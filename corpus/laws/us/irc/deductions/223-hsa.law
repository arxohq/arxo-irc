// Section 223 — Health savings accounts. Stage 1 (IRC-06), priority
// section. Scope: (a) allowance; (b)(1)-(2) the monthly limitation
// ($2,250 self-only / $4,500 family, as pinned in the 2024-Edition
// snapshot — these ARE the currently-effective indexed amounts for the
// snapshot's year, not the un-indexed 2003 statutory base; a later year's
// indexed amount is SOURCE_GAP); Pub. L. 119-21 sections 71306-71308 (HSA-
// eligibility extensions: telehealth safe harbor, bronze/catastrophic
// plans, direct primary care) as editions.

use self::{
    DeductionKind,
    IRC_S223_B,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation eligible_individual_hsa(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "an eligible individual for HSA purposes for the calendar month (section 223(c)(1))";
}
pub relation has_self_only_hdhp_coverage(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "has self-only coverage under a high deductible health plan as of the first day of the month (section 223(b)(2)(A))";
}
pub relation has_family_hdhp_coverage(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "has family coverage under a high deductible health plan as of the first day of the month (section 223(b)(2)(B))";
}
pub relation hsa_contribution_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount paid in cash for the taxable year to health savings accounts of the individual (section 223(a))";
}
pub relation months_with_self_only_coverage(p: Individual, y: TaxableYear, count: Integer) kind institutional {
    label en official "the count of months in the taxable year for which the individual had self-only HDHP coverage as an eligible individual (section 223(b)(1)-(2)) — a scenario supplies the count directly (deriving it from 12 separate monthly facts is a TECH_GAP under this stage's scope)";
}
pub relation months_with_family_coverage(p: Individual, y: TaxableYear, count: Integer) kind institutional {
    label en official "the count of months in the taxable year for which the individual had family HDHP coverage as an eligible individual (section 223(b)(1)-(2))";
}

@source(IRC_S223_B, quote = "in the case of an eligible individual who has self-only coverage under a high deductible health plan as of the first day of such month, $2,250")
rule HsaLimitSelfOnlyCoverage(p: Individual, y: TaxableYear, months: Integer, contribution: Money) strict {
    label en official "the HSA deduction limit for self-only coverage is 1/12 of $2,250 per eligible month (section 223(b)(2)(A)) — the aggregate limit for `months` months is $2,250 * months / 12, computed here as a per-month rate times the month count to avoid Money/Integer division";
    when months_with_self_only_coverage(p, y, months);
    when hsa_contribution_for_year(p, y, contribution);
    when contribution <= round(187.50 USD * months, 2, "HALF_UP");
    then deduction_allowed(p, y, Section223Hsa, contribution);
}
@source(IRC_S223_B, quote = "in the case of an eligible individual who has self-only coverage under a high deductible health plan as of the first day of such month, $2,250")
rule HsaContributionExceedsSelfOnlyLimitCapped(p: Individual, y: TaxableYear, months: Integer, contribution: Money) strict {
    label en official "an HSA contribution exceeding the self-only-coverage monthly-limitation aggregate is capped at that aggregate (section 223(b)(1)-(2)(A))";
    when months_with_self_only_coverage(p, y, months);
    when hsa_contribution_for_year(p, y, contribution);
    when contribution > round(187.50 USD * months, 2, "HALF_UP");
    then deduction_allowed(p, y, Section223Hsa, round(187.50 USD * months, 2, "HALF_UP"));
}
@source(IRC_S223_B, quote = "in the case of an eligible individual who has family coverage under a high deductible health plan as of the first day of such month, $4,500")
rule HsaLimitFamilyCoverage(p: Individual, y: TaxableYear, months: Integer, contribution: Money) strict {
    label en official "the HSA deduction limit for family coverage is 1/12 of $4,500 per eligible month (section 223(b)(2)(B))";
    when months_with_family_coverage(p, y, months);
    when hsa_contribution_for_year(p, y, contribution);
    when contribution <= round(375.00 USD * months, 2, "HALF_UP");
    then deduction_allowed(p, y, Section223Hsa, contribution);
}
@source(IRC_S223_B, quote = "in the case of an eligible individual who has family coverage under a high deductible health plan as of the first day of such month, $4,500")
rule HsaContributionExceedsFamilyLimitCapped(p: Individual, y: TaxableYear, months: Integer, contribution: Money) strict {
    label en official "an HSA contribution exceeding the family-coverage monthly-limitation aggregate is capped at that aggregate (section 223(b)(1)-(2)(B))";
    when months_with_family_coverage(p, y, months);
    when hsa_contribution_for_year(p, y, contribution);
    when contribution > round(375.00 USD * months, 2, "HALF_UP");
    then deduction_allowed(p, y, Section223Hsa, round(375.00 USD * months, 2, "HALF_UP"));
}
@source(IRC_S223_B, quote = "The limitation under this subsection for any month with respect to an individual shall be zero for the first month such individual is entitled to benefits under title XVIII of the Social Security Act and for each month thereafter")
rule HsaLimitationZeroOnceMedicareEntitled(p: Individual, y: TaxableYear, month: Integer, contribution: Money) strict {
    label en official "the HSA limitation is zero for any month, and each following month, once the individual is entitled to Medicare benefits (section 223(b)(7))";
    when medicare_entitled_as_of_month(p, y, month);
    when hsa_contribution_for_year(p, y, contribution);
    when contribution > 0.00 USD;
    then not deduction_allowed(p, y, Section223Hsa, contribution);
}
pub relation medicare_entitled_as_of_month(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "entitled to Medicare (title XVIII of the Social Security Act) benefits as of this month, per section 223(b)(7)";
}

// --- Pub. L. 119-21 eligibility extensions (sections 71306-71308) --------------

pub relation telehealth_only_coverage(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "coverage for telehealth and other remote care services, alongside HDHP coverage lacking a deductible for such services (section 223(c)(2)(E), as amended)";
}
@source(us.irc.temporal::PL119_21_S71306, relation = derives_from, quote = "A plan shall not fail to be treated as a high deductible health plan by reason of failing to have a deductible for telehealth and other remote care services")
rule TelehealthSafeHarborPermanentFrom2025(p: Individual, y: TaxableYear, month: Integer) strict {
    label en official "Pub. L. 119-21 section 71306: for plan years beginning after December 31, 2024, permanently, a plan is not disqualified as a high deductible health plan for lacking a telehealth deductible";
    effective [@2025-01-01, infinity);
    when telehealth_only_coverage(p, y, month);
    when has_self_only_hdhp_coverage(p, y, month) or has_family_hdhp_coverage(p, y, month);
    then eligible_individual_hsa(p, y, month);
}

pub relation bronze_or_catastrophic_exchange_plan_coverage(p: Individual, y: TaxableYear, month: Integer) kind empirical {
    label en official "coverage under a bronze or catastrophic plan available through an Affordable Care Act Exchange (section 223(c)(2)(H), as added)";
}
@source(us.irc.temporal::PL119_21_S71307, relation = derives_from, quote = "shall include any plan which is")
rule BronzeCatastrophicPlanTreatedAsHdhpFrom2026(p: Individual, y: TaxableYear, month: Integer) strict {
    label en official "Pub. L. 119-21 section 71307: for months beginning after December 31, 2025, a bronze or catastrophic Exchange plan is treated as a high deductible health plan";
    effective [@2026-01-01, infinity);
    when bronze_or_catastrophic_exchange_plan_coverage(p, y, month);
    then eligible_individual_hsa(p, y, month);
}

pub relation direct_primary_care_arrangement_fee(p: Individual, y: TaxableYear, month: Integer, amount: Money) kind empirical {
    label en official "the aggregate fee for direct primary care service arrangements for the individual for the month (section 223(c)(1)(E), as added)";
}
@source(us.irc.temporal::PL119_21_S71308, relation = derives_from, quote = "A direct primary care service arrangement shall not be treated as a health plan for purposes of subparagraph (A)(ii)")
rule DirectPrimaryCareArrangementNotDisqualifyingWithinFeeLimit(p: Individual, y: TaxableYear, month: Integer, fee: Money) strict {
    label en official "Pub. L. 119-21 section 71308: a direct primary care arrangement with an aggregate fee not exceeding $150/month ($300 for an arrangement covering more than one individual) is not treated as a disqualifying health plan";
    when direct_primary_care_arrangement_fee(p, y, month, fee);
    when fee <= 150.00 USD;
    then not disqualifying_coverage(p, y, month);
}
pub relation disqualifying_coverage(p: Individual, y: TaxableYear, month: Integer) kind institutional {
    label en official "coverage that would otherwise disqualify HSA eligibility for the month, absent an applicable exception";
}
// The effective date of section 71308 is not stated as a separate sentence
// in the pinned Public Law fragment (unlike 71306/71307); this stage does
// not window it — recorded as a coverage-row note rather than guessed.
