// Section 170(c) -- qualifying donee organizations ("charitable contribution" defined). WIRE-9 (26.09.2026, DECISION-0379,
// implemented_unverified; scenarios written, NOT executed; no legal review). TECH-GAPS G7000 closed.
//
// The definition is a classification of a CONTRIBUTION OR GIFT (item) by the donee it is made to or for the use of: five paragraphs
// with their conditions ((1) governmental units for exclusively public purposes; (2) corporations, trusts, community chests, funds and
// foundations organized and operated for the listed purposes; (3) war veterans' posts; (4) domestic fraternal lodge-system societies
// for individual donors; (5) cemetery companies; (6) federally chartered section 501(c)(19) organizations) and the closing sentence of
// (c) for amounts treated under (g) as paid for the use of an organization described in (2), (3) or (4).
//
// JUDGMENT CALLS
//  - The purposes of paragraph (2)(B) differ from section 501(c)(3) (no "testing for public safety"), so the organizational and
//    operational test is its own evaluative element (`Section170c2BExclusivePurposes`, DECISION-0194 channel, authority TaxCourt) and
//    not the `us.irc.exempt_organizations` judgment relations. Private inurement and political-campaign intervention are read from
//    `us.irc.exempt_organizations` (`private_inurement_established`, `political_campaign_intervention_established`).
//  - Paragraph (2)(D) "not disqualified under section 501(c)(3) by reason of attempting to influence legislation": disqualified
//    when the substantial-part test is failed and no section 501(h) election is in effect, or when an election is in effect and the
//    (h) expenditures exceed the ceiling (both read from `us.irc.exempt_organizations`).
//  - Paragraph (4): the donor must be an individual (case fact `donor_is_individual_170c4`; entity types are not runtime facts); "to be used exclusively for"
//    the listed purposes is a case-asserted intention fact of the contribution.
//  - Paragraph (5) is two rules (the "or" between the cemetery company and the burial corporation); "not operated for profit" is a case
//    fact of the donee.
//  - The general rule (`CharitableContributionGeneralRuleAllowedIfSubstantiated` in 170-charitable.law) still reads the case-asserted
//    `charitable_contribution_made`; this module derives the definition and does not yet feed it back into that rule. The older
//    empirical `qualifying_donee_organization(org)` is left as it was.
//  - Section 170(c) contains no duty, prohibition or power addressed to a person; the conditions are classification tests, so no
//    deontic position is declared.

use self::{
    IRC_S170_C,
    Person,
    TaxableYear,
};

pub enum DoneeCategory170c {
    Donee170c1GovernmentalUnit;
    Donee170c2CharitableOrganization;
    Donee170c3WarVeteransOrganization;
    Donee170c4FraternalLodgeSociety;
    Donee170c5CemeteryCompany;
    Donee170c6FederallyChartered501c19Organization;
    label en unofficial "the paragraph of section 170(c) that describes the donee of a contribution or gift";
}

pub relation contribution_or_gift_170c(donor: Person, y: TaxableYear, item: Integer, donee: Person) kind empirical {
    label en official "a contribution or gift made by the donor during the taxable year to or for the use of the donee (section 170(c)); case-asserted";
}
pub relation donor_is_corporation_170c2(donor: Person) kind empirical {
    label en official "the donor is a corporation (section 170(c)(2), closing sentence); case-asserted, entity types are not runtime facts";
}
pub relation donor_is_individual_170c4(donor: Person) kind empirical {
    label en official "the donor is an individual (section 170(c)(4)); case-asserted, entity types are not runtime facts";
}
pub relation governmental_unit_donee_170c1(org: Person) kind empirical {
    label en official "the donee is a State, a possession of the United States, a political subdivision of either, the United States or the District of Columbia (section 170(c)(1))";
}
pub relation contribution_made_for_exclusively_public_purposes_170c1(item: Integer) kind empirical {
    label en official "the contribution or gift is made for exclusively public purposes (section 170(c)(1))";
}
pub relation donee_has_form_listed_in_170c2(org: Person) kind empirical {
    label en official "the donee is a corporation, trust, or community chest, fund, or foundation (section 170(c)(2))";
}
pub relation donee_is_trust_chest_fund_or_foundation_170c2(org: Person) kind empirical {
    label en official "the donee is a trust, community chest, fund, or foundation rather than a corporation (section 170(c)(2), closing sentence)";
}
pub relation organized_in_united_states_or_possession_or_under_its_law_170c2A(org: Person) kind empirical {
    label en official "the donee is created or organized in the United States or a possession, or under the law of the United States, a State, the District of Columbia or a possession (section 170(c)(2)(A))";
}
external judgment relation Section170c2BExclusivePurposes(org: Person) {
    authority TaxCourt;
    label en official "the donee is organized and operated exclusively for religious, charitable, scientific, literary or educational purposes, to foster national or international amateur sports competition (without providing athletic facilities or equipment) or for the prevention of cruelty to children or animals (section 170(c)(2)(B)) -- DECISION-0194 evaluative channel";
}
pub relation contribution_used_within_united_states_exclusively_for_170c2B_purposes(item: Integer) kind empirical {
    label en official "the contribution or gift is to be used within the United States or its possessions exclusively for the purposes of section 170(c)(2)(B) (section 170(c)(2), closing sentence)";
}
pub relation donee_barred_by_political_or_legislative_activity_170c2D(item: Integer, y: TaxableYear, org: Person) kind institutional {
    label en official "the donee of the contribution or gift participates or intervenes in a political campaign, or is disqualified for exemption under section 501(c)(3) by reason of attempting to influence legislation (the substantial-part test failed with no section 501(h) election, or the section 501(h) ceiling exceeded with an election in effect) (section 170(c)(2)(D))";
}
pub relation donee_private_inurement_170c(item: Integer, y: TaxableYear, org: Person) kind institutional {
    label en official "part of the net earnings of the donee of the contribution or gift inures to the benefit of a private shareholder or individual (section 170(c)(2)(C), (3)(B), (5))";
}
pub relation contribution_by_corporation_to_trust_or_fund_outside_use_limit_170c2(item: Integer, y: TaxableYear) kind institutional {
    label en official "a contribution or gift by a corporation to a trust, chest, fund, or foundation that is not to be used within the United States or its possessions exclusively for section 170(c)(2)(B) purposes, and so is not deductible by reason of paragraph (2)";
}
pub relation domestic_fraternal_lodge_system_society_170c4(org: Person) kind empirical {
    label en official "the donee is a domestic fraternal society, order or association operating under the lodge system (section 170(c)(4))";
}
pub relation contribution_to_be_used_exclusively_for_170c4_purposes(item: Integer) kind empirical {
    label en official "the contribution or gift is to be used exclusively for religious, charitable, scientific, literary or educational purposes or for the prevention of cruelty to children or animals (section 170(c)(4))";
}
pub relation cemetery_company_owned_and_operated_exclusively_for_members_170c5(org: Person) kind empirical {
    label en official "the donee is a cemetery company owned and operated exclusively for the benefit of its members (section 170(c)(5))";
}
pub relation burial_only_cemetery_corporation_170c5(org: Person) kind empirical {
    label en official "the donee is a corporation chartered solely for burial purposes as a cemetery corporation and not permitted by its charter to engage in any business not necessarily incident to that purpose (section 170(c)(5))";
}
pub relation donee_not_operated_for_profit_170c5(org: Person) kind empirical {
    label en official "the cemetery company or corporation is not operated for profit (section 170(c)(5))";
}
pub relation federally_chartered_corporation_170c6(org: Person) kind empirical {
    label en official "the donee is a federally chartered corporation (section 170(c)(6))";
}
pub relation amount_treated_as_paid_for_use_of_organization_170g(item: Integer) kind empirical {
    label en official "the amount is treated under section 170(g) as paid for the use of the donee organization";
}

pub relation contribution_to_170c_organization(item: Integer, y: TaxableYear, category: DoneeCategory170c) kind institutional {
    label en official "the contribution or gift is made to or for the use of a donee described in the stated paragraph of section 170(c)";
}
pub relation charitable_contribution_170c(item: Integer, y: TaxableYear) kind institutional {
    label en official "a charitable contribution within the meaning of section 170(c): a contribution or gift to or for the use of a donee described in paragraphs (1)-(6), or an amount treated under subsection (g) as paid for the use of a donee described in (2), (3) or (4)";
}

@source(IRC_S170_C, quote = "(1) A State, a possession of the United States, or any political subdivision of any of the foregoing, or the United States or the District of Columbia, but only if the contribution or gift is made for exclusively public purposes.")
rule S170c1GovernmentalUnitForExclusivelyPublicPurposes(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(1): a gift to a governmental unit made for exclusively public purposes";
    when contribution_or_gift_170c(donor, y, item, org);
    when governmental_unit_donee_170c1(org);
    when contribution_made_for_exclusively_public_purposes_170c1(item);
    then contribution_to_170c_organization(item, y, Donee170c1GovernmentalUnit);
}

@source(IRC_S170_C, quote = "(C) no part of the net earnings of which inures to the benefit of any private shareholder or individual; and")
rule S170cPrivateInurementOfTheDonee(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2)(C), (3)(B), (5): part of the donee's net earnings inures to the benefit of a private shareholder or individual in the taxable year";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::private_inurement_established(org, y);
    then donee_private_inurement_170c(item, y, org);
}
@source(IRC_S170_C, quote = "and which does not participate in, or intervene in (including the publishing or distributing of statements), any political campaign on behalf of (or in opposition to) any candidate for public office.")
rule S170c2DDoneeInterveningInPoliticalCampaign(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2)(D): the donee participates or intervenes in a political campaign for or against a candidate for public office";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::political_campaign_intervention_established(org, y);
    then donee_barred_by_political_or_legislative_activity_170c2D(item, y, org);
}
@source(IRC_S170_C, quote = "which is not disqualified for tax exemption under section 501(c)(3) by reason of attempting to influence legislation")
rule S170c2DDisqualifiedBySubstantialLegislativeActivity(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2)(D): the donee attempts to influence legislation to a substantial part and no section 501(h) election is in effect";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::SubstantialLegislativeActivity(org, y);
    when not_known(us.irc.exempt_organizations::section_501h_election_in_effect(org, y));
    then donee_barred_by_political_or_legislative_activity_170c2D(item, y, org);
}
@source(IRC_S170_C, quote = "which is not disqualified for tax exemption under section 501(c)(3) by reason of attempting to influence legislation")
rule S170c2DDisqualifiedByExceedingSection501hCeiling(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2)(D): a section 501(h) election is in effect and the lobbying expenditures exceed the ceiling";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::section_501h_election_in_effect(org, y);
    when us.irc.exempt_organizations::section_501h_expenditures_exceed_ceiling(org, y);
    then donee_barred_by_political_or_legislative_activity_170c2D(item, y, org);
}
@source(IRC_S170_C, quote = "A contribution or gift by a corporation to a trust, chest, fund, or foundation shall be deductible by reason of this paragraph only if it is to be used within the United States or any of its possessions exclusively for purposes specified in subparagraph (B).")
rule S170c2CorporateGiftToTrustOutsideUseLimit(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2), closing sentence: a corporation's gift to a trust, chest, fund or foundation without the United States use limited to (B) purposes is not deductible by reason of paragraph (2)";
    when contribution_or_gift_170c(donor, y, item, org);
    when donor_is_corporation_170c2(donor);
    when donee_is_trust_chest_fund_or_foundation_170c2(org);
    when not_known(contribution_used_within_united_states_exclusively_for_170c2B_purposes(item));
    then contribution_by_corporation_to_trust_or_fund_outside_use_limit_170c2(item, y);
}
@source(IRC_S170_C, quote = "(2) A corporation, trust, or community chest, fund, or foundation—")
rule S170c2CharitableOrganizationOrganizedAndOperatedForListedPurposes(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(2): a gift to a domestic corporation, trust, chest, fund or foundation organized and operated exclusively for the listed purposes, with no private inurement, no disqualifying legislative activity and no campaign intervention, and not caught by the corporate closing sentence";
    when contribution_or_gift_170c(donor, y, item, org);
    when donee_has_form_listed_in_170c2(org);
    when organized_in_united_states_or_possession_or_under_its_law_170c2A(org);
    when Section170c2BExclusivePurposes(org);
    unless donee_private_inurement_170c(item, y, org);
    unless donee_barred_by_political_or_legislative_activity_170c2D(item, y, org);
    unless contribution_by_corporation_to_trust_or_fund_outside_use_limit_170c2(item, y);
    then contribution_to_170c_organization(item, y, Donee170c2CharitableOrganization);
}
@source(IRC_S170_C, quote = "(3) A post or organization of war veterans, or an auxiliary unit or society of, or trust or foundation for, any such post or organization—")
rule S170c3WarVeteransPostOrganizedInUnitedStatesWithoutInurement(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(3): a gift to a war veterans' post (or its auxiliary unit, society, trust or foundation) organized in the United States or a possession, with no private inurement of net earnings";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::veterans_post_or_organization(org, y);
    when us.irc.exempt_organizations::organized_in_us_or_possessions(org);
    unless donee_private_inurement_170c(item, y, org);
    then contribution_to_170c_organization(item, y, Donee170c3WarVeteransOrganization);
}
@source(IRC_S170_C, quote = "(4) In the case of a contribution or gift by an individual, a domestic fraternal society, order, or association, operating under the lodge system, but only if such contribution or gift is to be used exclusively for religious, charitable, scientific, literary, or educational purposes, or for the prevention of cruelty to children or animals.")
rule S170c4FraternalLodgeSocietyGiftByIndividual(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(4): an individual's gift to a domestic fraternal lodge-system society, to be used exclusively for the listed purposes";
    when contribution_or_gift_170c(donor, y, item, org);
    when donor_is_individual_170c4(donor);
    when domestic_fraternal_lodge_system_society_170c4(org);
    when contribution_to_be_used_exclusively_for_170c4_purposes(item);
    then contribution_to_170c_organization(item, y, Donee170c4FraternalLodgeSociety);
}
@source(IRC_S170_C, quote = "(5) A cemetery company owned and operated exclusively for the benefit of its members")
rule S170c5CemeteryCompanyOwnedForMembers(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(5): a gift to a cemetery company owned and operated exclusively for its members, not operated for profit and without private inurement";
    when contribution_or_gift_170c(donor, y, item, org);
    when cemetery_company_owned_and_operated_exclusively_for_members_170c5(org);
    when donee_not_operated_for_profit_170c5(org);
    unless donee_private_inurement_170c(item, y, org);
    then contribution_to_170c_organization(item, y, Donee170c5CemeteryCompany);
}
@source(IRC_S170_C, quote = "or any corporation chartered solely for burial purposes as a cemetery corporation and not permitted by its charter to engage in any business not necessarily incident to that purpose")
rule S170c5BurialOnlyCemeteryCorporation(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(5): a gift to a corporation chartered solely for burial purposes as a cemetery corporation, not operated for profit and without private inurement";
    when contribution_or_gift_170c(donor, y, item, org);
    when burial_only_cemetery_corporation_170c5(org);
    when donee_not_operated_for_profit_170c5(org);
    unless donee_private_inurement_170c(item, y, org);
    then contribution_to_170c_organization(item, y, Donee170c5CemeteryCompany);
}
@source(IRC_S170_C, quote = "(6) An organization described in section 501(c)(19) that is a federally chartered corporation.")
rule S170c6FederallyChartered501c19Organization(donor: Person, y: TaxableYear, item: Integer, org: Person) defeasible {
    label en official "section 170(c)(6): a gift to a section 501(c)(19) organization that is a federally chartered corporation";
    when contribution_or_gift_170c(donor, y, item, org);
    when us.irc.exempt_organizations::section_501c19(org, y);
    when federally_chartered_corporation_170c6(org);
    then contribution_to_170c_organization(item, y, Donee170c6FederallyChartered501c19Organization);
}

@source(IRC_S170_C, quote = "For purposes of this section, the term \"charitable contribution\" means a contribution or gift to or for the use of—")
rule S170cCharitableContributionIsGiftToADescribedDonee(item: Integer, y: TaxableYear) defeasible {
    label en official "section 170(c): a contribution or gift to or for the use of a donee described in any of paragraphs (1)-(6) is a charitable contribution";
    when contribution_to_170c_organization(item, y, _);
    then charitable_contribution_170c(item, y);
}
@source(IRC_S170_C, quote = "the term \"charitable contribution\" also means an amount treated under subsection (g) as paid for the use of an organization described in paragraph (2), (3), or (4)")
rule S170cAmountPaidForUseOfParagraph2OrganizationIsCharitableContribution(item: Integer, y: TaxableYear) defeasible {
    label en official "section 170(c), closing sentence: an amount treated under subsection (g) as paid for the use of an organization described in paragraph (2) is a charitable contribution";
    when amount_treated_as_paid_for_use_of_organization_170g(item);
    when contribution_to_170c_organization(item, y, Donee170c2CharitableOrganization);
    then charitable_contribution_170c(item, y);
}
@source(IRC_S170_C, quote = "the term \"charitable contribution\" also means an amount treated under subsection (g) as paid for the use of an organization described in paragraph (2), (3), or (4)")
rule S170cAmountPaidForUseOfParagraph3OrganizationIsCharitableContribution(item: Integer, y: TaxableYear) defeasible {
    label en official "section 170(c), closing sentence: an amount treated under subsection (g) as paid for the use of an organization described in paragraph (3) is a charitable contribution";
    when amount_treated_as_paid_for_use_of_organization_170g(item);
    when contribution_to_170c_organization(item, y, Donee170c3WarVeteransOrganization);
    then charitable_contribution_170c(item, y);
}
@source(IRC_S170_C, quote = "the term \"charitable contribution\" also means an amount treated under subsection (g) as paid for the use of an organization described in paragraph (2), (3), or (4)")
rule S170cAmountPaidForUseOfParagraph4OrganizationIsCharitableContribution(item: Integer, y: TaxableYear) defeasible {
    label en official "section 170(c), closing sentence: an amount treated under subsection (g) as paid for the use of an organization described in paragraph (4) is a charitable contribution";
    when amount_treated_as_paid_for_use_of_organization_170g(item);
    when contribution_to_170c_organization(item, y, Donee170c4FraternalLodgeSociety);
    then charitable_contribution_170c(item, y);
}
