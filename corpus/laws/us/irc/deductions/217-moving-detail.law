// Section 217 — moving expenses: stage 2b detail (TECH_GAPS G2793): (b) the definition of moving
// expenses, (c) the distance and time conditions, (d) the exceptions, the return-date election and
// its recapture, (f) self-employed individual, (g) Armed Forces, (h) foreign move storage,
// (i) retirees and survivors. The result is `moving_expense_deductible_217`, a fuller derivation
// than the stage 1 `MovingExpenseAllowedOutsideSuspensionWindow`; both respect the (k) suspension
// through `section_217k_suspension_applies`. The suspension itself (2018-2025) is the stage 1 rule.
// Not modelled: the 39/78-week counts are supplied as totals, not derived from weekly records; the
// shortest-more-commonly-traveled-route distance is a fact.

use self::{
    IRC_S217_A,
    IRC_S217_B,
    IRC_S217_C,
    IRC_S217_D,
    IRC_S217_F,
    IRC_S217_G,
    IRC_S217_H,
    IRC_S217_I,
    Person,
    TaxableYear,
    section_217k_suspension_applies,
};

enum MovingExpenseKind {
    HouseholdGoodsAndEffects;
    TravelIncludingLodging;
    Meals;
    Storage;
}

pub relation moving_expense_of_kind(p: Person, y: TaxableYear, item: Integer, kind: MovingExpenseKind, amount: Money) kind empirical {
    label en official "an expense of the kind, paid or incurred by or for the taxpayer in connection with the commencement of work at a new principal place of work (section 217(a),(b)(1))";
}
external judgment relation moving_expense_is_reasonable(item: Integer) {
    authority TaxCourt;
    label en official "the expense is reasonable (section 217(b)(1))";
}
pub relation expense_is_of_individual_other_than_taxpayer(item: Integer) kind empirical {
    label en official "the expense is that of an individual other than the taxpayer (section 217(b)(2))";
}
pub relation other_individual_has_both_residences_as_principal_abode_and_is_household_member(item: Integer) kind empirical {
    label en official "the individual has both the former residence and the new residence as his principal place of abode and is a member of the taxpayer's household (section 217(b)(2))";
}
pub relation foreign_move_217h(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer commences work at a new principal place of work located outside the United States, which includes the possessions (section 217(h)(2),(3))";
}
pub relation qualified_moving_expense_217b(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a moving expense within section 217(b)(1) (with (h) storage in a foreign move), taken into account for the taxpayer or a qualifying household member";
}
@source(IRC_S217_B, quote = "(A) of moving household goods and personal effects from the former residence to the new residence, and")
rule QualifiedMovingExpenseHouseholdGoodsTaxpayer(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the reasonable expense of moving household goods and personal effects is a moving expense (section 217(b)(1)(A))";
    when moving_expense_of_kind(p, y, item, HouseholdGoodsAndEffects, amount);
    when moving_expense_is_reasonable(item);
    when not_known(expense_is_of_individual_other_than_taxpayer(item));
    then qualified_moving_expense_217b(p, y, item, amount);
}
@source(IRC_S217_B, quote = "(B) of traveling (including lodging) from the former residence to the new place of residence.")
rule QualifiedMovingExpenseTravelTaxpayer(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the reasonable expense of traveling, including lodging, is a moving expense (section 217(b)(1)(B))";
    when moving_expense_of_kind(p, y, item, TravelIncludingLodging, amount);
    when moving_expense_is_reasonable(item);
    when not_known(expense_is_of_individual_other_than_taxpayer(item));
    then qualified_moving_expense_217b(p, y, item, amount);
}
@source(IRC_S217_B, quote = "expenses referred to in paragraph (1) shall be taken into account only if such individual has both the former residence and the new residence as his principal place of abode and is a member of the taxpayer's household")
rule QualifiedMovingExpenseOtherIndividualGoods(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an individual other than the taxpayer counts only if a household member with both residences as principal abode (section 217(b)(2)) - household goods";
    when moving_expense_of_kind(p, y, item, HouseholdGoodsAndEffects, amount);
    when moving_expense_is_reasonable(item);
    when expense_is_of_individual_other_than_taxpayer(item);
    when other_individual_has_both_residences_as_principal_abode_and_is_household_member(item);
    then qualified_moving_expense_217b(p, y, item, amount);
}
@source(IRC_S217_B, quote = "expenses referred to in paragraph (1) shall be taken into account only if such individual has both the former residence and the new residence as his principal place of abode and is a member of the taxpayer's household")
rule QualifiedMovingExpenseOtherIndividualTravel(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an individual other than the taxpayer counts only if a household member with both residences as principal abode (section 217(b)(2)) - travel";
    when moving_expense_of_kind(p, y, item, TravelIncludingLodging, amount);
    when moving_expense_is_reasonable(item);
    when expense_is_of_individual_other_than_taxpayer(item);
    when other_individual_has_both_residences_as_principal_abode_and_is_household_member(item);
    then qualified_moving_expense_217b(p, y, item, amount);
}
@source(IRC_S217_H, quote = "of moving household goods and personal effects to and from storage")
rule QualifiedMovingExpenseForeignMoveStorage(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "in a foreign move the reasonable expenses of moving goods to and from storage and of storing them for the period the new place of work is the principal place of work are moving expenses (section 217(h)(1))";
    when moving_expense_of_kind(p, y, item, Storage, amount);
    when moving_expense_is_reasonable(item);
    when foreign_move_217h(p, y);
    then qualified_moving_expense_217b(p, y, item, amount);
}
pub relation meals_are_not_moving_expenses(item: Integer) kind institutional {
    label en official "expenses for meals are not moving expenses (section 217(b)(1) last sentence)";
}
@source(IRC_S217_B, quote = "Such term shall not include any expenses for meals.")
rule MealsNotMovingExpense(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "expenses for meals are excluded from moving expenses (section 217(b)(1))";
    when moving_expense_of_kind(p, y, item, Meals, amount);
    then meals_are_not_moving_expenses(item);
}
rule MealExpenseNegative(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a meals expense yields no section 217 deduction (section 217(b)(1))";
    when moving_expense_of_kind(p, y, item, Meals, amount);
    then not qualified_moving_expense_217b(p, y, item, amount);
}

// --- (c)(1): distance ----------------------------------------------------------------------------------------------------

pub relation new_principal_place_of_work_distance_from_former_residence(p: Person, y: TaxableYear, miles: Integer) kind empirical {
    label en official "the distance in miles (shortest of the more commonly traveled routes) from the former residence to the new principal place of work (section 217(c)(1),(c) last sentence)";
}
pub relation former_principal_place_of_work_distance_from_former_residence(p: Person, y: TaxableYear, miles: Integer) kind empirical {
    label en official "the distance in miles from the former residence to the former principal place of work (section 217(c)(1)(A))";
}
pub relation had_no_former_principal_place_of_work(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer had no former principal place of work (section 217(c)(1)(B))";
}
pub relation moving_distance_condition_met(p: Person, y: TaxableYear) kind institutional {
    label en official "the distance condition of section 217(c)(1) is met";
}
@source(IRC_S217_C, quote = "is at least 50 miles farther from his former residence than was his former principal place of work")
rule DistanceConditionFarther50Miles(p: Person, y: TaxableYear, new_miles: Integer, old_miles: Integer) defeasible {
    label en official "the new principal place of work is at least 50 miles farther from the former residence than the former one was (section 217(c)(1)(A))";
    when new_principal_place_of_work_distance_from_former_residence(p, y, new_miles);
    when former_principal_place_of_work_distance_from_former_residence(p, y, old_miles);
    when new_miles - old_miles >= 50;
    then moving_distance_condition_met(p, y);
}
@source(IRC_S217_C, quote = "if he had no former principal place of work, is at least 50 miles from his former residence")
rule DistanceConditionNoFormerWorkplace50Miles(p: Person, y: TaxableYear, new_miles: Integer) defeasible {
    label en official "with no former principal place of work the new one is at least 50 miles from the former residence (section 217(c)(1)(B))";
    when had_no_former_principal_place_of_work(p, y);
    when new_principal_place_of_work_distance_from_former_residence(p, y, new_miles);
    when new_miles >= 50;
    then moving_distance_condition_met(p, y);
}

// --- (c)(2): time in the new location ---------------------------------------------------------------------------------------

pub relation full_time_employee_weeks_in_first_12_months(p: Person, y: TaxableYear, weeks: Integer) kind empirical {
    label en official "weeks as a full-time employee in the general location of the new principal place of work during the 12-month period following arrival (section 217(c)(2)(A))";
}
pub relation full_time_work_weeks_in_first_24_months(p: Person, y: TaxableYear, weeks: Integer) kind empirical {
    label en official "weeks as a full-time employee or full-time self-employed individual in that location during the 24-month period following arrival (section 217(c)(2)(B))";
}
pub relation moving_time_condition_met(p: Person, y: TaxableYear) kind institutional {
    label en official "the time condition of section 217(c)(2) is met";
}
@source(IRC_S217_C, quote = "the taxpayer is a full-time employee, in such general location, during at least 39 weeks")
rule TimeConditionThirtyNineWeeksIn12Months(p: Person, y: TaxableYear, weeks: Integer) defeasible {
    label en official "at least 39 weeks as a full-time employee in the 12 months after arrival (section 217(c)(2)(A))";
    when full_time_employee_weeks_in_first_12_months(p, y, weeks);
    when weeks >= 39;
    then moving_time_condition_met(p, y);
}
@source(IRC_S217_C, quote = "during at least 78 weeks, of which not less than 39 weeks are during the 12-month period referred to in subparagraph (A)")
rule TimeConditionSeventyEightWeeksIn24Months(p: Person, y: TaxableYear, weeks24: Integer, weeks12: Integer) defeasible {
    label en official "at least 78 weeks of full-time work in the 24 months after arrival, at least 39 of them in the first 12 months (section 217(c)(2)(B))";
    when full_time_work_weeks_in_first_24_months(p, y, weeks24);
    when full_time_employee_weeks_in_first_12_months(p, y, weeks12);
    when weeks24 >= 78;
    when weeks12 >= 39;
    then moving_time_condition_met(p, y);
}
pub relation moving_conditions_of_subsection_c_met(p: Person, y: TaxableYear) kind institutional {
    label en official "both the distance and the time conditions of section 217(c) are met";
}
@source(IRC_S217_C, quote = "No deduction shall be allowed under this section unless")
rule MovingConditionsCMet(p: Person, y: TaxableYear) defeasible {
    label en official "the distance and time conditions of subsection (c) are both met (section 217(c))";
    when moving_distance_condition_met(p, y);
    when moving_time_condition_met(p, y);
    then moving_conditions_of_subsection_c_met(p, y);
}

// --- (d): exceptions, election and recapture --------------------------------------------------------------------------------------

pub relation unable_to_satisfy_time_condition_by_death_or_disability(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer is unable to satisfy the condition of subsection (c)(2) by reason of death or disability (section 217(d)(1)(A))";
}
pub relation involuntary_separation_other_than_willful_misconduct(p: Person, y: TaxableYear) kind empirical {
    label en official "involuntary separation (other than for willful misconduct) from the service of, or transfer for the benefit of, an employer (section 217(d)(1)(B))";
}
external judgment relation full_time_employment_where_taxpayer_could_reasonably_have_been_expected_to_satisfy(p: Person, y: TaxableYear) {
    authority TaxCourt;
    label en official "the taxpayer obtained full-time employment in which he could reasonably have been expected to satisfy the condition (section 217(d)(1)(B))";
}
pub relation time_condition_waived_217d1(p: Person, y: TaxableYear) kind institutional {
    label en official "the condition of subsection (c)(2) does not apply by reason of section 217(d)(1)";
}
@source(IRC_S217_D, quote = "(A) death or disability, or")
rule TimeConditionWaivedDeathOrDisability(p: Person, y: TaxableYear) defeasible {
    label en official "the time condition does not apply where the taxpayer is unable to satisfy it by reason of death or disability (section 217(d)(1)(A))";
    when unable_to_satisfy_time_condition_by_death_or_disability(p, y);
    then time_condition_waived_217d1(p, y);
}
@source(IRC_S217_D, quote = "involuntary separation (other than for willful misconduct) from the service of, or transfer for the benefit of, an employer after obtaining full-time employment")
rule TimeConditionWaivedInvoluntarySeparation(p: Person, y: TaxableYear) defeasible {
    label en official "the time condition does not apply after an involuntary separation or transfer following full-time employment in which the taxpayer could reasonably have been expected to satisfy it (section 217(d)(1)(B))";
    when involuntary_separation_other_than_willful_misconduct(p, y);
    when full_time_employment_where_taxpayer_could_reasonably_have_been_expected_to_satisfy(p, y);
    then time_condition_waived_217d1(p, y);
}
pub relation may_still_satisfy_time_condition_at_return_due_date(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer has not satisfied the condition of subsection (c)(2) before the time prescribed by law (including extensions) for filing the return, but may still satisfy it (section 217(d)(2))";
}
pub relation elects_to_deduct_moving_expenses_before_time_condition(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects to deduct the moving expenses for the taxable year notwithstanding subsection (c)(2) (section 217(d)(2))";
}
pub relation moving_expenses_deducted_by_217d2_election(p: Person, y: TaxableYear) kind institutional {
    label en official "the moving expenses are deductible for the taxable year by the election of section 217(d)(2)";
}
@source(IRC_S217_D, quote = "then such expenses may (at the election of the taxpayer) be deducted for such taxable year notwithstanding subsection (c)(2)")
rule S217d2ElectionPower(p: Person, y: TaxableYear) defeasible {
    label en official "the taxpayer may elect to deduct the expenses before the time condition is satisfied if it may still be satisfied (section 217(d)(2)); an election where it may not be satisfied has no effect";
    when elects_to_deduct_moving_expenses_before_time_condition(p, y);
    then power S217dElectDeductionBeforeTimeCondition {
        holder p;
        over y;
        exercise elects_to_deduct_moving_expenses_before_time_condition(p, y);
        valid_when may_still_satisfy_time_condition_at_return_due_date(p, y);
        effect create(moving_expenses_deducted_by_217d2_election(p, y));
        window [-infinity, infinity];
    };
}
pub relation time_condition_cannot_be_satisfied_at_close_of_year(p: Person, election_year: TaxableYear, later_year: TaxableYear) kind empirical {
    label en official "the condition of subsection (c)(2) cannot be satisfied at the close of a subsequent taxable year (section 217(d)(3)(B))";
}
pub relation moving_expenses_deducted_amount_by_election(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of moving expenses deducted under the section 217(d)(2) election for the taxable year";
}
pub relation recapture_of_217d2_expenses_in_gross_income(p: Person, later_year: TaxableYear, amount: Money) kind institutional {
    label en official "an amount equal to the expenses deducted by the election is included in gross income for the first such subsequent taxable year (section 217(d)(3))";
}
@source(IRC_S217_D, quote = "then an amount equal to the expenses which were so deducted shall be included in gross income for the first such subsequent taxable year")
rule RecaptureOfElectedMovingExpenses(p: Person, y: TaxableYear, later: TaxableYear, amount: Money) defeasible {
    label en official "expenses deducted under the (d)(2) election are included in income for the first later year in which the time condition cannot be satisfied (section 217(d)(3)); the first-such-year selection is left to the case facts (`time_condition_cannot_be_satisfied_at_close_of_year` names the year)";
    when moving_expenses_deducted_by_217d2_election(p, y);
    when moving_expenses_deducted_amount_by_election(p, y, amount);
    when time_condition_cannot_be_satisfied_at_close_of_year(p, y, later);
    then recapture_of_217d2_expenses_in_gross_income(p, later, amount);
}

// --- (f): self-employed individual --------------------------------------------------------------------------------------------------

pub relation performs_services_as_owner_of_entire_interest_in_unincorporated_business(p: Person) kind empirical {
    label en official "the individual performs personal services as the owner of the entire interest in an unincorporated trade or business (section 217(f)(1))";
}
pub relation performs_services_as_partner_in_trade_or_business_partnership(p: Person) kind empirical {
    label en official "the individual performs personal services as a partner in a partnership carrying on a trade or business (section 217(f)(2))";
}
pub relation self_employed_individual_217f(p: Person) kind institutional {
    label en official "a self-employed individual within section 217(f)";
}
@source(IRC_S217_F, quote = "(1) as the owner of the entire interest in an unincorporated trade or business, or")
rule SelfEmployedOwner(p: Person) strict {
    label en official "the owner of the entire interest in an unincorporated business is self-employed (section 217(f)(1))";
    when performs_services_as_owner_of_entire_interest_in_unincorporated_business(p);
    then self_employed_individual_217f(p);
}
@source(IRC_S217_F, quote = "(2) as a partner in a partnership carrying on a trade or business.")
rule SelfEmployedPartner(p: Person) strict {
    label en official "a partner in a partnership carrying on a trade or business is self-employed (section 217(f)(2))";
    when performs_services_as_partner_in_trade_or_business_partnership(p);
    then self_employed_individual_217f(p);
}

// --- (g): Armed Forces -----------------------------------------------------------------------------------------------------------------

pub relation armed_forces_member_on_active_duty_moving_under_order_pcs(p: Person, y: TaxableYear) kind empirical {
    label en official "a member of the Armed Forces on active duty who moves pursuant to a military order and incident to a permanent change of station (section 217(g))";
}
pub relation armed_forces_move_limitations_of_c_do_not_apply(p: Person, y: TaxableYear) kind institutional {
    label en official "the limitations of subsection (c) do not apply to the move (section 217(g)(1))";
}
@source(IRC_S217_G, quote = "(1) the limitations under subsection (c) shall not apply;")
rule ArmedForcesMoveCLimitationsNotApply(p: Person, y: TaxableYear) strict {
    label en official "the subsection (c) limitations do not apply to a military move under orders (section 217(g)(1))";
    when armed_forces_member_on_active_duty_moving_under_order_pcs(p, y);
    then armed_forces_move_limitations_of_c_do_not_apply(p, y);
}
pub relation moving_and_storage_furnished_in_kind_or_reimbursed(p: Person, y: TaxableYear, furnished: Money, paid_or_incurred: Money) kind empirical {
    label en official "moving and storage expenses furnished in kind, or reimbursed or allowanced, to the member, spouse or dependents: the amount furnished and the expenses paid or incurred (section 217(g)(2))";
}
pub relation moving_storage_benefit_excluded_from_gross_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the moving and storage expenses furnished in kind (or reimbursement or allowance, only to the extent of the expenses paid or incurred) are not includible in gross income (section 217(g)(2))";
}
@source(IRC_S217_G, quote = "shall not be includible in gross income")
rule ArmedForcesInKindMovingBenefitExcluded(p: Person, y: TaxableYear, furnished: Money, paid: Money) defeasible {
    label en official "in-kind moving and storage benefits, and reimbursements only to the extent of the expenses paid or incurred, are excluded from gross income (section 217(g)(2))";
    when armed_forces_member_on_active_duty_moving_under_order_pcs(p, y);
    when moving_and_storage_furnished_in_kind_or_reimbursed(p, y, furnished, paid);
    then moving_storage_benefit_excluded_from_gross_income(p, y, min(furnished, paid));
}
pub relation spouse_or_dependent_moves_to_different_location(p: Person, y: TaxableYear, spouse: Person) kind empirical {
    label en official "moving and storage expenses are furnished to the member's spouse and dependents with regard to moving to (or from) a location other than the member's (section 217(g)(3))";
}
pub relation spouse_treated_as_commencing_work_at_new_principal_place_of_work(p: Person, y: TaxableYear, spouse: Person) kind institutional {
    label en official "section 217 applies to the spouse's and dependents' moving expenses as if the spouse commenced work as an employee at a new principal place of work at that location, without regard to subsection (c) (section 217(g)(3))";
}
@source(IRC_S217_G, quote = "as if his spouse commenced work as an employee at a new principal place of work at such location")
rule ArmedForcesSpouseDifferentLocation(p: Person, y: TaxableYear, spouse: Person) defeasible {
    label en official "a spouse or dependents moving to a different location are treated as commencing work there, with no subsection (c) limitation (section 217(g)(3))";
    when armed_forces_member_on_active_duty_moving_under_order_pcs(p, y);
    when spouse_or_dependent_moves_to_different_location(p, y, spouse);
    then spouse_treated_as_commencing_work_at_new_principal_place_of_work(p, y, spouse);
}

// --- (i): retirees and survivors -----------------------------------------------------------------------------------------------------------

pub relation former_workplace_and_residence_outside_united_states(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual's former principal place of work and former residence were outside the United States (section 217(i)(2)(A))";
}
pub relation move_to_new_us_residence_for_bona_fide_retirement(p: Person, y: TaxableYear) kind empirical {
    label en official "the move is to a new residence in the United States in connection with the bona fide retirement of the individual (section 217(i)(2)(B))";
}
pub relation qualified_retiree_moving_expenses(p: Person, y: TaxableYear) kind institutional {
    label en official "qualified retiree moving expenses within section 217(i)(2)";
}
@source(IRC_S217_I, quote = "which are incurred for a move to a new residence in the United States in connection with the bona fide retirement of the individual")
rule QualifiedRetireeMovingExpenses(p: Person, y: TaxableYear) defeasible {
    label en official "moving expenses of a retiree whose former workplace and residence were outside the United States, for a move to a United States residence on retirement (section 217(i)(2))";
    when former_workplace_and_residence_outside_united_states(p, y);
    when move_to_new_us_residence_for_bona_fide_retirement(p, y);
    then qualified_retiree_moving_expenses(p, y);
}
pub relation decedent_had_principal_place_of_work_outside_united_states_at_death(p: Person, y: TaxableYear, decedent: Person) kind empirical {
    label en official "the payer is the spouse or a dependent of a decedent who at death had a principal place of work outside the United States (section 217(i)(3)(A))";
}
pub relation survivor_move_begins_within_months_after_death(p: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months after the decedent's death by which the move begins (section 217(i)(3)(B))";
}
pub relation survivor_move_from_foreign_joint_residence_to_us_residence(p: Person, y: TaxableYear) kind empirical {
    label en official "the move is to a residence in the United States from a former residence outside the United States that was, at the time of death, the residence of the decedent and of the payer (section 217(i)(3)(B))";
}
pub relation qualified_survivor_moving_expenses(p: Person, y: TaxableYear) kind institutional {
    label en official "qualified survivor moving expenses within section 217(i)(3)";
}
@source(IRC_S217_I, quote = "which are incurred for a move which begins within 6 months after the death of such decedent")
rule QualifiedSurvivorMovingExpenses(p: Person, y: TaxableYear, decedent: Person, months: Integer) defeasible {
    label en official "moving expenses of a spouse or dependent of a decedent who worked abroad, for a move beginning within 6 months after death from the joint foreign residence to the United States (section 217(i)(3))";
    when decedent_had_principal_place_of_work_outside_united_states_at_death(p, y, decedent);
    when survivor_move_begins_within_months_after_death(p, y, months);
    when months <= 6;
    when survivor_move_from_foreign_joint_residence_to_us_residence(p, y);
    then qualified_survivor_moving_expenses(p, y);
}
pub relation time_condition_not_applicable_retiree_or_survivor(p: Person, y: TaxableYear) kind institutional {
    label en official "the limitations of subsection (c)(2) do not apply to qualified retiree or survivor moving expenses (section 217(i)(1)(B))";
}
@source(IRC_S217_I, quote = "the limitations of subsection (c)(2) shall not apply")
rule RetireeSurvivorTimeConditionNotApplicable(p: Person, y: TaxableYear) defeasible {
    label en official "qualified retiree or survivor moving expenses are not subject to the time condition (section 217(i)(1)(B))";
    when qualified_retiree_moving_expenses(p, y);
    then time_condition_not_applicable_retiree_or_survivor(p, y);
}
@source(IRC_S217_I, quote = "the limitations of subsection (c)(2) shall not apply")
rule SurvivorTimeConditionNotApplicable(p: Person, y: TaxableYear) defeasible {
    label en official "qualified survivor moving expenses are not subject to the time condition (section 217(i)(1)(B))";
    when qualified_survivor_moving_expenses(p, y);
    then time_condition_not_applicable_retiree_or_survivor(p, y);
}

// --- the deduction --------------------------------------------------------------------------------------------------------------------------------

pub relation moving_expense_deductible_217(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the moving expense allowed as a deduction under section 217(a) after subsections (b)-(d), (g), (h), (i) and the (k) suspension";
}
@source(IRC_S217_A, quote = "There shall be allowed as a deduction moving expenses paid or incurred during the taxable year")
rule MovingExpenseDeductibleWithConditions(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "a moving expense meeting (b), with the distance and time conditions of (c) satisfied, is deductible outside the (k) suspension";
    when qualified_moving_expense_217b(p, y, item, amount);
    when moving_conditions_of_subsection_c_met(p, y);
    when not_known(section_217k_suspension_applies(p, y, item));
    then moving_expense_deductible_217(p, y, item, amount);
}
@source(IRC_S217_D, quote = "The condition of subsection (c)(2) shall not apply if the taxpayer is unable to satisfy such condition")
rule MovingExpenseDeductibleTimeConditionWaived(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "where the time condition is waived by (d)(1) only the distance condition remains (section 217(d)(1))";
    when qualified_moving_expense_217b(p, y, item, amount);
    when moving_distance_condition_met(p, y);
    when time_condition_waived_217d1(p, y);
    when not_known(section_217k_suspension_applies(p, y, item));
    then moving_expense_deductible_217(p, y, item, amount);
}
@source(IRC_S217_D, quote = "then such expenses may (at the election of the taxpayer) be deducted for such taxable year notwithstanding subsection (c)(2)")
rule MovingExpenseDeductibleByElection(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "with a valid (d)(2) election only the distance condition remains";
    when qualified_moving_expense_217b(p, y, item, amount);
    when moving_distance_condition_met(p, y);
    when moving_expenses_deducted_by_217d2_election(p, y);
    when not_known(section_217k_suspension_applies(p, y, item));
    then moving_expense_deductible_217(p, y, item, amount);
}
@source(IRC_S217_G, quote = "the limitations under subsection (c) shall not apply")
rule MovingExpenseDeductibleArmedForces(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an Armed Forces move under orders is not subject to (c); the (k) suspension does not apply to it (section 217(g),(k))";
    when qualified_moving_expense_217b(p, y, item, amount);
    when armed_forces_move_limitations_of_c_do_not_apply(p, y);
    then moving_expense_deductible_217(p, y, item, amount);
}
@source(IRC_S217_I, quote = "this section (other than subsection (h)) shall be applied with respect to such expenses as if they were incurred in connection with the commencement of work by the taxpayer as an employee at a new principal place of work located within the United States")
rule MovingExpenseDeductibleRetireeOrSurvivor(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "qualified retiree or survivor moving expenses are deductible as if work began in the United States, without the time condition; the distance condition is applied (section 217(i)(1)), outside the (k) suspension";
    when qualified_moving_expense_217b(p, y, item, amount);
    when moving_distance_condition_met(p, y);
    when time_condition_not_applicable_retiree_or_survivor(p, y);
    when not_known(section_217k_suspension_applies(p, y, item));
    then moving_expense_deductible_217(p, y, item, amount);
}
