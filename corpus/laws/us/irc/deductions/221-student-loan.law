// Section 221 — Interest on education loans. Stage 1 (IRC-06), priority
// section. Scope: (a) allowance; (b)(1) the $2,500 cap; (b)(2) the MAGI
// phase-out ($50,000/$100,000 threshold, $15,000/$30,000 range); (c) the
// dependent exclusion.

use self::{
    DeductionKind,
    IRC_S221_B,
    IRC_S221_C,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation qualified_education_loan_interest_paid(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest paid by the taxpayer during the taxable year on a qualified education loan (section 221(a),(d)(1))";
}
pub relation modified_agi_for_221(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified adjusted gross income for section 221(b)(2)(C): AGI without regard to section 221 and sections 911/931/933, after application of sections 86/135/137/219/469";
}
pub relation claimed_as_dependent_151_for_221(p: Individual, y: TaxableYear) kind institutional {
    label en official "a section 151 deduction with respect to this individual is allowable to another taxpayer for a taxable year beginning in the calendar year this individual's taxable year begins (section 221(c)) — dependency contract, producer: unresolved (section 151, stage 2)";
}

@source(IRC_S221_C, quote = "No deduction shall be allowed by this section to an individual for the taxable year if a deduction under section 151 with respect to such individual is allowed to another taxpayer")
rule NoDeductionForDependent(p: Individual, y: TaxableYear, interest: Money) strict {
    label en official "no student loan interest deduction for an individual claimed as a dependent by another taxpayer (section 221(c))";
    when qualified_education_loan_interest_paid(p, y, interest);
    when claimed_as_dependent_151_for_221(p, y);
    then not deduction_allowed(p, y, Section221StudentLoanInterest, interest);
}

@source(IRC_S221_B, quote = "the deduction allowed by subsection (a) for the taxable year shall not exceed $2,500")
rule StudentLoanInterestCappedAtTwentyFiveHundred(p: Individual, y: TaxableYear, interest: Money, s: us.irc.income_individual::FilingStatus, magi: Money) strict {
    label en official "student loan interest is deductible up to $2,500, before the MAGI phase-out (section 221(b)(1))";
    when qualified_education_loan_interest_paid(p, y, interest);
    when not_known(claimed_as_dependent_151_for_221(p, y));
    when us.irc.income_individual::filing_status(p, y, s);
    when modified_agi_for_221(p, y, magi);
    when s != us.irc.income_individual::Joint;
    when magi <= 50000.00 USD;
    when interest <= 2500.00 USD;
    then deduction_allowed(p, y, Section221StudentLoanInterest, interest);
}
@source(IRC_S221_B, quote = "the deduction allowed by subsection (a) for the taxable year shall not exceed $2,500")
rule StudentLoanInterestExcessOverTwentyFiveHundredCapped(p: Individual, y: TaxableYear, interest: Money, s: us.irc.income_individual::FilingStatus, magi: Money) strict {
    label en official "student loan interest exceeding $2,500 is capped at $2,500, before the MAGI phase-out (section 221(b)(1))";
    when qualified_education_loan_interest_paid(p, y, interest);
    when not_known(claimed_as_dependent_151_for_221(p, y));
    when us.irc.income_individual::filing_status(p, y, s);
    when modified_agi_for_221(p, y, magi);
    when s != us.irc.income_individual::Joint;
    when magi <= 50000.00 USD;
    when interest > 2500.00 USD;
    then deduction_allowed(p, y, Section221StudentLoanInterest, 2500.00 USD);
}
@source(IRC_S221_B, quote = "The amount which would (but for this paragraph) be allowable as a deduction under this section shall be reduced (but not below zero) by the amount determined under subparagraph (B)")
rule StudentLoanInterestPhasedOutAboveMagiRange(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, magi: Money) strict {
    label en official "the student loan interest deduction is reduced to zero once MAGI reaches the threshold plus the $15,000 ($30,000 joint) phase-out range (section 221(b)(2))";
    when us.irc.income_individual::filing_status(p, y, s);
    when modified_agi_for_221(p, y, magi);
    when s != us.irc.income_individual::Joint;
    when magi >= 50000.00 USD + 15000.00 USD;
    then not deduction_allowed(p, y, Section221StudentLoanInterest, 2500.00 USD);
}
@source(IRC_S221_B, quote = "$100,000 in the case of a joint return")
rule StudentLoanInterestJointBelowThreshold(p: Individual, y: TaxableYear, interest: Money, s: us.irc.income_individual::FilingStatus, magi: Money) strict {
    label en official "for a joint return with MAGI at or below $100,000, student loan interest is deductible up to $2,500 (section 221(b)(1)-(2))";
    when qualified_education_loan_interest_paid(p, y, interest);
    when not_known(claimed_as_dependent_151_for_221(p, y));
    when us.irc.income_individual::filing_status(p, y, s);
    when modified_agi_for_221(p, y, magi);
    when s == us.irc.income_individual::Joint;
    when magi <= 100000.00 USD;
    when interest <= 2500.00 USD;
    then deduction_allowed(p, y, Section221StudentLoanInterest, interest);
}
// The linear phase-out for MAGI strictly within the $15,000/$30,000 range
// (section 221(b)(2)(B) ratio computation) stays "stage 2" — only the
// below-threshold and above-range edges are modelled, matching the same
// SIMPLIFICATION noted for section 199A's phase-in above.
