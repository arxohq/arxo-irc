// Section 263A regulation readers (IRC-G/G4, CFR wiring 27.09.2026).
//
// 26 CFR 1.263A-0..-15 is pinned phase-0 (us.cfr.t26_1_263a) — addressable,
// rule-less, not yet a dependency (registry/lock gap, g4unicap-skel STATUS).
// The case-selected relations below name the regulation content as applied;
// each rule derives the subsection consequence in parallel with the existing
// (b)/(i) scope path in `263a-unicap.law`, which is untouched. Covered rows
// stay EXTERNAL_DEPENDENCY (flip only after execution, owner gate step 6).
//
// Structural only: amounts and allocation ratios stay case facts elsewhere;
// no rates, thresholds or tables are copied from the regulation (SFA_STOP_NUMBER).
// -5 (qualified creative expenses) and -6 (foreign persons) are [Reserved] on
// the slice — pinned as is, no norm; the (h) reader below is statute-based.

// --- (a): capitalization requirement (1.263A-1: direct + allocable indirect) --

use self::{
    IRC_S263A_A,
    IRC_S263A_C,
    IRC_S263A_D,
    IRC_S263A_E,
    IRC_S263A_F,
    IRC_S263A_G,
    IRC_S263A_H,
    IRC_S263A_J,
    IRC_S263A_NOTE_6,
    Person,
    TaxableYear,
    section_263a_applies,
    section_263a_applies_to_property,
};

relation unicap_costs_described_a2_as_applied_1_263a_1(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item's costs, as applied under 26 CFR 1.263A-1(e), are the (a)(2) described costs — direct costs plus the property's properly allocable share of indirect costs (case-selected: the regulation content enters as case facts)";
}
pub relation unicap_costs_capitalized_under_reg_1_263a(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(a): the described costs are included in inventory costs (inventory property) or capitalized (other property) under the regulation";
}
@source(IRC_S263A_A, relation = formalizes, coverage = partial, quote = "In the case of any property to which this section applies, any costs described in paragraph (2)")
rule S263aACapitalizationViaReg1_263a strict {
    label en official "section 263A(a): regulation-described costs of property to which the section applies are inventory/capitalized costs";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies(p, y, item);
    when unicap_costs_described_a2_as_applied_1_263a_1(p, y, item);
    then unicap_costs_capitalized_under_reg_1_263a(p, y, item);
}

// --- (c): general exceptions -----------------------------------------------

relation unicap_statutory_exception_as_applied_263a_c(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a section 263A(c) general exception, as applied to the item for the year (personal-use property, section 174 amounts, listed deductible costs, long-term contract property and siblings — case-selected)";
}
pub relation section_263a_relief_under_exception_c(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(c): the section does not apply to the item for the year under the applied general exception";
}
@source(IRC_S263A_C, relation = formalizes, coverage = partial, quote = "This section shall not apply to any property produced by the taxpayer for use by the taxpayer")
rule S263aCExceptionViaReg1_263a strict {
    label en official "section 263A(c): the applied general exception relieves the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies_to_property(p, y, item);
    when unicap_statutory_exception_as_applied_263a_c(p, y, item);
    then section_263a_relief_under_exception_c(p, y, item);
}

// --- (d): farming business exception ----------------------------------------

relation unicap_farming_exception_as_applied_263a_d(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a section 263A(d) farming-business exception, as applied to the item for the year (qualifying animal/plant, taxpayer election and accounting-method limits per 1.263A-4 — case-selected)";
}
pub relation section_263a_relief_under_farming_exception_d(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(d): the section does not apply to the item for the year under the applied farming exception";
}
@source(IRC_S263A_D, relation = formalizes, coverage = partial, quote = "This section shall not apply to any of the following which is produced by the taxpayer in a farming business")
rule S263aDFarmingViaReg1_263a strict {
    label en official "section 263A(d): the applied farming exception relieves the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies_to_property(p, y, item);
    when unicap_farming_exception_as_applied_263a_d(p, y, item);
    then section_263a_relief_under_farming_exception_d(p, y, item);
}

// --- (e): plant elections / recapture ----------------------------------------

relation unicap_plant_election_as_applied_263a_e(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a section 263A(e) plant election and its recapture consequence, as applied to the item for the year (section 1245 treatment, recapture amount — case-selected)";
}
pub relation unicap_plant_election_consequence_263a_e(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(e): the applied plant election consequence (section 1245 property treatment and recapture) holds for the item for the year";
}
@source(IRC_S263A_E, relation = formalizes, coverage = partial, quote = "such plant (if not otherwise section 1245 property) shall be treated as section 1245 property")
rule S263aEPlantElectionViaReg1_263a strict {
    label en official "section 263A(e): the applied plant election consequence holds for the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies_to_property(p, y, item);
    when unicap_plant_election_as_applied_263a_e(p, y, item);
    then unicap_plant_election_consequence_263a_e(p, y, item);
}

// --- (f): interest capitalization (1.263A-8/-9: production period, avoided cost)

relation unicap_interest_costs_as_applied_263a_f(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "section 263A(f) interest costs, as applied to the item for the year (paid or incurred during the production period, allocable to (b)(1) property with a long useful life and siblings per 1.263A-8/-9 — case-selected)";
}
pub relation unicap_interest_capitalized_under_reg_1_263a_8(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(f): the applied interest costs are capitalized under the regulation for the item for the year";
}
@source(IRC_S263A_F, relation = formalizes, coverage = partial, quote = "Subsection (a) shall only apply to interest costs which are")
rule S263aFInterestViaReg1_263a strict {
    label en official "section 263A(f): the applied interest costs are capitalized for the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies(p, y, item);
    when unicap_interest_costs_as_applied_263a_f(p, y, item);
    then unicap_interest_capitalized_under_reg_1_263a_8(p, y, item);
}

// --- (g): "produce" definition ------------------------------------------------

relation unicap_produce_activity_as_applied_263a_g(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a section 263A(g) produce-activity, as applied to the item for the year (construct, build, install, manufacture, develop, improve, or contract production for the taxpayer — case-selected)";
}
pub relation unicap_treated_as_producing_263a_g(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(g): the taxpayer is treated as producing the item for the year under the applied produce-activity";
}
@source(IRC_S263A_G, relation = formalizes, coverage = partial, quote = "The term \"produce\" includes construct, build, install, manufacture, develop, or improve.")
rule S263aGProduceViaReg1_263a strict {
    label en official "section 263A(g): the applied produce-activity makes the taxpayer the producer of the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when unicap_produce_activity_as_applied_263a_g(p, y, item);
    then unicap_treated_as_producing_263a_g(p, y, item);
}

// --- (h): qualified creative expenses (statute-based; -5 is [Reserved]) --------

relation unicap_qualified_creative_expense_as_applied_263a_h(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a section 263A(h) qualified creative expense, as applied to the item for the year (free-lance author/photographer/artist trade-or-business expense, otherwise deductible — case-selected; 1.263A-5 is [Reserved], so the content is statute-based)";
}
pub relation unicap_creative_expense_excluded_263a_h(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(h): no capitalization of the applied qualified creative expense is required for the year";
}
@source(IRC_S263A_H, relation = formalizes, coverage = partial, quote = "Nothing in this section shall require the capitalization of any qualified creative expense.")
rule S263aHCreativeExpenseViaReg1_263a strict {
    label en official "section 263A(h): the applied qualified creative expense is excluded from capitalization for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies_to_property(p, y, item);
    when unicap_qualified_creative_expense_as_applied_263a_h(p, y, item);
    then unicap_creative_expense_excluded_263a_h(p, y, item);
}

// --- (j): regulatory mandate (1.263A-14 related persons; simplified procedures)

relation unicap_regulatory_coverage_as_applied_263a_j(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "section 263A(j) regulatory coverage, as applied to the item for the year (related-party/pass-thru anti-avoidance per 1.263A-14, simplified procedures for (b)(2) property — case-selected)";
}
pub relation unicap_regulatory_mandate_satisfied_263a_j(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 263A(j): the prescribed-regulations coverage holds for the item for the year under the applied mandate";
}
@source(IRC_S263A_J, relation = formalizes, coverage = partial, quote = "regulations to prevent the use of related parties, pass-thru entities, or intermediaries to avoid the application of this section")
rule S263aJRegulatoryMandateViaReg1_263a strict {
    label en official "section 263A(j): the applied regulatory coverage holds for the item for the year";
    for p: Person;
    for y: TaxableYear;
    for item: Integer;
    when section_263a_applies_to_property(p, y, item);
    when unicap_regulatory_coverage_as_applied_263a_j(p, y, item);
    then unicap_regulatory_mandate_satisfied_263a_j(p, y, item);
}

// --- notes 5/6: amendment applicability ----------------------------------------

relation unicap_amendment_effective_as_applied_263a_note(p: Person, y: TaxableYear) kind empirical {
    label en official "the section 263A amendment applicability notes, as applied to the taxpayer for the year (Pub. L. 99-514/101-239/106-170/108-357/109-58/114-113/115-97/116-94/116-260 effective-date notes — case-selected)";
}
pub relation unicap_amendment_version_applies_for_year_263a_note(p: Person, y: TaxableYear) kind institutional {
    label en official "section 263A notes: the amended version of the section applies to the taxpayer for the year under the applied applicability note";
}
@source(IRC_S263A_NOTE_6, relation = formalizes, coverage = partial, quote = "shall apply to costs incurred after December 31, 1986, in taxable years ending after such date")
rule S263aAmendmentAppliesViaNote strict {
    label en official "section 263A notes: the applied amendment applicability note fixes the section version for the year";
    for p: Person;
    for y: TaxableYear;
    when unicap_amendment_effective_as_applied_263a_note(p, y);
    then unicap_amendment_version_applies_for_year_263a_note(p, y);
}
