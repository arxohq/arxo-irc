// Section 213 — medical care: stage 2b detail (TECH_GAPS G2794): (c) expenses paid after death,
// (d) the definition of medical care (paragraphs (1)-(11)) and (e) the section 21 credit
// exclusion. The stage 1 `medical_care_expense_paid` stays the fact feeding the 7.5-percent floor;
// this module derives `medical_care_amount_213d` from the kinds of payment. Not modelled: the
// section 6013(d) marital status ((d)(8)), the section 1861(r) physician definition ((d)(4)),
// section 7702B definitions, the Secretary's more-appropriate cost adjustment as a value, and the
// published indexed premium limits (index values are facts).

use self::{
    IRC_S213_C,
    IRC_S213_D,
    IRC_S213_E,
    IRC_S213_TABLE_1,
    Individual,
    TaxableYear,
};

enum MedicalPaymentKind {
    DiagnosisCureTreatmentPrevention;
    TransportationForMedicalCare;
    QualifiedLongTermCareService;
    InsuranceCoveringMedicalCare;
    QualifiedLongTermCareContractPremium;
    LodgingAwayFromHome;
}

pub relation amount_paid_for_medical_purpose(p: Individual, y: TaxableYear, item: Integer, kind: MedicalPaymentKind, amount: Money) kind empirical {
    label en official "an amount paid during the taxable year for the medical purpose of the kind, for the taxpayer, spouse or dependent (section 213(d)(1))";
}
// SSA reader (IRC-G/G6, 2026-09-27): section 213(d)(4) physician means
// section 1861(r) of the Social Security Act (row 26/213/d/u13).
// Pattern G4/CFR: the SSA content enters as a case-selected fact; the
// from-package leg — reading pubs of `us.ssa.title42_values` (govinfo
// bytes pinned in corpus/laws/us/ssa-title42-values/sources/) — waits for
// registry + lock --write + flip (step 6, owner gate). The module header's
// "(d)(4) NOT modelled" note stands for full modelling; this reader covers
// only the external-dependency definition.
pub relation individual_practices_within_1861r_definition_213d4(p: Individual) kind empirical {
    label en unofficial "the individual is a physician within the meaning of section 1861(r) of the Social Security Act (42 USC 1395x(r)), case-asserted from the pinned text";
}
pub relation physician_213d4(p: Individual) kind institutional {
    label en official "section 213(d)(4): the individual is a physician";
}
@source(IRC_S213_D, relation = formalizes, coverage = partial, quote = "(4) Physician.—The term \"physician\" has the meaning given to such term by section 1861(r) of the Social Security Act (42 U.S.C. 1395x(r)).")
rule S213D4PhysicianWithin1861r(p: Individual) strict {
    label en official "section 213(d)(4): the asserted section 1861(r) physician is a physician";
    when individual_practices_within_1861r_definition_213d4(p);
    then physician_213d4(p);
}
pub relation procedure_is_cosmetic_surgery(item: Integer) kind empirical {
    label en official "the procedure is directed at improving the patient's appearance and does not meaningfully promote the proper function of the body or prevent or treat illness or disease (section 213(d)(9)(B))";
}
pub relation cosmetic_procedure_ameliorates_deformity(item: Integer) kind empirical {
    label en official "the surgery or procedure is necessary to ameliorate a deformity arising from, or directly related to, a congenital abnormality, a personal injury from an accident or trauma, or a disfiguring disease (section 213(d)(9)(A))";
}
pub relation cosmetic_surgery_excluded_from_medical_care(item: Integer) kind institutional {
    label en official "cosmetic surgery or a similar procedure not within the deformity exception is not medical care (section 213(d)(9)(A))";
}
@source(IRC_S213_D, quote = "The term \"medical care\" does not include cosmetic surgery or other similar procedures")
rule CosmeticSurgeryExcluded(item: Integer) defeasible {
    label en official "cosmetic surgery is excluded from medical care unless necessary to ameliorate a congenital, traumatic or disease-caused deformity (section 213(d)(9))";
    when procedure_is_cosmetic_surgery(item);
    when not_known(cosmetic_procedure_ameliorates_deformity(item));
    then cosmetic_surgery_excluded_from_medical_care(item);
}
pub relation medical_care_amount_213d(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the amount paid that is for medical care within section 213(d)";
}
@source(IRC_S213_D, quote = "for the diagnosis, cure, mitigation, treatment, or prevention of disease, or for the purpose of affecting any structure or function of the body")
rule MedicalCareDiagnosisTreatment(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "amounts paid for the diagnosis, cure, mitigation, treatment or prevention of disease or for affecting a structure or function of the body are medical care, except cosmetic surgery (section 213(d)(1)(A),(9))";
    when amount_paid_for_medical_purpose(p, y, item, DiagnosisCureTreatmentPrevention, amount);
    when not_known(cosmetic_surgery_excluded_from_medical_care(item));
    then medical_care_amount_213d(p, y, item, amount);
}
pub relation transportation_primarily_for_and_essential_to_medical_care(item: Integer) kind empirical {
    label en official "the transportation is primarily for and essential to medical care referred to in paragraph (1)(A) (section 213(d)(1)(B))";
}
@source(IRC_S213_D, quote = "for transportation primarily for and essential to medical care referred to in subparagraph (A)")
rule MedicalCareTransportation(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "transportation primarily for and essential to medical care is medical care (section 213(d)(1)(B))";
    when amount_paid_for_medical_purpose(p, y, item, TransportationForMedicalCare, amount);
    when transportation_primarily_for_and_essential_to_medical_care(item);
    then medical_care_amount_213d(p, y, item, amount);
}

// --- (d)(11): long-term care services by relatives -----------------------------------------------------------

pub relation ltc_service_provided_by_spouse_or_relative(item: Integer) kind empirical {
    label en official "the qualified long-term care service is provided by the spouse of the individual or by a relative (section 152(d)(2)(A)-(G)), directly or through an entity (section 213(d)(11)(A))";
}
pub relation ltc_service_provider_is_licensed_professional_for_service(item: Integer) kind empirical {
    label en official "the service is provided by a licensed professional with respect to such service (section 213(d)(11)(A))";
}
pub relation ltc_service_provided_by_related_corporation_or_partnership(item: Integer) kind empirical {
    label en official "the service is provided by a corporation or partnership related (within section 267(b) or 707(b)) to the individual (section 213(d)(11)(B))";
}
pub relation ltc_service_treated_as_not_medical_care(item: Integer) kind institutional {
    label en official "the qualified long-term care service is treated as not paid for medical care (section 213(d)(11))";
}
@source(IRC_S213_D, quote = "by the spouse of the individual or by a relative (directly or through a partnership, corporation, or other entity) unless the service is provided by a licensed professional with respect to such service")
rule LtcServiceByRelativeNotMedicalCare(item: Integer) defeasible {
    label en official "a service provided by the spouse or a relative is not medical care unless by a licensed professional (section 213(d)(11)(A))";
    when ltc_service_provided_by_spouse_or_relative(item);
    when not_known(ltc_service_provider_is_licensed_professional_for_service(item));
    then ltc_service_treated_as_not_medical_care(item);
}
@source(IRC_S213_D, quote = "by a corporation or partnership which is related (within the meaning of section 267(b) or 707(b)) to the individual")
rule LtcServiceByRelatedEntityNotMedicalCare(item: Integer) defeasible {
    label en official "a service provided by a related corporation or partnership is not medical care (section 213(d)(11)(B))";
    when ltc_service_provided_by_related_corporation_or_partnership(item);
    then ltc_service_treated_as_not_medical_care(item);
}
@source(IRC_S213_D, quote = "for qualified long-term care services (as defined in section 7702B(c))")
rule MedicalCareQualifiedLtcService(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "amounts paid for qualified long-term care services are medical care, except services within paragraph (11) (section 213(d)(1)(C),(11))";
    when amount_paid_for_medical_purpose(p, y, item, QualifiedLongTermCareService, amount);
    when not_known(ltc_service_treated_as_not_medical_care(item));
    then medical_care_amount_213d(p, y, item, amount);
}

// --- (d)(1)(D),(6),(7),(10): insurance ------------------------------------------------------------------------------

pub relation insurance_contract_covers_only_medical_care_1a_1b_1c(item: Integer) kind empirical {
    label en official "the insurance contract pays only for medical care referred to in paragraph (1)(A), (B) and (C)";
}
pub relation insurance_charge_separately_stated_in_contract_or_statement(item: Integer, charge: Money) kind empirical {
    label en official "the charge for the medical care coverage is separately stated in the contract or furnished in a separate statement (section 213(d)(6)(A))";
}
pub relation insurance_charge_unreasonably_large_relative_to_total(item: Integer) kind empirical {
    label en official "the separately stated charge is unreasonably large in relation to the total charges under the contract (section 213(d)(6)(C))";
}
@source(IRC_S213_D, quote = "for insurance (including amounts paid as premiums under part B of title XVIII of the Social Security Act")
rule MedicalCareInsuranceOnlyMedical(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "premiums for insurance covering medical care are medical care (section 213(d)(1)(D)); a contract covering only medical care needs no separate charge";
    when amount_paid_for_medical_purpose(p, y, item, InsuranceCoveringMedicalCare, amount);
    when insurance_contract_covers_only_medical_care_1a_1b_1c(item);
    then medical_care_amount_213d(p, y, item, amount);
}
@source(IRC_S213_D, quote = "the amount taken into account as the amount paid for such insurance shall not exceed such charge")
rule MedicalCareInsuranceMixedContractLimitedToSeparateCharge(p: Individual, y: TaxableYear, item: Integer, amount: Money, charge: Money) defeasible {
    label en official "for a contract also paying for other than medical care, only a separately stated charge counts, up to that charge, and not if unreasonably large (section 213(d)(6))";
    when amount_paid_for_medical_purpose(p, y, item, InsuranceCoveringMedicalCare, amount);
    when insurance_charge_separately_stated_in_contract_or_statement(item, charge);
    when not_known(insurance_contract_covers_only_medical_care_1a_1b_1c(item));
    when not_known(insurance_charge_unreasonably_large_relative_to_total(item));
    then medical_care_amount_213d(p, y, item, min(amount, charge));
}
pub relation attained_age_before_close_of_taxable_year(p: Individual, y: TaxableYear, age: Integer) kind empirical {
    label en official "the individual's attained age before the close of the taxable year (section 213(d)(10)(A))";
}
pub relation ltc_premium_base_limit(p: Individual, y: TaxableYear, base: Money) kind institutional {
    label en official "the unindexed limitation of the section 213(d)(10)(A) table for the individual's attained age";
}
@source(IRC_S213_TABLE_1, quote = "40 or less")
rule LtcPremiumLimitAge40OrLess(p: Individual, y: TaxableYear, age: Integer) strict {
    label en official "$200 for attained age 40 or less (section 213(d)(10)(A) table)";
    when attained_age_before_close_of_taxable_year(p, y, age);
    when age <= 40;
    then ltc_premium_base_limit(p, y, 200.00 USD);
}
@source(IRC_S213_TABLE_1, quote = "More than 40 but not more than 50 / 375")
rule LtcPremiumLimitAge41To50(p: Individual, y: TaxableYear, age: Integer) strict {
    label en official "$375 for attained age more than 40 but not more than 50 (section 213(d)(10)(A) table)";
    when attained_age_before_close_of_taxable_year(p, y, age);
    when age > 40;
    when age <= 50;
    then ltc_premium_base_limit(p, y, 375.00 USD);
}
@source(IRC_S213_TABLE_1, quote = "More than 50 but not more than 60 / 750")
rule LtcPremiumLimitAge51To60(p: Individual, y: TaxableYear, age: Integer) strict {
    label en official "$750 for attained age more than 50 but not more than 60 (section 213(d)(10)(A) table)";
    when attained_age_before_close_of_taxable_year(p, y, age);
    when age > 50;
    when age <= 60;
    then ltc_premium_base_limit(p, y, 750.00 USD);
}
@source(IRC_S213_TABLE_1, quote = "More than 60 but not more than 70 / 2,000")
rule LtcPremiumLimitAge61To70(p: Individual, y: TaxableYear, age: Integer) strict {
    label en official "$2,000 for attained age more than 60 but not more than 70 (section 213(d)(10)(A) table)";
    when attained_age_before_close_of_taxable_year(p, y, age);
    when age > 60;
    when age <= 70;
    then ltc_premium_base_limit(p, y, 2000.00 USD);
}
@source(IRC_S213_TABLE_1, quote = "More than 70 / 2,500")
rule LtcPremiumLimitAgeOver70(p: Individual, y: TaxableYear, age: Integer) strict {
    label en official "$2,500 for attained age more than 70 (section 213(d)(10)(A) table)";
    when attained_age_before_close_of_taxable_year(p, y, age);
    when age > 70;
    then ltc_premium_base_limit(p, y, 2500.00 USD);
}
pub relation medical_care_component_c_cpi_u_august_preceding_year(cy: Integer, index: Decimal) kind empirical {
    label en official "the medical care component of the C-CPI-U (section 1(f)(6)) for August of the preceding calendar year (section 213(d)(10)(B)(ii)(I))";
}
pub relation medical_care_component_cpi_august_1996_times_1f3b_amount(index: Decimal) kind empirical {
    label en official "such component of the CPI (section 1(f)(4)) for August of 1996, multiplied by the amount determined under section 1(f)(3)(B) (section 213(d)(10)(B)(ii)(II))";
}
pub relation medical_care_cost_adjustment(cy: Integer, adjustment: Decimal) kind institutional {
    label en official "the percentage by which the August C-CPI-U medical component exceeds the 1996 CPI base (section 213(d)(10)(B)(ii))";
}
@source(IRC_S213_D, quote = "the medical care cost adjustment for any calendar year is the percentage (if any) by which")
rule MedicalCareCostAdjustmentDerived(cy: Integer, current: Decimal, base: Decimal) strict {
    label en official "the adjustment is the excess of the current index over the base as a percentage of the base (no rounding named: exact to 8 places HALF_UP, JUDGMENT CALL)";
    when medical_care_component_c_cpi_u_august_preceding_year(cy, current);
    when medical_care_component_cpi_august_1996_times_1f3b_amount(base);
    when current > base;
    then medical_care_cost_adjustment(cy, div_round(current - base, base, 8, "HALF_UP"));
}
pub relation calendar_year_in_which_taxable_year_begins(y: TaxableYear, cy: Integer) kind empirical {
    label en official "the calendar year in which the taxable year begins";
}
pub relation ltc_premium_limit_for_year(p: Individual, y: TaxableYear, limit: Money) kind institutional {
    label en official "the section 213(d)(10) limitation for the taxable year, indexed for years after 1997 with the increase rounded to the nearest multiple of $10";
}
@source(IRC_S213_D, quote = "each dollar amount contained in subparagraph (A) shall be increased by the medical care cost adjustment of such amount for such calendar year")
rule LtcPremiumLimitIndexedAfter1997(p: Individual, y: TaxableYear, base: Money, cy: Integer, adjustment: Decimal) strict {
    label en official "for taxable years beginning after 1997 the table amount is increased by the adjustment, the increase rounded to the nearest multiple of $10 (section 213(d)(10)(B)(i))";
    when ltc_premium_base_limit(p, y, base);
    when calendar_year_in_which_taxable_year_begins(y, cy);
    when cy > 1997;
    when medical_care_cost_adjustment(cy, adjustment);
    then ltc_premium_limit_for_year(p, y, base + 10.00 USD * div_round(base * adjustment, 10.00 USD, 0, "HALF_UP"));
}
@source(IRC_S213_D, quote = "to the extent such amount does not exceed the limitation determined under the following table")
rule LtcPremiumLimitUnindexed1997(p: Individual, y: TaxableYear, base: Money, cy: Integer) strict {
    label en official "for a taxable year beginning in 1997 or earlier the table amount applies unindexed (section 213(d)(10)(A),(B)(i))";
    when ltc_premium_base_limit(p, y, base);
    when calendar_year_in_which_taxable_year_begins(y, cy);
    when cy <= 1997;
    then ltc_premium_limit_for_year(p, y, base);
}
pub relation eligible_long_term_care_premiums(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "eligible long-term care premiums: the amount paid for a qualified long-term care insurance contract, up to the age-based limitation (section 213(d)(10)(A))";
}
@source(IRC_S213_D, quote = "the term \"eligible long-term care premiums\" means the amount paid during a taxable year for any qualified long-term care insurance contract")
rule EligibleLtcPremiumsWithinLimit(p: Individual, y: TaxableYear, item: Integer, amount: Money, limit: Money) strict {
    label en official "the premiums are taken into account only up to the limitation (section 213(d)(10)(A),(1) last sentence)";
    when amount_paid_for_medical_purpose(p, y, item, QualifiedLongTermCareContractPremium, amount);
    when ltc_premium_limit_for_year(p, y, limit);
    then eligible_long_term_care_premiums(p, y, item, min(amount, limit));
}
@source(IRC_S213_D, quote = "only eligible long-term care premiums (as defined in paragraph (10)) shall be taken into account under subparagraph (D)")
rule MedicalCareQualifiedLtcContractPremiums(p: Individual, y: TaxableYear, item: Integer, eligible: Money) defeasible {
    label en official "for a qualified long-term care insurance contract only the eligible premiums are medical care (section 213(d)(1)(D))";
    when eligible_long_term_care_premiums(p, y, item, eligible);
    then medical_care_amount_213d(p, y, item, eligible);
}
pub relation premium_paid_before_age_65_for_coverage_after_65(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "premiums paid during the taxable year by a taxpayer before he attains age 65 for insurance covering medical care for the taxpayer, spouse or a dependent after the taxpayer attains 65 (section 213(d)(7))";
}
pub relation prepaid_premium_payment_period_years(item: Integer, years: Integer) kind empirical {
    label en official "the level-payment period, in years, over which the premiums are payable under the contract (section 213(d)(7))";
}
pub relation premiums_payable_until_year_taxpayer_attains_65(item: Integer) kind empirical {
    label en official "the premiums are payable until the year in which the taxpayer attains the age of 65 (section 213(d)(7))";
}
@source(IRC_S213_D, quote = "shall be treated as expenses paid during the taxable year for insurance which constitutes medical care if premiums for such insurance are payable (on a level payment basis) under the contract for a period of 10 years or more")
rule PrepaidInsurancePremiumsTenYears(p: Individual, y: TaxableYear, item: Integer, amount: Money, years: Integer) defeasible {
    label en official "premiums paid before 65 for coverage after 65 are insurance that is medical care if payable level for 10 years or more (section 213(d)(7))";
    when premium_paid_before_age_65_for_coverage_after_65(p, y, item, amount);
    when prepaid_premium_payment_period_years(item, years);
    when years >= 10;
    then medical_care_amount_213d(p, y, item, amount);
}
@source(IRC_S213_D, quote = "or until the year in which the taxpayer attains the age of 65 (but in no case for a period of less than 5 years)")
rule PrepaidInsurancePremiumsUntilAge65Min5Years(p: Individual, y: TaxableYear, item: Integer, amount: Money, years: Integer) defeasible {
    label en official "premiums payable until the year the taxpayer attains 65, but never for less than 5 years (section 213(d)(7))";
    when premium_paid_before_age_65_for_coverage_after_65(p, y, item, amount);
    when premiums_payable_until_year_taxpayer_attains_65(item);
    when prepaid_premium_payment_period_years(item, years);
    when years >= 5;
    then medical_care_amount_213d(p, y, item, amount);
}

// --- (d)(2): lodging away from home -----------------------------------------------------------------------------------

pub relation lodging_paid_away_from_home_for_medical_care(p: Individual, y: TaxableYear, item: Integer, amount: Money, nights: Integer, individuals: Integer) kind empirical {
    label en official "amounts paid for lodging (not lavish or extravagant) while away from home primarily for and essential to medical care, with the number of nights and individuals (section 213(d)(2))";
}
pub relation lodging_care_provided_by_physician_in_licensed_hospital_or_equivalent(item: Integer) kind empirical {
    label en official "the medical care is provided by a physician in a licensed hospital or a related or equivalent medical care facility (section 213(d)(2)(A))";
}
pub relation travel_has_significant_element_of_personal_pleasure_recreation_or_vacation(item: Integer) kind empirical {
    label en official "there is a significant element of personal pleasure, recreation or vacation in the travel away from home (section 213(d)(2)(B))";
}
@source(IRC_S213_D, quote = "The amount taken into account under the preceding sentence shall not exceed $50 for each night for each individual.")
rule MedicalCareLodgingLimitedTo50PerNightPerIndividual(p: Individual, y: TaxableYear, item: Integer, amount: Money, nights: Integer, people: Integer) defeasible {
    label en official "lodging while away from home for medical care is medical care up to $50 for each night for each individual, if the care is by a physician in a hospital-type facility and the travel has no significant element of pleasure (section 213(d)(2))";
    when lodging_paid_away_from_home_for_medical_care(p, y, item, amount, nights, people);
    when lodging_care_provided_by_physician_in_licensed_hospital_or_equivalent(item);
    when not_known(travel_has_significant_element_of_personal_pleasure_recreation_or_vacation(item));
    then medical_care_amount_213d(p, y, item, min(amount, 50.00 USD * nights * people));
}

// --- (d)(3),(5): prescribed drug, divorced parents ----------------------------------------------------------------------

pub relation drug_or_biological_requires_physician_prescription_for_use(item: Integer) kind empirical {
    label en official "the drug or biological requires a prescription of a physician for its use by an individual (section 213(d)(3))";
}
pub relation prescribed_drug_213d3(item: Integer) kind institutional {
    label en official "a prescribed drug within section 213(d)(3)";
}
@source(IRC_S213_D, quote = "The term \"prescribed drug\" means a drug or biological which requires a prescription of a physician for its use by an individual.")
rule PrescribedDrugDefinition(item: Integer) strict {
    label en official "a drug or biological requiring a physician's prescription for use is a prescribed drug (section 213(d)(3))";
    when drug_or_biological_requires_physician_prescription_for_use(item);
    then prescribed_drug_213d3(item);
}
pub relation child_to_whom_152e_applies(child: Individual, parent1: Individual, parent2: Individual) kind empirical {
    label en official "the child is one to whom section 152(e) applies, with the two parents (section 213(d)(5))";
}
pub relation dependent_for_section_213(child: Individual, parent: Individual) kind institutional {
    label en official "the child is treated as a dependent of the parent for purposes of section 213 (section 213(d)(5))";
}
@source(IRC_S213_D, quote = "Any child to whom section 152(e) applies shall be treated as a dependent of both parents for purposes of this section.")
rule ChildOfDivorcedParentsDependentOfBoth(child: Individual, parent1: Individual, parent2: Individual) strict {
    label en official "a child to whom section 152(e) applies is a dependent of both parents for section 213 (section 213(d)(5))";
    when child_to_whom_152e_applies(child, parent1, parent2);
    then dependent_for_section_213(child, parent1);
}
@source(IRC_S213_D, quote = "Any child to whom section 152(e) applies shall be treated as a dependent of both parents for purposes of this section.")
rule ChildOfDivorcedParentsDependentOfBothSecond(child: Individual, parent1: Individual, parent2: Individual) strict {
    label en official "a child to whom section 152(e) applies is a dependent of both parents for section 213 (section 213(d)(5)), the second parent";
    when child_to_whom_152e_applies(child, parent1, parent2);
    then dependent_for_section_213(child, parent2);
}

// --- (d)(10) last paragraph: the Secretary's prescribed adjustment ---------------------------------------------------------

pub relation secretary_prescribed_more_appropriate_adjustment_for_213d10(cy: Integer) kind empirical {
    label en official "the Secretary, in consultation with the Secretary of Health and Human Services, has prescribed an adjustment more appropriate than the CPI-based adjustment for the calendar year (section 213(d)(10)(B) last sentence)";
}
pub relation calendar_year_requires_213d10_prescribed_adjustment(cy: Integer) kind empirical {
    label en official "the calendar year for which an adjustment is to be prescribed";
}
rule SecretaryPrescribeAdjustment213d10Duty defeasible {
    for cy: Integer;
    when calendar_year_requires_213d10_prescribed_adjustment(cy);
    then duty S213dPrescribeMoreAppropriateAdjustment {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_prescribed_more_appropriate_adjustment_for_213d10(cy);
            window [-infinity, infinity];
        }
    };
}

// --- (c): expenses paid after death -------------------------------------------------------------------------------------------

pub relation decedent_medical_expense_paid_out_of_estate(p: Individual, item: Integer, paid_on: Date, death_date: Date, amount: Money, incurred_year: TaxableYear) kind empirical {
    label en official "expenses for the medical care of the taxpayer paid out of his estate on the date, with the death date and the year in which they were incurred (section 213(c)(1))";
}
pub relation allowable_as_estate_deduction_under_2053(item: Integer) kind empirical {
    label en official "the amount paid is allowable under section 2053 as a deduction in computing the taxable estate of the decedent (section 213(c)(2))";
}
pub relation statement_not_allowed_under_2053_filed(item: Integer) kind empirical {
    label en official "a statement that the amount has not been allowed as a deduction under section 2053 is filed within the time and in the manner prescribed (section 213(c)(2)(A))";
}
pub relation waiver_of_2053_deduction_filed(item: Integer) kind empirical {
    label en official "a waiver of the right to have the amount allowed at any time as a deduction under section 2053 is filed (section 213(c)(2)(B))";
}
pub relation section_2053_statement_and_waiver_filed(item: Integer) kind institutional {
    label en official "both the statement and the waiver of section 213(c)(2)(A),(B) are filed";
}
rule StatementAndWaiverFiledDerived(item: Integer) strict {
    label en official "the statement and the waiver are both filed (section 213(c)(2))";
    when statement_not_allowed_under_2053_filed(item);
    when waiver_of_2053_deduction_filed(item);
    then section_2053_statement_and_waiver_filed(item);
}
pub relation medical_expense_treated_as_paid_by_taxpayer_when_incurred(p: Individual, item: Integer, incurred_year: TaxableYear, amount: Money) kind institutional {
    label en official "the expense paid out of the estate within one year after death is treated as paid by the taxpayer at the time incurred (section 213(c)(1))";
}
@source(IRC_S213_C, quote = "which are paid out of his estate during the 1-year period beginning with the day after the date of his death shall be treated as paid by the taxpayer at the time incurred")
rule DecedentMedicalExpensePaidWithinYearAfterDeathTreatedAsIncurred(p: Individual, item: Integer, paid_on: Date, death: Date, amount: Money, incurred_year: TaxableYear) defeasible {
    label en official "medical expenses paid out of the estate in the year beginning the day after death are treated as paid by the decedent when incurred, unless barred by section 2053 without a statement and waiver (section 213(c)(1),(2))";
    when decedent_medical_expense_paid_out_of_estate(p, item, paid_on, death, amount, incurred_year);
    when paid_on > death;
    when paid_on <= add_calendar_period(death, 1 calendar_year);
    when not_known(estate_deduction_2053_bars_213c_treatment(item));
    then medical_expense_treated_as_paid_by_taxpayer_when_incurred(p, item, incurred_year, amount);
}
pub relation estate_deduction_2053_bars_213c_treatment(item: Integer) kind institutional {
    label en official "paragraph (1) does not apply because the amount is allowable under section 2053 and no statement and waiver are filed (section 213(c)(2))";
}
@source(IRC_S213_C, quote = "Paragraph (1) shall not apply if the amount paid is allowable under section 2053 as a deduction in computing the taxable estate of the decedent")
rule Estate2053BarsTreatmentWithoutStatementAndWaiver(item: Integer) defeasible {
    label en official "an amount allowable under section 2053 is not treated as paid by the taxpayer unless the statement and the waiver are filed (section 213(c)(2))";
    when allowable_as_estate_deduction_under_2053(item);
    when not_known(section_2053_statement_and_waiver_filed(item));
    then estate_deduction_2053_bars_213c_treatment(item);
}

// --- (e): the section 21 credit ---------------------------------------------------------------------------------------------------

pub relation expense_allowed_as_credit_under_section_21(item: Integer) kind empirical {
    label en official "the expense is allowed as a credit under section 21 (dependent care) (section 213(e))";
}
pub relation expense_treated_as_paid_for_medical_care(item: Integer) kind institutional {
    label en official "the expense is treated as an expense paid for medical care (section 213)";
}
@source(IRC_S213_E, quote = "Any expense allowed as a credit under section 21 shall not be treated as an expense paid for medical care.")
rule Section21CreditExpenseNotMedicalCare(item: Integer) strict {
    label en official "an expense allowed as a section 21 credit is not an expense paid for medical care (section 213(e))";
    when expense_allowed_as_credit_under_section_21(item);
    then not expense_treated_as_paid_for_medical_care(item);
}
