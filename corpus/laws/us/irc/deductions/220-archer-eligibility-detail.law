// Section 220 — Archer MSAs: stage 2b, part 1: eligibility inputs (G2762, G2763) and the cut-off
// machinery of subsections (i) and (j) (G2764). Four stage 1 relations became institutional so that a
// case may still assert them while the rules below derive them: `covered_by_other_overlapping_health_plan`,
// `hdhp_established_by_small_employer_or_self_employed`,
// `active_msa_participant_or_new_participant_of_participating_employer` and
// `distribution_is_rollover_or_excess_contribution_return`. The cut-off year is the earlier of 2007 and
// the first year before 2007 for which the numerical limitation is exceeded (computed from the counts of
// (j)); the stage 1 rules keep the 2007 windows on the taxable-year start date, this part adds the
// earlier cut-off years and the cut-off dates.

// --- (c)(3): permitted insurance ---------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S220_B,
    IRC_S220_C,
    IRC_S220_I,
    IRC_S220_J,
    Individual,
    Person,
    TaxableYear,
    covered_by_high_deductible_health_plan_first_day_of_month,
    covered_by_other_overlapping_health_plan,
    hdhp_established_by_small_employer_or_self_employed,
    medicare_entitled_from_month,
    taxable_year_begins_on,
};

pub relation insurance_substantially_all_coverage_workers_compensation(policy: Integer) kind empirical {
    label en official "substantially all of the coverage relates to liabilities incurred under workers' compensation laws (section 220(c)(3)(A)(i))";
}
pub relation insurance_substantially_all_coverage_tort_liabilities(policy: Integer) kind empirical {
    label en official "substantially all of the coverage relates to tort liabilities (section 220(c)(3)(A)(ii))";
}
pub relation insurance_substantially_all_coverage_ownership_or_use_of_property(policy: Integer) kind empirical {
    label en official "substantially all of the coverage relates to liabilities relating to ownership or use of property (section 220(c)(3)(A)(iii))";
}
pub relation insurance_substantially_all_coverage_other_liability_specified_by_regulations(policy: Integer) kind empirical {
    label en official "substantially all of the coverage relates to such other similar liabilities as the Secretary specifies by regulations (section 220(c)(3)(A)(iv))";
}
pub relation insurance_for_specified_disease_or_illness(policy: Integer) kind empirical {
    label en official "insurance for a specified disease or illness (section 220(c)(3)(B))";
}
pub relation insurance_paying_fixed_amount_per_period_of_hospitalization(policy: Integer) kind empirical {
    label en official "insurance paying a fixed amount per day (or other period) of hospitalization (section 220(c)(3)(C))";
}
pub relation permitted_insurance_220(policy: Integer) kind institutional {
    label en official "permitted insurance within section 220(c)(3)";
}
@source(IRC_S220_C, quote = "(i) liabilities incurred under workers' compensation laws,")
rule PermittedInsuranceWorkersCompensation(policy: Integer) strict {
    label en official "insurance substantially all for workers' compensation liabilities is permitted (section 220(c)(3)(A)(i))";
    when insurance_substantially_all_coverage_workers_compensation(policy);
    then permitted_insurance_220(policy);
}
@source(IRC_S220_C, quote = "(ii) tort liabilities,")
rule PermittedInsuranceTortLiabilities(policy: Integer) strict {
    label en official "insurance substantially all for tort liabilities is permitted (section 220(c)(3)(A)(ii))";
    when insurance_substantially_all_coverage_tort_liabilities(policy);
    then permitted_insurance_220(policy);
}
@source(IRC_S220_C, quote = "(iii) liabilities relating to ownership or use of property, or")
rule PermittedInsuranceOwnershipOrUseOfProperty(policy: Integer) strict {
    label en official "insurance substantially all for liabilities of ownership or use of property is permitted (section 220(c)(3)(A)(iii))";
    when insurance_substantially_all_coverage_ownership_or_use_of_property(policy);
    then permitted_insurance_220(policy);
}
@source(IRC_S220_C, quote = "(iv) such other similar liabilities as the Secretary may specify by regulations,")
rule PermittedInsuranceOtherLiabilityByRegulation(policy: Integer) strict {
    label en official "insurance substantially all for liabilities specified by regulations is permitted (section 220(c)(3)(A)(iv))";
    when insurance_substantially_all_coverage_other_liability_specified_by_regulations(policy);
    then permitted_insurance_220(policy);
}
@source(IRC_S220_C, quote = "(B) insurance for a specified disease or illness, and")
rule PermittedInsuranceSpecifiedDisease(policy: Integer) strict {
    label en official "insurance for a specified disease or illness is permitted (section 220(c)(3)(B))";
    when insurance_for_specified_disease_or_illness(policy);
    then permitted_insurance_220(policy);
}
@source(IRC_S220_C, quote = "(C) insurance paying a fixed amount per day (or other period) of hospitalization.")
rule PermittedInsuranceFixedAmountHospitalization(policy: Integer) strict {
    label en official "insurance paying a fixed amount per day of hospitalization is permitted (section 220(c)(3)(C))";
    when insurance_paying_fixed_amount_per_period_of_hospitalization(policy);
    then permitted_insurance_220(policy);
}

// --- (c)(1)(A)(ii),(B): overlapping coverage --------------------------------------------------------------------------------------------------

pub relation other_plan_coverage_of_hdhp_benefit(p: Individual, y: TaxableYear, month: Integer, plan: Integer) kind empirical {
    label en official "while covered under a high deductible health plan the individual is covered under another health plan that is not a high deductible health plan and provides coverage for a benefit covered by the high deductible health plan (section 220(c)(1)(A)(ii))";
}
pub relation plan_coverage_is_of_disregarded_kind(plan: Integer) kind empirical {
    label en official "the coverage is for accidents, disability, dental care, vision care or long-term care, through insurance or otherwise (section 220(c)(1)(B)(ii))";
}
pub relation plan_coverage_is_permitted_insurance_benefit(plan: Integer) kind empirical {
    label en official "the coverage is for a benefit provided by permitted insurance (section 220(c)(1)(B)(i))";
}
@source(IRC_S220_C, quote = "Subparagraph (A)(ii) shall be applied without regard to")
rule OverlappingCoverageDisqualifiesUnlessDisregarded(p: Individual, y: TaxableYear, month: Integer, plan: Integer) strict {
    label en official "other coverage of an HDHP benefit disqualifies unless it is permitted insurance or of a disregarded kind (section 220(c)(1)(A)(ii),(B))";
    when other_plan_coverage_of_hdhp_benefit(p, y, month, plan);
    when not_known(plan_coverage_is_of_disregarded_kind(plan));
    when not_known(plan_coverage_is_permitted_insurance_benefit(plan));
    then covered_by_other_overlapping_health_plan(p, y, month);
}

// --- (c)(4): small employer -----------------------------------------------------------------------------------------------------------------------

pub relation average_employees_on_business_days(employer: Person, cy: Integer, average: Integer) kind empirical {
    label en official "the average number of employees the employer employed on business days during the calendar year (section 220(c)(4)(A))";
}
pub relation employer_in_existence_throughout_year(employer: Person, cy: Integer) kind empirical {
    label en official "the employer was in existence throughout the calendar year (section 220(c)(4)(A) last sentence)";
}
pub relation reasonably_expected_average_employees_current_year(employer: Person, cy: Integer, expected: Integer) kind empirical {
    label en official "the average number of employees reasonably expected on business days in the current calendar year, for an employer not in existence throughout the 1st preceding calendar year (section 220(c)(4)(B))";
}
pub relation small_employer_by_preceding_year_average(employer: Person, cy: Integer) kind institutional {
    label en official "the employer employed an average of 50 or fewer employees on business days during either of the 2 preceding calendar years (each considered only if the employer existed throughout it) (section 220(c)(4)(A))";
}
@source(IRC_S220_C, quote = "employed an average of 50 or fewer employees on business days during either of the 2 preceding calendar years")
rule SmallEmployerFirstPrecedingYear(employer: Person, preceding: Integer, average: Integer) strict {
    label en official "50 or fewer employees on average in the 1st preceding year, which the employer existed throughout (section 220(c)(4)(A))";
    when employer_in_existence_throughout_year(employer, preceding);
    when average_employees_on_business_days(employer, preceding, average);
    when average <= 50;
    then small_employer_by_preceding_year_average(employer, preceding + 1);
}
@source(IRC_S220_C, quote = "employed an average of 50 or fewer employees on business days during either of the 2 preceding calendar years")
rule SmallEmployerSecondPrecedingYear(employer: Person, preceding: Integer, average: Integer) strict {
    label en official "50 or fewer employees on average in the 2nd preceding year, which the employer existed throughout (section 220(c)(4)(A))";
    when employer_in_existence_throughout_year(employer, preceding);
    when average_employees_on_business_days(employer, preceding, average);
    when average <= 50;
    then small_employer_by_preceding_year_average(employer, preceding + 2);
}
pub relation small_employer_220(employer: Person, cy: Integer) kind institutional {
    label en official "a small employer for the calendar year within section 220(c)(4)";
}
rule SmallEmployerFromPrecedingYears(employer: Person, cy: Integer) strict {
    label en official "a small employer by the preceding-year test (section 220(c)(4)(A))";
    when small_employer_by_preceding_year_average(employer, cy);
    then small_employer_220(employer, cy);
}
@source(IRC_S220_C, quote = "the determination under subparagraph (A) shall be based on the average number of employees that it is reasonably expected such employer will employ on business days in the current calendar year")
rule SmallEmployerNotInExistenceFirstPrecedingYear(employer: Person, cy: Integer, expected: Integer) strict {
    label en official "an employer not in existence throughout the 1st preceding year is small if it reasonably expects 50 or fewer employees on average in the current year (section 220(c)(4)(B))";
    when reasonably_expected_average_employees_current_year(employer, cy, expected);
    when expected <= 50;
    when not_known(employer_in_existence_throughout_year(employer, cy - 1));
    then small_employer_220(employer, cy);
}
pub relation met_small_employer_test_for_preceding_year_after_1996(employer: Person, preceding: Integer) kind empirical {
    label en official "the employer met the requirement of subparagraph (A) (without regard to (B)) for a preceding calendar year after 1996 (section 220(c)(4)(C)(i))";
}
pub relation amount_contributed_to_employee_archer_msa_excludable_or_deductible_in_year(employer: Person, preceding: Integer) kind empirical {
    label en official "an amount was contributed to the Archer MSA of an employee for coverage under the employer's high deductible health plan during the preceding year, excludable under section 106(b) or allowable as a deduction (section 220(c)(4)(C)(ii))";
}
pub relation average_employees_at_most_200_each_preceding_year_after_1996(employer: Person, cy: Integer) kind empirical {
    label en official "the employer employed an average of 200 or fewer employees on business days during each preceding calendar year after 1996 (section 220(c)(4)(C)(iii))";
}
@source(IRC_S220_C, quote = "The term \"small employer\" includes, with respect to any calendar year, any employer if")
rule SmallEmployerGrowingEmployerRetainsTreatment(employer: Person, cy: Integer, preceding: Integer) strict {
    label en official "a growing employer retains small employer treatment where it met the 50-employee test in a preceding year after 1996, made excludable/deductible Archer MSA contributions that year and stayed at 200 or fewer employees (section 220(c)(4)(C))";
    when met_small_employer_test_for_preceding_year_after_1996(employer, preceding);
    when preceding > 1996;
    when preceding < cy;
    when amount_contributed_to_employee_archer_msa_excludable_or_deductible_in_year(employer, preceding);
    when average_employees_at_most_200_each_preceding_year_after_1996(employer, cy);
    then small_employer_220(employer, cy);
}
pub relation employers_treated_as_single_employer_414(employer1: Person, employer2: Person) kind empirical {
    label en official "all persons treated as a single employer under subsection (b), (c), (m) or (o) of section 414 (section 220(c)(4)(D)(i))";
}
pub relation employer_is_predecessor_of(predecessor: Person, employer: Person) kind empirical {
    label en official "the predecessor of the employer (section 220(c)(4)(D)(ii))";
}
pub relation same_employer_for_small_employer_test(employer1: Person, employer2: Person) kind institutional {
    label en official "the two persons are one employer (controlled group) or an employer and its predecessor for the small employer test (section 220(c)(4)(D))";
}
@source(IRC_S220_C, quote = "all persons treated as a single employer under subsection (b), (c), (m), or (o) of section 414 shall be treated as 1 employer")
rule ControlledGroupOneEmployer(employer1: Person, employer2: Person) strict {
    label en official "persons treated as a single employer under section 414 are one employer (section 220(c)(4)(D)(i))";
    when employers_treated_as_single_employer_414(employer1, employer2);
    then same_employer_for_small_employer_test(employer1, employer2);
}
@source(IRC_S220_C, quote = "Any reference in this paragraph to an employer shall include a reference to any predecessor of such employer.")
rule PredecessorIncludedInEmployer(employer: Person, predecessor: Person) strict {
    label en official "a predecessor is included in the reference to the employer (section 220(c)(4)(D)(ii)); the year facts of a predecessor are asserted for the employer";
    when employer_is_predecessor_of(predecessor, employer);
    then same_employer_for_small_employer_test(employer, predecessor);
}

// --- (c)(1)(A)(iii),(C): plan sponsor -----------------------------------------------------------------------------------------------------------

pub relation hdhp_established_and_maintained_by_employer_of_individual_or_spouse(p: Individual, y: TaxableYear, employer: Person) kind empirical {
    label en official "the high deductible health plan covering the individual is established and maintained by the employer of the individual or of the individual's spouse (section 220(c)(1)(A)(iii)(I))";
}
pub relation calendar_year_of_taxable_year_220(y: TaxableYear, cy: Integer) kind empirical {
    label en official "the calendar year in which the taxable year begins (for the small employer test)";
}
pub relation individual_is_employee_or_spouse_of_employee_401c1_without_employer_plan(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is an employee within section 401(c)(1) (self-employed) or the spouse of such an employee and the high deductible health plan is not established or maintained by any employer of the individual or spouse (section 220(c)(1)(A)(iii)(II))";
}
pub relation employer_ceased_to_be_small_employer_but_employee_continues(p: Individual, y: TaxableYear, employer: Person) kind empirical {
    label en official "while the employer was a small employer an amount excludable under section 106(b) or deductible under this section was contributed to the Archer MSA of the individual (an employee or an employee's spouse), the employer later ceased to be a small employer and the employee continues to be an employee of that employer (section 220(c)(1)(C))";
}
@source(IRC_S220_C, quote = "the high deductible health plan covering such individual is established and maintained by the employer of such individual or of the spouse of such individual and such employer is a small employer")
rule HdhpByEmployerThatIsSmallEmployer(p: Individual, y: TaxableYear, employer: Person, cy: Integer) strict {
    label en official "a plan of the individual's or spouse's small employer satisfies the sponsor requirement (section 220(c)(1)(A)(iii)(I))";
    when hdhp_established_and_maintained_by_employer_of_individual_or_spouse(p, y, employer);
    when calendar_year_of_taxable_year_220(y, cy);
    when small_employer_220(employer, cy);
    then hdhp_established_by_small_employer_or_self_employed(p, y);
}
@source(IRC_S220_C, quote = "such individual shall not cease to meet the requirement of subparagraph (A)(iii)(I) by reason of such employer ceasing to be a small employer so long as such employee continues to be an employee of such employer")
rule ContinuedEligibilityAfterEmployerNoLongerSmall(p: Individual, y: TaxableYear, employer: Person) strict {
    label en official "an employee with a prior excludable/deductible contribution keeps meeting the sponsor requirement after the employer stops being a small employer, while still employed by it (section 220(c)(1)(C))";
    when employer_ceased_to_be_small_employer_but_employee_continues(p, y, employer);
    when hdhp_established_and_maintained_by_employer_of_individual_or_spouse(p, y, employer);
    then hdhp_established_by_small_employer_or_self_employed(p, y);
}
@source(IRC_S220_C, quote = "such individual is an employee (within the meaning of section 401(c)(1)) or the spouse of such an employee and the high deductible health plan covering such individual is not established or maintained by any employer of such individual or spouse")
rule HdhpOfSelfEmployedIndividual(p: Individual, y: TaxableYear) strict {
    label en official "a self-employed individual (or spouse) with a plan not sponsored by an employer satisfies the sponsor requirement (section 220(c)(1)(A)(iii)(II))";
    when individual_is_employee_or_spouse_of_employee_401c1_without_employer_plan(p, y);
    then hdhp_established_by_small_employer_or_self_employed(p, y);
}

// --- (b)(3),(7): married individuals and Medicare ------------------------------------------------------------------------------------------------

pub relation married_and_either_spouse_has_family_hdhp_coverage(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individuals are married to each other and either spouse has family coverage (section 220(b)(3))";
}
pub relation lowest_family_annual_deductible_among_spouses(p: Individual, y: TaxableYear, deductible: Money) kind empirical {
    label en official "the lowest annual deductible among the family coverages of the spouses (section 220(b)(3)(A))";
}
pub relation family_coverage_months_for_married_220(p: Individual, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months the individual is an eligible individual with family coverage (section 220(b)(3))";
}
pub relation spouses_agree_on_division_220(p: Individual, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the spouses agree on a different division of the limitation: this individual's share (section 220(b)(3)(B))";
}
pub relation married_archer_msa_limitation_for_individual(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 220(b)(1) limitation of a married individual: the family limitation computed with the lowest family deductible, divided equally unless the spouses agree otherwise (section 220(b)(3))";
}
@source(IRC_S220_B, quote = "the limitation under paragraph (1) (after the application of subparagraph (A) of this paragraph) shall be divided equally between them unless they agree on a different division")
rule MarriedLimitationEqualDivision(p: Individual, y: TaxableYear, deductible: Money, months: Integer) defeasible {
    label en official "both spouses are treated as having the family coverage with the lowest deductible; the limitation (75 percent of the deductible per month) is divided equally, one rounding to cents HALF_UP (section 220(b)(2)(B),(3))";
    when married_and_either_spouse_has_family_hdhp_coverage(p, y);
    when lowest_family_annual_deductible_among_spouses(p, y, deductible);
    when family_coverage_months_for_married_220(p, y, months);
    when not_known(spouses_agree_on_division_220(p, y, 0.5));
    then married_archer_msa_limitation_for_individual(p, y, div_round(deductible * months * 75, 2400.0, 2, "HALF_UP"));
}
@source(IRC_S220_B, quote = "unless they agree on a different division")
rule MarriedLimitationAgreedDivision(p: Individual, y: TaxableYear, deductible: Money, months: Integer, share: Decimal) defeasible {
    label en official "the spouses' agreed division applies instead of equal division (section 220(b)(3)(B))";
    when married_and_either_spouse_has_family_hdhp_coverage(p, y);
    when lowest_family_annual_deductible_among_spouses(p, y, deductible);
    when family_coverage_months_for_married_220(p, y, months);
    when spouses_agree_on_division_220(p, y, share);
    then married_archer_msa_limitation_for_individual(p, y, round(div_round(deductible * months * 75, 1200.0, 2, "HALF_UP") * share, 2, "HALF_UP"));
}
pub relation archer_monthly_limitation_zero_for_month(p: Individual, y: TaxableYear, month: Integer) kind institutional {
    label en official "the monthly limitation is zero for the first month of Medicare entitlement and each month thereafter (section 220(b)(7))";
}
@source(IRC_S220_B, quote = "The limitation under this subsection for any month with respect to an individual shall be zero for the first month such individual is entitled to benefits under title XVIII of the Social Security Act and for each month thereafter.")
rule ArcherMonthlyLimitationZeroFromMedicareMonth(p: Individual, y: TaxableYear, first_month: Integer, month: Integer) strict {
    label en official "the limitation is zero from the first month of Medicare entitlement (section 220(b)(7)); months are 1 to 12";
    when medicare_entitled_from_month(p, y, first_month);
    when covered_by_high_deductible_health_plan_first_day_of_month(p, y, month);
    when month >= first_month;
    then archer_monthly_limitation_zero_for_month(p, y, month);
}

// --- (j): numerical limitation and cut-off year -------------------------------------------------------------------------------------------------------

pub relation archer_msas_established_as_of_april_30_1997(count: Integer) kind empirical {
    label en official "the number of Archer MSAs established as of April 30, 1997, based on trustee reports (section 220(j)(1)(A))";
}
pub relation archer_msas_established_as_of_june_30_1997(count: Integer) kind empirical {
    label en official "the number of Archer MSAs established as of June 30, 1997, based on trustee reports (section 220(j)(1)(B))";
}
pub relation msa_returns_filed_by_april_15(cy: Integer, count: Integer) kind empirical {
    label en official "the number of MSA returns filed on or before April 15 of the calendar year for taxable years ending with or within the preceding year (section 220(j)(2)(A)(i))";
}
pub relation secretary_estimate_of_later_filed_msa_returns(cy: Integer, count: Integer) kind empirical {
    label en official "the Secretary's estimate of the number of MSA returns for such years to be filed after April 15 (section 220(j)(2)(A)(ii))";
}
pub relation archer_msas_established_before_july_1(cy: Integer, count: Integer) kind empirical {
    label en official "the number of Archer MSAs established during the portion of the year preceding July 1 for taxable years beginning in the year (section 220(j)(2)(B)(ii)), excluding accounts of previously uninsured individuals (section 220(j)(3))";
}
pub relation numerical_limitation_exceeded(cy: Integer) kind institutional {
    label en official "the numerical limitation for the calendar year is exceeded (section 220(j))";
}
@source(IRC_S220_J, quote = "(A) April 30, 1997, exceeds 375,000, or")
rule NumericalLimit1997April(count: Integer) strict {
    label en official "1997 is exceeded if more than 375,000 Archer MSAs were established as of April 30, 1997 (section 220(j)(1)(A))";
    when archer_msas_established_as_of_april_30_1997(count);
    when count > 375000;
    then numerical_limitation_exceeded(1997);
}
@source(IRC_S220_J, quote = "(B) June 30, 1997, exceeds 525,000.")
rule NumericalLimit1997June(count: Integer) strict {
    label en official "1997 is exceeded if more than 525,000 Archer MSAs were established as of June 30, 1997 (section 220(j)(1)(B))";
    when archer_msas_established_as_of_june_30_1997(count);
    when count > 525000;
    then numerical_limitation_exceeded(1997);
}
@source(IRC_S220_J, quote = "The numerical limitation for 1998, 1999, 2001, 2002, 2004, 2005, or 2006 is exceeded if the sum of")
rule NumericalLimitParagraph2A1998(cy: Integer, returns: Integer, estimate: Integer) strict {
    label en official "for 1998 the limit is exceeded if returns filed by April 15 plus the estimate exceed 600,000 (section 220(j)(2)(A))";
    when msa_returns_filed_by_april_15(cy, returns);
    when secretary_estimate_of_later_filed_msa_returns(cy, estimate);
    when cy == 1998;
    when returns + estimate > 600000;
    then numerical_limitation_exceeded(cy);
}
@source(IRC_S220_J, quote = "exceeds 750,000 (600,000 in the case of 1998)")
rule NumericalLimitParagraph2AOtherYears(cy: Integer, returns: Integer, estimate: Integer) strict {
    label en official "for 1999, 2001, 2002, 2004, 2005 and 2006 the limit is exceeded if returns plus the estimate exceed 750,000 (section 220(j)(2)(A))";
    when msa_returns_filed_by_april_15(cy, returns);
    when secretary_estimate_of_later_filed_msa_returns(cy, estimate);
    when cy != 1998;
    when cy != 2000;
    when cy != 2003;
    when returns + estimate > 750000;
    then numerical_limitation_exceeded(cy);
}
@source(IRC_S220_J, quote = "(i) 90 percent of the sum determined under subparagraph (A) for such calendar year, plus")
rule NumericalLimitParagraph2BAlternative(cy: Integer, returns: Integer, estimate: Integer, estab_count: Integer) strict {
    label en official "the alternative test: 90 percent of the (A) sum plus 2.5 times the MSAs established before July 1 exceeds 750,000 (section 220(j)(2)(B)); computed in tenths to stay exact";
    when msa_returns_filed_by_april_15(cy, returns);
    when secretary_estimate_of_later_filed_msa_returns(cy, estimate);
    when archer_msas_established_before_july_1(cy, estab_count);
    when cy != 2000;
    when cy != 2003;
    when (returns + estimate) * 9 + estab_count * 25 > 7500000;
    then numerical_limitation_exceeded(cy);
}
@source(IRC_S220_J, quote = "The numerical limitation shall not apply for 2000 or 2003.")
rule NoNumericalLimitationFor2000(returns: Integer) strict {
    label en official "no numerical limitation applies for 2000 (section 220(j)(2)(C))";
    when msa_returns_filed_by_april_15(2000, returns);
    then not numerical_limitation_exceeded(2000);
}
@source(IRC_S220_J, quote = "The numerical limitation shall not apply for 2000 or 2003.")
rule NoNumericalLimitationFor2003(returns: Integer) strict {
    label en official "no numerical limitation applies for 2003 (section 220(j)(2)(C))";
    when msa_returns_filed_by_april_15(2003, returns);
    then not numerical_limitation_exceeded(2003);
}
pub relation cut_off_year_candidate(cy: Integer) kind institutional {
    label en official "a calendar year that can be the cut-off year: 2007, or a year before 2007 whose numerical limitation is exceeded (section 220(i)(2))";
}
@source(IRC_S220_I, quote = "(A) calendar year 2007, or")
rule CutOffCandidate2007(y: TaxableYear, begins: Date) strict {
    label en official "2007 is always a candidate for the cut-off year (section 220(i)(2)(A)); the rule fires whenever a taxable year of the case is known";
    when taxable_year_begins_on(y, begins);
    then cut_off_year_candidate(2007);
}
@source(IRC_S220_I, quote = "the first calendar year before 2007 for which the Secretary determines under subsection (j) that the numerical limitation for such year has been exceeded")
rule CutOffCandidateBefore2007ExceededYear(cy: Integer) strict {
    label en official "a year before 2007 whose numerical limitation is exceeded is a candidate (section 220(i)(2)(B))";
    when numerical_limitation_exceeded(cy);
    when cy < 2007;
    then cut_off_year_candidate(cy);
}
pub relation earlier_cut_off_candidate_exists(cy: Integer) kind institutional {
    label en official "a strictly earlier cut-off candidate exists";
}
rule EarlierCutOffCandidate(cy: Integer, other: Integer) strict {
    label en official "helper: a strictly earlier candidate exists";
    when cut_off_year_candidate(cy);
    when cut_off_year_candidate(other);
    when other < cy;
    then earlier_cut_off_candidate_exists(cy);
}
pub relation cut_off_year(cy: Integer) kind institutional {
    label en official "the cut-off year: the earlier of calendar year 2007 and the first earlier year for which the numerical limitation is exceeded (section 220(i)(2))";
}
@source(IRC_S220_I, quote = "the term \"cut-off year\" means the earlier of")
rule CutOffYearEarliestCandidate(cy: Integer) strict {
    label en official "the cut-off year is the earliest candidate (section 220(i)(2))";
    when cut_off_year_candidate(cy);
    when not_known(earlier_cut_off_candidate_exists(cy));
    then cut_off_year(cy);
}
