// Sections 181, 186, 194 and 216 — stage 2c detail (TECH_GAPS G2735, G2737-G2739, G2745, G2755, G2760): (181)(b),(c)(2),
// (d)(2)(B),(e)(2)(B),(C) no other depreciation, revocation, television episodes, separate live productions; (186)(b),
// (d)(2),(d)(3),(e) compensable injury, the injury period, the losses attributable to the injury and the reduction of
// the carryover; (194)(b)(2),(c)(1),(3)-(5),(d) the group limit, qualified timber property, reforestation
// expenditures, trusts and the life tenant; (216)(a)(2),(b)(1)-(6),(c) the purposes of indebtedness, the cooperative
// housing corporation tests, the depreciation of stock.
//
// Stage 1 interface changes (recorded): `net_operating_losses_attributable_to_injury`,
// `damages_received_or_accrued_for_compensable_injury`, `qualified_timber_property_reforestation_expenditure`,
// `corporation_qualifying_interest_216a2` and `corporation_has_one_class_of_stock_and_occupancy_rights` are now
// institutional (derived below, or still asserted by a case); the stage 1 film and television rule carries a `not_known`
// guard for an episode beyond the 44th.
//
// JUDGMENT CALLS: (1) the cumulative section 186 losses of the years are given per year; (2) the carryforward of the
// disallowed depreciation of section 216(c)(2)(B) is derived for one succeeding year from a total the case gives (the
// multi-year ledger is recursive, LDC-E4102); (3) the apportionment of a controlled group's dollar limit is the
// Secretary's regulation and is a fact of the case; (4) amounts are rounded to cents HALF_UP.

// === §181(b),(c)(2): the election ========================================================================================

use self::{
    ConservationPurposeKind,
    IRC_S181_B,
    IRC_S181_C,
    IRC_S181_D,
    IRC_S181_E,
    IRC_S186_B,
    IRC_S186_D,
    IRC_S186_E,
    IRC_S194_B,
    IRC_S194_C,
    IRC_S194_D,
    IRC_S216_A,
    IRC_S216_B,
    IRC_S216_C,
    IncomeProductionPurpose212,
    Person,
    QualifiedProductionKind,
    ReforestationTaxpayerKind,
    SoilConservationPurpose175,
    TaxableYear,
    compensatory_amount_186,
    corporation_has_one_class_of_stock_and_occupancy_rights,
    corporation_qualifying_interest_216a2,
    damages_received_or_accrued_for_compensable_injury,
    net_operating_losses_attributable_to_injury,
    qualified_production_181,
    qualified_timber_property_reforestation_expenditure,
    section_181_election_in_effect,
    tenant_stockholder,
    unrecovered_losses_186,
};

pub relation production_basis_for_181_election(p: Person, production: Integer, amount: Money) kind empirical {
    label en official "the basis of the qualified film, television or live theatrical production to which an election is made (section 181(b))";
}
pub relation other_depreciation_or_amortization_disallowed_for_production_basis(p: Person, production: Integer, amount: Money) kind institutional {
    label en official "no other depreciation or amortization deduction is allowable for the basis of an elected production (section 181(b))";
}
@source(IRC_S181_B, quote = "With respect to the basis of any qualified film or television production or any qualified live theatrical production to which an election is made under subsection (a), no other depreciation or amortization deduction shall be allowable.")
rule OtherDepreciationDisallowedForElectedProduction(p: Person, production: Integer, kind: QualifiedProductionKind, basis: Money) defeasible {
    label en official "the elected basis carries no depreciation or amortization";
    when section_181_election_in_effect(p, production);
    when qualified_production_181(p, production, kind);
    when kind != SoundRecording;
    when production_basis_for_181_election(p, production, basis);
    then other_depreciation_or_amortization_disallowed_for_production_basis(p, production, basis);
}
pub relation revokes_section_181_election(p: Person, production: Integer) kind empirical {
    label en official "the taxpayer revokes its section 181 election for the production (section 181(c)(2))";
}
pub relation secretary_consents_to_revocation_181(p: Person, production: Integer) kind empirical {
    label en official "the Secretary consents to the revocation (section 181(c)(2))";
}
pub relation section_181_election_revoked(p: Person, production: Integer) kind institutional {
    label en official "the section 181 election for the production is revoked with the consent of the Secretary";
}
@source(IRC_S181_C, quote = "Any election made under this section may not be revoked without the consent of the Secretary.")
rule Section181RevocationPower(p: Person, production: Integer) defeasible {
    label en official "revocable only with consent";
    when revokes_section_181_election(p, production);
    then power S181RevokeElection {
        holder p;
        over production;
        exercise revokes_section_181_election(p, production);
        valid_when secretary_consents_to_revocation_181(p, production);
        effect create(section_181_election_revoked(p, production));
        window [@2004-10-23, infinity);
    };
}

// === §181(d)(2)(B): television series =====================================================================================

pub relation episode_of_television_series(series: Integer, production: Integer, number: Integer) kind empirical {
    label en official "the production is the episode of the given number of a television series (section 181(d)(2)(B))";
}
pub relation episode_treated_as_separate_production(production: Integer) kind institutional {
    label en official "each episode of a television series is treated as a separate production (section 181(d)(2)(B)(i))";
}
@source(IRC_S181_D, quote = "(i) each episode of such series shall be treated as a separate production, and")
rule EpisodeSeparateProduction(series: Integer, production: Integer, number: Integer) strict {
    label en official "each episode is its own production";
    when episode_of_television_series(series, production, number);
    then episode_treated_as_separate_production(production);
}
pub relation episode_beyond_first_44_of_series(production: Integer) kind institutional {
    label en official "the episode is beyond the first 44 episodes of the series and is not taken into account (section 181(d)(2)(B)(ii))";
}
@source(IRC_S181_D, quote = "(ii) only the first 44 episodes of such series shall be taken into account.")
rule EpisodeBeyondFortyFourth(series: Integer, production: Integer, number: Integer) strict {
    label en official "an episode numbered above 44";
    when episode_of_television_series(series, production, number);
    when number > 44;
    then episode_beyond_first_44_of_series(production);
}
pub relation episode_taken_into_account(production: Integer) kind institutional {
    label en official "the episode is one of the first 44 of its series and is taken into account";
}
@source(IRC_S181_D, quote = "(ii) only the first 44 episodes of such series shall be taken into account.")
rule EpisodeTakenIntoAccount(series: Integer, production: Integer, number: Integer) strict {
    label en official "an episode numbered 44 or below";
    when episode_of_television_series(series, production, number);
    when number <= 44;
    then episode_taken_into_account(production);
}

// === §181(e)(2)(B),(C): multiple live staged productions =======================================================================

pub relation live_production_is_separate_phase_of_production(production: Integer, parent: Integer) kind empirical {
    label en official "the live staged production is a separate phase of a production (section 181(e)(2)(B)(ii)(I))";
}
pub relation live_production_is_initial_staging(production: Integer) kind empirical {
    label en official "the phase is the initial staging of a live theatrical production (section 181(e)(2)(C)(i))";
}
pub relation live_production_is_subsequent_staging_or_tour_by_same_producer(production: Integer) kind empirical {
    label en official "the phase is a subsequent additional staging or touring of the production produced by the same producer as the initial staging (section 181(e)(2)(C)(ii))";
}
pub relation phase_treated_by_taxpayer_as_separate_activity_for_all_purposes(production: Integer) kind empirical {
    label en official "the taxpayer treats the phase as a separate activity for all purposes of the title (section 181(e)(2)(C))";
}
pub relation live_production_is_separate_simultaneous_staging(production: Integer, parent: Integer) kind empirical {
    label en official "the live staged production is a separate simultaneous staging of the same production in a different geographical location (section 181(e)(2)(B)(ii)(II))";
}
pub relation staging_is_another_performance_location_of_one_touring_production(production: Integer) kind empirical {
    label en official "the staging is only another performance location of a single touring production (section 181(e)(2)(B)(ii)(II) parenthetical)";
}
pub relation election_allowable_to_same_taxpayer_for_multiple_productions(production: Integer) kind empirical {
    label en official "the election would be allowable to the same taxpayer for the multiple live staged productions (section 181(e)(2)(B)(i))";
}
pub relation live_production_treated_as_separate_production(production: Integer) kind institutional {
    label en official "each such live staged production is treated as a separate production (section 181(e)(2)(B))";
}
@source(IRC_S181_E, quote = "(I) separate phases of a production, or")
rule LivePhaseSeparateProduction(production: Integer, parent: Integer) strict {
    label en official "a phase (an initial staging, or a later staging or tour by the same producer) treated by the taxpayer as a separate activity";
    when election_allowable_to_same_taxpayer_for_multiple_productions(production);
    when live_production_is_separate_phase_of_production(production, parent);
    when phase_treated_by_taxpayer_as_separate_activity_for_all_purposes(production);
    then live_production_treated_as_separate_production(production);
}
@source(IRC_S181_E, quote = "(II) separate simultaneous stagings of the same production in different geographical locations (not including multiple performance locations of any one touring production),")
rule LiveSimultaneousStagingSeparateProduction(production: Integer, parent: Integer) strict {
    label en official "a simultaneous staging in a different geographical location, not a location of one touring production";
    when election_allowable_to_same_taxpayer_for_multiple_productions(production);
    when live_production_is_separate_simultaneous_staging(production, parent);
    when not_known(staging_is_another_performance_location_of_one_touring_production(production));
    then live_production_treated_as_separate_production(production);
}
pub relation live_phase_defined(production: Integer) kind institutional {
    label en official "the production is a phase within section 181(e)(2)(C): an initial staging, or a subsequent staging or tour by the same producer, treated as a separate activity";
}
@source(IRC_S181_E, quote = "For purposes of subparagraph (B), the term \"phase\" with respect to any qualified live theatrical production refers to each of the following, but only if each of the following is treated by the taxpayer as a separate activity for all purposes of this title:")
rule LivePhaseDefinedInitial(production: Integer) strict {
    label en official "an initial staging treated as a separate activity";
    when live_production_is_initial_staging(production);
    when phase_treated_by_taxpayer_as_separate_activity_for_all_purposes(production);
    then live_phase_defined(production);
}
@source(IRC_S181_E, quote = "(ii) Subsequent additional stagings or touring of such production which are produced by the same producer as the initial staging.")
rule LivePhaseDefinedSubsequent(production: Integer) strict {
    label en official "a later staging or tour by the same producer treated as a separate activity";
    when live_production_is_subsequent_staging_or_tour_by_same_producer(production);
    when phase_treated_by_taxpayer_as_separate_activity_for_all_purposes(production);
    then live_phase_defined(production);
}

// === §186(b),(d)(2),(d)(3),(e) ================================================================================================

pub enum CompensableInjuryKind {
    PatentInfringementUnitedStatesPatent;
    BreachOfContractOrFiduciaryDuty;
    AntitrustInjuryClaytonSection4;
    OtherInjury;
}
pub relation injury_kind_186(injury: Integer, kind: CompensableInjuryKind) kind empirical {
    label en official "the kind of injury sustained (section 186(b))";
}
pub relation compensable_injury_186(injury: Integer) kind institutional {
    label en official "a compensable injury (section 186(b))";
}
@source(IRC_S186_B, quote = "(1) injuries sustained as a result of an infringement of a patent issued by the United States,")
rule CompensableInjuryPatent(injury: Integer) strict {
    label en official "infringement of a United States patent";
    when injury_kind_186(injury, PatentInfringementUnitedStatesPatent);
    then compensable_injury_186(injury);
}
@source(IRC_S186_B, quote = "(2) injuries sustained as a result of a breach of contract or a breach of fiduciary duty or relationship, or")
rule CompensableInjuryBreach(injury: Integer) strict {
    label en official "breach of contract or fiduciary duty or relationship";
    when injury_kind_186(injury, BreachOfContractOrFiduciaryDuty);
    then compensable_injury_186(injury);
}
@source(IRC_S186_B, quote = "(3) injuries sustained in business, or to property, by reason of any conduct forbidden in the antitrust laws for which a civil action may be brought under section 4 of the Act entitled")
rule CompensableInjuryAntitrust(injury: Integer) strict {
    label en official "antitrust conduct giving a civil action under section 4 of the Clayton Act";
    when injury_kind_186(injury, AntitrustInjuryClaytonSection4);
    then compensable_injury_186(injury);
}
pub relation damages_received_or_accrued_186_fact(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind empirical {
    label en official "damages received or accrued in the year as a result of an award in, or settlement of, a civil action for recovery, included in gross income (section 186(a),(c))";
}
@source(IRC_S186_B, quote = "For purposes of this section, the term \"compensable injury\" means—")
rule DamagesForCompensableInjuryDerived(p: Person, y: TaxableYear, injury: Integer, amount: Money) strict {
    label en official "damages for a compensable injury; an amount asserted by a case is still accepted";
    when damages_received_or_accrued_186_fact(p, y, injury, amount);
    when compensable_injury_186(injury);
    then damages_received_or_accrued_for_compensable_injury(p, y, injury, amount);
}
pub relation patent_infringement_period(injury: Integer, start: Date, end: Date) kind empirical {
    label en official "the period in which the infringement of the patent occurred (section 186(d)(2)(A))";
}
pub relation period_amounts_would_have_been_received_but_for_breach(injury: Integer, start: Date, end: Date) kind empirical {
    label en official "the period during which amounts would have been received or accrued but for the breach (section 186(d)(2)(B))";
}
pub relation period_antitrust_injuries_sustained(injury: Integer, start: Date, end: Date) kind empirical {
    label en official "the period in which the injuries were sustained by reason of the forbidden conduct (section 186(d)(2)(C))";
}
pub relation injury_period_186(injury: Integer, start: Date, end: Date) kind institutional {
    label en official "the injury period (section 186(d)(2))";
}
@source(IRC_S186_D, quote = "(A) with respect to any infringement of a patent, the period in which such infringement occurred,")
rule InjuryPeriodPatent(injury: Integer, start: Date, end: Date) strict {
    label en official "the infringement period";
    when injury_kind_186(injury, PatentInfringementUnitedStatesPatent);
    when patent_infringement_period(injury, start, end);
    then injury_period_186(injury, start, end);
}
@source(IRC_S186_D, quote = "(B) with respect to a breach of contract or breach of fiduciary duty or relationship, the period during which amounts would have been received or accrued but for the breach of contract or breach of fiduciary duty or relationship, and")
rule InjuryPeriodBreach(injury: Integer, start: Date, end: Date) strict {
    label en official "the period of lost amounts";
    when injury_kind_186(injury, BreachOfContractOrFiduciaryDuty);
    when period_amounts_would_have_been_received_but_for_breach(injury, start, end);
    then injury_period_186(injury, start, end);
}
@source(IRC_S186_D, quote = "(C) with respect to injuries sustained by reason of any conduct forbidden in the antitrust laws, the period in which such injuries were sustained.")
rule InjuryPeriodAntitrust(injury: Integer, start: Date, end: Date) strict {
    label en official "the period of the injuries";
    when injury_kind_186(injury, AntitrustInjuryClaytonSection4);
    when period_antitrust_injuries_sustained(injury, start, end);
    then injury_period_186(injury, start, end);
}
pub relation year_within_injury_period(injury: Integer, y: TaxableYear) kind institutional {
    label en official "the taxable year is in whole or in part within the injury period (section 186(d)(1)(A))";
}
pub relation taxable_year_span_186(y: TaxableYear, begins: Date, ends: Date) kind empirical {
    label en official "the first and last day of the taxable year";
}
@source(IRC_S186_D, quote = "for each taxable year in whole or in part within the injury period")
rule YearWithinInjuryPeriod(injury: Integer, y: TaxableYear, start: Date, end: Date, begins: Date, ends: Date) strict {
    label en official "the year overlaps the injury period";
    when injury_period_186(injury, start, end);
    when taxable_year_span_186(y, begins, ends);
    when begins <= end;
    when ends >= start;
    then year_within_injury_period(injury, y);
}
pub relation net_operating_loss_of_year_186(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net operating loss of the taxable year, as determined under section 172";
}
pub relation compensable_injury_sustained_in_year(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind empirical {
    label en official "the compensable injury sustained during the taxable year (section 186(d)(3)(A))";
}
pub relation nol_attributable_to_injury_in_year(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind institutional {
    label en official "the part of the year's net operating loss treated as attributable to the compensable injury: to the extent of the injury sustained in the year (section 186(d)(3)(A))";
}
@source(IRC_S186_D, quote = "(A) a net operating loss for any taxable year shall be treated as attributable to a compensable injury to the extent of the compensable injury sustained during such taxable year, and")
rule NolAttributableToInjuryInYear(p: Person, y: TaxableYear, injury: Integer, nol: Money, sustained: Money) strict {
    label en official "the lesser of the loss and the injury sustained, for a year within the injury period";
    when net_operating_loss_of_year_186(p, y, nol);
    when compensable_injury_sustained_in_year(p, y, injury, sustained);
    when year_within_injury_period(injury, y);
    then nol_attributable_to_injury_in_year(p, y, injury, min(nol, sustained));
}
@source(IRC_S186_D, quote = "(A) the sum of the amount of the net operating losses (as determined under section 172) for each taxable year in whole or in part within the injury period, to the extent that such net operating losses are attributable to such compensable injury, reduced by")
rule NetOperatingLossesAttributableToInjurySum(p: Person, injury: Integer, y0: TaxableYear, a0: Money) strict {
    label en official "the sum over the years of the injury period; a total asserted by a case is still accepted";
    when nol_attributable_to_injury_in_year(p, y0, injury, a0);
    then net_operating_losses_attributable_to_injury(p, injury, sum all amount: Money for y: TaxableYear where nol_attributable_to_injury_in_year(p, y, injury, amount));
}
pub relation separate_nol_portion_applied_after_other_portion(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind institutional {
    label en official "the attributable part of a net operating loss is a separate loss for the year, applied after the other part (section 186(d)(3)(B))";
}
@source(IRC_S186_D, quote = "(B) if only a portion of a net operating loss for any taxable year is attributable to a compensable injury, such portion shall (in applying section 172 for purposes of this section) be considered to be a separate net operating loss for such year to be applied after the other portion of such net operating loss.")
rule SeparateNolPortion(p: Person, y: TaxableYear, injury: Integer, nol: Money, attributable: Money) strict {
    label en official "only a part of the loss is attributable to the injury";
    when net_operating_loss_of_year_186(p, y, nol);
    when nol_attributable_to_injury_in_year(p, y, injury, attributable);
    when attributable < nol;
    then separate_nol_portion_applied_after_other_portion(p, y, injury, attributable);
}
pub relation nol_carryover_attributable_to_injury_186e(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind empirical {
    label en official "the part of the net operating loss carryover to the year that is attributable to the compensable injury (section 186(e))";
}
pub relation unrecovered_losses_with_expired_carryover_period_186(p: Person, injury: Integer, amount: Money) kind empirical {
    label en official "the part of the unrecovered losses for which the section 172 carryover period has expired (section 186(e)(2))";
}
pub relation nol_carryover_reduction_186e(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind institutional {
    label en official "the reduction of the carryover attributable to the injury: the deduction allowed less the expired unrecovered losses, up to the carryover (section 186(e))";
}
@source(IRC_S186_E, quote = "such portion of such net operating loss carryover shall be reduced by an amount equal to—")
rule NolCarryoverReduction186e(p: Person, y: TaxableYear, injury: Integer, carryover: Money, comp: Money, unrecovered: Money, expired: Money) strict {
    label en official "the lesser of the carryover and the deduction less the expired losses, not below zero";
    when nol_carryover_attributable_to_injury_186e(p, y, injury, carryover);
    when compensatory_amount_186(p, y, injury, comp);
    when unrecovered_losses_186(p, injury, unrecovered);
    when unrecovered_losses_with_expired_carryover_period_186(p, injury, expired);
    then nol_carryover_reduction_186e(p, y, injury, min(carryover, max(0.00 USD, min(comp, unrecovered) - expired)));
}

// === §194(b)(2),(c),(d) ==========================================================================================================

pub relation controlled_group_test_met_50_percent_1563a(group: Integer, member: Integer) kind empirical {
    label en official "the corporation is a component member of a controlled group under section 1563(a), with 'more than 50 percent' in place of 'at least 80 percent' in section 1563(a)(1) (section 194(b)(2)(A))";
}
pub relation controlled_group_component_member_194(group: Integer, member: Integer) kind institutional {
    label en official "a component member of a controlled group for section 194(b)(2)(A)";
}
@source(IRC_S194_B, quote = "For purposes of the preceding sentence, the term \"controlled group\" has the meaning assigned to it by section 1563(a), except that the phrase \"more than 50 percent\" shall be substituted for the phrase \"at least 80 percent\" each place it appears in section 1563(a)(1).")
rule ControlledGroupComponentMember(group: Integer, member: Integer) strict {
    label en official "the modified section 1563(a) test";
    when controlled_group_test_met_50_percent_1563a(group, member);
    then controlled_group_component_member_194(group, member);
}
pub relation apportioned_dollar_limit_of_member_194(group: Integer, member: Integer, timber: Integer, amount: Money) kind empirical {
    label en official "the part of the dollar limitation that the Secretary's regulations apportion to the component member (section 194(b)(2)(A)(ii))";
}
pub relation member_reforestation_dollar_limit(group: Integer, member: Integer, timber: Integer, amount: Money) kind institutional {
    label en official "the dollar limitation of the component member: the group is one taxpayer and the limit is apportioned (section 194(b)(2)(A))";
}
@source(IRC_S194_B, quote = "(i) all component members of a controlled group shall be treated as one taxpayer, and")
rule MemberReforestationDollarLimit(group: Integer, member: Integer, timber: Integer, amount: Money) strict {
    label en official "the apportioned amount of a component member";
    when controlled_group_component_member_194(group, member);
    when apportioned_dollar_limit_of_member_194(group, member, timber, amount);
    then member_reforestation_dollar_limit(group, member, timber, amount);
}
pub relation pass_through_entity_kind_194(entity_id: Integer, kind: PassThroughKind194) kind empirical {
    label en official "the entity is a partnership or an S corporation (section 194(b)(2)(B))";
}
pub enum PassThroughKind194 {
    PartnershipEntity;
    SCorporationEntity;
    OtherEntity;
}
pub relation owner_of_pass_through_entity_194(owner: Person, entity_id: Integer) kind empirical {
    label en official "the person is a partner or a shareholder of the entity";
}
pub relation dollar_limit_applies_at_entity_level_194(entity_id: Integer) kind institutional {
    label en official "the dollar limitation applies with respect to the partnership or S corporation itself (section 194(b)(2)(B))";
}
pub relation dollar_limit_applies_to_owner_194(owner: Person, entity_id: Integer) kind institutional {
    label en official "the dollar limitation applies with respect to each partner or shareholder as well (section 194(b)(2)(B))";
}
@source(IRC_S194_B, quote = "In the case of a partnership, the dollar limitation contained in paragraph (1)(B) shall apply with respect to the partnership and with respect to each partner.")
rule DollarLimitAtPartnershipLevel(entity_id: Integer) strict {
    label en official "a partnership";
    when pass_through_entity_kind_194(entity_id, PartnershipEntity);
    then dollar_limit_applies_at_entity_level_194(entity_id);
}
@source(IRC_S194_B, quote = "In the case of a partnership, the dollar limitation contained in paragraph (1)(B) shall apply with respect to the partnership and with respect to each partner.")
rule DollarLimitAtPartnerLevel(owner: Person, entity_id: Integer) strict {
    label en official "each partner";
    when pass_through_entity_kind_194(entity_id, PartnershipEntity);
    when owner_of_pass_through_entity_194(owner, entity_id);
    then dollar_limit_applies_to_owner_194(owner, entity_id);
}
@source(IRC_S194_B, quote = "A similar rule shall apply in the case of an S corporation and its shareholders.")
rule DollarLimitAtSCorporationLevel(entity_id: Integer) strict {
    label en official "an S corporation";
    when pass_through_entity_kind_194(entity_id, SCorporationEntity);
    then dollar_limit_applies_at_entity_level_194(entity_id);
}
@source(IRC_S194_B, quote = "A similar rule shall apply in the case of an S corporation and its shareholders.")
rule DollarLimitAtShareholderLevel(owner: Person, entity_id: Integer) strict {
    label en official "each shareholder";
    when pass_through_entity_kind_194(entity_id, SCorporationEntity);
    when owner_of_pass_through_entity_194(owner, entity_id);
    then dollar_limit_applies_to_owner_194(owner, entity_id);
}
pub relation site_located_in_united_states_194(timber: Integer) kind empirical {
    label en official "the woodlot or other site is located in the United States (section 194(c)(1))";
}
pub relation site_will_contain_trees_in_significant_commercial_quantities(timber: Integer) kind empirical {
    label en official "the site will contain trees in significant commercial quantities (section 194(c)(1))";
}
pub relation site_held_for_planting_cultivating_caring_for_and_cutting_trees_for_commercial_timber(p: Person, timber: Integer) kind empirical {
    label en official "the site is held by the taxpayer for the planting, cultivating, caring for and cutting of trees for sale or use in the commercial production of timber products (section 194(c)(1))";
}
pub relation qualified_timber_property(p: Person, timber: Integer) kind institutional {
    label en official "qualified timber property (section 194(c)(1))";
}
@source(IRC_S194_C, quote = "The term \"qualified timber property\" means a woodlot or other site located in the United States which will contain trees in significant commercial quantities and which is held by the taxpayer for the planting, cultivating, caring for, and cutting of trees for sale or use in the commercial production of timber products.")
rule QualifiedTimberProperty(p: Person, timber: Integer) strict {
    label en official "a United States site with commercial trees held for commercial timber production";
    when site_located_in_united_states_194(timber);
    when site_will_contain_trees_in_significant_commercial_quantities(timber);
    when site_held_for_planting_cultivating_caring_for_and_cutting_trees_for_commercial_timber(p, timber);
    then qualified_timber_property(p, timber);
}
pub enum ReforestationCostKind {
    SitePreparation;
    SeedsOrSeedlings;
    LaborAndTools;
    OtherDirectCost;
    IndirectCost;
}
pub relation reforestation_cost_item(p: Person, y: TaxableYear, timber: Integer, item: Integer, kind: ReforestationCostKind, amount: Money) kind empirical {
    label en official "a cost incurred in connection with forestation or reforestation by planting or artificial or natural seeding, by kind (section 194(c)(3)(A))";
}
pub relation cost_reimbursed_under_governmental_cost_sharing_program(item: Integer) kind empirical {
    label en official "the cost has been reimbursed under a governmental reforestation cost-sharing program (section 194(c)(3)(B))";
}
pub relation reimbursement_included_in_gross_income(item: Integer) kind empirical {
    label en official "the amount reimbursed is included in the taxpayer's gross income (section 194(c)(3)(B))";
}
pub relation reforestation_expenditure_item(p: Person, y: TaxableYear, timber: Integer, item: Integer, amount: Money) kind institutional {
    label en official "a reforestation expenditure: a direct cost of forestation or reforestation, not reimbursed under a cost-sharing program unless the reimbursement is included in income (section 194(c)(3))";
}
pub relation reforestation_item_reimbursement_excluded(item: Integer) kind institutional {
    label en official "helper: the item is reimbursed and the reimbursement is not included in gross income";
}
@source(IRC_S194_C, quote = "Reforestation expenditures shall not include any expenditures for which the taxpayer has been reimbursed under any governmental reforestation cost-sharing program unless the amounts reimbursed have been included in the gross income of the taxpayer.")
rule ReforestationReimbursementExcluded(item: Integer) strict {
    label en official "reimbursed and not included in income";
    when cost_reimbursed_under_governmental_cost_sharing_program(item);
    when not_known(reimbursement_included_in_gross_income(item));
    then reforestation_item_reimbursement_excluded(item);
}
@source(IRC_S194_C, quote = "(i) for the preparation of the site;")
rule ReforestationExpenditureSitePreparation(p: Person, y: TaxableYear, timber: Integer, item: Integer, amount: Money) strict {
    label en official "the preparation of the site";
    when reforestation_cost_item(p, y, timber, item, SitePreparation, amount);
    when not_known(reforestation_item_reimbursement_excluded(item));
    then reforestation_expenditure_item(p, y, timber, item, amount);
}
@source(IRC_S194_C, quote = "(ii) of seeds or seedlings; and")
rule ReforestationExpenditureSeeds(p: Person, y: TaxableYear, timber: Integer, item: Integer, amount: Money) strict {
    label en official "seeds or seedlings";
    when reforestation_cost_item(p, y, timber, item, SeedsOrSeedlings, amount);
    when not_known(reforestation_item_reimbursement_excluded(item));
    then reforestation_expenditure_item(p, y, timber, item, amount);
}
@source(IRC_S194_C, quote = "(iii) for labor and tools, including depreciation of equipment such as tractors, trucks, tree planters, and similar machines used in planting or seeding.")
rule ReforestationExpenditureLabor(p: Person, y: TaxableYear, timber: Integer, item: Integer, amount: Money) strict {
    label en official "labor and tools, including the depreciation of planting equipment";
    when reforestation_cost_item(p, y, timber, item, LaborAndTools, amount);
    when not_known(reforestation_item_reimbursement_excluded(item));
    then reforestation_expenditure_item(p, y, timber, item, amount);
}
@source(IRC_S194_C, quote = "The term \"reforestation expenditures\" means direct costs incurred in connection with forestation or reforestation by planting or artificial or natural seeding, including costs—")
rule ReforestationExpenditureOtherDirect(p: Person, y: TaxableYear, timber: Integer, item: Integer, amount: Money) strict {
    label en official "another direct cost of forestation or reforestation (the list is 'including')";
    when reforestation_cost_item(p, y, timber, item, OtherDirectCost, amount);
    when not_known(reforestation_item_reimbursement_excluded(item));
    then reforestation_expenditure_item(p, y, timber, item, amount);
}
pub relation taxpayer_kind_194(p: Person, kind: ReforestationTaxpayerKind) kind empirical {
    label en official "the kind of the taxpayer for the dollar limitation (section 194(b)(1)(B))";
}
@source(IRC_S194_C, quote = "The term \"reforestation expenditures\" means direct costs incurred in connection with forestation or reforestation by planting or artificial or natural seeding, including costs—")
rule QualifiedTimberReforestationExpenditureDerived(p: Person, y: TaxableYear, timber: Integer, kind: ReforestationTaxpayerKind, i0: Integer, a0: Money) strict {
    label en official "the sum of the reforestation expenditure items of a qualified timber property; an amount asserted by a case is still accepted";
    when qualified_timber_property(p, timber);
    when taxpayer_kind_194(p, kind);
    when reforestation_expenditure_item(p, y, timber, i0, a0);
    then qualified_timber_property_reforestation_expenditure(p, y, timber, kind, sum all amount: Money for item: Integer where reforestation_expenditure_item(p, y, timber, item, amount));
}
pub relation trust_reforestation_expenditures(trust: Person, y: TaxableYear, timber: Integer, amount: Money) kind empirical {
    label en official "the aggregate reforestation expenditures incurred by the trust or estate (section 194(c)(4))";
}
pub relation trust_apportionment_percent_194(trust: Person, beneficiary: Person, pct: Decimal) kind empirical {
    label en official "the percentage of the expenditures apportioned to the income beneficiary under the Secretary's regulations (section 194(c)(4))";
}
pub relation reforestation_expenditures_of_beneficiary(beneficiary: Person, y: TaxableYear, timber: Integer, amount: Money) kind institutional {
    label en official "the amount apportioned to the beneficiary, taken into account as its own expenditures (section 194(c)(4))";
}
@source(IRC_S194_C, quote = "Any amount so apportioned to a beneficiary shall be taken into account as expenditures incurred by such beneficiary in applying this section to such beneficiary.")
rule ReforestationExpendituresOfBeneficiary(trust: Person, beneficiary: Person, y: TaxableYear, timber: Integer, total: Money, pct: Decimal) strict {
    label en official "the beneficiary's percentage of the trust's expenditures";
    when trust_reforestation_expenditures(trust, y, timber, total);
    when trust_apportionment_percent_194(trust, beneficiary, pct);
    then reforestation_expenditures_of_beneficiary(beneficiary, y, timber, div_round(total * pct, 100.0, 2, "HALF_UP"));
}
pub relation reforestation_expenditure_deducted_under_194(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the expenditure for which a deduction is allowed or allowable under section 194 (section 194(c)(5))";
}
pub relation expenditure_deductible_only_under_194(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "no deduction is allowed under any other provision of this chapter for the expenditure (section 194(c)(5))";
}
@source(IRC_S194_C, quote = "No deduction shall be allowed under any other provision of this chapter with respect to any expenditure with respect to which a deduction is allowed or allowable under this section to the taxpayer.")
rule ExpenditureDeductibleOnlyUnder194(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the deduction is exclusive";
    when reforestation_expenditure_deducted_under_194(p, y, item, amount);
    then expenditure_deductible_only_under_194(p, y, item);
}
pub relation property_held_for_life_with_remainder_194(timber: Integer, life_tenant: Person, remainderman: Person) kind empirical {
    label en official "the property is held by one person for life with remainder to another (section 194(d))";
}
pub relation deduction_computed_as_if_life_tenant_were_absolute_owner_194(life_tenant: Person, timber: Integer) kind institutional {
    label en official "the deduction is computed as if the life tenant were the absolute owner and is allowed to the life tenant (section 194(d))";
}
@source(IRC_S194_D, quote = "the deduction under this section shall be computed as if the life tenant were the absolute owner of the property and shall be allowed to the life tenant.")
rule LifeTenantTreatedAsAbsoluteOwner194(timber: Integer, life_tenant: Person, remainderman: Person) strict {
    label en official "the life tenant is the owner for the deduction";
    when property_held_for_life_with_remainder_194(timber, life_tenant, remainderman);
    then deduction_computed_as_if_life_tenant_were_absolute_owner_194(life_tenant, timber);
}

// === §216(a)(2): the purposes of the corporation's indebtedness ============================================================

pub enum CooperativeIndebtednessPurpose {
    AcquisitionOfHouses;
    ConstructionOfHouses;
    AlterationOrRehabilitationOfHouses;
    MaintenanceOfHouses;
    AcquisitionOfLand;
    OtherPurpose;
}
pub relation cooperative_interest_item(corp: Integer, y: TaxableYear, item: Integer, purpose: CooperativeIndebtednessPurpose, amount: Money) kind empirical {
    label en official "interest paid or incurred by the corporation on indebtedness contracted for the stated purpose, allowable to it under section 163 (section 216(a)(2))";
}
pub relation cooperative_interest_item_qualifying(corp: Integer, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "interest on indebtedness contracted in the acquisition, construction, alteration, rehabilitation or maintenance of the houses or apartment building, or in the acquisition of the land (section 216(a)(2)(A),(B))";
}
@source(IRC_S216_A, quote = "(A) in the acquisition, construction, alteration, rehabilitation, or maintenance of the houses or apartment building, or")
rule CooperativeInterestForHouses(corp: Integer, y: TaxableYear, item: Integer, purpose: CooperativeIndebtednessPurpose, amount: Money) strict {
    label en official "a purpose relating to the houses or apartment building";
    when cooperative_interest_item(corp, y, item, purpose, amount);
    when purpose != AcquisitionOfLand;
    when purpose != OtherPurpose;
    then cooperative_interest_item_qualifying(corp, y, item, amount);
}
@source(IRC_S216_A, quote = "(B) in the acquisition of the land on which the houses (or apartment building) are situated.")
rule CooperativeInterestForLand(corp: Integer, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the acquisition of the land";
    when cooperative_interest_item(corp, y, item, AcquisitionOfLand, amount);
    then cooperative_interest_item_qualifying(corp, y, item, amount);
}
@source(IRC_S216_A, quote = "(2) the interest allowable as a deduction to the corporation under section 163 which is paid or incurred by the corporation on its indebtedness contracted—")
rule CooperativeQualifyingInterestDerived(corp: Integer, y: TaxableYear, i0: Integer, a0: Money) strict {
    label en official "the sum of the qualifying interest; an amount asserted by a case is still accepted";
    when cooperative_interest_item_qualifying(corp, y, i0, a0);
    then corporation_qualifying_interest_216a2(corp, y, sum all amount: Money for item: Integer where cooperative_interest_item_qualifying(corp, y, item, amount));
}

// === §216(b)(1)-(6): the cooperative housing corporation ============================================================================

pub relation cooperative_candidate_corporation(corp: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation is tested for cooperative housing status for the year (section 216(b)(1))";
}
pub relation corporation_has_one_and_only_one_class_of_stock(corp: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation has one and only one class of stock outstanding (section 216(b)(1)(A))";
}
pub relation stockholder_of_corporation_216(corp: Integer, y: TaxableYear, stockholder: Integer) kind empirical {
    label en official "the person is a stockholder of the corporation during the year";
}
pub relation stockholder_entitled_to_occupy_solely_by_stock_ownership(corp: Integer, stockholder: Integer) kind empirical {
    label en official "the stockholder is entitled, solely by reason of stock ownership, to occupy for dwelling purposes a house or an apartment in a building owned or leased by the corporation (section 216(b)(1)(B))";
}
pub relation stockholder_occupancy_only_subject_to_prior_approval(corp: Integer, stockholder: Integer) kind empirical {
    label en official "the stockholder may not occupy without the prior approval of the corporation, by agreement with it (section 216(b)(5))";
}
pub relation stockholder_acquired_stock_by_operation_of_law(corp: Integer, stockholder: Integer) kind empirical {
    label en official "the stockholder acquired the stock by operation of law (section 216(b)(5)(A))";
}
pub relation stockholder_is_not_an_individual(corp: Integer, stockholder: Integer) kind empirical {
    label en official "the stockholder is a person other than an individual (section 216(b)(5)(B))";
}
pub relation original_seller_acquired_stock_on(corp: Integer, stockholder: Integer, on: Date) kind empirical {
    label en official "the original seller, from whom the corporation acquired the apartments or houses (or leaseholds), acquired stock from the corporation on the date (section 216(b)(5)(C),(6))";
}
pub relation apartments_transferred_by_original_seller_to_corporation_on(corp: Integer, stockholder: Integer, on: Date) kind empirical {
    label en official "the date the apartments or houses (or leaseholds) were transferred by the original seller to the corporation (section 216(b)(5)(C))";
}
pub relation stockholder_is_governmental_unit_216(corp: Integer, stockholder: Integer) kind empirical {
    label en official "the stockholder is the United States or a possession, a State or political subdivision, or an agency or instrumentality empowered to acquire shares to provide housing facilities (section 216(b)(4))";
}
pub relation prior_approval_disregarded(corp: Integer, stockholder: Integer) kind institutional {
    label en official "the prior-approval condition on occupancy is not taken into account (section 216(b)(5))";
}
@source(IRC_S216_B, quote = "(A) In any case where a person acquires stock of a cooperative housing corporation by operation of law.")
rule PriorApprovalDisregardedOperationOfLaw(corp: Integer, stockholder: Integer) strict {
    label en official "stock acquired by operation of law";
    when stockholder_acquired_stock_by_operation_of_law(corp, stockholder);
    then prior_approval_disregarded(corp, stockholder);
}
@source(IRC_S216_B, quote = "(B) In any case where a person other than an individual acquires stock of a cooperative housing corporation.")
rule PriorApprovalDisregardedNotIndividual(corp: Integer, stockholder: Integer) strict {
    label en official "a stockholder that is not an individual";
    when stockholder_is_not_an_individual(corp, stockholder);
    then prior_approval_disregarded(corp, stockholder);
}
@source(IRC_S216_B, quote = "(C) In any case where the original seller acquires any stock of the cooperative housing corporation from the corporation not later than 1 year after the date on which the apartments or houses (or leaseholds therein) are transferred by the original seller to the corporation.")
rule PriorApprovalDisregardedOriginalSeller(corp: Integer, stockholder: Integer, acquired: Date, transferred: Date) strict {
    label en official "the original seller acquires stock within a year after transferring the apartments";
    when original_seller_acquired_stock_on(corp, stockholder, acquired);
    when apartments_transferred_by_original_seller_to_corporation_on(corp, stockholder, transferred);
    when acquired <= add_calendar_period(transferred, 1 calendar_year);
    then prior_approval_disregarded(corp, stockholder);
}
pub relation stockholder_treated_as_entitled_to_occupy(corp: Integer, stockholder: Integer) kind institutional {
    label en official "the stockholder is entitled to occupy solely by stock ownership, the prior-approval condition disregarded in the cases of paragraph (5)";
}
@source(IRC_S216_B, quote = "(B) each of the stockholders of which is entitled, solely by reason of his ownership of stock in the corporation, to occupy for dwelling purposes a house, or an apartment in a building, owned or leased by such corporation,")
rule StockholderEntitledToOccupy(corp: Integer, stockholder: Integer) strict {
    label en official "entitled solely by stock ownership";
    when stockholder_entitled_to_occupy_solely_by_stock_ownership(corp, stockholder);
    then stockholder_treated_as_entitled_to_occupy(corp, stockholder);
}
@source(IRC_S216_B, quote = "For purposes of this section, in the following cases there shall not be taken into account the fact that (by agreement with the cooperative housing corporation) the person or his nominee may not occupy the house or apartment without the prior approval of such corporation:")
rule StockholderEntitledToOccupyApprovalDisregarded(corp: Integer, stockholder: Integer) strict {
    label en official "entitled but for a prior-approval condition that is disregarded";
    when stockholder_occupancy_only_subject_to_prior_approval(corp, stockholder);
    when prior_approval_disregarded(corp, stockholder);
    then stockholder_treated_as_entitled_to_occupy(corp, stockholder);
}
pub relation stockholder_disqualifying_occupancy(corp: Integer, y: TaxableYear, stockholder: Integer) kind institutional {
    label en official "a stockholder, other than a governmental unit, that is not entitled to occupy solely by stock ownership";
}
@source(IRC_S216_B, quote = "For purposes of this subsection, in determining whether a corporation is a cooperative housing corporation, stock owned and apartments leased by the United States or any of its possessions, a State or any political subdivision thereof, or any agency or instrumentality of the foregoing empowered to acquire shares in a cooperative housing corporation for the purpose of providing housing facilities, shall not be taken into account.")
rule StockholderDisqualifyingOccupancy(corp: Integer, y: TaxableYear, stockholder: Integer) strict {
    label en official "governmental stockholders are not taken into account";
    when stockholder_of_corporation_216(corp, y, stockholder);
    when not_known(stockholder_treated_as_entitled_to_occupy(corp, stockholder));
    when not_known(stockholder_is_governmental_unit_216(corp, stockholder));
    then stockholder_disqualifying_occupancy(corp, y, stockholder);
}
pub relation stockholder_entitled_to_non_earnings_distribution_before_liquidation(corp: Integer, y: TaxableYear, stockholder: Integer) kind empirical {
    label en official "the stockholder is entitled, conditionally or unconditionally, to a distribution not out of earnings and profits except on a complete or partial liquidation (section 216(b)(1)(C))";
}
pub relation stockholder_disqualifying_distribution_right(corp: Integer, y: TaxableYear, stockholder: Integer) kind institutional {
    label en official "a stockholder, other than a governmental unit, entitled to a distribution not out of earnings and profits before liquidation";
}
@source(IRC_S216_B, quote = "(C) no stockholder of which is entitled (either conditionally or unconditionally) to receive any distribution not out of earnings and profits of the corporation except on a complete or partial liquidation of the corporation, and")
rule StockholderDisqualifyingDistributionRight(corp: Integer, y: TaxableYear, stockholder: Integer) strict {
    label en official "a stockholder with a distribution right other than out of earnings";
    when stockholder_entitled_to_non_earnings_distribution_before_liquidation(corp, y, stockholder);
    when not_known(stockholder_is_governmental_unit_216(corp, stockholder));
    then stockholder_disqualifying_distribution_right(corp, y, stockholder);
}
@source(IRC_S216_B, quote = "The term \"cooperative housing corporation\" means a corporation—")
rule CorporationHasOneClassOfStockAndOccupancyRightsDerived(corp: Integer, y: TaxableYear) strict {
    label en official "one class of stock, every stockholder entitled to occupy, no stockholder with a distribution right outside earnings; an assertion by a case is still accepted";
    when cooperative_candidate_corporation(corp, y);
    when corporation_has_one_and_only_one_class_of_stock(corp, y);
    when count(collect s: Integer where stockholder_disqualifying_occupancy(corp, y, s)) == 0;
    when count(collect s2: Integer where stockholder_disqualifying_distribution_right(corp, y, s2)) == 0;
    then corporation_has_one_class_of_stock_and_occupancy_rights(corp, y);
}
pub relation revokes_unit_allocation_election_216(p: Person, corp: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation revokes its election for the unit allocation of taxes and interest (section 216(b)(3)(B)(ii))";
}
pub relation secretary_consents_to_revocation_216(p: Person, corp: Integer, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation (section 216(b)(3)(B)(ii))";
}
pub relation unit_allocation_election_revoked_216(p: Person, corp: Integer, y: TaxableYear) kind institutional {
    label en official "the election of the unit allocation is revoked with the consent of the Secretary";
}
@source(IRC_S216_B, quote = "Such an election, once made, may be revoked only with the consent of the Secretary.")
rule UnitAllocationRevocationPower(p: Person, corp: Integer, y: TaxableYear) defeasible {
    label en official "revocable only with consent";
    when revokes_unit_allocation_election_216(p, corp, y);
    then power S216bRevokeUnitAllocationElection {
        holder p;
        over corp;
        exercise revokes_unit_allocation_election_216(p, corp, y);
        valid_when secretary_consents_to_revocation_216(p, corp, y);
        effect create(unit_allocation_election_revoked_216(p, corp, y));
        window [-infinity, infinity];
    };
}

// === §216(c): depreciation of stock =============================================================================================================

pub relation stock_allocable_to_proprietary_lease_of_depreciable_property(p: Person, corp: Integer, y: TaxableYear) kind empirical {
    label en official "so much of the stock as is allocable, under the regulations, to a proprietary lease or right of tenancy in property subject to the allowance for depreciation (section 216(c)(1))";
}
pub relation proprietary_lease_used_in_trade_or_business_or_for_production_of_income(p: Person, corp: Integer, y: TaxableYear) kind empirical {
    label en official "the proprietary lease or right of tenancy is used by the tenant-stockholder in a trade or business or for the production of income (section 216(c)(1))";
}
pub relation stock_treated_as_depreciable_property_216c(p: Person, corp: Integer, y: TaxableYear) kind institutional {
    label en official "the stock is treated as property subject to the allowance for depreciation under section 167(a) (section 216(c)(1))";
}
@source(IRC_S216_C, quote = "shall, to the extent such proprietary lease or right of tenancy is used by such tenant-stockholder in a trade or business or for the production of income, be treated as property subject to the allowance for depreciation under section 167(a).")
rule StockTreatedAsDepreciableProperty(p: Person, corp: Integer, y: TaxableYear) strict {
    label en official "stock allocable to a business-use proprietary lease";
    when tenant_stockholder(p, y, corp);
    when stock_allocable_to_proprietary_lease_of_depreciable_property(p, corp, y);
    when proprietary_lease_used_in_trade_or_business_or_for_production_of_income(p, corp, y);
    then stock_treated_as_depreciable_property_216c(p, corp, y);
}
pub relation stock_depreciation_before_basis_limit_216c(p: Person, corp: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the depreciation of the stock for the year, including the amount carried forward from the preceding year (section 216(c)(2))";
}
pub relation adjusted_basis_of_stock_at_close_of_year_216c(p: Person, corp: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted basis of the stock as of the close of the taxable year in which the deduction was incurred (section 216(c)(2)(A))";
}
pub relation stock_depreciation_allowed_216c(p: Person, corp: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the depreciation deduction allowable for the stock: not more than its adjusted basis at the close of the year (section 216(c)(2)(A))";
}
@source(IRC_S216_C, quote = "shall not exceed the adjusted basis of such stock as of the close of the taxable year of the tenant-stockholder in which such deduction was incurred.")
rule StockDepreciationAllowed(p: Person, corp: Integer, y: TaxableYear, depreciation: Money, basis: Money) strict {
    label en official "the lesser of the depreciation and the adjusted basis";
    when stock_treated_as_depreciable_property_216c(p, corp, y);
    when stock_depreciation_before_basis_limit_216c(p, corp, y, depreciation);
    when adjusted_basis_of_stock_at_close_of_year_216c(p, corp, y, basis);
    then stock_depreciation_allowed_216c(p, corp, y, min(depreciation, max(0.00 USD, basis)));
}
pub relation succeeding_taxable_year_216(y: TaxableYear, next: TaxableYear) kind empirical {
    label en official "the succeeding taxable year (section 216(c)(2)(B))";
}
pub relation stock_depreciation_carried_to_succeeding_year_216c(p: Person, corp: Integer, y: TaxableYear, next: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction not allowed by reason of the basis limit is treated as a section 167(a) deduction allowable in the succeeding taxable year (section 216(c)(2)(B))";
}
@source(IRC_S216_C, quote = "The amount of any deduction which is not allowed by reason of subparagraph (A) shall, subject to the provisions of subparagraph (A), be treated as a deduction allowable under section 167(a) in the succeeding taxable year.")
rule StockDepreciationCarryforward(p: Person, corp: Integer, y: TaxableYear, next: TaxableYear, depreciation: Money, basis: Money) strict {
    label en official "the excess over the basis passes to the succeeding year (JUDGMENT CALL: the total with earlier carryforwards is a fact of the case)";
    when stock_treated_as_depreciable_property_216c(p, corp, y);
    when stock_depreciation_before_basis_limit_216c(p, corp, y, depreciation);
    when adjusted_basis_of_stock_at_close_of_year_216c(p, corp, y, basis);
    when succeeding_taxable_year_216(y, next);
    when depreciation > max(0.00 USD, basis);
    then stock_depreciation_carried_to_succeeding_year_216c(p, corp, y, next, depreciation - max(0.00 USD, basis));
}
