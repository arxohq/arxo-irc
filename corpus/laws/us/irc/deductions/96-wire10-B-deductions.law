// Deductions -- WIRE-10, group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Norms the package lacked and that consumer packages of group B need as `pub` relations. Case facts stay a valid channel for every
// consumer (WIRE-7/8/9 technique).

language "law.core" version "0.2";
package us.irc.deductions version "0.1.1";
namespace "urn:us:irc:deductions:clir";

use self::{
    IRC_S168_I,
    IRC_S267_B,
    Person,
    RelatedPartyRelationship,
    related_persons,
};

// --- section 168(i)(3): lease term (read by accounting, section 470(c)(2), (f)(2)) ------------------------------------------------
// The lease is identified by an Integer key (the key of the consumer's placeholder). Terms are whole years (the consumer's
// whole-year simplification for the 5-year short-lease tests). "Successive leases treated as 1 lease" is carried as the years of the
// other leases of the same transaction (section 168(i)(3)(A)(iii)); grouping the leases themselves is a case fact.

pub relation lease_term_components_168i3(lease: Integer, stated_years: Integer, renewal_option_years: Integer, service_contract_years: Integer, successive_lease_years: Integer) kind empirical {
    label en unofficial "the components of a lease term: the term stated in the lease, the years of options to renew, the years of related service contracts or similar arrangements, and the years of successive leases in the same transaction (section 168(i)(3)(A))";
}
pub relation renewal_option_at_fair_market_value_on_real_property_168i3B(lease: Integer) kind empirical {
    label en official "the lease is of nonresidential real property or residential rental property and the option to renew is at fair market value, determined at the time of renewal (section 168(i)(3)(B))";
}
pub relation lease_term_years_168i3(lease: Integer, years: Integer) kind institutional {
    label en official "the lease term under section 168(i)(3): options to renew are taken into account (except fair-market-value options on nonresidential real property or residential rental property), and the terms of related service contracts and of successive leases of the same transaction are included";
}
@source(IRC_S168_I, relation = formalizes, coverage = partial, quote = "there shall be taken into account options to renew")
rule W10LeaseTermWithRenewalOptions(lease: Integer, stated: Integer, renewal: Integer, service: Integer, successive: Integer) strict {
    label en official "section 168(i)(3)(A): the lease term includes the options to renew, the related service contract terms and the successive leases of the same transaction";
    when lease_term_components_168i3(lease, stated, renewal, service, successive);
    when not_known(renewal_option_at_fair_market_value_on_real_property_168i3B(lease));
    then lease_term_years_168i3(lease, stated + renewal + service + successive);
}
@source(IRC_S168_I, relation = formalizes, coverage = partial, quote = "there shall not be taken into account any option to renew at fair market value, determined at the time of renewal")
rule W10LeaseTermWithoutFairMarketValueOption(lease: Integer, stated: Integer, renewal: Integer, service: Integer, successive: Integer) strict {
    label en official "section 168(i)(3)(B): a fair-market-value renewal option on real property is not taken into account";
    when lease_term_components_168i3(lease, stated, renewal, service, successive);
    when renewal_option_at_fair_market_value_on_real_property_168i3B(lease);
    then lease_term_years_168i3(lease, stated + service + successive);
}

// --- section 267(b)(3), (10), (11), (12): related persons of section 1239(c)(1)(C) (read by property_transactions) -----------------
// Owner-derives-consumer technique: property_transactions cannot import deductions (cycle through gross_income). The four relationship
// classes of `related_persons` that section 1239(c)(1)(C) names derive the pub stub of the consumer. The case-fact channel stays valid.

@source(IRC_S267_B, relation = formalizes, coverage = partial, quote = "Two corporations which are members of the same controlled group")
rule W10Related267b3For1239(p: Person, other: Person) strict {
    label en official "corporations that are members of the same controlled group are related under section 267(b)(3), hence controlled entities under section 1239(c)(1)(C)";
    when related_persons(p, other, ControlledGroupCorporations);
    then us.irc.property_transactions::related_under_267b_class_1239c1c(p, other);
}
@source(IRC_S267_B, relation = formalizes, coverage = partial, quote = "A corporation and a partnership if the same persons own")
rule W10Related267b10For1239(p: Person, other: Person) strict {
    label en official "a corporation and a partnership with the same owners are related under section 267(b)(10)";
    when related_persons(p, other, CorporationAndControlledPartnership);
    then us.irc.property_transactions::related_under_267b_class_1239c1c(p, other);
}
@source(IRC_S267_B, relation = formalizes, coverage = partial, quote = "An S corporation and another S corporation if the same persons own")
rule W10Related267b11For1239(p: Person, other: Person) strict {
    label en official "two S corporations with the same owners are related under section 267(b)(11)";
    when related_persons(p, other, TwoControlledSCorporations);
    then us.irc.property_transactions::related_under_267b_class_1239c1c(p, other);
}
@source(IRC_S267_B, relation = formalizes, coverage = partial, quote = "An S corporation and a C corporation, if the same persons own")
rule W10Related267b12For1239(p: Person, other: Person) strict {
    label en official "an S corporation and a C corporation with the same owners are related under section 267(b)(12)";
    when related_persons(p, other, ControlledSAndCCorporation);
    then us.irc.property_transactions::related_under_267b_class_1239c1c(p, other);
}
