// Special disallowances and definitions — stage 2c detail (TECH_GAPS G2734, G2745, G2765-G2768, G2806): (248)(b),(c)
// organizational expenditures and the timing of the election; (269A)(b)(3) related persons; (269B)(a)(2),(3),(c)(3)
// stapled interests and entities; (271)(b)(1), (276)(b)(1) political parties; (277)(b) the exceptions; (280B)
// demolition; (280E) drug trafficking; (281)(a),(b),(d) terminal railroad corporations; (291)(b)(3),(5),(d) special
// rules.
//
// Stage 1 interface changes (recorded): `organizational_expenditures_aggregate`, `terminal_railroad_corporation_281`,
// `terminal_income_credited_or_uncharged_281`, `worthless_debt_owed_by_political_party` and
// `membership_organization_within_277b_exception` are now institutional (derived below, or still asserted by a case);
// the stage 1 organizational-expenditure rules and the stage 1 section 291(a)(1) rule carry `not_known` guards.
// Two variants were added to `DeductionKind` (162-trade-or-business.law): Section280BDemolition and
// Section280EIllegalDrugTrafficking.
//
// JUDGMENT CALLS: (1) a substantial addition to a facility of section 281(d)(2) is a fact of the case
// (`facility_addition_treated_as_separate_facility`), the enactment date of the section being external; (2) the
// election of section 248 is untimely when it is made after the return due date with extensions; (3) the
// organizational expenditure's limited-life test is a fact of the case; (4) amounts are rounded to cents HALF_UP.

// === §248(b),(c): organizational expenditures ==================================================================

use self::{
    Corporation,
    DeductionKind,
    Person,
    TaxableYear,
    deduction_allowed,
    entities_stapled_with_each_other,
    intangible_drilling_or_mining_cost_deduction,
    membership_organization_within_277b_exception,
    ordinary_income_if_section_1245_property_291,
    ordinary_income_under_section_1250_291,
    organizational_expenditures_aggregate,
    section_1250_property_in_certified_pollution_control_facility_with_169_election,
    section_1250_recapture_exception_1250d,
    section_291b2_amortization_deduction,
    taxable_year_begins_on,
    terminal_income_credited_or_uncharged_281,
    terminal_income_not_received_or_accrued_281,
    terminal_railroad_corporation_281,
    worthless_debt_owed_by_political_party,
};

pub relation expenditure_incident_to_creation_of_corporation(c: Corporation, item: Integer) kind empirical {
    label en official "the expenditure is incident to the creation of the corporation (section 248(b)(1))";
}
pub relation expenditure_chargeable_to_capital_account_248(c: Corporation, item: Integer) kind empirical {
    label en official "the expenditure is chargeable to capital account (section 248(b)(2))";
}
pub relation expenditure_amortizable_if_incident_to_creation_of_limited_life_corporation(c: Corporation, item: Integer) kind empirical {
    label en official "the expenditure is of a character which, if incurred incident to the creation of a corporation having a limited life, would be amortizable over that life (section 248(b)(3))";
}
pub relation organizational_expenditure_amount(c: Corporation, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the expenditure";
}
pub relation organizational_expenditure(c: Corporation, item: Integer, amount: Money) kind institutional {
    label en official "an organizational expenditure (section 248(b))";
}
@origin_kind(IRC_S248_B, quote = "The term \"organizational expenditures\" means any expenditure which—")
rule OrganizationalExpenditureDefinition(c: Corporation, item: Integer, amount: Money) strict {
    label en official "incident to the creation, chargeable to capital account and of an amortizable character";
    when organizational_expenditure_amount(c, item, amount);
    when expenditure_incident_to_creation_of_corporation(c, item);
    when expenditure_chargeable_to_capital_account_248(c, item);
    when expenditure_amortizable_if_incident_to_creation_of_limited_life_corporation(c, item);
    then organizational_expenditure(c, item, amount);
}
@origin_kind(IRC_S248_B, quote = "The term \"organizational expenditures\" means any expenditure which—")
rule OrganizationalExpendituresAggregateDerived(c: Corporation, i0: Integer, a0: Money) strict {
    label en official "the sum of the organizational expenditures; an aggregate asserted by a case is still accepted";
    when organizational_expenditure(c, i0, a0);
    then organizational_expenditures_aggregate(c, sum all amount: Money for item: Integer where organizational_expenditure(c, item, amount));
}
pub relation organizational_election_made_on(c: Corporation, y: TaxableYear, on: Date) kind empirical {
    label en official "the date the election under section 248(a) is made for the taxable year (section 248(c))";
}
pub relation return_due_date_with_extensions_248(c: Corporation, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, including extensions (section 248(c))";
}
pub relation organizational_election_untimely(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the election is made later than the time prescribed for filing the return, extensions included, so it is not made (section 248(c))";
}
@origin_kind(IRC_S248_C, quote = "The election provided by subsection (a) may be made for any taxable year but only if made not later than the time prescribed by law for filing the return for such taxable year (including extensions thereof).")
rule OrganizationalElectionUntimely(c: Corporation, y: TaxableYear, made: Date, due: Date) strict {
    label en official "made after the due date with extensions";
    when organizational_election_made_on(c, y, made);
    when return_due_date_with_extensions_248(c, y, due);
    when made > due;
    then organizational_election_untimely(c, y);
}
pub relation taxable_year_index_248(y: TaxableYear, n: Integer) kind empirical {
    label en official "the position of the taxable year in the order of the corporation's taxable years (section 248(c))";
}
pub relation organizational_election_year_and_period(c: Corporation, y: TaxableYear, months: Integer) kind empirical {
    label en official "the taxable year for which the election is made and the amortization period in months elected (section 248(a),(c))";
}
pub relation organizational_period_adhered_to(c: Corporation, y: TaxableYear, months: Integer) kind institutional {
    label en official "the elected period is adhered to for the year of the election and all subsequent taxable years (section 248(c))";
}
@origin_kind(IRC_S248_C, quote = "The period so elected shall be adhered to in computing the taxable income of the corporation for the taxable year for which the election is made and all subsequent taxable years.")
rule OrganizationalPeriodAdheredTo(c: Corporation, y: TaxableYear, y0: TaxableYear, months: Integer, n0: Integer, n: Integer) strict {
    label en official "the period of the election year applies to it and to every later year";
    when organizational_election_year_and_period(c, y0, months);
    when taxable_year_index_248(y0, n0);
    when taxable_year_index_248(y, n);
    when n >= n0;
    when not_known(organizational_election_untimely(c, y0));
    then organizational_period_adhered_to(c, y, months);
}

// === §269A(b)(3): related persons ======================================================================================

pub relation persons_related_within_144a3(a: Integer, b: Integer) kind empirical {
    label en official "the two persons are related persons within the meaning of section 144(a)(3) (section 269A(b)(3))";
}
pub relation treated_as_one_entity_269A(a: Integer, b: Integer) kind institutional {
    label en official "related persons are treated as one entity (section 269A(b)(3))";
}
@origin_kind(IRC_S269A_B, quote = "All related persons (within the meaning of section 144(a)(3)) shall be treated as 1 entity.")
rule RelatedPersonsTreatedAsOneEntity(a: Integer, b: Integer) strict {
    label en official "related persons are one entity";
    when persons_related_within_144a3(a, b);
    then treated_as_one_entity_269A(a, b);
}
pub relation personal_service_corporation_services_share_percent(psc: Integer, person: Integer, pct: Decimal) kind empirical {
    label en official "the percentage of the personal service corporation's services performed for or on behalf of the person";
}
pub relation services_for_entity_group_percent_269A(psc: Integer, person: Integer, pct: Decimal) kind institutional {
    label en official "the percentage of the services performed for the person and all persons related to it, treated as one entity (section 269A(a)(1),(b)(3))";
}
@origin_kind(IRC_S269A_B, quote = "All related persons (within the meaning of section 144(a)(3)) shall be treated as 1 entity.")
rule ServicesForEntityGroupPercent(psc: Integer, person: Integer, o0: Integer, p0: Decimal) strict {
    label en official "the person's own share and the shares of persons related to it";
    when personal_service_corporation_services_share_percent(psc, person, p0);
    when treated_as_one_entity_269A(person, o0);
    then services_for_entity_group_percent_269A(psc, person, p0 + sum all pct: Decimal for other: Integer where treated_as_one_entity_269A(person, other) and personal_service_corporation_services_share_percent(psc, other, pct));
}

// === §269B(a)(2),(3),(c)(3): stapled interests ==========================================================================

pub relation interests_stapled_by_form_or_terms(first: Integer, second: Integer) kind empirical {
    label en official "by reason of form of ownership, restrictions on transfer or other terms or conditions, the interests are linked (section 269B(c)(3))";
}
pub relation transfer_of_one_interest_transfers_or_requires_transfer_of_the_other(first: Integer, second: Integer) kind empirical {
    label en official "in connection with the transfer of one interest the other interests are also transferred or required to be transferred (section 269B(c)(3))";
}
pub relation stapled_interests(first: Integer, second: Integer) kind institutional {
    label en official "the interests are stapled interests (section 269B(c)(3))";
}
@origin_kind(IRC_S269B_C, quote = "Two or more interests are stapled interests if, by reason of form of ownership, restrictions on transfer, or other terms or conditions, in connection with the transfer of 1 of such interests the other such interests are also transferred or required to be transferred.")
rule StapledInterests(first: Integer, second: Integer) strict {
    label en official "interests linked on transfer by their form or terms";
    when interests_stapled_by_form_or_terms(first, second);
    when transfer_of_one_interest_transfers_or_requires_transfer_of_the_other(first, second);
    then stapled_interests(first, second);
}
pub relation stock_of_second_corporation_is_stapled_interest_of_first_corporation_stock(first: Integer, second: Integer) kind empirical {
    label en official "stock in a second corporation constitutes a stapled interest with respect to stock of a first corporation (section 269B(a)(2))";
}
pub relation second_corporation_stock_treated_as_owned_by_first_for_1563(first: Integer, second: Integer) kind institutional {
    label en official "in applying section 1563, the stock of the second corporation is treated as owned by the first corporation (section 269B(a)(2))";
}
@origin_kind(IRC_S269B_A, quote = "(2) in applying section 1563, stock in a second corporation which constitutes a stapled interest with respect to stock of a first corporation shall be treated as owned by such first corporation, and")
rule StapledStockTreatedAsOwnedFor1563(first: Integer, second: Integer) strict {
    label en official "a stapled interest counts as owned by the first corporation";
    when stock_of_second_corporation_is_stapled_interest_of_first_corporation_stock(first, second);
    then second_corporation_stock_treated_as_owned_by_first_for_1563(first, second);
}
pub relation stapled_entities_treated_as_one_entity_for_subchapter_m(first: Integer, second: Integer) kind institutional {
    label en official "in applying subchapter M to whether a stapled entity is a regulated investment company or a real estate investment trust, the stapled entities are treated as one entity (section 269B(a)(3))";
}
@origin_kind(IRC_S269B_A, quote = "(3) in applying subchapter M for purposes of determining whether any stapled entity is a regulated investment company or a real estate investment trust, all entities which are stapled entities with respect to each other shall be treated as 1 entity.")
rule StapledEntitiesOneEntityForSubchapterM(first: Integer, second: Integer) strict {
    label en official "stapled entities are one entity for subchapter M";
    when entities_stapled_with_each_other(first, second);
    then stapled_entities_treated_as_one_entity_for_subchapter_m(first, second);
}

// === §271(b)(1), §276(b)(1): political parties ============================================================================

pub relation entity_is_political_party(ent: Integer) kind empirical {
    label en official "the entity is a political party (section 271(b)(1)(A), 276(b)(1)(A))";
}
pub relation entity_is_committee_of_political_party(ent: Integer) kind empirical {
    label en official "the entity is a national, State or local committee of a political party (section 271(b)(1)(B), 276(b)(1)(B))";
}
pub relation entity_accepts_contributions_or_makes_expenditures_to_influence_election(ent: Integer) kind empirical {
    label en official "the committee, association or organization, incorporated or not, accepts contributions (section 271(b)(2)) or makes expenditures (section 271(b)(3)) to influence the selection, nomination or election of an individual to public office or of presidential electors (section 271(b)(1)(C), 276(b)(1)(C))";
}
pub relation political_party_271b1(ent: Integer) kind institutional {
    label en official "a political party for section 271 (section 271(b)(1))";
}
@origin_kind(IRC_S271_B, quote = "(A) a political party;")
rule PoliticalParty271A(ent: Integer) strict {
    label en official "a political party";
    when entity_is_political_party(ent);
    then political_party_271b1(ent);
}
@origin_kind(IRC_S271_B, quote = "(B) a national, State, or local committee of a political party; or")
rule PoliticalParty271B(ent: Integer) strict {
    label en official "a committee of a political party";
    when entity_is_committee_of_political_party(ent);
    then political_party_271b1(ent);
}
@origin_kind(IRC_S271_B, quote = "(C) a committee, association, or organization which accepts contributions or makes expenditures for the purpose of influencing or attempting to influence the election of presidential or vice-presidential electors or of any individual whose name is presented for election to any Federal, State, or local elective public office, whether or not such individual is elected.")
rule PoliticalParty271C(ent: Integer) strict {
    label en official "an organization that accepts contributions or makes expenditures to influence an election";
    when entity_accepts_contributions_or_makes_expenditures_to_influence_election(ent);
    then political_party_271b1(ent);
}
pub relation political_party_276b1(ent: Integer) kind institutional {
    label en official "a political party for section 276 (section 276(b)(1))";
}
@origin_kind(IRC_S276_B, quote = "(A) a political party;")
rule PoliticalParty276A(ent: Integer) strict {
    label en official "a political party";
    when entity_is_political_party(ent);
    then political_party_276b1(ent);
}
@origin_kind(IRC_S276_B, quote = "(B) a National, State, or local committee of a political party; or")
rule PoliticalParty276B(ent: Integer) strict {
    label en official "a committee of a political party";
    when entity_is_committee_of_political_party(ent);
    then political_party_276b1(ent);
}
@origin_kind(IRC_S276_B, quote = "(C) a committee, association, or organization, whether incorporated or not, which directly or indirectly accepts contributions (as defined in section 271(b)(2)) or make expenditures (as defined in section 271(b)(3)) for the purpose of influencing or attempting to influence the selection, nomination, or election of any individual to any Federal, State, or local elective public office, or the election of presidential and vice-presidential electors, whether or not such individual or electors are selected, nominated, or elected.")
rule PoliticalParty276C(ent: Integer) strict {
    label en official "an organization, incorporated or not, that accepts contributions or makes expenditures to influence a selection, nomination or election";
    when entity_accepts_contributions_or_makes_expenditures_to_influence_election(ent);
    then political_party_276b1(ent);
}
pub relation worthless_debt_owed_by_debtor(p: Person, y: TaxableYear, item: Integer, debtor: Integer, amount: Money) kind empirical {
    label en official "a debt owed to the taxpayer by the debtor that becomes worthless, or a security of the debtor that becomes worthless (section 271(a))";
}
@origin_kind(IRC_S271_B, quote = "For purposes of subsection (a), the term \"political party\" means—")
rule WorthlessDebtOwedByPoliticalPartyDerived(p: Person, y: TaxableYear, item: Integer, debtor: Integer, amount: Money) strict {
    label en official "a worthless debt owed by a political party; an amount asserted by a case is still accepted";
    when worthless_debt_owed_by_debtor(p, y, item, debtor, amount);
    when political_party_271b1(debtor);
    then worthless_debt_owed_by_political_party(p, y, item, amount);
}

// === §277(b): the exceptions ===================================================================================================

pub relation organization_subject_to_taxation_under_subchapter_h_or_l(p: Person, y: TaxableYear) kind empirical {
    label en official "the organization is for the taxable year subject to taxation under subchapter H or L (section 277(b)(1))";
}
pub relation organization_made_456c_election_before_october_9_1969_or_affiliated(p: Person) kind empirical {
    label en official "the organization made an election before October 9, 1969 under section 456(c) or is affiliated with such an organization (section 277(b)(2))";
}
pub relation organization_is_securities_exchange_or_contract_market_every_day(p: Person, y: TaxableYear) kind empirical {
    label en official "for each day of the taxable year the organization is a national securities exchange subject to regulation under the Securities Exchange Act of 1934 or a contract market subject to regulation under the Commodity Exchange Act (section 277(b)(3))";
}
pub relation organization_engaged_primarily_in_news_gathering_for_members(p: Person, y: TaxableYear) kind empirical {
    label en official "the organization is engaged primarily in the gathering and distribution of news to its members for publication (section 277(b)(4))";
}
@origin_kind(IRC_S277_B, quote = "(1) which for the taxable year is subject to taxation under subchapter H or L,")
rule Exception277Subchapters(p: Person, y: TaxableYear) strict {
    label en official "an insurance company or bank taxed under subchapter H or L";
    when organization_subject_to_taxation_under_subchapter_h_or_l(p, y);
    then membership_organization_within_277b_exception(p, y);
}
@origin_kind(IRC_S277_B, quote = "(2) which has made an election before October 9, 1969, under section 456(c) or which is affiliated with such an organization,")
rule Exception277Election456c(p: Person, y: TaxableYear, b0: Date) strict {
    label en official "a section 456(c) electing organization";
    when organization_made_456c_election_before_october_9_1969_or_affiliated(p);
    when taxable_year_begins_on(y, b0);
    then membership_organization_within_277b_exception(p, y);
}
@origin_kind(IRC_S277_B, quote = "(3) which for each day of any taxable year is a national securities exchange subject to regulation under the Securities Exchange Act of 1934 or a contract market subject to regulation under the Commodity Exchange Act, or")
rule Exception277Exchange(p: Person, y: TaxableYear) strict {
    label en official "an exchange or contract market";
    when organization_is_securities_exchange_or_contract_market_every_day(p, y);
    then membership_organization_within_277b_exception(p, y);
}
@origin_kind(IRC_S277_B, quote = "(4) which is engaged primarily in the gathering and distribution of news to its members for publication.")
rule Exception277News(p: Person, y: TaxableYear) strict {
    label en official "a news-gathering organization";
    when organization_engaged_primarily_in_news_gathering_for_members(p, y);
    then membership_organization_within_277b_exception(p, y);
}

// === §280B: demolition of structures ===============================================================================================

pub relation demolition_of_structure(p: Person, y: TaxableYear, structure: Integer) kind empirical {
    label en official "the structure is demolished during the taxable year (section 280B)";
}
pub relation taxpayer_is_owner_or_lessee_of_structure(p: Person, structure: Integer) kind empirical {
    label en official "the taxpayer is the owner or lessee of the structure (section 280B(1))";
}
pub relation amount_expended_for_demolition(p: Person, y: TaxableYear, structure: Integer, amount: Money) kind empirical {
    label en official "an amount expended for the demolition (section 280B(1)(A))";
}
pub relation loss_sustained_on_account_of_demolition(p: Person, y: TaxableYear, structure: Integer, amount: Money) kind empirical {
    label en official "a loss sustained on account of the demolition (section 280B(1)(B))";
}
@origin_kind(IRC_S280B, quote = "(A) any amount expended for such demolition, or")
rule DemolitionExpenditureNotDeductible(p: Person, y: TaxableYear, structure: Integer, amount: Money) strict {
    label en official "no deduction for the cost of demolishing a structure the taxpayer owns or leases";
    when demolition_of_structure(p, y, structure);
    when taxpayer_is_owner_or_lessee_of_structure(p, structure);
    when amount_expended_for_demolition(p, y, structure, amount);
    then not deduction_allowed(p, y, Section280BDemolition, amount);
}
@origin_kind(IRC_S280B, quote = "(B) any loss sustained on account of such demolition; and")
rule DemolitionLossNotDeductible(p: Person, y: TaxableYear, structure: Integer, amount: Money) strict {
    label en official "no deduction for the loss on the demolition";
    when demolition_of_structure(p, y, structure);
    when taxpayer_is_owner_or_lessee_of_structure(p, structure);
    when loss_sustained_on_account_of_demolition(p, y, structure, amount);
    then not deduction_allowed(p, y, Section280BDemolition, amount);
}
pub relation demolition_amount_capitalized_to_land(p: Person, y: TaxableYear, structure: Integer, amount: Money) kind institutional {
    label en official "the amounts of paragraph (1) are properly chargeable to capital account with respect to the land on which the structure stood (section 280B(2))";
}
@origin_kind(IRC_S280B, quote = "(2) amounts described in paragraph (1) shall be treated as properly chargeable to capital account with respect to the land on which the demolished structure was located.")
rule DemolitionExpenditureCapitalizedToLand(p: Person, y: TaxableYear, structure: Integer, amount: Money) strict {
    label en official "the expenditure is added to the basis of the land";
    when demolition_of_structure(p, y, structure);
    when taxpayer_is_owner_or_lessee_of_structure(p, structure);
    when amount_expended_for_demolition(p, y, structure, amount);
    then demolition_amount_capitalized_to_land(p, y, structure, amount);
}
@origin_kind(IRC_S280B, quote = "(2) amounts described in paragraph (1) shall be treated as properly chargeable to capital account with respect to the land on which the demolished structure was located.")
rule DemolitionLossCapitalizedToLand(p: Person, y: TaxableYear, structure: Integer, amount: Money) strict {
    label en official "the loss is added to the basis of the land";
    when demolition_of_structure(p, y, structure);
    when taxpayer_is_owner_or_lessee_of_structure(p, structure);
    when loss_sustained_on_account_of_demolition(p, y, structure, amount);
    then demolition_amount_capitalized_to_land(p, y, structure, amount);
}

// === §280E: expenditures in connection with the illegal sale of drugs ==============================================================

pub relation business_consists_of_trafficking_in_schedule_i_or_ii_substances(p: Person, y: TaxableYear, business: Integer) kind empirical {
    label en official "the trade or business, or the activities that comprise it, consists of trafficking in controlled substances within schedule I or II of the Controlled Substances Act (section 280E)";
}
pub relation trafficking_prohibited_by_federal_or_state_law_where_conducted(p: Person, y: TaxableYear, business: Integer) kind empirical {
    label en official "the trafficking is prohibited by Federal law or by the law of a State in which the business is conducted (section 280E)";
}
pub relation amount_paid_in_carrying_on_business(p: Person, y: TaxableYear, business: Integer, amount: Money) kind empirical {
    label en official "an amount paid or incurred during the taxable year in carrying on the trade or business (section 280E)";
}
pub relation trafficking_business(p: Person, y: TaxableYear, business: Integer) kind institutional {
    label en official "the business is one within section 280E";
}
@origin_kind(IRC_S280E, quote = "consists of trafficking in controlled substances (within the meaning of schedule I and II of the Controlled Substances Act) which is prohibited by Federal law or the law of any State in which such trade or business is conducted.")
rule TraffickingBusiness280E(p: Person, y: TaxableYear, business: Integer) strict {
    label en official "trafficking in schedule I or II substances that is prohibited by Federal or State law";
    when business_consists_of_trafficking_in_schedule_i_or_ii_substances(p, y, business);
    when trafficking_prohibited_by_federal_or_state_law_where_conducted(p, y, business);
    then trafficking_business(p, y, business);
}
@origin_kind(IRC_S280E, quote = "No deduction or credit shall be allowed for any amount paid or incurred during the taxable year in carrying on any trade or business if such trade or business")
rule TraffickingBusinessNoDeduction(p: Person, y: TaxableYear, business: Integer, amount: Money) strict {
    label en official "no deduction for amounts paid in carrying on the business";
    when trafficking_business(p, y, business);
    when amount_paid_in_carrying_on_business(p, y, business, amount);
    then not deduction_allowed(p, y, Section280EIllegalDrugTrafficking, amount);
}
pub relation credit_denied_for_trafficking_business_280E(p: Person, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "no credit for an amount paid or incurred in carrying on the business (section 280E)";
}
@origin_kind(IRC_S280E, quote = "No deduction or credit shall be allowed for any amount paid or incurred during the taxable year in carrying on any trade or business if such trade or business")
rule TraffickingBusinessNoCredit(p: Person, y: TaxableYear, business: Integer, amount: Money) strict {
    label en official "no credit for amounts paid in carrying on the business";
    when trafficking_business(p, y, business);
    when amount_paid_in_carrying_on_business(p, y, business, amount);
    then credit_denied_for_trafficking_business_280E(p, y, business, amount);
}

// === §281: terminal railroad corporations ==============================================================================================

pub relation railroad_corporation_is_domestic(c: Corporation) kind empirical {
    label en official "the corporation is a domestic railroad corporation (section 281(d)(1))";
}
pub relation member_of_affiliated_group_other_than_as_common_parent(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a member of an affiliated group (section 1504) other than as the common parent (section 281(d)(1))";
}
pub relation all_shareholders_are_rail_carriers(c: Corporation, y: TaxableYear) kind empirical {
    label en official "all the shareholders are rail carriers subject to part A of subtitle IV of title 49 (section 281(d)(1)(A))";
}
pub relation primary_business_is_railroad_terminal_and_switching_services(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the primary business is providing railroad terminal and switching facilities and services to rail carriers and to their shippers and passengers (section 281(d)(1)(B))";
}
pub relation substantial_part_of_services_rendered_to_shareholders(c: Corporation, y: TaxableYear) kind empirical {
    label en official "a substantial part of the services for the taxable year is rendered to one or more of its shareholders (section 281(d)(1)(C))";
}
pub relation each_shareholder_has_same_taxable_year(c: Corporation, y: TaxableYear) kind empirical {
    label en official "each shareholder computes its taxable income on the basis of a taxable year beginning or ending on the same day as the corporation's (section 281(d)(1)(D))";
}
@origin_kind(IRC_S281_D, quote = "The term \"terminal railroad corporation\" means a domestic railroad corporation which is not a member, other than as a common parent corporation, of an affiliated group (as defined in section 1504) and—")
rule TerminalRailroadCorporationDerived(c: Corporation, y: TaxableYear) strict {
    label en official "a domestic railroad corporation outside an affiliated group meeting the four conditions; an assertion by a case is still accepted";
    when railroad_corporation_is_domestic(c);
    when not_known(member_of_affiliated_group_other_than_as_common_parent(c, y));
    when all_shareholders_are_rail_carriers(c, y);
    when primary_business_is_railroad_terminal_and_switching_services(c, y);
    when substantial_part_of_services_rendered_to_shareholders(c, y);
    when each_shareholder_has_same_taxable_year(c, y);
    then terminal_railroad_corporation_281(c, y);
}
pub enum RelatedTerminalIncomeKind {
    OrdinaryTerminalServices;
    NonRailroadUseOfRailroadFacility;
    ServicesInConnectionWithRailroadOperations;
    MailHandlingFromUnitedStates;
    OtherIncome;
}
pub relation terminal_income_item(c: Corporation, y: TaxableYear, item: Integer, kind: RelatedTerminalIncomeKind, amount: Money) kind empirical {
    label en official "an item of income of the terminal railroad corporation, by the source of the income (section 281(d)(2)(A)-(D))";
}
pub relation facility_addition_treated_as_separate_facility(c: Corporation, item: Integer) kind empirical {
    label en official "the income is from a substantial addition, constructed after the enactment of section 281, to a facility, which is treated as a separate facility (section 281(d)(2) last sentence)";
}
pub relation related_terminal_income(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "related terminal income: income from the services and facilities of section 281(d)(2)(A)-(D) (determined under regulations)";
}
@origin_kind(IRC_S281_D, quote = "(A) from services or facilities of a character ordinarily and regularly provided by terminal railroad corporations for railroad corporations or for the employees, passengers, or shippers of railroad corporations;")
rule RelatedTerminalIncomeOrdinary(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "income from ordinary terminal services";
    when terminal_income_item(c, y, item, OrdinaryTerminalServices, amount);
    then related_terminal_income(c, y, item, amount);
}
@origin_kind(IRC_S281_D, quote = "(B) from the use by persons other than railroad corporations of portions of a facility, or a service, which is used primarily for railroad purposes;")
rule RelatedTerminalIncomeNonRailroadUse(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "income from the use by others of a facility used primarily for railroad purposes, an addition being a separate facility (JUDGMENT CALL: the separate-facility question is a fact of the case)";
    when terminal_income_item(c, y, item, NonRailroadUseOfRailroadFacility, amount);
    when not_known(facility_addition_treated_as_separate_facility(c, item));
    then related_terminal_income(c, y, item, amount);
}
@origin_kind(IRC_S281_D, quote = "(C) from any railroad corporation for services or facilities provided by such terminal railroad corporation in connection with railroad operations; and")
rule RelatedTerminalIncomeRailroadOperations(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "income from a railroad corporation for services in connection with railroad operations";
    when terminal_income_item(c, y, item, ServicesInConnectionWithRailroadOperations, amount);
    then related_terminal_income(c, y, item, amount);
}
@origin_kind(IRC_S281_D, quote = "(D) from the United States in payment for facilities or services in connection with mail handling.")
rule RelatedTerminalIncomeMail(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "income from the United States for mail handling";
    when terminal_income_item(c, y, item, MailHandlingFromUnitedStates, amount);
    then related_terminal_income(c, y, item, amount);
}
pub relation liability_discharged_by_crediting_related_terminal_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of a railroad corporation's liability for related terminal services that is discharged by crediting it with related terminal income (section 281(a)(1)(A)(i))";
}
pub relation charge_not_made_because_related_terminal_income_taken_into_account(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of a charge for related terminal services that is not made as a result of taking related terminal income into account in computing the charge (section 281(a)(1)(A)(ii))";
}
pub relation terminal_credit_present(c: Corporation, y: TaxableYear) kind institutional {
    label en official "helper: a discharge by crediting is given";
}
rule TerminalCreditPresentKeyed(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when liability_discharged_by_crediting_related_terminal_income(c, y, amount);
    then terminal_credit_present(c, y);
}
pub relation terminal_uncharged_present(c: Corporation, y: TaxableYear) kind institutional {
    label en official "helper: a charge not made is given";
}
rule TerminalUnchargedPresentKeyed(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when charge_not_made_because_related_terminal_income_taken_into_account(c, y, amount);
    then terminal_uncharged_present(c, y);
}
@origin_kind(IRC_S281_A, quote = "(i) the portion of any liability of any railroad corporation, with respect to related terminal services provided by such corporation, which is discharged by crediting such liability with an amount of related terminal income, or")
rule TerminalIncomeCreditedOnly(c: Corporation, y: TaxableYear, credited: Money) strict {
    label en official "the discharge by crediting alone";
    when liability_discharged_by_crediting_related_terminal_income(c, y, credited);
    when not_known(terminal_uncharged_present(c, y));
    then terminal_income_credited_or_uncharged_281(c, y, credited);
}
@origin_kind(IRC_S281_A, quote = "(ii) the portion of any charge which would be made by such corporation for related terminal services provided by it, but which is not made as a result of taking related terminal income into account in computing such charge; and")
rule TerminalIncomeUnchargedOnly(c: Corporation, y: TaxableYear, uncharged: Money) strict {
    label en official "the charge not made alone";
    when charge_not_made_because_related_terminal_income_taken_into_account(c, y, uncharged);
    when not_known(terminal_credit_present(c, y));
    then terminal_income_credited_or_uncharged_281(c, y, uncharged);
}
@origin_kind(IRC_S281_A, quote = "(ii) the portion of any charge which would be made by such corporation for related terminal services provided by it, but which is not made as a result of taking related terminal income into account in computing such charge; and")
rule TerminalIncomeCreditedAndUncharged(c: Corporation, y: TaxableYear, credited: Money, uncharged: Money) strict {
    label en official "both, added";
    when liability_discharged_by_crediting_related_terminal_income(c, y, credited);
    when charge_not_made_because_related_terminal_income_taken_into_account(c, y, uncharged);
    then terminal_income_credited_or_uncharged_281(c, y, credited + uncharged);
}
pub relation deduction_not_disallowed_by_terminal_discharge_281a1B(c: Corporation, y: TaxableYear) kind institutional {
    label en official "no deduction otherwise allowable is disallowed as a result of the discharge or the computation of charges (section 281(a)(1)(B))";
}
@origin_kind(IRC_S281_A, quote = "(B) no deduction otherwise allowable under this chapter shall be disallowed as a result of any discharge of liability described in subparagraph (A)(i) or as a result of any computation of charges in the manner described in subparagraph (A)(ii).")
rule DeductionNotDisallowedByTerminalDischarge(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "the protection holds when the amounts are not treated as received or accrued";
    when terminal_income_not_received_or_accrued_281(c, y, amount);
    then deduction_not_disallowed_by_terminal_discharge_281a1B(c, y);
}
pub relation shareholder_of_terminal_railroad_corporation(sh: Person, c: Corporation, y: TaxableYear) kind empirical {
    label en official "the person is a shareholder of the terminal railroad corporation (section 281(b))";
}
pub relation shareholder_amount_not_received_accrued_paid_or_incurred_281b(sh: Person, c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "no amount is considered received, accrued, paid or incurred by the shareholder as a result of the discharge or the computation of charges (section 281(b))";
}
@origin_kind(IRC_S281_B, quote = "in computing the taxable income of any shareholder of a terminal railroad corporation, no amount shall be considered to have been received or accrued or paid or incurred by such shareholder")
rule ShareholderAmountNotRecognized(sh: Person, c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "the shareholder is treated as the corporation is, subject to the net operating loss limitation";
    when shareholder_of_terminal_railroad_corporation(sh, c, y);
    when terminal_income_not_received_or_accrued_281(c, y, amount);
    then shareholder_amount_not_received_accrued_paid_or_incurred_281b(sh, c, y, amount);
}

// === §291(b)(3),(5),(d) ========================================================================================================================

pub enum Section291bDeductionSource {
    Section263cIntegratedOil;
    Section616a;
    Section617a;
}
pub relation section_291b_cost_source(c: Corporation, y: TaxableYear, item: Integer, origin_kind: Section291bDeductionSource) kind empirical {
    label en official "the section under which the cost is deductible: section 263(c) for an integrated oil company, 616(a) or 617(a) (section 291(b)(3))";
}
pub relation amortization_deduction_treated_as_deduction_under_source_for_1254(c: Corporation, y: TaxableYear, item: Integer, origin_kind: Section291bDeductionSource, amount: Money) kind institutional {
    label en official "for section 1254 the section 291(b)(2) deduction is treated as a deduction under section 263(c), 616(a) or 617(a), whichever is appropriate (section 291(b)(3))";
}
@origin_kind(IRC_S291_B, quote = "For purposes of section 1254, any deduction under paragraph (2) shall be treated as a deduction allowable under section 263(c), 616(a), or 617(a) (whichever is appropriate).")
rule AmortizationTreatedAsSourceDeductionFor1254(c: Corporation, y: TaxableYear, item: Integer, origin_kind: Section291bDeductionSource, amount: Money) strict {
    label en official "the amortization keeps the character of the deduction it replaces";
    when section_291b2_amortization_deduction(c, y, item, amount);
    when section_291b_cost_source(c, y, item, origin_kind);
    then amortization_deduction_treated_as_deduction_under_source_for_1254(c, y, item, origin_kind, amount);
}
pub relation property_basis_attributable_to_amounts_reduced_under_291b1(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the part of the adjusted basis of the property attributable to the amounts to which paragraph (1) applied (section 291(b)(5))";
}
@origin_kind(IRC_S291_B, quote = "The portion of the adjusted basis of any property which is attributable to amounts to which paragraph (1) applied shall not be taken into account for purposes of determining depletion under section 611.")
rule BasisAttributableToReducedAmounts(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the 30 percent not allowed remains in basis as the reduced part";
    when intangible_drilling_or_mining_cost_deduction(c, y, item, amount);
    then property_basis_attributable_to_amounts_reduced_under_291b1(c, y, item, round(amount * 0.30, 2, "HALF_UP"));
}
pub relation adjusted_basis_of_property_for_291b5(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the property";
}
pub relation basis_for_cost_depletion_after_291b5(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the basis taken into account for cost depletion under section 611: the adjusted basis without the part attributable to the amounts reduced under paragraph (1) (section 291(b)(5))";
}
@origin_kind(IRC_S291_B, quote = "The portion of the adjusted basis of any property which is attributable to amounts to which paragraph (1) applied shall not be taken into account for purposes of determining depletion under section 611.")
rule BasisForCostDepletionWithout291bPortion(c: Corporation, y: TaxableYear, item: Integer, basis: Money, reduced: Money) strict {
    label en official "the adjusted basis less the part attributable to the reduced amounts";
    when adjusted_basis_of_property_for_291b5(c, y, item, basis);
    when property_basis_attributable_to_amounts_reduced_under_291b1(c, y, item, reduced);
    then basis_for_cost_depletion_after_291b5(c, y, item, max(0.00 USD, basis - reduced));
}
pub relation taxpayer_is_real_estate_investment_trust_291(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the corporation is a real estate investment trust as defined in section 856 (section 291(d))";
}
pub relation reit_capital_gain_dividend_paid_out_of_difference(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the capital gain dividend (section 857(b)(3)(C), without this section) treated as paid out of the difference between the section 1245 and section 1250 amounts (section 291(d))";
}
pub relation section_1250_difference_after_reit_reduction_291d(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the excess of the section 1245 recapture amount over the section 1250 recapture amount, reduced by the capital gain dividend treated as paid out of it (section 291(d))";
}
@origin_kind(IRC_S291_D, quote = "the difference between the amounts described in subparagraphs (A) and (B) of subsection (a)(1) shall be reduced to the extent that a capital gain dividend")
rule Section1250DifferenceReducedForReit(c: Corporation, y: TaxableYear, prop: Integer, a: Money, b: Money, dividend: Money) strict {
    label en official "the difference less the capital gain dividend, not below zero";
    when taxpayer_is_real_estate_investment_trust_291(c, y);
    when ordinary_income_if_section_1245_property_291(c, y, prop, a);
    when ordinary_income_under_section_1250_291(c, y, prop, b);
    when reit_capital_gain_dividend_paid_out_of_difference(c, y, prop, dividend);
    when a > b;
    then section_1250_difference_after_reit_reduction_291d(c, y, prop, max(0.00 USD, (a - b) - dividend));
}
pub relation additional_section_1250_ordinary_income_of_reit_291(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the 20 percent of the reduced difference treated as ordinary income under section 1250 by a real estate investment trust (section 291(a)(1),(d))";
}
@origin_kind(IRC_S291_A, quote = "20 percent of the excess (if any) of—")
rule AdditionalSection1250IncomeOfReit(c: Corporation, y: TaxableYear, prop: Integer, difference: Money) strict {
    label en official "20 percent of the reduced difference";
    when section_1250_difference_after_reit_reduction_291d(c, y, prop, difference);
    when not_known(section_1250_property_in_certified_pollution_control_facility_with_169_election(c, y, prop));
    when not_known(section_1250_recapture_exception_1250d(c, y, prop));
    then additional_section_1250_ordinary_income_of_reit_291(c, y, prop, round(difference * 0.20, 2, "HALF_UP"));
}
pub relation capital_gain_dividend_retains_section_1250_character_291d(sh: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "a capital gain dividend treated as paid out of the difference to a shareholder that is an applicable corporation keeps its character as gain from section 1250 property for applying subsection (a)(1) to the shareholder (section 291(d))";
}
pub relation capital_gain_dividend_received_by_applicable_corporation(sh: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the amount of such a dividend received by a shareholder that is an applicable corporation";
}
@origin_kind(IRC_S291_D, quote = "Any capital gain dividend treated as having been paid out of such difference to a shareholder which is an applicable corporation retains its character in the hands of the shareholder as gain from the disposition of section 1250 property for purposes of applying subsection (a)(1) to such shareholder.")
rule CapitalGainDividendRetainsCharacter(sh: Corporation, y: TaxableYear, prop: Integer, amount: Money) strict {
    label en official "the character is kept";
    when capital_gain_dividend_received_by_applicable_corporation(sh, y, prop, amount);
    then capital_gain_dividend_retains_section_1250_character_291d(sh, y, prop, amount);
}
