// Section 274 — stage 2b detail (TECH_GAPS G2780): (b) the definition of gift and the special rules,
// (e)(2)(B),(9) specified individuals, (f) the deductions outside section 274, (g) facilities,
// (h)(4),(6),(7) conventions, (i) qualified nonpersonal use vehicles, (j)(3),(4) achievement awards,
// (k)(2) the exceptions to the meals validity condition. Stage 1 changes: `recipient_is_specified_individual`
// and `gift_expense_to_individual_in_year` are now institutional (derived here or asserted);
// Exception274e2Compensation and Exception274e9IncludibleInIncome do not apply to a specified
// individual (the amount-limited rules below do); the stage 1 lavish-meal denial stands aside for the
// (k)(2)(A) exceptions. Not modelled: the exchange-of-information agreement machinery of (h)(6)(C)-(D)
// and the Presidential publication; the spouse aggregation of (b)(2)(B) beyond the classification.

// --- (b): gifts ----------------------------------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S274_B,
    IRC_S274_E,
    IRC_S274_F,
    IRC_S274_G,
    IRC_S274_H,
    IRC_S274_I,
    IRC_S274_J,
    IRC_S274_K,
    Person,
    TaxableYear,
    deduction_allowed,
    entertainment_exception_applies_274e,
    entertainment_sold_to_customers_for_adequate_consideration,
    expense_includible_in_income_of_non_employee_recipient,
    expense_treated_as_compensation_and_wages,
    food_or_beverage_expense,
    gift_expense_to_individual_in_year,
    goods_services_facilities_made_available_to_general_public,
    information_return_required_but_amount_not_included,
    recipient_is_specified_individual,
    recreational_expense_primarily_for_employees_not_highly_compensated,
    reimbursed_expense_with_accounting_or_employer_untreated,
};

pub relation gift_item_paid(p: Person, y: TaxableYear, recipient: Person, item: Integer, cost: Money) kind empirical {
    label en official "an item given directly or indirectly to an individual, excludable from the recipient's gross income under section 102 and not under any other provision of chapter 1, with its cost to the taxpayer (section 274(b)(1))";
}
pub relation item_cost_at_most_4_dollars_imprinted_identical_distributed_generally(item: Integer) kind empirical {
    label en official "an item costing the taxpayer not more than $4.00, on which the taxpayer's name is clearly and permanently imprinted, one of a number of identical items distributed generally by the taxpayer (section 274(b)(1)(A))";
}
pub relation item_is_sign_display_rack_or_promotional_material_for_recipient_premises(item: Integer) kind empirical {
    label en official "a sign, display rack or other promotional material to be used on the business premises of the recipient (section 274(b)(1)(B))";
}
pub relation gift_within_274b(item: Integer) kind institutional {
    label en official "a gift within section 274(b)(1): the item is not one of the two excluded kinds";
}
rule GiftItemNotExcluded(p: Person, y: TaxableYear, recipient: Person, item: Integer, cost: Money) defeasible {
    label en official "an item is a gift unless it is an imprinted item of $4 or less distributed generally or promotional material for the recipient's premises (section 274(b)(1))";
    when gift_item_paid(p, y, recipient, item, cost);
    when not_known(item_cost_at_most_4_dollars_imprinted_identical_distributed_generally(item));
    when not_known(item_is_sign_display_rack_or_promotional_material_for_recipient_premises(item));
    then gift_within_274b(item);
}
pub relation gift_item_counted(p: Person, y: TaxableYear, recipient: Person, item: Integer, cost: Money) kind institutional {
    label en official "a gift item counted toward the $25 limit";
}
rule GiftItemCounted(p: Person, y: TaxableYear, recipient: Person, item: Integer, cost: Money) defeasible {
    label en official "the cost of a gift within section 274(b)(1) counts toward the limit";
    when gift_item_paid(p, y, recipient, item, cost);
    when gift_within_274b(item);
    then gift_item_counted(p, y, recipient, item, cost);
}
@source(IRC_S274_B, quote = "to the extent that such expense, when added to prior expenses of the taxpayer for gifts made to such individual during the same taxable year, exceeds $25")
rule GiftExpenseToIndividualAggregated(p: Person, y: TaxableYear, recipient: Person, i0: Integer, c0: Money) defeasible {
    label en official "the gift expense for the year to the individual is the sum of the counted gift items (section 274(b)(1)); the stage 1 $25 rule reads this total";
    when gift_item_counted(p, y, recipient, i0, c0);
    then gift_expense_to_individual_in_year(p, y, recipient,
        sum all cost: Money for item: Integer where gift_item_counted(p, y, recipient, item, cost));
}
pub relation gift_by_partnership(p: Person, member: Person) kind empirical {
    label en official "the taxpayer is a partnership and the person is a member of it (section 274(b)(2)(A))";
}
pub relation gift_limit_applies_to(p: Person, subject: Person) kind institutional {
    label en official "the $25 limitation applies to the subject: the partnership and each member (section 274(b)(2)(A))";
}
@source(IRC_S274_B, quote = "In the case of a gift by a partnership, the limitation contained in paragraph (1) shall apply to the partnership as well as to each member thereof.")
rule PartnershipGiftLimitAppliesToPartnershipAndMembers(p: Person, member: Person) strict {
    label en official "the limit applies to the partnership and to each member (section 274(b)(2)(A))";
    when gift_by_partnership(p, member);
    then gift_limit_applies_to(p, member);
}
pub relation husband_and_wife_274b(a: Person, b: Person) kind empirical {
    label en official "the two persons are husband and wife (section 274(b)(2)(B))";
}
pub relation treated_as_one_taxpayer_for_gift_limit(a: Person, b: Person) kind institutional {
    label en official "a husband and wife are treated as one taxpayer for the gift limit (section 274(b)(2)(B)); the combined gift expense is then the couple's items asserted under one taxpayer";
}
@source(IRC_S274_B, quote = "For purposes of paragraph (1), a husband and wife shall be treated as one taxpayer.")
rule HusbandAndWifeOneTaxpayerForGiftLimit(a: Person, b: Person) strict {
    label en official "a husband and wife are one taxpayer for the gift limit (section 274(b)(2)(B))";
    when husband_and_wife_274b(a, b);
    then treated_as_one_taxpayer_for_gift_limit(a, b);
}

// --- (e)(2)(B),(9): specified individuals ---------------------------------------------------------------------------------------------------------------

pub relation recipient_subject_to_section_16a_of_securities_exchange_act(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the recipient is subject to the requirements of section 16(a) of the Securities Exchange Act of 1934 with respect to the taxpayer or a related party (a person related within section 267(b) or 707(b)) (section 274(e)(2)(B)(ii)(I))";
}
pub relation recipient_would_be_subject_to_16a_if_taxpayer_were_issuer(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the recipient would be subject to such requirements if the taxpayer (or such related party) were an issuer of equity securities referred to in section 16 (section 274(e)(2)(B)(ii)(II))";
}
@source(IRC_S274_E, quote = "(I) is subject to the requirements of section 16(a) of the Securities Exchange Act of 1934 with respect to the taxpayer or a related party to the taxpayer, or")
rule SpecifiedIndividualSubjectTo16a(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "an individual subject to section 16(a) is a specified individual (section 274(e)(2)(B)(ii)(I))";
    when recipient_subject_to_section_16a_of_securities_exchange_act(p, y, item);
    then recipient_is_specified_individual(p, y, item);
}
@source(IRC_S274_E, quote = "(II) would be subject to such requirements if the taxpayer (or such related party) were an issuer of equity securities referred to in such section.")
rule SpecifiedIndividualWouldBeSubject(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "an individual who would be subject if the taxpayer were an issuer is a specified individual (section 274(e)(2)(B)(ii)(II))";
    when recipient_would_be_subject_to_16a_if_taxpayer_were_issuer(p, y, item);
    then recipient_is_specified_individual(p, y, item);
}
pub relation expense_total_for_entertainment_item(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the total expenses for the goods, services and facilities of the item (section 274(e)(2),(9))";
}
pub relation expense_amount_treated_as_compensation_and_wages_reported(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the expenses treated by the taxpayer as compensation on its return and as wages for chapter 24 (section 274(e)(2)(A) as read by (B)(i))";
}
pub relation entertainment_expense_within_exception_274e2_specified(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "for a specified individual the exception of (e)(2)(A) covers only expenses not exceeding the amount reported as compensation and wages (section 274(e)(2)(B)(i))";
}
@source(IRC_S274_E, quote = "subparagraph (A) and paragraph (9) shall each be applied by substituting \"to the extent that the expenses do not exceed the amount of the expenses which\" for \"to the extent that the expenses\"")
rule Exception274e2SpecifiedIndividualLimitedToReportedAmount(p: Person, y: TaxableYear, item: Integer, total: Money, reported: Money) strict {
    label en official "the exception for a specified individual covers the lesser of the total and the amount reported as compensation and wages (section 274(e)(2)(B)(i))";
    when recipient_is_specified_individual(p, y, item);
    when expense_total_for_entertainment_item(p, y, item, total);
    when expense_amount_treated_as_compensation_and_wages_reported(p, y, item, reported);
    then entertainment_expense_within_exception_274e2_specified(p, y, item, min(total, reported));
}
rule Exception274e2SpecifiedIndividualFullyReported(p: Person, y: TaxableYear, item: Integer, total: Money, reported: Money) strict {
    label en official "where the reported amount covers the whole expense the exception applies to the item (section 274(e)(2)(B)(i))";
    when recipient_is_specified_individual(p, y, item);
    when expense_total_for_entertainment_item(p, y, item, total);
    when expense_amount_treated_as_compensation_and_wages_reported(p, y, item, reported);
    when total <= reported;
    then entertainment_exception_applies_274e(p, y, item);
}
pub relation expense_amount_includible_in_non_employee_recipient_income(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the expenses includible in the gross income of a recipient who is not an employee as compensation for services or as a prize or award under section 74 (section 274(e)(9))";
}
pub relation entertainment_expense_within_exception_274e9_specified(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "for a specified individual the exception of (e)(9) covers only expenses not exceeding the amount includible in the recipient's income (section 274(e)(2)(B)(i))";
}
@source(IRC_S274_E, quote = "subparagraph (A) and paragraph (9) shall each be applied by substituting")
rule Exception274e9SpecifiedIndividualLimitedToIncludibleAmount(p: Person, y: TaxableYear, item: Integer, total: Money, includible: Money) strict {
    label en official "the (e)(9) exception for a specified individual covers the lesser of the total and the includible amount (section 274(e)(2)(B)(i))";
    when recipient_is_specified_individual(p, y, item);
    when expense_total_for_entertainment_item(p, y, item, total);
    when expense_amount_includible_in_non_employee_recipient_income(p, y, item, includible);
    when not_known(information_return_required_but_amount_not_included(p, y, item));
    then entertainment_expense_within_exception_274e9_specified(p, y, item, min(total, includible));
}
rule Exception274e9SpecifiedIndividualFullyIncludible(p: Person, y: TaxableYear, item: Integer, total: Money, includible: Money) strict {
    label en official "where the includible amount covers the whole expense the (e)(9) exception applies to the item";
    when recipient_is_specified_individual(p, y, item);
    when expense_total_for_entertainment_item(p, y, item, total);
    when expense_amount_includible_in_non_employee_recipient_income(p, y, item, includible);
    when not_known(information_return_required_but_amount_not_included(p, y, item));
    when total <= includible;
    then entertainment_exception_applies_274e(p, y, item);
}

// --- (k)(2): exceptions to the food and beverage validity condition --------------------------------------------------------------------------------------

pub relation food_beverage_274k_exception_applies(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the expense is described in paragraph (2), (3), (4), (7), (8) or (9) of subsection (e), so subsection (k)(1) does not apply (section 274(k)(2)(A))";
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE2(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "an expense treated as compensation and wages is outside (k)(1) (section 274(k)(2)(A), (e)(2))";
    when expense_treated_as_compensation_and_wages(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE3(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a reimbursed expense is outside (k)(1) (section 274(k)(2)(A), (e)(3))";
    when reimbursed_expense_with_accounting_or_employer_untreated(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE4(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a recreational expense for employees is outside (k)(1) (section 274(k)(2)(A), (e)(4))";
    when recreational_expense_primarily_for_employees_not_highly_compensated(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE7(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "items available to the public are outside (k)(1) (section 274(k)(2)(A), (e)(7))";
    when goods_services_facilities_made_available_to_general_public(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE8(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "entertainment sold to customers is outside (k)(1) (section 274(k)(2)(A), (e)(8))";
    when entertainment_sold_to_customers_for_adequate_consideration(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "(A) any expense described in paragraph (2), (3), (4), (7), (8), or (9) of subsection (e), and")
rule Food274kExceptionE9(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "expenses includible in a non-employee's income are outside (k)(1) (section 274(k)(2)(A), (e)(9))";
    when expense_includible_in_income_of_non_employee_recipient(p, y, item);
    then food_beverage_274k_exception_applies(p, y, item);
}
@source(IRC_S274_K, quote = "Paragraph (1) shall not apply to")
rule FoodBeverageWithin274kExceptionAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a food or beverage expense within a (k)(2)(A) exception is not gated by the presence and lavishness conditions of (k)(1)";
    when food_or_beverage_expense(p, y, item, amount);
    when food_beverage_274k_exception_applies(p, y, item);
    then deduction_allowed(p, y, Section274Meals, amount);
}

// --- (f),(g): deductions outside section 274; facilities ---------------------------------------------------------------------------------------------------

pub relation deduction_allowable_without_regard_to_trade_or_business_connection(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the deduction is allowable to the taxpayer without regard to its connection with the trade or business (or income-producing activity) (section 274(f))";
}
pub relation taxpayer_is_not_an_individual_274f(p: Person) kind empirical {
    label en official "the taxpayer is not an individual (section 274(f) last sentence)";
}
pub relation section_274_does_not_apply_to_deduction(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 274 does not apply to the deduction (section 274(f))";
}
@source(IRC_S274_F, quote = "This section shall not apply to any deduction allowable to the taxpayer without regard to its connection with his trade or business")
rule Section274NotAppliedToNonBusinessDeduction(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "section 274 does not apply to a deduction allowable without regard to business connection; for a taxpayer that is not an individual the test is applied as if it were one (section 274(f))";
    when deduction_allowable_without_regard_to_trade_or_business_connection(p, y, item);
    then section_274_does_not_apply_to_deduction(p, y, item);
}
pub relation facility_portion_disallowed_under_274a(facility: Integer, portion: Money) kind empirical {
    label en official "the portion of a facility for which deductions are disallowed under subsection (a) (section 274(g))";
}
pub relation facility_portion_treated_as_personal_living_or_family_asset(facility: Integer, portion: Money) kind institutional {
    label en official "the disallowed portion is treated as an asset used for personal, living and family purposes, not as an asset used in the trade or business (section 274(g))";
}
@source(IRC_S274_G, quote = "such portion shall be treated as an asset which is used for personal, living, and family purposes (and not as an asset used in the trade or business)")
rule DisallowedFacilityPortionIsPersonalAsset(facility: Integer, portion: Money) strict {
    label en official "a facility portion disallowed by subsection (a) is a personal asset for the chapter (section 274(g))";
    when facility_portion_disallowed_under_274a(facility, portion);
    then facility_portion_treated_as_personal_living_or_family_asset(facility, portion);
}

// --- (h): conventions ------------------------------------------------------------------------------------------------------------------------------------------

pub relation deduction_of_person_for_expenses_allocable_to_meeting(p: Person, attendee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a deduction otherwise allowable under section 162 to a person, whether or not the person is the individual attending the convention, seminar or similar meeting (section 274(h)(4)(A))";
}
pub relation amount_paid_to_attendee_includible_in_attendee_gross_income(p: Person, attendee: Person, y: TaxableYear) kind empirical {
    label en official "the amount paid by the person to or on behalf of the attendee is includible in the gross income of the attendee (section 274(h)(4)(B))";
}
pub relation information_return_required_for_payment_to_attendee_not_included(p: Person, attendee: Person, y: TaxableYear) kind empirical {
    label en official "the amount is required to be included in an information return filed by the person under part III of subchapter A of chapter 61 and is not so included (section 274(h)(4)(B))";
}
pub relation subsection_274h_applies_to_person_deduction(p: Person, attendee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "subsection (h) applies to the person's deduction: to any person, not only the traveler, except for amounts includible in the traveler's income (section 274(h)(4))";
}
@source(IRC_S274_H, quote = "this subsection shall apply to deductions otherwise allowable under section 162 to any person, whether or not such person is the individual attending the convention, seminar, or similar meeting")
rule Subsection274hAppliesToAnyPerson(p: Person, attendee: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "subsection (h) applies to any person's section 162 deduction for the meeting, except an amount paid to the attendee and includible in the attendee's income unless required to be reported and not reported (section 274(h)(4))";
    when deduction_of_person_for_expenses_allocable_to_meeting(p, attendee, y, amount);
    unless subsection_274h_exception_includible_keyed(p, attendee, y, amount);
    then subsection_274h_applies_to_person_deduction(p, attendee, y, amount);
}
pub relation subsection_274h_exception_includible_keyed(p: Person, attendee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "helper: the includible-in-attendee-income exception keyed by the deduction";
}
rule Subsection274hIncludibleExceptionKeyed(p: Person, attendee: Person, y: TaxableYear, amount: Money) strict {
    label en official "an amount includible in the attendee's income (and not required-and-unreported on an information return) does not carry the denial to the payer (section 274(h)(4)(B))";
    when deduction_of_person_for_expenses_allocable_to_meeting(p, attendee, y, amount);
    when amount_paid_to_attendee_includible_in_attendee_gross_income(p, attendee, y);
    when not_known(information_return_required_for_payment_to_attendee_not_included(p, attendee, y));
    then subsection_274h_exception_includible_keyed(p, attendee, y, amount);
}
pub relation country_is_caribbean_basin_beneficiary_or_bermuda(country: Integer) kind empirical {
    label en official "the country is a beneficiary country within section 212(a)(1)(A) of the Caribbean Basin Economic Recovery Act, or Bermuda (section 274(h)(6)(B))";
}
pub relation exchange_of_information_agreement_in_effect_with_country(country: Integer, meeting: Integer) kind empirical {
    label en official "as of the time the meeting begins a bilateral or multilateral agreement described in subparagraph (C) providing for the exchange of information is in effect between the country and the United States (section 274(h)(6)(A)(i))";
}
pub relation secretary_finding_that_country_tax_laws_discriminate_in_effect(country: Integer, meeting: Integer) kind empirical {
    label en official "a finding by the Secretary that the tax laws of the country discriminate against conventions held in the United States is in effect (section 274(h)(6)(A)(ii))";
}
pub relation north_american_area_includes_beneficiary_country_for_meeting(country: Integer, meeting: Integer) kind institutional {
    label en official "for the convention, seminar or meeting the North American area includes the beneficiary country (section 274(h)(6)(A))";
}
@source(IRC_S274_H, quote = "the term \"North American area\" includes, with respect to any convention, seminar, or similar meeting, any beneficiary country if")
rule NorthAmericanAreaIncludesBeneficiaryCountry(country: Integer, meeting: Integer) strict {
    label en official "a beneficiary country with an information exchange agreement and no discrimination finding at the meeting start is in the North American area (section 274(h)(6)(A))";
    when country_is_caribbean_basin_beneficiary_or_bermuda(country);
    when exchange_of_information_agreement_in_effect_with_country(country, meeting);
    when not_known(secretary_finding_that_country_tax_laws_discriminate_in_effect(country, meeting));
    then north_american_area_includes_beneficiary_country_for_meeting(country, meeting);
}
pub relation secretary_determination_or_finding_under_274h6_made(kind_id: Integer) kind empirical {
    label en official "a determination by the Secretary under subparagraph (C)(ii), or a finding by the Secretary under subparagraph (A)(ii) (and any termination of it), has been made (section 274(h)(6)(E)(ii),(iii))";
}
pub relation secretary_274h6_determination_published_in_federal_register(kind_id: Integer) kind empirical {
    label en official "the determination or finding has been published in the Federal Register (section 274(h)(6)(E))";
}
rule S274h6PublicationDuty defeasible {
    for k: Integer;
    when secretary_determination_or_finding_under_274h6_made(k);
    then duty S274h6PublishInFederalRegister {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_274h6_determination_published_in_federal_register(k);
            window [-infinity, infinity];
        }
    };
}
pub relation expenses_allocable_to_convention_seminar_or_similar_meeting_for_212(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "expenses deductible only under section 212 that are allocable to a convention, seminar or similar meeting (section 274(h)(7))";
}
@source(IRC_S274_H, quote = "No deduction shall be allowed under section 212 for expenses allocable to a convention, seminar, or similar meeting.")
rule NoSection212DeductionForConventionExpenses(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "no section 212 deduction for expenses allocable to a convention, seminar or similar meeting (section 274(h)(7))";
    when expenses_allocable_to_convention_seminar_or_similar_meeting_for_212(p, y, amount);
    then not deduction_allowed(p, y, Section274CForeignTravel, amount);
}

// --- (i): qualified nonpersonal use vehicle --------------------------------------------------------------------------------------------------------------------

external judgment relation vehicle_by_nature_not_likely_used_more_than_de_minimis_for_personal_purposes(vehicle: Integer) {
    authority TaxCourt;
    label en official "by reason of its nature the vehicle is not likely to be used more than a de minimis amount for personal purposes (section 274(i))";
}
pub relation qualified_nonpersonal_use_vehicle(vehicle: Integer) kind institutional {
    label en official "a qualified nonpersonal use vehicle within section 274(i), for purposes of subsection (d)";
}
@source(IRC_S274_I, quote = "the term \"qualified nonpersonal use vehicle\" means any vehicle which, by reason of its nature, is not likely to be used more than a de minimis amount for personal purposes")
rule QualifiedNonpersonalUseVehicleDefinition(vehicle: Integer) strict {
    label en official "a vehicle by nature unlikely to be used more than de minimis for personal purposes is a qualified nonpersonal use vehicle (section 274(i)); the likelihood is a judgment (DECISION-0194)";
    when vehicle_by_nature_not_likely_used_more_than_de_minimis_for_personal_purposes(vehicle);
    then qualified_nonpersonal_use_vehicle(vehicle);
}

// --- (j)(3),(4): employee achievement awards ----------------------------------------------------------------------------------------------------------------------

pub relation item_is_tangible_personal_property_transferred_by_employer_to_employee(item: Integer) kind empirical {
    label en official "an item of tangible personal property transferred by an employer to an employee (section 274(j)(3)(A)(i))";
}
pub relation item_is_cash_gift_card_coupon_or_certificate_not_limited_array(item: Integer) kind empirical {
    label en official "cash, cash equivalents, gift cards, gift coupons or gift certificates (other than arrangements conferring only the right to select from a limited pre-approved array of items) (section 274(j)(3)(A)(ii)(I))";
}
pub relation item_is_vacation_meal_lodging_ticket_security_or_similar(item: Integer) kind empirical {
    label en official "vacations, meals, lodging, tickets to theater or sporting events, stocks, bonds, other securities and similar items (section 274(j)(3)(A)(ii)(II))";
}
pub relation item_awarded_for_length_of_service_achievement(item: Integer) kind empirical {
    label en official "the item is awarded for length of service achievement (section 274(j)(3)(A)(i)(I))";
}
pub relation item_awarded_for_safety_achievement(item: Integer) kind empirical {
    label en official "the item is awarded for safety achievement (section 274(j)(3)(A)(i)(I))";
}
pub relation item_awarded_as_part_of_meaningful_presentation(item: Integer) kind empirical {
    label en official "the item is awarded as part of a meaningful presentation (section 274(j)(3)(A)(i)(II))";
}
external judgment relation award_conditions_create_no_significant_likelihood_of_disguised_compensation(item: Integer) {
    authority TaxCourt;
    label en official "the award is made under conditions and circumstances that do not create a significant likelihood of the payment of disguised compensation (section 274(j)(3)(A)(i)(III))";
}
pub relation item_received_in_recipients_first_five_years_of_employment(item: Integer) kind empirical {
    label en official "the item is received during the recipient's 1st 5 years of employment (section 274(j)(4)(B))";
}
pub relation recipient_received_length_of_service_award_in_year_or_prior_four_years(item: Integer) kind empirical {
    label en official "the recipient received a length of service achievement award (other than one excludable under section 132(e)(1)) during that year or any of the prior 4 years (section 274(j)(4)(B))";
}
pub relation safety_awards_previously_made_to_over_ten_percent_of_employees_this_year(item: Integer) kind empirical {
    label en official "during the taxable year safety achievement awards (other than those excludable under section 132(e)(1)) have previously been awarded to more than 10 percent of the employer's employees (excluding managers, administrators, clerical and other professional employees) (section 274(j)(4)(C)(i))";
}
pub relation recipient_is_manager_administrator_clerical_or_professional_employee(item: Integer) kind empirical {
    label en official "the item is awarded to a manager, administrator, clerical employee or other professional employee (section 274(j)(4)(C)(ii))";
}
pub relation length_of_service_achievement_treatment_allowed(item: Integer) kind institutional {
    label en official "the item may be treated as provided for length of service achievement (section 274(j)(4)(B))";
}
@source(IRC_S274_J, quote = "An item shall not be treated as having been provided for length of service achievement if the item is received during the recipient's 1st 5 years of employment")
rule LengthOfServiceAchievementTreatment(item: Integer) strict {
    label en official "an item counts as length of service achievement unless received in the first 5 years or after a length of service award in the year or the prior 4 years (section 274(j)(4)(B))";
    when item_awarded_for_length_of_service_achievement(item);
    when not_known(item_received_in_recipients_first_five_years_of_employment(item));
    when not_known(recipient_received_length_of_service_award_in_year_or_prior_four_years(item));
    then length_of_service_achievement_treatment_allowed(item);
}
pub relation safety_achievement_treatment_allowed(item: Integer) kind institutional {
    label en official "the item may be treated as provided for safety achievement (section 274(j)(4)(C))";
}
@source(IRC_S274_J, quote = "An item provided by an employer to an employee shall not be treated as having been provided for safety achievement if")
rule SafetyAchievementTreatment(item: Integer) strict {
    label en official "an item counts as safety achievement unless more than 10 percent of employees already received such awards this year or it is awarded to a manager, administrator, clerical or professional employee (section 274(j)(4)(C))";
    when item_awarded_for_safety_achievement(item);
    when not_known(safety_awards_previously_made_to_over_ten_percent_of_employees_this_year(item));
    when not_known(recipient_is_manager_administrator_clerical_or_professional_employee(item));
    then safety_achievement_treatment_allowed(item);
}
pub relation employee_achievement_award(item: Integer) kind institutional {
    label en official "an employee achievement award within section 274(j)(3)(A)";
}
@source(IRC_S274_J, quote = "The term \"employee achievement award\" means an item of tangible personal property which is")
rule EmployeeAchievementAwardLengthOfService(item: Integer) defeasible {
    label en official "tangible personal property (not cash, gift cards, vacations, meals, tickets or securities) transferred for length of service achievement in a meaningful presentation without disguised compensation is an award (section 274(j)(3)(A))";
    when item_is_tangible_personal_property_transferred_by_employer_to_employee(item);
    when length_of_service_achievement_treatment_allowed(item);
    when item_awarded_as_part_of_meaningful_presentation(item);
    when award_conditions_create_no_significant_likelihood_of_disguised_compensation(item);
    when not_known(item_is_cash_gift_card_coupon_or_certificate_not_limited_array(item));
    when not_known(item_is_vacation_meal_lodging_ticket_security_or_similar(item));
    then employee_achievement_award(item);
}
@source(IRC_S274_J, quote = "The term \"employee achievement award\" means an item of tangible personal property which is")
rule EmployeeAchievementAwardSafety(item: Integer) defeasible {
    label en official "the same definition for safety achievement (section 274(j)(3)(A),(4)(C))";
    when item_is_tangible_personal_property_transferred_by_employer_to_employee(item);
    when safety_achievement_treatment_allowed(item);
    when item_awarded_as_part_of_meaningful_presentation(item);
    when award_conditions_create_no_significant_likelihood_of_disguised_compensation(item);
    when not_known(item_is_cash_gift_card_coupon_or_certificate_not_limited_array(item));
    when not_known(item_is_vacation_meal_lodging_ticket_security_or_similar(item));
    then employee_achievement_award(item);
}
pub relation award_under_established_written_nondiscriminatory_plan(item: Integer) kind empirical {
    label en official "the award is made as part of an established written plan or program of the taxpayer which does not discriminate in favor of highly compensated employees (section 414(q)) as to eligibility or benefits (section 274(j)(3)(B)(i))";
}
pub relation employer_qualified_plan_awards_total_and_count(employer: Person, y: TaxableYear, total: Money, count: Integer) kind empirical {
    label en official "the total cost, and the number, of the employee achievement awards provided by the employer during the year that would be qualified plan awards but for the average cost limit, excluding awards of nominal value (section 274(j)(3)(B)(ii))";
}
pub relation qualified_plan_average_cost_exceeds_400(employer: Person, y: TaxableYear) kind institutional {
    label en official "the average cost of the would-be qualified plan awards exceeds $400 (section 274(j)(3)(B)(ii))";
}
@source(IRC_S274_J, quote = "if the average cost of all employee achievement awards which are provided by the employer during the year, and which would be qualified plan awards but for this subparagraph, exceeds $400")
rule QualifiedPlanAverageCostExceeds400(employer: Person, y: TaxableYear, total: Money, count: Integer) strict {
    label en official "average cost above $400 tested as total > 400 x count (section 274(j)(3)(B)(ii))";
    when employer_qualified_plan_awards_total_and_count(employer, y, total, count);
    when count > 0;
    when total > 400.00 USD * count;
    then qualified_plan_average_cost_exceeds_400(employer, y);
}
pub relation award_of_employer_in_year(item: Integer, employer: Person, y: TaxableYear) kind empirical {
    label en official "the award is made by the employer in the taxable year";
}
pub relation qualified_plan_award(item: Integer) kind institutional {
    label en official "a qualified plan award within section 274(j)(3)(B)";
}
@source(IRC_S274_J, quote = "The term \"qualified plan award\" means an employee achievement award awarded as part of an established written plan or program of the taxpayer")
rule QualifiedPlanAwardDefinition(item: Integer, employer: Person, y: TaxableYear) defeasible {
    label en official "an employee achievement award under a written non-discriminatory plan is a qualified plan award unless the average cost of such awards exceeds $400 (section 274(j)(3)(B))";
    when employee_achievement_award(item);
    when award_under_established_written_nondiscriminatory_plan(item);
    when award_of_employer_in_year(item, employer, y);
    when not_known(qualified_plan_average_cost_exceeds_400(employer, y));
    then qualified_plan_award(item);
}
pub relation award_made_by_partnership_to_member_limits(p: Person, member: Person) kind empirical {
    label en official "the award is made by a partnership, and the person is a member (section 274(j)(4)(A))";
}
pub relation award_limits_apply_to(p: Person, subject: Person) kind institutional {
    label en official "the deduction limitations of paragraph (2) apply to the partnership as well as to each member (section 274(j)(4)(A))";
}
@source(IRC_S274_J, quote = "the deduction limitations contained in paragraph (2) shall apply to the partnership as well as to each member thereof")
rule PartnershipAwardLimitsApplyToPartnershipAndMembers(p: Person, member: Person) strict {
    label en official "the award limits apply to the partnership and each member (section 274(j)(4)(A))";
    when award_made_by_partnership_to_member_limits(p, member);
    then award_limits_apply_to(p, member);
}
