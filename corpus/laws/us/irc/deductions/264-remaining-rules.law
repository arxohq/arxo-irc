// Section 264 — life insurance, endowment and annuity contracts: paragraphs (a)(2)-(4)
// (interest on indebtedness to purchase or carry contracts), (b) exceptions to (a)(1),
// (c) single premium contracts, (d) exceptions to (a)(3), (e) the key person exception
// to (a)(4) and (f) the pro rata allocation of interest to unborrowed policy cash
// values. (a)(1) (premiums where the taxpayer is a beneficiary) is in
// `262-265-personal-and-capital.law`. Stage 2. Not modelled (TECH_GAPS G2782): the
// Moody's Corporate Bond Yield Average cap of (e)(2) (rates unpinned), the master
// contract, controlled group aggregation and partnership-level rules of (e)(5),
// (f)(4)(E),(f)(5)(b),(f)(8), the (f)(5)(A)(ii)-(iv) business beneficiary rule and the
// average-balance computation of policy cash values.

use self::{
    DeductionKind,
    IRC_S264_A,
    IRC_S264_C,
    IRC_S264_D,
    IRC_S264_E,
    IRC_S264_F,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation interest_on_debt_to_purchase_or_carry_contract(p: Person, y: TaxableYear, item: Integer, contract: Integer, amount: Money) kind empirical {
    label en official "an amount paid or accrued on indebtedness incurred or continued to purchase or carry a life insurance, endowment or annuity contract (section 264(a)(2),(3))";
}

// --- (c): contracts treated as single premium ----------------------------------------------------------

pub relation substantially_all_premiums_paid_within_four_years(contract: Integer) kind empirical {
    label en official "substantially all the premiums on the contract are paid within 4 years from the date it is purchased (section 264(c)(1))";
}
pub relation amount_deposited_with_insurer_for_future_premiums_after_1954(contract: Integer) kind empirical {
    label en official "an amount is deposited after March 1, 1954 with the insurer for payment of a substantial number of future premiums (section 264(c)(2))";
}
pub relation single_premium_contract(contract: Integer) kind empirical {
    label en official "the contract is a single premium life insurance, endowment or annuity contract (section 264(a)(2))";
}
pub relation contract_treated_as_single_premium(contract: Integer) kind institutional {
    label en official "the contract is a single premium contract or is treated as one under section 264(c)";
}
@source(IRC_S264_C, quote = "if substantially all the premiums on the contract are paid within a period of 4 years from the date on which the contract is purchased, or")
rule SinglePremiumByFourYearPayment(contract: Integer) strict {
    label en official "payment of substantially all premiums within 4 years (section 264(c)(1))";
    when substantially_all_premiums_paid_within_four_years(contract);
    then contract_treated_as_single_premium(contract);
}
@source(IRC_S264_C, quote = "if an amount is deposited after March 1, 1954, with the insurer for payment of a substantial number of future premiums on the contract.")
rule SinglePremiumByDeposit(contract: Integer) strict {
    label en official "a deposit for a substantial number of future premiums (section 264(c)(2))";
    when amount_deposited_with_insurer_for_future_premiums_after_1954(contract);
    then contract_treated_as_single_premium(contract);
}
@source(IRC_S264_A, quote = "Any amount paid or accrued on indebtedness incurred or continued to purchase or carry a single premium life insurance, endowment, or annuity contract.")
rule SinglePremiumContractStatus(contract: Integer) strict {
    label en official "a single premium contract is such by its own nature";
    when single_premium_contract(contract);
    then contract_treated_as_single_premium(contract);
}
pub relation annuity_contract_purchased_on(contract: Integer, on: Date) kind empirical {
    label en official "the date the contract was purchased (section 264(a) last paragraph: annuity contracts after March 1, 1954; (a)(3) contracts after August 6, 1963; (a)(4) contracts after June 20, 1986)";
}
pub relation contract_is_annuity(contract: Integer) kind empirical {
    label en official "the contract is an annuity contract (section 264(a)(2) applies to annuity contracts only if purchased after March 1, 1954)";
}
@source(IRC_S264_A, quote = "Any amount paid or accrued on indebtedness incurred or continued to purchase or carry a single premium life insurance, endowment, or annuity contract.")
rule SinglePremiumInterestDenied(p: Person, y: TaxableYear, item: Integer, contract: Integer, amount: Money) strict {
    label en official "no deduction for interest on indebtedness to purchase or carry a single premium contract (section 264(a)(2)); an annuity contract counts only if purchased after March 1, 1954, which the date rule below adds";
    when interest_on_debt_to_purchase_or_carry_contract(p, y, item, contract, amount);
    when contract_treated_as_single_premium(contract);
    when not_known(contract_is_annuity(contract));
    then not deduction_allowed(p, y, Section264LifeInsuranceInterest, amount);
}
@source(IRC_S264_A, quote = "Paragraph (2) shall apply in respect of annuity contracts only as to contracts purchased after March 1, 1954.")
rule SinglePremiumAnnuityInterestDenied(p: Person, y: TaxableYear, item: Integer, contract: Integer, amount: Money, purchased: Date) strict {
    label en official "for an annuity contract the denial applies only to contracts purchased after March 1, 1954";
    when interest_on_debt_to_purchase_or_carry_contract(p, y, item, contract, amount);
    when contract_treated_as_single_premium(contract);
    when contract_is_annuity(contract);
    when annuity_contract_purchased_on(contract, purchased);
    when purchased > @1954-03-01;
    then not deduction_allowed(p, y, Section264LifeInsuranceInterest, amount);
}

// --- (a)(3),(d): systematic borrowing plans ----------------------------------------------------------------

pub relation plan_contemplates_systematic_borrowing_of_cash_value_increases(contract: Integer) kind empirical {
    label en official "the contract was purchased pursuant to a plan that contemplates the systematic direct or indirect borrowing of part or all of the increases in cash value (section 264(a)(3))";
}
pub relation four_of_first_seven_annual_premiums_not_paid_by_borrowing(contract: Integer) kind empirical {
    label en official "no part of 4 of the annual premiums due during the 7-year period beginning with the first premium is paid under the plan by means of indebtedness (section 264(d)(1))";
}
pub relation borrowing_plan_interest_total_for_year(p: Person, y: TaxableYear, contract: Integer, amount: Money) kind empirical {
    label en official "the total of the amounts paid or accrued by the person during the year for which no deduction would be allowable by reason of (a)(3) without regard to (d)(2) (section 264(d)(2))";
}
pub relation borrowing_due_to_unforeseen_substantial_loss_of_income_or_increase_in_obligations(contract: Integer) kind empirical {
    label en official "the indebtedness was incurred because of an unforeseen substantial loss of income or unforeseen substantial increase in financial obligations (section 264(d)(3))";
}
pub relation borrowing_incurred_in_trade_or_business(contract: Integer) kind empirical {
    label en official "the indebtedness was incurred in connection with the person's trade or business (section 264(d)(4))";
}
pub relation exception_264d_applies(p: Person, y: TaxableYear, contract: Integer) kind institutional {
    label en official "one of the exceptions of section 264(d) takes the year's interest out of subsection (a)(3)";
}
@source(IRC_S264_D, quote = "if no part of 4 of the annual premiums due during the 7-year period")
rule Exception264dSevenYearFourPremiums(p: Person, y: TaxableYear, contract: Integer) strict {
    label en official "four of the first seven annual premiums paid without borrowing (section 264(d)(1))";
    when plan_contemplates_systematic_borrowing_of_cash_value_increases(contract);
    when four_of_first_seven_annual_premiums_not_paid_by_borrowing(contract);
    when borrowing_plan_interest_total_for_year(p, y, contract, _);
    then exception_264d_applies(p, y, contract);
}
@source(IRC_S264_D, quote = "does not exceed $100,")
rule Exception264dHundredDollars(p: Person, y: TaxableYear, contract: Integer, total: Money) strict {
    label en official "a total of $100 or less for the year (section 264(d)(2))";
    when plan_contemplates_systematic_borrowing_of_cash_value_increases(contract);
    when borrowing_plan_interest_total_for_year(p, y, contract, total);
    when total <= 100.00 USD;
    then exception_264d_applies(p, y, contract);
}
@source(IRC_S264_D, quote = "if such amount was paid or accrued on indebtedness incurred because of an unforeseen substantial loss of income or unforeseen substantial increase in his financial obligations, or")
rule Exception264dUnforeseenLoss(p: Person, y: TaxableYear, contract: Integer) strict {
    label en official "indebtedness incurred because of an unforeseen loss of income or increase in obligations (section 264(d)(3))";
    when plan_contemplates_systematic_borrowing_of_cash_value_increases(contract);
    when borrowing_due_to_unforeseen_substantial_loss_of_income_or_increase_in_obligations(contract);
    when borrowing_plan_interest_total_for_year(p, y, contract, _);
    then exception_264d_applies(p, y, contract);
}
@source(IRC_S264_D, quote = "if such indebtedness was incurred in connection with his trade or business.")
rule Exception264dTradeOrBusiness(p: Person, y: TaxableYear, contract: Integer) strict {
    label en official "indebtedness incurred in connection with a trade or business (section 264(d)(4))";
    when plan_contemplates_systematic_borrowing_of_cash_value_increases(contract);
    when borrowing_incurred_in_trade_or_business(contract);
    when borrowing_plan_interest_total_for_year(p, y, contract, _);
    then exception_264d_applies(p, y, contract);
}
@source(IRC_S264_A, quote = "pursuant to a plan of purchase which contemplates the systematic direct or indirect borrowing of part or all of the increases in the cash value of such contract")
rule SystematicBorrowingInterestDenied(p: Person, y: TaxableYear, item: Integer, contract: Integer, amount: Money, purchased: Date) strict {
    label en official "no deduction for interest on debt under a systematic borrowing plan for a contract purchased after August 6, 1963, unless a section 264(d) exception applies (section 264(a)(3))";
    when interest_on_debt_to_purchase_or_carry_contract(p, y, item, contract, amount);
    when plan_contemplates_systematic_borrowing_of_cash_value_increases(contract);
    when annuity_contract_purchased_on(contract, purchased);
    when purchased > @1963-08-06;
    when not_known(contract_treated_as_single_premium(contract));
    when not_known(exception_264d_applies(p, y, contract));
    then not deduction_allowed(p, y, Section264LifeInsuranceInterest, amount);
}

// --- (a)(4),(e): interest on indebtedness with respect to policies; key persons ----------------------

pub relation interest_on_indebtedness_with_respect_to_owned_policies(p: Person, y: TaxableYear, insured: Integer, interest: Money, indebtedness: Money) kind empirical {
    label en official "interest paid or accrued on indebtedness with respect to one or more life insurance policies owned by the taxpayer covering the life of an individual (or endowment or annuity contracts covering an individual), purchased after June 20, 1986, and the aggregate indebtedness with respect to the policies covering that individual (section 264(a)(4),(e)(1))";
}
pub relation insured_is_officer_or_twenty_percent_owner(p: Person, insured: Integer) kind institutional {
    label en official "the insured is an officer or a 20-percent owner of the taxpayer: for a corporation 20 percent or more of the stock or of the voting power, for others 20 percent or more of the capital or profits interest (section 264(e)(3),(4))";
}
pub relation number_of_key_persons_and_officers_employees(p: Person, key_persons: Integer, officers_and_employees: Integer) kind empirical {
    label en official "the number of individuals the taxpayer treats as key persons and its total number of officers and employees (section 264(e)(3))";
}
pub relation key_person_count_within_limit(p: Person) kind institutional {
    label en official "the number of key persons does not exceed the greater of 5 and the lesser of 5 percent of the officers and employees and 20 (section 264(e)(3))";
}
@source(IRC_S264_E, quote = "the number of individuals who may be treated as key persons with respect to any taxpayer shall not exceed the greater of—")
rule KeyPersonCountWithinLimitByFive(p: Person, k: Integer, total: Integer) strict {
    label en official "at most 5 key persons in any case";
    when number_of_key_persons_and_officers_employees(p, k, total);
    when k <= 5;
    then key_person_count_within_limit(p);
}
@source(IRC_S264_E, quote = "the number of individuals who may be treated as key persons with respect to any taxpayer shall not exceed the greater of—")
rule KeyPersonCountWithinLimitByPercent(p: Person, k: Integer, total: Integer) strict {
    label en official "at most the lesser of 5 percent of the officers and employees and 20 (k x 20 <= total, k <= 20)";
    when number_of_key_persons_and_officers_employees(p, k, total);
    when k <= 20;
    when k * 20 <= total;
    then key_person_count_within_limit(p);
}
pub relation key_person_interest_denied_above_fifty_thousand(p: Person, y: TaxableYear, insured: Integer, amount: Money) kind institutional {
    label en official "the interest attributable to indebtedness above $50,000 for a key person, or all interest for a non-key person, for which no deduction is allowed (section 264(a)(4),(e)(1))";
}
@source(IRC_S264_E, quote = "to the extent that the aggregate amount of such indebtedness with respect to policies and contracts covering such individual does not exceed $50,000.")
rule KeyPersonInterestAboveFiftyThousandDenied(p: Person, y: TaxableYear, insured: Integer, interest: Money, debt: Money) strict {
    label en official "for a key person the interest on indebtedness up to $50,000 is outside the denial; the share above it is denied in proportion, one rounding (section 264(e)(1))";
    when interest_on_indebtedness_with_respect_to_owned_policies(p, y, insured, interest, debt);
    when insured_is_officer_or_twenty_percent_owner(p, insured);
    when key_person_count_within_limit(p);
    when debt > 50000.00 USD;
    then key_person_interest_denied_above_fifty_thousand(p, y, insured, div_round(interest * ((debt - 50000.00 USD) / 1.00 USD), debt / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S264_A, quote = "Except as provided in subsection (e), any interest paid or accrued on any indebtedness with respect to 1 or more life insurance policies owned by the taxpayer")
rule NonKeyPersonInterestDenied(p: Person, y: TaxableYear, insured: Integer, interest: Money, debt: Money) strict {
    label en official "for an insured who is not a key person all the interest is denied (section 264(a)(4))";
    when interest_on_indebtedness_with_respect_to_owned_policies(p, y, insured, interest, debt);
    when not_known(insured_is_officer_or_twenty_percent_owner(p, insured));
    then key_person_interest_denied_above_fifty_thousand(p, y, insured, interest);
}
@source(IRC_S264_A, quote = "Except as provided in subsection (e), any interest paid or accrued on any indebtedness with respect to 1 or more life insurance policies owned by the taxpayer")
rule KeyPersonBeyondCountLimitInterestDenied(p: Person, y: TaxableYear, insured: Integer, interest: Money, debt: Money) strict {
    label en official "an insured beyond the key person count limit is not a key person: all the interest is denied";
    when interest_on_indebtedness_with_respect_to_owned_policies(p, y, insured, interest, debt);
    when insured_is_officer_or_twenty_percent_owner(p, insured);
    when not_known(key_person_count_within_limit(p));
    then key_person_interest_denied_above_fifty_thousand(p, y, insured, interest);
}
@source(IRC_S264_A, quote = "Except as provided in subsection (e), any interest paid or accrued on any indebtedness with respect to 1 or more life insurance policies owned by the taxpayer")
rule PolicyIndebtednessInterestNotDeductible(p: Person, y: TaxableYear, insured: Integer, amount: Money) strict {
    label en official "the denied interest is not an allowed deduction";
    when key_person_interest_denied_above_fifty_thousand(p, y, insured, amount);
    then not deduction_allowed(p, y, Section264PolicyIndebtedness, amount);
}

// --- (f): interest allocable to unborrowed policy cash values -------------------------------------------------

pub relation taxpayer_interest_expense_264f(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate interest deduction otherwise allowable, without regard to section 264(f) (section 264(f)(7)), reduced by interest already disallowed under (a) or section 265 (section 264(f)(6))";
}
pub relation average_unborrowed_policy_cash_values_of_pro_rata_contracts(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's average unborrowed policy cash values of life insurance policies and annuity and endowment contracts issued after June 8, 1997 (section 264(f)(2)(A)), excluding policies covering a 20-percent owner, officer, director or employee (section 264(f)(4))";
}
pub relation average_unborrowed_cash_values_and_adjusted_bases_of_all_assets(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the average unborrowed policy cash values of the policies and the average adjusted bases of the taxpayer's other assets (section 264(f)(2)(B))";
}
pub relation policy_or_contract_held_by_natural_person(p: Person) kind empirical {
    label en official "the policy or contract is held by a natural person, outside subsection (f) (section 264(f)(5)(A)(i))";
}
pub relation taxpayer_is_insurance_company_under_subchapter_l(p: Person) kind empirical {
    label en official "the taxpayer is an insurance company subject to tax under subchapter L (section 264(f)(8)(B))";
}
pub relation interest_allocable_to_unborrowed_policy_cash_values(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest expense allocable to unborrowed policy cash values: interest expense times the average unborrowed policy cash values over the average total of cash values and adjusted bases (section 264(f)(2))";
}
@source(IRC_S264_F, quote = "No deduction shall be allowed for that portion of the taxpayer's interest expense which is allocable to unborrowed policy cash values")
rule InterestAllocableToUnborrowedCashValues(p: Person, y: TaxableYear, interest: Money, cash: Money, total: Money) strict {
    label en official "the pro rata portion of interest expense is denied, with one rounding (section 264(f)(1),(2)); natural person holders and subchapter L companies are outside";
    when taxpayer_interest_expense_264f(p, y, interest);
    when average_unborrowed_policy_cash_values_of_pro_rata_contracts(p, y, cash);
    when average_unborrowed_cash_values_and_adjusted_bases_of_all_assets(p, y, total);
    when total > 0.00 USD;
    when not_known(policy_or_contract_held_by_natural_person(p));
    when not_known(taxpayer_is_insurance_company_under_subchapter_l(p));
    then interest_allocable_to_unborrowed_policy_cash_values(p, y, div_round(interest * (cash / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S264_F, quote = "No deduction shall be allowed for that portion of the taxpayer's interest expense which is allocable to unborrowed policy cash values")
rule ProRataInterestNotDeductible(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the allocable interest is not an allowed deduction";
    when interest_allocable_to_unborrowed_policy_cash_values(p, y, amount);
    then not deduction_allowed(p, y, Section264ProRataInterest, amount);
}
