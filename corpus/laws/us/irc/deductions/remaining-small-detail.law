// Sections 166, 178, 180, 190, 192, 193, 194A, 212, 243, 262, 263A — stage 2c small remaining detail (TECH_GAPS G2711, G2724,
// G2725, G2736, G2745, G2747, G2756-G2758, G2806): (166)(b),(e) the basis of the deduction and the debt evidenced by a
// security; (178)(b) options of the lessee; (180)(b),(c) land used in farming, the timely election and its revocation; (190)(b)
// barrier removal expenses; (192)(c)(3)-(5) the time of the contribution, the form, the denial under section 162(a);
// (193)(b) qualified tertiary injectant expenses and the hydrocarbon injectant; (194A)(b) the allocation over the years of a
// specified period; (212) the expenses of an individual for the production of income; (243)(b)(3)(B) the effect of the
// group election, (243)(c)(2) the 20-percent owned corporation; (262)(b) the first telephone line; (263A)(b)(2),(i)(2),(3).
//
// Stage 1 interface changes (recorded): `tertiary_injectant_expense`, `personal_living_or_family_expense` and
// `dividend_from_20_percent_owned_corporation` are now institutional (derived below, or still asserted by a case); the
// section 166 deduction carries a `not_known` guard for a debt evidenced by a security; the section 180 deduction a guard for
// a revoked election; the section 243(b)(3) qualifying dividend a guard for the distribution of (B)(ii); `DeductionKind`
// gained `Section212IncomeProduction`.
//
// JUDGMENT CALLS: (1) the time prescribed by law for filing the return, extensions included, is a date the case gives;
// (2) the proration of (194A)(b) is one equal portion over the years of the specified period, the regulations may prescribe
// another; (3) the standards of (190)(b)(2) are the external judgment of the Secretary already declared at stage 1;
// (4) amounts are rounded to cents HALF_UP.

// === §166(b),(e) ================================================================================================

use self::{
    ConservationPurposeKind,
    CooperativeIndebtednessPurpose,
    Corporation,
    DeductionKind,
    IRC_S166_B,
    IRC_S166_E,
    IRC_S178_B,
    IRC_S180_B,
    IRC_S180_C,
    IRC_S190_B,
    IRC_S192_C,
    IRC_S193_B,
    IRC_S194A_B,
    IRC_S212,
    IRC_S243_B,
    IRC_S243_C,
    IRC_S262_B,
    IRC_S263A_B,
    IRC_S263A_I,
    Person,
    SoilConservationPurpose175,
    TaxableYear,
    barrier_removal_expense_established_to_satisfaction_of_secretary,
    debt_wholly_worthless_within_year,
    deduction_allowed,
    dividend_from_20_percent_owned_corporation,
    makes_life_insurance_group_election,
    personal_living_or_family_expense,
    property_produced_by_taxpayer,
    tertiary_injectant_expense,
};

pub relation debt_adjusted_basis_1011_for_loss_166(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis provided in section 1011 for determining the loss from the sale or other disposition of the debt (section 166(b))";
}
pub relation bad_debt_deduction_basis_166b(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the basis for determining the amount of the bad debt deduction";
}
@source(IRC_S166_B, quote = "the basis for determining the amount of the deduction for any bad debt shall be the adjusted basis provided in section 1011 for determining the loss from the sale or other disposition of property")
rule BadDebtDeductionBasis(p: Person, y: TaxableYear, item: Integer, worthless: Money, amount: Money) strict {
    label en official "the section 1011 adjusted basis for loss";
    when debt_wholly_worthless_within_year(p, y, item, worthless);
    when debt_adjusted_basis_1011_for_loss_166(p, item, amount);
    then bad_debt_deduction_basis_166b(p, y, item, amount);
}
pub relation debt_evidenced_by_security_165g2c(p: Person, item: Integer) kind empirical {
    label en official "the debt is evidenced by a security as defined in section 165(g)(2)(C) (section 166(e))";
}
pub relation section_166_inapplicable_to_debt(p: Person, item: Integer) kind institutional {
    label en official "section 166 does not apply to the debt";
}
@source(IRC_S166_E, quote = "This section shall not apply to a debt which is evidenced by a security as defined in section 165(g)(2)(C).")
rule Section166NotApplicableToSecurityDebt(p: Person, item: Integer) strict {
    label en official "a debt evidenced by a security";
    when debt_evidenced_by_security_165g2c(p, item);
    then section_166_inapplicable_to_debt(p, item);
}

// === §178(b) ====================================================================================================

pub relation lease_remaining_term_months_including_lessee_options_178(p: Person, lease: Integer, months: Integer) kind empirical {
    label en official "the period of the term of the lease remaining on the date of acquisition, counting the periods of options exercisable by the lessee";
}
pub relation lease_lessee_option_period_months_178(p: Person, lease: Integer, months: Integer) kind empirical {
    label en official "the period for which the lease may subsequently be renewed, extended or continued pursuant to an option exercisable by the lessee";
}
pub relation lease_remaining_term_months_excluding_lessee_options_178b(p: Person, lease: Integer, months: Integer) kind institutional {
    label en official "the remaining term of the lease without the periods of options exercisable by the lessee";
}
@source(IRC_S178_B, quote = "there shall not be taken into account any period for which the lease may subsequently be renewed, extended, or continued pursuant to an option exercisable by the lessee")
rule LeaseRemainingTermWithoutLesseeOptions(p: Person, lease: Integer, total: Integer, options: Integer) strict {
    label en official "the option periods are not taken into account";
    when lease_remaining_term_months_including_lessee_options_178(p, lease, total);
    when lease_lessee_option_period_months_178(p, lease, options);
    then lease_remaining_term_months_excluding_lessee_options_178b(p, lease, max(0, total - options));
}

// === §180(b),(c) ================================================================================================

pub relation land_used_for_crops_or_livestock_180(land: Integer) kind empirical {
    label en official "the land is used by the taxpayer or his tenant for the production of crops, fruits or other agricultural products or for the sustenance of livestock (section 180(b))";
}
pub relation land_use_before_or_simultaneously_with_180_expenditure(land: Integer, p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the use is before or simultaneously with the expenditure";
}
pub relation land_used_in_farming_180b(land: Integer, p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "land used in farming for the expenditure (section 180(b))";
}
@source(IRC_S180_B, quote = "the term \"land used in farming\" means land used")
rule LandUsedInFarming180(land: Integer, p: Person, y: TaxableYear, item: Integer) strict {
    label en official "used for crops or livestock before or with the expenditure";
    when land_used_for_crops_or_livestock_180(land);
    when land_use_before_or_simultaneously_with_180_expenditure(land, p, y, item);
    then land_used_in_farming_180b(land, p, y, item);
}
pub relation fertilizer_election_made_on_180(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the date on which the election under section 180(a) is made";
}
pub relation return_due_date_with_extensions_180(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the time prescribed by law (including extensions) for filing the return for the taxable year (section 180(c))";
}
pub relation fertilizer_election_timely_180c(p: Person, y: TaxableYear) kind institutional {
    label en official "the election is made within the time prescribed for filing the return";
}
@source(IRC_S180_C, quote = "The election under subsection (a) for any taxable year shall be made within the time prescribed by law (including extensions thereof) for filing the return for such taxable year.")
rule FertilizerElectionTimely(p: Person, y: TaxableYear, made: Date, due: Date) strict {
    label en official "made not later than the due date";
    when fertilizer_election_made_on_180(p, y, made);
    when return_due_date_with_extensions_180(p, y, due);
    when made <= due;
    then fertilizer_election_timely_180c(p, y);
}
pub relation revokes_fertilizer_election_180(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes the section 180 election for the taxable year";
}
pub relation secretary_consents_to_revocation_180(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation";
}
pub relation fertilizer_election_revoked_180(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 180 election is revoked with the consent of the Secretary";
}
@source(IRC_S180_C, quote = "Such election may not be revoked except with the consent of the Secretary.")
rule FertilizerElectionRevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "revocable only with consent";
    when revokes_fertilizer_election_180(p, y);
    then power S180RevokeElection {
        holder p;
        over y;
        exercise revokes_fertilizer_election_180(p, y);
        valid_when secretary_consents_to_revocation_180(p, y);
        effect create(fertilizer_election_revoked_180(p, y));
        window [@1954-01-01, infinity);
    };
}

// === §190(b) ====================================================================================================

pub relation facility_owned_or_leased_for_trade_or_business_190(p: Person, facility: Integer) kind empirical {
    label en official "the facility or public transportation vehicle is owned or leased by the taxpayer for use in connection with his trade or business (section 190(b)(1))";
}
pub relation expenditure_for_facility_190(p: Person, y: TaxableYear, item: Integer, facility: Integer) kind empirical {
    label en official "the expenditure is for the facility or vehicle";
}
pub relation expenditure_purpose_accessible_to_handicapped_or_elderly_190(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the purpose is making the facility more accessible to, and usable by, handicapped and elderly individuals (section 190(b)(1))";
}
pub relation barrier_removal_expense_190b1(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "an architectural and transportation barrier removal expense";
}
@source(IRC_S190_B, quote = "means an expenditure for the purpose of making any facility or public transportation vehicle owned or leased by the taxpayer for use in connection with his trade or business more accessible to, and usable by, handicapped and elderly individuals")
rule BarrierRemovalExpenseDefined(p: Person, y: TaxableYear, item: Integer, facility: Integer) strict {
    label en official "the purpose and the facility";
    when expenditure_for_facility_190(p, y, item, facility);
    when facility_owned_or_leased_for_trade_or_business_190(p, facility);
    when expenditure_purpose_accessible_to_handicapped_or_elderly_190(p, y, item);
    then barrier_removal_expense_190b1(p, y, item);
}
pub relation qualified_barrier_removal_expense_190b2(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "a qualified architectural and transportation barrier removal expense";
}
@source(IRC_S190_B, quote = "with respect to which the taxpayer establishes, to the satisfaction of the Secretary, that the resulting removal of any such barrier meets the standards promulgated by the Secretary")
rule QualifiedBarrierRemovalExpenseDefined(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "the standards are established to the satisfaction of the Secretary";
    when barrier_removal_expense_190b1(p, y, item);
    when barrier_removal_expense_established_to_satisfaction_of_secretary(p, y, item);
    then qualified_barrier_removal_expense_190b2(p, y, item);
}

// === §192(c)(3)-(5) =============================================================================================

pub relation black_lung_contribution_on_account_of_year_192(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the payment is on account of the taxable year (section 192(c)(3))";
}
pub relation black_lung_contribution_paid_on_192(p: Person, item: Integer, on: Date) kind empirical {
    label en official "the date of the payment of the contribution";
}
pub relation return_due_date_with_extensions_192(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, extensions included (section 192(c)(3))";
}
pub relation black_lung_contribution_deemed_made_on_last_day_192c3(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the contribution is deemed made on the last day of the taxable year";
}
@source(IRC_S192_C, quote = "a taxpayer shall be deemed to have made a payment of a contribution on the last day of a taxable year if the payment is on account of that taxable year and is made not later than the time prescribed by law for filing the return")
rule ContributionDeemedMadeOnLastDay(p: Person, y: TaxableYear, item: Integer, paid: Date, due: Date) strict {
    label en official "on account of the year and paid by the due date";
    when black_lung_contribution_on_account_of_year_192(p, y, item);
    when black_lung_contribution_paid_on_192(p, item, paid);
    when return_due_date_with_extensions_192(p, y, due);
    when paid <= due;
    then black_lung_contribution_deemed_made_on_last_day_192c3(p, y, item);
}
pub relation contribution_to_501c21_trust_192(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a contribution to a trust described in section 501(c)(21)";
}
pub relation contribution_in_cash_or_permitted_investment_192(p: Person, item: Integer) kind empirical {
    label en official "the contribution is in cash or in items in which the trust may invest under section 501(c)(21)(A)(ii)(II) (section 192(c)(4))";
}
pub relation black_lung_contribution_not_deductible_192c4(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "no deduction under section 192(a) for a contribution other than in cash or permitted items";
}
@source(IRC_S192_C, quote = "No deduction shall be allowed under subsection (a) with respect to any contribution to a trust described in section 501(c)(21) other than a contribution in cash")
rule ContributionNotInCashNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "not in cash or a permitted investment";
    when contribution_to_501c21_trust_192(p, y, item, amount);
    when not_known(contribution_in_cash_or_permitted_investment_192(p, item));
    then black_lung_contribution_not_deductible_192c4(p, y, item, amount);
}
pub relation liability_taken_into_account_in_black_lung_deduction_192(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a liability taken into account in determining the deduction under section 192(a) of the taxpayer or a predecessor (section 192(c)(5))";
}
@source(IRC_S192_C, quote = "No deduction shall be allowed under section 162(a) with respect to any liability taken into account in determining the deduction under subsection (a) of this section of the taxpayer (or a predecessor).")
rule NoSection162DeductionForBlackLungLiability(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "no section 162(a) deduction for the liability";
    when liability_taken_into_account_in_black_lung_deduction_192(p, y, amount);
    then not deduction_allowed(p, y, Section162TradeOrBusiness, amount);
}

// === §193(b) ====================================================================================================

pub relation tertiary_injectant_cost_193(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a cost paid or incurred, whether or not chargeable to capital account, for a tertiary injectant (section 193(b)(1))";
}
pub relation injectant_used_as_part_of_tertiary_recovery_method_193(item: Integer) kind empirical {
    label en official "the injectant is used as a part of a tertiary recovery method";
}
pub relation injectant_is_natural_gas_or_crude_oil_193b2(item: Integer) kind empirical {
    label en official "the injectant is natural gas or crude oil";
}
pub relation injectant_comprised_of_more_than_insignificant_natural_gas_or_crude_oil_193b2(item: Integer) kind empirical {
    label en official "the injectant is comprised of more than an insignificant amount of natural gas or crude oil";
}
pub relation injectant_is_recoverable_193(item: Integer) kind empirical {
    label en official "the hydrocarbon injectant is recoverable";
}
pub relation hydrocarbon_injectant_193b2(item: Integer) kind institutional {
    label en official "a hydrocarbon injectant";
}
@source(IRC_S193_B, quote = "The term \"hydrocarbon injectant\" includes natural gas, crude oil")
rule HydrocarbonInjectantNaturalGasOrCrudeOil(item: Integer) strict {
    label en official "natural gas or crude oil";
    when injectant_is_natural_gas_or_crude_oil_193b2(item);
    then hydrocarbon_injectant_193b2(item);
}
@source(IRC_S193_B, quote = "any other injectant which is comprised of more than an insignificant amount of natural gas or crude oil")
rule HydrocarbonInjectantMoreThanInsignificant(item: Integer) strict {
    label en official "more than an insignificant amount";
    when injectant_comprised_of_more_than_insignificant_natural_gas_or_crude_oil_193b2(item);
    then hydrocarbon_injectant_193b2(item);
}
pub relation injectant_total_cost_193(item: Integer, amount: Money) kind empirical {
    label en official "the cost of the injectant";
}
pub relation injectant_hydrocarbon_portion_cost_193(item: Integer, amount: Money) kind empirical {
    label en official "the cost of the portion of the injectant that is a hydrocarbon";
}
pub relation injectant_portion_not_treated_as_hydrocarbon_injectant_193b2(item: Integer, amount: Money) kind institutional {
    label en official "that portion of a hydrocarbon injectant which is not a hydrocarbon is not treated as a hydrocarbon injectant";
}
@source(IRC_S193_B, quote = "that portion of a hydrocarbon injectant which is not a hydrocarbon shall not be treated as a hydrocarbon injectant")
rule NonHydrocarbonPortionNotHydrocarbonInjectant(item: Integer, total: Money, hydrocarbon: Money) strict {
    label en official "the portion that is not a hydrocarbon";
    when hydrocarbon_injectant_193b2(item);
    when injectant_total_cost_193(item, total);
    when injectant_hydrocarbon_portion_cost_193(item, hydrocarbon);
    then injectant_portion_not_treated_as_hydrocarbon_injectant_193b2(item, max(0.00 USD, total - hydrocarbon));
}
pub relation recoverable_hydrocarbon_injectant_excluded_193b1(item: Integer) kind institutional {
    label en official "a hydrocarbon injectant which is recoverable is excluded";
}
@source(IRC_S193_B, quote = "(other than a hydrocarbon injectant which is recoverable)")
rule RecoverableHydrocarbonInjectantExcluded(item: Integer) strict {
    label en official "a recoverable hydrocarbon injectant";
    when hydrocarbon_injectant_193b2(item);
    when injectant_is_recoverable_193(item);
    then recoverable_hydrocarbon_injectant_excluded_193b1(item);
}
@source(IRC_S193_B, quote = "means any cost paid or incurred (whether or not chargeable to capital account) for any tertiary injectant")
rule QualifiedTertiaryInjectantExpense(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a cost for a tertiary injectant used in a tertiary recovery method, not a recoverable hydrocarbon injectant";
    when tertiary_injectant_cost_193(p, y, item, amount);
    when injectant_used_as_part_of_tertiary_recovery_method_193(item);
    when not_known(recoverable_hydrocarbon_injectant_excluded_193b1(item));
    then tertiary_injectant_expense(p, y, item, amount);
}

// === §194A(b) ===================================================================================================

pub relation withdrawal_fund_contribution_item_194A(p: Person, item: Integer, amount: Money) kind empirical {
    label en official "a contribution relating to a specified period of time (section 194A(b))";
}
pub relation withdrawal_fund_contribution_year_of_period_194A(p: Person, item: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is one of the taxable years of the specified period";
}
pub relation withdrawal_fund_contribution_years_in_period_194A(p: Person, item: Integer, years: Integer) kind institutional {
    label en official "the number of taxable years in the specified period";
}
@source(IRC_S194A_B, quote = "which relates to any specified period of time which includes more than one taxable year")
rule WithdrawalFundContributionYearsInPeriod(p: Person, item: Integer, amount: Money) strict {
    label en official "the taxable years of the period";
    when withdrawal_fund_contribution_item_194A(p, item, amount);
    then withdrawal_fund_contribution_years_in_period_194A(p, item, count(collect y: TaxableYear where withdrawal_fund_contribution_year_of_period_194A(p, item, y)));
}
pub relation withdrawal_fund_contribution_allocated_to_year_194Ab(p: Person, item: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount properly allocable to the taxable year of the period";
}
@source(IRC_S194A_B, quote = "the amount properly allocable to any taxable year in such period shall be determined by prorating such amounts to such taxable years")
rule WithdrawalFundContributionProrated(p: Person, item: Integer, y: TaxableYear, amount: Money, years: Integer) strict {
    label en official "one equal portion for each taxable year of the period";
    when withdrawal_fund_contribution_item_194A(p, item, amount);
    when withdrawal_fund_contribution_year_of_period_194A(p, item, y);
    when withdrawal_fund_contribution_years_in_period_194A(p, item, years);
    when years > 1;
    then withdrawal_fund_contribution_allocated_to_year_194Ab(p, item, y, div_round(amount, years * 1.0, 2, "HALF_UP"));
}

// === §212 =======================================================================================================

pub relation taxpayer_is_individual_212(p: Person) kind empirical {
    label en official "the taxpayer is an individual (section 212)";
}
pub relation ordinary_and_necessary_expense_paid_or_incurred_212(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an ordinary and necessary expense paid or incurred during the taxable year (section 212)";
}
pub enum IncomeProductionPurpose212 {
    ProductionOrCollectionOfIncome;
    ManagementConservationOrMaintenanceOfIncomeProperty;
    DeterminationCollectionOrRefundOfTax;
    OtherPurpose;
}
pub relation expense_purpose_212(p: Person, y: TaxableYear, item: Integer, purpose: IncomeProductionPurpose212) kind empirical {
    label en official "the purpose of the expense (section 212(1)-(3))";
}
@source(IRC_S212, quote = "In the case of an individual, there shall be allowed as a deduction all the ordinary and necessary expenses paid or incurred during the taxable year")
rule IncomeProductionExpenseDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money, purpose: IncomeProductionPurpose212) defeasible {
    label en official "an individual's ordinary and necessary expense for the production of income, the management of income property or a tax matter";
    when taxpayer_is_individual_212(p);
    when ordinary_and_necessary_expense_paid_or_incurred_212(p, y, item, amount);
    when expense_purpose_212(p, y, item, purpose);
    when purpose != OtherPurpose;
    then deduction_allowed(p, y, Section212IncomeProduction, amount);
}

// === §243(b)(3)(B),(c)(2) =======================================================================================

pub relation controlled_group_rules_apply_without_1563a4_and_b2d_243b3(c: Corporation, y: TaxableYear) kind institutional {
    label en official "part II of subchapter B of chapter 6 is applied to the members of the group without regard to sections 1563(a)(4) and 1563(b)(2)(D)";
}
@source(IRC_S243_B, quote = "part II of subchapter B of chapter 6 (relating to certain controlled corporations) shall be applied with respect to the members of such group without regard to sections 1563(a)(4) and 1563(b)(2)(D)")
rule ControlledGroupRulesWithoutGroupElectionExclusions(c: Corporation, y: TaxableYear) strict {
    label en official "the election is in effect";
    when makes_life_insurance_group_election(c, y);
    then controlled_group_rules_apply_without_1563a4_and_b2d_243b3(c, y);
}
pub relation distribution_by_member_subject_to_tax_under_801_243b3(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the distribution by a member of the group is subject to tax under section 801";
}
pub relation distribution_out_of_earnings_of_year_without_group_election_243b3(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the distribution is out of earnings and profits for a taxable year for which the election is not effective";
}
pub relation distributing_corporation_not_component_member_solely_by_1563b2D_243b3(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "for that year the distributing corporation was not a component member of a controlled group solely by reason of section 1563(b)(2)(D)";
}
pub relation distribution_not_qualifying_dividend_243b3bii(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the distribution is not treated as a qualifying dividend under section 243(b)(3)(B)(ii)";
}
@source(IRC_S243_B, quote = "a distribution by any member of such group which is subject to tax under section 801 shall not be treated as a qualifying dividend if such distribution is out of earnings and profits for a taxable year for which an election under this paragraph is not effective")
rule DistributionNotQualifyingDividendUnderGroupElection(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "section 801 distribution out of earnings of a year without the election";
    when makes_life_insurance_group_election(c, y);
    when distribution_by_member_subject_to_tax_under_801_243b3(c, y, item);
    when distribution_out_of_earnings_of_year_without_group_election_243b3(c, y, item);
    when distributing_corporation_not_component_member_solely_by_1563b2D_243b3(c, y, item);
    then distribution_not_qualifying_dividend_243b3bii(c, y, item);
}
pub relation dividend_payor_243(c: Corporation, y: TaxableYear, item: Integer, payor: Corporation) kind empirical {
    label en official "the corporation that pays the dividend";
}
pub relation stock_vote_percentage_owned_without_1504a4_243c2(c: Corporation, payor: Corporation, pct: Decimal) kind empirical {
    label en official "the percentage of the stock of the payor, by vote, owned by the taxpayer, stock described in section 1504(a)(4) not taken into account";
}
pub relation stock_value_percentage_owned_without_1504a4_243c2(c: Corporation, payor: Corporation, pct: Decimal) kind empirical {
    label en official "the percentage of the stock of the payor, by value, owned by the taxpayer, stock described in section 1504(a)(4) not taken into account";
}
@source(IRC_S243_C, quote = "the term \"20-percent owned corporation\" means any corporation if 20 percent or more of the stock of such corporation (by vote and value) is owned by the taxpayer")
rule DividendFromTwentyPercentOwnedCorporation(c: Corporation, y: TaxableYear, item: Integer, payor: Corporation, vote: Decimal, value: Decimal) strict {
    label en official "20 percent or more by vote and by value";
    when dividend_payor_243(c, y, item, payor);
    when stock_vote_percentage_owned_without_1504a4_243c2(c, payor, vote);
    when stock_value_percentage_owned_without_1504a4_243c2(c, payor, value);
    when vote >= 20.0;
    when value >= 20.0;
    then dividend_from_20_percent_owned_corporation(c, y, item);
}

// === §262(b) ====================================================================================================

pub relation basic_local_telephone_charge_first_line_262b(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a charge (including taxes) for basic local telephone service for the first telephone line provided to a residence of the taxpayer (section 262(b))";
}
pub relation taxpayer_is_individual_262b(p: Person) kind empirical {
    label en official "the taxpayer is an individual (section 262(b))";
}
@source(IRC_S262_B, quote = "any charge (including taxes thereon) for basic local telephone service with respect to the 1st telephone line provided to any residence of the taxpayer shall be treated as a personal expense")
rule FirstTelephoneLineIsPersonalExpense(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the first line to a residence is a personal expense";
    when taxpayer_is_individual_262b(p);
    when basic_local_telephone_charge_first_line_262b(p, y, item, amount);
    then personal_living_or_family_expense(p, y, item, amount);
}

// === §263A(b)(2),(i)(2),(3) =====================================================================================

pub relation produced_property_is_film_sound_recording_video_tape_book_or_similar_263a(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the property is a film, sound recording, video tape, book or similar property (section 263A(b)(2))";
}
pub relation produced_property_is_tangible_personal_property_263a(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the produced property is tangible personal property for section 263A(b)(1)";
}
@source(IRC_S263A_B, quote = "the term \"tangible personal property\" shall include a film, sound recording, video tape, book, or similar property")
rule FilmAndSimilarPropertyIsTangiblePersonalProperty(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "a film, sound recording, video tape, book or similar property";
    when property_produced_by_taxpayer(p, y, item);
    when produced_property_is_film_sound_recording_video_tape_book_or_similar_263a(p, y, item);
    then produced_property_is_tangible_personal_property_263a(p, y, item);
}
pub relation taxpayer_is_corporation_or_partnership_263a(p: Person) kind empirical {
    label en official "the taxpayer is a corporation or a partnership";
}
pub relation trade_or_business_of_taxpayer_263a(p: Person, business: Integer) kind empirical {
    label en official "a trade or business of the taxpayer";
}
pub relation trade_or_business_treated_as_corporation_or_partnership_for_gross_receipts_test_263Ai2(p: Person, business: Integer) kind institutional {
    label en official "the gross receipts test of section 448(c) is applied as if each trade or business were a corporation or partnership";
}
@source(IRC_S263A_I, quote = "the gross receipts test of section 448(c) shall be applied in the same manner as if each trade or business of such taxpayer were a corporation or partnership")
rule GrossReceiptsTestPerTradeOrBusiness(p: Person, business: Integer) strict {
    label en official "a taxpayer that is not a corporation or a partnership";
    when trade_or_business_of_taxpayer_263a(p, business);
    when not_known(taxpayer_is_corporation_or_partnership_263a(p));
    then trade_or_business_treated_as_corporation_or_partnership_for_gross_receipts_test_263Ai2(p, business);
}
pub relation accounting_method_change_made_pursuant_to_263Ai(p: Person, y: TaxableYear) kind empirical {
    label en official "a change in method of accounting is made pursuant to section 263A(i)";
}
pub relation method_change_treated_as_initiated_with_consent_under_481_263Ai3(p: Person, y: TaxableYear) kind institutional {
    label en official "for section 481 the change is initiated by the taxpayer and made with the consent of the Secretary";
}
@source(IRC_S263A_I, quote = "shall be treated for purposes of section 481 as initiated by the taxpayer and made with the consent of the Secretary")
rule MethodChangeTreatedAsInitiatedWithConsent(p: Person, y: TaxableYear) strict {
    label en official "a change made pursuant to the exemption";
    when accounting_method_change_made_pursuant_to_263Ai(p, y);
    then method_change_treated_as_initiated_with_consent_under_481_263Ai3(p, y);
}
