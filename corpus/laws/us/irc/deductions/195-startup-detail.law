// Section 195 — start-up expenditures: stage 2b detail (TECH_GAPS G2805): (c)(1) the definition,
// (c)(2) the beginning of the business, (d) the time and scope of the election, (b)(2) dispositions and
// (b)(3) the 2010 amounts. The stage 1 `start_up_expenditure` is now institutional (derived here from
// the purpose of the amount or asserted by a case); the stage 1 election power reads
// `start_up_election_valid`, and the stage 1 year-one and amortization rules are guarded against a
// business beginning in 2010, which the rules below handle with the $10,000/$60,000 amounts. Not
// modelled: the Secretary's regulations on when a business begins ((c)(2)(A)); the month fraction of
// the 180-month period stays a case fact.

// --- (c)(1): start-up expenditure ------------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S195_B,
    IRC_S195_C,
    IRC_S195_D,
    Person,
    TaxableYear,
    active_trade_or_business_begins_in_year,
    deduction_allowed,
    elects_to_deduct_start_up_expenditures,
    start_up_amortization_month_fraction_for_year,
    start_up_deduction_election_in_effect,
    start_up_expenditure,
    start_up_expenditures_aggregate,
    taxable_year_begins_on,
};

enum StartUpPurpose {
    InvestigatingCreationOrAcquisition;
    CreatingActiveTradeOrBusiness;
    PreOpeningForProfitActivity;
}
pub relation expenditure_for_start_up_purpose(p: Person, y: TaxableYear, activity: Integer, item: Integer, purpose: StartUpPurpose, amount: Money) kind empirical {
    label en official "an amount paid or incurred in connection with investigating the creation or acquisition of an active trade or business, creating one, or an activity engaged in for profit before the business begins in anticipation of it becoming an active trade or business (section 195(c)(1)(A))";
}
pub relation would_be_deductible_if_paid_in_operation_of_existing_business_in_same_field(item: Integer) kind empirical {
    label en official "the amount, if paid in connection with the operation of an existing active trade or business in the same field, would be allowable as a deduction for the year paid or incurred (section 195(c)(1)(B))";
}
pub relation deduction_allowable_under_163a_164_or_174_for_item(item: Integer) kind empirical {
    label en official "a deduction is allowable for the amount under section 163(a), 164 or 174 (section 195(c)(1) last sentence)";
}
@source(IRC_S195_C, quote = "investigating the creation or acquisition of an active trade or business")
rule StartUpExpenditureInvestigating(p: Person, y: TaxableYear, activity: Integer, item: Integer, amount: Money) defeasible {
    label en official "an amount for investigating the creation or acquisition of a business is a start-up expenditure if it would be deductible in an existing business and not under 163(a), 164 or 174 (section 195(c)(1))";
    when expenditure_for_start_up_purpose(p, y, activity, item, InvestigatingCreationOrAcquisition, amount);
    when would_be_deductible_if_paid_in_operation_of_existing_business_in_same_field(item);
    when not_known(deduction_allowable_under_163a_164_or_174_for_item(item));
    then start_up_expenditure(p, y, activity, item, amount);
}
@source(IRC_S195_C, quote = "(ii) creating an active trade or business, or")
rule StartUpExpenditureCreating(p: Person, y: TaxableYear, activity: Integer, item: Integer, amount: Money) defeasible {
    label en official "an amount for creating an active trade or business is a start-up expenditure on the same conditions (section 195(c)(1))";
    when expenditure_for_start_up_purpose(p, y, activity, item, CreatingActiveTradeOrBusiness, amount);
    when would_be_deductible_if_paid_in_operation_of_existing_business_in_same_field(item);
    when not_known(deduction_allowable_under_163a_164_or_174_for_item(item));
    then start_up_expenditure(p, y, activity, item, amount);
}
@source(IRC_S195_C, quote = "any activity engaged in for profit and for the production of income before the day on which the active trade or business begins, in anticipation of such activity becoming an active trade or business")
rule StartUpExpenditurePreOpeningActivity(p: Person, y: TaxableYear, activity: Integer, item: Integer, amount: Money) defeasible {
    label en official "an amount for a pre-opening for-profit activity in anticipation of a business is a start-up expenditure on the same conditions (section 195(c)(1))";
    when expenditure_for_start_up_purpose(p, y, activity, item, PreOpeningForProfitActivity, amount);
    when would_be_deductible_if_paid_in_operation_of_existing_business_in_same_field(item);
    when not_known(deduction_allowable_under_163a_164_or_174_for_item(item));
    then start_up_expenditure(p, y, activity, item, amount);
}

// --- (c)(2): beginning of the business ---------------------------------------------------------------------------------------------------------------

pub relation active_trade_or_business_acquired_on(p: Person, activity: Integer, on: Date) kind empirical {
    label en official "the date the taxpayer acquires an active trade or business (section 195(c)(2)(B))";
}
pub relation active_trade_or_business_begins_on(p: Person, activity: Integer, on: Date) kind institutional {
    label en official "the date the active trade or business is treated as beginning: an acquired business begins when acquired (section 195(c)(2)(B)); otherwise as the Secretary's regulations provide (section 195(c)(2)(A))";
}
@source(IRC_S195_C, quote = "An acquired active trade or business shall be treated as beginning when the taxpayer acquires it.")
rule AcquiredBusinessBeginsWhenAcquired(p: Person, activity: Integer, acquired: Date) strict {
    label en official "an acquired business begins on the acquisition date (section 195(c)(2)(B))";
    when active_trade_or_business_acquired_on(p, activity, acquired);
    then active_trade_or_business_begins_on(p, activity, acquired);
}
pub relation business_begins_on_by_regulations(p: Person, activity: Integer, on: Date) kind empirical {
    label en official "the date the active trade or business begins, determined in accordance with the Secretary's regulations (section 195(c)(2)(A))";
}
@source(IRC_S195_C, quote = "the determination of when an active trade or business begins shall be made in accordance with such regulations as the Secretary may prescribe")
rule NonAcquiredBusinessBeginsByRegulations(p: Person, activity: Integer, begins: Date) defeasible {
    label en official "a business not acquired begins as the regulations provide (a fact of the case) (section 195(c)(2)(A))";
    when business_begins_on_by_regulations(p, activity, begins);
    when not_known(active_trade_or_business_acquired_on_any(p, activity));
    then active_trade_or_business_begins_on(p, activity, begins);
}
pub relation active_trade_or_business_acquired_on_any(p: Person, activity: Integer) kind institutional {
    label en official "helper: the business was acquired";
}
rule AcquiredAnyHelper(p: Person, activity: Integer, on: Date) strict {
    label en official "helper for the acquired-business exception";
    when active_trade_or_business_acquired_on(p, activity, on);
    then active_trade_or_business_acquired_on_any(p, activity);
}

// --- (d): time and scope of the election -----------------------------------------------------------------------------------------------------------------

pub relation start_up_election_made_on(p: Person, activity: Integer, on: Date) kind empirical {
    label en official "the date the section 195(b) election is made (section 195(d)(1))";
}
pub relation return_due_date_including_extensions_for_year_business_begins(p: Person, activity: Integer, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year in which the trade or business begins, including extensions (section 195(d)(1))";
}
pub relation start_up_election_late(p: Person, activity: Integer) kind institutional {
    label en official "the election is made after the time prescribed for filing the return for the year the business begins";
}
@source(IRC_S195_D, quote = "An election under subsection (b) shall be made not later than the time prescribed by law for filing the return for the taxable year in which the trade or business begins (including extensions thereof).")
rule StartUpElectionLate(p: Person, activity: Integer, made: Date, due: Date) strict {
    label en official "an election after the return due date (with extensions) is late (section 195(d)(1))";
    when start_up_election_made_on(p, activity, made);
    when return_due_date_including_extensions_for_year_business_begins(p, activity, due);
    when made > due;
    then start_up_election_late(p, activity);
}
pub relation start_up_election_valid(p: Person, activity: Integer) kind institutional {
    label en official "the section 195(b) election is timely, so the election power takes effect";
}
@source(IRC_S195_D, quote = "An election under subsection (b) shall be made not later than the time prescribed by law")
rule StartUpElectionValidWhenNotLate(p: Person, activity: Integer) defeasible {
    label en official "an election not shown to be late is valid (section 195(d)(1)); a late election has no effect";
    when elects_to_deduct_start_up_expenditures(p, activity);
    when not_known(start_up_election_late(p, activity));
    then start_up_election_valid(p, activity);
}
pub relation taxable_year_at_or_after_election_year(p: Person, activity: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year is the year for which the election is made or a subsequent taxable year (section 195(d)(2))";
}
pub relation start_up_period_must_be_adhered_to(p: Person, activity: Integer, y: TaxableYear) kind institutional {
    label en official "the period selected under subsection (b) must be adhered to in computing taxable income for the year (section 195(d)(2))";
}
@source(IRC_S195_D, quote = "The period selected under subsection (b) shall be adhered to in computing taxable income for the taxable year for which the election is made and all subsequent taxable years.")
rule StartUpPeriodAdheredToInSubsequentYears(p: Person, activity: Integer, y: TaxableYear) strict {
    label en official "the election year and every later year use the period selected (section 195(d)(2))";
    when start_up_deduction_election_in_effect(p, activity);
    when taxable_year_at_or_after_election_year(p, activity, y);
    then start_up_period_must_be_adhered_to(p, activity, y);
}

// --- (b)(2): dispositions --------------------------------------------------------------------------------------------------------------------------------

pub relation trade_or_business_completely_disposed_of_before_period_ends(p: Person, activity: Integer) kind empirical {
    label en official "the trade or business is completely disposed of by the taxpayer before the end of the amortization period (section 195(b)(2))";
}
pub relation deferred_start_up_expenses_not_yet_deducted(p: Person, activity: Integer, amount: Money) kind empirical {
    label en official "the deferred expenses attributable to the business which were not allowed as a deduction by reason of section 195 (section 195(b)(2))";
}
pub relation deferred_start_up_expenses_deductible_to_extent_allowable_under_165(p: Person, activity: Integer, amount: Money) kind institutional {
    label en official "the deferred expenses may be deducted to the extent allowable under section 165 (section 195(b)(2))";
}
@source(IRC_S195_B, quote = "any deferred expenses attributable to such trade or business which were not allowed as a deduction by reason of this section may be deducted to the extent allowable under section 165")
rule DeferredExpensesDeductibleOnCompleteDisposition(p: Person, activity: Integer, amount: Money) strict {
    label en official "on complete disposition before the period ends the deferred expenses are deductible to the extent section 165 allows (section 195(b)(2)); the section 165 limit is applied by that section";
    when trade_or_business_completely_disposed_of_before_period_ends(p, activity);
    when deferred_start_up_expenses_not_yet_deducted(p, activity, amount);
    then deferred_start_up_expenses_deductible_to_extent_allowable_under_165(p, activity, amount);
}

// --- (b)(3): taxable years beginning in 2010 --------------------------------------------------------------------------------------------------------------

pub relation start_up_business_begins_in_2010(p: Person, activity: Integer) kind institutional {
    label en official "the active trade or business begins in a taxable year beginning in 2010 (section 195(b)(3))";
}
@source(IRC_S195_B, quote = "In the case of a taxable year beginning in 2010, paragraph (1)(A)(ii) shall be applied")
rule BusinessBeginsInTaxableYearBeginningIn2010(p: Person, activity: Integer, y: TaxableYear, begins: Date) strict {
    label en official "the year in which the business begins is a taxable year beginning in 2010";
    when active_trade_or_business_begins_in_year(p, activity, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2010-01-01;
    when begins <= @2010-12-31;
    then start_up_business_begins_in_2010(p, activity);
}
pub relation start_up_year_one_deduction_2010(p: Person, activity: Integer, amount: Money) kind institutional {
    label en official "the year-one start-up deduction for a business beginning in 2010: the lesser of the expenditures or $10,000 reduced (not below zero) by the excess over $60,000 (section 195(b)(1)(A),(3))";
}
@source(IRC_S195_B, quote = "by substituting \"$10,000\" for \"$5,000\"")
rule StartUpYearOneDeduction2010(p: Person, activity: Integer, aggregate: Money) defeasible {
    label en official "in 2010 the immediate amount is min(expenditures, 10,000 less the excess over 60,000, not below zero) (section 195(b)(3))";
    when start_up_deduction_election_in_effect(p, activity);
    when start_up_business_begins_in_2010(p, activity);
    when start_up_expenditures_aggregate(p, activity, aggregate);
    then start_up_year_one_deduction_2010(p, activity, min(aggregate, max(0.00 USD, 10000.00 USD - max(0.00 USD, aggregate - 60000.00 USD))));
}
@source(IRC_S195_B, quote = "by substituting \"$60,000\" for \"$50,000\"")
rule StartUpYearOneDeduction2010Allowed(p: Person, y: TaxableYear, activity: Integer, amount: Money) defeasible {
    label en official "the 2010 year-one amount is allowed in the year the business begins (section 195(b)(1)(A),(3))";
    when start_up_year_one_deduction_2010(p, activity, amount);
    when active_trade_or_business_begins_in_year(p, activity, y);
    then deduction_allowed(p, y, Section195StartUp, amount);
}
@source(IRC_S195_B, quote = "the remainder of such start-up expenditures shall be allowed as a deduction ratably over the 180-month period beginning with the month in which the active trade or business begins")
rule StartUpRemainderAmortized2010(p: Person, y: TaxableYear, activity: Integer, aggregate: Money, immediate: Money, fraction: Decimal) defeasible {
    label en official "for a 2010 business the remainder after the $10,000 amount is amortized over 180 months (section 195(b)(1)(B),(3))";
    when start_up_business_begins_in_2010(p, activity);
    when start_up_expenditures_aggregate(p, activity, aggregate);
    when start_up_year_one_deduction_2010(p, activity, immediate);
    when aggregate > immediate;
    when start_up_amortization_month_fraction_for_year(p, activity, y, fraction);
    then deduction_allowed(p, y, Section195StartUp, round((aggregate - immediate) * fraction, 2, "HALF_UP"));
}
