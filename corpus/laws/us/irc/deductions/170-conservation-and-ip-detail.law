// Section 170 — stage 2b detail (TECH_GAPS G2779): (h)(6) qualified mineral interest, (h)(7) the
// pass-through limit (modified and relevant basis, other pass-through entities) with the (f)(19)
// coverage test derived from it, (m) donee income from intellectual property (12-year percentage table,
// 10-year and legal-life limits, 6050L cap, initial-deduction offset) and (n)(3) sanctioned whaling.
//
// Stage 1 interface changes (recorded): `partnership_conservation_contribution_amount`,
// `sum_of_partners_relevant_basis`, `partnership_contribution_certified_historic_structure_above_2_5_times_basis`,
// `recognized_whaling_captain_engaged_in_sanctioned_whaling` and `charitable_contribution_made` are now
// institutional (derived below, or still asserted by a case).
//
// JUDGMENT CALLS: (1) the part of a partner's modified basis allocable to the contributed real property is a
// percentage fact of the case (rules "similar to section 755"); (2) the "such other adjustments as the
// Secretary may provide" of (h)(7)(B)(ii)(III) are a case fact; (3) with no section 6050L report of the donee
// income the (m)(10)(B) cap is zero, so nothing is increased; (4) amounts are rounded to cents HALF_UP.
// Not modelled: the Secretary's short-taxable-year rules of (m)(10)(D)(i) and the exceptions of (o)(1)(B)
// (external dependencies).

// === (h)(6): qualified mineral interest ==================================================================

use self::{
    CharitableContributionKind,
    IRC_S170_19,
    IRC_S170_H,
    IRC_S170_M,
    IRC_S170_N,
    IRC_S170_TABLE_1,
    Individual,
    Person,
    TaxableYear,
    charitable_contribution_made,
    conservation_purpose_is_certified_historic_structure,
    partnership_conservation_contribution_amount,
    partnership_contribution_certified_historic_structure_above_2_5_times_basis,
    qualified_conservation_contribution_170h,
    recognized_whaling_captain_engaged_in_sanctioned_whaling,
    sum_of_partners_relevant_basis,
    taxable_year_begins_on,
};

pub relation interest_is_subsurface_oil_gas_or_other_minerals(interest: Integer) kind empirical {
    label en official "the interest is subsurface oil, gas, or other minerals (section 170(h)(6)(A))";
}
pub relation interest_is_right_of_access_to_minerals(interest: Integer) kind empirical {
    label en official "the interest is the right to access to such minerals (section 170(h)(6)(B))";
}
pub relation qualified_mineral_interest_170h6(interest: Integer) kind institutional {
    label en official "a qualified mineral interest: subsurface oil, gas or other minerals, or the right to access to them (section 170(h)(6))";
}
@source(IRC_S170_H, quote = "(A) subsurface oil, gas, or other minerals, and")
rule QualifiedMineralInterestSubsurface(interest: Integer) strict {
    label en official "subsurface oil, gas or other minerals (section 170(h)(6)(A))";
    when interest_is_subsurface_oil_gas_or_other_minerals(interest);
    then qualified_mineral_interest_170h6(interest);
}
@source(IRC_S170_H, quote = "(B) the right to access to such minerals.")
rule QualifiedMineralInterestAccess(interest: Integer) strict {
    label en official "the right to access to such minerals (section 170(h)(6)(B))";
    when interest_is_right_of_access_to_minerals(interest);
    then qualified_mineral_interest_170h6(interest);
}
pub relation contribution_retains_interest(contribution: Integer, interest: Integer) kind empirical {
    label en official "the donor retains the interest in a contribution of the entire interest (section 170(h)(2)(A))";
}
pub relation contribution_retains_qualified_mineral_interest(contribution: Integer) kind institutional {
    label en official "the donor retains a qualified mineral interest, so the entire interest 'other than a qualified mineral interest' is contributed (section 170(h)(2)(A),(6))";
}
@source(IRC_S170_H, quote = "For purposes of this subsection, the term \"qualified mineral interest\" means—")
rule ContributionRetainsQualifiedMineralInterest(contribution: Integer, interest: Integer) strict {
    label en official "a retained interest that is a qualified mineral interest (section 170(h)(6))";
    when contribution_retains_interest(contribution, interest);
    when qualified_mineral_interest_170h6(interest);
    then contribution_retains_qualified_mineral_interest(contribution);
}

// === (h)(7): modified basis and relevant basis of a partner ================================================

pub relation partner_adjusted_basis_immediately_before_contribution(contribution: Integer, partner: Integer, amount: Money) kind empirical {
    label en official "the partner's adjusted basis in the partnership immediately before the contribution (section 170(h)(7)(B)(ii)(I)), including the effect of section 752";
}
pub relation partner_section_752_basis_effect(contribution: Integer, partner: Integer, amount: Money) kind empirical {
    label en official "the part of the partner's adjusted basis attributable to section 752 (partnership liabilities), which is disregarded (section 170(h)(7)(B)(ii)(II))";
}
pub relation partner_other_secretary_basis_adjustment(contribution: Integer, partner: Integer, amount: Money) kind empirical {
    label en official "the other adjustments the Secretary provides to the partner's basis, a signed amount (section 170(h)(7)(B)(ii)(III)); zero when none";
}
pub relation partner_modified_basis(contribution: Integer, partner: Integer, amount: Money) kind institutional {
    label en official "the partner's modified basis: the adjusted basis immediately before the contribution, without regard to section 752, after the Secretary's other adjustments, not below zero (section 170(h)(7)(B)(ii))";
}
@source(IRC_S170_H, quote = "The term \"modified basis\" means, with respect to any partner, such partner's adjusted basis in the partnership as determined—")
rule PartnerModifiedBasis(contribution: Integer, partner: Integer, adjusted: Money, effect752: Money, other: Money) strict {
    label en official "adjusted basis before the contribution, less the section 752 effect, plus the Secretary's adjustments (section 170(h)(7)(B)(ii)(I)-(III)); a negative result is treated as zero (JUDGMENT CALL)";
    when partner_adjusted_basis_immediately_before_contribution(contribution, partner, adjusted);
    when partner_section_752_basis_effect(contribution, partner, effect752);
    when partner_other_secretary_basis_adjustment(contribution, partner, other);
    then partner_modified_basis(contribution, partner, max(0.00 USD, adjusted - effect752 + other));
}
pub relation partner_basis_allocable_percent_to_contributed_property(contribution: Integer, partner: Integer, percent: Integer) kind empirical {
    label en official "the percentage of the partner's modified basis allocable, under rules similar to section 755, to the portion of the real property with respect to which the contribution is made (section 170(h)(7)(B)(i))";
}
pub relation partner_relevant_basis(contribution: Integer, partner: Integer, amount: Money) kind institutional {
    label en official "the partner's relevant basis: the allocable portion of the partner's modified basis (section 170(h)(7)(B)(i))";
}
@source(IRC_S170_H, quote = "The term \"relevant basis\" means, with respect to any partner, the portion of such partner's modified basis in the partnership which is allocable (under rules similar to the rules of section 755) to the portion of the real property with respect to which the contribution described in subparagraph (A) is made.")
rule PartnerRelevantBasis(contribution: Integer, partner: Integer, modified: Money, percent: Integer) strict {
    label en official "modified basis times the allocable percentage (section 170(h)(7)(B)(i))";
    when partner_modified_basis(contribution, partner, modified);
    when partner_basis_allocable_percent_to_contributed_property(contribution, partner, percent);
    then partner_relevant_basis(contribution, partner, div_round(modified * percent, 100 * 1.0, 2, "HALF_UP"));
}
@source(IRC_S170_H, quote = "2.5 times the sum of each partner's relevant basis in such partnership.")
rule SumOfPartnersRelevantBasisDerived(contribution: Integer, p0: Integer, a0: Money) strict {
    label en official "the sum of each partner's relevant basis (section 170(h)(7)(A)); a total asserted by a case is still accepted";
    when partner_relevant_basis(contribution, p0, a0);
    then sum_of_partners_relevant_basis(contribution, sum all amount: Money for partner: Integer where partner_relevant_basis(contribution, partner, amount));
}

// === (h)(7)(F), (f)(19)(C): other pass-through entities ===================================================

pub relation pass_through_entity_conservation_contribution_amount(contribution: Integer, amount: Money) kind empirical {
    label en official "the amount of a conservation contribution made by an S corporation or other pass-through entity that is not a partnership (section 170(h)(7)(F), (f)(19)(C))";
}
pub relation secretary_provides_otherwise_for_pass_through_entity(contribution: Integer) kind empirical {
    label en official "the Secretary otherwise provides that the partnership rules do not apply to the entity (section 170(h)(7)(F) 'except as may be otherwise provided')";
}
@source(IRC_S170_H, quote = "Except as may be otherwise provided by the Secretary, the rules of this paragraph shall apply to S corporations and other pass-through entities in the same manner as such rules apply to partnerships.")
rule PassThroughEntityContributionTreatedAsPartnership(contribution: Integer, amount: Money) strict {
    label en official "an S corporation or other pass-through entity is treated as a partnership for the (h)(7) limit unless the Secretary provides otherwise (section 170(h)(7)(F))";
    when pass_through_entity_conservation_contribution_amount(contribution, amount);
    when not_known(secretary_provides_otherwise_for_pass_through_entity(contribution));
    then partnership_conservation_contribution_amount(contribution, amount);
}

// === (f)(19): the reporting rule applies to a contribution of the three kinds ==============================

pub relation conservation_contribution_by_partnership_in_year(contribution: Integer, partnership: Integer, y: TaxableYear) kind empirical {
    label en official "the contribution is made by the partnership (directly or as a distributive share of another partnership's contribution) in the taxable year (section 170(f)(19)(B)(ii))";
}
@source(IRC_S170_19, quote = "(iii) the amount of which exceeds 2.5 times the sum of each partner's relevant basis (as defined in subsection (h)(7)) in the partnership making the contribution.")
rule Reporting19ApplicableContribution(contribution: Integer, partnership: Integer, y: TaxableYear, amount: Money, basis: Money) strict {
    label en official "a qualified conservation contribution for a certified historic structure, made by a partnership, above 2.5 times the sum of the partners' relevant basis (section 170(f)(19)(B)(i)-(iii)); the pass-through entities of (C) come through the entity rule above";
    when qualified_conservation_contribution_170h(contribution);
    when conservation_purpose_is_certified_historic_structure(contribution);
    when conservation_contribution_by_partnership_in_year(contribution, partnership, y);
    when partnership_conservation_contribution_amount(contribution, amount);
    when sum_of_partners_relevant_basis(contribution, basis);
    when amount > basis * 2.5;
    then partnership_contribution_certified_historic_structure_above_2_5_times_basis(partnership, y);
}

// === (m): donee income from intellectual property ==========================================================

pub relation ip_contribution_by_donor(contribution: Integer, donor: Individual, on: Date) kind empirical {
    label en official "a charitable contribution of property made by the donor on the date (section 170(m)(1),(4))";
}
pub relation ip_property_described_in_e1B3_not_e1B2(contribution: Integer) kind empirical {
    label en official "the property is described in section 170(e)(1)(B)(iii) (patent, copyright, trademark, trade name, trade secret, know-how, software) and is not contributed to or for the use of an organization described in (e)(1)(B)(ii) (section 170(m)(9))";
}
pub relation ip_contribution_amount_reduced_by_e1(contribution: Integer) kind empirical {
    label en official "the amount of the contribution taken into account is reduced by reason of subsection (e)(1) (section 170(m)(8)(A))";
}
pub relation donor_informed_donee_of_qualified_ip_treatment(contribution: Integer) kind empirical {
    label en official "the donor informed the donee at the time of the contribution that the donor intends to treat it as a qualified intellectual property contribution for section 170(m) and section 6050L (section 170(m)(8)(B))";
}
pub relation qualified_ip_contribution_170m8(contribution: Integer) kind institutional {
    label en official "a qualified intellectual property contribution (section 170(m)(8))";
}
@source(IRC_S170_M, quote = "For purposes of this subsection, the term \"qualified intellectual property contribution\" means any charitable contribution of qualified intellectual property—")
rule QualifiedIpContribution(contribution: Integer) strict {
    label en official "a contribution of qualified intellectual property whose amount is reduced by (e)(1) and for which the donor informed the donee (section 170(m)(8),(9))";
    when ip_property_described_in_e1B3_not_e1B2(contribution);
    when ip_contribution_amount_reduced_by_e1(contribution);
    when donor_informed_donee_of_qualified_ip_treatment(contribution);
    then qualified_ip_contribution_170m8(contribution);
}

pub relation donor_taxable_year_end_date(donor: Individual, y: TaxableYear, end: Date) kind empirical {
    label en official "the last day of the donor's taxable year (section 170(m)(1),(4),(10)(C))";
}
pub relation s170m_donor_year_ordinal(contribution: Integer, y: TaxableYear, n: Integer) kind institutional {
    label en official "the donor's taxable year is the n-th taxable year of the donor ending on or after the date of the contribution (section 170(m)(7),(10)(C))";
}
@source(IRC_S170_M, quote = "corresponds to a taxable year of the donor ending on or after the date of the qualified intellectual property contribution:")
rule S170mDonorYearOrdinal(contribution: Integer, donor: Individual, on: Date, y: TaxableYear, end: Date) strict {
    label en official "the ordinal counts the donor's taxable years ending on or after the contribution date, up to and including this one";
    when ip_contribution_by_donor(contribution, donor, on);
    when donor_taxable_year_end_date(donor, y, end);
    when end >= on;
    then s170m_donor_year_ordinal(contribution, y, count(collect y2: TaxableYear, e2: Date where donor_taxable_year_end_date(donor, y2, e2) and e2 >= on and e2 <= end));
}

pub relation ip_donee_income_item(contribution: Integer, item: Integer, received: Date, donee_year_end: Date, net_income: Money) kind empirical {
    label en official "net income received by or accrued to the donee on the date, properly allocable to the qualified intellectual property, for the donee's taxable year ending on the stated date (section 170(m)(3),(4))";
}
pub relation ip_donee_reported_income_6050L(contribution: Integer, item: Integer, reported: Money) kind empirical {
    label en official "the amount of the income reported by the donee under section 6050L(b)(1) (section 170(m)(10)(B))";
}
pub relation ip_income_received_after_legal_life_expiry(contribution: Integer, item: Integer) kind empirical {
    label en official "the income is received or accrued after the expiration of the legal life of the property (section 170(m)(6))";
}
pub relation s170m_qualified_donee_income_item(contribution: Integer, item: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified donee income of an item allocated to the donor's taxable year: within 10 years of the contribution, within the legal life, capped by the amount reported under section 6050L (section 170(m)(3)-(6),(10)(B))";
}
@source(IRC_S170_M, quote = "For purposes of this subsection, the term \"qualified donee income\" means any net income received by or accrued to the donee which is properly allocable to the qualified intellectual property.")
rule S170mQualifiedDoneeIncomeItem(contribution: Integer, item: Integer, donor: Individual, on: Date, received: Date, donee_end: Date, net: Money, reported: Money, y: TaxableYear, end: Date, begins: Date) strict {
    label en official "allocated to the donor year in which the donee year ends; not after the 10-year period beginning on the contribution date ((5): received before the tenth anniversary); not after the legal life ((6)); not above the 6050L report ((10)(B))";
    when qualified_ip_contribution_170m8(contribution);
    when ip_contribution_by_donor(contribution, donor, on);
    when ip_donee_income_item(contribution, item, received, donee_end, net);
    when ip_donee_reported_income_6050L(contribution, item, reported);
    when received < add_calendar_period(on, 10 calendar_year);
    when not_known(ip_income_received_after_legal_life_expiry(contribution, item));
    when donor_taxable_year_end_date(donor, y, end);
    when taxable_year_begins_on(y, begins);
    when donee_end >= begins;
    when donee_end <= end;
    then s170m_qualified_donee_income_item(contribution, item, y, min(net, reported));
}
pub relation s170m_qualified_donee_income_for_year(contribution: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified donee income properly allocable to the donor's taxable year (section 170(m)(1),(4))";
}
@source(IRC_S170_M, quote = "qualified donee income shall be treated as properly allocable to a taxable year of the donor if such income is received by or accrued to the donee for the taxable year of the donee which ends within or with such taxable year of the donor.")
rule S170mQualifiedDoneeIncomeForYear(contribution: Integer, y: TaxableYear, i0: Integer, a0: Money) strict {
    label en official "helper: sums the item amounts allocated to the year";
    when s170m_qualified_donee_income_item(contribution, i0, y, a0);
    then s170m_qualified_donee_income_for_year(contribution, y,
        sum all amount: Money for item: Integer where s170m_qualified_donee_income_item(contribution, item, y, amount));
}

pub relation s170m_applicable_percentage(contribution: Integer, y: TaxableYear, n: Integer, percent: Integer) kind institutional {
    label en official "the applicable percentage for the n-th taxable year of the donor ending on or after the contribution date (section 170(m)(7)); there is no row after the 12th year (section 170(m)(10)(C))";
}
@source(IRC_S170_TABLE_1, quote = "1st / 100")
rule S170mPercentage1(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "1st year: 100 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 1;
    then s170m_applicable_percentage(contribution, y, n, 100);
}
@source(IRC_S170_TABLE_1, quote = "2nd / 100")
rule S170mPercentage2(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "2nd year: 100 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 2;
    then s170m_applicable_percentage(contribution, y, n, 100);
}
@source(IRC_S170_TABLE_1, quote = "3rd / 90")
rule S170mPercentage3(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "3rd year: 90 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 3;
    then s170m_applicable_percentage(contribution, y, n, 90);
}
@source(IRC_S170_TABLE_1, quote = "4th / 80")
rule S170mPercentage4(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "4th year: 80 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 4;
    then s170m_applicable_percentage(contribution, y, n, 80);
}
@source(IRC_S170_TABLE_1, quote = "5th / 70")
rule S170mPercentage5(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "5th year: 70 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 5;
    then s170m_applicable_percentage(contribution, y, n, 70);
}
@source(IRC_S170_TABLE_1, quote = "6th / 60")
rule S170mPercentage6(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "6th year: 60 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 6;
    then s170m_applicable_percentage(contribution, y, n, 60);
}
@source(IRC_S170_TABLE_1, quote = "7th / 50")
rule S170mPercentage7(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "7th year: 50 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 7;
    then s170m_applicable_percentage(contribution, y, n, 50);
}
@source(IRC_S170_TABLE_1, quote = "8th / 40")
rule S170mPercentage8(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "8th year: 40 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 8;
    then s170m_applicable_percentage(contribution, y, n, 40);
}
@source(IRC_S170_TABLE_1, quote = "9th / 30")
rule S170mPercentage9(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "9th year: 30 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 9;
    then s170m_applicable_percentage(contribution, y, n, 30);
}
@source(IRC_S170_TABLE_1, quote = "10th / 20")
rule S170mPercentage10(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "10th year: 20 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 10;
    then s170m_applicable_percentage(contribution, y, n, 20);
}
@source(IRC_S170_TABLE_1, quote = "11th / 10")
rule S170mPercentage11(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "11th year: 10 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 11;
    then s170m_applicable_percentage(contribution, y, n, 10);
}
@source(IRC_S170_TABLE_1, quote = "12th / 10")
rule S170mPercentage12(contribution: Integer, y: TaxableYear, n: Integer) strict {
    label en official "12th year: 10 percent";

    when s170m_donor_year_ordinal(contribution, y, n);
    when n == 12;
    then s170m_applicable_percentage(contribution, y, n, 10);
}

pub relation s170m_gross_increase_for_year(contribution: Integer, y: TaxableYear, n: Integer, amount: Money) kind institutional {
    label en official "the applicable percentage of the qualified donee income allocated to the year, before the initial-deduction offset (section 170(m)(1))";
}
@source(IRC_S170_M, quote = "shall be increased (subject to the limitations under subsection (b)) by the applicable percentage of qualified donee income with respect to such contribution which is properly allocable to such year under this subsection.")
rule S170mGrossIncreaseForYear(contribution: Integer, y: TaxableYear, n: Integer, income: Money, percent: Integer) strict {
    label en official "percentage times income, rounded to cents HALF_UP (JUDGMENT CALL); the 12th taxable year is the last (section 170(m)(10)(C))";
    when s170m_donor_year_ordinal(contribution, y, n);
    when s170m_qualified_donee_income_for_year(contribution, y, income);
    when s170m_applicable_percentage(contribution, y, n, percent);
    then s170m_gross_increase_for_year(contribution, y, n, div_round(income * percent, 100 * 1.0, 2, "HALF_UP"));
}
pub relation s170m_gross_increase_for_ordinal(contribution: Integer, n: Integer, amount: Money) kind institutional {
    label en official "helper: the gross increase keyed by the ordinal of the donor year, for the cumulative sum of (m)(2)";
}
rule S170mGrossIncreaseForOrdinal(contribution: Integer, y: TaxableYear, n: Integer, amount: Money) strict {
    label en official "helper: drops the year identity";
    when s170m_gross_increase_for_year(contribution, y, n, amount);
    then s170m_gross_increase_for_ordinal(contribution, n, amount);
}
pub relation s170m_cumulative_gross_increase(contribution: Integer, n: Integer, amount: Money) kind institutional {
    label en official "the aggregate of the gross increases for the ordinals up to and including n (section 170(m)(2))";
}
rule S170mCumulativeGrossIncrease(contribution: Integer, n: Integer, a0: Money) strict {
    label en official "helper: sums the gross increases of the ordinals not above n";
    when s170m_gross_increase_for_ordinal(contribution, n, a0);
    then s170m_cumulative_gross_increase(contribution, n,
        sum all amount: Money for k: Integer where s170m_gross_increase_for_ordinal(contribution, k, amount) and k <= n);
}
pub relation ip_initial_deduction_allowed(contribution: Integer, amount: Money) kind empirical {
    label en official "the amount allowed as a deduction under subsection (a) for the contribution determined without regard to subsection (m) (section 170(m)(2))";
}
pub relation ip_additional_deduction_amount(contribution: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase of the deduction for the donor year: the lesser of the year's gross increase and the excess of the cumulative gross increases over the initial deduction (section 170(m)(1),(2))";
}
@source(IRC_S170_M, quote = "the deduction allowed under subsection (a) shall be increased under paragraph (1) only to the extent that the aggregate amount of such increases with respect to such contribution exceed the amount allowed as a deduction under subsection (a) with respect to such contribution determined without regard to this subsection.")
rule S170mIncreaseAfterInitialDeduction(contribution: Integer, y: TaxableYear, n: Integer, gross: Money, cumulative: Money, initial: Money) strict {
    label en official "the increase is allowed only to the extent the cumulative gross increases exceed the initial deduction";
    when s170m_gross_increase_for_year(contribution, y, n, gross);
    when s170m_cumulative_gross_increase(contribution, n, cumulative);
    when ip_initial_deduction_allowed(contribution, initial);
    when cumulative > initial;
    then ip_additional_deduction_amount(contribution, y, min(gross, cumulative - initial));
}

pub relation ip_donee_contribution_kind(contribution: Integer, kind: CharitableContributionKind) kind empirical {
    label en official "the kind of the charitable contribution to the donee for the section 170(b) limits (section 170(m)(10)(A))";
}
@source(IRC_S170_M, quote = "Any increase under this subsection of the deduction provided under subsection (a) shall be treated for purposes of subsection (b) as a deduction which is attributable to a charitable contribution to the donee to which such increase relates.")
rule S170mIncreaseIsContributionToDonee(p: Individual, y: TaxableYear, contribution: Integer, kind: CharitableContributionKind, amount: Money, on0: Date) strict {
    label en official "the increase is a charitable contribution of the donee's kind for the (b) limits; item = the contribution";
    when ip_contribution_by_donor(contribution, p, on0);
    when ip_additional_deduction_amount(contribution, y, amount);
    when ip_donee_contribution_kind(contribution, kind);
    then charitable_contribution_made(p, y, contribution, kind, amount);
}

pub relation secretary_short_year_guidance_for_ip_income(contribution: Integer) kind empirical {
    label en official "the Secretary's guidance for a donor or donee with a short taxable year (section 170(m)(10)(D)(i)); not modelled";
}

// === (n)(3): sanctioned whaling activities =================================================================

pub relation activity_is_subsistence_bowhead_whale_hunting(activity: Integer) kind empirical {
    label en official "the activity is subsistence bowhead whale hunting (section 170(n)(3))";
}
pub relation activity_conducted_under_aewc_management_plan(activity: Integer) kind empirical {
    label en official "the activity is conducted pursuant to the management plan of the Alaska Eskimo Whaling Commission (section 170(n)(3))";
}
pub relation sanctioned_whaling_activity(activity: Integer) kind institutional {
    label en official "a sanctioned whaling activity (section 170(n)(3))";
}
@source(IRC_S170_N, quote = "means subsistence bowhead whale hunting activities conducted pursuant to the management plan of the Alaska Eskimo Whaling Commission.")
rule SanctionedWhalingActivity(activity: Integer) strict {
    label en official "subsistence bowhead whale hunting under the Commission's management plan";
    when activity_is_subsistence_bowhead_whale_hunting(activity);
    when activity_conducted_under_aewc_management_plan(activity);
    then sanctioned_whaling_activity(activity);
}
pub relation recognized_by_aewc_as_whaling_captain_responsible_for_activities(p: Person, y: TaxableYear) kind empirical {
    label en official "the individual is recognized by the Alaska Eskimo Whaling Commission as a whaling captain charged with the responsibility of maintaining and carrying out sanctioned whaling activities (section 170(n)(1))";
}
pub relation individual_engages_in_activity_in_year(p: Person, y: TaxableYear, activity: Integer) kind empirical {
    label en official "the individual engages in the activity during the taxable year (section 170(n)(1))";
}
@source(IRC_S170_N, quote = "who engages in such activities during the taxable year")
rule RecognizedWhalingCaptainEngagedInSanctionedWhaling(p: Person, y: TaxableYear, activity: Integer) strict {
    label en official "the recognized captain engages in a sanctioned whaling activity during the year (section 170(n)(1),(3))";
    when recognized_by_aewc_as_whaling_captain_responsible_for_activities(p, y);
    when individual_engages_in_activity_in_year(p, y, activity);
    when sanctioned_whaling_activity(activity);
    then recognized_whaling_captain_engaged_in_sanctioned_whaling(p, y);
}
