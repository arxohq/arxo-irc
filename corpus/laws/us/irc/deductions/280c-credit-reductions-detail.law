// Section 280C — certain expenses for which credits are allowable: stage 2b detail (TECH_GAPS G2796).
// (a) wages, (b) clinical testing with the capitalization rule and the reduced-credit election,
// (c) research with its election, (d)-(h) the other credit-portion disallowances. The credit amounts
// are facts (their computation belongs to the credit owners). Not modelled: the controlled-group
// rules under the Secretary's regulations ((a), (b)(4)); the reading of (c)(3) (INTERPRETATION);
// the irrevocability of an election as a separate norm (it is only the note of the effect).

use self::{
    DeductionKind,
    IRC_S280C_A,
    IRC_S280C_B,
    IRC_S280C_C,
    IRC_S280C_D,
    IRC_S280C_E,
    IRC_S280C_F,
    IRC_S280C_G,
    IRC_S280C_H,
    Person,
    TaxableYear,
    deduction_allowed,
};

enum WageCreditSection {
    S45Aa;
    S45Pa;
    S45Sa;
    S51a;
    S1396a;
}
pub relation wage_credit_determined_for_year(p: Person, y: TaxableYear, section: WageCreditSection, amount: Money) kind empirical {
    label en official "the credit determined for the taxable year under section 45A(a), 45P(a), 45S(a), 51(a) or 1396(a) (section 280C(a))";
}
pub relation sum_of_wage_credits_for_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the credits determined for the taxable year under sections 45A(a), 45P(a), 45S(a), 51(a) and 1396(a)";
}
rule SumOfWageCredits(p: Person, y: TaxableYear, c0: WageCreditSection, a0: Money) strict {
    label en official "helper: sums the wage-related credits determined for the taxable year (section 280C(a))";
    when wage_credit_determined_for_year(p, y, c0, a0);
    then sum_of_wage_credits_for_year(p, y,
        sum all amount: Money for c: WageCreditSection where wage_credit_determined_for_year(p, y, c, amount));
}
@source(IRC_S280C_A, quote = "No deduction shall be allowed for that portion of the wages or salaries paid or incurred for the taxable year which is equal to the sum of the credits determined for the taxable year")
rule Section280cWagesPortionEqualToCreditsNotDeductible(p: Person, y: TaxableYear, credits: Money) strict {
    label en official "no deduction for the portion of wages or salaries equal to the sum of the section 45A(a), 45P(a), 45S(a), 51(a) and 1396(a) credits (section 280C(a))";
    when sum_of_wage_credits_for_year(p, y, credits);
    when credits > 0.00 USD;
    then not deduction_allowed(p, y, Section280CWagesPortion, credits);
}

// --- (b): qualified clinical testing expenses ---------------------------------------------------------------------------------

pub relation credit_under_45c_without_38c_limit(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit allowable for the taxable year under section 45C, determined without regard to section 38(c) (section 280C(b)(1),(2))";
}
pub relation qualified_clinical_testing_expenses_deductible_before_280c(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualified clinical testing expenses (section 45C(b)) otherwise allowable as a deduction for the taxable year, determined without regard to paragraph (1) (section 280C(b)(1),(2)(B))";
}
pub relation reduced_credit_election_in_effect_280cb(p: Person, y: TaxableYear) kind institutional {
    label en official "the election of reduced credit under section 280C(b)(3) is in effect for the taxable year";
}
@source(IRC_S280C_B, quote = "No deduction shall be allowed for that portion of the qualified clinical testing expenses")
rule Section280cbClinicalTestingPortionNotDeductible(p: Person, y: TaxableYear, credit: Money) defeasible {
    label en official "no deduction for the part of qualified clinical testing expenses equal to the section 45C credit (without regard to section 38(c)), unless the reduced-credit election is made (section 280C(b)(1),(3)(A)(i))";
    when credit_under_45c_without_38c_limit(p, y, credit);
    when credit > 0.00 USD;
    when not_known(reduced_credit_election_in_effect_280cb(p, y));
    then not deduction_allowed(p, y, Section280CClinicalTestingPortion, credit);
}
pub relation clinical_testing_expenses_chargeable_to_capital_account(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount chargeable to capital account for the taxable year for qualified clinical testing expenses (section 280C(b)(2))";
}
pub relation clinical_testing_capital_account_reduction(p: Person, y: TaxableYear, reduction: Money) kind institutional {
    label en official "the reduction of the amount chargeable to capital account by the excess of the section 45C credit over the deduction allowable for the expenses (section 280C(b)(2))";
}
@source(IRC_S280C_B, quote = "the amount chargeable to capital account for the taxable year for such expenses shall be reduced by the amount of such excess")
rule Section280cbCapitalizedExpensesReducedByExcess(p: Person, y: TaxableYear, credit: Money, deduction: Money) defeasible {
    label en official "where the credit exceeds the deduction allowable for the expenses (they being capitalized), the capital account is reduced by the excess (section 280C(b)(2)); not when the election applies";
    when credit_under_45c_without_38c_limit(p, y, credit);
    when qualified_clinical_testing_expenses_deductible_before_280c(p, y, deduction);
    when credit > deduction;
    when not_known(reduced_credit_election_in_effect_280cb(p, y));
    then clinical_testing_capital_account_reduction(p, y, credit - deduction);
}
pub relation maximum_rate_of_tax_under_11b(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "the maximum rate of tax under section 11(b) for the taxable year (section 280C(b)(3)(B)(ii)(II),(c)(2)(B)(ii)(II)); the rate is a fact, section 11 is owned by the corporations package";
}
pub relation credit_under_45c_a_without_election(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of credit determined under section 45C(a) without regard to paragraph (3) (section 280C(b)(3)(B)(i))";
}
pub relation elects_reduced_45c_credit(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the reduced section 45C credit for the taxable year (section 280C(b)(3))";
}
pub relation reduced_credit_election_made_on_timely_return(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made not later than the time for filing the return for the year (including extensions), on the return, in the manner the Secretary prescribes (section 280C(b)(3)(C))";
}
@source(IRC_S280C_B, quote = "An election under this paragraph for any taxable year shall be made not later than the time for filing the return of tax for such year")
rule S280cbElectReducedCreditPower(p: Person, y: TaxableYear) defeasible {
    label en official "the taxpayer may elect the reduced credit for the year; the election must be made on a timely return; once made it is irrevocable (section 280C(b)(3)(C)); an untimely election has no effect";
    when elects_reduced_45c_credit(p, y);
    then power S280cbElectReducedClinicalTestingCredit {
        holder p;
        over y;
        exercise elects_reduced_45c_credit(p, y);
        valid_when reduced_credit_election_made_on_timely_return(p, y);
        effect create(reduced_credit_election_in_effect_280cb(p, y));
        window [-infinity, infinity];
    };
}
pub relation reduced_45c_credit_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduced section 45C credit: the credit without regard to paragraph (3) less its product with the maximum section 11(b) rate (section 280C(b)(3)(B))";
}
@source(IRC_S280C_B, quote = "the amount of the credit under section 45C(a) shall be the amount determined under subparagraph (B)")
rule ReducedSection45cCreditAmount(p: Person, y: TaxableYear, credit: Money, rate: Decimal) defeasible {
    label en official "with the election, the credit equals the credit less the credit times the maximum rate under section 11(b), rounded to cents HALF_UP (text names no rounding; JUDGMENT CALL)";
    when reduced_credit_election_in_effect_280cb(p, y);
    when credit_under_45c_a_without_election(p, y, credit);
    when maximum_rate_of_tax_under_11b(y, rate);
    then reduced_45c_credit_amount(p, y, credit - round(credit * rate, 2, "HALF_UP"));
}

// --- (c): research credit ------------------------------------------------------------------------------------------------------

pub relation credit_under_41a1(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined for the taxable year under section 41(a)(1) (section 280C(c)(1)(A))";
}
pub relation deduction_for_qualified_or_basic_research_expenses(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount allowable as a deduction for the taxable year for qualified research expenses or basic research expenses (section 280C(c)(1)(B))";
}
pub relation reduced_research_credit_election_in_effect_280cc(p: Person, y: TaxableYear) kind institutional {
    label en official "the election of reduced credit under section 280C(c)(2) is in effect for the taxable year";
}
pub relation research_expenses_capital_account_reduction(p: Person, y: TaxableYear, reduction: Money) kind institutional {
    label en official "the reduction of the amount chargeable to capital account for the expenses by the excess of the section 41(a)(1) credit over the deduction (section 280C(c)(1))";
}
@source(IRC_S280C_C, quote = "the amount chargeable to capital account for the taxable year for such expenses shall be reduced by the amount of such excess")
rule Section280ccResearchCapitalReducedByExcess(p: Person, y: TaxableYear, credit: Money, deduction: Money) defeasible {
    label en official "where the section 41(a)(1) credit exceeds the deduction for research expenses, the capital account is reduced by the excess (section 280C(c)(1)); not when the election applies";
    when credit_under_41a1(p, y, credit);
    when deduction_for_qualified_or_basic_research_expenses(p, y, deduction);
    when credit > deduction;
    when not_known(reduced_research_credit_election_in_effect_280cc(p, y));
    then research_expenses_capital_account_reduction(p, y, credit - deduction);
}
pub relation elects_reduced_41_credit(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects the reduced section 41 credit for the taxable year (section 280C(c)(2))";
}
pub relation reduced_research_credit_election_made_on_timely_return(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely return in the manner the Secretary may prescribe (section 280C(c)(2)(C))";
}
@source(IRC_S280C_C, quote = "An election under this paragraph for any taxable year shall be made not later than the time for filing the return of tax for such year")
rule S280ccElectReducedResearchCreditPower(p: Person, y: TaxableYear) defeasible {
    label en official "the taxpayer may elect the reduced research credit on a timely return; once made it is irrevocable (section 280C(c)(2)(C)); an untimely election has no effect";
    when elects_reduced_41_credit(p, y);
    then power S280ccElectReducedResearchCredit {
        holder p;
        over y;
        exercise elects_reduced_41_credit(p, y);
        valid_when reduced_research_credit_election_made_on_timely_return(p, y);
        effect create(reduced_research_credit_election_in_effect_280cc(p, y));
        window [-infinity, infinity];
    };
}
pub relation credit_under_41a_without_election(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of credit determined under section 41(a) without regard to paragraph (2) (section 280C(c)(2)(B)(i))";
}
pub relation reduced_41_credit_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduced section 41 credit: the credit less its product with the maximum section 11(b) rate (section 280C(c)(2)(B))";
}
@source(IRC_S280C_C, quote = "the amount of the credit under section 41(a) shall be the amount determined under subparagraph (B)")
rule ReducedSection41CreditAmount(p: Person, y: TaxableYear, credit: Money, rate: Decimal) defeasible {
    label en official "with the election, the credit equals the credit less the credit times the maximum rate under section 11(b), rounded to cents HALF_UP (JUDGMENT CALL)";
    when reduced_research_credit_election_in_effect_280cc(p, y);
    when credit_under_41a_without_election(p, y, credit);
    when maximum_rate_of_tax_under_11b(y, rate);
    then reduced_41_credit_amount(p, y, credit - round(credit * rate, 2, "HALF_UP"));
}

// --- (d)-(h): other credit-portion disallowances --------------------------------------------------------------------------------

pub relation credit_determined_under_45h_a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit determined for the taxable year under section 45H(a) (section 280C(d))";
}
@source(IRC_S280C_D, quote = "The deductions otherwise allowed under this chapter for the taxable year shall be reduced by the amount of the credit determined for the taxable year under section 45H(a).")
rule Section280cdDeductionsReducedBy45hCredit(p: Person, y: TaxableYear, credit: Money) strict {
    label en official "the deductions allowed under chapter 1 are reduced by the section 45H(a) credit (section 280C(d))";
    when credit_determined_under_45h_a(p, y, credit);
    when credit > 0.00 USD;
    then not deduction_allowed(p, y, Section280CCreditPortion, credit);
}
pub relation credit_determined_under_45n_a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit determined for the taxable year under section 45N(a) (section 280C(e))";
}
@source(IRC_S280C_E, quote = "No deduction shall be allowed for that portion of the expenses otherwise allowable as a deduction for the taxable year which is equal to the amount of the credit determined for the taxable year under section 45N(a).")
rule Section280ceNoDeductionForCreditPortion45n(p: Person, y: TaxableYear, credit: Money) strict {
    label en official "no deduction for the portion of expenses equal to the section 45N(a) credit (section 280C(e))";
    when credit_determined_under_45n_a(p, y, credit);
    when credit > 0.00 USD;
    then not deduction_allowed(p, y, Section280CCreditPortion, credit);
}
pub relation credit_determined_under_45o_a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit determined for the taxable year under section 45O(a) (section 280C(f))";
}
@source(IRC_S280C_F, quote = "which is equal to the amount of the credit determined for such taxable year under section 45O(a)")
rule Section280cfNoDeductionForCreditPortion45o(p: Person, y: TaxableYear, credit: Money) strict {
    label en official "no deduction for the portion of expenses taken into account in the section 45O credit equal to that credit (section 280C(f))";
    when credit_determined_under_45o_a(p, y, credit);
    when credit > 0.00 USD;
    then not deduction_allowed(p, y, Section280CCreditPortion, credit);
}
pub relation credit_determined_under_36b_a_for_premiums(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit determined for the taxable year under section 36B(a) with respect to premiums paid for coverage under a qualified health plan (section 280C(g))";
}
@source(IRC_S280C_G, quote = "No deduction shall be allowed for the portion of the premiums paid by the taxpayer for coverage of 1 or more individuals under a qualified health plan")
rule Section280cgNoDeductionForPremiumPortion36b(p: Person, y: TaxableYear, credit: Money) strict {
    label en official "no deduction for the portion of qualified health plan premiums equal to the section 36B(a) credit (section 280C(g))";
    when credit_determined_under_36b_a_for_premiums(p, y, credit);
    when credit > 0.00 USD;
    then not deduction_allowed(p, y, Section280CCreditPortion, credit);
}
pub relation credit_determined_under_45r_a_for_premiums(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the credit determined under section 45R(a) with respect to the employer's premiums for qualified health plans (or health insurance coverage in 2010-2013) (section 280C(h))";
}
@source(IRC_S280C_H, quote = "which is equal to the amount of the credit determined under section 45R(a) with respect to the premiums")
rule Section280chNoDeductionForPremiumPortion45r(p: Person, y: TaxableYear, credit: Money) strict {
    label en official "no deduction for the portion of the employer's premiums equal to the section 45R(a) credit (section 280C(h))";
    when credit_determined_under_45r_a_for_premiums(p, y, credit);
    when credit > 0.00 USD;
    then not deduction_allowed(p, y, Section280CCreditPortion, credit);
}
