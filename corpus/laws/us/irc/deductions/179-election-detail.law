// Section 179 — election to expense: stage 2b detail (TECH_GAPS G2804). (b)(4) married individuals
// filing separately, (b)(5) the sport utility vehicle sub-cap, (b)(6) the inflation adjustment,
// (c) the form of the election and its revocation, (d) the definitions (section 179 property, purchase,
// cost), the estate/trust, lessor and controlled group rules, partnerships, the section 38
// coordination and the recapture regulations, (e) qualified real property. The stage 1
// election power's `valid_when` now reads `section_179_election_exercisable`, which is the election
// fact unless the election is defective in form ((c)(1)), the taxpayer is an estate or trust ((d)(4))
// or a noncorporate lessor outside the exceptions ((d)(5)). Not modelled: the manner of election set
// by regulations, the Secretary's apportionment among controlled group members ((d)(6)(B)), the
// section 1563(a) controlled group definition, published indexed amounts (Rev. Proc.).

// --- (c): the election ---------------------------------------------------------------------------------------------------------------------------

use self::{
    IRC_S179_B,
    IRC_S179_C,
    IRC_S179_D,
    IRC_S179_E,
    Individual,
    Person,
    TaxableYear,
    elects_to_expense_section_179_property,
    section_179_election_in_effect,
    taxable_year_begins_on,
};

pub relation section_179_election_not_specifying_items_and_cost_portions(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the election fails to specify the items of section 179 property and the portion of the cost of each to be taken into account (section 179(c)(1)(A))";
}
pub relation section_179_election_not_made_on_return(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the election is not made on the taxpayer's return of the tax imposed by chapter 1 for the taxable year (section 179(c)(1)(B))";
}
pub relation taxpayer_is_estate_or_trust_179(p: Person) kind empirical {
    label en official "the taxpayer is an estate or a trust (section 179(d)(4))";
}
pub relation noncorporate_lessor_of_section_179_property(p: Person, item: Integer) kind empirical {
    label en official "the person is not a corporation and is the lessor of section 179 property it purchased (section 179(d)(5))";
}
pub relation lessor_manufactured_or_produced_leased_property(item: Integer) kind empirical {
    label en official "the property subject to the lease has been manufactured or produced by the lessor (section 179(d)(5)(A))";
}
pub relation lease_term_under_half_of_class_life_and_first_year_deductions_exceed_15_percent_of_rents(item: Integer) kind empirical {
    label en official "the lease term (with renewal options) is less than 50 percent of the class life (section 168(i)(1)) and, for the first 12 months after transfer to the lessee, the lessor's section 162 deductions (other than rents and reimbursed amounts) exceed 15 percent of the rental income (section 179(d)(5)(B))";
}
pub relation noncorporate_lessor_excluded_179(p: Person, item: Integer) kind institutional {
    label en official "the section applies to no property purchased by a noncorporate lessor unless an exception of (d)(5)(A) or (B) is met";
}
@source(IRC_S179_D, quote = "This section shall not apply to any section 179 property which is purchased by a person who is not a corporation and with respect to which such person is the lessor unless")
rule NoncorporateLessorExcludedUnlessException(p: Person, item: Integer) defeasible {
    label en official "a noncorporate lessor of section 179 property is excluded unless the property was manufactured or produced by it or the short-lease conditions are met (section 179(d)(5))";
    when noncorporate_lessor_of_section_179_property(p, item);
    when not_known(lessor_manufactured_or_produced_leased_property(item));
    when not_known(lease_term_under_half_of_class_life_and_first_year_deductions_exceed_15_percent_of_rents(item));
    then noncorporate_lessor_excluded_179(p, item);
}
pub relation section_179_election_exercisable(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 179(a) election may validly be exercised: no formal defect (c)(1), not an estate or trust (d)(4), not an excluded noncorporate lessor (d)(5)";
}
@source(IRC_S179_C, quote = "An election under this section for any taxable year shall")
rule Section179ElectionExercisable(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "an election is exercisable when made in proper form by a taxpayer other than an estate, a trust or an excluded noncorporate lessor (section 179(c)(1),(d)(4),(d)(5)); the absence of a recorded defect is not a finding of validity but leaves the election standing";
    when elects_to_expense_section_179_property(p, y, item);
    when not_known(section_179_election_not_specifying_items_and_cost_portions(p, y, item));
    when not_known(section_179_election_not_made_on_return(p, y, item));
    when not_known(taxpayer_is_estate_or_trust_179(p));
    when not_known(noncorporate_lessor_excluded_179(p, item));
    then section_179_election_exercisable(p, y, item);
}
pub relation revokes_section_179_election(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer revokes the election (or a specification in it) with respect to the property (section 179(c)(2))";
}
pub relation section_179_election_revoked(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the election is revoked with respect to the property; the revocation, once made, is irrevocable (section 179(c)(2))";
}
@source(IRC_S179_C, quote = "Any election made under this section, and any specification contained in any such election, may be revoked by the taxpayer with respect to any property, and such revocation, once made, shall be irrevocable.")
rule S179RevocationPower(p: Person, y: TaxableYear, item: Integer) defeasible {
    label en official "the taxpayer may revoke the election for a property; the revocation is itself irrevocable (section 179(c)(2)); a revocation of an election not in effect has no effect";
    when revokes_section_179_election(p, y, item);
    then power S179cRevokeElection {
        holder p;
        over item;
        exercise revokes_section_179_election(p, y, item);
        valid_when section_179_election_in_effect(p, y, item);
        effect create(section_179_election_revoked(p, y, item));
        window [-infinity, infinity];
    };
}

// --- (d)(1),(2),(3): section 179 property, purchase, cost ---------------------------------------------------------------------------------------

pub relation property_is_tangible_property_to_which_168_applies(item: Integer) kind empirical {
    label en official "tangible property to which section 168 applies (section 179(d)(1)(A)(i))";
}
pub relation property_is_computer_software_197e3_to_which_167_applies(item: Integer) kind empirical {
    label en official "computer software (section 197(e)(3)(B)) described in section 197(e)(3)(A)(i) and to which section 167 applies (section 179(d)(1)(A)(ii))";
}
pub relation property_is_section_1245_property(item: Integer) kind empirical {
    label en official "section 1245 property as defined in section 1245(a)(3) (section 179(d)(1)(B)(i))";
}
pub relation elects_treatment_as_qualified_real_property(item: Integer) kind empirical {
    label en official "at the election of the taxpayer, the property is qualified real property (section 179(d)(1)(B)(ii))";
}
pub relation property_acquired_by_purchase_for_active_conduct_of_trade_or_business(item: Integer) kind empirical {
    label en official "the property is acquired by purchase for use in the active conduct of a trade or business (section 179(d)(1)(C))";
}
pub relation property_described_in_section_50b_other_than_50b2(item: Integer) kind empirical {
    label en official "the property is described in section 50(b) (other than paragraph (2) thereof) (section 179(d)(1) last sentence)";
}
pub relation section_179_property(item: Integer) kind institutional {
    label en official "section 179 property within section 179(d)(1)";
}
@source(IRC_S179_D, quote = "For purposes of this section, the term \"section 179 property\" means property")
rule Section179PropertyTangibleSection1245(item: Integer) defeasible {
    label en official "tangible section 168 property that is section 1245 property (or qualified real property by election), acquired by purchase for active business use, is section 179 property unless described in section 50(b) (section 179(d)(1))";
    when property_is_tangible_property_to_which_168_applies(item);
    when property_is_section_1245_property(item);
    when property_acquired_by_purchase_for_active_conduct_of_trade_or_business(item);
    when not_known(property_described_in_section_50b_other_than_50b2(item));
    then section_179_property(item);
}
@source(IRC_S179_D, quote = "computer software (as defined in section 197(e)(3)(B)) which is described in section 197(e)(3)(A)(i) and to which section 167 applies")
rule Section179PropertyComputerSoftware(item: Integer) defeasible {
    label en official "qualifying computer software that is section 1245 property, acquired by purchase for active business use, is section 179 property (section 179(d)(1)(A)(ii))";
    when property_is_computer_software_197e3_to_which_167_applies(item);
    when property_is_section_1245_property(item);
    when property_acquired_by_purchase_for_active_conduct_of_trade_or_business(item);
    when not_known(property_described_in_section_50b_other_than_50b2(item));
    then section_179_property(item);
}
@source(IRC_S179_D, quote = "(ii) at the election of the taxpayer, qualified real property (as defined in subsection (e))")
rule Section179PropertyElectedQualifiedRealProperty(item: Integer) defeasible {
    label en official "qualified real property elected to be section 179 property, tangible, acquired by purchase for active business use (section 179(d)(1)(B)(ii))";
    when property_is_tangible_property_to_which_168_applies(item);
    when elects_treatment_as_qualified_real_property(item);
    when qualified_real_property_179e(item);
    when property_acquired_by_purchase_for_active_conduct_of_trade_or_business(item);
    when not_known(property_described_in_section_50b_other_than_50b2(item));
    then section_179_property(item);
}
pub relation acquired_from_person_whose_relationship_would_disallow_losses_267_or_707b(item: Integer) kind empirical {
    label en official "the property is acquired from a person whose relationship would result in the disallowance of losses under section 267 or 707(b) (family limited to spouse, ancestors and lineal descendants) (section 179(d)(2)(A))";
}
pub relation acquired_by_one_component_member_of_controlled_group_from_another(item: Integer) kind empirical {
    label en official "the property is acquired by one component member of a controlled group from another component member of the same controlled group (section 179(d)(2)(B))";
}
pub relation basis_determined_by_reference_to_transferor_basis(item: Integer) kind empirical {
    label en official "the acquirer's basis is determined in whole or in part by reference to the adjusted basis of the property in the hands of the person from whom acquired (section 179(d)(2)(C)(i))";
}
pub relation basis_determined_under_1014a_from_decedent(item: Integer) kind empirical {
    label en official "the acquirer's basis is determined under section 1014(a) (property acquired from a decedent) (section 179(d)(2)(C)(ii))";
}
pub relation any_acquisition_of_property(item: Integer) kind empirical {
    label en official "the property is acquired (any acquisition of property) (section 179(d)(2))";
}
pub relation acquisition_is_purchase_179d2(item: Integer) kind institutional {
    label en official "the acquisition is a purchase within section 179(d)(2)";
}
@source(IRC_S179_D, quote = "the term \"purchase\" means any acquisition of property, but only if")
rule PurchaseDefinition179d2(item: Integer) defeasible {
    label en official "an acquisition is a purchase only if not from a related person, not within a controlled group, and not at a carryover or section 1014(a) basis (section 179(d)(2))";
    when any_acquisition_of_property(item);
    when not_known(acquired_from_person_whose_relationship_would_disallow_losses_267_or_707b(item));
    when not_known(acquired_by_one_component_member_of_controlled_group_from_another(item));
    when not_known(basis_determined_by_reference_to_transferor_basis(item));
    when not_known(basis_determined_under_1014a_from_decedent(item));
    then acquisition_is_purchase_179d2(item);
}
pub relation basis_of_property_for_179(item: Integer, amount: Money) kind empirical {
    label en official "the basis of the property";
}
pub relation basis_determined_by_reference_to_basis_of_other_property(item: Integer, amount: Money) kind empirical {
    label en official "so much of the basis as is determined by reference to the basis of other property held at any time by the person acquiring such property (section 179(d)(3))";
}
pub relation section_179_cost_of_property(item: Integer, amount: Money) kind institutional {
    label en official "the cost of section 179 property: the basis less the part determined by reference to the basis of other property (section 179(d)(3))";
}
@source(IRC_S179_D, quote = "the cost of property does not include so much of the basis of such property as is determined by reference to the basis of other property held at any time by the person acquiring such property")
rule Section179CostExcludesCarryoverBasis(item: Integer, basis: Money, carryover: Money) strict {
    label en official "cost is the basis less the part determined by reference to the basis of other property, not below zero (section 179(d)(3))";
    when basis_of_property_for_179(item, basis);
    when basis_determined_by_reference_to_basis_of_other_property(item, carryover);
    then section_179_cost_of_property(item, max(0.00 USD, basis - carryover));
}

// --- (e): qualified real property ------------------------------------------------------------------------------------------------------------------

pub relation property_is_qualified_improvement_property_168e6(item: Integer) kind empirical {
    label en official "qualified improvement property described in section 168(e)(6) (section 179(e)(1))";
}
pub relation improvement_to_nonresidential_real_property_placed_in_service_after_first_service(item: Integer) kind empirical {
    label en official "an improvement to nonresidential real property placed in service after the date the property was first placed in service (section 179(e)(2))";
}
pub relation improvement_is_roof(item: Integer) kind empirical {
    label en official "roofs (section 179(e)(2)(A))";
}
pub relation improvement_is_hvac_property(item: Integer) kind empirical {
    label en official "heating, ventilation and air-conditioning property (section 179(e)(2)(B))";
}
pub relation improvement_is_fire_protection_or_alarm_system(item: Integer) kind empirical {
    label en official "fire protection and alarm systems (section 179(e)(2)(C))";
}
pub relation improvement_is_security_system(item: Integer) kind empirical {
    label en official "security systems (section 179(e)(2)(D))";
}
pub relation qualified_real_property_179e(item: Integer) kind institutional {
    label en official "qualified real property within section 179(e)";
}
@source(IRC_S179_E, quote = "(1) any qualified improvement property described in section 168(e)(6), and")
rule QualifiedRealPropertyQualifiedImprovementProperty(item: Integer) strict {
    label en official "qualified improvement property is qualified real property (section 179(e)(1))";
    when property_is_qualified_improvement_property_168e6(item);
    then qualified_real_property_179e(item);
}
@source(IRC_S179_E, quote = "(A) Roofs.")
rule QualifiedRealPropertyRoof(item: Integer) strict {
    label en official "a roof improvement to nonresidential real property placed in service later is qualified real property (section 179(e)(2)(A))";
    when improvement_to_nonresidential_real_property_placed_in_service_after_first_service(item);
    when improvement_is_roof(item);
    then qualified_real_property_179e(item);
}
@source(IRC_S179_E, quote = "(B) Heating, ventilation, and air-conditioning property.")
rule QualifiedRealPropertyHvac(item: Integer) strict {
    label en official "an HVAC improvement is qualified real property (section 179(e)(2)(B))";
    when improvement_to_nonresidential_real_property_placed_in_service_after_first_service(item);
    when improvement_is_hvac_property(item);
    then qualified_real_property_179e(item);
}
@source(IRC_S179_E, quote = "(C) Fire protection and alarm systems.")
rule QualifiedRealPropertyFireProtection(item: Integer) strict {
    label en official "a fire protection or alarm system improvement is qualified real property (section 179(e)(2)(C))";
    when improvement_to_nonresidential_real_property_placed_in_service_after_first_service(item);
    when improvement_is_fire_protection_or_alarm_system(item);
    then qualified_real_property_179e(item);
}
@source(IRC_S179_E, quote = "(D) Security systems.")
rule QualifiedRealPropertySecuritySystem(item: Integer) strict {
    label en official "a security system improvement is qualified real property (section 179(e)(2)(D))";
    when improvement_to_nonresidential_real_property_placed_in_service_after_first_service(item);
    when improvement_is_security_system(item);
    then qualified_real_property_179e(item);
}

// --- (b)(4): married individuals filing separately ------------------------------------------------------------------------------------------------------

pub relation married_filing_separate_returns_179(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is married and files a separate return for the taxable year (section 179(b)(4))";
}
pub relation cost_taken_into_account_by_spouses_combined_before_income_limit(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the cost which may be taken into account under subsection (a) for the taxable year, the two spouses treated as 1 taxpayer for (b)(1) and (2), before paragraph (3) (section 179(b)(4)(B))";
}
pub relation spouses_elect_other_allocation_percent(p: Individual, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the spouses elect to allocate the cost otherwise than equally: this individual's share (section 179(b)(4)(B))";
}
pub relation cost_allocated_to_separate_filer_179(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the combined cost allocated to the individual: 50 percent unless the spouses elect otherwise (section 179(b)(4)(B))";
}
@source(IRC_S179_B, quote = "unless such individuals elect otherwise, 50 percent of the cost which may be taken into account under subsection (a) for such taxable year (before application of paragraph (3)) shall be allocated to each such individual")
rule SeparateFilerHalfAllocation(p: Individual, y: TaxableYear, combined: Money) defeasible {
    label en official "each separately filing spouse is allocated 50 percent of the combined cost unless they elect otherwise (section 179(b)(4)(B)), rounded to cents HALF_UP";
    when married_filing_separate_returns_179(p, y);
    when cost_taken_into_account_by_spouses_combined_before_income_limit(p, y, combined);
    when not_known(spouses_elect_other_allocation_percent(p, y, 0.5));
    then cost_allocated_to_separate_filer_179(p, y, round(combined * 50 percent, 2, "HALF_UP"));
}
@source(IRC_S179_B, quote = "unless such individuals elect otherwise")
rule SeparateFilerElectedAllocation(p: Individual, y: TaxableYear, combined: Money, share: Decimal) defeasible {
    label en official "the spouses' elected allocation applies instead of 50 percent (section 179(b)(4)(B))";
    when married_filing_separate_returns_179(p, y);
    when cost_taken_into_account_by_spouses_combined_before_income_limit(p, y, combined);
    when spouses_elect_other_allocation_percent(p, y, share);
    then cost_allocated_to_separate_filer_179(p, y, round(combined * share, 2, "HALF_UP"));
}

// --- (b)(5): sport utility vehicles ------------------------------------------------------------------------------------------------------------------------

pub relation four_wheeled_vehicle_designed_to_carry_passengers_on_public_roads(item: Integer) kind empirical {
    label en official "a 4-wheeled vehicle primarily designed or which can be used to carry passengers over public streets, roads or highways (not rail-only) (section 179(b)(5)(B)(i)(I))";
}
pub relation vehicle_subject_to_section_280f(item: Integer) kind empirical {
    label en official "the vehicle is subject to section 280F (section 179(b)(5)(B)(i)(II))";
}
pub relation vehicle_gross_weight_rating_pounds(item: Integer, pounds: Integer) kind empirical {
    label en official "the vehicle's gross vehicle weight rating in pounds (section 179(b)(5)(B)(i)(III))";
}
pub relation vehicle_seating_more_than_nine_behind_driver(item: Integer) kind empirical {
    label en official "the vehicle is designed to have a seating capacity of more than 9 persons behind the driver's seat (section 179(b)(5)(B)(ii)(I))";
}
pub relation vehicle_with_open_or_capped_cargo_area_six_feet(item: Integer) kind empirical {
    label en official "the vehicle is equipped with a cargo area of at least 6 feet in interior length which is open or designed as open but enclosed by a cap and not readily accessible from the passenger compartment (section 179(b)(5)(B)(ii)(II))";
}
pub relation vehicle_with_integral_enclosure_no_rear_seating(item: Integer) kind empirical {
    label en official "the vehicle has an integral enclosure fully enclosing the driver compartment and load carrying device, no seating rearward of the driver's seat and no body section protruding more than 30 inches ahead of the windshield (section 179(b)(5)(B)(ii)(III))";
}
pub relation sport_utility_vehicle_179(item: Integer) kind institutional {
    label en official "a sport utility vehicle within section 179(b)(5)(B)";
}
@source(IRC_S179_B, quote = "The term \"sport utility vehicle\" means any 4-wheeled vehicle")
rule SportUtilityVehicleDefinition(item: Integer, pounds: Integer) defeasible {
    label en official "a 4-wheeled passenger road vehicle not subject to section 280F and rated at not more than 14,000 pounds gross vehicle weight is an SUV, except the three excluded designs (section 179(b)(5)(B))";
    when four_wheeled_vehicle_designed_to_carry_passengers_on_public_roads(item);
    when vehicle_gross_weight_rating_pounds(item, pounds);
    when pounds <= 14000;
    when not_known(vehicle_subject_to_section_280f(item));
    when not_known(vehicle_seating_more_than_nine_behind_driver(item));
    when not_known(vehicle_with_open_or_capped_cargo_area_six_feet(item));
    when not_known(vehicle_with_integral_enclosure_no_rear_seating(item));
    then sport_utility_vehicle_179(item);
}
pub relation section_179_cost_of_vehicle(p: Person, y: TaxableYear, item: Integer, cost: Money) kind empirical {
    label en official "the cost of a vehicle taken into account under section 179 for the taxable year";
}
pub relation suv_cost_cap_179_for_year(y: TaxableYear, cap: Money) kind institutional {
    label en official "the sport utility vehicle sub-cap for the taxable year: $25,000 (statutory base, not yet indexed under (b)(6))";
}
pub relation suv_cost_taken_into_account_179(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the cost of a sport utility vehicle taken into account: not exceeding the sub-cap (section 179(b)(5)(A))";
}
@source(IRC_S179_B, quote = "The cost of any sport utility vehicle for any taxable year which may be taken into account under this section shall not exceed $25,000.")
rule SuvCostCappedAt25000(p: Person, y: TaxableYear, item: Integer, cost: Money) defeasible {
    label en official "the cost of an SUV taken into account is at most $25,000 (section 179(b)(5)(A)); indexation under (b)(6) is applied through `section_179_indexed_amount` where its facts are supplied";
    when sport_utility_vehicle_179(item);
    when section_179_cost_of_vehicle(p, y, item, cost);
    then suv_cost_taken_into_account_179(p, y, item, min(cost, 25000.00 USD));
}

// --- (b)(6): inflation adjustment ---------------------------------------------------------------------------------------------------------------------------

enum Section179AmountKind {
    DollarLimitation;
    InvestmentThreshold;
    SuvSubCap;
}
pub relation section_179_dollar_amount_to_index(kind: Section179AmountKind, base: Money) kind empirical {
    label en official "a dollar amount of paragraph (1), (2) or (5)(A) in effect before the section 179(b)(6) adjustment (statutory amounts as amended)";
}
pub relation cost_of_living_adjustment_179_base_2017(y: TaxableYear, factor: Decimal) kind empirical {
    label en official "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year in which the taxable year begins, with calendar year 2017 substituted for calendar year 2016 (section 179(b)(6)(A)(ii))";
}
pub relation section_179_indexed_amount(y: TaxableYear, kind: Section179AmountKind, indexed: Money) kind institutional {
    label en official "the amount increased by amount x adjustment for taxable years beginning after 2018, the increase rounded to the nearest multiple of $10,000 ($100 for the paragraph (5)(A) amount) (section 179(b)(6))";
}
@source(IRC_S179_B, quote = "In the case of any taxable year beginning after 2018, the dollar amounts in paragraphs (1), (2), and (5)(A) shall each be increased by an amount equal to")
rule Section179IndexedAmountTenThousandRounding(y: TaxableYear, kind: Section179AmountKind, base: Money, factor: Decimal, begins: Date) strict {
    label en official "the dollar limitation and the investment threshold are increased and rounded to the nearest $10,000 (section 179(b)(6)(A),(B))";
    when taxable_year_begins_on(y, begins);
    when begins > @2018-12-31;
    when section_179_dollar_amount_to_index(kind, base);
    when kind != SuvSubCap;
    when cost_of_living_adjustment_179_base_2017(y, factor);
    then section_179_indexed_amount(y, kind, base + 10000.00 USD * round(base * factor / 10000.00 USD, 0, "HALF_UP"));
}
@source(IRC_S179_B, quote = "($100 in the case of any increase in the amount under paragraph (5)(A))")
rule Section179IndexedAmountSuvHundredRounding(y: TaxableYear, base: Money, factor: Decimal, begins: Date) strict {
    label en official "the sport utility vehicle sub-cap is increased and rounded to the nearest $100 (section 179(b)(6)(B))";
    when taxable_year_begins_on(y, begins);
    when begins > @2018-12-31;
    when section_179_dollar_amount_to_index(SuvSubCap, base);
    when cost_of_living_adjustment_179_base_2017(y, factor);
    then section_179_indexed_amount(y, SuvSubCap, base + 100.00 USD * round(base * factor / 100.00 USD, 0, "HALF_UP"));
}

// --- (d)(6),(7),(8),(9),(10) --------------------------------------------------------------------------------------------------------------------------------------

pub relation component_members_of_controlled_group_179(c1: Person, c2: Person) kind empirical {
    label en official "the corporations are component members of a controlled group (section 1563(a) with more than 50 percent substituted for at least 80 percent) (section 179(d)(6),(7))";
}
pub relation treated_as_one_taxpayer_for_179b(c1: Person, c2: Person) kind institutional {
    label en official "all component members of a controlled group are treated as one taxpayer for subsection (b) (section 179(d)(6)(A))";
}
@source(IRC_S179_D, quote = "(A) all component members of a controlled group shall be treated as one taxpayer, and")
rule ControlledGroupOneTaxpayer(c1: Person, c2: Person) strict {
    label en official "component members of a controlled group are one taxpayer for the section 179(b) limitations (section 179(d)(6)(A))";
    when component_members_of_controlled_group_179(c1, c2);
    then treated_as_one_taxpayer_for_179b(c1, c2);
}
pub relation entity_is_partnership_or_s_corporation_179(pt_entity: Person) kind empirical {
    label en official "the entity is a partnership or an S corporation (section 179(d)(8))";
}
pub relation owner_of_pass_through_entity_179(pt_entity: Person, owner: Person) kind empirical {
    label en official "the person is a partner (or S corporation shareholder) of the entity";
}
pub relation section_179b_limits_apply_to(pt_entity: Person, subject: Person) kind institutional {
    label en official "the limitations of subsection (b) apply to the subject: the partnership (or S corporation) and each partner (or shareholder) (section 179(d)(8))";
}
@source(IRC_S179_D, quote = "In the case of a partnership, the limitations of subsection (b) shall apply with respect to the partnership and with respect to each partner.")
rule LimitsApplyToEntityItself(pt_entity: Person) strict {
    label en official "the limitations apply at the entity level (section 179(d)(8))";
    when entity_is_partnership_or_s_corporation_179(pt_entity);
    then section_179b_limits_apply_to(pt_entity, pt_entity);
}
@source(IRC_S179_D, quote = "A similar rule shall apply in the case of an S corporation and its shareholders.")
rule LimitsApplyToEachOwner(pt_entity: Person, owner: Person) strict {
    label en official "the limitations apply again at each partner or shareholder (section 179(d)(8))";
    when entity_is_partnership_or_s_corporation_179(pt_entity);
    when owner_of_pass_through_entity_179(pt_entity, owner);
    then section_179b_limits_apply_to(pt_entity, owner);
}
pub relation amount_deducted_under_179a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount for which a deduction is allowed under section 179(a)";
}
pub relation credit_allowed_under_section_38_for_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "a credit under section 38 is allowed with respect to the amount";
}
@source(IRC_S179_D, quote = "No credit shall be allowed under section 38 with respect to any amount for which a deduction is allowed under subsection (a).")
rule NoSection38CreditForExpensedAmount(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "no section 38 credit on an amount deducted under section 179(a) (section 179(d)(9))";
    when amount_deducted_under_179a(p, y, amount);
    then not credit_allowed_under_section_38_for_amount(p, y, amount);
}
pub relation section_179_recapture_regulations_prescribed(year: Integer) kind empirical {
    label en official "regulations have been prescribed providing for recapturing the benefit of a section 179(a) deduction for property not used predominantly in a trade or business at any time (section 179(d)(10))";
}
pub relation section_179_recapture_regulation_year_required(year: Integer) kind empirical {
    label en official "a year for which the recapture regulations are required";
}
rule S179PrescribeRecaptureRegulationsDuty defeasible {
    for year: Integer;
    when section_179_recapture_regulation_year_required(year);
    then duty S179dPrescribeRecaptureRegulations {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition section_179_recapture_regulations_prescribed(year);
            window [-infinity, infinity];
        }
    };
}
