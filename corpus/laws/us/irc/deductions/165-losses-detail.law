// Section 165 — losses: stage 2b detail (TECH_GAPS G2792): (b) the basis, (e) the year of theft
// losses, (f) capital losses, (i) the election to deduct disaster losses in the preceding year,
// (j) registration-required obligations, (k) demolition or relocation orders, (l) losses on deposits
// in insolvent financial institutions. Not modelled: (i)(4) Secretary's appraisal guidance and
// (j)(3) regulatory exceptions (external), the amounts allowed by sections 1211/1212 (fact), the
// presidential determination itself (a fact).

// --- (b): the basis for the loss deduction ---------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S165_B,
    IRC_S165_E,
    IRC_S165_F,
    IRC_S165_I,
    IRC_S165_J,
    IRC_S165_K,
    IRC_S165_L,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
    obligation_in_registered_form,
};

pub relation adjusted_basis_under_1011_for_loss(item: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis provided in section 1011 for determining the loss from the sale or other disposition of the property";
}
pub relation basis_for_loss_deduction_165(item: Integer, amount: Money) kind institutional {
    label en official "the basis for determining the amount of the section 165 loss deduction (section 165(b))";
}
@source(IRC_S165_B, quote = "the basis for determining the amount of the deduction for any loss shall be the adjusted basis provided in section 1011")
rule LossDeductionBasisIsAdjustedBasis(item: Integer, amount: Money) strict {
    label en official "the basis for the loss deduction is the adjusted basis under section 1011 for a sale or disposition (section 165(b))";
    when adjusted_basis_under_1011_for_loss(item, amount);
    then basis_for_loss_deduction_165(item, amount);
}

// --- (e): theft losses ---------------------------------------------------------------------------------------

pub relation theft_loss_discovered_in_year(p: Person, item: Integer, discovery_year: TaxableYear) kind empirical {
    label en official "the taxpayer discovers the loss arising from theft in the taxable year (section 165(e))";
}
pub relation loss_treated_as_sustained_in_year(p: Person, item: Integer, y: TaxableYear) kind institutional {
    label en official "the loss is treated as sustained during the taxable year (section 165(a),(e))";
}
@source(IRC_S165_E, quote = "any loss arising from theft shall be treated as sustained during the taxable year in which the taxpayer discovers such loss")
rule TheftLossSustainedWhenDiscovered(p: Person, item: Integer, y: TaxableYear) strict {
    label en official "a theft loss is sustained in the taxable year in which the taxpayer discovers it (section 165(e))";
    when theft_loss_discovered_in_year(p, item, y);
    then loss_treated_as_sustained_in_year(p, item, y);
}

// --- (f): capital losses -----------------------------------------------------------------------------------------

pub relation capital_asset_sale_or_exchange_loss(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a loss from the sale or exchange of a capital asset (section 165(f))";
}
pub relation capital_loss_allowed_under_1211_1212(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the extent to which the capital loss is allowed under sections 1211 and 1212 (owned by the property-transactions package)";
}
pub relation capital_asset_loss_allowed_as_deduction(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the capital asset loss allowed as a deduction, only to the extent allowed in sections 1211 and 1212 (section 165(f))";
}
@source(IRC_S165_F, quote = "Losses from sales or exchanges of capital assets shall be allowed only to the extent allowed in sections 1211 and 1212.")
rule CapitalLossOnlyToExtentOf1211And1212(p: Person, y: TaxableYear, item: Integer, loss: Money, allowed: Money) strict {
    label en official "a capital asset loss is allowed only to the extent allowed by sections 1211 and 1212 (section 165(f))";
    when capital_asset_sale_or_exchange_loss(p, y, item, loss);
    when capital_loss_allowed_under_1211_1212(p, y, item, allowed);
    then capital_asset_loss_allowed_as_deduction(p, y, item, min(loss, allowed));
}

// --- (i),(k): disaster loss election ---------------------------------------------------------------------------------

pub relation disaster_determined_by_president_to_warrant_stafford_assistance(disaster: Integer) kind empirical {
    label en official "the President of the United States has determined that the disaster warrants assistance by the Federal Government under the Robert T. Stafford Disaster Relief and Emergency Assistance Act (section 165(i)(5)(A))";
}
pub relation disaster_area_of_declared_disaster(area: Integer, disaster: Integer) kind empirical {
    label en official "the area so determined to warrant such assistance (section 165(i)(5)(B))";
}
pub relation federally_declared_disaster_165i(disaster: Integer) kind institutional {
    label en official "a federally declared disaster for section 165(i): any disaster subsequently determined by the President to warrant assistance (section 165(i)(5)(A))";
}
@source(IRC_S165_I, quote = "any disaster subsequently determined by the President of the United States to warrant assistance by the Federal Government")
rule FederallyDeclaredDisasterDefinition(disaster: Integer) strict {
    label en official "a disaster determined by the President to warrant Stafford Act assistance is a federally declared disaster (section 165(i)(5)(A))";
    when disaster_determined_by_president_to_warrant_stafford_assistance(disaster);
    then federally_declared_disaster_165i(disaster);
}
pub relation casualty_loss_in_disaster_area_from_declared_disaster(p: Individual, evt: Integer, disaster: Integer, area: Integer) kind empirical {
    label en official "a loss occurring in a disaster area and attributable to a federally declared disaster (section 165(i)(1))";
}
pub relation disaster_loss_election_available(p: Individual, evt: Integer) kind institutional {
    label en official "the loss occurred in a disaster area and is attributable to a federally declared disaster, so it may be taken into account for the preceding taxable year";
}
@source(IRC_S165_I, quote = "any loss occurring in a disaster area and attributable to a federally declared disaster")
rule DisasterLossElectionAvailable(p: Individual, evt: Integer, disaster: Integer, area: Integer) strict {
    label en official "a loss in a disaster area attributable to a federally declared disaster may be elected into the preceding year (section 165(i)(1))";
    when casualty_loss_in_disaster_area_from_declared_disaster(p, evt, disaster, area);
    when disaster_area_of_declared_disaster(area, disaster);
    when federally_declared_disaster_165i(disaster);
    then disaster_loss_election_available(p, evt);
}
pub relation elects_disaster_loss_in_preceding_year(p: Individual, evt: Integer, prior_year: TaxableYear) kind empirical {
    label en official "the taxpayer elects to take the loss into account for the taxable year immediately preceding the year the disaster occurred (section 165(i)(1))";
}
pub relation disaster_loss_taken_in_preceding_year(p: Individual, evt: Integer, prior_year: TaxableYear) kind institutional {
    label en official "the loss is taken into account for the preceding taxable year and the casualty is treated as having occurred in that year (section 165(i)(1),(2))";
}
@source(IRC_S165_I, quote = "may, at the election of the taxpayer, be taken into account for the taxable year immediately preceding the taxable year in which the disaster occurred")
rule S165iPrecedingYearElectionPower(p: Individual, evt: Integer, prior_year: TaxableYear) strict {
    label en official "the taxpayer may elect to take a qualifying disaster loss into account for the preceding taxable year (section 165(i)(1),(2)); an election over a loss that does not qualify has no effect";
    when elects_disaster_loss_in_preceding_year(p, evt, prior_year);
    then power S165iElectPrecedingYearDisasterLoss {
        holder p;
        over evt;
        exercise elects_disaster_loss_in_preceding_year(p, evt, prior_year);
        valid_when disaster_loss_election_available(p, evt);
        effect create(disaster_loss_taken_in_preceding_year(p, evt, prior_year));
        window [-infinity, infinity];
    };
}
pub relation uncompensated_disaster_loss_at_claim_date(p: Individual, evt: Integer, amount: Money) kind empirical {
    label en official "the uncompensated amount determined on the basis of the facts existing at the date the taxpayer claims the loss (section 165(i)(3))";
}
pub relation disaster_loss_claimed_for_preceding_year(p: Individual, evt: Integer, amount: Money) kind empirical {
    label en official "the amount of the loss the taxpayer takes into account in the preceding taxable year";
}
pub relation disaster_loss_amount_within_uncompensated_limit(p: Individual, evt: Integer, amount: Money) kind institutional {
    label en official "the loss taken into account in the preceding year does not exceed the uncompensated amount at the claim date (section 165(i)(3))";
}
@source(IRC_S165_I, quote = "shall not exceed the uncompensated amount determined on the basis of the facts existing at the date the taxpayer claims the loss")
rule DisasterLossAmountLimitedToUncompensated(p: Individual, evt: Integer, claimed: Money, uncompensated: Money) strict {
    label en official "the preceding-year amount is limited to the uncompensated amount at the claim date (section 165(i)(3))";
    when disaster_loss_claimed_for_preceding_year(p, evt, claimed);
    when uncompensated_disaster_loss_at_claim_date(p, evt, uncompensated);
    then disaster_loss_amount_within_uncompensated_limit(p, evt, min(claimed, uncompensated));
}
pub relation determination_date_of_presidential_disaster(disaster: Integer, on: Date) kind empirical {
    label en official "the date of the President's determination that the area warrants Stafford Act assistance (section 165(k))";
}
pub relation residence_in_declared_disaster_area(p: Individual, residence: Integer, disaster: Integer) kind empirical {
    label en official "the taxpayer's residence is located in an area determined to warrant assistance (section 165(k))";
}
pub relation ordered_to_demolish_or_relocate_residence_on(p: Individual, residence: Integer, on: Date) kind empirical {
    label en official "the taxpayer is ordered by the State or a political subdivision to demolish or relocate the residence, on the date (section 165(k)(1))";
}
pub relation residence_rendered_unsafe_by_the_disaster(residence: Integer, disaster: Integer) kind empirical {
    label en official "the residence has been rendered unsafe for use as a residence by reason of the disaster (section 165(k)(2))";
}
pub relation demolition_loss_treated_as_casualty_described_in_165i(p: Individual, residence: Integer, disaster: Integer) kind institutional {
    label en official "any loss attributable to the disaster is treated as a casualty loss described in subsection (i) (section 165(k))";
}
@source(IRC_S165_K, quote = "any loss attributable to such disaster shall be treated as a loss which arises from a casualty and which is described in subsection (i)")
rule DemolitionOrderLossTreatedAsCasualty(p: Individual, residence: Integer, disaster: Integer, determined: Date, ordered: Date) strict {
    label en official "a residence ordered demolished or relocated within 120 days of the determination and rendered unsafe gives a casualty loss described in subsection (i) (section 165(k))";
    when residence_in_declared_disaster_area(p, residence, disaster);
    when determination_date_of_presidential_disaster(disaster, determined);
    when ordered_to_demolish_or_relocate_residence_on(p, residence, ordered);
    when ordered <= add_calendar_period(determined, 120 calendar_day);
    when residence_rendered_unsafe_by_the_disaster(residence, disaster);
    then demolition_loss_treated_as_casualty_described_in_165i(p, residence, disaster);
}

// --- (j): registration-required obligations -----------------------------------------------------------------------------

pub relation loss_on_registration_required_obligation(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a loss sustained on a registration-required obligation (section 163(f)(2)) (section 165(j)(1))";
}
pub relation obligation_issuance_subject_to_tax_under_4701(item: Integer) kind empirical {
    label en official "the issuance of the obligation was subject to tax under section 4701 (section 165(j)(1))";
}
@source(IRC_S165_J, quote = "Nothing in subsection (a) or in any other provision of law shall be construed to provide a deduction for any loss sustained on any registration-required obligation unless such obligation is in registered form")
rule NoLossDeductionOnUnregisteredRegistrationRequiredObligation(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "no deduction for a loss on a registration-required obligation unless in registered form or its issuance was taxed under section 4701 (section 165(j)(1)); registered form is that of section 163(f) (`obligation_in_registered_form`)";
    when loss_on_registration_required_obligation(p, y, item, amount);
    when not_known(obligation_in_registered_form(p, item));
    when not_known(obligation_issuance_subject_to_tax_under_4701(item));
    then not deduction_allowed(p, y, Section165Losses, amount);
}

// --- (l): deposits in insolvent financial institutions -----------------------------------------------------------------------

pub relation owns_one_percent_of_institution_stock(p: Individual, inst: Integer) kind empirical {
    label en official "the individual owns at least 1 percent in value of the outstanding stock of the qualified financial institution (section 165(l)(2)(A))";
}
pub relation officer_of_institution(p: Individual, inst: Integer) kind empirical {
    label en official "the individual is an officer of the qualified financial institution (section 165(l)(2)(B))";
}
pub relation relative_of_owner_or_officer_of_institution(p: Individual, inst: Integer) kind empirical {
    label en official "the individual is a sibling (whole or half blood), spouse, aunt, uncle, nephew, niece, ancestor or lineal descendant of an owner or officer (section 165(l)(2)(C))";
}
pub relation related_person_267b_of_owner_or_officer_of_institution(p: Individual, inst: Integer) kind empirical {
    label en official "the individual otherwise is a related person (section 267(b)) with respect to an owner or officer (section 165(l)(2)(D))";
}
pub relation excluded_from_qualified_individual_for_deposit_loss(p: Individual, inst: Integer) kind institutional {
    label en official "the individual is within an exclusion of section 165(l)(2)(A)-(D)";
}
@source(IRC_S165_L, quote = "(A) who owns at least 1 percent in value of the outstanding stock of the qualified financial institution,")
rule DepositLossExclusionOwner(p: Individual, inst: Integer) strict {
    label en official "a 1-percent owner is not a qualified individual (section 165(l)(2)(A))";
    when owns_one_percent_of_institution_stock(p, inst);
    then excluded_from_qualified_individual_for_deposit_loss(p, inst);
}
@source(IRC_S165_L, quote = "(B) who is an officer of the qualified financial institution,")
rule DepositLossExclusionOfficer(p: Individual, inst: Integer) strict {
    label en official "an officer is not a qualified individual (section 165(l)(2)(B))";
    when officer_of_institution(p, inst);
    then excluded_from_qualified_individual_for_deposit_loss(p, inst);
}
@source(IRC_S165_L, quote = "(C) who is a sibling (whether by the whole or half blood), spouse, aunt, uncle, nephew, niece, ancestor, or lineal descendant of an individual described in subparagraph (A) or (B), or")
rule DepositLossExclusionRelative(p: Individual, inst: Integer) strict {
    label en official "a relative of an owner or officer is not a qualified individual (section 165(l)(2)(C))";
    when relative_of_owner_or_officer_of_institution(p, inst);
    then excluded_from_qualified_individual_for_deposit_loss(p, inst);
}
@source(IRC_S165_L, quote = "(D) who otherwise is a related person (as defined in section 267(b)) with respect to an individual described in subparagraph (A) or (B).")
rule DepositLossExclusionRelatedPerson(p: Individual, inst: Integer) strict {
    label en official "a section 267(b) related person of an owner or officer is not a qualified individual (section 165(l)(2)(D))";
    when related_person_267b_of_owner_or_officer_of_institution(p, inst);
    then excluded_from_qualified_individual_for_deposit_loss(p, inst);
}
pub relation institution_is_bank_581(inst: Integer) kind empirical {
    label en official "a bank as defined in section 581 (section 165(l)(3)(A))";
}
pub relation institution_described_in_591(inst: Integer) kind empirical {
    label en official "an institution described in section 591 (section 165(l)(3)(B))";
}
pub relation institution_is_insured_or_guaranteed_credit_union(inst: Integer) kind empirical {
    label en official "a credit union the deposits or accounts in which are insured under Federal or State law or protected or guaranteed under State law (section 165(l)(3)(C))";
}
pub relation institution_is_similar_chartered_and_supervised(inst: Integer) kind empirical {
    label en official "a similar institution chartered and supervised under Federal or State law (section 165(l)(3)(D))";
}
pub relation qualified_financial_institution(inst: Integer) kind institutional {
    label en official "a qualified financial institution within the meaning of section 165(l)(3)";
}
@source(IRC_S165_L, quote = "(A) any bank (as defined in section 581),")
rule QualifiedInstitutionBank(inst: Integer) strict {
    label en official "a bank (section 581) is a qualified financial institution (section 165(l)(3)(A))";
    when institution_is_bank_581(inst);
    then qualified_financial_institution(inst);
}
@source(IRC_S165_L, quote = "(B) any institution described in section 591,")
rule QualifiedInstitution591(inst: Integer) strict {
    label en official "a section 591 institution is a qualified financial institution (section 165(l)(3)(B))";
    when institution_described_in_591(inst);
    then qualified_financial_institution(inst);
}
@source(IRC_S165_L, quote = "(C) any credit union the deposits or accounts in which are insured under Federal or State law or are protected or guaranteed under State law, or")
rule QualifiedInstitutionCreditUnion(inst: Integer) strict {
    label en official "an insured or guaranteed credit union is a qualified financial institution (section 165(l)(3)(C))";
    when institution_is_insured_or_guaranteed_credit_union(inst);
    then qualified_financial_institution(inst);
}
@source(IRC_S165_L, quote = "(D) any similar institution chartered and supervised under Federal or State law.")
rule QualifiedInstitutionSimilar(inst: Integer) strict {
    label en official "a similar chartered and supervised institution is a qualified financial institution (section 165(l)(3)(D))";
    when institution_is_similar_chartered_and_supervised(inst);
    then qualified_financial_institution(inst);
}
pub relation account_is_deposit_withdrawable_account_or_share(account: Integer) kind empirical {
    label en official "a deposit, withdrawable account, or withdrawable or repurchasable share (section 165(l)(4))";
}
pub relation deposit_165l(account: Integer) kind institutional {
    label en official "a deposit for section 165(l) (section 165(l)(4))";
}
@source(IRC_S165_L, quote = "the term \"deposit\" means any deposit, withdrawable account, or withdrawable or repurchasable share")
rule DepositDefinition165l(account: Integer) strict {
    label en official "a deposit, withdrawable account, or withdrawable or repurchasable share is a deposit (section 165(l)(4))";
    when account_is_deposit_withdrawable_account_or_share(account);
    then deposit_165l(account);
}
pub relation reasonably_estimated_deposit_loss_at_year_end(p: Individual, y: TaxableYear, inst: Integer, amount: Money) kind empirical {
    label en official "as of the close of the taxable year it can reasonably be estimated that there is a loss on the individual's deposit in the institution, in the amount (section 165(l)(1)(A))";
}
pub relation deposit_loss_on_account_of_bankruptcy_or_insolvency(inst: Integer) kind empirical {
    label en official "the loss is on account of the bankruptcy or insolvency of the institution (section 165(l)(1)(B))";
}
pub relation deposit_loss_election_conditions_met(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the conditions of section 165(l)(1): a reasonably estimated loss, on account of the insolvency, of a qualified individual in a qualified financial institution";
}
@source(IRC_S165_L, quote = "then the taxpayer may elect to treat the amount so estimated as a loss described in subsection (c)(3) incurred during the taxable year")
rule DepositLossElectionConditions(p: Individual, y: TaxableYear, inst: Integer, amount: Money) defeasible {
    label en official "a qualified individual with a reasonably estimated loss on a deposit in a qualified financial institution on account of its bankruptcy or insolvency may elect (section 165(l)(1))";
    when reasonably_estimated_deposit_loss_at_year_end(p, y, inst, amount);
    when deposit_loss_on_account_of_bankruptcy_or_insolvency(inst);
    when qualified_financial_institution(inst);
    unless excluded_from_qualified_individual_for_deposit_loss_with_year(p, y, inst);
    then deposit_loss_election_conditions_met(p, y, inst);
}
pub relation excluded_from_qualified_individual_for_deposit_loss_with_year(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "helper: the exclusion of paragraph (2) keyed by year so that the exception binds every head variable";
}
rule DepositLossExclusionKeyedByYear(p: Individual, y: TaxableYear, inst: Integer, amount: Money) strict {
    label en official "helper for the exception";
    when excluded_from_qualified_individual_for_deposit_loss(p, inst);
    when reasonably_estimated_deposit_loss_at_year_end(p, y, inst, amount);
    then excluded_from_qualified_individual_for_deposit_loss_with_year(p, y, inst);
}
pub relation elects_deposit_loss_as_casualty_loss(p: Individual, y: TaxableYear, inst: Integer) kind empirical {
    label en official "the taxpayer elects to treat the estimated amount as a loss described in section 165(c)(3) incurred during the taxable year (section 165(l)(1))";
}
pub relation deposit_loss_treated_as_c3_loss(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the estimated deposit loss is treated as a section 165(c)(3) loss incurred during the taxable year";
}
rule S165lElectionAsCasualtyLossPower(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "the taxpayer may elect to treat the estimated deposit loss as a section 165(c)(3) loss (section 165(l)(1)); an election where the conditions fail has no effect";
    when elects_deposit_loss_as_casualty_loss(p, y, inst);
    then power S165lElectDepositLossAsCasualty {
        holder p;
        over inst;
        exercise elects_deposit_loss_as_casualty_loss(p, y, inst);
        valid_when deposit_loss_election_conditions_met(p, y, inst);
        effect create(deposit_loss_treated_as_c3_loss(p, y, inst));
        window [-infinity, infinity];
    };
}
pub relation elects_deposit_loss_as_ordinary_loss(p: Individual, y: TaxableYear, inst: Integer) kind empirical {
    label en official "in lieu of the paragraph (1) election, the taxpayer elects to treat the amount as an ordinary loss described in section 165(c)(2) (section 165(l)(5)(A))";
}
pub relation deposit_partly_or_wholly_insured_under_federal_law(inst: Integer, p: Individual) kind empirical {
    label en official "part or all of the deposit is insured under Federal law (section 165(l)(5)(B)(i))";
}
pub relation deposit_loss_ordinary_election_available(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the paragraph (5) election is available: the conditions of paragraph (1) hold and no part of the deposit is Federally insured";
}
@source(IRC_S165_L, quote = "No election may be made under subparagraph (A) with respect to any loss on a deposit in a qualified financial institution if part or all of such deposit is insured under Federal law.")
rule DepositLossOrdinaryElectionAvailable(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "the ordinary-loss election is unavailable where the deposit is Federally insured (section 165(l)(5)(B)(i))";
    when deposit_loss_election_conditions_met(p, y, inst);
    when not_known(deposit_partly_or_wholly_insured_under_federal_law(inst, p));
    then deposit_loss_ordinary_election_available(p, y, inst);
}
pub relation deposit_loss_treated_as_ordinary_loss_c2(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the estimated deposit loss is treated as an ordinary loss described in section 165(c)(2) incurred during the taxable year";
}
rule S165lElectionAsOrdinaryLossPower(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "the taxpayer may elect ordinary-loss treatment in lieu of the paragraph (1) election (section 165(l)(5)(A)); an election where unavailable has no effect";
    when elects_deposit_loss_as_ordinary_loss(p, y, inst);
    then power S165lElectDepositLossAsOrdinary {
        holder p;
        over inst;
        exercise elects_deposit_loss_as_ordinary_loss(p, y, inst);
        valid_when deposit_loss_ordinary_election_available(p, y, inst);
        effect create(deposit_loss_treated_as_ordinary_loss_c2(p, y, inst));
        window [-infinity, infinity];
    };
}
pub relation married_filing_separate_return_165l(p: Individual, y: TaxableYear) kind empirical {
    label en official "the return is a separate return by a married individual (section 165(l)(5)(B)(ii))";
}
pub relation state_insurance_proceeds_reasonably_expected(p: Individual, y: TaxableYear, inst: Integer, amount: Money) kind empirical {
    label en official "insurance proceeds under any State law which can reasonably be expected to be received with respect to losses on deposits in the institution (section 165(l)(5)(B)(ii))";
}
pub relation deposit_ordinary_loss_election_dollar_limit(p: Individual, y: TaxableYear, inst: Integer, limit: Money) kind institutional {
    label en official "the aggregate amount of losses per institution to which the paragraph (5) election may be made: $20,000 ($10,000 on a separate return by a married individual) reduced by expected State insurance proceeds (section 165(l)(5)(B)(ii))";
}
@source(IRC_S165_L, quote = "shall not exceed $20,000 ($10,000 in the case of a separate return by a married individual)")
rule DepositOrdinaryElectionLimitGeneral(p: Individual, y: TaxableYear, inst: Integer, proceeds: Money) defeasible {
    label en official "the per-institution limit is $20,000 less expected State insurance proceeds, not below zero (section 165(l)(5)(B)(ii))";
    when state_insurance_proceeds_reasonably_expected(p, y, inst, proceeds);
    when not_known(married_filing_separate_return_165l(p, y));
    then deposit_ordinary_loss_election_dollar_limit(p, y, inst, max(0.00 USD, 20000.00 USD - proceeds));
}
@source(IRC_S165_L, quote = "shall not exceed $20,000 ($10,000 in the case of a separate return by a married individual)")
rule DepositOrdinaryElectionLimitSeparateReturn(p: Individual, y: TaxableYear, inst: Integer, proceeds: Money) defeasible {
    label en official "the per-institution limit is $10,000 less expected State insurance proceeds on a separate return by a married individual (section 165(l)(5)(B)(ii))";
    when married_filing_separate_return_165l(p, y);
    when state_insurance_proceeds_reasonably_expected(p, y, inst, proceeds);
    then deposit_ordinary_loss_election_dollar_limit(p, y, inst, max(0.00 USD, 10000.00 USD - proceeds));
}
pub relation election_applies_to_all_losses_on_deposits_in_institution(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the election applies to all losses for the taxable year on deposits in the institution with respect to which it was made (section 165(l)(6)(A))";
}
@source(IRC_S165_L, quote = "shall apply to all losses for such taxable year of the taxpayer on deposits in the institution with respect to which such election was made")
rule DepositElectionCoversAllLossesInInstitution(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "an election under subsection (l) covers all the year's losses of the taxpayer on deposits in that institution (section 165(l)(6)(A))";
    when elects_deposit_loss_as_casualty_loss(p, y, inst);
    then election_applies_to_all_losses_on_deposits_in_institution(p, y, inst);
}
pub relation secretary_consents_to_revocation_of_deposit_loss_election(p: Individual, y: TaxableYear, inst: Integer) kind empirical {
    label en official "the Secretary consents to revocation of the election (section 165(l)(6)(B))";
}
pub relation deposit_loss_election_revoked(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "the section 165(l) election has been revoked with the Secretary's consent";
}
pub relation taxpayer_revokes_deposit_loss_election(p: Individual, y: TaxableYear, inst: Integer) kind empirical {
    label en official "the taxpayer revokes the section 165(l) election";
}
rule S165lRevocationPower(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "the election may be revoked only with the consent of the Secretary (section 165(l)(6)(B)); a revocation without consent has no effect";
    when taxpayer_revokes_deposit_loss_election(p, y, inst);
    then power S165lRevokeDepositLossElection {
        holder p;
        over inst;
        exercise taxpayer_revokes_deposit_loss_election(p, y, inst);
        valid_when secretary_consents_to_revocation_of_deposit_loss_election(p, y, inst);
        effect create(deposit_loss_election_revoked(p, y, inst));
        window [-infinity, infinity];
    };
}
pub relation section_166_applies_to_deposit_loss(p: Individual, y: TaxableYear, inst: Integer) kind institutional {
    label en official "section 166 (bad debts) applies to the loss on the deposit";
}
@source(IRC_S165_L, quote = "Section 166 shall not apply to any loss to which an election under this subsection applies.")
rule Section166NotAppliedToElectedDepositLoss(p: Individual, y: TaxableYear, inst: Integer) defeasible {
    label en official "section 166 does not apply to a deposit loss for which the section 165(l) election is made (section 165(l)(7))";
    when election_applies_to_all_losses_on_deposits_in_institution(p, y, inst);
    then not section_166_applies_to_deposit_loss(p, y, inst);
}
