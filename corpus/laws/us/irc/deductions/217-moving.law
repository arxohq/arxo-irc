// Section 217 — Moving expenses. Stage 1 (IRC-06), priority section.
// AMENDMENTS.json shows no Pub. L. 119-21 entry for section 217 (only
// sections 163, 164, 165, 168, 170, 172, 179, 199A, 223, 224, 250, 274, 280
// were amended among this package's sections) — the (k) suspension is
// modelled from the pinned 2024-Edition text alone (2018-2025, with the
// statutory sunset on January 1, 2026 intact, not extended or made
// permanent by anything this task's amendment scan found).

use self::{
    DeductionKind,
    IRC_S217_A,
    IRC_S217_K,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation moving_expense_paid(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a reasonable expense of moving household goods/personal effects or of traveling (excluding meals) from the former to the new residence, in connection with the commencement of work at a new principal place of work (section 217(a)-(b))";
}
pub relation armed_forces_member_move_under_orders(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the moving expense is that of a member of the Armed Forces on active duty moving pursuant to a military order and incident to a permanent change of station (section 217(g))";
}

@source(IRC_S217_A, quote = "There shall be allowed as a deduction moving expenses paid or incurred during the taxable year in connection with the commencement of work by the taxpayer as an employee or as a self-employed individual at a new principal place of work")
rule MovingExpenseAllowedOutsideSuspensionWindow(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "moving expenses in connection with commencing work at a new principal place of work are deductible, outside the section 217(k) suspension window (or for an Armed Forces member's move under orders, to which the suspension does not apply)";
    when moving_expense_paid(p, y, item, amount);
    when not_known(section_217k_suspension_applies(p, y, item));
    then deduction_allowed(p, y, Section217Moving, amount);
}
pub relation section_217k_suspension_applies(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 217(k) suspension applies to this moving expense item";
}
@source(IRC_S217_K, quote = "this section shall not apply to any taxable year beginning after December 31, 2017, and before January 1, 2026")
rule SuspensionAppliesDuring2018To2025ExceptArmedForces(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for a taxable year beginning after December 31, 2017 and before January 1, 2026, section 217 does not apply, except to an Armed Forces member's move under orders (section 217(g)) (section 217(k))";
    effective [@2018-01-01, @2026-01-01);
    when moving_expense_paid(p, y, item, amount);
    when not armed_forces_member_move_under_orders(p, y, item);
    then section_217k_suspension_applies(p, y, item);
}
