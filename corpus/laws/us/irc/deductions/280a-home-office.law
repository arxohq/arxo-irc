// Section 280A — Disallowance of certain expenses in connection with
// business use of home, rental of vacation homes, etc. Stage 1 (IRC-06),
// priority section. Scope: (a) general disallowance; (c)(1) the exclusive-
// business-use exception (home office); (c)(5) the gross-income limitation;
// (g) the 15-day rental rule.

use self::{
    DeductionKind,
    IRC_S280A_A,
    IRC_S280A_B,
    IRC_S280A_C,
    IRC_S280A_G,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation dwelling_unit_used_as_residence(p: Person, y: TaxableYear, unit: Integer) kind empirical {
    label en official "a dwelling unit used by the taxpayer during the taxable year as a residence (section 280A(a),(d))";
}
pub relation home_expense_item(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money) kind empirical {
    label en official "an item otherwise allowable as a deduction, with respect to the use of the dwelling unit";
}
pub relation exclusive_regular_principal_place_of_business(p: Person, y: TaxableYear, unit: Integer, item: Integer) kind empirical {
    label en official "the item is allocable to a portion of the dwelling unit exclusively used on a regular basis as the principal place of business for a trade or business of the taxpayer, or (for an employee) for the convenience of the employer (section 280A(c)(1)(A))";
}
pub relation independently_allowable_without_regard_to_business_connection(p: Person, y: TaxableYear, unit: Integer, item: Integer) kind empirical {
    label en official "the item is allowable to the taxpayer without regard to its connection with a trade or business or income-producing activity (e.g. mortgage interest, real estate taxes, casualty losses) (section 280A(b))";
}

@source(IRC_S280A_A, quote = "no deduction otherwise allowable under this chapter shall be allowed with respect to the use of a dwelling unit which is used by the taxpayer during the taxable year as a residence")
rule HomeExpenseDisallowedByDefault(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money) strict {
    label en official "no deduction with respect to home-use expenses, unless section 280A itself provides an exception (section 280A(a))";
    when dwelling_unit_used_as_residence(p, y, unit);
    when home_expense_item(p, y, unit, item, amount);
    when not_known(independently_allowable_without_regard_to_business_connection(p, y, unit, item));
    when not_known(exclusive_regular_principal_place_of_business(p, y, unit, item));
    then not deduction_allowed(p, y, Section280AHomeOffice, amount);
}
@source(IRC_S280A_B, quote = "Subsection (a) shall not apply to any deduction allowable to the taxpayer without regard to its connection with his trade or business")
rule HomeExpenseIndependentlyAllowableExcepted(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money) strict {
    label en official "section 280A(a) does not apply to a deduction independently allowable without regard to its business connection (section 280A(b))";
    when home_expense_item(p, y, unit, item, amount);
    when independently_allowable_without_regard_to_business_connection(p, y, unit, item);
    then deduction_allowed(p, y, Section280AHomeOffice, amount);
}

pub relation home_office_gross_income(p: Person, y: TaxableYear, unit: Integer, amount: Money) kind empirical {
    label en official "gross income derived from the exclusive-business-use portion of the home for the taxable year (section 280A(c)(5))";
}
pub relation home_office_deductions_independent_of_use(p: Person, y: TaxableYear, unit: Integer, amount: Money) kind institutional {
    label en official "deductions allocable to the exclusive-use portion that are allowable whether or not so used, plus deductions allocable to the business/rental activity but not to the use itself (section 280A(c)(5)(B))";
}

@source(IRC_S280A_C, quote = "Subsection (a) shall not apply to any item to the extent such item is allocable to a portion of the dwelling unit which is exclusively used on a regular basis")
rule HomeOfficeExpenseAllowedWithinGrossIncomeLimit(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money, gross: Money, independent: Money) strict {
    label en official "a home-office expense is allowed up to the excess of home-office gross income over other deductions attributable to the use (section 280A(c)(1),(c)(5))";
    when exclusive_regular_principal_place_of_business(p, y, unit, item);
    when home_expense_item(p, y, unit, item, amount);
    when home_office_gross_income(p, y, unit, gross);
    when home_office_deductions_independent_of_use(p, y, unit, independent);
    when amount <= gross - independent;
    then deduction_allowed(p, y, Section280AHomeOffice, amount);
}
@source(IRC_S280A_C, quote = "the deductions allowed under this chapter for the taxable year by reason of being attributed to such use shall not exceed the excess of")
rule HomeOfficeExpenseCappedAtGrossIncomeLimit(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money, gross: Money, independent: Money) strict {
    label en official "a home-office expense exceeding the gross-income limitation is capped at the excess of gross income over independently-allowable/activity-level deductions (section 280A(c)(5))";
    when exclusive_regular_principal_place_of_business(p, y, unit, item);
    when home_expense_item(p, y, unit, item, amount);
    when home_office_gross_income(p, y, unit, gross);
    when home_office_deductions_independent_of_use(p, y, unit, independent);
    when amount > gross - independent;
    when gross - independent > 0.00 USD;
    then deduction_allowed(p, y, Section280AHomeOffice, gross - independent);
}

// --- §280A(g): rental for fewer than 15 days -------------------------------------

pub relation days_actually_rented_in_year(p: Person, y: TaxableYear, unit: Integer, days: Integer) kind empirical {
    label en official "the number of days the dwelling unit is actually rented during the taxable year (section 280A(g))";
}
@source(IRC_S280A_G, quote = "if a dwelling unit is used during the taxable year by the taxpayer as a residence and such dwelling unit is actually rented for less than 15 days during the taxable year")
rule FifteenDayRentalRuleNoDeductionNoIncome(p: Person, y: TaxableYear, unit: Integer, item: Integer, amount: Money, days: Integer) strict {
    label en official "when a residence is rented for fewer than 15 days in the taxable year, no rental-use deduction is allowed for the rental (and, per the same subsection, the rental income is excluded from gross income under section 61 — the income side is gross-income's own rule to state)";
    when dwelling_unit_used_as_residence(p, y, unit);
    when days_actually_rented_in_year(p, y, unit, days);
    when days < 15;
    when home_expense_item(p, y, unit, item, amount);
    then not deduction_allowed(p, y, Section280AHomeOffice, amount);
}
// (c)(2) storage-use, (c)(3) rental use generally, (c)(4) day care, (c)(6)
// rental-to-employer, (d) "use as a residence" definition (personal-use-day
// counting), (e) rental-proration, (f) definitions stay "stage 2".
