// Section 199A — Qualified business income deduction. Stage 1 (IRC-06) and stage 2
// rewrite. Scope: (a) the 20-percent-of-(taxable-income-minus-net-capital-gain)
// overall cap; (b)(1)-(2) the combined QBI amount; (b)(3) the taxable-income phase-in
// of the wage and UBIA limitation; (c) qualified business income and its exclusions;
// (d) qualified trade or business and the specified service trade or business (SSTB)
// phase-out with the applicable percentage; (e) threshold amounts (A3 parameters:
// $157,500/$315,000 statutory in 2018, Rev. Proc. 2024-40 section 2.27 for 2025 and
// Rev. Proc. 2025-32 section 4.26 for 2026), qualified REIT dividends and publicly
// traded partnership income; (g) the deduction of specified agricultural or
// horticultural cooperatives and of their patrons; (i) the minimum deduction added
// by Pub. L. 119-21 section 70105; the phase-in range width $50,000/$100,000 becomes
// $75,000/$150,000 for taxable years after 2025.
// Stage 2 rewrite (26.09.2026): the stage 1/2b rules used the range width as the
// threshold amount and modelled only the joint return; the threshold amount and the
// range width are now separate A3 parameters and every filing status is covered.
// Amounts named by the statute as percentages are exact decimals; the reduction and
// the SSTB scaling are one proportion with one rounding
// (docs/research/constructs/21-expressions-quantities/ item 7); cents HALF_UP is the corpus convention
// where the statute names no rounding (JUDGMENT CALL).

use self::{
    Corporation,
    IRC_S199A_A,
    IRC_S199A_B,
    IRC_S199A_D,
    IRC_S199A_E,
    IRC_S199A_G,
    Individual,
    Person,
    TaxableYear,
};

pub relation qualified_business_income(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "qualified business income with respect to a qualified trade or business: the net amount of qualified items of income, gain, deduction and loss, without the (c)(4) items (section 199A(c)); an asserted amount, the net loss carryover of (c)(2) is not modelled (TECH_GAPS G2773)";
}
pub relation w2_wages_for_business(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "W-2 wages with respect to the trade or business (section 199A(b)(4))";
}
pub relation ubia_for_business(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the unadjusted basis immediately after acquisition of all qualified property of the trade or business (section 199A(b)(2)(B)(ii))";
}
pub relation specified_service_trade_or_business(p: Individual, y: TaxableYear, business: Integer) kind empirical {
    label en official "the trade or business is a specified service trade or business within section 199A(d)(2), or the trade or business of performing services as an employee (section 199A(d)(1))";
}
pub relation taxable_income_for_199a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable income computed without regard to the section 199A deduction (section 199A(e)(1))";
}
pub relation net_capital_gain_199a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "net capital gain, as defined in section 1(h), for the taxable year (section 199A(a)(2)(B)) — dependency contract, producer: unresolved (property-transactions pending)";
}
pub relation qualified_reit_and_ptp_income(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount of qualified REIT dividends and qualified publicly traded partnership income for the taxable year (section 199A(b)(1)(B)); see the (e)(3) and (e)(4) classifiers below";
}

// --- (e)(2): the threshold amount and the range width -----------------------------------

pub relation section_199a_threshold_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the threshold amount of section 199A(e)(2): $157,500 (200 percent of it for a joint return), indexed";
}
@source(IRC_S199A_E, quote = "(200 percent of such amount in the case of a joint return)")
rule ThresholdAmountJointReturn(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the threshold amount of a joint return (A3 parameter, indexed by Revenue Procedures for 2025 and 2026)";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    then section_199a_threshold_amount(p, y, Section199aThresholdAmountJoint);
}
@source(IRC_S199A_E, quote = "The term \"threshold amount\" means $157,500")
rule ThresholdAmountOtherReturn(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the threshold amount of any return other than a joint return (A3 parameter, indexed)";
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::Joint;
    then section_199a_threshold_amount(p, y, Section199aThresholdAmountOther);
}
pub relation section_199a_range_width(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the width of the phase-in range above the threshold amount: $50,000 ($100,000 joint), $75,000 ($150,000 joint) for taxable years beginning after 2025 (sections 199A(b)(3)(B)(ii), (d)(3)(A), Pub. L. 119-21 section 70105(a))";
}
@source(IRC_S199A_B, quote = "the sum of the threshold amount plus $50,000 ($100,000 in the case of a joint return)")
rule RangeWidthJointReturn(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the phase-in range width of a joint return";
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::Joint;
    then section_199a_range_width(p, y, Section199aPhaseInRangeWidthJoint);
}
@source(IRC_S199A_B, quote = "the sum of the threshold amount plus $50,000 ($100,000 in the case of a joint return)")
rule RangeWidthOtherReturn(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "the phase-in range width of any return other than a joint return";
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::Joint;
    then section_199a_range_width(p, y, Section199aPhaseInRangeWidthOther);
}

// --- (d): qualified trade or business; the SSTB applicable fraction -------------------------

pub relation sstb_numerator_199a(p: Individual, y: TaxableYear, business: Integer, numerator: Money) kind institutional {
    label en official "the numerator of the fraction of an SSTB's items taken into account: the range width itself (the whole) where taxable income does not exceed the threshold amount or the business is not an SSTB, or the excess of threshold plus width over taxable income within the range; no numerator at or above the top of the range (section 199A(d)(3)(A)); the applicable percentage is numerator over width";
}
@source(IRC_S199A_D, quote = "any trade or business other than")
rule NonSstbFractionIsWhole(p: Individual, y: TaxableYear, business: Integer, w: Money) strict {
    label en official "a trade or business that is not an SSTB is taken into account in full (section 199A(d)(1))";
    when qualified_business_income(p, y, business, _);
    when not_known(specified_service_trade_or_business(p, y, business));
    when section_199a_range_width(p, y, w);
    then sstb_numerator_199a(p, y, business, w);
}
@source(IRC_S199A_D, quote = "any specified service trade or business of the taxpayer shall not fail to be treated as a qualified trade or business")
rule SstbBelowThresholdFractionIsWhole(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, w: Money) strict {
    label en official "an SSTB is taken into account in full when taxable income does not exceed the threshold amount (section 199A(d)(3)(A)(i))";
    when specified_service_trade_or_business(p, y, business);
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when section_199a_range_width(p, y, w);
    when ti <= t;
    then sstb_numerator_199a(p, y, business, w);
}
@source(IRC_S199A_D, quote = "only the applicable percentage of qualified items of income, gain, deduction, or loss")
rule SstbInRangeFraction(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, w: Money) strict {
    label en official "within the range only the applicable percentage of an SSTB's items is taken into account: 100 percent reduced by the ratio of the excess of taxable income over the threshold to the range width (section 199A(d)(3)(A)(ii),(B))";
    when specified_service_trade_or_business(p, y, business);
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when section_199a_range_width(p, y, w);
    when ti > t;
    when ti < t + w;
    then sstb_numerator_199a(p, y, business, t + w - ti);
}
pub relation qualified_trade_or_business_199a(p: Individual, y: TaxableYear, business: Integer) kind institutional {
    label en official "a qualified trade or business for section 199A purposes: any trade or business other than an SSTB, and an SSTB only while taxable income is below the top of the phase-in range (section 199A(d)(1)-(3))";
}
@source(IRC_S199A_D, quote = "The term \"qualified trade or business\" means any trade or business other than")
rule QualifiedTradeOrBusinessRule(p: Individual, y: TaxableYear, business: Integer, n: Money) strict {
    label en official "a business with a fraction taken into account is a qualified trade or business";
    when sstb_numerator_199a(p, y, business, n);
    when n > 0.00 USD;
    then qualified_trade_or_business_199a(p, y, business);
}
pub relation qbi_taken_into_account_199a(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the qualified business income taken into account: the whole for a non-SSTB, the applicable percentage of it for an SSTB in the range (section 199A(d)(3)(A)(ii))";
}
@source(IRC_S199A_D, quote = "of the taxpayer allocable to such specified service trade or business shall be taken into account")
rule QbiTakenIntoAccountRule(p: Individual, y: TaxableYear, business: Integer, qbi: Money, n: Money, w: Money) strict {
    label en official "QBI times the numerator over the range width, one rounding";
    when qualified_business_income(p, y, business, qbi);
    when sstb_numerator_199a(p, y, business, n);
    when section_199a_range_width(p, y, w);
    then qbi_taken_into_account_199a(p, y, business, div_round(qbi * (n / 1.00 USD), w / 1.00 USD, 2, "HALF_UP"));
}
pub relation wages_taken_into_account_199a(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the W-2 wages taken into account, scaled like the qualified business income of an SSTB (section 199A(d)(3)(A)(ii))";
}
@source(IRC_S199A_D, quote = "of the taxpayer allocable to such specified service trade or business shall be taken into account")
rule WagesTakenIntoAccountRule(p: Individual, y: TaxableYear, business: Integer, wages: Money, n: Money, w: Money) strict {
    label en official "W-2 wages times the numerator over the range width, one rounding";
    when w2_wages_for_business(p, y, business, wages);
    when sstb_numerator_199a(p, y, business, n);
    when section_199a_range_width(p, y, w);
    then wages_taken_into_account_199a(p, y, business, div_round(wages * (n / 1.00 USD), w / 1.00 USD, 2, "HALF_UP"));
}
pub relation ubia_taken_into_account_199a(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the unadjusted basis of qualified property taken into account, scaled like the qualified business income of an SSTB";
}
@source(IRC_S199A_D, quote = "of the taxpayer allocable to such specified service trade or business shall be taken into account")
rule UbiaTakenIntoAccountRule(p: Individual, y: TaxableYear, business: Integer, ubia: Money, n: Money, w: Money) strict {
    label en official "UBIA times the numerator over the range width, one rounding";
    when ubia_for_business(p, y, business, ubia);
    when sstb_numerator_199a(p, y, business, n);
    when section_199a_range_width(p, y, w);
    then ubia_taken_into_account_199a(p, y, business, div_round(ubia * (n / 1.00 USD), w / 1.00 USD, 2, "HALF_UP"));
}

// --- (b)(2),(3): the per-business amount --------------------------------------------------------

pub relation section_199a_para2a_twenty_percent_qbi(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the section 199A(b)(2)(A) amount: 20 percent of qualified business income";
}
@source(IRC_S199A_B, quote = "20 percent of the taxpayer's qualified business income")
rule Section199aPara2aComputation(p: Individual, y: TaxableYear, business: Integer, qbi: Money) strict {
    label en official "20 percent of the qualified business income taken into account (section 199A(b)(2)(A))";
    when qbi_taken_into_account_199a(p, y, business, qbi);
    then section_199a_para2a_twenty_percent_qbi(p, y, business, round(qbi * 0.20, 2, "HALF_UP"));
}
pub relation section_199a_para2b_wage_ubia_limit(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the section 199A(b)(2)(B) amount: the greater of 50 percent of W-2 wages or 25 percent of W-2 wages plus 2.5 percent of UBIA";
}
@source(IRC_S199A_B, quote = "the greater of")
rule Section199aPara2bComputation(p: Individual, y: TaxableYear, business: Integer, wages: Money, ubia: Money) strict {
    label en official "the greater of the two wage and UBIA formulas, over the amounts taken into account (section 199A(b)(2)(B))";
    when wages_taken_into_account_199a(p, y, business, wages);
    when ubia_taken_into_account_199a(p, y, business, ubia);
    then section_199a_para2b_wage_ubia_limit(p, y, business,
        max(round(wages * 0.50, 2, "HALF_UP"), round(wages * 0.25, 2, "HALF_UP") + round(ubia * 0.025, 2, "HALF_UP")));
}
pub relation section_199a_per_business_amount(p: Individual, y: TaxableYear, business: Integer, amount: Money) kind institutional {
    label en official "the section 199A(b)(2) per-business amount, after the (b)(3) phase-in (or its inapplicability below the threshold)";
}
@source(IRC_S199A_B, quote = "In the case of any taxpayer whose taxable income for the taxable year does not exceed the threshold amount, paragraph (2) shall be applied without regard to subparagraph (B)")
rule PerBusinessAmountBelowThreshold(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, para2a: Money) strict {
    label en official "below the threshold amount the wage and UBIA limitation does not apply: the per-business amount is 20 percent of QBI (section 199A(b)(3)(A))";
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when ti <= t;
    when section_199a_para2a_twenty_percent_qbi(p, y, business, para2a);
    then section_199a_per_business_amount(p, y, business, para2a);
}
@source(IRC_S199A_B, quote = "the amount which bears the same ratio to the excess amount as")
rule PerBusinessAmountPhaseInInterpolated(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, w: Money, para2a: Money, para2b: Money) strict {
    label en official "within the range, where the (2)(B) amount is below the (2)(A) amount, the (2)(A) amount is reduced by the excess times the ratio of (taxable income minus threshold) to the range width, one rounding (section 199A(b)(3)(B))";
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when section_199a_range_width(p, y, w);
    when ti > t;
    when ti <= t + w;
    when section_199a_para2a_twenty_percent_qbi(p, y, business, para2a);
    when section_199a_para2b_wage_ubia_limit(p, y, business, para2b);
    when para2b < para2a;
    then section_199a_per_business_amount(p, y, business,
        para2a - div_round((para2a - para2b) * ((ti - t) / 1.00 USD), w / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S199A_B, quote = "is less than the amount determined under paragraph (2)(A)")
rule PerBusinessAmountInRangeWageLimitNotBinding(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, w: Money, para2a: Money, para2b: Money) strict {
    label en official "within the range, when the (2)(B) amount is not below the (2)(A) amount the per-business amount stays at the (2)(A) amount (section 199A(b)(3)(B)(i))";
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when section_199a_range_width(p, y, w);
    when ti > t;
    when ti <= t + w;
    when section_199a_para2a_twenty_percent_qbi(p, y, business, para2a);
    when section_199a_para2b_wage_ubia_limit(p, y, business, para2b);
    when para2b >= para2a;
    then section_199a_per_business_amount(p, y, business, para2a);
}
@source(IRC_S199A_B, quote = "the greater of")
rule PerBusinessAmountAboveRange(p: Individual, y: TaxableYear, business: Integer, ti: Money, t: Money, w: Money, para2a: Money, para2b: Money) strict {
    label en official "above the top of the range the full wage and UBIA limitation applies: the lesser of the (2)(A) and (2)(B) amounts (section 199A(b)(2))";
    when taxable_income_for_199a(p, y, ti);
    when section_199a_threshold_amount(p, y, t);
    when section_199a_range_width(p, y, w);
    when ti > t + w;
    when section_199a_para2a_twenty_percent_qbi(p, y, business, para2a);
    when section_199a_para2b_wage_ubia_limit(p, y, business, para2b);
    then section_199a_per_business_amount(p, y, business, min(para2a, para2b));
}

// --- (e)(3),(e)(4): qualified REIT dividends and publicly traded partnership income ------------

pub relation reit_dividend_received(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a dividend from a real estate investment trust received by the taxpayer";
}
pub relation reit_dividend_is_capital_gain_dividend_or_qualified_dividend_income(p: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend is a capital gain dividend under section 857(b)(3) or qualified dividend income under section 1(h)(11) (section 199A(e)(3)(A),(B))";
}
pub relation reit_dividend_holding_period_not_met_199a(p: Individual, y: TaxableYear, item: Integer) kind empirical {
    label en official "the dividend fails the section 199A(b)(1)(B) holding period rule (stock held more than 45 days in the 91-day window) — asserted; the regulation-based rule is not decomposed (TECH_GAPS G2774)";
}
pub relation qualified_reit_dividend_199a(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a qualified REIT dividend: a REIT dividend that is not a capital gain dividend and not qualified dividend income (section 199A(e)(3))";
}
@source(IRC_S199A_E, quote = "The term \"qualified REIT dividend\" means any dividend from a real estate investment trust")
rule QualifiedReitDividendRule(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a REIT dividend that is neither a capital gain dividend nor qualified dividend income is a qualified REIT dividend (section 199A(e)(3))";
    when reit_dividend_received(p, y, item, amount);
    when not_known(reit_dividend_is_capital_gain_dividend_or_qualified_dividend_income(p, y, item));
    when not_known(reit_dividend_holding_period_not_met_199a(p, y, item));
    then qualified_reit_dividend_199a(p, y, item, amount);
}
pub relation ptp_allocable_share_of_qualified_item_net(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net amount of the taxpayer's allocable share of each qualified item of income, gain, deduction and loss from publicly traded partnerships (section 199A(e)(4)(A)); an asserted net amount (the sum over partnerships is an aggregate over derived amounts)";
}
pub relation ptp_gain_recognized_on_disposition_ordinary(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "gain recognized on disposition of a publicly traded partnership interest treated as ordinary income under section 751 (section 199A(e)(4)(B))";
}
pub relation qualified_ptp_income_199a(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "qualified publicly traded partnership income: the net allocable share (not below zero) plus ordinary gain on disposition of the interest (section 199A(e)(4))";
}
@source(IRC_S199A_E, quote = "The term \"qualified publicly traded partnership income\" means, with respect to any qualified trade or business of a taxpayer, the sum of—")
rule QualifiedPtpIncomeRule(p: Individual, y: TaxableYear, net: Money, gain: Money) strict {
    label en official "the sum of the net allocable share and the ordinary disposition gain (section 199A(e)(4)); a net loss is a reduction of the sum, not carried here (TECH_GAPS G2773)";
    when ptp_allocable_share_of_qualified_item_net(p, y, net);
    when ptp_gain_recognized_on_disposition_ordinary(p, y, gain);
    then qualified_ptp_income_199a(p, y, net + gain);
}

// --- (a): the overall deduction and the (i) minimum ------------------------------------------------

pub relation combined_qbi_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the combined qualified business income amount: the per-business amount plus 20 percent of qualified REIT dividends and PTP income (section 199A(b)(1)); for several businesses the sum of the per-business amounts is asserted directly";
}
@source(IRC_S199A_B, quote = "20 percent of the aggregate amount of the qualified REIT dividends and qualified publicly traded partnership income of the taxpayer for the taxable year")
rule CombinedQbiAmountComputed(p: Individual, y: TaxableYear, business: Integer, per_business: Money, reit_ptp: Money) strict {
    label en official "the per-business amount plus 20 percent of the REIT and PTP income";
    when section_199a_per_business_amount(p, y, business, per_business);
    when qualified_reit_and_ptp_income(p, y, reit_ptp);
    then combined_qbi_amount(p, y, per_business + round(reit_ptp * 0.20, 2, "HALF_UP"));
}
pub relation section_199a_computed_deduction(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 199A(a) deduction before the (i) minimum: the lesser of the combined QBI amount and 20 percent of taxable income in excess of net capital gain";
}
@source(IRC_S199A_A, quote = "the lesser of")
rule QbiDeductionOverallCap(p: Individual, y: TaxableYear, combined: Money, ti: Money, ncg: Money) strict {
    label en official "the combined QBI amount when it does not exceed 20 percent of taxable income over net capital gain (section 199A(a))";
    when combined_qbi_amount(p, y, combined);
    when taxable_income_for_199a(p, y, ti);
    when net_capital_gain_199a(p, y, ncg);
    when combined <= round(max(0.00 USD, ti - ncg) * 0.20, 2, "HALF_UP");
    then section_199a_computed_deduction(p, y, combined);
}
@source(IRC_S199A_A, quote = "an amount equal to 20 percent of the excess (if any) of")
rule QbiDeductionCappedAtTwentyPercentOfTaxableIncomeLessNcg(p: Individual, y: TaxableYear, combined: Money, ti: Money, ncg: Money) strict {
    label en official "20 percent of the excess (if any) of taxable income over net capital gain when that is smaller (section 199A(a)(2))";
    when combined_qbi_amount(p, y, combined);
    when taxable_income_for_199a(p, y, ti);
    when net_capital_gain_199a(p, y, ncg);
    when combined > round(max(0.00 USD, ti - ncg) * 0.20, 2, "HALF_UP");
    then section_199a_computed_deduction(p, y, round(max(0.00 USD, ti - ncg) * 0.20, 2, "HALF_UP"));
}
pub relation minimum_deduction_applies_199a(p: Individual, y: TaxableYear) kind institutional {
    label en official "the taxpayer has at least $1,000 of qualified business income from an active qualified trade or business, so the section 199A(i) minimum deduction of $400 applies (taxable years beginning after December 31, 2025, Pub. L. 119-21 section 70105); 'active' and 'applicable taxpayer' are simplified to the $1,000 floor (TECH_GAPS G2775)";
}
@source(us.irc.temporal::PL119_21_S70105, relation = derives_from, quote = "the deduction allowed under subsection (a) for the taxable year shall be equal to the greater of")
rule MinimumDeductionApplies(p: Individual, y: TaxableYear, business: Integer, qbi: Money) strict {
    label en official "at least $1,000 of qualified business income from a qualified trade or business";
    effective [@2026-01-01, infinity);
    when qualified_trade_or_business_199a(p, y, business);
    when qualified_business_income(p, y, business, qbi);
    when qbi >= 1000.00 USD;
    then minimum_deduction_applies_199a(p, y);
}
@source(us.irc.temporal::PL119_21_S70105, relation = derives_from, quote = "the deduction allowed under subsection (a) for the taxable year shall be equal to the greater of")
rule DeductionWithMinimum(p: Individual, y: TaxableYear, computed: Money) strict {
    label en official "where the minimum applies the deduction is the greater of the computed amount and $400 (Pub. L. 119-21 section 70105)";
    when section_199a_computed_deduction(p, y, computed);
    when minimum_deduction_applies_199a(p, y);
    then us.irc.gross_income::section_199a_deduction(p, y, max(computed, 400.00 USD));
}
@source(IRC_S199A_A, quote = "In the case of a taxpayer other than a corporation, there shall be allowed as a deduction for any taxable year")
rule DeductionWithoutMinimum(p: Individual, y: TaxableYear, computed: Money) strict {
    label en official "otherwise the deduction is the computed amount (section 199A(a))";
    when section_199a_computed_deduction(p, y, computed);
    when not_known(minimum_deduction_applies_199a(p, y));
    then us.irc.gross_income::section_199a_deduction(p, y, computed);
}
// --- (g): specified agricultural or horticultural cooperatives -------------------------------------

pub relation cooperative_qualified_production_activities_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified production activities income of the cooperative: domestic production gross receipts less the cost of goods sold allocable to them and other allocable expenses, losses and deductions (section 199A(g)(3)(A)); an asserted amount, the receipts and allocation rules are not modelled (TECH_GAPS G2776)";
}
pub relation cooperative_taxable_income_before_199a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income of the specified agricultural or horticultural cooperative for the year, without the (g) deduction and, for a cooperative, computed as section 199A(g)(1)(C) directs";
}
pub relation cooperative_w2_wages(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the W-2 wages of the cooperative attributable to domestic production gross receipts (section 199A(g)(1)(B)(ii))";
}
pub relation section_199a_g1_cooperative_deduction(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 199A(g)(1) deduction of a specified agricultural or horticultural cooperative: 9 percent of the lesser of its qualified production activities income and taxable income, limited to 50 percent of its W-2 wages";
}
@source(IRC_S199A_G, quote = "the lesser of")
rule Section199aG1CooperativeDeduction(c: Corporation, y: TaxableYear, qpai: Money, ti: Money, wages: Money) strict {
    label en official "9 percent of the lesser of QPAI and taxable income, not above 50 percent of W-2 wages (section 199A(g)(1)(A),(B))";
    when cooperative_qualified_production_activities_income(c, y, qpai);
    when cooperative_taxable_income_before_199a(c, y, ti);
    when cooperative_w2_wages(c, y, wages);
    then section_199a_g1_cooperative_deduction(c, y, min(round(min(qpai, ti) * 0.09, 2, "HALF_UP"), round(wages * 0.50, 2, "HALF_UP")));
}
pub relation patron_qualified_payment_and_qpai_portion(p: Person, y: TaxableYear, qualified_payment: Money, identified_qpai: Money) kind empirical {
    label en official "a qualified payment received by an eligible taxpayer from a specified agricultural or horticultural cooperative, and the portion of the cooperative's qualified production activities income that it identified in a written notice (section 199A(g)(2)(A),(e))";
}
pub relation patron_taxable_income_before_199a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the patron's taxable income determined without the section 199A(g)(2) deduction";
}
pub relation patron_w2_wages(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the W-2 wages of the patron (section 199A(g)(2)(B))";
}
pub relation section_199a_g2_patron_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 199A(g)(2) deduction of a patron: 9 percent of the least of the identified qualified production activities income portion, its taxable income and, per the (B) limit, 50 percent of its W-2 wages";
}
@source(IRC_S199A_G, quote = "In the case of any eligible taxpayer who receives a qualified payment from a specified agricultural or horticultural cooperative")
rule Section199aG2PatronDeduction(p: Person, y: TaxableYear, payment: Money, qpai: Money, ti: Money, wages: Money) strict {
    label en official "9 percent of the least of the identified QPAI portion and taxable income, not above 50 percent of W-2 wages (section 199A(g)(2)(A),(B)); the patron deduction of a joint owner and the cooperative's own reduction (g)(2)(C) are not modelled";
    when patron_qualified_payment_and_qpai_portion(p, y, payment, qpai);
    when patron_taxable_income_before_199a(p, y, ti);
    when patron_w2_wages(p, y, wages);
    then section_199a_g2_patron_deduction(p, y, min(round(min(qpai, ti) * 0.09, 2, "HALF_UP"), round(wages * 0.50, 2, "HALF_UP")));
}
