// Section 274 — remaining subsections (stage 2): (c) foreign travel, (e) the specific
// exceptions to (a), (h) foreign conventions and cruise ships, (j) employee
// achievement awards, (l) commuting benefits and (m) additional limitations on
// travel. The entertainment rule of (a)(1) in `274-entertainment-meals.law` reads
// `entertainment_exception_applies_274e` (defined here) so that the exceptions gate
// it. Not modelled (TECH_GAPS G2780): (f) interest, taxes and casualty losses (a cross
// rule), (g) allocation, (i) the qualified nonpersonal use vehicle definition, (h)(6)
// the exchange-of-information agreement machinery for North American area
// beneficiary countries, (j)(3)-(4) award definitions beyond the asserted status.

// === (e): the specific exceptions to subsection (a) ====================================

use self::{
    DeductionKind,
    IRC_S274_C,
    IRC_S274_E,
    IRC_S274_H,
    IRC_S274_J,
    IRC_S274_L,
    IRC_S274_M,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation expense_furnished_on_business_premises_primarily_for_employees(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "food and beverages (and facilities) furnished on the business premises primarily for employees (section 274(e)(1))";
}
pub relation expense_treated_as_compensation_and_wages(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenses are treated by the taxpayer as compensation to the employee on its return and as wages for chapter 24 (section 274(e)(2)(A))";
}
pub relation recipient_is_specified_individual(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the recipient is subject (or would be, if the taxpayer or a related party were an issuer) to section 16(a) of the Securities Exchange Act of 1934 (section 274(e)(2)(B)(ii)); the compensation treatment is then limited to the amount reported as compensation, asserted through the first fact";
}
pub relation reimbursed_expense_with_accounting_or_employer_untreated(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "expenses paid in connection with services for another person under a reimbursement or expense allowance arrangement, where the employer has not treated them as compensation (services for an employer) or the taxpayer accounts as subsection (d) provides (services for a non-employer) (section 274(e)(3))";
}
pub relation recreational_expense_primarily_for_employees_not_highly_compensated(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "recreational, social or similar activities primarily for the benefit of employees other than highly compensated employees (section 274(e)(4)); not for purposes of (a)(3)";
}
pub relation expense_directly_related_to_business_meeting_of_employees_stockholders_agents_directors(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "expenses directly related to business meetings of employees, stockholders, agents or directors (section 274(e)(5))";
}
pub relation expense_for_business_league_meeting_or_convention(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "expenses directly related and necessary to attendance at a business meeting or convention of a section 501(c)(6) organization (section 274(e)(6))";
}
pub relation goods_services_facilities_made_available_to_general_public(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "goods, services and facilities made available by the taxpayer to the general public (section 274(e)(7))";
}
pub relation entertainment_sold_to_customers_for_adequate_consideration(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "goods or services sold by the taxpayer in a bona fide transaction for adequate and full consideration (section 274(e)(8))";
}
pub relation expense_includible_in_income_of_non_employee_recipient(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "expenses includible in the gross income of a non-employee recipient as compensation or a prize or award under section 74 (section 274(e)(9))";
}
pub relation information_return_required_but_amount_not_included(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amount is required to be included (or would be, but for being under $600) in an information return under part III of subchapter A of chapter 61 and is not so included (section 274(e)(9) second sentence)";
}
pub relation entertainment_exception_applies_274e(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "one of the specific exceptions of section 274(e) applies to the item, so subsection (a) does not";
}
@source(IRC_S274_E, quote = "Expenses for food and beverages (and facilities used in connection therewith) furnished on the business premises of the taxpayer primarily for his employees.")
rule Exception274e1EmployeeFood(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "employee food on the business premises (section 274(e)(1))";
    when expense_furnished_on_business_premises_primarily_for_employees(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "expenses for goods, services, and facilities, to the extent that the expenses are treated by the taxpayer, with respect to the recipient of the entertainment, amusement, or recreation, as compensation to an employee")
rule Exception274e2Compensation(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "expenses treated as compensation and wages (section 274(e)(2)(A)); for a specified individual the exception is limited to the amount reported (the reported amount is asserted through the fact)";
    when expense_treated_as_compensation_and_wages(p, y, item);
    when not_known(recipient_is_specified_individual(p, y, item));
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses paid or incurred by the taxpayer, in connection with the performance by him of services for another person")
rule Exception274e3Reimbursed(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "reimbursed expenses, where the employer has not treated them as compensation or the taxpayer accounts (section 274(e)(3))";
    when reimbursed_expense_with_accounting_or_employer_untreated(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses for recreational, social, or similar activities (including facilities therefor) primarily for the benefit of employees")
rule Exception274e4Recreational(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "recreational activities for the rank and file (section 274(e)(4)); highly compensated employees are the asserted exclusion";
    when recreational_expense_primarily_for_employees_not_highly_compensated(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses incurred by a taxpayer which are directly related to business meetings of his employees, stockholders, agents, or directors.")
rule Exception274e5BusinessMeetings(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "business meetings of employees, stockholders, agents or directors (section 274(e)(5))";
    when expense_directly_related_to_business_meeting_of_employees_stockholders_agents_directors(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses directly related and necessary to attendance at a business meeting or convention of any organization described in section 501(c)(6)")
rule Exception274e6BusinessLeague(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "meetings of business leagues and chambers of commerce (section 274(e)(6))";
    when expense_for_business_league_meeting_or_convention(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses for goods, services, and facilities made available by the taxpayer to the general public.")
rule Exception274e7PublicItems(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "items available to the public (section 274(e)(7))";
    when goods_services_facilities_made_available_to_general_public(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "Expenses for goods or services (including the use of facilities) which are sold by the taxpayer in a bona fide transaction for an adequate and full consideration in money or money's worth.")
rule Exception274e8SoldToCustomers(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "entertainment sold to customers (section 274(e)(8))";
    when entertainment_sold_to_customers_for_adequate_consideration(p, y, item);
    then entertainment_exception_applies_274e(p, y, item);
}
@source(IRC_S274_E, quote = "to the extent that the expenses are includible in the gross income of a recipient of the entertainment, amusement, or recreation who is not an employee of the taxpayer")
rule Exception274e9IncludibleInIncome(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "expenses includible in the income of a non-employee recipient, unless required to be reported on an information return and not reported (section 274(e)(9))";
    when expense_includible_in_income_of_non_employee_recipient(p, y, item);
    when not_known(information_return_required_but_amount_not_included(p, y, item));
    when not_known(recipient_is_specified_individual(p, y, item));
    then entertainment_exception_applies_274e(p, y, item);
}

// === (c): certain foreign travel ==========================================================

pub relation foreign_travel_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "expenses of travel outside the United States away from home in pursuit of a trade or business or a section 212 activity, otherwise allowable under section 162 or 212 (section 274(c)(1)); travel from one point in the United States to another is excluded (section 274(c)(3))";
}
pub relation foreign_travel_total_days(p: Person, y: TaxableYear, item: Integer, days: Integer) kind empirical {
    label en official "the total time of travel outside the United States away from home, in days";
}
pub relation foreign_travel_business_days(p: Person, y: TaxableYear, item: Integer, days: Integer) kind empirical {
    label en official "the time of the travel attributable to the pursuit of the taxpayer's trade or business or section 212 activity, in days";
}
pub relation foreign_travel_portion_not_allocable(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the portion of the expenses not allocable to the business or activity, for which no deduction is allowed: the expenses times the non-business days over the total days";
}
@source(IRC_S274_C, quote = "no deduction shall be allowed under section 162 or section 212 for that portion of the expenses of such travel otherwise allowable under such section which, under regulations prescribed by the Secretary, is not allocable to such trade or business or to such activity.")
rule ForeignTravelNonAllocablePortion(p: Person, y: TaxableYear, item: Integer, amount: Money, total: Integer, business: Integer) strict {
    label en official "for travel over one week where the non-business time is 25 percent or more of the total, the non-business share of the expenses is disallowed; the allocation by days stands for the regulations (JUDGMENT CALL) (section 274(c)(1),(2))";
    when foreign_travel_expense(p, y, item, amount);
    when foreign_travel_total_days(p, y, item, total);
    when foreign_travel_business_days(p, y, item, business);
    when total > 7;
    when (total - business) * 4 >= total;
    then foreign_travel_portion_not_allocable(p, y, item, amount - div_round(amount * business, total * 1.0, 2, "HALF_UP"));
}
@source(IRC_S274_C, quote = "no deduction shall be allowed under section 162 or section 212")
rule ForeignTravelNonAllocableNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the non-allocable portion is not an allowed deduction";
    when foreign_travel_portion_not_allocable(p, y, item, amount);
    then not deduction_allowed(p, y, Section274CForeignTravel, amount);
}

// === (h): foreign conventions and cruise ships ============================================

pub relation convention_seminar_or_meeting_held_outside_north_american_area(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "expenses of attending a convention, seminar or similar meeting held outside the North American area (the United States, its possessions, Canada, Mexico and qualifying Caribbean, Bermuda beneficiary countries) (section 274(h)(1),(3)(A),(6))";
}
external judgment relation reasonable_for_meeting_to_be_held_outside_north_american_area(p: Person, y: TaxableYear, item: Integer) {
    authority TaxCourt;
    label en official "as reasonable for the meeting to be held outside the North American area as within it, having regard to the purpose of the meeting, the sponsoring organization, the residences of its members and other relevant factors (section 274(h)(1))";
}
@source(IRC_S274_H, quote = "it is as reasonable for the meeting to be held outside the North American area as within the North American area.")
rule ForeignConventionExpensesDeductibleWhenReasonable(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "expenses of a foreign convention are deductible where the taxpayer establishes it is as reasonable to hold it abroad; where the judgment is absent the question is open (DECISION-0194)";
    when convention_seminar_or_meeting_held_outside_north_american_area(p, y, item, amount);
    when reasonable_for_meeting_to_be_held_outside_north_american_area(p, y, item);
    then convention_abroad_expense_deductible_274h(p, y, item, amount);
}
pub relation convention_abroad_expense_deductible_274h(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the expenses of a convention outside the North American area are not disallowed by section 274(h)(1)";
}
pub relation cruise_ship_convention_expenses(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "expenses of attending conventions, seminars or meetings held on a cruise ship for the individual in the calendar year (section 274(h)(2))";
}
pub relation cruise_convention_directly_related_and_statements_attached(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer establishes that the meeting is directly related to the active conduct of the trade or business and attaches to the return the signed statements of the attendee and of an officer of the sponsoring organization (section 274(h)(2),(5))";
}
pub relation cruise_ship_registered_in_united_states_with_all_ports_in_united_states_or_possessions(p: Person, y: TaxableYear) kind empirical {
    label en official "the cruise ship is a vessel registered in the United States and all its ports of call are located in the United States or its possessions (section 274(h)(2)(A),(B))";
}
pub relation cruise_ship_convention_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductible expenses of cruise ship conventions: none for a ship not meeting the conditions, otherwise not more than $2,000 per individual for cruises beginning in a calendar year";
}
@source(IRC_S274_H, quote = "not more than $2,000 of the expenses attributable to an individual attending one or more meetings")
rule CruiseShipConventionLimit(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "a qualifying US-registered ship with the (5) reporting: $2,000 per individual per calendar year (section 274(h)(2),(5))";
    when cruise_ship_convention_expenses(p, y, amount);
    when cruise_ship_registered_in_united_states_with_all_ports_in_united_states_or_possessions(p, y);
    when cruise_convention_directly_related_and_statements_attached(p, y);
    then cruise_ship_convention_deduction(p, y, min(amount, 2000.00 USD));
}
@source(IRC_S274_H, quote = "In the case of any individual who attends a convention, seminar, or other meeting which is held on any cruise ship")
rule CruiseShipConventionNotQualifyingShip(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "a cruise ship that is not US-registered, calls at foreign ports, or a meeting without the (5) reporting gives no deduction (section 274(h)(2),(5))";
    when cruise_ship_convention_expenses(p, y, amount);
    when not_known(cruise_convention_directly_related_and_statements_attached(p, y));
    then cruise_ship_convention_deduction(p, y, 0.00 USD);
}

// === (j): employee achievement awards ==========================================================

pub relation achievement_award_costs_to_employee(p: Person, y: TaxableYear, employee: Integer, nonqualified_awards: Money, qualified_plan_awards: Money) kind empirical {
    label en official "the cost to the employer during the taxable year of the employee achievement awards made to the employee that are not qualified plan awards, and of those that are (section 274(j)(2)); tangible personal property for length of service or safety achievement (not cash, vacations, meals, securities), awarded in a meaningful presentation without disguised compensation (section 274(j)(3)(A)), asserted";
}
pub relation achievement_award_deduction(p: Person, y: TaxableYear, employee: Integer, amount: Money) kind institutional {
    label en official "the deduction for the cost of the awards: non-qualified awards at most $400 and all awards at most $1,600 when qualified plan awards are made";
}
@source(IRC_S274_J, quote = "shall not exceed $400, and")
rule AchievementAwardDeductionLimits(p: Person, y: TaxableYear, employee: Integer, nq: Money, q: Money) strict {
    label en official "the non-qualified awards are limited to $400 and, with the qualified plan awards, the total to $1,600 (section 274(j)(2)); qualified plan status (written non-discriminating plan, average cost at most $400) is asserted";
    when achievement_award_costs_to_employee(p, y, employee, nq, q);
    then achievement_award_deduction(p, y, employee, min(min(nq, 400.00 USD) + q, 1600.00 USD));
}

// === (l): transportation and commuting benefits ===================================================

pub relation commuting_transportation_expense_for_employee(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expense incurred for providing transportation, or a payment or reimbursement, to an employee in connection with travel between residence and place of employment (section 274(l)(1))";
}
pub relation commuting_expense_necessary_for_employee_safety(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the transportation is necessary for ensuring the safety of the employee (section 274(l)(1))";
}
pub relation qualified_bicycle_commuting_reimbursement(p: Person, y: TaxableYear, item: Integer, paid_on: Date) kind empirical {
    label en official "a qualified bicycle commuting reimbursement (section 132(f)(5)(F)) paid on the stated date (section 274(l)(2))";
}
@source(IRC_S274_L, quote = "No deduction shall be allowed under this chapter for any expense incurred for providing any transportation, or any payment or reimbursement, to an employee of the taxpayer in connection with travel between the employee's residence and place of employment, except as necessary for ensuring the safety of the employee.")
rule CommutingExpenseNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for commuting transportation benefits, except for employee safety and (for 2018-2025) qualified bicycle reimbursements";
    when commuting_transportation_expense_for_employee(p, y, item, amount);
    when not_known(commuting_expense_necessary_for_employee_safety(p, y, item));
    when not_known(bicycle_reimbursement_exception_applies_274l2(p, y, item));
    then not deduction_allowed(p, y, Section274LCommuting, amount);
}
pub relation bicycle_reimbursement_exception_applies_274l2(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the section 274(l)(2) exception applies: a qualified bicycle commuting reimbursement paid after December 31, 2017 and before January 1, 2026";
}
@source(IRC_S274_L, quote = "this subsection shall not apply for any amounts paid or incurred after December 31, 2017, and before January 1, 2026.")
rule BicycleReimbursementException(p: Person, y: TaxableYear, item: Integer, paid_on: Date) strict {
    label en official "a qualified bicycle commuting reimbursement paid in the window is outside the denial";
    when qualified_bicycle_commuting_reimbursement(p, y, item, paid_on);
    when paid_on > @2017-12-31;
    when paid_on < @2026-01-01;
    then bicycle_reimbursement_exception_applies_274l2(p, y, item);
}

// === (m): additional limitations on travel expenses ==================================================

pub relation water_transportation_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "expenses incurred for transportation by water (section 274(m)(1))";
}
pub relation water_transportation_days_and_per_diem(p: Person, y: TaxableYear, item: Integer, days: Integer, per_diem: Money) kind empirical {
    label en official "the days of the transportation and the highest per diem amount generally allowable to executive branch employees for travel within the United States (section 274(m)(1)(A))";
}
pub relation water_transportation_within_274m1b_exception(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expense is allocable to a convention, seminar or meeting held on a cruise ship, or is an expense described in section 274(e)(2),(3),(4),(7),(8) or (9) (section 274(m)(1)(B))";
}
pub relation water_transportation_excess_nondeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the expenses above twice the aggregate per diem amounts for the days of transportation, for which no deduction is allowed";
}
@source(IRC_S274_M, quote = "No deduction shall be allowed under this chapter for expenses incurred for transportation by water to the extent such expenses exceed twice the aggregate per diem amounts for days of such transportation.")
rule LuxuryWaterTransportationExcess(p: Person, y: TaxableYear, item: Integer, amount: Money, days: Integer, per_diem: Money) strict {
    label en official "the excess over twice the per diem times the days is not deductible (section 274(m)(1)(A))";
    when water_transportation_expense(p, y, item, amount);
    when water_transportation_days_and_per_diem(p, y, item, days, per_diem);
    when not_known(water_transportation_within_274m1b_exception(p, y, item));
    when amount > per_diem * days * 2;
    then water_transportation_excess_nondeductible(p, y, item, amount - per_diem * days * 2);
}
@source(IRC_S274_M, quote = "No deduction shall be allowed under this chapter for expenses incurred for transportation by water")
rule LuxuryWaterTransportationNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the excess is not an allowed deduction";
    when water_transportation_excess_nondeductible(p, y, item, amount);
    then not deduction_allowed(p, y, Section274MLuxuryWater, amount);
}
pub relation travel_as_a_form_of_education_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "expenses for travel as a form of education (section 274(m)(2))";
}
@source(IRC_S274_M, quote = "No deduction shall be allowed under this chapter for expenses for travel as a form of education.")
rule TravelAsEducationNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for travel as a form of education (section 274(m)(2))";
    when travel_as_a_form_of_education_expense(p, y, item, amount);
    then not deduction_allowed(p, y, Section274MTravelEducation, amount);
}
pub relation accompanying_person_travel_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "travel expenses paid or incurred for a spouse, dependent or other individual accompanying the taxpayer (or an officer or employee) on business travel (section 274(m)(3))";
}
pub relation accompanying_person_is_employee_with_bona_fide_business_purpose_and_deductible(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the accompanying person is an employee of the taxpayer, the travel is for a bona fide business purpose and the expenses would otherwise be deductible by that person (section 274(m)(3)(A)-(C))";
}
@source(IRC_S274_M, quote = "for travel expenses paid or incurred with respect to a spouse, dependent, or other individual accompanying the taxpayer")
rule AccompanyingPersonTravelNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for the travel of an accompanying person unless the three conditions are all met (section 274(m)(3))";
    when accompanying_person_travel_expense(p, y, item, amount);
    when not_known(accompanying_person_is_employee_with_bona_fide_business_purpose_and_deductible(p, y, item));
    then not deduction_allowed(p, y, Section274MAccompanyingPerson, amount);
}
