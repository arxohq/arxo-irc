// Sections 269, 269A, 269B (anti-avoidance powers of the Secretary and stapled
// entities) and 271-281 (part IX disallowances: political party debts, coal and iron
// ore contracts, life-tenant shrinkage, taxes, political events, social clubs,
// corporate acquisition indebtedness, terminal railroad corporations). Stage 2.
// Sections 274 (separate module) and 278, 280 (repealed) are not touched here.
// Deontics: sections 269 and 269A are POWERS of the Secretary (`holder Secretary`,
// `valid_when` the statutory conditions, `effect` the disallowance or allocation,
// E-0239: an invalid exercise has no effect); the principal-purpose tests are
// evaluative (DECISION-0194, `external judgment relation` with the court as
// authority). The part IX denials are classifications whose conclusion is
// `not deduction_allowed(...)` under a kind of their own.

// === §269: acquisitions made to evade or avoid income tax ===================================

use self::{
    Corporation,
    DeductionKind,
    IRC_S269A_A,
    IRC_S269A_B,
    IRC_S269B_A,
    IRC_S269B_C,
    IRC_S269B_E,
    IRC_S269_A,
    IRC_S269_B,
    IRC_S269_C,
    IRC_S271_A,
    IRC_S271_C,
    IRC_S272,
    IRC_S273,
    IRC_S275_A,
    IRC_S276_A,
    IRC_S277_A,
    IRC_S279_A,
    IRC_S279_B,
    IRC_S279_D,
    IRC_S281_A,
    Person,
    TaxableYear,
    adjusted_total_assets_279,
    adjusted_total_indebtedness_279,
    deduction_allowed,
};

pub relation person_or_persons_acquire_control_of_corporation(benefit: Integer) kind empirical {
    label en official "any person or persons acquire, directly or indirectly, control of a corporation: ownership of stock possessing at least 50 percent of the total combined voting power or at least 50 percent of the total value of all classes (section 269(a)(1))";
}
pub relation corporation_acquires_property_with_carryover_basis_from_uncontrolled_corporation(benefit: Integer) kind empirical {
    label en official "a corporation acquires property of another corporation not controlled, immediately before the acquisition, by the acquirer or its stockholders, the basis of which in the acquirer's hands is determined by reference to the transferor's basis (section 269(a)(2))";
}
pub relation qualified_stock_purchase_without_338_election_then_liquidation_within_two_years(benefit: Integer) kind empirical {
    label en official "there is a qualified stock purchase of a corporation, no section 338 election is made, and the acquired corporation is liquidated under a plan adopted not more than 2 years after the acquisition date (section 269(b)(1)(A)-(C))";
}
external judgment relation principal_purpose_is_evasion_or_avoidance_of_income_tax(benefit: Integer) {
    authority TaxCourt;
    label en official "the principal purpose for the acquisition (or for the liquidation) is evasion or avoidance of Federal income tax by securing the benefit of a deduction, credit or other allowance which the person or corporation would not otherwise enjoy (section 269(a),(b)(1)(D))";
}
pub relation section_269_applies(benefit: Integer) kind institutional {
    label en official "section 269(a) or (b) applies to the deduction, credit or other allowance";
}
@source(IRC_S269_A, quote = "any person or persons acquire, directly or indirectly, control of a corporation, or")
rule Section269AppliesControlAcquisition(benefit: Integer) strict {
    label en official "an acquisition of control with the principal purpose of tax avoidance brings section 269 into play (section 269(a)(1))";
    when person_or_persons_acquire_control_of_corporation(benefit);
    when principal_purpose_is_evasion_or_avoidance_of_income_tax(benefit);
    then section_269_applies(benefit);
}
@source(IRC_S269_A, quote = "any corporation acquires, directly or indirectly, property of another corporation, not controlled, directly or indirectly, immediately before such acquisition, by such acquiring corporation or its stockholders")
rule Section269AppliesPropertyAcquisition(benefit: Integer) strict {
    label en official "a carryover-basis acquisition of property from an uncontrolled corporation with the principal purpose of tax avoidance brings section 269 into play (section 269(a)(2))";
    when corporation_acquires_property_with_carryover_basis_from_uncontrolled_corporation(benefit);
    when principal_purpose_is_evasion_or_avoidance_of_income_tax(benefit);
    then section_269_applies(benefit);
}
@source(IRC_S269_B, quote = "there is a qualified stock purchase by a corporation of another corporation,")
rule Section269AppliesLiquidationAfterQualifiedStockPurchase(benefit: Integer) strict {
    label en official "a liquidation within 2 years of a qualified stock purchase without a section 338 election, with the principal purpose of tax avoidance, brings section 269 into play (section 269(b))";
    when qualified_stock_purchase_without_338_election_then_liquidation_within_two_years(benefit);
    when principal_purpose_is_evasion_or_avoidance_of_income_tax(benefit);
    then section_269_applies(benefit);
}
pub relation secretary_disallows_benefit_under_269(benefit: Integer) kind empirical {
    label en official "the Secretary disallows the deduction, credit or other allowance (section 269(a),(b))";
}
pub relation benefit_disallowed_under_269(benefit: Integer) kind institutional {
    label en official "the deduction, credit or other allowance is disallowed by the Secretary under section 269";
}
@source(IRC_S269_A, quote = "then the Secretary may disallow such deduction, credit, or other allowance.")
rule Section269DisallowancePowerRule(benefit: Integer) strict {
    label en official "the Secretary has the power to disallow the deduction, credit or other allowance where section 269 applies (section 269(a),(b)); an exercise where the conditions do not hold has no effect";
    when secretary_disallows_benefit_under_269(benefit);
    then power Section269Disallowance {
        holder us.irc.core::Secretary;
        over benefit;
        exercise secretary_disallows_benefit_under_269(benefit);
        valid_when section_269_applies(benefit);
        effect create(benefit_disallowed_under_269(benefit));
        window [@1943-01-01, infinity);
    };
}
pub relation secretary_allows_part_under_269c(benefit: Integer) kind empirical {
    label en official "the Secretary allows part of an amount disallowed, or distributes, apportions or allocates income and the benefits among the corporations or properties involved (section 269(c)(1)-(3))";
}
pub relation part_of_disallowed_benefit_allowed_under_269c(benefit: Integer) kind institutional {
    label en official "the Secretary has allowed part of the disallowed benefit or allocated it, to the extent that no evasion or avoidance results";
}
@source(IRC_S269_C, quote = "In any case to which subsection (a) or (b) applies the Secretary is authorized—")
rule Section269cPartialAllowancePowerRule(benefit: Integer) strict {
    label en official "in a case to which section 269(a) or (b) applies the Secretary has the power to allow part of the disallowed amount or to apportion and allocate the benefits (section 269(c))";
    when secretary_allows_part_under_269c(benefit);
    then power Section269cPartialAllowance {
        holder us.irc.core::Secretary;
        over benefit;
        exercise secretary_allows_part_under_269c(benefit);
        valid_when section_269_applies(benefit);
        effect create(part_of_disallowed_benefit_allowed_under_269c(benefit));
        window [@1943-01-01, infinity);
    };
}

// === §269A: personal service corporations formed to avoid tax ===================================

pub relation corporation_principal_activity_is_personal_services_performed_by_employee_owners(corp: Integer) kind empirical {
    label en official "the corporation's principal activity is the performance of personal services and they are substantially performed by employee-owners (section 269A(b)(1))";
}
pub relation substantially_all_services_performed_for_one_other_entity(corp: Integer) kind empirical {
    label en official "substantially all of the services of the personal service corporation are performed for or on behalf of 1 other corporation, partnership or other entity, related persons under section 144(a)(3) counted as one (section 269A(a)(1),(b)(3))";
}
pub relation owner_employee_percentage_of_stock(corp: Integer, employee: Integer, percent: Decimal) kind empirical {
    label en official "the percentage of the outstanding stock the employee owns on any day of the year, applying section 318 with 5 percent substituted for 50 percent in section 318(a)(2)(C) (section 269A(b)(2))";
}
pub relation employee_owner_269a(corp: Integer, employee: Integer) kind institutional {
    label en official "the employee owns more than 10 percent of the outstanding stock of the personal service corporation (section 269A(b)(2))";
}
@source(IRC_S269A_B, quote = "The term \"employee-owner\" means any employee who owns, on any day during the taxable year, more than 10 percent of the outstanding stock of the personal service corporation.")
rule EmployeeOwnerRule(corp: Integer, employee: Integer, percent: Decimal) strict {
    label en official "an employee owning more than 10 percent on any day is an employee-owner (section 269A(b)(2))";
    when owner_employee_percentage_of_stock(corp, employee, percent);
    when percent > 10.0;
    then employee_owner_269a(corp, employee);
}
external judgment relation principal_purpose_of_forming_or_using_personal_service_corporation_is_tax_avoidance(corp: Integer) {
    authority TaxCourt;
    label en official "the principal purpose for forming, or availing of, the personal service corporation is the avoidance or evasion of Federal income tax by reducing the income of, or securing the benefit of an expense, deduction, credit, exclusion or other allowance for, an employee-owner which would not otherwise be available (section 269A(a)(2))";
}
pub relation section_269a_applies(corp: Integer) kind institutional {
    label en official "section 269A(a) applies to the personal service corporation";
}
@source(IRC_S269A_A, quote = "substantially all of the services of a personal service corporation are performed for (or on behalf of) 1 other corporation, partnership, or other entity, and")
rule Section269aAppliesRule(corp: Integer, employee: Integer) strict {
    label en official "a personal service corporation working substantially for one entity, with a tax-avoidance principal purpose and an employee-owner, is within section 269A(a)";
    when corporation_principal_activity_is_personal_services_performed_by_employee_owners(corp);
    when substantially_all_services_performed_for_one_other_entity(corp);
    when employee_owner_269a(corp, employee);
    when principal_purpose_of_forming_or_using_personal_service_corporation_is_tax_avoidance(corp);
    then section_269a_applies(corp);
}
pub relation secretary_allocates_between_psc_and_employee_owners(corp: Integer) kind empirical {
    label en official "the Secretary allocates all income, deductions, credits, exclusions and other allowances between the personal service corporation and its employee-owners (section 269A(a))";
}
pub relation psc_allocation_made_269a(corp: Integer) kind institutional {
    label en official "the allocation is made, because it is necessary to prevent avoidance or evasion or clearly to reflect income";
}
@source(IRC_S269A_A, quote = "then the Secretary may allocate all income, deductions, credits, exclusions, and other allowances between such personal service corporation and its employee-owners")
rule Section269aAllocationPowerRule(corp: Integer) strict {
    label en official "the Secretary has the power to allocate items between a personal service corporation and its employee-owners where section 269A(a) applies (whether the allocation is necessary to prevent avoidance or clearly to reflect income is left to the exercise)";
    when secretary_allocates_between_psc_and_employee_owners(corp);
    then power Section269aAllocation {
        holder us.irc.core::Secretary;
        over corp;
        exercise secretary_allocates_between_psc_and_employee_owners(corp);
        valid_when section_269a_applies(corp);
        effect create(psc_allocation_made_269a(corp));
        window [@1982-09-04, infinity);
    };
}

// === §269B: stapled entities =================================================================

pub relation percent_value_of_beneficial_ownership_consisting_of_stapled_interests(ent: Integer, percent: Decimal) kind empirical {
    label en official "the percentage in value of the beneficial ownership in the entity that consists of stapled interests (section 269B(c)(2))";
}
pub relation entities_stapled_with_each_other(first: Integer, second: Integer) kind institutional {
    label en official "the two entities are stapled entities: more than 50 percent in value of the beneficial ownership in each consists of stapled interests (section 269B(c)(2)); a group of more than two entities is not decomposed";
}
@source(IRC_S269B_C, quote = "The term \"stapled entities\" means any group of 2 or more entities if more than 50 percent in value of the beneficial ownership in each of such entities consists of stapled interests.")
rule StapledEntitiesRule(first: Integer, second: Integer, a: Decimal, b: Decimal) strict {
    label en official "two entities each more than 50 percent stapled are stapled entities (section 269B(c)(2))";
    when percent_value_of_beneficial_ownership_consisting_of_stapled_interests(first, a);
    when percent_value_of_beneficial_ownership_consisting_of_stapled_interests(second, b);
    when a > 50.0;
    when b > 50.0;
    when first != second;
    then entities_stapled_with_each_other(first, second);
}
pub relation domestic_corporation_entity(ent: Integer) kind empirical {
    label en official "the entity is a domestic corporation";
}
pub relation foreign_corporation_entity(ent: Integer) kind empirical {
    label en official "the entity is a foreign corporation";
}
pub relation us_persons_hold_percent_of_vote(ent: Integer, percent: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power held directly or indirectly (sections 958(a)(2),(3), 318(a)(4)) by United States persons (section 269B(e)(2)(A))";
}
pub relation us_persons_hold_percent_of_value(ent: Integer, percent: Decimal) kind empirical {
    label en official "the percentage of the total value of the stock held directly or indirectly by United States persons (section 269B(e)(2)(B))";
}
pub relation corporation_foreign_owned_269b(ent: Integer) kind institutional {
    label en official "less than 50 percent of both the voting power and the value of the corporation's stock is held by United States persons (section 269B(e)(2))";
}
@source(IRC_S269B_E, quote = "a corporation is foreign owned if less than 50 percent of—")
rule ForeignOwnedRule(ent: Integer, vote: Decimal, value: Decimal) strict {
    label en official "a corporation is foreign owned if United States persons hold less than 50 percent of the vote and less than 50 percent of the value (section 269B(e)(2))";
    when us_persons_hold_percent_of_vote(ent, vote);
    when us_persons_hold_percent_of_value(ent, value);
    when vote < 50.0;
    when value < 50.0;
    then corporation_foreign_owned_269b(ent);
}
external judgment relation foreign_ownership_established_to_satisfaction_of_secretary(dom: Integer, foreign: Integer) {
    authority Secretary;
    label en official "it is established to the satisfaction of the Secretary that the domestic and the foreign corporation are foreign owned (section 269B(e)(1))";
}
pub relation foreign_corporation_treated_as_domestic_269b(foreign: Integer) kind institutional {
    label en official "the foreign corporation, stapled to a domestic corporation, is treated as a domestic corporation for all purposes of the title (section 269B(a)(1))";
}
@source(IRC_S269B_A, quote = "if a domestic corporation and a foreign corporation are stapled entities, the foreign corporation shall be treated as a domestic corporation.")
rule ForeignStapledCorporationTreatedAsDomestic(dom: Integer, foreign: Integer) defeasible {
    label en official "a foreign corporation stapled to a domestic one is treated as domestic, except where both are foreign owned and the Secretary is so satisfied (section 269B(a)(1),(e)); treaties give no exemption (section 269B(d)); regulations may provide otherwise";
    when domestic_corporation_entity(dom);
    when foreign_corporation_entity(foreign);
    when entities_stapled_with_each_other(dom, foreign);
    unless foreign_ownership_established_to_satisfaction_of_secretary(dom, foreign);
    then foreign_corporation_treated_as_domestic_269b(foreign);
}

// === §271: debts owed by political parties ==========================================================

pub relation worthless_debt_owed_by_political_party(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a debt owed by a political party (a party, a national, State or local committee, or an organization accepting contributions or making expenditures to influence elections) becomes worthless (section 271(a),(b))";
}
pub relation taxpayer_is_a_bank_581(p: Person) kind empirical {
    label en official "the taxpayer is a bank as defined in section 581 (section 271(a))";
}
pub relation accrual_method_receivable_from_bona_fide_sale_with_more_than_30_percent_due_from_parties(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "an accrual method taxpayer's debt accrued as a receivable on a bona fide sale of goods or services in the ordinary course, and for the year it accrued more than 30 percent of all its receivables were due from political parties (section 271(c)(1))";
}
external judgment relation substantial_continuing_efforts_to_collect(p: Person, y: TaxableYear, item: Integer) {
    authority TaxCourt;
    label en official "the taxpayer made substantial continuing efforts to collect on the debt (section 271(c)(2))";
}
pub relation section_271c_exception_met(p: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the accrual-method exception of section 271(c): a receivable on a bona fide sale, more than 30 percent of the year's receivables due from political parties, and substantial continuing efforts to collect";
}
@source(IRC_S271_C, quote = "the taxpayer made substantial continuing efforts to collect on the debt.")
rule Section271cExceptionRule(p: Person, y: TaxableYear, item: Integer) strict {
    label en official "both conditions of section 271(c) together make the exception";
    when accrual_method_receivable_from_bona_fide_sale_with_more_than_30_percent_due_from_parties(p, y, item);
    when substantial_continuing_efforts_to_collect(p, y, item);
    then section_271c_exception_met(p, y, item);
}
pub relation political_party_debt_deduction_denied_271(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "no deduction under section 166 or 165(g) is allowed for the worthlessness of the debt owed by a political party";
}
@source(IRC_S271_A, quote = "no deduction shall be allowed under section 166 (relating to bad debts) or under section 165(g) (relating to worthlessness of securities) by reason of the worthlessness of any debt owed by a political party")
rule PoliticalPartyDebtDeductionDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a taxpayer other than a bank gets no bad debt or worthless security deduction for a debt owed by a political party (section 271(a)); the (c) exception for accrual-method sellers with more than 30 percent of receivables from parties and substantial collection efforts defeats it";
    when worthless_debt_owed_by_political_party(p, y, item, amount);
    when not_known(taxpayer_is_a_bank_581(p));
    when not_known(section_271c_exception_met(p, y, item));
    then political_party_debt_deduction_denied_271(p, y, item, amount);
}
@source(IRC_S271_A, quote = "no deduction shall be allowed under section 166 (relating to bad debts)")
rule PoliticalPartyDebtNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the denied amount is not an allowed deduction";
    when political_party_debt_deduction_denied_271(p, y, item, amount);
    then not deduction_allowed(p, y, Section271PoliticalPartyDebts, amount);
}

// === §272: disposal of coal or domestic iron ore under section 631 =======================================

pub relation expenditure_of_coal_or_iron_ore_contract_covered_by_631(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "expenditures attributable to the making and administering of a contract under which coal or iron ore is disposed of within section 631, and to preserving the retained economic interest (section 272)";
}
pub relation adjusted_depletion_basis_of_ore_disposed(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted depletion basis of the coal or iron ore disposed of in the taxable year";
}
pub relation amount_realized_under_contract(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount realized under the contract for the taxable year; section 272 does not apply to a year with no income under the contract";
}
pub relation section_1231_gain_reduction_used(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the part of the excess availed of as a reduction of gain under section 1231";
}
pub relation contract_expenditure_nondeductible_272(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed for the expenditures (section 272)";
}
@source(IRC_S272, quote = "no deduction shall be allowed for expenditures attributable to the making and administering of the contract under which such disposition occurs")
rule ContractExpenditureNotDeductible272(p: Person, y: TaxableYear, exp: Money, income: Money) strict {
    label en official "expenditures for the making and administering of a section 631 coal or iron ore contract are not deductible (section 272), in a year with income under the contract";
    when expenditure_of_coal_or_iron_ore_contract_covered_by_631(p, y, exp);
    when amount_realized_under_contract(p, y, income);
    when income > 0.00 USD;
    then contract_expenditure_nondeductible_272(p, y, exp);
}
pub relation section_165a_loss_from_contract_excess_272(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of expenditures plus adjusted depletion basis over the amount realized, to the extent not used against section 1231 gain, is a loss deductible under section 165(a) (section 272)";
}
@source(IRC_S272, quote = "such excess, to the extent not availed of as a reduction of gain under section 1231, shall be a loss deductible under section 165(a)")
rule ContractExcessLoss272(p: Person, y: TaxableYear, exp: Money, basis: Money, realized: Money, used: Money) strict {
    label en official "expenditures plus depletion basis above the amount realized are a section 165(a) loss to the extent not availed of under section 1231 (section 272)";
    when expenditure_of_coal_or_iron_ore_contract_covered_by_631(p, y, exp);
    when adjusted_depletion_basis_of_ore_disposed(p, y, basis);
    when amount_realized_under_contract(p, y, realized);
    when section_1231_gain_reduction_used(p, y, used);
    when realized > 0.00 USD;
    when exp + basis > realized;
    then section_165a_loss_from_contract_excess_272(p, y, max(0.00 USD, (exp + basis - realized) - used));
}

// === §273: holders of life or terminable interests ================================================================

pub relation income_paid_to_holder_of_life_or_terminable_interest_acquired_gratuitously(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid under the laws of a State, the District of Columbia, a possession or a foreign country as income to the holder of a life or terminable interest acquired by gift, bequest or inheritance (section 273)";
}
pub relation shrinkage_deduction_claimed_on_life_or_terminable_interest(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "a deduction claimed for shrinkage, by whatever name called, in the value of the interest due to the lapse of time";
}
@source(IRC_S273, quote = "shall not be reduced or diminished by any deduction for shrinkage (by whatever name called) in the value of such interest due to the lapse of time")
rule LifeInterestShrinkageNotDeductible(p: Person, y: TaxableYear, income: Money, claimed: Money) strict {
    label en official "no deduction for shrinkage of a gratuitously acquired life or terminable interest reduces the income received on it (section 273)";
    when income_paid_to_holder_of_life_or_terminable_interest_acquired_gratuitously(p, y, income);
    when shrinkage_deduction_claimed_on_life_or_terminable_interest(p, y, claimed);
    then not deduction_allowed(p, y, Section273LifeInterestShrinkage, claimed);
}

// === §275: taxes for which no deduction is allowed =================================================================

pub enum NondeductibleTaxCandidate {
    FederalIncomeTax;
    EmployeeFicaTax;
    RailroadEmployeeTax;
    TaxWithheldOnWages;
    WarProfitsOrExcessProfitsTax;
    EstateInheritanceLegacySuccessionOrGiftTax;
    ForeignIncomeTax;
    RealPropertyTaxTreatedAsImposedOnAnother;
    ChapterExciseTax;
    OtherTax;
}
pub relation tax_paid_or_accrued_275(p: Person, y: TaxableYear, item: Integer, tax: NondeductibleTaxCandidate, amount: Money) kind empirical {
    label en official "a tax paid or accrued by the taxpayer, of the stated category (section 275(a)); ChapterExciseTax stands for the taxes imposed by chapters 37, 41, 42, 43, 44, 45, 46, 50A and 54";
}
pub relation taxpayer_chooses_benefits_of_section_901(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer chooses to take to any extent the benefits of section 901 (section 275(a)(4))";
}
pub relation amount_allowable_under_164f(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the part of a Federal income tax (employment taxes) allowable as a deduction under section 164(f) (section 275(a) last sentence)";
}
pub relation tax_deduction_denied_275(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "no deduction is allowed for the tax by section 275(a)";
}
@source(IRC_S275_A, quote = "No deduction shall be allowed for the following taxes:")
rule Section275DeniedCategories(p: Person, y: TaxableYear, item: Integer, tax: NondeductibleTaxCandidate, amount: Money) strict {
    label en official "Federal income taxes (including FICA on employees, railroad employee taxes and wage withholding), war and excess profits taxes, estate, inheritance, legacy, succession and gift taxes, taxes on real property treated as imposed on another taxpayer under section 164(d), and the taxes of chapters 37, 41-46, 50A and 54 are not deductible (section 275(a)(1)-(3),(5),(6)); the Federal income tax category yields to section 164(f) through the next rule";
    when tax_paid_or_accrued_275(p, y, item, tax, amount);
    when tax != OtherTax;
    when tax != ForeignIncomeTax;
    when tax != FederalIncomeTax;
    when tax != EmployeeFicaTax;
    when tax != RailroadEmployeeTax;
    when tax != TaxWithheldOnWages;
    then tax_deduction_denied_275(p, y, item, amount);
}
@source(IRC_S275_A, quote = "Federal income taxes, including—")
rule Section275FederalIncomeTaxCategories(p: Person, y: TaxableYear, item: Integer, tax: NondeductibleTaxCandidate, amount: Money, allowable164f: Money) strict {
    label en official "Federal income taxes, employee FICA, railroad employee taxes and wage withholding are not deductible except to the extent of section 164(f) (section 275(a)(1))";
    when tax_paid_or_accrued_275(p, y, item, tax, amount);
    when tax != OtherTax;
    when tax != ForeignIncomeTax;
    when tax != WarProfitsOrExcessProfitsTax;
    when tax != EstateInheritanceLegacySuccessionOrGiftTax;
    when tax != RealPropertyTaxTreatedAsImposedOnAnother;
    when tax != ChapterExciseTax;
    when amount_allowable_under_164f(p, y, item, allowable164f);
    then tax_deduction_denied_275(p, y, item, max(0.00 USD, amount - allowable164f));
}
@source(IRC_S275_A, quote = "Income, war profits, and excess profits taxes imposed by the authority of any foreign country or possession of the United States if the taxpayer chooses to take to any extent the benefits of section 901.")
rule Section275ForeignIncomeTaxWithCreditChoice(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "foreign income taxes are not deductible if the taxpayer chooses the benefits of section 901 (section 275(a)(4))";
    when tax_paid_or_accrued_275(p, y, item, ForeignIncomeTax, amount);
    when taxpayer_chooses_benefits_of_section_901(p, y);
    then tax_deduction_denied_275(p, y, item, amount);
}
@source(IRC_S275_A, quote = "No deduction shall be allowed for the following taxes:")
rule Section275DeniedTaxNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the denied tax amount is not an allowed deduction";
    when tax_deduction_denied_275(p, y, item, amount);
    when amount > 0.00 USD;
    then not deduction_allowed(p, y, Section275NondeductibleTaxes, amount);
}

// === §276: political events and publications =========================================================================

pub enum PoliticalEventPayment {
    ConventionProgramAdvertising;
    PublicationAdvertisingWithProceedsToPartyOrCandidate;
    DinnerOrProgramAdmissionWithProceedsToPartyOrCandidate;
    InauguralEventAdmission;
    OtherPayment;
}
pub relation payment_for_political_event(p: Person, y: TaxableYear, item: Integer, kind: PoliticalEventPayment, amount: Money) kind empirical {
    label en official "an amount paid or incurred for advertising in a convention program of a political party or in a publication whose proceeds inure to a party or candidate, for admission to a dinner or program whose proceeds so inure, or for admission to an inaugural ball, gala, parade or concert or a similar event identified with a party or candidate (section 276(a))";
}
pub relation proceeds_used_to_further_candidacy_and_not_received_in_ordinary_business(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the proceeds may be used directly or indirectly to further a candidacy and are not received by the candidate in the ordinary course of a trade or business other than holding elective public office (section 276(b)(2))";
}
pub relation political_event_payment_deduction_denied_276(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "no deduction otherwise allowable under chapter 1 is allowed for the amount (section 276(a))";
}
@source(IRC_S276_A, quote = "advertising in a convention program of a political party")
rule ConventionProgramAdvertisingDenied(p: Person, y: TaxableYear, item: Integer, kind: PoliticalEventPayment, amount: Money) strict {
    label en official "advertising in a party's convention program, admission to an inaugural event or similar event is not deductible (section 276(a)(1),(3))";
    when payment_for_political_event(p, y, item, kind, amount);
    when kind != OtherPayment;
    when kind != PublicationAdvertisingWithProceedsToPartyOrCandidate;
    when kind != DinnerOrProgramAdmissionWithProceedsToPartyOrCandidate;
    then political_event_payment_deduction_denied_276(p, y, item, amount);
}
@source(IRC_S276_A, quote = "if any part of the proceeds of such publication directly or indirectly inures (or is intended to inure) to or for the use of a political party or a political candidate")
rule PublicationOrDinnerWithProceedsDenied(p: Person, y: TaxableYear, item: Integer, kind: PoliticalEventPayment, amount: Money) strict {
    label en official "advertising in a publication, or admission to a dinner or program, whose proceeds inure to a party or a candidate (as section 276(b)(2) reads that for a candidate) is not deductible (section 276(a)(1)-(2))";
    when payment_for_political_event(p, y, item, kind, amount);
    when kind != OtherPayment;
    when kind != ConventionProgramAdvertising;
    when kind != InauguralEventAdmission;
    when proceeds_used_to_further_candidacy_and_not_received_in_ordinary_business(p, y, item);
    then political_event_payment_deduction_denied_276(p, y, item, amount);
}
@source(IRC_S276_A, quote = "No deduction otherwise allowable under this chapter shall be allowed for any amount paid or incurred for—")
rule PoliticalEventPaymentNotDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the denied amount is not an allowed deduction";
    when political_event_payment_deduction_denied_276(p, y, item, amount);
    then not deduction_allowed(p, y, Section276PoliticalEvents, amount);
}

// === §277: social clubs and other membership organizations ====================================================================

pub relation membership_organization_operated_primarily_to_furnish_services_or_goods_to_members(p: Person) kind empirical {
    label en official "a social club or other membership organization operated primarily to furnish services or goods to members and not exempt from taxation (section 277(a))";
}
pub relation membership_organization_within_277b_exception(p: Person, y: TaxableYear) kind institutional {
    label en official "the organization is subject to tax under subchapter H or L for the year, made a section 456(c) election before October 9, 1969 (or is affiliated with such an organization), is a national securities exchange or contract market on each day of the year, or is engaged primarily in gathering and distributing news to its members for publication (section 277(b))";
}
pub relation deductions_attributable_to_furnishing_items_to_members(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions for the year attributable to furnishing services, insurance, goods or other items of value to members, including amounts carried over from the preceding year (section 277(a))";
}
pub relation income_derived_from_members_or_transactions_with_members(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "income derived during the year from members or transactions with members, including institutes and trade shows primarily for the education of members (section 277(a))";
}
pub relation member_deductions_allowed_277(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions attributable to furnishing items to members allowed for the year: only to the extent of income from members (section 277(a))";
}
pub relation member_deductions_carried_to_succeeding_year_277(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess deductions, treated as attributable to furnishing items to members paid or incurred in the succeeding taxable year (section 277(a))";
}
@source(IRC_S277_A, quote = "shall be allowed only to the extent of income derived during such year from members or transactions with members")
rule MemberDeductionsLimitedToMemberIncome(p: Person, y: TaxableYear, ded: Money, inc: Money) strict {
    label en official "deductions attributable to furnishing items to members are allowed only to the extent of income derived from members (section 277(a))";
    when membership_organization_operated_primarily_to_furnish_services_or_goods_to_members(p);
    when not_known(membership_organization_within_277b_exception(p, y));
    when deductions_attributable_to_furnishing_items_to_members(p, y, ded);
    when income_derived_from_members_or_transactions_with_members(p, y, inc);
    then member_deductions_allowed_277(p, y, min(ded, inc));
}
@source(IRC_S277_A, quote = "the excess shall be treated as a deduction attributable to furnishing services, insurance, goods, or other items of value to members paid or incurred in the succeeding taxable year")
rule MemberDeductionsExcessCarriedForward(p: Person, y: TaxableYear, ded: Money, inc: Money) strict {
    label en official "the excess over member income carries to the succeeding year (section 277(a))";
    when membership_organization_operated_primarily_to_furnish_services_or_goods_to_members(p);
    when not_known(membership_organization_within_277b_exception(p, y));
    when deductions_attributable_to_furnishing_items_to_members(p, y, ded);
    when income_derived_from_members_or_transactions_with_members(p, y, inc);
    when ded > inc;
    then member_deductions_carried_to_succeeding_year_277(p, y, ded - inc);
}
pub relation dividends_received_deductions_denied_to_membership_organization(p: Person, y: TaxableYear) kind institutional {
    label en official "the deductions of sections 243 and 245 are not allowed to a section 277 organization for the year (section 277(a) last sentence)";
}
@source(IRC_S277_A, quote = "The deductions provided by sections 243 and 245 (relating to dividends received by corporations) shall not be allowed to any organization to which this section applies for the taxable year.")
rule MembershipOrganizationNoDividendsReceivedDeduction(p: Person, y: TaxableYear) strict {
    label en official "a section 277 organization gets no dividends-received deduction under section 243 or 245 (section 277(a))";
    when membership_organization_operated_primarily_to_furnish_services_or_goods_to_members(p);
    when deductions_attributable_to_furnishing_items_to_members(p, y, _);
    when not_known(membership_organization_within_277b_exception(p, y));
    then dividends_received_deductions_denied_to_membership_organization(p, y);
}

// === §279: interest on corporate acquisition indebtedness ===========================================================================

pub relation acquisition_obligation_issued_for_stock_or_two_thirds_of_assets(obl: Integer) kind institutional {
    label en official "the obligation is issued to provide consideration for the acquisition of stock in another corporation, or of assets under a plan by which at least two-thirds in value of all the assets (excluding money) used in the acquired corporation's trades and businesses are acquired (section 279(b)(1))";
}
pub relation obligation_subordinated_to_trade_creditors_or_unsecured_debt(obl: Integer) kind institutional {
    label en official "the obligation is subordinated to the claims of trade creditors generally, or expressly subordinated in right of payment to any substantial amount of unsecured indebtedness (section 279(b)(2))";
}
pub relation obligation_convertible_or_with_stock_option_unit(obl: Integer) kind institutional {
    label en official "the obligation is convertible directly or indirectly into stock of the issuing corporation, or part of an investment unit that includes an option to acquire such stock (section 279(b)(3))";
}
pub relation issuer_total_indebtedness(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total indebtedness of the issuing corporation on the last day of the taxable year (section 279(c)(1),(2))";
}
pub relation issuer_total_assets_money_and_adjusted_basis(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the issuing corporation's money and all its other assets, at adjusted basis for determining gain, before subtracting indebtedness (section 279(c)(2))";
}
pub relation issuer_projected_earnings(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the average annual earnings of the issuing corporation (and, where control or substantially all properties were acquired, of both corporations) for the 3-year period ending with the last day of the year, computed without reduction for interest, depreciation or amortization, tax and section 301(c)(1) distributions (section 279(c)(3))";
}
pub relation annual_interest_to_be_paid_or_incurred(obl: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the annual interest to be paid or incurred by the issuing corporation (and, with projected earnings of both corporations, by both) by reference to total indebtedness outstanding (section 279(c)(4))";
}
pub relation debt_to_equity_test_met_279(obl: Integer, y: TaxableYear) kind institutional {
    label en official "the ratio of debt to equity exceeds 2 to 1: total indebtedness over assets less indebtedness (section 279(b)(4)(A),(c)(2))";
}
@source(IRC_S279_B, quote = "the ratio of debt to equity (as defined in subsection (c)(2)) of the issuing corporation exceeds 2 to 1, or")
rule DebtToEquityExceedsTwoToOne(obl: Integer, y: TaxableYear, debt: Money, assets: Money) strict {
    label en official "debt exceeds twice equity, equity being assets less debt; debt over assets that leave no positive equity also meets the test (section 279(b)(4)(A),(c)(2))";
    when adjusted_total_indebtedness_279(obl, y, debt);
    when adjusted_total_assets_279(obl, y, assets);
    when debt > 2 * (assets - debt);
    then debt_to_equity_test_met_279(obl, y);
}
pub relation projected_earnings_test_met_279(obl: Integer, y: TaxableYear) kind institutional {
    label en official "the projected earnings do not exceed 3 times the annual interest to be paid or incurred (section 279(b)(4)(B))";
}
@source(IRC_S279_B, quote = "the projected earnings (as defined in subsection (c)(3)) do not exceed 3 times the annual interest to be paid or incurred")
rule ProjectedEarningsNotAboveThreeTimesInterest(obl: Integer, y: TaxableYear, earnings: Money, interest: Money) strict {
    label en official "projected earnings of at most 3 times annual interest meet the test (section 279(b)(4)(B))";
    when issuer_projected_earnings(obl, y, earnings);
    when annual_interest_to_be_paid_or_incurred(obl, y, interest);
    when earnings <= interest * 3;
    then projected_earnings_test_met_279(obl, y);
}
pub relation issuer_owns_five_percent_of_voting_power_of_acquired_corporation(obl: Integer, y: TaxableYear) kind empirical {
    label en official "at some time before the close of the year the issuing corporation owns 5 percent or more of the total combined voting power of the acquired corporation (section 279(d)(5))";
}
pub relation obligation_issued_for_stock_acquisition(obl: Integer) kind empirical {
    label en official "the obligation was issued for the acquisition of stock (so the 5-percent rule of section 279(d)(5) applies)";
}
pub relation acquired_corporation_substantially_all_income_from_foreign_sources(obl: Integer) kind empirical {
    label en official "the acquired foreign corporation derived substantially all its income for the 3-year period ending with the acquisition from sources without the United States (section 279(f))";
}
pub relation cai_determination_279b(obl: Integer, y: TaxableYear) kind institutional {
    label en official "the tests of section 279(b) make the obligation corporate acquisition indebtedness as of the last day of the taxable year (section 279(b),(c)(1))";
}
pub relation corporate_acquisition_indebtedness_279(obl: Integer, y: TaxableYear) kind institutional {
    label en official "the obligation is corporate acquisition indebtedness for the taxable year, by the determination of that year (the succeeding-year and 3-year rules of section 279(d)(2)-(4) are not modelled, TECH_GAPS G2723)";
}
@source(IRC_S279_B, quote = "such obligation is issued to provide consideration for the acquisition of—")
rule CorporateAcquisitionIndebtednessByDebtToEquity(obl: Integer, y: TaxableYear) strict {
    label en official "an acquisition obligation that is subordinated, convertible (or an option unit) and meets the debt-to-equity test is corporate acquisition indebtedness (section 279(b)); the 5-percent rule of (d)(5) and the foreign exemption of (f) are gates";
    when acquisition_obligation_issued_for_stock_or_two_thirds_of_assets(obl);
    when obligation_subordinated_to_trade_creditors_or_unsecured_debt(obl);
    when obligation_convertible_or_with_stock_option_unit(obl);
    when debt_to_equity_test_met_279(obl, y);
    when not_known(acquired_corporation_substantially_all_income_from_foreign_sources(obl));
    when not_known(five_percent_rule_blocks_279(obl, y));
    then cai_determination_279b(obl, y);
}
@source(IRC_S279_B, quote = "such obligation is issued to provide consideration for the acquisition of—")
rule CorporateAcquisitionIndebtednessByProjectedEarnings(obl: Integer, y: TaxableYear) strict {
    label en official "the same, meeting the projected earnings test instead of the debt-to-equity test (section 279(b)(4)(B))";
    when acquisition_obligation_issued_for_stock_or_two_thirds_of_assets(obl);
    when obligation_subordinated_to_trade_creditors_or_unsecured_debt(obl);
    when obligation_convertible_or_with_stock_option_unit(obl);
    when projected_earnings_test_met_279(obl, y);
    when not_known(acquired_corporation_substantially_all_income_from_foreign_sources(obl));
    when not_known(five_percent_rule_blocks_279(obl, y));
    then cai_determination_279b(obl, y);
}
pub relation five_percent_rule_blocks_279(obl: Integer, y: TaxableYear) kind institutional {
    label en official "an obligation issued for stock is corporate acquisition indebtedness only if the issuer owns 5 percent or more of the voting power of the acquired corporation before the close of the year (section 279(d)(5))";
}
@source(IRC_S279_D, quote = "such obligations shall be corporate acquisition indebtedness for a taxable year only if at some time before the close of such year the issuing corporation owns 5 percent or more")
rule FivePercentRuleBlocks(obl: Integer, y: TaxableYear) strict {
    label en official "for a stock acquisition without the 5-percent voting stake the obligation is not corporate acquisition indebtedness (section 279(d)(5))";
    when obligation_issued_for_stock_acquisition(obl);
    when issuer_total_indebtedness(obl, y, _);
    when not_known(issuer_owns_five_percent_of_voting_power_of_acquired_corporation(obl, y));
    then five_percent_rule_blocks_279(obl, y);
}
pub relation interest_on_corporate_acquisition_indebtedness(c: Corporation, y: TaxableYear, obl: Integer, amount: Money) kind institutional {
    label en official "interest paid or incurred by the corporation during the taxable year on its corporate acquisition indebtedness (section 279(a))";
}
pub relation interest_on_acquisition_obligations_not_corporate_acquisition_indebtedness(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "interest paid or incurred during the year on obligations issued to provide consideration for an acquisition of section 279(b)(1) but which are not corporate acquisition indebtedness (section 279(a)(2))";
}
pub relation acquisition_interest_disallowed_279(c: Corporation, y: TaxableYear, obl: Integer, amount: Money) kind institutional {
    label en official "the interest on corporate acquisition indebtedness for which no deduction is allowed: the excess over $5,000,000 reduced by the interest on the other acquisition obligations";
}
@source(IRC_S279_A, quote = "No deduction shall be allowed for any interest paid or incurred by a corporation during the taxable year with respect to its corporate acquisition indebtedness to the extent that such interest exceeds—")
rule AcquisitionInterestDisallowed(c: Corporation, y: TaxableYear, obl: Integer, interest: Money, other: Money) strict {
    label en official "interest on corporate acquisition indebtedness above $5,000,000 less the interest on the other acquisition obligations is not deductible (section 279(a)); the limit is floored at zero (JUDGMENT CALL); an aggregate over several obligations is asserted through the single obligation";
    when interest_on_corporate_acquisition_indebtedness(c, y, obl, interest);
    when corporate_acquisition_indebtedness_279(obl, y);
    when interest_on_acquisition_obligations_not_corporate_acquisition_indebtedness(c, y, other);
    when interest > max(0.00 USD, 5000000.00 USD - other);
    then acquisition_interest_disallowed_279(c, y, obl, interest - max(0.00 USD, 5000000.00 USD - other));
}
@source(IRC_S279_A, quote = "No deduction shall be allowed for any interest paid or incurred by a corporation during the taxable year with respect to its corporate acquisition indebtedness")
rule AcquisitionInterestNotDeductible(c: Corporation, y: TaxableYear, obl: Integer, amount: Money) strict {
    label en official "the disallowed interest is not an allowed deduction";
    when acquisition_interest_disallowed_279(c, y, obl, amount);
    then not deduction_allowed(c, y, Section279AcquisitionInterest, amount);
}

// === §281: terminal railroad corporations ===============================================================================================

pub relation terminal_railroad_corporation_281(c: Corporation, y: TaxableYear) kind institutional {
    label en official "a domestic railroad corporation that is not (other than as common parent) a member of an affiliated group, all its shareholders being rail carriers, its primary business being railroad terminal and switching services, a substantial part of its services rendered to shareholders, and each shareholder using a taxable year beginning and ending on the same days (section 281(d)(1))";
}
pub relation terminal_income_credited_or_uncharged_281(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the portion of a railroad's liability discharged by crediting related terminal income, or of a charge not made because related terminal income was taken into account (section 281(a)(1)(A)), provided for in a written agreement (section 281(c))";
}
pub relation written_agreement_provides_for_terminal_income_crediting(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the discharge or computation of charges was provided for in a written agreement (section 281(c))";
}
pub relation net_operating_loss_created_or_increased_by_281(c: Corporation, y: TaxableYear) kind empirical {
    label en official "applying section 281(a)(1) would create or increase a net operating loss for the taxable year (section 281(a)(2))";
}
pub relation terminal_income_not_received_or_accrued_281(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the terminal railroad corporation is not considered to have received or accrued the credited amount (section 281(a)(1)(A))";
}
@source(IRC_S281_A, quote = "such corporation shall not be considered to have received or accrued—")
rule TerminalIncomeNotReceived(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "credited related terminal income is not received or accrued by the terminal railroad corporation, under a written agreement and to the extent it does not create or increase a net operating loss (section 281(a)(1)-(2),(c))";
    when terminal_railroad_corporation_281(c, y);
    when terminal_income_credited_or_uncharged_281(c, y, amount);
    when written_agreement_provides_for_terminal_income_crediting(c, y);
    when not_known(net_operating_loss_created_or_increased_by_281(c, y));
    then terminal_income_not_received_or_accrued_281(c, y, amount);
}
