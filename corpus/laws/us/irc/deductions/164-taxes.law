// Section 164 — Taxes. Stage 1 (IRC-06), priority section.
//
// Scope: (a) the list of deductible taxes; (b)(5) election to deduct state
// and local sales tax in lieu of income tax, as a power; (b)(6) the SALT
// cap, pinned 2024-Edition $10,000/$5,000 text plus Pub. L. 119-21 section
// 70120's "applicable limitation amount" replacement with MAGI phase-down,
// as editions with scenarios on both sides of the 2025 boundary.

use self::{
    DeductionKind,
    IRC_S164_A,
    IRC_S164_B,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
    real_property_tax_treated_as_imposed_on_other_taxpayer,
    tax_assessed_against_local_benefits,
};

pub enum TaxKind164 {
    RealPropertyTax;        // (a)(1)
    PersonalPropertyTax;    // (a)(2)
    IncomeWarProfitsTax;    // (a)(3)
    GstTaxOnIncomeDistributions; // (a)(4)
    TradeOrBusinessOrSection212Tax; // (a) flush language
    GeneralSalesTax;        // (b)(5), in lieu of income tax by election
}
pub relation tax_paid_or_accrued(p: Person, y: TaxableYear, item: Integer, kind: TaxKind164, amount: Money) kind empirical {
    label en official "a state, local, or foreign tax of a kind described in section 164(a) paid or accrued within the taxable year";
}
pub relation foreign_real_property_tax(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the tax is a foreign real property tax (section 164(a)(1), subject to the section 164(b)(6)(A) exclusion)";
}
pub relation tax_paid_in_trade_or_business_or_212(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the tax is paid or accrued in carrying on a trade or business or a section 212 activity (excepted from the section 164(b)(6) cap by its own terms)";
}

@source(IRC_S164_A, quote = "the following taxes shall be allowed as a deduction for the taxable year within which paid or accrued")
rule TaxDeductionGeneralRule(p: Person, y: TaxableYear, item: Integer, kind: TaxKind164, amount: Money) strict {
    label en official "a section 164(a) tax is allowed as a deduction for the taxable year paid or accrued, except as limited by section 164(b)(6) for an individual's non-business state/local/GST taxes";
    when tax_paid_or_accrued(p, y, item, kind, amount);
    when not_known(foreign_real_property_tax(p, y, item));
    when not_known(tax_assessed_against_local_benefits(item));
    when not_known(real_property_tax_treated_as_imposed_on_other_taxpayer(p, y, item));
    when kind != GeneralSalesTax;
    then deduction_allowed(p, y, Section164Taxes, amount);
}
@source(IRC_S164_A, quote = "there shall be allowed as a deduction State and local, and foreign, taxes not described in the preceding sentence which are paid or accrued within the taxable year in carrying on a trade or business or an activity described in section 212")
rule TaxDeductionTradeOrBusinessCatchAll(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a state, local, or foreign tax not otherwise listed, paid or accrued in carrying on a trade or business or a section 212 activity, is allowed as a deduction (section 164(a) flush language)";
    when tax_paid_or_accrued(p, y, item, TradeOrBusinessOrSection212Tax, amount);
    then deduction_allowed(p, y, Section164Taxes, amount);
}

// --- §164(b)(5): election to deduct general sales taxes in lieu of income tax --

pub relation elects_sales_tax_in_lieu_of_income_tax(p: Individual, y: TaxableYear) kind empirical {
    label en official "elects, for the taxable year, to apply section 164(a) without regard to state/local income taxes and as if general sales taxes were referred to instead (section 164(b)(5)(A))";
}
@source(IRC_S164_B, quote = "At the election of the taxpayer for the taxable year, subsection (a) shall be applied")
rule SalesTaxElectionPowerRule(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus) strict {
    label en official "a taxpayer has the power to elect to substitute general sales taxes for state/local income taxes under section 164(a) (section 164(b)(5)(A))";
    when us.irc.income_individual::filing_status(p, y, s);
    then power SalesTaxInLieuOfIncomeTaxElection {
        holder p;
        over y;
        exercise elects_sales_tax_in_lieu_of_income_tax(p, y);
        valid_when elects_sales_tax_in_lieu_of_income_tax(p, y);
        effect create(sales_tax_election_in_effect(p, y));
        window [@2004-01-01, infinity);
    };
}
pub relation sales_tax_election_in_effect(p: Individual, y: TaxableYear) kind institutional {
    label en official "the section 164(b)(5)(A) election is in effect for the taxable year";
}
@source(IRC_S164_A, quote = "State and local, and foreign, income, war profits, and excess profits taxes")
rule IncomeTaxNotDeductedWhenSalesTaxElected(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "when the section 164(b)(5)(A) election is in effect, a state/local income tax item is not counted under section 164(a)(3) (the election substitutes sales tax for it)";
    when sales_tax_election_in_effect(p, y);
    when tax_paid_or_accrued(p, y, item, IncomeWarProfitsTax, amount);
    then not deduction_allowed(p, y, Section164Taxes, amount);
}
@source(IRC_S164_B, quote = "as if State and local general sales taxes were referred to in a paragraph thereof")
rule SalesTaxDeductibleWhenElected(p: Individual, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "when the section 164(b)(5)(A) election is in effect, a general sales tax item is deductible as if listed in section 164(a)";
    when sales_tax_election_in_effect(p, y);
    when tax_paid_or_accrued(p, y, item, GeneralSalesTax, amount);
    then deduction_allowed(p, y, Section164Taxes, amount);
}

// --- §164(b)(6): the SALT cap --------------------------------------------------

pub relation salt_capped_taxes_aggregate(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate of section 164(a)(1)-(3) and (b)(5) taxes taken into account for the taxable year, before the section 164(b)(6) cap (excludes items excepted by their own trade-or-business/section 212 terms)";
}
pub relation modified_adjusted_gross_income_for_salt(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "modified adjusted gross income for section 164(b)(7)(B)(iv): AGI increased by amounts excluded under sections 911, 931, or 933 — dependency contract, producer: unresolved (sections 911/931/933 pending)";
}

@source(IRC_S164_B, quote = "the aggregate amount of taxes taken into account under paragraphs (1), (2), and (3) of subsection (a) and paragraph (5) of this subsection for any taxable year shall not exceed $10,000 ($5,000 in the case of a married individual filing a separate return)")
rule SaltCapPre2025General(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, aggregate: Money) strict {
    label en official "for taxable years beginning after December 31, 2017 and before January 1, 2025 (pre-Pub.L.119-21 text): non-business SALT is capped at $10,000, not married filing separately";
    effective [@2018-01-01, @2025-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::MarriedSeparate;
    when salt_capped_taxes_aggregate(p, y, aggregate);
    when aggregate > 10000.00 USD;
    then not deduction_allowed(p, y, Section164Taxes, aggregate - 10000.00 USD);
}
@source(IRC_S164_B, quote = "$10,000 ($5,000 in the case of a married individual filing a separate return)")
rule SaltCapPre2025Mfs(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, aggregate: Money) strict {
    label en official "for taxable years beginning after December 31, 2017 and before January 1, 2025 (pre-Pub.L.119-21 text): non-business SALT is capped at $5,000, married filing separately";
    effective [@2018-01-01, @2025-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::MarriedSeparate;
    when salt_capped_taxes_aggregate(p, y, aggregate);
    when aggregate > 5000.00 USD;
    then not deduction_allowed(p, y, Section164Taxes, aggregate - 5000.00 USD);
}

@source(us.irc.temporal::PL119_21_S70120, relation = derives_from, quote = "in the case of any taxable year beginning in calendar year 2025, $40,000")
rule SaltCapFrom2025General(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, aggregate: Money, magi: Money) strict {
    label en official "for taxable years beginning in calendar year 2025 or 2026 (Pub. L. 119-21 section 70120): non-business SALT is capped at the applicable limitation amount (before MAGI phasedown), not married filing separately";
    effective [@2025-01-01, @2027-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s != us.irc.income_individual::MarriedSeparate;
    when salt_capped_taxes_aggregate(p, y, aggregate);
    when modified_adjusted_gross_income_for_salt(p, y, magi);
    when aggregate > max(round(SaltCapGeneral, 2, "HALF_UP") - round(min(round(SaltCapGeneral, 2, "HALF_UP") - 10000.00 USD, max(0.00 USD, round((magi - round(SaltCapMagiThresholdGeneral, 2, "HALF_UP")) * 0.30, 2, "HALF_UP"))), 2, "HALF_UP"), 10000.00 USD);
    then not deduction_allowed(p, y, Section164Taxes,
        aggregate - max(round(SaltCapGeneral, 2, "HALF_UP") - round(min(round(SaltCapGeneral, 2, "HALF_UP") - 10000.00 USD, max(0.00 USD, round((magi - round(SaltCapMagiThresholdGeneral, 2, "HALF_UP")) * 0.30, 2, "HALF_UP"))), 2, "HALF_UP"), 10000.00 USD));
}
// JUDGMENT CALL: the applicable-limitation-amount phasedown ("reduced by 30
// percent of the excess of MAGI over the threshold amount ... not below
// $10,000") is modelled here as
// `max($40,000 - min($30,000, 30% * excess), $10,000)`, algebraically
// equivalent to "reduce the $40,000 base by 30% of the excess, floored at
// $10,000" — spelled out because the language's `if/then/else` nesting for
// a three-way min/max/floor composition was less legible than the
// arithmetic identity. Taxable years beginning after 2026 require a 101%
// compounding recursion across calendar years that this stage does not
// model (TECH_GAP, LDC-E4102-style self-recursive arithmetic risk) —
// `salt-cap-general.lawparam.json`/`salt-cap-magi-threshold-general.
// lawparam.json` pin only 2025 and 2026; a 2027+ scenario is unsupported
// and recorded as a coverage-row TECH_GAP, not silently computed.

@source(us.irc.temporal::PL119_21_S70120, relation = derives_from, quote = "in the case of any taxable year beginning in calendar year 2026, $505,000")
rule SaltCapFrom2025Mfs(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, aggregate: Money, magi: Money) strict {
    label en official "for taxable years beginning in calendar year 2025 or 2026: non-business SALT is capped at half the applicable limitation amount (before MAGI phasedown), married filing separately";
    effective [@2025-01-01, @2027-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when s == us.irc.income_individual::MarriedSeparate;
    when salt_capped_taxes_aggregate(p, y, aggregate);
    when modified_adjusted_gross_income_for_salt(p, y, magi);
    when aggregate > max(round(SaltCapMfs, 2, "HALF_UP") - round(min(round(SaltCapMfs, 2, "HALF_UP") - 5000.00 USD, max(0.00 USD, round((magi - round(SaltCapMagiThresholdMfs, 2, "HALF_UP")) * 0.30, 2, "HALF_UP"))), 2, "HALF_UP"), 5000.00 USD);
    then not deduction_allowed(p, y, Section164Taxes,
        aggregate - max(round(SaltCapMfs, 2, "HALF_UP") - round(min(round(SaltCapMfs, 2, "HALF_UP") - 5000.00 USD, max(0.00 USD, round((magi - round(SaltCapMagiThresholdMfs, 2, "HALF_UP")) * 0.30, 2, "HALF_UP"))), 2, "HALF_UP"), 5000.00 USD));
}
@source(IRC_S164_B, quote = "foreign real property taxes shall not be taken into account under subsection (a)(1)")
rule ForeignRealPropertyTaxExcludedDuring2018To2025(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for an individual, a foreign real property tax is not taken into account at all for a taxable year beginning after December 31, 2017 (section 164(b)(6)(A), unaffected by the Pub. L. 119-21 dollar-amount change)";
    effective [@2018-01-01, infinity);
    when foreign_real_property_tax(p, y, item);
    when tax_paid_or_accrued(p, y, item, RealPropertyTax, amount);
    then not deduction_allowed(p, y, Section164Taxes, amount);
}
// A 2030-and-later scenario (flat $10,000/$5,000 restored per section
// 164(b)(7)(A)(iv)) is a further edition boundary this stage records as
// "stage 2" (not reached this session; the two pinned lawparam files stop
// at 2027-01-01). (c) (collected charges: repealed), (d) (apportionment of
// property tax on sale), (e) (state legislator's per diem taxes), (f)
// (self-employment tax) stay "stage 2".
