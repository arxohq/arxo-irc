// Sections 169, 179B, 179C, 179D and 179E — stage 2c detail (TECH_GAPS G2741, G2745, G2749-G2754): (169)(d)(4),(5),(i)
// the new identifiable treatment facility, the coal-fired facilities and the life tenant; (179B)(c),(e) the basis
// reduction, the recapture as depreciation and the allocation to cooperative owners; (179C)(b)(2),(c),(d),(e),(g)
// qualified refinery property and the allocation to owners; (179D)(d)(3),(f)(2)-(4),(6) the allocation by tax-exempt
// owners, the retrofit plan, the retrofit property, the qualified building and the baseline energy use intensity;
// (179E)(b)(2),(c),(d) advanced mine safety equipment.
//
// Stage 1 interface changes (recorded): `eligible_adjusted_basis_before_useful_life_ratio`,
// `facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005`,
// `facility_in_connection_with_plant_placed_in_operation_after_1975`, `qualified_refinery_property_cost`,
// `advanced_mine_safety_equipment_cost`, `qualified_building_179df4` and `baseline_energy_use_intensity` are now
// institutional (derived below, or still asserted by a case); the stage 1 certified-facility rule carries a `not_known`
// guard for a facility that fails the new-identifiable-treatment-facility test.
//
// JUDGMENT CALLS: (1) the part of a cooperative's allocated amount that each owner receives is the amount times the
// owner's percentage among the receiving owners (a fact of the case); (2) the weather adjustment of the baseline is a
// factor of the case (the Secretary determines its manner); (3) the deadlines of the written notices are dates of the case;
// (4) the enactment dates are those of the statute: August 8, 2005 (section 179C) and December 20, 2006 (section 179E);
// (5) amounts are rounded to cents HALF_UP.

// === §169(d)(4),(5): the facility ============================================================================================

use self::{
    IRC_S169_D,
    IRC_S169_I,
    IRC_S179B_C,
    IRC_S179B_E,
    IRC_S179C_B,
    IRC_S179C_C,
    IRC_S179C_D,
    IRC_S179C_E,
    IRC_S179C_G,
    IRC_S179D_D,
    IRC_S179D_F,
    IRC_S179E_B,
    IRC_S179E_C,
    IRC_S179E_D,
    Person,
    TaxableYear,
    advanced_mine_safety_equipment_cost,
    baseline_energy_use_intensity,
    eligible_adjusted_basis_before_useful_life_ratio,
    facility_in_connection_with_plant_placed_in_operation_after_1975,
    facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005,
    qualified_building_179df4,
    qualified_refinery_property_cost,
    section_179b_deduction,
};

pub relation facility_is_tangible_depreciable_property_identifiable_as_treatment_facility(p: Person, facility: Integer) kind empirical {
    label en official "the facility is tangible property of a character subject to the allowance for depreciation under section 167 and identifiable as a treatment facility (section 169(d)(4)(A))";
}
pub relation facility_is_building_or_structural_component(p: Person, facility: Integer) kind empirical {
    label en official "the facility is a building or its structural components (section 169(d)(4)(A))";
}
pub relation building_is_exclusively_a_treatment_facility(p: Person, facility: Integer) kind empirical {
    label en official "the building is exclusively a treatment facility (section 169(d)(4)(A))";
}
pub relation facility_construction_completed_on(p: Person, facility: Integer, on: Date) kind empirical {
    label en official "the date the construction, reconstruction or erection of the facility is completed by the taxpayer (section 169(d)(4)(A)(i))";
}
pub relation facility_acquired_with_original_use_commencing_on(p: Person, facility: Integer, on: Date) kind empirical {
    label en official "the date the facility is acquired and its original use commences with the taxpayer (section 169(d)(4)(A)(ii))";
}
pub relation facility_described_solely_by_paragraph_5(p: Person, facility: Integer) kind empirical {
    label en official "the facility is described in paragraph (1) solely by reason of paragraph (5): an atmospheric pollution control facility placed in service after April 11, 2005 and used with a primarily coal-fired plant (section 169(d)(4)(B))";
}
pub relation facility_completion_or_acquisition_date_met(p: Person, facility: Integer) kind institutional {
    label en official "the construction is completed, or the property is acquired with original use commencing, after the cutoff date: December 31, 1968, or April 11, 2005 for a facility described solely by paragraph (5) (section 169(d)(4)(A),(B))";
}
@source(IRC_S169_D, quote = "(i) the construction, reconstruction, or erection of which is completed by the taxpayer after December 31, 1968, or")
rule FacilityConstructedAfter1968(p: Person, facility: Integer, on: Date) strict {
    label en official "completed after December 31, 1968";
    when facility_construction_completed_on(p, facility, on);
    when on > @1968-12-31;
    when not_known(facility_described_solely_by_paragraph_5(p, facility));
    then facility_completion_or_acquisition_date_met(p, facility);
}
@source(IRC_S169_D, quote = "(ii) acquired after December 31, 1968, if the original use of the property commences with the taxpayer and commences after such date.")
rule FacilityAcquiredAfter1968(p: Person, facility: Integer, on: Date) strict {
    label en official "acquired, with original use commencing, after December 31, 1968";
    when facility_acquired_with_original_use_commencing_on(p, facility, on);
    when on > @1968-12-31;
    when not_known(facility_described_solely_by_paragraph_5(p, facility));
    then facility_completion_or_acquisition_date_met(p, facility);
}
@source(IRC_S169_D, quote = "In the case of any facility described in paragraph (1) solely by reason of paragraph (5), subparagraph (A) shall be applied by substituting \"April 11, 2005\" for \"December 31, 1968\" each place it appears therein.")
rule FacilityConstructedAfter2005(p: Person, facility: Integer, on: Date) strict {
    label en official "completed after April 11, 2005, for a facility of paragraph (5)";
    when facility_construction_completed_on(p, facility, on);
    when on > @2005-04-11;
    when facility_described_solely_by_paragraph_5(p, facility);
    then facility_completion_or_acquisition_date_met(p, facility);
}
@source(IRC_S169_D, quote = "In the case of any facility described in paragraph (1) solely by reason of paragraph (5), subparagraph (A) shall be applied by substituting \"April 11, 2005\" for \"December 31, 1968\" each place it appears therein.")
rule FacilityAcquiredAfter2005(p: Person, facility: Integer, on: Date) strict {
    label en official "acquired, with original use commencing, after April 11, 2005, for a facility of paragraph (5)";
    when facility_acquired_with_original_use_commencing_on(p, facility, on);
    when on > @2005-04-11;
    when facility_described_solely_by_paragraph_5(p, facility);
    then facility_completion_or_acquisition_date_met(p, facility);
}
pub relation new_identifiable_treatment_facility(p: Person, facility: Integer) kind institutional {
    label en official "a new identifiable treatment facility (section 169(d)(4)(A))";
}
@source(IRC_S169_D, quote = "the term \"new identifiable treatment facility\" includes only tangible property (not including a building and its structural components, other than a building which is exclusively a treatment facility)")
rule NewIdentifiableTreatmentFacilityNotBuilding(p: Person, facility: Integer) strict {
    label en official "tangible depreciable property identifiable as a treatment facility, not a building, meeting the date test";
    when facility_is_tangible_depreciable_property_identifiable_as_treatment_facility(p, facility);
    when not_known(facility_is_building_or_structural_component(p, facility));
    when facility_completion_or_acquisition_date_met(p, facility);
    then new_identifiable_treatment_facility(p, facility);
}
@source(IRC_S169_D, quote = "other than a building which is exclusively a treatment facility)")
rule NewIdentifiableTreatmentFacilityExclusiveBuilding(p: Person, facility: Integer) strict {
    label en official "a building that is exclusively a treatment facility";
    when facility_is_tangible_depreciable_property_identifiable_as_treatment_facility(p, facility);
    when facility_is_building_or_structural_component(p, facility);
    when building_is_exclusively_a_treatment_facility(p, facility);
    when facility_completion_or_acquisition_date_met(p, facility);
    then new_identifiable_treatment_facility(p, facility);
}
pub relation new_identifiable_test_failed(p: Person, facility: Integer) kind institutional {
    label en official "the facility has been tested under section 169(d)(4) and is not a new identifiable treatment facility";
}
@source(IRC_S169_D, quote = "For purposes of paragraph (1), the term \"new identifiable treatment facility\" includes only tangible property")
rule NewIdentifiableTestFailed(p: Person, facility: Integer) strict {
    label en official "the test facts are given and the facility does not qualify";
    when facility_is_tangible_depreciable_property_identifiable_as_treatment_facility(p, facility);
    when not_known(new_identifiable_treatment_facility(p, facility));
    then new_identifiable_test_failed(p, facility);
}
pub relation facility_basis_attributable_to_construction_after_cutoff(p: Person, facility: Integer, amount: Money) kind empirical {
    label en official "the portion of the basis properly attributable to construction, reconstruction or erection after the cutoff date (section 169(d)(4)(A) last sentence)";
}
pub relation facility_adjusted_basis_169(p: Person, facility: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the facility";
}
@source(IRC_S169_D, quote = "In applying this section in the case of property described in clause (i) there shall be taken into account only that portion of the basis which is properly attributable to construction, reconstruction, or erection after December 31, 1968.")
rule EligibleBasisConstructedFacility(p: Person, facility: Integer, on: Date, portion: Money) strict {
    label en official "only the basis attributable to construction after the cutoff";
    when facility_construction_completed_on(p, facility, on);
    when new_identifiable_treatment_facility(p, facility);
    when facility_basis_attributable_to_construction_after_cutoff(p, facility, portion);
    then eligible_adjusted_basis_before_useful_life_ratio(p, facility, portion);
}
@source(IRC_S169_D, quote = "(ii) acquired after December 31, 1968, if the original use of the property commences with the taxpayer and commences after such date.")
rule EligibleBasisAcquiredFacility(p: Person, facility: Integer, on: Date, basis: Money) strict {
    label en official "the whole basis of a facility acquired with original use commencing after the cutoff";
    when facility_acquired_with_original_use_commencing_on(p, facility, on);
    when new_identifiable_treatment_facility(p, facility);
    when facility_adjusted_basis_169(p, facility, basis);
    then eligible_adjusted_basis_before_useful_life_ratio(p, facility, basis);
}
pub relation facility_used_with_plant_in_operation_before_1976(p: Person, facility: Integer) kind empirical {
    label en official "the facility is used in connection with a plant or other property in operation before January 1, 1976 (section 169(d)(1))";
}
pub relation atmospheric_pollution_control_facility_placed_in_service_on(p: Person, facility: Integer, on: Date) kind empirical {
    label en official "the date an atmospheric pollution control facility is placed in service (section 169(d)(5))";
}
pub relation facility_used_with_primarily_coal_fired_plant(p: Person, facility: Integer) kind empirical {
    label en official "the facility is used in connection with an electric generation plant or other property which is primarily coal fired (section 169(d)(5))";
}
pub relation coal_fired_atmospheric_facility_paragraph_5(p: Person, facility: Integer) kind institutional {
    label en official "paragraph (5) applies: an atmospheric pollution control facility placed in service after April 11, 2005 and used with a primarily coal-fired plant (section 169(d)(5))";
}
@source(IRC_S169_D, quote = "In the case of any atmospheric pollution control facility which is placed in service after April 11, 2005, and used in connection with an electric generation plant or other property which is primarily coal fired—")
rule CoalFiredAtmosphericFacility(p: Person, facility: Integer, on: Date) strict {
    label en official "placed in service after April 11, 2005 and used with a primarily coal-fired plant";
    when atmospheric_pollution_control_facility_placed_in_service_on(p, facility, on);
    when on > @2005-04-11;
    when facility_used_with_primarily_coal_fired_plant(p, facility);
    then coal_fired_atmospheric_facility_paragraph_5(p, facility);
}
@source(IRC_S169_D, quote = "(A) paragraph (1) shall be applied without regard to the phrase \"in operation before January 1, 1976\", and")
rule PlantConditionPre1976(p: Person, facility: Integer) strict {
    label en official "a plant in operation before 1976";
    when facility_used_with_plant_in_operation_before_1976(p, facility);
    then facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(p, facility);
}
@source(IRC_S169_D, quote = "(A) paragraph (1) shall be applied without regard to the phrase \"in operation before January 1, 1976\", and")
rule PlantConditionCoalFired(p: Person, facility: Integer) strict {
    label en official "the date phrase is disregarded for a coal-fired facility of paragraph (5)";
    when coal_fired_atmospheric_facility_paragraph_5(p, facility);
    then facility_used_with_plant_in_operation_before_1976_or_coal_fired_after_2005(p, facility);
}
pub relation plant_placed_in_operation_on(p: Person, facility: Integer, on: Date) kind empirical {
    label en official "the date the plant or other property is placed in operation (section 169(d)(5)(B))";
}
@source(IRC_S169_D, quote = "(B) in the case of a facility placed in service in connection with a plant or other property placed in operation after December 31, 1975, this section shall be applied by substituting \"84\" for \"60\" each place it appears in subsections (a) and (b).")
rule PlantPlacedInOperationAfter1975(p: Person, facility: Integer, on: Date) strict {
    label en official "a paragraph (5) facility of a plant placed in operation after 1975 uses 84 months";
    when coal_fired_atmospheric_facility_paragraph_5(p, facility);
    when plant_placed_in_operation_on(p, facility, on);
    when on > @1975-12-31;
    then facility_in_connection_with_plant_placed_in_operation_after_1975(p, facility);
}

// === §169(i): life tenant and remainderman ============================================================================================

pub relation property_held_for_life_with_remainder(facility: Integer, life_tenant: Person, remainderman: Person) kind empirical {
    label en official "the property is held by one person for life with remainder to another person (section 169(i))";
}
pub relation deduction_computed_as_if_life_tenant_were_absolute_owner_169(life_tenant: Person, facility: Integer) kind institutional {
    label en official "the deduction is computed as if the life tenant were the absolute owner and is allowable to the life tenant (section 169(i))";
}
@source(IRC_S169_I, quote = "the deduction under this section shall be computed as if the life tenant were the absolute owner of the property and shall be allowable to the life tenant.")
rule LifeTenantTreatedAsAbsoluteOwner(facility: Integer, life_tenant: Person, remainderman: Person) strict {
    label en official "the life tenant is the owner for the deduction";
    when property_held_for_life_with_remainder(facility, life_tenant, remainderman);
    then deduction_computed_as_if_life_tenant_were_absolute_owner_169(life_tenant, facility);
}

// === §179B(c),(e) and §179C(g): the basis reduction and the allocation to cooperative owners ===============================

pub relation property_basis_reduction_179b(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the basis of property is reduced by the portion of the cost taken into account under subsection (a): the deduction (section 179B(c)(1))";
}
@source(IRC_S179B_C, quote = "For purposes of this title, the basis of any property shall be reduced by the portion of the cost of such property taken into account under subsection (a).")
rule PropertyBasisReduction179b(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the cost taken into account is the deduction";
    when section_179b_deduction(p, y, amount);
    then property_basis_reduction_179b(p, y, amount);
}
pub relation property_of_depreciable_character_179b(p: Person, y: TaxableYear) kind empirical {
    label en official "the property is of a character subject to the allowance for depreciation (section 179B(c)(2))";
}
pub relation deduction_treated_as_depreciation_for_1245_179b(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for section 1245 the section 179B deduction is treated as a deduction allowed for depreciation under section 167 (section 179B(c)(2))";
}
@source(IRC_S179B_C, quote = "For purposes of section 1245, the amount of the deduction allowable under subsection (a) with respect to any property which is of a character subject to the allowance for depreciation shall be treated as a deduction allowed for depreciation under section 167.")
rule DeductionTreatedAsDepreciationFor1245(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "recapture as depreciation";
    when section_179b_deduction(p, y, amount);
    when property_of_depreciable_character_179b(p, y);
    then deduction_treated_as_depreciation_for_1245_179b(p, y, amount);
}
pub relation coop_taxpayer_in_subchapter_t_part_i(p: Person, y: TaxableYear) kind empirical {
    label en official "the refiner or taxpayer is an organization to which part I of subchapter T applies (section 179B(e)(1)(A), 179C(g)(1)(A))";
}
pub relation coop_owner_in_subchapter_t_part_i(owner: Person, p: Person, y: TaxableYear) kind empirical {
    label en official "a person directly holding an ownership interest in the taxpayer is an organization to which part I of subchapter T applies (section 179B(e)(1)(B), 179C(g)(1)(B))";
}
pub relation coop_allocation_election_made_179b(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the refiner elects to allocate an amount of the deduction to its owners, on a timely filed return for the year (section 179B(e)(1),(2))";
}
pub relation coop_owner_ownership_percent(owner: Person, p: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en official "the owner's ratable share, as a percentage, determined on the basis of its ownership interest in the taxpayer among the owners receiving the allocation (section 179B(e)(1), 179C(g)(1))";
}
pub relation allocation_election_on_timely_return_179b(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return for the year (section 179B(e)(2))";
}
pub relation owner_allocation_179b(owner: Person, p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the section 179B deduction allocated to an owner: its ratable share of the amount allocated (section 179B(e)(1))";
}
@source(IRC_S179B_E, quote = "the refiner may elect to allocate all or a portion of the deduction allowable under subsection (a) to such persons. Such allocation shall be equal to the person's ratable share of the total amount allocated, determined on the basis of the person's ownership interest in the taxpayer.")
rule OwnerAllocation179b(owner: Person, p: Person, y: TaxableYear, allocated: Money, pct: Decimal) strict {
    label en official "the allocated amount times the owner's percentage; only a subchapter T refiner and owner, on a timely return";
    when coop_taxpayer_in_subchapter_t_part_i(p, y);
    when coop_owner_in_subchapter_t_part_i(owner, p, y);
    when coop_allocation_election_made_179b(p, y, allocated);
    when allocation_election_on_timely_return_179b(p, y);
    when coop_owner_ownership_percent(owner, p, y, pct);
    then owner_allocation_179b(owner, p, y, div_round(allocated * pct, 100.0, 2, "HALF_UP"));
}
pub relation taxable_income_not_reduced_under_1382_for_allocation_179b(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the refiner's taxable income is not reduced under section 1382 by an amount allocated to owners (section 179B(e)(1))";
}
@source(IRC_S179B_E, quote = "The taxable income of the refiner shall not be reduced under section 1382 by reason of any amount to which the preceding sentence applies.")
rule TaxableIncomeNotReducedUnder1382For179b(p: Person, y: TaxableYear, owner: Person, amount: Money) strict {
    label en official "the allocated amount does not reduce the refiner's taxable income";
    when owner_allocation_179b(owner, p, y, amount);
    then taxable_income_not_reduced_under_1382_for_allocation_179b(p, y, amount);
}
pub relation allocation_election_irrevocable_for_year_179b(p: Person, y: TaxableYear) kind institutional {
    label en official "the election is irrevocable for the taxable year (section 179B(e)(2))";
}
@source(IRC_S179B_E, quote = "Such election, once made, shall be irrevocable for such taxable year.")
rule AllocationElectionIrrevocable179b(p: Person, y: TaxableYear, allocated: Money) strict {
    label en official "irrevocable once made";
    when coop_allocation_election_made_179b(p, y, allocated);
    when allocation_election_on_timely_return_179b(p, y);
    then allocation_election_irrevocable_for_year_179b(p, y);
}
pub relation allocation_return_due_date_179b(p: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "the due date of the return with the allocation election (section 179B(e)(3))";
}
pub relation written_notice_of_allocation_given_179b(p: Person, y: TaxableYear, owner: Person) kind empirical {
    label en official "the cooperative gave the owner written notice of the amount of the allocation (section 179B(e)(3))";
}
@source(IRC_S179B_E, quote = "If any portion of the deduction available under subsection (a) is allocated to owners under paragraph (1), the cooperative shall provide any owner receiving an allocation written notice of the amount of the allocation.")
rule CooperativeNoticeDuty179b defeasible {
    for p: Person;
    for y: TaxableYear;
    for owner: Person;
    for allocated: Money;
    for due: Date;
    when owner_allocation_179b(owner, p, y, allocated);
    when allocation_return_due_date_179b(p, y, due);
    then duty S179bNoticeToOwner {
        bearer p;
        goal achievement {
            condition written_notice_of_allocation_given_179b(p, y, owner);
            window [-infinity, due];
        }
    };
}
pub relation coop_allocation_election_made_179c(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer elects to allocate an amount of the section 179C deduction to its owners, on a timely filed return for the year (section 179C(g)(1),(2))";
}
pub relation allocation_election_on_timely_return_179c(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on a timely filed return for the year (section 179C(g)(2))";
}
pub relation owner_allocation_179c(owner: Person, p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the section 179C deduction allocated to an owner: its ratable share of the amount allocated (section 179C(g)(1))";
}
@source(IRC_S179C_G, quote = "the taxpayer may elect to allocate all or a portion of the deduction allowable under subsection (a) to such persons. Such allocation shall be equal to the person's ratable share of the total amount allocated, determined on the basis of the person's ownership interest in the taxpayer.")
rule OwnerAllocation179c(owner: Person, p: Person, y: TaxableYear, allocated: Money, pct: Decimal) strict {
    label en official "the allocated amount times the owner's percentage";
    when coop_taxpayer_in_subchapter_t_part_i(p, y);
    when coop_owner_in_subchapter_t_part_i(owner, p, y);
    when coop_allocation_election_made_179c(p, y, allocated);
    when allocation_election_on_timely_return_179c(p, y);
    when coop_owner_ownership_percent(owner, p, y, pct);
    then owner_allocation_179c(owner, p, y, div_round(allocated * pct, 100.0, 2, "HALF_UP"));
}
pub relation taxable_income_not_reduced_under_1382_for_allocation_179c(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxpayer's taxable income is not reduced under section 1382 by an amount allocated to owners (section 179C(g)(1))";
}
@source(IRC_S179C_G, quote = "The taxable income of the taxpayer shall not be reduced under section 1382 by reason of any amount to which the preceding sentence applies.")
rule TaxableIncomeNotReducedUnder1382For179c(p: Person, y: TaxableYear, owner: Person, amount: Money) strict {
    label en official "the allocated amount does not reduce taxable income";
    when owner_allocation_179c(owner, p, y, amount);
    then taxable_income_not_reduced_under_1382_for_allocation_179c(p, y, amount);
}
pub relation allocation_election_irrevocable_for_year_179c(p: Person, y: TaxableYear) kind institutional {
    label en official "the election is irrevocable for the taxable year (section 179C(g)(2))";
}
@source(IRC_S179C_G, quote = "Such election, once made, shall be irrevocable for such taxable year.")
rule AllocationElectionIrrevocable179c(p: Person, y: TaxableYear, allocated: Money) strict {
    label en official "irrevocable once made";
    when coop_allocation_election_made_179c(p, y, allocated);
    when allocation_election_on_timely_return_179c(p, y);
    then allocation_election_irrevocable_for_year_179c(p, y);
}
pub relation allocation_return_due_date_179c(p: Person, y: TaxableYear, due: Date) kind empirical {
    label en official "the due date of the return with the allocation election (section 179C(g)(3))";
}
pub relation written_notice_of_allocation_given_179c(p: Person, y: TaxableYear, owner: Person) kind empirical {
    label en official "the cooperative gave the owner written notice of the amount of the allocation (section 179C(g)(3))";
}
@source(IRC_S179C_G, quote = "If any portion of the deduction available under subsection (a) is allocated to owners under paragraph (1), the cooperative shall provide any owner receiving an allocation written notice of the amount of the allocation.")
rule CooperativeNoticeDuty179c defeasible {
    for p: Person;
    for y: TaxableYear;
    for owner: Person;
    for allocated: Money;
    for due: Date;
    when owner_allocation_179c(owner, p, y, allocated);
    when allocation_return_due_date_179c(p, y, due);
    then duty S179cNoticeToOwner {
        bearer p;
        goal achievement {
            condition written_notice_of_allocation_given_179c(p, y, owner);
            window [-infinity, due];
        }
    };
}

// === §179C(b)(2), §179E(b)(2): revocation only with the consent of the Secretary ==========================================

pub relation revokes_section_179c_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes its election under section 179C (section 179C(b)(2))";
}
pub relation secretary_consents_to_revocation_179c(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation (section 179C(b)(2))";
}
pub relation section_179c_election_revoked(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 179C election is revoked with the consent of the Secretary";
}
@source(IRC_S179C_B, quote = "Any election made under this section may not be revoked except with the consent of the Secretary.")
rule Section179cRevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "revocable only with consent";
    when revokes_section_179c_election(p, y);
    then power S179cRefineryRevokeElection {
        holder p;
        over y;
        exercise revokes_section_179c_election(p, y);
        valid_when secretary_consents_to_revocation_179c(p, y);
        effect create(section_179c_election_revoked(p, y));
        window [@2005-08-08, infinity);
    };
}
pub relation revokes_section_179e_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes its election under section 179E (section 179E(b)(2))";
}
pub relation secretary_consents_to_revocation_179e(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation (section 179E(b)(2))";
}
pub relation section_179e_election_revoked(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 179E election is revoked with the consent of the Secretary";
}
@source(IRC_S179E_B, quote = "Any election made under this section may not be revoked except with the consent of the Secretary.")
rule Section179eRevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "revocable only with consent";
    when revokes_section_179e_election(p, y);
    then power S179eMineRevokeElection {
        holder p;
        over y;
        exercise revokes_section_179e_election(p, y);
        valid_when secretary_consents_to_revocation_179e(p, y);
        effect create(section_179e_election_revoked(p, y));
        window [@2006-12-20, infinity);
    };
}

// === §179C(c),(d),(e): qualified refinery property ==================================================================================

pub relation refinery_located_in_united_states(refinery: Integer) kind empirical {
    label en official "the refinery is located in the United States (section 179C(d))";
}
pub relation refinery_designed_to_process_liquid_fuel_from_crude_oil(refinery: Integer) kind empirical {
    label en official "the refinery is designed to serve the primary purpose of processing liquid fuel from crude oil (section 179C(d))";
}
pub relation refinery_designed_to_process_qualified_fuels_45k(refinery: Integer) kind empirical {
    label en official "the refinery is designed to serve the primary purpose of processing liquid fuel from qualified fuels (section 45K(c)) (section 179C(d))";
}
pub relation refinery_designed_to_process_shale_or_tar_sands_directly(refinery: Integer) kind empirical {
    label en official "the refinery is designed to serve the primary purpose of processing liquid fuel directly from shale or tar sands (section 179C(d))";
}
pub relation qualified_refinery(refinery: Integer) kind institutional {
    label en official "a qualified refinery (section 179C(d))";
}
@source(IRC_S179C_D, quote = "the term \"qualified refinery\" means any refinery located in the United States which is designed to serve the primary purpose of processing liquid fuel from crude oil or qualified fuels")
rule QualifiedRefineryCrude(refinery: Integer) strict {
    label en official "a United States refinery designed to process liquid fuel from crude oil";
    when refinery_located_in_united_states(refinery);
    when refinery_designed_to_process_liquid_fuel_from_crude_oil(refinery);
    then qualified_refinery(refinery);
}
@source(IRC_S179C_D, quote = "the term \"qualified refinery\" means any refinery located in the United States which is designed to serve the primary purpose of processing liquid fuel from crude oil or qualified fuels")
rule QualifiedRefineryQualifiedFuels(refinery: Integer) strict {
    label en official "a United States refinery designed to process liquid fuel from qualified fuels";
    when refinery_located_in_united_states(refinery);
    when refinery_designed_to_process_qualified_fuels_45k(refinery);
    then qualified_refinery(refinery);
}
@source(IRC_S179C_D, quote = "or directly from shale or tar sands.")
rule QualifiedRefineryShaleTarSands(refinery: Integer) strict {
    label en official "a United States refinery designed to process liquid fuel directly from shale or tar sands";
    when refinery_located_in_united_states(refinery);
    when refinery_designed_to_process_shale_or_tar_sands_directly(refinery);
    then qualified_refinery(refinery);
}
pub relation refinery_portion_output_increase_percent(item: Integer, pct: Decimal) kind empirical {
    label en official "the percentage by which the portion enables the existing qualified refinery to increase total volume output, without asphalt or lube oil, on an average daily basis (section 179C(e)(1))";
}
pub relation refinery_portion_processing_rate_percent_of_throughput(item: Integer, pct: Decimal) kind empirical {
    label en official "the rate, as a percentage of total throughput on an average daily basis, at which the portion enables the existing refinery to process shale, tar sands or qualified fuels (section 179C(e)(2))";
}
pub relation portion_meets_production_capacity_requirement_179ce(item: Integer) kind institutional {
    label en official "the portion meets the production capacity requirement of subsection (e)";
}
@source(IRC_S179C_E, quote = "(1) enables the existing qualified refinery to increase total volume output (determined without regard to asphalt or lube oil) by 5 percent or more on an average daily basis, or")
rule ProductionCapacityOutputIncrease(item: Integer, pct: Decimal) strict {
    label en official "an output increase of 5 percent or more";
    when refinery_portion_output_increase_percent(item, pct);
    when pct >= 5.0;
    then portion_meets_production_capacity_requirement_179ce(item);
}
@source(IRC_S179C_E, quote = "(2) enables the existing qualified refinery to process shale, tar sands, or qualified fuels (as defined in section 45K(c)) at a rate which is equal to or greater than 25 percent of the total throughput of such qualified refinery on an average daily basis.")
rule ProductionCapacityProcessingRate(item: Integer, pct: Decimal) strict {
    label en official "a processing rate of 25 percent or more of the throughput";
    when refinery_portion_processing_rate_percent_of_throughput(item, pct);
    when pct >= 25.0;
    then portion_meets_production_capacity_requirement_179ce(item);
}
pub relation refinery_property_portion(p: Person, y: TaxableYear, item: Integer, refinery: Integer, amount: Money) kind empirical {
    label en official "a portion of a refinery placed in service by the taxpayer in the year, with its cost (section 179C(c)(1))";
}
pub relation refinery_portion_original_use_commences_with_taxpayer(p: Person, item: Integer) kind empirical {
    label en official "the original use of the portion commences with the taxpayer (section 179C(c)(1)(A))";
}
pub relation refinery_portion_originally_placed_in_service_on(p: Person, item: Integer, on: Date) kind empirical {
    label en official "the date the portion was originally placed in service (section 179C(c)(2)(A))";
}
pub relation refinery_portion_sold_and_leased_back_on(p: Person, item: Integer, sold: Date, leaseback_use: Date) kind empirical {
    label en official "the portion was sold and leased back by the person, the sale date and the date it is used under the leaseback (section 179C(c)(2)(B))";
}
pub relation refinery_portion_effective_placed_in_service_179c(p: Person, item: Integer, on: Date) kind institutional {
    label en official "the date the portion is treated as originally placed in service: for a sale-leaseback within 3 months, not earlier than the date it is used under the leaseback (section 179C(c)(2))";
}
@source(IRC_S179C_C, quote = "such property shall be treated as originally placed in service not earlier than the date on which such property is used under the leaseback referred to in subparagraph (B).")
rule RefineryEffectiveDateLeaseback(p: Person, item: Integer, original: Date, sold: Date, leaseback: Date) strict {
    label en official "the leaseback date, when the sale and leaseback are within 3 months of the original placement";
    when refinery_portion_originally_placed_in_service_on(p, item, original);
    when refinery_portion_sold_and_leased_back_on(p, item, sold, leaseback);
    when sold <= add_calendar_period(original, 3 calendar_month);
    then refinery_portion_effective_placed_in_service_179c(p, item, leaseback);
}
@source(IRC_S179C_C, quote = "(B) which is placed in service by the taxpayer after the date of the enactment of this section and before January 1, 2014,")
rule RefineryEffectiveDateOriginal(p: Person, item: Integer, original: Date, sold: Date, leaseback: Date) strict {
    label en official "the original date, when the sale-leaseback is later than 3 months after it";
    when refinery_portion_originally_placed_in_service_on(p, item, original);
    when refinery_portion_sold_and_leased_back_on(p, item, sold, leaseback);
    when sold > add_calendar_period(original, 3 calendar_month);
    then refinery_portion_effective_placed_in_service_179c(p, item, original);
}
@source(IRC_S179C_C, quote = "(B) which is placed in service by the taxpayer after the date of the enactment of this section and before January 1, 2014,")
rule RefineryEffectiveDateNoLeaseback(p: Person, item: Integer, original: Date) strict {
    label en official "the original date without a leaseback";
    when refinery_portion_originally_placed_in_service_on(p, item, original);
    when not_known(refinery_portion_leaseback_present(p, item));
    then refinery_portion_effective_placed_in_service_179c(p, item, original);
}
pub relation refinery_portion_leaseback_present(p: Person, item: Integer) kind institutional {
    label en official "helper: a sale-leaseback is given for the portion";
}
rule RefineryLeasebackPresentKeyed(p: Person, item: Integer, sold: Date, leaseback: Date) strict {
    label en official "helper";
    when refinery_portion_sold_and_leased_back_on(p, item, sold, leaseback);
    then refinery_portion_leaseback_present(p, item);
}
pub relation refinery_portion_is_separate_from_existing_refinery(item: Integer) kind empirical {
    label en official "the portion is of a qualified refinery separate from any existing refinery, so subsection (e) does not apply (section 179C(c)(1)(C))";
}
pub relation refinery_portion_meets_environmental_laws(item: Integer) kind empirical {
    label en official "the portion meets all applicable environmental laws in effect on the date it was placed in service (section 179C(c)(1)(D))";
}
pub relation refinery_portion_meets_environmental_laws_only_by_clean_air_act_waiver(item: Integer) kind empirical {
    label en official "the portion meets the environmental laws only by reason of a waiver under the Clean Air Act (section 179C(c)(3))";
}
pub relation written_binding_contract_for_refinery_portion_in_effect_on_or_before_2005_06_14(item: Integer) kind empirical {
    label en official "a written binding contract for the construction of the portion was in effect on or before June 14, 2005 (section 179C(c)(1)(E))";
}
pub relation refinery_portion_construction_under_binding_contract_entered_on(item: Integer, on: Date) kind empirical {
    label en official "the date a written binding construction contract for the portion was entered into (section 179C(c)(1)(F)(i))";
}
pub relation refinery_self_constructed_portion_construction_began_on(item: Integer, on: Date) kind empirical {
    label en official "the date the construction of the self-constructed portion began (section 179C(c)(1)(F)(iii))";
}
pub relation refinery_portion_binding_contract_or_dates_met(item: Integer, placed: Date) kind institutional {
    label en official "clause (F) is met: a binding contract entered into before 2010, placement in service before 2010, or self-construction begun after June 14, 2005 and before 2010 (section 179C(c)(1)(F))";
}
pub relation refinery_portion_effective_date_for_F(p: Person, item: Integer, placed: Date) kind institutional {
    label en official "helper: the effective placed-in-service date used by clause (F)(ii)";
}
rule RefineryEffectiveDateForF(p: Person, item: Integer, placed: Date) strict {
    label en official "helper";
    when refinery_portion_effective_placed_in_service_179c(p, item, placed);
    then refinery_portion_effective_date_for_F(p, item, placed);
}
@source(IRC_S179C_C, quote = "(i) the construction of which is subject to a written binding construction contract entered into before January 1, 2010,")
rule RefineryClauseFContract(p: Person, item: Integer, placed: Date, entered: Date) strict {
    label en official "a binding construction contract entered into before 2010";
    when refinery_portion_effective_placed_in_service_179c(p, item, placed);
    when refinery_portion_construction_under_binding_contract_entered_on(item, entered);
    when entered < @2010-01-01;
    then refinery_portion_binding_contract_or_dates_met(item, placed);
}
@source(IRC_S179C_C, quote = "(ii) which is placed in service before January 1, 2010, or")
rule RefineryClauseFPlacedBefore2010(p: Person, item: Integer, placed: Date) strict {
    label en official "placed in service before 2010";
    when refinery_portion_effective_placed_in_service_179c(p, item, placed);
    when placed < @2010-01-01;
    then refinery_portion_binding_contract_or_dates_met(item, placed);
}
@source(IRC_S179C_C, quote = "(iii) in the case of self-constructed property, the construction of which began after June 14, 2005, and before January 1, 2010.")
rule RefineryClauseFSelfConstructed(p: Person, item: Integer, placed: Date, began: Date) strict {
    label en official "self-constructed property begun after June 14, 2005 and before 2010";
    when refinery_portion_effective_placed_in_service_179c(p, item, placed);
    when refinery_self_constructed_portion_construction_began_on(item, began);
    when began > @2005-06-14;
    when began < @2010-01-01;
    then refinery_portion_binding_contract_or_dates_met(item, placed);
}
pub relation qualified_refinery_property_conditions_met(p: Person, item: Integer) kind institutional {
    label en official "the portion is qualified refinery property: clauses (A) to (F) of section 179C(c)(1) are met";
}
@source(IRC_S179C_C, quote = "The term \"qualified refinery property\" means any portion of a qualified refinery—")
rule QualifiedRefineryPropertyConditions(p: Person, y: TaxableYear, item: Integer, refinery: Integer, amount: Money, placed: Date) strict {
    label en official "portion of a qualified refinery: original use, the placed-in-service window, capacity, environmental laws, no early binding contract, and clause (F)";
    when refinery_property_portion(p, y, item, refinery, amount);
    when qualified_refinery(refinery);
    when refinery_portion_original_use_commences_with_taxpayer(p, item);
    when refinery_portion_effective_placed_in_service_179c(p, item, placed);
    when placed > @2005-08-08;
    when placed < @2014-01-01;
    when refinery_portion_meets_environmental_laws(item);
    when not_known(refinery_portion_meets_environmental_laws_only_by_clean_air_act_waiver(item));
    when not_known(written_binding_contract_for_refinery_portion_in_effect_on_or_before_2005_06_14(item));
    when refinery_portion_binding_contract_or_dates_met(item, placed);
    when not_known(portion_needs_capacity_test_unmet(item));
    then qualified_refinery_property_conditions_met(p, item);
}
pub relation portion_needs_capacity_test_unmet(item: Integer) kind institutional {
    label en official "helper: the portion is not of a separate refinery and does not meet the production capacity requirement";
}
@source(IRC_S179C_C, quote = "(C) in the case any portion of a qualified refinery (other than a qualified refinery which is separate from any existing refinery), which meets the requirements of subsection (e),")
rule CapacityTestUnmet(item: Integer, pct0: Decimal) strict {
    label en official "an existing refinery portion that does not meet subsection (e)";
    when refinery_portion_output_increase_percent(item, pct0);
    when not_known(refinery_portion_is_separate_from_existing_refinery(item));
    when not_known(portion_meets_production_capacity_requirement_179ce(item));
    then portion_needs_capacity_test_unmet(item);
}
@source(IRC_S179C_C, quote = "(C) in the case any portion of a qualified refinery (other than a qualified refinery which is separate from any existing refinery), which meets the requirements of subsection (e),")
rule QualifiedRefineryPropertyCostDerived(p: Person, y: TaxableYear, item: Integer, refinery: Integer, amount: Money) strict {
    label en official "the cost of qualified refinery property; an amount asserted by a case is still accepted";
    when refinery_property_portion(p, y, item, refinery, amount);
    when qualified_refinery_property_conditions_met(p, item);
    then qualified_refinery_property_cost(p, y, item, amount);
}

// === §179E(c),(d): advanced mine safety equipment ======================================================================================

pub enum MineSafetyEquipmentKind {
    EmergencyCommunicationTechnology;
    ElectronicIdentificationAndLocationDevice;
    EmergencyOxygenGeneratingSelfRescueDevice;
    PrePositionedOxygenSupplies;
    ComprehensiveAtmosphericMonitoringSystem;
    OtherEquipment;
}
pub relation mine_equipment_kind(item: Integer, kind: MineSafetyEquipmentKind) kind empirical {
    label en official "the kind of equipment (section 179E(d)(1)-(5))";
}
pub relation self_rescue_device_oxygen_minutes(item: Integer, minutes: Integer) kind empirical {
    label en official "the minutes of oxygen the self-rescue device provides (section 179E(d)(3))";
}
pub relation pre_positioned_oxygen_survival_hours(item: Integer, hours: Integer) kind empirical {
    label en official "the hours of survival the pre-positioned supplies of oxygen, with self-rescue devices, provide each miner on a shift (section 179E(d)(4))";
}
pub relation advanced_mine_safety_equipment_property(item: Integer) kind institutional {
    label en official "advanced mine safety equipment property (section 179E(d))";
}
@source(IRC_S179E_D, quote = "(1) Emergency communication technology or device which is used to allow a miner to maintain constant communication with an individual who is not in the mine.")
rule MineEquipmentCommunication(item: Integer) strict {
    label en official "emergency communication technology";
    when mine_equipment_kind(item, EmergencyCommunicationTechnology);
    then advanced_mine_safety_equipment_property(item);
}
@source(IRC_S179E_D, quote = "(2) Electronic identification and location device which allows an individual who is not in the mine to track at all times the movements and location of miners working in or at the mine.")
rule MineEquipmentLocation(item: Integer) strict {
    label en official "an electronic identification and location device";
    when mine_equipment_kind(item, ElectronicIdentificationAndLocationDevice);
    then advanced_mine_safety_equipment_property(item);
}
@source(IRC_S179E_D, quote = "(3) Emergency oxygen-generating, self-rescue device which provides oxygen for at least 90 minutes.")
rule MineEquipmentSelfRescue(item: Integer, minutes: Integer) strict {
    label en official "a self-rescue device providing oxygen for at least 90 minutes";
    when mine_equipment_kind(item, EmergencyOxygenGeneratingSelfRescueDevice);
    when self_rescue_device_oxygen_minutes(item, minutes);
    when minutes >= 90;
    then advanced_mine_safety_equipment_property(item);
}
@source(IRC_S179E_D, quote = "(4) Pre-positioned supplies of oxygen which (in combination with self-rescue devices) can be used to provide each miner on a shift, in the event of an accident or other event which traps the miner in the mine or otherwise necessitates the use of such a self-rescue device, the ability to survive for at least 48 hours.")
rule MineEquipmentPrePositionedOxygen(item: Integer, hours: Integer) strict {
    label en official "pre-positioned oxygen supplies giving at least 48 hours of survival";
    when mine_equipment_kind(item, PrePositionedOxygenSupplies);
    when pre_positioned_oxygen_survival_hours(item, hours);
    when hours >= 48;
    then advanced_mine_safety_equipment_property(item);
}
@source(IRC_S179E_D, quote = "(5) Comprehensive atmospheric monitoring system which monitors the levels of carbon monoxide, methane, and oxygen that are present in all areas of the mine and which can detect smoke in the case of a fire in a mine.")
rule MineEquipmentAtmosphericMonitoring(item: Integer) strict {
    label en official "a comprehensive atmospheric monitoring system";
    when mine_equipment_kind(item, ComprehensiveAtmosphericMonitoringSystem);
    then advanced_mine_safety_equipment_property(item);
}
pub relation mine_equipment_for_use_in_underground_mine_in_united_states(item: Integer) kind empirical {
    label en official "the equipment is for use in an underground mine located in the United States (section 179E(c))";
}
pub relation mine_equipment_original_use_commences_with_taxpayer(p: Person, item: Integer) kind empirical {
    label en official "the original use of the equipment commences with the taxpayer (section 179E(c)(1))";
}
pub relation mine_equipment_cost_fact(p: Person, y: TaxableYear, item: Integer, placed_in_service: Date, amount: Money) kind empirical {
    label en official "the cost of equipment placed in service by the taxpayer on the date";
}
pub relation qualified_advanced_mine_safety_equipment_property(p: Person, item: Integer, placed_in_service: Date) kind institutional {
    label en official "qualified advanced mine safety equipment property: advanced equipment for an underground mine in the United States, original use with the taxpayer, placed in service after December 20, 2006 (section 179E(c))";
}
@source(IRC_S179E_C, quote = "For purposes of this section, the term \"qualified advanced mine safety equipment property\" means any advanced mine safety equipment property for use in any underground mine located in the United States—")
rule QualifiedAdvancedMineSafetyEquipmentProperty(p: Person, y: TaxableYear, item: Integer, placed: Date, amount: Money) strict {
    label en official "advanced equipment for a United States underground mine, original use with the taxpayer, placed in service after enactment";
    when mine_equipment_cost_fact(p, y, item, placed, amount);
    when advanced_mine_safety_equipment_property(item);
    when mine_equipment_for_use_in_underground_mine_in_united_states(item);
    when mine_equipment_original_use_commences_with_taxpayer(p, item);
    when placed > @2006-12-20;
    then qualified_advanced_mine_safety_equipment_property(p, item, placed);
}
@source(IRC_S179E_C, quote = "(2) which is placed in service by the taxpayer after the date of the enactment of this section.")
rule AdvancedMineSafetyEquipmentCostDerived(p: Person, y: TaxableYear, item: Integer, placed: Date, amount: Money) strict {
    label en official "the cost of qualified equipment; an amount asserted by a case is still accepted";
    when mine_equipment_cost_fact(p, y, item, placed, amount);
    when qualified_advanced_mine_safety_equipment_property(p, item, placed);
    then advanced_mine_safety_equipment_cost(p, y, item, placed, amount);
}

// === §179D(d)(3): allocation by tax-exempt owners =====================================================================================

pub relation owner_is_governmental_unit_179d(owner: Person) kind empirical {
    label en official "the owner is the United States, a State or political subdivision, a possession, or an agency or instrumentality of any of them (section 179D(d)(3)(B)(i))";
}
pub relation owner_is_indian_tribal_government_or_alaska_native_corporation_179d(owner: Person) kind empirical {
    label en official "the owner is an Indian tribal government (section 30D(g)(9)) or an Alaska Native Corporation (section 3 of the Alaska Native Claims Settlement Act) (section 179D(d)(3)(B)(ii))";
}
pub relation owner_is_organization_exempt_from_tax_179d(owner: Person) kind empirical {
    label en official "the owner is an organization exempt from tax imposed by this chapter (section 179D(d)(3)(B)(iii))";
}
pub relation specified_tax_exempt_entity_179d(owner: Person) kind institutional {
    label en official "a specified tax-exempt entity (section 179D(d)(3)(B))";
}
@source(IRC_S179D_D, quote = "(i) the United States, any State or political subdivision thereof, any possession of the United States, or any agency or instrumentality of any of the foregoing,")
rule SpecifiedTaxExemptEntityGovernment(owner: Person) strict {
    label en official "a governmental unit";
    when owner_is_governmental_unit_179d(owner);
    then specified_tax_exempt_entity_179d(owner);
}
@source(IRC_S179D_D, quote = "(ii) an Indian tribal government (as defined in section 30D(g)(9)) or Alaska Native Corporation (as defined in section 3 of the Alaska Native Claims Settlement Act (43 U.S.C. 1602(m)),[1] and")
rule SpecifiedTaxExemptEntityTribal(owner: Person) strict {
    label en official "an Indian tribal government or Alaska Native Corporation";
    when owner_is_indian_tribal_government_or_alaska_native_corporation_179d(owner);
    then specified_tax_exempt_entity_179d(owner);
}
@source(IRC_S179D_D, quote = "(iii) any organization exempt from tax imposed by this chapter.")
rule SpecifiedTaxExemptEntityExempt(owner: Person) strict {
    label en official "an organization exempt from tax";
    when owner_is_organization_exempt_from_tax_179d(owner);
    then specified_tax_exempt_entity_179d(owner);
}
pub relation building_property_installed_on_property_owned_by(building: Integer, owner: Person) kind empirical {
    label en official "the energy efficient commercial building property is installed on or in property owned by the owner (section 179D(d)(3)(A))";
}
pub relation designer_primarily_responsible_for_designing_property(building: Integer, designer: Person) kind empirical {
    label en official "the person is primarily responsible for designing the property (section 179D(d)(3)(A))";
}
pub relation secretary_guidance_allows_allocation_to_designer(building: Integer) kind empirical {
    label en official "the Secretary's regulations or guidance allow the allocation of the deduction to the designer (section 179D(d)(3)(A))";
}
pub relation owner_allocates_179d_deduction_to_designer(building: Integer, owner: Person, designer: Person) kind empirical {
    label en official "the owner allocates the deduction to the designer";
}
pub relation designer_treated_as_taxpayer_179d(building: Integer, designer: Person) kind institutional {
    label en official "the designer is treated as the taxpayer for the deduction, in lieu of the specified tax-exempt owner (section 179D(d)(3)(A))";
}
@source(IRC_S179D_D, quote = "Such person shall be treated as the taxpayer for purposes of this section.")
rule DesignerTreatedAsTaxpayer(building: Integer, owner: Person, designer: Person) strict {
    label en official "a tax-exempt owner's designer, with guidance allowing the allocation";
    when specified_tax_exempt_entity_179d(owner);
    when building_property_installed_on_property_owned_by(building, owner);
    when designer_primarily_responsible_for_designing_property(building, designer);
    when owner_allocates_179d_deduction_to_designer(building, owner, designer);
    when secretary_guidance_allows_allocation_to_designer(building);
    then designer_treated_as_taxpayer_179d(building, designer);
}
pub relation building_owned_by_specified_tax_exempt_entity_179d(building: Integer) kind institutional {
    label en official "helper: the building property is on property of a specified tax-exempt entity";
}
rule BuildingOwnedBySpecifiedEntityKeyed(building: Integer, owner: Person) strict {
    label en official "helper";
    when building_property_installed_on_property_owned_by(building, owner);
    when specified_tax_exempt_entity_179d(owner);
    then building_owned_by_specified_tax_exempt_entity_179d(building);
}
@source(IRC_S179D_D, quote = "In the case of energy efficient commercial building property installed on or in property owned by a specified tax-exempt entity, the Secretary shall promulgate regulations or guidance to allow the allocation of the deduction to the person primarily responsible for designing the property in lieu of the owner of such property.")
rule SecretaryAllocationGuidanceDuty defeasible {
    for building: Integer;
    when building_owned_by_specified_tax_exempt_entity_179d(building);
    then duty S179dPromulgateAllocationGuidance {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_guidance_allows_allocation_to_designer(building);
            window [-infinity, infinity];
        }
    };
}

// === §179D(f): the retrofit plan, retrofit property, qualified building, baseline =====================================================

pub relation individual_is_licensed_architect_or_engineer(person: Person) kind empirical {
    label en official "the individual is a licensed architect or a licensed engineer (section 179D(f)(7)(B))";
}
pub relation individual_meets_other_requirements_of_secretary_for_qualified_professional(person: Person) kind empirical {
    label en official "the individual meets such other requirements as the Secretary may provide (section 179D(f)(7)(B))";
}
pub relation qualified_professional_179d(person: Person) kind institutional {
    label en official "a qualified professional (section 179D(f)(7)(B))";
}
@source(IRC_S179D_F, quote = "The term \"qualified professional\" means an individual who is a licensed architect or a licensed engineer and meets such other requirements as the Secretary may provide.")
rule QualifiedProfessional179d(person: Person) strict {
    label en official "a licensed architect or engineer meeting the Secretary's requirements";
    when individual_is_licensed_architect_or_engineer(person);
    when individual_meets_other_requirements_of_secretary_for_qualified_professional(person);
    then qualified_professional_179d(person);
}
pub relation retrofit_plan_written_by(building: Integer, professional: Person) kind empirical {
    label en official "a written plan specifying modifications to the building, prepared by the person (section 179D(f)(2))";
}
pub relation retrofit_plan_expected_energy_use_intensity_reduction_percent(building: Integer, pct: Decimal) kind empirical {
    label en official "the reduction of the building's energy use intensity, in comparison to the baseline, that the modifications are in the aggregate expected to achieve (section 179D(f)(2))";
}
pub relation retrofit_plan_provides_for_certification_of_energy_use_intensity_before_placement(building: Integer) kind empirical {
    label en official "the plan provides for a qualified professional to certify the energy use intensity as of any date in the year ending on the placed-in-service date (section 179D(f)(2)(A))";
}
pub relation retrofit_plan_provides_for_certification_of_property_status(building: Integer) kind empirical {
    label en official "the plan provides for a qualified professional to certify the status of the installed property as meeting subparagraphs (B) and (C) of paragraph (3) (section 179D(f)(2)(B))";
}
pub relation retrofit_plan_provides_for_certification_of_energy_use_intensity_after_placement(building: Integer) kind empirical {
    label en official "the plan provides for a qualified professional to certify the energy use intensity as of a date more than 1 year after the placed-in-service date (section 179D(f)(2)(C))";
}
pub relation qualified_retrofit_plan(building: Integer) kind institutional {
    label en official "a qualified retrofit plan (section 179D(f)(2))";
}
@source(IRC_S179D_F, quote = "For purposes of this subsection, the term \"qualified retrofit plan\" means a written plan prepared by a qualified professional which specifies modifications to a building which, in the aggregate, are expected to reduce such building's energy use intensity by 25 percent or more in comparison to the baseline energy use intensity of such building.")
rule QualifiedRetrofitPlan(building: Integer, professional: Person, pct: Decimal) strict {
    label en official "a written plan by a qualified professional, expected reduction of at least 25 percent, providing for the three certifications";
    when retrofit_plan_written_by(building, professional);
    when qualified_professional_179d(professional);
    when retrofit_plan_expected_energy_use_intensity_reduction_percent(building, pct);
    when pct >= 25.0;
    when retrofit_plan_provides_for_certification_of_energy_use_intensity_before_placement(building);
    when retrofit_plan_provides_for_certification_of_property_status(building);
    when retrofit_plan_provides_for_certification_of_energy_use_intensity_after_placement(building);
    then qualified_retrofit_plan(building);
}
pub enum RetrofitSystem179d {
    InteriorLightingSystems;
    HeatingCoolingVentilationAndHotWaterSystems;
    BuildingEnvelope;
    OtherSystem;
}
pub relation retrofit_item_depreciable(item: Integer) kind empirical {
    label en official "depreciation, or amortization in lieu of depreciation, is allowable for the property (section 179D(f)(3)(A))";
}
pub relation retrofit_item_installed_on_building(item: Integer, building: Integer) kind empirical {
    label en official "the property is installed on or in the building (section 179D(f)(3)(B))";
}
pub relation retrofit_item_system(item: Integer, system: RetrofitSystem179d) kind empirical {
    label en official "the system of which the property is installed as part (section 179D(f)(3)(C))";
}
pub relation retrofit_item_certified_under_2B(item: Integer) kind empirical {
    label en official "the property is certified in accordance with paragraph (2)(B) as meeting subparagraphs (B) and (C) (section 179D(f)(3)(D))";
}
pub relation energy_efficient_building_retrofit_property(item: Integer, building: Integer) kind institutional {
    label en official "energy efficient building retrofit property of a qualified building (section 179D(f)(3))";
}
@source(IRC_S179D_F, quote = "For purposes of this subsection, the term \"energy efficient building retrofit property\" means property—")
rule EnergyEfficientBuildingRetrofitProperty(item: Integer, building: Integer, system: RetrofitSystem179d) strict {
    label en official "depreciable property installed on a qualified building as part of lighting, HVAC and hot water, or the envelope, and certified";
    when retrofit_item_depreciable(item);
    when retrofit_item_installed_on_building(item, building);
    when qualified_building_179df4(building);
    when retrofit_item_system(item, system);
    when system != OtherSystem;
    when retrofit_item_certified_under_2B(item);
    then energy_efficient_building_retrofit_property(item, building);
}
pub relation building_located_in_united_states_179d(building: Integer) kind empirical {
    label en official "the building is located in the United States (section 179D(f)(4)(A))";
}
pub relation building_originally_placed_in_service_on_179d(building: Integer, on: Date) kind empirical {
    label en official "the date the building was originally placed in service (section 179D(f)(4)(B))";
}
pub relation retrofit_plan_established_on(building: Integer, on: Date) kind empirical {
    label en official "the date the qualified retrofit plan is established (section 179D(f)(4)(B))";
}
@source(IRC_S179D_F, quote = "(B) was originally placed in service not less than 5 years before the establishment of the qualified retrofit plan with respect to such building.")
rule QualifiedBuilding179dDerived(building: Integer, placed: Date, plan: Date) strict {
    label en official "a building in the United States placed in service at least 5 years before the plan; an assertion by a case is still accepted";
    when building_located_in_united_states_179d(building);
    when building_originally_placed_in_service_on_179d(building, placed);
    when retrofit_plan_established_on(building, plan);
    when add_calendar_period(placed, 5 calendar_year) <= plan;
    then qualified_building_179df4(building);
}
pub relation energy_use_intensity_certified_before_placement(building: Integer, intensity: Decimal) kind empirical {
    label en official "the energy use intensity certified under paragraph (2)(A), in British thermal units (section 179D(f)(6)(A),(7)(A))";
}
pub relation weather_adjustment_factor_179d(building: Integer, factor: Decimal) kind empirical {
    label en official "the factor by which the certified energy use intensity is adjusted to take weather into account, determined in the manner the Secretary provides (section 179D(f)(6))";
}
@source(IRC_S179D_F, quote = "For purposes of this subsection, the term \"baseline energy use intensity\" means the energy use intensity certified under paragraph (2)(A), as adjusted to take into account weather.")
rule BaselineEnergyUseIntensityDerived(building: Integer, certified: Decimal, factor: Decimal) strict {
    label en official "the certified intensity times the weather factor; an assertion by a case is still accepted";
    when energy_use_intensity_certified_before_placement(building, certified);
    when weather_adjustment_factor_179d(building, factor);
    then baseline_energy_use_intensity(building, certified * factor);
}
