// Section 280H — limitation on certain amounts paid to employee-owners by personal service
// corporations with a section 444 election: stage 2b (TECH_GAPS G2800). (a) the limitation, (b) carry
// to the succeeding year, (c) minimum distribution requirements and the applicable percentage,
// (d) the maximum deductible amount, (e) the carryback bar, (f) definitions. Not modelled: the
// section 444(b)(4) deferral period, the section 269A(b)(2)/441(i)(2) definitions (facts).

// --- (f): definitions -----------------------------------------------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S280H_A,
    IRC_S280H_B,
    IRC_S280H_C,
    IRC_S280H_D,
    IRC_S280H_E,
    IRC_S280H_F,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation payment_to_employee_owner(c: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid by the personal service corporation to an employee-owner (section 269A(b)(2), as modified by section 441(i)(2)) in the taxable year (section 280H(f)(1))";
}
pub relation payment_includible_in_employee_gross_income(item: Integer) kind empirical {
    label en official "the payment is includible in the gross income of the employee (section 280H(f)(1))";
}
pub relation payment_is_gain_on_sale_or_exchange_of_property_between_owner_and_corporation(item: Integer) kind empirical {
    label en official "the amount is gain from the sale or exchange of property between the owner-employee and the corporation (section 280H(f)(1)(A))";
}
pub relation payment_is_dividend_paid_by_corporation(item: Integer) kind empirical {
    label en official "the amount is a dividend paid by the corporation (section 280H(f)(1)(B))";
}
pub relation payment_in_deferral_period(item: Integer) kind empirical {
    label en official "the payment is paid during the deferral period (section 444(b)(4)) of the taxable year";
}
pub relation applicable_amount_280h(c: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "an applicable amount: an amount paid to an employee-owner includible in the employee's gross income, other than gain on property transfers between owner and corporation and dividends (section 280H(f)(1))";
}
@source(IRC_S280H_F, quote = "The term \"applicable amount\" means any amount paid to an employee-owner which is includible in the gross income of such employee")
rule ApplicableAmountDefinition(c: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an includible payment to an employee-owner is an applicable amount unless it is gain on a sale or exchange between owner and corporation or a dividend (section 280H(f)(1))";
    when payment_to_employee_owner(c, y, item, amount);
    when payment_includible_in_employee_gross_income(item);
    when not_known(payment_is_gain_on_sale_or_exchange_of_property_between_owner_and_corporation(item));
    when not_known(payment_is_dividend_paid_by_corporation(item));
    then applicable_amount_280h(c, y, item, amount);
}
pub relation applicable_amounts_paid_in_year(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable amounts paid during the taxable year (sum of applicable amounts)";
}
rule ApplicableAmountsPaidInYearTotal(c: Person, y: TaxableYear, i0: Integer, a0: Money) defeasible {
    label en official "helper: sums the applicable amounts of the taxable year (section 280H(f)(1))";
    when applicable_amount_280h(c, y, i0, a0);
    then applicable_amounts_paid_in_year(c, y,
        sum all amount: Money for item: Integer where applicable_amount_280h(c, y, item, amount));
}
pub relation applicable_amount_paid_in_deferral_period_item(c: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "an applicable amount paid during the deferral period";
}
rule ApplicableAmountInDeferralPeriodItem(c: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "an applicable amount that is paid during the deferral period";
    when applicable_amount_280h(c, y, item, amount);
    when payment_in_deferral_period(item);
    then applicable_amount_paid_in_deferral_period_item(c, y, item, amount);
}
pub relation applicable_amounts_paid_in_deferral_period(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable amounts paid during the deferral period of the taxable year";
}
rule ApplicableAmountsPaidInDeferralPeriodTotal(c: Person, y: TaxableYear, i0: Integer, a0: Money) defeasible {
    label en official "helper: sums the applicable amounts paid during the deferral period";
    when applicable_amount_paid_in_deferral_period_item(c, y, i0, a0);
    then applicable_amounts_paid_in_deferral_period(c, y,
        sum all amount: Money for item: Integer where applicable_amount_paid_in_deferral_period_item(c, y, item, amount));
}
pub relation months_in_taxable_year(c: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months in the taxable year";
}
pub relation months_in_deferral_period(c: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months in the deferral period of the taxable year (section 444(b)(4))";
}
pub relation months_in_nondeferral_period(c: Person, y: TaxableYear, months: Integer) kind institutional {
    label en official "the portion of the taxable year after the deferral period (section 280H(f)(3)(B))";
}
@source(IRC_S280H_F, quote = "The term \"nondeferral period\" means the portion of the taxable year of the personal service corporation which occurs after the portion of such year constituting the deferral period.")
rule NondeferralPeriodMonths(c: Person, y: TaxableYear, total: Integer, deferral: Integer) strict {
    label en official "the nondeferral period is the rest of the taxable year after the deferral period (section 280H(f)(3)(B))";
    when months_in_taxable_year(c, y, total);
    when months_in_deferral_period(c, y, deferral);
    when total >= deferral;
    then months_in_nondeferral_period(c, y, total - deferral);
}
pub relation taxable_income_for_280h(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxable income of the corporation for the period, before the section 280H(f)(4) adjustments";
}
pub relation amounts_paid_to_employee_owners_deducted(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid to an employee-owner includible in gross income that reduced taxable income (section 280H(f)(4)(A))";
}
pub relation nol_carryover_attributable_to_employee_owner_payments(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the net operating loss carryover to the extent attributable to the amounts of paragraph (4)(A) (section 280H(f)(4)(B))";
}
pub relation adjusted_taxable_income_280h(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted taxable income: taxable income determined without regard to amounts paid to an employee-owner and the net operating loss carryover attributable to them (section 280H(f)(4))";
}
@source(IRC_S280H_F, quote = "The term \"adjusted taxable income\" means taxable income determined without regard to")
rule AdjustedTaxableIncomeAddBack(c: Person, y: TaxableYear, ti: Money, paid: Money, nol: Money) strict {
    label en official "adjusted taxable income adds back the employee-owner payments and the attributable NOL carryover (section 280H(f)(4)); the arithmetic reading of \"without regard to\" is a JUDGMENT CALL";
    when taxable_income_for_280h(c, y, ti);
    when amounts_paid_to_employee_owners_deducted(c, y, paid);
    when nol_carryover_attributable_to_employee_owner_payments(c, y, nol);
    then adjusted_taxable_income_280h(c, y, ti + paid + nol);
}

// --- (c): minimum distribution requirements ------------------------------------------------------------------------------------------------

pub relation applicable_amounts_paid_in_year_for_percentage(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the applicable amounts paid or incurred during the 3 taxable years immediately preceding the taxable year, in total (section 280H(c)(2)(A))";
}
pub relation adjusted_taxable_income_three_preceding_years(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted taxable income of the corporation for such 3 taxable years, in total (section 280H(c)(2)(B))";
}
pub relation applicable_percentage_280h(c: Person, y: TaxableYear, percent: Decimal) kind institutional {
    label en official "the applicable percentage: the 3-year applicable amounts divided by the 3-year adjusted taxable income, not in excess of 95 percent (section 280H(c)(2))";
}
@source(IRC_S280H_C, quote = "The term \"applicable percentage\" means the percentage (not in excess of 95 percent) determined by dividing")
rule ApplicablePercentageCappedAt95(c: Person, y: TaxableYear, amounts: Money, ati: Money) strict {
    label en official "the applicable percentage is the ratio of 3-year applicable amounts to 3-year adjusted taxable income, capped at 95 percent; the ratio to 8 places HALF_UP (text names no rounding; JUDGMENT CALL)";
    when applicable_amounts_paid_in_year_for_percentage(c, y, amounts);
    when adjusted_taxable_income_three_preceding_years(c, y, ati);
    when ati > 0.00 USD;
    then applicable_percentage_280h(c, y, min(0.95, div_round(amounts, ati, 8, "HALF_UP")));
}
pub relation applicable_amounts_paid_preceding_year(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the applicable amounts paid during the preceding taxable year (section 280H(c)(1)(A)(i))";
}
pub relation months_in_preceding_taxable_year(c: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months in the preceding taxable year (section 280H(c)(1)(A)(i))";
}
pub relation months_in_deferral_period_of_preceding_year(c: Person, y: TaxableYear, months: Integer) kind empirical {
    label en official "the number of months in the deferral period of the preceding taxable year (section 280H(c)(1)(A)(ii))";
}
pub relation adjusted_taxable_income_for_deferral_period(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the adjusted taxable income for the deferral period of the taxable year (section 280H(c)(1)(B))";
}
pub relation minimum_distribution_threshold(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the lesser of the prior-year monthly rate times the prior deferral months and the applicable percentage of adjusted taxable income of the deferral period (section 280H(c)(1)(A),(B))";
}
@source(IRC_S280H_C, quote = "equal or exceed the lesser of")
rule MinimumDistributionThresholdLesserOf(c: Person, y: TaxableYear, prior_paid: Money, prior_months: Integer, prior_deferral: Integer, percent: Decimal, ati: Money) strict {
    label en official "the threshold is the lesser of (A) prior-year applicable amounts / prior-year months x prior deferral months and (B) the applicable percentage x adjusted taxable income of the deferral period (section 280H(c)(1)); (A) with one rounding to cents HALF_UP";
    when applicable_amounts_paid_preceding_year(c, y, prior_paid);
    when months_in_preceding_taxable_year(c, y, prior_months);
    when months_in_deferral_period_of_preceding_year(c, y, prior_deferral);
    when applicable_percentage_280h(c, y, percent);
    when adjusted_taxable_income_for_deferral_period(c, y, ati);
    when prior_months > 0;
    then minimum_distribution_threshold(c, y, min(div_round(prior_paid * prior_deferral, prior_months * 1.0, 2, "HALF_UP"), round(ati * percent, 2, "HALF_UP")));
}
pub relation meets_minimum_distribution_requirements(c: Person, y: TaxableYear) kind institutional {
    label en official "the personal service corporation meets the minimum distribution requirements of section 280H(c) for the taxable year";
}
@source(IRC_S280H_C, quote = "A personal service corporation meets the minimum distribution requirements of this subsection if the applicable amounts paid or incurred during the deferral period of the taxable year")
rule MeetsMinimumDistributionRequirements(c: Person, y: TaxableYear, paid: Money, threshold: Money) defeasible {
    label en official "applicable amounts of the deferral period (without regard to (b)) equal or exceed the threshold (section 280H(c)(1))";
    when applicable_amounts_paid_in_deferral_period(c, y, paid);
    when minimum_distribution_threshold(c, y, threshold);
    when paid >= threshold;
    then meets_minimum_distribution_requirements(c, y);
}

// --- (d): maximum deductible amount ------------------------------------------------------------------------------------------------------------------

pub relation maximum_deductible_amount_280h(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the maximum deductible amount: the applicable amounts paid during the deferral period plus their monthly rate times the months of the nondeferral period (section 280H(d))";
}
@source(IRC_S280H_D, quote = "the term \"maximum deductible amount\" means the sum of")
rule MaximumDeductibleAmountFormula(c: Person, y: TaxableYear, paid: Money, deferral: Integer, nondeferral: Integer) defeasible {
    label en official "maximum deductible amount = deferral-period amounts + (deferral-period amounts / deferral months) x nondeferral months, one rounding to cents HALF_UP (section 280H(d))";
    when applicable_amounts_paid_in_deferral_period(c, y, paid);
    when months_in_deferral_period(c, y, deferral);
    when months_in_nondeferral_period(c, y, nondeferral);
    when deferral > 0;
    then maximum_deductible_amount_280h(c, y, paid + div_round(paid * nondeferral, deferral * 1.0, 2, "HALF_UP"));
}

// --- (a),(b): the limitation and its carry ---------------------------------------------------------------------------------------------------------------

pub relation section_444_election_in_effect_for_personal_service_corporation(c: Person, y: TaxableYear) kind empirical {
    label en official "an election by a personal service corporation under section 444 is in effect for the taxable year (section 280H(a)(1))";
}
pub relation applicable_amounts_paid_or_incurred_for_deduction(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the applicable amounts paid or incurred by the corporation to employee-owners for the taxable year, otherwise allowed as a deduction (section 280H(a))";
}
pub relation applicable_amounts_deduction_limited_to_maximum(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for applicable amounts, not exceeding the maximum deductible amount (section 280H(a))";
}
pub relation applicable_amounts_deduction_limitation_applies(c: Person, y: TaxableYear) kind institutional {
    label en official "a section 444 election is in effect and the corporation does not meet the minimum distribution requirements (section 280H(a))";
}
@source(IRC_S280H_A, quote = "then the deduction otherwise allowed under this chapter for applicable amounts paid or incurred by such corporation to employee-owners shall not exceed the maximum deductible amount")
rule Section280HLimitationApplies(c: Person, y: TaxableYear) defeasible {
    label en official "the limitation applies where a section 444 election is in effect and the minimum distribution requirements are not met (section 280H(a))";
    when section_444_election_in_effect_for_personal_service_corporation(c, y);
    when not_known(meets_minimum_distribution_requirements(c, y));
    then applicable_amounts_deduction_limitation_applies(c, y);
}
@source(IRC_S280H_A, quote = "then the deduction otherwise allowed under this chapter for applicable amounts paid or incurred by such corporation to employee-owners shall not exceed the maximum deductible amount")
rule ApplicableAmountsDeductionCappedAtMaximum(c: Person, y: TaxableYear, paid: Money, maximum: Money) defeasible {
    label en official "the deduction for applicable amounts is the lesser of the amounts and the maximum deductible amount (section 280H(a))";
    when applicable_amounts_deduction_limitation_applies(c, y);
    when applicable_amounts_paid_or_incurred_for_deduction(c, y, paid);
    when maximum_deductible_amount_280h(c, y, maximum);
    then applicable_amounts_deduction_limited_to_maximum(c, y, min(paid, maximum));
}
@source(IRC_S280H_A, quote = "shall not exceed the maximum deductible amount")
rule ApplicableAmountsExcessNotDeductible(c: Person, y: TaxableYear, paid: Money, maximum: Money) defeasible {
    label en official "no deduction for the excess of the applicable amounts over the maximum deductible amount (section 280H(a))";
    when applicable_amounts_deduction_limitation_applies(c, y);
    when applicable_amounts_paid_or_incurred_for_deduction(c, y, paid);
    when maximum_deductible_amount_280h(c, y, maximum);
    when paid > maximum;
    then not deduction_allowed(c, y, Section280HExcessApplicableAmounts, paid - maximum);
}
pub relation succeeding_taxable_year_280h(y: TaxableYear, next_year: TaxableYear) kind empirical {
    label en official "the succeeding taxable year";
}
pub relation disallowed_applicable_amounts_treated_paid_in_succeeding_year(c: Person, next_year: TaxableYear, amount: Money) kind institutional {
    label en official "an amount not allowed as a deduction under subsection (a) is treated as paid or incurred in the succeeding taxable year (section 280H(b))";
}
@source(IRC_S280H_B, quote = "such amount shall be treated as paid or incurred in the succeeding taxable year")
rule DisallowedAmountCarriedToSucceedingYear(c: Person, y: TaxableYear, next_year: TaxableYear, paid: Money, maximum: Money) defeasible {
    label en official "the excess not deducted is treated as paid or incurred in the succeeding taxable year (section 280H(b))";
    when applicable_amounts_deduction_limitation_applies(c, y);
    when applicable_amounts_paid_or_incurred_for_deduction(c, y, paid);
    when maximum_deductible_amount_280h(c, y, maximum);
    when succeeding_taxable_year_280h(y, next_year);
    when paid > maximum;
    then disallowed_applicable_amounts_treated_paid_in_succeeding_year(c, next_year, paid - maximum);
}

// --- (e): NOL carryback ---------------------------------------------------------------------------------------------------------------------------------------

pub relation net_operating_loss_carryback_to_or_from_year(c: Person, y: TaxableYear) kind institutional {
    label en official "a net operating loss carryback is allowed to or from the taxable year";
}
pub relation section_444_election_applies_to_year_of_psc(c: Person, y: TaxableYear) kind empirical {
    label en official "an election under section 444 applies to the taxable year of the personal service corporation (section 280H(e))";
}
@source(IRC_S280H_E, quote = "No net operating loss carryback shall be allowed to (or from) any taxable year of a personal service corporation to which an election under section 444 applies.")
rule NoNolCarrybackForSection444PersonalServiceCorporation(c: Person, y: TaxableYear) strict {
    label en official "no net operating loss carryback to or from a taxable year to which a section 444 election of a personal service corporation applies (section 280H(e))";
    when section_444_election_applies_to_year_of_psc(c, y);
    then not net_operating_loss_carryback_to_or_from_year(c, y);
}
