// Section 250 — foreign-derived deduction eligible income (FDII, renamed
// FDDEI by Pub. L. 119-21) and global intangible low-taxed income (GILTI, net CFC
// tested income). Stage 2. Editions by the first day of the taxable year:
//  * 2018-2025 (pinned 2024 text): 37.5 percent of foreign-derived intangible
//    income and 50 percent of the GILTI amount plus its section 78 gross-up;
//  * after December 31, 2025: Pub. L. 119-21 section 70321(a) substitutes 33.34
//    percent and 40 percent and strikes (a)(3) (21.875 / 37.5 percent), which
//    therefore never applies; section 70322(a) adds subclause (VII) to deduction
//    eligible income (dispositions after June 16, 2025) and (b) limits allocable
//    expenses to those other than interest and research expenditures (years after
//    2025).
// Scope: the amount of the deduction, foreign-derived intangible income, deemed
// intangible income, deduction eligible income, the (a)(2) taxable-income
// limitation. NOT modelled: the foreign-use and related-party sourcing rules of
// (b)(4)-(5) beyond the evaluative channel (Secretary's satisfaction), the QBAI
// computation of section 951A(d) (asserted amount) — see TECH_GAPS G2705-G2707.
// Rounding: the statute prescribes none; ratios are exact fractions with one
// rounding to cents HALF_UP (corpus convention, JUDGMENT CALL).

// --- the percentages, by edition ---------------------------------------------------

use self::{
    Corporation,
    DeductionKind,
    IRC_S250_A,
    IRC_S250_B,
    Person,
    TaxableYear,
    deduction_allowed,
    related_party_sale_lacks_foreign_use_250b5c,
    related_party_service_lacks_foreign_derived_status_250b5cii,
    taxable_year_begins_on,
};

pub relation section_250_percentages(y: TaxableYear, fdii_percentage: Decimal, gilti_percentage: Decimal) kind institutional {
    label en official "the section 250(a)(1) percentages applicable to the taxable year: foreign-derived intangible income and the GILTI amount";
}
@source(IRC_S250_A, quote = "37.5 percent of the foreign-derived intangible income of such domestic corporation for such taxable year, plus")
rule Section250PercentagesTaxableYears2018To2025(y: TaxableYear, begins: Date) strict {
    label en official "for taxable years beginning after December 31, 2017 and before January 1, 2026 the percentages are 37.5 and 50 (section 250(a)(1))";
    when taxable_year_begins_on(y, begins);
    when begins >= @2018-01-01;
    when begins <= @2025-12-31;
    then section_250_percentages(y, 0.375, 0.50);
}
@source(us.irc.temporal::PL119_21_S70321, relation = derives_from, quote = "by striking “37.5 percent” in paragraph (1)(A) and inserting “33.34 percent”")
rule Section250PercentagesTaxableYearsAfter2025(y: TaxableYear, begins: Date) strict {
    label en official "for taxable years beginning after December 31, 2025 the percentages are 33.34 and 40 (Pub. L. 119-21 section 70321(a)); the 21.875 and 37.5 percent of the pinned section 250(a)(3) are struck before they take effect";
    when taxable_year_begins_on(y, begins);
    when begins >= @2026-01-01;
    then section_250_percentages(y, 0.3334, 0.40);
}

// --- (b)(3): deduction eligible income ----------------------------------------------

pub relation gross_income_for_deduction_eligible_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income of the domestic corporation before the section 250(b)(3)(A)(i) exclusions";
}
pub relation dei_excluded_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the sum of the amounts excluded from gross income by section 250(b)(3)(A)(i)(I)-(VI): section 951(a)(1) inclusions, GILTI, financial services income, dividends from controlled foreign corporations, domestic oil and gas extraction income and foreign branch income";
}
pub relation dei_excluded_income_from_disposition_of_intangibles_after_2025_06_16(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "income and gain from the sale or other disposition (including deemed dispositions and section 367(d) transactions) after June 16, 2025 of intangible property or of property subject to depreciation, amortization or depletion, excluded by new section 250(b)(3)(A)(i)(VII) (Pub. L. 119-21 section 70322(a))";
}
pub relation deductions_properly_allocable_to_dei_gross_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the deductions (including taxes) properly allocable to the gross income of section 250(b)(3)(A)(i); for taxable years after 2025 other than interest expense and research or experimental expenditures (section 70322(b))";
}
pub relation deduction_eligible_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "deduction eligible income: the excess, if any, of the gross income of section 250(b)(3)(A)(i) over allocable deductions (section 250(b)(3)(A))";
}
@source(IRC_S250_B, quote = "the excess (if any) of—")
rule DeductionEligibleIncomeBefore2026(c: Corporation, y: TaxableYear, gross: Money, excluded: Money, alloc: Money, begins: Date) strict {
    label en official "deduction eligible income is gross income less the (I)-(VI) exclusions less allocable deductions, not below zero (section 250(b)(3)(A))";
    when gross_income_for_deduction_eligible_income(c, y, gross);
    when dei_excluded_income(c, y, excluded);
    when deductions_properly_allocable_to_dei_gross_income(c, y, alloc);
    when taxable_year_begins_on(y, begins);
    when begins <= @2025-12-31;
    then deduction_eligible_income(c, y, max(0.00 USD, gross - excluded - alloc));
}
@source(us.irc.temporal::PL119_21_S70322, relation = derives_from, quote = "any income and gain from the sale or other disposition")
rule DeductionEligibleIncomeAfter2025(c: Corporation, y: TaxableYear, gross: Money, excluded: Money, dispositions: Money, alloc: Money, begins: Date) strict {
    label en official "for taxable years after 2025 the amounts of subclause (VII) are also excluded; expenses exclude interest and research expenditures (Pub. L. 119-21 section 70322)";
    when gross_income_for_deduction_eligible_income(c, y, gross);
    when dei_excluded_income(c, y, excluded);
    when dei_excluded_income_from_disposition_of_intangibles_after_2025_06_16(c, y, dispositions);
    when deductions_properly_allocable_to_dei_gross_income(c, y, alloc);
    when taxable_year_begins_on(y, begins);
    when begins >= @2026-01-01;
    then deduction_eligible_income(c, y, max(0.00 USD, gross - excluded - dispositions - alloc));
}

// --- (b)(2): deemed intangible income ----------------------------------------------

pub relation qualified_business_asset_investment_250(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "qualified business asset investment as defined in section 951A(d), with deduction eligible income substituted for tested income and without regard to controlled foreign corporation status (section 250(b)(2)(B)); an asserted amount (TECH_GAPS G2705)";
}
pub relation deemed_tangible_income_return(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "10 percent of qualified business asset investment (section 250(b)(2)(B))";
}
@source(IRC_S250_B, quote = "an amount equal to 10 percent of the corporation's qualified business asset investment")
rule DeemedTangibleIncomeReturnRule(c: Corporation, y: TaxableYear, qbai: Money) strict {
    label en official "the deemed tangible income return is 10 percent of qualified business asset investment (section 250(b)(2)(B))";
    when qualified_business_asset_investment_250(c, y, qbai);
    then deemed_tangible_income_return(c, y, round(qbai * 0.10, 2, "HALF_UP"));
}
pub relation deemed_intangible_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "deemed intangible income: the excess, if any, of deduction eligible income over the deemed tangible income return (section 250(b)(2)(A))";
}
@source(IRC_S250_B, quote = "The term \"deemed intangible income\" means the excess (if any) of—")
rule DeemedIntangibleIncomeRule(c: Corporation, y: TaxableYear, dei: Money, dtir: Money) strict {
    label en official "deemed intangible income is deduction eligible income less the deemed tangible income return, not below zero (section 250(b)(2)(A))";
    when deduction_eligible_income(c, y, dei);
    when deemed_tangible_income_return(c, y, dtir);
    then deemed_intangible_income(c, y, max(0.00 USD, dei - dtir));
}

// --- (b)(4): foreign-derived deduction eligible income (evaluative channel) ---------

pub relation dei_item_sale_of_property_to_non_us_person(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item of deduction eligible income is derived in connection with property sold by the taxpayer to a person who is not a United States person (section 250(b)(4)(A)(i)); 'sold' includes any lease, license, exchange or other disposition (section 250(b)(5)(E))";
}
pub relation dei_item_services_provided_to_person_or_property_outside_us(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the item is derived in connection with services provided to a person, or with respect to property, not located within the United States (section 250(b)(4)(B))";
}
external judgment relation foreign_use_or_location_established_to_satisfaction_of_secretary(c: Corporation, y: TaxableYear, item: Integer) {
    authority Secretary;
    label en official "the taxpayer establishes to the satisfaction of the Secretary that the property is for a foreign use, or that the services are provided to a person or with respect to property not located within the United States (section 250(b)(4)(A)(ii),(B))";
}
pub relation sale_to_domestic_intermediary_for_further_manufacture(c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the property is sold to an unrelated person for further manufacture or other modification within the United States, so it is not sold for a foreign use even if that person later uses it abroad (section 250(b)(5)(B)(i))";
}
pub relation dei_item_is_foreign_derived(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "the item of deduction eligible income is foreign-derived deduction eligible income (section 250(b)(4))";
}
@source(IRC_S250_B, quote = "which the taxpayer establishes to the satisfaction of the Secretary is for a foreign use")
rule ForeignDerivedItemPropertySale(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "income from a sale to a non-U.S. person that the Secretary is satisfied is for a foreign use is foreign-derived (section 250(b)(4)(A)); a sale for further manufacture within the United States is excluded (section 250(b)(5)(B)(i))";
    when dei_item_sale_of_property_to_non_us_person(c, y, item);
    when foreign_use_or_location_established_to_satisfaction_of_secretary(c, y, item);
    when not_known(sale_to_domestic_intermediary_for_further_manufacture(c, y, item));
    when not_known(related_party_sale_lacks_foreign_use_250b5c(c, y, item));
    then dei_item_is_foreign_derived(c, y, item);
}
@source(IRC_S250_B, quote = "services provided by the taxpayer which the taxpayer establishes to the satisfaction of the Secretary are provided to any person, or with respect to property, not located within the United States")
rule ForeignDerivedItemServices(c: Corporation, y: TaxableYear, item: Integer) strict {
    label en official "income from services the Secretary is satisfied are provided abroad is foreign-derived (section 250(b)(4)(B))";
    when dei_item_services_provided_to_person_or_property_outside_us(c, y, item);
    when foreign_use_or_location_established_to_satisfaction_of_secretary(c, y, item);
    when not_known(related_party_service_lacks_foreign_derived_status_250b5cii(c, y, item));
    then dei_item_is_foreign_derived(c, y, item);
}
pub relation foreign_derived_deduction_eligible_income(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "foreign-derived deduction eligible income: the sum of the items of deduction eligible income that are foreign-derived (an asserted total; a sum over the derived `dei_item_is_foreign_derived` is a runtime subset limitation, section 111 — TECH_GAPS G2706)";
}

// --- (b)(1): foreign-derived intangible income ---------------------------------------

pub relation foreign_derived_intangible_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "foreign-derived intangible income: deemed intangible income times the ratio of foreign-derived deduction eligible income to deduction eligible income (section 250(b)(1))";
}
@source(IRC_S250_B, quote = "The foreign-derived intangible income of any domestic corporation is the amount which bears the same ratio to the deemed intangible income of such corporation as—")
rule ForeignDerivedIntangibleIncomeRule(c: Corporation, y: TaxableYear, deemed: Money, fddei: Money, dei: Money) strict {
    label en official "foreign-derived intangible income is deemed intangible income multiplied by FDDEI over DEI, with one rounding (section 250(b)(1))";
    when deemed_intangible_income(c, y, deemed);
    when foreign_derived_deduction_eligible_income(c, y, fddei);
    when deduction_eligible_income(c, y, dei);
    when dei > 0.00 USD;
    then foreign_derived_intangible_income(c, y, div_round(deemed * (fddei / 1.00 USD), dei / 1.00 USD, 2, "HALF_UP"));
}

// --- (a)(1)-(2): the deduction and the taxable income limitation --------------------

pub relation gilti_amount_included_under_951a(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the global intangible low-taxed income amount included in gross income under section 951A for the taxable year (net CFC tested income after 2025)";
}
pub relation section_78_dividend_attributable_to_gilti(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount treated as a dividend received under section 78 which is attributable to the GILTI amount (section 250(a)(1)(B)(ii))";
}
pub relation taxable_income_without_section_250(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "taxable income determined without regard to section 250 (section 250(a)(2)(A)(ii))";
}
pub relation gilti_amount_taken_into_account(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the GILTI amount included under section 951A plus the section 78 dividend attributable to it, taken into account under section 250(a)(1)(B)";
}
@source(IRC_S250_A, quote = "the amount treated as a dividend received by such corporation under section 78 which is attributable to the amount described in clause (i)")
rule GiltiAmountTakenIntoAccountRule(c: Corporation, y: TaxableYear, g: Money, d78: Money) strict {
    label en official "the GILTI base of the 50 (40) percent deduction is the section 951A inclusion plus its section 78 gross-up (section 250(a)(1)(B)(i),(ii))";
    when gilti_amount_included_under_951a(c, y, g);
    when section_78_dividend_attributable_to_gilti(c, y, d78);
    then gilti_amount_taken_into_account(c, y, g + d78);
}
pub relation fdii_after_taxable_income_limitation(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "foreign-derived intangible income after the section 250(a)(2) reduction";
}
pub relation gilti_after_taxable_income_limitation(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the GILTI amount after the section 250(a)(2) reduction";
}
@source(IRC_S250_A, quote = "foreign-derived intangible income shall be reduced by an amount which bears the same ratio to the excess described in subparagraph (A) as such foreign-derived intangible income bears to the sum described in subparagraph (A)(i)")
rule FdiiReducedWhenSumExceedsTaxableIncome(c: Corporation, y: TaxableYear, fdii: Money, gilti: Money, ti: Money) strict {
    label en official "when FDII plus the GILTI amount exceed taxable income, FDII is reduced by the excess in proportion to its share of the sum (section 250(a)(2)(B)(i)); taxable income below zero is treated as zero (JUDGMENT CALL: taxable income is not negative)";
    when foreign_derived_intangible_income(c, y, fdii);
    when gilti_amount_taken_into_account(c, y, gilti);
    when taxable_income_without_section_250(c, y, ti);
    when fdii + gilti > max(0.00 USD, ti);
    then fdii_after_taxable_income_limitation(c, y,
        fdii - div_round((fdii + gilti - max(0.00 USD, ti)) * (fdii / 1.00 USD), (fdii + gilti) / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S250_A, quote = "the global intangible low-taxed income amount shall be reduced by the remainder of such excess")
rule GiltiReducedByRemainderOfExcess(c: Corporation, y: TaxableYear, fdii: Money, gilti: Money, ti: Money) strict {
    label en official "the GILTI amount is reduced by the remainder of the excess after the FDII reduction (section 250(a)(2)(B)(ii))";
    when foreign_derived_intangible_income(c, y, fdii);
    when gilti_amount_taken_into_account(c, y, gilti);
    when taxable_income_without_section_250(c, y, ti);
    when fdii + gilti > max(0.00 USD, ti);
    then gilti_after_taxable_income_limitation(c, y,
        gilti - ((fdii + gilti - max(0.00 USD, ti)) - div_round((fdii + gilti - max(0.00 USD, ti)) * (fdii / 1.00 USD), (fdii + gilti) / 1.00 USD, 2, "HALF_UP")));
}
@source(IRC_S250_A, quote = "then the amount of the foreign-derived intangible income and the global intangible low-taxed income amount so taken into account shall be reduced as provided in subparagraph (B)")
rule FdiiNotReducedWithinTaxableIncome(c: Corporation, y: TaxableYear, fdii: Money, gilti: Money, ti: Money) strict {
    label en official "when the sum does not exceed taxable income no reduction applies (section 250(a)(2)(A))";
    when foreign_derived_intangible_income(c, y, fdii);
    when gilti_amount_taken_into_account(c, y, gilti);
    when taxable_income_without_section_250(c, y, ti);
    when fdii + gilti <= max(0.00 USD, ti);
    then fdii_after_taxable_income_limitation(c, y, fdii);
}
@source(IRC_S250_A, quote = "then the amount of the foreign-derived intangible income and the global intangible low-taxed income amount so taken into account shall be reduced as provided in subparagraph (B)")
rule GiltiNotReducedWithinTaxableIncome(c: Corporation, y: TaxableYear, fdii: Money, gilti: Money, ti: Money) strict {
    label en official "when the sum does not exceed taxable income the GILTI amount is not reduced (section 250(a)(2)(A))";
    when foreign_derived_intangible_income(c, y, fdii);
    when gilti_amount_taken_into_account(c, y, gilti);
    when taxable_income_without_section_250(c, y, ti);
    when fdii + gilti <= max(0.00 USD, ti);
    then gilti_after_taxable_income_limitation(c, y, gilti);
}
pub relation section_250_deduction(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 250(a) deduction for the taxable year";
}
@source(IRC_S250_A, quote = "there shall be allowed as a deduction an amount equal to the sum of—")
rule Section250DeductionRule(c: Corporation, y: TaxableYear, fdii: Money, gilti: Money, fp: Decimal, gp: Decimal) strict {
    label en official "the deduction is the FDII percentage of foreign-derived intangible income plus the GILTI percentage of the GILTI amount, each after the taxable income limitation, rounded once to cents (section 250(a)(1))";
    when fdii_after_taxable_income_limitation(c, y, fdii);
    when gilti_after_taxable_income_limitation(c, y, gilti);
    when section_250_percentages(y, fp, gp);
    then section_250_deduction(c, y, round(fdii * fp + gilti * gp, 2, "HALF_UP"));
}
@source(IRC_S250_A, quote = "In the case of a domestic corporation for any taxable year, there shall be allowed as a deduction")
rule Section250DeductionAllowed(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "the section 250 deduction is allowed to a domestic corporation";
    when section_250_deduction(c, y, amount);
    then deduction_allowed(c, y, Section250FddeiNci, amount);
}
