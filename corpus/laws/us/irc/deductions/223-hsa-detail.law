// Section 223 — health savings accounts: stage 2b detail. Adds what `223-hsa.law` left open
// (TECH_GAPS G2790): (a) the allowance, (b)(3) the additional contribution amount, (b)(4)-(6),(8)
// the coordination, the married-couple, dependent and last-month rules and the resulting
// limitation, (d) the account, qualified medical expenses and the account beneficiary, (e)(1) tax
// exemption, (f)(1)-(8) distributions, the 20 percent additional tax, rollovers, divorce transfers
// and death of the beneficiary, (g) the indexing arithmetic and the Secretary's publication duty,
// (h) reporting authority. The per-month sums stay in `223-hsa.law`; this module builds the full
// limitation as a separate derived amount (`hsa_deduction_computed`) so the older per-coverage rules
// are not contradicted. Not modelled (fresh id in TECH-GAPS G39xx): the lowest-annual-deductible
// choice of (b)(5)(A), the deemed HDHP coverage of (b)(8)(A)(ii) as a plan identity, the published
// indexed amounts of (g) (Rev. Proc. 2024-25 and later are not pinned), the incorporated rules of
// sections 408(e)(2),(4), 408(g),(h) and 219(f)(5) (owned by other packages), and fiscal-year
// last-month counting (the last month is read as month 12).

// --- (a): the allowance ---------------------------------------------------------------------------

use self::{
    IRC_S223_A,
    IRC_S223_B,
    IRC_S223_D,
    IRC_S223_E,
    IRC_S223_F,
    IRC_S223_G,
    IRC_S223_H,
    IRC_S223_TABLE_1,
    Individual,
    Person,
    TaxableYear,
    eligible_individual_hsa,
    hsa_contribution_for_year,
    months_with_family_coverage,
    months_with_self_only_coverage,
    taxable_year_begins_on,
};

pub relation hsa_allowance_before_limitation(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount allowable as a deduction before the subsection (b) limitation: the aggregate cash paid during the taxable year by or on behalf of the eligible individual to a health savings account of the individual (section 223(a))";
}
@source(IRC_S223_A, quote = "there shall be allowed as a deduction for the taxable year an amount equal to the aggregate amount paid in cash during such taxable year by or on behalf of such individual to a health savings account of such individual")
rule HsaAllowanceIsCashPaidForEligibleIndividual(p: Individual, y: TaxableYear, month: Integer, amount: Money) strict {
    label en official "an individual who is an eligible individual for any month of the taxable year is allowed the aggregate cash paid to his health savings account (section 223(a))";
    when eligible_individual_hsa(p, y, month);
    when hsa_contribution_for_year(p, y, amount);
    then hsa_allowance_before_limitation(p, y, amount);
}

// --- (b)(3): additional contribution amount (table) -------------------------------------------------

pub relation attained_age_55_before_close_of_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual has attained age 55 before the close of the taxable year (section 223(b)(3)(A))";
}
pub relation hsa_additional_contribution_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional contribution amount for an individual who attained age 55 before the close of the taxable year, from the table of section 223(b)(3)(B)";
}
@source(IRC_S223_TABLE_1, quote = "2004 / $500")
rule HsaAdditionalContribution2004(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$500 for taxable years beginning in 2004 (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2004-01-01;
    when begins <= @2004-12-31;
    then hsa_additional_contribution_amount(p, y, 500.00 USD);
}
@source(IRC_S223_TABLE_1, quote = "2005 / $600")
rule HsaAdditionalContribution2005(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$600 for taxable years beginning in 2005 (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2005-01-01;
    when begins <= @2005-12-31;
    then hsa_additional_contribution_amount(p, y, 600.00 USD);
}
@source(IRC_S223_TABLE_1, quote = "2006 / $700")
rule HsaAdditionalContribution2006(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$700 for taxable years beginning in 2006 (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2006-01-01;
    when begins <= @2006-12-31;
    then hsa_additional_contribution_amount(p, y, 700.00 USD);
}
@source(IRC_S223_TABLE_1, quote = "2007 / $800")
rule HsaAdditionalContribution2007(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$800 for taxable years beginning in 2007 (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2007-01-01;
    when begins <= @2007-12-31;
    then hsa_additional_contribution_amount(p, y, 800.00 USD);
}
@source(IRC_S223_TABLE_1, quote = "2008 / $900")
rule HsaAdditionalContribution2008(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$900 for taxable years beginning in 2008 (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2008-01-01;
    when begins <= @2008-12-31;
    then hsa_additional_contribution_amount(p, y, 900.00 USD);
}
@source(IRC_S223_TABLE_1, quote = "2009 and thereafter / $1,000")
rule HsaAdditionalContribution2009AndAfter(p: Individual, y: TaxableYear, begins: Date) strict {
    label en official "$1,000 for taxable years beginning in 2009 and thereafter (section 223(b)(3)(B))";
    when attained_age_55_before_close_of_year(p, y);
    when taxable_year_begins_on(y, begins);
    when begins >= @2009-01-01;
    then hsa_additional_contribution_amount(p, y, 1000.00 USD);
}

// --- (b)(1),(2),(3),(4): the limitation before the married and dependent rules ------------------------

pub relation hsa_monthly_limitation_sum(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the monthly limitations for the months of the taxable year the individual is an eligible individual: 1/12 of the self-only amount for self-only months plus 1/12 of the family amount for family months (section 223(b)(1)-(2))";
}
@source(IRC_S223_B, quote = "The amount allowable as a deduction under subsection (a) to an individual for the taxable year shall not exceed the sum of the monthly limitations")
rule HsaMonthlyLimitationSumMixed(p: Individual, y: TaxableYear, self_months: Integer, family_months: Integer) strict {
    label en official "the sum of monthly limitations with both self-only and family months (section 223(b)(1)-(2))";
    when months_with_self_only_coverage(p, y, self_months);
    when months_with_family_coverage(p, y, family_months);
    then hsa_monthly_limitation_sum(p, y, round(187.50 USD * self_months + 375.00 USD * family_months, 2, "HALF_UP"));
}
@source(IRC_S223_B, quote = "The amount allowable as a deduction under subsection (a) to an individual for the taxable year shall not exceed the sum of the monthly limitations")
rule HsaMonthlyLimitationSumSelfOnly(p: Individual, y: TaxableYear, self_months: Integer) strict {
    label en official "the sum of monthly limitations with self-only months only (section 223(b)(1)-(2)(A))";
    when months_with_self_only_coverage(p, y, self_months);
    when not_known(months_with_family_coverage_any(p, y));
    then hsa_monthly_limitation_sum(p, y, round(187.50 USD * self_months, 2, "HALF_UP"));
}
@source(IRC_S223_B, quote = "The amount allowable as a deduction under subsection (a) to an individual for the taxable year shall not exceed the sum of the monthly limitations")
rule HsaMonthlyLimitationSumFamilyOnly(p: Individual, y: TaxableYear, family_months: Integer) strict {
    label en official "the sum of monthly limitations with family months only (section 223(b)(1)-(2)(B))";
    when months_with_family_coverage(p, y, family_months);
    when not_known(months_with_self_only_coverage_any(p, y));
    then hsa_monthly_limitation_sum(p, y, round(375.00 USD * family_months, 2, "HALF_UP"));
}
pub relation months_with_family_coverage_any(p: Individual, y: TaxableYear) kind institutional {
    label en official "the individual has at least one month of family HDHP coverage in the taxable year (helper for the single-kind monthly sums)";
}
pub relation months_with_self_only_coverage_any(p: Individual, y: TaxableYear) kind institutional {
    label en official "the individual has at least one month of self-only HDHP coverage in the taxable year (helper for the single-kind monthly sums)";
}
rule FamilyMonthsAnyHelper(p: Individual, y: TaxableYear, n: Integer) strict {
    label en official "helper: some family months exist";
    when months_with_family_coverage(p, y, n);
    when n > 0;
    then months_with_family_coverage_any(p, y);
}
rule SelfOnlyMonthsAnyHelper(p: Individual, y: TaxableYear, n: Integer) strict {
    label en official "helper: some self-only months exist";
    when months_with_self_only_coverage(p, y, n);
    when n > 0;
    then months_with_self_only_coverage_any(p, y);
}

pub relation hsa_limitation_with_additional(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the applicable limitation increased by the additional contribution amount for an individual 55 or older (section 223(b)(3)(A))";
}
@source(IRC_S223_B, quote = "the applicable limitation under subparagraphs (A) and (B) of paragraph (2) shall be increased by the additional contribution amount")
rule HsaLimitationIncreasedForAge55(p: Individual, y: TaxableYear, base: Money, extra: Money) strict {
    label en official "an individual who attained age 55 before the close of the taxable year has the limitation increased by the additional contribution amount (section 223(b)(3)(A))";
    when hsa_monthly_limitation_sum(p, y, base);
    when hsa_additional_contribution_amount(p, y, extra);
    then hsa_limitation_with_additional(p, y, base + extra);
}
@source(IRC_S223_B, quote = "In the case of an individual who has attained age 55 before the close of the taxable year")
rule HsaLimitationNoAdditionUnder55(p: Individual, y: TaxableYear, base: Money) strict {
    label en official "an individual who has not attained age 55 has no additional contribution amount (section 223(b)(3)(A))";
    when hsa_monthly_limitation_sum(p, y, base);
    when not_known(attained_age_55_before_close_of_year(p, y));
    then hsa_limitation_with_additional(p, y, base);
}

pub relation archer_msa_payments_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount paid for the taxable year to Archer MSAs of the individual (section 223(b)(4)(A))";
}
pub relation hsa_contributions_excludable_under_106d(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount contributed to health savings accounts of the individual which is excludable from gross income under section 106(d) (section 223(b)(4)(B))";
}
pub relation hsa_contributions_under_408d9(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount contributed to health savings accounts of the individual for the taxable year under section 408(d)(9) (section 223(b)(4)(C))";
}
pub relation married_to_each_other_either_has_family_coverage(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is married to another individual and either spouse has family coverage (section 223(b)(5))";
}
pub relation hsa_limitation_after_coordination(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the limitation reduced (not below zero) by Archer MSA payments, excludable employer contributions and section 408(d)(9) contributions (section 223(b)(4))";
}
@source(IRC_S223_B, quote = "The limitation which would (but for this paragraph) apply under this subsection to an individual for any taxable year shall be reduced (but not below zero) by the sum of")
rule HsaLimitationReducedByOtherContributions(p: Individual, y: TaxableYear, limit: Money, msa: Money, employer: Money, rollover408: Money) strict {
    label en official "the limitation is reduced, but not below zero, by the sum of Archer MSA payments, excludable section 106(d) contributions and section 408(d)(9) contributions; the Archer MSA reduction does not apply where paragraph (5) applies (section 223(b)(4))";
    when hsa_limitation_with_additional(p, y, limit);
    when archer_msa_payments_for_year(p, y, msa);
    when hsa_contributions_excludable_under_106d(p, y, employer);
    when hsa_contributions_under_408d9(p, y, rollover408);
    when not_known(married_to_each_other_either_has_family_coverage(p, y));
    then hsa_limitation_after_coordination(p, y, max(0.00 USD, limit - msa - employer - rollover408));
}

// --- (b)(5): married individuals with family coverage ------------------------------------------------

pub relation archer_msa_payments_of_both_spouses(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount paid to Archer MSAs of both spouses for the taxable year (section 223(b)(5)(B)(i))";
}
pub relation spouses_agree_on_division_percent(p: Individual, y: TaxableYear, percent: Decimal) kind empirical {
    label en official "the spouses agree on a different division of the limitation: this individual's share as a fraction (section 223(b)(5)(B)(ii))";
}
pub relation hsa_married_family_pool(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the family-coverage limitation for the year, without the additional contribution amount, reduced by the Archer MSA payments of both spouses (section 223(b)(5)(B)(i))";
}
@source(IRC_S223_B, quote = "shall be reduced by the aggregate amount paid to Archer MSAs of such spouses for the taxable year")
rule HsaMarriedFamilyPool(p: Individual, y: TaxableYear, family_months: Integer, msa: Money) strict {
    label en official "spouses where either has family coverage are treated as having only family coverage; the pool is the family monthly limitations less the Archer MSA payments of both (section 223(b)(5)(A),(B)(i)); the lowest-deductible choice among different family plans is not derived";
    when married_to_each_other_either_has_family_coverage(p, y);
    when months_with_family_coverage(p, y, family_months);
    when archer_msa_payments_of_both_spouses(p, y, msa);
    then hsa_married_family_pool(p, y, max(0.00 USD, round(375.00 USD * family_months, 2, "HALF_UP") - msa));
}
@source(IRC_S223_B, quote = "shall be divided equally between them unless they agree on a different division")
rule HsaMarriedLimitationEqualDivision(p: Individual, y: TaxableYear, pool: Money, extra: Money) strict {
    label en official "the pool is divided equally between the spouses unless they agree on a different division; the additional contribution amount is added apart from the pool (section 223(b)(5)(B))";
    when hsa_married_family_pool(p, y, pool);
    when hsa_additional_contribution_amount(p, y, extra);
    when not_known(spouses_agree_on_division_percent(p, y, 0.5));
    then hsa_limitation_after_coordination(p, y, round(pool * 50 percent, 2, "HALF_UP") + extra);
}
@source(IRC_S223_B, quote = "shall be divided equally between them unless they agree on a different division")
rule HsaMarriedLimitationEqualDivisionNoExtra(p: Individual, y: TaxableYear, pool: Money) strict {
    label en official "the pool divided equally for a spouse with no additional contribution amount (section 223(b)(5)(B)(ii))";
    when hsa_married_family_pool(p, y, pool);
    when not_known(attained_age_55_before_close_of_year(p, y));
    when not_known(spouses_agree_on_division_percent(p, y, 0.5));
    then hsa_limitation_after_coordination(p, y, round(pool * 50 percent, 2, "HALF_UP"));
}
@source(IRC_S223_B, quote = "shall be divided equally between them unless they agree on a different division")
rule HsaMarriedLimitationAgreedDivision(p: Individual, y: TaxableYear, pool: Money, share: Decimal) strict {
    label en official "the pool is divided as the spouses agree (section 223(b)(5)(B)(ii))";
    when hsa_married_family_pool(p, y, pool);
    when spouses_agree_on_division_percent(p, y, share);
    then hsa_limitation_after_coordination(p, y, round(pool * share, 2, "HALF_UP"));
}

// --- (b)(6): dependents ------------------------------------------------------------------------------------

pub relation deduction_under_151_allowable_to_another_taxpayer_for_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "a deduction under section 151 is allowable to another taxpayer with respect to the individual for a taxable year beginning in the calendar year in which the individual's taxable year begins (section 223(b)(6))";
}
pub relation hsa_final_limitation(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the limitation on the section 223 deduction for the taxable year after subsection (b) paragraphs (1)-(6) and (8)";
}
@source(IRC_S223_B, quote = "No deduction shall be allowed under this section to any individual with respect to whom a deduction under section 151 is allowable to another taxpayer")
rule HsaFinalLimitationZeroForDependent(p: Individual, y: TaxableYear) strict {
    label en official "no deduction under section 223 to an individual for whom another taxpayer may deduct under section 151: the limitation is zero (section 223(b)(6))";
    when deduction_under_151_allowable_to_another_taxpayer_for_year(p, y);
    then hsa_final_limitation(p, y, 0.00 USD);
}
@source(IRC_S223_B, quote = "the limitation under paragraph (1) (after the application of subparagraph (A)")
rule HsaFinalLimitationOrdinary(p: Individual, y: TaxableYear, limit: Money) strict {
    label en official "the limitation for an individual who is not a dependent of another taxpayer (section 223(b)(1)-(5))";
    when hsa_limitation_after_coordination(p, y, limit);
    when not_known(deduction_under_151_allowable_to_another_taxpayer_for_year(p, y));
    then hsa_final_limitation(p, y, limit);
}

pub relation hsa_deduction_computed(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 223 deduction: the cash paid, not exceeding the final limitation (section 223(a),(b)(1))";
}
@source(IRC_S223_B, quote = "shall not exceed the sum of the monthly limitations for months during such taxable year that the individual is an eligible individual")
rule HsaDeductionComputedWithinLimit(p: Individual, y: TaxableYear, paid: Money, limit: Money) strict {
    label en official "the deduction equals the smaller of the cash paid and the final limitation (section 223(a),(b)(1))";
    when hsa_allowance_before_limitation(p, y, paid);
    when hsa_final_limitation(p, y, limit);
    then hsa_deduction_computed(p, y, min(paid, limit));
}

// --- (b)(8): individuals becoming eligible after the beginning of the year -----------------------------

pub relation eligible_in_last_month_of_taxable_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is an eligible individual during the last month of the taxable year (read as calendar month 12) (section 223(b)(8)(A))";
}
rule EligibleInLastMonthDerived(p: Individual, y: TaxableYear) strict {
    label en official "eligibility in month 12 is eligibility in the last month of a calendar taxable year (section 223(b)(8)(A))";
    when eligible_individual_hsa(p, y, 12);
    then eligible_in_last_month_of_taxable_year(p, y);
}
pub relation treated_as_eligible_all_months_last_month_rule(p: Individual, y: TaxableYear) kind institutional {
    label en official "the individual is treated as an eligible individual during each month of the taxable year, enrolled in the plan of the last month (section 223(b)(8)(A))";
}
@source(IRC_S223_B, quote = "an individual who is an eligible individual during the last month of such taxable year shall be treated")
rule LastMonthRuleTreatsAsEligibleAllYear(p: Individual, y: TaxableYear) strict {
    label en official "an individual eligible in the last month of the taxable year is treated as eligible in every month of that year (section 223(b)(8)(A)(i))";
    when eligible_in_last_month_of_taxable_year(p, y);
    then treated_as_eligible_all_months_last_month_rule(p, y);
}
pub relation contributions_possible_only_by_last_month_rule(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate contributions to the individual's health savings account which could not have been made but for section 223(b)(8)(A) (section 223(b)(8)(B)(i)(I))";
}
pub relation not_eligible_at_some_time_in_testing_period(p: Individual, y: TaxableYear) kind empirical {
    label en official "at some time during the testing period (the last month of the year through the last day of the 12th following month) the individual is not an eligible individual (section 223(b)(8)(B)(i),(iii))";
}
pub relation ceased_eligibility_by_death_or_disability(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual ceased to be an eligible individual by reason of death or of becoming disabled within the meaning of section 72(m)(7) (section 223(b)(8)(B)(ii))";
}
pub relation hsa_last_month_rule_inclusion(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in gross income for the year of the first testing-period month without eligibility (section 223(b)(8)(B)(i)(I))";
}
pub relation hsa_last_month_rule_additional_tax(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "10 percent of the inclusion under section 223(b)(8)(B)(i)(I) (section 223(b)(8)(B)(i)(II))";
}
@source(IRC_S223_B, quote = "gross income of the individual for the taxable year in which occurs the first month in the testing period for which such individual is not an eligible individual is increased by the aggregate amount of all contributions")
rule LastMonthRuleFailureInclusion(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "failure to remain eligible through the testing period includes the contributions made possible by the last-month rule (section 223(b)(8)(B)(i)(I)), except on death or disability";
    when treated_as_eligible_all_months_last_month_rule(p, y);
    when not_eligible_at_some_time_in_testing_period(p, y);
    when contributions_possible_only_by_last_month_rule(p, y, amount);
    unless ceased_eligibility_by_death_or_disability_with_amount(p, y, amount);
    then hsa_last_month_rule_inclusion(p, y, amount);
}
pub relation ceased_eligibility_by_death_or_disability_with_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "exception (b)(8)(B)(ii) keyed to the contribution amount, so that the exception binds every head variable of the inclusion rule";
}
rule DeathOrDisabilityExceptionKeyed(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "helper: the death-or-disability exception applies to the amount under test";
    when ceased_eligibility_by_death_or_disability(p, y);
    when contributions_possible_only_by_last_month_rule(p, y, amount);
    then ceased_eligibility_by_death_or_disability_with_amount(p, y, amount);
}
@source(IRC_S223_B, quote = "the tax imposed by this chapter for any taxable year on the individual shall be increased by 10 percent of the amount of such increase")
rule LastMonthRuleFailureAdditionalTax(p: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "the tax is increased by 10 percent of the inclusion (section 223(b)(8)(B)(i)(II))";
    when hsa_last_month_rule_inclusion(p, y, amount);
    then hsa_last_month_rule_additional_tax(p, y, round(amount * 10 percent, 2, "HALF_UP"));
}

// --- (d)(1): the health savings account ---------------------------------------------------------------

pub relation trust_created_in_united_states_as_hsa_exclusively_for_qualified_medical_expenses(acct: Integer) kind empirical {
    label en official "a trust created or organized in the United States as a health savings account exclusively for the purpose of paying the qualified medical expenses of the account beneficiary (section 223(d)(1))";
}
pub relation instrument_bars_non_cash_contributions(acct: Integer) kind empirical {
    label en official "the written governing instrument provides that no contribution will be accepted unless it is in cash, except a rollover contribution (section 223(d)(1)(A)(i))";
}
pub relation instrument_bars_contributions_above_dollar_limits(acct: Integer) kind empirical {
    label en official "the written governing instrument provides that no contribution will be accepted to the extent it exceeds, with prior contributions for the calendar year, the sum of the amounts under subsections (b)(2)(B) and (b)(3)(B) (section 223(d)(1)(A)(ii))";
}
pub relation trustee_is_bank_or_insurance_company(acct: Integer) kind empirical {
    label en official "the trustee is a bank (as defined in section 408(n)) or an insurance company (as defined in section 816) (section 223(d)(1)(B))";
}
external judgment relation trustee_demonstrates_consistent_administration_to_secretary(acct: Integer) {
    authority Secretary;
    label en official "another person demonstrates to the satisfaction of the Secretary that the manner in which it will administer the trust will be consistent with the requirements of section 223 (section 223(d)(1)(B))";
}
pub relation instrument_bars_life_insurance_investment(acct: Integer) kind empirical {
    label en official "the governing instrument provides that no part of the trust assets will be invested in life insurance contracts (section 223(d)(1)(C))";
}
pub relation instrument_bars_commingling(acct: Integer) kind empirical {
    label en official "the governing instrument provides that assets will not be commingled with other property except in a common trust fund or common investment fund (section 223(d)(1)(D))";
}
pub relation instrument_makes_interest_nonforfeitable(acct: Integer) kind empirical {
    label en official "the interest of an individual in the balance in his account is nonforfeitable (section 223(d)(1)(E))";
}
pub relation qualified_hsa_trustee(acct: Integer) kind institutional {
    label en official "the trustee satisfies section 223(d)(1)(B): a bank, an insurance company or a person approved by the Secretary";
}
@source(IRC_S223_D, quote = "The trustee is a bank (as defined in section 408(n)), an insurance company (as defined in section 816)")
rule QualifiedHsaTrusteeBankOrInsurer(acct: Integer) strict {
    label en official "a bank or an insurance company is a qualified trustee (section 223(d)(1)(B))";
    when trustee_is_bank_or_insurance_company(acct);
    then qualified_hsa_trustee(acct);
}
@source(IRC_S223_D, quote = "or another person who demonstrates to the satisfaction of the Secretary")
rule QualifiedHsaTrusteeApprovedPerson(acct: Integer) strict {
    label en official "a person approved by the Secretary is a qualified trustee (section 223(d)(1)(B))";
    when trustee_demonstrates_consistent_administration_to_secretary(acct);
    then qualified_hsa_trustee(acct);
}
pub relation health_savings_account(acct: Integer) kind institutional {
    label en official "a health savings account within the meaning of section 223(d)(1)";
}
@source(IRC_S223_D, quote = "The term \"health savings account\" means a trust created or organized in the United States as a health savings account exclusively for the purpose of paying the qualified medical expenses of the account beneficiary")
rule HealthSavingsAccountDefinition(acct: Integer) strict {
    label en official "a trust created in the United States exclusively to pay qualified medical expenses whose governing instrument meets requirements (A)-(E) is a health savings account (section 223(d)(1))";
    when trust_created_in_united_states_as_hsa_exclusively_for_qualified_medical_expenses(acct);
    when instrument_bars_non_cash_contributions(acct);
    when instrument_bars_contributions_above_dollar_limits(acct);
    when qualified_hsa_trustee(acct);
    when instrument_bars_life_insurance_investment(acct);
    when instrument_bars_commingling(acct);
    when instrument_makes_interest_nonforfeitable(acct);
    then health_savings_account(acct);
}

// --- (d)(3): the account beneficiary -----------------------------------------------------------------

pub relation hsa_established_on_behalf_of(acct: Integer, b: Individual) kind empirical {
    label en official "the individual on whose behalf the health savings account was established";
}
pub relation account_beneficiary(acct: Integer, b: Individual) kind institutional {
    label en official "the account beneficiary of the health savings account (section 223(d)(3))";
}
@source(IRC_S223_D, quote = "The term \"account beneficiary\" means the individual on whose behalf the health savings account was established.")
rule AccountBeneficiaryDefinition(acct: Integer, b: Individual) strict {
    label en official "the individual on whose behalf the account was established is the account beneficiary (section 223(d)(3))";
    when health_savings_account(acct);
    when hsa_established_on_behalf_of(acct, b);
    then account_beneficiary(acct, b);
}

// --- (d)(2): qualified medical expenses --------------------------------------------------------------

pub relation hsa_payment_by_beneficiary(acct: Integer, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an amount paid by the account beneficiary (section 223(d)(2)(A))";
}
pub relation payment_is_medical_care_213d_for_beneficiary_spouse_or_dependent(item: Integer) kind empirical {
    label en official "the amount is paid for medical care (section 213(d)) for the account beneficiary, the spouse or a dependent (section 152 without regard to (b)(1),(b)(2),(d)(1)(B)) (section 223(d)(2)(A))";
}
pub relation payment_for_menstrual_care_product(item: Integer) kind empirical {
    label en official "the amount is paid for a menstrual care product: a tampon, pad, liner, cup, sponge or similar product used with respect to menstruation or other genital-tract secretions (section 223(d)(2)(A),(D))";
}
pub relation amount_compensated_by_insurance_or_otherwise(item: Integer, amount: Money) kind empirical {
    label en official "the part of the payment compensated by insurance or otherwise (section 223(d)(2)(A))";
}
pub relation payment_for_insurance(item: Integer) kind empirical {
    label en official "the payment is for insurance (section 223(d)(2)(B))";
}
pub relation insurance_payment_for_continuation_coverage_under_federal_law(item: Integer) kind empirical {
    label en official "the expense is for a health plan during a period of continuation coverage required under Federal law (section 223(d)(2)(C)(i))";
}
pub relation insurance_payment_for_qualified_long_term_care_contract(item: Integer) kind empirical {
    label en official "the expense is for a qualified long-term care insurance contract (section 7702B(b)) (section 223(d)(2)(C)(ii))";
}
pub relation insurance_payment_for_plan_during_unemployment_compensation(item: Integer) kind empirical {
    label en official "the expense is for a health plan during a period in which the individual receives unemployment compensation under Federal or State law (section 223(d)(2)(C)(iii))";
}
pub relation insurance_payment_after_medicare_age_other_than_medicare_supplement(item: Integer) kind empirical {
    label en official "the account beneficiary has attained the age specified in section 1811 of the Social Security Act and the expense is for health insurance other than a medicare supplemental policy (section 223(d)(2)(C)(iv))";
}
pub relation insurance_payment_exception_223d2c(item: Integer) kind institutional {
    label en official "one of the exceptions of section 223(d)(2)(C) lets the payment for insurance be a qualified medical expense";
}
@source(IRC_S223_D, quote = "(i) a health plan during any period of continuation coverage required under any Federal law,")
rule InsuranceExceptionContinuation(item: Integer) strict {
    label en official "continuation coverage required under Federal law (section 223(d)(2)(C)(i))";
    when insurance_payment_for_continuation_coverage_under_federal_law(item);
    then insurance_payment_exception_223d2c(item);
}
@source(IRC_S223_D, quote = "(ii) a qualified long-term care insurance contract (as defined in section 7702B(b)),")
rule InsuranceExceptionLongTermCare(item: Integer) strict {
    label en official "a qualified long-term care insurance contract (section 223(d)(2)(C)(ii))";
    when insurance_payment_for_qualified_long_term_care_contract(item);
    then insurance_payment_exception_223d2c(item);
}
@source(IRC_S223_D, quote = "(iii) a health plan during a period in which the individual is receiving unemployment compensation under any Federal or State law, or")
rule InsuranceExceptionUnemployment(item: Integer) strict {
    label en official "a health plan during a period of unemployment compensation (section 223(d)(2)(C)(iii))";
    when insurance_payment_for_plan_during_unemployment_compensation(item);
    then insurance_payment_exception_223d2c(item);
}
@source(IRC_S223_D, quote = "any health insurance other than a medicare supplemental policy")
rule InsuranceExceptionAfterMedicareAge(item: Integer) strict {
    label en official "health insurance other than a medicare supplemental policy after the medicare age (section 223(d)(2)(C)(iv))";
    when insurance_payment_after_medicare_age_other_than_medicare_supplement(item);
    then insurance_payment_exception_223d2c(item);
}
pub relation qualified_medical_expense(acct: Integer, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the qualified medical expenses of the account beneficiary paid for the item, net of amounts compensated by insurance or otherwise (section 223(d)(2))";
}
@source(IRC_S223_D, quote = "but only to the extent such amounts are not compensated for by insurance or otherwise")
rule QualifiedMedicalExpenseMedicalCare(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "an amount paid for medical care of the beneficiary, spouse or dependent is a qualified medical expense to the extent not compensated (section 223(d)(2)(A)), unless it is a payment for insurance";
    when hsa_payment_by_beneficiary(acct, y, item, paid);
    when payment_is_medical_care_213d_for_beneficiary_spouse_or_dependent(item);
    when amount_compensated_by_insurance_or_otherwise(item, compensated);
    when not_known(payment_for_insurance(item));
    then qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}
@source(IRC_S223_D, quote = "amounts paid for menstrual care products shall be treated as paid for medical care")
rule QualifiedMedicalExpenseMenstrualCare(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "amounts paid for menstrual care products are treated as paid for medical care (section 223(d)(2)(A),(D))";
    when hsa_payment_by_beneficiary(acct, y, item, paid);
    when payment_for_menstrual_care_product(item);
    when amount_compensated_by_insurance_or_otherwise(item, compensated);
    then qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}
@source(IRC_S223_D, quote = "Subparagraph (B) shall not apply to any expense for coverage under")
rule QualifiedMedicalExpenseInsuranceException(acct: Integer, y: TaxableYear, item: Integer, paid: Money, compensated: Money) strict {
    label en official "a payment for insurance is a qualified medical expense only within an exception of paragraph (2)(C) (section 223(d)(2)(B),(C))";
    when hsa_payment_by_beneficiary(acct, y, item, paid);
    when payment_is_medical_care_213d_for_beneficiary_spouse_or_dependent(item);
    when payment_for_insurance(item);
    when insurance_payment_exception_223d2c(item);
    when amount_compensated_by_insurance_or_otherwise(item, compensated);
    then qualified_medical_expense(acct, y, item, max(0.00 USD, paid - compensated));
}

// --- (d)(4)(A),(B): rules similar to section 219(d)(2) and (f)(3) ----------------------------------------

pub relation hsa_rollover_contribution_received(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a rollover contribution described in section 223(f)(5) or 220(f)(5) paid into a health savings account of the individual";
}
pub relation hsa_rollover_amount_not_deductible(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "no deduction is allowed for a rollover contribution (rules similar to section 219(d)(2), section 223(d)(4)(A))";
}
@source(IRC_S223_D, quote = "(A) Section 219(d)(2) (relating to no deduction for rollovers).")
rule HsaNoDeductionForRollovers(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a rollover contribution is not deductible under section 223 (section 223(d)(4)(A))";
    when hsa_rollover_contribution_received(p, y, amount);
    then hsa_rollover_amount_not_deductible(p, y, amount);
}
pub relation hsa_contribution_made_on(p: Individual, acct: Integer, made_on: Date, for_year: TaxableYear, amount: Money) kind empirical {
    label en official "a contribution to a health savings account made on the date on account of the taxable year";
}
pub relation return_filing_due_date_without_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, not including extensions";
}
pub relation taxable_year_last_day(y: TaxableYear, last_day: Date) kind empirical {
    label en official "the last day of the taxable year";
}
pub relation hsa_contribution_deemed_made_on_last_day_of_year(p: Individual, acct: Integer, y: TaxableYear, deemed: Date, amount: Money) kind institutional {
    label en official "a contribution made on account of the taxable year by the return due date (without extensions) is deemed made on the last day of that year (rules similar to section 219(f)(3), section 223(d)(4)(B))";
}
@source(IRC_S223_D, quote = "(B) Section 219(f)(3) (relating to time when contributions deemed made).")
rule HsaContributionDeemedMadeLastDayOfYear(p: Individual, acct: Integer, y: TaxableYear, made: Date, due: Date, last_day: Date, amount: Money) strict {
    label en official "a contribution on account of a taxable year made not later than the return due date, without extensions, is deemed made on the last day of that year (section 223(d)(4)(B))";
    when hsa_contribution_made_on(p, acct, made, y, amount);
    when return_filing_due_date_without_extensions(p, y, due);
    when taxable_year_last_day(y, last_day);
    when made <= due;
    then hsa_contribution_deemed_made_on_last_day_of_year(p, acct, y, last_day, amount);
}

// --- (e)(1): tax exemption ---------------------------------------------------------------------------------

pub relation hsa_has_ceased_to_be_health_savings_account(acct: Integer) kind empirical {
    label en official "the account has ceased to be a health savings account (section 223(e)(1))";
}
pub relation hsa_exempt_from_income_tax(acct: Integer) kind institutional {
    label en official "the health savings account is exempt from taxation under subtitle A (section 223(e)(1))";
}
pub relation hsa_subject_to_section_511_tax(acct: Integer) kind institutional {
    label en official "the health savings account is subject to the tax on unrelated business income imposed by section 511 (section 223(e)(1))";
}
@source(IRC_S223_E, quote = "A health savings account is exempt from taxation under this subtitle unless such account has ceased to be a health savings account.")
rule HsaExemptFromTaxation(acct: Integer) defeasible {
    label en official "a health savings account is exempt from income taxation while it remains such an account (section 223(e)(1))";
    when health_savings_account(acct);
    unless hsa_has_ceased_to_be_health_savings_account(acct);
    then hsa_exempt_from_income_tax(acct);
}
@source(IRC_S223_E, quote = "Notwithstanding the preceding sentence, any such account is subject to the taxes imposed by section 511")
rule HsaSubjectToSection511(acct: Integer) strict {
    label en official "the exemption does not displace the section 511 tax on unrelated business income (section 223(e)(1))";
    when health_savings_account(acct);
    then hsa_subject_to_section_511_tax(acct);
}

// --- (f)(1),(2): distributions -------------------------------------------------------------------------------

pub relation hsa_distribution(dist: Integer, acct: Integer, b: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid or distributed out of a health savings account to or for the account beneficiary in the taxable year";
}
pub relation hsa_dist_used_exclusively_for_qme(dist: Integer) kind empirical {
    label en official "the distribution is used exclusively to pay qualified medical expenses of an account beneficiary (section 223(f)(1))";
}
pub relation hsa_dist_not_used_exclusively_for_qme(dist: Integer) kind empirical {
    label en official "the distribution is not used exclusively to pay the qualified medical expenses of the account beneficiary (section 223(f)(2))";
}
pub relation hsa_distribution_excluded_from_gross_income(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the distribution is not includible in gross income (section 223(f)(1))";
}
pub relation hsa_distribution_included_in_gross_income(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the distribution is included in the gross income of the account beneficiary (section 223(f)(2))";
}
@source(IRC_S223_F, quote = "which is used exclusively to pay qualified medical expenses of any account beneficiary shall not be includible in gross income")
rule HsaDistributionForQualifiedExpensesExcluded(dist: Integer, acct: Integer, b: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a distribution used exclusively for qualified medical expenses is not includible in gross income (section 223(f)(1))";
    when hsa_distribution(dist, acct, b, y, amount);
    when hsa_dist_used_exclusively_for_qme(dist);
    then hsa_distribution_excluded_from_gross_income(dist, b, y, amount);
}
@source(IRC_S223_F, quote = "shall be included in the gross income of such beneficiary")
rule HsaDistributionOtherwiseIncluded(dist: Integer, acct: Integer, b: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "a distribution not used exclusively for qualified medical expenses is included in the beneficiary's gross income (section 223(f)(2)), unless an exception below applies";
    when hsa_distribution(dist, acct, b, y, amount);
    when hsa_dist_not_used_exclusively_for_qme(dist);
    unless hsa_distribution_exempted_from_inclusion(dist, b, y, amount);
    then hsa_distribution_included_in_gross_income(dist, b, y, amount);
}
pub relation hsa_distribution_exempted_from_inclusion(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "paragraph (2) does not apply to the distribution: a returned excess contribution (paragraph (3)) or a rollover (paragraph (5))";
}

// --- (f)(3): excess contributions returned before the due date --------------------------------------------------

pub relation hsa_excess_contribution(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the contribution (other than a rollover) that is neither excludable under section 106(d) nor deductible under section 223 (section 223(f)(3)(B))";
}
@source(IRC_S223_F, quote = "the term \"excess contribution\" means any contribution (other than a rollover contribution described in paragraph (5) or section 220(f)(5)) which is neither excludable from gross income under section 106(d) nor deductible under this section")
rule HsaExcessContributionDerived(p: Individual, y: TaxableYear, paid: Money, deductible: Money) strict {
    label en official "the part of the cash contributed that exceeds the deductible amount is an excess contribution (section 223(f)(3)(B)); employer contributions excludable under section 106(d) are not in `hsa_contribution_for_year`";
    when hsa_contribution_for_year(p, y, paid);
    when hsa_deduction_computed(p, y, deductible);
    when paid > deductible;
    then hsa_excess_contribution(p, y, paid - deductible);
}
pub relation hsa_excess_returned(p: Individual, y: TaxableYear, dist: Integer, amount: Money, net_income: Money, received_on: Date) kind empirical {
    label en official "a distribution from the individual's health savings accounts returning excess contributions for the year, with the net income attributable to them, received on the date (section 223(f)(3)(A))";
}
pub relation return_filing_due_date_with_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the last day prescribed by law (including extensions of time) for filing the individual's return for the taxable year";
}
pub relation hsa_excess_return_year_received(p: Individual, y: TaxableYear, received_year: TaxableYear) kind empirical {
    label en official "the taxable year in which the returned excess and its net income are received";
}
pub relation hsa_excess_return_qualifies(p: Individual, y: TaxableYear, dist: Integer, amount: Money) kind institutional {
    label en official "the returned excess is not included in gross income under paragraph (2): received by the return due date with extensions and accompanied by its net income, up to the excess contributions (section 223(f)(3)(A))";
}
@source(IRC_S223_F, quote = "such distribution is received by the individual on or before the last day prescribed by law (including extensions of time) for filing such individual's return for such taxable year")
rule HsaExcessReturnQualifies(p: Individual, y: TaxableYear, dist: Integer, amount: Money, net_income: Money, received: Date, due: Date, excess: Money) strict {
    label en official "a distribution of an excess contribution with its net income, received by the return due date including extensions, is not included under paragraph (2) to the extent it does not exceed the excess contributions (section 223(f)(3)(A))";
    when hsa_excess_returned(p, y, dist, amount, net_income, received);
    when return_filing_due_date_with_extensions(p, y, due);
    when hsa_excess_contribution(p, y, excess);
    when received <= due;
    then hsa_excess_return_qualifies(p, y, dist, min(amount, excess));
}
pub relation hsa_returned_net_income_included(p: Individual, received_year: TaxableYear, net_income: Money) kind institutional {
    label en official "the net income attributable to a returned excess contribution is included in gross income for the taxable year in which it is received (section 223(f)(3)(A) last sentence)";
}
@source(IRC_S223_F, quote = "Any net income described in clause (ii) shall be included in the gross income of the individual for the taxable year in which it is received.")
rule HsaReturnedNetIncomeIncluded(p: Individual, y: TaxableYear, dist: Integer, amount: Money, net_income: Money, received: Date, received_year: TaxableYear, qualified: Money) strict {
    label en official "the net income accompanying a qualifying return of excess is gross income of the year received (section 223(f)(3)(A))";
    when hsa_excess_returned(p, y, dist, amount, net_income, received);
    when hsa_excess_return_qualifies(p, y, dist, qualified);
    when hsa_excess_return_year_received(p, y, received_year);
    then hsa_returned_net_income_included(p, received_year, net_income);
}

// --- (f)(4): the 20 percent additional tax -------------------------------------------------------------------------

pub relation account_beneficiary_disabled_or_dead_before_payment(dist: Integer) kind empirical {
    label en official "the payment or distribution is made after the account beneficiary becomes disabled within the meaning of section 72(m)(7) or dies (section 223(f)(4)(B))";
}
pub relation payment_after_medicare_age_date(dist: Integer) kind empirical {
    label en official "the payment or distribution is made after the date on which the account beneficiary attains the age specified in section 1811 of the Social Security Act (section 223(f)(4)(C))";
}
pub relation hsa_additional_tax_exception(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "an exception of section 223(f)(4)(B) or (C) removes the additional tax on the included distribution";
}
@source(IRC_S223_F, quote = "Subparagraph (A) shall not apply if the payment or distribution is made after the account beneficiary becomes disabled within the meaning of section 72(m)(7) or dies.")
rule HsaAdditionalTaxExceptionDisabilityOrDeath(dist: Integer, b: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "no additional tax on a distribution after the beneficiary becomes disabled or dies (section 223(f)(4)(B))";
    when hsa_distribution_included_in_gross_income(dist, b, y, amount);
    when account_beneficiary_disabled_or_dead_before_payment(dist);
    then hsa_additional_tax_exception(dist, b, y, amount);
}
@source(IRC_S223_F, quote = "Subparagraph (A) shall not apply to any payment or distribution after the date on which the account beneficiary attains the age specified in section 1811 of the Social Security Act.")
rule HsaAdditionalTaxExceptionMedicareAge(dist: Integer, b: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "no additional tax on a distribution after the beneficiary attains the medicare age (section 223(f)(4)(C))";
    when hsa_distribution_included_in_gross_income(dist, b, y, amount);
    when payment_after_medicare_age_date(dist);
    then hsa_additional_tax_exception(dist, b, y, amount);
}
pub relation hsa_additional_tax_on_distribution(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the tax imposed by chapter 1: 20 percent of the amount includible under paragraph (2) (section 223(f)(4)(A))";
}
@source(IRC_S223_F, quote = "shall be increased by 20 percent of the amount which is so includible")
rule HsaAdditionalTaxTwentyPercent(dist: Integer, b: Individual, y: TaxableYear, amount: Money) defeasible {
    label en official "the tax is increased by 20 percent of the amount includible under paragraph (2), unless an exception applies (section 223(f)(4)(A))";
    when hsa_distribution_included_in_gross_income(dist, b, y, amount);
    unless hsa_additional_tax_exception(dist, b, y, amount);
    then hsa_additional_tax_on_distribution(dist, b, y, round(amount * 20 percent, 2, "HALF_UP"));
}

// --- (f)(5): rollover contribution -----------------------------------------------------------------------------------

pub relation hsa_rollover_received_and_repaid(dist: Integer, b: Individual, y: TaxableYear, amount: Money, received_on: Date, repaid_on: Date) kind empirical {
    label en official "an amount distributed from a health savings account to the account beneficiary and paid into a health savings account for the benefit of the beneficiary on the later date (section 223(f)(5)(A))";
}
pub relation another_untaxed_rollover_in_prior_year_ending_on_receipt(dist: Integer, b: Individual) kind empirical {
    label en official "at any time during the 1-year period ending on the day of receipt the individual received another amount described in paragraph (5)(A) not includible in gross income because of paragraph (5) (section 223(f)(5)(B))";
}
pub relation hsa_rollover_contribution(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount is a rollover contribution described in section 223(f)(5): paid into a health savings account not later than the 60th day after receipt, and within the one-rollover-per-year limit";
}
@source(IRC_S223_F, quote = "not later than the 60th day after the day on which the beneficiary receives the payment or distribution")
rule HsaRolloverWithin60DaysOnePerYear(dist: Integer, b: Individual, y: TaxableYear, amount: Money, received: Date, repaid: Date) strict {
    label en official "an amount paid into a health savings account for the beneficiary not later than the 60th day after receipt is a rollover contribution, unless another such rollover was received within the preceding year (section 223(f)(5)(A),(B))";
    when hsa_rollover_received_and_repaid(dist, b, y, amount, received, repaid);
    when repaid <= add_calendar_period(received, 60 calendar_day);
    when not_known(another_untaxed_rollover_in_prior_year_ending_on_receipt(dist, b));
    then hsa_rollover_contribution(dist, b, y, amount);
}
@source(IRC_S223_F, quote = "Paragraph (2) shall not apply to any amount paid or distributed from a health savings account to the account beneficiary to the extent the amount received is paid into a health savings account")
rule HsaRolloverExemptedFromInclusion(dist: Integer, b: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a rollover contribution is exempted from inclusion under paragraph (2) (section 223(f)(5)(A))";
    when hsa_rollover_contribution(dist, b, y, amount);
    then hsa_distribution_exempted_from_inclusion(dist, b, y, amount);
}
rule HsaExcessReturnExemptedFromInclusion(p: Individual, y: TaxableYear, dist: Integer, amount: Money) strict {
    label en official "a qualifying return of an excess contribution is exempted from inclusion under paragraph (2) (section 223(f)(3)(A))";
    when hsa_excess_return_qualifies(p, y, dist, amount);
    then hsa_distribution_exempted_from_inclusion(dist, p, y, amount);
}

// --- (f)(6),(7),(8) -------------------------------------------------------------------------------------------------------

pub relation hsa_distribution_for_qualified_medical_expenses(dist: Integer, b: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "a payment or distribution out of a health savings account for qualified medical expenses (section 223(f)(6))";
}
pub relation expense_paid_for_medical_care_for_section_213(b: Individual, y: TaxableYear, dist: Integer, amount: Money) kind institutional {
    label en official "the amount that is treated as an expense paid for medical care for the section 213 deduction: an HSA distribution for qualified medical expenses is not so treated (section 223(f)(6))";
}
@source(IRC_S223_F, quote = "any payment or distribution out of a health savings account for qualified medical expenses shall not be treated as an expense paid for medical care")
rule HsaDistributionNotSection213Expense(dist: Integer, b: Individual, y: TaxableYear, amount: Money) strict {
    label en official "for the section 213 deduction an HSA distribution for qualified medical expenses is not an expense paid for medical care (section 223(f)(6))";
    when hsa_distribution_excluded_from_gross_income(dist, b, y, amount);
    then not expense_paid_for_medical_care_for_section_213(b, y, dist, amount);
}
pub relation hsa_interest_transferred_to_spouse_or_former_spouse_under_divorce_instrument(acct: Integer, from_p: Individual, to_p: Individual) kind empirical {
    label en official "an individual's interest in a health savings account is transferred to the spouse or former spouse under a divorce or separation instrument described in section 121(d)(3)(C)(i) (section 223(f)(7))";
}
pub relation hsa_divorce_transfer_is_taxable_transfer(acct: Integer, from_p: Individual) kind institutional {
    label en official "the transfer is a taxable transfer made by the individual";
}
@source(IRC_S223_F, quote = "shall not be considered a taxable transfer made by such individual notwithstanding any other provision of this subtitle")
rule HsaDivorceTransferNotTaxable(acct: Integer, from_p: Individual, to_p: Individual) strict {
    label en official "the divorce or separation transfer of an HSA interest to the spouse or former spouse is not a taxable transfer (section 223(f)(7))";
    when hsa_interest_transferred_to_spouse_or_former_spouse_under_divorce_instrument(acct, from_p, to_p);
    then not hsa_divorce_transfer_is_taxable_transfer(acct, from_p);
}
@source(IRC_S223_F, quote = "such interest shall, after such transfer, be treated as a health savings account with respect to which such spouse is the account beneficiary")
rule HsaDivorceTransfereeIsAccountBeneficiary(acct: Integer, from_p: Individual, to_p: Individual) strict {
    label en official "after the divorce transfer the spouse or former spouse is the account beneficiary (section 223(f)(7))";
    when hsa_interest_transferred_to_spouse_or_former_spouse_under_divorce_instrument(acct, from_p, to_p);
    then account_beneficiary(acct, to_p);
}
pub relation surviving_spouse_designated_beneficiary_acquires_hsa(acct: Integer, deceased: Individual, spouse: Individual) kind empirical {
    label en official "the account beneficiary's surviving spouse acquires the interest by reason of being the designated beneficiary at the death of the account beneficiary (section 223(f)(8)(A))";
}
@source(IRC_S223_F, quote = "such health savings account shall be treated as if the spouse were the account beneficiary")
rule HsaSurvivingSpouseBecomesAccountBeneficiary(acct: Integer, deceased: Individual, spouse: Individual) strict {
    label en official "the surviving spouse who is the designated beneficiary is treated as the account beneficiary (section 223(f)(8)(A))";
    when surviving_spouse_designated_beneficiary_acquires_hsa(acct, deceased, spouse);
    then account_beneficiary(acct, spouse);
}
pub relation other_person_acquires_hsa_by_reason_of_death(acct: Integer, deceased: Individual, acquirer: Person) kind empirical {
    label en official "by reason of the death of the account beneficiary any person acquires the interest in a case to which subparagraph (A) does not apply (section 223(f)(8)(B)(i))";
}
pub relation acquirer_is_estate_of_deceased(acquirer: Person, deceased: Individual) kind empirical {
    label en official "the acquirer is the estate of the account beneficiary";
}
pub relation hsa_fair_market_value_at_death(acct: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the assets in the account on the date of death (section 223(f)(8)(B)(i)(II))";
}
pub relation predeath_qualified_expenses_paid_by_acquirer_within_one_year(acct: Integer, acquirer: Person, amount: Money) kind empirical {
    label en official "qualified medical expenses incurred by the decedent before death and paid by the acquirer within 1 year after the date of death (section 223(f)(8)(B)(ii)(I))";
}
pub relation hsa_ceases_to_be_hsa_at_death(acct: Integer) kind institutional {
    label en official "the account ceases to be a health savings account as of the date of death (section 223(f)(8)(B)(i)(I))";
}
pub relation hsa_death_inclusion(acct: Integer, acquirer: Person, amount: Money) kind institutional {
    label en official "the amount includible in the gross income of the acquirer (or of the deceased for the last taxable year if the acquirer is the estate) on the beneficiary's death (section 223(f)(8)(B)(i)(II))";
}
@source(IRC_S223_F, quote = "such account shall cease to be a health savings account as of the date of death")
rule HsaCeasesAtDeathWhenNotSpouse(acct: Integer, deceased: Individual, acquirer: Person) strict {
    label en official "where the interest passes other than to a surviving spouse designated beneficiary, the account ceases to be a health savings account at death (section 223(f)(8)(B)(i)(I))";
    when other_person_acquires_hsa_by_reason_of_death(acct, deceased, acquirer);
    then hsa_ceases_to_be_hsa_at_death(acct);
}
@source(IRC_S223_F, quote = "an amount equal to the fair market value of the assets in such account on such date shall be includible")
rule HsaDeathInclusionNonEstate(acct: Integer, deceased: Individual, acquirer: Person, fmv: Money, paid: Money) strict {
    label en official "a non-estate acquirer includes the fair market value at death, reduced by qualified predeath expenses of the decedent paid within one year, not below zero (section 223(f)(8)(B)(i)(II),(ii)(I))";
    when other_person_acquires_hsa_by_reason_of_death(acct, deceased, acquirer);
    when hsa_fair_market_value_at_death(acct, fmv);
    when predeath_qualified_expenses_paid_by_acquirer_within_one_year(acct, acquirer, paid);
    when not_known(acquirer_is_estate_of_deceased(acquirer, deceased));
    then hsa_death_inclusion(acct, acquirer, max(0.00 USD, fmv - paid));
}
@source(IRC_S223_F, quote = "or if such person is the estate of such beneficiary, in such beneficiary's gross income for the last taxable year of such beneficiary")
rule HsaDeathInclusionEstate(acct: Integer, deceased: Individual, acquirer: Person, fmv: Money) strict {
    label en official "where the acquirer is the estate the fair market value at death is included, without reduction, in the decedent's last taxable year (section 223(f)(8)(B)(i)(II))";
    when other_person_acquires_hsa_by_reason_of_death(acct, deceased, acquirer);
    when acquirer_is_estate_of_deceased(acquirer, deceased);
    when hsa_fair_market_value_at_death(acct, fmv);
    then hsa_death_inclusion(acct, acquirer, fmv);
}
pub relation section_691c_deduction_allowed_on_hsa_inclusion(acct: Integer, acquirer: Person, amount: Money) kind institutional {
    label en official "an appropriate deduction under section 691(c) is allowed to a person other than the decedent or the decedent's spouse with respect to the amounts included (section 223(f)(8)(B)(ii)(II))";
}
@source(IRC_S223_F, quote = "An appropriate deduction shall be allowed under section 691(c) to any person (other than the decedent or the decedent's spouse)")
rule HsaDeathInclusionSection691cDeduction(acct: Integer, deceased: Individual, acquirer: Person, amount: Money) strict {
    label en official "a person other than the decedent or the decedent's spouse who includes the amount is allowed a section 691(c) deduction (section 223(f)(8)(B)(ii)(II)); the amount of the deduction is section 691(c)'s computation";
    when hsa_death_inclusion(acct, acquirer, amount);
    when other_person_acquires_hsa_by_reason_of_death(acct, deceased, acquirer);
    when not_known(acquirer_is_estate_of_deceased(acquirer, deceased));
    then section_691c_deduction_allowed_on_hsa_inclusion(acct, acquirer, amount);
}

// --- (g): indexing arithmetic and the Secretary's publication duty ---------------------------------------------------------

pub relation hsa_cost_of_living_adjustment_factor(y: TaxableYear, base_year: Integer, factor: Decimal) kind empirical {
    label en official "the cost-of-living adjustment determined under section 1(f)(3) for the calendar year in which the taxable year begins, with calendar year 1997 as the base (2003 for the subsection (c)(2)(A) amounts) (section 223(g)(1)(B))";
}
pub relation hsa_indexed_dollar_amount(y: TaxableYear, base_amount: Money, indexed: Money) kind institutional {
    label en official "a subsection (b)(2) or (c)(2)(A) dollar amount increased by the amount times the cost-of-living adjustment, the increase rounded to the nearest multiple of $50 (section 223(g)(1),(2))";
}
pub relation hsa_dollar_amount_under_indexation(y: TaxableYear, base_year: Integer, amount: Money) kind empirical {
    label en official "a statutory dollar amount of subsection (b)(2) or (c)(2)(A) subject to indexation, with the base year of its cost-of-living adjustment";
}
@source(IRC_S223_G, quote = "If any increase under paragraph (1) is not a multiple of $50, such increase shall be rounded to the nearest multiple of $50.")
rule HsaIndexedAmountRoundedToFifty(y: TaxableYear, base_year: Integer, amount: Money, factor: Decimal) strict {
    label en official "the increase is the dollar amount times the cost-of-living adjustment, rounded to the nearest multiple of $50 (section 223(g)(1),(2)); the published amounts of a given year are not pinned in this package";
    when hsa_dollar_amount_under_indexation(y, base_year, amount);
    when hsa_cost_of_living_adjustment_factor(y, base_year, factor);
    then hsa_indexed_dollar_amount(y, amount, amount + 50.00 USD * div_round(amount * factor, 50.00 USD, 0, "HALF_UP"));
}
pub relation hsa_indexed_amounts_published_for_calendar_year(cy: Integer) kind empirical {
    label en official "the Secretary has published the adjusted amounts under subsections (b)(2) and (c)(2)(A) for taxable years beginning in the calendar year (section 223(g)(1))";
}
pub relation hsa_indexed_amounts_publication_deadline(cy: Integer, deadline: Date) kind empirical {
    label en official "June 1 of the calendar year preceding the calendar year for which the amounts are published (section 223(g)(1))";
}
@source(IRC_S223_G, quote = "the Secretary shall publish the adjusted amounts under subsections (b)(2) and (c)(2)(A) for taxable years beginning in any calendar year no later than June 1 of the preceding calendar year")
rule SecretaryPublishHsaIndexedAmountsDuty defeasible {
    for cy: Integer;
    for deadline: Date;
    when hsa_indexed_amounts_publication_deadline(cy, deadline);
    then duty S223PublishIndexedAmounts {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition hsa_indexed_amounts_published_for_calendar_year(cy);
            window [-infinity, deadline];
        }
    };
}

// --- (h): reports ------------------------------------------------------------------------------------------------------------

pub relation secretary_requires_hsa_trustee_report(acct: Integer) kind empirical {
    label en official "the Secretary requires the trustee of the health savings account to make reports to the Secretary and to the account beneficiary on contributions, distributions, the return of excess contributions and other matters (section 223(h)(1))";
}
pub relation secretary_requires_hdhp_provider_report(p: Person) kind empirical {
    label en official "the Secretary requires a person who provides an individual with a high deductible health plan to make reports on the plan to the Secretary and the account beneficiary (section 223(h)(2))";
}
pub relation hsa_trustee_report_required(acct: Integer) kind institutional {
    label en official "the trustee reporting requirement is in effect for the account (section 223(h)(1))";
}
@source(IRC_S223_H, quote = "the trustee of a health savings account to make such reports regarding such account to the Secretary and to the account beneficiary")
rule S223HTrusteeReportPower(acct: Integer) strict {
    label en official "the Secretary may require the trustee of a health savings account to make reports (section 223(h)(1)); an exercise for an account that is not a health savings account has no effect";
    when secretary_requires_hsa_trustee_report(acct);
    then power S223RequireTrusteeReports {
        holder us.irc.core::Secretary;
        over acct;
        exercise secretary_requires_hsa_trustee_report(acct);
        valid_when health_savings_account(acct);
        effect create(hsa_trustee_report_required(acct));
        window [-infinity, infinity];
    };
}
pub relation hdhp_provider_report_required(p: Person) kind institutional {
    label en official "the reporting requirement for a provider of a high deductible health plan is in effect (section 223(h)(2))";
}
pub relation is_hdhp_provider(p: Person) kind empirical {
    label en official "the person provides an individual with a high deductible health plan";
}
@source(IRC_S223_H, quote = "any person who provides an individual with a high deductible health plan to make such reports to the Secretary and to the account beneficiary")
rule S223HProviderReportPower(p: Person) strict {
    label en official "the Secretary may require a provider of a high deductible health plan to make reports (section 223(h)(2)); an exercise over a person who provides no such plan has no effect";
    when secretary_requires_hdhp_provider_report(p);
    then power S223RequireHdhpProviderReports {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_requires_hdhp_provider_report(p);
        valid_when is_hdhp_provider(p);
        effect create(hdhp_provider_report_required(p));
        window [-infinity, infinity];
    };
}
