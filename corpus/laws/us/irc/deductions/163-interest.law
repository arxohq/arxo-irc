// Section 163 — Interest. Stage 1 (IRC-06), priority section.
//
// Scope of this module: (a) general rule; (d) investment interest limitation
// with carryforward; (h) personal interest disallowance and qualified
// residence interest, including the acquisition-indebtedness dollar limits
// and Pub. L. 119-21 section 70108 (removes the 2018-2025 sunset, makes the
// $750,000/$375,000 substitution permanent); (j) business interest
// limitation (30% of adjusted taxable income) with carryforward, small
// business exemption, and Pub. L. 119-21 section 70303 (permanent EBITDA-
// style addback, striking the "before 2022" limit on the depreciation/
// amortization/depletion addback in (j)(8)(A)(v)). (b) (imputed interest on
// installment sales), (e) (original issue discount), (i) (applicable high
// yield discount obligations), (k) (section 6166 interest) stay "stage 2".

// --- §163(a): general rule ----------------------------------------------------

use self::{
    DeductionKind,
    IRC_S163_A,
    IRC_S163_D,
    IRC_S163_H,
    IRC_S163_J,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
    interest_denied_by_163_special_rule,
};

pub relation interest_paid_or_accrued(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid or accrued within the taxable year on indebtedness (section 163(a))";
}

@source(IRC_S163_A, quote = "There shall be allowed as a deduction all interest paid or accrued within the taxable year on indebtedness")
rule InterestGeneralRuleAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "interest paid or accrued within the taxable year on indebtedness is allowed as a deduction, subject to the limitations of subsections (d), (h) and (j)";
    when interest_paid_or_accrued(p, y, item, amount);
    when not_known(personal_interest_item(p, y, item));
    when not_known(investment_interest_item(p, y, item));
    when not_known(business_interest_item(p, y, item));
    when not_known(interest_denied_by_163_special_rule(p, y, item));
    then deduction_allowed(p, y, Section163Interest, amount);
}
// classification: the general rule's default channel covers interest that
// is none of "personal", "investment" or "business" (e.g. interest on a tax
// deficiency outside those categories) — a case that classifies its item
// into one of the three special categories is instead governed by the
// category-specific rules below, which may allow, cap, or disallow it.

// --- §163(d): limitation on investment interest -------------------------------

pub relation investment_interest_item(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "interest allocable to property held for investment, other than qualified residence interest or passive-activity interest under section 469 (section 163(d)(3))";
}
pub relation investment_interest_paid(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate investment interest paid or accrued for the taxable year, before the section 163(d)(1) limitation (section 163(d))";
}
pub relation net_investment_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "net investment income: investment income minus investment expenses (section 163(d)(4)(A))";
}
pub relation investment_interest_carryforward_from_prior_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "investment interest disallowed in the prior taxable year, treated as paid or accrued in this taxable year (section 163(d)(2))";
}
pub relation investment_interest_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "investment interest allowed as a deduction for the taxable year, after the section 163(d)(1) limitation (section 163(d))";
}
pub relation investment_interest_carryforward_to_next_year(p: Person, y_from: TaxableYear, y_to: TaxableYear, amount: Money) kind institutional {
    label en official "investment interest not allowed by reason of section 163(d)(1), carried forward to the succeeding taxable year (section 163(d)(2))";
}

@source(IRC_S163_D, quote = "the amount allowed as a deduction under this chapter for investment interest for any taxable year shall not exceed the net investment income of the taxpayer for the taxable year")
rule InvestmentInterestLimitationBinds(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, gross: Money, nii: Money) strict {
    label en official "investment interest for a non-corporate taxpayer is limited to net investment income for the taxable year; the excess is disallowed for the year (section 163(d)(1))";
    when us.irc.income_individual::filing_status(p, y, s);
    when investment_interest_paid(p, y, gross);
    when net_investment_income(p, y, nii);
    when gross > nii;
    then investment_interest_allowed(p, y, nii);
}
@source(IRC_S163_D, quote = "the amount allowed as a deduction under this chapter for investment interest for any taxable year shall not exceed the net investment income of the taxpayer for the taxable year")
rule InvestmentInterestUnderLimitFullyAllowed(p: Person, y: TaxableYear, s: us.irc.income_individual::FilingStatus, gross: Money, nii: Money) strict {
    label en official "investment interest not exceeding net investment income is fully allowed (section 163(d)(1))";
    when us.irc.income_individual::filing_status(p, y, s);
    when investment_interest_paid(p, y, gross);
    when net_investment_income(p, y, nii);
    when gross <= nii;
    then investment_interest_allowed(p, y, gross);
}
@source(IRC_S163_D, quote = "The amount not allowed as a deduction for any taxable year by reason of paragraph (1) shall be treated as investment interest paid or accrued by the taxpayer in the succeeding taxable year")
rule InvestmentInterestCarryforwardComputed(p: Person, y: TaxableYear, y_next: TaxableYear, gross: Money, nii: Money) strict {
    label en official "investment interest disallowed for the year carries forward, without expiration, to the succeeding taxable year (section 163(d)(2)) — a scenario asserts `y_next` as its own second TaxableYear instance (successor-year derivation from a calendar-year integer is a TECH_GAP, see coverage row)";
    when investment_interest_paid(p, y, gross);
    when net_investment_income(p, y, nii);
    when gross > nii;
    when us.irc.core::year_of(p, y_next);
    then investment_interest_carryforward_to_next_year(p, y, y_next, gross - nii);
}

@source(IRC_S163_D, quote = "The amount not allowed as a deduction for any taxable year by reason of paragraph (1) shall be treated as investment interest paid or accrued by the taxpayer in the succeeding taxable year")
rule InvestmentInterestCarryforwardAppliedNextYear(p: Person, y: TaxableYear, carried: Money) strict {
    label en official "investment interest carried forward from the prior year is treated as investment interest paid or accrued this year (section 163(d)(2))";
    when investment_interest_carryforward_from_prior_year(p, y, carried);
    then investment_interest_item(p, y, -1);
}
// (the `item = -1` sentinel marks the carryforward as a distinct pseudo-item
// so it does not collide with a scenario's own item numbering; the amount
// itself feeds `investment_interest_paid` through case composition, not a
// separate rule, to avoid double-counting to the same relation from two
// rule heads).

// --- §163(h): disallowance of deduction for personal interest -----------------

pub relation personal_interest_item(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "interest allowable as a deduction under chapter 1 other than trade-or-business, investment, passive-activity, qualified residence, section 6601/2001 estate-tax-extension, or section 221 education-loan interest (section 163(h)(2))";
}

@source(IRC_S163_H, quote = "In the case of a taxpayer other than a corporation, no deduction shall be allowed under this chapter for personal interest paid or accrued during the taxable year")
rule PersonalInterestDisallowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for personal interest of a non-corporate taxpayer (section 163(h)(1))";
    when interest_paid_or_accrued(p, y, item, amount);
    when personal_interest_item(p, y, item);
    then not deduction_allowed(p, y, Section163Interest, amount);
}

pub relation qualified_residence_interest_item(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid or accrued on acquisition indebtedness or home equity indebtedness with respect to a qualified residence (section 163(h)(3)(A))";
}
pub relation acquisition_indebtedness_outstanding(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount treated as acquisition indebtedness with respect to the taxpayer's qualified residence(s) for the period (section 163(h)(3)(B)(i))";
}

@source(IRC_S163_H, quote = "The aggregate amount treated as acquisition indebtedness for any period shall not exceed $1,000,000 ($500,000 in the case of a married individual filing a separate return)")
rule QualifiedResidenceInterestAllowedWithinLimitPre2018(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, item: Integer, amount: Money, outstanding: Money) strict {
    label en official "before 2018: qualified residence interest is allowed to the extent acquisition indebtedness does not exceed $1,000,000 ($500,000 married filing separately)";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when qualified_residence_interest_item(p, y, item, amount);
    when acquisition_indebtedness_outstanding(p, y, outstanding);
    when s == us.irc.income_individual::MarriedSeparate;
    when outstanding <= round(QriAcquisitionIndebtednessLimitMfs, 2, "HALF_UP");
    then deduction_allowed(p, y, Section163Interest, amount);
}
@source(IRC_S163_H, quote = "Subparagraph (B)(ii) shall be applied by substituting \"$750,000 ($375,000\" for \"$1,000,000 ($500,000\"")
rule QualifiedResidenceInterestAllowedWithinLimitFrom2018(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, item: Integer, amount: Money, outstanding: Money) strict {
    label en official "for taxable years beginning after December 31, 2017 (permanently, per Pub. L. 119-21 section 70108): qualified residence interest is allowed to the extent acquisition indebtedness does not exceed $750,000 ($375,000 married filing separately)";
    effective [@2018-01-01, infinity);
    when us.irc.income_individual::filing_status(p, y, s);
    when qualified_residence_interest_item(p, y, item, amount);
    when acquisition_indebtedness_outstanding(p, y, outstanding);
    when s == us.irc.income_individual::MarriedSeparate;
    when outstanding <= round(QriAcquisitionIndebtednessLimitMfs, 2, "HALF_UP");
    then deduction_allowed(p, y, Section163Interest, amount);
}
@source(IRC_S163_H, quote = "The aggregate amount treated as acquisition indebtedness for any period shall not exceed $1,000,000 ($500,000 in the case of a married individual filing a separate return)")
rule QualifiedResidenceInterestAllowedWithinLimitPre2018General(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, item: Integer, amount: Money, outstanding: Money) strict {
    label en official "before 2018, not married filing separately: qualified residence interest is allowed to the extent acquisition indebtedness does not exceed $1,000,000";
    effective (-infinity, @2018-01-01);
    when us.irc.income_individual::filing_status(p, y, s);
    when qualified_residence_interest_item(p, y, item, amount);
    when acquisition_indebtedness_outstanding(p, y, outstanding);
    when s != us.irc.income_individual::MarriedSeparate;
    when outstanding <= round(QriAcquisitionIndebtednessLimitGeneral, 2, "HALF_UP");
    then deduction_allowed(p, y, Section163Interest, amount);
}
@source(IRC_S163_H, quote = "Subparagraph (B)(ii) shall be applied by substituting \"$750,000 ($375,000\" for \"$1,000,000 ($500,000\"")
rule QualifiedResidenceInterestAllowedWithinLimitFrom2018General(p: Individual, y: TaxableYear, s: us.irc.income_individual::FilingStatus, item: Integer, amount: Money, outstanding: Money) strict {
    label en official "for taxable years beginning after December 31, 2017, not married filing separately: qualified residence interest is allowed to the extent acquisition indebtedness does not exceed $750,000, permanently per Pub. L. 119-21 section 70108";
    effective [@2018-01-01, infinity);
    when us.irc.income_individual::filing_status(p, y, s);
    when qualified_residence_interest_item(p, y, item, amount);
    when acquisition_indebtedness_outstanding(p, y, outstanding);
    when s != us.irc.income_individual::MarriedSeparate;
    when outstanding <= round(QriAcquisitionIndebtednessLimitGeneral, 2, "HALF_UP");
    then deduction_allowed(p, y, Section163Interest, amount);
}
// Above-the-limit acquisition indebtedness (interest allocable to the
// EXCESS over the dollar limit is not qualified residence interest, and so
// falls back to `personal_interest_item`'s disallowance), home equity
// indebtedness's separate (and, from 2018 through the permanent-suspension
// text, ELIMINATED) allowance, the pre-October-13-1987 grandfather rule,
// and the mortgage-insurance-premium-as-interest treatment (with its own
// Pub. L. 119-21 section 70108(a)(1)(D) change to the termination clause)
// stay "stage 2" — the task named the acquisition-indebtedness dollar
// limits specifically; the remaining (h)(3) sub-paragraphs are recorded as
// unreviewed with note "stage 2" in the coverage rows, not silently merged
// into the two rules above.

// --- §163(j): limitation on business interest ---------------------------------

pub relation business_interest_item(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "interest paid or accrued on indebtedness properly allocable to a trade or business, other than investment interest (section 163(j)(5))";
}
pub relation business_interest_paid(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate business interest paid or accrued for the taxable year, before the section 163(j)(1) limitation";
}
pub relation business_interest_income(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "business interest income for the taxable year (section 163(j)(6))";
}
pub relation floor_plan_financing_interest(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "floor plan financing interest for the taxable year (section 163(j)(9))";
}
pub relation adjusted_taxable_income_before_depreciation_addback(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxpayer's taxable income computed without regard to non-trade-or-business items, business interest/interest income, the NOL deduction, and the section 199A deduction, but BEFORE any depreciation/amortization/depletion addback (section 163(j)(8)(A)(i)-(iv)) — dependency contract, producer: unresolved (full taxable-income computation is out of this stage's scope)";
}
pub relation depreciation_amortization_depletion_deduction(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate deduction allowable for depreciation, amortization, or depletion for the taxable year (section 163(j)(8)(A)(v)) — dependency contract, producer: accounting (pending, section 167/168)";
}
pub relation adjusted_taxable_income(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted taxable income for the section 163(j) business interest limitation (section 163(j)(8))";
}
pub relation meets_gross_receipts_test_448c(p: Person, y: TaxableYear) kind institutional {
    label en official "meets the gross receipts test of section 448(c) for the taxable year, and is not a tax shelter prohibited from the cash method under section 448(a)(3) (section 163(j)(3)) — dependency contract, producer: unresolved (section 448 pending)";
}
pub relation business_interest_carryforward_from_prior_year(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "business interest not allowed in the prior taxable year by reason of section 163(j)(1), treated as business interest paid or accrued this taxable year (section 163(j)(2))";
}
pub relation business_interest_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "business interest allowed as a deduction for the taxable year, after the section 163(j)(1) limitation";
}
pub relation business_interest_carryforward_to_next_year(p: Person, y_from: TaxableYear, y_to: TaxableYear, amount: Money) kind institutional {
    label en official "business interest not allowed by reason of section 163(j)(1), carried forward without expiration to the succeeding taxable year (section 163(j)(2))";
}

@source(IRC_S163_J, quote = "the term \"adjusted taxable income\" means the taxable income of the taxpayer")
rule AdjustedTaxableIncomeEbitdaEditionPre2022(p: Person, y: TaxableYear, before_addback: Money, dad: Money) strict {
    label en official "before 2022, and again for taxable years beginning after December 31, 2024 (Pub. L. 119-21 section 70303): adjusted taxable income is computed WITH a depreciation/amortization/depletion addback";
    effective (-infinity, @2022-01-01);
    when adjusted_taxable_income_before_depreciation_addback(p, y, before_addback);
    when depreciation_amortization_depletion_deduction(p, y, dad);
    then adjusted_taxable_income(p, y, before_addback + dad);
}
@source(IRC_S163_J, quote = "in the case of taxable years beginning before January 1, 2022, any deduction allowable for depreciation, amortization, or depletion")
rule AdjustedTaxableIncomeEbitEdition2022To2024(p: Person, y: TaxableYear, before_addback: Money) strict {
    label en official "for taxable years beginning in 2022 through 2024 (pre-Pub.L.119-21 text): adjusted taxable income is computed WITHOUT a depreciation/amortization/depletion addback";
    effective [@2022-01-01, @2025-01-01);
    when adjusted_taxable_income_before_depreciation_addback(p, y, before_addback);
    then adjusted_taxable_income(p, y, before_addback);
}
@source(IRC_S163_J, quote = "in the case of taxable years beginning before January 1, 2022, any deduction allowable for depreciation, amortization, or depletion")
rule AdjustedTaxableIncomeEbitdaEditionFrom2025(p: Person, y: TaxableYear, before_addback: Money, dad: Money) strict {
    label en official "Pub. L. 119-21 section 70303(a) strikes the 'before January 1, 2022' limit: for taxable years beginning after December 31, 2024, adjusted taxable income is again computed WITH the depreciation/amortization/depletion addback, permanently";
    effective [@2025-01-01, infinity);
    when adjusted_taxable_income_before_depreciation_addback(p, y, before_addback);
    when depreciation_amortization_depletion_deduction(p, y, dad);
    then adjusted_taxable_income(p, y, before_addback + dad);
}

@source(IRC_S163_J, quote = "The amount allowed as a deduction under this chapter for any taxable year for business interest shall not exceed the sum of")
rule BusinessInterestLimitationBinds(p: Person, y: TaxableYear, gross: Money, bii: Money, ati: Money, fpfi: Money) strict {
    label en official "business interest is limited to business interest income, plus 30% of adjusted taxable income (not below zero), plus floor plan financing interest; the excess is disallowed for the year (section 163(j)(1))";
    when not_known(meets_gross_receipts_test_448c(p, y));
    when business_interest_paid(p, y, gross);
    when business_interest_income(p, y, bii);
    when adjusted_taxable_income(p, y, ati);
    when floor_plan_financing_interest(p, y, fpfi);
    when gross > bii + max(0.00 USD, round(ati * 0.30, 2, "HALF_UP")) + fpfi;
    then business_interest_allowed(p, y, bii + max(0.00 USD, round(ati * 0.30, 2, "HALF_UP")) + fpfi);
}
@source(IRC_S163_J, quote = "The amount allowed as a deduction under this chapter for any taxable year for business interest shall not exceed the sum of")
rule BusinessInterestUnderLimitFullyAllowed(p: Person, y: TaxableYear, gross: Money, bii: Money, ati: Money, fpfi: Money) strict {
    label en official "business interest not exceeding the section 163(j)(1) sum is fully allowed";
    when not_known(meets_gross_receipts_test_448c(p, y));
    when business_interest_paid(p, y, gross);
    when business_interest_income(p, y, bii);
    when adjusted_taxable_income(p, y, ati);
    when floor_plan_financing_interest(p, y, fpfi);
    when gross <= bii + max(0.00 USD, round(ati * 0.30, 2, "HALF_UP")) + fpfi;
    then business_interest_allowed(p, y, gross);
}
@source(IRC_S163_J, quote = "which meets the gross receipts test of section 448(c) for any taxable year, paragraph (1) shall not apply to such taxpayer for such taxable year")
rule BusinessInterestSmallBusinessExemption(p: Person, y: TaxableYear, gross: Money) strict {
    label en official "the section 163(j)(1) limitation does not apply to a taxpayer meeting the section 448(c) gross receipts test for the taxable year (section 163(j)(3))";
    when meets_gross_receipts_test_448c(p, y);
    when business_interest_paid(p, y, gross);
    then business_interest_allowed(p, y, gross);
}
@source(IRC_S163_J, quote = "The amount of any business interest not allowed as a deduction for any taxable year by reason of paragraph (1) shall be treated as business interest paid or accrued in the succeeding taxable year")
rule BusinessInterestCarryforwardAppliedNextYear(p: Person, y: TaxableYear, carried: Money) strict {
    label en official "business interest carried forward from the prior year is treated as business interest paid or accrued this year (section 163(j)(2))";
    when business_interest_carryforward_from_prior_year(p, y, carried);
    then business_interest_item(p, y, -1);
}
// (j)(4) partnership/S-corporation application, (j)(9) floor plan financing
// definition detail, (j)(10) 2019-2020 special COVID-era rules, and (j)(11)
// coordination with interest capitalization (Pub. L. 119-21 section 70341)
// stay "stage 2" — recorded as unreviewed with note "stage 2".
