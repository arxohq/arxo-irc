// Sections 265 and 267 — stage 2b detail (TECH_GAPS G2784). Section 265(b): qualified small issuers,
// qualified tax-exempt obligations with the 2009-2010 rules, aggregation, composites, refundings,
// definitions and coordination. Section 267: the relationships of (b)(3)-(13), the special
// matching persons of (a)(2), the foreign payee rule of (a)(3), the exceptions to (d)(1), pass-thru
// entities (e) and the controlled group definition (f)(1),(4). Stage 1 changes:
// `obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated` and
// `average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986` are institutional
// (derived here or asserted); `DeductionMatchedToPayeeIncomeItemSpecifiedForA2` is added to
// 267-related-party.law. Not modelled: the exact scope of "an entity formed to avoid the purposes"
// ((b)(3)(E)(iii)) beyond a fact, the Secretary's regulations of (a)(3)(A),(B)(ii) and (f)(3),
// the section 1563(a) definition of controlled group (a fact).

// --- 265(b)(3)(B),(C): qualified small issuer, private activity bonds ---------------------------------------------------------------------------------

use self::{
    IRC_S265_B,
    IRC_S267_A,
    IRC_S267_B,
    IRC_S267_D,
    IRC_S267_E,
    IRC_S267_F,
    Person,
    RelatedPartyRelationship,
    TaxableYear,
    average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986,
    gain_on_later_disposition,
    issuer_designated_amount_in_calendar_year,
    obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated,
    prior_loss_disallowed_under_267a1,
    qualified_tax_exempt_obligation_265,
    related_persons,
};

pub relation obligation_issued_on(obl: Integer, on: Date) kind empirical {
    label en official "the date the obligation is issued";
}
pub relation obligation_is_tax_exempt_obligation(obl: Integer) kind empirical {
    label en official "the obligation is a tax-exempt obligation (section 265(b)(4)(B))";
}
pub relation obligation_is_private_activity_bond_141(obl: Integer) kind empirical {
    label en official "the obligation is a private activity bond as defined in section 141 (section 265(b)(3)(B)(i)(II))";
}
pub relation obligation_is_qualified_501c3_bond(obl: Integer) kind empirical {
    label en official "the obligation is a qualified 501(c)(3) bond as defined in section 145 (section 265(b)(3)(B)(ii)(I))";
}
pub relation obligation_refunds_pre_august_8_1986_obligation_not_idb_or_private_loan(obl: Integer) kind empirical {
    label en official "the obligation is issued to refund (or is part of a series issued to refund) an obligation issued before August 8, 1986 which was not an industrial development bond or a private loan bond as defined before the Tax Reform Act of 1986 (section 265(b)(3)(B)(ii)(II))";
}
pub relation treated_as_not_private_activity_bond_265(obl: Integer) kind institutional {
    label en official "for clause (i)(II) the obligation is not treated as a private activity bond (section 265(b)(3)(B)(ii))";
}
@source(IRC_S265_B, quote = "(I) any qualified 501(c)(3) bond (as defined in section 145), or")
rule Qualified501c3BondNotPrivateActivityBond(obl: Integer) strict {
    label en official "a qualified 501(c)(3) bond is not treated as a private activity bond (section 265(b)(3)(B)(ii)(I))";
    when obligation_is_qualified_501c3_bond(obl);
    then treated_as_not_private_activity_bond_265(obl);
}
@source(IRC_S265_B, quote = "any obligation issued to refund (or which is part of a series of obligations issued to refund) an obligation issued before August 8, 1986")
rule RefundingOfPre1986NonPrivateObligationNotPrivateActivityBond(obl: Integer) strict {
    label en official "a refunding of a pre-August 8, 1986 obligation that was not an IDB or private loan bond is not a private activity bond (section 265(b)(3)(B)(ii)(II))";
    when obligation_refunds_pre_august_8_1986_obligation_not_idb_or_private_loan(obl);
    then treated_as_not_private_activity_bond_265(obl);
}
pub relation reasonably_anticipated_tax_exempt_issuance_in_calendar_year(issuer: Integer, cy: Integer, amount: Money) kind empirical {
    label en official "the reasonably anticipated amount of tax-exempt obligations which will be issued by the issuer during the calendar year, before excluding the clause (ii) obligations (section 265(b)(3)(C)(i))";
}
pub relation anticipated_amount_of_excluded_obligations(issuer: Integer, cy: Integer, amount: Money) kind empirical {
    label en official "the anticipated amount of obligations described in clause (ii): private activity bonds (other than qualified 501(c)(3) bonds), certain section 1312/1313/1316(g)/1317 obligations, and refundings up to the outstanding refunded amount (section 265(b)(3)(C)(ii))";
}
pub relation calendar_year_of_issue_265(obl: Integer, cy: Integer) kind empirical {
    label en official "the calendar year in which the obligation is issued";
}
pub relation issuer_of_obligation(obl: Integer, issuer: Integer) kind empirical {
    label en official "the issuer of the obligation";
}
pub relation qualified_small_issuer(issuer: Integer, cy: Integer) kind institutional {
    label en official "a qualified small issuer for the calendar year: reasonably anticipated tax-exempt issuance (net of the clause (ii) obligations) not above $10,000,000, or $30,000,000 for 2009 and 2010 (section 265(b)(3)(C)(i),(G)(i))";
}
@source(IRC_S265_B, quote = "if the reasonably anticipated amount of tax-exempt obligations (other than obligations described in clause (ii)) which will be issued by such issuer during such calendar year does not exceed $10,000,000")
rule QualifiedSmallIssuerTenMillion(issuer: Integer, cy: Integer, anticipated: Money, excluded: Money) strict {
    label en official "net anticipated issuance of at most $10,000,000 makes a qualified small issuer (section 265(b)(3)(C)(i))";
    when reasonably_anticipated_tax_exempt_issuance_in_calendar_year(issuer, cy, anticipated);
    when anticipated_amount_of_excluded_obligations(issuer, cy, excluded);
    when anticipated - excluded <= 10000000.00 USD;
    then qualified_small_issuer(issuer, cy);
}
@source(IRC_S265_B, quote = "In the case of obligations issued during 2009 or 2010, subparagraphs (C)(i), (D)(i), and (D)(iii)(II) shall each be applied by substituting \"$30,000,000\" for \"$10,000,000\".")
rule QualifiedSmallIssuerThirtyMillion2009And2010(issuer: Integer, cy: Integer, anticipated: Money, excluded: Money) strict {
    label en official "for 2009 and 2010 the qualified small issuer limit is $30,000,000 (section 265(b)(3)(G)(i))";
    when reasonably_anticipated_tax_exempt_issuance_in_calendar_year(issuer, cy, anticipated);
    when anticipated_amount_of_excluded_obligations(issuer, cy, excluded);
    when cy == 2009 or cy == 2010;
    when anticipated - excluded <= 30000000.00 USD;
    then qualified_small_issuer(issuer, cy);
}
pub relation governmental_entities_agree_irrevocably_on_allocation_before_issuance(issue: Integer) kind empirical {
    label en official "all governmental entities receiving benefits from the issue irrevocably agree, before the date of issuance, on an allocation of the amount of the issue (section 265(b)(3)(C)(iii)(I))";
}
pub relation allocation_bears_reasonable_relationship_to_benefits(issue: Integer) kind empirical {
    label en official "the allocation bears a reasonable relationship to the respective benefits received by the entities (section 265(b)(3)(C)(iii)(II))";
}
pub relation issue_amount_allocated_to_entity(issue: Integer, ent: Integer, amount: Money) kind empirical {
    label en official "the amount of the issue allocated to the governmental entity";
}
pub relation amount_of_issue_taken_into_account_for_entity(issue: Integer, ent: Integer, amount: Money) kind institutional {
    label en official "only the amount allocated to the entity is taken into account under clause (i) with respect to it (section 265(b)(3)(C)(iii))";
}
@source(IRC_S265_B, quote = "then the amount of such issue so allocated to an entity (and only such amount with respect to such issue) shall be taken into account under clause (i) with respect to such entity")
rule AllocatedAmountOfMultiEntityIssueTakenIntoAccount(issue: Integer, ent: Integer, amount: Money) strict {
    label en official "with an irrevocable, reasonable allocation only the allocated amount counts for the entity (section 265(b)(3)(C)(iii))";
    when governmental_entities_agree_irrevocably_on_allocation_before_issuance(issue);
    when allocation_bears_reasonable_relationship_to_benefits(issue);
    when issue_amount_allocated_to_entity(issue, ent, amount);
    then amount_of_issue_taken_into_account_for_entity(issue, ent, amount);
}

// --- 265(b)(3)(B): the qualified tax-exempt obligation ---------------------------------------------------------------------------------------------------

pub relation obligation_designated_by_issuer_for_265b3(obl: Integer) kind empirical {
    label en official "the obligation is designated by the issuer for purposes of paragraph (3) (section 265(b)(3)(B)(i)(III))";
}
@source(IRC_S265_B, quote = "(I) which is issued after August 7, 1986, by a qualified small issuer,")
rule ObligationMeetsBConditions(obl: Integer, issued: Date, issuer: Integer, cy: Integer) defeasible {
    label en official "a tax-exempt obligation issued after August 7, 1986 by a qualified small issuer, not a private activity bond (or treated as not one) and designated by the issuer meets the (B) conditions (section 265(b)(3)(B)(i))";
    when obligation_is_tax_exempt_obligation(obl);
    when obligation_issued_on(obl, issued);
    when issued > @1986-08-07;
    when issuer_of_obligation(obl, issuer);
    when calendar_year_of_issue_265(obl, cy);
    when qualified_small_issuer(issuer, cy);
    when obligation_designated_by_issuer_for_265b3(obl);
    when not_known(private_activity_bond_status_blocks_265(obl));
    then obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated(obl);
}
pub relation private_activity_bond_status_blocks_265(obl: Integer) kind institutional {
    label en official "the obligation is a private activity bond not excused by clause (ii)";
}
rule PrivateActivityBondStatusBlocks(obl: Integer) defeasible {
    label en official "a private activity bond not treated as one by clause (ii) fails (B)(i)(II)";
    when obligation_is_private_activity_bond_141(obl);
    when not_known(treated_as_not_private_activity_bond_265(obl));
    then private_activity_bond_status_blocks_265(obl);
}
pub relation obligation_designated_amount_within_2009_2010_limit(obl: Integer) kind institutional {
    label en official "an obligation issued in 2009 or 2010 within the $30,000,000 designation limit (section 265(b)(3)(G)(i))";
}
@source(IRC_S265_B, quote = "subparagraphs (C)(i), (D)(i), and (D)(iii)(II) shall each be applied by substituting \"$30,000,000\" for \"$10,000,000\"")
rule QualifiedTaxExemptObligation2009To2010ThirtyMillion(obl: Integer, designated: Money, cy: Integer) defeasible {
    label en official "for 2009 and 2010 up to $30,000,000 may be designated, so the obligation is qualified within that limit (section 265(b)(3)(D)(i),(G)(i))";
    when obligation_issued_by_qualified_small_issuer_not_private_activity_and_designated(obl);
    when issuer_designated_amount_in_calendar_year(obl, designated);
    when calendar_year_of_issue_265(obl, cy);
    when cy == 2009 or cy == 2010;
    when designated <= 30000000.00 USD;
    then obligation_designated_amount_within_2009_2010_limit(obl);
}
rule QualifiedTaxExemptObligationFrom2009To2010Limit(obl: Integer) defeasible {
    label en official "an obligation within the 2009-2010 limit is a qualified tax-exempt obligation (section 265(b)(3)(B),(G)(i))";
    when obligation_designated_amount_within_2009_2010_limit(obl);
    then qualified_tax_exempt_obligation_265(obl);
}

// --- 265(b)(3)(D)(ii),(iii): refundings and barred designations ------------------------------------------------------------------------------------------------

pub relation refunding_obligation_of_qualified_tax_exempt_obligation(obl: Integer, original: Integer) kind empirical {
    label en official "the obligation is a refunding (or series of refundings) of a qualified tax-exempt obligation (section 265(b)(3)(D)(ii))";
}
pub relation refunding_not_taken_into_account_by_c_ii_iii(obl: Integer) kind empirical {
    label en official "the refunding obligation was not taken into account under subparagraph (C) by reason of clause (ii)(III) thereof (section 265(b)(3)(D)(ii)(I))";
}
pub relation average_maturity_years_of_refunding_issue(obl: Integer, years: Decimal) kind empirical {
    label en official "the average maturity of the refunding issue (section 147(b)(2)(A)) in years";
}
pub relation average_maturity_years_of_refunded_issue(obl: Integer, years: Decimal) kind empirical {
    label en official "the average maturity of the obligations to be refunded";
}
pub relation average_maturity_years_of_original_issue(obl: Integer, years: Decimal) kind empirical {
    label en official "the average maturity of the issue of which the original qualified tax-exempt obligation was part (and of the issue of the obligations to be refunded)";
}
pub relation refunding_maturity_years_after_original_issue(obl: Integer, years: Decimal) kind empirical {
    label en official "the years from the original obligation's issue date to the refunding obligation's maturity date (section 265(b)(3)(D)(ii)(III))";
}
pub relation refunding_deemed_designated_265(obl: Integer) kind institutional {
    label en official "the refunding obligation is treated as designated and as a qualified tax-exempt obligation, not counted toward the limit (section 265(b)(3)(D)(ii))";
}
@source(IRC_S265_B, quote = "the refunding obligation shall be treated as a qualified tax-exempt obligation (and shall not be taken into account under clause (i)) if")
rule RefundingDeemedDesignatedNormalMaturity(obl: Integer, original: Integer, refunding_avg: Decimal, refunded_avg: Decimal, original_avg: Decimal, years: Decimal) strict {
    label en official "a refunding whose average maturity is not later than the refunded issue's and whose maturity is within 30 years of the original issue is deemed designated (section 265(b)(3)(D)(ii)(I)-(III))";
    when refunding_obligation_of_qualified_tax_exempt_obligation(obl, original);
    when refunding_not_taken_into_account_by_c_ii_iii(obl);
    when average_maturity_years_of_refunding_issue(obl, refunding_avg);
    when average_maturity_years_of_refunded_issue(obl, refunded_avg);
    when average_maturity_years_of_original_issue(obl, original_avg);
    when refunding_maturity_years_after_original_issue(obl, years);
    when original_avg > 3.0;
    when refunding_avg <= refunded_avg;
    when years <= 30.0;
    then refunding_deemed_designated_265(obl);
}
@source(IRC_S265_B, quote = "Subclause (II) shall not apply if the average maturity of the issue of which the original qualified tax-exempt obligation was a part")
rule RefundingDeemedDesignatedShortAverageMaturity(obl: Integer, original: Integer, original_avg: Decimal, years: Decimal) strict {
    label en official "when the average maturity of the original issue is 3 years or less subclause (II) does not apply (section 265(b)(3)(D)(ii) last sentence)";
    when refunding_obligation_of_qualified_tax_exempt_obligation(obl, original);
    when refunding_not_taken_into_account_by_c_ii_iii(obl);
    when average_maturity_years_of_original_issue(obl, original_avg);
    when refunding_maturity_years_after_original_issue(obl, years);
    when original_avg <= 3.0;
    when years <= 30.0;
    then refunding_deemed_designated_265(obl);
}
rule RefundingDeemedDesignatedIsQualified(obl: Integer) strict {
    label en official "a deemed designated refunding is a qualified tax-exempt obligation (section 265(b)(3)(D)(ii))";
    when refunding_deemed_designated_265(obl);
    then qualified_tax_exempt_obligation_265(obl);
}
pub relation issue_includes_a_refunding_obligation(issue: Integer) kind empirical {
    label en official "any obligation issued as part of the issue is issued to refund another obligation (section 265(b)(3)(D)(iii)(I))";
}
pub relation aggregate_face_amount_of_issue(issue: Integer, amount: Money) kind empirical {
    label en official "the aggregate face amount of the issue (section 265(b)(3)(D)(iii)(II))";
}
pub relation issue_calendar_year_265(issue: Integer, cy: Integer) kind empirical {
    label en official "the calendar year of the issue";
}
pub relation designation_barred_for_issue(issue: Integer) kind institutional {
    label en official "no obligation of the issue may be designated or deemed designated: a refunding is part of an issue whose face amount exceeds $10,000,000 ($30,000,000 for 2009-2010) (section 265(b)(3)(D)(iii))";
}
@source(IRC_S265_B, quote = "No obligation issued as part of an issue may be designated under this paragraph (or may be treated as designated under clause (ii)) if")
rule DesignationBarredForRefundingIssueOver10Million(issue: Integer, amount: Money, cy: Integer) strict {
    label en official "a refunding issue over $10,000,000 cannot be designated (section 265(b)(3)(D)(iii))";
    when issue_includes_a_refunding_obligation(issue);
    when aggregate_face_amount_of_issue(issue, amount);
    when issue_calendar_year_265(issue, cy);
    when cy != 2009;
    when cy != 2010;
    when amount > 10000000.00 USD;
    then designation_barred_for_issue(issue);
}
@source(IRC_S265_B, quote = "subparagraphs (C)(i), (D)(i), and (D)(iii)(II) shall each be applied by substituting \"$30,000,000\" for \"$10,000,000\"")
rule DesignationBarredForRefundingIssueOver30MillionIn2009And2010(issue: Integer, amount: Money, cy: Integer) strict {
    label en official "in 2009 and 2010 the barred amount is $30,000,000 (section 265(b)(3)(G)(i))";
    when issue_includes_a_refunding_obligation(issue);
    when aggregate_face_amount_of_issue(issue, amount);
    when issue_calendar_year_265(issue, cy);
    when cy == 2009 or cy == 2010;
    when amount > 30000000.00 USD;
    then designation_barred_for_issue(issue);
}

// --- 265(b)(3)(E),(F),(G): aggregation, composites, 2009-2010 ---------------------------------------------------------------------------------------------------

pub relation issuer_issues_on_behalf_of(issuer_a: Integer, issuer_b: Integer) kind empirical {
    label en official "issuer_a is an entity that issues obligations on behalf of issuer_b (section 265(b)(3)(E)(i))";
}
pub relation entity_subordinate_to(sub: Integer, other: Integer) kind empirical {
    label en official "sub is a subordinate entity of other (section 265(b)(3)(E)(ii))";
}
pub relation entity_formed_or_availed_of_to_avoid_c_or_d(ent: Integer, main: Integer) kind empirical {
    label en official "the entity was formed (or, to the extent the Secretary provides, availed of) to avoid the purposes of subparagraph (C) or (D), and the entities benefiting thereby (section 265(b)(3)(E)(iii))";
}
pub relation treated_as_one_issuer(a: Integer, b: Integer) kind institutional {
    label en official "the two entities are treated as 1 issuer for subparagraphs (C) and (D) (section 265(b)(3)(E))";
}
@source(IRC_S265_B, quote = "(i) an issuer and all entities which issue obligations on behalf of such issuer shall be treated as 1 issuer,")
rule IssuerAndOnBehalfIssuersOneIssuer(a: Integer, b: Integer) strict {
    label en official "an issuer and the entities issuing on its behalf are 1 issuer (section 265(b)(3)(E)(i))";
    when issuer_issues_on_behalf_of(a, b);
    then treated_as_one_issuer(a, b);
}
@source(IRC_S265_B, quote = "(ii) all obligations issued by a subordinate entity shall, for purposes of applying subparagraphs (C) and (D) to each other entity to which such entity is subordinate, be treated as issued by such other entity")
rule SubordinateEntityObligationsAttributedToParent(sub: Integer, other: Integer) strict {
    label en official "obligations of a subordinate entity are treated as issued by each entity to which it is subordinate (section 265(b)(3)(E)(ii))";
    when entity_subordinate_to(sub, other);
    then treated_as_one_issuer(sub, other);
}
@source(IRC_S265_B, quote = "(iii) an entity formed (or, to the extent provided by the Secretary, availed of) to avoid the purposes of subparagraph (C) or (D) and all entities benefiting thereby shall be treated as 1 issuer")
rule AvoidanceEntityOneIssuer(ent: Integer, main: Integer) strict {
    label en official "an avoidance entity and the entities benefiting are 1 issuer (section 265(b)(3)(E)(iii))";
    when entity_formed_or_availed_of_to_avoid_c_or_d(ent, main);
    then treated_as_one_issuer(ent, main);
}
pub relation obligation_part_of_composite_issue(obl: Integer, issue: Integer) kind empirical {
    label en official "the obligation is issued as part of a direct or indirect composite issue (section 265(b)(3)(F))";
}
pub relation composite_issue_meets_requirements_as_single_issue(issue: Integer) kind empirical {
    label en official "the requirements of paragraph (3) are met with respect to the composite issue treated as a single issue (section 265(b)(3)(F)(i))";
}
pub relation each_lot_of_composite_issue_meets_requirements(issue: Integer) kind empirical {
    label en official "the requirements of paragraph (3) are met with respect to each separate lot, treated as a separate issue (section 265(b)(3)(F)(ii))";
}
pub relation qualified_financing_issue_2009_2010(issue: Integer) kind empirical {
    label en official "a composite, pooled or other conduit financing issue whose proceeds finance loans to qualified borrowers (State or political subdivision, or a 501(c)(3) organization exempt under 501(a)), issued during 2009 or 2010 (section 265(b)(3)(G)(iii),(iv),(vi))";
}
pub relation each_qualified_portion_of_issue_meets_requirements(issue: Integer) kind empirical {
    label en official "the requirements of paragraph (3) are met with respect to each qualified portion of the issue (the proceeds used for each qualified borrower), treated as a separate issue of the qualified borrower (section 265(b)(3)(G)(iii)(II),(v))";
}
pub relation composite_issue_obligation_qualified_265(obl: Integer) kind institutional {
    label en official "the composite-issue obligation is not barred by subparagraph (F)";
}
@source(IRC_S265_B, quote = "such obligation shall not be treated as a qualified tax-exempt obligation unless")
rule CompositeIssueObligationRequirements(obl: Integer, issue: Integer) strict {
    label en official "a composite-issue obligation qualifies only if the issue as a whole and each lot meet the requirements (section 265(b)(3)(F))";
    when obligation_part_of_composite_issue(obl, issue);
    when composite_issue_meets_requirements_as_single_issue(issue);
    when each_lot_of_composite_issue_meets_requirements(issue);
    then composite_issue_obligation_qualified_265(obl);
}
@source(IRC_S265_B, quote = "any obligation issued as a part of such issue shall be treated as a qualified tax-exempt obligation if the requirements of this paragraph are met with respect to each qualified portion of the issue")
rule QualifiedFinancingIssue2009To2010Obligation(obl: Integer, issue: Integer) strict {
    label en official "for a 2009-2010 qualified financing issue (F) does not apply and the obligation qualifies if each qualified portion meets the requirements (section 265(b)(3)(G)(iii))";
    when obligation_part_of_composite_issue(obl, issue);
    when qualified_financing_issue_2009_2010(issue);
    when each_qualified_portion_of_issue_meets_requirements(issue);
    then composite_issue_obligation_qualified_265(obl);
}
pub relation qualified_501c3_bond_issued_2009_2010_for_organization(obl: Integer, org: Integer) kind empirical {
    label en official "a qualified 501(c)(3) bond issued during 2009 or 2010 for the benefit of the organization (section 265(b)(3)(G)(ii))";
}
pub relation issuer_for_265b3_purposes(obl: Integer, issuer: Integer) kind institutional {
    label en official "the issuer of the obligation for paragraph (3): for a 2009-2010 qualified 501(c)(3) bond the organization for whose benefit it was issued (section 265(b)(3)(G)(ii))";
}
@source(IRC_S265_B, quote = "this paragraph shall be applied by treating the 501(c)(3) organization for whose benefit such bond was issued as the issuer")
rule Qualified501c3Bond2009To2010OrganizationIsIssuer(obl: Integer, org: Integer) strict {
    label en official "the 501(c)(3) organization is the issuer of a 2009-2010 qualified 501(c)(3) bond (section 265(b)(3)(G)(ii))";
    when qualified_501c3_bond_issued_2009_2010_for_organization(obl, org);
    then issuer_for_265b3_purposes(obl, org);
}

// --- 265(b)(4)(B),(6),(7)(C) ---------------------------------------------------------------------------------------------------------------------------------------------

pub relation obligation_interest_wholly_exempt_from_subtitle_a_taxes(obl: Integer) kind empirical {
    label en official "the interest on the obligation is wholly exempt from the taxes imposed by this subtitle (section 265(b)(4)(B))";
}
pub relation share_of_regulated_investment_company_distributing_exempt_interest_dividends(obl: Integer) kind empirical {
    label en official "shares of stock of a regulated investment company which during the holder's taxable year distributes exempt-interest dividends (section 265(b)(4)(B))";
}
pub relation tax_exempt_obligation_265(obl: Integer) kind institutional {
    label en official "a tax-exempt obligation within section 265(b)(4)(B)";
}
@source(IRC_S265_B, quote = "The term \"tax-exempt obligation\" means any obligation the interest on which is wholly exempt from taxes imposed by this subtitle.")
rule TaxExemptObligationWhollyExemptInterest(obl: Integer) strict {
    label en official "an obligation with wholly exempt interest is a tax-exempt obligation (section 265(b)(4)(B))";
    when obligation_interest_wholly_exempt_from_subtitle_a_taxes(obl);
    then tax_exempt_obligation_265(obl);
}
@source(IRC_S265_B, quote = "Such term includes shares of stock of a regulated investment company which during the taxable year of the holder thereof distributes exempt-interest dividends.")
rule TaxExemptObligationIncludesExemptInterestRicShares(obl: Integer) strict {
    label en official "RIC shares distributing exempt-interest dividends are tax-exempt obligations (section 265(b)(4)(B))";
    when share_of_regulated_investment_company_distributing_exempt_interest_dividends(obl);
    then tax_exempt_obligation_265(obl);
}
pub relation average_adjusted_basis_of_tax_exempt_obligations_before_265b6(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the taxpayer's average adjusted bases of tax-exempt obligations acquired after August 7, 1986, before the paragraph (6)(A)(ii) reduction (section 265(b)(2)(A))";
}
pub relation indebtedness_whose_interest_is_disallowed_under_265a(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of indebtedness whose interest is disallowed under subsection (a) with respect to a tax-exempt obligation (section 265(b)(6)(A))";
}
@source(IRC_S265_B, quote = "the adjusted basis of such tax-exempt obligation shall be reduced (but not below zero) by the amount of such indebtedness")
rule TeoBasisReducedByDisallowedIndebtedness(p: Person, y: TaxableYear, basis: Money, indebtedness: Money) strict {
    label en official "the adjusted basis of the obligation is reduced (not below zero) by the indebtedness whose interest is disallowed under subsection (a) (section 265(b)(6)(A)(ii)); the reduction is applied to the aggregate";
    when average_adjusted_basis_of_tax_exempt_obligations_before_265b6(p, y, basis);
    when indebtedness_whose_interest_is_disallowed_under_265a(p, y, indebtedness);
    then average_adjusted_basis_of_tax_exempt_obligations_acquired_after_august_7_1986(p, y, max(0.00 USD, basis - indebtedness));
}
pub relation refunded_bond_issue_date(refunded: Integer, on: Date) kind empirical {
    label en official "the issue date of the refunded bond (or, in a series of refundings, of the original bond) (section 265(b)(7)(C))";
}
pub relation refunding_of_bond(refunding: Integer, refunded: Integer) kind empirical {
    label en official "the refunding bond, current or advance, and the bond it refunds (section 265(b)(7)(C))";
}
pub relation deemed_issue_date_for_265b7(obl: Integer, on: Date) kind institutional {
    label en official "the date the bond is treated as issued for the 2009-2010 de minimis exception: for a refunding bond, the issue date of the refunded (original) bond (section 265(b)(7)(C))";
}
@source(IRC_S265_B, quote = "a refunding bond (whether a current or advance refunding) shall be treated as issued on the date of the issuance of the refunded bond")
rule RefundingBondTreatedAsIssuedOnRefundedBondDate(refunding: Integer, refunded: Integer, on: Date) strict {
    label en official "a refunding bond is treated as issued on the refunded bond's issue date (section 265(b)(7)(C))";
    when refunding_of_bond(refunding, refunded);
    when refunded_bond_issue_date(refunded, on);
    then deemed_issue_date_for_265b7(refunding, on);
}

// --- 267(b)(3)-(13): the relationships ---------------------------------------------------------------------------------------------------------------------------------

pub relation controlled_group_1563a_over_50_percent(a: Person, b: Person) kind empirical {
    label en official "the two corporations are members of the same controlled group under section 1563(a), with more than 50 percent substituted for at least 80 percent and without regard to sections 1563(a)(4) and (e)(3)(C) (section 267(f)(1))";
}
pub relation grantor_of_trust_267(grantor: Person, trust: Person) kind empirical {
    label en official "the person is a grantor of the trust";
}
pub relation fiduciary_of_trust_267(fiduciary: Person, trust: Person) kind empirical {
    label en official "the person is a fiduciary of the trust";
}
pub relation beneficiary_of_trust_267(beneficiary: Person, trust: Person) kind empirical {
    label en official "the person is a beneficiary of the trust";
}
pub relation trust_or_its_grantor_owns_over_half_of_corporation_value(trust: Person, corp: Person) kind empirical {
    label en official "more than 50 percent in value of the outstanding stock of the corporation is owned, directly or indirectly, by or for the trust or by or for a person who is a grantor of the trust (section 267(b)(8))";
}
pub relation organization_501_controlled_by_person_or_family(org: Person, person: Person) kind empirical {
    label en official "an organization to which section 501 applies is controlled directly or indirectly by the person or (if an individual) by members of the family of such individual (section 267(b)(9))";
}
pub relation same_group_owns_over_half_of_corporation_value(group: Integer, corp: Person) kind empirical {
    label en official "the persons of the group own more than 50 percent in value of the outstanding stock of the corporation";
}
pub relation same_group_owns_over_half_of_partnership_interest(group: Integer, partnership: Person) kind empirical {
    label en official "the persons of the group own more than 50 percent of the capital interest, or the profits interest, in the partnership";
}
pub relation corporation_is_s_corporation_267(corp: Person) kind empirical {
    label en official "the corporation is an S corporation";
}
pub relation corporation_is_c_corporation_267(corp: Person) kind empirical {
    label en official "the corporation is a C corporation";
}
pub relation executor_of_estate_267(executor: Person, estate: Person) kind empirical {
    label en official "the person is the executor of the estate";
}
pub relation beneficiary_of_estate_267(beneficiary: Person, estate: Person) kind empirical {
    label en official "the person is a beneficiary of the estate";
}
pub relation sale_in_satisfaction_of_pecuniary_bequest(item: Integer) kind empirical {
    label en official "the sale or exchange is in satisfaction of a pecuniary bequest (section 267(b)(13))";
}
pub relation transaction_item_between_persons(a: Person, b: Person, item: Integer) kind empirical {
    label en official "the sale or exchange item is between the two persons (binds the item for the executor exception)";
}
@source(IRC_S267_B, quote = "(3) Two corporations which are members of the same controlled group (as defined in subsection (f));")
rule Related3ControlledGroupCorporations(a: Person, b: Person) strict {
    label en official "two corporations of the same controlled group are related (section 267(b)(3))";
    when controlled_group_1563a_over_50_percent(a, b);
    then related_persons(a, b, ControlledGroupCorporations);
}
@source(IRC_S267_B, quote = "(4) A grantor and a fiduciary of any trust;")
rule Related4GrantorAndFiduciary(g: Person, f: Person, trust: Person) strict {
    label en official "a grantor and a fiduciary of a trust are related (section 267(b)(4))";
    when grantor_of_trust_267(g, trust);
    when fiduciary_of_trust_267(f, trust);
    then related_persons(g, f, GrantorAndFiduciary);
}
@source(IRC_S267_B, quote = "(5) A fiduciary of a trust and a fiduciary of another trust, if the same person is a grantor of both trusts;")
rule Related5FiduciariesOfTrustsWithCommonGrantor(f1: Person, f2: Person, t1: Person, t2: Person, g: Person) strict {
    label en official "fiduciaries of two trusts with the same grantor are related (section 267(b)(5))";
    when fiduciary_of_trust_267(f1, t1);
    when fiduciary_of_trust_267(f2, t2);
    when grantor_of_trust_267(g, t1);
    when grantor_of_trust_267(g, t2);
    when t1 != t2;
    then related_persons(f1, f2, FiduciariesCommonGrantor);
}
@source(IRC_S267_B, quote = "(6) A fiduciary of a trust and a beneficiary of such trust;")
rule Related6FiduciaryAndBeneficiary(f: Person, b: Person, trust: Person) strict {
    label en official "a fiduciary and a beneficiary of the same trust are related (section 267(b)(6))";
    when fiduciary_of_trust_267(f, trust);
    when beneficiary_of_trust_267(b, trust);
    then related_persons(f, b, FiduciaryAndBeneficiary);
}
@source(IRC_S267_B, quote = "(7) A fiduciary of a trust and a beneficiary of another trust, if the same person is a grantor of both trusts;")
rule Related7FiduciaryAndBeneficiaryOfOtherTrust(f: Person, b: Person, t1: Person, t2: Person, g: Person) strict {
    label en official "a fiduciary of one trust and a beneficiary of another trust with the same grantor are related (section 267(b)(7))";
    when fiduciary_of_trust_267(f, t1);
    when beneficiary_of_trust_267(b, t2);
    when grantor_of_trust_267(g, t1);
    when grantor_of_trust_267(g, t2);
    when t1 != t2;
    then related_persons(f, b, FiduciaryAndOtherTrustBeneficiary);
}
@source(IRC_S267_B, quote = "(8) A fiduciary of a trust and a corporation more than 50 percent in value of the outstanding stock of which is owned, directly or indirectly, by or for the trust or by or for a person who is a grantor of the trust;")
rule Related8FiduciaryAndControlledCorporation(f: Person, corp: Person, trust: Person) strict {
    label en official "a fiduciary and a corporation more than half owned by the trust or its grantor are related (section 267(b)(8))";
    when fiduciary_of_trust_267(f, trust);
    when trust_or_its_grantor_owns_over_half_of_corporation_value(trust, corp);
    then related_persons(f, corp, FiduciaryAndControlledCorporation);
}
@source(IRC_S267_B, quote = "(9) A person and an organization to which section 501")
rule Related9PersonAndControlledExemptOrganization(person: Person, org: Person) strict {
    label en official "a person and a section 501 organization controlled by the person (or by family members of an individual) are related (section 267(b)(9))";
    when organization_501_controlled_by_person_or_family(org, person);
    then related_persons(person, org, PersonAndControlledExemptOrg);
}
@source(IRC_S267_B, quote = "(10) A corporation and a partnership if the same persons own")
rule Related10CorporationAndPartnershipSameOwners(corp: Person, partnership: Person, group: Integer) strict {
    label en official "a corporation and a partnership are related if the same persons own more than half of each (section 267(b)(10))";
    when same_group_owns_over_half_of_corporation_value(group, corp);
    when same_group_owns_over_half_of_partnership_interest(group, partnership);
    then related_persons(corp, partnership, CorporationAndControlledPartnership);
}
@source(IRC_S267_B, quote = "(11) An S corporation and another S corporation if the same persons own more than 50 percent in value of the outstanding stock of each corporation;")
rule Related11TwoSCorporationsSameOwners(c1: Person, c2: Person, group: Integer) strict {
    label en official "two S corporations are related if the same persons own more than half in value of each (section 267(b)(11))";
    when corporation_is_s_corporation_267(c1);
    when corporation_is_s_corporation_267(c2);
    when same_group_owns_over_half_of_corporation_value(group, c1);
    when same_group_owns_over_half_of_corporation_value(group, c2);
    when c1 != c2;
    then related_persons(c1, c2, TwoControlledSCorporations);
}
@source(IRC_S267_B, quote = "(12) An S corporation and a C corporation, if the same persons own more than 50 percent in value of the outstanding stock of each corporation; or")
rule Related12SAndCCorporationSameOwners(s: Person, c: Person, group: Integer) strict {
    label en official "an S corporation and a C corporation are related if the same persons own more than half in value of each (section 267(b)(12))";
    when corporation_is_s_corporation_267(s);
    when corporation_is_c_corporation_267(c);
    when same_group_owns_over_half_of_corporation_value(group, s);
    when same_group_owns_over_half_of_corporation_value(group, c);
    then related_persons(s, c, ControlledSAndCCorporation);
}
@source(IRC_S267_B, quote = "(13) Except in the case of a sale or exchange in satisfaction of a pecuniary bequest, an executor of an estate and a beneficiary of such estate.")
rule Related13ExecutorAndBeneficiary(ex: Person, b: Person, estate: Person, item: Integer) strict {
    label en official "an executor and a beneficiary of the estate are related, except in a sale or exchange in satisfaction of a pecuniary bequest (section 267(b)(13))";
    when executor_of_estate_267(ex, estate);
    when beneficiary_of_estate_267(b, estate);
    when transaction_item_between_persons(ex, b, item);
    when not_known(sale_in_satisfaction_of_pecuniary_bequest(item));
    then related_persons(ex, b, ExecutorAndBeneficiary);
}

// --- 267(a)(2) last sentence, (a)(3),(e): persons specified for the matching rule ---------------------------------------------------------------------------

pub relation personal_service_corporation_441i2(psc: Person) kind empirical {
    label en official "the corporation is a personal service corporation (section 441(i)(2)) (section 267(a)(2) last sentence)";
}
pub relation employee_owner_of_psc_269a_b2_as_modified(owner: Person, psc: Person) kind empirical {
    label en official "the person is an employee-owner (section 269A(b)(2) as modified by section 441(i)(2)) of the personal service corporation";
}
pub relation pass_thru_entity_partnership_or_s_corporation(ent: Person) kind empirical {
    label en official "the person is a pass-thru entity: a partnership or an S corporation (section 267(e)(2))";
}
pub relation entity_is_partnership_267e(ent: Person) kind empirical {
    label en official "the pass-thru entity is a partnership";
}
pub relation owns_capital_or_profits_interest_or_stock_directly_or_indirectly(owner: Person, ent: Person) kind empirical {
    label en official "the person owns (directly or indirectly) any capital interest or profits interest of the partnership, or any of the stock of the S corporation (section 267(e)(1)(B))";
}
pub relation owns_interest_in_partnership_in_which_entity_owns_interest(owner: Person, ent: Person, partnership: Person) kind empirical {
    label en official "the person owns (directly or indirectly) any capital interest or profits interest of a partnership in which the entity owns (directly or indirectly) an interest (section 267(e)(1)(C))";
}
pub relation transaction_related_to_operations_or_interest_in_that_partnership(ent: Person, owner: Person) kind empirical {
    label en official "the transaction is related either to the operations of that partnership or to an interest in it (section 267(e)(1) last sentence)";
}
pub relation related_within_267b_or_707b1(a: Person, b: Person) kind empirical {
    label en official "the persons are related within the meaning of section 267(b) or section 707(b)(1) (section 267(e)(1)(D))";
}
pub relation persons_specified_267e_direct(a: Person, b: Person) kind institutional {
    label en official "the two persons are directly specified for subsection (a)(2): a personal service corporation and its employee-owner, a pass-thru entity and its owners (section 267(a)(2),(e)(1)(A)-(C))";
}
pub relation persons_specified_for_267a2(a: Person, b: Person) kind institutional {
    label en official "the two persons are treated as persons specified in a paragraph of subsection (b) for applying subsection (a)(2): directly specified, or related to a directly specified owner (section 267(e)(1)(D))";
}
rule DirectlySpecifiedPersonsAreSpecifiedForA2(a: Person, b: Person) strict {
    label en official "directly specified persons are specified for (a)(2)";
    when persons_specified_267e_direct(a, b);
    then persons_specified_for_267a2(a, b);
}
@source(IRC_S267_A, quote = "such corporation and any employee-owner (within the meaning of section 269A(b)(2), as modified by section 441(i)(2)) shall be treated as persons specified in subsection (b)")
rule PscAndEmployeeOwnerSpecifiedForA2(psc: Person, owner: Person) strict {
    label en official "a personal service corporation and its employee-owner are specified persons for (a)(2) (section 267(a)(2) last sentence)";
    when personal_service_corporation_441i2(psc);
    when employee_owner_of_psc_269a_b2_as_modified(owner, psc);
    then persons_specified_267e_direct(psc, owner);
}
@source(IRC_S267_E, quote = "(A) such entity,")
rule PassThruEntityAndOwnerSpecifiedForA2(ent: Person, owner: Person) strict {
    label en official "the pass-thru entity and each person owning an interest or stock in it are specified persons (section 267(e)(1)(A),(B))";
    when pass_thru_entity_partnership_or_s_corporation(ent);
    when owns_capital_or_profits_interest_or_stock_directly_or_indirectly(owner, ent);
    then persons_specified_267e_direct(ent, owner);
}
@source(IRC_S267_E, quote = "(C) any person who owns (directly or indirectly) any capital interest or profits interest of a partnership in which such entity owns (directly or indirectly) any capital interest or profits interest")
rule OwnerOfPartnershipInWhichEntityHoldsInterestSpecified(ent: Person, owner: Person, partnership: Person) strict {
    label en official "a person owning an interest in a partnership in which the entity holds an interest is specified, only for a transaction related to that partnership's operations or interest (section 267(e)(1)(C))";
    when pass_thru_entity_partnership_or_s_corporation(ent);
    when owns_interest_in_partnership_in_which_entity_owns_interest(owner, ent, partnership);
    when transaction_related_to_operations_or_interest_in_that_partnership(ent, owner);
    then persons_specified_267e_direct(ent, owner);
}
@source(IRC_S267_E, quote = "(D) any person related (within the meaning of subsection (b) of this section or section 707(b)(1)) to a person described in subparagraph (B) or (C)")
rule RelatedToSpecifiedOwnerSpecified(ent: Person, owner: Person, relative: Person) strict {
    label en official "a person related to a specified owner is specified (section 267(e)(1)(D))";
    when persons_specified_267e_direct(ent, owner);
    when related_within_267b_or_707b1(owner, relative);
    then persons_specified_for_267a2(ent, relative);
}
pub relation shareholder_owns_five_percent_or_more_in_value_of_c_corporation(shareholder: Person, corp: Person) kind empirical {
    label en official "the shareholder owns (directly or indirectly) 5 percent or more in value of the stock of the C corporation (section 267(e)(3)(B))";
}
pub relation partnership_interest_owned_by_c_corporation(corp: Person, partnership: Person) kind empirical {
    label en official "a C corporation owns a capital or profits interest of the partnership";
}
pub relation partnership_interest_considered_owned_by_c_corporation_shareholder(shareholder: Person, corp: Person, partnership: Person) kind institutional {
    label en official "interests owned by or for a C corporation are considered owned by or for a shareholder only if the shareholder owns 5 percent or more in value of the corporation's stock (section 267(e)(3)(B))";
}
@source(IRC_S267_E, quote = "interests owned (directly or indirectly) by or for a C corporation shall be considered as owned by or for any shareholder only if such shareholder owns (directly or indirectly) 5 percent or more in value of the stock of such corporation")
rule CorporationPartnershipInterestAttributedOnlyToFivePercentShareholders(shareholder: Person, corp: Person, partnership: Person) strict {
    label en official "a C corporation's partnership interest is attributed to a shareholder only at 5 percent or more (section 267(e)(3)(B)); section 267(c)(3) does not apply";
    when partnership_interest_owned_by_c_corporation(corp, partnership);
    when shareholder_owns_five_percent_or_more_in_value_of_c_corporation(shareholder, corp);
    then partnership_interest_considered_owned_by_c_corporation_shareholder(shareholder, corp, partnership);
}
pub relation amount_paid_or_incurred_by_partnership_to_which_707c_applies(item: Integer) kind empirical {
    label en official "the amount paid or incurred by a partnership is one to which section 707(c) (guaranteed payments) applies (section 267(e)(4))";
}
pub relation subsection_a2_does_not_apply_to_amount(item: Integer) kind institutional {
    label en official "subsection (a)(2) does not apply to the amount, to the extent section 707(c) applies (section 267(e)(4))";
}
@source(IRC_S267_E, quote = "subsection (a)(2) shall not apply to the extent that section 707(c) applies to such amount")
rule GuaranteedPaymentsOutsideA2(item: Integer) strict {
    label en official "subsection (a)(2) does not apply to a partnership's guaranteed payment to the extent section 707(c) applies (section 267(e)(4))";
    when amount_paid_or_incurred_by_partnership_to_which_707c_applies(item);
    then subsection_a2_does_not_apply_to_amount(item);
}

// --- 267(e)(5): low-income housing partnerships -------------------------------------------------------------------------------------------------------------------------

pub relation partner_percent_of_aggregate_capital_and_profits_including_related(partner: Person, partnership: Person, percent: Decimal) kind empirical {
    label en official "the partner's interest, direct or indirect and including interests held by persons related within section 267(b) or 707(b)(1), in the aggregate capital and profits interests of the partnership (section 267(e)(5)(B))";
}
pub relation partner_owned_housing_throughout_two_years_ending_at_transfer(partner: Person, partnership: Person) kind empirical {
    label en official "the partner owned the low-income housing at all times during the 2-year period ending on the date it was transferred to the partnership (section 267(e)(5)(B)(i))";
}
pub relation partnership_acquired_housing_from_hud_or_housing_authority(partnership: Person) kind empirical {
    label en official "the partnership acquired the low-income housing by purchase, assignment or other transfer from the Department of Housing and Urban Development or any State or local housing authority (section 267(e)(5)(B)(ii))";
}
pub relation qualified_five_percent_or_less_partner(partner: Person, partnership: Person) kind institutional {
    label en official "a qualified 5-percent or less partner within section 267(e)(5)(B)";
}
@source(IRC_S267_E, quote = "the term \"qualified 5-percent or less partner\" means any partner who has (directly or indirectly) an interest of 5 percent or less in the aggregate capital and profits interests of the partnership")
rule QualifiedFivePercentPartnerByPriorOwnership(partner: Person, partnership: Person, percent: Decimal) strict {
    label en official "a partner of 5 percent or less who owned the housing during the 2 years before transfer (section 267(e)(5)(B)(i))";
    when partner_percent_of_aggregate_capital_and_profits_including_related(partner, partnership, percent);
    when percent <= 0.05;
    when partner_owned_housing_throughout_two_years_ending_at_transfer(partner, partnership);
    then qualified_five_percent_or_less_partner(partner, partnership);
}
@source(IRC_S267_E, quote = "such partnership acquired the low-income housing pursuant to a purchase, assignment, or other transfer from the Department of Housing and Urban Development or any State or local housing authority")
rule QualifiedFivePercentPartnerByHudAcquisition(partner: Person, partnership: Person, percent: Decimal) strict {
    label en official "a partner of 5 percent or less where the partnership acquired the housing from HUD or a housing authority (section 267(e)(5)(B)(ii))";
    when partner_percent_of_aggregate_capital_and_profits_including_related(partner, partnership, percent);
    when percent <= 0.05;
    when partnership_acquired_housing_from_hud_or_housing_authority(partnership);
    then qualified_five_percent_or_less_partner(partner, partnership);
}
pub relation partnership_expense_or_interest_on_low_income_housing(item: Integer, partnership: Person) kind empirical {
    label en official "an expense or interest incurred by the partnership with respect to low-income housing held by it (section 267(e)(5)(C))";
}
pub relation amount_unconditionally_required_to_be_paid_within_years_of_incurrence(item: Integer, years: Integer) kind empirical {
    label en official "the number of years after the amount was incurred by which the partnership is unconditionally required to pay it (section 267(e)(5)(C)(i))";
}
pub relation item_is_interest_at_annual_rate(item: Integer, rate: Decimal) kind empirical {
    label en official "the item is interest incurred at the annual rate (section 267(e)(5)(C)(ii))";
}
pub relation item_is_expense_not_interest(item: Integer) kind empirical {
    label en official "the item is an expense other than interest";
}
pub relation qualified_expenses_and_interest_267e5(item: Integer) kind institutional {
    label en official "qualified expenses and interest of a low-income housing partnership (section 267(e)(5)(C))";
}
@source(IRC_S267_E, quote = "only if the amount of such expense or interest (as the case may be) is unconditionally required to be paid by the partnership not later than 10 years after the date such amount was incurred")
rule QualifiedExpenseWithinTenYears(item: Integer, partnership: Person, years: Integer) strict {
    label en official "an expense unconditionally payable within 10 years is qualified (section 267(e)(5)(C)(i))";
    when partnership_expense_or_interest_on_low_income_housing(item, partnership);
    when item_is_expense_not_interest(item);
    when amount_unconditionally_required_to_be_paid_within_years_of_incurrence(item, years);
    when years <= 10;
    then qualified_expenses_and_interest_267e5(item);
}
@source(IRC_S267_E, quote = "in the case of such interest, only if such interest is incurred at an annual rate not in excess of 12 percent")
rule QualifiedInterestWithinTenYearsAndTwelvePercent(item: Integer, partnership: Person, years: Integer, rate: Decimal) strict {
    label en official "interest payable within 10 years at an annual rate of 12 percent or less is qualified (section 267(e)(5)(C)(i),(ii))";
    when partnership_expense_or_interest_on_low_income_housing(item, partnership);
    when item_is_interest_at_annual_rate(item, rate);
    when amount_unconditionally_required_to_be_paid_within_years_of_incurrence(item, years);
    when years <= 10;
    when rate <= 0.12;
    then qualified_expenses_and_interest_267e5(item);
}
pub relation payee_of_item_is_qualified_partner_or_related(item: Integer, payee: Person, partnership: Person) kind empirical {
    label en official "the payee is a qualified 5-percent or less partner of the partnership or a person related (within section 267(b) or 707(b)(1)) to one";
}
pub relation subsection_e_does_not_apply_to_item(item: Integer) kind institutional {
    label en official "subsection (e) does not apply to the qualified expense or interest paid to a qualified 5-percent or less partner or a related person (section 267(e)(5)(A))";
}
@source(IRC_S267_E, quote = "This subsection shall not apply with respect to qualified expenses and interest paid or incurred by a partnership owning low-income housing to")
rule LowIncomeHousingQualifiedItemOutsideSubsectionE(item: Integer, payee: Person, partnership: Person) strict {
    label en official "subsection (e) does not apply to qualified low-income housing expenses and interest paid to a qualified partner or a person related to one (section 267(e)(5)(A))";
    when qualified_expenses_and_interest_267e5(item);
    when payee_of_item_is_qualified_partner_or_related(item, payee, partnership);
    then subsection_e_does_not_apply_to_item(item);
}
pub relation property_described_in_1250a1B_i_to_iv(prop: Integer) kind empirical {
    label en official "property described in clause (i), (ii), (iii) or (iv) of section 1250(a)(1)(B) (section 267(e)(5)(D)(i))";
}
pub relation partnership_owns_property_described_in_1250a1B(partnership: Person, prop: Integer) kind empirical {
    label en official "the partnership owns such property (section 267(e)(5)(D)(ii))";
}
pub relation low_income_housing_interest(item: Integer) kind institutional {
    label en official "low-income housing within section 267(e)(5)(D): an interest in property described in section 1250(a)(1)(B)(i)-(iv), or an interest in a partnership owning such property";
}
@source(IRC_S267_E, quote = "(i) any interest in property described in clause (i), (ii), (iii), or (iv) of section 1250(a)(1)(B), and")
rule LowIncomeHousingInterestInProperty(prop: Integer) strict {
    label en official "an interest in section 1250(a)(1)(B) property is low-income housing (section 267(e)(5)(D)(i))";
    when property_described_in_1250a1B_i_to_iv(prop);
    then low_income_housing_interest(prop);
}
@source(IRC_S267_E, quote = "(ii) any interest in a partnership owning such property.")
rule LowIncomeHousingInterestInPartnership(partnership: Person, prop: Integer) strict {
    label en official "an interest in a partnership owning such property is low-income housing (section 267(e)(5)(D)(ii))";
    when partnership_owns_property_described_in_1250a1B(partnership, prop);
    then low_income_housing_interest(prop);
}

// --- 267(a)(3), (d)(2),(3), (f)(1),(4) ---------------------------------------------------------------------------------------------------------------------------------

pub relation payment_item_payable_to_cfc_or_pfic(item: Integer) kind empirical {
    label en official "the item is payable to a controlled foreign corporation (section 957) or a passive foreign investment company (section 1297) (section 267(a)(3)(B)(i))";
}
pub relation amount_attributable_includible_in_gross_income_of_us_owner_of_stock(item: Integer, taxable_year_before_payment: TaxableYear, amount: Money) kind empirical {
    label en official "the amount attributable to the item that is includible (without regard to properly allocable deductions and qualified deficits under section 952(c)(1)(B)) during the prior taxable year in the gross income of a United States person who owns (section 958(a)) stock in the corporation (section 267(a)(3)(B)(i))";
}
pub relation payor_accrual_deduction_before_payment_year(item: Integer, taxable_year_before_payment: TaxableYear, amount: Money) kind empirical {
    label en official "the deduction otherwise allowable to the payor for the item in a taxable year before the year in which it is paid";
}
pub relation cfc_pfic_payor_deduction_allowed_before_payment(item: Integer, taxable_year_before_payment: TaxableYear, amount: Money) kind institutional {
    label en official "the payor's deduction before the year of payment, allowed only to the extent an amount attributable to the item is includible in the gross income of a United States shareholder (section 267(a)(3)(B)(i))";
}
@source(IRC_S267_A, quote = "a deduction shall be allowable to the payor with respect to such amount for any taxable year before the taxable year in which paid only to the extent that an amount attributable to such item is includible")
rule CfcPficPayorDeductionLimitedToIncludibleAmount(item: Integer, ty: TaxableYear, deduction: Money, includible: Money) strict {
    label en official "the payor's pre-payment deduction for an item payable to a CFC or PFIC is limited to the amount includible by a United States owner (section 267(a)(3)(B)(i))";
    when payment_item_payable_to_cfc_or_pfic(item);
    when payor_accrual_deduction_before_payment_year(item, ty, deduction);
    when amount_attributable_includible_in_gross_income_of_us_owner_of_stock(item, ty, includible);
    then cfc_pfic_payor_deduction_allowed_before_payment(item, ty, min(deduction, includible));
}
pub relation prior_loss_disallowed_by_wash_sale_1091(transferor: Person, taxpayer: Person, item: Integer) kind empirical {
    label en official "the loss sustained by the transferor is not allowable by reason of section 1091 (wash sales) (section 267(d)(2))";
}
pub relation transferor_loss_not_taken_into_account_for_tax_under_section_1_or_11(transferor: Person, taxpayer: Person, item: Integer, amount: Money) kind empirical {
    label en official "the part of the transferor's loss which, if allowed, would not be taken into account in determining a tax imposed under section 1 or 11 (or a tax computed as provided by either) (section 267(d)(3))";
}
pub relation prior_loss_effective_for_267d1(transferor: Person, taxpayer: Person, item: Integer, amount: Money) kind institutional {
    label en official "the disallowed loss that limits the gain recognized: not for a wash-sale loss ((d)(2)) and net of the part not taken into account for tax ((d)(3))";
}
@source(IRC_S267_D, quote = "Paragraph (1) shall not apply if the loss sustained by the transferor is not allowable to the transferor as a deduction by reason of section 1091")
rule PriorLossEffectiveExceptWashSaleAndTaxIndifferentPart(transferor: Person, taxpayer: Person, item: Integer, disallowed: Money, indifferent: Money) strict {
    label en official "the loss carried into (d)(1) excludes a wash-sale loss and the part that would not be taken into account in determining tax (section 267(d)(2),(3))";
    when prior_loss_disallowed_under_267a1(transferor, taxpayer, item, disallowed);
    when transferor_loss_not_taken_into_account_for_tax_under_section_1_or_11(transferor, taxpayer, item, indifferent);
    when not_known(prior_loss_disallowed_by_wash_sale_1091(transferor, taxpayer, item));
    then prior_loss_effective_for_267d1(transferor, taxpayer, item, max(0.00 USD, disallowed - indifferent));
}
@source(IRC_S267_D, quote = "Paragraph (1) shall not apply to the extent any loss sustained by the transferor (if allowed) would not be taken into account")
rule PriorLossEffectiveWithNoTaxIndifferentPart(transferor: Person, taxpayer: Person, item: Integer, disallowed: Money) strict {
    label en official "with no tax-indifferent part and no wash sale the whole disallowed loss carries into (d)(1) (section 267(d))";
    when prior_loss_disallowed_under_267a1(transferor, taxpayer, item, disallowed);
    when not_known(prior_loss_disallowed_by_wash_sale_1091(transferor, taxpayer, item));
    when not_known(tax_indifferent_part_recorded(transferor, taxpayer, item));
    then prior_loss_effective_for_267d1(transferor, taxpayer, item, disallowed);
}
pub relation tax_indifferent_part_recorded(transferor: Person, taxpayer: Person, item: Integer) kind institutional {
    label en official "helper: a tax-indifferent part of the loss is recorded";
}
rule TaxIndifferentPartRecordedHelper(transferor: Person, taxpayer: Person, item: Integer, indifferent: Money) strict {
    label en official "helper for the (d)(3) alternative";
    when transferor_loss_not_taken_into_account_for_tax_under_section_1_or_11(transferor, taxpayer, item, indifferent);
    then tax_indifferent_part_recorded(transferor, taxpayer, item);
}
pub relation gain_recognized_after_effective_prior_loss(taxpayer: Person, item: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gain recognized on the later disposition after the effective prior disallowed loss (section 267(d)(1) with (2),(3))";
}
@source(IRC_S267_D, quote = "then such gain shall be recognized only to the extent that it exceeds so much of such loss as is properly allocable to the property sold or otherwise disposed of by the taxpayer")
rule GainRecognizedAfterEffectivePriorLoss(transferor: Person, taxpayer: Person, item: Integer, y: TaxableYear, eff_loss: Money, realized: Money) strict {
    label en official "the gain is recognized only to the extent it exceeds the effective disallowed loss (section 267(d)(1)-(3)); the stage 1 rule reads the raw disallowed loss";
    when prior_loss_effective_for_267d1(transferor, taxpayer, item, eff_loss);
    when gain_on_later_disposition(taxpayer, item, y, realized);
    then gain_recognized_after_effective_prior_loss(taxpayer, item, y, max(0.00 USD, realized - eff_loss));
}
pub relation section_of_title_refers_to_relationship_resulting_in_267_disallowance(section: Integer) kind empirical {
    label en official "another section of this title refers to a relationship which would result in a disallowance of losses under section 267 (section 267(f)(4))";
}
pub relation loss_deferred_under_267f2_for_relationship(a: Person, b: Person) kind empirical {
    label en official "a loss between the persons is deferred under paragraph (2)";
}
pub relation deferral_treated_as_disallowance_for_other_sections(a: Person, b: Person) kind institutional {
    label en official "for any other section referring to a relationship resulting in disallowance under section 267, the paragraph (2) deferral is treated as disallowance (section 267(f)(4))";
}
@source(IRC_S267_F, quote = "deferral under paragraph (2) shall be treated as disallowance")
rule DeferralTreatedAsDisallowanceForOtherSections(a: Person, b: Person, section: Integer) strict {
    label en official "a controlled group deferral counts as disallowance for other sections' relationship tests (section 267(f)(4))";
    when section_of_title_refers_to_relationship_resulting_in_267_disallowance(section);
    when loss_deferred_under_267f2_for_relationship(a, b);
    then deferral_treated_as_disallowance_for_other_sections(a, b);
}
