// Section 280F — Limitation on depreciation for luxury automobiles.
// Stage 1 (IRC-06), priority section: the depreciation COMPUTATION itself
// is `accounting`'s pending concern (sections 167/168); this module models
// only the section 280F(a)(1)(A) dollar CAP as a limitation applied to
// whatever depreciation amount that computation produces.

use self::{
    DeductionKind,
    IRC_S280F_A,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation depreciation_deduction_before_280f_cap(p: Person, y: TaxableYear, vehicle: Integer, recovery_year: Integer, amount: Money) kind institutional {
    label en official "the depreciation deduction otherwise computed for a passenger automobile for the recovery year, before the section 280F(a)(1)(A) dollar cap — dependency contract, producer: accounting (pending, sections 167/168)";
}

@source(IRC_S280F_A, quote = "$10,000 for the 1st taxable year in the recovery period")
rule LuxuryAutoCapFirstYear(p: Person, y: TaxableYear, vehicle: Integer, before_cap: Money) strict {
    label en official "the depreciation deduction for a passenger automobile's 1st recovery year is capped at $10,000 (statutory base; unindexed for inflation here — the published annually-indexed amount is SOURCE_GAP, no IRB citation pinned)";
    when depreciation_deduction_before_280f_cap(p, y, vehicle, 1, before_cap);
    when before_cap > 10000.00 USD;
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, before_cap - 10000.00 USD);
}
@source(IRC_S280F_A, quote = "$16,000 for the 2nd taxable year in the recovery period")
rule LuxuryAutoCapSecondYear(p: Person, y: TaxableYear, vehicle: Integer, before_cap: Money) strict {
    label en official "the depreciation deduction for a passenger automobile's 2nd recovery year is capped at $16,000 (statutory base; SOURCE_GAP for the indexed amount)";
    when depreciation_deduction_before_280f_cap(p, y, vehicle, 2, before_cap);
    when before_cap > 16000.00 USD;
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, before_cap - 16000.00 USD);
}
@source(IRC_S280F_A, quote = "$9,600 for the 3rd taxable year in the recovery period")
rule LuxuryAutoCapThirdYear(p: Person, y: TaxableYear, vehicle: Integer, before_cap: Money) strict {
    label en official "the depreciation deduction for a passenger automobile's 3rd recovery year is capped at $9,600 (statutory base; SOURCE_GAP for the indexed amount)";
    when depreciation_deduction_before_280f_cap(p, y, vehicle, 3, before_cap);
    when before_cap > 9600.00 USD;
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, before_cap - 9600.00 USD);
}
@source(IRC_S280F_A, quote = "$5,760 for each succeeding taxable year in the recovery period")
rule LuxuryAutoCapSucceedingYears(p: Person, y: TaxableYear, vehicle: Integer, recovery_year: Integer, before_cap: Money) strict {
    label en official "the depreciation deduction for each succeeding recovery year of a passenger automobile is capped at $5,760 (statutory base; SOURCE_GAP for the indexed amount)";
    when depreciation_deduction_before_280f_cap(p, y, vehicle, recovery_year, before_cap);
    when recovery_year > 3;
    when before_cap > 5760.00 USD;
    then not deduction_allowed(p, y, Section262PersonalNonDeductible, before_cap - 5760.00 USD);
}
// JUDGMENT CALL: these four table amounts are the ORIGINAL 1984-vintage
// dollar figures the pinned §280F(a)(1)(A) text states; the statute
// specifies (in (a)(1)(A) itself, via (d)(7)) that these are the base
// figures for a 1988-and-later cost-of-living adjustment table the IRS
// publishes annually (Rev. Proc.) — no such published table is pinned
// anywhere in this package's sources, so every year's ACTUAL applicable
// dollar limit is SOURCE_GAP; the bare statutory figures above are usable
// only for a hypothetical scenario that stipulates them directly, not for
// a real current-year computation. (a)(1)(B) post-recovery-period
// unrecovered basis, (a)(2) coordination with personal-use reductions,
// (b) listed-property limits, (c) employee use, (d) definitions stay
// "stage 2".
