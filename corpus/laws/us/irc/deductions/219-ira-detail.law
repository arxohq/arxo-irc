// Section 219 — retirement savings: stage 2b detail (TECH_GAPS G2798): (c) the spousal IRA limit,
// (d)(2)-(4) non-deductible amounts, (e) qualified retirement contributions, (f) compensation, married
// individuals, timing, employer payments, unused limitation and combat-zone compensation. The
// stage 1 `219-ira.law` keeps the (a)/(b) allowance and (g) phase-out. Not modelled: the (g) linear
// phase-out; the allocation of endowment-contract amounts to life insurance cost (regulations, a
// fact); section 4973(b)(2) excess contributions (a fact); the (b)(3) 501(c)(18) $7,000/25 percent
// limit and (b)(5)(C) indexing (published amounts unpinned).

// --- (e): qualified retirement contributions -----------------------------------------------------------------------------

use self::{
    DeductionKind,
    IRC_S219_C,
    IRC_S219_D,
    IRC_S219_E,
    IRC_S219_F,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation cash_paid_to_individual_retirement_plan_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "any amount paid in cash for the taxable year by or on behalf of an individual to an individual retirement plan for such individual's benefit (section 219(e)(1))";
}
pub relation contributed_on_behalf_to_501c18_plan(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "any amount contributed on behalf of an individual to a plan described in section 501(c)(18) (section 219(e)(2))";
}
pub relation qualified_retirement_contribution_amount(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified retirement contributions of the individual for the taxable year (section 219(e))";
}
@source(IRC_S219_E, quote = "(1) any amount paid in cash for the taxable year by or on behalf of an individual to an individual retirement plan for such individual's benefit, and")
rule QualifiedRetirementContributionCash(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "cash paid to an individual retirement plan is a qualified retirement contribution (section 219(e)(1))";
    when cash_paid_to_individual_retirement_plan_for_year(p, y, amount);
    then qualified_retirement_contribution_amount(p, y, amount);
}
@source(IRC_S219_E, quote = "(2) any amount contributed on behalf of any individual to a plan described in section 501(c)(18).")
rule QualifiedRetirementContribution501c18(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an amount contributed on behalf of an individual to a section 501(c)(18) plan is a qualified retirement contribution (section 219(e)(2))";
    when contributed_on_behalf_to_501c18_plan(p, y, amount);
    then qualified_retirement_contribution_amount(p, y, amount);
}

// --- (f)(1),(7): compensation ----------------------------------------------------------------------------------------------------

enum CompensationItemKind {
    EarnedIncome401c2;
    DifferentialWagePayment;
    GraduateOrPostdoctoralStudyAid;
    PensionOrAnnuity;
    DeferredCompensation;
    CombatZoneExcludedUnderSection112;
}
pub relation compensation_item(p: Individual, y: TaxableYear, item: Integer, kind: CompensationItemKind, amount: Money) kind empirical {
    label en official "an item received by the individual for the taxable year, of a kind relevant to compensation under section 219(f)(1),(7)";
}
pub relation compensation_item_included_219f(p: Individual, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the item is included in compensation for section 219";
}
@source(IRC_S219_F, quote = "For purposes of this section, the term \"compensation\" includes earned income (as defined in section 401(c)(2)).")
rule CompensationIncludesEarnedIncome(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "earned income (section 401(c)(2), applied as if the section 1402 trade or business included service of subsection (c)(6)) is compensation (section 219(f)(1))";
    when compensation_item(p, y, item, EarnedIncome401c2, amount);
    then compensation_item_included_219f(p, y, item, amount);
}
@source(IRC_S219_F, quote = "The term \"compensation\" includes any differential wage payment (as defined in section 3401(h)(2)).")
rule CompensationIncludesDifferentialWage(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a differential wage payment is compensation (section 219(f)(1))";
    when compensation_item(p, y, item, DifferentialWagePayment, amount);
    then compensation_item_included_219f(p, y, item, amount);
}
@source(IRC_S219_F, quote = "The term \"compensation\" shall include any amount which is included in the individual's gross income and paid to the individual to aid the individual in the pursuit of graduate or postdoctoral study.")
rule CompensationIncludesGraduateStudyAid(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "an amount included in gross income and paid to aid graduate or postdoctoral study is compensation (section 219(f)(1))";
    when compensation_item(p, y, item, GraduateOrPostdoctoralStudyAid, amount);
    then compensation_item_included_219f(p, y, item, amount);
}
@source(IRC_S219_F, quote = "For purposes of subsections (b)(1)(B) and (c), the amount of compensation includible in an individual's gross income shall be determined without regard to section 112.")
rule CompensationIncludesCombatZonePay(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for subsections (b)(1)(B) and (c), combat-zone pay excluded by section 112 is treated as includible compensation (section 219(f)(7))";
    when compensation_item(p, y, item, CombatZoneExcludedUnderSection112, amount);
    then compensation_item_included_219f(p, y, item, amount);
}
pub relation compensation_for_219(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the compensation of the individual for section 219: earned income, differential wages, graduate study aid and combat-zone pay, but not pensions, annuities or deferred compensation (section 219(f)(1),(7))";
}
rule CompensationFor219Total(p: Individual, y: TaxableYear, i0: Integer, a0: Money) strict {
    label en official "helper: sums the items included in compensation (section 219(f)(1),(7)); pension, annuity and deferred compensation items are excluded because no rule includes them";
    when compensation_item_included_219f(p, y, i0, a0);
    then compensation_for_219(p, y,
        sum all amount: Money for item: Integer where compensation_item_included_219f(p, y, item, amount));
}

// --- (c): spousal IRA --------------------------------------------------------------------------------------------------------------

pub relation files_joint_return_219c(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual files a joint return for the taxable year (section 219(c)(2)(A))";
}
pub relation spouse_compensation_includible(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the compensation includible in the gross income of the individual's spouse for the taxable year (section 219(c)(1)(B)(ii))";
}
pub relation spouse_ira_deduction_allowed(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount allowed as a deduction under subsection (a) to the spouse for the taxable year (section 219(c)(1)(B)(ii)(I))";
}
pub relation spouse_designated_nondeductible_contribution(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of any designated nondeductible contribution (section 408(o)) on behalf of the spouse for the taxable year (section 219(c)(1)(B)(ii)(II))";
}
pub relation spouse_roth_ira_contribution(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of any contribution on behalf of the spouse to a Roth IRA under section 408A for the taxable year (section 219(c)(1)(B)(ii)(III))";
}
pub relation spousal_ira_applies(p: Individual, y: TaxableYear) kind institutional {
    label en official "paragraph (1) of section 219(c) applies: a joint return and the individual's compensation is less than the spouse's";
}
@source(IRC_S219_C, quote = "the amount of compensation (if any) includible in such individual's gross income for the taxable year is less than the compensation includible in the gross income of such individual's spouse for the taxable year")
rule SpousalIraAppliesWhenOwnCompensationLower(p: Individual, y: TaxableYear, own: Money, spouse: Money) strict {
    label en official "the spousal limit applies to a joint filer whose compensation is less than the spouse's (section 219(c)(2))";
    when files_joint_return_219c(p, y);
    when compensation_for_219(p, y, own);
    when spouse_compensation_includible(p, y, spouse);
    when own < spouse;
    then spousal_ira_applies(p, y);
}
pub relation spousal_ira_limit(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 219(b)(1) limitation of an individual to whom the spousal rule applies: the lesser of the dollar amount and own compensation plus the spouse's compensation reduced by the spouse's deduction, designated nondeductible contribution and Roth contribution (section 219(c)(1))";
}
@source(IRC_S219_C, quote = "the limitation of paragraph (1) of subsection (b) shall be equal to the lesser of")
rule SpousalIraLimitLesserOfDollarAndCombined(p: Individual, y: TaxableYear, own: Money, spouse: Money, deduction: Money, nondeductible: Money, roth: Money) strict {
    label en official "the spousal limit is the lesser of the deductible amount ($5,000 unindexed base) and combined compensation less the spouse's contributions (section 219(c)(1)); not below zero";
    when spousal_ira_applies(p, y);
    when compensation_for_219(p, y, own);
    when spouse_compensation_includible(p, y, spouse);
    when spouse_ira_deduction_allowed(p, y, deduction);
    when spouse_designated_nondeductible_contribution(p, y, nondeductible);
    when spouse_roth_ira_contribution(p, y, roth);
    then spousal_ira_limit(p, y, max(0.00 USD, min(5000.00 USD, own + spouse - deduction - nondeductible - roth)));
}

// --- (d)(2),(3),(4): amounts for which no deduction is allowed ----------------------------------------------------------------------------

pub relation rollover_contribution_402c_403a4_403b8_408d3_457e16(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "a rollover contribution described in section 402(c), 403(a)(4), 403(b)(8), 408(d)(3) or 457(e)(16) (section 219(d)(2))";
}
@source(IRC_S219_D, quote = "No deduction shall be allowed under this section with respect to a rollover contribution described in section 402(c), 403(a)(4), 403(b)(8), 408(d)(3), or 457(e)(16).")
rule NoIraDeductionForRolloverContribution(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "no deduction under section 219 for a rollover contribution (section 219(d)(2))";
    when rollover_contribution_402c_403a4_403b8_408d3_457e16(p, y, amount);
    then not deduction_allowed(p, y, Section219Ira, amount);
}
pub relation endowment_contract_408b_amount_allocable_to_life_insurance_cost(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the portion of the amounts paid under an endowment contract described in section 408(b) which is properly allocable, under regulations prescribed by the Secretary, to the cost of life insurance (section 219(d)(3))";
}
@source(IRC_S219_D, quote = "no deduction shall be allowed under this section for that portion of the amounts paid under the contract for the taxable year which is properly allocable")
rule NoIraDeductionForLifeInsuranceCostPortion(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "no deduction for the life-insurance-cost portion of an endowment contract (section 219(d)(3)); the allocation is a fact (regulations)";
    when endowment_contract_408b_amount_allocable_to_life_insurance_cost(p, y, amount);
    then not deduction_allowed(p, y, Section219Ira, amount);
}
pub relation amount_paid_to_inherited_ira_or_annuity(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid to an inherited individual retirement account or annuity (within the meaning of section 408(d)(3)(C)(ii)) (section 219(d)(4))";
}
@source(IRC_S219_D, quote = "No deduction shall be allowed under this section with respect to any amount paid to an inherited individual retirement account or individual retirement annuity")
rule NoIraDeductionForInheritedIra(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "no deduction for an amount paid to an inherited IRA (section 219(d)(4))";
    when amount_paid_to_inherited_ira_or_annuity(p, y, amount);
    then not deduction_allowed(p, y, Section219Ira, amount);
}

// --- (f)(2),(3),(5): married individuals, timing, employer payments ------------------------------------------------------------------------------

pub relation maximum_deduction_computed_separately_for_each_spouse(p: Individual, y: TaxableYear) kind institutional {
    label en official "the maximum deduction under subsection (b) is computed separately for each individual, without regard to community property laws (section 219(f)(2))";
}
pub relation individual_is_married_for_219(p: Individual, y: TaxableYear) kind empirical {
    label en official "the individual is married for the taxable year";
}
@source(IRC_S219_F, quote = "The maximum deduction under subsection (b) shall be computed separately for each individual, and this section shall be applied without regard to any community property laws.")
rule MaximumDeductionSeparatePerSpouseNoCommunityProperty(p: Individual, y: TaxableYear) strict {
    label en official "each spouse's maximum deduction is computed separately and community property law is disregarded (section 219(f)(2))";
    when individual_is_married_for_219(p, y);
    then maximum_deduction_computed_separately_for_each_spouse(p, y);
}
pub relation ira_contribution_made_on_date(p: Individual, plan: Integer, made_on: Date, for_year: TaxableYear, amount: Money) kind empirical {
    label en official "a contribution to an individual retirement plan made on the date on account of the taxable year";
}
pub relation return_due_date_excluding_extensions(p: Individual, y: TaxableYear, due: Date) kind empirical {
    label en official "the time prescribed by law for filing the return for the taxable year, not including extensions (section 219(f)(3))";
}
pub relation last_day_of_taxable_year(y: TaxableYear, last: Date) kind empirical {
    label en official "the last day of the taxable year";
}
pub relation ira_contribution_deemed_made_last_day_of_year(p: Individual, plan: Integer, y: TaxableYear, deemed: Date, amount: Money) kind institutional {
    label en official "the contribution is deemed made on the last day of the taxable year (section 219(f)(3))";
}
@source(IRC_S219_F, quote = "a taxpayer shall be deemed to have made a contribution to an individual retirement plan on the last day of the preceding taxable year if the contribution is made on account of such taxable year and is made not later than the time prescribed by law for filing the return for such taxable year")
rule IraContributionDeemedMadeLastDayOfTaxableYear(p: Individual, plan: Integer, y: TaxableYear, made: Date, due: Date, last: Date, amount: Money) strict {
    label en official "a contribution on account of a year, made by the return due date without extensions, is deemed made on the last day of that year (section 219(f)(3))";
    when ira_contribution_made_on_date(p, plan, made, y, amount);
    when return_due_date_excluding_extensions(p, y, due);
    when last_day_of_taxable_year(y, last);
    when made <= due;
    then ira_contribution_deemed_made_last_day_of_year(p, plan, y, last, amount);
}
pub relation employer_payment_to_individual_retirement_plan(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "an amount paid by an employer to an individual retirement plan for the taxable year (section 219(f)(5))";
}
pub relation employee_is_self_employed_individual_under_401c1(p: Individual) kind empirical {
    label en official "the employee is a self-employed individual who is an employee within the meaning of section 401(c)(1) (section 219(f)(5))";
}
pub relation employer_ira_payment_treated_as_compensation_includible(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the employer's payment is treated as compensation of the employee includible in gross income in the year for which it was contributed, whether or not deductible (section 219(f)(5))";
}
@source(IRC_S219_F, quote = "any amount paid by an employer to an individual retirement plan shall be treated as payment of compensation to the employee")
rule EmployerIraPaymentTreatedAsCompensation(p: Individual, y: TaxableYear, amount: Money) strict {
    label en official "an employer's payment to an employee's IRA is compensation includible in gross income for the year contributed, except for a self-employed 401(c)(1) employee (section 219(f)(5))";
    when employer_payment_to_individual_retirement_plan(p, y, amount);
    when not_known(employee_is_self_employed_individual_under_401c1(p));
    then employer_ira_payment_treated_as_compensation_includible(p, y, amount);
}

// --- (f)(6): unused limitation ---------------------------------------------------------------------------------------------------------------

pub relation maximum_ira_deduction_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the maximum amount allowable as a deduction under section 219 for contributions to an individual retirement plan for the taxable year (section 219(f)(6)(A))";
}
pub relation amount_contributed_excluding_rollovers_and_this_paragraph(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount contributed, determined without regard to paragraph (6) and not including rollover contributions (section 219(f)(6)(B))";
}
pub relation excess_contributions_4973b2_without_c(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the excess contributions for the taxable year determined under section 4973(b)(2) without regard to subparagraph (C) thereof (section 219(f)(6)(A)(ii))";
}
pub relation additional_contribution_treated_made_for_year(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional contribution the taxpayer is treated as having made for the taxable year (section 219(f)(6)(A))";
}
@source(IRC_S219_F, quote = "then the taxpayer shall be treated as having made an additional contribution for the taxable year in an amount equal to the lesser of")
rule UnusedLimitationAdditionalContributionLesserOfExcessAndOverContributions(p: Individual, y: TaxableYear, maximum: Money, contributed: Money, excess_contributions: Money) strict {
    label en official "where the maximum deduction exceeds the amount contributed, the taxpayer is treated as having made an additional contribution equal to the lesser of the unused amount and the section 4973(b)(2) excess contributions (section 219(f)(6)(A))";
    when maximum_ira_deduction_for_year(p, y, maximum);
    when amount_contributed_excluding_rollovers_and_this_paragraph(p, y, contributed);
    when excess_contributions_4973b2_without_c(p, y, excess_contributions);
    when maximum > contributed;
    then additional_contribution_treated_made_for_year(p, y, min(maximum - contributed, excess_contributions));
}
pub relation prior_closed_year_deduction_allowed(p: Individual, y: TaxableYear, prior: TaxableYear, allowed: Money, should_have_been: Money) kind empirical {
    label en official "an amount allowed as a deduction under section 219 for a prior taxable year for which the period for assessing deficiency has expired, with the amount that should have been allowed (section 219(f)(6)(C))";
}
pub relation unused_limitation_reduction_for_closed_year(p: Individual, y: TaxableYear, reduction: Money) kind institutional {
    label en official "the proper reduction in the amount allowable by reason of paragraph (6) for an excess deduction allowed for a closed prior year (section 219(f)(6)(C))";
}
@source(IRC_S219_F, quote = "Proper reduction shall be made in the amount allowable as a deduction by reason of this paragraph for any amount allowed as a deduction under this section for a prior taxable year for which the period for assessing deficiency has expired")
rule ClosedYearExcessDeductionReducesUnusedLimitationAdditional(p: Individual, y: TaxableYear, prior: TaxableYear, allowed: Money, should: Money) strict {
    label en official "the excess of the deduction allowed over what should have been allowed for a closed year reduces the paragraph (6) amount (section 219(f)(6)(C))";
    when prior_closed_year_deduction_allowed(p, y, prior, allowed, should);
    when allowed > should;
    then unused_limitation_reduction_for_closed_year(p, y, allowed - should);
}
