// Section 197 — Amortization of goodwill and certain other intangibles.
// Stage 2b. Scope: (a) general rule (15-year straight-line amortization,
// ANNUAL amount only — no month-of-acquisition proration, see the note
// below); (b) no other depreciation/amortization deduction (classification
// note, not an enforced cross-section exclusion — TECH_GAP); (c)(1)
// amortizable section 197 intangible (acquired after the date of
// enactment, held in connection with a trade or business or section 212
// activity) and (c)(2) the self-created-intangible exclusion (gated, not
// broken into every (d)(1) sub-item); (d)(1) intro (the classification
// itself is an empirical fact — the exhaustive list of intangible types is
// NOT decomposed into separate rules, TECH_GAP); (e) exceptions are NOT
// enforced (financial interests, land, off-the-shelf computer software —
// TECH_GAP, `section_197_intangible` is taken as given); (f)(9)
// anti-churning, as a classification that blocks (c)(1) (only the three
// (f)(9)(A) triggering conditions, not the (f)(9)(B) gain-recognized
// exception).

use self::{
    Asset,
    IRC_S197_A,
    IRC_S197_C,
    IRC_S197_F,
    Person,
    TaxableYear,
    section_197_anti_abuse_disqualified,
    section_197_basis_determined_under_1014a,
};

pub relation section_197_intangible(p: Person, a: Asset) kind empirical {
    label en official "the property is a section 197 intangible under section 197(d)(1) (this module takes the classification as given; the exhaustive list of intangible types and the section (e) exceptions are not derived — TECH_GAP)";
}
pub relation section_197_held_for_trade_or_business_or_212(p: Person, a: Asset) kind empirical {
    label en official "the intangible is held in connection with the conduct of a trade or business or a section 212 activity (section 197(c)(1)(B))";
}
pub relation section_197_acquired_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the section 197 intangible (section 197(a),(c)(1)(A))";
}
pub relation section_197_created_by_taxpayer(p: Person, a: Asset) kind empirical {
    label en official "the intangible was created by the taxpayer rather than acquired from another person (section 197(c)(2))";
}
pub relation section_197_type_d_e_or_f(p: Person, a: Asset) kind empirical {
    label en official "the intangible is described in subparagraph (D), (E), or (F) of section 197(d)(1) (licenses/permits, franchises/trademarks/trade names, or covenants not to compete), which are excepted from the self-created-intangible exclusion (section 197(c)(2))";
}

pub relation section_197_self_created_excluded(p: Person, a: Asset) kind institutional {
    label en official "the self-created intangible is excluded from 'amortizable section 197 intangible' (section 197(c)(2))";
}
@source(IRC_S197_C, quote = "which is created by the taxpayer")
rule Section197SelfCreatedExclusion(p: Person, a: Asset) defeasible {
    label en official "a self-created intangible not of type (D), (E) or (F) is excluded from amortizable section 197 intangible status (section 197(c)(2))";
    when section_197_created_by_taxpayer(p, a);
    unless section_197_type_d_e_or_f(p, a);
    then section_197_self_created_excluded(p, a);
}

// --- (f)(9): anti-churning ---------------------------------------------------

pub relation section_197_goodwill_or_going_concern(p: Person, a: Asset) kind empirical {
    label en official "the intangible is described in subparagraph (A) or (B) of section 197(d)(1) (goodwill or going concern value), the anti-churning gate (section 197(f)(9)(A))";
}
pub relation section_197_held_or_used_before_enactment_by_taxpayer_or_related(p: Person, a: Asset) kind empirical {
    label en official "the intangible was held or used at any time on or after July 25, 1991 and on or before the date of enactment by the taxpayer or a related person (section 197(f)(9)(A)(i))";
}
pub relation section_197_acquired_from_prior_holder_no_user_change(p: Person, a: Asset) kind empirical {
    label en official "the intangible was acquired from a person who held it during the pre-enactment window and the user did not change as part of the transaction (section 197(f)(9)(A)(ii))";
}
pub relation section_197_granted_use_to_prior_holder(p: Person, a: Asset) kind empirical {
    label en official "the taxpayer grants the right to use the intangible to a person who held or used it during the pre-enactment window (section 197(f)(9)(A)(iii))";
}
pub relation section_197_anti_churning_disqualified(p: Person, a: Asset) kind institutional {
    label en official "the intangible is disqualified from amortizable section 197 intangible status by the anti-churning rule (section 197(f)(9)(A))";
}
@source(IRC_S197_F, quote = "which is described in subparagraph (A) or (B) of subsection (d)(1)")
rule Section197AntiChurningDisqualification(p: Person, a: Asset) strict {
    label en official "goodwill or going concern value held or used before enactment (by the taxpayer, a related person, or via a no-user-change acquisition or a use grant back to a prior holder) is disqualified from amortizable section 197 intangible status (section 197(f)(9)(A))";
    when section_197_goodwill_or_going_concern(p, a);
    when not_known(section_197_basis_determined_under_1014a(p, a));
    when section_197_held_or_used_before_enactment_by_taxpayer_or_related(p, a)
        or section_197_acquired_from_prior_holder_no_user_change(p, a)
        or section_197_granted_use_to_prior_holder(p, a);
    then section_197_anti_churning_disqualified(p, a);
}
// (f)(9)(B) exception where gain is recognized on the earlier transfer is
// NOT modelled — TECH_GAP.

// --- (c): amortizable section 197 intangible --------------------------------

pub relation amortizable_section_197_intangible(p: Person, a: Asset) kind institutional {
    label en official "the intangible is an amortizable section 197 intangible (section 197(c)(1))";
}
@source(IRC_S197_C, quote = "which is acquired by the taxpayer after the date of the enactment of this section")
rule AmortizableSection197IntangibleRule(p: Person, a: Asset, acquired: Date) defeasible {
    label en official "a section 197 intangible acquired after the date of enactment (August 10, 1993) and held in connection with a trade or business or section 212 activity is amortizable, absent the self-created or anti-churning exclusions (section 197(c)(1))";
    when section_197_intangible(p, a);
    when section_197_held_for_trade_or_business_or_212(p, a);
    when section_197_acquired_on(p, a, acquired);
    when acquired > @1993-08-10;
    unless section_197_self_created_excluded(p, a);
    unless section_197_anti_churning_disqualified(p, a);
    unless section_197_anti_abuse_disqualified(p, a);
    then amortizable_section_197_intangible(p, a);
}

// --- (a): the annual amortization amount -------------------------------------
//
// Ratably over the 15-year (180-month) period beginning with the month of
// acquisition — this module computes only the FULL annual amount
// (basis * 1/15); the month-of-acquisition proration for the first and
// last (partial) years is NOT modelled (TECH_GAP, same "year-1 proration"
// class noted for section 168's real-property classes).

pub relation section_197_adjusted_basis(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis (for purposes of determining gain) of the amortizable section 197 intangible (section 197(a))";
}
pub relation section_197_held_for_full_taxable_year(p: Person, a: Asset, y: TaxableYear) kind empirical {
    label en official "the intangible was held by the taxpayer for the entirety of the taxable year (the scope condition under which this module's annual, unprorated amount applies)";
}

pub relation amortization_197(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 197(a) amortization deduction for the taxable year";
}
@source(IRC_S197_A, quote = "The amount of such deduction shall be determined by amortizing the adjusted basis (for purposes of determining gain) of such intangible ratably over the 15-year period beginning with the month in which such intangible was acquired")
rule Amortization197AnnualAmount(p: Person, a: Asset, y: TaxableYear, basis: Money) defeasible {
    label en official "for a full taxable year, the amortization deduction is 1/15 of the adjusted basis (section 197(a))";
    when amortizable_section_197_intangible(p, a);
    when section_197_adjusted_basis(p, a, basis);
    when section_197_held_for_full_taxable_year(p, a, y);
    then amortization_197(p, a, y, div_round(basis, 15.0, 2, "HALF_UP"));
}
// (b): no other depreciation/amortization deduction is allowable for an
// amortizable section 197 intangible — a classification note, not an
// enforced cross-section exclusion (this package has no other module that
// could double-depreciate a section 197 intangible today, so no interlock
// rule is written) — TECH_GAP if such a module is ever added.
