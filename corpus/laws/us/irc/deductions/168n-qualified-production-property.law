// Section 168(n) — special allowance for qualified production property (Pub. L. 119-21 section 70307),
// stage 2c. The pinned 2024 edition of section 168 has no subsection (n); the text is the amendment of
// the temporal package (`us.irc.temporal::PL119_21_S70307`), effective for property placed in service
// after the date of enactment (July 4, 2025).
//
// Scope: (n)(1) the 100 percent allowance and the basis reduction, (n)(2) the definition of qualified
// production property, activity, production and product, the (B) special rule for property not
// previously used, the (C) exclusion of office and similar space, (G) syndication, (H) the extension
// for an act of God; (n)(3) the minimum tax; (n)(4) the separate class and the exclusion of
// alternative depreciation property; (n)(5) the 10-year recapture; (n)(6) the election and its
// revocation with the Secretary's consent. The regulations of (n)(7) are external.
//
// JUDGMENT CALLS: (1) the part of a nonresidential building that is "that portion" of the property
// is a basis: the designated portion's adjusted basis less the basis of the excluded functions
// ((C)); (2) the recapture of (n)(5) treats the ordinary-income amount as the depreciation adjustments
// taken (the (B) amount of section 1245(a)(1) is treated as at least the (A) amount); (3) a written
// binding contract fixes the acquisition date for the (B)(i) period test only when it falls outside
// the period, as (B)(ii) provides; (4) amounts are rounded to cents HALF_UP.

// --- (n)(2)(D)-(F): qualified production activity and product ----------------------------------------------------------------------------------------

use self::{
    Asset,
    Person,
    TaxableYear,
    acquisition_meets_179d_2ABC_3,
    syndication_rule_applies,
};

pub enum QppActivityKind {
    Manufacturing;
    Refining;
    AgriculturalProduction;
    ChemicalProduction;
    OtherProduction;
}
pub relation qpp_activity_kind_of_use(p: Person, a: Asset, kind: QppActivityKind) kind empirical {
    label en official "the kind of activity for which the building is used: manufacturing, refining, or production of the stated kind (section 168(n)(2)(D),(E))";
}
pub relation qpp_activity_results_in_substantial_transformation(p: Person, a: Asset) kind empirical {
    label en official "the taxpayer's activities result in a substantial transformation of the property comprising the product (section 168(n)(2)(D) second sentence)";
}
pub relation qpp_product_is_tangible_personal_property(p: Person, a: Asset) kind empirical {
    label en official "the product is tangible personal property (section 168(n)(2)(F))";
}
pub relation qpp_product_is_food_or_beverage_prepared_in_retail_building(p: Person, a: Asset) kind empirical {
    label en official "the product is a food or beverage prepared in the same building as a retail establishment in which it is sold (section 168(n)(2)(F))";
}
pub relation qpp_qualified_product(p: Person, a: Asset) kind institutional {
    label en official "the product of the activity is a qualified product (section 168(n)(2)(F))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the term ‘qualified product’ means any tangible personal property if such property is not a food or beverage prepared in the same building as a retail establishment in which such property is sold.")
rule QppQualifiedProduct(p: Person, a: Asset) strict {
    label en official "tangible personal property that is not a food or beverage prepared in the same building as a retail establishment in which it is sold";
    when qpp_product_is_tangible_personal_property(p, a);
    when not_known(qpp_product_is_food_or_beverage_prepared_in_retail_building(p, a));
    then qpp_qualified_product(p, a);
}
pub relation qpp_qualified_production_activity(p: Person, a: Asset) kind institutional {
    label en official "the use is a qualified production activity: manufacturing, production or refining of a qualified product with a substantial transformation; production means only agricultural and chemical production (section 168(n)(2)(D),(E))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the term ‘qualified production activity’ means the manufacturing, production, or refining of a qualified product.")
rule QppActivityManufacturing(p: Person, a: Asset) strict {
    label en official "manufacturing of a qualified product with a substantial transformation";
    when qpp_activity_kind_of_use(p, a, Manufacturing);
    when qpp_qualified_product(p, a);
    when qpp_activity_results_in_substantial_transformation(p, a);
    then qpp_qualified_production_activity(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the term ‘qualified production activity’ means the manufacturing, production, or refining of a qualified product.")
rule QppActivityRefining(p: Person, a: Asset) strict {
    label en official "refining of a qualified product with a substantial transformation";
    when qpp_activity_kind_of_use(p, a, Refining);
    when qpp_qualified_product(p, a);
    when qpp_activity_results_in_substantial_transformation(p, a);
    then qpp_qualified_production_activity(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "The term ‘production’ shall not include activities other than agricultural production and chemical production.")
rule QppActivityAgriculturalProduction(p: Person, a: Asset) strict {
    label en official "agricultural production of a qualified product with a substantial transformation";
    when qpp_activity_kind_of_use(p, a, AgriculturalProduction);
    when qpp_qualified_product(p, a);
    when qpp_activity_results_in_substantial_transformation(p, a);
    then qpp_qualified_production_activity(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "The term ‘production’ shall not include activities other than agricultural production and chemical production.")
rule QppActivityChemicalProduction(p: Person, a: Asset) strict {
    label en official "chemical production of a qualified product with a substantial transformation";
    when qpp_activity_kind_of_use(p, a, ChemicalProduction);
    when qpp_qualified_product(p, a);
    when qpp_activity_results_in_substantial_transformation(p, a);
    then qpp_qualified_production_activity(p, a);
}

// --- (n)(2)(A): the clauses ---------------------------------------------------------------------------------------------------------------------------------------

pub relation qpp_is_nonresidential_real_property_to_which_168_applies(p: Person, a: Asset) kind empirical {
    label en official "the property is nonresidential real property to which section 168 applies (section 168(n)(2)(A)(i))";
}
pub relation qpp_used_by_taxpayer_as_integral_part_of_activity(p: Person, a: Asset) kind empirical {
    label en official "the property is used by the taxpayer as an integral part of a qualified production activity (section 168(n)(2)(A)(ii))";
}
pub relation qpp_taxpayer_is_lessor_of_property(p: Person, a: Asset) kind empirical {
    label en official "the taxpayer is a lessor of the property (section 168(n)(2)(A) last sentence)";
}
pub relation qpp_used_as_integral_part_of_qualified_activity(p: Person, a: Asset) kind institutional {
    label en official "clause (ii) is met: the taxpayer itself uses the property as an integral part of a qualified production activity; a lessee's use does not count for a lessor (section 168(n)(2)(A)(ii) and last sentence)";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "For purposes of clause (ii), in the case of property with respect to which the taxpayer is a lessor, property used by a lessee shall not be considered to be used by the taxpayer as part of a qualified production activity.")
rule QppUsedAsIntegralPart(p: Person, a: Asset) strict {
    label en official "the use by the taxpayer, not by a lessee";
    when qpp_used_by_taxpayer_as_integral_part_of_activity(p, a);
    when qpp_qualified_production_activity(p, a);
    when not_known(qpp_taxpayer_is_lessor_of_property(p, a));
    then qpp_used_as_integral_part_of_qualified_activity(p, a);
}
pub relation qpp_placed_in_service_in_united_states_or_possession(p: Person, a: Asset) kind empirical {
    label en official "the property is placed in service in the United States or any possession of the United States (section 168(n)(2)(A)(iii))";
}
pub relation qpp_original_use_commences_with_taxpayer(p: Person, a: Asset) kind institutional {
    label en official "the original use of the property commences with the taxpayer (section 168(n)(2)(A)(iv))";
}
pub relation qpp_construction_begins_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the construction of the property begins (section 168(n)(2)(A)(v))";
}
pub relation qpp_designated_in_election(p: Person, a: Asset) kind empirical {
    label en official "the property (or the portion) is designated by the taxpayer in the election made under section 168(n) (section 168(n)(2)(A)(vi))";
}
pub relation qpp_placed_in_service_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the property is placed in service (section 168(n)(2)(A)(vii), (c) effective date)";
}
pub relation secretary_extends_qpp_placed_in_service_date(p: Person, a: Asset) kind empirical {
    label en official "the Secretary extends the December 31, 2030 date because an act of God prevents the taxpayer from placing the property in service before it (section 168(n)(2)(H))";
}
pub relation qpp_construction_period_requirements_met(p: Person, a: Asset) kind institutional {
    label en official "clauses (iv) and (v) are met: original use commences with the taxpayer and construction begins after January 19, 2025 and before January 1, 2029, or the (B) special rule for property not previously used is met";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the construction of which begins after January 19, 2025, and before January 1, 2029,")
rule QppConstructionPeriodOriginalUse(p: Person, a: Asset, begins: Date) strict {
    label en official "original use with the taxpayer and construction begun in the period";
    when qpp_original_use_commences_with_taxpayer(p, a);
    when qpp_construction_begins_on(p, a, begins);
    when begins > @2025-01-19;
    when begins < @2029-01-01;
    then qpp_construction_period_requirements_met(p, a);
}

// --- (n)(2)(B): property not previously used in qualified production activities ------------------------------------------------------------

pub relation qpp_acquired_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the taxpayer acquired the property (section 168(n)(2)(B)(i))";
}
pub relation qpp_written_binding_contract_entered_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date a written binding contract for the acquisition was entered into (section 168(n)(2)(B)(ii))";
}
pub relation qpp_not_used_in_qualified_activity_by_any_person_2021_to_may_2025(p: Person, a: Asset) kind empirical {
    label en official "the property was not used in a qualified production activity by any person at any time from January 1, 2021 through May 12, 2025 (section 168(n)(2)(B)(i)(I))";
}
pub relation qpp_not_used_by_taxpayer_before_acquisition(p: Person, a: Asset) kind empirical {
    label en official "the property was not used by the taxpayer at any time prior to the acquisition (section 168(n)(2)(B)(i)(II))";
}
pub relation qpp_contract_places_acquisition_outside_period(p: Person, a: Asset) kind institutional {
    label en official "a written binding contract fixes the acquisition date outside the period: on or before January 19, 2025, or after December 31, 2028 (section 168(n)(2)(B)(ii))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "such property shall be treated as acquired not later than the date on which the taxpayer enters into a written binding contract for such acquisition")
rule QppContractBeforePeriod(p: Person, a: Asset, on: Date) strict {
    label en official "a contract entered into on or before January 19, 2025: treated as acquired before the period";
    when qpp_written_binding_contract_entered_on(p, a, on);
    when on <= @2025-01-19;
    then qpp_contract_places_acquisition_outside_period(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "such property shall be treated as acquired not earlier than such date.")
rule QppContractAfterPeriod(p: Person, a: Asset, on: Date) strict {
    label en official "a contract entered into after 2028: treated as acquired after the period";
    when qpp_written_binding_contract_entered_on(p, a, on);
    when on >= @2029-01-01;
    then qpp_contract_places_acquisition_outside_period(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the requirements of clauses (iv) and (v) of subparagraph (A) shall be treated as satisfied if—")
rule QppConstructionPeriodPreviouslyUnused(p: Person, a: Asset, acquired: Date) strict {
    label en official "property acquired in the period, never used in qualified production 2021 to May 12, 2025, not used by the taxpayer before, acquired under section 179(d)";
    when qpp_acquired_on(p, a, acquired);
    when acquired > @2025-01-19;
    when acquired < @2029-01-01;
    when qpp_not_used_in_qualified_activity_by_any_person_2021_to_may_2025(p, a);
    when qpp_not_used_by_taxpayer_before_acquisition(p, a);
    when acquisition_meets_179d_2ABC_3(p, a);
    when not_known(qpp_contract_places_acquisition_outside_period(p, a));
    then qpp_construction_period_requirements_met(p, a);
}

// --- (n)(2)(A)(vii),(H): the placed-in-service date ---------------------------------------------------------------------------------------------------

pub relation qpp_placed_in_service_in_window(p: Person, a: Asset) kind institutional {
    label en official "the property is placed in service after the date of enactment (July 4, 2025) and before January 1, 2031, or within the date the Secretary extends for an act of God (section 168(n)(2)(A)(vii),(H); Pub. L. 119-21 section 70307(c))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "which is placed in service before January 1, 2031.")
rule QppPlacedInServiceInWindow(p: Person, a: Asset, on: Date) strict {
    label en official "placed in service after July 4, 2025 and before January 1, 2031";
    when qpp_placed_in_service_on(p, a, on);
    when on > @2025-07-04;
    when on < @2031-01-01;
    then qpp_placed_in_service_in_window(p, a);
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "The Secretary may extend the date under subparagraph (A)(vii)")
rule QppPlacedInServiceExtended(p: Person, a: Asset, on: Date) strict {
    label en official "a date the Secretary extended for an act of God; JUDGMENT CALL: the extended date is a fact of the case and only the enactment date is tested";
    when qpp_placed_in_service_on(p, a, on);
    when on > @2025-07-04;
    when secretary_extends_qpp_placed_in_service_date(p, a);
    then qpp_placed_in_service_in_window(p, a);
}

// --- (n)(2)(C): the excluded functions and the qualified portion ---------------------------------------------------------------------------

pub relation qpp_alternative_depreciation_system_applies(p: Person, a: Asset) kind empirical {
    label en official "the alternative depreciation system under subsection (g) applies to the property (section 168(n)(4)(B))";
}
pub relation qpp_designated_portion_adjusted_basis(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the portion of the nonresidential real property designated in the election (section 168(n)(6)(A)(i))";
}
pub relation qpp_excluded_functions_basis(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the part of the basis that is used for offices, administrative services, lodging, parking, sales activities, research activities, software development or engineering activities, or other functions unrelated to the manufacturing, production or refining of tangible personal property (section 168(n)(2)(C))";
}
pub relation qpp_property_qualified(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified production property: every clause of section 168(n)(2)(A) is met and section 168(n)(4)(B) does not exclude it";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the term ‘qualified production property’ means that portion of any nonresidential real property—")
rule QppPropertyQualified(p: Person, a: Asset) strict {
    label en official "nonresidential real property, integral use in a qualified production activity, United States, original use or the (B) rule, construction period, designated in the election, placed in service in the window, and not alternative depreciation property";
    when qpp_is_nonresidential_real_property_to_which_168_applies(p, a);
    when qpp_used_as_integral_part_of_qualified_activity(p, a);
    when qpp_placed_in_service_in_united_states_or_possession(p, a);
    when qpp_construction_period_requirements_met(p, a);
    when qpp_designated_in_election(p, a);
    when qpp_placed_in_service_in_window(p, a);
    when not_known(qpp_alternative_depreciation_system_applies(p, a));
    then qpp_property_qualified(p, a);
}
pub relation qpp_qualified_portion_basis(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the adjusted basis of the qualified production property: the designated portion less the excluded functions (section 168(n)(2)(A) 'that portion', (C))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "The term ‘qualified production property’ shall not include that portion of any nonresidential real property which is used for offices, administrative services, lodging, parking, sales activities, research activities, software development or engineering activities, or other functions unrelated to the manufacturing, production, or refining of tangible personal property.")
rule QppQualifiedPortionBasis(p: Person, a: Asset, designated: Money, excluded: Money) strict {
    label en official "the designated basis less the basis of the excluded functions, not below zero";
    when qpp_property_qualified(p, a);
    when qpp_designated_portion_adjusted_basis(p, a, designated);
    when qpp_excluded_functions_basis(p, a, excluded);
    then qpp_qualified_portion_basis(p, a, max(0.00 USD, designated - excluded));
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "For purposes of subparagraph (A)(iv), rules similar to the rules of subsection (k)(2)(E)(iii) shall apply.")
rule QppOriginalUseBySyndication(p: Person, a: Asset) strict {
    label en official "rules similar to section 168(k)(2)(E)(iii): after a qualifying syndication the purchaser at the last sale is treated as the original user (section 168(n)(2)(G))";
    when syndication_rule_applies(p, a);
    then qpp_original_use_commences_with_taxpayer(p, a);
}
pub relation qpp_is_section_1245_property(p: Person, a: Asset) kind institutional {
    label en official "qualified production property is section 1245 property (section 1245(a)(3)(G), added by Pub. L. 119-21 section 70307(b))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "(G) any qualified production property (as defined in section 168(n)(2)).")
rule QppIsSection1245Property(p: Person, a: Asset) strict {
    label en official "qualified production property is section 1245 property";
    when qpp_property_qualified(p, a);
    then qpp_is_section_1245_property(p, a);
}

// --- (n)(1): the allowance ---------------------------------------------------------------------------------------------------------------------------------------

pub relation elects_168n_for_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer makes the election under section 168(n) for the taxable year (section 168(n)(1),(6))";
}
pub relation qpp_placed_in_service_year(p: Person, a: Asset, y: TaxableYear) kind empirical {
    label en official "the taxable year in which the qualified production property is placed in service";
}
pub relation qpp_special_allowance(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the allowance for the taxable year in which the qualified production property is placed in service: 100 percent of its adjusted basis (section 168(n)(1)(A))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "an allowance equal to 100 percent of the adjusted basis of the qualified production property")
rule QppSpecialAllowance(p: Person, a: Asset, y: TaxableYear, basis: Money) defeasible {
    label en official "100 percent of the adjusted basis of the qualified portion for an electing taxpayer";
    when elects_168n_for_year(p, y);
    when qpp_placed_in_service_year(p, a, y);
    when qpp_qualified_portion_basis(p, a, basis);
    then qpp_special_allowance(p, a, y, basis);
}
pub relation qpp_basis_after_allowance(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted basis after the allowance, before computing the other depreciation of that and later years (section 168(n)(1)(B))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the adjusted basis of the qualified production property shall be reduced by the amount of such deduction before computing the amount otherwise allowable as a depreciation deduction under this chapter for such taxable year and any subsequent taxable year.")
rule QppBasisReduced(p: Person, a: Asset, y: TaxableYear, basis: Money, allowance: Money) defeasible {
    label en official "the basis of the qualified portion less the allowance";
    when qpp_qualified_portion_basis(p, a, basis);
    when qpp_special_allowance(p, a, y, allowance);
    then qpp_basis_after_allowance(p, a, y, basis - allowance);
}
pub relation qpp_deduction_for_amti(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 167 deduction for qualified production property in computing alternative minimum taxable income: determined without regard to any section 56 adjustment (section 168(n)(3))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "the deduction under section 167 for qualified production property shall be determined under this section without regard to any adjustment under section 56.")
rule QppDeductionForAmti(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the same allowance for the minimum tax";
    when qpp_special_allowance(p, a, y, amount);
    then qpp_deduction_for_amti(p, a, y, amount);
}
pub relation qpp_separate_class_with_deemed_elections(p: Person, a: Asset) kind institutional {
    label en official "qualified production property is a separate class of property for subsections (k)(7), (l)(3)(D) and (m)(2)(B)(iii), and the taxpayer is treated as having made an election under them for that class (section 168(n)(4)(A))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "qualified production property shall be treated as a separate class of property, and")
rule QppSeparateClass(p: Person, a: Asset) strict {
    label en official "a separate class with the deemed elections";
    when qpp_property_qualified(p, a);
    then qpp_separate_class_with_deemed_elections(p, a);
}
pub relation qpp_treated_as_separate_nonresidential_real_property_for_g7(p: Person, a: Asset) kind institutional {
    label en official "for section 168(g)(7)(A) qualified production property to which subsection (n) applies is treated as separate nonresidential real property (section 168(n)(4)(B))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "For purposes of subsection (g)(7)(A), qualified production property to which this subsection applies shall be treated as separate nonresidential real property.")
rule QppSeparateNonresidentialRealPropertyForG7(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "treated as separate nonresidential real property";
    when qpp_special_allowance(p, a, y, amount);
    then qpp_treated_as_separate_nonresidential_real_property_for_g7(p, a);
}

// --- (n)(5): recapture -----------------------------------------------------------------------------------------------------------------------------------------------

pub relation qpp_ceases_to_be_used_in_qualified_activity_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the property ceases to be used as described in paragraph (2)(A)(ii) and is used by the taxpayer in a productive use not so described (section 168(n)(5))";
}
pub relation qpp_depreciation_adjustments_taken(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the depreciation adjustments taken with respect to the property, the amount of section 1245(a)(1)(A)";
}
pub relation qpp_change_of_use_recapture_amount(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the amount recognized as ordinary income under section 1245 on the deemed disposition at the change of use within 10 years of placement in service, the (B) amount being treated as at least the (A) amount (section 168(n)(5))";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "If, at any time during the 10-year period beginning on the date that any qualified production property is placed in service by the taxpayer, such property ceases to be used as described in paragraph (2)(A)(ii)")
rule QppChangeOfUseRecapture(p: Person, a: Asset, placed: Date, changed: Date, taken: Money) strict {
    label en official "a change of use within 10 years of placement in service: section 1245 applies as if disposed of, with at least the depreciation adjustments recaptured";
    when qpp_property_qualified(p, a);
    when qpp_placed_in_service_on(p, a, placed);
    when qpp_ceases_to_be_used_in_qualified_activity_on(p, a, changed);
    when changed < add_calendar_period(placed, 10 calendar_year);
    when qpp_depreciation_adjustments_taken(p, a, taken);
    then qpp_change_of_use_recapture_amount(p, a, taken);
}

// --- (n)(6): the election ----------------------------------------------------------------------------------------------------------------------------------------------

pub relation qpp_election_specifies_property_and_portion(p: Person, y: TaxableYear, a: Asset) kind empirical {
    label en official "the election specifies the nonresidential real property and the portion designated under paragraph (2)(A)(vi) (section 168(n)(6)(A)(i))";
}
pub relation qpp_election_made_on_return_for_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the election is made on the taxpayer's return for the taxable year, unless the Secretary provides otherwise (section 168(n)(6)(A)(ii))";
}
pub relation qpp_election_valid(p: Person, y: TaxableYear, a: Asset) kind institutional {
    label en official "a valid election under section 168(n): it specifies the property and the portion and is made on the return";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "specify the nonresidential real property subject to the election and the portion of such property designated under paragraph (2)(A)(vi), and")
rule QppElectionValid(p: Person, y: TaxableYear, a: Asset) strict {
    label en official "the election specifies the property and is made on the return";
    when elects_168n_for_year(p, y);
    when qpp_election_specifies_property_and_portion(p, y, a);
    when qpp_election_made_on_return_for_year(p, y);
    then qpp_election_valid(p, y, a);
}
pub relation secretary_consents_to_revocation_of_168n_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the Secretary consents to the revocation of the election (only in extraordinary circumstances) (section 168(n)(6)(B))";
}
pub relation revokes_168n_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer revokes the election under section 168(n) or a specification in it";
}
pub relation qpp_election_revoked(p: Person, y: TaxableYear) kind institutional {
    label en official "the election under section 168(n) is revoked with the consent of the Secretary";
}
@source(us.irc.temporal::PL119_21_S70307, relation = derives_from, quote = "may not be revoked except with the consent of the Secretary (and the Secretary shall provide such consent only in extraordinary circumstances).")
rule QppElectionRevocationPower(p: Person, y: TaxableYear) defeasible {
    label en official "revocation only with the consent of the Secretary";
    when revokes_168n_election(p, y);
    then power S168nRevokeElection {
        holder p;
        over y;
        exercise revokes_168n_election(p, y);
        valid_when secretary_consents_to_revocation_of_168n_election(p, y);
        effect create(qpp_election_revoked(p, y));
        window [-infinity, infinity];
    };
}
pub relation secretary_issues_qpp_guidance(p: Person) kind empirical {
    label en official "the Secretary issues regulations or guidance on substantial transformation and on the change of use by a transferee (section 168(n)(7)); external";
}
