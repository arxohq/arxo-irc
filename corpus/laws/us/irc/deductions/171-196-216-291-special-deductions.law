// Sections 171 (amortizable bond premium), 196 (deduction for unused business
// credits), 216 (cooperative housing corporation) and 291 (corporate preference
// reductions). Stage 2. The amounts that other owners compute (yield-to-maturity
// premium schedule, section 1245/1250 recapture amounts, section 613 depletion)
// enter as asserted case facts; this module states what the sections do to them.
// Rounding: the statute names none; cents HALF_UP (corpus convention, JUDGMENT
// CALL), ratios with one rounding (docs/research/constructs/21-expressions-quantities/ item 7).

// === §171: amortizable bond premium ======================================================

use self::{
    Corporation,
    DeductionKind,
    IRC_S171_A,
    IRC_S171_B,
    IRC_S171_C,
    IRC_S196_A,
    IRC_S196_B,
    IRC_S196_D,
    IRC_S216_A,
    IRC_S216_B,
    IRC_S216_D,
    IRC_S216_E,
    IRC_S291_A,
    IRC_S291_B,
    IRC_S291_E,
    Person,
    TaxableYear,
    amortizable_bond_premium_of_year,
    bond_premium_offset_applies_171e,
    deduction_allowed,
    taxpayer_is_real_estate_investment_trust_291,
};

pub relation bond_basis_for_loss_171(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the taxpayer's basis for determining loss on sale or exchange of the bond (section 171(b)(1)(A))";
}
pub relation bond_acquired_in_exchange_with_carryover_basis(p: Person, bond: Integer) kind empirical {
    label en official "the bond was acquired in exchange for other property and its basis is determined in whole or in part by reference to the basis of that property (section 171(b)(4)(A))";
}
pub relation bond_exchange_part_of_reorganization_368(p: Person, bond: Integer) kind empirical {
    label en official "the exchange of the bond for another bond is part of a reorganization within section 368 (section 171(b)(4)(B))";
}
pub relation bond_fair_market_value_after_exchange(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the fair market value of the bond immediately after the exchange (asserted or adjudicated fact, DECISION-0194)";
}
pub relation bond_amount_payable_at_maturity(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the amount payable on maturity (section 171(b)(1)(B))";
}
pub relation bond_premium_attributable_to_conversion_feature(p: Person, bond: Integer, amount: Money) kind empirical {
    label en official "the part of the bond premium of a convertible bond attributable to the conversion feature, which is never bond premium (section 171(b)(1) last sentence)";
}
pub relation bond_interest_excludable_from_gross_income(p: Person, bond: Integer) kind empirical {
    label en official "the interest on the bond is excludable from gross income (section 171(a)(2))";
}
pub relation bond_is_stock_in_trade_inventory_or_held_for_sale(p: Person, bond: Integer) kind empirical {
    label en official "the obligation constitutes stock in trade, is of a kind properly included in inventory, or is held primarily for sale to customers in the ordinary course of business, so it is not a 'bond' (section 171(d))";
}
pub relation bond_premium_attributable_to_year(p: Person, y: TaxableYear, bond: Integer, amount: Money) kind empirical {
    label en official "the amount of bond premium attributable to the taxable year determined on the yield to maturity basis compounded at the close of each accrual period (section 171(b)(2),(3)); the constant-yield schedule is a multi-year computation (TECH_GAPS G2708) and is asserted";
}
pub relation makes_section_171c_election(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, in accordance with regulations, that section 171 applies to its taxable bonds (section 171(c))";
}
pub relation bond_premium_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 171(c) election is in effect: it applies to all taxable bonds held at the beginning of the first year and thereafter acquired, and binds all subsequent years unless the Secretary permits revocation";
}
@source(IRC_S171_C, quote = "this section shall apply only if the taxpayer has so elected")
rule BondPremiumElectionPowerRule(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer holding taxable bonds has the power to elect that section 171 applies, binding for all subsequent taxable years (section 171(c))";
    when makes_section_171c_election(p, y);
    then power BondPremiumAmortizationElection {
        holder p;
        over y;
        exercise makes_section_171c_election(p, y);
        valid_when makes_section_171c_election(p, y);
        effect create(bond_premium_election_in_effect(p, y));
        window [@1954-01-01, infinity);
    };
}

pub relation bond_basis_for_premium_171b(p: Person, bond: Integer, amount: Money) kind institutional {
    label en official "the basis taken into account in determining bond premium: the loss basis, capped at fair market value immediately after an exchange with carryover basis, except for a reorganization exchange (section 171(b)(1)(A),(4))";
}
@source(IRC_S171_B, quote = "the basis of such bond shall not exceed its fair market value immediately after the exchange")
rule BondBasisCappedAtFairMarketValueAfterExchange(p: Person, bond: Integer, basis: Money, fmv: Money) strict {
    label en official "for a bond acquired in an exchange with carryover basis, the basis for premium purposes does not exceed its fair market value immediately after the exchange (section 171(b)(4)(A))";
    when bond_basis_for_loss_171(p, bond, basis);
    when bond_acquired_in_exchange_with_carryover_basis(p, bond);
    when not_known(bond_exchange_part_of_reorganization_368(p, bond));
    when bond_fair_market_value_after_exchange(p, bond, fmv);
    then bond_basis_for_premium_171b(p, bond, min(basis, fmv));
}
@source(IRC_S171_B, quote = "with reference to the amount of the basis (for determining loss on sale or exchange) of such bond,")
rule BondBasisOrdinary(p: Person, bond: Integer, basis: Money) strict {
    label en official "otherwise the loss basis of the bond is the basis for bond premium (section 171(b)(1)(A))";
    when bond_basis_for_loss_171(p, bond, basis);
    when not_known(bond_acquired_in_exchange_with_carryover_basis(p, bond));
    then bond_basis_for_premium_171b(p, bond, basis);
}
@source(IRC_S171_B, quote = "Subparagraph (A) shall not apply to an exchange by the taxpayer of a bond for another bond if such exchange is a part of a reorganization")
rule BondBasisReorganizationExchange(p: Person, bond: Integer, basis: Money) strict {
    label en official "in a reorganization exchange of a bond for another bond the basis is not capped (section 171(b)(4)(B))";
    when bond_basis_for_loss_171(p, bond, basis);
    when bond_acquired_in_exchange_with_carryover_basis(p, bond);
    when bond_exchange_part_of_reorganization_368(p, bond);
    then bond_basis_for_premium_171b(p, bond, basis);
}
pub relation bond_premium_total_171b(p: Person, bond: Integer, amount: Money) kind institutional {
    label en official "the amount of bond premium: basis in excess of the amount payable on maturity, excluding any amount attributable to conversion features (section 171(b)(1)); the earlier-call-date comparison is not modelled (TECH_GAPS G2708)";
}
@source(IRC_S171_B, quote = "In no case shall the amount of bond premium on a convertible bond include any amount attributable to the conversion features of the bond.")
rule BondPremiumTotalRule(p: Person, bond: Integer, basis: Money, maturity: Money, conversion: Money) strict {
    label en official "bond premium is the excess of basis over the amount payable at maturity, less the part attributable to conversion features, not below zero (section 171(b)(1))";
    when bond_basis_for_premium_171b(p, bond, basis);
    when bond_amount_payable_at_maturity(p, bond, maturity);
    when bond_premium_attributable_to_conversion_feature(p, bond, conversion);
    then bond_premium_total_171b(p, bond, max(0.00 USD, basis - maturity - conversion));
}

@source(IRC_S171_A, quote = "the amount of the amortizable bond premium for the taxable year shall be allowed as a deduction")
rule AmortizableBondPremiumTaxableBondDeduction(p: Person, y: TaxableYear, bond: Integer, amount: Money) defeasible {
    label en official "the amortizable bond premium of a taxable bond is deductible for the year, where the section 171(c) election is in effect (section 171(a)(1),(c)(1))";
    when amortizable_bond_premium_of_year(p, y, bond, amount);
    when bond_premium_election_in_effect(p, y);
    when not_known(bond_interest_excludable_from_gross_income(p, bond));
    when not_known(bond_is_stock_in_trade_inventory_or_held_for_sale(p, bond));
    when not_known(bond_premium_offset_applies_171e(p, bond));
    then deduction_allowed(p, y, Section171BondPremium, amount);
}
@source(IRC_S171_A, quote = "no deduction shall be allowed for the amortizable bond premium for the taxable year")
rule AmortizableBondPremiumTaxExemptBondNoDeduction(p: Person, y: TaxableYear, bond: Integer, amount: Money) strict {
    label en official "no deduction for bond premium on a bond whose interest is excludable from gross income; the premium still reduces basis under section 1016(a)(5) (section 171(a)(2),(3))";
    when bond_premium_attributable_to_year(p, y, bond, amount);
    when bond_interest_excludable_from_gross_income(p, bond);
    then not deduction_allowed(p, y, Section171BondPremium, amount);
}

// === §196: deduction for certain unused business credits =================================

pub enum QualifiedBusinessCreditKind {
    InvestmentCreditOther;
    RehabilitationCredit;
    WorkOpportunityCredit;
    AlcoholFuelsCredit;
    ResearchCredit;
    EnhancedOilRecoveryCredit;
    EmpowermentZoneEmploymentCredit;
    IndianEmploymentCredit;
    EmployerSocialSecurityCredit;
    NewMarketsTaxCredit;
    SmallEmployerPensionStartupCredit;
    BiodieselFuelsCredit;
    LowSulfurDieselCredit;
    NewEnergyEfficientHomeCredit;
    SmallEmployerHealthInsuranceCredit;
}
pub relation qualified_business_credit_not_allowed_after_38c(p: Person, credit_year: TaxableYear, kind: QualifiedBusinessCreditKind, amount: Money) kind empirical {
    label en official "the part of the qualified business credit determined for the credit year that has not, after the application of section 38(c), been allowed as a credit under section 38 for any taxable year (section 196(a)); for the investment credit only to the extent attributable to property whose basis is reduced by section 50(c) (section 196(c)(1)); the research credit excludes the section 280C(c)(3) credit (section 196(c)(4))";
}
pub relation first_taxable_year_after_last_carryover_year(p: Person, credit_year: TaxableYear, y: TaxableYear) kind empirical {
    label en official "the first taxable year following the last taxable year for which the credit could, under section 39, have been allowed as a credit (calendar arithmetic over the carryover period is a term gap, TECH_GAPS G2709)";
}
pub relation taxpayer_dies_or_ceases_to_exist_in_year(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer dies or ceases to exist in the taxable year, before the first taxable year following the last carryover year (section 196(b))";
}
pub relation unused_credit_deduction_196(p: Person, y: TaxableYear, credit_year: TaxableYear, amount: Money) kind institutional {
    label en official "the section 196 deduction for the unused credit of the credit year, allowed in year y";
}
@source(IRC_S196_A, quote = "an amount equal to the credit not so allowed shall be allowed to the taxpayer as a deduction for the first taxable year following the last taxable year for which such credit could, under section 39, have been allowed as a credit")
rule UnusedBusinessCreditDeductionFullAmount(p: Person, y: TaxableYear, credit_year: TaxableYear, kind: QualifiedBusinessCreditKind, amount: Money) strict {
    label en official "the credit not allowed is deducted in the first year after the last carryover year; for the investment credit other than the rehabilitation credit only 50 percent is deducted (section 196(a),(d)), which is the next rule";
    when qualified_business_credit_not_allowed_after_38c(p, credit_year, kind, amount);
    when first_taxable_year_after_last_carryover_year(p, credit_year, y);
    when kind != InvestmentCreditOther;
    when not_known(taxpayer_dies_or_ceases_to_exist_in_year(p, y));
    then unused_credit_deduction_196(p, y, credit_year, amount);
}
@source(IRC_S196_D, quote = "Subsection (a) shall be applied by substituting \"an amount equal to 50 percent of\" for \"an amount equal to\" in the case of the investment credit determined under section 46 (other than the rehabilitation credit).")
rule UnusedInvestmentCreditDeductionFiftyPercent(p: Person, y: TaxableYear, credit_year: TaxableYear, amount: Money) strict {
    label en official "for the investment credit other than the rehabilitation credit, 50 percent of the unused credit is deducted (section 196(d))";
    when qualified_business_credit_not_allowed_after_38c(p, credit_year, InvestmentCreditOther, amount);
    when first_taxable_year_after_last_carryover_year(p, credit_year, y);
    when not_known(taxpayer_dies_or_ceases_to_exist_in_year(p, y));
    then unused_credit_deduction_196(p, y, credit_year, round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S196_B, quote = "shall, under regulations prescribed by the Secretary, be allowed to the taxpayer as a deduction for the taxable year in which such death or cessation occurs")
rule UnusedBusinessCreditDeductionOnDeathOrCessation(p: Person, y: TaxableYear, credit_year: TaxableYear, kind: QualifiedBusinessCreditKind, amount: Money) strict {
    label en official "if the taxpayer dies or ceases to exist before the deduction year, the amount is deducted in the year of death or cessation (section 196(b)); the 50-percent rule of (d) for the investment credit applies to it through the amount asserted (TECH_GAPS G2709)";
    when qualified_business_credit_not_allowed_after_38c(p, credit_year, kind, amount);
    when taxpayer_dies_or_ceases_to_exist_in_year(p, y);
    when kind != InvestmentCreditOther;
    then unused_credit_deduction_196(p, y, credit_year, amount);
}
@source(IRC_S196_A, quote = "an amount equal to the credit not so allowed shall be allowed to the taxpayer as a deduction")
rule UnusedBusinessCreditDeductionAllowed(p: Person, y: TaxableYear, credit_year: TaxableYear, amount: Money) strict {
    label en official "the section 196 amount is an allowed deduction";
    when unused_credit_deduction_196(p, y, credit_year, amount);
    then deduction_allowed(p, y, Section196UnusedBusinessCredits, amount);
}

// === §216: tenant-stockholder in a cooperative housing corporation =======================

pub relation corporation_has_one_class_of_stock_and_occupancy_rights(corp: Integer, y: TaxableYear) kind institutional {
    label en official "the corporation has one and only one class of stock outstanding, each stockholder is entitled solely by reason of stock ownership to occupy a house or apartment, and no stockholder may receive a distribution not out of earnings and profits except on liquidation (section 216(b)(1)(A)-(C))";
}
pub relation cooperative_gross_income_80_percent_from_tenant_stockholders(corp: Integer, y: TaxableYear) kind empirical {
    label en official "80 percent or more of the corporation's gross income for the year is derived from tenant-stockholders (section 216(b)(1)(D)(i))";
}
pub relation cooperative_square_footage_80_percent_residential(corp: Integer, y: TaxableYear) kind empirical {
    label en official "at all times during the year 80 percent or more of the total square footage is used or available for residential or ancillary purposes of tenant-stockholders (section 216(b)(1)(D)(ii))";
}
pub relation cooperative_expenditures_90_percent_for_tenant_stockholders(corp: Integer, y: TaxableYear) kind empirical {
    label en official "90 percent or more of the corporation's expenditures for the year are for the acquisition, construction, management, maintenance or care of the property for the benefit of tenant-stockholders (section 216(b)(1)(D)(iii))";
}
pub relation cooperative_housing_corporation(corp: Integer, y: TaxableYear) kind institutional {
    label en official "the corporation is a cooperative housing corporation for the taxable year (section 216(b)(1))";
}
@source(IRC_S216_B, quote = "(i) 80 percent or more of the corporation's gross income for such taxable year is derived from tenant-stockholders.")
rule CooperativeHousingCorporationGrossIncomeTest(corp: Integer, y: TaxableYear) strict {
    label en official "a corporation with one class of stock and occupancy rights that meets the 80-percent gross income requirement is a cooperative housing corporation (section 216(b)(1)(A)-(D)(i))";
    when corporation_has_one_class_of_stock_and_occupancy_rights(corp, y);
    when cooperative_gross_income_80_percent_from_tenant_stockholders(corp, y);
    then cooperative_housing_corporation(corp, y);
}
@source(IRC_S216_B, quote = "(ii) At all times during such taxable year, 80 percent or more of the total square footage")
rule CooperativeHousingCorporationSquareFootageTest(corp: Integer, y: TaxableYear) strict {
    label en official "the 80-percent square footage requirement alternatively satisfies section 216(b)(1)(D)";
    when corporation_has_one_class_of_stock_and_occupancy_rights(corp, y);
    when cooperative_square_footage_80_percent_residential(corp, y);
    then cooperative_housing_corporation(corp, y);
}
@source(IRC_S216_B, quote = "(iii) 90 percent or more of the expenditures of the corporation paid or incurred during such taxable year")
rule CooperativeHousingCorporationExpenditureTest(corp: Integer, y: TaxableYear) strict {
    label en official "the 90-percent expenditure requirement alternatively satisfies section 216(b)(1)(D)";
    when corporation_has_one_class_of_stock_and_occupancy_rights(corp, y);
    when cooperative_expenditures_90_percent_for_tenant_stockholders(corp, y);
    then cooperative_housing_corporation(corp, y);
}
pub relation stockholder_of_cooperative_housing_corporation(p: Person, y: TaxableYear, corp: Integer) kind empirical {
    label en official "the person is a stockholder in the corporation";
}
external judgment relation stock_paid_up_in_reasonable_relationship_shown_to_secretary(p: Person, y: TaxableYear, corp: Integer) {
    authority Secretary;
    label en official "the stock is fully paid-up in an amount not less than an amount shown to the satisfaction of the Secretary as bearing a reasonable relationship to the value of the equity attributable to the unit the person may occupy (section 216(b)(2))";
}
pub relation tenant_stockholder(p: Person, y: TaxableYear, corp: Integer) kind institutional {
    label en official "the person is a tenant-stockholder of the cooperative housing corporation (section 216(b)(2))";
}
@source(IRC_S216_B, quote = "The term \"tenant-stockholder\" means a person who is a stockholder in a cooperative housing corporation")
rule TenantStockholderRule(p: Person, y: TaxableYear, corp: Integer) strict {
    label en official "a stockholder of a cooperative housing corporation whose stock is paid up to the extent the Secretary is satisfied is a tenant-stockholder (section 216(b)(2))";
    when stockholder_of_cooperative_housing_corporation(p, y, corp);
    when cooperative_housing_corporation(corp, y);
    when stock_paid_up_in_reasonable_relationship_shown_to_secretary(p, y, corp);
    then tenant_stockholder(p, y, corp);
}
pub relation shares_owned_by_stockholder(p: Person, y: TaxableYear, corp: Integer, shares: Integer) kind empirical {
    label en official "the number of shares of the cooperative housing corporation owned by the tenant-stockholder";
}
pub relation total_shares_outstanding_including_treasury(corp: Integer, y: TaxableYear, shares: Integer) kind empirical {
    label en official "the total outstanding stock of the corporation, including any stock held by the corporation, with stock owned by governmental units and leased apartments disregarded only in testing the section 216(b)(1) status (section 216(b)(3)(A),(4))";
}
pub relation corporation_real_estate_taxes_deductible_216a1(corp: Integer, y: TaxableYear, amount: Money) kind empirical {
    label en official "the real estate taxes allowable as a deduction to the corporation under section 164 on the houses or apartment building and the land (section 216(a)(1))";
}
pub relation corporation_qualifying_interest_216a2(corp: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest allowable as a deduction to the corporation under section 163 on indebtedness contracted to acquire, construct, alter, rehabilitate or maintain the property or to acquire the land (section 216(a)(2))";
}
pub relation amounts_paid_or_accrued_to_cooperative(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind empirical {
    label en official "the amounts, not otherwise deductible, paid or accrued to the cooperative housing corporation within the taxable year (section 216(a))";
}
pub relation corporation_elects_unit_allocation_of_taxes_and_interest(corp: Integer, y: TaxableYear) kind empirical {
    label en official "the corporation elects the section 216(b)(3)(B) allocation, each dwelling unit being separately allocated taxes or interest reflecting the cost attributable to it; the election is revocable only with the Secretary's consent";
}
pub relation unit_allocated_taxes_and_interest(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind empirical {
    label en official "the taxes and interest allocated to the tenant-stockholder's unit under an election of section 216(b)(3)(B)";
}
pub relation proportionate_share_of_taxes_and_interest(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind institutional {
    label en official "the tenant-stockholder's proportionate share of the taxes and interest described in section 216(a)(1),(2)";
}
@source(IRC_S216_B, quote = "that proportion which the stock of the cooperative housing corporation owned by the tenant-stockholder is of the total outstanding stock of the corporation")
rule ProportionateShareByStock(p: Person, y: TaxableYear, corp: Integer, owned: Integer, total_shares: Integer, taxes: Money, interest: Money) strict {
    label en official "the proportionate share is the stock proportion applied to the taxes and interest, with one rounding (section 216(b)(3)(A)), unless the unit allocation election applies";
    when tenant_stockholder(p, y, corp);
    when shares_owned_by_stockholder(p, y, corp, owned);
    when total_shares_outstanding_including_treasury(corp, y, total_shares);
    when corporation_real_estate_taxes_deductible_216a1(corp, y, taxes);
    when corporation_qualifying_interest_216a2(corp, y, interest);
    when not_known(corporation_elects_unit_allocation_of_taxes_and_interest(corp, y));
    then proportionate_share_of_taxes_and_interest(p, y, corp, div_round((taxes + interest) * owned, total_shares * 1.0, 2, "HALF_UP"));
}
@source(IRC_S216_B, quote = "then the term \"tenant-stockholder's proportionate share\" means the shares determined in accordance with the allocations described in subclause (II).")
rule ProportionateShareByUnitAllocation(p: Person, y: TaxableYear, corp: Integer, allocated: Money) strict {
    label en official "where the corporation elects, the shares follow the unit allocations that reasonably reflect cost (section 216(b)(3)(B))";
    when tenant_stockholder(p, y, corp);
    when corporation_elects_unit_allocation_of_taxes_and_interest(corp, y);
    when unit_allocated_taxes_and_interest(p, y, corp, allocated);
    then proportionate_share_of_taxes_and_interest(p, y, corp, allocated);
}
@source(IRC_S216_A, quote = "there shall be allowed as a deduction amounts (not otherwise deductible) paid or accrued to a cooperative housing corporation within the taxable year, but only to the extent that such amounts represent the tenant-stockholder's proportionate share")
rule TenantStockholderDeduction(p: Person, y: TaxableYear, corp: Integer, paid: Money, share: Money) strict {
    label en official "the tenant-stockholder deducts the amounts paid or accrued to the cooperative to the extent of the proportionate share of its taxes and interest (section 216(a))";
    when tenant_stockholder(p, y, corp);
    when amounts_paid_or_accrued_to_cooperative(p, y, corp, paid);
    when proportionate_share_of_taxes_and_interest(p, y, corp, share);
    then deduction_allowed(p, y, Section216TenantStockholder, min(paid, share));
}
pub relation payment_allocable_to_corporation_capital_expenditures(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind empirical {
    label en official "the part of the amount paid to the corporation properly allocable, under regulations, to amounts chargeable to the corporation's capital account (section 216(d))";
}
pub relation cooperative_payment_disallowed_capital_216d(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind institutional {
    label en official "the amount for which no deduction is allowed under section 216(d); the stockholder's adjusted basis in the stock increases by it";
}
@source(IRC_S216_D, quote = "No deduction shall be allowed to a stockholder in a cooperative housing corporation for any amount paid or accrued to such corporation during any taxable year (in excess of the stockholder's proportionate share")
rule CooperativePaymentCapitalDisallowance(p: Person, y: TaxableYear, corp: Integer, paid: Money, share: Money, capital: Money) strict {
    label en official "the part of a payment that exceeds the proportionate share and is allocable to the corporation's capital expenditures is disallowed, and increases stock basis (section 216(d))";
    when amounts_paid_or_accrued_to_cooperative(p, y, corp, paid);
    when proportionate_share_of_taxes_and_interest(p, y, corp, share);
    when payment_allocable_to_corporation_capital_expenditures(p, y, corp, capital);
    when paid > share;
    then cooperative_payment_disallowed_capital_216d(p, y, corp, min(paid - share, capital));
}
pub relation cooperative_stock_basis_increase_216d(p: Person, y: TaxableYear, corp: Integer, amount: Money) kind institutional {
    label en official "the increase in the stockholder's adjusted basis in the stock equal to the section 216(d) disallowance";
}
@source(IRC_S216_D, quote = "The stockholder's adjusted basis in the stock in the corporation shall be increased by the amount of such disallowance.")
rule CooperativeStockBasisIncreaseRule(p: Person, y: TaxableYear, corp: Integer, disallowed: Money) strict {
    label en official "the section 216(d) disallowance is added to the stock basis";
    when cooperative_payment_disallowed_capital_216d(p, y, corp, disallowed);
    then cooperative_stock_basis_increase_216d(p, y, corp, disallowed);
}
pub relation distribution_of_dwelling_unit_in_exchange_for_stock(p: Person, y: TaxableYear, corp: Integer) kind empirical {
    label en official "the cooperative housing corporation distributes a dwelling unit to a stockholder in exchange for the stockholder's stock and the unit is used as the stockholder's principal residence within section 121 (section 216(e))";
}
pub relation no_gain_or_loss_recognized_on_cooperative_distribution(p: Person, y: TaxableYear, corp: Integer) kind institutional {
    label en official "no gain or loss is recognized on the distribution, except as provided in regulations (section 216(e))";
}
@source(IRC_S216_E, quote = "no gain or loss shall be recognized on the distribution by a cooperative housing corporation of a dwelling unit to a stockholder")
rule CooperativeDistributionNoGainOrLoss(p: Person, y: TaxableYear, corp: Integer) strict {
    label en official "a distribution of a principal-residence unit in exchange for stock recognizes no gain or loss (section 216(e))";
    when distribution_of_dwelling_unit_in_exchange_for_stock(p, y, corp);
    when cooperative_housing_corporation(corp, y);
    then no_gain_or_loss_recognized_on_cooperative_distribution(p, y, corp);
}

// === §291: special rules relating to corporate preference items ==========================

pub relation ordinary_income_if_section_1245_property_291(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the amount that would be ordinary income on disposition of the section 1250 property if it were section 1245 property (section 291(a)(1)(A))";
}
pub relation ordinary_income_under_section_1250_291(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the amount treated as ordinary income under section 1250, determined without regard to section 291(a)(1) (section 291(a)(1)(B))";
}
pub relation section_1250_property_in_certified_pollution_control_facility_with_169_election(c: Corporation, y: TaxableYear, prop: Integer) kind empirical {
    label en official "the section 1250 property is part of a certified pollution control facility for which a section 169 election was made (section 291(c)(2))";
}
pub relation section_1250_recapture_exception_1250d(c: Corporation, y: TaxableYear, prop: Integer) kind empirical {
    label en official "section 1250(a) does not apply to the disposition by reason of section 1250(d) (section 291(a)(1) last sentence, under regulations)";
}
pub relation additional_section_1250_ordinary_income_291(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the 20 percent of the section 1245-versus-1250 excess treated as ordinary income under section 1250 (section 291(a)(1))";
}
@source(IRC_S291_A, quote = "20 percent of the excess (if any) of—")
rule Section1250CapitalGainTreatmentReduction(c: Corporation, y: TaxableYear, prop: Integer, a: Money, b: Money) strict {
    label en official "a corporation treats 20 percent of the excess of the section 1245 recapture amount over the section 1250 recapture amount as ordinary income (section 291(a)(1)); pollution control facilities under a section 169 election and dispositions outside section 1250(a) by reason of section 1250(d) are excepted (section 291(c)(2))";
    when ordinary_income_if_section_1245_property_291(c, y, prop, a);
    when ordinary_income_under_section_1250_291(c, y, prop, b);
    when a > b;
    when not_known(taxpayer_is_real_estate_investment_trust_291(c, y));
    when not_known(section_1250_property_in_certified_pollution_control_facility_with_169_election(c, y, prop));
    when not_known(section_1250_recapture_exception_1250d(c, y, prop));
    then additional_section_1250_ordinary_income_291(c, y, prop, round((a - b) * 0.20, 2, "HALF_UP"));
}
pub relation percentage_depletion_deduction_iron_ore_or_coal(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the section 613 percentage depletion deduction for the year for iron ore or coal (including lignite) determined without regard to section 291(a)(2)";
}
pub relation adjusted_basis_of_depletable_property_at_year_end(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind empirical {
    label en official "the adjusted basis of the property at the close of the year, determined without regard to the year's depletion deduction (section 291(a)(2)(B))";
}
pub relation percentage_depletion_reduced_by_291(c: Corporation, y: TaxableYear, prop: Integer, amount: Money) kind institutional {
    label en official "the section 613 deduction for iron ore or coal after the section 291(a)(2) reduction";
}
@source(IRC_S291_A, quote = "shall be reduced by 20 percent of the amount of the excess (if any) of—")
rule PercentageDepletionReduction(c: Corporation, y: TaxableYear, prop: Integer, dep: Money, basis: Money) strict {
    label en official "the deduction is reduced by 20 percent of the excess of the section 613 deduction over the adjusted basis at year end (section 291(a)(2))";
    when percentage_depletion_deduction_iron_ore_or_coal(c, y, prop, dep);
    when adjusted_basis_of_depletable_property_at_year_end(c, y, prop, basis);
    then percentage_depletion_reduced_by_291(c, y, prop, dep - round(max(0.00 USD, dep - basis) * 0.20, 2, "HALF_UP"));
}
pub relation financial_institution_preference_item_deduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the deduction with respect to a financial institution preference item, determined without regard to section 291 (section 291(a)(3))";
}
pub relation financial_institution_preference_item_deduction_after_291(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the deduction with respect to a financial institution preference item after the 20 percent reduction";
}
@source(IRC_S291_A, quote = "The amount allowable as a deduction under this chapter (determined without regard to this section) with respect to any financial institution preference item shall be reduced by 20 percent.")
rule FinancialInstitutionPreferenceItemReduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a corporation's deduction for a financial institution preference item is reduced by 20 percent (section 291(a)(3))";
    when financial_institution_preference_item_deduction(c, y, item, amount);
    then financial_institution_preference_item_deduction_after_291(c, y, item, amount - round(amount * 0.20, 2, "HALF_UP"));
}
pub relation bank_interest_on_debt_to_carry_tax_exempt_obligations_acquired_1983_1986(c: Corporation, y: TaxableYear, aggregate_interest: Money, average_basis_of_such_obligations: Money, average_basis_of_all_assets: Money) kind empirical {
    label en official "the aggregate interest deduction (without regard to sections 291 and 265(b)), the average adjusted basis of obligations acquired after December 31, 1982 and before August 8, 1986 and the average adjusted basis of all assets of a bank (section 291(e)(1)(B))";
}
pub relation financial_institution_preference_interest_291e1b(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the preference-item interest of a bank on debt incurred or continued to carry tax-exempt obligations of the 1983-1986 window, in the ratio of average basis of those obligations to average basis of all assets (section 291(e)(1)(B)(ii))";
}
@source(IRC_S291_E, quote = "the taxpayer's average adjusted basis (within the meaning of section 1016) of obligations described in clause (i), bears to")
rule FinancialInstitutionPreferenceInterestRatio(c: Corporation, y: TaxableYear, interest: Money, oblig: Money, assets: Money) strict {
    label en official "unless the taxpayer establishes otherwise, the preference interest is the interest deduction times the ratio of average basis of the 1983-1986 obligations to average basis of all assets, one rounding (section 291(e)(1)(B)(ii))";
    when bank_interest_on_debt_to_carry_tax_exempt_obligations_acquired_1983_1986(c, y, interest, oblig, assets);
    when assets > 0.00 USD;
    then financial_institution_preference_interest_291e1b(c, y, div_round(interest * (oblig / 1.00 USD), assets / 1.00 USD, 2, "HALF_UP"));
}
pub relation pollution_control_amortizable_basis_291a4(c: Corporation, y: TaxableYear, facility: Integer, amount: Money) kind empirical {
    label en official "the amortizable basis of a certified pollution control facility for which a section 169 election is made, before section 291(a)(4)";
}
pub relation pollution_control_amortizable_basis_after_291(c: Corporation, y: TaxableYear, facility: Integer, amount: Money) kind institutional {
    label en official "the amortizable basis for section 169 purposes after the 20 percent reduction; the remaining basis is recovered under section 168 (section 291(a)(4),(c)(1))";
}
@source(IRC_S291_A, quote = "the amortizable basis of such facility for purposes of such section shall be reduced by 20 percent")
rule PollutionControlBasisReduction(c: Corporation, y: TaxableYear, facility: Integer, basis: Money) strict {
    label en official "a corporation reduces the amortizable basis of a section 169 facility by 20 percent (section 291(a)(4))";
    when pollution_control_amortizable_basis_291a4(c, y, facility, basis);
    then pollution_control_amortizable_basis_after_291(c, y, facility, basis - round(basis * 0.20, 2, "HALF_UP"));
}
pub relation intangible_drilling_or_mining_cost_deduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount allowable as a deduction for the year under section 263(c) for an integrated oil company, or under section 616(a) or 617(a), determined without regard to section 291 (section 291(b)(1))";
}
pub relation intangible_drilling_deduction_after_291(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the deduction after the 30 percent reduction of section 291(b)(1)";
}
@source(IRC_S291_B, quote = "shall be reduced by 30 percent.")
rule IntangibleDrillingDeductionReduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the section 263(c) (integrated oil company), 616(a) and 617(a) deductions of a corporation are reduced by 30 percent (section 291(b)(1))";
    when intangible_drilling_or_mining_cost_deduction(c, y, item, amount);
    then intangible_drilling_deduction_after_291(c, y, item, amount - round(amount * 0.30, 2, "HALF_UP"));
}
pub relation months_of_60_month_period_in_taxable_year(c: Corporation, y: TaxableYear, item: Integer, months: Integer) kind empirical {
    label en official "the months of the 60-month period beginning with the month the costs are paid or incurred that fall within the taxable year (a month-count term gap, TECH_GAPS G2703)";
}
pub relation section_291b2_amortization_deduction(c: Corporation, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the ratable 60-month deduction of the 30 percent not allowed under section 291(b)(1)";
}
@source(IRC_S291_B, quote = "shall be allowable as a deduction ratably over the 60-month period beginning with the month in which the costs are paid or incurred")
rule IntangibleDrillingDisallowedPartAmortized(c: Corporation, y: TaxableYear, item: Integer, amount: Money, months: Integer) strict {
    label en official "the 30 percent not allowed is deducted ratably over 60 months: the reduction times months in the year over 60, one rounding (section 291(b)(2))";
    when intangible_drilling_or_mining_cost_deduction(c, y, item, amount);
    when months_of_60_month_period_in_taxable_year(c, y, item, months);
    then section_291b2_amortization_deduction(c, y, item, div_round(round(amount * 0.30, 2, "HALF_UP") * months, 60.0, 2, "HALF_UP"));
}
