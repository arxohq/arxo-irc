// Section 163 — stage 2c detail (TECH_GAPS G2781): (e)(2)(B) the daily portion of section 1272(a),
// (e)(3)(B) controlled foreign corporation and passive foreign investment company holders, (e)(5) the
// applicable high yield discount obligation (remainder deductible when paid, the dividend equivalent
// portion, earnings and profits), (f)(2),(3) registration-required obligations, (i)(2),(3) the
// significant original issue discount test and the payment assumptions, and (l)(3),(4) the tests of
// "payable in equity" and the basis increase.
//
// Stage 1 interface changes (recorded): `oid_daily_portions_for_year`,
// `instrument_has_significant_original_issue_discount`, `total_return_on_obligation`,
// `registration_required_obligation_interest`, `obligation_in_registered_form` and
// `corporate_indebtedness_payable_in_equity` are now institutional (derived below, or still asserted by a
// case); the stage 1 accrual rule of (e) and the stage 1 related-foreign-holder rule carry extra
// `not_known` guards.
//
// JUDGMENT CALLS: (1) yields are Decimal percentages (as in stage 1) and the accrual yield is the yield for the
// accrual period; the daily portion is the accrual-period original issue discount (adjusted issue price times
// the yield less the qualified stated interest) apportioned by days, and paragraph (7) of section 1272(a) and
// the de minimis rule of section 1273(a)(3) are not applied, as (e)(2)(B) directs; (2) for a controlled foreign
// corporation or passive foreign investment company holder the deduction of a year is the larger of the amount
// paid and the amount includible in a United States owner's gross income, up to the daily portion; (3) for an
// applicable high yield discount obligation the deduction of a year is the least of the daily portion, the
// amount deemed paid in the year and the remainder after the disqualified portion; (4) the "significant
// original issue discount" product of the issue price and the yield is the issue price times the yield as a
// percentage of 100; (5) amounts are rounded to cents HALF_UP.
// Not modelled: the regulations of (i)(1),(5) and (e)(3)(B)(ii) beyond a case fact, and the interplay of the dividend
// equivalent portion with the dividends-received deduction beyond the derived amount.

// === (e)(2)(B): daily portions under section 1272(a) ==============================================================

use self::{
    IRC_S163_E,
    IRC_S163_F,
    IRC_S163_I,
    IRC_S163_L,
    Person,
    TaxableYear,
    ahydo_issued_from_2008_09_01_to_2009_12_31,
    applicable_high_yield_discount_obligation,
    corporate_indebtedness_payable_in_equity,
    disqualified_portion_of_original_issue_discount,
    held_by_related_foreign_person,
    indebtedness_issued_by_dealer_payable_by_reference_to_dealer_held_equity,
    instrument_has_significant_original_issue_discount,
    instrument_yield_to_maturity,
    issuer_is_s_corporation_for_period,
    obligation_in_registered_form,
    obligation_issued_on,
    oid_daily_portions_for_year,
    oid_deduction_for_year,
    oid_effectively_connected_with_us_business_of_foreign_holder,
    oid_paid_in_year,
    original_issue_discount_on_obligation,
    registration_required_obligation_interest,
    taxable_year_begins_on,
    total_return_on_obligation,
};

pub relation oid_accrual_period_adjusted_issue_price(p: Person, instrument: Integer, ap: Integer, amount: Money) kind empirical {
    label en official "the adjusted issue price of the debt instrument at the beginning of the accrual period (section 1272(a)(3),(4))";
}
pub relation oid_accrual_period_yield_percent(p: Person, instrument: Integer, ap: Integer, pct: Decimal) kind empirical {
    label en official "the yield to maturity for the accrual period as a percentage (section 1272(a)(3)(A))";
}
pub relation oid_accrual_period_qualified_stated_interest(p: Person, instrument: Integer, ap: Integer, amount: Money) kind empirical {
    label en official "the qualified stated interest allocable to the accrual period (section 1272(a)(3)(B))";
}
pub relation oid_accrual_period_length_days(p: Person, instrument: Integer, ap: Integer, days: Integer) kind empirical {
    label en official "the number of days in the accrual period (section 1272(a)(5))";
}
pub relation oid_accrual_period_days_in_taxable_year(p: Person, y: TaxableYear, instrument: Integer, ap: Integer, days: Integer) kind empirical {
    label en official "the days of the accrual period that fall in the issuer's taxable year (section 163(e)(1))";
}
pub relation oid_accrual_period_portion_for_year(p: Person, y: TaxableYear, instrument: Integer, ap: Integer, amount: Money) kind institutional {
    label en official "the daily portions of the original issue discount for the days of the accrual period in the taxable year: the accrual-period discount apportioned by days (section 163(e)(2)(B), section 1272(a) without paragraph (7) and without section 1273(a)(3))";
}
@source(IRC_S163_E, quote = "The daily portion of the original issue discount for any day shall be determined under section 1272(a) (without regard to paragraph (7) thereof and without regard to section 1273(a)(3)).")
rule OidAccrualPeriodPortionForYear(p: Person, y: TaxableYear, instrument: Integer, ap: Integer, aip: Money, pct: Decimal, qsi: Money, length: Integer, days: Integer) strict {
    label en official "the adjusted issue price times the accrual yield, less the qualified stated interest, times the days in the year over the days in the accrual period";
    when oid_accrual_period_adjusted_issue_price(p, instrument, ap, aip);
    when oid_accrual_period_yield_percent(p, instrument, ap, pct);
    when oid_accrual_period_qualified_stated_interest(p, instrument, ap, qsi);
    when oid_accrual_period_length_days(p, instrument, ap, length);
    when oid_accrual_period_days_in_taxable_year(p, y, instrument, ap, days);
    then oid_accrual_period_portion_for_year(p, y, instrument, ap, div_round((div_round(aip * pct, 100.0, 2, "HALF_UP") - qsi) * days, length * 1.0, 2, "HALF_UP"));
}
@source(IRC_S163_E, quote = "The portion of the original issue discount with respect to any debt instrument which is allowable as a deduction to the issuer for any taxable year shall be equal to the aggregate daily portions of the original issue discount for days during such taxable year.")
rule OidDailyPortionsForYearDerived(p: Person, y: TaxableYear, instrument: Integer, a0: Integer, m0: Money) strict {
    label en official "the aggregate daily portions over the accrual periods of the year; a total asserted by a case is still accepted";
    when oid_accrual_period_portion_for_year(p, y, instrument, a0, m0);
    then oid_daily_portions_for_year(p, y, instrument, sum all amount: Money for ap: Integer where oid_accrual_period_portion_for_year(p, y, instrument, ap, amount));
}

// === (e)(3)(B): controlled foreign corporation and passive foreign investment company holders ==========================

pub relation held_by_related_cfc_or_pfic(p: Person, instrument: Integer) kind empirical {
    label en official "the related foreign holder is a controlled foreign corporation (section 957) or a passive foreign investment company (section 1297) (section 163(e)(3)(B)(i))";
}
pub relation secretary_exempts_transaction_from_cfc_pfic_limit(p: Person, instrument: Integer) kind empirical {
    label en official "the Secretary by regulation exempts the transaction from clause (i), including a transaction entered into in the ordinary course of a trade or business in which the payor is predominantly engaged (section 163(e)(3)(B)(ii))";
}
pub relation oid_includible_in_us_owner_gross_income_for_year(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind empirical {
    label en official "the original issue discount includible during the year in the gross income of a United States person who owns stock in the corporation, determined without regard to properly allocable deductions and qualified deficits under section 952(c)(1)(B) (section 163(e)(3)(B)(i))";
}
pub relation oid_cfc_pfic_limit_applies(p: Person, instrument: Integer) kind institutional {
    label en official "the special rule for controlled foreign corporation and passive foreign investment company holders applies to the instrument";
}
@source(IRC_S163_E, quote = "(i) In general")
rule OidCfcPficLimitApplies(p: Person, instrument: Integer) strict {
    label en official "a related foreign holder that is a CFC or PFIC, unless the Secretary exempts the transaction";
    when held_by_related_foreign_person(p, instrument);
    when held_by_related_cfc_or_pfic(p, instrument);
    when not_known(secretary_exempts_transaction_from_cfc_pfic_limit(p, instrument));
    when not_known(oid_effectively_connected_with_us_business_of_foreign_holder(p, instrument));
    then oid_cfc_pfic_limit_applies(p, instrument);
}
@source(IRC_S163_E, quote = "a deduction shall be allowable to the issuer with respect to such original issue discount for any taxable year before the taxable year in which paid only to the extent such original issue discount is includible")
rule OidCfcPficDeduction(p: Person, y: TaxableYear, instrument: Integer, daily: Money, paid: Money, includible: Money) strict {
    label en official "the deduction of a year is the larger of the amount paid and the amount includible in a United States owner's income, up to the daily portion";
    when oid_cfc_pfic_limit_applies(p, instrument);
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when oid_paid_in_year(p, y, instrument, paid);
    when oid_includible_in_us_owner_gross_income_for_year(p, y, instrument, includible);
    then oid_deduction_for_year(p, y, instrument, min(daily, max(paid, includible)));
}
pub relation oid_has_includible_amount_for_year(p: Person, y: TaxableYear, instrument: Integer) kind institutional {
    label en official "helper: some amount of the discount is includible in a United States owner's income in the year";
}
rule OidHasIncludibleAmountKeyed(p: Person, y: TaxableYear, instrument: Integer, amount: Money) strict {
    label en official "helper: keys the includible amount by instrument and year";
    when oid_includible_in_us_owner_gross_income_for_year(p, y, instrument, amount);
    then oid_has_includible_amount_for_year(p, y, instrument);
}
@source(IRC_S163_E, quote = "a deduction shall be allowable to the issuer with respect to such original issue discount for any taxable year before the taxable year in which paid only to the extent such original issue discount is includible")
rule OidCfcPficDeductionNothingIncludible(p: Person, y: TaxableYear, instrument: Integer, daily: Money, paid: Money) strict {
    label en official "with nothing includible the amount paid is the deduction";
    when oid_cfc_pfic_limit_applies(p, instrument);
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when oid_paid_in_year(p, y, instrument, paid);
    when not_known(oid_has_includible_amount_for_year(p, y, instrument));
    then oid_deduction_for_year(p, y, instrument, min(daily, paid));
}

// === (i)(2),(3): the significant original issue discount test and the payment assumptions ===============================

pub relation oid_test_accrual_period_after_5th_anniversary(p: Person, instrument: Integer, ap: Integer) kind empirical {
    label en official "the accrual period (section 1272(a)(5)) ends after the date 5 years after the date of issue (section 163(i)(2)(A))";
}
pub relation oid_test_aggregate_includible_before_close(p: Person, instrument: Integer, ap: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount which would be includible in gross income for periods before the close of the accrual period (section 163(i)(2)(A))";
}
pub relation oid_test_interest_to_be_paid_before_close(p: Person, instrument: Integer, ap: Integer, amount: Money) kind empirical {
    label en official "the aggregate amount of interest to be paid under the instrument before the close of the accrual period (section 163(i)(2)(B)(i))";
}
pub relation instrument_issue_price(p: Person, instrument: Integer, amount: Money) kind empirical {
    label en official "the issue price of the instrument (sections 1273(b) and 1274(a)) (section 163(i)(2)(B)(ii))";
}
@source(IRC_S163_I, quote = "(A) the aggregate amount which would be includible in gross income with respect to such instrument for periods before the close of any accrual period (as defined in section 1272(a)(5)) ending after the date 5 years after the date of issue, exceeds—")
rule SignificantOidTest(p: Person, instrument: Integer, ap: Integer, includible: Money, interest: Money, issue: Money, yield_rate: Decimal) strict {
    label en official "the aggregate includible amount exceeds the interest to be paid plus the issue price times the yield, for an accrual period ending after the fifth anniversary";
    when oid_test_accrual_period_after_5th_anniversary(p, instrument, ap);
    when oid_test_aggregate_includible_before_close(p, instrument, ap, includible);
    when oid_test_interest_to_be_paid_before_close(p, instrument, ap, interest);
    when instrument_issue_price(p, instrument, issue);
    when instrument_yield_to_maturity(p, instrument, yield_rate);
    when includible > interest + div_round(issue * yield_rate, 100.0, 2, "HALF_UP");
    then instrument_has_significant_original_issue_discount(p, instrument);
}
pub relation ahydo_payment_form_is_cash_or_property_other_than_obligation(p: Person, instrument: Integer, payment: Integer) kind empirical {
    label en official "the payment is made in cash or in property other than an obligation of the issuer or a related person (section 163(i)(3))";
}
pub relation ahydo_payment_last_day_permitted(p: Person, instrument: Integer, payment: Integer, on: Date) kind empirical {
    label en official "the last day the instrument permits the payment to be made (section 163(i)(3)(A))";
}
pub relation ahydo_payment_in_form_of_obligation_of_issuer_or_related(p: Person, instrument: Integer, payment: Integer, obligation: Integer) kind empirical {
    label en official "the payment is to be made in the form of another obligation of the issuer or of a related person within section 453(f)(1), or of stock (section 163(i)(3)(B) last sentence)";
}
pub relation obligation_required_to_be_paid_in_cash_or_property_on(obligation: Integer, on: Date) kind empirical {
    label en official "the date the obligation is required to be paid in cash or in property other than that obligation (section 163(i)(3)(B))";
}
pub relation ahydo_payment_assumed_made_on(p: Person, instrument: Integer, payment: Integer, on: Date) kind institutional {
    label en official "the date a payment is assumed to be made for testing an applicable high yield discount obligation, and for the amount and the time of payment of the original issue discount under section 163(e)(5)(A)";
}
@source(IRC_S163_I, quote = "(A) any payment under the instrument shall be assumed to be made on the last day permitted under the instrument, and")
rule AhydoPaymentAssumedOnLastPermittedDay(p: Person, instrument: Integer, payment: Integer, on: Date) strict {
    label en official "a payment in cash or property is assumed made on the last day permitted";
    when ahydo_payment_form_is_cash_or_property_other_than_obligation(p, instrument, payment);
    when ahydo_payment_last_day_permitted(p, instrument, payment, on);
    then ahydo_payment_assumed_made_on(p, instrument, payment, on);
}
@source(IRC_S163_I, quote = "(B) any payment to be made in the form of another obligation of the issuer (or a related person within the meaning of section 453(f)(1)) shall be assumed to be made when such obligation is required to be paid in cash or in property other than such obligation.")
rule AhydoPaymentInObligationAssumedWhenObligationDue(p: Person, instrument: Integer, payment: Integer, obligation: Integer, on: Date) strict {
    label en official "a payment in the form of another obligation is assumed made when that obligation is required to be paid in cash";
    when ahydo_payment_in_form_of_obligation_of_issuer_or_related(p, instrument, payment, obligation);
    when obligation_required_to_be_paid_in_cash_or_property_on(obligation, on);
    then ahydo_payment_assumed_made_on(p, instrument, payment, on);
}

// === (e)(5): the applicable high yield discount obligation ===============================================================

pub relation ahydo_deduction_deferred_until_paid(p: Person, instrument: Integer) kind institutional {
    label en official "section 163(e)(5) applies to the obligation: the disqualified portion is not deductible and the remainder is deductible when paid";
}
@source(IRC_S163_E, quote = "(D) Exception for S corporations")
rule AhydoDeductionDeferredUntilPaid(p: Person, instrument: Integer) strict {
    label en official "an applicable high yield discount obligation, not of an S corporation and not within the 2008-2009 suspension (section 163(e)(5)(D),(F))";
    when applicable_high_yield_discount_obligation(p, instrument);
    when not_known(issuer_is_s_corporation_for_period(p, instrument));
    when not_known(ahydo_issued_from_2008_09_01_to_2009_12_31(p, instrument));
    then ahydo_deduction_deferred_until_paid(p, instrument);
}
pub relation ahydo_payment_amount(p: Person, instrument: Integer, payment: Integer, amount: Money) kind empirical {
    label en official "the amount of original issue discount (and interest) paid by the payment (section 163(e)(5)(A)(ii))";
}
pub relation oid_taxable_year_end_date(y: TaxableYear, end: Date) kind empirical {
    label en official "the last day of the taxable year";
}
pub relation ahydo_paid_in_year(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind institutional {
    label en official "the original issue discount deemed paid during the year, each payment counted on the date it is assumed made (section 163(e)(5)(A) last sentence, (i)(3)(B))";
}
pub relation ahydo_payment_assumed_made_on_in_year(p: Person, y: TaxableYear, instrument: Integer, payment: Integer) kind institutional {
    label en official "helper: the payment's assumed date falls in the taxable year";
}
rule AhydoPaymentAssumedInYear(p: Person, y: TaxableYear, instrument: Integer, payment: Integer, begins: Date, ends: Date, on: Date) strict {
    label en official "helper: keys the payment by the year of its assumed date";
    when taxable_year_begins_on(y, begins);
    when oid_taxable_year_end_date(y, ends);
    when ahydo_payment_assumed_made_on(p, instrument, payment, on);
    when on >= begins;
    when on <= ends;
    then ahydo_payment_assumed_made_on_in_year(p, y, instrument, payment);
}
@source(IRC_S163_E, quote = "For purposes of this paragraph, rules similar to the rules of subsection (i)(3)(B) shall apply in determining the amount of the original issue discount and when the original issue discount is paid.")
rule AhydoPaidInYear(p: Person, y: TaxableYear, instrument: Integer, p0: Integer, a0: Money) strict {
    label en official "the sum of the payments whose assumed date falls in the year";
    when ahydo_payment_assumed_made_on_in_year(p, y, instrument, p0);
    when ahydo_payment_amount(p, instrument, p0, a0);
    then ahydo_paid_in_year(p, y, instrument, sum all amount: Money for pay: Integer where ahydo_payment_amount(p, instrument, pay, amount) and ahydo_payment_assumed_made_on_in_year(p, y, instrument, pay));
}
@source(IRC_S163_E, quote = "(ii) the remainder of such original issue discount shall not be allowable as a deduction until paid.")
rule AhydoRemainderDeductibleWhenPaid(p: Person, y: TaxableYear, instrument: Integer, daily: Money, paid: Money, oid: Money, disqualified: Money) strict {
    label en official "the least of the daily portion, the amount deemed paid and the remainder after the disqualified portion";
    when ahydo_deduction_deferred_until_paid(p, instrument);
    when oid_daily_portions_for_year(p, y, instrument, daily);
    when ahydo_paid_in_year(p, y, instrument, paid);
    when original_issue_discount_on_obligation(p, instrument, oid);
    when disqualified_portion_of_original_issue_discount(p, instrument, disqualified);
    then oid_deduction_for_year(p, y, instrument, min(min(daily, paid), max(0.00 USD, oid - disqualified)));
}
pub relation oid_qualified_stated_interest_total(p: Person, instrument: Integer, amount: Money) kind empirical {
    label en official "the interest described in the parenthetical of section 1273(a)(2) that would be included in the stated redemption price (section 163(e)(5)(C)(ii))";
}
@source(IRC_S163_E, quote = "and the term \"total return\" is the amount which would have been the original issue discount on the obligation if interest described in the parenthetical in section 1273(a)(2) were included in the stated redemption price at maturity.")
rule TotalReturnDerived(p: Person, instrument: Integer, oid: Money, interest: Money) strict {
    label en official "the original issue discount plus the interest that would be included in the stated redemption price";
    when original_issue_discount_on_obligation(p, instrument, oid);
    when oid_qualified_stated_interest_total(p, instrument, interest);
    then total_return_on_obligation(p, instrument, oid + interest);
}

// --- (e)(5)(B): the dividend equivalent portion ----------------------------------------------------------------------------------

pub relation holder_inclusion_under_1272a_for_ahydo(holder: Person, p: Person, instrument: Integer, amount: Money) kind empirical {
    label en official "the amount includible in the corporate holder's gross income under section 1272(a) in respect of the obligation (section 163(e)(5)(B)(i))";
}
pub relation issuer_earnings_and_profits_after_oid_deduction(p: Person, instrument: Integer, amount: Money) kind empirical {
    label en official "the earnings and profits of the issuer available for a dividend, as determined with the ordinary original issue discount deduction (section 163(e)(5)(B)(ii)(II),(E))";
}
pub relation ahydo_earnings_and_profits_for_dividend_equivalent(p: Person, instrument: Integer, amount: Money) kind institutional {
    label en official "the earnings and profits used to test the dividend equivalent portion: no reduction for the disqualified portion (section 163(e)(5)(E))";
}
@source(IRC_S163_E, quote = "no reduction shall be made for any amount attributable to the disqualified portion of any original issue discount on such obligation.")
rule AhydoEarningsAndProfitsForDividendEquivalent(p: Person, instrument: Integer, ep: Money, disqualified: Money) strict {
    label en official "the earnings and profits plus the disqualified portion that reduced them";
    when issuer_earnings_and_profits_after_oid_deduction(p, instrument, ep);
    when disqualified_portion_of_original_issue_discount(p, instrument, disqualified);
    then ahydo_earnings_and_profits_for_dividend_equivalent(p, instrument, ep + disqualified);
}
pub relation ahydo_earnings_and_profits_not_reduced_by_disallowance(p: Person, y: TaxableYear, instrument: Integer, amount: Money) kind institutional {
    label en official "for earnings and profits the original issue discount is deducted as accrued: paragraph (5) does not apply (section 163(e)(5)(E))";
}
@source(IRC_S163_E, quote = "This paragraph shall not apply for purposes of determining earnings and profits;")
rule AhydoEarningsAndProfitsDeductionAsAccrued(p: Person, y: TaxableYear, instrument: Integer, daily: Money) strict {
    label en official "the daily portions reduce earnings and profits when accrued";
    when ahydo_deduction_deferred_until_paid(p, instrument);
    when oid_daily_portions_for_year(p, y, instrument, daily);
    then ahydo_earnings_and_profits_not_reduced_by_disallowance(p, y, instrument, daily);
}
pub relation ahydo_dividend_equivalent_portion(holder: Person, p: Person, instrument: Integer, amount: Money) kind institutional {
    label en official "the dividend equivalent portion of the amount includible by the holder: the part attributable to the disqualified portion that would have been a dividend on stock (section 163(e)(5)(B)(ii)); treated as a dividend received solely for sections 243, 245, 246 and 246A";
}
@source(IRC_S163_E, quote = "(I) which is attributable to the disqualified portion of the original issue discount on such obligation, and")
rule AhydoDividendEquivalentPortion(holder: Person, p: Person, instrument: Integer, inclusion: Money, oid: Money, disqualified: Money, ep: Money) strict {
    label en official "the inclusion apportioned to the disqualified portion, limited to the earnings and profits";
    when holder_inclusion_under_1272a_for_ahydo(holder, p, instrument, inclusion);
    when original_issue_discount_on_obligation(p, instrument, oid);
    when disqualified_portion_of_original_issue_discount(p, instrument, disqualified);
    when ahydo_earnings_and_profits_for_dividend_equivalent(p, instrument, ep);
    when oid > 0.00 USD;
    then ahydo_dividend_equivalent_portion(holder, p, instrument, min(round(inclusion * (disqualified / oid), 2, "HALF_UP"), ep));
}

// === (f)(2),(3): registration-required obligations ============================================================================

pub relation obligation_issued_by_natural_person(item: Integer) kind empirical {
    label en official "the obligation is issued by a natural person (section 163(f)(2)(A)(i))";
}
pub relation obligation_of_type_offered_to_public(item: Integer) kind empirical {
    label en official "the obligation is of a type offered to the public (section 163(f)(2)(A)(ii))";
}
pub relation obligation_matures_on(item: Integer, on: Date) kind empirical {
    label en official "the maturity date of the obligation (section 163(f)(2)(A)(iii))";
}
pub relation obligation_type_used_frequently_to_avoid_taxes_per_regulations(item: Integer) kind empirical {
    label en official "the obligation is of a type the Secretary has determined by regulations to be used frequently in avoiding Federal taxes (section 163(f)(2)(B)(i))";
}
pub relation obligation_issued_after_regulations_effective(item: Integer) kind empirical {
    label en official "the obligation is issued after the date the regulations take effect (section 163(f)(2)(B)(ii))";
}
pub relation registration_required_obligation(item: Integer) kind institutional {
    label en official "a registration-required obligation: any obligation other than one issued by a natural person, not of a type offered to the public, or with a maturity at issue of not more than 1 year (section 163(f)(2)(A))";
}
pub relation obligation_within_a_exception_clauses_ii_iii_disabled_by_regulations(item: Integer) kind institutional {
    label en official "clauses (ii) and (iii) of subparagraph (A) do not apply to the obligation because of the regulations (section 163(f)(2)(B))";
}
@source(IRC_S163_F, quote = "Clauses (ii) and (iii) of subparagraph (A) shall not apply to any obligation if—")
rule ExceptionClausesDisabledByRegulations(item: Integer) strict {
    label en official "a type the regulations mark as used to avoid tax, issued after the regulations take effect";
    when obligation_type_used_frequently_to_avoid_taxes_per_regulations(item);
    when obligation_issued_after_regulations_effective(item);
    then obligation_within_a_exception_clauses_ii_iii_disabled_by_regulations(item);
}
pub relation obligation_excepted_from_registration(item: Integer) kind institutional {
    label en official "the obligation is within an exception of section 163(f)(2)(A)";
}
@source(IRC_S163_F, quote = "(i) is issued by a natural person,")
rule ObligationExceptedNaturalPerson(item: Integer) strict {
    label en official "issued by a natural person";
    when obligation_issued_by_natural_person(item);
    then obligation_excepted_from_registration(item);
}
@source(IRC_S163_F, quote = "(ii) is not of a type offered to the public, or")
rule ObligationExceptedNotOfferedToPublic(item: Integer, issued: Date) strict {
    label en official "not of a type offered to the public, unless the regulations disable the exception";
    when obligation_issued_on(item, issued);
    when not_known(obligation_of_type_offered_to_public(item));
    when not_known(obligation_within_a_exception_clauses_ii_iii_disabled_by_regulations(item));
    then obligation_excepted_from_registration(item);
}
@source(IRC_S163_F, quote = "(iii) has a maturity (at issue) of not more than 1 year.")
rule ObligationExceptedShortMaturity(item: Integer, issued: Date, matures: Date) strict {
    label en official "a maturity at issue of not more than 1 year, unless the regulations disable the exception";
    when obligation_issued_on(item, issued);
    when obligation_matures_on(item, matures);
    when matures <= add_calendar_period(issued, 1 calendar_year);
    when not_known(obligation_within_a_exception_clauses_ii_iii_disabled_by_regulations(item));
    then obligation_excepted_from_registration(item);
}
@source(IRC_S163_F, quote = "The term \"registration-required obligation\" means any obligation (including any obligation issued by a governmental entity) other than an obligation which—")
rule RegistrationRequiredObligation(item: Integer, issued: Date) strict {
    label en official "an obligation outside the exceptions";
    when obligation_issued_on(item, issued);
    when not_known(obligation_excepted_from_registration(item));
    then registration_required_obligation(item);
}
pub relation obligation_interest_paid_or_accrued(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid or accrued on the obligation during the year (section 163(f)(1))";
}
@source(IRC_S163_F, quote = "Nothing in subsection (a) or in any other provision of law shall be construed to provide a deduction for interest on any registration-required obligation unless such obligation is in registered form.")
rule RegistrationRequiredObligationInterestDerived(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the interest on a registration-required obligation; an amount asserted by a case is still accepted";
    when obligation_interest_paid_or_accrued(p, y, item, amount);
    when registration_required_obligation(item);
    then registration_required_obligation_interest(p, y, item, amount);
}
pub relation obligation_in_registered_form_by_law(p: Person, item: Integer) kind empirical {
    label en official "the obligation is in registered form (section 163(f)(1))";
}
pub relation obligation_in_book_entry_system_described_in_149a3(p: Person, item: Integer) kind empirical {
    label en official "the obligation is issued and transferred through a book entry system described in section 149(a)(3) (section 163(f)(3))";
}
pub relation obligation_in_dematerialized_or_secretary_specified_book_entry_system(p: Person, item: Integer) kind empirical {
    label en official "the obligation is in a dematerialized book entry system or other book entry system specified by the Secretary, treated as a system described in section 149(a)(3) (section 163(f)(3))";
}
@source(IRC_S163_F, quote = "For purposes of this subsection, rules similar to the rules of section 149(a)(3) shall apply,")
rule RegisteredFormByLaw(p: Person, item: Integer) strict {
    label en official "an obligation in registered form";
    when obligation_in_registered_form_by_law(p, item);
    then obligation_in_registered_form(p, item);
}
@source(IRC_S163_F, quote = "For purposes of this subsection, rules similar to the rules of section 149(a)(3) shall apply,")
rule RegisteredFormBookEntry(p: Person, item: Integer) strict {
    label en official "a book entry system described in section 149(a)(3)";
    when obligation_in_book_entry_system_described_in_149a3(p, item);
    then obligation_in_registered_form(p, item);
}
@source(IRC_S163_F, quote = "except that a dematerialized book entry system or other book entry system specified by the Secretary shall be treated as a book entry system described in such section.")
rule RegisteredFormDematerializedBookEntry(p: Person, item: Integer) strict {
    label en official "a dematerialized or Secretary-specified book entry system";
    when obligation_in_dematerialized_or_secretary_specified_book_entry_system(p, item);
    then obligation_in_registered_form(p, item);
}

// === (l)(3),(4): payable in equity ===================================================================================================

pub relation indebtedness_substantial_amount_payable_or_convertible_into_equity(item: Integer) kind empirical {
    label en official "a substantial amount of the principal or interest is required to be paid or converted, or at the option of the issuer or a related party is payable in or convertible into, the equity (section 163(l)(3)(A))";
}
pub relation indebtedness_substantial_amount_determined_by_reference_to_equity_value(item: Integer) kind empirical {
    label en official "a substantial amount of the principal or interest is required to be determined, or at the option of the issuer or a related party is determined, by reference to the value of the equity (section 163(l)(3)(B))";
}
pub relation indebtedness_part_of_arrangement_expected_to_result_in_a_or_b(item: Integer) kind empirical {
    label en official "the indebtedness is part of an arrangement reasonably expected to result in a transaction described in subparagraph (A) or (B) (section 163(l)(3)(C))";
}
pub relation equity_settlement_at_option_of_holder_or_related_party(item: Integer) kind empirical {
    label en official "principal or interest may be required at the option of the holder or a related party to be paid, converted or determined by reference to the equity (section 163(l)(3) last sentence)";
}
pub relation substantial_certainty_holder_option_will_be_exercised(item: Integer) kind empirical {
    label en official "there is a substantial certainty the option will be exercised (section 163(l)(3) last sentence)";
}
pub relation indebtedness_treated_as_payable_in_equity_163l3(item: Integer) kind institutional {
    label en official "the indebtedness is treated as payable in equity of the issuer or any other person (section 163(l)(3))";
}
@source(IRC_S163_L, quote = "(A) a substantial amount of the principal or interest is required to be paid or converted, or at the option of the issuer or a related party is payable in, or convertible into, such equity,")
rule PayableInEquityConversion(item: Integer) strict {
    label en official "a substantial amount is required to be paid or converted";
    when indebtedness_substantial_amount_payable_or_convertible_into_equity(item);
    then indebtedness_treated_as_payable_in_equity_163l3(item);
}
@source(IRC_S163_L, quote = "(B) a substantial amount of the principal or interest is required to be determined, or at the option of the issuer or a related party is determined, by reference to the value of such equity, or")
rule PayableInEquityReference(item: Integer) strict {
    label en official "a substantial amount is determined by reference to the value of the equity";
    when indebtedness_substantial_amount_determined_by_reference_to_equity_value(item);
    then indebtedness_treated_as_payable_in_equity_163l3(item);
}
@source(IRC_S163_L, quote = "(C) the indebtedness is part of an arrangement which is reasonably expected to result in a transaction described in subparagraph (A) or (B).")
rule PayableInEquityArrangement(item: Integer) strict {
    label en official "part of an arrangement expected to result in (A) or (B)";
    when indebtedness_part_of_arrangement_expected_to_result_in_a_or_b(item);
    then indebtedness_treated_as_payable_in_equity_163l3(item);
}
@source(IRC_S163_L, quote = "For purposes of this paragraph, principal or interest shall be treated as required to be so paid, converted, or determined if it may be required at the option of the holder or a related party and there is a substantial certainty the option will be exercised.")
rule PayableInEquityHolderOptionSubstantiallyCertain(item: Integer) strict {
    label en official "a holder's option that is substantially certain to be exercised counts as a requirement";
    when equity_settlement_at_option_of_holder_or_related_party(item);
    when substantial_certainty_holder_option_will_be_exercised(item);
    then indebtedness_treated_as_payable_in_equity_163l3(item);
}
pub relation corporate_indebtedness_interest_paid_or_accrued(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "interest paid or accrued on the indebtedness of a corporation (section 163(l)(1))";
}
@source(IRC_S163_L, quote = "For purposes of paragraph (2), indebtedness shall be treated as payable in equity of the issuer or any other person only if—")
rule CorporateIndebtednessPayableInEquityDerived(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "interest on indebtedness treated as payable in equity; an amount asserted by a case is still accepted";
    when corporate_indebtedness_interest_paid_or_accrued(p, y, item, amount);
    when indebtedness_treated_as_payable_in_equity_163l3(item);
    then corporate_indebtedness_payable_in_equity(p, y, item, amount);
}
pub relation indebtedness_payable_in_equity_held_by_issuer_in_unrelated_person(item: Integer) kind empirical {
    label en official "the instrument is payable in equity held by the issuer (or a related party) in another person that is not a related party (section 163(l)(4))";
}
pub relation equity_basis_increase_from_disallowed_interest(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the basis of the equity held by the issuer is increased by the amount not allowed as a deduction (section 163(l)(4))";
}
@source(IRC_S163_L, quote = "the basis of such equity shall be increased by the amount not allowed as a deduction by reason of paragraph (1) with respect to the instrument.")
rule EquityBasisIncreaseFromDisallowedInterest(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the disallowed interest is capitalized into the basis of the equity";
    when corporate_indebtedness_payable_in_equity(p, y, item, amount);
    when indebtedness_payable_in_equity_held_by_issuer_in_unrelated_person(item);
    when not_known(indebtedness_issued_by_dealer_payable_by_reference_to_dealer_held_equity(p, item));
    then equity_basis_increase_from_disallowed_interest(p, y, item, amount);
}
