// Section 168(k) — special (bonus) depreciation allowance. Stage 2b.
// Scope: (k)(1) the additional first-year allowance; (k)(2)(A) qualified
// property as an empirical classification (the detailed sub-definitions —
// original use, 20-year-or-less recovery period, computer software, water
// utility property, qualified film/TV/live-theatrical production — are
// TECH_GAP, same reason as section 168(e)); (k)(6) the pre-Pub. L. 119-21
// "applicable percentage" schedule by placed-in-service date; Pub. L.
// 119-21 section 70301's permanent 100 percent for property ACQUIRED after
// January 19, 2025 (a different date axis than placed-in-service — both
// are modelled as separate empirical facts); (k)(7) the election out, as a
// power. NOT done: the (k)(2)(B)/(C) longer-production-period and
// specified-plant sub-schedules, the (k)(10) transitional election to
// 40%/60% for the first taxable year ending after January 19, 2025, and
// (k)(8) phase-down for pre-2017-09-28-acquired property.

// --- (k)(2)(A): qualified property (classification, partial) ---------------

use self::{
    Asset,
    IRC_S168_K,
    Person,
    RecoveryPropertyClass,
    TaxableYear,
    bonus_2017_first_year_election_applies,
    bonus_eligible_basis,
    bonus_phase_down_applies,
    bonus_property_described_in_2B_or_2C,
    bonus_transitional_election_applies,
    placed_in_service_year,
    property_classified_as,
};

pub relation qualified_property_for_bonus_depreciation(p: Person, a: Asset) kind institutional {
    label en official "the property is qualified property under section 168(k)(2)(A) (this module takes the classification as given; the underlying sub-definitions are not derived — see TECH-GAPS G282)";
}

// --- (k)(6)/(70301): the applicable percentage ------------------------------

pub relation bonus_depreciation_property_placed_in_service_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the property was placed in service, for purposes of the section 168(k)(6) applicable-percentage schedule";
}
pub relation bonus_depreciation_property_acquired_on(p: Person, a: Asset, on: Date) kind empirical {
    label en official "the date the property was acquired, for purposes of the Pub. L. 119-21 section 70301(c) 'acquired after January 19, 2025' boundary (a written binding contract entered into on or before that date keeps the property outside the amendment under section 70301(c)(4), not modelled here)";
}

pub relation bonus_depreciation_governed_by_pl119_21_permanent_expensing(p: Person, a: Asset) kind institutional {
    label en official "the property was acquired after January 19, 2025 and so is governed by Pub. L. 119-21 section 70301's permanent 100 percent rate rather than the pre-amendment section 168(k)(6) schedule";
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "the amendments made by this section shall apply to property acquired after January 19, 2025")
rule BonusDepreciationGovernedByPl11921(p: Person, a: Asset, acquired: Date) strict {
    label en official "property acquired after January 19, 2025 is governed by the Pub. L. 119-21 section 70301 permanent 100 percent rate";
    when bonus_depreciation_property_acquired_on(p, a, acquired);
    when acquired > @2025-01-19;
    then bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
}

pub relation bonus_depreciation_applicable_percentage(p: Person, a: Asset, pct: Decimal) kind institutional {
    label en official "the applicable percentage for the section 168(k)(1) additional first-year allowance";
}
@source(us.irc.temporal::PL119_21_S70301, relation = derives_from, quote = "in paragraph (1)(A), by striking “the applicable percentage” and inserting “100 percent”")
rule BonusDepreciationPercentagePermanentHundred(p: Person, a: Asset) defeasible {
    label en official "the applicable percentage is 100 percent for property acquired after January 19, 2025 (Pub. L. 119-21 section 70301(b))";
    when bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_transitional_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 1.00);
}
@source(IRC_S168_K, quote = "in the case of property placed in service after September 27, 2017, and before January 1, 2023, 100 percent")
rule BonusDepreciationPercentagePre2023(p: Person, a: Asset, placed: Date) defeasible {
    label en official "the pre-amendment applicable percentage is 100 percent for property placed in service after September 27, 2017 and before January 1, 2023 (section 168(k)(6)(A)(i))";
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2017-09-27;
    when placed < @2023-01-01;
    unless bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_property_described_in_2B_or_2C(p, a);
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 1.00);
}
@source(IRC_S168_K, quote = "in the case of property placed in service after December 31, 2022, and before January 1, 2024, 80 percent")
rule BonusDepreciationPercentage2023(p: Person, a: Asset, placed: Date) defeasible {
    label en official "the pre-amendment applicable percentage is 80 percent for property placed in service during 2023 (section 168(k)(6)(A)(ii))";
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2022-12-31;
    when placed < @2024-01-01;
    unless bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_property_described_in_2B_or_2C(p, a);
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.80);
}
@source(IRC_S168_K, quote = "in the case of property placed in service after December 31, 2023, and before January 1, 2025, 60 percent")
rule BonusDepreciationPercentage2024(p: Person, a: Asset, placed: Date) defeasible {
    label en official "the pre-amendment applicable percentage is 60 percent for property placed in service during 2024 (section 168(k)(6)(A)(iii))";
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2023-12-31;
    when placed < @2025-01-01;
    unless bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_property_described_in_2B_or_2C(p, a);
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.60);
}
@source(IRC_S168_K, quote = "in the case of property placed in service after December 31, 2024, and before January 1, 2026, 40 percent")
rule BonusDepreciationPercentage2025(p: Person, a: Asset, placed: Date) defeasible {
    label en official "the pre-amendment applicable percentage is 40 percent for property placed in service during 2025 (section 168(k)(6)(A)(iv)); this branch only reaches property NOT governed by Pub. L. 119-21 section 70301 (acquired on or before January 19, 2025)";
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2024-12-31;
    when placed < @2026-01-01;
    unless bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_property_described_in_2B_or_2C(p, a);
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.40);
}
@source(IRC_S168_K, quote = "in the case of property placed in service after December 31, 2025, and before January 1, 2027, 20 percent")
rule BonusDepreciationPercentage2026(p: Person, a: Asset, placed: Date) defeasible {
    label en official "the pre-amendment applicable percentage is 20 percent for property placed in service during 2026 (section 168(k)(6)(A)(v))";
    when bonus_depreciation_property_placed_in_service_on(p, a, placed);
    when placed > @2025-12-31;
    when placed < @2027-01-01;
    unless bonus_depreciation_governed_by_pl119_21_permanent_expensing(p, a);
    unless bonus_property_described_in_2B_or_2C(p, a);
    unless bonus_phase_down_applies(p, a);
    unless bonus_2017_first_year_election_applies(p, a);
    then bonus_depreciation_applicable_percentage(p, a, 0.20);
}

// --- (k)(7): election out, as a power ---------------------------------------

pub relation elects_out_of_bonus_depreciation(p: Person, class: RecoveryPropertyClass, y: TaxableYear) kind empirical {
    label en official "the taxpayer's election, for a class of property and a taxable year, out of the section 168(k) additional first-year depreciation (section 168(k)(7))";
}
pub relation bonus_depreciation_election_out_in_effect(p: Person, class: RecoveryPropertyClass, y: TaxableYear) kind institutional {
    label en official "the section 168(k)(7) election out is in effect for the class and taxable year";
}
@source(IRC_S168_K, quote = "If a taxpayer makes an election under this paragraph with respect to any class of property for any taxable year, paragraphs (1) and (2)(F) shall not apply to any qualified property in such class placed in service during such taxable year")
rule BonusDepreciationElectionOutPower(p: Person, class: RecoveryPropertyClass, y: TaxableYear) strict {
    label en official "a taxpayer has the power to elect out of bonus depreciation for a class of property for a taxable year (section 168(k)(7))";
    when elects_out_of_bonus_depreciation(p, class, y);
    then power BonusDepreciationElectionOutPowerExercise {
        holder p;
        over class;
        exercise elects_out_of_bonus_depreciation(p, class, y);
        valid_when elects_out_of_bonus_depreciation(p, class, y);
        effect create(bonus_depreciation_election_out_in_effect(p, class, y));
        window [@1981-01-01, infinity);
    };
}
// Revocation "only with the consent of the Secretary" is not modelled
// (no external-consent channel wired to this power) — TECH_GAP.

// --- (k)(1): the additional first-year allowance ----------------------------

pub relation bonus_depreciation_tentative_amount(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional first-year allowance computed from the applicable percentage and the adjusted basis, before the section 168(k)(7) election out (intermediate value)";
}
@source(IRC_S168_K, quote = "the depreciation deduction provided by section 167(a) for the taxable year in which such property is placed in service shall include an allowance equal to the applicable percentage of the adjusted basis of the qualified property")
rule BonusDepreciationTentativeAmountComputation(p: Person, a: Asset, y: TaxableYear, basis: Money, pct: Decimal) defeasible {
    label en official "the additional first-year allowance equals the applicable percentage of the qualified property's adjusted basis, before the section 168(k)(7) election out (section 168(k)(1)(A))";
    when qualified_property_for_bonus_depreciation(p, a);
    when placed_in_service_year(p, a, y);
    when bonus_eligible_basis(p, a, y, basis);
    when bonus_depreciation_applicable_percentage(p, a, pct);
    then bonus_depreciation_tentative_amount(p, a, y, round(pct * basis, 2, "HALF_UP"));
}

// The `unless` on a computed head must bind every head variable (LDC-E4101):
// `bonus_depreciation_election_out_in_effect` is keyed by (holder, class,
// year), not by the individual asset or amount, so it is first projected
// onto exactly the final rule's head shape (p, a, y, amount).
pub relation bonus_depreciation_election_out_blocks_asset(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 168(k)(7) election out, projected onto this asset and its tentative bonus-depreciation amount for the taxable year";
}
rule ProjectElectionOutOntoAsset(p: Person, a: Asset, y: TaxableYear, amount: Money, class: RecoveryPropertyClass) defeasible {
    label en official "the class-level section 168(k)(7) election out blocks this asset's bonus depreciation for the year";
    when bonus_depreciation_tentative_amount(p, a, y, amount);
    when property_classified_as(p, a, class);
    when bonus_depreciation_election_out_in_effect(p, class, y);
    then bonus_depreciation_election_out_blocks_asset(p, a, y, amount);
}

pub relation bonus_depreciation(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the additional first-year depreciation allowance under section 168(k)(1)";
}
@source(IRC_S168_K, quote = "If a taxpayer makes an election under this paragraph with respect to any class of property for any taxable year, paragraphs (1) and (2)(F) shall not apply to any qualified property in such class placed in service during such taxable year")
rule BonusDepreciationAllowedAbsentElectionOut(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the additional first-year allowance is allowed unless the taxpayer has elected out of section 168(k) for the property's class and taxable year (section 168(k)(1),(7))";
    when bonus_depreciation_tentative_amount(p, a, y, amount);
    unless bonus_depreciation_election_out_blocks_asset(p, a, y, amount);
    then bonus_depreciation(p, a, y, amount);
}
// (k)(1)(B) — the ordinary depreciation deduction on the REMAINING adjusted
// basis (after subtracting the bonus amount) is not wired to
// `depreciation_deduction` in 168-acrs.law (that module still reads the
// full unadjusted basis) — TECH_GAP, an asset with both bonus depreciation
// AND a year-1 ordinary allowance is currently over-counted if both fire;
// see TECH-GAPS G282 and the report.
