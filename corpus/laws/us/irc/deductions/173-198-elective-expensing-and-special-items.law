// Sections 173, 175, 176, 178, 180, 181, 186, 190, 192, 193, 194, 194A, 198 —
// the small deduction and expensing sections of part VI. Stage 2. Sections 177,
// 182, 184, 185, 187, 188, 189, 191, 198A and 199 are repealed (no rule).
// Elections are `power`s whose effect is a relation `<x>_election_in_effect`;
// exact fractions use `div_round`; the statute prescribes no rounding for the
// amounts below (cents HALF_UP, JUDGMENT CALL).
// Pub. L. 119-21 section 70434 adds the qualified sound recording production to
// section 181 for productions commencing in taxable years ending after July 4,
// 2025 (a `revision`-style edition gate on the taxable-year end date).

// === §173: circulation expenditures ====================================================

use self::{
    Corporation,
    DeductionKind,
    IRC_S173_A,
    IRC_S175_A,
    IRC_S175_B,
    IRC_S175_C,
    IRC_S175_D,
    IRC_S176,
    IRC_S178_A,
    IRC_S180_A,
    IRC_S181_A,
    IRC_S181_C,
    IRC_S181_D,
    IRC_S181_E,
    IRC_S181_G,
    IRC_S186_A,
    IRC_S186_C,
    IRC_S186_D,
    IRC_S190_A,
    IRC_S190_C,
    IRC_S192_A,
    IRC_S192_B,
    IRC_S192_D,
    IRC_S193_A,
    IRC_S194A_A,
    IRC_S194A_C,
    IRC_S194_A,
    IRC_S194_B,
    IRC_S198_A,
    Person,
    TaxableYear,
    deduction_allowed,
    episode_beyond_first_44_of_series,
    fertilizer_election_revoked_180,
    section_181_election_revoked,
};

pub relation circulation_expenditure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expenditure to establish, maintain or increase the circulation of a newspaper, magazine or other periodical (section 173(a))";
}
pub relation circulation_expenditure_for_land_depreciable_property_or_acquired_circulation(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is for the purchase of land or depreciable property, or for acquiring circulation by purchasing part of another publisher's business (section 173(a) exclusions)";
}
@source(IRC_S173_A, quote = "shall be allowed as a deduction")
rule CirculationExpenditureDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "circulation expenditures are deductible notwithstanding section 263, other than expenditures for land, depreciable property or acquisition of circulation (section 173(a)); the section 59(e) election of ratable amortization is a cross reference (section 173(b))";
    when circulation_expenditure(p, y, item, amount);
    when not_known(circulation_expenditure_for_land_depreciable_property_or_acquired_circulation(p, y, item));
    then deduction_allowed(p, y, Section173Circulation, amount);
}

// === §175: soil and water conservation expenditures of farmers ===========================

pub relation soil_water_conservation_expenditure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "an expenditure by a farmer for soil or water conservation, prevention of erosion or endangered species recovery on land used in farming (section 175(a),(c)(1)); depreciable structures and amounts deductible without regard to section 175 are excluded from the definition";
}
pub relation soil_water_expenditure_inconsistent_with_plan_or_wetland_or_pivot(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is not consistent with the approved conservation or recovery plan (or a comparable State plan), or is in connection with draining or filling wetlands or preparing land for center pivot irrigation (section 175(c)(3))";
}
pub relation gross_income_derived_from_farming(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gross income derived from farming during the taxable year (section 175(b))";
}
pub relation elects_soil_water_conservation_method(p: Person) kind empirical {
    label en official "the farmer adopts the section 175 method: without consent for the first year with such expenditures, or at any time with the Secretary's consent (section 175(d))";
}
pub relation soil_water_conservation_method_in_effect(p: Person) kind institutional {
    label en official "the section 175 method is in effect; it applies to all such expenditures and is adhered to unless the Secretary approves a change (section 175(e))";
}
@source(IRC_S175_D, quote = "A taxpayer may, without the consent of the Secretary, adopt the method provided in this section for the taxpayer's first taxable year for which expenditures described in subsection (a) are paid or incurred.")
rule SoilWaterMethodAdoptionPower(p: Person) strict {
    label en official "a farmer has the power to adopt the section 175 method, without consent in the first year with expenditures and with consent at any time (section 175(d)); once adopted it binds (section 175(e))";
    when elects_soil_water_conservation_method(p);
    then power SoilWaterConservationMethodAdoption {
        holder p;
        over p;
        exercise elects_soil_water_conservation_method(p);
        valid_when elects_soil_water_conservation_method(p);
        effect create(soil_water_conservation_method_in_effect(p));
        window [@1954-01-01, infinity);
    };
}
pub relation soil_water_expenditures_with_carryover(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the qualifying expenditures of the year plus the excess of earlier years deductible in succeeding years (an asserted total: the carryover chain is a multi-year computation, TECH_GAPS G2710)";
}
pub relation soil_water_deduction_175(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 175 deduction for the year: the expenditures, limited to 25 percent of gross income from farming";
}
pub relation soil_water_excess_carried_to_succeeding_years(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the expenditures above 25 percent of farming gross income, deductible in succeeding taxable years subject to the same limit (section 175(b))";
}
@source(IRC_S175_B, quote = "The amount deductible under subsection (a) for any taxable year shall not exceed 25 percent of the gross income derived from farming during the taxable year.")
rule SoilWaterDeductionLimitedToQuarterOfFarmIncome(p: Person, y: TaxableYear, total: Money, gross: Money) strict {
    label en official "the deduction is the lesser of the expenditures (with carryover) and 25 percent of gross income from farming (section 175(a),(b))";
    when soil_water_conservation_method_in_effect(p);
    when soil_water_expenditures_with_carryover(p, y, total);
    when gross_income_derived_from_farming(p, y, gross);
    then soil_water_deduction_175(p, y, min(total, round(gross * 0.25, 2, "HALF_UP")));
}
@source(IRC_S175_B, quote = "such excess shall be deductible for succeeding taxable years")
rule SoilWaterExcessCarriedForward(p: Person, y: TaxableYear, total: Money, gross: Money) strict {
    label en official "the excess over 25 percent of farming gross income carries to succeeding years (section 175(b))";
    when soil_water_conservation_method_in_effect(p);
    when soil_water_expenditures_with_carryover(p, y, total);
    when gross_income_derived_from_farming(p, y, gross);
    when total > round(gross * 0.25, 2, "HALF_UP");
    then soil_water_excess_carried_to_succeeding_years(p, y, total - round(gross * 0.25, 2, "HALF_UP"));
}
@source(IRC_S175_A, quote = "The expenditures so treated shall be allowed as a deduction.")
rule SoilWaterDeductionAllowed(p: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "the section 175 amount is an allowed deduction";
    when soil_water_deduction_175(p, y, amount);
    then deduction_allowed(p, y, Section175SoilWater, amount);
}
@source(IRC_S175_C, quote = "subsection (a) shall not apply to any expenditures unless such expenditures are consistent with—")
rule SoilWaterExpenditureNotConsistentDenied(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no section 175 treatment for an expenditure inconsistent with the plan or in connection with wetlands or pivot irrigation preparation (section 175(c)(3))";
    when soil_water_conservation_expenditure(p, y, item, amount);
    when soil_water_expenditure_inconsistent_with_plan_or_wetland_or_pivot(p, y, item);
    then not deduction_allowed(p, y, Section175SoilWater, amount);
}

// === §176: payments for employees of certain foreign corporations ========================

pub relation payment_under_section_3121l_agreement_uncompensated(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts paid or incurred by a domestic corporation, to the extent not compensated for, under an agreement under section 3121(l) for United States citizens employed by foreign subsidiaries (section 176)";
}
pub relation reimbursement_of_section_176_deduction(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en official "a reimbursement of an amount previously allowed as a deduction under section 176";
}
pub relation section_176_reimbursement_included_in_gross_income(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reimbursement is included in gross income (section 176 last sentence)";
}
@source(IRC_S176, quote = "there shall be allowed as a deduction amounts (to the extent not compensated for) paid or incurred pursuant to an agreement entered into under section 3121(l)")
rule Section176Deduction(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "a domestic corporation deducts uncompensated payments under a section 3121(l) agreement (section 176)";
    when payment_under_section_3121l_agreement_uncompensated(c, y, amount);
    then deduction_allowed(c, y, Section176ForeignSubsidiaryEmployees, amount);
}
@source(IRC_S176, quote = "Any reimbursement of any amount previously allowed as a deduction under this section shall be included in gross income")
rule Section176ReimbursementIncluded(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "reimbursement of a section 176 deduction is gross income";
    when reimbursement_of_section_176_deduction(c, y, amount);
    then section_176_reimbursement_included_in_gross_income(c, y, amount);
}

// === §178: amortization of lease acquisition costs =========================================

pub relation lease_acquisition_cost_total(p: Person, lease: Integer, amount: Money) kind empirical {
    label en official "the cost of acquiring the lease, for the lessee's exhaustion, wear and tear, obsolescence or amortization (section 178(a))";
}
pub relation lease_acquisition_cost_attributable_to_term_remaining(p: Person, lease: Integer, amount: Money) kind empirical {
    label en official "the part of the lease acquisition cost attributable to the period of the term of the lease remaining on the date of acquisition, not counting renewal options (section 178(a),(b))";
}
pub relation lease_term_includes_renewal_options_178(p: Person, lease: Integer) kind institutional {
    label en official "for amortization purposes the lease term includes all renewal options and any other period for which the parties reasonably expect renewal (section 178(a))";
}
@source(IRC_S178_A, quote = "if less than 75 percent of such cost is attributable to the period of the term of the lease remaining on the date of its acquisition")
rule LeaseTermIncludesRenewalsBelowSeventyFivePercent(p: Person, lease: Integer, total: Money, attributable: Money) strict {
    label en official "if less than 75 percent of the acquisition cost is attributable to the remaining term, the term is treated as including renewal options (section 178(a)); the 'reasonably expect' extension is an evaluative element not modelled (TECH_GAPS G2711)";
    when lease_acquisition_cost_total(p, lease, total);
    when lease_acquisition_cost_attributable_to_term_remaining(p, lease, attributable);
    when attributable * 4 < total * 3;
    then lease_term_includes_renewal_options_178(p, lease);
}

// === §180: fertilizer and land conditioning expenditures =====================================

pub relation fertilizer_or_land_conditioning_expenditure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expenditure otherwise chargeable to capital account for fertilizer, lime, ground limestone, marl or other materials to enrich, neutralize or condition land used in farming, or for their application (section 180(a),(b))";
}
pub relation elects_fertilizer_expensing(p: Person, y: TaxableYear) kind empirical {
    label en official "the farmer elects, by the due date of the return with extensions, to treat the expenditures as expenses (section 180(c))";
}
pub relation fertilizer_expensing_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 180 election is in effect for the taxable year and may not be revoked without consent";
}
@source(IRC_S180_A, quote = "A taxpayer engaged in the business of farming may elect to treat as expenses which are not chargeable to capital account")
rule FertilizerExpensingElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a farmer has the power to elect to expense fertilizer and land conditioning costs (section 180)";
    when elects_fertilizer_expensing(p, y);
    then power FertilizerExpensingElection {
        holder p;
        over y;
        exercise elects_fertilizer_expensing(p, y);
        valid_when elects_fertilizer_expensing(p, y);
        effect create(fertilizer_expensing_election_in_effect(p, y));
        window [@1954-01-01, infinity);
    };
}
@source(IRC_S180_A, quote = "expenditures (otherwise chargeable to capital account) which are paid or incurred by him during the taxable year for the purchase or acquisition of fertilizer")
rule FertilizerExpensingDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "with the election the expenditures are deductible in the year paid or incurred (section 180(a))";
    when fertilizer_expensing_election_in_effect(p, y);
    when not_known(fertilizer_election_revoked_180(p, y));
    when fertilizer_or_land_conditioning_expenditure(p, y, item, amount);
    then deduction_allowed(p, y, Section180Fertilizer, amount);
}

// === §181: qualified film, television, live theatrical and sound recording productions ============

pub enum QualifiedProductionKind {
    FilmOrTelevision;
    LiveTheatrical;
    SoundRecording;
}
pub relation production_aggregate_cost(p: Person, y: TaxableYear, production: Integer, kind: QualifiedProductionKind, amount: Money) kind empirical {
    label en official "the aggregate cost of the production (for a sound recording, the aggregate cumulative cost of all sound recording productions in the taxable year) (section 181(a)(2))";
}
pub relation production_total_compensation(p: Person, production: Integer, amount: Money) kind empirical {
    label en official "the total compensation of the production (section 181(d)(1),(e)(1))";
}
pub relation production_qualified_compensation(p: Person, production: Integer, amount: Money) kind empirical {
    label en official "compensation for services performed in the United States by actors, production personnel, directors and producers, excluding participations and residuals (section 181(d)(3))";
}
pub relation production_is_property_described_in_168f3(p: Person, production: Integer) kind empirical {
    label en official "the film or television production is property described in section 168(f)(3) (section 181(d)(2)(A))";
}
pub relation production_requires_2257_records_or_2257h_conduct(p: Person, production: Integer) kind empirical {
    label en official "records are required under 18 U.S.C. 2257 for a performer, or the production includes conduct described in 18 U.S.C. 2257(h)(1) (section 181(d)(2)(C),(e)(2)(E))";
}
pub relation live_production_from_written_book_or_script_by_taxable_entity(p: Person, production: Integer) kind empirical {
    label en official "a live staged play (with or without music) derived from a written book or script, produced or presented by a taxable entity (section 181(e)(2)(A))";
}
pub relation live_production_venue_capacity(p: Person, production: Integer, capacity: Integer) kind empirical {
    label en official "the audience capacity of the venue, or of the majority of a series of venues (section 181(e)(2)(A))";
}
pub relation live_production_presented_ten_weeks_or_less(p: Person, production: Integer) kind empirical {
    label en official "a seasonal production produced or presented for not more than 10 weeks of the taxable year, for which the capacity limit is 6,500 (section 181(e)(2)(D)(i))";
}
pub relation sound_recording_produced_and_recorded_in_united_states(p: Person, production: Integer) kind empirical {
    label en official "a sound recording (17 U.S.C. 101) produced and recorded in the United States (section 181(f), added by Pub. L. 119-21 section 70434(e))";
}
pub relation production_commences_in_year_ending_after(p: Person, production: Integer, commencement: Date, year_end: Date) kind empirical {
    label en official "the date the production commences and the end of the taxable year in which it commences";
}
pub relation cost_significantly_incurred_in_eligible_area(p: Person, production: Integer) kind empirical {
    label en official "the aggregate cost is significantly incurred in a low-income community under section 45D or a Delta Regional Authority distressed county or isolated area of distress (section 181(a)(2)(B))";
}
pub relation qualified_production_181(p: Person, production: Integer, kind: QualifiedProductionKind) kind institutional {
    label en official "the production is a qualified film or television production, qualified live theatrical production or qualified sound recording production";
}
@source(IRC_S181_D, quote = "if 75 percent of the total compensation of the production is qualified compensation")
rule QualifiedFilmOrTelevisionProduction(p: Person, production: Integer, total: Money, qualified: Money) strict {
    label en official "a production that is section 168(f)(3) property with at least 75 percent qualified compensation is a qualified film or television production, unless section 2257 records are required (section 181(d))";
    when production_is_property_described_in_168f3(p, production);
    when production_total_compensation(p, production, total);
    when production_qualified_compensation(p, production, qualified);
    when qualified * 4 >= total * 3;
    when not_known(production_requires_2257_records_or_2257h_conduct(p, production));
    when not_known(episode_beyond_first_44_of_series(production));
    then qualified_production_181(p, production, FilmOrTelevision);
}
@source(IRC_S181_E, quote = "A production is described in this paragraph if such production is a live staged production of a play (with or without music)")
rule QualifiedLiveTheatricalProductionStandard(p: Person, production: Integer, total: Money, qualified: Money, capacity: Integer) strict {
    label en official "a live staged play from a written book or script with venue capacity of at most 3,000 and at least 75 percent qualified compensation is a qualified live theatrical production (section 181(e)(1),(2)(A))";
    when live_production_from_written_book_or_script_by_taxable_entity(p, production);
    when live_production_venue_capacity(p, production, capacity);
    when capacity <= 3000;
    when production_total_compensation(p, production, total);
    when production_qualified_compensation(p, production, qualified);
    when qualified * 4 >= total * 3;
    when not_known(production_requires_2257_records_or_2257h_conduct(p, production));
    then qualified_production_181(p, production, LiveTheatrical);
}
@source(IRC_S181_E, quote = "subparagraph (A) shall be applied by substituting \"6,500\" for \"3,000\"")
rule QualifiedLiveTheatricalProductionSeasonal(p: Person, production: Integer, total: Money, qualified: Money, capacity: Integer) strict {
    label en official "a seasonal production presented for at most 10 weeks may use a venue capacity of up to 6,500 (section 181(e)(2)(D)(i))";
    when live_production_from_written_book_or_script_by_taxable_entity(p, production);
    when live_production_presented_ten_weeks_or_less(p, production);
    when live_production_venue_capacity(p, production, capacity);
    when capacity <= 6500;
    when production_total_compensation(p, production, total);
    when production_qualified_compensation(p, production, qualified);
    when qualified * 4 >= total * 3;
    when not_known(production_requires_2257_records_or_2257h_conduct(p, production));
    then qualified_production_181(p, production, LiveTheatrical);
}
@source(us.irc.temporal::PL119_21_S70434, relation = derives_from, quote = "the term ‘qualified sound recording production’ means a sound recording (as defined in section 101 of title 17, United States Code) produced and recorded in the United States")
rule QualifiedSoundRecordingProduction(p: Person, production: Integer) strict {
    label en official "a sound recording produced and recorded in the United States is a qualified sound recording production (new section 181(f))";
    when sound_recording_produced_and_recorded_in_united_states(p, production);
    then qualified_production_181(p, production, SoundRecording);
}
pub relation section_181_dollar_limit(p: Person, production: Integer, limit: Money) kind institutional {
    label en official "the section 181(a)(2) dollar limit: $15,000,000, or $20,000,000 for productions significantly incurred in an eligible area; $150,000 for sound recordings";
}
@source(IRC_S181_A, quote = "Paragraph (1) shall not apply to so much of the aggregate cost of any qualified film or television production or any qualified live theatrical production as exceeds $15,000,000.")
rule Section181LimitStandard(p: Person, production: Integer, kind: QualifiedProductionKind) strict {
    label en official "the limit is $15,000,000 for a film, television or live theatrical production (section 181(a)(2)(A))";
    when qualified_production_181(p, production, kind);
    when kind != SoundRecording;
    when not_known(cost_significantly_incurred_in_eligible_area(p, production));
    then section_181_dollar_limit(p, production, 15000000.00 USD);
}
@source(IRC_S181_A, quote = "subparagraph (A) shall be applied by substituting \"$20,000,000\" for \"$15,000,000\".")
rule Section181LimitEligibleArea(p: Person, production: Integer, kind: QualifiedProductionKind) strict {
    label en official "the limit is $20,000,000 where the cost is significantly incurred in an eligible area (section 181(a)(2)(B))";
    when qualified_production_181(p, production, kind);
    when kind != SoundRecording;
    when cost_significantly_incurred_in_eligible_area(p, production);
    then section_181_dollar_limit(p, production, 20000000.00 USD);
}
@source(us.irc.temporal::PL119_21_S70434, relation = derives_from, quote = "as exceeds $150,000")
rule Section181LimitSoundRecording(p: Person, production: Integer) strict {
    label en official "the limit for qualified sound recording productions is $150,000 of aggregate cumulative cost in the taxable year (new section 181(a)(2)(C))";
    when qualified_production_181(p, production, SoundRecording);
    then section_181_dollar_limit(p, production, 150000.00 USD);
}
pub relation elects_section_181_expensing(p: Person, production: Integer) kind empirical {
    label en official "the taxpayer elects, by the due date with extensions of the return for the year in which costs are first incurred, to treat the cost of the production as an expense (section 181(c)(1))";
}
pub relation section_181_election_in_effect(p: Person, production: Integer) kind institutional {
    label en official "the section 181 election is in effect for the production; it may not be revoked without the Secretary's consent (section 181(c)(2)); no other depreciation or amortization is allowable (section 181(b))";
}
@source(IRC_S181_C, quote = "An election under this section with respect to any qualified film or television production or any qualified live theatrical production shall be made in such manner as prescribed by the Secretary")
rule Section181ElectionPower(p: Person, production: Integer) strict {
    label en official "a taxpayer has the power to elect section 181 treatment of a qualified production (section 181(a)(1),(c))";
    when elects_section_181_expensing(p, production);
    then power QualifiedProductionExpensingElection {
        holder p;
        over production;
        exercise elects_section_181_expensing(p, production);
        valid_when elects_section_181_expensing(p, production);
        effect create(section_181_election_in_effect(p, production));
        window [@2004-10-23, infinity);
    };
}
pub relation section_181_terminated_for_production(p: Person, production: Integer) kind institutional {
    label en official "section 181 does not apply to productions commencing after December 31, 2025 (section 181(g), redesignated (h) by Pub. L. 119-21 section 70434(e),(f))";
}
@source(IRC_S181_G, quote = "This section shall not apply to qualified film and television productions or qualified live theatrical productions commencing after December 31, 2025.")
rule Section181TerminationRule(p: Person, production: Integer, commencement: Date, year_end: Date) strict {
    label en official "a production commencing after December 31, 2025 is outside section 181";
    when production_commences_in_year_ending_after(p, production, commencement, year_end);
    when commencement > @2025-12-31;
    then section_181_terminated_for_production(p, production);
}
pub relation section_181_deduction(p: Person, y: TaxableYear, production: Integer, amount: Money) kind institutional {
    label en official "the section 181 deduction for the production: the cost up to the dollar limit";
}
@source(IRC_S181_A, quote = "Any cost so treated shall be allowed as a deduction.")
rule Section181Deduction(p: Person, y: TaxableYear, production: Integer, kind: QualifiedProductionKind, cost: Money, limit: Money) defeasible {
    label en official "with the election the cost of the qualified production is deducted, up to the dollar limit (section 181(a)(1),(2)); sound recordings apply only to productions commencing in taxable years ending after July 4, 2025 (Pub. L. 119-21 section 70434(i)), which is not gated here (TECH_GAPS G2712)";
    when section_181_election_in_effect(p, production);
    when qualified_production_181(p, production, kind);
    when production_aggregate_cost(p, y, production, kind, cost);
    when section_181_dollar_limit(p, production, limit);
    when not_known(section_181_terminated_for_production(p, production));
    when not_known(section_181_election_revoked(p, production));
    then section_181_deduction(p, y, production, min(cost, limit));
}
@source(IRC_S181_A, quote = "Any cost so treated shall be allowed as a deduction.")
rule Section181DeductionAllowed(p: Person, y: TaxableYear, production: Integer, amount: Money) defeasible {
    label en official "the section 181 amount is an allowed deduction";
    when section_181_deduction(p, y, production, amount);
    then deduction_allowed(p, y, Section181QualifiedProductions, amount);
}

// === §186: recoveries of damages for antitrust violations, etc. =============================

pub relation damages_received_or_accrued_for_compensable_injury(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind institutional {
    label en official "damages received or accrued in the year as a result of an award in, or settlement of, a civil action for recovery for a compensable injury (patent infringement, breach of contract or fiduciary duty, antitrust injury) and included in gross income (section 186(a),(b),(c))";
}
pub relation costs_of_securing_award_or_settlement(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind empirical {
    label en official "amounts paid or incurred in the taxable year in securing the award or settlement (section 186(c))";
}
pub relation net_operating_losses_attributable_to_injury(p: Person, injury: Integer, amount: Money) kind institutional {
    label en official "the sum of the net operating losses for each year in whole or in part within the injury period, to the extent attributable to the compensable injury (section 186(d)(1)(A)); an asserted total";
}
pub relation attributable_losses_already_allowed_under_172(p: Person, injury: Integer, amount: Money) kind empirical {
    label en official "the net operating losses attributable to the injury that were allowed for a prior year as a carryback or carryover (section 186(d)(1)(B)(i))";
}
pub relation prior_186_deductions_for_injury(p: Person, injury: Integer, amount: Money) kind empirical {
    label en official "the amounts allowed as a deduction under section 186(a) for prior recoveries for the same injury (section 186(d)(1)(B)(ii))";
}
pub relation unrecovered_losses_186(p: Person, injury: Integer, amount: Money) kind institutional {
    label en official "the unrecovered losses sustained as a result of the compensable injury (section 186(d)(1))";
}
@source(IRC_S186_D, quote = "the sum of the amount of the net operating losses (as determined under section 172) for each taxable year in whole or in part within the injury period")
rule UnrecoveredLossesRule(p: Person, injury: Integer, attributable: Money, allowed: Money, prior: Money) strict {
    label en official "unrecovered losses are the attributable net operating losses reduced by those already allowed and by prior section 186 deductions, not below zero (section 186(d)(1))";
    when net_operating_losses_attributable_to_injury(p, injury, attributable);
    when attributable_losses_already_allowed_under_172(p, injury, allowed);
    when prior_186_deductions_for_injury(p, injury, prior);
    then unrecovered_losses_186(p, injury, max(0.00 USD, attributable - allowed - prior));
}
pub relation compensatory_amount_186(p: Person, y: TaxableYear, injury: Integer, amount: Money) kind institutional {
    label en official "the compensatory amount: damages received or accrued less the costs of securing the award or settlement (section 186(c))";
}
@source(IRC_S186_C, quote = "reduced by any amounts paid or incurred in the taxable year in securing such award or settlement")
rule CompensatoryAmountRule(p: Person, y: TaxableYear, injury: Integer, damages: Money, costs: Money) strict {
    label en official "the compensatory amount is damages less the costs of securing them, not below zero (section 186(c))";
    when damages_received_or_accrued_for_compensable_injury(p, y, injury, damages);
    when costs_of_securing_award_or_settlement(p, y, injury, costs);
    then compensatory_amount_186(p, y, injury, max(0.00 USD, damages - costs));
}
@source(IRC_S186_A, quote = "there shall be allowed as a deduction for the taxable year an amount equal to the lesser of—")
rule Section186Deduction(p: Person, y: TaxableYear, injury: Integer, comp: Money, unrecovered: Money) strict {
    label en official "the deduction is the lesser of the compensatory amount and the unrecovered losses (section 186(a))";
    when compensatory_amount_186(p, y, injury, comp);
    when unrecovered_losses_186(p, injury, unrecovered);
    then deduction_allowed(p, y, Section186Recoveries, min(comp, unrecovered));
}

// === §190: architectural and transportation barrier removal =================================

pub relation barrier_removal_expense_established_to_satisfaction_of_secretary(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "an expenditure for making a facility or public transportation vehicle owned or leased for a trade or business more accessible to handicapped and elderly individuals, for which the taxpayer establishes to the satisfaction of the Secretary that the barrier removal meets the promulgated standards (section 190(b)(2))";
}
pub relation barrier_removal_expense_amount(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "the amount of the qualified barrier removal expense (section 190(a)(1))";
}
pub relation elects_barrier_removal_expensing(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects, at the time and in the manner the Secretary prescribes, to treat qualified barrier removal expenses as expenses (section 190(a)(2))";
}
pub relation barrier_removal_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 190 election is in effect for the year";
}
@source(IRC_S190_A, quote = "A taxpayer may elect to treat qualified architectural and transportation barrier removal expenses which are paid or incurred by him during the taxable year as expenses")
rule BarrierRemovalElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer has the power to elect to expense qualified barrier removal expenses (section 190(a))";
    when elects_barrier_removal_expensing(p, y);
    then power BarrierRemovalExpensingElection {
        holder p;
        over y;
        exercise elects_barrier_removal_expensing(p, y);
        valid_when elects_barrier_removal_expensing(p, y);
        effect create(barrier_removal_election_in_effect(p, y));
        window [@1976-01-01, infinity);
    };
}
pub relation barrier_removal_expenses_total(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate qualified barrier removal expenses of the taxable year (an asserted total; a sum over derived per-item amounts is a runtime subset limitation, section 111)";
}
@source(IRC_S190_C, quote = "The deduction allowed by subsection (a) for any taxable year shall not exceed $15,000.")
rule BarrierRemovalDeductionLimited(p: Person, y: TaxableYear, total: Money) defeasible {
    label en official "the deduction is the qualified expenses limited to $15,000 for the year (section 190(a),(c))";
    when barrier_removal_election_in_effect(p, y);
    when barrier_removal_expenses_total(p, y, total);
    then deduction_allowed(p, y, Section190BarrierRemoval, min(total, 15000.00 USD));
}

// === §192: black lung benefit trusts ===========================================================

pub relation contributions_to_black_lung_trust_with_carryover(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "cash (or permitted investment) contributions to a section 501(c)(21) trust during the year, deemed made on the last day of the year if paid by the return due date, plus the excess carried over from the preceding year (section 192(a),(c)(3),(4),(d))";
}
pub relation black_lung_level_funding_of_unfunded_liability(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount necessary to fund, with level funding, the remaining unfunded liability for black lung claims over the funding period of section 192(c)(1) (section 192(b)(1)); actuarial";
}
pub relation black_lung_amount_to_bring_trust_to_required_level(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate amount necessary to increase each section 501(c)(21) trust to the amount required to pay all amounts payable out of it for the year (section 192(b)(2))";
}
pub relation black_lung_deduction_192(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 192 deduction: contributions limited to the greater of the level-funding amount and the trust top-up amount";
}
pub relation black_lung_excess_carried_over(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of contributions over the section 192(b) limit, treated as contributed in the succeeding year (section 192(d))";
}
@source(IRC_S192_B, quote = "The maximum amount of the deduction allowed by subsection (a) for any taxpayer for any taxable year shall not exceed the greater of—")
rule BlackLungDeductionLimit(p: Person, y: TaxableYear, contrib: Money, level: Money, topup: Money) strict {
    label en official "the deduction is the contributions limited to the greater of the two funding amounts (section 192(a),(b))";
    when contributions_to_black_lung_trust_with_carryover(p, y, contrib);
    when black_lung_level_funding_of_unfunded_liability(p, y, level);
    when black_lung_amount_to_bring_trust_to_required_level(p, y, topup);
    then black_lung_deduction_192(p, y, min(contrib, max(level, topup)));
}
@source(IRC_S192_D, quote = "the excess shall be carried over to the succeeding taxable year and treated as contributed to the trust during that year")
rule BlackLungExcessCarryover(p: Person, y: TaxableYear, contrib: Money, level: Money, topup: Money) strict {
    label en official "contributions above the section 192(b) limit carry over one year at a time (section 192(d))";
    when contributions_to_black_lung_trust_with_carryover(p, y, contrib);
    when black_lung_level_funding_of_unfunded_liability(p, y, level);
    when black_lung_amount_to_bring_trust_to_required_level(p, y, topup);
    when contrib > max(level, topup);
    then black_lung_excess_carried_over(p, y, contrib - max(level, topup));
}
@source(IRC_S192_A, quote = "There is allowed as a deduction for the taxable year an amount equal to the sum of the amounts contributed by the taxpayer during the taxable year")
rule BlackLungDeductionAllowed(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the section 192 amount is an allowed deduction; no section 162(a) deduction is allowed for the liability taken into account (section 192(c)(5))";
    when black_lung_deduction_192(p, y, amount);
    then deduction_allowed(p, y, Section192BlackLungTrust, amount);
}

// === §193: tertiary injectant expenses ===========================================================

pub relation tertiary_injectant_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "a cost paid or incurred, whether or not chargeable to capital account, for a tertiary injectant used as part of a tertiary recovery method and injected during the taxable year, other than a recoverable hydrocarbon injectant (section 193(a),(b))";
}
pub relation tertiary_injectant_expense_elected_under_263c_or_otherwise_deductible(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the expenditure is one for which a section 263(c) election was made or a deduction is allowed or allowable under another provision of chapter 1 (section 193(c))";
}
@source(IRC_S193_A, quote = "There shall be allowed as a deduction for the taxable year an amount equal to the qualified tertiary injectant expenses of the taxpayer for tertiary injectants injected during such taxable year.")
rule TertiaryInjectantDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "qualified tertiary injectant expenses are deductible unless section 263(c) was elected or another provision allows a deduction (section 193(a),(c))";
    when tertiary_injectant_expense(p, y, item, amount);
    when not_known(tertiary_injectant_expense_elected_under_263c_or_otherwise_deductible(p, y, item));
    then deduction_allowed(p, y, Section193TertiaryInjectant, amount);
}

// === §194: reforestation expenditures ============================================================

pub enum ReforestationTaxpayerKind {
    OrdinaryTaxpayer;
    MarriedFilingSeparately;
    Trust;
}
pub relation qualified_timber_property_reforestation_expenditure(p: Person, y: TaxableYear, timber: Integer, kind: ReforestationTaxpayerKind, amount: Money) kind institutional {
    label en official "reforestation expenditures paid or incurred during the taxable year with respect to a qualified timber property, of a taxpayer of the stated kind (section 194(b)(1),(c)); expenditures reimbursed under a cost-sharing program and not included in income are excluded (section 194(c)(3)(B))";
}
pub relation elects_reforestation_expensing(p: Person, timber: Integer) kind empirical {
    label en official "the taxpayer elects section 194(b) with respect to the qualified timber property";
}
pub relation reforestation_expensing_election_in_effect(p: Person, timber: Integer) kind institutional {
    label en official "the section 194(b) election is in effect for the qualified timber property";
}
@source(IRC_S194_B, quote = "the taxpayer shall treat reforestation expenditures which are paid or incurred during the taxable year with respect to such property as an expense which is not chargeable to capital account")
rule ReforestationElectionPower(p: Person, timber: Integer) strict {
    label en official "a taxpayer has the power to elect expense treatment of reforestation expenditures for a qualified timber property (section 194(b)(1)(A))";
    when elects_reforestation_expensing(p, timber);
    then power ReforestationExpensingElection {
        holder p;
        over timber;
        exercise elects_reforestation_expensing(p, timber);
        valid_when elects_reforestation_expensing(p, timber);
        effect create(reforestation_expensing_election_in_effect(p, timber));
        window [@2004-10-23, infinity);
    };
}
@source(IRC_S194_B, quote = "(i) except as provided in clause (ii) or (iii), $10,000,")
rule ReforestationExpenseDeductionOrdinary(p: Person, y: TaxableYear, timber: Integer, amount: Money) defeasible {
    label en official "with the election the reforestation expenditures of an ordinary taxpayer are deducted up to $10,000 per qualified timber property; the excess is amortizable basis (section 194(a),(b)(1)(B)(i))";
    when reforestation_expensing_election_in_effect(p, timber);
    when qualified_timber_property_reforestation_expenditure(p, y, timber, OrdinaryTaxpayer, amount);
    then deduction_allowed(p, y, Section194Reforestation, min(amount, 10000.00 USD));
}
@source(IRC_S194_B, quote = "(ii) in the case of a separate return by a married individual (as defined in section 7703), $5,000, and")
rule ReforestationExpenseDeductionMarriedSeparate(p: Person, y: TaxableYear, timber: Integer, amount: Money) defeasible {
    label en official "the limit is $5,000 on a separate return by a married individual (section 194(b)(1)(B)(ii))";
    when reforestation_expensing_election_in_effect(p, timber);
    when qualified_timber_property_reforestation_expenditure(p, y, timber, MarriedFilingSeparately, amount);
    then deduction_allowed(p, y, Section194Reforestation, min(amount, 5000.00 USD));
}
@source(IRC_S194_B, quote = "(iii) in the case of a trust, zero.")
rule ReforestationExpenseDeductionTrust(p: Person, y: TaxableYear, timber: Integer, amount: Money) defeasible {
    label en official "the limit is zero for a trust (section 194(b)(1)(B)(iii))";
    when reforestation_expensing_election_in_effect(p, timber);
    when qualified_timber_property_reforestation_expenditure(p, y, timber, Trust, amount);
    then deduction_allowed(p, y, Section194Reforestation, 0.00 USD);
}
pub relation reforestation_amortizable_basis(p: Person, timber: Integer, amount: Money) kind empirical {
    label en official "the portion of the basis of the qualified timber property attributable to reforestation expenditures not taken into account under section 194(b) (section 194(c)(2))";
}
pub relation elects_reforestation_amortization(p: Person, timber: Integer) kind empirical {
    label en official "the taxpayer elects the 84-month amortization of section 194(a)";
}
pub relation reforestation_amortization_months_in_taxable_year(p: Person, y: TaxableYear, timber: Integer, months: Integer) kind empirical {
    label en official "the months of the 84-month period, beginning with the first month of the second half of the taxable year in which the property is acquired, that fall within the taxable year (month-count term gap, TECH_GAPS G2703)";
}
@source(IRC_S194_A, quote = "the taxpayer shall be entitled to a deduction with respect to the amortization of the amortizable basis of qualified timber property based on a period of 84 months")
rule ReforestationAmortizationDeduction(p: Person, y: TaxableYear, timber: Integer, basis: Money, months: Integer) strict {
    label en official "the amortizable basis is deducted ratably over 84 months: basis times months in the year over 84, one rounding (section 194(a))";
    when elects_reforestation_amortization(p, timber);
    when reforestation_amortizable_basis(p, timber, basis);
    when reforestation_amortization_months_in_taxable_year(p, y, timber, months);
    then deduction_allowed(p, y, Section194Reforestation, div_round(basis * months, 84.0, 2, "HALF_UP"));
}

// === §194A: withdrawal liability payment fund contributions ==========================================

pub relation employer_contribution_to_withdrawal_liability_fund(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount properly allocable to the taxable year that an employer contributes to a section 501(c)(22) trust meeting section 4223(h) of ERISA (section 194A(a))";
}
pub relation contribution_relates_to_specified_period(p: Person, y: TaxableYear) kind empirical {
    label en official "the contribution relates to a specified period of time (section 194A(b),(c))";
}
@source(IRC_S194A_A, quote = "There shall be allowed as a deduction for the taxable year an amount equal to the amount—")
rule WithdrawalLiabilityFundDeduction(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "the employer deducts the properly allocable contribution to a withdrawal liability payment fund, provided the contribution relates to a specified period of time (section 194A(a),(c))";
    when employer_contribution_to_withdrawal_liability_fund(p, y, amount);
    when contribution_relates_to_specified_period(p, y);
    then deduction_allowed(p, y, Section194AWithdrawalLiabilityFund, amount);
}
@source(IRC_S194A_C, quote = "No deduction shall be allowed under subsection (a) with respect to any contribution described in subsection (a) which does not relate to any specified period of time.")
rule WithdrawalLiabilityFundNoSpecifiedPeriodDenied(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "no deduction for a contribution that does not relate to a specified period (section 194A(c))";
    when employer_contribution_to_withdrawal_liability_fund(p, y, amount);
    when not_known(contribution_relates_to_specified_period(p, y));
    then not deduction_allowed(p, y, Section194AWithdrawalLiabilityFund, amount);
}

// === §198: environmental remediation expenditures (terminated after 2011) ============================

pub relation environmental_remediation_expenditure(p: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "an expenditure otherwise chargeable to capital account paid or incurred in connection with the abatement or control of hazardous substances at a qualified contaminated site, other than for depreciable property (section 198(b))";
}
pub relation elects_environmental_remediation_expensing(p: Person, y: TaxableYear) kind empirical {
    label en official "the taxpayer elects to treat qualified environmental remediation expenditures as expenses (section 198(a))";
}
pub relation environmental_remediation_election_in_effect(p: Person, y: TaxableYear) kind institutional {
    label en official "the section 198 election is in effect for the year";
}
pub relation site_on_national_priorities_list_or_no_state_statement(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the site is on or proposed for the national priorities list, or the taxpayer has no statement from the appropriate State environmental agency that it meets the contamination requirement (section 198(c)(2),(3))";
}
@source(IRC_S198_A, quote = "A taxpayer may elect to treat any qualified environmental remediation expenditure which is paid or incurred by the taxpayer as an expense which is not chargeable to capital account.")
rule EnvironmentalRemediationElectionPower(p: Person, y: TaxableYear) strict {
    label en official "a taxpayer has the power to elect expense treatment of qualified environmental remediation expenditures paid or incurred before January 1, 2012 (section 198(a),(h))";
    when elects_environmental_remediation_expensing(p, y);
    then power EnvironmentalRemediationExpensingElection {
        holder p;
        over y;
        exercise elects_environmental_remediation_expensing(p, y);
        valid_when elects_environmental_remediation_expensing(p, y);
        effect create(environmental_remediation_election_in_effect(p, y));
        window [@1997-08-06, @2012-01-01);
    };
}
@source(IRC_S198_A, quote = "Any expenditure which is so treated shall be allowed as a deduction for the taxable year in which it is paid or incurred.")
rule EnvironmentalRemediationDeduction(p: Person, y: TaxableYear, item: Integer, amount: Money) defeasible {
    label en official "the expenditure is deducted in the year paid or incurred, absent a national priorities list site or missing State statement (section 198(a),(c)); section 198(h) ends the section for expenditures after December 31, 2011 through the power's window";
    when environmental_remediation_election_in_effect(p, y);
    when environmental_remediation_expenditure(p, y, item, amount);
    when not_known(site_on_national_priorities_list_or_no_state_statement(p, y, item));
    then deduction_allowed(p, y, Section198Environmental, amount);
}
