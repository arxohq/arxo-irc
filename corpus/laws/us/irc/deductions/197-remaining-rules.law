// Section 197 — the rules that complete `197-amortization-intangibles.law` (stage
// 2b): (b) no other depreciation or amortization, (d)(1) the classes of section 197
// intangibles, (e)(1)-(7) the exceptions, (f)(1)-(5),(7)-(10) the special rules and
// the (f)(9)(B) exception to anti-churning, and the month-prorated amortization of
// (a). The earlier module took the classification `section_197_intangible` as an
// asserted fact; the rules here derive it from the type of the item, and a second
// rule of `amortizable_section_197_intangible` reads the derived status.
// Not modelled: the related-person test of (f)(9)(C) (sections 267(b), 707(b)(1)
// with 20 percent) and the partnership rule (f)(9)(E) (TECH_GAPS G2721), the user
// change test (regulations), the (f)(9)(F) anti-abuse purpose (evaluative channel
// only), the section 41(f)(1) aggregation of (f)(1)(C).

use self::{
    Asset,
    DeductionKind,
    IRC_S197_A,
    IRC_S197_B,
    IRC_S197_C,
    IRC_S197_D,
    IRC_S197_E,
    IRC_S197_F,
    Person,
    TaxableYear,
    amortizable_section_197_intangible,
    deduction_allowed,
    section_197_acquired_on,
    section_197_adjusted_basis,
    section_197_anti_churning_disqualified,
    section_197_held_for_trade_or_business_or_212,
    section_197_self_created_excluded,
};

pub enum Section197ItemType {
    Goodwill;
    GoingConcernValue;
    WorkforceInPlace;
    InformationBase;
    PatentCopyrightFormulaProcessKnowhow;
    CustomerBasedIntangible;
    SupplierBasedIntangible;
    OtherSimilarItem;
    GovernmentLicensePermitOrRight;
    CovenantNotToCompete;
    FranchiseTrademarkOrTradeName;
}
pub relation section_197_item_type(p: Person, a: Asset, kind: Section197ItemType) kind institutional {
    label en official "the intangible is an item described in section 197(d)(1)(A)-(F): goodwill, going concern value, workforce in place, business books and records or other information base, patent, copyright, formula, process, design, pattern, knowhow or format, customer-based or supplier-based intangible (including a financial institution's deposit base), other similar item, a governmental license, permit or right, a covenant not to compete entered into in connection with an acquisition of an interest in a trade or business, or a franchise, trademark or trade name";
}

// --- (e): exceptions ------------------------------------------------------------------------------------

pub relation section_197_acquired_in_business_acquisition(p: Person, a: Asset) kind empirical {
    label en official "the intangible was acquired in a transaction (or series of related transactions) involving the acquisition of assets constituting a trade or business or a substantial portion of one";
}
pub relation intangible_is_interest_in_entity_or_financial_contract(p: Person, a: Asset) kind empirical {
    label en official "the intangible is an interest in a corporation, partnership, trust or estate, or under an existing futures, foreign currency, notional principal or similar financial contract (section 197(e)(1))";
}
pub relation intangible_is_interest_in_land(p: Person, a: Asset) kind empirical {
    label en official "the intangible is an interest in land (section 197(e)(2))";
}
pub relation software_readily_available_nonexclusive_unmodified(p: Person, a: Asset) kind empirical {
    label en official "computer software readily available for purchase by the general public, subject to a nonexclusive license and not substantially modified (section 197(e)(3)(A)(i))";
}
pub relation software_other(p: Person, a: Asset) kind empirical {
    label en official "other computer software (a program designed to cause a computer to perform a desired function, excluding data bases not in the public domain) (section 197(e)(3)(A)(ii),(B))";
}
pub relation separately_acquired_film_sound_book_or_similar_interest(p: Person, a: Asset) kind empirical {
    label en official "any interest in a film, sound recording, video tape, book or similar property (section 197(e)(4)(A))";
}
pub relation separately_acquired_right_to_tangible_property_or_services(p: Person, a: Asset) kind empirical {
    label en official "any right to receive tangible property or services under a contract or granted by a governmental unit (section 197(e)(4)(B))";
}
pub relation separately_acquired_patent_or_copyright_interest(p: Person, a: Asset) kind empirical {
    label en official "any interest in a patent or copyright (section 197(e)(4)(C))";
}
pub relation intangible_is_interest_under_existing_lease_or_sublease(p: Person, a: Asset) kind empirical {
    label en official "an interest under an existing lease of tangible property; a sublease is treated as a lease (section 197(e)(5)(A),(f)(6))";
}
pub relation intangible_is_interest_under_existing_indebtedness_other_than_deposit_base(p: Person, a: Asset) kind empirical {
    label en official "an interest under existing indebtedness, except as provided in section 197(d)(2)(B) (section 197(e)(5)(B))";
}
pub relation intangible_is_right_to_service_residential_mortgages(p: Person, a: Asset) kind empirical {
    label en official "a right to service indebtedness secured by residential real property (section 197(e)(6))";
}
pub relation intangible_is_transaction_cost_of_nonrecognition_transaction(p: Person, a: Asset) kind empirical {
    label en official "fees for professional services and transaction costs incurred by parties to a transaction in which any gain or loss is not recognized under part III of subchapter C (section 197(e)(7))";
}
pub relation section_197_excepted_by_e(p: Person, a: Asset) kind institutional {
    label en official "the item is not a section 197 intangible by reason of an exception of section 197(e)";
}
@source(IRC_S197_E, quote = "Any interest—")
rule Section197ExceptionFinancialInterestsAndLand(p: Person, a: Asset) strict {
    label en official "financial interests and interests in land are not section 197 intangibles (section 197(e)(1)-(2))";
    when intangible_is_interest_in_entity_or_financial_contract(p, a);
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any interest in land.")
rule Section197ExceptionLand(p: Person, a: Asset) strict {
    label en official "an interest in land is not a section 197 intangible (section 197(e)(2))";
    when intangible_is_interest_in_land(p, a);
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "computer software which is readily available for purchase by the general public, is subject to a nonexclusive license, and has not been substantially modified")
rule Section197ExceptionReadilyAvailableSoftware(p: Person, a: Asset) strict {
    label en official "off-the-shelf software is excepted (section 197(e)(3)(A)(i))";
    when software_readily_available_nonexclusive_unmodified(p, a);
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "other computer software which is not acquired in a transaction (or series of related transactions) involving the acquisition of assets constituting a trade or business or substantial portion thereof.")
rule Section197ExceptionOtherSoftware(p: Person, a: Asset) strict {
    label en official "other software not acquired in a business acquisition is excepted (section 197(e)(3)(A)(ii))";
    when software_other(p, a);
    when not_known(section_197_acquired_in_business_acquisition(p, a));
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any interest in a film, sound recording, video tape, book, or similar property.")
rule Section197ExceptionSeparatelyAcquiredFilm(p: Person, a: Asset) strict {
    label en official "a separately acquired interest in a film, sound recording, video tape, book or similar property is excepted (section 197(e)(4)(A))";
    when separately_acquired_film_sound_book_or_similar_interest(p, a);
    when not_known(section_197_acquired_in_business_acquisition(p, a));
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any right to receive tangible property or services under a contract or granted by a governmental unit or agency or instrumentality thereof.")
rule Section197ExceptionSeparatelyAcquiredRight(p: Person, a: Asset) strict {
    label en official "a separately acquired right to receive tangible property or services is excepted (section 197(e)(4)(B))";
    when separately_acquired_right_to_tangible_property_or_services(p, a);
    when not_known(section_197_acquired_in_business_acquisition(p, a));
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any interest in a patent or copyright.")
rule Section197ExceptionSeparatelyAcquiredPatent(p: Person, a: Asset) strict {
    label en official "a separately acquired interest in a patent or copyright is excepted (section 197(e)(4)(C))";
    when separately_acquired_patent_or_copyright_interest(p, a);
    when not_known(section_197_acquired_in_business_acquisition(p, a));
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "an existing lease of tangible property")
rule Section197ExceptionLease(p: Person, a: Asset) strict {
    label en official "an interest under an existing lease (or sublease) of tangible property is excepted (section 197(e)(5)(A),(f)(6))";
    when intangible_is_interest_under_existing_lease_or_sublease(p, a);
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "except as provided in subsection (d)(2)(B), any existing indebtedness.")
rule Section197ExceptionIndebtedness(p: Person, a: Asset) strict {
    label en official "an interest under existing indebtedness, other than a financial institution's deposit base, is excepted (section 197(e)(5)(B))";
    when intangible_is_interest_under_existing_indebtedness_other_than_deposit_base(p, a);
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any right to service indebtedness which is secured by residential real property")
rule Section197ExceptionMortgageServicing(p: Person, a: Asset) strict {
    label en official "a right to service residential mortgages is excepted unless acquired in a business acquisition (section 197(e)(6))";
    when intangible_is_right_to_service_residential_mortgages(p, a);
    when not_known(section_197_acquired_in_business_acquisition(p, a));
    then section_197_excepted_by_e(p, a);
}
@source(IRC_S197_E, quote = "Any fees for professional services, and any transaction costs, incurred by parties to a transaction with respect to which any portion of the gain or loss is not recognized under part III of subchapter C.")
rule Section197ExceptionTransactionCosts(p: Person, a: Asset) strict {
    label en official "professional fees and transaction costs of a nonrecognition transaction are excepted (section 197(e)(7))";
    when intangible_is_transaction_cost_of_nonrecognition_transaction(p, a);
    then section_197_excepted_by_e(p, a);
}
pub relation section_197_intangible_by_definition(p: Person, a: Asset) kind institutional {
    label en official "the item is a section 197 intangible: it is described in section 197(d)(1) and not excepted by section 197(e)";
}
@source(IRC_S197_D, quote = "the term \"section 197 intangible\" means—")
rule Section197IntangibleByDefinitionRule(p: Person, a: Asset, kind: Section197ItemType) strict {
    label en official "an item of a (d)(1) class that no (e) exception removes is a section 197 intangible (section 197(d)(1),(e))";
    when section_197_item_type(p, a, kind);
    when not_known(section_197_excepted_by_e(p, a));
    then section_197_intangible_by_definition(p, a);
}
@source(IRC_S197_C, quote = "which is acquired by the taxpayer after the date of the enactment of this section")
rule AmortizableSection197IntangibleByDefinition(p: Person, a: Asset, acquired: Date) defeasible {
    label en official "a section 197 intangible derived from its type, acquired after August 10, 1993 and held in a trade or business or section 212 activity is amortizable, absent the self-created or anti-churning exclusions (section 197(c)(1))";
    when section_197_intangible_by_definition(p, a);
    when section_197_held_for_trade_or_business_or_212(p, a);
    when section_197_acquired_on(p, a, acquired);
    when acquired > @1993-08-10;
    unless section_197_self_created_excluded(p, a);
    unless section_197_anti_churning_disqualified(p, a);
    unless section_197_anti_abuse_disqualified(p, a);
    then amortizable_section_197_intangible(p, a);
}

// --- (b): no other depreciation or amortization -----------------------------------------------------------

pub relation other_depreciation_or_amortization_disallowed_197b(p: Person, a: Asset) kind institutional {
    label en official "except as provided in section 197(a), no depreciation or amortization deduction is allowable for the amortizable section 197 intangible; the interlock with section 167 and 168 modules of this package is not wired (TECH_GAPS G2722)";
}
@source(IRC_S197_B, quote = "no depreciation or amortization deduction shall be allowable with respect to any amortizable section 197 intangible")
rule Section197NoOtherDeduction(p: Person, a: Asset) defeasible {
    label en official "an amortizable section 197 intangible gets no other depreciation or amortization (section 197(b))";
    when amortizable_section_197_intangible(p, a);
    then other_depreciation_or_amortization_disallowed_197b(p, a);
}
pub relation treated_as_depreciable_property_197f7(p: Person, a: Asset) kind institutional {
    label en official "the amortizable section 197 intangible is treated as property of a character subject to the allowance for depreciation under section 167 (section 197(f)(7))";
}
@source(IRC_S197_F, quote = "any amortizable section 197 intangible shall be treated as property which is of a character subject to the allowance for depreciation provided in section 167")
rule Section197TreatedAsDepreciable(p: Person, a: Asset) defeasible {
    label en official "for chapter 1 purposes the amortizable intangible is depreciable property (section 197(f)(7))";
    when amortizable_section_197_intangible(p, a);
    then treated_as_depreciable_property_197f7(p, a);
}

// --- (a),(f)(10): the prorated amortization amount ------------------------------------------------------------

pub relation tax_exempt_use_lease_term_months(p: Person, a: Asset, months: Integer) kind empirical {
    label en official "the lease term, in months (section 168(i)(3)), of a section 197 intangible that would be tax-exempt use property under section 168(h) if that section applied to it (section 197(f)(10))";
}
pub relation has_tax_exempt_use_lease_197(p: Person, a: Asset) kind institutional {
    label en official "helper: the intangible is subject to a lease term of section 197(f)(10)";
}
rule HasTaxExemptUseLease197Rule(p: Person, a: Asset) strict {
    label en official "helper: a lease term was asserted";
    when tax_exempt_use_lease_term_months(p, a, _);
    then has_tax_exempt_use_lease_197(p, a);
}
pub relation section_197_amortization_period_months(p: Person, a: Asset, months: Decimal) kind institutional {
    label en official "the amortization period in months: 180, or 125 percent of the lease term if longer for tax-exempt use property (section 197(a),(f)(10))";
}
@source(IRC_S197_A, quote = "ratably over the 15-year period beginning with the month in which such intangible was acquired")
rule Section197PeriodOrdinary(p: Person, a: Asset) defeasible {
    label en official "the period is 15 years (180 months) (section 197(a))";
    when amortizable_section_197_intangible(p, a);
    when not_known(has_tax_exempt_use_lease_197(p, a));
    then section_197_amortization_period_months(p, a, 180.0);
}
@source(IRC_S197_F, quote = "the amortization period under this section shall not be less than 125 percent of the lease term")
rule Section197PeriodTaxExemptUse(p: Person, a: Asset, lease: Integer) defeasible {
    label en official "for tax-exempt use property subject to a lease the period is not less than 125 percent of the lease term (section 197(f)(10))";
    when amortizable_section_197_intangible(p, a);
    when tax_exempt_use_lease_term_months(p, a, lease);
    then section_197_amortization_period_months(p, a, max(180.0, lease * 1.25));
}
pub relation section_197_months_in_taxable_year(p: Person, a: Asset, y: TaxableYear, months: Integer) kind empirical {
    label en official "the months of the amortization period, beginning with the month of acquisition, that fall within the taxable year (month-count term gap, TECH_GAPS G2703)";
}
pub relation amortization_197_prorated(p: Person, a: Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 197(a) amortization for the taxable year: adjusted basis times the months of the year over the amortization period in months, one rounding";
}
@source(IRC_S197_A, quote = "The amount of such deduction shall be determined by amortizing the adjusted basis (for purposes of determining gain) of such intangible ratably")
rule Amortization197ProratedRule(p: Person, a: Asset, y: TaxableYear, basis: Money, months: Integer, period: Decimal) defeasible {
    label en official "adjusted basis x months in the year / period months, one rounding (section 197(a))";
    when amortizable_section_197_intangible(p, a);
    when section_197_adjusted_basis(p, a, basis);
    when section_197_months_in_taxable_year(p, a, y, months);
    when section_197_amortization_period_months(p, a, period);
    then amortization_197_prorated(p, a, y, div_round(basis * months, period, 2, "HALF_UP"));
}
@source(IRC_S197_A, quote = "A taxpayer shall be entitled to an amortization deduction with respect to any amortizable section 197 intangible.")
rule Amortization197ProratedAllowed(p: Person, a: Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "the prorated section 197 amortization is an allowed deduction";
    when amortization_197_prorated(p, a, y, amount);
    then deduction_allowed(p, y, Section197Amortization, amount);
}

// --- (f)(1): dispositions and worthlessness -----------------------------------------------------------------

pub relation section_197_intangible_disposed_or_worthless(p: Person, a: Asset) kind empirical {
    label en official "an amortizable section 197 intangible acquired in a transaction or series of related transactions is disposed of or becomes worthless (section 197(f)(1)(A))";
}
pub relation other_intangibles_of_same_acquisition_retained(p: Person, a: Asset) kind empirical {
    label en official "one or more other amortizable section 197 intangibles acquired in the same transaction or series are retained";
}
pub relation covenant_not_to_compete_entire_interest_disposed(p: Person, a: Asset) kind empirical {
    label en official "the entire interest in the trade or business (or substantial portion) in connection with which a covenant not to compete was entered into has been disposed of (section 197(f)(1)(B))";
}
pub relation loss_on_disposition_of_intangible(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the loss that would otherwise be recognized on the disposition or worthlessness";
}
pub relation section_197_loss_not_recognized(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "no loss is recognized by reason of the disposition or worthlessness while other intangibles of the acquisition are retained; the retained intangibles' bases are adjusted by that amount (section 197(f)(1)(A))";
}
@source(IRC_S197_F, quote = "no loss shall be recognized by reason of such disposition (or such worthlessness)")
rule Section197DispositionLossNotRecognized(p: Person, a: Asset, loss: Money) strict {
    label en official "the loss is not recognized while other intangibles of the same acquisition are retained (section 197(f)(1)(A)); a covenant not to compete is not treated as disposed of before the entire interest is (section 197(f)(1)(B)), which the covenant rule below adds";
    when section_197_intangible_disposed_or_worthless(p, a);
    when other_intangibles_of_same_acquisition_retained(p, a);
    when loss_on_disposition_of_intangible(p, a, loss);
    then section_197_loss_not_recognized(p, a, loss);
}
pub relation retained_intangibles_basis_increase_197f1(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the appropriate adjustment to the adjusted bases of the retained intangibles for the loss not recognized (section 197(f)(1)(A)(ii)); the allocation among several retained intangibles is left to regulations";
}
@source(IRC_S197_F, quote = "appropriate adjustments to the adjusted bases of such retained intangibles shall be made for any loss not recognized under clause (i).")
rule Section197RetainedBasisAdjustment(p: Person, a: Asset, loss: Money) strict {
    label en official "the unrecognized loss is added to the basis of the retained intangibles";
    when section_197_loss_not_recognized(p, a, loss);
    then retained_intangibles_basis_increase_197f1(p, a, loss);
}
pub relation covenant_treated_as_disposed_197f1b(p: Person, a: Asset) kind institutional {
    label en official "a covenant not to compete is treated as disposed of or worthless only upon the disposition of the entire interest in connection with which it was entered into (section 197(f)(1)(B))";
}
@source(IRC_S197_F, quote = "in no event shall such covenant or other arrangement be treated as disposed of (or becoming worthless) before the disposition of the entire interest")
rule Section197CovenantDisposition(p: Person, a: Asset) strict {
    label en official "the covenant is treated as disposed of only with the entire interest (section 197(f)(1)(B))";
    when section_197_item_type(p, a, CovenantNotToCompete);
    when covenant_not_to_compete_entire_interest_disposed(p, a);
    then covenant_treated_as_disposed_197f1b(p, a);
}

// --- (f)(2),(3),(4),(5),(8): transfers, covenants, renewals, reinsurance, increments ------------------------------

pub relation transferred_in_carryover_transaction_197f2(p: Person, a: Asset) kind empirical {
    label en official "the intangible is transferred in a transaction under section 332, 351, 361, 721, 731, 1031 or 1033, or between members of an affiliated group for a consolidated return year (section 197(f)(2)(B))";
}
pub relation transferee_adjusted_basis_197(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the intangible in the hands of the transferee";
}
pub relation transferor_adjusted_basis_197(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the adjusted basis of the intangible in the hands of the transferor";
}
pub relation basis_treated_as_transferors_for_amortization(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the part of the transferee's adjusted basis, up to the transferor's adjusted basis, for which the transferee is treated as the transferor in applying section 197 (section 197(f)(2)(A))";
}
@source(IRC_S197_F, quote = "the transferee shall be treated as the transferor for purposes of applying this section with respect to so much of the adjusted basis in the hands of the transferee as does not exceed the adjusted basis in the hands of the transferor")
rule Section197TransfereeAsTransferor(p: Person, a: Asset, tee: Money, tor: Money) strict {
    label en official "the carryover part of the basis is amortized as the transferor would (section 197(f)(2)(A))";
    when transferred_in_carryover_transaction_197f2(p, a);
    when transferee_adjusted_basis_197(p, a, tee);
    when transferor_adjusted_basis_197(p, a, tor);
    then basis_treated_as_transferors_for_amortization(p, a, min(tee, tor));
}
pub relation covenant_payment_197f3(p: Person, y: TaxableYear, a: Asset, amount: Money) kind empirical {
    label en official "an amount paid or incurred pursuant to a covenant not to compete (or similar arrangement) of section 197(d)(1)(E)";
}
pub relation amount_chargeable_to_capital_account_197f3(p: Person, y: TaxableYear, a: Asset, amount: Money) kind institutional {
    label en official "the amount is chargeable to capital account (section 197(f)(3))";
}
@source(IRC_S197_F, quote = "shall be treated as an amount chargeable to capital account")
rule Section197CovenantPaymentsCapitalized(p: Person, y: TaxableYear, a: Asset, amount: Money) strict {
    label en official "payments under a covenant not to compete are capitalized (section 197(f)(3))";
    when covenant_payment_197f3(p, y, a, amount);
    then amount_chargeable_to_capital_account_197f3(p, y, a, amount);
}
pub relation franchise_trademark_or_license_renewal_cost(p: Person, y: TaxableYear, a: Asset, amount: Money) kind empirical {
    label en official "a cost incurred in connection with the renewal of a franchise, trademark, trade name, license, permit or other right of section 197(d)(1)(D) (section 197(f)(4)(B))";
}
pub relation renewal_cost_treated_as_acquisition(p: Person, y: TaxableYear, a: Asset, amount: Money) kind institutional {
    label en official "a renewal is treated as an acquisition, only with respect to the costs incurred in connection with the renewal";
}
@source(IRC_S197_F, quote = "shall be treated as an acquisition.")
rule Section197RenewalTreatedAsAcquisition(p: Person, y: TaxableYear, a: Asset, amount: Money) strict {
    label en official "renewal costs are treated as the cost of an acquisition (section 197(f)(4)(B))";
    when franchise_trademark_or_license_renewal_cost(p, y, a, amount);
    then renewal_cost_treated_as_acquisition(p, y, a, amount);
}
pub relation assumption_reinsurance_amount_paid(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the amount paid or incurred by the acquirer under the assumption reinsurance transaction (section 197(f)(5)(A))";
}
pub relation assumption_reinsurance_amount_capitalized_under_848(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the amount required to be capitalized under section 848 in connection with the transaction (section 197(f)(5)(B))";
}
pub relation reinsurance_intangible_adjusted_basis_197f5(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "the adjusted basis of an intangible resulting from an assumption reinsurance transaction: the excess of the amount paid over the amount capitalized under section 848 (section 197(f)(5))";
}
@source(IRC_S197_F, quote = "the amount taken into account as the adjusted basis of such intangible under this section shall be the excess of—")
rule Section197ReinsuranceBasis(p: Person, a: Asset, paid: Money, cap848: Money) strict {
    label en official "the basis is the amount paid less the section 848 amount, not below zero (section 197(f)(5))";
    when assumption_reinsurance_amount_paid(p, a, paid);
    when assumption_reinsurance_amount_capitalized_under_848(p, a, cap848);
    then reinsurance_intangible_adjusted_basis_197f5(p, a, max(0.00 USD, paid - cap848));
}
pub relation increment_in_value_taken_into_cost_of_non_197_property(p: Person, a: Asset) kind empirical {
    label en official "an increment in value that, without regard to section 197, is properly taken into account in determining the cost of property that is not a section 197 intangible (section 197(f)(8))";
}
pub relation section_197_not_applicable_to_increment(p: Person, a: Asset) kind institutional {
    label en official "section 197 does not apply to the increment (section 197(f)(8))";
}
@source(IRC_S197_F, quote = "This section shall not apply to any increment in value if, without regard to this section, such increment is properly taken into account in determining the cost of property which is not a section 197 intangible.")
rule Section197IncrementInValue(p: Person, a: Asset) strict {
    label en official "section 197 does not apply to an increment already part of the cost of non-197 property (section 197(f)(8))";
    when increment_in_value_taken_into_cost_of_non_197_property(p, a);
    then section_197_not_applicable_to_increment(p, a);
}

// --- (f)(9): anti-churning — the additions --------------------------------------------------------------------------

pub relation section_197_basis_determined_under_1014a(p: Person, a: Asset) kind empirical {
    label en official "the basis of the property in the hands of the taxpayer is determined under section 1014(a), so anti-churning does not apply to an acquisition by reason of death (section 197(f)(9)(D))";
}
external judgment relation acquired_for_principal_purpose_of_avoiding_197(p: Person, a: Asset) {
    authority TaxCourt;
    label en official "the intangible was acquired in a transaction one of the principal purposes of which is to avoid the requirement that it be acquired after the date of enactment or to avoid the anti-churning rule (section 197(f)(9)(F))";
}
pub relation section_197_anti_abuse_disqualified(p: Person, a: Asset) kind institutional {
    label en official "the intangible is not an amortizable section 197 intangible by reason of the anti-abuse rule of section 197(f)(9)(F)";
}
@source(IRC_S197_F, quote = "one of the principal purposes of which is to avoid the requirement of subsection (c)(1)")
rule Section197AntiAbuseRule(p: Person, a: Asset) strict {
    label en official "an intangible acquired for a principal purpose of avoiding subsection (c)(1) or the anti-churning rule is not amortizable (section 197(f)(9)(F)); the purpose is a judgment (DECISION-0194)";
    when acquired_for_principal_purpose_of_avoiding_197(p, a);
    then section_197_anti_abuse_disqualified(p, a);
}
pub relation transferor_elects_gain_recognition_at_highest_rate_197f9b(p: Person, a: Asset) kind empirical {
    label en official "the person from whom the taxpayer acquired the intangible elects to recognize gain on the disposition and to pay tax on it at the highest rate of income tax applicable to that person (section 197(f)(9)(B)(ii))";
}
pub relation gain_recognized_by_transferor_197f9b(p: Person, a: Asset, amount: Money) kind empirical {
    label en official "the gain recognized under the section 197(f)(9)(B)(ii) election";
}
pub relation anti_churning_reach_only_by_relationship_timing_197f9b(p: Person, a: Asset) kind empirical {
    label en official "subparagraph (A) would not apply to the intangible but for the last sentence of subparagraph (C)(i) (relationship immediately before or after the acquisition) (section 197(f)(9)(B)(i))";
}
pub relation anti_churning_disqualified_basis_197f9b(p: Person, a: Asset, amount: Money) kind institutional {
    label en official "where the (f)(9)(B) exception applies, anti-churning applies only to the extent the taxpayer's adjusted basis exceeds the gain recognized";
}
@source(IRC_S197_F, quote = "then subparagraph (A) shall apply to the intangible only to the extent that the taxpayer's adjusted basis in the intangible exceeds the gain recognized under clause (ii)(I).")
rule Section197AntiChurningGainRecognizedException(p: Person, a: Asset, basis: Money, gain: Money) strict {
    label en official "the anti-churning disqualification reaches only the basis in excess of the gain recognized (section 197(f)(9)(B))";
    when anti_churning_reach_only_by_relationship_timing_197f9b(p, a);
    when transferor_elects_gain_recognition_at_highest_rate_197f9b(p, a);
    when section_197_adjusted_basis(p, a, basis);
    when gain_recognized_by_transferor_197f9b(p, a, gain);
    then anti_churning_disqualified_basis_197f9b(p, a, max(0.00 USD, basis - gain));
}
