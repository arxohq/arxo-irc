// Section 274 — Disallowance of certain entertainment, etc., expenses.
// Stage 1 (IRC-06), priority section. Scope: (a) entertainment disallowance;
// (d) substantiation as a validity condition; (n) the 50% meals limitation
// (with the employee-food (e)(1) exception and Pub. L. 119-21 section 70305
// carve-outs for fishing-boat/fish-processing crew meals).

use self::{
    DeductionKind,
    IRC_S274_A,
    IRC_S274_B,
    IRC_S274_D,
    IRC_S274_K,
    IRC_S274_N,
    Person,
    TaxableYear,
    deduction_allowed,
    entertainment_exception_applies_274e,
    food_beverage_274k_exception_applies,
};

pub relation entertainment_amusement_or_recreation_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an item with respect to an activity of a type generally considered entertainment, amusement, or recreation, or a facility used in connection with one (section 274(a)(1))";
}
@source(IRC_S274_A, quote = "No deduction otherwise allowable under this chapter shall be allowed for any item")
rule EntertainmentExpenseDisallowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for an entertainment, amusement, or recreation expense (section 274(a)(1))";
    when entertainment_amusement_or_recreation_expense(p, y, item, amount);
    when not_known(entertainment_exception_applies_274e(p, y, item));
    then not deduction_allowed(p, y, Section274Meals, amount);
}
pub relation club_dues_paid(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "amounts paid or incurred for membership in a club organized for business, pleasure, recreation, or other social purpose (section 274(a)(3))";
}
@source(IRC_S274_A, quote = "no deduction shall be allowed under this chapter for amounts paid or incurred for membership in any club organized for business, pleasure, recreation, or other social purpose")
rule ClubDuesNeverDeductible(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for club dues, regardless of any entertainment-related exception (section 274(a)(3))";
    when club_dues_paid(p, y, item, amount);
    then not deduction_allowed(p, y, Section274Meals, amount);
}

// --- §274(d): substantiation as a validity condition ----------------------------

pub relation traveling_or_gift_expense_item(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a traveling expense (including meals and lodging while away from home), or an expense for a gift, subject to section 274(d) substantiation";
}
pub relation substantiated_by_adequate_records_or_evidence(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "substantiated by adequate records or sufficient corroborating evidence as to amount, time and place (or date and description), business purpose, and business relationship (section 274(d))";
}
@source(IRC_S274_D, quote = "unless the taxpayer substantiates by adequate records or by sufficient evidence corroborating the taxpayer's own statement")
rule TravelOrGiftExpenseRequiresSubstantiation(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a traveling or gift expense is not deductible without section 274(d) substantiation — a VALIDITY CONDITION, not a duty to keep records";
    when traveling_or_gift_expense_item(p, y, item, amount);
    when not_known(substantiated_by_adequate_records_or_evidence(p, y, item));
    then not deduction_allowed(p, y, Section274Meals, amount);
}

// --- §274(n): 50% meals limitation ------------------------------------------------

pub relation food_or_beverage_expense(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "an expense for food or beverages otherwise allowable as a deduction (section 274(n)(1))";
}
pub relation employee_food_on_business_premises(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "food/beverages furnished on the taxpayer's business premises primarily for employees (section 274(e)(1)), excepted from the 50% limitation by (n)(2)(A)";
}

@source(IRC_S274_N, quote = "The amount allowable as a deduction under this chapter for any expense for food or beverages shall not exceed 50 percent of the amount of such expense which would (but for this paragraph) be allowable as a deduction under this chapter")
rule MealsExpenseLimitedToFiftyPercent(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a food or beverage expense is deductible only up to 50% of the otherwise-allowable amount, unless a section 274(n)(2) exception applies (section 274(n)(1))";
    when food_or_beverage_expense(p, y, item, amount);
    when not_known(employee_food_on_business_premises(p, y, item));
    then deduction_allowed(p, y, Section274Meals, round(amount * 0.50, 2, "HALF_UP"));
}
@source(IRC_S274_N, quote = "Paragraph (1) shall not apply to any expense if")
rule MealsExpenseFullyDeductibleUnderException(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "the 50% limitation does not apply to employee food/beverages furnished on the business premises primarily for employees (section 274(n)(2)(A), cross-referring (e)(1))";
    when food_or_beverage_expense(p, y, item, amount);
    when employee_food_on_business_premises(p, y, item);
    then deduction_allowed(p, y, Section274Meals, amount);
}

pub relation food_or_beverage_for_transportation_hours_of_service_worker(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "food/beverages consumed away from home by an individual during a period of duty subject to Department of Transportation hours-of-service limitations (section 274(n)(3))";
}
@source(IRC_S274_N, quote = "paragraph (1) shall be applied by substituting \"80 percent\" for \"50 percent\"")
rule MealsExpenseEightyPercentForHoursOfServiceWorkers(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for individuals subject to DOT hours-of-service limitations, the meals limitation is 80%, not 50% (section 274(n)(3))";
    when food_or_beverage_for_transportation_hours_of_service_worker(p, y, item, amount);
    then deduction_allowed(p, y, Section274Meals, round(amount * 0.80, 2, "HALF_UP"));
}

pub relation food_or_beverage_fishing_or_fish_processing_vessel_or_facility(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "food or beverages provided on a fishing/fish-processing/fish-tender vessel, or at a qualifying northern fish-processing facility outside a metropolitan statistical area (section 274(n)(2)(C)(v), as added)";
}
@source(us.irc.temporal::PL119_21_S70305, relation = derives_from, quote = "provided on a fishing vessel, fish processing vessel, or fish tender vessel")
rule FishingVesselMealsNotSubjectToFiftyPercentLimitFrom2026(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "Pub. L. 119-21 section 70305(b): for amounts paid or incurred after December 31, 2025, food/beverages on a qualifying fishing vessel or at a qualifying northern fish-processing facility are not subject to the section 274(n) 50% limitation";
    effective [@2026-01-01, infinity);
    when food_or_beverage_fishing_or_fish_processing_vessel_or_facility(p, y, item, amount);
    then deduction_allowed(p, y, Section274Meals, amount);
}
// --- §274(b): the $25 gift limit ---------------------------------------------

pub relation gift_expense_to_individual_in_year(p: Person, y: TaxableYear, recipient: Person, amount: Money) kind institutional {
    label en official "the aggregate expense for gifts made directly or indirectly to the individual during the taxable year, before the section 274(b)(1) $25 limit (section 274(b))";
}
@source(IRC_S274_B, quote = "No deduction shall be allowed under section 162 or section 212 for any expense for gifts made directly or indirectly to any individual to the extent that such expense, when added to prior expenses of the taxpayer for gifts made to such individual during the same taxable year, exceeds $25")
rule GiftExpenseLimitedToTwentyFiveDollars(p: Person, y: TaxableYear, recipient: Person, amount: Money) defeasible {
    label en official "no deduction is allowed for the portion of aggregate gift expenses to one individual for the year exceeding $25 (section 274(b)(1))";
    when gift_expense_to_individual_in_year(p, y, recipient, amount);
    when amount > 25.00 USD;
    then not deduction_allowed(p, y, Section274Meals, amount - 25.00 USD);
}
// The $4.00 imprinted-item and other (b)(1) exclusions from "gift" are NOT
// modelled — `gift_expense_to_individual_in_year` takes the classification
// as given (TECH_GAP). The `Section274Meals` `DeductionKind` bucket is
// reused for gifts (JUDGMENT CALL, same reasoning as section 267's reuse of
// `Section262PersonalNonDeductible`: no dedicated gift-expense kind exists
// yet in this package's enum).

// --- §274(k): business meals — not lavish, taxpayer present ----------------

pub relation food_or_beverage_lavish_or_extravagant(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the food or beverage expense is lavish or extravagant under the circumstances (section 274(k)(1)(A))";
}
pub relation taxpayer_or_employee_present_at_meal(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the taxpayer (or an employee of the taxpayer) is present at the furnishing of the food or beverages (section 274(k)(1)(B))";
}
@source(IRC_S274_K, quote = "No deduction shall be allowed under this chapter for the expense of any food or beverages unless")
rule BusinessMealsValidityCondition(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "no deduction for a food or beverage expense unless it is not lavish or extravagant and the taxpayer or an employee is present (section 274(k)(1))";
    when food_or_beverage_expense(p, y, item, amount);
    when taxpayer_or_employee_present_at_meal(p, y, item);
    when not_known(food_or_beverage_lavish_or_extravagant(p, y, item));
    then deduction_allowed(p, y, Section274Meals, amount);
}
@source(IRC_S274_K, quote = "such expense is not lavish or extravagant under the circumstances")
rule BusinessMealsDisallowedWhenLavish(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a lavish or extravagant food or beverage expense is not deductible under section 274(k)(1)(A)";
    when food_or_beverage_expense(p, y, item, amount);
    when food_or_beverage_lavish_or_extravagant(p, y, item);
    when not_known(food_beverage_274k_exception_applies(p, y, item));
    then not deduction_allowed(p, y, Section274Meals, amount);
}
// (k)(2) exceptions to the (k)(1) validity condition — cross-referencing
// (e)(2),(3),(4),(7),(8),(9) — are NOT modelled (this rule pair applies
// (k)(1) unconditionally); a scenario within one of those (e) exceptions
// would be wrongly gated by (k)(1) here — TECH_GAP, flagged rather than
// silently accepted as complete.

// (c) foreign travel allocation, (e)(2)-(9) the remaining exceptions to
// (a), (m) travel-as-education/luxury-water-travel/spousal-travel limits
// stay NOT DONE this session.
