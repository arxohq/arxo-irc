// Section 220 — Archer MSAs: stage 2b, part 2: the cut-off year consequences of subsection (i) and the
// reporting of subsection (j)(3)-(5) (TECH_GAPS G2764). Dates inside the cut-off year are (month, day)
// pairs, compared as month*100+day, because the language has no constructor of a date from a year.
// The stage 1 up-to-cut-off rule is guarded by the two relations defined here. Not modelled: the
// section 6693(a) penalty itself (`report_failure_penalty` states the $25 rate and the $5,000 ceiling);
// the exact contents of the trustee's report (a single fact of filing).

use self::{
    IRC_S220_I,
    IRC_S220_J,
    Individual,
    Person,
    TaxableYear,
    active_msa_participant_or_new_participant_of_participating_employer,
    cut_off_year,
};

pub relation calendar_year_of_taxable_year_220_cut_off(y: TaxableYear, ycal: Integer) kind empirical {
    label en official "the calendar year in which the taxable year begins";
}
pub relation taxable_year_begins_after_earlier_cut_off_year(y: TaxableYear) kind institutional {
    label en official "the taxable year begins after a cut-off year earlier than 2007 (section 220(i)(1))";
}
@source(IRC_S220_I, quote = "no individual shall be treated as an eligible individual for any taxable year beginning after the cut-off year unless")
rule TaxableYearAfterEarlierCutOffYear(y: TaxableYear, ycal: Integer, cy: Integer) strict {
    label en official "a taxable year beginning in a calendar year after an earlier-than-2007 cut-off year (section 220(i)(1),(2)(B))";
    when calendar_year_of_taxable_year_220_cut_off(y, ycal);
    when cut_off_year(cy);
    when cy < 2007;
    when ycal > cy;
    then taxable_year_begins_after_earlier_cut_off_year(y);
}

// --- (i)(3)(C): cut-off dates -----------------------------------------------------------------------------------------------------------------------

pub relation individual_plan_is_employer_plan_iii_I(p: Individual) kind empirical {
    label en official "the individual is described in section 220(c)(1)(A)(iii)(I): covered by a plan established and maintained by the individual's or the spouse's small employer";
}
pub relation individual_is_self_employed_iii_II(p: Individual) kind empirical {
    label en official "the individual is described in section 220(c)(1)(A)(iii)(II): a self-employed individual or spouse";
}
pub relation regular_enrollment_period_in_last_three_months_of_cut_off_year(p: Individual, cy: Integer) kind empirical {
    label en official "the regularly scheduled enrollment period for health plans of the individual's employer occurs during the last 3 months of the cut-off year (section 220(i)(3)(C)(ii))";
}
pub relation regular_enrollment_period_in_last_four_months_of_cut_off_year(p: Individual, cy: Integer) kind empirical {
    label en official "the regularly scheduled enrollment period occurs during the last 4 months of the cut-off year (1997 special rule, section 220(i)(3)(C)(iv)(II))";
}
pub relation cut_off_date_month_day(p: Individual, cy: Integer, month: Integer, day: Integer) kind institutional {
    label en official "the cut-off date for the individual in the cut-off year as a month and day (section 220(i)(3)(C))";
}
@source(IRC_S220_I, quote = "Except as otherwise provided in this subparagraph, the cut-off date is October 1 of the cut-off year.")
rule CutOffDateOctoberFirst(p: Individual, cy: Integer) strict {
    label en official "the general cut-off date is October 1 of the cut-off year (section 220(i)(3)(C)(i)); for 1997 it is one month earlier";
    when cut_off_year(cy);
    when individual_plan_is_employer_plan_iii_I(p);
    when cy != 1997;
    when not_known(regular_enrollment_period_in_last_three_months_of_cut_off_year(p, cy));
    then cut_off_date_month_day(p, cy, 10, 1);
}
@source(IRC_S220_I, quote = "the cut-off date is December 31 of the cut-off year")
rule CutOffDateDecemberThirtyFirstLateEnrollment(p: Individual, cy: Integer) strict {
    label en official "an employee whose employer's enrollment period is in the last 3 months has December 31 as the cut-off date (section 220(i)(3)(C)(ii))";
    when cut_off_year(cy);
    when individual_plan_is_employer_plan_iii_I(p);
    when cy != 1997;
    when regular_enrollment_period_in_last_three_months_of_cut_off_year(p, cy);
    then cut_off_date_month_day(p, cy, 12, 31);
}
@source(IRC_S220_I, quote = "the cut-off date is November 1 of the cut-off year")
rule CutOffDateSelfEmployedNovemberFirst(p: Individual, cy: Integer) strict {
    label en official "a self-employed individual's cut-off date is November 1 of the cut-off year (section 220(i)(3)(C)(iii)); for 1997 it is one month earlier";
    when cut_off_year(cy);
    when individual_is_self_employed_iii_II(p);
    when cy != 1997;
    then cut_off_date_month_day(p, cy, 11, 1);
}
@source(IRC_S220_I, quote = "each of the cut-off dates under clauses (i) and (iii) shall be 1 month earlier than the date determined without regard to this clause")
rule CutOffDate1997EmployeeSeptemberFirst(p: Individual) strict {
    label en official "if 1997 is the cut-off year the general cut-off date is September 1 (section 220(i)(3)(C)(iv)(I))";
    when cut_off_year(1997);
    when individual_plan_is_employer_plan_iii_I(p);
    when not_known(regular_enrollment_period_in_last_four_months_of_cut_off_year(p, 1997));
    then cut_off_date_month_day(p, 1997, 9, 1);
}
@source(IRC_S220_I, quote = "clause (ii) shall be applied by substituting \"4 months\" for \"3 months\"")
rule CutOffDate1997LateEnrollmentDecemberThirtyFirst(p: Individual) strict {
    label en official "for 1997 an enrollment period in the last 4 months gives December 31 (section 220(i)(3)(C)(iv)(II))";
    when cut_off_year(1997);
    when individual_plan_is_employer_plan_iii_I(p);
    when regular_enrollment_period_in_last_four_months_of_cut_off_year(p, 1997);
    then cut_off_date_month_day(p, 1997, 12, 31);
}
@source(IRC_S220_I, quote = "each of the cut-off dates under clauses (i) and (iii) shall be 1 month earlier than the date determined without regard to this clause")
rule CutOffDate1997SelfEmployedOctoberFirst(p: Individual) strict {
    label en official "if 1997 is the cut-off year the self-employed cut-off date is October 1 (section 220(i)(3)(C)(iv)(I))";
    when cut_off_year(1997);
    when individual_is_self_employed_iii_II(p);
    then cut_off_date_month_day(p, 1997, 10, 1);
}

// --- (i)(3)(B): cut-off years before 2007 ---------------------------------------------------------------------------------------------------------------

pub relation hdhp_coverage_start_month_day_in_cut_off_year(p: Individual, cy: Integer, month: Integer, day: Integer) kind empirical {
    label en official "the individual's coverage under a high deductible health plan began in the cut-off year on the month and day";
}
pub relation covered_under_hdhp_on_or_before_cut_off_date(p: Individual, cy: Integer) kind institutional {
    label en official "the individual is, on or before the cut-off date, covered under a high deductible health plan (section 220(i)(3)(B)(i))";
}
@source(IRC_S220_I, quote = "an individual shall not be treated as an eligible individual for any month of such year or an active MSA participant under paragraph (1)(A) unless such individual is, on or before the cut-off date, covered under a high deductible health plan")
rule CoveredOnOrBeforeCutOffDate(p: Individual, cy: Integer, cm: Integer, cd: Integer, hm: Integer, hd: Integer) strict {
    label en official "coverage begun no later than the cut-off date (compared as month*100+day) satisfies the cut-off year condition (section 220(i)(3)(B)(i))";
    when cut_off_date_month_day(p, cy, cm, cd);
    when hdhp_coverage_start_month_day_in_cut_off_year(p, cy, hm, hd);
    when hm * 100 + hd <= cm * 100 + cd;
    then covered_under_hdhp_on_or_before_cut_off_date(p, cy);
}
pub relation coverage_after_cut_off_date_in_earlier_cut_off_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "in a cut-off year before 2007 the individual was not covered on or before the cut-off date, so the individual is not an eligible individual for any month of that year (section 220(i)(3)(B)(i))";
}
pub relation cut_off_year_taxable_year(y: TaxableYear, cy: Integer) kind empirical {
    label en official "the taxable year is (within) the cut-off year";
}
@source(IRC_S220_I, quote = "In the case of a cut-off year before 2007")
rule EarlierCutOffYearCoverageAfterCutOffDate(p: Individual, y: TaxableYear, cy: Integer) strict {
    label en official "in an earlier cut-off year the individual without coverage by the cut-off date is not eligible for that year (section 220(i)(3)(B)(i))";
    when cut_off_year_taxable_year(y, cy);
    when cut_off_year(cy);
    when cy < 2007;
    when individual_plan_is_employer_plan_iii_I(p) or individual_is_self_employed_iii_II(p);
    when not_known(covered_under_hdhp_on_or_before_cut_off_date(p, cy));
    then coverage_after_cut_off_date_in_earlier_cut_off_year(p, y);
}

// --- (i)(4): MSA-participating employer -------------------------------------------------------------------------------------------------------------------

pub relation employer_made_excludable_contribution_to_employee_archer_msa_in_or_before_cut_off_year(employer: Person) kind empirical {
    label en official "the employer made a contribution to the Archer MSA of any employee during the cut-off year or any preceding calendar year which was excludable from gross income under section 106(b) (section 220(i)(4)(A))";
}
pub relation employees_of_employer_eligible_by_reason_of_employer_hdhp(employer: Person, count: Integer) kind empirical {
    label en official "the number of the employer's employees who are eligible individuals for any month of the cut-off year by reason of coverage under the employer's high deductible health plan (section 220(i)(4)(B))";
}
pub relation employees_who_each_contributed_at_least_100_deductible(employer: Person, count: Integer) kind empirical {
    label en official "the number of those employees who each made a contribution of at least $100 to their Archer MSAs, allowable as a deduction, for a taxable year ending with or within the cut-off year (section 220(i)(4)(B))";
}
pub relation small_employer_in_cut_off_year(employer: Person) kind empirical {
    label en official "the employer is a small employer (section 220(i)(4))";
}
pub relation msa_participating_employer(employer: Person) kind institutional {
    label en official "an MSA-participating employer within section 220(i)(4)";
}
@source(IRC_S220_I, quote = "such employer made any contribution to the Archer MSA of any employee during the cut-off year or any preceding calendar year which was excludable from gross income under section 106(b)")
rule MsaParticipatingEmployerByExcludableContribution(employer: Person) strict {
    label en official "a small employer with an excludable Archer MSA contribution is MSA-participating (section 220(i)(4)(A))";
    when small_employer_in_cut_off_year(employer);
    when employer_made_excludable_contribution_to_employee_archer_msa_in_or_before_cut_off_year(employer);
    then msa_participating_employer(employer);
}
@source(IRC_S220_I, quote = "at least 20 percent of the employees of such employer who are eligible individuals for any month of the cut-off year by reason of coverage under a high deductible health plan of such employer")
rule MsaParticipatingEmployerByTwentyPercentContributing(employer: Person, eligible: Integer, contributing: Integer) strict {
    label en official "a small employer of which at least 20 percent of the eligible employees each contributed at least $100 is MSA-participating (section 220(i)(4)(B)); 20 percent tested as contributing x 5 >= eligible";
    when small_employer_in_cut_off_year(employer);
    when employees_of_employer_eligible_by_reason_of_employer_hdhp(employer, eligible);
    when employees_who_each_contributed_at_least_100_deductible(employer, contributing);
    when eligible > 0;
    when contributing * 5 >= eligible;
    then msa_participating_employer(employer);
}
pub relation employer_offered_hdhp_coverage_on_or_before_cut_off_date(employer: Person, cy: Integer) kind empirical {
    label en official "the employer, on or before the cut-off date, offered coverage under a high deductible health plan to any employee (section 220(i)(3)(B)(ii))";
}
pub relation employer_not_msa_participating_in_earlier_cut_off_year(employer: Person, cy: Integer) kind institutional {
    label en official "in a cut-off year before 2007 an employer that did not offer high deductible coverage by the cut-off date is not an MSA-participating employer (section 220(i)(3)(B)(ii))";
}
@source(IRC_S220_I, quote = "an employer shall not be treated as an MSA-participating employer unless the employer, on or before the cut-off date, offered coverage under a high deductible health plan to any employee")
rule EmployerNotParticipatingWithoutOfferByCutOffDate(employer: Person, cy: Integer) strict {
    label en official "an employer without an offer by the cut-off date is not MSA-participating for an earlier cut-off year (section 220(i)(3)(B)(ii))";
    when cut_off_year(cy);
    when cy < 2007;
    when small_employer_in_cut_off_year(employer);
    when not_known(employer_offered_hdhp_coverage_on_or_before_cut_off_date(employer, cy));
    then employer_not_msa_participating_in_earlier_cut_off_year(employer, cy);
}

// --- (i)(1),(3)(A),(5): active participants and additional eligibility ------------------------------------------------------------------------------------------

pub relation contribution_excludable_under_106b_or_deductible_for_year(p: Individual, y: TaxableYear) kind empirical {
    label en official "a contribution into an Archer MSA of the individual was excludable from gross income under section 106(b) or allowable as a deduction under section 220 for the taxable year (section 220(i)(3)(A))";
}
pub relation active_msa_participant_for_year(p: Individual, y: TaxableYear) kind institutional {
    label en official "an active MSA participant for the taxable year (section 220(i)(3)(A))";
}
@source(IRC_S220_I, quote = "\"active MSA participant\" means, with respect to any taxable year, any individual who is the account holder of any Archer MSA into which any contribution was made")
rule ActiveMsaParticipantDefinition(p: Individual, y: TaxableYear) strict {
    label en official "the account holder into whose Archer MSA an excludable or deductible contribution was made for the year (section 220(i)(3)(A))";
    when contribution_excludable_under_106b_or_deductible_for_year(p, y);
    then active_msa_participant_for_year(p, y);
}
@source(IRC_S220_I, quote = "such individual was an active MSA participant for any taxable year ending on or before the close of the cut-off year")
rule ActiveParticipantBeforeOrThroughCutOffYear(p: Individual, y: TaxableYear, prior: TaxableYear) strict {
    label en official "an individual who was an active MSA participant for a year ending on or before the close of the cut-off year satisfies (i)(1)(A)";
    when eligibility_year_under_review_220(p, y);
    when active_msa_participant_for_year(p, prior);
    when taxable_year_ends_by_cut_off_year_close(prior);
    then active_msa_participant_or_new_participant_of_participating_employer(p, y);
}
pub relation eligibility_year_under_review_220(p: Individual, y: TaxableYear) kind empirical {
    label en official "the taxable year for which eligibility is reviewed";
}
pub relation taxable_year_ends_by_cut_off_year_close(y: TaxableYear) kind empirical {
    label en official "the taxable year ends on or before the close of the cut-off year";
}
pub relation first_became_active_participant_by_coverage_under_participating_employer_plan(p: Individual, y: TaxableYear, employer: Person) kind empirical {
    label en official "the individual first became an active MSA participant for a taxable year ending after the cut-off year by reason of coverage under a high deductible health plan of an MSA-participating employer (section 220(i)(1)(B))";
}
@source(IRC_S220_I, quote = "such individual first became an active MSA participant for a taxable year ending after the cut-off year by reason of coverage under a high deductible health plan of an MSA-participating employer")
rule NewParticipantOfMsaParticipatingEmployer(p: Individual, y: TaxableYear, employer: Person) strict {
    label en official "a new participant through an MSA-participating employer satisfies (i)(1)(B)";
    when first_became_active_participant_by_coverage_under_participating_employer_plan(p, y, employer);
    when msa_participating_employer(employer);
    then active_msa_participant_or_new_participant_of_participating_employer(p, y);
}
pub relation secretary_determines_limit_not_exceeded_for_year_after_cut_off_year(cy: Integer) kind empirical {
    label en official "the Secretary determines under subsection (j)(2)(A) that the numerical limit for the calendar year following a cut-off year described in paragraph (2)(B) has not been exceeded (section 220(i)(5)); for 1998 the figure is 750,000 instead of 600,000";
}
pub relation covered_under_hdhp_first_six_months_of_second_year_after_cut_off_year(p: Individual, cy: Integer) kind empirical {
    label en official "the individual is covered under a high deductible health plan during the first 6 months of the second calendar year following the cut-off year (section 220(i)(5)(A))";
}
pub relation contribution_made_to_archer_msa_for_that_coverage(p: Individual, cy: Integer) kind empirical {
    label en official "a contribution is made to any Archer MSA with respect to such coverage";
}
@source(IRC_S220_I, quote = "this subsection shall not apply to any otherwise eligible individual who is covered under a high deductible health plan during the first 6 months of the second calendar year following the cut-off year")
rule AdditionalEligibilityAfterCutOffYearTreatedAsActiveParticipant(p: Individual, y: TaxableYear, cy: Integer) strict {
    label en official "when the next year's limit is not exceeded, an individual covered in the first 6 months of the second year after the cut-off year is treated as an active MSA participant if a contribution is made (section 220(i)(5)(A))";
    when cut_off_year(cy);
    when cy < 2007;
    when secretary_determines_limit_not_exceeded_for_year_after_cut_off_year(cy + 1);
    when covered_under_hdhp_first_six_months_of_second_year_after_cut_off_year(p, cy);
    when contribution_made_to_archer_msa_for_that_coverage(p, cy);
    when cut_off_year_taxable_year(y, cy + 2);
    then active_msa_participant_or_new_participant_of_participating_employer(p, y);
}
pub relation employer_offers_hdhp_in_first_six_months_of_second_year_after_cut_off_year(employer: Person, cy: Integer) kind empirical {
    label en official "the employer offers coverage under a high deductible health plan to any employee during the 6-month period (section 220(i)(5)(B))";
}
@source(IRC_S220_I, quote = "any employer who offers coverage under a high deductible health plan to any employee during such 6-month period shall be treated as an MSA-participating employer")
rule EmployerTreatedParticipatingBySixMonthOffer(employer: Person, cy: Integer) strict {
    label en official "an employer offering high deductible coverage in the 6-month window is MSA-participating if the (i)(4) requirements are met (section 220(i)(5)(B))";
    when cut_off_year(cy);
    when cy < 2007;
    when secretary_determines_limit_not_exceeded_for_year_after_cut_off_year(cy + 1);
    when employer_offers_hdhp_in_first_six_months_of_second_year_after_cut_off_year(employer, cy);
    when small_employer_in_cut_off_year(employer);
    when employer_made_excludable_contribution_to_employee_archer_msa_in_or_before_cut_off_year(employer);
    then msa_participating_employer(employer);
}

// --- (j)(3): previously uninsured individuals ---------------------------------------------------------------------------------------------------------------

pub relation no_health_plan_coverage_other_than_disregarded_in_six_months_before_hdhp(p: Individual) kind empirical {
    label en official "the individual had no health plan coverage (other than coverage referred to in subsection (c)(1)(B)) at any time during the 6-month period before the high deductible health plan coverage commences (section 220(j)(3)(B))";
}
pub relation previously_uninsured_individual(p: Individual) kind institutional {
    label en official "a previously uninsured individual within section 220(j)(3)(B)";
}
@source(IRC_S220_J, quote = "the term \"previously uninsured individual\" means, with respect to any Archer MSA, any individual who had no health plan coverage")
rule PreviouslyUninsuredIndividualDefinition(p: Individual) strict {
    label en official "an individual without health plan coverage in the 6 months before the plan commenced is previously uninsured (section 220(j)(3)(B))";
    when no_health_plan_coverage_other_than_disregarded_in_six_months_before_hdhp(p);
    then previously_uninsured_individual(p);
}
pub relation archer_msa_of_individual(acct: Integer, p: Individual) kind empirical {
    label en official "the account holder of the Archer MSA";
}
pub relation archer_msa_counted_for_cut_off_determination(acct: Integer) kind institutional {
    label en official "the Archer MSA is counted in determining whether a calendar year is a cut-off year: not the MSA of a previously uninsured individual (section 220(j)(3)(A))";
}
@source(IRC_S220_J, quote = "The determination of whether any calendar year is a cut-off year shall be made by not counting the Archer MSA of any previously uninsured individual.")
rule ArcherMsaCountedUnlessPreviouslyUninsured(acct: Integer, p: Individual) defeasible {
    label en official "an Archer MSA is counted unless its holder is a previously uninsured individual (section 220(j)(3)(A))";
    when archer_msa_of_individual(acct, p);
    when not_known(previously_uninsured_individual(p));
    then archer_msa_counted_for_cut_off_determination(acct);
}

// --- (j)(4): trustee reports --------------------------------------------------------------------------------------------------------------------------------------

pub relation trustee_of_archer_msa_established_before_july_1(trustee: Person, cy: Integer) kind empirical {
    label en official "the person is the trustee of an Archer MSA established before July 1 of the calendar year (section 220(j)(4)(A))";
}
pub relation trustee_report_deadline_august_1(cy: Integer, deadline: Date) kind empirical {
    label en official "August 1 of the calendar year";
}
pub relation trustee_report_made_to_secretary(trustee: Person, cy: Integer) kind empirical {
    label en official "the trustee has made the report to the Secretary specifying the number of accounts, the name and TIN of each account holder and the number of accounts of previously uninsured individuals (section 220(j)(4)(A))";
}
@source(IRC_S220_J, quote = "Not later than August 1 of 1997, 1998, 1999, 2001, 2002, 2004, 2005, and 2006, each person who is the trustee of an Archer MSA established before July 1 of such calendar year shall make a report to the Secretary")
rule TrusteeReportDuty220j4A(trustee: Person, cy: Integer, deadline: Date) defeasible {
    label en official "each trustee of an Archer MSA established before July 1 must report by August 1 of 1997, 1998, 1999, 2001, 2002, 2004, 2005 and 2006 (section 220(j)(4)(A))";
    when trustee_of_archer_msa_established_before_july_1(trustee, cy);
    when cy >= 1997;
    when cy <= 2006;
    when cy != 2000;
    when cy != 2003;
    when trustee_report_deadline_august_1(cy, deadline);
    then duty S220jTrusteeAnnualReport {
        bearer trustee;
        goal achievement {
            condition trustee_report_made_to_secretary(trustee, cy);
            window [-infinity, deadline];
        }
    };
}
pub relation trustee_of_archer_msa_established_before_may_1_1997(trustee: Person) kind empirical {
    label en official "the person is the trustee of an Archer MSA established before May 1, 1997 (section 220(j)(4)(B))";
}
pub relation additional_report_1997_deadline_june_1(deadline: Date) kind empirical {
    label en official "June 1, 1997";
}
pub relation additional_report_1997_made(trustee: Person) kind empirical {
    label en official "the trustee has made the additional report for accounts established before May 1, 1997 (section 220(j)(4)(B))";
}
@source(IRC_S220_J, quote = "Not later than June 1, 1997, each person who is the trustee of an Archer MSA established before May 1, 1997, shall make an additional report")
rule TrusteeAdditionalReportDuty1997(trustee: Person, deadline: Date) defeasible {
    label en official "the trustee of an Archer MSA established before May 1, 1997 must file the additional report by June 1, 1997 (section 220(j)(4)(B))";
    when trustee_of_archer_msa_established_before_may_1_1997(trustee);
    when additional_report_1997_deadline_june_1(deadline);
    then duty S220jTrusteeAdditionalReport1997 {
        bearer trustee;
        goal achievement {
            condition additional_report_1997_made(trustee);
            window [-infinity, deadline];
        }
    };
}
pub relation number_of_report_failures_by_trustee(trustee: Person, failures: Integer) kind empirical {
    label en official "the number of reports required by section 220(j)(4) that the trustee failed to file";
}
pub relation report_failure_penalty(trustee: Person, amount: Money) kind institutional {
    label en official "the section 6693(a) penalty for failure to file the report, $25 per failure (instead of $50), the total for any trustee not exceeding $5,000 (section 220(j)(4)(C))";
}
@source(IRC_S220_J, quote = "the maximum penalty imposed on any trustee shall not exceed $5,000")
rule ReportFailurePenaltyTwentyFiveCappedFiveThousand(trustee: Person, failures: Integer) strict {
    label en official "penalty = min($25 x failures, $5,000) (section 220(j)(4)(C))";
    when number_of_report_failures_by_trustee(trustee, failures);
    then report_failure_penalty(trustee, min(25.00 USD * failures, 5000.00 USD));
}
pub relation archer_msa_of_person_for_aggregation(acct: Integer, holder: Individual) kind empirical {
    label en official "an Archer MSA of the individual";
}
pub relation spouses_married_to_each_other_220j(a: Individual, b: Individual) kind empirical {
    label en official "the individuals are married to each other";
}
pub relation accounts_treated_as_one_account_for_counting(acct1: Integer, acct2: Integer) kind institutional {
    label en official "all Archer MSAs of an individual, and all accounts of individuals married to each other, are treated as 1 account in determining the number of Archer MSAs (section 220(j)(4)(D))";
}
@source(IRC_S220_J, quote = "all Archer MSAs of an individual shall be treated as 1 account")
rule AccountsOfOneIndividualOneAccount(acct1: Integer, acct2: Integer, holder: Individual) strict {
    label en official "two accounts of the same individual count as one (section 220(j)(4)(D))";
    when archer_msa_of_person_for_aggregation(acct1, holder);
    when archer_msa_of_person_for_aggregation(acct2, holder);
    then accounts_treated_as_one_account_for_counting(acct1, acct2);
}
@source(IRC_S220_J, quote = "all accounts of individuals who are married to each other shall be treated as 1 account")
rule AccountsOfSpousesOneAccount(acct1: Integer, acct2: Integer, a: Individual, b: Individual) strict {
    label en official "the accounts of spouses count as one (section 220(j)(4)(D))";
    when archer_msa_of_person_for_aggregation(acct1, a);
    when archer_msa_of_person_for_aggregation(acct2, b);
    when spouses_married_to_each_other_220j(a, b);
    then accounts_treated_as_one_account_for_counting(acct1, acct2);
}

// --- (j)(5): the Secretary's determination -----------------------------------------------------------------------------------------------------------------

pub relation year_requires_cut_off_determination(cy: Integer, deadline: Date) kind empirical {
    label en official "a calendar year for which the Secretary must determine whether it is a cut-off year, with the deadline of October 1 of that year (section 220(j)(5))";
}
pub relation secretary_made_and_published_cut_off_determination(cy: Integer) kind empirical {
    label en official "the Secretary has made and published the determination that the calendar year is (or is not) a cut-off year (section 220(j)(5))";
}
@source(IRC_S220_J, quote = "Any determination under this subsection that a calendar year is a cut-off year shall be made by the Secretary and shall be published not later than October 1 of such year.")
rule SecretaryCutOffDeterminationDuty(cy: Integer, deadline: Date) defeasible {
    label en official "the Secretary must make and publish a cut-off year determination by October 1 of the year (section 220(j)(5))";
    when year_requires_cut_off_determination(cy, deadline);
    then duty S220jSecretaryPublishCutOffDetermination {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_made_and_published_cut_off_determination(cy);
            window [-infinity, deadline];
        }
    };
}
