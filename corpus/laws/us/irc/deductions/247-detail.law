// Section 247 — stage 2c detail (TECH_GAPS G2702, G2732): (c)(2) the 15-year treatment of the excess, (e)(2) the
// revocation of the election, (f) the earnings and profits, gain or loss, the Settlement Trust's income, holding period
// and basis, and (g) the Settlement Trust's election to defer income recognition with its recapture on an early
// disposition and the extended assessment period.
//
// Stage 1 interface changes (recorded): the three stage 1 rules that read `native_corporation_section_247_election_in_effect`
// carry a `not_known` guard for a revoked election.
//
// JUDGMENT CALLS: (1) the running total of contributions with the carryover of the 15 preceding years stays a case
// fact (the ledger is recursive over years, LDC-E4102); what is derived is the excess of a year and its treatment as a
// contribution in each of the next 15 years; (2) the Settlement Trust's income is the share of the contribution amount that
// the deduction allowed bears to the total of the year; (3) the tax due on an early disposition is the increase in tax,
// its interest, 10 percent of the increase and the interest on that addition, all given as amounts of the case except the
// 10 percent; (4) amounts are rounded to cents HALF_UP.

// === (c)(2): the excess carried to the 15 succeeding years ==============================================================

use self::{
    Corporation,
    IRC_S247_C,
    IRC_S247_E,
    IRC_S247_F,
    IRC_S247_G,
    Person,
    TaxableYear,
    adjusted_basis_of_contributed_property_247,
    contribution_by_native_corporation_to_settlement_trust,
    native_corporation_contribution_deduction_allowed,
    native_corporation_contribution_deduction_before_limit,
    native_corporation_contributions_total_with_carryover,
};

pub relation native_corporation_excess_contribution_of_year(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the aggregate contributions of the year over the taxable income limitation (section 247(c)(2))";
}
@source(IRC_S247_C, quote = "If the aggregate amount of contributions described in subsection (a) for any taxable year exceeds the limitation under paragraph (1)")
rule NativeCorporationExcessContribution(c: Corporation, y: TaxableYear, total: Money, allowed: Money) defeasible {
    label en official "the total less the deduction allowed";
    when native_corporation_contributions_total_with_carryover(c, y, total);
    when native_corporation_contribution_deduction_allowed(c, y, allowed);
    when total > allowed;
    then native_corporation_excess_contribution_of_year(c, y, total - allowed);
}
pub relation taxable_year_number_after_247(y: TaxableYear, later: TaxableYear, n: Integer) kind empirical {
    label en official "the later taxable year is the n-th taxable year after the year (section 247(c)(2))";
}
pub relation native_corporation_carryover_contribution_in_year(c: Corporation, from_year: TaxableYear, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of an earlier year treated as a contribution described in subsection (a) in a succeeding year, within 15 years (section 247(c)(2))";
}
@source(IRC_S247_C, quote = "such excess shall be treated as a contribution described in subsection (a) in each of the 15 succeeding years in order of time.")
rule NativeCorporationCarryoverContribution(c: Corporation, from_year: TaxableYear, y: TaxableYear, excess: Money, n: Integer) defeasible {
    label en official "the excess is a contribution in each of the next 15 years";
    when native_corporation_excess_contribution_of_year(c, from_year, excess);
    when taxable_year_number_after_247(from_year, y, n);
    when n >= 1;
    when n <= 15;
    then native_corporation_carryover_contribution_in_year(c, from_year, y, excess);
}

// === (e)(2): revocation of the election ===========================================================================================

pub relation revokes_section_247_election_by_timely_amended_return(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the Native Corporation revokes its election by a timely filed amendment or supplement to its income tax return (section 247(e)(2))";
}
pub relation timely_amendment_or_supplement_filed_for_247(c: Corporation, y: TaxableYear) kind empirical {
    label en official "the amendment or supplement to the return is timely filed (section 247(e)(2))";
}
pub relation native_corporation_section_247_election_revoked(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the section 247 election for the taxable year is revoked (section 247(e)(2))";
}
@source(IRC_S247_E, quote = "Any election made by a Native Corporation pursuant to this subsection may be revoked pursuant to a timely filed amendment or supplement to the income tax return of such Native Corporation.")
rule NativeCorporationRevocationPower(c: Corporation, y: TaxableYear) strict {
    label en official "the corporation may revoke its election by a timely amended return";
    when revokes_section_247_election_by_timely_amended_return(c, y);
    then power NativeCorporationSection247Revocation {
        holder c;
        over y;
        exercise revokes_section_247_election_by_timely_amended_return(c, y);
        valid_when timely_amendment_or_supplement_filed_for_247(c, y);
        effect create(native_corporation_section_247_election_revoked(c, y));
        window [@2017-12-22, infinity);
    };
}

// === (f): additional rules ===========================================================================================================

pub relation native_corporation_earnings_and_profits_reduction_247(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits of the Native Corporation are reduced by the deduction claimed, notwithstanding section 646(d)(2) (section 247(f)(1))";
}
@source(IRC_S247_F, quote = "the earnings and profits of such Native Corporation for such taxable year shall be reduced by the amount of such deduction.")
rule NativeCorporationEarningsAndProfitsReduced(c: Corporation, y: TaxableYear, allowed: Money) defeasible {
    label en official "the earnings and profits fall by the deduction allowed";
    when native_corporation_contribution_deduction_allowed(c, y, allowed);
    when allowed > 0.00 USD;
    then native_corporation_earnings_and_profits_reduction_247(c, y, allowed);
}
pub relation no_gain_or_loss_recognized_on_247_property_contribution(c: Corporation, y: TaxableYear, item: Integer) kind institutional {
    label en official "no gain or loss is recognized by the Native Corporation on a contribution of property for which a deduction is allowed (section 247(f)(2))";
}
@source(IRC_S247_F, quote = "No gain or loss shall be recognized by the Native Corporation with respect to a contribution of property for which a deduction is allowed under this section.")
rule NoGainOrLossOnPropertyContribution(c: Corporation, y: TaxableYear, item: Integer, amount: Money, allowed: Money) defeasible {
    label en official "a property contribution with a section 247 amount, when a deduction is allowed";
    when contribution_by_native_corporation_to_settlement_trust(c, y, item, false, amount);
    when native_corporation_contribution_deduction_before_limit(c, y, item, amount);
    when native_corporation_contribution_deduction_allowed(c, y, allowed);
    when allowed > 0.00 USD;
    then no_gain_or_loss_recognized_on_247_property_contribution(c, y, item);
}
pub relation settlement_trust_receives_contribution_in_year(trust: Person, c: Corporation, y: TaxableYear, item: Integer) kind empirical {
    label en official "the Settlement Trust actually receives the contribution in the taxable year (section 247(f)(3))";
}
pub relation settlement_trust_deferral_election_in_effect(trust: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the Settlement Trust's election under subsection (g) is in effect for the property (section 247(g)(3)(A))";
}
pub relation settlement_trust_income_from_contribution(trust: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the amount of the deduction allowed that the Settlement Trust includes in income in the year it actually receives the contribution, subject to the deferral election (section 247(f)(3))";
}
@source(IRC_S247_F, quote = "Subject to subsection (g), a Settlement Trust shall include in income the amount of any deduction allowed under this section in the taxable year in which the Settlement Trust actually receives such contribution.")
rule SettlementTrustIncludesDeduction(trust: Person, c: Corporation, y: TaxableYear, item: Integer, amount: Money, allowed: Money, total: Money) defeasible {
    label en official "the share of the contribution's amount that the deduction allowed bears to the total (JUDGMENT CALL)";
    when settlement_trust_receives_contribution_in_year(trust, c, y, item);
    when native_corporation_contribution_deduction_before_limit(c, y, item, amount);
    when native_corporation_contribution_deduction_allowed(c, y, allowed);
    when native_corporation_contributions_total_with_carryover(c, y, total);
    when total > 0.00 USD;
    when not_known(settlement_trust_deferral_election_in_effect(trust, y, item));
    then settlement_trust_income_from_contribution(trust, y, item, round(amount * (min(allowed, total) / total), 2, "HALF_UP"));
}
pub relation native_corporation_property_holding_start(c: Corporation, item: Integer, start: Date) kind empirical {
    label en official "the date the Native Corporation's holding of the property began (section 247(f)(4))";
}
pub relation settlement_trust_holding_period_start(trust: Person, item: Integer, start: Date) kind institutional {
    label en official "the Settlement Trust's holding period under section 1223 includes the period the Native Corporation held the property (section 247(f)(4))";
}
@source(IRC_S247_F, quote = "The holding period under section 1223 of the Settlement Trust shall include the period the property was held by the Native Corporation.")
rule SettlementTrustHoldingPeriodTacks(trust: Person, c: Corporation, y: TaxableYear, item: Integer, start: Date) strict {
    label en official "the holding period starts when the Native Corporation's began";
    when settlement_trust_receives_contribution_in_year(trust, c, y, item);
    when native_corporation_property_holding_start(c, item, start);
    then settlement_trust_holding_period_start(trust, item, start);
}
pub relation settlement_trust_basis_in_contributed_property(trust: Person, item: Integer, amount: Money) kind institutional {
    label en official "the Settlement Trust's basis: the lesser of the Native Corporation's adjusted basis and the fair market value of the property immediately before the contribution (section 247(f)(5))";
}
@source(IRC_S247_F, quote = "The basis that a Settlement Trust has for which a deduction is allowed under this section shall be equal to the lesser of—")
rule SettlementTrustBasis(trust: Person, c: Corporation, y: TaxableYear, item: Integer, fmv: Money, basis: Money) strict {
    label en official "the lesser of the corporation's adjusted basis and the fair market value";
    when settlement_trust_receives_contribution_in_year(trust, c, y, item);
    when contribution_by_native_corporation_to_settlement_trust(c, y, item, false, fmv);
    when adjusted_basis_of_contributed_property_247(c, y, item, basis);
    then settlement_trust_basis_in_contributed_property(trust, item, min(basis, fmv));
}

// === (g): the Settlement Trust's election to defer income recognition ==============================================================

pub relation settlement_trust_elects_deferral_for_property(trust: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the Settlement Trust elects to defer recognition of income related to the non-cash property contributed in the year, identifying it with reasonable particularity on its return (section 247(g)(1),(3)(A))";
}
pub relation contribution_of_property_other_than_cash_to_trust(trust: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the contribution consists of property other than cash (section 247(g)(1))";
}
@source(IRC_S247_G, quote = "For each taxable year, a Settlement Trust may elect to apply this subsection for any property described in paragraph (1) which was contributed during such year.")
rule SettlementTrustDeferralElectionPower(trust: Person, y: TaxableYear, item: Integer) strict {
    label en official "the trust may elect to defer income on a non-cash contribution of the year, effective solely for that year";
    when settlement_trust_elects_deferral_for_property(trust, y, item);
    then power SettlementTrustDeferralElection {
        holder trust;
        over item;
        exercise settlement_trust_elects_deferral_for_property(trust, y, item);
        valid_when contribution_of_property_other_than_cash_to_trust(trust, y, item);
        effect create(settlement_trust_deferral_election_in_effect(trust, y, item));
        window [@2017-12-22, infinity);
    };
}
pub relation revokes_settlement_trust_deferral_election(trust: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the Settlement Trust revokes its election by a timely filed amendment or supplement to its return (section 247(g)(3)(B))";
}
pub relation timely_amendment_filed_by_settlement_trust(trust: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "the amendment or supplement is timely filed (section 247(g)(3)(B))";
}
pub relation settlement_trust_deferral_election_revoked(trust: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "the deferral election for the property is revoked (section 247(g)(3)(B))";
}
@source(IRC_S247_G, quote = "Any election made by a Settlement Trust pursuant to this subsection may be revoked pursuant to a timely filed amendment or supplement to the income tax return of such Settlement Trust.")
rule SettlementTrustDeferralRevocationPower(trust: Person, y: TaxableYear, item: Integer) strict {
    label en official "the trust may revoke by a timely amended return";
    when revokes_settlement_trust_deferral_election(trust, y, item);
    then power SettlementTrustDeferralRevocation {
        holder trust;
        over item;
        exercise revokes_settlement_trust_deferral_election(trust, y, item);
        valid_when timely_amendment_filed_by_settlement_trust(trust, y, item);
        effect create(settlement_trust_deferral_election_revoked(trust, y, item));
        window [@2017-12-22, infinity);
    };
}
pub relation deferred_income_amount(trust: Person, item: Integer, amount: Money) kind empirical {
    label en official "the income that would have been included at the time of the contribution under subsection (f)(3) but for the election (section 247(g)(2)(A))";
}
pub relation gain_realized_on_sale_of_deferred_property(trust: Person, item: Integer, amount: Money) kind empirical {
    label en official "the income or gain realized on the sale or exchange of the deferred property (section 247(g)(2))";
}
pub relation deferred_property_gain_ordinary_portion(trust: Person, item: Integer, amount: Money) kind institutional {
    label en official "the part of the gain, up to the deferred income, that is ordinary income (section 247(g)(2)(A))";
}
@source(IRC_S247_G, quote = "(A) for such amount of the income or gain as is equal to or less than the amount of income which would be included in income at the time of contribution under subsection (f)(3) but for the taxpayer's election under this subsection, ordinary income, and")
rule DeferredPropertyGainOrdinaryPortion(trust: Person, item: Integer, gain: Money, deferred: Money) strict {
    label en official "the lesser of the gain and the deferred income";
    when gain_realized_on_sale_of_deferred_property(trust, item, gain);
    when deferred_income_amount(trust, item, deferred);
    then deferred_property_gain_ordinary_portion(trust, item, min(gain, deferred));
}
pub relation deferred_property_gain_other_portion(trust: Person, item: Integer, amount: Money) kind institutional {
    label en official "the part of the gain above the deferred income, with the character it would have had without the election (section 247(g)(2)(B))";
}
@source(IRC_S247_G, quote = "(B) for any amounts of the income or gain which are in excess of the amount of income which would be included in income at the time of contribution under subsection (f)(3) but for the taxpayer's election under this subsection, having the same character as if this subsection did not apply.")
rule DeferredPropertyGainOtherPortion(trust: Person, item: Integer, gain: Money, deferred: Money) strict {
    label en official "the gain in excess of the deferred income";
    when gain_realized_on_sale_of_deferred_property(trust, item, gain);
    when deferred_income_amount(trust, item, deferred);
    when gain > deferred;
    then deferred_property_gain_other_portion(trust, item, gain - deferred);
}

// --- (g)(3)(C): an early disposition -------------------------------------------------------------------------------------------------

pub relation deferred_property_disposed_in_first_subsequent_year(trust: Person, item: Integer, y: TaxableYear) kind empirical {
    label en official "the property is disposed of within the first taxable year subsequent to the year of contribution (section 247(g)(3)(C)(i))";
}
pub relation deferral_election_disregarded_on_early_disposition(trust: Person, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 247 is applied as if the election had not been made (section 247(g)(3)(C)(i)(I))";
}
@source(IRC_S247_G, quote = "(I) this section shall be applied as if the election under this subsection had not been made,")
rule DeferralElectionDisregardedOnEarlyDisposition(trust: Person, y: TaxableYear, item: Integer, disposed: TaxableYear) strict {
    label en official "an elected property disposed of within the first later year";
    when settlement_trust_deferral_election_in_effect(trust, y, item);
    when deferred_property_disposed_in_first_subsequent_year(trust, item, disposed);
    then deferral_election_disregarded_on_early_disposition(trust, y, item);
}
pub relation early_disposition_income_included_in_contribution_year(trust: Person, y: TaxableYear, item: Integer, amount: Money) kind institutional {
    label en official "the income that would have been included in the year of contribution is included in that year (section 247(g)(3)(C)(i)(II))";
}
@source(IRC_S247_G, quote = "(II) any income or gain which would have been included in the year of contribution under subsection (f)(3) but for the taxpayer's election under this subsection shall be included in income for the taxable year of such contribution, and")
rule EarlyDispositionIncomeIncluded(trust: Person, y: TaxableYear, item: Integer, deferred: Money) strict {
    label en official "the deferred income is included in the contribution year";
    when deferral_election_disregarded_on_early_disposition(trust, y, item);
    when deferred_income_amount(trust, item, deferred);
    then early_disposition_income_included_in_contribution_year(trust, y, item, deferred);
}
pub relation increase_in_tax_from_inclusion(trust: Person, item: Integer, amount: Money) kind empirical {
    label en official "the increase in tax resulting from the inclusion (section 247(g)(3)(C)(i)(III))";
}
pub relation interest_on_increase_in_tax(trust: Person, item: Integer, amount: Money) kind empirical {
    label en official "the interest on the increase in tax (section 247(g)(3)(C)(i)(III))";
}
pub relation interest_on_additional_ten_percent_amount(trust: Person, item: Integer, amount: Money) kind empirical {
    label en official "the interest on the 10 percent addition (section 247(g)(3)(C)(i)(III) 'with interest')";
}
pub relation additional_ten_percent_of_increase(trust: Person, item: Integer, amount: Money) kind institutional {
    label en official "10 percent of the amount of the increase in tax (section 247(g)(3)(C)(i)(III))";
}
@source(IRC_S247_G, quote = "increased by 10 percent of the amount of such increase with interest.")
rule AdditionalTenPercentOfIncrease(trust: Person, y: TaxableYear, item: Integer, increase: Money) strict {
    label en official "10 percent of the increase";
    when deferral_election_disregarded_on_early_disposition(trust, y, item);
    when increase_in_tax_from_inclusion(trust, item, increase);
    then additional_ten_percent_of_increase(trust, item, round(increase * 0.10, 2, "HALF_UP"));
}
pub relation settlement_trust_tax_payable_on_early_disposition(trust: Person, item: Integer, amount: Money) kind institutional {
    label en official "the amount the Settlement Trust pays on an early disposition: the increase in tax, its interest, 10 percent of the increase and the interest on it (section 247(g)(3)(C)(i)(III))";
}
@source(IRC_S247_G, quote = "(III) the Settlement Trust shall pay any increase in tax resulting from such inclusion, including any applicable interest, and increased by 10 percent of the amount of such increase with interest.")
rule SettlementTrustTaxPayableOnEarlyDisposition(trust: Person, item: Integer, increase: Money, interest: Money, addition: Money, addition_interest: Money) strict {
    label en official "the increase, its interest, the 10 percent addition and its interest";
    when increase_in_tax_from_inclusion(trust, item, increase);
    when interest_on_increase_in_tax(trust, item, interest);
    when additional_ten_percent_of_increase(trust, item, addition);
    when interest_on_additional_ten_percent_amount(trust, item, addition_interest);
    then settlement_trust_tax_payable_on_early_disposition(trust, item, increase + interest + addition + addition_interest);
}
pub relation deferral_election_return_filed_on(trust: Person, item: Integer, filed: Date) kind empirical {
    label en official "the date the return making the election for the property was filed (section 247(g)(3)(C)(ii))";
}
pub relation assessment_deadline_for_early_disposition_amount(trust: Person, item: Integer, deadline: Date) kind institutional {
    label en official "the amount may be assessed, or a court proceeding begun without assessment, within 4 years after the return with the election was filed, notwithstanding section 6501(a) (section 247(g)(3)(C)(ii))";
}
@source(IRC_S247_G, quote = "Notwithstanding section 6501(a), any amount described in subclause (III) of clause (i) may be assessed, or a proceeding in court with respect to such amount may be initiated without assessment, within 4 years after the date on which the return making the election under this subsection for such property was filed.")
rule AssessmentDeadlineEarlyDisposition(trust: Person, item: Integer, filed: Date) strict {
    label en official "4 years after the return with the election was filed";
    when deferral_election_return_filed_on(trust, item, filed);
    then assessment_deadline_for_early_disposition_amount(trust, item, add_calendar_period(filed, 4 calendar_year));
}
