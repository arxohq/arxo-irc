// Section 165 — Losses. Stage 1 (IRC-06), priority section.
//
// Scope: (a)-(c) general rule and individual limitation; (d) wagering
// losses, including Pub. L. 119-21 section 70114's replacement (90% of
// losses, allowed only to the extent of gains, from 2026); (g) worthless
// securities; (h) casualty/theft dollar and percentage floors, plus
// Pub. L. 119-21 section 70109's permanent extension of the federally-
// declared/State-declared-disaster limitation; (i) disaster loss election.

use self::{
    DeductionKind,
    IRC_S165_A,
    IRC_S165_C,
    IRC_S165_D,
    IRC_S165_G,
    IRC_S165_H,
    Individual,
    Person,
    TaxableYear,
    deduction_allowed,
};

pub relation loss_sustained(p: Person, y: TaxableYear, item: Integer, amount: Money) kind empirical {
    label en official "a loss sustained during the taxable year and not compensated for by insurance or otherwise (section 165(a))";
}
pub relation loss_of_individual_within_c3(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a loss of an individual within section 165(c)(3) (personal casualty or theft loss, not connected with a trade or business or a transaction entered into for profit)";
}
pub relation loss_connected_with_trade_or_business_or_profit_transaction(p: Person, y: TaxableYear, item: Integer) kind empirical {
    label en official "a loss connected with a trade or business (section 165(c)(1)) or a transaction entered into for profit though not connected with a trade or business (section 165(c)(2))";
}

@source(IRC_S165_A, quote = "There shall be allowed as a deduction any loss sustained during the taxable year and not compensated for by insurance or otherwise")
rule LossGeneralRuleAllowed(p: Person, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a loss not compensated by insurance or otherwise is allowed as a deduction (section 165(a)), subject to the section 165(c) individual limitation and the (d)/(h) special rules";
    when loss_sustained(p, y, item, amount);
    when not_known(loss_of_individual_within_c3(p, y, item));
    then deduction_allowed(p, y, Section165Losses, amount);
}
@source(IRC_S165_C, quote = "In the case of an individual, the deduction under subsection (a) shall be limited to")
rule IndividualLossLimitedToBusinessProfitOrCasualty(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "for an individual, section 165(a) is limited to losses connected with a trade or business, a transaction entered into for profit, or a section 165(c)(3) casualty/theft loss (section 165(c))";
    when loss_sustained(p, y, item, amount);
    when loss_connected_with_trade_or_business_or_profit_transaction(p, y, item);
    then deduction_allowed(p, y, Section165Losses, amount);
}
@source(IRC_S165_C, quote = "losses of property not connected with a trade or business or a transaction entered into for profit, if such losses arise from fire, storm, shipwreck, or other casualty, or from theft")
rule IndividualCasualtyLossWithinC3NotDeductedDirectly(p: Individual, y: TaxableYear, item: Integer, amount: Money) strict {
    label en official "a section 165(c)(3) personal casualty/theft loss is not deducted directly under the general rule — it is governed by the section 165(h) dollar and percentage floors instead (see below)";
    when loss_of_individual_within_c3(p, y, item);
    when loss_sustained(p, y, item, amount);
    then not deduction_allowed(p, y, Section165Losses, amount);
}
// (the negative conclusion here is superseded, for the NET amount surviving
// the (h) floors, by `PersonalCasualtyLossAllowedAfterFloors` below; the two
// operate on different quantities — the gross item versus the post-floor
// aggregate — so they do not directly conflict on the same `amount`.)

// --- §165(g): worthless securities ---------------------------------------------

pub relation security_worthless_during_year(p: Person, y: TaxableYear, item: Integer, basis: Money) kind empirical {
    label en official "a security which is a capital asset becomes worthless during the taxable year (section 165(g)(1))";
}
@source(IRC_S165_G, quote = "the loss resulting therefrom shall, for purposes of this subtitle, be treated as a loss from the sale or exchange, on the last day of the taxable year, of a capital asset")
rule WorthlessSecurityLossDeemedYearEndCapitalLoss(p: Person, y: TaxableYear, item: Integer, basis: Money) strict {
    label en official "a worthless security's loss is treated as a capital loss from a deemed sale or exchange on the last day of the taxable year (section 165(g)(1)) — classification, not itself an amount computation (the amount is the adjusted basis, a property-transactions concept)";
    when security_worthless_during_year(p, y, item, basis);
    then deduction_allowed(p, y, Section165Losses, basis);
}
// classification note: whether the resulting loss is ORDINARY or CAPITAL
// (and the capital-loss limitation that follows) is `property-transactions`'
// concern (pending institutional dependency); this rule records only that
// section 165(g) converts a worthless-security event into a loss item.

// --- §165(d): wagering losses ---------------------------------------------------

pub relation wagering_losses_for_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "losses from wagering transactions during the taxable year, including otherwise-allowable deductions incurred in carrying on the wagering activity (section 165(d))";
}
pub relation wagering_gains_for_year(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "gains from wagering transactions during the taxable year (section 165(d))";
}

@source(IRC_S165_D, quote = "Losses from wagering transactions shall be allowed only to the extent of the gains from such transactions")
rule WageringLossesLimitedToGainsPre2026(p: Person, y: TaxableYear, losses: Money, gains: Money) strict {
    label en official "before 2026 (pre-Pub.L.119-21 text): wagering losses are deductible only to the extent of wagering gains, dollar for dollar";
    effective (-infinity, @2026-01-01);
    when wagering_losses_for_year(p, y, losses);
    when wagering_gains_for_year(p, y, gains);
    when losses <= gains;
    then deduction_allowed(p, y, Section165Losses, losses);
}
@source(IRC_S165_D, quote = "Losses from wagering transactions shall be allowed only to the extent of the gains from such transactions")
rule WageringLossesCappedAtGainsPre2026(p: Person, y: TaxableYear, losses: Money, gains: Money) strict {
    label en official "before 2026: wagering losses exceeding gains are capped at the amount of gains";
    effective (-infinity, @2026-01-01);
    when wagering_losses_for_year(p, y, losses);
    when wagering_gains_for_year(p, y, gains);
    when losses > gains;
    then deduction_allowed(p, y, Section165Losses, gains);
}
@source(us.irc.temporal::PL119_21_S70114, relation = derives_from, quote = "shall be equal to 90 percent of the amount of such losses during such taxable year")
rule WageringLossDeductionNinetyPercentFrom2026(p: Person, y: TaxableYear, losses: Money, gains: Money) strict {
    label en official "for taxable years beginning after December 31, 2025 (Pub. L. 119-21 section 70114): the wagering-loss deduction is 90% of losses, further capped at the amount of gains";
    effective [@2026-01-01, infinity);
    when wagering_losses_for_year(p, y, losses);
    when wagering_gains_for_year(p, y, gains);
    when round(losses * 0.90, 2, "HALF_UP") <= gains;
    then deduction_allowed(p, y, Section165Losses, round(losses * 0.90, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70114, relation = derives_from, quote = "shall be allowed only to the extent of the gains from such transactions during such taxable year")
rule WageringLossDeductionNinetyPercentCappedAtGainsFrom2026(p: Person, y: TaxableYear, losses: Money, gains: Money) strict {
    label en official "for taxable years beginning after December 31, 2025: when 90% of losses exceeds gains, the deduction is capped at gains (Pub. L. 119-21 section 70114)";
    effective [@2026-01-01, infinity);
    when wagering_losses_for_year(p, y, losses);
    when wagering_gains_for_year(p, y, gains);
    when round(losses * 0.90, 2, "HALF_UP") > gains;
    then deduction_allowed(p, y, Section165Losses, gains);
}

// --- §165(h): casualty/theft dollar and percentage floors ----------------------

pub relation personal_casualty_loss_per_event(p: Individual, y: TaxableYear, evt: Integer, amount: Money) kind empirical {
    label en official "the amount of a personal casualty loss (section 165(c)(3)) from a single casualty or theft event, before the section 165(h)(1) per-event floor (section 165(h)(3)(B))";
}
pub relation personal_casualty_gains_for_year(p: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "personal casualty gains for the taxable year (section 165(h)(3)(A))";
}
pub relation federally_or_state_declared_disaster_loss(p: Individual, y: TaxableYear, evt: Integer) kind empirical {
    label en official "the personal casualty loss is attributable to a Federally declared disaster (section 165(i)(5)) or, from the taxable years Pub. L. 119-21 section 70109 governs, a State declared disaster";
}
pub relation adjusted_gross_income_for_165h(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted gross income for the section 165(h)(2) 10%-of-AGI floor (section 62)";
}

@source(IRC_S165_H, quote = "shall be allowed only to the extent that the amount of the loss to such individual arising from each casualty, or from each theft, exceeds $500 ($100 for taxable years beginning after December 31, 2009)")
rule PerEventCasualtyFloorHundredDollars(p: Individual, y: TaxableYear, evt: Integer, gross_loss: Money) strict {
    label en official "for taxable years beginning after December 31, 2009: each casualty/theft event's loss is reduced by a $100 per-event floor before aggregation (section 165(h)(1))";
    effective [@2010-01-01, infinity);
    when personal_casualty_loss_per_event(p, y, evt, gross_loss);
    when gross_loss > 100.00 USD;
    then personal_casualty_loss_net_of_event_floor(p, y, evt, gross_loss - 100.00 USD);
}
pub relation personal_casualty_loss_net_of_event_floor(p: Individual, y: TaxableYear, evt: Integer, amount: Money) kind institutional {
    label en official "a personal casualty loss after the section 165(h)(1) per-event $100 floor";
}
pub relation personal_casualty_losses_for_year_net_of_event_floor(p: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of personal casualty losses for the taxable year, after the per-event floor and after the section 165(h)(5) disaster limitation, before the 10%-of-AGI floor";
}

@source(IRC_S165_H, quote = "such losses shall be allowed for the taxable year only to the extent of the sum of")
rule NetCasualtyLossAllowedAboveTenPercentAgi(p: Individual, y: TaxableYear, losses: Money, gains: Money, agi: Money) strict {
    label en official "personal casualty losses exceeding personal casualty gains are allowed only to the extent of the gains plus the excess over 10% of AGI (section 165(h)(2)(A))";
    when personal_casualty_losses_for_year_net_of_event_floor(p, y, losses);
    when personal_casualty_gains_for_year(p, y, gains);
    when adjusted_gross_income_for_165h(p, y, agi);
    when losses > gains;
    when (losses - gains) > round(agi * 0.10, 2, "HALF_UP");
    then deduction_allowed(p, y, Section165Losses, gains + (losses - gains) - round(agi * 0.10, 2, "HALF_UP"));
}
@source(IRC_S165_H, quote = "such losses shall be allowed for the taxable year only to the extent of the sum of")
rule NetCasualtyLossBelowTenPercentAgiFullyDisallowedExcess(p: Individual, y: TaxableYear, losses: Money, gains: Money, agi: Money) strict {
    label en official "when the excess of losses over gains does not exceed 10% of AGI, only the gains-offsetting portion is allowed (section 165(h)(2)(A))";
    when personal_casualty_losses_for_year_net_of_event_floor(p, y, losses);
    when personal_casualty_gains_for_year(p, y, gains);
    when adjusted_gross_income_for_165h(p, y, agi);
    when losses > gains;
    when (losses - gains) <= round(agi * 0.10, 2, "HALF_UP");
    then deduction_allowed(p, y, Section165Losses, gains);
}

@source(IRC_S165_H, quote = "any personal casualty loss which (but for this paragraph) would be deductible in a taxable year beginning after December 31, 2017, and before January 1, 2026, shall be allowed as a deduction under subsection (a) only to the extent it is attributable to a Federally declared disaster")
rule CasualtyLossLimitedToDeclaredDisasterWindow(p: Individual, y: TaxableYear, evt: Integer, amount: Money) strict {
    label en official "for a taxable year beginning after December 31, 2017 (pre-Pub.L.119-21 window: before January 1, 2026): a personal casualty loss is deductible only to the extent attributable to a Federally declared disaster (section 165(h)(5)(A))";
    effective [@2018-01-01, @2026-01-01);
    when personal_casualty_loss_net_of_event_floor(p, y, evt, amount);
    when not_known(federally_or_state_declared_disaster_loss(p, y, evt));
    then not deduction_allowed(p, y, Section165Losses, amount);
}
@source(us.irc.temporal::PL119_21_S70109, relation = derives_from, quote = "and before January 1, 2026")
rule CasualtyLossLimitedToDeclaredDisasterPermanentFrom2026(p: Individual, y: TaxableYear, evt: Integer, amount: Money) strict {
    label en official "Pub. L. 119-21 section 70109 strikes the 2026 sunset: for taxable years beginning after December 31, 2017 (including 2026 and later, permanently), a personal casualty loss not attributable to a Federally or State declared disaster remains non-deductible";
    effective [@2026-01-01, infinity);
    when personal_casualty_loss_net_of_event_floor(p, y, evt, amount);
    when not_known(federally_or_state_declared_disaster_loss(p, y, evt));
    then not deduction_allowed(p, y, Section165Losses, amount);
}
// (h)(4) special rules (joint returns as one individual, estates/trusts AGI,
// coordination with estate tax, insurance-claim requirement) and (i)
// (election to deduct a disaster loss in the preceding year) stay
// "stage 2".
