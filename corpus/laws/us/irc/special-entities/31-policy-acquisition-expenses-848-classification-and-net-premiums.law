// Section 848(b)(3)-(4), (d), (e), (f), (g) (capitalization of policy
// acquisition expenses: the controlled-group and reinsurance rules of (b),
// net premiums, the classification of contracts, the negative net premium
// rule and the ceding commission rule).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. Contracts are classified from asserted facts about the contract
// (life insurance, annuity, noncancellable accident and health, the
// exceptions of (e)(1)(B), the group life and long-term care markers) into
// the three categories of (c)(1). Premium items are itemised
// (`us.irc.core::Payment`): the gross items are the section 803(b) included
// items of module 28 (less the section 808(e) deemed premiums, which (d)(3)
// disregards), the deductions are the return premiums and the reinsurance
// premiums taxed to an insurance company (d)(4)(A); items are attached to a
// contract by `premium_item_contract_848`. Sums by category are sums over
// derived items (the section 111 runtime subset, TECH-GAPS G4903). The three
// net-premium relations of module 10 are institutional and derived from
// these sums; a case may still assert them directly.

// ---- Section 848(e): classification of contracts ----

use self::{
    Contract,
    IRC_S848_B,
    IRC_S848_D,
    IRC_S848_E,
    IRC_S848_F,
    IRC_S848_G,
    Person,
    TaxableYear,
    amount_amortized_over_60_months_848b,
    computations_under_accrual_or_permitted_combination_811a,
    dividend_treated_as_returned_as_premium_808e,
    included_premium_item_803b1,
    insurance_company_in_group_for_848b3,
    net_premiums_annuity_848c1A,
    net_premiums_group_life_848c1B,
    net_premiums_other_848c1C,
    pension_plan_contract_818a,
    qualified_foreign_contract_807e3B,
    return_premium_item_803a1B,
    section_848b1_five_million_threshold_after_phaseout,
    specified_policy_acquisition_expenses,
    specified_policy_acquisition_expenses_ceiling_848c1,
    specified_policy_acquisition_expenses_ceiling_before_848f,
    treated_as_noncancellable_816e,
};

pub relation life_insurance_contract_848e1A(k: Contract) kind empirical {
    label en unofficial "the contract is a life insurance contract";
}
pub relation annuity_contract_848e1A(k: Contract) kind empirical {
    label en unofficial "the contract is an annuity contract";
}
pub relation noncancellable_health_contract_848e1A(k: Contract) kind empirical {
    label en unofficial "the contract is a noncancellable accident and health insurance contract (guaranteed renewable contracts are treated as noncancellable by section 816(e), module 22)";
}
pub relation flight_insurance_or_similar_848e1Bii(k: Contract) kind empirical {
    label en unofficial "the contract is a flight insurance or similar contract";
}
pub relation archer_msa_contract_848e1Biv(k: Contract) kind empirical {
    label en unofficial "the contract is an Archer MSA (section 220(d))";
}
pub relation health_savings_account_contract_848e1Bv(k: Contract) kind empirical {
    label en unofficial "the contract is a health savings account (section 223(d))";
}
pub relation specified_insurance_contract_base_848e1A(k: Contract) kind institutional {
    label en official "a life insurance, annuity or noncancellable accident and health insurance contract (or a combination), before the exceptions";
}
@source(IRC_S848_E, quote = "the term \"specified insurance contract\" means any life insurance, annuity, or noncancellable accident and health insurance contract (or any combination thereof)")
rule Section848e1ALife(k: Contract) strict {
    label en official "section 848(e)(1)(A): a life insurance contract";
    when life_insurance_contract_848e1A(k);
    then specified_insurance_contract_base_848e1A(k);
}
@source(IRC_S848_E, quote = "the term \"specified insurance contract\" means any life insurance, annuity, or noncancellable accident and health insurance contract (or any combination thereof)")
rule Section848e1AAnnuity(k: Contract) strict {
    label en official "section 848(e)(1)(A): an annuity contract";
    when annuity_contract_848e1A(k);
    then specified_insurance_contract_base_848e1A(k);
}
@source(IRC_S848_E, quote = "the term \"specified insurance contract\" means any life insurance, annuity, or noncancellable accident and health insurance contract (or any combination thereof)")
rule Section848e1ANoncancellableHealth(k: Contract) strict {
    label en official "section 848(e)(1)(A): a noncancellable accident and health insurance contract";
    when noncancellable_health_contract_848e1A(k);
    then specified_insurance_contract_base_848e1A(k);
}
@source(IRC_S848_E, quote = "the term \"specified insurance contract\" means any life insurance, annuity, or noncancellable accident and health insurance contract (or any combination thereof)")
rule Section848e1AGuaranteedRenewable(k: Contract) strict {
    label en official "section 848(e)(1)(A) with (e)(4) and section 816(e): a guaranteed renewable contract is treated as noncancellable";
    when treated_as_noncancellable_816e(k);
    then specified_insurance_contract_base_848e1A(k);
}
pub relation specified_insurance_contract_848e1(k: Contract) kind institutional {
    label en official "the contract is a specified insurance contract: within (e)(1)(A) and none of the exceptions of (e)(1)(B)";
}
@source(IRC_S848_E, quote = "The term \"specified insurance contract\" shall not include")
rule Section848e1SpecifiedContract(k: Contract) defeasible {
    label en official "section 848(e)(1): a base contract that is not a pension plan contract, flight insurance, a qualified foreign contract, an Archer MSA or a health savings account";
    when specified_insurance_contract_base_848e1A(k);
    when not_known(pension_plan_contract_818a(k));
    when not_known(flight_insurance_or_similar_848e1Bii(k));
    when not_known(qualified_foreign_contract_807e3B(k));
    when not_known(archer_msa_contract_848e1Biv(k));
    when not_known(health_savings_account_contract_848e1Bv(k));
    then specified_insurance_contract_848e1(k);
}
pub relation group_covers_individuals_by_relationship_848e2A(k: Contract) kind empirical {
    label en unofficial "the contract covers a group of individuals defined by reference to employment relationship, membership in an organization, or a similar factor";
}
pub relation premiums_determined_on_group_basis_848e2B(k: Contract) kind empirical {
    label en unofficial "the premiums for the contract are determined on a group basis";
}
pub relation proceeds_payable_to_persons_other_than_employer_848e2C(k: Contract) kind empirical {
    label en unofficial "the proceeds are payable to (or for the benefit of) persons other than the employer of the insured, an organization to which the insured belongs, or another similar person";
}
pub relation group_life_insurance_contract_848e2(k: Contract) kind institutional {
    label en official "the contract is a group life insurance contract";
}
@source(IRC_S848_E, quote = "The term \"group life insurance contract\" means any life insurance contract")
rule Section848e2GroupLife(k: Contract) strict {
    label en official "section 848(e)(2): a life insurance contract on a group, priced on a group basis, payable to others than the employer or organization";
    when life_insurance_contract_848e1A(k);
    when group_covers_individuals_by_relationship_848e2A(k);
    when premiums_determined_on_group_basis_848e2B(k);
    when proceeds_payable_to_persons_other_than_employer_848e2C(k);
    then group_life_insurance_contract_848e2(k);
}
pub relation annuity_combined_with_noncancellable_health_848e3(k: Contract) kind empirical {
    label en unofficial "the annuity contract is combined with noncancellable accident and health insurance";
}
pub relation includes_qualified_ltc_contract_848e6(k: Contract) kind empirical {
    label en unofficial "the annuity or life insurance contract includes a qualified long-term care insurance contract as a part of or a rider on it";
}
pub relation contract_reinsures_848e5(k: Contract, reinsured: Contract) kind empirical {
    label en unofficial "the contract reinsures the other contract";
}
pub enum ContractCategory848c1 {
    CategoryAnnuity;
    CategoryGroupLife;
    CategoryOther;
    label en unofficial "the category of section 848(c)(1): (A) annuity contracts, (B) group life insurance contracts, (C) other specified insurance contracts";
}
pub relation annuity_category_848c1A(k: Contract) kind institutional {
    label en official "the contract is a specified annuity contract (not combined with noncancellable health insurance, not with a long-term care rider)";
}
@source(IRC_S848_E, quote = "Any annuity contract combined with noncancellable accident and health insurance shall be treated as a noncancellable accident and health insurance contract and not as an annuity contract.")
rule Section848e3AnnuityCategory(k: Contract) defeasible {
    label en official "section 848(e)(3), (6): an annuity contract that is neither combined with noncancellable health insurance nor carrying a long-term care rider";
    when specified_insurance_contract_848e1(k);
    when annuity_contract_848e1A(k);
    when not_known(annuity_combined_with_noncancellable_health_848e3(k));
    when not_known(includes_qualified_ltc_contract_848e6(k));
    then annuity_category_848c1A(k);
}
pub relation group_life_category_848c1B(k: Contract) kind institutional {
    label en official "the contract is a specified group life insurance contract (not with a long-term care rider)";
}
rule Section848e2GroupLifeCategory(k: Contract) defeasible {
    label en official "section 848(e)(2), (6): a specified group life insurance contract without a long-term care rider";
    when specified_insurance_contract_848e1(k);
    when group_life_insurance_contract_848e2(k);
    when not_known(includes_qualified_ltc_contract_848e6(k));
    then group_life_category_848c1B(k);
}
pub relation direct_contract_category_848(k: Contract, category: ContractCategory848c1) kind institutional {
    label en official "the category of the contract by its own character, before the section 848(e)(5) reinsurance rule";
}
pub relation contract_category_848(k: Contract, category: ContractCategory848c1) kind institutional {
    label en official "the category of the contract for the section 848(c)(1) percentages (a reinsuring contract takes the category of the reinsured contract, one reinsurance hop: TECH-GAPS G4900 class)";
}
rule Section848DirectCategoryIsCategory(k: Contract, category: ContractCategory848c1) defeasible {
    label en official "section 848(c)(1): the contract's own category";
    when direct_contract_category_848(k, category);
    then contract_category_848(k, category);
}
rule Section848c1ACategoryAnnuity(k: Contract) defeasible {
    label en official "section 848(c)(1)(A): annuity contracts";
    when annuity_category_848c1A(k);
    then direct_contract_category_848(k, CategoryAnnuity);
}
rule Section848c1BCategoryGroupLife(k: Contract) defeasible {
    label en official "section 848(c)(1)(B): group life insurance contracts";
    when group_life_category_848c1B(k);
    then direct_contract_category_848(k, CategoryGroupLife);
}
@source(IRC_S848_E, quote = "shall be treated as a specified insurance contract not described in subparagraph (A) or (B) of subsection (c)(1).")
rule Section848e6LtcIsOther(k: Contract) defeasible {
    label en official "section 848(e)(6): an annuity or life contract with a qualified long-term care contract is a specified insurance contract not described in (c)(1)(A) or (B)";
    when specified_insurance_contract_848e1(k);
    when includes_qualified_ltc_contract_848e6(k);
    then direct_contract_category_848(k, CategoryOther);
}
rule Section848c1COtherCategory(k: Contract) defeasible {
    label en official "section 848(c)(1)(C): a specified insurance contract that is neither an annuity nor a group life contract";
    when specified_insurance_contract_848e1(k);
    when not_known(annuity_category_848c1A(k));
    when not_known(group_life_category_848c1B(k));
    then direct_contract_category_848(k, CategoryOther);
}
@source(IRC_S848_E, quote = "A contract which reinsures another contract shall be treated in the same manner as the reinsured contract.")
rule Section848e5ReinsuranceContract(k: Contract, reinsured: Contract, category: ContractCategory848c1) defeasible {
    label en official "section 848(e)(5): a contract that reinsures another is in the reinsured contract's category";
    when contract_reinsures_848e5(k, reinsured);
    when direct_contract_category_848(reinsured, category);
    then contract_category_848(k, category);
}

// ---- Section 848(d): net premiums ----

pub relation premium_item_contract_848(item: us.irc.core::Payment, k: Contract) kind empirical {
    label en unofficial "the premium item is on this contract";
}
pub relation reinsurance_premium_item_848d1B(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) kind empirical {
    label en unofficial "premiums and other consideration incurred for reinsurance of the contract";
}
pub relation reinsurance_premium_includible_848d4A(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the reinsurance premium is includible in the gross income of an insurance company taxable under subchapter L, or is subject to tax under this chapter by reason of subpart F of part III of subchapter N";
}
pub relation deemed_premium_item_808e_848d3(c: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the item is a section 808(e) deemed premium (to be disregarded by section 848(d)(3))";
}
rule Section848d3DeemedPremiumMarker(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 848(d)(3): the item comes from a policyholder dividend treated as paid and returned";
    when dividend_treated_as_returned_as_premium_808e(c, y, item, amount);
    then deemed_premium_item_808e_848d3(c, y, item);
}
pub relation gross_premium_item_848d1A(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) kind institutional {
    label en official "a gross premium item on a specified contract: a section 803(b) included item, without regard to section 808(e) deemed premiums";
}
@source(IRC_S848_D, quote = "The rules of section 803(b) shall apply for purposes of the preceding sentence.")
rule Section848d1AGrossItem(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) defeasible {
    label en official "section 848(d)(1)(A), (d)(3): the gross amount of premiums and other consideration on the contract (section 803(b) items, deemed 808(e) premiums disregarded)";
    when included_premium_item_803b1(c, y, item, amount);
    when premium_item_contract_848(item, k);
    when not_known(deemed_premium_item_808e_848d3(c, y, item));
    then gross_premium_item_848d1A(c, y, item, k, amount);
}
pub relation deduction_premium_item_848d1B(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) kind institutional {
    label en official "a return premium on the contract, or premiums and other consideration incurred for reinsurance of it (to the extent of (d)(4)(A))";
}
@source(IRC_S848_D, quote = "return premiums on such contracts and premiums and other consideration incurred for reinsurance of such contracts.")
rule Section848d1BReturnPremium(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) strict {
    label en official "section 848(d)(1)(B): return premiums on the contract";
    when return_premium_item_803a1B(c, y, item, amount);
    when premium_item_contract_848(item, k);
    then deduction_premium_item_848d1B(c, y, item, k, amount);
}
@source(IRC_S848_D, quote = "Premiums and other consideration incurred for reinsurance shall be taken into account under paragraph (1)(B) only to the extent such premiums and other consideration are includible in the gross income of an insurance company taxable under this subchapter or are subject to tax under this chapter by reason of subpart F of part III of subchapter N.")
rule Section848d4AReinsurancePremium(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) strict {
    label en official "section 848(d)(4)(A): reinsurance premiums count only to the extent includible in the reinsurer's gross income (or subject to subpart F tax)";
    when reinsurance_premium_item_848d1B(c, y, item, k, amount);
    when reinsurance_premium_includible_848d4A(item);
    then deduction_premium_item_848d1B(c, y, item, k, amount);
}
pub relation accrual_basis_848d2(c: Person, y: TaxableYear) kind institutional {
    label en official "the computations entering into net premiums are made in the manner required by section 811(a) for life insurance companies, where the company is taxed under part II";
}
pub relation company_taxed_under_part_ii_848d2(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the insurance company is subject to tax under part II of subchapter L (a life insurance company)";
}
@source(IRC_S848_D, quote = "In the case of an insurance company subject to tax under part II of this subchapter, all computations entering into determinations of net premiums for any taxable year shall be made in the manner required under section 811(a) for life insurance companies.")
rule Section848d2PartIIAccrual(c: Person, y: TaxableYear) defeasible {
    label en official "section 848(d)(2): a part II company computes on the section 811(a) basis";
    when company_taxed_under_part_ii_848d2(c, y);
    when computations_under_accrual_or_permitted_combination_811a(c, y);
    then accrual_basis_848d2(c, y);
}
rule Section848d2NotPartII(c: Person, y: TaxableYear, item: us.irc.core::Payment, k: Contract, amount: Money) defeasible {
    label en official "section 848(d)(2): a company not taxed under part II is not subject to the requirement";
    when gross_premium_item_848d1A(c, y, item, k, amount);
    when not_known(company_taxed_under_part_ii_848d2(c, y));
    then accrual_basis_848d2(c, y);
}
pub relation category_gross_premiums_848d1A(c: Person, y: TaxableYear, category: ContractCategory848c1, total: Money) kind institutional {
    label en official "the gross premiums and other consideration on the contracts of the category (a sum over derived items, TECH-GAPS G4903)";
}
pub relation category_deduction_premiums_848d1B(c: Person, y: TaxableYear, category: ContractCategory848c1, total: Money) kind institutional {
    label en official "the return premiums and reinsurance premiums on the contracts of the category (a sum over derived items, TECH-GAPS G4903)";
}
pub relation gross_item_in_category_848(c: Person, y: TaxableYear, category: ContractCategory848c1, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a gross premium item attributed to the category of its contract";
}
rule Section848GrossItemByCategory(c: Person, y: TaxableYear, category: ContractCategory848c1, item: us.irc.core::Payment, k: Contract, amount: Money) defeasible {
    label en official "section 848(d)(1)(A): the gross item, in the category of its contract";
    when gross_premium_item_848d1A(c, y, item, k, amount);
    when contract_category_848(k, category);
    then gross_item_in_category_848(c, y, category, item, amount);
}
pub relation deduction_item_in_category_848(c: Person, y: TaxableYear, category: ContractCategory848c1, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a return or reinsurance premium item attributed to the category of its contract";
}
rule Section848DeductionItemByCategory(c: Person, y: TaxableYear, category: ContractCategory848c1, item: us.irc.core::Payment, k: Contract, amount: Money) defeasible {
    label en official "section 848(d)(1)(B): the return or reinsurance item, in the category of its contract";
    when deduction_premium_item_848d1B(c, y, item, k, amount);
    when contract_category_848(k, category);
    then deduction_item_in_category_848(c, y, category, item, amount);
}
rule Section848CategoryGrossAnnuity(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(A): the annuity category's gross premiums";
    when gross_item_in_category_848(c, y, CategoryAnnuity, anchor, anchor_amount);
    then category_gross_premiums_848d1A(c, y, CategoryAnnuity, sum all amount: Money for item: us.irc.core::Payment where gross_item_in_category_848(c, y, CategoryAnnuity, item, amount));
}
rule Section848CategoryGrossGroupLife(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(A): the group life category's gross premiums";
    when gross_item_in_category_848(c, y, CategoryGroupLife, anchor, anchor_amount);
    then category_gross_premiums_848d1A(c, y, CategoryGroupLife, sum all amount: Money for item: us.irc.core::Payment where gross_item_in_category_848(c, y, CategoryGroupLife, item, amount));
}
rule Section848CategoryGrossOther(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(A): the other category's gross premiums";
    when gross_item_in_category_848(c, y, CategoryOther, anchor, anchor_amount);
    then category_gross_premiums_848d1A(c, y, CategoryOther, sum all amount: Money for item: us.irc.core::Payment where gross_item_in_category_848(c, y, CategoryOther, item, amount));
}
rule Section848CategoryDeductionsAnnuity(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(B): the annuity category's return and reinsurance premiums";
    when deduction_item_in_category_848(c, y, CategoryAnnuity, anchor, anchor_amount);
    then category_deduction_premiums_848d1B(c, y, CategoryAnnuity, sum all amount: Money for item: us.irc.core::Payment where deduction_item_in_category_848(c, y, CategoryAnnuity, item, amount));
}
rule Section848CategoryDeductionsGroupLife(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(B): the group life category's return and reinsurance premiums";
    when deduction_item_in_category_848(c, y, CategoryGroupLife, anchor, anchor_amount);
    then category_deduction_premiums_848d1B(c, y, CategoryGroupLife, sum all amount: Money for item: us.irc.core::Payment where deduction_item_in_category_848(c, y, CategoryGroupLife, item, amount));
}
rule Section848CategoryDeductionsOther(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 848(d)(1)(B): the other category's return and reinsurance premiums";
    when deduction_item_in_category_848(c, y, CategoryOther, anchor, anchor_amount);
    then category_deduction_premiums_848d1B(c, y, CategoryOther, sum all amount: Money for item: us.irc.core::Payment where deduction_item_in_category_848(c, y, CategoryOther, item, amount));
}
pub relation has_deduction_premiums_848(c: Person, y: TaxableYear, category: ContractCategory848c1) kind institutional {
    label en official "a return or reinsurance premium total exists for the category (helper)";
}
rule Section848HasDeductionPremiums(c: Person, y: TaxableYear, category: ContractCategory848c1, total: Money) defeasible {
    label en official "helper";
    when category_deduction_premiums_848d1B(c, y, category, total);
    then has_deduction_premiums_848(c, y, category);
}
pub relation net_premiums_848d(c: Person, y: TaxableYear, category: ContractCategory848c1, amount: Money) kind institutional {
    label en official "net premiums of the category: the excess (if any) of the gross premiums over the return and reinsurance premiums";
}
@source(IRC_S848_D, quote = "the excess (if any) of")
rule Section848d1NetPositive(c: Person, y: TaxableYear, category: ContractCategory848c1, gross: Money, deductions: Money) defeasible {
    label en official "section 848(d)(1): the gross amount exceeds the return and reinsurance premiums";
    when category_gross_premiums_848d1A(c, y, category, gross);
    when category_deduction_premiums_848d1B(c, y, category, deductions);
    when accrual_basis_848d2(c, y);
    when gross > deductions;
    then net_premiums_848d(c, y, category, gross - deductions);
}
rule Section848d1NetZero(c: Person, y: TaxableYear, category: ContractCategory848c1, gross: Money, deductions: Money) defeasible {
    label en official "section 848(d)(1): no excess: net premiums are zero (the negative amount is used by subsection (f))";
    when category_gross_premiums_848d1A(c, y, category, gross);
    when category_deduction_premiums_848d1B(c, y, category, deductions);
    when accrual_basis_848d2(c, y);
    when gross <= deductions;
    then net_premiums_848d(c, y, category, 0.00 USD);
}
rule Section848d1NetWithoutDeductions(c: Person, y: TaxableYear, category: ContractCategory848c1, gross: Money) defeasible {
    label en official "section 848(d)(1): with no return or reinsurance premium the net premiums are the gross amount";
    when category_gross_premiums_848d1A(c, y, category, gross);
    when accrual_basis_848d2(c, y);
    when not_known(has_deduction_premiums_848(c, y, category));
    then net_premiums_848d(c, y, category, gross);
}
rule Section848NetPremiumsAnnuityFromCategory(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 848(c)(1)(A): the annuity category's net premiums";
    when net_premiums_848d(c, y, CategoryAnnuity, amount);
    then net_premiums_annuity_848c1A(c, y, amount);
}
rule Section848NetPremiumsGroupLifeFromCategory(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 848(c)(1)(B): the group life category's net premiums";
    when net_premiums_848d(c, y, CategoryGroupLife, amount);
    then net_premiums_group_life_848c1B(c, y, amount);
}
rule Section848NetPremiumsOtherFromCategory(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 848(c)(1)(C): the other category's net premiums";
    when net_premiums_848d(c, y, CategoryOther, amount);
    then net_premiums_other_848c1C(c, y, amount);
}

// ---- Section 848(f): negative net premiums ----

pub relation capitalization_percentage_848c1(category: ContractCategory848c1, pct: Decimal) kind institutional {
    label en official "the percentage applicable under section 848(c)(1) to the category";
}
rule Section848c1PctAnnuity() strict {
    label en official "section 848(c)(1)(A): 2.09 percent";
    then capitalization_percentage_848c1(CategoryAnnuity, 0.0209);
}
rule Section848c1PctGroupLife() strict {
    label en official "section 848(c)(1)(B): 2.45 percent";
    then capitalization_percentage_848c1(CategoryGroupLife, 0.0245);
}
rule Section848c1PctOther() strict {
    label en official "section 848(c)(1)(C): 9.2 percent";
    then capitalization_percentage_848c1(CategoryOther, 0.092);
}
pub relation negative_capitalization_amount_848f2(c: Person, y: TaxableYear, category: ContractCategory848c1, amount: Money) kind institutional {
    label en official "the negative capitalization amount of the category: the applicable percentage of the excess of the return and reinsurance premiums over the gross premiums";
}
@source(IRC_S848_F, quote = "the term \"negative capitalization amount\" means, with respect to any category of specified insurance contracts, the percentage (applicable under subsection (c)(1) to such category) of the amount (if any) by which")
rule Section848f2NegativeCapitalizationAmount(c: Person, y: TaxableYear, category: ContractCategory848c1, gross: Money, deductions: Money, pct: Decimal) defeasible {
    label en official "section 848(f)(2): the percentage of the excess of (d)(1)(B) over (d)(1)(A) (cents HALF_UP is a JUDGMENT CALL)";
    when category_gross_premiums_848d1A(c, y, category, gross);
    when category_deduction_premiums_848d1B(c, y, category, deductions);
    when capitalization_percentage_848c1(category, pct);
    when deductions > gross;
    then negative_capitalization_amount_848f2(c, y, category, round((deductions - gross) * pct, 2, "HALF_UP"));
}
pub relation has_negative_capitalization_848f(c: Person, y: TaxableYear) kind institutional {
    label en official "some category has a negative capitalization amount (helper)";
}
rule Section848fHasNegative(c: Person, y: TaxableYear, category: ContractCategory848c1, amount: Money) defeasible {
    label en official "helper";
    when negative_capitalization_amount_848f2(c, y, category, amount);
    then has_negative_capitalization_848f(c, y);
}
pub relation negative_capitalization_total_848f(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the negative capitalization amounts of all categories added (a sum over derived rows, TECH-GAPS G4903)";
}
rule Section848fNegativeTotal(c: Person, y: TaxableYear, anchor: ContractCategory848c1, anchor_amount: Money) defeasible {
    label en official "section 848(f)(1): the negative capitalization amount";
    when negative_capitalization_amount_848f2(c, y, anchor, anchor_amount);
    then negative_capitalization_total_848f(c, y, sum all amount: Money for cat: ContractCategory848c1 where negative_capitalization_amount_848f2(c, y, cat, amount));
}
@source(IRC_S848_F, quote = "the amount otherwise required to be capitalized under this section for such taxable year with respect to any other category of specified insurance contracts shall be reduced (but not below zero) by such negative capitalization amount")
rule Section848f1AReducesCeiling(c: Person, y: TaxableYear, before: Money, negative: Money) defeasible {
    label en official "section 848(f)(1)(A): the amount otherwise required to be capitalized (the ceiling) is reduced, not below zero, by the negative capitalization amount";
    when specified_policy_acquisition_expenses_ceiling_before_848f(c, y, before);
    when negative_capitalization_total_848f(c, y, negative);
    when before >= negative;
    then specified_policy_acquisition_expenses_ceiling_848c1(c, y, before - negative);
}
rule Section848f1AReducesCeilingToZero(c: Person, y: TaxableYear, before: Money, negative: Money) defeasible {
    label en official "section 848(f)(1)(A): the reduction is not below zero";
    when specified_policy_acquisition_expenses_ceiling_before_848f(c, y, before);
    when negative_capitalization_total_848f(c, y, negative);
    when before < negative;
    then specified_policy_acquisition_expenses_ceiling_848c1(c, y, 0.00 USD);
}
rule Section848f1NoNegativeCeilingUnchanged(c: Person, y: TaxableYear, before: Money) defeasible {
    label en official "section 848(c)(1): with no negative capitalization amount the ceiling is the sum of the category percentages";
    when specified_policy_acquisition_expenses_ceiling_before_848f(c, y, before);
    when not_known(has_negative_capitalization_848f(c, y));
    then specified_policy_acquisition_expenses_ceiling_848c1(c, y, before);
}
pub relation unamortized_balance_at_year_start_848f1Bi(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the total unamortized balance, as of the beginning of the taxable year, of the amounts previously capitalized under subsection (a) (the per-year ledger and its most-recent-first ordering are the case's: TECH-GAPS G4911)";
}
pub relation negative_amount_not_absorbed_848f1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the negative capitalization amount to the extent not taken into account under subparagraph (A)";
}
@source(IRC_S848_F, quote = "such negative capitalization amount (to the extent not taken into account under subparagraph (A))")
rule Section848f1BNotAbsorbed(c: Person, y: TaxableYear, before: Money, negative: Money) defeasible {
    label en official "section 848(f)(1)(B): the part of the negative capitalization amount above the reduced ceiling base";
    when specified_policy_acquisition_expenses_ceiling_before_848f(c, y, before);
    when negative_capitalization_total_848f(c, y, negative);
    when negative > before;
    then negative_amount_not_absorbed_848f1B(c, y, negative - before);
}
pub relation negative_capitalization_deduction_848f1Bii(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction allowed for the taxable year: the part of the negative amount that reduces the unamortized balance (not below zero)";
}
@source(IRC_S848_F, quote = "to the extent taken into account as such a reduction, shall be allowed as a deduction for such taxable year")
rule Section848f1BiiDeduction(c: Person, y: TaxableYear, remaining: Money, balance: Money) defeasible {
    label en official "section 848(f)(1)(B)(i)-(ii): the remaining negative amount reduces the unamortized balance, not below zero, and the reduction is deductible";
    when negative_amount_not_absorbed_848f1B(c, y, remaining);
    when unamortized_balance_at_year_start_848f1Bi(c, y, balance);
    then negative_capitalization_deduction_848f1Bii(c, y, min(remaining, balance));
}

// ---- Section 848(b)(3)-(4): controlled groups and reinsurance ----

pub relation insurance_company_in_controlled_group_848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) kind empirical {
    label en unofficial "the insurance company is a member of the controlled group for the taxable year (the group is the section 1563(a) group as modified by (b)(3): (a)(4) and (b)(2)(D) of section 1563 do not apply and (b)(2)(C) does not exclude a foreign corporation to which section 842 applies; the modification is not recomputed, TECH-GAPS G4910)";
}
pub relation member_of_insurance_controlled_group_848b3(c: Person, y: TaxableYear) kind institutional {
    label en official "the insurance company is a member of a controlled group and is treated with the group for subsection (b)";
}
rule Section848b3MemberOfGroup(group: us.irc.corporations::ControlledGroup, c: Person, y: TaxableYear) defeasible {
    label en official "section 848(b)(3)(A): the members of the group are treated as one company";
    when insurance_company_in_group_for_848b3(group, c, y);
    then member_of_insurance_controlled_group_848b3(c, y);
}
pub relation group_specified_expenses_848b3(group: us.irc.corporations::ControlledGroup, y: TaxableYear, total: Money) kind institutional {
    label en official "the specified policy acquisition expenses of all insurance companies of the group (a sum over derived rows, TECH-GAPS G4903)";
}
@source(IRC_S848_B, quote = "all insurance companies which are members of such group shall be treated as 1 company for purposes of this subsection")
rule Section848b3GroupExpenses(group: us.irc.corporations::ControlledGroup, y: TaxableYear, anchor: Person, anchor_expenses: Money) defeasible {
    label en official "section 848(b)(3)(A): the group's specified policy acquisition expenses";
    when insurance_company_in_group_for_848b3(group, anchor, y);
    when specified_policy_acquisition_expenses(anchor, y, anchor_expenses);
    then group_specified_expenses_848b3(group, y, sum(collect all e: Money, m: Person where insurance_company_in_group_for_848b3(group, m, y) and specified_policy_acquisition_expenses(m, y, e), empty: 0.00 USD));
}
pub relation group_sixty_month_amount_848b3(group: us.irc.corporations::ControlledGroup, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the group's expenses to which paragraph (1) applies: the group total up to the $5,000,000 amount reduced (not below zero) by the excess of the total over $10,000,000";
}
rule Section848b3GroupSixtyMonthAboveTenMillion(group: us.irc.corporations::ControlledGroup, y: TaxableYear, total: Money) defeasible {
    label en official "section 848(b)(2), (3): the group's threshold is reduced by the excess over $10,000,000, not below zero";
    when group_specified_expenses_848b3(group, y, total);
    when total > 10000000.00 USD;
    then group_sixty_month_amount_848b3(group, y, min(total, max(0.00 USD, 5000000.00 USD - (total - 10000000.00 USD))));
}
rule Section848b3GroupSixtyMonthAtOrBelowTenMillion(group: us.irc.corporations::ControlledGroup, y: TaxableYear, total: Money) defeasible {
    label en official "section 848(b)(2), (3): no phase-out: the group total up to $5,000,000";
    when group_specified_expenses_848b3(group, y, total);
    when total <= 10000000.00 USD;
    then group_sixty_month_amount_848b3(group, y, min(total, 5000000.00 USD));
}
@source(IRC_S848_B, quote = "the amount to which paragraph (1) applies shall be allocated among such companies in such manner as the Secretary may prescribe")
pub relation secretary_allocation_848b3B(group: us.irc.corporations::ControlledGroup, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the group's paragraph (1) amount allocated to the company in the manner the Secretary prescribes (the allocation regulation is not in the snapshot: asserted)";
}
@source(IRC_S848_B, quote = "the amount to which paragraph (1) applies shall be allocated among such companies in such manner as the Secretary may prescribe")
rule Section848b3BAllocatedAmount(group: us.irc.corporations::ControlledGroup, c: Person, y: TaxableYear, allocated: Money) defeasible {
    label en official "section 848(b)(3)(B): the company's 60-month amount is its allocated share of the group's amount";
    when insurance_company_in_group_for_848b3(group, c, y);
    when secretary_allocation_848b3B(group, c, y, allocated);
    when group_sixty_month_amount_848b3(group, y, _);
    then amount_amortized_over_60_months_848b(c, y, allocated);
}
pub relation expenses_attributable_to_reinsurance_848b4(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the specified policy acquisition expenses for the year attributable to premiums or other consideration under any reinsurance contract";
}
pub relation reinsurance_attributable_expenses_stated_848b4(c: Person, y: TaxableYear) kind institutional {
    label en official "an amount attributable to reinsurance is stated for the company and year (helper)";
}
rule Section848b4Stated(c: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when expenses_attributable_to_reinsurance_848b4(c, y, amount);
    then reinsurance_attributable_expenses_stated_848b4(c, y);
}
@source(IRC_S848_B, quote = "Paragraph (1) shall not apply to any specified policy acquisition expenses for any taxable year which are attributable to premiums or other consideration under any reinsurance contract.")
rule Section848b4ReinsuranceExcluded(c: Person, y: TaxableYear, expenses: Money, threshold: Money, attributable: Money) defeasible {
    label en official "section 848(b)(4): the 60-month amount is limited to the expenses not attributable to reinsurance contracts";
    when specified_policy_acquisition_expenses(c, y, expenses);
    when section_848b1_five_million_threshold_after_phaseout(c, y, threshold);
    when expenses_attributable_to_reinsurance_848b4(c, y, attributable);
    when not_known(member_of_insurance_controlled_group_848b3(c, y));
    then amount_amortized_over_60_months_848b(c, y, min(max(0.00 USD, expenses - attributable), threshold));
}

// ---- Section 848(g): ceding commissions ----

pub relation ceding_commission_848g(c: Person, item: us.irc.core::Payment, incurred_on: Date) kind empirical {
    label en unofficial "a ceding commission the company incurred on this date under a reinsurance contract";
}
pub relation ceding_commission_contract_reinsures_specified_contract_848g(item: us.irc.core::Payment, k: Contract) kind empirical {
    label en unofficial "the contract under which the ceding commission is incurred reinsures this contract";
}
pub relation ceding_commission_not_capitalized_848g(c: Person, item: us.irc.core::Payment) kind institutional {
    label en official "no provision of law other than section 848 or 197 requires the capitalization of the ceding commission incurred on or after September 30, 1990 under a contract reinsuring a specified insurance contract";
}
@source(IRC_S848_G, quote = "Nothing in any provision of law (other than this section or section 197) shall require the capitalization of any ceding commission incurred on or after September 30, 1990, under any contract which reinsures a specified insurance contract.")
rule Section848gCedingCommission(c: Person, item: us.irc.core::Payment, incurred: Date, k: Contract) defeasible {
    label en official "section 848(g): a ceding commission incurred on or after 1990-09-30 under a contract that reinsures a specified insurance contract is not capitalized under other law";
    when ceding_commission_848g(c, item, incurred);
    when ceding_commission_contract_reinsures_specified_contract_848g(item, k);
    when specified_insurance_contract_848e1(k);
    when incurred >= @1990-09-30;
    then ceding_commission_not_capitalized_848g(c, item);
}
