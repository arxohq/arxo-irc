// Section 848(a)-(c) (capitalization of specified policy acquisition
// expenses: the 180-month ratable deduction, the first-$5,000,000/60-month
// exception with its $10,000,000 phase-out, and the 2.09%/2.45%/9.2% expense
// ceiling). Stage 2b (IRC-09 stage 2b, A12).
//
// METHOD: section 848(a)(2)'s "ratably over the 180-month period beginning
// with the first month in the second half of such taxable year" needs a
// YEAR-1 STEP because the 180 (or, under (b), 60) month period straddles
// multiple taxable years and only a fraction of it falls in the taxable
// year of capitalization itself: this module computes the exact MONTHLY
// amortization amount (Money/Decimal via `div_round`, since `Money /
// Integer` is a type error outside the divisible pairs — Money * Integer,
// by contrast, is ordinary exact scaling) and the taxable year's own
// deduction as that monthly amount times however many months of the period
// fall within the taxable year of capitalization (a case-asserted count,
// since it depends on the company's own tax year and the exact month the
// 180/60-month period begins). Only the YEAR-1 step is modeled — carrying
// the remaining balance forward year by year is the same self-referential
// multi-year-ledger class already filed elsewhere in this registry
// (TECH-GAPS.md's "Многолетний учёт" class) and is NOT attempted here.
//
// Section 848(b)(3) (controlled-group treatment) and (b)(4) (reinsurance-
// contract exception) are NOT modeled (narrow attribution/classification
// machinery outside this pass's core arithmetic). Section 848(d) (net
// premiums: the section 803(b) cross-reference, the accrual-basis
// requirement, the section 808(e) policyholder-dividend carve-out, the
// reinsurance special rules) is NOT separately modeled — `net_premiums_
// annuity_848c1A`/`_group_life_848c1B`/`_other_848c1C` below are case-
// asserted NET figures (gross less returns, per section 803(b)'s own
// method, which this package already models in module 07) rather than
// derived from separate gross/return inputs a second time. Section 848(e)
// (classification of contracts into the three (c)(1) categories) is NOT
// modeled — which category a contract falls into is asserted by the case
// through which net-premiums relation it feeds. Section 848(f) (special
// rule for negative net premiums/capitalization amounts), (g) (ceding-
// commission non-capitalization rule), and (h) (Secretary's authority to
// adjust capitalization amounts by category) are NOT modeled: (f) needs a
// running unamortized-balance ledger (same multi-year class as the (a)(2)
// carryforward above), (g) is a narrow non-capitalization carve-out outside
// this pass's core arithmetic, and (h) is a Secretarial rulemaking
// authority with no self-executing taxpayer-facing amount (NON_NORMATIVE:
// it authorizes future regulations, it does not itself compute anything).

// Stage 3 (26.09.2026): every rule of this module is `defeasible` and the
// three net-premium relations are institutional: module 31 derives them from
// itemised premiums by category (section 848(d)-(e)), applies the negative
// net premium rule of (f) and the controlled-group rule of (b)(3); a case may
// still assert the net premiums directly.

// ---- Section 848(c): specified policy acquisition expenses ----

use self::{
    IRC_S848_A,
    IRC_S848_B,
    IRC_S848_C,
    Person,
    TaxableYear,
    member_of_insurance_controlled_group_848b3,
};

@source(IRC_S848_C, quote = "2.09 percent of the net premiums for such taxable year on specified insurance contracts which are annuity contracts")
pub relation net_premiums_annuity_848c1A(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "net premiums for the taxable year on specified insurance contracts which are annuity contracts, per section 848(c)(1)(A) (net of returns, per section 803(b)'s method — section 848(d)(1) cross-reference, not separately re-derived)";
}
@source(IRC_S848_C, quote = "2.45 percent of the net premiums for such taxable year on specified insurance contracts which are group life insurance contracts")
pub relation net_premiums_group_life_848c1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "net premiums for the taxable year on specified insurance contracts which are group life insurance contracts, per section 848(c)(1)(B)";
}
@source(IRC_S848_C, quote = "9.2 percent of the net premiums for such taxable year on specified insurance contracts not described in subparagraph (A) or (B)")
pub relation net_premiums_other_848c1C(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "net premiums for the taxable year on specified insurance contracts not described in section 848(c)(1)(A) or (B), per section 848(c)(1)(C)";
}
pub relation specified_policy_acquisition_expenses_ceiling_before_848f(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(c)(1): the sum of 2.09/2.45/9.2 percent of net premiums by category, before the section 848(f) reduction for a negative capitalization amount";
}
@source(IRC_S848_C, quote = "(A) 2.09 percent of the net premiums for such taxable year on specified insurance contracts which are annuity contracts,\n(B) 2.45 percent of the net premiums for such taxable year on specified insurance contracts which are group life insurance contracts, and\n(C) 9.2 percent of the net premiums for such taxable year on specified insurance contracts not described in subparagraph (A) or (B).")
pub relation specified_policy_acquisition_expenses_ceiling_848c1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(c)(1): the sum of 2.09/2.45/9.2 percent of net premiums by category";
}
rule Section848c1ExpenseCeiling(c: Person, y: TaxableYear, annuity: Money, group_life: Money, other: Money) defeasible {
    label en official "section 848(c)(1): the expense ceiling is 2.09 percent of annuity net premiums, plus 2.45 percent of group life net premiums, plus 9.2 percent of other net premiums";
    when net_premiums_annuity_848c1A(c, y, annuity);
    when net_premiums_group_life_848c1B(c, y, group_life);
    when net_premiums_other_848c1C(c, y, other);
    then specified_policy_acquisition_expenses_ceiling_before_848f(c, y, (round(annuity * 0.0209, 2, "HALF_UP") + round(group_life * 0.0245, 2, "HALF_UP")) + round(other * 0.092, 2, "HALF_UP"));
}
@source(IRC_S848_C, quote = "The term \"general deductions\" means the deductions provided in part VI of subchapter B (sec. 161 and following, relating to itemized deductions) and in part I of subchapter D (sec. 401 and following, relating to pension, profit sharing, stock bonus plans, etc.).")
pub relation general_deductions_848c2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 848(c)(2) 'general deductions' (part VI of subchapter B and part I of subchapter D deductions) for the taxable year — a DIFFERENT figure from this package's own section 805 'general deductions' (life insurance companies' own deduction total); owned by us.irc.deductions, asserted here as a case fact";
}
@source(IRC_S848_C, quote = "The term \"specified policy acquisition expenses\" means, with respect to any taxable year, so much of the general deductions for such taxable year as does not exceed the sum of—")
pub relation specified_policy_acquisition_expenses(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(c)(1): specified policy acquisition expenses — the lesser of general deductions (c)(2) or the expense ceiling (c)(1)(A)-(C)";
}
rule Section848c1SpecifiedExpensesLesserOfDeductionsOrCeiling(c: Person, y: TaxableYear, deductions: Money, ceiling: Money) defeasible {
    label en official "section 848(c)(1): specified policy acquisition expenses = min(general deductions, expense ceiling)";
    when general_deductions_848c2(c, y, deductions);
    when specified_policy_acquisition_expenses_ceiling_848c1(c, y, ceiling);
    then specified_policy_acquisition_expenses(c, y, min(deductions, ceiling));
}

// ---- Section 848(b): the first-$5,000,000/60-month exception and its
// $10,000,000 phase-out ----

@source(IRC_S848_B, quote = "If the specified policy acquisition expenses of an insurance company exceed $10,000,000 for any taxable year, the $5,000,000 amount under paragraph (1) shall be reduced (but not below zero) by the amount of such excess.")
pub relation section_848b2_phaseout_reduction(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(b)(2): the excess of specified policy acquisition expenses over $10,000,000, or zero if none";
}
rule Section848b2PhaseoutReductionAboveThreshold(c: Person, y: TaxableYear, expenses: Money) defeasible {
    label en official "section 848(b)(2): specified expenses exceeding $10,000,000 produce a phase-out reduction equal to the excess";
    when specified_policy_acquisition_expenses(c, y, expenses);
    when expenses > 10000000.00 USD;
    then section_848b2_phaseout_reduction(c, y, expenses - 10000000.00 USD);
}
rule Section848b2NoPhaseoutAtOrBelowThreshold(c: Person, y: TaxableYear, expenses: Money) defeasible {
    label en official "section 848(b)(2): specified expenses at or below $10,000,000 produce no phase-out reduction";
    when specified_policy_acquisition_expenses(c, y, expenses);
    when expenses <= 10000000.00 USD;
    then section_848b2_phaseout_reduction(c, y, 0.00 USD);
}
@source(IRC_S848_B, quote = "so much of the specified policy acquisition expenses of an insurance company for any taxable year as does not exceed $5,000,000")
pub relation section_848b1_five_million_threshold_after_phaseout(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(b)(1)-(2): the $5,000,000 threshold, reduced (not below zero) by the section 848(b)(2) phase-out reduction";
}
rule Section848b1FiveMillionThresholdAfterPhaseoutBinds(c: Person, y: TaxableYear, reduction: Money) defeasible {
    label en official "section 848(b)(1)-(2): the $5,000,000 threshold reduced by the phase-out, when the reduction is at least $5,000,000 (floor at zero)";
    when section_848b2_phaseout_reduction(c, y, reduction);
    when reduction >= 5000000.00 USD;
    then section_848b1_five_million_threshold_after_phaseout(c, y, 0.00 USD);
}
rule Section848b1FiveMillionThresholdAfterPhaseoutPartial(c: Person, y: TaxableYear, reduction: Money) defeasible {
    label en official "section 848(b)(1)-(2): the $5,000,000 threshold reduced by the phase-out, when the reduction is less than $5,000,000";
    when section_848b2_phaseout_reduction(c, y, reduction);
    when reduction < 5000000.00 USD;
    then section_848b1_five_million_threshold_after_phaseout(c, y, 5000000.00 USD - reduction);
}
@source(IRC_S848_B, quote = "Paragraph (2) of subsection (a) shall be applied with respect to so much of the specified policy acquisition expenses of an insurance company for any taxable year as does not exceed $5,000,000 by substituting \"60-month\" for \"180-month\".")
pub relation amount_amortized_over_60_months_848b(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(b)(1): the portion of specified policy acquisition expenses amortized over 60 months instead of 180 (the lesser of the total expenses or the post-phase-out $5,000,000 threshold)";
}
rule Section848b1SixtyMonthAmount(c: Person, y: TaxableYear, expenses: Money, threshold: Money) defeasible {
    label en official "section 848(b)(1): the 60-month amount is the lesser of total specified expenses or the post-phase-out threshold";
    when specified_policy_acquisition_expenses(c, y, expenses);
    when section_848b1_five_million_threshold_after_phaseout(c, y, threshold);
    // Stage 3: a member of a controlled group is treated with the group (module 31).
    when not_known(member_of_insurance_controlled_group_848b3(c, y));
    then amount_amortized_over_60_months_848b(c, y, min(expenses, threshold));
}
@source(IRC_S848_A, quote = "specified policy acquisition expenses for any taxable year shall be capitalized")
pub relation amount_amortized_over_180_months_848a(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(a): the portion of specified policy acquisition expenses amortized over the general 180-month period (total expenses less the section 848(b) 60-month portion)";
}
rule Section848aOneHundredEightyMonthAmount(c: Person, y: TaxableYear, expenses: Money, sixty_month: Money) defeasible {
    label en official "section 848(a): the 180-month amount is total specified expenses minus the 60-month portion";
    when specified_policy_acquisition_expenses(c, y, expenses);
    when amount_amortized_over_60_months_848b(c, y, sixty_month);
    then amount_amortized_over_180_months_848a(c, y, expenses - sixty_month);
}

// ---- Section 848(a)(2): the ratable deduction, year-1 step ----

@source(IRC_S848_A, quote = "such expenses shall be allowed as a deduction ratably over the 180-month period beginning with the first month in the second half of such taxable year")
pub relation months_of_period_in_capitalization_year(c: Person, y: TaxableYear, months: Integer) kind empirical {
    label en unofficial "the number of months of the 180-month (or, under section 848(b), 60-month) amortization period that fall within the taxable year of capitalization itself (the second half of that taxable year) — a case-asserted count, since it depends on the company's own taxable year (calendar or fiscal)";
}
@source(IRC_S848_A, quote = "such expenses shall be allowed as a deduction ratably over the 180-month period beginning with the first month in the second half of such taxable year")
pub relation section_848a2_year1_deduction_180_month_portion(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(a)(2): the taxable year's ratable deduction for the 180-month-amortized portion (year 1 only; the remaining 174 months' deductions in later years are not modeled here — a multi-year carryforward ledger)";
}
rule Section848a2Year1Deduction180Month(c: Person, y: TaxableYear, amount: Money, months: Integer) defeasible {
    label en official "section 848(a)(2): year-1 deduction for the 180-month portion = (amount / 180) * months of the period falling in this taxable year";
    when amount_amortized_over_180_months_848a(c, y, amount);
    when months_of_period_in_capitalization_year(c, y, months);
    then section_848a2_year1_deduction_180_month_portion(c, y, round(div_round(amount, 180.0, 6, "HALF_UP") * months, 2, "HALF_UP"));
}
@source(IRC_S848_B, quote = "by substituting \"60-month\" for \"180-month\"")
pub relation section_848a2_year1_deduction_60_month_portion(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(b)(1)/(a)(2): the taxable year's ratable deduction for the 60-month-amortized portion (year 1 only)";
}
rule Section848a2Year1Deduction60Month(c: Person, y: TaxableYear, amount: Money, months: Integer) defeasible {
    label en official "section 848(b)(1)/(a)(2): year-1 deduction for the 60-month portion = (amount / 60) * months of the period falling in this taxable year";
    when amount_amortized_over_60_months_848b(c, y, amount);
    when months_of_period_in_capitalization_year(c, y, months);
    then section_848a2_year1_deduction_60_month_portion(c, y, round(div_round(amount, 60.0, 6, "HALF_UP") * months, 2, "HALF_UP"));
}
@source(IRC_S848_A, quote = "such expenses shall be allowed as a deduction ratably over the 180-month period beginning with the first month in the second half of such taxable year")
pub relation section_848a2_year1_deduction(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 848(a)(2): the total taxable-year-of-capitalization deduction (the 180-month and 60-month portions combined)";
}
rule Section848a2Year1TotalDeduction(c: Person, y: TaxableYear, portion180: Money, portion60: Money) defeasible {
    label en official "section 848(a)(2): total year-1 deduction = the 180-month portion's year-1 amount plus the 60-month portion's year-1 amount";
    when section_848a2_year1_deduction_180_month_portion(c, y, portion180);
    when section_848a2_year1_deduction_60_month_portion(c, y, portion60);
    then section_848a2_year1_deduction(c, y, portion180 + portion60);
}
