// Sections 851(c)-(i), 852(b)(4),(6)-(9), 852(c)-(f), 853, 853A, 854, 855
// (regulated investment companies: the definitions feeding the
// diversification test, the failure-cure and tax rules, unit investment
// trusts and funds, qualified publicly traded partnerships, the RIC's
// earnings-and-profits and holding rules, the section 853/853A elections
// passing foreign tax and credit-bond credits to shareholders, the
// dividend-reporting caps and the dividends-after-year-end election).
// Stage 2c (IRC-09 stage 2c, A12), 26.09.2026. Status implemented_unverified.
//
// METHOD. Amounts the statute takes from another part of the Code (the
// section 246(c) holding period, the section 4982 required distribution,
// the section 1(h)(11) qualified dividend income, the section 6621 rate)
// are case-asserted facts, and each is named in the coverage row. A
// determination of "reasonable cause and not due to willful neglect" is an
// `external judgment relation` (DECISION-0194 channel 1, authority the
// Secretary) asserted with origin `adjudicated`; unknown is not negative.
// Every "Secretary may prescribe other period" alternative is an
// EXTERNAL_DEPENDENCY row (no Treasury regulation is in the snapshot).
// Month counts start from the day AFTER the last day of a quarter or year
// ("6 months after the last day of the quarter" ends on the last day of the
// sixth following month; "the 15th day of the 9th month after the close" is
// the day after the close plus 8 months plus 14 days). A step from a 29th-31st
// (`add_calendar_period` refuses a nonexistent date) is avoided this way; the
// reading is an INTERPRETATION recorded here. A 52-53 week year ending
// mid-month: TECH-GAPS G2200.

// ---- Section 851(c): definitions for the diversification test ----

use self::{
    Corporation,
    IRC_S851_C,
    IRC_S851_D,
    IRC_S851_F,
    IRC_S851_G,
    IRC_S851_H,
    IRC_S851_I,
    IRC_S852_B,
    IRC_S852_C,
    IRC_S852_D,
    IRC_S852_E,
    IRC_S852_F,
    IRC_S853A_A,
    IRC_S853A_B,
    IRC_S853A_C,
    IRC_S853_A,
    IRC_S853_B,
    IRC_S853_C,
    IRC_S854_A,
    IRC_S854_B,
    IRC_S855_A,
    IRC_S855_B,
    Person,
    TaxableYear,
    aep_for_distribution_requirement_852e2Ai,
    dividend_item_fails_deduction_test_854b3,
    domestic_corporation_candidate,
    election_to_defer_unavailable_852b8Gii,
    elects_regulated_investment_company_status,
    highest_rate_of_tax_section_11,
    november_year_electing_company_852b8Gi,
    qualifying_gross_income_851b2,
    regulated_investment_company_candidate,
    section_852a1_distribution_requirement_met,
    subchapter_m_part_i_applies,
    total_gross_income_851,
};

@source(IRC_S851_C, quote = "The term \"controls\" means the ownership in a corporation of 20 percent or more of the total combined voting power of all classes of stock entitled to vote.")
pub relation voting_power_percent_owned_851c(owner: Corporation, issuer: Corporation, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the total combined voting power of all classes of stock entitled to vote in the issuer that the owner owns directly";
}
pub relation controls_851c2(owner: Corporation, issuer: Corporation) kind institutional {
    label en official "the owner controls the issuer: it owns 20 percent or more of its total combined voting power (section 851(c)(2))";
}
rule Section851c2Controls(owner: Corporation, issuer: Corporation, pct: Decimal) strict {
    label en official "section 851(c)(2): control means ownership of 20 percent or more of the total combined voting power";
    when voting_power_percent_owned_851c(owner, issuer, pct);
    when pct >= 20.0;
    then controls_851c2(owner, issuer);
}
@source(IRC_S851_C, quote = "The term \"controlled group\" means one or more chains of corporations connected through stock ownership with the taxpayer")
pub relation controlled_group_member_851c3(taxpayer: Corporation, member: Corporation) kind institutional {
    label en official "the corporation is in the taxpayer's controlled group: connected to the taxpayer through a chain of 20-percent ownership (section 851(c)(3); ownership aggregated across several owners is TECH-GAPS G2202)";
}
rule Section851c3ControlledGroupBase(taxpayer: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(B): the taxpayer directly owns 20 percent or more of the voting power of at least one other corporation";
    when controls_851c2(taxpayer, member);
    then controlled_group_member_851c3(taxpayer, member);
}
rule Section851c3ControlledGroupOneIntermediate(taxpayer: Corporation, via: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(A): a corporation owned 20 percent or more by a corporation the taxpayer controls (one intermediate)";
    when controls_851c2(taxpayer, via);
    when controls_851c2(via, member);
    then controlled_group_member_851c3(taxpayer, member);
}
// The chain is unrolled to three links: a recursive closure over a derived
// relation is LDC-E4102 (TECH-GAPS G2202).
rule Section851c3ControlledGroupTwoIntermediates(taxpayer: Corporation, via1: Corporation, via2: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(A): a chain of three links (two intermediates)";
    when controls_851c2(taxpayer, via1);
    when controls_851c2(via1, via2);
    when controls_851c2(via2, member);
    then controlled_group_member_851c3(taxpayer, member);
}
pub relation security_market_quotation_readily_available_851c4(s: us.irc.core::Asset) kind empirical {
    label en unofficial "market quotations are readily available for the security, which is not a security of a majority-owned subsidiary";
}
pub relation market_value_of_security_851c4(s: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the market value of the security";
}
pub relation board_good_faith_fair_value_851c4(s: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair value of the security or other asset as determined in good faith by the board of directors";
}
@source(IRC_S851_C, quote = "with respect to securities (other than those of majority-owned subsidiaries) for which market quotations are readily available, the market value of such securities")
pub relation value_851c4(s: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the value of the security or asset for the diversification test (section 851(c)(4))";
}
rule Section851c4MarketValue(s: us.irc.core::Asset, amount: Money) strict {
    label en official "section 851(c)(4): value is market value where quotations are readily available";
    when security_market_quotation_readily_available_851c4(s);
    when market_value_of_security_851c4(s, amount);
    then value_851c4(s, amount);
}
@source(IRC_S851_C, quote = "with respect to other securities and assets, fair value as determined in good faith by the board of directors")
rule Section851c4BoardFairValue(s: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 851(c)(4): otherwise value is the fair value determined in good faith by the board of directors";
    when board_good_faith_fair_value_851c4(s, amount);
    when not_known(security_market_quotation_readily_available_851c4(s));
    then value_851c4(s, amount);
}
@source(IRC_S851_C, quote = "In ascertaining the value of the taxpayer's investment in the securities of an issuer, for the purposes of subparagraph (B), there shall be included its proper proportion of the investment of any other corporation, a member of a controlled group, in the securities of such issuer")
pub relation proper_proportion_of_group_member_investment_851c1(taxpayer: Corporation, issuer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer's proper proportion, as determined under regulations, of a controlled-group member's investment in the issuer's securities (regulations are not in the snapshot; the case supplies the proportion)";
}
pub relation taxpayer_investment_including_group_proportion_851c1(taxpayer: Corporation, issuer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxpayer's investment in the issuer's securities including the proper proportion of controlled-group members' investment (section 851(c)(1))";
}
pub relation own_investment_in_issuer_851c1(taxpayer: Corporation, issuer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the taxpayer's own investment in the securities of the issuer";
}
rule Section851c1IncludesGroupProportion(taxpayer: Corporation, issuer: Person, y: TaxableYear, own: Money, share: Money) strict {
    label en official "section 851(c)(1): the investment in an issuer includes the proper proportion of the controlled group's investment";
    when own_investment_in_issuer_851c1(taxpayer, issuer, y, own);
    when proper_proportion_of_group_member_investment_851c1(taxpayer, issuer, y, share);
    then taxpayer_investment_including_group_proportion_851c1(taxpayer, issuer, y, own + share);
}

// ---- Section 851(d): failure cures ----

pub relation ric_requirements_met_at_close_of_quarter_851d1(c: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "the corporation meets the requirements of sections 851(b)(3) and (c) at the close of the quarter";
}
pub relation previous_quarter_851d1(q: us.irc.core::Period, prior: us.irc.core::Period) kind empirical {
    label en unofficial "prior is the quarter immediately before q (no quarter navigation term in us.irc.core; TECH-GAPS G2201)";
}
pub relation value_discrepancy_in_quarter_851d1(c: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "a discrepancy between the value of the investments and the requirements exists during the quarter";
}
pub relation discrepancy_from_acquisition_851d1(c: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "the discrepancy exists immediately after the acquisition of a security or other property and is wholly or partly the result of that acquisition";
}
@source(IRC_S851_D, quote = "shall not lose its status as a regulated investment company because of a discrepancy during a subsequent quarter between the value of its various investments and such requirements")
pub relation ric_status_preserved_by_851d1(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "the corporation does not lose RIC status for the quarter because of a value discrepancy not resulting from an acquisition";
}
rule Section851d1StatusPreserved(c: Person, q: us.irc.core::Period, prior: us.irc.core::Period) defeasible {
    label en official "section 851(d)(1): status is not lost through a later discrepancy, unless it arises immediately after and from an acquisition";
    when previous_quarter_851d1(q, prior);
    when ric_requirements_met_at_close_of_quarter_851d1(c, prior);
    when value_discrepancy_in_quarter_851d1(c, q);
    when not_known(discrepancy_from_acquisition_851d1(c, q));
    then ric_status_preserved_by_851d1(c, q);
}

external judgment relation ric_failure_due_to_reasonable_cause_not_willful_neglect(c: Person, q: us.irc.core::Period) {
    authority Secretary;
    label en official "the failure is due to reasonable cause and not due to willful neglect (sections 851(d)(2)(A)(ii), 851(i)(1)(B)); an evaluative element, DECISION-0194 channel 1";
}
pub relation quarter_ends_on_851d2(q: us.irc.core::Period, last_day: Date) kind empirical {
    label en unofficial "the last day of the quarter in which the corporation's identification of the failure occurred";
}
pub relation failure_schedule_filed_851d2A(c: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "a description of each asset causing the failure is set forth in a schedule for the quarter filed in the manner provided by the Secretary";
}
pub relation failing_assets_disposed_on_851d2(c: Person, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the corporation disposes of the assets on the schedule on this date";
}
pub relation requirements_otherwise_met_by_851d2(c: Person, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the requirements of section 851(b)(3) are otherwise met on this date";
}
pub relation diversification_failure_deemed_cured_851d2(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "the corporation is considered to have satisfied section 851(b)(3) for the quarter";
}
@source(IRC_S851_D, quote = "the corporation disposes of the assets set forth on the schedule specified in clause (i) within 6 months after the last day of the quarter")
rule Section851d2ACureByDisposal(c: Person, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 851(d)(2)(A): schedule filed, reasonable cause, and disposal within 6 months of the quarter end cure the failure";
    when failure_schedule_filed_851d2A(c, q);
    when ric_failure_due_to_reasonable_cause_not_willful_neglect(c, q);
    when quarter_ends_on_851d2(q, last_day);
    when failing_assets_disposed_on_851d2(c, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then diversification_failure_deemed_cured_851d2(c, q);
}
@source(IRC_S851_D, quote = "the requirements of such subsection are otherwise met within the time period specified in subclause (I)")
rule Section851d2ACureByOtherwiseMet(c: Person, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 851(d)(2)(A)(iii)(II): the requirements are otherwise met within the 6 months";
    when failure_schedule_filed_851d2A(c, q);
    when ric_failure_due_to_reasonable_cause_not_willful_neglect(c, q);
    when quarter_ends_on_851d2(q, last_day);
    when requirements_otherwise_met_by_851d2(c, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then diversification_failure_deemed_cured_851d2(c, q);
}
pub relation failing_assets_total_value_851d2B(c: Person, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the total value of the assets whose ownership causes the failure";
}
pub relation total_assets_value_at_quarter_end_851d2B(c: Person, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the total value of the corporation's assets at the end of the quarter";
}
pub relation failing_assets_within_de_minimis_851d2B(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "the failing assets do not exceed the lesser of 1 percent of total assets and $10,000,000";
}
@source(IRC_S851_D, quote = "1 percent of the total value of the corporation's assets at the end of the quarter for which such measurement is done")
rule Section851d2BDeMinimis(c: Person, q: us.irc.core::Period, failing: Money, total: Money) strict {
    label en official "section 851(d)(2)(B)(i): failing assets at most 1 percent of total assets and at most $10,000,000";
    when failing_assets_total_value_851d2B(c, q, failing);
    when total_assets_value_at_quarter_end_851d2B(c, q, total);
    when failing * 100.0 <= total;
    when failing <= 10000000.00 USD;
    then failing_assets_within_de_minimis_851d2B(c, q);
}
pub relation de_minimis_failure_deemed_cured_851d2B(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "a de minimis failure is considered cured (section 851(d)(2)(B))";
}
@source(IRC_S851_D, quote = "the corporation, following the identification of such failure, disposes of assets in order to meet the requirements of such subsection within 6 months after the last day of the quarter")
rule Section851d2BCureByDisposal(c: Person, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 851(d)(2)(B): a de minimis failure is cured by disposal within 6 months of the quarter end";
    when failing_assets_within_de_minimis_851d2B(c, q);
    when quarter_ends_on_851d2(q, last_day);
    when failing_assets_disposed_on_851d2(c, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then de_minimis_failure_deemed_cured_851d2B(c, q);
}
rule Section851d2BCureByOtherwiseMet(c: Person, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 851(d)(2)(B)(ii)(II): a de minimis failure is cured when the requirements are otherwise met within 6 months";
    when failing_assets_within_de_minimis_851d2B(c, q);
    when quarter_ends_on_851d2(q, last_day);
    when requirements_otherwise_met_by_851d2(c, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then de_minimis_failure_deemed_cured_851d2B(c, q);
}
pub relation net_income_generated_by_failing_assets_851d2C(c: Person, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the net income generated by the scheduled assets for the period of clause (ii) (determined under regulations; asserted)";
}
pub relation section_851d2C_tax_imposed(c: Person, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the tax imposed when subparagraph (A) applies: the greater of $50,000 and the net income of the assets at the highest section 11 rate";
}
@source(IRC_S851_D, quote = "there is hereby imposed on such corporation a tax in an amount equal to the greater of")
rule Section851d2CTaxOnCuredFailure(c: Person, q: us.irc.core::Period, net_income: Money, rate: Decimal) strict {
    label en official "section 851(d)(2)(C)(i): tax equals the greater of $50,000 and the net income multiplied by the highest section 11 rate";
    when diversification_failure_deemed_cured_851d2(c, q);
    when net_income_generated_by_failing_assets_851d2C(c, q, net_income);
    when highest_rate_of_tax_section_11(rate);
    then section_851d2C_tax_imposed(c, q, max(50000.00 USD, round(net_income * rate, 2, "HALF_UP")));
}
pub relation section_851d2C_tax_treated_as_excise_tax(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "for subtitle F the tax is an excise tax to which the deficiency procedures apply (section 851(d)(2)(C)(iii))";
}
@source(IRC_S851_D, quote = "a tax imposed by this subparagraph shall be treated as an excise tax with respect to which the deficiency procedures of such subtitle apply")
rule Section851d2CIiiExciseTreatment(c: Person, q: us.irc.core::Period, amount: Money) strict {
    label en official "section 851(d)(2)(C)(iii): the tax is an excise tax subject to the deficiency procedures";
    when section_851d2C_tax_imposed(c, q, amount);
    then section_851d2C_tax_treated_as_excise_tax(c, q);
}

// ---- Section 851(f)-(h): unit investment trusts, funds, QPTPs ----

pub relation uit_registered_periodic_payment_plan_851f1A(t: Person) kind empirical {
    label en unofficial "a unit investment trust registered under the Investment Company Act of 1940 that issues periodic payment plan certificates in one or more series";
}
pub relation uit_substantially_all_assets_single_issuer_851f1B(t: Person) kind empirical {
    label en unofficial "substantially all the assets of the trust, as to all series, are securities issued by a single management company (and securities acquired under (C)) or by a single other corporation";
}
pub relation uit_no_power_to_invest_elsewhere_851f1C(t: Person) kind empirical {
    label en unofficial "the trust has no power to invest in any securities other than those of a single other management company, when permitted";
}
pub relation uit_is_segregated_asset_account_851f(t: Person) kind empirical {
    label en unofficial "the unit investment trust is a segregated asset account under State insurance laws or regulations";
}
@source(IRC_S851_F, quote = "shall not be treated as a person")
pub relation uit_not_treated_as_person_851f1(t: Person) kind institutional {
    label en official "the unit investment trust is not treated as a person for purposes of the title";
}
rule Section851f1UitNotAPerson(t: Person) strict {
    label en official "section 851(f)(1): a qualifying unit investment trust is not treated as a person, unless it is a segregated asset account";
    when uit_registered_periodic_payment_plan_851f1A(t);
    when uit_substantially_all_assets_single_issuer_851f1B(t);
    when uit_no_power_to_invest_elsewhere_851f1C(t);
    when not_known(uit_is_segregated_asset_account_851f(t));
    then uit_not_treated_as_person_851f1(t);
}
pub relation holder_interest_share_in_uit_851f2A(h: Person, t: Person, share: Decimal) kind empirical {
    label en unofficial "the holder's proportionate interest in the trust";
}
pub relation basis_of_holder_interest_in_uit_851f2B(h: Person, t: Person, amount: Money) kind empirical {
    label en unofficial "the holder's basis in the interest in the trust";
}
pub relation holding_period_start_of_holder_interest_851f2C(h: Person, t: Person, start: Date) kind empirical {
    label en unofficial "the date the holder's holding period of the interest in the trust began";
}
pub relation holder_treated_as_owning_share_of_uit_assets_851f2A(h: Person, t: Person, share: Decimal) kind institutional {
    label en official "the holder is treated as owning a proportionate share of the trust's assets, to the extent of the interest";
}
pub relation basis_of_uit_assets_treated_as_owned_851f2B(h: Person, t: Person, amount: Money) kind institutional {
    label en official "the basis of the assets treated as owned by the holder equals the basis of the interest in the trust";
}
pub relation holding_period_start_of_uit_assets_851f2C(h: Person, t: Person, start: Date) kind institutional {
    label en official "the holding period of the assets treated as owned includes the period the holder held the interest";
}
@source(IRC_S851_F, quote = "each holder of an interest in such trust shall, to the extent of such interest, be treated as owning a proportionate share of the assets of such trust")
rule Section851f2AProportionateOwnership(h: Person, t: Person, share: Decimal) strict {
    label en official "section 851(f)(2)(A): holders of a qualifying trust own a proportionate share of the trust's assets";
    when uit_not_treated_as_person_851f1(t);
    when holder_interest_share_in_uit_851f2A(h, t, share);
    then holder_treated_as_owning_share_of_uit_assets_851f2A(h, t, share);
}
@source(IRC_S851_F, quote = "the basis of the assets of such trust which are treated under subparagraph (A) as being owned by a holder of an interest in such trust shall be the same as the basis of his interest in such trust")
rule Section851f2BBasis(h: Person, t: Person, amount: Money) strict {
    label en official "section 851(f)(2)(B): the basis of the assets treated as owned equals the basis of the holder's interest";
    when uit_not_treated_as_person_851f1(t);
    when basis_of_holder_interest_in_uit_851f2B(h, t, amount);
    then basis_of_uit_assets_treated_as_owned_851f2B(h, t, amount);
}
@source(IRC_S851_F, quote = "there shall be included the period for which such holder has held his interest in such trust")
rule Section851f2CHoldingPeriod(h: Person, t: Person, start: Date) strict {
    label en official "section 851(f)(2)(C): the holding period of the assets includes the holder's holding period of the interest";
    when uit_not_treated_as_person_851f1(t);
    when holding_period_start_of_holder_interest_851f2C(h, t, start);
    then holding_period_start_of_uit_assets_851f2C(h, t, start);
}
pub relation fund_of_regulated_investment_company_851g(f: Person, c: Person) kind empirical {
    label en unofficial "f is a segregated portfolio of assets of c, the beneficial interests in which are owned by the holders of a class or series of c's stock that is preferred over all other classes or series in respect of that portfolio";
}
pub relation number_of_funds_851g1(c: Person, n: Integer) kind empirical {
    label en unofficial "the number of funds of the regulated investment company";
}
@source(IRC_S851_G, quote = "each fund of such regulated investment company shall be treated as a separate corporation for purposes of this title")
pub relation fund_treated_as_separate_corporation_851g1(f: Person) kind institutional {
    label en official "the fund is treated as a separate corporation for the title (except the definitional requirement of subsection (a))";
}
rule Section851g1SeparateCorporationPerFund(f: Person, c: Person, n: Integer) strict {
    label en official "section 851(g)(1): each fund of a multi-fund regulated investment company is a separate corporation";
    when fund_of_regulated_investment_company_851g(f, c);
    when number_of_funds_851g1(c, n);
    when n > 1;
    then fund_treated_as_separate_corporation_851g1(f);
}
pub relation publicly_traded_partnership_7704b_851h(p: Person) kind empirical {
    label en unofficial "the partnership is a publicly traded partnership described in section 7704(b)";
}
pub relation satisfies_7704c2_with_only_851b2A_income_851h(p: Person) kind empirical {
    label en unofficial "the partnership would satisfy the gross income requirements of section 7704(c)(2) if qualifying income included only income described in section 851(b)(2)(A)";
}
@source(IRC_S851_H, quote = "the term \"qualified publicly traded partnership\" means a publicly traded partnership described in section 7704(b) other than a partnership which would satisfy the gross income requirements of section 7704(c)(2) if qualifying income included only income described in subsection (b)(2)(A)")
pub relation qualified_publicly_traded_partnership_851h(p: Person) kind institutional {
    label en official "a qualified publicly traded partnership";
}
rule Section851hQualifiedPubliclyTradedPartnership(p: Person) defeasible {
    label en official "section 851(h): a publicly traded partnership other than one meeting section 7704(c)(2) on section 851(b)(2)(A) income alone";
    when publicly_traded_partnership_7704b_851h(p);
    when not_known(satisfies_7704c2_with_only_851b2A_income_851h(p));
    then qualified_publicly_traded_partnership_851h(p);
}

// ---- Section 851(i): gross income test failure ----

pub relation gross_income_test_schedule_filed_851i1A(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "a description of each item of gross income described in section 851(b)(2) is set forth in a schedule for the taxable year filed in the manner provided by the Secretary";
}
external judgment relation ric_income_failure_due_to_reasonable_cause_not_willful_neglect(c: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the failure to meet section 851(b)(2) is due to reasonable cause and not due to willful neglect (section 851(i)(1)(B)); DECISION-0194 channel 1";
}
pub relation ric_income_requirement_deemed_satisfied_851i1(c: Person, y: TaxableYear) kind institutional {
    label en official "the corporation is considered to have satisfied section 851(b)(2) for the taxable year";
}
@source(IRC_S851_I, quote = "shall nevertheless be considered to have satisfied the requirement of such paragraph for such taxable year if")
rule Section851i1IncomeTestCure(c: Person, y: TaxableYear) strict {
    label en official "section 851(i)(1): a schedule and reasonable cause cure a failure of the 90 percent income test";
    when gross_income_test_schedule_filed_851i1A(c, y);
    when ric_income_failure_due_to_reasonable_cause_not_willful_neglect(c, y);
    then ric_income_requirement_deemed_satisfied_851i1(c, y);
}
pub relation section_851i2_tax_imposed(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed when paragraph (1) applies: the excess of nonqualifying gross income over 1/9 of qualifying gross income";
}
@source(IRC_S851_I, quote = "a tax in an amount equal to the excess of")
rule Section851i2TaxOnNonqualifyingIncome(c: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 851(i)(2): tax = gross income not derived from section 851(b)(2) sources, over 1/9 of the gross income derived from them (never below zero)";
    when ric_income_requirement_deemed_satisfied_851i1(c, y);
    when qualifying_gross_income_851b2(c, y, qualifying);
    when total_gross_income_851(c, y, total);
    // JUDGMENT CALL: 1/9 of a Money amount is rounded to cents HALF_UP.
    then section_851i2_tax_imposed(c, y, max(0.00 USD, (total - qualifying) - div_round(qualifying, 9.0, 2, "HALF_UP")));
}

// ---- Section 852(b)(4), (6)-(9): holding and timing rules ----

pub relation share_held_six_months_or_less_852b4(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en unofficial "the shareholder has held the share for 6 months or less, counting under the section 246(c)(3)-(4) rules and ignoring any day more than 6 months after the ex-dividend date (the count itself is asserted; the section 246(c) holding-period rules belong to us.irc.corporations)";
}
pub relation capital_gain_dividend_treated_as_long_term_on_share_852b4(sh: Person, share: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount treated under section 852(b)(3)(B) or (D) as long-term capital gain with respect to the share";
}
pub relation exempt_interest_dividend_received_on_share_852b4(sh: Person, share: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the exempt-interest dividend the shareholder received with respect to the share";
}
pub relation loss_on_sale_of_ric_share_852b4(sh: Person, share: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the loss on the sale or exchange of the regulated investment company share";
}
pub relation loss_disallowed_by_exempt_interest_dividend_852b4B(sh: Person, share: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the loss disallowed to the extent of the exempt-interest dividend on a share held 6 months or less";
}
pub relation has_exempt_interest_dividend_on_share_852b4(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en official "helper binding the open amount argument: the shareholder received an exempt-interest dividend on the share";
}
rule Section852b4HelperHasExemptInterestDividend(sh: Person, share: us.irc.core::Asset, amount: Money) strict {
    label en official "helper: an exempt-interest dividend on the share exists";
    when exempt_interest_dividend_received_on_share_852b4(sh, share, amount);
    then has_exempt_interest_dividend_on_share_852b4(sh, share);
}
rule Section852b4BNoExemptInterestDividendNothingDisallowed(sh: Person, share: us.irc.core::Asset, loss: Money) strict {
    label en official "section 852(b)(4)(B): with no exempt-interest dividend on the share nothing is disallowed";
    when share_held_six_months_or_less_852b4(sh, share);
    when loss_on_sale_of_ric_share_852b4(sh, share, loss);
    when not_known(has_exempt_interest_dividend_on_share_852b4(sh, share));
    then loss_disallowed_by_exempt_interest_dividend_852b4B(sh, share, 0.00 USD);
}
@source(IRC_S852_B, quote = "then any loss on the sale or exchange of such share shall, to the extent of the amount of such exempt-interest dividend, be disallowed")
rule Section852b4BLossDisallowed(sh: Person, share: us.irc.core::Asset, loss: Money, exempt: Money) strict {
    label en official "section 852(b)(4)(B): the loss on a share held 6 months or less is disallowed to the extent of the exempt-interest dividend";
    when share_held_six_months_or_less_852b4(sh, share);
    when exempt_interest_dividend_received_on_share_852b4(sh, share, exempt);
    when loss_on_sale_of_ric_share_852b4(sh, share, loss);
    then loss_disallowed_by_exempt_interest_dividend_852b4B(sh, share, min(loss, exempt));
}
pub relation loss_treated_as_long_term_capital_loss_852b4A(sh: Person, share: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the loss (not disallowed under (B)) treated as a long-term capital loss to the extent of the amount treated as long-term capital gain";
}
@source(IRC_S852_B, quote = "then any loss (to the extent not disallowed under subparagraph (B)) on the sale or exchange of such share shall, to the extent of the amount described in clause (i), be treated as a long-term capital loss")
rule Section852b4ALossIsLongTerm(sh: Person, share: us.irc.core::Asset, loss: Money, gain: Money, disallowed: Money) strict {
    label en official "section 852(b)(4)(A): the loss on a share held 6 months or less is long-term to the extent of the capital gain dividend amount";
    when share_held_six_months_or_less_852b4(sh, share);
    when capital_gain_dividend_treated_as_long_term_on_share_852b4(sh, share, gain);
    when loss_on_sale_of_ric_share_852b4(sh, share, loss);
    when loss_disallowed_by_exempt_interest_dividend_852b4B(sh, share, disallowed);
    then loss_treated_as_long_term_capital_loss_852b4A(sh, share, min(loss - disallowed, gain));
}
pub relation redemption_on_demand_of_shareholder_852b6(c: Person, y: TaxableYear, distribution: us.irc.core::Payment) kind empirical {
    label en unofficial "the distribution is in redemption of the company's stock upon the demand of the shareholder";
}
@source(IRC_S852_B, quote = "Section 311(b) shall not apply to any distribution by a regulated investment company to which this part applies, if such distribution is in redemption of its stock upon the demand of the shareholder.")
pub relation section_311b_inapplicable_852b6(c: Person, y: TaxableYear, distribution: us.irc.core::Payment) kind institutional {
    label en official "section 311(b) does not apply to the redemption distribution";
}
rule Section852b6NoGainOnDemandRedemption(c: Person, y: TaxableYear, distribution: us.irc.core::Payment) strict {
    label en official "section 852(b)(6): section 311(b) does not apply to a redemption on the shareholder's demand by a company to which part I applies";
    when subchapter_m_part_i_applies(c, y);
    when redemption_on_demand_of_shareholder_852b6(c, y, distribution);
    then section_311b_inapplicable_852b6(c, y, distribution);
}
pub relation dividend_declared_in_october_november_december_852b7(c: Person, dividend: us.irc.core::Payment, calendar_year: Integer) kind empirical {
    label en unofficial "the dividend is declared in October, November or December of the calendar year and payable to shareholders of record on a specified date in such a month";
}
pub relation dividend_actually_paid_in_january_following_852b7(c: Person, dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is actually paid by the company during January of the following calendar year";
}
@source(IRC_S852_B, quote = "to have been received by each shareholder on December 31 of such calendar year")
pub relation dividend_deemed_received_and_paid_on_december_31_852b7(c: Person, dividend: us.irc.core::Payment, calendar_year: Integer) kind institutional {
    label en official "the dividend is deemed received by each shareholder and paid by the company on December 31 of the calendar year (a date cannot be built from a year number; TECH-GAPS G2203, so the calendar year is the value)";
}
rule Section852b7YearEndDividendDeeming(c: Person, dividend: us.irc.core::Payment, calendar_year: Integer) strict {
    label en official "section 852(b)(7): an Oct-Dec dividend paid in the following January is deemed received and paid on December 31";
    when dividend_declared_in_october_november_december_852b7(c, dividend, calendar_year);
    when dividend_actually_paid_in_january_following_852b7(c, dividend);
    then dividend_deemed_received_and_paid_on_december_31_852b7(c, dividend, calendar_year);
}
pub relation net_capital_loss_after_october_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net capital loss attributable to the portion of the taxable year after October 31";
}
pub relation net_long_term_capital_loss_after_october_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net long-term capital loss attributable to the portion of the taxable year after October 31";
}
pub relation net_short_term_capital_loss_after_october_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net short-term capital loss attributable to the portion of the taxable year after October 31";
}
pub relation specified_losses_after_october_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the specified losses (section 4982(e)(5)(B)(ii)) attributable to the portion after October 31";
}
pub relation specified_gains_after_october_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the specified gains (section 4982(e)(5)(B)(i)) attributable to the portion after October 31";
}
pub relation ordinary_losses_after_december_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the ordinary losses not described in subparagraph (E)(i) attributable to the portion after December 31";
}
pub relation ordinary_income_after_december_31_852b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the ordinary income not described in subparagraph (E)(ii) attributable to the portion after December 31";
}
pub relation post_october_capital_loss_852b8C(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the post-October capital loss: the net capital loss after October 31 or, if none, the net long-term or short-term capital loss after October 31";
}
@source(IRC_S852_B, quote = "any net capital loss attributable to the portion of the taxable year after October 31")
rule Section852b8CNetCapitalLossBranch(c: Person, y: TaxableYear, ncl: Money) strict {
    label en official "section 852(b)(8)(C)(i): a net capital loss after October 31 is the post-October capital loss";
    when net_capital_loss_after_october_31_852b8(c, y, ncl);
    when ncl > 0.00 USD;
    then post_october_capital_loss_852b8C(c, y, ncl);
}
@source(IRC_S852_B, quote = "if there is no such loss—")
rule Section852b8CNoNetCapitalLossBranch(c: Person, y: TaxableYear, ncl: Money, lt: Money, st: Money) strict {
    label en official "section 852(b)(8)(C)(ii): with no net capital loss after October 31, the net long-term and net short-term capital losses after October 31";
    when net_capital_loss_after_october_31_852b8(c, y, ncl);
    when ncl <= 0.00 USD;
    when net_long_term_capital_loss_after_october_31_852b8(c, y, lt);
    when net_short_term_capital_loss_after_october_31_852b8(c, y, st);
    then post_october_capital_loss_852b8C(c, y, lt + st);
}
pub relation post_october_specified_loss_852b8E(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of specified losses over specified gains attributable to the portion after October 31";
}
rule Section852b8EPostOctoberSpecifiedLoss(c: Person, y: TaxableYear, losses: Money, gains: Money) strict {
    label en official "section 852(b)(8)(E): the excess (if any) of specified losses over specified gains after October 31";
    when specified_losses_after_october_31_852b8(c, y, losses);
    when specified_gains_after_october_31_852b8(c, y, gains);
    then post_october_specified_loss_852b8E(c, y, max(0.00 USD, losses - gains));
}
pub relation post_december_ordinary_loss_852b8F(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of ordinary losses over ordinary income attributable to the portion after December 31";
}
rule Section852b8FPostDecemberOrdinaryLoss(c: Person, y: TaxableYear, losses: Money, income: Money) strict {
    label en official "section 852(b)(8)(F): the excess (if any) of ordinary losses over ordinary income after December 31";
    when ordinary_losses_after_december_31_852b8(c, y, losses);
    when ordinary_income_after_december_31_852b8(c, y, income);
    then post_december_ordinary_loss_852b8F(c, y, max(0.00 USD, losses - income));
}
pub relation late_year_ordinary_loss_852b8D(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the late-year ordinary loss: the sum of the post-October specified loss and the post-December ordinary loss";
}
rule Section852b8DLateYearOrdinaryLoss(c: Person, y: TaxableYear, specified: Money, december: Money) strict {
    label en official "section 852(b)(8)(D): late-year ordinary loss is the sum of the two components";
    when post_october_specified_loss_852b8E(c, y, specified);
    when post_december_ordinary_loss_852b8F(c, y, december);
    then late_year_ordinary_loss_852b8D(c, y, specified + december);
}
pub relation qualified_late_year_loss_852b8B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the qualified late-year loss: the post-October capital loss plus the late-year ordinary loss";
}
rule Section852b8BQualifiedLateYearLoss(c: Person, y: TaxableYear, capital: Money, ordinary: Money) strict {
    label en official "section 852(b)(8)(B): qualified late-year loss is the sum of the post-October capital loss and the late-year ordinary loss";
    when post_october_capital_loss_852b8C(c, y, capital);
    when late_year_ordinary_loss_852b8D(c, y, ordinary);
    when not_known(november_year_electing_company_852b8Gi(c, y));
    then qualified_late_year_loss_852b8B(c, y, capital + ordinary);
}
pub relation elects_to_defer_qualified_late_year_loss_852b8A(c: Person, y: TaxableYear, portion: Money) kind empirical {
    label en unofficial "the company elects to treat this portion of its qualified late-year loss as arising on the first day of the following taxable year";
}
pub relation late_year_loss_treated_as_arising_first_day_of_next_year_852b8A(c: Person, y: TaxableYear, portion: Money) kind institutional {
    label en official "the portion of the qualified late-year loss is treated as arising on the first day of the following taxable year, for purposes of the title";
}
@source(IRC_S852_B, quote = "a regulated investment company may elect for any taxable year to treat any portion of any qualified late-year loss for such taxable year as arising on the first day of the following taxable year")
rule Section852b8AElectionToDeferLateYearLoss(c: Person, y: TaxableYear, portion: Money, total: Money) strict {
    label en official "section 852(b)(8)(A): the company may elect to defer a portion of its qualified late-year loss to the next year's first day";
    when elects_to_defer_qualified_late_year_loss_852b8A(c, y, portion);
    when qualified_late_year_loss_852b8B(c, y, total);
    then power RicLateYearLossElection {
        holder c;
        over c;
        exercise elects_to_defer_qualified_late_year_loss_852b8A(c, y, portion);
        valid_when election_within_qualified_late_year_loss_852b8A(c, y, portion);
        effect create(late_year_loss_treated_as_arising_first_day_of_next_year_852b8A(c, y, portion));
        window [@2010-12-22, infinity);
    };
}
pub relation election_within_qualified_late_year_loss_852b8A(c: Person, y: TaxableYear, portion: Money) kind institutional {
    label en official "the elected portion does not exceed the qualified late-year loss (helper: valid_when takes one atom)";
}
rule Section852b8AElectedPortionWithinLoss(c: Person, y: TaxableYear, portion: Money, total: Money) strict {
    label en official "section 852(b)(8)(A): only a portion of an existing qualified late-year loss can be deferred";
    when elects_to_defer_qualified_late_year_loss_852b8A(c, y, portion);
    when qualified_late_year_loss_852b8B(c, y, total);
    when portion <= total;
    when not_known(election_to_defer_unavailable_852b8Gii(c, y));
    then election_within_qualified_late_year_loss_852b8A(c, y, portion);
}
pub relation ex_dividend_date_852b9(c: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the share became ex-dividend with respect to the dividend";
}
pub relation share_acquired_on_852b9(c: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the company acquired the share";
}
pub relation share_record_holder_on_record_date_852b9(c: Person, share: us.irc.core::Asset) kind empirical {
    label en unofficial "the company is the holder of record of the share on the record date for the dividend";
}
pub relation dividend_inclusion_date_852b9(c: Person, share: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the dividend is included in the company's gross income as of the later of the ex-dividend date and the acquisition date";
}
@source(IRC_S852_B, quote = "such dividend shall be included in gross income by such company as of the later of")
rule Section852b9ExDividendLater(c: Person, share: us.irc.core::Asset, ex_on: Date, acquired_on: Date) strict {
    label en official "section 852(b)(9): the ex-dividend date governs when it is not before the acquisition date";
    when share_record_holder_on_record_date_852b9(c, share);
    when ex_dividend_date_852b9(c, share, ex_on);
    when share_acquired_on_852b9(c, share, acquired_on);
    when ex_on >= acquired_on;
    then dividend_inclusion_date_852b9(c, share, ex_on);
}
rule Section852b9AcquisitionLater(c: Person, share: us.irc.core::Asset, ex_on: Date, acquired_on: Date) strict {
    label en official "section 852(b)(9): the acquisition date governs when it is after the ex-dividend date";
    when share_record_holder_on_record_date_852b9(c, share);
    when ex_dividend_date_852b9(c, share, ex_on);
    when share_acquired_on_852b9(c, share, acquired_on);
    when acquired_on > ex_on;
    then dividend_inclusion_date_852b9(c, share, acquired_on);
}

// ---- Section 852(c): earnings and profits ----

pub relation earnings_and_profits_before_capital_loss_adjustment_852c1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the company's earnings and profits for the year determined with the net capital loss taken into account";
}
pub relation net_capital_loss_of_ric_852c1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net capital loss of the regulated investment company for the taxable year";
}
pub relation earnings_and_profits_ignoring_net_capital_loss_852c1A(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits for the year, the net capital loss not being taken into account";
}
@source(IRC_S852_C, quote = "such net capital loss shall not be taken into account for purposes of determining the company's earnings and profits")
rule Section852c1ANetCapitalLossIgnored(c: Person, y: TaxableYear, ep: Money, ncl: Money) strict {
    label en official "section 852(c)(1)(A)(i): the net capital loss is disregarded in earnings and profits";
    when earnings_and_profits_before_capital_loss_adjustment_852c1(c, y, ep);
    when net_capital_loss_of_ric_852c1(c, y, ncl);
    then earnings_and_profits_ignoring_net_capital_loss_852c1A(c, y, ep + ncl);
}
pub relation nondeductible_amount_reducing_ep_852c1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount not allowable as a deduction in computing taxable income for the year (other than by reason of section 265 or 171(a)(2)) that would reduce earnings and profits";
}
pub relation earnings_and_profits_for_year_852c1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits of the year (not accumulated), not reduced by amounts nondeductible other than by reason of section 265 or 171(a)(2)";
}
pub relation earnings_and_profits_before_nondeductible_reduction_852c1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits for the year after every reduction, including the nondeductible amount";
}
@source(IRC_S852_C, quote = "shall not be reduced by any amount which is not allowable as a deduction (other than by reason of section 265 or 171(a)(2)) in computing its taxable income")
rule Section852c1BNondeductibleNotReducing(c: Person, y: TaxableYear, ep: Money, nondeductible: Money) strict {
    label en official "section 852(c)(1)(B)(i): earnings and profits for the year are not reduced by nondeductible amounts";
    when earnings_and_profits_before_nondeductible_reduction_852c1B(c, y, ep);
    when nondeductible_amount_reducing_ep_852c1B(c, y, nondeductible);
    then earnings_and_profits_for_year_852c1B(c, y, ep + nondeductible);
}
pub relation required_distribution_at_100_percent_852c2(c: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en unofficial "the required distribution for the calendar year determined under section 4982 substituting 100 percent for each percentage in section 4982(b)(1)";
}
pub relation distributed_with_respect_to_calendar_year_852c2(c: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en unofficial "the amount distributed by the company with respect to the calendar year";
}
pub relation section_4982e4_election_in_effect_852c2B(c: Person) kind empirical {
    label en unofficial "an election under section 4982(e)(4) is in effect with respect to the company";
}
pub relation post_october_net_capital_loss_disregarded_for_distributions_852c2(c: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the net capital loss after October 31 is disregarded in the earnings and profits used for distributions with respect to the calendar year, up to the required distribution";
}
@source(IRC_S852_C, quote = "the earnings and profits of such company shall be determined without regard to any net capital loss attributable to the portion of the taxable year after October 31")
rule Section852c2CalendarYearDistributions(c: Person, calendar_year: Integer, required: Money, distributed: Money) defeasible {
    label en official "section 852(c)(2): earnings and profits for calendar-year distributions ignore the post-October net capital loss, to the extent the distribution does not exceed the required distribution and no section 4982(e)(4) election is in effect";
    when required_distribution_at_100_percent_852c2(c, calendar_year, required);
    when distributed_with_respect_to_calendar_year_852c2(c, calendar_year, distributed);
    when not_known(section_4982e4_election_in_effect_852c2B(c));
    then post_october_net_capital_loss_disregarded_for_distributions_852c2(c, calendar_year, min(distributed, required));
}
@source(IRC_S852_C, quote = "the term \"regulated investment company\" includes a domestic corporation which is a regulated investment company determined without regard to the requirements of subsection (a)")
pub relation ric_for_852c_purposes(c: Person, y: TaxableYear) kind institutional {
    label en official "for section 852(c) the term regulated investment company includes a domestic corporation that would be one without regard to subsection (a)";
}
rule Section852c4RicForEarningsAndProfits(c: Person, y: TaxableYear) strict {
    label en official "section 852(c)(4): a domestic corporation that is a RIC apart from the section 852(a) requirements counts";
    when domestic_corporation_candidate(c);
    when regulated_investment_company_candidate(c);
    when elects_regulated_investment_company_status(c, y);
    then ric_for_852c_purposes(c, y);
}

// ---- Section 852(d): unit investment trust redemptions ----

pub relation uit_redemption_distribution_852d(t: Person, holder: Person, distribution: us.irc.core::Payment) kind empirical {
    label en unofficial "a distribution by the unit investment trust to a holder in redemption of part or all of the interest, with respect to the capital gain net income attributable to the redemption";
}
pub relation uit_registered_holding_management_company_securities_852d(t: Person) kind empirical {
    label en unofficial "the trust is registered under the Investment Company Act of 1940, issues periodic payment plan certificates, and substantially all its assets are securities issued by a management company";
}
@source(IRC_S852_D, quote = "section 562(c) (relating to preferential dividends) shall not apply to a distribution by such trust to a holder of an interest in such trust in redemption of part or all of such interest")
pub relation preferential_dividend_rule_inapplicable_852d(t: Person, distribution: us.irc.core::Payment) kind institutional {
    label en official "section 562(c) does not apply to the redemption distribution";
}
rule Section852dNoPreferentialDividendRule(t: Person, holder: Person, distribution: us.irc.core::Payment) strict {
    label en official "section 852(d): the preferential-dividend rule does not apply to a qualifying trust's redemption distributions";
    when uit_registered_holding_management_company_securities_852d(t);
    when uit_redemption_distribution_852d(t, holder, distribution);
    then preferential_dividend_rule_inapplicable_852d(t, distribution);
}

// ---- Section 852(e): determination that part I did not apply ----

pub relation non_ric_year_determination_on_852e1(c: Person, y: TaxableYear, determined_on: Date) kind empirical {
    label en unofficial "a determination (as defined in section 860(e)) that part I did not apply to the company for the non-RIC year is made on this date";
}
pub relation aep_attributable_to_non_ric_year_852e2A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of accumulated earnings and profits, as of the determination date, attributable to the non-RIC year";
}
pub relation interest_payable_852e3_amount(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest payable under paragraph (3) (the underpayment rate of section 6621 on 50 percent of the amount in (2)(A)(i) for the period of (3)(A)(ii); the rate and compounding belong to us.irc.payment_refunds_interest, TECH-GAPS G2204)";
}
pub relation qualified_designated_distribution_852e2B(c: Person, y: TaxableYear, distribution: us.irc.core::Payment, amount: Money, paid_on: Date) kind empirical {
    label en unofficial "a distribution to which section 301 applies, designated as taken into account under paragraph (2) for the non-RIC year";
}
pub relation qualified_distribution_within_90_days_852e2A(c: Person, y: TaxableYear, distribution: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a qualified designated distribution made within the 90-day period beginning on the determination date";
}
rule Section852e2AWithinNinetyDays(c: Person, y: TaxableYear, distribution: us.irc.core::Payment, amount: Money, paid_on: Date, determined_on: Date) strict {
    label en official "section 852(e)(2)(A): the distribution is made within 90 days of the determination";
    when non_ric_year_determination_on_852e1(c, y, determined_on);
    when qualified_designated_distribution_852e2B(c, y, distribution, amount, paid_on);
    when paid_on >= determined_on;
    when paid_on <= add_calendar_period(determined_on, 90 calendar_day);
    then qualified_distribution_within_90_days_852e2A(c, y, distribution, amount);
}
pub relation section_852e_finding_of_fraud(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the determination contains a finding that the failure to meet a requirement of part I was due to fraud with intent to evade tax";
}
pub relation non_ric_year_treated_as_part_i_year_852e1(c: Person, y: TaxableYear) kind institutional {
    label en official "for applying subsection (a)(2) to later years, part I is treated as having applied to the company for the non-RIC year";
}
@source(IRC_S852_E, quote = "the provisions of this part shall be treated as applying to such investment company for the non-RIC year")
rule Section852e1DeemedPartIYear(c: Person, y: TaxableYear, determined_on: Date, aep: Money, interest: Money, distributed: Money) defeasible {
    label en official "section 852(e)(1)-(2): distributions within 90 days of at least the accumulated earnings of the non-RIC year (less interest) treat part I as applying to that year";
    when non_ric_year_determination_on_852e1(c, y, determined_on);
    when aep_for_distribution_requirement_852e2Ai(c, y, aep);
    when interest_payable_852e3_amount(c, y, interest);
    when total_qualified_distributions_within_90_days_852e2A(c, y, distributed);
    when distributed >= aep - interest;
    when not_known(section_852e_finding_of_fraud(c, y));
    then non_ric_year_treated_as_part_i_year_852e1(c, y);
}
pub relation total_qualified_distributions_within_90_days_852e2A(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of qualified designated distributions made within the 90-day window";
}
rule Section852e2ATotalWithinWindow(c: Person, y: TaxableYear) strict {
    label en official "section 852(e)(2)(A): the sum of the qualifying distributions in the window";
    when qualified_distribution_within_90_days_852e2A(c, y, _, _);
    then total_qualified_distributions_within_90_days_852e2A(c, y, sum all amount: Money for d: us.irc.core::Payment where qualified_distribution_within_90_days_852e2A(c, y, d, amount));
}

// ---- Section 852(f): load charges ----

pub relation load_charge_incurred_852f1A(sh: Person, stock: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the taxpayer incurs a load charge in acquiring the stock, and by reason of that acquires a reinvestment right";
}
pub relation stock_acquired_on_852f1(sh: Person, stock: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the stock was acquired";
}
pub relation stock_disposed_on_852f1(sh: Person, stock: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the stock was disposed of";
}
pub relation reduction_in_load_charge_on_later_acquisition_852f1C(sh: Person, stock: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the reduction of the load charge on stock in a regulated investment company acquired between the disposition and January 31 of the following calendar year, by reason of the reinvestment right";
}
pub relation load_charge_excluded_from_gain_or_loss_852f1(sh: Person, stock: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the load charge not taken into account in determining gain or loss on the disposition (to the extent of the reduction)";
}
@source(IRC_S852_F, quote = "the load charge referred to in subparagraph (A) (to the extent it does not exceed the reduction referred to in subparagraph (C)) shall not be taken into account for purposes of determining the amount of gain or loss on the disposition referred to in subparagraph (B)")
rule Section852f1LoadChargeDisregarded(sh: Person, stock: us.irc.core::Asset, load: Money, reduction: Money, acquired_on: Date, disposed_on: Date) strict {
    label en official "section 852(f)(1): a load charge is disregarded in computing gain or loss, to the extent of the later reduction, when the stock is disposed of before the 91st day";
    when load_charge_incurred_852f1A(sh, stock, load);
    when stock_acquired_on_852f1(sh, stock, acquired_on);
    when stock_disposed_on_852f1(sh, stock, disposed_on);
    when disposed_on <= add_calendar_period(acquired_on, 90 calendar_day);
    when reduction_in_load_charge_on_later_acquisition_852f1C(sh, stock, reduction);
    then load_charge_excluded_from_gain_or_loss_852f1(sh, stock, min(load, reduction));
}

// ---- Section 853: foreign tax pass-through ----

pub relation foreign_stock_and_securities_value_at_close_853a1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value (section 851(c)(4)) of the company's assets consisting of stock or securities in foreign corporations at the close of the taxable year";
}
pub relation total_assets_value_at_close_853a1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the company's total assets at the close of the taxable year";
}
pub relation elects_foreign_tax_pass_through_853a(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company elects the application of section 853 for the taxable year";
}
pub relation foreign_income_taxes_paid_by_ric_853a(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the income, war profits and excess profits taxes described in section 901(b)(1) paid to foreign countries and possessions during the year";
}
pub relation foreign_taxes_not_creditable_by_901k_or_l_853e(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the taxes for which no credit is allowed by reason of section 901(k) or (l)";
}
pub relation eligible_for_foreign_tax_election_853a(c: Person, y: TaxableYear) kind institutional {
    label en official "the company has more than 50 percent of the value of its total assets in foreign stock or securities and meets section 852(a)";
}
@source(IRC_S853_A, quote = "more than 50 percent of the value (as defined in section 851(c)(4)) of whose total assets at the close of the taxable year consists of stock or securities in foreign corporations")
rule Section853aEligibility(c: Person, y: TaxableYear, foreign: Money, total: Money) strict {
    label en official "section 853(a)(1)-(2): more than half of total assets in foreign securities, and section 852(a) is met";
    when foreign_stock_and_securities_value_at_close_853a1(c, y, foreign);
    when total_assets_value_at_close_853a1(c, y, total);
    when foreign * 2.0 > total;
    when section_852a1_distribution_requirement_met(c, y);
    then eligible_for_foreign_tax_election_853a(c, y);
}
pub relation section_853_election_effective(c: Person, y: TaxableYear) kind institutional {
    label en official "the election under section 853(a) is effective for the taxable year";
}
@source(IRC_S853_A, quote = "may, for such taxable year, elect the application of this section with respect to income, war profits, and excess profits taxes described in section 901(b)(1)")
rule Section853aElectionPower(c: Person, y: TaxableYear) strict {
    label en official "section 853(a): an eligible company may elect pass-through of foreign taxes";
    when elects_foreign_tax_pass_through_853a(c, y);
    then power RicForeignTaxElection {
        holder c;
        over c;
        exercise elects_foreign_tax_pass_through_853a(c, y);
        valid_when eligible_for_foreign_tax_election_853a(c, y);
        effect create(section_853_election_effective(c, y));
        window [@1955-01-01, infinity);
    };
}
pub relation ric_foreign_tax_deduction_or_credit_denied_853b1A(c: Person, y: TaxableYear) kind institutional {
    label en official "the company is allowed no deduction under section 164(a) or credit under section 901 for the taxes covered by the election";
}
rule Section853b1ADeductionAndCreditDenied(c: Person, y: TaxableYear) strict {
    label en official "section 853(b)(1)(A): no deduction or credit for the passed-through taxes";
    when section_853_election_effective(c, y);
    then ric_foreign_tax_deduction_or_credit_denied_853b1A(c, y);
}
pub relation addition_to_dividends_paid_deduction_853b1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the foreign taxes allowed as an addition to the dividends paid deduction";
}
@source(IRC_S853_B, quote = "shall be allowed as an addition to the dividends paid deduction for such taxable year the amount of such taxes")
rule Section853b1BAdditionToDividendsPaidDeduction(c: Person, y: TaxableYear, taxes: Money, not_creditable: Money) strict {
    label en official "section 853(b)(1)(B): the electing company adds the covered taxes to the dividends paid deduction";
    when section_853_election_effective(c, y);
    when foreign_income_taxes_paid_by_ric_853a(c, y, taxes);
    when foreign_taxes_not_creditable_by_901k_or_l_853e(c, y, not_creditable);
    then addition_to_dividends_paid_deduction_853b1B(c, y, taxes - not_creditable);
}
pub relation shareholder_proportionate_share_of_foreign_taxes_853b2(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's proportionate share of the taxes paid to foreign countries and possessions";
}
pub relation amount_reported_in_statement_to_shareholder_853c(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of taxes reported by the company in a written statement furnished to the shareholder";
}
pub relation shareholder_foreign_tax_inclusion_853b2A(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount the shareholder includes in gross income and treats as paid: the proportionate share, not more than the amount reported";
}
@source(IRC_S853_C, quote = "shall not exceed the amounts so reported by the company in a written statement furnished to such shareholder")
rule Section853b2AShareholderInclusion(sh: Person, c: Person, y: TaxableYear, share: Money, reported: Money) strict {
    label en official "sections 853(b)(2)(A), (c): the shareholder includes and is treated as paying its proportionate share of the taxes, limited to the reported amount";
    when section_853_election_effective(c, y);
    when shareholder_proportionate_share_of_foreign_taxes_853b2(sh, c, y, share);
    when amount_reported_in_statement_to_shareholder_853c(sh, c, y, reported);
    then shareholder_foreign_tax_inclusion_853b2A(sh, c, y, min(share, reported));
}

// ---- Section 853A: tax credit bond pass-through ----

pub relation holds_tax_credit_bond_on_applicable_date_853Aa1(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company holds (directly or indirectly) one or more tax credit bonds on one or more applicable dates during the taxable year";
}
pub relation meets_852a_after_853A_853Aa2(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company meets the requirements of section 852(a) for the year, determined after the application of section 853A";
}
pub relation elects_tax_credit_bond_pass_through_853Aa(c: Person, y: TaxableYear, credits: Money) kind empirical {
    label en unofficial "the company elects the application of section 853A for the credits (amount) allowable for the year with respect to such bonds";
}
pub relation section_853A_election_effective(c: Person, y: TaxableYear, credits: Money) kind institutional {
    label en official "the election under section 853A(a) is in effect for the credits";
}
@source(IRC_S853A_A, quote = "may elect the application of this section with respect to some or all of the credits allowable")
rule Section853AaElectionPower(c: Person, y: TaxableYear, credits: Money) strict {
    label en official "section 853A(a): a company holding tax credit bonds and meeting section 852(a) may elect pass-through of the credits";
    when elects_tax_credit_bond_pass_through_853Aa(c, y, credits);
    then power RicTaxCreditBondElection {
        holder c;
        over c;
        exercise elects_tax_credit_bond_pass_through_853Aa(c, y, credits);
        valid_when tax_credit_bond_election_eligible_853Aa(c, y);
        effect create(section_853A_election_effective(c, y, credits));
        window [@2009-02-17, infinity);
    };
}
pub relation tax_credit_bond_election_eligible_853Aa(c: Person, y: TaxableYear) kind institutional {
    label en official "the company holds a tax credit bond on an applicable date and meets section 852(a) after section 853A";
}
rule Section853AaEligibility(c: Person, y: TaxableYear) strict {
    label en official "section 853A(a)(1)-(2): holding a tax credit bond and meeting section 852(a)";
    when holds_tax_credit_bond_on_applicable_date_853Aa1(c, y);
    when meets_852a_after_853A_853Aa2(c, y);
    then tax_credit_bond_election_eligible_853Aa(c, y);
}
pub relation credits_denied_to_ric_853Ab1A(c: Person, y: TaxableYear, credits: Money) kind institutional {
    label en official "the company is not allowed the credits";
}
pub relation credit_amount_included_in_ric_gross_income_as_interest_853Ab1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the company includes in gross income, as interest, the amount that would have been included without the election";
}
pub relation credit_amount_treated_as_ric_distribution_853Ab1D(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the company is treated as making distributions of money equal to the credits";
}
pub relation interest_that_would_have_been_included_853Ab1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount that would have been included in gross income with respect to the credits had section 853A not been elected";
}
@source(IRC_S853A_B, quote = "shall not be allowed such credits")
rule Section853Ab1CreditsDenied(c: Person, y: TaxableYear, credits: Money) strict {
    label en official "section 853A(b)(1)(A): the electing company is not allowed the credits";
    when section_853A_election_effective(c, y, credits);
    then credits_denied_to_ric_853Ab1A(c, y, credits);
}
@source(IRC_S853A_B, quote = "shall include in gross income (as interest) for such taxable year the amount which would have been so included with respect to such credits had the application of this section not been elected")
rule Section853Ab1BInterestInclusion(c: Person, y: TaxableYear, credits: Money, interest: Money) strict {
    label en official "section 853A(b)(1)(B),(C): the amount is gross income as interest and enters earnings and profits";
    when section_853A_election_effective(c, y, credits);
    when interest_that_would_have_been_included_853Ab1B(c, y, interest);
    then credit_amount_included_in_ric_gross_income_as_interest_853Ab1B(c, y, interest);
}
@source(IRC_S853A_B, quote = "shall be treated as making one or more distributions of money with respect to its stock equal to the amount of such credits")
rule Section853Ab1DDeemedDistribution(c: Person, y: TaxableYear, credits: Money) strict {
    label en official "section 853A(b)(1)(D): the company is treated as distributing money equal to the credits";
    when section_853A_election_effective(c, y, credits);
    then credit_amount_treated_as_ric_distribution_853Ab1D(c, y, credits);
}
pub relation shareholder_proportionate_share_of_credits_853Ab2(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's proportionate share of the distribution treated as made";
}
pub relation credit_amount_reported_to_shareholder_853Ac(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount reported by the company in a written statement furnished to the shareholder";
}
pub relation shareholder_credit_allowed_853Ab2B(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the credit allowed against the shareholder's tax: its proportionate share, not more than the reported amount";
}
@source(IRC_S853A_C, quote = "shall not exceed the amount so reported by the regulated investment company in a written statement furnished to such shareholder")
rule Section853Ab2ShareholderCredit(sh: Person, c: Person, y: TaxableYear, credits: Money, share: Money, reported: Money) strict {
    label en official "section 853A(b)(2),(c): the shareholder receives the distribution and a credit equal to it, not above the reported amount";
    when section_853A_election_effective(c, y, credits);
    when shareholder_proportionate_share_of_credits_853Ab2(sh, c, y, share);
    when credit_amount_reported_to_shareholder_853Ac(sh, c, y, reported);
    then shareholder_credit_allowed_853Ab2B(sh, c, y, min(share, reported));
}

// ---- Section 854: limitations on dividends ----

pub relation dividend_from_ric_received_854(sh: Person, c: Person, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the shareholder receives a dividend from the regulated investment company";
}
pub relation dividend_is_capital_gain_dividend_854a(dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is a capital gain dividend (section 852(b)(3))";
}
@source(IRC_S854_A, quote = "a capital gain dividend (as defined in section 852(b)(3)) received from a regulated investment company shall not be considered as a dividend")
pub relation capital_gain_dividend_not_a_dividend_for_1h11_and_243_854a(dividend: us.irc.core::Payment) kind institutional {
    label en official "a capital gain dividend is not a dividend for section 1(h)(11) and section 243";
}
rule Section854aCapitalGainDividendNotDividend(sh: Person, c: Person, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 854(a): a capital gain dividend of a RIC is not a dividend for the qualified dividend rate and the dividends received deduction";
    when dividend_from_ric_received_854(sh, c, dividend, amount);
    when dividend_is_capital_gain_dividend_854a(dividend);
    then capital_gain_dividend_not_a_dividend_for_1h11_and_243_854a(dividend);
}
pub relation ric_meets_852a_for_dividend_year_854b(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company meets the requirements of section 852(a) for the taxable year during which it paid the dividend";
}
pub relation portion_reported_as_eligible_for_243_854b1A(sh: Person, c: Person, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the portion of the dividend reported by the company as eligible for the section 243 deduction in written statements to shareholders";
}
pub relation dividend_portion_taken_into_account_for_243_854b1A(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "only the reported portion of the dividend is taken into account for the section 243 deduction";
}
@source(IRC_S854_B, quote = "there shall be taken into account only that portion of such dividend reported by the regulated investment company as eligible for such deduction in written statements furnished to its shareholders")
rule Section854b1AOnlyReportedPortionFor243(sh: Person, c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, reported: Money) strict {
    label en official "section 854(b)(1)(A): only the reported portion of a dividend counts for the dividends received deduction";
    when dividend_from_ric_received_854(sh, c, dividend, amount);
    when ric_meets_852a_for_dividend_year_854b(c, y);
    when portion_reported_as_eligible_for_243_854b1A(sh, c, dividend, reported);
    then dividend_portion_taken_into_account_for_243_854b1A(sh, dividend, min(amount, reported));
}
pub relation qualified_dividend_income_of_ric_854b1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified dividend income of the company for the taxable year (section 1(h)(11)(B))";
}
pub relation gross_income_of_ric_854b1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the company's gross income for the year, counting on sales of stock or securities only the excess of net short-term gain over net long-term loss (section 854(b)(1)(B)(ii))";
}
pub relation portion_reported_as_qualified_dividend_income_854b1B(sh: Person, c: Person, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the portion of the dividend reported by the company as qualified dividend income";
}
pub relation qualified_dividend_income_limited_to_reported_854b1B(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "when the company's qualified dividend income is under 95 percent of gross income, only the reported portion is qualified dividend income";
}
@source(IRC_S854_B, quote = "the qualified dividend income of such investment company for such taxable year is less than 95 percent of its gross income")
rule Section854b1BOnlyReportedPortionAsQdi(sh: Person, c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, reported: Money, qdi: Money, gross: Money) strict {
    label en official "section 854(b)(1)(B): below the 95 percent threshold, only the reported portion of a dividend is qualified dividend income";
    when dividend_from_ric_received_854(sh, c, dividend, amount);
    when ric_meets_852a_for_dividend_year_854b(c, y);
    when qualified_dividend_income_of_ric_854b1B(c, y, qdi);
    when gross_income_of_ric_854b1B(c, y, gross);
    when qdi * 100.0 < gross * 95.0;
    when portion_reported_as_qualified_dividend_income_854b1B(sh, c, dividend, reported);
    then qualified_dividend_income_limited_to_reported_854b1B(sh, dividend, min(amount, reported));
}
pub relation dividend_received_by_ric_854b2(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "a dividend received by the regulated investment company during the taxable year";
}
pub relation dividend_payer_is_domestic_corporation_854b2A(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend was received from a domestic corporation";
}
pub relation dividend_payer_exempt_or_reit_854b2B(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the payer is, for the year of the distribution or the preceding year, exempt under section 501 or 521, or is a REIT qualifying under part II of subchapter M";
}
pub relation qualifying_aggregate_dividend_item_854b2(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a dividend that counts in the aggregate dividends received: from a domestic corporation and not from an exempt organization or REIT";
}
@source(IRC_S854_B, quote = "In computing the amount of aggregate dividends received, there shall only be taken into account dividends received from domestic corporations.")
rule Section854b2AggregateDividendsDomesticOnly(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 854(b)(2)(A)-(B): only dividends from domestic corporations count, excluding exempt-organization and REIT distributions";
    when dividend_received_by_ric_854b2(c, y, item, amount);
    when dividend_payer_is_domestic_corporation_854b2A(item);
    when not_known(dividend_payer_exempt_or_reit_854b2B(item));
    when not_known(dividend_item_fails_deduction_test_854b3(item));
    then qualifying_aggregate_dividend_item_854b2(c, y, item, amount);
}
pub relation aggregate_dividends_received_854b2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate dividends received by the company for the taxable year (section 854(b)(2))";
}
rule Section854b2AggregateDividendsSum(c: Person, y: TaxableYear) strict {
    label en official "section 854(b)(2): the sum of the qualifying dividend items";
    when qualifying_aggregate_dividend_item_854b2(c, y, _, _);
    then aggregate_dividends_received_854b2(c, y, sum all amount: Money for item: us.irc.core::Payment where qualifying_aggregate_dividend_item_854b2(c, y, item, amount));
}
pub relation aggregate_reported_as_dividends_854b1C(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount reported by the company as eligible for the section 243 deduction";
}
pub relation reported_dividends_within_aggregate_received_854b1C(c: Person, y: TaxableYear) kind institutional {
    label en official "the aggregate amount reported as dividends does not exceed the aggregate dividends received (section 854(b)(1)(C)(i))";
}
@source(IRC_S854_B, quote = "The aggregate amount which may be reported as dividends under subparagraph (A) shall not exceed the aggregate dividends received by the company for the taxable year.")
rule Section854b1CiReportingCap(c: Person, y: TaxableYear, reported: Money, received: Money) strict {
    label en official "section 854(b)(1)(C)(i): reported dividends may not exceed the dividends received";
    when aggregate_reported_as_dividends_854b1C(c, y, reported);
    when aggregate_dividends_received_854b2(c, y, received);
    when reported <= received;
    then reported_dividends_within_aggregate_received_854b1C(c, y);
}
pub relation reporting_exceeds_dividends_received_854b1C(c: Person, y: TaxableYear) kind institutional {
    label en official "the company reports more dividends than it received: the excess reporting violates the cap";
}
rule Section854b1CiReportingExceedsCap(c: Person, y: TaxableYear, reported: Money, received: Money) strict {
    label en official "section 854(b)(1)(C)(i): reporting above the dividends received exceeds the cap";
    when aggregate_reported_as_dividends_854b1C(c, y, reported);
    when aggregate_dividends_received_854b2(c, y, received);
    when reported > received;
    then reporting_exceeds_dividends_received_854b1C(c, y);
}
pub relation aggregate_reported_as_qualified_dividend_income_854b1C(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount reported as qualified dividend income";
}
pub relation accumulated_earnings_distributed_from_non_part_i_year_854b1Cii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "earnings and profits distributed for the year that were accumulated in a taxable year to which part I did not apply";
}
pub relation reported_qdi_within_cap_854b1Cii(c: Person, y: TaxableYear) kind institutional {
    label en official "the aggregate reported qualified dividend income does not exceed the qualified dividend income plus the accumulated non-part-I earnings distributed";
}
@source(IRC_S854_B, quote = "The aggregate amount which may be reported as qualified dividend income under subparagraph (B) shall not exceed the sum of")
rule Section854b1CiiQdiReportingCap(c: Person, y: TaxableYear, reported: Money, qdi: Money, accumulated: Money) strict {
    label en official "section 854(b)(1)(C)(ii): reported qualified dividend income is capped";
    when aggregate_reported_as_qualified_dividend_income_854b1C(c, y, reported);
    when qualified_dividend_income_of_ric_854b1B(c, y, qdi);
    when accumulated_earnings_distributed_from_non_part_i_year_854b1Cii(c, y, accumulated);
    when reported <= qdi + accumulated;
    then reported_qdi_within_cap_854b1Cii(c, y);
}

// ---- Section 855: dividends declared after the close of the year ----

pub relation ric_dividend_declared_on_855a1(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, declared_on: Date) kind empirical {
    label en unofficial "the regulated investment company declares the dividend on this date";
}
pub relation ric_return_due_date_with_extension_855a1B(c: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the due date for filing the company's return for the year, taking into account an extension";
}
pub relation ric_dividend_distributed_on_855a2(c: Person, dividend: us.irc.core::Payment, distributed_on: Date) kind empirical {
    label en unofficial "the date the dividend amount was distributed to shareholders";
}
pub relation first_same_type_dividend_payment_after_declaration_855a2(c: Person, dividend: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date of the first dividend payment of the same type made after the declaration";
}
pub relation elects_in_return_to_treat_as_paid_in_year_855a(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the company elects in its return, in accordance with regulations, to treat the declared and distributed amount as paid during the taxable year";
}
pub relation declaration_timely_855a1(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the dividend was declared on or before the later of the 15th day of the 9th month after the year close and the extended return due date";
}
@source(IRC_S855_A, quote = "declares a dividend on or before the later of")
rule Section855a1DeclaredByNinthMonthDeadline(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, declared_on: Date, ends_on: Date) strict {
    label en official "section 855(a)(1)(A): declared on or before the 15th day of the 9th month after year close";
    when ric_dividend_declared_on_855a1(c, y, dividend, declared_on);
    when us.irc.core::ends(y, ends_on);
    when declared_on <= add_calendar_period(add_calendar_period(add_calendar_period(ends_on, 1 calendar_day), 8 calendar_month), 14 calendar_day);
    then declaration_timely_855a1(c, y, dividend);
}
rule Section855a1DeclaredByExtendedDueDate(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, declared_on: Date, due: Date) strict {
    label en official "section 855(a)(1)(B): declared on or before the extended return due date";
    when ric_dividend_declared_on_855a1(c, y, dividend, declared_on);
    when ric_return_due_date_with_extension_855a1B(c, y, due);
    when declared_on <= due;
    then declaration_timely_855a1(c, y, dividend);
}
pub relation distribution_timely_855a2(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the amount was distributed in the 12-month period after the close of the year and not later than the first same-type dividend payment after the declaration";
}
@source(IRC_S855_A, quote = "distributes the amount of such dividend to shareholders in the 12-month period following the close of such taxable year and not later than the date of the first dividend payment of the same type of dividend made after such declaration")
rule Section855a2DistributionWindow(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, ends_on: Date, distributed_on: Date, first_on: Date) strict {
    label en official "section 855(a)(2): distributed within 12 months of the year close and by the first same-type payment after declaration";
    when us.irc.core::ends(y, ends_on);
    when ric_dividend_distributed_on_855a2(c, dividend, distributed_on);
    when first_same_type_dividend_payment_after_declaration_855a2(c, dividend, first_on);
    when distributed_on > ends_on;
    when distributed_on < add_calendar_period(add_calendar_period(ends_on, 1 calendar_day), 12 calendar_month);
    when distributed_on <= first_on;
    then distribution_timely_855a2(c, y, dividend);
}
pub relation dividend_considered_paid_during_year_855a(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the declared and distributed amount is considered as paid during the taxable year, to the extent of the company's election";
}
@source(IRC_S855_A, quote = "the amount so declared and distributed shall, to the extent the company elects in such return in accordance with regulations prescribed by the Secretary, be considered as having been paid during such taxable year")
rule Section855aElectionPower(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) strict {
    label en official "section 855(a): the company may elect to treat a timely declared and distributed dividend as paid in the year";
    when elects_in_return_to_treat_as_paid_in_year_855a(c, y, dividend);
    then power RicPostYearDividendElection {
        holder c;
        over c;
        exercise elects_in_return_to_treat_as_paid_in_year_855a(c, y, dividend);
        valid_when post_year_dividend_qualifies_855a(c, y, dividend);
        effect create(dividend_considered_paid_during_year_855a(c, y, dividend));
        window [@1955-01-01, infinity);
    };
}
pub relation post_year_dividend_qualifies_855a(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the dividend was timely declared and timely distributed";
}
rule Section855aQualifies(c: Person, y: TaxableYear, dividend: us.irc.core::Payment) strict {
    label en official "section 855(a)(1)-(2): timely declaration and distribution";
    when declaration_timely_855a1(c, y, dividend);
    when distribution_timely_855a2(c, y, dividend);
    then post_year_dividend_qualifies_855a(c, y, dividend);
}
pub relation dividend_is_year_end_deemed_852b7(c: Person, dividend: us.irc.core::Payment) kind institutional {
    label en official "helper binding the open year argument: the dividend is a section 852(b)(7) year-end deemed dividend";
}
rule Section852b7HelperYearEndDeemed(c: Person, dividend: us.irc.core::Payment, calendar_year: Integer) strict {
    label en official "helper: some calendar year makes the dividend a section 852(b)(7) deemed dividend";
    when dividend_deemed_received_and_paid_on_december_31_852b7(c, dividend, calendar_year);
    then dividend_is_year_end_deemed_852b7(c, dividend);
}
pub relation shareholder_receipt_year_855b(c: Person, dividend: us.irc.core::Payment, distributed_on: Date) kind institutional {
    label en official "amounts to which subsection (a) applies are received by the shareholder in the taxable year in which the distribution is made";
}
@source(IRC_S855_B, quote = "amounts to which subsection (a) is applicable shall be treated as received by the shareholder in the taxable year in which the distribution is made")
rule Section855bShareholderReceivesOnDistribution(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, distributed_on: Date) defeasible {
    label en official "section 855(b): the shareholder receives the amount when distributed, except for section 852(b)(7) dividends";
    when dividend_considered_paid_during_year_855a(c, y, dividend);
    when ric_dividend_distributed_on_855a2(c, dividend, distributed_on);
    when not_known(dividend_is_year_end_deemed_852b7(c, dividend));
    then shareholder_receipt_year_855b(c, dividend, distributed_on);
}
