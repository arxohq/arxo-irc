// Sections 851-857 stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. Regulated investment companies and real estate investment trusts:
//   * 852(e)(1) second sentence and (e)(3)(A): the amount of the distribution
//     requirement when the determination rests only on the failure of
//     subsection (a)(2), the interest base (50 percent of the accumulated
//     earnings) and the interest period (from the last day for payment,
//     without extensions, to the determination date); the interest amount
//     itself (underpayment rate of section 6621 compounded daily, section
//     6622) is not computed here and stays an input (G5311);
//   * 852(f)(1) last sentences and (f)(2)(C): the excluded load charge is
//     added to the later acquisition, and a nonrecognition acquirer succeeds
//     to the transferor's load charge treatment;
//   * 852(g)(1)(B): a qualified fund of funds is eligible for section 853
//     without the (a)(1) asset test;
//   * 852(b)(8)(G): the section 4982(e)(4) election (a November year end
//     drops the (C) and (E) components; a December year end has no deferral);
//   * 852(c)(3) and 857(d)(3): first-in first-out allocation of a distribution
//     made to comply with the distribution requirement, by yearly layers of
//     earnings and profits;
//   * 852(b)(4)(C) and 857(b)(8)(B): the six-month holding period with the
//     ex-dividend cutoff (the days of diminished risk of loss stay an input);
//   * 854(b)(1)(B)(ii) gross income for the 95 percent test, 854(b)(3) the
//     dividends counted;
//   * 857(b)(3)(C)(v), (E), and (b)(7)(B)(ii)-(iv) exceptions.
// Sums over derived items follow G4903.

// ---- Section 852(e)(1) second sentence ----

use self::{
    IRC_S852_B,
    IRC_S852_C,
    IRC_S852_E,
    IRC_S852_F,
    IRC_S852_G,
    IRC_S854_B,
    IRC_S857_B,
    IRC_S857_D,
    Person,
    TaxableYear,
    aep_attributable_to_non_ric_year_852e2A,
    all_amounts_from_property_856d7B,
    dividend_received_by_ric_854b2,
    eligible_for_foreign_tax_election_853a,
    gross_income_of_ric_854b1B,
    load_charge_excluded_from_gain_or_loss_852f1,
    load_charge_incurred_852f1A,
    non_ric_year_determination_on_852e1,
    non_ric_year_treated_as_part_i_year_852e1,
    post_december_ordinary_loss_852b8F,
    qualified_fund_of_funds_852g2,
    qualified_late_year_loss_852b8B,
    redetermined_rents_857b7B,
    redetermined_rents_excepted_857b7B,
    redetermined_rents_taxable_857b7,
    reit_share_held_six_months_or_less_857b8,
    section_852a1_distribution_requirement_met,
    share_held_six_months_or_less_852b4,
};

pub relation determination_solely_from_failure_of_852a2_852e1(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the determination that part I did not apply rests solely on the failure to meet the requirements of subsection (a)(2)";
}
pub relation aep_which_resulted_in_failure_852e1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of the accumulated earnings and profits which resulted in the failure";
}
pub relation aep_for_distribution_requirement_852e2Ai(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount referred to in paragraph (2)(A)(i): the earnings attributable to the non-RIC year, or, after a failure of subsection (a)(2) alone, the portion which resulted in the failure";
}
@source(IRC_S852_E, quote = "for purposes of applying subsection (a)(2) to subsequent taxable years, the provisions of this part")
rule Section852e1AmountAfterFailureOfA2(c: Person, y: TaxableYear, failure: Money) strict {
    label en official "section 852(e)(1): after a determination resting solely on subsection (a)(2), the amount is the portion of accumulated earnings which resulted in the failure";
    when determination_solely_from_failure_of_852a2_852e1(c, y);
    when aep_which_resulted_in_failure_852e1(c, y, failure);
    then aep_for_distribution_requirement_852e2Ai(c, y, failure);
}
rule Section852e1AmountOrdinary(c: Person, y: TaxableYear, aep: Money) strict {
    label en official "section 852(e)(2)(A)(i): otherwise the portion of the accumulated earnings attributable to the non-RIC year";
    when aep_attributable_to_non_ric_year_852e2A(c, y, aep);
    when not_known(determination_solely_from_failure_of_852a2_852e1(c, y));
    then aep_for_distribution_requirement_852e2Ai(c, y, aep);
}
pub relation non_ric_year_treated_as_part_i_year_for_852a2_of_that_year_852e1(c: Person, y: TaxableYear) kind institutional {
    label en official "the deemed application of part I also applies for applying subsection (a)(2) to the non-RIC year itself";
}
rule Section852e1DeemedForTheNonRicYearItself(c: Person, y: TaxableYear) defeasible {
    label en official "section 852(e)(1): where the determination rests solely on the failure of subsection (a)(2), the deemed application reaches the non-RIC year";
    when non_ric_year_treated_as_part_i_year_852e1(c, y);
    when determination_solely_from_failure_of_852a2_852e1(c, y);
    then non_ric_year_treated_as_part_i_year_for_852a2_of_that_year_852e1(c, y);
}

// ---- Section 852(e)(3)(A): the interest base and period ----

pub relation payment_due_date_without_extensions_852e3Aii(c: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the last day prescribed for payment of the tax imposed for the non-RIC year, determined without regard to extensions";
}
pub relation interest_at_underpayment_rate_applies_852e3A(c: Person, y: TaxableYear) kind institutional {
    label en official "the company pays interest at the underpayment rate of section 6621 for the non-RIC year";
}
@source(IRC_S852_E, quote = "If paragraph (1) applies to any non-RIC year of an investment company, such investment company shall pay")
rule Section852e3AInterestApplies(c: Person, y: TaxableYear, determined_on: Date) strict {
    label en official "section 852(e)(3)(A): a determination for a non-RIC year makes the company liable for interest at the underpayment rate";
    when non_ric_year_determination_on_852e1(c, y, determined_on);
    then interest_at_underpayment_rate_applies_852e3A(c, y);
}
pub relation interest_base_852e3Ai(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount on which interest runs: 50 percent of the amount referred to in paragraph (2)(A)(i)";
}
@source(IRC_S852_E, quote = "(i) on an amount equal to 50 percent of the amount referred to in paragraph (2)(A)(i),")
rule Section852e3AiInterestBase(c: Person, y: TaxableYear, aep: Money) strict {
    label en official "section 852(e)(3)(A)(i): 50 percent of the paragraph (2)(A)(i) amount (cents HALF_UP)";
    when aep_for_distribution_requirement_852e2Ai(c, y, aep);
    then interest_base_852e3Ai(c, y, round(aep * 0.50, 2, "HALF_UP"));
}
pub relation interest_period_852e3Aii(c: Person, y: TaxableYear, starts_on: Date, ends_on: Date) kind institutional {
    label en official "the interest period: from the last day prescribed for payment (without extensions) to the date the determination is made";
}
@source(IRC_S852_E, quote = "(ii) for the period—")
rule Section852e3AiiInterestPeriod(c: Person, y: TaxableYear, due: Date, determined_on: Date) strict {
    label en official "section 852(e)(3)(A)(ii)(I)-(II): the period begins on the last day for payment (without extensions) and ends on the determination date";
    when payment_due_date_without_extensions_852e3Aii(c, y, due);
    when non_ric_year_determination_on_852e1(c, y, determined_on);
    when determined_on >= due;
    then interest_period_852e3Aii(c, y, due, determined_on);
}

// ---- Section 852(f): load charges ----

pub relation later_stock_acquired_852f1C(sh: Person, stock: us.irc.core::Asset, later: us.irc.core::Asset) kind empirical {
    label en unofficial "the stock of a regulated investment company acquired within the period of subparagraph (C), by reason of which the load charge is reduced";
}
pub relation load_charge_added_to_later_acquisition_852f1(sh: Person, later: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the excluded load charge is treated as incurred in connection with the later acquisition (including for reapplying the paragraph)";
}
@source(IRC_S852_F, quote = "the load charge referred to in subparagraph (A) (to the extent it does not exceed the reduction referred")
rule Section852f1ExcludedChargeMovesToLaterAcquisition(sh: Person, stock: us.irc.core::Asset, later: us.irc.core::Asset, amount: Money) strict {
    label en official "section 852(f)(1) last sentence: the charge not taken into account is treated as incurred in connection with the later acquisition";
    when load_charge_excluded_from_gain_or_loss_852f1(sh, stock, amount);
    when later_stock_acquired_852f1C(sh, stock, later);
    then load_charge_added_to_later_acquisition_852f1(sh, later, amount);
}
pub relation stock_acquired_from_transferor_852f2C(taxpayer: Person, stock: us.irc.core::Asset, transferor: Person) kind empirical {
    label en unofficial "the taxpayer acquires stock in a regulated investment company from another person";
}
pub relation gain_or_loss_not_recognized_on_acquisition_852f2C(taxpayer: Person, stock: us.irc.core::Asset) kind empirical {
    label en unofficial "the acquisition is a transaction in which gain or loss is not recognized";
}
pub relation succeeds_to_transferors_load_charge_852f2C(taxpayer: Person, stock: us.irc.core::Asset, transferor: Person, amount: Money) kind institutional {
    label en official "the taxpayer succeeds to the transferor's treatment under subsection (f): the transferor's load charge on the stock is the taxpayer's";
}
@source(IRC_S852_F, quote = "If the taxpayer acquires stock in a regulated investment company from another person in a transaction in")
rule Section852f2CSuccessionToTransferor(taxpayer: Person, stock: us.irc.core::Asset, transferor: Person, amount: Money) strict {
    label en official "section 852(f)(2)(C): in a nonrecognition acquisition the taxpayer succeeds to the other person's treatment";
    when stock_acquired_from_transferor_852f2C(taxpayer, stock, transferor);
    when gain_or_loss_not_recognized_on_acquisition_852f2C(taxpayer, stock);
    when load_charge_incurred_852f1A(transferor, stock, amount);
    then succeeds_to_transferors_load_charge_852f2C(taxpayer, stock, transferor, amount);
}

// ---- Section 852(g)(1): funds of funds ----

@source(IRC_S852_G, quote = "(B) such fund may elect the application of section 853 (relating to foreign tax credit allowed to")
rule Section852g1BFundOfFundsMayElect853(c: Person, y: TaxableYear) strict {
    label en official "section 852(g)(1)(B): a qualified fund of funds may elect section 853 without the (a)(1) foreign asset requirement (section 852(a) is still required)";
    when qualified_fund_of_funds_852g2(c, y);
    when section_852a1_distribution_requirement_met(c, y);
    then eligible_for_foreign_tax_election_853a(c, y);
}
pub relation fund_of_funds_special_rules_apply_852g1(c: Person, y: TaxableYear) kind institutional {
    label en official "the special rules of subsection (g)(1) apply to the company (chapeau)";
}
@source(IRC_S852_G, quote = "In the case of a qualified fund of funds—")
rule Section852g1FundOfFundsChapeau(c: Person, y: TaxableYear) strict {
    label en official "section 852(g)(1): in the case of a qualified fund of funds";
    when qualified_fund_of_funds_852g2(c, y);
    then fund_of_funds_special_rules_apply_852g1(c, y);
}

// ---- Section 852(b)(8)(G): the section 4982(e)(4) election ----

pub relation elects_4982e4_852b8G(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company has an election under section 4982(e)(4) in effect";
}
pub relation taxable_year_ends_in_november_852b8G(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company's taxable year ends with the month of November";
}
pub relation taxable_year_ends_in_december_852b8G(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company's taxable year ends with the month of December";
}
pub relation november_year_electing_company_852b8Gi(c: Person, y: TaxableYear) kind institutional {
    label en official "an electing company whose taxable year ends in November";
}
@source(IRC_S852_B, quote = "(i) if such company's taxable year ends with the month of November, the amount of qualified late-year")
rule Section852b8GiNovemberElectingCompany(c: Person, y: TaxableYear) strict {
    label en official "section 852(b)(8)(G)(i): the election with a November year end";
    when elects_4982e4_852b8G(c, y);
    when taxable_year_ends_in_november_852b8G(c, y);
    then november_year_electing_company_852b8Gi(c, y);
}
rule Section852b8GiQualifiedLateYearLossWithoutCAndE(c: Person, y: TaxableYear, december_ordinary: Money) strict {
    label en official "section 852(b)(8)(G)(i): the qualified late-year loss is computed without regard to the items of subparagraphs (C) and (E): only the post-December ordinary loss remains";
    when november_year_electing_company_852b8Gi(c, y);
    when post_december_ordinary_loss_852b8F(c, y, december_ordinary);
    then qualified_late_year_loss_852b8B(c, y, december_ordinary);
}
pub relation election_to_defer_unavailable_852b8Gii(c: Person, y: TaxableYear) kind institutional {
    label en official "subparagraph (A) does not apply: an electing company with a December year end cannot defer a late-year loss";
}
@source(IRC_S852_B, quote = "(ii) if such company's taxable year ends with the month of December, subparagraph (A) shall not apply.")
rule Section852b8GiiDecemberYearNoDeferral(c: Person, y: TaxableYear) strict {
    label en official "section 852(b)(8)(G)(ii): with a December year end subparagraph (A) does not apply";
    when elects_4982e4_852b8G(c, y);
    when taxable_year_ends_in_december_852b8G(c, y);
    then election_to_defer_unavailable_852b8Gii(c, y);
}
@source(IRC_S852_B, quote = "In the case of a company to which an election under section 4982(e)(4) applies—")
pub relation section_4982e4_election_special_rules_apply_852b8G(c: Person, y: TaxableYear) kind institutional {
    label en official "the special rules of subparagraph (G) apply (chapeau)";
}
rule Section852b8GChapeau(c: Person, y: TaxableYear) strict {
    label en official "section 852(b)(8)(G): in the case of a company to which an election under section 4982(e)(4) applies";
    when elects_4982e4_852b8G(c, y);
    then section_4982e4_election_special_rules_apply_852b8G(c, y);
}

// ---- Section 854(b)(1)(B)(ii), (b)(3) ----

pub relation gross_income_other_than_stock_sales_854b1Bii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the company's gross income other than on sales or other dispositions of stock or securities";
}
pub relation net_short_term_gain_from_stock_sales_854b1BiiI(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net short-term capital gain from sales or other dispositions of stock or securities";
}
pub relation net_long_term_loss_from_stock_sales_854b1BiiII(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net long-term capital loss from sales or other dispositions of stock or securities";
}
@source(IRC_S854_B, quote = "For purposes of clause (i), in the case of 1 or more sales or other dispositions of stock or securities,")
rule Section854b1BiiGrossIncomeWithSales(c: Person, y: TaxableYear, other: Money, short_gain: Money, long_loss: Money) strict {
    label en official "section 854(b)(1)(B)(ii): gross income counts on sales of stock or securities only the excess of the net short-term gain over the net long-term loss";
    when gross_income_other_than_stock_sales_854b1Bii(c, y, other);
    when net_short_term_gain_from_stock_sales_854b1BiiI(c, y, short_gain);
    when net_long_term_loss_from_stock_sales_854b1BiiII(c, y, long_loss);
    then gross_income_of_ric_854b1B(c, y, other + max(0.00 USD, short_gain - long_loss));
}
// WIRE-6 (26.09.2026): the three tests of section 854(b)(3) READ the owner (`us.irc.deductions`, payment-keyed views of
// sections 243, 246 and 246A) with the regulated investment company as the explicit, hypothetical recipient `c` ("as if
// section 243 applied to dividends received by a regulated investment company"). The three case-input relations that
// used to carry the conclusions of (A)-(C) are removed; the case states the premises of sections 243-246A for the
// company as recipient plus `us.irc.deductions::dividend_item_index_of_payment` (the identity of the dividend Payment
// with the per-dividend index of the owner). Without that link nothing is derived, as before without the three facts.
pub relation dividend_item_fails_deduction_test_854b3(item: us.irc.core::Payment) kind institutional {
    label en official "no section 243 deduction would have been allowable to the company for the dividend, determined under (A)-(C)";
}
@source(IRC_S854_B, quote = "(A) as if section 243 applied to dividends received by a regulated investment company,")
rule Section854b3AIneligible(item: us.irc.core::Payment, c: Person, y: TaxableYear) strict {
    label en official "section 854(b)(3)(A): section 243 is applied to the company's dividends as if it applied";
    when dividend_received_by_ric_854b2(c, y, item, _);
    when us.irc.deductions::payment_dividend_not_eligible_for_243(c, y, item);
    then dividend_item_fails_deduction_test_854b3(item);
}
@source(IRC_S854_B, quote = "(B) after the application of section 246 (but without regard to subsection (b) thereof), and")
rule Section854b3BDisallowedBy246(item: us.irc.core::Payment, c: Person, y: TaxableYear) strict {
    label en official "section 854(b)(3)(B): after section 246, without regard to its subsection (b)";
    when dividend_received_by_ric_854b2(c, y, item, _);
    when us.irc.deductions::payment_dividend_denied_by_246_without_246b(c, y, item);
    then dividend_item_fails_deduction_test_854b3(item);
}
@source(IRC_S854_B, quote = "(C) after the application of section 246A.")
rule Section854b3CDisallowedBy246A(item: us.irc.core::Payment, c: Person, y: TaxableYear) strict {
    label en official "section 854(b)(3)(C): after section 246A";
    when dividend_received_by_ric_854b2(c, y, item, _);
    when us.irc.deductions::payment_dividend_denied_by_246A(c, y, item);
    then dividend_item_fails_deduction_test_854b3(item);
}

// ---- Section 857(b)(3)(C)(v), (E) ----

pub relation reit_earnings_and_profits_before_adjustment_857b3Cv(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the trust's earnings and profits before the adjustments of clause (v)";
}
pub relation earnings_and_profits_adjustment_by_regulations_857b3Cv(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjustment of earnings and profits prescribed by the Secretary's regulations";
}
pub relation reit_earnings_and_profits_adjusted_857b3Cv(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the trust's earnings and profits after the adjustment";
}
@source(IRC_S857_B, quote = "(v) The earnings and profits of such real estate investment trust, and the earnings and profits of any")
rule Section857b3CvAdjustedEarnings(t: Person, y: TaxableYear, before: Money, adjustment: Money) strict {
    label en official "section 857(b)(3)(C)(v): earnings and profits appropriately adjusted in accordance with regulations";
    when reit_earnings_and_profits_before_adjustment_857b3Cv(t, y, before);
    when earnings_and_profits_adjustment_by_regulations_857b3Cv(t, y, adjustment);
    then reit_earnings_and_profits_adjusted_857b3Cv(t, y, before + adjustment);
}
pub relation shareholder_corporation_earnings_and_profits_before_857b3Cv(sh: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits of a corporate shareholder before the adjustment";
}
pub relation shareholder_earnings_and_profits_adjustment_857b3Cv(sh: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjustment prescribed by regulations for the corporate shareholder";
}
pub relation shareholder_earnings_and_profits_adjusted_857b3Cv(sh: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the corporate shareholder's earnings and profits after the adjustment";
}
rule Section857b3CvShareholderAdjustedEarnings(sh: Person, y: TaxableYear, before: Money, adjustment: Money) strict {
    label en official "section 857(b)(3)(C)(v): the shareholder's earnings and profits are adjusted likewise";
    when shareholder_corporation_earnings_and_profits_before_857b3Cv(sh, y, before);
    when shareholder_earnings_and_profits_adjustment_857b3Cv(sh, y, adjustment);
    then shareholder_earnings_and_profits_adjusted_857b3Cv(sh, y, before + adjustment);
}
pub relation shareholder_not_subject_to_897_857b3E(sh: Person) kind empirical {
    label en unofficial "section 897 does not apply to the shareholder by reason of the second sentence of section 897(h)(1) or subparagraph (A)(ii) or (C) of section 897(k)(2)";
}
pub relation amount_that_would_be_long_term_gain_857b3E(sh: Person, t: Person, amount: Money) kind empirical {
    label en unofficial "the amount that would be included in computing the shareholder's long-term capital gains under subparagraph (A) or (C), without regard to subparagraph (E)";
}
pub relation amount_excluded_from_long_term_gains_857b3Ei(sh: Person, t: Person, amount: Money) kind institutional {
    label en official "the amount is not included in computing the shareholder's long-term capital gains";
}
@source(IRC_S857_B, quote = "(i) shall not be included in computing such shareholder's long-term capital gains, and")
rule Section857b3EiNotLongTermGain(sh: Person, t: Person, amount: Money) strict {
    label en official "section 857(b)(3)(E)(i): the amount is not long-term capital gain of the shareholder";
    when shareholder_not_subject_to_897_857b3E(sh);
    when amount_that_would_be_long_term_gain_857b3E(sh, t, amount);
    then amount_excluded_from_long_term_gains_857b3Ei(sh, t, amount);
}
pub relation amount_included_as_reit_dividend_857b3Eii(sh: Person, t: Person, amount: Money) kind institutional {
    label en official "the amount is included in the shareholder's gross income as a dividend from the trust";
}
@source(IRC_S857_B, quote = "(ii) shall be included in such shareholder's gross income as a dividend from the real estate investment")
rule Section857b3EiiIncludedAsDividend(sh: Person, t: Person, amount: Money) strict {
    label en official "section 857(b)(3)(E)(ii): the amount is a dividend from the real estate investment trust";
    when shareholder_not_subject_to_897_857b3E(sh);
    when amount_that_would_be_long_term_gain_857b3E(sh, t, amount);
    then amount_included_as_reit_dividend_857b3Eii(sh, t, amount);
}
@source(IRC_S857_B, quote = "In the case of a shareholder of a real estate investment trust to whom section 897 does not apply by")
pub relation shareholder_outside_897_special_rule_applies_857b3E(sh: Person, t: Person) kind institutional {
    label en official "the special rule of subparagraph (E) applies to the shareholder (chapeau)";
}
rule Section857b3EChapeau(sh: Person, t: Person, amount: Money) strict {
    label en official "section 857(b)(3)(E): a shareholder to whom section 897 does not apply";
    when shareholder_not_subject_to_897_857b3E(sh);
    when amount_that_would_be_long_term_gain_857b3E(sh, t, amount);
    then shareholder_outside_897_special_rule_applies_857b3E(sh, t);
}

// ---- Section 857(b)(7)(B)(ii)-(iv): the exceptions to redetermined rents ----

pub relation impermissible_service_amounts_for_property_857b7Bii(t: Person, y: TaxableYear, p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amounts described in section 856(d)(7)(A) with respect to the property";
}
pub relation one_percent_threshold_exception_857b7Bii(t: Person, y: TaxableYear, p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the part of the section 856(d)(7)(A) amounts within the one percent threshold of section 856(d)(7)(B) for the property";
}
@source(IRC_S857_B, quote = "Clause (i) shall not apply to amounts described in section 856(d)(7)(A) with respect to a property to")
rule Section857b7BiiOnePercentException(t: Person, y: TaxableYear, p: us.irc.core::Asset, amount: Money, total: Money) strict {
    label en official "section 857(b)(7)(B)(ii): clause (i) does not apply to the section 856(d)(7)(A) amounts up to the one percent threshold (cents HALF_UP)";
    when impermissible_service_amounts_for_property_857b7Bii(t, y, p, amount);
    when all_amounts_from_property_856d7B(t, y, p, total);
    then one_percent_threshold_exception_857b7Bii(t, y, p, min(amount, round(total * 0.01, 2, "HALF_UP")));
}
pub relation exception_from_properties_857b7Bii(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the one percent exceptions over the properties";
}
rule Section857b7BiiTotalOverProperties(t: Person, y: TaxableYear) strict {
    label en official "section 857(b)(7)(B)(ii): the sum over properties";
    when one_percent_threshold_exception_857b7Bii(t, y, _, _);
    then exception_from_properties_857b7Bii(t, y, sum all amount: Money for p: us.irc.core::Asset where one_percent_threshold_exception_857b7Bii(t, y, p, amount));
}
pub relation service_by_trs_to_tenant_857b7Biii(t: Person, y: TaxableYear, service: us.irc.core::Payment, charge: Money) kind empirical {
    label en unofficial "a service rendered by a taxable REIT subsidiary of the trust to a tenant of the trust, with the charge for it";
}
pub relation trs_renders_significant_similar_services_to_unrelated_857b7BiiiI(service: us.irc.core::Payment) kind empirical {
    label en unofficial "the subsidiary renders a significant amount of similar services to persons other than the trust and tenants of the trust who are unrelated (section 856(d)(8)(F)) to the subsidiary, trust and tenants";
}
pub relation comparable_charge_for_similar_services_857b7BiiiII(service: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the charge for the similar services rendered to those persons (the substantially comparable part of the charge)";
}
pub relation share_of_net_leasable_space_of_tenants_without_the_service_857b7BivI(service: us.irc.core::Payment, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the net leasable space of the trust's property leased by tenants not receiving the service from the subsidiary";
}
pub relation rents_of_non_receiving_tenants_substantially_comparable_857b7BivI(service: us.irc.core::Payment) kind empirical {
    label en unofficial "the rents paid by those tenants are substantially comparable to the rents paid by tenants leasing comparable space who receive the service";
}
pub relation charge_for_service_separately_stated_857b7BivII(service: us.irc.core::Payment) kind empirical {
    label en unofficial "the charge for the service from the subsidiary is separately stated";
}
pub relation service_meets_clause_iv_857b7B(service: us.irc.core::Payment) kind institutional {
    label en official "the service meets subclauses (I) and (II) of clause (iv)";
}
@source(IRC_S857_B, quote = "Clause (i) shall not apply to any service rendered by a taxable REIT subsidiary of a real estate")
rule Section857b7BivServiceMeetsClauseIv(service: us.irc.core::Payment, pct: Decimal) strict {
    label en official "section 857(b)(7)(B)(iv): tenants without the service lease at least 25 percent of the net leasable space at comparable rents, and the charge is separately stated";
    when share_of_net_leasable_space_of_tenants_without_the_service_857b7BivI(service, pct);
    when pct >= 25.0;
    when rents_of_non_receiving_tenants_substantially_comparable_857b7BivI(service);
    when charge_for_service_separately_stated_857b7BivII(service);
    then service_meets_clause_iv_857b7B(service);
}
pub relation service_exception_857b7B(t: Person, y: TaxableYear, service: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the charge for the service excepted from clause (i)";
}
@source(IRC_S857_B, quote = "(I) the rents paid to the trust by tenants (leasing at least 25 percent of the net leasable space in the")
rule Section857b7BivWholeCharge(t: Person, y: TaxableYear, service: us.irc.core::Payment, charge: Money) strict {
    label en official "section 857(b)(7)(B)(iv): the whole charge for the service is excepted";
    when service_by_trs_to_tenant_857b7Biii(t, y, service, charge);
    when service_meets_clause_iv_857b7B(service);
    then service_exception_857b7B(t, y, service, charge);
}
@source(IRC_S857_B, quote = "Clause (i) shall not apply to any service rendered by a taxable REIT subsidiary of a real estate")
rule Section857b7BiiiComparablePart(t: Person, y: TaxableYear, service: us.irc.core::Payment, charge: Money, comparable: Money) strict {
    label en official "section 857(b)(7)(B)(iii): a service rendered by the subsidiary is excepted only to the extent the charge is substantially comparable to the charge for similar services to unrelated persons, when a significant amount of such services is rendered";
    when service_by_trs_to_tenant_857b7Biii(t, y, service, charge);
    when trs_renders_significant_similar_services_to_unrelated_857b7BiiiI(service);
    when comparable_charge_for_similar_services_857b7BiiiII(service, comparable);
    when not_known(service_meets_clause_iv_857b7B(service));
    then service_exception_857b7B(t, y, service, min(charge, comparable));
}
@source(IRC_S857_B, quote = "(I) such subsidiary renders a significant amount of similar services to persons other than such trust")
pub relation clause_iii_significant_similar_services_857b7BiiiI(t: Person, y: TaxableYear, service: us.irc.core::Payment) kind institutional {
    label en official "subclause (I): the subsidiary renders a significant amount of similar services to others";
}
rule Section857b7BiiiIRecorded(t: Person, y: TaxableYear, service: us.irc.core::Payment, charge: Money) strict {
    label en official "section 857(b)(7)(B)(iii)(I)";
    when service_by_trs_to_tenant_857b7Biii(t, y, service, charge);
    when trs_renders_significant_similar_services_to_unrelated_857b7BiiiI(service);
    then clause_iii_significant_similar_services_857b7BiiiI(t, y, service);
}
pub relation exception_from_services_857b7Biii_iv(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the service exceptions";
}
rule Section857b7BiiiIvTotalOverServices(t: Person, y: TaxableYear) strict {
    label en official "section 857(b)(7)(B)(iii)-(iv): the sum over services";
    when service_exception_857b7B(t, y, _, _);
    then exception_from_services_857b7Biii_iv(t, y, sum all amount: Money for service: us.irc.core::Payment where service_exception_857b7B(t, y, service, amount));
}
pub relation rents_exception_present_857b7B(t: Person, y: TaxableYear) kind institutional {
    label en official "some derived exception to clause (i) is present (helper)";
}
rule Section857b7BHelperPropertiesPresent(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when exception_from_properties_857b7Bii(t, y, amount);
    then rents_exception_present_857b7B(t, y);
}
rule Section857b7BHelperServicesPresent(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when exception_from_services_857b7Biii_iv(t, y, amount);
    then rents_exception_present_857b7B(t, y);
}
pub relation properties_exception_present_857b7B(t: Person, y: TaxableYear) kind institutional {
    label en official "a one percent exception is present (helper)";
}
rule Section857b7BHelperProperties(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when exception_from_properties_857b7Bii(t, y, amount);
    then properties_exception_present_857b7B(t, y);
}
pub relation services_exception_present_857b7B(t: Person, y: TaxableYear) kind institutional {
    label en official "a service exception is present (helper)";
}
rule Section857b7BHelperServices(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when exception_from_services_857b7Biii_iv(t, y, amount);
    then services_exception_present_857b7B(t, y);
}
rule Section857b7BTaxableRentsAfterBothExceptions(t: Person, y: TaxableYear, rents: Money, properties: Money, services: Money) strict {
    label en official "section 857(b)(7)(B): the redetermined rents less the one percent and service exceptions";
    when redetermined_rents_857b7B(t, y, rents);
    when exception_from_properties_857b7Bii(t, y, properties);
    when exception_from_services_857b7Biii_iv(t, y, services);
    when not_known(redetermined_rents_excepted_857b7B(t, y));
    then redetermined_rents_taxable_857b7(t, y, max(0.00 USD, rents - (properties + services)));
}
rule Section857b7BTaxableRentsAfterPropertiesException(t: Person, y: TaxableYear, rents: Money, properties: Money) strict {
    label en official "section 857(b)(7)(B)(ii): the redetermined rents less the one percent exception";
    when redetermined_rents_857b7B(t, y, rents);
    when exception_from_properties_857b7Bii(t, y, properties);
    when not_known(services_exception_present_857b7B(t, y));
    when not_known(redetermined_rents_excepted_857b7B(t, y));
    then redetermined_rents_taxable_857b7(t, y, max(0.00 USD, rents - properties));
}
rule Section857b7BTaxableRentsAfterServicesException(t: Person, y: TaxableYear, rents: Money, services: Money) strict {
    label en official "section 857(b)(7)(B)(iii)-(iv): the redetermined rents less the service exceptions";
    when redetermined_rents_857b7B(t, y, rents);
    when exception_from_services_857b7Biii_iv(t, y, services);
    when not_known(properties_exception_present_857b7B(t, y));
    when not_known(redetermined_rents_excepted_857b7B(t, y));
    then redetermined_rents_taxable_857b7(t, y, max(0.00 USD, rents - services));
}

// ---- Section 852(c): a distribution made to comply with the distribution requirement (first in, first out) ----

pub relation distribution_to_comply_with_852a2B_852c3(c: Person, dist: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "a distribution made in order to comply with the requirements of subsection (a)(2)(B)";
}
pub relation accumulated_earnings_of_year_852c3(c: Person, ly: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits of the taxable year that would, but for the distribution, result in a failure to meet the requirements (a year's layer, ordered by the beginning of the year)";
}
pub relation earlier_layer_amount_852c3(c: Person, ly: TaxableYear, other: TaxableYear, amount: Money) kind institutional {
    label en official "an earlier layer of earnings and profits and its amount (helper for the first-in first-out order)";
}
rule Section852c3EarlierLayer(c: Person, ly: TaxableYear, other: TaxableYear, own: Money, amount: Money, b1: Date, b2: Date) strict {
    label en official "helper: the layers that begin before this layer";
    when accumulated_earnings_of_year_852c3(c, ly, own);
    when accumulated_earnings_of_year_852c3(c, other, amount);
    when us.irc.core::begins(ly, b1);
    when us.irc.core::begins(other, b2);
    when b2 < b1;
    then earlier_layer_amount_852c3(c, ly, other, amount);
}
pub relation has_earlier_layer_852c3(c: Person, ly: TaxableYear) kind institutional {
    label en official "some earlier layer exists (helper)";
}
rule Section852c3HasEarlierLayer(c: Person, ly: TaxableYear, other: TaxableYear, amount: Money) strict {
    label en official "helper";
    when earlier_layer_amount_852c3(c, ly, other, amount);
    then has_earlier_layer_852c3(c, ly);
}
pub relation earlier_layers_total_852c3(c: Person, ly: TaxableYear, total: Money) kind institutional {
    label en official "the total of the earlier layers";
}
rule Section852c3EarlierTotal(c: Person, ly: TaxableYear) strict {
    label en official "the sum of the layers that begin earlier (sums over derived items: G4903)";
    when earlier_layer_amount_852c3(c, ly, _, _);
    then earlier_layers_total_852c3(c, ly, sum all amount: Money for other: TaxableYear where earlier_layer_amount_852c3(c, ly, other, amount));
}
rule Section852c3NoEarlierTotal(c: Person, ly: TaxableYear, own: Money) strict {
    label en official "the oldest layer has no earlier layers";
    when accumulated_earnings_of_year_852c3(c, ly, own);
    when not_known(has_earlier_layer_852c3(c, ly));
    then earlier_layers_total_852c3(c, ly, 0.00 USD);
}
pub relation distribution_allocated_to_layer_852c3(c: Person, dist: us.irc.core::Payment, ly: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the distribution treated as made from the layer, oldest layer first";
}
@source(IRC_S852_C, quote = "(A) shall be treated for purposes of this subsection and subsection (a)(2)(B) as made from earnings and")
rule Section852c3AllocateToLayer(c: Person, dist: us.irc.core::Payment, ly: TaxableYear, distribution: Money, layer: Money, earlier: Money) strict {
    label en official "Section 852(c)(3)(A): the distribution is treated as made from the earnings that would cause the failure, allocated first in, first out (cents exact)";
    when distribution_to_comply_with_852a2B_852c3(c, dist, distribution);
    when accumulated_earnings_of_year_852c3(c, ly, layer);
    when earlier_layers_total_852c3(c, ly, earlier);
    then distribution_allocated_to_layer_852c3(c, dist, ly, min(layer, max(0.00 USD, distribution - earlier)));
}
pub relation distribution_treated_as_from_accumulated_earnings_852c3(c: Person, dist: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the distribution treated as made from accumulated earnings and profits";
}
@source(IRC_S852_C, quote = "(A) shall be treated for purposes of this subsection and subsection (a)(2)(B) as made from earnings and")
rule Section852c3TotalFromAccumulatedEarnings(c: Person, dist: us.irc.core::Payment) strict {
    label en official "Section 852(c)(3): the total of the layer allocations";
    when distribution_allocated_to_layer_852c3(c, dist, _, _);
    then distribution_treated_as_from_accumulated_earnings_852c3(c, dist, sum all amount: Money for ly: TaxableYear where distribution_allocated_to_layer_852c3(c, dist, ly, amount));
}
pub relation distribution_not_a_distribution_for_852b2D_855(c: Person, dist: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "to the extent treated as made from accumulated earnings and profits, not treated as a distribution for subsection (b)(2)(D) and section 855";
}
@source(IRC_S852_C, quote = "(B) to the extent treated under subparagraph (A) as made from accumulated earnings and profits, shall")
rule Section852c3NotADistribution(c: Person, dist: us.irc.core::Payment, amount: Money) strict {
    label en official "Section 852(c)(3)(B): the accumulated-earnings part is not a distribution for subsection (b)(2)(D) and section 855";
    when distribution_treated_as_from_accumulated_earnings_852c3(c, dist, amount);
    then distribution_not_a_distribution_for_852b2D_855(c, dist, amount);
}

// ---- Section 857(d): a distribution made to comply with the distribution requirement (first in, first out) ----

pub relation distribution_to_comply_with_857a2B_857d3(c: Person, dist: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "a distribution made in order to comply with the requirements of subsection (a)(2)(B)";
}
pub relation accumulated_earnings_of_year_857d3(c: Person, ly: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits of the taxable year that would, but for the distribution, result in a failure to meet the requirements (a year's layer, ordered by the beginning of the year)";
}
pub relation earlier_layer_amount_857d3(c: Person, ly: TaxableYear, other: TaxableYear, amount: Money) kind institutional {
    label en official "an earlier layer of earnings and profits and its amount (helper for the first-in first-out order)";
}
rule Section857d3EarlierLayer(c: Person, ly: TaxableYear, other: TaxableYear, own: Money, amount: Money, b1: Date, b2: Date) strict {
    label en official "helper: the layers that begin before this layer";
    when accumulated_earnings_of_year_857d3(c, ly, own);
    when accumulated_earnings_of_year_857d3(c, other, amount);
    when us.irc.core::begins(ly, b1);
    when us.irc.core::begins(other, b2);
    when b2 < b1;
    then earlier_layer_amount_857d3(c, ly, other, amount);
}
pub relation has_earlier_layer_857d3(c: Person, ly: TaxableYear) kind institutional {
    label en official "some earlier layer exists (helper)";
}
rule Section857d3HasEarlierLayer(c: Person, ly: TaxableYear, other: TaxableYear, amount: Money) strict {
    label en official "helper";
    when earlier_layer_amount_857d3(c, ly, other, amount);
    then has_earlier_layer_857d3(c, ly);
}
pub relation earlier_layers_total_857d3(c: Person, ly: TaxableYear, total: Money) kind institutional {
    label en official "the total of the earlier layers";
}
rule Section857d3EarlierTotal(c: Person, ly: TaxableYear) strict {
    label en official "the sum of the layers that begin earlier (sums over derived items: G4903)";
    when earlier_layer_amount_857d3(c, ly, _, _);
    then earlier_layers_total_857d3(c, ly, sum all amount: Money for other: TaxableYear where earlier_layer_amount_857d3(c, ly, other, amount));
}
rule Section857d3NoEarlierTotal(c: Person, ly: TaxableYear, own: Money) strict {
    label en official "the oldest layer has no earlier layers";
    when accumulated_earnings_of_year_857d3(c, ly, own);
    when not_known(has_earlier_layer_857d3(c, ly));
    then earlier_layers_total_857d3(c, ly, 0.00 USD);
}
pub relation distribution_allocated_to_layer_857d3(c: Person, dist: us.irc.core::Payment, ly: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the distribution treated as made from the layer, oldest layer first";
}
@source(IRC_S857_D, quote = "(A) shall be treated for purposes of this subsection and subsection (a)(2)(B) as made from earnings and")
rule Section857d3AllocateToLayer(c: Person, dist: us.irc.core::Payment, ly: TaxableYear, distribution: Money, layer: Money, earlier: Money) strict {
    label en official "Section 857(d)(3)(A): the distribution is treated as made from the earnings that would cause the failure, allocated first in, first out (cents exact)";
    when distribution_to_comply_with_857a2B_857d3(c, dist, distribution);
    when accumulated_earnings_of_year_857d3(c, ly, layer);
    when earlier_layers_total_857d3(c, ly, earlier);
    then distribution_allocated_to_layer_857d3(c, dist, ly, min(layer, max(0.00 USD, distribution - earlier)));
}
pub relation distribution_treated_as_from_accumulated_earnings_857d3(c: Person, dist: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the distribution treated as made from accumulated earnings and profits";
}
@source(IRC_S857_D, quote = "(A) shall be treated for purposes of this subsection and subsection (a)(2)(B) as made from earnings and")
rule Section857d3TotalFromAccumulatedEarnings(c: Person, dist: us.irc.core::Payment) strict {
    label en official "Section 857(d)(3): the total of the layer allocations";
    when distribution_allocated_to_layer_857d3(c, dist, _, _);
    then distribution_treated_as_from_accumulated_earnings_857d3(c, dist, sum all amount: Money for ly: TaxableYear where distribution_allocated_to_layer_857d3(c, dist, ly, amount));
}
pub relation distribution_not_a_distribution_for_857b2B_858(c: Person, dist: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "to the extent treated as made from accumulated earnings and profits, not treated as a distribution for subsection (b)(2)(B) and section 858";
}
@source(IRC_S857_D, quote = "(B) to the extent treated under subparagraph (A) as made from accumulated earnings and profits, shall")
rule Section857d3NotADistribution(c: Person, dist: us.irc.core::Payment, amount: Money) strict {
    label en official "Section 857(d)(3)(B): the accumulated-earnings part is not a distribution for subsection (b)(2)(B) and section 858";
    when distribution_treated_as_from_accumulated_earnings_857d3(c, dist, amount);
    then distribution_not_a_distribution_for_857b2B_858(c, dist, amount);
}

// ---- Section 852(b)(4)(C): the holding period of a share (section 246(c)(3), (4) rules and the ex-dividend cutoff) ----

pub relation share_acquired_on_852b4C(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the taxpayer acquired the share";
}
pub relation share_disposed_on_852b4C(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the taxpayer disposed of the share";
}
pub relation share_becomes_ex_dividend_on_852b4C(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the share becomes ex-dividend";
}
pub relation days_risk_of_loss_diminished_852b4C(sh: Person, share: us.irc.core::Asset, days: Integer) kind empirical {
    label en unofficial "the days excluded from the holding period by the rules of paragraphs (3) and (4) of section 246(c) (the days on which the risk of loss is diminished are an asserted count: G2212)";
}
pub relation share_has_ex_dividend_date_852b4C(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en official "the share has an ex-dividend date (helper)";
}
rule Section852b4CHelperExDividend(sh: Person, share: us.irc.core::Asset, on: Date) strict {
    label en official "helper";
    when share_becomes_ex_dividend_on_852b4C(sh, share, on);
    then share_has_ex_dividend_date_852b4C(sh, share);
}
pub relation counting_end_of_holding_period_852b4C(sh: Person, share: us.irc.core::Asset, end: Date) kind institutional {
    label en official "the last day counted in the holding period: the disposition date, or 6 months after the ex-dividend date when that is earlier";
}
@source(IRC_S852_B, quote = "(ii) there shall not be taken into account any day which is more than 6 months after the date on which")
rule Section852b4CCountingEndAtDisposition(sh: Person, share: us.irc.core::Asset, disposed: Date, ex: Date) strict {
    label en official "Section 852(b)(4)(C)(ii): a disposition within 6 months after the ex-dividend date ends the count";
    when share_disposed_on_852b4C(sh, share, disposed);
    when share_becomes_ex_dividend_on_852b4C(sh, share, ex);
    when disposed <= add_calendar_period(ex, 6 calendar_month);
    then counting_end_of_holding_period_852b4C(sh, share, disposed);
}
rule Section852b4CCountingEndAtCutoff(sh: Person, share: us.irc.core::Asset, disposed: Date, ex: Date) strict {
    label en official "Section 852(b)(4)(C)(ii): days more than 6 months after the ex-dividend date are not counted";
    when share_disposed_on_852b4C(sh, share, disposed);
    when share_becomes_ex_dividend_on_852b4C(sh, share, ex);
    when disposed > add_calendar_period(ex, 6 calendar_month);
    then counting_end_of_holding_period_852b4C(sh, share, add_calendar_period(ex, 6 calendar_month));
}
rule Section852b4CCountingEndWithoutExDividend(sh: Person, share: us.irc.core::Asset, disposed: Date) strict {
    label en official "Section 852(b)(4)(C): without an ex-dividend date the whole period counts";
    when share_disposed_on_852b4C(sh, share, disposed);
    when not_known(share_has_ex_dividend_date_852b4C(sh, share));
    then counting_end_of_holding_period_852b4C(sh, share, disposed);
}
pub relation diminished_risk_days_852b4C(sh: Person, share: us.irc.core::Asset, days: Integer) kind institutional {
    label en official "the days excluded by the risk-of-loss rules (zero when none are stated)";
}
rule Section852b4CDiminishedDaysStated(sh: Person, share: us.irc.core::Asset, days: Integer) strict {
    label en official "Section 852(b)(4)(C)(i): the days excluded under section 246(c)(3)-(4)";
    when days_risk_of_loss_diminished_852b4C(sh, share, days);
    then diminished_risk_days_852b4C(sh, share, days);
}
pub relation risk_days_stated_852b4C(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en official "excluded days are stated for the share (helper)";
}
rule Section852b4CHelperRiskDaysStated(sh: Person, share: us.irc.core::Asset, days: Integer) strict {
    label en official "helper";
    when days_risk_of_loss_diminished_852b4C(sh, share, days);
    then risk_days_stated_852b4C(sh, share);
}
rule Section852b4CDiminishedDaysNone(sh: Person, share: us.irc.core::Asset, disposed: Date) strict {
    label en official "Section 852(b)(4)(C)(i): no excluded days";
    when share_disposed_on_852b4C(sh, share, disposed);
    when not_known(risk_days_stated_852b4C(sh, share));
    then diminished_risk_days_852b4C(sh, share, 0);
}
pub relation holding_period_days_852b4C(sh: Person, share: us.irc.core::Asset, days: Integer) kind institutional {
    label en official "the days the share is held for the six-month test";
}
@source(IRC_S852_B, quote = "For purposes of this paragraph, in determining the period for which the taxpayer has held any share of")
rule Section852b4CHoldingDays(sh: Person, share: us.irc.core::Asset, acquired: Date, end: Date, diminished: Integer) strict {
    label en official "Section 852(b)(4)(C): the days from acquisition to the counting end, less the days excluded";
    when share_acquired_on_852b4C(sh, share, acquired);
    when counting_end_of_holding_period_852b4C(sh, share, end);
    when diminished_risk_days_852b4C(sh, share, diminished);
    then holding_period_days_852b4C(sh, share, days_between(acquired, end) - diminished);
}
@source(IRC_S852_B, quote = "(i) the rules of paragraphs (3) and (4) of section 246(c) shall apply, and")
rule Section852b4CSixMonthsOrLess(sh: Person, share: us.irc.core::Asset, acquired: Date, days: Integer) strict {
    label en official "Section 852(b)(4)(C): a share is held six months or less when the counted days do not exceed the days in the six months from acquisition";
    when share_acquired_on_852b4C(sh, share, acquired);
    when holding_period_days_852b4C(sh, share, days);
    when days <= days_between(acquired, add_calendar_period(acquired, 6 calendar_month));
    then share_held_six_months_or_less_852b4(sh, share);
}

// ---- Section 857(b)(8)(B): the holding period of a share (section 246(c)(3), (4) rules and the ex-dividend cutoff) ----

pub relation share_acquired_on_857b8B(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the taxpayer acquired the share";
}
pub relation share_disposed_on_857b8B(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the taxpayer disposed of the share";
}
pub relation share_becomes_ex_dividend_on_857b8B(sh: Person, share: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date the share becomes ex-dividend";
}
pub relation days_risk_of_loss_diminished_857b8B(sh: Person, share: us.irc.core::Asset, days: Integer) kind empirical {
    label en unofficial "the days excluded from the holding period by the rules of paragraphs (3) and (4) of section 246(c) (the days on which the risk of loss is diminished are an asserted count: G2212)";
}
pub relation share_has_ex_dividend_date_857b8B(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en official "the share has an ex-dividend date (helper)";
}
rule Section857b8BHelperExDividend(sh: Person, share: us.irc.core::Asset, on: Date) strict {
    label en official "helper";
    when share_becomes_ex_dividend_on_857b8B(sh, share, on);
    then share_has_ex_dividend_date_857b8B(sh, share);
}
pub relation counting_end_of_holding_period_857b8B(sh: Person, share: us.irc.core::Asset, end: Date) kind institutional {
    label en official "the last day counted in the holding period: the disposition date, or 6 months after the ex-dividend date when that is earlier";
}
@source(IRC_S857_B, quote = "(ii) there shall not be taken into account any day which is more than 6 months after the date on which")
rule Section857b8BCountingEndAtDisposition(sh: Person, share: us.irc.core::Asset, disposed: Date, ex: Date) strict {
    label en official "Section 857(b)(8)(B)(ii): a disposition within 6 months after the ex-dividend date ends the count";
    when share_disposed_on_857b8B(sh, share, disposed);
    when share_becomes_ex_dividend_on_857b8B(sh, share, ex);
    when disposed <= add_calendar_period(ex, 6 calendar_month);
    then counting_end_of_holding_period_857b8B(sh, share, disposed);
}
rule Section857b8BCountingEndAtCutoff(sh: Person, share: us.irc.core::Asset, disposed: Date, ex: Date) strict {
    label en official "Section 857(b)(8)(B)(ii): days more than 6 months after the ex-dividend date are not counted";
    when share_disposed_on_857b8B(sh, share, disposed);
    when share_becomes_ex_dividend_on_857b8B(sh, share, ex);
    when disposed > add_calendar_period(ex, 6 calendar_month);
    then counting_end_of_holding_period_857b8B(sh, share, add_calendar_period(ex, 6 calendar_month));
}
rule Section857b8BCountingEndWithoutExDividend(sh: Person, share: us.irc.core::Asset, disposed: Date) strict {
    label en official "Section 857(b)(8)(B): without an ex-dividend date the whole period counts";
    when share_disposed_on_857b8B(sh, share, disposed);
    when not_known(share_has_ex_dividend_date_857b8B(sh, share));
    then counting_end_of_holding_period_857b8B(sh, share, disposed);
}
pub relation diminished_risk_days_857b8B(sh: Person, share: us.irc.core::Asset, days: Integer) kind institutional {
    label en official "the days excluded by the risk-of-loss rules (zero when none are stated)";
}
rule Section857b8BDiminishedDaysStated(sh: Person, share: us.irc.core::Asset, days: Integer) strict {
    label en official "Section 857(b)(8)(B)(i): the days excluded under section 246(c)(3)-(4)";
    when days_risk_of_loss_diminished_857b8B(sh, share, days);
    then diminished_risk_days_857b8B(sh, share, days);
}
pub relation risk_days_stated_857b8B(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en official "excluded days are stated for the share (helper)";
}
rule Section857b8BHelperRiskDaysStated(sh: Person, share: us.irc.core::Asset, days: Integer) strict {
    label en official "helper";
    when days_risk_of_loss_diminished_857b8B(sh, share, days);
    then risk_days_stated_857b8B(sh, share);
}
rule Section857b8BDiminishedDaysNone(sh: Person, share: us.irc.core::Asset, disposed: Date) strict {
    label en official "Section 857(b)(8)(B)(i): no excluded days";
    when share_disposed_on_857b8B(sh, share, disposed);
    when not_known(risk_days_stated_857b8B(sh, share));
    then diminished_risk_days_857b8B(sh, share, 0);
}
pub relation holding_period_days_857b8B(sh: Person, share: us.irc.core::Asset, days: Integer) kind institutional {
    label en official "the days the share is held for the six-month test";
}
@source(IRC_S857_B, quote = "For purposes of this paragraph, in determining the period for which the taxpayer has held any share of")
rule Section857b8BHoldingDays(sh: Person, share: us.irc.core::Asset, acquired: Date, end: Date, diminished: Integer) strict {
    label en official "Section 857(b)(8)(B): the days from acquisition to the counting end, less the days excluded";
    when share_acquired_on_857b8B(sh, share, acquired);
    when counting_end_of_holding_period_857b8B(sh, share, end);
    when diminished_risk_days_857b8B(sh, share, diminished);
    then holding_period_days_857b8B(sh, share, days_between(acquired, end) - diminished);
}
@source(IRC_S857_B, quote = "(i) the rules of paragraphs (3) and (4) of section 246(c) shall apply, and")
rule Section857b8BSixMonthsOrLess(sh: Person, share: us.irc.core::Asset, acquired: Date, days: Integer) strict {
    label en official "Section 857(b)(8)(B): a share is held six months or less when the counted days do not exceed the days in the six months from acquisition";
    when share_acquired_on_857b8B(sh, share, acquired);
    when holding_period_days_857b8B(sh, share, days);
    when days <= days_between(acquired, add_calendar_period(acquired, 6 calendar_month));
    then reit_share_held_six_months_or_less_857b8(sh, share);
}
