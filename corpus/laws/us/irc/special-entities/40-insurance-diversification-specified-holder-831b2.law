// Section 831(b)(2)(B)(i)(II)-(iv), (C), (D): the diversification
// requirement beyond the one-policyholder 20 percent test (stage 3b, IRC-09
// stage 3b, TECH_GAP reduction), 26.09.2026. Status implemented_unverified;
// nothing here was executed.
//
// METHOD. The 20 percent test of subclause (I) is now computed per
// "policyholder unit": a policyholder's premiums (its own written
// premiums plus, under (D), the premiums of the underlying direct
// policyholders of a reinsurance, fronting or intermediary arrangement)
// added to the premiums of every policyholder treated as one policyholder
// with it under (C)(i)(II) (related persons or members of the same
// controlled group). The unit relation is given per pair by the case (G5308:
// the closure of a chain of related persons is not followed). The premiums
// threshold of (A)(i) counts, under (C)(i)(I), the premiums received by the
// other members of the controlled group, where "controlled group" is the
// section 1563(a) group with "more than 50 percent" (one hop: an owner of
// more than 50 percent, or a common owner of more than 50 percent of both:
// G5309). The alternative test of subclause (II) is derived per specified
// holder: the aggregate interest in the company (direct, indirect through
// a trust, estate, partnership or corporation, and a United States citizen
// spouse's) against the holder's percentage of the interests in the
// relevant specified assets; a difference of more than 2 percentage points
// (the de minimis line; regulations may change it) disqualifies. Sums over
// derived items follow G4903.

// ---- Section 831(b)(2)(C)(ii): the controlled group ----

use self::{
    IRC_S831_B,
    Person,
    TaxableYear,
    premiums_from_one_policyholder,
    section_831b_diversification_requirement_met,
    section_831b_premiums_measure,
};

pub relation ownership_percent_831b2Cii(owner: Person, corp: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the total voting power or value of the corporation's stock the owner holds (with more than 50 percent for at least 80 percent, section 1563(a) as modified)";
}
pub relation owns_more_than_50_percent_831b2Cii(owner: Person, corp: Person) kind institutional {
    label en official "the owner holds more than 50 percent of the corporation";
}
@source(IRC_S831_B, quote = "each place it appears in section 1563(a), and")
rule Section831b2CiiOwnsMoreThanFiftyPercent(owner: Person, corp: Person, pct: Decimal) strict {
    label en official "section 831(b)(2)(C)(ii)(I): more than 50 percent is substituted for at least 80 percent";
    when ownership_percent_831b2Cii(owner, corp, pct);
    when pct > 50.0;
    then owns_more_than_50_percent_831b2Cii(owner, corp);
}
pub relation same_controlled_group_831b2Cii(a: Person, b: Person) kind institutional {
    label en official "the two companies are members of the same controlled group (one hop: parent and subsidiary, or a common parent)";
}
@source(IRC_S831_B, quote = "means any controlled group of corporations (as defined in section 1563(a)); except that—")
rule Section831b2CiiParentAndSubsidiary(a: Person, b: Person) strict {
    label en official "section 831(b)(2)(C)(ii): a company that owns more than 50 percent of another is in its controlled group";
    when owns_more_than_50_percent_831b2Cii(a, b);
    then same_controlled_group_831b2Cii(a, b);
}
rule Section831b2CiiSubsidiaryAndParent(a: Person, b: Person) strict {
    label en official "section 831(b)(2)(C)(ii): the controlled group relation is symmetric";
    when owns_more_than_50_percent_831b2Cii(b, a);
    then same_controlled_group_831b2Cii(a, b);
}
rule Section831b2CiiCommonParent(a: Person, b: Person, parent: Person) strict {
    label en official "section 831(b)(2)(C)(ii): two companies more than 50 percent owned by the same parent are in one controlled group";
    when owns_more_than_50_percent_831b2Cii(parent, a);
    when owns_more_than_50_percent_831b2Cii(parent, b);
    then same_controlled_group_831b2Cii(a, b);
}
@source(IRC_S831_B, quote = "(II) subsections (a)(4) and (b)(2)(D) of section 1563 shall not apply.")
pub relation section_1563_a4_b2D_disapplied_831b2CiiII(a: Person) kind empirical {
    label en unofficial "subsections (a)(4) and (b)(2)(D) of section 1563 are not applied in determining the controlled group (recorded as a case reading: the case's ownership percentages already omit those rules)";
}

// ---- Section 831(b)(2)(C)(i)(I): premiums of the controlled group ----

pub relation premiums_measure_of_member_831b2Ci(member: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 831(b) premiums measure (net written premiums, or if greater direct written premiums) received by the member of the controlled group during the taxable year";
}
pub relation other_member_premiums_831b2Ci(c: Person, y: TaxableYear, member: Person, amount: Money) kind institutional {
    label en official "a member of the same controlled group as the company received these premiums in the taxable year";
}
rule Section831b2CiOtherMemberPremiums(c: Person, y: TaxableYear, member: Person, amount: Money) strict {
    label en official "section 831(b)(2)(C)(i)(I): premiums received by the other members of the controlled group";
    when same_controlled_group_831b2Cii(c, member);
    when premiums_measure_of_member_831b2Ci(member, y, amount);
    then other_member_premiums_831b2Ci(c, y, member, amount);
}
pub relation section_831b_group_premiums_measure_831b2Ci(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the premiums measure of the company plus the premiums received by the other members of its controlled group";
}
@source(IRC_S831_B, quote = "(I) in determining whether any company is described in clause (i) of subparagraph (A), such company")
rule Section831b2CiGroupPremiumsWithOthers(c: Person, y: TaxableYear, own: Money) strict {
    label en official "section 831(b)(2)(C)(i)(I): the company is treated as receiving the amounts received by all other members of its controlled group";
    when section_831b_premiums_measure(c, y, own);
    when other_member_premiums_831b2Ci(c, y, _, _);
    then section_831b_group_premiums_measure_831b2Ci(c, y, own + sum all amount: Money for member: Person where other_member_premiums_831b2Ci(c, y, member, amount));
}
pub relation controlled_group_has_other_premiums_831b2Ci(c: Person, y: TaxableYear) kind institutional {
    label en official "some other member of the controlled group received premiums (helper)";
}
rule Section831b2CiHelperOtherPremiums(c: Person, y: TaxableYear, member: Person, amount: Money) strict {
    label en official "helper";
    when other_member_premiums_831b2Ci(c, y, member, amount);
    then controlled_group_has_other_premiums_831b2Ci(c, y);
}
rule Section831b2CiGroupPremiumsAlone(c: Person, y: TaxableYear, own: Money) strict {
    label en official "section 831(b)(2)(C)(i)(I): a company with no other member premiums has its own measure";
    when section_831b_premiums_measure(c, y, own);
    when not_known(controlled_group_has_other_premiums_831b2Ci(c, y));
    then section_831b_group_premiums_measure_831b2Ci(c, y, own);
}

// ---- Section 831(b)(2)(D), (C)(i)(II): the policyholder unit ----

pub relation premiums_via_arrangement_of_underlying_policyholder_831b2D(c: Person, y: TaxableYear, arrangement: Person, policyholder: Person, amount: Money) kind empirical {
    label en unofficial "premiums written through a reinsurance, fronting, intermediary or similar arrangement, attributable to a policyholder of the underlying direct written insurance";
}
pub relation underlying_policyholder_premiums_831b2D(c: Person, y: TaxableYear, policyholder: Person, amount: Money) kind institutional {
    label en official "the premiums attributable to the underlying policyholder over all arrangements";
}
@source(IRC_S831_B, quote = "means each policyholder of the underlying direct written insurance with respect to such reinsurance or")
rule Section831b2DUnderlyingPolicyholder(c: Person, y: TaxableYear, policyholder: Person) strict {
    label en official "section 831(b)(2)(D): in reinsurance or fronting the policyholder is each policyholder of the underlying direct written insurance";
    when premiums_via_arrangement_of_underlying_policyholder_831b2D(c, y, _, policyholder, _);
    then underlying_policyholder_premiums_831b2D(c, y, policyholder, sum all amount: Money for arrangement: Person where premiums_via_arrangement_of_underlying_policyholder_831b2D(c, y, arrangement, policyholder, amount));
}
pub relation has_direct_premiums_831b2(c: Person, y: TaxableYear, policyholder: Person) kind institutional {
    label en official "the policyholder has premiums written directly (helper)";
}
rule Section831b2HelperDirect(c: Person, y: TaxableYear, policyholder: Person, amount: Money) strict {
    label en official "helper";
    when premiums_from_one_policyholder(c, y, policyholder, amount);
    then has_direct_premiums_831b2(c, y, policyholder);
}
pub relation has_underlying_premiums_831b2(c: Person, y: TaxableYear, policyholder: Person) kind institutional {
    label en official "the policyholder has premiums attributed through an arrangement (helper)";
}
rule Section831b2HelperUnderlying(c: Person, y: TaxableYear, policyholder: Person, amount: Money) strict {
    label en official "helper";
    when underlying_policyholder_premiums_831b2D(c, y, policyholder, amount);
    then has_underlying_premiums_831b2(c, y, policyholder);
}
pub relation policyholder_premiums_831b2(c: Person, y: TaxableYear, policyholder: Person, amount: Money) kind institutional {
    label en official "the premiums attributable to the policyholder: direct premiums plus underlying-arrangement premiums";
}
rule Section831b2PolicyholderPremiumsBoth(c: Person, y: TaxableYear, policyholder: Person, direct: Money, underlying: Money) strict {
    label en official "section 831(b)(2)(D): direct and arrangement premiums of the same policyholder add";
    when premiums_from_one_policyholder(c, y, policyholder, direct);
    when underlying_policyholder_premiums_831b2D(c, y, policyholder, underlying);
    then policyholder_premiums_831b2(c, y, policyholder, direct + underlying);
}
rule Section831b2PolicyholderPremiumsDirectOnly(c: Person, y: TaxableYear, policyholder: Person, direct: Money) strict {
    label en official "section 831(b)(2)(B)(i): a policyholder with direct premiums only";
    when premiums_from_one_policyholder(c, y, policyholder, direct);
    when not_known(has_underlying_premiums_831b2(c, y, policyholder));
    then policyholder_premiums_831b2(c, y, policyholder, direct);
}
rule Section831b2PolicyholderPremiumsUnderlyingOnly(c: Person, y: TaxableYear, policyholder: Person, underlying: Money) strict {
    label en official "section 831(b)(2)(D): a policyholder with arrangement premiums only";
    when underlying_policyholder_premiums_831b2D(c, y, policyholder, underlying);
    when not_known(has_direct_premiums_831b2(c, y, policyholder));
    then policyholder_premiums_831b2(c, y, policyholder, underlying);
}
pub relation policyholders_related_267b_707b_831b2Cii(a: Person, b: Person) kind empirical {
    label en unofficial "the two policyholders are related within the meaning of section 267(b) or 707(b) (stated in both directions; the closure of a chain is not followed: G5308)";
}
pub relation treated_as_one_policyholder_831b2Cii(a: Person, b: Person) kind institutional {
    label en official "the two policyholders are treated as one policyholder: related, or members of the same controlled group";
}
@source(IRC_S831_B, quote = "(II) in determining the attribution of premiums to any policyholder under subparagraph (B)(i), all")
rule Section831b2CiiRelatedPolicyholders(a: Person, b: Person) strict {
    label en official "section 831(b)(2)(C)(i)(II): related policyholders are treated as one policyholder";
    when policyholders_related_267b_707b_831b2Cii(a, b);
    then treated_as_one_policyholder_831b2Cii(a, b);
}
rule Section831b2CiiControlledGroupPolicyholders(a: Person, b: Person) strict {
    label en official "section 831(b)(2)(C)(i)(II): members of the same controlled group are treated as one policyholder";
    when same_controlled_group_831b2Cii(a, b);
    then treated_as_one_policyholder_831b2Cii(a, b);
}
pub relation related_policyholder_premiums_831b2Cii(c: Person, y: TaxableYear, policyholder: Person, other: Person, amount: Money) kind institutional {
    label en official "premiums of another policyholder treated as one with the policyholder";
}
rule Section831b2CiiRelatedPremiums(c: Person, y: TaxableYear, policyholder: Person, other: Person, amount: Money) strict {
    label en official "section 831(b)(2)(C)(i)(II): the premiums of the policyholders treated as one";
    when treated_as_one_policyholder_831b2Cii(policyholder, other);
    when policyholder_premiums_831b2(c, y, other, amount);
    then related_policyholder_premiums_831b2Cii(c, y, policyholder, other, amount);
}
pub relation policyholder_has_related_831b2Cii(c: Person, y: TaxableYear, policyholder: Person) kind institutional {
    label en official "some other policyholder is treated as one with the policyholder (helper)";
}
rule Section831b2CiiHelperHasRelated(c: Person, y: TaxableYear, policyholder: Person, other: Person, amount: Money) strict {
    label en official "helper";
    when related_policyholder_premiums_831b2Cii(c, y, policyholder, other, amount);
    then policyholder_has_related_831b2Cii(c, y, policyholder);
}
pub relation policyholder_unit_premiums_831b2Bi(c: Person, y: TaxableYear, policyholder: Person, amount: Money) kind institutional {
    label en official "the premiums attributable to the policyholder as one unit, with the policyholders treated as one with it";
}
rule Section831b2BiUnitWithRelated(c: Person, y: TaxableYear, policyholder: Person, own: Money) strict {
    label en official "section 831(b)(2)(B)(i), (C)(i)(II): the policyholder's premiums plus those of the policyholders treated as one with it";
    when policyholder_premiums_831b2(c, y, policyholder, own);
    when policyholder_has_related_831b2Cii(c, y, policyholder);
    then policyholder_unit_premiums_831b2Bi(c, y, policyholder, own + sum all amount: Money for other: Person where related_policyholder_premiums_831b2Cii(c, y, policyholder, other, amount));
}
rule Section831b2BiUnitAlone(c: Person, y: TaxableYear, policyholder: Person, own: Money) strict {
    label en official "section 831(b)(2)(B)(i): a policyholder treated as one with no other";
    when policyholder_premiums_831b2(c, y, policyholder, own);
    when not_known(policyholder_has_related_831b2Cii(c, y, policyholder));
    then policyholder_unit_premiums_831b2Bi(c, y, policyholder, own);
}
pub relation policyholder_unit_over_20_percent_831b2Bi(c: Person, y: TaxableYear) kind institutional {
    label en official "some policyholder unit accounts for more than 20 percent of the premiums measure";
}
rule Section831b2BiUnitOverTwentyPercent(c: Person, y: TaxableYear, policyholder: Person, unit: Money, total: Money) strict {
    label en official "section 831(b)(2)(B)(i)(I): a unit above 20 percent of the premiums measure";
    when section_831b_premiums_measure(c, y, total);
    when policyholder_unit_premiums_831b2Bi(c, y, policyholder, unit);
    when unit * 100 > total * 20;
    then policyholder_unit_over_20_percent_831b2Bi(c, y);
}
@source(IRC_S831_B, quote = "For purposes of this paragraph—")
pub relation controlled_group_and_related_rules_apply_831b2Ci(c: Person, y: TaxableYear) kind institutional {
    label en official "the controlled group and related-person aggregation rules of subparagraph (C)(i) apply to the determination (chapeau)";
}
rule Section831b2CiChapeau(c: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 831(b)(2)(C)(i): the aggregation rules apply where a group premiums measure is derived";
    when section_831b_group_premiums_measure_831b2Ci(c, y, amount);
    then controlled_group_and_related_rules_apply_831b2Ci(c, y);
}

// ---- Section 831(b)(2)(B)(i)(II)-(iv): the specified holder test ----

pub relation premium_paid_with_respect_to_asset_831b2Bivii(c: Person, y: TaxableYear, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the net written (or direct written) premiums of the company are paid with respect to this trade or business, right or asset";
}
pub relation specified_asset_831b2Bivii(c: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "the trade or business, right or asset is a specified asset with respect to the company";
}
@source(IRC_S831_B, quote = "means, with respect to any insurance company, the trades or businesses, rights, or assets with respect")
rule Section831b2BivSpecifiedAsset(c: Person, y: TaxableYear, asset: us.irc.core::Asset) strict {
    label en official "section 831(b)(2)(B)(iv)(II): specified assets are those for which the premiums are paid";
    when premium_paid_with_respect_to_asset_831b2Bivii(c, y, asset);
    then specified_asset_831b2Bivii(c, asset);
}
pub relation specified_asset_value_831b2Biv(c: Person, asset: us.irc.core::Asset, value: Money) kind empirical {
    label en unofficial "the value of the specified asset";
}
pub relation asset_held_by_spouse_or_specified_relation_of_holder_831b2BivI(c: Person, holder: Person, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "an interest in the specified asset is held (directly or indirectly) by a spouse or specified relation of the specified holder";
}
pub relation asset_interest_acquired_solely_by_inheritance_831b2BivI(c: Person, holder: Person, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest of the spouse or specified relation in the asset was acquired solely by bequest, devise, or inheritance";
}
pub relation relevant_specified_asset_831b2BivI(c: Person, holder: Person, asset: us.irc.core::Asset, value: Money) kind institutional {
    label en official "the specified asset is a relevant specified asset with respect to the specified holder, with its value";
}
@source(IRC_S831_B, quote = "means, with respect to any specified holder with respect to any insurance company, the aggregate amount")
rule Section831b2BivIRelevantSpecifiedAsset(c: Person, holder: Person, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 831(b)(2)(B)(iv)(I): specified assets held by a spouse or specified relation, not solely by inheritance";
    when specified_asset_831b2Bivii(c, asset);
    when asset_held_by_spouse_or_specified_relation_of_holder_831b2BivI(c, holder, asset);
    when specified_asset_value_831b2Biv(c, asset, value);
    when not_known(asset_interest_acquired_solely_by_inheritance_831b2BivI(c, holder, asset));
    then relevant_specified_asset_831b2BivI(c, holder, asset, value);
}
pub relation relevant_specified_assets_aggregate_831b2BivI(c: Person, holder: Person, amount: Money) kind institutional {
    label en official "the aggregate amount of the relevant specified assets with respect to the specified holder";
}
rule Section831b2BivIAggregate(c: Person, holder: Person) strict {
    label en official "section 831(b)(2)(B)(iv)(I): the aggregate amount of the relevant specified assets";
    when relevant_specified_asset_831b2BivI(c, holder, _, _);
    then relevant_specified_assets_aggregate_831b2BivI(c, holder, sum all value: Money for asset: us.irc.core::Asset where relevant_specified_asset_831b2BivI(c, holder, asset, value));
}
pub relation holder_interest_amount_in_relevant_assets_831b2Bi(c: Person, holder: Person, amount: Money) kind empirical {
    label en unofficial "the amount of the relevant specified assets in which the specified holder holds an interest (directly or indirectly)";
}
pub relation holder_percent_of_relevant_assets_831b2Bi(c: Person, holder: Person, pct: Decimal) kind institutional {
    label en official "the percentage of the interests in the relevant specified assets held by the specified holder (4 decimals, HALF_UP: JUDGMENT CALL)";
}
rule Section831b2BiPercentOfRelevantAssets(c: Person, holder: Person, held: Money, aggregate: Money) strict {
    label en official "section 831(b)(2)(B)(i)(II): the holder's share of the interests in the relevant specified assets";
    when holder_interest_amount_in_relevant_assets_831b2Bi(c, holder, held);
    when relevant_specified_assets_aggregate_831b2BivI(c, holder, aggregate);
    when aggregate > 0.00 USD;
    then holder_percent_of_relevant_assets_831b2Bi(c, holder, div_round(held * 100.0, aggregate, 4, "HALF_UP"));
}
pub relation holds_specified_assets_interest_831b2Biii(c: Person, person: Person) kind empirical {
    label en unofficial "the individual holds an interest (directly or indirectly) in the specified assets with respect to the company";
}
pub relation lineal_descendant_of_specified_assets_holder_831b2BiiiI(c: Person, h: Person) kind empirical {
    label en unofficial "the individual is a lineal descendent (including by adoption) of an individual who holds an interest in the specified assets, or of such individual's spouse";
}
pub relation spouse_of_such_lineal_descendant_831b2BiiiII(c: Person, h: Person) kind empirical {
    label en unofficial "the individual is a spouse of a lineal descendent described in subclause (I)";
}
pub relation noncitizen_spouse_of_specified_assets_holder_831b2BiiiIII(c: Person, h: Person) kind empirical {
    label en unofficial "the individual is not a citizen of the United States and is a spouse of an individual who holds an interest in the specified assets";
}
pub relation holds_interest_in_company_831b2Biii(c: Person, h: Person) kind empirical {
    label en unofficial "the individual holds (directly or indirectly) an interest in the insurance company";
}
pub relation specified_holder_831b2Biii(c: Person, h: Person) kind institutional {
    label en official "the individual is a specified holder with respect to the company";
}
@source(IRC_S831_B, quote = "(I) is a lineal descendent (including by adoption) of an individual who holds an interest (directly or")
rule Section831b2BiiiISpecifiedHolderDescendant(c: Person, h: Person) strict {
    label en official "section 831(b)(2)(B)(iii)(I): a lineal descendent of a holder of the specified assets or of the holder's spouse";
    when holds_interest_in_company_831b2Biii(c, h);
    when lineal_descendant_of_specified_assets_holder_831b2BiiiI(c, h);
    then specified_holder_831b2Biii(c, h);
}
@source(IRC_S831_B, quote = "(II) is a spouse of any lineal descendent described in subclause (I), or")
rule Section831b2BiiiIISpecifiedHolderDescendantSpouse(c: Person, h: Person) strict {
    label en official "section 831(b)(2)(B)(iii)(II): a spouse of such a lineal descendent";
    when holds_interest_in_company_831b2Biii(c, h);
    when spouse_of_such_lineal_descendant_831b2BiiiII(c, h);
    then specified_holder_831b2Biii(c, h);
}
@source(IRC_S831_B, quote = "(III) is not a citizen of the United States and is a spouse of an individual who holds an interest")
rule Section831b2BiiiIIISpecifiedHolderNoncitizenSpouse(c: Person, h: Person) strict {
    label en official "section 831(b)(2)(B)(iii)(III): a non-citizen spouse of a holder of the specified assets";
    when holds_interest_in_company_831b2Biii(c, h);
    when noncitizen_spouse_of_specified_assets_holder_831b2BiiiIII(c, h);
    then specified_holder_831b2Biii(c, h);
}
@source(IRC_S831_B, quote = "means, with respect to any insurance company, any individual who holds (directly or indirectly) an")
pub relation specified_holder_definition_applies_831b2Biii(c: Person) kind institutional {
    label en official "a specified holder exists with respect to the company (the chapeau of clause (iii))";
}
rule Section831b2BiiiChapeau(c: Person, h: Person) strict {
    label en official "section 831(b)(2)(B)(iii): a specified holder is an individual holding an interest in the company who meets one of the three kinds";
    when specified_holder_831b2Biii(c, h);
    then specified_holder_definition_applies_831b2Biii(c);
}
pub relation interest_components_831b2B(c: Person, h: Person, direct: Decimal, indirect: Decimal, citizen_spouse: Decimal) kind empirical {
    label en unofficial "the holder's percentage of the entire interests in the company: direct, indirect (through a trust, estate, partnership or corporation), and held by a United States citizen spouse of the holder";
}
pub relation aggregate_interest_percent_of_specified_holder_831b2B(c: Person, h: Person, pct: Decimal) kind institutional {
    label en official "the specified holder's aggregate percentage of the interests in the company: direct, indirect, and a United States citizen spouse's";
}
@source(IRC_S831_B, quote = "For purposes of clause (i)(II), any interest in the insurance company referred to in such clause which")
rule Section831b2BiiAggregateInterest(c: Person, h: Person, direct: Decimal, indirect: Decimal, spouse: Decimal) strict {
    label en official "section 831(b)(2)(B)(ii), (iv)(III): a citizen spouse's interest, and an indirect interest, is treated as held by the specified holder";
    when specified_holder_831b2Biii(c, h);
    when interest_components_831b2B(c, h, direct, indirect, spouse);
    then aggregate_interest_percent_of_specified_holder_831b2B(c, h, (direct + indirect) + spouse);
}
pub relation indirect_interest_kinds_831b2Biviii(c: Person, h: Person) kind institutional {
    label en official "an indirect interest includes an interest held through a trust, estate, partnership, or corporation (recorded in the indirect component)";
}
@source(IRC_S831_B, quote = "An indirect interest includes any interest held through a trust, estate, partnership, or corporation.")
rule Section831b2BivIIIIndirectInterest(c: Person, h: Person, direct: Decimal, indirect: Decimal, spouse: Decimal) strict {
    label en official "section 831(b)(2)(B)(iv)(III): the indirect component counts toward the aggregate interest";
    when interest_components_831b2B(c, h, direct, indirect, spouse);
    when indirect > 0.0;
    then indirect_interest_kinds_831b2Biviii(c, h);
}
pub relation de_minimis_percentage_points_831b2Biviv(c: Person, points: Decimal) kind institutional {
    label en official "2 percentage points or less are de minimis (unless the Secretary provides otherwise)";
}
pub relation secretary_de_minimis_points_831b2Biviv(c: Person, points: Decimal) kind empirical {
    label en unofficial "the de minimis percentage points provided by the Secretary in regulations or other guidance";
}
pub relation secretary_de_minimis_stated_831b2Biviv(c: Person) kind institutional {
    label en official "the Secretary has provided a different de minimis figure (helper)";
}
rule Section831b2BivIVSecretaryStated(c: Person, points: Decimal) strict {
    label en official "helper";
    when secretary_de_minimis_points_831b2Biviv(c, points);
    then secretary_de_minimis_stated_831b2Biviv(c);
}
@source(IRC_S831_B, quote = "Except as otherwise provided by the Secretary in regulations or other guidance, 2 percentage points or")
rule Section831b2BivIVStatutoryDeMinimis(c: Person, h: Person) strict {
    label en official "section 831(b)(2)(B)(iv)(IV): 2 percentage points or less are de minimis";
    when holds_interest_in_company_831b2Biii(c, h);
    when not_known(secretary_de_minimis_stated_831b2Biviv(c));
    then de_minimis_percentage_points_831b2Biviv(c, 2.0);
}
rule Section831b2BivIVSecretaryDeMinimis(c: Person, points: Decimal) strict {
    label en official "section 831(b)(2)(B)(iv)(IV): except as the Secretary provides otherwise";
    when secretary_de_minimis_points_831b2Biviv(c, points);
    then de_minimis_percentage_points_831b2Biviv(c, points);
}
pub relation disqualifying_specified_holder_831b2BiII(c: Person, h: Person) kind institutional {
    label en official "the specified holder holds a percentage of the company more than a de minimis percentage higher than the percentage of the relevant specified assets";
}
@source(IRC_S831_B, quote = "For purposes of this subparagraph—")
rule Section831b2BiIIDisqualifyingHolder(c: Person, h: Person, company_pct: Decimal, assets_pct: Decimal, points: Decimal) strict {
    label en official "section 831(b)(2)(B)(i)(II): the aggregate interest exceeds the relevant assets percentage by more than the de minimis points";
    when aggregate_interest_percent_of_specified_holder_831b2B(c, h, company_pct);
    when holder_percent_of_relevant_assets_831b2Bi(c, h, assets_pct);
    when de_minimis_percentage_points_831b2Biviv(c, points);
    when company_pct > assets_pct + points;
    then disqualifying_specified_holder_831b2BiII(c, h);
}
pub relation some_disqualifying_specified_holder_831b2BiII(c: Person) kind institutional {
    label en official "some specified holder disqualifies the company (helper)";
}
rule Section831b2BiIISomeDisqualifyingHolder(c: Person, h: Person) strict {
    label en official "helper";
    when disqualifying_specified_holder_831b2BiII(c, h);
    then some_disqualifying_specified_holder_831b2BiII(c);
}
pub relation diversification_requirement_by_alternative_test_831b2BiII(c: Person, y: TaxableYear) kind institutional {
    label en official "the alternative diversification test of subclause (II) is met";
}
@source(IRC_S831_B, quote = "(II) such insurance company does not meet the requirement of subclause (I) and no person who holds")
rule Section831b2BiIIAlternativeMet(c: Person, y: TaxableYear, total: Money) strict {
    label en official "section 831(b)(2)(B)(i)(II): the company does not meet subclause (I) and no specified holder holds a more than de minimis higher percentage of the company than of the relevant specified assets";
    when section_831b_premiums_measure(c, y, total);
    when not_known(diversification_cap_requirement_831b2BiI(c, y));
    when not_known(some_disqualifying_specified_holder_831b2BiII(c));
    then diversification_requirement_by_alternative_test_831b2BiII(c, y);
}
pub relation diversification_cap_requirement_831b2BiI(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 831(b)(2)(B)(i)(I) 20 percent one-policyholder-unit test is met";
}
rule Section831b2BiIMeetsRequirement(c: Person, y: TaxableYear) strict {
    label en official "section 831(b)(2)(B)(i)(I): the diversification requirement is met by the 20 percent test";
    when diversification_cap_requirement_831b2BiI(c, y);
    then section_831b_diversification_requirement_met(c, y);
}
rule Section831b2BiIIMeetsRequirement(c: Person, y: TaxableYear) strict {
    label en official "section 831(b)(2)(B)(i)(II): the diversification requirement is met by the alternative test";
    when diversification_requirement_by_alternative_test_831b2BiII(c, y);
    then section_831b_diversification_requirement_met(c, y);
}
