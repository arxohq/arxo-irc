// Section 857(b)(6)(C)-(J) (the safe harbors from the 100 percent tax on
// prohibited transactions: the general safe harbor (C), the timber safe
// harbor (D), the special rules (E), the 3-year averages (G) and (H), the
// treatment as investment property (I) and the termination date (J)).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. The safe harbors are per property and year. Their prerequisites
// (holding period, the expenditure limit, the sales-volume test, the rental
// holding period, the marketing requirement) are derived relations that a
// case can satisfy in two ways: through the aggregate facts of module 5
// (`property_held_at_least_2_years`, `two_year_capitalized_expenditures`,
// `number_of_qualifying_sales_in_year`, ...), which stay valid, or through
// itemised facts (sales, expenditures with dates, holding dates) that are
// counted here. The two stage-1 strict rules of module 5 that concluded the
// safe harbor from the (i)-(iii) branches alone were dropped: they ignored
// clauses (iv) and (v) of subparagraph (C). Amounts are exact cross-
// multiplied comparisons (no percentage is rounded). Two-year windows use
// calendar months (`add_calendar_period`, policy IRC_CALENDAR_STEP). Sums
// and counts over derived items are the section 111 runtime subset
// (TECH-GAPS G4903). The 3-year period is asserted year by year, since the
// core has no successor/predecessor year (TECH-GAPS G2201).

// ---- Inputs: the sale, the expenditure, the holding facts ----

use self::{
    Corporation,
    IRC_S856_C,
    IRC_S856_NOTE_6,
    IRC_S857_B,
    Person,
    TaxableYear,
    aggregate_adjusted_bases_of_all_trust_assets_at_beginning_of_year,
    aggregate_adjusted_bases_of_qualifying_property_sold,
    independent_contractor_856d3,
    is_taxable_reit_subsidiary_856l,
    net_selling_price,
    number_of_qualifying_sales_in_year,
    property_held_at_least_2_years,
    sale_within_prohibited_transaction_safe_harbor,
    trust_derives_income_from_contractor_856d7Ci,
    two_year_capitalized_expenditures,
};

pub enum ExpenditureKind857b6 {
    ExpTimberOperationCapitalized;
    ExpOtherCapitalized;
    ExpTimberlandAcquisition;
    ExpNotIncludibleInBasis;
    label en unofficial "the kind of an expenditure for the section 857(b)(6)(C)/(D) limits: capitalized and directly related to timber production or preservation, capitalized but not so related, a timberland acquisition expenditure, or one not includible in the basis of the property";
}
pub enum ExpenditureMaker857b6 {
    MadeByTrust;
    MadeByPartner;
    MadeByMortgagorOrLesseeAfterImminentDefault;
    MadeByAnyoneElse;
    label en unofficial "who made the expenditure: the trust, a partner of the trust, or (on property acquired through foreclosure or lease termination) the mortgagor or lessee after default became imminent";
}
pub enum ExpenditureExclusionGround857b6E {
    ExclForeclosurePropertyNoLossOfStatus;
    ExclGovernmentStandards;
    ExclCasualtyRestoration;
    ExclLoanAdvance;
    label en unofficial "a ground of section 857(b)(6)(E)(iii)-(v) on which an expenditure is not taken into account";
}
@source(IRC_S857_B, quote = "a sale of property which is a real estate asset (as defined in section 856(c)(5)(B))")
pub relation reit_sale_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) kind empirical {
    label en unofficial "the trust sold the real estate asset on this date in the taxable year, for this net selling price";
}
pub relation sale_transaction_857b6Evi(t: Person, y: TaxableYear, p: us.irc.core::Asset, txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the property was sold in this transaction (several properties sold to one buyer as part of one transaction share it)";
}
pub relation sale_of_foreclosure_property_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the sale is a sale of foreclosure property";
}
pub relation sale_to_which_section_1033_applies_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the sale is one to which section 1033 applies";
}
pub relation sold_property_adjusted_basis_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, basis: Money) kind empirical {
    label en unofficial "the adjusted basis of the property sold, determined for purposes of computing earnings and profits";
}
pub relation sold_property_fair_market_value_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, fmv: Money) kind empirical {
    label en unofficial "the fair market value of the property sold";
}
pub relation all_assets_fair_market_value_at_year_start_857b6(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of all the assets of the trust as of the beginning of the taxable year";
}
pub relation reit_acquired_property_on_857b6(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the trust acquired the property on this date";
}
pub relation property_acquired_by_foreclosure_or_lease_termination_857b6E(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property was acquired through foreclosure (or deed in lieu of foreclosure), or termination of a lease";
}
pub relation loan_or_lease_held_since_857b6Ei(t: Person, p: us.irc.core::Asset, since: Date) kind empirical {
    label en unofficial "the trust has held the loan the property secured, or the lease of the property, since this date";
}
pub relation reit_expenditure_857b6(t: Person, p: us.irc.core::Asset, item: us.irc.core::Payment, on: Date, amount: Money, kind: ExpenditureKind857b6, maker: ExpenditureMaker857b6) kind empirical {
    label en unofficial "an expenditure on the property, made on this date by this maker, of this kind";
}
pub relation expenditure_exclusion_ground_857b6E(item: us.irc.core::Payment, ground: ExpenditureExclusionGround857b6E) kind empirical {
    label en unofficial "the expenditure falls under this ground of section 857(b)(6)(E)(iii)-(v)";
}
pub relation property_is_land_or_improvements_857b6Civ(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property consists of land or improvements";
}
pub relation held_for_rental_income_since_857b6Civ(t: Person, p: us.irc.core::Asset, since: Date) kind empirical {
    label en unofficial "the trust has held the property for the production of rental income since this date";
}
pub relation held_for_rental_income_two_years_857b6Civ(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the trust has held the property for not less than 2 years for the production of rental income (an aggregate fact; the dated fact above is the itemised form)";
}
@source(IRC_S857_B, quote = "the trust held the property for not less than 2 years in connection with the trade or business of producing timber")
pub relation held_in_connection_with_timber_business_857b6Di(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property was held in connection with the trade or business of producing timber";
}
@source(IRC_S857_B, quote = "the sales price of the property sold by the trust is not based in whole or in part on income or profits, including income or profits derived from the sale or operation of such property")
pub relation sale_price_based_on_income_or_profits_857b6Dvi(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the sales price is based in whole or in part on income or profits, including income or profits derived from the sale or operation of the property";
}
@source(IRC_S857_B, quote = "substantially all of the marketing and development expenditures with respect to the property were made through an independent contractor")
pub relation substantially_all_marketing_expenditures_through_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, via: Person) kind empirical {
    label en unofficial "substantially all of the marketing (for subparagraph (C), also development) expenditures with respect to the property were made through this person (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}

// ---- Section 857(b)(6)(E)(i): holding period ----

@source(IRC_S857_B, quote = "The holding period of property acquired through foreclosure (or deed in lieu of foreclosure), or termination of the lease, includes the period for which the trust held the loan which such property secured, or the lease of such property.")
pub relation holding_start_857b6(t: Person, p: us.irc.core::Asset, start: Date) kind institutional {
    label en official "the date from which the trust's holding period of the property runs (the acquisition date, or for foreclosure or lease-termination property the date it began to hold the loan or lease)";
}
rule Section857b6EiHoldingFromAcquisition(t: Person, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 857(b)(6)(E)(i): the holding period runs from acquisition when the property was not acquired through foreclosure or lease termination";
    when reit_acquired_property_on_857b6(t, p, on);
    when not_known(property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p));
    then holding_start_857b6(t, p, on);
}
@source(IRC_S857_B, quote = "The holding period of property acquired through foreclosure (or deed in lieu of foreclosure), or termination of the lease, includes the period for which the trust held the loan which such property secured, or the lease of such property.")
rule Section857b6EiHoldingFromLoanOrLease(t: Person, p: us.irc.core::Asset, since: Date) defeasible {
    label en official "section 857(b)(6)(E)(i): the holding period of foreclosure or lease-termination property includes the period the trust held the loan or the lease";
    when property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p);
    when loan_or_lease_held_since_857b6Ei(t, p, since);
    then holding_start_857b6(t, p, since);
}
pub relation held_two_years_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the trust has held the property for not less than 2 years at the sale (clause (C)(i); for (D)(i) in connection with timber production)";
}
@source(IRC_S857_B, quote = "the trust has held the property for not less than 2 years")
rule Section857b6CiHeldTwoYearsByDates(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money, start: Date) defeasible {
    label en official "section 857(b)(6)(C)(i): two calendar years from the holding start to the sale date";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when holding_start_857b6(t, p, start);
    when add_calendar_period(start, 24 calendar_month) <= sold_on;
    then held_two_years_857b6(t, y, p);
}
@source(IRC_S857_B, quote = "the trust has held the property for not less than 2 years")
rule Section857b6CiHeldTwoYearsAsserted(t: Person, y: TaxableYear, p: us.irc.core::Asset) strict {
    label en official "section 857(b)(6)(C)(i): the aggregate fact of module 5 that the property was held for not less than 2 years";
    when property_held_at_least_2_years(t, y, p);
    then held_two_years_857b6(t, y, p);
}

// ---- Section 857(b)(6)(E)(ii)-(v): which expenditures are taken into account ----

pub relation expenditure_regarded_as_made_by_trust_857b6(item: us.irc.core::Payment) kind institutional {
    label en official "the expenditure counts as made by the trust: made by the trust or a partner of the trust, or (foreclosure or lease-termination property) by the mortgagor or lessee after default became imminent";
}
rule Section857b6ExpenditureByTrust(t: Person, p: us.irc.core::Asset, item: us.irc.core::Payment, on: Date, amount: Money, kind: ExpenditureKind857b6) strict {
    label en official "section 857(b)(6)(C)(ii): an expenditure made by the trust";
    when reit_expenditure_857b6(t, p, item, on, amount, kind, MadeByTrust);
    then expenditure_regarded_as_made_by_trust_857b6(item);
}
rule Section857b6ExpenditureByPartner(t: Person, p: us.irc.core::Asset, item: us.irc.core::Payment, on: Date, amount: Money, kind: ExpenditureKind857b6) strict {
    label en official "section 857(b)(6)(C)(ii): an expenditure made by a partner of the trust";
    when reit_expenditure_857b6(t, p, item, on, amount, kind, MadeByPartner);
    then expenditure_regarded_as_made_by_trust_857b6(item);
}
@source(IRC_S857_B, quote = "expenditures made by, or for the account of, the mortgagor or lessee after default became imminent will be regarded as made by the trust")
rule Section857b6EiiMortgagorExpenditure(t: Person, p: us.irc.core::Asset, item: us.irc.core::Payment, on: Date, amount: Money, kind: ExpenditureKind857b6) strict {
    label en official "section 857(b)(6)(E)(ii): on foreclosure or lease-termination property, expenditures of the mortgagor or lessee after default became imminent are the trust's";
    when reit_expenditure_857b6(t, p, item, on, amount, kind, MadeByMortgagorOrLesseeAfterImminentDefault);
    when property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p);
    then expenditure_regarded_as_made_by_trust_857b6(item);
}
pub relation expenditure_not_taken_into_account_857b6E(item: us.irc.core::Payment) kind institutional {
    label en official "the expenditure is not taken into account: foreclosure property that kept its status, government standards, casualty restoration, or a loan advance";
}
@source(IRC_S857_B, quote = "Expenditures will not be taken into account if they are made solely to comply with standards or requirements of any government or governmental authority having relevant jurisdiction, or if they are made to restore the property as a result of losses arising from fire, storm or other casualty.")
rule Section857b6EiiiToVExcluded(item: us.irc.core::Payment, ground: ExpenditureExclusionGround857b6E) strict {
    label en official "section 857(b)(6)(E)(iii)-(v): an expenditure on any of the excluding grounds is not taken into account";
    when expenditure_exclusion_ground_857b6E(item, ground);
    then expenditure_not_taken_into_account_857b6E(item);
}
pub relation counted_expenditure_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, amount: Money, kind: ExpenditureKind857b6) kind institutional {
    label en official "an expenditure that is taken into account for the limits: made (or regarded as made) by the trust or a partner, includible in the basis of the property, in the 2-year period preceding the date of sale, and not excluded by clause (E)";
}
@source(IRC_S857_B, quote = "aggregate expenditures made by the trust, or any partner of the trust, during the 2-year period preceding the date of sale which are includible in the basis of the property")
rule Section857b6CiiCountedExpenditure(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, on: Date, amount: Money, kind: ExpenditureKind857b6, maker: ExpenditureMaker857b6, sold_on: Date, price: Money) defeasible {
    label en official "section 857(b)(6)(C)(ii), (D)(ii)-(iii), (E): the itemised expenditure in the 2 years before the sale that counts";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when reit_expenditure_857b6(t, p, item, on, amount, kind, maker);
    when kind != ExpNotIncludibleInBasis;
    when on < sold_on;
    when add_calendar_period(on, 24 calendar_month) >= sold_on;
    when expenditure_regarded_as_made_by_trust_857b6(item);
    when not_known(expenditure_not_taken_into_account_857b6E(item));
    then counted_expenditure_857b6(t, y, p, item, amount, kind);
}
pub relation has_counted_expenditure_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "at least one expenditure is taken into account for the sale";
}
rule Section857b6HasCountedExpenditure(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, amount: Money, kind: ExpenditureKind857b6) defeasible {
    label en official "helper: some expenditure counts";
    when counted_expenditure_857b6(t, y, p, item, amount, kind);
    then has_counted_expenditure_857b6(t, y, p);
}
pub relation counted_expenditure_total_857b6C(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money) kind institutional {
    label en official "the aggregate expenditures taken into account for subparagraph (C)(ii)";
}
rule Section857b6CiiTotal(t: Person, y: TaxableYear, p: us.irc.core::Asset, anchor: us.irc.core::Payment, anchor_amount: Money, anchor_kind: ExpenditureKind857b6) defeasible {
    label en official "section 857(b)(6)(C)(ii): the sum of the counted expenditures";
    when counted_expenditure_857b6(t, y, p, anchor, anchor_amount, anchor_kind);
    then counted_expenditure_total_857b6C(t, y, p, sum all amount: Money for item: us.irc.core::Payment where counted_expenditure_857b6(t, y, p, item, amount, _));
}
pub relation counted_timber_expenditure_total_857b6D(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money) kind institutional {
    label en official "the aggregate capitalized expenditures directly related to timber production or preservation (timberland acquisition expenditures excluded), subparagraph (D)(ii)";
}
rule Section857b6DiiTimberTotal(t: Person, y: TaxableYear, p: us.irc.core::Asset, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 857(b)(6)(D)(ii): the sum of the counted timber-related expenditures";
    when counted_expenditure_857b6(t, y, p, anchor, anchor_amount, ExpTimberOperationCapitalized);
    then counted_timber_expenditure_total_857b6D(t, y, p, sum all amount: Money for item: us.irc.core::Payment where counted_expenditure_857b6(t, y, p, item, amount, ExpTimberOperationCapitalized));
}
pub relation counted_other_expenditure_total_857b6D(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money) kind institutional {
    label en official "the aggregate capitalized expenditures not directly related to timber production or preservation (timberland acquisition expenditures excluded), subparagraph (D)(iii)";
}
rule Section857b6DiiiOtherTotal(t: Person, y: TaxableYear, p: us.irc.core::Asset, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 857(b)(6)(D)(iii): the sum of the counted other expenditures";
    when counted_expenditure_857b6(t, y, p, anchor, anchor_amount, ExpOtherCapitalized);
    then counted_other_expenditure_total_857b6D(t, y, p, sum all amount: Money for item: us.irc.core::Payment where counted_expenditure_857b6(t, y, p, item, amount, ExpOtherCapitalized));
}

// ---- Expenditure limits: (C)(ii) 30 percent; (D)(ii) 30 percent; (D)(iii) 5 percent ----

pub relation net_selling_price_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset, price: Money) kind institutional {
    label en official "the net selling price of the property sold (from the itemised sale or the aggregate fact of module 5)";
}
rule Section857b6NetSellingPriceFromSale(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) strict {
    label en official "the net selling price of the itemised sale";
    when reit_sale_857b6(t, y, p, sold_on, price);
    then net_selling_price_857b6(t, y, p, price);
}
rule Section857b6NetSellingPriceAsserted(t: Person, y: TaxableYear, p: us.irc.core::Asset, price: Money) strict {
    label en official "the net selling price asserted by the aggregate fact of module 5";
    when net_selling_price(t, y, p, price);
    then net_selling_price_857b6(t, y, p, price);
}
pub relation expenditure_limit_met_857b6C(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the aggregate expenditures do not exceed 30 percent of the net selling price (clause (C)(ii))";
}
@source(IRC_S857_B, quote = "do not exceed 30 percent of the net selling price of the property")
rule Section857b6CiiLimitByAggregateFact(t: Person, y: TaxableYear, p: us.irc.core::Asset, expenditures: Money, price: Money) strict {
    label en official "section 857(b)(6)(C)(ii): the aggregate expenditures asserted by module 5 are at most 30 percent of the net selling price";
    when two_year_capitalized_expenditures(t, y, p, expenditures);
    when net_selling_price_857b6(t, y, p, price);
    when expenditures * 100 <= price * 30;
    then expenditure_limit_met_857b6C(t, y, p);
}
@source(IRC_S857_B, quote = "do not exceed 30 percent of the net selling price of the property")
rule Section857b6CiiLimitByItems(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money, price: Money) defeasible {
    label en official "section 857(b)(6)(C)(ii): the itemised counted expenditures are at most 30 percent of the net selling price";
    when counted_expenditure_total_857b6C(t, y, p, total);
    when net_selling_price_857b6(t, y, p, price);
    when total * 100 <= price * 30;
    then expenditure_limit_met_857b6C(t, y, p);
}
@source(IRC_S857_B, quote = "do not exceed 30 percent of the net selling price of the property")
rule Section857b6CiiNoCountedExpenditure(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) defeasible {
    label en official "section 857(b)(6)(C)(ii): no expenditure is taken into account, so the limit is met";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when not_known(has_counted_expenditure_857b6(t, y, p));
    then expenditure_limit_met_857b6C(t, y, p);
}
pub relation timber_expenditure_limit_met_857b6D(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the capitalized timber-related expenditures do not exceed 30 percent of the net selling price (clause (D)(ii))";
}
@source(IRC_S857_B, quote = "do not exceed 30 percent of the net selling price of the property")
rule Section857b6DiiLimit(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money, price: Money) defeasible {
    label en official "section 857(b)(6)(D)(ii): at most 30 percent of the net selling price";
    when counted_timber_expenditure_total_857b6D(t, y, p, total);
    when net_selling_price_857b6(t, y, p, price);
    when total * 100 <= price * 30;
    then timber_expenditure_limit_met_857b6D(t, y, p);
}
rule Section857b6DiiNoTimberExpenditure(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) defeasible {
    label en official "section 857(b)(6)(D)(ii): no timber-related expenditure counts, so the limit is met";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when not_known(has_counted_expenditure_857b6(t, y, p));
    then timber_expenditure_limit_met_857b6D(t, y, p);
}
pub relation other_expenditure_limit_met_857b6D(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the capitalized other expenditures do not exceed 5 percent of the net selling price (clause (D)(iii))";
}
@source(IRC_S857_B, quote = "do not exceed 5 percent of the net selling price of the property")
rule Section857b6DiiiLimit(t: Person, y: TaxableYear, p: us.irc.core::Asset, total: Money, price: Money) defeasible {
    label en official "section 857(b)(6)(D)(iii): at most 5 percent of the net selling price";
    when counted_other_expenditure_total_857b6D(t, y, p, total);
    when net_selling_price_857b6(t, y, p, price);
    when total * 100 <= price * 5;
    then other_expenditure_limit_met_857b6D(t, y, p);
}
rule Section857b6DiiiNoOtherExpenditure(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) defeasible {
    label en official "section 857(b)(6)(D)(iii): no other expenditure counts, so the limit is met";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when not_known(has_counted_expenditure_857b6(t, y, p));
    then other_expenditure_limit_met_857b6D(t, y, p);
}

// ---- Section 857(b)(6)(E)(vi)-(vii): what is a sale ----

pub relation counted_sale_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "a sale that counts for the volume tests: not a sale of foreclosure property, not a section 1033 sale, and with a net selling price of at least $10,000 (a transaction below $10,000 is not a sale)";
}
@source(IRC_S857_B, quote = "The term \"sale\" does not include any transaction in which the net selling price is less than $10,000.")
rule Section857b6EviiCountedSale(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) defeasible {
    label en official "section 857(b)(6)(E)(vii) with (C)(iii)(I): a sale (net selling price at least $10,000) other than of foreclosure property or under section 1033";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when price >= 10000.00 USD;
    when not_known(sale_of_foreclosure_property_857b6(t, y, p));
    when not_known(sale_to_which_section_1033_applies_857b6(t, y, p));
    then counted_sale_857b6(t, y, p);
}
pub relation counted_sale_transaction_857b6(t: Person, y: TaxableYear, txn: us.irc.core::Transaction) kind institutional {
    label en official "a transaction that constitutes one counted sale (the sale of several properties to one buyer as part of one transaction is one sale)";
}
@source(IRC_S857_B, quote = "The sale of more than one property to one buyer as part of one transaction constitutes one sale.")
rule Section857b6EviOneSalePerTransaction(t: Person, y: TaxableYear, p: us.irc.core::Asset, txn: us.irc.core::Transaction) defeasible {
    label en official "section 857(b)(6)(E)(vi): the counted sales of one transaction are one sale";
    when counted_sale_857b6(t, y, p);
    when sale_transaction_857b6Evi(t, y, p, txn);
    then counted_sale_transaction_857b6(t, y, txn);
}
pub relation counted_sales_number_857b6(t: Person, y: TaxableYear, n: Integer) kind institutional {
    label en official "the number of sales the trust makes in the taxable year (a count over derived transactions, TECH-GAPS G4903)";
}
rule Section857b6CountSales(t: Person, y: TaxableYear, anchor: us.irc.core::Transaction) defeasible {
    label en official "section 857(b)(6)(C)(iii)(I): the number of counted sales";
    when counted_sale_transaction_857b6(t, y, anchor);
    then counted_sales_number_857b6(t, y, count(collect txn: us.irc.core::Transaction where counted_sale_transaction_857b6(t, y, txn)));
}
pub relation has_counted_sale_857b6(t: Person, y: TaxableYear) kind institutional {
    label en official "at least one counted sale exists in the year";
}
rule Section857b6HasCountedSale(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "helper: some counted sale exists";
    when counted_sale_857b6(t, y, p);
    then has_counted_sale_857b6(t, y);
}

// ---- Section 857(b)(6)(C)(iii), (D)(iv): the volume tests ----

pub relation sold_adjusted_bases_total_857b6(t: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the aggregate adjusted bases (for earnings and profits) of the counted property sold in the year";
}
rule Section857b6SoldBasesFromItems(t: Person, y: TaxableYear, anchor: us.irc.core::Asset) defeasible {
    label en official "clauses (C)(iii)(II), (D)(iv)(II): the sum of adjusted bases of counted sales";
    when counted_sale_857b6(t, y, anchor);
    then sold_adjusted_bases_total_857b6(t, y, sum all basis: Money for q: us.irc.core::Asset where counted_sale_857b6(t, y, q) and sold_property_adjusted_basis_857b6(t, y, q, basis));
}
rule Section857b6SoldBasesFromAggregateFact(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "the aggregate adjusted bases asserted by module 5";
    when aggregate_adjusted_bases_of_qualifying_property_sold(t, y, amount);
    then sold_adjusted_bases_total_857b6(t, y, amount);
}
pub relation sold_fair_market_value_total_857b6(t: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the fair market value of the counted property sold in the year";
}
rule Section857b6SoldFmvFromItems(t: Person, y: TaxableYear, anchor: us.irc.core::Asset) defeasible {
    label en official "clauses (C)(iii)(III), (D)(iv)(III): the sum of fair market values of counted sales";
    when counted_sale_857b6(t, y, anchor);
    then sold_fair_market_value_total_857b6(t, y, sum all fmv: Money for q: us.irc.core::Asset where counted_sale_857b6(t, y, q) and sold_property_fair_market_value_857b6(t, y, q, fmv));
}
pub relation sales_count_test_met_857b6iiiI(t: Person, y: TaxableYear) kind institutional {
    label en official "during the taxable year the trust does not make more than 7 sales (clause (C)(iii)(I) or (D)(iv)(I))";
}
@source(IRC_S857_B, quote = "during the taxable year the trust does not make more than 7 sales of property (other than sales of foreclosure property or sales to which section 1033 applies)")
rule Section857b6iiiIByCount(t: Person, y: TaxableYear, n: Integer) defeasible {
    label en official "clause (iii)(I): at most 7 counted sales";
    when counted_sales_number_857b6(t, y, n);
    when n <= 7;
    then sales_count_test_met_857b6iiiI(t, y);
}
rule Section857b6iiiIByAggregateFact(t: Person, y: TaxableYear, n: Integer) strict {
    label en official "clause (iii)(I): the number of sales asserted by module 5 is at most 7";
    when number_of_qualifying_sales_in_year(t, y, n);
    when n <= 7;
    then sales_count_test_met_857b6iiiI(t, y);
}
rule Section857b6iiiINoSale(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money) defeasible {
    label en official "clause (iii)(I): the sale being tested is the only sale and it does not count (a counted-sale number of zero is at most 7)";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when not_known(has_counted_sale_857b6(t, y));
    then sales_count_test_met_857b6iiiI(t, y);
}
pub relation sold_bases_at_most_10_percent_857b6iiiII(t: Person, y: TaxableYear) kind institutional {
    label en official "the adjusted bases of the property sold do not exceed 10 percent of the bases of all the trust's assets at the beginning of the year (clause (C)(iii)(II) or (D)(iv)(II))";
}
@source(IRC_S857_B, quote = "does not exceed 10 percent of the aggregate bases (as so determined) of all of the assets of the trust as of the beginning of the taxable year")
rule Section857b6iiiII(t: Person, y: TaxableYear, sold: Money, all_bases: Money) defeasible {
    label en official "clause (iii)(II): sold bases at most 10 percent of all bases at the beginning of the year (exact cross-multiplication)";
    when sold_adjusted_bases_total_857b6(t, y, sold);
    when aggregate_adjusted_bases_of_all_trust_assets_at_beginning_of_year(t, y, all_bases);
    when sold * 100 <= all_bases * 10;
    then sold_bases_at_most_10_percent_857b6iiiII(t, y);
}
pub relation sold_fmv_at_most_10_percent_857b6iiiIII(t: Person, y: TaxableYear) kind institutional {
    label en official "the fair market value of the property sold does not exceed 10 percent of that of all the trust's assets at the beginning of the year (clause (C)(iii)(III) or (D)(iv)(III))";
}
@source(IRC_S857_B, quote = "does not exceed 10 percent of the fair market value of all of the assets of the trust as of the beginning of the taxable year")
rule Section857b6iiiIII(t: Person, y: TaxableYear, sold: Money, all_fmv: Money) defeasible {
    label en official "clause (iii)(III): sold fair market value at most 10 percent of all assets' value at the beginning of the year";
    when sold_fair_market_value_total_857b6(t, y, sold);
    when all_assets_fair_market_value_at_year_start_857b6(t, y, all_fmv);
    when sold * 100 <= all_fmv * 10;
    then sold_fmv_at_most_10_percent_857b6iiiIII(t, y);
}
// (G), (H): the 3-year averages
pub relation three_year_period_year_857b6GH(y: TaxableYear, member: TaxableYear) kind empirical {
    label en unofficial "the member is one of the 3 taxable years ending with the year (the year itself included; asserted, the core has no year successor, TECH-GAPS G2201)";
}
pub relation all_assets_adjusted_bases_at_year_start_857b6(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted bases of all the trust's assets at the beginning of the year";
}
rule Section857b6AllBasesFromFact(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "the aggregate fact of module 5";
    when aggregate_adjusted_bases_of_all_trust_assets_at_beginning_of_year(t, y, amount);
    then all_assets_adjusted_bases_at_year_start_857b6(t, y, amount);
}
@source(IRC_S857_B, quote = "the aggregate adjusted bases (as determined for purposes of computing earnings and profits) of property (other than sales of foreclosure property or sales to which section 1033 applies) sold during the 3 taxable year period ending with such taxable year, divided by")
pub relation three_year_average_adjusted_bases_857b6G(t: Person, y: TaxableYear, sold_three_years: Money, bases_three_years: Money) kind institutional {
    label en official "the numerator (bases of counted property sold in the 3-year period) and denominator (sum of the bases of all assets at the beginning of each of the 3 years) of the 3-year average adjusted bases percentage";
}
@source(IRC_S857_B, quote = "the sum of the aggregate adjusted bases (as so determined) of all of the assets of the trust as of the beginning of each of the 3 taxable years which are part of the period referred to in clause (i).")
rule Section857b6G(t: Person, y: TaxableYear, member: TaxableYear, anchor: Money) defeasible {
    label en official "section 857(b)(6)(G): numerator and denominator of the 3-year average adjusted bases percentage";
    when three_year_period_year_857b6GH(y, member);
    when all_assets_adjusted_bases_at_year_start_857b6(t, y, anchor);
    then three_year_average_adjusted_bases_857b6G(t, y, sum all amount: Money for yy: TaxableYear where three_year_period_year_857b6GH(y, yy) and sold_adjusted_bases_total_857b6(t, yy, amount), sum all amount: Money for yy: TaxableYear where three_year_period_year_857b6GH(y, yy) and all_assets_adjusted_bases_at_year_start_857b6(t, yy, amount));
}
@source(IRC_S857_B, quote = "the fair market value of property (other than sales of foreclosure property or sales to which section 1033 applies) sold during the 3 taxable year period ending with such taxable year, divided by")
pub relation three_year_average_fair_market_value_857b6H(t: Person, y: TaxableYear, sold_three_years: Money, value_three_years: Money) kind institutional {
    label en official "the numerator and denominator of the 3-year average fair market value percentage";
}
@source(IRC_S857_B, quote = "the sum of the fair market value of all of the assets of the trust as of the beginning of each of the 3 taxable years which are part of the period referred to in clause (i).")
rule Section857b6H(t: Person, y: TaxableYear, member: TaxableYear, anchor: Money) defeasible {
    label en official "section 857(b)(6)(H): numerator and denominator of the 3-year average fair market value percentage";
    when three_year_period_year_857b6GH(y, member);
    when all_assets_fair_market_value_at_year_start_857b6(t, y, anchor);
    then three_year_average_fair_market_value_857b6H(t, y, sum all amount: Money for yy: TaxableYear where three_year_period_year_857b6GH(y, yy) and sold_fair_market_value_total_857b6(t, yy, amount), sum all amount: Money for yy: TaxableYear where three_year_period_year_857b6GH(y, yy) and all_assets_fair_market_value_at_year_start_857b6(t, yy, amount));
}
pub relation sold_bases_at_most_20_percent_and_three_year_at_most_10_857b6iiiIV(t: Person, y: TaxableYear) kind institutional {
    label en official "clause (C)(iii)(IV) or (D)(iv)(IV): the (II) test with 20 percent, and the 3-year average adjusted bases percentage at most 10 percent";
}
@source(IRC_S857_B, quote = "the trust satisfies the requirements of subclause (II) applied by substituting \"20 percent\" for \"10 percent\" and the 3-year average adjusted bases percentage for the taxable year (as defined in subparagraph (G)) does not exceed 10 percent")
rule Section857b6iiiIV(t: Person, y: TaxableYear, sold: Money, all_bases: Money, sold3: Money, bases3: Money) defeasible {
    label en official "clause (iii)(IV): at most 20 percent this year and at most 10 percent on the 3-year average (exact cross-multiplication)";
    when sold_adjusted_bases_total_857b6(t, y, sold);
    when all_assets_adjusted_bases_at_year_start_857b6(t, y, all_bases);
    when sold * 100 <= all_bases * 20;
    when three_year_average_adjusted_bases_857b6G(t, y, sold3, bases3);
    when sold3 * 100 <= bases3 * 10;
    then sold_bases_at_most_20_percent_and_three_year_at_most_10_857b6iiiIV(t, y);
}
pub relation sold_fmv_at_most_20_percent_and_three_year_at_most_10_857b6iiiV(t: Person, y: TaxableYear) kind institutional {
    label en official "clause (C)(iii)(V) or (D)(iv)(V): the (III) test with 20 percent, and the 3-year average fair market value percentage at most 10 percent";
}
@source(IRC_S857_B, quote = "the trust satisfies the requirements of subclause (III) applied by substituting \"20 percent\" for \"10 percent\" and the 3-year average fair market value percentage for the taxable year (as defined in subparagraph (H)) does not exceed 10 percent")
rule Section857b6iiiV(t: Person, y: TaxableYear, sold: Money, all_fmv: Money, sold3: Money, value3: Money) defeasible {
    label en official "clause (iii)(V): at most 20 percent this year and at most 10 percent on the 3-year average";
    when sold_fair_market_value_total_857b6(t, y, sold);
    when all_assets_fair_market_value_at_year_start_857b6(t, y, all_fmv);
    when sold * 100 <= all_fmv * 20;
    when three_year_average_fair_market_value_857b6H(t, y, sold3, value3);
    when sold3 * 100 <= value3 * 10;
    then sold_fmv_at_most_20_percent_and_three_year_at_most_10_857b6iiiV(t, y);
}
pub relation sales_volume_other_branch_met_857b6(t: Person, y: TaxableYear) kind institutional {
    label en official "one of the branches (II)-(V) of the volume test is met (branch (I), the count, is separate: clause (v) applies when it is not met)";
}
rule Section857b6VolumeBranchII(t: Person, y: TaxableYear) defeasible {
    label en official "branch (II)";
    when sold_bases_at_most_10_percent_857b6iiiII(t, y);
    then sales_volume_other_branch_met_857b6(t, y);
}
rule Section857b6VolumeBranchIII(t: Person, y: TaxableYear) defeasible {
    label en official "branch (III)";
    when sold_fmv_at_most_10_percent_857b6iiiIII(t, y);
    then sales_volume_other_branch_met_857b6(t, y);
}
rule Section857b6VolumeBranchIV(t: Person, y: TaxableYear) defeasible {
    label en official "branch (IV)";
    when sold_bases_at_most_20_percent_and_three_year_at_most_10_857b6iiiIV(t, y);
    then sales_volume_other_branch_met_857b6(t, y);
}
rule Section857b6VolumeBranchV(t: Person, y: TaxableYear) defeasible {
    label en official "branch (V)";
    when sold_fmv_at_most_20_percent_and_three_year_at_most_10_857b6iiiV(t, y);
    then sales_volume_other_branch_met_857b6(t, y);
}

// ---- Clauses (C)(iv), (C)(v), (D)(v): rental holding and marketing ----

pub relation rental_holding_requirement_met_857b6Civ(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "clause (C)(iv): land or improvements not acquired through foreclosure or lease termination were held for not less than 2 years for the production of rental income (other property: the clause does not apply)";
}
@source(IRC_S857_B, quote = "in the case of property, which consists of land or improvements, not acquired through foreclosure (or deed in lieu of foreclosure), or lease termination, the trust has held the property for not less than 2 years for production of rental income")
rule Section857b6CivNotLand(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "clause (C)(iv) does not apply to property that is not land or improvements";
    when held_two_years_857b6(t, y, p);
    when not_known(property_is_land_or_improvements_857b6Civ(p));
    then rental_holding_requirement_met_857b6Civ(t, y, p);
}
rule Section857b6CivForeclosureLand(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "clause (C)(iv) does not apply to land or improvements acquired through foreclosure or lease termination";
    when held_two_years_857b6(t, y, p);
    when property_is_land_or_improvements_857b6Civ(p);
    when property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p);
    then rental_holding_requirement_met_857b6Civ(t, y, p);
}
rule Section857b6CivRentalByDates(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money, since: Date) defeasible {
    label en official "clause (C)(iv): held for the production of rental income for 2 calendar years before the sale";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when property_is_land_or_improvements_857b6Civ(p);
    when not_known(property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p));
    when held_for_rental_income_since_857b6Civ(t, p, since);
    when add_calendar_period(since, 24 calendar_month) <= sold_on;
    then rental_holding_requirement_met_857b6Civ(t, y, p);
}
rule Section857b6CivRentalByAggregateFact(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "clause (C)(iv): the aggregate fact that the land was held 2 years for rental income";
    when property_is_land_or_improvements_857b6Civ(p);
    when not_known(property_acquired_by_foreclosure_or_lease_termination_857b6E(t, p));
    when held_for_rental_income_two_years_857b6Civ(t, y, p);
    then rental_holding_requirement_met_857b6Civ(t, y, p);
}
pub relation marketing_through_contractor_or_trs_857b6(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "substantially all of the marketing (and development) expenditures were made through an independent contractor from whom the trust derives no income, or through a taxable REIT subsidiary (clauses (C)(v), (D)(v))";
}
@source(IRC_S857_B, quote = "through an independent contractor (as defined in section 856(d)(3)) from whom the trust itself does not derive or receive any income")
rule Section857b6vIndependentContractor(t: Person, y: TaxableYear, p: us.irc.core::Asset, via: Person) defeasible {
    label en official "clauses (C)(v), (D)(v): through an independent contractor of section 856(d)(3) from whom the trust derives no income";
    when substantially_all_marketing_expenditures_through_857b6(t, y, p, via);
    when independent_contractor_856d3(via, t);
    when not_known(trust_derives_income_from_contractor_856d7Ci(t, via));
    then marketing_through_contractor_or_trs_857b6(t, y, p);
}
@source(IRC_S857_B, quote = "through an independent contractor (as defined in section 856(d)(3)) from whom the trust itself does not derive or receive any income, or a taxable REIT subsidiary")
rule Section857b6vTaxableReitSubsidiary(t: Person, y: TaxableYear, p: us.irc.core::Asset, via: Corporation) defeasible {
    label en official "clauses (C)(v), (D)(v): through a taxable REIT subsidiary of the trust";
    when substantially_all_marketing_expenditures_through_857b6(t, y, p, via);
    when is_taxable_reit_subsidiary_856l(via, t);
    then marketing_through_contractor_or_trs_857b6(t, y, p);
}

// ---- Section 857(b)(6)(C), (D): the safe harbors ----

pub relation safe_harbor_857b6C(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the sale of the real estate asset is not a prohibited transaction under the general safe harbor of subparagraph (C)";
}
@source(IRC_S857_B, quote = "For purposes of this part, the term \"prohibited transaction\" does not include a sale of property which is a real estate asset (as defined in section 856(c)(5)(B)) if")
rule Section857b6CByCount(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(C): the 2-year hold, the 30 percent limit, the rental holding period, and at most 7 sales";
    when held_two_years_857b6(t, y, p);
    when expenditure_limit_met_857b6C(t, y, p);
    when sales_count_test_met_857b6iiiI(t, y);
    when rental_holding_requirement_met_857b6Civ(t, y, p);
    then safe_harbor_857b6C(t, y, p);
}
@source(IRC_S857_B, quote = "if the requirement of clause (iii)(I) is not satisfied, substantially all of the marketing and development expenditures with respect to the property were made through an independent contractor")
rule Section857b6CByVolumeAndMarketing(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(C): the (iii)(II)-(V) branches, with clause (v) because the count branch (I) is not met";
    when held_two_years_857b6(t, y, p);
    when expenditure_limit_met_857b6C(t, y, p);
    when sales_volume_other_branch_met_857b6(t, y);
    when not_known(sales_count_test_met_857b6iiiI(t, y));
    when rental_holding_requirement_met_857b6Civ(t, y, p);
    when marketing_through_contractor_or_trs_857b6(t, y, p);
    then safe_harbor_857b6C(t, y, p);
}
pub relation safe_harbor_857b6D(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the sale of the real estate asset is not a prohibited transaction under the timber safe harbor of subparagraph (D)";
}
@source(IRC_S857_B, quote = "the trust held the property for not less than 2 years in connection with the trade or business of producing timber")
rule Section857b6DByCount(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(D): timber held 2 years, the 30 percent and 5 percent limits, at most 7 sales, price not based on income or profits";
    when held_two_years_857b6(t, y, p);
    when held_in_connection_with_timber_business_857b6Di(t, p);
    when timber_expenditure_limit_met_857b6D(t, y, p);
    when other_expenditure_limit_met_857b6D(t, y, p);
    when sales_count_test_met_857b6iiiI(t, y);
    when not_known(sale_price_based_on_income_or_profits_857b6Dvi(t, y, p));
    then safe_harbor_857b6D(t, y, p);
}
@source(IRC_S857_B, quote = "in the case that the requirement of clause (iv)(I) is not satisfied, substantially all of the marketing expenditures with respect to the property were made through an independent contractor")
rule Section857b6DByVolumeAndMarketing(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(D): the (iv)(II)-(V) branches, with clause (v) because the count branch (iv)(I) is not met";
    when held_two_years_857b6(t, y, p);
    when held_in_connection_with_timber_business_857b6Di(t, p);
    when timber_expenditure_limit_met_857b6D(t, y, p);
    when other_expenditure_limit_met_857b6D(t, y, p);
    when sales_volume_other_branch_met_857b6(t, y);
    when not_known(sales_count_test_met_857b6iiiI(t, y));
    when marketing_through_contractor_or_trs_857b6(t, y, p);
    when not_known(sale_price_based_on_income_or_profits_857b6Dvi(t, y, p));
    then safe_harbor_857b6D(t, y, p);
}
@source(IRC_S857_B, quote = "the term \"prohibited transaction\" does not include a sale of property which is a real estate asset")
rule Section857b6SafeHarborCBlocksTax(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(C): a sale within the general safe harbor is not a prohibited transaction, so the 100 percent tax is not imposed (the tax rule of module 5 reads this year-level relation)";
    when safe_harbor_857b6C(t, y, p);
    then sale_within_prohibited_transaction_safe_harbor(t, y);
}
@source(IRC_S857_B, quote = "the term \"prohibited transaction\" does not include a sale of property which is a real estate asset")
rule Section857b6SafeHarborDBlocksTax(t: Person, y: TaxableYear, p: us.irc.core::Asset) defeasible {
    label en official "section 857(b)(6)(D): a sale within the timber safe harbor is not a prohibited transaction";
    when safe_harbor_857b6D(t, y, p);
    then sale_within_prohibited_transaction_safe_harbor(t, y);
}

// ---- Section 857(b)(6)(J), (I): the termination date and the effect on dealer status ----

@source(IRC_S856_C, quote = "the term \"termination date\" means, with respect to any taxpayer, the last day of the taxpayer's first taxable year beginning after the date of the enactment of this paragraph and before the date that is 1 year after such date of enactment")
pub relation taxable_year_of_taxpayer_857b6J(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year is a taxable year of the taxpayer";
}
pub relation year_in_termination_window_857b6J(t: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year begins after July 30, 2008 (the enactment of section 856(c)(10), Pub. L. 110-289) and before July 30, 2009";
}
@source(IRC_S856_NOTE_6, quote = "shall apply to taxable years beginning after the date of the enactment of this Act [July 30, 2008]")
rule Section857b6JYearInWindow(t: Person, y: TaxableYear, begins_on: Date) strict {
    label en official "section 856(c)(10): a taxable year beginning after the enactment date (2008-07-30) and before the date one year after it (2009-07-30)";
    when taxable_year_of_taxpayer_857b6J(t, y);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2008-07-30;
    when begins_on < @2009-07-30;
    then year_in_termination_window_857b6J(t, y);
}
pub relation earlier_year_in_termination_window_857b6J(t: Person, y: TaxableYear) kind institutional {
    label en official "an earlier taxable year of the taxpayer is also in the window";
}
rule Section857b6JEarlierYear(t: Person, y: TaxableYear, other: TaxableYear, b1: Date, b2: Date) strict {
    label en official "no earliest-of aggregate exists (TECH-GAPS G136): a strictly earlier window year is derived";
    when year_in_termination_window_857b6J(t, y);
    when year_in_termination_window_857b6J(t, other);
    when us.irc.core::begins(y, b1);
    when us.irc.core::begins(other, b2);
    when b2 < b1;
    then earlier_year_in_termination_window_857b6J(t, y);
}
@source(IRC_S857_B, quote = "For purposes of this paragraph, the term \"termination date\" has the meaning given such term by section 856(c)(10).")
pub relation termination_date_857b6J(t: Person, date: Date) kind institutional {
    label en official "the termination date: the last day of the taxpayer's first taxable year beginning after July 30, 2008 and before July 30, 2009";
}
rule Section857b6JTerminationDate(t: Person, y: TaxableYear, ends_on: Date) strict {
    label en official "section 856(c)(10) with section 857(b)(6)(J): the last day of the first such taxable year";
    when year_in_termination_window_857b6J(t, y);
    when not_known(earlier_year_in_termination_window_857b6J(t, y));
    when us.irc.core::ends(y, ends_on);
    then termination_date_857b6J(t, ends_on);
}
pub relation sale_not_prohibited_through_d_before_2008_857b6I(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the sale is not a prohibited transaction through the application of subparagraph (D) as in effect on the day before the enactment of the Housing Assistance Tax Act of 2008, as modified by subparagraph (G) as so in effect (that text is superseded and not pinned in this package; asserted, TECH-GAPS G4905)";
}
pub relation treated_as_investment_property_857b6I(t: Person, y: TaxableYear, p: us.irc.core::Asset) kind institutional {
    label en official "the property sold is considered property held for investment or for use in a trade or business and not property described in section 1221(a)(1) for all purposes of the subtitle";
}
@source(IRC_S857_B, quote = "In the case of a sale on or before the termination date, the sale of property which is not a prohibited transaction through the application of subparagraph (D) shall be considered property held for investment or for use in a trade or business and not property described in section 1221(a)(1) for all purposes of this subtitle.")
rule Section857b6IInvestmentProperty(t: Person, y: TaxableYear, p: us.irc.core::Asset, sold_on: Date, price: Money, termination: Date) defeasible {
    label en official "section 857(b)(6)(I): a sale on or before the termination date that is not a prohibited transaction through (D) as in effect before 2008 makes the property investment property, not section 1221(a)(1) property";
    when reit_sale_857b6(t, y, p, sold_on, price);
    when termination_date_857b6J(t, termination);
    when sold_on <= termination;
    when sale_not_prohibited_through_d_before_2008_857b6I(t, y, p);
    then treated_as_investment_property_857b6I(t, y, p);
}
