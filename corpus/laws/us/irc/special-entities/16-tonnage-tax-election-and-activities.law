// Sections 1354(c)-(e), 1355(b)-(g), 1356, 1357, 1358, 1359 (Subchapter R,
// tonnage tax: the election's group and revocation rules, termination and
// re-election bar, the operating/shipping-activity definitions, the
// temporary-cessation notices, qualifying shipping activities, the
// exclusion and the disallowance rules, the separate-activity/482 rules
// and the replacement-vessel nonrecognition election). Stage 2c
// (IRC-09 stage 2c, A12), 26.09.2026. Status implemented_unverified: not
// executed.
//
// METHOD. Figures the statute measures over a taxable year (gross income
// per class of shipping activity, fair market values, tonnage averages) are
// case-asserted `empirical` facts: this package does not own the ledger they
// come from. Every ratio is one `div_round` (TECH-GAPS G499). A revocation,
// an election and a replacement-vessel election are `power`s (E-0239: an
// invalid exercise gives POWER_INVALID_EXERCISE and no effect); the date on
// which a revocation bites is a separate derived relation, because the
// power's effect (the election is revoked) and its timing (sec. 1354(d)(1)(B)-(C))
// are two different legal facts. "Earlier of two dates" (sec. 1355(e)(3),
// (f)(3), (g)(2)(C)) uses the candidates-plus-no-earlier-candidate form of
// TECH-GAPS G136. The Secretary's rule-making delegations are not modelled
// as executable rules (EXTERNAL_DEPENDENCY rows).

// ---- Section 1354(b): timely election ----

use self::{
    Corporation,
    IRC_S1354_B,
    IRC_S1354_C,
    IRC_S1354_D,
    IRC_S1354_E,
    IRC_S1355_A,
    IRC_S1355_B,
    IRC_S1355_C,
    IRC_S1355_D,
    IRC_S1355_E,
    IRC_S1355_F,
    IRC_S1355_G,
    IRC_S1356_A,
    IRC_S1356_C,
    IRC_S1356_D,
    IRC_S1357_A,
    IRC_S1357_B,
    IRC_S1357_C,
    IRC_S1358_A,
    IRC_S1358_B,
    IRC_S1359_A,
    IRC_S1359_B,
    IRC_S1359_D,
    IRC_S1359_E,
    Person,
    TaxableYear,
    electing_corporation_1355a1,
    elects_tonnage_tax_1354,
    is_in_electing_group_1356e,
    qualifying_vessel_operator_1355a3,
};

pub relation tonnage_election_made_on_1354b(c: Corporation, y: TaxableYear, made_on: Date) kind empirical {
    label en unofficial "the election under subchapter R is made on this date, for the taxable year";
}
pub relation return_due_date_with_extensions_1354b(c: Corporation, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the due date (including extensions) for filing the corporation's return for the taxable year";
}
pub relation election_timely_1354b(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the election is made on or before the due date, including extensions, for the return for the taxable year, so it may be effective for that year";
}
@source(IRC_S1354_B, quote = "Such election may be effective for any taxable year only if made on or before the due date (including extensions) for filing the corporation's return for such taxable year.")
rule Section1354b4TimelyElection(c: Corporation, y: TaxableYear, made_on: Date, due: Date) strict {
    label en official "section 1354(b): the election is effective for a year only if made by the return due date, including extensions";
    when tonnage_election_made_on_1354b(c, y, made_on);
    when return_due_date_with_extensions_1354b(c, y, due);
    when made_on <= due;
    then election_timely_1354b(c, y);
}

// ---- Section 1354(c): controlled-group election ----

@source(IRC_S1354_C, quote = "An election under subsection (a) by a member of a controlled group shall apply to all qualifying vessel operators that are members of such group.")
pub relation controlled_group_member_1354c(c: Corporation, d: Corporation) kind empirical {
    label en unofficial "d is a qualifying vessel operator that is a member of the same controlled group as c, per section 1354(c)";
}
@source(IRC_S1354_C, quote = "shall apply to all qualifying vessel operators that are members of such group")
pub relation election_applies_to_group_member_1354c(d: Corporation, y: TaxableYear) kind institutional {
    label en official "the section 1354(a) election made by another member of the controlled group applies to this qualifying vessel operator for the taxable year";
}
rule Section1354cElectionBindsControlledGroup(c: Corporation, d: Corporation, y: TaxableYear) strict {
    label en official "section 1354(c): an election by a member of a controlled group applies to all qualifying vessel operators that are members of the group";
    when elects_tonnage_tax_1354(c, y);
    when controlled_group_member_1354c(c, d);
    when qualifying_vessel_operator_1355a3(d);
    then election_applies_to_group_member_1354c(d, y);
}

// ---- Section 1354(d)(1): revocation ----

@source(IRC_S1354_D, quote = "An election under subsection (a) may be terminated by revocation.")
pub relation revokes_tonnage_election_1354d1(c: Corporation, y: TaxableYear, made_on: Date) kind empirical {
    label en unofficial "the electing corporation revokes its section 1354(a) election on the date, during the taxable year, per section 1354(d)(1)(A)";
}
pub relation tonnage_election_revocation_made(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "a revocation of the section 1354(a) election was made during the taxable year (gate atom for the power, derived from the dated fact by the case)";
}
pub relation revocation_specifies_date_1354d1c(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the revocation specifies a date for revocation that is on or after the day it is made, per section 1354(d)(1)(C)";
}
pub relation revocation_specified_date_1354d1c(c: Corporation, y: TaxableYear, specified: Date) kind empirical {
    label en unofficial "the date the revocation specifies, per section 1354(d)(1)(C)";
}
pub relation tonnage_election_revoked_1354d1(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the section 1354(a) election has been terminated by revocation made in the taxable year";
}
@source(IRC_S1354_D, quote = "An election under subsection (a) may be terminated by revocation.")
rule Section1354d1RevocationPower(c: Corporation, y: TaxableYear, made_on: Date) strict {
    label en official "section 1354(d)(1)(A): the electing corporation may revoke its election; a revocation without an election in effect is an invalid exercise";
    when revokes_tonnage_election_1354d1(c, y, made_on);
    when tonnage_election_revocation_made(c, y);
    then power TonnageTaxRevocation {
        holder c;
        over c;
        exercise revokes_tonnage_election_1354d1(c, y, made_on);
        valid_when electing_corporation_1355a1(c, y);
        effect create(tonnage_election_revoked_1354d1(c, y));
        window [@2004-10-22, infinity);
    };
}
pub relation revocation_effective_for_years_beginning_on_or_after_1354d1(c: Corporation, y: TaxableYear, from: Date) kind institutional {
    label en official "the revocation is effective for taxable years beginning on and after this date (sections 1354(d)(1)(B)-(C))";
}
// JUDGMENT CALL: "the 15th day of the 4th month" of the taxable year is
// begin + 3 calendar months + 14 days, which is the 15th only when the year
// begins on the 1st of a month (every calendar and ordinary fiscal year); a
// 52-53 week year beginning mid-month is TECH-GAPS G2200.
@source(IRC_S1354_D, quote = "a revocation made during the taxable year and on or before the 15th day of the 4th month thereof shall be effective on the 1st day of such taxable year")
rule Section1354d1BEarlyRevocation(c: Corporation, y: TaxableYear, made_on: Date, begins_on: Date) defeasible {
    label en official "section 1354(d)(1)(B)(i): a revocation made on or before the 15th day of the 4th month is effective on the 1st day of the taxable year";
    when revokes_tonnage_election_1354d1(c, y, made_on);
    when us.irc.core::begins(y, begins_on);
    when made_on >= begins_on;
    when made_on <= add_calendar_period(add_calendar_period(begins_on, 3 calendar_month), 14 calendar_day);
    when not_known(revocation_specifies_date_1354d1c(c, y));
    then revocation_effective_for_years_beginning_on_or_after_1354d1(c, y, begins_on);
}
@source(IRC_S1354_D, quote = "a revocation made during the taxable year but after such 15th day shall be effective on the 1st day of the following taxable year")
rule Section1354d1BLateRevocation(c: Corporation, y: TaxableYear, made_on: Date, begins_on: Date, ends_on: Date) defeasible {
    label en official "section 1354(d)(1)(B)(ii): a revocation made after that 15th day is effective on the 1st day of the following taxable year";
    when revokes_tonnage_election_1354d1(c, y, made_on);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    when made_on > add_calendar_period(add_calendar_period(begins_on, 3 calendar_month), 14 calendar_day);
    when made_on <= ends_on;
    when not_known(revocation_specifies_date_1354d1c(c, y));
    then revocation_effective_for_years_beginning_on_or_after_1354d1(c, y, add_calendar_period(ends_on, 1 calendar_day));
}
@source(IRC_S1354_D, quote = "If the revocation specifies a date for revocation which is on or after the day on which the revocation is made, the revocation shall be effective for taxable years beginning on and after the date so specified.")
rule Section1354d1CSpecifiedDate(c: Corporation, y: TaxableYear, made_on: Date, specified: Date) strict {
    label en official "section 1354(d)(1)(C): a specified date on or after the day of revocation governs the years beginning on and after it";
    when revokes_tonnage_election_1354d1(c, y, made_on);
    when revocation_specifies_date_1354d1c(c, y);
    when revocation_specified_date_1354d1c(c, y, specified);
    when specified >= made_on;
    then revocation_effective_for_years_beginning_on_or_after_1354d1(c, y, specified);
}

// ---- Section 1354(d)(2): termination on ceasing to be a qualifying vessel operator ----

pub relation first_electing_year_begins_on(c: Corporation, first_day: Date) kind empirical {
    label en unofficial "the first day of the first taxable year for which the corporation is an electing corporation (section 1354(d)(2)(A))";
}
pub relation ceases_to_be_qualifying_vessel_operator_on(c: Corporation, on: Date) kind empirical {
    label en unofficial "the corporation ceases to be a qualifying vessel operator on this date (section 1354(d)(2)(A))";
}
@source(IRC_S1354_D, quote = "An election under subsection (a) shall be terminated whenever (at any time on or after the 1st day of the 1st taxable year for which the corporation is an electing corporation) such corporation ceases to be a qualifying vessel operator.")
pub relation tonnage_election_terminated_from(c: Corporation, from: Date) kind institutional {
    label en official "the section 1354(a) election is terminated on and after the date of cessation (sections 1354(d)(2)(A)-(B))";
}
rule Section1354d2ACessationTerminatesElection(c: Corporation, first_day: Date, on: Date) strict {
    label en official "section 1354(d)(2)(A)-(B): the election terminates on and after the date the corporation ceases to be a qualifying vessel operator, if that date is on or after the first day of its first electing year";
    when first_electing_year_begins_on(c, first_day);
    when ceases_to_be_qualifying_vessel_operator_on(c, on);
    when on >= first_day;
    then tonnage_election_terminated_from(c, on);
}

// ---- Section 1354(e): five-year re-election bar ----

pub relation years_after_termination_year_1354e(c: Corporation, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "y is the ordinal-th taxable year beginning after the 1st taxable year for which the termination is effective (there is no core term for 'the nth taxable year after'; TECH-GAPS G2201)";
}
pub relation secretary_consents_to_reelection_1354e(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary consents to an election for the taxable year notwithstanding the bar of section 1354(e)";
}
pub relation reelection_barred_1354e(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the operator is not eligible to make a section 1354(a) election for the taxable year, being before its 5th taxable year beginning after the year of effective termination";
}
@source(IRC_S1354_E, quote = "shall not be eligible to make an election under subsection (a) for any taxable year before its 5th taxable year which begins after the 1st taxable year for which such termination is effective, unless the Secretary consents to such election")
rule Section1354eReelectionBar(c: Corporation, y: TaxableYear, ordinal: Integer) defeasible {
    label en official "section 1354(e): after a termination under (d), no election for any taxable year before the 5th taxable year beginning after the year the termination is effective, absent the Secretary's consent";
    when years_after_termination_year_1354e(c, y, ordinal);
    when ordinal < 5;
    then reelection_barred_1354e(c, y);
    unless secretary_consents_to_reelection_1354e(c, y);
}
pub relation eligible_to_elect_tonnage_tax_1354(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the qualifying vessel operator may make a section 1354(a) election for the taxable year (a qualifying vessel operator not barred by section 1354(e))";
}
rule Section1354aEligibleToElect(c: Corporation, y: TaxableYear) defeasible {
    label en official "section 1354(a) with (b) and (e): a qualifying vessel operator making a timely election is eligible unless barred by the re-election rule";
    when qualifying_vessel_operator_1355a3(c);
    when year_of_corporation_1354(c, y);
    when election_timely_1354b(c, y);
    then eligible_to_elect_tonnage_tax_1354(c, y);
    unless reelection_barred_1354e(c, y);
}
pub relation year_of_corporation_1354(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "y is a taxable year of the corporation (asserted bridge to us.irc.core::year_of for the eligibility gate)";
}

// ---- Section 1355(b): operating a vessel ----

pub relation vessel_owned_or_chartered_to_person_1355b1(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the vessel is owned by, or chartered (including a time charter) to, the person during the taxable year, per section 1355(b)(1)(A)(i)";
}
pub relation services_under_operating_agreement_1355b1(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the person provides services for the vessel pursuant to an operating agreement, per section 1355(b)(1)(A)(ii)";
}
pub relation vessel_in_use_as_qualifying_vessel_1355b1(v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the vessel is in use as a qualifying vessel during the period, per section 1355(b)(1)(B)";
}
pub relation chartered_out_on_bareboat_terms_1355b2(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the person has chartered the vessel out on bareboat charter terms, per section 1355(b)(2)";
}
pub relation temporarily_surplus_charter_term_years_1355b2A(p: Person, v: us.irc.core::Asset, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the vessel is temporarily surplus to the person's requirements and the charter term is this many years, per section 1355(b)(2)(A)(i)";
}
pub relation bareboat_chartered_within_controlled_group_1355b2(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the vessel is bareboat chartered to a member of the person's controlled group, or to an unrelated person who sub-bareboats or time charters it to such a member (including the owner), per section 1355(b)(2)(A)(ii)";
}
pub relation used_as_qualifying_vessel_by_ultimate_charterer_1355b2B(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the vessel is used as a qualifying vessel by the person to whom it is ultimately chartered, per section 1355(b)(2)(B)";
}
pub relation treated_as_operating_vessel_1355b(p: Person, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the person is treated as operating the vessel for the taxable year for the purposes of subchapter R";
}
@source(IRC_S1355_B, quote = "a person is treated as operating any vessel during any period if")
rule Section1355b1OwnedOrChartered(p: Person, v: us.irc.core::Asset, y: TaxableYear) defeasible {
    label en official "section 1355(b)(1)(A)(i),(B): the owner or charterer is treated as operating a vessel that is in use as a qualifying vessel, except a vessel it charters out bareboat (paragraph (2))";
    when vessel_owned_or_chartered_to_person_1355b1(p, v, y);
    when vessel_in_use_as_qualifying_vessel_1355b1(v, y);
    when not_known(chartered_out_on_bareboat_terms_1355b2(p, v, y));
    then treated_as_operating_vessel_1355b(p, v, y);
}
@source(IRC_S1355_B, quote = "the person provides services for such vessel pursuant to an operating agreement")
rule Section1355b1OperatingAgreement(p: Person, v: us.irc.core::Asset, y: TaxableYear) defeasible {
    label en official "section 1355(b)(1)(A)(ii),(B): the person providing services under an operating agreement is treated as operating a vessel in use as a qualifying vessel, except a vessel it charters out bareboat";
    when services_under_operating_agreement_1355b1(p, v, y);
    when vessel_in_use_as_qualifying_vessel_1355b1(v, y);
    when not_known(chartered_out_on_bareboat_terms_1355b2(p, v, y));
    then treated_as_operating_vessel_1355b(p, v, y);
}
@source(IRC_S1355_B, quote = "the vessel is temporarily surplus to the person's requirements and the term of the charter does not exceed 3 years")
rule Section1355b2ASurplusShortCharter(p: Person, v: us.irc.core::Asset, y: TaxableYear, years: Integer) strict {
    label en official "section 1355(b)(2)(A)(i),(B): a temporarily surplus vessel bareboat chartered out for no more than 3 years, used as a qualifying vessel by the ultimate charterer, is treated as operated and used by the person";
    when chartered_out_on_bareboat_terms_1355b2(p, v, y);
    when temporarily_surplus_charter_term_years_1355b2A(p, v, y, years);
    when years <= 3;
    when used_as_qualifying_vessel_by_ultimate_charterer_1355b2B(p, v, y);
    then treated_as_operating_vessel_1355b(p, v, y);
}
@source(IRC_S1355_B, quote = "the vessel is bareboat chartered to a member of a controlled group which includes such person or to an unrelated person who sub-bareboats or time charters the vessel to such a member")
rule Section1355b2AControlledGroupCharter(p: Person, v: us.irc.core::Asset, y: TaxableYear) strict {
    label en official "section 1355(b)(2)(A)(ii),(B): a vessel bareboat chartered within the controlled group and used as a qualifying vessel by the ultimate charterer is treated as operated and used by the person";
    when chartered_out_on_bareboat_terms_1355b2(p, v, y);
    when bareboat_chartered_within_controlled_group_1355b2(p, v, y);
    when used_as_qualifying_vessel_by_ultimate_charterer_1355b2B(p, v, y);
    then treated_as_operating_vessel_1355b(p, v, y);
}

// ---- Section 1355(c): shipping activity requirement ----

pub relation owned_or_bareboat_chartered_average_tonnage_1355c4(c: Corporation, y: TaxableYear, tons: Decimal) kind empirical {
    label en unofficial "the average aggregate tonnage, during the year, of qualifying vessels used by the corporation that it owned or had chartered to it on bareboat charter terms, per section 1355(c)(4)";
}
pub relation aggregate_average_tonnage_of_qualifying_vessels_used_1355c4(c: Corporation, y: TaxableYear, tons: Decimal) kind empirical {
    label en unofficial "the average aggregate tonnage, during the year, of all qualifying vessels used by the corporation, per section 1355(c)(4)";
}
@source(IRC_S1355_C, quote = "at least 25 percent of the aggregate tonnage of qualifying vessels used by the corporation were owned by such corporation or chartered to such corporation on bareboat charter terms")
pub relation shipping_activity_year_test_met_1355c4(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the requirement of section 1355(c)(4) is met for the taxable year";
}
rule Section1355c4TwentyFivePercentOwnedOrBareboat(c: Corporation, y: TaxableYear, owned: Decimal, aggregate: Decimal) strict {
    label en official "section 1355(c)(4): on average, at least 25 percent of the tonnage of qualifying vessels used was owned or bareboat chartered to the corporation";
    when owned_or_bareboat_chartered_average_tonnage_1355c4(c, y, owned);
    when aggregate_average_tonnage_of_qualifying_vessels_used_1355c4(c, y, aggregate);
    when owned * 100.0 >= aggregate * 25.0;
    when not_known(member_of_controlled_group_treated_as_one_person_1355c3(c, y));
    then shipping_activity_year_test_met_1355c4(c, y);
}
pub relation preceding_taxable_year_1355c(y: TaxableYear, previous: TaxableYear) kind empirical {
    label en unofficial "previous is the taxable year immediately preceding y (there is no preceding-year term in us.irc.core; TECH-GAPS G2201)";
}
pub relation first_electing_taxable_year_1355c2(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "y is the first taxable year for which the corporation's section 1354(a) election is in effect, per section 1355(c)(2)";
}
pub relation member_of_controlled_group_treated_as_one_person_1355c3(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the corporation is a member of a controlled group for the taxable year, so section 1355(c)(3) applies (the case then supplies the group-level tonnage figures under section 1355(c)(4) in place of its own)";
}
pub relation shipping_activity_requirement_met_1355c(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation meets the shipping activity requirement of section 1355(c) for the taxable year";
}
@source(IRC_S1355_C, quote = "a corporation meets the shipping activity requirement of this subsection for any taxable year only if the requirement of paragraph (4) is met for each of the 2 preceding taxable years")
rule Section1355c1TwoPrecedingYears(c: Corporation, y: TaxableYear, p1: TaxableYear, p2: TaxableYear) strict {
    label en official "section 1355(c)(1): the requirement of paragraph (4) is met for each of the 2 preceding taxable years";
    when preceding_taxable_year_1355c(y, p1);
    when preceding_taxable_year_1355c(p1, p2);
    when shipping_activity_year_test_met_1355c4(c, p1);
    when shipping_activity_year_test_met_1355c4(c, p2);
    then shipping_activity_requirement_met_1355c(c, y);
}
@source(IRC_S1355_C, quote = "for the first taxable year for which the election under section 1354(a) is in effect only if the requirement of paragraph (4) is met for the preceding taxable year")
rule Section1355c2FirstElectingYear(c: Corporation, y: TaxableYear, p1: TaxableYear) strict {
    label en official "section 1355(c)(2): for the first electing year the requirement of paragraph (4) need be met only for the preceding taxable year";
    when first_electing_taxable_year_1355c2(c, y);
    when preceding_taxable_year_1355c(y, p1);
    when shipping_activity_year_test_met_1355c4(c, p1);
    then shipping_activity_requirement_met_1355c(c, y);
}

pub relation operates_qualifying_vessels_1355a3A(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the corporation operates one or more qualifying vessels in the taxable year (section 1355(a)(3)(A))";
}
pub relation qualifying_vessel_operator_by_requirement_1355a3(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation is a qualifying vessel operator for the year: it operates qualifying vessels and meets the shipping activity requirement of subsection (c); the (a)(3) switch of module 15 stays an asserted classification";
}
@source(IRC_S1355_A, quote = "who meets the shipping activity requirement in subsection (c).")
rule Section1355a3QualifyingVesselOperatorByRequirement(c: Corporation, y: TaxableYear) strict {
    label en official "section 1355(a)(3)(A)-(B): operates qualifying vessels and meets the shipping activity requirement";
    when operates_qualifying_vessels_1355a3A(c, y);
    when shipping_activity_requirement_met_1355c(c, y);
    then qualifying_vessel_operator_by_requirement_1355a3(c, y);
}

// ---- Section 1355(d): partners ----

pub relation partnership_operates_vessel_1355d(pt: us.irc.core::Partnership, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the partnership (or other pass-thru entity) operates the vessel during the taxable year";
}
pub relation partner_in_partnership_1355d(p: Person, pt: us.irc.core::Partnership, y: TaxableYear) kind empirical {
    label en unofficial "the person is a partner (or holds an interest in another pass-thru entity) in the entity for the taxable year";
}
@source(IRC_S1355_D, quote = "each partner shall be treated as operating vessels operated by the partnership")
rule Section1355d1PartnerOperatesPartnershipVessels(p: Person, pt: us.irc.core::Partnership, v: us.irc.core::Asset, y: TaxableYear) strict {
    label en official "section 1355(d)(1): each partner is treated as operating the vessels the partnership operates";
    when partner_in_partnership_1355d(p, pt, y);
    when partnership_operates_vessel_1355d(pt, v, y);
    then treated_as_operating_vessel_1355b(p, v, y);
}

// ---- Section 1355(e)-(g): temporary cessation and domestic trade notices ----

pub relation cessation_notice_given_on_1355e(c: Corporation, v: us.irc.core::Asset, given_on: Date) kind empirical {
    label en unofficial "the electing corporation gave notice to the Secretary that it has temporarily ceased to operate the qualifying vessel and intends to resume, on this date, per section 1355(e)(1)";
}
pub relation return_due_date_with_extensions_1355e2(c: Corporation, v: us.irc.core::Asset, due: Date) kind empirical {
    label en unofficial "the due date, including extensions, of the corporation's return for the taxable year in which the temporary cessation begins (the return due date itself belongs to us.irc.administration/us.irc.returns and is asserted here)";
}
pub relation cessation_abandoned_on_1355e3A(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the electing corporation abandons its intention to resume operation of the qualifying vessel on this date";
}
pub relation cessation_resumed_on_1355e3B(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the electing corporation resumes operation of the qualifying vessel on this date";
}
pub relation timely_cessation_notice_1355e2(c: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the notice of temporary cessation is deemed timely (given not later than the return due date with extensions)";
}
@source(IRC_S1355_E, quote = "Notice shall be deemed timely if given not later than the due date (including extensions) for the corporation's tax return for the taxable year in which the temporary cessation begins.")
rule Section1355e2TimelyNotice(c: Corporation, v: us.irc.core::Asset, given_on: Date, due: Date) strict {
    label en official "section 1355(e)(2): notice is timely if given not later than the return due date, including extensions";
    when cessation_notice_given_on_1355e(c, v, given_on);
    when return_due_date_with_extensions_1355e2(c, v, due);
    when given_on <= due;
    then timely_cessation_notice_1355e2(c, v);
}
pub relation cessation_end_candidate_1355e3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a date on which the period of temporary cessation could end (abandonment or resumption)";
}
rule Section1355e3AbandonmentCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(e)(3)(A): abandonment of the intention to resume is a candidate end date";
    when cessation_abandoned_on_1355e3A(c, v, on);
    then cessation_end_candidate_1355e3(c, v, on);
}
rule Section1355e3ResumptionCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(e)(3)(B): resumption of operation is a candidate end date";
    when cessation_resumed_on_1355e3B(c, v, on);
    then cessation_end_candidate_1355e3(c, v, on);
}
pub relation earlier_cessation_end_candidate_exists_1355e3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a strictly earlier candidate end date exists (helper for the earlier-of rule, TECH-GAPS G136)";
}
rule Section1355e3EarlierCandidateExists(c: Corporation, v: us.irc.core::Asset, on: Date, other: Date) strict {
    label en official "helper: a candidate end date strictly earlier than the given one exists";
    when cessation_end_candidate_1355e3(c, v, on);
    when cessation_end_candidate_1355e3(c, v, other);
    when other < on;
    then earlier_cessation_end_candidate_exists_1355e3(c, v, on);
}
@source(IRC_S1355_E, quote = "The period of temporary cessation under paragraph (1) shall continue until the earlier of the date on which")
pub relation temporary_cessation_period_end_1355e3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the period of temporary cessation continues until the earlier of abandonment and resumption";
}
rule Section1355e3EarlierOfAbandonmentAndResumption(c: Corporation, v: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 1355(e)(3): the period ends on the earlier of the abandonment and resumption dates";
    when cessation_end_candidate_1355e3(c, v, on);
    when not_known(earlier_cessation_end_candidate_exists_1355e3(c, v, on));
    then temporary_cessation_period_end_1355e3(c, v, on);
}
pub relation treated_as_continuing_to_use_qualifying_vessel_1355e1(c: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the electing corporation is treated as continuing to use the qualifying vessel during the period of temporary cessation, for the purposes of subsections (b) and (c)";
}
@source(IRC_S1355_E, quote = "an electing corporation shall be treated as continuing to use a qualifying vessel during any period of temporary cessation if the electing corporation gives timely notice to the Secretary")
rule Section1355e1TemporaryCessationNotice(c: Corporation, v: us.irc.core::Asset, given_on: Date) strict {
    label en official "section 1355(e)(1): timely notice of temporary cessation and of the intention to resume preserves continued use";
    when cessation_notice_given_on_1355e(c, v, given_on);
    when timely_cessation_notice_1355e2(c, v);
    then treated_as_continuing_to_use_qualifying_vessel_1355e1(c, v);
}

pub relation domestic_trade_notice_given_on_1355f(c: Corporation, v: us.irc.core::Asset, given_on: Date) kind empirical {
    label en unofficial "the electing corporation gave notice that it temporarily operates in the United States domestic trade a qualifying vessel used in foreign trade and intends to resume foreign trade operation, on this date, per section 1355(f)(1)";
}
pub relation domestic_trade_return_due_date_1355f2(c: Corporation, v: us.irc.core::Asset, due: Date) kind empirical {
    label en unofficial "the due date, including extensions, of the return for the year in which the temporary domestic use begins (asserted)";
}
pub relation days_in_domestic_trade_during_year_1355f4(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days the vessel is operated in the United States domestic trade during the taxable year, per section 1355(f)(4)";
}
pub relation timely_domestic_trade_notice_1355f2(c: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the section 1355(f)(1) notice is deemed timely";
}
@source(IRC_S1355_F, quote = "Notice shall be deemed timely if given not later than the due date (including extensions) for the corporation's tax return for the taxable year in which the temporary cessation begins.")
rule Section1355f2TimelyNotice(c: Corporation, v: us.irc.core::Asset, given_on: Date, due: Date) strict {
    label en official "section 1355(f)(2): notice is timely if given not later than the return due date, including extensions";
    when domestic_trade_notice_given_on_1355f(c, v, given_on);
    when domestic_trade_return_due_date_1355f2(c, v, due);
    when given_on <= due;
    then timely_domestic_trade_notice_1355f2(c, v);
}
pub relation treated_as_continuing_foreign_trade_use_1355f1(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the electing corporation is treated as continuing to use the qualifying vessel in the United States foreign trade during the period of temporary domestic use";
}
@source(IRC_S1355_F, quote = "an electing corporation shall be treated as continuing to use a qualifying vessel in the United States foreign trade during any period of temporary use in the United States domestic trade if the electing corporation gives timely notice to the Secretary")
rule Section1355f1TemporaryDomesticUse(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, given_on: Date, days: Integer) strict {
    label en official "section 1355(f)(1),(4): timely notice preserves foreign-trade use, but not for a vessel operated in the domestic trade for more than 30 days in the taxable year";
    when domestic_trade_notice_given_on_1355f(c, v, given_on);
    when timely_domestic_trade_notice_1355f2(c, v);
    when days_in_domestic_trade_during_year_1355f4(c, v, y, days);
    when days <= 30;
    then treated_as_continuing_foreign_trade_use_1355f1(c, v, y);
}
pub relation domestic_use_abandoned_on_1355f3A(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the corporation abandons its intention to resume operations of the vessel in the United States foreign trade on this date";
}
pub relation domestic_use_resumed_foreign_on_1355f3B(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the corporation resumes operation of the vessel in the United States foreign trade on this date";
}
pub relation domestic_use_end_candidate_1355f3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a date on which the period of temporary domestic use could end";
}
rule Section1355f3AbandonmentCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(f)(3)(A): abandonment of the intention to resume foreign trade is a candidate end date";
    when domestic_use_abandoned_on_1355f3A(c, v, on);
    then domestic_use_end_candidate_1355f3(c, v, on);
}
rule Section1355f3ResumptionCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(f)(3)(B): resumption of foreign-trade operation is a candidate end date";
    when domestic_use_resumed_foreign_on_1355f3B(c, v, on);
    then domestic_use_end_candidate_1355f3(c, v, on);
}
pub relation earlier_domestic_use_end_candidate_exists_1355f3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a strictly earlier candidate end date exists (helper, TECH-GAPS G136)";
}
rule Section1355f3EarlierCandidateExists(c: Corporation, v: us.irc.core::Asset, on: Date, other: Date) strict {
    label en official "helper: a candidate end date strictly earlier than the given one exists";
    when domestic_use_end_candidate_1355f3(c, v, on);
    when domestic_use_end_candidate_1355f3(c, v, other);
    when other < on;
    then earlier_domestic_use_end_candidate_exists_1355f3(c, v, on);
}
@source(IRC_S1355_F, quote = "The period of temporary use under paragraph (1) continues until the earlier of the date on which")
pub relation temporary_domestic_use_period_end_1355f3(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the period of temporary domestic use continues until the earlier of abandonment and resumption";
}
rule Section1355f3EarlierOfAbandonmentAndResumption(c: Corporation, v: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 1355(f)(3): the period ends on the earlier of the abandonment and resumption dates";
    when domestic_use_end_candidate_1355f3(c, v, on);
    when not_known(earlier_domestic_use_end_candidate_exists_1355f3(c, v, on));
    then temporary_domestic_use_period_end_1355f3(c, v, on);
}

// (g): qualified zone domestic trade.
pub relation elects_qualified_zone_treatment_1355g1(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the electing corporation elects, at the time and in the manner the Secretary requires, to apply subsection (g) to the vessel for the taxable year";
}
pub relation vessel_used_in_qualified_zone_domestic_trade_1355g1(v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en unofficial "the vessel is used in qualified zone domestic trade (transportation between places in the Great Lakes Waterway and the St. Lawrence Seaway that is domestic trade, per section 1355(g)(4)) during the taxable year";
}
pub relation qualified_zone_use_treated_as_foreign_trade_for_1355a4(v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "solely for purposes of subsection (a)(4), the use is treated as use in United States foreign trade (and not domestic trade), and subsection (f) does not apply for the year";
}
@source(IRC_S1355_G, quote = "solely for purposes of subsection (a)(4), such use shall be treated as use in United States foreign trade (and not as use in United States domestic trade)")
rule Section1355g1QualifiedZoneElection(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) strict {
    label en official "section 1355(g)(1): an electing corporation's election makes qualified zone domestic trade count as foreign trade for subsection (a)(4)";
    when elects_qualified_zone_treatment_1355g1(c, v, y);
    when vessel_used_in_qualified_zone_domestic_trade_1355g1(v, y);
    then power QualifiedZoneElection {
        holder c;
        over v;
        exercise elects_qualified_zone_treatment_1355g1(c, v, y);
        valid_when electing_corporation_1355a1(c, y);
        effect create(qualified_zone_use_treated_as_foreign_trade_for_1355a4(v, y));
        window [@2004-10-22, infinity);
    };
}
pub relation zone_notice_given_on_1355g2A(c: Corporation, v: us.irc.core::Asset, given_on: Date) kind empirical {
    label en unofficial "the electing corporation gave notice of temporary use in United States domestic trade (other than qualified zone) and of its intention to resume foreign or qualified zone trade, on this date";
}
pub relation zone_return_due_date_1355g2B(c: Corporation, v: us.irc.core::Asset, due: Date) kind empirical {
    label en unofficial "the due date, including extensions, of the return for the year the temporary use begins (asserted)";
}
pub relation days_in_non_zone_domestic_trade_1355g2D(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days the vessel is operated in United States domestic trade other than qualified zone domestic trade during the year";
}
pub relation timely_zone_notice_1355g2B(c: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the section 1355(g)(2)(A) notice is deemed timely";
}
@source(IRC_S1355_G, quote = "Notice shall be deemed timely if given not later than the due date (including extensions) for the corporation's tax return for the taxable year in which the temporary cessation begins.")
rule Section1355g2BTimelyNotice(c: Corporation, v: us.irc.core::Asset, given_on: Date, due: Date) strict {
    label en official "section 1355(g)(2)(B): notice is timely if given not later than the return due date, including extensions";
    when zone_notice_given_on_1355g2A(c, v, given_on);
    when zone_return_due_date_1355g2B(c, v, due);
    when given_on <= due;
    then timely_zone_notice_1355g2B(c, v);
}
pub relation treated_as_using_vessel_in_qualified_zone_1355g2A(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the electing corporation is treated as using the vessel in qualified zone domestic trade during the period of temporary use in other domestic trade";
}
@source(IRC_S1355_G, quote = "An electing corporation shall be treated as using such vessel in qualified zone domestic trade during any period of temporary use in the United States domestic trade (other than qualified zone domestic trade) if the electing corporation gives timely notice to the Secretary")
rule Section1355g2ATemporaryNonZoneUse(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, given_on: Date, days: Integer) strict {
    label en official "section 1355(g)(2)(A),(D): timely notice preserves qualified zone use, but not for a vessel operated in other domestic trade for more than 30 days in the year";
    when zone_notice_given_on_1355g2A(c, v, given_on);
    when timely_zone_notice_1355g2B(c, v);
    when days_in_non_zone_domestic_trade_1355g2D(c, v, y, days);
    when days <= 30;
    then treated_as_using_vessel_in_qualified_zone_1355g2A(c, v, y);
}

// ---- Section 1356: qualifying shipping activities ----

pub relation gross_income_core_qualifying_activities_1356b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income, without regard to subchapter R, derived from core qualifying activities (operating qualifying vessels in United States foreign trade), per section 1356(b)";
}
pub relation gross_income_secondary_activities_1356c2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "gross income, without regard to subchapter R, derived from secondary activities within section 1356(c)(2) (not core activities)";
}
pub relation gross_income_incidental_shipping_activities_1356d(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "gross income, without regard to subchapter R, from shipping-related activities that are incidental to core activities and are not qualifying secondary activities (the case aggregates the activities it classifies as incidental)";
}
pub relation qualifying_secondary_income_1356c1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part of secondary-activity gross income that is qualifying secondary activities: not more than 20 percent of core qualifying gross income";
}
@source(IRC_S1356_C, quote = "the gross income derived by such corporation from such activities does not exceed 20 percent of the gross income derived by the corporation from its core qualifying activities")
rule Section1356c1SecondaryWithinTwentyPercent(c: Corporation, y: TaxableYear, secondary: Money, core: Money) strict {
    label en official "section 1356(c)(1): secondary-activity income up to 20 percent of core income qualifies in full";
    when gross_income_secondary_activities_1356c2(c, y, secondary);
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when secondary * 100.0 <= core * 20.0;
    then qualifying_secondary_income_1356c1(c, y, secondary);
}
@source(IRC_S1356_C, quote = "but only to the extent that, without regard to this subchapter")
rule Section1356c1SecondaryAboveTwentyPercentCapped(c: Corporation, y: TaxableYear, secondary: Money, core: Money) strict {
    label en official "section 1356(c)(1): only to the extent of 20 percent of core income when the secondary income exceeds it";
    when gross_income_secondary_activities_1356c2(c, y, secondary);
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when secondary * 100.0 > core * 20.0;
    // JUDGMENT CALL: 20 percent of a Money amount to cents HALF_UP (the
    // statute names no rounding); one division, one rounding.
    then qualifying_secondary_income_1356c1(c, y, div_round(core * 20.0, 100.0, 2, "HALF_UP"));
}
pub relation incidental_activities_income_within_tenth_of_one_percent_1356d3(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the gross income from incidental shipping-related activities does not exceed 0.1 percent of gross income from core qualifying activities";
}
@source(IRC_S1356_D, quote = "does not exceed 0.1 percent of the corporation's gross income from its core qualifying activities")
rule Section1356d3IncidentalWithinTenthOfOnePercent(c: Corporation, y: TaxableYear, incidental: Money, core: Money) defeasible {
    label en official "section 1356(d)(3): incidental income at most 0.1 percent of core income";
    when gross_income_incidental_shipping_activities_1356d(c, y, incidental);
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when incidental * 1000.0 <= core;
    then incidental_activities_income_within_tenth_of_one_percent_1356d3(c, y);
}
pub relation qualifying_incidental_income_1356d(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the income of qualifying incidental activities for the taxable year (the incidental income when the (d)(3) ceiling is met, otherwise none)";
}
rule Section1356dIncidentalQualifies(c: Corporation, y: TaxableYear, incidental: Money) defeasible {
    label en official "section 1356(d): incidental activities within the 0.1 percent ceiling are qualifying incidental activities";
    when gross_income_incidental_shipping_activities_1356d(c, y, incidental);
    when incidental_activities_income_within_tenth_of_one_percent_1356d3(c, y);
    then qualifying_incidental_income_1356d(c, y, incidental);
}
rule Section1356dIncidentalOverCeilingDoesNotQualify(c: Corporation, y: TaxableYear, incidental: Money, core: Money) defeasible {
    label en official "section 1356(d)(3): incidental income above 0.1 percent of core income is not from qualifying incidental activities";
    when gross_income_incidental_shipping_activities_1356d(c, y, incidental);
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when incidental * 1000.0 > core;
    then qualifying_incidental_income_1356d(c, y, 0.00 USD);
}
@source(IRC_S1356_A, quote = "the term \"qualifying shipping activities\" means")
pub relation qualifying_shipping_activities_income_1356a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income from qualifying shipping activities: core plus qualifying secondary plus qualifying incidental";
}
rule Section1356aQualifyingShippingActivitiesIncome(c: Corporation, y: TaxableYear, core: Money, secondary: Money, incidental: Money) defeasible {
    label en official "section 1356(a): qualifying shipping activities are core, qualifying secondary and qualifying incidental activities";
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when qualifying_secondary_income_1356c1(c, y, secondary);
    when qualifying_incidental_income_1356d(c, y, incidental);
    when not_known(is_in_electing_group_1356e(c, y));
    then qualifying_shipping_activities_income_1356a(c, y, core + secondary + incidental);
}

// ---- Section 1357: items not subject to the ordinary income rules ----

pub relation electing_group_member_1357b(c: Corporation, y: TaxableYear) kind institutional {
    label en unofficial "the corporation, not itself an electing corporation, is a member of an electing group for the taxable year";
}
pub relation income_from_qualifying_shipping_activities_conducted_by_member_1357b(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "income from qualifying shipping activities conducted by this member of an electing group";
}
pub relation gross_income_excluded_1357(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the income from qualifying shipping activities excluded from gross income of the corporation";
}
@source(IRC_S1357_A, quote = "Gross income of an electing corporation shall not include its income from qualifying shipping activities.")
rule Section1357aElectingCorporationExclusion(c: Corporation, y: TaxableYear, amount: Money) defeasible {
    label en official "section 1357(a): an electing corporation's income from qualifying shipping activities is excluded from gross income";
    when electing_corporation_1355a1(c, y);
    when qualifying_shipping_activities_income_1356a(c, y, amount);
    then gross_income_excluded_1357(c, y, amount);
}
@source(IRC_S1357_B, quote = "Gross income of a corporation (other than an electing corporation) which is a member of an electing group shall not include its income from qualifying shipping activities conducted by such member.")
rule Section1357bGroupMemberExclusion(c: Corporation, y: TaxableYear, amount: Money) strict {
    label en official "section 1357(b): a non-electing member of an electing group excludes the qualifying shipping income it conducts";
    when electing_group_member_1357b(c, y);
    when income_from_qualifying_shipping_activities_conducted_by_member_1357b(c, y, amount);
    then gross_income_excluded_1357(c, y, amount);
}
pub relation non_interest_loss_deduction_or_credit_of_excluded_activity_1357c1(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the loss, deduction (other than interest expense) or credit attributable to an activity the income from which is excluded under section 1357 (all such items of the taxpayer, one amount)";
}
pub relation item_disallowed_1357c1(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of loss, deduction (other than interest) or credit disallowed by section 1357(c)(1)";
}
@source(IRC_S1357_C, quote = "each item of loss, deduction (other than for interest expense), or credit of any taxpayer with respect to any activity the income from which is excluded from gross income under this section shall be disallowed")
rule Section1357c1DisallowanceOfNonInterestItems(c: Corporation, y: TaxableYear, amount: Money, excluded: Money) defeasible {
    label en official "section 1357(c)(1): items attributable to an excluded activity are disallowed";
    when non_interest_loss_deduction_or_credit_of_excluded_activity_1357c1(c, y, amount);
    when gross_income_excluded_1357(c, y, excluded);
    then item_disallowed_1357c1(c, y, amount);
}
pub relation vessel_adjusted_basis_before_notional_depreciation_1357c2A(v: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the qualifying vessel before any notional depreciation";
}
pub relation depreciation_that_would_have_been_allowed_1357c2A(v: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the depreciation that would have been allowed had it not been disallowed by paragraph (1)";
}
pub relation vessel_adjusted_basis_for_gain_1357c2A(v: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the adjusted basis (for determining gain) of the qualifying vessel, as if the depreciation deduction had been allowed";
}
@source(IRC_S1357_C, quote = "the adjusted basis (for purposes of determining gain) of any qualifying vessel shall be determined as if the deduction for depreciation had been allowed")
rule Section1357c2AAdjustedBasisAsIfDepreciationAllowed(v: us.irc.core::Asset, before: Money, dep: Money) strict {
    label en official "section 1357(c)(2)(A): adjusted basis for gain is reduced by the depreciation that would have been allowed";
    when vessel_adjusted_basis_before_notional_depreciation_1357c2A(v, before);
    when depreciation_that_would_have_been_allowed_1357c2A(v, dep);
    when before >= dep;
    then vessel_adjusted_basis_for_gain_1357c2A(v, before - dep);
}
pub relation vessel_charter_entered_on_1357c2B(v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date on which the charter of the vessel was entered into";
}
pub relation straight_line_depreciation_applies_1357c2B(v: us.irc.core::Asset) kind institutional {
    label en official "the straight-line method of depreciation applies to the qualifying vessel whose operating income is excluded";
}
// JUDGMENT CALL: "the date of the enactment of this subchapter" is
// 22 October 2004 (Pub. L. 108-357, approved that day).
@source(IRC_S1357_C, quote = "Except as provided in clause (ii), the straight-line method of depreciation shall apply to qualifying vessels the income from operation of which is excluded from gross income under this section.")
rule Section1357c2BStraightLine(v: us.irc.core::Asset, chartered_on: Date) defeasible {
    label en official "section 1357(c)(2)(B)(i): straight-line depreciation applies, except to a vessel under a charter entered into before the enactment of the subchapter";
    when vessel_charter_entered_on_1357c2B(v, chartered_on);
    when chartered_on >= @2004-10-22;
    then straight_line_depreciation_applies_1357c2B(v);
}
pub relation interest_expense_1357c3(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest expense of the electing corporation for the taxable year";
}
pub relation fair_market_value_of_qualifying_vessels_1357c3(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the corporation's qualifying vessels (an evaluative figure the case supplies; DECISION-0194 channel: adjudicated or asserted fact)";
}
pub relation fair_market_value_of_total_assets_1357c3A(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the corporation's total assets";
}
pub relation fair_market_value_of_electing_group_total_assets_1357c3B(c: Corporation, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the electing group's total assets";
}
pub relation interest_expense_disallowed_1357c3(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the interest expense disallowed in the ratio of the fair market value of qualifying vessels to that of total assets";
}
@source(IRC_S1357_C, quote = "the interest expense of an electing corporation shall be disallowed in the ratio that the fair market value of such corporation's qualifying vessels bears to the fair market value of such corporation's total assets")
rule Section1357c3AInterestDisallowedByAssetRatio(c: Corporation, y: TaxableYear, interest: Money, vessels: Money, total: Money) strict {
    label en official "section 1357(c)(3)(A): interest expense disallowed in the ratio of vessel value to total asset value";
    when electing_corporation_1355a1(c, y);
    when interest_expense_1357c3(c, y, interest);
    when fair_market_value_of_qualifying_vessels_1357c3(c, y, vessels);
    when fair_market_value_of_total_assets_1357c3A(c, y, total);
    when total > 0.00 USD;
    then interest_expense_disallowed_1357c3(c, y, div_round(interest * (vessels / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S1357_C, quote = "In the case of a corporation which is a member of an electing group, the interest expense of such corporation shall be disallowed in the ratio that the fair market value of such corporation's qualifying vessels bears to the fair market value of the electing groups total assets.")
rule Section1357c3BGroupMemberInterestDisallowed(c: Corporation, y: TaxableYear, interest: Money, vessels: Money, group_total: Money) strict {
    label en official "section 1357(c)(3)(B): a group member's interest disallowed in the ratio of its vessel value to the electing group's total asset value";
    when electing_group_member_1357b(c, y);
    when interest_expense_1357c3(c, y, interest);
    when fair_market_value_of_qualifying_vessels_1357c3(c, y, vessels);
    when fair_market_value_of_electing_group_total_assets_1357c3B(c, y, group_total);
    when group_total > 0.00 USD;
    then interest_expense_disallowed_1357c3(c, y, div_round(interest * (vessels / 1.00 USD), group_total / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 1358: allocation of credits, income and deductions ----

pub relation separate_trade_or_business_activity_1358a(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the qualifying shipping activities of an electing corporation are a separate trade or business activity distinct from all its other activities";
}
@source(IRC_S1358_A, quote = "the qualifying shipping activities of an electing corporation shall be treated as a separate trade or business activity distinct from all other activities conducted by such corporation")
rule Section1358aSeparateActivity(c: Corporation, y: TaxableYear) strict {
    label en official "section 1358(a): qualifying shipping activities of an electing corporation are a separate trade or business";
    when electing_corporation_1355a1(c, y);
    then separate_trade_or_business_activity_1358a(c, y);
}
pub relation deduction_claimed_against_notional_shipping_income_1358b1(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the electing corporation claims a deduction against its notional shipping income";
}
pub relation credit_claimed_against_tonnage_tax_1358b1(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the electing corporation claims a credit against the tax imposed by section 1352(2)";
}
pub relation net_operating_loss_carryforward_from_before_election_1358b2(c: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the electing corporation claims a deduction for a net operating loss attributable to qualifying shipping activities, carried forward from a taxable year preceding the first year of the election";
}
// Prohibitions are addressed to the taxpayer's own conduct (claiming). The
// position stands from the electing year and is VIOLATED on itself when the
// claim is established (E-0179); the rule's premise is the status, not the
// claim, so a corporation that does not claim stays ACTIVE.
@source(IRC_S1358_B, quote = "(1) No deduction shall be allowed against the notional shipping income of an electing corporation")
rule Section1358b1NoDeductionAgainstNotionalIncome(c: Corporation, y: TaxableYear) strict {
    label en official "section 1358(b)(1): the electing corporation may not deduct against notional shipping income";
    when electing_corporation_1355a1(c, y);
    then prohibition NoDeductionAgainstNotionalShippingIncome {
        bearer c;
        action deduction_claimed_against_notional_shipping_income_1358b1(c, y);
        window [@2004-10-22, infinity);
    };
}
@source(IRC_S1358_B, quote = "and no credit shall be allowed against the tax imposed by section 1352(2)")
rule Section1358b1NoCreditAgainstTonnageTax(c: Corporation, y: TaxableYear) strict {
    label en official "section 1358(b)(1): no credit against the tax imposed by section 1352(2)";
    when electing_corporation_1355a1(c, y);
    then prohibition NoCreditAgainstTonnageTax {
        bearer c;
        action credit_claimed_against_tonnage_tax_1358b1(c, y);
        window [@2004-10-22, infinity);
    };
}
@source(IRC_S1358_B, quote = "No deduction shall be allowed for any net operating loss attributable to the qualifying shipping activities of any person to the extent that such loss is carried forward by such person from a taxable year preceding the first taxable year for which such person was an electing corporation.")
rule Section1358b2NoPreElectionNolCarryforward(c: Corporation, y: TaxableYear) strict {
    label en official "section 1358(b)(2): no deduction for a pre-election net operating loss of the qualifying shipping activities carried into an electing year";
    when electing_corporation_1355a1(c, y);
    then prohibition NoPreElectionNolDeduction {
        bearer c;
        action net_operating_loss_carryforward_from_before_election_1358b2(c, y);
        window [@2004-10-22, infinity);
    };
}

// ---- Section 1359: disposition of qualifying vessels ----

pub relation vessel_disposed_in_taxable_transaction_1359a(o: Corporation, v: us.irc.core::Asset, disposed_on: Date) kind empirical {
    label en unofficial "the qualifying vessel operator sells or disposes of the qualifying vessel in an otherwise taxable transaction on this date";
}
pub relation elects_nonrecognition_1359a(o: Corporation, v: us.irc.core::Asset) kind empirical {
    label en unofficial "the operator elects nonrecognition of the gain under section 1359(a)";
}
pub relation replacement_vessel_acquired_on_1359a(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, acquired_on: Date) kind empirical {
    label en unofficial "a replacement qualifying vessel is acquired on this date";
}
pub relation first_gain_year_ends_on_1359b1(o: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the close of the first taxable year in which the gain is realized";
}
pub relation replacement_period_extended_by_secretary_1359b2(o: Corporation, v: us.irc.core::Asset, later: Date) kind empirical {
    label en unofficial "the later date the Secretary designates, on application of the taxpayer, for the end of the period";
}
pub relation amount_realized_1359a(o: Corporation, v: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount realized on the sale or disposition of the qualifying vessel";
}
pub relation cost_of_replacement_vessel_1359a(o: Corporation, replacement: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the cost of the replacement qualifying vessel";
}
pub relation gain_realized_1359a(o: Corporation, v: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the gain realized on the disposition";
}
pub relation replacement_period_end_1359b(o: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the end of the replacement period: 3 years after the close of the first taxable year in which the gain is realized (or the Secretary's later date)";
}
pub relation has_secretary_extension_1359b2(o: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the Secretary has designated a later date on application (helper that binds the open date argument, so absence can be tested)";
}
rule Section1359b2HasExtension(o: Corporation, v: us.irc.core::Asset, later: Date) strict {
    label en official "helper: a later date designated by the Secretary exists";
    when replacement_period_extended_by_secretary_1359b2(o, v, later);
    then has_secretary_extension_1359b2(o, v);
}
@source(IRC_S1359_B, quote = "3 years after the close of the first taxable year in which the gain is realized")
rule Section1359b1ThreeYearsAfterFirstGainYear(o: Corporation, v: us.irc.core::Asset, close: Date, calendar_before_1: Date) strict {
    label en official "section 1359(b)(1): the period ends 3 years after the close of the first taxable year in which the gain is realized, when the Secretary designates no later date";
    when first_gain_year_ends_on_1359b1(o, v, close);
    when not_known(has_secretary_extension_1359b2(o, v))
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(add_calendar_period(close, 1 calendar_day), 36 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then replacement_period_end_1359b(o, v, calendar_before_1);
}
@source(IRC_S1359_B, quote = "on such later date as the Secretary may designate on application by the taxpayer")
rule Section1359b2SecretaryLaterDate(o: Corporation, v: us.irc.core::Asset, close: Date, later: Date, calendar_before_1: Date) strict {
    label en official "section 1359(b)(2): the later date the Secretary designates on application governs";
    when first_gain_year_ends_on_1359b1(o, v, close);
    when replacement_period_extended_by_secretary_1359b2(o, v, later);
    when later >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(add_calendar_period(close, 1 calendar_day), 36 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then replacement_period_end_1359b(o, v, later);
}
pub relation replacement_within_period_1359a(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset) kind institutional {
    label en official "the replacement vessel was acquired in the period beginning one year before the disposition and ending on the period end date";
}
@source(IRC_S1359_B, quote = "The period referred to in subsection (a) shall be the period beginning one year prior to the disposition of the qualifying vessel")
rule Section1359bReplacementWithinPeriod(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, disposed_on: Date, acquired_on: Date, end_on: Date, calendar_before_1: Date) strict {
    label en official "section 1359(b): the replacement vessel is acquired within the period from one year before the disposition to the period end";
    when vessel_disposed_in_taxable_transaction_1359a(o, v, disposed_on);
    when replacement_vessel_acquired_on_1359a(o, v, replacement, acquired_on);
    when replacement_period_end_1359b(o, v, end_on);
    when acquired_on >= calendar_before_1;
    when acquired_on <= end_on
        and us.irc.core::civil_calendar_boundary_before(disposed_on, 12, us.irc.core::CalendarMonth, calendar_before_1);
    then replacement_within_period_1359a(o, v, replacement);
}
pub relation gain_recognized_after_1359a_election(o: Corporation, v: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain recognized notwithstanding the election: only the excess of the amount realized over the cost of the replacement vessel (bounded by the gain realized)";
}
pub relation nonrecognition_elected_and_replaced_1359a(o: Corporation, v: us.irc.core::Asset) kind institutional {
    label en official "the operator's election under section 1359(a) took effect for the disposed vessel";
}
@source(IRC_S1359_A, quote = "at the election of such operator, no gain shall be recognized if any replacement qualifying vessel is acquired during the period specified in subsection (b)")
rule Section1359aNonrecognitionElection(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, disposed_on: Date) strict {
    label en official "section 1359(a): the operator's election to defer gain on a replaced qualifying vessel is a power over its own tax treatment";
    when elects_nonrecognition_1359a(o, v);
    when vessel_disposed_in_taxable_transaction_1359a(o, v, disposed_on);
    when replacement_within_period_1359a(o, v, replacement);
    then power VesselReplacementNonrecognitionElection {
        holder o;
        over o;
        exercise elects_nonrecognition_1359a(o, v);
        valid_when replacement_within_period_1359a(o, v, replacement);
        effect create(nonrecognition_elected_and_replaced_1359a(o, v));
        window [@2004-10-22, infinity);
    };
}
@source(IRC_S1359_A, quote = "except to the extent that the amount realized upon such sale or disposition exceeds the cost of the replacement qualifying vessel")
rule Section1359aGainRecognizedToExtentOfExcess(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, realized: Money, cost: Money, gain: Money) strict {
    label en official "section 1359(a): gain is recognized only to the extent the amount realized exceeds the cost of the replacement (never more than the gain realized)";
    when nonrecognition_elected_and_replaced_1359a(o, v);
    when replacement_within_period_1359a(o, v, replacement);
    when amount_realized_1359a(o, v, realized);
    when cost_of_replacement_vessel_1359a(o, replacement, cost);
    when gain_realized_1359a(o, v, gain);
    when realized > cost;
    when realized - cost <= gain;
    then gain_recognized_after_1359a_election(o, v, realized - cost);
}
rule Section1359aGainRecognizedCappedAtGainRealized(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, realized: Money, cost: Money, gain: Money) strict {
    label en official "section 1359(a): the recognized excess is bounded by the gain realized";
    when nonrecognition_elected_and_replaced_1359a(o, v);
    when replacement_within_period_1359a(o, v, replacement);
    when amount_realized_1359a(o, v, realized);
    when cost_of_replacement_vessel_1359a(o, replacement, cost);
    when gain_realized_1359a(o, v, gain);
    when realized > cost;
    when realized - cost > gain;
    then gain_recognized_after_1359a_election(o, v, gain);
}
rule Section1359aNothingRecognizedWhenCostCoversProceeds(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, realized: Money, cost: Money) strict {
    label en official "section 1359(a): no gain is recognized when the replacement cost is at least the amount realized";
    when nonrecognition_elected_and_replaced_1359a(o, v);
    when replacement_within_period_1359a(o, v, replacement);
    when amount_realized_1359a(o, v, realized);
    when cost_of_replacement_vessel_1359a(o, replacement, cost);
    when realized <= cost;
    then gain_recognized_after_1359a_election(o, v, 0.00 USD);
}
pub relation replacement_vessel_basis_1359e(o: Corporation, replacement: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of the replacement qualifying vessel: its cost decreased by the gain not recognized";
}
pub relation gain_not_recognized_1359e(o: Corporation, v: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the part of the realized gain not recognized because of the election";
}
rule Section1359eGainNotRecognized(o: Corporation, v: us.irc.core::Asset, gain: Money, recognized: Money) strict {
    label en official "section 1359(e): the gain not recognized is the gain realized less the gain recognized";
    when gain_realized_1359a(o, v, gain);
    when gain_recognized_after_1359a_election(o, v, recognized);
    when gain >= recognized;
    then gain_not_recognized_1359e(o, v, gain - recognized);
}
@source(IRC_S1359_E, quote = "the basis shall be the cost of the replacement qualifying vessel decreased in the amount of the gain not so recognized")
rule Section1359eReplacementBasis(o: Corporation, v: us.irc.core::Asset, replacement: us.irc.core::Asset, cost: Money, unrecognized: Money) strict {
    label en official "section 1359(e): basis of the replacement vessel is its cost decreased by the unrecognized gain (a single replacement vessel)";
    when replacement_within_period_1359a(o, v, replacement);
    when cost_of_replacement_vessel_1359a(o, replacement, cost);
    when gain_not_recognized_1359e(o, v, unrecognized);
    when cost >= unrecognized;
    then replacement_vessel_basis_1359e(o, replacement, cost - unrecognized);
}
pub relation deficiency_assessment_period_extended_until_1359d(o: Corporation, v: us.irc.core::Asset, until: Date) kind institutional {
    label en official "the period for assessing a deficiency attributable to the gain does not expire before this date (3 years from the Secretary's notification)";
}
pub relation secretary_notified_of_replacement_or_intention_not_to_replace_on_1359d1(o: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the Secretary was notified by the operator of the replacement qualifying vessel, or of an intention not to replace, on this date";
}
@source(IRC_S1359_D, quote = "shall not expire prior to the expiration of 3 years from the date the Secretary is notified by such operator")
rule Section1359d1AssessmentPeriodExtension(o: Corporation, v: us.irc.core::Asset, notified_on: Date) strict {
    label en official "section 1359(d)(1): the limitations period for a deficiency attributable to the gain runs to 3 years after the Secretary is notified";
    when nonrecognition_elected_and_replaced_1359a(o, v);
    when secretary_notified_of_replacement_or_intention_not_to_replace_on_1359d1(o, v, notified_on);
    then deficiency_assessment_period_extended_until_1359d(o, v, add_calendar_period(notified_on, 36 calendar_month));
}
