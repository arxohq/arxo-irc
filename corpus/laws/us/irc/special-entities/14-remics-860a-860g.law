// Sections 860A-860G (REMICs): section 860A (no entity-level tax), 860D
// (REMIC qualification and the election), 860E(c) (excess inclusion), and
// 860F(a) (100 percent tax on prohibited transactions). Stage 2b (IRC-09
// stage 2b, A12).
//
// METHOD: section 860D(a)'s five qualification conditions are modeled as
// classification switches; (a)(4)'s "substantially all... consist of
// qualified mortgages and permitted investments" (the 3-month test) is an
// EVALUATIVE element under DECISION-0194 (no exact percentage is stated in
// the text) — this module accepts it as a case-asserted classification
// switch rather than inventing a percentage threshold the statute does not
// state; a future stage should route it through the formal evaluative-
// element channel instead. The election is modeled as a `power` (the
// holder is the entity itself, consistent with this package's own section
// 831(b)/860 election patterns). Section 860E(c)'s excess-inclusion
// computation is modeled at the CALENDAR-QUARTER level (assuming the
// holder held the interest for the full quarter), not by allocating a
// separate daily accrual to each day and summing — the statute's own
// (c)(2)(A) "allocating to each day... its ratable portion" ratable
// allocation, for a holder who held the interest every day of the quarter,
// mathematically reduces to exactly this quarter-level product; a holder
// who acquired or disposed of the interest mid-quarter is NOT separately
// handled (filed as a TECH_GAP row, not silently assumed away). Section
// 860B (regular interest taxation), 860C (residual interest pass-thru,
// full basis/loss-limitation machinery), 860E(a)-(b),(d)-(f) (NOL
// coordination, UBTI treatment, REIT/RIC pass-through, variable-contract
// rule), 860E(e) (the disqualified-organization transfer tax), and 860F(b)-
// (e) (transfer nonrecognition, distributions, wash-sale coordination,
// subtitle F partnership treatment) are NOT modeled this pass.

// ---- Section 860A: no entity-level tax ----

use self::{
    IRC_S860A_A,
    IRC_S860C_A,
    IRC_S860D_A,
    IRC_S860D_B,
    IRC_S860E_C,
    IRC_S860F_A,
    Person,
    TaxableYear,
};

@source(IRC_S860A_A, quote = "Except as otherwise provided in this part, a REMIC shall not be subject to taxation under this subtitle (and shall not be treated as a corporation, partnership, or trust for purposes of this subtitle).")
pub relation remic_not_taxed_as_entity_860a(c: Person, y: TaxableYear) kind institutional {
    label en official "section 860A(a): a REMIC is not subject to Subtitle A taxation as an entity (except as this part otherwise provides)";
}
rule Section860aNotTaxedAsEntity(c: Person, y: TaxableYear) strict {
    label en official "section 860A(a): a qualified REMIC is not taxed as an entity";
    when remic_qualified(c, y);
    then remic_not_taxed_as_entity_860a(c, y);
}

// ---- Section 860D(a): REMIC qualification ----

@source(IRC_S860D_A, quote = "all of the interests in which are regular interests or residual interests")
pub relation all_interests_regular_or_residual_860d1a2(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "all interests in the entity are regular interests or residual interests, per section 860D(a)(2)";
}
@source(IRC_S860D_A, quote = "which has 1 (and only 1) class of residual interests (and all distributions, if any, with respect to such interests are pro rata)")
pub relation one_class_of_residual_interests_pro_rata_860d1a3(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity has exactly one class of residual interests, distributed pro rata, per section 860D(a)(3)";
}
@source(IRC_S860D_A, quote = "as of the close of the 3rd month beginning after the startup day and at all times thereafter, substantially all of the assets of which consist of qualified mortgages and permitted investments")
pub relation substantially_all_qualified_mortgages_860d1a4(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "as of the close of the 3rd month after the startup day and at all times thereafter, substantially all of the entity's assets consist of qualified mortgages and permitted investments, per section 860D(a)(4) (an EVALUATIVE 'substantially all' element, DECISION-0194 — asserted directly rather than a case-asserted percentage against an invented threshold, pending a future stage's use of the formal evaluative-element channel)";
}
@source(IRC_S860D_A, quote = "which has a taxable year which is a calendar year")
pub relation taxable_year_is_calendar_year_860d1a5(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity's taxable year is a calendar year, per section 860D(a)(5)";
}
@source(IRC_S860D_A, quote = "residual interests in such entity are not held by disqualified organizations (as defined in section 860E(e)(5)), and")
pub relation residual_interests_not_held_by_disqualified_organizations_860d1a6A(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "reasonable arrangements ensure residual interests are not held by disqualified organizations (section 860E(e)(5)), per section 860D(a)(6)(A)";
}
@source(IRC_S860D_A, quote = "information necessary for the application of section 860E(e) will be made available by the entity")
pub relation information_for_860e_available_860d1a6B(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "reasonable arrangements ensure information necessary for section 860E(e) is made available, per section 860D(a)(6)(B)";
}
@source(IRC_S860D_A, quote = "For purposes of this title, the terms \"real estate mortgage investment conduit\" and \"REMIC\" mean any entity—\n(1) to which an election to be treated as a REMIC applies for the taxable year and all prior taxable years,\n(2) all of the interests in which are regular interests or residual interests,\n(3) which has 1 (and only 1) class of residual interests (and all distributions, if any, with respect to such interests are pro rata),\n(4) as of the close of the 3rd month beginning after the startup day and at all times thereafter, substantially all of the assets of which consist of qualified mortgages and permitted investments,\n(5) which has a taxable year which is a calendar year, and\n(6) with respect to which there are reasonable arrangements designed to ensure that—")
pub relation remic_qualified(c: Person, y: TaxableYear) kind institutional {
    label en official "section 860D(a): the entity qualifies as a REMIC for the taxable year (the election, (a)(2)-(6) conditions all met)";
}
rule Section860daRemicQualified(c: Person, y: TaxableYear) strict {
    label en official "section 860D(a): an entity meeting all of (a)(1)-(6) is a REMIC";
    when treated_as_remic_860d(c, y);
    when all_interests_regular_or_residual_860d1a2(c, y);
    when one_class_of_residual_interests_pro_rata_860d1a3(c, y);
    when substantially_all_qualified_mortgages_860d1a4(c, y);
    when taxable_year_is_calendar_year_860d1a5(c, y);
    when residual_interests_not_held_by_disqualified_organizations_860d1a6A(c, y);
    when information_for_860e_available_860d1a6B(c, y);
    then remic_qualified(c, y);
}

// ---- Section 860D(b): the election ----

@source(IRC_S860D_B, quote = "An entity (otherwise meeting the requirements of subsection (a)) may elect to be treated as a REMIC for its 1st taxable year.")
pub relation elects_remic_860d(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity's election, made on its return for its first taxable year, to be treated as a REMIC, per section 860D(b)(1)";
}
pub relation treated_as_remic_860d(c: Person, y: TaxableYear) kind institutional {
    label en official "the entity is treated as having made a valid section 860D(b) REMIC election, applicable to the taxable year and all subsequent taxable years (the (b)(2) termination/inadvertent-termination machinery is not separately modeled)";
}
@source(IRC_S860D_B, quote = "Except as provided in paragraph (2), such an election shall apply to the taxable year for which made and all subsequent taxable years.")
rule Section860dbElection(c: Person, y: TaxableYear) strict {
    label en official "section 860D(b)(1): a REMIC election, once made, is given effect for purposes of the qualification test (the entity still must meet (a)(2)-(6) for the year in question)";
    when elects_remic_860d(c, y);
    then power RemicElection {
        holder c;
        over c;
        exercise elects_remic_860d(c, y);
        valid_when all_interests_regular_or_residual_860d1a2(c, y);
        effect create(treated_as_remic_860d(c, y));
        window [@1987-01-01, infinity);
    };
}

// ---- Section 860E(c): excess inclusion ----

@source(IRC_S860E_C, quote = "the adjusted issue price of such interest at the beginning of such quarter")
pub relation adjusted_issue_price_beginning_of_quarter_860e2B(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the adjusted issue price of the residual interest at the beginning of the calendar quarter, per section 860E(c)(2)(B)";
}
@source(IRC_S860E_C, quote = "120 percent of the long-term Federal rate (determined on the basis of compounding at the close of each calendar quarter and properly adjusted for the length of such quarter)")
pub relation federal_long_term_rate_860e2C(remic: Person, q: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the Federal long-term rate under section 1274(d) for the quarter — EXTERNAL_DEPENDENCY (Secretary-published rate; case-fact path — the Table 1 path is federal_long_term_rate_from_table_860e2C, used for pinned months)";
}
@source(IRC_S860E_C, quote = "the daily accrual with respect to any residual interest for any day in any calendar quarter shall be determined by allocating to each day in such quarter its ratable portion of the product of—\n(i) the adjusted issue price of such interest at the beginning of such quarter, and\n(ii) 120 percent of the long-term Federal rate (determined on the basis of compounding at the close of each calendar quarter and properly adjusted for the length of such quarter)")
pub relation daily_accruals_sum_for_quarter_860e2A(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "section 860E(c)(2)(A): the sum of the daily accruals for the quarter, assuming the holder held the interest for the full quarter";
}
rule Section860e2ADailyAccrualsSumFullQuarter(holder: Person, remic: Person, q: TaxableYear, issue_price: Money, rate: Decimal) strict {
    label en official "section 860E(c)(2)(A): daily accruals sum for a full quarter = adjusted issue price times 120 percent of the Federal long-term rate";
    when adjusted_issue_price_beginning_of_quarter_860e2B(holder, remic, q, issue_price);
    when federal_long_term_rate_860e2C(remic, q, rate);
    then daily_accruals_sum_for_quarter_860e2A(holder, remic, q, round(issue_price * (rate * 1.20), 2, "HALF_UP"));
}
@source(IRC_S860C_A, quote = "such holder shall take into account his daily portion of the taxable income or net loss of such REMIC for each day during the taxable year on which such holder held such interest")
pub relation amount_taken_into_account_860c_a(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount taken into account by the holder under section 860C(a) with respect to the residual interest for the calendar quarter, per section 860E(c)(1)(A) (section 860C(a)'s own daily-portion allocation machinery is not separately modeled — see the module 14 header)";
}
@source(IRC_S860E_C, quote = "The term \"excess inclusion\" means, with respect to any residual interest in a REMIC for any calendar quarter, the excess (if any) of—\n(A) the amount taken into account with respect to such interest by the holder under section 860C(a), over\n(B) the sum of the daily accruals with respect to such interest for days during such calendar quarter while held by such holder.")
pub relation excess_inclusion(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "section 860E(c)(1): excess inclusion for the calendar quarter — the excess, if any, of the section 860C(a) amount over the sum of daily accruals";
}

// ---- Section 860E(c)(2): Federal long-term rate from the pinned Table 1 ----
// The section 1274(d) Federal long-term rate is published monthly by the IRS in Revenue Rulings. This module
// reads the BASE long-term rate from the us.irs.rev_rul_afr Table 1 contract (afr_table_rate/4) under the
// month-index policy (corpus/laws/us/rev-rul-afr/month-index.json): the rate rule below fires only for a pinned
// month ("2026-08" via Rev. Rul. 2026-13, "2026-10" via Rev. Rul. 2026-19); a month absent from the index
// keeps the case-fact path. Single-issue evaluation worlds are assumed (both pinned issues emit the same
// predicate; world composition is the merge step's). The 120 percent of (c)(2)(A)(ii) stays in the accrual
// rule below (unchanged); the quarterly-compounding basis of (c)(2)(C) selects the Table 1 quarterly column.
// Every rate number comes from the tables — no rate is written here.
relation afr_table_month_860e(m: Text) kind institutional {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue governs a Table 1 lookup: a month pinned in the AFR month-index (the freshest ruling of that month)";
}
rule Section860eAfrMonth202608 strict {
    label en unofficial "August 2026 is a pinned AFR month (Rev. Rul. 2026-13, month-index selection policy)";
    when true;
    then afr_table_month_860e("2026-08");
}
rule Section860eAfrMonth202610 strict {
    label en unofficial "October 2026 is a pinned AFR month (Rev. Rul. 2026-19, month-index selection policy)";
    when true;
    then afr_table_month_860e("2026-10");
}
relation afr_month_for_quarter_860e(remic: Person, q: TaxableYear, m: Text) kind empirical {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue supplies the Federal long-term rate for the calendar quarter (case-selected: the statute names the quarter, not the month)";
}
pub relation federal_long_term_rate_from_table_860e2C(remic: Person, q: TaxableYear, m: Text, rate: Decimal) kind institutional {
    label en official "section 860E(c)(2)(C): the Federal long-term rate from the pinned Table 1 — the long-term base rate with quarterly compounding (section 1274(d) without regard to paragraph (2))";
}
@source(IRC_S860E_C, relation = formalizes, coverage = partial, quote = "120 percent of the long-term Federal rate (determined on the basis of compounding at the close of each calendar quarter and properly adjusted for the length of such quarter)")
rule Section860e2CFederalLongTermRateFromTable(remic: Person, q: TaxableYear, m: Text, rate: Decimal) strict {
    label en official "section 860E(c)(2)(C): the Federal long-term rate for the quarter is the Table 1 long-term base rate with quarterly compounding for a pinned month";
    when afr_month_for_quarter_860e(remic, q, m);
    when afr_table_month_860e(m);
    when us.irs.rev_rul_afr::afr_table_rate("long", "base", "quarterly", rate);
    then federal_long_term_rate_from_table_860e2C(remic, q, m, rate);
}
@source(IRC_S860E_C, quote = "the daily accrual with respect to any residual interest for any day in any calendar quarter shall be determined by allocating to each day in such quarter its ratable portion of the product of—\n(i) the adjusted issue price of such interest at the beginning of such quarter, and\n(ii) 120 percent of the long-term Federal rate (determined on the basis of compounding at the close of each calendar quarter and properly adjusted for the length of such quarter)")
rule Section860e2ADailyAccrualsSumFullQuarterFromTable(holder: Person, remic: Person, q: TaxableYear, m: Text, issue_price: Money, rate: Decimal) strict {
    label en official "section 860E(c)(2)(A): daily accruals sum for a full quarter from the Table 1 long-term rate = adjusted issue price times 120 percent of that rate";
    when adjusted_issue_price_beginning_of_quarter_860e2B(holder, remic, q, issue_price);
    when federal_long_term_rate_from_table_860e2C(remic, q, m, rate);
    then daily_accruals_sum_for_quarter_860e2A(holder, remic, q, round(issue_price * (rate * 1.20), 2, "HALF_UP"));
}
rule Section860e1ExcessInclusion(holder: Person, remic: Person, q: TaxableYear, taken_into_account: Money, accruals: Money) strict {
    label en official "section 860E(c)(1): excess inclusion = section 860C(a) amount minus daily accruals sum, when positive";
    when amount_taken_into_account_860c_a(holder, remic, q, taken_into_account);
    when daily_accruals_sum_for_quarter_860e2A(holder, remic, q, accruals);
    when taken_into_account > accruals;
    then excess_inclusion(holder, remic, q, taken_into_account - accruals);
}

// ---- Section 860F(a): 100 percent tax on prohibited transactions ----

pub relation gross_income_from_prohibited_transactions_860f(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income from section 860F(a)(2) prohibited transactions for the taxable year";
}
pub relation deductions_connected_with_prohibited_transactions_860f(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deductions directly connected with section 860F(a)(2) prohibited transactions, per section 860F(a)(3)";
}
@source(IRC_S860F_A, quote = "the term \"net income derived from prohibited transactions\" means the excess of the gross income from prohibited transactions over the deductions allowed by this chapter which are directly connected with such transactions; except that there shall not be taken into account any item attributable to any prohibited transaction for which there was a loss")
pub relation net_income_from_prohibited_transactions_860f(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 860F(a)(3): net income from prohibited transactions (the loss-transaction exclusion is not separately modeled)";
}
rule Section860f3NetIncomeFromProhibitedTransactions(c: Person, y: TaxableYear, gross: Money, deductions: Money) strict {
    label en official "section 860F(a)(3): net income = gross income from prohibited transactions minus directly connected deductions, when positive";
    when gross_income_from_prohibited_transactions_860f(c, y, gross);
    when deductions_connected_with_prohibited_transactions_860f(c, y, deductions);
    when gross > deductions;
    then net_income_from_prohibited_transactions_860f(c, y, gross - deductions);
}
@source(IRC_S860F_A, quote = "There is hereby imposed for each taxable year of a REMIC a tax equal to 100 percent of the net income derived from prohibited transactions.")
pub relation remic_prohibited_transaction_tax_860f(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 860F(a)(1): the 100 percent tax on net income from prohibited transactions";
}
rule Section860f1ProhibitedTransactionTax(c: Person, y: TaxableYear, net_income: Money) strict {
    label en official "section 860F(a)(1): the tax equals 100 percent of net income from prohibited transactions";
    when net_income_from_prohibited_transactions_860f(c, y, net_income);
    then remic_prohibited_transaction_tax_860f(c, y, net_income);
}
