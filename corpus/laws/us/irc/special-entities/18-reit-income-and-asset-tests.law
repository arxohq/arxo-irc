// Section 856(b), (c)(1)-(9) beyond stage 1: the 335-day ownership timing
// rule, the item-level 95 percent and 75 percent gross income tests (the
// stage 1 module keeps the aggregate-figure form; this module derives the
// same result from itemised income), the item-level asset tests per
// quarter, the per-issuer 5/10/10 percent limits, qualified temporary
// investment income, the REMIC look-through, the income and asset failure
// reliefs with their taxes, the post-reorganization election bar and the
// ancillary personal property rules; and the Pub. L. 119-21 sec. 70439
// change of the taxable REIT subsidiary ceiling. Stage 2c (IRC-09 stage 2c,
// A12), 26.09.2026. Status implemented_unverified.
//
// METHOD. Gross income is itemised: each item carries a `ReitIncomeKind`
// and an amount, prohibited-transaction gain is excluded from both
// numerator and denominator, and `sum all` builds the two aggregates. The
// item's kind is a classification the case asserts from sections 856(c)(2),
// (c)(3) and (d); module 13 supplies the year-level rents aggregate for
// section 856(d) and is not re-derived per item. Asset tests are per
// quarter (`us.irc.core::Period`); "at the close of each quarter" over all
// four quarters is a universal test the language expresses only through
// per-quarter results (TECH-GAPS G2205).

use self::{
    IRC_S856_B,
    IRC_S856_C,
    IRC_S856_H,
    Person,
    TaxableYear,
    ninety_five_percent_income_test_met_856c2,
    seventy_five_percent_income_test_met_856c3,
    taxable_reit_subsidiary_securities_value,
    tenant_service_income_856d7A,
    total_assets_value_856,
};

pub enum ReitIncomeKind {
    ReitDividend;
    ReitInterest;
    ReitMortgageInterest;
    ReitRentsFromRealProperty;
    ReitGainOnStockSecuritiesOrRealProperty;
    ReitGainOnRealProperty;
    ReitTaxAbatementOrRefund;
    ReitForeclosurePropertyIncome;
    ReitCommitmentFee;
    ReitGainOnRealEstateAssetNotProhibitedSolelyBy857b6;
    ReitTimberMineralRoyalty;
    ReitShareDistributionOrGain;
    ReitQualifiedTemporaryInvestmentIncome;
    ReitProhibitedTransactionGain;
    ReitRealEstateForeignExchangeGain;
    ReitPassiveForeignExchangeGain;
    ReitOtherIncome;
    ReitHedgingIncome;
    ReitTimberGain;
    label en unofficial "the class of a gross income item of a real estate investment trust for the sections 856(c)(2) and (c)(3) tests";
}

pub relation reit_gross_income_item(t: Person, y: TaxableYear, item: us.irc.core::Payment, kind: ReitIncomeKind, amount: Money) kind empirical {
    label en unofficial "an item of the trust's gross income for the taxable year, with its class and amount";
}
pub relation interest_item_depends_on_income_or_profits_856f1(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount of the interest depends in whole or in part on the income or profits of any person";
}
pub relation interest_item_fixed_percentage_of_receipts_or_sales_856f1A(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount is based on a fixed percentage or percentages of receipts or sales";
}
// (c)(2): 95 percent test items.
pub relation itemized_gross_income_for_856c2(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item of gross income for the section 856(c)(2) percentage: not gross income from prohibited transactions and not passive foreign exchange gain (section 856(n)(1)(A))";
}
rule Section856c2ItemCountsInGrossIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, kind: ReitIncomeKind, amount: Money) strict {
    label en official "sections 856(c)(2), (n)(1)(A): every item other than prohibited-transaction gain and passive foreign exchange gain is gross income for the 95 percent test";
    when reit_gross_income_item(t, y, item, kind, amount);
    when kind != ReitProhibitedTransactionGain;
    when kind != ReitPassiveForeignExchangeGain;
    when kind != ReitRealEstateForeignExchangeGain;
    when kind != ReitHedgingIncome;
    then itemized_gross_income_for_856c2(t, y, item, amount);
}
pub relation itemized_gross_income_for_856c3(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item of gross income for the section 856(c)(3) percentage: not gross income from prohibited transactions and not real estate foreign exchange gain (section 856(n)(1)(B)); passive foreign exchange gain that is not real estate foreign exchange gain still counts in the denominator";
}
rule Section856c3ItemCountsInGrossIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, kind: ReitIncomeKind, amount: Money) strict {
    label en official "sections 856(c)(3), (n)(1)(B): every item other than prohibited-transaction gain and real estate foreign exchange gain is gross income for the 75 percent test";
    when reit_gross_income_item(t, y, item, kind, amount);
    when kind != ReitProhibitedTransactionGain;
    when kind != ReitRealEstateForeignExchangeGain;
    when kind != ReitHedgingIncome;
    then itemized_gross_income_for_856c3(t, y, item, amount);
}
pub relation itemized_qualifying_item_856c2(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item derived from a section 856(c)(2)(A)-(I) source";
}
rule Section856c2ADividends(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(A): dividends";
    when reit_gross_income_item(t, y, item, ReitDividend, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2BInterestNotProfitDependent(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(B): interest that does not depend on income or profits (section 856(f)(1))";
    when reit_gross_income_item(t, y, item, ReitInterest, amount);
    when not_known(interest_item_depends_on_income_or_profits_856f1(item));
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2BInterestFixedPercentage(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(B): interest based on a fixed percentage of receipts or sales (section 856(f)(1)(A))";
    when reit_gross_income_item(t, y, item, ReitInterest, amount);
    when interest_item_depends_on_income_or_profits_856f1(item);
    when interest_item_fixed_percentage_of_receipts_or_sales_856f1A(item);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2BMortgageInterestNotProfitDependent(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(B): interest that does not depend on income or profits (section 856(f)(1))";
    when reit_gross_income_item(t, y, item, ReitMortgageInterest, amount);
    when not_known(interest_item_depends_on_income_or_profits_856f1(item));
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2BMortgageInterestFixedPercentage(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(B): interest based on a fixed percentage of receipts or sales (section 856(f)(1)(A))";
    when reit_gross_income_item(t, y, item, ReitMortgageInterest, amount);
    when interest_item_depends_on_income_or_profits_856f1(item);
    when interest_item_fixed_percentage_of_receipts_or_sales_856f1A(item);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2CRents(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(C): rents from real property (the item is classified by the case under section 856(d))";
    when reit_gross_income_item(t, y, item, ReitRentsFromRealProperty, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2DGainOnStockSecuritiesRealProperty(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(D): gain on stock, securities and real property not held as dealer property";
    when reit_gross_income_item(t, y, item, ReitGainOnStockSecuritiesOrRealProperty, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2DGainOnRealPropertyAlso(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(D): gain on real property is within the class of gain on stock, securities and real property";
    when reit_gross_income_item(t, y, item, ReitGainOnRealProperty, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2ETaxAbatements(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(E): abatements and refunds of taxes on real property";
    when reit_gross_income_item(t, y, item, ReitTaxAbatementOrRefund, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2FForeclosureIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(F): income and gain from foreclosure property";
    when reit_gross_income_item(t, y, item, ReitForeclosurePropertyIncome, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2GCommitmentFees(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(G): consideration for agreements to make mortgage loans or to purchase or lease real property (not depending on income or profits)";
    when reit_gross_income_item(t, y, item, ReitCommitmentFee, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2HGainOnRealEstateAsset(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(H): gain on a real estate asset that is not a prohibited transaction solely by reason of section 857(b)(6)";
    when reit_gross_income_item(t, y, item, ReitGainOnRealEstateAssetNotProhibitedSolelyBy857b6, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2ITimberMineralRoyalty(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(2)(I): mineral royalty income of a timber REIT";
    when reit_gross_income_item(t, y, item, ReitTimberMineralRoyalty, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856c2DReitShareDistribution(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "sections 856(c)(2)(A),(D): distributions on, and gain on, shares of other REITs are dividends or gain on securities";
    when reit_gross_income_item(t, y, item, ReitShareDistributionOrGain, amount);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
pub relation itemized_gross_income_total_856c2(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total gross income for the 95 percent test, from the itemised income";
}
rule Section856c2TotalGrossIncome(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(2): the sum of the items counted for the 95 percent test";
    when itemized_gross_income_for_856c2(t, y, _, _);
    then itemized_gross_income_total_856c2(t, y, sum(collect all amount: Money, item: us.irc.core::Payment where itemized_gross_income_for_856c2(t, y, item, amount), empty: 0.00 USD) + sum(collect all ts: Money, ast: us.irc.core::Asset where tenant_service_income_856d7A(t, y, ast, ts), empty: 0.00 USD));
}
pub relation itemized_gross_income_total_856c3(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total gross income for the 75 percent test, from the itemised income";
}
rule Section856c3TotalGrossIncome(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(3): the sum of the items counted for the 75 percent test";
    when itemized_gross_income_for_856c3(t, y, _, _);
    then itemized_gross_income_total_856c3(t, y, sum(collect all amount: Money, item: us.irc.core::Payment where itemized_gross_income_for_856c3(t, y, item, amount), empty: 0.00 USD) + sum(collect all ts3: Money, ast3: us.irc.core::Asset where tenant_service_income_856d7A(t, y, ast3, ts3), empty: 0.00 USD));
}
pub relation itemized_qualifying_income_total_856c2(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income derived from section 856(c)(2) sources, from the itemised income";
}
rule Section856c2QualifyingTotal(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(2): the sum of the qualifying items";
    when itemized_qualifying_item_856c2(t, y, _, _);
    then itemized_qualifying_income_total_856c2(t, y, sum all amount: Money for item: us.irc.core::Payment where itemized_qualifying_item_856c2(t, y, item, amount));
}
@source(IRC_S856_C, quote = "at least 95 percent (90 percent for taxable years beginning before January 1, 1980) of its gross income (excluding gross income from prohibited transactions) is derived from")
rule Section856c2ItemizedNinetyFivePercent(t: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(2): at least 95 percent of gross income (excluding prohibited transactions) derives from the listed sources, computed from itemised income";
    when itemized_qualifying_income_total_856c2(t, y, qualifying);
    when itemized_gross_income_total_856c2(t, y, total);
    when qualifying * 100.0 >= total * 95.0;
    then ninety_five_percent_income_test_met_856c2(t, y);
}

// (c)(3): 75 percent test items.
pub relation itemized_qualifying_item_856c3(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item derived from a section 856(c)(3)(A)-(I) source";
}
rule Section856c3ARents(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(A): rents from real property";
    when reit_gross_income_item(t, y, item, ReitRentsFromRealProperty, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3BMortgageInterestNotProfitDependent(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(B): interest that does not depend on income or profits (section 856(f)(1))";
    when reit_gross_income_item(t, y, item, ReitMortgageInterest, amount);
    when not_known(interest_item_depends_on_income_or_profits_856f1(item));
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3BMortgageInterestFixedPercentage(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(B): interest based on a fixed percentage of receipts or sales (section 856(f)(1)(A))";
    when reit_gross_income_item(t, y, item, ReitMortgageInterest, amount);
    when interest_item_depends_on_income_or_profits_856f1(item);
    when interest_item_fixed_percentage_of_receipts_or_sales_856f1A(item);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3CGainOnRealProperty(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(C): gain on real property and mortgages on real property, not dealer property";
    when reit_gross_income_item(t, y, item, ReitGainOnRealProperty, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3DReitShares(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(D): distributions on, and gain on, shares of other qualifying REITs";
    when reit_gross_income_item(t, y, item, ReitShareDistributionOrGain, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3ETaxAbatements(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(E): abatements and refunds of taxes on real property";
    when reit_gross_income_item(t, y, item, ReitTaxAbatementOrRefund, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3FForeclosureIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(F): income and gain from foreclosure property";
    when reit_gross_income_item(t, y, item, ReitForeclosurePropertyIncome, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3GCommitmentFees(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(G): consideration for agreements to make mortgage loans or to purchase or lease real property";
    when reit_gross_income_item(t, y, item, ReitCommitmentFee, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
pub relation gain_is_on_nonqualified_publicly_offered_reit_debt_856c3H(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the gain is from a nonqualified publicly offered REIT debt instrument";
}
rule Section856c3HGainOnRealEstateAsset(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(H): gain on a real estate asset (other than a nonqualified publicly offered REIT debt instrument) that is not a prohibited transaction solely by reason of section 857(b)(6)";
    when reit_gross_income_item(t, y, item, ReitGainOnRealEstateAssetNotProhibitedSolelyBy857b6, amount);
    when not_known(gain_is_on_nonqualified_publicly_offered_reit_debt_856c3H(item));
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
rule Section856c3IQualifiedTemporaryInvestmentIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(3)(I): qualified temporary investment income";
    when reit_gross_income_item(t, y, item, ReitQualifiedTemporaryInvestmentIncome, amount);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
pub relation itemized_qualifying_income_total_856c3(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income derived from section 856(c)(3) sources, from the itemised income";
}
rule Section856c3QualifyingTotal(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(3): the sum of the qualifying items";
    when itemized_qualifying_item_856c3(t, y, _, _);
    then itemized_qualifying_income_total_856c3(t, y, sum all amount: Money for item: us.irc.core::Payment where itemized_qualifying_item_856c3(t, y, item, amount));
}
@source(IRC_S856_C, quote = "at least 75 percent of its gross income (excluding gross income from prohibited transactions) is derived from")
rule Section856c3ItemizedSeventyFivePercent(t: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(3): at least 75 percent of gross income (excluding prohibited transactions) derives from the listed sources, computed from itemised income";
    when itemized_qualifying_income_total_856c3(t, y, qualifying);
    when itemized_gross_income_total_856c3(t, y, total);
    when qualifying * 100.0 >= total * 75.0;
    then seventy_five_percent_income_test_met_856c3(t, y);
}

// (c)(5)(D): qualified temporary investment income.
pub relation new_capital_received_on_856c5D(t: Person, y: TaxableYear, capital: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the trust receives new capital: an amount received in exchange for its shares or beneficial interests (not under a dividend reinvestment plan) or in a public offering of debt with maturities of at least 5 years";
}
pub relation temp_income_attributable_to_stock_or_debt_856c5D(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the income is attributable to stock or a debt instrument (section 1275(a)(1))";
}
pub relation temp_income_from_temporary_investment_of_capital_856c5D(item: us.irc.core::Payment, capital: us.irc.core::Payment) kind empirical {
    label en unofficial "the income is attributable to the temporary investment of the new capital";
}
pub relation temp_income_received_or_accrued_on_856c5D(item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date the income is received or accrued";
}
pub relation qualified_temporary_investment_income_856c5D(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the income is qualified temporary investment income";
}
@source(IRC_S856_C, quote = "is received or accrued during the 1-year period beginning on the date on which the real estate investment trust receives such capital")
rule Section856c5DQualifiedTemporaryInvestmentIncome(t: Person, y: TaxableYear, item: us.irc.core::Payment, capital: us.irc.core::Payment, received_on: Date, accrued_on: Date) strict {
    label en official "section 856(c)(5)(D): income from stock or debt attributable to the temporary investment of new capital, received or accrued within one year of receiving the capital";
    when temp_income_attributable_to_stock_or_debt_856c5D(item);
    when temp_income_from_temporary_investment_of_capital_856c5D(item, capital);
    when new_capital_received_on_856c5D(t, y, capital, received_on);
    when temp_income_received_or_accrued_on_856c5D(item, accrued_on);
    when accrued_on >= received_on;
    when accrued_on < add_calendar_period(received_on, 12 calendar_month);
    then qualified_temporary_investment_income_856c5D(t, y, item);
}

// (c)(5)(E): REMIC interests.
pub relation remic_interest_income_amount_856c5E(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount includible in gross income with respect to a regular or residual interest in a REMIC";
}
pub relation remic_real_estate_asset_percentage_856c5E(item: us.irc.core::Payment, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the assets of the REMIC that are real estate assets";
}
pub relation remic_interest_income_treated_as_mortgage_interest_856c5E(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the REMIC interest income treated as interest on an obligation secured by a mortgage on real property";
}
@source(IRC_S856_C, quote = "any amount includible in gross income with respect to such an interest shall be treated as interest on an obligation secured by a mortgage on real property")
rule Section856c5EFullyQualifyingRemic(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, pct: Decimal) strict {
    label en official "section 856(c)(5)(E): the whole amount when at least 95 percent of the REMIC's assets are real estate assets";
    when remic_interest_income_amount_856c5E(t, y, item, amount);
    when remic_real_estate_asset_percentage_856c5E(item, pct);
    when pct >= 95.0;
    then remic_interest_income_treated_as_mortgage_interest_856c5E(t, y, item, amount);
}
@source(IRC_S856_C, quote = "except that, if less than 95 percent of the assets of such REMIC are real estate assets")
rule Section856c5EProportionateRemic(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, pct: Decimal) strict {
    label en official "section 856(c)(5)(E): only the proportionate part when less than 95 percent of the REMIC's assets are real estate assets";
    when remic_interest_income_amount_856c5E(t, y, item, amount);
    when remic_real_estate_asset_percentage_856c5E(item, pct);
    when pct < 95.0;
    then remic_interest_income_treated_as_mortgage_interest_856c5E(t, y, item, div_round(amount * pct, 100.0, 2, "HALF_UP"));
}

// ---- Section 856(b): the timing of the organizational conditions ----

pub relation days_100_or_more_beneficial_owners_856b(t: Person, y: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days of the taxable year on which the beneficial ownership is held by 100 or more persons";
}
pub relation taxable_year_length_days_856b(t: Person, y: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days in the taxable year";
}
pub relation conditions_1_to_4_met_throughout_year_856b(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the conditions of section 856(a)(1)-(4) are met during the entire taxable year";
}
pub relation condition_5_timing_met_856b(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(a)(5) condition exists during at least 335 days of a 12-month year, or a proportionate part of a shorter year";
}
@source(IRC_S856_B, quote = "the condition described in paragraph (5) must exist during at least 335 days of a taxable year of 12 months")
rule Section856bFullYearThreeThirtyFiveDays(t: Person, y: TaxableYear, days: Integer) strict {
    label en official "section 856(b): at least 335 days for a taxable year of 12 months";
    when days_100_or_more_beneficial_owners_856b(t, y, days);
    when days >= 335;
    when not_known(us.irc.core::short_year(y));
    then condition_5_timing_met_856b(t, y);
}
// JUDGMENT CALL (INTERPRETATION): "a proportionate part of a taxable year of
// less than 12 months" is read as 335/365 of the short year's length.
@source(IRC_S856_B, quote = "or during a proportionate part of a taxable year of less than 12 months")
rule Section856bShortYearProportion(t: Person, y: TaxableYear, days: Integer, length: Integer) strict {
    label en official "section 856(b): a proportionate part of 335 days for a short taxable year";
    when us.irc.core::short_year(y);
    when days_100_or_more_beneficial_owners_856b(t, y, days);
    when taxable_year_length_days_856b(t, y, length);
    when days * 365 >= length * 335;
    then condition_5_timing_met_856b(t, y);
}
pub relation organizational_conditions_timing_met_856b(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(b) timing of the section 856(a) conditions is met (the first electing year is exempt from conditions (5) and (6) under section 856(h)(2))";
}
rule Section856bTimingMetOrdinaryYear(t: Person, y: TaxableYear) strict {
    label en official "section 856(b): conditions (1)-(4) throughout the year and condition (5) for 335 days";
    when conditions_1_to_4_met_throughout_year_856b(t, y);
    when condition_5_timing_met_856b(t, y);
    then organizational_conditions_timing_met_856b(t, y);
}
pub relation first_year_of_reit_election_856h2(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year is the first taxable year for which an election is made under section 856(c)(1)";
}
@source(IRC_S856_H, quote = "Paragraphs (5) and (6) of subsection (a) shall not apply to the 1st taxable year for which an election is made under subsection (c)(1)")
rule Section856h2FirstElectionYearExemption(t: Person, y: TaxableYear) strict {
    label en official "section 856(h)(2): conditions (5) and (6) do not apply to the first electing year, so the timing test needs only conditions (1)-(4)";
    when conditions_1_to_4_met_throughout_year_856b(t, y);
    when first_year_of_reit_election_856h2(t, y);
    then organizational_conditions_timing_met_856b(t, y);
}

// ---- Section 856(c)(4): per-quarter asset tests ----

pub enum ReitAssetKind {
    ReitRealProperty;
    ReitInterestInRealProperty;
    ReitMortgageOnRealProperty;
    ReitSharesOfOtherReit;
    ReitPubliclyOfferedReitDebt;
    ReitCashOrReceivable;
    ReitGovernmentSecurity;
    ReitTaxableReitSubsidiarySecurity;
    ReitOtherSecurity;
    ReitOtherAsset;
    ReitForeignCurrencyFunctional;
    label en unofficial "the class of an asset of a real estate investment trust for the section 856(c)(4) tests";
}
pub relation reit_asset_item_at_quarter_close(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, kind: ReitAssetKind, value: Money) kind empirical {
    label en unofficial "an asset of the trust at the close of the quarter, with its class and value (section 856(c)(5)(A))";
}
pub relation quarter_asset_item_75_percent_class_856c4A(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) kind institutional {
    label en official "an asset that is a real estate asset, cash or cash item (including receivables) or a Government security";
}
rule Section856c4ARealProperty(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "sections 856(c)(4)(A), (c)(5)(B): real property is a real estate asset";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitRealProperty, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4AInterestInRealProperty(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(5)(B),(C): interests in real property are real estate assets";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitInterestInRealProperty, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4AMortgage(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(5)(B): interests in mortgages on real property are real estate assets";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitMortgageOnRealProperty, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4AReitShares(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(5)(B): shares of other REITs meeting part II are real estate assets";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitSharesOfOtherReit, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4APubliclyOfferedReitDebt(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(5)(B): debt instruments issued by publicly offered REITs are real estate assets";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitPubliclyOfferedReitDebt, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4ACash(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(4)(A): cash and cash items (including receivables)";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitCashOrReceivable, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
rule Section856c4AGovernmentSecurities(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(4)(A): Government securities";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitGovernmentSecurity, value);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}
pub relation quarter_total_assets_value_856c4(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the total value of the trust's assets at the close of the quarter, from the itemised assets";
}
rule Section856c4QuarterTotal(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "section 856(c)(4): the sum of all itemised asset values at the quarter close";
    when reit_asset_item_at_quarter_close(t, y, q, _, _, _);
    then quarter_total_assets_value_856c4(t, y, q, sum all value: Money for asset: us.irc.core::Asset where reit_asset_item_at_quarter_close(t, y, q, asset, _, value));
}
pub relation quarter_qualifying_assets_value_856c4A(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the value of real estate assets, cash items and Government securities at the quarter close";
}
rule Section856c4AQuarterQualifyingTotal(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "section 856(c)(4)(A): the sum of the 75-percent-class assets";
    when quarter_asset_item_75_percent_class_856c4A(t, y, q, _, _);
    then quarter_qualifying_assets_value_856c4A(t, y, q, sum all value: Money for asset: us.irc.core::Asset where quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value));
}
pub relation quarter_seventy_five_percent_asset_test_met_856c4A(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "at the close of the quarter at least 75 percent of the value of total assets is real estate assets, cash items and Government securities";
}
@source(IRC_S856_C, quote = "at least 75 percent of the value of its total assets is represented by real estate assets, cash and cash items (including receivables), and Government securities")
rule Section856c4AQuarterTest(t: Person, y: TaxableYear, q: us.irc.core::Period, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(4)(A): the 75 percent test at a quarter close, from itemised assets";
    when quarter_qualifying_assets_value_856c4A(t, y, q, qualifying);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when qualifying * 100.0 >= total * 75.0;
    then quarter_seventy_five_percent_asset_test_met_856c4A(t, y, q);
}
pub relation quarter_trs_securities_value_856c4Bii(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the value of securities of taxable REIT subsidiaries at the quarter close";
}
rule Section856c4BiiQuarterTrsValue(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "section 856(c)(4)(B)(ii): the sum of taxable REIT subsidiary securities";
    when reit_asset_item_at_quarter_close(t, y, q, _, ReitTaxableReitSubsidiarySecurity, _);
    then quarter_trs_securities_value_856c4Bii(t, y, q, sum all value: Money for asset: us.irc.core::Asset where reit_asset_item_at_quarter_close(t, y, q, asset, ReitTaxableReitSubsidiarySecurity, value));
}
pub relation quarter_trs_ceiling_met_856c4Bii(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "taxable REIT subsidiary securities are within the ceiling at the quarter close: 20 percent of total assets (25 percent for taxable years beginning after December 31, 2025, Pub. L. 119-21 sec. 70439)";
}
@source(IRC_S856_C, quote = "not more than 20 percent of the value of its total assets is represented by securities of one or more taxable REIT subsidiaries")
rule Section856c4BiiTwentyPercentCeilingPinned(t: Person, y: TaxableYear, q: us.irc.core::Period, trs: Money, total: Money, begins_on: Date) strict {
    label en official "section 856(c)(4)(B)(ii), pinned 2024 text: at most 20 percent of total assets, for years beginning on or before 2025-12-31";
    when quarter_trs_securities_value_856c4Bii(t, y, q, trs);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when us.irc.core::begins(y, begins_on);
    when begins_on <= @2025-12-31;
    when trs * 100.0 <= total * 20.0;
    then quarter_trs_ceiling_met_856c4Bii(t, y, q);
}
@source(us.irc.temporal::PL119_21_S70439, quote = "Section 856(c)(4)(B)(ii) is amended by striking “20 percent” and inserting “25 percent”.")
rule Section856c4BiiTwentyFivePercentCeilingPL119_21(t: Person, y: TaxableYear, q: us.irc.core::Period, trs: Money, total: Money, begins_on: Date) strict {
    effective [@2025-07-04, infinity);
    label en official "Pub. L. 119-21 sec. 70439: at most 25 percent of total assets for taxable years beginning after 2025-12-31";
    when quarter_trs_securities_value_856c4Bii(t, y, q, trs);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2025-12-31;
    when trs * 100.0 <= total * 25.0;
    then quarter_trs_ceiling_met_856c4Bii(t, y, q);
}
pub relation quarter_other_securities_value_856c4Bi(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the value of securities (other than those includible under subparagraph (A) and other than taxable REIT subsidiary securities) at the quarter close";
}
pub relation quarter_nonqualified_publicly_offered_reit_debt_value_856c4Biii(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the value of nonqualified publicly offered REIT debt instruments at the quarter close";
}
pub relation quarter_other_ceilings_met_856c4Bi_iii(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "the 25 percent ceilings of section 856(c)(4)(B)(i) and (iii) are met at the quarter close";
}
rule Section856c4BiIiiQuarterCeilings(t: Person, y: TaxableYear, q: us.irc.core::Period, other: Money, debt: Money, total: Money) strict {
    label en official "section 856(c)(4)(B)(i),(iii): other securities and nonqualified publicly offered REIT debt each at most 25 percent of total assets";
    when quarter_other_securities_value_856c4Bi(t, y, q, other);
    when quarter_nonqualified_publicly_offered_reit_debt_value_856c4Biii(t, y, q, debt);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when other * 100.0 <= total * 25.0;
    when debt * 100.0 <= total * 25.0;
    then quarter_other_ceilings_met_856c4Bi_iii(t, y, q);
}

// (c)(4)(B)(iv): per-issuer limits.
pub relation issuer_securities_value_856c4Biv(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, value: Money) kind empirical {
    label en unofficial "the value of the securities of one issuer held by the trust at the quarter close";
}
pub relation issuer_voting_power_percent_held_856c4BivII(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the total voting power of the issuer's outstanding securities that the trust's securities possess";
}
pub relation issuer_value_percent_held_856c4BivIII(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the total value of the issuer's outstanding securities that the trust's securities have (after section 856(m))";
}
pub relation issuer_exempt_from_856c4Biv(issuer: Person) kind empirical {
    label en unofficial "the issuer is a taxable REIT subsidiary, or the securities are includible under subparagraph (A)";
}
pub relation issuer_limit_breached_856c4Biv(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person) kind institutional {
    label en official "the trust breaches a per-issuer limit of section 856(c)(4)(B)(iv) at the quarter close";
}
@source(IRC_S856_C, quote = "not more than 5 percent of the value of its total assets is represented by securities of any one issuer")
rule Section856c4BivIFivePercentBreach(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, value: Money, total: Money) strict {
    label en official "section 856(c)(4)(B)(iv)(I): securities of one issuer above 5 percent of total assets";
    when issuer_securities_value_856c4Biv(t, y, q, issuer, value);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when value * 100.0 > total * 5.0;
    when not_known(issuer_exempt_from_856c4Biv(issuer));
    then issuer_limit_breached_856c4Biv(t, y, q, issuer);
}
@source(IRC_S856_C, quote = "the trust does not hold securities possessing more than 10 percent of the total voting power of the outstanding securities of any one issuer")
rule Section856c4BivIITenPercentVotingBreach(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, pct: Decimal) strict {
    label en official "section 856(c)(4)(B)(iv)(II): securities with more than 10 percent of one issuer's voting power";
    when issuer_voting_power_percent_held_856c4BivII(t, y, q, issuer, pct);
    when pct > 10.0;
    when not_known(issuer_exempt_from_856c4Biv(issuer));
    then issuer_limit_breached_856c4Biv(t, y, q, issuer);
}
@source(IRC_S856_C, quote = "the trust does not hold securities having a value of more than 10 percent of the total value of the outstanding securities of any one issuer")
rule Section856c4BivIIITenPercentValueBreach(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person, pct: Decimal) strict {
    label en official "section 856(c)(4)(B)(iv)(III): securities with more than 10 percent of the value of one issuer's securities";
    when issuer_value_percent_held_856c4BivIII(t, y, q, issuer, pct);
    when pct > 10.0;
    when not_known(issuer_exempt_from_856c4Biv(issuer));
    then issuer_limit_breached_856c4Biv(t, y, q, issuer);
}
pub relation has_issuer_limit_breach_856c4Biv(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "helper binding the open issuer argument: some issuer limit is breached at the quarter close";
}
rule Section856c4BivHelperHasBreach(t: Person, y: TaxableYear, q: us.irc.core::Period, issuer: Person) strict {
    label en official "helper: a breach exists for some issuer";
    when issuer_limit_breached_856c4Biv(t, y, q, issuer);
    then has_issuer_limit_breach_856c4Biv(t, y, q);
}
pub relation all_issuers_reviewed_856c4Biv(t: Person, y: TaxableYear, q: us.irc.core::Period) kind empirical {
    label en unofficial "the case supplies the position in every issuer the trust holds at the quarter close (completeness of the issuer listing; absence of a breach is not read from an absent issuer)";
}
pub relation quarter_issuer_limits_met_856c4Biv(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "no per-issuer limit of section 856(c)(4)(B)(iv) is breached at the quarter close";
}
rule Section856c4BivNoBreach(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "section 856(c)(4)(B)(iv): the per-issuer limits are met when every issuer is reviewed and none breaches";
    when all_issuers_reviewed_856c4Biv(t, y, q);
    when not_known(has_issuer_limit_breach_856c4Biv(t, y, q));
    then quarter_issuer_limits_met_856c4Biv(t, y, q);
}
pub relation quarter_asset_tests_met_856c4(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "all of the section 856(c)(4) asset tests are met at the close of the quarter";
}
rule Section856c4QuarterAllTests(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "section 856(c)(4): the 75 percent test, the 25/20(25)/25 ceilings and the issuer limits at the quarter close";
    when quarter_seventy_five_percent_asset_test_met_856c4A(t, y, q);
    when quarter_trs_ceiling_met_856c4Bii(t, y, q);
    when quarter_other_ceilings_met_856c4Bi_iii(t, y, q);
    when quarter_issuer_limits_met_856c4Biv(t, y, q);
    then quarter_asset_tests_met_856c4(t, y, q);
}

// ---- Section 856(c)(6)-(7): failure reliefs ----

pub relation income_test_schedule_filed_856c6A(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "a description of each item of gross income described in paragraphs (2) and (3) is set forth in a schedule for the taxable year filed in the manner provided by the Secretary";
}
external judgment relation reit_failure_due_to_reasonable_cause_not_willful_neglect(t: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the failure is due to reasonable cause and not due to willful neglect (sections 856(c)(6)(B), (c)(7)(A)(ii), (g)(4)(C), (g)(5)(B)); an evaluative element, DECISION-0194 channel 1";
}
pub relation reit_income_tests_deemed_satisfied_856c6(t: Person, y: TaxableYear) kind institutional {
    label en official "the trust is considered to have satisfied the requirements of paragraphs (2) and (3) for the taxable year";
}
@source(IRC_S856_C, quote = "shall nevertheless be considered to have satisfied the requirements of such paragraphs for such taxable year if")
rule Section856c6IncomeTestRelief(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(6): a schedule and reasonable cause cure a failure of the income tests";
    when income_test_schedule_filed_856c6A(t, y);
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    then reit_income_tests_deemed_satisfied_856c6(t, y);
}
pub relation quarter_ended_on_856c7(q: us.irc.core::Period, last_day: Date) kind empirical {
    label en unofficial "the last day of the quarter in which the identification of the failure occurred";
}
pub relation asset_failure_schedule_filed_856c7A(t: Person, y: TaxableYear, q: us.irc.core::Period) kind empirical {
    label en unofficial "a description of each asset causing the failure is set forth in a schedule for the quarter filed in the manner provided by the Secretary";
}
pub relation failing_assets_disposed_on_856c7(t: Person, y: TaxableYear, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the trust disposes of the scheduled assets on this date";
}
pub relation asset_requirements_otherwise_met_by_856c7(t: Person, y: TaxableYear, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the requirements of paragraph (4) are otherwise met on this date";
}
pub relation reit_asset_failure_deemed_cured_856c7A(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "the trust is considered to have satisfied paragraph (4) for the quarter (failures other than a de minimis (B)(iv) failure)";
}
@source(IRC_S856_C, quote = "disposes of the assets set forth on the schedule specified in clause (i) within 6 months after the last day of the quarter")
rule Section856c7ACureByDisposal(t: Person, y: TaxableYear, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 856(c)(7)(A): schedule, reasonable cause and disposal within 6 months of the quarter end";
    when asset_failure_schedule_filed_856c7A(t, y, q);
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    when quarter_ended_on_856c7(q, last_day);
    when failing_assets_disposed_on_856c7(t, y, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then reit_asset_failure_deemed_cured_856c7A(t, y, q);
}
rule Section856c7ACureByOtherwiseMet(t: Person, y: TaxableYear, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 856(c)(7)(A)(iii)(II): the requirements are otherwise met within 6 months";
    when asset_failure_schedule_filed_856c7A(t, y, q);
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    when quarter_ended_on_856c7(q, last_day);
    when asset_requirements_otherwise_met_by_856c7(t, y, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then reit_asset_failure_deemed_cured_856c7A(t, y, q);
}
pub relation reit_failing_assets_value_856c7B(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the total value of the assets whose ownership causes the section 856(c)(4)(B)(iv) failure";
}
pub relation reit_de_minimis_failure_856c7B(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "the (B)(iv) failure is due to assets not exceeding the lesser of 1 percent of total assets and $10,000,000";
}
@source(IRC_S856_C, quote = "1 percent of the total value of the trust's assets at the end of the quarter for which such measurement is done")
rule Section856c7BDeMinimis(t: Person, y: TaxableYear, q: us.irc.core::Period, failing: Money, total: Money) strict {
    label en official "section 856(c)(7)(B)(i): failing assets at most 1 percent of total assets and $10,000,000";
    when reit_failing_assets_value_856c7B(t, y, q, failing);
    when quarter_total_assets_value_856c4(t, y, q, total);
    when failing * 100.0 <= total;
    when failing <= 10000000.00 USD;
    then reit_de_minimis_failure_856c7B(t, y, q);
}
pub relation reit_de_minimis_failure_deemed_cured_856c7B(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "the de minimis (B)(iv) failure is considered cured";
}
rule Section856c7BCureByDisposal(t: Person, y: TaxableYear, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 856(c)(7)(B)(ii)(I): disposal within 6 months of the quarter end";
    when reit_de_minimis_failure_856c7B(t, y, q);
    when quarter_ended_on_856c7(q, last_day);
    when failing_assets_disposed_on_856c7(t, y, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then reit_de_minimis_failure_deemed_cured_856c7B(t, y, q);
}
rule Section856c7BCureByOtherwiseMet(t: Person, y: TaxableYear, q: us.irc.core::Period, last_day: Date, on: Date) strict {
    label en official "section 856(c)(7)(B)(ii)(II): the requirements are otherwise met within 6 months";
    when reit_de_minimis_failure_856c7B(t, y, q);
    when quarter_ended_on_856c7(q, last_day);
    when asset_requirements_otherwise_met_by_856c7(t, y, q, on);
    when on < add_calendar_period(add_calendar_period(last_day, 1 calendar_day), 6 calendar_month);
    then reit_de_minimis_failure_deemed_cured_856c7B(t, y, q);
}
pub relation net_income_generated_by_scheduled_assets_856c7C(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the net income generated by the scheduled assets for the period of clause (ii) (determined under regulations; asserted)";
}
pub relation section_856c7C_tax_imposed(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the tax imposed when subparagraph (A) applies: the greater of $50,000 and the net income of the scheduled assets at the highest section 11 rate";
}
@source(IRC_S856_C, quote = "there is hereby imposed on such corporation, trust, or association a tax in an amount equal to the greater of")
rule Section856c7CTaxOnAssetFailureRelief(t: Person, y: TaxableYear, q: us.irc.core::Period, net_income: Money, rate: Decimal) strict {
    label en official "section 856(c)(7)(C)(i): tax equals the greater of $50,000 and the net income multiplied by the highest section 11 rate";
    when reit_asset_failure_deemed_cured_856c7A(t, y, q);
    when net_income_generated_by_scheduled_assets_856c7C(t, y, q, net_income);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then section_856c7C_tax_imposed(t, y, q, max(50000.00 USD, round(net_income * rate, 2, "HALF_UP")));
}
pub relation section_856c7C_tax_treated_as_excise_tax(t: Person, y: TaxableYear, q: us.irc.core::Period) kind institutional {
    label en official "for subtitle F the tax is an excise tax to which the deficiency procedures apply (section 856(c)(7)(C)(iii))";
}
rule Section856c7CIiiExciseTreatment(t: Person, y: TaxableYear, q: us.irc.core::Period, amount: Money) strict {
    label en official "section 856(c)(7)(C)(iii): the tax is an excise tax subject to the deficiency procedures";
    when section_856c7C_tax_imposed(t, y, q, amount);
    then section_856c7C_tax_treated_as_excise_tax(t, y, q);
}

// ---- Section 856(c)(8): election after a tax-free reorganization ----

pub relation distribution_under_section_355_on_856c8(c: Person, on: Date) kind empirical {
    label en unofficial "the corporation was a distributing or controlled corporation (other than a controlled corporation in a section 355(h)(2)(A) distribution) with respect to a distribution to which section 355 applied, made on this date";
}
pub relation reit_election_year_begins_on_856c8(c: Person, y: TaxableYear, begins_on: Date) kind empirical {
    label en unofficial "the taxable year for which the election is made begins on this date";
}
pub relation reit_election_barred_after_355_distribution_856c8(c: Person, y: TaxableYear) kind institutional {
    label en official "the corporation (or its successor) is not eligible to make a section 856(c)(1) election for a taxable year beginning before the end of the 10-year period beginning on the distribution date";
}
@source(IRC_S856_C, quote = "shall not be eligible to make any election under paragraph (1) for any taxable year beginning before the end of the 10-year period beginning on the date of such distribution")
rule Section856c8TenYearElectionBar(c: Person, y: TaxableYear, distributed_on: Date, begins_on: Date) strict {
    label en official "section 856(c)(8): no election for a year beginning within 10 years of a section 355 distribution";
    when distribution_under_section_355_on_856c8(c, distributed_on);
    when reit_election_year_begins_on_856c8(c, y, begins_on);
    when begins_on < add_calendar_period(distributed_on, 120 calendar_month);
    then reit_election_barred_after_355_distribution_856c8(c, y);
}

// ---- Section 856(c)(9): ancillary personal property ----

pub relation personal_property_leased_with_real_property_856c9A(t: Person, y: TaxableYear, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "personal property leased under, or in connection with, a lease of real property, for a period of not less than 1 year, the rents from which are treated as rents from real property under section 856(d)(1)(C)";
}
pub relation personal_property_treated_as_real_estate_asset_856c9Ai(t: Person, y: TaxableYear, asset: us.irc.core::Asset) kind institutional {
    label en official "the personal property is a real estate asset for paragraph (4)(A), to the extent its rents are treated as rents from real property";
}
rule Section856c9AiLeasedPersonalPropertyIsRealEstateAsset(t: Person, y: TaxableYear, asset: us.irc.core::Asset) strict {
    label en official "section 856(c)(9)(A)(i): personal property whose rents qualify under section 856(d)(1)(C) is a real estate asset";
    when personal_property_leased_with_real_property_856c9A(t, y, asset);
    then personal_property_treated_as_real_estate_asset_856c9Ai(t, y, asset);
}
pub relation personal_property_fmv_at_disposition_856c9Aii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the personal property sold or contemporaneously disposed of, at the time of disposition";
}
pub relation total_fmv_of_property_disposed_856c9Aii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total fair market value of all the personal and real property sold or contemporaneously disposed of, at the time of disposition";
}
pub relation single_disposition_of_personal_and_real_property_856c9Aii(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "a portion of the personal property and a portion of the real property are disposed of in a single disposition (or contemporaneously in separate dispositions)";
}
pub relation gain_on_ancillary_personal_property_is_real_estate_asset_gain_856c9Aii(t: Person, y: TaxableYear) kind institutional {
    label en official "the gain is treated for paragraphs (2)(H) and (3)(H) as gain from the disposition of a real estate asset";
}
@source(IRC_S856_C, quote = "does not exceed 15 percent of the total fair market value of all of the personal and real property so sold or contemporaneously disposed of")
rule Section856c9AiiFifteenPercentGain(t: Person, y: TaxableYear, asset: us.irc.core::Asset, personal: Money, total: Money) strict {
    label en official "section 856(c)(9)(A)(ii): gain on personal property sold with real property qualifies where the personal property is at most 15 percent of the total value";
    when personal_property_leased_with_real_property_856c9A(t, y, asset);
    when single_disposition_of_personal_and_real_property_856c9Aii(t, y);
    when personal_property_fmv_at_disposition_856c9Aii(t, y, personal);
    when total_fmv_of_property_disposed_856c9Aii(t, y, total);
    when personal * 100.0 <= total * 15.0;
    then gain_on_ancillary_personal_property_is_real_estate_asset_gain_856c9Aii(t, y);
}
pub relation mortgage_on_real_and_personal_property_856c9B(t: Person, y: TaxableYear, obligation: us.irc.core::Asset) kind empirical {
    label en unofficial "an obligation secured by a mortgage on both real property and personal property";
}
pub relation personal_property_fmv_under_mortgage_856c9B(obligation: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the personal property securing the obligation";
}
pub relation total_fmv_of_property_under_mortgage_856c9B(obligation: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of all the property securing the obligation";
}
pub relation mixed_mortgage_treated_as_real_property_mortgage_856c9B(t: Person, y: TaxableYear, obligation: us.irc.core::Asset) kind institutional {
    label en official "the obligation is treated as a mortgage on real property for paragraphs (2)(D), (3)(B), (3)(C) and (4)(A)";
}
@source(IRC_S856_C, quote = "if the fair market value of such personal property does not exceed 15 percent of the total fair market value of all such property")
rule Section856c9BFifteenPercentMortgage(t: Person, y: TaxableYear, obligation: us.irc.core::Asset, personal: Money, total: Money) strict {
    label en official "section 856(c)(9)(B)(i): a mortgage on real and personal property with personal property at most 15 percent of the value is treated as a real property mortgage";
    when mortgage_on_real_and_personal_property_856c9B(t, y, obligation);
    when personal_property_fmv_under_mortgage_856c9B(obligation, personal);
    when total_fmv_of_property_under_mortgage_856c9B(obligation, total);
    when personal * 100.0 <= total * 15.0;
    then mixed_mortgage_treated_as_real_property_mortgage_856c9B(t, y, obligation);
}

// ---- Year-level composition used by the section 856(c) requirements ----

pub relation all_quarters_reviewed_856c4Biv_year(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the case has supplied the issuer positions for every quarter close of the taxable year (completeness of the listing)";
}
pub relation has_issuer_limit_breach_in_year_856c4Biv(t: Person, y: TaxableYear) kind institutional {
    label en official "helper binding the open quarter argument: a per-issuer limit is breached at the close of some quarter of the year";
}
rule Section856c4BivHelperYearBreach(t: Person, y: TaxableYear, q: us.irc.core::Period) strict {
    label en official "helper: some quarter of the year has a breach";
    when has_issuer_limit_breach_856c4Biv(t, y, q);
    then has_issuer_limit_breach_in_year_856c4Biv(t, y);
}
pub relation issuer_limits_met_year_856c4Biv(t: Person, y: TaxableYear) kind institutional {
    label en official "no per-issuer limit of section 856(c)(4)(B)(iv) is breached at the close of any quarter of the taxable year";
}
rule Section856c4BivYearNoBreach(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(4)(B)(iv): met for the year when every quarter is reviewed and none breaches";
    when all_quarters_reviewed_856c4Biv_year(t, y);
    when not_known(has_issuer_limit_breach_in_year_856c4Biv(t, y));
    then issuer_limits_met_year_856c4Biv(t, y);
}
pub relation trs_ceiling_met_year_level_856c4Bii(t: Person, y: TaxableYear) kind institutional {
    label en official "the year-level taxable REIT subsidiary ceiling of section 856(c)(4)(B)(ii): 20 percent, or 25 percent for taxable years beginning after December 31, 2025 (Pub. L. 119-21 sec. 70439)";
}
@source(IRC_S856_C, quote = "not more than 20 percent of the value of its total assets is represented by securities of one or more taxable REIT subsidiaries")
rule Section856c4BiiYearLevelPinnedTwentyPercent(t: Person, y: TaxableYear, trs: Money, total: Money, begins_on: Date) strict {
    label en official "section 856(c)(4)(B)(ii), pinned 2024 text: at most 20 percent for taxable years beginning on or before 2025-12-31";
    when taxable_reit_subsidiary_securities_value(t, y, trs);
    when total_assets_value_856(t, y, total);
    when us.irc.core::begins(y, begins_on);
    when begins_on <= @2025-12-31;
    when trs * 100.0 <= total * 20.0;
    then trs_ceiling_met_year_level_856c4Bii(t, y);
}
@source(us.irc.temporal::PL119_21_S70439, quote = "Section 856(c)(4)(B)(ii) is amended by striking “20 percent” and inserting “25 percent”.")
rule Section856c4BiiYearLevelPL119_21TwentyFivePercent(t: Person, y: TaxableYear, trs: Money, total: Money, begins_on: Date) strict {
    effective [@2025-07-04, infinity);
    label en official "Pub. L. 119-21 sec. 70439: at most 25 percent for taxable years beginning after 2025-12-31";
    when taxable_reit_subsidiary_securities_value(t, y, trs);
    when total_assets_value_856(t, y, total);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @2025-12-31;
    when trs * 100.0 <= total * 25.0;
    then trs_ceiling_met_year_level_856c4Bii(t, y);
}

// ---- Section 856(c)(4), closing paragraph: the quarterly discrepancy safe harbor ----

pub relation reit_requirements_met_at_close_of_quarter_856c4(t: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "the trust meets the requirements of paragraph (4) at the close of the quarter";
}
pub relation previous_quarter_856c4(q: us.irc.core::Period, prior: us.irc.core::Period) kind empirical {
    label en unofficial "prior is the quarter immediately before q (TECH-GAPS G2201)";
}
pub relation value_discrepancy_in_quarter_856c4(t: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "a discrepancy between the value of the trust's investments and the requirements exists during the quarter (including one caused solely by a change in the foreign currency exchange rate used to value a foreign asset)";
}
pub relation discrepancy_from_acquisition_856c4(t: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "the discrepancy exists immediately after the acquisition of a security or other property and is wholly or partly the result of that acquisition";
}
pub relation reit_status_preserved_by_856c4_discrepancy_rule(t: Person, q: us.irc.core::Period) kind institutional {
    label en official "the trust does not lose REIT status for the quarter because of a value discrepancy that is not the result of an acquisition";
}
@source(IRC_S856_C, quote = "shall not lose its status as a real estate investment trust because of a discrepancy during a subsequent quarter between the value of its various investments and such requirements")
rule Section856c4DiscrepancyStatusPreserved(t: Person, q: us.irc.core::Period, prior: us.irc.core::Period) strict {
    label en official "section 856(c)(4), closing paragraph: status is not lost through a later discrepancy, unless it arises immediately after and from an acquisition";
    when previous_quarter_856c4(q, prior);
    when reit_requirements_met_at_close_of_quarter_856c4(t, prior);
    when value_discrepancy_in_quarter_856c4(t, q);
    when not_known(discrepancy_from_acquisition_856c4(t, q));
    then reit_status_preserved_by_856c4_discrepancy_rule(t, q);
}

// ---- Section 856(c)(5)(A): value ----

pub relation reit_security_market_quotation_readily_available_856c5A(s: us.irc.core::Asset) kind empirical {
    label en unofficial "market quotations are readily available for the security";
}
pub relation reit_security_market_value_856c5A(s: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the market value of the security";
}
pub relation reit_asset_trustees_fair_value_856c5A(s: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair value of the security or asset as determined in good faith by the trustees";
}
pub relation reit_value_856c5A(s: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the value of the security or asset for part II: market value where quotations are readily available, otherwise fair value determined in good faith by the trustees";
}
@source(IRC_S856_C, quote = "with respect to securities for which market quotations are readily available, the market value of such securities")
rule Section856c5AMarketValue(s: us.irc.core::Asset, amount: Money) strict {
    label en official "section 856(c)(5)(A): market value where quotations are readily available";
    when reit_security_market_quotation_readily_available_856c5A(s);
    when reit_security_market_value_856c5A(s, amount);
    then reit_value_856c5A(s, amount);
}
@source(IRC_S856_C, quote = "with respect to other securities and assets, fair value as determined in good faith by the trustees")
rule Section856c5ATrusteesFairValue(s: us.irc.core::Asset, amount: Money) strict {
    label en official "section 856(c)(5)(A): otherwise the fair value determined in good faith by the trustees";
    when reit_asset_trustees_fair_value_856c5A(s, amount);
    when not_known(reit_security_market_quotation_readily_available_856c5A(s));
    then reit_value_856c5A(s, amount);
}
