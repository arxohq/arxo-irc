// Sections 831(b)(1)-(d), 832(b)(7)-(8), 832(c)-(g), 833, 834, 835,
// 841-845 (insurance companies other than life: the alternative tax on
// taxable investment income, the special premium computations, the itemised
// deductions and their limits, the mortgage guaranty account, interinsurer
// savings, Blue Cross and Blue Shield organizations, taxable investment
// income, reciprocals and their election, the foreign tax credit base,
// foreign insurers, the accounting period, and the Secretary's reinsurance
// powers). Stage 2c (IRC-09 stage 2c, A12), 26.09.2026. Status
// implemented_unverified.
//
// METHOD. Gross investment income and the deductions of section 834(c) are
// itemised with a class (`sum all`); the mortgage guaranty account is a
// running ledger whose yearly step is expressed from asserted opening
// figures (the ten-year roll-forward is a recursive ledger, TECH-GAPS
// G2208). The Secretary's discretionary determinations (section 845) are
// `external judgment relation`s (DECISION-0194, channel 1) and the
// Secretary's powers are `power`s that are valid only where the statutory
// preconditions hold.

// ---- Section 831 ----

use self::{
    Corporation,
    IRC_S831_B,
    IRC_S831_C,
    IRC_S831_D,
    IRC_S832_B,
    IRC_S832_C,
    IRC_S832_D,
    IRC_S832_E,
    IRC_S832_F,
    IRC_S832_G,
    IRC_S833_B,
    IRC_S833_C,
    IRC_S834_A,
    IRC_S834_C,
    IRC_S834_D,
    IRC_S834_E,
    IRC_S835_A,
    IRC_S835_B,
    IRC_S835_D,
    IRC_S835_E,
    IRC_S841,
    IRC_S842_B,
    IRC_S842_C,
    IRC_S843,
    IRC_S845_A,
    IRC_S845_B,
    Person,
    TaxableYear,
    insurance_company_by_816a,
    insurance_company_taxable_income,
    life_insurance_company_taxable_income,
    section_831b_alternative_tax_applies,
    subject_to_section_831a_tax,
    worldwide_yield_election_in_effect_842b4C,
};

pub relation insurance_company_for_831(p: Person, y: TaxableYear) kind institutional {
    label en official "an insurance company for section 831: the meaning given by section 816(a)";
}
@source(IRC_S831_C, quote = "For purposes of this section, the term \"insurance company\" has the meaning given to such term by section 816(a).")
rule Section831cInsuranceCompanyMeaning(p: Person, y: TaxableYear) strict {
    label en official "section 831(c): the term insurance company is as in section 816(a)";
    when insurance_company_by_816a(p, y);
    then insurance_company_for_831(p, y);
}
pub relation section_831b_information_furnished_831d(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company has furnished to the Secretary the information the Secretary prescribes for a section 831(b) election";
}
@source(IRC_S831_D, quote = "Every insurance company for which an election is in effect under subsection (b) for any taxable year shall furnish to the Secretary")
rule Section831dDutyToFurnishInformation(c: Person, y: TaxableYear, ends_on: Date) strict {
    label en official "section 831(d): an electing company must furnish the prescribed information (no deadline is stated in the statute; the time is prescribed by the Secretary)";
    when section_831b_alternative_tax_applies(c, y);
    when us.irc.core::ends(y, ends_on);
    then duty FurnishSection831bInformation {
        bearer c;
        goal achievement {
            condition section_831b_information_furnished_831d(c, y);
            window [ends_on, infinity];
        }
    };
}
pub relation section_831b_tax_amount(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 831(b)(1) tax: the taxable investment income multiplied by the section 11(b) rate";
}
@source(IRC_S831_B, quote = "taxable investment income")
rule Section831b1TaxOnTaxableInvestmentIncome(c: Corporation, y: TaxableYear, tii: Money, rate: Decimal) defeasible {
    label en official "section 831(b)(1): the electing company's tax is its taxable investment income times the rate";
    when section_831b_alternative_tax_applies(c, y);
    when taxable_investment_income_834(c, y, tii);
    when us.irc.corporations::corporate_tax_rate(c, y, rate);
    then section_831b_tax_amount(c, y, round(tii * rate, 2, "HALF_UP"));
}

// ---- Section 832(b)(7)-(8): special premiums earned ----

pub relation gross_written_less_returns_and_reinsurance_832b4A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross premiums written less return premiums and premiums paid for reinsurance";
}
pub relation unearned_premiums_special_class_end_of_prior_year_832b7(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unearned premiums of the special class on outstanding business at the end of the preceding taxable year";
}
pub relation unearned_premiums_special_class_end_of_year_832b7(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unearned premiums of the special class on outstanding business at the end of the taxable year";
}
pub relation premiums_on_life_annuity_or_noncancellable_contracts_832b7A(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the premiums are attributable to insurance contracts described in section 816(b)(1)(B)";
}
pub relation premiums_on_long_term_securities_default_insurance_832b7B(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the premiums are attributable to insurance against default in the payment of principal or interest on securities described in section 165(g)(2)(C) with maturities of more than 5 years";
}
pub relation premiums_earned_special_percentage_832b7(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "premiums earned for a special class, with the substituted percentage of unearned premiums";
}
@source(IRC_S832_B, quote = "by substituting \"100 percent\" for \"80 percent\" each place it appears in such subparagraph")
rule Section832b7AHundredPercent(c: Person, y: TaxableYear, base: Money, prior: Money, end: Money) strict {
    label en official "section 832(b)(7)(A): 100 percent of unearned premiums for contracts described in section 816(b)(1)(B)";
    when premiums_on_life_annuity_or_noncancellable_contracts_832b7A(c, y);
    when gross_written_less_returns_and_reinsurance_832b4A(c, y, base);
    when unearned_premiums_special_class_end_of_prior_year_832b7(c, y, prior);
    when unearned_premiums_special_class_end_of_year_832b7(c, y, end);
    then premiums_earned_special_percentage_832b7(c, y, (base + prior) - end);
}
@source(IRC_S832_B, quote = "subparagraph (B) of paragraph (4) shall be applied by substituting \"90 percent\" for \"80 percent\" each place it appears")
rule Section832b7BNinetyPercent(c: Person, y: TaxableYear, base: Money, prior: Money, end: Money) strict {
    label en official "section 832(b)(7)(B)(i): 90 percent of unearned premiums for long-term securities default insurance";
    when premiums_on_long_term_securities_default_insurance_832b7B(c, y);
    when gross_written_less_returns_and_reinsurance_832b4A(c, y, base);
    when unearned_premiums_special_class_end_of_prior_year_832b7(c, y, prior);
    when unearned_premiums_special_class_end_of_year_832b7(c, y, end);
    then premiums_earned_special_percentage_832b7(c, y, (base + div_round(prior * 90.0, 100.0, 2, "HALF_UP")) - div_round(end * 90.0, 100.0, 2, "HALF_UP"));
}
pub relation premiums_on_title_insurance_832b8A(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the premiums are attributable to title insurance";
}
pub relation discounted_unearned_premiums_end_of_prior_year_832b8(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the discounted unearned premiums at the end of the preceding taxable year (the present value using the applicable interest rate of section 846(c)(2) and the statutory premium recognition pattern, an EXTERNAL_DEPENDENCY figure)";
}
pub relation discounted_unearned_premiums_end_of_year_832b8(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the discounted unearned premiums at the end of the taxable year";
}
pub relation premiums_earned_title_insurance_832b8(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "premiums earned on title insurance: the discounted unearned premiums replace 80 percent of the unearned premiums, and paragraph (4)(C) does not apply";
}
@source(IRC_S832_B, quote = "subparagraph (B) of paragraph (4) shall be applied by substituting \"the discounted unearned premiums\" for \"80 percent of the unearned premiums\" each place it appears")
rule Section832b8ATitleInsurance(c: Person, y: TaxableYear, base: Money, prior: Money, end: Money) strict {
    label en official "section 832(b)(8)(A): title insurance premiums earned use the discounted unearned premiums";
    when premiums_on_title_insurance_832b8A(c, y);
    when gross_written_less_returns_and_reinsurance_832b4A(c, y, base);
    when discounted_unearned_premiums_end_of_prior_year_832b8(c, y, prior);
    when discounted_unearned_premiums_end_of_year_832b8(c, y, end);
    then premiums_earned_title_insurance_832b8(c, y, (base + prior) - end);
}
pub relation undiscounted_unearned_premiums_832b8Ci(c: Person, y: TaxableYear, calendar_year_of_receipt: Integer, amount: Money) kind empirical {
    label en unofficial "the unearned premiums shown in the yearly statement filed by the taxpayer for the year ending with or within the taxable year, for premiums received in the calendar year";
}

// ---- Section 832(c): deductions ----

pub enum InsuranceDeductionKind832c {
    InsDedExpenses162;
    InsDedInterest163;
    InsDedTaxes164;
    InsDedLossesIncurred;
    InsDedCapitalLossesSubchapterP;
    InsDedWorthlessAgencyBalances;
    InsDedExemptInterest103;
    InsDedDepreciationAndDepletion;
    InsDedCharitable170;
    InsDedOtherPartVI;
    InsDedPolicyholderDividends;
    InsDedDividendsReceived;
    InsDedMortgageGuaranty832e;
    label en unofficial "the class of a deduction of an insurance company under section 832(c)";
}
pub relation insurance_deduction_item_832c(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: InsuranceDeductionKind832c, amount: Money) kind empirical {
    label en unofficial "a deduction item of the company with its class and amount";
}
pub relation mutual_fire_insurance_company_832b1C(c: Person) kind empirical {
    label en unofficial "the company is a mutual fire insurance company described in subsection (b)(1)(C)";
}
pub relation abnormal_loss_capital_asset_sales_832c5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "losses from capital assets sold or exchanged to obtain funds to meet abnormal insurance losses and to pay policyholder dividends";
}
pub relation taxable_income_without_capital_gains_and_losses_832c5A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income computed without regard to gains or losses from sales or exchanges of capital assets";
}
pub relation abnormal_capital_loss_deduction_832c5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the loss from capital assets sold to obtain funds for abnormal losses and policyholder dividends, allowed up to the lesser of the taxable income without capital items and those losses";
}
@source(IRC_S832_C, quote = "plus losses from capital assets sold or exchanged in order to obtain funds to meet abnormal insurance losses")
rule Section832c5AbnormalCapitalLosses(c: Person, y: TaxableYear, losses: Money, income: Money) strict {
    label en official "section 832(c)(5): the abnormal-loss capital loss is capped at the taxable income computed without capital gains or losses";
    when abnormal_loss_capital_asset_sales_832c5(c, y, losses);
    when taxable_income_without_capital_gains_and_losses_832c5A(c, y, income);
    then abnormal_capital_loss_deduction_832c5(c, y, min(losses, max(0.00 USD, income)));
}
pub relation deduction_item_allowed_832c(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a deduction item allowed by section 832(c)";
}
rule Section832cOrdinaryDeductionKinds(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: InsuranceDeductionKind832c, amount: Money) strict {
    label en official "section 832(c)(1)-(4),(6)-(10),(12)-(13): the listed classes are allowed (policyholder dividends and the capital loss class are handled separately)";
    when insurance_deduction_item_832c(c, y, item, kind, amount);
    when kind != InsDedPolicyholderDividends;
    when kind != InsDedCapitalLossesSubchapterP;
    then deduction_item_allowed_832c(c, y, item, amount);
}
rule Section832cCapitalLossesUnderSubchapterP(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 832(c)(5): capital losses to the extent provided in subchapter P";
    when insurance_deduction_item_832c(c, y, item, InsDedCapitalLossesSubchapterP, amount);
    then deduction_item_allowed_832c(c, y, item, amount);
}
rule Section832c11PolicyholderDividends(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 832(c)(11): policyholder dividends are deductible, except for a mutual fire insurance company described in subsection (b)(1)(C)";
    when insurance_deduction_item_832c(c, y, item, InsDedPolicyholderDividends, amount);
    when not_known(mutual_fire_insurance_company_832b1C(c));
    then deduction_item_allowed_832c(c, y, item, amount);
}
pub relation insurance_deductions_832c_itemized(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the allowed deduction items plus the abnormal capital loss deduction";
}
rule Section832cItemizedTotal(c: Person, y: TaxableYear, abnormal: Money) defeasible {
    label en official "section 832(c): the sum of the allowed items and the abnormal capital loss deduction";
    when deduction_item_allowed_832c(c, y, _, _);
    when abnormal_capital_loss_deduction_832c5(c, y, abnormal);
    then insurance_deductions_832c_itemized(c, y, abnormal + sum all amount: Money for item: us.irc.core::Payment where deduction_item_allowed_832c(c, y, item, amount));
}
pub relation item_deducted_twice_832d(c: Person, y: TaxableYear, item: us.irc.core::Payment) kind empirical {
    label en unofficial "the same item is deducted more than once";
}
@source(IRC_S832_D, quote = "Nothing in this section shall permit the same item to be deducted more than once.")
rule Section832dNoDoubleDeduction(c: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 832(d): the same item may not be deducted twice";
    when insurance_company_for_831(c, y);
    when insurance_deduction_item_832c(c, y, item, _, _);
    then prohibition NoDoubleDeductionUnder832 {
        bearer c;
        action item_deducted_twice_832d(c, y, item);
        window [@1986-12-31, infinity);
    };
}

// ---- Section 832(e): mortgage guaranty insurance ----

pub relation writes_mortgage_guaranty_insurance_832e(c: Person) kind empirical {
    label en unofficial "the company writes mortgage guaranty insurance (or lease guaranty insurance, or insurance on obligations the interest on which is excludable under section 103)";
}
pub relation amount_required_by_state_law_set_aside_832e1A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount required by State law or regulation to be set aside in the year in a reserve for mortgage guaranty insurance losses resulting from adverse economic cycles";
}
pub relation premiums_earned_on_mortgage_guaranty_832e1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "premiums earned on mortgage guaranty insurance contracts (subsection (b)(4)) for the year";
}
pub relation amounts_set_aside_in_eight_preceding_years_not_deducted_832e1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate of amounts set aside in the reserve for the 8 preceding taxable years to the extent not deducted under this paragraph";
}
pub relation taxable_income_before_mortgage_guaranty_deduction_832e1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income for the year computed without regard to this paragraph or to any net operating loss carryback";
}
pub relation mortgage_guaranty_deduction_before_bonds_832e1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the year's set-aside (not more than 50 percent of mortgage guaranty premiums earned) and the eight-year balance, not more than taxable income";
}
@source(IRC_S832_E, quote = "the amount required by State law or regulation to be so set aside in any taxable year shall not exceed 50 percent of premiums earned")
rule Section832e1DeductionCeiling(c: Person, y: TaxableYear, set_aside: Money, earned: Money, prior: Money, income: Money) strict {
    label en official "section 832(e)(1): (A) set-aside capped at 50 percent of mortgage guaranty premiums earned, plus (B) the eight-year balance, all capped at taxable income";
    when writes_mortgage_guaranty_insurance_832e(c);
    when amount_required_by_state_law_set_aside_832e1A(c, y, set_aside);
    when premiums_earned_on_mortgage_guaranty_832e1(c, y, earned);
    when amounts_set_aside_in_eight_preceding_years_not_deducted_832e1B(c, y, prior);
    when taxable_income_before_mortgage_guaranty_deduction_832e1(c, y, income);
    then mortgage_guaranty_deduction_before_bonds_832e1(c, y, min(max(0.00 USD, income), min(set_aside, div_round(earned * 50.0, 100.0, 2, "HALF_UP")) + prior));
}
pub relation tax_and_loss_bonds_purchased_832e2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax and loss bonds purchased on or before the date the year's taxes are due";
}
pub relation section_11_rate_for_tax_benefit_832e2(c: Person, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the rate that measures the tax benefit attributable to the deduction (the tax benefit is determined under regulations; the flat rate approximates it, an INTERPRETATION)";
}
pub relation mortgage_guaranty_deduction_allowed_832e(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction allowed only to the extent the tax and loss bonds purchased equal the tax benefit";
}
@source(IRC_S832_E, quote = "The deduction under paragraph (1) shall be allowed only to the extent that tax and loss bonds are purchased in an amount equal to the tax benefit attributable to such deduction")
rule Section832e2DeductionLimitedByBondPurchases(c: Person, y: TaxableYear, deduction: Money, bonds: Money, rate: Decimal) strict {
    label en official "section 832(e)(2): the deduction is allowed to the extent the bonds cover the tax benefit";
    when mortgage_guaranty_deduction_before_bonds_832e1(c, y, deduction);
    when tax_and_loss_bonds_purchased_832e2(c, y, bonds);
    when section_11_rate_for_tax_benefit_832e2(c, y, rate);
    when rate > 0.0;
    then mortgage_guaranty_deduction_allowed_832e(c, y, min(deduction, div_round(bonds, rate, 2, "HALF_UP")));
}
pub relation mortgage_guaranty_account_established_832e3(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company has established and maintains a mortgage guaranty account";
}
@source(IRC_S832_E, quote = "Each company which writes mortgage guaranty insurance shall, for purposes of this part, establish and maintain a mortgage guaranty account.")
rule Section832e3DutyToMaintainAccount(c: Person, y: TaxableYear, begins_on: Date, ends_on: Date) strict {
    label en official "section 832(e)(3): each mortgage guaranty writer must establish and maintain the account";
    when writes_mortgage_guaranty_insurance_832e(c);
    when insurance_company_for_831(c, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    then duty MaintainMortgageGuarantyAccount {
        bearer c;
        goal maintenance {
            condition mortgage_guaranty_account_established_832e3(c, y);
            window [begins_on, ends_on];
        }
    };
}
pub relation mortgage_guaranty_account_before_addition_832e4(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the balance of the mortgage guaranty account before the year's addition";
}
pub relation mortgage_guaranty_account_after_addition_832e4(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the account after adding the amount allowed as a deduction for the year";
}
@source(IRC_S832_E, quote = "There shall be added to the mortgage guaranty account for each taxable year an amount equal to the amount allowed as a deduction")
rule Section832e4AddDeductionToAccount(c: Person, y: TaxableYear, before: Money, allowed: Money) strict {
    label en official "section 832(e)(4): the deduction is added to the account";
    when mortgage_guaranty_account_before_addition_832e4(c, y, before);
    when mortgage_guaranty_deduction_allowed_832e(c, y, allowed);
    then mortgage_guaranty_account_after_addition_832e4(c, y, before + allowed);
}
pub relation amount_added_in_tenth_preceding_year_remaining_832e5A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount, if any, remaining that was added to the account for the tenth preceding taxable year";
}
pub relation reserve_balance_832e5B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount in the reserve referred to in paragraph (1)(A), disregarding amounts added for years beginning before January 1, 1987";
}
pub relation net_operating_loss_before_subtraction_832e5C(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net operating loss for the year computed without regard to subparagraph (C)";
}
pub relation improperly_subtracted_with_bonds_redeemed_832e5D(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "any amount improperly subtracted under (A), (B) or (C), to the extent tax and loss bonds were redeemed with respect to it";
}
pub relation account_subtraction_included_in_gross_income_832e5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount subtracted from the account and included in gross income: the tenth-year remainder, the excess over the reserve, the net operating loss, and improperly subtracted amounts";
}
@source(IRC_S832_E, quote = "After applying paragraph (4), there shall be subtracted for the taxable year from the mortgage guaranty account and included in gross income")
rule Section832e5SubtractionsIncluded(c: Person, y: TaxableYear, tenth: Money, account: Money, reserve: Money, nol: Money, improper: Money) strict {
    label en official "section 832(e)(5): (A) tenth-year remainder, (B) account over reserve, (C) net operating loss, (D) improper subtractions";
    when amount_added_in_tenth_preceding_year_remaining_832e5A(c, y, tenth);
    when mortgage_guaranty_account_after_addition_832e4(c, y, account);
    when reserve_balance_832e5B(c, y, reserve);
    when net_operating_loss_before_subtraction_832e5C(c, y, nol);
    when improperly_subtracted_with_bonds_redeemed_832e5D(c, y, improper);
    then account_subtraction_included_in_gross_income_832e5(c, y, ((tenth + max(0.00 USD, (account - tenth) - reserve)) + max(0.00 USD, nol)) + improper);
}

// ---- Section 832(f): interinsurers and reciprocal underwriters ----

pub relation subscriber_savings_credited_end_of_year_832f(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the savings credited to subscriber accounts at the end of the taxable year";
}
pub relation subscriber_savings_credited_end_of_prior_year_832f(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the savings credited to subscriber accounts at the end of the preceding taxable year";
}
pub relation mutual_interinsurer_or_reciprocal_underwriter_832f(c: Person) kind empirical {
    label en unofficial "the company is a mutual insurance company that is an interinsurer or reciprocal underwriter";
}
pub relation increase_in_subscriber_savings_deduction_832f1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction: the increase for the year in savings credited to subscriber accounts";
}
@source(IRC_S832_F, quote = "there shall be allowed as a deduction the increase for the taxable year in savings credited to subscriber accounts")
rule Section832f1IncreaseIsDeduction(c: Person, y: TaxableYear, end: Money, prior: Money) strict {
    label en official "section 832(f)(1): an increase in savings credited is a deduction";
    when mutual_interinsurer_or_reciprocal_underwriter_832f(c);
    when subscriber_savings_credited_end_of_year_832f(c, y, end);
    when subscriber_savings_credited_end_of_prior_year_832f(c, y, prior);
    when end > prior;
    then increase_in_subscriber_savings_deduction_832f1(c, y, end - prior);
}
pub relation decrease_in_subscriber_savings_income_832f2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income item: the decrease for the year in savings credited to subscriber accounts";
}
@source(IRC_S832_F, quote = "there shall be included as an item of gross income the decrease for the taxable year in savings credited to subscriber accounts")
rule Section832f2DecreaseIsIncome(c: Person, y: TaxableYear, end: Money, prior: Money) strict {
    label en official "section 832(f)(2): a decrease in savings credited is gross income";
    when mutual_interinsurer_or_reciprocal_underwriter_832f(c);
    when subscriber_savings_credited_end_of_year_832f(c, y, end);
    when subscriber_savings_credited_end_of_prior_year_832f(c, y, prior);
    when end < prior;
    then decrease_in_subscriber_savings_income_832f2(c, y, prior - end);
}
pub relation intragroup_dividend_832g(c: Person, y: TaxableYear, payer: Person) kind empirical {
    label en unofficial "a dividend paid by one member of a consolidated group of insurance companies to another member";
}
pub relation dividend_determined_as_if_no_consolidated_return_832g(c: Person, y: TaxableYear, payer: Person) kind institutional {
    label en official "any determination under this part with respect to the dividend is made as if the group were not filing a consolidated return";
}
@source(IRC_S832_G, quote = "any determination under this part with respect to any dividend paid by one member of such group to another member of such group shall be made as if such group were not filing a consolidated return")
rule Section832gSeparateReturnDividendTreatment(c: Person, y: TaxableYear, payer: Person) defeasible {
    label en official "section 832(g): intragroup dividends are treated as if there were no consolidated return";
    when subject_to_section_831a_tax(c, y);
    when intragroup_dividend_832g(c, y, payer);
    then dividend_determined_as_if_no_consolidated_return_832g(c, y, payer);
}

// ---- Section 833: Blue Cross and Blue Shield organizations ----

pub relation existing_blue_cross_org_in_existence_on_1986_08_16_833c2A(o: Person) kind empirical {
    label en unofficial "the organization was in existence on August 16, 1986";
}
pub relation exempt_for_last_year_before_1987_833c2B(o: Person) kind empirical {
    label en unofficial "the organization was determined to be exempt from tax for its last taxable year beginning before January 1, 1987";
}
pub relation no_material_change_since_1986_08_16_833c2C(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "no material change has occurred in its operations or structure after August 16, 1986, and before the close of the taxable year";
}
pub relation existing_blue_cross_or_blue_shield_org_833c2(o: Person, y: TaxableYear) kind institutional {
    label en official "an existing Blue Cross or Blue Shield organization";
}
rule Section833c2ExistingOrganization(o: Person, y: TaxableYear) strict {
    label en official "section 833(c)(2): in existence on 1986-08-16, tax-exempt for the last pre-1987 year, and unchanged";
    when existing_blue_cross_org_in_existence_on_1986_08_16_833c2A(o);
    when exempt_for_last_year_before_1987_833c2B(o);
    when no_material_change_since_1986_08_16_833c2C(o, y);
    then existing_blue_cross_or_blue_shield_org_833c2(o, y);
}
pub relation substantially_all_activities_health_insurance_833c3Ai(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "substantially all the activities of the organization involve the providing of health insurance";
}
pub relation health_insurance_to_individuals_and_small_groups_percent_833c3Aii(o: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the health insurance provided that is provided to individuals and small groups (not counting Medicare supplemental coverage)";
}
pub relation continuous_full_year_open_enrollment_833c3Aiii(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the organization provides continuous full-year open enrollment (including conversions) for individuals and small groups";
}
pub relation full_coverage_of_preexisting_conditions_of_high_risk_833c3Aiv(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "policies covering individuals provide full coverage of pre-existing conditions of high-risk individuals without a price differential (with a reasonable exception)";
}
pub relation community_rated_premium_percent_833c3Av(o: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of its premiums determined on a community rated basis";
}
pub relation no_net_earnings_inure_to_private_shareholder_833c3Avi(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "no part of its net earnings inures to the benefit of any private shareholder or individual";
}
pub relation other_organization_meeting_833c3(o: Person, y: TaxableYear) kind institutional {
    label en official "an organization meeting the requirements of paragraph (3): substantially all health insurance, 10 percent to individuals and small groups, open enrollment, high-risk coverage, 35 percent community rated, no inurement";
}
@source(IRC_S833_C, quote = "An organization meets the requirements of this paragraph for any taxable year if")
rule Section833c3OtherOrganization(o: Person, y: TaxableYear, individual_pct: Decimal, community_pct: Decimal) strict {
    label en official "section 833(c)(3)(A)(i)-(vi): all six requirements";
    when substantially_all_activities_health_insurance_833c3Ai(o, y);
    when health_insurance_to_individuals_and_small_groups_percent_833c3Aii(o, y, individual_pct);
    when individual_pct >= 10.0;
    when continuous_full_year_open_enrollment_833c3Aiii(o, y);
    when full_coverage_of_preexisting_conditions_of_high_risk_833c3Aiv(o, y);
    when community_rated_premium_percent_833c3Av(o, y, community_pct);
    when community_pct >= 35.0;
    when no_net_earnings_inure_to_private_shareholder_833c3Avi(o, y);
    then other_organization_meeting_833c3(o, y);
}
pub relation state_small_group_number_833c3B(o: Person, n: Integer) kind empirical {
    label en unofficial "the number of individuals required for a small group under applicable State law";
}
pub relation small_group_size_limit_833c3B(o: Person, n: Integer) kind institutional {
    label en official "a small group is the lesser of 15 individuals and the number required under applicable State law";
}
rule Section833c3BSmallGroup(o: Person, state_n: Integer) strict {
    label en official "section 833(c)(3)(B): the lesser of 15 and the State number";
    when state_small_group_number_833c3B(o, state_n);
    then small_group_size_limit_833c3B(o, min(15, state_n));
}
pub relation percentage_of_premium_revenue_on_clinical_services_and_quality_833c5(o: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of total premium revenue expended on reimbursement for clinical services and activities that improve health care quality (as reported under section 2718 of the Public Health Service Act)";
}
pub relation medical_loss_ratio_test_met_833c5(o: Person, y: TaxableYear) kind institutional {
    label en official "the percentage is not less than 85 percent";
}
@source(IRC_S833_C, quote = "is not less than 85 percent")
rule Section833c5EightyFivePercent(o: Person, y: TaxableYear, pct: Decimal) strict {
    label en official "section 833(c)(5): at least 85 percent of premium revenue on clinical services and quality";
    when percentage_of_premium_revenue_on_clinical_services_and_quality_833c5(o, y, pct);
    when pct >= 85.0;
    then medical_loss_ratio_test_met_833c5(o, y);
}
pub relation section_833_applies_to_organization(o: Person, y: TaxableYear) kind institutional {
    label en official "section 833 applies: an existing Blue Cross or Blue Shield organization, or another organization meeting paragraph (3)";
}
rule Section833c1AExisting(o: Person, y: TaxableYear) defeasible {
    label en official "section 833(c)(1)(A)";
    when existing_blue_cross_or_blue_shield_org_833c2(o, y);
    then section_833_applies_to_organization(o, y);
}
rule Section833c1BOther(o: Person, y: TaxableYear) strict {
    label en official "section 833(c)(1)(B)";
    when other_organization_meeting_833c3(o, y);
    then section_833_applies_to_organization(o, y);
}
pub relation claims_and_cost_plus_liabilities_incurred_833b1A(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the claims incurred during the year and liabilities incurred under cost-plus contracts (health-related business only)";
}
pub relation claims_administration_expenses_incurred_833b1A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the expenses incurred in connection with the administration, adjustment or settlement of claims or the administration of cost-plus contracts";
}
pub relation adjusted_surplus_beginning_of_year_833b1B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the adjusted surplus as of the beginning of the taxable year (the year-by-year roll-forward of paragraph (3) is a running ledger, TECH-GAPS G2208)";
}
pub relation taxable_income_without_833_deduction_833b2(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "taxable income for the year determined without regard to the section 833(b) deduction";
}
pub relation blue_cross_deduction_833b(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 833(b) deduction: the excess of 25 percent of claims and expenses over the adjusted surplus, not more than taxable income";
}
@source(IRC_S833_B, quote = "the deduction determined under this subsection for any taxable year is the excess (if any) of")
rule Section833b1Deduction(o: Person, y: TaxableYear, claims: Money, expenses: Money, surplus: Money, income: Money) defeasible {
    label en official "section 833(b)(1)-(2): 25 percent of claims and administration expenses minus adjusted surplus, never below zero and never above taxable income";
    when section_833_applies_to_organization(o, y);
    when claims_and_cost_plus_liabilities_incurred_833b1A(o, y, claims);
    when claims_administration_expenses_incurred_833b1A(o, y, expenses);
    when adjusted_surplus_beginning_of_year_833b1B(o, y, surplus);
    when taxable_income_without_833_deduction_833b2(o, y, income);
    then blue_cross_deduction_833b(o, y, min(max(0.00 USD, income), max(0.00 USD, div_round((claims + expenses) * 25.0, 100.0, 2, "HALF_UP") - surplus)));
}
pub relation adjusted_taxable_income_prior_year_833b3Ai(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjusted taxable income for the preceding taxable year";
}
pub relation adjusted_net_operating_loss_prior_year_833b3Aii(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjusted net operating loss for the preceding taxable year";
}
pub relation adjusted_surplus_beginning_of_prior_year_833b3A(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjusted surplus as of the beginning of the preceding taxable year";
}
pub relation adjusted_surplus_rolled_forward_833b3A(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted surplus at the beginning of the year: the prior year's, increased by the prior adjusted taxable income or decreased by the prior adjusted net operating loss";
}
@source(IRC_S833_B, quote = "The adjusted surplus as of the beginning of any taxable year is an amount equal to the adjusted surplus as of the beginning of the preceding taxable year")
rule Section833b3ARollForward(o: Person, y: TaxableYear, prior_surplus: Money, income: Money, loss: Money) strict {
    label en official "section 833(b)(3)(A): one yearly step of the roll-forward from asserted prior figures";
    when adjusted_surplus_beginning_of_prior_year_833b3A(o, y, prior_surplus);
    when adjusted_taxable_income_prior_year_833b3Ai(o, y, income);
    when adjusted_net_operating_loss_prior_year_833b3Aii(o, y, loss);
    then adjusted_surplus_rolled_forward_833b3A(o, y, (prior_surplus + income) - loss);
}
pub relation tax_exempt_interest_less_disallowed_833b3E(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "any tax-exempt interest received or accrued during the year, reduced by the amounts not otherwise deductible that would have been allowable as a deduction for it";
}
pub relation dividends_received_deductions_243_245_833b3E(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the aggregate amount allowed as a deduction for the year under sections 243 and 245, after the section 832(b)(5)(B) reduction";
}
pub relation taxable_income_for_833b3C(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "taxable income determined without the section 833(b) deduction and without carrybacks or carryforwards";
}
pub relation adjusted_taxable_income_833b3C(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "adjusted taxable income: taxable income increased by the net exempt income";
}
@source(IRC_S833_B, quote = "by increasing gross income by an amount equal to the net exempt income for the taxable year")
rule Section833b3CAdjustedTaxableIncome(o: Person, y: TaxableYear, income: Money, exempt: Money, dividends: Money) strict {
    label en official "section 833(b)(3)(C),(E): taxable income plus the net exempt income (tax-exempt interest and dividends received deductions)";
    when taxable_income_for_833b3C(o, y, income);
    when tax_exempt_interest_less_disallowed_833b3E(o, y, exempt);
    when dividends_received_deductions_243_245_833b3E(o, y, dividends);
    then adjusted_taxable_income_833b3C(o, y, (income + exempt) + dividends);
}

// ---- Section 834: taxable investment income ----

pub enum GrossInvestmentIncomeKind834 {
    InvInterestDividendsRentsRoyalties;
    InvLeaseMortgageAgreementConsideration;
    InvAlterationTerminationOfInstrument;
    InvCapitalGainSubchapterP;
    InvNonInsuranceTradeOrBusiness;
    label en unofficial "the class of an item of gross investment income under section 834(b)";
}
pub relation gross_investment_income_item_834b(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: GrossInvestmentIncomeKind834, amount: Money) kind empirical {
    label en unofficial "an item of gross investment income of the insurance company";
}
pub relation gross_investment_income_834b(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross investment income: the sum of the listed items";
}
rule Section834bGrossInvestmentIncome(c: Person, y: TaxableYear) strict {
    label en official "section 834(b): the sum of the itemised income (paragraph (2) excluding any item described in paragraph (1), by the case's classification)";
    when gross_investment_income_item_834b(c, y, _, _, _);
    then gross_investment_income_834b(c, y, sum all amount: Money for item: us.irc.core::Payment where gross_investment_income_item_834b(c, y, item, _, amount));
}
pub enum InvestmentDeductionKind834 {
    InvDedExemptInterest;
    InvDedInvestmentExpenses;
    InvDedRealEstateTaxesAndExpenses;
    InvDedDepreciation;
    InvDedInterestOnIndebtedness;
    InvDedCapitalLosses;
    InvDedDividendsReceived;
    InvDedNonInsuranceBusiness;
    InvDedDepletion;
    label en unofficial "the class of a deduction in computing taxable investment income under section 834(c)";
}
pub relation investment_deduction_item_834c(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: InvestmentDeductionKind834, amount: Money) kind empirical {
    label en unofficial "a deduction item in computing taxable investment income";
}
pub relation mean_book_value_of_invested_assets_834c2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the mean of the book value of the invested assets held at the beginning and end of the taxable year";
}
pub relation taxable_investment_income_before_investment_expenses_834c2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "taxable investment income computed without any deduction for investment expenses, tax-free interest, or the section 834(c)(7) dividends";
}
pub relation general_expenses_assigned_to_investment_expenses_834c2(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "general expenses are in part assigned to or included in the investment expenses";
}
pub relation investment_expenses_deduction_ceiling_834c2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "when general expenses are included, the deduction is at most one-fourth of 1 percent of the mean book value of invested assets plus one-fourth of the excess of taxable investment income (before those deductions) over the first amount";
}
@source(IRC_S834_C, quote = "the total deduction under this paragraph shall not exceed one-fourth of 1 percent of the mean of the book value of the invested assets held at the beginning and end of the taxable year")
rule Section834c2Ceiling(c: Person, y: TaxableYear, book: Money, tii: Money) strict {
    label en official "section 834(c)(2): one-fourth of 1 percent of mean book value plus one-fourth of the excess of taxable investment income over that amount";
    when general_expenses_assigned_to_investment_expenses_834c2(c, y);
    when mean_book_value_of_invested_assets_834c2(c, y, book);
    when taxable_investment_income_before_investment_expenses_834c2(c, y, tii);
    // 1/4 of 1 percent is 1/400; the second term is 1/4 of the excess.
    then investment_expenses_deduction_ceiling_834c2(c, y, div_round(book, 400.0, 2, "HALF_UP") + div_round(max(0.00 USD, tii - div_round(book, 400.0, 2, "HALF_UP")), 4.0, 2, "HALF_UP"));
}
pub relation deduction_item_allowed_834c(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an investment deduction item allowed by section 834(c)";
}
rule Section834cOrdinaryDeductionKinds(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: InvestmentDeductionKind834, amount: Money) strict {
    label en official "section 834(c)(1),(3)-(9): the listed classes other than the investment expenses class (paragraph (2), which carries its own ceiling)";
    when investment_deduction_item_834c(c, y, item, kind, amount);
    when kind != InvDedInvestmentExpenses;
    then deduction_item_allowed_834c(c, y, item, amount);
}
pub relation investment_expenses_paid_834c2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the investment expenses class total";
}
rule Section834c2InvestmentExpensesTotal(c: Person, y: TaxableYear) strict {
    label en official "section 834(c)(2): the sum of the investment expenses items";
    when investment_deduction_item_834c(c, y, _, InvDedInvestmentExpenses, _);
    then investment_expenses_paid_834c2(c, y, sum all amount: Money for item: us.irc.core::Payment where investment_deduction_item_834c(c, y, item, InvDedInvestmentExpenses, amount));
}
pub relation investment_expenses_deduction_allowed_834c2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the investment expenses deduction: as paid, or at the ceiling when general expenses are included";
}
rule Section834c2NoGeneralExpensesInFull(c: Person, y: TaxableYear, paid: Money) defeasible {
    label en official "section 834(c)(2): investment expenses alone are deducted in full";
    when investment_expenses_paid_834c2(c, y, paid);
    when not_known(general_expenses_assigned_to_investment_expenses_834c2(c, y));
    then investment_expenses_deduction_allowed_834c2(c, y, paid);
}
rule Section834c2WithGeneralExpensesCapped(c: Person, y: TaxableYear, paid: Money, ceiling: Money) strict {
    label en official "section 834(c)(2): with general expenses included, the deduction is capped";
    when investment_expenses_paid_834c2(c, y, paid);
    when investment_expenses_deduction_ceiling_834c2(c, y, ceiling);
    then investment_expenses_deduction_allowed_834c2(c, y, min(paid, ceiling));
}
pub relation deductions_834c_total(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deductions allowed in computing taxable investment income";
}
rule Section834cTotalDeductions(c: Person, y: TaxableYear, investment: Money) defeasible {
    label en official "section 834(c): the allowed items plus the investment expenses deduction";
    when deduction_item_allowed_834c(c, y, _, _);
    when investment_expenses_deduction_allowed_834c2(c, y, investment);
    then deductions_834c_total(c, y, investment + sum all amount: Money for item: us.irc.core::Payment where deduction_item_allowed_834c(c, y, item, amount));
}
pub relation taxable_investment_income_834(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable investment income: the gross investment income minus the section 834(c) deductions";
}
@source(IRC_S834_A, quote = "the term \"taxable investment income\" means the gross investment income, minus the deductions provided in subsection (c)")
rule Section834aTaxableInvestmentIncome(c: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 834(a): gross investment income minus the section 834(c) deductions";
    when gross_investment_income_834b(c, y, gross);
    when deductions_834c_total(c, y, deductions);
    then taxable_investment_income_834(c, y, gross - deductions);
}
pub relation real_estate_deduction_before_occupancy_limit_834d1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction under subsection (c)(3) or (4) on real estate owned and occupied in whole or in part by a mutual insurance company, computed without regard to paragraph (d)(1)";
}
pub relation rental_value_of_space_not_occupied_834d1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the rental value of the space not occupied by the company";
}
pub relation rental_value_of_entire_property_834d1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the rental value of the entire property";
}
pub relation mutual_company_real_estate_deduction_limited_834d1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the real estate deduction of an occupying mutual company limited by the ratio of unoccupied rental value to total rental value";
}
@source(IRC_S834_D, quote = "shall be limited to an amount which bears the same ratio to such deduction (computed without regard to this paragraph) as the rental value of the space not so occupied bears to the rental value of the entire property")
rule Section834d1OccupancyLimit(c: Person, y: TaxableYear, deduction: Money, unoccupied: Money, entire: Money) strict {
    label en official "section 834(d)(1): deduction times the unoccupied share of rental value";
    when real_estate_deduction_before_occupancy_limit_834d1(c, y, deduction);
    when rental_value_of_space_not_occupied_834d1(c, y, unoccupied);
    when rental_value_of_entire_property_834d1(c, y, entire);
    when entire > 0.00 USD;
    then mutual_company_real_estate_deduction_limited_834d1(c, y, div_round(deduction * (unoccupied / 1.00 USD), entire / 1.00 USD, 2, "HALF_UP"));
}
pub relation gross_premiums_written_or_received_834e1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross premiums (including deposits and assessments) written or received on insurance contracts during the taxable year";
}
pub relation return_premiums_and_reinsurance_premiums_834e1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "return premiums and premiums paid or incurred for reinsurance (amounts returned that depend on the company's experience or management discretion are dividends to policyholders, not return premiums)";
}
pub relation net_premiums_834e1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net premiums: gross premiums less return premiums and reinsurance premiums";
}
@source(IRC_S834_E, quote = "means gross premiums (including deposits and assessments) written or received on insurance contracts during the taxable year less return premiums and premiums paid or incurred for reinsurance")
rule Section834e1NetPremiums(c: Person, y: TaxableYear, gross: Money, returns: Money) strict {
    label en official "section 834(e)(1): gross premiums less return and reinsurance premiums";
    when gross_premiums_written_or_received_834e1(c, y, gross);
    when return_premiums_and_reinsurance_premiums_834e1(c, y, returns);
    then net_premiums_834e1(c, y, gross - returns);
}

// ---- Section 835: reciprocals ----

pub relation reciprocal_subject_to_831a_835a(r: Person, y: TaxableYear) kind empirical {
    label en unofficial "the mutual insurance company is an interinsurer or reciprocal underwriter subject to the section 831(a) tax";
}
pub relation reciprocal_elects_attorney_in_fact_limit_835a(r: Person, y: TaxableYear) kind empirical {
    label en unofficial "the reciprocal elects to be subject to the limitation of subsection (b)";
}
pub relation attorney_in_fact_subject_to_section_11_835c1(a: Person) kind empirical {
    label en unofficial "the attorney-in-fact is subject to the tax imposed by section 11";
}
pub relation attorney_in_fact_consents_to_information_835c2(a: Person) kind empirical {
    label en unofficial "the attorney-in-fact consents to make available the information required during the period the election is in effect";
}
pub relation attorney_in_fact_same_accounting_method_835c3(a: Person) kind empirical {
    label en unofficial "the attorney-in-fact reports the income from the reciprocal and the allocable deductions under the same method under which the reciprocal reports the deductions for the amounts paid";
}
pub relation attorney_in_fact_calendar_year_return_835c4(a: Person) kind empirical {
    label en unofficial "the attorney-in-fact files its return on the calendar year basis";
}
pub relation attorney_in_fact_of_reciprocal_835c(a: Person, r: Person) kind empirical {
    label en unofficial "the person is the attorney-in-fact of the reciprocal";
}
pub relation attorney_in_fact_meets_835c(a: Person) kind institutional {
    label en official "the attorney-in-fact meets all four requirements of subsection (c)";
}
rule Section835cAttorneyInFactConditions(a: Person) strict {
    label en official "section 835(c)(1)-(4)";
    when attorney_in_fact_subject_to_section_11_835c1(a);
    when attorney_in_fact_consents_to_information_835c2(a);
    when attorney_in_fact_same_accounting_method_835c3(a);
    when attorney_in_fact_calendar_year_return_835c4(a);
    then attorney_in_fact_meets_835c(a);
}
pub relation reciprocal_election_eligible_835a(r: Person, y: TaxableYear) kind institutional {
    label en official "the reciprocal may elect: it is subject to section 831(a) and its attorney-in-fact meets subsection (c)";
}
rule Section835cEligibility(r: Person, y: TaxableYear, a: Person) strict {
    label en official "sections 835(a), (c): an election may not be made unless the attorney-in-fact meets (c)";
    when reciprocal_subject_to_831a_835a(r, y);
    when attorney_in_fact_of_reciprocal_835c(a, r);
    when attorney_in_fact_meets_835c(a);
    then reciprocal_election_eligible_835a(r, y);
}
pub relation reciprocal_election_in_effect_835a(r: Person, y: TaxableYear) kind institutional {
    label en official "the section 835(a) election is effective for the year and all succeeding years (revocable only with the Secretary's consent)";
}
@source(IRC_S835_A, quote = "may, under regulations prescribed by the Secretary, elect to be subject to the limitation provided in subsection (b)")
rule Section835aElectionPower(r: Person, y: TaxableYear) strict {
    label en official "section 835(a): a reciprocal may elect the attorney-in-fact deduction limit";
    when reciprocal_elects_attorney_in_fact_limit_835a(r, y);
    then power ReciprocalAttorneyInFactElection {
        holder r;
        over r;
        exercise reciprocal_elects_attorney_in_fact_limit_835a(r, y);
        valid_when reciprocal_election_eligible_835a(r, y);
        effect create(reciprocal_election_in_effect_835a(r, y));
        window [@1963-01-01, infinity);
    };
}
pub relation amounts_paid_to_attorney_in_fact_835b(r: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts paid or incurred in the taxable year to the attorney-in-fact";
}
pub relation attorney_in_fact_deductions_allocable_to_reciprocal_income_835b(r: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deductions of the attorney-in-fact allocable to the income received from the reciprocal";
}
pub relation reciprocal_deduction_for_attorney_in_fact_payments_835b(r: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction limited to, but not increased by, the attorney-in-fact's allocable deductions";
}
@source(IRC_S835_B, quote = "shall be limited to, but in no case increased by, the deductions of the attorney-in-fact allocable")
rule Section835bDeductionLimited(r: Person, y: TaxableYear, paid: Money, allocable: Money) strict {
    label en official "section 835(b): the deduction is the lesser of the amount paid and the attorney-in-fact's allocable deductions";
    when reciprocal_election_in_effect_835a(r, y);
    when amounts_paid_to_attorney_in_fact_835b(r, y, paid);
    when attorney_in_fact_deductions_allocable_to_reciprocal_income_835b(r, y, allocable);
    then reciprocal_deduction_for_attorney_in_fact_payments_835b(r, y, min(paid, allocable));
}
pub relation increase_in_taxable_income_from_835b_limit_835e(r: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the reciprocal's taxable income attributable to the limit: the disallowed part of the payments";
}
rule Section835eIncrease(r: Person, y: TaxableYear, paid: Money, allowed: Money) strict {
    label en official "section 835(e): the disallowed part of the payments increases taxable income";
    when amounts_paid_to_attorney_in_fact_835b(r, y, paid);
    when reciprocal_deduction_for_attorney_in_fact_payments_835b(r, y, allowed);
    then increase_in_taxable_income_from_835b_limit_835e(r, y, paid - allowed);
}
pub relation tax_on_increase_at_highest_rate_835e(r: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase is taxed at the highest rate specified in section 11(b)";
}
@source(IRC_S835_E, quote = "shall be taxed at the highest rate of tax specified in section 11(b)")
rule Section835eTaxAtHighestRate(r: Person, y: TaxableYear, increase: Money, rate: Decimal) strict {
    label en official "section 835(e): the increase is taxed at the highest rate";
    when increase_in_taxable_income_from_835b_limit_835e(r, y, increase);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then tax_on_increase_at_highest_rate_835e(r, y, round(increase * rate, 2, "HALF_UP"));
}
pub relation tax_paid_by_attorney_in_fact_attributable_to_reciprocal_835d(r: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax paid by the attorney-in-fact attributable, under regulations, to the income it received from the reciprocal in the year";
}
pub relation reciprocal_credited_with_attorney_in_fact_tax_835d(r: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reciprocal is credited with the attorney-in-fact's attributable tax";
}
@source(IRC_S835_D, quote = "shall be credited with so much of the tax paid by the attorney-in-fact as is attributable")
rule Section835dCredit(r: Person, y: TaxableYear, tax: Money) strict {
    label en official "section 835(d): credit for the attributable tax";
    when reciprocal_election_in_effect_835a(r, y);
    when tax_paid_by_attorney_in_fact_attributable_to_reciprocal_835d(r, y, tax);
    then reciprocal_credited_with_attorney_in_fact_tax_835d(r, y, tax);
}

// ---- Sections 841, 842, 843, 845 ----

pub relation domestic_insurance_company_subject_to_801_841(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the domestic insurance company is subject to the tax imposed by section 801";
}
pub relation domestic_insurance_company_subject_to_831_841(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the domestic insurance company is subject to the tax imposed by section 831";
}
pub relation taxable_income_base_for_901_limit_841(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for the section 901 credit limit of a domestic insurance company the taxable income is the life insurance company taxable income (section 801) or the section 832(a) taxable income (section 831)";
}
@source(IRC_S841, quote = "in the case of the tax imposed by section 801, the life insurance company taxable income (as defined in section 801(b))")
rule Section841LifeInsuranceBase(c: Person, y: TaxableYear, income: Money) defeasible {
    label en official "section 841(1): life insurance company taxable income";
    when domestic_insurance_company_subject_to_801_841(c, y);
    when life_insurance_company_taxable_income(c, y, income);
    then taxable_income_base_for_901_limit_841(c, y, income);
}
rule Section841OtherInsuranceBase(c: Person, y: TaxableYear, income: Money) defeasible {
    label en official "section 841(2): the section 832(a) taxable income";
    when domestic_insurance_company_subject_to_831_841(c, y);
    when insurance_company_taxable_income(c, y, income);
    then taxable_income_base_for_901_limit_841(c, y, income);
}
pub relation mean_total_insurance_liabilities_on_us_business_842b2A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the mean of the foreign company's total insurance liabilities on United States business";
}
pub relation domestic_asset_liability_ratio_842b2C(c: Person, y: TaxableYear, ratio: Decimal) kind empirical {
    label en unofficial "the domestic asset/liability percentage applicable to the company for the year, as a ratio (determined by the Secretary)";
}
pub relation domestic_investment_yield_842b3(c: Person, y: TaxableYear, yield_rate: Decimal) kind empirical {
    label en unofficial "the domestic investment yield applicable to the company for the year, as a rate (determined by the Secretary)";
}
pub relation elects_worldwide_yield_842b4(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign company elects to take its worldwide current investment yield into account in lieu of the domestic investment yield";
}
pub relation net_investment_income_all_sources_842b4B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net investment income of the company from all sources";
}
pub relation mean_of_all_assets_842b4B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the mean of all assets of the company (whether or not held in the United States)";
}
pub relation actual_effectively_connected_net_investment_income_842b1(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net investment income of the foreign company for the year that is effectively connected with the conduct of a trade or business within the United States";
}
pub relation required_united_states_assets_842b2(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the required United States assets: the mean of total insurance liabilities on United States business times the domestic asset/liability percentage";
}
@source(IRC_S842_B, quote = "the required United States assets of any foreign company for any taxable year is an amount equal to the product of")
rule Section842b2RequiredAssets(c: Person, y: TaxableYear, liabilities: Money, ratio: Decimal) strict {
    label en official "section 842(b)(2)(A): liabilities times the domestic asset/liability percentage";
    when mean_total_insurance_liabilities_on_us_business_842b2A(c, y, liabilities);
    when domestic_asset_liability_ratio_842b2C(c, y, ratio);
    then required_united_states_assets_842b2(c, y, round(liabilities * ratio, 2, "HALF_UP"));
}
pub relation minimum_effectively_connected_net_investment_income_842b1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the floor on effectively connected net investment income: the required United States assets times the applicable yield";
}
@source(IRC_S842_B, quote = "its net investment income for such year which is effectively connected with")
rule Section842b1FloorAtDomesticYield(c: Person, y: TaxableYear, liabilities: Money, ratio: Decimal, yield_rate: Decimal) defeasible {
    label en official "section 842(b)(1),(3): required assets times the domestic investment yield (one rounding)";
    when mean_total_insurance_liabilities_on_us_business_842b2A(c, y, liabilities);
    when domestic_asset_liability_ratio_842b2C(c, y, ratio);
    when domestic_investment_yield_842b3(c, y, yield_rate);
    when not_known(worldwide_yield_election_in_effect_842b4C(c, y));
    then minimum_effectively_connected_net_investment_income_842b1(c, y, round((liabilities * ratio) * yield_rate, 2, "HALF_UP"));
}
rule Section842b4FloorAtWorldwideYield(c: Person, y: TaxableYear, required: Money, all_income: Money, all_assets: Money) strict {
    label en official "section 842(b)(4): with the election, the worldwide current investment yield replaces the domestic yield";
    when worldwide_yield_election_in_effect_842b4C(c, y);
    when required_united_states_assets_842b2(c, y, required);
    when net_investment_income_all_sources_842b4B(c, y, all_income);
    when mean_of_all_assets_842b4B(c, y, all_assets);
    when all_assets > 0.00 USD;
    then minimum_effectively_connected_net_investment_income_842b1(c, y, div_round(required * (all_income / 1.00 USD), all_assets / 1.00 USD, 2, "HALF_UP"));
}
pub relation effectively_connected_net_investment_income_842b(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the effectively connected net investment income taken into account: not less than the floor";
}
rule Section842bEffectivelyConnectedIncome(c: Person, y: TaxableYear, actual: Money, floor: Money) defeasible {
    label en official "section 842(b)(1): the greater of the actual figure and the floor";
    when actual_effectively_connected_net_investment_income_842b1(c, y, actual);
    when minimum_effectively_connected_net_investment_income_842b1(c, y, floor);
    then effectively_connected_net_investment_income_842b(c, y, max(actual, floor));
}
pub relation section_881_tax_before_842c_842c1A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax under section 881 determined without regard to section 842(c)(1)";
}
pub relation increase_in_effectively_connected_income_from_842b_842c1Ai(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the increase in effectively connected income resulting from subsection (b)";
}
pub relation amount_subject_to_881_without_103_and_894_842c1Aii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount that would be subject to tax under section 881 determined without regard to sections 103 and 894";
}
pub relation increase_in_part_i_or_ii_taxes_from_842b_842c1B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the increase in taxes under part I or II by reason of the increase in effectively connected income";
}
pub relation section_881_tax_reduction_842c1(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reduction of the section 881 tax: the proportion of the increase to the section 881 base, not more than the increase in taxes and not below zero of the tax";
}
@source(IRC_S842_C, quote = "The tax under section 881 (determined without regard to this paragraph) shall be reduced (but not below zero) by an amount which bears the same ratio to such tax as")
rule Section842c1Reduction(c: Person, y: TaxableYear, tax: Money, increase: Money, base: Money, cap: Money) strict {
    label en official "section 842(c)(1)(A)-(B): tax times increase over base, capped at the increase in taxes";
    when section_881_tax_before_842c_842c1A(c, y, tax);
    when increase_in_effectively_connected_income_from_842b_842c1Ai(c, y, increase);
    when amount_subject_to_881_without_103_and_894_842c1Aii(c, y, base);
    when increase_in_part_i_or_ii_taxes_from_842b_842c1B(c, y, cap);
    when base > 0.00 USD;
    then section_881_tax_reduction_842c1(c, y, min(min(tax, cap), div_round(tax * (increase / 1.00 USD), base / 1.00 USD, 2, "HALF_UP")));
}
pub relation insurance_company_accounting_period_is_calendar_year_843(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the annual accounting period of the insurance company for the year is the calendar year";
}
pub relation joins_consolidated_return_and_adopts_parent_year_843(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "under regulations, the company joins in a consolidated return and adopts the taxable year of the common parent, though not a calendar year";
}
pub relation insurance_company_accounting_period_conforms_843(c: Person, y: TaxableYear) kind institutional {
    label en official "the accounting period is the calendar year, or the common parent's year under the consolidated return exception";
}
@source(IRC_S843, quote = "the annual accounting period for each insurance company subject to a tax imposed by this subchapter shall be the calendar year")
rule Section843CalendarYear(c: Person, y: TaxableYear) strict {
    label en official "section 843: the calendar year";
    when insurance_company_accounting_period_is_calendar_year_843(c, y);
    then insurance_company_accounting_period_conforms_843(c, y);
}
rule Section843ConsolidatedParentYear(c: Person, y: TaxableYear) strict {
    label en official "section 843: an exception for a consolidated-return member adopting the common parent's year";
    when joins_consolidated_return_and_adopts_parent_year_843(c, y);
    then insurance_company_accounting_period_conforms_843(c, y);
}
pub relation reinsurance_agreement_between_related_persons_845a(p1: Person, p2: Person) kind empirical {
    label en unofficial "two or more related persons (section 482) are parties to a reinsurance agreement (or one party is, with respect to the agreement, a related person to the other's insurance business)";
}
external judgment relation secretary_determines_allocation_necessary_845a(p1: Person, p2: Person) {
    authority Secretary;
    label en official "the Secretary determines that the allocation, recharacterization or adjustment is necessary to reflect the proper amount, source or character of the taxable income of each person (section 845(a)); DECISION-0194 channel 1";
}
pub relation secretary_exercised_845a_authority(p1: Person, p2: Person, on: Date) kind empirical {
    label en unofficial "the Secretary allocates, recharacterizes or otherwise adjusts items related to the reinsurance agreement on this date";
}
pub relation reinsurance_allocation_valid_845a(p1: Person, p2: Person) kind institutional {
    label en official "the Secretary's section 845(a) action is authorised: the parties are related and the Secretary has determined it necessary";
}
rule Section845aPreconditions(p1: Person, p2: Person) strict {
    label en official "section 845(a): related parties to a reinsurance agreement and the Secretary's necessity determination";
    when reinsurance_agreement_between_related_persons_845a(p1, p2);
    when secretary_determines_allocation_necessary_845a(p1, p2);
    then reinsurance_allocation_valid_845a(p1, p2);
}
pub relation reinsurance_allocation_made_845a(p1: Person, p2: Person) kind institutional {
    label en official "the items related to the reinsurance agreement are allocated, recharacterized or adjusted as the Secretary determined";
}
@source(IRC_S845_A, quote = "allocate between or among such persons income")
rule Section845aSecretaryPower(p1: Person, p2: Person, on: Date) strict {
    label en official "section 845(a): the Secretary's power over a reinsurance agreement between related persons";
    when secretary_exercised_845a_authority(p1, p2, on);
    then power ReinsuranceAllocationByTheSecretary {
        holder us.irc.core::Secretary;
        over p1;
        exercise secretary_exercised_845a_authority(p1, p2, on);
        valid_when reinsurance_allocation_valid_845a(p1, p2);
        effect create(reinsurance_allocation_made_845a(p1, p2));
        window [@1984-07-18, infinity);
    };
}
pub relation reinsurance_contract_has_significant_tax_avoidance_effect_845b(p: Person) kind empirical {
    label en unofficial "the reinsurance contract has a significant tax avoidance effect on the party";
}
external judgment relation secretary_determines_significant_avoidance_effect_845b(p: Person) {
    authority Secretary;
    label en official "the Secretary determines that the reinsurance contract has a significant tax avoidance effect on the party (section 845(b)); DECISION-0194 channel 1";
}
pub relation secretary_exercised_845b_adjustment(p: Person, on: Date) kind empirical {
    label en unofficial "the Secretary makes proper adjustments with respect to the party, including treating the contract as terminated each December 31 and reinstated the next January 1";
}
pub relation reinsurance_adjustment_valid_845b(p: Person) kind institutional {
    label en official "the section 845(b) adjustment is authorised by the Secretary's determination";
}
rule Section845bPrecondition(p: Person) strict {
    label en official "section 845(b): a determination of significant tax avoidance effect";
    when secretary_determines_significant_avoidance_effect_845b(p);
    then reinsurance_adjustment_valid_845b(p);
}
pub relation reinsurance_adjustment_made_845b(p: Person) kind institutional {
    label en official "the Secretary's adjustment eliminating the tax avoidance effect has been made";
}
@source(IRC_S845_B, quote = "the Secretary may make proper adjustments with respect to such party to eliminate such tax avoidance effect")
rule Section845bSecretaryPower(p: Person, on: Date) strict {
    label en official "section 845(b): the Secretary's power to adjust a reinsurance contract with a significant tax avoidance effect";
    when secretary_exercised_845b_adjustment(p, on);
    then power ReinsuranceTaxAvoidanceAdjustment {
        holder us.irc.core::Secretary;
        over p;
        exercise secretary_exercised_845b_adjustment(p, on);
        valid_when reinsurance_adjustment_valid_845b(p);
        effect create(reinsurance_adjustment_made_845b(p));
        window [@1984-07-18, infinity);
    };
}
