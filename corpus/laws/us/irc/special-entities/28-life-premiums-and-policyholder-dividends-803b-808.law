// Section 803(b) (special rules for premiums) and section 808(a)-(g)
// (policyholder dividends: the definition and inclusions, the (d)
// definitions, the paid-and-returned-as-premium treatment, the 1984
// fresh-start coordination, the prevailing State assumed interest rate).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. Premiums and dividends are itemised (`us.irc.core::Payment`), so
// the section 803(a)(1) figures and the section 808(c) amount can be built
// from items; the aggregate case facts of modules 07 and 11
// (`gross_premiums_and_other_consideration_803a1A`,
// `return_premiums_803a1B`, `policyholder_dividends_paid_or_accrued_808c`)
// stay valid as a second path. The stage-2b pass-through of section 808(c)
// now concludes `policyholder_dividends_808c_amount`, from which the
// deduction of section 805(a)(3) is that amount less the 1984 fresh-start
// reduction of subsection (f). Sums over derived items are the section 111
// runtime subset (TECH-GAPS G4903). The excess interest of (d)(1) assumes
// interest that accrues linearly in the rate, so the excess is the credited
// amount times (rate - prevailing rate) / rate; that is an INTERPRETATION.

// ---- Section 803(b): items of gross premiums and return premiums ----

use self::{
    IRC_S803_B,
    IRC_S808_A,
    IRC_S808_B,
    IRC_S808_C,
    IRC_S808_D,
    IRC_S808_E,
    IRC_S808_F,
    IRC_S808_G,
    Person,
    TaxableYear,
    net_premiums_803a1,
    policyholder_dividends_deduction_805a3,
};

pub enum PremiumItemKind803 {
    ItemPremiumOrConsideration;
    ItemAdvancePremium;
    ItemDeposit;
    ItemFee;
    ItemAssessment;
    ItemAssumptionConsideration;
    ItemReimbursableReinsuranceDividend;
    ItemReturnPremium;
    ItemReturnedPolicyholderDividend;
    ItemReturnedOnIndemnityReinsurance;
    label en unofficial "the kind of an item of premiums and other consideration for section 803(a)(1): premium or other consideration, one of the section 803(b)(1) additions, or a return item";
}
@source(IRC_S803_B, quote = "the term \"gross amount of premiums and other consideration\" includes")
pub relation premium_item_803(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: PremiumItemKind803, amount: Money) kind empirical {
    label en unofficial "an item of premiums, other consideration or returns on insurance and annuity contracts in the taxable year, with its kind and amount";
}
pub relation included_premium_item_803b1(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item of the gross amount of premiums and other consideration: premiums and other consideration, advance premiums, deposits, fees, assessments, assumption consideration, reimbursable reinsurance dividends";
}
@source(IRC_S803_B, quote = "(A) advance premiums,")
rule Section803b1APremiumOrConsideration(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(a)(1)(A): premiums and other consideration";
    when premium_item_803(c, y, item, ItemPremiumOrConsideration, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(A) advance premiums,")
rule Section803b1AAdvancePremium(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(A): advance premiums are included";
    when premium_item_803(c, y, item, ItemAdvancePremium, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(B) deposits,")
rule Section803b1BDeposit(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(B): deposits are included";
    when premium_item_803(c, y, item, ItemDeposit, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(C) fees,")
rule Section803b1CFee(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(C): fees are included";
    when premium_item_803(c, y, item, ItemFee, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(D) assessments,")
rule Section803b1DAssessment(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(D): assessments are included";
    when premium_item_803(c, y, item, ItemAssessment, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(E) consideration in respect of assuming liabilities under contracts not issued by the taxpayer, and")
rule Section803b1EAssumption(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(E): consideration for assuming liabilities under contracts not issued by the taxpayer is included";
    when premium_item_803(c, y, item, ItemAssumptionConsideration, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
@source(IRC_S803_B, quote = "(F) the amount of policyholder dividends reimbursable to the taxpayer by a reinsurer in respect of reinsured policies,")
rule Section803b1FReimbursableDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(1)(F): policyholder dividends reimbursable to the taxpayer by a reinsurer are included";
    when premium_item_803(c, y, item, ItemReimbursableReinsuranceDividend, amount);
    then included_premium_item_803b1(c, y, item, amount);
}
pub relation return_premium_item_803a1B(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item deducted as return premiums under section 803(a)(1)(B): a return premium, or premiums or consideration returned to another life insurance company on indemnity reinsurance (a returned policyholder dividend is not a return premium)";
}
@source(IRC_S803_B, quote = "Except as provided in subparagraph (B), the term \"return premiums\" does not include any policyholder dividends.")
rule Section803b2AReturnPremium(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(a)(1)(B): return premiums";
    when premium_item_803(c, y, item, ItemReturnPremium, amount);
    then return_premium_item_803a1B(c, y, item, amount);
}
@source(IRC_S803_B, quote = "Subparagraph (A) shall not apply to amounts of premiums or other consideration returned to another life insurance company in respect of indemnity reinsurance.")
rule Section803b2BIndemnityReinsuranceReturn(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 803(b)(2)(B): amounts returned to another life insurance company on indemnity reinsurance are return premiums even if dividends";
    when premium_item_803(c, y, item, ItemReturnedOnIndemnityReinsurance, amount);
    then return_premium_item_803a1B(c, y, item, amount);
}
// a returned policyholder dividend (ItemReturnedPolicyholderDividend) has no
// rule above on purpose: section 803(b)(2)(A) keeps it out of return premiums.
pub relation gross_premiums_from_items_803a1A(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross amount of premiums and other consideration, built from the included items (a sum over derived items, TECH-GAPS G4903)";
}
rule Section803a1AGrossFromItems(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 803(a)(1)(A) with (b)(1): the sum of the included items";
    when included_premium_item_803b1(c, y, anchor, anchor_amount);
    then gross_premiums_from_items_803a1A(c, y, sum all amount: Money for item: us.irc.core::Payment where included_premium_item_803b1(c, y, item, amount));
}
pub relation return_premiums_from_items_803a1B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the return premiums, built from the return items (a sum over derived items, TECH-GAPS G4903)";
}
rule Section803a1BReturnFromItems(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) strict {
    label en official "section 803(a)(1)(B): the sum of the return items";
    when return_premium_item_803a1B(c, y, anchor, anchor_amount);
    then return_premiums_from_items_803a1B(c, y, sum all amount: Money for item: us.irc.core::Payment where return_premium_item_803a1B(c, y, item, amount));
}
rule Section803a1NetPremiumsFromItems(c: Person, y: TaxableYear, gross: Money, returned: Money) defeasible {
    label en official "section 803(a)(1): net premiums from the itemised gross premiums and return premiums";
    when gross_premiums_from_items_803a1A(c, y, gross);
    when return_premiums_from_items_803a1B(c, y, returned);
    then net_premiums_803a1(c, y, gross - returned);
}

pub relation has_return_premium_item_803(c: Person, y: TaxableYear) kind institutional {
    label en official "a return item exists for the company and year (helper)";
}
rule Section803HasReturnItem(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "helper";
    when return_premium_item_803a1B(c, y, item, amount);
    then has_return_premium_item_803(c, y);
}
rule Section803a1NetPremiumsNoReturnItems(c: Person, y: TaxableYear, gross: Money) defeasible {
    label en official "section 803(a)(1): with no return item the net premiums are the gross amount";
    when gross_premiums_from_items_803a1A(c, y, gross);
    when not_known(has_return_premium_item_803(c, y));
    then net_premiums_803a1(c, y, gross);
}

// ---- Section 808(g): the prevailing State assumed interest rate ----

pub entity StateInsuranceLaw808g {
    label en unofficial "the insurance law of one State, as to the highest assumed interest rate it permits for computing life insurance reserves";
}
pub enum ContractKind808g {
    InsuranceContractKind;
    AnnuityContractKind;
    label en unofficial "insurance contracts or annuity contracts, as the case may be";
}
@source(IRC_S808_G, quote = "the highest assumed interest rate permitted to be used in computing life insurance reserves for insurance contracts or annuity contracts (as the case may be) under the insurance laws of at least 26 States")
pub relation state_permits_assumed_rate_808g1(law: StateInsuranceLaw808g, as_of: Date, kind: ContractKind808g, rate: Decimal) kind empirical {
    label en unofficial "the State's insurance law permits, as of this date, this highest assumed interest rate for reserves of contracts of this kind (the effect of nonforfeiture laws on reserve interest rates is not taken into account: the case asserts the reserve rate)";
}
pub relation rate_permitted_in_26_states_808g1(as_of: Date, kind: ContractKind808g, rate: Decimal) kind institutional {
    label en official "at least 26 States permit an assumed interest rate at or above this rate as of the date (a count over derived rows, TECH-GAPS G4903)";
}
@source(IRC_S808_G, quote = "under the insurance laws of at least 26 States")
rule Section808g1TwentySixStates(law0: StateInsuranceLaw808g, as_of: Date, kind: ContractKind808g, rate: Decimal) defeasible {
    label en official "section 808(g)(1): a rate that at least 26 State laws permit or exceed (each State law is one row per date and kind)";
    when state_permits_assumed_rate_808g1(law0, as_of, kind, rate);
    when count(collect all l: StateInsuranceLaw808g, r2: Decimal where state_permits_assumed_rate_808g1(l, as_of, kind, r2) and r2 >= rate) >= 26;
    then rate_permitted_in_26_states_808g1(as_of, kind, rate);
}
pub relation higher_rate_permitted_in_26_states_808g1(as_of: Date, kind: ContractKind808g, rate: Decimal) kind institutional {
    label en official "a strictly higher rate is also permitted in at least 26 States";
}
rule Section808g1HigherRateExists(as_of: Date, kind: ContractKind808g, rate: Decimal, higher: Decimal) defeasible {
    label en official "no maximum aggregate exists (TECH-GAPS G136): a strictly higher qualifying rate is derived";
    when rate_permitted_in_26_states_808g1(as_of, kind, rate);
    when rate_permitted_in_26_states_808g1(as_of, kind, higher);
    when higher > rate;
    then higher_rate_permitted_in_26_states_808g1(as_of, kind, rate);
}
pub relation prevailing_state_assumed_rate_at_808g(as_of: Date, kind: ContractKind808g, rate: Decimal) kind institutional {
    label en official "the highest assumed interest rate permitted in at least 26 States as of the date, for contracts of the kind";
}
@source(IRC_S808_G, quote = "the highest assumed interest rate permitted")
rule Section808g1Prevailing(as_of: Date, kind: ContractKind808g, rate: Decimal) defeasible {
    label en official "section 808(g)(1): the highest rate that at least 26 States permit";
    when rate_permitted_in_26_states_808g1(as_of, kind, rate);
    when not_known(higher_rate_permitted_in_26_states_808g1(as_of, kind, rate));
    then prevailing_state_assumed_rate_at_808g(as_of, kind, rate);
}
@source(IRC_S808_G, quote = "The prevailing State assumed interest rate with respect to any contract shall be determined as of the beginning of the calendar year in which the contract was issued.")
pub relation contract_kind_and_issue_date_808g(contract: us.irc.core::Asset, kind: ContractKind808g, issued_on: Date) kind empirical {
    label en unofficial "the contract is of this kind and was issued on this date";
}
pub relation prevailing_state_assumed_rate_808g(contract: us.irc.core::Asset, rate: Decimal) kind institutional {
    label en official "the prevailing State assumed interest rate with respect to the contract, determined as of the beginning of the calendar year in which it was issued (the case supplies the State rows as of that January 1; the row whose calendar year contains the issue date is used)";
}
@source(IRC_S808_G, quote = "The prevailing State assumed interest rate with respect to any contract shall be determined as of the beginning of the calendar year in which the contract was issued.")
rule Section808g2RateAtBeginningOfIssueYear(contract: us.irc.core::Asset, kind: ContractKind808g, issued_on: Date, as_of: Date, rate: Decimal) defeasible {
    label en official "section 808(g)(2): the rate as of the beginning of the calendar year of issue (the determination date is at most the issue date and less than 12 calendar months before it)";
    when contract_kind_and_issue_date_808g(contract, kind, issued_on);
    when prevailing_state_assumed_rate_at_808g(as_of, kind, rate);
    when as_of <= issued_on;
    when add_calendar_period(as_of, 12 calendar_month) > issued_on;
    then prevailing_state_assumed_rate_808g(contract, rate);
}

// ---- Section 808(a), (b), (d): policyholder dividends and their inclusions ----

@source(IRC_S808_A, quote = "the term \"policyholder dividend\" means any dividend or similar distribution to policyholders in their capacity as such")
pub relation distribution_to_policyholders_808a(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "a dividend or similar distribution to policyholders in their capacity as such, paid or accrued in the taxable year, on the contract";
}
pub relation policyholder_dividend_item_808(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "a policyholder dividend item: a dividend or similar distribution to policyholders (subsection (a)), or an amount included by subsection (b)";
}
@source(IRC_S808_A, quote = "the term \"policyholder dividend\" means any dividend or similar distribution to policyholders in their capacity as such")
rule Section808aDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(a): a dividend or similar distribution to policyholders in their capacity as such";
    when distribution_to_policyholders_808a(c, y, item, contract, amount);
    then policyholder_dividend_item_808(c, y, item, contract, amount);
}
@source(IRC_S808_B, quote = "any amount paid or credited (including as an increase in benefits) where the amount is not fixed in the contract but depends on the experience of the company or the discretion of the management")
pub relation amount_paid_or_credited_808b1(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "an amount paid or credited on the contract (including as an increase in benefits)";
}
pub relation amount_fixed_in_contract_808b1(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount is fixed in the contract";
}
pub relation amount_depends_on_experience_or_discretion_808b1(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount depends on the experience of the company or the discretion of the management";
}
@source(IRC_S808_B, quote = "any amount paid or credited (including as an increase in benefits) where the amount is not fixed in the contract but depends on the experience of the company or the discretion of the management")
rule Section808b1ExperienceOrDiscretion(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(b)(1): an amount not fixed in the contract that depends on the company's experience or management's discretion";
    when amount_paid_or_credited_808b1(c, y, item, contract, amount);
    when amount_depends_on_experience_or_discretion_808b1(item);
    when not_known(amount_fixed_in_contract_808b1(item));
    then policyholder_dividend_item_808(c, y, item, contract, amount);
}
@source(IRC_S808_D, quote = "The term \"excess interest\" means any amount in the nature of interest")
pub relation interest_credited_to_policyholder_808d1A(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money, rate: Decimal) kind empirical {
    label en unofficial "an amount in the nature of interest paid or credited to a policyholder in his capacity as such, at this credited rate";
}
pub relation excess_interest_808d1(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, excess: Money) kind institutional {
    label en official "the amount of interest in excess of interest determined at the prevailing State assumed rate for the contract";
}
@source(IRC_S808_D, quote = "in excess of interest determined at the prevailing State assumed rate for such contract")
rule Section808d1BExcessInterest(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money, rate: Decimal, prevailing: Decimal) defeasible {
    label en official "section 808(d)(1): credited interest above the prevailing State assumed rate (linear in the rate: amount x (rate - prevailing) / rate; cents HALF_UP is a JUDGMENT CALL, one rounding)";
    when interest_credited_to_policyholder_808d1A(c, y, item, contract, amount, rate);
    when prevailing_state_assumed_rate_808g(contract, prevailing);
    when rate > prevailing;
    then excess_interest_808d1(c, y, item, contract, div_round(amount * (rate - prevailing), rate, 2, "HALF_UP"));
}
@source(IRC_S808_B, quote = "(2) excess interest,")
rule Section808b2ExcessInterestIsDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, excess: Money) defeasible {
    label en official "section 808(b)(2): excess interest is a policyholder dividend";
    when excess_interest_808d1(c, y, item, contract, excess);
    then policyholder_dividend_item_808(c, y, item, contract, excess);
}
@source(IRC_S808_D, quote = "The term \"premium adjustment\" means any reduction in the premium under an insurance or annuity contract which (but for the reduction) would have been required to be paid under the contract.")
pub relation premium_reduction_808d2(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "a reduction in the premium under an insurance or annuity contract";
}
pub relation premium_otherwise_required_by_contract_808d2(item: us.irc.core::Payment) kind empirical {
    label en unofficial "but for the reduction the premium would have been required to be paid under the contract";
}
pub relation premium_adjustment_808d2(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "a premium adjustment: a reduction of a premium that the contract would otherwise have required";
}
@source(IRC_S808_D, quote = "The term \"premium adjustment\" means any reduction in the premium under an insurance or annuity contract which (but for the reduction) would have been required to be paid under the contract.")
rule Section808d2PremiumAdjustment(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) strict {
    label en official "section 808(d)(2): a reduction of a premium otherwise required under the contract";
    when premium_reduction_808d2(c, y, item, contract, amount);
    when premium_otherwise_required_by_contract_808d2(item);
    then premium_adjustment_808d2(c, y, item, contract, amount);
}
@source(IRC_S808_B, quote = "(3) premium adjustments, and")
rule Section808b3PremiumAdjustmentIsDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(b)(3): premium adjustments are policyholder dividends";
    when premium_adjustment_808d2(c, y, item, contract, amount);
    then policyholder_dividend_item_808(c, y, item, contract, amount);
}
@source(IRC_S808_D, quote = "The term \"experience-rated refund\" means any refund or credit based on the experience of the contract or group involved.")
pub relation refund_or_credit_808d3(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "a refund or credit on the contract";
}
pub relation refund_based_on_experience_of_contract_or_group_808d3(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the refund or credit is based on the experience of the contract or group involved";
}
pub relation experience_rated_refund_808d3(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "an experience-rated refund";
}
@source(IRC_S808_D, quote = "The term \"experience-rated refund\" means any refund or credit based on the experience of the contract or group involved.")
rule Section808d3ExperienceRatedRefund(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) strict {
    label en official "section 808(d)(3): a refund or credit based on the experience of the contract or group";
    when refund_or_credit_808d3(c, y, item, contract, amount);
    when refund_based_on_experience_of_contract_or_group_808d3(item);
    then experience_rated_refund_808d3(c, y, item, contract, amount);
}
@source(IRC_S808_B, quote = "(4) experience-rated refunds.")
rule Section808b4RefundIsDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(b)(4): experience-rated refunds are policyholder dividends";
    when experience_rated_refund_808d3(c, y, item, contract, amount);
    then policyholder_dividend_item_808(c, y, item, contract, amount);
}

// ---- Section 808(e): paid and returned as premium ----

pub relation dividend_increases_cash_value_or_benefits_808e1(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the policyholder dividend increases the cash surrender value of the contract or other benefits payable under it";
}
pub relation dividend_reduces_premium_808e2(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the policyholder dividend reduces the premium otherwise required to be paid";
}
pub relation dividend_treated_as_returned_as_premium_808e(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the dividend is treated as paid to the policyholder and returned by the policyholder to the company as a premium (so it is also premium consideration under section 803)";
}
@source(IRC_S808_E, quote = "shall be treated as paid to the policyholder and returned by the policyholder to the company as a premium")
rule Section808e1CashValueIncrease(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(e)(1): a dividend that increases the cash surrender value or other benefits is paid and returned as premium";
    when policyholder_dividend_item_808(c, y, item, contract, amount);
    when dividend_increases_cash_value_or_benefits_808e1(item);
    then dividend_treated_as_returned_as_premium_808e(c, y, item, amount);
}
@source(IRC_S808_E, quote = "shall be treated as paid to the policyholder and returned by the policyholder to the company as a premium")
rule Section808e2PremiumReduction(c: Person, y: TaxableYear, item: us.irc.core::Payment, contract: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 808(e)(2): a dividend that reduces the premium otherwise required is paid and returned as premium";
    when policyholder_dividend_item_808(c, y, item, contract, amount);
    when dividend_reduces_premium_808e2(item);
    then dividend_treated_as_returned_as_premium_808e(c, y, item, amount);
}
@source(IRC_S808_E, quote = "shall be treated as paid to the policyholder and returned by the policyholder to the company as a premium")
rule Section808eDeemedPremiumIsIncludedItem(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 808(e) with 803(a)(1)(A): the deemed premium is premium consideration (the amount is the dividend's)";
    when dividend_treated_as_returned_as_premium_808e(c, y, item, amount);
    then included_premium_item_803b1(c, y, item, amount);
}

// ---- Section 808(c): the amount and the deduction ----

pub relation policyholder_dividends_808c_amount(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the policyholder dividends paid or accrued during the taxable year (before the section 808(f) reduction)";
}
rule Section808cAmountFromItems(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_contract: us.irc.core::Asset, anchor_amount: Money) defeasible {
    label en official "section 808(c): the sum of the policyholder dividend items of the year (a sum over derived items, TECH-GAPS G4903)";
    when policyholder_dividend_item_808(c, y, anchor, anchor_contract, anchor_amount);
    then policyholder_dividends_808c_amount(c, y, sum all amount: Money for item: us.irc.core::Payment where policyholder_dividend_item_808(c, y, item, _, amount));
}

// ---- Section 808(f): the 1984 fresh-start coordination ----

pub entity LineOfBusiness808f {
    label en unofficial "a line of business of the taxpayer (section 808(f)(5): the coordination applies separately to each)";
}
@source(IRC_S808_F, quote = "the term \"year of change\" means the taxable year in which the change in business practices which results in the accelerated policyholder dividends deduction takes effect")
pub relation year_of_change_808f2(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind empirical {
    label en unofficial "the taxable year is the year in which the change in business practices resulting in the accelerated deduction takes effect, for the line of business";
}
@source(IRC_S808_F, quote = "the term \"accelerated policyholder dividends deduction\" means the amount which (but for this subsection) would be determined for the taxable year under paragraph (1) of subsection (c) but which would have been determined (under such paragraph) for a later taxable year under the business practices of the taxpayer as in effect at the close of the preceding taxable year")
pub relation accelerated_policyholder_dividends_deduction_808f3(c: Person, y: TaxableYear, lob: LineOfBusiness808f, amount: Money) kind empirical {
    label en unofficial "the accelerated policyholder dividends deduction for the year of change and line of business (the amount that would have been determined for a later year under last year's business practices)";
}
pub relation reserves_for_dividends_at_end_of_1983_808f4(c: Person, lob: LineOfBusiness808f, amount: Money) kind empirical {
    label en unofficial "the amounts held as of December 31, 1983 as reserves for dividends to policyholders under section 811(b) as then in effect";
}
pub relation dividends_accrued_before_1984_808f4(c: Person, lob: LineOfBusiness808f, amount: Money) kind empirical {
    label en unofficial "the part of those reserves that is for dividends which accrued before January 1, 1984";
}
pub relation previously_nondeductible_dividends_809f_808f4(c: Person, lob: LineOfBusiness808f, amount: Money) kind empirical {
    label en unofficial "the amount of previously nondeductible policyholder dividends under section 809(f) as in effect before the Tax Reform Act of 1984";
}
pub relation fresh_start_adjustment_taken_into_account_808f1(c: Person, lob: LineOfBusiness808f, amount: Money) kind empirical {
    label en unofficial "the part of the 1984 fresh-start adjustment already taken into account under subsection (f)";
}
pub relation dividend_on_policy_issued_after_1983_808f7A(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind empirical {
    label en unofficial "the dividends of the line of business are paid or accrued with respect to a policy issued after December 31, 1983";
}
pub relation policy_issued_in_exchange_for_similar_pre_1984_policy_808f7B(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind empirical {
    label en unofficial "the post-1983 policy was issued in exchange for a substantially similar policy issued on or before that date (or in a series of such exchanges)";
}
pub relation dividend_on_group_welfare_plan_policy_808f8(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind empirical {
    label en unofficial "the dividend is paid or accrued with respect to a group policy issued in connection with a plan to provide welfare benefits to employees (section 419(e)(2))";
}
pub relation change_is_mere_change_in_dividend_amount_808f6(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind empirical {
    label en unofficial "the change is a mere change in the amount of policyholder dividends";
}
pub relation fresh_start_adjustment_808f4(c: Person, lob: LineOfBusiness808f, amount: Money) kind institutional {
    label en official "the 1984 fresh-start adjustment for policyholder dividends: the reserves at the end of 1983 less dividends accrued before 1984, properly reduced by previously nondeductible dividends (floored at zero)";
}
@source(IRC_S808_F, quote = "other than for dividends which accrued before January 1, 1984. Such amounts shall be properly reduced to reflect the amount of previously nondeductible policyholder dividends")
rule Section808f4FreshStartAdjustment(c: Person, lob: LineOfBusiness808f, reserves: Money, accrued: Money, nondeductible: Money) defeasible {
    label en official "section 808(f)(4): reserves at 12/31/1983 less dividends accrued before 1984 less previously nondeductible dividends (INTERPRETATION: 'properly reduced' is the plain subtraction; the result is not below zero)";
    when reserves_for_dividends_at_end_of_1983_808f4(c, lob, reserves);
    when dividends_accrued_before_1984_808f4(c, lob, accrued);
    when previously_nondeductible_dividends_809f_808f4(c, lob, nondeductible);
    when reserves - accrued - nondeductible >= 0.00 USD;
    then fresh_start_adjustment_808f4(c, lob, reserves - accrued - nondeductible);
}
rule Section808f4FreshStartAdjustmentFloor(c: Person, lob: LineOfBusiness808f, reserves: Money, accrued: Money, nondeductible: Money) defeasible {
    label en official "section 808(f)(4): the adjustment is not below zero";
    when reserves_for_dividends_at_end_of_1983_808f4(c, lob, reserves);
    when dividends_accrued_before_1984_808f4(c, lob, accrued);
    when previously_nondeductible_dividends_809f_808f4(c, lob, nondeductible);
    when reserves - accrued - nondeductible < 0.00 USD;
    then fresh_start_adjustment_808f4(c, lob, 0.00 USD);
}
pub relation fresh_start_coordination_applies_808f(c: Person, y: TaxableYear, lob: LineOfBusiness808f) kind institutional {
    label en official "subsection (f) applies to the line of business in the year of change: not a mere change in the amount of dividends, and not for dividends on post-1983 policies (unless an exchange of a substantially similar pre-1984 policy) or on group welfare plan policies";
}
@source(IRC_S808_F, quote = "This subsection shall not apply to a mere change in the amount of policyholder dividends.")
rule Section808fApplies(c: Person, y: TaxableYear, lob: LineOfBusiness808f) defeasible {
    label en official "section 808(f)(2), (6), (7), (8): the year of change, excluding a mere change in amount, post-1983 policies and group welfare plan policies";
    when year_of_change_808f2(c, y, lob);
    when not_known(change_is_mere_change_in_dividend_amount_808f6(c, y, lob));
    when not_known(dividend_on_policy_issued_after_1983_808f7A(c, y, lob));
    when not_known(dividend_on_group_welfare_plan_policy_808f8(c, y, lob));
    then fresh_start_coordination_applies_808f(c, y, lob);
}
@source(IRC_S808_F, quote = "For purposes of subparagraph (A), any policy issued after December 31, 1983, in exchange for a substantially similar policy issued on or before such date shall be treated as issued before January 1, 1984.")
rule Section808f7BExchangePolicyTreatedAsPre1984(c: Person, y: TaxableYear, lob: LineOfBusiness808f) defeasible {
    label en official "section 808(f)(7)(B): a post-1983 policy issued in exchange for a substantially similar pre-1984 policy is treated as issued before 1984, so the subsection still applies";
    when year_of_change_808f2(c, y, lob);
    when dividend_on_policy_issued_after_1983_808f7A(c, y, lob);
    when policy_issued_in_exchange_for_similar_pre_1984_policy_808f7B(c, y, lob);
    when not_known(change_is_mere_change_in_dividend_amount_808f6(c, y, lob));
    when not_known(dividend_on_group_welfare_plan_policy_808f8(c, y, lob));
    then fresh_start_coordination_applies_808f(c, y, lob);
}
pub relation fresh_start_reduction_808f(c: Person, y: TaxableYear, lob: LineOfBusiness808f, reduction: Money) kind institutional {
    label en official "the reduction of the year-of-change dividend amount: the accelerated deduction up to the part of the 1984 fresh-start adjustment not previously taken into account";
}
@source(IRC_S808_F, quote = "be reduced by so much of the accelerated policyholder dividends deduction for such year as does not exceed the 1984 fresh-start adjustment for policyholder dividends (to the extent such adjustment was not previously taken into account under this subsection)")
rule Section808f1ReductionByAcceleratedDeduction(c: Person, y: TaxableYear, lob: LineOfBusiness808f, accelerated: Money, adjustment: Money, taken: Money) defeasible {
    label en official "section 808(f)(1): the accelerated deduction, but not more than the unused fresh-start adjustment";
    when fresh_start_coordination_applies_808f(c, y, lob);
    when accelerated_policyholder_dividends_deduction_808f3(c, y, lob, accelerated);
    when fresh_start_adjustment_808f4(c, lob, adjustment);
    when fresh_start_adjustment_taken_into_account_808f1(c, lob, taken);
    when accelerated <= adjustment - taken;
    then fresh_start_reduction_808f(c, y, lob, accelerated);
}
rule Section808f1ReductionCappedByAdjustment(c: Person, y: TaxableYear, lob: LineOfBusiness808f, accelerated: Money, adjustment: Money, taken: Money) defeasible {
    label en official "section 808(f)(1): the reduction is capped at the unused fresh-start adjustment";
    when fresh_start_coordination_applies_808f(c, y, lob);
    when accelerated_policyholder_dividends_deduction_808f3(c, y, lob, accelerated);
    when fresh_start_adjustment_808f4(c, lob, adjustment);
    when fresh_start_adjustment_taken_into_account_808f1(c, lob, taken);
    when accelerated > adjustment - taken;
    then fresh_start_reduction_808f(c, y, lob, adjustment - taken);
}
pub relation fresh_start_reduction_total_808f(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the section 808(f) reductions over the lines of business (a sum over derived rows, TECH-GAPS G4903)";
}
rule Section808f5TotalReduction(c: Person, y: TaxableYear, anchor: LineOfBusiness808f, anchor_amount: Money) defeasible {
    label en official "section 808(f)(5): the reductions are applied separately per line of business and added";
    when fresh_start_reduction_808f(c, y, anchor, anchor_amount);
    then fresh_start_reduction_total_808f(c, y, sum all r: Money for lob: LineOfBusiness808f where fresh_start_reduction_808f(c, y, lob, r));
}

// ---- The deduction of section 805(a)(3) ----

pub relation has_fresh_start_reduction_808f(c: Person, y: TaxableYear) kind institutional {
    label en official "a section 808(f) reduction has been derived for the company and year (helper)";
}
rule Section808fHasReduction(c: Person, y: TaxableYear, total: Money) defeasible {
    label en official "helper";
    when fresh_start_reduction_total_808f(c, y, total);
    then has_fresh_start_reduction_808f(c, y);
}
@source(IRC_S808_C, quote = "The deduction for policyholder dividends for any taxable year shall be an amount equal to the policyholder dividends paid or accrued during the taxable year.")
rule Section808cDeductionAfterFreshStart(c: Person, y: TaxableYear, amount: Money, reduction: Money) defeasible {
    label en official "sections 808(c), (f)(1): the deduction is the dividends paid or accrued less the fresh-start reduction of the year of change";
    when policyholder_dividends_808c_amount(c, y, amount);
    when fresh_start_reduction_total_808f(c, y, reduction);
    then policyholder_dividends_deduction_805a3(c, y, amount - reduction);
}
@source(IRC_S808_C, quote = "The deduction for policyholder dividends for any taxable year shall be an amount equal to the policyholder dividends paid or accrued during the taxable year.")
rule Section808cDeductionWithoutFreshStart(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 808(c): with no fresh-start reduction the deduction is the dividends paid or accrued";
    when policyholder_dividends_808c_amount(c, y, amount);
    when not_known(has_fresh_start_reduction_808f(c, y));
    then policyholder_dividends_deduction_805a3(c, y, amount);
}
