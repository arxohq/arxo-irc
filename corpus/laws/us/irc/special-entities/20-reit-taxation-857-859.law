// Sections 857(b)(3)-(5), (b)(7)-(9), 857(c)-(g), 858 and 859 (real estate
// investment trusts: capital gain dividends and undistributed capital gain,
// the tax on foreclosure property income, the tax after income-test relief,
// the taxable REIT subsidiary transaction taxes, the dividend rules for
// shareholders, earnings and profits, excess noncash income, the
// ownership-regulation duty and its penalties, the cap on designations,
// dividends declared after the close of the year, and the calendar-year
// accounting period). Stage 2c (IRC-09 stage 2c, A12), 26.09.2026. Status
// implemented_unverified.
//
// METHOD. The highest section 11 rate is the case-supplied
// `highest_rate_of_tax_section_11` of module 15 (the corporate rate is flat
// under current law; a rate schedule is not modelled in this package).
// Every proportion is one `div_round` (TECH-GAPS G499); a designation is a
// `power` whose exercise is valid only when timely and within the cap; the
// duty to pay the tax on undistributed capital gain and the duty to comply
// with the ownership regulations are `duty` positions with a statutory
// window, so an unmet duty reads as VIOLATED after the window.

// ---- Section 857(b)(3): capital gain dividends ----

use self::{
    IRC_S857_B,
    IRC_S857_C,
    IRC_S857_D,
    IRC_S857_E,
    IRC_S857_F,
    IRC_S857_G,
    IRC_S858_A,
    IRC_S858_B,
    IRC_S858_C,
    IRC_S859_A,
    IRC_S859_B,
    Person,
    TaxableYear,
    real_estate_investment_trust,
    reit_failure_due_to_reasonable_cause_not_willful_neglect,
    reit_income_tests_deemed_satisfied_856c6,
    rents_exception_present_857b7B,
};

pub relation reit_designates_capital_gain_dividend_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, mailed_on: Date) kind empirical {
    label en unofficial "the trust designates the dividend (or part) as a capital gain dividend in a written notice mailed to its shareholders on this date (or with its annual report)";
}
pub relation designation_notice_mailed_with_annual_report_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the notice was mailed with the annual report for the taxable year";
}
pub relation designation_timely_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the notice was mailed before the expiration of 30 days after the close of the taxable year (or with the annual report)";
}
@source(IRC_S857_B, quote = "at any time before the expiration of 30 days after the close of its taxable year")
rule Section857b3BTimelyByThirtyDays(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, mailed_on: Date, ends_on: Date) strict {
    label en official "section 857(b)(3)(B): the notice is mailed within 30 days after the close of the taxable year";
    when reit_designates_capital_gain_dividend_857b3B(t, y, dividend, amount, mailed_on);
    when us.irc.core::ends(y, ends_on);
    when mailed_on <= add_calendar_period(ends_on, 30 calendar_day);
    then designation_timely_857b3B(t, y, dividend);
}
@source(IRC_S857_B, quote = "(or mailed to its shareholders or holders of beneficial interests with its annual report for the taxable year)")
rule Section857b3BTimelyWithAnnualReport(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) strict {
    label en official "section 857(b)(3)(B): a notice mailed with the annual report is timely";
    when designation_notice_mailed_with_annual_report_857b3B(t, y, dividend);
    then designation_timely_857b3B(t, y, dividend);
}
pub relation dividends_paid_for_year_including_858_857g1(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dividends paid by the trust with respect to the taxable year, counting dividends paid after the close of the year that are treated as paid under section 858";
}
pub relation aggregate_designated_dividends_857g1(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of dividends designated by the trust under subsections (b)(3)(C) and (c)(2)(A) with respect to the taxable year";
}
pub relation designations_within_dividends_paid_857g1(t: Person, y: TaxableYear) kind institutional {
    label en official "the aggregate designated dividends do not exceed the dividends paid with respect to the year";
}
@source(IRC_S857_G, quote = "The aggregate amount of dividends designated by a real estate investment trust under subsections (b)(3)(C) and (c)(2)(A) with respect to any taxable year may not exceed the dividends paid by such trust with respect to such year.")
rule Section857g1DesignationCap(t: Person, y: TaxableYear, designated: Money, paid: Money) strict {
    label en official "section 857(g)(1): designations may not exceed the dividends paid";
    when aggregate_designated_dividends_857g1(t, y, designated);
    when dividends_paid_for_year_including_858_857g1(t, y, paid);
    when designated <= paid;
    then designations_within_dividends_paid_857g1(t, y);
}
pub relation capital_gain_dividend_designation_valid_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the designation is timely and within the cap of section 857(g)(1)";
}
rule Section857b3BDesignationValid(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) strict {
    label en official "sections 857(b)(3)(B), (g)(1): a timely designation within the dividends paid";
    when designation_timely_857b3B(t, y, dividend);
    when designations_within_dividends_paid_857g1(t, y);
    then capital_gain_dividend_designation_valid_857b3B(t, y, dividend);
}
pub relation capital_gain_dividend_designated_amount_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the designated amount of the dividend that is a capital gain dividend, before the net capital gain ceiling";
}
@source(IRC_S857_B, quote = "a capital gain dividend is any dividend, or part thereof, which is designated by the real estate investment trust as a capital gain dividend")
rule Section857b3BDesignationPower(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, mailed_on: Date) strict {
    label en official "section 857(b)(3)(B): the trust designates capital gain dividends by written notice";
    when reit_designates_capital_gain_dividend_857b3B(t, y, dividend, amount, mailed_on);
    then power CapitalGainDividendDesignation {
        holder t;
        over dividend;
        exercise reit_designates_capital_gain_dividend_857b3B(t, y, dividend, amount, mailed_on);
        valid_when capital_gain_dividend_designation_valid_857b3B(t, y, dividend);
        effect create(capital_gain_dividend_designated_amount_857b3B(t, y, dividend, amount));
        window [@1960-01-01, infinity);
    };
}
pub relation aggregate_capital_gain_designated_857b3B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount designated as capital gain dividends for the taxable year, including those paid after the close of the year under section 858";
}
pub relation net_capital_gain_of_reit_857b3B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net capital gain of the taxable year (for a non-calendar year determined without regard to a net capital loss attributable to transactions after December 31, which is treated as arising on the 1st day of the next year)";
}
pub relation capital_gain_dividend_portion_857b3B(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the portion of the dividend that is a capital gain dividend after scaling the designations down to the net capital gain";
}
@source(IRC_S857_B, quote = "the portion of each distribution which shall be a capital gain dividend shall be only that proportion of the amount so designated which such net capital gain bears to the aggregate amount so designated")
rule Section857b3BScaledToNetCapitalGain(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, designated: Money, aggregate: Money, ncg: Money) strict {
    label en official "section 857(b)(3)(B): when the aggregate designated exceeds net capital gain, each distribution keeps only the proportion ncg/aggregate";
    when capital_gain_dividend_designated_amount_857b3B(t, y, dividend, designated);
    when aggregate_capital_gain_designated_857b3B(t, y, aggregate);
    when net_capital_gain_of_reit_857b3B(t, y, ncg);
    when aggregate > ncg;
    then capital_gain_dividend_portion_857b3B(t, y, dividend, div_round(designated * (ncg / 1.00 USD), aggregate / 1.00 USD, 2, "HALF_UP"));
}
rule Section857b3BNotScaledWithinNetCapitalGain(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, designated: Money, aggregate: Money, ncg: Money) strict {
    label en official "section 857(b)(3)(B): designations not above net capital gain stand in full";
    when capital_gain_dividend_designated_amount_857b3B(t, y, dividend, designated);
    when aggregate_capital_gain_designated_857b3B(t, y, aggregate);
    when net_capital_gain_of_reit_857b3B(t, y, ncg);
    when aggregate <= ncg;
    then capital_gain_dividend_portion_857b3B(t, y, dividend, designated);
}
pub relation reit_shareholder_capital_gain_dividend_857b3A(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the shareholder treats the capital gain dividend as gain from the sale or exchange of a capital asset held for more than 1 year";
}
pub relation shareholder_receives_reit_dividend_857b3(sh: Person, t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the shareholder receives the dividend from the trust";
}
@source(IRC_S857_B, quote = "A capital gain dividend shall be treated by the shareholders or holders of beneficial interests as a gain from the sale or exchange of a capital asset held for more than 1 year.")
rule Section857b3AShareholderLongTermGain(sh: Person, t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 857(b)(3)(A): a capital gain dividend is long-term capital gain to the shareholder";
    when shareholder_receives_reit_dividend_857b3(sh, t, y, dividend);
    when capital_gain_dividend_portion_857b3B(t, y, dividend, amount);
    then reit_shareholder_capital_gain_dividend_857b3A(sh, dividend, amount);
}
pub relation ncg_of_reit_857b3F(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net capital gain of the trust for the taxable year";
}
pub relation capital_gain_dividends_paid_for_dpd_857b3F(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction for dividends paid (section 561) determined with reference to capital gain dividends only";
}
pub relation undistributed_capital_gain_857b3F(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the net capital gain over the deduction for dividends paid determined with reference to capital gain dividends only";
}
@source(IRC_S857_B, quote = "the term \"undistributed capital gain\" means the excess of the net capital gain over the deduction for dividends paid (as defined in section 561) determined with reference to capital gain dividends only")
rule Section857b3FUndistributedCapitalGain(t: Person, y: TaxableYear, ncg: Money, dpd: Money) strict {
    label en official "section 857(b)(3)(F): net capital gain over the capital-gain-only dividends paid deduction (never below zero)";
    when ncg_of_reit_857b3F(t, y, ncg);
    when capital_gain_dividends_paid_for_dpd_857b3F(t, y, dpd);
    then undistributed_capital_gain_857b3F(t, y, max(0.00 USD, ncg - dpd));
}
pub relation reit_designates_undistributed_capital_gain_857b3C(t: Person, y: TaxableYear, designated: Money, mailed_on: Date) kind empirical {
    label en unofficial "the trust designates, in a written notice mailed to shareholders on this date, the amount of undistributed capital gain each shareholder includes";
}
pub relation undistributed_gain_designation_timely_857b3Ci(t: Person, y: TaxableYear) kind institutional {
    label en official "the designation notice was mailed before the expiration of 60 days after the close of the taxable year";
}
rule Section857b3CiTimelyBySixtyDays(t: Person, y: TaxableYear, designated: Money, mailed_on: Date, ends_on: Date) strict {
    label en official "section 857(b)(3)(C)(i): the notice is mailed within 60 days after the close of the taxable year";
    when reit_designates_undistributed_capital_gain_857b3C(t, y, designated, mailed_on);
    when us.irc.core::ends(y, ends_on);
    when mailed_on <= add_calendar_period(ends_on, 60 calendar_day);
    then undistributed_gain_designation_timely_857b3Ci(t, y);
}
pub relation undistributed_capital_gain_designated_857b3C(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of undistributed capital gain designated for shareholder inclusion";
}
@source(IRC_S857_B, quote = "such amount as the trust shall designate in respect of such shares in a written notice mailed to its shareholders at any time prior to the expiration of 60 days after the close of its taxable year")
rule Section857b3CiDesignationPower(t: Person, y: TaxableYear, designated: Money, mailed_on: Date) strict {
    label en official "section 857(b)(3)(C)(i): the trust designates undistributed capital gain for shareholder inclusion";
    when reit_designates_undistributed_capital_gain_857b3C(t, y, designated, mailed_on);
    then power UndistributedCapitalGainDesignation {
        holder t;
        over t;
        exercise reit_designates_undistributed_capital_gain_857b3C(t, y, designated, mailed_on);
        valid_when undistributed_gain_designation_timely_857b3Ci(t, y);
        effect create(undistributed_capital_gain_designated_857b3C(t, y, designated));
        window [@1960-01-01, infinity);
    };
}
pub relation shareholder_share_of_designated_undistributed_gain_857b3C(sh: Person, t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the amount subject to tax in paragraph (1) the shareholder would have received had all of it been distributed as capital gain dividends at the close of the year";
}
pub relation shareholder_long_term_gain_inclusion_857b3Ci(sh: Person, t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount the shareholder includes in long-term capital gains: the designated share, not more than the share the shareholder would have received";
}
@source(IRC_S857_B, quote = "but the amount so includible by any shareholder shall not exceed that part of the amount subjected to tax in paragraph (1) which he would have received if all of such amount had been distributed as capital gain dividends")
rule Section857b3CiShareholderInclusion(sh: Person, t: Person, y: TaxableYear, designated_share: Money, cap: Money) strict {
    label en official "section 857(b)(3)(C)(i): shareholder inclusion limited to the shareholder's share";
    when undistributed_capital_gain_designated_857b3C(t, y, _);
    when shareholder_designated_amount_857b3C(sh, t, y, designated_share);
    when shareholder_share_of_designated_undistributed_gain_857b3C(sh, t, y, cap);
    then shareholder_long_term_gain_inclusion_857b3Ci(sh, t, y, min(designated_share, cap));
}
pub relation shareholder_designated_amount_857b3C(sh: Person, t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the trust designated in respect of the shareholder's shares";
}
pub relation tax_on_undistributed_capital_gain_857b3(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by paragraph (1) on the designated undistributed capital gain, at the highest section 11 rate";
}
@source(IRC_S857_B, quote = "the tax imposed by paragraph (1) on undistributed capital gain")
rule Section857b3CTaxOnUndistributedGain(t: Person, y: TaxableYear, designated: Money, rate: Decimal) strict {
    label en official "section 857(b)(3)(C)(ii),(iv): tax on the designated undistributed capital gain at the section 11 rate (JUDGMENT CALL: the flat corporate rate)";
    when undistributed_capital_gain_designated_857b3C(t, y, designated);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then tax_on_undistributed_capital_gain_857b3(t, y, round(designated * rate, 2, "HALF_UP"));
}
pub relation shareholder_deemed_tax_paid_857b3Cii(sh: Person, t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder is deemed to have paid the tax on the included amount, with credit or refund";
}
@source(IRC_S857_B, quote = "every such shareholder shall be deemed to have paid, for his taxable year under clause (i), the tax imposed by paragraph (1) on undistributed capital gain")
rule Section857b3CiiDeemedTaxPaid(sh: Person, t: Person, y: TaxableYear, included: Money, rate: Decimal) strict {
    label en official "section 857(b)(3)(C)(ii): deemed payment of the tax on the included amount";
    when shareholder_long_term_gain_inclusion_857b3Ci(sh, t, y, included);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then shareholder_deemed_tax_paid_857b3Cii(sh, t, y, round(included * rate, 2, "HALF_UP"));
}
pub relation shareholder_basis_increase_857b3Ciii(sh: Person, t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted basis of the shares is increased by the included gain less the tax deemed paid";
}
@source(IRC_S857_B, quote = "by the difference between the amount of such includible gains and the tax deemed paid by such shareholder in respect of such shares under clause (ii)")
rule Section857b3CiiiBasisIncrease(sh: Person, t: Person, y: TaxableYear, included: Money, tax: Money) strict {
    label en official "section 857(b)(3)(C)(iii): basis increases by included gain minus deemed tax";
    when shareholder_long_term_gain_inclusion_857b3Ci(sh, t, y, included);
    when shareholder_deemed_tax_paid_857b3Cii(sh, t, y, tax);
    then shareholder_basis_increase_857b3Ciii(sh, t, y, included - tax);
}
pub relation tax_on_undistributed_gain_paid_857b3Civ(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trust has paid the tax on undistributed capital gain";
}
@source(IRC_S857_B, quote = "In the event of such designation, the tax imposed by paragraph (1) on undistributed capital gain shall be paid by the real estate investment trust within 30 days after the close of its taxable year.")
rule Section857b3CivDutyToPayTaxOnUndistributedGain(t: Person, y: TaxableYear, designated: Money, ends_on: Date) strict {
    label en official "section 857(b)(3)(C)(iv): after a designation the trust must pay the tax within 30 days after the close of its taxable year";
    when undistributed_capital_gain_designated_857b3C(t, y, designated);
    when us.irc.core::ends(y, ends_on);
    then duty PayTaxOnUndistributedCapitalGain {
        bearer t;
        goal achievement {
            condition tax_on_undistributed_gain_paid_857b3Civ(t, y);
            window [ends_on, add_calendar_period(ends_on, 30 calendar_day)];
        }
    };
}
pub relation net_capital_gain_of_year_857b3D(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the net capital gain for the taxable year";
}
pub relation net_capital_gain_excluded_for_172_857b3D(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for section 172, the net capital gain (to the extent it does not exceed the capital gain dividends) is excluded in determining the net operating loss";
}
@source(IRC_S857_B, quote = "the amount of the net capital gain for such taxable year (to the extent such gain does not exceed the amount of such capital gain dividends) shall be excluded in determining")
rule Section857b3DNetCapitalGainExcludedFromNol(t: Person, y: TaxableYear, ncg: Money, cgd: Money) strict {
    label en official "section 857(b)(3)(D): the excluded amount is the lesser of the net capital gain and the capital gain dividends paid";
    when net_capital_gain_of_year_857b3D(t, y, ncg);
    when capital_gain_dividends_paid_for_dpd_857b3F(t, y, cgd);
    then net_capital_gain_excluded_for_172_857b3D(t, y, min(ncg, cgd));
}

// ---- Section 857(b)(4): foreclosure property income ----

pub relation gain_on_dealer_foreclosure_property_857b4B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gain (including foreign currency gain) from the sale or other disposition of foreclosure property described in section 1221(a)(1)";
}
pub relation gross_income_from_foreclosure_property_not_c3_857b4B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income derived from foreclosure property, only to the extent it is not described in section 856(c)(3) (other than subparagraph (F))";
}
pub relation deductions_directly_connected_with_foreclosure_income_857b4Bii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deductions allowed by the chapter directly connected with the production of the income in clause (i)";
}
pub relation net_income_from_foreclosure_property_derived_857b4B(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net income from foreclosure property: the excess of the clause (i) income over the directly connected deductions";
}
@source(IRC_S857_B, quote = "the term \"net income from foreclosure property\" means the excess of")
rule Section857b4BNetIncome(t: Person, y: TaxableYear, gain: Money, income: Money, deductions: Money) strict {
    label en official "section 857(b)(4)(B): the excess (never below zero) of qualifying foreclosure income over the deductions";
    when gain_on_dealer_foreclosure_property_857b4B(t, y, gain);
    when gross_income_from_foreclosure_property_not_c3_857b4B(t, y, income);
    when deductions_directly_connected_with_foreclosure_income_857b4Bii(t, y, deductions);
    then net_income_from_foreclosure_property_derived_857b4B(t, y, max(0.00 USD, (gain + income) - deductions));
}
pub relation foreclosure_property_income_tax_857b4A(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax on the net income from foreclosure property: the net income multiplied by the highest rate specified in section 11(b)";
}
@source(IRC_S857_B, quote = "Such tax shall be computed by multiplying the net income from foreclosure property by the highest rate of tax specified in section 11(b).")
rule Section857b4ATaxOnForeclosureIncome(t: Person, y: TaxableYear, net: Money, rate: Decimal) strict {
    label en official "section 857(b)(4)(A): tax equals net income from foreclosure property times the highest section 11(b) rate";
    when net_income_from_foreclosure_property_derived_857b4B(t, y, net);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then foreclosure_property_income_tax_857b4A(t, y, round(net * rate, 2, "HALF_UP"));
}

// ---- Section 857(b)(5): tax after relief from the income tests ----

pub relation gross_income_for_857b5_greater_of_tests(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income of the trust for the taxable year, excluding gross income from prohibited transactions";
}
pub relation gross_income_from_856c2_sources_857b5A(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of that gross income derived from sources referred to in section 856(c)(2)";
}
pub relation gross_income_from_856c3_sources_857b5B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of that gross income derived from sources referred to in section 856(c)(3)";
}
pub relation reit_taxable_income_for_857b5_fraction(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the REIT taxable income determined without regard to the deductions of paragraphs (2)(B) and (2)(E), without any net operating loss deduction and excluding net capital gain";
}
pub relation gross_income_for_857b5_fraction_denominator(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income excluding prohibited-transaction income, qualifying foreclosure income and gain, long-term capital gain, and short-term capital gain to the extent of short-term capital loss";
}
pub relation section_857b5_tax_imposed(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed when section 856(c)(6) applies: the greater of the 95-percent and 75-percent shortfalls, multiplied by the ratio of modified REIT taxable income to modified gross income";
}
@source(IRC_S857_B, quote = "If section 856(c)(6) applies to a real estate investment trust for any taxable year, there is hereby imposed on such trust a tax in an amount equal to the greater of")
rule Section857b5TaxAfterIncomeTestRelief(t: Person, y: TaxableYear, gross: Money, q2: Money, q3: Money, numerator: Money, denominator: Money) strict {
    label en official "section 857(b)(5): the greater shortfall (95 percent of gross income over (c)(2) income, or 75 percent over (c)(3) income) times the taxable-income fraction";
    when reit_income_tests_deemed_satisfied_856c6(t, y);
    when gross_income_for_857b5_greater_of_tests(t, y, gross);
    when gross_income_from_856c2_sources_857b5A(t, y, q2);
    when gross_income_from_856c3_sources_857b5B(t, y, q3);
    when reit_taxable_income_for_857b5_fraction(t, y, numerator);
    when gross_income_for_857b5_fraction_denominator(t, y, denominator);
    when denominator > 0.00 USD;
    // Both shortfalls are computed in cents from 95/100 and 75/100 of a
    // Money amount; the greater is taken before the one proportion.
    then section_857b5_tax_imposed(t, y, div_round(max(max(0.00 USD, div_round(gross * 95.0, 100.0, 2, "HALF_UP") - q2), max(0.00 USD, div_round(gross * 75.0, 100.0, 2, "HALF_UP") - q3)) * (numerator / 1.00 USD), denominator / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 857(b)(7): taxable REIT subsidiary transactions ----

pub relation redetermined_rents_857b7B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "rents from real property to the extent the amount would (but for (F)) be reduced under section 482 to clearly reflect income as a result of services furnished by a taxable REIT subsidiary to a tenant";
}
pub relation redetermined_rents_excepted_857b7B(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "clause (ii) (amounts within the 1 percent threshold of section 856(d)(7)), (iii) (comparable services to third parties), (iv) (comparable rents and separately stated charge) or (v) (charge at least 150 percent of direct cost) applies, or the Secretary waives the tax under clause (vi)";
}
pub relation redetermined_deductions_857b7C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deductions of a taxable REIT subsidiary (other than redetermined rents) to the extent they would (but for (F)) be decreased under section 482 as between the subsidiary and the trust";
}
pub relation excess_interest_857b7D(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deductions for interest payments by a taxable REIT subsidiary to the trust in excess of a commercially reasonable rate";
}
pub relation redetermined_trs_service_income_857b7E(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income of a taxable REIT subsidiary from services to or on behalf of the trust (less allocable deductions), to the extent it would (but for (F)) be increased under section 482, other than income from services to a tenant";
}
pub relation redetermined_rents_taxable_857b7(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the redetermined rents subject to the 100 percent tax (none when an exception applies)";
}
@source(IRC_S857_B, quote = "There is hereby imposed for each taxable year of the real estate investment trust a tax equal to 100 percent of redetermined rents, redetermined deductions, excess interest, and redetermined TRS service income.")
rule Section857b7RedeterminedRentsTaxable(t: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 857(b)(7)(A)-(B): redetermined rents are taxed unless an exception in (B)(ii)-(vi) applies";
    when redetermined_rents_857b7B(t, y, amount);
    when not_known(redetermined_rents_excepted_857b7B(t, y));
    when not_known(rents_exception_present_857b7B(t, y));
    then redetermined_rents_taxable_857b7(t, y, amount);
}
pub relation section_857b7_tax_imposed(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the 100 percent tax on redetermined rents, redetermined deductions, excess interest and redetermined TRS service income";
}
rule Section857b7HundredPercentTax(t: Person, y: TaxableYear, rents: Money, deductions: Money, interest: Money, service: Money) strict {
    label en official "section 857(b)(7)(A): the tax equals 100 percent of the four components";
    when redetermined_rents_taxable_857b7(t, y, rents);
    when redetermined_deductions_857b7C(t, y, deductions);
    when excess_interest_857b7D(t, y, interest);
    when redetermined_trs_service_income_857b7E(t, y, service);
    then section_857b7_tax_imposed(t, y, ((rents + deductions) + interest) + service);
}

// ---- Section 857(b)(8): loss on shares held six months or less ----

pub relation reit_share_held_six_months_or_less_857b8(sh: Person, share: us.irc.core::Asset) kind institutional {
    label en unofficial "the taxpayer has held the share or interest for 6 months or less (section 246(c)(3)-(4) rules, ignoring days more than 6 months after ex-dividend)";
}
pub relation reit_capital_gain_dividend_on_share_857b8(sh: Person, share: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount treated under paragraph (3)(B) or (D) as long-term capital gain with respect to the share";
}
pub relation reit_loss_on_share_857b8(sh: Person, share: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the loss on the sale or exchange of the share or interest";
}
pub relation reit_loss_treated_as_long_term_857b8A(sh: Person, share: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the loss on a share held 6 months or less is a long-term capital loss to the extent of the capital gain dividend amount";
}
@source(IRC_S857_B, quote = "then any loss on the sale or exchange of such share or interest shall, to the extent of the amount described in clause (i), be treated as a long-term capital loss")
rule Section857b8ALossIsLongTerm(sh: Person, share: us.irc.core::Asset, loss: Money, gain: Money) strict {
    label en official "section 857(b)(8)(A): the short-held loss is long-term to the extent of the capital gain dividend";
    when reit_share_held_six_months_or_less_857b8(sh, share);
    when reit_capital_gain_dividend_on_share_857b8(sh, share, gain);
    when reit_loss_on_share_857b8(sh, share, loss);
    then reit_loss_treated_as_long_term_857b8A(sh, share, min(loss, gain));
}

// ---- Section 857(b)(9): year-end dividends ----

pub relation reit_dividend_declared_in_october_november_december_857b9(t: Person, dividend: us.irc.core::Payment, calendar_year: Integer) kind empirical {
    label en unofficial "the dividend is declared in October, November or December of the calendar year and payable to shareholders of record on a specified date in such a month";
}
pub relation reit_dividend_actually_paid_in_january_857b9(t: Person, dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is actually paid by the trust during January of the following calendar year";
}
pub relation reit_dividend_deemed_received_and_paid_december_31_857b9(t: Person, dividend: us.irc.core::Payment, calendar_year: Integer) kind institutional {
    label en official "the dividend is deemed received by each shareholder and paid by the trust on December 31 of the calendar year (year number as value, TECH-GAPS G2203)";
}
@source(IRC_S857_B, quote = "to have been received by each shareholder on December 31 of such calendar year")
rule Section857b9YearEndDeeming(t: Person, dividend: us.irc.core::Payment, calendar_year: Integer) strict {
    label en official "section 857(b)(9): an Oct-Dec dividend paid in the following January is deemed received and paid on December 31";
    when reit_dividend_declared_in_october_november_december_857b9(t, dividend, calendar_year);
    when reit_dividend_actually_paid_in_january_857b9(t, dividend);
    then reit_dividend_deemed_received_and_paid_december_31_857b9(t, dividend, calendar_year);
}

// ---- Section 857(c): treatment of dividends received from a REIT ----

pub relation dividend_from_reit_meeting_part_ii_857c1(dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is received from a real estate investment trust that meets the requirements of part II";
}
@source(IRC_S857_C, quote = "a dividend received from a real estate investment trust which meets the requirements of this part shall not be considered a dividend")
pub relation reit_dividend_not_a_dividend_for_243_857c1(dividend: us.irc.core::Payment) kind institutional {
    label en official "for the dividends received deduction the dividend is not considered a dividend";
}
rule Section857c1NoDividendsReceivedDeduction(dividend: us.irc.core::Payment) strict {
    label en official "section 857(c)(1): a qualifying REIT's dividend does not carry the section 243 deduction";
    when dividend_from_reit_meeting_part_ii_857c1(dividend);
    then reit_dividend_not_a_dividend_for_243_857c1(dividend);
}
pub relation reit_qualified_dividend_income_of_year_857c2B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified dividend income of the trust for the taxable year (section 1(h)(11)(B))";
}
pub relation reit_prior_year_taxable_income_and_337d_income_857c2Bii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the REIT taxable income for the preceding year and the income subject to tax by the regulations under section 337(d) for that year";
}
pub relation reit_prior_year_taxes_857c2Bii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the taxes imposed for the preceding year under section 857(b)(1) and by the regulations under section 337(d)";
}
pub relation reit_accumulated_non_part_ii_earnings_distributed_857c2Biii(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "earnings and profits distributed for the year that were accumulated in a taxable year to which part II did not apply";
}
pub relation reit_qdi_designation_ceiling_857c2B(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the ceiling of qualified dividend income the trust may designate: its qualified dividend income, plus the prior-year after-tax income excess, plus accumulated non-part-II earnings distributed";
}
@source(IRC_S857_C, quote = "The aggregate amount which may be designated as qualified dividend income under subparagraph (A) shall not exceed the sum of")
rule Section857c2BQdiCeiling(t: Person, y: TaxableYear, qdi: Money, prior_income: Money, prior_tax: Money, accumulated: Money) strict {
    label en official "section 857(c)(2)(B): the three-part ceiling, the middle part never below zero";
    when reit_qualified_dividend_income_of_year_857c2B(t, y, qdi);
    when reit_prior_year_taxable_income_and_337d_income_857c2Bii(t, y, prior_income);
    when reit_prior_year_taxes_857c2Bii(t, y, prior_tax);
    when reit_accumulated_non_part_ii_earnings_distributed_857c2Biii(t, y, accumulated);
    then reit_qdi_designation_ceiling_857c2B(t, y, (qdi + max(0.00 USD, prior_income - prior_tax)) + accumulated);
}
pub relation reit_aggregate_qdi_designated_857c2B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount designated as qualified dividend income";
}
pub relation reit_qdi_designation_within_ceiling_857c2B(t: Person, y: TaxableYear) kind institutional {
    label en official "the aggregate qualified dividend income designation is within the ceiling";
}
rule Section857c2BWithinCeiling(t: Person, y: TaxableYear, designated: Money, ceiling: Money) strict {
    label en official "section 857(c)(2)(B): the designation does not exceed the ceiling";
    when reit_aggregate_qdi_designated_857c2B(t, y, designated);
    when reit_qdi_designation_ceiling_857c2B(t, y, ceiling);
    when designated <= ceiling;
    then reit_qdi_designation_within_ceiling_857c2B(t, y);
}
pub relation reit_qdi_notice_mailed_on_857c2C(t: Person, y: TaxableYear, mailed_on: Date) kind empirical {
    label en unofficial "the written notice designating qualified dividend income was mailed to shareholders on this date";
}
pub relation reit_qdi_designated_for_dividend_857c2C(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount designated as qualified dividend income in respect of the dividend";
}
pub relation reit_dividend_qualified_dividend_income_857c2A(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the dividend taken into account as qualified dividend income: only the part designated, within the ceiling and by a notice mailed not later than 60 days after the close of the year";
}
@source(IRC_S857_C, quote = "shall not exceed the amount so designated by the trust in a written notice to its shareholders mailed not later than 60 days after the close of its taxable year")
rule Section857c2QdiOnlyDesignatedPortion(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, designated: Money, dividend_amount: Money, mailed_on: Date, ends_on: Date) strict {
    label en official "section 857(c)(2)(A),(C): only the designated portion of a non-capital-gain dividend counts as qualified dividend income, when the notice is timely and the ceiling is respected";
    when reit_qdi_designated_for_dividend_857c2C(t, y, dividend, designated);
    when shareholder_dividend_amount_857c2(t, dividend, dividend_amount);
    when reit_qdi_notice_mailed_on_857c2C(t, y, mailed_on);
    when us.irc.core::ends(y, ends_on);
    when mailed_on <= add_calendar_period(ends_on, 60 calendar_day);
    when reit_qdi_designation_within_ceiling_857c2B(t, y);
    then reit_dividend_qualified_dividend_income_857c2A(t, y, dividend, min(designated, dividend_amount));
}
pub relation shareholder_dividend_amount_857c2(t: Person, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount of the dividend (other than a capital gain dividend) received from the trust";
}

// ---- Section 857(d): earnings and profits ----

pub relation reit_ep_for_year_before_nondeductible_857d1(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits of the trust for the year after every reduction";
}
pub relation reit_amount_not_allowable_now_or_before_857d1(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount not allowable in computing taxable income for the year and not allowable for any prior year";
}
pub relation reit_ep_for_year_857d1(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the earnings and profits of the year (not accumulated), not reduced by amounts never allowable as deductions";
}
@source(IRC_S857_D, quote = "The earnings and profits of a real estate investment trust for any taxable year (but not its accumulated earnings) shall not be reduced by any amount which")
rule Section857d1EarningsAndProfitsForYear(t: Person, y: TaxableYear, ep: Money, not_allowable: Money) strict {
    label en official "section 857(d)(1): year earnings and profits are not reduced by amounts never allowable";
    when reit_ep_for_year_before_nondeductible_857d1(t, y, ep);
    when reit_amount_not_allowable_now_or_before_857d1(t, y, not_allowable);
    then reit_ep_for_year_857d1(t, y, ep + not_allowable);
}
pub relation reit_distribution_during_calendar_year_857d2(t: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en unofficial "the amount distributed during the calendar year that is treated as a dividend by the trust (other than a redemption to which section 302(a) applies)";
}
pub relation reit_required_distribution_4981_857d2(t: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en unofficial "the required distribution for the calendar year determined under section 4981";
}
pub relation reit_distribution_treated_as_dividend_for_lack_of_earnings_857d2(t: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "the trust is treated as having sufficient earnings and profits for the distribution to be a dividend, but not beyond the required distribution";
}
@source(IRC_S857_D, quote = "A real estate investment trust shall be treated as having sufficient earnings and profits to treat as a dividend any distribution")
rule Section857d2SufficientEarnings(t: Person, calendar_year: Integer, distributed: Money, required: Money) strict {
    label en official "section 857(d)(2): sufficient earnings and profits up to the section 4981 required distribution";
    when reit_distribution_during_calendar_year_857d2(t, calendar_year, distributed);
    when reit_required_distribution_4981_857d2(t, calendar_year, required);
    then reit_distribution_treated_as_dividend_for_lack_of_earnings_857d2(t, calendar_year, min(distributed, required));
}
@source(IRC_S857_D, quote = "the term \"real estate investment trust\" includes a domestic corporation, trust, or association which is a real estate investment trust determined without regard to the requirements of subsection (a)")
pub relation reit_for_857d_purposes(t: Person, y: TaxableYear) kind institutional {
    label en official "for section 857(d) a real estate investment trust includes an entity that is one apart from the section 857(a) requirements";
}
rule Section857d4ReitForEarningsAndProfits(t: Person, y: TaxableYear) strict {
    label en official "section 857(d)(4): the term includes a domestic entity that is a REIT without regard to subsection (a)";
    when real_estate_investment_trust(t, y);
    then reit_for_857d_purposes(t, y);
}

// ---- Section 857(e): excess noncash income ----

pub relation section_467_income_included_857e2A(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts includible in gross income under section 467";
}
pub relation income_without_section_467_857e2A(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts that would have been includible in gross income without regard to section 467";
}
pub relation income_on_real_estate_asset_disposition_not_1031_857e2B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "income on the disposition of a real estate asset where a determination (section 860(e)) is that it is not eligible for section 1031 nonrecognition";
}
pub relation instrument_income_includible_857e2C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts includible in gross income with respect to instruments to which section 860E(a) or 1272 applies";
}
pub relation money_and_property_received_under_instruments_857e2C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the money and fair market value of other property received during the year under those instruments";
}
pub relation cancellation_of_indebtedness_income_857e2D(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts includible in income by reason of cancellation of indebtedness";
}
pub relation reit_taxable_income_for_857e1B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the REIT taxable income for the year determined without regard to the deduction for dividends paid and excluding any net capital gain";
}
pub relation section_857e2_amount(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the sum of the four components of paragraph (2)";
}
@source(IRC_S857_E, quote = "The amount determined under this paragraph for the taxable year is the sum of")
rule Section857e2Amount(t: Person, y: TaxableYear, with467: Money, without467: Money, disposition: Money, instrument: Money, received: Money, cod: Money) strict {
    label en official "section 857(e)(2): section 467 excess, non-1031 disposition income (reasonable cause), instrument excess, and cancellation of indebtedness income";
    when section_467_income_included_857e2A(t, y, with467);
    when income_without_section_467_857e2A(t, y, without467);
    when income_on_real_estate_asset_disposition_not_1031_857e2B(t, y, disposition);
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    when instrument_income_includible_857e2C(t, y, instrument);
    when money_and_property_received_under_instruments_857e2C(t, y, received);
    when cancellation_of_indebtedness_income_857e2D(t, y, cod);
    then section_857e2_amount(t, y, (((max(0.00 USD, with467 - without467) + disposition) + max(0.00 USD, instrument - received)) + cod));
}
pub relation excess_noncash_income_derived_857e1(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess noncash income: the paragraph (2) amount over 5 percent of the REIT taxable income (never below zero)";
}
@source(IRC_S857_E, quote = "the term \"excess noncash income\" means the excess (if any) of")
rule Section857e1ExcessNoncashIncome(t: Person, y: TaxableYear, amount2: Money, income: Money) strict {
    label en official "section 857(e)(1): the excess of the (2) amount over 5 percent of REIT taxable income";
    when section_857e2_amount(t, y, amount2);
    when reit_taxable_income_for_857e1B(t, y, income);
    then excess_noncash_income_derived_857e1(t, y, max(0.00 USD, amount2 - div_round(income * 5.0, 100.0, 2, "HALF_UP")));
}

// ---- Section 857(f): ownership regulations, penalties ----

pub relation reit_complies_with_ownership_regulations_857f1(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trust has complied, for the taxable year, with the regulations for ascertaining the actual ownership of its outstanding shares or certificates of beneficial interest";
}
@source(IRC_S857_F, quote = "Each real estate investment trust shall each taxable year comply with regulations prescribed by the Secretary for the purposes of ascertaining the actual ownership of the outstanding shares, or certificates of beneficial interest, of such trust.")
rule Section857f1OwnershipRegulationsDuty(t: Person, y: TaxableYear, begins_on: Date, ends_on: Date) strict {
    label en official "section 857(f)(1): each REIT must, each taxable year, comply with the ownership-ascertainment regulations";
    when real_estate_investment_trust(t, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    then duty ComplyWithOwnershipRegulations {
        bearer t;
        goal achievement {
            condition reit_complies_with_ownership_regulations_857f1(t, y);
            window [begins_on, ends_on];
        }
    };
}
pub relation reit_failure_to_comply_intentional_disregard_857f2B(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the failure under paragraph (1) is due to intentional disregard of the requirement";
}
pub relation reit_failed_ownership_regulations_857f2(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trust fails to comply with the requirements of paragraph (1) for the taxable year";
}
pub relation reit_failed_to_take_secretary_required_actions_857f2C(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary required the trust to take actions to ascertain actual ownership and the trust failed to take them";
}
pub relation reit_ownership_failure_penalty_base_857f2(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the penalty under subparagraph (A) or (B): $25,000, or $50,000 for intentional disregard";
}
rule Section857f2APenaltyTwentyFiveThousand(t: Person, y: TaxableYear) strict {
    label en official "section 857(f)(2)(A): a penalty of $25,000 for failing to comply, unless reasonable cause is shown or (B) applies";
    when reit_failed_ownership_regulations_857f2(t, y);
    when not_known(reit_failure_to_comply_intentional_disregard_857f2B(t, y));
    when not_known(reit_ownership_failure_due_to_reasonable_cause_857f2D(t, y));
    then reit_ownership_failure_penalty_base_857f2(t, y, 25000.00 USD);
}
rule Section857f2BPenaltyFiftyThousand(t: Person, y: TaxableYear) strict {
    label en official "section 857(f)(2)(B): $50,000 when the failure is due to intentional disregard, unless reasonable cause is shown";
    when reit_failed_ownership_regulations_857f2(t, y);
    when reit_failure_to_comply_intentional_disregard_857f2B(t, y);
    when not_known(reit_ownership_failure_due_to_reasonable_cause_857f2D(t, y));
    then reit_ownership_failure_penalty_base_857f2(t, y, 50000.00 USD);
}
pub relation reit_ownership_failure_due_to_reasonable_cause_857f2D(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "it is shown that the failure is due to reasonable cause and not to willful neglect";
}
pub relation reit_ownership_failure_total_penalty_857f2(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the penalty including the additional equal penalty when the trust fails to take the actions the Secretary requires (subparagraph (C))";
}
rule Section857f2CAdditionalPenalty(t: Person, y: TaxableYear, base: Money) strict {
    label en official "section 857(f)(2)(C): an additional penalty equal to the (A) or (B) penalty for failing the Secretary's required actions";
    when reit_ownership_failure_penalty_base_857f2(t, y, base);
    when reit_failed_to_take_secretary_required_actions_857f2C(t, y);
    then reit_ownership_failure_total_penalty_857f2(t, y, base + base);
}
rule Section857f2TotalWithoutAdditional(t: Person, y: TaxableYear, base: Money) strict {
    label en official "section 857(f)(2): without the (C) failure the total is the base penalty";
    when reit_ownership_failure_penalty_base_857f2(t, y, base);
    when not_known(reit_failed_to_take_secretary_required_actions_857f2C(t, y));
    then reit_ownership_failure_total_penalty_857f2(t, y, base);
}

// ---- Section 858: dividends declared after the close of the year ----

pub relation reit_dividend_declared_on_858a1(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, declared_on: Date) kind empirical {
    label en unofficial "the trust declares the dividend on this date";
}
pub relation reit_return_due_date_with_extension_858a1(t: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the time prescribed by law for filing the trust's return for the year, including any extension";
}
pub relation reit_dividend_distributed_on_858a2(t: Person, dividend: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date the amount was distributed to shareholders or holders of beneficial interests";
}
pub relation reit_first_regular_dividend_after_declaration_858a2(t: Person, dividend: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date of the first regular dividend payment made after the declaration";
}
pub relation reit_elects_in_return_with_dollar_amounts_858a(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the trust elects in its return, specifying dollar amounts, to treat the declared and distributed amount as paid during the taxable year";
}
pub relation reit_post_year_dividend_qualifies_858a(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the dividend was declared before the return due date and distributed within the 12-month period and not later than the first regular dividend payment after the declaration";
}
@source(IRC_S858_A, quote = "declares a dividend before the time prescribed by law for the filing of its return for a taxable year (including the period of any extension of time granted for filing such return)")
rule Section858aQualifies(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, declared_on: Date, due: Date, ends_on: Date, distributed_on: Date, first_on: Date) strict {
    label en official "section 858(a)(1)-(2): timely declaration and distribution";
    when reit_dividend_declared_on_858a1(t, y, dividend, declared_on);
    when reit_return_due_date_with_extension_858a1(t, y, due);
    when us.irc.core::ends(y, ends_on);
    when reit_dividend_distributed_on_858a2(t, dividend, distributed_on);
    when reit_first_regular_dividend_after_declaration_858a2(t, dividend, first_on);
    when declared_on < due;
    when distributed_on > ends_on;
    when distributed_on < add_calendar_period(add_calendar_period(ends_on, 1 calendar_day), 12 calendar_month);
    when distributed_on <= first_on;
    then reit_post_year_dividend_qualifies_858a(t, y, dividend);
}
pub relation reit_dividend_considered_paid_in_year_858a(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the declared and distributed amount is considered as paid only during the taxable year, to the extent of the trust's election";
}
@source(IRC_S858_A, quote = "the amount so declared and distributed shall, to the extent the trust elects in such return (and specifies in dollar amounts) in accordance with regulations prescribed by the Secretary, be considered as having been paid only during such taxable year")
rule Section858aElectionPower(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 858(a): the trust may elect, in its return and in dollar amounts, to treat a post-year dividend as paid in the year";
    when reit_elects_in_return_with_dollar_amounts_858a(t, y, dividend, amount);
    then power ReitPostYearDividendElection {
        holder t;
        over t;
        exercise reit_elects_in_return_with_dollar_amounts_858a(t, y, dividend, amount);
        valid_when reit_post_year_dividend_qualifies_858a(t, y, dividend);
        effect create(reit_dividend_considered_paid_in_year_858a(t, y, dividend, amount));
        window [@1960-01-01, infinity);
    };
}
pub relation reit_dividend_is_year_end_deemed_857b9(t: Person, dividend: us.irc.core::Payment) kind institutional {
    label en official "helper binding the open year argument: the dividend is a section 857(b)(9) year-end deemed dividend";
}
rule Section857b9HelperYearEndDeemed(t: Person, dividend: us.irc.core::Payment, calendar_year: Integer) strict {
    label en official "helper: some calendar year makes the dividend a section 857(b)(9) deemed dividend";
    when reit_dividend_deemed_received_and_paid_december_31_857b9(t, dividend, calendar_year);
    then reit_dividend_is_year_end_deemed_857b9(t, dividend);
}
pub relation reit_shareholder_receipt_year_858b(t: Person, dividend: us.irc.core::Payment, distributed_on: Date) kind institutional {
    label en official "amounts to which subsection (a) applies are received by the shareholder in the taxable year in which the distribution is made";
}
@source(IRC_S858_B, quote = "amounts to which subsection (a) applies shall be treated as received by the shareholder or holder of a beneficial interest in the taxable year in which the distribution is made")
rule Section858bShareholderReceivesOnDistribution(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, distributed_on: Date) defeasible {
    label en official "section 858(b): the shareholder receives the amount when distributed, except for section 857(b)(9) dividends";
    when reit_dividend_considered_paid_in_year_858a(t, y, dividend, amount);
    when reit_dividend_distributed_on_858a2(t, dividend, distributed_on);
    when not_known(reit_dividend_is_year_end_deemed_857b9(t, dividend));
    then reit_shareholder_receipt_year_858b(t, dividend, distributed_on);
}
pub relation reit_notice_for_858_amounts_mailed_on_858c(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, mailed_on: Date) kind empirical {
    label en unofficial "the notice to shareholders required under this part with respect to the section 858 amounts was made on this date";
}
pub relation reit_858_notice_timely_858c(t: Person, y: TaxableYear, dividend: us.irc.core::Payment) kind institutional {
    label en official "the notice was made not later than 30 days after the close of the taxable year in which the distribution is made";
}
pub relation reit_distribution_year_end_858c(t: Person, dividend: us.irc.core::Payment, year_end: Date) kind empirical {
    label en unofficial "the close of the taxable year in which the distribution is made";
}
@source(IRC_S858_C, quote = "shall be made not later than 30 days after the close of the taxable year in which the distribution is made")
rule Section858cNoticeWithinThirtyDays(t: Person, y: TaxableYear, dividend: us.irc.core::Payment, mailed_on: Date, year_end: Date) strict {
    label en official "section 858(c): the required notice is made within 30 days after the close of the distribution year";
    when reit_notice_for_858_amounts_mailed_on_858c(t, y, dividend, mailed_on);
    when reit_distribution_year_end_858c(t, dividend, year_end);
    when mailed_on <= add_calendar_period(year_end, 30 calendar_day);
    then reit_858_notice_timely_858c(t, y, dividend);
}

// ---- Section 859: the accounting period ----

pub relation reit_changes_accounting_period_to_non_calendar_859a1(t: Person) kind empirical {
    label en unofficial "the trust changes to an accounting period other than the calendar year";
}
@source(IRC_S859_A, quote = "a real estate investment trust shall not change to any accounting period other than the calendar year")
rule Section859a1NoChangeFromCalendarYear(t: Person, y: TaxableYear) strict {
    label en official "section 859(a)(1): a REIT may not change to a non-calendar accounting period";
    when real_estate_investment_trust(t, y);
    then prohibition NoNonCalendarAccountingPeriodChange {
        bearer t;
        action reit_changes_accounting_period_to_non_calendar_859a1(t);
        window [@1976-10-05, infinity);
    };
}
pub relation reit_accounting_period_is_calendar_year_859a2(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity's accounting period for the year is the calendar year";
}
pub relation reit_considered_reit_for_year_beginning_on_or_before_1976_10_04_859a2(t: Person) kind empirical {
    label en unofficial "the entity was considered a REIT for a taxable year beginning on or before October 4, 1976";
}
pub relation reit_election_eligible_as_to_accounting_period_859a2(t: Person, y: TaxableYear) kind institutional {
    label en official "the entity may elect to be a REIT for the taxable year: its accounting period is the calendar year, or it was a REIT for a year beginning on or before October 4, 1976";
}
@source(IRC_S859_A, quote = "a corporation, trust, or association may not elect to be a real estate investment trust for any taxable year beginning after October 4, 1976, unless its accounting period is the calendar year")
rule Section859a2CalendarYearRequired(t: Person, y: TaxableYear) strict {
    label en official "section 859(a)(2): the election requires a calendar-year accounting period";
    when reit_accounting_period_is_calendar_year_859a2(t, y);
    then reit_election_eligible_as_to_accounting_period_859a2(t, y);
}
@source(IRC_S859_A, quote = "Paragraph (2) shall not apply to a corporation, trust, or association which was considered to be a real estate investment trust for any taxable year beginning on or before October 4, 1976.")
rule Section859a2PreExistingReitException(t: Person, y: TaxableYear) strict {
    label en official "section 859(a): the calendar-year requirement does not apply to a pre-October-5-1976 REIT";
    when reit_considered_reit_for_year_beginning_on_or_before_1976_10_04_859a2(t);
    when reit_accounting_period_is_calendar_year_859a2(t, y);
    then reit_election_eligible_as_to_accounting_period_859a2(t, y);
}
pub relation entity_without_active_trade_or_business_859b(t: Person) kind empirical {
    label en unofficial "the entity has not engaged in any active trade or business";
}
pub relation accounting_period_change_in_connection_with_856c_election_859b(t: Person) kind empirical {
    label en unofficial "the change of accounting period to a calendar year is in connection with an election under section 856(c)";
}
pub relation calendar_year_change_without_secretary_approval_859b(t: Person) kind institutional {
    label en official "notwithstanding section 442, the entity may change its accounting period to a calendar year without the Secretary's approval";
}
@source(IRC_S859_B, quote = "an entity which has not engaged in any active trade or business may change its accounting period to a calendar year without the approval of the Secretary if such change is in connection with an election under section 856(c)")
rule Section859bChangeWithoutApproval(t: Person) strict {
    label en official "section 859(b): an inactive entity may change to a calendar year in connection with a REIT election without approval";
    when entity_without_active_trade_or_business_859b(t);
    when accounting_period_change_in_connection_with_856c_election_859b(t);
    then calendar_year_change_without_secretary_approval_859b(t);
}
