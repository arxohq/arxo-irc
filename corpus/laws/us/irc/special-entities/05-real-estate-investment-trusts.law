// Sections 856(a),(c)(1)-(4) (real estate investment trust defined:
// organizational requirements, the election, the 95%/75% gross income
// tests, the asset tests) and 857(a)-(b)(2),(b)(6) (REIT taxation: the 90%
// distribution requirement, REIT taxable income, the 100%
// prohibited-transaction tax with its safe harbor). Stage 1 (IRC-09 stage
// 1, A12), priority sections.
//
// METHOD: section 856(b) (timing: conditions (1)-(4) throughout the year,
// condition (5) for 335 days), (c)(5)-(10) (value/real-estate-asset/hedging/
// timber/termination-date definitions), (d)-(n) are NOT modeled at this
// stage — the 856(c)(2)-(4) tests below take their income/asset figures as
// CASE-ASSERTED AGGREGATES, per the method note for this package ("aggregates
// over case-asserted income/asset items"), not as derived from underlying
// rents/loans/holdings. Section 857(c)-(h) and (b)(3)-(5),(7)-(9) are NOT
// modeled (outside "(a)-(b)(2),(b)(6)"). Section 857(b)(6)(D)-(J) (timber
// variant, special rules, termination) are NOT modeled; the safe harbor
// below covers only (C)(i)-(iii)(I)-(II) — the 2-year holding period, the
// 30 percent expenditure ratio, and the "not more than 7 sales" / "10
// percent of aggregate adjusted bases" branches of (iii); the (III)-(V)
// fair-market-value and 20-percent/3-year-average alternative branches are
// not modeled (TECH-GAPS.md G102).

// ---- Section 856(a) ----

use self::{
    Corporation,
    IRC_S856_A,
    IRC_S856_C,
    IRC_S857_A,
    IRC_S857_B,
    Person,
    TaxableYear,
    issuer_limits_met_year_856c4Biv,
    trs_ceiling_met_year_level_856c4Bii,
};

@source(IRC_S856_A, quote = "which is managed by one or more trustees or directors")
pub relation managed_by_trustees_or_directors(t: Person) kind empirical {
    label en unofficial "managed by one or more trustees or directors, per section 856(a)(1)";
}
@source(IRC_S856_A, quote = "the beneficial ownership of which is evidenced by transferable shares, or by transferable certificates of beneficial interest")
pub relation beneficial_ownership_evidenced_by_transferable_shares(t: Person) kind empirical {
    label en unofficial "beneficial ownership evidenced by transferable shares or transferable certificates of beneficial interest, per section 856(a)(2)";
}
@source(IRC_S856_A, quote = "which (but for the provisions of this part) would be taxable as a domestic corporation")
pub relation would_be_taxable_as_domestic_corporation(t: Person) kind empirical {
    label en unofficial "would be taxable as a domestic corporation but for subchapter M, part II, per section 856(a)(3)";
}
@source(IRC_S856_A, quote = "which is neither (A) a financial institution referred to in section 582(c)(2), nor (B) an insurance company to which subchapter L applies")
pub relation not_financial_institution_582c2(t: Person) kind empirical {
    label en unofficial "not a financial institution referred to in section 582(c)(2), per section 856(a)(4)(A)";
}
pub relation not_insurance_company_subchapter_l(t: Person) kind empirical {
    label en unofficial "not an insurance company to which subchapter L applies, per section 856(a)(4)(B)";
}
@source(IRC_S856_A, quote = "the beneficial ownership of which is held by 100 or more persons")
pub relation number_of_beneficial_owners(t: Person, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of persons holding beneficial ownership of the trust, per section 856(a)(5)/(b) (the 335-day timing rule of (b) is not separately modeled)";
}
@source(IRC_S856_A, quote = "subject to the provisions of subsection (k), which is not closely held (as determined under subsection (h))")
pub relation not_closely_held_856h(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "not closely held as determined under section 856(h) (the section 856(h)/542(a)(2) five-or-fewer test itself is not modeled at this stage)";
}
@source(IRC_S856_A, quote = "which meets the requirements of subsection (c)")
pub relation meets_856c_requirements(t: Person, y: TaxableYear) kind institutional {
    label en official "meets the requirements of section 856(c), per section 856(a)(7) (defined by the section 856(c)(1)-(4) rules below)";
}
@source(IRC_S856_A, quote = "the beneficial ownership of which is held by 100 or more persons")
pub relation hundred_shareholder_test_met(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(a)(5) 100-or-more-persons test is met for the taxable year";
}
rule Section856a5HundredShareholderTest(t: Person, y: TaxableYear, count: Integer) strict {
    label en official "section 856(a)(5): beneficial ownership is held by 100 or more persons";
    when number_of_beneficial_owners(t, y, count);
    when count >= 100;
    then hundred_shareholder_test_met(t, y);
}

@source(IRC_S856_A)
pub relation real_estate_investment_trust(t: Person, y: TaxableYear) kind institutional {
    label en official "a real estate investment trust for the taxable year, per section 856(a)";
}
rule Section856aRealEstateInvestmentTrustDefined(t: Person, y: TaxableYear) strict {
    label en official "section 856(a)(1)-(7): the seven organizational and operating conditions together confer REIT status";
    when managed_by_trustees_or_directors(t);
    when beneficial_ownership_evidenced_by_transferable_shares(t);
    when would_be_taxable_as_domestic_corporation(t);
    when not_financial_institution_582c2(t);
    when not_insurance_company_subchapter_l(t);
    when hundred_shareholder_test_met(t, y);
    when not_closely_held_856h(t, y);
    when meets_856c_requirements(t, y);
    then real_estate_investment_trust(t, y);
}

// ---- Section 856(c)(1)-(4) ----

@source(IRC_S856_C, quote = "it files with its return for the taxable year an election to be a real estate investment trust or has made such election for a previous taxable year, and such election has not been terminated or revoked under subsection (g)")
pub relation elects_real_estate_investment_trust_status(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "an election to be a REIT, filed for the taxable year or a previous one and not terminated/revoked under section 856(g) (not modeled), per section 856(c)(1)";
}
@source(IRC_S856_C, quote = "at least 95 percent (90 percent for taxable years beginning before January 1, 1980) of its gross income (excluding gross income from prohibited transactions) is derived from—")
pub relation qualifying_gross_income_856c2(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income (excluding prohibited-transaction income) derived from the section 856(c)(2)(A)-(I) qualifying sources (dividends, interest, rents from real property, etc.), for the taxable year";
}
pub relation total_gross_income_856_excluding_prohibited(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "total gross income (excluding gross income from prohibited transactions), per section 856(c)(2)-(3)";
}
@source(IRC_S856_C, quote = "at least 95 percent (90 percent for taxable years beginning before January 1, 1980) of its gross income (excluding gross income from prohibited transactions) is derived from—")
pub relation ninety_five_percent_income_test_met_856c2(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(c)(2) 95 percent qualifying-gross-income test is met for the taxable year (the 90 percent pre-1980 figure is not modeled: no pre-1980 taxable year is in scope)";
}
rule Section856c2NinetyFivePercentIncomeTest(t: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(2): qualifying gross income is at least 95 percent of total gross income (excluding prohibited transactions)";
    when qualifying_gross_income_856c2(t, y, qualifying);
    when total_gross_income_856_excluding_prohibited(t, y, total);
    when qualifying * 100 >= total * 95;
    then ninety_five_percent_income_test_met_856c2(t, y);
}

@source(IRC_S856_C)
pub relation qualifying_gross_income_856c3(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income (excluding prohibited-transaction income) derived from the section 856(c)(3)(A)-(I) qualifying real-property-related sources, for the taxable year";
}
@source(IRC_S856_C, quote = "at least 75 percent of its gross income (excluding gross income from prohibited transactions) is derived from—")
pub relation seventy_five_percent_income_test_met_856c3(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(c)(3) 75 percent qualifying-real-property-income test is met for the taxable year";
}
rule Section856c3SeventyFivePercentIncomeTest(t: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(3): qualifying real-property-related gross income is at least 75 percent of total gross income (excluding prohibited transactions)";
    when qualifying_gross_income_856c3(t, y, qualifying);
    when total_gross_income_856_excluding_prohibited(t, y, total);
    when qualifying * 100 >= total * 75;
    then seventy_five_percent_income_test_met_856c3(t, y);
}

@source(IRC_S856_C)
pub relation qualifying_real_estate_and_cash_and_govt_securities_value(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of real estate assets, cash and cash items, and Government securities at the close of a quarter, per section 856(c)(4)(A)";
}
pub relation total_assets_value_856(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of total assets of the trust at the close of a quarter, per section 856(c)(4)";
}
@source(IRC_S856_C, quote = "at least 75 percent of the value of its total assets is represented by real estate assets, cash and cash items (including receivables), and Government securities")
pub relation seventy_five_percent_asset_test_met_856c4a(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(c)(4)(A) 75 percent qualifying-asset test is met at the close of a quarter";
}
rule Section856c4ASeventyFivePercentAssetTest(t: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(c)(4)(A): qualifying real estate/cash/Government securities are at least 75 percent of total asset value";
    when qualifying_real_estate_and_cash_and_govt_securities_value(t, y, qualifying);
    when total_assets_value_856(t, y, total);
    when qualifying * 100 >= total * 75;
    then seventy_five_percent_asset_test_met_856c4a(t, y);
}

@source(IRC_S856_C, quote = "not more than 25 percent of the value of its total assets is represented by securities (other than those includible under subparagraph (A))")
pub relation non_qualifying_securities_value_856c4bi(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of securities other than those includible under section 856(c)(4)(A), at the close of a quarter, per section 856(c)(4)(B)(i)";
}
@source(IRC_S856_C, quote = "not more than 20 percent of the value of its total assets is represented by securities of one or more taxable REIT subsidiaries")
pub relation taxable_reit_subsidiary_securities_value(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of securities of one or more taxable REIT subsidiaries, at the close of a quarter, per section 856(c)(4)(B)(ii)";
}
@source(IRC_S856_C, quote = "not more than 25 percent of the value of its total assets is represented by nonqualified publicly offered REIT debt instruments")
pub relation nonqualified_publicly_offered_reit_debt_instruments_value(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of nonqualified publicly offered REIT debt instruments, at the close of a quarter, per section 856(c)(4)(B)(iii)";
}
@source(IRC_S856_C)
pub relation twenty_five_twenty_twenty_five_percent_asset_limits_met_856c4b(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(c)(4)(B)(i)-(iii) 25%/20%/25% asset ceilings are met at the close of a quarter (the (iv) per-issuer 5%/10%/10% limits are not separately modeled)";
}
rule Section856c4BAssetCeilings(t: Person, y: TaxableYear, other_securities: Money, nonqualified_debt: Money, total: Money) strict {
    label en official "section 856(c)(4)(B)(i)-(iii): non-qualifying securities <=25%, taxable REIT subsidiary securities within their ceiling (20%, 25% for years beginning after 2025, module 18), nonqualified publicly offered REIT debt instruments <=25% of total asset value";
    when total_assets_value_856(t, y, total);
    when non_qualifying_securities_value_856c4bi(t, y, other_securities);
    when trs_ceiling_met_year_level_856c4Bii(t, y);
    when nonqualified_publicly_offered_reit_debt_instruments_value(t, y, nonqualified_debt);
    when other_securities * 100 <= total * 25;
    when nonqualified_debt * 100 <= total * 25;
    then twenty_five_twenty_twenty_five_percent_asset_limits_met_856c4b(t, y);
}

@source(IRC_S856_C)
rule Section856cRequirementsMet(t: Person, y: TaxableYear) strict {
    label en official "section 856(c)(1)-(4): election, the 95% and 75% income tests, and the 75%/25%/20%/25% asset tests together satisfy section 856(c)";
    when elects_real_estate_investment_trust_status(t, y);
    when ninety_five_percent_income_test_met_856c2(t, y);
    when seventy_five_percent_income_test_met_856c3(t, y);
    when seventy_five_percent_asset_test_met_856c4a(t, y);
    when twenty_five_twenty_twenty_five_percent_asset_limits_met_856c4b(t, y);
    // Stage 2c: the per-issuer 5/10/10 percent limits of (c)(4)(B)(iv)
    // (module 18) are part of the requirement.
    when issuer_limits_met_year_856c4Biv(t, y);
    then meets_856c_requirements(t, y);
}

// ---- Section 857(a) ----

@source(IRC_S857_A, quote = "the deduction for dividends paid during the taxable year (as defined in section 561, but determined without regard to capital gains dividends) equals or exceeds—")
pub relation dividends_paid_deduction_reit(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction for dividends paid during the taxable year, as defined in section 561, determined without regard to capital gain dividends, per section 857(a)(1)";
}
pub relation reit_taxable_income_without_dpd_excluding_capital_gain(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "REIT taxable income for the taxable year, determined without regard to the dividends paid deduction and excluding net capital gain, per section 857(a)(1)(A)(i)";
}
pub relation net_income_from_foreclosure_property(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "net income from foreclosure property, per section 857(a)(1)(A)(ii)/(b)(4)(B)";
}
pub relation tax_on_foreclosure_property_income_857b4a(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax imposed on net income from foreclosure property by section 857(b)(4)(A), for the taxable year";
}
pub relation excess_noncash_income_857e(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "excess noncash income as determined under section 857(e) (not modeled at this stage), per section 857(a)(1)(B)";
}
@source(IRC_S857_A)
pub relation section_857a1_distribution_requirement_met(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 857(a)(1) 90 percent distribution requirement is met for the taxable year";
}
rule Section857a1DistributionRequirement(t: Person, y: TaxableYear, dpd: Money, ti: Money, fp_income: Money, fp_tax: Money, noncash: Money) strict {
    label en official "section 857(a)(1): dividends paid deduction >= 90% of REIT taxable income (excl. capital gain, w/o DPD) + 90% of (foreclosure property net income - its tax) - excess noncash income";
    when dividends_paid_deduction_reit(t, y, dpd);
    when reit_taxable_income_without_dpd_excluding_capital_gain(t, y, ti);
    when net_income_from_foreclosure_property(t, y, fp_income);
    when tax_on_foreclosure_property_income_857b4a(t, y, fp_tax);
    when excess_noncash_income_857e(t, y, noncash);
    when dpd >= ((round(ti * 0.90, 2, "HALF_UP") + round((fp_income - fp_tax) * 0.90, 2, "HALF_UP")) - noncash);
    then section_857a1_distribution_requirement_met(t, y);
}

@source(IRC_S857_A, quote = "the provisions of this part apply to the real estate investment trust for all taxable years beginning after February 28, 1986")
pub relation part_ii_applied_since_1986_02_28(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the provisions of subchapter M, part II applied to the trust for all taxable years beginning after February 28, 1986, per section 857(a)(2)(A)";
}
@source(IRC_S857_A, quote = "as of the close of the taxable year, the real estate investment trust has no earnings and profits accumulated in any non-REIT year")
pub relation no_accumulated_earnings_from_non_reit_years(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "as of the close of the taxable year, no earnings and profits accumulated in a non-REIT year, per section 857(a)(2)(B)";
}
@source(IRC_S857_A)
pub relation section_857a2_condition_met(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 857(a)(2) alternative history condition is met for the taxable year";
}
rule Section857a2ByLongStanding(t: Person, y: TaxableYear) strict {
    label en official "section 857(a)(2)(A): part II has applied since February 28, 1986";
    when part_ii_applied_since_1986_02_28(t, y);
    then section_857a2_condition_met(t, y);
}
rule Section857a2ByNoTaintedEarnings(t: Person, y: TaxableYear) strict {
    label en official "section 857(a)(2)(B): no accumulated earnings from a non-REIT year";
    when no_accumulated_earnings_from_non_reit_years(t, y);
    then section_857a2_condition_met(t, y);
}
@source(IRC_S857_A, quote = "The provisions of this part (other than subsection (d) of this section and subsection (g) of section 856) shall not apply to a real estate investment trust for a taxable year unless—")
pub relation subchapter_m_part_ii_applies(t: Person, y: TaxableYear) kind institutional {
    label en official "subchapter M, part II applies to the real estate investment trust for the taxable year (section 857(a))";
}
rule Section857aPartIiApplies(t: Person, y: TaxableYear) strict {
    label en official "section 857(a): part II applies when the trust is a REIT and both the distribution requirement and the (a)(2) condition are met";
    when real_estate_investment_trust(t, y);
    when section_857a1_distribution_requirement_met(t, y);
    when section_857a2_condition_met(t, y);
    then subchapter_m_part_ii_applies(t, y);
}

// ---- Section 857(b)(1)-(2) ----
// (b)(1)'s tax amount at section 11 rates: STAGE 2 (WIRE-2, 25.09.2026)
// wires the rate step to `us.irc.corporations`'s `pub corporate_tax_rate(c,
// y, rate)` export (module 02's header of this package explains the keying
// mechanism). LIMITATION carried forward, not newly discovered: that export
// is typed `c: Corporation`; a REIT organized as a trust or association
// (both legal under section 856(a)) cannot supply a `Corporation`-typed
// entity, so `reit_tax` below only fires for REITs that ARE corporations.
// A REIT-as-trust/association is left `external_norm_unresolved` on the
// same rate gap — closing it needs `us.irc.corporations` to widen
// `corporate_tax_rate`'s holder type to `Person` (or add a sibling export),
// which is that package's decision, not a fork by this one. The base (REIT
// taxable income) is modeled below without this restriction.

pub relation reit_taxable_income_before_857b2_adjustments(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income of the real estate investment trust computed under the normal rules, before the section 857(b)(2) adjustments";
}
pub relation part_viii_deduction_previously_allowed_reit(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of part VIII (other than section 248) deductions taken into account in the base taxable income figure, to be added back per section 857(b)(2)(A)";
}
@source(IRC_S857_B, quote = "The deduction for dividends paid (as defined in section 561) shall be allowed, but shall be computed without regard to that portion of such deduction which is attributable to the amount excluded under subparagraph (D).")
pub relation dividends_paid_deduction_857b2b(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction for dividends paid, computed without regard to the portion attributable to the section 857(b)(2)(D) exclusion, per section 857(b)(2)(B)";
}
@source(IRC_S857_B, quote = "There shall be deducted an amount equal to the tax imposed by paragraphs (5) and (7) of this subsection, section 856(c)(7)(C), and section 856(g)(5) for the taxable year.")
pub relation other_857_and_856_taxes_deducted(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of tax imposed by section 857(b)(5)/(7), section 856(c)(7)(C), and section 856(g)(5) for the taxable year, deducted per section 857(b)(2)(E)";
}
@source(IRC_S857_B, quote = "There shall be excluded an amount equal to any net income derived from prohibited transactions.")
pub relation net_income_from_prohibited_transactions_reit(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "net income derived from prohibited transactions, per section 857(b)(2)(F)/(b)(6)(B)";
}
@source(IRC_S857_B)
pub relation real_estate_investment_trust_taxable_income(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "real estate investment trust taxable income for the taxable year, per section 857(b)(2)(A),(B),(D),(E),(F) (the (C) method-of-computation adjustment is not separately modeled)";
}
rule Section857b2RealEstateInvestmentTrustTaxableIncome(t: Person, y: TaxableYear, base: Money, part_viii: Money, dpd: Money, foreclosure: Money, other_taxes: Money, prohibited: Money) strict {
    label en official "section 857(b)(2): REIT taxable income = base + part VIII add-back - DPD(b2b) - foreclosure property net income - other (5)/(7)/856 taxes - prohibited-transaction net income";
    when reit_taxable_income_before_857b2_adjustments(t, y, base);
    when part_viii_deduction_previously_allowed_reit(t, y, part_viii);
    when dividends_paid_deduction_857b2b(t, y, dpd);
    when net_income_from_foreclosure_property(t, y, foreclosure);
    when other_857_and_856_taxes_deducted(t, y, other_taxes);
    when net_income_from_prohibited_transactions_reit(t, y, prohibited);
    then real_estate_investment_trust_taxable_income(t, y, ((((base + part_viii) - dpd) - foreclosure) - other_taxes) - prohibited);
}

// (b)(1)'s rate step, wired to `us.irc.corporations`'s `pub
// corporate_tax_rate(c, y, rate)` export (STAGE 2, WIRE-2). Typed `t:
// Corporation` per the module header note above: only reaches REITs that
// are corporations, not trusts/associations (see the header LIMITATION).
@source(IRC_S857_B, quote = "There is hereby imposed for each taxable year on the real estate investment trust taxable income of every real estate investment trust a tax computed as provided in section 11, as though the real estate investment trust taxable income were the taxable income referred to in section 11.")
pub relation reit_tax(t: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 857(b)(1): real estate investment trust taxable income taxed at the section 11 rate, as though it were section 11 taxable income (for a REIT that is a corporation)";
}
rule Section857b1ReitTax(t: Corporation, y: TaxableYear, income: Money, rate: Decimal) strict {
    label en official "section 857(b)(1): the tax is the section 11 rate applied to REIT taxable income";
    when real_estate_investment_trust_taxable_income(t, y, income);
    when us.irc.corporations::corporate_tax_rate(t, y, rate);
    then reit_tax(t, y, round(income * rate, 2, "HALF_UP"));
}

// ---- Section 857(b)(6): prohibited transactions ----

pub relation gain_from_prohibited_transactions(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gain (including foreign currency gain) from prohibited transactions, per section 857(b)(6)(B)(i)";
}
pub relation deductions_connected_with_prohibited_transactions(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deductions directly connected with prohibited transactions, per section 857(b)(6)(B)(i)";
}
@source(IRC_S857_B, quote = "the term \"net income derived from prohibited transactions\" means the excess of the gain (including any foreign currency gain, as defined in section 988(b)(1)) from prohibited transactions over the deductions (including any foreign currency loss, as defined in section 988(b)(2)) allowed by this chapter which are directly connected with prohibited transactions")
rule Section857b6BNetIncomeFromProhibitedTransactions(t: Person, y: TaxableYear, gain: Money, deductions: Money) strict {
    label en official "section 857(b)(6)(B)(i): net income from prohibited transactions = gain minus connected deductions";
    when gain_from_prohibited_transactions(t, y, gain);
    when deductions_connected_with_prohibited_transactions(t, y, deductions);
    when gain > deductions;
    then net_income_from_prohibited_transactions_reit(t, y, gain - deductions);
}
@source(IRC_S857_B, quote = "There is hereby imposed for each taxable year of every real estate investment trust a tax equal to 100 percent of the net income derived from prohibited transactions.")
pub relation prohibited_transaction_tax(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 857(b)(6)(A) tax equal to 100 percent of net income from prohibited transactions, for the taxable year, unless every sale is within the section 857(b)(6)(C) safe harbor";
}
rule Section857b6ATaxOnProhibitedTransactionIncome(t: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 857(b)(6)(A): a 100 percent tax on net income from prohibited transactions, unless the sale falls within the (C) safe harbor";
    when net_income_from_prohibited_transactions_reit(t, y, amount);
    when not_known(sale_within_prohibited_transaction_safe_harbor(t, y));
    then prohibited_transaction_tax(t, y, amount);
}

@source(IRC_S857_B, quote = "the trust has held the property for not less than 2 years")
pub relation property_held_at_least_2_years(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the trust has held the property for not less than 2 years, per section 857(b)(6)(C)(i)";
}
@source(IRC_S857_B, quote = "aggregate expenditures made by the trust, or any partner of the trust, during the 2-year period preceding the date of sale which are includible in the basis of the property do not exceed 30 percent of the net selling price of the property")
pub relation two_year_capitalized_expenditures(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "aggregate capitalized expenditures during the 2-year period preceding sale, per section 857(b)(6)(C)(ii)";
}
pub relation net_selling_price(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the net selling price of the property, per section 857(b)(6)(C)(ii)";
}
@source(IRC_S857_B, quote = "during the taxable year the trust does not make more than 7 sales of property (other than sales of foreclosure property or sales to which section 1033 applies)")
pub relation number_of_qualifying_sales_in_year(t: Person, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of sales of property during the taxable year (other than foreclosure property sales or section 1033 sales), per section 857(b)(6)(C)(iii)(I)";
}
@source(IRC_S857_B)
pub relation aggregate_adjusted_bases_of_qualifying_property_sold(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "aggregate adjusted bases of qualifying property sold during the taxable year, per section 857(b)(6)(C)(iii)(II)";
}
pub relation aggregate_adjusted_bases_of_all_trust_assets_at_beginning_of_year(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "aggregate adjusted bases of all trust assets at the beginning of the taxable year, per section 857(b)(6)(C)(iii)(II)";
}
@source(IRC_S857_B)
pub relation sale_within_prohibited_transaction_safe_harbor(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 857(b)(6)(C) safe harbor is met for the taxable year's sale(s), on the (i),(ii),(iii)(I)-(II) branches modeled here (stage 3: all branches, clauses (iv) and (v) and the timber safe harbor (D) are derived in module 27)";
}
// Stage 3 (26.09.2026): the two stage-1 strict rules that concluded this
// relation from the (i)-(iii)(I) and (i)-(iii)(II) branches alone were
// removed: they ignored clauses (iv) and (v) of subparagraph (C). The safe
// harbors (C) and (D) are derived in module 27 (`safe_harbor_857b6C`,
// `safe_harbor_857b6D`) from the aggregate facts declared above or from
// itemised sales, expenditures and dates; module 27 concludes this
// year-level relation.
