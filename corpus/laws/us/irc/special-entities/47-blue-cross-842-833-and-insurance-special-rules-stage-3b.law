// Sections 832(e)(5), 833, 834(d)(2), 835(f), 842 stage 3b (IRC-09 stage 3b,
// TECH_GAP reduction), 26.09.2026. Status implemented_unverified; nothing
// here was executed.
//
// METHOD.
//   * 833: the organization is taxed as a stock company; its premiums earned
//     take 100 percent of the unearned premiums with no transitional
//     addback (the general rule of module 03 is displaced for it); the
//     adjusted surplus of the first year, the roll-forward feed, the
//     adjusted net operating loss, the net exempt income after the
//     832(b)(5)(B) decrease, the health-related items, and the successors
//     and the (c)(4) organizations that (c)(2) applies to.
//   * 842: the total insurance liabilities of (b)(2)(B), the duration of the
//     worldwide yield election ((b)(4)(C)) and the net investment income
//     ((b)(5)).
//   * 832(e)(5) last paragraphs, 834(d)(2), 835(f).
// Sums over derived items follow G4903.

// ---- Section 833(a): stock company treatment and premiums earned ----

use self::{
    IRC_S832_E,
    IRC_S833_A,
    IRC_S833_B,
    IRC_S833_C,
    IRC_S834_D,
    IRC_S835_F,
    IRC_S842_B,
    Person,
    TaxableYear,
    adjusted_surplus_beginning_of_year_833b1B,
    adjusted_surplus_rolled_forward_833b3A,
    claims_and_cost_plus_liabilities_incurred_833b1A,
    dividends_received_deductions_243_245_833b3E,
    elects_worldwide_yield_842b4,
    exempt_for_last_year_before_1987_833c2B,
    existing_blue_cross_or_blue_shield_org_833c2,
    existing_blue_cross_org_in_existence_on_1986_08_16_833c2A,
    gross_premiums_written,
    no_material_change_since_1986_08_16_833c2C,
    organization_described_in_833c4B,
    premiums_paid_for_reinsurance,
    return_premiums,
    section_833_applies_to_organization,
    tax_exempt_interest_less_disallowed_833b3E,
    unearned_premiums_end_of_prior_year,
    unearned_premiums_end_of_year,
};

pub relation organization_taxable_as_stock_insurance_company_833a1(o: Person, y: TaxableYear) kind institutional {
    label en official "the organization is taxable under the part in the same manner as if it were a stock insurance company";
}
@source(IRC_S833_A, quote = "Such organization shall be taxable under this part in the same manner as if it were a stock insurance")
rule Section833a1StockCompanyTreatment(o: Person, y: TaxableYear) defeasible {
    label en official "section 833(a)(1): an organization to which section 833 applies is taxed as a stock insurance company (the section 831(a) computation itself is module 03's)";
    when section_833_applies_to_organization(o, y);
    then organization_taxable_as_stock_insurance_company_833a1(o, y);
}
pub relation premiums_earned_833a3(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "premiums earned of an organization to which section 833 applies: 100 percent of the unearned premiums, and no paragraph (4)(C) addback";
}
@source(IRC_S833_A, quote = "Subparagraph (B) of paragraph (4) of section 832(b) shall be applied by substituting")
rule Section833a3PremiumsEarnedFullUnearned(o: Person, y: TaxableYear, written: Money, returned: Money, reinsurance: Money, unearned_prior: Money, unearned_end: Money) defeasible {
    label en official "section 833(a)(3): section 832(b)(4)(B) with 100 percent for 80 percent and without subparagraph (C)";
    when section_833_applies_to_organization(o, y);
    when gross_premiums_written(o, y, written);
    when return_premiums(o, y, returned);
    when premiums_paid_for_reinsurance(o, y, reinsurance);
    when unearned_premiums_end_of_prior_year(o, y, unearned_prior);
    when unearned_premiums_end_of_year(o, y, unearned_end);
    then premiums_earned_833a3(o, y, (((written - returned) - reinsurance) + unearned_prior) - unearned_end);
}

// ---- Section 833(b)(3): the adjusted surplus, the adjusted net operating loss, net exempt income ----

pub relation total_assets_per_annual_statement_833b3B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total assets shown on the annual statement at the beginning of the year";
}
pub relation total_liabilities_per_annual_statement_833b3B(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total liabilities shown on the annual statement at the beginning of the year";
}
pub relation first_taxable_year_beginning_after_1986_833b3B(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is the organization's first taxable year beginning after December 31, 1986";
}
pub relation first_taxable_year_meeting_833c3_833c3C(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is the first taxable year for which the organization meets the requirements of paragraph (3)";
}
pub relation surplus_at_beginning_of_year_833b3B(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the surplus: the excess of the total assets over total liabilities as shown on the annual statement";
}
@source(IRC_S833_B, quote = "The adjusted surplus as of the beginning of the organization's 1st taxable year beginning after December")
rule Section833b3BSurplus(o: Person, y: TaxableYear, assets: Money, liabilities: Money) strict {
    label en official "section 833(b)(3)(B): surplus is total assets less total liabilities";
    when total_assets_per_annual_statement_833b3B(o, y, assets);
    when total_liabilities_per_annual_statement_833b3B(o, y, liabilities);
    then surplus_at_beginning_of_year_833b3B(o, y, assets - liabilities);
}
rule Section833b3BFirstYearAdjustedSurplus(o: Person, y: TaxableYear, surplus: Money) strict {
    label en official "section 833(b)(3)(B): the adjusted surplus at the beginning of the first year beginning after 1986 is the surplus";
    when first_taxable_year_beginning_after_1986_833b3B(o, y);
    when surplus_at_beginning_of_year_833b3B(o, y, surplus);
    then adjusted_surplus_beginning_of_year_833b1B(o, y, surplus);
}
@source(IRC_S833_C, quote = "For purposes of subsection (b), the adjusted surplus of any organization meeting the requirements of")
rule Section833c3CFirstYearAdjustedSurplus(o: Person, y: TaxableYear, surplus: Money) strict {
    label en official "section 833(c)(3)(C): the adjusted surplus at the beginning of the first year the organization meets paragraph (3) is its surplus";
    when first_taxable_year_meeting_833c3_833c3C(o, y);
    when surplus_at_beginning_of_year_833b3B(o, y, surplus);
    then adjusted_surplus_beginning_of_year_833b1B(o, y, surplus);
}
rule Section833b3ARolledSurplusIsBeginningSurplus(o: Person, y: TaxableYear, surplus: Money) strict {
    label en official "section 833(b)(3)(A): the rolled-forward surplus is the adjusted surplus at the beginning of the year";
    when adjusted_surplus_rolled_forward_833b3A(o, y, surplus);
    then adjusted_surplus_beginning_of_year_833b1B(o, y, surplus);
}
pub relation net_operating_loss_of_year_833b3D(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net operating loss for the taxable year";
}
pub relation dividends_received_deductions_before_832b5B_decrease_833b3E(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount allowed as a deduction under sections 243 and 245 before the reduction of the last sentence of subparagraph (E)";
}
pub relation decrease_in_deductions_832b5B_attributable_to_243_245_833b3E(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the decrease in deductions allowable for the year by reason of section 832(b)(5)(B), to the extent attributable to deductions under sections 243 and 245";
}
@source(IRC_S833_B, quote = "The amount determined under clause (ii) shall be reduced by the amount of any decrease in deductions")
rule Section833b3EDividendDeductionsAfterDecrease(o: Person, y: TaxableYear, before: Money, decrease: Money) strict {
    label en official "section 833(b)(3)(E) last sentence: the amount of clause (ii) is reduced by the section 832(b)(5)(B) decrease attributable to sections 243 and 245 (never below zero)";
    when dividends_received_deductions_before_832b5B_decrease_833b3E(o, y, before);
    when decrease_in_deductions_832b5B_attributable_to_243_245_833b3E(o, y, decrease);
    then dividends_received_deductions_243_245_833b3E(o, y, max(0.00 USD, before - decrease));
}
pub relation net_exempt_income_833b3E(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net exempt income: tax-exempt interest less the disallowed amounts, plus the section 243 and 245 deductions after the decrease";
}
rule Section833b3ENetExemptIncome(o: Person, y: TaxableYear, interest: Money, dividends: Money) strict {
    label en official "section 833(b)(3)(E): the two clauses added";
    when tax_exempt_interest_less_disallowed_833b3E(o, y, interest);
    when dividends_received_deductions_243_245_833b3E(o, y, dividends);
    then net_exempt_income_833b3E(o, y, interest + dividends);
}
pub relation adjusted_net_operating_loss_833b3D(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the net operating loss determined with the adjustments of subparagraph (C): reduced by the net exempt income (a loss turned into income is no loss)";
}
@source(IRC_S833_B, quote = "means the net operating loss for any taxable year determined with the adjustments set forth in")
rule Section833b3DAdjustedNetOperatingLoss(o: Person, y: TaxableYear, nol: Money, exempt: Money) strict {
    label en official "section 833(b)(3)(D): the net operating loss adjusted by increasing gross income by the net exempt income";
    when net_operating_loss_of_year_833b3D(o, y, nol);
    when net_exempt_income_833b3E(o, y, exempt);
    when nol > exempt;
    then adjusted_net_operating_loss_833b3D(o, y, nol - exempt);
}

// ---- Section 833(b)(4): health-related items ----

pub relation claims_item_833b1Ai(o: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "an item of claims incurred or of liabilities incurred under cost-plus contracts";
}
pub relation item_attributable_to_health_related_business_833b4(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the item is attributable to the health-related business of the taxpayer";
}
pub relation health_related_claims_item_833b4(o: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a claims item taken into account: only items attributable to the health-related business";
}
@source(IRC_S833_B, quote = "Any determination under this subsection shall be made by only taking into account items attributable to")
rule Section833b4OnlyHealthRelatedItems(o: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 833(b)(4): a determination under the subsection takes only health-related items into account";
    when claims_item_833b1Ai(o, y, item, amount);
    when item_attributable_to_health_related_business_833b4(item);
    then health_related_claims_item_833b4(o, y, item, amount);
}
pub relation health_related_claims_total_833b4(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the health-related claims items";
}
rule Section833b4HealthRelatedClaimsTotal(o: Person, y: TaxableYear) strict {
    label en official "section 833(b)(4): the sum of the health-related items (a sum over derived items: G4903)";
    when health_related_claims_item_833b4(o, y, _, _);
    then health_related_claims_total_833b4(o, y, sum all amount: Money for item: us.irc.core::Payment where health_related_claims_item_833b4(o, y, item, amount));
}
rule Section833b4TotalIsClaimsFigure(o: Person, y: TaxableYear, total: Money) strict {
    label en official "section 833(b)(1)(A)(i): the claims and cost-plus liabilities are the health-related total";
    when health_related_claims_total_833b4(o, y, total);
    then claims_and_cost_plus_liabilities_incurred_833b1A(o, y, total);
}

// ---- Section 833(c)(2), (4): existing organizations, successors, State-law organizations ----

pub relation successor_or_merged_organization_833c2(o: Person, pred: Person) kind empirical {
    label en unofficial "the organization is a successor to the predecessor, or results from the merger or consolidation of organizations each of which met the requirements";
}
pub relation secretary_permits_treatment_as_existing_833c2(o: Person) kind empirical {
    label en unofficial "to the extent permitted by the Secretary";
}
@source(IRC_S833_C, quote = "To the extent permitted by the Secretary, any successor to an organization meeting the requirements of")
rule Section833c2SuccessorTreatedAsExisting(o: Person, pred: Person, y: TaxableYear) defeasible {
    label en official "section 833(c)(2) last sentence: a permitted successor of an organization meeting (A)-(C) is treated as an existing organization";
    when successor_or_merged_organization_833c2(o, pred);
    when secretary_permits_treatment_as_existing_833c2(o);
    when existing_blue_cross_org_in_existence_on_1986_08_16_833c2A(pred);
    when exempt_for_last_year_before_1987_833c2B(pred);
    when no_material_change_since_1986_08_16_833c2C(pred, y);
    then existing_blue_cross_or_blue_shield_org_833c2(o, y);
}
@source(IRC_S833_C, quote = "Paragraph (2) shall be applied to an organization described in subparagraph (B) as if it were a Blue")
rule Section833c4AStateLawOrganizationAsBlueCross(o: Person, y: TaxableYear) defeasible {
    label en official "section 833(c)(4)(A): paragraph (2) is applied to a State-law not-for-profit organization as if it were a Blue Cross or Blue Shield organization (clauses (A)-(C) are its own facts)";
    when organization_described_in_833c4B(o);
    when existing_blue_cross_org_in_existence_on_1986_08_16_833c2A(o);
    when exempt_for_last_year_before_1987_833c2B(o);
    when no_material_change_since_1986_08_16_833c2C(o, y);
    then existing_blue_cross_or_blue_shield_org_833c2(o, y);
}

// ---- Section 842(b): total insurance liabilities, the election, net investment income ----

pub relation company_taxable_under_part_i_842b2B(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign company is taxable under part I (life insurance companies)";
}
pub relation company_taxable_under_part_ii_842b2B(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign company is taxable under part II (other insurance companies)";
}
pub relation total_reserves_816c_842b2Bi(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total reserves (section 816(c))";
}
pub relation items_807c_3_to_6_not_in_reserves_842b2Bi(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the items of paragraphs (3), (4), (5) and (6) of section 807(c), to the extent not included in total reserves";
}
pub relation unearned_premiums_842b2Bii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unearned premiums";
}
pub relation unpaid_losses_842b2Bii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unpaid losses";
}
pub relation total_insurance_liabilities_842b2B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total insurance liabilities of the foreign company";
}
@source(IRC_S842_B, quote = "means the sum of the total reserves (as defined in section 816(c)) plus (to the extent not included in")
rule Section842b2BiPartI(c: Person, y: TaxableYear, reserves: Money, items: Money) strict {
    label en official "section 842(b)(2)(B)(i): total reserves plus the section 807(c)(3)-(6) items not included";
    when company_taxable_under_part_i_842b2B(c, y);
    when total_reserves_816c_842b2Bi(c, y, reserves);
    when items_807c_3_to_6_not_in_reserves_842b2Bi(c, y, items);
    then total_insurance_liabilities_842b2B(c, y, reserves + items);
}
@source(IRC_S842_B, quote = "In the case of a company taxable under part II, the term")
rule Section842b2BiiPartII(c: Person, y: TaxableYear, unearned: Money, unpaid: Money) strict {
    label en official "section 842(b)(2)(B)(ii): unearned premiums plus unpaid losses";
    when company_taxable_under_part_ii_842b2B(c, y);
    when unearned_premiums_842b2Bii(c, y, unearned);
    when unpaid_losses_842b2Bii(c, y, unpaid);
    then total_insurance_liabilities_842b2B(c, y, unearned + unpaid);
}
pub relation worldwide_yield_election_made_in_842b4(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foreign company makes the election under paragraph (4) for this taxable year";
}
pub relation worldwide_yield_election_revoked_with_consent_842b4C(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the election is revoked with the consent of the Secretary, effective for this taxable year and later ones";
}
pub relation worldwide_yield_election_ended_for_year_842b4C(c: Person, y: TaxableYear) kind institutional {
    label en official "a revocation with consent took effect on or before the beginning of the taxable year";
}
rule Section842b4CEndedByRevocation(c: Person, y: TaxableYear, revoked_in: TaxableYear, revoked_begins: Date, begins_on: Date) strict {
    label en official "section 842(b)(4)(C): the election ends with a revocation with the Secretary's consent";
    when worldwide_yield_election_revoked_with_consent_842b4C(c, revoked_in);
    when us.irc.core::begins(revoked_in, revoked_begins);
    when us.irc.core::begins(y, begins_on);
    when begins_on >= revoked_begins;
    then worldwide_yield_election_ended_for_year_842b4C(c, y);
}
pub relation worldwide_yield_election_in_effect_842b4C(c: Person, y: TaxableYear) kind institutional {
    label en official "the worldwide yield election applies to the taxable year";
}
@source(IRC_S842_B, quote = "An election under this paragraph shall apply to the taxable year for which made and all subsequent")
rule Section842b4CElectionContinues(c: Person, y: TaxableYear, made_in: TaxableYear, made_begins: Date, begins_on: Date) strict {
    label en official "section 842(b)(4)(C): the election applies to the taxable year for which made and all subsequent years unless revoked with consent";
    when worldwide_yield_election_made_in_842b4(c, made_in);
    when us.irc.core::begins(made_in, made_begins);
    when us.irc.core::begins(y, begins_on);
    when begins_on >= made_begins;
    when not_known(worldwide_yield_election_ended_for_year_842b4C(c, y));
    then worldwide_yield_election_in_effect_842b4C(c, y);
}
rule Section842b4ElectionFactIsInEffect(c: Person, y: TaxableYear) strict {
    label en official "section 842(b)(4): an election asserted for the year is in effect for it";
    when elects_worldwide_yield_842b4(c, y);
    then worldwide_yield_election_in_effect_842b4C(c, y);
}
pub relation gross_investment_income_842b5A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross investment income within the meaning of section 834(b)";
}
pub relation expenses_allocable_to_investment_income_842b5B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the expenses allocable to the investment income";
}
pub relation net_investment_income_842b5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "net investment income: gross investment income reduced by the allocable expenses";
}
@source(IRC_S842_B, quote = "(A) gross investment income (within the meaning of section 834(b)), reduced by")
rule Section842b5NetInvestmentIncome(c: Person, y: TaxableYear, gross: Money, expenses: Money) strict {
    label en official "section 842(b)(5): gross investment income less expenses allocable to it";
    when gross_investment_income_842b5A(c, y, gross);
    when expenses_allocable_to_investment_income_842b5B(c, y, expenses);
    then net_investment_income_842b5(c, y, gross - expenses);
}
@source(IRC_S842_B, quote = "(B) expenses allocable to such income.")
pub relation net_investment_income_expenses_recorded_842b5B(c: Person, y: TaxableYear) kind institutional {
    label en official "the expenses allocable to the income are deducted (clause (B))";
}
rule Section842b5BExpensesRecorded(c: Person, y: TaxableYear, expenses: Money) strict {
    label en official "section 842(b)(5)(B): expenses allocable to the income reduce it";
    when expenses_allocable_to_investment_income_842b5B(c, y, expenses);
    then net_investment_income_expenses_recorded_842b5B(c, y);
}

// ---- Section 832(e)(5) last paragraphs: termination of the mortgage guaranty business ----

pub relation mortgage_guaranty_account_remaining_832e5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the entire amount remaining in the mortgage guaranty account";
}
pub relation liquidates_or_terminates_mortgage_guaranty_business_832e5(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company liquidates or otherwise terminates its mortgage guaranty insurance business";
}
pub relation transfers_mortgage_guaranty_business_in_381a_acquisition_832e5(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company transfers or distributes its mortgage guaranty insurance business in an acquisition of assets referred to in section 381(a)";
}
pub relation entire_account_subtracted_on_termination_832e5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the entire amount remaining in the account is subtracted and included in gross income";
}
@source(IRC_S832_E, quote = "If a company liquidates or otherwise terminates its mortgage guaranty insurance business and does not")
rule Section832e5TerminationSubtractsTheAccount(c: Person, y: TaxableYear, remaining: Money) strict {
    label en official "section 832(e)(5): on liquidation or termination, without a section 381(a) transfer, the entire amount remaining is subtracted";
    when liquidates_or_terminates_mortgage_guaranty_business_832e5(c, y);
    when mortgage_guaranty_account_remaining_832e5(c, y, remaining);
    when not_known(transfers_mortgage_guaranty_business_in_381a_acquisition_832e5(c, y));
    then entire_account_subtracted_on_termination_832e5(c, y, remaining);
}
pub relation not_subject_to_section_831_in_year_832e5(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company is not subject to the tax imposed by section 831 for the taxable year";
}
pub relation account_at_close_of_year_832e5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount in the account at the close of the taxable year";
}
pub relation preceding_taxable_year_832e5(y: TaxableYear, previous: TaxableYear) kind empirical {
    label en unofficial "previous is the taxable year immediately preceding y (no preceding-year term in us.irc.core, G2201)";
}
pub relation entire_account_subtracted_in_preceding_year_832e5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the entire amount in the account at the close of the preceding year is subtracted in that year (the company is not subject to section 831 for the following year)";
}
rule Section832e5NotSubjectToSection831SubtractsInPrecedingYear(c: Person, y: TaxableYear, previous: TaxableYear, amount: Money) strict {
    label en official "section 832(e)(5): a year in which the company is not subject to section 831 subtracts the whole account in the preceding year";
    when not_subject_to_section_831_in_year_832e5(c, y);
    when preceding_taxable_year_832e5(y, previous);
    when account_at_close_of_year_832e5(c, previous, amount);
    when not_known(transfers_mortgage_guaranty_business_in_381a_acquisition_832e5(c, y));
    then entire_account_subtracted_in_preceding_year_832e5(c, previous, amount);
}

// ---- Section 834(d)(2): the accrual of discount ----

pub relation bond_discount_834d2(bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the discount on the bond attributable to the taxable year";
}
pub relation bond_discount_is_original_issue_discount_834d2(bond: us.irc.core::Asset) kind empirical {
    label en unofficial "the discount is original issue discount (section 1273)";
}
pub relation bond_as_defined_in_171d_834d2(bond: us.irc.core::Asset) kind empirical {
    label en unofficial "the instrument is a bond as defined in section 171(d)";
}
pub relation accrual_of_discount_required_834d2(bond: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the accrual of discount required for the year";
}
@source(IRC_S834_D, quote = "No accrual of discount shall be required under this paragraph on any bond (as defined in section 171(d))")
rule Section834d2AccrualOnlyForOriginalIssueDiscountOfBonds(bond: us.irc.core::Asset, amount: Money) strict {
    label en official "section 834(d)(2): on a bond, discount is accrued only if it is original issue discount";
    when bond_discount_834d2(bond, amount);
    when bond_as_defined_in_171d_834d2(bond);
    when bond_discount_is_original_issue_discount_834d2(bond);
    then accrual_of_discount_required_834d2(bond, amount);
}
rule Section834d2AccrualOnOtherEvidencesOfIndebtedness(bond: us.irc.core::Asset, amount: Money) strict {
    label en official "section 834(d)(2): on an evidence of indebtedness that is not a bond of section 171(d) the appropriate accrual is required";
    when bond_discount_834d2(bond, amount);
    when not_known(bond_as_defined_in_171d_834d2(bond));
    then accrual_of_discount_required_834d2(bond, amount);
}

// ---- Section 835(f): the attorney-in-fact's later credit or refund ----

pub relation attorney_in_fact_credit_or_refund_allowed_835f(a: Person, r: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the attorney-in-fact is allowed a credit or refund of taxes paid with respect to which a credit to the reciprocal resulted under subsection (d)";
}
pub relation reciprocal_taxes_before_835f_adjustment(r: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxes of the reciprocal for the taxable year before the adjustment";
}
pub relation reciprocal_taxes_adjusted_835f(r: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxes of the reciprocal for the year adjusted for the attorney-in-fact's credit or refund (reduced by it, never below zero: a JUDGMENT CALL on \"properly adjusted under regulations\")";
}
@source(IRC_S835_F, quote = "If for any taxable year an attorney-in-fact is allowed a credit or refund for taxes paid with respect to")
rule Section835fAdjustmentForRefund(a: Person, r: Person, y: TaxableYear, taxes: Money, refund: Money) strict {
    label en official "section 835(f): the reciprocal's taxes are adjusted for the credit or refund allowed to the attorney-in-fact";
    when attorney_in_fact_credit_or_refund_allowed_835f(a, r, y, refund);
    when reciprocal_taxes_before_835f_adjustment(r, y, taxes);
    then reciprocal_taxes_adjusted_835f(r, y, max(0.00 USD, taxes - refund));
}
