// Sections 811, 814, 816(b)-(h), 817, 817A and 818 (life insurance
// companies: the accrual method and its duty, premium amortization and
// discount accrual, the limits on reserves and deductions, the guaranteed
// interest rule, the short-period projection, the contiguous country branch
// election, the definitions of life insurance reserves and total reserves,
// variable contracts, modified guaranteed contracts, and the miscellaneous
// rules of section 818). Stage 2c (IRC-09 stage 2c, A12), 26.09.2026.
// Status implemented_unverified.
//
// METHOD. Stage 1 keeps `life_insurance_reserves` and `total_reserves_816c`
// as case-asserted figures for the section 816(a) test; this module derives
// the same two quantities from itemised reserves under the section 816(b)
// and (c) definitions (new relations, so nothing that consumes the asserted
// figures changes). The accrual-method rule of section 811(a) and the
// separate-accounting rules of sections 814(c) and 817(c) are duties of the
// company (maintenance goals over the taxable year); the double-counting
// limits of section 811(c) are prohibitions. Treasury regulations and the
// NAIC annual statement are EXTERNAL_DEPENDENCY rows.

// ---- Section 811 ----

use self::{
    Contract,
    IRC_S811_A,
    IRC_S811_B,
    IRC_S811_C,
    IRC_S811_D,
    IRC_S811_E,
    IRC_S814_A,
    IRC_S814_B,
    IRC_S814_C,
    IRC_S814_E,
    IRC_S814_F,
    IRC_S814_G,
    IRC_S816_A,
    IRC_S816_B,
    IRC_S816_C,
    IRC_S816_D,
    IRC_S816_E,
    IRC_S816_G,
    IRC_S817A_B,
    IRC_S817A_D,
    IRC_S817_A,
    IRC_S817_B,
    IRC_S817_C,
    IRC_S817_D,
    IRC_S817_E,
    IRC_S817_G,
    IRC_S817_H,
    IRC_S818_B,
    IRC_S818_C,
    IRC_S818_G,
    Person,
    TaxableYear,
    life_insurance_company,
    transfer_subject_to_repatriation_addition_814e2A,
};

pub relation life_insurance_company_computation_year_811(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year of the life insurance company for which computations under this part are made";
}
pub relation computations_under_accrual_method_811a1(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "all computations entering into the determination of the taxes are made under an accrual method of accounting";
}
pub relation computations_under_permitted_combination_method_811a2(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the computations are made, to the extent permitted under regulations, under a combination of an accrual method with any other method permitted by the chapter (other than the cash receipts and disbursements method)";
}
pub relation computations_under_accrual_or_permitted_combination_811a(c: Person, y: TaxableYear) kind institutional {
    label en official "the computations are made under an accrual method or a permitted combination method";
}
rule Section811aAccrualMethod(c: Person, y: TaxableYear) strict {
    label en official "section 811(a)(1): an accrual method";
    when computations_under_accrual_method_811a1(c, y);
    then computations_under_accrual_or_permitted_combination_811a(c, y);
}
rule Section811aPermittedCombination(c: Person, y: TaxableYear) strict {
    label en official "section 811(a)(2): a combination method permitted under regulations";
    when computations_under_permitted_combination_method_811a2(c, y);
    then computations_under_accrual_or_permitted_combination_811a(c, y);
}
@source(IRC_S811_A, quote = "All computations entering into the determination of the taxes imposed by this part shall be made")
rule Section811aDutyToComputeOnAccrualBasis(c: Person, y: TaxableYear, begins_on: Date, ends_on: Date) strict {
    label en official "section 811(a): all computations under this part shall be made on an accrual basis (or a permitted combination)";
    when life_insurance_company(c, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    then duty ComputeUnderAccrualMethod {
        bearer c;
        goal maintenance {
            condition computations_under_accrual_or_permitted_combination_811a(c, y);
            window [begins_on, ends_on];
        }
    };
}
pub relation bond_premium_811b2(c: Person, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount of bond premium on the bond, determined under section 171(b) as if the election of section 171(c) had been made";
}
pub relation bond_premium_attributable_to_conversion_feature_811b2B(c: Person, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the part of the premium on a convertible evidence of indebtedness attributable to its conversion features";
}
pub relation bond_premium_for_811b(c: Person, y: TaxableYear, bond: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the premium taken into account: the section 171(b) premium, never including an amount attributable to the conversion features";
}
@source(IRC_S811_B, quote = "In no case shall the amount of premium on a convertible evidence of indebtedness include any amount attributable to the conversion features of the evidence of indebtedness.")
rule Section811b2BConversionFeatureExcluded(c: Person, y: TaxableYear, bond: us.irc.core::Asset, premium: Money, conversion: Money) strict {
    label en official "section 811(b)(2)(B): premium excludes the conversion-feature part";
    when bond_premium_811b2(c, y, bond, premium);
    when bond_premium_attributable_to_conversion_feature_811b2B(c, y, bond, conversion);
    then bond_premium_for_811b(c, y, bond, max(0.00 USD, premium - conversion));
}
pub relation discount_is_section_103_interest_811b3A(bond: us.irc.core::Asset) kind empirical {
    label en unofficial "the discount is interest to which section 103 applies";
}
pub relation discount_is_original_issue_discount_1273_811b3B(bond: us.irc.core::Asset) kind empirical {
    label en unofficial "the discount is original issue discount (section 1273)";
}
pub relation accrual_of_discount_required_811b3(bond: us.irc.core::Asset) kind institutional {
    label en official "accrual of the discount is required: no accrual is required on a bond except discount that is section 103 interest or original issue discount";
}
rule Section811b3AccrualOfSection103Discount(bond: us.irc.core::Asset) strict {
    label en official "section 811(b)(3)(A): section 103 interest discount is accrued";
    when discount_is_section_103_interest_811b3A(bond);
    then accrual_of_discount_required_811b3(bond);
}
rule Section811b3BAccrualOfOriginalIssueDiscount(bond: us.irc.core::Asset) strict {
    label en official "section 811(b)(3)(B): original issue discount is accrued";
    when discount_is_original_issue_discount_1273_811b3B(bond);
    then accrual_of_discount_required_811b3(bond);
}
pub relation premiums_for_item_included_in_life_insurance_gross_income_811c1(c: Person, y: TaxableYear, item: us.irc.core::Asset) kind empirical {
    label en unofficial "the gross amount of premiums and other consideration attributable to the item is required to be included in life insurance gross income";
}
pub relation reserve_for_item_permitted_811c1(c: Person, y: TaxableYear, item: us.irc.core::Asset) kind institutional {
    label en official "a reserve may be established for the item: its premiums are included in life insurance gross income";
}
@source(IRC_S811_C, quote = "a reserve to be established for any item unless the gross amount of premiums and other consideration attributable to such item are required to be included in life insurance gross income")
rule Section811c1ReserveOnlyForIncludedPremiums(c: Person, y: TaxableYear, item: us.irc.core::Asset) strict {
    label en official "section 811(c)(1): no reserve for an item whose premiums are not included in gross income";
    when premiums_for_item_included_in_life_insurance_gross_income_811c1(c, y, item);
    then reserve_for_item_permitted_811c1(c, y, item);
}
pub relation item_counted_more_than_once_for_reserve_811c2(c: Person, y: TaxableYear, item: us.irc.core::Asset) kind empirical {
    label en unofficial "the company counts the same item more than once for reserve purposes";
}
pub relation item_deducted_more_than_once_811c3(c: Person, y: TaxableYear, item: us.irc.core::Asset) kind empirical {
    label en unofficial "the company deducts the item more than once (directly or as an increase in reserves)";
}
@source(IRC_S811_C, quote = "the same item to be counted more than once for reserve purposes")
rule Section811c2NoDoubleCountingForReserves(c: Person, y: TaxableYear, item: us.irc.core::Asset) strict {
    label en official "section 811(c)(2): the same item may not be counted twice for reserves";
    when life_insurance_company(c, y);
    when premiums_for_item_included_in_life_insurance_gross_income_811c1(c, y, item);
    then prohibition NoDoubleCountingForReserves {
        bearer c;
        action item_counted_more_than_once_for_reserve_811c2(c, y, item);
        window [@1984-01-01, infinity);
    };
}
@source(IRC_S811_C, quote = "any item to be deducted (either directly or as an increase in reserves) more than once")
rule Section811c3NoDoubleDeduction(c: Person, y: TaxableYear, item: us.irc.core::Asset) strict {
    label en official "section 811(c)(3): no item is deducted twice";
    when life_insurance_company(c, y);
    when premiums_for_item_included_in_life_insurance_gross_income_811c1(c, y, item);
    then prohibition NoDoubleDeductionOfItem {
        bearer c;
        action item_deducted_more_than_once_811c3(c, y, item);
        window [@1984-01-01, infinity);
    };
}
pub relation contract_guaranteed_rate_811d(contract: Contract, rate: Decimal) kind empirical {
    label en unofficial "the interest rate to be paid or credited under the contract for the period";
}
pub relation contract_rate_guaranteed_beyond_year_end_811d2(contract: Contract) kind empirical {
    label en unofficial "the rate is guaranteed beyond the end of the taxable year on which the reserves are being computed";
}
pub relation section_808g_rate_for_contract_811d1(contract: Contract, rate: Decimal) kind empirical {
    label en unofficial "the interest rate in effect under section 808(g) for the contract for the period";
}
pub relation interest_rate_for_reserve_computation_811d(contract: Contract, rate: Decimal) kind institutional {
    label en official "the interest rate taken into account in computing the reserve: the section 808(g) rate where the guaranteed rate exceeds it and is guaranteed beyond the year end";
}
@source(IRC_S811_D, quote = "shall be taken into account in computing the reserves with respect to such contract as if such interest were guaranteed only up to the end of the taxable year")
rule Section811dExcessGuaranteeIgnored(contract: Contract, guaranteed: Decimal, statutory: Decimal) strict {
    label en official "section 811(d): a guaranteed rate above the section 808(g) rate, guaranteed beyond year end, is computed at the statutory rate";
    when contract_guaranteed_rate_811d(contract, guaranteed);
    when contract_rate_guaranteed_beyond_year_end_811d2(contract);
    when section_808g_rate_for_contract_811d1(contract, statutory);
    when guaranteed > statutory;
    then interest_rate_for_reserve_computation_811d(contract, statutory);
}
rule Section811dGuaranteedRateWithinStatutory(contract: Contract, guaranteed: Decimal, statutory: Decimal) strict {
    label en official "section 811(d): a guaranteed rate not above the section 808(g) rate is used as it is";
    when contract_guaranteed_rate_811d(contract, guaranteed);
    when section_808g_rate_for_contract_811d1(contract, statutory);
    when guaranteed <= statutory;
    then interest_rate_for_reserve_computation_811d(contract, guaranteed);
}
pub relation short_period_figure_811e(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the appropriate figure for the short period of a return covering less than the entire calendar year";
}
pub relation days_in_short_period_811e(c: Person, y: TaxableYear, days: Decimal) kind empirical {
    label en unofficial "the number of days in the short period";
}
pub relation days_in_calendar_year_811e(y: TaxableYear, days: Decimal) kind empirical {
    label en unofficial "the number of days in the calendar year";
}
pub relation annualized_short_period_figure_811e(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the short-period figure on an annual basis by a ratable daily projection (section 443 does not apply)";
}
@source(IRC_S811_E, quote = "life insurance company taxable income shall be determined, under regulations prescribed by the Secretary, on an annual basis by a ratable daily projection of the appropriate figures for the short period")
rule Section811eShortPeriodAnnualized(c: Person, y: TaxableYear, figure: Money, short_days: Decimal, year_days: Decimal) strict {
    label en official "section 811(e): the short-period figure is projected ratably to a full year";
    when short_period_figure_811e(c, y, figure);
    when days_in_short_period_811e(c, y, short_days);
    when days_in_calendar_year_811e(y, year_days);
    when short_days > 0.0;
    then annualized_short_period_figure_811e(c, y, div_round(figure * year_days, short_days, 2, "HALF_UP"));
}

// ---- Section 814: contiguous country life insurance branch ----

pub relation domestic_mutual_life_insurance_company_814a(c: Person) kind empirical {
    label en unofficial "the company is a domestic mutual insurance company that is a life insurance company";
}
pub relation branch_issues_contracts_on_residents_of_contiguous_country_814b1(br: Person) kind institutional {
    label en unofficial "the branch issues insurance contracts insuring risks in connection with the lives or health of residents of a country contiguous to the United States";
}
pub relation branch_principal_place_of_business_in_contiguous_country_814b2(br: Person) kind empirical {
    label en unofficial "the branch has its principal place of business in that contiguous country";
}
pub relation branch_would_be_mutual_life_insurance_company_814b3(br: Person) kind empirical {
    label en unofficial "the branch would constitute a mutual life insurance company if it were a separate domestic insurance company";
}
pub relation branch_of_domestic_company_814b(c: Person, br: Person) kind empirical {
    label en unofficial "the branch is a branch of the domestic company";
}
pub relation contiguous_country_life_insurance_branch_814b(br: Person) kind institutional {
    label en official "a contiguous country life insurance branch";
}
@source(IRC_S814_B, quote = "the term contiguous country life insurance branch means a branch which")
rule Section814bContiguousCountryBranch(br: Person) strict {
    label en official "section 814(b): insures residents of a contiguous country, has its principal place of business there, and would be a mutual life insurer if separate";
    when branch_issues_contracts_on_residents_of_contiguous_country_814b1(br);
    when branch_principal_place_of_business_in_contiguous_country_814b2(br);
    when branch_would_be_mutual_life_insurance_company_814b3(br);
    then contiguous_country_life_insurance_branch_814b(br);
}
pub relation elects_branch_exclusion_814g(c: Person, br: Person, y: TaxableYear, filed_on: Date) kind empirical {
    label en unofficial "the taxpayer makes the section 814(g) election with respect to the contiguous country branch, on this date";
}
pub relation return_due_date_with_extensions_814g(c: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the time prescribed by law for filing the return for the taxable year, including extensions";
}
pub relation branch_election_timely_814g(c: Person, br: Person, y: TaxableYear) kind institutional {
    label en official "the election is made not later than the time prescribed by law for filing the return, including extensions";
}
rule Section814gTimely(c: Person, br: Person, y: TaxableYear, filed_on: Date, due: Date) strict {
    label en official "section 814(g): the election is filed by the return due date";
    when elects_branch_exclusion_814g(c, br, y, filed_on);
    when return_due_date_with_extensions_814g(c, y, due);
    when filed_on <= due;
    then branch_election_timely_814g(c, br, y);
}
pub relation branch_election_valid_814a_g(c: Person, br: Person, y: TaxableYear) kind institutional {
    label en official "the election is timely and made by a domestic mutual life insurance company for a contiguous country branch";
}
rule Section814gElectionEligibility(c: Person, br: Person, y: TaxableYear) strict {
    label en official "sections 814(a), (g): a domestic mutual life insurer with a contiguous country branch and a timely election";
    when domestic_mutual_life_insurance_company_814a(c);
    when branch_of_domestic_company_814b(c, br);
    when contiguous_country_life_insurance_branch_814b(br);
    when branch_election_timely_814g(c, br, y);
    then branch_election_valid_814a_g(c, br, y);
}
pub relation branch_election_in_effect_814g(c: Person, br: Person, y: TaxableYear) kind institutional {
    label en official "the section 814(g) election is in effect for the taxable year and, until revoked with the Secretary's consent, all subsequent years";
}
@source(IRC_S814_G, quote = "A taxpayer may make the election provided by this subsection with respect to any contiguous country for any taxable year.")
rule Section814gElectionPower(c: Person, br: Person, y: TaxableYear, filed_on: Date) strict {
    label en official "section 814(g): the taxpayer may elect the exclusion of the branch's items";
    when elects_branch_exclusion_814g(c, br, y, filed_on);
    then power ContiguousCountryBranchElection {
        holder c;
        over br;
        exercise elects_branch_exclusion_814g(c, br, y, filed_on);
        valid_when branch_election_valid_814a_g(c, br, y);
        effect create(branch_election_in_effect_814g(c, br, y));
        window [@1984-01-01, infinity);
    };
}
pub relation branch_items_excluded_from_licti_814a(c: Person, br: Person, y: TaxableYear) kind institutional {
    label en official "the items separately accounted for in the branch account are excluded from each item in the determination of life insurance company taxable income";
}
@source(IRC_S814_A, quote = "there shall be excluded from each item involved in the determination of life insurance company taxable income the items separately accounted for in accordance with subsection (c)")
rule Section814aBranchItemsExcluded(c: Person, br: Person, y: TaxableYear) strict {
    label en official "section 814(a): with the election in effect the branch items are excluded";
    when branch_election_in_effect_814g(c, br, y);
    then branch_items_excluded_from_licti_814a(c, br, y);
}
pub relation branch_separate_account_maintained_814c(c: Person, br: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer has established and maintains a separate account for the income, exclusion, deduction, asset, reserve, liability and surplus items attributable to the branch";
}
@source(IRC_S814_C, quote = "Any taxpayer which makes the election provided by subsection (g) shall establish and maintain a separate account")
rule Section814cDutyToMaintainBranchAccount(c: Person, br: Person, y: TaxableYear, begins_on: Date, ends_on: Date) strict {
    label en official "section 814(c): an electing taxpayer must maintain a separate branch account";
    when branch_election_in_effect_814g(c, br, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    then duty MaintainBranchSeparateAccount {
        bearer c;
        goal maintenance {
            condition branch_separate_account_maintained_814c(c, br, y);
            window [begins_on, ends_on];
        }
    };
}
pub relation aggregate_decrease_in_tentative_licti_814e2Bi(c: Person, br: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate decrease in the tentative LICTI for the taxable year and all prior years resulting solely from the application of subsection (a) with respect to the branch";
}
pub relation prior_additions_to_tentative_licti_814e2Bii(c: Person, br: Person, amount: Money) kind empirical {
    label en unofficial "the amount of additions to tentative LICTI under subparagraph (A) with respect to the branch for all prior taxable years";
}
pub relation amount_transferred_from_branch_account_814e2A(c: Person, br: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount directly or indirectly transferred or credited from the branch account to other accounts of the company (other than as reimbursement or otherwise excepted)";
}
pub relation branch_transfer_addition_to_tentative_licti_814e2(c: Person, br: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the addition to tentative LICTI for a branch transfer, not more than the excess of the aggregate decrease from subsection (a) over prior additions";
}
@source(IRC_S814_E, quote = "The addition provided by subparagraph (A) for the taxable year with respect to any contiguous country life insurance branch shall not exceed the amount by which")
rule Section814e2AdditionCappedByAggregateDecrease(c: Person, br: Person, y: TaxableYear, transferred: Money, decrease: Money, prior: Money) strict {
    label en official "section 814(e)(2): the addition equals the transfer, capped by the aggregate decrease less prior additions";
    when transfer_subject_to_repatriation_addition_814e2A(c, br, y, transferred);
    when aggregate_decrease_in_tentative_licti_814e2Bi(c, br, decrease);
    when prior_additions_to_tentative_licti_814e2Bii(c, br, prior);
    then branch_transfer_addition_to_tentative_licti_814e2(c, br, y, min(transferred, max(0.00 USD, decrease - prior)));
}
pub relation branch_treated_as_foreign_corporation_814f2(br: Person) kind institutional {
    label en official "for sections 881, 882 and 1442 each contiguous country life insurance branch is treated as a foreign corporation";
}
@source(IRC_S814_F, quote = "each contiguous country life insurance branch shall be treated as a foreign corporation")
rule Section814f2BranchIsForeignCorporation(br: Person) strict {
    label en official "section 814(f)(2): the branch is a foreign corporation for the withholding and foreign corporation taxes";
    when contiguous_country_life_insurance_branch_814b(br);
    then branch_treated_as_foreign_corporation_814f2(br);
}

// ---- Section 816(b)-(h): reserves ----

pub enum LifeReserveKind816 {
    ReserveOnRecognizedTables;
    ReserveOnWeeklyPremiumPolicy;
    ReserveAssessmentDeposit;
    ReserveAssessmentCharterFund;
    ReserveOtherRequiredByLaw;
    label en unofficial "the class of an insurance reserve for the section 816(b) and (c) definitions";
}
pub relation reserve_item_816b(c: Person, y: TaxableYear, item: us.irc.core::Asset, kind: LifeReserveKind816, begin_amount: Money, end_amount: Money) kind empirical {
    label en unofficial "a reserve of the company with its amount at the beginning and at the end of the taxable year";
}
pub relation reserve_computed_on_recognized_tables_and_interest_816b1A(item: us.irc.core::Asset) kind empirical {
    label en unofficial "the amount is computed or estimated on the basis of recognized mortality or morbidity tables and assumed rates of interest";
}
pub relation reserve_set_aside_for_future_unaccrued_claims_816b1B(item: us.irc.core::Asset) kind empirical {
    label en unofficial "the amount is set aside to mature or liquidate, by payment or reinsurance, future unaccrued claims arising from life insurance, annuity and noncancellable accident and health contracts";
}
pub relation reserve_required_by_law_816b2(item: us.irc.core::Asset) kind empirical {
    label en unofficial "the reserve is required by law";
}
pub relation life_insurance_reserve_item_816b(c: Person, y: TaxableYear, item: us.irc.core::Asset, mean_amount: Money) kind institutional {
    label en official "a life insurance reserve item: the mean of the reserve at the beginning and end of the taxable year";
}
@source(IRC_S816_B, quote = "the term \"life insurance reserves\" means amounts")
rule Section816bMainDefinition(c: Person, y: TaxableYear, item: us.irc.core::Asset, begin: Money, end: Money) strict {
    label en official "section 816(b)(1)-(2),(4): computed on tables and assumed interest, set aside for future claims, required by law; the reserve is the mean of the opening and closing amounts";
    when reserve_item_816b(c, y, item, ReserveOnRecognizedTables, begin, end);
    when reserve_computed_on_recognized_tables_and_interest_816b1A(item);
    when reserve_set_aside_for_future_unaccrued_claims_816b1B(item);
    when reserve_required_by_law_816b2(item);
    then life_insurance_reserve_item_816b(c, y, item, div_round(begin + end, 2.0, 2, "HALF_UP"));
}
@source(IRC_S816_B, quote = "in the case of policies covering life, accident, and health insurance combined in one policy issued on the weekly premium payment plan, continuing for life and not subject to cancellation")
rule Section816b2AWeeklyPremiumNeedsNoLawRequirement(c: Person, y: TaxableYear, item: us.irc.core::Asset, begin: Money, end: Money) strict {
    label en official "section 816(b)(2)(A): a weekly premium combined policy reserve need not be required by law";
    when reserve_item_816b(c, y, item, ReserveOnWeeklyPremiumPolicy, begin, end);
    when reserve_computed_on_recognized_tables_and_interest_816b1A(item);
    when reserve_set_aside_for_future_unaccrued_claims_816b1B(item);
    then life_insurance_reserve_item_816b(c, y, item, div_round(begin + end, 2.0, 2, "HALF_UP"));
}
@source(IRC_S816_B, quote = "In the case of an assessment life insurance company or association, the term \"life insurance reserves\" includes")
rule Section816b3AAssessmentDeposits(c: Person, y: TaxableYear, item: us.irc.core::Asset, begin: Money, end: Money) strict {
    label en official "section 816(b)(3)(A): sums deposited with State officers as guaranty or reserve funds";
    when reserve_item_816b(c, y, item, ReserveAssessmentDeposit, begin, end);
    then life_insurance_reserve_item_816b(c, y, item, div_round(begin + end, 2.0, 2, "HALF_UP"));
}
rule Section816b3BAssessmentCharterFunds(c: Person, y: TaxableYear, item: us.irc.core::Asset, begin: Money, end: Money) strict {
    label en official "section 816(b)(3)(B): funds maintained under the charter exclusively for the payment of certain claims";
    when reserve_item_816b(c, y, item, ReserveAssessmentCharterFund, begin, end);
    then life_insurance_reserve_item_816b(c, y, item, div_round(begin + end, 2.0, 2, "HALF_UP"));
}
pub relation life_insurance_reserves_derived_816b(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the life insurance reserves of the company for the year: the sum of the qualifying reserve items, each at the mean of its opening and closing amounts";
}
rule Section816bLifeInsuranceReservesTotal(c: Person, y: TaxableYear) strict {
    label en official "section 816(b): the sum of the qualifying items";
    when life_insurance_reserve_item_816b(c, y, _, _);
    then life_insurance_reserves_derived_816b(c, y, sum all amount: Money for item: us.irc.core::Asset where life_insurance_reserve_item_816b(c, y, item, amount));
}
pub relation unearned_premiums_and_unpaid_losses_mean_816c2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "unearned premiums and unpaid losses (whether or not ascertained) not included in life insurance reserves, at the mean of the beginning and end of the year";
}
pub relation other_insurance_reserves_required_by_law_mean_816c3(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "all other insurance reserves required by law, at the mean of the beginning and end of the year";
}
pub relation total_reserves_derived_816c(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "total reserves: life insurance reserves, unearned premiums and unpaid losses not included in them, and all other insurance reserves required by law";
}
@source(IRC_S816_C, quote = "the term \"total reserves\" means")
rule Section816cTotalReserves(c: Person, y: TaxableYear, life: Money, unearned: Money, other: Money) strict {
    label en official "section 816(c): the sum of the three components";
    when life_insurance_reserves_derived_816b(c, y, life);
    when unearned_premiums_and_unpaid_losses_mean_816c2(c, y, unearned);
    when other_insurance_reserves_required_by_law_mean_816c3(c, y, other);
    then total_reserves_derived_816c(c, y, (life + unearned) + other);
}
pub relation policy_loans_outstanding_mean_816d(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the mean of the aggregates, at the beginning and end of the year, of the policy loans outstanding on contracts for which life insurance reserves are maintained";
}
pub relation amounts_held_at_interest_without_permanent_guarantees_816f(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts set aside and held at interest to satisfy obligations under contracts that contain no permanent guarantees with respect to life, accident or health contingencies";
}
pub relation deficiency_reserves_816h(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deficiency reserves of the company";
}
pub relation life_insurance_reserves_for_status_test_816d(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for the section 816(a) status test only: life insurance reserves reduced by the mean of outstanding policy loans, by amounts held at interest without permanent guarantees, and by deficiency reserves";
}
@source(IRC_S816_D, quote = "the life insurance reserves, and the total reserves, shall each be reduced by an amount equal to the mean of the aggregates")
rule Section816dReservesForStatusTest(c: Person, y: TaxableYear, life: Money, loans: Money, held: Money, deficiency: Money) strict {
    label en official "sections 816(d), (f), (h): life insurance reserves for the status test are reduced by policy loans, non-guaranteed held amounts and deficiency reserves";
    when life_insurance_reserves_derived_816b(c, y, life);
    when policy_loans_outstanding_mean_816d(c, y, loans);
    when amounts_held_at_interest_without_permanent_guarantees_816f(c, y, held);
    when deficiency_reserves_816h(c, y, deficiency);
    then life_insurance_reserves_for_status_test_816d(c, y, max(0.00 USD, ((life - loans) - held) - deficiency));
}
pub relation total_reserves_for_status_test_816d(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for the section 816(a) status test only: total reserves reduced by the mean of outstanding policy loans, by amounts held at interest without permanent guarantees, and by deficiency reserves";
}
rule Section816dTotalReservesForStatusTest(c: Person, y: TaxableYear, total: Money, loans: Money, held: Money, deficiency: Money) strict {
    label en official "sections 816(d), (f), (h): total reserves for the status test reduced likewise";
    when total_reserves_derived_816c(c, y, total);
    when policy_loans_outstanding_mean_816d(c, y, loans);
    when amounts_held_at_interest_without_permanent_guarantees_816f(c, y, held);
    when deficiency_reserves_816h(c, y, deficiency);
    then total_reserves_for_status_test_816d(c, y, max(0.00 USD, ((total - loans) - held) - deficiency));
}
pub relation life_insurance_status_reserves_test_816a_derived(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 816(a) test met on derived reserves: life insurance reserves exceed 50 percent of total reserves after the section 816(d), (f), (h) reductions";
}
@source(IRC_S816_A, quote = "the term \"life insurance company\" means an insurance company which is engaged in the business of issuing life insurance and annuity contracts")
rule Section816aStatusFromDerivedReserves(c: Person, y: TaxableYear, life: Money, total: Money) strict {
    label en official "section 816(a)(2): life insurance reserves plus unearned premiums and unpaid losses on noncancellable and similar contracts exceed 50 percent of total reserves (over the derived, reduced figures)";
    when life_insurance_reserves_for_status_test_816d(c, y, life);
    when total_reserves_for_status_test_816d(c, y, total);
    when life * 100.0 > total * 50.0;
    then life_insurance_status_reserves_test_816a_derived(c, y);
}
pub relation guaranteed_renewable_contract_816e(contract: Contract) kind empirical {
    label en unofficial "the contract is a guaranteed renewable life, accident or health contract";
}
pub relation treated_as_noncancellable_816e(contract: Contract) kind institutional {
    label en official "guaranteed renewable contracts are treated in the same manner as noncancellable life, accident and health insurance";
}
@source(IRC_S816_E, quote = "guaranteed renewable life, accident, and health insurance shall be treated in the same manner as noncancellable life, accident, and health insurance")
rule Section816eGuaranteedRenewableIsNoncancellable(contract: Contract) strict {
    label en official "section 816(e): guaranteed renewable equals noncancellable";
    when guaranteed_renewable_contract_816e(contract);
    then treated_as_noncancellable_816e(contract);
}
pub relation burial_insurer_manufactures_funeral_supplies_or_performs_services_816g(c: Person) kind empirical {
    label en unofficial "the burial or funeral benefit insurance company is engaged directly in the manufacture of funeral supplies or the performance of funeral services";
}
pub relation taxable_under_831_not_this_part_816g(c: Person) kind institutional {
    label en official "the company is not taxable under this part but under section 831";
}
@source(IRC_S816_G, quote = "shall not be taxable under this part but shall be taxable under section 831")
rule Section816gFuneralInsurerTaxedUnder831(c: Person) strict {
    label en official "section 816(g): a funeral-directing burial insurer is taxed under section 831";
    when burial_insurer_manufactures_funeral_supplies_or_performs_services_816g(c);
    then taxable_under_831_not_this_part_816g(c);
}

// ---- Section 817: variable contracts ----

pub relation section_807c_items_of_variable_contract_817a(c: Person, y: TaxableYear, contract: Contract, amount: Money) kind empirical {
    label en unofficial "the sum of the section 807(c) items taken into account at the close of the taxable year with respect to the variable contract";
}
pub relation appreciation_added_to_segregated_reserves_817a1(c: Person, y: TaxableYear, contract: Contract, amount: Money) kind empirical {
    label en unofficial "the amounts added to the separately accounted reserves by reason of appreciation in the value of assets (whether or not disposed of)";
}
pub relation depreciation_subtracted_from_segregated_reserves_817a2(c: Person, y: TaxableYear, contract: Contract, amount: Money) kind empirical {
    label en unofficial "the amounts subtracted from the separately accounted reserves by reason of depreciation in the value of assets";
}
pub relation variable_contract_section_807c_items_adjusted_817a(c: Person, y: TaxableYear, contract: Contract, amount: Money) kind institutional {
    label en official "the items adjusted by subtracting appreciation added and adding depreciation subtracted";
}
@source(IRC_S817_A, quote = "by subtracting therefrom an amount equal to the sum of the amounts added from time to time (for the taxable year) to the reserves separately accounted for in accordance with subsection (c) by reason of appreciation in value of")
rule Section817aAdjustedItems(c: Person, y: TaxableYear, contract: Contract, items: Money, appreciation: Money, depreciation: Money) strict {
    label en official "section 817(a)(1)-(2): items less appreciation plus depreciation";
    when section_807c_items_of_variable_contract_817a(c, y, contract, items);
    when appreciation_added_to_segregated_reserves_817a1(c, y, contract, appreciation);
    when depreciation_subtracted_from_segregated_reserves_817a2(c, y, contract, depreciation);
    then variable_contract_section_807c_items_adjusted_817a(c, y, contract, (items - appreciation) + depreciation);
}
pub relation segregated_asset_basis_before_817b(asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the basis of the asset in the segregated asset account before the section 817(b) adjustments";
}
pub relation segregated_asset_appreciation_reflected_817b1(asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the appreciation reflected in the increases in reserves or other items referred to in subsection (a)";
}
pub relation segregated_asset_depreciation_reflected_817b2(asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the depreciation reflected in the decreases in reserves or other items referred to in subsection (a)";
}
pub relation segregated_asset_basis_after_817b(asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of an asset in a segregated asset account, increased by appreciation and decreased by depreciation so reflected";
}
@source(IRC_S817_B, quote = "to the extent such appreciation and depreciation are from time to time reflected in the increases and decreases in reserves or other items referred to in subsection (a) with respect to such contracts")
rule Section817bBasisAdjustments(asset: us.irc.core::Asset, before: Money, appreciation: Money, depreciation: Money) strict {
    label en official "section 817(b): basis plus reflected appreciation minus reflected depreciation";
    when segregated_asset_basis_before_817b(asset, before);
    when segregated_asset_appreciation_reflected_817b1(asset, appreciation);
    when segregated_asset_depreciation_reflected_817b2(asset, depreciation);
    then segregated_asset_basis_after_817b(asset, (before + appreciation) - depreciation);
}
pub relation variable_contract_separate_accounting_maintained_817c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company separately accounts for the income, exclusion, deduction, asset, reserve and other liability items properly attributable to its variable contracts";
}
pub relation company_issues_variable_contracts_817c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the life insurance company issues variable contracts in the taxable year";
}
@source(IRC_S817_C, quote = "a life insurance company which issues variable contracts shall separately account for the various income, exclusion, deduction, asset, reserve, and other liability items properly attributable to such variable contracts")
rule Section817cDutyToAccountSeparately(c: Person, y: TaxableYear, begins_on: Date, ends_on: Date) strict {
    label en official "section 817(c): a life insurer issuing variable contracts must separately account for them";
    when life_insurance_company(c, y);
    when company_issues_variable_contracts_817c(c, y);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    then duty AccountSeparatelyForVariableContracts {
        bearer c;
        goal maintenance {
            condition variable_contract_separate_accounting_maintained_817c(c, y);
            window [begins_on, ends_on];
        }
    };
}
pub relation contract_allocates_amounts_to_state_segregated_account_817d1(contract: Contract) kind empirical {
    label en unofficial "the contract provides for the allocation of all or part of the amounts received to an account that, under State law or regulation, is segregated from the general asset accounts of the company";
}
pub relation contract_is_annuity_life_or_retired_lives_funding_817d2(contract: Contract) kind empirical {
    label en unofficial "the contract provides for the payment of annuities, is a life insurance contract, or provides for funding of insurance on retired lives as described in section 807(c)(6)";
}
pub relation contract_reflects_investment_return_and_market_value_817d3(contract: Contract) kind empirical {
    label en unofficial "the amounts paid in or out (annuity), the death benefit or period of coverage (life insurance), or the amounts paid in or out (retired lives funding) reflect the investment return and market value of the segregated asset account";
}
pub relation contract_ceased_to_reflect_current_investment_return_817d(contract: Contract) kind empirical {
    label en unofficial "the contract has ceased to reflect current investment return and current market value";
}
pub relation variable_contract_817d(contract: Contract) kind institutional {
    label en official "the contract is a variable contract";
}
@source(IRC_S817_D, quote = "For purposes of this part, the term \"variable contract\" means a contract")
rule Section817dVariableContract(contract: Contract) defeasible {
    label en official "section 817(d): segregated account, annuity or life or retired lives funding contract, and reflecting the account's return and market value, until it ceases to";
    when contract_allocates_amounts_to_state_segregated_account_817d1(contract);
    when contract_is_annuity_life_or_retired_lives_funding_817d2(contract);
    when contract_reflects_investment_return_and_market_value_817d3(contract);
    when not_known(contract_ceased_to_reflect_current_investment_return_817d(contract));
    then variable_contract_817d(contract);
}
pub relation pension_plan_contract_not_insurance_817e(contract: Contract) kind empirical {
    label en unofficial "the pension plan contract is not a life, accident or health, property, casualty or liability insurance contract";
}
pub relation treated_as_annuity_payment_contract_817e(contract: Contract) kind institutional {
    label en official "the pension plan contract is treated as a contract that provides for the payment of annuities for subsection (d)";
}
@source(IRC_S817_E, quote = "A pension plan contract which is not a life, accident, or health, property, casualty, or liability insurance contract shall be treated as a contract which provides for the payments of annuities for purposes of subsection (d).")
rule Section817ePensionPlanContractIsAnnuity(contract: Contract) strict {
    label en official "section 817(e): a non-insurance pension plan contract counts as an annuity contract";
    when pension_plan_contract_not_insurance_817e(contract);
    then treated_as_annuity_payment_contract_817e(contract);
}
pub relation segregated_account_meets_851b3_at_quarter_close_817h2A(account: us.irc.core::Asset, q: us.irc.core::Period) kind empirical {
    label en unofficial "the segregated asset account meets the requirements of section 851(b)(3) at the close of the quarter";
}
pub relation account_value_in_851b3Ai_assets_817h2B(account: us.irc.core::Asset, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the value of the account's assets that are described in section 851(b)(3)(A)(i)";
}
pub relation account_total_value_817h2B(account: us.irc.core::Asset, q: us.irc.core::Period, amount: Money) kind empirical {
    label en unofficial "the value of the total assets of the account";
}
pub relation account_adequately_diversified_for_quarter_817h2(account: us.irc.core::Asset, q: us.irc.core::Period) kind institutional {
    label en official "the segregated asset account is treated as meeting the diversification requirement for the quarter";
}
@source(IRC_S817_H, quote = "no more than 55 percent of the value of the total assets of the account are assets described in section 851(b)(3)(A)(i)")
rule Section817h2SafeHarbor(account: us.irc.core::Asset, q: us.irc.core::Period, cash_like: Money, total: Money) strict {
    label en official "section 817(h)(2): meeting section 851(b)(3) and at most 55 percent in section 851(b)(3)(A)(i) assets";
    when segregated_account_meets_851b3_at_quarter_close_817h2A(account, q);
    when account_value_in_851b3Ai_assets_817h2B(account, q, cash_like);
    when account_total_value_817h2B(account, q, total);
    when cash_like * 100.0 <= total * 55.0;
    then account_adequately_diversified_for_quarter_817h2(account, q);
}
pub relation account_investment_in_us_treasury_securities_817h3(account: us.irc.core::Asset) kind empirical {
    label en unofficial "the segregated asset account of a variable life insurance contract is invested in securities issued by the United States Treasury";
}
pub relation treasury_investments_treated_as_adequately_diversified_817h3(account: us.irc.core::Asset) kind institutional {
    label en official "to that extent the account's investments are treated as adequately diversified";
}
rule Section817h3TreasuryInvestments(account: us.irc.core::Asset) strict {
    label en official "section 817(h)(3): Treasury securities count as adequately diversified";
    when account_investment_in_us_treasury_securities_817h3(account);
    then treasury_investments_treated_as_adequately_diversified_817h3(account);
}
pub relation account_adequately_diversified_817h1(account: us.irc.core::Asset, q: us.irc.core::Period) kind empirical {
    label en unofficial "the investments made by the account are, in accordance with regulations, adequately diversified for the period (the regulations' tests are outside the pinned text)";
}
pub relation variable_contract_treated_as_annuity_or_life_insurance_817h1(contract: Contract, account: us.irc.core::Asset, q: us.irc.core::Period) kind institutional {
    label en official "the variable contract based on the segregated asset account is treated as an annuity, endowment or life insurance contract for the period";
}
@source(IRC_S817_H, quote = "shall not be treated as an annuity, endowment, or life insurance contract for any period (and any subsequent period) for which the investments made by such account are not")
rule Section817h1AdequatelyDiversifiedContract(contract: Contract, account: us.irc.core::Asset, q: us.irc.core::Period) defeasible {
    label en official "section 817(h)(1): a variable contract keeps its annuity/life insurance character only while the account is adequately diversified";
    when variable_contract_817d(contract);
    when contract_account_817h(contract, account);
    when account_adequately_diversified_817h1(account, q);
    then variable_contract_treated_as_annuity_or_life_insurance_817h1(contract, account, q);
}
pub relation contract_account_817h(contract: Contract, account: us.irc.core::Asset) kind empirical {
    label en unofficial "the contract is based on the segregated asset account";
}
pub relation account_holders_are_insurance_companies_or_fund_managers_817h4(account: us.irc.core::Asset) kind empirical {
    label en unofficial "all of the beneficial interests in a RIC or trust are held by insurance companies (or affiliates) in general or segregated accounts, or by fund managers (or affiliates)";
}
pub relation diversification_looks_through_to_ric_or_trust_817h4(account: us.irc.core::Asset) kind institutional {
    label en official "the diversification requirement is applied by taking into account the assets held by the regulated investment company or trust";
}
rule Section817h4LookThrough(account: us.irc.core::Asset) strict {
    label en official "section 817(h)(4): look-through to the RIC or trust";
    when account_holders_are_insurance_companies_or_fund_managers_817h4(account);
    then diversification_looks_through_to_ric_or_trust_817h4(account);
}
pub relation government_agency_or_instrumentality_issuer_817h6(issuer: Person) kind empirical {
    label en unofficial "the issuer is a United States Government agency or instrumentality";
}
pub relation government_agency_treated_as_separate_issuer_817h6(issuer: Person) kind institutional {
    label en official "each United States Government agency or instrumentality is a separate issuer for the diversification test";
}
rule Section817h6AgencySeparateIssuer(issuer: Person) strict {
    label en official "section 817(h)(6): each agency is a separate issuer";
    when government_agency_or_instrumentality_issuer_817h6(issuer);
    then government_agency_treated_as_separate_issuer_817h6(issuer);
}
pub relation variable_annuity_computed_on_mortality_and_investment_experience_817g(contract: Contract) kind empirical {
    label en unofficial "the contract provides for the payment of a variable annuity computed on recognized mortality tables and the investment experience of a segregated asset account or the company-wide investment experience";
}
pub relation company_issues_only_variable_contracts_817g2(c: Person) kind empirical {
    label en unofficial "the company issues no contracts other than variable contracts";
}
pub relation annuity_contract_includes_variable_annuity_817g(contract: Contract) kind institutional {
    label en official "the term annuity contract includes the variable annuity contract";
}
@source(IRC_S817_G, quote = "the term \"annuity contract\" includes a contract which provides for the payment of a variable annuity")
rule Section817gVariableAnnuityIsAnnuityContract(contract: Contract) strict {
    label en official "section 817(g): a variable annuity contract is an annuity contract";
    when variable_annuity_computed_on_mortality_and_investment_experience_817g(contract);
    then annuity_contract_includes_variable_annuity_817g(contract);
}

// ---- Section 817A: modified guaranteed contracts ----

pub relation contract_not_described_in_817_allocated_to_market_valued_account_817Ad1(contract: Contract) kind empirical {
    label en unofficial "all or part of the amounts received are allocated to a segregated account valued from time to time by reference to market value";
}
pub relation contract_annuity_life_or_pension_817Ad2(contract: Contract) kind empirical {
    label en unofficial "the contract provides for annuities, is a life insurance contract, or is a pension plan contract that is not an insurance contract";
}
pub relation contract_reserves_valued_at_market_for_annual_statement_817Ad3(contract: Contract) kind empirical {
    label en unofficial "the reserves are valued at market for annual statement purposes";
}
pub relation contract_provides_net_surrender_value_or_policyholders_fund_817Ad4(contract: Contract) kind empirical {
    label en unofficial "the contract provides for a net surrender value or a policyholder's fund (section 807(e)(1))";
}
pub relation modified_guaranteed_contract_817Ad(contract: Contract) kind institutional {
    label en official "the contract is a modified guaranteed contract";
}
@source(IRC_S817A_D, quote = "the term \"modified guaranteed contract\" means a contract not described in section 817")
rule Section817AdModifiedGuaranteedContract(contract: Contract) defeasible {
    label en official "section 817A(d): a contract not described in section 817 meeting the four conditions";
    when contract_not_described_in_817_allocated_to_market_valued_account_817Ad1(contract);
    when contract_annuity_life_or_pension_817Ad2(contract);
    when contract_reserves_valued_at_market_for_annual_statement_817Ad3(contract);
    when contract_provides_net_surrender_value_or_policyholders_fund_817Ad4(contract);
    when not_known(variable_contract_817d(contract));
    then modified_guaranteed_contract_817Ad(contract);
}
pub relation segregated_asset_under_mgc_817Ab2(asset: us.irc.core::Asset, contract: Contract) kind empirical {
    label en unofficial "the asset is held as part of a segregated account under a modified guaranteed contract";
}
pub relation segregated_asset_fair_market_value_last_business_day_817Ab1B(asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the asset on the last business day of the taxable year";
}
pub relation segregated_asset_adjusted_basis_817Ab1B(asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the asset";
}
pub relation mark_to_market_gain_or_loss_817Ab1B(asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain or loss recognized as if the asset were sold for its fair market value on the last business day of the taxable year; ordinary income or loss";
}
@source(IRC_S817A_B, quote = "such company shall recognize gain or loss as if such asset were sold for its fair market value on the last business day of such taxable year")
rule Section817Ab1BMarkToMarket(asset: us.irc.core::Asset, contract: Contract, fmv: Money, basis: Money) defeasible {
    label en official "section 817A(b)(1)(A)-(B): held segregated assets are marked to market and the gain or loss is ordinary";
    when segregated_asset_under_mgc_817Ab2(asset, contract);
    when modified_guaranteed_contract_817Ad(contract);
    when segregated_asset_fair_market_value_last_business_day_817Ab1B(asset, fmv);
    when segregated_asset_adjusted_basis_817Ab1B(asset, basis);
    then mark_to_market_gain_or_loss_817Ab1B(asset, fmv - basis);
}

// ---- Section 818 ----

pub relation contract_entered_with_401a_exempt_trust_818a1(contract: Contract) kind empirical {
    label en unofficial "the contract was entered into with a trust that was deemed a trust described in section 401(a) and exempt from tax under section 501(a) (or a section 165 trust of the 1939 Code)";
}
pub relation contract_entered_under_403a_plan_818a2(contract: Contract) kind empirical {
    label en unofficial "the contract was entered into under a plan deemed a plan described in section 403(a) (or meeting section 165(a)(3)-(6) of the 1939 Code)";
}
pub relation contract_for_life_insurer_employees_under_qualified_plan_818a3(contract: Contract) kind empirical {
    label en unofficial "the contract is provided for employees of the life insurance company under a plan that, for the year, meets the listed requirements of section 401(a)";
}
pub relation contract_purchased_by_501c3_for_retirement_annuities_818a4(contract: Contract) kind empirical {
    label en unofficial "the contract was purchased to provide retirement annuities for employees by a section 501(c)(3) organization exempt under section 501(a)";
}
pub relation contract_entered_with_individual_retirement_account_818a5(contract: Contract) kind empirical {
    label en unofficial "the contract was entered into with an individual retirement account (section 408(a)) or is an individual retirement annuity (section 408(b))";
}
pub relation contract_purchased_by_governmental_plan_or_government_818a6(contract: Contract) kind empirical {
    label en unofficial "the contract is purchased by a governmental plan, an eligible deferred compensation plan, a government, or a tax-exempt organization for a section 457 plan";
}
pub relation pension_plan_contract_818a(contract: Contract) kind institutional {
    label en official "the contract is a pension plan contract";
}
rule Section818a1PensionPlanContract401aTrust(contract: Contract) strict {
    label en official "section 818(a)(1): entered into with an exempt section 401(a) trust";
    when contract_entered_with_401a_exempt_trust_818a1(contract);
    then pension_plan_contract_818a(contract);
}
rule Section818a2PensionPlanContract403aPlan(contract: Contract) strict {
    label en official "section 818(a)(2): entered into under a section 403(a) plan";
    when contract_entered_under_403a_plan_818a2(contract);
    then pension_plan_contract_818a(contract);
}
rule Section818a3PensionPlanContractEmployeePlan(contract: Contract) strict {
    label en official "section 818(a)(3): provided for the insurer's own employees under a qualified plan";
    when contract_for_life_insurer_employees_under_qualified_plan_818a3(contract);
    then pension_plan_contract_818a(contract);
}
rule Section818a4PensionPlanContract501c3(contract: Contract) strict {
    label en official "section 818(a)(4): purchased by a 501(c)(3) organization for retirement annuities";
    when contract_purchased_by_501c3_for_retirement_annuities_818a4(contract);
    then pension_plan_contract_818a(contract);
}
rule Section818a5PensionPlanContractIra(contract: Contract) strict {
    label en official "section 818(a)(5): an individual retirement account or annuity contract";
    when contract_entered_with_individual_retirement_account_818a5(contract);
    then pension_plan_contract_818a(contract);
}
rule Section818a6PensionPlanContractGovernmental(contract: Contract) strict {
    label en official "section 818(a)(6): purchased by a governmental plan, eligible deferred compensation plan or government";
    when contract_purchased_by_governmental_plan_or_government_818a6(contract);
    then pension_plan_contract_818a(contract);
}
pub relation property_used_in_insurance_business_depreciable_held_over_one_year_818b1A(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is used in carrying on an insurance business, is of a character subject to the section 167 allowance, and is held for more than 1 year (or is real property used in carrying on an insurance business)";
}
pub relation property_described_in_1231b2_818b1B(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is described in section 1231(b)(2)";
}
pub relation property_used_in_trade_or_business_for_1231a_insurer_818b1(p: us.irc.core::Asset) kind institutional {
    label en official "for a life insurance company, the term property used in the trade or business in section 1231(a) includes only these properties";
}
@source(IRC_S818_B, quote = "in applying section 1231(a), the term \"property used in the trade or business\" shall be treated as including only")
rule Section818b1AInsuranceBusinessProperty(p: us.irc.core::Asset) strict {
    label en official "section 818(b)(1)(A): property used in an insurance business";
    when property_used_in_insurance_business_depreciable_held_over_one_year_818b1A(p);
    then property_used_in_trade_or_business_for_1231a_insurer_818b1(p);
}
rule Section818b1B1231b2Property(p: us.irc.core::Asset) strict {
    label en official "section 818(b)(1)(B): property described in section 1231(b)(2)";
    when property_described_in_1231b2_818b1B(p);
    then property_used_in_trade_or_business_for_1231a_insurer_818b1(p);
}
pub relation gain_without_regard_to_818c_1958_property(p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the gain on the sale or disposition of the property, determined without regard to subsection (c)";
}
pub relation fair_market_value_on_1958_12_31_818c1(p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the property on December 31, 1958";
}
pub relation adjusted_basis_on_1958_12_31_818c1(p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis for determining gain as of December 31, 1958";
}
pub relation life_insurer_at_all_times_after_1958_12_31_818c1B(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the taxpayer has been a life insurance company at all times on and after December 31, 1958";
}
pub relation gain_on_1958_property_818c1(p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain treated as the excess (not less than zero) of the gain otherwise determined over the December 31, 1958 appreciation";
}
@source(IRC_S818_C, quote = "the gain on the sale or other disposition of such property shall be treated as an amount (not less than zero) equal to the amount by which the gain")
rule Section818c1GainOnPropertyHeldOn1958(p: us.irc.core::Asset, gain: Money, fmv: Money, basis: Money) strict {
    label en official "section 818(c)(1): gain is reduced by the appreciation existing on December 31, 1958 (never below zero)";
    when life_insurer_at_all_times_after_1958_12_31_818c1B(p);
    when gain_without_regard_to_818c_1958_property(p, gain);
    when fair_market_value_on_1958_12_31_818c1(p, fmv);
    when adjusted_basis_on_1958_12_31_818c1(p, basis);
    when fmv > basis;
    then gain_on_1958_property_818c1(p, max(0.00 USD, gain - (fmv - basis)));
}
pub relation rider_on_life_insurance_contract_818g(rider: us.irc.core::Asset) kind empirical {
    label en unofficial "the rider on a life insurance contract, whose only payments meet the requirements of section 101(g)";
}
pub relation rider_is_long_term_care_contract_7702B_818g3(rider: us.irc.core::Asset) kind empirical {
    label en unofficial "the rider is treated as a long-term care insurance contract under section 7702B";
}
pub relation qualified_accelerated_death_benefit_rider_818g2(rider: us.irc.core::Asset) kind institutional {
    label en official "a rider whose only payments meet the requirements of section 101(g), and that is not a section 7702B rider";
}
@source(IRC_S818_G, quote = "the term \"qualified accelerated death benefit rider\" means any rider on a life insurance contract if the only payments under the rider are payments meeting the requirements of section 101(g)")
rule Section818g2QualifiedAcceleratedDeathBenefitRider(rider: us.irc.core::Asset) defeasible {
    label en official "sections 818(g)(2)-(3): a rider paying only section 101(g) payments, unless it is a long-term care rider";
    when rider_on_life_insurance_contract_818g(rider);
    when not_known(rider_is_long_term_care_contract_7702B_818g3(rider));
    then qualified_accelerated_death_benefit_rider_818g2(rider);
}
pub relation reference_to_life_insurance_contract_includes_rider_818g1(rider: us.irc.core::Asset) kind institutional {
    label en official "any reference to a life insurance contract includes a reference to the qualified accelerated death benefit rider on it";
}
rule Section818g1RiderIsPartOfContract(rider: us.irc.core::Asset) defeasible {
    label en official "section 818(g)(1): the rider is treated as part of the life insurance contract";
    when qualified_accelerated_death_benefit_rider_818g2(rider);
    then reference_to_life_insurance_contract_includes_rider_818g1(rider);
}
pub relation section_807c_items_not_interest_818f3(c: Person, y: TaxableYear) kind institutional {
    label en official "for part I of subchapter N, items described in any paragraph of section 807(c) are amounts that are not interest";
}
rule Section818f3ReservesNotInterest(c: Person, y: TaxableYear) strict {
    label en official "section 818(f)(3): section 807(c) items are not interest for subchapter N part I";
    when life_insurance_company(c, y);
    then section_807c_items_not_interest_818f3(c, y);
}
