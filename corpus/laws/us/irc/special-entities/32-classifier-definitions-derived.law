// Definitions that only classified (TECH-GAPS G2221) and are now derived
// from asserted facts: qualified zone domestic trade (1355(g)(4)), secondary
// and incidental shipping activities (1356(c)(2), (d)), business development
// corporation (582(c)(2)(B)), common trust fund contributions (584(a)),
// qualifying real property loans (593(d)), insurance contracts (814(b),
// 818(d)), savings credited to subscribers (832(f)), the organization of
// 833(c)(4) and dividends to policyholders (834(e)(2)).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. A definition that lists kinds is a rule per kind over an enum or
// a flag asserted by the case; a definition with a quantity (a 95 percent
// share, a 60-day window, a 15-day limit) compares it. Evaluative elements
// ("integral part", "banks would not generally make") stay asserted facts,
// DECISION-0194 channel 2 when adjudicated; determinations the text gives
// to the Secretary are `external judgment relation`s. Relations that a
// stage-2 module used as a case input are institutional here (a case may
// still assert them directly), and the strict rules that read them are
// unchanged where the producers below are strict.

// ---- Section 1355(g)(4): qualified zone domestic trade ----

use self::{
    Contract,
    Corporation,
    IRC_S1355_G,
    IRC_S1356_C,
    IRC_S1356_D,
    IRC_S582_C,
    IRC_S584_A,
    IRC_S593_D,
    IRC_S814_B,
    IRC_S818_D,
    IRC_S832_F,
    IRC_S833_C,
    IRC_S834_E,
    Person,
    TaxableYear,
    bank,
    branch_issues_contracts_on_residents_of_contiguous_country_814b1,
    business_development_corporation_582c2Aiv,
    exempt_for_last_year_before_1987_833c2B,
    existing_blue_cross_or_blue_shield_org_833c2,
    existing_blue_cross_org_in_existence_on_1986_08_16_833c2A,
    fund_exclusively_for_collective_investment_by_fiduciary_584a1,
    gross_income_incidental_shipping_activities_1356d,
    gross_income_secondary_activities_1356c2,
    no_material_change_since_1986_08_16_833c2C,
    qualifying_real_property_loans_outstanding_593b2C,
    subscriber_savings_credited_end_of_year_832f,
    vessel_used_in_qualified_zone_domestic_trade_1355g1,
};

pub enum WaterwayKind1355g4B {
    WaterwayGreatLakes;
    WaterwayStLawrenceSeaway;
    WaterwayOther;
    label en unofficial "the waterway a place lies on";
}
@source(IRC_S1355_G, quote = "The term \"qualified zone\" means the Great Lakes Waterway and the St. Lawrence Seaway.")
pub relation place_in_waterway_1355g4B(place: us.irc.core::Asset, kind: WaterwayKind1355g4B) kind empirical {
    label en unofficial "the place lies in the waterway";
}
pub relation qualified_zone_place_1355g4B(place: us.irc.core::Asset) kind institutional {
    label en official "the place is in the qualified zone: the Great Lakes Waterway or the St. Lawrence Seaway";
}
rule Section1355g4BGreatLakes(place: us.irc.core::Asset) strict {
    label en official "section 1355(g)(4)(B): the Great Lakes Waterway";
    when place_in_waterway_1355g4B(place, WaterwayGreatLakes);
    then qualified_zone_place_1355g4B(place);
}
rule Section1355g4BStLawrence(place: us.irc.core::Asset) strict {
    label en official "section 1355(g)(4)(B): the St. Lawrence Seaway";
    when place_in_waterway_1355g4B(place, WaterwayStLawrenceSeaway);
    then qualified_zone_place_1355g4B(place);
}
@source(IRC_S1355_G, quote = "the transportation of goods or passengers between places in the qualified zone if such transportation is in the United States domestic trade")
pub relation vessel_trip_1355g4A(v: us.irc.core::Asset, y: TaxableYear, trip: us.irc.core::Transaction, origin: us.irc.core::Asset, destination: us.irc.core::Asset) kind empirical {
    label en unofficial "the vessel transports goods or passengers on the trip between the origin and the destination in the taxable year";
}
pub relation trip_in_united_states_domestic_trade_1355g4A(trip: us.irc.core::Transaction) kind empirical {
    label en unofficial "the transportation is in the United States domestic trade";
}
pub relation qualified_zone_domestic_trade_trip_1355g4A(v: us.irc.core::Asset, y: TaxableYear, trip: us.irc.core::Transaction) kind institutional {
    label en official "the trip is qualified zone domestic trade: between places in the qualified zone and in the United States domestic trade";
}
rule Section1355g4AQualifiedZoneTrip(v: us.irc.core::Asset, y: TaxableYear, trip: us.irc.core::Transaction, origin: us.irc.core::Asset, destination: us.irc.core::Asset) strict {
    label en official "section 1355(g)(4)(A): transportation of goods or passengers between places in the qualified zone in domestic trade";
    when vessel_trip_1355g4A(v, y, trip, origin, destination);
    when qualified_zone_place_1355g4B(origin);
    when qualified_zone_place_1355g4B(destination);
    when trip_in_united_states_domestic_trade_1355g4A(trip);
    then qualified_zone_domestic_trade_trip_1355g4A(v, y, trip);
}
rule Section1355g1VesselUsedInQualifiedZoneTrade(v: us.irc.core::Asset, y: TaxableYear, trip: us.irc.core::Transaction) strict {
    label en official "section 1355(g)(1): the vessel is used in qualified zone domestic trade during the taxable year when it makes a qualified zone trip";
    when qualified_zone_domestic_trade_trip_1355g4A(v, y, trip);
    then vessel_used_in_qualified_zone_domestic_trade_1355g1(v, y);
}

// ---- Section 1356(c)(2), (d): secondary and incidental activities ----

pub enum ShippingActivityKind1356 {
    ActivityCoreVesselOperation;
    ActivityManageNonQualifyingVessels;
    ActivityProvideFacilitiesOrServices;
    ActivityIntegralEquipmentOwnership;
    ActivityIntegralInlandHaulage;
    ActivityIntegralTerminalOrMaintenanceServices;
    ActivityOtherIntegral;
    ActivityPrescribedByRegulation;
    ActivityIncidental;
    label en unofficial "the kind of a shipping-related activity for section 1356: core, one of the secondary kinds of (c)(2), or an incidental activity";
}
@source(IRC_S1356_C, quote = "The term \"secondary activities\" means")
pub relation shipping_activity_income_1356(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, kind: ShippingActivityKind1356, amount: Money) kind empirical {
    label en unofficial "an activity of the corporation or its electing group with its gross income for the year, without regard to subchapter R";
}
pub relation activity_integral_to_qualifying_vessel_business_1356c2C(act: us.irc.core::Transaction) kind empirical {
    label en unofficial "the activity is an integral part of the business of operating qualifying vessels in United States foreign trade (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
pub relation activity_incidental_to_core_1356d1(act: us.irc.core::Transaction) kind empirical {
    label en unofficial "the shipping-related activity is incidental to the corporation's core qualifying activities (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
pub relation secondary_activity_item_1356c2(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "an activity that is a secondary activity, with its gross income (core qualifying activities are not secondary)";
}
@source(IRC_S1356_C, quote = "(A) the active management or operation of vessels other than qualifying vessels in the United States foreign trade,")
rule Section1356c2AManageOtherVessels(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(A): management or operation of vessels other than qualifying vessels in foreign trade";
    when shipping_activity_income_1356(c, y, act, ActivityManageNonQualifyingVessels, amount);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(B) the provision of vessel, barge, container, or cargo-related facilities or services to any person,")
rule Section1356c2BFacilitiesAndServices(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(B): provision of vessel, barge, container or cargo-related facilities or services to any person";
    when shipping_activity_income_1356(c, y, act, ActivityProvideFacilitiesOrServices, amount);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(i) ownership or operation of barges, containers, chassis, and other equipment that are the complement of, or used in connection with, a qualifying vessel in United States foreign trade,")
rule Section1356c2CiEquipment(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(C)(i): ownership or operation of barges, containers, chassis and other equipment used with a qualifying vessel, an integral activity";
    when shipping_activity_income_1356(c, y, act, ActivityIntegralEquipmentOwnership, amount);
    when activity_integral_to_qualifying_vessel_business_1356c2C(act);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(ii) the inland haulage of cargo shipped, or to be shipped, on qualifying vessels in United States foreign trade, and")
rule Section1356c2CiiInlandHaulage(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(C)(ii): inland haulage of cargo shipped on qualifying vessels";
    when shipping_activity_income_1356(c, y, act, ActivityIntegralInlandHaulage, amount);
    when activity_integral_to_qualifying_vessel_business_1356c2C(act);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(iii) the provision of terminal, maintenance, repair, logistical, or other vessel, barge, container, or cargo-related services that are an integral part of operating qualifying vessels in United States foreign trade, and")
rule Section1356c2CiiiTerminalServices(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(C)(iii): terminal, maintenance, repair, logistical or other services that are an integral part of operating qualifying vessels";
    when shipping_activity_income_1356(c, y, act, ActivityIntegralTerminalOrMaintenanceServices, amount);
    when activity_integral_to_qualifying_vessel_business_1356c2C(act);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(C) other activities of the electing corporation and other members of its electing group that are an integral part of its business of operating qualifying vessels in United States foreign trade, including—")
rule Section1356c2COtherIntegral(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(C): other activities that are an integral part of the business of operating qualifying vessels";
    when shipping_activity_income_1356(c, y, act, ActivityOtherIntegral, amount);
    when activity_integral_to_qualifying_vessel_business_1356c2C(act);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
@source(IRC_S1356_C, quote = "(D) such other activities as may be prescribed by the Secretary pursuant to regulations.")
rule Section1356c2DPrescribedByRegulation(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 1356(c)(2)(D): activities prescribed by regulations (the regulation is not in the snapshot: the kind is asserted)";
    when shipping_activity_income_1356(c, y, act, ActivityPrescribedByRegulation, amount);
    then secondary_activity_item_1356c2(c, y, act, amount);
}
pub relation secondary_gross_income_from_items_1356c2(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income of the secondary activities (a sum over derived items, TECH-GAPS G4903)";
}
rule Section1356c2SecondaryTotal(c: Corporation, y: TaxableYear, anchor: us.irc.core::Transaction, anchor_amount: Money) strict {
    label en official "section 1356(c): the secondary activities' gross income";
    when secondary_activity_item_1356c2(c, y, anchor, anchor_amount);
    then gross_income_secondary_activities_1356c2(c, y, sum all amount: Money for act: us.irc.core::Transaction where secondary_activity_item_1356c2(c, y, act, amount));
}
pub relation incidental_activity_item_1356d(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "an activity that is a shipping-related activity incidental to the core activities and not a qualifying secondary activity, with its gross income";
}
pub relation secondary_activity_marker_1356c2(act: us.irc.core::Transaction) kind institutional {
    label en official "the activity is a secondary activity (helper)";
}
rule Section1356c2Marker(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) strict {
    label en official "helper";
    when secondary_activity_item_1356c2(c, y, act, amount);
    then secondary_activity_marker_1356c2(act);
}
@source(IRC_S1356_D, quote = "(1) they are incidental to the corporation's core qualifying activities,")
rule Section1356dIncidentalActivity(c: Corporation, y: TaxableYear, act: us.irc.core::Transaction, amount: Money) defeasible {
    label en official "section 1356(d)(1), (2): a shipping-related activity incidental to core activities that is not a secondary activity";
    when shipping_activity_income_1356(c, y, act, ActivityIncidental, amount);
    when activity_incidental_to_core_1356d1(act);
    when not_known(secondary_activity_marker_1356c2(act));
    then incidental_activity_item_1356d(c, y, act, amount);
}
rule Section1356dIncidentalTotal(c: Corporation, y: TaxableYear, anchor: us.irc.core::Transaction, anchor_amount: Money) defeasible {
    label en official "section 1356(d): the incidental activities' gross income";
    when incidental_activity_item_1356d(c, y, anchor, anchor_amount);
    then gross_income_incidental_shipping_activities_1356d(c, y, sum all amount: Money for act: us.irc.core::Transaction where incidental_activity_item_1356d(c, y, act, amount));
}

// ---- Section 582(c)(2)(B): business development corporation ----

@source(IRC_S582_C, quote = "the term \"business development corporation\" means a corporation which was created by or pursuant to an act of a State legislature")
pub relation created_by_or_under_state_legislature_act_582c2B(fi: Person) kind empirical {
    label en unofficial "the corporation was created by or pursuant to an act of a State legislature";
}
pub relation created_to_promote_economy_by_loans_582c2B(fi: Person) kind empirical {
    label en unofficial "it was created for purposes of promoting, maintaining and assisting the economy and industry within the State on a regional or statewide basis by making loans to be used in trades and businesses";
}
pub relation loans_banks_would_generally_not_make_582c2B(fi: Person) kind empirical {
    label en unofficial "the loans are of a kind banks within the region or State would generally not make in the ordinary course of business (except on a partial participation basis; an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
pub relation operated_primarily_for_those_purposes_582c2B(fi: Person) kind empirical {
    label en unofficial "the corporation is operated primarily for those purposes";
}
@source(IRC_S582_C, quote = "and which is operated primarily for such purposes")
rule Section582c2BBusinessDevelopmentCorporation(fi: Person) strict {
    label en official "section 582(c)(2)(B): created by or under a State legislature's act to promote the State economy by loans banks would not generally make, and operated primarily for those purposes";
    when created_by_or_under_state_legislature_act_582c2B(fi);
    when created_to_promote_economy_by_loans_582c2B(fi);
    when loans_banks_would_generally_not_make_582c2B(fi);
    when operated_primarily_for_those_purposes_582c2B(fi);
    then business_development_corporation_582c2Aiv(fi);
}

// ---- Section 584(a)(1): the capacities of a common trust fund's contributors ----

pub enum ContributionCapacity584a1 {
    CapacityTrustee;
    CapacityExecutor;
    CapacityAdministrator;
    CapacityGuardian;
    CapacityCustodianOfQualifyingAccount;
    CapacityOther;
    label en unofficial "the capacity in which the bank contributed moneys to the fund";
}
@source(IRC_S584_A, quote = "exclusively for the collective investment and reinvestment of moneys contributed thereto by the bank in its capacity")
pub relation fund_contribution_584a1(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset, capacity: ContributionCapacity584a1) kind empirical {
    label en unofficial "moneys contributed to the fund by the bank, from the account, in this capacity";
}
@source(IRC_S584_A, quote = "which the Secretary determines are established pursuant to a State law which is substantially similar to the Uniform Gifts to Minors Act as published by the American Law Institute")
external judgment relation secretary_determines_ugma_like_state_law_584a1Bi(account: us.irc.core::Asset) {
    authority Secretary;
    label en official "the Secretary determines that the custodial account is established under a State law substantially similar to the Uniform Gifts to Minors Act (section 584(a)(1)(B)(i); DECISION-0194 channel 1)";
}
@source(IRC_S584_A, quote = "with respect to which the bank establishes, to the satisfaction of the Secretary, that it has duties and responsibilities similar to duties and responsibilities of a trustee or guardian")
external judgment relation bank_establishes_trustee_like_duties_to_secretary_584a1Bii(b: Person, account: us.irc.core::Asset) {
    authority Secretary;
    label en official "the bank establishes, to the satisfaction of the Secretary, duties and responsibilities similar to those of a trustee or guardian (section 584(a)(1)(B)(ii); DECISION-0194 channel 1)";
}
pub relation fiduciary_contribution_584a1(f: Person, b: Person, item: us.irc.core::Payment) kind institutional {
    label en official "a contribution the bank made as trustee, executor, administrator or guardian, or as custodian of a qualifying account (Secretary's determination and the bank's showing both present)";
}
@source(IRC_S584_A, quote = "(A) as a trustee, executor, administrator, or guardian, or")
rule Section584a1ATrustee(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) strict {
    label en official "section 584(a)(1)(A): as a trustee";
    when fund_contribution_584a1(f, b, item, account, CapacityTrustee);
    then fiduciary_contribution_584a1(f, b, item);
}
rule Section584a1AExecutor(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) strict {
    label en official "section 584(a)(1)(A): as an executor";
    when fund_contribution_584a1(f, b, item, account, CapacityExecutor);
    then fiduciary_contribution_584a1(f, b, item);
}
rule Section584a1AAdministrator(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) strict {
    label en official "section 584(a)(1)(A): as an administrator";
    when fund_contribution_584a1(f, b, item, account, CapacityAdministrator);
    then fiduciary_contribution_584a1(f, b, item);
}
rule Section584a1AGuardian(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) strict {
    label en official "section 584(a)(1)(A): as a guardian";
    when fund_contribution_584a1(f, b, item, account, CapacityGuardian);
    then fiduciary_contribution_584a1(f, b, item);
}
@source(IRC_S584_A, quote = "(B) as a custodian of accounts—")
rule Section584a1BCustodian(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) strict {
    label en official "section 584(a)(1)(B): as a custodian of accounts under a State law substantially similar to the Uniform Gifts to Minors Act, with duties similar to a trustee's";
    when fund_contribution_584a1(f, b, item, account, CapacityCustodianOfQualifyingAccount);
    when secretary_determines_ugma_like_state_law_584a1Bi(account);
    when bank_establishes_trustee_like_duties_to_secretary_584a1Bii(b, account);
    then fiduciary_contribution_584a1(f, b, item);
}
pub relation non_fiduciary_contribution_584a1(f: Person, item: us.irc.core::Payment) kind institutional {
    label en official "a contribution in a capacity outside (A) and (B), or a custodial contribution without the Secretary's determination or the bank's showing";
}
rule Section584a1OtherCapacity(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) defeasible {
    label en official "section 584(a)(1): a contribution in another capacity";
    when fund_contribution_584a1(f, b, item, account, CapacityOther);
    then non_fiduciary_contribution_584a1(f, item);
}
rule Section584a1CustodianWithoutDetermination(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset) defeasible {
    label en official "section 584(a)(1)(B): a custodian contribution that lacks the Secretary's determination or the bank's showing is not a fiduciary contribution";
    when fund_contribution_584a1(f, b, item, account, CapacityCustodianOfQualifyingAccount);
    when not_known(fiduciary_contribution_584a1(f, b, item));
    then non_fiduciary_contribution_584a1(f, item);
}
@source(IRC_S584_A, quote = "exclusively for the collective investment and reinvestment of moneys contributed thereto by the bank in its capacity")
rule Section584a1Exclusively(f: Person, b: Person, item: us.irc.core::Payment, account: us.irc.core::Asset, capacity: ContributionCapacity584a1) defeasible {
    label en official "section 584(a)(1): the fund holds only contributions the bank made in the listed fiduciary capacities";
    when fund_contribution_584a1(f, b, item, account, capacity);
    when fiduciary_contribution_584a1(f, b, item);
    when not_known(has_non_fiduciary_contribution_584a1(f));
    then fund_exclusively_for_collective_investment_by_fiduciary_584a1(f);
}
pub relation has_non_fiduciary_contribution_584a1(f: Person) kind institutional {
    label en official "the fund holds a non-fiduciary contribution (helper)";
}
rule Section584a1HasNonFiduciary(f: Person, item: us.irc.core::Payment) defeasible {
    label en official "helper";
    when non_fiduciary_contribution_584a1(f, item);
    then has_non_fiduciary_contribution_584a1(f);
}

// ---- Section 593(d): loans defined ----

pub relation loan_of_593d(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "a loan of the taxpayer outstanding at the close of the taxable year, with its amount (a loan is debt as used in section 166: an input from us.irc.deductions)";
}
pub relation loan_secured_by_improved_real_property_593d1(loan: us.irc.core::Asset) kind empirical {
    label en unofficial "the loan is secured by an interest in improved real property";
}
pub relation loan_secured_by_real_property_to_be_improved_593d1(loan: us.irc.core::Asset) kind empirical {
    label en unofficial "the loan is secured by an interest in real property which is to be improved out of the proceeds of the loan";
}
pub relation loan_evidenced_by_security_165g2C_593d1A(loan: us.irc.core::Asset) kind empirical {
    label en unofficial "the loan is evidenced by a security (section 165(g)(2)(C))";
}
pub relation primary_obligor_593d1B(loan: us.irc.core::Asset, obligor: Person) kind empirical {
    label en unofficial "the primary obligor on the loan";
}
pub relation government_or_instrumentality_593d1Bi(p: Person) kind empirical {
    label en unofficial "the person is a government or political subdivision or instrumentality of one";
}
pub relation same_affiliated_group_593d1Biii(i: Person, obligor: Person) kind institutional {
    label en official "the obligor is another member of the taxpayer's affiliated group, with more than 50 percent replacing 80 percent and all corporations includible (one-hop ownership over ownership_interest, TECH-GAPS G4900 class)";
}
rule Section593d1BiiiTaxpayerOwnsObligor(i: Person, obligor: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) strict {
    label en official "section 593(d)(1)(B)(iii): the taxpayer owns more than 50 percent of the obligor";
    when us.irc.core::ownership_interest(oi, i, obligor, share);
    when share > 0.50;
    then same_affiliated_group_593d1Biii(i, obligor);
}
rule Section593d1BiiiObligorOwnsTaxpayer(i: Person, obligor: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) strict {
    label en official "section 593(d)(1)(B)(iii): the obligor owns more than 50 percent of the taxpayer";
    when us.irc.core::ownership_interest(oi, obligor, i, share);
    when share > 0.50;
    then same_affiliated_group_593d1Biii(i, obligor);
}
rule Section593d1BiiiCommonParent(i: Person, obligor: Person, parent: Person, s1: Decimal, s2: Decimal, oi1: us.irc.core::OwnershipInterest, oi2: us.irc.core::OwnershipInterest) strict {
    label en official "section 593(d)(1)(B)(iii): a common parent owns more than 50 percent of both";
    when us.irc.core::ownership_interest(oi1, parent, i, s1);
    when us.irc.core::ownership_interest(oi2, parent, obligor, s2);
    when s1 > 0.50;
    when s2 > 0.50;
    then same_affiliated_group_593d1Biii(i, obligor);
}
pub relation loan_excluded_by_obligor_593d1B(i: Person, loan: us.irc.core::Asset) kind institutional {
    label en official "the primary obligor is a government, a bank or another member of the affiliated group";
}
@source(IRC_S593_D, quote = "(i) a government or political subdivision or instrumentality thereof;")
rule Section593d1BiGovernmentObligor(i: Person, loan: us.irc.core::Asset, obligor: Person) strict {
    label en official "section 593(d)(1)(B)(i): a government or political subdivision or instrumentality";
    when loan_of_593d(i, _, loan, _);
    when primary_obligor_593d1B(loan, obligor);
    when government_or_instrumentality_593d1Bi(obligor);
    then loan_excluded_by_obligor_593d1B(i, loan);
}
@source(IRC_S593_D, quote = "(ii) a bank (as defined in section 581); or")
rule Section593d1BiiBankObligor(i: Person, loan: us.irc.core::Asset, obligor: Person) strict {
    label en official "section 593(d)(1)(B)(ii): a bank as defined in section 581";
    when loan_of_593d(i, _, loan, _);
    when primary_obligor_593d1B(loan, obligor);
    when bank(obligor);
    then loan_excluded_by_obligor_593d1B(i, loan);
}
@source(IRC_S593_D, quote = "(iii) another member of the same affiliated group;")
rule Section593d1BiiiAffiliatedObligor(i: Person, loan: us.irc.core::Asset, obligor: Person) strict {
    label en official "section 593(d)(1)(B)(iii): another member of the same affiliated group";
    when loan_of_593d(i, _, loan, _);
    when primary_obligor_593d1B(loan, obligor);
    when same_affiliated_group_593d1Biii(i, obligor);
    then loan_excluded_by_obligor_593d1B(i, loan);
}
pub relation amount_secured_by_deposit_or_share_593d1C(loan: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the part of the loan secured by a deposit in or share of the taxpayer";
}
pub relation loan_made_or_acquired_on_593d1D(loan: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the loan was made or acquired on this date";
}
pub relation loan_repaid_or_disposed_of_on_593d1D(loan: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the loan was repaid or disposed of on this date";
}
pub relation creditor_taxable_year_593d1D(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year is a taxable year of the creditor";
}
pub relation transactions_bona_fide_business_purposes_593d1D(loan: us.irc.core::Asset) kind empirical {
    label en unofficial "the transactions by which the loan was made or acquired and then repaid or disposed of are established to be for bona fide business purposes (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
pub relation loan_churned_across_year_end_593d1D(i: Person, loan: us.irc.core::Asset) kind institutional {
    label en official "the loan was made or acquired and then repaid or disposed of within a 60-day period beginning in one taxable year of the creditor and ending in its next taxable year";
}
@source(IRC_S593_D, quote = "any loan which, within a 60-day period beginning in one taxable year of the creditor and ending in its next taxable year, is made or acquired and then repaid or disposed of")
rule Section593d1DChurn(i: Person, loan: us.irc.core::Asset, y1: TaxableYear, made: Date, repaid: Date, year_end: Date) strict {
    label en official "section 593(d)(1)(D): made or acquired in one taxable year and repaid or disposed of in the next, within 60 days";
    when loan_made_or_acquired_on_593d1D(loan, made);
    when loan_repaid_or_disposed_of_on_593d1D(loan, repaid);
    when creditor_taxable_year_593d1D(i, y1);
    when us.irc.core::ends(y1, year_end);
    when made <= year_end;
    when repaid > year_end;
    when add_calendar_period(made, 60 calendar_day) >= repaid;
    then loan_churned_across_year_end_593d1D(i, loan);
}
pub relation loan_excluded_by_churn_593d1D(i: Person, loan: us.irc.core::Asset) kind institutional {
    label en official "the loan is excluded by subparagraph (D): churned across the year end without established bona fide business purposes";
}
@source(IRC_S593_D, quote = "unless the transactions by which such loan was made or acquired and then repaid or disposed of are established to be for bona fide business purposes")
rule Section593d1DExcluded(i: Person, loan: us.irc.core::Asset) defeasible {
    label en official "section 593(d)(1)(D): churned loans are excluded unless bona fide business purposes are established";
    when loan_churned_across_year_end_593d1D(i, loan);
    when not_known(transactions_bona_fide_business_purposes_593d1D(loan));
    then loan_excluded_by_churn_593d1D(i, loan);
}
pub relation qualifying_real_property_loan_amount_593d1(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the amount of the loan that is a qualifying real property loan: secured by improved (or to-be-improved) real property, not evidenced by a security, not owed by a government, a bank or an affiliate, not churned, and not to the extent secured by a deposit or share of the taxpayer";
}
@source(IRC_S593_D, quote = "The term \"qualifying real property loan\" means any loan secured by an interest in improved real property or secured by an interest in real property which is to be improved out of the proceeds of the loan")
rule Section593d1QualifyingLoanNoDepositSecurity(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 593(d)(1): a loan secured by improved real property, with no exclusion and no deposit security";
    when loan_of_593d(i, y, loan, amount);
    when loan_secured_by_improved_real_property_593d1(loan);
    when not_known(loan_evidenced_by_security_165g2C_593d1A(loan));
    when not_known(loan_excluded_by_obligor_593d1B(i, loan));
    when not_known(loan_excluded_by_churn_593d1D(i, loan));
    when not_known(deposit_secured_amount_stated_593d1C(loan));
    then qualifying_real_property_loan_amount_593d1(i, y, loan, amount);
}
rule Section593d1QualifyingLoanToBeImproved(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 593(d)(1): a loan secured by real property to be improved out of the loan proceeds, with no exclusion and no deposit security";
    when loan_of_593d(i, y, loan, amount);
    when loan_secured_by_real_property_to_be_improved_593d1(loan);
    when not_known(loan_evidenced_by_security_165g2C_593d1A(loan));
    when not_known(loan_excluded_by_obligor_593d1B(i, loan));
    when not_known(loan_excluded_by_churn_593d1D(i, loan));
    when not_known(deposit_secured_amount_stated_593d1C(loan));
    then qualifying_real_property_loan_amount_593d1(i, y, loan, amount);
}
pub relation deposit_secured_amount_stated_593d1C(loan: us.irc.core::Asset) kind institutional {
    label en official "a part secured by a deposit or share of the taxpayer is stated for the loan (helper)";
}
rule Section593d1CDepositStated(loan: us.irc.core::Asset, amount: Money) strict {
    label en official "helper";
    when amount_secured_by_deposit_or_share_593d1C(loan, amount);
    then deposit_secured_amount_stated_593d1C(loan);
}
@source(IRC_S593_D, quote = "(C) any loan, to the extent secured by a deposit in or share of the taxpayer; or")
rule Section593d1CLoanNetOfDepositSecurity(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, secured: Money) defeasible {
    label en official "section 593(d)(1)(C): a loan is a qualifying real property loan only to the extent not secured by a deposit in or share of the taxpayer";
    when loan_of_593d(i, y, loan, amount);
    when loan_secured_by_improved_real_property_593d1(loan);
    when amount_secured_by_deposit_or_share_593d1C(loan, secured);
    when not_known(loan_evidenced_by_security_165g2C_593d1A(loan));
    when not_known(loan_excluded_by_obligor_593d1B(i, loan));
    when not_known(loan_excluded_by_churn_593d1D(i, loan));
    then qualifying_real_property_loan_amount_593d1(i, y, loan, amount - secured);
}
pub relation remic_interest_593d4(i: Person, y: TaxableYear, interest: us.irc.core::Asset, remic: us.irc.core::Asset, value: Money) kind empirical {
    label en unofficial "a regular or residual interest of the taxpayer in the REMIC, at this value";
}
pub relation remic_qualifying_assets_share_593d4(remic: us.irc.core::Asset, share: Decimal) kind empirical {
    label en unofficial "the share of the REMIC's assets that are qualifying real property loans, determined as if the taxpayer held the assets (tiered REMICs are treated as one and interests in other REMICs are looked through by the case)";
}
@source(IRC_S593_D, quote = "A regular or residual interest in a REMIC shall be treated as a qualifying real property loan; except that, if less than 95 percent of the assets of such REMIC are qualifying real property loans")
rule Section593d4RemicInterestFull(i: Person, y: TaxableYear, interest: us.irc.core::Asset, remic: us.irc.core::Asset, value: Money, share: Decimal) strict {
    label en official "section 593(d)(4): a REMIC interest is a qualifying real property loan in full when at least 95 percent of the REMIC's assets are qualifying loans";
    when remic_interest_593d4(i, y, interest, remic, value);
    when remic_qualifying_assets_share_593d4(remic, share);
    when share >= 0.95;
    then qualifying_real_property_loan_amount_593d1(i, y, interest, value);
}
rule Section593d4RemicInterestProportion(i: Person, y: TaxableYear, interest: us.irc.core::Asset, remic: us.irc.core::Asset, value: Money, share: Decimal) strict {
    label en official "section 593(d)(4): below 95 percent the interest qualifies only in the proportion of qualifying assets (cents HALF_UP is a JUDGMENT CALL)";
    when remic_interest_593d4(i, y, interest, remic, value);
    when remic_qualifying_assets_share_593d4(remic, share);
    when share < 0.95;
    then qualifying_real_property_loan_amount_593d1(i, y, interest, round(value * share, 2, "HALF_UP"));
}
pub relation nonqualifying_loan_593d2(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "a loan that is not a qualifying real property loan";
}
@source(IRC_S593_D, quote = "The term \"nonqualifying loan\" means any loan which is not a qualifying real property loan.")
rule Section593d2NonqualifyingLoan(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) defeasible {
    label en official "section 593(d)(2): a loan with no qualifying amount";
    when loan_of_593d(i, y, loan, amount);
    when not_known(qualifying_real_property_loan_amount_593d1(i, y, loan, amount));
    then nonqualifying_loan_593d2(i, y, loan, amount);
}
pub relation qualifying_real_property_loans_total_593d(i: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the qualifying real property loans outstanding at the close of the year (a sum over derived items, TECH-GAPS G4903)";
}
rule Section593dQualifyingTotal(i: Person, y: TaxableYear, anchor: us.irc.core::Asset, anchor_amount: Money) defeasible {
    label en official "section 593(d): the sum of the qualifying loan amounts";
    when qualifying_real_property_loan_amount_593d1(i, y, anchor, anchor_amount);
    then qualifying_real_property_loans_total_593d(i, y, sum all amount: Money for loan: us.irc.core::Asset where qualifying_real_property_loan_amount_593d1(i, y, loan, amount));
}
rule Section593dTotalFeedsOutstanding(i: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 593(b)(2)(C): the derived total is the qualifying real property loans outstanding";
    when qualifying_real_property_loans_total_593d(i, y, total);
    then qualifying_real_property_loans_outstanding_593b2C(i, y, total);
}

// ---- Sections 814(b), 818(d): insurance contracts ----

pub enum InsuranceContractKind814b {
    ContractLife;
    ContractHealth;
    ContractAccident;
    ContractAnnuity;
    ContractReinsurance;
    ContractOther;
    label en unofficial "the kind of a contract for the definitions of insurance contract";
}
@source(IRC_S814_B, quote = "the term \"insurance contract\" means any life, health, accident, or annuity contract or reinsurance contract or any contract relating thereto")
pub relation contract_kind_814b(k: Contract, kind: InsuranceContractKind814b) kind empirical {
    label en unofficial "the contract is of this kind";
}
pub relation contract_relates_to_814b(k: Contract, main: Contract) kind empirical {
    label en unofficial "the contract relates to the other contract";
}
pub relation insurance_contract_814b(k: Contract) kind institutional {
    label en official "the contract is an insurance contract for section 814: a life, health, accident, annuity or reinsurance contract, or any contract relating to one";
}
rule Section814bInsuranceContractLife(k: Contract) strict {
    label en official "section 814(b): a life contract";
    when contract_kind_814b(k, ContractLife);
    then insurance_contract_814b(k);
}
rule Section814bInsuranceContractHealth(k: Contract) strict {
    label en official "section 814(b): a health contract";
    when contract_kind_814b(k, ContractHealth);
    then insurance_contract_814b(k);
}
rule Section814bInsuranceContractAccident(k: Contract) strict {
    label en official "section 814(b): an accident contract";
    when contract_kind_814b(k, ContractAccident);
    then insurance_contract_814b(k);
}
rule Section814bInsuranceContractAnnuity(k: Contract) strict {
    label en official "section 814(b): an annuity contract";
    when contract_kind_814b(k, ContractAnnuity);
    then insurance_contract_814b(k);
}
rule Section814bInsuranceContractReinsurance(k: Contract) strict {
    label en official "section 814(b): a reinsurance contract";
    when contract_kind_814b(k, ContractReinsurance);
    then insurance_contract_814b(k);
}
rule Section814bInsuranceContractRelating(k: Contract, main: Contract) strict {
    label en official "section 814(b): a contract relating to an insurance contract (one hop)";
    when contract_relates_to_814b(k, main);
    when insurance_contract_814b_base(main);
    then insurance_contract_814b(k);
}
pub relation insurance_contract_814b_base(k: Contract) kind institutional {
    label en official "a life, health, accident, annuity or reinsurance contract (before the 'relating thereto' extension)";
}
rule Section814bBaseLife(k: Contract) strict {
    label en official "base kind: life";
    when contract_kind_814b(k, ContractLife);
    then insurance_contract_814b_base(k);
}
rule Section814bBaseHealth(k: Contract) strict {
    label en official "base kind: health";
    when contract_kind_814b(k, ContractHealth);
    then insurance_contract_814b_base(k);
}
rule Section814bBaseAccident(k: Contract) strict {
    label en official "base kind: accident";
    when contract_kind_814b(k, ContractAccident);
    then insurance_contract_814b_base(k);
}
rule Section814bBaseAnnuity(k: Contract) strict {
    label en official "base kind: annuity";
    when contract_kind_814b(k, ContractAnnuity);
    then insurance_contract_814b_base(k);
}
rule Section814bBaseReinsurance(k: Contract) strict {
    label en official "base kind: reinsurance";
    when contract_kind_814b(k, ContractReinsurance);
    then insurance_contract_814b_base(k);
}
pub relation branch_issued_contract_814b1(br: Person, k: Contract) kind empirical {
    label en unofficial "the branch issued the contract";
}
pub relation contract_insures_life_or_health_of_contiguous_country_resident_814b1(k: Contract) kind empirical {
    label en unofficial "the contract insures risks in connection with the lives or health of residents of a country contiguous to the United States";
}
@source(IRC_S814_B, quote = "insurance contracts insuring risks in connection with the lives or health of residents of a country which is contiguous to the United States")
rule Section814b1BranchIssuesContiguousResidentContracts(br: Person, k: Contract) strict {
    label en official "section 814(b)(1): the branch issues insurance contracts on the lives or health of residents of a contiguous country";
    when branch_issued_contract_814b1(br, k);
    when insurance_contract_814b(k);
    when contract_insures_life_or_health_of_contiguous_country_resident_814b1(k);
    then branch_issues_contracts_on_residents_of_contiguous_country_814b1(br);
}
pub relation contract_supplementary_to_818d(k: Contract, main: Contract) kind empirical {
    label en unofficial "the contract is supplementary to the insurance or annuity contract";
}
pub relation insurance_or_annuity_contract_818d(k: Contract) kind institutional {
    label en official "the contract is an insurance or annuity contract for the part: a life, annuity or other insurance contract, or a contract supplementary to one (one hop; no rule of the part reads it yet, TECH-GAPS G4913)";
}
rule Section818dBase(k: Contract) strict {
    label en official "section 818(d): an insurance or annuity contract";
    when insurance_contract_814b_base(k);
    then insurance_or_annuity_contract_818d(k);
}
@source(IRC_S818_D, quote = "the term \"insurance or annuity contract\" includes any contract supplementary thereto")
rule Section818dSupplementary(k: Contract, main: Contract) strict {
    label en official "section 818(d): a contract supplementary to an insurance or annuity contract is one";
    when contract_supplementary_to_818d(k, main);
    when insurance_contract_814b_base(main);
    then insurance_or_annuity_contract_818d(k);
}

// ---- Section 832(f): savings credited to subscriber accounts ----

pub relation subscriber_account_credit_832f(c: Person, y: TaxableYear, account: us.irc.core::Asset, credited_on: Date, amount: Money) kind empirical {
    label en unofficial "a portion of the surplus credited to the individual account of a subscriber, on this date";
}
pub relation obligated_to_pay_promptly_on_termination_832f(account: us.irc.core::Asset) kind empirical {
    label en unofficial "the company would be obligated to pay the amount promptly to the subscriber if he terminated his contract at the close of the company's taxable year";
}
pub relation subscriber_savings_credited_item_832f(c: Person, y: TaxableYear, account: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "savings credited to a subscriber account: credited before the 16th day of the 3rd month following the close of the taxable year, and payable promptly on termination at the close of the year";
}
@source(IRC_S832_F, quote = "such portion of the surplus as is credited to the individual accounts of subscribers before the 16th day of the 3rd month following the close of the taxable year, but only if the company would be obligated to pay such amount promptly to such subscriber if he terminated his contract at the close of the company's taxable year")
rule Section832fSavingsCredited(c: Person, y: TaxableYear, account: us.irc.core::Asset, credited: Date, amount: Money, year_end: Date) strict {
    label en official "section 832(f): credited before the 16th day of the 3rd month after year end (first day of the next month + 2 calendar months + 15 days), and payable on termination";
    when subscriber_account_credit_832f(c, y, account, credited, amount);
    when obligated_to_pay_promptly_on_termination_832f(account);
    when us.irc.core::ends(y, year_end);
    when credited < add_calendar_period(add_calendar_period(add_calendar_period(year_end, 1 calendar_day), 2 calendar_month), 15 calendar_day);
    then subscriber_savings_credited_item_832f(c, y, account, amount);
}
pub relation subscriber_savings_credited_total_832f(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the savings credited to subscriber accounts for the year (a sum over derived items, TECH-GAPS G4903)";
}
rule Section832fSavingsTotal(c: Person, y: TaxableYear, anchor: us.irc.core::Asset, anchor_amount: Money) strict {
    label en official "section 832(f): the sum of the savings credited";
    when subscriber_savings_credited_item_832f(c, y, anchor, anchor_amount);
    then subscriber_savings_credited_total_832f(c, y, sum all amount: Money for account: us.irc.core::Asset where subscriber_savings_credited_item_832f(c, y, account, amount));
}
rule Section832fSavingsTotalIsEndOfYear(c: Person, y: TaxableYear, total: Money) strict {
    label en official "section 832(f): the derived total is the savings credited at the end of the year";
    when subscriber_savings_credited_total_832f(c, y, total);
    then subscriber_savings_credited_end_of_year_832f(c, y, total);
}

// ---- Section 833(c)(4): organizations treated as Blue Cross or Blue Shield ----

pub relation organized_under_state_law_exclusive_to_not_for_profit_health_833c4Bi(o: Person) kind empirical {
    label en unofficial "the organization is organized under, and governed by, State laws specifically and exclusively applicable to not-for-profit health insurance or health service type organizations";
}
pub relation is_blue_cross_blue_shield_or_hmo_833c4Bii(o: Person) kind empirical {
    label en unofficial "the organization is a Blue Cross or Blue Shield organization or a health maintenance organization";
}
pub relation organization_described_in_833c4B(o: Person) kind institutional {
    label en official "an organization described in section 833(c)(4)(B)";
}
@source(IRC_S833_C, quote = "is organized under, and governed by, State laws which are specifically and exclusively applicable to not-for-profit health insurance or health service type organizations")
rule Section833c4BOrganization(o: Person) defeasible {
    label en official "section 833(c)(4)(B): organized under State laws exclusive to not-for-profit health insurance organizations, and not a Blue Cross or Blue Shield organization or an HMO";
    when organized_under_state_law_exclusive_to_not_for_profit_health_833c4Bi(o);
    when not_known(is_blue_cross_blue_shield_or_hmo_833c4Bii(o));
    then organization_described_in_833c4B(o);
}
@source(IRC_S833_C, quote = "Paragraph (2) shall be applied to an organization described in subparagraph (B) as if it were a Blue Cross or Blue Shield organization.")
rule Section833c4AAppliesParagraph2(o: Person, y: TaxableYear) defeasible {
    label en official "section 833(c)(4)(A): paragraph (2) is applied to such an organization as if it were a Blue Cross or Blue Shield organization";
    when organization_described_in_833c4B(o);
    when existing_blue_cross_org_in_existence_on_1986_08_16_833c2A(o);
    when exempt_for_last_year_before_1987_833c2B(o);
    when no_material_change_since_1986_08_16_833c2C(o, y);
    then existing_blue_cross_or_blue_shield_org_833c2(o, y);
}

// ---- Section 834(e)(2): dividends to policyholders ----

pub enum BooksMethod834e2 {
    BooksMethodPaid;
    BooksMethodDeclared;
    label en unofficial "the method regularly employed by the company in keeping its books: on dividends paid, or on dividends declared";
}
@source(IRC_S834_E, quote = "The term \"dividends to policyholders\" means dividends and similar distributions paid or declared to policyholders.")
pub relation distribution_to_policyholders_834e2(c: Person, item: us.irc.core::Payment, paid_on: Date, declared_on: Date, amount: Money) kind empirical {
    label en unofficial "a dividend or similar distribution to policyholders, with the date it was paid and the date it was declared";
}
pub relation regular_books_method_834e2(c: Person, method: BooksMethod834e2) kind empirical {
    label en unofficial "the method regularly employed in keeping the company's books";
}
pub relation dividends_to_policyholders_834e2(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a dividend to policyholders for the taxable year: paid or declared in the year according to the company's regular books method";
}
@source(IRC_S834_E, quote = "the term \"paid or declared\" shall be construed according to the method regularly employed in keeping the books of the insurance company")
rule Section834e2PaidMethod(c: Person, y: TaxableYear, item: us.irc.core::Payment, paid: Date, declared: Date, amount: Money, begins_on: Date, ends_on: Date) strict {
    label en official "section 834(e)(2): under a paid method the dividend belongs to the year in which it was paid";
    when distribution_to_policyholders_834e2(c, item, paid, declared, amount);
    when regular_books_method_834e2(c, BooksMethodPaid);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    when paid >= begins_on;
    when paid <= ends_on;
    then dividends_to_policyholders_834e2(c, y, item, amount);
}
rule Section834e2DeclaredMethod(c: Person, y: TaxableYear, item: us.irc.core::Payment, paid: Date, declared: Date, amount: Money, begins_on: Date, ends_on: Date) strict {
    label en official "section 834(e)(2): under a declared method the dividend belongs to the year in which it was declared";
    when distribution_to_policyholders_834e2(c, item, paid, declared, amount);
    when regular_books_method_834e2(c, BooksMethodDeclared);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::ends(y, ends_on);
    when declared >= begins_on;
    when declared <= ends_on;
    then dividends_to_policyholders_834e2(c, y, item, amount);
}
