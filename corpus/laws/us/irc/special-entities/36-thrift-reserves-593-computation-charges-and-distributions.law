// Section 593(b)(2)(D), (c)(3), (e) (thrift institutions: the computation of
// taxable income for the 8 percent method, the charging of worthless debts
// to the reserves, and distributions to shareholders). Stage 3 (IRC-09
// stage 3, TECH_GAP reduction), 26.09.2026. Status implemented_unverified;
// nothing here was executed. The reserve method ended for taxable years
// beginning after 1995 (section 593(f)); these rules are the historical
// text as pinned.
//
// METHOD. The taxable income of (b)(2)(D) is an arithmetic over asserted
// components (the base taxable income is computed elsewhere without the bad
// debt reserve deduction; the capital gain rate differential of section
// 904(b)(3) is an asserted fraction because section 904 is owned by
// us.irc.international). The ordering of (e)(1) is a fixed sequence of
// stages (earnings, then the (g)(2)(A)(ii) balance, then the supplemental
// reserve, then other accounts; the order of the balances and earnings is
// reversed for redemptions and liquidations); each stage absorbs up to its
// balance, in distribution terms (a reserve balance is worth its amount
// less the tax on including it: the highest section 11(b) rate of
// us.irc.corporations is used, a JUDGMENT CALL). The amount charged to a
// reserve is the portion grossed up for that tax, cents HALF_UP.

// ---- Section 593(b)(2)(D): computation of taxable income ----

use self::{
    IRC_S593_B,
    IRC_S593_C,
    IRC_S593_E,
    Person,
    TaxableYear,
    nonqualifying_loan_593d2,
    qualifying_real_property_loan_amount_593d1,
    taxable_income_for_593b2A,
};

@source(IRC_S593_B, quote = "(ii) without regard to any deduction allowable for any addition to the reserve for bad debts,")
pub relation taxable_income_base_593b2D(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "taxable income computed without regard to any deduction allowable for any addition to the reserve for bad debts (clause (ii)); the other adjustments below are applied to it";
}
pub relation amounts_included_by_reason_of_593e_593b2Di(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts included in gross income by reason of subsection (e)";
}
pub relation net_gain_on_stock_or_section_103_obligations_593b2Diii(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net gain for the taxable year from the sale or exchange of stock of a corporation or of obligations the interest on which is excludable under section 103";
}
pub relation part_viii_dividends_593b2Div(i: Person, y: TaxableYear, dividends: Money, deduction: Money) kind empirical {
    label en unofficial "the dividends with respect to which a deduction is allowable by part VIII of subchapter B, and the dividends received deduction for the taxable year";
}
pub relation capital_gain_rate_differential_fraction_593b2Dv(i: Person, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the rate differential portion (section 904(b)(3)(E)) as a fraction of a capital gain, where a capital gain rate differential (section 904(b)(3)(D)) exists for the year (section 904 is not imported: asserted)";
}
pub relation net_long_term_capital_gain_593b2DvI(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net long-term capital gain for the taxable year";
}
pub relation net_long_term_capital_gain_other_593b2DvII(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net long-term capital gain for the taxable year from the sale or exchange of property other than stock or section 103 obligations";
}
pub relation dividend_exclusion_593b2Div(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the part VIII dividends excluded from gross income, reduced by 8 percent of the dividends received deduction (cents HALF_UP is a JUDGMENT CALL)";
}
@source(IRC_S593_B, quote = "(iv) by excluding from gross income dividends with respect to which a deduction is allowable by part VIII of subchapter B, reduced by an amount equal to 8 percent of the dividends received deduction for the taxable year, and")
rule Section593b2DivDividendExclusion(i: Person, y: TaxableYear, dividends: Money, deduction: Money) strict {
    label en official "section 593(b)(2)(D)(iv): dividends less 8 percent of the dividends received deduction";
    when part_viii_dividends_593b2Div(i, y, dividends, deduction);
    then dividend_exclusion_593b2Div(i, y, dividends - round(deduction * 8 percent, 2, "HALF_UP"));
}
pub relation rate_differential_exclusion_593b2Dv(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the rate differential portion of the lesser of the two net long-term capital gains";
}
@source(IRC_S593_B, quote = "the rate differential portion (within the meaning of section 904(b)(3)(E)) of the lesser of")
rule Section593b2DvRateDifferential(i: Person, y: TaxableYear, fraction: Decimal, all_ltcg: Money, other_ltcg: Money) strict {
    label en official "section 593(b)(2)(D)(v): the rate differential portion of the lesser of subclauses (I) and (II) (cents HALF_UP is a JUDGMENT CALL)";
    when capital_gain_rate_differential_fraction_593b2Dv(i, y, fraction);
    when net_long_term_capital_gain_593b2DvI(i, y, all_ltcg);
    when net_long_term_capital_gain_other_593b2DvII(i, y, other_ltcg);
    then rate_differential_exclusion_593b2Dv(i, y, round(min(all_ltcg, other_ltcg) * fraction, 2, "HALF_UP"));
}
pub relation section_593b2D_adjusted_ti_ready(i: Person, y: TaxableYear) kind institutional {
    label en official "every adjustment input of clauses (i)-(iv) is supplied (helper)";
}
rule Section593b2DAdjustedIncomeWithDifferential(i: Person, y: TaxableYear, base: Money, incl_e: Money, gain: Money, div_excl: Money, differential: Money) strict {
    label en official "section 593(b)(2)(D): the base taxable income less the subsection (e) inclusions, the net gain on stock and section 103 obligations, the excluded dividends, and the rate differential portion";
    when taxable_income_base_593b2D(i, y, base);
    when amounts_included_by_reason_of_593e_593b2Di(i, y, incl_e);
    when net_gain_on_stock_or_section_103_obligations_593b2Diii(i, y, gain);
    when dividend_exclusion_593b2Div(i, y, div_excl);
    when rate_differential_exclusion_593b2Dv(i, y, differential);
    then taxable_income_for_593b2A(i, y, (((base - incl_e) - gain) - div_excl) - differential);
}
rule Section593b2DAdjustedIncomeWithoutDifferential(i: Person, y: TaxableYear, base: Money, incl_e: Money, gain: Money, div_excl: Money) defeasible {
    label en official "section 593(b)(2)(D): with no capital gain rate differential clause (v) does not apply";
    when taxable_income_base_593b2D(i, y, base);
    when amounts_included_by_reason_of_593e_593b2Di(i, y, incl_e);
    when net_gain_on_stock_or_section_103_obligations_593b2Diii(i, y, gain);
    when dividend_exclusion_593b2Div(i, y, div_excl);
    when not_known(capital_gain_rate_differential_stated_593b2Dv(i, y));
    then taxable_income_for_593b2A(i, y, ((base - incl_e) - gain) - div_excl);
}
pub relation capital_gain_rate_differential_stated_593b2Dv(i: Person, y: TaxableYear) kind institutional {
    label en official "a capital gain rate differential fraction is stated for the year (helper)";
}
rule Section593b2DvDifferentialStated(i: Person, y: TaxableYear, fraction: Decimal) strict {
    label en official "helper";
    when capital_gain_rate_differential_fraction_593b2Dv(i, y, fraction);
    then capital_gain_rate_differential_stated_593b2Dv(i, y);
}

// ---- Section 593(c)(3): charging worthless debts to the reserves ----

pub enum BadDebtReserveKind593c {
    ReserveOnQualifyingLoans;
    ReserveOnNonqualifyingLoans;
    ReserveSupplemental;
    label en unofficial "the reserve of section 593(c)(1) a worthless debt is charged to";
}
pub relation worthless_debt_593c3(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the loan becomes worthless or partially worthless in the taxable year, by this amount";
}
pub relation elected_supplemental_charge_593c3(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount the taxpayer elects to charge to the supplemental reserve for losses on loans, in whole or in part";
}
pub relation debt_charged_to_reserve_593c3(i: Person, y: TaxableYear, loan: us.irc.core::Asset, reserve: BadDebtReserveKind593c, amount: Money) kind institutional {
    label en official "the part of the worthless debt charged to the reserve";
}
@source(IRC_S593_C, quote = "Any debt becoming worthless or partially worthless in respect of a qualifying real property loan shall be charged to the reserve for losses on such loans")
rule Section593c3QualifyingLoanCharge(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, q: Money) defeasible {
    label en official "section 593(c)(3): a worthless qualifying real property loan is charged to the reserve for qualifying loans (no supplemental election)";
    when worthless_debt_593c3(i, y, loan, amount);
    when qualifying_real_property_loan_amount_593d1(i, y, loan, q);
    when not_known(supplemental_charge_stated_593c3(i, y, loan));
    then debt_charged_to_reserve_593c3(i, y, loan, ReserveOnQualifyingLoans, amount);
}
@source(IRC_S593_C, quote = "and any debt becoming worthless or partially worthless in respect of a nonqualifying loan shall be charged to the reserve for losses on nonqualifying loans")
rule Section593c3NonqualifyingLoanCharge(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, n: Money) defeasible {
    label en official "section 593(c)(3): a worthless nonqualifying loan is charged to the reserve for nonqualifying loans (no supplemental election)";
    when worthless_debt_593c3(i, y, loan, amount);
    when nonqualifying_loan_593d2(i, y, loan, n);
    when not_known(supplemental_charge_stated_593c3(i, y, loan));
    then debt_charged_to_reserve_593c3(i, y, loan, ReserveOnNonqualifyingLoans, amount);
}
pub relation supplemental_charge_stated_593c3(i: Person, y: TaxableYear, loan: us.irc.core::Asset) kind institutional {
    label en official "the taxpayer elected a supplemental-reserve charge for the loan (helper)";
}
rule Section593c3SupplementalStated(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money) strict {
    label en official "helper";
    when elected_supplemental_charge_593c3(i, y, loan, amount);
    then supplemental_charge_stated_593c3(i, y, loan);
}
@source(IRC_S593_C, quote = "except that any such debt may, at the election of the taxpayer, be charged in whole or in part to the supplemental reserve for losses on loans")
rule Section593c3SupplementalCharge(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, elected: Money) defeasible {
    label en official "section 593(c)(3): at the taxpayer's election the debt is charged in whole or in part to the supplemental reserve";
    when worthless_debt_593c3(i, y, loan, amount);
    when elected_supplemental_charge_593c3(i, y, loan, elected);
    when elected <= amount;
    then debt_charged_to_reserve_593c3(i, y, loan, ReserveSupplemental, elected);
}
rule Section593c3RemainderQualifying(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, elected: Money, q: Money) defeasible {
    label en official "section 593(c)(3): the part not elected stays with the loan's own reserve (qualifying loans)";
    when worthless_debt_593c3(i, y, loan, amount);
    when elected_supplemental_charge_593c3(i, y, loan, elected);
    when qualifying_real_property_loan_amount_593d1(i, y, loan, q);
    when elected < amount;
    then debt_charged_to_reserve_593c3(i, y, loan, ReserveOnQualifyingLoans, amount - elected);
}
rule Section593c3RemainderNonqualifying(i: Person, y: TaxableYear, loan: us.irc.core::Asset, amount: Money, elected: Money, n: Money) defeasible {
    label en official "section 593(c)(3): the part not elected stays with the loan's own reserve (nonqualifying loans)";
    when worthless_debt_593c3(i, y, loan, amount);
    when elected_supplemental_charge_593c3(i, y, loan, elected);
    when nonqualifying_loan_593d2(i, y, loan, n);
    when elected < amount;
    then debt_charged_to_reserve_593c3(i, y, loan, ReserveOnNonqualifyingLoans, amount - elected);
}

// ---- Section 593(e): distributions to shareholders ----

pub enum DistributionSource593e {
    SourceEarnings;
    SourceReserveBalance;
    SourceSupplementalReserve;
    SourceOtherAccounts;
    label en unofficial "the account a distribution is treated as made out of";
}
@source(IRC_S593_E, quote = "any distribution of property (as defined in section 317(a)) by a taxpayer having a balance described in subsection (g)(2)(A)(ii) to a shareholder with respect to its stock, if such distribution is not allowable as a deduction under section 591")
pub relation distribution_593e(i: Person, y: TaxableYear, dist: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "a distribution of property to a shareholder with respect to its stock that is not allowable as a deduction under section 591, by a taxpayer having a balance described in subsection (g)(2)(A)(ii)";
}
pub relation distribution_in_redemption_or_liquidation_593e1(dist: us.irc.core::Payment) kind empirical {
    label en unofficial "the distribution is in redemption of stock or in partial or complete liquidation of the taxpayer";
}
pub relation distribution_excepted_593e1(dist: us.irc.core::Payment) kind empirical {
    label en unofficial "the distribution is in a transaction to which section 381 applies, or to the FSLIC or FDIC in redemption of an interest received for assistance under section 597(c), or is a distribution of all the stock of a bank to an affiliated corporation under the section 5(e) of the Federal Deposit Insurance Act conditions";
}
pub relation accumulated_earnings_post_1951_593e1A(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earnings and profits accumulated in taxable years beginning after December 31, 1951 (for an S corporation, the accumulated adjustments account)";
}
pub relation reserve_balance_593e1B(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the balance taken into account under subsection (g)(2)(A)(ii), properly adjusted for amounts charged against such reserves for taxable years beginning after December 31, 1987";
}
pub relation qualifying_reserve_addition_of_year_593e3A(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the additions to the reserve for losses on qualifying real property loans for the taxable year in which the distribution occurs";
}
pub relation supplemental_reserve_593e1C(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the supplemental reserve for losses on loans";
}
pub relation reserve_balance_capacity_593e1B(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the (g)(2)(A)(ii) balance with the year's additions to the qualifying reserve taken into account (section 593(e)(3)(A))";
}
rule Section593e3AReserveCapacityWithAdditions(i: Person, y: TaxableYear, balance: Money, addition: Money) strict {
    label en official "section 593(e)(3)(A): additions to the qualifying reserve for the year of distribution are taken into account";
    when reserve_balance_593e1B(i, y, balance);
    when qualifying_reserve_addition_of_year_593e3A(i, y, addition);
    then reserve_balance_capacity_593e1B(i, y, balance + addition);
}
rule Section593e3AReserveCapacityNoAddition(i: Person, y: TaxableYear, balance: Money) defeasible {
    label en official "section 593(e)(1)(B): with no addition stated the balance is the capacity";
    when reserve_balance_593e1B(i, y, balance);
    when not_known(addition_stated_593e3A(i, y));
    then reserve_balance_capacity_593e1B(i, y, balance);
}
pub relation addition_stated_593e3A(i: Person, y: TaxableYear) kind institutional {
    label en official "an addition to the qualifying reserve is stated for the year (helper)";
}
rule Section593e3AAdditionStated(i: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when qualifying_reserve_addition_of_year_593e3A(i, y, amount);
    then addition_stated_593e3A(i, y);
}
pub relation ordinary_stage_earnings_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "an ordinary distribution, stage (A): the part out of earnings and profits (to the extent thereof) and what remains";
}
pub relation ordinary_stage_balance_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "an ordinary distribution, stage (B): the part out of the (g)(2)(A)(ii) balance and what remains";
}
pub relation ordinary_stage_supplemental_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "an ordinary distribution, stage (C): the part out of the supplemental reserve and what remains";
}
pub relation redemption_stage_balance_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "a redemption or liquidation distribution, first stage: the part out of the (g)(2)(A)(ii) balance and what remains";
}
pub relation redemption_stage_supplemental_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "a redemption or liquidation distribution, second stage: the part out of the supplemental reserve and what remains";
}
pub relation redemption_stage_earnings_593e(dist: us.irc.core::Payment, portion: Money, remaining: Money) kind institutional {
    label en official "a redemption or liquidation distribution, third stage: the part out of earnings and profits and what remains";
}
@source(IRC_S593_E, quote = "(A) first out of its earnings and profits accumulated in taxable years beginning after December 31, 1951, (and, in the case of an S corporation, the accumulated adjustments account, as defined in section 1368(e)(1)) to the extent thereof,")
rule Section593e1AOrdinaryFirstEarnings(i: Person, y: TaxableYear, dist: us.irc.core::Payment, amount: Money, earnings: Money) defeasible {
    label en official "section 593(e)(1)(A): an ordinary distribution is first out of earnings and profits, to the extent thereof";
    when distribution_593e(i, y, dist, amount);
    when accumulated_earnings_post_1951_593e1A(i, y, earnings);
    when not_known(distribution_in_redemption_or_liquidation_593e1(dist));
    when not_known(distribution_excepted_593e1(dist));
    then ordinary_stage_earnings_593e(dist, min(amount, earnings), amount - min(amount, earnings));
}
@source(IRC_S593_E, quote = "(B) then out of the balance taken into account under subsection (g)(2)(A)(ii) (properly adjusted for amounts charged against such reserves for taxable years beginning after December 31, 1987),")
rule Section593e1BOrdinaryThenBalance(i: Person, y: TaxableYear, dist: us.irc.core::Payment, previous: Money, remaining: Money, capacity: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(1)(B): then out of the (g)(2)(A)(ii) balance; the balance is worth its amount less the tax on its inclusion (highest section 11(b) rate: JUDGMENT CALL)";
    when ordinary_stage_earnings_593e(dist, previous, remaining);
    when distribution_593e(i, y, dist, _);
    when reserve_balance_capacity_593e1B(i, y, capacity);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then ordinary_stage_balance_593e(dist, min(remaining, round(capacity * (1.00 - rate), 2, "HALF_UP")), remaining - min(remaining, round(capacity * (1.00 - rate), 2, "HALF_UP")));
}
@source(IRC_S593_E, quote = "(C) then out of the supplemental reserve for losses on loans, to the extent thereof,")
rule Section593e1COrdinaryThenSupplemental(i: Person, y: TaxableYear, dist: us.irc.core::Payment, previous: Money, remaining: Money, supplemental: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(1)(C): then out of the supplemental reserve, to the extent thereof";
    when ordinary_stage_balance_593e(dist, previous, remaining);
    when distribution_593e(i, y, dist, _);
    when supplemental_reserve_593e1C(i, y, supplemental);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then ordinary_stage_supplemental_593e(dist, min(remaining, round(supplemental * (1.00 - rate), 2, "HALF_UP")), remaining - min(remaining, round(supplemental * (1.00 - rate), 2, "HALF_UP")));
}
@source(IRC_S593_E, quote = "except that any such distribution shall be treated as made first out of the amount referred to in subparagraph (B), second out of the amount referred to in subparagraph (C), third out of the amount referred to in subparagraph (A), and then out of such other accounts as may be proper")
rule Section593e1RedemptionFirstBalance(i: Person, y: TaxableYear, dist: us.irc.core::Payment, amount: Money, capacity: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(1), last part: a redemption or liquidation distribution is first out of the (g)(2)(A)(ii) balance";
    when distribution_593e(i, y, dist, amount);
    when distribution_in_redemption_or_liquidation_593e1(dist);
    when reserve_balance_capacity_593e1B(i, y, capacity);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    when not_known(distribution_excepted_593e1(dist));
    then redemption_stage_balance_593e(dist, min(amount, round(capacity * (1.00 - rate), 2, "HALF_UP")), amount - min(amount, round(capacity * (1.00 - rate), 2, "HALF_UP")));
}
rule Section593e1RedemptionSecondSupplemental(i: Person, y: TaxableYear, dist: us.irc.core::Payment, previous: Money, remaining: Money, supplemental: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(1), last part: second out of the supplemental reserve";
    when redemption_stage_balance_593e(dist, previous, remaining);
    when distribution_593e(i, y, dist, _);
    when supplemental_reserve_593e1C(i, y, supplemental);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then redemption_stage_supplemental_593e(dist, min(remaining, round(supplemental * (1.00 - rate), 2, "HALF_UP")), remaining - min(remaining, round(supplemental * (1.00 - rate), 2, "HALF_UP")));
}
rule Section593e1RedemptionThirdEarnings(i: Person, y: TaxableYear, dist: us.irc.core::Payment, previous: Money, remaining: Money, earnings: Money) defeasible {
    label en official "section 593(e)(1), last part: third out of earnings and profits";
    when redemption_stage_supplemental_593e(dist, previous, remaining);
    when distribution_593e(i, y, dist, _);
    when accumulated_earnings_post_1951_593e1A(i, y, earnings);
    then redemption_stage_earnings_593e(dist, min(remaining, earnings), remaining - min(remaining, earnings));
}
pub relation distribution_out_of_593e(dist: us.irc.core::Payment, account: DistributionSource593e, portion: Money) kind institutional {
    label en official "the part of the distribution treated as made out of the account";
}
rule Section593eOrdinaryEarningsOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1)(A): the part out of earnings";
    when ordinary_stage_earnings_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceEarnings, portion);
}
rule Section593eOrdinaryBalanceOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1)(B): the part out of the (g)(2)(A)(ii) balance";
    when ordinary_stage_balance_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceReserveBalance, portion);
}
rule Section593eOrdinarySupplementalOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1)(C): the part out of the supplemental reserve";
    when ordinary_stage_supplemental_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceSupplementalReserve, portion);
}
@source(IRC_S593_E, quote = "(D) then out of such other accounts as may be proper.")
rule Section593eOrdinaryOtherOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1)(D): the rest out of such other accounts as may be proper";
    when ordinary_stage_supplemental_593e(dist, portion, remaining);
    when remaining > 0.00 USD;
    then distribution_out_of_593e(dist, SourceOtherAccounts, remaining);
}
rule Section593eRedemptionBalanceOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1), last part: the part out of the (g)(2)(A)(ii) balance";
    when redemption_stage_balance_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceReserveBalance, portion);
}
rule Section593eRedemptionSupplementalOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1), last part: the part out of the supplemental reserve";
    when redemption_stage_supplemental_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceSupplementalReserve, portion);
}
rule Section593eRedemptionEarningsOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1), last part: the part out of earnings";
    when redemption_stage_earnings_593e(dist, portion, remaining);
    then distribution_out_of_593e(dist, SourceEarnings, portion);
}
rule Section593eRedemptionOtherOutOf(dist: us.irc.core::Payment, portion: Money, remaining: Money) defeasible {
    label en official "section 593(e)(1), last part: then out of such other accounts as may be proper";
    when redemption_stage_earnings_593e(dist, portion, remaining);
    when remaining > 0.00 USD;
    then distribution_out_of_593e(dist, SourceOtherAccounts, remaining);
}
pub relation charged_against_reserve_593e2(dist: us.irc.core::Payment, account: DistributionSource593e, charged: Money) kind institutional {
    label en official "the amount charged against the reserve: the portion grossed up so that, reduced by the tax attributable to its inclusion in gross income, it equals the portion (also included in gross income)";
}
@source(IRC_S593_E, quote = "the amount charged against such reserve shall be the amount which, when reduced by the amount of tax imposed under this chapter and attributable to the inclusion of such amount in gross income, is equal to the amount of such distribution; and the amount so charged against such reserve shall be included in gross income of the taxpayer")
rule Section593e2ChargedAgainstBalance(i: Person, y: TaxableYear, dist: us.irc.core::Payment, portion: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(2): the charge against the (g)(2)(A)(ii) balance (portion / (1 - tax rate), cents HALF_UP: JUDGMENT CALL)";
    when distribution_out_of_593e(dist, SourceReserveBalance, portion);
    when distribution_593e(i, y, dist, _);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then charged_against_reserve_593e2(dist, SourceReserveBalance, div_round(portion, 1.00 - rate, 2, "HALF_UP"));
}
rule Section593e2ChargedAgainstSupplemental(i: Person, y: TaxableYear, dist: us.irc.core::Payment, portion: Money, rate: Decimal) defeasible {
    label en official "section 593(e)(2): the charge against the supplemental reserve";
    when distribution_out_of_593e(dist, SourceSupplementalReserve, portion);
    when distribution_593e(i, y, dist, _);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then charged_against_reserve_593e2(dist, SourceSupplementalReserve, div_round(portion, 1.00 - rate, 2, "HALF_UP"));
}
pub relation charge_included_in_gross_income_593e2(dist: us.irc.core::Payment, account: DistributionSource593e, amount: Money) kind institutional {
    label en official "the amount charged against the reserve is included in the gross income of the taxpayer";
}
rule Section593e2ChargeIncluded(dist: us.irc.core::Payment, account: DistributionSource593e, charged: Money) defeasible {
    label en official "section 593(e)(2): the charge is gross income";
    when charged_against_reserve_593e2(dist, account, charged);
    then charge_included_in_gross_income_593e2(dist, account, charged);
}
pub relation charge_ignored_for_reasonable_addition_593e3B(i: Person, y: TaxableYear, dist: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an amount charged to the qualifying reserve under paragraph (2) is not taken into account in computing the reasonable addition to that reserve";
}
@source(IRC_S593_E, quote = "any amount charged during any year to such reserve pursuant to the provisions of paragraph (2) shall not be taken into account")
rule Section593e3BChargeIgnored(i: Person, y: TaxableYear, dist: us.irc.core::Payment, charged: Money) defeasible {
    label en official "section 593(e)(3)(B): the paragraph (2) charge is left out of the reasonable addition computation";
    when distribution_593e(i, y, dist, _);
    when charged_against_reserve_593e2(dist, SourceReserveBalance, charged);
    then charge_ignored_for_reasonable_addition_593e3B(i, y, dist, charged);
}
