// Section 856(d) (rents from real property defined: the included amounts,
// the 15 percent personal-property test, the excluded amounts including the
// 10 percent related-tenant test and impermissible tenant service income
// with its 1 percent de minimis test, and the (8)(A) taxable-REIT-subsidiary
// limited-rental exception). Stage 2b (IRC-09 stage 2b, A12).
//
// METHOD: the (1)(C) 15 percent personal-property-rent test, the (2)(B) 10
// percent related-tenant ownership test, the (7)(B) 1 percent impermissible-
// tenant-service-income de minimis test, and the (8)(A)(i) 90 percent
// limited-rental test are all modeled as EXACT cross-multiplied comparisons
// over case-asserted aggregate figures, per this package's established
// method (no division). The (2)(B)/(3)/(5) ownership tests (10 percent
// direct-or-indirect ownership via constructive ownership under section
// 318(a) as modified) accept a case-asserted OWNERSHIP PERCENTAGE directly
// rather than deriving it from a constructive-ownership graph — the same
// simplification this package's own section 816(a)/831(b) tests use for
// percentage thresholds over case-supplied aggregates, but here the
// underlying attribution machinery itself (section 318(a) as modified by
// (d)(5)) is NOT derived, only the final percentage comparison. Section
// 856(d)(4) (contingent-rent proportionate-part rule), (d)(6) (sublease-
// through rule), (d)(8)(B)-(9) (lodging/health-care special exceptions,
// eligible-independent-contractor definition) are NOT modeled — narrow,
// self-contained sub-rules outside this pass's core arithmetic.

// ---- Section 856(d)(1): amounts included ----

use self::{
    IRC_S856_D,
    Person,
    TaxableYear,
};

@source(IRC_S856_D, quote = "rents from interests in real property")
pub relation rents_from_interests_in_real_property_856d1A(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "rents from interests in real property, per section 856(d)(1)(A)";
}
@source(IRC_S856_D, quote = "charges for services customarily furnished or rendered in connection with the rental of real property, whether or not such charges are separately stated")
pub relation service_charges_customary_856d1B(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "charges for services customarily furnished or rendered in connection with the rental of real property, per section 856(d)(1)(B)";
}
@source(IRC_S856_D, quote = "the average of the fair market values of the personal property at the beginning and at the end of the taxable year")
pub relation average_fmv_personal_property_856d1C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the average of the fair market values of the leased personal property at the beginning and end of the taxable year, per section 856(d)(1)(C)'s final sentence";
}
@source(IRC_S856_D, quote = "the average of the aggregate fair market values of both the real property and the personal property at the beginning and at the end of such taxable year")
pub relation average_fmv_real_and_personal_property_856d1C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the average of the aggregate fair market values of both the real and personal property leased under the lease, at the beginning and end of the taxable year, per section 856(d)(1)(C)'s final sentence";
}
@source(IRC_S856_D, quote = "total rent for the taxable year attributable to both the real and personal property leased under, or in connection with, such lease")
pub relation total_rent_real_and_personal_property_856d1C(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "total rent for the taxable year attributable to both the real and personal property leased under the lease, per section 856(d)(1)(C)";
}
@source(IRC_S856_D, quote = "rent attributable to personal property for the taxable year is that amount which bears the same ratio to total rent for the taxable year as the average of the fair market values of the personal property at the beginning and at the end of the taxable year bears to the average of the aggregate fair market values of both the real property and the personal property at the beginning and at the end of such taxable year")
pub relation rent_attributable_to_personal_property_856d1C(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 856(d)(1)(C)'s final sentence: rent attributable to personal property, by the fair-market-value ratio, computed exactly via div_round rather than a separate fraction";
}
rule Section856d1CRentAttributableToPersonalProperty(t: Person, y: TaxableYear, avg_personal: Money, avg_total: Money, total_rent: Money) strict {
    label en official "section 856(d)(1)(C): rent attributable to personal property = total rent times the fair-market-value ratio";
    when average_fmv_personal_property_856d1C(t, y, avg_personal);
    when average_fmv_real_and_personal_property_856d1C(t, y, avg_total);
    when total_rent_real_and_personal_property_856d1C(t, y, total_rent);
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then rent_attributable_to_personal_property_856d1C(t, y, div_round(total_rent * (avg_personal / 1.00 USD), avg_total / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S856_D, quote = "the rent attributable to such personal property for the taxable year does not exceed 15 percent of the total rent for the taxable year attributable to both the real and personal property leased under, or in connection with, such lease")
pub relation personal_property_rent_within_fifteen_percent_856d1C(t: Person, y: TaxableYear) kind institutional {
    label en official "section 856(d)(1)(C): the personal-property rent does not exceed 15 percent of total rent under the lease";
}
rule Section856d1CFifteenPercentTest(t: Person, y: TaxableYear, personal_rent: Money, total_rent: Money) strict {
    label en official "section 856(d)(1)(C): personal-property rent at or below 15 percent of total rent, by exact cross-multiplication";
    when rent_attributable_to_personal_property_856d1C(t, y, personal_rent);
    when total_rent_real_and_personal_property_856d1C(t, y, total_rent);
    when personal_rent * 100 <= total_rent * 15;
    then personal_property_rent_within_fifteen_percent_856d1C(t, y);
}
@source(IRC_S856_D, quote = "rent attributable to personal property which is leased under, or in connection with, a lease of real property, but only if the rent attributable to such personal property for the taxable year does not exceed 15 percent of the total rent for the taxable year attributable to both the real and personal property leased under, or in connection with, such lease")
pub relation personal_property_rent_included_856d1C(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 856(d)(1)(C): personal-property rent is included in rents from real property, when the 15 percent test is met";
}
rule Section856d1CPersonalPropertyRentIncludedWhenWithinLimit(t: Person, y: TaxableYear, personal_rent: Money) strict {
    label en official "section 856(d)(1)(C): the personal-property rent is included when it is within the 15 percent limit";
    when personal_property_rent_within_fifteen_percent_856d1C(t, y);
    when rent_attributable_to_personal_property_856d1C(t, y, personal_rent);
    then personal_property_rent_included_856d1C(t, y, personal_rent);
}
// When the 15 percent test is NOT met, section 856(d)(1)(C) simply does not
// include the personal-property rent at all (not "included at zero" — the
// whole category fails the (1)(C) gate); no rule fires for
// `personal_property_rent_included_856d1C` in that case, and the sum rule
// below falls back to (A)+(B) only via its own not_known guard.

@source(IRC_S856_D, quote = "For purposes of paragraphs (2) and (3) of subsection (c), the term \"rents from real property\" includes (subject to paragraph (2))—\n(A) rents from interests in real property,\n(B) charges for services customarily furnished or rendered in connection with the rental of real property, whether or not such charges are separately stated, and\n(C) rent attributable to personal property which is leased under, or in connection with, a lease of real property")
pub relation rents_from_real_property_included_856d1(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 856(d)(1): the sum of (A) real property rents, (B) customary service charges, and (C) qualifying personal-property rent, before the (2) exclusions";
}
rule Section856d1SumWithPersonalProperty(t: Person, y: TaxableYear, real_rent: Money, services: Money, personal: Money) strict {
    label en official "section 856(d)(1): sum including qualifying personal-property rent";
    when rents_from_interests_in_real_property_856d1A(t, y, real_rent);
    when service_charges_customary_856d1B(t, y, services);
    when personal_property_rent_included_856d1C(t, y, personal);
    then rents_from_real_property_included_856d1(t, y, (real_rent + services) + personal);
}
rule Section856d1SumWithoutPersonalProperty(t: Person, y: TaxableYear, real_rent: Money, services: Money) defeasible {
    label en official "section 856(d)(1): sum without personal-property rent, when the (1)(C) 15 percent test is not met or no personal-property facts are supplied";
    when rents_from_interests_in_real_property_856d1A(t, y, real_rent);
    when service_charges_customary_856d1B(t, y, services);
    when not_known(personal_property_rent_included_856d1C(t, y, real_rent));
    then rents_from_real_property_included_856d1(t, y, real_rent + services);
}

// ---- Section 856(d)(2): amounts excluded ----

@source(IRC_S856_D, quote = "any amount received or accrued, directly or indirectly, with respect to any real or personal property, if the determination of such amount depends in whole or in part on the income or profits derived by any person from such property")
pub relation profit_dependent_amount_856d2A(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount received depends in whole or in part on the income or profits derived from the property, per section 856(d)(2)(A) (the fixed-percentage-of-receipts-or-sales carve-out within the same subparagraph is not separately modeled)";
}
@source(IRC_S856_D, quote = "in the case of any person which is a corporation, stock of such person possessing 10 percent or more of the total combined voting power of all classes of stock entitled to vote, or 10 percent or more of the total value of shares of all classes of stock of such person")
pub relation trust_ownership_percentage_of_tenant_856d2B(t: Person, tenant: Person, y: TaxableYear, percentage: Decimal) kind empirical {
    label en unofficial "the trust's direct-or-indirect ownership percentage of the tenant (voting power/value of stock, or interest in assets/net profits for a non-corporate tenant), per section 856(d)(2)(B) (constructive ownership under section 318(a) as modified by (d)(5) is not separately derived — a case supplies the final percentage)";
}
@source(IRC_S856_D, quote = "any amount received or accrued directly or indirectly from any person if the real estate investment trust owns, directly or indirectly—\n(i) in the case of any person which is a corporation, stock of such person possessing 10 percent or more of the total combined voting power of all classes of stock entitled to vote, or 10 percent or more of the total value of shares of all classes of stock of such person; or\n(ii) in the case of any person which is not a corporation, an interest of 10 percent or more in the assets or net profits of such person")
pub relation related_tenant_856d2B(t: Person, tenant: Person, y: TaxableYear) kind institutional {
    label en official "section 856(d)(2)(B): the trust owns 10 percent or more of the tenant, so amounts received from the tenant are excluded from rents from real property (subject to the (d)(8) taxable-REIT-subsidiary exception)";
}
rule Section856d2BRelatedTenantAtLeastTenPercent(t: Person, tenant: Person, y: TaxableYear, pct: Decimal) strict {
    label en official "section 856(d)(2)(B): 10 percent or more ownership of the tenant makes it a related tenant";
    when trust_ownership_percentage_of_tenant_856d2B(t, tenant, y, pct);
    when pct >= 0.10;
    then related_tenant_856d2B(t, tenant, y);
}

@source(IRC_S856_D, quote = "any amount received or accrued directly or indirectly by the real estate investment trust for—\n(i) services furnished or rendered by the trust to the tenants of such property, or\n(ii) managing or operating such property")
pub relation tenant_service_income_856d7A(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "amounts received for services furnished/rendered or for managing/operating the property, per section 856(d)(7)(A) (the (C) independent-contractor/taxable-REIT-subsidiary and section 512(b)(3) exceptions are not separately modeled)";
}
@source(IRC_S856_D, quote = "all amounts received or accrued during such taxable year directly or indirectly by the real estate investment trust with respect to such property")
pub relation all_amounts_from_property_856d7B(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "all amounts received or accrued during the taxable year with respect to the property, per section 856(d)(7)(B)'s 1 percent de minimis test";
}
@source(IRC_S856_D, quote = "If the amount described in subparagraph (A) with respect to a property for any taxable year exceeds 1 percent of all amounts received or accrued during such taxable year directly or indirectly by the real estate investment trust with respect to such property, the impermissible tenant service income of the trust with respect to the property shall include all such amounts.")
pub relation impermissible_tenant_service_income_856d7(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "section 856(d)(7)(B): when tenant service income exceeds 1 percent of all amounts from the property, ALL such amounts (not just the excess) are impermissible tenant service income";
}
rule Section856d7BExceedsOnePercentDeMinimis(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, service_income: Money, all_amounts: Money) strict {
    label en official "section 856(d)(7)(B): service income exceeding 1 percent of all amounts from the property disqualifies all such amounts";
    when tenant_service_income_856d7A(t, y, reit_asset, service_income);
    when all_amounts_from_property_856d7B(t, y, reit_asset, all_amounts);
    when service_income * 100 > all_amounts * 1;
    then impermissible_tenant_service_income_856d7(t, y, reit_asset, all_amounts);
}

// ---- Section 856(d)(8)(A): limited rental exception for TRS payments ----

@source(IRC_S856_D, quote = "at least 90 percent of the leased space of the property is rented to persons other than taxable REIT subsidiaries of such trust and other than persons described in paragraph (2)(B)")
pub relation leased_space_rented_to_non_trs_856d8A(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, amount: Decimal) kind empirical {
    label en unofficial "the percentage of leased space of the property rented to persons other than taxable REIT subsidiaries and other than section 856(d)(2)(B) related persons, per section 856(d)(8)(A)(i)";
}
@source(IRC_S856_D, quote = "The requirements of this subparagraph are met with respect to any property if at least 90 percent of the leased space of the property is rented to persons other than taxable REIT subsidiaries of such trust and other than persons described in paragraph (2)(B).")
pub relation trs_limited_rental_exception_met_856d8A(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset) kind institutional {
    label en official "section 856(d)(8)(A)(i): the limited rental exception's 90 percent test is met for the property (the (ii)-(iii) rent-comparability requirement is not separately modeled)";
}
rule Section856d8AiNinetyPercentTest(t: Person, y: TaxableYear, reit_asset: us.irc.core::Asset, pct: Decimal) strict {
    label en official "section 856(d)(8)(A)(i): at least 90 percent of leased space rented to non-TRS, non-related persons";
    when leased_space_rented_to_non_trs_856d8A(t, y, reit_asset, pct);
    when pct >= 0.90;
    then trs_limited_rental_exception_met_856d8A(t, y, reit_asset);
}

// ---- The published pub export: company-wide "rents from real property" ----
//
// Gated on the section 856(d)(1) sum, unless the company-wide (d)(2)(A)
// profit-dependent switch applies. The (d)(2)(B) related-tenant exclusion
// and the (d)(7) impermissible-tenant-service-income exclusion are, by the
// statute's own terms, PER TENANT / PER PROPERTY amounts (`related_tenant_
// 856d2B`, `impermissible_tenant_service_income_856d7` above) — they are
// NOT wired into this single company-wide aggregate relation, because doing
// so honestly would require decomposing the (d)(1) aggregate into its
// tenant/property-level components first (an aggregation gap in the
// opposite direction from this package's other "sum over derived
// predicates" gaps, filed as a TECH_GAP rather than silently ignored).
@source(IRC_S856_D, quote = "For purposes of paragraphs (2) and (3) of subsection (c), the term \"rents from real property\" includes (subject to paragraph (2))—")
pub relation rents_from_real_property(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 856(d): rents from real property for purposes of section 856(c)(2)-(3), before the per-tenant/per-property (d)(2)(B)/(d)(7) exclusions (see the module header)";
}
rule Section856dRentsFromRealPropertyNoProfitDependence(t: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 856(d): rents from real property equal the (d)(1) included sum, unless the company-wide profit-dependent-amount switch (d)(2)(A) applies";
    when rents_from_real_property_included_856d1(t, y, amount);
    when not_known(profit_dependent_amount_856d2A(t, y));
    then rents_from_real_property(t, y, amount);
}
