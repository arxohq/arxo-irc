// 26 U.S.C. 812(a) — Definition of company's share and policyholder's share
fragment IRC_S812_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/812/a";
    text en official """(a) Company's share
For purposes of section 805(a)(4), the term "company's share" means, with respect to any taxable year beginning after December 31, 2017, 70 percent.""";
    content_hash "sha256:1cd9e4a321a610f9c4a41540b7ca8bd017adcce9be0e0e73cdba1fff79647029";
}

// 26 U.S.C. 812(b) — Definition of company's share and policyholder's share
fragment IRC_S812_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/812/b";
    text en official """(b) Policyholder's share
For purposes of section 807, the term "policyholder's share" means, with respect to any taxable year beginning after December 31, 2017, 30 percent.""";
    content_hash "sha256:d0a1b997b8b0265d6c31bb3cdaa0fc927f3aadd8b608f9d78f16f58d56d2a1ec";
