// Section 856(d)(2)(B), (d)(3)-(6) (rents from real property: the related-
// tenant test through constructive ownership, independent contractors,
// contingent rents from subtenants' profits, the sublease-through rule).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. Section 856(d)(5) applies the section 318(a) attribution rules to
// stock, assets and net profits of any person, with two changes: "10
// percent" replaces "50 percent" in section 318(a)(2)(C) and (3)(C), and
// section 318(a)(3)(A) counts only partners holding 25 percent or more of
// the capital or profits interest. The direct facts are the shared
// `us.irc.core::ownership_interest` rows and the partner/beneficiary rows
// of us.irc.corporations (the same input relations the section 318 rules
// there read); the derived relation `reit_constructive_ownership_856d5`
// is ONE HOP per path (a chain of attributions, and the section 318(a)(5)
// re-attribution limits, are not followed: recursive closure is LDC-E4102,
// TECH-GAPS G4900). A threshold is met by any single path; two paths that
// are each below the threshold but together above it are not added
// (TECH-GAPS G4901). The interpretation of a share as "voting power or
// value" (section 856(d)(2)(B)(i)) is left to the case: one ownership row
// per measure, any row at or above 10 percent satisfies the test.

// ---- Section 856(d)(5): constructive ownership ----

use self::{
    Corporation,
    IRC_S856_D,
    Person,
    TaxableYear,
    reit_constructive_ownership_total_856d5,
    related_tenant_856d2B,
};

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
pub relation reit_constructive_ownership_856d5(owner: Person, target: Person, share: Decimal, via: us.irc.corporations::AttributionKind) kind institutional {
    label en official "the owner owns, actually or constructively under section 318(a) as modified by section 856(d)(5), the share of the target's stock, assets or net profits (one attribution hop per row)";
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Section856d5ActualOwnership(owner: Person, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) defeasible {
    label en official "section 856(d)(5): direct (actual) ownership of stock, assets or net profits";
    when us.irc.core::ownership_interest(oi, owner, target, share);
    then reit_constructive_ownership_856d5(owner, target, share, us.irc.corporations::Actual);
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Section856d5FamilySpouse(ind: us.irc.core::Individual, spouse: us.irc.core::Individual, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5), 318(a)(1)(A)(i): an individual is considered as owning what the spouse owns (unless legally separated)";
    when us.irc.corporations::spouse_of(spouse, ind);
    when not_known(us.irc.corporations::legally_separated_spouse(spouse, ind));
    when us.irc.core::ownership_interest(oi, spouse, target, share);
    then reit_constructive_ownership_856d5(ind, target, share, us.irc.corporations::Family);
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Section856d5FamilyLineal(ind: us.irc.core::Individual, relative: us.irc.core::Individual, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5), 318(a)(1)(A)(ii): an individual is considered as owning what the individual's children, grandchildren and parents own";
    when us.irc.corporations::child_grandchild_or_parent_of(relative, ind);
    when us.irc.core::ownership_interest(oi, relative, target, share);
    then reit_constructive_ownership_856d5(ind, target, share, us.irc.corporations::Family);
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Section856d5FromPartnership(partner: Person, partnership: us.irc.core::Partnership, interest_share: Decimal, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5), 318(a)(2)(A): a partner is considered as owning the partnership's holding proportionately";
    when us.irc.corporations::partner_of(partner, partnership, interest_share);
    when us.irc.core::ownership_interest(oi, partnership, target, share);
    then reit_constructive_ownership_856d5(partner, target, share * interest_share, us.irc.corporations::FromEntity);
}
@source(IRC_S856_D, quote = "\"10 percent\" shall be substituted for \"50 percent\" in subparagraph (C) of paragraphs (2) and (3) of section 318(a)")
rule Section856d5AFromTenPercentOwnedCorporation(owner: Person, held: Corporation, owned_share: Decimal, target: Person, held_share: Decimal, oi1: us.irc.core::OwnershipInterest, oi2: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5)(A), 318(a)(2)(C): a 10-percent-or-more owner of a corporation is considered as owning the corporation's holding in the target, in the proportion the owner's stock bears to all the stock";
    when us.irc.core::ownership_interest(oi1, owner, held, owned_share);
    when owned_share >= 0.10;
    when us.irc.core::ownership_interest(oi2, held, target, held_share);
    then reit_constructive_ownership_856d5(owner, target, held_share * owned_share, us.irc.corporations::FromEntity);
}
@source(IRC_S856_D, quote = "\"10 percent\" shall be substituted for \"50 percent\" in subparagraph (C) of paragraphs (2) and (3) of section 318(a)")
rule Section856d5AToTenPercentOwnedCorporation(owner: Person, held: Corporation, owned_share: Decimal, target: Person, share: Decimal, oi1: us.irc.core::OwnershipInterest, oi2: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5)(A), 318(a)(3)(C): a corporation is considered as owning the stock its 10-percent-or-more owner owns";
    when us.irc.core::ownership_interest(oi1, owner, held, owned_share);
    when owned_share >= 0.10;
    when us.irc.core::ownership_interest(oi2, owner, target, share);
    then reit_constructive_ownership_856d5(held, target, share, us.irc.corporations::ToEntity);
}
@source(IRC_S856_D, quote = "section 318(a)(3)(A) shall be applied in the case of a partnership by taking into account only partners who own (directly or indirectly) 25 percent or more of the capital interest, or the profits interest, in the partnership")
rule Section856d5BToPartnershipFromQuarterPartner(partner: Person, partnership: us.irc.core::Partnership, interest_share: Decimal, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) defeasible {
    label en official "sections 856(d)(5)(B), 318(a)(3)(A): a partnership is considered as owning the stock owned by a partner who holds 25 percent or more of the capital or profits interest; smaller partners are not taken into account";
    when us.irc.corporations::partner_of(partner, partnership, interest_share);
    when interest_share >= 0.25;
    when us.irc.core::ownership_interest(oi, partner, target, share);
    then reit_constructive_ownership_856d5(partnership, target, share, us.irc.corporations::ToEntity);
}

// ---- Section 856(d)(2)(B): related tenant by attributed ownership ----

@source(IRC_S856_D, quote = "any amount received or accrued directly or indirectly from any person if the real estate investment trust owns, directly or indirectly")
pub relation rent_received_from_tenant_for_property_856d(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the trust received or accrued the amount from the tenant with respect to the property in the taxable year, directly or indirectly (the base of the section 856(d)(2)(B) and (d)(8) tests)";
}
@source(IRC_S856_D, quote = "any amount received or accrued directly or indirectly from any person if the real estate investment trust owns, directly or indirectly")
rule Section856d2BRelatedTenantByConstructiveOwnership(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money, share: Decimal) defeasible {
    label en official "section 856(d)(2)(B) with (d)(5): the trust owns, actually or constructively, 10 percent or more of the tenant (corporate tenant: voting power or value; other tenant: interest in assets or net profits)";
    when rent_received_from_tenant_for_property_856d(t, tenant, p, y, amount);
    when reit_constructive_ownership_total_856d5(t, tenant, share);
    when share >= 0.10;
    then related_tenant_856d2B(t, tenant, y);
}

// ---- Section 856(d)(3): independent contractor ----

@source(IRC_S856_D, quote = "the term \"independent contractor\" means any person")
pub relation independent_contractor_candidate_856d3(c: Person, t: Person) kind empirical {
    label en unofficial "the person is put to the section 856(d)(3) independent contractor test with respect to the real estate investment trust";
}
@source(IRC_S856_D, quote = "is regularly traded on an established securities market")
pub relation stock_regularly_traded_856d3(entity_p: Person) kind empirical {
    label en unofficial "a class of stock of the real estate investment trust or of the person is regularly traded on an established securities market";
}
@source(IRC_S856_D, quote = "only persons who own, directly or indirectly, more than 5 percent of such class of stock shall be taken into account as owning any of the stock of such class")
pub relation owner_taken_into_account_856d3(owner: Person, entity_p: Person, share: Decimal) kind institutional {
    label en official "the owner's holding is taken into account for the 35 percent limitation: where a class of the entity's stock is regularly traded, only owners of more than 5 percent count (all outstanding stock stays in the denominator, so the share is the owner's share of all stock)";
}
@source(IRC_S856_D, quote = "only persons who own, directly or indirectly, more than 5 percent of such class of stock shall be taken into account as owning any of the stock of such class")
rule Section856d3RegularlyTradedFiveFilter(owner: Person, entity_p: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3), last sentence: for stock regularly traded on an established securities market only more-than-5-percent owners are taken into account";
    when reit_constructive_ownership_total_856d5(owner, entity_p, share);
    when stock_regularly_traded_856d3(entity_p);
    when share > 0.05;
    then owner_taken_into_account_856d3(owner, entity_p, share);
}
@source(IRC_S856_D, quote = "only persons who own, directly or indirectly, more than 5 percent of such class of stock shall be taken into account as owning any of the stock of such class")
rule Section856d3NotTradedAllOwnersCount(owner: Person, entity_p: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3): where no class is regularly traded every owner's holding is taken into account";
    when reit_constructive_ownership_total_856d5(owner, entity_p, share);
    when not_known(stock_regularly_traded_856d3(entity_p));
    then owner_taken_into_account_856d3(owner, entity_p, share);
}
@source(IRC_S856_D, quote = "who does not own, directly or indirectly, more than 35 percent of the shares, or certificates of beneficial interest, in the real estate investment trust")
pub relation owns_more_than_35_percent_of_trust_856d3A(c: Person, t: Person) kind institutional {
    label en official "the person owns, directly or indirectly, more than 35 percent of the shares or certificates of beneficial interest in the trust (the disqualifying case of subparagraph (A))";
}
@source(IRC_S856_D, quote = "who does not own, directly or indirectly, more than 35 percent of the shares, or certificates of beneficial interest, in the real estate investment trust")
rule Section856d3AOwnsMoreThan35Percent(c: Person, t: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3)(A): the person owns more than 35 percent of the trust";
    when independent_contractor_candidate_856d3(c, t);
    when owner_taken_into_account_856d3(c, t, share);
    when share > 0.35;
    then owns_more_than_35_percent_of_trust_856d3A(c, t);
}
@source(IRC_S856_D, quote = "owned, directly or indirectly, by one or more persons owning 35 percent or more of the shares or certificates of beneficial interest in the trust")
pub relation owner_of_35_percent_or_more_of_trust_856d3B(q: Person, t: Person) kind institutional {
    label en official "the person owns 35 percent or more of the shares or certificates of beneficial interest in the trust";
}
@source(IRC_S856_D, quote = "owned, directly or indirectly, by one or more persons owning 35 percent or more of the shares or certificates of beneficial interest in the trust")
rule Section856d3BOwnerOfThirtyFivePercentOfTrust(q: Person, t: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3)(B): a person owning 35 percent or more of the trust";
    when independent_contractor_candidate_856d3(_, t);
    when owner_taken_into_account_856d3(q, t, share);
    when share >= 0.35;
    then owner_of_35_percent_or_more_of_trust_856d3B(q, t);
}
@source(IRC_S856_D, quote = "not more than 35 percent of the total combined voting power of whose stock (or 35 percent of the total shares of all classes of whose stock), or, if such person is not a corporation, not more than 35 percent of the interest in whose assets or net profits is owned")
pub relation contractor_owned_over_35_percent_by_35_percent_owners_856d3B(c: Person, t: Person) kind institutional {
    label en official "more than 35 percent of the contractor (voting power or shares of a corporation; assets or net profits of another person) is owned, directly or indirectly, by persons owning 35 percent or more of the trust (the disqualifying case of subparagraph (B))";
}
pub relation contractor_holding_of_35_percent_owners_in_aggregate_856d3B(c: Person, t: Person, share: Decimal) kind empirical {
    label en unofficial "the combined share of the contractor owned by ALL persons owning 35 percent or more of the trust, when several such owners each hold less than 35 percent (an aggregate the case supplies; the derived test below adds no owners)";
}
@source(IRC_S856_D, quote = "owned, directly or indirectly, by one or more persons owning 35 percent or more of the shares or certificates of beneficial interest in the trust")
rule Section856d3BSingleOwnerExceedsThirtyFive(c: Person, t: Person, q: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3)(B): one owner of 35 percent or more of the trust owns more than 35 percent of the contractor";
    when independent_contractor_candidate_856d3(c, t);
    when owner_of_35_percent_or_more_of_trust_856d3B(q, t);
    when owner_taken_into_account_856d3(q, c, share);
    when share > 0.35;
    then contractor_owned_over_35_percent_by_35_percent_owners_856d3B(c, t);
}
@source(IRC_S856_D, quote = "owned, directly or indirectly, by one or more persons owning 35 percent or more of the shares or certificates of beneficial interest in the trust")
rule Section856d3BAggregateOwnersExceedThirtyFive(c: Person, t: Person, share: Decimal) defeasible {
    label en official "section 856(d)(3)(B): the several owners of 35 percent or more of the trust together own more than 35 percent of the contractor";
    when independent_contractor_candidate_856d3(c, t);
    when contractor_holding_of_35_percent_owners_in_aggregate_856d3B(c, t, share);
    when share > 0.35;
    then contractor_owned_over_35_percent_by_35_percent_owners_856d3B(c, t);
}
@source(IRC_S856_D, quote = "the term \"independent contractor\" means any person")
pub relation independent_contractor_856d3(c: Person, t: Person) kind institutional {
    label en official "the person is an independent contractor of the trust for purposes of section 856(d) and (e): neither disqualifying case of subparagraph (A) or (B) applies";
}
@source(IRC_S856_D, quote = "the term \"independent contractor\" means any person")
rule Section856d3IndependentContractor(c: Person, t: Person) defeasible {
    label en official "section 856(d)(3): an independent contractor is a person who owns no more than 35 percent of the trust and of whom no more than 35 percent is owned by owners of 35 percent or more of the trust";
    when independent_contractor_candidate_856d3(c, t);
    when not_known(owns_more_than_35_percent_of_trust_856d3A(c, t));
    when not_known(contractor_owned_over_35_percent_by_35_percent_owners_856d3B(c, t));
    then independent_contractor_856d3(c, t);
}

// ---- Section 856(d)(4): contingent rents, proportionate part ----

@source(IRC_S856_D, quote = "any amount which would be excluded from the term \"rents from real property\" solely because the tenant of the real estate investment trust receives or accrues, directly or indirectly, from subtenants any amount the determination of which depends in whole or in part on the income or profits derived by any person from such property")
pub relation amount_excluded_solely_by_subtenant_profit_dependence_856d4(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount the trust received or accrued from the tenant that would be excluded from rents from real property solely because the tenant's receipts from subtenants depend on the income or profits of any person from the property";
}
@source(IRC_S856_D, quote = "only a proportionate part (determined pursuant to regulations prescribed by the Secretary) of the amount received or accrued by the real estate investment trust from that tenant will be excluded")
pub relation proportionate_part_by_regulations_856d4(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, part: Decimal) kind empirical {
    label en unofficial "the proportionate part of the amount that is excluded, as determined pursuant to regulations prescribed by the Secretary (the regulation is not pinned in this package: the proportion is the case's input, TECH-GAPS G4902)";
}
@source(IRC_S856_D, quote = "only a proportionate part (determined pursuant to regulations prescribed by the Secretary) of the amount received or accrued by the real estate investment trust from that tenant will be excluded")
pub relation amount_excluded_856d4(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, excluded: Money) kind institutional {
    label en official "the part of the amount from the tenant that stays excluded from rents from real property under section 856(d)(4)";
}
@source(IRC_S856_D, quote = "only a proportionate part (determined pursuant to regulations prescribed by the Secretary) of the amount received or accrued by the real estate investment trust from that tenant will be excluded")
rule Section856d4ProportionateExclusion(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money, part: Decimal) defeasible {
    label en official "section 856(d)(4): only the proportionate part of the amount from the tenant is excluded; cents HALF_UP is a JUDGMENT CALL (the text names no rounding)";
    when amount_excluded_solely_by_subtenant_profit_dependence_856d4(t, tenant, p, y, amount);
    when proportionate_part_by_regulations_856d4(t, tenant, p, y, part);
    then amount_excluded_856d4(t, tenant, p, y, round(amount * part, 2, "HALF_UP"));
}
@source(IRC_S856_D, quote = "only a proportionate part (determined pursuant to regulations prescribed by the Secretary) of the amount received or accrued by the real estate investment trust from that tenant will be excluded")
pub relation amount_not_excluded_856d4(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, kept: Money) kind institutional {
    label en official "the rest of the amount from the tenant, which section 856(d)(4) does not exclude from rents from real property";
}
@source(IRC_S856_D, quote = "only a proportionate part (determined pursuant to regulations prescribed by the Secretary) of the amount received or accrued by the real estate investment trust from that tenant will be excluded")
rule Section856d4RemainderNotExcluded(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money, excluded: Money) defeasible {
    label en official "section 856(d)(4): the amount not excluded is the amount from the tenant less the excluded proportionate part";
    when amount_excluded_solely_by_subtenant_profit_dependence_856d4(t, tenant, p, y, amount);
    when amount_excluded_856d4(t, tenant, p, y, excluded);
    then amount_not_excluded_856d4(t, tenant, p, y, amount - excluded);
}

// ---- Section 856(d)(6): property subleased by the tenant ----

@source(IRC_S856_D, quote = "a tenant which derives substantially all of its income with respect to such property from the subleasing of substantially all of such property")
pub relation tenant_derives_substantially_all_income_from_subleasing_856d6A(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the tenant derives substantially all of its income with respect to the property from subleasing substantially all of the property (an evaluative element the case asserts, DECISION-0194 channel 2 when adjudicated)";
}
pub relation amount_received_from_subleasing_tenant_856d6A(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the trust received or accrued from the tenant with respect to the property, which is based on the tenant's income or profits";
}
pub relation subtenant_receipt_856d6(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "an amount the tenant received or accrued, directly or indirectly, from a subtenant of the property";
}
pub relation receipt_would_be_rents_from_real_property_if_received_by_trust_856d6B(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount would be treated as rents from real property if it were received by the real estate investment trust (a classification under section 856(d)(1)-(2) that the case makes for the receipt)";
}
@source(IRC_S856_D, quote = "the term \"qualified rents\" means any amount which would be treated as rents from real property if received by the real estate investment trust")
pub relation qualified_rent_item_856d6B(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a subtenant receipt of the tenant that is a qualified rent";
}
@source(IRC_S856_D, quote = "the term \"qualified rents\" means any amount which would be treated as rents from real property if received by the real estate investment trust")
rule Section856d6BQualifiedRent(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 856(d)(6)(B): a subtenant receipt that would be rents from real property if received by the trust is a qualified rent";
    when subtenant_receipt_856d6(tenant, p, y, item, amount);
    when receipt_would_be_rents_from_real_property_if_received_by_trust_856d6B(item);
    then qualified_rent_item_856d6B(tenant, p, y, item, amount);
}
@source(IRC_S856_D, quote = "a portion of the amount such tenant receives or accrues, directly or indirectly, from subtenants consists of qualified rents")
pub relation qualified_rents_total_856d6B(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the tenant's qualified rents for the property and year (an aggregate over a derived relation: the section 111 runtime subset may leave the result unestablished, TECH-GAPS G4903)";
}
@source(IRC_S856_D, quote = "a portion of the amount such tenant receives or accrues, directly or indirectly, from subtenants consists of qualified rents")
rule Section856d6BQualifiedRentsTotal(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 856(d)(6)(A)(ii): the tenant's qualified rents in total";
    when qualified_rent_item_856d6B(tenant, p, y, anchor, anchor_amount);
    then qualified_rents_total_856d6B(tenant, p, y, sum all amount: Money for item: us.irc.core::Payment where qualified_rent_item_856d6B(tenant, p, y, item, amount));
}
pub relation subtenant_receipts_total_856d6(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of everything the tenant receives or accrues from subtenants of the property in the year";
}
rule Section856d6SubtenantReceiptsTotal(tenant: Person, p: us.irc.core::Asset, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 856(d)(6)(A)(ii): the tenant's subtenant receipts in total";
    when subtenant_receipt_856d6(tenant, p, y, anchor, anchor_amount);
    then subtenant_receipts_total_856d6(tenant, p, y, sum all amount: Money for item: us.irc.core::Payment where subtenant_receipt_856d6(tenant, p, y, item, amount));
}
@source(IRC_S856_D, quote = "the amounts which the trust receives or accrues from the tenant shall not be excluded from the term \"rents from real property\" by reason of being based on the income or profits of such tenant to the extent the amounts so received or accrued are attributable to qualified rents received or accrued by such tenant")
pub relation amount_not_excluded_856d6(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, kept: Money) kind institutional {
    label en official "the part of the amount from the tenant that section 856(d)(6) keeps in rents from real property: the amount attributable to the tenant's qualified rents";
}
@source(IRC_S856_D, quote = "the amounts which the trust receives or accrues from the tenant shall not be excluded from the term \"rents from real property\" by reason of being based on the income or profits of such tenant to the extent the amounts so received or accrued are attributable to qualified rents received or accrued by such tenant")
rule Section856d6AAttributableToQualifiedRents(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money, qualified: Money, total: Money) defeasible {
    label en official "section 856(d)(6)(A): the amounts from the tenant are attributable to qualified rents in the ratio of the tenant's qualified rents to its subtenant receipts (INTERPRETATION: the text says only 'to the extent attributable'; one rounding, cents HALF_UP)";
    when tenant_derives_substantially_all_income_from_subleasing_856d6A(t, tenant, p, y);
    when amount_received_from_subleasing_tenant_856d6A(t, tenant, p, y, amount);
    when qualified_rents_total_856d6B(tenant, p, y, qualified);
    when subtenant_receipts_total_856d6(tenant, p, y, total);
    when total > 0.00 USD;
    then amount_not_excluded_856d6(t, tenant, p, y, div_round(amount * (qualified / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
