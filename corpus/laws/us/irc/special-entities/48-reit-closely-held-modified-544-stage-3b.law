// Section 856(h)(1)(B) stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. The ownership of the entity's stock is derived per owner with the
// rules of section 544 as section 856(h)(1)(B) modifies them: the family
// rule of 544(a)(2) without the partner rule (the family relation is read
// from us.irc.corporations::family_of_544a2 and the partner relation of that
// package is simply not used), and the option rule of 544(a)(4)(A) and
// (b)(1) with the substitution: an option is counted unless counting it
// would make the entity meet the stock ownership requirement of section
// 542(a)(2). One hop per path; the top five individuals' total (the closely
// held test of module 19) stays an asserted percentage (G5316).

use self::{
    IRC_S856_H,
    Person,
};

pub relation reit_ownership_856h1B(owner: Person, target: Person, share: Decimal, via: us.irc.corporations::AttributionKind) kind institutional {
    label en official "the owner owns, actually or by the modified section 544 rules, the share of the entity's stock";
}
rule Section856h1BActualOwnership(owner: Person, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) strict {
    label en official "section 856(h)(1): direct ownership of stock";
    when us.irc.core::ownership_interest(oi, owner, target, share);
    then reit_ownership_856h1B(owner, target, share, us.irc.corporations::Actual);
}
@source(IRC_S856_H, quote = "(i) paragraph (2) of section 544(a) shall be applied as if such paragraph did not contain the phrase")
rule Section856h1BiFamilyWithoutPartner(ind: us.irc.core::Individual, relative: us.irc.core::Individual, target: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) strict {
    label en official "section 856(h)(1)(B)(i): section 544(a)(2) applied as if it did not contain \"or by or for his partner\": only the family attributes";
    when us.irc.corporations::family_of_544a2(relative, ind);
    when us.irc.core::ownership_interest(oi, relative, target, share);
    then reit_ownership_856h1B(ind, target, share, us.irc.corporations::Family);
}
pub relation option_to_acquire_stock_856h1Bii(holder: Person, target: Person, share: Decimal) kind empirical {
    label en unofficial "the holder has an option to acquire this share of the entity's stock (an option on an option, and a series of options, count as an option)";
}
pub relation option_would_make_entity_meet_542a2_856h1Bii(holder: Person, target: Person) kind empirical {
    label en unofficial "counting the option would cause the entity to meet the stock ownership requirement of section 542(a)(2)";
}
@source(IRC_S856_H, quote = "(ii) sections 544(a)(4)(A) and 544(b)(1) shall be applied by substituting")
rule Section856h1BiiOptionCounted(holder: Person, target: Person, share: Decimal) strict {
    label en official "section 856(h)(1)(B)(ii): an option counts as ownership unless counting it would make the entity meet the requirement of section 542(a)(2)";
    when option_to_acquire_stock_856h1Bii(holder, target, share);
    when not_known(option_would_make_entity_meet_542a2_856h1Bii(holder, target));
    then reit_ownership_856h1B(holder, target, share, us.irc.corporations::Option);
}
pub relation option_disregarded_856h1Bii(holder: Person, target: Person) kind institutional {
    label en official "the option is not counted: it would make the entity meet the stock ownership requirement";
}
rule Section856h1BiiOptionDisregarded(holder: Person, target: Person, share: Decimal) strict {
    label en official "section 856(h)(1)(B)(ii): the substitution for the personal holding company condition";
    when option_to_acquire_stock_856h1Bii(holder, target, share);
    when option_would_make_entity_meet_542a2_856h1Bii(holder, target);
    then option_disregarded_856h1Bii(holder, target);
}
@source(IRC_S856_H, quote = "For purposes of subparagraph (A)—")
pub relation modified_section_544_rules_applied_856h1B(target: Person) kind institutional {
    label en official "the rules of section 544 as modified by subparagraph (B) are applied to the entity";
}
rule Section856h1BChapeau(owner: Person, target: Person, share: Decimal, via: us.irc.corporations::AttributionKind) strict {
    label en official "section 856(h)(1)(B): for purposes of subparagraph (A) the ownership is determined by the modified rules";
    when reit_ownership_856h1B(owner, target, share, via);
    then modified_section_544_rules_applied_856h1B(target);
}
