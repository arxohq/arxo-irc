// Section 808(a)-(d) (policyholder dividends: the definition, the (c)
// deduction amount that feeds section 805(a)(3), and the excess-interest/
// premium-adjustment/experience-rated-refund definitions). Stage 2b
// (IRC-09 stage 2b, A12).
//
// METHOD: section 808(c)'s deduction amount is a direct pass-through of
// the case-asserted "dividends paid or accrued" figure — the only genuine
// operative rule in this section. Section 808(a)-(b) (the definition of
// "policyholder dividend" and its (b)(1)-(4) inclusions: experience-rated
// amounts, excess interest, premium adjustments, experience-rated refunds)
// and (d) (defining "excess interest", "premium adjustment", "experience-
// rated refund" for purposes of this section) are pure definitional glosses
// that this package folds into the single case-asserted
// `policyholder_dividends_paid_or_accrued_808c` figure, rather than
// separately deriving which sub-category a given payment falls into.
// Section 808(e) (treatment of dividends that increase cash value or
// reduce premium as paid-and-returned) is cross-referenced by section
// 848(d)(3) but is NOT modeled here (it would require decomposing a
// dividend payment into its cash-value/premium-reduction components).
// Section 808(f) (1984 fresh-start coordination) and (g) (prevailing State
// assumed interest rate, itself needed by (d)(1)(B)'s excess-interest
// definition) are NOT modeled — (f) is a narrow historical transition rule
// for a 1983-vintage reserve balance, and (g) needs a 26-state median-type
// determination this package has no data model for.

use self::{
    IRC_S808_C,
    Person,
    TaxableYear,
    policyholder_dividends_808c_amount,
};

@source(IRC_S808_C, quote = "The deduction for policyholder dividends for any taxable year shall be an amount equal to the policyholder dividends paid or accrued during the taxable year.")
pub relation policyholder_dividends_paid_or_accrued_808c(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "policyholder dividends paid or accrued during the taxable year, per section 808(c) (the section 808(a)-(b) definition and (d) sub-definitions are folded into this single figure, not separately itemized)";
}
// Stage 3 (26.09.2026): this aggregate now concludes the section 808(c)
// AMOUNT (`policyholder_dividends_808c_amount`, module 28); the deduction of
// section 805(a)(3) is that amount less the section 808(f) fresh-start
// reduction (module 28). Sections 808(a), (b), (d), (e), (f), (g) are
// derived in module 28; the notes above that call them not modeled are the
// stage-2b state.
rule Section808cPolicyholderDividendsDeduction(c: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 808(c): the policyholder dividends paid or accrued during the taxable year (the aggregate fact)";
    when policyholder_dividends_paid_or_accrued_808c(c, y, amount);
    then policyholder_dividends_808c_amount(c, y, amount);
}
