// Section 852(b)(5) (exempt-interest dividends: the 50 percent qualification
// test, the definition with its excess-reported-amount adjustment, and
// shareholder treatment) and section 852(g) (special rules for a fund of
// funds). Stage 2b (IRC-09 stage 2b, A12).
//
// METHOD: the (b)(5)(A)(ii)-(iii) excess-reported-amount adjustment has the
// IDENTICAL shape to section 852(b)(3)(C)'s capital-gain-dividend excess-
// reported-amount mechanics (the statute's own (b)(5) cross-references
// "similar" treatment) — this module models it fully with exact
// cross-multiplication (the (iii)(I) ratio is computed by cross-
// multiplying the comparison rather than dividing, consistent with this
// package's method), unlike (b)(3)(C) which stage 1 left as a documented
// TECH_GAP (and which stage 2b's coverage pass corrected from a stray
// EXECUTABLE misclassification — see coverage/special-entities.json). The
// (iii)(II) noncalendar-year special rule (post-December reported amount
// substitution) is NOT modeled — a narrower temporal branch. Section
// 852(b)(4) (loss disallowance on stock held 6 months or less, attributable
// to a capital gain dividend or an exempt-interest dividend, with its
// holding-period computation and daily-dividend-company exception) is NOT
// modeled this pass (a distinct, self-contained holding-period computation,
// out of budget alongside the rest of this stage's scope). Section
// 852(b)(6)-(9) (section 311(b) inapplicability, October/November/December
// dividend timing, elective late-year-loss deferral, ex-dividend-date
// timing) are NOT modeled.

// ---- Section 852(b)(5) chapeau: the 50 percent qualification test ----

use self::{
    IRC_S852_B,
    IRC_S852_G,
    Person,
    TaxableYear,
    noncalendar_special_rule_applies_852b5Aiii,
};

@source(IRC_S852_B, quote = "at least 50 percent of the value (as defined in section 851(c)(4)) of the total assets of the regulated investment company consists of obligations described in section 103(a)")
pub relation value_of_section_103a_obligations(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of section 103(a) obligations (tax-exempt State/local bonds) held by the regulated investment company, per section 852(b)(5)'s chapeau (measured at the close of each quarter — the case supplies the figure for whichever quarter is being tested)";
}
@source(IRC_S852_B, quote = "the value (as defined in section 851(c)(4)) of the total assets of the regulated investment company")
pub relation total_assets_value_852b5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the total assets of the regulated investment company, per section 852(b)(5)'s chapeau (section 851(c)(4) valuation method, not separately re-derived here — this package's own section 851(b) diversification tests already use the same valuation concept)";
}
@source(IRC_S852_B, quote = "If, at the close of each quarter of its taxable year, at least 50 percent of the value (as defined in section 851(c)(4)) of the total assets of the regulated investment company consists of obligations described in section 103(a), such company shall be qualified to pay exempt-interest dividends, as defined herein, to its shareholders.")
pub relation qualified_to_pay_exempt_interest_dividends(c: Person, y: TaxableYear) kind institutional {
    label en official "section 852(b)(5)'s chapeau: the company is qualified to pay exempt-interest dividends for the taxable year";
}
rule Section852b5QualifiedByFiftyPercentTest(c: Person, y: TaxableYear, obligations: Money, total: Money) strict {
    label en official "section 852(b)(5): at least 50 percent of total assets in section 103(a) obligations qualifies the company to pay exempt-interest dividends";
    when value_of_section_103a_obligations(c, y, obligations);
    when total_assets_value_852b5(c, y, total);
    when obligations * 100 >= total * 50;
    then qualified_to_pay_exempt_interest_dividends(c, y);
}
// Section 852(g)(1)(A): a qualified fund of funds is qualified to pay
// exempt-interest dividends WITHOUT regard to the 50 percent test above.
@source(IRC_S852_G, quote = "such fund shall be qualified to pay exempt-interest dividends to its shareholders without regard to whether such fund satisfies the requirements of the first sentence of subsection (b)(5)")
rule Section852g1AFundOfFundsQualifiesWithoutFiftyPercentTest(c: Person, y: TaxableYear) strict {
    label en official "section 852(g)(1)(A): a qualified fund of funds is qualified to pay exempt-interest dividends without regard to the section 852(b)(5) 50 percent test";
    when qualified_fund_of_funds_852g2(c, y);
    then qualified_to_pay_exempt_interest_dividends(c, y);
}
@source(IRC_S852_G, quote = "at least 50 percent of the value of its total assets is represented by interests in other regulated investment companies")
pub relation value_of_interests_in_other_rics(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the regulated investment company's interests in other regulated investment companies, per section 852(g)(2)'s 50 percent test";
}
@source(IRC_S852_G, quote = "the term \"qualified fund of funds\" means a regulated investment company if (at the close of each quarter of the taxable year) at least 50 percent of the value of its total assets is represented by interests in other regulated investment companies")
pub relation qualified_fund_of_funds_852g2(c: Person, y: TaxableYear) kind institutional {
    label en official "section 852(g)(2): a qualified fund of funds — at least 50 percent of total assets represented by interests in other regulated investment companies";
}
rule Section852g2QualifiedFundOfFunds(c: Person, y: TaxableYear, interests: Money, total: Money) strict {
    label en official "section 852(g)(2): at least 50 percent of total assets in interests in other RICs qualifies the company as a fund of funds";
    when value_of_interests_in_other_rics(c, y, interests);
    when total_assets_value_852b5(c, y, total);
    when interests * 100 >= total * 50;
    then qualified_fund_of_funds_852g2(c, y);
}

// ---- Section 852(b)(5)(A): definition of exempt-interest dividend ----

@source(IRC_S852_B, quote = "an exempt-interest dividend is any dividend or part thereof (other than a capital gain dividend) paid by a regulated investment company and reported by the company as an exempt-interest dividend in written statements furnished to its shareholders")
pub relation reported_exempt_interest_dividend_amount(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount reported to shareholders as an exempt-interest dividend, per section 852(b)(5)(A)(i)/(iv)(I)";
}
@source(IRC_S852_B, quote = "The term \"aggregate reported amount\" means the aggregate amount of dividends reported by the company under clause (i) as exempt-interest dividends for the taxable year (including exempt-interest dividends paid after the close of the taxable year described in section 855).")
pub relation aggregate_reported_amount_852b5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of dividends reported as exempt-interest dividends for the taxable year (including any section 855 post-year-end dividends), per section 852(b)(5)(A)(iv)(III)";
}
@source(IRC_S852_B, quote = "The term \"exempt interest\" means, with respect to any regulated investment company, the excess of the amount of interest excludable from gross income under section 103(a) over the amounts disallowed as deductions under sections 265 and 171(a)(2).")
pub relation exempt_interest_852b5(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the company's 'exempt interest' for the taxable year (section 103(a) excludable interest, less section 265/171(a)(2) disallowed deductions), per section 852(b)(5)(A)(iv)(V)";
}
@source(IRC_S852_B, quote = "The term \"excess reported amount\" means the excess of the aggregate reported amount over the exempt interest of the company for the taxable year.")
pub relation excess_reported_amount_852b5(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 852(b)(5)(A)(iv)(II): the excess of the aggregate reported amount over exempt interest";
}
rule Section852b5Aiv2ExcessReportedAmount(c: Person, y: TaxableYear, aggregate: Money, exempt_interest: Money) strict {
    label en official "section 852(b)(5)(A)(iv)(II): excess reported amount = aggregate reported amount minus exempt interest, when positive";
    when aggregate_reported_amount_852b5(c, y, aggregate);
    when exempt_interest_852b5(c, y, exempt_interest);
    when aggregate > exempt_interest;
    then excess_reported_amount_852b5(c, y, aggregate - exempt_interest);
}
@source(IRC_S852_B, quote = "that portion of the excess reported amount which bears the same ratio to the excess reported amount as the reported exempt-interest dividend amount bears to the aggregate reported amount")
pub relation excess_reported_amount_allocable_852b5(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "section 852(b)(5)(A)(iii)(I): the portion of the excess reported amount allocable to a given reported exempt-interest dividend, by exact cross-multiplied ratio";
}
rule Section852b5Aiii1AllocationByCrossMultipliedRatio(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, excess: Money, reported: Money, aggregate: Money) defeasible {
    label en official "section 852(b)(5)(A)(iii)(I): allocable excess = excess reported amount times (reported dividend / aggregate reported amount), computed exactly by cross-multiplication to avoid dividing two Money values into a fraction that then multiplies a third — instead this rule multiplies the excess by the exact Money/Money ratio via div_round";
    when excess_reported_amount_852b5(c, y, excess);
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, reported);
    when aggregate_reported_amount_852b5(c, y, aggregate);
    // Stage 3 (26.09.2026): the noncalendar-year special rule of clause
    // (iii)(II) replaces this allocation (module 34).
    when not_known(noncalendar_special_rule_applies_852b5Aiii(c, y));
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then excess_reported_amount_allocable_852b5(c, y, dividend_id, div_round(excess * (reported / 1.00 USD), aggregate / 1.00 USD, 2, "HALF_UP"));
}
@source(IRC_S852_B, quote = "an exempt-interest dividend is the excess of—\n(I) the reported exempt-interest dividend amount, over\n(II) the excess reported amount which is allocable to such reported exempt-interest dividend amount")
pub relation exempt_interest_dividend(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "section 852(b)(5)(A): the exempt-interest dividend amount for a given reported dividend — the reported amount, reduced by its allocable excess reported amount when the aggregate reported amount exceeds exempt interest for the year";
}
rule Section852b5Aii1WithExcessReportedAmount(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, reported: Money, allocable_excess: Money) defeasible {
    label en official "section 852(b)(5)(A)(ii): when the excess reported amount is allocated, the exempt-interest dividend is the reported amount minus the allocable excess";
    when qualified_to_pay_exempt_interest_dividends(c, y);
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, reported);
    when excess_reported_amount_allocable_852b5(c, y, dividend_id, allocable_excess);
    then exempt_interest_dividend(c, y, dividend_id, reported - allocable_excess);
}
rule Section852b5AiNoExcessReportedAmount(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, reported: Money) defeasible {
    label en official "section 852(b)(5)(A)(i): when no excess reported amount is allocated for this dividend (the aggregate reported amount does not exceed exempt interest, or the excess/allocation facts are not supplied), the exempt-interest dividend is the full reported amount";
    when qualified_to_pay_exempt_interest_dividends(c, y);
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, reported);
    when not_known(has_excess_reported_amount_allocable_852b5(c, y, dividend_id));
    then exempt_interest_dividend(c, y, dividend_id, reported);
}
pub relation has_excess_reported_amount_allocable_852b5(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment) kind institutional {
    label en official "an allocable excess reported amount has been derived for this dividend (helper)";
}
rule HasExcessReportedAmountAllocable852b5(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) defeasible {
    label en official "helper: holds whenever any allocable excess is derived for the dividend";
    when excess_reported_amount_allocable_852b5(c, y, dividend_id, amount);
    then has_excess_reported_amount_allocable_852b5(c, y, dividend_id);
}

// ---- Section 852(b)(5)(B): shareholder treatment ----

pub relation shareholder_received_exempt_interest_dividend(shareholder: Person, dividend_id: us.irc.core::Payment) kind empirical {
    label en unofficial "the shareholder received the dividend (case fact binding a shareholder to an exempt-interest dividend of the regulated investment company)";
}
@source(IRC_S852_B, quote = "An exempt-interest dividend shall be treated by the shareholders for all purposes of this subtitle as an item of interest excludable from gross income under section 103(a).")
pub relation treated_as_excludable_interest_by_shareholder(shareholder: Person, dividend_id: us.irc.core::Payment) kind institutional {
    label en official "section 852(b)(5)(B): the shareholder treats the exempt-interest dividend as interest excludable from gross income under section 103(a)";
}
rule Section852b5BShareholderTreatment(shareholder: Person, c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 852(b)(5)(B): a exempt-interest dividend is treated by the shareholder as excludable interest under section 103(a)";
    when exempt_interest_dividend(c, y, dividend_id, amount);
    when shareholder_received_exempt_interest_dividend(shareholder, dividend_id);
    then treated_as_excludable_interest_by_shareholder(shareholder, dividend_id);
}
