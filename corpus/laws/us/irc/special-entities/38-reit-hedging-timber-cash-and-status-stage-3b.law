// Sections 856(c)(5)(G)-(I), (K), (c)(7)(C)(ii), (e)(4)(C), (e)(6)(C),
// (f), (j), (l), (m), stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. The item model of module 18 is kept: every item of gross income
// carries a `ReitIncomeKind`. Two kinds are added (module 18): hedging
// income (the item is income of a transaction the case says is a hedge)
// and timber gain (the item is gain of the kind described in (c)(5)(H)).
//   * (G) hedging: the exclusion from gross income is derived per item
//     (clauses (i)-(iii), the identification requirement of (iv) and the
//     Secretary's contrary determination as a case fact); an item that is
//     not excluded stays in the denominator of both percentage tests. The
//     "to the extent" apportionment inside an item is not represented (the
//     case splits items): G5304.
//   * (H) timber gain: the item qualifies as gain on real property for
//     (c)(2)(D) and (c)(3)(C) when it is one of the three kinds and the
//     disposition is on or before the termination date; the deemed sale to
//     the taxable REIT subsidiary on the first day of the year and the
//     dealer-property disregard are derived per item.
//   * (K) cash: foreign currency counts as cash only to the extent held
//     for the normal course of the trust's activities and not in
//     connection with a (n)(4) activity; a new asset class is added
//     (module 18).
//   * (c)(7)(C)(ii): the net income period ends on the earlier of two
//     dates, by the candidates-plus-no-earlier-candidate pattern.
//   * (e)(6)(C): income from an independent contractor disregarded for
//     (e)(4)(C), per basis, capped at the income received; the
//     "substantially similar or lesser benefit" comparison is an external
//     judgment (DECISION-0194 channel 1).
//   * (f), (j), (l), (m): the proportional and holding-period arithmetic
//     of the listed paragraphs (cents HALF_UP; shares to 6 decimals, a
//     JUDGMENT CALL).

// ---- Section 856(c)(5)(G): hedging instruments ----

use self::{
    Corporation,
    IRC_S856_C,
    IRC_S856_E,
    IRC_S856_F,
    IRC_S856_J,
    IRC_S856_L,
    IRC_S856_M,
    Person,
    ReitAssetKind,
    ReitIncomeKind,
    TaxableYear,
    contingency_upon_default_or_prepayment_consistent_with_commercial_practice_856m2Bii,
    contingency_yield_test_met_856m2Bi,
    foreclosure_property_by_acquisition_856e1,
    income_from_shared_appreciation_provision_856j1,
    itemized_gross_income_for_856c2,
    itemized_gross_income_for_856c3,
    itemized_qualifying_item_856c2,
    itemized_qualifying_item_856c3,
    partnership_debt_instrument_856m4,
    property_used_in_trade_or_business_of_trust_on_856e4C,
    qualified_health_care_property_856e6D,
    quarter_asset_item_75_percent_class_856c4A,
    reit_asset_item_at_quarter_close,
    reit_gross_income_item,
    reit_holds_percent_of_stock_856i2,
    shared_appreciation_sale_expenditures_by_holder_856j3B,
    straight_debt_per_1361c5_856m2A,
    termination_date_857b6J,
    trs_holds_more_than_35_percent_of_value_856l2B,
    trs_joint_election_856l1B,
};

pub relation hedging_transaction_1221b2A_856cG(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the item is income of a hedging transaction as defined in clause (ii) or (iii) of section 1221(b)(2)(A) (including gain from its sale or disposition)";
}
pub relation hedges_indebtedness_to_acquire_or_carry_real_estate_assets_856cGi(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the transaction hedges indebtedness incurred or to be incurred by the trust to acquire or carry real estate assets";
}
pub relation transaction_primarily_manages_currency_risk_on_c2_c3_income_856cGii(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the transaction was entered into primarily to manage risk of currency fluctuations with respect to an item of income or gain described in paragraph (2) or (3) (or property generating it), including gain from its termination";
}
pub relation hedge_position_entered_856cGiiiI(pos: us.irc.core::Asset) kind empirical {
    label en unofficial "the trust enters into a position described in clause (i) with respect to indebtedness, or a position described in clause (ii) with respect to property generating (c)(2) or (c)(3) income";
}
pub relation hedged_indebtedness_extinguished_or_property_disposed_856cGiiiII(pos: us.irc.core::Asset) kind empirical {
    label en unofficial "any portion of the hedged indebtedness is extinguished or any portion of the property is disposed of";
}
pub relation counteracting_transaction_entered_856cGiiiIII(pos: us.irc.core::Asset) kind empirical {
    label en unofficial "in connection with the extinguishment or disposition, the trust enters into a transaction that would be a hedging transaction of clause (ii) or (iii) of section 1221(b)(2)(A) with respect to the position if the position were ordinary property";
}
pub relation item_of_income_from_position_or_counteracting_transaction_856cGiii(item: us.irc.core::Payment, pos: us.irc.core::Asset) kind empirical {
    label en unofficial "the item is income of the position or of the counteracting transaction (including gain from its termination), to the extent the transaction hedges the position";
}
pub relation identification_requirement_1221a7_satisfied_856cGiv(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the transaction satisfies the identification requirement of section 1221(a)(7), after any curative provisions";
}
pub relation secretary_determines_hedging_treatment_otherwise_856cG(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the Secretary has determined that the hedging exclusion does not apply to the item";
}
pub relation hedging_income_excluded_856cG(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the item of hedging income does not constitute gross income under paragraphs (2) and (3)";
}
@source(IRC_S856_C, quote = "(i) any income of a real estate investment trust from a hedging transaction (as defined in clause (ii)")
rule Section856cGiHedgeOfIndebtedness(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(G)(i): income of a hedge of indebtedness incurred to acquire or carry real estate assets is not gross income for the two tests";
    when reit_gross_income_item(t, y, item, ReitHedgingIncome, amount);
    when hedging_transaction_1221b2A_856cG(item);
    when hedges_indebtedness_to_acquire_or_carry_real_estate_assets_856cGi(item);
    when identification_requirement_1221a7_satisfied_856cGiv(item);
    when not_known(secretary_determines_hedging_treatment_otherwise_856cG(item));
    then hedging_income_excluded_856cG(t, y, item);
}
@source(IRC_S856_C, quote = "(ii) any income of a real estate investment trust from a transaction entered into by the trust primarily")
rule Section856cGiiCurrencyHedge(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(G)(ii): income of a currency-risk transaction on (c)(2) or (c)(3) income is not gross income for the two tests";
    when reit_gross_income_item(t, y, item, ReitHedgingIncome, amount);
    when transaction_primarily_manages_currency_risk_on_c2_c3_income_856cGii(item);
    when identification_requirement_1221a7_satisfied_856cGiv(item);
    when not_known(secretary_determines_hedging_treatment_otherwise_856cG(item));
    then hedging_income_excluded_856cG(t, y, item);
}
@source(IRC_S856_C, quote = "any income of such trust from any position referred to in subclause (I) and from any transaction")
rule Section856cGiiiCounteractingTransaction(t: Person, y: TaxableYear, item: us.irc.core::Payment, pos: us.irc.core::Asset, amount: Money) strict {
    label en official "section 856(c)(5)(G)(iii): income of a position and of the counteracting transaction entered into on extinguishment or disposition is not gross income for the two tests";
    when reit_gross_income_item(t, y, item, ReitHedgingIncome, amount);
    when hedge_position_entered_856cGiiiI(pos);
    when hedged_indebtedness_extinguished_or_property_disposed_856cGiiiII(pos);
    when counteracting_transaction_entered_856cGiiiIII(pos);
    when item_of_income_from_position_or_counteracting_transaction_856cGiii(item, pos);
    when identification_requirement_1221a7_satisfied_856cGiv(item);
    when not_known(secretary_determines_hedging_treatment_otherwise_856cG(item));
    then hedging_income_excluded_856cG(t, y, item);
}
@source(IRC_S856_C, quote = "(G) Treatment of certain hedging instruments.—Except to the extent as determined by the Secretary—")
rule Section856cGRetainedAsGrossIncome95(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(G): a hedging item that is not excluded remains in gross income (in the denominator only) for the 95 percent test";
    when reit_gross_income_item(t, y, item, ReitHedgingIncome, amount);
    when not_known(hedging_income_excluded_856cG(t, y, item));
    then itemized_gross_income_for_856c2(t, y, item, amount);
}
rule Section856cGRetainedAsGrossIncome75(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(G): a hedging item that is not excluded remains in gross income (in the denominator only) for the 75 percent test";
    when reit_gross_income_item(t, y, item, ReitHedgingIncome, amount);
    when not_known(hedging_income_excluded_856cG(t, y, item));
    then itemized_gross_income_for_856c3(t, y, item, amount);
}

// ---- Section 856(c)(5)(H): timber gains ----

pub relation timber_gain_under_631a_election_cut_by_trs_856cHiI(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the gain is recognized by an election under section 631(a) from timber owned by the trust, the cutting of which is provided by a taxable REIT subsidiary";
}
pub relation timber_gain_under_631b_856cHiII(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the gain is recognized under section 631(b)";
}
pub relation income_would_be_timber_gain_but_for_one_year_holding_856cHiIII(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the income would constitute gain under subclause (I) or (II) but for the failure to meet the 1-year holding period requirement";
}
pub relation holding_period_failure_relates_to_631a_856cHiiI(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the income of subclause (III) relates to gain of subclause (I)";
}
pub relation timber_gain_disposition_date_856cH(item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date of the disposition giving rise to the timber gain";
}
pub relation timber_gain_qualifies_856cHi(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the timber gain is gain from the sale of real property described in paragraphs (2)(D) and (3)(C)";
}
@source(IRC_S856_C, quote = "(I) recognized by an election under section 631(a) from timber owned by the real estate investment")
rule Section856cHiITimberGainUnder631a(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, on: Date, termination: Date) strict {
    label en official "section 856(c)(5)(H)(i)(I), (iii): gain under a section 631(a) election, cut by a taxable REIT subsidiary, on or before the termination date";
    when reit_gross_income_item(t, y, item, ReitTimberGain, amount);
    when timber_gain_under_631a_election_cut_by_trs_856cHiI(item);
    when timber_gain_disposition_date_856cH(item, on);
    when termination_date_857b6J(t, termination);
    when on <= termination;
    then timber_gain_qualifies_856cHi(t, y, item);
}
@source(IRC_S856_C, quote = "(II) recognized under section 631(b); or")
rule Section856cHiIITimberGainUnder631b(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, on: Date, termination: Date) strict {
    label en official "section 856(c)(5)(H)(i)(II), (iii): gain recognized under section 631(b), on or before the termination date";
    when reit_gross_income_item(t, y, item, ReitTimberGain, amount);
    when timber_gain_under_631b_856cHiII(item);
    when timber_gain_disposition_date_856cH(item, on);
    when termination_date_857b6J(t, termination);
    when on <= termination;
    then timber_gain_qualifies_856cHi(t, y, item);
}
@source(IRC_S856_C, quote = "(III) income which would constitute gain under subclause (I) or (II) but for the failure to meet the")
rule Section856cHiIIITimberIncomeButForHoldingPeriod(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, on: Date, termination: Date) strict {
    label en official "section 856(c)(5)(H)(i)(III), (iii): income that would be such gain but for the 1-year holding period, on or before the termination date";
    when reit_gross_income_item(t, y, item, ReitTimberGain, amount);
    when income_would_be_timber_gain_but_for_one_year_holding_856cHiIII(item);
    when timber_gain_disposition_date_856cH(item, on);
    when termination_date_857b6J(t, termination);
    when on <= termination;
    then timber_gain_qualifies_856cHi(t, y, item);
}
@source(IRC_S856_C, quote = "(i) In general.—Gain from the sale of real property described in paragraph (2)(D) and (3)(C) shall")
rule Section856cHiTimberGainCountsFor95(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(H)(i): qualifying timber gain is gain on real property for the 95 percent test ((c)(2)(D))";
    when reit_gross_income_item(t, y, item, ReitTimberGain, amount);
    when timber_gain_qualifies_856cHi(t, y, item);
    then itemized_qualifying_item_856c2(t, y, item, amount);
}
rule Section856cHiTimberGainCountsFor75(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 856(c)(5)(H)(i): qualifying timber gain is gain on real property for the 75 percent test ((c)(3)(C))";
    when reit_gross_income_item(t, y, item, ReitTimberGain, amount);
    when timber_gain_qualifies_856cHi(t, y, item);
    then itemized_qualifying_item_856c3(t, y, item, amount);
}
pub relation cut_timber_deemed_sold_to_trs_856cHiiI(t: Person, y: TaxableYear, item: us.irc.core::Payment, on: Date) kind institutional {
    label en official "the cut timber is deemed sold to the taxable REIT subsidiary on the first day of the taxable year";
}
@source(IRC_S856_C, quote = "(I) For purposes of this subtitle, cut timber, the gain from which is recognized by a real estate")
rule Section856cHiiIDeemedSaleToTrsFor631a(t: Person, y: TaxableYear, item: us.irc.core::Payment, first_day: Date) strict {
    label en official "section 856(c)(5)(H)(ii)(I): cut timber whose 631(a) gain is recognized is deemed sold to the taxable REIT subsidiary on the first day of the taxable year";
    when timber_gain_qualifies_856cHi(t, y, item);
    when timber_gain_under_631a_election_cut_by_trs_856cHiI(item);
    when us.irc.core::begins(y, first_day);
    then cut_timber_deemed_sold_to_trs_856cHiiI(t, y, item, first_day);
}
@source(IRC_S856_C, quote = "(I) For purposes of this subtitle, cut timber, the gain from which is recognized by a real estate investment trust pursuant to an election under section 631(a) described in clause (i)(I) or so much of clause (i)(III) as relates to clause (i)(I), shall be deemed to be sold to the taxable REIT")
rule Section856cHiiIDeemedSaleToTrsForHoldingPeriodPart(t: Person, y: TaxableYear, item: us.irc.core::Payment, first_day: Date) strict {
    label en official "section 856(c)(5)(H)(ii)(I): so much of clause (i)(III) as relates to clause (i)(I) is deemed sold likewise";
    when timber_gain_qualifies_856cHi(t, y, item);
    when income_would_be_timber_gain_but_for_one_year_holding_856cHiIII(item);
    when holding_period_failure_relates_to_631a_856cHiiI(item);
    when us.irc.core::begins(y, first_day);
    then cut_timber_deemed_sold_to_trs_856cHiiI(t, y, item, first_day);
}
pub relation timber_income_not_dealer_property_gain_856cHiiII(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the timber income is not treated as gain from the sale of property described in section 1221(a)(1)";
}
@source(IRC_S856_C, quote = "(II) For purposes of this subtitle, income described in this subparagraph shall not be treated as gain")
rule Section856cHiiIINotDealerGain(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(c)(5)(H)(ii)(II): income described in the subparagraph is not gain from the sale of dealer property";
    when timber_gain_qualifies_856cHi(t, y, item);
    then timber_income_not_dealer_property_gain_856cHiiII(t, y, item);
}
@source(IRC_S856_C, quote = "(iii) Termination.—This subparagraph shall not apply to dispositions after the termination date.")
pub relation timber_gain_after_termination_date_856cHiii(t: Person, item: us.irc.core::Payment) kind institutional {
    label en official "the disposition is after the termination date: the subparagraph does not apply";
}
rule Section856cHiiiAfterTerminationDate(t: Person, item: us.irc.core::Payment, on: Date, termination: Date) strict {
    label en official "section 856(c)(5)(H)(iii): the subparagraph does not apply to dispositions after the termination date";
    when timber_gain_disposition_date_856cH(item, on);
    when termination_date_857b6J(t, termination);
    when on > termination;
    then timber_gain_after_termination_date_856cHiii(t, item);
}
pub relation timber_real_property_assets_value_856cI(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of real property held in connection with the trade or business of producing timber";
}
pub relation total_assets_value_856cI(t: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the trust's total assets";
}
pub relation timber_real_estate_investment_trust_856cI(t: Person, y: TaxableYear) kind institutional {
    label en official "more than 50 percent in value of the trust's total assets consists of real property held in connection with the trade or business of producing timber";
}
@source(IRC_S856_C, quote = "means a real estate investment trust in which more than 50 percent in value of its total assets consists")
rule Section856cITimberReit(t: Person, y: TaxableYear, timber: Money, total: Money) strict {
    label en official "section 856(c)(5)(I): a timber real estate investment trust has more than 50 percent of the value of its total assets in timber-producing real property";
    when timber_real_property_assets_value_856cI(t, y, timber);
    when total_assets_value_856cI(t, y, total);
    when timber * 100.0 > total * 50.0;
    then timber_real_estate_investment_trust_856cI(t, y);
}

// ---- Section 856(c)(5)(K): foreign currency as cash ----

pub relation reit_or_qbu_uses_foreign_currency_as_functional_currency_856cK(t: Person) kind empirical {
    label en unofficial "the trust or its qualified business unit uses a foreign currency as its functional currency (section 985(b))";
}
pub relation foreign_currency_held_for_normal_course_activities_856cKi(asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the foreign currency is held for use in the normal course of the activities that give rise to (c)(2) or (c)(3) income or are directly related to acquiring or holding (c)(4) assets";
}
pub relation foreign_currency_held_in_connection_with_856n4_activity_856cKii(asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the foreign currency is held in connection with an activity described in subsection (n)(4)";
}
pub relation foreign_currency_counts_as_cash_856cK(t: Person, asset: us.irc.core::Asset) kind institutional {
    label en official "the foreign currency is included in the term cash";
}
@source(IRC_S856_C, quote = "(K) Cash.—If the real estate investment trust or its qualified business unit (as defined in section 989)")
rule Section856cKForeignCurrencyIsCash(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(5)(K): a functional foreign currency is cash to the extent held for the normal course of activities and not in connection with a (n)(4) activity";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitForeignCurrencyFunctional, value);
    when reit_or_qbu_uses_foreign_currency_as_functional_currency_856cK(t);
    when foreign_currency_held_for_normal_course_activities_856cKi(asset);
    when not_known(foreign_currency_held_in_connection_with_856n4_activity_856cKii(asset));
    then foreign_currency_counts_as_cash_856cK(t, asset);
}
@source(IRC_S856_C, quote = "(i) is held for use in the normal course of the activities of the trust or qualified business unit which")
rule Section856cKForeignCurrencyCountsInThe75PercentClass(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, value: Money) strict {
    label en official "section 856(c)(4)(A), (c)(5)(K): the cash foreign currency is in the 75-percent class of assets";
    when reit_asset_item_at_quarter_close(t, y, q, asset, ReitForeignCurrencyFunctional, value);
    when foreign_currency_counts_as_cash_856cK(t, asset);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}

// ---- Section 856(c)(7)(C)(ii): the period for the net income of the scheduled assets ----

pub relation first_failure_date_from_scheduled_assets_856c7Cii(t: Person, on: Date) kind empirical {
    label en unofficial "the first date on which the failure to satisfy paragraph (4) occurs as a result of the ownership of the scheduled assets";
}
pub relation scheduled_assets_disposed_on_856c7Cii(t: Person, on: Date) kind empirical {
    label en unofficial "the date on which the trust disposes of the scheduled assets";
}
pub relation end_of_first_quarter_without_failure_856c7Cii(t: Person, on: Date) kind empirical {
    label en unofficial "the end of the first quarter when there is no longer a failure to satisfy paragraph (4)";
}
pub relation net_income_period_end_candidate_856c7Cii(t: Person, on: Date) kind institutional {
    label en official "a date at which the net income period may end (helper for the earlier-of rule, G136)";
}
rule Section856c7CiiCandidateDisposal(t: Person, on: Date) strict {
    label en official "helper: the disposal date is a candidate end";
    when scheduled_assets_disposed_on_856c7Cii(t, on);
    then net_income_period_end_candidate_856c7Cii(t, on);
}
rule Section856c7CiiCandidateQuarterEnd(t: Person, on: Date) strict {
    label en official "helper: the end of the first failure-free quarter is a candidate end";
    when end_of_first_quarter_without_failure_856c7Cii(t, on);
    then net_income_period_end_candidate_856c7Cii(t, on);
}
pub relation earlier_net_income_period_end_candidate_exists_856c7Cii(t: Person, on: Date) kind institutional {
    label en official "a strictly earlier candidate end date exists (helper)";
}
rule Section856c7CiiEarlierCandidate(t: Person, on: Date, other: Date) strict {
    label en official "helper: a candidate end strictly earlier than the given one exists";
    when net_income_period_end_candidate_856c7Cii(t, on);
    when net_income_period_end_candidate_856c7Cii(t, other);
    when other < on;
    then earlier_net_income_period_end_candidate_exists_856c7Cii(t, on);
}
pub relation net_income_period_856c7Cii(t: Person, start: Date, end: Date) kind institutional {
    label en official "the period for the net income generated by the scheduled assets: from the first failure date to the earlier of the disposal and the end of the first failure-free quarter";
}
@source(IRC_S856_C, quote = "(ii) Period.—For purposes of clause (i)(II), the period described in this clause is the period beginning")
rule Section856c7CiiPeriod(t: Person, start: Date, end: Date) strict {
    label en official "section 856(c)(7)(C)(ii): the period begins on the first failure date and ends on the earlier of the disposal date and the end of the first quarter without a failure";
    when first_failure_date_from_scheduled_assets_856c7Cii(t, start);
    when net_income_period_end_candidate_856c7Cii(t, end);
    when not_known(earlier_net_income_period_end_candidate_exists_856c7Cii(t, end));
    when end >= start;
    then net_income_period_856c7Cii(t, start, end);
}

// ---- Section 856(e)(4)(C) flush and (e)(6)(C): use and independent contractor income ----

pub relation trust_activities_with_respect_to_property_on_856e4C(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the trust carries on activities with respect to the property on this date";
}
pub relation activities_produce_amounts_other_than_rents_from_real_property_856e4C(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the activities would result in amounts received or accrued with respect to the property being treated as other than rents from real property";
}
@source(IRC_S856_E, quote = "For purposes of subparagraph (C), property shall not be treated as used in a trade or business by reason")
rule Section856e4CFlushActivitiesThatMakeUse(t: Person, p: us.irc.core::Asset, on: Date) strict {
    label en official "section 856(e)(4) flush: activities make the property used in a trade or business only to the extent they would result in amounts other than rents from real property";
    when trust_activities_with_respect_to_property_on_856e4C(t, p, on);
    when activities_produce_amounts_other_than_rents_from_real_property_856e4C(t, p, on);
    then property_used_in_trade_or_business_of_trust_on_856e4C(t, p, on);
}
pub enum IcIncomeDisregardBasis856e6C {
    BasisLeaseInEffectOnAcquisition;
    BasisSimilarNewLease;
    label en unofficial "the basis on which independent contractor income is disregarded for paragraph (4)(C)";
}
pub relation independent_contractor_income_from_health_care_property_856e6C(t: Person, p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the income derived or received by the trust from an independent contractor with respect to the qualified health care property";
}
pub relation lease_in_effect_on_acquisition_income_856e6Ci(t: Person, p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the part of the income attributable to a lease in effect on the acquisition date (or its renewal under the terms of the lease as in effect on that date)";
}
pub relation trust_lease_of_property_in_effect_on_acquisition_856e6CiiI(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "on the acquisition date a lease of the property from the trust was in effect";
}
pub relation income_from_new_lease_856e6Cii(t: Person, p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the part of the income attributable to a lease of the property entered into after the acquisition date";
}
external judgment relation new_lease_substantially_similar_or_lesser_benefit_856e6CiiII(t: Person, p: us.irc.core::Asset) {
    authority Secretary;
    label en official "under the terms of the new lease the trust receives a substantially similar or lesser benefit in comparison to the lease in effect on the acquisition date; an evaluative element, DECISION-0194 channel 1";
}
pub relation independent_contractor_income_disregarded_856e6C(t: Person, p: us.irc.core::Asset, basis: IcIncomeDisregardBasis856e6C, amount: Money) kind institutional {
    label en official "the independent contractor income disregarded for paragraph (4)(C), on the given basis (capped at the income received)";
}
@source(IRC_S856_E, quote = "(i) any lease of property in effect on the date the real estate investment trust acquired the qualified")
rule Section856e6CiLeaseInEffectOnAcquisition(t: Person, p: us.irc.core::Asset, income: Money, attributable: Money) strict {
    label en official "section 856(e)(6)(C)(i): income attributable to a lease in effect on the acquisition date is disregarded";
    when qualified_health_care_property_856e6D(p);
    when foreclosure_property_by_acquisition_856e1(t, p);
    when independent_contractor_income_from_health_care_property_856e6C(t, p, income);
    when lease_in_effect_on_acquisition_income_856e6Ci(t, p, attributable);
    then independent_contractor_income_disregarded_856e6C(t, p, BasisLeaseInEffectOnAcquisition, min(income, attributable));
}
@source(IRC_S856_E, quote = "(ii) any lease of property entered into after such date if—")
rule Section856e6CiiSimilarNewLease(t: Person, p: us.irc.core::Asset, income: Money, attributable: Money) strict {
    label en official "section 856(e)(6)(C)(ii): income attributable to a new lease, when a trust lease was in effect on the acquisition date and the new lease gives a substantially similar or lesser benefit, is disregarded";
    when qualified_health_care_property_856e6D(p);
    when foreclosure_property_by_acquisition_856e1(t, p);
    when independent_contractor_income_from_health_care_property_856e6C(t, p, income);
    when income_from_new_lease_856e6Cii(t, p, attributable);
    when trust_lease_of_property_in_effect_on_acquisition_856e6CiiI(t, p);
    when new_lease_substantially_similar_or_lesser_benefit_856e6CiiII(t, p);
    then independent_contractor_income_disregarded_856e6C(t, p, BasisSimilarNewLease, min(income, attributable));
}

// ---- Section 856(f): interest determined by income or profits ----

pub relation interest_item_amount_856f1B(item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount received or accrued that would be excluded from interest solely because the debtor's receipts depend on income or profits of a person";
}
pub relation proportion_excluded_pursuant_to_regulations_856f1B(item: us.irc.core::Payment, fraction: Decimal) kind empirical {
    label en unofficial "the proportionate part determined pursuant to regulations prescribed by the Secretary (an input: G4902)";
}
pub relation interest_amount_excluded_856f1B(item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "only a proportionate part of the amount is excluded from the term interest";
}
@source(IRC_S856_F, quote = "solely because the debtor of the real estate investment trust receives or accrues any amount the")
rule Section856f1BProportionateExclusion(item: us.irc.core::Payment, amount: Money, fraction: Decimal) strict {
    label en official "section 856(f)(1)(B): only the regulation proportion of an amount excluded solely by the debtor's income dependence is excluded (cents HALF_UP)";
    when interest_item_amount_856f1B(item, amount);
    when proportion_excluded_pursuant_to_regulations_856f1B(item, fraction);
    then interest_amount_excluded_856f1B(item, round(amount * fraction, 2, "HALF_UP"));
}
pub relation debtor_derives_substantially_all_income_from_leasing_856f2A(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the debtor derives substantially all of its gross income with respect to the property (not counting gain on disposition) from leasing substantially all of its interests to tenants";
}
pub relation obligation_secured_by_mortgage_on_real_property_856f2A(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amounts are received or accrued with respect to an obligation secured by a mortgage on real property or an interest in real property";
}
pub relation amount_attributable_to_qualified_rents_of_debtor_856f2(item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the part of the amounts received attributable to qualified rents (section 856(d)(6)(B)) received or accrued by the debtor from tenants";
}
pub relation interest_item_amount_856f2(item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amounts the trust receives or accrues from the debtor";
}
pub relation interest_not_excluded_for_income_dependence_856f2(item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the amounts are not excluded from the term interest by reason of being based on the debtor's income or profits, to the extent attributable to qualified rents";
}
@source(IRC_S856_F, quote = "by reason of being based on the income or profits of such debtor to the extent the amounts so received")
rule Section856f2QualifiedRentsPart(item: us.irc.core::Payment, amount: Money, attributable: Money) strict {
    label en official "section 856(f)(2): the part attributable to qualified rents received by a debtor that leases substantially all its interests is not excluded from interest";
    when obligation_secured_by_mortgage_on_real_property_856f2A(item);
    when debtor_derives_substantially_all_income_from_leasing_856f2A(item);
    when interest_item_amount_856f2(item, amount);
    when amount_attributable_to_qualified_rents_of_debtor_856f2(item, attributable);
    then interest_not_excluded_for_income_dependence_856f2(item, min(amount, attributable));
}

// ---- Section 856(j)(2)(A), (3): shared appreciation provisions ----

pub relation trust_acquired_shared_appreciation_provision_on_856j2A(t: Person, item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date the trust began holding the shared appreciation provision";
}
pub relation secured_property_acquired_by_holder_on_856j2A(item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the date the person holding the secured property began holding it";
}
pub relation trust_treated_as_holding_secured_property_since_856j2A(t: Person, item: us.irc.core::Payment, since: Date) kind institutional {
    label en official "the trust is treated as holding the secured property since this date (the shorter of the two holding periods starts on the later of the two dates)";
}
@source(IRC_S856_J, quote = "(A) the real estate investment trust shall be treated as holding the secured property for the period")
rule Section856j2AHoldingStartProvisionLater(t: Person, item: us.irc.core::Payment, provision_on: Date, property_on: Date) strict {
    label en official "section 856(j)(2)(A): the holding period of the provision is the shorter one";
    when trust_acquired_shared_appreciation_provision_on_856j2A(t, item, provision_on);
    when secured_property_acquired_by_holder_on_856j2A(item, property_on);
    when provision_on >= property_on;
    then trust_treated_as_holding_secured_property_since_856j2A(t, item, provision_on);
}
rule Section856j2AHoldingStartPropertyLater(t: Person, item: us.irc.core::Payment, provision_on: Date, property_on: Date) strict {
    label en official "section 856(j)(2)(A): the holding period of the secured property is the shorter one";
    when trust_acquired_shared_appreciation_provision_on_856j2A(t, item, provision_on);
    when secured_property_acquired_by_holder_on_856j2A(item, property_on);
    when property_on > provision_on;
    then trust_treated_as_holding_secured_property_since_856j2A(t, item, property_on);
}
pub relation trust_treated_as_having_sold_secured_property_856j3A(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the trust is treated as having sold the secured property when it recognizes shared appreciation income";
}
@source(IRC_S856_J, quote = "(A) the real estate investment trust shall be treated as having sold the secured property when it")
rule Section856j3ATreatedAsSold(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(j)(3)(A): recognition of shared appreciation income is a sale of the secured property by the trust";
    when income_from_shared_appreciation_provision_856j1(t, y, item);
    then trust_treated_as_having_sold_secured_property_856j3A(t, y, item);
}
pub relation expenditure_treated_as_made_by_trust_856j3B(t: Person, item: us.irc.core::Payment) kind institutional {
    label en official "expenditures made by any holder of the secured property are treated as made by the trust";
}
@source(IRC_S856_J, quote = "(B) any expenditures made by any holder of the secured property shall be treated as made by the real")
rule Section856j3BHolderExpenditureIsTrustExpenditure(t: Person, item: us.irc.core::Payment) strict {
    label en official "section 856(j)(3)(B): any holder's expenditure is the trust's";
    when shared_appreciation_sale_expenditures_by_holder_856j3B(t, item);
    then expenditure_treated_as_made_by_trust_856j3B(t, item);
}

// ---- Section 856(l): taxable REIT subsidiaries ----

pub relation trust_consents_to_trs_election_revocation_856l1(t: Person, c: Corporation) kind empirical {
    label en unofficial "the trust consents to the revocation of the taxable REIT subsidiary election";
}
pub relation corporation_consents_to_trs_election_revocation_856l1(c: Corporation, t: Person) kind empirical {
    label en unofficial "the corporation consents to the revocation of the taxable REIT subsidiary election";
}
pub relation trs_election_revoked_856l1(t: Person, c: Corporation) kind institutional {
    label en official "the election was revoked with the consent of both the trust and the corporation (no Secretary consent is needed)";
}
@source(IRC_S856_L, quote = "Such an election, once made, shall be irrevocable unless both such trust and corporation consent to its")
rule Section856l1JointRevocation(t: Person, c: Corporation) strict {
    label en official "section 856(l)(1) flush: an election is irrevocable unless both the trust and the corporation consent to its revocation, without the consent of the Secretary";
    when trs_joint_election_856l1B(t, c);
    when trust_consents_to_trs_election_revocation_856l1(t, c);
    when corporation_consents_to_trs_election_revocation_856l1(c, t);
    then trs_election_revoked_856l1(t, c);
}
pub relation trs_securities_value_in_corporation_856l2B(sub: Corporation, c: Corporation, value: Money) kind empirical {
    label en unofficial "the value of the securities of the corporation owned directly or indirectly by the taxable REIT subsidiary";
}
pub relation corporation_outstanding_securities_value_856l2B(c: Corporation, value: Money) kind empirical {
    label en unofficial "the total value of the outstanding securities of the corporation";
}
pub relation section_856m2A_securities_value_of_corporation_856l2B(c: Corporation, value: Money) kind empirical {
    label en unofficial "the value of the corporation's outstanding securities described in subsection (m)(2)(A) (straight debt), which are not taken into account";
}
pub relation wholly_owned_by_reit_excluded_856l2(t: Person, c: Corporation) kind institutional {
    label en official "the corporation is wholly owned by the trust, so the 35 percent ownership rule does not reach it (the qualified REIT subsidiary sentence of section 856(l)(2), read at the level of ownership to avoid the cycle through taxable REIT subsidiary status: JUDGMENT CALL)";
}
@source(IRC_S856_L, quote = "The preceding sentence shall not apply to a qualified REIT subsidiary (as defined in subsection (i)(2)). For purposes of subparagraph (B), securities described in subsection (m)(2)(A) shall not be taken into account.")
rule Section856l2WhollyOwnedIsNotReached(t: Person, c: Corporation, pct: Decimal) strict {
    label en official "section 856(l)(2), last sentence: the preceding sentence does not apply to a qualified REIT subsidiary (a corporation 100 percent owned by the trust)";
    when reit_holds_percent_of_stock_856i2(t, c, pct);
    when pct >= 100.0;
    then wholly_owned_by_reit_excluded_856l2(t, c);
}
@source(IRC_S856_L, quote = "The preceding sentence shall not apply to a qualified REIT subsidiary (as defined in subsection (i)(2)).")
rule Section856l2BValueTestExcludingStraightDebt(sub: Corporation, c: Corporation, held: Money, total: Money, excluded: Money) strict {
    label en official "section 856(l)(2)(B), flush: the 35 percent value test does not take into account the securities described in subsection (m)(2)(A)";
    when trs_securities_value_in_corporation_856l2B(sub, c, held);
    when corporation_outstanding_securities_value_856l2B(c, total);
    when section_856m2A_securities_value_of_corporation_856l2B(c, excluded);
    when held * 100.0 > (total - excluded) * 35.0;
    then trs_holds_more_than_35_percent_of_value_856l2B(sub, c);
}

// ---- Section 856(m)(2)(B)(ii), (3)(B), (4)(A) ----

pub relation payment_contingent_856m2B(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the time or amount of a payment on the security is contingent";
}
pub relation contingency_absent_or_permitted_856m2B(sec: us.irc.core::Asset) kind institutional {
    label en official "the security has no contingency, or its contingency is one of the permitted kinds of clause (i) or (ii)";
}
@source(IRC_S856_M, quote = "(ii) the time or amount of payment is subject to a contingency upon a default or the exercise of a")
rule Section856m2BNoContingency(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(2)(B): no contingent payment";
    when straight_debt_per_1361c5_856m2A(sec);
    when not_known(payment_contingent_856m2B(sec));
    then contingency_absent_or_permitted_856m2B(sec);
}
rule Section856m2BiPermittedYieldContingency(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(2)(B)(i): a contingency within the yield or small-issue limits is permitted";
    when payment_contingent_856m2B(sec);
    when contingency_yield_test_met_856m2Bi(sec);
    then contingency_absent_or_permitted_856m2B(sec);
}
rule Section856m2BiiPermittedCustomaryContingency(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(2)(B)(ii): a contingency upon default or prepayment consistent with customary commercial practice is permitted";
    when payment_contingent_856m2B(sec);
    when contingency_upon_default_or_prepayment_consistent_with_commercial_practice_856m2Bii(sec);
    then contingency_absent_or_permitted_856m2B(sec);
}
pub relation trust_held_partnership_securities_value_856m3Bi(t: Person, pt: us.irc.core::Partnership, value: Money) kind empirical {
    label en unofficial "the value of the securities issued by the partnership held by the trust, without regard to (A)(i) and paragraph (4), not including securities described in paragraph (1)";
}
pub relation partnership_total_securities_value_856m3Bi(pt: us.irc.core::Partnership, value: Money) kind empirical {
    label en unofficial "the value of all securities issued by the partnership (not including securities described in paragraph (1))";
}
pub relation trust_proportionate_interest_in_partnership_securities_856m3Bi(t: Person, pt: us.irc.core::Partnership, share: Decimal) kind institutional {
    label en official "the trust's interest in the partnership assets is its proportionate interest in the partnership's securities";
}
@source(IRC_S856_M, quote = "(i) the trust's interest in the partnership assets shall be the trust's proportionate interest in any")
rule Section856m3BiProportionateInterest(t: Person, pt: us.irc.core::Partnership, held: Money, total: Money) strict {
    label en official "section 856(m)(3)(B)(i): the proportionate interest in the partnership's securities (6 decimals, HALF_UP: JUDGMENT CALL)";
    when trust_held_partnership_securities_value_856m3Bi(t, pt, held);
    when partnership_total_securities_value_856m3Bi(pt, total);
    when total > 0.00 USD;
    then trust_proportionate_interest_in_partnership_securities_856m3Bi(t, pt, div_round(held / 1.00 USD, total / 1.00 USD, 6, "HALF_UP"));
}
pub relation adjusted_issue_price_1272a4_of_debt_856m3Bii(debt: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted issue price of the debt instrument as defined in section 1272(a)(4)";
}
pub relation debt_instrument_value_for_856m3B_856m3Bii(debt: us.irc.core::Asset, value: Money) kind institutional {
    label en official "the value of the debt instrument is its adjusted issue price";
}
@source(IRC_S856_M, quote = "(ii) the value of any debt instrument shall be the adjusted issue price thereof, as defined in section")
rule Section856m3BiiDebtValueIsAdjustedIssuePrice(debt: us.irc.core::Asset, price: Money) strict {
    label en official "section 856(m)(3)(B)(ii): the value of any debt instrument is its adjusted issue price";
    when adjusted_issue_price_1272a4_of_debt_856m3Bii(debt, price);
    then debt_instrument_value_for_856m3B_856m3Bii(debt, price);
}
pub relation trust_interest_as_partner_856m4A(t: Person, pt: us.irc.core::Partnership, share: Decimal) kind empirical {
    label en unofficial "the trust's interest as a partner in the partnership, as a share";
}
pub relation partnership_debt_value_856m4A(pt: us.irc.core::Partnership, debt: us.irc.core::Asset, value: Money) kind empirical {
    label en unofficial "the value of the partnership's debt instrument not described in paragraph (1)";
}
pub relation partnership_debt_portion_not_a_security_856m4A(t: Person, pt: us.irc.core::Partnership, debt: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the part of the partnership's debt instrument that is not considered a security: to the extent of the trust's interest as a partner";
}
@source(IRC_S856_M, quote = "(A) any debt instrument issued by a partnership and not described in paragraph (1) shall not be")
rule Section856m4ADebtNotSecurityToExtentOfPartnerInterest(t: Person, pt: us.irc.core::Partnership, debt: us.irc.core::Asset, share: Decimal, value: Money) strict {
    label en official "section 856(m)(4)(A): the debt is not a security to the extent of the trust's interest as a partner (cents HALF_UP)";
    when partnership_debt_instrument_856m4(pt, debt);
    when trust_interest_as_partner_856m4A(t, pt, share);
    when partnership_debt_value_856m4A(pt, debt, value);
    then partnership_debt_portion_not_a_security_856m4A(t, pt, debt, round(value * share, 2, "HALF_UP"));
}
