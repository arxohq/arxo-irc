// Section 832(b)(4)(C), (6), (7), (8): the transitional addback, expenses
// incurred, and the special rules for premiums earned (stage 3b, IRC-09
// stage 3b, TECH_GAP reduction), 26.09.2026. Status implemented_unverified;
// nothing here was executed.
//
// METHOD. The transitional (4)(C) addback of 3 1/3 percent (one thirtieth)
// of the unearned premiums at the end of the most recent taxable year that
// began before 1987 is now part of premiums earned (module 03 reads it):
// outside the phase-in window the addback is derived as zero, so ordinary
// cases are unchanged. The base is taken net of the contracts the special
// rules remove ((7)(A) life reserves, (8)(A)(ii) title insurance) with the
// insured-securities premiums at 1 2/3 percent (one sixtieth) under
// (7)(B)(ii); the components are case figures (one relation, all five
// amounts). The phase-in window is the general one (years beginning after
// 1986-12-31 and before 1993-01-01), or the late one of (7)(D)(ii) with the
// two substitutions; the (7)(D)(i) exception removes companies that were
// not taxable before 1987 by reason of section 821(c) or 501(c). The
// (7)(C) acceleration multiplies the annual addback by the number of years
// still to run (an asserted count). Reciprocals under (7)(E) include their
// premium acquisition expenses in unearned premiums and adjust the (C)
// base by the difference (I) minus (II) (a JUDGMENT CALL on "appropriate
// adjustments"). The discounted unearned premiums of (8)(B) are the sum of
// the undiscounted unearned premiums by calendar year of receipt, times the
// statutory recognition percentage of each future year, times the discount
// factor of that year (the factors incorporate the mid-year receipt
// assumption and the rate; the power (1 + i)^(k - 1/2) is not computable
// here, G5306). Sums over derived items follow G4903.

// ---- Section 832(b)(7)(D): who is in the phase-in ----

use self::{
    IRC_S832_B,
    Person,
    TaxableYear,
    discounted_unearned_premiums_end_of_year_832b8,
    expenses_incurred_832b6,
    gross_premiums_written,
    undiscounted_unearned_premiums_832b8Ci,
    unearned_premiums_end_of_prior_year,
    unearned_premiums_end_of_year,
};

pub relation year_before_1987_subject_to_tax_821a_831a_832b7Di(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "in this taxable year beginning before 1987 the company was subject to the tax imposed by section 821(a) or 831(a) (as in effect before the Tax Reform Act of 1986)";
}
pub relation not_taxed_before_1987_by_reason_of_821c_or_501c_832b7Di(c: Person) kind empirical {
    label en unofficial "for the taxable years beginning before 1987 the company was not subject to those taxes by reason of being subject to section 821(c) tax or being exempt under section 501(a)";
}
pub relation subject_to_tax_in_some_year_before_1987_832b7Di(c: Person) kind institutional {
    label en official "the company was subject to the tax of section 821(a) or 831(a) in some taxable year beginning before 1987 (helper)";
}
rule Section832b7DiSubjectInSomeYear(c: Person, y: TaxableYear) strict {
    label en official "helper";
    when year_before_1987_subject_to_tax_821a_831a_832b7Di(c, y);
    then subject_to_tax_in_some_year_before_1987_832b7Di(c);
}
pub relation exempt_from_transitional_addback_832b7Di(c: Person) kind institutional {
    label en official "subparagraph (C) of paragraph (4) does not apply to the company";
}
@source(IRC_S832_B, quote = "Subparagraph (C) of paragraph (4) shall not apply to any insurance company which, for each taxable year")
rule Section832b7DiNoPhaseIn(c: Person) strict {
    label en official "section 832(b)(7)(D)(i): a company that in each pre-1987 year was outside sections 821(a) and 831(a) by reason of section 821(c) or 501(c) has no phase-in";
    when not_taxed_before_1987_by_reason_of_821c_or_501c_832b7Di(c);
    when not_known(subject_to_tax_in_some_year_before_1987_832b7Di(c));
    then exempt_from_transitional_addback_832b7Di(c);
}
@source(IRC_S832_B, quote = "(I) subject to tax under section 821(c) [1] (as so in effect), or")
pub relation subject_to_821c_tax_before_1987_832b7DiI(c: Person) kind empirical {
    label en unofficial "subclause (I): the company was subject to tax under section 821(c) (as in effect before the 1986 Act)";
}
@source(IRC_S832_B, quote = "(II) described in section 501(c) (as so in effect) and exempt from tax under section 501(a).")
pub relation exempt_under_501c_before_1987_832b7DiII(c: Person) kind empirical {
    label en unofficial "subclause (II): the company was described in section 501(c) (as so in effect) and exempt from tax under section 501(a)";
}
rule Section832b7DiReasonIsSection821cOr501cFirst(c: Person) strict {
    label en official "section 832(b)(7)(D)(i)(I): the reason for being outside sections 821(a) and 831(a) is section 821(c) tax";
    when subject_to_821c_tax_before_1987_832b7DiI(c);
    then not_taxed_before_1987_by_reason_of_821c_or_501c_832b7Di(c);
}
rule Section832b7DiReasonIsSection821cOr501cSecond(c: Person) strict {
    label en official "section 832(b)(7)(D)(i)(II): the reason for being outside sections 821(a) and 831(a) is section 501(a) exemption";
    when exempt_under_501c_before_1987_832b7DiII(c);
    then not_taxed_before_1987_by_reason_of_821c_or_501c_832b7Di(c);
}
pub relation not_subject_to_831a_first_year_after_1986_832b7DiiI(c: Person) kind empirical {
    label en unofficial "the company was not subject to the tax of section 831(a) for its first taxable year beginning after 1986, by reason of being subject to tax under section 831(b) or exempt under section 501(a)";
}
pub relation subject_to_821a_or_831a_before_1987_832b7DiiII(c: Person) kind empirical {
    label en unofficial "for some taxable year beginning before 1987 the company was subject to the tax of section 821(a) or 831(a) (as in effect before the 1986 Act)";
}
pub relation first_year_subject_to_831a_after_1986_832b7Dii(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the first taxable year beginning after 1986 for which the company is subject to the tax imposed by section 831(a)";
}
pub relation seventh_succeeding_taxable_year_832b7Dii(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the 7th taxable year succeeding the first year subject to section 831(a)";
}
pub relation late_phase_in_company_832b7Dii(c: Person) kind institutional {
    label en official "the company's phase-in begins at a later date (clauses (I) and (II) both hold)";
}
@source(IRC_S832_B, quote = "In the case of an insurance company—")
rule Section832b7DiiLatePhaseInCompany(c: Person) strict {
    label en official "section 832(b)(7)(D)(ii): a company outside section 831(a) in its first post-1986 year (by reason of section 831(b) or 501(c)) that was taxable before 1987";
    when not_subject_to_831a_first_year_after_1986_832b7DiiI(c);
    when subject_to_821a_or_831a_before_1987_832b7DiiII(c);
    then late_phase_in_company_832b7Dii(c);
}
pub relation transitional_period_year_832b4C(c: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year is one for which the transitional addback of paragraph (4)(C) applies";
}
@source(IRC_S832_B, quote = "subparagraph (C) of paragraph (4) shall apply beginning with the 1st taxable year beginning after")
rule Section832b4CGeneralPeriod(c: Person, y: TaxableYear, written: Money, begins_on: Date) strict {
    label en official "section 832(b)(4)(C): a taxable year beginning after December 31, 1986, and before January 1, 1993";
    when gross_premiums_written(c, y, written);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @1986-12-31;
    when begins_on < @1993-01-01;
    when not_known(late_phase_in_company_832b7Dii(c));
    when not_known(exempt_from_transitional_addback_832b7Di(c));
    then transitional_period_year_832b4C(c, y);
}
@source(IRC_S832_B, quote = "subparagraph (C) of paragraph (4) shall apply beginning with the 1st taxable year beginning after December 31, 1986, for which such company is subject to the tax imposed by section 831(a) and shall be applied by substituting the last day of the preceding taxable year for")
rule Section832b7DiiLatePeriod(c: Person, y: TaxableYear, written: Money, first: TaxableYear, seventh: TaxableYear, begins_on: Date, first_begins: Date, seventh_begins: Date) strict {
    label en official "section 832(b)(7)(D)(ii): from the first year subject to section 831(a) to the 1st day of the 7th succeeding taxable year";
    when gross_premiums_written(c, y, written);
    when late_phase_in_company_832b7Dii(c);
    when first_year_subject_to_831a_after_1986_832b7Dii(c, first);
    when seventh_succeeding_taxable_year_832b7Dii(c, seventh);
    when us.irc.core::begins(y, begins_on);
    when us.irc.core::begins(first, first_begins);
    when us.irc.core::begins(seventh, seventh_begins);
    when begins_on >= first_begins;
    when begins_on < seventh_begins;
    then transitional_period_year_832b4C(c, y);
}

// ---- Section 832(b)(4)(C) with (7)(A), (B), (E), (8)(A): the addback ----

pub relation transitional_reference_components_832b4C(c: Person, total: Money, life: Money, securities: Money, title: Money) kind empirical {
    label en unofficial "the unearned premiums at the end of the reference taxable year (the most recent year beginning before 1987; for a late phase-in the year before it), the part on life insurance contracts of section 816(b)(1)(B), the part attributable to insuring securities of section 165(g)(2)(C) with maturities over 5 years, and the part on title insurance";
}
pub relation reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c: Person) kind empirical {
    label en unofficial "the company is a reciprocal (section 835(a)) that reports, as required by State law, reserves on unearned premiums net of premium acquisition expenses";
}
pub relation unearned_reserves_net_before_1987_832b7EiiI(c: Person, amount: Money) kind empirical {
    label en unofficial "the reserves at the close of the most recent taxable year beginning before 1987 (subclause (I))";
}
pub relation premium_acquisition_expenses_before_1987_832b7EiiII(c: Person, amount: Money) kind empirical {
    label en unofficial "the premium acquisition expenses at the close of that year";
}
pub relation reciprocal_adjustment_832b7Eii(c: Person, amount: Money) kind institutional {
    label en official "the appropriate adjustment to the (4)(C) base for a reciprocal: (I) less 80 percent of the sum of (I) and the expenses (a JUDGMENT CALL)";
}
@source(IRC_S832_B, quote = "(ii) appropriate adjustments shall be made under subparagraph (c) of paragraph (4) to reflect the amount")
rule Section832b7EiiReciprocalAdjustment(c: Person, reserves: Money, expenses: Money) strict {
    label en official "section 832(b)(7)(E)(ii): the amount by which the reserves are greater or less than 80 percent of the sum of the reserves and the expenses";
    when reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c);
    when unearned_reserves_net_before_1987_832b7EiiI(c, reserves);
    when premium_acquisition_expenses_before_1987_832b7EiiII(c, expenses);
    then reciprocal_adjustment_832b7Eii(c, reserves - round((reserves + expenses) * 0.80, 2, "HALF_UP"));
}
rule Section832b7EiiNoReciprocalAdjustment(c: Person, total: Money, life: Money, securities: Money, title: Money) strict {
    label en official "section 832(b)(7)(E)(ii): no adjustment for a company that is not such a reciprocal";
    when transitional_reference_components_832b4C(c, total, life, securities, title);
    when not_known(reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c));
    then reciprocal_adjustment_832b7Eii(c, 0.00 USD);
}
pub relation transitional_addback_832b4C(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount added to premiums earned for the taxable year under paragraph (4)(C)";
}
@source(IRC_S832_B, quote = "(ii) subparagraph (C) of paragraph (4) shall be applied by substituting")
rule Section832b4CAddback(c: Person, y: TaxableYear, total: Money, life: Money, securities: Money, title: Money, adjustment: Money) strict {
    label en official "sections 832(b)(4)(C), (7)(A), (7)(B)(ii), (8)(A)(ii): one thirtieth of the reference unearned premiums (without life and title contracts, adjusted for a reciprocal), plus one sixtieth of the insured-securities premiums (cents HALF_UP)";
    when transitional_period_year_832b4C(c, y);
    when transitional_reference_components_832b4C(c, total, life, securities, title);
    when reciprocal_adjustment_832b7Eii(c, adjustment);
    then transitional_addback_832b4C(c, y, div_round(((total - life) - (securities + title)) + adjustment, 30.0, 2, "HALF_UP") + div_round(securities, 60.0, 2, "HALF_UP"));
}
rule Section832b4CNoAddbackOutsidePeriod(c: Person, y: TaxableYear, written: Money) strict {
    label en official "section 832(b)(4)(C): outside the transitional period nothing is added";
    when gross_premiums_written(c, y, written);
    when not_known(transitional_period_year_832b4C(c, y));
    then transitional_addback_832b4C(c, y, 0.00 USD);
}

// ---- Section 832(b)(7)(C): cessation before 1993 ----

pub relation ceases_to_be_831a_company_in_year_832b7C(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer ceases, in this taxable year beginning before 1993, to be an insurance company taxable under section 831(a)";
}
pub relation remaining_transitional_years_832b7C(c: Person, years: Integer) kind empirical {
    label en unofficial "the number of taxable years, from the cessation year on, for which the paragraph (4)(C) adjustment would have been made but for the cessation";
}
pub relation aggregate_transitional_adjustments_made_for_preceding_year_832b7C(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the aggregate paragraph (4)(C) adjustments that would have been made for the cessation year and later years are made for the year preceding the cessation year";
}
@source(IRC_S832_B, quote = "Except as provided in section 381(c)(22) (relating to carryovers in certain corporate readjustments),")
rule Section832b7CAccelerateAdjustments(c: Person, cessation: TaxableYear, before: TaxableYear, years: Integer, annual: Money, cessation_begins: Date, before_ends: Date) strict {
    label en official "section 832(b)(7)(C): the annual (4)(C) addback times the remaining years is made for the year preceding the cessation year (the section 381(c)(22) exception is not represented)";
    when ceases_to_be_831a_company_in_year_832b7C(c, cessation);
    when remaining_transitional_years_832b7C(c, years);
    when transitional_addback_832b4C(c, cessation, annual);
    when us.irc.core::begins(cessation, cessation_begins);
    when cessation_begins < @1993-01-01;
    when us.irc.core::year_of(c, before);
    when us.irc.core::ends(before, before_ends);
    when cessation_begins <= add_calendar_period(before_ends, 1 calendar_day);
    when cessation_begins >= add_calendar_period(before_ends, 1 calendar_day);
    then aggregate_transitional_adjustments_made_for_preceding_year_832b7C(c, before, annual * years);
}

// ---- Section 832(b)(7)(E)(i): reciprocals' unearned premiums ----

pub relation premium_acquisition_expenses_end_of_year_832b7E(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the premium acquisition expenses netted against unearned premiums at the end of the taxable year";
}
pub relation premium_acquisition_expenses_end_of_prior_year_832b7E(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the premium acquisition expenses netted against unearned premiums at the end of the preceding taxable year";
}
pub relation unearned_premiums_end_of_year_for_832b4B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unearned premiums at the end of the taxable year as used in paragraph (4)(B) (a reciprocal's include its acquisition expenses)";
}
pub relation unearned_premiums_end_of_prior_year_for_832b4B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the unearned premiums at the end of the preceding taxable year as used in paragraph (4)(B)";
}
rule Section832b4BUnearnedEndOrdinary(c: Person, y: TaxableYear, unearned: Money) strict {
    label en official "section 832(b)(4)(B): the unearned premiums at the end of the year";
    when unearned_premiums_end_of_year(c, y, unearned);
    when not_known(reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c));
    then unearned_premiums_end_of_year_for_832b4B(c, y, unearned);
}
rule Section832b4BUnearnedPriorOrdinary(c: Person, y: TaxableYear, unearned: Money) strict {
    label en official "section 832(b)(4)(B): the unearned premiums at the end of the preceding year";
    when unearned_premiums_end_of_prior_year(c, y, unearned);
    when not_known(reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c));
    then unearned_premiums_end_of_prior_year_for_832b4B(c, y, unearned);
}
@source(IRC_S832_B, quote = "(i) subparagraph (B) of paragraph (4) shall be applied by treating unearned premiums as including an")
rule Section832b7EiReciprocalUnearnedEnd(c: Person, y: TaxableYear, unearned: Money, expenses: Money) strict {
    label en official "section 832(b)(7)(E)(i): a reciprocal treats unearned premiums as including the acquisition expenses (end of year)";
    when reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c);
    when unearned_premiums_end_of_year(c, y, unearned);
    when premium_acquisition_expenses_end_of_year_832b7E(c, y, expenses);
    then unearned_premiums_end_of_year_for_832b4B(c, y, unearned + expenses);
}
rule Section832b7EiReciprocalUnearnedPrior(c: Person, y: TaxableYear, unearned: Money, expenses: Money) strict {
    label en official "section 832(b)(7)(E)(i): a reciprocal treats unearned premiums as including the acquisition expenses (end of preceding year)";
    when reciprocal_reports_reserves_net_of_acquisition_expenses_832b7E(c);
    when unearned_premiums_end_of_prior_year(c, y, unearned);
    when premium_acquisition_expenses_end_of_prior_year_832b7E(c, y, expenses);
    then unearned_premiums_end_of_prior_year_for_832b4B(c, y, unearned + expenses);
}

// ---- Section 832(b)(6): expenses incurred ----

pub relation expenses_paid_during_year_832b6(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "all expenses paid during the taxable year, as shown on the annual statement approved by the NAIC";
}
pub relation expenses_unpaid_end_of_year_832b6(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "expenses unpaid at the end of the taxable year, not including unpaid loss adjustment expenses (those are unpaid losses)";
}
pub relation expenses_unpaid_end_of_prior_year_832b6(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "expenses unpaid at the end of the preceding taxable year, not including unpaid loss adjustment expenses";
}
@source(IRC_S832_B, quote = "means all expenses shown on the annual statement approved by the National Association of Insurance")
rule Section832b6ExpensesIncurred(c: Person, y: TaxableYear, paid: Money, unpaid_end: Money, unpaid_prior: Money) strict {
    label en official "section 832(b)(6): expenses incurred = paid + unpaid at the end of the year - unpaid at the end of the preceding year";
    when expenses_paid_during_year_832b6(c, y, paid);
    when expenses_unpaid_end_of_year_832b6(c, y, unpaid_end);
    when expenses_unpaid_end_of_prior_year_832b6(c, y, unpaid_prior);
    then expenses_incurred_832b6(c, y, (paid + unpaid_end) - unpaid_prior);
}
pub relation expenses_not_allowed_as_deductions_by_832c_832b6(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "expenses incurred which are not allowed as deductions by subsection (c)";
}
pub relation expenses_incurred_for_section_831_tax_832b6(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for computing the taxable income subject to the section 831 tax, expenses incurred less the expenses not allowed as deductions by subsection (c)";
}
rule Section832b6ExpensesForSection831(c: Person, y: TaxableYear, incurred: Money, disallowed: Money) strict {
    label en official "section 832(b)(6) last sentence: expenses incurred not allowed by subsection (c) are deducted from expenses incurred";
    when expenses_incurred_832b6(c, y, incurred);
    when expenses_not_allowed_as_deductions_by_832c_832b6(c, y, disallowed);
    then expenses_incurred_for_section_831_tax_832b6(c, y, incurred - disallowed);
}

// ---- Section 832(b)(8): discounted unearned premiums of title insurance ----

pub relation applicable_statutory_pattern_percent_832b8Ciii(c: Person, calendar_year_of_receipt: Integer, k: Integer, percent: Decimal) kind empirical {
    label en unofficial "the statutory premium recognition pattern in effect for the calendar year in which the premiums are received (which applies to premiums received by the taxpayer in that year): the share of the premiums recognized in the k-th year after receipt";
}
pub relation discount_factor_for_recognition_year_832b8B(c: Person, y: TaxableYear, calendar_year_of_receipt: Integer, k: Integer, factor: Decimal) kind empirical {
    label en unofficial "the discount factor for the k-th year after receipt from the applicable interest rate, with premiums received in a calendar year treated as received in the middle of it (the factor is a case input: G5306)";
}
pub relation discounted_component_832b8B(c: Person, y: TaxableYear, calendar_year_of_receipt: Integer, k: Integer, amount: Money) kind institutional {
    label en official "the present value of the part of the undiscounted unearned premiums recognized in the k-th year after receipt";
}
@source(IRC_S832_B, quote = "(i) the amount of the undiscounted unearned premiums at such time,")
rule Section832b8BiComponent(c: Person, y: TaxableYear, cyear: Integer, k: Integer, undiscounted: Money, percent: Decimal, factor: Decimal) strict {
    label en official "section 832(b)(8)(B)(i)-(iii): undiscounted unearned premiums x pattern percent x discount factor (cents HALF_UP)";
    when undiscounted_unearned_premiums_832b8Ci(c, y, cyear, undiscounted);
    when applicable_statutory_pattern_percent_832b8Ciii(c, cyear, k, percent);
    when discount_factor_for_recognition_year_832b8B(c, y, cyear, k, factor);
    then discounted_component_832b8B(c, y, cyear, k, round(undiscounted * (percent * factor), 2, "HALF_UP"));
}
pub relation present_value_by_year_of_receipt_832b8B(c: Person, y: TaxableYear, calendar_year_of_receipt: Integer, amount: Money) kind institutional {
    label en official "the present value of the unearned premiums received in the calendar year, as of the end of the taxable year";
}
@source(IRC_S832_B, quote = "(ii) the applicable interest rate, and")
rule Section832b8BiiPresentValueByCalendarYear(c: Person, y: TaxableYear, cyear: Integer) strict {
    label en official "section 832(b)(8)(B): the present value is determined separately for premiums received in each calendar year";
    when discounted_component_832b8B(c, y, cyear, _, _);
    then present_value_by_year_of_receipt_832b8B(c, y, cyear, sum all amount: Money for k: Integer where discounted_component_832b8B(c, y, cyear, k, amount));
}
pub relation discounted_unearned_premiums_computed_832b8B(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the discounted unearned premiums as of the end of the taxable year: the sum of the present values by calendar year of receipt";
}
@source(IRC_S832_B, quote = "(iii) the applicable statutory premium recognition pattern.")
rule Section832b8BDiscountedUnearnedPremiums(c: Person, y: TaxableYear) strict {
    label en official "section 832(b)(8)(B): the discounted unearned premiums are the sum over calendar years of receipt of the present values";
    when present_value_by_year_of_receipt_832b8B(c, y, _, _);
    then discounted_unearned_premiums_computed_832b8B(c, y, sum all amount: Money for cyear: Integer where present_value_by_year_of_receipt_832b8B(c, y, cyear, amount));
}
@source(IRC_S832_B, quote = "means the unearned premiums shown in the yearly statement filed by the taxpayer for the year ending with")
pub relation undiscounted_unearned_premiums_as_shown_832b8Ci(c: Person, y: TaxableYear) kind institutional {
    label en official "the undiscounted unearned premiums are those shown in the yearly statement filed for the year ending with or within the taxable year (a reading of the case figure)";
}
rule Section832b8CiUndiscountedFromYearlyStatement(c: Person, y: TaxableYear, cyear: Integer, amount: Money) strict {
    label en official "section 832(b)(8)(C)(i): the undiscounted unearned premiums are the amounts shown in the yearly statement";
    when undiscounted_unearned_premiums_832b8Ci(c, y, cyear, amount);
    then undiscounted_unearned_premiums_as_shown_832b8Ci(c, y);
}
@source(IRC_S832_B, quote = "means the statutory premium recognition pattern—")
pub relation applicable_recognition_pattern_stated_832b8Ciii(c: Person, calendar_year_of_receipt: Integer) kind institutional {
    label en official "the applicable statutory premium recognition pattern for the calendar year of receipt is stated";
}
rule Section832b8CiiiPatternForYearOfReceipt(c: Person, cyear: Integer, k: Integer, percent: Decimal) strict {
    label en official "section 832(b)(8)(C)(iii)(I)-(II): the pattern in effect for the calendar year of receipt, based on the pattern that applies to premiums received in that year";
    when applicable_statutory_pattern_percent_832b8Ciii(c, cyear, k, percent);
    then applicable_recognition_pattern_stated_832b8Ciii(c, cyear);
}
rule Section832b8AFeedsTitleInsurancePremiums(c: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 832(b)(8)(A)(i): the computed discounted unearned premiums are the end-of-year figure the title insurance premiums-earned rule uses";
    when discounted_unearned_premiums_computed_832b8B(c, y, amount);
    then discounted_unearned_premiums_end_of_year_832b8(c, y, amount);
}
