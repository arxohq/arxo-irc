// Sections 860B, 860C, 860E(a)-(b),(d)-(f), 860F(b)-(e), 860G, and 860H-860L
// (REMICs: taxation of regular and residual interest holders, the daily
// portion and the basis of a residual interest, the excess inclusion floor
// and its allocation, the tax on transfers to disqualified organizations
// and on pass-thru entities, nonrecognition on transfers to a REMIC and on
// distributions, and the section 860G definitions and taxes). Stage 2c
// (IRC-09 stage 2c, A12), 26.09.2026. Status implemented_unverified.
//
// METHOD. A holder's amount for a calendar quarter is the REMIC's quarterly
// taxable income times the holder's weighted days over the days in the
// quarter (one `div_round`, TECH-GAPS G499): the daily allocation of
// section 860C(a)(2) is expressed through the holder's day-weighted holding,
// which the case asserts, because the day-by-day allocation is a recursive
// ledger (TECH-GAPS G2208). Present-value amounts and applicable federal
// rates (section 860E(e)(2), section 1274(d)) are case-asserted figures.
// The Secretary's waiver and prescribed rules are EXTERNAL_DEPENDENCY rows.

// ---- Section 860B: regular interests ----

use self::{
    IRC_S860B_A,
    IRC_S860B_B,
    IRC_S860B_C,
    IRC_S860C_A,
    IRC_S860C_B,
    IRC_S860C_C,
    IRC_S860C_D,
    IRC_S860C_E,
    IRC_S860E_A,
    IRC_S860E_B,
    IRC_S860E_D,
    IRC_S860E_E,
    IRC_S860E_F,
    IRC_S860F_B,
    IRC_S860F_C,
    IRC_S860F_D,
    IRC_S860F_E,
    IRC_S860G_A,
    IRC_S860G_B,
    IRC_S860G_C,
    IRC_S860G_D,
    Person,
    TaxableYear,
    highest_rate_of_tax_section_11,
    remic_qualified,
};

pub relation regular_interest_860B(i: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest is a regular interest in a REMIC (section 860G(a)(1))";
}
pub relation regular_interest_otherwise_a_debt_instrument_860Ba(i: us.irc.core::Asset) kind empirical {
    label en unofficial "the regular interest is otherwise a debt instrument";
}
pub relation regular_interest_treated_as_debt_instrument_860Ba(i: us.irc.core::Asset) kind institutional {
    label en official "in determining the holder's tax the regular interest is treated as a debt instrument";
}
@source(IRC_S860B_A, quote = "such interest (if not otherwise a debt instrument) shall be treated as a debt instrument")
rule Section860BaRegularInterestIsDebt(i: us.irc.core::Asset) strict {
    label en official "section 860B(a): a regular interest is treated as a debt instrument for the holder's tax";
    when regular_interest_860B(i);
    then regular_interest_treated_as_debt_instrument_860Ba(i);
}
pub relation regular_interest_income_uses_accrual_method_860Bb(i: us.irc.core::Asset) kind institutional {
    label en official "amounts includible in gross income with respect to the regular interest are determined under the accrual method of accounting";
}
@source(IRC_S860B_B, quote = "The amounts includible in gross income with respect to any regular interest in a REMIC shall be determined under the accrual method of accounting.")
rule Section860BbAccrualMethod(i: us.irc.core::Asset) strict {
    label en official "section 860B(b): accrual method for regular interest income";
    when regular_interest_860B(i);
    then regular_interest_income_uses_accrual_method_860Bb(i);
}
pub relation gain_on_disposition_of_regular_interest_860Bc(h: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the gain on the disposition of the regular interest";
}
pub relation amount_includible_at_110_percent_of_afr_860Bc1(h: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount that would have been includible in gross income if the yield on the interest were 110 percent of the applicable Federal rate (section 1274(d) without regard to paragraph (2) thereof)";
}
pub relation amount_actually_includible_860Bc2(h: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount actually includible in gross income with respect to the interest by the taxpayer";
}
pub relation regular_interest_gain_treated_as_ordinary_income_860Bc(h: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain on disposition treated as ordinary income: the gain, not more than the excess of the 110-percent amount over the amount actually included";
}
@source(IRC_S860B_C, quote = "Gain on the disposition of a regular interest shall be treated as ordinary income to the extent such gain does not exceed the excess (if any) of")
rule Section860BcOrdinaryIncomePortion(h: Person, i: us.irc.core::Asset, gain: Money, at110: Money, actual: Money) strict {
    label en official "section 860B(c): ordinary income up to the excess of the 110 percent of AFR amount over the amount actually included";
    when gain_on_disposition_of_regular_interest_860Bc(h, i, gain);
    when amount_includible_at_110_percent_of_afr_860Bc1(h, i, at110);
    when amount_actually_includible_860Bc2(h, i, actual);
    then regular_interest_gain_treated_as_ordinary_income_860Bc(h, i, min(gain, max(0.00 USD, at110 - actual)));
}

// ---- Section 860C: residual interest holders ----

pub relation remic_taxable_income_for_quarter_860C(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income (or, if negative, the net loss) of the REMIC for the calendar quarter, computed under subsection (b)";
}
pub relation days_in_calendar_quarter_860C(q: TaxableYear, days: Decimal) kind empirical {
    label en unofficial "the number of days in the calendar quarter";
}
pub relation holder_weighted_days_in_quarter_860C(holder: Person, remic: Person, q: TaxableYear, weighted_days: Decimal) kind empirical {
    label en unofficial "the sum over the days of the quarter of the holder's proportion of the residual interests on that day (the day-by-day allocation among holders of section 860C(a)(2)(B))";
}
pub relation holder_daily_portion_total_860Ca(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "the holder's daily portions of the REMIC's taxable income or net loss for the quarter, taken into account by the holder";
}
@source(IRC_S860C_A, quote = "such holder shall take into account his daily portion of the taxable income or net loss of such REMIC for each day during the taxable year on which such holder held such")
rule Section860Ca1DailyPortions(holder: Person, remic: Person, q: TaxableYear, income: Money, days: Decimal, weighted: Decimal) strict {
    label en official "section 860C(a): the ratable daily portion of the quarter's income, allocated among the holders of each day, summed over the days the holder held the interest";
    when remic_taxable_income_for_quarter_860C(remic, q, income);
    when days_in_calendar_quarter_860C(q, days);
    when holder_weighted_days_in_quarter_860C(holder, remic, q, weighted);
    when days > 0.0;
    then holder_daily_portion_total_860Ca(holder, remic, q, div_round(income * weighted, days, 2, "HALF_UP"));
}
pub relation remic_gross_income_860Cb2(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income of the REMIC for the quarter, with the section 860C(b)(1) modifications";
}
pub relation remic_allowable_deductions_860Cb2(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deductions allowable in computing the taxable income of the REMIC for the quarter, with the modifications";
}
pub relation remic_net_loss_860Cb2(remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "the net loss of the REMIC: the excess of allowable deductions over gross income";
}
@source(IRC_S860C_B, quote = "The net loss of any REMIC is the excess of")
rule Section860Cb2NetLoss(remic: Person, q: TaxableYear, deductions: Money, gross: Money) strict {
    label en official "section 860C(b)(2): net loss is deductions over gross income";
    when remic_allowable_deductions_860Cb2(remic, q, deductions);
    when remic_gross_income_860Cb2(remic, q, gross);
    when deductions > gross;
    then remic_net_loss_860Cb2(remic, q, deductions - gross);
}
pub relation remic_income_before_foreclosure_reduction_860Cb1E(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net income from foreclosure property of the REMIC before reduction by the section 860G(c) tax";
}
pub relation remic_section_860G_c_tax_860Cb1E(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax imposed by section 860G(c)";
}
pub relation remic_net_income_from_foreclosure_property_reduced_860Cb1E(remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "the net income from foreclosure property reduced by the tax imposed by section 860G(c)";
}
@source(IRC_S860C_B, quote = "the amount of the net income from foreclosure property (if any) shall be reduced by the amount of the tax imposed by section 860G(c)")
rule Section860Cb1EForeclosureIncomeReduced(remic: Person, q: TaxableYear, income: Money, tax: Money) strict {
    label en official "section 860C(b)(1)(E): foreclosure income is reduced by the section 860G(c) tax";
    when remic_income_before_foreclosure_reduction_860Cb1E(remic, q, income);
    when remic_section_860G_c_tax_860Cb1E(remic, q, tax);
    then remic_net_income_from_foreclosure_property_reduced_860Cb1E(remic, q, income - tax);
}
pub relation remic_distribution_to_holder_860Cc(holder: Person, remic: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "a distribution by the REMIC with respect to the interest";
}
pub relation residual_interest_adjusted_basis_860Cc(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the interest";
}
pub relation remic_distribution_not_included_860Cc1(holder: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the distribution is not included in gross income to the extent it does not exceed the adjusted basis";
}
@source(IRC_S860C_C, quote = "shall not be included in gross income to the extent it does not exceed the adjusted basis of the interest")
rule Section860Cc1DistributionWithinBasis(holder: Person, remic: Person, i: us.irc.core::Asset, distribution: Money, basis: Money) strict {
    label en official "section 860C(c)(1): a distribution up to basis is not income";
    when remic_distribution_to_holder_860Cc(holder, remic, i, distribution);
    when residual_interest_adjusted_basis_860Cc(holder, i, basis);
    then remic_distribution_not_included_860Cc1(holder, i, min(distribution, basis));
}
pub relation remic_distribution_gain_860Cc2(holder: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the distribution in excess of the adjusted basis is treated as gain from the sale or exchange of the interest";
}
@source(IRC_S860C_C, quote = "to the extent it exceeds the adjusted basis of the interest, shall be treated as gain from the sale or exchange of such interest")
rule Section860Cc2ExcessIsGain(holder: Person, remic: Person, i: us.irc.core::Asset, distribution: Money, basis: Money) strict {
    label en official "section 860C(c)(2): the excess over basis is sale or exchange gain";
    when remic_distribution_to_holder_860Cc(holder, remic, i, distribution);
    when residual_interest_adjusted_basis_860Cc(holder, i, basis);
    when distribution > basis;
    then remic_distribution_gain_860Cc2(holder, i, distribution - basis);
}
pub relation basis_before_quarter_860Cd(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the basis of the residual interest before the quarter's adjustments";
}
pub relation taxable_income_taken_into_account_860Cd1(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the taxable income of the REMIC taken into account by the holder under subsection (a) with respect to the interest";
}
pub relation net_loss_taken_into_account_860Cd2B(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the net loss of the REMIC taken into account by the holder under subsection (a) with respect to the interest";
}
pub relation distributions_to_holder_860Cd2A(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the distributions to the holder with respect to the interest";
}
pub relation residual_interest_basis_after_860Cd(holder: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis after increase by taxable income and decrease (not below zero) by distributions and net loss";
}
@source(IRC_S860C_D, quote = "The basis of any person's residual interest in a REMIC shall be decreased (but not below zero) by the sum of the following amounts")
rule Section860CdBasisAdjustments(holder: Person, i: us.irc.core::Asset, before: Money, income: Money, distributions: Money, loss: Money) strict {
    label en official "section 860C(d): basis plus taxable income taken into account, minus distributions and net loss, never below zero";
    when basis_before_quarter_860Cd(holder, i, before);
    when taxable_income_taken_into_account_860Cd1(holder, i, income);
    when distributions_to_holder_860Cd2A(holder, i, distributions);
    when net_loss_taken_into_account_860Cd2B(holder, i, loss);
    then residual_interest_basis_after_860Cd(holder, i, max(0.00 USD, ((before + income) - distributions) - loss));
}
pub relation holder_net_loss_for_quarter_860Ce2(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the amount of the REMIC's net loss taken into account by the holder for the quarter";
}
pub relation basis_at_close_of_quarter_860Ce2(holder: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the holder's residual interest at the close of the calendar quarter, determined without regard to the net loss for the quarter";
}
pub relation net_loss_allowed_860Ce2A(holder: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the net loss taken into account for the quarter, not more than the adjusted basis";
}
@source(IRC_S860C_E, quote = "shall not exceed the adjusted basis of such holder's residual interest in such REMIC as of the close of such calendar quarter")
rule Section860Ce2ANetLossLimitedToBasis(holder: Person, i: us.irc.core::Asset, loss: Money, basis: Money) strict {
    label en official "section 860C(e)(2)(A): net loss allowed up to adjusted basis";
    when holder_net_loss_for_quarter_860Ce2(holder, i, loss);
    when basis_at_close_of_quarter_860Ce2(holder, i, basis);
    then net_loss_allowed_860Ce2A(holder, i, min(loss, basis));
}
pub relation net_loss_disallowed_carried_to_next_quarter_860Ce2B(holder: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the disallowed net loss is treated as incurred by the REMIC in the succeeding calendar quarter with respect to the holder";
}
@source(IRC_S860C_E, quote = "Any loss disallowed by reason of subparagraph (A) shall be treated as incurred by the REMIC in the succeeding calendar quarter with respect to such holder.")
rule Section860Ce2BDisallowedLossCarried(holder: Person, i: us.irc.core::Asset, loss: Money, basis: Money) strict {
    label en official "section 860C(e)(2)(B): the excess over basis carries to the next quarter";
    when holder_net_loss_for_quarter_860Ce2(holder, i, loss);
    when basis_at_close_of_quarter_860Ce2(holder, i, basis);
    when loss > basis;
    then net_loss_disallowed_carried_to_next_quarter_860Ce2B(holder, i, loss - basis);
}
pub relation amount_taken_into_account_by_residual_holder_860Ce1(holder: Person, remic: Person, q: TaxableYear) kind institutional {
    label en official "any amount taken into account by a residual interest holder under subsection (a) is ordinary income or ordinary loss";
}
@source(IRC_S860C_E, quote = "Any amount taken into account under subsection (a) by any holder of a residual interest in a REMIC shall be treated as ordinary income or ordinary loss, as the case may be.")
rule Section860Ce1Ordinary(holder: Person, remic: Person, q: TaxableYear, amount: Money) strict {
    label en official "section 860C(e)(1): ordinary character";
    when holder_daily_portion_total_860Ca(holder, remic, q, amount);
    then amount_taken_into_account_by_residual_holder_860Ce1(holder, remic, q);
}

// ---- Section 860E(a)-(b), (d)-(f): excess inclusions ----

pub relation holder_taxable_income_before_floor_860Ea1(holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income of the holder for the taxable year before the section 860E(a)(1) floor";
}
pub relation holder_excess_inclusion_for_year_860Ea1(holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess inclusion of the holder for the taxable year (the sum of the quarterly excess inclusions)";
}
pub relation holder_taxable_income_after_floor_860Ea1(holder: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "taxable income never less than the excess inclusion for the year";
}
@source(IRC_S860E_A, quote = "The taxable income of any holder of a residual interest in a REMIC for any taxable year shall in no event be less than the excess inclusion for such taxable year.")
rule Section860Ea1TaxableIncomeFloor(holder: Person, y: TaxableYear, income: Money, excess: Money) strict {
    label en official "section 860E(a)(1): taxable income is at least the excess inclusion";
    when holder_taxable_income_before_floor_860Ea1(holder, y, income);
    when holder_excess_inclusion_for_year_860Ea1(holder, y, excess);
    then holder_taxable_income_after_floor_860Ea1(holder, y, max(income, excess));
}
pub relation affiliated_group_filing_consolidated_return_860Ea2(holder: Person, group: Person) kind empirical {
    label en unofficial "the holder is a member of an affiliated group filing a consolidated return";
}
pub relation treated_as_one_taxpayer_for_860Ea1_860Ea2(holder: Person, group: Person) kind institutional {
    label en official "all members of the consolidated group are treated as one taxpayer for the taxable income floor";
}
@source(IRC_S860E_A, quote = "All members of an affiliated group filing a consolidated return shall be treated as 1 taxpayer for purposes of this subsection.")
rule Section860Ea2ConsolidatedGroupOneTaxpayer(holder: Person, group: Person) strict {
    label en official "section 860E(a)(2): a consolidated group is one taxpayer";
    when affiliated_group_filing_consolidated_return_860Ea2(holder, group);
    then treated_as_one_taxpayer_for_860Ea1_860Ea2(holder, group);
}
pub relation excess_inclusion_disregarded_for_nol_860Ea3(holder: Person, y: TaxableYear) kind institutional {
    label en official "the excess inclusion is not taken into account in determining the net operating loss for the year or the section 172(a)(2)(B)(ii)(I)/(b)(2) taxable income";
}
@source(IRC_S860E_A, quote = "Any excess inclusion for any taxable year shall not be taken into account")
rule Section860Ea3ExcessInclusionNotInNol(holder: Person, y: TaxableYear, excess: Money) strict {
    label en official "section 860E(a)(3): the excess inclusion is disregarded for net operating loss purposes";
    when holder_excess_inclusion_for_year_860Ea1(holder, y, excess);
    then excess_inclusion_disregarded_for_nol_860Ea3(holder, y);
}
pub relation alternative_minimum_taxable_income_before_floor_860Ea4B(holder: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the alternative minimum taxable income of the holder before the excess inclusion floor";
}
pub relation alternative_minimum_taxable_income_after_floor_860Ea4B(holder: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "alternative minimum taxable income never less than the excess inclusion";
}
@source(IRC_S860E_A, quote = "the alternative minimum taxable income of any holder of a residual interest in a REMIC for any taxable year shall in no event be less than the excess inclusion for such taxable year")
rule Section860Ea4BAmtFloor(holder: Person, y: TaxableYear, amti: Money, excess: Money) strict {
    label en official "section 860E(a)(4)(B): the alternative minimum taxable income is at least the excess inclusion";
    when alternative_minimum_taxable_income_before_floor_860Ea4B(holder, y, amti);
    when holder_excess_inclusion_for_year_860Ea1(holder, y, excess);
    then alternative_minimum_taxable_income_after_floor_860Ea4B(holder, y, max(amti, excess));
}
pub relation holder_subject_to_section_511_tax_860Eb(holder: Person) kind empirical {
    label en unofficial "the holder is an organization subject to the tax imposed by section 511";
}
pub relation excess_inclusion_is_unrelated_business_taxable_income_860Eb(holder: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess inclusion is treated as unrelated business taxable income for section 512";
}
@source(IRC_S860E_B, quote = "the excess inclusion of such holder for any taxable year shall be treated as unrelated business taxable income of such holder")
rule Section860EbUbti(holder: Person, y: TaxableYear, excess: Money) strict {
    label en official "section 860E(b): a section 511 organization's excess inclusion is UBTI";
    when holder_subject_to_section_511_tax_860Eb(holder);
    when holder_excess_inclusion_for_year_860Ea1(holder, y, excess);
    then excess_inclusion_is_unrelated_business_taxable_income_860Eb(holder, y, excess);
}
pub relation reit_or_ric_residual_aggregate_excess_inclusions_860Ed1A(ent: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate excess inclusions determined with respect to the residual interests held by the entity";
}
pub relation reit_taxable_income_excluding_net_capital_gain_860Ed1B(ent: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the real estate investment trust taxable income (section 857(b)(2), excluding any net capital gain), or the corresponding amount for a RIC, common trust fund or subchapter T organization";
}
pub relation dividends_received_from_entity_860Ed1(sh: Person, ent: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dividends the shareholder received from the entity";
}
pub relation total_dividends_paid_by_entity_860Ed1(ent: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total dividends received by all shareholders from the entity";
}
pub relation excess_inclusion_allocated_to_shareholder_860Ed(sh: Person, ent: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder's allocation of the excess of aggregate excess inclusions over the entity's taxable income, in proportion to dividends received; it is treated as an excess inclusion of the shareholder";
}
@source(IRC_S860E_D, quote = "shall be allocated among the shareholders of such trust in proportion to the dividends received by such shareholders from such trust")
rule Section860EdAllocationToShareholders(sh: Person, ent: Person, y: TaxableYear, aggregate: Money, income: Money, received: Money, total: Money) strict {
    label en official "section 860E(d)(1)-(2): the excess of aggregate excess inclusions over taxable income is allocated by dividends received, and is an excess inclusion of the shareholder";
    when reit_or_ric_residual_aggregate_excess_inclusions_860Ed1A(ent, y, aggregate);
    when reit_taxable_income_excluding_net_capital_gain_860Ed1B(ent, y, income);
    when dividends_received_from_entity_860Ed1(sh, ent, y, received);
    when total_dividends_paid_by_entity_860Ed1(ent, y, total);
    when aggregate > income;
    when total > 0.00 USD;
    then excess_inclusion_allocated_to_shareholder_860Ed(sh, ent, y, div_round((aggregate - income) * (received / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// (e): tax on transfers to, and pass-thru entity holdings by, disqualified organizations.
pub relation residual_interest_transferred_on_860Ee1(transferor: Person, transferee: Person, i: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the transferor transfers the residual interest in a REMIC to the transferee on this date";
}
pub relation transfer_through_agent_of_disqualified_organization_860Ee3(transferor: Person, transferee: Person, i: us.irc.core::Asset, agent: Person) kind empirical {
    label en unofficial "the transfer is through the named agent for a disqualified organization";
}
pub relation united_states_state_or_foreign_government_or_instrumentality_860Ee5A(p: Person) kind empirical {
    label en unofficial "the person is the United States, a State or political subdivision, a foreign government, an international organization, or an agency or instrumentality of any of them";
}
pub relation tax_exempt_organization_not_subject_to_511_or_521_cooperative_860Ee5B(p: Person) kind empirical {
    label en unofficial "the person is an organization (other than a section 521 cooperative) exempt from the chapter's tax unless it is subject to the tax imposed by section 511";
}
pub relation organization_described_in_1381a2C_860Ee5C(p: Person) kind empirical {
    label en unofficial "the person is an organization described in section 1381(a)(2)(C)";
}
pub relation disqualified_organization_860Ee5(p: Person) kind institutional {
    label en official "the person is a disqualified organization";
}
rule Section860Ee5ADisqualifiedGovernment(p: Person) strict {
    label en official "section 860E(e)(5)(A): governmental persons are disqualified organizations";
    when united_states_state_or_foreign_government_or_instrumentality_860Ee5A(p);
    then disqualified_organization_860Ee5(p);
}
rule Section860Ee5BDisqualifiedExempt(p: Person) strict {
    label en official "section 860E(e)(5)(B): exempt organizations not subject to section 511 (other than cooperatives) are disqualified organizations";
    when tax_exempt_organization_not_subject_to_511_or_521_cooperative_860Ee5B(p);
    then disqualified_organization_860Ee5(p);
}
rule Section860Ee5CDisqualifiedCooperative(p: Person) strict {
    label en official "section 860E(e)(5)(C): organizations described in section 1381(a)(2)(C) are disqualified organizations";
    when organization_described_in_1381a2C_860Ee5C(p);
    then disqualified_organization_860Ee5(p);
}
pub relation transferee_furnishes_non_disqualified_affidavit_860Ee4A(transferor: Person, transferee: Person, i: us.irc.core::Asset) kind empirical {
    label en unofficial "the transferee furnishes to the transferor an affidavit that the transferee is not a disqualified organization";
}
pub relation transferor_has_actual_knowledge_affidavit_false_860Ee4B(transferor: Person, transferee: Person, i: us.irc.core::Asset) kind empirical {
    label en unofficial "as of the time of the transfer the transferor has actual knowledge that the affidavit is false";
}
pub relation present_value_of_anticipated_excess_inclusions_860Ee2A(transferor: Person, i: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the present value of the total anticipated excess inclusions with respect to the interest for periods after the transfer (determined under regulations)";
}
pub relation transferor_relieved_of_transfer_tax_860Ee4(transferor: Person, transferee: Person, i: us.irc.core::Asset) kind institutional {
    label en official "the person otherwise liable is relieved of liability: the transferee furnished an affidavit and the transferor did not know it was false";
}
@source(IRC_S860E_E, quote = "shall be relieved of liability for the tax imposed by paragraph (1) with respect to any transfer if")
rule Section860Ee4Relief(transferor: Person, transferee: Person, i: us.irc.core::Asset) strict {
    label en official "section 860E(e)(4): affidavit without actual knowledge of falsity relieves the person of the transfer tax";
    when transferee_furnishes_non_disqualified_affidavit_860Ee4A(transferor, transferee, i);
    when not_known(transferor_has_actual_knowledge_affidavit_false_860Ee4B(transferor, transferee, i));
    then transferor_relieved_of_transfer_tax_860Ee4(transferor, transferee, i);
}
pub relation transfer_tax_liable_person_860Ee3(payer: Person, transferee: Person, i: us.irc.core::Asset) kind institutional {
    label en official "the person liable for the transfer tax: the transferor, or the agent when the transfer is through an agent for the disqualified organization";
}
rule Section860Ee3TransferorPays(transferor: Person, transferee: Person, i: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 860E(e)(3): the tax on a transfer is paid by the transferor";
    when residual_interest_transferred_on_860Ee1(transferor, transferee, i, on);
    when disqualified_organization_860Ee5(transferee);
    then transfer_tax_liable_person_860Ee3(transferor, transferee, i);
}
pub relation transfer_tax_on_disqualified_organization_transfer_860Ee2(transferor: Person, transferee: Person, i: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the tax on the transfer: the present value of total anticipated excess inclusions times the highest section 11(b) rate";
}
@source(IRC_S860E_E, quote = "A tax is hereby imposed on any transfer of a residual interest in a REMIC to a disqualified organization.")
rule Section860Ee2TransferTax(transferor: Person, transferee: Person, i: us.irc.core::Asset, on: Date, pv: Money, rate: Decimal) strict {
    label en official "section 860E(e)(1)-(2): the transfer tax equals the present value of anticipated excess inclusions multiplied by the highest rate";
    when residual_interest_transferred_on_860Ee1(transferor, transferee, i, on);
    when disqualified_organization_860Ee5(transferee);
    when present_value_of_anticipated_excess_inclusions_860Ee2A(transferor, i, pv);
    when highest_rate_of_tax_section_11(rate);
    then transfer_tax_on_disqualified_organization_transfer_860Ee2(transferor, transferee, i, round(pv * rate, 2, "HALF_UP"));
}
pub relation transfer_tax_paid_860Ee3(transferor: Person, transferee: Person, i: us.irc.core::Asset) kind empirical {
    label en unofficial "the transfer tax has been paid by the person liable";
}
@source(IRC_S860E_E, quote = "The tax imposed by paragraph (1) on any transfer shall be paid by the transferor")
rule Section860Ee3DutyToPayTransferTax(transferor: Person, transferee: Person, i: us.irc.core::Asset, on: Date, relieved_amount: Money) defeasible {
    label en official "section 860E(e)(3): the transferor (or the agent of a disqualified organization) must pay the tax, unless relieved under paragraph (4)";
    when residual_interest_transferred_on_860Ee1(transferor, transferee, i, on);
    when disqualified_organization_860Ee5(transferee);
    when transfer_tax_on_disqualified_organization_transfer_860Ee2(transferor, transferee, i, relieved_amount);
    when not_known(transferor_relieved_of_transfer_tax_860Ee4(transferor, transferee, i));
    then duty PayTransferTaxToDisqualifiedOrganization {
        bearer transferor;
        goal achievement {
            condition transfer_tax_paid_860Ee3(transferor, transferee, i);
            window [on, infinity];
        }
    };
}
pub relation pass_thru_entity_860Ee6B(e: Person) kind empirical {
    label en unofficial "the entity is a RIC, REIT, common trust fund, partnership, trust, estate or subchapter T organization (or a nominee holding for another)";
}
pub relation disqualified_organization_record_holder_during_year_860Ee6A(e: Person, y: TaxableYear, holder: Person) kind empirical {
    label en unofficial "at some time during the taxable year a disqualified organization is the record holder of an interest in the pass-thru entity";
}
pub relation excess_inclusions_allocable_to_disqualified_holder_860Ee6A(e: Person, y: TaxableYear, holder: Person, amount: Money) kind empirical {
    label en unofficial "the amount of excess inclusions for the year allocable to the interest held by the disqualified organization";
}
pub relation record_holder_affidavit_860Ee6D(e: Person, y: TaxableYear, holder: Person) kind empirical {
    label en unofficial "the record holder furnishes to the pass-thru entity an affidavit that it is not a disqualified organization";
}
pub relation pass_thru_entity_has_actual_knowledge_affidavit_false_860Ee6D(e: Person, y: TaxableYear, holder: Person) kind empirical {
    label en unofficial "during the period the pass-thru entity has actual knowledge that the affidavit is false";
}
pub relation pass_thru_tax_relief_860Ee6D(e: Person, y: TaxableYear, holder: Person) kind institutional {
    label en official "no tax is imposed on the interest: an affidavit was furnished and the entity had no actual knowledge that it was false";
}
@source(IRC_S860E_E, quote = "No tax shall be imposed by subparagraph (A) with respect to any interest in a pass-thru entity for any period if")
rule Section860Ee6DAffidavitRelief(e: Person, y: TaxableYear, holder: Person) strict {
    label en official "section 860E(e)(6)(D): an affidavit and no actual knowledge of falsity avoid the pass-thru tax";
    when record_holder_affidavit_860Ee6D(e, y, holder);
    when not_known(pass_thru_entity_has_actual_knowledge_affidavit_false_860Ee6D(e, y, holder));
    then pass_thru_tax_relief_860Ee6D(e, y, holder);
}
pub relation pass_thru_entity_tax_860Ee6A(e: Person, y: TaxableYear, holder: Person, amount: Money) kind institutional {
    label en official "the tax on the pass-thru entity: the excess inclusions allocable to the disqualified holder's interest times the highest section 11(b) rate";
}
@source(IRC_S860E_E, quote = "there is hereby imposed on such entity for such taxable year a tax equal to the product of")
rule Section860Ee6APassThruTax(e: Person, y: TaxableYear, holder: Person, allocable: Money, rate: Decimal) defeasible {
    label en official "section 860E(e)(6)(A): a pass-thru entity with a disqualified organization record holder pays the highest rate on the allocable excess inclusions, unless the affidavit relief applies";
    when pass_thru_entity_860Ee6B(e);
    when disqualified_organization_record_holder_during_year_860Ee6A(e, y, holder);
    when excess_inclusions_allocable_to_disqualified_holder_860Ee6A(e, y, holder, allocable);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    when not_known(pass_thru_tax_relief_860Ee6D(e, y, holder));
    then pass_thru_entity_tax_860Ee6A(e, y, holder, round(allocable * rate, 2, "HALF_UP"));
}
pub relation pass_thru_entity_tax_ordinary_treatment_860Ee6C(e: Person, y: TaxableYear, holder: Person) kind institutional {
    label en official "the section 860E(e)(6) tax reduces the amount included in the gross income of the interest holders of the entity (title effect)";
}
@source(IRC_S860E_E, quote = "Any tax imposed by this paragraph with respect to any excess inclusion of any pass-thru entity for any taxable year shall, for purposes of this title (other than this subsection), be applied against (and operate to reduce)")
rule Section860Ee6CTaxReducesIncludedAmount(e: Person, y: TaxableYear, holder: Person, amount: Money) defeasible {
    label en official "section 860E(e)(6)(C): the tax operates to reduce the amount otherwise includible";
    when pass_thru_entity_tax_860Ee6A(e, y, holder, amount);
    then pass_thru_entity_tax_ordinary_treatment_860Ee6C(e, y, holder);
}
pub relation section_860E_e_tax_treated_as_excise_tax_860Ee8(e: Person) kind institutional {
    label en official "for subtitle F the taxes imposed by section 860E(e) are excise taxes to which the deficiency procedures apply";
}
rule Section860Ee8ExciseTreatment(e: Person, y: TaxableYear, holder: Person, amount: Money) defeasible {
    label en official "section 860E(e)(8): the pass-thru entity tax is an excise tax subject to the deficiency procedures";
    when pass_thru_entity_tax_860Ee6A(e, y, holder, amount);
    then section_860E_e_tax_treated_as_excise_tax_860Ee8(e);
}
pub relation variable_contract_excess_inclusion_860Ef(contract: us.irc.core::Asset, excess: Money) kind empirical {
    label en unofficial "the excess inclusion attributable to a variable contract (section 817)";
}
pub relation reserve_adjustment_for_variable_contract_860Ef(contract: us.irc.core::Asset, before: Money) kind empirical {
    label en unofficial "the reserve adjustment otherwise determined for the variable contract";
}
pub relation reserve_adjustment_after_excess_inclusion_860Ef(contract: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "there is no adjustment in the reserve to the extent of any excess inclusion";
}
@source(IRC_S860E_F, quote = "with respect to any variable contract (as defined in section 817), there shall be no adjustment in the reserve to the extent of any excess inclusion")
rule Section860EfNoReserveAdjustmentForExcessInclusion(contract: us.irc.core::Asset, before: Money, excess: Money) strict {
    label en official "section 860E(f): the reserve adjustment is reduced by the excess inclusion";
    when reserve_adjustment_for_variable_contract_860Ef(contract, before);
    when variable_contract_excess_inclusion_860Ef(contract, excess);
    then reserve_adjustment_after_excess_inclusion_860Ef(contract, max(0.00 USD, before - excess));
}

// ---- Section 860F(b)-(e): transfers, distributions, wash sales ----

pub relation property_transferred_to_remic_860Fb1(transferor: Person, remic: Person, prop: us.irc.core::Asset, interest: us.irc.core::Asset) kind empirical {
    label en unofficial "the transferor transfers the property to the REMIC in exchange for the regular or residual interest";
}
pub relation transfer_to_remic_nonrecognition_860Fb1A(transferor: Person, prop: us.irc.core::Asset) kind institutional {
    label en official "no gain or loss is recognized to the transferor on the transfer";
}
@source(IRC_S860F_B, quote = "No gain or loss shall be recognized to the transferor on the transfer of any property to a REMIC in exchange for regular or residual interests in such REMIC.")
rule Section860Fb1ANonrecognition(transferor: Person, remic: Person, prop: us.irc.core::Asset, interest: us.irc.core::Asset) strict {
    label en official "section 860F(b)(1)(A): nonrecognition on a transfer in exchange for interests";
    when property_transferred_to_remic_860Fb1(transferor, remic, prop, interest);
    then transfer_to_remic_nonrecognition_860Fb1A(transferor, prop);
}
pub relation aggregate_adjusted_bases_of_transferred_property_860Fb1B(transferor: Person, remic: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate adjusted bases of the property transferred in the transfer";
}
pub relation fair_market_value_of_interest_860Fb1B(interest: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the regular or residual interest received";
}
pub relation total_fair_market_value_of_interests_received_860Fb1B(transferor: Person, remic: Person, amount: Money) kind empirical {
    label en unofficial "the total fair market value of the interests received in the transfer";
}
pub relation adjusted_basis_of_interest_received_860Fb1B(transferor: Person, interest: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of the interest: the aggregate adjusted bases of the transferred property, allocated among the interests in proportion to their fair market values";
}
@source(IRC_S860F_B, quote = "The adjusted bases of the regular and residual interests received in a transfer described in subparagraph (A) shall be equal to the aggregate adjusted bases of the property transferred in such transfer.")
rule Section860Fb1BBasisAllocation(transferor: Person, remic: Person, interest: us.irc.core::Asset, aggregate: Money, fmv: Money, total: Money) strict {
    label en official "section 860F(b)(1)(B): aggregate basis allocated by fair market value";
    when aggregate_adjusted_bases_of_transferred_property_860Fb1B(transferor, remic, aggregate);
    when fair_market_value_of_interest_860Fb1B(interest, fmv);
    when total_fair_market_value_of_interests_received_860Fb1B(transferor, remic, total);
    when total > 0.00 USD;
    then adjusted_basis_of_interest_received_860Fb1B(transferor, interest, div_round(aggregate * (fmv / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation issue_price_of_interest_860Fb1C(interest: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the issue price of the interest (section 860G(a)(10))";
}
pub relation residual_interest_860Fb1(interest: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest is a residual interest";
}
pub relation anticipated_existence_years_860Fb1(remic: Person, years: Decimal) kind empirical {
    label en unofficial "the anticipated period, in years, during which the REMIC will be in existence";
}
pub relation issue_price_excess_ratable_inclusion_860Fb1Cii(transferor: Person, interest: us.irc.core::Asset, remic: Person, amount: Money) kind institutional {
    label en official "for a residual interest whose issue price exceeds its basis, the excess included in gross income ratably (annually) over the anticipated existence period";
}
@source(IRC_S860F_B, quote = "in the case of a residual interest, such excess shall be included in gross income ratably over the anticipated period during which the REMIC will be in existence")
rule Section860Fb1CiiResidualIssuePriceExcess(transferor: Person, remic: Person, interest: us.irc.core::Asset, price: Money, basis: Money, years: Decimal) strict {
    label en official "section 860F(b)(1)(C)(ii): excess of issue price over basis, included ratably per year of anticipated existence";
    when residual_interest_860Fb1(interest);
    when issue_price_of_interest_860Fb1C(interest, price);
    when adjusted_basis_of_interest_received_860Fb1B(transferor, interest, basis);
    when anticipated_existence_years_860Fb1(remic, years);
    when price > basis;
    when years > 0.0;
    then issue_price_excess_ratable_inclusion_860Fb1Cii(transferor, interest, remic, div_round(price - basis, years, 2, "HALF_UP"));
}
pub relation basis_excess_ratable_deduction_860Fb1Dii(transferor: Person, interest: us.irc.core::Asset, remic: Person, amount: Money) kind institutional {
    label en official "for a residual interest whose basis exceeds its issue price, the excess allowable as a deduction ratably (annually) over the anticipated existence period";
}
@source(IRC_S860F_B, quote = "in the case of a residual interest, such excess shall be allowable as a deduction ratably over the anticipated period during which the REMIC will be in existence")
rule Section860Fb1DiiResidualBasisExcess(transferor: Person, remic: Person, interest: us.irc.core::Asset, price: Money, basis: Money, years: Decimal) strict {
    label en official "section 860F(b)(1)(D)(ii): excess of basis over issue price, deducted ratably per year of anticipated existence";
    when residual_interest_860Fb1(interest);
    when issue_price_of_interest_860Fb1C(interest, price);
    when adjusted_basis_of_interest_received_860Fb1B(transferor, interest, basis);
    when anticipated_existence_years_860Fb1(remic, years);
    when basis > price;
    when years > 0.0;
    then basis_excess_ratable_deduction_860Fb1Dii(transferor, interest, remic, div_round(basis - price, years, 2, "HALF_UP"));
}
pub relation fair_market_value_immediately_after_transfer_860Fb2(prop: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the property immediately after the transfer";
}
pub relation remic_basis_in_property_860Fb2(remic: Person, prop: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of property received by the REMIC in a transfer is its fair market value immediately after the transfer";
}
@source(IRC_S860F_B, quote = "The basis of any property received by a REMIC in a transfer described in paragraph (1)(A) shall be its fair market value immediately after such transfer.")
rule Section860Fb2RemicBasisIsFmv(transferor: Person, remic: Person, prop: us.irc.core::Asset, interest: us.irc.core::Asset, fmv: Money) strict {
    label en official "section 860F(b)(2): the REMIC takes the property at fair market value";
    when property_transferred_to_remic_860Fb1(transferor, remic, prop, interest);
    when fair_market_value_immediately_after_transfer_860Fb2(prop, fmv);
    then remic_basis_in_property_860Fb2(remic, prop, fmv);
}
pub relation remic_distributes_property_860Fc(remic: Person, holder: Person, prop: us.irc.core::Asset) kind empirical {
    label en unofficial "the REMIC distributes the property with respect to a regular or residual interest";
}
pub relation fair_market_value_at_distribution_860Fc(prop: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the fair market value of the distributed property";
}
pub relation remic_adjusted_basis_in_distributed_property_860Fc(remic: Person, prop: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the REMIC's adjusted basis in the distributed property";
}
pub relation remic_gain_on_distribution_860Fc1(remic: Person, prop: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "gain recognized to the REMIC as if it had sold the property to the distributee at fair market value";
}
@source(IRC_S860F_C, quote = "gain shall be recognized to such REMIC on the distribution in the same manner as if it had sold such property to the distributee at its fair market value")
rule Section860Fc1GainOnDistribution(remic: Person, holder: Person, prop: us.irc.core::Asset, fmv: Money, basis: Money) strict {
    label en official "section 860F(c)(1): gain (a loss is not recognized) as on a sale at fair market value";
    when remic_distributes_property_860Fc(remic, holder, prop);
    when fair_market_value_at_distribution_860Fc(prop, fmv);
    when remic_adjusted_basis_in_distributed_property_860Fc(remic, prop, basis);
    then remic_gain_on_distribution_860Fc1(remic, prop, max(0.00 USD, fmv - basis));
}
pub relation distributee_basis_in_property_860Fc2(holder: Person, prop: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the distributee's basis in the property is its fair market value";
}
rule Section860Fc2DistributeeBasisIsFmv(remic: Person, holder: Person, prop: us.irc.core::Asset, fmv: Money) strict {
    label en official "section 860F(c)(2): the distributee takes fair market value basis";
    when remic_distributes_property_860Fc(remic, holder, prop);
    when fair_market_value_at_distribution_860Fc(prop, fmv);
    then distributee_basis_in_property_860Fc2(holder, prop, fmv);
}
pub relation residual_interest_860Fd(interest: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest is a residual interest in a REMIC (or a comparable interest in a taxable mortgage pool)";
}
pub relation residual_interest_is_a_security_for_1091_860Fd1(interest: us.irc.core::Asset) kind institutional {
    label en official "the residual interest is a security for section 1091";
}
rule Section860Fd1ResidualInterestIsSecurity(interest: us.irc.core::Asset) strict {
    label en official "section 860F(d)(1): a residual interest is a security for the wash sale rule";
    when residual_interest_860Fd(interest);
    then residual_interest_is_a_security_for_1091_860Fd1(interest);
}
pub relation wash_sale_period_months_for_residual_interest_860Fd2B(interest: us.irc.core::Asset, months: Integer) kind institutional {
    label en official "in applying section 1091(a) and (e) to a loss on a residual interest, 6 months is substituted for 30 days";
}
@source(IRC_S860F_D, quote = "subsections (a) and (e) of such section shall be applied by substituting \"6 months\" for \"30 days\" each place it appears")
rule Section860Fd2BSixMonthsForThirtyDays(interest: us.irc.core::Asset) strict {
    label en official "section 860F(d)(2)(B): the wash sale window is 6 months";
    when residual_interest_860Fd(interest);
    then wash_sale_period_months_for_residual_interest_860Fd2B(interest, 6);
}
pub relation remic_treated_as_partnership_860Fe(remic: Person) kind institutional {
    label en official "for subtitle F a REMIC is treated as a partnership and the holders of residual interests as partners";
}
@source(IRC_S860F_E, quote = "For purposes of subtitle F, a REMIC shall be treated as a partnership (and holders of residual interests in such REMIC shall be treated as partners).")
rule Section860FeRemicIsPartnershipForSubtitleF(remic: Person, y: TaxableYear) strict {
    label en official "section 860F(e): a qualified REMIC is a partnership for subtitle F";
    when remic_qualified(remic, y);
    then remic_treated_as_partnership_860Fe(remic);
}

// ---- Section 860G: definitions, foreign holders, taxes ----

pub relation interest_issued_on_startup_day_with_fixed_terms_designated_regular_860Ga1(i: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest in a REMIC is issued on the startup day with fixed terms and is designated as a regular interest";
}
pub relation unconditionally_entitles_to_specified_principal_860Ga1A(i: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest unconditionally entitles the holder to receive a specified principal amount (or similar amount); only the timing (not the amount) of principal payments may be contingent on prepayments and on income from permitted investments";
}
pub relation interest_payments_fixed_or_specified_portion_860Ga1B(i: us.irc.core::Asset) kind empirical {
    label en unofficial "interest payments, if any, are payable at a fixed rate (or a variable rate provided in regulations) or consist of a specified portion of the interest payments on qualified mortgages that does not vary";
}
pub relation regular_interest_860Ga1(i: us.irc.core::Asset) kind institutional {
    label en official "the interest is a regular interest";
}
@source(IRC_S860G_A, quote = "The term \"regular interest\" means any interest in a REMIC which is issued on the startup day with fixed terms and which is designated as a regular interest if")
rule Section860Ga1RegularInterest(i: us.irc.core::Asset) strict {
    label en official "section 860G(a)(1): issued on the startup day with fixed terms, designated, with a specified principal and fixed or proportionate interest";
    when interest_issued_on_startup_day_with_fixed_terms_designated_regular_860Ga1(i);
    when unconditionally_entitles_to_specified_principal_860Ga1A(i);
    when interest_payments_fixed_or_specified_portion_860Ga1B(i);
    then regular_interest_860Ga1(i);
}
pub relation interest_issued_on_startup_day_designated_residual_860Ga2(i: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest is issued on the startup day and designated as a residual interest";
}
pub relation residual_interest_860Ga2(i: us.irc.core::Asset) kind institutional {
    label en official "the interest is a residual interest";
}
@source(IRC_S860G_A, quote = "The term \"residual interest\" means an interest in a REMIC which is issued on the startup day, which is not a regular interest, and which is designated as a residual interest.")
rule Section860Ga2ResidualInterest(i: us.irc.core::Asset) defeasible {
    label en official "section 860G(a)(2): a designated interest issued on the startup day that is not a regular interest";
    when interest_issued_on_startup_day_designated_residual_860Ga2(i);
    when not_known(regular_interest_860Ga1(i));
    then residual_interest_860Ga2(i);
}
pub relation obligation_principally_secured_by_real_property_860Ga3A(o: us.irc.core::Asset) kind institutional {
    label en unofficial "the obligation (or participation or certificate) is principally secured by an interest in real property (an obligation secured by cooperative housing stock counts)";
}
pub relation obligation_transferred_on_startup_day_860Ga3Ai(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is transferred to the REMIC on the startup day in exchange for regular or residual interests";
}
pub relation obligation_purchased_within_three_months_under_fixed_price_contract_860Ga3Aii(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is purchased within the 3-month period beginning on the startup day under a fixed-price contract in effect on the startup day";
}
pub relation obligation_is_reverse_mortgage_advance_increase_860Ga3Aiii(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation represents an increase in principal under an original obligation described in (i) or (ii), attributable to an advance under its original terms, occurring after the startup day and purchased under a fixed-price contract in effect on the startup day";
}
pub relation regular_interest_in_another_remic_transferred_on_startup_day_860Ga3C(o: us.irc.core::Asset) kind empirical {
    label en unofficial "a regular interest in another REMIC transferred to the REMIC on the startup day in exchange for regular or residual interests";
}
pub relation qualified_replacement_mortgage_860Ga4(o: us.irc.core::Asset) kind institutional {
    label en official "the obligation is a qualified replacement mortgage";
}
pub relation qualified_mortgage_860Ga3(o: us.irc.core::Asset) kind institutional {
    label en official "the obligation is a qualified mortgage";
}
rule Section860Ga3AiQualifiedMortgageTransferred(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3)(A)(i): a real-property obligation transferred on the startup day";
    when obligation_principally_secured_by_real_property_860Ga3A(o);
    when obligation_transferred_on_startup_day_860Ga3Ai(o);
    then qualified_mortgage_860Ga3(o);
}
rule Section860Ga3AiiQualifiedMortgagePurchased(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3)(A)(ii): a real-property obligation purchased within 3 months under a fixed-price contract";
    when obligation_principally_secured_by_real_property_860Ga3A(o);
    when obligation_purchased_within_three_months_under_fixed_price_contract_860Ga3Aii(o);
    then qualified_mortgage_860Ga3(o);
}
rule Section860Ga3AiiiQualifiedMortgageAdvance(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3)(A)(iii): a reverse mortgage advance increase";
    when obligation_principally_secured_by_real_property_860Ga3A(o);
    when obligation_is_reverse_mortgage_advance_increase_860Ga3Aiii(o);
    then qualified_mortgage_860Ga3(o);
}
rule Section860Ga3BQualifiedMortgageReplacement(o: us.irc.core::Asset) defeasible {
    label en official "section 860G(a)(3)(B): a qualified replacement mortgage";
    when qualified_replacement_mortgage_860Ga4(o);
    then qualified_mortgage_860Ga3(o);
}
rule Section860Ga3CQualifiedMortgageRegularInterest(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3)(C): a regular interest in another REMIC transferred on the startup day";
    when regular_interest_in_another_remic_transferred_on_startup_day_860Ga3C(o);
    then qualified_mortgage_860Ga3(o);
}
pub relation replacement_obligation_would_qualify_on_startup_day_860Ga4A(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation would be a qualified mortgage if transferred on the startup day in exchange for regular or residual interests";
}
pub relation replacement_received_for_another_obligation_within_three_months_860Ga4Bi(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is received for another obligation within the 3-month period beginning on the startup day";
}
pub relation replacement_received_for_defective_obligation_within_two_years_860Ga4Bii(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is received for a defective obligation within the 2-year period beginning on the startup day";
}
rule Section860Ga4QualifiedReplacementWithinThreeMonths(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(4): a replacement obligation received for another obligation within 3 months";
    when replacement_obligation_would_qualify_on_startup_day_860Ga4A(o);
    when replacement_received_for_another_obligation_within_three_months_860Ga4Bi(o);
    then qualified_replacement_mortgage_860Ga4(o);
}
rule Section860Ga4QualifiedReplacementDefective(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(4): a replacement obligation received for a defective obligation within 2 years";
    when replacement_obligation_would_qualify_on_startup_day_860Ga4A(o);
    when replacement_received_for_defective_obligation_within_two_years_860Ga4Bii(o);
    then qualified_replacement_mortgage_860Ga4(o);
}
pub relation qualified_reserve_fund_value_860Ga7B(remic: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of the assets held in the reserve";
}
pub relation remic_total_assets_value_on_startup_day_860Ga7B(remic: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of all the assets of the REMIC on the startup day";
}
pub relation reserve_within_fifty_percent_of_startup_assets_860Ga7B(remic: Person) kind institutional {
    label en official "the reserve does not exceed 50 percent of the aggregate fair market value of the REMIC's assets on the startup day";
}
@source(IRC_S860G_A, quote = "The aggregate fair market value of the assets held in any such reserve shall not exceed 50 percent of the aggregate fair market value of all of the assets of the REMIC on the startup day")
rule Section860Ga7BReserveWithinFiftyPercent(remic: Person, reserve: Money, total: Money) strict {
    label en official "section 860G(a)(7)(B): the reserve is at most 50 percent of the startup-day assets";
    when qualified_reserve_fund_value_860Ga7B(remic, reserve);
    when remic_total_assets_value_on_startup_day_860Ga7B(remic, total);
    when reserve * 100.0 <= total * 50.0;
    then reserve_within_fifty_percent_of_startup_assets_860Ga7B(remic);
}
pub relation reserve_gross_income_860Ga7C(remic: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income from the assets in the reserve fund for the taxable year";
}
pub relation reserve_gross_income_from_short_hold_dispositions_860Ga7C(remic: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of that gross income derived from the sale or other disposition of property held for less than 3 months (other than a qualified reserve asset disposed of to prevent a default on regular interests after a default on qualified mortgages)";
}
pub relation reserve_not_a_qualified_reserve_860Ga7C(remic: Person, y: TaxableYear) kind institutional {
    label en official "the reserve is not a qualified reserve for the year and all subsequent years: more than 30 percent of the gross income comes from short-held dispositions";
}
@source(IRC_S860G_A, quote = "if more than 30 percent of the gross income from the assets in such fund for the taxable year is derived from the sale or other disposition of property")
rule Section860Ga7CThirtyPercentShortHold(remic: Person, y: TaxableYear, short: Money, total: Money) strict {
    label en official "section 860G(a)(7)(C): more than 30 percent short-held income disqualifies the reserve";
    when reserve_gross_income_from_short_hold_dispositions_860Ga7C(remic, y, short);
    when reserve_gross_income_860Ga7C(remic, y, total);
    when short * 100.0 > total * 30.0;
    then reserve_not_a_qualified_reserve_860Ga7C(remic, y);
}
pub relation foreign_holder_of_residual_interest_860Gb(holder: Person) kind empirical {
    label en unofficial "the holder of a residual interest is a nonresident alien individual or a foreign corporation";
}
pub relation amounts_taken_into_account_when_paid_or_distributed_860Gb1(holder: Person, remic: Person) kind institutional {
    label en official "for sections 871(a), 881, 1441 and 1442 amounts includible under this part are taken into account when paid or distributed (or when the interest is disposed of)";
}
@source(IRC_S860G_B, quote = "amounts includible in the gross income of such holder under this part shall be taken into account when paid or distributed (or when the interest is disposed of)")
rule Section860Gb1WhenPaidOrDistributed(holder: Person, remic: Person) strict {
    label en official "section 860G(b)(1): timing for foreign holders";
    when foreign_holder_of_residual_interest_860Gb(holder);
    when holder_of_residual_interest_in_860Gb(holder, remic);
    then amounts_taken_into_account_when_paid_or_distributed_860Gb1(holder, remic);
}
pub relation holder_of_residual_interest_in_860Gb(holder: Person, remic: Person) kind empirical {
    label en unofficial "the holder holds a residual interest in the REMIC";
}
pub relation no_treaty_or_statutory_exemption_for_excess_inclusion_860Gb2(holder: Person, remic: Person) kind institutional {
    label en official "no exemption from the taxes of sections 871(a), 881, 1441 and 1442 (and no reduction in the rates) applies to any excess inclusion";
}
@source(IRC_S860G_B, quote = "no exemption from the taxes imposed by such sections (and no reduction in the rates of such taxes) shall apply to any excess inclusion")
rule Section860Gb2NoExemptionForExcessInclusion(holder: Person, remic: Person) strict {
    label en official "section 860G(b)(2): no exemption or rate reduction for excess inclusions of foreign holders";
    when foreign_holder_of_residual_interest_860Gb(holder);
    when holder_of_residual_interest_in_860Gb(holder, remic);
    then no_treaty_or_statutory_exemption_for_excess_inclusion_860Gb2(holder, remic);
}
pub relation remic_net_income_from_foreclosure_property_860Gc(remic: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount that would be the REMIC's net income from foreclosure property under section 857(b)(4)(B) if the REMIC were a real estate investment trust";
}
pub relation remic_foreclosure_property_tax_860Gc1(remic: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax on the net income from foreclosure property of the REMIC: the net income times the highest section 11(b) rate";
}
@source(IRC_S860G_C, quote = "Such tax shall be computed by multiplying the net income from foreclosure property by the highest rate of tax specified in section 11(b).")
rule Section860Gc1ForeclosurePropertyTax(remic: Person, y: TaxableYear, net: Money, rate: Decimal) strict {
    label en official "section 860G(c)(1): tax equals net income from foreclosure property times the highest rate";
    when remic_net_income_from_foreclosure_property_860Gc(remic, y, net);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then remic_foreclosure_property_tax_860Gc1(remic, y, round(net * rate, 2, "HALF_UP"));
}
pub relation contribution_to_remic_after_startup_day_860Gd(remic: Person, y: TaxableYear, contribution: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "an amount is contributed to the REMIC after the startup day, in the taxable year in which it is received";
}
pub relation contribution_is_cash_860Gd2(contribution: us.irc.core::Payment) kind empirical {
    label en unofficial "the contribution is made in cash";
}
pub relation contribution_within_exception_860Gd2(contribution: us.irc.core::Payment) kind empirical {
    label en unofficial "the cash contribution facilitates a clean-up call or a qualified liquidation (A), is a guarantee payment (B), is made during the 3-month period beginning on the startup day (C), is made to a qualified reserve fund by a residual holder (D), or is permitted in regulations (E)";
}
pub relation contribution_excepted_from_tax_860Gd2(contribution: us.irc.core::Payment) kind institutional {
    label en official "the cash contribution is described in one of the exceptions of paragraph (2)";
}
@source(IRC_S860G_D, quote = "Paragraph (1) shall not apply to any contribution which is made in cash and is described in any of the following subparagraphs")
rule Section860Gd2CashExceptions(contribution: us.irc.core::Payment) strict {
    label en official "section 860G(d)(2): only a cash contribution within a listed exception is excepted";
    when contribution_is_cash_860Gd2(contribution);
    when contribution_within_exception_860Gd2(contribution);
    then contribution_excepted_from_tax_860Gd2(contribution);
}
pub relation tax_on_post_startup_contribution_860Gd1(remic: Person, y: TaxableYear, contribution: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the tax equal to 100 percent of the contribution received after the startup day";
}
@source(IRC_S860G_D, quote = "if any amount is contributed to a REMIC after the startup day, there is hereby imposed a tax for the taxable year of the REMIC in which the contribution is received equal to 100 percent of the amount of such contribution")
rule Section860Gd1HundredPercentTax(remic: Person, y: TaxableYear, contribution: us.irc.core::Payment, amount: Money) strict {
    label en official "section 860G(d)(1): 100 percent tax on a post-startup contribution, unless excepted";
    when contribution_to_remic_after_startup_day_860Gd(remic, y, contribution, amount);
    when not_known(contribution_excepted_from_tax_860Gd2(contribution));
    then tax_on_post_startup_contribution_860Gd1(remic, y, contribution, amount);
}
