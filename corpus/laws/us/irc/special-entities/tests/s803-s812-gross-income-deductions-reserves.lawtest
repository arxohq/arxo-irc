// Sections 803-805, 807(a)-(d),(f), 812 scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).
// STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S803-01-GROSS-INCOME-WITH-NET-DECREASE-IN-RESERVES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_premiums_and_other_consideration_803a1A(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": return_premiums_803a1B(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f2": other_amounts_includible_803a3(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 10000.00 USD) { origin case_input; }
        assert "f3": reserve_items_opening_balance(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 500000.00 USD) { origin case_input; }
        assert "f4": reserve_items_closing_balance(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 450000.00 USD) { origin case_input; }
        assert "f5": policyholders_share_reduction_807(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 0.00 USD) { origin case_input; }
    }
    // net premiums = 1,000,000 - 100,000 = 900,000. closing net = 450,000 -
    // 0 = 450,000. opening (500,000) > closing net (450,000): decrease =
    // 50,000, included under 803(a)(2). gross income = 900,000 + 50,000 +
    // 10,000 = 960,000.
    evaluate truth(life_insurance_gross_income(entity_ref("urn:test:s803:t1#c"), entity_ref("urn:test:s803:t1#y"), 960000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S803-02-GROSS-INCOME-WITH-NO-RESERVE-CHANGE-COMPUTED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_premiums_and_other_consideration_803a1A(entity_ref("urn:test:s803:t2#c"), entity_ref("urn:test:s803:t2#y"), 700000.00 USD) { origin case_input; }
        assert "f1": return_premiums_803a1B(entity_ref("urn:test:s803:t2#c"), entity_ref("urn:test:s803:t2#y"), 50000.00 USD) { origin case_input; }
        assert "f2": other_amounts_includible_803a3(entity_ref("urn:test:s803:t2#c"), entity_ref("urn:test:s803:t2#y"), 5000.00 USD) { origin case_input; }
    }
    // no reserve-balance facts asserted: net_decrease_in_reserves_807a is
    // not derivable, so the fallback rule (guarded by
    // not_known(has_net_decrease_in_reserves_807a)) applies: gross income =
    // 650,000 + 5,000 = 655,000.
    evaluate truth(life_insurance_gross_income(entity_ref("urn:test:s803:t2#c"), entity_ref("urn:test:s803:t2#y"), 655000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S805-01-GENERAL-DEDUCTIONS-WITH-NET-INCREASE-IN-RESERVES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reserve_items_opening_balance(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 400000.00 USD) { origin case_input; }
        assert "f1": reserve_items_closing_balance(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 500000.00 USD) { origin case_input; }
        assert "f2": policyholders_share_reduction_807(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 0.00 USD) { origin case_input; }
        assert "f3": death_benefits_and_losses_805a1(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 200000.00 USD) { origin case_input; }
        assert "f4": policyholder_dividends_deduction_805a3(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 30000.00 USD) { origin case_input; }
        assert "f5": dividends_received_805a4_before_proration(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 20000.00 USD) { origin case_input; }
        assert "f6": assumption_of_liabilities_consideration_805a6(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 5000.00 USD) { origin case_input; }
        assert "f7": reimbursable_dividends_805a7(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 2000.00 USD) { origin case_input; }
        assert "f8": other_deductions_805a8(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 15000.00 USD) { origin case_input; }
    }
    // closing net = 500,000; opening = 400,000: increase = 100,000, deducted
    // under 805(a)(2). No 805(a)(4)(D) proration asserted: 805(a)(4) stands
    // at 20,000. Total = 200,000 + 100,000 + 30,000 + 20,000 + 5,000 + 2,000
    // + 15,000 = 372,000.
    evaluate truth(general_deductions_805(entity_ref("urn:test:s805:t1#c"), entity_ref("urn:test:s805:t1#y"), 372000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

