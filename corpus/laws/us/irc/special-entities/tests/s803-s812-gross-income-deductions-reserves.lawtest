    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": policyholder_dividends_paid_or_accrued_808c(entity_ref("urn:test:s808:t1#c"), entity_ref("urn:test:s808:t1#y"), 45000.00 USD) { origin case_input; }
    }
    evaluate truth(policyholder_dividends_deduction_805a3(entity_ref("urn:test:s808:t1#c"), entity_ref("urn:test:s808:t1#y"), 45000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
