        assert "f2": policyholders_share_reduction_807(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 0.00 USD) { origin case_input; }
        assert "f3": death_benefits_and_losses_805a1(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 200000.00 USD) { origin case_input; }
        assert "f4": policyholder_dividends_deduction_805a3(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 30000.00 USD) { origin case_input; }
        assert "f5": dividends_received_805a4_before_proration(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 20000.00 USD) { origin case_input; }
        assert "f6": assumption_of_liabilities_consideration_805a6(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 5000.00 USD) { origin case_input; }
        assert "f7": reimbursable_dividends_805a7(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 2000.00 USD) { origin case_input; }
        assert "f8": other_deductions_805a8(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 15000.00 USD) { origin case_input; }
