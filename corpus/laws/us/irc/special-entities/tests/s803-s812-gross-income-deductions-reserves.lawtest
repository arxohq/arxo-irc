    evaluate truth(life_insurance_deductions(entity_ref("urn:test:s804:t1#c"), entity_ref("urn:test:s804:t1#y"), 372000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S807D-01-RESERVE-92-81-PERCENT-EXCEEDS-SURRENDER-VALUE-NOT-CAPPED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_surrender_value_807(entity_ref("urn:test:s807d:t1#c"), entity_ref("urn:test:s807d:t1#contract"), 80000.00 USD) { origin case_input; }
        assert "f1": tax_reserve_method_amount_807d2(entity_ref("urn:test:s807d:t1#c"), entity_ref("urn:test:s807d:t1#contract"), 100000.00 USD) { origin case_input; }
        assert "f2": statutory_reserves_807d4(entity_ref("urn:test:s807d:t1#c"), entity_ref("urn:test:s807d:t1#contract"), 95000.00 USD) { origin case_input; }
    }
    // scaled = 100,000 * 0.9281 = 92,810.00; greater of (80,000, 92,810) =
    // 92,810; statutory cap (95,000) does not bind (92,810 <= 95,000).
    evaluate truth(life_insurance_reserve_807d(entity_ref("urn:test:s807d:t1#c"), entity_ref("urn:test:s807d:t1#contract"), 92810.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S807D-02-STATUTORY-RESERVES-CAP-BINDS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_surrender_value_807(entity_ref("urn:test:s807d:t2#c"), entity_ref("urn:test:s807d:t2#contract"), 80000.00 USD) { origin case_input; }
        assert "f1": tax_reserve_method_amount_807d2(entity_ref("urn:test:s807d:t2#c"), entity_ref("urn:test:s807d:t2#contract"), 100000.00 USD) { origin case_input; }
        assert "f2": statutory_reserves_807d4(entity_ref("urn:test:s807d:t2#c"), entity_ref("urn:test:s807d:t2#contract"), 90000.00 USD) { origin case_input; }
    }
    // scaled = 92,810 > statutory reserves (90,000): the section
    // 807(d)(1)(C) cap binds at 90,000.
    evaluate truth(life_insurance_reserve_807d(entity_ref("urn:test:s807d:t2#c"), entity_ref("urn:test:s807d:t2#contract"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S812-01-FLAT-SHARES-AND-ZERO-PRORATION-REDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": life_insurance_company(entity_ref("urn:test:s812:t1#paying"), entity_ref("urn:test:s812:t1#y")) { origin case_input; }
        assert "f1": life_insurance_company(entity_ref("urn:test:s812:t1#receiving"), entity_ref("urn:test:s812:t1#y2")) { origin case_input; }
        assert "f2": dividends_received_805a4_before_proration(entity_ref("urn:test:s812:t1#receiving"), entity_ref("urn:test:s812:t1#y2"), 50000.00 USD) { origin case_input; }
    }
    // both companies get the flat 70 percent section 812(a) share; the
    // paying company's share does NOT exceed the receiving company's (equal,
    // not strictly greater), so section 805(a)(4)(D)(i)'s own condition is
    // not met and no reduction fires: this is the CORRECT current-law
    // outcome under the flat post-2017 rule, not a gap. The base amount
    // (50,000) stands.
    evaluate truth(companys_share_812a(entity_ref("urn:test:s812:t1#paying"), entity_ref("urn:test:s812:t1#y"), 0.70));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(policyholders_share_812b(entity_ref("urn:test:s812:t1#paying"), entity_ref("urn:test:s812:t1#y"), 0.30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(dividends_received_805a4(entity_ref("urn:test:s812:t1#receiving"), entity_ref("urn:test:s812:t1#y2"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// STAGE 2b (25.09.2026): section 808(c).

