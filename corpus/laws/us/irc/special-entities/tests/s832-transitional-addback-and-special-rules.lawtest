        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": applicable_statutory_pattern_percent_832b8Ciii(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), 2025, 1, 0.60) { origin case_input; }
        assert "f1": applicable_statutory_pattern_percent_832b8Ciii(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), 2025, 2, 0.40) { origin case_input; }
        assert "f2": discount_factor_for_recognition_year_832b8B(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 2025, 1, 0.97) { origin case_input; }
        assert "f3": discount_factor_for_recognition_year_832b8B(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 2025, 2, 0.94) { origin case_input; }
        assert "f4": undiscounted_unearned_premiums_832b8Ci(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 2025, 1000000.00 USD) { origin case_input; }
        assert "f5": premiums_on_title_insurance_832b8A(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y")) { origin case_input; }
        assert "f6": gross_written_less_returns_and_reinsurance_832b4A(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 2000000.00 USD) { origin case_input; }
        assert "f7": discounted_unearned_premiums_end_of_prior_year_832b8(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 900000.00 USD) { origin case_input; }
    }
    // 2,000,000 + 900,000 - 958,000 = 1,942,000.00.
    evaluate truth(premiums_earned_title_insurance_832b8(entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#c"), entity_ref("urn:test:s832b8a-01-computed-discount-feeds-the-t#y"), 1942000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

