// Sections 851(a)-(b), 852(a)-(b) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S851-01-REGISTERED-DOMESTIC-CORPORATION-MEETING-ALL-TESTS-IS-A-RIC" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.definitions::domestic(entity_ref("urn:test:s851:t1#c")) { origin case_input; }
        assert "f1": registered_as_management_company_or_unit_investment_trust(entity_ref("urn:test:s851:t1#c")) { origin case_input; }
        assert "f2": elects_regulated_investment_company_status(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y")) { origin case_input; }
        assert "f3": qualifying_gross_income_851b2(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y"), 950000.00 USD) { origin case_input; }
        assert "f4": total_gross_income_851(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f5": cash_govt_and_qualifying_other_ric_securities_value(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y"), 6000000.00 USD) { origin case_input; }
        assert "f6": total_assets_value_851(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y"), 10000000.00 USD) { origin case_input; }
        assert "f7": single_issuer_securities_value_851(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y"), entity_ref("urn:test:s851:t1#issuer"), 2000000.00 USD) { origin case_input; }
    }
    // 950,000/1,000,000 = 95% >= 90%; 6,000,000/10,000,000 = 60% >= 50%;
    // 2,000,000/10,000,000 = 20% <= 25%.
    evaluate truth(regulated_investment_company(entity_ref("urn:test:s851:t1#c"), entity_ref("urn:test:s851:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S851-02-INCOME-TEST-AT-89-POINT-9-PERCENT-FAILS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualifying_gross_income_851b2(entity_ref("urn:test:s851:t2#c"), entity_ref("urn:test:s851:t2#y"), 899000.00 USD) { origin case_input; }
        assert "f1": total_gross_income_851(entity_ref("urn:test:s851:t2#c"), entity_ref("urn:test:s851:t2#y"), 1000000.00 USD) { origin case_input; }
    }
    // 899,000/1,000,000 = 89.9% < 90%: the cross-multiplied comparison
    // 89,900,000 >= 90,000,000 is false.
    evaluate truth(ninety_percent_income_test_met_851b2(entity_ref("urn:test:s851:t2#c"), entity_ref("urn:test:s851:t2#y")));
    expect truth_status == NEITHER;
}

test "S852-01-DISTRIBUTION-REQUIREMENT-MET-AT-EXACTLY-90-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": dividends_paid_deduction(entity_ref("urn:test:s852:t1#c"), entity_ref("urn:test:s852:t1#y"), 90000.00 USD) { origin case_input; }
        assert "f1": investment_company_taxable_income_without_b2d(entity_ref("urn:test:s852:t1#c"), entity_ref("urn:test:s852:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f2": tax_exempt_interest_income_103a(entity_ref("urn:test:s852:t1#c"), entity_ref("urn:test:s852:t1#y"), 0.00 USD) { origin case_input; }
        assert "f3": disallowed_deductions_265_171a2(entity_ref("urn:test:s852:t1#c"), entity_ref("urn:test:s852:t1#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(section_852a1_distribution_requirement_met(entity_ref("urn:test:s852:t1#c"), entity_ref("urn:test:s852:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S852-02-INVESTMENT-COMPANY-TAXABLE-INCOME-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ric_taxable_income_before_852b2_adjustments(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 500000.00 USD) { origin case_input; }
        assert "f1": net_capital_gain_ric(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 50000.00 USD) { origin case_input; }
        assert "f2": nol_deduction_previously_allowed_172(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 10000.00 USD) { origin case_input; }
        assert "f3": dividends_received_deduction_previously_allowed_part_viii(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 5000.00 USD) { origin case_input; }
        assert "f4": dividends_paid_deduction_852b2d(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 400000.00 USD) { origin case_input; }
        assert "f5": section_851_d2_and_i_tax_amount(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 1000.00 USD) { origin case_input; }
    }
    // 500,000 - 50,000 + 10,000 + 5,000 - 400,000 - 1,000 = 64,000.
    evaluate truth(investment_company_taxable_income(entity_ref("urn:test:s852:t2#c"), entity_ref("urn:test:s852:t2#y"), 64000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// section 852(b)(1)'s rate step (STAGE 2, WIRE-2), over the same ICTI as
// S852-02. As in S801-02, the `us.irc.corporations::taxable_income` fact
// only unlocks the rate export for the same (company, year) key.
test "S852-03-RIC-TAX-AT-SECTION-11-RATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ric_taxable_income_before_852b2_adjustments(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 500000.00 USD) { origin case_input; }
        assert "f1": net_capital_gain_ric(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 50000.00 USD) { origin case_input; }
        assert "f2": nol_deduction_previously_allowed_172(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 10000.00 USD) { origin case_input; }
        assert "f3": dividends_received_deduction_previously_allowed_part_viii(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 5000.00 USD) { origin case_input; }
        assert "f4": dividends_paid_deduction_852b2d(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 400000.00 USD) { origin case_input; }
        assert "f5": section_851_d2_and_i_tax_amount(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 1000.00 USD) { origin case_input; }
        assert "f6": us.irc.corporations::taxable_income(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 64000.00 USD) { origin case_input; }
    }
    // ICTI = 64,000 (as in S852-02); tax = 64,000 * 0.21 = 13,440.00.
    evaluate truth(ric_tax(entity_ref("urn:test:s852:t3#c"), entity_ref("urn:test:s852:t3#y"), 13440.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// section 852(b)(3)(A)'s rate step (STAGE 2, WIRE-2).
test "S852-04-RIC-CAPITAL-GAIN-TAX-AT-SECTION-11B-RATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_capital_gain_ric(entity_ref("urn:test:s852:t4#c"), entity_ref("urn:test:s852:t4#y"), 100000.00 USD) { origin case_input; }
        assert "f1": capital_gain_dividends_paid_852(entity_ref("urn:test:s852:t4#c"), entity_ref("urn:test:s852:t4#y"), 40000.00 USD) { origin case_input; }
        assert "f2": us.irc.corporations::taxable_income(entity_ref("urn:test:s852:t4#c"), entity_ref("urn:test:s852:t4#y"), 60000.00 USD) { origin case_input; }
    }
    // base = 100,000 - 40,000 = 60,000; tax = 60,000 * 0.21 = 12,600.00.
    evaluate truth(ric_capital_gain_tax(entity_ref("urn:test:s852:t4#c"), entity_ref("urn:test:s852:t4#y"), 12600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
