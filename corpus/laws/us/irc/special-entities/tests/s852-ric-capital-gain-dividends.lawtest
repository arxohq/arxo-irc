// Section 852(b)(3)(C)-(E) scenarios (capital gain dividends of regulated investment companies). NOT EXECUTED (implemented_unverified). STAGE 3 (26.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S852b3Civ-01-AGGREGATE-REPORTED-AMOUNT-IS-THE-SUM" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": reported_capital_gain_dividend_852b3C(entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#c"), entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#y"), entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#d1"), 600.00 USD, @2026-06-30) { origin case_input; }
        assert "f1": reported_capital_gain_dividend_852b3C(entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#c"), entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#y"), entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#d2"), 600.00 USD, @2027-01-15) { origin case_input; }
    }
    // 600 + 600 (one paid after the close under section 855): 1,200.00.
    evaluate truth(aggregate_reported_amount_852b3Civ(entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#c"), entity_ref("urn:test:s852b3civ-01-aggregate-reported-amount-i#y"), 1200.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

