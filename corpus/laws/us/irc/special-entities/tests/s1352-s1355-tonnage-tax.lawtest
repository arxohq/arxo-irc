// Sections 1352-1355 scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction). STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S1353-01-DAILY-INCOME-AT-OR-BELOW-25000-NET-TONS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_tonnage_of_vessel(entity_ref("urn:test:s1353:t1#v"), 20000.0) { origin case_input; }
    }
    // 20,000 net tons * $0.40/100 tons = 200 * 0.40 = $80.00/day.
    evaluate truth(daily_notional_shipping_income_1353c(entity_ref("urn:test:s1353:t1#v"), 80.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1353-02-DAILY-INCOME-ABOVE-25000-NET-TONS-TWO-TIERS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_tonnage_of_vessel(entity_ref("urn:test:s1353:t2#v"), 35000.0) { origin case_input; }
    }
    // low tier: 25,000 tons * $0.40/100 = 250 * 0.40 = $100.00.
    // high tier: (35,000 - 25,000) = 10,000 tons * $0.20/100 = 100 * 0.20 =
    // $20.00. total = $120.00/day.
    evaluate truth(daily_notional_shipping_income_1353c(entity_ref("urn:test:s1353:t2#v"), 120.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1353-03-PER-VESSEL-NOTIONAL-INCOME-OVER-QUALIFYING-DAYS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualifying_vessel(entity_ref("urn:test:s1353:t3#v"), entity_ref("urn:test:s1353:t3#y")) { origin case_input; }
        assert "f1": net_tonnage_of_vessel(entity_ref("urn:test:s1353:t3#v"), 20000.0) { origin case_input; }
        assert "f2": days_operated_as_qualifying_vessel(entity_ref("urn:test:s1353:t3#c"), entity_ref("urn:test:s1353:t3#v"), entity_ref("urn:test:s1353:t3#y"), 300) { origin case_input; }
    }
    // daily = $80.00 (as in S1353-01); * 300 days = $24,000.00.
    evaluate truth(notional_shipping_income_per_vessel_1353b1(entity_ref("urn:test:s1353:t3#c"), entity_ref("urn:test:s1353:t3#v"), entity_ref("urn:test:s1353:t3#y"), 24000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1352-01-ALTERNATIVE-TAX-COMBINES-ORDINARY-AND-NOTIONAL-AMOUNTS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_tonnage_tax_1354(entity_ref("urn:test:s1352:t1#c"), entity_ref("urn:test:s1352:t1#y")) { origin case_input; }
        assert "f1": qualifying_vessel(entity_ref("urn:test:s1352:t1#v"), entity_ref("urn:test:s1352:t1#y")) { origin case_input; }
        assert "f2": net_tonnage_of_vessel(entity_ref("urn:test:s1352:t1#v"), 20000.0) { origin case_input; }
        assert "f3": days_operated_as_qualifying_vessel(entity_ref("urn:test:s1352:t1#c"), entity_ref("urn:test:s1352:t1#v"), entity_ref("urn:test:s1352:t1#y"), 300) { origin case_input; }
        assert "f4": section_11_tax_after_subchapter_r_1352(entity_ref("urn:test:s1352:t1#c"), entity_ref("urn:test:s1352:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s1352:t1#y"), @2024-01-01) { origin case_input; }
    }
    // notional income = 24,000.00 (as in S1353-03); rate = 21%: 24,000 *
    // 0.21 = 5,040.00. tax = 50,000 + 5,040 = 55,040.00.
    evaluate truth(tonnage_tax(entity_ref("urn:test:s1352:t1#c"), entity_ref("urn:test:s1352:t1#y"), 55040.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1352-02-HIGHEST-RATE-IS-DERIVED-FROM-CORPORATIONS-NOT-A-CASE-FACT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_tonnage_tax_1354(entity_ref("urn:test:s1352:t2#c"), entity_ref("urn:test:s1352:t2#y")) { origin case_input; }
        assert "f1": qualifying_vessel(entity_ref("urn:test:s1352:t2#v"), entity_ref("urn:test:s1352:t2#y")) { origin case_input; }
        assert "f2": net_tonnage_of_vessel(entity_ref("urn:test:s1352:t2#v"), 20000.0) { origin case_input; }
        assert "f3": days_operated_as_qualifying_vessel(entity_ref("urn:test:s1352:t2#c"), entity_ref("urn:test:s1352:t2#v"), entity_ref("urn:test:s1352:t2#y"), 300) { origin case_input; }
        assert "f4": section_11_tax_after_subchapter_r_1352(entity_ref("urn:test:s1352:t2#c"), entity_ref("urn:test:s1352:t2#y"), 0.00 USD) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s1352:t2#y"), @2018-01-01) { origin case_input; }
    }
    // A year beginning on 2018-01-01 (after 2017-12-31): the highest rate is 21
    // percent: 24,000.00 * 0.21 = 5,040.00; ordinary tax 0.
    evaluate truth(tonnage_tax(entity_ref("urn:test:s1352:t2#c"), entity_ref("urn:test:s1352:t2#y"), 5040.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S1352-03-YEAR-BEGINNING-IN-2017-HAS-NO-DERIVED-RATE" {
    given {
        context {
            legal_time @2017-04-15;
            decision_time @2017-04-15T09:00:00-05:00;
            knowledge_time @2017-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_tonnage_tax_1354(entity_ref("urn:test:s1352:t3#c"), entity_ref("urn:test:s1352:t3#y")) { origin case_input; }
        assert "f1": qualifying_vessel(entity_ref("urn:test:s1352:t3#v"), entity_ref("urn:test:s1352:t3#y")) { origin case_input; }
        assert "f2": net_tonnage_of_vessel(entity_ref("urn:test:s1352:t3#v"), 20000.0) { origin case_input; }
        assert "f3": days_operated_as_qualifying_vessel(entity_ref("urn:test:s1352:t3#c"), entity_ref("urn:test:s1352:t3#v"), entity_ref("urn:test:s1352:t3#y"), 300) { origin case_input; }
        assert "f4": section_11_tax_after_subchapter_r_1352(entity_ref("urn:test:s1352:t3#c"), entity_ref("urn:test:s1352:t3#y"), 0.00 USD) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s1352:t3#y"), @2017-01-01) { origin case_input; }
    }
    // The pre-2018 graduated schedule is not in the pinned text: no rate, no tax.
    evaluate truth(tonnage_tax(entity_ref("urn:test:s1352:t3#c"), entity_ref("urn:test:s1352:t3#y"), 5040.00 USD));
    expect truth_status == NEITHER;
}
