    }
    // A family member's 15 percent.
    evaluate truth(reit_ownership_856h1B(entity_ref("urn:test:s856h1bi-01-family-ownership-is-attribut#ind"), entity_ref("urn:test:s856h1bi-01-family-ownership-is-attribut#t"), 0.15, us.irc.corporations::Family));
