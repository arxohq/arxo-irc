    expect evaluation_status == COMPUTED;
}

test "S856h1Bi-02-A-PARTNERS-OWNERSHIP-IS-NOT-ATTRIBUTED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": us.irc.corporations::partner_of_544a2(entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#rel"), entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#ind")) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#oi"), entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#rel"), entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#t"), 0.15) { origin case_input; }
    }
    // Section 544(a)(2) is applied without the partner rule.
    evaluate truth(reit_ownership_856h1B(entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#ind"), entity_ref("urn:test:s856h1bi-02-a-partners-ownership-is-not#t"), 0.15, us.irc.corporations::Family));
    expect truth_status == NEITHER;
}

