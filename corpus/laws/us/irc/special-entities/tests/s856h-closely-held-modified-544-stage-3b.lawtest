// Section 856(h)(1)(B) scenarios, stage 3b (modified section 544 ownership). NOT EXECUTED (implemented_unverified). STAGE 3b (26.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S856h1B-01-DIRECT-OWNERSHIP" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:s856h1b-01-direct-ownership#oi"), entity_ref("urn:test:s856h1b-01-direct-ownership#ind"), entity_ref("urn:test:s856h1b-01-direct-ownership#t"), 0.20) { origin case_input; }
    }
    // An individual owns 20 percent.
    evaluate truth(reit_ownership_856h1B(entity_ref("urn:test:s856h1b-01-direct-ownership#ind"), entity_ref("urn:test:s856h1b-01-direct-ownership#t"), 0.20, us.irc.corporations::Actual));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856h1Bi-01-FAMILY-OWNERSHIP-IS-ATTRIBUTED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": us.irc.corporations::family_of_544a2(entity_ref("urn:test:s856h1bi-01-family-ownership-is-attribut#rel"), entity_ref("urn:test:s856h1bi-01-family-ownership-is-attribut#ind")) { origin case_input; }
