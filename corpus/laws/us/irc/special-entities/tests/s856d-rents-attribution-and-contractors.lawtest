    }
    // 9 percent is below the 10 percent threshold: no related-tenant exclusion follows.
    evaluate truth(related_tenant_856d2B(entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#t"), entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#tenant"), entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#y")));
