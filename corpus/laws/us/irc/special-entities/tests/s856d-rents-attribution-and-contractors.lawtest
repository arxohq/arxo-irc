}

test "S856d5-03-TWENTY-PERCENT-OWNER-OF-CORPORATION-ATTRIBUTED-BY-TEN-PERCENT-SUBSTITUTION" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": rent_received_from_tenant_for_property_856d(entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#t"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#tenant"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#p"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#y"), 100000.00 USD) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#oi1"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#t"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#x"), 0.20) { origin case_input; }
        assert "f2": us.irc.core::ownership_interest(entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#oi2"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#x"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#tenant"), 0.60) { origin case_input; }
    }
    // Under section 318(a)(2)(C) alone a 20 percent owner is not attributed anything (50 percent needed); section 856(d)(5)(A) substitutes 10 percent.
    // t owns 20 percent of X; X owns 60 percent of the tenant: t is considered to own 20 percent x 60 percent = 12 percent of the tenant, at least 10 percent.
    evaluate truth(related_tenant_856d2B(entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#t"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#tenant"), entity_ref("urn:test:s856d5-03-twenty-percent-owner-of-corpor#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

