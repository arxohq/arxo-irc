// Section 856(d)(2)(B), (d)(3)-(6) scenarios (attribution, independent contractors, contingent rents, sublease-through). NOT EXECUTED (implemented_unverified). STAGE 3 (26.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S856d5-01-TWELVE-PERCENT-DIRECT-OWNERSHIP-MAKES-RELATED-TENANT" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": rent_received_from_tenant_for_property_856d(entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#t"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#tenant"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#p"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#y"), 100000.00 USD) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#oi1"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#t"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#tenant"), 0.12) { origin case_input; }
    }
    // 12 percent actual ownership of the tenant is at least 10 percent (section 856(d)(2)(B)).
    evaluate truth(related_tenant_856d2B(entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#t"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#tenant"), entity_ref("urn:test:s856d5-01-twelve-percent-direct-ownershi#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856d5-02-NINE-PERCENT-DIRECT-OWNERSHIP-NOT-RELATED-TENANT" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": rent_received_from_tenant_for_property_856d(entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#t"), entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#tenant"), entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#p"), entity_ref("urn:test:s856d5-02-nine-percent-direct-ownership#y"), 100000.00 USD) { origin case_input; }
