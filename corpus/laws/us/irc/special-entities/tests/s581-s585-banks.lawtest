// Sections 581, 585(a)-(c)(1)-(2) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S581-01-CHARTERED-SUPERVISED-BANK-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incorporated_as_bank_or_trust_company(entity_ref("urn:test:s581:t1#p")) { origin case_input; }
        assert "f1": substantial_banking_or_fiduciary_business(entity_ref("urn:test:s581:t1#p")) { origin case_input; }
        assert "f2": subject_to_banking_supervision(entity_ref("urn:test:s581:t1#p")) { origin case_input; }
    }
    evaluate truth(bank(entity_ref("urn:test:s581:t1#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S581-02-MISSING-SUPERVISION-NOT-A-BANK" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incorporated_as_bank_or_trust_company(entity_ref("urn:test:s581:t2#p")) { origin case_input; }
        assert "f1": substantial_banking_or_fiduciary_business(entity_ref("urn:test:s581:t2#p")) { origin case_input; }
    }
    // subject_to_banking_supervision not asserted: no established negation
    // either, so this is UNDETERMINED, not a computed FALSE.
    evaluate truth(bank(entity_ref("urn:test:s581:t2#p")));
    expect truth_status == NEITHER;
}

