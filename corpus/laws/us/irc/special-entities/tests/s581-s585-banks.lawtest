}

test "S585-04-EXACTLY-AT-500-MILLION-NOT-A-LARGE-BANK" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": average_adjusted_bases_of_bank_assets(entity_ref("urn:test:s585:t4#b"), entity_ref("urn:test:s585:t4#y"), 500000000.00 USD) { origin case_input; }
    }
    // section 585(c)(2)(A) requires the average adjusted bases to EXCEED
    // $500,000,000 — exactly at the threshold does not satisfy the strict
    // inequality, so the rule does not fire (NEITHER, not a computed FALSE).
    evaluate truth(large_bank(entity_ref("urn:test:s585:t4#b"), entity_ref("urn:test:s585:t4#y")));
    expect truth_status == NEITHER;
}

test "S585-05-LARGE-BANK-BLOCKS-585A-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incorporated_as_bank_or_trust_company(entity_ref("urn:test:s585:t5#b")) { origin case_input; }
        assert "f1": substantial_banking_or_fiduciary_business(entity_ref("urn:test:s585:t5#b")) { origin case_input; }
        assert "f2": subject_to_banking_supervision(entity_ref("urn:test:s585:t5#b")) { origin case_input; }
        assert "f3": bad_debt_reserve_addition_claimed(entity_ref("urn:test:s585:t5#b"), entity_ref("urn:test:s585:t5#y"), 50000.00 USD) { origin case_input; }
        assert "f4": experience_method_addition(entity_ref("urn:test:s585:t5#b"), entity_ref("urn:test:s585:t5#y"), 60000.00 USD) { origin case_input; }
        assert "f5": average_adjusted_bases_of_bank_assets(entity_ref("urn:test:s585:t5#b"), entity_ref("urn:test:s585:t5#y"), 600000000.00 USD) { origin case_input; }
    }
    // section 585(c)(1): a large bank is excepted from section 585(a)
    // entirely, so the deduction rule (guarded by not_known(large_bank))
    // does not fire.
    evaluate truth(reasonable_addition_to_bad_debt_reserve(entity_ref("urn:test:s585:t5#b"), entity_ref("urn:test:s585:t5#y"), 50000.00 USD));
    expect truth_status == NEITHER;
}

// STAGE 2b (25.09.2026): section 585(b)(2)'s experience-method computation
// (closes TECH-GAPS.md G100's branch (A) numeric gap; div_round(Money,
// Money) -> Decimal, errata E-0170).

test "S585-06-EXPERIENCE-METHOD-BRANCH-A-ONLY-NO-BASE-YEAR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bad_debts_sustained_6_year_period(entity_ref("urn:test:s585:t6#b"), entity_ref("urn:test:s585:t6#y"), 30000.00 USD) { origin case_input; }
        assert "f1": loans_outstanding_6_year_sum(entity_ref("urn:test:s585:t6#b"), entity_ref("urn:test:s585:t6#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": loans_outstanding_close_of_year(entity_ref("urn:test:s585:t6#b"), entity_ref("urn:test:s585:t6#y"), 900000.00 USD) { origin case_input; }
    }
    // ratio = 30,000 / 1,000,000 = 0.03; amount = 900,000 * 0.03 = 27,000.00.
    // No base_year_585b2 fact asserted: branch (B) is not computed, and the
    // fallback rule uses branch (A) alone.
    evaluate truth(experience_method_addition(entity_ref("urn:test:s585:t6#b"), entity_ref("urn:test:s585:t6#y"), 27000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S585-07-EXPERIENCE-METHOD-BRANCH-B-EXCEEDS-BRANCH-A-LOANS-DECREASED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bad_debts_sustained_6_year_period(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#y"), 30000.00 USD) { origin case_input; }
        assert "f1": loans_outstanding_6_year_sum(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": loans_outstanding_close_of_year(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#y"), 900000.00 USD) { origin case_input; }
        assert "f3": base_year_585b2(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#y"), entity_ref("urn:test:s585:t7#base_y")) { origin case_input; }
        assert "f4": reserve_balance_close_of_year(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#base_y"), 40000.00 USD) { origin case_input; }
        assert "f5": loans_outstanding_close_of_year(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#base_y"), 1000000.00 USD) { origin case_input; }
    }
    // branch (A) = 900,000 * (30,000/1,000,000) = 27,000.00 (as in S585-06).
    // branch (B): loans at close of year (900,000) < loans at close of base
    // year (1,000,000), so (ii) applies: 40,000 * (900,000/1,000,000) =
    // 36,000.00. greater of (A), (B) = 36,000.00.
    evaluate truth(experience_method_addition(entity_ref("urn:test:s585:t7#b"), entity_ref("urn:test:s585:t7#y"), 36000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S585-08-EXPERIENCE-METHOD-BRANCH-B-LOANS-NOT-DECREASED-USES-BASE-BALANCE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bad_debts_sustained_6_year_period(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#y"), 10000.00 USD) { origin case_input; }
        assert "f1": loans_outstanding_6_year_sum(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": loans_outstanding_close_of_year(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#y"), 1200000.00 USD) { origin case_input; }
        assert "f3": base_year_585b2(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#y"), entity_ref("urn:test:s585:t8#base_y")) { origin case_input; }
        assert "f4": reserve_balance_close_of_year(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#base_y"), 25000.00 USD) { origin case_input; }
        assert "f5": loans_outstanding_close_of_year(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#base_y"), 1000000.00 USD) { origin case_input; }
    }
    // branch (A) = 1,200,000 * (10,000/1,000,000) = 12,000.00. branch (B):
    // loans at close of year (1,200,000) is NOT less than at close of base
    // year (1,000,000), so (ii) does not apply; the branch amount is the
    // base-year reserve balance itself, 25,000.00. greater of (A), (B) =
    // 25,000.00.
    evaluate truth(experience_method_addition(entity_ref("urn:test:s585:t8#b"), entity_ref("urn:test:s585:t8#y"), 25000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Section 585(b)(2)(A) is one proportion with one rounding: 3000000 USD of
// loans at close of year times 3000000 / 9000000 is exactly 1000000 USD.
// The former form rounded the ratio to 0.333333 first and gave 999999 USD.
test "S585-A1-BRANCH-A-ONE-PROPORTION-ONE-ROUNDING" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": bad_debts_sustained_6_year_period(entity_ref("urn:test:s585:a1#b"), entity_ref("urn:test:s585:a1#y"), 3000000.00 USD) { origin case_input; }
        assert "f1": loans_outstanding_6_year_sum(entity_ref("urn:test:s585:a1#b"), entity_ref("urn:test:s585:a1#y"), 9000000.00 USD) { origin case_input; }
        assert "f2": loans_outstanding_close_of_year(entity_ref("urn:test:s585:a1#b"), entity_ref("urn:test:s585:a1#y"), 3000000.00 USD) { origin case_input; }
    }
    evaluate truth(experience_method_branch_a_amount(entity_ref("urn:test:s585:a1#b"), entity_ref("urn:test:s585:a1#y"), 1000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
