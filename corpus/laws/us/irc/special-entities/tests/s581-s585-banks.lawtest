test "S585-01-DEDUCTION-ALLOWED-WITHIN-CAP" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incorporated_as_bank_or_trust_company(entity_ref("urn:test:s585:t1#b")) { origin case_input; }
        assert "f1": substantial_banking_or_fiduciary_business(entity_ref("urn:test:s585:t1#b")) { origin case_input; }
        assert "f2": subject_to_banking_supervision(entity_ref("urn:test:s585:t1#b")) { origin case_input; }
        assert "f3": bad_debt_reserve_addition_claimed(entity_ref("urn:test:s585:t1#b"), entity_ref("urn:test:s585:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f4": experience_method_addition(entity_ref("urn:test:s585:t1#b"), entity_ref("urn:test:s585:t1#y"), 60000.00 USD) { origin case_input; }
    }
    evaluate truth(reasonable_addition_to_bad_debt_reserve(entity_ref("urn:test:s585:t1#b"), entity_ref("urn:test:s585:t1#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S585-02-CLAIMED-AMOUNT-EXCEEDS-CAP-NOT-ALLOWED-AT-THAT-AMOUNT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": incorporated_as_bank_or_trust_company(entity_ref("urn:test:s585:t2#b")) { origin case_input; }
        assert "f1": substantial_banking_or_fiduciary_business(entity_ref("urn:test:s585:t2#b")) { origin case_input; }
        assert "f2": subject_to_banking_supervision(entity_ref("urn:test:s585:t2#b")) { origin case_input; }
        assert "f3": bad_debt_reserve_addition_claimed(entity_ref("urn:test:s585:t2#b"), entity_ref("urn:test:s585:t2#y"), 90000.00 USD) { origin case_input; }
        assert "f4": experience_method_addition(entity_ref("urn:test:s585:t2#b"), entity_ref("urn:test:s585:t2#y"), 60000.00 USD) { origin case_input; }
    }
    // claimed (90,000) exceeds the experience-method cap (60,000): the
    // section 585(a)(1) rule's `claimed <= cap` premise fails, so no rule
    // derives the deduction at that amount (NEITHER, not a computed FALSE).
    evaluate truth(reasonable_addition_to_bad_debt_reserve(entity_ref("urn:test:s585:t2#b"), entity_ref("urn:test:s585:t2#y"), 90000.00 USD));
    expect truth_status == NEITHER;
}

