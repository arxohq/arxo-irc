// Sections 856(a),(c)(1)-(4), 857(a)-(b)(2),(b)(6) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S856-01-99-SHAREHOLDERS-FAILS-HUNDRED-TEST" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": number_of_beneficial_owners(entity_ref("urn:test:s856:t1#trust"), entity_ref("urn:test:s856:t1#y"), 99) { origin case_input; }
    }
    evaluate truth(hundred_shareholder_test_met(entity_ref("urn:test:s856:t1#trust"), entity_ref("urn:test:s856:t1#y")));
    expect truth_status == NEITHER;
}

test "S856-02-EXACTLY-100-SHAREHOLDERS-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": number_of_beneficial_owners(entity_ref("urn:test:s856:t2#trust"), entity_ref("urn:test:s856:t2#y"), 100) { origin case_input; }
    }
    evaluate truth(hundred_shareholder_test_met(entity_ref("urn:test:s856:t2#trust"), entity_ref("urn:test:s856:t2#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856-03-FULL-REIT-DEFINITION-ALL-CONDITIONS-MET" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": managed_by_trustees_or_directors(entity_ref("urn:test:s856:t3#trust")) { origin case_input; }
        assert "f1": beneficial_ownership_evidenced_by_transferable_shares(entity_ref("urn:test:s856:t3#trust")) { origin case_input; }
        assert "f2": would_be_taxable_as_domestic_corporation(entity_ref("urn:test:s856:t3#trust")) { origin case_input; }
        assert "f3": not_financial_institution_582c2(entity_ref("urn:test:s856:t3#trust")) { origin case_input; }
        assert "f4": not_insurance_company_subchapter_l(entity_ref("urn:test:s856:t3#trust")) { origin case_input; }
        assert "f5": number_of_beneficial_owners(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 150) { origin case_input; }
        assert "f6": not_closely_held_856h(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y")) { origin case_input; }
        assert "f7": elects_real_estate_investment_trust_status(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y")) { origin case_input; }
        assert "f8": qualifying_gross_income_856c2(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 96000.00 USD) { origin case_input; }
        assert "f9": total_gross_income_856_excluding_prohibited(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 100000.00 USD) { origin case_input; }
        assert "f10": qualifying_gross_income_856c3(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 80000.00 USD) { origin case_input; }
        assert "f11": qualifying_real_estate_and_cash_and_govt_securities_value(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 8000000.00 USD) { origin case_input; }
        assert "f12": total_assets_value_856(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 10000000.00 USD) { origin case_input; }
        assert "f13": non_qualifying_securities_value_856c4bi(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 2000000.00 USD) { origin case_input; }
        assert "f14": taxable_reit_subsidiary_securities_value(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 1000000.00 USD) { origin case_input; }
        assert "f15": nonqualified_publicly_offered_reit_debt_instruments_value(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y"), 0.00 USD) { origin case_input; }
        assert "f16": us.irc.core::begins(entity_ref("urn:test:s856:t3#y"), @2024-01-01) { origin case_input; }
        assert "f17": all_quarters_reviewed_856c4Biv_year(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y")) { origin case_input; }
    }
    // 96% >= 95%; 80% >= 75%; 80% >= 75% assets; 20%<=25%, 10%<=20%, 0%<=25%.
    evaluate truth(real_estate_investment_trust(entity_ref("urn:test:s856:t3#trust"), entity_ref("urn:test:s856:t3#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S857-01-PROHIBITED-TRANSACTION-100-PERCENT-TAX-NO-SAFE-HARBOR" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gain_from_prohibited_transactions(entity_ref("urn:test:s857:t1#trust"), entity_ref("urn:test:s857:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f1": deductions_connected_with_prohibited_transactions(entity_ref("urn:test:s857:t1#trust"), entity_ref("urn:test:s857:t1#y"), 20000.00 USD) { origin case_input; }
    }
    // net income = 80,000; taxed at 100% since no safe-harbor facts asserted.
    evaluate truth(prohibited_transaction_tax(entity_ref("urn:test:s857:t1#trust"), entity_ref("urn:test:s857:t1#y"), 80000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S857-02-SAFE-HARBOR-AT-7-SALES-BLOCKS-THE-TAX" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gain_from_prohibited_transactions(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), 100000.00 USD) { origin case_input; }
        assert "f1": deductions_connected_with_prohibited_transactions(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), 20000.00 USD) { origin case_input; }
        assert "f2": property_held_at_least_2_years(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), entity_ref("urn:test:s857:t2#asset")) { origin case_input; }
        assert "f3": two_year_capitalized_expenditures(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), entity_ref("urn:test:s857:t2#asset"), 25000.00 USD) { origin case_input; }
        assert "f4": net_selling_price(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), entity_ref("urn:test:s857:t2#asset"), 100000.00 USD) { origin case_input; }
        assert "f5": number_of_qualifying_sales_in_year(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), 7) { origin case_input; }
    }
    // held 2+ years, expenditures 25% <= 30%, 7 sales <= 7: safe harbor
    // applies, so the 100% tax does not fire.
    evaluate truth(prohibited_transaction_tax(entity_ref("urn:test:s857:t2#trust"), entity_ref("urn:test:s857:t2#y"), 80000.00 USD));
    expect truth_status == NEITHER;
}

test "S857-03-8-SALES-EXCEEDS-SAFE-HARBOR-SALES-COUNT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": property_held_at_least_2_years(entity_ref("urn:test:s857:t3#trust"), entity_ref("urn:test:s857:t3#y"), entity_ref("urn:test:s857:t3#asset")) { origin case_input; }
        assert "f1": two_year_capitalized_expenditures(entity_ref("urn:test:s857:t3#trust"), entity_ref("urn:test:s857:t3#y"), entity_ref("urn:test:s857:t3#asset"), 25000.00 USD) { origin case_input; }
        assert "f2": net_selling_price(entity_ref("urn:test:s857:t3#trust"), entity_ref("urn:test:s857:t3#y"), entity_ref("urn:test:s857:t3#asset"), 100000.00 USD) { origin case_input; }
        assert "f3": number_of_qualifying_sales_in_year(entity_ref("urn:test:s857:t3#trust"), entity_ref("urn:test:s857:t3#y"), 8) { origin case_input; }
    }
    // 8 sales exceeds the (iii)(I) 7-sale cap: the sales-count branch of the
    // safe harbor does not fire (the adjusted-basis-ratio branch was not
    // asserted either).
    evaluate truth(sale_within_prohibited_transaction_safe_harbor(entity_ref("urn:test:s857:t3#trust"), entity_ref("urn:test:s857:t3#y")));
    expect truth_status == NEITHER;
}

// section 857(b)(1)'s rate step (STAGE 2, WIRE-2), over a REIT taxable
// income computed from section 857(b)(2)'s own adjustments. As in S801-02,
// the `us.irc.corporations::taxable_income` fact only unlocks the rate
// export for the same (trust, year) key. This scenario's REIT is a
// corporation (per the module header LIMITATION: `reit_tax` is typed `t:
// Corporation` because `corporate_tax_rate` is).
test "S857-04-REIT-TAX-AT-SECTION-11-RATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": reit_taxable_income_before_857b2_adjustments(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 500000.00 USD) { origin case_input; }
        assert "f1": part_viii_deduction_previously_allowed_reit(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 5000.00 USD) { origin case_input; }
        assert "f2": dividends_paid_deduction_857b2b(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 400000.00 USD) { origin case_input; }
        assert "f3": net_income_from_foreclosure_property(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 0.00 USD) { origin case_input; }
        assert "f4": other_857_and_856_taxes_deducted(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 2000.00 USD) { origin case_input; }
        assert "f5": net_income_from_prohibited_transactions_reit(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 3000.00 USD) { origin case_input; }
        assert "f6": us.irc.corporations::taxable_income(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 100000.00 USD) { origin case_input; }
    }
    // REIT taxable income = 500,000 + 5,000 - 400,000 - 0 - 2,000 - 3,000
    // = 100,000; tax = 100,000 * 0.21 = 21,000.00.
    evaluate truth(reit_tax(entity_ref("urn:test:s857:t4#trust"), entity_ref("urn:test:s857:t4#y"), 21000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
