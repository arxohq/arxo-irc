test "S857b6Ci-01-EXACTLY-TWO-YEARS-HELD-BY-DATES" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": reit_sale_857b6(entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#t"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#y"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#p"), @2026-06-30, 100000.00 USD) { origin case_input; }
        assert "f1": reit_acquired_property_on_857b6(entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#t"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#p"), @2024-06-30) { origin case_input; }
        assert "f2": number_of_qualifying_sales_in_year(entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#t"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#y"), 3) { origin case_input; }
    }
    // Acquired 2024-06-30, sold 2026-06-30: two calendar years to the day.
    evaluate truth(held_two_years_857b6(entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#t"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#y"), entity_ref("urn:test:s857b6ci-01-exactly-two-years-held-by-da#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

