    evaluate truth(treated_as_investment_property_857b6I(entity_ref("urn:test:s857b6i-01-sale-before-termination-date#t"), entity_ref("urn:test:s857b6i-01-sale-before-termination-date#y"), entity_ref("urn:test:s857b6i-01-sale-before-termination-date#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

