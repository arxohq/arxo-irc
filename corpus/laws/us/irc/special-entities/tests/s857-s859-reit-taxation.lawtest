        assert "f1": us.irc.core::ends(entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#y"), @2026-12-31) { origin case_input; }
        assert "f2": aggregate_designated_dividends_857g1(entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#t"), entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#y"), 800000.00 USD) { origin case_input; }
