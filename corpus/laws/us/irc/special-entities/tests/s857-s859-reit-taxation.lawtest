    }
    // notice mailed 2027-01-30 is before the 30 days after 2026-12-31 expire (2027-01-30 is day 30: expiration comes after it)
    evaluate truth(designation_timely_857b3B(entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#t"), entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#y"), entity_ref("urn:test:s857b3b-01-timely-designation-within-cap#d")));
