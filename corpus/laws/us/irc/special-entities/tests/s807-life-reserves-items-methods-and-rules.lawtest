test "S807a-01-ITEMISED-BALANCES-NET-DECREASE" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": reserve_item_807c(entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#c"), entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#y"), entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#i1"), ItemLifeInsuranceReserves, OpeningBalance, 1000000.00 USD) { origin case_input; }
        assert "f1": reserve_item_807c(entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#c"), entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#y"), entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#i2"), ItemLifeInsuranceReserves, ClosingBalance, 800000.00 USD) { origin case_input; }
    }
    // Opening 1,000,000, closing 800,000, no policyholders'-share reduction: net decrease 200,000.00 (sums over derived items, TECH-GAPS G4903).
    evaluate truth(net_decrease_in_reserves_807a(entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#c"), entity_ref("urn:test:s807a-01-itemised-balances-net-decrease#y"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

