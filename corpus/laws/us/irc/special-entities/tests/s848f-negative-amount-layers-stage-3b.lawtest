// Section 848(f)(1)(B)(i) scenarios, stage 3b (per-year layers of the unamortized balance). NOT EXECUTED (implemented_unverified). STAGE 3b (26.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S848f1Bi-01-LAYERS-ARE-ADDED-TO-THE-UNAMORTIZED-BALANCE" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": unamortized_layer_balance_848f1Bi(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#c"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#y"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l1"), 100000.00 USD) { origin case_input; }
        assert "f1": unamortized_layer_balance_848f1Bi(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#c"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#y"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l2"), 200000.00 USD) { origin case_input; }
        assert "f2": unamortized_layer_balance_848f1Bi(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#c"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#y"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l3"), 300000.00 USD) { origin case_input; }
        assert "f3": us.irc.core::begins(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l1"), @2020-01-01) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l2"), @2021-01-01) { origin case_input; }
        assert "f5": us.irc.core::begins(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#l3"), @2022-01-01) { origin case_input; }
    }
    // 100,000 + 200,000 + 300,000 = 600,000.00.
    evaluate truth(unamortized_balance_at_year_start_848f1Bi(entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#c"), entity_ref("urn:test:s848f1bi-01-layers-are-added-to-the-unam#y"), 600000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

