// Section 860 (all subsections) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S860-01-VALID-CLAIM-WITHIN-120-DAYS-DEDUCTION-ALLOWED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": regulated_investment_company(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y")) { origin case_input; }
        assert "f1": final_court_decision(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), @2024-01-10) { origin adjudicated; }
        assert "f2": adjustment_amount_ric(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f3": distribution_after_determination_before_claim(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), 50000.00 USD, @2024-01-20) { origin case_input; }
        assert "f4": distributed_within_90_days_of_determination(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), @2024-01-20, @2024-01-10) { origin case_input; }
        assert "f5": claim_filed_under_860g(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), @2024-02-01) { origin case_input; }
        assert "f6": claim_filed_within_120_days_of_determination(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), @2024-02-01, @2024-01-10) { origin case_input; }
    }
    evaluate truth(deficiency_dividend_deduction_allowed(entity_ref("urn:test:s860:t1#p"), entity_ref("urn:test:s860:t1#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S860-02-CLAIM-FILED-LATE-DEDUCTION-BLOCKED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": regulated_investment_company(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y")) { origin case_input; }
        assert "f1": final_court_decision(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), @2024-01-10) { origin adjudicated; }
        assert "f2": adjustment_amount_ric(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), 50000.00 USD) { origin case_input; }
        assert "f3": distribution_after_determination_before_claim(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), 50000.00 USD, @2024-01-20) { origin case_input; }
        assert "f4": distributed_within_90_days_of_determination(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), @2024-01-20, @2024-01-10) { origin case_input; }
        assert "f5": claim_filed_under_860g(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), @2024-06-01) { origin case_input; }
        // claim_filed_within_120_days_of_determination is NOT asserted:
        // the claim was filed more than 120 days after the January 10
        // determination.
    }
    // section 860(g)/(a): the power's valid_when fails for want of a
    // timely claim — POWER_INVALID_EXERCISE, no effect (E-0239).
    evaluate truth(deficiency_dividend_deduction_allowed(entity_ref("urn:test:s860:t2#p"), entity_ref("urn:test:s860:t2#y"), 50000.00 USD));
    expect truth_status == FALSE_ONLY;
}

test "S860-03-FRAUD-FINDING-BARS-THE-DEDUCTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": regulated_investment_company(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y")) { origin case_input; }
        assert "f1": final_court_decision(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), @2024-01-10) { origin adjudicated; }
        assert "f2": adjustment_amount_ric(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), 50000.00 USD) { origin case_input; }
        assert "f3": distribution_after_determination_before_claim(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), 50000.00 USD, @2024-01-20) { origin case_input; }
        assert "f4": distributed_within_90_days_of_determination(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), @2024-01-20, @2024-01-10) { origin case_input; }
        assert "f5": claim_filed_under_860g(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), @2024-02-01) { origin case_input; }
        assert "f6": claim_filed_within_120_days_of_determination(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), @2024-02-01, @2024-01-10) { origin case_input; }
        assert "f7": determination_finds_fraud_or_willful_failure_to_file(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y")) { origin adjudicated; }
    }
    // section 860(i): a fraud finding bars the deduction even though the
    // claim was timely.
    evaluate truth(deficiency_dividend_deduction_allowed(entity_ref("urn:test:s860:t3#p"), entity_ref("urn:test:s860:t3#y"), 50000.00 USD));
    expect truth_status == FALSE_ONLY;
}

test "S860-04-QUALIFIED-INVESTMENT-ENTITY-BY-REIT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": real_estate_investment_trust(entity_ref("urn:test:s860:t4#p"), entity_ref("urn:test:s860:t4#y")) { origin case_input; }
    }
    evaluate truth(qualified_investment_entity(entity_ref("urn:test:s860:t4#p"), entity_ref("urn:test:s860:t4#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
