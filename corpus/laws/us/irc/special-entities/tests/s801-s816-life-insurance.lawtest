// Sections 801, 816(a) scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S801-01-LICTI-EQUALS-GROSS-MINUS-DEDUCTIONS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": life_insurance_gross_income(entity_ref("urn:test:s801:t1#c"), entity_ref("urn:test:s801:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": life_insurance_deductions(entity_ref("urn:test:s801:t1#c"), entity_ref("urn:test:s801:t1#y"), 400000.00 USD) { origin case_input; }
    }
    evaluate truth(life_insurance_company_taxable_income(entity_ref("urn:test:s801:t1#c"), entity_ref("urn:test:s801:t1#y"), 600000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// section 801(a)'s rate step (STAGE 2, WIRE-2): the tax is the section 11
// rate (21 percent, current era) applied to the LICTI from the scenario
// above. The `us.irc.corporations::taxable_income` fact below is asserted
// ONLY to unlock that package's `corporate_tax_rate` export for the SAME
// (company, year) key this scenario's own section 801 computation uses
// (see module 02's header); it does not create or affect a real section
// 11(a) liability for this company, which section 11(c)(2) excludes from
// section 11(a) whenever it is subject to a subchapter L tax.
test "S801-02-LICTI-TAXED-AT-SECTION-11-RATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": life_insurance_gross_income(entity_ref("urn:test:s801:t2#c"), entity_ref("urn:test:s801:t2#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": life_insurance_deductions(entity_ref("urn:test:s801:t2#c"), entity_ref("urn:test:s801:t2#y"), 400000.00 USD) { origin case_input; }
        assert "f2": us.irc.corporations::taxable_income(entity_ref("urn:test:s801:t2#c"), entity_ref("urn:test:s801:t2#y"), 600000.00 USD) { origin case_input; }
    }
    // LICTI = 1,000,000 - 400,000 = 600,000; tax = 600,000 * 0.21 = 126,000.
    evaluate truth(life_insurance_company_tax(entity_ref("urn:test:s801:t2#c"), entity_ref("urn:test:s801:t2#y"), 126000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S816-01-RESERVES-RATIO-JUST-ABOVE-50-PERCENT-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": insurance_company_by_816a(entity_ref("urn:test:s816:t1#p"), entity_ref("urn:test:s816:t1#y")) { origin case_input; }
        assert "f1": issues_life_insurance_or_annuity_contracts(entity_ref("urn:test:s816:t1#p")) { origin case_input; }
        assert "f2": life_insurance_reserves(entity_ref("urn:test:s816:t1#p"), entity_ref("urn:test:s816:t1#y"), 510000.00 USD) { origin case_input; }
        assert "f3": unearned_premiums_and_unpaid_losses_not_in_reserves(entity_ref("urn:test:s816:t1#p"), entity_ref("urn:test:s816:t1#y"), 0.00 USD) { origin case_input; }
        assert "f4": total_reserves_816c(entity_ref("urn:test:s816:t1#p"), entity_ref("urn:test:s816:t1#y"), 1000000.00 USD) { origin case_input; }
    }
    // 510,000 / 1,000,000 = 51% > 50%.
    evaluate truth(life_insurance_company(entity_ref("urn:test:s816:t1#p"), entity_ref("urn:test:s816:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S816-02-RESERVES-RATIO-EXACTLY-50-PERCENT-DOES-NOT-QUALIFY" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": insurance_company_by_816a(entity_ref("urn:test:s816:t2#p"), entity_ref("urn:test:s816:t2#y")) { origin case_input; }
        assert "f1": issues_life_insurance_or_annuity_contracts(entity_ref("urn:test:s816:t2#p")) { origin case_input; }
        assert "f2": life_insurance_reserves(entity_ref("urn:test:s816:t2#p"), entity_ref("urn:test:s816:t2#y"), 500000.00 USD) { origin case_input; }
        assert "f3": unearned_premiums_and_unpaid_losses_not_in_reserves(entity_ref("urn:test:s816:t2#p"), entity_ref("urn:test:s816:t2#y"), 0.00 USD) { origin case_input; }
        assert "f4": total_reserves_816c(entity_ref("urn:test:s816:t2#p"), entity_ref("urn:test:s816:t2#y"), 1000000.00 USD) { origin case_input; }
    }
    // section 816(a) requires MORE than 50 percent: exactly 50% fails the
    // strict inequality, so no rule derives life_insurance_company.
    evaluate truth(life_insurance_company(entity_ref("urn:test:s816:t2#p"), entity_ref("urn:test:s816:t2#y")));
    expect truth_status == NEITHER;
}
