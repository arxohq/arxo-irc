// Section 856(d) scenarios. NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction). STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S856D-01-PERSONAL-PROPERTY-RENT-AT-15-PERCENT-INCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rents_from_interests_in_real_property_856d1A(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 850000.00 USD) { origin case_input; }
        assert "f1": service_charges_customary_856d1B(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f2": average_fmv_personal_property_856d1C(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 15000.00 USD) { origin case_input; }
        assert "f3": average_fmv_real_and_personal_property_856d1C(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f4": total_rent_real_and_personal_property_856d1C(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 1000000.00 USD) { origin case_input; }
    }
    // personal-property rent = 1,000,000 * (15,000/100,000) = 150,000.00;
    // 150,000/1,000,000 = 15% <= 15%: included. total = 850,000 + 50,000 +
    // 150,000 = 1,050,000.00.
    evaluate truth(rents_from_real_property(entity_ref("urn:test:s856d:t1#t"), entity_ref("urn:test:s856d:t1#y"), 1050000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856D-02-PERSONAL-PROPERTY-RENT-OVER-15-PERCENT-EXCLUDED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rents_from_interests_in_real_property_856d1A(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 850000.00 USD) { origin case_input; }
        assert "f1": service_charges_customary_856d1B(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 50000.00 USD) { origin case_input; }
        assert "f2": average_fmv_personal_property_856d1C(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 20000.00 USD) { origin case_input; }
        assert "f3": average_fmv_real_and_personal_property_856d1C(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 100000.00 USD) { origin case_input; }
        assert "f4": total_rent_real_and_personal_property_856d1C(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 1000000.00 USD) { origin case_input; }
    }
    // personal-property rent = 1,000,000 * (20,000/100,000) = 200,000.00;
    // 200,000/1,000,000 = 20% > 15%: the whole personal-property category
    // fails (1)(C) and is excluded entirely. total = 850,000 + 50,000 =
    // 900,000.00 (not 900,000 + a reduced personal-property amount).
    evaluate truth(rents_from_real_property(entity_ref("urn:test:s856d:t2#t"), entity_ref("urn:test:s856d:t2#y"), 900000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856D-03-TEN-PERCENT-OWNERSHIP-MAKES-RELATED-TENANT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": trust_ownership_percentage_of_tenant_856d2B(entity_ref("urn:test:s856d:t3#t"), entity_ref("urn:test:s856d:t3#tenant"), entity_ref("urn:test:s856d:t3#y"), 0.10) { origin case_input; }
    }
    evaluate truth(related_tenant_856d2B(entity_ref("urn:test:s856d:t3#t"), entity_ref("urn:test:s856d:t3#tenant"), entity_ref("urn:test:s856d:t3#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S856D-04-SERVICE-INCOME-OVER-ONE-PERCENT-DISQUALIFIES-ALL-AMOUNTS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tenant_service_income_856d7A(entity_ref("urn:test:s856d:t4#t"), entity_ref("urn:test:s856d:t4#y"), entity_ref("urn:test:s856d:t4#property"), 1100.00 USD) { origin case_input; }
        assert "f1": all_amounts_from_property_856d7B(entity_ref("urn:test:s856d:t4#t"), entity_ref("urn:test:s856d:t4#y"), entity_ref("urn:test:s856d:t4#property"), 100000.00 USD) { origin case_input; }
    }
    // 1,100 / 100,000 = 1.1% > 1%: ALL 100,000 becomes impermissible tenant
    // service income (not just the 1,100).
    evaluate truth(impermissible_tenant_service_income_856d7(entity_ref("urn:test:s856d:t4#t"), entity_ref("urn:test:s856d:t4#y"), entity_ref("urn:test:s856d:t4#property"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
