// Sections 831(a)-(b), 832(a),(b)(1),(3)-(5) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S831-01-SMALL-COMPANY-ELECTION-VALID" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_written_premiums(entity_ref("urn:test:s831:t1#c"), entity_ref("urn:test:s831:t1#y"), 2000000.00 USD) { origin case_input; }
        assert "f1": direct_written_premiums(entity_ref("urn:test:s831:t1#c"), entity_ref("urn:test:s831:t1#y"), 1800000.00 USD) { origin case_input; }
        assert "f2": premiums_from_one_policyholder(entity_ref("urn:test:s831:t1#c"), entity_ref("urn:test:s831:t1#y"), entity_ref("urn:test:s831:t1#holder"), 300000.00 USD) { origin case_input; }
        assert "f3": elects_section_831b(entity_ref("urn:test:s831:t1#c"), entity_ref("urn:test:s831:t1#y")) { origin case_input; }
    }
    // premiums measure = 2,000,000 (net, since net >= direct); one
    // policyholder's 300,000 is 15% <= 20%; premiums <= $2,200,000: valid
    // election.
    evaluate truth(section_831b_alternative_tax_applies(entity_ref("urn:test:s831:t1#c"), entity_ref("urn:test:s831:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S831-02-ELECTION-INVALID-PREMIUMS-OVER-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_written_premiums(entity_ref("urn:test:s831:t2#c"), entity_ref("urn:test:s831:t2#y"), 2500000.00 USD) { origin case_input; }
        assert "f1": direct_written_premiums(entity_ref("urn:test:s831:t2#c"), entity_ref("urn:test:s831:t2#y"), 2000000.00 USD) { origin case_input; }
        assert "f2": premiums_from_one_policyholder(entity_ref("urn:test:s831:t2#c"), entity_ref("urn:test:s831:t2#y"), entity_ref("urn:test:s831:t2#holder"), 100000.00 USD) { origin case_input; }
        assert "f3": elects_section_831b(entity_ref("urn:test:s831:t2#c"), entity_ref("urn:test:s831:t2#y")) { origin case_input; }
    }
    // premiums measure = 2,500,000 > $2,200,000: the (2)(A) threshold fails,
    // so meets_section_831b_requirements is not derivable and the power's
    // valid_when fails — POWER_INVALID_EXERCISE, no effect (E-0239).
    evaluate truth(section_831b_alternative_tax_applies(entity_ref("urn:test:s831:t2#c"), entity_ref("urn:test:s831:t2#y")));
    expect truth_status == FALSE_ONLY;
}

test "S831-03-DIVERSIFICATION-AT-EXACTLY-20-PERCENT-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_written_premiums(entity_ref("urn:test:s831:t3#c"), entity_ref("urn:test:s831:t3#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": direct_written_premiums(entity_ref("urn:test:s831:t3#c"), entity_ref("urn:test:s831:t3#y"), 900000.00 USD) { origin case_input; }
        assert "f2": premiums_from_one_policyholder(entity_ref("urn:test:s831:t3#c"), entity_ref("urn:test:s831:t3#y"), entity_ref("urn:test:s831:t3#holder"), 200000.00 USD) { origin case_input; }
    }
    // 200,000 / 1,000,000 = exactly 20 percent: "no more than 20 percent"
    // includes the boundary.
    evaluate truth(section_831b_diversification_requirement_met(entity_ref("urn:test:s831:t3#c"), entity_ref("urn:test:s831:t3#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S832-01-PREMIUMS-EARNED-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_premiums_written(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": return_premiums(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f2": premiums_paid_for_reinsurance(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 20000.00 USD) { origin case_input; }
        assert "f3": unearned_premiums_end_of_prior_year(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f4": unearned_premiums_end_of_year(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 120000.00 USD) { origin case_input; }
    }
    // (1,000,000 - 50,000 - 20,000) + 80%*100,000 - 80%*120,000
    // = 930,000 + 80,000 - 96,000 = 914,000.
    evaluate truth(premiums_earned(entity_ref("urn:test:s832:t1#c"), entity_ref("urn:test:s832:t1#y"), 914000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S832-02-LOSSES-INCURRED-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": losses_paid(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 500000.00 USD) { origin case_input; }
        assert "f1": salvage_and_reinsurance_recovered(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 30000.00 USD) { origin case_input; }
        assert "f2": unpaid_losses_on_life_and_discounted_unpaid_losses_end_of_year(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 200000.00 USD) { origin case_input; }
        assert "f3": unpaid_losses_on_life_and_discounted_unpaid_losses_end_of_prior_year(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 180000.00 USD) { origin case_input; }
        assert "f4": estimated_salvage_and_reinsurance_recoverable_end_of_prior_year(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 10000.00 USD) { origin case_input; }
        assert "f5": estimated_salvage_and_reinsurance_recoverable_end_of_year(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 15000.00 USD) { origin case_input; }
    }
    // (500,000 - 30,000) + (200,000 - 180,000) + (10,000 - 15,000)
    // = 470,000 + 20,000 - 5,000 = 485,000.
    evaluate truth(losses_incurred(entity_ref("urn:test:s832:t2#c"), entity_ref("urn:test:s832:t2#y"), 485000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S832-03-UNDERWRITING-INCOME-COMPUTATION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": premiums_earned(entity_ref("urn:test:s832:t3#c"), entity_ref("urn:test:s832:t3#y"), 900000.00 USD) { origin case_input; }
        assert "f1": losses_incurred(entity_ref("urn:test:s832:t3#c"), entity_ref("urn:test:s832:t3#y"), 500000.00 USD) { origin case_input; }
        assert "f2": expenses_incurred_832b6(entity_ref("urn:test:s832:t3#c"), entity_ref("urn:test:s832:t3#y"), 150000.00 USD) { origin case_input; }
    }
    evaluate truth(underwriting_income(entity_ref("urn:test:s832:t3#c"), entity_ref("urn:test:s832:t3#y"), 250000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// section 831(a)'s rate step (STAGE 2, WIRE-2): a company within section
// 816(a) that has not made a section 831(b) election is subject to section
// 831(a); its taxable income is taxed at the section 11 rate. As in
// S801-02, the `us.irc.corporations::taxable_income` fact only unlocks the
// rate export for the same (company, year) key.
test "S831-04-OTHER-INSURANCE-COMPANY-TAXED-AT-SECTION-11-RATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": insurance_company_by_816a(entity_ref("urn:test:s831:t4#c"), entity_ref("urn:test:s831:t4#y")) { origin case_input; }
        assert "f1": insurance_company_gross_income_832b1(entity_ref("urn:test:s831:t4#c"), entity_ref("urn:test:s831:t4#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": insurance_deductions_832c(entity_ref("urn:test:s831:t4#c"), entity_ref("urn:test:s831:t4#y"), 700000.00 USD) { origin case_input; }
        assert "f3": us.irc.corporations::taxable_income(entity_ref("urn:test:s831:t4#c"), entity_ref("urn:test:s831:t4#y"), 300000.00 USD) { origin case_input; }
    }
    // not a life insurance company (no S816(a) reserves-ratio facts
    // asserted) and no section 831(b) election: subject to section 831(a).
    // taxable income = 1,000,000 - 700,000 = 300,000; tax = 300,000 * 0.21
    // = 63,000.
    evaluate truth(other_insurance_company_tax(entity_ref("urn:test:s831:t4#c"), entity_ref("urn:test:s831:t4#y"), 63000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// STAGE 2b (25.09.2026): section 846 (discounted unpaid losses).

test "S846-01-PRESENT-VALUE-NOT-CAPPED-BY-ANNUAL-STATEMENT-AGGREGATE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": undiscounted_unpaid_losses_846(entity_ref("urn:test:s846:t1#c"), entity_ref("urn:test:s846:t1#y"), "auto_liability", entity_ref("urn:test:s846:t1#ay2022"), 100000.00 USD) { origin case_input; }
        assert "f1": discount_factor_846(entity_ref("urn:test:s846:t1#c"), entity_ref("urn:test:s846:t1#y"), "auto_liability", entity_ref("urn:test:s846:t1#ay2022"), 0.90) { origin case_input; }
        assert "f2": annual_statement_aggregate_unpaid_losses_846a3(entity_ref("urn:test:s846:t1#c"), entity_ref("urn:test:s846:t1#y"), "auto_liability", entity_ref("urn:test:s846:t1#ay2022"), 95000.00 USD) { origin case_input; }
    }
    // present value = 100,000 * 0.90 = 90,000.00; annual-statement aggregate
    // cap (95,000) does not bind (90,000 <= 95,000).
    evaluate truth(discounted_unpaid_losses_846_per_accident_year(entity_ref("urn:test:s846:t1#c"), entity_ref("urn:test:s846:t1#y"), "auto_liability", entity_ref("urn:test:s846:t1#ay2022"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S846-02-ANNUAL-STATEMENT-AGGREGATE-CAP-BINDS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": undiscounted_unpaid_losses_846(entity_ref("urn:test:s846:t2#c"), entity_ref("urn:test:s846:t2#y"), "workers_comp", entity_ref("urn:test:s846:t2#ay2022"), 100000.00 USD) { origin case_input; }
        assert "f1": discount_factor_846(entity_ref("urn:test:s846:t2#c"), entity_ref("urn:test:s846:t2#y"), "workers_comp", entity_ref("urn:test:s846:t2#ay2022"), 0.98) { origin case_input; }
        assert "f2": annual_statement_aggregate_unpaid_losses_846a3(entity_ref("urn:test:s846:t2#c"), entity_ref("urn:test:s846:t2#y"), "workers_comp", entity_ref("urn:test:s846:t2#ay2022"), 90000.00 USD) { origin case_input; }
    }
    // present value = 100,000 * 0.98 = 98,000.00 > cap (90,000): the section
    // 846(a)(3) limitation binds at 90,000.
    evaluate truth(discounted_unpaid_losses_846_per_accident_year(entity_ref("urn:test:s846:t2#c"), entity_ref("urn:test:s846:t2#y"), "workers_comp", entity_ref("urn:test:s846:t2#ay2022"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
