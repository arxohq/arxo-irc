// Section 848(a)-(c) scenarios (section 846 scenarios live in
// tests/s831-s832-other-insurance.lawtest, next to the other-insurance
// module they belong with). NOT EXECUTED (implemented_unverified per
// AGENT-BRIEF NO-HEAVY-CHECKS restriction). STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S848-01-EXPENSE-CEILING-BELOW-GENERAL-DEDUCTIONS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_premiums_annuity_848c1A(entity_ref("urn:test:s848:t1#c"), entity_ref("urn:test:s848:t1#y"), 1000000.00 USD) { origin case_input; }
        assert "f1": net_premiums_group_life_848c1B(entity_ref("urn:test:s848:t1#c"), entity_ref("urn:test:s848:t1#y"), 500000.00 USD) { origin case_input; }
        assert "f2": net_premiums_other_848c1C(entity_ref("urn:test:s848:t1#c"), entity_ref("urn:test:s848:t1#y"), 2000000.00 USD) { origin case_input; }
        assert "f3": general_deductions_848c2(entity_ref("urn:test:s848:t1#c"), entity_ref("urn:test:s848:t1#y"), 300000.00 USD) { origin case_input; }
    }
    // ceiling = 1,000,000*0.0209 + 500,000*0.0245 + 2,000,000*0.092 =
    // 20,900 + 12,250 + 184,000 = 217,150.00. General deductions (300,000)
    // exceed the ceiling: specified expenses = min(300,000, 217,150) =
    // 217,150.00.
    evaluate truth(specified_policy_acquisition_expenses(entity_ref("urn:test:s848:t1#c"), entity_ref("urn:test:s848:t1#y"), 217150.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S848-02-NO-PHASEOUT-BELOW-10-MILLION-FULL-5-MILLION-AT-60-MONTHS" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_premiums_annuity_848c1A(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 0.00 USD) { origin case_input; }
        assert "f1": net_premiums_group_life_848c1B(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 0.00 USD) { origin case_input; }
        assert "f2": net_premiums_other_848c1C(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 100000000.00 USD) { origin case_input; }
        assert "f3": general_deductions_848c2(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 8000000.00 USD) { origin case_input; }
    }
    // ceiling = 100,000,000 * 0.092 = 9,200,000; general deductions
    // (8,000,000) are lower: specified expenses = 8,000,000.00 (below the
    // $10,000,000 phase-out trigger, so no reduction; the full $5,000,000
    // threshold applies to the 60-month amortization, the remaining
    // 3,000,000 to the 180-month amortization).
    evaluate truth(specified_policy_acquisition_expenses(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 8000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(amount_amortized_over_60_months_848b(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 5000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(amount_amortized_over_180_months_848a(entity_ref("urn:test:s848:t2#c"), entity_ref("urn:test:s848:t2#y"), 3000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S848-03-PHASEOUT-PARTIALLY-ERODES-5-MILLION-THRESHOLD" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_premiums_annuity_848c1A(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 0.00 USD) { origin case_input; }
        assert "f1": net_premiums_group_life_848c1B(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 0.00 USD) { origin case_input; }
        assert "f2": net_premiums_other_848c1C(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 200000000.00 USD) { origin case_input; }
        assert "f3": general_deductions_848c2(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 12000000.00 USD) { origin case_input; }
    }
    // ceiling = 200,000,000 * 0.092 = 18,400,000; general deductions
    // (12,000,000) are lower: specified expenses = 12,000,000.00. Exceeds
    // $10,000,000 by 2,000,000: the $5,000,000 threshold is reduced to
    // 3,000,000. 60-month amount = min(12,000,000, 3,000,000) = 3,000,000;
    // 180-month amount = 12,000,000 - 3,000,000 = 9,000,000.
    evaluate truth(amount_amortized_over_60_months_848b(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 3000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(amount_amortized_over_180_months_848a(entity_ref("urn:test:s848:t3#c"), entity_ref("urn:test:s848:t3#y"), 9000000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S848-04-YEAR-1-RATABLE-DEDUCTION-SIX-MONTHS-OF-EACH-PORTION" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": net_premiums_annuity_848c1A(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 0.00 USD) { origin case_input; }
        assert "f1": net_premiums_group_life_848c1B(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 0.00 USD) { origin case_input; }
        assert "f2": net_premiums_other_848c1C(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 100000000.00 USD) { origin case_input; }
        assert "f3": general_deductions_848c2(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 8000000.00 USD) { origin case_input; }
        assert "f4": months_of_period_in_capitalization_year(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 6) { origin case_input; }
    }
    // as in S848-02: 60-month portion = 5,000,000.00, 180-month portion =
    // 3,000,000.00 (specified expenses = 8,000,000, below the $10,000,000
    // phase-out trigger). Year-1 deduction, 6 months of each period falling
    // in the calendar taxable year (July-December):
    // 180-month: 3,000,000 / 180 = 16,666.666667/month; * 6 = 100,000.00
    // (exact: 3,000,000 * 6 / 180 = 100,000).
    // 60-month: 5,000,000 / 60 = 83,333.333333/month; * 6 = 500,000.00
    // (exact: 5,000,000 * 6 / 60 = 500,000).
    // total = 600,000.00.
    evaluate truth(section_848a2_year1_deduction_180_month_portion(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_848a2_year1_deduction_60_month_portion(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(section_848a2_year1_deduction(entity_ref("urn:test:s848:t4#c"), entity_ref("urn:test:s848:t4#y"), 600000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
