test "S593b2Div-01-DIVIDEND-EXCLUSION-IS-DIVIDENDS-LESS-8-PERCENT-OF-THE-DRD" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": part_viii_dividends_593b2Div(entity_ref("urn:test:s593b2div-01-dividend-exclusion-is-divid#i"), entity_ref("urn:test:s593b2div-01-dividend-exclusion-is-divid#y"), 100000.00 USD, 50000.00 USD) { origin case_input; }
    }
    // 100,000 dividends less 8 percent of 50,000 = 96,000.00.
    evaluate truth(dividend_exclusion_593b2Div(entity_ref("urn:test:s593b2div-01-dividend-exclusion-is-divid#i"), entity_ref("urn:test:s593b2div-01-dividend-exclusion-is-divid#y"), 96000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

