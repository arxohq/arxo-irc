        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": substituted_basis_property_acquired_after_1958_818c2(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p")) { origin case_input; }
        assert "f1": predecessor_property_holding_period_includes_1958_818c2B(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p"), entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#pr")) { origin case_input; }
        assert "f2": fair_market_value_on_1958_12_31_818c1(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#pr"), 500000.00 USD) { origin case_input; }
        assert "f3": adjusted_basis_on_1958_12_31_818c1(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#pr"), 200000.00 USD) { origin case_input; }
        assert "f4": prior_gain_without_818c_on_related_properties_818c2Di(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p"), 100000.00 USD) { origin case_input; }
        assert "f5": prior_gain_recognized_on_related_properties_818c2Dii(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p"), 20000.00 USD) { origin case_input; }
        assert "f6": life_insurer_at_all_times_after_1958_12_31_818c1B(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p")) { origin case_input; }
        assert "f7": gain_without_regard_to_818c_1958_property(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p"), 400000.00 USD) { origin case_input; }
    }
    // Not held only by life insurance companies.
    evaluate truth(gain_on_substituted_basis_property_818c2(entity_ref("urn:test:s818c2c-02-held-by-a-non-life-company-de#p"), 180000.00 USD));
    expect truth_status == NEITHER;
}

test "S818c2E-01-EXEMPTED-GAIN-IS-ADDED-TO-THE-BASIS" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": substituted_basis_property_acquired_after_1958_818c2(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p")) { origin case_input; }
        assert "f1": predecessor_property_holding_period_includes_1958_818c2B(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p"), entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#pr")) { origin case_input; }
        assert "f2": fair_market_value_on_1958_12_31_818c1(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#pr"), 500000.00 USD) { origin case_input; }
        assert "f3": adjusted_basis_on_1958_12_31_818c1(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#pr"), 200000.00 USD) { origin case_input; }
        assert "f4": prior_gain_without_818c_on_related_properties_818c2Di(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p"), 100000.00 USD) { origin case_input; }
        assert "f5": prior_gain_recognized_on_related_properties_818c2Dii(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p"), 20000.00 USD) { origin case_input; }
        assert "f6": held_only_by_life_insurance_companies_after_1958_818c2C(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p")) { origin case_input; }
        assert "f7": life_insurer_at_all_times_after_1958_12_31_818c1B(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p")) { origin case_input; }
        assert "f8": gain_without_regard_to_818c_1958_property(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p"), 400000.00 USD) { origin case_input; }
    }
    // 400,000 - 180,000 = 220,000.00.
    evaluate truth(gain_exempted_added_to_basis_818c2E(entity_ref("urn:test:s818c2e-01-exempted-gain-is-added-to-the#p"), 220000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

