// Sections 814, 817, 817A, 818 scenarios, stage 3b (branch deemed sale and dealings, variable contract adjustments, modified guaranteed contracts, 1958 property). NOT EXECUTED (implemented_unverified). STAGE 3b (26.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S814d-01-BRANCH-ASSETS-ARE-DEEMED-SOLD-ON-THE-FIRST-DAY" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": first_electing_year_814d(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#c"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#br"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#y")) { origin case_input; }
        assert "f1": branch_election_in_effect_814g(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#c"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#br"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#y")) { origin case_input; }
        assert "f2": branch_assets_fair_market_value_on_first_day_814d(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#c"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#br"), 900000.00 USD) { origin case_input; }
        assert "f3": branch_assets_adjusted_basis_814d(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#c"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#br"), 700000.00 USD) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#y"), @2026-01-01) { origin case_input; }
    }
    // 900,000 - 700,000 = 200,000.00 on 2026-01-01.
    evaluate truth(deemed_sale_of_branch_assets_814d(entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#c"), entity_ref("urn:test:s814d-01-branch-assets-are-deemed-sold-o#br"), @2026-01-01, 200000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

