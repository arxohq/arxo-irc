test "S856d9D-01-HOTEL-IS-QUALIFIED-LODGING-FACILITY" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; }
        assert "f0": hotel_856d9Dii(entity_ref("urn:test:s856d9d-01-hotel-is-qualified-lodging-fa#p")) { origin case_input; }
    }
    // A hotel is a lodging facility; without wagering it is a qualified lodging facility (section 856(d)(9)(D)).
    evaluate truth(qualified_lodging_facility_856d9D(entity_ref("urn:test:s856d9d-01-hotel-is-qualified-lodging-fa#p")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

