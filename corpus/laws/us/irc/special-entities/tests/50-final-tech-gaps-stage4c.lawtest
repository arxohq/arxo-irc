    expect truth_status == TRUE_ONLY;
}

test "S593D1BIII-01-CHAIN-OF-THREE-LEVELS" {
    // A owns 60 percent of B and of X; B owns 60 percent of C; C owns 60 percent of D: X (level 1) and D (level 3) are in the group of A.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.core::ownership_interest(entity_ref("urn:test:se50:5#o1"), entity_ref("urn:test:se50:5#a"), entity_ref("urn:test:se50:5#b"), 0.6) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:se50:5#o2"), entity_ref("urn:test:se50:5#a"), entity_ref("urn:test:se50:5#x"), 0.6) { origin case_input; }
        assert "f2": us.irc.core::ownership_interest(entity_ref("urn:test:se50:5#o3"), entity_ref("urn:test:se50:5#b"), entity_ref("urn:test:se50:5#c"), 0.6) { origin case_input; }
        assert "f3": us.irc.core::ownership_interest(entity_ref("urn:test:se50:5#o4"), entity_ref("urn:test:se50:5#c"), entity_ref("urn:test:se50:5#d"), 0.6) { origin case_input; }
    }
    evaluate truth(same_affiliated_group_593d1Biii(entity_ref("urn:test:se50:5#x"), entity_ref("urn:test:se50:5#d")));
    expect truth_status == TRUE_ONLY;
}

test "S856D5-01-SECOND-HOP-SPOUSE-OF-A-PARTNER" {
    // A is a 50 percent partner of P; P owns 60 percent of T: A owns 30 percent (FromEntity); A's spouse S owns it by re-application (FromEntity, Family).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.corporations::partner_of(entity_ref("urn:test:se50:6#a"), entity_ref("urn:test:se50:6#p"), 0.5) { origin case_input; }
        assert "f1": us.irc.core::ownership_interest(entity_ref("urn:test:se50:6#oi"), entity_ref("urn:test:se50:6#p"), entity_ref("urn:test:se50:6#t"), 0.6) { origin case_input; }
        assert "f2": us.irc.corporations::spouse_of(entity_ref("urn:test:se50:6#a"), entity_ref("urn:test:se50:6#s")) { origin case_input; }
    }
    evaluate truth(reit_constructive_ownership_second_hop_856d5(entity_ref("urn:test:se50:6#s"), entity_ref("urn:test:se50:6#t"), 0.30, FromEntity, Family));
    expect truth_status == TRUE_ONLY;
}

