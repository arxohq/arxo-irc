        assert "f1": us.irc.corporations::partner_of(entity_ref("urn:test:se50:7#a"), entity_ref("urn:test:se50:7#p"), 0.5) { origin case_input; }
        assert "f2": us.irc.core::ownership_interest(entity_ref("urn:test:se50:7#o2"), entity_ref("urn:test:se50:7#p"), entity_ref("urn:test:se50:7#t"), 0.12) { origin case_input; }
    }
    evaluate truth(reit_constructive_ownership_total_856d5(entity_ref("urn:test:se50:7#a"), entity_ref("urn:test:se50:7#t"), 0.12));
    expect truth_status == TRUE_ONLY;
}

