test "S805A4DV-01-NON-LIFE-PAYER-REDUCTION" {
    // non-life paying share 80 percent, receiving share 70 percent (section 812(a)), prorated portion 1000: reduction 1000 x 0.10 = 100.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": paying_company_share_non_life_805a4Dv(entity_ref("urn:test:se50:1#pay"), entity_ref("urn:test:se50:1#yp"), 0.80) { origin case_input; }
        assert "f1": life_insurance_company(entity_ref("urn:test:se50:1#rec"), entity_ref("urn:test:se50:1#yr")) { origin case_input; }
        assert "f2": portion_of_dividend_attributable_to_prorated_amounts(entity_ref("urn:test:se50:1#rec"), entity_ref("urn:test:se50:1#yr"), 1000 USD) { origin case_input; }
    }
    evaluate truth(dividends_received_805a4_proration_reduction(entity_ref("urn:test:se50:1#rec"), entity_ref("urn:test:se50:1#yr"), 100.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S848B3-01-INSURER-IN-THE-GROUP-WITHOUT-THE-A4-SEPARATION" {
    // a member insurer of the (a)(1)-(3) group is in the group of 848(b)(3); the (a)(4) separation is not applied.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.corporations::member_of_controlled_group_1563(entity_ref("urn:test:se50:2#g"), entity_ref("urn:test:se50:2#m")) { origin case_input; }
        assert "f1": us.irc.corporations::insurance_company_801_1563a4(entity_ref("urn:test:se50:2#m")) { origin case_input; }
        assert "f2": us.irc.core::ends(entity_ref("urn:test:se50:2#y"), @2024-12-31) { origin case_input; }
    }
    evaluate truth(insurance_company_in_group_for_848b3(entity_ref("urn:test:se50:2#g"), entity_ref("urn:test:se50:2#m"), entity_ref("urn:test:se50:2#y")));
    expect truth_status == TRUE_ONLY;
}

test "S848B3-02-FOREIGN-CORPORATION-EXCLUDED-BY-1563B2C" {
