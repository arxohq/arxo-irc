test "S860Fa4B-01-LIQUIDATION-PERIOD-ENDS-ON-THE-90TH-DAY" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": remic_adopts_plan_of_complete_liquidation_860Fa4Ai(entity_ref("urn:test:s860fa4b-01-liquidation-period-ends-on-t#r"), @2026-03-01) { origin case_input; }
    }
    // Plan adopted 2026-03-01: the 90th day after it is 2026-05-30.
    evaluate truth(liquidation_period_end_860Fa4Bii(entity_ref("urn:test:s860fa4b-01-liquidation-period-ends-on-t#r"), @2026-03-01, @2026-05-30));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

