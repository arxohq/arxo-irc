        assert "f2": holder_weighted_days_in_quarter_860C(entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#h"), entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#r"), entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#q"), 91.0) { origin case_input; }
    }
    // The holder's daily portion is taken into account (860C(a)); the income is taxable to the holder.
    evaluate truth(remic_income_taxable_to_holder_860Ab(entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#h"), entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#r"), entity_ref("urn:test:s860ab-01-income-taxable-to-the-residual#q")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
