// Sections 860A, 860D, 860E(c), 860F(a) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF NO-HEAVY-CHECKS restriction).
// STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S860D-01-VALID-ELECTION-AND-ALL-CONDITIONS-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elects_remic_860d(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f1": all_interests_regular_or_residual_860d1a2(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f2": one_class_of_residual_interests_pro_rata_860d1a3(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f3": substantially_all_qualified_mortgages_860d1a4(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f4": taxable_year_is_calendar_year_860d1a5(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f5": residual_interests_not_held_by_disqualified_organizations_860d1a6A(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
        assert "f6": information_for_860e_available_860d1a6B(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")) { origin case_input; }
    }
    evaluate truth(remic_qualified(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(remic_not_taxed_as_entity_860a(entity_ref("urn:test:s860d:t1#c"), entity_ref("urn:test:s860d:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S860D-02-NO-ELECTION-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f1": all_interests_regular_or_residual_860d1a2(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
        assert "f2": one_class_of_residual_interests_pro_rata_860d1a3(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
        assert "f3": substantially_all_qualified_mortgages_860d1a4(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
        assert "f4": taxable_year_is_calendar_year_860d1a5(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
        assert "f5": residual_interests_not_held_by_disqualified_organizations_860d1a6A(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
        assert "f6": information_for_860e_available_860d1a6B(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")) { origin case_input; }
    }
    // no election asserted: POWER not exercised, treated_as_remic_860d is
    // not derived, so remic_qualified does not fire.
    evaluate truth(remic_qualified(entity_ref("urn:test:s860d:t2#c"), entity_ref("urn:test:s860d:t2#y")));
    expect truth_status == NEITHER;
}

test "S860E-01-EXCESS-INCLUSION-POSITIVE" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adjusted_issue_price_beginning_of_quarter_860e2B(entity_ref("urn:test:s860e:t1#holder"), entity_ref("urn:test:s860e:t1#remic"), entity_ref("urn:test:s860e:t1#q1"), 1000000.00 USD) { origin case_input; }
        assert "f1": federal_long_term_rate_860e2C(entity_ref("urn:test:s860e:t1#remic"), entity_ref("urn:test:s860e:t1#q1"), 0.04) { origin case_input; }
        assert "f2": amount_taken_into_account_860c_a(entity_ref("urn:test:s860e:t1#holder"), entity_ref("urn:test:s860e:t1#remic"), entity_ref("urn:test:s860e:t1#q1"), 60000.00 USD) { origin case_input; }
    }
    // daily accruals sum = 1,000,000 * (0.04 * 1.20) = 1,000,000 * 0.048 =
    // 48,000.00. excess inclusion = 60,000 - 48,000 = 12,000.00.
    evaluate truth(excess_inclusion(entity_ref("urn:test:s860e:t1#holder"), entity_ref("urn:test:s860e:t1#remic"), entity_ref("urn:test:s860e:t1#q1"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S860F-01-PROHIBITED-TRANSACTION-TAX-100-PERCENT" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gross_income_from_prohibited_transactions_860f(entity_ref("urn:test:s860f:t1#c"), entity_ref("urn:test:s860f:t1#y"), 50000.00 USD) { origin case_input; }
        assert "f1": deductions_connected_with_prohibited_transactions_860f(entity_ref("urn:test:s860f:t1#c"), entity_ref("urn:test:s860f:t1#y"), 10000.00 USD) { origin case_input; }
    }
    // net income = 40,000; tax = 100% * 40,000 = 40,000.00.
    evaluate truth(remic_prohibited_transaction_tax_860f(entity_ref("urn:test:s860f:t1#c"), entity_ref("urn:test:s860f:t1#y"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
