// Section 852(b)(5), (g) scenarios. NOT EXECUTED (implemented_unverified
// per AGENT-BRIEF NO-HEAVY-CHECKS restriction). STAGE 2b (25.09.2026).

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

test "S852B5-01-FIFTY-PERCENT-TEST-QUALIFIES" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": value_of_section_103a_obligations(entity_ref("urn:test:s852b5:t1#c"), entity_ref("urn:test:s852b5:t1#y"), 510000.00 USD) { origin case_input; }
        assert "f1": total_assets_value_852b5(entity_ref("urn:test:s852b5:t1#c"), entity_ref("urn:test:s852b5:t1#y"), 1000000.00 USD) { origin case_input; }
    }
    evaluate truth(qualified_to_pay_exempt_interest_dividends(entity_ref("urn:test:s852b5:t1#c"), entity_ref("urn:test:s852b5:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S852B5-02-NO-EXCESS-REPORTED-AMOUNT-FULL-DIVIDEND" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": value_of_section_103a_obligations(entity_ref("urn:test:s852b5:t2#c"), entity_ref("urn:test:s852b5:t2#y"), 510000.00 USD) { origin case_input; }
        assert "f1": total_assets_value_852b5(entity_ref("urn:test:s852b5:t2#c"), entity_ref("urn:test:s852b5:t2#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": reported_exempt_interest_dividend_amount(entity_ref("urn:test:s852b5:t2#c"), entity_ref("urn:test:s852b5:t2#y"), entity_ref("urn:test:s852b5:t2#div1"), 40000.00 USD) { origin case_input; }
    }
    // qualified (as in S852B5-01); no aggregate/exempt-interest facts
    // asserted, so no excess reported amount is derivable: the dividend
    // stands at the full reported amount.
    evaluate truth(exempt_interest_dividend(entity_ref("urn:test:s852b5:t2#c"), entity_ref("urn:test:s852b5:t2#y"), entity_ref("urn:test:s852b5:t2#div1"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S852B5-03-EXCESS-REPORTED-AMOUNT-REDUCES-DIVIDEND" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": value_of_section_103a_obligations(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), 510000.00 USD) { origin case_input; }
        assert "f1": total_assets_value_852b5(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), 1000000.00 USD) { origin case_input; }
        assert "f2": reported_exempt_interest_dividend_amount(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), entity_ref("urn:test:s852b5:t3#div1"), 40000.00 USD) { origin case_input; }
        assert "f3": aggregate_reported_amount_852b5(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), 100000.00 USD) { origin case_input; }
        assert "f4": exempt_interest_852b5(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), 80000.00 USD) { origin case_input; }
    }
    // excess reported amount = 100,000 - 80,000 = 20,000. allocable to div1
    // = 20,000 * (40,000/100,000) = 8,000.00. exempt-interest dividend =
    // 40,000 - 8,000 = 32,000.00.
    evaluate truth(exempt_interest_dividend(entity_ref("urn:test:s852b5:t3#c"), entity_ref("urn:test:s852b5:t3#y"), entity_ref("urn:test:s852b5:t3#div1"), 32000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S852G-01-QUALIFIED-FUND-OF-FUNDS-BYPASSES-FIFTY-PERCENT-TEST" {
    given {
        context {
            legal_time @2024-04-15;
            decision_time @2024-04-15T09:00:00-05:00;
            knowledge_time @2024-04-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": value_of_interests_in_other_rics(entity_ref("urn:test:s852g:t1#c"), entity_ref("urn:test:s852g:t1#y"), 600000.00 USD) { origin case_input; }
        assert "f1": total_assets_value_852b5(entity_ref("urn:test:s852g:t1#c"), entity_ref("urn:test:s852g:t1#y"), 1000000.00 USD) { origin case_input; }
    }
    // 60% in other RIC interests qualifies as a fund of funds; no section
    // 103(a) obligations facts asserted at all (the (b)(5) test is bypassed
    // per section 852(g)(1)(A)).
    evaluate truth(qualified_fund_of_funds_852g2(entity_ref("urn:test:s852g:t1#c"), entity_ref("urn:test:s852g:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    evaluate truth(qualified_to_pay_exempt_interest_dividends(entity_ref("urn:test:s852g:t1#c"), entity_ref("urn:test:s852g:t1#y")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
