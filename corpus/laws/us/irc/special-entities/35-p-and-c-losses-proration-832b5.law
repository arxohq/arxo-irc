// Section 832(b)(5)(B)-(E) (insurance companies other than life: the
// reduction of the losses-incurred deduction for tax-exempt interest and
// the dividends-received deductions, the exception for investments made
// before August 8, 1986, the definitions of prorated amounts and 100 percent
// dividends, and the special rules for dividends subject to proration at
// the subsidiary level). Stage 3 (IRC-09 stage 3, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. Each source of the reduction is an item: tax-exempt interest, a
// dividend (its section 243/245 deduction percentage is an asserted input,
// as in module 30), the increase in policy cash values of module 30
// (section 805(a)(4)(F)) and a 100 percent dividend's portion attributable
// to prorated amounts (module 30's earnings-based rule). The applicable
// percentage is 5.25 percent divided by the highest section 11(b) rate
// (derived from us.irc.corporations); the reduction is that percentage of
// the sum, with one rounding (cents HALF_UP is a JUDGMENT CALL). Module 03's
// `losses_incurred` is now the (A) amount less this reduction. Sums over
// derived items are the section 111 runtime subset (TECH-GAPS G4903).

use self::{
    Contract,
    IRC_S832_B,
    Person,
    TaxableYear,
    deduction_percentage_used_243_245_805a4C,
    increase_in_policy_cash_value_805a4F,
    losses_incurred,
    losses_incurred_before_reduction_832b5A,
};

pub relation tax_exempt_interest_item_832b5Bi(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, acquired_on: Date) kind empirical {
    label en unofficial "tax-exempt interest received or accrued during the taxable year, on an obligation acquired on this date";
}
pub relation dividend_item_832b5Bii(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, acquired_on: Date) kind empirical {
    label en unofficial "a dividend received during the taxable year on stock acquired on this date (the deduction percentage of sections 243 and 245 is asserted through deduction_percentage_used_243_245_805a4C)";
}
pub relation foreign_receiver_domestic_dividend_832b5Dii(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is received by a foreign corporation from a domestic corporation and would be a 100 percent dividend if section 1504(b)(3) did not apply for purposes of applying section 243(b)(2)";
}
pub relation dividend_is_100_percent_832b5D(item: us.irc.core::Payment) kind institutional {
    label en official "the dividend is a 100 percent dividend: the percentage used for the section 243 or 245(b) deduction is 100 percent, or the foreign-corporation rule of (D)(ii)(II) applies";
}
@source(IRC_S832_B, quote = "The term \"100 percent dividend\" means any dividend if the percentage used for purposes of determining the deduction allowable under section 243 or 245(b) is 100 percent.")
rule Section832b5DiiIPercentageIs100(item: us.irc.core::Payment, pct: Decimal) strict {
    label en official "section 832(b)(5)(D)(ii)(I): the percentage used is 100 percent";
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct >= 1.00;
    then dividend_is_100_percent_832b5D(item);
}
@source(IRC_S832_B, quote = "A dividend received by a foreign corporation from a domestic corporation which would be a 100 percent dividend if section 1504(b)(3) did not apply for purposes of applying section 243(b)(2) shall be treated as a 100 percent dividend.")
rule Section832b5DiiIIForeignReceiver(item: us.irc.core::Payment) strict {
    label en official "section 832(b)(5)(D)(ii)(II): a dividend of that kind received by a foreign corporation is a 100 percent dividend";
    when foreign_receiver_domestic_dividend_832b5Dii(item);
    then dividend_is_100_percent_832b5D(item);
}
pub relation prorated_dividend_832b5Di(item: us.irc.core::Payment) kind institutional {
    label en official "a dividend with respect to which a deduction is allowable under section 243 or 245 and which is not a 100 percent dividend (a prorated amount)";
}
@source(IRC_S832_B, quote = "The term \"prorated amounts\" means tax-exempt interest and dividends with respect to which a deduction is allowable under section 243 or 245 (other than 100 percent dividends).")
rule Section832b5DiProratedDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, acquired: Date, pct: Decimal) defeasible {
    label en official "section 832(b)(5)(D)(i): a dividend with a section 243/245 deduction that is not a 100 percent dividend";
    when dividend_item_832b5Bii(c, y, item, payer, amount, acquired);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct > 0.00;
    when not_known(dividend_is_100_percent_832b5D(item));
    then prorated_dividend_832b5Di(item);
}
pub relation counted_proration_item_832b5(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an amount that enters the section 832(b)(5)(B) sum: tax-exempt interest, the section 243/245 deduction for a dividend other than a 100 percent dividend, a 100 percent dividend's deduction to the extent attributable to prorated amounts, or the increase in policy cash values; investments made before August 8, 1986 are excepted";
}
@source(IRC_S832_B, quote = "(i) tax-exempt interest received or accrued during such taxable year,")
rule Section832b5BiTaxExemptInterest(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money, acquired: Date) strict {
    label en official "section 832(b)(5)(B)(i), (C)(i): tax-exempt interest on an obligation not acquired before August 8, 1986";
    when tax_exempt_interest_item_832b5Bi(c, y, item, amount, acquired);
    when acquired >= @1986-08-08;
    then counted_proration_item_832b5(c, y, item, amount);
}
@source(IRC_S832_B, quote = "(I) dividends (other than 100 percent dividends) received during the taxable year, and")
rule Section832b5BiiIOtherDividendDeduction(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, acquired: Date, pct: Decimal) defeasible {
    label en official "section 832(b)(5)(B)(ii)(I), (C)(i): the section 243/245 deduction for a dividend other than a 100 percent dividend on stock not acquired before August 8, 1986";
    when dividend_item_832b5Bii(c, y, item, payer, amount, acquired);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when prorated_dividend_832b5Di(item);
    when acquired >= @1986-08-08;
    then counted_proration_item_832b5(c, y, item, round(amount * pct, 2, "HALF_UP"));
}
pub relation payor_acquired_stock_on_832b5Cii(item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the payor acquired the stock or obligation to which the prorated amounts are attributable on this date";
}
pub relation payor_and_payee_affiliated_since_832b5Cii(item: us.irc.core::Payment, on: Date) kind empirical {
    label en unofficial "the 1st day on which the payor and payee were members of the same affiliated group (section 243(b)(2))";
}
pub relation deemed_acquisition_date_832b5Cii(item: us.irc.core::Payment, on: Date) kind institutional {
    label en official "the date on which the prorated portion of a 100 percent dividend is treated as received with respect to stock acquired: the later of the payor's acquisition and the first day of common membership";
}
@source(IRC_S832_B, quote = "For purposes of clause (i), the portion of any 100 percent dividend which is attributable to prorated amounts shall be treated as received with respect to stock acquired on the later of")
rule Section832b5CiiLaterIsPayorAcquisition(item: us.irc.core::Payment, payor_on: Date, affiliated_on: Date) strict {
    label en official "section 832(b)(5)(C)(ii): the payor's acquisition date when it is not earlier than the first day of common membership";
    when payor_acquired_stock_on_832b5Cii(item, payor_on);
    when payor_and_payee_affiliated_since_832b5Cii(item, affiliated_on);
    when payor_on >= affiliated_on;
    then deemed_acquisition_date_832b5Cii(item, payor_on);
}
rule Section832b5CiiLaterIsAffiliation(item: us.irc.core::Payment, payor_on: Date, affiliated_on: Date) strict {
    label en official "section 832(b)(5)(C)(ii): the first day of common membership when it is later than the payor's acquisition";
    when payor_acquired_stock_on_832b5Cii(item, payor_on);
    when payor_and_payee_affiliated_since_832b5Cii(item, affiliated_on);
    when payor_on < affiliated_on;
    then deemed_acquisition_date_832b5Cii(item, affiliated_on);
}
pub relation payor_is_insurance_company_832b5Ei(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the 100 percent dividend is paid to an insurance company to which this part applies by an insurance company";
}
pub relation payor_decrease_in_deductions_832b5Ei(item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the decrease in the deductions (or increase in income) of the payor company attributable to the application of this section or section 805(a)(4)(A) to the prorated amounts";
}
pub relation hundred_percent_dividend_prorated_portion_832b5(c: Person, y: TaxableYear, item: us.irc.core::Payment, portion: Money) kind institutional {
    label en official "the portion of the 100 percent dividend attributable to prorated amounts: paid first out of the payor's earnings attributable to prorated amounts, to the extent thereof, without reduction for tax";
}
@source(IRC_S832_B, quote = "(I) any dividend by the paying corporation shall be treated as paid first out of earnings and profits attributable to prorated amounts (to the extent thereof), and")
rule Section832b5EiiPortion(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, acquired: Date, prorated_earnings: Money) strict {
    label en official "section 832(b)(5)(E)(ii): the portion is the lesser of the dividend and the payor's earnings attributable to prorated amounts (before tax)";
    when dividend_item_832b5Bii(c, y, item, payer, amount, acquired);
    when dividend_is_100_percent_832b5D(item);
    when earnings_attributable_to_prorated_amounts_832b5(payer, prorated_earnings);
    then hundred_percent_dividend_prorated_portion_832b5(c, y, item, min(amount, prorated_earnings));
}
pub relation earnings_attributable_to_prorated_amounts_832b5(payer: Person, amount: Money) kind empirical {
    label en unofficial "the payor's earnings and profits attributable to prorated amounts, without any reduction for the tax imposed by this chapter";
}
@source(IRC_S832_B, quote = "(II) 100 percent dividends received during the taxable year to the extent attributable (directly or indirectly) to prorated amounts")
rule Section832b5BiiIIHundredPercentPortionNotAcquiredBefore1986(c: Person, y: TaxableYear, item: us.irc.core::Payment, portion: Money, on: Date) defeasible {
    label en official "section 832(b)(5)(B)(ii)(II), (C)(ii), (E)(i): the prorated portion of a 100 percent dividend, counted when treated as received with respect to stock acquired on or after August 8, 1986; a decrease of the payor's deductions reduces it (not below zero) when the payor is an insurance company";
    when hundred_percent_dividend_prorated_portion_832b5(c, y, item, portion);
    when deemed_acquisition_date_832b5Cii(item, on);
    when on >= @1986-08-08;
    when not_known(payor_is_insurance_company_832b5Ei(item));
    then counted_proration_item_832b5(c, y, item, portion);
}
@source(IRC_S832_B, quote = "the amount of the decrease in the deductions of the payee company by reason of the portion of such dividend attributable to prorated amounts shall be reduced (but not below zero) by the amount of the decrease in the deductions (or increase in income) of the payor company")
rule Section832b5EiPayorDecreaseReduces(c: Person, y: TaxableYear, item: us.irc.core::Payment, portion: Money, on: Date, payor_decrease: Money) defeasible {
    label en official "section 832(b)(5)(E)(i): the payee's decrease is reduced, not below zero, by the payor's decrease";
    when hundred_percent_dividend_prorated_portion_832b5(c, y, item, portion);
    when deemed_acquisition_date_832b5Cii(item, on);
    when on >= @1986-08-08;
    when payor_is_insurance_company_832b5Ei(item);
    when payor_decrease_in_deductions_832b5Ei(item, payor_decrease);
    then counted_proration_item_832b5(c, y, item, max(0.00 USD, portion - payor_decrease));
}
pub relation policy_cash_value_item_832b5Biii(c: Person, y: TaxableYear, policy: Contract, item: us.irc.core::Payment) kind empirical {
    label en unofficial "the life insurance policy or annuity or endowment contract of the company, to which section 264(f) applies, with the item id under which its increase is counted";
}
@source(IRC_S832_B, quote = "(iii) the increase for the taxable year in policy cash values (within the meaning of section 805(a)(4)(F)) of life insurance policies and annuity and endowment contracts to which section 264(f) applies.")
rule Section832b5BiiiPolicyCashValueIncrease(c: Person, y: TaxableYear, policy: Contract, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 832(b)(5)(B)(iii): the increase in policy cash values (section 805(a)(4)(F), module 30)";
    when policy_cash_value_item_832b5Biii(c, y, policy, item);
    when increase_in_policy_cash_value_805a4F(policy, y, amount);
    then counted_proration_item_832b5(c, y, item, amount);
}
pub relation proration_base_832b5B(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of the counted items (a sum over derived items, TECH-GAPS G4903)";
}
rule Section832b5BSum(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 832(b)(5)(B): the sum of the tax-exempt interest, the dividends-received deductions and the policy cash value increase";
    when counted_proration_item_832b5(c, y, anchor, anchor_amount);
    then proration_base_832b5B(c, y, sum all amount: Money for item: us.irc.core::Payment where counted_proration_item_832b5(c, y, item, amount));
}
pub relation loss_reduction_832b5B(c: Person, y: TaxableYear, reduction: Money) kind institutional {
    label en official "the reduction of the amount taken into account under subparagraph (A): the applicable percentage (5.25 percent divided by the highest section 11(b) rate) of the sum";
}
@source(IRC_S832_B, quote = "For purposes of this subparagraph, the applicable percentage is 5.25 percent divided by the highest rate in effect under section 11(b).")
rule Section832b5BReduction(c: Person, y: TaxableYear, base: Money, rate: Decimal) defeasible {
    label en official "section 832(b)(5)(B): the reduction (one division, one rounding, cents HALF_UP: a JUDGMENT CALL)";
    when proration_base_832b5B(c, y, base);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then loss_reduction_832b5B(c, y, div_round(base * 0.0525, rate, 2, "HALF_UP"));
}
pub relation has_loss_reduction_832b5B(c: Person, y: TaxableYear) kind institutional {
    label en official "a subparagraph (B) reduction is derived for the company and year (helper)";
}
rule Section832b5BHasReduction(c: Person, y: TaxableYear, reduction: Money) defeasible {
    label en official "helper";
    when loss_reduction_832b5B(c, y, reduction);
    then has_loss_reduction_832b5B(c, y);
}
@source(IRC_S832_B, quote = "The amount which would (but for this subparagraph) be taken into account under subparagraph (A) shall be reduced by an amount equal to the applicable percentage of the sum of")
rule Section832b5BLossesReduced(c: Person, y: TaxableYear, before: Money, reduction: Money) defeasible {
    label en official "section 832(b)(5)(B): losses incurred are the (A) amount less the reduction";
    when losses_incurred_before_reduction_832b5A(c, y, before);
    when loss_reduction_832b5B(c, y, reduction);
    then losses_incurred(c, y, before - reduction);
}
rule Section832b5ANoReduction(c: Person, y: TaxableYear, before: Money) defeasible {
    label en official "section 832(b)(5)(A): with no subparagraph (B) reduction derived, losses incurred are the (A) amount";
    when losses_incurred_before_reduction_832b5A(c, y, before);
    when not_known(has_loss_reduction_832b5B(c, y));
    then losses_incurred(c, y, before);
}
