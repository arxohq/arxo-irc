// Sections 584, 585, 593 stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD.
//   * 584(a) last sentence: co-trustee banks of one affiliated group are one
//     bank (the affiliation is a case fact); 584(c) last sentence: the
//     participant's share of qualified dividends; 584(d)(1): the fund's
//     capital items segregated into gains and losses; 584(h)(2)-(3): the
//     basis rules for a transfer of a common trust fund to regulated
//     investment companies, with the FMV allocations.
//   * 585(b)(2) last sentence: the base year of the experience method;
//     585(c)(3)(B): the suspension for a financially troubled bank, the
//     exception for an elective first year, the parent-subsidiary group
//     percentage, and the estimated tax date. The ordinal of a succeeding
//     year (module 24) is counted by the case without a year that section
//     585(c)(3)(B)(i)(II) disregards.
//   * 593(g)(2)(B), (3), (4)(D)-(E), (5), (6): the fresh start balances, the
//     recapture when a taxpayer ceases to be a bank, the base amount with
//     its elective exclusion of the highest and lowest year, the group
//     residential loan test, and the continued fresh start.
// Sums over derived items follow G4903; a tie for the highest (lowest)
// residential loan year subtracts one year only (JUDGMENT CALL).

// ---- Section 584(a) last sentence: affiliated banks as one bank ----

use self::{
    IRC_S584_A,
    IRC_S584_C,
    IRC_S584_D,
    IRC_S584_H,
    IRC_S585_B,
    IRC_S585_C,
    IRC_S593_G,
    Person,
    TaxableYear,
    adjustment_taken_into_account_585c3,
    base_amount_average_of_prior_six_years_593g4D,
    base_year_585b2,
    common_trust_fund_584a,
    elected_first_year_percentage_585c3AiiiI,
    financially_troubled_bank_585c3Biii,
    first_year_amount_585c3AiiiI,
    fund_ric_transfer_nonrecognition_584h1,
    fund_transfers_substantially_all_assets_to_ric_solely_for_stock_584h1A,
    member_of_parent_subsidiary_controlled_group_585c5A,
    participant_share_of_fund_584c,
    reserves_1988_balance_reduced_593g2AiiII,
    reserves_close_of_last_year_before_1988_593g2AiiI,
    residential_loan_requirement_met_593g4B,
    residential_loans_principal_made_in_year_593g4B,
    ric_asset_basis_increase_584h3B,
    succeeding_year_amount_585c3AiiiII,
    sum_of_equity_at_quarter_closes_585c3Biv,
    sum_of_nonperforming_loan_balances_at_quarter_closes_585c3Biv,
};

pub relation bank_is_trustee_or_cotrustee_of_fund_584a(f: Person, b: Person) kind empirical {
    label en unofficial "the bank is the trustee, or one of the cotrustees, of the fund";
}
pub relation banks_members_of_same_affiliated_group_584a(b1: Person, b2: Person) kind empirical {
    label en unofficial "the two banks are members of the same affiliated group (section 1504), stated in both directions";
}
pub relation treated_as_one_bank_for_fund_584a(f: Person, b1: Person, b2: Person) kind institutional {
    label en official "the two banks are treated as one bank for the period of affiliation with respect to the fund";
}
@source(IRC_S584_A, quote = "For purposes of this subsection, two or more banks which are members of the same affiliated group")
rule Section584aAffiliatedBanksAreOneBank(f: Person, b1: Person, b2: Person) strict {
    label en official "section 584(a): banks of one affiliated group that are trustee or cotrustees of a fund are one bank (one hop; the period of affiliation is not measured)";
    when bank_is_trustee_or_cotrustee_of_fund_584a(f, b1);
    when bank_is_trustee_or_cotrustee_of_fund_584a(f, b2);
    when banks_members_of_same_affiliated_group_584a(b1, b2);
    then treated_as_one_bank_for_fund_584a(f, b1, b2);
}

// ---- Section 584(c) last sentence: qualified dividends ----

pub relation fund_dividends_to_which_1h11_applies_584c(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dividends received by the common trust fund to which section 1(h)(11) applies";
}
pub relation participant_qualified_dividend_share_584c(p: Person, f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the participant's proportionate share of the dividends, considered received by the participant for section 1(h)(11) (cents HALF_UP)";
}
@source(IRC_S584_C, quote = "The proportionate share of each participant in the amount of dividends received by the common trust fund")
rule Section584cParticipantShareOfQualifiedDividends(p: Person, f: Person, y: TaxableYear, dividends: Money, share: Decimal) defeasible {
    label en official "section 584(c): the participant's share of the dividends is considered received by the participant";
    when common_trust_fund_584a(f);
    when fund_dividends_to_which_1h11_applies_584c(f, y, dividends);
    when participant_share_of_fund_584c(p, f, y, share);
    then participant_qualified_dividend_share_584c(p, f, y, round(dividends * share, 2, "HALF_UP"));
}

// ---- Section 584(d)(1): the capital items are segregated ----

pub relation fund_capital_asset_sale_584d1(f: Person, y: TaxableYear, sale: us.irc.core::Transaction, amount: Money) kind empirical {
    label en unofficial "the gain (positive) or loss (negative) of the fund on a sale or exchange of a capital asset";
}
pub relation fund_capital_gain_item_584d1(f: Person, y: TaxableYear, sale: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "a capital gain of the fund, segregated from the loss items";
}
pub relation fund_capital_loss_item_584d1(f: Person, y: TaxableYear, sale: us.irc.core::Transaction, amount: Money) kind institutional {
    label en official "a capital loss of the fund (as a positive amount), segregated from the gain items";
}
@source(IRC_S584_D, quote = "(1) there shall be segregated the gains and losses from sales or exchanges of capital assets;")
rule Section584d1SegregateGains(f: Person, y: TaxableYear, sale: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 584(d)(1): gains from sales or exchanges of capital assets are segregated";
    when fund_capital_asset_sale_584d1(f, y, sale, amount);
    when amount > 0.00 USD;
    then fund_capital_gain_item_584d1(f, y, sale, amount);
}
rule Section584d1SegregateLosses(f: Person, y: TaxableYear, sale: us.irc.core::Transaction, amount: Money) strict {
    label en official "section 584(d)(1): losses from sales or exchanges of capital assets are segregated";
    when fund_capital_asset_sale_584d1(f, y, sale, amount);
    when amount < 0.00 USD;
    then fund_capital_loss_item_584d1(f, y, sale, 0.00 USD - amount);
}
pub relation fund_capital_gains_total_584d1(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the segregated gains";
}
rule Section584d1GainsTotal(f: Person, y: TaxableYear) strict {
    label en official "section 584(d)(1): the segregated gains added";
    when fund_capital_gain_item_584d1(f, y, _, _);
    then fund_capital_gains_total_584d1(f, y, sum all amount: Money for sale: us.irc.core::Transaction where fund_capital_gain_item_584d1(f, y, sale, amount));
}
pub relation fund_capital_losses_total_584d1(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the total of the segregated losses";
}
rule Section584d1LossesTotal(f: Person, y: TaxableYear) strict {
    label en official "section 584(d)(1): the segregated losses added";
    when fund_capital_loss_item_584d1(f, y, _, _);
    then fund_capital_losses_total_584d1(f, y, sum all amount: Money for sale: us.irc.core::Transaction where fund_capital_loss_item_584d1(f, y, sale, amount));
}

// ---- Section 584(h)(2)-(3): the basis rules ----

pub relation fund_basis_in_asset_transferred_to_ric_584h2A(f: Person, asset: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the basis of the asset in the hands of the common trust fund";
}
pub relation ric_receives_asset_from_fund_584h2A(f: Person, ric: Person, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the regulated investment company receives the asset in the transfer";
}
pub relation ric_basis_in_received_asset_584h2A(ric: Person, asset: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the basis of the asset in the hands of the regulated investment company: the same as in the hands of the fund";
}
@source(IRC_S584_H, quote = "The basis of any asset received by a regulated investment company in a transfer referred to in paragraph")
rule Section584h2ARicBasisIsFundBasis(f: Person, ric: Person, asset: us.irc.core::Asset, amount: Money) strict {
    label en official "section 584(h)(2)(A): the RIC's basis is the fund's basis";
    when fund_ric_transfer_nonrecognition_584h1(f);
    when ric_receives_asset_from_fund_584h2A(f, ric, asset);
    when fund_basis_in_asset_transferred_to_ric_584h2A(f, asset, amount);
    then ric_basis_in_received_asset_584h2A(ric, asset, amount);
}
pub relation participant_basis_in_fund_interest_584h2B(p: Person, f: Person, amount: Money) kind empirical {
    label en unofficial "the basis of the participant's interest in the fund (the property exchanged)";
}
pub relation ric_stock_fair_market_value_received_584h2B(p: Person, f: Person, ric: Person, value: Money) kind empirical {
    label en unofficial "the fair market value of the stock of the regulated investment company received by the participant";
}
pub relation participant_stock_basis_584h2B(p: Person, f: Person, ric: Person, amount: Money) kind institutional {
    label en official "the basis of the stock received: the basis of the property exchanged, allocated among the companies by fair market value (cents HALF_UP)";
}
pub relation participant_stock_value_total_584h2B(p: Person, f: Person, total: Money) kind institutional {
    label en official "the fair market value of all the stock received by the participant";
}
rule Section584h2BStockValueTotal(p: Person, f: Person) strict {
    label en official "section 584(h)(2)(B): the total fair market value of the stock (a sum over the companies: G4903)";
    when ric_stock_fair_market_value_received_584h2B(p, f, _, _);
    then participant_stock_value_total_584h2B(p, f, sum all v: Money for r: Person where ric_stock_fair_market_value_received_584h2B(p, f, r, v));
}
@source(IRC_S584_H, quote = "The basis of the stock which is received in an exchange referred to in paragraph (1)(B) shall be the")
rule Section584h2BParticipantStockBasis(p: Person, f: Person, ric: Person, basis: Money, value: Money, total: Money) strict {
    label en official "section 584(h)(2)(B): the stock takes the basis of the property exchanged, allocated by fair market values among the companies";
    when fund_ric_transfer_nonrecognition_584h1(f);
    when participant_basis_in_fund_interest_584h2B(p, f, basis);
    when ric_stock_fair_market_value_received_584h2B(p, f, ric, value);
    when participant_stock_value_total_584h2B(p, f, total);
    when total > 0.00 USD;
    then participant_stock_basis_584h2B(p, f, ric, div_round(basis * (value / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation consideration_other_than_ric_stock_and_assumption_584h3A(f: Person, amount: Money) kind empirical {
    label en unofficial "the consideration received by the fund other than regulated investment company stock, not counting the assumption of a liability of the fund";
}
pub relation fund_transfers_substantially_all_assets_584h1A(f: Person) kind empirical {
    label en unofficial "the fund transfers substantially all of its assets to one or more regulated investment companies";
}
@source(IRC_S584_H, quote = "In determining whether the transfer referred to in paragraph (1)(A) is in exchange solely for stock in")
rule Section584h3AAssumptionDisregarded(f: Person, other: Money) strict {
    label en official "section 584(h)(3)(A): in deciding whether the transfer is solely for stock the assumption of a liability is disregarded";
    when fund_transfers_substantially_all_assets_584h1A(f);
    when consideration_other_than_ric_stock_and_assumption_584h3A(f, other);
    when other <= 0.00 USD;
    then fund_transfers_substantially_all_assets_to_ric_solely_for_stock_584h1A(f);
}
pub relation ric_fair_market_value_of_assets_received_584h3Bi(f: Person, ric: Person, value: Money) kind empirical {
    label en unofficial "the fair market value of the assets received by the regulated investment company in the transfer";
}
pub relation ric_basis_increase_allocated_584h3Bi(f: Person, ric: Person, amount: Money) kind institutional {
    label en official "the basis increase for the gain recognized allocated among the companies by the fair market values of the assets received (cents HALF_UP)";
}
pub relation ric_assets_fair_market_value_total_584h3Bi(f: Person, total: Money) kind institutional {
    label en official "the fair market value of the assets received by all the companies";
}
rule Section584h3BiFmvTotal(f: Person) strict {
    label en official "section 584(h)(3)(B)(i): the total fair market value (a sum over the companies: G4903)";
    when ric_fair_market_value_of_assets_received_584h3Bi(f, _, _);
    then ric_assets_fair_market_value_total_584h3Bi(f, sum all v: Money for r: Person where ric_fair_market_value_of_assets_received_584h3Bi(f, r, v));
}
@source(IRC_S584_H, quote = "If the transfer referred to in paragraph (1)(A) is to two or more regulated investment companies, the")
rule Section584h3BiAllocateBasisIncrease(f: Person, ric: Person, gain: Money, value: Money, total: Money) strict {
    label en official "section 584(h)(3)(B)(i): a transfer to two or more companies allocates the basis increase by fair market values";
    when ric_asset_basis_increase_584h3B(f, gain);
    when ric_fair_market_value_of_assets_received_584h3Bi(f, ric, value);
    when ric_assets_fair_market_value_total_584h3Bi(f, total);
    when total > 0.00 USD;
    then ric_basis_increase_allocated_584h3Bi(f, ric, div_round(gain * (value / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 585(b)(2) last sentence: the base year ----

pub relation year_of_most_recent_adoption_of_experience_method_585b2(b: Person, adopted_in: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which the bank most recently adopted the experience method";
}
pub relation preceding_taxable_year_585b2(y: TaxableYear, previous: TaxableYear) kind empirical {
    label en unofficial "previous is the taxable year immediately preceding y (no preceding-year term in us.irc.core, G2201)";
}
pub relation last_taxable_year_beginning_before_1988_585b2(b: Person, y: TaxableYear) kind empirical {
    label en unofficial "the last taxable year of the bank beginning before 1988";
}
@source(IRC_S585_B, quote = "For purposes of this paragraph, the base year shall be the last taxable year before the most recent")
rule Section585b2BaseYearAfter1987(b: Person, y: TaxableYear, base: TaxableYear, begins_on: Date) strict {
    label en official "section 585(b)(2): for a taxable year beginning after 1987 the base year is the last taxable year beginning before 1988";
    when last_taxable_year_beginning_before_1988_585b2(b, base);
    when us.irc.core::begins(y, begins_on);
    when begins_on > @1987-12-31;
    then base_year_585b2(b, y, base);
}
rule Section585b2BaseYearBefore1988(b: Person, y: TaxableYear, adopted_in: TaxableYear, base: TaxableYear, begins_on: Date) strict {
    label en official "section 585(b)(2): otherwise the last taxable year before the most recent adoption of the experience method";
    when year_of_most_recent_adoption_of_experience_method_585b2(b, adopted_in);
    when preceding_taxable_year_585b2(adopted_in, base);
    when us.irc.core::begins(y, begins_on);
    when begins_on <= @1987-12-31;
    then base_year_585b2(b, y, base);
}

// ---- Section 585(c)(3)(B): the financially troubled bank ----

pub relation parent_subsidiary_group_member_585c3Biv(b: Person, m: Person) kind empirical {
    label en unofficial "m is a member of the parent-subsidiary controlled group of which the bank is a member (the bank itself is not listed)";
}
pub relation group_member_nonperforming_balances_585c3Biv(b: Person, y: TaxableYear, m: Person, amount: Money) kind institutional {
    label en official "the nonperforming loan balances of another member of the group";
}
rule Section585c3BivGroupMemberNonperforming(b: Person, y: TaxableYear, m: Person, amount: Money) strict {
    label en official "section 585(c)(3)(B)(iv) last sentence: the members' balances";
    when parent_subsidiary_group_member_585c3Biv(b, m);
    when sum_of_nonperforming_loan_balances_at_quarter_closes_585c3Biv(m, y, amount);
    then group_member_nonperforming_balances_585c3Biv(b, y, m, amount);
}
pub relation group_member_equity_585c3Biv(b: Person, y: TaxableYear, m: Person, amount: Money) kind institutional {
    label en official "the equity of another member of the group";
}
rule Section585c3BivGroupMemberEquity(b: Person, y: TaxableYear, m: Person, amount: Money) strict {
    label en official "section 585(c)(3)(B)(iv) last sentence: the members' equity";
    when parent_subsidiary_group_member_585c3Biv(b, m);
    when sum_of_equity_at_quarter_closes_585c3Biv(m, y, amount);
    then group_member_equity_585c3Biv(b, y, m, amount);
}
pub relation group_other_members_nonperforming_total_585c3Biv(b: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the nonperforming loan balances of the other members of the group added";
}
rule Section585c3BivOthersNonperformingTotal(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(3)(B)(iv): the sum over the other members (G4903)";
    when group_member_nonperforming_balances_585c3Biv(b, y, _, _);
    then group_other_members_nonperforming_total_585c3Biv(b, y, sum all n: Money for m: Person where group_member_nonperforming_balances_585c3Biv(b, y, m, n));
}
pub relation group_other_members_equity_total_585c3Biv(b: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the equity of the other members of the group added";
}
rule Section585c3BivOthersEquityTotal(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(3)(B)(iv): the sum over the other members (G4903)";
    when group_member_equity_585c3Biv(b, y, _, _);
    then group_other_members_equity_total_585c3Biv(b, y, sum all e: Money for m: Person where group_member_equity_585c3Biv(b, y, m, e));
}
@source(IRC_S585_C, quote = "In the case of a bank which is a member of a parent-subsidiary controlled group for the taxable year,")
rule Section585c3BivGroupTroubled(b: Person, y: TaxableYear, own_npl: Money, own_equity: Money, other_npl: Money, other_equity: Money) strict {
    label en official "section 585(c)(3)(B)(iv): for a member of a parent-subsidiary controlled group the percentage is applied to the group";
    when member_of_parent_subsidiary_controlled_group_585c5A(b);
    when sum_of_nonperforming_loan_balances_at_quarter_closes_585c3Biv(b, y, own_npl);
    when sum_of_equity_at_quarter_closes_585c3Biv(b, y, own_equity);
    when group_other_members_nonperforming_total_585c3Biv(b, y, other_npl);
    when group_other_members_equity_total_585c3Biv(b, y, other_equity);
    when (own_npl + other_npl) * 100.0 > (own_equity + other_equity) * 75.0;
    then financially_troubled_bank_585c3Biii(b, y);
}
pub relation first_year_of_the_spread_585c3(b: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is the first of the 4 taxable years beginning with the disqualification year";
}
pub relation troubled_year_suspension_applies_585c3Bi(b: Person, y: TaxableYear) kind institutional {
    label en official "the suspension of clause (i) applies for the year: the bank is financially troubled, and the year is not a first year with an elected higher percentage";
}
pub relation elective_first_year_exception_585c3Bii(b: Person, y: TaxableYear) kind institutional {
    label en official "the first year with an elected higher percentage: clause (i) does not apply (helper)";
}
@source(IRC_S585_C, quote = "Clause (i) shall not apply to the 1st taxable year referred to in subparagraph (A)(iii)(I) if the")
rule Section585c3BiiElectiveFirstYear(b: Person, y: TaxableYear, pct: Decimal) strict {
    label en official "section 585(c)(3)(B)(ii): clause (i) does not apply to the first year if the taxpayer elects a higher percentage";
    when first_year_of_the_spread_585c3(b, y);
    when elected_first_year_percentage_585c3AiiiI(b, pct);
    when pct > 10.0;
    then elective_first_year_exception_585c3Bii(b, y);
}
@source(IRC_S585_C, quote = "(I) no adjustment shall be taken into account under subparagraph (A) for such taxable year, and")
rule Section585c3BiTroubledYearSuspension(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(3)(B)(i): a financially troubled year suspends the adjustment (unless the elective first year exception applies)";
    when financially_troubled_bank_585c3Biii(b, y);
    when not_known(elective_first_year_exception_585c3Bii(b, y));
    then troubled_year_suspension_applies_585c3Bi(b, y);
}
pub relation year_disregarded_for_the_spread_585c3BiII(b: Person, y: TaxableYear) kind institutional {
    label en official "the year is disregarded in determining whether another year requires an adjustment, and the amount (the case numbers the succeeding years without it)";
}
@source(IRC_S585_C, quote = "(II) such taxable year shall be disregarded in determining whether any other taxable year is a taxable")
rule Section585c3BiIIYearDisregarded(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(3)(B)(i)(II): the suspended year is disregarded for the other years";
    when troubled_year_suspension_applies_585c3Bi(b, y);
    then year_disregarded_for_the_spread_585c3BiII(b, y);
}
rule Section585c3AdjustmentFirstYear(b: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(I), (B)(i)(I): the first-year amount is taken into account unless the year is suspended";
    when first_year_amount_585c3AiiiI(b, y, amount);
    when not_known(troubled_year_suspension_applies_585c3Bi(b, y));
    then adjustment_taken_into_account_585c3(b, y, amount);
}
rule Section585c3AdjustmentSucceedingYear(b: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(II), (B)(i)(I): a succeeding year's amount is taken into account unless the year is suspended";
    when succeeding_year_amount_585c3AiiiII(b, y, amount);
    when not_known(troubled_year_suspension_applies_585c3Bi(b, y));
    then adjustment_taken_into_account_585c3(b, y, amount);
}
@source(IRC_S585_C, quote = "(I) no adjustment shall be taken into account under subparagraph (A) for such taxable year, and")
rule Section585c3BiISuspendedYearHasNoAdjustment(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(3)(B)(i)(I): no adjustment is taken into account for a suspended year";
    when troubled_year_suspension_applies_585c3Bi(b, y);
    then adjustment_taken_into_account_585c3(b, y, 0.00 USD);
}
pub relation installment_due_date_6655e2_585c3C(b: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the last day prescribed for payment of the estimated tax installment";
}
pub relation nonperforming_balances_through_installment_date_585c3C(b: Person, y: TaxableYear, due: Date, amount: Money) kind empirical {
    label en unofficial "the nonperforming loan balances at the quarter closes up to the installment date";
}
pub relation equity_through_installment_date_585c3C(b: Person, y: TaxableYear, due: Date, amount: Money) kind empirical {
    label en unofficial "the equity at the quarter closes up to the installment date";
}
pub relation financially_troubled_as_of_installment_585c3C(b: Person, y: TaxableYear, due: Date) kind institutional {
    label en official "for section 6655(e)(2)(A)(i) the financially troubled bank determination is made as of the last day prescribed for payment of the installment";
}
@source(IRC_S585_C, quote = "For purposes of applying section 6655(e)(2)(A)(i) with respect to any installment, the determination")
rule Section585c3CDeterminationAsOfInstallmentDate(b: Person, y: TaxableYear, due: Date, npl: Money, equity: Money) strict {
    label en official "section 585(c)(3)(C): the determination under (B) is made as of the installment date (sums through that date)";
    when installment_due_date_6655e2_585c3C(b, y, due);
    when nonperforming_balances_through_installment_date_585c3C(b, y, due, npl);
    when equity_through_installment_date_585c3C(b, y, due, equity);
    when npl * 100.0 > equity * 75.0;
    then financially_troubled_as_of_installment_585c3C(b, y, due);
}

// ---- Section 593(g)(2)(B), (3), (5), (6): the fresh start balances ----

pub relation bank_not_large_first_year_after_1995_593g2B(i: Person) kind empirical {
    label en unofficial "the taxpayer is a bank (section 581) that was not a large bank (section 585(c)(2)) for its first taxable year beginning after 1995";
}
pub relation reserve_balance_by_585b2A_additions_593g2Bi(i: Person, amount: Money) kind empirical {
    label en unofficial "the balance of the reserves at the close of the last taxable year beginning before 1996 if the additions for all taxable years had been determined under section 585(b)(2)(A)";
}
pub relation balance_taken_into_account_593g2Aii(i: Person, amount: Money) kind institutional {
    label en official "the balance taken into account under subparagraph (A)(ii): the lesser of the 1987 balance and its reduced amount";
}
rule Section593g2AiiBalance(i: Person, close_1987: Money, reduced: Money) strict {
    label en official "section 593(g)(2)(A)(ii): the lesser of the two balances";
    when reserves_close_of_last_year_before_1988_593g2AiiI(i, close_1987);
    when reserves_1988_balance_reduced_593g2AiiII(i, reduced);
    then balance_taken_into_account_593g2Aii(i, min(close_1987, reduced));
}
pub relation balance_taken_into_account_after_593g2Bi(i: Person, amount: Money) kind institutional {
    label en official "the balance of subparagraph (A)(ii) after clause (i): not less than the balance by the section 585(b)(2)(A) method";
}
@source(IRC_S593_G, quote = "In the case of a bank (as defined in section 581) which was not a large bank (as defined in section")
rule Section593g2BiFloorForNewSmallBanks(i: Person, balance: Money, floor: Money) strict {
    label en official "section 593(g)(2)(B)(i): for a thrift that becomes a small bank the balance is not less than the amount by the experience method";
    when bank_not_large_first_year_after_1995_593g2B(i);
    when balance_taken_into_account_593g2Aii(i, balance);
    when reserve_balance_by_585b2A_additions_593g2Bi(i, floor);
    then balance_taken_into_account_after_593g2Bi(i, max(balance, floor));
}
@source(IRC_S593_G, quote = "(i) the balance taken into account under subparagraph (A)(ii) shall not be less than the amount which")
pub relation opening_reserve_balance_593g2Bii(i: Person, amount: Money) kind institutional {
    label en official "the opening balance of the reserve for bad debts at the beginning of the first taxable year";
}
@source(IRC_S593_G, quote = "(ii) the opening balance of the reserve for bad debts as of the beginning of such first taxable year")
rule Section593g2BiiOpeningBalance(i: Person, balance: Money) strict {
    label en official "section 593(g)(2)(B)(ii): the opening balance is the balance of (A)(ii) after clause (i)";
    when balance_taken_into_account_after_593g2Bi(i, balance);
    then opening_reserve_balance_593g2Bii(i, balance);
}
pub relation balance_for_593g5_593g6_593e1(i: Person, amount: Money) kind institutional {
    label en official "the balance used for paragraphs (5) and (6) and subsection (e)(1): the (A)(ii) balance without the (B) increase";
}
@source(IRC_S593_G, quote = "The preceding sentence shall not apply for purposes of paragraphs (5) and (6) or subsection (e)(1).")
rule Section593g2BLastSentenceExcludesTheIncrease(i: Person, balance: Money) strict {
    label en official "section 593(g)(2)(B) last sentence: the preceding sentence does not apply for paragraphs (5) and (6) or subsection (e)(1)";
    when balance_taken_into_account_593g2Aii(i, balance);
    then balance_for_593g5_593g6_593e1(i, balance);
}
pub relation taxpayer_not_a_bank_in_year_593g3(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "during this taxable year beginning after 1995 the taxpayer to which paragraph (1) applied is not a bank";
}
pub relation supplemental_reserve_balance_593g3(i: Person, amount: Money) kind empirical {
    label en unofficial "the balance of the supplemental reserve for losses on loans";
}
pub relation recapture_on_ceasing_to_be_bank_593g3(i: Person, y: TaxableYear, annual: Money) kind institutional {
    label en official "the reserves of (2)(A)(ii) and the supplemental reserve are taken into account ratably over the 6-taxable year period beginning with the year the taxpayer is not a bank (one sixth a year, cents HALF_UP)";
}
@source(IRC_S593_G, quote = "If, during any taxable year beginning after December 31, 1995, a taxpayer to which paragraph (1) applied")
rule Section593g3RecaptureOnCeasingToBeBank(i: Person, y: TaxableYear, balance: Money, supplemental: Money) strict {
    label en official "section 593(g)(3): recapture of the pre-1988 reserves when the taxpayer ceases to be a bank";
    when taxpayer_not_a_bank_in_year_593g3(i, y);
    when balance_for_593g5_593g6_593e1(i, balance);
    when supplemental_reserve_balance_593g3(i, supplemental);
    then recapture_on_ceasing_to_be_bank_593g3(i, y, div_round(balance + supplemental, 6.0, 2, "HALF_UP"));
}
pub relation reserve_for_bad_debts_close_of_last_year_before_disqualification_593g5A(i: Person, amount: Money) kind empirical {
    label en unofficial "the reserve for bad debts as of the close of the last taxable year before the disqualification year";
}
pub relation continued_fresh_start_applies_593g5(i: Person) kind empirical {
    label en unofficial "the taxpayer is one to which paragraph (1) applied and which was not a large bank for its first taxable year beginning after 1995";
}
pub relation net_amount_of_adjustments_593g5A(i: Person, amount: Money) kind institutional {
    label en official "the net amount of adjustments for section 585(c)(3)(A)(iii): only the excess of the reserve over the (A)(ii) balance";
}
@source(IRC_S593_G, quote = "For purposes of determining the net amount of adjustments referred to in section 585(c)(3)(A)(iii),")
rule Section593g5AExcessOverSuspendedBalance(i: Person, reserve: Money, balance: Money) strict {
    label en official "section 593(g)(5)(A): only the excess of the reserve over the balance taken into account under (2)(A)(ii)";
    when continued_fresh_start_applies_593g5(i);
    when reserve_for_bad_debts_close_of_last_year_before_disqualification_593g5A(i, reserve);
    when balance_for_593g5_593g6_593e1(i, balance);
    then net_amount_of_adjustments_593g5A(i, max(0.00 USD, reserve - balance));
}
pub relation reserve_balance_for_585c4B_after_593g5B(i: Person, amount: Money) kind institutional {
    label en official "for section 585(c)(4) the reserve balance is reduced by the (A)(ii) balance";
}
@source(IRC_S593_G, quote = "(i) the balance of the reserve taken into account under subparagraph (B) thereof shall be reduced by the")
rule Section593g5BiReducedReserveForCutOff(i: Person, reserve: Money, balance: Money) strict {
    label en official "section 593(g)(5)(B)(i): the balance of the reserve of section 585(c)(4)(B) is reduced by the (A)(ii) balance";
    when continued_fresh_start_applies_593g5(i);
    when reserve_for_bad_debts_close_of_last_year_before_disqualification_593g5A(i, reserve);
    when balance_for_593g5_593g6_593e1(i, balance);
    then reserve_balance_for_585c4B_after_593g5B(i, max(0.00 USD, reserve - balance));
}
pub relation reduction_not_included_in_gross_income_593g5Bii(i: Person) kind institutional {
    label en official "no amount is includible in gross income by reason of the reduction";
}
@source(IRC_S593_G, quote = "(ii) no amount shall be includible in gross income by reason of such reduction.")
rule Section593g5BiiNoIncomeFromReduction(i: Person) strict {
    label en official "section 593(g)(5)(B)(ii): no gross income by reason of the reduction";
    when reserve_balance_for_585c4B_after_593g5B(i, _);
    then reduction_not_included_in_gross_income_593g5Bii(i);
}
@source(IRC_S593_G, quote = "In the case of a taxpayer to which paragraph (1) applied and which was not a large bank (as defined in")
pub relation continued_fresh_start_recorded_593g5(i: Person) kind institutional {
    label en official "the continued application of the fresh start under the section 585 transitional rules applies (chapeau)";
}
rule Section593g5Chapeau(i: Person) strict {
    label en official "section 593(g)(5): a taxpayer to which paragraph (1) applied and which was not a large bank for its first year after 1995";
    when continued_fresh_start_applies_593g5(i);
    then continued_fresh_start_recorded_593g5(i);
}
pub relation treated_as_section_381c_item_593g6(i: Person, item: Text, amount: Money) kind institutional {
    label en official "the balance and the supplemental reserve are treated as items described in section 381(c)";
}
@source(IRC_S593_G, quote = "The balance taken into account by a taxpayer under paragraph (2)(A)(ii) of this subsection and the")
rule Section593g6BalanceIsSection381cItem(i: Person, balance: Money) strict {
    label en official "section 593(g)(6): the (A)(ii) balance is a section 381(c) item";
    when balance_for_593g5_593g6_593e1(i, balance);
    then treated_as_section_381c_item_593g6(i, "balance under section 593(g)(2)(A)(ii)", balance);
}
rule Section593g6SupplementalReserveIsSection381cItem(i: Person, supplemental: Money) strict {
    label en official "section 593(g)(6): the supplemental reserve is a section 381(c) item";
    when supplemental_reserve_balance_593g3(i, supplemental);
    then treated_as_section_381c_item_593g6(i, "supplemental reserve", supplemental);
}

// ---- Section 593(g)(4)(D)-(E): the base amount and the controlled group ----

pub relation residential_loans_of_base_year_593g4D(i: Person, base_year: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the principal amount of the residential loans made by the taxpayer in one of the 6 most recent taxable years beginning on or before December 31, 1995";
}
pub relation elects_to_drop_highest_and_lowest_593g4D(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer, having made such loans in each of the 6 years, elects to disregard the highest and the lowest year (for the first taxable year beginning after 1995, and the succeeding year unless revoked)";
}
pub relation base_year_amount_exceeded_593g4D(i: Person, amount: Money) kind institutional {
    label en official "some base year has a greater principal amount (helper)";
}
rule Section593g4DHelperExceeded(i: Person, y1: TaxableYear, y2: TaxableYear, a1: Money, a2: Money) strict {
    label en official "helper";
    when residential_loans_of_base_year_593g4D(i, y1, a1);
    when residential_loans_of_base_year_593g4D(i, y2, a2);
    when a2 > a1;
    then base_year_amount_exceeded_593g4D(i, a1);
}
pub relation base_year_amount_undercut_593g4D(i: Person, amount: Money) kind institutional {
    label en official "some base year has a smaller principal amount (helper)";
}
rule Section593g4DHelperUndercut(i: Person, y1: TaxableYear, y2: TaxableYear, a1: Money, a2: Money) strict {
    label en official "helper";
    when residential_loans_of_base_year_593g4D(i, y1, a1);
    when residential_loans_of_base_year_593g4D(i, y2, a2);
    when a2 < a1;
    then base_year_amount_undercut_593g4D(i, a1);
}
pub relation highest_base_year_amount_593g4D(i: Person, amount: Money) kind institutional {
    label en official "the highest principal amount among the base years";
}
rule Section593g4DHighest(i: Person, y: TaxableYear, a: Money) strict {
    label en official "helper: the highest base year";
    when residential_loans_of_base_year_593g4D(i, y, a);
    when not_known(base_year_amount_exceeded_593g4D(i, a));
    then highest_base_year_amount_593g4D(i, a);
}
pub relation lowest_base_year_amount_593g4D(i: Person, amount: Money) kind institutional {
    label en official "the lowest principal amount among the base years";
}
rule Section593g4DLowest(i: Person, y: TaxableYear, a: Money) strict {
    label en official "helper: the lowest base year";
    when residential_loans_of_base_year_593g4D(i, y, a);
    when not_known(base_year_amount_undercut_593g4D(i, a));
    then lowest_base_year_amount_593g4D(i, a);
}
pub relation base_years_total_593g4D(i: Person, amount: Money) kind institutional {
    label en official "the total principal amount over the base years";
}
rule Section593g4DTotal(i: Person, y: TaxableYear, a: Money) strict {
    label en official "section 593(g)(4)(D): the sum over the base years";
    when residential_loans_of_base_year_593g4D(i, y, a);
    then base_years_total_593g4D(i, sum all amount: Money for by: TaxableYear where residential_loans_of_base_year_593g4D(i, by, amount));
}
@source(IRC_S593_G, quote = "For purposes of subparagraph (B), the base amount is the average of the principal amounts of the")
rule Section593g4DAverageOfSixYears(i: Person, y: TaxableYear, total: Money, made: Money) strict {
    label en official "section 593(g)(4)(D): the average of the 6 most recent years (cents HALF_UP)";
    when base_years_total_593g4D(i, total);
    when residential_loans_principal_made_in_year_593g4B(i, y, made);
    when not_known(elects_to_drop_highest_and_lowest_593g4D(i, y));
    then base_amount_average_of_prior_six_years_593g4D(i, y, div_round(total, 6.0, 2, "HALF_UP"));
}
rule Section593g4DAverageWithoutHighestAndLowest(i: Person, y: TaxableYear, total: Money, high: Money, low: Money) strict {
    label en official "section 593(g)(4)(D): at the taxpayer's election without the highest and the lowest year (cents HALF_UP)";
    when base_years_total_593g4D(i, total);
    when highest_base_year_amount_593g4D(i, high);
    when lowest_base_year_amount_593g4D(i, low);
    when elects_to_drop_highest_and_lowest_593g4D(i, y);
    then base_amount_average_of_prior_six_years_593g4D(i, y, div_round((total - high) - low, 4.0, 2, "HALF_UP"));
}
pub relation controlled_group_member_593g4E(i: Person, m: Person) kind empirical {
    label en unofficial "m is a member of the controlled group of corporations described in section 1563(a)(1) of which the taxpayer is a member";
}
pub relation controlled_group_applies_593g4E(i: Person) kind institutional {
    label en official "the taxpayer is a member of a controlled group described in section 1563(a)(1) (helper)";
}
rule Section593g4EHelperGroupApplies(i: Person, m: Person) strict {
    label en official "helper";
    when controlled_group_member_593g4E(i, m);
    then controlled_group_applies_593g4E(i);
}
pub relation group_member_loans_made_593g4E(i: Person, y: TaxableYear, m: Person, amount: Money) kind institutional {
    label en official "the residential loan principal made by another member of the group";
}
rule Section593g4EGroupMemberLoansMade(i: Person, y: TaxableYear, m: Person, amount: Money) strict {
    label en official "section 593(g)(4)(E): the other members' residential loans";
    when controlled_group_member_593g4E(i, m);
    when residential_loans_principal_made_in_year_593g4B(m, y, amount);
    then group_member_loans_made_593g4E(i, y, m, amount);
}
pub relation group_member_base_amount_593g4E(i: Person, y: TaxableYear, m: Person, amount: Money) kind institutional {
    label en official "the base amount of another member of the group";
}
rule Section593g4EGroupMemberBase(i: Person, y: TaxableYear, m: Person, amount: Money) strict {
    label en official "section 593(g)(4)(E): the other members' base amounts";
    when controlled_group_member_593g4E(i, m);
    when base_amount_average_of_prior_six_years_593g4D(m, y, amount);
    then group_member_base_amount_593g4E(i, y, m, amount);
}
pub relation group_other_members_loans_total_593g4E(i: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the residential loan principal of the other members added";
}
rule Section593g4EOthersLoansTotal(i: Person, y: TaxableYear) strict {
    label en official "section 593(g)(4)(E): the sum over the other members (G4903)";
    when group_member_loans_made_593g4E(i, y, _, _);
    then group_other_members_loans_total_593g4E(i, y, sum all a: Money for m: Person where group_member_loans_made_593g4E(i, y, m, a));
}
pub relation group_other_members_base_total_593g4E(i: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the base amounts of the other members added";
}
rule Section593g4EOthersBaseTotal(i: Person, y: TaxableYear) strict {
    label en official "section 593(g)(4)(E): the sum over the other members (G4903)";
    when group_member_base_amount_593g4E(i, y, _, _);
    then group_other_members_base_total_593g4E(i, y, sum all b: Money for m: Person where group_member_base_amount_593g4E(i, y, m, b));
}
@source(IRC_S593_G, quote = "In the case of a taxpayer which is a member of any controlled group of corporations described in section")
rule Section593g4EGroupResidentialLoanRequirement(i: Person, y: TaxableYear, own_made: Money, own_base: Money, other_made: Money, other_base: Money) strict {
    label en official "section 593(g)(4)(E): subparagraph (B) applied to the controlled group";
    when residential_loans_principal_made_in_year_593g4B(i, y, own_made);
    when base_amount_average_of_prior_six_years_593g4D(i, y, own_base);
    when group_other_members_loans_total_593g4E(i, y, other_made);
    when group_other_members_base_total_593g4E(i, y, other_base);
    when own_made + other_made >= own_base + other_base;
    then residential_loan_requirement_met_593g4B(i, y);
}
