// Sections 860A-860G, stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. Every relation is either a case fact (empirical) or derived by a
// rule; the derived relations carry the classifications the stage 2 modules
// (14, 21) took as asserted inputs:
//   * qualified liquidation and liquidation period (860F(a)(4)) and its
//     effect on the 860D(a)(4) asset test (860D(a) flush sentence), at the
//     level of a date under review (G5302: the year-level qualification of
//     module 14 is not re-derived from it);
//   * the four categories of prohibited transactions (860F(a)(2)) with the
//     (a)(2)(A) and (a)(5) exceptions, per transaction (G5301: the tax of
//     module 14 still takes the aggregate gross income as an input);
//   * permitted investments (860G(a)(5)-(8)): cash flow investment,
//     qualified reserve asset and fund, foreclosure property;
//   * the startup day (860G(a)(9)), the tenant-stockholder and government
//     origination sentences of 860G(a)(3);
//   * termination and inadvertent termination (860D(b)(2)), the
//     Secretary's determination and the reasonable-time step being external
//     judgments (DECISION-0194 channel 1);
//   * the adjusted issue price roll-forward (860E(c)(2)(B)) and the
//     no-significant-value excess inclusion (860E(c)(1) last sentence);
//   * the REMIC's taxable income under 860C(b)(1)(A)-(D);
//   * the regular-interest ratable inclusion and deduction of 860F(b)(1)
//     (C)(i)/(D)(i) as a STRAIGHT-LINE reading of the "rules similar to
//     section 1276(b) / section 171" (a JUDGMENT CALL: the constant-yield
//     election of those sections is not represented, G5300).
// A period "not exceeding 10 days" of 860G(a)(9) is read as both end days
// included (JUDGMENT CALL): the end day is at most start + 9 days.

// ---- Section 860F(a)(4): qualified liquidation and liquidation period ----

use self::{
    IRC_S860A_B,
    IRC_S860C_B,
    IRC_S860D_A,
    IRC_S860D_B,
    IRC_S860E_A,
    IRC_S860E_C,
    IRC_S860E_D,
    IRC_S860F_A,
    IRC_S860F_B,
    IRC_S860F_D,
    IRC_S860G_A,
    Person,
    TaxableYear,
    adjusted_basis_of_interest_received_860Fb1B,
    adjusted_issue_price_beginning_of_quarter_860e2B,
    amount_taken_into_account_860c_a,
    amount_taken_into_account_by_residual_holder_860Ce1,
    dividends_received_from_entity_860Ed1,
    excess_inclusion,
    holder_excess_inclusion_for_year_860Ea1,
    holder_taxable_income_before_floor_860Ea1,
    issue_price_of_interest_860Fb1C,
    obligation_principally_secured_by_real_property_860Ga3A,
    qualified_mortgage_860Ga3,
    regular_interest_860Ga1,
    reit_or_ric_residual_aggregate_excess_inclusions_860Ed1A,
    reit_taxable_income_excluding_net_capital_gain_860Ed1B,
    remic_allowable_deductions_860Cb2,
    remic_gross_income_860Cb2,
    residual_interest_860Fd,
    total_dividends_paid_by_entity_860Ed1,
    treated_as_remic_860d,
};

pub relation remic_date_under_review_860F(remic: Person, on: Date) kind empirical {
    label en unofficial "a date as of which the REMIC's status is examined (for the liquidation period and the section 860D(a)(4) asset test)";
}
pub relation remic_adopts_plan_of_complete_liquidation_860Fa4Ai(remic: Person, adopted: Date) kind empirical {
    label en unofficial "the REMIC adopts a plan of complete liquidation on this date";
}
pub relation remic_sells_all_non_cash_assets_within_liquidation_period_860Fa4Aii(remic: Person, adopted: Date) kind empirical {
    label en unofficial "the REMIC sells all its assets (other than cash) within the liquidation period that began on the adoption date";
}
pub relation proceeds_credited_or_distributed_by_period_end_860Fa4Aiii(remic: Person, adopted: Date) kind empirical {
    label en unofficial "all proceeds of the liquidation (plus the cash), less assets retained to meet claims, are credited or distributed to holders of regular or residual interests on or before the last day of the liquidation period";
}
pub relation liquidation_period_end_860Fa4Bii(remic: Person, adopted: Date, ends_on: Date) kind institutional {
    label en official "the liquidation period ends at the close of the 90th day after the adoption of the plan";
}
@source(IRC_S860F_A, quote = "(ii) ending at the close of the 90th day after such date.")
rule Section860Fa4BiiLiquidationPeriodEnd(remic: Person, adopted: Date) strict {
    label en official "section 860F(a)(4)(B)(ii): the liquidation period ends at the close of the 90th day after the date of adoption";
    when remic_adopts_plan_of_complete_liquidation_860Fa4Ai(remic, adopted);
    then liquidation_period_end_860Fa4Bii(remic, adopted, add_calendar_period(adopted, 90 calendar_day));
}
pub relation qualified_liquidation_860Fa4A(remic: Person, adopted: Date) kind institutional {
    label en official "the REMIC's plan adopted on this date is a qualified liquidation";
}
@source(IRC_S860F_A, quote = "means a transaction in which—")
rule Section860Fa4AQualifiedLiquidation(remic: Person, adopted: Date) strict {
    label en official "section 860F(a)(4)(A): a plan of complete liquidation, all non-cash assets sold in the liquidation period, and all proceeds distributed by its last day";
    when remic_adopts_plan_of_complete_liquidation_860Fa4Ai(remic, adopted);
    when remic_sells_all_non_cash_assets_within_liquidation_period_860Fa4Aii(remic, adopted);
    when proceeds_credited_or_distributed_by_period_end_860Fa4Aiii(remic, adopted);
    then qualified_liquidation_860Fa4A(remic, adopted);
}
pub relation remic_in_liquidation_period_on_860Fa4B(remic: Person, adopted: Date, on: Date) kind institutional {
    label en official "the date falls in the liquidation period: it begins on the date of the adoption of the plan and ends at the close of the 90th day after it";
}
@source(IRC_S860F_A, quote = "(i) beginning on the date of the adoption of the plan of liquidation, and")
rule Section860Fa4BLiquidationPeriodContainsDate(remic: Person, adopted: Date, ends_on: Date, on: Date) strict {
    label en official "section 860F(a)(4)(B): the liquidation period begins on the date of adoption and ends on the 90th day after it";
    when liquidation_period_end_860Fa4Bii(remic, adopted, ends_on);
    when remic_date_under_review_860F(remic, on);
    when on >= adopted;
    when on <= ends_on;
    then remic_in_liquidation_period_on_860Fa4B(remic, adopted, on);
}

// ---- Section 860D(a) flush sentence: the asset test in a qualified liquidation ----

pub relation asset_test_disapplied_by_qualified_liquidation_860Da4(remic: Person, on: Date) kind institutional {
    label en official "paragraph (4) does not apply on this date: it falls in the liquidation period of a qualified liquidation";
}
@source(IRC_S860D_A, quote = "In the case of a qualified liquidation (as defined in section 860F(a)(4)(A)), paragraph (4) shall not")
rule Section860DaFlushQualifiedLiquidationDisappliesAssetTest(remic: Person, adopted: Date, on: Date) strict {
    label en official "section 860D(a) flush: in a qualified liquidation paragraph (4) does not apply during the liquidation period";
    when qualified_liquidation_860Fa4A(remic, adopted);
    when remic_in_liquidation_period_on_860Fa4B(remic, adopted, on);
    then asset_test_disapplied_by_qualified_liquidation_860Da4(remic, on);
}

// ---- Section 860F(a)(2), (5): prohibited transactions ----

pub enum ProhibitedTransactionCategory860F {
    CategoryDispositionOfQualifiedMortgage;
    CategoryIncomeFromNonqualifiedAsset;
    CategoryFeeForServices;
    CategoryGainOnCashFlowInvestment;
    label en unofficial "the category of section 860F(a)(2) a prohibited transaction falls in";
}
pub relation disposition_of_qualified_mortgage_860Fa2A(remic: Person, txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the REMIC disposes of a qualified mortgage transferred to it";
}
pub relation disposition_is_substitution_or_repurchase_of_defective_860Fa2Ai(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition is the substitution of a qualified replacement mortgage for a qualified mortgage (or the repurchase in lieu of substitution of a defective obligation)";
}
pub relation disposition_incident_to_foreclosure_default_or_imminent_default_860Fa2Aii(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition is incident to the foreclosure, default, or imminent default of the mortgage";
}
pub relation disposition_incident_to_bankruptcy_or_insolvency_860Fa2Aiii(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition is incident to the bankruptcy or insolvency of the REMIC";
}
pub relation disposition_pursuant_to_qualified_liquidation_860Fa2Aiv(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition is pursuant to a qualified liquidation";
}
pub relation disposition_required_to_prevent_default_on_regular_interest_860Fa5A(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition is required to prevent default on a regular interest where the threatened default resulted from a default on one or more qualified mortgages";
}
pub relation disposition_to_facilitate_clean_up_call_860Fa5B(txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the disposition facilitates a clean-up call (as defined in regulations)";
}
pub relation income_received_attributable_to_asset_860Fa2B(remic: Person, txn: us.irc.core::Transaction, asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the REMIC receives income attributable to the asset in the transaction";
}
pub relation receipt_of_fee_or_compensation_for_services_860Fa2C(remic: Person, txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the REMIC receives an amount representing a fee or other compensation for services";
}
pub relation gain_from_disposition_of_cash_flow_investment_860Fa2D(remic: Person, txn: us.irc.core::Transaction) kind empirical {
    label en unofficial "the REMIC has gain from the disposition of a cash flow investment";
}
pub relation prohibited_transaction_860Fa2(remic: Person, txn: us.irc.core::Transaction, category: ProhibitedTransactionCategory860F) kind institutional {
    label en official "the transaction is a prohibited transaction of the given category";
}
pub relation disposition_excepted_860Fa2A_860Fa5(txn: us.irc.core::Transaction) kind institutional {
    label en official "the disposition is within one of the exceptions of paragraph (2)(A)(i)-(iii) or paragraph (5) (helper)";
}
rule Section860Fa2AiExceptedSubstitution(txn: us.irc.core::Transaction) strict {
    label en official "helper: paragraph (2)(A)(i) exception";
    when disposition_is_substitution_or_repurchase_of_defective_860Fa2Ai(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
rule Section860Fa2AiiExceptedForeclosure(txn: us.irc.core::Transaction) strict {
    label en official "helper: paragraph (2)(A)(ii) exception";
    when disposition_incident_to_foreclosure_default_or_imminent_default_860Fa2Aii(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
rule Section860Fa2AiiiExceptedBankruptcy(txn: us.irc.core::Transaction) strict {
    label en official "helper: paragraph (2)(A)(iii) exception";
    when disposition_incident_to_bankruptcy_or_insolvency_860Fa2Aiii(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
rule Section860Fa2AivExceptedLiquidation(txn: us.irc.core::Transaction) strict {
    label en official "helper: paragraph (2)(A)(iv) exception";
    when disposition_pursuant_to_qualified_liquidation_860Fa2Aiv(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
@source(IRC_S860F_A, quote = "(A) required to prevent default on a regular interest where the threatened default resulted from a")
rule Section860Fa5AExceptedDefaultPrevention(txn: us.irc.core::Transaction) strict {
    label en official "section 860F(a)(5)(A): a disposition required to prevent default on a regular interest is not a prohibited transaction";
    when disposition_required_to_prevent_default_on_regular_interest_860Fa5A(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
@source(IRC_S860F_A, quote = "(B) to facilitate a clean-up call (as defined in regulations).")
rule Section860Fa5BExceptedCleanUpCall(txn: us.irc.core::Transaction) strict {
    label en official "section 860F(a)(5)(B): a disposition facilitating a clean-up call is not a prohibited transaction";
    when disposition_to_facilitate_clean_up_call_860Fa5B(txn);
    then disposition_excepted_860Fa2A_860Fa5(txn);
}
pub relation disposition_excepted_860Fa5_only(txn: us.irc.core::Transaction) kind institutional {
    label en official "the disposition is within paragraph (5) only (helper: paragraph (5) reaches subparagraphs (A) and (D) of paragraph (2))";
}
rule Section860Fa5OnlyDefault(txn: us.irc.core::Transaction) strict {
    label en official "helper";
    when disposition_required_to_prevent_default_on_regular_interest_860Fa5A(txn);
    then disposition_excepted_860Fa5_only(txn);
}
rule Section860Fa5OnlyCleanUp(txn: us.irc.core::Transaction) strict {
    label en official "helper";
    when disposition_to_facilitate_clean_up_call_860Fa5B(txn);
    then disposition_excepted_860Fa5_only(txn);
}
@source(IRC_S860F_A, quote = "The disposition of any qualified mortgage transferred to the REMIC other than a disposition pursuant to—")
rule Section860Fa2AProhibitedDisposition(remic: Person, txn: us.irc.core::Transaction) defeasible {
    label en official "section 860F(a)(2)(A): the disposition of a qualified mortgage, other than under the excepted cases, is a prohibited transaction";
    when disposition_of_qualified_mortgage_860Fa2A(remic, txn);
    when not_known(disposition_excepted_860Fa2A_860Fa5(txn));
    then prohibited_transaction_860Fa2(remic, txn, CategoryDispositionOfQualifiedMortgage);
}
@source(IRC_S860F_A, quote = "The receipt of any income attributable to any asset which is neither a qualified mortgage nor a")
rule Section860Fa2BProhibitedIncome(remic: Person, txn: us.irc.core::Transaction, asset: us.irc.core::Asset) defeasible {
    label en official "section 860F(a)(2)(B): income attributable to an asset that is neither a qualified mortgage nor a permitted investment is a prohibited transaction";
    when income_received_attributable_to_asset_860Fa2B(remic, txn, asset);
    when not_known(qualified_mortgage_860Ga3(asset));
    when not_known(permitted_investment_860Ga5(asset));
    then prohibited_transaction_860Fa2(remic, txn, CategoryIncomeFromNonqualifiedAsset);
}
@source(IRC_S860F_A, quote = "The receipt by the REMIC of any amount representing a fee or other compensation for services.")
rule Section860Fa2CProhibitedFee(remic: Person, txn: us.irc.core::Transaction) defeasible {
    label en official "section 860F(a)(2)(C): the receipt of a fee or other compensation for services is a prohibited transaction";
    when receipt_of_fee_or_compensation_for_services_860Fa2C(remic, txn);
    then prohibited_transaction_860Fa2(remic, txn, CategoryFeeForServices);
}
@source(IRC_S860F_A, quote = "Gain from the disposition of any cash flow investment other than pursuant to any qualified liquidation.")
rule Section860Fa2DProhibitedGain(remic: Person, txn: us.irc.core::Transaction) defeasible {
    label en official "section 860F(a)(2)(D): gain from the disposition of a cash flow investment, other than under a qualified liquidation, is a prohibited transaction";
    when gain_from_disposition_of_cash_flow_investment_860Fa2D(remic, txn);
    when not_known(disposition_pursuant_to_qualified_liquidation_860Fa2Aiv(txn));
    when not_known(disposition_excepted_860Fa5_only(txn));
    then prohibited_transaction_860Fa2(remic, txn, CategoryGainOnCashFlowInvestment);
}
pub relation transaction_is_prohibited_transaction_860Fa2(remic: Person, txn: us.irc.core::Transaction) kind institutional {
    label en official "the transaction is a prohibited transaction of some category (the chapeau of paragraph (2))";
}
@source(IRC_S860F_A, quote = "For purposes of this part, the term")
rule Section860Fa2AnyCategory(remic: Person, txn: us.irc.core::Transaction, category: ProhibitedTransactionCategory860F) defeasible {
    label en official "section 860F(a)(2): a transaction in any of the four categories is a prohibited transaction";
    when prohibited_transaction_860Fa2(remic, txn, category);
    then transaction_is_prohibited_transaction_860Fa2(remic, txn);
}
pub relation disposition_not_a_prohibited_transaction_860Fa5(txn: us.irc.core::Transaction) kind institutional {
    label en official "paragraph (5): notwithstanding subparagraphs (A) and (D) of paragraph (2), the disposition is not a prohibited transaction";
}
@source(IRC_S860F_A, quote = "Notwithstanding subparagraphs (A) and (D) of paragraph (2), the term")
rule Section860Fa5NotProhibited(txn: us.irc.core::Transaction) strict {
    label en official "section 860F(a)(5): a disposition within (A) or (B) is not a prohibited transaction";
    when disposition_excepted_860Fa5_only(txn);
    then disposition_not_a_prohibited_transaction_860Fa5(txn);
}

// ---- Section 860G(a)(5)-(8): permitted investments ----

pub relation investment_of_qualified_mortgage_receipts_pending_distribution_860Ga6(remic: Person, inv: us.irc.core::Asset) kind empirical {
    label en unofficial "an investment of amounts received under qualified mortgages for a temporary period before distribution to holders of interests in the REMIC";
}
pub relation cash_flow_investment_860Ga6(inv: us.irc.core::Asset) kind institutional {
    label en official "the investment is a cash flow investment";
}
@source(IRC_S860G_A, quote = "means any investment of amounts received under qualified mortgages for a temporary period before")
rule Section860Ga6CashFlowInvestment(remic: Person, inv: us.irc.core::Asset) strict {
    label en official "section 860G(a)(6): an investment of qualified mortgage receipts for a temporary period before distribution is a cash flow investment";
    when investment_of_qualified_mortgage_receipts_pending_distribution_860Ga6(remic, inv);
    then cash_flow_investment_860Ga6(inv);
}
pub relation intangible_property_held_for_investment_860Ga7A(asset: us.irc.core::Asset) kind empirical {
    label en unofficial "the asset is intangible property held for investment";
}
pub relation held_as_part_of_qualified_reserve_fund_860Ga7A(asset: us.irc.core::Asset, fund: us.irc.core::Asset) kind empirical {
    label en unofficial "the asset is held as part of the reserve fund";
}
pub relation reserve_provides_for_expenses_or_amounts_due_on_regular_interests_860Ga7Bi(fund: us.irc.core::Asset) kind empirical {
    label en unofficial "the reserve is reasonably required to provide for full payment of expenses of the REMIC or amounts due on regular interests in the event of defaults on qualified mortgages or lower than expected returns on cash flow investments";
}
pub relation reserve_provides_funds_for_obligation_purchases_860Ga7Bii(fund: us.irc.core::Asset) kind empirical {
    label en unofficial "the reserve is reasonably required to provide a source of funds for the purchase of obligations described in clause (ii) or (iii) of paragraph (3)(A)";
}
pub relation qualified_reserve_fund_860Ga7B(fund: us.irc.core::Asset) kind institutional {
    label en official "the reserve is a qualified reserve fund";
}
@source(IRC_S860G_A, quote = "(i) provide for full payment of expenses of the REMIC or amounts due on regular interests in the event")
rule Section860Ga7BiQualifiedReserveFundExpenses(fund: us.irc.core::Asset) strict {
    label en official "section 860G(a)(7)(B)(i): a reserve reasonably required for expenses or amounts due on regular interests is a qualified reserve fund";
    when reserve_provides_for_expenses_or_amounts_due_on_regular_interests_860Ga7Bi(fund);
    then qualified_reserve_fund_860Ga7B(fund);
}
@source(IRC_S860G_A, quote = "(ii) provide a source of funds for the purchase of obligations described in clause (ii) or (iii) of")
rule Section860Ga7BiiQualifiedReserveFundPurchases(fund: us.irc.core::Asset) strict {
    label en official "section 860G(a)(7)(B)(ii): a reserve reasonably required as a source of funds for the purchase of qualified obligations is a qualified reserve fund";
    when reserve_provides_funds_for_obligation_purchases_860Ga7Bii(fund);
    then qualified_reserve_fund_860Ga7B(fund);
}
pub relation qualified_reserve_asset_860Ga7A(asset: us.irc.core::Asset) kind institutional {
    label en official "the asset is a qualified reserve asset";
}
@source(IRC_S860G_A, quote = "means any intangible property which is held for investment and as part of a qualified reserve fund.")
rule Section860Ga7AQualifiedReserveAsset(asset: us.irc.core::Asset, fund: us.irc.core::Asset) strict {
    label en official "section 860G(a)(7)(A): intangible property held for investment and as part of a qualified reserve fund is a qualified reserve asset";
    when intangible_property_held_for_investment_860Ga7A(asset);
    when held_as_part_of_qualified_reserve_fund_860Ga7A(asset, fund);
    when qualified_reserve_fund_860Ga7B(fund);
    then qualified_reserve_asset_860Ga7A(asset);
}
pub relation would_be_foreclosure_property_856e_if_acquired_by_reit_860Ga8A(prop: us.irc.core::Asset) kind empirical {
    label en unofficial "the property would be foreclosure property under section 856(e) (without regard to paragraph (5) thereof) if acquired by a real estate investment trust";
}
pub relation would_be_foreclosure_property_disregarding_856e4_860Ga8(prop: us.irc.core::Asset) kind empirical {
    label en unofficial "the property would be foreclosure property under section 856(e) if acquired by a real estate investment trust, without regard to paragraph (4) thereof (the termination of foreclosure property status)";
}
pub relation acquired_in_connection_with_default_or_imminent_default_of_qualified_mortgage_860Ga8B(prop: us.irc.core::Asset, remic: Person) kind empirical {
    label en unofficial "the property is acquired in connection with the default or imminent default of a qualified mortgage held by the REMIC";
}
pub relation foreclosure_property_860Ga8(prop: us.irc.core::Asset) kind institutional {
    label en official "the property is foreclosure property of a REMIC";
}
@source(IRC_S860G_A, quote = "foreclosure property")
rule Section860Ga8ForeclosureProperty(prop: us.irc.core::Asset, remic: Person) strict {
    label en official "section 860G(a)(8): property that would be foreclosure property of a REIT and is acquired on a default of a qualified mortgage";
    when would_be_foreclosure_property_856e_if_acquired_by_reit_860Ga8A(prop);
    when acquired_in_connection_with_default_or_imminent_default_of_qualified_mortgage_860Ga8B(prop, remic);
    then foreclosure_property_860Ga8(prop);
}
pub relation foreclosure_property_for_860Da_860Ga8(prop: us.irc.core::Asset) kind institutional {
    label en official "the property is foreclosure property for purposes of section 860D(a), determined without regard to section 856(e)(4)";
}
@source(IRC_S860G_A, quote = "Solely for purposes of section 860D(a), the determination of whether any property is foreclosure")
rule Section860Ga8ForeclosurePropertyFor860Da(prop: us.irc.core::Asset, remic: Person) strict {
    label en official "section 860G(a)(8) flush: solely for section 860D(a) the determination is made without regard to section 856(e)(4)";
    when would_be_foreclosure_property_disregarding_856e4_860Ga8(prop);
    when acquired_in_connection_with_default_or_imminent_default_of_qualified_mortgage_860Ga8B(prop, remic);
    then foreclosure_property_for_860Da_860Ga8(prop);
}
pub relation permitted_investment_860Ga5(asset: us.irc.core::Asset) kind institutional {
    label en official "the asset is a permitted investment";
}
@source(IRC_S860G_A, quote = "(A) cash flow investment,")
rule Section860Ga5ACashFlowInvestment(asset: us.irc.core::Asset) strict {
    label en official "section 860G(a)(5)(A): a cash flow investment is a permitted investment";
    when cash_flow_investment_860Ga6(asset);
    then permitted_investment_860Ga5(asset);
}
@source(IRC_S860G_A, quote = "(B) qualified reserve asset, or")
rule Section860Ga5BQualifiedReserveAsset(asset: us.irc.core::Asset) strict {
    label en official "section 860G(a)(5)(B): a qualified reserve asset is a permitted investment";
    when qualified_reserve_asset_860Ga7A(asset);
    then permitted_investment_860Ga5(asset);
}
@source(IRC_S860G_A, quote = "(C) foreclosure property.")
rule Section860Ga5CForeclosureProperty(asset: us.irc.core::Asset) strict {
    label en official "section 860G(a)(5)(C): foreclosure property is a permitted investment";
    when foreclosure_property_860Ga8(asset);
    then permitted_investment_860Ga5(asset);
}

// ---- Section 860G(a)(3): the tenant-stockholder and government origination sentences ----

pub relation obligation_principally_secured_by_tenant_stockholder_stock_860Ga3A(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is principally secured by stock held by a person as a tenant-stockholder (section 216) in a cooperative housing corporation";
}
pub relation obligation_originated_by_government_860Ga3A(o: us.irc.core::Asset) kind empirical {
    label en unofficial "the obligation is originated by the United States or any State (or any political subdivision, agency, or instrumentality of either)";
}
@source(IRC_S860G_A, quote = "For purposes of subparagraph (A), any obligation secured by stock held by a person as a")
rule Section860Ga3ACooperativeStockIsRealProperty(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3) flush: an obligation secured by tenant-stockholder stock is treated as secured by an interest in real property";
    when obligation_principally_secured_by_tenant_stockholder_stock_860Ga3A(o);
    then obligation_principally_secured_by_real_property_860Ga3A(o);
}
rule Section860Ga3AGovernmentOriginatedIsPrincipallySecured(o: us.irc.core::Asset) strict {
    label en official "section 860G(a)(3) flush: an obligation originated by the United States or a State is treated as principally secured by an interest in real property";
    when obligation_originated_by_government_860Ga3A(o);
    then obligation_principally_secured_by_real_property_860Ga3A(o);
}

// ---- Section 860G(a)(9): the startup day ----

pub relation remic_issues_all_regular_and_residual_interests_on_860Ga9(remic: Person, on: Date) kind empirical {
    label en unofficial "the REMIC issues all of its regular and residual interests on this day";
}
pub relation issuance_period_permitted_by_regulations_860Ga9(remic: Person, start: Date, end: Date) kind empirical {
    label en unofficial "a period permitted in regulations during which all interests are issued and all transfers to the REMIC are made";
}
pub relation day_selected_by_remic_860Ga9(remic: Person, day: Date) kind empirical {
    label en unofficial "the day during the permitted period selected by the REMIC";
}
pub relation issuance_period_stated_860Ga9(remic: Person) kind institutional {
    label en official "a permitted issuance period is stated for the REMIC (helper)";
}
rule Section860Ga9PeriodStated(remic: Person, start: Date, end: Date) strict {
    label en official "helper";
    when issuance_period_permitted_by_regulations_860Ga9(remic, start, end);
    then issuance_period_stated_860Ga9(remic);
}
pub relation startup_day_860Ga9(remic: Person, day: Date) kind institutional {
    label en official "the startup day of the REMIC";
}
@source(IRC_S860G_A, quote = "means the day on which the REMIC issues all of its regular and residual interests. To the extent")
rule Section860Ga9StartupDayIssuance(remic: Person, on: Date) defeasible {
    label en official "section 860G(a)(9): the startup day is the day on which the REMIC issues all its regular and residual interests";
    when remic_issues_all_regular_and_residual_interests_on_860Ga9(remic, on);
    when not_known(issuance_period_stated_860Ga9(remic));
    then startup_day_860Ga9(remic, on);
}
rule Section860Ga9StartupDaySelected(remic: Person, start: Date, end: Date, selected: Date) defeasible {
    label en official "section 860G(a)(9): interests issued during a permitted period of at most 10 days are treated as issued on the day selected by the REMIC (both end days counted: JUDGMENT CALL)";
    when issuance_period_permitted_by_regulations_860Ga9(remic, start, end);
    when day_selected_by_remic_860Ga9(remic, selected);
    when selected >= start;
    when selected <= end;
    when end <= add_calendar_period(start, 9 calendar_day);
    then startup_day_860Ga9(remic, selected);
}

// ---- Section 860D(b)(2): termination and inadvertent termination ----

pub relation ceases_to_be_remic_during_year_860Db2A(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity ceases to be a REMIC at some time during the taxable year";
}
pub relation entity_agrees_to_required_adjustments_860Db2Biv(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity agrees to make the adjustments (consistent with its treatment as a REMIC or a C corporation) required by the Secretary for the period";
}
pub relation holder_of_interest_during_period_860Db2Biv(c: Person, y: TaxableYear, holder: Person) kind empirical {
    label en unofficial "the person held an interest in the entity at some time during the period specified pursuant to the subsection";
}
pub relation holder_agrees_to_required_adjustments_860Db2Biv(c: Person, y: TaxableYear, holder: Person) kind empirical {
    label en unofficial "the holder agrees to make the adjustments required by the Secretary for the period";
}
pub relation holder_has_not_agreed_860Db2Biv(c: Person, y: TaxableYear) kind institutional {
    label en official "some person who held an interest during the period has not agreed to the adjustments (helper)";
}
rule Section860Db2BivHolderNotAgreed(c: Person, y: TaxableYear, holder: Person) defeasible {
    label en official "helper: a holder that has not agreed";
    when holder_of_interest_during_period_860Db2Biv(c, y, holder);
    when not_known(holder_agrees_to_required_adjustments_860Db2Biv(c, y, holder));
    then holder_has_not_agreed_860Db2Biv(c, y);
}
external judgment relation secretary_determines_cessation_inadvertent_860Db2Bii(c: Person, y: TaxableYear) {
    authority Secretary;
    label en official "the Secretary determines that the cessation was inadvertent (section 860D(b)(2)(B)(ii)); an evaluative element, DECISION-0194 channel 1";
}
external judgment relation steps_taken_within_reasonable_time_to_be_remic_again_860Db2Biii(c: Person, y: TaxableYear) {
    authority Secretary;
    label en official "no later than a reasonable time after the discovery of the event resulting in the cessation, steps are taken so that the entity is once more a REMIC (section 860D(b)(2)(B)(iii)); an evaluative element, DECISION-0194 channel 1";
}
pub relation treated_as_continuing_remic_860Db2B(c: Person, y: TaxableYear) kind institutional {
    label en official "notwithstanding the terminating event, the entity is treated as continuing to be a REMIC (or the cessation is disregarded)";
}
@source(IRC_S860D_B, quote = "then, notwithstanding such terminating event, such entity shall be treated as continuing to be a REMIC")
rule Section860Db2BInadvertentTermination(c: Person, y: TaxableYear) defeasible {
    label en official "section 860D(b)(2)(B): a cessation the Secretary finds inadvertent, cured within a reasonable time, with the agreements of the entity and each holder, is disregarded";
    when ceases_to_be_remic_during_year_860Db2A(c, y);
    when secretary_determines_cessation_inadvertent_860Db2Bii(c, y);
    when steps_taken_within_reasonable_time_to_be_remic_again_860Db2Biii(c, y);
    when entity_agrees_to_required_adjustments_860Db2Biv(c, y);
    when not_known(holder_has_not_agreed_860Db2Biv(c, y));
    then treated_as_continuing_remic_860Db2B(c, y);
}
pub relation entity_not_treated_as_remic_after_cessation_860Db2A(c: Person, y: TaxableYear) kind institutional {
    label en official "the entity is not treated as a REMIC for the taxable year of cessation or any succeeding taxable year";
}
@source(IRC_S860D_B, quote = "If any entity ceases to be a REMIC at any time during the taxable year, such entity shall not be treated")
rule Section860Db2ACessationEndsRemicStatus(c: Person, y: TaxableYear, ceased_in: TaxableYear, ceased_begins: Date, begins: Date) defeasible {
    label en official "section 860D(b)(2)(A): an entity that ceases to be a REMIC is not a REMIC for that taxable year or any succeeding taxable year";
    when ceases_to_be_remic_during_year_860Db2A(c, ceased_in);
    when us.irc.core::begins(ceased_in, ceased_begins);
    when us.irc.core::begins(y, begins);
    when begins >= ceased_begins;
    when not_known(treated_as_continuing_remic_860Db2B(c, ceased_in));
    then entity_not_treated_as_remic_after_cessation_860Db2A(c, y);
}
pub relation remic_status_in_effect_860Db2(c: Person, y: TaxableYear) kind institutional {
    label en official "the entity is a REMIC for the taxable year after the termination rules of section 860D(b)(2)";
}
rule Section860Db2StatusAfterTermination(c: Person, y: TaxableYear) defeasible {
    label en official "section 860D(b)(2): a REMIC whose status is not ended by a cessation stays a REMIC";
    when treated_as_remic_860d(c, y);
    when not_known(entity_not_treated_as_remic_after_cessation_860Db2A(c, y));
    then remic_status_in_effect_860Db2(c, y);
}

// ---- Section 860E(c): the adjusted issue price and the no-significant-value rule ----

pub relation issue_price_adjusted_for_contributions_860Ec2B(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the issue price of the residual interest, adjusted for contributions";
}
pub relation prior_quarter_daily_accruals_total_860Ec2Bi(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total of the daily accruals for prior quarters (an asserted total: the per-quarter sum over derived accruals is the section 111 limit, G4903)";
}
pub relation distributions_before_quarter_860Ec2Bii(holder: Person, remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total of the distributions made with respect to the interest before the beginning of the quarter";
}
@source(IRC_S860E_C, quote = "For purposes of this paragraph, the adjusted issue price of any residual interest at the beginning of")
rule Section860Ec2BAdjustedIssuePrice(holder: Person, remic: Person, q: TaxableYear, price: Money, accruals: Money, distributions: Money) strict {
    label en official "section 860E(c)(2)(B): the adjusted issue price at the start of the quarter is the issue price (adjusted for contributions) plus prior accruals, less prior distributions, but not below zero";
    when issue_price_adjusted_for_contributions_860Ec2B(holder, remic, q, price);
    when prior_quarter_daily_accruals_total_860Ec2Bi(holder, remic, q, accruals);
    when distributions_before_quarter_860Ec2Bii(holder, remic, q, distributions);
    when price + accruals > distributions;
    then adjusted_issue_price_beginning_of_quarter_860e2B(holder, remic, q, (price + accruals) - distributions);
}
@source(IRC_S860E_C, quote = "(ii) decreased (but not below zero) by any distribution made with respect to such interest before the")
rule Section860Ec2BAdjustedIssuePriceFloor(holder: Person, remic: Person, q: TaxableYear, price: Money, accruals: Money, distributions: Money) strict {
    label en official "section 860E(c)(2)(B)(ii): the decrease by distributions does not go below zero";
    when issue_price_adjusted_for_contributions_860Ec2B(holder, remic, q, price);
    when prior_quarter_daily_accruals_total_860Ec2Bi(holder, remic, q, accruals);
    when distributions_before_quarter_860Ec2Bii(holder, remic, q, distributions);
    when price + accruals <= distributions;
    then adjusted_issue_price_beginning_of_quarter_860e2B(holder, remic, q, 0.00 USD);
}
pub relation residual_interest_without_significant_value_860Ec1(holder: Person, remic: Person, q: TaxableYear) kind empirical {
    label en unofficial "to the extent provided in regulations, the residual interest does not have significant value";
}
@source(IRC_S860E_C, quote = "To the extent provided in regulations, if residual interests in a REMIC do not have significant value,")
rule Section860Ec1NoSignificantValueExcessInclusion(holder: Person, remic: Person, q: TaxableYear, taken_into_account: Money) defeasible {
    label en official "section 860E(c)(1) last sentence: for an interest without significant value the excess inclusion is the section 860C(a) amount, without the daily accruals subtraction";
    when residual_interest_without_significant_value_860Ec1(holder, remic, q);
    when amount_taken_into_account_860c_a(holder, remic, q, taken_into_account);
    when taken_into_account > 0.00 USD;
    then excess_inclusion(holder, remic, q, taken_into_account);
}

// ---- Section 860E(a)(4)(A), (C): alternative minimum tax coordination ----

pub relation taxable_income_for_alternative_tax_reference_860Ea4A(holder: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income to which the reference in section 55(b)(1)(D) is read: taxable income determined without regard to the excess inclusion floor";
}
@source(IRC_S860E_A, quote = "(A) the reference in section 55(b)(1)(D) to taxable income shall be treated as a reference to taxable")
rule Section860Ea4ATaxableIncomeWithoutFloor(holder: Person, y: TaxableYear, income: Money) strict {
    label en official "section 860E(a)(4)(A): the reference in section 55(b)(1)(D) to taxable income is a reference to taxable income determined without regard to the floor";
    when holder_taxable_income_before_floor_860Ea1(holder, y, income);
    then taxable_income_for_alternative_tax_reference_860Ea4A(holder, y, income);
}
pub relation excess_inclusion_disregarded_for_alternative_tax_nol_860Ea4C(holder: Person, y: TaxableYear) kind institutional {
    label en official "the excess inclusion is disregarded in computing the alternative tax net operating loss deduction";
}
@source(IRC_S860E_A, quote = "(C) any excess inclusion shall be disregarded for purposes of computing the alternative tax net")
rule Section860Ea4CExcessInclusionNotInAlternativeTaxNol(holder: Person, y: TaxableYear, excess: Money) strict {
    label en official "section 860E(a)(4)(C): an excess inclusion is disregarded in computing the alternative tax net operating loss deduction";
    when holder_excess_inclusion_for_year_860Ea1(holder, y, excess);
    then excess_inclusion_disregarded_for_alternative_tax_nol_860Ea4C(holder, y);
}

// ---- Section 860E(d) last sentence: similar rules for other entities ----

pub relation common_trust_fund_or_subchapter_T_organization_860Ed(ent: Person) kind empirical {
    label en unofficial "the entity is a common trust fund or an organization to which part I of subchapter T applies";
}
pub relation regulated_investment_company_entity_860Ed(ent: Person) kind empirical {
    label en unofficial "the entity is a regulated investment company";
}
pub relation similar_entity_for_860Ed_allocation(ent: Person) kind institutional {
    label en official "the entity is one to which rules similar to those of the preceding sentence apply (a regulated investment company, a common trust fund, or a subchapter T organization)";
}
@source(IRC_S860E_D, quote = "Rules similar to the rules of the preceding sentence shall apply also in the case of regulated")
rule Section860EdSimilarRulesRic(ent: Person) strict {
    label en official "section 860E(d) last sentence: rules similar to the REIT allocation apply to a regulated investment company";
    when regulated_investment_company_entity_860Ed(ent);
    then similar_entity_for_860Ed_allocation(ent);
}
rule Section860EdSimilarRulesCommonTrustFund(ent: Person) strict {
    label en official "section 860E(d) last sentence: rules similar to the REIT allocation apply to a common trust fund or a subchapter T organization";
    when common_trust_fund_or_subchapter_T_organization_860Ed(ent);
    then similar_entity_for_860Ed_allocation(ent);
}
pub relation excess_inclusion_allocated_to_shareholder_of_similar_entity_860Ed(sh: Person, ent: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder's allocation from a regulated investment company, common trust fund or subchapter T organization, by dividends received (the allocation of the REIT sentence applied by analogy)";
}
rule Section860EdAllocationSimilarEntity(sh: Person, ent: Person, y: TaxableYear, aggregate: Money, income: Money, received: Money, total: Money) strict {
    label en official "section 860E(d) last sentence: the excess of aggregate excess inclusions over taxable income is allocated by dividends received among the shareholders of a similar entity";
    when similar_entity_for_860Ed_allocation(ent);
    when reit_or_ric_residual_aggregate_excess_inclusions_860Ed1A(ent, y, aggregate);
    when reit_taxable_income_excluding_net_capital_gain_860Ed1B(ent, y, income);
    when dividends_received_from_entity_860Ed1(sh, ent, y, received);
    when total_dividends_paid_by_entity_860Ed1(ent, y, total);
    when aggregate > income;
    when total > 0.00 USD;
    then excess_inclusion_allocated_to_shareholder_of_similar_entity_860Ed(sh, ent, y, div_round((aggregate - income) * (received / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 860F(b)(1)(C)(i), (D)(i): regular interests ----

pub relation days_held_by_transferor_in_year_860Fb1(interest: us.irc.core::Asset, y: TaxableYear, days: Decimal) kind empirical {
    label en unofficial "the days in the taxable year during which the regular interest is held by the transferor (or a person whose basis is determined by reference to the transferor's)";
}
pub relation days_from_acquisition_to_maturity_860Fb1(interest: us.irc.core::Asset, days: Decimal) kind empirical {
    label en unofficial "the days from the acquisition of the regular interest to its maturity (the straight-line denominator of the rules similar to sections 1276(b) and 171)";
}
pub relation regular_interest_860Fb1(interest: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest received in the transfer is a regular interest";
}
pub relation regular_issue_price_excess_ratable_inclusion_860Fb1Ci(transferor: Person, interest: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a regular interest whose issue price exceeds its basis, the part of the excess included in gross income for the year (straight-line reading of section 1276(b): JUDGMENT CALL, G5300)";
}
@source(IRC_S860F_B, quote = "(i) in the case of a regular interest, such excess shall be included in gross income (as determined")
rule Section860Fb1CiRegularIssuePriceExcess(transferor: Person, interest: us.irc.core::Asset, y: TaxableYear, price: Money, basis: Money, held: Decimal, total: Decimal) strict {
    label en official "section 860F(b)(1)(C)(i): the excess of issue price over basis of a regular interest is included ratably by days held (cents HALF_UP)";
    when regular_interest_860Fb1(interest);
    when issue_price_of_interest_860Fb1C(interest, price);
    when adjusted_basis_of_interest_received_860Fb1B(transferor, interest, basis);
    when days_held_by_transferor_in_year_860Fb1(interest, y, held);
    when days_from_acquisition_to_maturity_860Fb1(interest, total);
    when price > basis;
    when total > 0.0;
    then regular_issue_price_excess_ratable_inclusion_860Fb1Ci(transferor, interest, y, div_round((price - basis) * held, total, 2, "HALF_UP"));
}
pub relation regular_basis_excess_ratable_deduction_860Fb1Di(transferor: Person, interest: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "for a regular interest whose basis exceeds its issue price, the part of the excess allowable as a deduction for the year (straight-line reading of section 171: JUDGMENT CALL, G5300)";
}
@source(IRC_S860F_B, quote = "(i) in the case of a regular interest, such excess shall be allowable as a deduction under rules similar")
rule Section860Fb1DiRegularBasisExcess(transferor: Person, interest: us.irc.core::Asset, y: TaxableYear, price: Money, basis: Money, held: Decimal, total: Decimal) strict {
    label en official "section 860F(b)(1)(D)(i): the excess of basis over issue price of a regular interest is deducted ratably by days held (cents HALF_UP)";
    when regular_interest_860Fb1(interest);
    when issue_price_of_interest_860Fb1C(interest, price);
    when adjusted_basis_of_interest_received_860Fb1B(transferor, interest, basis);
    when days_held_by_transferor_in_year_860Fb1(interest, y, held);
    when days_from_acquisition_to_maturity_860Fb1(interest, total);
    when basis > price;
    when total > 0.0;
    then regular_basis_excess_ratable_deduction_860Fb1Di(transferor, interest, y, div_round((basis - price) * held, total, 2, "HALF_UP"));
}

// ---- Section 860F(d)(2)(A): substantially identical securities ----

pub relation taxable_mortgage_pool_interest_comparable_to_residual_860Fd2A(x: us.irc.core::Asset) kind empirical {
    label en unofficial "the interest in a taxable mortgage pool (section 7701(i)) is comparable to a residual interest in a REMIC";
}
pub relation regulations_provide_otherwise_860Fd2A(x: us.irc.core::Asset) kind empirical {
    label en unofficial "regulations provide that the interest is not treated as substantially identical";
}
pub relation residual_or_comparable_interest_860Fd2A(x: us.irc.core::Asset) kind institutional {
    label en official "the interest is a residual interest in a REMIC or a comparable interest in a taxable mortgage pool (helper)";
}
rule Section860Fd2AResidualIsCandidate(x: us.irc.core::Asset) strict {
    label en official "helper: a residual interest in a REMIC";
    when residual_interest_860Fd(x);
    then residual_or_comparable_interest_860Fd2A(x);
}
rule Section860Fd2ATmpIsCandidate(x: us.irc.core::Asset) strict {
    label en official "helper: a comparable taxable mortgage pool interest";
    when taxable_mortgage_pool_interest_comparable_to_residual_860Fd2A(x);
    then residual_or_comparable_interest_860Fd2A(x);
}
pub relation substantially_identical_securities_860Fd2A(a: us.irc.core::Asset, b: us.irc.core::Asset) kind institutional {
    label en official "for the section 1091 loss on a residual interest, the two interests are treated as substantially identical stock or securities";
}
@source(IRC_S860F_D, quote = "(A) except as provided in regulations, any residual interest in any REMIC and any interest in a taxable")
rule Section860Fd2ASubstantiallyIdentical(a: us.irc.core::Asset, b: us.irc.core::Asset) defeasible {
    label en official "section 860F(d)(2)(A): any residual interest in any REMIC and any comparable taxable mortgage pool interest are treated as substantially identical securities, except as provided in regulations";
    when residual_or_comparable_interest_860Fd2A(a);
    when residual_or_comparable_interest_860Fd2A(b);
    when not_known(regulations_provide_otherwise_860Fd2A(a));
    when not_known(regulations_provide_otherwise_860Fd2A(b));
    then substantially_identical_securities_860Fd2A(a, b);
}

// ---- Section 860C(b)(1): the REMIC's taxable income ----

pub relation gross_income_allocable_to_prohibited_transactions_860Cb1C(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the items of income and gain allocable to a prohibited transaction in the quarter";
}
pub relation deductions_allocable_to_prohibited_transactions_860Cb1C(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the items of loss and deduction allocable to a prohibited transaction in the quarter";
}
pub relation deductions_referred_to_in_703a2_other_than_212_860Cb1D(remic: Person, q: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deductions referred to in section 703(a)(2) (other than any deduction under section 212) included in the allowable deductions";
}
pub relation remic_taxable_income_computed_860Cb1(remic: Person, q: TaxableYear, amount: Money) kind institutional {
    label en official "the taxable income of the REMIC for the quarter under section 860C(b)(1), accrual method, without prohibited-transaction items and without the section 703(a)(2) deductions";
}
@source(IRC_S860C_B, quote = "The taxable income of a REMIC shall be determined under an accrual method of accounting and, except as")
rule Section860Cb1TaxableIncomeComputed(remic: Person, q: TaxableYear, gross: Money, prohibited_gross: Money, deductions: Money, prohibited_deductions: Money, disallowed: Money) strict {
    label en official "section 860C(b)(1)(C)-(D): gross income and deductions without prohibited-transaction items, and without the section 703(a)(2) deductions; positive results only";
    when remic_gross_income_860Cb2(remic, q, gross);
    when gross_income_allocable_to_prohibited_transactions_860Cb1C(remic, q, prohibited_gross);
    when remic_allowable_deductions_860Cb2(remic, q, deductions);
    when deductions_allocable_to_prohibited_transactions_860Cb1C(remic, q, prohibited_deductions);
    when deductions_referred_to_in_703a2_other_than_212_860Cb1D(remic, q, disallowed);
    when gross - prohibited_gross >= (deductions - prohibited_deductions) - disallowed;
    then remic_taxable_income_computed_860Cb1(remic, q, (gross - prohibited_gross) - ((deductions - prohibited_deductions) - disallowed));
}
pub relation regular_interest_treated_as_indebtedness_860Cb1A(i: us.irc.core::Asset) kind institutional {
    label en official "the regular interest is treated as indebtedness of the REMIC (when not otherwise a debt instrument)";
}
@source(IRC_S860C_B, quote = "(A) regular interests in such REMIC (if not otherwise debt instruments) shall be treated as indebtedness")
rule Section860Cb1ARegularInterestIsIndebtedness(i: us.irc.core::Asset) strict {
    label en official "section 860C(b)(1)(A): regular interests in the REMIC are treated as indebtedness of the REMIC";
    when regular_interest_860Ga1(i);
    then regular_interest_treated_as_indebtedness_860Cb1A(i);
}
pub relation market_discount_on_bond_860Cb1B(remic: Person, bond: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the market discount on the market discount bond held by the REMIC";
}
pub relation days_in_year_attributable_1276b2_860Cb1B(bond: us.irc.core::Asset, y: TaxableYear, days: Decimal) kind empirical {
    label en unofficial "the days of the taxable year to which the market discount is attributable under section 1276(b)(2)";
}
pub relation days_to_maturity_from_acquisition_1276b2_860Cb1B(bond: us.irc.core::Asset, days: Decimal) kind empirical {
    label en unofficial "the days from acquisition to maturity (the straight-line denominator: constant-yield election not represented, G5300)";
}
pub relation market_discount_included_in_year_860Cb1B(remic: Person, bond: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the market discount included in the REMIC's gross income for the taxable year to which it is attributable";
}
@source(IRC_S860C_B, quote = "(B) market discount on any market discount bond shall be included in gross income for the taxable years")
rule Section860Cb1BMarketDiscountIncluded(remic: Person, bond: us.irc.core::Asset, y: TaxableYear, discount: Money, days: Decimal, total: Decimal) strict {
    label en official "section 860C(b)(1)(B): market discount is included for the years to which it is attributable (sections 1276(a) and 1277 do not apply); straight-line, cents HALF_UP";
    when market_discount_on_bond_860Cb1B(remic, bond, discount);
    when days_in_year_attributable_1276b2_860Cb1B(bond, y, days);
    when days_to_maturity_from_acquisition_1276b2_860Cb1B(bond, total);
    when total > 0.0;
    then market_discount_included_in_year_860Cb1B(remic, bond, y, div_round(discount * days, total, 2, "HALF_UP"));
}

// ---- Section 860A(b): income taxable to the holders ----

pub relation remic_income_taxable_to_holder_860Ab(holder: Person, remic: Person, q: TaxableYear) kind institutional {
    label en official "the income of the REMIC is taxable to the holder of a residual interest as provided in this part";
}
@source(IRC_S860A_B, quote = "The income of any REMIC shall be taxable to the holders of interests in such REMIC as provided in this")
rule Section860AbIncomeTaxableToHolders(holder: Person, remic: Person, q: TaxableYear) strict {
    label en official "section 860A(b): the income of the REMIC is taxable to the holders of interests as provided in part IV (through section 860C for residual interests)";
    when amount_taken_into_account_by_residual_holder_860Ce1(holder, remic, q);
    then remic_income_taxable_to_holder_860Ab(holder, remic, q);
}
