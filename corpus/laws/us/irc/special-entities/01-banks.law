// Sections 581 (definition of bank, for purposes of sections 582 and 584)
// and 585(a)-(c)(1)-(2) (reserve for bad debts of banks: the deduction, the
// section 585 "bank" test, the experience method, and the $500,000,000
// large-bank gate). Stage 1 (IRC-09 stage 1, A12), priority sections.
//
// METHOD: section 581's three qualitative tests (incorporation and doing
// business as a bank or trust company under U.S./State law; a substantial
// part of the business consisting of deposits/loans or of fiduciary powers
// comparable to a national bank's; supervision by a State or Federal banking
// authority) are asserted CASE FACTS — "substantial part of the business"
// and "similar to those permitted to national banks" are evaluative
// readings a case supplies, not arithmetic guards this package computes
// (DECISION-0194: no authority is named in the text for this judgment, so
// this package models it as an ordinary classification premise the case
// asserts, not as an `external judgment relation` with a named authority).
// Section 585(a)(2) restates "bank" for section 585's own purposes,
// including foreign corporations whose U.S. banking-business loans qualify
// — a narrower predicate than section 581's, built from it.
//
// Section 585(a)(1)'s deduction is "in lieu of" section 166(a) (not modeled
// here — deductions/166 is a different owner) and is capped, not fixed, by
// the section 585(b)(2) experience-method amount; section 585(c)(1)-(2)'s
// $500,000,000 large-bank test is the gate on section 585(a) the pinned
// text cross-references directly ("[e]xcept as provided in subsection (c)")
// — included here as a priority-adjacent, single-paragraph classification,
// even though it is not separately named in the stage's priority list,
// because section 585(a) cannot be modeled as an executable `unless` guard
// without it.

use self::{
    IRC_S581,
    IRC_S585_A,
    IRC_S585_B,
    IRC_S585_C,
    Person,
    TaxableYear,
};

@source(IRC_S581, quote = "the term \"bank\" means a bank or trust company incorporated and doing business under the laws of the United States (including laws relating to the District of Columbia) or of any State, a substantial part of the business of which consists of receiving deposits and making loans and discounts, or of exercising fiduciary powers similar to those permitted to national banks under authority of the Comptroller of the Currency, and which is subject by law to supervision and examination by State or Federal authority having supervision over banking institutions")
pub relation incorporated_as_bank_or_trust_company(p: Person) kind empirical {
    label en unofficial "incorporated and doing business as a bank or trust company under the laws of the United States (including the District of Columbia) or of any State";
}
@source(IRC_S581, quote = "a substantial part of the business of which consists of receiving deposits and making loans and discounts, or of exercising fiduciary powers similar to those permitted to national banks under authority of the Comptroller of the Currency")
pub relation substantial_banking_or_fiduciary_business(p: Person) kind empirical {
    label en unofficial "a substantial part of the person's business consists of receiving deposits and making loans and discounts, or of exercising fiduciary powers similar to those permitted to national banks";
}
@source(IRC_S581, quote = "subject by law to supervision and examination by State or Federal authority having supervision over banking institutions")
pub relation subject_to_banking_supervision(p: Person) kind empirical {
    label en unofficial "subject by law to supervision and examination by a State or Federal authority having supervision over banking institutions";
}
@source(IRC_S581, quote = "Such term also means a domestic building and loan association.")
pub relation bank_is_domestic_building_and_loan_association_581(p: Person) kind empirical {
    label en unofficial "a domestic building and loan association";
}

@source(IRC_S581, quote = "For purposes of sections 582 and 584, the term \"bank\" means a bank or trust company incorporated and doing business under the laws of the United States (including laws relating to the District of Columbia) or of any State, a substantial part of the business of which consists of receiving deposits and making loans and discounts, or of exercising fiduciary powers similar to those permitted to national banks under authority of the Comptroller of the Currency, and which is subject by law to supervision and examination by State or Federal authority having supervision over banking institutions.")
pub relation bank(p: Person) kind institutional {
    label en official "a bank within the meaning of section 581, for purposes of sections 582 and 584";
}
rule Section581BankByCharterAndBusiness(p: Person) strict {
    label en official "section 581: a person is a bank if incorporated and doing business as a bank or trust company, a substantial part of whose business is deposits/loans or comparable fiduciary powers, and which is subject to banking supervision";
    when incorporated_as_bank_or_trust_company(p);
    when substantial_banking_or_fiduciary_business(p);
    when subject_to_banking_supervision(p);
    then bank(p);
}
@source(IRC_S581, quote = "Such term also means a domestic building and loan association.")
rule Section581BankByBuildingAndLoanAssociation(p: Person) strict {
    label en official "section 581: a domestic building and loan association is also a bank";
    when bank_is_domestic_building_and_loan_association_581(p);
    then bank(p);
}

// Section 585(a)(2): "bank", for purposes of section 585, includes a
// foreign corporation that would meet section 581 but for being foreign,
// limited to its U.S.-connected banking-business loans.
@source(IRC_S585_A, quote = "The term \"bank\" also includes any corporation to which subparagraph (A) would apply except for the fact that it is a foreign corporation. In the case of any such foreign corporation, this section shall apply only with respect to loans outstanding the interest on which is effectively connected with the conduct of a banking business within the United States.")
pub relation would_be_bank_but_for_foreign_status(p: Person) kind empirical {
    label en unofficial "would meet section 581's bank test but for being a foreign corporation";
}
@source(IRC_S585_A, quote = "loans outstanding the interest on which is effectively connected with the conduct of a banking business within the United States")
pub relation loan_effectively_connected_with_us_banking_business(p: Person, loan: us.irc.core::Asset) kind empirical {
    label en unofficial "a loan of the foreign corporation whose interest is effectively connected with the conduct of a banking business within the United States";
}
@source(IRC_S585_A, quote = "For purposes of this section—\n(A) In general\nThe term \"bank\" means any bank (as defined in section 581).")
pub relation bank_for_section_585(p: Person) kind institutional {
    label en official "a \"bank\" for purposes of section 585, per section 585(a)(2)";
}
rule Section585ABankIsSection581Bank(p: Person) strict {
    label en official "section 585(a)(2)(A): a section 581 bank is a bank for purposes of section 585";
    when bank(p);
    then bank_for_section_585(p);
}
rule Section585ABankIncludesQualifyingForeignCorporation(p: Person) strict {
    label en official "section 585(a)(2)(B): a foreign corporation that would meet section 581 but for its foreign status is a bank for purposes of section 585, as to its U.S.-connected banking loans";
    when would_be_bank_but_for_foreign_status(p);
    then bank_for_section_585(p);
}

// Section 585(c)(1)-(2): the $500,000,000 large-bank gate. (c)(3)-(4)
// (4-year spread of adjustments on disqualification, financially-troubled
// suspension) are NOT modeled at this stage — self-recursive multi-year
// recapture ledgers of this shape are the TECH-GAPS.md class already
// recorded for other packages' day-by-day/year-by-year ledgers
// (AGENT-BRIEF "Compiler traps": self-recursive arithmetic is LDC-E4102);
// filed as G100 below rather than hidden.
@source(IRC_S585_C, quote = "the average adjusted bases of all assets of such bank exceeded $500,000,000")
pub relation average_adjusted_bases_of_bank_assets(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the average adjusted bases of all assets of the bank for the taxable year (or a preceding taxable year beginning after December 31, 1986)";
}
@source(IRC_S585_C, quote = "such bank was a member of a parent-subsidiary controlled group and the average adjusted bases of all assets of such group exceeded $500,000,000")
pub relation average_adjusted_bases_of_controlled_group_assets(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the average adjusted bases of all assets of the parent-subsidiary controlled group of which the bank is a member, for the taxable year";
}
@source(IRC_S585_C, quote = "a bank is a large bank if, for the taxable year (or for any preceding taxable year beginning after December 31, 1986)—\n(A) the average adjusted bases of all assets of such bank exceeded $500,000,000, or\n(B) such bank was a member of a parent-subsidiary controlled group and the average adjusted bases of all assets of such group exceeded $500,000,000")
pub relation large_bank(b: Person, y: TaxableYear) kind institutional {
    label en official "a large bank for purposes of section 585(c), for the taxable year";
}
rule Section585c2ALargeBankByOwnAssets(b: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 585(c)(2)(A): a bank whose own average adjusted asset bases exceed $500,000,000 is a large bank";
    when average_adjusted_bases_of_bank_assets(b, y, amount);
    when amount > 500000000.00 USD;
    then large_bank(b, y);
}
rule Section585c2BLargeBankByControlledGroupAssets(b: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 585(c)(2)(B): a bank in a parent-subsidiary controlled group whose average adjusted asset bases exceed $500,000,000 is a large bank";
    when average_adjusted_bases_of_controlled_group_assets(b, y, amount);
    when amount > 500000000.00 USD;
    then large_bank(b, y);
}

// Section 585(a)(1): the reserve deduction itself, gated by section 585(c).
@source(IRC_S585_A, quote = "Except as provided in subsection (c), a bank shall be allowed a deduction for a reasonable addition to a reserve for bad debts. Such deduction shall be in lieu of any deduction under section 166(a).")
pub relation bad_debt_reserve_addition_claimed(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the addition to the reserve for bad debts the bank determines and claims for the taxable year, before the section 585(b) cap";
}
@source(IRC_S585_B, quote = "the reasonable addition to the reserve for bad debts of any financial institution to which this section applies shall be an amount determined by the taxpayer which shall not exceed the addition to the reserve for losses on loans determined under the experience method as provided in paragraph (2)")
pub relation experience_method_addition(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the addition to the reserve for losses on loans determined under the section 585(b)(2) experience method, for the taxable year: the greater of the branch (A) 6-year ratio amount or the branch (B) base-year amount (STAGE 2b, closes TECH-GAPS.md G100's branch (A) numeric gap; kept `institutional` rather than `empirical` so a case may still assert it directly where the raw branch facts are not available, per the existing cross-package convention of asserting an institutional relation as a case fact — see e.g. `regulated_investment_company` in tests/s860-deficiency-dividends.lawtest)";
}
@source(IRC_S585_A, quote = "a bank shall be allowed a deduction for a reasonable addition to a reserve for bad debts")
pub relation reasonable_addition_to_bad_debt_reserve(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reasonable addition to the reserve for bad debts allowed as a deduction under section 585(a)(1), for the taxable year";
}
rule Section585a1DeductionAllowedWithinExperienceMethodCap(b: Person, y: TaxableYear, claimed: Money, cap: Money) defeasible {
    label en official "section 585(a)(1)-(b)(1): a bank (not a large bank under (c)) is allowed a deduction for its claimed addition to the bad debt reserve, up to the section 585(b)(2) experience-method cap";
    when bank_for_section_585(b);
    when bad_debt_reserve_addition_claimed(b, y, claimed);
    when experience_method_addition(b, y, cap);
    when claimed <= cap;
    when not_known(large_bank(b, y));
    then reasonable_addition_to_bad_debt_reserve(b, y, claimed);
}

// Section 585(b)(2)(A): the ratio-of-6-years branch of the experience
// method. Branch (B) (the "base year" comparison — "the last taxable year
// before the most recent adoption of the experience method", or 1987 for
// years beginning after 1987) needs a bank-specific adoption-history fact
// this package does not track; the statute takes the GREATER of (A) and
// (B), so a bank whose (B) amount would exceed (A) is under-computed here.
// Recorded as TECH-GAPS.md G100 rather than silently computing only (A).
@source(IRC_S585_B, quote = "the total bad debts sustained during the taxable year and the 5 preceding taxable years (or, with the approval of the Secretary, a shorter period), adjusted for recoveries of bad debts during such period")
pub relation bad_debts_sustained_6_year_period(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "total bad debts sustained during the taxable year and the 5 preceding taxable years, adjusted for recoveries, per section 585(b)(2)(A)(i)";
}
@source(IRC_S585_B, quote = "the sum of the loans outstanding at the close of such 6 or fewer taxable years")
pub relation loans_outstanding_6_year_sum(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the loans outstanding at the close of each of the 6 (or fewer) taxable years, per section 585(b)(2)(A)(ii)";
}
@source(IRC_S585_B, quote = "loans outstanding at the close of the taxable year")
pub relation loans_outstanding_close_of_year(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "loans outstanding at the close of the taxable year";
}
// Section 585(b)(2)(A) is ONE proportion with ONE rounding: loans at close
// of year times 6-year bad debts, divided by 6-year loans. Written as
// `div_round(loans_close * (bad_debts / 1.00 USD), loans_6yr / 1.00 USD, …)`:
// each `Money / 1.00 USD` is an exact Decimal (§58, errata E-0083 — the
// quotient's denominator is 1), `Money * Decimal` is exact (E-0085), and
// `div_round` divides and rounds once (E-0036). The former form rounded the
// ratio to 6 places first (`round(loans_close * div_round(bad_debts,
// loans_6yr, 6, …), 2, …)`) and gave 999999 USD instead of 1000000 USD on
// 3000000 / 3000000 / 9000000. JUDGMENT CALL: cents HALF_UP — the statute
// names no rounding (TECH-GAPS G100).
@source(IRC_S585_B, quote = "the amount which bears the same ratio to loans outstanding at the close of the taxable year as (i) the total bad debts sustained during the taxable year and the 5 preceding taxable years (or, with the approval of the Secretary, a shorter period), adjusted for recoveries of bad debts during such period, bears to (ii) the sum of the loans outstanding at the close of such 6 or fewer taxable years")
pub relation experience_method_branch_a_amount(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 585(b)(2)(A): loans outstanding at the close of the taxable year, times the ratio of 6-year bad debts to 6-year loans outstanding";
}
rule Section585b2ABranchARatioAmount(b: Person, y: TaxableYear, bad_debts: Money, loans_6yr: Money, loans_close: Money) strict {
    label en official "section 585(b)(2)(A): the ratio-of-6-years amount";
    when bad_debts_sustained_6_year_period(b, y, bad_debts);
    when loans_outstanding_6_year_sum(b, y, loans_6yr);
    when loans_outstanding_close_of_year(b, y, loans_close);
    then experience_method_branch_a_amount(b, y, div_round(loans_close * (bad_debts / 1.00 USD), loans_6yr / 1.00 USD, 2, "HALF_UP"));
}

// Section 585(b)(2)(B): the "base year" comparison. "Base year" (the last
// taxable year before the most recent adoption of the experience method,
// or the last taxable year beginning before 1988 for taxable years
// beginning after 1987) is a bank-specific ADOPTION-HISTORY fact this
// package does not derive from any other modeled relation — it is asserted
// as a case fact identifying WHICH prior taxable year is the base year for
// a given (bank, taxable year) computation, per the statute's own
// definition; `loans_outstanding_close_of_year` above is reused for the
// base year itself (it is already generic over any `TaxableYear`), so only
// the base year's reserve balance needs a new relation.
@source(IRC_S585_B, quote = "the base year shall be the last taxable year before the most recent adoption of the experience method, except that for taxable years beginning after 1987 the base year shall be the last taxable year beginning before 1988")
pub relation base_year_585b2(b: Person, y: TaxableYear, base_y: TaxableYear) kind institutional {
    label en unofficial "the section 585(b)(2)(B) base year applicable to the bank's computation for the taxable year (the taxpayer's own determination under the two-branch base-year rule; not derived here, since 'most recent adoption of the experience method' is bank-specific adoption history this package does not otherwise track)";
}
@source(IRC_S585_B, quote = "the balance of the reserve at the close of the base year")
pub relation reserve_balance_close_of_year(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the balance of the reserve for losses on loans at the close of the given taxable year (used both for the taxable year itself and, via base_year_585b2, for the base year)";
}
@source(IRC_S585_B, quote = "(B) the lower of—\n(i) the balance of the reserve at the close of the base year, or\n(ii) if the amount of loans outstanding at the close of the taxable year is less than the amount of loans outstanding at the close of the base year, the amount which bears the same ratio to loans outstanding at the close of the taxable year as the balance of the reserve at the close of the base year bears to the amount of loans outstanding at the close of the base year")
pub relation experience_method_branch_b_amount(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 585(b)(2)(B): the base-year comparison amount";
}
rule Section585b2BiBranchBLoansNotDecreased(b: Person, y: TaxableYear, base_y: TaxableYear, base_reserve: Money, loans_y: Money, loans_base: Money) strict {
    label en official "section 585(b)(2)(B): when loans outstanding at close of taxable year are NOT less than at close of base year, (ii) does not apply and the branch amount is the base-year reserve balance itself";
    when base_year_585b2(b, y, base_y);
    when reserve_balance_close_of_year(b, base_y, base_reserve);
    when loans_outstanding_close_of_year(b, y, loans_y);
    when loans_outstanding_close_of_year(b, base_y, loans_base);
    when loans_y >= loans_base;
    then experience_method_branch_b_amount(b, y, base_reserve);
}
rule Section585b2BiiBranchBLoansDecreased(b: Person, y: TaxableYear, base_y: TaxableYear, base_reserve: Money, loans_y: Money, loans_base: Money) strict {
    label en official "section 585(b)(2)(B)(ii): when loans outstanding at close of taxable year are less than at close of base year, the branch amount is the base-year reserve balance scaled by the ratio of taxable-year loans to base-year loans (always <= the base-year balance itself, so it is the 'lower of' the two)";
    when base_year_585b2(b, y, base_y);
    when reserve_balance_close_of_year(b, base_y, base_reserve);
    when loans_outstanding_close_of_year(b, y, loans_y);
    when loans_outstanding_close_of_year(b, base_y, loans_base);
    when loans_y < loans_base;
    then experience_method_branch_b_amount(b, y, div_round(base_reserve * (loans_y / 1.00 USD), loans_base / 1.00 USD, 2, "HALF_UP"));
}

// Section 585(b)(2): the experience-method addition is the GREATER of
// branch (A) or branch (B). A bank whose case does not supply the base-year
// facts (branch (B)'s inputs) still gets a branch-(A)-only amount — no
// longer a bare case-fact placeholder, since branch (A) is now fully
// derived; a bank that DOES supply both gets the statutory greater-of.
// `experience_method_addition` may also still be asserted directly as a
// case fact (kind institutional, per the header note above) where a case
// wants to supply the taxpayer's already-computed final figure without
// exercising the branch machinery.
rule Section585b2GreaterOfBranchAAndB(b: Person, y: TaxableYear, a: Money, bb: Money) strict {
    label en official "section 585(b)(2): the experience-method addition is the greater of the branch (A) and branch (B) amounts, when both are computed";
    when experience_method_branch_a_amount(b, y, a);
    when experience_method_branch_b_amount(b, y, bb);
    then experience_method_addition(b, y, max(a, bb));
}
// Helper: whether ANY base year has been asserted for the (bank, taxable
// year) pair, so the fallback rule below can guard on `not_known` of a
// zero-arity-in-the-relevant-variable boolean rather than naming the
// (unbound, existentially quantified) base year itself in its own head.
pub relation has_base_year_585b2(b: Person, y: TaxableYear) kind institutional {
    label en official "a section 585(b)(2)(B) base year has been asserted for this bank and taxable year (helper, not itself part of the statutory text)";
}
rule HasBaseYear585b2(b: Person, y: TaxableYear, base_y: TaxableYear) strict {
    label en official "helper: holds whenever any base year is asserted for the pair";
    when base_year_585b2(b, y, base_y);
    then has_base_year_585b2(b, y);
}
rule Section585b2BranchAOnlyWhenNoBaseYear(b: Person, y: TaxableYear, a: Money) defeasible {
    label en official "section 585(b)(2): when no base-year facts are supplied for the taxable year, the experience-method addition is the branch (A) amount alone (branch (B) is not thereby treated as zero; it is simply not computed for this case)";
    when experience_method_branch_a_amount(b, y, a);
    when not_known(has_base_year_585b2(b, y));
    then experience_method_addition(b, y, a);
}
