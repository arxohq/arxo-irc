// Section 848(f)(1)(B)(i) stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD. The unamortized balance of the amounts previously capitalized is
// kept per capitalization year (a layer). The negative capitalization
// amount that reduces the balance (module 31: the deduction of (B)(ii)) is
// allocated to the layers beginning with the amount capitalized for the most
// recent year: each layer gives up at most its balance, after the layers
// more recent than it. The total balance of module 31 is derived from the
// layers when they are given (sums over derived items: G4903).

use self::{
    IRC_S848_F,
    Person,
    TaxableYear,
    negative_capitalization_deduction_848f1Bii,
    unamortized_balance_at_year_start_848f1Bi,
};

pub relation unamortized_layer_balance_848f1Bi(c: Person, y: TaxableYear, ly: TaxableYear, balance: Money) kind empirical {
    label en unofficial "the unamortized balance, as of the beginning of the taxable year, of the amount capitalized under subsection (a) for the capitalization year";
}
pub relation more_recent_layer_balance_848f1Bi(c: Person, y: TaxableYear, ly: TaxableYear, other: TaxableYear, balance: Money) kind institutional {
    label en official "the balance of a layer capitalized for a more recent year than the given layer (helper)";
}
rule Section848f1BiMoreRecentLayer(c: Person, y: TaxableYear, ly: TaxableYear, other: TaxableYear, own: Money, balance: Money, b1: Date, b2: Date) strict {
    label en official "helper: the layers capitalized later";
    when unamortized_layer_balance_848f1Bi(c, y, ly, own);
    when unamortized_layer_balance_848f1Bi(c, y, other, balance);
    when us.irc.core::begins(ly, b1);
    when us.irc.core::begins(other, b2);
    when b2 > b1;
    then more_recent_layer_balance_848f1Bi(c, y, ly, other, balance);
}
pub relation has_more_recent_layer_848f1Bi(c: Person, y: TaxableYear, ly: TaxableYear) kind institutional {
    label en official "some more recent layer exists (helper)";
}
rule Section848f1BiHasMoreRecent(c: Person, y: TaxableYear, ly: TaxableYear, other: TaxableYear, balance: Money) strict {
    label en official "helper";
    when more_recent_layer_balance_848f1Bi(c, y, ly, other, balance);
    then has_more_recent_layer_848f1Bi(c, y, ly);
}
pub relation more_recent_layers_total_848f1Bi(c: Person, y: TaxableYear, ly: TaxableYear, total: Money) kind institutional {
    label en official "the total balance of the layers capitalized for more recent years";
}
rule Section848f1BiMoreRecentTotal(c: Person, y: TaxableYear, ly: TaxableYear) strict {
    label en official "the sum of the more recent layers";
    when more_recent_layer_balance_848f1Bi(c, y, ly, _, _);
    then more_recent_layers_total_848f1Bi(c, y, ly, sum all balance: Money for other: TaxableYear where more_recent_layer_balance_848f1Bi(c, y, ly, other, balance));
}
rule Section848f1BiMostRecentTotal(c: Person, y: TaxableYear, ly: TaxableYear, own: Money) strict {
    label en official "the most recent layer has no more recent layer";
    when unamortized_layer_balance_848f1Bi(c, y, ly, own);
    when not_known(has_more_recent_layer_848f1Bi(c, y, ly));
    then more_recent_layers_total_848f1Bi(c, y, ly, 0.00 USD);
}
pub relation layer_balance_reduction_848f1Bi(c: Person, y: TaxableYear, ly: TaxableYear, amount: Money) kind institutional {
    label en official "the part of the negative capitalization amount that reduces the layer, beginning with the amount capitalized for the most recent taxable year";
}
@source(IRC_S848_F, quote = "(i) shall reduce (but not below zero) the unamortized balance (as of the beginning of such taxable year)")
rule Section848f1BiReduceLayers(c: Person, y: TaxableYear, ly: TaxableYear, absorbed: Money, layer: Money, more_recent: Money) defeasible {
    label en official "section 848(f)(1)(B)(i): the negative amount reduces the unamortized balance, most recent year first, not below zero (cents exact)";
    when negative_capitalization_deduction_848f1Bii(c, y, absorbed);
    when unamortized_layer_balance_848f1Bi(c, y, ly, layer);
    when more_recent_layers_total_848f1Bi(c, y, ly, more_recent);
    then layer_balance_reduction_848f1Bi(c, y, ly, min(layer, max(0.00 USD, absorbed - more_recent)));
}
pub relation layers_total_balance_848f1Bi(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the total unamortized balance over the layers";
}
rule Section848f1BiLayersTotal(c: Person, y: TaxableYear) strict {
    label en official "section 848(f)(1)(B)(i): the sum over the capitalization years";
    when unamortized_layer_balance_848f1Bi(c, y, _, _);
    then layers_total_balance_848f1Bi(c, y, sum all balance: Money for ly: TaxableYear where unamortized_layer_balance_848f1Bi(c, y, ly, balance));
}
rule Section848f1BiTotalFeedsTheDeduction(c: Person, y: TaxableYear, total: Money) strict {
    label en official "section 848(f)(1)(B)(i): the layers give the unamortized balance at the start of the year";
    when layers_total_balance_848f1Bi(c, y, total);
    then unamortized_balance_at_year_start_848f1Bi(c, y, total);
}
