// Section 856(d)(7)-(9) (impermissible tenant service income, the taxable
// REIT subsidiary exceptions, eligible independent contractors, qualified
// lodging facilities), together with the section 856 classifiers that were
// case inputs until now: qualified health care property (856(e)(6)(D)),
// interests in real property (856(c)(5)(C)), shared appreciation provision
// (856(j)(5)) and the lodging/health care facility of 856(l)(4).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. A definition that lists kinds is a derived classification over
// facts about the property (an enum of kinds asserted by the case, or a
// share compared with the statutory threshold). Evaluative elements
// ("substantially comparable", "customary", "substantially similar") stay
// asserted facts, DECISION-0194 channel 2 when adjudicated. Amounts per
// service item are itemised (`us.irc.core::Payment`) and summed with
// `sum all` over derived items; the section 111 runtime subset may leave
// such a sum unestablished (TECH-GAPS G4903). Rules that read a derived
// conclusion with `not_known` are `defeasible` (LDC-E4103).

// ---- Section 856(d)(9)(D): lodging facility, qualified lodging facility ----

use self::{
    Corporation,
    IRC_S856_C,
    IRC_S856_D,
    IRC_S856_E,
    IRC_S856_J,
    IRC_S856_L,
    Person,
    ReitAssetKind,
    TaxableYear,
    all_amounts_from_property_856d7B,
    impermissible_tenant_service_income_856d7,
    income_from_shared_appreciation_provision_856j1,
    independent_contractor_856d3,
    is_taxable_reit_subsidiary_856l,
    operates_lodging_or_health_care_facility_856l3A,
    qualified_health_care_property_856e6D,
    quarter_asset_item_75_percent_class_856c4A,
    reit_asset_item_at_quarter_close,
    reit_constructive_ownership_total_856d5,
    related_tenant_856d2B,
    rent_received_from_tenant_for_property_856d,
    trs_limited_rental_exception_met_856d8A,
};

@source(IRC_S856_D, quote = "(I) hotel,")
pub relation hotel_856d9Dii(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is a hotel";
}
@source(IRC_S856_D, quote = "(II) motel, or")
pub relation motel_856d9Dii(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is a motel";
}
@source(IRC_S856_D, quote = "(III) other establishment more than one-half of the dwelling units in which are used on a transient basis.")
pub relation transient_share_of_dwelling_units_856d9Dii(p: us.irc.core::Asset, share: Decimal) kind empirical {
    label en unofficial "the share of the establishment's dwelling units that are used on a transient basis";
}
@source(IRC_S856_D, quote = "The term \"lodging facility\" means a—")
pub relation lodging_establishment_856d9Dii(p: us.irc.core::Asset) kind institutional {
    label en official "the property is a hotel, a motel, or another establishment more than one-half of whose dwelling units are used on a transient basis (the establishment itself, before the amenities of clause (iii))";
}
@source(IRC_S856_D, quote = "The term \"lodging facility\" means a—")
pub relation lodging_facility_856d9D(p: us.irc.core::Asset) kind institutional {
    label en official "the property is a lodging facility: the establishment of clause (ii) or its customary amenities and facilities (clause (iii))";
}
@source(IRC_S856_D, quote = "(I) hotel,")
rule Section856d9DiiHotel(p: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(D)(ii)(I): a hotel is a lodging facility";
    when hotel_856d9Dii(p);
    then lodging_establishment_856d9Dii(p);
}
@source(IRC_S856_D, quote = "(II) motel, or")
rule Section856d9DiiMotel(p: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(D)(ii)(II): a motel is a lodging facility";
    when motel_856d9Dii(p);
    then lodging_establishment_856d9Dii(p);
}
@source(IRC_S856_D, quote = "(III) other establishment more than one-half of the dwelling units in which are used on a transient basis.")
rule Section856d9DiiOtherEstablishment(p: us.irc.core::Asset, share: Decimal) strict {
    label en official "section 856(d)(9)(D)(ii)(III): an establishment more than one-half of whose dwelling units are used on a transient basis";
    when transient_share_of_dwelling_units_856d9Dii(p, share);
    when share > 0.50;
    then lodging_establishment_856d9Dii(p);
}
@source(IRC_S856_D, quote = "The term \"lodging facility\" includes customary amenities and facilities operated as part of, or associated with, the lodging facility")
pub relation amenity_of_lodging_facility_856d9Diii(amenity: us.irc.core::Asset, lodging: us.irc.core::Asset) kind empirical {
    label en unofficial "the amenity or facility is operated as part of, or associated with, the lodging facility";
}
pub relation amenity_customary_for_comparable_unrelated_properties_856d9Diii(amenity: us.irc.core::Asset) kind empirical {
    label en unofficial "the amenity or facility is customary for other properties of a comparable size and class owned by owners unrelated to the trust (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
@source(IRC_S856_D, quote = "so long as such amenities and facilities are customary for other properties of a comparable size and class owned by other owners unrelated to such real estate investment trust")
rule Section856d9DiiEstablishmentIsFacility(p: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(D)(ii): the establishment is a lodging facility";
    when lodging_establishment_856d9Dii(p);
    then lodging_facility_856d9D(p);
}
@source(IRC_S856_D, quote = "The term \"lodging facility\" includes customary amenities and facilities operated as part of, or associated with, the lodging facility")
rule Section856d9DiiiCustomaryAmenities(amenity: us.irc.core::Asset, lodging: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(D)(iii): customary amenities and facilities are part of the lodging facility";
    when amenity_of_lodging_facility_856d9Diii(amenity, lodging);
    when lodging_establishment_856d9Dii(lodging);
    when amenity_customary_for_comparable_unrelated_properties_856d9Diii(amenity);
    then lodging_facility_856d9D(amenity);
}
@source(IRC_S856_D, quote = "unless wagering activities are conducted at or in connection with such facility by any person who is engaged in the business of accepting wagers and who is legally authorized to engage in such business at or in connection with such facility")
pub relation wagering_conducted_by_authorized_wagering_business_856d9Di(p: us.irc.core::Asset) kind empirical {
    label en unofficial "wagering activities are conducted at or in connection with the facility by a person engaged in the business of accepting wagers who is legally authorized to engage in it at or in connection with the facility";
}
@source(IRC_S856_D, quote = "The term \"qualified lodging facility\" means any lodging facility unless wagering activities are conducted at or in connection with such facility")
pub relation qualified_lodging_facility_856d9D(p: us.irc.core::Asset) kind institutional {
    label en official "the property is a qualified lodging facility: a lodging facility at which no authorized wagering business conducts wagering";
}
@source(IRC_S856_D, quote = "The term \"qualified lodging facility\" means any lodging facility unless wagering activities are conducted at or in connection with such facility")
rule Section856d9DiQualifiedLodgingFacility(p: us.irc.core::Asset) defeasible {
    label en official "section 856(d)(9)(D)(i): a lodging facility is a qualified lodging facility unless wagering is conducted by an authorized wagering business";
    when lodging_facility_856d9D(p);
    when not_known(wagering_conducted_by_authorized_wagering_business_856d9Di(p));
    then qualified_lodging_facility_856d9D(p);
}

// ---- Section 856(e)(6)(D): qualified health care property (G2221) ----

pub enum HealthCareFacilityKind856e6D {
    HealthCareHospital;
    HealthCareNursingFacility;
    HealthCareAssistedLivingFacility;
    HealthCareCongregateCareFacility;
    HealthCareQualifiedContinuingCareFacility;
    HealthCareOtherLicensedFacility;
    label en unofficial "the kind of health care facility listed in section 856(e)(6)(D)(ii)";
}
@source(IRC_S856_E, quote = "the term \"health care facility\" means a hospital, nursing facility, assisted living facility, congregate care facility, qualified continuing care facility")
pub relation health_care_facility_kind_856e6Dii(p: us.irc.core::Asset, kind: HealthCareFacilityKind856e6D) kind empirical {
    label en unofficial "the property is a facility of the listed kind (a qualified continuing care facility is one defined in section 7872(g)(4), asserted, not derived; another licensed facility must extend medical, nursing or ancillary services to patients)";
}
@source(IRC_S856_E, quote = "was operated by a provider of such services which was eligible for participation in the medicare program under title XVIII of the Social Security Act with respect to such facility")
pub relation operated_before_lease_end_by_medicare_eligible_provider_856e6Dii(p: us.irc.core::Asset) kind empirical {
    label en unofficial "immediately before the termination, expiration, default or breach of the lease of or mortgage secured by the facility, it was operated by a provider eligible for participation in the medicare program with respect to the facility";
}
@source(IRC_S856_E, quote = "the term \"health care facility\" means a hospital, nursing facility, assisted living facility, congregate care facility, qualified continuing care facility")
pub relation health_care_facility_856e6Dii(p: us.irc.core::Asset) kind institutional {
    label en official "the property is a health care facility within section 856(e)(6)(D)(ii) (INTERPRETATION: the medicare-provider clause is read as qualifying every listed kind, not only the last)";
}
@source(IRC_S856_E, quote = "the term \"health care facility\" means a hospital, nursing facility, assisted living facility, congregate care facility, qualified continuing care facility")
rule Section856e6DiiHealthCareFacility(p: us.irc.core::Asset, kind: HealthCareFacilityKind856e6D) strict {
    label en official "section 856(e)(6)(D)(ii): a listed facility operated before the lease end by a medicare-eligible provider";
    when health_care_facility_kind_856e6Dii(p, kind);
    when operated_before_lease_end_by_medicare_eligible_provider_856e6Dii(p);
    then health_care_facility_856e6Dii(p);
}
@source(IRC_S856_E, quote = "is necessary or incidental to the use of a health care facility.")
pub relation necessary_or_incidental_to_use_of_health_care_facility_856e6Di(p: us.irc.core::Asset, facility: us.irc.core::Asset) kind empirical {
    label en unofficial "the real property (or incident personal property) is necessary or incidental to the use of the health care facility (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
@source(IRC_S856_E, quote = "any real property (including interests therein), and any personal property incident to such real property")
pub relation real_property_or_incident_personal_property_856e6Di(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is real property (including interests therein) or personal property incident to real property";
}
@source(IRC_S856_E, quote = "The term \"qualified health care property\" means any real property (including interests therein), and any personal property incident to such real property, which")
rule Section856e6DiIsHealthCareFacility(p: us.irc.core::Asset) strict {
    label en official "section 856(e)(6)(D)(i)(I): real property (or incident personal property) that is a health care facility";
    when real_property_or_incident_personal_property_856e6Di(p);
    when health_care_facility_856e6Dii(p);
    then qualified_health_care_property_856e6D(p);
}
@source(IRC_S856_E, quote = "is necessary or incidental to the use of a health care facility.")
rule Section856e6DiNecessaryOrIncidental(p: us.irc.core::Asset, facility: us.irc.core::Asset) strict {
    label en official "section 856(e)(6)(D)(i)(II): real property (or incident personal property) that is necessary or incidental to the use of a health care facility";
    when real_property_or_incident_personal_property_856e6Di(p);
    when necessary_or_incidental_to_use_of_health_care_facility_856e6Di(p, facility);
    when health_care_facility_856e6Dii(facility);
    then qualified_health_care_property_856e6D(p);
}

// ---- Section 856(c)(5)(C): interests in real property (G2221) ----

pub enum InterestInRealPropertyKind856c5C {
    InterestFeeOwnership;
    InterestCoOwnership;
    InterestLeasehold;
    InterestOptionToAcquireLand;
    InterestOptionToAcquireLeasehold;
    InterestMineralOilOrGasRoyalty;
    label en unofficial "the kind of interest a real estate investment trust holds in land or improvements (section 856(c)(5)(C))";
}
@source(IRC_S856_C, quote = "The term \"interests in real property\" includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon, but does not include mineral, oil, or gas royalty interests.")
pub relation interest_kind_856c5C(a: us.irc.core::Asset, kind: InterestInRealPropertyKind856c5C) kind empirical {
    label en unofficial "the trust's interest in land or improvements is of this kind";
}
@source(IRC_S856_C, quote = "The term \"interests in real property\" includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon, but does not include mineral, oil, or gas royalty interests.")
pub relation interest_in_real_property_856c5C(a: us.irc.core::Asset) kind institutional {
    label en official "the asset is an interest in real property: fee ownership, co-ownership, a leasehold, or an option to acquire land, improvements or a leasehold; a mineral, oil or gas royalty interest is not";
}
@source(IRC_S856_C, quote = "includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon")
rule Section856c5CFeeOwnership(a: us.irc.core::Asset) strict {
    label en official "section 856(c)(5)(C): fee ownership of land or improvements";
    when interest_kind_856c5C(a, InterestFeeOwnership);
    then interest_in_real_property_856c5C(a);
}
@source(IRC_S856_C, quote = "includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon")
rule Section856c5CCoOwnership(a: us.irc.core::Asset) strict {
    label en official "section 856(c)(5)(C): co-ownership of land or improvements";
    when interest_kind_856c5C(a, InterestCoOwnership);
    then interest_in_real_property_856c5C(a);
}
@source(IRC_S856_C, quote = "includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon")
rule Section856c5CLeasehold(a: us.irc.core::Asset) strict {
    label en official "section 856(c)(5)(C): leaseholds of land or improvements";
    when interest_kind_856c5C(a, InterestLeasehold);
    then interest_in_real_property_856c5C(a);
}
@source(IRC_S856_C, quote = "includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon")
rule Section856c5COptionOnLand(a: us.irc.core::Asset) strict {
    label en official "section 856(c)(5)(C): options to acquire land or improvements";
    when interest_kind_856c5C(a, InterestOptionToAcquireLand);
    then interest_in_real_property_856c5C(a);
}
@source(IRC_S856_C, quote = "includes fee ownership and co-ownership of land or improvements thereon, leaseholds of land or improvements thereon, options to acquire land or improvements thereon, and options to acquire leaseholds of land or improvements thereon")
rule Section856c5COptionOnLeasehold(a: us.irc.core::Asset) strict {
    label en official "section 856(c)(5)(C): options to acquire leaseholds of land or improvements";
    when interest_kind_856c5C(a, InterestOptionToAcquireLeasehold);
    then interest_in_real_property_856c5C(a);
}
@source(IRC_S856_C, quote = "The term \"real estate assets\" means real property (including interests in real property and interests in mortgages on real property or on interests in real property)")
rule Section856c4AInterestByDefinition(t: Person, y: TaxableYear, q: us.irc.core::Period, asset: us.irc.core::Asset, kind: ReitAssetKind, value: Money) strict {
    label en official "section 856(c)(5)(B),(C): an itemised asset that is an interest in real property by the definition is a real estate asset, whatever class the case gave it";
    when reit_asset_item_at_quarter_close(t, y, q, asset, kind, value);
    when interest_in_real_property_856c5C(asset);
    then quarter_asset_item_75_percent_class_856c4A(t, y, q, asset, value);
}

// ---- Section 856(j)(5): shared appreciation provision (G2221) ----

@source(IRC_S856_J, quote = "which is in connection with an obligation which is held by the real estate investment trust and is secured by an interest in real property")
pub relation provision_in_connection_with_secured_obligation_856j5Ai(prov: us.irc.core::Asset, t: Person, secured: us.irc.core::Asset) kind empirical {
    label en unofficial "the provision is in connection with an obligation held by the trust and secured by an interest in the real property";
}
@source(IRC_S856_J, quote = "which entitles the real estate investment trust to receive a specified portion of any gain realized on the sale or exchange of such real property")
pub relation provision_entitles_to_specified_portion_of_gain_or_appreciation_856j5Aii(prov: us.irc.core::Asset) kind empirical {
    label en unofficial "the provision entitles the trust to a specified portion of any gain on the sale or exchange of the property (or gain that would be realized if sold on a specified date) or of appreciation in value as of a specified date";
}
@source(IRC_S856_J, quote = "The term \"shared appreciation provision\" means any provision")
pub relation shared_appreciation_provision_856j5A(prov: us.irc.core::Asset, t: Person) kind institutional {
    label en official "the provision is a shared appreciation provision of the trust";
}
@source(IRC_S856_J, quote = "The term \"shared appreciation provision\" means any provision")
rule Section856j5AProvision(prov: us.irc.core::Asset, t: Person, secured: us.irc.core::Asset) strict {
    label en official "section 856(j)(5)(A): a provision connected with a secured obligation of the trust that entitles it to a specified portion of gain or appreciation";
    when provision_in_connection_with_secured_obligation_856j5Ai(prov, t, secured);
    when provision_entitles_to_specified_portion_of_gain_or_appreciation_856j5Aii(prov);
    then shared_appreciation_provision_856j5A(prov, t);
}
@source(IRC_S856_J, quote = "The term \"secured property\" means the real property referred to in subparagraph (A).")
pub relation secured_property_856j5B(prov: us.irc.core::Asset, secured: us.irc.core::Asset) kind institutional {
    label en official "the secured property of a shared appreciation provision is the real property referred to in subparagraph (A)";
}
@source(IRC_S856_J, quote = "The term \"secured property\" means the real property referred to in subparagraph (A).")
rule Section856j5BSecuredProperty(prov: us.irc.core::Asset, t: Person, secured: us.irc.core::Asset) strict {
    label en official "section 856(j)(5)(B): the secured property is the real property of subparagraph (A)";
    when shared_appreciation_provision_856j5A(prov, t);
    when provision_in_connection_with_secured_obligation_856j5Ai(prov, t, secured);
    then secured_property_856j5B(prov, secured);
}
pub relation income_item_attributable_to_provision_856j1(t: Person, y: TaxableYear, item: us.irc.core::Payment, prov: us.irc.core::Asset) kind empirical {
    label en unofficial "the income item is derived from the provision";
}
@source(IRC_S856_J, quote = "any income derived from a shared appreciation provision shall be treated as gain recognized on the sale of the secured property")
rule Section856j1IncomeFromProvision(t: Person, y: TaxableYear, item: us.irc.core::Payment, prov: us.irc.core::Asset) strict {
    label en official "section 856(j)(1) with (j)(5)(A): an item derived from a shared appreciation provision is income from such a provision";
    when income_item_attributable_to_provision_856j1(t, y, item, prov);
    when shared_appreciation_provision_856j5A(prov, t);
    then income_from_shared_appreciation_provision_856j1(t, y, item);
}

// ---- Section 856(d)(9)(E)-(F): operate includes manage; related person ----

@source(IRC_S856_D, quote = "References in this paragraph to operating a property shall be treated as including a reference to managing the property.")
pub relation operates_property_856d9(person: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the person operates the property";
}
pub relation manages_property_856d9(person: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the person manages the property";
}
@source(IRC_S856_D, quote = "References in this paragraph to operating a property shall be treated as including a reference to managing the property.")
pub relation operates_or_manages_856d9E(person: Person, p: us.irc.core::Asset) kind institutional {
    label en official "the person operates the property, or manages it (a reference to operating includes managing)";
}
@source(IRC_S856_D, quote = "References in this paragraph to operating a property shall be treated as including a reference to managing the property.")
rule Section856d9EOperates(person: Person, p: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(E): operating";
    when operates_property_856d9(person, p);
    then operates_or_manages_856d9E(person, p);
}
@source(IRC_S856_D, quote = "References in this paragraph to operating a property shall be treated as including a reference to managing the property.")
rule Section856d9EManages(person: Person, p: us.irc.core::Asset) strict {
    label en official "section 856(d)(9)(E): managing counts as operating";
    when manages_property_856d9(person, p);
    then operates_or_manages_856d9E(person, p);
}
@source(IRC_S856_D, quote = "Persons shall be treated as related to each other if such persons are treated as a single employer under subsection (a) or (b) of section 52.")
pub relation single_employer_under_section_52_856d9F(a: Person, b: Person) kind empirical {
    label en unofficial "the persons are treated as a single employer under section 52(a) or (b) (an owner of section 52, which this package does not import; asserted)";
}
@source(IRC_S856_D, quote = "Persons shall be treated as related to each other if such persons are treated as a single employer under subsection (a) or (b) of section 52.")
pub relation related_person_856d9F(a: Person, b: Person) kind institutional {
    label en official "the persons are related for section 856(d)(9): a single employer under section 52(a) or (b), in either direction";
}
@source(IRC_S856_D, quote = "Persons shall be treated as related to each other if such persons are treated as a single employer under subsection (a) or (b) of section 52.")
rule Section856d9FRelated(a: Person, b: Person) strict {
    label en official "section 856(d)(9)(F): single-employer persons are related";
    when single_employer_under_section_52_856d9F(a, b);
    then related_person_856d9F(a, b);
}
@source(IRC_S856_D, quote = "Persons shall be treated as related to each other if such persons are treated as a single employer under subsection (a) or (b) of section 52.")
rule Section856d9FRelatedSymmetric(a: Person, b: Person) strict {
    label en official "section 856(d)(9)(F): relatedness is mutual";
    when single_employer_under_section_52_856d9F(b, a);
    then related_person_856d9F(a, b);
}
@source(IRC_S856_L, quote = "any corporation which directly or indirectly operates or manages a lodging facility or a health care facility")
rule Section856l3AOperatesLodgingByDefinition(c: Corporation, p: us.irc.core::Asset) strict {
    label en official "section 856(l)(3)(A) with (l)(4)(A): a corporation that operates or manages a lodging facility (section 856(d)(9)(D)(ii)) is not a taxable REIT subsidiary";
    when operates_or_manages_856d9E(c, p);
    when lodging_facility_856d9D(p);
    then operates_lodging_or_health_care_facility_856l3A(c);
}
@source(IRC_S856_L, quote = "any corporation which directly or indirectly operates or manages a lodging facility or a health care facility")
rule Section856l3AOperatesHealthCareByDefinition(c: Corporation, p: us.irc.core::Asset) strict {
    label en official "section 856(l)(3)(A) with (l)(4)(B): a corporation that operates or manages a health care facility (section 856(e)(6)(D)(ii)) is not a taxable REIT subsidiary";
    when operates_or_manages_856d9E(c, p);
    when health_care_facility_856e6Dii(p);
    then operates_lodging_or_health_care_facility_856l3A(c);
}

// ---- Section 856(d)(9)(A): eligible independent contractor ----

pub enum OperatedFacilityKind856d9 {
    OperatesQualifiedLodging;
    OperatesQualifiedHealthCare;
    label en unofficial "the kind of property the contractor (or a related person) operates for others (section 856(d)(9)(A))";
}
@source(IRC_S856_D, quote = "at the time such contractor enters into a management agreement or other similar service contract with the taxable REIT subsidiary to operate such qualified lodging facility or qualified health care property")
pub relation management_agreement_856d9A(c: Person, trs: Corporation, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the contractor entered into a management agreement or similar service contract with the taxable REIT subsidiary to operate the property, on this date";
}
@source(IRC_S856_D, quote = "such contractor (or any related person) is actively engaged in the trade or business of operating qualified lodging facilities or qualified health care properties, respectively, for any person who is not a related person with respect to the real estate investment trust or the taxable REIT subsidiary")
pub relation operator_engaged_in_operating_for_owner_856d9A(c: Person, operator: Person, owner: Person, kind: OperatedFacilityKind856d9) kind empirical {
    label en unofficial "at the time of the agreement the operator (the contractor itself or a related person) is actively engaged in the trade or business of operating qualified lodging facilities or health care properties of this kind for the owner";
}
@source(IRC_S856_D, quote = "The term \"eligible independent contractor\" means, with respect to any qualified lodging facility or qualified health care property")
pub relation eligible_independent_contractor_856d9A(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset) kind institutional {
    label en official "the contractor is an eligible independent contractor with respect to the qualified lodging facility or qualified health care property leased to the taxable REIT subsidiary";
}
@source(IRC_S856_D, quote = "any independent contractor if, at the time such contractor enters into a management agreement or other similar service contract with the taxable REIT subsidiary to operate such qualified lodging facility or qualified health care property")
rule Section856d9AEligibleForLodging(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset, on: Date, operator: Person, owner: Person) defeasible {
    label en official "section 856(d)(9)(A): an independent contractor that (or a related person that) operates qualified lodging facilities for a person unrelated to the trust and to the subsidiary";
    when independent_contractor_856d3(c, t);
    when management_agreement_856d9A(c, trs, p, on);
    when qualified_lodging_facility_856d9D(p);
    when operator_engaged_in_operating_for_owner_856d9A(c, operator, owner, OperatesQualifiedLodging);
    when not_known(related_person_856d9F(owner, t));
    when not_known(related_person_856d9F(owner, trs));
    then eligible_independent_contractor_856d9A(c, t, trs, p);
}
@source(IRC_S856_D, quote = "any independent contractor if, at the time such contractor enters into a management agreement or other similar service contract with the taxable REIT subsidiary to operate such qualified lodging facility or qualified health care property")
rule Section856d9AEligibleForHealthCare(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset, on: Date, operator: Person, owner: Person) defeasible {
    label en official "section 856(d)(9)(A): an independent contractor that (or a related person that) operates qualified health care properties for a person unrelated to the trust and to the subsidiary";
    when independent_contractor_856d3(c, t);
    when management_agreement_856d9A(c, trs, p, on);
    when qualified_health_care_property_856e6D(p);
    when operator_engaged_in_operating_for_owner_856d9A(c, operator, owner, OperatesQualifiedHealthCare);
    when not_known(related_person_856d9F(owner, t));
    when not_known(related_person_856d9F(owner, trs));
    then eligible_independent_contractor_856d9A(c, t, trs, p);
}

// ---- Section 856(d)(9)(B)-(C): special rules and existing leases ----

@source(IRC_S856_D, quote = "a person shall not fail to be treated as an independent contractor with respect to any qualified lodging facility or qualified health care property")
pub entity ReitLease856d {
    label en unofficial "a lease of a property from the real estate investment trust to a person, considered for the section 856(d)(9)(B)(iii) special rule";
}
@source(IRC_S856_D, quote = "The taxable REIT subsidiary bears the expenses for the operation of such qualified lodging facility or qualified health care property pursuant to the management agreement or other similar service contract.")
pub relation trs_bears_operating_expenses_856d9Bi(trs: Corporation, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the taxable REIT subsidiary bears the expenses of operating the property under the management agreement";
}
@source(IRC_S856_D, quote = "The taxable REIT subsidiary receives the revenues from the operation of such qualified lodging facility or qualified health care property, net of expenses for such operation and fees payable to the operator pursuant to such agreement or contract.")
pub relation trs_receives_net_revenues_856d9Bii(trs: Corporation, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the taxable REIT subsidiary receives the revenues from operating the property, net of expenses and the operator's fees";
}
@source(IRC_S856_D, quote = "The real estate investment trust receives income from such person with respect to another property that is attributable to a lease of such other property to such person")
pub relation trust_income_from_contractor_under_lease_856d9Biii(t: Person, c: Person, lease: ReitLease856d) kind empirical {
    label en unofficial "the trust receives income from the contractor with respect to another property that is attributable to this lease of the other property to the contractor";
}
pub relation lease_entered_on_856d9C(lease: ReitLease856d, on: Date) kind empirical {
    label en unofficial "the lease was entered into on this date";
}
pub relation lease_in_effect_on_856d9C(lease: ReitLease856d, on: Date) kind empirical {
    label en unofficial "the lease, in its terms as then in effect, was in effect on this date";
}
pub relation lease_renews_prior_lease_pursuant_to_its_terms_856d9Ci(lease: ReitLease856d, prior: ReitLease856d) kind empirical {
    label en unofficial "the lease is a renewal of the prior lease, made pursuant to the terms of the prior lease as in effect on the reference date";
}
pub relation prior_lease_of_property_in_effect_on_reference_date_856d9Cii(lease: ReitLease856d, prior: ReitLease856d) kind empirical {
    label en unofficial "on the reference date a lease of the same property from the trust was in effect (the prior lease)";
}
pub relation new_lease_substantially_similar_or_lesser_benefit_856d9Cii(lease: ReitLease856d, prior: ReitLease856d) kind empirical {
    label en unofficial "under the new lease the trust receives a substantially similar or lesser benefit than under the prior lease (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
pub relation management_agreement_date_856d9Bii(t: Person, c: Person, p: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a taxable REIT subsidiary of the trust entered into a management agreement or similar service contract with the contractor with respect to the property on this date";
}
@source(IRC_S856_D, quote = "(II) the earliest date that any taxable REIT subsidiary of such trust entered into a management agreement or other similar service contract with such person with respect to such qualified lodging facility or qualified health care property.")
rule Section856d9BiiAgreementDate(t: Person, c: Person, trs: Corporation, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 856(d)(9)(B)(iii)(II): the dates on which a taxable REIT subsidiary of the trust contracted with the person";
    when management_agreement_856d9A(c, trs, p, on);
    when is_taxable_reit_subsidiary_856l(trs, t);
    then management_agreement_date_856d9Bii(t, c, p, on);
}
pub relation earlier_management_agreement_exists_856d9Bii(t: Person, c: Person, p: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a strictly earlier management agreement date exists for the trust, contractor and property";
}
rule Section856d9BiiEarlierExists(t: Person, c: Person, p: us.irc.core::Asset, on: Date, other: Date) defeasible {
    label en official "no earliest-of aggregate exists in the language (TECH-GAPS G136): a strictly earlier candidate is derived instead";
    when management_agreement_date_856d9Bii(t, c, p, on);
    when management_agreement_date_856d9Bii(t, c, p, other);
    when other < on;
    then earlier_management_agreement_exists_856d9Bii(t, c, p, on);
}
@source(IRC_S856_D, quote = "that was in effect as of the later of")
pub relation reference_date_856d9Biii(t: Person, c: Person, p: us.irc.core::Asset, refdate: Date) kind institutional {
    label en official "the later of January 1, 1999 and the earliest date a taxable REIT subsidiary of the trust entered into a management agreement with the contractor for the property";
}
@source(IRC_S856_D, quote = "(I) January 1, 1999, or")
rule Section856d9BiiiReferenceIsAgreementDate(t: Person, c: Person, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 856(d)(9)(B)(iii): the earliest agreement date is on or after January 1, 1999, so it is the later date";
    when management_agreement_date_856d9Bii(t, c, p, on);
    when not_known(earlier_management_agreement_exists_856d9Bii(t, c, p, on));
    when on >= @1999-01-01;
    then reference_date_856d9Biii(t, c, p, on);
}
@source(IRC_S856_D, quote = "(I) January 1, 1999, or")
rule Section856d9BiiiReferenceIsJanuary1999(t: Person, c: Person, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 856(d)(9)(B)(iii): the earliest agreement date precedes January 1, 1999, so January 1, 1999 is the later date";
    when management_agreement_date_856d9Bii(t, c, p, on);
    when not_known(earlier_management_agreement_exists_856d9Bii(t, c, p, on));
    when on < @1999-01-01;
    then reference_date_856d9Biii(t, c, p, @1999-01-01);
}
@source(IRC_S856_D, quote = "a lease shall be treated as in effect on January 1, 1999, without regard to its renewal after such date, so long as such renewal is pursuant to the terms of such lease as in effect on whichever of the dates under subparagraph (B)(iii) is the latest")
pub relation lease_treated_in_effect_at_reference_856d9C(lease: ReitLease856d, refdate: Date) kind institutional {
    label en official "the lease is treated as in effect on the reference date";
}
@source(IRC_S856_D, quote = "a lease shall be treated as in effect on January 1, 1999, without regard to its renewal after such date, so long as such renewal is pursuant to the terms of such lease as in effect on whichever of the dates under subparagraph (B)(iii) is the latest")
rule Section856d9CiInEffect(lease: ReitLease856d, refdate: Date) strict {
    label en official "section 856(d)(9)(C)(i): a lease in effect on the reference date is treated as in effect on it";
    when lease_in_effect_on_856d9C(lease, refdate);
    then lease_treated_in_effect_at_reference_856d9C(lease, refdate);
}
@source(IRC_S856_D, quote = "a lease shall be treated as in effect on January 1, 1999, without regard to its renewal after such date, so long as such renewal is pursuant to the terms of such lease as in effect on whichever of the dates under subparagraph (B)(iii) is the latest")
rule Section856d9CiRenewal(lease: ReitLease856d, prior: ReitLease856d, refdate: Date) strict {
    label en official "section 856(d)(9)(C)(i): a renewal pursuant to the terms of the lease as in effect on the reference date is treated as the lease in effect on it";
    when lease_renews_prior_lease_pursuant_to_its_terms_856d9Ci(lease, prior);
    when lease_in_effect_on_856d9C(prior, refdate);
    then lease_treated_in_effect_at_reference_856d9C(lease, refdate);
}
@source(IRC_S856_D, quote = "a lease of a property entered into after whichever of the dates under subparagraph (B)(iii) is the latest shall be treated as in effect on such date if")
rule Section856d9CiiNewLease(lease: ReitLease856d, prior: ReitLease856d, refdate: Date, entered: Date) strict {
    label en official "section 856(d)(9)(C)(ii): a lease entered into after the reference date is treated as in effect on it when a lease of the property from the trust was in effect then and the new lease gives the trust a substantially similar or lesser benefit";
    when lease_entered_on_856d9C(lease, entered);
    when lease_in_effect_on_856d9C(prior, refdate);
    when entered > refdate;
    when prior_lease_of_property_in_effect_on_reference_date_856d9Cii(lease, prior);
    when new_lease_substantially_similar_or_lesser_benefit_856d9Cii(lease, prior);
    then lease_treated_in_effect_at_reference_856d9C(lease, refdate);
}
@source(IRC_S856_D, quote = "a person shall not fail to be treated as an independent contractor with respect to any qualified lodging facility or qualified health care property")
pub relation independent_contractor_status_kept_856d9B(c: Person, t: Person, p: us.irc.core::Asset) kind institutional {
    label en official "the person is an independent contractor for section 856(d)(9) and (8)(B) despite the special-rule circumstances: the taxable REIT subsidiary bears the expenses or receives the net revenues, or the trust has income from the person under a lease in effect on the reference date";
}
@source(IRC_S856_D, quote = "The taxable REIT subsidiary bears the expenses for the operation of such qualified lodging facility or qualified health care property")
rule Section856d9BiExpensesDoNotDefeat(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 856(d)(9)(B)(i): the subsidiary's bearing of the operating expenses does not stop the contractor from being an independent contractor";
    when independent_contractor_856d3(c, t);
    when management_agreement_856d9A(c, trs, p, on);
    when trs_bears_operating_expenses_856d9Bi(trs, p);
    then independent_contractor_status_kept_856d9B(c, t, p);
}
@source(IRC_S856_D, quote = "The taxable REIT subsidiary receives the revenues from the operation of such qualified lodging facility or qualified health care property")
rule Section856d9BiiRevenuesDoNotDefeat(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset, on: Date) defeasible {
    label en official "section 856(d)(9)(B)(ii): the subsidiary's receipt of the net revenues does not stop the contractor from being an independent contractor";
    when independent_contractor_856d3(c, t);
    when management_agreement_856d9A(c, trs, p, on);
    when trs_receives_net_revenues_856d9Bii(trs, p);
    then independent_contractor_status_kept_856d9B(c, t, p);
}
@source(IRC_S856_D, quote = "The real estate investment trust receives income from such person with respect to another property that is attributable to a lease of such other property to such person")
rule Section856d9BiiiLeaseIncomeDoesNotDefeat(c: Person, t: Person, trs: Corporation, p: us.irc.core::Asset, on: Date, lease: ReitLease856d, refdate: Date) defeasible {
    label en official "section 856(d)(9)(B)(iii): income the trust receives from the contractor under a lease treated as in effect on the reference date does not stop the contractor from being an independent contractor";
    when independent_contractor_856d3(c, t);
    when management_agreement_856d9A(c, trs, p, on);
    when trust_income_from_contractor_under_lease_856d9Biii(t, c, lease);
    when reference_date_856d9Biii(t, c, p, refdate);
    when lease_treated_in_effect_at_reference_856d9C(lease, refdate);
    then independent_contractor_status_kept_856d9B(c, t, p);
}

// ---- Section 856(d)(8)(B): lodging and health care property leased to a taxable REIT subsidiary ----

pub enum TrsOperationBasis856d8B {
    OperationByLicenseOrPermit;
    OperationByForeignEmployees;
    OperationOtherwise;
    label en unofficial "the basis on which a taxable REIT subsidiary would be said to operate or manage a qualified lodging facility or health care property";
}
@source(IRC_S856_D, quote = "a taxable REIT subsidiary is not considered to be operating or managing a qualified health care property or qualified lodging facility solely because it")
pub relation trs_operation_basis_856d8B(trs: Corporation, p: us.irc.core::Asset, basis: TrsOperationBasis856d8B) kind empirical {
    label en unofficial "the subsidiary's connection with the operation or management of the property rests on this basis";
}
@source(IRC_S856_D, quote = "only if an eligible independent contractor is responsible for the daily supervision and direction of such individuals on behalf of the taxable REIT subsidiary pursuant to a management agreement or similar service contract")
pub relation eic_supervises_foreign_employees_856d8Bii(trs: Corporation, p: us.irc.core::Asset) kind empirical {
    label en unofficial "an eligible independent contractor is responsible for the daily supervision and direction of the individuals working outside the United States on behalf of the subsidiary pursuant to a management agreement or similar service contract";
}
pub relation trs_treated_as_operating_856d8B(trs: Corporation, p: us.irc.core::Asset) kind institutional {
    label en official "the taxable REIT subsidiary is considered to be operating or managing the property (a license or permit, or foreign employees under an eligible independent contractor's daily supervision, alone do not make it so)";
}
@source(IRC_S856_D, quote = "a taxable REIT subsidiary is not considered to be operating or managing a qualified health care property or qualified lodging facility solely because it")
rule Section856d8BOperatesOtherwise(trs: Corporation, p: us.irc.core::Asset) strict {
    label en official "section 856(d)(8)(B): the subsidiary operates or manages the property on a basis other than a license or supervised foreign employees";
    when trs_operation_basis_856d8B(trs, p, OperationOtherwise);
    then trs_treated_as_operating_856d8B(trs, p);
}
@source(IRC_S856_D, quote = "employs individuals working at such facility or property located outside the United States, but only if an eligible independent contractor is responsible for the daily supervision and direction of such individuals")
rule Section856d8BiiForeignEmployeesUnsupervised(trs: Corporation, p: us.irc.core::Asset) defeasible {
    label en official "section 856(d)(8)(B)(ii): foreign employees exempt the subsidiary from being an operator only if an eligible independent contractor supervises them daily";
    when trs_operation_basis_856d8B(trs, p, OperationByForeignEmployees);
    when not_known(eic_supervises_foreign_employees_856d8Bii(trs, p));
    then trs_treated_as_operating_856d8B(trs, p);
}
@source(IRC_S856_D, quote = "The requirements of this subparagraph are met with respect to an interest in real property which is a qualified lodging facility")
pub relation property_leased_to_trs_856d8B(t: Person, trs: Corporation, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the trust leases the interest in the property to its taxable REIT subsidiary";
}
pub relation property_operated_on_behalf_of_trs_by_856d8B(trs: Corporation, p: us.irc.core::Asset, operator: Person) kind empirical {
    label en unofficial "the property is operated on behalf of the subsidiary by this person";
}
pub relation lodging_or_health_care_exception_met_856d8B(t: Person, trs: Corporation, p: us.irc.core::Asset) kind institutional {
    label en official "the requirements of section 856(d)(8)(B) are met for the property";
}
@source(IRC_S856_D, quote = "if the property is operated on behalf of such subsidiary by a person who is an eligible independent contractor")
rule Section856d8BLodgingException(t: Person, trs: Corporation, p: us.irc.core::Asset, operator: Person) defeasible {
    label en official "section 856(d)(8)(B): a qualified lodging facility leased to the subsidiary and operated for it by an eligible independent contractor";
    when property_leased_to_trs_856d8B(t, trs, p);
    when qualified_lodging_facility_856d9D(p);
    when property_operated_on_behalf_of_trs_by_856d8B(trs, p, operator);
    when eligible_independent_contractor_856d9A(operator, t, trs, p);
    when not_known(trs_treated_as_operating_856d8B(trs, p));
    then lodging_or_health_care_exception_met_856d8B(t, trs, p);
}
@source(IRC_S856_D, quote = "if the property is operated on behalf of such subsidiary by a person who is an eligible independent contractor")
rule Section856d8BHealthCareException(t: Person, trs: Corporation, p: us.irc.core::Asset, operator: Person) defeasible {
    label en official "section 856(d)(8)(B): a qualified health care property leased to the subsidiary and operated for it by an eligible independent contractor";
    when property_leased_to_trs_856d8B(t, trs, p);
    when qualified_health_care_property_856e6D(p);
    when property_operated_on_behalf_of_trs_by_856d8B(trs, p, operator);
    when eligible_independent_contractor_856d9A(operator, t, trs, p);
    when not_known(trs_treated_as_operating_856d8B(trs, p));
    then lodging_or_health_care_exception_met_856d8B(t, trs, p);
}

// ---- Section 856(d)(8)(A)(ii)-(vi): comparable rents, timing, controlled subsidiary ----

pub entity LeaseTestEvent856d8 {
    label en unofficial "a time referred to in section 856(d)(8)(A)(iii) at which the rent comparability of a lease to a taxable REIT subsidiary is tested";
}
pub enum LeaseEventKind856d8 {
    LeaseEntered;
    LeaseExtended;
    RentIncreasingModification;
    label en unofficial "the time of testing: entry into the lease, each extension (including a failure to exercise a right to terminate), or a modification that effectively increases the rent";
}
@source(IRC_S856_D, quote = "Clause (i) shall apply only to the extent that the amounts paid to the trust as rents from real property")
pub relation rent_substantially_comparable_856d8Aii(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the rents the subsidiary pays are substantially comparable to the rents paid by the other tenants of the trust's property for comparable space (an evaluative element, DECISION-0194 channel 2 when adjudicated)";
}
@source(IRC_S856_D, quote = "The substantial comparability requirement of clause (ii) shall be treated as met with respect to a lease to a taxable REIT subsidiary of the trust if such requirement is met under the terms of the lease")
pub relation lease_test_event_856d8Aiii(t: Person, trs: Corporation, p: us.irc.core::Asset, ev: LeaseTestEvent856d8, kind: LeaseEventKind856d8, on: Date) kind empirical {
    label en unofficial "the lease to the subsidiary was entered into, extended or modified on this date";
}
pub relation comparability_met_under_lease_terms_at_event_856d8Aiii(ev: LeaseTestEvent856d8) kind empirical {
    label en unofficial "the substantial comparability requirement is met under the terms of the lease at the event";
}
pub relation comparability_failed_at_some_event_856d8Aiii(t: Person, trs: Corporation, p: us.irc.core::Asset) kind institutional {
    label en official "at some time referred to in clause (iii) the comparability requirement is not met under the terms of the lease";
}
rule Section856d8AiiiFailedAtEvent(t: Person, trs: Corporation, p: us.irc.core::Asset, ev: LeaseTestEvent856d8, kind: LeaseEventKind856d8, on: Date) defeasible {
    label en official "section 856(d)(8)(A)(iii): comparability is not met under the lease terms at one of the three testing times";
    when lease_test_event_856d8Aiii(t, trs, p, ev, kind, on);
    when not_known(comparability_met_under_lease_terms_at_event_856d8Aiii(ev));
    then comparability_failed_at_some_event_856d8Aiii(t, trs, p);
}
@source(IRC_S856_D, quote = "The substantial comparability requirement of clause (ii) shall be treated as met with respect to a lease to a taxable REIT subsidiary of the trust if such requirement is met under the terms of the lease")
pub relation comparability_treated_as_met_856d8Aiii(t: Person, trs: Corporation, p: us.irc.core::Asset) kind institutional {
    label en official "the substantial comparability requirement is treated as met for the lease: it is met under the lease terms at its entry, at each extension and at each rent-increasing modification";
}
@source(IRC_S856_D, quote = "The substantial comparability requirement of clause (ii) shall be treated as met with respect to a lease to a taxable REIT subsidiary of the trust if such requirement is met under the terms of the lease")
rule Section856d8AiiiTreatedAsMet(t: Person, trs: Corporation, p: us.irc.core::Asset, ev: LeaseTestEvent856d8, on: Date) defeasible {
    label en official "section 856(d)(8)(A)(iii): comparability treated as met when it is met at the lease's entry and at no testing time does it fail";
    when lease_test_event_856d8Aiii(t, trs, p, ev, LeaseEntered, on);
    when comparability_met_under_lease_terms_at_event_856d8Aiii(ev);
    when not_known(comparability_failed_at_some_event_856d8Aiii(t, trs, p));
    then comparability_treated_as_met_856d8Aiii(t, trs, p);
}
@source(IRC_S856_D, quote = "if the taxable REIT subsidiary of the trust is a controlled taxable REIT subsidiary of the trust")
pub relation controlled_taxable_reit_subsidiary_856d8Aiv(t: Person, trs: Corporation) kind institutional {
    label en official "the subsidiary is a taxable REIT subsidiary of the trust in which the trust owns, directly or indirectly, more than 50 percent of the voting power or of the value of the outstanding stock (one row per measure, the case asserts the shares)";
}
@source(IRC_S856_D, quote = "(I) stock possessing more than 50 percent of the total voting power of the outstanding stock of such subsidiary, or")
rule Section856d8AivControlled(t: Person, trs: Corporation, share: Decimal) defeasible {
    label en official "section 856(d)(8)(A)(iv): a taxable REIT subsidiary more than half of which the trust owns, directly or indirectly (section 856(d)(5) attribution applies)";
    when is_taxable_reit_subsidiary_856l(trs, t);
    when reit_constructive_ownership_total_856d5(t, trs, share);
    when share > 0.50;
    then controlled_taxable_reit_subsidiary_856d8Aiv(t, trs);
}
pub relation rent_increase_from_modification_856d8Aiii(ev: LeaseTestEvent856d8, amount: Money) kind empirical {
    label en unofficial "the amount by which the rent under the lease is effectively increased by the modification";
}
pub relation rent_excluded_by_controlled_trs_increase_856d8Aiii(t: Person, trs: Corporation, p: us.irc.core::Asset, ev: LeaseTestEvent856d8, amount: Money) kind institutional {
    label en official "the rent under the lease to a controlled taxable REIT subsidiary that is not rents from real property: the increase on account of a rent-increasing modification";
}
@source(IRC_S856_D, quote = "the term \"rents from real property\" shall not in any event include rent under such lease to the extent of the increase in such rent on account of such modification")
rule Section856d8AiiiControlledModificationIncrease(t: Person, trs: Corporation, p: us.irc.core::Asset, ev: LeaseTestEvent856d8, on: Date, amount: Money) defeasible {
    label en official "section 856(d)(8)(A)(iii), last sentence: for a controlled subsidiary the rent increase from a modification is never rents from real property";
    when lease_test_event_856d8Aiii(t, trs, p, ev, RentIncreasingModification, on);
    when controlled_taxable_reit_subsidiary_856d8Aiv(t, trs);
    when rent_increase_from_modification_856d8Aiii(ev, amount);
    then rent_excluded_by_controlled_trs_increase_856d8Aiii(t, trs, p, ev, amount);
}
@source(IRC_S856_D, quote = "such requirements shall continue to be treated as met so long as there is no increase in the space leased to any taxable REIT subsidiary of such trust or to any person described in paragraph (2)(B)")
pub relation ninety_percent_test_met_at_time_856d8Ai(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the 90 percent leased-space requirement of clause (i) was met at a time referred to in clause (iii), on this date";
}
pub relation space_leased_to_trs_or_related_increased_856d8Av(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the space leased to a taxable REIT subsidiary of the trust or to a person described in paragraph (2)(B) increased on this date";
}
pub relation continuing_qualification_asked_856d8Av(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the date at which the continued qualification of clause (i) is asked";
}
pub relation space_increase_between_856d8Av(t: Person, p: us.irc.core::Asset, base: Date, on: Date) kind institutional {
    label en official "the space leased to a taxable REIT subsidiary or a section 856(d)(2)(B) person increased after the base date and by the asked date";
}
rule Section856d8AvIncreaseBetween(t: Person, p: us.irc.core::Asset, base: Date, on: Date, increased_on: Date) defeasible {
    label en official "section 856(d)(8)(A)(v): an increase in space leased to a subsidiary or related person after the base time";
    when ninety_percent_test_met_at_time_856d8Ai(t, p, base);
    when continuing_qualification_asked_856d8Av(t, p, on);
    when space_leased_to_trs_or_related_increased_856d8Av(t, p, increased_on);
    when increased_on > base;
    when increased_on <= on;
    then space_increase_between_856d8Av(t, p, base, on);
}
pub relation ninety_percent_test_continues_856d8Av(t: Person, p: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the requirements of clause (i), met at a time referred to in clause (iii), continue to be treated as met at the date";
}
@source(IRC_S856_D, quote = "such requirements shall continue to be treated as met so long as there is no increase in the space leased to any taxable REIT subsidiary of such trust or to any person described in paragraph (2)(B)")
rule Section856d8AvContinues(t: Person, p: us.irc.core::Asset, base: Date, on: Date) defeasible {
    label en official "section 856(d)(8)(A)(v): continuing qualification while the leased space to subsidiaries and related persons does not increase";
    when ninety_percent_test_met_at_time_856d8Ai(t, p, base);
    when continuing_qualification_asked_856d8Av(t, p, on);
    when on >= base;
    when not_known(space_increase_between_856d8Av(t, p, base, on));
    then ninety_percent_test_continues_856d8Av(t, p, on);
}
@source(IRC_S856_D, quote = "the requirements of clause (iii) shall be treated as met during the quarter and the succeeding quarter if such requirements are met at the close of such succeeding quarter")
pub relation space_increase_in_quarter_856d8Avi(t: Person, p: us.irc.core::Asset, q: us.irc.core::Period) kind empirical {
    label en unofficial "an increase referred to in clause (v) occurred during the calendar quarter";
}
pub relation succeeding_quarter_856d8Avi(q: us.irc.core::Period, next: us.irc.core::Period) kind empirical {
    label en unofficial "the second period is the calendar quarter succeeding the first";
}
pub relation clause_iii_requirements_met_at_close_of_quarter_856d8Avi(t: Person, p: us.irc.core::Asset, q: us.irc.core::Period) kind empirical {
    label en unofficial "the requirements of clause (iii) are met at the close of the quarter";
}
pub relation clause_iii_requirements_treated_as_met_in_quarter_856d8Avi(t: Person, p: us.irc.core::Asset, q: us.irc.core::Period) kind institutional {
    label en official "the requirements of clause (iii) are treated as met during the quarter (the correction period)";
}
@source(IRC_S856_D, quote = "the requirements of clause (iii) shall be treated as met during the quarter and the succeeding quarter if such requirements are met at the close of such succeeding quarter")
rule Section856d8AviCorrectionQuarterOfIncrease(t: Person, p: us.irc.core::Asset, q: us.irc.core::Period, next: us.irc.core::Period) strict {
    label en official "section 856(d)(8)(A)(vi): the quarter of the increase";
    when space_increase_in_quarter_856d8Avi(t, p, q);
    when succeeding_quarter_856d8Avi(q, next);
    when clause_iii_requirements_met_at_close_of_quarter_856d8Avi(t, p, next);
    then clause_iii_requirements_treated_as_met_in_quarter_856d8Avi(t, p, q);
}
@source(IRC_S856_D, quote = "the requirements of clause (iii) shall be treated as met during the quarter and the succeeding quarter if such requirements are met at the close of such succeeding quarter")
rule Section856d8AviCorrectionSucceedingQuarter(t: Person, p: us.irc.core::Asset, q: us.irc.core::Period, next: us.irc.core::Period) strict {
    label en official "section 856(d)(8)(A)(vi): the succeeding quarter";
    when space_increase_in_quarter_856d8Avi(t, p, q);
    when succeeding_quarter_856d8Avi(q, next);
    when clause_iii_requirements_met_at_close_of_quarter_856d8Avi(t, p, next);
    then clause_iii_requirements_treated_as_met_in_quarter_856d8Avi(t, p, next);
}

// ---- Section 856(d)(8): the subsidiary payment is not excluded by (2)(B) ----

pub relation limited_rental_exception_856d8A(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the limited rental exception is met: the 90 percent leased-space test of clause (i) and the rent comparability of clause (ii) (directly, or treated as met under clause (iii))";
}
@source(IRC_S856_D, quote = "Clause (i) shall apply only to the extent that the amounts paid to the trust as rents from real property")
rule Section856d8AComparableRents(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear) defeasible {
    label en official "section 856(d)(8)(A)(i)-(ii): at least 90 percent of the space rented to persons other than subsidiaries and related persons, and comparable rents";
    when trs_limited_rental_exception_met_856d8A(t, y, p);
    when rent_substantially_comparable_856d8Aii(t, trs, p, y);
    then limited_rental_exception_856d8A(t, trs, p, y);
}
@source(IRC_S856_D, quote = "The substantial comparability requirement of clause (ii) shall be treated as met with respect to a lease to a taxable REIT subsidiary of the trust if such requirement is met under the terms of the lease")
rule Section856d8AComparableByLeaseTerms(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear) defeasible {
    label en official "section 856(d)(8)(A)(i), (iii): at least 90 percent of the space rented to others and comparability treated as met by the lease terms";
    when trs_limited_rental_exception_met_856d8A(t, y, p);
    when comparability_treated_as_met_856d8Aiii(t, trs, p);
    then limited_rental_exception_856d8A(t, trs, p, y);
}
pub relation trs_payment_not_excluded_by_856d2B_856d8(t: Person, trs: Person, p: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "amounts paid to the trust by its taxable REIT subsidiary are not excluded from rents from real property by reason of paragraph (2)(B): the requirements of (8)(A) or (8)(B) are met";
}
@source(IRC_S856_D, quote = "amounts paid to a real estate investment trust by a taxable REIT subsidiary of such trust shall not be excluded from rents from real property by reason of paragraph (2)(B) if the requirements of either of the following subparagraphs are met")
rule Section856d8LimitedRental(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear) defeasible {
    label en official "section 856(d)(8)(A): the limited rental exception";
    when is_taxable_reit_subsidiary_856l(trs, t);
    when limited_rental_exception_856d8A(t, trs, p, y);
    then trs_payment_not_excluded_by_856d2B_856d8(t, trs, p, y);
}
@source(IRC_S856_D, quote = "amounts paid to a real estate investment trust by a taxable REIT subsidiary of such trust shall not be excluded from rents from real property by reason of paragraph (2)(B) if the requirements of either of the following subparagraphs are met")
rule Section856d8LodgingOrHealthCare(t: Person, trs: Corporation, p: us.irc.core::Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 856(d)(8)(B): the lodging and health care exception";
    when is_taxable_reit_subsidiary_856l(trs, t);
    when lodging_or_health_care_exception_met_856d8B(t, trs, p);
    when rent_received_from_tenant_for_property_856d(t, trs, p, y, amount);
    then trs_payment_not_excluded_by_856d2B_856d8(t, trs, p, y);
}
pub relation rent_excluded_as_related_tenant_856d2B(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount received from a related tenant for the property is excluded from rents from real property by paragraph (2)(B), because no paragraph (8) exception applies to it";
}
@source(IRC_S856_D, quote = "except as provided in paragraph (8), any amount received or accrued directly or indirectly from any person if the real estate investment trust owns, directly or indirectly")
rule Section856d2BExclusionAfterParagraph8(t: Person, tenant: Person, p: us.irc.core::Asset, y: TaxableYear, amount: Money) defeasible {
    label en official "section 856(d)(2)(B): the amount from a related tenant is excluded unless a taxable REIT subsidiary exception of paragraph (8) applies";
    when rent_received_from_tenant_for_property_856d(t, tenant, p, y, amount);
    when related_tenant_856d2B(t, tenant, y);
    when not_known(trs_payment_not_excluded_by_856d2B_856d8(t, tenant, p, y));
    then rent_excluded_as_related_tenant_856d2B(t, tenant, p, y, amount);
}

// ---- Section 856(d)(7): impermissible tenant service income ----

pub enum TenantServiceKind856d7A {
    ServiceFurnishedToTenants;
    ManagingOrOperatingProperty;
    label en unofficial "the kind of amount described in section 856(d)(7)(A): services furnished or rendered to the tenants, or managing or operating the property";
}
@source(IRC_S856_D, quote = "any amount received or accrued directly or indirectly by the real estate investment trust for")
pub relation tenant_service_item_856d7A(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, kind: TenantServiceKind856d7A, amount: Money) kind empirical {
    label en unofficial "an amount the trust received or accrued for services furnished or rendered to the tenants of the property, or for managing or operating the property";
}
@source(IRC_S856_D, quote = "services furnished or rendered, or management or operation provided, through an independent contractor from whom the trust itself does not derive or receive any income or through a taxable REIT subsidiary of such trust shall not be treated as furnished, rendered, or provided by the trust")
pub relation service_item_provided_through_856d7Ci(item: us.irc.core::Payment, via: Person) kind empirical {
    label en unofficial "the service, management or operation was provided through this person";
}
pub relation trust_derives_income_from_contractor_856d7Ci(t: Person, via: Person) kind empirical {
    label en unofficial "the trust itself derives or receives income from the independent contractor";
}
@source(IRC_S856_D, quote = "there shall not be taken into account any amount which would be excluded from unrelated business taxable income under section 512(b)(3) if received by an organization described in section 511(a)(2)")
pub relation item_excluded_from_ubti_by_512b3_856d7Cii(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the amount would be excluded from unrelated business taxable income under section 512(b)(3) if received by an organization described in section 511(a)(2) (section 512 is not imported; asserted)";
}
@source(IRC_S856_D, quote = "the amount treated as received for any service (or management or operation) shall not be less than 150 percent of the direct cost of the trust in furnishing or rendering the service")
pub relation direct_cost_of_trust_856d7D(item: us.irc.core::Payment, cost: Money) kind empirical {
    label en unofficial "the direct cost of the trust in furnishing or rendering the service (or providing the management or operation)";
}
pub relation direct_cost_stated_856d7D(item: us.irc.core::Payment) kind institutional {
    label en official "a direct cost is stated for the item";
}
rule Section856d7DCostStated(item: us.irc.core::Payment, cost: Money) strict {
    label en official "section 856(d)(7)(D): the item has a stated direct cost of the trust";
    when direct_cost_of_trust_856d7D(item, cost);
    then direct_cost_stated_856d7D(item);
}
@source(IRC_S856_D, quote = "the amount treated as received for any service (or management or operation) shall not be less than 150 percent of the direct cost of the trust in furnishing or rendering the service")
pub relation amount_treated_received_856d7D(item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the amount treated as received for the service: the amount actually received, but not less than 150 percent of the trust's direct cost";
}
@source(IRC_S856_D, quote = "the amount treated as received for any service (or management or operation) shall not be less than 150 percent of the direct cost of the trust in furnishing or rendering the service")
rule Section856d7DFloorApplies(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, kind: TenantServiceKind856d7A, amount: Money, cost: Money) defeasible {
    label en official "section 856(d)(7)(D): the amount received is below 150 percent of the direct cost, so 150 percent of the cost is treated as received (cents HALF_UP is a JUDGMENT CALL)";
    when tenant_service_item_856d7A(t, y, p, item, kind, amount);
    when direct_cost_of_trust_856d7D(item, cost);
    when amount < round(cost * 150 percent, 2, "HALF_UP");
    then amount_treated_received_856d7D(item, round(cost * 150 percent, 2, "HALF_UP"));
}
@source(IRC_S856_D, quote = "the amount treated as received for any service (or management or operation) shall not be less than 150 percent of the direct cost of the trust in furnishing or rendering the service")
rule Section856d7DFloorNotNeeded(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, kind: TenantServiceKind856d7A, amount: Money, cost: Money) defeasible {
    label en official "section 856(d)(7)(D): the amount received is at least 150 percent of the direct cost, so it is the amount treated as received";
    when tenant_service_item_856d7A(t, y, p, item, kind, amount);
    when direct_cost_of_trust_856d7D(item, cost);
    when amount >= round(cost * 150 percent, 2, "HALF_UP");
    then amount_treated_received_856d7D(item, amount);
}
rule Section856d7DNoCostStated(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, kind: TenantServiceKind856d7A, amount: Money) defeasible {
    label en official "section 856(d)(7)(D): without a stated direct cost the amount received is the amount treated as received";
    when tenant_service_item_856d7A(t, y, p, item, kind, amount);
    when not_known(direct_cost_stated_856d7D(item));
    then amount_treated_received_856d7D(item, amount);
}
pub relation service_item_not_provided_by_trust_856d7Ci(t: Person, item: us.irc.core::Payment) kind institutional {
    label en official "the service, management or operation is not treated as furnished, rendered or provided by the trust: it went through an independent contractor from whom the trust derives no income, or through a taxable REIT subsidiary of the trust";
}
@source(IRC_S856_D, quote = "through an independent contractor from whom the trust itself does not derive or receive any income")
rule Section856d7CiIndependentContractor(t: Person, item: us.irc.core::Payment, via: Person) defeasible {
    label en official "section 856(d)(7)(C)(i): through an independent contractor (section 856(d)(3)) from whom the trust derives no income";
    when service_item_provided_through_856d7Ci(item, via);
    when independent_contractor_856d3(via, t);
    when not_known(trust_derives_income_from_contractor_856d7Ci(t, via));
    then service_item_not_provided_by_trust_856d7Ci(t, item);
}
@source(IRC_S856_D, quote = "or through a taxable REIT subsidiary of such trust shall not be treated as furnished, rendered, or provided by the trust")
rule Section856d7CiTaxableReitSubsidiary(t: Person, item: us.irc.core::Payment, via: Corporation) defeasible {
    label en official "section 856(d)(7)(C)(i): through a taxable REIT subsidiary of the trust";
    when service_item_provided_through_856d7Ci(item, via);
    when is_taxable_reit_subsidiary_856l(via, t);
    then service_item_not_provided_by_trust_856d7Ci(t, item);
}
pub relation impermissible_service_item_856d7A(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item of impermissible tenant service income: a service, management or operation amount furnished by the trust itself and not excluded by section 512(b)(3), at the amount treated as received";
}
@source(IRC_S856_D, quote = "The term \"impermissible tenant service income\" means, with respect to any real or personal property, any amount received or accrued directly or indirectly by the real estate investment trust for")
rule Section856d7AImpermissibleItem(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, kind: TenantServiceKind856d7A, actual: Money, treated: Money) defeasible {
    label en official "section 856(d)(7)(A), (C), (D): services furnished to tenants, or management or operation, by the trust itself";
    when tenant_service_item_856d7A(t, y, p, item, kind, actual);
    when amount_treated_received_856d7D(item, treated);
    when not_known(service_item_not_provided_by_trust_856d7Ci(t, item));
    when not_known(item_excluded_from_ubti_by_512b3_856d7Cii(item));
    then impermissible_service_item_856d7A(t, y, p, item, treated);
}
pub relation impermissible_tenant_service_amount_856d7A(t: Person, y: TaxableYear, p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the amount described in subparagraph (A) for the property and year: the sum of the impermissible service items (an aggregate over derived items, TECH-GAPS G4903)";
}
rule Section856d7ASumOfItems(t: Person, y: TaxableYear, p: us.irc.core::Asset, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 856(d)(7)(A): the amount described in subparagraph (A)";
    when impermissible_service_item_856d7A(t, y, p, anchor, anchor_amount);
    then impermissible_tenant_service_amount_856d7A(t, y, p, sum all amount: Money for item: us.irc.core::Payment where impermissible_service_item_856d7A(t, y, p, item, amount));
}
@source(IRC_S856_D, quote = "exceeds 1 percent of all amounts received or accrued during such taxable year directly or indirectly by the real estate investment trust with respect to such property")
rule Section856d7BOnePercentOfItemisedAmount(t: Person, y: TaxableYear, p: us.irc.core::Asset, service: Money, all_amounts: Money) defeasible {
    label en official "section 856(d)(7)(B): the itemised subparagraph (A) amount exceeds 1 percent of all amounts from the property, so all such amounts are impermissible tenant service income";
    when impermissible_tenant_service_amount_856d7A(t, y, p, service);
    when all_amounts_from_property_856d7B(t, y, p, all_amounts);
    when service * 100 > all_amounts * 1;
    then impermissible_tenant_service_income_856d7(t, y, p, all_amounts);
}
pub relation impermissible_service_amount_in_gross_income_856d7E(t: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the impermissible service amount is included in the gross income of the corporation, trust or association for section 856(c)(2) and (3) (the itemised gross-income sums read the case's reit_gross_income_item rows, which must list it; TECH-GAPS G4904)";
}
@source(IRC_S856_D, quote = "For purposes of paragraphs (2) and (3) of subsection (c), amounts described in subparagraph (A) shall be included in the gross income of the corporation, trust, or association.")
rule Section856d7ECoordination(t: Person, y: TaxableYear, p: us.irc.core::Asset, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 856(d)(7)(E): amounts described in subparagraph (A) are gross income for the (c)(2) and (c)(3) tests";
    when impermissible_service_item_856d7A(t, y, p, item, amount);
    then impermissible_service_amount_in_gross_income_856d7E(t, y, item, amount);
}
