// 26 U.S.C. Subchapters H, L, M, R of Chapter 1 — Special Entities: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package special-entities` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.

// Stage 1 (IRC-09 stage 1, A12): the owner's explicit priority subset —
// section 581 (bank defined), 585(a)-(b) (bad-debt reserve of banks,
// experience method) plus the (c)(1)-(2) large-bank gate it depends on,
// 801 (tax on life insurance companies), 816(a) (life insurance company
// defined, the >50% reserves test), 831(a)-(b) (tax on other insurance
// companies, the small-company alternative tax and its core diversification
// test), 832(a),(b)(1),(3)-(5) (insurance company taxable income: gross
// income, underwriting income, premiums earned, losses incurred), 851(a)-(b)
// (RIC defined: registration/election, the 90% income test, the 50%/25%
// diversification test), 852(a)-(b) (RIC taxation: the 90% distribution
// requirement, investment company taxable income, the capital gain tax),
// 856(a),(c)(1)-(4) (REIT defined: organizational tests, the election, the
// 95%/75% gross income tests, the asset tests), 857(a)-(b)(2),(b)(6) (REIT
// taxation: the 90% distribution requirement, REIT taxable income, the 100%
// prohibited-transaction tax with its safe harbor), 860 fully (deficiency
// dividend procedure). All other sections/subsections this package owns
// (see docs/foundations/us-irc/OWNERSHIP.json) stay `unreviewed`, noted
// "stage 2" in coverage rows where a row falls inside a section this stage
// partially touches; see docs/foundations/us-irc/HANDOFF.md for the exact
// boundary of what stage 1 did and did not reach.
//
// MODULE MAP
//   01-banks.law                — sections 581, 585(a)-(c)(1)-(2)
//   02-life-insurance.law       — sections 801, 816(a)
//   03-other-insurance.law      — sections 831(a)-(b), 832(a),(b)(1),(3)-(5)
//   04-regulated-investment-companies.law — sections 851(a)-(b), 852(a)-(b)
//   05-real-estate-investment-trusts.law  — sections 856(a),(c)(1)-(4), 857(a)-(b)(2),(b)(6)
//   06-deficiency-dividends.law — section 860 (all subsections)

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

import us.irc.core version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.deductions version "0.1.1";
import us.irc.definitions version "0.1.1";
import us.irc.temporal version "0.1.1";
import us.irs.rev_rul_afr version "0.1.1";

// Shared type aliases for us.irc.core entities, declared once here so that
// every module of this package can reference them without re-declaring the
// same name (LDC-E1201/LDC-E1338: a name/StableId may be declared only once
// per package, even across files).
type Person = us.irc.core::Person;
type Corporation = us.irc.core::Corporation;
type Trust = us.irc.core::Trust;
type Association = us.irc.core::Association;
type TaxableYear = us.irc.core::TaxableYear;
// STAGE 2b (25.09.2026): a generic per-contract entity for section 807(d)-
// (e)'s reserve-per-contract computations, section 817's variable-contract
// segregated-asset accounts, and similar contract-level relations. No
// dedicated "insurance/annuity contract" entity exists in `us.irc.core`;
// `Asset` ("property in which a person holds an interest for tax purposes")
// is the closest fit and is reused rather than duplicated, per the
// convention against forking a shared type.
type Contract = us.irc.core::Asset;
