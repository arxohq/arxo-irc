// Section 846 (discounted unpaid losses of insurance companies other than
// life insurance companies). Stage 2b (IRC-09 stage 2b, A12).
//
// METHOD: section 846(a)(2)'s "present value... determined by using... the
// applicable interest rate... and... the applicable loss payment pattern"
// is a genuine actuarial present-value computation the Secretary publishes
// the INPUTS for (the interest rate under (c), based on the corporate bond
// yield curve; the loss payment pattern under (d), based on aggregate NAIC
// experience data) but does not publish as a single combined discount
// factor in the statute itself — computing the actual present value from a
// yield curve and a multi-year payment-pattern schedule (the (d)(3)(B)(ii)
// 10-year-pattern extension in particular, itself a multi-year running
// average) is model-and-data machinery well beyond this package's own
// text, matching the task's own framing of the discount factors as
// EXTERNAL_DEPENDENCY. This package therefore: (1) models the (a)(1)/(3)
// STRUCTURE exactly (each line-of-business/accident-year figure separately
// computed and capped at the annual-statement aggregate), (2) accepts the
// discount FACTOR itself as a case-asserted EXTERNAL_DEPENDENCY value
// (`discount_factor_846`, standing in for whatever combination of (c)'s
// rate and (d)'s payment pattern a case's own actuarial determination
// produced), and (3) does NOT sum the per-line/per-accident-year figures
// into the single total `discounted_unpaid_losses` the statute's own (a)(1)
// "sum of" language describes — that summation is an aggregate-over-
// derived-predicates computation (AGENT-BRIEF §111 class), filed as
// TECH-GAPS.md G400. Section 846(b) (undiscounted unpaid losses, including
// the (b)(2) already-discounted-on-annual-statement adjustment), (e)(1)
// (accident year, folded into this module's own variable naming rather
// than a separate classification rule), and (f) (Secretary's regulatory
// authority — NON_NORMATIVE, no independent taxpayer-facing legal
// consequence) are the only other (sub)sections given their own rows here;
// (c) (the interest-rate determination itself), (d) (the payment-pattern
// determination itSelf, including the 10-year extension's running average),
// (e)(2)-(6) (unpaid loss adjustment expenses, annual statement, line of
// business, multiple peril lines, the accident-and-health special rule) are
// NOT modeled as separate rules — they describe how the Secretary computes
// the (c)/(d) inputs this package treats as EXTERNAL_DEPENDENCY, or are
// pure definitional glosses consumed implicitly by this module's relation
// signatures (e.g., a case's own `line_of_business`/`accident_year` values).

use self::{
    IRC_S846_A,
    IRC_S846_B,
    Person,
    TaxableYear,
};

@source(IRC_S846_B, quote = "the term \"undiscounted unpaid losses\" means the unpaid losses shown in the annual statement filed by the taxpayer for the year ending with or within the taxable year of the taxpayer")
pub relation undiscounted_unpaid_losses_846(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the undiscounted unpaid losses shown in the annual statement, for a line of business and accident year, per section 846(a)(1)/(b)(1) (the (b)(2) already-discounted-on-annual-statement adjustment is not separately modeled — a case asserts the already-adjusted figure)";
}
@source(IRC_S846_A, quote = "the applicable interest rate, and\n(C) the applicable loss payment pattern")
pub relation discount_factor_846(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, factor: Decimal) kind empirical {
    label en unofficial "the present-value discount factor combining the section 846(c) interest rate and the section 846(d) loss payment pattern for the line of business and accident year — EXTERNAL_DEPENDENCY (Treasury/NAIC-determined; not computed by this package from raw rate/pattern data, per the module header)";
}
@source(IRC_S846_A, quote = "The amount of the discounted unpaid losses as of the end of any taxable year attributable to any accident year shall be the present value of such losses (as of such time) determined by using—\n(A) the amount of the undiscounted unpaid losses as of such time,\n(B) the applicable interest rate, and\n(C) the applicable loss payment pattern.")
pub relation discounted_unpaid_losses_846_uncapped(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 846(a)(2): the present value of the undiscounted unpaid losses for the line of business and accident year, before the section 846(a)(3) limitation";
}
rule Section846a2PresentValue(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, undiscounted: Money, factor: Decimal) strict {
    label en official "section 846(a)(2): present value = undiscounted unpaid losses times the discount factor";
    when undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, undiscounted);
    when discount_factor_846(c, y, line_of_business, accident_year, factor);
    then discounted_unpaid_losses_846_uncapped(c, y, line_of_business, accident_year, round(undiscounted * factor, 2, "HALF_UP"));
}
@source(IRC_S846_A, quote = "In no event shall the amount of the discounted unpaid losses with respect to any line of business attributable to any accident year exceed the aggregate amount of unpaid losses with respect to such line of business for such accident year included on the annual statement filed by the taxpayer for the year ending with or within the taxable year.")
pub relation annual_statement_aggregate_unpaid_losses_846a3(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of unpaid losses for the line of business and accident year included on the annual statement, per section 846(a)(3)'s limitation";
}
@source(IRC_S846_A, quote = "In no event shall the amount of the discounted unpaid losses with respect to any line of business attributable to any accident year exceed the aggregate amount of unpaid losses with respect to such line of business for such accident year included on the annual statement filed by the taxpayer for the year ending with or within the taxable year.")
pub relation discounted_unpaid_losses_846_per_accident_year(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 846(a)(1)-(3): the discounted unpaid losses for the line of business and accident year, capped at the annual-statement aggregate";
}
rule Section846a3CapAtAnnualStatementAggregate(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, uncapped: Money, cap: Money) strict {
    label en official "section 846(a)(3): the present value, capped at the annual-statement aggregate, when the cap binds";
    when discounted_unpaid_losses_846_uncapped(c, y, line_of_business, accident_year, uncapped);
    when annual_statement_aggregate_unpaid_losses_846a3(c, y, line_of_business, accident_year, cap);
    when uncapped > cap;
    then discounted_unpaid_losses_846_per_accident_year(c, y, line_of_business, accident_year, cap);
}
rule Section846a3UncappedWhenBelowAggregate(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, uncapped: Money, cap: Money) strict {
    label en official "section 846(a)(3): the present value stands when it does not exceed the annual-statement aggregate";
    when discounted_unpaid_losses_846_uncapped(c, y, line_of_business, accident_year, uncapped);
    when annual_statement_aggregate_unpaid_losses_846a3(c, y, line_of_business, accident_year, cap);
    when uncapped <= cap;
    then discounted_unpaid_losses_846_per_accident_year(c, y, line_of_business, accident_year, uncapped);
}
rule Section846a3UncappedWhenNoAggregateFigure(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, uncapped: Money) defeasible {
    label en official "section 846(a)(3): when no annual-statement aggregate is supplied for the line/accident year, the present value stands uncapped";
    when discounted_unpaid_losses_846_uncapped(c, y, line_of_business, accident_year, uncapped);
    when not_known(annual_statement_aggregate_unpaid_losses_846a3(c, y, line_of_business, accident_year, uncapped));
    then discounted_unpaid_losses_846_per_accident_year(c, y, line_of_business, accident_year, uncapped);
}
// NOTE (honest limitation, TECH-GAPS.md G400): section 846(a)(1) defines
// "the amount of the discounted unpaid losses as of the end of any taxable
// year" as THE SUM, across every line of business and accident year, of
// the per-line/per-accident-year figures above. That summation is an
// aggregate over a derived (institutional) predicate with a variable
// number of (line_of_business, accident_year) keys per taxpayer/year — the
// same runtime-subset limitation class as this corpus's other "aggregates
// over derived predicates" gaps (AGENT-BRIEF §111). This package computes
// and exposes only the per-line/per-accident-year figure
// (`discounted_unpaid_losses_846_per_accident_year`); the portfolio-level
// total a taxpayer's own return would report is NOT derived here.
