// Sections 851(a)-(b) (regulated investment company defined: registration/
// election, the 90% income test, the 50%/25% diversification test) and
// 852(a)-(b) (RIC taxation: the 90% distribution requirement, investment
// company taxable income, the capital gain tax). Stage 1 (IRC-09 stage 1,
// A12), priority sections.
//
// METHOD: section 851(c) (the detailed "controls"/"controlled group"/
// "value" definitions feeding the 851(b)(3) diversification test) and
// 851(d)-(i) (status determination timing, § 4982 cross-references,
// personal holding company rules, common trust fund conversion, foreign
// currency) are NOT modeled at this stage — the diversification test below
// takes the "value of total assets represented by..." figures as CASE
// FACTS (an aggregate over case-asserted items, per the method note for
// this package), not derived from underlying holdings. Section 852(b)(4)
// (loss on stock held 6 months or less), (b)(5) (exempt-interest dividends)
// and (b)(6)-(9) are NOT modeled (outside "(a)-(b)" priority and each is a
// self-contained sub-scheme); their DISPOSITIONS rows stay unreviewed.
// The rate step of the section 852(b)(1)/(3)(A) tax amounts is
// `external_norm_unresolved` for the same `us.irc.corporations` reason as
// modules 02-03.

// ---- Section 851(a) ----

use self::{
    Corporation,
    IRC_S851_A,
    IRC_S851_B,
    IRC_S852_A,
    IRC_S852_B,
    Person,
    TaxableYear,
    distribution_exempt_from_section_897_852b3E,
};

@source(IRC_S851_A, quote = "the term \"regulated investment company\" means any domestic corporation")
pub relation domestic_corporation_candidate(c: Person) kind institutional {
    label en unofficial "a domestic corporation, per section 851(a): derived from the section 7701(a)(4) classification `us.irc.definitions::domestic` (WIRE-5); a case may still assert it directly for an entity the definitions package does not classify";
}
@source(IRC_S851_A, quote = "the term \"regulated investment company\" means any domestic corporation")
rule Section851aDomesticCorporationFromSection7701(c: Corporation) strict {
    label en official "section 851(a): the corporation is domestic within the meaning of section 7701(a)(4)";
    when us.irc.definitions::domestic(c);
    then domestic_corporation_candidate(c);
}
@source(IRC_S851_A, quote = "is registered under the Investment Company Act of 1940, as amended (15 U.S.C. 80a–1 to 80b–2) as a management company or unit investment trust")
pub relation registered_as_management_company_or_unit_investment_trust(c: Person) kind empirical {
    label en unofficial "registered under the Investment Company Act of 1940 as a management company or unit investment trust, at all times during the taxable year, per section 851(a)(1)(A)";
}
@source(IRC_S851_A, quote = "has in effect an election under such Act to be treated as a business development company")
pub relation elected_business_development_company_1940_act(c: Person) kind empirical {
    label en unofficial "has in effect an election under the Investment Company Act of 1940 to be treated as a business development company, per section 851(a)(1)(B)";
}
@source(IRC_S851_A, quote = "which is a common trust fund or similar fund excluded by section 3(c)(3) of such Act (15 U.S.C. 80a–3(c)) from the definition of \"investment company\" and is not included in the definition of \"common trust fund\" by section 584(a)")
pub relation common_trust_fund_excluded_by_1940_act_3c3(c: Person) kind empirical {
    label en unofficial "a common trust fund or similar fund excluded from \"investment company\" by section 3(c)(3) of the Investment Company Act of 1940, per section 851(a)(2)";
}
@source(IRC_S851_A, quote = "is not included in the definition of \"common trust fund\" by section 584(a)")
pub relation included_in_section_584a_common_trust_fund(c: Person) kind empirical {
    label en unofficial "included in the definition of \"common trust fund\" by section 584(a) (the negative condition of section 851(a)(2))";
}
@source(IRC_S851_A)
pub relation regulated_investment_company_candidate(c: Person) kind institutional {
    label en official "the section 851(a) general-rule candidate for \"regulated investment company\" status (before the section 851(b) limitations)";
}
rule Section851a1ByRegistration(c: Person) strict {
    label en official "section 851(a)(1)(A): a domestic corporation registered as a management company or unit investment trust is a candidate";
    when domestic_corporation_candidate(c);
    when registered_as_management_company_or_unit_investment_trust(c);
    then regulated_investment_company_candidate(c);
}
rule Section851a1ByBdcElection(c: Person) strict {
    label en official "section 851(a)(1)(B): a domestic corporation electing business development company treatment is a candidate";
    when domestic_corporation_candidate(c);
    when elected_business_development_company_1940_act(c);
    then regulated_investment_company_candidate(c);
}
rule Section851a2ByCommonTrustFund(c: Person) strict {
    label en official "section 851(a)(2): a domestic corporation that is an excluded common trust fund and not a section 584(a) common trust fund is a candidate";
    when domestic_corporation_candidate(c);
    when common_trust_fund_excluded_by_1940_act_3c3(c);
    when not_known(included_in_section_584a_common_trust_fund(c));
    then regulated_investment_company_candidate(c);
}

// ---- Section 851(b) ----

@source(IRC_S851_B, quote = "it files with its return for the taxable year an election to be a regulated investment company or has made such election for a previous taxable year")
pub relation elects_regulated_investment_company_status(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "an election to be a regulated investment company, filed with the return for the taxable year or a previous one, per section 851(b)(1)";
}
@source(IRC_S851_B)
pub relation qualifying_gross_income_851b2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross income derived from the section 851(b)(2)(A)-(B) qualifying sources (dividends, interest, securities gains, qualified PTP income, etc.) for the taxable year";
}
pub relation total_gross_income_851(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "total gross income of the company for the taxable year, per section 851(b)(2)";
}
@source(IRC_S851_B, quote = "at least 90 percent of its gross income is derived from—")
pub relation ninety_percent_income_test_met_851b2(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 851(b)(2) 90 percent qualifying-gross-income test is met for the taxable year";
}
rule Section851b2NinetyPercentIncomeTest(c: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 851(b)(2): qualifying gross income is at least 90 percent of total gross income";
    when qualifying_gross_income_851b2(c, y, qualifying);
    when total_gross_income_851(c, y, total);
    when qualifying * 100 >= total * 90;
    then ninety_percent_income_test_met_851b2(c, y);
}

@source(IRC_S851_B)
pub relation cash_govt_and_qualifying_other_ric_securities_value(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of cash, cash items, Government securities, securities of other RICs, and other securities qualifying under the 5%/10% per-issuer limits of section 851(b)(3)(A)(ii), at the close of a quarter";
}
pub relation total_assets_value_851(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of total assets of the company at the close of a quarter of the taxable year, per section 851(b)(3)";
}
@source(IRC_S851_B, quote = "at least 50 percent of the value of its total assets is represented by—")
pub relation fifty_percent_asset_test_met_851b3a(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 851(b)(3)(A) 50 percent asset test is met at the close of a quarter";
}
rule Section851b3AFiftyPercentAssetTest(c: Person, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 851(b)(3)(A): qualifying cash/Government/RIC/limited-other securities are at least 50 percent of total asset value";
    when cash_govt_and_qualifying_other_ric_securities_value(c, y, qualifying);
    when total_assets_value_851(c, y, total);
    when qualifying * 100 >= total * 50;
    then fifty_percent_asset_test_met_851b3a(c, y);
}

@source(IRC_S851_B)
pub relation single_issuer_securities_value_851(c: Person, y: TaxableYear, issuer: Person, amount: Money) kind empirical {
    label en unofficial "the value of securities of one issuer (other than Government securities or securities of other RICs), at the close of a quarter, per section 851(b)(3)(B)(i)";
}
@source(IRC_S851_B, quote = "not more than 25 percent of the value of its total assets is invested in—")
pub relation twenty_five_percent_asset_test_met_851b3b(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 851(b)(3)(B)(i) 25 percent single-issuer asset test is met at the close of a quarter (the (ii)-(iii) controlled-group/PTP branches are not modeled)";
}
rule Section851b3BTwentyFivePercentAssetTest(c: Person, y: TaxableYear, issuer: Person, issuer_value: Money, total: Money) strict {
    label en official "section 851(b)(3)(B)(i): no single issuer's securities exceed 25 percent of total asset value";
    when total_assets_value_851(c, y, total);
    when single_issuer_securities_value_851(c, y, issuer, issuer_value);
    when issuer_value * 100 <= total * 25;
    then twenty_five_percent_asset_test_met_851b3b(c, y);
}

@source(IRC_S851_B)
pub relation regulated_investment_company(c: Person, y: TaxableYear) kind institutional {
    label en official "a regulated investment company for the taxable year, per section 851(a)-(b)";
}
rule Section851bRegulatedInvestmentCompanyStatus(c: Person, y: TaxableYear) strict {
    label en official "section 851(a)-(b): the general-rule candidate plus the election, 90% income test, 50% and 25% asset tests together confer RIC status";
    when regulated_investment_company_candidate(c);
    when elects_regulated_investment_company_status(c, y);
    when ninety_percent_income_test_met_851b2(c, y);
    when fifty_percent_asset_test_met_851b3a(c, y);
    when twenty_five_percent_asset_test_met_851b3b(c, y);
    then regulated_investment_company(c, y);
}

// ---- Section 852(a) ----

@source(IRC_S852_A, quote = "the deduction for dividends paid during the taxable year (as defined in section 561, but without regard to capital gain dividends)")
pub relation dividends_paid_deduction(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction for dividends paid during the taxable year, as defined in section 561, without regard to capital gain dividends (section 561 is not modeled at this stage; asserted as a case fact)";
}
@source(IRC_S852_A, quote = "its investment company taxable income for the taxable year determined without regard to subsection (b)(2)(D)")
pub relation investment_company_taxable_income_without_b2d(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "investment company taxable income determined without regard to the section 852(b)(2)(D) dividends-paid deduction, per section 852(a)(1)(A)";
}
pub relation tax_exempt_interest_income_103a(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "interest income excludable from gross income under section 103(a), per section 852(a)(1)(B)(i)";
}
pub relation disallowed_deductions_265_171a2(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "deductions disallowed under sections 265 and 171(a)(2), per section 852(a)(1)(B)(ii)";
}
@source(IRC_S852_A)
pub relation section_852a1_distribution_requirement_met(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 852(a)(1) 90 percent distribution requirement is met for the taxable year";
}
rule Section852a1DistributionRequirement(c: Person, y: TaxableYear, dpd: Money, ictiw: Money, exempt: Money, disallowed: Money) strict {
    label en official "section 852(a)(1): dividends paid deduction >= 90% of (ICTI without (b)(2)(D)) + 90% of (exempt interest income - disallowed 265/171(a)(2) deductions)";
    when dividends_paid_deduction(c, y, dpd);
    when investment_company_taxable_income_without_b2d(c, y, ictiw);
    when tax_exempt_interest_income_103a(c, y, exempt);
    when disallowed_deductions_265_171a2(c, y, disallowed);
    when dpd >= (round(ictiw * 0.90, 2, "HALF_UP") + round((exempt - disallowed) * 0.90, 2, "HALF_UP"));
    then section_852a1_distribution_requirement_met(c, y);
}

@source(IRC_S852_A, quote = "the provisions of this part applied to the investment company for all taxable years ending on or after November 8, 1983")
pub relation part_i_applied_since_1983_11_08(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the provisions of subchapter M, part I applied to the investment company for all taxable years ending on or after November 8, 1983, per section 852(a)(2)(A)";
}
@source(IRC_S852_A, quote = "as of the close of the taxable year, the investment company has no earnings and profits accumulated in any taxable year to which the provisions of this part (or the corresponding provisions of prior law) did not apply to it")
pub relation no_accumulated_earnings_from_non_ric_years(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "as of the close of the taxable year, no earnings and profits accumulated in a year to which part I (or its prior-law equivalent) did not apply, per section 852(a)(2)(B)";
}
@source(IRC_S852_A)
pub relation section_852a2_condition_met(c: Person, y: TaxableYear) kind institutional {
    label en official "the section 852(a)(2) alternative history condition is met for the taxable year";
}
rule Section852a2ByLongStanding(c: Person, y: TaxableYear) strict {
    label en official "section 852(a)(2)(A): the company has been under part I since November 8, 1983";
    when part_i_applied_since_1983_11_08(c, y);
    then section_852a2_condition_met(c, y);
}
rule Section852a2ByNoTaintedEarnings(c: Person, y: TaxableYear) strict {
    label en official "section 852(a)(2)(B): the company has no accumulated earnings from a non-RIC year";
    when no_accumulated_earnings_from_non_ric_years(c, y);
    then section_852a2_condition_met(c, y);
}

@source(IRC_S852_A)
pub relation subchapter_m_part_i_applies(c: Person, y: TaxableYear) kind institutional {
    label en official "subchapter M, part I applies to the regulated investment company for the taxable year (section 852(a))";
}
rule Section852aPartIApplies(c: Person, y: TaxableYear) strict {
    label en official "section 852(a): part I applies when the company is a RIC and both the distribution requirement and the (a)(2) condition are met";
    when regulated_investment_company(c, y);
    when section_852a1_distribution_requirement_met(c, y);
    when section_852a2_condition_met(c, y);
    then subchapter_m_part_i_applies(c, y);
}

// ---- Section 852(b) ----

// (b)(1): tax on investment company taxable income at section 11 rates —
// STAGE 2 (WIRE-2, 25.09.2026) wires the rate step to `us.irc.corporations`'s
// `pub corporate_tax_rate(c, y, rate)` export (module 02's header of
// `us.irc.special_entities` explains the keying mechanism); the base is
// modeled below.

pub relation net_capital_gain_ric(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "net capital gain of the regulated investment company for the taxable year, per section 852(b)(2)(A)";
}
pub relation ric_taxable_income_before_852b2_adjustments(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxable income of the regulated investment company computed under the normal rules, before the section 852(b)(2) adjustments";
}
pub relation nol_deduction_previously_allowed_172(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the section 172 net operating loss deduction taken into account in the base taxable income figure, to be added back per section 852(b)(2)(B)";
}
pub relation dividends_received_deduction_previously_allowed_part_viii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the part VIII (other than section 248) dividends-received-type deductions taken into account in the base taxable income figure, to be added back per section 852(b)(2)(C)";
}
@source(IRC_S852_B, quote = "The deduction for dividends paid (as defined in section 561) shall be allowed, but shall be computed without regard to capital gain dividends and exempt-interest dividends.")
pub relation dividends_paid_deduction_852b2d(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction for dividends paid, computed without regard to capital gain dividends and exempt-interest dividends, per section 852(b)(2)(D)";
}
@source(IRC_S852_B, quote = "There shall be deducted an amount equal to the tax imposed by subsections (d)(2) and (i) of section 851 for the taxable year.")
pub relation section_851_d2_and_i_tax_amount(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of tax imposed by section 851(d)(2) and (i) for the taxable year, deducted per section 852(b)(2)(G)";
}
@source(IRC_S852_B)
pub relation investment_company_taxable_income(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "investment company taxable income for the taxable year, per section 852(b)(2)(A)-(D),(G) (the (E)-(F) method-of-computation adjustments are not separately modeled)";
}
rule Section852b2InvestmentCompanyTaxableIncome(c: Person, y: TaxableYear, base: Money, gain: Money, nol: Money, drd: Money, dpd: Money, tax851: Money) strict {
    label en official "section 852(b)(2): ICTI = base taxable income - net capital gain + NOL add-back + part VIII deduction add-back - dividends paid deduction (b2d) - section 851(d)(2)/(i) tax";
    when ric_taxable_income_before_852b2_adjustments(c, y, base);
    when net_capital_gain_ric(c, y, gain);
    when nol_deduction_previously_allowed_172(c, y, nol);
    when dividends_received_deduction_previously_allowed_part_viii(c, y, drd);
    when dividends_paid_deduction_852b2d(c, y, dpd);
    when section_851_d2_and_i_tax_amount(c, y, tax851);
    then investment_company_taxable_income(c, y, ((((base - gain) + nol) + drd) - dpd) - tax851);
}

// (b)(1)'s rate step, wired to `us.irc.corporations`'s stage 2
// `pub corporate_tax_rate(c, y, rate)` export (STAGE 2, WIRE-2; see module
// 02's header in this package for the keying mechanism).
@source(IRC_S852_B, quote = "There is hereby imposed for each taxable year upon the investment company taxable income of every regulated investment company a tax computed as provided in section 11, as though the investment company taxable income were the taxable income referred to in section 11.")
pub relation ric_tax(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 852(b)(1): investment company taxable income taxed at the section 11 rate, as though it were section 11 taxable income";
}
rule Section852b1RicTax(c: Corporation, y: TaxableYear, income: Money, rate: Decimal) strict {
    label en official "section 852(b)(1): the tax is the section 11 rate applied to investment company taxable income";
    when investment_company_taxable_income(c, y, income);
    when us.irc.corporations::corporate_tax_rate(c, y, rate);
    then ric_tax(c, y, round(income * rate, 2, "HALF_UP"));
}

// (b)(3)(A) capital gains tax base; (B) shareholder treatment classification.
@source(IRC_S852_B, quote = "the excess, if any, of the net capital gain over the deduction for dividends paid (as defined in section 561) determined with reference to capital gain dividends only")
pub relation capital_gain_dividends_paid_852(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the deduction for dividends paid, determined with reference to capital gain dividends only, per section 852(b)(3)(A)";
}
@source(IRC_S852_B, quote = "There is hereby imposed for each taxable year in the case of every regulated investment company a tax, determined as provided in section 11(b), on the excess, if any, of the net capital gain over the deduction for dividends paid (as defined in section 561) determined with reference to capital gain dividends only.")
pub relation ric_capital_gain_tax_base(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 852(b)(3)(A) tax base: net capital gain minus capital gain dividends paid, if positive";
}
rule Section852b3ACapitalGainTaxBase(c: Person, y: TaxableYear, gain: Money, paid: Money) strict {
    label en official "section 852(b)(3)(A): the capital gain tax base is net capital gain minus capital gain dividends paid, when positive";
    when net_capital_gain_ric(c, y, gain);
    when capital_gain_dividends_paid_852(c, y, paid);
    when gain > paid;
    then ric_capital_gain_tax_base(c, y, gain - paid);
}
// (b)(3)(A)'s rate step ("determined as provided in section 11(b)"), wired
// the same way (STAGE 2, WIRE-2). Not one of the ten names the task lists,
// but modeled alongside `ric_tax` since the base was already fully modeled
// in stage 1 and the same mechanism applies without new judgment calls.
pub relation ric_capital_gain_tax(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 852(b)(3)(A): the capital gain tax base taxed at the section 11(b) rate";
}
rule Section852b3ARicCapitalGainTax(c: Corporation, y: TaxableYear, base: Money, rate: Decimal) strict {
    label en official "section 852(b)(3)(A): the tax is the section 11(b) rate applied to the capital gain tax base";
    when ric_capital_gain_tax_base(c, y, base);
    when us.irc.corporations::corporate_tax_rate(c, y, rate);
    then ric_capital_gain_tax(c, y, round(base * rate, 2, "HALF_UP"));
}
@source(IRC_S852_B, quote = "A capital gain dividend shall be treated by the shareholders as a gain from the sale or exchange of a capital asset held for more than 1 year.")
pub relation capital_gain_dividend_852(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment) kind institutional {
    label en unofficial "a dividend, or part of one, reported by the company as a capital gain dividend under section 852(b)(3)(C) (stage 3: derived in module 33 from the reported amounts and the excess reported amount rule of (C); a case may still assert it)";
}
pub relation treated_as_long_term_capital_gain_by_shareholder(shareholder: Person, dividend_id: us.irc.core::Payment) kind institutional {
    label en official "the shareholder treats the capital gain dividend as gain from a capital asset held more than one year (section 852(b)(3)(B))";
}
pub relation shareholder_received_dividend(shareholder: Person, dividend_id: us.irc.core::Payment) kind empirical {
    label en unofficial "the shareholder received the dividend (case fact binding a shareholder to a capital gain dividend of the regulated investment company)";
}
rule Section852b3BShareholderTreatment(shareholder: Person, c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment) defeasible {
    label en official "section 852(b)(3)(B): a capital gain dividend is treated by the shareholder as long-term capital gain";
    when capital_gain_dividend_852(c, y, dividend_id);
    when shareholder_received_dividend(shareholder, dividend_id);
    // Stage 3 (26.09.2026): section 852(b)(3)(E), module 33.
    when not_known(distribution_exempt_from_section_897_852b3E(dividend_id));
    then treated_as_long_term_capital_gain_by_shareholder(shareholder, dividend_id);
}
