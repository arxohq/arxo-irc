// Section 852(b)(5)(A)(iii)(II), (iv)(IV) (exempt-interest dividends of a
// regulated investment company: the special rule for noncalendar taxable
// years and the post-December reported amount). Stage 3 (IRC-09 stage 3,
// TECH_GAP reduction), 26.09.2026. Status implemented_unverified; nothing
// here was executed.
//
// METHOD. The calendar/noncalendar classification of the year and the
// December 31 within a noncalendar year are the case's inputs (the same
// relations as module 33, section 852(b)(3)(C)); the payment date of each
// reported exempt-interest dividend is a new empirical row. The special
// rule replaces the general allocation of module 12 (which is guarded by
// `not_known(noncalendar_special_rule_applies_852b5Aiii)`): when the
// post-December reported amount equals or exceeds the excess reported
// amount, the excess is allocated over the post-December reported amount,
// and none is allocated to a dividend paid on or before December 31.

use self::{
    IRC_S852_B,
    Person,
    TaxableYear,
    december_31_within_year_852b3Ciii,
    excess_reported_amount_852b5,
    excess_reported_amount_allocable_852b5,
    noncalendar_taxable_year_852b3C,
    reported_exempt_interest_dividend_amount,
};

pub relation exempt_interest_dividend_paid_on_852b5(dividend_id: us.irc.core::Payment, paid_on: Date) kind empirical {
    label en unofficial "the date the reported exempt-interest dividend was paid";
}
pub relation reported_after_december_852b5(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a reported exempt-interest dividend paid after December 31 of the taxable year";
}
rule Section852b5AivIVReportedAfterDecember(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money, paid: Date, dec31: Date) strict {
    label en official "section 852(b)(5)(A)(iv)(IV): a reported exempt-interest dividend paid after December 31 of the taxable year";
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, amount);
    when exempt_interest_dividend_paid_on_852b5(dividend_id, paid);
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid > dec31;
    then reported_after_december_852b5(c, y, dividend_id, amount);
}
pub relation post_december_reported_amount_852b5(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the post-December reported amount: the aggregate reported amount taking into account only dividends paid after December 31 of the taxable year";
}
@source(IRC_S852_B, quote = "The term \"post-December reported amount\" means the aggregate reported amount determined by taking into account only dividends paid after December 31 of the taxable year.")
rule Section852b5AivIVPostDecember(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) strict {
    label en official "section 852(b)(5)(A)(iv)(IV): the sum of the reported exempt-interest dividends paid after December 31";
    when reported_after_december_852b5(c, y, anchor, anchor_amount);
    then post_december_reported_amount_852b5(c, y, sum all amount: Money for d: us.irc.core::Payment where reported_after_december_852b5(c, y, d, amount));
}
pub relation noncalendar_special_rule_applies_852b5Aiii(c: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year does not begin and end in the same calendar year and the post-December reported amount equals or exceeds the excess reported amount";
}
@source(IRC_S852_B, quote = "In the case of any taxable year which does not begin and end in the same calendar year, if the post-December reported amount equals or exceeds the excess reported amount for such taxable year")
rule Section852b5AiiiIIApplies(c: Person, y: TaxableYear, post_dec: Money, excess: Money) strict {
    label en official "section 852(b)(5)(A)(iii)(II): a noncalendar year whose post-December reported amount is at least the excess";
    when noncalendar_taxable_year_852b3C(c, y);
    when post_december_reported_amount_852b5(c, y, post_dec);
    when excess_reported_amount_852b5(c, y, excess);
    when post_dec >= excess;
    then noncalendar_special_rule_applies_852b5Aiii(c, y);
}
@source(IRC_S852_B, quote = "no excess reported amount shall be allocated to any dividend paid on or before December 31 of such taxable year")
rule Section852b5AiiiIIEarlyDividendNoExcess(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money, paid: Date, dec31: Date) strict {
    label en official "section 852(b)(5)(A)(iii)(II): no excess reported amount is allocated to a dividend paid on or before December 31";
    when noncalendar_special_rule_applies_852b5Aiii(c, y);
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, amount);
    when exempt_interest_dividend_paid_on_852b5(dividend_id, paid);
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid <= dec31;
    then excess_reported_amount_allocable_852b5(c, y, dividend_id, 0.00 USD);
}
@source(IRC_S852_B, quote = "subclause (I) shall be applied by substituting \"post-December reported amount\" for \"aggregate reported amount\"")
rule Section852b5AiiiIILateDividendAllocation(c: Person, y: TaxableYear, dividend_id: us.irc.core::Payment, amount: Money, paid: Date, dec31: Date, excess: Money, post_dec: Money) strict {
    label en official "section 852(b)(5)(A)(iii)(II): the excess is allocated in the ratio of the reported amount to the post-December reported amount (one rounding)";
    when noncalendar_special_rule_applies_852b5Aiii(c, y);
    when reported_exempt_interest_dividend_amount(c, y, dividend_id, amount);
    when exempt_interest_dividend_paid_on_852b5(dividend_id, paid);
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid > dec31;
    when excess_reported_amount_852b5(c, y, excess);
    when post_december_reported_amount_852b5(c, y, post_dec);
    then excess_reported_amount_allocable_852b5(c, y, dividend_id, div_round(excess * (amount / 1.00 USD), post_dec / 1.00 USD, 2, "HALF_UP"));
}
