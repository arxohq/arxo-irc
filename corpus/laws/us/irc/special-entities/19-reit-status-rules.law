// Sections 856(e)-(n) (real estate investment trusts: foreclosure property
// and its election, the termination, revocation and re-election bar of the
// REIT election, the closely-held test and the pension-trust look-through,
// qualified REIT subsidiaries, shared appreciation provisions, the
// reasonable-diligence relief, taxable REIT subsidiaries, the securities
// that are not counted for the 10 percent value test, and foreign currency
// gains). Stage 2c (IRC-09 stage 2c, A12), 26.09.2026. Status
// implemented_unverified.
//
// METHOD. A REIT's taxable year is the calendar year (section 859), so
// "the close of the 3d taxable year following the year of acquisition" is
// the end date of the acquisition year plus 36 calendar months, and the
// health care and extension periods are 24 and 72 months. Ordinal
// positions of taxable years ("the 5th taxable year that begins after ...")
// are asserted, because the core has no year-navigation term (TECH-GAPS
// G2201). The Secretary's discretionary grants (extension, waiver, consent)
// are case facts named in each relation, not derived.

// ---- Section 856(e): foreclosure property ----

use self::{
    Corporation,
    IRC_S856_E,
    IRC_S856_G,
    IRC_S856_H,
    IRC_S856_I,
    IRC_S856_J,
    IRC_S856_K,
    IRC_S856_L,
    IRC_S856_M,
    IRC_S856_N,
    Person,
    TaxableYear,
    contingency_absent_or_permitted_856m2B,
    reit_failure_due_to_reasonable_cause_not_willful_neglect,
    trs_election_revoked_856l1,
    wholly_owned_by_reit_excluded_856l2,
};

pub relation reit_acquired_property_on_856e(t: Person, p: us.irc.core::Asset, acquired_on: Date) kind empirical {
    label en unofficial "the trust acquired the property on this date, by bidding it in at foreclosure or by otherwise reducing it to ownership or possession by agreement or process of law";
}
pub relation reit_acquisition_year_856e(t: Person, p: us.irc.core::Asset, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which the trust acquired the property";
}
pub relation default_or_imminent_default_856e1(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "there was default (or default was imminent) on a lease of the property or on an indebtedness which the property secured";
}
pub relation acquired_on_lease_termination_not_default_856e6A(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is a qualified health care property acquired as the result of the termination of a lease other than a termination by reason of a default, or the imminence of a default, on the lease";
}
pub relation qualified_health_care_property_856e6D(p: us.irc.core::Asset) kind institutional {
    label en unofficial "the property is real property (or incident personal property) that is a health care facility or is necessary or incidental to the use of one (a hospital, nursing facility, assisted living facility, congregate care facility, qualified continuing care facility or other licensed facility extending medical, nursing or ancillary services)";
}
pub relation foreclosure_property_by_acquisition_856e1(t: Person, p: us.irc.core::Asset) kind institutional {
    label en official "the property is foreclosure property by its acquisition (section 856(e)(1)), or a qualified health care property acquired on a non-default lease termination (section 856(e)(6)(A))";
}
@source(IRC_S856_E, quote = "the term \"foreclosure property\" means any real property (including interests in real property), and any personal property incident to such real property, acquired by the real estate investment trust as the result of such trust having bid in such property at foreclosure")
rule Section856e1ForeclosureAcquisition(t: Person, p: us.irc.core::Asset, acquired_on: Date) strict {
    label en official "section 856(e)(1): property acquired at foreclosure or by agreement or process of law after a default (or imminent default)";
    when reit_acquired_property_on_856e(t, p, acquired_on);
    when default_or_imminent_default_856e1(t, p);
    then foreclosure_property_by_acquisition_856e1(t, p);
}
@source(IRC_S856_E, quote = "The term \"foreclosure property\" shall include any qualified health care property acquired by a real estate investment trust as the result of the termination of a lease of such property")
rule Section856e6AHealthCareLeaseTermination(t: Person, p: us.irc.core::Asset, acquired_on: Date) strict {
    label en official "section 856(e)(6)(A): a qualified health care property acquired on a non-default lease termination is foreclosure property";
    when reit_acquired_property_on_856e(t, p, acquired_on);
    when qualified_health_care_property_856e6D(p);
    when acquired_on_lease_termination_not_default_856e6A(t, p);
    then foreclosure_property_by_acquisition_856e1(t, p);
}
pub relation foreclosure_election_made_on_856e5(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the trust elects, in the manner provided in regulations, that the property be treated as foreclosure property, on this date";
}
pub relation acquisition_year_return_due_date_with_extensions_856e5(t: Person, p: us.irc.core::Asset, due: Date) kind empirical {
    label en unofficial "the due date (including extensions) for the return of tax for the taxable year in which the trust acquired the property";
}
pub relation foreclosure_election_timely_856e5(t: Person, p: us.irc.core::Asset) kind institutional {
    label en official "the election is made on or before the due date, including extensions, of the return for the acquisition year";
}
rule Section856e5ElectionTimely(t: Person, p: us.irc.core::Asset, made_on: Date, due: Date) strict {
    label en official "section 856(e)(5): the election is made on or before the return due date for the acquisition year";
    when foreclosure_election_made_on_856e5(t, p, made_on);
    when acquisition_year_return_due_date_with_extensions_856e5(t, p, due);
    when made_on <= due;
    then foreclosure_election_timely_856e5(t, p);
}
pub relation foreclosure_property_election_in_effect_856e5(t: Person, p: us.irc.core::Asset) kind institutional {
    label en official "the property is treated as foreclosure property for the part: the trust's election is in effect";
}
@source(IRC_S856_E, quote = "Property shall be treated as foreclosure property for purposes of this part only if the real estate investment trust so elects")
rule Section856e5ElectionPower(t: Person, p: us.irc.core::Asset, made_on: Date) strict {
    label en official "section 856(e)(5): foreclosure property treatment requires a timely election by the trust";
    when foreclosure_election_made_on_856e5(t, p, made_on);
    then power ForeclosurePropertyElection {
        holder t;
        over p;
        exercise foreclosure_election_made_on_856e5(t, p, made_on);
        valid_when foreclosure_election_timely_856e5(t, p);
        effect create(foreclosure_property_election_in_effect_856e5(t, p));
        window [@1960-01-01, infinity);
    };
}
pub relation foreclosure_election_revoked_on_856e5(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the trust files a revocation of the election on this date";
}
@source(IRC_S856_E, quote = "A real estate investment trust may revoke any such election for a taxable year by filing the revocation")
rule Section856e5RevocationPower(t: Person, p: us.irc.core::Asset, on: Date) strict {
    label en official "section 856(e)(5): the trust may revoke its foreclosure property election";
    when foreclosure_election_revoked_on_856e5(t, p, on);
    then power ForeclosurePropertyElectionRevocation {
        holder t;
        over p;
        exercise foreclosure_election_revoked_on_856e5(t, p, on);
        valid_when foreclosure_property_election_in_effect_856e5(t, p);
        effect terminate(foreclosure_property_election_in_effect_856e5(t, p));
        window [@1960-01-01, infinity);
    };
}
// Ceasing events, (e)(4).
pub relation lease_giving_nonqualifying_income_entered_on_856e4A(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "a lease is entered into with respect to the property which by its terms will give rise to income not described in subsection (c)(3) (other than subparagraph (F)), or an amount is received or accrued pursuant to such a lease that is not so described, on this date";
}
pub relation construction_on_property_on_856e4B(t: Person, p: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "construction takes place on the property on this date";
}
pub relation construction_completion_exception_856e4B(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the construction is the completion of a building or other improvement where more than 10 percent of the construction was completed before default became imminent";
}
pub relation property_used_in_trade_or_business_of_trust_on_856e4C(t: Person, p: us.irc.core::Asset, on: Date) kind institutional {
    label en unofficial "on this date the property is used in a trade or business conducted by the trust other than through an independent contractor or a taxable REIT subsidiary";
}
pub relation foreclosure_property_ceasing_event_on_856e4(t: Person, p: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a day on which the property ceases to be foreclosure property under section 856(e)(4)";
}
@source(IRC_S856_E, quote = "a lease is entered into with respect to such property which, by its terms, will give rise to income which is not described in subsection (c)(3)")
rule Section856e4ANonqualifyingLease(t: Person, p: us.irc.core::Asset, on: Date) strict {
    label en official "section 856(e)(4)(A): a lease giving rise to income outside (c)(3)";
    when lease_giving_nonqualifying_income_entered_on_856e4A(t, p, on);
    then foreclosure_property_ceasing_event_on_856e4(t, p, on);
}
@source(IRC_S856_E, quote = "any construction takes place on such property (other than completion of a building, or completion of any other improvement, where more than 10 percent of the construction of such building or other improvement was completed before default became imminent)")
rule Section856e4BConstruction(t: Person, p: us.irc.core::Asset, on: Date) strict {
    label en official "section 856(e)(4)(B): construction other than completing an improvement more than 10 percent built before default";
    when construction_on_property_on_856e4B(t, p, on);
    when not_known(construction_completion_exception_856e4B(t, p));
    then foreclosure_property_ceasing_event_on_856e4(t, p, on);
}
@source(IRC_S856_E, quote = "if such day is more than 90 days after the day on which such property was acquired by the real estate investment trust and the property is used in a trade or business which is conducted by the trust")
rule Section856e4CTradeOrBusinessUse(t: Person, p: us.irc.core::Asset, on: Date, acquired_on: Date) strict {
    label en official "section 856(e)(4)(C): use in the trust's own trade or business on a day more than 90 days after acquisition";
    when reit_acquired_property_on_856e(t, p, acquired_on);
    when property_used_in_trade_or_business_of_trust_on_856e4C(t, p, on);
    when on > add_calendar_period(acquired_on, 90 calendar_day);
    then foreclosure_property_ceasing_event_on_856e4(t, p, on);
}
pub relation ceasing_event_by_year_end_856e4(t: Person, p: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "a section 856(e)(4) ceasing event has occurred on or before the end of the taxable year";
}
rule Section856e4EventByYearEnd(t: Person, p: us.irc.core::Asset, y: TaxableYear, on: Date, ends_on: Date) strict {
    label en official "helper: a ceasing event no later than the year end";
    when foreclosure_property_ceasing_event_on_856e4(t, p, on);
    when us.irc.core::ends(y, ends_on);
    when on <= ends_on;
    then ceasing_event_by_year_end_856e4(t, p, y);
}
pub relation secretary_extension_granted_856e3(t: Person, p: us.irc.core::Asset) kind empirical {
    label en unofficial "the Secretary has granted the one extension of the grace period for the property (on the trust's showing that it is necessary for the orderly liquidation of the trust's interests)";
}
pub relation grace_period_end_856e(t: Person, p: us.irc.core::Asset, end: Date) kind institutional {
    label en official "the close of the last taxable year in which the property remains foreclosure property, apart from ceasing events";
}
@source(IRC_S856_E, quote = "property shall cease to be foreclosure property with respect to the real estate investment trust as of the close of the 3d taxable year following the taxable year in which the trust acquired such property")
rule Section856e2ThreeYears(t: Person, p: us.irc.core::Asset, y: TaxableYear, acq_end: Date) strict {
    label en official "section 856(e)(2): the grace period ends at the close of the 3d taxable year following the acquisition year";
    when reit_acquisition_year_856e(t, p, y);
    when us.irc.core::ends(y, acq_end);
    when not_known(secretary_extension_granted_856e3(t, p));
    when not_known(qualified_health_care_property_856e6D(p));
    then grace_period_end_856e(t, p, add_calendar_period(acq_end, 36 calendar_month));
}
@source(IRC_S856_E, quote = "Any such extension shall not extend the grace period beyond the close of the 3d taxable year following the last taxable year in the period under paragraph (2).")
rule Section856e3ExtensionSixYears(t: Person, p: us.irc.core::Asset, y: TaxableYear, acq_end: Date) strict {
    label en official "section 856(e)(3): one extension, to no later than the close of the 3d year after the last year of the (2) period (the 6th year after acquisition)";
    when reit_acquisition_year_856e(t, p, y);
    when us.irc.core::ends(y, acq_end);
    when secretary_extension_granted_856e3(t, p);
    then grace_period_end_856e(t, p, add_calendar_period(acq_end, 72 calendar_month));
}
@source(IRC_S856_E, quote = "the qualified health care property shall cease to be foreclosure property as of the close of the second taxable year after the taxable year in which such trust acquired such property")
rule Section856e6BHealthCareTwoYears(t: Person, p: us.irc.core::Asset, y: TaxableYear, acq_end: Date) strict {
    label en official "section 856(e)(6)(B)(i): a health care property that is foreclosure property solely by reason of (A) ceases at the close of the 2d year after acquisition";
    when reit_acquisition_year_856e(t, p, y);
    when us.irc.core::ends(y, acq_end);
    when acquired_on_lease_termination_not_default_856e6A(t, p);
    when not_known(secretary_extension_granted_856e3(t, p));
    then grace_period_end_856e(t, p, add_calendar_period(acq_end, 24 calendar_month));
}
@source(IRC_S856_E, quote = "Any such extension shall not extend the grace period beyond the close of the 6th year after the taxable year in which such trust acquired such qualified health care property.")
rule Section856e6BiiHealthCareExtension(t: Person, p: us.irc.core::Asset, y: TaxableYear, acq_end: Date) strict {
    label en official "section 856(e)(6)(B)(ii): extensions of a health care property's grace period never beyond the 6th year after acquisition";
    when reit_acquisition_year_856e(t, p, y);
    when us.irc.core::ends(y, acq_end);
    when acquired_on_lease_termination_not_default_856e6A(t, p);
    when secretary_extension_granted_856e3(t, p);
    then grace_period_end_856e(t, p, add_calendar_period(acq_end, 72 calendar_month));
}
pub relation foreclosure_property_for_year_856e(t: Person, p: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the property is foreclosure property for the whole taxable year: acquired by foreclosure, elected, within the grace period and with no ceasing event by the year end (a ceasing event inside the year makes it foreclosure property for only part of the year, TECH-GAPS G2207)";
}
@source(IRC_S856_E, quote = "For purposes of this part, the term \"foreclosure property\" means")
rule Section856eForeclosurePropertyForYear(t: Person, p: us.irc.core::Asset, y: TaxableYear, ends_on: Date, grace_end: Date) strict {
    label en official "section 856(e)(1)-(6): the elected property is foreclosure property through the grace period unless a ceasing event occurs";
    when foreclosure_property_by_acquisition_856e1(t, p);
    when foreclosure_property_election_in_effect_856e5(t, p);
    when grace_period_end_856e(t, p, grace_end);
    when us.irc.core::ends(y, ends_on);
    when ends_on <= grace_end;
    when not_known(ceasing_event_by_year_end_856e4(t, p, y));
    then foreclosure_property_for_year_856e(t, p, y);
}

// ---- Section 856(g): termination, revocation and re-election bar ----

pub relation not_a_reit_to_which_part_applies_for_year_856g1(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the corporation, trust or association is not a real estate investment trust to which part II applies for the taxable year";
}
pub relation reit_election_year_begins_856g(t: Person, y: TaxableYear, begins_on: Date) kind empirical {
    label en unofficial "the first day of the taxable year";
}
pub relation section_856g5_relief_applies(t: Person, y: TaxableYear) kind institutional {
    label en official "paragraph (5) applies: the failures are due to reasonable cause and the penalty is paid";
}
pub relation reit_election_terminated_856g1(t: Person, y: TaxableYear) kind institutional {
    label en official "the section 856(c)(1) election terminates, effective for the taxable year in which the trust is not a REIT and all succeeding years";
}
@source(IRC_S856_G, quote = "An election under subsection (c)(1) made by a corporation, trust, or association shall terminate if the corporation, trust, or association is not a real estate investment trust to which the provisions of this part apply for the taxable year with respect to which the election is made")
rule Section856g1Termination(t: Person, y: TaxableYear) defeasible {
    label en official "section 856(g)(1): the election terminates when the entity is not a REIT for the year, unless paragraph (5) applies";
    when not_a_reit_to_which_part_applies_for_year_856g1(t, y);
    then reit_election_terminated_856g1(t, y);
    unless section_856g5_relief_applies(t, y);
}
pub relation reit_election_revoked_on_856g2(t: Person, y: TaxableYear, made_on: Date) kind empirical {
    label en unofficial "the entity revokes its election, on this date, effective for taxable year y and all succeeding years";
}
pub relation revocation_year_is_after_first_effective_year_856g2(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is a taxable year after the first taxable year for which the election is effective (ordinal position; TECH-GAPS G2201)";
}
pub relation revocation_timely_856g2(t: Person, y: TaxableYear) kind institutional {
    label en official "the revocation is made on or before the 90th day after the first day of the first taxable year for which it is to be effective";
}
@source(IRC_S856_G, quote = "Such revocation must be made on or before the 90th day after the first day of the first taxable year for which the revocation is to be effective.")
rule Section856g2RevocationTiming(t: Person, y: TaxableYear, made_on: Date, begins_on: Date) strict {
    label en official "section 856(g)(2): the revocation is made within 90 days after the first day of the year it takes effect";
    when reit_election_revoked_on_856g2(t, y, made_on);
    when reit_election_year_begins_856g(t, y, begins_on);
    when made_on <= add_calendar_period(begins_on, 90 calendar_day);
    then revocation_timely_856g2(t, y);
}
pub relation reit_election_revoked_856g2(t: Person, y: TaxableYear) kind institutional {
    label en official "the election is revoked effective for the taxable year and all succeeding taxable years";
}
pub relation revocation_requirements_met_856g2(t: Person, y: TaxableYear) kind institutional {
    label en official "the revocation is for a year after the first effective year and is timely";
}
rule Section856g2RevocationRequirements(t: Person, y: TaxableYear) strict {
    label en official "section 856(g)(2): after the first effective year, and within 90 days";
    when revocation_year_is_after_first_effective_year_856g2(t, y);
    when revocation_timely_856g2(t, y);
    then revocation_requirements_met_856g2(t, y);
}
@source(IRC_S856_G, quote = "An election under subsection (c)(1) made by a corporation, trust, or association may be revoked by it for any taxable year after the first taxable year for which the election is effective.")
rule Section856g2RevocationPower(t: Person, y: TaxableYear, made_on: Date) strict {
    label en official "section 856(g)(2): the entity may revoke its election for a later year";
    when reit_election_revoked_on_856g2(t, y, made_on);
    then power ReitElectionRevocation {
        holder t;
        over t;
        exercise reit_election_revoked_on_856g2(t, y, made_on);
        valid_when revocation_requirements_met_856g2(t, y);
        effect create(reit_election_revoked_856g2(t, y));
        window [@1960-01-01, infinity);
    };
}
pub relation years_after_termination_year_856g3(t: Person, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "y is the ordinal-th taxable year beginning after the 1st taxable year for which the termination or revocation is effective (TECH-GAPS G2201)";
}
pub relation termination_exception_conditions_856g4(t: Person, y: TaxableYear) kind institutional {
    label en official "paragraph (4): a terminated election's bar does not apply: no willful failure to file, no fraudulent incorrect information, reasonable cause";
}
pub relation willful_failure_to_file_return_856g4A(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity willfully failed to file within the time prescribed by law an income tax return for the year in which the termination occurs";
}
pub relation incorrect_return_information_due_to_fraud_856g4B(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the inclusion of incorrect information in the return is due to fraud with intent to evade tax";
}
pub relation election_terminated_under_paragraph_1_856g4(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the election was terminated under paragraph (1) (not revoked)";
}
@source(IRC_S856_G, quote = "the corporation, trust, or association establishes to the satisfaction of the Secretary that its failure to qualify as a real estate investment trust to which the provisions of this part apply is due to reasonable cause and not due to willful neglect")
rule Section856g4Exception(t: Person, y: TaxableYear) strict {
    label en official "section 856(g)(4): after a paragraph (1) termination, the bar is lifted when there is no willful non-filing, no fraud and reasonable cause";
    when election_terminated_under_paragraph_1_856g4(t, y);
    when not_known(willful_failure_to_file_return_856g4A(t, y));
    when not_known(incorrect_return_information_due_to_fraud_856g4B(t, y));
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    then termination_exception_conditions_856g4(t, y);
}
pub relation reelection_barred_856g3(t: Person, y: TaxableYear) kind institutional {
    label en official "the entity (and any successor) may not make a section 856(c)(1) election for the taxable year, being before the 5th taxable year that begins after the year of effective termination or revocation";
}
@source(IRC_S856_G, quote = "shall not be eligible to make an election under subsection (c)(1) for any taxable year prior to the fifth taxable year which begins after the first taxable year for which such termination or revocation is effective")
rule Section856g3ReelectionBar(t: Person, y: TaxableYear, ordinal: Integer) defeasible {
    label en official "section 856(g)(3): no re-election before the 5th taxable year that begins after the year of termination or revocation, except as provided in paragraph (4)";
    when years_after_termination_year_856g3(t, y, ordinal);
    when ordinal < 5;
    then reelection_barred_856g3(t, y);
    unless termination_exception_conditions_856g4(t, y);
}
pub relation number_of_failures_to_comply_856g5(t: Person, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of failures to comply with a provision of part II (other than paragraph (2), (3) or (4) of subsection (c)) in the taxable year";
}
pub relation section_856g5_penalty_paid(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity pays, as prescribed by the Secretary and in the same manner as tax, the penalty of $50,000 for each failure";
}
pub relation section_856g5_penalty_amount(t: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the penalty of $50,000 for each failure due to reasonable cause and not willful neglect";
}
@source(IRC_S856_G, quote = "a penalty of $50,000 for each failure to satisfy a provision of this part due to reasonable cause and not willful neglect")
rule Section856g5PenaltyPerFailure(t: Person, y: TaxableYear, count: Integer) strict {
    label en official "section 856(g)(5)(C): $50,000 for each failure";
    when number_of_failures_to_comply_856g5(t, y, count);
    then section_856g5_penalty_amount(t, y, 50000.00 USD * count);
}
@source(IRC_S856_G, quote = "which is not a real estate investment trust to which the provisions of this part apply for the taxable year due to one or more failures to comply with one or more of the provisions of this part")
rule Section856g5Relief(t: Person, y: TaxableYear) strict {
    label en official "section 856(g)(5): failures due to reasonable cause, with the per-failure penalty paid, do not terminate the election";
    when not_a_reit_to_which_part_applies_for_year_856g1(t, y);
    when reit_failure_due_to_reasonable_cause_not_willful_neglect(t, y);
    when section_856g5_penalty_paid(t, y);
    then section_856g5_relief_applies(t, y);
}

// ---- Section 856(h): closely held; pension-held REITs ----

pub relation five_or_fewer_individuals_ownership_percent_of_value_856h1(t: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the value of the entity's outstanding stock owned, directly or indirectly, by or for not more than 5 individuals (section 542(a)(2), with section 544(a) as modified by section 856(h)(1)(B))";
}
pub relation closely_held_856h1(t: Person, y: TaxableYear) kind institutional {
    label en official "the stock ownership requirement of section 542(a)(2) is met: the entity is closely held";
}
@source(IRC_S856_H, quote = "a corporation, trust, or association is closely held if the stock ownership requirement of section 542(a)(2) is met")
rule Section856h1CloselyHeld(t: Person, y: TaxableYear, pct: Decimal) strict {
    label en official "section 856(h)(1)(A): more than 50 percent of the value held by 5 or fewer individuals";
    when five_or_fewer_individuals_ownership_percent_of_value_856h1(t, y, pct);
    when pct > 50.0;
    then closely_held_856h1(t, y);
}
pub relation qualified_trust_856h3E(tr: Person) kind empirical {
    label en unofficial "the trust is described in section 401(a) and exempt from tax under section 501(a)";
}
pub relation disqualified_persons_hold_five_percent_or_more_856h3Aii(tr: Person) kind empirical {
    label en unofficial "one or more disqualified persons (section 4975(e)(2), without regard to subparagraphs (B) and (I)) with respect to the qualified trust hold in the aggregate 5 percent or more in value of the interests in the REIT";
}
pub relation qualified_trust_stock_treated_as_held_by_beneficiaries_856h3A(tr: Person) kind institutional {
    label en official "stock held by the qualified trust is treated as held directly by its beneficiaries in proportion to their actuarial interests";
}
@source(IRC_S856_H, quote = "any stock held by a qualified trust shall be treated as held directly by its beneficiaries in proportion to their actuarial interests in such trust")
rule Section856h3ALookThrough(tr: Person) defeasible {
    label en official "section 856(h)(3)(A)(i)-(ii): a qualified trust is looked through unless disqualified persons hold 5 percent or more";
    when qualified_trust_856h3E(tr);
    when not_known(disqualified_persons_hold_five_percent_or_more_856h3Aii(tr));
    then qualified_trust_stock_treated_as_held_by_beneficiaries_856h3A(tr);
}
pub relation qualified_trust_percent_of_reit_value_856h3D(tr: Person, reit: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage, by value, of the interests in the REIT that the qualified trust holds";
}
pub relation aggregate_percent_held_by_qualified_trusts_over_ten_percent_856h3DII(reit: Person, pct: Decimal) kind empirical {
    label en unofficial "the aggregate percentage of the interests in the REIT held by qualified trusts each owning more than 10 percent by value";
}
pub relation predominantly_held_by_qualified_trusts_856h3Dii(reit: Person) kind institutional {
    label en official "the REIT is predominantly held by qualified trusts: one trust holds more than 25 percent, or trusts each holding more than 10 percent hold together more than 50 percent";
}
@source(IRC_S856_H, quote = "at least 1 qualified trust holds more than 25 percent (by value) of the interests in such real estate investment trust")
rule Section856h3DiiIOneTrustOverTwentyFive(tr: Person, reit: Person, pct: Decimal) strict {
    label en official "section 856(h)(3)(D)(ii)(I): one qualified trust holds more than 25 percent";
    when qualified_trust_856h3E(tr);
    when qualified_trust_percent_of_reit_value_856h3D(tr, reit, pct);
    when pct > 25.0;
    then predominantly_held_by_qualified_trusts_856h3Dii(reit);
}
@source(IRC_S856_H, quote = "1 or more qualified trusts (each of whom own more than 10 percent by value of the interests in such real estate investment trust) hold in the aggregate more than 50 percent (by value) of the interests in such real estate investment trust")
rule Section856h3DiiIITrustsOverTenHoldOverFifty(reit: Person, pct: Decimal) strict {
    label en official "section 856(h)(3)(D)(ii)(II): qualified trusts each above 10 percent hold together above 50 percent";
    when aggregate_percent_held_by_qualified_trusts_over_ten_percent_856h3DII(reit, pct);
    when pct > 50.0;
    then predominantly_held_by_qualified_trusts_856h3Dii(reit);
}
pub relation reit_qualifies_only_by_reason_of_856h3(reit: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trust would not have qualified as a REIT but for the qualified-trust look-through of section 856(h)(3)";
}
pub relation pension_held_reit_856h3Di(reit: Person, y: TaxableYear) kind institutional {
    label en official "the REIT is a pension-held REIT";
}
rule Section856h3DiPensionHeldReit(reit: Person, y: TaxableYear) strict {
    label en official "section 856(h)(3)(D)(i): qualifies only by the look-through and is predominantly held by qualified trusts";
    when reit_qualifies_only_by_reason_of_856h3(reit, y);
    when predominantly_held_by_qualified_trusts_856h3Dii(reit);
    then pension_held_reit_856h3Di(reit, y);
}
pub relation trust_percent_of_pension_held_reit_value_856h3C(tr: Person, reit: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage, by value, the qualified trust holds in the pension-held REIT at any time in the year";
}
pub relation reit_unrelated_gross_income_net_of_direct_expenses_856h3Ci(reit: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income (less direct expenses) of the REIT for the year from unrelated trades or businesses (determined as if the REIT were a qualified trust)";
}
pub relation reit_gross_income_net_of_direct_expenses_856h3Cii(reit: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income (less direct expenses) of the REIT for the year";
}
pub relation trust_gross_income_from_reit_856h3C(tr: Person, reit: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income of the qualified trust from the pension-held REIT for the year";
}
pub relation trust_unrelated_business_gross_income_from_reit_856h3C(tr: Person, reit: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount treated as gross income from an unrelated trade or business of the qualified trust: the same ratio of its REIT income as the REIT's unrelated to total gross income, when at least 5 percent";
}
@source(IRC_S856_H, quote = "This subparagraph shall apply only if the ratio determined under the preceding sentence is at least 5 percent.")
rule Section856h3CUnrelatedBusinessIncome(tr: Person, reit: Person, y: TaxableYear, pct: Decimal, unrelated: Money, total: Money, from_reit: Money) strict {
    label en official "section 856(h)(3)(C): a trust holding over 10 percent of a pension-held REIT has unrelated business gross income in the REIT's unrelated ratio, when that ratio is at least 5 percent";
    when qualified_trust_856h3E(tr);
    when pension_held_reit_856h3Di(reit, y);
    when trust_percent_of_pension_held_reit_value_856h3C(tr, reit, y, pct);
    when pct > 10.0;
    when reit_unrelated_gross_income_net_of_direct_expenses_856h3Ci(reit, y, unrelated);
    when reit_gross_income_net_of_direct_expenses_856h3Cii(reit, y, total);
    when total > 0.00 USD;
    when unrelated * 100.0 >= total * 5.0;
    when trust_gross_income_from_reit_856h3C(tr, reit, y, from_reit);
    then trust_unrelated_business_gross_income_from_reit_856h3C(tr, reit, y, div_round(from_reit * (unrelated / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 856(i): qualified REIT subsidiaries ----

pub relation reit_holds_percent_of_stock_856i2(t: Person, sub: Corporation, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the corporation's stock held by the real estate investment trust";
}
pub relation is_taxable_reit_subsidiary_856l(sub: Corporation, t: Person) kind institutional {
    label en official "the corporation is a taxable REIT subsidiary of the trust (section 856(l))";
}
pub relation qualified_reit_subsidiary_856i2(t: Person, sub: Corporation) kind institutional {
    label en official "the corporation is a qualified REIT subsidiary: 100 percent of its stock is held by the REIT, and it is not a taxable REIT subsidiary";
}
@source(IRC_S856_I, quote = "the term \"qualified REIT subsidiary\" means any corporation if 100 percent of the stock of such corporation is held by the real estate investment trust")
rule Section856i2QualifiedReitSubsidiary(t: Person, sub: Corporation, pct: Decimal) defeasible {
    label en official "section 856(i)(2): a wholly owned corporation that is not a taxable REIT subsidiary";
    when reit_holds_percent_of_stock_856i2(t, sub, pct);
    when pct >= 100.0;
    then qualified_reit_subsidiary_856i2(t, sub);
    unless is_taxable_reit_subsidiary_856l(sub, t);
}
pub relation qrs_not_treated_as_separate_corporation_856i1(t: Person, sub: Corporation) kind institutional {
    label en official "the qualified REIT subsidiary is not a separate corporation; its assets, liabilities and items are those of the REIT";
}
@source(IRC_S856_I, quote = "a corporation which is a qualified REIT subsidiary shall not be treated as a separate corporation")
rule Section856i1QrsDisregarded(t: Person, sub: Corporation) defeasible {
    label en official "section 856(i)(1): a qualified REIT subsidiary is disregarded and its items belong to the REIT";
    when qualified_reit_subsidiary_856i2(t, sub);
    then qrs_not_treated_as_separate_corporation_856i1(t, sub);
}
pub relation corporation_ceases_to_be_qrs_on_856i3(sub: Corporation, on: Date) kind empirical {
    label en unofficial "the corporation, formerly a qualified REIT subsidiary, ceases to meet the requirements of paragraph (2) on this date";
}
pub relation treated_as_new_corporation_acquiring_assets_856i3(sub: Corporation, immediately_before: Date) kind institutional {
    label en official "the former qualified REIT subsidiary is treated as a new corporation acquiring all of its assets and assuming all of its liabilities immediately before the cessation";
}
@source(IRC_S856_I, quote = "such corporation shall be treated as a new corporation acquiring all of its assets (and assuming all of its liabilities) immediately before such cessation")
rule Section856i3CessationNewCorporation(sub: Corporation, on: Date) strict {
    label en official "section 856(i)(3): cessation is a deemed formation of a new corporation";
    when corporation_ceases_to_be_qrs_on_856i3(sub, on);
    then treated_as_new_corporation_acquiring_assets_856i3(sub, on);
}

// ---- Section 856(j): shared appreciation provisions ----

pub relation income_from_shared_appreciation_provision_856j1(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en unofficial "the income is derived from a shared appreciation provision (a provision connected with an obligation held by the trust and secured by real property that entitles the trust to a specified portion of the gain or appreciation)";
}
pub relation shared_appreciation_income_treated_as_gain_on_sale_856j1(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "solely for subsection (c) and section 857(b)(6), the income is treated as gain recognized on the sale of the secured property";
}
@source(IRC_S856_J, quote = "any income derived from a shared appreciation provision shall be treated as gain recognized on the sale of the secured property")
rule Section856j1SharedAppreciationIsGain(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(j)(1): shared appreciation income is gain on the sale of the secured property";
    when income_from_shared_appreciation_provision_856j1(t, y, item);
    then shared_appreciation_income_treated_as_gain_on_sale_856j1(t, y, item);
}
pub relation shared_appreciation_sale_expenditures_by_holder_856j3B(t: Person, item: us.irc.core::Payment) kind empirical {
    label en unofficial "expenditures were made by a holder of the secured property";
}
pub relation shared_appreciation_property_dealer_property_856j2B(t: Person, item: us.irc.core::Payment) kind empirical {
    label en unofficial "the secured property is described in section 1221(a)(1) in the hands of the holder (or would be if held by the trust)";
}
pub relation shared_appreciation_property_treated_as_dealer_property_856j2B(t: Person, item: us.irc.core::Payment) kind institutional {
    label en official "the secured property is treated as property described in section 1221(a)(1)";
}
rule Section856j2BDealerPropertyTreatment(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(j)(2)(B): dealer property in the holder's hands (or if held by the trust) is dealer property";
    when income_from_shared_appreciation_provision_856j1(t, y, item);
    when shared_appreciation_property_dealer_property_856j2B(t, item);
    then shared_appreciation_property_treated_as_dealer_property_856j2B(t, item);
}
pub relation shared_appreciation_disposed_under_title_11_case_856j4A(t: Person, item: us.irc.core::Payment) kind empirical {
    label en unofficial "the secured property is sold or disposed of pursuant to a title 11 case, the seller is under the court's jurisdiction, and the disposition is required by the court or under an approved plan";
}
pub relation shared_appreciation_acquired_with_intent_or_default_known_856j4B(t: Person, item: us.irc.core::Payment) kind empirical {
    label en unofficial "the secured property was acquired by the seller with intent to evict or foreclose, or the trust knew or had reason to know that default would occur";
}
pub relation shared_appreciation_treated_as_held_four_years_856j4A(t: Person, item: us.irc.core::Payment) kind institutional {
    label en official "for section 857(b)(6)(C) the trust is treated as having held the property for at least 4 years";
}
@source(IRC_S856_J, quote = "the trust shall be treated as having held such property for at least 4 years")
rule Section856j4AFourYearsInBankruptcy(t: Person, y: TaxableYear, item: us.irc.core::Payment) defeasible {
    label en official "section 856(j)(4)(A): a court-ordered title 11 disposition counts as a 4-year holding, unless (B) applies";
    when income_from_shared_appreciation_provision_856j1(t, y, item);
    when shared_appreciation_disposed_under_title_11_case_856j4A(t, item);
    when not_known(shared_appreciation_acquired_with_intent_or_default_known_856j4B(t, item));
    then shared_appreciation_treated_as_held_four_years_856j4A(t, item);
}

// ---- Section 856(k): reasonable-diligence relief ----

pub relation reit_meets_857f1_ownership_regulations_856k1(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity for the taxable year meets the requirements of section 857(f)(1)";
}
pub relation entity_knows_or_would_know_failure_of_856a6_856k2(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the entity knows, or exercising reasonable diligence would have known, whether it failed to meet the requirement of subsection (a)(6)";
}
pub relation treated_as_meeting_856a6_by_856k(t: Person, y: TaxableYear) kind institutional {
    label en official "the entity is treated as having met the not-closely-held requirement of subsection (a)(6) for the taxable year";
}
@source(IRC_S856_K, quote = "shall be treated as having met the requirement of subsection (a)(6) for the taxable year")
rule Section856kDiligenceRelief(t: Person, y: TaxableYear) defeasible {
    label en official "section 856(k): an entity meeting section 857(f)(1) that neither knows nor would have known of the (a)(6) failure is treated as meeting (a)(6)";
    when reit_meets_857f1_ownership_regulations_856k1(t, y);
    when not_known(entity_knows_or_would_know_failure_of_856a6_856k2(t, y));
    then treated_as_meeting_856a6_by_856k(t, y);
}

// ---- Section 856(l): taxable REIT subsidiaries ----

pub relation reit_owns_stock_in_corporation_856l1A(t: Person, c: Corporation) kind empirical {
    label en unofficial "the trust directly or indirectly owns stock in the corporation (which is not a REIT)";
}
pub relation trs_joint_election_856l1B(t: Person, c: Corporation) kind empirical {
    label en unofficial "the trust and the corporation jointly elect that the corporation be treated as a taxable REIT subsidiary of the trust";
}
pub relation trs_holds_more_than_35_percent_of_voting_power_856l2A(sub_of_trust: Corporation, c: Corporation) kind empirical {
    label en unofficial "a taxable REIT subsidiary of the trust owns directly or indirectly securities possessing more than 35 percent of the total voting power of the corporation";
}
pub relation trs_holds_more_than_35_percent_of_value_856l2B(sub_of_trust: Corporation, c: Corporation) kind institutional {
    label en unofficial "a taxable REIT subsidiary of the trust owns directly or indirectly securities having a value of more than 35 percent of the total value of the corporation's outstanding securities (not counting securities described in subsection (m)(2)(A))";
}
pub relation operates_lodging_or_health_care_facility_856l3A(c: Corporation) kind institutional {
    label en unofficial "the corporation directly or indirectly operates or manages a lodging facility or a health care facility";
}
pub relation provides_brand_rights_for_lodging_or_health_care_facility_856l3B(c: Corporation) kind empirical {
    label en unofficial "the corporation directly or indirectly provides to any other person rights to any brand name under which a lodging or health care facility is operated";
}
pub relation brand_rights_held_as_franchisee_by_eligible_independent_contractor_856l3(c: Corporation) kind empirical {
    label en unofficial "the rights are provided to an eligible independent contractor to operate or manage a facility, and the rights are held by the corporation as franchisee, licensee or in a similar capacity";
}
pub relation trs_disqualified_by_856l3(c: Corporation) kind institutional {
    label en official "the corporation is excluded from taxable REIT subsidiary status by section 856(l)(3)";
}
@source(IRC_S856_L, quote = "any corporation which directly or indirectly operates or manages a lodging facility or a health care facility")
rule Section856l3AOperatesLodging(c: Corporation) strict {
    label en official "section 856(l)(3)(A): operators of lodging or health care facilities are not taxable REIT subsidiaries";
    when operates_lodging_or_health_care_facility_856l3A(c);
    then trs_disqualified_by_856l3(c);
}
@source(IRC_S856_L, quote = "any corporation which directly or indirectly provides to any other person (under a franchise, license, or otherwise) rights to any brand name under which any lodging facility or health care facility is operated")
rule Section856l3BBrandProvider(c: Corporation) defeasible {
    label en official "section 856(l)(3)(B): brand-rights providers are not taxable REIT subsidiaries, except rights given to an eligible independent contractor and held as franchisee or licensee";
    when provides_brand_rights_for_lodging_or_health_care_facility_856l3B(c);
    when not_known(brand_rights_held_as_franchisee_by_eligible_independent_contractor_856l3(c));
    then trs_disqualified_by_856l3(c);
}
pub relation taxable_reit_subsidiary_by_election_856l1(c: Corporation, t: Person) kind institutional {
    label en official "the corporation is a taxable REIT subsidiary by the trust's ownership and the joint election (section 856(l)(1))";
}
@source(IRC_S856_L, quote = "The term \"taxable REIT subsidiary\" means, with respect to a real estate investment trust, a corporation (other than a real estate investment trust) if")
rule Section856l1TaxableReitSubsidiaryByElection(t: Person, c: Corporation) defeasible {
    label en official "section 856(l)(1): a corporation in which the trust owns stock and that the trust and the corporation jointly elect, unless excluded by paragraph (3)";
    when reit_owns_stock_in_corporation_856l1A(t, c);
    when trs_joint_election_856l1B(t, c);
    when not_known(trs_election_revoked_856l1(t, c));
    when not_known(trs_disqualified_by_856l3(c));
    then taxable_reit_subsidiary_by_election_856l1(c, t);
}
pub relation taxable_reit_subsidiary_by_ownership_856l2(c: Corporation, t: Person) kind institutional {
    label en official "the corporation is a taxable REIT subsidiary because a taxable REIT subsidiary of the trust owns more than 35 percent of its voting power or value (section 856(l)(2); a chain through a second-tier subsidiary is not followed, a recursive closure being LDC-E4102, TECH-GAPS G2202)";
}
@source(IRC_S856_L, quote = "securities possessing more than 35 percent of the total voting power of the outstanding securities of such corporation")
rule Section856l2ATaxableReitSubsidiaryByVotingPower(t: Person, sub: Corporation, c: Corporation) defeasible {
    label en official "section 856(l)(2)(A): a corporation more than 35 percent of whose voting power a taxable REIT subsidiary owns";
    when taxable_reit_subsidiary_by_election_856l1(sub, t);
    when trs_holds_more_than_35_percent_of_voting_power_856l2A(sub, c);
    when not_known(wholly_owned_by_reit_excluded_856l2(t, c));
    when not_known(trs_disqualified_by_856l3(c));
    then taxable_reit_subsidiary_by_ownership_856l2(c, t);
}
@source(IRC_S856_L, quote = "securities having a value of more than 35 percent of the total value of the outstanding securities of such corporation")
rule Section856l2BTaxableReitSubsidiaryByValue(t: Person, sub: Corporation, c: Corporation) defeasible {
    label en official "section 856(l)(2)(B): a corporation more than 35 percent of whose value a taxable REIT subsidiary owns";
    when taxable_reit_subsidiary_by_election_856l1(sub, t);
    when trs_holds_more_than_35_percent_of_value_856l2B(sub, c);
    when not_known(wholly_owned_by_reit_excluded_856l2(t, c));
    when not_known(trs_disqualified_by_856l3(c));
    then taxable_reit_subsidiary_by_ownership_856l2(c, t);
}
rule Section856lTrsByElectionIsTrs(t: Person, c: Corporation) defeasible {
    label en official "section 856(l)(1): the corporation is a taxable REIT subsidiary of the trust";
    when taxable_reit_subsidiary_by_election_856l1(c, t);
    then is_taxable_reit_subsidiary_856l(c, t);
}
rule Section856lTrsByOwnershipIsTrs(t: Person, c: Corporation) defeasible {
    label en official "section 856(l)(2): the corporation is a taxable REIT subsidiary of the trust";
    when taxable_reit_subsidiary_by_ownership_856l2(c, t);
    then is_taxable_reit_subsidiary_856l(c, t);
}

// ---- Section 856(m): securities not counted for the 10 percent value test ----

pub enum ReitSecurityKind856m {
    ReitStraightDebtSecurity;
    ReitLoanToIndividualOrEstate;
    ReitSection467RentalAgreementSecurity;
    ReitRentObligationSecurity;
    ReitGovernmentIssuedSecurity;
    ReitReitIssuedSecurity;
    ReitOtherSecurity856m;
    label en unofficial "the class of a security held by the trust for the section 856(m)(1) exclusions";
}
pub relation security_class_856m1(sec: us.irc.core::Asset, kind: ReitSecurityKind856m) kind empirical {
    label en unofficial "the class of the security, as the case classifies it";
}
pub relation government_security_payment_depends_on_profits_856m1E(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the determination of any payment received or accrued under the government security depends in whole or in part upon the profits of any entity or payments representing profits of any entity";
}
pub relation section_467_rental_agreement_with_related_tenant_856m1C(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the section 467 rental agreement is with a person described in subsection (d)(2)(B)";
}
pub relation issuer_is_corporation_or_partnership_856m2C(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the issuer of the straight debt is a corporation or a partnership";
}
pub relation trust_and_trs_hold_over_one_percent_of_non_straight_debt_856m2C(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the trust and its controlled taxable REIT subsidiaries hold securities of the issuer that are not straight debt and have an aggregate value greater than 1 percent of the issuer's outstanding securities";
}
pub relation straight_debt_per_1361c5_856m2A(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the security is straight debt as defined in section 1361(c)(5), without regard to subparagraph (B)(iii) thereof";
}
pub relation yield_change_from_contingency_percentage_points_856m2Bi(sec: us.irc.core::Asset, change: Decimal) kind empirical {
    label en unofficial "the change in the annual yield to maturity (in percentage points, section 1272) caused by a contingency on the time of payment";
}
pub relation annual_yield_to_maturity_percent_856m2Bi(sec: us.irc.core::Asset, yield_percent: Decimal) kind empirical {
    label en unofficial "the annual yield to maturity, in percent";
}
pub relation aggregate_issue_price_or_face_amount_of_issuer_debt_856m2BiII(sec: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the larger of the aggregate issue price and the aggregate face amount of the issuer's debt instruments held by the trust";
}
pub relation months_of_unaccrued_interest_prepayable_856m2BiII(sec: us.irc.core::Asset, months: Integer) kind empirical {
    label en unofficial "the number of months of unaccrued interest that can be required to be prepaid";
}
pub relation contingency_upon_default_or_prepayment_consistent_with_commercial_practice_856m2Bii(sec: us.irc.core::Asset) kind empirical {
    label en unofficial "the time or amount of payment is subject to a contingency upon a default or the exercise of a prepayment right by the issuer, consistent with customary commercial practice";
}
pub relation contingency_yield_test_met_856m2Bi(sec: us.irc.core::Asset) kind institutional {
    label en official "a contingency on the time of payment does not change the yield beyond the greater of 1/4 of 1 percent and 5 percent of the annual yield, or the small-issue alternative is met";
}
@source(IRC_S856_M, quote = "any such contingency does not have the effect of changing the effective yield to maturity, as determined under section 1272, other than a change in the annual yield to maturity which does not exceed the greater of ¼ of 1 percent or 5 percent of the annual yield to maturity")
rule Section856m2BiIYieldChange(sec: us.irc.core::Asset, change: Decimal, yield_percent: Decimal) strict {
    label en official "section 856(m)(2)(B)(i)(I): yield change at most the greater of 0.25 percentage points and 5 percent of the yield";
    when yield_change_from_contingency_percentage_points_856m2Bi(sec, change);
    when annual_yield_to_maturity_percent_856m2Bi(sec, yield_percent);
    when change <= max(0.25, yield_percent * 0.05);
    then contingency_yield_test_met_856m2Bi(sec);
}
@source(IRC_S856_M, quote = "neither the aggregate issue price nor the aggregate face amount of the issuer's debt instruments held by the trust exceeds $1,000,000 and not more than 12 months of unaccrued interest can be required to be prepaid thereunder")
rule Section856m2BiIISmallIssue(sec: us.irc.core::Asset, amount: Money, months: Integer) strict {
    label en official "section 856(m)(2)(B)(i)(II): holdings of at most $1,000,000 and at most 12 months of prepayable interest";
    when aggregate_issue_price_or_face_amount_of_issuer_debt_856m2BiII(sec, amount);
    when months_of_unaccrued_interest_prepayable_856m2BiII(sec, months);
    when amount <= 1000000.00 USD;
    when months <= 12;
    then contingency_yield_test_met_856m2Bi(sec);
}
pub relation security_is_straight_debt_856m2(sec: us.irc.core::Asset) kind institutional {
    label en official "the security meets the straight-debt requirement of section 856(m)(2)";
}
@source(IRC_S856_M, quote = "securities meet the requirements of this paragraph if such securities are straight debt, as defined in section 1361(c)(5) (without regard to subparagraph (B)(iii) thereof)")
rule Section856m2AStraightDebt(sec: us.irc.core::Asset) defeasible {
    label en official "section 856(m)(2)(A): straight debt as defined in section 1361(c)(5); a contingency does not fail it when (B) is met; and a corporate or partnership issuer's securities fail when the trust and its controlled TRSs hold more than 1 percent of non-straight-debt securities (C)";
    when straight_debt_per_1361c5_856m2A(sec);
    when contingency_absent_or_permitted_856m2B(sec);
    then security_is_straight_debt_856m2(sec);
    unless trust_and_trs_hold_over_one_percent_of_non_straight_debt_856m2C(sec);
}
pub relation security_not_considered_held_856m1(sec: us.irc.core::Asset) kind institutional {
    label en official "the security is not considered a security held by the trust for the (c)(4)(B)(iv)(III) 10 percent value test";
}
rule Section856m1AStraightDebtExcluded(sec: us.irc.core::Asset) defeasible {
    label en official "section 856(m)(1)(A): straight debt securities meeting paragraph (2)";
    when security_class_856m1(sec, ReitStraightDebtSecurity);
    when security_is_straight_debt_856m2(sec);
    then security_not_considered_held_856m1(sec);
}
rule Section856m1BLoanToIndividualExcluded(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(1)(B): any loan to an individual or an estate";
    when security_class_856m1(sec, ReitLoanToIndividualOrEstate);
    then security_not_considered_held_856m1(sec);
}
rule Section856m1CRentalAgreementExcluded(sec: us.irc.core::Asset) defeasible {
    label en official "section 856(m)(1)(C): a section 467 rental agreement, other than with a person described in subsection (d)(2)(B)";
    when security_class_856m1(sec, ReitSection467RentalAgreementSecurity);
    when not_known(section_467_rental_agreement_with_related_tenant_856m1C(sec));
    then security_not_considered_held_856m1(sec);
}
rule Section856m1DRentObligationExcluded(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(1)(D): any obligation to pay rents from real property";
    when security_class_856m1(sec, ReitRentObligationSecurity);
    then security_not_considered_held_856m1(sec);
}
rule Section856m1EGovernmentSecurityExcluded(sec: us.irc.core::Asset) defeasible {
    label en official "section 856(m)(1)(E): a State, District of Columbia, foreign government or Puerto Rico security whose payments do not depend on profits of any entity";
    when security_class_856m1(sec, ReitGovernmentIssuedSecurity);
    when not_known(government_security_payment_depends_on_profits_856m1E(sec));
    then security_not_considered_held_856m1(sec);
}
rule Section856m1FReitSecurityExcluded(sec: us.irc.core::Asset) strict {
    label en official "section 856(m)(1)(F): any security issued by a real estate investment trust";
    when security_class_856m1(sec, ReitReitIssuedSecurity);
    then security_not_considered_held_856m1(sec);
}
pub relation trust_partnership_asset_share_856m3A(t: Person, pt: us.irc.core::Partnership, share: Decimal) kind empirical {
    label en unofficial "the trust's proportionate interest as a partner in the partnership";
}
pub relation trust_deemed_to_own_share_of_partnership_assets_856m3Aii(t: Person, pt: us.irc.core::Partnership, share: Decimal) kind institutional {
    label en official "for the 10 percent value test, the partnership interest is not a security and the trust is deemed to own its proportionate share of each partnership asset";
}
@source(IRC_S856_M, quote = "the trust shall be deemed to own its proportionate share of each of the assets of the partnership")
rule Section856m3AProportionateShareOfPartnershipAssets(t: Person, pt: us.irc.core::Partnership, share: Decimal) strict {
    label en official "section 856(m)(3)(A): look-through to the partnership's assets";
    when trust_partnership_asset_share_856m3A(t, pt, share);
    then trust_deemed_to_own_share_of_partnership_assets_856m3Aii(t, pt, share);
}
pub relation partnership_gross_income_from_856c3_sources_856m4B(pt: us.irc.core::Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partnership's gross income (excluding prohibited-transaction income) derived from section 856(c)(3) sources";
}
pub relation partnership_total_gross_income_856m4B(pt: us.irc.core::Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partnership's gross income (excluding prohibited-transaction income)";
}
pub relation partnership_debt_instrument_856m4(pt: us.irc.core::Partnership, debt: us.irc.core::Asset) kind empirical {
    label en unofficial "a debt instrument issued by the partnership and not described in paragraph (1)";
}
pub relation partnership_debt_not_a_security_856m4B(debt: us.irc.core::Asset) kind institutional {
    label en official "the partnership's debt instrument is not considered a security because at least 75 percent of the partnership's gross income derives from section 856(c)(3) sources";
}
@source(IRC_S856_M, quote = "at least 75 percent of the partnership's gross income (excluding gross income from prohibited transactions) is derived from sources referred to in subsection (c)(3)")
rule Section856m4BSeventyFivePercentPartnership(pt: us.irc.core::Partnership, debt: us.irc.core::Asset, y: TaxableYear, qualifying: Money, total: Money) strict {
    label en official "section 856(m)(4)(B): partnership debt is not a security when the partnership earns at least 75 percent qualifying income";
    when partnership_debt_instrument_856m4(pt, debt);
    when partnership_gross_income_from_856c3_sources_856m4B(pt, y, qualifying);
    when partnership_total_gross_income_856m4B(pt, y, total);
    when qualifying * 100.0 >= total * 75.0;
    then partnership_debt_not_a_security_856m4B(debt);
}

// ---- Section 856(n): foreign currency gains ----

pub relation section_988_gain_from_dealing_in_securities_856n4(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind empirical {
    label en unofficial "section 988 gain derived from dealing, or engaging in substantial and regular trading, in securities (section 475(c)(2))";
}
pub relation dealer_fx_gain_is_nonqualifying_gross_income_856n4(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the gain is gross income that does not qualify under paragraph (2) or (3) notwithstanding the other subsections of section 856(n)";
}
@source(IRC_S856_N, quote = "any section 988 gain derived by a corporation, trust, or association from dealing, or engaging in substantial and regular trading, in securities")
rule Section856n4DealerGain(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(n)(4): dealer section 988 gain is nonqualifying gross income";
    when section_988_gain_from_dealing_in_securities_856n4(t, y, item);
    then dealer_fx_gain_is_nonqualifying_gross_income_856n4(t, y, item);
}
pub relation foreign_currency_gain_attributable_to_c3_income_856n2(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind empirical {
    label en unofficial "foreign currency gain (section 988(b)(1)) attributable to an item of income or gain described in subsection (c)(3), to real-property-mortgage obligations owned, or to becoming or being the obligor under them";
}
pub relation foreign_currency_gain_attributable_to_c2_income_or_obligations_856n3B(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind empirical {
    label en unofficial "foreign currency gain not described in (n)(3)(A) attributable to an item of income or gain described in subsection (c)(2), to obligations, or to being the obligor";
}
pub relation section_987_gain_of_qualifying_qbu_856n2B(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind empirical {
    label en unofficial "section 987 gain attributable to a qualified business unit that meets subsection (c)(3) for the year and subsection (c)(4)(A) at the close of each quarter it has been held";
}
pub relation real_estate_foreign_exchange_gain_856n2(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the item is real estate foreign exchange gain: excluded from gross income for subsection (c)(3)";
}
rule Section856n2ARealEstateFxByAttribution(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(n)(2)(A): foreign currency gain attributable to (c)(3) income or mortgage obligations";
    when foreign_currency_gain_attributable_to_c3_income_856n2(t, y, item);
    then real_estate_foreign_exchange_gain_856n2(t, y, item);
}
rule Section856n2BSection987Gain(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(n)(2)(B): section 987 gain of a qualifying business unit";
    when section_987_gain_of_qualifying_qbu_856n2B(t, y, item);
    then real_estate_foreign_exchange_gain_856n2(t, y, item);
}
pub relation passive_foreign_exchange_gain_856n3(t: Person, y: TaxableYear, item: us.irc.core::Payment) kind institutional {
    label en official "the item is passive foreign exchange gain: excluded from gross income for subsection (c)(2)";
}
rule Section856n3ARealEstateFxIsPassive(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(n)(3)(A): real estate foreign exchange gain is passive foreign exchange gain";
    when real_estate_foreign_exchange_gain_856n2(t, y, item);
    then passive_foreign_exchange_gain_856n3(t, y, item);
}
rule Section856n3BOtherPassiveFx(t: Person, y: TaxableYear, item: us.irc.core::Payment) strict {
    label en official "section 856(n)(3)(B): other foreign currency gain attributable to (c)(2) income or to obligations";
    when foreign_currency_gain_attributable_to_c2_income_or_obligations_856n3B(t, y, item);
    then passive_foreign_exchange_gain_856n3(t, y, item);
}
