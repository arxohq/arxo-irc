// Sections 814, 817, 817A, 818 stage 3b (IRC-09 stage 3b, TECH_GAP
// reduction), 26.09.2026. Status implemented_unverified; nothing here was
// executed.
//
// METHOD.
//   * 814(d), (e), (f), (h): the deemed sale of the branch account at the
//     first day of the first electing year, the reimbursement as a separate
//     person's payment (removed from the repatriation addition), the
//     denial of foreign tax on excluded income, and the special rule for
//     stock companies (the deemed sale gain limited by the transferred
//     proportion).
//   * 817(a) last sentence: the deductions of 805(a)(1) and (6) for
//     variable contracts follow appreciation and depreciation not already
//     reflected; 817(f)(1), 817(g), 817A(a), (c), (d): the assumed rate,
//     the company-wide variable annuity limit, the net surrender value of a
//     modified guaranteed contract with the market value adjustment, and
//     the separate treatment of the part of a contract not described in
//     section 817.
//   * 818(b)(2), 818(c)(2): the property used in an insurance business for
//     section 1221(a)(2) and the 1958 gain rule extended to substituted
//     basis property with the reductions of (D) and the basis of (E).

// ---- Section 814(d): the deemed sale of the branch assets ----

use self::{
    Contract,
    IRC_S814_D,
    IRC_S814_E,
    IRC_S814_F,
    IRC_S814_H,
    IRC_S817A_A,
    IRC_S817A_C,
    IRC_S817A_D,
    IRC_S817_A,
    IRC_S817_F,
    IRC_S817_G,
    IRC_S818_B,
    IRC_S818_C,
    Person,
    TaxableYear,
    adjusted_basis_on_1958_12_31_818c1,
    amount_transferred_from_branch_account_814e2A,
    branch_election_in_effect_814g,
    branch_items_excluded_from_licti_814a,
    branch_separate_account_maintained_814c,
    company_issues_only_variable_contracts_817g2,
    contract_of_company_807,
    fair_market_value_on_1958_12_31_818c1,
    gain_without_regard_to_818c_1958_property,
    life_insurer_at_all_times_after_1958_12_31_818c1B,
    modified_guaranteed_contract_817Ad,
    net_surrender_value_807,
    penalty_or_charge_on_surrender_807e1Ai,
    penalty_or_charge_stated_807e1,
    pension_plan_contract_807e1B,
    surrender_value_before_penalty_and_market_adjustment_807e1,
};

pub relation branch_assets_fair_market_value_on_first_day_814d(c: Person, br: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate fair market value of the invested assets and tangible property separately accounted for in the branch account on the first day of the first electing year";
}
pub relation branch_assets_adjusted_basis_814d(c: Person, br: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate adjusted basis of those assets for determining gain";
}
pub relation first_electing_year_814d(c: Person, br: Person, y: TaxableYear) kind empirical {
    label en unofficial "the first taxable year for which the branch election is in effect";
}
pub relation deemed_sale_of_branch_assets_814d(c: Person, br: Person, on: Date, gain: Money) kind institutional {
    label en official "the company is treated as having sold the branch assets on the first day of the first electing year, the net gain being recognized";
}
@source(IRC_S814_D, quote = "If the aggregate fair market value of all the invested assets and tangible property which are separately")
rule Section814dDeemedSaleOfBranchAssets(c: Person, br: Person, y: TaxableYear, fmv: Money, basis: Money, first_day: Date) strict {
    label en official "section 814(d): when the fair market value exceeds the adjusted basis the assets are deemed sold on the first day of the first electing year and the net gain is recognized";
    when first_electing_year_814d(c, br, y);
    when branch_election_in_effect_814g(c, br, y);
    when branch_assets_fair_market_value_on_first_day_814d(c, br, fmv);
    when branch_assets_adjusted_basis_814d(c, br, basis);
    when us.irc.core::begins(y, first_day);
    when fmv > basis;
    then deemed_sale_of_branch_assets_814d(c, br, first_day, fmv - basis);
}

// ---- Section 814(e): dealings between the branch and the company ----

pub relation reimbursement_from_branch_account_814e1(c: Person, br: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a payment, transfer, reimbursement, credit, or allowance from the branch account to another account as reimbursement for costs of insuring risks accounted for in the branch account";
}
pub relation reimbursement_taken_into_account_as_from_separate_person_814e1(c: Person, br: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reimbursement is taken into account as if received from a separate person";
}
@source(IRC_S814_E, quote = "Any payment, transfer, reimbursement, credit, or allowance which is made from a separate account")
rule Section814e1ReimbursementFromSeparatePerson(c: Person, br: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 814(e)(1): a reimbursement from the branch account is treated as received from a separate person";
    when branch_separate_account_maintained_814c(c, br, y);
    when reimbursement_from_branch_account_814e1(c, br, y, amount);
    then reimbursement_taken_into_account_as_from_separate_person_814e1(c, br, y, amount);
}
pub relation has_reimbursement_814e1(c: Person, br: Person, y: TaxableYear) kind institutional {
    label en official "some reimbursement is stated for the year (helper)";
}
rule Section814e1HelperHasReimbursement(c: Person, br: Person, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when reimbursement_from_branch_account_814e1(c, br, y, amount);
    then has_reimbursement_814e1(c, br, y);
}
pub relation transfer_subject_to_repatriation_addition_814e2A(c: Person, br: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount transferred or credited from the branch account other than reimbursements to which paragraph (1) applies";
}
@source(IRC_S814_E, quote = "Except as provided in subparagraph (B), any amount directly or indirectly transferred or credited from a")
rule Section814e2ATransferAfterReimbursement(c: Person, br: Person, y: TaxableYear, transferred: Money, reimbursed: Money) strict {
    label en official "section 814(e)(2)(A): a transfer that is a reimbursement under paragraph (1) is not added to income";
    when amount_transferred_from_branch_account_814e2A(c, br, y, transferred);
    when reimbursement_from_branch_account_814e1(c, br, y, reimbursed);
    then transfer_subject_to_repatriation_addition_814e2A(c, br, y, max(0.00 USD, transferred - reimbursed));
}
rule Section814e2ATransferWithoutReimbursement(c: Person, br: Person, y: TaxableYear, transferred: Money) strict {
    label en official "section 814(e)(2)(A): a transfer with no reimbursement is added to income (within the (B) limitation)";
    when amount_transferred_from_branch_account_814e2A(c, br, y, transferred);
    when not_known(has_reimbursement_814e1(c, br, y));
    then transfer_subject_to_repatriation_addition_814e2A(c, br, y, transferred);
}

// ---- Section 814(f)(1): foreign taxes ----

pub relation foreign_taxes_attributable_to_excluded_income_814f1(c: Person, br: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "income, war profits, or excess profits taxes paid or accrued to a foreign country or possession attributable to income excluded under subsection (a)";
}
pub relation foreign_taxes_disregarded_for_credit_and_deduction_814f1(c: Person, br: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the taxes are not taken into account for the foreign tax credit and are not allowable as a deduction";
}
@source(IRC_S814_F, quote = "No income, war profits, or excess profits taxes paid or accrued to any foreign country or possession of")
rule Section814f1TaxesOnExcludedIncomeDisregarded(c: Person, br: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 814(f)(1): foreign taxes attributable to excluded branch income are neither credited nor deducted";
    when branch_items_excluded_from_licti_814a(c, br, y);
    when foreign_taxes_attributable_to_excluded_income_814f1(c, br, y, amount);
    then foreign_taxes_disregarded_for_credit_and_deduction_814f1(c, br, y, amount);
}

// ---- Section 814(h): domestic stock life insurance companies ----

pub relation stock_company_elects_814h(c: Person, br: Person, y: TaxableYear) kind empirical {
    label en unofficial "a domestic stock life insurance company with a branch described in subsection (b) (without regard to (b)(3)) makes the election of subsection (h)";
}
pub relation branch_assets_transferred_fair_market_value_814h(c: Person, br: Person, amount: Money) kind empirical {
    label en unofficial "the fair market value of the branch assets transferred to the foreign corporation";
}
pub relation section_367_not_applied_to_branch_transfer_814h(c: Person, br: Person) kind institutional {
    label en official "the branch assets may be transferred to a foreign corporation of the contiguous country without the application of section 367";
}
@source(IRC_S814_H, quote = "At the election of a domestic stock life insurance company which has a contiguous country life insurance")
rule Section814hNoSection367(c: Person, br: Person, y: TaxableYear) strict {
    label en official "section 814(h) first sentence: at the election, the transfer is without section 367";
    when stock_company_elects_814h(c, br, y);
    then section_367_not_applied_to_branch_transfer_814h(c, br);
}
pub relation transferee_stock_treated_as_mutual_branch_item_814h(c: Person, br: Person) kind institutional {
    label en official "subsection (a) applies to the stock of the foreign corporation as if the domestic company were a mutual company and the stock an item described in subsection (c)";
}
rule Section814hStockIsMutualItem(c: Person, br: Person, y: TaxableYear) strict {
    label en official "section 814(h) second sentence";
    when stock_company_elects_814h(c, br, y);
    then transferee_stock_treated_as_mutual_branch_item_814h(c, br);
}
pub relation deemed_sale_gain_limited_by_transferred_proportion_814h(c: Person, br: Person, gain: Money) kind institutional {
    label en official "the net gain on the deemed sale, not more than the proportion that the fair market value of the transferred assets bears to that of all the assets (cents HALF_UP)";
}
rule Section814hGainLimitedByTransferredProportion(c: Person, br: Person, y: TaxableYear, whole: Money, transferred: Money, total: Money, first_day: Date) strict {
    label en official "section 814(h) last sentence: the recognized gain is limited to the transferred proportion";
    when stock_company_elects_814h(c, br, y);
    when deemed_sale_of_branch_assets_814d(c, br, first_day, whole);
    when branch_assets_transferred_fair_market_value_814h(c, br, transferred);
    when branch_assets_fair_market_value_on_first_day_814d(c, br, total);
    when total > 0.00 USD;
    then deemed_sale_gain_limited_by_transferred_proportion_814h(c, br, div_round(whole * (transferred / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 817(a) last sentence, (f)(1), (g) ----

pub relation deduction_805a1_805a6_for_variable_contract_817a(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deduction allowable for the items of section 805(a)(1) and (6) with respect to variable contracts, before the appreciation adjustment";
}
pub relation appreciation_not_reflected_in_adjustments_817a(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the increase by appreciation (positive) or decrease by depreciation (negative) of the amount of those items not reflected in the adjustments of the preceding sentence";
}
pub relation variable_contract_deduction_after_appreciation_817a(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction reduced by the appreciation increase (or increased by the depreciation decrease) not otherwise reflected";
}
@source(IRC_S817_A, quote = "The deduction allowable for items described in paragraphs (1) and (6) of section 805(a) with respect to")
rule Section817aDeductionAdjustedForAppreciation(c: Person, y: TaxableYear, deduction: Money, appreciation: Money) strict {
    label en official "section 817(a): the deduction is reduced by appreciation and increased by depreciation not reflected in the adjustments";
    when deduction_805a1_805a6_for_variable_contract_817a(c, y, deduction);
    when appreciation_not_reflected_in_adjustments_817a(c, y, appreciation);
    then variable_contract_deduction_after_appreciation_817a(c, y, deduction - appreciation);
}
pub relation segregated_account_reflected_as_assumed_rate_817f1(contract: Contract) kind empirical {
    label en unofficial "the contract reflects the investment return and market value of the segregated asset account";
}
pub relation assumed_rate_of_interest_for_816b1A_817f1(contract: Contract) kind institutional {
    label en official "the reflection of the investment return and market value of the segregated account is considered an assumed rate of interest for section 816(b)(1)(A)";
}
@source(IRC_S817_F, quote = "For purposes of subsection (b)(1)(A) of section 816, the reflection of the investment return and the")
rule Section817f1ReflectionIsAssumedRate(contract: Contract) strict {
    label en official "section 817(f)(1): the reflection is an assumed rate of interest";
    when segregated_account_reflected_as_assumed_rate_817f1(contract);
    then assumed_rate_of_interest_for_816b1A_817f1(contract);
}
pub relation company_issues_contracts_not_variable_817g(c: Person) kind empirical {
    label en unofficial "the company issues contracts which are not variable contracts";
}
pub relation company_wide_experience_basis_permitted_817g2B(c: Person) kind institutional {
    label en official "a variable annuity computed on the company-wide investment experience of the company may be an annuity contract (the company issues variable contracts only)";
}
@source(IRC_S817_G, quote = "Paragraph (2)(B) shall not apply to any company which issues contracts which are not variable contracts.")
rule Section817g2BOnlyForVariableOnlyCompanies(c: Person) strict {
    label en official "section 817(g), last sentence: paragraph (2)(B) does not apply to a company which issues contracts that are not variable contracts";
    when company_issues_only_variable_contracts_817g2(c);
    when not_known(company_issues_contracts_not_variable_817g(c));
    then company_wide_experience_basis_permitted_817g2B(c);
}

// ---- Section 817A(a), (c), (d): modified guaranteed contracts ----

pub relation market_value_adjustment_807e1Aii(contract: Contract, amount: Money) kind empirical {
    label en unofficial "the market value adjustment applicable to the surrender of the contract (negative for a downward adjustment)";
}
@source(IRC_S817A_A, quote = "In the case of a modified guaranteed contract, clause (ii) of section 807(e)(1)(A) shall not apply.")
rule Section817AaMgcNetSurrenderValueWithMva(c: Person, contract: Contract, gross: Money, penalty: Money, mva: Money) defeasible {
    label en official "section 817A(a): for a modified guaranteed contract clause (ii) of section 807(e)(1)(A) does not apply: the market value adjustment is taken into account";
    when contract_of_company_807(c, contract);
    when modified_guaranteed_contract_817Ad(contract);
    when surrender_value_before_penalty_and_market_adjustment_807e1(contract, gross);
    when penalty_or_charge_on_surrender_807e1Ai(contract, penalty);
    when market_value_adjustment_807e1Aii(contract, mva);
    when not_known(pension_plan_contract_807e1B(contract));
    then net_surrender_value_807(c, contract, (gross + mva) - penalty);
}
rule Section817AaMgcNetSurrenderValueWithMvaNoPenalty(c: Person, contract: Contract, gross: Money, mva: Money) defeasible {
    label en official "section 817A(a): with no penalty stated the market value adjustment is still taken into account";
    when contract_of_company_807(c, contract);
    when modified_guaranteed_contract_817Ad(contract);
    when surrender_value_before_penalty_and_market_adjustment_807e1(contract, gross);
    when market_value_adjustment_807e1Aii(contract, mva);
    when not_known(pension_plan_contract_807e1B(contract));
    when not_known(penalty_or_charge_stated_807e1(contract));
    then net_surrender_value_807(c, contract, gross + mva);
}
pub relation rate_determined_with_reference_to_market_rate_817Ac(contract: Contract) kind empirical {
    label en unofficial "the rate of interest is determined, from time to time, with reference to a market rate of interest";
}
pub relation market_rate_is_an_assumed_rate_for_mgc_817Ac(contract: Contract) kind institutional {
    label en official "for a modified guaranteed contract an assumed rate of interest includes a rate determined with reference to a market rate";
}
@source(IRC_S817A_C, quote = "For purposes of applying section 816(b)(1)(A) to any modified guaranteed contract, an assumed rate of")
rule Section817AcMarketRateIsAssumedRate(contract: Contract) defeasible {
    label en official "section 817A(c): for section 816(b)(1)(A) an assumed rate of interest of a modified guaranteed contract includes a market-referenced rate";
    when modified_guaranteed_contract_817Ad(contract);
    when rate_determined_with_reference_to_market_rate_817Ac(contract);
    then market_rate_is_an_assumed_rate_for_mgc_817Ac(contract);
}
pub relation portion_of_contract_not_described_in_817_817Ad(contract: Contract, portion: Contract) kind empirical {
    label en unofficial "the portion is the part of the contract that is not described in section 817";
}
pub relation portion_treated_as_separate_contract_817Ad(portion: Contract) kind institutional {
    label en official "the portion of a contract not described in section 817 is treated as a separate contract for section 817A";
}
@source(IRC_S817A_D, quote = "If only a portion of a contract is not described in section 817, such portion shall be treated for")
rule Section817AdPortionIsSeparateContract(contract: Contract, portion: Contract) strict {
    label en official "section 817A(d): a portion not described in section 817 is a separate contract";
    when portion_of_contract_not_described_in_817_817Ad(contract, portion);
    then portion_treated_as_separate_contract_817Ad(portion);
}

// ---- Section 818(b)(2), (c)(2): property and the 1958 rule ----

pub relation property_used_in_trade_or_business_generally_818b2(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is used in a trade or business (the reference of section 1221(a)(2))";
}
pub relation property_used_in_carrying_on_insurance_business_818b2(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property is used in carrying on an insurance business";
}
pub relation property_used_in_trade_or_business_for_1221a2_insurer_818b2(p: us.irc.core::Asset) kind institutional {
    label en official "for section 1221(a)(2) the reference to property used in the trade or business includes only property used in carrying on an insurance business";
}
@source(IRC_S818_B, quote = "(2) in applying section 1221(a)(2), the reference to property used in trade or business shall be treated")
rule Section818b2InsuranceBusinessOnly(p: us.irc.core::Asset) strict {
    label en official "section 818(b)(2): only property used in carrying on an insurance business";
    when property_used_in_trade_or_business_generally_818b2(p);
    when property_used_in_carrying_on_insurance_business_818b2(p);
    then property_used_in_trade_or_business_for_1221a2_insurer_818b2(p);
}
pub relation substituted_basis_property_acquired_after_1958_818c2(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property was acquired after December 31, 1958 and has a substituted basis (section 1016(b))";
}
pub relation predecessor_property_holding_period_includes_1958_818c2B(p: us.irc.core::Asset, pred: us.irc.core::Asset) kind empirical {
    label en unofficial "the predecessor property for which the holding period taken into account includes December 31, 1958";
}
pub relation held_only_by_life_insurance_companies_after_1958_818c2C(p: us.irc.core::Asset) kind empirical {
    label en unofficial "the property or properties whose holding periods are taken into account were held only by life insurance companies after December 31, 1958";
}
pub relation prior_gain_without_818c_on_related_properties_818c2Di(p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the gain that would have been recognized but for subsection (c) on all prior sales or dispositions after 1958 of the related properties";
}
pub relation prior_gain_recognized_on_related_properties_818c2Dii(p: us.irc.core::Asset, amount: Money) kind empirical {
    label en unofficial "the gain which was recognized on those sales or dispositions";
}
pub relation deemed_held_continuously_since_holding_period_began_818c2A(p: us.irc.core::Asset) kind institutional {
    label en official "the property is deemed held continuously by the taxpayer since the beginning of its holding period, determined with reference to section 1223";
}
@source(IRC_S818_C, quote = "(A) for purposes of paragraph (1), such property shall be deemed held continuously by the taxpayer since")
rule Section818c2ADeemedHeldContinuously(p: us.irc.core::Asset) strict {
    label en official "section 818(c)(2)(A): substituted basis property is deemed held since its holding period began";
    when substituted_basis_property_acquired_after_1958_818c2(p);
    then deemed_held_continuously_since_holding_period_began_818c2A(p);
}
pub relation appreciation_1958_of_substituted_basis_property_818c2B(p: us.irc.core::Asset, fmv: Money, basis: Money) kind institutional {
    label en official "the fair market value and adjusted basis on December 31, 1958 are those of the predecessor property";
}
@source(IRC_S818_C, quote = "(B) the fair market value and adjusted basis referred to in paragraph (1) shall be that of that property")
rule Section818c2BValuesOfThePredecessor(p: us.irc.core::Asset, pred: us.irc.core::Asset, fmv: Money, basis: Money) strict {
    label en official "section 818(c)(2)(B): the values are those of the property whose holding period includes December 31, 1958";
    when substituted_basis_property_acquired_after_1958_818c2(p);
    when predecessor_property_holding_period_includes_1958_818c2B(p, pred);
    when fair_market_value_on_1958_12_31_818c1(pred, fmv);
    when adjusted_basis_on_1958_12_31_818c1(pred, basis);
    then appreciation_1958_of_substituted_basis_property_818c2B(p, fmv, basis);
}
pub relation appreciation_1958_after_prior_sales_818c2D(p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the December 31, 1958 appreciation reduced (to not less than zero) by the excess of the prior exempted gain over the prior recognized gain";
}
@source(IRC_S818_C, quote = "(D) the difference between the fair market value and adjusted basis referred to in paragraph (1) shall")
rule Section818c2DReducedAppreciation(p: us.irc.core::Asset, fmv: Money, basis: Money, exempted: Money, recognized: Money) strict {
    label en official "section 818(c)(2)(D): the difference between fair market value and basis is reduced (not below zero) by the excess of prior exempted gain over prior recognized gain";
    when appreciation_1958_of_substituted_basis_property_818c2B(p, fmv, basis);
    when prior_gain_without_818c_on_related_properties_818c2Di(p, exempted);
    when prior_gain_recognized_on_related_properties_818c2Dii(p, recognized);
    then appreciation_1958_after_prior_sales_818c2D(p, max(0.00 USD, (fmv - basis) - max(0.00 USD, exempted - recognized)));
}
pub relation gain_on_substituted_basis_property_818c2(p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain on the substituted basis property: the gain otherwise determined less the remaining 1958 appreciation (never below zero)";
}
@source(IRC_S818_C, quote = "(C) paragraph (1) shall apply only if the property or properties the holding periods of which are taken")
rule Section818c2GainOnSubstitutedBasisProperty(p: us.irc.core::Asset, gain: Money, appreciation: Money) strict {
    label en official "section 818(c)(2)(C), (1): paragraph (1) applies only if the property was held only by life insurance companies";
    when substituted_basis_property_acquired_after_1958_818c2(p);
    when held_only_by_life_insurance_companies_after_1958_818c2C(p);
    when life_insurer_at_all_times_after_1958_12_31_818c1B(p);
    when gain_without_regard_to_818c_1958_property(p, gain);
    when appreciation_1958_after_prior_sales_818c2D(p, appreciation);
    then gain_on_substituted_basis_property_818c2(p, max(0.00 USD, gain - appreciation));
}
pub relation gain_exempted_added_to_basis_818c2E(p: us.irc.core::Asset, amount: Money) kind institutional {
    label en official "the gain that would have been recognized but for subsection (c) is taken into account in the basis as if recognized";
}
@source(IRC_S818_C, quote = "(E) the basis of such property shall be determined as if the gain which would have been recognized but")
rule Section818c2EExemptedGainAddedToBasis(p: us.irc.core::Asset, gain: Money, recognized: Money) strict {
    label en official "section 818(c)(2)(E): the exempted gain (the gain without the subsection less the recognized gain) is treated as recognized for the basis";
    when gain_without_regard_to_818c_1958_property(p, gain);
    when gain_on_substituted_basis_property_818c2(p, recognized);
    then gain_exempted_added_to_basis_818c2E(p, max(0.00 USD, gain - recognized));
}
@source(IRC_S818_C, quote = "In the case of property acquired after December 31, 1958, and having a substituted basis (within the")
pub relation substituted_basis_rule_applies_818c2(p: us.irc.core::Asset) kind institutional {
    label en official "paragraph (2) applies to the property (chapeau)";
}
rule Section818c2Chapeau(p: us.irc.core::Asset) strict {
    label en official "section 818(c)(2): property acquired after December 31, 1958 with a substituted basis";
    when substituted_basis_property_acquired_after_1958_818c2(p);
    then substituted_basis_rule_applies_818c2(p);
}
