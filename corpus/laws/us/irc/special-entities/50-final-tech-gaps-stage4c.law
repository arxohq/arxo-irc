// Special entities -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): G5317 (section 805(a)(4)(D)(v)), G5318 (section 848(b)(3)),
// G5319 (section 593(d)(1)(B)(iii)), G5320 (section 856(d)(5)), G5321 (section 856(d)(7)(E)).
//
// G5317. "Rules similar to the rules of this subsection" for a 100 percent dividend paid by an insurance company that is not a life insurance company: the
// pinned text defines no section 812-type share for such a payer, so the paying company's share is a CASE FACT (`paying_company_share_non_life_805a4Dv`) and the two
// rules of (D)(i)-(ii) are copied over it (JUDGMENT CALL: the analogue of the paying company's share; the receiving company's share is that of section 812).
// G5318. The controlled group of section 848(b)(3) is the section 1563(a)(1)-(3) group (`member_of_controlled_group_1563`, asserted membership of the group) WITHOUT the
// separation of (a)(4) (that relation is simply not applied) and without the exclusion of (b)(2)(D); the exclusions (B) (exempt corporations not taxed on UBTI), (E)
// (franchised corporations) and (C) (foreign corporations taxed under 881) apply, (C) NOT to a foreign corporation to which section 842 applies (case fact). The
// membership fact `insurance_company_in_controlled_group_848b3` stays the asserted channel; `insurance_company_in_group_for_848b3` (derived, else asserted) is read.
// G5319. Section 1504(a) with 50 percent for 80 percent: the group is derived in THREE levels of ownership of more than 50 percent below a common parent (the parent
// is any person that owns more than 50 percent of another), all corporations includible.
// G5320. Section 318(a) as modified by section 856(d)(5) applied a second time (one re-application, the exclusions of (5)(B) and (5)(C) as in module 33 of
// `us.irc.corporations`), and the shares of all paths are ADDED (`reit_constructive_ownership_total_856d5`; JUDGMENT CALL: the paths are distinct holdings), so two
// paths below 10 percent that add to 10 percent are seen; the consumers of modules 25 and 26 read the total.
// G5321. The amounts received for services to tenants or for managing or operating the property (section 856(d)(7)(A)) are included in the gross income that is the
// denominator of the 95 percent and 75 percent tests (`tenant_service_income_856d7A` added to the totals); JUDGMENT CALL: the case does not also itemize them.

language "law.core" version "0.2";
package us.irc.special_entities version "0.1.1";
namespace "urn:us:irc:special_entities:clir";

use self::{
    Corporation,
    IRC_S593_D,
    IRC_S805_A,
    IRC_S848_B,
    IRC_S856_D,
    Person,
    TaxableYear,
    companys_share_812a,
    dividends_received_805a4_proration_reduction,
    insurance_company_in_controlled_group_848b3,
    portion_of_dividend_attributable_to_prorated_amounts,
    reit_constructive_ownership_856d5,
    same_affiliated_group_593d1Biii,
};

// ===================== G5317 =====================

pub relation paying_company_share_non_life_805a4Dv(paying: Person, y_paying: TaxableYear, share: Decimal) kind empirical {
    label en official "the share of a paying insurance company that is not a life insurance company, the analogue of the section 812 share for the rules similar to section 805(a)(4)(D) (section 805(a)(4)(D)(v)) — case fact, no share is defined by the text";
}
pub relation section_805a4d_non_life_paying_exceeds_receiving(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear) kind institutional {
    label en official "section 805(a)(4)(D)(i) by (D)(v): the non-life paying company's share exceeds the receiving company's section 812 share";
}
@source(IRC_S805_A, quote = "Rules similar to the rules of this subsection shall apply in the case of 100 percent dividends paid by an insurance company which is not a life insurance company.")
rule Section805a4DvNonLifePayingExceedsReceiving(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear, paying_share: Decimal, receiving_share: Decimal) strict {
    label en official "the comparison of the two shares (rule similar to (D)(i))";
    when paying_company_share_non_life_805a4Dv(paying, y_paying, paying_share);
    when companys_share_812a(receiving, y_receiving, receiving_share);
    when paying_share > receiving_share;
    then section_805a4d_non_life_paying_exceeds_receiving(paying, receiving, y_paying, y_receiving);
}
@source(IRC_S805_A, quote = "Rules similar to the rules of this subsection shall apply in the case of 100 percent dividends paid by an insurance company which is not a life insurance company.")
rule Section805a4DvNonLifeReductionAmount(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear, prorated: Money, paying_share: Decimal, receiving_share: Decimal) strict {
    label en official "the reduction is the prorated-amounts portion times (paying share minus receiving share) (rule similar to (D)(ii))";
    when section_805a4d_non_life_paying_exceeds_receiving(paying, receiving, y_paying, y_receiving);
    when portion_of_dividend_attributable_to_prorated_amounts(receiving, y_receiving, prorated);
    when paying_company_share_non_life_805a4Dv(paying, y_paying, paying_share);
    when companys_share_812a(receiving, y_receiving, receiving_share);
    then dividends_received_805a4_proration_reduction(receiving, y_receiving, round(prorated * (paying_share - receiving_share), 2, "HALF_UP"));
}

// ===================== G5318 =====================

pub relation foreign_corporation_to_which_842_applies_848b3(c: Person) kind empirical {
    label en official "the foreign corporation is one to which section 842 applies (section 848(b)(3): section 1563(b)(2)(C) does not exclude it) — case fact";
}
pub relation excluded_from_848b3_group(c: Person, on: Date) kind institutional {
    label en official "the corporation is excluded from the group of section 848(b)(3) by section 1563(b)(2)(B), (C) or (E) ((D) and (a)(4) do not apply)";
}
@source(IRC_S848_B, quote = "except that subsections (a)(4) and (b)(2)(D) of section 1563 shall not apply")
rule Excluded848b3Exempt(c: Person, on: Date) defeasible {
    label en official "section 1563(b)(2)(B)";
    when us.irc.corporations::exempt_501a_1563b2b(c, on);
    when not_known(us.irc.corporations::taxed_on_unrelated_business_income_511_1563b2b(c, on));
    then excluded_from_848b3_group(c, on);
}
@source(IRC_S848_B, quote = "and subsection (b)(2)(C) of section 1563 shall not apply to the extent it excludes a foreign corporation to which section 842 applies")
rule Excluded848b3Foreign(c: Person, on: Date) defeasible {
    label en official "section 1563(b)(2)(C), not for a foreign corporation to which section 842 applies";
    when us.irc.corporations::foreign_corporation_taxed_under_881_1563b2c(c, on);
    when not_known(foreign_corporation_to_which_842_applies_848b3(c));
    then excluded_from_848b3_group(c, on);
}
@source(IRC_S848_B, quote = "except that subsections (a)(4) and (b)(2)(D) of section 1563 shall not apply")
rule Excluded848b3Franchised(c: Person, on: Date) defeasible {
    label en official "section 1563(b)(2)(E)";
    when us.irc.corporations::franchised_corporation_1563f4(c, on);
    then excluded_from_848b3_group(c, on);
}
pub relation insurance_company_in_group_derived_848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) kind institutional {
    label en official "the insurance company is a member of the section 1563(a)(1)-(3) group and is not excluded by (B), (C) (as modified) or (E)";
}
@source(IRC_S848_B, quote = "except that subsections (a)(4) and (b)(2)(D) of section 1563 shall not apply")
rule InsuranceCompanyInGroupDerived848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear, on: Date) defeasible {
    label en official "the (a)(1)-(3) group without the (a)(4) separation and without the (b)(2)(D) exclusion";
    when us.irc.corporations::member_of_controlled_group_1563(group, member);
    when us.irc.corporations::insurance_company_801_1563a4(member);
    when us.irc.core::ends(y, on);
    when not_known(excluded_from_848b3_group(member, on));
    then insurance_company_in_group_derived_848b3(group, member, y);
}
relation has_insurance_company_in_group_derived_848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) kind institutional;
rule HasInsuranceCompanyInGroupDerived848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) defeasible {
    label en official "bridge for the absence test";
    when insurance_company_in_group_derived_848b3(group, member, y);
    then has_insurance_company_in_group_derived_848b3(group, member, y);
}
pub relation insurance_company_in_group_for_848b3(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) kind institutional {
    label en official "the membership the section 848(b)(3) rules read: derived where the group membership is supplied, else asserted";
}
rule InsuranceCompanyInGroupFor848b3Derived(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) defeasible {
    label en official "the derived membership";
    when insurance_company_in_group_derived_848b3(group, member, y);
    then insurance_company_in_group_for_848b3(group, member, y);
}
rule InsuranceCompanyInGroupFor848b3Asserted(group: us.irc.corporations::ControlledGroup, member: Person, y: TaxableYear) defeasible {
    label en official "the asserted membership (the earlier channel)";
    when insurance_company_in_controlled_group_848b3(group, member, y);
    when not_known(has_insurance_company_in_group_derived_848b3(group, member, y));
    then insurance_company_in_group_for_848b3(group, member, y);
}

// ===================== G5319 =====================

pub relation own_more_than_half_593d(a: Person, b: Person) kind institutional {
    label en official "a owns more than 50 percent of b (section 1504(a)(2) with 50 percent for 80 percent)";
}
rule OwnMoreThanHalf593d(a: Person, b: Person, share: Decimal, oi: us.irc.core::OwnershipInterest) strict {
    label en official "ownership above 50 percent";
    when us.irc.core::ownership_interest(oi, a, b, share);
    when share > 0.50;
    then own_more_than_half_593d(a, b);
}
pub relation chain_level_1_593d(root: Person, m: Person) kind institutional { label en official "owned to more than 50 percent by the root"; }
rule ChainLevel1593d(root: Person, m: Person) strict { label en official "level 1"; when own_more_than_half_593d(root, m); then chain_level_1_593d(root, m); }
pub relation chain_level_2_593d(root: Person, m: Person) kind institutional { label en official "owned to more than 50 percent by a level 1 member"; }
rule ChainLevel2593d(root: Person, m1: Person, m: Person) strict { label en official "level 2"; when chain_level_1_593d(root, m1); when own_more_than_half_593d(m1, m); then chain_level_2_593d(root, m); }
pub relation chain_level_3_593d(root: Person, m: Person) kind institutional { label en official "owned to more than 50 percent by a level 2 member"; }
rule ChainLevel3593d(root: Person, m1: Person, m: Person) strict { label en official "level 3"; when chain_level_2_593d(root, m1); when own_more_than_half_593d(m1, m); then chain_level_3_593d(root, m); }
pub relation group_member_593d(root: Person, m: Person) kind institutional { label en official "the root or a member of its chain of more than 50 percent ownership, up to three levels"; }
rule GroupMemberRoot593d(root: Person, x: Person) strict { label en official "the root"; when own_more_than_half_593d(root, x); then group_member_593d(root, root); }
rule GroupMember1593d(root: Person, m: Person) strict { label en official "level 1"; when chain_level_1_593d(root, m); then group_member_593d(root, m); }
rule GroupMember2593d(root: Person, m: Person) strict { label en official "level 2"; when chain_level_2_593d(root, m); then group_member_593d(root, m); }
rule GroupMember3593d(root: Person, m: Person) strict { label en official "level 3"; when chain_level_3_593d(root, m); then group_member_593d(root, m); }
@source(IRC_S593_D, quote = "(iii) another member of the same affiliated group;")
rule Section593d1BiiiChain(i: Person, obligor: Person, root: Person) strict {
    label en official "section 593(d)(1)(B)(iii): both are members of the chain of one common parent (up to three levels, G5319)";
    when group_member_593d(root, i);
    when group_member_593d(root, obligor);
    then same_affiliated_group_593d1Biii(i, obligor);
}

// ===================== G5320 =====================

pub relation reit_constructive_ownership_second_hop_856d5(owner: Person, target: Person, share: Decimal, first: us.irc.corporations::AttributionKind, second: us.irc.corporations::AttributionKind) kind institutional {
    label en official "the owner owns, by re-application of section 318(a) as modified by section 856(d)(5) to stock that another owns constructively (section 318(a)(5)(A)), the share of the target: first and second are the attribution kinds of the two hops";
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopSpouse(ind: us.irc.core::Individual, spouse: us.irc.core::Individual, target: Person, share: Decimal, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5), 318(a)(1)(A)(i), (5)(A)-(B)";
    when us.irc.corporations::spouse_of(spouse, ind);
    when not_known(us.irc.corporations::legally_separated_spouse(spouse, ind));
    when reit_constructive_ownership_856d5(spouse, target, share, v1);
    when v1 != us.irc.corporations::Actual;
    when v1 != us.irc.corporations::Family;
    then reit_constructive_ownership_second_hop_856d5(ind, target, share, v1, us.irc.corporations::Family);
}

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopLineal(ind: us.irc.core::Individual, relative: us.irc.core::Individual, target: Person, share: Decimal, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5), 318(a)(1)(A)(ii), (5)(A)-(B)";
    when us.irc.corporations::child_grandchild_or_parent_of(relative, ind);
    when reit_constructive_ownership_856d5(relative, target, share, v1);
    when v1 != us.irc.corporations::Actual;
    when v1 != us.irc.corporations::Family;
    then reit_constructive_ownership_second_hop_856d5(ind, target, share, v1, us.irc.corporations::Family);
}

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopFromPartnership(partner: Person, partnership: us.irc.core::Partnership, interest_share: Decimal, target: Person, share: Decimal, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5), 318(a)(2)(A), (5)(A), (5)(C)";
    when us.irc.corporations::partner_of(partner, partnership, interest_share);
    when reit_constructive_ownership_856d5(partnership, target, share, v1);
    when v1 != us.irc.corporations::Actual;
    when v1 != us.irc.corporations::ToEntity;
    then reit_constructive_ownership_second_hop_856d5(partner, target, share * interest_share, v1, us.irc.corporations::FromEntity);
}

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopFromTenPercentOwnedCorporation(owner: Person, held: Corporation, owned_share: Decimal, target: Person, held_share: Decimal, oi1: us.irc.core::OwnershipInterest, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5)(A), 318(a)(2)(C), (5)(A), (5)(C)";
    when us.irc.core::ownership_interest(oi1, owner, held, owned_share);
    when owned_share >= 0.10;
    when reit_constructive_ownership_856d5(held, target, held_share, v1);
    when v1 != us.irc.corporations::Actual;
    when v1 != us.irc.corporations::ToEntity;
    then reit_constructive_ownership_second_hop_856d5(owner, target, held_share * owned_share, v1, us.irc.corporations::FromEntity);
}

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopToPartnership(partnership: us.irc.core::Partnership, partner: Person, interest_share: Decimal, target: Person, share: Decimal, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5)(B), 318(a)(3)(A), (5)(A)";
    when us.irc.corporations::partner_of(partner, partnership, interest_share);
    when interest_share >= 0.25;
    when reit_constructive_ownership_856d5(partner, target, share, v1);
    when v1 != us.irc.corporations::Actual;
    then reit_constructive_ownership_second_hop_856d5(partnership, target, share, v1, us.irc.corporations::ToEntity);
}

@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule Reit856d5SecondHopToTenPercentOwnedCorporation(owner: Person, held: Corporation, owned_share: Decimal, target: Person, share: Decimal, oi1: us.irc.core::OwnershipInterest, v1: us.irc.corporations::AttributionKind) defeasible {
    label en official "sections 856(d)(5)(A), 318(a)(3)(C), (5)(A)";
    when us.irc.core::ownership_interest(oi1, owner, held, owned_share);
    when owned_share >= 0.10;
    when reit_constructive_ownership_856d5(owner, target, share, v1);
    when v1 != us.irc.corporations::Actual;
    then reit_constructive_ownership_second_hop_856d5(held, target, share, v1, us.irc.corporations::ToEntity);
}

pub relation reit_constructive_ownership_total_856d5(owner: Person, target: Person, share: Decimal) kind institutional {
    label en official "the sum of the shares of all paths (actual, first hop, second hop) by which the owner owns the target under section 856(d)(5) (JUDGMENT CALL: the paths are distinct holdings)";
}
relation has_reit_first_hop_856d5(owner: Person, target: Person) kind institutional;
rule HasReitFirstHop856d5(owner: Person, target: Person, s: Decimal, v: us.irc.corporations::AttributionKind) defeasible {
    label en official "bridge for the absence test";
    when reit_constructive_ownership_856d5(owner, target, s, v);
    then has_reit_first_hop_856d5(owner, target);
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule ReitOwnershipTotal856d5(owner: Person, target: Person, s0: Decimal, v0: us.irc.corporations::AttributionKind) defeasible {
    label en official "first-hop rows plus second-hop rows";
    when reit_constructive_ownership_856d5(owner, target, s0, v0);
    then reit_constructive_ownership_total_856d5(owner, target,
        sum(collect all s: Decimal, v: us.irc.corporations::AttributionKind where reit_constructive_ownership_856d5(owner, target, s, v), empty: 0.0)
        + sum(collect all s2: Decimal, a: us.irc.corporations::AttributionKind, b: us.irc.corporations::AttributionKind where reit_constructive_ownership_second_hop_856d5(owner, target, s2, a, b), empty: 0.0));
}
@source(IRC_S856_D, quote = "the rules prescribed by section 318(a) for determining the ownership of stock shall apply in determining the ownership of stock, assets, or net profits of any person")
rule ReitOwnershipTotalSecondHopOnly856d5(owner: Person, target: Person, s0: Decimal, a0: us.irc.corporations::AttributionKind, b0: us.irc.corporations::AttributionKind) defeasible {
    label en official "an owner with second-hop rows only";
    when reit_constructive_ownership_second_hop_856d5(owner, target, s0, a0, b0);
    when not_known(has_reit_first_hop_856d5(owner, target));
    then reit_constructive_ownership_total_856d5(owner, target,
        sum(collect all s2: Decimal, a: us.irc.corporations::AttributionKind, b: us.irc.corporations::AttributionKind where reit_constructive_ownership_second_hop_856d5(owner, target, s2, a, b), empty: 0.0));
}
