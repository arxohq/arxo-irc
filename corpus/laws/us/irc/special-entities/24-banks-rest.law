// Sections 582, 584, 585(c)(3)-(5), 591, 593, 594, 597 (banks and thrift
// institutions: bad debts on securities, financial institutions and the
// character of their debt sales, common trust funds, the change from the
// reserve method for large banks, the deposit-interest deduction, the
// pre-1996 thrift reserve deduction and its 6-year recapture, mutual
// savings banks with a life insurance department, and Federal financial
// assistance). Stage 2c (IRC-09 stage 2c, A12), 26.09.2026. Status
// implemented_unverified.
//
// METHOD. Section 593(a)-(d) and (e) are rules of a repealed reserve
// method (section 593(f): no taxable year beginning after December 31,
// 1995); they are modelled under the pre-1996 window and the recapture
// rules of (g) that still bind. A "the Secretary shall prescribe" delegation
// is an EXTERNAL_DEPENDENCY row. Tables are read from the pinned table
// fragment: section 585's applicable fractions are 2/9, 1/3 and 4/9.

// ---- Section 582 ----

use self::{
    IRC_S582_A,
    IRC_S582_B,
    IRC_S582_C,
    IRC_S584_A,
    IRC_S584_B,
    IRC_S584_C,
    IRC_S584_D,
    IRC_S584_E,
    IRC_S584_G,
    IRC_S584_H,
    IRC_S584_I,
    IRC_S585_C,
    IRC_S585_TABLE_1,
    IRC_S591_A,
    IRC_S591_B,
    IRC_S593_B,
    IRC_S593_C,
    IRC_S593_F,
    IRC_S593_G,
    IRC_S594_A,
    Person,
    TaxableYear,
    controlled_group_applies_593g4E,
};

pub relation bank_debt_evidenced_by_security_582a(b: Person, debt: us.irc.core::Asset) kind empirical {
    label en unofficial "the debt held by the bank is evidenced by a security as defined in section 165(g)(2)(C)";
}
pub relation bank_582a(b: Person) kind empirical {
    label en unofficial "the taxpayer is a bank";
}
pub relation section_166a_b_apply_to_bank_security_debt_582a(b: Person, debt: us.irc.core::Asset) kind institutional {
    label en official "notwithstanding sections 165(g)(1) and 166(e), section 166(a) and (b) apply to the bank's debt evidenced by a security";
}
@source(IRC_S582_A, quote = "subsections (a) and (b) of section 166 (relating to allowance of deduction for bad debts) shall apply in the case of a bank to a debt which is evidenced by a security as defined in section 165(g)(2)(C)")
rule Section582aBadDebtOnSecurity(b: Person, debt: us.irc.core::Asset) strict {
    label en official "section 582(a): a bank's bad debt evidenced by a security is deductible under section 166";
    when bank_582a(b);
    when bank_debt_evidenced_by_security_582a(b, debt);
    then section_166a_b_apply_to_bank_security_debt_582a(b, debt);
}
pub relation percent_of_each_class_of_stock_of_other_bank_owned_directly_582b(b: Person, other: Person, min_class_percent: Decimal) kind empirical {
    label en unofficial "the lowest percentage, across the classes of stock of the other bank, that the taxpayer bank owns directly";
}
pub relation stock_of_other_bank_not_a_capital_asset_582b(b: Person, other: Person) kind institutional {
    label en official "for section 165(g)(1), stock in the other bank is not a capital asset";
}
@source(IRC_S582_B, quote = "stock in such other bank shall not be treated as a capital asset")
rule Section582bEightyPercentBankSubsidiary(b: Person, other: Person, pct: Decimal) strict {
    label en official "section 582(b): a bank owning directly at least 80 percent of each class of another bank's stock does not hold a capital asset";
    when bank_582a(b);
    when bank_582a(other);
    when percent_of_each_class_of_stock_of_other_bank_owned_directly_582b(b, other, pct);
    when pct >= 80.0;
    then stock_of_other_bank_not_a_capital_asset_582b(b, other);
}
pub relation domestic_or_foreign_bank_582c2Ai(fi: Person) kind empirical {
    label en unofficial "the institution is a bank (or a corporation that would be a bank but for being foreign)";
}
pub relation savings_institution_described_in_591_582c2Aii(fi: Person) kind empirical {
    label en unofficial "the institution is a financial institution referred to in section 591";
}
pub relation small_business_investment_company_582c2Aiii(fi: Person) kind empirical {
    label en unofficial "the institution is a small business investment company operating under the Small Business Investment Act of 1958";
}
pub relation business_development_corporation_582c2Aiv(fi: Person) kind institutional {
    label en unofficial "the institution is a business development corporation: created by or under a State legislature's act to promote the State's economy by making loans that banks would not generally make (section 582(c)(2)(B))";
}
pub relation financial_institution_582c2(fi: Person) kind institutional {
    label en official "a financial institution referred to in section 582(c)(2)";
}
rule Section582c2Ai(fi: Person) strict {
    label en official "section 582(c)(2)(A)(i): a bank";
    when domestic_or_foreign_bank_582c2Ai(fi);
    then financial_institution_582c2(fi);
}
rule Section582c2Aii(fi: Person) strict {
    label en official "section 582(c)(2)(A)(ii): a section 591 institution";
    when savings_institution_described_in_591_582c2Aii(fi);
    then financial_institution_582c2(fi);
}
rule Section582c2Aiii(fi: Person) strict {
    label en official "section 582(c)(2)(A)(iii): a small business investment company";
    when small_business_investment_company_582c2Aiii(fi);
    then financial_institution_582c2(fi);
}
rule Section582c2Aiv(fi: Person) strict {
    label en official "section 582(c)(2)(A)(iv): a business development corporation";
    when business_development_corporation_582c2Aiv(fi);
    then financial_institution_582c2(fi);
}
pub relation sale_of_evidence_of_indebtedness_582c1(fi: Person, sale: us.irc.core::Transaction) kind empirical {
    label en unofficial "the financial institution sells or exchanges a bond, debenture, note, certificate or other evidence of indebtedness (a regular or residual interest in a REMIC counts)";
}
pub relation foreign_corporation_bank_582c2C(fi: Person) kind empirical {
    label en unofficial "the institution is a foreign corporation referred to in subparagraph (A)(i)";
}
pub relation sale_effectively_connected_with_us_banking_582c2C(sale: us.irc.core::Transaction) kind empirical {
    label en unofficial "the gain or loss is effectively connected with the conduct of a banking business in the United States";
}
pub relation sale_not_a_sale_of_a_capital_asset_582c1(fi: Person, sale: us.irc.core::Transaction) kind institutional {
    label en official "the sale or exchange is not considered a sale or exchange of a capital asset";
}
@source(IRC_S582_C, quote = "the sale or exchange of a bond, debenture, note, or certificate or other evidence of indebtedness shall not be considered a sale or exchange of a capital asset")
rule Section582c1DomesticInstitutionSale(fi: Person, sale: us.irc.core::Transaction) defeasible {
    label en official "section 582(c)(1): a financial institution's debt sale is ordinary, for a domestic institution";
    when financial_institution_582c2(fi);
    when sale_of_evidence_of_indebtedness_582c1(fi, sale);
    when not_known(foreign_corporation_bank_582c2C(fi));
    then sale_not_a_sale_of_a_capital_asset_582c1(fi, sale);
}
@source(IRC_S582_C, quote = "paragraph (1) shall only apply to gains and losses which are effectively connected with the conduct of a banking business in the United States")
rule Section582c2CForeignBankSale(fi: Person, sale: us.irc.core::Transaction) strict {
    label en official "section 582(c)(2)(C): for a foreign bank paragraph (1) reaches only effectively connected gains and losses";
    when financial_institution_582c2(fi);
    when foreign_corporation_bank_582c2C(fi);
    when sale_of_evidence_of_indebtedness_582c1(fi, sale);
    when sale_effectively_connected_with_us_banking_582c2C(sale);
    then sale_not_a_sale_of_a_capital_asset_582c1(fi, sale);
}

// ---- Section 584: common trust funds ----

pub relation fund_maintained_by_bank_584a(f: Person, b: Person) kind empirical {
    label en unofficial "the fund is maintained by the bank";
}
pub relation fund_exclusively_for_collective_investment_by_fiduciary_584a1(f: Person) kind institutional {
    label en unofficial "exclusively for the collective investment and reinvestment of moneys contributed by the bank as trustee, executor, administrator or guardian, or as a custodian of qualifying accounts (State law substantially similar to the Uniform Gifts to Minors Act, with fiduciary-like duties)";
}
pub relation fund_conforms_to_regulator_rules_584a2(f: Person) kind empirical {
    label en unofficial "the fund is maintained in conformity with the rules and regulations, prevailing from time to time, of the Board of Governors of the Federal Reserve System or the Comptroller of the Currency pertaining to the collective investment of trust funds by national banks";
}
pub relation common_trust_fund_584a(f: Person) kind institutional {
    label en official "a common trust fund";
}
@source(IRC_S584_A, quote = "the term \"common trust fund\" means a fund maintained by a bank")
rule Section584aCommonTrustFund(f: Person, b: Person) defeasible {
    label en official "section 584(a): a fund maintained by a bank exclusively for fiduciary collective investment and in conformity with the banking regulators' rules";
    when bank_582a(b);
    when fund_maintained_by_bank_584a(f, b);
    when fund_exclusively_for_collective_investment_by_fiduciary_584a1(f);
    when fund_conforms_to_regulator_rules_584a2(f);
    then common_trust_fund_584a(f);
}
pub relation common_trust_fund_not_taxed_as_corporation_584b(f: Person) kind institutional {
    label en official "the common trust fund is not subject to tax under the chapter and is not considered a corporation";
}
@source(IRC_S584_B, quote = "A common trust fund shall not be subject to taxation under this chapter and for purposes of this chapter shall not be considered a corporation.")
rule Section584bNotTaxed(f: Person) defeasible {
    label en official "section 584(b): no entity tax";
    when common_trust_fund_584a(f);
    then common_trust_fund_not_taxed_as_corporation_584b(f);
}
pub relation fund_short_term_capital_gain_584c1(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fund's net short-term capital gain or loss (assets held not more than 1 year) for the taxable year";
}
pub relation fund_long_term_capital_gain_584c2(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fund's net long-term capital gain or loss (assets held more than 1 year) for the taxable year";
}
pub relation fund_ordinary_income_or_loss_584c3(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fund's ordinary taxable income or ordinary net loss for the taxable year, computed as in subsection (d)";
}
pub relation participant_share_of_fund_584c(p: Person, f: Person, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the participant's proportionate share of the fund for the year";
}
pub relation participant_short_term_inclusion_584c1(p: Person, f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the participant's proportionate share of the fund's short-term capital gain or loss, included whether or not distributed";
}
@source(IRC_S584_C, quote = "as part of its gains and losses from sales or exchanges of capital assets held for not more than 1 year")
rule Section584c1ShortTerm(p: Person, f: Person, y: TaxableYear, gain: Money, share: Decimal) defeasible {
    label en official "section 584(c)(1): proportionate share of the short-term gain or loss";
    when common_trust_fund_584a(f);
    when fund_short_term_capital_gain_584c1(f, y, gain);
    when participant_share_of_fund_584c(p, f, y, share);
    then participant_short_term_inclusion_584c1(p, f, y, round(gain * share, 2, "HALF_UP"));
}
pub relation participant_long_term_inclusion_584c2(p: Person, f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the participant's proportionate share of the fund's long-term capital gain or loss";
}
rule Section584c2LongTerm(p: Person, f: Person, y: TaxableYear, gain: Money, share: Decimal) defeasible {
    label en official "section 584(c)(2): proportionate share of the long-term gain or loss";
    when common_trust_fund_584a(f);
    when fund_long_term_capital_gain_584c2(f, y, gain);
    when participant_share_of_fund_584c(p, f, y, share);
    then participant_long_term_inclusion_584c2(p, f, y, round(gain * share, 2, "HALF_UP"));
}
pub relation participant_ordinary_inclusion_584c3(p: Person, f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the participant's proportionate share of the fund's ordinary taxable income or ordinary net loss";
}
rule Section584c3Ordinary(p: Person, f: Person, y: TaxableYear, income: Money, share: Decimal) defeasible {
    label en official "section 584(c)(3): proportionate share of the ordinary income or loss";
    when common_trust_fund_584a(f);
    when fund_ordinary_income_or_loss_584c3(f, y, income);
    when participant_share_of_fund_584c(p, f, y, share);
    then participant_ordinary_inclusion_584c3(p, f, y, round(income * share, 2, "HALF_UP"));
}
pub relation fund_gross_income_584d2A(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income of the fund, excluding capital gains and losses";
}
pub relation fund_deductions_584d2B(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the deductions of the fund, other than the section 170 deduction (which is not allowed)";
}
pub relation fund_ordinary_taxable_income_computed_584d2(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the fund's ordinary taxable income (the excess of gross income over deductions) or, negative, its ordinary net loss";
}
@source(IRC_S584_D, quote = "an ordinary taxable income which shall consist of the excess of the gross income over deductions")
rule Section584d2OrdinaryIncome(f: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 584(d)(2)(A)-(B): ordinary taxable income or ordinary net loss";
    when common_trust_fund_584a(f);
    when fund_gross_income_584d2A(f, y, gross);
    when fund_deductions_584d2B(f, y, deductions);
    then fund_ordinary_taxable_income_computed_584d2(f, y, gross - deductions);
}
pub relation fund_claims_charitable_deduction_584d3(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "the fund claims the section 170 charitable deduction";
}
@source(IRC_S584_D, quote = "the deduction provided by section 170 (relating to charitable, etc., contributions and gifts) shall not be allowed")
rule Section584d3NoCharitableDeduction(f: Person, y: TaxableYear) strict {
    label en official "section 584(d)(3): the fund may not claim the charitable deduction";
    when common_trust_fund_584a(f);
    when fund_year_584i(f, y);
    then prohibition NoCharitableDeductionByCommonTrustFund {
        bearer f;
        action fund_claims_charitable_deduction_584d3(f, y);
        window [@1954-01-01, infinity);
    };
}
pub relation fund_claims_nol_deduction_584g(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "the fund claims the section 172 net operating loss deduction";
}
@source(IRC_S584_G, quote = "The benefit of the deduction for net operating losses provided by section 172 shall not be allowed to a common trust fund")
rule Section584gNoNolForFund(f: Person, y: TaxableYear) strict {
    label en official "section 584(g): the fund may not claim the net operating loss deduction (participants may, under regulations)";
    when common_trust_fund_584a(f);
    when fund_year_584i(f, y);
    then prohibition NoNolDeductionByCommonTrustFund {
        bearer f;
        action fund_claims_nol_deduction_584g(f, y);
        window [@1954-01-01, infinity);
    };
}
pub relation participant_admitted_or_withdraws_584e(f: Person, p: Person, on: Date) kind empirical {
    label en unofficial "the participant is admitted to, or withdraws from, the fund on this date";
}
pub relation fund_recognizes_no_gain_or_loss_on_admission_or_withdrawal_584e(f: Person, p: Person, on: Date) kind institutional {
    label en official "no gain or loss is realized by the fund by the admission or withdrawal of a participant";
}
@source(IRC_S584_E, quote = "No gain or loss shall be realized by the common trust fund by the admission or withdrawal of a participant.")
rule Section584eNoGainOrLossForFund(f: Person, p: Person, on: Date) defeasible {
    label en official "section 584(e): admission and withdrawal are not realization events for the fund";
    when common_trust_fund_584a(f);
    when participant_admitted_or_withdraws_584e(f, p, on);
    then fund_recognizes_no_gain_or_loss_on_admission_or_withdrawal_584e(f, p, on);
}
pub relation fund_year_ends_within_or_with_participant_year_584f(f: Person, fy: TaxableYear, p: Person, py: TaxableYear) kind empirical {
    label en unofficial "the taxable year of the fund ends within or with the taxable year of the participant";
}
pub relation fund_year_included_in_participant_year_584f(f: Person, fy: TaxableYear, p: Person, py: TaxableYear) kind institutional {
    label en official "the participant's inclusion is based on the fund's taxable year ending within or with the participant's taxable year";
}
rule Section584fInclusionYear(f: Person, fy: TaxableYear, p: Person, py: TaxableYear) strict {
    label en official "section 584(f): the fund year that ends within or with the participant's year";
    when fund_year_ends_within_or_with_participant_year_584f(f, fy, p, py);
    then fund_year_included_in_participant_year_584f(f, fy, p, py);
}
pub relation fund_taxable_year_calendar_584i(f: Person, y: TaxableYear) kind institutional {
    label en official "the taxable year of the common trust fund is the calendar year";
}
pub relation fund_year_584i(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is a taxable year of the fund";
}
@source(IRC_S584_I, quote = "the taxable year of any common trust fund shall be the calendar year")
rule Section584iCalendarYear(f: Person, y: TaxableYear, n: Integer) strict {
    label en official "section 584(i): a fund's taxable year is a calendar year";
    when fund_year_584i(f, y);
    when us.irc.core::calendar_year_of(y, n);
    then fund_taxable_year_calendar_584i(f, y);
}
pub relation fund_transfers_substantially_all_assets_to_ric_solely_for_stock_584h1A(f: Person) kind empirical {
    label en unofficial "the fund transfers substantially all its assets to one or more regulated investment companies in exchange solely for stock in the RIC or RICs";
}
pub relation ric_stock_distributed_solely_for_interests_584h1B(f: Person) kind empirical {
    label en unofficial "the stock is distributed by the fund to its participants in exchange solely for their interests in the fund";
}
pub relation fund_meets_368a2F_requirement_584h4(f: Person) kind empirical {
    label en unofficial "the fund would meet the requirements of section 368(a)(2)(F)(ii) if it were a corporation";
}
pub relation fund_ric_transfer_nonrecognition_584h1(f: Person) kind institutional {
    label en official "no gain or loss is recognized by the fund by reason of the transfer or distribution, and none by the participants on the exchange of their interests for the stock";
}
@source(IRC_S584_H, quote = "no gain or loss shall be recognized by such common trust fund by reason of such transfer or distribution")
rule Section584h1RicTransfer(f: Person) strict {
    label en official "section 584(h)(1): transfer to RICs for stock and its distribution to participants";
    when fund_transfers_substantially_all_assets_to_ric_solely_for_stock_584h1A(f);
    when ric_stock_distributed_solely_for_interests_584h1B(f);
    when fund_meets_368a2F_requirement_584h4(f);
    then fund_ric_transfer_nonrecognition_584h1(f);
}
pub relation assumed_liabilities_of_fund_584h3B(f: Person, amount: Money) kind empirical {
    label en unofficial "the liabilities of the fund assumed by the RICs in the transfer (with the section 357(d) rules)";
}
pub relation aggregate_adjusted_bases_of_transferred_assets_584h3B(f: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate adjusted bases (in the hands of the fund) of the assets transferred";
}
pub relation fund_gain_on_excess_liabilities_584h3B(f: Person, amount: Money) kind institutional {
    label en official "gain recognized to the fund in the amount by which the assumed liabilities exceed the aggregate adjusted bases of the transferred assets";
}
@source(IRC_S584_H, quote = "gain shall be recognized to the common trust fund on such transfer in an amount equal to such excess")
rule Section584h3BExcessLiabilitiesGain(f: Person, liabilities: Money, bases: Money) strict {
    label en official "section 584(h)(3)(B)(i)(I): recognition of the excess of assumed liabilities over the bases";
    when fund_ric_transfer_nonrecognition_584h1(f);
    when assumed_liabilities_of_fund_584h3B(f, liabilities);
    when aggregate_adjusted_bases_of_transferred_assets_584h3B(f, bases);
    when liabilities > bases;
    then fund_gain_on_excess_liabilities_584h3B(f, liabilities - bases);
}
pub relation ric_asset_basis_increase_584h3B(f: Person, amount: Money) kind institutional {
    label en official "the basis of the assets received by the regulated investment company is increased by the gain so recognized";
}
rule Section584h3BiiBasisIncrease(f: Person, gain: Money) strict {
    label en official "section 584(h)(3)(B)(i)(II): the RIC's asset basis increases by the gain recognized";
    when fund_gain_on_excess_liabilities_584h3B(f, gain);
    then ric_asset_basis_increase_584h3B(f, gain);
}

// ---- Section 585(c)(3)-(5): recapture of the reserve on losing small bank status ----

pub relation bank_maintained_bad_debt_reserve_in_last_year_before_disqualification_585c3A(b: Person) kind empirical {
    label en unofficial "the bank for its last taxable year before the disqualification year maintained a reserve for bad debts";
}
pub relation net_section_481a_adjustment_585c3Aiii(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the net amount of adjustments required by section 481(a) as a result of the change of method for the disqualification year";
}
pub relation elected_first_year_percentage_585c3AiiiI(b: Person, pct: Decimal) kind empirical {
    label en unofficial "the higher percentage of the net amount the taxpayer elects to take into account in the first year (at least 10 percent)";
}
pub relation first_year_amount_585c3AiiiI(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount taken into account for the first year: the greater of 10 percent and the elected percentage of the net amount";
}
@source(IRC_S585_C, quote = "the amount taken into account for the 1st of such taxable years being the greater of 10 percent of such net amount or such higher percentage of such net amount as the taxpayer may elect")
rule Section585c3AiiiIFirstYear(b: Person, y: TaxableYear, net: Money, pct: Decimal) strict {
    label en official "section 585(c)(3)(A)(iii)(I): the greater of 10 percent and the elected percentage (one rounding)";
    when net_section_481a_adjustment_585c3Aiii(b, y, net);
    when elected_first_year_percentage_585c3AiiiI(b, pct);
    then first_year_amount_585c3AiiiI(b, y, div_round(net * max(10.0, pct), 100.0, 2, "HALF_UP"));
}
rule Section585c3AiiiIFirstYearDefaultTenPercent(b: Person, y: TaxableYear, net: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(I): 10 percent when no higher percentage is elected";
    when net_section_481a_adjustment_585c3Aiii(b, y, net);
    when not_known(has_elected_percentage_585c3(b));
    then first_year_amount_585c3AiiiI(b, y, div_round(net * 10.0, 100.0, 2, "HALF_UP"));
}
pub relation has_elected_percentage_585c3(b: Person) kind institutional {
    label en official "helper binding the open percentage argument: the bank elected a first-year percentage";
}
rule Section585c3HelperHasElectedPercentage(b: Person, pct: Decimal) strict {
    label en official "helper: an elected percentage exists";
    when elected_first_year_percentage_585c3AiiiI(b, pct);
    then has_elected_percentage_585c3(b);
}
pub relation succeeding_year_ordinal_585c3AiiiII(b: Person, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "y is the ordinal-th succeeding taxable year (1, 2 or 3) after the first year of the spread (TECH-GAPS G2201)";
}
pub relation succeeding_year_amount_585c3AiiiII(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount taken into account in a succeeding year: 2/9, 1/3 or 4/9 of the net amount not taken into account in the first year";
}
@source(IRC_S585_TABLE_1, quote = "1st succeeding year / 2/9 | 2nd succeeding year / 1/3 | 3rd succeeding year / 4/9")
rule Section585c3AiiiIIFirstSucceedingYear(b: Person, y: TaxableYear, net: Money, first: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(II) with the table: 2/9 of the remainder in the 1st succeeding year";
    when succeeding_year_ordinal_585c3AiiiII(b, y, 1);
    when net_section_481a_adjustment_585c3Aiii(b, y, net);
    when first_year_amount_585c3AiiiI(b, y, first);
    then succeeding_year_amount_585c3AiiiII(b, y, div_round((net - first) * 2.0, 9.0, 2, "HALF_UP"));
}
rule Section585c3AiiiIISecondSucceedingYear(b: Person, y: TaxableYear, net: Money, first: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(II) with the table: 1/3 of the remainder in the 2nd succeeding year";
    when succeeding_year_ordinal_585c3AiiiII(b, y, 2);
    when net_section_481a_adjustment_585c3Aiii(b, y, net);
    when first_year_amount_585c3AiiiI(b, y, first);
    then succeeding_year_amount_585c3AiiiII(b, y, div_round(net - first, 3.0, 2, "HALF_UP"));
}
rule Section585c3AiiiIIThirdSucceedingYear(b: Person, y: TaxableYear, net: Money, first: Money) strict {
    label en official "section 585(c)(3)(A)(iii)(II) with the table: 4/9 of the remainder in the 3rd succeeding year";
    when succeeding_year_ordinal_585c3AiiiII(b, y, 3);
    when net_section_481a_adjustment_585c3Aiii(b, y, net);
    when first_year_amount_585c3AiiiI(b, y, first);
    then succeeding_year_amount_585c3AiiiII(b, y, div_round((net - first) * 4.0, 9.0, 2, "HALF_UP"));
}
pub relation sum_of_nonperforming_loan_balances_at_quarter_closes_585c3Biv(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the outstanding balances of nonperforming loans of the bank as of the close of each quarter of the taxable year";
}
pub relation sum_of_equity_at_quarter_closes_585c3Biv(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the amounts of equity of the bank as of the close of each such quarter";
}
pub relation financially_troubled_bank_585c3Biii(b: Person, y: TaxableYear) kind institutional {
    label en official "the bank's nonperforming loan percentage for the year exceeds 75 percent";
}
@source(IRC_S585_C, quote = "the term \"financially troubled bank\" means any bank if, for the taxable year, the nonperforming loan percentage of such bank exceeds 75 percent")
rule Section585c3BiiiFinanciallyTroubled(b: Person, y: TaxableYear, npl: Money, equity: Money) strict {
    label en official "section 585(c)(3)(B)(iii)-(iv): nonperforming balances over equity, over 75 percent";
    when sum_of_nonperforming_loan_balances_at_quarter_closes_585c3Biv(b, y, npl);
    when sum_of_equity_at_quarter_closes_585c3Biv(b, y, equity);
    when npl * 100.0 > equity * 75.0;
    when not_known(member_of_parent_subsidiary_controlled_group_585c5A(b));
    then financially_troubled_bank_585c3Biii(b, y);
}
pub relation adjustment_taken_into_account_585c3(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjustment taken into account for the year: none for a financially troubled bank (the year is also disregarded for the spread)";
}
pub relation reserve_balance_at_close_of_year_585c4B(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the reserve for loans held on the first day of the disqualification year at the close of the taxable year (section 585(c)(4)(B))";
}
pub relation outstanding_balance_of_reserved_loans_585c4B(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the outstanding balance at the close of the taxable year of the loans held on the first day of the disqualification year";
}
pub relation elects_reserve_continuation_585c4(b: Person) kind empirical {
    label en unofficial "the bank makes the election under paragraph (4) for the disqualification year";
}
pub relation reserve_excess_included_in_gross_income_585c4(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess of the continued reserve over the outstanding balance of the loans is included in gross income";
}
@source(IRC_S585_C, quote = "such excess shall be included in gross income for such taxable year")
rule Section585c4ExcessReserveIncluded(b: Person, y: TaxableYear, reserve: Money, balance: Money) strict {
    label en official "section 585(c)(4) last sentence: the excess of the reserve over the outstanding loan balance is income";
    when elects_reserve_continuation_585c4(b);
    when reserve_balance_at_close_of_year_585c4B(b, y, reserve);
    when outstanding_balance_of_reserved_loans_585c4B(b, y, balance);
    when reserve > balance;
    then reserve_excess_included_in_gross_income_585c4(b, y, reserve - balance);
}
pub relation elects_reserve_continuation_for_disqualification_year_585c4(b: Person, y: TaxableYear) kind empirical {
    label en unofficial "the bank elects under paragraph (4), for the disqualification year, to keep its reserve";
}
pub relation reserve_continuation_election_in_effect_585c4(b: Person, y: TaxableYear) kind institutional {
    label en official "the paragraph (4) election is in effect: no change in method of accounting, the reserve continues, and no deduction is allowed for additions to it";
}
@source(IRC_S585_C, quote = "If a bank makes an election under this paragraph for the disqualification year")
rule Section585c4ElectionPower(b: Person, y: TaxableYear) strict {
    label en official "section 585(c)(4): the bank may elect to continue its reserve instead of the section 481(a) spread";
    when elects_reserve_continuation_for_disqualification_year_585c4(b, y);
    then power BankReserveContinuationElection {
        holder b;
        over b;
        exercise elects_reserve_continuation_for_disqualification_year_585c4(b, y);
        valid_when bank_maintained_a_reserve_for_preceding_year_585c5B(b);
        effect create(reserve_continuation_election_in_effect_585c4(b, y));
        window [@1987-01-01, infinity);
    };
}
pub relation bank_maintained_a_reserve_for_preceding_year_585c5B(b: Person) kind empirical {
    label en unofficial "the bank maintained a reserve for bad debts for the preceding taxable year (so that the year is a disqualification year)";
}
pub relation member_of_parent_subsidiary_controlled_group_585c5A(b: Person) kind empirical {
    label en unofficial "the bank is a member of a controlled group of corporations described in section 1563(a)(1)";
}
pub relation election_made_separately_by_each_member_585c5C(b: Person) kind institutional {
    label en official "any election under this section is made separately by each member of a parent-subsidiary controlled group";
}
@source(IRC_S585_C, quote = "any election under this section shall be made separately by each member of such group")
rule Section585c5CSeparateElections(b: Person) strict {
    label en official "section 585(c)(5)(C): each member of the group elects separately";
    when member_of_parent_subsidiary_controlled_group_585c5A(b);
    then election_made_separately_by_each_member_585c5C(b);
}

// ---- Section 591 ----

pub relation savings_institution_591a(i: Person) kind empirical {
    label en unofficial "the institution is a mutual savings bank, cooperative bank, domestic building and loan association, or other savings institution chartered and supervised as a savings and loan or similar association under Federal or State law";
}
pub relation amount_paid_or_credited_to_depositors_591a(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts paid or credited to the accounts of depositors or holders of accounts as dividends or interest on their deposits or withdrawable accounts";
}
pub relation amounts_withdrawable_on_demand_591a(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amounts paid or credited are withdrawable on demand subject only to customary notice of intention to withdraw";
}
pub relation deduction_for_amounts_paid_to_depositors_591a(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the deduction for amounts paid to, or credited to the accounts of, depositors as dividends or interest";
}
@source(IRC_S591_A, quote = "there shall be allowed as deductions in computing taxable income amounts paid to, or credited to the accounts of, depositors or holders of accounts as dividends or interest on their deposits or withdrawable accounts")
rule Section591aDepositorInterestDeduction(i: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 591(a): a savings institution deducts interest and dividends on withdrawable deposits";
    when savings_institution_591a(i);
    when amount_paid_or_credited_to_depositors_591a(i, y, amount);
    when amounts_withdrawable_on_demand_591a(i, y);
    then deduction_for_amounts_paid_to_depositors_591a(i, y, amount);
}
pub relation bank_with_capital_stock_represented_by_shares_591b1(b: Person) kind empirical {
    label en unofficial "the bank has capital stock represented by shares";
}
pub relation bank_subject_to_and_operates_under_mutual_savings_bank_laws_591b2(b: Person) kind empirical {
    label en unofficial "the bank is subject to, and operates under, Federal or State laws relating to mutual savings banks";
}
pub relation mutual_savings_bank_includes_591b(b: Person) kind institutional {
    label en official "for this part the term mutual savings bank includes a bank with capital stock represented by shares that operates under mutual savings bank laws";
}
@source(IRC_S591_B, quote = "the term \"mutual savings bank\" includes any bank")
rule Section591bMutualSavingsBankIncludes(b: Person) strict {
    label en official "section 591(b)(1)-(2): a bank with capital stock represented by shares subject to mutual savings bank laws";
    when bank_with_capital_stock_represented_by_shares_591b1(b);
    when bank_subject_to_and_operates_under_mutual_savings_bank_laws_591b2(b);
    then mutual_savings_bank_includes_591b(b);
}

// ---- Section 593: thrift reserves (pre-1996) ----

pub relation thrift_institution_593a1(i: Person) kind empirical {
    label en unofficial "a domestic building and loan association, a mutual savings bank, or a cooperative bank without capital stock organized and operated for mutual purposes and without profit";
}
pub relation meets_7701a19C_593a2(i: Person) kind empirical {
    label en unofficial "the association or bank meets the requirements of section 7701(a)(19)(C)";
}
pub relation year_begins_593(y: TaxableYear, begins_on: Date) kind empirical {
    label en unofficial "the first day of the taxable year";
}
pub relation thrift_reserve_method_available_593a(i: Person, y: TaxableYear) kind institutional {
    label en official "the thrift reserve deduction is available: a qualifying institution, in a year beginning before January 1, 1996 (section 593(f))";
}
@source(IRC_S593_F, quote = "Subsections (a), (b), (c), and (d) shall not apply to any taxable year beginning after December 31, 1995.")
rule Section593aAvailableBefore1996(i: Person, y: TaxableYear, begins_on: Date) strict {
    label en official "sections 593(a)(2), (f): a section 7701(a)(19)(C) institution, for years beginning before 1996";
    when thrift_institution_593a1(i);
    when meets_7701a19C_593a2(i);
    when year_begins_593(y, begins_on);
    when begins_on <= @1995-12-31;
    then thrift_reserve_method_available_593a(i, y);
}
pub relation taxable_income_for_593b2A(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "taxable income for the year as computed under section 593(b)(2)(D) (before the bad debt reserve deduction and with the listed exclusions)";
}
pub relation nonqualifying_loan_reserve_addition_593b1A(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the reasonable addition to the reserve for losses on nonqualifying loans, computed under section 585 rules";
}
pub relation qualifying_real_property_loans_outstanding_593b2C(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the qualifying real property loans outstanding at the close of the taxable year";
}
pub relation qualifying_loan_reserve_balance_before_addition_593b2C(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the balance of the reserve for losses on qualifying real property loans before the year's addition";
}
pub relation qualifying_loan_reserve_percentage_of_taxable_income_addition_593b2(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 593(b)(2) amount: 8 percent of taxable income, reduced by the nonqualifying-loan addition, and not more than the amount raising the reserve to 6 percent of qualifying loans";
}
@source(IRC_S593_B, quote = "the amount determined under this paragraph for the taxable year shall be an amount equal to 8 percent of the taxable income for such year")
rule Section593b2PercentageOfTaxableIncome(i: Person, y: TaxableYear, ti: Money, nonqual: Money, loans: Money, reserve: Money) defeasible {
    label en official "section 593(b)(2)(A)-(C): 8 percent of taxable income less the paragraph (1)(A) addition, capped at 6 percent of qualifying loans less the reserve";
    when thrift_reserve_method_available_593a(i, y);
    when taxable_income_for_593b2A(i, y, ti);
    when nonqualifying_loan_reserve_addition_593b1A(i, y, nonqual);
    when qualifying_real_property_loans_outstanding_593b2C(i, y, loans);
    when qualifying_loan_reserve_balance_before_addition_593b2C(i, y, reserve);
    then qualifying_loan_reserve_percentage_of_taxable_income_addition_593b2(i, y, max(0.00 USD, min(div_round(ti * 8.0, 100.0, 2, "HALF_UP") - nonqual, div_round(loans * 6.0, 100.0, 2, "HALF_UP") - reserve)));
}
pub relation deposits_or_withdrawable_accounts_at_close_593b1Bii(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total deposits or withdrawable accounts of depositors at the close of the year";
}
pub relation surplus_undivided_profits_reserves_at_beginning_593b1Bii(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of surplus, undivided profits and reserves at the beginning of the year";
}
pub relation twelve_percent_of_deposits_alternative_593b1Bii(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount which, with the nonqualifying addition, equals the excess of 12 percent of deposits over surplus, undivided profits and reserves";
}
@source(IRC_S593_B, quote = "equals the amount by which 12 percent of the total deposits or withdrawable accounts of depositors of the taxpayer at the close of such year exceeds the sum of its surplus, undivided profits, and reserves at the beginning of such year")
rule Section593b1BiiTwelvePercentOfDeposits(i: Person, y: TaxableYear, deposits: Money, surplus: Money, nonqual: Money) strict {
    label en official "section 593(b)(1)(B)(ii): 12 percent of deposits less surplus, undivided profits and reserves, less the nonqualifying addition";
    when thrift_reserve_method_available_593a(i, y);
    when deposits_or_withdrawable_accounts_at_close_593b1Bii(i, y, deposits);
    when surplus_undivided_profits_reserves_at_beginning_593b1Bii(i, y, surplus);
    when nonqualifying_loan_reserve_addition_593b1A(i, y, nonqual);
    then twelve_percent_of_deposits_alternative_593b1Bii(i, y, max(0.00 USD, (div_round(deposits * 12.0, 100.0, 2, "HALF_UP") - surplus) - nonqual));
}
pub relation experience_method_amount_593b3(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount determined under paragraph (3): computed as for banks under section 585(b)(2) (the experience method; the figure is asserted, or read from the 585(b)(2) rules of module 01 for a bank)";
}
pub relation reasonable_addition_to_thrift_reserve_593b1(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the reasonable addition to the reserve for bad debts: the nonqualifying addition plus the taxpayer's qualifying addition, which is capped by the larger of the paragraph (2) and (3) amounts and by the larger of the paragraph (3) amount and the 12 percent amount";
}
pub relation taxpayer_determined_qualifying_addition_593b1B(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the taxpayer determines to be a reasonable addition to the reserve for losses on qualifying real property loans";
}
@source(IRC_S593_B, quote = "the reasonable addition for the taxable year to the reserve for bad debts of any taxpayer described in subsection (a) shall be an amount equal to the sum of")
rule Section593b1Sum(i: Person, y: TaxableYear, nonqual: Money, chosen: Money, pct: Money, exp: Money, twelve: Money) defeasible {
    label en official "section 593(b)(1): the nonqualifying addition plus the qualifying addition, not more than the larger of (2) and (3) and not more than the larger of (3) and the 12 percent amount";
    when nonqualifying_loan_reserve_addition_593b1A(i, y, nonqual);
    when taxpayer_determined_qualifying_addition_593b1B(i, y, chosen);
    when qualifying_loan_reserve_percentage_of_taxable_income_addition_593b2(i, y, pct);
    when experience_method_amount_593b3(i, y, exp);
    when twelve_percent_of_deposits_alternative_593b1Bii(i, y, twelve);
    then reasonable_addition_to_thrift_reserve_593b1(i, y, nonqual + min(chosen, min(max(pct, exp), max(exp, twelve))));
}
pub relation addition_to_supplemental_reserve_claimed_593c1(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer claims a deduction for an addition to the supplemental reserve for losses on loans";
}
pub relation uses_reserve_method_593c1(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer uses the reserve method of accounting for bad debts";
}
@source(IRC_S593_C, quote = "no deduction shall be allowed for any addition to the supplemental reserve for losses on loans")
rule Section593c1NoDeductionForSupplementalReserve(i: Person, y: TaxableYear) strict {
    label en official "section 593(c)(1): no deduction for an addition to the supplemental reserve";
    when thrift_reserve_method_available_593a(i, y);
    when uses_reserve_method_593c1(i, y);
    then prohibition NoDeductionForSupplementalReserveAddition {
        bearer i;
        action addition_to_supplemental_reserve_claimed_593c1(i, y);
        window [@1969-01-01, @1995-12-31];
    };
}
pub relation applicable_excess_reserves_593g2(i: Person, amount: Money) kind institutional {
    label en official "the applicable excess reserves: the reserves at the close of the last year before 1996 (other than the supplemental reserve) over the lesser of the balance at the close of the last year beginning before 1988 and its reduced amount";
}
pub relation reserves_close_of_last_year_before_1996_593g2Ai(i: Person, amount: Money) kind empirical {
    label en unofficial "the balance of the reserves described in subsection (c)(1) (other than the supplemental reserve) as of the close of the last taxable year beginning before January 1, 1996";
}
pub relation reserves_close_of_last_year_before_1988_593g2AiiI(i: Person, amount: Money) kind empirical {
    label en unofficial "the balance of such reserves as of the close of the last taxable year beginning before January 1, 1988";
}
pub relation reserves_1988_balance_reduced_593g2AiiII(i: Person, amount: Money) kind empirical {
    label en unofficial "the balance of those reserves reduced in the same manner as under section 585(b)(2)(B)(ii) on the basis of the loan experience after 1987";
}
@source(IRC_S593_G, quote = "the term \"applicable excess reserves\" means the excess (if any) of")
rule Section593g2AApplicableExcessReserves(i: Person, close_1995: Money, close_1987: Money, reduced: Money) strict {
    label en official "section 593(g)(2)(A): reserves over the lesser of the two 1987-based balances (never below zero)";
    when reserves_close_of_last_year_before_1996_593g2Ai(i, close_1995);
    when reserves_close_of_last_year_before_1988_593g2AiiI(i, close_1987);
    when reserves_1988_balance_reduced_593g2AiiII(i, reduced);
    then applicable_excess_reserves_593g2(i, max(0.00 USD, close_1995 - min(close_1987, reduced)));
}
pub relation annual_recapture_under_593g1(i: Person, amount: Money) kind institutional {
    label en official "the section 481(a) net adjustment (applicable excess reserves only) taken into account ratably over the 6-taxable-year period";
}
@source(IRC_S593_G, quote = "as so determined, shall be taken into account ratably over the 6-taxable year period")
rule Section593g1CSixYearRatableRecapture(i: Person, excess: Money) strict {
    label en official "section 593(g)(1)(C): one sixth of the applicable excess reserves a year";
    when applicable_excess_reserves_593g2(i, excess);
    then annual_recapture_under_593g1(i, div_round(excess, 6.0, 2, "HALF_UP"));
}
pub relation residential_loans_principal_made_in_year_593g4B(i: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the principal amount of the residential loans made by the taxpayer during the year";
}
pub relation base_amount_average_of_prior_six_years_593g4D(i: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the base amount: the average of the principal amounts of the residential loans made by the taxpayer for the 6 most recent taxable years beginning before January 1, 1996";
}
pub relation residential_loan_requirement_met_593g4B(i: Person, y: TaxableYear) kind institutional {
    label en official "the residential loan principal made in the year is not less than the base amount";
}
@source(IRC_S593_G, quote = "A taxpayer meets the residential loan requirement of this subparagraph for any taxable year if the principal amount of the residential loans made by the taxpayer during such year is not less than the base amount for such year.")
rule Section593g4BResidentialLoanRequirement(i: Person, y: TaxableYear, made: Money, base: Money) strict {
    label en official "section 593(g)(4)(B): residential loans made at least equal the base amount";
    when residential_loans_principal_made_in_year_593g4B(i, y, made);
    when base_amount_average_of_prior_six_years_593g4D(i, y, base);
    when not_known(controlled_group_applies_593g4E(i));
    when made >= base;
    then residential_loan_requirement_met_593g4B(i, y);
}
pub relation recapture_deferred_for_residential_lender_593g4A(i: Person, y: TaxableYear) kind institutional {
    label en official "for the first year beginning after 1995 in which the bank meets the residential loan requirement, no adjustment is taken into account and the year is disregarded";
}
pub relation first_taxable_year_beginning_after_1995_593g4A(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "y is the first taxable year beginning after December 31, 1995";
}
rule Section593g4ADeferral(i: Person, y: TaxableYear) strict {
    label en official "section 593(g)(4)(A): the residential lender defers the recapture for the year";
    when first_taxable_year_beginning_after_1995_593g4A(i, y);
    when residential_loan_requirement_met_593g4B(i, y);
    then recapture_deferred_for_residential_lender_593g4A(i, y);
}
pub relation thrift_becomes_credit_union_593g7(i: Person) kind empirical {
    label en unofficial "the taxpayer to which paragraph (1) applied becomes a credit union described in section 501(c) and exempt from tax under section 501(a)";
}
pub relation credit_union_not_treated_as_bank_593g7B(i: Person) kind institutional {
    label en official "for paragraph (3) the credit union is not treated as if it were a bank; amounts required to be included are treated as derived from an unrelated trade or business";
}
rule Section593g7BCreditUnionNotBank(i: Person) strict {
    label en official "section 593(g)(7)(B)";
    when thrift_becomes_credit_union_593g7(i);
    then credit_union_not_treated_as_bank_593g7B(i);
}

// ---- Section 594 ----

pub relation mutual_savings_bank_without_capital_stock_594a(b: Person) kind empirical {
    label en unofficial "the mutual savings bank has no capital stock represented by shares, is authorised under State law to issue life insurance contracts, and conducts a life insurance business in a separately accounted department";
}
pub relation life_insurance_department_would_qualify_under_816_594b(b: Person) kind empirical {
    label en unofficial "the life insurance department would, if treated as a separate corporation, qualify as a life insurance company under section 816";
}
pub relation partial_tax_on_bank_income_without_life_department_594a1(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partial tax computed on the taxable income determined without regard to items allocable to the life insurance department";
}
pub relation partial_tax_on_life_insurance_department_594a2(b: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the partial tax computed on the income of the life insurance department, determined without regard to items allocable to the rest of the business, at the rates and in the manner of the life insurance company tax";
}
pub relation tax_in_lieu_of_section_11_594a(b: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed in lieu of the section 11 tax: the sum of the two partial taxes";
}
@source(IRC_S594_A, quote = "there shall be imposed in lieu of the tax imposed by section 11, a tax consisting of the sum of the partial taxes determined under paragraphs (1) and (2)")
rule Section594aSumOfPartialTaxes(b: Person, y: TaxableYear, bank_tax: Money, life_tax: Money) strict {
    label en official "sections 594(a)-(b): the sum of the partial taxes, when the life department would qualify under section 816";
    when mutual_savings_bank_without_capital_stock_594a(b);
    when life_insurance_department_would_qualify_under_816_594b(b);
    when partial_tax_on_bank_income_without_life_department_594a1(b, y, bank_tax);
    when partial_tax_on_life_insurance_department_594a2(b, y, life_tax);
    then tax_in_lieu_of_section_11_594a(b, y, bank_tax + life_tax);
}

// ---- Section 597 ----

pub relation money_or_property_provided_by_fslic_for_building_and_loan_597c1(a: Person, amount: Money) kind empirical {
    label en unofficial "money or other property provided with respect to a domestic building and loan association by the Federal Savings and Loan Insurance Corporation (or its successor)";
}
pub relation money_or_property_provided_by_fdic_597c2(a: Person, amount: Money) kind empirical {
    label en unofficial "money or other property provided with respect to a bank or domestic building and loan association by the Federal Deposit Insurance Corporation (or its successor)";
}
pub relation federal_financial_assistance_597c(a: Person, amount: Money) kind institutional {
    label en official "the amount of Federal financial assistance: money or other property provided, whether or not any note or other instrument is issued in exchange";
}
rule Section597c1FslicAssistance(a: Person, amount: Money) strict {
    label en official "section 597(c)(1)";
    when money_or_property_provided_by_fslic_for_building_and_loan_597c1(a, amount);
    then federal_financial_assistance_597c(a, amount);
}
rule Section597c2FdicAssistance(a: Person, amount: Money) strict {
    label en official "section 597(c)(2)";
    when money_or_property_provided_by_fdic_597c2(a, amount);
    then federal_financial_assistance_597c(a, amount);
}
pub relation domestic_building_and_loan_association_597d(a: Person) kind empirical {
    label en unofficial "the association is a domestic building and loan association as defined in section 7701(a)(19), without regard to subparagraph (C)";
}
