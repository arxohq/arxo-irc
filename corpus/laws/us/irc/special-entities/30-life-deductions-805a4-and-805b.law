// Section 805(a)(4) (dividends received by a life insurance company: the
// 100 percent dividend, the aggregate limit, the foreign-corporation rule,
// the increase in policy cash values, the portion of a dividend attributable
// to prorated amounts) and 805(b) (the modifications of the "other
// deductions" of 805(a)(8)), with the closing sentence of 805(a).
// Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. The dividends-received deduction is built from itemised
// dividends: the deduction percentage of sections 243 and 245 (owned by
// us.irc.deductions, not imported) is an asserted input per dividend, the
// company's share is the flat 70 percent of module 08 (section 812), and the
// 100 percent dividend of (C) is decided from that percentage and the (C)(ii)
// exclusion. The aggregate limit of (B) reads a section 246(b)(3) percentage
// and a base taxable income computed without the excluded items, both
// asserted (section 246 and the circular taxable income are outside this
// package). The "other deductions" of (a)(8) are built from itemised
// deductions filtered by the modifications of (b). Module 07's aggregate
// facts (`dividends_received_805a4_before_proration`, `other_deductions_805a8`)
// stay valid second paths. Sums over derived items are the section 111
// runtime subset (TECH-GAPS G4903).

// ---- Section 805(a)(4)(F): the increase in policy cash values ----

use self::{
    Contract,
    IRC_S805_A,
    IRC_S805_B,
    Person,
    ReserveBoundary807,
    TaxableYear,
    companys_share_812a,
    dividends_received_805a4_before_proration,
    other_deductions_805a8,
    portion_of_dividend_attributable_to_prorated_amounts,
};

@source(IRC_S805_A, quote = "The increase in the policy cash value for any taxable year with respect to policy or contract is the amount of the increase in the adjusted cash value during such taxable year")
pub relation cash_surrender_value_at_805a4F(policy: Contract, y: TaxableYear, boundary: ReserveBoundary807, amount: Money) kind empirical {
    label en unofficial "the cash surrender value of the policy or contract at the beginning or the end of the taxable year";
}
pub relation commissions_payable_805a4Fii(policy: Contract, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "commissions payable with respect to the policy or contract for the taxable year";
}
pub relation fees_and_charges_imposed_805a4Fii(policy: Contract, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "asset management fees, surrender charges, mortality and expense charges and other fees or charges specified in regulations, imposed (or that would be imposed on cancellation) for the taxable year";
}
pub relation gross_premiums_paid_805a4Fi(policy: Contract, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "gross premiums paid during the taxable year";
}
pub relation distributions_not_includible_72e_805a4Fi(policy: Contract, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "distributions during the taxable year to which section 72(e) applies, other than amounts includible in the policyholder's gross income";
}
pub relation adjusted_cash_value_at_end_805a4Fii(policy: Contract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted cash value: the year-end cash surrender value increased by the year's commissions payable and fees and charges (INTERPRETATION: the year's add-ons are applied to the year-end value only, since the same add-ons at both dates would cancel)";
}
@source(IRC_S805_A, quote = "the term \"adjusted cash value\" means the cash surrender value of the policy or contract increased by the sum of")
rule Section805a4FiiAdjustedCashValue(policy: Contract, y: TaxableYear, csv: Money, commissions: Money, fees: Money) strict {
    label en official "section 805(a)(4)(F)(ii): cash surrender value plus commissions payable plus fees and charges";
    when cash_surrender_value_at_805a4F(policy, y, ClosingBalance, csv);
    when commissions_payable_805a4Fii(policy, y, commissions);
    when fees_and_charges_imposed_805a4Fii(policy, y, fees);
    then adjusted_cash_value_at_end_805a4Fii(policy, y, csv + commissions + fees);
}
pub relation increase_in_policy_cash_value_805a4F(policy: Contract, y: TaxableYear, amount: Money) kind institutional {
    label en official "the increase in the policy cash value: the increase in the adjusted cash value determined without regard to the year's gross premiums and to non-includible section 72(e) distributions";
}
@source(IRC_S805_A, quote = "is the amount of the increase in the adjusted cash value during such taxable year determined without regard to")
rule Section805a4FiIncrease(policy: Contract, y: TaxableYear, acv_end: Money, csv_begin: Money, premiums: Money, distributions: Money) strict {
    label en official "section 805(a)(4)(F)(i): (adjusted cash value at the end - cash surrender value at the beginning) less the premiums paid plus the non-includible distributions";
    when adjusted_cash_value_at_end_805a4Fii(policy, y, acv_end);
    when cash_surrender_value_at_805a4F(policy, y, OpeningBalance, csv_begin);
    when gross_premiums_paid_805a4Fi(policy, y, premiums);
    when distributions_not_includible_72e_805a4Fi(policy, y, distributions);
    then increase_in_policy_cash_value_805a4F(policy, y, ((acv_end - csv_begin) - premiums) + distributions);
}

// ---- Section 805(a)(4)(C): the 100 percent dividend ----

@source(IRC_S805_A, quote = "the term \"100 percent dividend\" means any dividend if the percentage used for purposes of determining the deduction allowable under section 243 or 245(b) is 100 percent")
pub relation dividend_received_805a4(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money) kind empirical {
    label en unofficial "a dividend the life insurance company received from the payer in the taxable year";
}
pub relation deduction_percentage_used_243_245_805a4C(item: us.irc.core::Payment, pct: Decimal) kind empirical {
    label en unofficial "the percentage used for determining the deduction allowable under section 243 or 245(b) for the dividend (an input from us.irc.deductions, which this package does not import)";
}
pub relation payer_is_insurance_company_805a4Cii(payer: Person) kind empirical {
    label en unofficial "the paying corporation is an insurance company";
}
pub relation distribution_out_of_prorated_source_805a4Cii(item: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the part of the distribution that is out of tax-exempt interest, out of the increase in policy cash values of life insurance policies and annuity and endowment contracts to which section 264(f) applies, or out of dividends which are not 100 percent dividends";
}
pub relation hundred_percent_dividend_amount_805a4C(item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the dividend that is a 100 percent dividend";
}
@source(IRC_S805_A, quote = "Except as provided in clause (ii), the term \"100 percent dividend\" means any dividend if the percentage used for purposes of determining the deduction allowable under section 243 or 245(b) is 100 percent.")
rule Section805a4CiFromInsurer(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, pct: Decimal) defeasible {
    label en official "section 805(a)(4)(C)(i): the deduction percentage is 100 percent (an insurance payer: no clause (ii) reduction)";
    when dividend_received_805a4(c, y, item, payer, amount);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct >= 1.00;
    when payer_is_insurance_company_805a4Cii(payer);
    then hundred_percent_dividend_amount_805a4C(item, amount);
}
@source(IRC_S805_A, quote = "The term \"100 percent dividend\" does not include any distribution by a corporation which is not an insurance company to the extent such distribution is out of tax-exempt interest")
rule Section805a4CiiNoninsurerNoProratedSource(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, pct: Decimal) defeasible {
    label en official "section 805(a)(4)(C)(ii): a noninsurer's 100 percent dividend with no part out of the excluded sources";
    when dividend_received_805a4(c, y, item, payer, amount);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct >= 1.00;
    when not_known(payer_is_insurance_company_805a4Cii(payer));
    when not_known(prorated_source_stated_805a4Cii(item));
    then hundred_percent_dividend_amount_805a4C(item, amount);
}
pub relation prorated_source_stated_805a4Cii(item: us.irc.core::Payment) kind institutional {
    label en official "a part of the distribution out of an excluded source is stated for the item (helper)";
}
rule Section805a4CiiProratedSourceStated(item: us.irc.core::Payment, amount: Money) strict {
    label en official "helper";
    when distribution_out_of_prorated_source_805a4Cii(item, amount);
    then prorated_source_stated_805a4Cii(item);
}
rule Section805a4CiiNoninsurerLessExcludedPart(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, pct: Decimal, excluded: Money) defeasible {
    label en official "section 805(a)(4)(C)(ii): a noninsurer's distribution is a 100 percent dividend only to the extent it is not out of tax-exempt interest, 264(f) policy cash value increases or non-100 percent dividends";
    when dividend_received_805a4(c, y, item, payer, amount);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct >= 1.00;
    when not_known(payer_is_insurance_company_805a4Cii(payer));
    when distribution_out_of_prorated_source_805a4Cii(item, excluded);
    then hundred_percent_dividend_amount_805a4C(item, amount - excluded);
}
pub relation other_dividend_amount_805a4A(item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the dividend that is a dividend other than a 100 percent dividend";
}
@source(IRC_S805_A, quote = "(ii) for the life insurance company's share of the dividends (other than 100 percent dividends) received.")
rule Section805a4AOtherWholeDividend(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, pct: Decimal) defeasible {
    label en official "section 805(a)(4)(A)(ii): a dividend whose deduction percentage is below 100 percent is wholly another dividend";
    when dividend_received_805a4(c, y, item, payer, amount);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct < 1.00;
    then other_dividend_amount_805a4A(item, amount);
}
rule Section805a4AOtherProratedPart(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, pct: Decimal, excluded: Money) defeasible {
    label en official "section 805(a)(4)(C)(ii): the excluded part of a noninsurer's 100 percent distribution is another dividend";
    when dividend_received_805a4(c, y, item, payer, amount);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when pct >= 1.00;
    when not_known(payer_is_insurance_company_805a4Cii(payer));
    when distribution_out_of_prorated_source_805a4Cii(item, excluded);
    then other_dividend_amount_805a4A(item, excluded);
}

// ---- Section 805(a)(4)(A), (E): the deduction components ----

pub relation foreign_receiver_dividend_805a4E(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the dividend is received by a foreign corporation from a domestic corporation and would be a 100 percent dividend if section 1504(b)(3) did not apply for purposes of applying section 243(b)(2)";
}
pub relation dividends_received_component_805a4A(c: Person, y: TaxableYear, item: us.irc.core::Payment, component_i: Boolean, amount: Money) kind institutional {
    label en official "the section 243/245 deduction component of an itemised dividend: true for component (i) (100 percent dividends), false for component (ii) (the company's share of other dividends)";
}
@source(IRC_S805_A, quote = "(i) for 100 percent dividends received, and")
rule Section805a4AiHundredPercent(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money, dividend: Money) defeasible {
    label en official "section 805(a)(4)(A)(i): the deduction for 100 percent dividends received (at 100 percent)";
    when dividend_received_805a4(c, y, item, payer, dividend);
    when hundred_percent_dividend_amount_805a4C(item, amount);
    then dividends_received_component_805a4A(c, y, item, true, amount);
}
@source(IRC_S805_A, quote = "Subparagraph (A)(i) (and not subparagraph (A)(ii)) shall apply to any dividend received by a foreign corporation from a domestic corporation which would be a 100 percent dividend if section 1504(b)(3) did not apply for purposes of applying section 243(b)(2).")
rule Section805a4EForeignReceiverIsComponentI(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, amount: Money) defeasible {
    label en official "section 805(a)(4)(E): a dividend of that kind received by a foreign corporation gets only the (A)(i) deduction, at 100 percent of the dividend";
    when dividend_received_805a4(c, y, item, payer, amount);
    when foreign_receiver_dividend_805a4E(item);
    then dividends_received_component_805a4A(c, y, item, true, amount);
}
@source(IRC_S805_A, quote = "(ii) for the life insurance company's share of the dividends (other than 100 percent dividends) received.")
rule Section805a4AiiCompanysShare(c: Person, y: TaxableYear, item: us.irc.core::Payment, payer: Person, dividend: Money, other: Money, pct: Decimal, share: Decimal) defeasible {
    label en official "section 805(a)(4)(A)(ii): the deduction percentage of section 243/245 applied to the company's share (section 812) of the other dividends (one rounding, cents HALF_UP; the amount is share x percentage x the other dividend)";
    when dividend_received_805a4(c, y, item, payer, dividend);
    when other_dividend_amount_805a4A(item, other);
    when deduction_percentage_used_243_245_805a4C(item, pct);
    when companys_share_812a(c, y, share);
    when not_known(foreign_receiver_dividend_805a4E(item));
    then dividends_received_component_805a4A(c, y, item, false, round(other * (pct * share), 2, "HALF_UP"));
}
pub relation dividends_received_before_limit_805a4A(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the section 243/245 deductions for the year before the section 246(b) limit (a sum over derived components, TECH-GAPS G4903)";
}
rule Section805a4ATotal(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_flag: Boolean, anchor_amount: Money) defeasible {
    label en official "section 805(a)(4)(A): components (i) and (ii) added";
    when dividends_received_component_805a4A(c, y, anchor, anchor_flag, anchor_amount);
    then dividends_received_before_limit_805a4A(c, y, sum all amount: Money for item: us.irc.core::Payment where dividends_received_component_805a4A(c, y, item, _, amount));
}

// ---- Section 805(a)(4)(B): the aggregate limit ----

@source(IRC_S805_A, quote = "the limit on the aggregate amount of the deductions allowed by sections 243(a)(1) and 245 shall be the percentage determined under section 246(b)(3) of the life insurance company taxable income")
pub relation section_246b3_percentage_805a4B(c: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage determined under section 246(b)(3) (section 246 is owned by us.irc.deductions and not imported; asserted)";
}
pub relation licti_before_limit_805a4B(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the life insurance company taxable income computed without regard to the deduction allowed under section 172, the deductions allowed by sections 243(a)(1) and 245, and any capital loss carryback under section 1212(a)(1) (asserted: the taxable income itself depends on this deduction)";
}
@source(IRC_S805_A, quote = "but such limit shall not apply for any taxable year for which there is a loss from operations.")
pub relation loss_from_operations_805a4B(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "there is a loss from operations for the taxable year";
}
pub relation aggregate_dividend_limit_805a4B(c: Person, y: TaxableYear, limit: Money) kind institutional {
    label en official "the limit on the aggregate section 243(a)(1) and 245 deductions: the section 246(b)(3) percentage of the base taxable income";
}
rule Section805a4BLimit(c: Person, y: TaxableYear, pct: Decimal, base: Money) strict {
    label en official "section 805(a)(4)(B): the percentage of the taxable income computed without the excluded items (cents HALF_UP is a JUDGMENT CALL)";
    when section_246b3_percentage_805a4B(c, y, pct);
    when licti_before_limit_805a4B(c, y, base);
    then aggregate_dividend_limit_805a4B(c, y, round(base * pct, 2, "HALF_UP"));
}
pub relation dividends_received_805a4_limited(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 243/245 deductions after the aggregate limit";
}
rule Section805a4BAboveLimit(c: Person, y: TaxableYear, total: Money, limit: Money) defeasible {
    label en official "section 805(a)(4)(B): the deductions are capped at the limit";
    when dividends_received_before_limit_805a4A(c, y, total);
    when aggregate_dividend_limit_805a4B(c, y, limit);
    when total > limit;
    when not_known(loss_from_operations_805a4B(c, y));
    then dividends_received_805a4_limited(c, y, limit);
}
rule Section805a4BWithinLimit(c: Person, y: TaxableYear, total: Money, limit: Money) defeasible {
    label en official "section 805(a)(4)(B): the deductions are within the limit";
    when dividends_received_before_limit_805a4A(c, y, total);
    when aggregate_dividend_limit_805a4B(c, y, limit);
    when total <= limit;
    then dividends_received_805a4_limited(c, y, total);
}
@source(IRC_S805_A, quote = "but such limit shall not apply for any taxable year for which there is a loss from operations.")
rule Section805a4BLossFromOperations(c: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 805(a)(4)(B): the limit does not apply for a year with a loss from operations";
    when dividends_received_before_limit_805a4A(c, y, total);
    when loss_from_operations_805a4B(c, y);
    then dividends_received_805a4_limited(c, y, total);
}
rule Section805a4BNoLimitInputs(c: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 805(a)(4)(B): with no limit inputs supplied the limit is not tested (it is not thereby zero)";
    when dividends_received_before_limit_805a4A(c, y, total);
    when not_known(aggregate_dividend_limit_stated_805a4B(c, y));
    when not_known(loss_from_operations_805a4B(c, y));
    then dividends_received_805a4_limited(c, y, total);
}
pub relation aggregate_dividend_limit_stated_805a4B(c: Person, y: TaxableYear) kind institutional {
    label en official "a section 246(b) limit is derived for the year (helper)";
}
rule Section805a4BLimitStated(c: Person, y: TaxableYear, limit: Money) defeasible {
    label en official "helper";
    when aggregate_dividend_limit_805a4B(c, y, limit);
    then aggregate_dividend_limit_stated_805a4B(c, y);
}
rule Section805a4BeforeProrationFromItems(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 805(a)(4): the itemised, limited deduction is the base for the (D) proration reduction";
    when dividends_received_805a4_limited(c, y, amount);
    then dividends_received_805a4_before_proration(c, y, amount);
}

// ---- Section 805(a)(4)(D)(iii)-(iv): the portion attributable to prorated amounts ----

pub relation dividend_from_life_company_805a4D(item: us.irc.core::Payment, paying: Person, y_paying: TaxableYear, receiving: Person, y_receiving: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a 100 percent dividend paid to the receiving life insurance company out of the earnings and profits of the paying life insurance company for a taxable year beginning after December 31, 1983";
}
pub relation earnings_attributable_to_prorated_amounts_805a4Div(paying: Person, y_paying: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the paying corporation's earnings and profits for taxable years beginning after December 31, 1983 attributable to prorated amounts (tax-exempt interest, the increase in policy cash values, dividends other than 100 percent dividends), without any reduction for the tax imposed by chapter 1";
}
@source(IRC_S805_A, quote = "any dividend by the paying corporation shall be treated as paid first out of earnings and profits for taxable years beginning after December 31, 1983, attributable to prorated amounts (to the extent thereof)")
rule Section805a4DivPortionAttributableToProratedAmounts(item: us.irc.core::Payment, paying: Person, y_paying: TaxableYear, receiving: Person, y_receiving: TaxableYear, dividend: Money, prorated_earnings: Money) strict {
    label en official "section 805(a)(4)(D)(iv): the dividend is paid first out of the earnings attributable to prorated amounts, to the extent thereof (earnings before any reduction for tax)";
    when dividend_from_life_company_805a4D(item, paying, y_paying, receiving, y_receiving, dividend);
    when earnings_attributable_to_prorated_amounts_805a4Div(paying, y_paying, prorated_earnings);
    then portion_of_dividend_attributable_to_prorated_amounts(receiving, y_receiving, min(dividend, prorated_earnings));
}

// ---- Section 805(b): the modifications of the (a)(8) other deductions ----

pub enum OtherDeductionKind805 {
    OdInterestSection163;
    OdCharitableSection170;
    OdAmortizableBondPremiumSection171;
    OdDividendsReceivedSection243Or245;
    OdPolicyholderDividend;
    OdOtherDeduction;
    label en unofficial "the kind of an item of the other deductions allowed under the subtitle for computing taxable income";
}
@source(IRC_S805_A, quote = "Subject to the modifications provided by subsection (b), all other deductions allowed under this subtitle for purposes of computing taxable income.")
pub relation other_deduction_item_805(c: Person, y: TaxableYear, item: us.irc.core::Payment, kind: OtherDeductionKind805, amount: Money) kind empirical {
    label en unofficial "an item of the deductions otherwise allowed under the subtitle, with its kind and amount before the section 805(b) modifications";
}
@source(IRC_S805_B, quote = "In applying section 163 (relating to deduction for interest), no deduction shall be allowed for interest in respect of items described in section 807(c).")
pub relation interest_in_respect_of_807c_item_805b1(item: us.irc.core::Payment) kind empirical {
    label en unofficial "the interest is in respect of items described in section 807(c)";
}
pub relation allowed_other_deduction_805b(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "an item of the other deductions after the section 805(b) modifications (charitable contributions are limited in the aggregate, below)";
}
@source(IRC_S805_A, quote = "Subject to the modifications provided by subsection (b), all other deductions allowed under this subtitle for purposes of computing taxable income.")
rule Section805a8OtherDeductionAllowed(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "section 805(a)(8): an other deduction that no modification touches";
    when other_deduction_item_805(c, y, item, OdOtherDeduction, amount);
    then allowed_other_deduction_805b(c, y, item, amount);
}
@source(IRC_S805_B, quote = "In applying section 163 (relating to deduction for interest), no deduction shall be allowed for interest in respect of items described in section 807(c).")
rule Section805b1InterestAllowedUnlessOnReserveItems(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) defeasible {
    label en official "section 805(b)(1): interest is allowed except interest in respect of section 807(c) items";
    when other_deduction_item_805(c, y, item, OdInterestSection163, amount);
    when not_known(interest_in_respect_of_807c_item_805b1(item));
    then allowed_other_deduction_805b(c, y, item, amount);
}
// (b)(3): section 171 shall not apply; (b)(4): sections 243 and 245 not allowed
// here; (a)(8) closing sentence: no policyholder dividend deduction outside
// (a)(3). The kinds OdAmortizableBondPremiumSection171, OdDividendsReceived-
// Section243Or245 and OdPolicyholderDividend have no allowing rule ON PURPOSE.
pub relation charitable_contributions_total_805b2(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the section 170 charitable deductions before the section 805(b)(2) limit (a sum over derived-free empirical items)";
}
rule Section805b2CharitableTotal(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) strict {
    label en official "section 805(b)(2): the charitable deductions otherwise allowed";
    when other_deduction_item_805(c, y, anchor, OdCharitableSection170, anchor_amount);
    then charitable_contributions_total_805b2(c, y, sum all amount: Money for item: us.irc.core::Payment where other_deduction_item_805(c, y, item, OdCharitableSection170, amount));
}
@source(IRC_S805_B, quote = "the limit on the total deductions under such section provided by section 170(b)(2) shall be 10 percent of the life insurance company taxable income computed without regard to")
pub relation licti_before_charity_805b2A(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the life insurance company taxable income computed without regard to the section 170 deduction, the deductions of paragraphs (3) and (4) of subsection (a), any net operating loss carryback under section 172 and any capital loss carryback under section 1212(a)(1) (asserted: the taxable income itself depends on the deduction)";
}
pub relation charitable_contributions_allowed_805b2A(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the charitable deductions after the 10 percent limit";
}
@source(IRC_S805_B, quote = "the limit on the total deductions under such section provided by section 170(b)(2) shall be 10 percent of the life insurance company taxable income")
rule Section805b2ACharitableLimit(c: Person, y: TaxableYear, total: Money, base: Money) strict {
    label en official "section 805(b)(2)(A): the total charitable deductions do not exceed 10 percent of the taxable income computed without the excluded items (cents HALF_UP is a JUDGMENT CALL)";
    when charitable_contributions_total_805b2(c, y, total);
    when licti_before_charity_805b2A(c, y, base);
    then charitable_contributions_allowed_805b2A(c, y, min(total, round(base * 10 percent, 2, "HALF_UP")));
}
pub relation other_deductions_after_modifications_805b(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the other deductions of section 805(a)(8) after the modifications of subsection (b) (a sum over derived items, TECH-GAPS G4903)";
}
rule Section805bOtherDeductionsWithCharity(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money, charity: Money) defeasible {
    label en official "section 805(a)(8) with (b): the allowed items plus the limited charitable deductions";
    when allowed_other_deduction_805b(c, y, anchor, anchor_amount);
    when charitable_contributions_allowed_805b2A(c, y, charity);
    then other_deductions_after_modifications_805b(c, y, charity + sum all amount: Money for item: us.irc.core::Payment where allowed_other_deduction_805b(c, y, item, amount));
}
pub relation has_charitable_deduction_805b2(c: Person, y: TaxableYear) kind institutional {
    label en official "a charitable deduction item exists for the company and year (helper)";
}
rule Section805bHasCharity(c: Person, y: TaxableYear, item: us.irc.core::Payment, amount: Money) strict {
    label en official "helper";
    when other_deduction_item_805(c, y, item, OdCharitableSection170, amount);
    then has_charitable_deduction_805b2(c, y);
}
rule Section805bOtherDeductionsWithoutCharity(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) defeasible {
    label en official "section 805(a)(8) with (b): with no charitable deduction the allowed items are the deductions";
    when allowed_other_deduction_805b(c, y, anchor, anchor_amount);
    when not_known(has_charitable_deduction_805b2(c, y));
    then other_deductions_after_modifications_805b(c, y, sum all amount: Money for item: us.irc.core::Payment where allowed_other_deduction_805b(c, y, item, amount));
}
rule Section805a8FromItems(c: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "section 805(a)(8): the modified other deductions";
    when other_deductions_after_modifications_805b(c, y, amount);
    then other_deductions_805a8(c, y, amount);
}
