// Sections 851, 853, 853A, 855 stage 3b (IRC-09 stage 3b, TECH_GAP
// reduction), 26.09.2026. Status implemented_unverified; nothing here was
// executed.
//
// METHOD.
//   * 851(c)(3)(A)-(B): the controlled group is derived over a candidate
//     chain the case names: each candidate other than the taxpayer must have
//     20 percent or more of its voting power owned directly by one or more of
//     the other candidates and the taxpayer (a sum over owners), and the
//     taxpayer must own 20 percent or more of at least one of them. The
//     candidates themselves ("connected through stock ownership") are a case
//     classification (G2202 narrowed: the aggregation is derived, the chain
//     is not built).
//   * 851(c)(5): outstanding voting securities include the equity securities
//     of a qualified publicly traded partnership.
//   * 851(d)(2)(C)(ii): the period for the net income of the scheduled assets,
//     by the candidates-plus-no-earlier-candidate pattern.
//   * 851(e)(2)-(3): the 25 percent limitation on the venture capital
//     exception and the status presumptions (10 years from the first
//     acquisition; furnishing capital within 10 years). The SEC's
//     certification of (e)(1) is external and not represented.
//   * 853(b)(2)(B), 853A(b)(1)(D), 853A(e)(2), 855(c): foreign source
//     treatment of the pass-through amounts, the dates of the deemed credit
//     distribution, the instruments evidencing separated credits, and the
//     year of a section 855 distribution for shareholders.
// Sums over derived items follow G4903.

// ---- Section 851(c)(3): the controlled group ----

use self::{
    Corporation,
    IRC_S851_C,
    IRC_S851_D,
    IRC_S851_E,
    IRC_S853A_B,
    IRC_S853A_E,
    IRC_S853_B,
    IRC_S855_C,
    Person,
    TaxableYear,
    controlled_group_member_851c3,
    controls_851c2,
    credit_amount_treated_as_ric_distribution_853Ab1D,
    qualified_publicly_traded_partnership_851h,
    shareholder_proportionate_share_of_foreign_taxes_853b2,
    total_assets_value_at_quarter_end_851d2B,
    voting_power_percent_owned_851c,
};

pub relation chain_candidate_851c3(taxpayer: Corporation, corp: Corporation) kind empirical {
    label en unofficial "the corporation is connected through stock ownership with the taxpayer in a chain (the case names the candidates)";
}
pub relation group_owner_percent_851c3A(taxpayer: Corporation, member: Corporation, owner: Corporation, pct: Decimal) kind institutional {
    label en official "the percentage of the member's voting power owned directly by one of the other corporations (a candidate or the taxpayer)";
}
rule Section851c3AOwnerIsCandidate(taxpayer: Corporation, member: Corporation, owner: Corporation, pct: Decimal) strict {
    label en official "section 851(c)(3)(A): ownership by another candidate corporation";
    when chain_candidate_851c3(taxpayer, member);
    when chain_candidate_851c3(taxpayer, owner);
    when voting_power_percent_owned_851c(owner, member, pct);
    then group_owner_percent_851c3A(taxpayer, member, owner, pct);
}
rule Section851c3AOwnerIsTaxpayer(taxpayer: Corporation, member: Corporation, pct: Decimal) strict {
    label en official "section 851(c)(3)(A): ownership by the taxpayer";
    when chain_candidate_851c3(taxpayer, member);
    when voting_power_percent_owned_851c(taxpayer, member, pct);
    then group_owner_percent_851c3A(taxpayer, member, taxpayer, pct);
}
pub relation group_owned_percent_851c3A(taxpayer: Corporation, member: Corporation, pct: Decimal) kind institutional {
    label en official "the percentage of the member's voting power owned directly by one or more of the other corporations";
}
@source(IRC_S851_C, quote = "(A) 20 percent or more of the total combined voting power of all classes of stock entitled to vote of")
rule Section851c3ASumOfOwners(taxpayer: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(A): the percentages owned directly by the other corporations add (a sum over owners: G4903)";
    when group_owner_percent_851c3A(taxpayer, member, _, _);
    then group_owned_percent_851c3A(taxpayer, member, sum all pct: Decimal for owner: Corporation where group_owner_percent_851c3A(taxpayer, member, owner, pct));
}
pub relation member_meets_20_percent_851c3A(taxpayer: Corporation, member: Corporation) kind institutional {
    label en official "20 percent or more of the member's voting power is owned directly by one or more of the other corporations";
}
rule Section851c3AMemberMeetsTwentyPercent(taxpayer: Corporation, member: Corporation, pct: Decimal) strict {
    label en official "section 851(c)(3)(A): 20 percent or more";
    when group_owned_percent_851c3A(taxpayer, member, pct);
    when pct >= 20.0;
    then member_meets_20_percent_851c3A(taxpayer, member);
}
pub relation some_candidate_fails_851c3A(taxpayer: Corporation) kind institutional {
    label en official "a candidate other than the taxpayer does not meet clause (A)";
}
rule Section851c3ASomeCandidateFails(taxpayer: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(A): each of the corporations (except the taxpayer) must meet the 20 percent test";
    when chain_candidate_851c3(taxpayer, member);
    when not_known(member_meets_20_percent_851c3A(taxpayer, member));
    then some_candidate_fails_851c3A(taxpayer);
}
pub relation taxpayer_controls_a_candidate_851c3B(taxpayer: Corporation) kind institutional {
    label en official "the taxpayer owns directly 20 percent or more of the voting power of at least one of the other corporations";
}
@source(IRC_S851_C, quote = "(A) 20 percent or more of the total combined voting power of all classes of stock entitled to vote of each of the corporations (except the taxpayer) is owned directly by one or more of the other corporations, and")
rule Section851c3BTaxpayerControlsOne(taxpayer: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3)(B): the taxpayer controls at least one candidate";
    when chain_candidate_851c3(taxpayer, member);
    when controls_851c2(taxpayer, member);
    then taxpayer_controls_a_candidate_851c3B(taxpayer);
}
rule Section851c3ControlledGroupByAggregation(taxpayer: Corporation, member: Corporation) strict {
    label en official "section 851(c)(3): a candidate in a chain where every other candidate meets (A) and the taxpayer meets (B)";
    when chain_candidate_851c3(taxpayer, member);
    when member_meets_20_percent_851c3A(taxpayer, member);
    when taxpayer_controls_a_candidate_851c3B(taxpayer);
    when not_known(some_candidate_fails_851c3A(taxpayer));
    then controlled_group_member_851c3(taxpayer, member);
}

// ---- Section 851(c)(5): outstanding voting securities and a qualified publicly traded partnership ----

pub relation issuer_outstanding_voting_securities_value_851c5(issuer: Person, amount: Money) kind empirical {
    label en unofficial "the value of the outstanding voting securities of the issuer";
}
pub relation qptp_equity_securities_value_851c5(issuer: Person, amount: Money) kind empirical {
    label en unofficial "the value of the equity securities of the issuer, a publicly traded partnership";
}
pub relation outstanding_voting_securities_including_qptp_851c5(issuer: Person, amount: Money) kind institutional {
    label en official "the value of the outstanding voting securities of the issuer, including the equity securities of a qualified publicly traded partnership";
}
@source(IRC_S851_C, quote = "shall include the equity securities of a qualified publicly traded partnership (as defined in subsection")
rule Section851c5IncludesQptpEquity(issuer: Person, voting: Money, equity: Money) defeasible {
    label en official "section 851(c)(5): the outstanding voting securities include the equity securities of a qualified publicly traded partnership";
    when issuer_outstanding_voting_securities_value_851c5(issuer, voting);
    when qptp_equity_securities_value_851c5(issuer, equity);
    when qualified_publicly_traded_partnership_851h(issuer);
    then outstanding_voting_securities_including_qptp_851c5(issuer, voting + equity);
}
rule Section851c5OrdinaryIssuer(issuer: Person, voting: Money) defeasible {
    label en official "section 851(c)(5): an issuer that is not a qualified publicly traded partnership has its voting securities only";
    when issuer_outstanding_voting_securities_value_851c5(issuer, voting);
    when not_known(qualified_publicly_traded_partnership_851h(issuer));
    then outstanding_voting_securities_including_qptp_851c5(issuer, voting);
}

// ---- Section 851(d)(2)(C)(ii): the net income period ----

pub relation first_failure_date_of_scheduled_assets_851d2Cii(c: Person, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the first date on which the failure to satisfy subsection (b)(3) occurs as a result of the ownership of the scheduled assets";
}
pub relation scheduled_assets_disposed_on_851d2Cii(c: Person, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the date the corporation disposes of the scheduled assets";
}
pub relation end_of_first_quarter_without_failure_851d2Cii(c: Person, q: us.irc.core::Period, on: Date) kind empirical {
    label en unofficial "the end of the first quarter when there is no longer a failure to satisfy subsection (b)(3)";
}
pub relation net_income_period_end_candidate_851d2Cii(c: Person, q: us.irc.core::Period, on: Date) kind institutional {
    label en official "a date at which the net income period may end (helper for the earlier-of rule)";
}
rule Section851d2CiiCandidateDisposal(c: Person, q: us.irc.core::Period, on: Date) strict {
    label en official "helper: the disposal date is a candidate end";
    when scheduled_assets_disposed_on_851d2Cii(c, q, on);
    then net_income_period_end_candidate_851d2Cii(c, q, on);
}
rule Section851d2CiiCandidateQuarterEnd(c: Person, q: us.irc.core::Period, on: Date) strict {
    label en official "helper: the end of the first failure-free quarter is a candidate end";
    when end_of_first_quarter_without_failure_851d2Cii(c, q, on);
    then net_income_period_end_candidate_851d2Cii(c, q, on);
}
pub relation earlier_net_income_period_end_candidate_exists_851d2Cii(c: Person, q: us.irc.core::Period, on: Date) kind institutional {
    label en official "a strictly earlier candidate end date exists (helper)";
}
rule Section851d2CiiEarlierCandidate(c: Person, q: us.irc.core::Period, on: Date, other: Date) strict {
    label en official "helper: a candidate end strictly earlier than the given one exists";
    when net_income_period_end_candidate_851d2Cii(c, q, on);
    when net_income_period_end_candidate_851d2Cii(c, q, other);
    when other < on;
    then earlier_net_income_period_end_candidate_exists_851d2Cii(c, q, on);
}
pub relation net_income_period_851d2Cii(c: Person, q: us.irc.core::Period, start: Date, end: Date) kind institutional {
    label en official "the period for the net income generated by the scheduled assets: from the first failure date to the earlier of the disposal and the end of the first failure-free quarter";
}
@source(IRC_S851_D, quote = "For purposes of clause (i)(II), the period described in this clause is the period beginning on the first")
rule Section851d2CiiPeriod(c: Person, q: us.irc.core::Period, start: Date, end: Date) strict {
    label en official "section 851(d)(2)(C)(ii): the period begins on the first failure date and ends on the earlier of the disposal date and the end of the first quarter without a failure";
    when first_failure_date_of_scheduled_assets_851d2Cii(c, q, start);
    when net_income_period_end_candidate_851d2Cii(c, q, end);
    when not_known(earlier_net_income_period_end_candidate_exists_851d2Cii(c, q, end));
    when end >= start;
    then net_income_period_851d2Cii(c, q, start, end);
}

// ---- Section 851(e)(2)-(4): the venture capital exception ----

pub relation holds_more_than_10_percent_of_voting_securities_851e2(c: Person, issuer: Person) kind empirical {
    label en unofficial "the investment company holds more than 10 percent of the outstanding voting securities of the issuer";
}
pub relation held_a_security_of_issuer_continuously_10_years_851e2(c: Person, q: us.irc.core::Period, issuer: Person) kind empirical {
    label en unofficial "the company (or a predecessor of the issuer) has continuously held any security of the issuer for 10 or more years preceding the quarter";
}
pub relation issuer_securities_value_at_quarter_close_851e2(c: Person, q: us.irc.core::Period, issuer: Person, amount: Money) kind empirical {
    label en unofficial "the value of the securities of the issuer held at the close of the quarter";
}
pub relation restricted_issuer_value_851e2(c: Person, q: us.irc.core::Period, issuer: Person, amount: Money) kind institutional {
    label en official "the securities of an issuer in which the company holds more than 10 percent of the voting securities and has held a security continuously for 10 years";
}
rule Section851e2RestrictedIssuer(c: Person, q: us.irc.core::Period, issuer: Person, amount: Money) strict {
    label en official "section 851(e)(2): issuers of which the company holds over 10 percent of the voting securities and a security for 10 or more years";
    when issuer_securities_value_at_quarter_close_851e2(c, q, issuer, amount);
    when holds_more_than_10_percent_of_voting_securities_851e2(c, issuer);
    when held_a_security_of_issuer_continuously_10_years_851e2(c, q, issuer);
    then restricted_issuer_value_851e2(c, q, issuer, amount);
}
pub relation restricted_issuers_total_851e2(c: Person, q: us.irc.core::Period, amount: Money) kind institutional {
    label en official "the total value of the securities of the restricted issuers at the close of the quarter";
}
rule Section851e2RestrictedTotal(c: Person, q: us.irc.core::Period) strict {
    label en official "section 851(e)(2): the sum over the restricted issuers";
    when restricted_issuer_value_851e2(c, q, _, _);
    then restricted_issuers_total_851e2(c, q, sum all amount: Money for issuer: Person where restricted_issuer_value_851e2(c, q, issuer, amount));
}
pub relation reduced_to_25_percent_or_less_within_30_days_851e2(c: Person, q: us.irc.core::Period) kind empirical {
    label en unofficial "the value of the total assets so represented is reduced to 25 percent or less within 30 days after the close of the quarter";
}
pub relation venture_capital_exception_unavailable_851e2(c: Person, q: us.irc.core::Period) kind institutional {
    label en official "the subsection does not apply at the close of the quarter: more than 25 percent of total assets is in restricted issuers and is not reduced within 30 days";
}
@source(IRC_S851_E, quote = "The provisions of this subsection shall not apply at the close of any quarter of a taxable year to an")
rule Section851e2LimitationOnTheException(c: Person, q: us.irc.core::Period, restricted: Money, total: Money) strict {
    label en official "section 851(e)(2): more than 25 percent of total assets in restricted issuers, unless reduced to 25 percent or less within 30 days";
    when restricted_issuers_total_851e2(c, q, restricted);
    when total_assets_value_at_quarter_end_851d2B(c, q, total);
    when restricted * 100.0 > total * 25.0;
    when not_known(reduced_to_25_percent_or_less_within_30_days_851e2(c, q));
    then venture_capital_exception_unavailable_851e2(c, q);
}
pub relation first_acquisition_of_issuer_security_851e3(c: Person, issuer: Person, on: Date) kind empirical {
    label en unofficial "the date of the first acquisition of any security in the issuer (or a predecessor) by the company";
}
pub relation issuer_principally_engaged_at_first_acquisition_851e3(c: Person, issuer: Person) kind empirical {
    label en unofficial "at the date of the first acquisition the issuer or its predecessor was principally engaged in the development or exploitation of inventions, technological improvements, new processes, or products not previously generally available";
}
pub relation sec_determines_status_otherwise_851e3(issuer: Person) kind empirical {
    label en unofficial "the Securities and Exchange Commission determines otherwise";
}
pub relation date_under_review_851e3(c: Person, on: Date) kind empirical {
    label en unofficial "a date at which the status of the issuer is examined";
}
pub relation issuer_considered_principally_engaged_851e3(c: Person, issuer: Person, on: Date) kind institutional {
    label en official "the corporation is considered principally engaged in the development or exploitation on this date: within 10 years after the first acquisition, absent a contrary SEC determination";
}
@source(IRC_S851_E, quote = "For purposes of this subsection, unless the Securities and Exchange Commission determines otherwise, a")
rule Section851e3PrincipallyEngagedTenYears(c: Person, issuer: Person, first: Date, on: Date) strict {
    label en official "section 851(e)(3): for at least 10 years after the first acquisition, if the issuer was then so engaged, unless the Commission determines otherwise";
    when first_acquisition_of_issuer_security_851e3(c, issuer, first);
    when issuer_principally_engaged_at_first_acquisition_851e3(c, issuer);
    when date_under_review_851e3(c, on);
    when on >= first;
    when on <= add_calendar_period(first, 120 calendar_month);
    when not_known(sec_determines_status_otherwise_851e3(issuer));
    then issuer_considered_principally_engaged_851e3(c, issuer, on);
}
pub relation acquired_security_from_issuer_851e3(c: Person, issuer: Person, on: Date) kind empirical {
    label en unofficial "the company acquired a security of the issuer, or a security surrendered in exchange, from the issuer or a predecessor on this date";
}
pub relation company_considered_furnishing_capital_851e3(c: Person, issuer: Person, on: Date) kind institutional {
    label en official "the company is considered at the date to be furnishing capital to the issuer: it acquired securities from it within the preceding 10 years";
}
rule Section851e3FurnishingCapital(c: Person, issuer: Person, acquired: Date, on: Date) strict {
    label en official "section 851(e)(3): furnishing capital if within 10 years before the date it acquired securities from the company";
    when acquired_security_from_issuer_851e3(c, issuer, acquired);
    when date_under_review_851e3(c, on);
    when on >= acquired;
    when on <= add_calendar_period(acquired, 120 calendar_month);
    then company_considered_furnishing_capital_851e3(c, issuer, on);
}
@source(IRC_S851_E, quote = "The terms used in this subsection shall have the same meaning as in subsections (b)(3) and (c) of this")
pub relation venture_capital_terms_as_in_851b3_851c_851e4(c: Person) kind institutional {
    label en official "the terms of the subsection have the meaning of subsections (b)(3) and (c): the value of section 851(c)(4) and the controls and controlled group definitions apply (recorded, no independent operative content)";
}
rule Section851e4TermsAsInB3AndC(c: Person, q: us.irc.core::Period, restricted: Money) strict {
    label en official "section 851(e)(4): the same meaning as in subsections (b)(3) and (c)";
    when restricted_issuers_total_851e2(c, q, restricted);
    then venture_capital_terms_as_in_851b3_851c_851e4(c);
}

// ---- Section 853(b)(2)(B), 853A(b)(1)(D), 853A(e)(2), 855(c) ----

pub relation dividend_portion_from_foreign_sources_853b2B(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the dividend paid by the company which represents income derived from sources within foreign countries or possessions of the United States";
}
pub relation shareholder_foreign_source_gross_income_853b2B(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "gross income from sources within foreign countries and possessions of the United States for the foreign tax credit: the proportionate share of the taxes and the foreign-source part of the dividend";
}
@source(IRC_S853_B, quote = "(B) treat as gross income from sources within the respective foreign countries and possessions of the")
rule Section853b2BForeignSourceGrossIncome(sh: Person, c: Person, y: TaxableYear, taxes: Money, dividend_part: Money) strict {
    label en official "section 853(b)(2)(B): the shareholder treats his share of the taxes and the foreign-source part of the dividend as foreign-source gross income (the sourcing itself is asserted: G5313 pending us.irc.international)";
    when shareholder_proportionate_share_of_foreign_taxes_853b2(sh, c, y, taxes);
    when dividend_portion_from_foreign_sources_853b2B(sh, c, y, dividend_part);
    then shareholder_foreign_source_gross_income_853b2B(sh, c, y, taxes + dividend_part);
}
pub relation credit_applicable_date_853Ab1D(c: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the applicable date of the credit";
}
pub relation distribution_date_selected_853Ab1D(c: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date selected by the company for the deemed distribution";
}
pub relation deemed_distribution_pursuant_to_855_853Ab1D(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the selected date follows the close of the taxable year pursuant to section 855";
}
pub relation credit_distribution_dated_853Ab1D(c: Person, y: TaxableYear, on: Date, amount: Money) kind institutional {
    label en official "the company is treated as making a distribution of money equal to the credits on the selected date";
}
@source(IRC_S853A_B, quote = "(D) shall be treated as making one or more distributions of money with respect to its stock equal to the")
rule Section853Ab1DDeemedDistributionInYear(c: Person, y: TaxableYear, applicable: Date, selected: Date, ends_on: Date, credits: Money) strict {
    label en official "section 853A(b)(1)(D): the deemed distribution of the credits on a date, on or after the applicable date, during the taxable year";
    when credit_amount_treated_as_ric_distribution_853Ab1D(c, y, credits);
    when credit_applicable_date_853Ab1D(c, y, applicable);
    when distribution_date_selected_853Ab1D(c, y, selected);
    when us.irc.core::ends(y, ends_on);
    when selected >= applicable;
    when selected <= ends_on;
    then credit_distribution_dated_853Ab1D(c, y, selected, credits);
}
rule Section853Ab1DDeemedDistributionAfterClose(c: Person, y: TaxableYear, applicable: Date, selected: Date, ends_on: Date, credits: Money) strict {
    label en official "section 853A(b)(1)(D): or following the close of the taxable year pursuant to section 855";
    when credit_amount_treated_as_ric_distribution_853Ab1D(c, y, credits);
    when credit_applicable_date_853Ab1D(c, y, applicable);
    when distribution_date_selected_853Ab1D(c, y, selected);
    when us.irc.core::ends(y, ends_on);
    when deemed_distribution_pursuant_to_855_853Ab1D(c, y);
    when selected > ends_on;
    then credit_distribution_dated_853Ab1D(c, y, selected, credits);
}
pub relation tax_credit_bond_credit_separated_853Ae2(bond: us.irc.core::Asset) kind empirical {
    label en unofficial "the ownership of the tax credit bond is separated from the credit with respect to the bond";
}
pub relation instrument_evidencing_credit_853Ae2(bond: us.irc.core::Asset, instrument: us.irc.core::Asset) kind empirical {
    label en unofficial "the instrument evidences the entitlement to the credit";
}
pub relation subsection_a_applied_to_credit_instrument_853Ae2(bond: us.irc.core::Asset, instrument: us.irc.core::Asset) kind institutional {
    label en official "subsection (a) is applied by reference to the instrument evidencing the entitlement to the credit rather than the bond";
}
@source(IRC_S853A_E, quote = "If the ownership of a tax credit bond is separated from the credit with respect to such bond, subsection")
rule Section853Ae2SeparatedCreditInstrument(bond: us.irc.core::Asset, instrument: us.irc.core::Asset) strict {
    label en official "section 853A(e)(2): when ownership of the bond is separated from its credit, subsection (a) applies to the credit instruments";
    when tax_credit_bond_credit_separated_853Ae2(bond);
    when instrument_evidencing_credit_853Ae2(bond, instrument);
    then subsection_a_applied_to_credit_instrument_853Ae2(bond, instrument);
}
pub relation section_853_amount_allocable_to_distribution_855c(sh: Person, c: Person, dist: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount described in section 853(b)(2) allocable to the section 855 distribution";
}
pub relation section_855_distribution_made_in_year_855c(c: Person, dist: us.irc.core::Payment, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which the distribution is made";
}
pub relation section_853_applicable_for_year_855c(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 853 is applicable to the company for the taxable year";
}
pub relation shareholder_853b2_amount_year_of_distribution_855c(sh: Person, c: Person, dist: us.irc.core::Payment, y: TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder considers the section 853(b)(2) amount as paid or received in the taxable year in which the distribution is made";
}
@source(IRC_S855_C, quote = "If an investment company to which section 853 is applicable for the taxable year makes a distribution as")
rule Section855cShareholdersYearOfDistribution(sh: Person, c: Person, dist: us.irc.core::Payment, y: TaxableYear, amount: Money, distribution_year: TaxableYear) strict {
    label en official "section 855(c): the shareholders consider the section 853(b)(2) amounts allocable to a section 855 distribution as paid or received in the year in which the distribution is made";
    when section_853_applicable_for_year_855c(c, y);
    when section_855_distribution_made_in_year_855c(c, dist, distribution_year);
    when section_853_amount_allocable_to_distribution_855c(sh, c, dist, amount);
    then shareholder_853b2_amount_year_of_distribution_855c(sh, c, dist, distribution_year, amount);
}
