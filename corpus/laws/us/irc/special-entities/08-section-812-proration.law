// Section 812 (definition of company's share and policyholder's share) and
// the section 805(a)(4)(D) proration reduction it feeds. Stage 2b (IRC-09
// stage 2b, A12).
//
// METHOD: since the amendment by Pub. L. 115-97 §13518(b) (Tax Cuts and
// Jobs Act, 2017), section 812(a)-(b)'s formerly company-specific,
// multi-factor "company's share"/"policyholder's share" computation (which
// compared a company's own required interest rate to the average earnings
// rate industry-wide) was REPLACED, for taxable years beginning after
// December 31, 2017, by two FLAT statutory percentages: company's share is
// 70 percent and policyholder's share is 30 percent, for every life
// insurance company alike. The pinned 2024 edition text of section 812
// contains only this flat-percentage rule (no formula subsections remain)
// — this package therefore models exactly what is pinned, as two A3
// `.lawparam.json` constants (`CompanysShare70Percent`,
// `PolicyholdersShare30Percent`), not a fork of a repealed computation.
//
// CONSEQUENCE (an honest finding, not a simplification chosen by this
// package): because BOTH the paying and the receiving life insurance
// company have the SAME flat 70 percent company's share for any taxable
// year beginning after December 31, 2017, section 805(a)(4)(D)(ii)'s
// reduction percentage — "the share described in subclause (II) of clause
// (i) from the share described in subclause (I) of such clause" (paying
// company's share minus receiving company's share) — is ALWAYS ZERO under
// current law for both companies' current-era taxable years. The general
// subtraction is still modeled below (so a case testing a taxable year
// beginning before 2018, where this package has no `.lawparam.json` row
// and so no share values, correctly gets NEITHER rather than an invented
// pre-2018 percentage), but under the flat post-2017 rule the (D) reduction
// will compute to $0.00 whenever both companies' 812 shares are pinned to
// the same era.

use self::{
    IRC_S805_A,
    IRC_S812_A,
    IRC_S812_B,
    Person,
    TaxableYear,
    dividends_received_805a4_proration_reduction,
    life_insurance_company,
};

@source(IRC_S812_A, quote = "For purposes of section 805(a)(4), the term \"company's share\" means, with respect to any taxable year beginning after December 31, 2017, 70 percent.")
pub relation companys_share_812a(c: Person, y: TaxableYear, share: Decimal) kind institutional {
    label en official "section 812(a): the company's share for purposes of section 805(a)(4), for a taxable year beginning after December 31, 2017 — a flat 70 percent for every life insurance company";
}
rule Section812aCompanysShareFlat70Percent(c: Person, y: TaxableYear) strict {
    label en official "section 812(a): the company's share is the flat statutory 70 percent";
    when life_insurance_company(c, y);
    then companys_share_812a(c, y, CompanysShare70Percent);
}

@source(IRC_S812_B, quote = "For purposes of section 807, the term \"policyholder's share\" means, with respect to any taxable year beginning after December 31, 2017, 30 percent.")
pub relation policyholders_share_812b(c: Person, y: TaxableYear, share: Decimal) kind institutional {
    label en official "section 812(b): the policyholder's share for purposes of section 807, for a taxable year beginning after December 31, 2017 — a flat 30 percent for every life insurance company";
}
rule Section812bPolicyholdersShareFlat30Percent(c: Person, y: TaxableYear) strict {
    label en official "section 812(b): the policyholder's share is the flat statutory 30 percent";
    when life_insurance_company(c, y);
    then policyholders_share_812b(c, y, PolicyholdersShare30Percent);
}

// ---- Section 805(a)(4)(D)(i)-(iv): the proration reduction ----

@source(IRC_S805_A, quote = "(I) the paying company's share determined under section 812 for such taxable year, exceeds\n(II) the receiving company's share determined under section 812 for its taxable year in which the dividend is received or accrued,")
pub relation section_805a4d_paying_company_exceeds_receiving(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear) kind institutional {
    label en official "section 805(a)(4)(D)(i): the paying company's section 812 share exceeds the receiving company's section 812 share";
}
rule Section805a4DiPayingExceedsReceiving(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear, paying_share: Decimal, receiving_share: Decimal) strict {
    label en official "section 805(a)(4)(D)(i): the comparison of the two companies' section 812 shares";
    when companys_share_812a(paying, y_paying, paying_share);
    when companys_share_812a(receiving, y_receiving, receiving_share);
    when paying_share > receiving_share;
    then section_805a4d_paying_company_exceeds_receiving(paying, receiving, y_paying, y_receiving);
}
@source(IRC_S805_A, quote = "the portion of such dividend attributable to prorated amounts")
pub relation portion_of_dividend_attributable_to_prorated_amounts(receiving: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the portion of the 100 percent dividend attributable to prorated amounts (tax-exempt interest, the increase in policy cash values, and dividends other than 100 percent dividends), per section 805(a)(4)(D)(iii)-(iv) (the (iv) ordering/without-tax-reduction computation rules for identifying this portion are not separately modeled — asserted directly)";
}
@source(IRC_S805_A, quote = "The reduction under this clause for a dividend is an amount equal to—\n(I) the portion of such dividend attributable to prorated amounts, multiplied by\n(II) the percentage obtained by subtracting the share described in subclause (II) of clause (i) from the share described in subclause (I) of such clause.")
rule Section805a4DiiProrationReductionAmount(paying: Person, receiving: Person, y_paying: TaxableYear, y_receiving: TaxableYear, prorated: Money, paying_share: Decimal, receiving_share: Decimal) strict {
    label en official "section 805(a)(4)(D)(ii): the reduction is the prorated-amounts portion times (paying company's share minus receiving company's share)";
    when section_805a4d_paying_company_exceeds_receiving(paying, receiving, y_paying, y_receiving);
    when portion_of_dividend_attributable_to_prorated_amounts(receiving, y_receiving, prorated);
    when companys_share_812a(paying, y_paying, paying_share);
    when companys_share_812a(receiving, y_receiving, receiving_share);
    then dividends_received_805a4_proration_reduction(receiving, y_receiving, round(prorated * (paying_share - receiving_share), 2, "HALF_UP"));
}
// When the paying company's share does NOT exceed the receiving company's
// (the (D)(i) condition fails — which, per the module header, is the ONLY
// possible outcome once both shares are pinned to the same flat 70 percent
// post-2017 constant), no reduction rule fires here; the module 07 fallback
// rule (`Section805a4NoProration`, guarded by `not_known(has_805a4_
// proration_reduction(...))`) takes over and the base dividends-received
// amount stands unreduced — which is the CORRECT result (the statute's own
// (D)(i) condition is not met, so (D)(ii) never applies), not a gap.
