// Section 852(b)(3)(C)-(E) (regulated investment companies: the capital
// gain dividend definition with the excess reported amount, the
// determination adjustment, the shareholders' treatment of undistributed
// capital gains, and the distributions to which section 897 does not
// apply). Stage 3 (IRC-09 stage 3, TECH_GAP reduction), 26.09.2026. Status
// implemented_unverified; nothing here was executed.
//
// METHOD. A company reports capital gain dividends dividend by dividend;
// the reported amounts are empirical rows (`us.irc.core::Payment`, an
// amount and the payment date). The aggregate reported amount, the excess
// reported amount over the net capital gain, the post-December amount and
// the pro rata allocation of the excess follow (C)(ii)-(iv); a capital gain
// dividend is the reported amount less the excess allocated to it. Sums over
// empirical rows are used (they avoid the section 111 limit); the derived
// capital gain dividends are then summed for the section 852(b)(3)(A) base.
// The calendar-year/noncalendar-year distinction and the December 31 date
// inside the year are asserted (the core cannot take the calendar year of a
// date). The excess is allocated with one rounding, cents HALF_UP (a
// JUDGMENT CALL: the text names none). Subparagraph (D) follows the same
// design as the REIT rules of module 20 (section 857(b)(3)(C)).

use self::{
    IRC_S852_B,
    Person,
    TaxableYear,
    capital_gain_dividend_852,
    capital_gain_dividends_paid_852,
    net_capital_gain_ric,
};

pub relation calendar_taxable_year_852b3C(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year begins and ends in the same calendar year";
}
pub relation noncalendar_taxable_year_852b3C(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year does not begin and end in the same calendar year";
}
pub relation december_31_within_year_852b3Ciii(y: TaxableYear, day: Date) kind empirical {
    label en unofficial "the December 31 that falls within the noncalendar taxable year";
}
@source(IRC_S852_B, quote = "a capital gain dividend is any dividend, or part thereof, which is reported by the company as a capital gain dividend in written statements furnished to its shareholders")
pub relation reported_capital_gain_dividend_852b3C(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid_on: Date) kind empirical {
    label en unofficial "the amount of the dividend reported by the company as a capital gain dividend in written statements to its shareholders, and the date the dividend was paid (dividends paid after the close of the year under section 855 are included)";
}
pub relation aggregate_reported_amount_852b3Civ(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the aggregate reported amount: the aggregate amount of dividends reported as capital gain dividends for the taxable year, including those paid after the close of the year under section 855";
}
@source(IRC_S852_B, quote = "The term \"aggregate reported amount\" means the aggregate amount of dividends reported by the company under clause (i) as capital gain dividends for the taxable year")
rule Section852b3CivIIIAggregateReported(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money, anchor_date: Date) strict {
    label en official "section 852(b)(3)(C)(iv)(III): the sum of the reported amounts";
    when reported_capital_gain_dividend_852b3C(c, y, anchor, anchor_amount, anchor_date);
    then aggregate_reported_amount_852b3Civ(c, y, sum all amount: Money for d: us.irc.core::Payment where reported_capital_gain_dividend_852b3C(c, y, d, amount, _));
}
pub relation excess_reported_amount_852b3Civ(c: Person, y: TaxableYear, excess: Money) kind institutional {
    label en official "the excess reported amount: the aggregate reported amount over the net capital gain of the company for the year";
}
@source(IRC_S852_B, quote = "The term \"excess reported amount\" means the excess of the aggregate reported amount over the net capital gain of the company for the taxable year.")
rule Section852b3CivIIExcessReported(c: Person, y: TaxableYear, aggregate: Money, ncg: Money) strict {
    label en official "section 852(b)(3)(C)(iv)(II): the aggregate reported amount exceeds the net capital gain";
    when aggregate_reported_amount_852b3Civ(c, y, aggregate);
    when net_capital_gain_ric(c, y, ncg);
    when aggregate > ncg;
    then excess_reported_amount_852b3Civ(c, y, aggregate - ncg);
}
pub relation post_december_reported_amount_852b3Civ(c: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the post-December reported amount: the aggregate reported amount taking into account only dividends paid after December 31 of the taxable year";
}
pub relation reported_after_december_852b3Civ(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "a reported capital gain dividend paid after December 31 of the taxable year";
}
rule Section852b3CivIVReportedAfterDecember(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, dec31: Date) strict {
    label en official "section 852(b)(3)(C)(iv)(IV): the dividend was paid after December 31 of the taxable year";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid > dec31;
    then reported_after_december_852b3Civ(c, y, dividend, amount);
}
@source(IRC_S852_B, quote = "The term \"post-December reported amount\" means the aggregate reported amount determined by taking into account only dividends paid after December 31 of the taxable year.")
rule Section852b3CivIVPostDecember(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) strict {
    label en official "section 852(b)(3)(C)(iv)(IV): the sum of the reported amounts paid after December 31";
    when reported_after_december_852b3Civ(c, y, anchor, anchor_amount);
    then post_december_reported_amount_852b3Civ(c, y, sum all amount: Money for d: us.irc.core::Payment where reported_after_december_852b3Civ(c, y, d, amount));
}
pub relation capital_gain_dividend_amount_852b3C(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the part of the dividend that is a capital gain dividend";
}
@source(IRC_S852_B, quote = "Except as provided in clause (ii), a capital gain dividend is any dividend, or part thereof, which is reported by the company as a capital gain dividend in written statements furnished to its shareholders.")
rule Section852b3CiReportedWithinNetCapitalGain(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, aggregate: Money, ncg: Money) strict {
    label en official "section 852(b)(3)(C)(i): the reported dividend is a capital gain dividend in full when the aggregate reported amount does not exceed the net capital gain";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when aggregate_reported_amount_852b3Civ(c, y, aggregate);
    when net_capital_gain_ric(c, y, ncg);
    when aggregate <= ncg;
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount);
}
@source(IRC_S852_B, quote = "(I) In general")
rule Section852b3CiiiICalendarYearAllocation(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, aggregate: Money, excess: Money) strict {
    label en official "section 852(b)(3)(C)(ii), (iii)(I): the reported amount less the excess allocated in the ratio of the reported amount to the aggregate reported amount (one rounding)";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when aggregate_reported_amount_852b3Civ(c, y, aggregate);
    when excess_reported_amount_852b3Civ(c, y, excess);
    when calendar_taxable_year_852b3C(c, y);
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount - div_round(excess * (amount / 1.00 USD), aggregate / 1.00 USD, 2, "HALF_UP"));
}
rule Section852b3CiiiINoncalendarPostDecemberShort(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, aggregate: Money, excess: Money, post_dec: Money) strict {
    label en official "section 852(b)(3)(C)(iii)(I): in a noncalendar year whose post-December reported amount is less than the excess, subclause (I) applies with the aggregate reported amount";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when aggregate_reported_amount_852b3Civ(c, y, aggregate);
    when excess_reported_amount_852b3Civ(c, y, excess);
    when noncalendar_taxable_year_852b3C(c, y);
    when post_december_reported_amount_852b3Civ(c, y, post_dec);
    when post_dec < excess;
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount - div_round(excess * (amount / 1.00 USD), aggregate / 1.00 USD, 2, "HALF_UP"));
}
rule Section852b3CiiiINoncalendarNoPostDecemberDividends(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, aggregate: Money, excess: Money) strict {
    label en official "section 852(b)(3)(C)(iii)(I): a noncalendar year with no dividends paid after December 31 has a post-December reported amount of zero, below the excess";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when aggregate_reported_amount_852b3Civ(c, y, aggregate);
    when excess_reported_amount_852b3Civ(c, y, excess);
    when noncalendar_taxable_year_852b3C(c, y);
    when no_post_december_dividends_852b3Civ(c, y);
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount - div_round(excess * (amount / 1.00 USD), aggregate / 1.00 USD, 2, "HALF_UP"));
}
pub relation no_post_december_dividends_852b3Civ(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "no reported capital gain dividend was paid after December 31 of the noncalendar taxable year (the post-December reported amount is zero)";
}
@source(IRC_S852_B, quote = "if the post-December reported amount equals or exceeds the excess reported amount for such taxable year, subclause (I) shall be applied by substituting \"post-December reported amount\" for \"aggregate reported amount\" and no excess reported amount shall be allocated to any dividend paid on or before December 31 of such taxable year")
rule Section852b3CiiiIIEarlyDividendsBearNoExcess(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, excess: Money, post_dec: Money, dec31: Date) strict {
    label en official "section 852(b)(3)(C)(iii)(II): no excess reported amount is allocated to a dividend paid on or before December 31";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when excess_reported_amount_852b3Civ(c, y, excess);
    when noncalendar_taxable_year_852b3C(c, y);
    when post_december_reported_amount_852b3Civ(c, y, post_dec);
    when post_dec >= excess;
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid <= dec31;
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount);
}
rule Section852b3CiiiIILateDividendsBearTheExcess(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money, paid: Date, excess: Money, post_dec: Money, dec31: Date) strict {
    label en official "section 852(b)(3)(C)(iii)(II): the excess is allocated to dividends paid after December 31 in the ratio of the reported amount to the post-December reported amount";
    when reported_capital_gain_dividend_852b3C(c, y, dividend, amount, paid);
    when excess_reported_amount_852b3Civ(c, y, excess);
    when noncalendar_taxable_year_852b3C(c, y);
    when post_december_reported_amount_852b3Civ(c, y, post_dec);
    when post_dec >= excess;
    when december_31_within_year_852b3Ciii(y, dec31);
    when paid > dec31;
    then capital_gain_dividend_amount_852b3C(c, y, dividend, amount - div_round(excess * (amount / 1.00 USD), post_dec / 1.00 USD, 2, "HALF_UP"));
}
rule Section852b3CDividendIsCapitalGainDividend(c: Person, y: TaxableYear, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 852(b)(3)(B): a dividend with a capital gain dividend amount is a capital gain dividend";
    when capital_gain_dividend_amount_852b3C(c, y, dividend, amount);
    when amount > 0.00 USD;
    then capital_gain_dividend_852(c, y, dividend);
}
rule Section852b3CTotalCapitalGainDividends(c: Person, y: TaxableYear, anchor: us.irc.core::Payment, anchor_amount: Money) strict {
    label en official "section 852(b)(3)(A): the capital gain dividends paid, from the derived amounts (a sum over derived items, TECH-GAPS G4903)";
    when capital_gain_dividend_amount_852b3C(c, y, anchor, anchor_amount);
    then capital_gain_dividends_paid_852(c, y, sum all amount: Money for d: us.irc.core::Payment where capital_gain_dividend_amount_852b3C(c, y, d, amount));
}
// (v): adjustment for determinations
pub relation determination_increased_excess_852b3Cv(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "a determination (section 860(e)) increases the excess of subparagraph (A) for the taxable year";
}
pub relation company_increases_reported_capital_gain_dividends_852b3Cv(c: Person, y: TaxableYear, additional: Money, on: Date) kind empirical {
    label en unofficial "the company increases the amount of capital gain dividends reported under clause (i) by this amount, on this date";
}
pub relation reported_amount_increase_permitted_852b3Cv(c: Person, y: TaxableYear, additional: Money) kind institutional {
    label en official "the increase of the reported capital gain dividends is permitted (the increased amount enters the computation as an additional reported row of the case: TECH-GAPS G4914)";
}
@source(IRC_S852_B, quote = "the company may, subject to the limitations of this subparagraph, increase the amount of capital gain dividends reported under clause (i)")
rule Section852b3CvIncreasePower(c: Person, y: TaxableYear, additional: Money, on: Date) strict {
    label en official "section 852(b)(3)(C)(v): after a determination increases the excess, the company may increase the capital gain dividends it reports";
    when company_increases_reported_capital_gain_dividends_852b3Cv(c, y, additional, on);
    then power IncreaseReportedCapitalGainDividends {
        holder c;
        over c;
        exercise company_increases_reported_capital_gain_dividends_852b3Cv(c, y, additional, on);
        valid_when determination_increased_excess_852b3Cv(c, y);
        effect create(reported_amount_increase_permitted_852b3Cv(c, y, additional));
        window [@1960-01-01, infinity);
    };
}

// ---- Section 852(b)(3)(D): undistributed capital gains ----

@source(IRC_S852_B, quote = "such amount as the company shall designate in respect of such shares in a written notice mailed to its shareholders at any time prior to the expiration of 60 days after close of its taxable year")
pub relation ric_designates_undistributed_capital_gain_852b3D(c: Person, y: TaxableYear, designated: Money, mailed_on: Date) kind empirical {
    label en unofficial "the company designates, in a written notice mailed to shareholders on this date, the amount of undistributed capital gain each shareholder includes";
}
pub relation undistributed_gain_designation_timely_852b3Di(c: Person, y: TaxableYear) kind institutional {
    label en official "the notice was mailed before the expiration of 60 days after the close of the taxable year";
}
rule Section852b3DiTimelyBySixtyDays(c: Person, y: TaxableYear, designated: Money, mailed_on: Date, ends_on: Date) strict {
    label en official "section 852(b)(3)(D)(i): the notice is mailed within 60 days after the close of the taxable year";
    when ric_designates_undistributed_capital_gain_852b3D(c, y, designated, mailed_on);
    when us.irc.core::ends(y, ends_on);
    when mailed_on <= add_calendar_period(ends_on, 60 calendar_day);
    then undistributed_gain_designation_timely_852b3Di(c, y);
}
pub relation undistributed_capital_gain_designated_852b3D(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of undistributed capital gain designated for shareholder inclusion";
}
rule Section852b3DiDesignationPower(c: Person, y: TaxableYear, designated: Money, mailed_on: Date) strict {
    label en official "section 852(b)(3)(D)(i): the company designates undistributed capital gain for shareholder inclusion";
    when ric_designates_undistributed_capital_gain_852b3D(c, y, designated, mailed_on);
    then power UndistributedCapitalGainDesignationRic {
        holder c;
        over c;
        exercise ric_designates_undistributed_capital_gain_852b3D(c, y, designated, mailed_on);
        valid_when undistributed_gain_designation_timely_852b3Di(c, y);
        effect create(undistributed_capital_gain_designated_852b3D(c, y, designated));
        window [@1960-01-01, infinity);
    };
}
pub relation shareholder_designated_amount_852b3D(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the company designated in respect of the shareholder's shares";
}
pub relation shareholder_share_if_all_distributed_852b3D(sh: Person, c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "that part of the amount subjected to tax under (A) which the shareholder would have received if all of it had been distributed as capital gain dividends at the close of the year";
}
pub relation shareholder_long_term_gain_inclusion_852b3Di(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount the shareholder includes in long-term capital gains: the designated amount, not more than the share the shareholder would have received";
}
@source(IRC_S852_B, quote = "but the amount so includible by any shareholder shall not exceed that part of the amount subjected to tax in subparagraph (A) which he would have received if all of such amount had been distributed as capital gain dividends by the company to the holders of such shares at the close of its taxable year")
rule Section852b3DiShareholderInclusion(sh: Person, c: Person, y: TaxableYear, designated_share: Money, cap: Money) strict {
    label en official "section 852(b)(3)(D)(i): the shareholder's inclusion is limited to the shareholder's share";
    when undistributed_capital_gain_designated_852b3D(c, y, _);
    when shareholder_designated_amount_852b3D(sh, c, y, designated_share);
    when shareholder_share_if_all_distributed_852b3D(sh, c, y, cap);
    then shareholder_long_term_gain_inclusion_852b3Di(sh, c, y, min(designated_share, cap));
}
pub relation shareholder_deemed_tax_paid_852b3Dii(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder is deemed to have paid the tax imposed by subparagraph (A) on the included amount, with credit or refund (at the section 11(b) maximum rate)";
}
@source(IRC_S852_B, quote = "every such shareholder shall be deemed to have paid, for his taxable year under clause (i), the tax imposed by subparagraph (A) on the amounts required by this subparagraph to be included")
rule Section852b3DiiDeemedTaxPaid(sh: Person, c: Person, y: TaxableYear, included: Money, rate: Decimal) strict {
    label en official "section 852(b)(3)(D)(ii): deemed payment of the tax on the included amount (JUDGMENT CALL: the section 11(b) rate, cents HALF_UP)";
    when shareholder_long_term_gain_inclusion_852b3Di(sh, c, y, included);
    when us.irc.corporations::maximum_section_11b_rate(y, rate);
    then shareholder_deemed_tax_paid_852b3Dii(sh, c, y, round(included * rate, 2, "HALF_UP"));
}
pub relation shareholder_basis_increase_852b3Diii(sh: Person, c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the adjusted basis of the shares is increased by the included gain less the tax deemed paid";
}
@source(IRC_S852_B, quote = "by the difference between the amount of such includible gains and the tax deemed paid by such shareholder in respect of such shares under clause (ii)")
rule Section852b3DiiiBasisIncrease(sh: Person, c: Person, y: TaxableYear, included: Money, tax: Money) strict {
    label en official "section 852(b)(3)(D)(iii): basis increases by the included gain minus the deemed tax";
    when shareholder_long_term_gain_inclusion_852b3Di(sh, c, y, included);
    when shareholder_deemed_tax_paid_852b3Dii(sh, c, y, tax);
    then shareholder_basis_increase_852b3Diii(sh, c, y, included - tax);
}
pub relation tax_on_undistributed_gain_paid_852b3Div(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the company has paid the tax on the undistributed capital gain";
}
@source(IRC_S852_B, quote = "In the event of such designation the tax imposed by subparagraph (A) shall be paid by the regulated investment company within 30 days after close of its taxable year.")
rule Section852b3DivDutyToPayTax(c: Person, y: TaxableYear, designated: Money, ends_on: Date) strict {
    label en official "section 852(b)(3)(D)(iv): after a designation the company must pay the tax within 30 days after the close of its taxable year";
    when undistributed_capital_gain_designated_852b3D(c, y, designated);
    when us.irc.core::ends(y, ends_on);
    then duty PayTaxOnUndistributedCapitalGainRic {
        bearer c;
        goal achievement {
            condition tax_on_undistributed_gain_paid_852b3Div(c, y);
            window [ends_on, add_calendar_period(ends_on, 30 calendar_day)];
        }
    };
}

// ---- Section 852(b)(3)(E): distributions to which section 897 does not apply ----

@source(IRC_S852_B, quote = "In the case of a distribution to which section 897 does not apply by reason of the second sentence of section 897(h)(1)")
pub relation distribution_exempt_from_section_897_852b3E(dividend: us.irc.core::Payment) kind empirical {
    label en unofficial "section 897 does not apply to the distribution by reason of the second sentence of section 897(h)(1) (section 897 is owned by us.irc.international, not imported: asserted)";
}
pub relation amount_otherwise_long_term_gain_852b3E(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind empirical {
    label en unofficial "the amount of the distribution that would be included in the shareholder's long-term capital gains under subparagraph (B) or (D) without regard to subparagraph (E)";
}
pub relation excluded_from_long_term_gain_852b3Ei(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the amount is not included in computing the shareholder's long-term capital gains";
}
@source(IRC_S852_B, quote = "shall not be included in computing such shareholder's long-term capital gains, and")
rule Section852b3EiExcludedFromLongTermGain(sh: Person, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 852(b)(3)(E)(i): the amount is not long-term capital gain";
    when distribution_exempt_from_section_897_852b3E(dividend);
    when amount_otherwise_long_term_gain_852b3E(sh, dividend, amount);
    then excluded_from_long_term_gain_852b3Ei(sh, dividend, amount);
}
pub relation included_as_dividend_852b3Eii(sh: Person, dividend: us.irc.core::Payment, amount: Money) kind institutional {
    label en official "the amount is included in the shareholder's gross income as a dividend from the regulated investment company";
}
@source(IRC_S852_B, quote = "shall be included in such shareholder's gross income as a dividend from the regulated investment company.")
rule Section852b3EiiIncludedAsDividend(sh: Person, dividend: us.irc.core::Payment, amount: Money) strict {
    label en official "section 852(b)(3)(E)(ii): the amount is a dividend in the shareholder's gross income";
    when distribution_exempt_from_section_897_852b3E(dividend);
    when amount_otherwise_long_term_gain_852b3E(sh, dividend, amount);
    then included_as_dividend_852b3Eii(sh, dividend, amount);
}
