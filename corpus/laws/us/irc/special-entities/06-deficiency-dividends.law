// Section 860 (deduction for deficiency dividends), all subsections (a)-(i).
// Stage 1 (IRC-09 stage 1, A12), priority section, done fully.
//
// METHOD: section 860(e)'s "determination" concept ((1)-(4): a final court
// decision, a section 7121 closing agreement, a Secretary agreement, or a
// taxpayer statement) is a set of alternative TRIGGERING FACTS, modeled as
// four rules concluding the same `determination_occurred` relation — each
// is asserted by the case (adjudicated fact / administrative record), not
// computed. Section 860(a) is a `power` of the qualified investment entity
// (the "claim therefor" of (g) is the exercise; the deduction is the
// effect), `valid_when` a single conjunctive helper atom per the
// compiler's "one atom" rule for `valid_when`. Sections 860(c),(h)
// (interest/statute-of-limitations mechanics) are modeled as their own
// institutional relations, not woven into the power, since they are
// consequences of the SAME determination rather than conditions on the
// deduction's validity.

use self::{
    IRC_S860_A,
    IRC_S860_B,
    IRC_S860_C,
    IRC_S860_D,
    IRC_S860_E,
    IRC_S860_F,
    IRC_S860_G,
    IRC_S860_H,
    IRC_S860_I,
    Person,
    TaxableYear,
    real_estate_investment_trust,
    regulated_investment_company,
};

@source(IRC_S860_B)
pub relation qualified_investment_entity(p: Person, y: TaxableYear) kind institutional {
    label en official "a qualified investment entity for purposes of section 860, per section 860(b)";
}
rule Section860bByRegulatedInvestmentCompany(p: Person, y: TaxableYear) strict {
    label en official "section 860(b)(1): a regulated investment company is a qualified investment entity";
    when regulated_investment_company(p, y);
    then qualified_investment_entity(p, y);
}
rule Section860bByRealEstateInvestmentTrust(p: Person, y: TaxableYear) strict {
    label en official "section 860(b)(2): a real estate investment trust is a qualified investment entity";
    when real_estate_investment_trust(p, y);
    then qualified_investment_entity(p, y);
}

// Section 860(e): the four alternative "determination" triggers.
@source(IRC_S860_E, quote = "a decision by the Tax Court, or a judgment, decree, or other order by any court of competent jurisdiction, which has become final")
pub relation final_court_decision(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "a final decision, judgment, decree, or order by a court of competent jurisdiction (including the Tax Court), per section 860(e)(1)";
}
@source(IRC_S860_E, quote = "a closing agreement made under section 7121")
pub relation closing_agreement_7121(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "a closing agreement made under section 7121, per section 860(e)(2)";
}
@source(IRC_S860_E, quote = "under regulations prescribed by the Secretary, an agreement signed by the Secretary and by, or on behalf of, the qualified investment entity relating to the liability of such entity for tax")
pub relation secretary_signed_agreement(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "an agreement signed by the Secretary and the entity relating to its tax liability, per section 860(e)(3)";
}
@source(IRC_S860_E, quote = "a statement by the taxpayer attached to its amendment or supplement to a return of tax for the relevant tax year")
pub relation taxpayer_statement_on_amended_return(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "a statement by the taxpayer attached to an amendment or supplement to its return for the relevant tax year, per section 860(e)(4)";
}
@source(IRC_S860_E)
pub relation determination_occurred(p: Person, y: TaxableYear, on: Date) kind institutional {
    label en official "a \"determination\" within the meaning of section 860(e) occurred on the given date";
}
rule Section860e1DeterminationByCourtDecision(p: Person, y: TaxableYear, on: Date) strict {
    label en official "section 860(e)(1): a final court decision is a determination";
    when final_court_decision(p, y, on);
    then determination_occurred(p, y, on);
}
rule Section860e2DeterminationByClosingAgreement(p: Person, y: TaxableYear, on: Date) strict {
    label en official "section 860(e)(2): a section 7121 closing agreement is a determination";
    when closing_agreement_7121(p, y, on);
    then determination_occurred(p, y, on);
}
rule Section860e3DeterminationBySecretaryAgreement(p: Person, y: TaxableYear, on: Date) strict {
    label en official "section 860(e)(3): a Secretary-signed agreement is a determination";
    when secretary_signed_agreement(p, y, on);
    then determination_occurred(p, y, on);
}
rule Section860e4DeterminationByTaxpayerStatement(p: Person, y: TaxableYear, on: Date) strict {
    label en official "section 860(e)(4): a taxpayer statement on an amended return is a determination";
    when taxpayer_statement_on_amended_return(p, y, on);
    then determination_occurred(p, y, on);
}

// Section 860(d): "adjustment" (modeled as an asserted amount per entity
// type, since its own components (852(b)(2)/(3)(A), 857(b)(2)/(3)(A)(ii))
// are separately modeled in modules 04-05; kept as a case fact here to
// avoid re-deriving the same figure through two different paths for the
// same (entity, year) key).
@source(IRC_S860_D)
pub relation adjustment_amount_ric(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 860(d)(1) adjustment amount for a regulated investment company, for the taxable year";
}
@source(IRC_S860_D)
pub relation adjustment_amount_reit(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 860(d)(2) adjustment amount for a real estate investment trust, for the taxable year";
}
@source(IRC_S860_A, quote = "If a determination with respect to any qualified investment entity results in any adjustment for any taxable year")
pub relation determination_results_in_adjustment(p: Person, y: TaxableYear) kind institutional {
    label en official "a determination with respect to the entity resulted in an adjustment for the taxable year, per section 860(a)";
}
rule Section860aAdjustmentFromRicFigure(p: Person, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "a determination plus a nonzero RIC adjustment amount satisfies the section 860(a) trigger";
    when determination_occurred(p, y, on);
    when adjustment_amount_ric(p, y, amount);
    when amount > 0.00 USD;
    then determination_results_in_adjustment(p, y);
}
rule Section860aAdjustmentFromReitFigure(p: Person, y: TaxableYear, on: Date, amount: Money) strict {
    label en official "a determination plus a nonzero REIT adjustment amount satisfies the section 860(a) trigger";
    when determination_occurred(p, y, on);
    when adjustment_amount_reit(p, y, amount);
    when amount > 0.00 USD;
    then determination_results_in_adjustment(p, y);
}

// Section 860(f): the deficiency-dividends definition and its own
// distribution-timing/limitation-amount conditions.
@source(IRC_S860_F, quote = "a distribution of property made by the qualified investment entity on or after the date of the determination and before filing claim under subsection (g), which would have been includible in the computation of the deduction for dividends paid under section 561 for the taxable year with respect to which the liability for tax resulting from the determination exists if distributed during such taxable year")
pub relation distribution_after_determination_before_claim(p: Person, y: TaxableYear, amount: Money, distributed_on: Date) kind empirical {
    label en unofficial "a distribution of property made on or after the determination and before the section 860(g) claim, that would have counted toward the section 561 dividends-paid deduction if paid during the taxable year, per section 860(f)(1)";
}
@source(IRC_S860_F, quote = "No distribution of property shall be considered as deficiency dividends for purposes of subsection (a) unless distributed within 90 days after the determination, and unless a claim for a deficiency dividend deduction with respect to such distribution is filed pursuant to subsection (g).")
pub relation distributed_within_90_days_of_determination(p: Person, y: TaxableYear, distributed_on: Date, determination_on: Date) kind empirical {
    label en unofficial "the distribution was made within 90 days after the determination, per section 860(f)(1)'s proviso";
}
pub relation claim_filed_under_860g(p: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "a claim for the deficiency dividend deduction was filed, per section 860(g)";
}
@source(IRC_S860_F)
pub relation deficiency_dividends(p: Person, y: TaxableYear, amount: Money, distributed_on: Date) kind institutional {
    label en official "a distribution of property is deficiency dividends within the meaning of section 860(f), for the taxable year";
}
rule Section860fDeficiencyDividendsQualify(p: Person, y: TaxableYear, amount: Money, distributed_on: Date, determination_on: Date, claim_on: Date) strict {
    label en official "section 860(f)(1): a post-determination, pre-claim distribution within 90 days of the determination, with a claim filed, is a deficiency dividend";
    when determination_occurred(p, y, determination_on);
    when distribution_after_determination_before_claim(p, y, amount, distributed_on);
    when distributed_within_90_days_of_determination(p, y, distributed_on, determination_on);
    when claim_filed_under_860g(p, y, claim_on);
    then deficiency_dividends(p, y, amount, distributed_on);
}

// Section 860(g): the 120-day claim window.
@source(IRC_S860_G, quote = "No deficiency dividend deduction shall be allowed under subsection (a) unless (under regulations prescribed by the Secretary) claim therefore is filed within 120 days after the date of the determination.")
pub relation claim_filed_within_120_days_of_determination(p: Person, y: TaxableYear, claim_on: Date, determination_on: Date) kind empirical {
    label en unofficial "the claim under section 860(g) was filed within 120 days after the determination";
}

// Section 860(i): the fraud/willful-failure bar.
@source(IRC_S860_I, quote = "No deficiency dividend deduction shall be allowed under subsection (a) if the determination contains a finding that any part of any deficiency attributable to an adjustment with respect to the taxable year is due to fraud with intent to evade tax or to willful failure to file an income tax return within the time prescribed by law or prescribed by the Secretary in pursuance of law.")
pub relation determination_finds_fraud_or_willful_failure_to_file(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the determination contains a finding of fraud with intent to evade tax, or willful failure to timely file, per section 860(i)";
}

// Section 860(a): the deduction itself, as a `power` of the qualified
// investment entity — exercise is the filing of a valid, timely claim,
// valid_when the single conjunctive precondition below, effect the
// deficiency-dividends deduction for purposes of the section 852/857
// dividends-paid deduction.
@source(IRC_S860_A)
pub relation deficiency_dividend_deduction_allowed(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 860(a) deduction for the amount of deficiency dividends is allowed, for purposes of the section 852 or 857 dividends paid deduction";
}
@source(IRC_S860_A)
pub relation section_860a_deduction_conditions_met(p: Person, y: TaxableYear, claim_on: Date, determination_on: Date) kind institutional {
    label en official "the section 860(a) preconditions (a determination resulting in an adjustment, a timely 120-day claim, and no section 860(i) fraud finding) are all met";
}
rule Section860aDeductionConditionsMet(p: Person, y: TaxableYear, claim_on: Date, determination_on: Date) strict {
    label en official "section 860(a)/(g)/(i): a determination-driven adjustment, a claim filed within 120 days, and no fraud/willful-failure finding, together satisfy the preconditions of the deduction";
    when determination_results_in_adjustment(p, y);
    when claim_filed_within_120_days_of_determination(p, y, claim_on, determination_on);
    when not_known(determination_finds_fraud_or_willful_failure_to_file(p, y));
    then section_860a_deduction_conditions_met(p, y, claim_on, determination_on);
}
rule Section860aDeductionAllowedByPower(p: Person, y: TaxableYear, amount: Money, distributed_on: Date, claim_on: Date, determination_on: Date) strict {
    label en official "section 860(a): a qualified investment entity may claim the deficiency-dividend deduction when the preconditions are met";
    when qualified_investment_entity(p, y);
    when deficiency_dividends(p, y, amount, distributed_on);
    when claim_filed_under_860g(p, y, claim_on);
    when determination_occurred(p, y, determination_on);
    then power Section860DeficiencyDividendDeduction {
        holder p;
        over p;
        exercise claim_filed_under_860g(p, y, claim_on);
        valid_when section_860a_deduction_conditions_met(p, y, claim_on, determination_on);
        effect create(deficiency_dividend_deduction_allowed(p, y, amount));
        window [@1976-01-01, infinity);
    };
}

// Section 860(c): interest/additions-to-tax bookkeeping consequences of the
// deduction (not the deduction's own validity — a separate legal state per
// PLAN §6.2, "separate consequence").
@source(IRC_S860_C, quote = "the tax imposed by this chapter (after taking into account the deduction allowed by subsection (a)) on the qualified investment entity for the taxable year with respect to which the determination is made shall be deemed to be increased by an amount equal to the deduction allowed by subsection (a) with respect to such taxable year")
pub relation deemed_tax_increase_for_interest_purposes(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "for interest/addition-to-tax purposes, the tax is deemed increased by the deduction amount, per section 860(c)(1)(A)";
}
rule Section860c1ADeemedTaxIncrease(p: Person, y: TaxableYear, amount: Money) strict {
    label en official "section 860(c)(1)(A): the deficiency dividend deduction amount is deemed an increase in tax for interest/addition-to-tax purposes";
    when deficiency_dividend_deduction_allowed(p, y, amount);
    then deemed_tax_increase_for_interest_purposes(p, y, amount);
}

// Section 860(h): suspension of the section 6501 limitations period and
// stay of collection while a section 860(g) claim is pending.
@source(IRC_S860_H)
pub relation limitations_period_suspended_2_years_from_determination(p: Person, y: TaxableYear, determination_on: Date) kind institutional {
    label en official "the section 6501 assessment limitations period is suspended for 2 years after the determination, per section 860(h)(1)";
}
rule Section860h1LimitationsSuspended(p: Person, y: TaxableYear, claim_on: Date, determination_on: Date) strict {
    label en official "section 860(h)(1): filing a section 860(g) claim suspends the section 6501 limitations period for 2 years after the determination";
    when claim_filed_under_860g(p, y, claim_on);
    when determination_occurred(p, y, determination_on);
    then limitations_period_suspended_2_years_from_determination(p, y, determination_on);
}
@source(IRC_S860_H)
pub relation collection_stayed_120_days_from_determination(p: Person, y: TaxableYear, determination_on: Date) kind institutional {
    label en official "collection of the deficiency is stayed until 120 days after the determination (absent jeopardy), per section 860(h)(2)(A)";
}
rule Section860h2ACollectionStayed(p: Person, y: TaxableYear, determination_on: Date) defeasible {
    label en official "section 860(h)(2)(A): collection is stayed for 120 days after the determination, absent jeopardy (jeopardy is not modeled: no jeopardy-collection relation exists for this rule to be defeated by)";
    when determination_occurred(p, y, determination_on);
    then collection_stayed_120_days_from_determination(p, y, determination_on);
}
