// Sections 1353-1359 stage 3b (IRC-09 stage 3b, TECH_GAP reduction),
// 26.09.2026. Status implemented_unverified; nothing here was executed.
//
// METHOD.
//   * 1353(a): the notional shipping income is the sum over the vessels
//     (a sum over derived items, G4903); the tonnage tax of module 15 now
//     reads that total. 1353(b)(2): the section 883 partial exclusion ratio.
//     1353(d): multiple operators share a vessel's income by their interests
//     (or by a share the Secretary prescribes).
//   * 1354(b)(3): the election runs from the year made until it is ended
//     by a termination or a revocation (dates compared with the year
//     beginning); a separate relation is used because the election of module
//     15 is a power effect and is not re-derived.
//   * 1355(a)(2), (5), (7): the electing group and the controlled group
//     (single employer under section 52 without (a)(1), (2)), the United
//     States flag vessel, and United States foreign trade.
//   * 1355(c)(3): the tonnage tests of a member of a controlled group are
//     applied to the group (sums over the other members).
//   * 1355(d)(2)-(3): a partner conducts the partnership's activities and
//     its interest in a vessel follows its interest in the partnership;
//     the same relations serve every pass-thru entity (the entity type is
//     Partnership in this package).
//   * 1355(g)(2)(C): the earlier-of pattern for the end of temporary use.
//   * 1356(e): the 20 percent and 0.1 percent limits of an electing group
//     are applied to the group and allocated by core income.
//   * 1359(c): persons that would be qualifying vessel operators were they
//     corporations.

// ---- Section 1353(b)(2): the section 883 partial exclusion ----

use self::{
    Corporation,
    IRC_S1353_A,
    IRC_S1353_B,
    IRC_S1353_D,
    IRC_S1354_B,
    IRC_S1355_A,
    IRC_S1355_C,
    IRC_S1355_D,
    IRC_S1355_G,
    IRC_S1356_E,
    IRC_S1359_C,
    Person,
    TaxableYear,
    aggregate_average_tonnage_of_qualifying_vessels_used_1355c4,
    daily_notional_shipping_income_1353c,
    electing_group_member_1357b,
    election_timely_1354b,
    elects_tonnage_tax_1354,
    gross_income_core_qualifying_activities_1356b,
    gross_income_incidental_shipping_activities_1356d,
    gross_income_secondary_activities_1356c2,
    member_of_controlled_group_treated_as_one_person_1355c3,
    notional_shipping_income_per_vessel_1353b1,
    owned_or_bareboat_chartered_average_tonnage_1355c4,
    partner_in_partnership_1355d,
    qualifying_shipping_activities_income_1356a,
    qualifying_vessel,
    qualifying_vessel_operator_1355a3,
    revocation_effective_for_years_beginning_on_or_after_1354d1,
    shipping_activity_year_test_met_1355c4,
    tonnage_election_terminated_from,
};

pub relation gross_income_from_vessel_in_us_foreign_trade_1353b2(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the gross income from the operation of the vessel in the United States foreign trade";
}
pub relation income_excluded_by_883_or_otherwise_1353b2(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the income from the vessel not included in gross income by reason of section 883 or otherwise";
}
pub relation vessel_has_excluded_income_1353b2(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "some of the vessel's income is excluded (helper)";
}
rule Section1353b2HelperHasExcluded(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when income_excluded_by_883_or_otherwise_1353b2(c, v, y, amount);
    then vessel_has_excluded_income_1353b2(c, v, y);
}
pub relation notional_shipping_income_after_partial_exclusion_1353b2(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the notional shipping income of the vessel scaled by the ratio of the gross income in United States foreign trade to that income plus the excluded income (cents HALF_UP)";
}
@source(IRC_S1353_B, quote = "In the case of a qualifying vessel any of the income from which is not included in gross income by")
rule Section1353b2PartialExclusionRatio(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, notional: Money, in_trade: Money, excluded: Money) strict {
    label en official "section 1353(b)(2): the notional shipping income bears to the shipping income the ratio of the gross income in United States foreign trade to that income plus the excluded income";
    when notional_shipping_income_per_vessel_1353b1(c, v, y, notional);
    when gross_income_from_vessel_in_us_foreign_trade_1353b2(c, v, y, in_trade);
    when income_excluded_by_883_or_otherwise_1353b2(c, v, y, excluded);
    when in_trade + excluded > 0.00 USD;
    then notional_shipping_income_after_partial_exclusion_1353b2(c, v, y, div_round(notional * (in_trade / 1.00 USD), (in_trade + excluded) / 1.00 USD, 2, "HALF_UP"));
}

// ---- Section 1353(d): several operators ----

pub relation days_operated_by_all_operators_1353d(v: us.irc.core::Asset, y: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the number of days the vessel was operated as a qualifying vessel in United States foreign trade by all its operators";
}
pub relation operator_interest_share_1353d(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, share: Decimal) kind empirical {
    label en unofficial "the operator's ownership, charter, and operating agreement interests in the vessel, as a share of the whole";
}
pub relation secretary_prescribed_share_1353d(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, share: Decimal) kind empirical {
    label en unofficial "a share of the operator determined on another basis prescribed by the Secretary in regulations";
}
pub relation secretary_prescribes_share_for_1353d(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the Secretary prescribed a share for the operator (helper)";
}
rule Section1353dHelperSecretaryShare(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, share: Decimal) strict {
    label en official "helper";
    when secretary_prescribed_share_1353d(c, v, y, share);
    then secretary_prescribes_share_for_1353d(c, v, y);
}
pub relation vessel_notional_shipping_income_all_operators_1353d(v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the notional shipping income of the vessel for all its operators together";
}
rule Section1353dVesselIncomeAllOperators(v: us.irc.core::Asset, y: TaxableYear, daily: Money, days: Integer) strict {
    label en official "section 1353(b)(1), (d): the daily notional shipping income times the days of operation by all operators";
    when qualifying_vessel(v, y);
    when daily_notional_shipping_income_1353c(v, daily);
    when days_operated_by_all_operators_1353d(v, y, days);
    then vessel_notional_shipping_income_all_operators_1353d(v, y, round(daily * days, 2, "HALF_UP"));
}
pub relation allocated_notional_shipping_income_1353d(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the operator's part of the vessel's notional shipping income, by interests or by the Secretary's basis";
}
@source(IRC_S1353_D, quote = "If for any period 2 or more persons are operators of a qualifying vessel, the notional shipping income")
rule Section1353dAllocationByInterests(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, whole: Money, share: Decimal) strict {
    label en official "section 1353(d): allocated on the basis of ownership, charter, and operating agreement interests (cents HALF_UP)";
    when vessel_notional_shipping_income_all_operators_1353d(v, y, whole);
    when operator_interest_share_1353d(c, v, y, share);
    when not_known(secretary_prescribes_share_for_1353d(c, v, y));
    then allocated_notional_shipping_income_1353d(c, v, y, round(whole * share, 2, "HALF_UP"));
}
rule Section1353dAllocationBySecretaryBasis(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, whole: Money, share: Decimal) strict {
    label en official "section 1353(d): or on such other basis as the Secretary may prescribe";
    when vessel_notional_shipping_income_all_operators_1353d(v, y, whole);
    when secretary_prescribed_share_1353d(c, v, y, share);
    then allocated_notional_shipping_income_1353d(c, v, y, round(whole * share, 2, "HALF_UP"));
}
pub relation has_allocated_notional_income_1353d(c: Corporation, v: us.irc.core::Asset, y: TaxableYear) kind institutional {
    label en official "the operator's part is fixed by an allocation under (d) (helper)";
}
rule Section1353dHelperHasAllocation(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "helper";
    when allocated_notional_shipping_income_1353d(c, v, y, amount);
    then has_allocated_notional_income_1353d(c, v, y);
}

// ---- Section 1353(a): the total over the vessels ----

pub relation notional_shipping_income_of_vessel_1353(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) kind institutional {
    label en official "the notional shipping income of the vessel for the operator: after the partial exclusion of (b)(2) or the allocation of (d)";
}
rule Section1353VesselIncomeAfterExclusion(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 1353(b)(2): the vessel's income after the partial exclusion ratio";
    when notional_shipping_income_after_partial_exclusion_1353b2(c, v, y, amount);
    when not_known(has_allocated_notional_income_1353d(c, v, y));
    then notional_shipping_income_of_vessel_1353(c, v, y, amount);
}
rule Section1353VesselIncomeOrdinary(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 1353(b)(1): the vessel's income when nothing is excluded or allocated";
    when notional_shipping_income_per_vessel_1353b1(c, v, y, amount);
    when not_known(vessel_has_excluded_income_1353b2(c, v, y));
    when not_known(has_allocated_notional_income_1353d(c, v, y));
    then notional_shipping_income_of_vessel_1353(c, v, y, amount);
}
rule Section1353VesselIncomeAllocated(c: Corporation, v: us.irc.core::Asset, y: TaxableYear, amount: Money) strict {
    label en official "section 1353(d): the operator's allocated part";
    when allocated_notional_shipping_income_1353d(c, v, y, amount);
    then notional_shipping_income_of_vessel_1353(c, v, y, amount);
}
pub relation notional_shipping_income_1353a(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the notional shipping income of an electing corporation: the sum of the amounts for each qualifying vessel it operates";
}
@source(IRC_S1353_A, quote = "For purposes of this subchapter, the notional shipping income of an electing corporation shall be the")
rule Section1353aSumOverVessels(c: Corporation, y: TaxableYear) strict {
    label en official "section 1353(a): the sum over the qualifying vessels operated (a sum over derived items: G4903)";
    when notional_shipping_income_of_vessel_1353(c, _, y, _);
    then notional_shipping_income_1353a(c, y, sum all amount: Money for v: us.irc.core::Asset where notional_shipping_income_of_vessel_1353(c, v, y, amount));
}

// ---- Section 1354(b)(3): the election runs until ended ----

pub relation election_ended_for_year_1354b3(c: Corporation, y: TaxableYear) kind institutional {
    label en official "a termination or revocation takes effect on or before the beginning of the taxable year";
}
rule Section1354b3EndedByTermination(c: Corporation, y: TaxableYear, from: Date, begins_on: Date) strict {
    label en official "section 1354(b)(3), (d)(2): the election is ended for the years beginning on and after a termination date";
    when tonnage_election_terminated_from(c, from);
    when us.irc.core::begins(y, begins_on);
    when begins_on >= from;
    then election_ended_for_year_1354b3(c, y);
}
rule Section1354b3EndedByRevocation(c: Corporation, y: TaxableYear, made_in: TaxableYear, from: Date, begins_on: Date) defeasible {
    label en official "section 1354(b)(3), (d)(1): the election is ended for the years beginning on and after the effective date of a revocation";
    when revocation_effective_for_years_beginning_on_or_after_1354d1(c, made_in, from);
    when us.irc.core::begins(y, begins_on);
    when begins_on >= from;
    then election_ended_for_year_1354b3(c, y);
}
pub relation tonnage_election_in_effect_for_year_1354b3(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the election made for an earlier taxable year is still in effect for the taxable year";
}
@source(IRC_S1354_B, quote = "(2) shall be effective for the taxable year for which made and all succeeding taxable years until")
rule Section1354b3ElectionContinues(c: Corporation, y: TaxableYear, made_in: TaxableYear, made_begins: Date, begins_on: Date) defeasible {
    label en official "section 1354(b)(3): effective for the taxable year for which made and all succeeding taxable years until terminated";
    when elects_tonnage_tax_1354(c, made_in);
    when election_timely_1354b(c, made_in);
    when us.irc.core::begins(made_in, made_begins);
    when us.irc.core::begins(y, begins_on);
    when begins_on >= made_begins;
    when not_known(election_ended_for_year_1354b3(c, y));
    then tonnage_election_in_effect_for_year_1354b3(c, y);
}

// ---- Section 1355(a): the electing group, the controlled group, flag vessels and foreign trade ----

pub relation single_employer_under_52_without_52a1_52a2_1355a2B(a: Corporation, b: Corporation) kind empirical {
    label en unofficial "the two corporations would be treated as a single employer under subsection (a) or (b) of section 52 if paragraphs (1) and (2) of section 52(a) did not apply";
}
pub relation controlled_group_1355a2B(a: Corporation, b: Corporation) kind institutional {
    label en official "the two corporations are members of a controlled group";
}
@source(IRC_S1355_A, quote = "means any group which would be treated as a single employer under subsection (a) or (b) of section 52 if")
rule Section1355a2BControlledGroup(a: Corporation, b: Corporation) strict {
    label en official "section 1355(a)(2)(B): a group treated as a single employer under section 52 (paragraphs (1) and (2) of section 52(a) disregarded)";
    when single_employer_under_52_without_52a1_52a2_1355a2B(a, b);
    then controlled_group_1355a2B(a, b);
}
rule Section1355a2BControlledGroupSymmetric(a: Corporation, b: Corporation) strict {
    label en official "section 1355(a)(2)(B): the relation is symmetric";
    when single_employer_under_52_without_52a1_52a2_1355a2B(b, a);
    then controlled_group_1355a2B(a, b);
}
pub relation electing_group_1355a2A(member: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation is a member of a controlled group of which one or more members is an electing corporation (the election is read from the electing fact: G5315)";
}
@source(IRC_S1355_A, quote = "means a controlled group of which one or more members is an electing corporation.")
rule Section1355a2AGroupWithElectingMember(a: Corporation, b: Corporation, y: TaxableYear) strict {
    label en official "section 1355(a)(2)(A): a controlled group of which one or more members is an electing corporation";
    when controlled_group_1355a2B(a, b);
    when elects_tonnage_tax_1354(b, y);
    then electing_group_1355a2A(a, y);
}
rule Section1355a2AElectingMemberItself(a: Corporation, y: TaxableYear) strict {
    label en official "section 1355(a)(2)(A): the electing corporation is a member of its own group";
    when elects_tonnage_tax_1354(a, y);
    then electing_group_1355a2A(a, y);
}
rule Section1357bGroupMemberByGroup(a: Corporation, y: TaxableYear) strict {
    label en official "section 1357(b): a non-electing member of an electing group (derived from the group definition)";
    when electing_group_1355a2A(a, y);
    when not_known(elects_tonnage_tax_1354(a, y));
    then electing_group_member_1357b(a, y);
}
pub relation documented_under_laws_of_united_states_1355a5(v: us.irc.core::Asset) kind empirical {
    label en unofficial "the vessel is documented under the laws of the United States";
}
pub relation united_states_flag_vessel_1355a5(v: us.irc.core::Asset) kind institutional {
    label en official "the vessel is a United States flag vessel";
}
@source(IRC_S1355_A, quote = "means any vessel documented under the laws of the United States.")
rule Section1355a5UnitedStatesFlagVessel(v: us.irc.core::Asset) strict {
    label en official "section 1355(a)(5): any vessel documented under the laws of the United States";
    when documented_under_laws_of_united_states_1355a5(v);
    then united_states_flag_vessel_1355a5(v);
}
pub relation voyage_between_places_1355a7(voyage: us.irc.core::Transaction, from: Text, to: Text) kind empirical {
    label en unofficial "the transportation of goods or passengers between two places";
}
pub relation place_in_united_states_1355a7(place: Text) kind empirical {
    label en unofficial "the place is in the United States";
}
pub relation foreign_place_1355a7(place: Text) kind empirical {
    label en unofficial "the place is a foreign place";
}
pub relation united_states_foreign_trade_1355a7(voyage: us.irc.core::Transaction) kind institutional {
    label en official "the transportation is in United States foreign trade";
}
@source(IRC_S1355_A, quote = "means the transportation of goods or passengers between a place in the United States and a foreign place")
rule Section1355a7UsToForeign(voyage: us.irc.core::Transaction, from: Text, to: Text) strict {
    label en official "section 1355(a)(7): transportation between a place in the United States and a foreign place";
    when voyage_between_places_1355a7(voyage, from, to);
    when place_in_united_states_1355a7(from);
    when foreign_place_1355a7(to);
    then united_states_foreign_trade_1355a7(voyage);
}
rule Section1355a7ForeignToUs(voyage: us.irc.core::Transaction, from: Text, to: Text) strict {
    label en official "section 1355(a)(7): transportation between a foreign place and a place in the United States";
    when voyage_between_places_1355a7(voyage, from, to);
    when foreign_place_1355a7(from);
    when place_in_united_states_1355a7(to);
    then united_states_foreign_trade_1355a7(voyage);
}
rule Section1355a7ForeignToForeign(voyage: us.irc.core::Transaction, from: Text, to: Text) strict {
    label en official "section 1355(a)(7): transportation between foreign places";
    when voyage_between_places_1355a7(voyage, from, to);
    when foreign_place_1355a7(from);
    when foreign_place_1355a7(to);
    then united_states_foreign_trade_1355a7(voyage);
}
@source(IRC_S1355_A, quote = "For purposes of this subchapter—")
pub relation subsection_a_definitions_applied_1355a(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the definitions of subsection (a) apply to the corporation (chapeau)";
}
rule Section1355aChapeau(c: Corporation, y: TaxableYear) strict {
    label en official "section 1355(a): for purposes of the subchapter, the definitions of the subsection";
    when electing_group_1355a2A(c, y);
    then subsection_a_definitions_applied_1355a(c, y);
}

// ---- Section 1355(c)(3): the group figures ----

pub relation other_member_owned_tonnage_1355c3(c: Corporation, y: TaxableYear, other: Corporation, tons: Decimal) kind institutional {
    label en official "the average tonnage owned or bareboat chartered by another member of the controlled group";
}
rule Section1355c3OtherMemberOwned(c: Corporation, y: TaxableYear, other: Corporation, tons: Decimal) strict {
    label en official "section 1355(c)(3): the other members of the group counted as one person";
    when controlled_group_1355a2B(c, other);
    when owned_or_bareboat_chartered_average_tonnage_1355c4(other, y, tons);
    then other_member_owned_tonnage_1355c3(c, y, other, tons);
}
pub relation other_member_aggregate_tonnage_1355c3(c: Corporation, y: TaxableYear, other: Corporation, tons: Decimal) kind institutional {
    label en official "the average aggregate tonnage of the qualifying vessels used by another member of the controlled group";
}
rule Section1355c3OtherMemberAggregate(c: Corporation, y: TaxableYear, other: Corporation, tons: Decimal) strict {
    label en official "section 1355(c)(3): the other members' aggregate tonnage";
    when controlled_group_1355a2B(c, other);
    when aggregate_average_tonnage_of_qualifying_vessels_used_1355c4(other, y, tons);
    then other_member_aggregate_tonnage_1355c3(c, y, other, tons);
}
pub relation group_owned_tonnage_1355c3(c: Corporation, y: TaxableYear, tons: Decimal) kind institutional {
    label en official "the owned or bareboat chartered tonnage of the member and the rest of the group";
}
rule Section1355c3GroupOwned(c: Corporation, y: TaxableYear, own: Decimal) strict {
    label en official "section 1355(c)(3): the group's owned or bareboat chartered tonnage (a sum over the other members: G4903)";
    when owned_or_bareboat_chartered_average_tonnage_1355c4(c, y, own);
    when other_member_owned_tonnage_1355c3(c, y, _, _);
    then group_owned_tonnage_1355c3(c, y, own + sum all tons: Decimal for other: Corporation where other_member_owned_tonnage_1355c3(c, y, other, tons));
}
pub relation group_aggregate_tonnage_1355c3(c: Corporation, y: TaxableYear, tons: Decimal) kind institutional {
    label en official "the aggregate tonnage of qualifying vessels used by the member and the rest of the group";
}
rule Section1355c3GroupAggregate(c: Corporation, y: TaxableYear, own: Decimal) strict {
    label en official "section 1355(c)(3): the group's aggregate tonnage";
    when aggregate_average_tonnage_of_qualifying_vessels_used_1355c4(c, y, own);
    when other_member_aggregate_tonnage_1355c3(c, y, _, _);
    then group_aggregate_tonnage_1355c3(c, y, own + sum all tons: Decimal for other: Corporation where other_member_aggregate_tonnage_1355c3(c, y, other, tons));
}
@source(IRC_S1355_C, quote = "A corporation who is a member of a controlled group meets the shipping activity requirement of this")
rule Section1355c3GroupShippingActivityTest(c: Corporation, y: TaxableYear, owned: Decimal, aggregate: Decimal) strict {
    label en official "section 1355(c)(3): a member of a controlled group meets the requirement only if it is met treating all members as one person";
    when member_of_controlled_group_treated_as_one_person_1355c3(c, y);
    when group_owned_tonnage_1355c3(c, y, owned);
    when group_aggregate_tonnage_1355c3(c, y, aggregate);
    when owned * 100.0 >= aggregate * 25.0;
    then shipping_activity_year_test_met_1355c4(c, y);
}

// ---- Section 1355(d)(2)-(3): partners ----

pub relation activity_conducted_by_partnership_1355d2(pt: us.irc.core::Partnership, y: TaxableYear, activity: Text) kind empirical {
    label en unofficial "the partnership (or other pass-thru entity) conducts the activity in the taxable year";
}
pub relation partner_treated_as_conducting_activity_1355d2(p: Person, pt: us.irc.core::Partnership, y: TaxableYear, activity: Text) kind institutional {
    label en official "each partner is treated as conducting the activities conducted by the partnership";
}
@source(IRC_S1355_D, quote = "(2) each partner shall be treated as conducting the activities conducted by the partnership, and")
rule Section1355d2PartnerConductsPartnershipActivities(p: Person, pt: us.irc.core::Partnership, y: TaxableYear, activity: Text) strict {
    label en official "section 1355(d)(2): each partner is treated as conducting the activities conducted by the partnership";
    when partner_in_partnership_1355d(p, pt, y);
    when activity_conducted_by_partnership_1355d2(pt, y, activity);
    then partner_treated_as_conducting_activity_1355d2(p, pt, y, activity);
}
pub relation partner_percentage_in_partnership_1355d3(p: Person, pt: us.irc.core::Partnership, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the partner's interest in the partnership, in percent";
}
pub relation partnership_interest_in_vessel_1355d3(pt: us.irc.core::Partnership, v: us.irc.core::Asset, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the partnership's ownership, charter, or operating agreement interest in the vessel, in percent";
}
pub relation partner_interest_in_vessel_1355d3(p: Person, v: us.irc.core::Asset, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the partner's interest in the vessel operated by the partnership, determined on the basis of its interest in the partnership (percent, 4 decimals HALF_UP)";
}
@source(IRC_S1355_D, quote = "(3) the extent of a partner's ownership, charter, or operating agreement interest in any vessel operated")
rule Section1355d3PartnerInterestInVessel(p: Person, pt: us.irc.core::Partnership, v: us.irc.core::Asset, y: TaxableYear, share: Decimal, vessel_pct: Decimal) strict {
    label en official "section 1355(d)(3): the partner's interest in a vessel of the partnership is determined by its interest in the partnership";
    when partner_percentage_in_partnership_1355d3(p, pt, y, share);
    when partnership_interest_in_vessel_1355d3(pt, v, y, vessel_pct);
    then partner_interest_in_vessel_1355d3(p, v, y, div_round(share * vessel_pct, 100.0, 4, "HALF_UP"));
}
pub relation pass_thru_entity_rule_recorded_1355d(pt: us.irc.core::Partnership, y: TaxableYear) kind institutional {
    label en official "the partnership rules serve every pass-thru entity of this package (its entity type is Partnership)";
}
@source(IRC_S1355_D, quote = "A similar rule shall apply with respect to other pass-thru entities.")
rule Section1355dOtherPassThruEntities(p: Person, pt: us.irc.core::Partnership, y: TaxableYear) strict {
    label en official "section 1355(d), last sentence: a similar rule applies to other pass-thru entities (the same relations are used)";
    when partner_in_partnership_1355d(p, pt, y);
    then pass_thru_entity_rule_recorded_1355d(pt, y);
}

// ---- Section 1355(g)(2)(C): the end of temporary use in the zone ----

pub relation zone_use_abandoned_on_1355g2Ci(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the electing corporation abandons its intention to resume operation of the vessel in United States foreign trade or qualified zone domestic trade";
}
pub relation zone_use_resumed_on_1355g2Cii(c: Corporation, v: us.irc.core::Asset, on: Date) kind empirical {
    label en unofficial "the electing corporation resumes operation of the vessel in United States foreign trade or qualified zone domestic trade";
}
pub relation temporary_zone_use_end_candidate_1355g2C(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a date on which the period of temporary use could end";
}
rule Section1355g2CAbandonmentCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(g)(2)(C)(i): abandonment is a candidate end";
    when zone_use_abandoned_on_1355g2Ci(c, v, on);
    then temporary_zone_use_end_candidate_1355g2C(c, v, on);
}
rule Section1355g2CResumptionCandidate(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(g)(2)(C)(ii): resumption is a candidate end";
    when zone_use_resumed_on_1355g2Cii(c, v, on);
    then temporary_zone_use_end_candidate_1355g2C(c, v, on);
}
pub relation earlier_temporary_zone_use_end_candidate_exists_1355g2C(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "a strictly earlier candidate end date exists (helper)";
}
rule Section1355g2CEarlierCandidate(c: Corporation, v: us.irc.core::Asset, on: Date, other: Date) strict {
    label en official "helper: a candidate end strictly earlier than the given one exists";
    when temporary_zone_use_end_candidate_1355g2C(c, v, on);
    when temporary_zone_use_end_candidate_1355g2C(c, v, other);
    when other < on;
    then earlier_temporary_zone_use_end_candidate_exists_1355g2C(c, v, on);
}
pub relation temporary_zone_use_period_end_1355g2C(c: Corporation, v: us.irc.core::Asset, on: Date) kind institutional {
    label en official "the period of temporary use continues until the earlier of abandonment and resumption";
}
@source(IRC_S1355_G, quote = "The period of temporary use under subparagraph (A) continues until the earlier of the date of which—")
rule Section1355g2CEarlierOf(c: Corporation, v: us.irc.core::Asset, on: Date) strict {
    label en official "section 1355(g)(2)(C): the period ends on the earlier of the two dates";
    when temporary_zone_use_end_candidate_1355g2C(c, v, on);
    when not_known(earlier_temporary_zone_use_end_candidate_exists_1355g2C(c, v, on));
    then temporary_zone_use_period_end_1355g2C(c, v, on);
}

// ---- Section 1356(e): electing groups ----

pub relation electing_group_representative_1356e(c: Corporation, rep: Corporation, y: TaxableYear) kind empirical {
    label en unofficial "the corporation is a member of the electing group identified by the representative corporation";
}
pub relation is_in_electing_group_1356e(c: Corporation, y: TaxableYear) kind institutional {
    label en official "the corporation is a member of an electing group for section 1356(e) (helper)";
}
rule Section1356eHelperInGroup(c: Corporation, rep: Corporation, y: TaxableYear) strict {
    label en official "helper";
    when electing_group_representative_1356e(c, rep, y);
    then is_in_electing_group_1356e(c, y);
}
pub relation group_member_core_1356e(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) kind institutional {
    label en official "the core qualifying gross income of a member of the group";
}
rule Section1356eMemberCore(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) strict {
    label en official "section 1356(e): the member's core income is a term of the group figure";
    when electing_group_representative_1356e(m, rep, y);
    when gross_income_core_qualifying_activities_1356b(m, y, amount);
    then group_member_core_1356e(rep, y, m, amount);
}
pub relation group_core_income_1356e(rep: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the core qualifying gross income of the electing group";
}
rule Section1356eGroupCore(rep: Corporation, y: TaxableYear) strict {
    label en official "section 1356(e): the group treated as one entity (a sum over the members: G4903)";
    when group_member_core_1356e(rep, y, _, _);
    then group_core_income_1356e(rep, y, sum all amount: Money for m: Corporation where group_member_core_1356e(rep, y, m, amount));
}
pub relation group_member_secondary_1356e(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) kind institutional {
    label en official "the gross income of a member from secondary activities";
}
rule Section1356eMemberSecondary(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) strict {
    label en official "section 1356(e): the member's secondary income is a term of the group figure";
    when electing_group_representative_1356e(m, rep, y);
    when gross_income_secondary_activities_1356c2(m, y, amount);
    then group_member_secondary_1356e(rep, y, m, amount);
}
pub relation group_secondary_income_1356e(rep: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income of the electing group from secondary activities";
}
rule Section1356eGroupSecondary(rep: Corporation, y: TaxableYear) strict {
    label en official "section 1356(e): the group's secondary income";
    when group_member_secondary_1356e(rep, y, _, _);
    then group_secondary_income_1356e(rep, y, sum all amount: Money for m: Corporation where group_member_secondary_1356e(rep, y, m, amount));
}
pub relation group_secondary_limit_1356e(rep: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "20 percent of the group's core qualifying income (cents HALF_UP)";
}
rule Section1356eGroupSecondaryLimit(rep: Corporation, y: TaxableYear, core: Money) strict {
    label en official "section 1356(c)(1) applied to the group as one entity";
    when group_core_income_1356e(rep, y, core);
    then group_secondary_limit_1356e(rep, y, div_round(core * 20.0, 100.0, 2, "HALF_UP"));
}
pub relation qualifying_secondary_income_group_1356e(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the member's qualifying secondary income: its secondary income within its allocated part of the group limit (allocated by core income, cents HALF_UP)";
}
@source(IRC_S1356_E, quote = "In the case of an electing group, subsections (c)(1) and (d)(3) shall be applied as if such group were 1")
rule Section1356eMemberSecondaryWithinAllocatedLimit(c: Corporation, rep: Corporation, y: TaxableYear, secondary: Money, core: Money, group_core: Money, limit: Money) strict {
    label en official "section 1356(e): the limitation of (c)(1) applied to the group and allocated among the corporations of the group";
    when electing_group_representative_1356e(c, rep, y);
    when gross_income_secondary_activities_1356c2(c, y, secondary);
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when group_core_income_1356e(rep, y, group_core);
    when group_secondary_limit_1356e(rep, y, limit);
    when group_core > 0.00 USD;
    then qualifying_secondary_income_group_1356e(c, y, min(secondary, div_round(limit * (core / 1.00 USD), group_core / 1.00 USD, 2, "HALF_UP")));
}
pub relation group_member_incidental_1356e(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) kind institutional {
    label en official "the gross income of a member from incidental shipping activities";
}
rule Section1356eMemberIncidental(rep: Corporation, y: TaxableYear, m: Corporation, amount: Money) defeasible {
    label en official "section 1356(e): the member's incidental income is a term of the group figure";
    when electing_group_representative_1356e(m, rep, y);
    when gross_income_incidental_shipping_activities_1356d(m, y, amount);
    then group_member_incidental_1356e(rep, y, m, amount);
}
pub relation group_incidental_income_1356e(rep: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the gross income of the electing group from incidental shipping activities";
}
rule Section1356eGroupIncidental(rep: Corporation, y: TaxableYear) defeasible {
    label en official "section 1356(e): the group's incidental income";
    when group_member_incidental_1356e(rep, y, _, _);
    then group_incidental_income_1356e(rep, y, sum all amount: Money for m: Corporation where group_member_incidental_1356e(rep, y, m, amount));
}
pub relation qualifying_incidental_income_group_1356e(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the member's incidental income counts only if the group's incidental income is within 0.1 percent of the group's core income";
}
rule Section1356eIncidentalWithinGroupCeiling(c: Corporation, rep: Corporation, y: TaxableYear, own: Money, group_incidental: Money, group_core: Money) defeasible {
    label en official "section 1356(d)(3) applied to the group as one entity";
    when electing_group_representative_1356e(c, rep, y);
    when gross_income_incidental_shipping_activities_1356d(c, y, own);
    when group_incidental_income_1356e(rep, y, group_incidental);
    when group_core_income_1356e(rep, y, group_core);
    when group_incidental * 1000.0 <= group_core;
    then qualifying_incidental_income_group_1356e(c, y, own);
}
rule Section1356eIncidentalOverGroupCeiling(c: Corporation, rep: Corporation, y: TaxableYear, own: Money, group_incidental: Money, group_core: Money) defeasible {
    label en official "section 1356(d)(3) applied to the group: above the ceiling none qualifies";
    when electing_group_representative_1356e(c, rep, y);
    when gross_income_incidental_shipping_activities_1356d(c, y, own);
    when group_incidental_income_1356e(rep, y, group_incidental);
    when group_core_income_1356e(rep, y, group_core);
    when group_incidental * 1000.0 > group_core;
    then qualifying_incidental_income_group_1356e(c, y, 0.00 USD);
}
rule Section1356aGroupMemberQualifyingIncome(c: Corporation, y: TaxableYear, core: Money, secondary: Money, incidental: Money) defeasible {
    label en official "section 1356(a), (e): a group member's qualifying shipping activities income with the group limits";
    when gross_income_core_qualifying_activities_1356b(c, y, core);
    when qualifying_secondary_income_group_1356e(c, y, secondary);
    when qualifying_incidental_income_group_1356e(c, y, incidental);
    then qualifying_shipping_activities_income_1356a(c, y, (core + secondary) + incidental);
}

// ---- Section 1359(c): persons that would be qualifying vessel operators ----

pub relation non_corporate_person_would_be_qualifying_vessel_operator_1359c(p: Person) kind empirical {
    label en unofficial "the person, not a corporation, would be a qualifying vessel operator were it a corporation";
}
pub relation qualifying_vessel_operator_for_section_1359_1359c(p: Person) kind institutional {
    label en official "the person is a qualifying vessel operator for section 1359: a corporation that is one, or a person that would be were it a corporation (the section 1359 rules of module 16 stay corporation-typed: G5314)";
}
@source(IRC_S1359_C, quote = "includes any person who would be a qualifying vessel operator were such person a corporation.")
rule Section1359cCorporateOperator(c: Corporation) strict {
    label en official "section 1359(c): a qualifying vessel operator is one for section 1359";
    when qualifying_vessel_operator_1355a3(c);
    then qualifying_vessel_operator_for_section_1359_1359c(c);
}
rule Section1359cNonCorporateOperator(p: Person) strict {
    label en official "section 1359(c): the term includes any person who would be a qualifying vessel operator were such person a corporation";
    when non_corporate_person_would_be_qualifying_vessel_operator_1359c(p);
    then qualifying_vessel_operator_for_section_1359_1359c(p);
}
