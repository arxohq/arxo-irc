// Section 846 stage 3b (IRC-09 stage 3b, TECH_GAP reduction), 26.09.2026.
// Status implemented_unverified; nothing here was executed.
//
// METHOD. Module 09 keeps the discount factor of section 846(a)(2) as a case
// figure (the power of the yield curve rate over the payment pattern is not
// computable here, G400/G5306). This module derives what surrounds it:
//   * (a)(1): the sum over accident years by line of business, then over
//     lines of business (sums over derived items: G4903), and the feed of
//     the total into section 832(b)(5)(A)(ii);
//   * (a)(4): the interest rate and the loss payment pattern in force for
//     the calendar year with which the accident year ends are selected from
//     per-calendar-year tables the case supplies (they select the inputs,
//     they do not compute the factor);
//   * (b): the undiscounted unpaid losses, including the (b)(2) restoration
//     of an already discounted annual statement figure when the extent is
//     disclosed, and (e)(2) unpaid loss adjustment expenses;
//   * (e)(1), (3)-(6): the accident year, the annual statement, the line of
//     business with the single multiple peril line, and the accident and
//     health basis of determination.

// ---- Section 846(b), (e)(2): undiscounted unpaid losses ----

use self::{
    IRC_S846_A,
    IRC_S846_B,
    IRC_S846_E,
    Person,
    TaxableYear,
    discounted_unpaid_losses_846_per_accident_year,
    undiscounted_unpaid_losses_846,
    unpaid_losses_on_life_and_discounted_unpaid_losses_end_of_year,
};

pub relation unpaid_losses_excluding_lae_shown_846b1(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unpaid losses shown in the annual statement filed for the year ending with or within the taxable year, without unpaid loss adjustment expenses";
}
pub relation unpaid_loss_adjustment_expenses_shown_846e2(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unpaid loss adjustment expenses shown on the annual statement";
}
pub relation unpaid_lae_shown_846e2(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear) kind institutional {
    label en official "unpaid loss adjustment expenses are shown for the line of business and accident year (helper)";
}
rule Section846e2HelperLaeShown(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) strict {
    label en official "helper";
    when unpaid_loss_adjustment_expenses_shown_846e2(c, y, line_of_business, accident_year, amount);
    then unpaid_lae_shown_846e2(c, y, line_of_business, accident_year);
}
pub relation unpaid_losses_shown_846b1(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, amount: Money) kind institutional {
    label en official "the unpaid losses shown in the annual statement, including unpaid loss adjustment expenses";
}
@source(IRC_S846_E, quote = "includes any unpaid loss adjustment expenses shown on the annual statement.")
rule Section846e2UnpaidLossesIncludeLae(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, losses: Money, lae: Money) strict {
    label en official "section 846(e)(2): unpaid losses include any unpaid loss adjustment expenses shown on the annual statement";
    when unpaid_losses_excluding_lae_shown_846b1(c, y, line_of_business, accident_year, losses);
    when unpaid_loss_adjustment_expenses_shown_846e2(c, y, line_of_business, accident_year, lae);
    then unpaid_losses_shown_846b1(c, y, line_of_business, accident_year, losses + lae);
}
rule Section846e2UnpaidLossesWithoutLae(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, losses: Money) strict {
    label en official "section 846(e)(2): no unpaid loss adjustment expenses shown";
    when unpaid_losses_excluding_lae_shown_846b1(c, y, line_of_business, accident_year, losses);
    when not_known(unpaid_lae_shown_846e2(c, y, line_of_business, accident_year));
    then unpaid_losses_shown_846b1(c, y, line_of_business, accident_year, losses);
}
pub relation shown_amount_determined_on_discounted_basis_846b2A(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear) kind empirical {
    label en unofficial "the amount of unpaid losses shown in the annual statement is determined on a discounted basis";
}
pub relation extent_of_discounting_disclosed_846b2B(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear) kind empirical {
    label en unofficial "the extent to which the losses were discounted can be determined on the basis of information disclosed on or with the annual statement";
}
pub relation discounting_reduction_disclosed_846b2(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, reduction: Money) kind empirical {
    label en unofficial "the reduction attributable to the discounting, as disclosed";
}
@source(IRC_S846_B, quote = "For purposes of this section—")
rule Section846b1UndiscountedAsShown(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, shown: Money) strict {
    label en official "section 846(b)(1): the undiscounted unpaid losses are those shown in the annual statement (unless the annual statement figure is discounted and the extent is disclosed)";
    when unpaid_losses_shown_846b1(c, y, line_of_business, accident_year, shown);
    when not_known(shown_amount_determined_on_discounted_basis_846b2A(c, y, line_of_business, accident_year));
    then undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, shown);
}
rule Section846b1UndiscountedAsShownWhenExtentUnknown(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, shown: Money) strict {
    label en official "section 846(b)(1): a discounted figure whose extent cannot be determined stands as shown";
    when unpaid_losses_shown_846b1(c, y, line_of_business, accident_year, shown);
    when shown_amount_determined_on_discounted_basis_846b2A(c, y, line_of_business, accident_year);
    when not_known(extent_of_discounting_disclosed_846b2B(c, y, line_of_business, accident_year));
    then undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, shown);
}
@source(IRC_S846_B, quote = "If—")
rule Section846b2RestoreDiscounting(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, shown: Money, reduction: Money) strict {
    label en official "section 846(b)(2): a discounted annual statement amount whose discounting is disclosed is determined without regard to the reduction";
    when unpaid_losses_shown_846b1(c, y, line_of_business, accident_year, shown);
    when shown_amount_determined_on_discounted_basis_846b2A(c, y, line_of_business, accident_year);
    when extent_of_discounting_disclosed_846b2B(c, y, line_of_business, accident_year);
    when discounting_reduction_disclosed_846b2(c, y, line_of_business, accident_year, reduction);
    then undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, shown + reduction);
}

// ---- Section 846(a)(4): the applicable rate and pattern ----

pub relation applicable_interest_rate_846c(calendar_year: Integer, rate: Decimal) kind empirical {
    label en unofficial "the interest rate determined under subsection (c) for the calendar year";
}
pub relation loss_payment_pattern_in_effect_846d(calendar_year: Integer, pattern: Text) kind empirical {
    label en unofficial "the loss payment pattern determined under subsection (d) in effect for the calendar year";
}
pub relation selected_interest_rate_846a4A(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, rate: Decimal) kind institutional {
    label en official "the applicable interest rate: that of the calendar year with which the accident year ends";
}
@source(IRC_S846_A, quote = "In determining the amount of the discounted unpaid losses attributable to any accident year—")
rule Section846a4AInterestRate(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, calendar_year: Integer, undiscounted: Money, rate: Decimal) strict {
    label en official "section 846(a)(4)(A): the interest rate of the calendar year with which the accident year ends";
    when undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, undiscounted);
    when us.irc.core::calendar_year_of(accident_year, calendar_year);
    when applicable_interest_rate_846c(calendar_year, rate);
    then selected_interest_rate_846a4A(c, y, line_of_business, accident_year, rate);
}
pub relation selected_loss_payment_pattern_846a4B(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, pattern: Text) kind institutional {
    label en official "the applicable loss payment pattern: the one in effect for the calendar year with which the accident year ends";
}
rule Section846a4BLossPaymentPattern(c: Person, y: TaxableYear, line_of_business: Text, accident_year: TaxableYear, calendar_year: Integer, undiscounted: Money, pattern: Text) strict {
    label en official "section 846(a)(4)(B): the loss payment pattern in effect for the calendar year with which the accident year ends";
    when undiscounted_unpaid_losses_846(c, y, line_of_business, accident_year, undiscounted);
    when us.irc.core::calendar_year_of(accident_year, calendar_year);
    when loss_payment_pattern_in_effect_846d(calendar_year, pattern);
    then selected_loss_payment_pattern_846a4B(c, y, line_of_business, accident_year, pattern);
}

// ---- Section 846(a)(1): the sum over lines of business and accident years ----

pub relation discounted_unpaid_losses_846_by_line(c: Person, y: TaxableYear, line_of_business: Text, amount: Money) kind institutional {
    label en official "the discounted unpaid losses of the line of business, summed over its accident years";
}
rule Section846a1SumOverAccidentYears(c: Person, y: TaxableYear, line_of_business: Text) defeasible {
    label en official "section 846(a)(1): the discounted unpaid losses of a line of business is the sum over its accident years";
    when discounted_unpaid_losses_846_per_accident_year(c, y, line_of_business, _, _);
    then discounted_unpaid_losses_846_by_line(c, y, line_of_business, sum all amount: Money for accident_year: TaxableYear where discounted_unpaid_losses_846_per_accident_year(c, y, line_of_business, accident_year, amount));
}
pub relation discounted_unpaid_losses_846_total(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of the discounted unpaid losses as of the end of the taxable year: the sum over every line of business and accident year";
}
@source(IRC_S846_A, quote = "The amount of the discounted unpaid losses as of the end of any taxable year shall be the sum of the")
rule Section846a1TotalOverLinesOfBusiness(c: Person, y: TaxableYear) defeasible {
    label en official "section 846(a)(1): the discounted unpaid losses at the end of the year is the sum of the per-line figures";
    when discounted_unpaid_losses_846_by_line(c, y, _, _);
    then discounted_unpaid_losses_846_total(c, y, sum all amount: Money for line_of_business: Text where discounted_unpaid_losses_846_by_line(c, y, line_of_business, amount));
}
pub relation unpaid_losses_on_life_insurance_contracts_end_of_year_832b5Aii(c: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the unpaid losses on life insurance contracts outstanding at the end of the taxable year";
}
rule Section832b5AiiUnpaidLossesFromSection846Total(c: Person, y: TaxableYear, life: Money, discounted: Money) defeasible {
    label en official "section 832(b)(5)(A)(ii): the unpaid losses on life insurance contracts plus the discounted unpaid losses (the section 846 total) at the end of the year";
    when unpaid_losses_on_life_insurance_contracts_end_of_year_832b5Aii(c, y, life);
    when discounted_unpaid_losses_846_total(c, y, discounted);
    then unpaid_losses_on_life_and_discounted_unpaid_losses_end_of_year(c, y, life + discounted);
}

// ---- Section 846(e)(1), (3)-(6): definitions ----

pub relation incident_calendar_year_846e1(loss: us.irc.core::Asset, calendar_year: Integer) kind empirical {
    label en unofficial "the calendar year in which the incident occurs which gives rise to the unpaid loss";
}
pub relation accident_year_of_unpaid_loss_846e1(loss: us.irc.core::Asset, calendar_year: Integer) kind institutional {
    label en official "the accident year of the unpaid loss is the calendar year of the incident";
}
@source(IRC_S846_E, quote = "means the calendar year in which the incident occurs which gives rise to the related unpaid loss.")
rule Section846e1AccidentYear(loss: us.irc.core::Asset, calendar_year: Integer) strict {
    label en official "section 846(e)(1): the accident year is the calendar year in which the incident occurs";
    when incident_calendar_year_846e1(loss, calendar_year);
    then accident_year_of_unpaid_loss_846e1(loss, calendar_year);
}
pub relation statement_approved_by_naic_846e3(stmt: us.irc.core::Asset) kind empirical {
    label en unofficial "the statement is approved by the National Association of Insurance Commissioners";
}
pub relation statement_required_to_be_filed_with_state_regulators_846e3(stmt: us.irc.core::Asset) kind empirical {
    label en unofficial "the taxpayer is required to file the statement with insurance regulatory authorities of a State";
}
pub relation annual_statement_846e3(stmt: us.irc.core::Asset) kind institutional {
    label en official "the statement is an annual statement for section 846";
}
@source(IRC_S846_E, quote = "means the annual statement approved by the National Association of Insurance Commissioners which the")
rule Section846e3AnnualStatement(stmt: us.irc.core::Asset) strict {
    label en official "section 846(e)(3): the annual statement approved by the NAIC which the taxpayer must file with State authorities";
    when statement_approved_by_naic_846e3(stmt);
    when statement_required_to_be_filed_with_state_regulators_846e3(stmt);
    then annual_statement_846e3(stmt);
}
pub enum LineCategory846 {
    FarmownersMultiplePeril;
    HomeownersMultiplePeril;
    CommercialMultiplePeril;
    OceanMarine;
    AircraftAllPerils;
    BoilerAndMachinery;
    MultiplePerilCombinedLine;
    OtherReportingCategory;
    label en unofficial "a reporting category of the annual statement for fire and casualty companies, and the single combined multiple peril line";
}
pub relation reported_category_846e4(c: Person, y: TaxableYear, category: LineCategory846) kind empirical {
    label en unofficial "a category for the reporting of loss payment patterns on the annual statement for the calendar year ending with or within the taxable year";
}
pub relation multiple_peril_line_846e5(category: LineCategory846) kind institutional {
    label en official "the category is one of the multiple peril lines";
}
@source(IRC_S846_E, quote = "means the lines of business relating to farmowners multiple peril, homeowners multiple peril, commercial")
rule Section846e5Farmowners(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): farmowners multiple peril";
    when reported_category_846e4(c, y, FarmownersMultiplePeril);
    then multiple_peril_line_846e5(FarmownersMultiplePeril);
}
rule Section846e5Homeowners(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): homeowners multiple peril";
    when reported_category_846e4(c, y, HomeownersMultiplePeril);
    then multiple_peril_line_846e5(HomeownersMultiplePeril);
}
rule Section846e5Commercial(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): commercial multiple peril";
    when reported_category_846e4(c, y, CommercialMultiplePeril);
    then multiple_peril_line_846e5(CommercialMultiplePeril);
}
rule Section846e5OceanMarine(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): ocean marine";
    when reported_category_846e4(c, y, OceanMarine);
    then multiple_peril_line_846e5(OceanMarine);
}
rule Section846e5Aircraft(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): aircraft (all perils)";
    when reported_category_846e4(c, y, AircraftAllPerils);
    then multiple_peril_line_846e5(AircraftAllPerils);
}
rule Section846e5BoilerAndMachinery(c: Person, y: TaxableYear) strict {
    label en official "section 846(e)(5): boiler and machinery";
    when reported_category_846e4(c, y, BoilerAndMachinery);
    then multiple_peril_line_846e5(BoilerAndMachinery);
}
pub relation line_of_business_846e4(c: Person, y: TaxableYear, category: LineCategory846, line: LineCategory846) kind institutional {
    label en official "the line of business of a reported category: the multiple peril lines form a single line";
}
@source(IRC_S846_E, quote = "means a category for the reporting of loss payment patterns determined on the basis of the annual")
rule Section846e4MultiplePerilCombined(c: Person, y: TaxableYear, category: LineCategory846) strict {
    label en official "section 846(e)(4): the multiple peril lines are treated as a single line of business";
    when reported_category_846e4(c, y, category);
    when multiple_peril_line_846e5(category);
    then line_of_business_846e4(c, y, category, MultiplePerilCombinedLine);
}
rule Section846e4OwnLine(c: Person, y: TaxableYear, category: LineCategory846) strict {
    label en official "section 846(e)(4): any other reporting category is its own line of business";
    when reported_category_846e4(c, y, category);
    when not_known(multiple_peril_line_846e5(category));
    then line_of_business_846e4(c, y, category, category);
}
pub enum DiscountingBasis846 {
    BasisLossPaymentPattern;
    BasisSection807dDisabilityIncome;
    BasisMidYearFollowingAccidentYear;
    label en unofficial "the basis of the determination of the discounted unpaid losses";
}
pub relation accident_and_health_line_846e6(c: Person, y: TaxableYear, line_of_business: Text) kind empirical {
    label en unofficial "the line of business is an accident and health insurance line";
}
pub relation credit_disability_line_846e6(c: Person, y: TaxableYear, line_of_business: Text) kind empirical {
    label en unofficial "the accident and health line is credit disability insurance";
}
pub relation disability_income_losses_846e6A(c: Person, y: TaxableYear, line_of_business: Text) kind empirical {
    label en unofficial "the unpaid losses relate to disability income";
}
pub relation discounting_basis_846e6(c: Person, y: TaxableYear, line_of_business: Text, basis: DiscountingBasis846) kind institutional {
    label en official "the basis on which the discounted unpaid losses of the line are determined";
}
@source(IRC_S846_E, quote = "(A) in the case of unpaid losses relating to disability income, by using the general rules prescribed")
rule Section846e6ADisabilityIncome(c: Person, y: TaxableYear, line_of_business: Text) strict {
    label en official "section 846(e)(6)(A): disability income losses of an accident and health line use the section 807(d) rules and the taxpayer's experience table, with the (a)(3) limitation";
    when accident_and_health_line_846e6(c, y, line_of_business);
    when disability_income_losses_846e6A(c, y, line_of_business);
    when not_known(credit_disability_line_846e6(c, y, line_of_business));
    then discounting_basis_846e6(c, y, line_of_business, BasisSection807dDisabilityIncome);
}
@source(IRC_S846_E, quote = "(B) in all other cases, by using an assumption (in lieu of a loss payment pattern) that unpaid losses")
rule Section846e6BMidYearAssumption(c: Person, y: TaxableYear, line_of_business: Text) strict {
    label en official "section 846(e)(6)(B): in all other cases the losses are assumed paid in the middle of the year following the accident year, in lieu of a payment pattern";
    when accident_and_health_line_846e6(c, y, line_of_business);
    when not_known(disability_income_losses_846e6A(c, y, line_of_business));
    when not_known(credit_disability_line_846e6(c, y, line_of_business));
    then discounting_basis_846e6(c, y, line_of_business, BasisMidYearFollowingAccidentYear);
}
@source(IRC_S846_E, quote = "Any determination under subsection (a) with respect to unpaid losses relating to accident and health")
rule Section846e6CreditDisabilityUsesPattern(c: Person, y: TaxableYear, line_of_business: Text) strict {
    label en official "section 846(e)(6): credit disability insurance is outside the special rule and keeps the loss payment pattern";
    when accident_and_health_line_846e6(c, y, line_of_business);
    when credit_disability_line_846e6(c, y, line_of_business);
    then discounting_basis_846e6(c, y, line_of_business, BasisLossPaymentPattern);
}
rule Section846e6OrdinaryLineUsesPattern(c: Person, y: TaxableYear, line_of_business: Text) strict {
    label en official "section 846(a)(2)(C): a line that is not an accident and health line uses the loss payment pattern";
    when undiscounted_unpaid_losses_846(c, y, line_of_business, _, _);
    when not_known(accident_and_health_line_846e6(c, y, line_of_business));
    then discounting_basis_846e6(c, y, line_of_business, BasisLossPaymentPattern);
}
