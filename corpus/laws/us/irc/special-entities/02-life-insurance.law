// Sections 801 (tax on life insurance companies) and 816(a) (life insurance
// company defined: the >50% reserves test). Stage 1 (IRC-09 stage 1, A12),
// priority sections.
//
// METHOD: section 801(a) imposes a tax "computed as provided in section 11
// as though the life insurance company taxable income were the taxable
// income referred to in section 11" — the TAX BASE (life insurance company
// taxable income, section 801(b)) is fully modeled. STAGE 2 (WIRE-2,
// 25.09.2026): the RATE MULTIPLICATION now reads `us.irc.corporations`'s
// `pub corporate_tax_rate(c, y, rate)` export (added by that package's own
// stage 2 for exactly this consumer), rather than a forked private copy of
// the 21 percent constant. `corporate_tax_rate`'s own export rule is keyed
// to `us.irc.corporations::taxable_income(c, y, income)` being known for
// the SAME (company, year) pair (it does not gate on the VALUE, only on
// the fact's presence, since the rate is a single flat constant for every
// corporation in the current era) — a consuming scenario therefore asserts
// that foreign fact (any amount) for the life insurance company/year pair
// to unlock the rate for the SAME key its own section 801 computation uses;
// see `tests/s801-s816-life-insurance.lawtest` for the pattern. This is not
// a private copy of the rate and does not affect the real corporate-tax
// relation for the same corporation under section 11(a)/(b), because a life
// insurance company is excluded from the ordinary section 11(a) tax by
// section 11(c)(2) (subchapter L) whenever `subject_to_subchapter_l_tax` is
// also asserted there. The tax amount below is typed `c: Corporation` (not
// the module's general `Person`) because `corporate_tax_rate` itself is
// typed to `Corporation`; the general life-insurance-company-taxable-income
// base above stays `Person`-typed and widens into this rule without loss.
// STAGE 2b (25.09.2026): section 803 (gross income items) and sections 804-
// 805 (deductions) are now modeled in `07-reserves-and-general-rules.law`
// (§807's reserve rules feed both §803(a)(2)'s decrease-in-reserves item and
// §805(a)(2)'s increase-in-reserves item); `life_insurance_gross_income`/
// `life_insurance_deductions` below are now derived (kind institutional)
// from those components, while remaining directly assertable as a case
// fact (per this corpus's own convention for overriding a derived
// institutional relation directly in a test — see the header of
// `01-banks.law`'s section 585(b)(2) note for the same pattern and its
// precedent, `regulated_investment_company`).
//
// Section 816(a)'s ">50% of total reserves" test is modeled as an exact
// cross-multiplied comparison over case-asserted reserve figures (no
// division), per the method's "percentage tests as exact comparisons by
// cross-multiplication" rule. Section 816(b)-(h) (the components "life
// insurance reserves" and "total reserves" are themselves defined) are NOT
// modeled at this stage; their outputs are asserted as case facts.

use self::{
    Corporation,
    IRC_S801_A,
    IRC_S801_B,
    IRC_S816_A,
    Person,
    TaxableYear,
};

@source(IRC_S801_B, quote = "For purposes of this part, the term \"life insurance company taxable income\" means—\n(1) life insurance gross income, reduced by\n(2) life insurance deductions.")
pub relation life_insurance_gross_income(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "life insurance gross income for the taxable year, per section 803 (derived in 07-reserves-and-general-rules.law, STAGE 2b)";
}
pub relation life_insurance_deductions(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "life insurance deductions for the taxable year, per section 804 (derived in 07-reserves-and-general-rules.law, STAGE 2b)";
}
@source(IRC_S801_B, quote = "the term \"life insurance company taxable income\" means—\n(1) life insurance gross income, reduced by\n(2) life insurance deductions")
pub relation life_insurance_company_taxable_income(c: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "life insurance company taxable income for the taxable year: life insurance gross income reduced by life insurance deductions (section 801(b))";
}
rule Section801bLifeInsuranceCompanyTaxableIncome(c: Person, y: TaxableYear, gross: Money, deductions: Money) defeasible {
    label en official "section 801(b): life insurance company taxable income equals life insurance gross income minus life insurance deductions";
    when life_insurance_gross_income(c, y, gross);
    when life_insurance_deductions(c, y, deductions);
    then life_insurance_company_taxable_income(c, y, gross - deductions);
}
// Section 801(a): the rate step, wired to `us.irc.corporations`'s stage 2
// `pub corporate_tax_rate` export (see module header; STAGE 2, WIRE-2).
@source(IRC_S801_A, quote = "Such tax shall consist of a tax computed as provided in section 11 as though the life insurance company taxable income were the taxable income referred to in section 11.")
pub relation life_insurance_company_tax(c: Corporation, y: TaxableYear, amount: Money) kind institutional {
    label en official "the tax imposed by section 801(a): the life insurance company taxable income taxed at the section 11(b) rate, as though it were section 11 taxable income";
}
rule Section801aLifeInsuranceCompanyTax(c: Corporation, y: TaxableYear, income: Money, rate: Decimal) defeasible {
    label en official "section 801(a): the tax is the section 11(b) rate applied to the life insurance company taxable income";
    when life_insurance_company_taxable_income(c, y, income);
    when us.irc.corporations::corporate_tax_rate(c, y, rate);
    then life_insurance_company_tax(c, y, round(income * rate, 2, "HALF_UP"));
}

// Section 816(a): the >50% reserves test.
@source(IRC_S816_A, quote = "an insurance company which is engaged in the business of issuing life insurance and annuity contracts (either separately or combined with accident and health insurance), or noncancellable contracts of health and accident insurance")
pub relation issues_life_insurance_or_annuity_contracts(p: Person) kind empirical {
    label en unofficial "engaged in the business of issuing life insurance and annuity contracts (alone or combined with accident and health insurance), or noncancellable accident and health contracts, per section 816(a)";
}
@source(IRC_S816_A, quote = "the term \"insurance company\" means any company more than half of the business of which during the taxable year is the issuing of insurance or annuity contracts or the reinsuring of risks underwritten by insurance companies")
pub relation insurance_company_by_816a(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "more than half of the company's business during the taxable year is issuing insurance or annuity contracts or reinsuring risks underwritten by insurance companies, per section 816(a)'s definition of \"insurance company\"";
}
@source(IRC_S816_A, quote = "its life insurance reserves (as defined in subsection (b))")
pub relation life_insurance_reserves(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "life insurance reserves as defined in section 816(b) (not modeled at this stage)";
}
@source(IRC_S816_A, quote = "unearned premiums, and unpaid losses (whether or not ascertained), on noncancellable life, accident, or health policies not included in life insurance reserves")
pub relation unearned_premiums_and_unpaid_losses_not_in_reserves(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "unearned premiums and unpaid losses on noncancellable life, accident, or health policies not included in life insurance reserves, per section 816(a)(2)";
}
@source(IRC_S816_A, quote = "total reserves (as defined in subsection (c))")
pub relation total_reserves_816c(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "total reserves as defined in section 816(c) (not modeled at this stage)";
}
@source(IRC_S816_A, quote = "comprise more than 50 percent of its total reserves")
pub relation life_insurance_reserves_ratio_test_met(p: Person, y: TaxableYear) kind institutional {
    label en official "life insurance reserves plus qualifying unearned premiums/unpaid losses comprise more than 50 percent of total reserves, per section 816(a)";
}
rule Section816aReservesRatioTest(p: Person, y: TaxableYear, reserves: Money, unearned: Money, total: Money) strict {
    label en official "section 816(a): (life insurance reserves + qualifying unearned premiums/unpaid losses) * 100 > total reserves * 50";
    when life_insurance_reserves(p, y, reserves);
    when unearned_premiums_and_unpaid_losses_not_in_reserves(p, y, unearned);
    when total_reserves_816c(p, y, total);
    when (reserves + unearned) * 100 > total * 50;
    then life_insurance_reserves_ratio_test_met(p, y);
}
@source(IRC_S816_A, quote = "the term \"life insurance company\" means an insurance company which is engaged in the business of issuing life insurance and annuity contracts (either separately or combined with accident and health insurance), or noncancellable contracts of health and accident insurance, if—\n(1) its life insurance reserves (as defined in subsection (b)), plus\n(2) unearned premiums, and unpaid losses (whether or not ascertained), on noncancellable life, accident, or health policies not included in life insurance reserves,\ncomprise more than 50 percent of its total reserves (as defined in subsection (c)).")
pub relation life_insurance_company(p: Person, y: TaxableYear) kind institutional {
    label en official "a life insurance company within the meaning of section 816(a), for the taxable year";
}
rule Section816aLifeInsuranceCompanyDefined(p: Person, y: TaxableYear) strict {
    label en official "section 816(a): an insurance company issuing life/annuity (or noncancellable health/accident) contracts whose reserves ratio test is met is a life insurance company";
    when insurance_company_by_816a(p, y);
    when issues_life_insurance_or_annuity_contracts(p);
    when life_insurance_reserves_ratio_test_met(p, y);
    then life_insurance_company(p, y);
}
