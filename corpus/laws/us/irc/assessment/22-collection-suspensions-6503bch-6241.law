// Assessment -- WIRE-7 (26.09.2026, DECISION-0379, implemented_unverified): the collection-side suspensions of section 6503(b), (c), (h)(2) and
// section 6241(6)(A)(ii) (the section 6502 collection period).
//
// The four coverage rows named `collection` as their owner ("do not model section 6502", "the collection-side branch is `collection`'s own
// norm"). The section 6502 clock and its suspension relation `collection_period_suspension` live in THIS package (modules 06, 16, 21), and
// `collection` imports `assessment`, so the owner could never host them; the rows are closed here, in the package that owns the clock.
//
// JUDGMENT CALLS.
//  - (b): the suspension runs from the start of the custody to the end of the custody plus 6 months ("and for 6 months thereafter"); the
//    custody dates are case inputs keyed by the assessment.
//  - (c): the absence must be "a continuous period of at least 6 months": the rule fires only when the return date is not earlier than the
//    departure date plus 6 months; the suspension covers the absence. The second sentence of (c) (the period shall not expire before 6
//    months after the return) is a floor on `collection_period_ends`, not a suspension, and is NOT modeled (coverage stays partial).
//  - (h)(2): the collection side mirrors the assessment side of `05-suspension.law` (60 days there, 6 months here); it reads the same
//    title 11 case facts (`bankruptcy_case_started`, `bankruptcy_case_pending`), joined to the assessment through `core::assessment_of`.
//    Title 11 itself stays outside Title 26 (the case facts are the interface).
//  - 6241(6)(A)(ii): the same 6-month extension for the collection of an imputed underpayment assessed against the partnership, read from
//    the partnership-level case facts of module 07 (`bankruptcy_case_started_bba`).

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    Assessment,
    CollectionSuspensionKind,
    IRC_S6241,
    IRC_S6503_B,
    IRC_S6503_C,
    IRC_S6503_H,
    Partnership,
    Person,
    bankruptcy_case_pending,
    bankruptcy_case_started,
    bankruptcy_case_started_bba,
    collection_period_suspension,
};

pub relation assets_in_court_custody(a: Assessment, start: Date, end: Date) kind empirical {
    label en official "the assets of the taxpayer are in the control or custody of the court in a proceeding before any court of the United States or of any State or of the District of Columbia, from start to end (section 6503(b))";
}
@source(IRC_S6503_B, relation = formalizes, coverage = partial, quote = "The period of limitations on collection after assessment prescribed in section 6502 shall be suspended for the period the assets of the taxpayer are in the control or custody of the court in any proceeding before any court of the United States or of any State or of the District of Columbia, and for 6 months thereafter.")
rule S6503bCourtCustodySuspendsCollection defeasible {
    label en official "the collection period is suspended while the taxpayer's assets are in the custody of a court, and for 6 months thereafter";
    for a: Assessment;
    for start: Date;
    for end: Date;
    when assets_in_court_custody(a, start, end);
    then collection_period_suspension(a, CourtCustody6503b, start, add_calendar_period(end, 6 calendar_month));
}

pub relation taxpayer_outside_united_states(a: Assessment, left: Date, returned: Date) kind empirical {
    label en official "the taxpayer is outside the United States from the departure date to the return date (section 6503(c))";
}
@source(IRC_S6503_C, relation = formalizes, coverage = partial, quote = "The running of the period of limitations on collection after assessment prescribed in section 6502 shall be suspended for the period during which the taxpayer is outside the United States if such period of absence is for a continuous period of at least 6 months.")
rule S6503cAbsenceOfAtLeastSixMonthsSuspendsCollection defeasible {
    label en official "the collection period is suspended for an absence from the United States of a continuous period of at least 6 months";
    for a: Assessment;
    for left: Date;
    for returned: Date;
    when taxpayer_outside_united_states(a, left, returned)
        and returned >= add_calendar_period(left, 6 calendar_month);
    then collection_period_suspension(a, AbsenceFromUnitedStates6503c, left, returned);
}

@source(IRC_S6503_H, relation = formalizes, coverage = partial, quote = "(2) for collection, 6 months thereafter.")
rule S6503h2BankruptcySuspendsCollectionPlusSixMonths defeasible {
    label en official "in a title 11 case the collection period is suspended while the Secretary is prohibited from collecting, and for 6 months thereafter";
    for a: Assessment;
    for p: Person;
    for start: Date;
    for prohibitedThrough: Date;
    when us.irc.core::assessment_of(a, p, _, _, _)
        and bankruptcy_case_started(p, start)
        and bankruptcy_case_pending(p, prohibitedThrough);
    then collection_period_suspension(a, BankruptcyProhibition6503h, start, add_calendar_period(prohibitedThrough, 6 calendar_month));
}

@source(IRC_S6241, relation = formalizes, coverage = partial, quote = "(ii) for collection, 6 months thereafter.")
rule S6241p6AiiBbaBankruptcySuspendsCollectionPlusSixMonths defeasible {
    label en official "in a title 11 case of a partnership the collection period of an imputed underpayment is suspended while the Secretary is prohibited from collecting, and for 6 months thereafter";
    for a: Assessment;
    for pship: Partnership;
    for start: Date;
    for prohibitedThrough: Date;
    when us.irc.core::assessment_of(a, pship, _, _, _)
        and bankruptcy_case_started_bba(pship, start)
        and bankruptcy_case_pending(pship, prohibitedThrough);
    then collection_period_suspension(a, BbaBankruptcyProhibition6241, start, add_calendar_period(prohibitedThrough, 6 calendar_month));
}
