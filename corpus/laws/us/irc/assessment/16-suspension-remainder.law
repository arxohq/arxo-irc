// §6503 — the suspensions that stages 1-3 left as TECH_GAP
// (stage 4, 26.09.2026, DECISION-0379, implemented_unverified).
//
// Covered here: (d) estate-tax payment extensions, (e) foreign expropriation
// loss recoveries, (f)(1)-(2) wrongful seizure and wrongful lien, (g)
// suspension pending correction, (i) PFIC earnings tax extensions, and the
// whole of (j) (designated summons: definition (j)(2), judicial enforcement
// period (j)(3), the two suspensions and the 60-day floor of (j)(1), the
// burden of (j)(4)).
//
// METHOD.
//  - A suspension of the §6502 COLLECTION period is a fact about an
//    assessment: `collection_period_suspension(a, origin, start, end)`, with an
//    optional `collection_period_suspension_limited_to(a, origin, limit)` for
//    the amount-limited suspensions of (f). A suspension of the §6501
//    ASSESSMENT period is a `suspension_period` interval (module 05), so the
//    union-of-intervals count of that module reads it unchanged.
//  - "Earlier of" (f)(2)(A)/(B): G136 pattern (candidates + "no strictly
//    earlier candidate").
//  - (j)(2)(B): "a prior summons ... was treated as a designated summons" is
//    the case fact `prior_summons_treated_as_designated`: deriving it would make
//    `designated_summons` depend on itself across summonses (LDC-E4102).
//  - (j)(2)(A)(ii): the period end "determined with regard to extensions" is a
//    case-supplied date (`assessment_period_end_at_issue`): the package has no
//    max-over-derived (module 04 header).
//
// JUDGMENT CALLS.
//  - (j)(1)(A)(ii): "the 30-day period which begins on the date" is read as the
//    issue date and the 29 days after it.
//  - (j)(1)(B): "the 120-day period beginning with the 1st day after the close"
//    is the interval [end + 1 day, end + 120 days].
//  - (f)(1): the two closing events ("returns property pursuant to 6343(b)" or
//    "judgment becomes final") each end a suspension interval; the case
//    asserts the one that occurred.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    Assessment,
    IRC_S6503_D,
    IRC_S6503_E,
    IRC_S6503_F,
    IRC_S6503_G,
    IRC_S6503_I,
    IRC_S6503_J,
    Person,
    Secretary,
    SuspendingEventKind,
    TaxKind,
    TaxableYear,
    assessment_period_ends,
    suspension_period,
};

// ============================================================================
// Collection-period suspensions: the shared relation
// ============================================================================

pub enum CollectionSuspensionKind {
    EstatePaymentExtension;         // §6503(d)
    ForeignExpropriationExtension;  // §6503(e)
    WrongfulSeizure;                // §6503(f)(1)
    WrongfulLien;                   // §6503(f)(2)
    ChapterFortyTwoCorrection;      // §6503(g)
    PficPaymentExtension;           // §6503(i)
    InsolventBankBar;               // §7507(c)(4) — module 21
    CourtCustody6503b;              // §6503(b) — module 22 (WIRE-7)
    AbsenceFromUnitedStates6503c;   // §6503(c) — module 22 (WIRE-7)
    BankruptcyProhibition6503h;     // §6503(h)(2) — module 22 (WIRE-7)
    BbaBankruptcyProhibition6241;   // §6241(6)(A)(ii) — module 22 (WIRE-7)
    TfrpCollectionStay6672c4;        // §6672(c)(4) — fed by us.irc.penalties (WIRE-10 A)
    PreparerPenaltyCollectionStay6694c3; // §6694(c)(3) — fed by us.irc.penalties (WIRE-10 A)
    AbusivePenaltyCollectionStay6703c3;  // §6703(c)(3) — fed by us.irc.penalties (WIRE-10 A)
    label en unofficial "which §6503 provision suspended the §6502 collection period";
}
pub relation collection_period_suspension(a: Assessment, origin: CollectionSuspensionKind, start: Date, end: Date) kind institutional {
    label en unofficial "an interval during which the §6502 collection period does not run for the assessment";
}
pub relation collection_period_suspension_limited_to(a: Assessment, origin: CollectionSuspensionKind, limit: Money) kind institutional {
    label en unofficial "the suspension applies only to this amount of the assessment (§6503(f)(1) money or value of property returned; (f)(2) value of the United States interest plus related interest, penalties, additions)";
}

// --- (d) — estate tax payment extensions -----------------------------------

pub enum EstatePaymentExtensionSection {
    Sec6161a2;
    Sec6161b2;
    Sec6163;
    Sec6166;
    label en unofficial "the extension provisions of section 6503(d)";
}
pub relation estate_tax_payment_extension_period(a: Assessment, section: EstatePaymentExtensionSection, start: Date, end: Date) kind empirical {
    label en official "the period of any extension of time for payment granted under section 6161(a)(2) or (b)(2), 6163 or 6166";
}
@source(IRC_S6503_D, relation = formalizes, coverage = exact, quote = "The running of the period of limitation for collection of any tax imposed by chapter 11 shall be suspended for the period of any extension of time for payment granted under the provisions of section 6161(a)(2) or (b)(2) or under the provisions of section 6163 or 6166.")
rule S6503DEstatePaymentExtensionSuspendsCollection defeasible {
    label en official "the collection period of a chapter 11 tax is suspended for the period of an extension of time for payment under 6161(a)(2), (b)(2), 6163 or 6166";
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for section: EstatePaymentExtensionSection;
    for start: Date;
    for end: Date;
    when us.irc.core::assessment_of(a, p, y, us.irc.core::EstateCh11, amount)
        and estate_tax_payment_extension_period(a, section, start, end);
    then collection_period_suspension(a, EstatePaymentExtension, start, end);
}

// --- (e) — foreign expropriation loss recoveries ---------------------------

pub relation assessment_attributable_to_foreign_expropriation_loss_recovery(a: Assessment) kind empirical {
    label en official "the tax attributable to a recovery of a foreign expropriation loss (within the meaning of section 6167(f))";
}
pub relation section_6167_payment_extension_period(a: Assessment, start: Date, end: Date) kind empirical {
    label en official "the period of any extension of time for payment under subsection (a) or (b) of section 6167";
}
@source(IRC_S6503_E, relation = formalizes, coverage = exact, quote = "shall be suspended for the period of any extension of time for payment under subsection (a) or (b) of section 6167.")
rule S6503EForeignExpropriationExtensionSuspendsCollection defeasible {
    label en official "the collection period of the tax attributable to a foreign expropriation loss recovery is suspended for the section 6167 extension period";
    for a: Assessment;
    for start: Date;
    for end: Date;
    when assessment_attributable_to_foreign_expropriation_loss_recovery(a)
        and section_6167_payment_extension_period(a, start, end);
    then collection_period_suspension(a, ForeignExpropriationExtension, start, end);
}

// --- (i) — undistributed PFIC earnings tax liability -----------------------

pub relation assessment_is_undistributed_pfic_earnings_liability(a: Assessment) kind empirical {
    label en official "the amount is undistributed PFIC earnings tax liability (as defined in section 1294(b))";
}
pub relation section_1294_payment_extension_period(a: Assessment, start: Date, end: Date) kind empirical {
    label en official "the period of any extension of time under section 1294 for payment of such amount";
}
@source(IRC_S6503_I, relation = formalizes, coverage = exact, quote = "shall be suspended for the period of any extension of time under section 1294 for payment of such amount.")
rule S6503IPficExtensionSuspendsCollection defeasible {
    label en official "the collection period of undistributed PFIC earnings tax liability is suspended for the period of a section 1294 extension";
    for a: Assessment;
    for start: Date;
    for end: Date;
    when assessment_is_undistributed_pfic_earnings_liability(a)
        and section_1294_payment_extension_period(a, start, end);
    then collection_period_suspension(a, PficPaymentExtension, start, end);
}

// --- (f)(1) — wrongful seizure ---------------------------------------------

pub relation third_party_property_wrongfully_seized_or_received(a: Assessment, seizedOn: Date) kind empirical {
    label en official "property (including money) of a third party is wrongfully seized or received by the Secretary in collecting the assessment";
}
pub relation seized_property_returned_under_6343b(a: Assessment, returnedOn: Date, valueReturned: Money) kind empirical {
    label en official "the Secretary returns property pursuant to section 6343(b) (money, or the value of specific property, returned)";
}
pub relation seized_property_judgment_under_7426_final(a: Assessment, finalOn: Date, valueReturned: Money) kind empirical {
    label en official "a judgment secured pursuant to section 7426 with respect to such property becomes final (money, or the value of specific property, returned)";
}
@source(IRC_S6503_F, relation = formalizes, coverage = exact, quote = "The running of the period under section 6502 shall be suspended for a period equal to the period from the date property (including money) of a third party is wrongfully seized or received by the Secretary to the date the Secretary returns property pursuant to section 6343(b)")
rule S6503F1WrongfulSeizureSuspensionUntilReturn defeasible {
    label en official "the section 6502 period is suspended from the wrongful seizure until the Secretary returns the property, and for 30 days thereafter";
    for a: Assessment;
    for seizedOn: Date;
    for returnedOn: Date;
    for valueReturned: Money;
    when third_party_property_wrongfully_seized_or_received(a, seizedOn)
        and seized_property_returned_under_6343b(a, returnedOn, valueReturned);
    then collection_period_suspension(a, WrongfulSeizure, seizedOn, add_calendar_period(returnedOn, 30 calendar_day));
    then collection_period_suspension_limited_to(a, WrongfulSeizure, valueReturned);
}
@source(IRC_S6503_F, relation = formalizes, coverage = exact, quote = "or the date on which a judgment secured pursuant to section 7426 with respect to such property becomes final, and for 30 days thereafter.")
rule S6503F1WrongfulSeizureSuspensionUntilJudgmentFinal defeasible {
    label en official "the section 6502 period is suspended from the wrongful seizure until the section 7426 judgment becomes final, and for 30 days thereafter";
    for a: Assessment;
    for seizedOn: Date;
    for finalOn: Date;
    for valueReturned: Money;
    when third_party_property_wrongfully_seized_or_received(a, seizedOn)
        and seized_property_judgment_under_7426_final(a, finalOn, valueReturned);
    then collection_period_suspension(a, WrongfulSeizure, seizedOn, add_calendar_period(finalOn, 30 calendar_day));
    then collection_period_suspension_limited_to(a, WrongfulSeizure, valueReturned);
}

// --- (f)(2) — wrongful lien ------------------------------------------------

pub relation lien_made_on_property_for_assessment(a: Assessment) kind empirical {
    label en official "a lien was made on any property for the assessment";
}
pub relation person_becomes_entitled_to_6325b4_certificate_on(a: Assessment, entitledOn: Date) kind empirical {
    label en official "a person becomes entitled to a certificate under section 6325(b)(4) with respect to the property";
}
pub relation secretary_no_longer_holds_deposit_or_bond_on(a: Assessment, releasedOn: Date) kind empirical {
    label en official "the Secretary no longer holds any amount as a deposit or bond provided under section 6325(b)(4) by reason of its being used to satisfy the unpaid tax or being refunded or released";
}
pub relation judgment_under_7426b5_final_on(a: Assessment, finalOn: Date) kind empirical {
    label en official "the judgment secured under section 7426(b)(5) becomes final";
}
pub relation lien_value_of_united_states_interest_and_related_amounts(a: Assessment, amount: Money) kind empirical {
    label en official "the value of the interest of the United States in the property plus interest, penalties, additions to the tax, and additional amounts attributable thereto";
}
pub relation deposit_release_strictly_earlier_than_judgment(a: Assessment, judgmentOn: Date) kind institutional {
    label en unofficial "G136 pattern: a deposit release date strictly earlier than the given judgment date exists";
}
rule S6503F2DepositReleaseEarlierThanJudgment defeasible {
    for a: Assessment;
    for releasedOn: Date;
    for judgmentOn: Date;
    when secretary_no_longer_holds_deposit_or_bond_on(a, releasedOn)
        and judgment_under_7426b5_final_on(a, judgmentOn)
        and releasedOn < judgmentOn;
    then deposit_release_strictly_earlier_than_judgment(a, judgmentOn);
}
pub relation judgment_not_later_than_deposit_release(a: Assessment, releasedOn: Date) kind institutional {
    label en unofficial "G136 pattern: a judgment date on or before the given deposit release date exists";
}
rule S6503F2JudgmentNotLaterThanDepositRelease defeasible {
    for a: Assessment;
    for releasedOn: Date;
    for judgmentOn: Date;
    when secretary_no_longer_holds_deposit_or_bond_on(a, releasedOn)
        and judgment_under_7426b5_final_on(a, judgmentOn)
        and judgmentOn <= releasedOn;
    then judgment_not_later_than_deposit_release(a, releasedOn);
}
@source(IRC_S6503_F, relation = formalizes, coverage = exact, quote = "(A) the earliest date on which the Secretary no longer holds any amount as a deposit or bond provided under section 6325(b)(4) by reason of such deposit or bond being used to satisfy the unpaid tax or being refunded or released; or")
rule S6503F2WrongfulLienSuspensionEndsAfterDepositRelease defeasible {
    label en official "the wrongful lien suspension ends 30 days after the deposit or bond release when that is the earlier event";
    for a: Assessment;
    for entitledOn: Date;
    for releasedOn: Date;
    for amount: Money;
    when lien_made_on_property_for_assessment(a)
        and person_becomes_entitled_to_6325b4_certificate_on(a, entitledOn)
        and secretary_no_longer_holds_deposit_or_bond_on(a, releasedOn)
        and lien_value_of_united_states_interest_and_related_amounts(a, amount)
        and not_known(judgment_not_later_than_deposit_release(a, releasedOn));
    then collection_period_suspension(a, WrongfulLien, entitledOn, add_calendar_period(releasedOn, 30 calendar_day));
    then collection_period_suspension_limited_to(a, WrongfulLien, amount);
}
@source(IRC_S6503_F, relation = formalizes, coverage = exact, quote = "(B) the date that the judgment secured under section 7426(b)(5) becomes final.")
rule S6503F2WrongfulLienSuspensionEndsAfterJudgmentFinal defeasible {
    label en official "the wrongful lien suspension ends 30 days after the section 7426(b)(5) judgment becomes final when that is the earlier event";
    for a: Assessment;
    for entitledOn: Date;
    for judgmentOn: Date;
    for amount: Money;
    when lien_made_on_property_for_assessment(a)
        and person_becomes_entitled_to_6325b4_certificate_on(a, entitledOn)
        and judgment_under_7426b5_final_on(a, judgmentOn)
        and lien_value_of_united_states_interest_and_related_amounts(a, amount)
        and not_known(deposit_release_strictly_earlier_than_judgment(a, judgmentOn));
    then collection_period_suspension(a, WrongfulLien, entitledOn, add_calendar_period(judgmentOn, 30 calendar_day));
    then collection_period_suspension_limited_to(a, WrongfulLien, amount);
}

// --- (g) — suspension pending correction -----------------------------------

pub relation chapter_42_507_4971_4975_tax(p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "a tax imposed by chapter 42 or section 507, 4971 or 4975";
}
pub relation correction_period_described_in_507g2_or_4963e(p: Person, y: TaxableYear, k: TaxKind, start: Date, end: Date) kind empirical {
    label en official "a period described in section 507(g)(2), or during which the Secretary has extended the time for making correction under section 4963(e)";
}
@source(IRC_S6503_G, relation = formalizes, coverage = exact, quote = "shall be suspended for any period described in section 507(g)(2) or during which the Secretary has extended the time for making correction under section 4963(e).")
rule S6503GCorrectionPeriodSuspendsAssessment defeasible {
    label en official "the section 6501 period on a chapter 42, 507, 4971 or 4975 tax is suspended during a section 507(g)(2) or 4963(e) correction period";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when chapter_42_507_4971_4975_tax(p, y, k)
        and correction_period_described_in_507g2_or_4963e(p, y, k, start, end);
    then suspension_period(p, y, k, ChapterFortyTwoCorrection, start, end);
}
@source(IRC_S6503_G, relation = formalizes, coverage = exact, quote = "The running of the periods of limitations provided in sections 6501 and 6502 on the making of assessments or the collection by levy or a proceeding in court in respect of any tax imposed by chapter 42 or section 507, 4971, or 4975")
rule S6503GCorrectionPeriodSuspendsCollection defeasible {
    label en official "the section 6502 period on a chapter 42, 507, 4971 or 4975 tax is suspended during a section 507(g)(2) or 4963(e) correction period";
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for start: Date;
    for end: Date;
    when us.irc.core::assessment_of(a, p, y, k, amount)
        and chapter_42_507_4971_4975_tax(p, y, k)
        and correction_period_described_in_507g2_or_4963e(p, y, k, start, end);
    then collection_period_suspension(a, ChapterFortyTwoCorrection, start, end);
}

// ============================================================================
// (j) — designated summons
// ============================================================================

pub entity Summons { label en unofficial "a summons issued by the Secretary under chapter 78"; }
pub relation summons_issued_to_corporation_on(s: Summons, corporation: Person, issuedOn: Date) kind empirical {
    label en official "a summons issued by the Secretary to a corporation (or to any other person to whom the corporation has transferred records)";
}
pub relation summons_relates_to_return_of(s: Summons, p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "the summons relates to a return of tax by the corporation for a taxable year (or other period)";
}
pub relation summons_for_determining_tax_amount(s: Summons) kind empirical {
    label en official "the summons is issued for purposes of determining the amount of any tax imposed by this title";
}
pub relation corporation_examined_under_coordinated_industry_case_program(p: Person, y: TaxableYear) kind empirical {
    label en official "the corporation is being examined for the taxable year under the coordinated industry case program (or any successor program) of the Internal Revenue Service";
}
pub relation issuance_reviewed_and_approved_in_writing(s: Summons) kind empirical {
    label en official "the issuance is preceded by a review and written approval by the Commissioner of the relevant operating division of the Internal Revenue Service and the Chief Counsel";
}
pub relation approval_states_reasonable_requests_facts(s: Summons) kind empirical {
    label en official "the review and approval state facts clearly establishing that the Secretary has made reasonable requests for the information that is the subject of the summons";
}
pub relation approval_attached_to_summons(s: Summons) kind empirical {
    label en official "the review and approval is attached to the summons";
}
pub relation assessment_period_end_at_issue(s: Summons, periodEnd: Date) kind empirical {
    label en unofficial "the day on which the section 6501 assessment period for the tax expires, determined with regard to extensions, as of the issuance of the summons (case-supplied; the package has no max over derived tuples)";
}
pub relation summons_states_it_is_designated(s: Summons) kind empirical {
    label en official "the summons clearly states that it is a designated summons for purposes of section 6503(j)";
}
pub relation prior_summons_treated_as_designated(s: Summons) kind empirical {
    label en official "a prior summons which relates to the same return was treated as a designated summons for purposes of section 6503(j)";
}
pub relation issued_at_least_60_days_before_period_expires(s: Summons) kind institutional {
    label en unofficial "the summons is issued at least 60 days before the day on which the section 6501 period expires (determined with regard to extensions)";
}
rule S6503J2AIiSixtyDaysBeforeExpiry defeasible {
    for s: Summons;
    for corporation: Person;
    for issuedOn: Date;
    for periodEnd: Date;
    when summons_issued_to_corporation_on(s, corporation, issuedOn)
        and assessment_period_end_at_issue(s, periodEnd)
        and days_between(issuedOn, periodEnd) >= 60;
    then issued_at_least_60_days_before_period_expires(s);
}
pub relation designated_summons(s: Summons) kind institutional {
    label en official "a designated summons: a summons issued for purposes of determining the amount of any tax if (i) its issuance is preceded by the review and written approval that states the reasonable-requests facts and is attached, (ii) it is issued at least 60 days before the section 6501 period expires, and (iii) it clearly states that it is a designated summons; not a designated summons if a prior summons relating to the same return was treated as one";
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "The term \"designated summons\" means any summons issued for purposes of determining the amount of any tax imposed by this title if—")
rule S6503J2ADesignatedSummons defeasible {
    label en official "a summons meeting (A)(i)-(iii) is a designated summons unless (B) excludes it";
    for s: Summons;
    when summons_for_determining_tax_amount(s)
        and issuance_reviewed_and_approved_in_writing(s)
        and approval_states_reasonable_requests_facts(s)
        and approval_attached_to_summons(s)
        and issued_at_least_60_days_before_period_expires(s)
        and summons_states_it_is_designated(s)
        and not_known(prior_summons_treated_as_designated(s));
    then designated_summons(s);
}
pub relation court_proceeding_on_summons_brought_on(s: Summons, broughtOn: Date) kind empirical {
    label en official "a court proceeding with respect to the summons is brought";
}
pub relation final_resolution_of_summoned_persons_response_on(s: Summons, resolvedOn: Date) kind empirical {
    label en official "there is a final resolution as to the summoned person's response to the summons";
}
pub relation judicial_enforcement_period(s: Summons, start: Date, end: Date) kind institutional {
    label en official "the period which begins on the day a court proceeding with respect to the summons is brought and ends on the day there is a final resolution as to the summoned person's response";
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "the term \"judicial enforcement period\" means, with respect to any summons, the period—")
rule S6503J3JudicialEnforcementPeriod defeasible {
    label en official "the judicial enforcement period runs from the day the court proceeding is brought to the day of final resolution of the summoned person's response";
    for s: Summons;
    for broughtOn: Date;
    for resolvedOn: Date;
    when court_proceeding_on_summons_brought_on(s, broughtOn)
        and final_resolution_of_summoned_persons_response_on(s, resolvedOn);
    then judicial_enforcement_period(s, broughtOn, resolvedOn);
}
pub relation designated_summons_enforcement_interval(p: Person, y: TaxableYear, k: TaxKind, start: Date, end: Date) kind institutional {
    label en unofficial "a judicial enforcement period during which the section 6501 period is suspended under section 6503(j)(1)(A) (the designated summons itself, or another summons relating to the same return issued within the 30-day window)";
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "(A) during any judicial enforcement period—")
rule S6503J1AiEnforcementPeriodOfDesignatedSummons defeasible {
    label en official "the section 6501 period is suspended during the judicial enforcement period of the designated summons";
    for s: Summons;
    for corporation: Person;
    for issuedOn: Date;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when designated_summons(s)
        and summons_issued_to_corporation_on(s, corporation, issuedOn)
        and summons_relates_to_return_of(s, p, y, k)
        and corporation_examined_under_coordinated_industry_case_program(p, y)
        and judicial_enforcement_period(s, start, end);
    then designated_summons_enforcement_interval(p, y, k, start, end);
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "(ii) with respect to any other summons which is issued during the 30-day period which begins on the date on which such designated summons is issued and which relates to the same return as such designated summons, and")
rule S6503J1AiiEnforcementPeriodOfRelatedSummons defeasible {
    label en official "the section 6501 period is also suspended during the judicial enforcement period of another summons relating to the same return issued within 30 days of the designated summons";
    for d: Summons;
    for o: Summons;
    for corporation: Person;
    for otherHolder: Person;
    for dIssued: Date;
    for oIssued: Date;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when designated_summons(d)
        and summons_issued_to_corporation_on(d, corporation, dIssued)
        and summons_relates_to_return_of(d, p, y, k)
        and corporation_examined_under_coordinated_industry_case_program(p, y)
        and summons_issued_to_corporation_on(o, otherHolder, oIssued)
        and summons_relates_to_return_of(o, p, y, k)
        and oIssued >= dIssued
        and oIssued <= add_calendar_period(dIssued, 29 calendar_day)
        and judicial_enforcement_period(o, start, end);
    then designated_summons_enforcement_interval(p, y, k, start, end);
}
rule S6503J1AEnforcementIntervalSuspendsAssessment defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when designated_summons_enforcement_interval(p, y, k, start, end);
    then suspension_period(p, y, k, DesignatedSummonsEnforcement, start, end);
}
pub relation court_required_compliance_with_summons(s: Summons) kind empirical {
    label en official "the court in the proceeding requires any compliance with a summons referred to in subparagraph (A)";
}
pub relation designated_summons_compliance_required(p: Person, y: TaxableYear, k: TaxKind, enforcementEnd: Date) kind institutional {
    label en unofficial "a court required compliance with a summons of the enforcement interval that ended on the given day (section 6503(j)(1)(B) applies)";
}
rule S6503J1BComplianceRequiredForDesignatedSummons defeasible {
    for s: Summons;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when designated_summons(s)
        and summons_relates_to_return_of(s, p, y, k)
        and judicial_enforcement_period(s, start, end)
        and court_required_compliance_with_summons(s);
    then designated_summons_compliance_required(p, y, k, end);
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "(B) if the court in any proceeding referred to in paragraph (3) requires any compliance with a summons referred to in subparagraph (A), during the 120-day period beginning with the 1st day after the close of the suspension under subparagraph (A).")
rule S6503J1BComplianceSuspension120Days defeasible {
    label en official "when the court requires compliance, the section 6501 period is further suspended for the 120 days beginning with the day after the close of the enforcement suspension";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for end: Date;
    when designated_summons_compliance_required(p, y, k, end);
    then suspension_period(p, y, k, DesignatedSummonsCompliance, add_calendar_period(end, 1 calendar_day), add_calendar_period(end, 120 calendar_day));
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "If subparagraph (B) does not apply, such period shall in no event expire before the 60th day after the close of the suspension under subparagraph (A).")
rule S6503J1DefaultSixtyDayFloorFromDerivedInterval defeasible {
    label en official "when (B) does not apply the section 6501 period does not expire before the 60th day after the close of the enforcement suspension";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for start: Date;
    for end: Date;
    when designated_summons_enforcement_interval(p, y, k, start, end)
        and not_known(designated_summons_compliance_required(p, y, k, end));
    then assessment_period_ends(p, y, k, add_calendar_period(end, 60 calendar_day));
}
@source(IRC_S6503_J, relation = formalizes, coverage = exact, quote = "In any court proceeding described in paragraph (3), the Secretary shall establish that reasonable requests were made for the information that is the subject of the summons.")
rule S6503J4SecretaryMustEstablishReasonableRequests defeasible {
    label en official "in a court proceeding on a designated summons the Secretary shall establish that reasonable requests were made for the information";
    for s: Summons;
    for broughtOn: Date;
    when designated_summons(s) and court_proceeding_on_summons_brought_on(s, broughtOn);
    then duty S6503J4EstablishReasonableRequestsDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_established_reasonable_requests(s);
            window [broughtOn, infinity];
        }
    };
}
pub relation secretary_established_reasonable_requests(s: Summons) kind empirical {
    label en official "the Secretary established in the court proceeding that reasonable requests were made for the information that is the subject of the summons";
}
