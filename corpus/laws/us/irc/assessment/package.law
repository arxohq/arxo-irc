// 26 U.S.C. Chapters 63, 66 — Assessment: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package assessment` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.

// MODULE MAP (stage 1, IRC-15 stage 1: the pilot chain assessment / deficiency
// procedure / limitations, per the owner's task assignment)
//   package.law                          — shared ontology, imports, type
//                                           aliases, typed institutional
//                                           dependency contracts (this file)
//   01-assessment-authority-and-method.law — §6201 (assessment authority),
//                                           §6203 (method of assessment: the
//                                           recording event, taxpayer's right
//                                           to a copy), §6204 (supplemental
//                                           assessments)
//   02-deficiency-and-notice.law         — §6211 (definition of a
//                                           deficiency), §6212 (notice of
//                                           deficiency)
//   03-restrictions-and-tax-court.law    — §6213 (restrictions on
//                                           assessment; petition to Tax
//                                           Court), §6214 (Tax Court
//                                           jurisdiction to redetermine),
//                                           §6215 (assessment after Tax
//                                           Court decision)
//   04-limitations.law                   — §6501 (limitations on
//                                           assessment)
//   05-suspension.law                    — §6503 (suspension of the
//                                           running of the period of
//                                           limitation)
//
// STAGE 3 (26.09.2026) modules:
//   10-assessment-authority-remainder.law  — §6202, §6205(b), §6206 (+ Pub. L.
//                                           119-21 §70525: §6435 payments)
//   11-partnership-audit-remainder.law     — BBA remainder: §6221 transition
//                                           note, §6222(d), §6225(d),
//                                           §6226(b)-(c), §6227(b), §6231(c)-(d),
//                                           §6232(c)-(f), §6233, §6234(b)-(e)
//   12-refund-and-limitation-remainder.law — §6511(f),(h); §6512; §6513(c)-(e);
//                                           §6514; §6521; §6532(b)
//   13-criminal-limitations-6531.law       — §6531
//   14-public-law-119-revisions.law        — Pub. L. 119-39 §2 (§6213(b)),
//                                           119-21 (§6213(g)(2)), 119-64 §2(a)
//   06-...-6502.law (extended)             — §6502(a)(2), final sentence, (b)
//
// Every other disposition in this package's 38 sections stays `unreviewed`
// with note "stage 2" (DISPOSITIONS.json; coverage rows are written only for
// the stage-1 sections above — see docs/foundations/us-irc/coverage/
// assessment.json). §6502(a)'s general 10-year rule (chapter 66) IS modelled
// as of WIRE-2 (25.09.2026, coordinator instruction superseding the earlier
// "do NOT model it" scope cut) — see `06-collection-after-assessment-6502.law`,
// `pub` so `us.irc.collection` can import a real fact instead of a stub. The
// rest of §6502 (the two extension branches, the indefinite-window final
// sentence) remains out of scope, TECH_GAP per that module's own header.
//
// JUDGMENT CALLS AND EXTERNAL DEPENDENCIES (see report for the full list;
// flagged again inline at each use site):
//  - §7481 "date on which a decision of the Tax Court becomes final" is
//    `judicial-proceedings`' own norm (chapter 76, not yet formalized); this
//    package reads it as a typed institutional dependency contract
//    (`decision_final_on`), never computing finality itself.
//  - §6903 fiduciary-relationship notice (read by §6212(b)) and the
//    §7701(a) classification tests (`domestic`/`foreign`, `nonresident_alien`)
//    are `us.irc.definitions`' norm (under concurrent construction, not
//    imported); modeled as typed institutional dependency contracts.
//  - Title 11 bankruptcy-case pendency (read by §6503(h) and §6213(f)) is
//    `collection`'s own norm; modeled as a typed institutional dependency
//    contract, not computed here.
//  - §6501(b)(1)'s "last day prescribed by law ... for the filing thereof"
//    is read as the UNEXTENDED statutory due date bridged from
//    `us.irc.returns::statutory_due_date` (imported, real `pub` symbol) —
//    this package does NOT fold a granted §6081 extension into that date.
//    Whether a validly granted extension moves the §6501(b)(1) "last day"
//    is an open interpretive question this package does not resolve
//    (INTERPRETATION, see report); `us.irc.core::extension_granted` is
//    available to a consumer that wants the extended date instead.
//  - Fraud/willfulness (§6501(c)(1)-(2)) are DECISION-0194 evaluative
//    elements, channeled as `external judgment relation` with authority the
//    Tax Court (the court that actually adjudicates them may also be a
//    district court or the Court of Federal Claims; naming the Tax Court
//    specifically is a modeling simplification for this stage — see
//    report).

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

import us.irc.core version "0.1.1";
import us.irc.administration version "0.1.1";
import us.irc.returns version "0.1.1";
import us.irc.partnerships version "0.1.1";
import us.irc.corporations version "0.1.1";
import us.irc.temporal version "0.1.1";
// WIRE-10 group A (26.09.2026): section 5703(d) of chapter 52 reads the section 6201/6501 machinery of this package (module 96-wire10-A-assessment.law).
import us.irc.tobacco_firearms version "0.1.1";

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Partnership = us.irc.core::Partnership;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Return = us.irc.core::Return;
type Notice = us.irc.core::Notice;
type Assessment = us.irc.core::Assessment;
type Proceeding = us.irc.core::Proceeding;
type TaxKind = us.irc.core::TaxKind;
type Levy = us.irc.core::Levy;

const Secretary: Organ = us.irc.core::Secretary;
const TaxCourt: Organ = us.irc.core::TaxCourt;

// --- Typed institutional dependency contracts (pending, see header) --------

// Pending: `judicial-proceedings` (chapter 76, §7481) — the actual test for
// when a Tax Court decision becomes final. §6214(d), §6213(a), §6215(a) and
// §6503(a)(1) all read this fact without computing it.
relation decision_final_on(pr: Proceeding, d: Date) kind institutional {
    label en unofficial "the date on which a decision of the Tax Court becomes final under §7481 (not this package's norm)";
}

// Pending: `definitions` (§7701(b)) and `income-individual`/`returns`'
// own contract of the same name — reused here rather than redeclared, so a
// case fact about the same person's nonresident-alien status is one fact,
// not two shadow relations (`docs/PACKAGE-LAYOUT.ru.md`, "голое relation
// чужого пакета").
relation nonresident_alien(p: Individual) kind institutional {
    label en unofficial "the individual is a nonresident alien under §7701(b) (pending: `definitions`, not this package's norm)";
}

// Pending: `estates`/`definitions` (§6903) — notice to the Secretary of the
// existence of a fiduciary relationship, read by §6212(b)(1) and (b)(3).
relation fiduciary_relationship_noticed(p: Person) kind institutional {
    label en unofficial "the Secretary has been notified under §6903 of the existence of a fiduciary relationship for this person (pending: `estates`/`definitions`, not this package's norm)";
}

// Pending: `collection` (title 11 bankruptcy proceedings) — read by
// §6503(h) and §6213(f).
relation bankruptcy_case_pending(p: Person, d: Date) kind institutional {
    label en unofficial "a case under title 11 of the United States Code is pending with respect to the person on this date (pending: `collection`, not this package's norm)";
}
relation debtor_prohibited_from_tax_court_petition(p: Person, d: Date) kind institutional {
    label en unofficial "the automatic stay of title 11 prohibits the debtor from filing a Tax Court petition on this date (pending: `collection`, not this package's norm)";
}

// `collection_period_ends` moved to `06-collection-after-assessment-6502.law`
// (WIRE-2, 25.09.2026) — now a real `pub` implementation of §6502(a)'s
// general rule, not a placeholder.
