// 26 U.S.C. §§6511, 6513, 6532 — Limitations on credit or refund; time
// return deemed filed and tax considered paid; periods of limitation on
// suits. Stage 2b (25.09.2026, coordinator instruction). OWNERSHIP.json
// assigns §§6511-6515, 6521, 6531-6533 to this package (`assessment`).
//
// SCOPE.
//  - §6511(a): the claim-filing period of limitation — the LATER of 3
//    years from the (deemed) filing date or 2 years from the time the tax
//    was paid; 2 years only if no return was filed. Modeled with the same
//    "no strictly later candidate" idiom `04-limitations.law` and
//    `07-partnership-audit-bba.law` already use (TECH-GAPS G136 pattern).
//  - §6511(b): the AMOUNT limitation (the "look-back" rule) — modeled for
//    the two ordinary branches ((2)(A) claim filed within the 3-year
//    period: amount paid in the 3 years plus any filing extension
//    immediately preceding the claim; (2)(B) claim filed outside that
//    period: amount paid in the 2 years immediately preceding the claim).
//    (2)(C) (the hypothetical "as if a claim were filed on the date of
//    allowance" amount when NO claim was filed) is NOT modeled — it
//    requires the SAME formula applied to a counterfactual filing date,
//    which stacks a fresh TECH_GAP (a hypothetical "as of" date is not
//    itself a fact this package can derive) on top of the aggregate
//    machinery already used for the two ordinary branches.
//  - §6511(c): the agreement-extension rule mirrors §6501(c)(4)'s own
//    consent-extension mechanics (`04-limitations.law`), as an ADDITIONAL
//    `refund_claim_period_ends` tuple (same "no max over derived" caveat
//    that module's header already documents applies here identically).
//  - §6511(d): (1) the 7-year bad-debt/worthless-security period is
//    modeled as a further alternate `refund_claim_period_ends` tuple; (2)
//    the NOL/capital-loss-carryback period mirrors
//    `04-limitations.law`'s own `assessment_period_ends_via_carryback`
//    shape. (2)(B), (3)-(8) (foreign tax credit 10-year rule, credit
//    carrybacks, self-employment/SSA agreements, ERISA recapture,
//    §7436 proceedings, uniformed-services retired-pay reduction) are NOT
//    modeled — same-pattern narrow special rules, classified TECH_GAP
//    per coverage row rather than attempted partially.
//  - §6513(a): the early-return/advance-payment deeming rule, bridged
//    from `04-limitations.law`'s `deemed_filed_date` (the SAME "actual
//    filing date, or the last prescribed day if filed early" computation
//    §6501(b) already performs) per the anti-duplication convention
//    (`docs/PACKAGE-LAYOUT.ru.md`) rather than re-derived from scratch.
//  - §6513(b): only paragraph (2) (estimated tax deemed paid on the
//    return's due date) is modeled as the representative pattern; (1)
//    (withholding under chapter 24, deemed paid the 15th day of the 4th
//    month following the taxable year's close) and (3) (chapter 3/4
//    withholding) follow the exact same shape and are classified
//    TECH_GAP (same-pattern, not separately encoded this stage), per the
//    task's own "as far as executable" allowance. (c)-(e) are NOT
//    modeled (gift tax, other specific taxes, other overpayments —
//    narrow, self-contained).
//  - §6532(a): suits by taxpayers for refund — a `power` (holder: the
//    taxpayer) to bring suit, valid only within the window bounded below
//    by 6 months after the claim is filed (unless the Secretary decides
//    sooner or the taxpayer waives notice) and above by 2 years after the
//    Secretary mails a notice of disallowance (extendable by agreement).
//    (a)(5)'s title-11 120-day substitution is NOT modeled (cross-
//    reference to title 11 itself).
//  - §6532(c): suits by persons other than taxpayers (wrongful levy,
//    §7426) — 2 years from the levy or agreement, with the (2) extension
//    for a pending return-of-property request. NOTE: the task's brief
//    described this as "9 months for wrongful levy"; the pinned 2024-
//    edition text of §6532(c) states a 2-YEAR period (with 12/6-month
//    extensions under (2)), not 9 months — this package models the text
//    as pinned, not the brief's figure, per "never invent" (a 9-month
//    period appears nowhere in the pinned §6532(c) fragment).
//  - §6532(b) (suits by the United States for erroneous refunds, 2/5
//    years) is NOT modeled — it runs against the GOVERNMENT as plaintiff,
//    a different institutional shape (a power held by the Secretary to
//    sue, not a taxpayer-facing limitations period) this stage does not
//    reach; classified TECH_GAP.
//  - §§6512, 6514, 6515, 6521, 6531, 6533 (Tax Court petition effects on
//    refund suits; credits barred after limitation void; cross-
//    references; SE/FICA mitigation; criminal limitations; extension of
//    time cross-reference) are NOT modeled this stage — each its own
//    coverage row (TECH_GAP or NON_NORMATIVE), not attempted.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6511_A,
    IRC_S6511_B,
    IRC_S6511_C,
    IRC_S6511_D,
    IRC_S6513_A,
    IRC_S6513_B,
    IRC_S6532_A,
    IRC_S6532_C,
    Person,
    Secretary,
    TaxKind,
    TaxableYear,
    amount_paid_as_tax,
    deemed_filed_date,
    exists_filing_extension_for_lookback,
    secretary_and_taxpayer_consented_in_writing,
};

// ============================================================================
// §6511(a) — Period of limitation on filing claim
// ============================================================================

pub relation refund_claim_filed(p: Person, y: TaxableYear, k: TaxKind, filedOn: Date) kind empirical {
    label en official "a claim for credit or refund of an overpayment of tax filed by the taxpayer";
}
pub relation deemed_filed_date_for_refund(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en unofficial "§6511(a)/§6513(a) bridge: re-exports 04-limitations.law's `deemed_filed_date` (the same 'actual filing date, or the last prescribed day if filed early' computation) rather than re-deriving it — anti-duplication convention, docs/PACKAGE-LAYOUT.ru.md";
}
pub relation exists_deemed_filed_date_for_refund(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "existential wrapper over `deemed_filed_date_for_refund` for `not_known` (§14/§98: `_` is only a positive-literal argument)";
}
rule S6513ExistsDeemedFiledDateForRefund defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for d: Date;
    when deemed_filed_date_for_refund(p, y, k, d);
    then exists_deemed_filed_date_for_refund(p, y, k);
}
@source(IRC_S6513_A, relation = formalizes, coverage = exact, quote = "For purposes of section 6511, any return filed before the last day prescribed for the filing thereof shall be considered as filed on such last day.")
pub rule S6513EarlyReturnDeemedFiledForRefundPurposes defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for d: Date;
    when deemed_filed_date(p, y, k, d);
    then deemed_filed_date_for_refund(p, y, k, d);
}

pub relation refund_claim_period_ends(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en official "§6511(a): the date after which a claim for credit or refund is no longer timely";
}
pub relation refund_claim_three_year_end(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional;
rule S6511ThreeYearEndFromDeemedFiling defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    when deemed_filed_date_for_refund(p, y, k, filedOn);
    then refund_claim_three_year_end(p, y, k, add_calendar_period(filedOn, 3 calendar_year));
}
pub relation refund_claim_two_year_end(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional;
rule S6511TwoYearEndFromPayment defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for paidOn: Date;
    when amount_paid_as_tax(p, y, k, amount, paidOn);
    then refund_claim_two_year_end(p, y, k, add_calendar_period(paidOn, 2 calendar_year));
}
@source(IRC_S6511_A, relation = formalizes, coverage = exact, quote = "Claim for credit or refund of an overpayment of any tax imposed by this title in respect of which tax the taxpayer is required to file a return shall be filed by the taxpayer within 3 years from the time the return was filed or 2 years from the time the tax was paid, whichever of such periods expires the later")
rule S6511PeriodEndsThreeYearWhenLater defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for threeYearEnd: Date;
    for twoYearEnd: Date;
    when refund_claim_three_year_end(p, y, k, threeYearEnd)
        and refund_claim_two_year_end(p, y, k, twoYearEnd)
        and threeYearEnd >= twoYearEnd;
    then refund_claim_period_ends(p, y, k, threeYearEnd);
}
@source(IRC_S6511_A, relation = formalizes, coverage = exact, quote = "or 2 years from the time the tax was paid, whichever of such periods expires the later")
rule S6511PeriodEndsTwoYearWhenLater defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for threeYearEnd: Date;
    for twoYearEnd: Date;
    when refund_claim_three_year_end(p, y, k, threeYearEnd)
        and refund_claim_two_year_end(p, y, k, twoYearEnd)
        and twoYearEnd > threeYearEnd;
    then refund_claim_period_ends(p, y, k, twoYearEnd);
}
@source(IRC_S6511_A, relation = formalizes, coverage = exact, quote = "or if no return was filed by the taxpayer, within 2 years from the time the tax was paid.")
rule S6511PeriodEndsTwoYearWhenNoReturnFiled defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for twoYearEnd: Date;
    when refund_claim_two_year_end(p, y, k, twoYearEnd)
        and not_known(exists_deemed_filed_date_for_refund(p, y, k));
    then refund_claim_period_ends(p, y, k, twoYearEnd);
}

pub relation refund_claim_timely(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en official "§6511(a): the claim for credit or refund was filed within the applicable period of limitation";
}
rule S6511ClaimTimely defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for periodEnd: Date;
    when refund_claim_filed(p, y, k, filedOn)
        and refund_claim_period_ends(p, y, k, periodEnd)
        and filedOn <= periodEnd;
    then refund_claim_timely(p, y, k);
}

// ============================================================================
// §6511(b) — Limitation on allowance of credits and refunds (look-back)
// ============================================================================

pub relation refund_amount_limit_three_year_lookback(p: Person, y: TaxableYear, k: TaxKind, limit: Money) kind institutional {
    label en official "§6511(b)(2)(A): where the claim was filed within the 3-year period, the credit/refund may not exceed the tax paid within the 3 years immediately preceding the claim (plus any filing extension — NOT modeled, a simplification: this stage reads the plain 3-year window without the extension addend)";
}
@source(IRC_S6511_B, relation = formalizes, coverage = partial, quote = "If the claim was filed by the taxpayer during the 3-year period prescribed in subsection (a), the amount of the credit or refund shall not exceed the portion of the tax paid within the period, immediately preceding the filing of the claim, equal to 3 years plus the period of any extension of time for filing the return.")
rule S6511ThreeYearLookbackAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for threeYearEnd: Date;
    for calendar_before_1: Date;
    when refund_claim_filed(p, y, k, filedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and filedOn <= threeYearEnd
        and not_known(exists_filing_extension_for_lookback(p, y, k))
        and us.irc.core::civil_calendar_boundary_before(filedOn, 3, us.irc.core::CalendarYear, calendar_before_1);
    then refund_amount_limit_three_year_lookback(p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn <= filedOn
                and paidOn >= calendar_before_1);
}
pub relation refund_amount_limit_two_year_lookback(p: Person, y: TaxableYear, k: TaxKind, limit: Money) kind institutional {
    label en official "§6511(b)(2)(B): where the claim was NOT filed within the 3-year period, the credit/refund may not exceed the tax paid within the 2 years immediately preceding the claim";
}
@source(IRC_S6511_B, relation = formalizes, coverage = exact, quote = "If the claim was not filed within such 3-year period, the amount of the credit or refund shall not exceed the portion of the tax paid during the 2 years immediately preceding the filing of the claim.")
rule S6511TwoYearLookbackAmount defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for threeYearEnd: Date;
    for calendar_before_1: Date;
    when refund_claim_filed(p, y, k, filedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and filedOn > threeYearEnd
        and us.irc.core::civil_calendar_boundary_before(filedOn, 2, us.irc.core::CalendarYear, calendar_before_1);
    then refund_amount_limit_two_year_lookback(p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn <= filedOn
                and paidOn >= calendar_before_1);
}
// TECH_GAP: §6511(b)(2)(C) (the amount limit when NO claim was filed,
// measured as if one had been filed on the date the credit/refund is
// allowed) is not modeled — a hypothetical "as if" filing date this
// package does not construct.

// ============================================================================
// §6511(c) — Extension by agreement to extend §6501(c)(4) assessment period
// ============================================================================

@source(IRC_S6511_C, relation = formalizes, coverage = exact, quote = "shall not expire prior to 6 months after the expiration of the period within which an assessment may be made pursuant to the agreement or any extension thereof under section 6501(c)(4).")
pub relation refund_claim_agreement_within_original_period(p: Person, y: TaxableYear, k: TaxKind, until: Date, consentedOn: Date) kind institutional {
    label en unofficial "single-atom valid_when helper (mirrors 04-limitations.law's `consent_within_original_period`): the section 6501(c)(4) agreement was made within the then-running section 6511(a) claim period";
}
rule S6511AgreementWithinOriginalPeriod defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for until: Date;
    for consentedOn: Date;
    for claimPeriodEnd: Date;
    when secretary_and_taxpayer_consented_in_writing(p, y, k, until, consentedOn)
        and refund_claim_period_ends(p, y, k, claimPeriodEnd)
        and consentedOn <= claimPeriodEnd;
    then refund_claim_agreement_within_original_period(p, y, k, until, consentedOn);
}
pub rule S6511PeriodExtendedBySixMonthsAfterAssessmentAgreement strict {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for until: Date;
    for consentedOn: Date;
    when refund_claim_agreement_within_original_period(p, y, k, until, consentedOn);
    then power S6511ExtendClaimPeriodBySixMonthsPower {
        holder Secretary;
        over p;
        exercise secretary_and_taxpayer_consented_in_writing(p, y, k, until, consentedOn);
        valid_when refund_claim_agreement_within_original_period(p, y, k, until, consentedOn);
        effect create(refund_claim_period_ends(p, y, k, add_calendar_period(until, 6 calendar_month)));
    };
}
// TECH_GAP: this creates a SECOND `refund_claim_period_ends` tuple for the
// same (p, y, k) key when the agreement condition is met — the same "no
// max-over-derived" limitation `04-limitations.law`'s header documents for
// `assessment_period_ends` applies identically; a consumer needing "the"
// single controlling date must compose both tuples itself. §6511(c)(2)-(3)
// (the amount-limit consequence of a claim filed after the agreement, and
// the carve-out for claims outside the agreement window) are not modeled.

// ============================================================================
// §6511(d) — Special rules applicable to income taxes
// ============================================================================

pub relation bad_debt_or_worthless_security_claim(p: Person, y: TaxableYear) kind empirical {
    label en official "the claim for credit or refund relates to an overpayment on account of the deductibility of a bad debt (section 166/832(c)) or a worthless security (section 165(g)), or a carryover affected by such deductibility (section 6511(d)(1))";
}
@source(IRC_S6511_D, relation = formalizes, coverage = exact, quote = "in lieu of the 3-year period of limitation prescribed in subsection (a), the period shall be 7 years from the date prescribed by law for filing the return for the year with respect to which the claim is made.")
rule S6511SevenYearPeriodForBadDebtsAndWorthlessSecurities defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for dueOn: Date;
    when bad_debt_or_worthless_security_claim(p, y)
        and us.irc.returns::statutory_due_date(p, y, k, dueOn);
    then refund_claim_period_ends(p, y, k, add_calendar_period(dueOn, 7 calendar_year));
}
pub relation refund_claim_attributable_to_carryback(p: Person, y: TaxableYear, k: TaxKind, lossYear: TaxableYear) kind empirical {
    label en official "the claim for credit or refund relates to an overpayment attributable to a net operating loss carryback or a capital loss carryback from `lossYear` (section 6511(d)(2)(A))";
}
@source(IRC_S6511_D, relation = formalizes, coverage = exact, quote = "the period shall be that period which ends 3 years after the time prescribed by law for filing the return (including extensions thereof) for the taxable year of the net operating loss or net capital loss which results in such carryback, or the period prescribed in subsection (c) in respect of such taxable year, whichever expires later.")
pub relation refund_claim_period_ends_via_carryback(p: Person, y: TaxableYear, k: TaxKind, lossYear: TaxableYear, d: Date) kind institutional {
    label en unofficial "mirrors `04-limitations.law`'s `assessment_period_ends_via_carryback` shape: reads the LOSS year's own statutory due date, not the claim year's — this stage does not additionally compare against 'the period prescribed in subsection (c)' (the (c) extension-by-agreement branch), a further same-pattern simplification";
}
rule S6511CarrybackPeriodFromLossYearDueDate defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for lossYear: TaxableYear;
    for lossYearDueOn: Date;
    when refund_claim_attributable_to_carryback(p, y, k, lossYear)
        and us.irc.returns::statutory_due_date(p, lossYear, k, lossYearDueOn);
    then refund_claim_period_ends_via_carryback(p, y, k, lossYear, add_calendar_period(lossYearDueOn, 3 calendar_year));
}
// TECH_GAP: §6511(d)(2)(B) (applicable rules: prevented-by-other-law
// override, tentative carryback adjustments, court determinations
// conclusive) and (d)(3)-(8) (10-year foreign tax credit period, credit
// carrybacks, self-employment/SSA agreements, ERISA recapture, §7436
// proceedings, uniformed-services retired pay) are NOT modeled — narrow,
// same-pattern special rules, classified TECH_GAP per coverage row.

// ============================================================================
// §6513(b)(2) — Estimated income tax deemed paid on the return's due date
// ============================================================================

pub relation estimated_tax_paid(p: Person, y: TaxableYear, amount: Money, paidOn: Date) kind empirical {
    label en official "an amount paid as estimated income tax for the taxable year";
}
@source(IRC_S6513_B, relation = formalizes, coverage = exact, quote = "Any amount paid as estimated income tax for any taxable year shall be deemed to have been paid on the last day prescribed for filing the return under section 6012 for such taxable year (determined without regard to any extension of time for filing such return).")
pub rule S6513EstimatedTaxDeemedPaidOnDueDate strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for paidOn: Date;
    for dueOn: Date;
    when estimated_tax_paid(p, y, amount, paidOn)
        and us.irc.returns::statutory_due_date(p, y, us.irc.core::IncomeCh1, dueOn);
    then amount_paid_as_tax(p, y, us.irc.core::IncomeCh1, amount, dueOn);
}
// TECH_GAP: §6513(b)(1) (chapter 24 withholding deemed paid the 15th day
// of the 4th month following the taxable year's close) and (b)(3)
// (chapter 3/4 withholding) follow the identical shape and are not
// separately encoded this stage (same-pattern). (c)-(e) are not modeled.

// ============================================================================
// §6532(a) — Suits by taxpayers for refund
// ============================================================================

pub relation notice_of_claim_disallowance_mailed(p: Person, y: TaxableYear, k: TaxKind, mailedOn: Date) kind empirical {
    label en official "the Secretary mails, by certified or registered mail, a notice of disallowance of the part of the claim to which the suit relates";
}
pub relation claim_disallowance_notice_waived(p: Person, y: TaxableYear, k: TaxKind, waivedOn: Date) kind empirical {
    label en official "the person files a written waiver of the requirement of being mailed a notice of disallowance (section 6532(a)(3))";
}
pub relation exists_claim_disallowance_notice_waived(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "existential wrapper over `claim_disallowance_notice_waived` for `not_known` (§14/§98)";
}
rule S6532ExistsClaimDisallowanceNoticeWaived strict {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for waivedOn: Date;
    when claim_disallowance_notice_waived(p, y, k, waivedOn);
    then exists_claim_disallowance_notice_waived(p, y, k);
}
pub relation refund_suit_period_extension_agreed(p: Person, y: TaxableYear, k: TaxKind, until: Date, agreedOn: Date) kind empirical {
    label en official "the 2-year period is extended for such period as may be agreed upon in writing between the taxpayer and the Secretary (section 6532(a)(2))";
}
pub relation refund_suit_period_ends(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en official "§6532(a)(1)-(3): the date after which a suit for refund may no longer be begun — 2 years from the mailing of the notice of disallowance (or from the filing of a waiver of that notice), as extended by any agreement under (a)(2)";
}
@source(IRC_S6532_A, relation = formalizes, coverage = exact, quote = "nor after the expiration of 2 years from the date of mailing by certified mail or registered mail by the Secretary to the taxpayer of a notice of the disallowance of the part of the claim to which the suit or proceeding relates.")
rule S6532SuitPeriodEndsTwoYearsFromDisallowance defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    when notice_of_claim_disallowance_mailed(p, y, k, mailedOn)
        and not_known(exists_claim_disallowance_notice_waived(p, y, k));
    then refund_suit_period_ends(p, y, k, add_calendar_period(mailedOn, 2 calendar_year));
}
@source(IRC_S6532_A, relation = formalizes, coverage = exact, quote = "If any person files a written waiver of the requirement that he be mailed a notice of disallowance, the 2-year period prescribed in paragraph (1) shall begin on the date such waiver is filed.")
rule S6532SuitPeriodEndsTwoYearsFromWaiver defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for waivedOn: Date;
    when claim_disallowance_notice_waived(p, y, k, waivedOn);
    then refund_suit_period_ends(p, y, k, add_calendar_period(waivedOn, 2 calendar_year));
}
@source(IRC_S6532_A, relation = formalizes, coverage = exact, quote = "The 2-year period prescribed in paragraph (1) shall be extended for such period as may be agreed upon in writing between the taxpayer and the Secretary.")
rule S6532SuitPeriodExtendedByAgreement strict {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for until: Date;
    for agreedOn: Date;
    when refund_suit_period_extension_agreed(p, y, k, until, agreedOn);
    then refund_suit_period_ends(p, y, k, until);
}

pub relation refund_suit_begun(p: Person, y: TaxableYear, k: TaxKind, beganOn: Date) kind empirical {
    label en official "a suit or proceeding under section 7422(a) for the recovery of tax, penalty, or other sum is begun";
}
pub relation refund_suit_earliest_start(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en official "§6532(a)(1): 6 months from the date of filing the claim (the earliest the suit may begin, absent an earlier Secretary decision)";
}
rule S6532EarliestStartSixMonthsAfterClaim defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    when refund_claim_filed(p, y, k, filedOn);
    then refund_suit_earliest_start(p, y, k, add_calendar_period(filedOn, 6 calendar_month));
}
pub relation refund_suit_window_open(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "helper for valid_when: the suit is begun on or after the earliest start date and on or before the period-end date (single-atom compiler constraint)";
}
rule S6532SuitWindowOpen defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for beganOn: Date;
    for earliest: Date;
    for periodEnd: Date;
    when refund_suit_begun(p, y, k, beganOn)
        and refund_suit_earliest_start(p, y, k, earliest)
        and refund_suit_period_ends(p, y, k, periodEnd)
        and beganOn >= earliest
        and beganOn <= periodEnd;
    then refund_suit_window_open(p, y, k);
}
@source(IRC_S6532_A, relation = formalizes, coverage = exact, quote = "No suit or proceeding under section 7422(a) for the recovery of any internal revenue tax, penalty, or other sum, shall be begun before the expiration of 6 months from the date of filing the claim required under such section unless the Secretary renders a decision thereon within that time, nor after the expiration of 2 years from the date of mailing by certified mail or registered mail by the Secretary to the taxpayer of a notice of the disallowance of the part of the claim to which the suit or proceeding relates.")
pub rule S6532BeginRefundSuit defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for beganOn: Date;
    when refund_suit_begun(p, y, k, beganOn);
    then power S6532BeginRefundSuitPower {
        holder p;
        over Secretary;
        exercise refund_suit_begun(p, y, k, beganOn);
        valid_when refund_suit_window_open(p, y, k);
        effect create(refund_suit_timely(p, y, k));
    };
}
pub relation refund_suit_timely(p: Person, y: TaxableYear, k: TaxKind) kind institutional;
// TECH_GAP: §6532(a)(1)'s "unless the Secretary renders a decision...within
// that time" early-start exception and (a)(4) (reconsideration after
// mailing does not extend the period) are not modeled; (a)(5) (title 11
// 120-day substitution) is a cross-reference not modeled.

// ============================================================================
// §6532(c) — Suits by persons other than taxpayers (wrongful levy)
// ============================================================================

pub relation levy_or_agreement_date(p: Person, giving_rise_to: Date) kind empirical {
    label en unofficial "the date of the levy or agreement giving rise to a section 7426 action";
}
pub relation return_of_property_request_filed(p: Person, requestedOn: Date) kind empirical {
    label en official "a request is made for the return of property described in section 6343(b) (section 6532(c)(2))";
}
pub relation exists_return_of_property_request_filed(p: Person) kind institutional {
    label en unofficial "existential wrapper over `return_of_property_request_filed` for `not_known` (§14/§98)";
}
rule S6532ExistsReturnOfPropertyRequestFiled strict {
    for p: Person;
    for requestedOn: Date;
    when return_of_property_request_filed(p, requestedOn);
    then exists_return_of_property_request_filed(p);
}
pub relation wrongful_levy_disallowance_notice_mailed(p: Person, mailedOn: Date) kind empirical {
    label en official "notice of disallowance of the part of the section 6343(b) request to which the action relates, mailed by registered or certified mail (section 6532(c)(2))";
}
pub relation exists_wrongful_levy_disallowance_notice_mailed(p: Person) kind institutional {
    label en unofficial "existential wrapper over `wrongful_levy_disallowance_notice_mailed` for `not_known` (§14/§98)";
}
rule S6532ExistsWrongfulLevyDisallowanceNoticeMailed strict {
    for p: Person;
    for mailedOn: Date;
    when wrongful_levy_disallowance_notice_mailed(p, mailedOn);
    then exists_wrongful_levy_disallowance_notice_mailed(p);
}
pub relation wrongful_levy_suit_period_ends(p: Person, d: Date) kind institutional {
    label en official "§6532(c)(1): the date after which a section 7426 action may no longer be begun — 2 years from the levy or agreement, extended under (c)(2) by 12 months from a pending return-of-property request or 6 months from the mailing of its disallowance notice, whichever is SHORTER";
}
@source(IRC_S6532_C, relation = formalizes, coverage = exact, quote = "no suit or proceeding under section 7426 shall be begun after the expiration of 2 years from the date of the levy or agreement giving rise to such action.")
rule S6532WrongfulLevyTwoYearPeriod defeasible {
    for p: Person;
    for giving_rise_to: Date;
    when levy_or_agreement_date(p, giving_rise_to)
        and not_known(exists_return_of_property_request_filed(p));
    then wrongful_levy_suit_period_ends(p, add_calendar_period(giving_rise_to, 2 calendar_year));
}
pub relation wrongful_levy_extension_from_request(p: Person, d: Date) kind institutional;
rule S6532WrongfulLevyExtensionFromRequestTwelveMonths defeasible {
    for p: Person;
    for requestedOn: Date;
    when return_of_property_request_filed(p, requestedOn);
    then wrongful_levy_extension_from_request(p, add_calendar_period(requestedOn, 12 calendar_month));
}
pub relation wrongful_levy_extension_from_notice(p: Person, d: Date) kind institutional;
rule S6532WrongfulLevyExtensionFromNoticeSixMonths defeasible {
    for p: Person;
    for mailedOn: Date;
    when wrongful_levy_disallowance_notice_mailed(p, mailedOn);
    then wrongful_levy_extension_from_notice(p, add_calendar_period(mailedOn, 6 calendar_month));
}
@source(IRC_S6532_C, relation = formalizes, coverage = exact, quote = "the 2-year period prescribed in paragraph (1) shall be extended for a period of 12 months from the date of filing of such request or for a period of 6 months from the date of mailing by registered or certified mail by the Secretary to the person making such request of a notice of disallowance of the part of the request to which the action relates, whichever is shorter.")
rule S6532WrongfulLevyExtendedPeriodShorterOfTwo defeasible {
    for p: Person;
    for twelveMonthEnd: Date;
    for sixMonthEnd: Date;
    when wrongful_levy_extension_from_request(p, twelveMonthEnd)
        and wrongful_levy_extension_from_notice(p, sixMonthEnd)
        and sixMonthEnd <= twelveMonthEnd;
    then wrongful_levy_suit_period_ends(p, sixMonthEnd);
}
rule S6532WrongfulLevyExtendedPeriodTwelveMonthShorter defeasible {
    for p: Person;
    for twelveMonthEnd: Date;
    for sixMonthEnd: Date;
    when wrongful_levy_extension_from_request(p, twelveMonthEnd)
        and wrongful_levy_extension_from_notice(p, sixMonthEnd)
        and twelveMonthEnd < sixMonthEnd;
    then wrongful_levy_suit_period_ends(p, twelveMonthEnd);
}
rule S6532WrongfulLevyExtensionPendingNoticeYet defeasible {
    for p: Person;
    for twelveMonthEnd: Date;
    when wrongful_levy_extension_from_request(p, twelveMonthEnd)
        and not_known(exists_wrongful_levy_disallowance_notice_mailed(p));
    then wrongful_levy_suit_period_ends(p, twelveMonthEnd);
}
