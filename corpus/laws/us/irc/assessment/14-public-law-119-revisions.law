// Public Laws of the 119th Congress applicable to sections owned by
// `us.irc.assessment` — stage 3 (26.09.2026, DECISION-0379).
// Status: implemented_unverified.
//
// The base edition is the 2024 text pinned in `sources.law`. The amendments
// below are pinned in `us.irc.temporal` and carried as rules whose window is
// a fact of the case (the notice date, the taxable year's beginning), not the
// reading date:
//
//  - Pub. L. 119-39 §2 (approved 2025-11-25): §6213(b)(1)(B) specificity of
//    the math-or-clerical-error notice, §6213(b)(2)(C) notice of abatement,
//    for notices sent after 2026-11-25 (12 months after enactment); the
//    Secretary's duties of §2(d) (procedures within 180 days) and §2(e)
//    (pilot and report within 18 months). The approval date is read from
//    `raw/plaw/PLAW-119publ39.xml` (`approvedDate`), because the `adopted`
//    date of the temporal edition object is a placeholder.
//  - Pub. L. 119-21 §§70103(b), 70119(b), 70201(c), 70202(d), 70204: the five
//    added §6213(g)(2) categories (W)-(AA) (enum values in module 03), and the
//    widening of (g)(2)(I) (§70104(e): "section 24(e)" -> "section 24") and
//    (g)(2)(J) (§70606(b): TIN -> SSN or EIN).
//  - Pub. L. 119-64 §2(a) (approved 2025-12-26): §7508A(f) — the period
//    disregarded under §7508A for filing a return is an extension of time for
//    §6511(b)(2)(A). Owned by `administration`
//    (`return_extension_for_6511`); read here to fill the extension addend of
//    the 3-year look-back that stage 2b left out.
//  - Pub. L. 119-21 §70525: §6206 (module 10).
//
// AMENDMENTS.json lists §6501 for Pub. L. 119-21 §70512; the fragment
// contains no amendment of §6501 (a heuristic false positive). §70605(e)-(f)
// amend §3134(l) (owner `employment`), not §§6501/6511.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6511_B,
    MathOrClericalErrorKind,
    Notice,
    Person,
    Return,
    Secretary,
    TaxKind,
    TaxableYear,
    amount_paid_as_tax,
    math_error_notice_given,
    math_error_notice_sets_forth_error_and_explanation,
    math_error_notice_valid,
    refund_amount_limit_three_year_lookback,
    refund_claim_filed,
    refund_claim_three_year_end,
};

// ============================================================================
// Pub. L. 119-39 §2(a) — §6213(b)(1)(B): specificity of the notice
// ============================================================================

pub relation math_error_notice_states_error_type(n: Notice) kind empirical {
    label en official "the notice describes the type of error";
}
pub relation math_error_notice_states_code_section(n: Notice) kind empirical {
    label en official "the notice describes the section of this title to which the error relates";
}
pub relation math_error_notice_describes_nature_of_error(n: Notice) kind empirical {
    label en official "the notice describes the nature of the error";
}
pub relation math_error_notice_states_return_line(n: Notice) kind empirical {
    label en official "the notice describes the specific line of the return on which the error was made";
}
pub relation math_error_notice_plain_language_description(n: Notice) kind institutional {
    label en official "the notice describes the mathematical or clerical error in comprehensive, plain language, including the type of error, the section, the nature of the error and the line";
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "describe the mathematical or clerical error in comprehensive, plain language")
rule S6213b1BIIPlainLanguageDescription strict {
    label en official "the description includes type, section, nature and return line";
    for n: Notice;
    when math_error_notice_states_error_type(n)
        and math_error_notice_states_code_section(n)
        and math_error_notice_describes_nature_of_error(n)
        and math_error_notice_states_return_line(n);
    then math_error_notice_plain_language_description(n);
}
pub relation math_error_notice_itemized_computation(n: Notice) kind empirical {
    label en official "an itemized computation of any direct or incidental adjustments to be made to the return in correction of the error, including the adjustments to the listed amounts";
}
pub relation math_error_notice_includes_transcript_phone_number(n: Notice) kind empirical {
    label en official "the notice includes the telephone number for the automated phone transcript service";
}
pub relation math_error_notice_displays_abatement_date_prominently(n: Notice) kind empirical {
    label en official "the notice displays the date by which the taxpayer may request abatement, in bold, font size 14, immediately next to the taxpayer's address on page 1";
}
pub relation math_error_notice_lists_alternative_potential_errors(n: Notice) kind empirical {
    label en official "the notice provides multiple potential or alternative errors which may be applicable to the return";
}
pub relation math_error_notice_specific(n: Notice) kind institutional {
    label en official "the notice satisfies section 6213(b)(1)(B)(i) (sent to the last known address, plain-language description, itemized computation, telephone number, abatement date display) and is not a list of potential errors ((B)(ii))";
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "The notice provided under subparagraph (A) shall—")
rule S6213b1BSpecificityOfNotice strict {
    label en official "a math-or-clerical-error notice must be specific (Pub. L. 119-39 section 2(a))";
    for n: Notice;
    when us.irc.core::address_last_known(n)
        and math_error_notice_plain_language_description(n)
        and math_error_notice_itemized_computation(n)
        and math_error_notice_includes_transcript_phone_number(n)
        and math_error_notice_displays_abatement_date_prominently(n)
        and not_known(math_error_notice_lists_alternative_potential_errors(n));
    then math_error_notice_specific(n);
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "shall apply to notices sent after the date which is 12 months after the date of the enactment of this Act")
rule S6213NoticeValidAfterPl11939 strict {
    label en official "for notices sent after 2026-11-25 the notice must set forth the error and be specific (Pub. L. 119-39 section 2(a)-(c))";
    for n: Notice;
    for p: Person;
    for kind: MathOrClericalErrorKind;
    for amount: Money;
    for mailedOn: Date;
    when math_error_notice_given(n, p, kind, amount, mailedOn)
        and math_error_notice_sets_forth_error_and_explanation(n)
        and math_error_notice_specific(n)
        and mailedOn > @2026-11-25;
    then math_error_notice_valid(n, p);
}
// The window boundary 2026-11-25 is 12 months after the approval date
// 2025-11-25 of Pub. L. 119-39; it is written as a literal because the
// temporal edition object carries a placeholder `adopted` date.

// --- (b): notice of abatement, §6213(b)(2)(C) ------------------------------------

pub relation abatement_determined(p: Person, n: Notice, determinedOn: Date) kind empirical {
    label en official "the Secretary determines an abatement pursuant to subparagraph (A) of section 6213(b)(2)";
}
pub relation abatement_notice_sent(p: Person, n: Notice) kind empirical {
    label en official "the Secretary sends the taxpayer notice of the abatement";
}
pub relation abatement_notice_to_last_known_address(p: Person, n: Notice) kind empirical {
    label en official "the abatement notice is sent to the taxpayer's last known address";
}
pub relation abatement_notice_plain_language(p: Person, n: Notice) kind empirical {
    label en official "the abatement notice describes the abatement in comprehensive, plain language";
}
pub relation abatement_notice_itemized_computation(p: Person, n: Notice) kind empirical {
    label en official "the abatement notice provides an itemized computation of any adjustments to the items described in the notice of mathematical or clerical error";
}
pub relation abatement_notice_compliant(p: Person, n: Notice) kind institutional {
    label en official "the abatement notice satisfies clauses (i)-(iii) of section 6213(b)(2)(C)";
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "describes the abatement in comprehensive, plain language")
rule S6213b2CAbatementNoticeCompliant defeasible {
    label en official "the abatement notice is sent to the last known address, in plain language, with an itemized computation";
    for p: Person;
    for n: Notice;
    when abatement_notice_sent(p, n)
        and abatement_notice_to_last_known_address(p, n)
        and abatement_notice_plain_language(p, n)
        and abatement_notice_itemized_computation(p, n);
    then abatement_notice_compliant(p, n);
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "Upon determination of an abatement pursuant to subparagraph (A), the Secretary shall send notice to the taxpayer of such abatement")
pub rule S6213b2CAbatementNoticeRequired defeasible {
    label en official "upon determination of an abatement, the Secretary shall send the taxpayer a compliant notice of the abatement (notices of math or clerical error sent after 2026-11-25)";
    for p: Person;
    for n: Notice;
    for kind: MathOrClericalErrorKind;
    for amount: Money;
    for mailedOn: Date;
    for determinedOn: Date;
    when abatement_determined(p, n, determinedOn)
        and math_error_notice_given(n, p, kind, amount, mailedOn)
        and mailedOn > @2026-11-25;
    then duty S6213b2CAbatementNoticeDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition abatement_notice_compliant(p, n);
            window [determinedOn, infinity];
        }
    };
}

// --- Pub. L. 119-39 §2(d), (e): Secretary's deadlines ----------------------------

pub relation abatement_request_procedures_provided(dummy: Notice) kind empirical {
    label en official "the Secretary provides procedures by which a taxpayer may request an abatement in writing, electronically, by telephone, or in person";
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "Not later than 180 days after the date of the enactment of this Act, the Secretary of the Treasury (or such Secretary’s delegate) shall provide for procedures")
pub rule S2dAbatementRequestProceduresRequired defeasible {
    label en official "not later than 180 days after 2025-11-25 the Secretary shall provide procedures for abatement requests (window ends 2026-05-24)";
    for n: Notice;
    for p: Person;
    for kind: MathOrClericalErrorKind;
    for amount: Money;
    for mailedOn: Date;
    when math_error_notice_given(n, p, kind, amount, mailedOn);
    then duty S2dAbatementRequestProceduresDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition abatement_request_procedures_provided(n);
            window [@2025-11-25, add_calendar_period(@2025-11-25, 180 calendar_day)];
        }
    };
}
pub relation math_error_pilot_program_implemented(dummy: Notice) kind empirical {
    label en official "the Secretary implements a pilot program sending a statistically significant number of math-or-clerical-error notices by certified or registered mail with e-signature confirmation of receipt";
}
pub relation math_error_pilot_report_submitted(dummy: Notice) kind empirical {
    label en official "the Secretary, in consultation with the National Taxpayer Advocate, reports to Congress the numbers, dollar amounts, abatements and the effect of the pilot";
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "Not later than 18 months after the date of the enactment of this Act")
pub rule S2ePilotProgramRequired defeasible {
    label en official "not later than 18 months after 2025-11-25 the Secretary shall implement the pilot program (window ends 2027-05-25)";
    for n: Notice;
    for p: Person;
    for kind: MathOrClericalErrorKind;
    for amount: Money;
    for mailedOn: Date;
    when math_error_notice_given(n, p, kind, amount, mailedOn);
    then duty S2ePilotProgramDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition math_error_pilot_program_implemented(n);
            window [@2025-11-25, add_calendar_period(@2025-11-25, 18 calendar_month)];
        }
    };
}
@source(us.irc.temporal::PL119_39_S2, relation = derives_from, quote = "report to Congress, aggregated by the type of error under section 6213(g) of such Code")
pub rule S2ePilotReportRequired defeasible {
    label en official "the Secretary shall report to Congress on the pilot (same 18-month window)";
    for n: Notice;
    for p: Person;
    for kind: MathOrClericalErrorKind;
    for amount: Money;
    for mailedOn: Date;
    when math_error_notice_given(n, p, kind, amount, mailedOn);
    then duty S2ePilotReportDuty {
        bearer Secretary;
        beneficiary us.irc.core::Congress;
        goal achievement {
            condition math_error_pilot_report_submitted(n);
            window [@2025-11-25, add_calendar_period(@2025-11-25, 18 calendar_month)];
        }
    };
}
// JUDGMENT CALL: the duties of §2(d)-(e) are addressed to the Secretary, not
// to a taxpayer or a notice; the `dummy: Notice` parameter and the trigger on
// any math-error notice exist only to give the duty a bound bearer/case
// binding in a rule body (a rule with no body variable cannot carry a duty).
// The "dummy" atoms record one fact per case; they are not statutory
// entities. Recorded as INTERPRETATION in the coverage rows.

// ============================================================================
// Pub. L. 119-21 — §6213(g)(2) categories (W)-(AA); (I) and (J) widened
// ============================================================================

pub relation math_error_category_applicable(kind: MathOrClericalErrorKind, y: TaxableYear) kind institutional {
    label en official "the section 6213(g)(2) category applies to the taxable year";
}
@source(us.irc.temporal::PL119_21_S70103, relation = derives_from, quote = "(W) an omission of a correct social security number required under section 151(d)(5)(C) (relating to deduction for seniors)")
rule S6213g2WSeniorDeductionSsn defeasible {
    label en official "(g)(2)(W): omission of the SSN required under section 151(d)(5)(C), taxable years beginning after 2024";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2024-12-31;
    then math_error_category_applicable(OmittedSeniorDeductionSsn, y);
}
@source(us.irc.temporal::PL119_21_S70119, relation = derives_from, quote = "(X) an omission of a correct social security number required under section 108(f)(5)(C")
rule S6213g2XDischargeExclusionSsn defeasible {
    label en official "(g)(2)(X): omission of the SSN required under section 108(f)(5)(C), discharges after 2025";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2025-12-31;
    then math_error_category_applicable(OmittedDischargeExclusionSsn, y);
}
@source(us.irc.temporal::PL119_21_S70201, relation = derives_from, quote = "(Y) an omission of a correct social security number required under section 224(e")
rule S6213g2YTipsDeductionSsn defeasible {
    label en official "(g)(2)(Y): omission of the SSN required under section 224(e), taxable years beginning after 2024";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2024-12-31;
    then math_error_category_applicable(OmittedTipsDeductionSsn, y);
}
@source(us.irc.temporal::PL119_21_S70202, relation = derives_from, quote = "(Z) an omission of a correct social security number required under section 225(d")
rule S6213g2ZOvertimeDeductionSsn defeasible {
    label en official "(g)(2)(Z): omission of the SSN required under section 225(d), taxable years beginning after 2024";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2024-12-31;
    then math_error_category_applicable(OmittedOvertimeDeductionSsn, y);
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "(AA) an omission of a correct social security number required under section 6434")
rule S6213g2AATrumpAccountSsn defeasible {
    label en official "(g)(2)(AA): omission of the SSN required under section 6434, taxable years beginning after 2025";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2025-12-31;
    then math_error_category_applicable(OmittedTrumpAccountSsn, y);
}
pub relation math_error_category_scope_widened(kind: MathOrClericalErrorKind, y: TaxableYear) kind institutional {
    label en official "the scope of an existing section 6213(g)(2) category is widened for the taxable year by Pub. L. 119-21";
}
@source(us.irc.temporal::PL119_21_S70104, relation = derives_from, quote = "Section 6213(g)(2)(I) is amended by striking “section 24(e)” and inserting “section 24”")
rule S6213g2IChildTaxCreditTinAllOfSection24 defeasible {
    label en official "(g)(2)(I) covers the omission of a required TIN under any of section 24, not only section 24(e), for taxable years beginning after 2024";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2024-12-31;
    then math_error_category_scope_widened(OmittedChildTaxCreditTin, y);
}
@source(us.irc.temporal::PL119_21_S70606, relation = derives_from, quote = "Section 6213(g)(2)(J) is amended by striking “TIN” and inserting “social security number or employer identification number”")
rule S6213g2JEducationCreditSsnOrEin defeasible {
    label en official "(g)(2)(J) covers the omission of the social security number or employer identification number required by section 25A(g) for taxable years beginning after 2025";
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::begins(y, beginsOn)
        and beginsOn > @2025-12-31;
    then math_error_category_scope_widened(OmittedEducationCreditTin, y);
}

// ============================================================================
// Pub. L. 119-64 §2(a) — §6511(b)(2)(A): the extension addend
// ============================================================================

pub relation filing_extension_days_6081(p: Person, y: TaxableYear, k: TaxKind, days: Integer) kind institutional {
    label en unofficial "the period of the extension of time granted for filing the return (section 6081), in days";
}
rule S6511b2AExtensionDaysFrom6081 defeasible {
    label en official "the period of any extension of time for filing the return is the extended date minus the statutory due date";
    for r: Return;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for until: Date;
    for dueOn: Date;
    when us.irc.core::return_of(r, p, y, k)
        and us.irc.core::extension_granted(r, until)
        and us.irc.returns::statutory_due_date(p, y, k, dueOn)
        and until > dueOn;
    then filing_extension_days_6081(p, y, k, days_between(dueOn, until));
}
pub relation filing_extension_days_7508a(p: Person, y: TaxableYear, k: TaxKind, days: Integer) kind institutional {
    label en unofficial "the period disregarded under section 7508A for the time to file the return, treated as an extension of time for section 6511(b)(2)(A) (section 7508A(f), Pub. L. 119-64), in days";
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "any period disregarded under this section with respect to the time prescribed for filing any return of tax shall be treated as an extension of time for filing such return")
rule S7508AfPeriodDisregardedIsFilingExtension defeasible {
    label en official "for section 6511(b)(2)(A), a period disregarded under section 7508A is an extension of time for filing (claims filed after 2025-12-26; the claim-date test is in `us.irc.administration::return_extension_for_6511`)";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for original: Date;
    for extended: Date;
    when us.irc.administration::return_extension_for_6511(p, original, extended)
        and us.irc.returns::statutory_due_date(p, y, k, original)
        and extended > original;
    then filing_extension_days_7508a(p, y, k, days_between(original, extended));
}
pub relation exists_filing_extension_for_lookback(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "some extension of time for filing (section 6081 or a section 7508A period) is recorded";
}
rule S6511b2AExistsExtension6081 defeasible {
    label en unofficial "a section 6081 extension exists";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for days: Integer;
    when filing_extension_days_6081(p, y, k, days);
    then exists_filing_extension_for_lookback(p, y, k);
}
rule S6511b2AExistsExtension7508A defeasible {
    label en unofficial "a section 7508A period exists";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for days: Integer;
    when filing_extension_days_7508a(p, y, k, days);
    then exists_filing_extension_for_lookback(p, y, k);
}
@source(IRC_S6511_B, relation = formalizes, coverage = exact, quote = "equal to 3 years plus the period of any extension of time for filing the return")
rule S6511b2ALookbackPlusSection6081Extension defeasible {
    label en official "the look-back is 3 years plus the period of the section 6081 extension";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for threeYearEnd: Date;
    for extensionDays: Integer;
    for calendar_before_1: Date;
    when refund_claim_filed(p, y, k, filedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and filedOn <= threeYearEnd
        and filing_extension_days_6081(p, y, k, extensionDays)
        and us.irc.core::civil_calendar_boundary_before(filedOn, 3, us.irc.core::CalendarYear, calendar_before_1);
    then refund_amount_limit_three_year_lookback(p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn <= filedOn
                and days_between(paidOn, calendar_before_1) <= extensionDays);
}
@source(us.irc.temporal::PL119_64_S2, relation = derives_from, quote = "shall be treated as an extension of time for filing such return")
rule S6511b2ALookbackPlusSection7508AExtension defeasible {
    label en official "the look-back is 3 years plus a period disregarded under section 7508A, treated as an extension (Pub. L. 119-64)";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for threeYearEnd: Date;
    for extensionDays: Integer;
    for calendar_before_1: Date;
    when refund_claim_filed(p, y, k, filedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and filedOn <= threeYearEnd
        and filing_extension_days_7508a(p, y, k, extensionDays)
        and us.irc.core::civil_calendar_boundary_before(filedOn, 3, us.irc.core::CalendarYear, calendar_before_1);
    then refund_amount_limit_three_year_lookback(p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn <= filedOn
                and days_between(paidOn, calendar_before_1) <= extensionDays);
}
// JUDGMENT CALL: a section 6081 extension and a section 7508A period for the
// same return may both be recorded; each yields its own limit tuple and a
// consumer takes the larger (no max-over-derived, the same caveat module 04
// documents). The (b)(2)(A) window is applied on the payment date with
// `days_between(paidOn, filedOn - 3 years) <= extension days`, which is true
// for every payment inside the plain 3-year window as well.
