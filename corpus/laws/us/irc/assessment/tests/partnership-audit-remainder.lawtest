        assert pushout_correction_year_ends(entity_ref("urn:us:irc:assessment:clir#C1"), @2022-12-31) { id "f1"; origin case_input; }
        assert pushout_correction_return_due(entity_ref("urn:us:irc:assessment:clir#C1"), @2023-04-15) { id "f2"; origin case_input; }
        assert pushout_correction_of(entity_ref("urn:us:irc:assessment:clir#C2"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), 200.00 USD) { id "f3"; origin case_input; }
        assert pushout_correction_year_ends(entity_ref("urn:us:irc:assessment:clir#C2"), @2023-12-31) { id "f4"; origin case_input; }
        assert pushout_correction_return_due(entity_ref("urn:us:irc:assessment:clir#C2"), @2024-04-15) { id "f5"; origin case_input; }
        assert pushout_correction_of(entity_ref("urn:us:irc:assessment:clir#C3"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), 500.00 USD) { id "f6"; origin case_input; }
        assert pushout_correction_year_ends(entity_ref("urn:us:irc:assessment:clir#C3"), @2024-12-31) { id "f7"; origin case_input; }
        assert pushout_correction_return_due(entity_ref("urn:us:irc:assessment:clir#C3"), @2025-04-15) { id "f8"; origin case_input; }
        assert partner_statement_furnished(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), @2024-08-01) { id "f9"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2024")) { id "f10"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:us:irc:assessment:clir#Y2024"), @2024-01-01) { id "f11"; origin case_input; }
        assert us.irc.core::ends(entity_ref("urn:us:irc:assessment:clir#Y2024"), @2024-12-31) { id "f12"; origin case_input; }
    }
    // corrections of years ending before 2024-01-01: 300 + 200; the 2024 correction is not part of the aggregate
    evaluate truth(partner_pushout_tax_adjustment(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#Y2024"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

