        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2023-06-01) { id "f2"; origin case_input; }
    }
    evaluate truth(collected_while_barred_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2023-06-01));
    expect truth_status == NEITHER;
}

test "S7507C1-04-NO-BAR-NO-ERRONEOUS-COLLECTION" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f0"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01) { id "f1"; origin case_input; }
    }
    // The owner relation is not asserted: no bar, no deemed erroneous collection.
    evaluate truth(collected_while_barred_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01));
    expect truth_status == NEITHER;
}

test "S7507C1-05-REFUNDABLE-WHEN-CLAIM-TIMELY" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01) { id "f2"; origin case_input; }
        assert deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f3"; origin case_input; }
        assert refund_claim_filed(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2026-06-01) { id "f4"; origin case_input; }
    }
    // Paid 2024-06-01, three-year claim period from the deemed filing date ends 2027-04-15; claim filed 2026-06-01 is timely (section 6511(a)).
    evaluate truth(erroneous_collection_refundable_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7507C1-06-NOT-REFUNDABLE-WHEN-CLAIM-UNTIMELY" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01) { id "f2"; origin case_input; }
        assert deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f3"; origin case_input; }
        assert refund_claim_filed(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2028-01-01) { id "f4"; origin case_input; }
    }
    // Claim filed 2028-01-01 is after the period end 2027-04-15: the refund is subject to the limitation.
    evaluate truth(erroneous_collection_refundable_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD));
    expect truth_status == NEITHER;
}

test "S7507C4-01-ASSESSMENT-PERIOD-SUSPENDED-DURING-BAR-PLUS-90-DAYS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert insolvent_bank_bar_ended(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-12-31) { id "f2"; origin case_input; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R1"), entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1) { id "f3"; origin case_input; }
    }
    // Bar 2024-01-01 .. 2024-12-31 plus 90 days = 2025-03-31.
    evaluate truth(suspension_period(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, InsolventBankBar, @2024-01-01, @2025-03-31));
    expect truth_status == TRUE_ONLY;
}

test "S7507C4-02-SUSPENDED-DAYS-COUNT-FEEDS-ASSESSMENT-PERIOD" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert insolvent_bank_bar_ended(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-12-31) { id "f2"; origin case_input; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R1"), entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1) { id "f3"; origin case_input; }
    }
    // Exact calendar days between 2024-01-01 and 2025-03-31: 455 (2024 is a leap year).
    evaluate truth(assessment_period_suspended_days(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 455));
    expect truth_status == TRUE_ONLY;
}

