// Scenarios for section 7507(c)(1) and (c)(4) (WIRE-6, module 21-insolvent-bank-7507c.law): the assessment package reads the
// owner's bar `us.irc.administration::s7507_bars_assessment_or_collection` (asserted as a case input; its own derivation is
// tested in `administration`). Written from the text; NOT executed (owner's NO-HEAVY-CHECKS restriction) --
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "S7507C1-01-TAX-COLLECTED-WHILE-BARRED-IS-ERRONEOUS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01) { id "f2"; origin case_input; }
    }
    evaluate truth(collected_while_barred_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 700.00 USD, @2024-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S7507C1-02-EMPLOYMENT-TAX-CH21-OUTSIDE-SECTION-7507" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.administration::s7507_bars_assessment_or_collection(entity_ref("urn:us:irc:assessment:clir#BANK1")) { id "f0"; origin case_input; }
        assert insolvent_bank_bar_began(entity_ref("urn:us:irc:assessment:clir#BANK1"), @2024-01-01) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::FicaCh21, 700.00 USD, @2024-06-01) { id "f2"; origin case_input; }
    }
    // Subsection (d): chapter 21 is excepted.
    evaluate truth(collected_while_barred_7507(entity_ref("urn:us:irc:assessment:clir#BANK1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::FicaCh21, 700.00 USD, @2024-06-01));
    expect truth_status == NEITHER;
}

