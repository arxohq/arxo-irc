// --- §6201(c): child's tax deemed also assessed against the parent ---------

test "S6201-08-CHILD-TAX-DEEMED-ASSESSED-AGAINST-PARENT" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::assessment_of(entity_ref("urn:us:irc:assessment:clir#A4"), entity_ref("urn:us:irc:assessment:clir#CHILD1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 200.00 USD) { id "f0"; origin case_input; }
        assert includible_solely_by_reason_of_section_73a(entity_ref("urn:us:irc:assessment:clir#CHILD1"), entity_ref("urn:us:irc:assessment:clir#PARENT1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), 200.00 USD) { id "f1"; origin case_input; }
        assert child_did_not_pay(entity_ref("urn:us:irc:assessment:clir#CHILD1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), 200.00 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(deemed_properly_assessed_against_parent(entity_ref("urn:us:irc:assessment:clir#PARENT1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), 200.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §6201(d): burden of production on a third-party information dispute --

test "S6201-09-SECRETARY-BEARS-BURDEN-OF-PRODUCTION" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert reasonable_dispute_asserted(entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#ITEM1")) { id "f0"; origin adjudicated; }
        assert taxpayer_fully_cooperated(entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#ITEM1")) { id "f1"; origin case_input; }
    }
    evaluate truth(secretary_bears_burden_of_production(entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#ITEM1")));
    expect truth_status == TRUE_ONLY;
}

test "S6201-10-NO-BURDEN-SHIFT-WITHOUT-JUDGMENT" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
