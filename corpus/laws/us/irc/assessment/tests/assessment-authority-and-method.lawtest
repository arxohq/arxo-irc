// Scenarios for §6201 (assessment authority), §6203 (method of assessment),
// §6204 (supplemental assessments), package us.irc.assessment, module
// 01-assessment-authority-and-method.law. Written from the text; NOT
// executed in this stage (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified` per docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

// --- §6201(a) chapeau + (a)(1): general power narrowed to a mandatory duty -

test "S6201-01-SELF-REPORTED-TAX-ASSESS-DUTY-ACTIVE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert tax_determined_on_return(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(S6201MandatoryAssessSelfReportedTax, ACTIVE);
}

test "S6201-02-SELF-REPORTED-TAX-ASSESSED-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert tax_determined_on_return(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f0"; origin case_input; }
        assert us.irc.core::assessment_of(entity_ref("urn:us:irc:assessment:clir#A1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S6201MandatoryAssessSelfReportedTax, SATISFIED);
}

test "S6201-03-ASSESS-TAX-POWER-EXERCISED-EFFECT-CREATED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert tax_not_duly_paid(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert secretary_makes_assessment(entity_ref("urn:us:irc:assessment:clir#A1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(us.irc.core::assessment_of(entity_ref("urn:us:irc:assessment:clir#A1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §6201(a)(3): erroneous prepayment credit assessment --------------------

test "S6201-04-ERRONEOUS-PREPAYMENT-CREDIT-ASSESSED" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert overstated_prepayment_credit(entity_ref("urn:us:irc:assessment:clir#R1"), 800.00 USD) { id "f0"; origin case_input; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f1"; origin case_input; }
        assert secretary_makes_assessment(entity_ref("urn:us:irc:assessment:clir#A2"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 800.00 USD) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S6201AssessErroneousPrepaymentCredit, ACTIVE);
}

