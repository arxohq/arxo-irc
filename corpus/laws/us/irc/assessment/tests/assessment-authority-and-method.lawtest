// --- §6204: supplemental assessment within the period ----------------------

test "S6204-01-SUPPLEMENTAL-ASSESSMENT-WITHIN-PERIOD" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::assessment_of(entity_ref("urn:us:irc:assessment:clir#A6"), entity_ref("urn:us:irc:assessment:clir#P6"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 1000.00 USD) { id "f0"; origin case_input; }
        assert assessment_imperfect_or_incomplete(entity_ref("urn:us:irc:assessment:clir#A6")) { id "f1"; origin case_input; }
        assert secretary_makes_assessment(entity_ref("urn:us:irc:assessment:clir#A7"), entity_ref("urn:us:irc:assessment:clir#P6"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 1200.00 USD) { id "f2"; origin case_input; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:assessment:clir#A7"), @2026-06-01) { id "f3"; origin case_input; }
        assert within_assessment_period(entity_ref("urn:us:irc:assessment:clir#P6"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, @2026-06-01) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S6204SupplementalAssessment, ACTIVE);
}
