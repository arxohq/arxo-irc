            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.exempt_organizations::section_507a_voluntary_termination_notice_given(entity_ref("urn:test:w10das2:a4#o"), entity_ref("urn:test:w10das2:a4#y")) { origin case_input; }
    }
    evaluate truth(assessment_period_unlimited(entity_ref("urn:test:w10das2:a4#o"), entity_ref("urn:test:w10das2:a4#y"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

