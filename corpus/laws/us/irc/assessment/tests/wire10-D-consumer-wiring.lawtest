// Assessment WIRE-10 group D consumer-wiring scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "W10-D-AS-01-IMPUTED-UNDERPAYMENT-USES-THE-SECTION-1-RATE-FROM-INCOME-INDIVIDUAL" {
    given {
        context {
            legal_time @2026-04-01;
            decision_time @2026-04-01T09:00:00-05:00;
            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10das:a1#y"), @2024-01-01) { origin case_input; }
        assert "f1": partnership_adjustment_item(entity_ref("urn:test:w10das:a1#ps"), entity_ref("urn:test:w10das:a1#y"), IncomeGainLossOrDeductionItems, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(imputed_underpayment(entity_ref("urn:test:w10das:a1#ps"), entity_ref("urn:test:w10das:a1#y"), 37000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-AS-02-NO-SECTION-1-RATE-FOR-A-YEAR-BEFORE-2018-LEAVES-THE-CASE-FACT-CHANNEL" {
    given {
        context {
            legal_time @2026-04-01;
            decision_time @2026-04-01T09:00:00-05:00;
            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::begins(entity_ref("urn:test:w10das:a2#y"), @2016-01-01) { origin case_input; }
        assert "f1": partnership_adjustment_item(entity_ref("urn:test:w10das:a2#ps"), entity_ref("urn:test:w10das:a2#y"), IncomeGainLossOrDeductionItems, 100000.00 USD) { origin case_input; }
    }
    evaluate truth(highest_section_1_rate_for_reviewed_year(entity_ref("urn:test:w10das:a2#y"), 0.37));
    expect truth_status == FALSE_ONLY;
}

