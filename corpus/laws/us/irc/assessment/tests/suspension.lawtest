// Scenarios for §6503 (suspension of the running of the period of
// limitation), package us.irc.assessment, module 05-suspension.law.
// Written from the text; NOT executed in this stage (owner's
// NO-HEAVY-CHECKS restriction) — `implemented_unverified` per
// AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

// --- §6503(a)(1): suspended during the petition window, plus 60 days ------

test "S6503-01-SUSPENDED-DURING-PETITION-WINDOW-PLUS-60-DAYS" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N1"), @2026-01-05) { id "f1"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), @2026-04-06) { id "f2"; origin case_input; }
    }
    // §6503(a)(1) tail: deadline + 60 days = June 5, 2026.
    evaluate truth(suspension_period(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, PetitionWindow, @2026-01-05, @2026-06-05));
    expect truth_status == TRUE_ONLY;
}

// --- Two overlapping suspensions counted once (PLAN §7 capability probe) --

test "S6503-02-TWO-OVERLAPPING-SUSPENSIONS-COUNTED-ONCE" {
    given {
        context { decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; legal_time @2026-08-01; timezone "America/New_York"; }
        // Suspension #1 (petition window + 60 days): Jan 5 - Jun 5, 2026 (151 days).
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N2"), entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N2"), @2026-01-05) { id "f1"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N2"), entity_ref("urn:us:irc:assessment:clir#P2"), @2026-04-06) { id "f2"; origin case_input; }
        // Suspension #2 (bankruptcy, overlapping): Mar 1 - Jul 1, 2026, plus
        // 60 days -> Aug 30, 2026; the two intervals overlap between
        // Mar 1 and Jun 5.
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R2"), entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f3"; origin case_input; }
        assert bankruptcy_case_pending(entity_ref("urn:us:irc:assessment:clir#P2"), @2026-07-01) { id "f4"; origin case_input; }
        assert bankruptcy_case_started(entity_ref("urn:us:irc:assessment:clir#P2"), @2026-03-01) { id "f5"; origin case_input; }
    }
    // Union of [Jan 5, Jun 5] (151 days) and [Mar 1, Aug 30] (182 days),
    // overlap [Mar 1, Jun 5] (96 days): 151 + 182 - 96 = 237 days — NOT
    // 151 + 182 = 333 (which would double-count the overlap).
    evaluate truth(two_suspensions_overlap(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

test "S6503-03-SINGLE-SUSPENSION-DAY-COUNT-NOT-A-UNION" {
    given {
        context { decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; legal_time @2026-08-01; timezone "America/New_York"; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N3"), @2026-01-05) { id "f1"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), @2026-04-06) { id "f2"; origin case_input; }
    }
    evaluate truth(assessment_period_suspended_days(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, 151));
    expect truth_status == TRUE_ONLY;
}

// --- §6503(a)(2): consolidated-return group member --------------------------

test "S6503-04-SUSPENSION-EXTENDS-TO-CONSOLIDATED-GROUP-MEMBER" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#FILER4"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N4"), @2026-01-05) { id "f1"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#FILER4"), @2026-04-06) { id "f2"; origin case_input; }
        assert consolidated_return_group_member(entity_ref("urn:us:irc:assessment:clir#MEMBER4"), entity_ref("urn:us:irc:assessment:clir#FILER4"), entity_ref("urn:us:irc:assessment:clir#Y2022")) { id "f3"; origin case_input; }
    }
    evaluate truth(suspension_period(entity_ref("urn:us:irc:assessment:clir#MEMBER4"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, PetitionWindow, @2026-01-05, @2026-06-05));
    expect truth_status == TRUE_ONLY;
}
