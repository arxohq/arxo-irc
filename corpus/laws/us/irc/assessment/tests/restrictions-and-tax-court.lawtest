// Scenarios for §6213 (restrictions on assessment; petition to Tax Court),
// §6214 (Tax Court jurisdiction), §6215 (assessment after Tax Court decision),
// package us.irc.assessment, module 03-restrictions-and-tax-court.law.
// Written from the text; NOT executed in this stage (owner's NO-HEAVY-CHECKS
// restriction) — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

// --- §6213(a): 90-day petition window, domestic notice ----------------------

test "S6213-01-PETITION-WINDOW-90-DAYS-DOMESTIC-NOT-ROLLED" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1")) { id "f0"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N1"), @2026-01-05) { id "f1"; origin case_input; }
        assert us.irc.administration::last_day_rolled(@2026-04-05, @2026-04-06) { id "f2"; origin case_input; }
    }
    // Jan 5 + 90 days = Apr 5, 2026 (a Sunday) rolls to Apr 6 (Monday).
    evaluate truth(petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), @2026-04-06));
    expect truth_status == TRUE_ONLY;
}

test "S6213-02-PETITION-WINDOW-150-DAYS-ADDRESSED-ABROAD" {
    given {
        context { decision_time @2026-01-05T09:00:00-05:00; knowledge_time @2026-01-05T09:00:00-05:00; legal_time @2026-01-05; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N2"), entity_ref("urn:us:irc:assessment:clir#P2")) { id "f0"; origin case_input; }
        assert addressed_outside_united_states(entity_ref("urn:us:irc:assessment:clir#N2")) { id "f1"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N2"), @2026-01-05) { id "f2"; origin case_input; }
        assert us.irc.administration::last_day_rolled(@2026-06-04, @2026-06-04) { id "f3"; origin case_input; }
    }
    evaluate truth(petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N2"), entity_ref("urn:us:irc:assessment:clir#P2"), @2026-06-04));
    expect truth_status == TRUE_ONLY;
}

// --- Assessment inside the window: blocked; after the window: allowed -----

test "S6213-03-ASSESSMENT-BLOCKED-DURING-PETITION-WINDOW" {
    given {
        context { decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; legal_time @2026-02-01; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3")) { id "f0"; origin case_input; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f1"; origin case_input; }
        assert us.irc.core::mailed_on(entity_ref("urn:us:irc:assessment:clir#N3"), @2026-01-05) { id "f2"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), @2026-04-06) { id "f3"; origin case_input; }
        assert secretary_makes_assessment(entity_ref("urn:us:irc:assessment:clir#A3"), entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 3000.00 USD) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect position(S6213RestrictedDuringPetitionWindow, ACTIVE);
}

test "S6213-04-ASSESSMENT-ALLOWED-AFTER-WINDOW-EXPIRES-NO-PETITION" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3")) { id "f0"; origin case_input; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f1"; origin case_input; }
        assert deficiency_amount(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 3000.00 USD) { id "f2"; origin case_input; }
        assert petition_window_deadline(entity_ref("urn:us:irc:assessment:clir#N3"), entity_ref("urn:us:irc:assessment:clir#P3"), @2026-04-06) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(S6213AssessAfterPetitionWindowExpiresWithoutPetition, ACTIVE);
}

// --- §6213(b)(1)-(2): math error notice + 60-day abatement request ---------

test "S6213-05-MATH-ERROR-NOTICE-NOT-A-DEFICIENCY-NOTICE" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert math_error_notice_given(entity_ref("urn:us:irc:assessment:clir#N7"), entity_ref("urn:us:irc:assessment:clir#P7"), ArithmeticError, 400.00 USD, @2026-02-01) { id "f0"; origin case_input; }
        assert math_error_notice_sets_forth_error_and_explanation(entity_ref("urn:us:irc:assessment:clir#N7")) { id "f1"; origin case_input; }
        assert deficiency_notice_for(entity_ref("urn:us:irc:assessment:clir#N7"), entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
    }
    evaluate truth(math_error_assessment_permitted(entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

test "S6213-06-ABATEMENT-REQUEST-WITHIN-60-DAYS-POWER-VALID" {
    given {
        context { decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; legal_time @2026-03-15; timezone "America/New_York"; }
        assert requests_math_error_abatement(entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#N7"), @2026-03-15) { id "f0"; origin case_input; }
        assert math_error_notice_given(entity_ref("urn:us:irc:assessment:clir#N7"), entity_ref("urn:us:irc:assessment:clir#P7"), ArithmeticError, 400.00 USD, @2026-02-01) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S6213AbatementRequest, ACTIVE);
}

test "S6213-07-ABATEMENT-REQUEST-AFTER-60-DAYS-NOT-VALID" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert requests_math_error_abatement(entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#N7"), @2026-05-01) { id "f0"; origin case_input; }
        assert math_error_notice_given(entity_ref("urn:us:irc:assessment:clir#N7"), entity_ref("urn:us:irc:assessment:clir#P7"), ArithmeticError, 400.00 USD, @2026-02-01) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect not position(S6213AbatementRequest, ACTIVE);
}

// --- §6213(d): waiver of restrictions ---------------------------------------

test "S6213-08-WAIVER-OF-RESTRICTIONS-POWER-EXERCISED" {
    given {
        context { decision_time @2026-02-15T09:00:00-05:00; knowledge_time @2026-02-15T09:00:00-05:00; legal_time @2026-02-15; timezone "America/New_York"; }
        assert signed_written_waiver_filed(entity_ref("urn:us:irc:assessment:clir#P8"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(restrictions_waived(entity_ref("urn:us:irc:assessment:clir#P8"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 5000.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §6214(a): Tax Court jurisdiction to redetermine a greater deficiency --

test "S6214-01-TAX-COURT-REDETERMINES-GREATER-DEFICIENCY" {
    given {
        context { decision_time @2026-09-01T09:00:00-05:00; knowledge_time @2026-09-01T09:00:00-05:00; legal_time @2026-09-01; timezone "America/New_York"; }
        assert petition_filed_timely(entity_ref("urn:us:irc:assessment:clir#PR9"), entity_ref("urn:us:irc:assessment:clir#N9"), entity_ref("urn:us:irc:assessment:clir#P9")) { id "f0"; origin case_input; }
        assert secretary_asserts_greater_deficiency_at_hearing(entity_ref("urn:us:irc:assessment:clir#PR9"), entity_ref("urn:us:irc:assessment:clir#P9"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 9000.00 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(redetermined_deficiency(entity_ref("urn:us:irc:assessment:clir#PR9"), entity_ref("urn:us:irc:assessment:clir#P9"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 9000.00 USD));
    expect truth_status == TRUE_ONLY;
}

