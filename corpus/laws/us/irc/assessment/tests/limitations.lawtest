}

// --- §6501(e)(1)(A)(i): substantial omission — exactly 25% boundary --------

test "S6501-06-OMISSION-EXACTLY-25-PERCENT-NOT-SUBSTANTIAL" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R6"), entity_ref("urn:us:irc:assessment:clir#P6"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert gross_income_stated_on_return(entity_ref("urn:us:irc:assessment:clir#R6"), 40000.00 USD) { id "f1"; origin case_input; }
        assert amount_omitted_from_gross_income(entity_ref("urn:us:irc:assessment:clir#R6"), 10000.00 USD) { id "f2"; origin case_input; }
    }
    // 10000 is EXACTLY 25% of 40000 — the statute requires "in excess of 25
    // percent", so the 6-year rule does NOT apply at the exact boundary.
    evaluate truth(substantial_omission_from_gross_income(entity_ref("urn:us:irc:assessment:clir#P6"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1));
    expect truth_status == NEITHER;
}

test "S6501-07-OMISSION-JUST-OVER-25-PERCENT-TRIGGERS-SIX-YEAR-PERIOD" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R7"), entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert gross_income_stated_on_return(entity_ref("urn:us:irc:assessment:clir#R7"), 40000.00 USD) { id "f1"; origin case_input; }
        assert amount_omitted_from_gross_income(entity_ref("urn:us:irc:assessment:clir#R7"), 10000.01 USD) { id "f2"; origin case_input; }
        assert deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2023-04-18) { id "f3"; origin case_input; }
    }
    evaluate truth(assessment_period_ends(entity_ref("urn:us:irc:assessment:clir#P7"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2029-04-18));
    expect truth_status == TRUE_ONLY;
}

// --- §6501(e)(1)(A)(ii): foreign asset omission exceeding $5,000 ------------

test "S6501-08-FOREIGN-ASSET-OMISSION-OVER-5000-TRIGGERS-SIX-YEAR-PERIOD" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R8"), entity_ref("urn:us:irc:assessment:clir#P8"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert amount_omitted_from_gross_income(entity_ref("urn:us:irc:assessment:clir#R8"), 5000.01 USD) { id "f1"; origin case_input; }
        assert omitted_amount_attributable_to_6038d_asset(entity_ref("urn:us:irc:assessment:clir#R8")) { id "f2"; origin case_input; }
    }
    evaluate truth(substantial_omission_from_gross_income(entity_ref("urn:us:irc:assessment:clir#P8"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

