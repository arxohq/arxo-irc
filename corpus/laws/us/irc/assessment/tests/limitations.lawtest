// Scenarios for §6501 (limitations on assessment), package
// us.irc.assessment, module 04-limitations.law. Written from the text;
// NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

// --- §6501(a)/(b)(1): 3-year period from actual filing date -----------------

test "S6501-01-THREE-YEAR-PERIOD-FROM-ACTUAL-FILING-DATE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R1"), entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_on(entity_ref("urn:us:irc:assessment:clir#R1"), @2023-04-15) { id "f1"; origin case_input; }
    }
    evaluate truth(deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2023-04-15));
    expect truth_status == TRUE_ONLY;
}

test "S6501-02-EARLY-FILED-RETURN-DEEMED-FILED-ON-DUE-DATE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R2"), entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert us.irc.core::filed_on(entity_ref("urn:us:irc:assessment:clir#R2"), @2023-02-01) { id "f1"; origin case_input; }
        assert us.irc.core::due_date(entity_ref("urn:us:irc:assessment:clir#R2"), @2023-04-18) { id "f2"; origin case_input; }
    }
    // Filed Feb 1, before the April 18 statutory due date — deemed filed on
    // the due date itself (§6501(b)(1)), not the actual (earlier) filing date.
    evaluate truth(deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2023-04-18));
    expect truth_status == TRUE_ONLY;
}

test "S6501-03-THREE-YEAR-PERIOD-ENDS-EXACTLY-ON-BOUNDARY" {
    given {
        context { decision_time @2026-04-18T09:00:00-05:00; knowledge_time @2026-04-18T09:00:00-05:00; legal_time @2026-04-18; timezone "America/New_York"; }
        assert deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2023-04-18) { id "f0"; origin case_input; }
    }
    evaluate truth(assessment_period_ends(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2026-04-18));
    expect truth_status == TRUE_ONLY;
}

// --- §6501(c)(1)-(3): fraud, willful evasion, no return -> no limitation ---

