    given {
        context { decision_time @2030-01-01T09:00:00-05:00; knowledge_time @2030-01-01T09:00:00-05:00; legal_time @2030-01-01; timezone "America/New_York"; }
        assert no_return_filed(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
    }
    evaluate truth(assessment_period_unlimited(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1));
    expect truth_status == TRUE_ONLY;
}

