// --- The time-bar immunity: blocked after the period ends -------------------

test "S6501-11-ASSESSMENT-BARRED-AFTER-PERIOD-ENDS" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert assessment_period_ends(entity_ref("urn:us:irc:assessment:clir#P11"), entity_ref("urn:us:irc:assessment:clir#Y2020"), us.irc.core::IncomeCh1, @2024-04-15) { id "f0"; origin case_input; }
        assert secretary_makes_assessment(entity_ref("urn:us:irc:assessment:clir#A11"), entity_ref("urn:us:irc:assessment:clir#P11"), entity_ref("urn:us:irc:assessment:clir#Y2020"), us.irc.core::IncomeCh1, 500.00 USD) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(S6501AssessmentBarredAfterPeriodEnds, ACTIVE);
}
