        assert assessment_period_ends(entity_ref("urn:us:irc:assessment:clir#P9"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1, @2026-04-18) { id "f1"; origin case_input; }
