// WIRE-10 group A scenarios for module 96-wire10-A-assessment.law (section 5703(d) read by the section 6201/6501 machinery). NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "W10A-AS-01-OMITTED-CHAPTER-52-TAX-IS-A-TAX-NOT-DULY-PAID" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.tobacco_firearms::tobacco_tax_omitted_from_payment(entity_ref("urn:test:w10a:as1#e"), entity_ref("urn:test:w10a:as1#p"), 500.00 USD) { origin case_input; }
        assert "f1": us.irc.tobacco_firearms::tobacco_event_taxable_year(entity_ref("urn:test:w10a:as1#e"), entity_ref("urn:test:w10a:as1#y")) { origin case_input; }
    }
    evaluate truth(tax_not_duly_paid(entity_ref("urn:test:w10a:as1#p"), entity_ref("urn:test:w10a:as1#y"), us.irc.core::TobaccoExciseCh52));
    expect truth_status == TRUE_ONLY;
}

test "W10A-AS-02-THE-ASSESSMENT-MADE-AT-CHAPTER-52-IS-THE-6201-ACT" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.tobacco_firearms::tobacco_assessment_made(entity_ref("urn:test:w10a:as2#e"), entity_ref("urn:test:w10a:as2#p"), entity_ref("urn:test:w10a:as2#a"), 500.00 USD) { origin case_input; }
        assert "f1": us.irc.tobacco_firearms::tobacco_event_taxable_year(entity_ref("urn:test:w10a:as2#e"), entity_ref("urn:test:w10a:as2#y")) { origin case_input; }
    }
    evaluate truth(secretary_makes_assessment(entity_ref("urn:test:w10a:as2#a"), entity_ref("urn:test:w10a:as2#p"), entity_ref("urn:test:w10a:as2#y"), us.irc.core::TobaccoExciseCh52, 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "W10A-AS-03-EVENT-CONSIDERED-AFTER-THE-PERIOD-END-IS-BARRED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.tobacco_firearms::tobacco_event_taxable_year(entity_ref("urn:test:w10a:as3#e"), entity_ref("urn:test:w10a:as3#y")) { origin case_input; }
        assert "f1": us.irc.tobacco_firearms::tobacco_assessment_considered_on(entity_ref("urn:test:w10a:as3#e"), @2026-06-01) { origin case_input; }
        assert "f2": assessment_period_ends(entity_ref("urn:test:w10a:as3#p"), entity_ref("urn:test:w10a:as3#y"), us.irc.core::TobaccoExciseCh52, @2026-01-31) { origin case_input; }
    }
    evaluate truth(us.irc.tobacco_firearms::tobacco_assessment_barred_by_6501(entity_ref("urn:test:w10a:as3#e"), entity_ref("urn:test:w10a:as3#p")));
    expect truth_status == TRUE_ONLY;
}

test "W10A-AS-04-EVENT-CONSIDERED-BEFORE-THE-PERIOD-END-IS-NOT-BARRED" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.tobacco_firearms::tobacco_event_taxable_year(entity_ref("urn:test:w10a:as4#e"), entity_ref("urn:test:w10a:as4#y")) { origin case_input; }
        assert "f1": us.irc.tobacco_firearms::tobacco_assessment_considered_on(entity_ref("urn:test:w10a:as4#e"), @2026-06-01) { origin case_input; }
        assert "f2": assessment_period_ends(entity_ref("urn:test:w10a:as4#p"), entity_ref("urn:test:w10a:as4#y"), us.irc.core::TobaccoExciseCh52, @2027-01-31) { origin case_input; }
    }
    evaluate truth(us.irc.tobacco_firearms::tobacco_assessment_barred_by_6501(entity_ref("urn:test:w10a:as4#e"), entity_ref("urn:test:w10a:as4#p")));
    expect truth_status == NEITHER;
}
