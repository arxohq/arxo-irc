test "S6511B2A-01-LOOKBACK-PLUS-SECTION-6081-EXTENSION" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert refund_claim_filed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2027-01-15) { id "f0"; origin case_input; }
        assert deemed_filed_date_for_refund(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 1000.00 USD, @2023-10-01) { id "f2"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 500.00 USD, @2023-06-01) { id "f3"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 2000.00 USD, @2025-01-01) { id "f4"; origin case_input; }
        assert filing_extension_days_6081(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 183) { id "f5"; origin case_input; }
    }
    // payment on 2023-10-01 is 106 days before 2024-01-15 (within 183 extension days); 2023-06-01 is 228 days before (outside)
    evaluate truth(refund_amount_limit_three_year_lookback(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6511B2A-02-LOOKBACK-WITHOUT-EXTENSION-KEEPS-PLAIN-THREE-YEARS" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert refund_claim_filed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2027-01-15) { id "f0"; origin case_input; }
        assert deemed_filed_date_for_refund(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 1000.00 USD, @2023-10-01) { id "f2"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 500.00 USD, @2023-06-01) { id "f3"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 2000.00 USD, @2025-01-01) { id "f4"; origin case_input; }
    }
    // no extension recorded: only the payment of 2025-01-01 is inside the plain 3-year window
    evaluate truth(refund_amount_limit_three_year_lookback(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 2000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6511B2A-03-LOOKBACK-PLUS-SECTION-7508A-PERIOD" {
    given {
        context { decision_time @2027-02-01T09:00:00-05:00; knowledge_time @2027-02-01T09:00:00-05:00; legal_time @2027-02-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert refund_claim_filed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2027-01-15) { id "f0"; origin case_input; }
        assert deemed_filed_date_for_refund(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f1"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 1000.00 USD, @2023-10-01) { id "f2"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 500.00 USD, @2023-06-01) { id "f3"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 2000.00 USD, @2025-01-01) { id "f4"; origin case_input; }
        assert us.irc.administration::return_extension_for_6511(entity_ref("urn:us:irc:assessment:clir#P1"), @2024-04-15, @2024-10-15) { id "f5"; origin case_input; }
        assert us.irc.returns::statutory_due_date(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f6"; origin case_input; }
    }
    // Pub. L. 119-64 section 2(a): a period disregarded under section 7508A is treated as an extension of time for filing (183 days from 2024-04-15 to 2024-10-15)
    evaluate truth(refund_amount_limit_three_year_lookback(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 3000.00 USD));
    expect truth_status == TRUE_ONLY;
}

