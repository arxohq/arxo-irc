        context { decision_time @2027-08-01T09:00:00-05:00; knowledge_time @2027-08-01T09:00:00-05:00; legal_time @2027-08-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert math_error_notice_given(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), ArithmeticError, 400.00 USD, @2026-01-05) { id "f0"; origin case_input; }
        assert math_error_notice_sets_forth_error_and_explanation(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f1"; origin case_input; }
