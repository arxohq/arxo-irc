// Written from the text; NOT executed (implemented_unverified). Stage 3, 26.09.2026.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "S6213B1B-01-NOTICE-AFTER-2026-11-25-SPECIFIC-VALID" {
    given {
        context { decision_time @2027-01-10T09:00:00-05:00; knowledge_time @2027-01-10T09:00:00-05:00; legal_time @2027-01-10; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert math_error_notice_given(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), ArithmeticError, 400.00 USD, @2027-01-05) { id "f0"; origin case_input; }
        assert math_error_notice_sets_forth_error_and_explanation(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f1"; origin case_input; }
        assert us.irc.core::address_last_known(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f2"; origin case_input; }
        assert math_error_notice_states_error_type(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f3"; origin case_input; }
        assert math_error_notice_states_code_section(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f4"; origin case_input; }
        assert math_error_notice_describes_nature_of_error(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f5"; origin case_input; }
        assert math_error_notice_states_return_line(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f6"; origin case_input; }
        assert math_error_notice_itemized_computation(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f7"; origin case_input; }
        assert math_error_notice_includes_transcript_phone_number(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f8"; origin case_input; }
        assert math_error_notice_displays_abatement_date_prominently(entity_ref("urn:us:irc:assessment:clir#N1")) { id "f9"; origin case_input; }
    }
    evaluate truth(math_error_notice_valid(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1")));
    expect truth_status == TRUE_ONLY;
}

