// Scenarios for §6205 (interest-free adjustments of employment tax),
// package us.irc.assessment, module
// 09-employment-tax-interest-free-adjustments.law. Written from the text;
// NOT executed in this stage (NO-HEAVY-CHECKS) — `implemented_unverified`
// per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "S6205-01-INTEREST-FREE-ADJUSTMENT-VALID-ON-UNDERPAYMENT" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert less_than_correct_amount_paid(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD, 400.00 USD) { id "f0"; origin case_input; }
        assert interest_free_adjustment_made(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD, 400.00 USD, @2026-03-01) { id "f1"; origin case_input; }
    }
    evaluate truth(employment_tax_adjusted_without_interest(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6205-02-NO-ADJUSTMENT-WHEN-FULL-AMOUNT-ALREADY-PAID" {
    given {
        context { decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; legal_time @2026-03-01; timezone "America/New_York"; }
        assert less_than_correct_amount_paid(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD, 500.00 USD) { id "f0"; origin case_input; }
        assert interest_free_adjustment_made(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD, 500.00 USD, @2026-03-01) { id "f1"; origin case_input; }
    }
    // actualAmount == correctAmount: no shortfall, so `interest_free_adjustment_valid`'s
    // condition (actualAmount < correctAmount) is not satisfied.
    evaluate truth(employment_tax_adjusted_without_interest(entity_ref("urn:us:irc:assessment:clir#EMPLOYER1"), us.irc.core::FicaCh21, @2026-01-15, 500.00 USD));
    expect truth_status == NEITHER;
}
