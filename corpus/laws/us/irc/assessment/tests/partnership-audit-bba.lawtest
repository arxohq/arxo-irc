test "S6221-01-ELECTION-OUT-VALID-WITH-100-OR-FEWER-PARTNERS" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert election_out_partner_count(entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), 60) { id "f0"; origin case_input; }
        assert election_out_all_partners_eligible_type(entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f1"; origin case_input; }
        assert election_out_made_with_timely_return(entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f2"; origin case_input; }
        assert election_out_partners_notified(entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f3"; origin case_input; }
    }
    evaluate truth(election_out_of_bba_effective(entity_ref("urn:us:irc:assessment:clir#PS1"), entity_ref("urn:us:irc:assessment:clir#Y2025")));
    expect truth_status == TRUE_ONLY;
}

test "S6221-02-ELECTION-OUT-INVALID-OVER-100-PARTNERS" {
    given {
        context { decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; legal_time @2026-04-01; timezone "America/New_York"; }
        assert election_out_partner_count(entity_ref("urn:us:irc:assessment:clir#PS2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), 150) { id "f0"; origin case_input; }
        assert election_out_all_partners_eligible_type(entity_ref("urn:us:irc:assessment:clir#PS2"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f1"; origin case_input; }
        assert election_out_made_with_timely_return(entity_ref("urn:us:irc:assessment:clir#PS2"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f2"; origin case_input; }
        assert election_out_partners_notified(entity_ref("urn:us:irc:assessment:clir#PS2"), entity_ref("urn:us:irc:assessment:clir#Y2025")) { id "f3"; origin case_input; }
    }
    // more than 100 statements required — (b)(1)(B) fails, so the
    // election-out conditions are never met and the default partnership-
    // level determination stands (BBA applies).
    evaluate truth(election_out_of_bba_effective(entity_ref("urn:us:irc:assessment:clir#PS2"), entity_ref("urn:us:irc:assessment:clir#Y2025")));
    expect truth_status == NEITHER;
}

