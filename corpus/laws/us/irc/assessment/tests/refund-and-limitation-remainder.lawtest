    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert amount_erroneously_treated_as_se_income_or_wages(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023")) { id "f0"; origin case_input; }
        assert correction_requires_assessment_of_one_and_refund_of_other(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023")) { id "f1"; origin case_input; }
        assert correction_prevented_as_to_other_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), EmployeeFicaTax3101) { id "f2"; origin case_input; }
        assert authorized_correction_amount(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), 1000.00 USD) { id "f3"; origin case_input; }
        assert prevented_correction_amount(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), 300.00 USD) { id "f4"; origin case_input; }
    }
    evaluate truth(reduced_correction_amount(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), 700.00 USD));
    expect truth_status == TRUE_ONLY;
}

