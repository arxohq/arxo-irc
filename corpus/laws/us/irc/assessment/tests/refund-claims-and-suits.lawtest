// Scenarios for §§6511, 6513, 6532 (refund claims and suits), package
// us.irc.assessment, module 08-refund-claims-and-suits.law. Written from
// the text; NOT executed in this stage (NO-HEAVY-CHECKS) —
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "S6511-01-THREE-YEAR-PERIOD-WHEN-LATER-THAN-TWO-YEAR" {
    given {
        context { decision_time @2027-01-01T09:00:00-05:00; knowledge_time @2027-01-01T09:00:00-05:00; legal_time @2027-01-01; timezone "America/New_York"; }
        assert deemed_filed_date(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2024-04-15) { id "f0"; origin case_input; }
        assert amount_paid_as_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, 5000.00 USD, @2024-04-15) { id "f1"; origin case_input; }
    }
    // three-year end (2027-04-15) is later than two-year end (2026-04-15).
    evaluate truth(refund_claim_period_ends(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2023"), us.irc.core::IncomeCh1, @2027-04-15));
    expect truth_status == TRUE_ONLY;
}

