        context { decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; legal_time @2026-09-26; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert notice_of_proposed_partnership_adjustment_mailed(entity_ref("urn:us:irc:assessment:clir#PS137"), entity_ref("urn:us:irc:assessment:clir#Y2022"), @2025-06-01) { id "f0"; origin case_input; }
        assert bba_modification_submission_complete_on(entity_ref("urn:us:irc:assessment:clir#PS137"), entity_ref("urn:us:irc:assessment:clir#Y2022"), @2026-02-27) { id "f1"; origin case_input; }
        assert secretary_approves_modification(entity_ref("urn:us:irc:assessment:clir#PS137"), entity_ref("urn:us:irc:assessment:clir#Y2022")) { id "f2"; origin case_input; }
    }
    evaluate truth(modification_approved(entity_ref("urn:us:irc:assessment:clir#PS137"), entity_ref("urn:us:irc:assessment:clir#Y2022")));
    expect truth_status == NEITHER;
}

// --- The modified imputed underpayment -------------------------------------
test "S6225-88-MODIFIED-IMPUTED-UNDERPAYMENT-LEAVES-OUT-PORTIONS-AND-ADDS-LOWER-RATE-TAX" {
    given {
        context { decision_time @2026-09-26T09:00:00-05:00; knowledge_time @2026-09-26T09:00:00-05:00; legal_time @2026-09-26; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert partnership_adjustment_item(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), IncomeGainLossOrDeductionItems, 100000.00 USD) { id "f0"; origin case_input; }
        assert applicable_highest_rate_for_reviewed_year(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), 0.37) { id "f1"; origin case_input; }
        assert notice_of_proposed_partnership_adjustment_mailed(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), @2025-06-01) { id "f2"; origin case_input; }
        assert bba_modification_submission_complete_on(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), @2026-02-01) { id "f3"; origin case_input; }
        assert secretary_approves_modification(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022")) { id "f4"; origin case_input; }
        assert partner_paid_amounts_in_lieu_of_returns(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT40")) { id "f5"; origin case_input; }
        assert partner_agrees_to_take_tax_attributes_into_account(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT40")) { id "f6"; origin case_input; }
        assert partner_provides_required_information(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT40")) { id "f7"; origin case_input; }
        assert partner_adjustment_portion_taken_into_account(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT40"), 20000.00 USD) { id "f8"; origin case_input; }
        assert partnership_demonstrates_allocable_lower_rate_portion(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT41"), CCorporationPartner) { id "f9"; origin case_input; }
        assert partner_is_c_corporation(entity_ref("urn:us:irc:assessment:clir#PT41")) { id "f10"; origin case_input; }
        assert procedure_lower_rate(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), CCorporationPartner, 0.21) { id "f11"; origin case_input; }
        assert highest_rate_in_effect_for_income_and_taxpayer(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), CCorporationPartner, 0.21) { id "f12"; origin case_input; }
        assert partner_distributive_share_portion(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), entity_ref("urn:us:irc:assessment:clir#PT41"), 30000.00 USD) { id "f13"; origin case_input; }
    }
    evaluate truth(modified_imputed_underpayment(entity_ref("urn:us:irc:assessment:clir#PS140"), entity_ref("urn:us:irc:assessment:clir#Y2022"), 24800.00 USD));
    expect truth_status == TRUE_ONLY;
}

