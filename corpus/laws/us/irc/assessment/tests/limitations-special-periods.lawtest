        assert ira_tax_attributable_to_acquiring_property_below_fmv(entity_ref("urn:us:irc:assessment:clir#I3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::QualifiedPlansExciseCh43) { id "f2"; origin case_input; }
        assert liability_arises_from_act_in_year(entity_ref("urn:us:irc:assessment:clir#I3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::QualifiedPlansExciseCh43, entity_ref("urn:us:irc:assessment:clir#Y2022")) { id "f3"; origin case_input; }
        assert us.irc.core::return_of(entity_ref("urn:us:irc:assessment:clir#R43"), entity_ref("urn:us:irc:assessment:clir#I3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::IncomeCh1) { id "f4"; origin case_input; }
    }
    evaluate truth(ira_income_tax_return_of_record(entity_ref("urn:us:irc:assessment:clir#R43"), entity_ref("urn:us:irc:assessment:clir#I3"), entity_ref("urn:us:irc:assessment:clir#Y2022"), us.irc.core::QualifiedPlansExciseCh43));
    expect truth_status == NEITHER;
}

