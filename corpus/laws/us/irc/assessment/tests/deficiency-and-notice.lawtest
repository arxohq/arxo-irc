// Scenarios for §6211 (definition of a deficiency), §6212 (notice of
// deficiency), package us.irc.assessment, module 02-deficiency-and-notice.law.
// Written from the text; NOT executed in this stage (owner's NO-HEAVY-CHECKS
// restriction) — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

// --- §6211(a): deficiency formula, with a return and previous assessment --

test "S6211-01-DEFICIENCY-FORMULA-WITH-RETURN-AND-PRIOR-ASSESSMENT" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert return_was_made(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert tax_imposed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 10000.00 USD) { id "f1"; origin case_input; }
        assert amount_shown_as_tax_by_taxpayer(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 7000.00 USD) { id "f2"; origin case_input; }
        assert amounts_previously_assessed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 500.00 USD) { id "f3"; origin case_input; }
        assert rebates_made(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f4"; origin case_input; }
        assert refundable_credit_excess_over_tax_imposed(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f5"; origin case_input; }
        assert refundable_credit_excess_over_shown_tax(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f6"; origin case_input; }
    }
    // 10000 - 0 - (7000 - 0 + 500) + 0 = 2500
    evaluate truth(deficiency_amount(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 2500.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6211-02-DEFICIENCY-FORMULA-NO-RETURN-MADE" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert tax_imposed(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 4000.00 USD) { id "f0"; origin case_input; }
        assert amounts_previously_assessed(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f1"; origin case_input; }
        assert rebates_made(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f2"; origin case_input; }
        assert refundable_credit_excess_over_tax_imposed(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(deficiency_amount(entity_ref("urn:us:irc:assessment:clir#P2"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 4000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S6211-03-REFUNDABLE-CREDIT-EXCESS-TREATED-AS-NEGATIVE-TAX" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert return_was_made(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert tax_imposed(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 1000.00 USD) { id "f1"; origin case_input; }
        assert amount_shown_as_tax_by_taxpayer(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 1000.00 USD) { id "f2"; origin case_input; }
        assert amounts_previously_assessed(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f3"; origin case_input; }
        assert rebates_made(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD) { id "f4"; origin case_input; }
        assert refundable_credit_excess_over_tax_imposed(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 300.00 USD) { id "f5"; origin case_input; }
        assert refundable_credit_excess_over_shown_tax(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 300.00 USD) { id "f6"; origin case_input; }
    }
    // (1000-300) - ((1000-300)+0) + 0 = 0
    evaluate truth(deficiency_amount(entity_ref("urn:us:irc:assessment:clir#P3"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1, 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

// --- §6212(a): power to send notice of deficiency ---------------------------

test "S6212-01-SEND-NOTICE-OF-DEFICIENCY-POWER-EXERCISED" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert secretary_determines_deficiency(entity_ref("urn:us:irc:assessment:clir#P1"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f0"; origin case_input; }
        assert secretary_mails_notice(entity_ref("urn:us:irc:assessment:clir#N1"), entity_ref("urn:us:irc:assessment:clir#P1"), @2026-06-01) { id "f1"; origin case_input; }
    }
    evaluate truth(us.irc.core::notice_of(entity_ref("urn:us:irc:assessment:clir#N1"), us.irc.core::Deficiency, entity_ref("urn:us:irc:assessment:clir#P1")));
    expect truth_status == TRUE_ONLY;
}

// --- §6212(b)(1): sufficiency at the last known address ---------------------

test "S6212-02-NOTICE-VALID-AT-LAST-KNOWN-ADDRESS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert us.irc.core::notice_of(entity_ref("urn:us:irc:assessment:clir#N2"), us.irc.core::Deficiency, entity_ref("urn:us:irc:assessment:clir#P2")) { id "f0"; origin case_input; }
        assert us.irc.core::address_last_known(entity_ref("urn:us:irc:assessment:clir#N2")) { id "f1"; origin case_input; }
    }
    evaluate truth(notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N2"), entity_ref("urn:us:irc:assessment:clir#P2")));
    expect truth_status == TRUE_ONLY;
}

test "S6212-03-NOTICE-INVALID-WITHOUT-LAST-KNOWN-ADDRESS" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; }
