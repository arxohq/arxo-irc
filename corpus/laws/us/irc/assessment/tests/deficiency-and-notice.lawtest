}

// --- §6212(c)(1): further deficiency letters restricted ---------------------

test "S6212-04-NO-FURTHER-DEFICIENCY-LETTER-IMMUNITY-ACTIVE" {
    given {
        context { decision_time @2026-07-01T09:00:00-05:00; knowledge_time @2026-07-01T09:00:00-05:00; legal_time @2026-07-01; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4")) { id "f0"; origin case_input; }
        assert petition_filed_with_tax_court(entity_ref("urn:us:irc:assessment:clir#PR4"), entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4")) { id "f1"; origin case_input; }
        assert same_taxable_period_deficiency(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
        assert secretary_mails_notice(entity_ref("urn:us:irc:assessment:clir#N5"), entity_ref("urn:us:irc:assessment:clir#P4"), @2026-07-01) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(S6212FurtherDeficiencyLettersRestricted, ACTIVE);
}

test "S6212-05-FRAUD-EXCEPTION-NO-IMMUNITY" {
    given {
        context { decision_time @2026-07-01T09:00:00-05:00; knowledge_time @2026-07-01T09:00:00-05:00; legal_time @2026-07-01; timezone "America/New_York"; }
        assert notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4")) { id "f0"; origin case_input; }
        assert petition_filed_with_tax_court(entity_ref("urn:us:irc:assessment:clir#PR4"), entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4")) { id "f1"; origin case_input; }
        assert same_taxable_period_deficiency(entity_ref("urn:us:irc:assessment:clir#N4"), entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f2"; origin case_input; }
        assert fraud_established(entity_ref("urn:us:irc:assessment:clir#P4"), entity_ref("urn:us:irc:assessment:clir#Y2025"), us.irc.core::IncomeCh1) { id "f3"; origin adjudicated; }
        assert secretary_mails_notice(entity_ref("urn:us:irc:assessment:clir#N5"), entity_ref("urn:us:irc:assessment:clir#P4"), @2026-07-01) { id "f4"; origin case_input; }
    }
    evaluate positions();
    expect not position(S6212FurtherDeficiencyLettersRestricted, ACTIVE);
}

// --- §6212(d): rescission with consent --------------------------------------

test "S6212-06-RESCISSION-POWER-EXERCISED-NOTICE-NO-LONGER-VALID" {
    given {
        context { decision_time @2026-07-15T09:00:00-05:00; knowledge_time @2026-07-15T09:00:00-05:00; legal_time @2026-07-15; timezone "America/New_York"; }
        assert us.irc.core::notice_of(entity_ref("urn:us:irc:assessment:clir#N6"), us.irc.core::Deficiency, entity_ref("urn:us:irc:assessment:clir#P6")) { id "f0"; origin case_input; }
        assert us.irc.core::address_last_known(entity_ref("urn:us:irc:assessment:clir#N6")) { id "f1"; origin case_input; }
        assert secretary_rescinds_notice(entity_ref("urn:us:irc:assessment:clir#N6"), entity_ref("urn:us:irc:assessment:clir#P6")) { id "f2"; origin case_input; }
        assert taxpayer_consents_to_rescission(entity_ref("urn:us:irc:assessment:clir#N6"), entity_ref("urn:us:irc:assessment:clir#P6")) { id "f3"; origin case_input; }
    }
    evaluate truth(notice_of_deficiency_valid(entity_ref("urn:us:irc:assessment:clir#N6"), entity_ref("urn:us:irc:assessment:clir#P6")));
    expect truth_status == NEITHER;
}
