test "S6206-02-6435-REMOVAL-ON-DAY-180-TREATED-AS-TAX" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert excessive_amount_under_6675b(entity_ref("urn:us:irc:assessment:clir#P1"), Payment6435, 500.00 USD, @2026-04-15) { id "f0"; origin case_input; }
        assert eligible_dyed_fuel_removed_on(entity_ref("urn:us:irc:assessment:clir#P1"), @2025-12-31) { id "f1"; origin case_input; }
    }
    // 2025-07-04 + 180 days = 2025-12-31: the first removal date covered by Pub. L. 119-21 section 70525(c)
    evaluate truth(excessive_claim_taxlike_treatment(entity_ref("urn:us:irc:assessment:clir#P1"), Payment6435, Tax4041Or4081));
    expect truth_status == TRUE_ONLY;
}

