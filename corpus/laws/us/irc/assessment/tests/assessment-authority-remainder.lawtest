test "S6205B-01-UNDERPAYMENT-NOT-ADJUSTABLE-FICA-IS-ASSESSABLE" {
    given {
        context { decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert underpayment_not_adjustable_under_6205a(entity_ref("urn:us:irc:assessment:clir#P1"), us.irc.core::FicaCh21, @2026-03-01, 1000.00 USD, 400.00 USD) { id "f0"; origin case_input; }
    }
    // amount of the underpayment = correct amount minus amount paid or deducted
    evaluate truth(employment_underpayment_assessable(entity_ref("urn:us:irc:assessment:clir#P1"), us.irc.core::FicaCh21, @2026-03-01, 600.00 USD));
    expect truth_status == TRUE_ONLY;
}

