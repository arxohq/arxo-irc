        assert levy_released_under_6343(entity_ref("urn:us:irc:assessment:clir#A1"), @2031-02-01) { id "f1"; origin case_input; }
        assert collection_period_agreed_before_release(entity_ref("urn:us:irc:assessment:clir#A1"), @2032-06-30, @2031-03-01) { id "f2"; origin case_input; }
    }
    // the period must have been agreed before the release
