test "S6502A-03-LEVY-AFTER-TEN-YEARS-TIMELY-UNDER-INSTALLMENT-EXTENSION" {
    given {
        context { decision_time @2030-07-01T09:00:00-05:00; knowledge_time @2030-07-01T09:00:00-05:00; legal_time @2030-07-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:assessment:clir#A1"), @2020-01-01) { id "f0"; origin case_input; }
        assert installment_agreement_entered(entity_ref("urn:us:irc:assessment:clir#A1"), @2028-01-01) { id "f1"; origin case_input; }
        assert collection_period_agreed_at_installment_agreement(entity_ref("urn:us:irc:assessment:clir#A1"), @2030-05-01) { id "f2"; origin case_input; }
        assert levy_or_proceeding_made_on(entity_ref("urn:us:irc:assessment:clir#A1"), @2030-06-01) { id "f3"; origin case_input; }
    }
    // 2030-05-01 + 90 days = 2030-07-30: the levy on 2030-06-01 is within the extended date although after the 10-year date
    evaluate truth(collection_action_timely(entity_ref("urn:us:irc:assessment:clir#A1"), @2030-06-01));
    expect truth_status == TRUE_ONLY;
}

