// Scenarios for §6502(a) (collection after assessment, general 10-year
// rule), package us.irc.assessment, module
// 06-collection-after-assessment-6502.law. Written from the text; NOT
// executed in this stage (NO-HEAVY-CHECKS) — `implemented_unverified` per
// AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

test "S6502-01-TEN-YEARS-AFTER-ASSESSMENT" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:assessment:clir#A1"), @2020-06-01) { id "f0"; origin case_input; }
    }
    evaluate truth(collection_period_ends(entity_ref("urn:us:irc:assessment:clir#A1"), @2030-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S6502-02-UNKNOWN-ASSESSMENT-DATE-GIVES-NO-PERIOD" {
    given {
        context { decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; legal_time @2026-05-01; timezone "America/New_York"; }
    }
    // No `assessed_on` fact asserted — the 10-year period cannot be derived;
    // absence of a computed fact, not a false one.
    evaluate truth(collection_period_ends(entity_ref("urn:us:irc:assessment:clir#A2"), @2036-01-01));
    expect truth_status == NEITHER;
}

// ---- stage 3 (26.09.2026): §6502(a)(2), final sentence, (b) ----

test "S6502A2A-01-INSTALLMENT-AGREEMENT-EXTENDS-PERIOD-BY-90-DAYS" {
    given {
        context { decision_time @2033-01-01T09:00:00-05:00; knowledge_time @2033-01-01T09:00:00-05:00; legal_time @2033-01-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert installment_agreement_entered(entity_ref("urn:us:irc:assessment:clir#A1"), @2030-01-01) { id "f0"; origin case_input; }
        assert collection_period_agreed_at_installment_agreement(entity_ref("urn:us:irc:assessment:clir#A1"), @2033-01-01) { id "f1"; origin case_input; }
    }
    // 2033-01-01 + 90 days = 2033-04-01
    evaluate truth(collection_period_ends(entity_ref("urn:us:irc:assessment:clir#A1"), @2033-04-01));
    expect truth_status == TRUE_ONLY;
}

