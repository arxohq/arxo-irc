}

test "S6502A2B-01-RELEASE-OF-LEVY-AFTER-TEN-YEARS-EXTENDS-TO-AGREED-DATE" {
    given {
        context { decision_time @2032-01-01T09:00:00-05:00; knowledge_time @2032-01-01T09:00:00-05:00; legal_time @2032-01-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert us.irc.core::assessed_on(entity_ref("urn:us:irc:assessment:clir#A1"), @2020-01-01) { id "f0"; origin case_input; }
        assert levy_released_under_6343(entity_ref("urn:us:irc:assessment:clir#A1"), @2031-02-01) { id "f1"; origin case_input; }
        assert collection_period_agreed_before_release(entity_ref("urn:us:irc:assessment:clir#A1"), @2032-06-30, @2030-12-01) { id "f2"; origin case_input; }
    }
    evaluate truth(collection_period_ends(entity_ref("urn:us:irc:assessment:clir#A1"), @2032-06-30));
    expect truth_status == TRUE_ONLY;
}

