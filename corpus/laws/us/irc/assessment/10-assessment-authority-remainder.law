// 26 U.S.C. §§6202, 6205(b), 6206 — Assessment authority remainder.
// Stage 3 (26.09.2026, DECISION-0379). Status: implemented_unverified.
//
// SCOPE.
//  - §6202 (mode or time of assessment not otherwise provided for): the text
//    is a delegation to regulations. The content of the regulations
//    (26 CFR 301.6202-1) is not in the pinned Title 26 text, so the row is an
//    EXTERNAL_DEPENDENCY; nothing here invents a mode or a time.
//  - §6205(b): the shortfall of a chapter 21 / 22 / 24 tax that cannot be
//    adjusted under §6205(a) is assessable. The manner and times are left to
//    regulations (EXTERNAL_DEPENDENCY for that half); the assessable AMOUNT
//    (correct amount minus amount paid or deducted) is executable.
//  - §6206: excessive refunds/payments under §§6416(a)(4), 6420, 6421, 6427
//    (and, from the Pub. L. 119-21 §70525 conforming amendment, §6435) and
//    the §6675 civil penalty are assessable as if a tax, within 3 years from
//    the last day prescribed for filing the claim. The definition of an
//    "excessive amount" is §6675(b) (owner `penalties`), read as a typed
//    institutional contract; the tax-as-if choice (§4081 or §4041/§4081) is
//    carried as a classification of the payment source.
//
// Pub. L. 119-21 §70525(b)(1)/(c): §6206 now also reaches payments under
// §6435 (dyed fuel) with respect to eligible indelibly dyed diesel fuel or
// kerosene removed on or after the date that is 180 days after enactment
// (2025-07-04 + 180 days = 2025-12-31). The window guard is on the removal
// date (a fact of the case), not on the reading date.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6205_B,
    IRC_S6206,
    Person,
    Secretary,
    TaxKind,
};

// ============================================================================
// §6202 — Establishment by regulations of mode or time of assessment
// ============================================================================

// EXTERNAL_DEPENDENCY: the Secretary's regulations under §6202 (mode or time
// of assessment where "not otherwise provided for"). No regulation text is
// pinned; the relation below is the typed contract a consumer asserts when a
// regulation has established a mode or time for a kind of assessment.
pub relation regulation_establishes_assessment_mode_or_time(k: TaxKind, effectiveFrom: Date) kind institutional {
    label en unofficial "a regulation issued under section 6202 establishes the mode or time of assessment for a kind of tax where the Code does not otherwise provide (content of the regulation is not pinned in this package)";
}

// ============================================================================
// §6205(b) — Underpayment that cannot be adjusted under (a)
// ============================================================================

pub relation underpayment_not_adjustable_under_6205a(p: Person, k: TaxKind, wagePaymentOn: Date, correctAmount: Money, actualAmount: Money) kind empirical {
    label en official "less than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid or deducted with respect to any payment of wages or compensation and the underpayment cannot be adjusted under subsection (a) of this section";
}
pub relation employment_underpayment_assessable(p: Person, k: TaxKind, wagePaymentOn: Date, amount: Money) kind institutional {
    label en official "the amount of the underpayment shall be assessed and collected (manner and times as the Secretary prescribes by regulations, subject to the statute of limitations properly applicable)";
}
@source(IRC_S6205_B, relation = formalizes, coverage = partial, quote = "the amount of the underpayment shall be assessed and collected")
rule S6205bUnderpaymentAssessableFica defeasible {
    label en official "the amount of the underpayment (chapter 21 tax) shall be assessed and collected";
    for p: Person;
    for wagePaymentOn: Date;
    for correctAmount: Money;
    for actualAmount: Money;
    when underpayment_not_adjustable_under_6205a(p, us.irc.core::FicaCh21, wagePaymentOn, correctAmount, actualAmount)
        and actualAmount < correctAmount;
    then employment_underpayment_assessable(p, us.irc.core::FicaCh21, wagePaymentOn, correctAmount - actualAmount);
}
@source(IRC_S6205_B, relation = formalizes, coverage = partial, quote = "the amount of the underpayment shall be assessed and collected")
rule S6205bUnderpaymentAssessableRrta defeasible {
    label en official "the amount of the underpayment (chapter 22 tax) shall be assessed and collected";
    for p: Person;
    for wagePaymentOn: Date;
    for correctAmount: Money;
    for actualAmount: Money;
    when underpayment_not_adjustable_under_6205a(p, us.irc.core::RrtaCh22, wagePaymentOn, correctAmount, actualAmount)
        and actualAmount < correctAmount;
    then employment_underpayment_assessable(p, us.irc.core::RrtaCh22, wagePaymentOn, correctAmount - actualAmount);
}
@source(IRC_S6205_B, relation = formalizes, coverage = partial, quote = "the amount of the underpayment shall be assessed and collected")
rule S6205bUnderpaymentAssessableWithholding defeasible {
    label en official "the amount of the underpayment (chapter 24 withholding) shall be assessed and collected";
    for p: Person;
    for wagePaymentOn: Date;
    for correctAmount: Money;
    for actualAmount: Money;
    when underpayment_not_adjustable_under_6205a(p, us.irc.core::WithholdingWagesCh24, wagePaymentOn, correctAmount, actualAmount)
        and actualAmount < correctAmount;
    then employment_underpayment_assessable(p, us.irc.core::WithholdingWagesCh24, wagePaymentOn, correctAmount - actualAmount);
}
// EXTERNAL_DEPENDENCY: "in such manner and at such times ... as the Secretary
// may by regulations prescribe" — regulations not pinned (see §6202 above).

// ============================================================================
// §6206 — Special rules applicable to excessive claims
// ============================================================================

pub enum ExcessiveClaimSource {
    Refund6416a4;
    Payment6420;
    Payment6421;
    Payment6427;
    Payment6435;
    Penalty6675;
    label en unofficial "the source of an excessive amount that section 6206 makes assessable as a tax: a refund under section 6416(a)(4), a payment under section 6420, 6421, 6427 or (Pub. L. 119-21 section 70525) 6435, or the civil penalty of section 6675";
}
pub enum ExcessiveClaimTaxTreatment {
    Tax4081;
    Tax4041Or4081;
    label en unofficial "the tax that the excessive amount is treated as imposed by: section 4081, or section 4041 or 4081 (payments under section 6427)";
}
// Pending: `penalties` (§6675(b)) — the amount of a refund or payment that is
// an "excessive amount", and the §6675 penalty itself.
pub relation excessive_amount_under_6675b(p: Person, src: ExcessiveClaimSource, amount: Money, lastDayForFiling: Date) kind institutional {
    label en unofficial "the amount is an excessive amount as defined in section 6675(b) (or the section 6675 civil penalty) with the last day prescribed for filing the claim under section 6416(a)(4), 6420, 6421 or 6427 (pending: `penalties`, not this package's norm)";
}
pub relation eligible_dyed_fuel_removed_on(p: Person, removedOn: Date) kind empirical {
    label en official "eligible indelibly dyed diesel fuel or kerosene removed (Pub. L. 119-21 section 70525(c) applicability: removals on or after the date 180 days after enactment)";
}
pub relation excessive_claim_taxlike_treatment(p: Person, src: ExcessiveClaimSource, treatment: ExcessiveClaimTaxTreatment) kind institutional {
    label en official "the excessive amount may be assessed and collected as if it were a tax imposed by section 4081 (refunds under 6416(a)(4), payments under 6420 and 6421), or 4041 or 4081 (payments under 6427), and as if the person who made the claim were liable for such tax";
}
@source(IRC_S6206, relation = formalizes, coverage = partial, quote = "as if it were a tax imposed by section 4081 (with respect to refunds under section 6416(a)(4) and payments under sections 6420 and 6421)")
rule S6206TaxLikeTreatmentRefund6416 defeasible {
    label en official "a refund under section 6416(a)(4) that is an excessive amount is treated as a tax imposed by section 4081";
    for p: Person;
    for amount: Money;
    for lastDay: Date;
    when excessive_amount_under_6675b(p, Refund6416a4, amount, lastDay);
    then excessive_claim_taxlike_treatment(p, Refund6416a4, Tax4081);
}
@source(IRC_S6206, relation = formalizes, coverage = partial, quote = "as if it were a tax imposed by section 4081 (with respect to refunds under section 6416(a)(4) and payments under sections 6420 and 6421)")
rule S6206TaxLikeTreatmentPayment6420 defeasible {
    label en official "a payment under section 6420 that is an excessive amount is treated as a tax imposed by section 4081";
    for p: Person;
    for amount: Money;
    for lastDay: Date;
    when excessive_amount_under_6675b(p, Payment6420, amount, lastDay);
    then excessive_claim_taxlike_treatment(p, Payment6420, Tax4081);
}
@source(IRC_S6206, relation = formalizes, coverage = partial, quote = "as if it were a tax imposed by section 4081 (with respect to refunds under section 6416(a)(4) and payments under sections 6420 and 6421)")
rule S6206TaxLikeTreatmentPayment6421 defeasible {
    label en official "a payment under section 6421 that is an excessive amount is treated as a tax imposed by section 4081";
    for p: Person;
    for amount: Money;
    for lastDay: Date;
    when excessive_amount_under_6675b(p, Payment6421, amount, lastDay);
    then excessive_claim_taxlike_treatment(p, Payment6421, Tax4081);
}
@source(IRC_S6206, relation = formalizes, coverage = partial, quote = "or 4041 or 4081 (with respect to payments under section 6427)")
rule S6206TaxLikeTreatmentPayment6427 defeasible {
    label en official "a payment under section 6427 that is an excessive amount is treated as a tax imposed by section 4041 or 4081";
    for p: Person;
    for amount: Money;
    for lastDay: Date;
    when excessive_amount_under_6675b(p, Payment6427, amount, lastDay);
    then excessive_claim_taxlike_treatment(p, Payment6427, Tax4041Or4081);
}
@source(us.irc.temporal::PL119_21_S70525, relation = derives_from, quote = "by striking “or 6427” each place it appears and inserting “6427, or 6435”")
rule S6206TaxLikeTreatmentPayment6435 defeasible {
    label en official "a payment under section 6435 (dyed fuel) that is an excessive amount is treated as a tax imposed by section 4041 or 4081 (Pub. L. 119-21 section 70525(b)(1)), for eligible fuel removed on or after 2025-12-31";
    for p: Person;
    for amount: Money;
    for lastDay: Date;
    for removedOn: Date;
    when excessive_amount_under_6675b(p, Payment6435, amount, lastDay)
        and eligible_dyed_fuel_removed_on(p, removedOn)
        and removedOn >= add_calendar_period(@2025-07-04, 180 calendar_day);
    then excessive_claim_taxlike_treatment(p, Payment6435, Tax4041Or4081);
}
// INTERPRETATION (stated in the coverage row of section 6206): the
// amendment "striking 6420 and 6421 and inserting 6420, 6421, and 6435" puts
// §6435 payments in the §4081 group of the first parenthetical, while
// "6427, or 6435" puts them in the §4041/§4081 group of the second. The two
// substitutions in Pub. L. 119-21 §70525(b)(1)(A) and (B) point to different
// groups; this module carries the reading that BOTH parentheticals now name
// §6435 and classifies the payment under the group whose consequence is the
// wider (§4041 or §4081), recording the second reading as open.

pub relation secretary_assesses_excessive_claim(p: Person, src: ExcessiveClaimSource, amount: Money, lastDayForFiling: Date, assessedOn: Date) kind empirical {
    label en official "the Secretary assesses the excessive amount as if it were a tax";
}
pub relation excessive_claim_assessment_within_three_years(p: Person, src: ExcessiveClaimSource, amount: Money, lastDayForFiling: Date, assessedOn: Date) kind institutional {
    label en unofficial "single-atom valid_when helper: the assessment is made within 3 years from the last day prescribed for the filing of the claim (section 6206, second sentence)";
}
@source(IRC_S6206, relation = formalizes, coverage = exact, quote = "The period for assessing any such portion, and for assessing any such penalty, shall be 3 years from the last day prescribed for the filing of the claim")
rule S6206AssessmentWithinThreeYears defeasible {
    label en official "the period for assessing an excessive portion or the section 6675 penalty is 3 years from the last day prescribed for filing the claim";
    for p: Person;
    for src: ExcessiveClaimSource;
    for amount: Money;
    for lastDay: Date;
    for assessedOn: Date;
    when secretary_assesses_excessive_claim(p, src, amount, lastDay, assessedOn)
        and assessedOn <= add_calendar_period(lastDay, 3 calendar_year);
    then excessive_claim_assessment_within_three_years(p, src, amount, lastDay, assessedOn);
}
pub relation excessive_claim_assessed_as_tax(p: Person, src: ExcessiveClaimSource, amount: Money) kind institutional {
    label en official "the excessive amount has been assessed and may be collected as if it were a tax";
}
@source(IRC_S6206, relation = formalizes, coverage = exact, quote = "may be assessed and collected as if it were a tax imposed by section 4081")
pub rule S6206AssessExcessiveClaim strict {
    label en official "any portion of a refund or payment which constitutes an excessive amount, and any civil penalty provided by section 6675, may be assessed and collected as if it were a tax";
    for p: Person;
    for src: ExcessiveClaimSource;
    for amount: Money;
    for lastDay: Date;
    for assessedOn: Date;
    when secretary_assesses_excessive_claim(p, src, amount, lastDay, assessedOn);
    then power S6206AssessExcessiveClaimPower {
        holder Secretary;
        over p;
        exercise secretary_assesses_excessive_claim(p, src, amount, lastDay, assessedOn);
        valid_when excessive_claim_assessment_within_three_years(p, src, amount, lastDay, assessedOn);
        effect create(excessive_claim_assessed_as_tax(p, src, amount));
    };
}
