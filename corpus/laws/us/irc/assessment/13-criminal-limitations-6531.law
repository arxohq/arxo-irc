// 26 U.S.C. §6531 — Periods of limitation on criminal prosecutions.
// Stage 3 (26.09.2026, DECISION-0379). Status: implemented_unverified.
//
// SCOPE.
//  - The general 3-year period after the commission of the offense and the
//    eight 6-year classes of offense (paragraphs (1)-(8)). The class of an
//    offense is a fact of the case: whether an act IS an offense described
//    in §7201, §7206(1), §7207, §7212(a), §7214(a) or 18 U.S.C. §371 is the
//    owner package `crimes`' norm (chapter 75), read here as the class the
//    case assigns (EXTERNAL_DEPENDENCY for the offense elements).
//  - The tolling sentence: time during which the person is outside the
//    United States or is a fugitive from justice (18 U.S.C. §3290) is not
//    counted. The extended deadline is validated in comparison form against
//    a candidate date (G243 idiom; `add_calendar_period` needs a literal
//    count) — TECH_GAP G3710.
//  - The bar itself is an immunity of the person: no prosecution, trial or
//    punishment unless the indictment is found or the information instituted
//    within the period.
//  The parenthetical of the last sentence (deemed amendment of §3748(a) of
//  the 1939 Code) is a historical savings clause: NON_NORMATIVE.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6531,
    Person,
};

pub entity TaxOffense {
    label en unofficial "one offense arising under the internal revenue laws, for the purposes of the period of limitation on prosecution";
}
pub enum ProsecutionLimitationClass {
    GeneralOffense;
    DefraudUnitedStates;
    EvadeTaxOrPayment;
    AidAssistFalseReturnOrDocument;
    FailToPayOrFileWillfully;
    FalseStatements7206_1_And_7207;
    IntimidationOfOfficers7212a;
    OfficerOffenses7214a;
    ConspiracyUnder18USC371ToEvadeTax;
    label en unofficial "the class of an offense under section 6531: the general 3-year class, or one of the eight 6-year classes of paragraphs (1)-(8)";
}
pub relation offense_of(o: TaxOffense, p: Person, cls: ProsecutionLimitationClass, committedOn: Date) kind empirical {
    label en official "an offense arising under the internal revenue laws, of the given class, committed by the person on the date (class assignment is `crimes`' norm)";
}
pub relation six_year_class(cls: ProsecutionLimitationClass) kind institutional {
    label en unofficial "the class is one of the eight classes of section 6531(1)-(8) for which the limitation period is 6 years";
}
rule S6531Class1DefraudIsSixYear strict { then six_year_class(DefraudUnitedStates); }
rule S6531Class2EvadeIsSixYear strict { then six_year_class(EvadeTaxOrPayment); }
rule S6531Class3AidAssistIsSixYear strict { then six_year_class(AidAssistFalseReturnOrDocument); }
rule S6531Class4FailToPayOrFileIsSixYear strict { then six_year_class(FailToPayOrFileWillfully); }
rule S6531Class5FalseStatementsIsSixYear strict { then six_year_class(FalseStatements7206_1_And_7207); }
rule S6531Class6IntimidationIsSixYear strict { then six_year_class(IntimidationOfOfficers7212a); }
rule S6531Class7OfficerOffensesIsSixYear strict { then six_year_class(OfficerOffenses7214a); }
rule S6531Class8ConspiracyIsSixYear strict { then six_year_class(ConspiracyUnder18USC371ToEvadeTax); }

pub relation prosecution_base_deadline(o: TaxOffense, d: Date) kind institutional {
    label en official "the last day on which the indictment may be found or the information instituted, before any tolling: 3 years (6 years for the paragraph (1)-(8) classes) after the commission of the offense";
}
@source(IRC_S6531, relation = formalizes, coverage = exact, quote = "unless the indictment is found or the information instituted within 3 years next after the commission of the offense")
rule S6531GeneralThreeYearPeriod defeasible {
    label en official "the general period of limitation on prosecution is 3 years after the commission of the offense";
    for o: TaxOffense;
    for p: Person;
    for committedOn: Date;
    when offense_of(o, p, GeneralOffense, committedOn);
    then prosecution_base_deadline(o, add_calendar_period(committedOn, 3 calendar_year));
}
@source(IRC_S6531, relation = formalizes, coverage = exact, quote = "except that the period of limitation shall be 6 years—")
rule S6531SixYearClasses defeasible {
    label en official "for the offenses of paragraphs (1)-(8) the period of limitation is 6 years";
    for o: TaxOffense;
    for p: Person;
    for cls: ProsecutionLimitationClass;
    for committedOn: Date;
    when offense_of(o, p, cls, committedOn)
        and six_year_class(cls);
    then prosecution_base_deadline(o, add_calendar_period(committedOn, 6 calendar_year));
}

// --- Tolling: outside the United States or fugitive ----------------------------

pub entity AbsencePeriod {
    label en unofficial "a period during which the person is outside the United States or is a fugitive from justice";
}
pub relation absence_period_of(ap: AbsencePeriod, o: TaxOffense, startsOn: Date, endsOn: Date) kind empirical {
    label en official "a period during which the person committing the offense is outside the United States or is a fugitive from justice within the meaning of 18 U.S.C. 3290";
}
pub relation absence_days(o: TaxOffense, ap: AbsencePeriod, days: Integer) kind institutional {
    label en unofficial "the days of an absence period that are not counted";
}
rule S6531TollingDaysOfAbsencePeriod defeasible {
    label en official "the time of absence or flight is not taken as any part of the time limited for commencing the proceeding";
    for o: TaxOffense;
    for ap: AbsencePeriod;
    for startsOn: Date;
    for endsOn: Date;
    when absence_period_of(ap, o, startsOn, endsOn)
        and endsOn >= startsOn;
    then absence_days(o, ap, days_between(startsOn, endsOn) + 1);
}
pub relation total_absence_days(o: TaxOffense, total: Integer) kind institutional {
    label en unofficial "the total of the tolled days";
}
rule S6531TollingTotalDays defeasible {
    label en unofficial "the total number of days of absence or flight";
    for o: TaxOffense;
    for ap0: AbsencePeriod;
    for d0: Integer;
    when absence_days(o, ap0, d0);
    then total_absence_days(o, sum all d: Integer for ap: AbsencePeriod where absence_days(o, ap, d));
}
pub relation exists_absence_period(o: TaxOffense) kind institutional {
    label en unofficial "some absence period is recorded for the offense";
}
rule S6531ExistsAbsencePeriod strict {
    label en unofficial "an absence period exists";
    for o: TaxOffense;
    for ap: AbsencePeriod;
    for startsOn: Date;
    for endsOn: Date;
    when absence_period_of(ap, o, startsOn, endsOn);
    then exists_absence_period(o);
}
pub relation candidate_prosecution_deadline_with_tolling(o: TaxOffense, candidate: Date) kind empirical {
    label en unofficial "a candidate deadline, AS EXTENDED for the tolled days, proposed by the caller for validation (G243 comparison form)";
}
pub relation prosecution_deadline(o: TaxOffense, d: Date) kind institutional {
    label en official "the last day on which the indictment may be found or the information instituted: the base deadline, extended by exactly the days of absence or flight";
}
@source(IRC_S6531, relation = formalizes, coverage = exact, quote = "shall not be taken as any part of the time limited by law for the commencement of such proceedings")
rule S6531DeadlineWithoutTolling defeasible {
    label en official "with no absence or flight the deadline is the base deadline";
    for o: TaxOffense;
    for baseEnd: Date;
    when prosecution_base_deadline(o, baseEnd)
        and not_known(exists_absence_period(o));
    then prosecution_deadline(o, baseEnd);
}
@source(IRC_S6531, relation = formalizes, coverage = exact, quote = "shall not be taken as any part of the time limited by law for the commencement of such proceedings")
pub rule S6531DeadlineExtendedByAbsence defeasible {
    label en official "the days outside the United States or as a fugitive are excluded from the period (candidate confirmed by exact day count)";
    for o: TaxOffense;
    for baseEnd: Date;
    for tolled: Integer;
    for candidate: Date;
    when prosecution_base_deadline(o, baseEnd)
        and total_absence_days(o, tolled)
        and candidate_prosecution_deadline_with_tolling(o, candidate)
        and candidate >= baseEnd
        and days_between(baseEnd, candidate) == tolled;
    then prosecution_deadline(o, candidate);
}

// --- The bar --------------------------------------------------------------------

pub relation prosecution_instituted_on(o: TaxOffense, instituteOn: Date) kind empirical {
    label en official "the indictment is found or the information instituted";
}
pub relation prosecution_proceeds(o: TaxOffense) kind institutional {
    label en official "the person is prosecuted, tried, or punished for the offense";
}
pub relation prosecution_timely(o: TaxOffense) kind institutional {
    label en unofficial "the indictment was found or the information instituted on or before the deadline";
}
rule S6531ProsecutionTimely defeasible {
    label en official "the indictment is found or the information instituted within the period";
    for o: TaxOffense;
    for instituteOn: Date;
    for deadline: Date;
    when prosecution_instituted_on(o, instituteOn)
        and prosecution_deadline(o, deadline)
        and instituteOn <= deadline;
    then prosecution_timely(o);
}
rule S6531ProsecutionProceedsWhenTimely defeasible {
    label en unofficial "a timely prosecution may proceed";
    for o: TaxOffense;
    when prosecution_timely(o);
    then prosecution_proceeds(o);
}
@source(IRC_S6531, relation = formalizes, coverage = exact, quote = "No person shall be prosecuted, tried, or punished for any of the various offenses arising under the internal revenue laws")
pub rule S6531NoProsecutionAfterLimitation defeasible {
    label en official "no person shall be prosecuted, tried, or punished unless the indictment is found or the information instituted within the period";
    for o: TaxOffense;
    for p: Person;
    for cls: ProsecutionLimitationClass;
    for committedOn: Date;
    for instituteOn: Date;
    for deadline: Date;
    when offense_of(o, p, cls, committedOn)
        and prosecution_instituted_on(o, instituteOn)
        and prosecution_deadline(o, deadline)
        and instituteOn > deadline;
    then immunity S6531NoProsecutionAfterLimitationImmunity {
        holder p;
        protected_effect prosecution_proceeds(o);
        window [deadline, infinity];
    };
}
