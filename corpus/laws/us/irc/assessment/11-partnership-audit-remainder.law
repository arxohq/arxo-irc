// 26 U.S.C. §§6221 (transition note), 6222(d), 6225(d), 6226(b)-(c), 6227(b),
// 6231(c)-(d), 6232(c)-(f), 6233, 6234(b)-(e) — centralized partnership
// audit regime (BBA), remainder. Stage 3 (26.09.2026, DECISION-0379).
// Status: implemented_unverified (scenarios are written, not executed).
//
// SCOPE (what this module adds to 07-partnership-audit-bba.law).
//  - Transition note of Pub. L. 114-74 §1101(g): the regime applies to
//    returns filed for partnership taxable years beginning after
//    2017-12-31, and a partnership may elect earlier application for years
//    beginning after 2015-11-02 and before 2018-01-01 (the §6221(b) election
//    out excepted). The applicability is a rule on the taxable year's
//    beginning date, not an edition switch.
//  - §6222(d): a final decision on an inconsistent position in a
//    proceeding to which the partnership is not a party does not bind it
//    (an immunity of the partnership).
//  - §6225(d): reviewed year and adjustment year DERIVED from the facts that
//    define them (court decision final / AAR filed / FPA mailed). The
//    legacy `adjustment_year_for_reviewed_year` of module 07 remains a
//    case-supplied fact; the derived counterpart is
//    `bba_adjustment_year_derived`.
//  - §6226(b) push-out: the aggregate of the correction amounts and its
//    year, the tiered-partner duties of (b)(4); (c) penalties at the
//    partnership level with partner liability, interest at partner level with
//    the "5 percentage points" spread. The chapter 1 tax recomputation that
//    produces each correction amount is NOT this package's norm.
//  - §6227(b): the year in which an AAR adjustment is taken into account and
//    the two routes (imputed underpayment / push-out-like).
//  - §6231(c)-(d): the Secretary's prohibition on a second FPA after a
//    petition (absent a fraud showing, DECISION-0194 channel) and the
//    rescission power with the partnership's consent.
//  - §6232(c)-(f): injunction power, the waiver of the (b) restrictions, the
//    liability cap when no petition is filed, the 10-day non-payment
//    consequences and the assessment against partners (proportionate
//    shares, 2-year limit).
//  - §6233: interest period and partnership liability for penalties;
//    §6234(b)-(e): the deposit as a condition of district-court /
//    Court of Federal Claims petitions, jurisdiction, effect of a
//    determination, dismissal as a decision that the FPA is correct.
//
// TWIN RULES (E-0134): a `power`'s effect is materialized after all strata and
// is invisible to defeasible rules and to `not_known`. Where later rules must
// read the outcome of an election or waiver (push-out, waiver of the
// §6232(b) restrictions, rescission), the outcome is derived a second time
// from the SAME premises as the power's `valid_when` (`*_twin` relations);
// the power itself remains the position that carries valid / invalid exercise.
//
// TECH_GAP identifiers are registered in docs/foundations/us-irc/TECH-GAPS.md.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6221_NOTE_6,
    IRC_S6222_D,
    IRC_S6225_D,
    IRC_S6226_B,
    IRC_S6226_C,
    IRC_S6227_B,
    IRC_S6231_C,
    IRC_S6231_D,
    IRC_S6232_C,
    IRC_S6232_D,
    IRC_S6232_E,
    IRC_S6232_F,
    IRC_S6233_A,
    IRC_S6233_B,
    IRC_S6234_B,
    IRC_S6234_C,
    IRC_S6234_D,
    IRC_S6234_E,
    Organ,
    Partnership,
    PartnershipAdjustmentCategory,
    Person,
    Proceeding,
    Secretary,
    TaxableYear,
    adjustment_year_for_reviewed_year,
    administrative_adjustment_request_filed,
    attempted_assessment_of_imputed_underpayment,
    decision_final_on,
    exists_readjustment_petition_filed_timely,
    finality_check_as_of,
    fpa_effective,
    imputed_underpayment,
    notice_of_final_partnership_adjustment_mailed,
    partner_treatment_inconsistent,
    partnership_adjustment_item,
    partnership_level_determination,
    partnership_return_due_date,
    push_out_election_made,
    push_out_election_timely,
    readjustment_petition_filed,
    readjustment_petition_filed_timely,
};

// ============================================================================
// Pub. L. 114-74 §1101(g) — applicability of the BBA regime (note 6 to §6221)
// ============================================================================

pub relation bba_regime_applies_to_year(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the amendments made by section 1101 of Pub. L. 114-74 (this subchapter) apply to returns filed for the partnership taxable year";
}
pub relation bba_section_6226_election_applies_to_year(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the amendments apply to a partnership electing the application of section 6226 with respect to returns filed for partnership taxable years beginning after December 31, 2017";
}
pub relation bba_section_6227_request_applies_to_year(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the amendments apply to an administrative adjustment request under section 6227 with respect to returns filed for partnership taxable years beginning after December 31, 2017";
}
@source(IRC_S6221_NOTE_6, relation = formalizes, coverage = exact, quote = "shall apply to returns filed for partnership taxable years beginning after December 31, 2017")
rule S1101gBbaAppliesToYearsBeginningAfter2017 defeasible {
    label en official "the BBA amendments apply to returns filed for partnership taxable years beginning after December 31, 2017";
    for pship: Partnership;
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::year_of(pship, y)
        and us.irc.core::begins(y, beginsOn)
        and beginsOn > @2017-12-31;
    then bba_regime_applies_to_year(pship, y);
}
@source(IRC_S6221_NOTE_6, relation = formalizes, coverage = exact, quote = "the amendments made by this section shall apply to requests with respect to returns filed for partnership taxable years beginning after December 31, 2017")
rule S1101gAarRequestsFollowTheRegime defeasible {
    label en official "an administrative adjustment request under section 6227 is governed by the BBA amendments for returns of taxable years beginning after December 31, 2017";
    for pship: Partnership;
    for y: TaxableYear;
    when bba_regime_applies_to_year(pship, y);
    then bba_section_6227_request_applies_to_year(pship, y);
}
@source(IRC_S6221_NOTE_6, relation = formalizes, coverage = exact, quote = "the amendments made by this section shall apply to elections with respect to returns filed for partnership taxable years beginning after December 31, 2017")
rule S1101gPushOutElectionsFollowTheRegime defeasible {
    label en official "an election under section 6226 is governed by the BBA amendments for returns of taxable years beginning after December 31, 2017";
    for pship: Partnership;
    for y: TaxableYear;
    when bba_regime_applies_to_year(pship, y);
    then bba_section_6226_election_applies_to_year(pship, y);
}
pub relation bba_early_application_elected(pship: Partnership, y: TaxableYear, electedOn: Date) kind empirical {
    label en official "a partnership elects (at the time and in the form and manner the Secretary prescribes) for the amendments (other than the election under section 6221(b)) to apply to a return filed for a partnership taxable year beginning after November 2, 2015 and before January 1, 2018";
}
pub relation bba_early_application_year_in_window(pship: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "single-atom valid_when helper: the taxable year begins after 2015-11-02 and before 2018-01-01";
}
rule S1101gEarlyApplicationYearInWindow defeasible {
    label en unofficial "the partnership taxable year begins after the date of enactment (2015-11-02) and before January 1, 2018";
    for pship: Partnership;
    for y: TaxableYear;
    for beginsOn: Date;
    when us.irc.core::year_of(pship, y)
        and us.irc.core::begins(y, beginsOn)
        and beginsOn > @2015-11-02
        and beginsOn < @2018-01-01;
    then bba_early_application_year_in_window(pship, y);
}
@source(IRC_S6221_NOTE_6, relation = formalizes, coverage = exact, quote = "A partnership may elect (at such time and in such form and manner as the Secretary of the Treasury may prescribe) for the amendments made by this section (other than the election under section 6221(b) of such Code (as added by this Act)) to apply to any return of the partnership filed for partnership taxable years beginning after the date of the enactment of this Act")
pub rule S1101gElectEarlyApplication defeasible {
    label en official "a partnership may elect for the BBA amendments (other than the section 6221(b) election out) to apply to a return for a partnership taxable year beginning after 2015-11-02 and before 2018-01-01";
    for pship: Partnership;
    for y: TaxableYear;
    for electedOn: Date;
    when bba_early_application_elected(pship, y, electedOn);
    then power S1101gEarlyApplicationElectionPower {
        holder pship;
        over pship;
        exercise bba_early_application_elected(pship, y, electedOn);
        valid_when bba_early_application_year_in_window(pship, y);
        effect create(bba_regime_applies_to_year(pship, y));
    };
}
// The (4) carve-out ("other than the election under section 6221(b)") is read
// as: a partnership whose year is in the early-application window cannot
// rely on `election_out_of_bba_effective` for that year. This module states
// it as a comment only (no rule reads `election_out_of_bba_effective` for
// early-election years); see the coverage row of 26/6221/note/6/5.

// ============================================================================
// §6222(d) — Decisions in proceedings to which the partnership is not a party
// ============================================================================

pub relation decision_on_inconsistent_position(pr: Proceeding, partner: Person, pship: Partnership, y: TaxableYear) kind empirical {
    label en official "a final decision with respect to an inconsistent position identified under section 6222(c) in a proceeding";
}
pub relation partnership_is_party_to_proceeding(pship: Partnership, pr: Proceeding) kind empirical {
    label en official "the partnership is a party to the proceeding";
}
pub relation exists_partnership_party_to_proceeding(pship: Partnership, pr: Proceeding) kind institutional {
    label en unofficial "existential wrapper over `partnership_is_party_to_proceeding` so absence can be tested with not_known (§14/§98)";
}
rule S6222dExistsPartyToProceeding strict {
    label en unofficial "the partnership is recorded as a party to the proceeding";
    for pship: Partnership;
    for pr: Proceeding;
    when partnership_is_party_to_proceeding(pship, pr);
    then exists_partnership_party_to_proceeding(pship, pr);
}
pub relation decision_binds_partnership(pship: Partnership, pr: Proceeding) kind institutional {
    label en unofficial "the final decision in the proceeding binds the partnership";
}
rule S6222dDecisionBindsParty defeasible {
    label en unofficial "a final decision binds the partnership that was a party to the proceeding";
    for pship: Partnership;
    for pr: Proceeding;
    for partner: Person;
    for y: TaxableYear;
    when decision_on_inconsistent_position(pr, partner, pship, y)
        and partnership_is_party_to_proceeding(pship, pr);
    then decision_binds_partnership(pship, pr);
}
@source(IRC_S6222_D, relation = formalizes, coverage = exact, quote = "in a proceeding to which the partnership is not a party shall not be binding on the partnership")
rule S6222dNotBindingOnNonParty defeasible {
    label en official "any final decision with respect to an inconsistent position in a proceeding to which the partnership is not a party shall not be binding on the partnership";
    for pship: Partnership;
    for pr: Proceeding;
    for partner: Person;
    for y: TaxableYear;
    when decision_on_inconsistent_position(pr, partner, pship, y)
        and not_known(exists_partnership_party_to_proceeding(pship, pr));
    then immunity S6222dNotBoundByNonPartyDecisionImmunity {
        holder pship;
        protected_effect decision_binds_partnership(pship, pr);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6225(d) — Definitions: reviewed year, adjustment year
// ============================================================================

pub relation bba_reviewed_year(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the partnership taxable year to which the item being adjusted relates";
}
@source(IRC_S6225_D, relation = formalizes, coverage = exact, quote = "The term \"reviewed year\" means the partnership taxable year to which the item being adjusted relates.")
rule S6225d1ReviewedYearIsYearOfAdjustedItem defeasible {
    label en official "the reviewed year is the partnership taxable year to which the item being adjusted relates";
    for pship: Partnership;
    for y: TaxableYear;
    for category: PartnershipAdjustmentCategory;
    for amount: Money;
    when partnership_adjustment_item(pship, y, category, amount);
    then bba_reviewed_year(pship, y);
}
pub relation bba_adjustment_year_derived(pship: Partnership, reviewedYear: TaxableYear, adjustmentYear: TaxableYear) kind institutional {
    label en official "the adjustment year: the partnership taxable year in which (A) a court decision under section 6234 becomes final, (B) an administrative adjustment request is made, or (C) in any other case a notice of final partnership adjustment is mailed";
}
@source(IRC_S6225_D, relation = formalizes, coverage = exact, quote = "in the case of an adjustment pursuant to the decision of a court in a proceeding brought under section 6234, such decision becomes final")
rule S6225d2aAdjustmentYearOfFinalCourtDecision defeasible {
    label en official "adjustment year (A): the partnership taxable year in which the court decision in a section 6234 proceeding becomes final";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    for finalOn: Date;
    for adjYear: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    when readjustment_petition_filed_timely(pship, reviewedYear, pr)
        and decision_final_on(pr, finalOn)
        and us.irc.core::year_of(pship, adjYear)
        and us.irc.core::begins(adjYear, beginsOn)
        and us.irc.core::ends(adjYear, endsOn)
        and beginsOn <= finalOn
        and finalOn <= endsOn;
    then bba_adjustment_year_derived(pship, reviewedYear, adjYear);
}
@source(IRC_S6225_D, relation = formalizes, coverage = exact, quote = "in the case of an administrative adjustment request under section 6227, such administrative adjustment request is made")
rule S6225d2bAdjustmentYearOfAdministrativeAdjustmentRequest defeasible {
    label en official "adjustment year (B): the partnership taxable year in which the administrative adjustment request under section 6227 is made";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for filedOn: Date;
    for adjYear: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    when administrative_adjustment_request_filed(pship, reviewedYear, filedOn)
        and us.irc.core::year_of(pship, adjYear)
        and us.irc.core::begins(adjYear, beginsOn)
        and us.irc.core::ends(adjYear, endsOn)
        and beginsOn <= filedOn
        and filedOn <= endsOn;
    then bba_adjustment_year_derived(pship, reviewedYear, adjYear);
}
@source(IRC_S6225_D, relation = formalizes, coverage = exact, quote = "in any other case, notice of the final partnership adjustment is mailed under section 6231")
rule S6225d2cAdjustmentYearOfFpaMailing defeasible {
    label en official "adjustment year (C): in any other case, the partnership taxable year in which the notice of final partnership adjustment is mailed under section 6231";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for mailedOn: Date;
    for adjYear: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    when notice_of_final_partnership_adjustment_mailed(pship, reviewedYear, mailedOn)
        and not_known(exists_readjustment_petition_filed_timely(pship, reviewedYear))
        and us.irc.core::year_of(pship, adjYear)
        and us.irc.core::begins(adjYear, beginsOn)
        and us.irc.core::ends(adjYear, endsOn)
        and beginsOn <= mailedOn
        and mailedOn <= endsOn;
    then bba_adjustment_year_derived(pship, reviewedYear, adjYear);
}

// ============================================================================
// §6226(b) — Adjustments of the partner's tax under the push-out election
// ============================================================================

pub entity PushoutCorrection {
    label en unofficial "one correction amount of section 6226(b)(2) for one taxable year of one partner";
}
pub relation partner_statement_furnished(partner: Person, pship: Partnership, reviewedYear: TaxableYear, furnishedOn: Date) kind empirical {
    label en official "the statement of the partner's share of the adjustments furnished under section 6226(a)(2)";
}
pub relation pushout_correction_of(c: PushoutCorrection, partner: Person, pship: Partnership, reviewedYear: TaxableYear, amount: Money) kind empirical {
    label en official "the amount by which the tax imposed under chapter 1 would increase or decrease if the partner's share of the adjustments were taken into account for the partner's taxable year (section 6226(b)(2)(A)-(B)); computed outside this package (EXTERNAL_DEPENDENCY on the chapter 1 computation)";
}
pub relation pushout_correction_year_ends(c: PushoutCorrection, endsOn: Date) kind empirical {
    label en unofficial "the last day of the partner's taxable year to which the correction amount relates";
}
pub relation pushout_correction_return_due(c: PushoutCorrection, dueOn: Date) kind empirical {
    label en unofficial "the due date of the partner's return for the taxable year to which the correction amount is attributable (section 6226(c)(2)(B))";
}
pub relation partner_is_partnership_or_s_corporation(partner: Person) kind empirical {
    label en official "a partner which receives a statement under subsection (a)(2) is a partnership or an S corporation";
}
pub relation pushout_correction_counted(c: PushoutCorrection, partner: Person, pship: Partnership, reviewedYear: TaxableYear, statementYear: TaxableYear) kind institutional {
    label en unofficial "the correction amount relates to a partner taxable year that ends before the partner taxable year that includes the date the statement was furnished";
}
rule S6226bCorrectionYearsBeforeStatementYear defeasible {
    label en unofficial "correction amounts of years before the year including the statement date are aggregated";
    for c: PushoutCorrection;
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    for furnishedOn: Date;
    for statementYear: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    for correctionYearEnds: Date;
    when pushout_correction_of(c, partner, pship, reviewedYear, amount)
        and pushout_correction_year_ends(c, correctionYearEnds)
        and partner_statement_furnished(partner, pship, reviewedYear, furnishedOn)
        and us.irc.core::year_of(partner, statementYear)
        and us.irc.core::begins(statementYear, beginsOn)
        and us.irc.core::ends(statementYear, endsOn)
        and beginsOn <= furnishedOn
        and furnishedOn <= endsOn
        and correctionYearEnds < beginsOn;
    then pushout_correction_counted(c, partner, pship, reviewedYear, statementYear);
}
pub relation partner_pushout_tax_adjustment(partner: Person, pship: Partnership, reviewedYear: TaxableYear, statementYear: TaxableYear, total: Money) kind institutional {
    label en official "each partner's tax imposed by chapter 1 for the taxable year which includes the date the statement was furnished shall be adjusted by the aggregate of the correction amounts";
}
@source(IRC_S6226_B, relation = formalizes, coverage = exact, quote = "each partner's tax imposed by chapter 1 for the taxable year which includes the date the statement was furnished under subsection (a) shall be adjusted by the aggregate of the correction amounts determined under paragraph (2) for the taxable years referred to therein")
pub rule S6226b1PartnerTaxAdjustedByAggregateCorrections defeasible {
    label en official "the partner's tax for the year including the statement date is adjusted by the aggregate of the correction amounts of the earlier years";
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for statementYear: TaxableYear;
    for c0: PushoutCorrection;
    for amount0: Money;
    when pushout_correction_of(c0, partner, pship, reviewedYear, amount0)
        and pushout_correction_counted(c0, partner, pship, reviewedYear, statementYear)
        and not_known(partner_is_partnership_or_s_corporation(partner));
    then partner_pushout_tax_adjustment(partner, pship, reviewedYear, statementYear,
        sum all amt: Money for c: PushoutCorrection
            where pushout_correction_of(c, partner, pship, reviewedYear, amt)
                and pushout_correction_counted(c, partner, pship, reviewedYear, statementYear));
}
// JUDGMENT CALL: "Except as provided in paragraph (4)" — a partner that is a
// partnership or S corporation does not take the adjustment into its own
// tax (it follows (b)(4)); the rule above is therefore closed to such
// partners by `not_known(partner_is_partnership_or_s_corporation(partner))`.
// TECH_GAP G3700: the correction amounts themselves ((b)(2)(A)-(B)) and the
// attribute adjustments of (b)(3) are supplied by the case (facts of
// `pushout_correction_of`); recomputing a partner's tax across several
// years with adjusted attributes is a multi-year computation outside this
// package.

// --- (b)(4): tiered partners ------------------------------------------------

pub relation tiered_partner_received_statement(partner: Person, auditedPship: Partnership, reviewedYear: TaxableYear, furnishedOn: Date) kind empirical {
    label en official "a partner which is a partnership or an S corporation receives a statement under subsection (a)(2) from the audited partnership (the partnership in the chain of ownership originally electing the application of this section)";
}
pub relation tracking_report_filed(partner: Person, auditedPship: Partnership, reviewedYear: TaxableYear) kind empirical {
    label en official "the partner files with the Secretary a partnership adjustment tracking report which includes such information as the Secretary may require";
}
pub relation tiered_partner_furnished_statements(partner: Person, auditedPship: Partnership, reviewedYear: TaxableYear) kind empirical {
    label en official "the partner furnishes statements under rules similar to the rules of subsection (a)(2)";
}
pub relation tiered_partner_paid_imputed_underpayment(partner: Person, auditedPship: Partnership, reviewedYear: TaxableYear) kind empirical {
    label en official "the partner computes and pays an imputed underpayment under rules similar to the rules of section 6225";
}
pub relation tiered_partner_furnished_or_paid(partner: Person, auditedPship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en unofficial "single-atom condition of the (b)(4)(A)(ii) duty: statements were furnished (subclause (I)) or, if none, the imputed underpayment was computed and paid (subclause (II))";
}
rule S6226b4AiiIFurnished defeasible {
    label en official "the partner furnished statements under rules similar to subsection (a)(2)";
    for partner: Person;
    for auditedPship: Partnership;
    for reviewedYear: TaxableYear;
    when tiered_partner_furnished_statements(partner, auditedPship, reviewedYear);
    then tiered_partner_furnished_or_paid(partner, auditedPship, reviewedYear);
}
rule S6226b4AiiIIPaid defeasible {
    label en official "if no such statements are furnished, the partner computed and paid an imputed underpayment";
    for partner: Person;
    for auditedPship: Partnership;
    for reviewedYear: TaxableYear;
    when tiered_partner_paid_imputed_underpayment(partner, auditedPship, reviewedYear)
        and not_known(tiered_partner_furnished_statements(partner, auditedPship, reviewedYear));
    then tiered_partner_furnished_or_paid(partner, auditedPship, reviewedYear);
}
@source(IRC_S6226_B, relation = formalizes, coverage = exact, quote = "file with the Secretary a partnership adjustment tracking report which includes such information as the Secretary may require")
pub rule S6226b4AiTrackingReportRequired defeasible {
    label en official "a tiered partner shall file a partnership adjustment tracking report, not later than the due date for the return for the adjustment year of the audited partnership";
    for partner: Person;
    for auditedPship: Partnership;
    for reviewedYear: TaxableYear;
    for furnishedOn: Date;
    for adjYear: TaxableYear;
    for dueOn: Date;
    when tiered_partner_received_statement(partner, auditedPship, reviewedYear, furnishedOn)
        and partner_is_partnership_or_s_corporation(partner)
        and adjustment_year_for_reviewed_year(auditedPship, reviewedYear, adjYear)
        and partnership_return_due_date(auditedPship, adjYear, dueOn);
    then duty S6226b4AiTrackingReportDuty {
        bearer partner;
        beneficiary Secretary;
        goal achievement {
            condition tracking_report_filed(partner, auditedPship, reviewedYear);
            window [furnishedOn, dueOn];
        }
    };
}
@source(IRC_S6226_B, relation = formalizes, coverage = exact, quote = "(ii)(I) furnish statements under rules similar to the rules of subsection (a)(2), or")
pub rule S6226b4AiiFurnishOrPayRequired defeasible {
    label en official "a tiered partner shall furnish statements or, if none are furnished, compute and pay an imputed underpayment, not later than the due date for the return for the adjustment year of the audited partnership; the duty holds notwithstanding an election under section 6221(b) ((b)(4)(C))";
    for partner: Person;
    for auditedPship: Partnership;
    for reviewedYear: TaxableYear;
    for furnishedOn: Date;
    for adjYear: TaxableYear;
    for dueOn: Date;
    when tiered_partner_received_statement(partner, auditedPship, reviewedYear, furnishedOn)
        and partner_is_partnership_or_s_corporation(partner)
        and adjustment_year_for_reviewed_year(auditedPship, reviewedYear, adjYear)
        and partnership_return_due_date(auditedPship, adjYear, dueOn);
    then duty S6226b4AiiFurnishOrPayDuty {
        bearer partner;
        beneficiary Secretary;
        goal achievement {
            condition tiered_partner_furnished_or_paid(partner, auditedPship, reviewedYear);
            window [furnishedOn, dueOn];
        }
    };
}
// (b)(4)(C): neither duty rule reads `election_out_of_bba_effective`; the
// duty therefore arises for a partner in a partnership that elected out for
// the year including the end of the reviewed year of the audited partnership.
// (b)(4)(D): "audited partnership" is the partnership in the chain that
// originally elected under this section; the relation
// `tiered_partner_received_statement(partner, auditedPship, ...)` takes it as
// the case's fact. Deriving it by walking a multi-tier chain of ownership is
// TECH_GAP G3701 (ownership chain, recursion over tiers).

// ============================================================================
// §6226(c) — Penalties and interest under the push-out election
// ============================================================================

pub relation partner_for_reviewed_year(partner: Person, pship: Partnership, reviewedYear: TaxableYear) kind empirical {
    label en official "a partner of the partnership for the reviewed year";
}
pub relation push_out_election_effective_twin(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en unofficial "E-0134 twin of `push_out_election_valid`: the election was made within 45 days of the FPA (same premises as the power's valid_when), readable by defeasible rules";
}
rule S6226PushOutElectionEffectiveTwin defeasible {
    label en unofficial "a timely push-out election has effect (readable twin of the power's effect)";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for madeOn: Date;
    when push_out_election_made(pship, reviewedYear, madeOn)
        and push_out_election_timely(pship, reviewedYear);
    then push_out_election_effective_twin(pship, reviewedYear);
}
pub relation partner_liable_for_partnership_penalty(partner: Person, pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en official "the partners of the partnership for the reviewed year shall be liable for any penalty, addition to tax, or additional amount determined at the partnership level under section 6221";
}
@source(IRC_S6226_C, relation = formalizes, coverage = exact, quote = "any penalties, additions to tax, or additional amount shall be determined as provided under section 6221 and the partners of the partnership for the reviewed year shall be liable for any such penalty, addition to tax, or additional amount")
pub rule S6226c1PartnersLiableForPartnershipLevelPenalties defeasible {
    label en official "notwithstanding (a) and (b), penalties are determined at the partnership level and the partners for the reviewed year are liable for them";
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    when push_out_election_effective_twin(pship, reviewedYear)
        and partner_for_reviewed_year(partner, pship, reviewedYear)
        and partnership_level_determination(pship, reviewedYear);
    then partner_liable_for_partnership_penalty(partner, pship, reviewedYear);
}
pub relation pushout_interest_determined_at_partner_level(c: PushoutCorrection, partner: Person) kind institutional {
    label en official "interest is determined at the partner level";
}
pub relation pushout_interest_runs_from(c: PushoutCorrection, fromDate: Date) kind institutional {
    label en official "from the due date of the return for the taxable year to which the increase is attributable";
}
pub relation pushout_interest_rate_spread_points(c: PushoutCorrection, points: Integer) kind institutional {
    label en official "at the underpayment rate under section 6621(a)(2), determined by substituting 5 percentage points for 3 percentage points in subparagraph (B) thereof";
}
@source(IRC_S6226_C, relation = formalizes, coverage = exact, quote = "at the partner level,")
rule S6226c2AInterestAtPartnerLevel defeasible {
    label en official "interest on a push-out imputed underpayment is determined at the partner level";
    for c: PushoutCorrection;
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    when pushout_correction_of(c, partner, pship, reviewedYear, amount)
        and push_out_election_effective_twin(pship, reviewedYear);
    then pushout_interest_determined_at_partner_level(c, partner);
}
@source(IRC_S6226_C, relation = formalizes, coverage = exact, quote = "from the due date of the return for the taxable year to which the increase is attributable")
rule S6226c2BInterestRunsFromReturnDueDate defeasible {
    label en official "interest runs from the due date of the return for the taxable year to which the increase is attributable";
    for c: PushoutCorrection;
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    for dueOn: Date;
    when pushout_correction_of(c, partner, pship, reviewedYear, amount)
        and push_out_election_effective_twin(pship, reviewedYear)
        and pushout_correction_return_due(c, dueOn);
    then pushout_interest_runs_from(c, dueOn);
}
@source(IRC_S6226_C, relation = formalizes, coverage = exact, quote = "determined by substituting \"5 percentage points\" for \"3 percentage points\" in subparagraph (B) thereof")
rule S6226c2CInterestRateSpreadFivePoints defeasible {
    label en official "the underpayment rate of section 6621(a)(2) is applied with 5 percentage points in place of 3 (the rate itself is chapter 67, owner payment-refunds-interest)";
    for c: PushoutCorrection;
    for partner: Person;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    when pushout_correction_of(c, partner, pship, reviewedYear, amount)
        and push_out_election_effective_twin(pship, reviewedYear);
    then pushout_interest_rate_spread_points(c, 5);
}

// ============================================================================
// §6227(b) — Effect of an administrative adjustment request
// ============================================================================

pub enum AarRoute {
    PartnershipPaysImputedUnderpayment;
    PartnersTakeAdjustmentIntoAccount;
    label en unofficial "the two ways section 6227(b) lets an adjustment be taken into account: (1) by the partnership under rules similar to section 6225, (2) by the partnership and partners under rules similar to section 6226";
}
pub relation aar_adjustment_year(pship: Partnership, reviewedYear: TaxableYear, filingYear: TaxableYear) kind institutional {
    label en official "the adjustment is determined and taken into account for the partnership taxable year in which the administrative adjustment request is filed";
}
@source(IRC_S6227_B, relation = formalizes, coverage = exact, quote = "Any such adjustment under subsection (a) shall be determined and taken into account for the partnership taxable year in which the administrative adjustment request is filed")
rule S6227bAdjustmentTakenIntoAccountInFilingYear defeasible {
    label en official "the AAR adjustment is taken into account for the partnership taxable year in which the request is filed";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for filedOn: Date;
    for filingYear: TaxableYear;
    for beginsOn: Date;
    for endsOn: Date;
    when administrative_adjustment_request_filed(pship, reviewedYear, filedOn)
        and us.irc.core::year_of(pship, filingYear)
        and us.irc.core::begins(filingYear, beginsOn)
        and us.irc.core::ends(filingYear, endsOn)
        and beginsOn <= filedOn
        and filedOn <= endsOn;
    then aar_adjustment_year(pship, reviewedYear, filingYear);
}
pub relation aar_route_available(pship: Partnership, reviewedYear: TaxableYear, route: AarRoute) kind institutional {
    label en official "the route by which the AAR adjustment is taken into account";
}
pub relation aar_adjustment_results_in_imputed_underpayment(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en unofficial "the AAR adjustment would result in a positive imputed underpayment";
}
rule S6227bAdjustmentResultsInImputedUnderpayment defeasible {
    label en unofficial "the imputed underpayment for the year is positive";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    for filedOn: Date;
    when administrative_adjustment_request_filed(pship, reviewedYear, filedOn)
        and imputed_underpayment(pship, reviewedYear, amount)
        and amount > 0.00 USD;
    then aar_adjustment_results_in_imputed_underpayment(pship, reviewedYear);
}
@source(IRC_S6227_B, relation = formalizes, coverage = exact, quote = "by the partnership and partners under rules similar to the rules of section 6226")
rule S6227b2PartnersRouteAlwaysAvailable defeasible {
    label en official "the partnership and partners may take the AAR adjustment into account under rules similar to section 6226";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for filedOn: Date;
    when administrative_adjustment_request_filed(pship, reviewedYear, filedOn);
    then aar_route_available(pship, reviewedYear, PartnersTakeAdjustmentIntoAccount);
}
@source(IRC_S6227_B, relation = formalizes, coverage = exact, quote = "In the case of an adjustment that would not result in an imputed underpayment, paragraph (1) shall not apply and paragraph (2) shall apply with appropriate adjustments.")
rule S6227b1PartnershipRouteOnlyForImputedUnderpayment defeasible {
    label en official "the partnership route (1) applies only where the adjustment results in an imputed underpayment";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for filedOn: Date;
    when administrative_adjustment_request_filed(pship, reviewedYear, filedOn)
        and aar_adjustment_results_in_imputed_underpayment(pship, reviewedYear);
    then aar_route_available(pship, reviewedYear, PartnershipPaysImputedUnderpayment);
}

// ============================================================================
// §6231(c)-(d) — Further notices and rescission
// ============================================================================

external judgment relation fpa_fraud_malfeasance_or_misrepresentation_shown(pship: Partnership, y: TaxableYear) {
    authority TaxCourt;
    label en official "a showing of fraud, malfeasance, or misrepresentation of a material fact";
}
pub relation secretary_mails_further_fpa(pship: Partnership, y: TaxableYear, mailedOn: Date) kind empirical {
    label en official "the Secretary mails another notice of final partnership adjustment to the partnership for the same taxable year";
}
@source(IRC_S6231_C, relation = formalizes, coverage = exact, quote = "the Secretary shall not mail another such notice to such partnership with respect to such taxable year")
pub rule S6231cNoFurtherFpaAfterPetition defeasible {
    label en official "after the partnership files a petition under section 6234, the Secretary shall not mail another FPA for the same taxable year absent fraud, malfeasance, or misrepresentation";
    for pship: Partnership;
    for y: TaxableYear;
    for firstOn: Date;
    for pr: Proceeding;
    for petitionOn: Date;
    for furtherOn: Date;
    when notice_of_final_partnership_adjustment_mailed(pship, y, firstOn)
        and readjustment_petition_filed(pship, y, pr, petitionOn)
        and secretary_mails_further_fpa(pship, y, furtherOn)
        and furtherOn > firstOn;
    then prohibition S6231cNoSecondFpaProhibition {
        bearer Secretary;
        beneficiary pship;
        action secretary_mails_further_fpa(pship, y, furtherOn);
        window [-infinity, infinity];
    };
    unless fpa_fraud_malfeasance_or_misrepresentation_shown(pship, y) and secretary_mails_further_fpa(pship, y, furtherOn);
}
pub relation secretary_rescinds_fpa(pship: Partnership, y: TaxableYear, mailedOn: Date) kind empirical {
    label en official "the Secretary rescinds a notice of a partnership adjustment mailed to the partnership";
}
pub relation partnership_consents_to_fpa_rescission(pship: Partnership, y: TaxableYear, mailedOn: Date) kind empirical {
    label en official "the partnership consents to the rescission of the notice of a partnership adjustment";
}
pub relation fpa_rescinded_with_consent_twin(pship: Partnership, y: TaxableYear, mailedOn: Date) kind institutional {
    label en unofficial "E-0134 twin of the rescission power's effect: the notice was rescinded with the partnership's consent and is not treated as a notice of partnership adjustment for purposes of this subchapter";
}
rule S6231dRescissionTwin defeasible {
    label en unofficial "a consented rescission removes the notice's effect (readable twin)";
    for pship: Partnership;
    for y: TaxableYear;
    for mailedOn: Date;
    when secretary_rescinds_fpa(pship, y, mailedOn)
        and partnership_consents_to_fpa_rescission(pship, y, mailedOn);
    then fpa_rescinded_with_consent_twin(pship, y, mailedOn);
}
pub relation fpa_rescinded(pship: Partnership, y: TaxableYear, mailedOn: Date) kind institutional {
    label en official "any notice so rescinded shall not be treated as a notice of partnership adjustment for purposes of this subchapter, and the taxpayer shall have no right to bring a proceeding under section 6234 with respect to such notice";
}
@source(IRC_S6231_D, relation = formalizes, coverage = exact, quote = "The Secretary may, with the consent of the partnership, rescind any notice of a partnership adjustment mailed to such partnership.")
pub rule S6231dRescindNotice defeasible {
    label en official "the Secretary may, with the consent of the partnership, rescind a notice of partnership adjustment";
    for pship: Partnership;
    for y: TaxableYear;
    for mailedOn: Date;
    when secretary_rescinds_fpa(pship, y, mailedOn);
    then power S6231dRescindFpaPower {
        holder Secretary;
        over pship;
        exercise secretary_rescinds_fpa(pship, y, mailedOn);
        valid_when partnership_consents_to_fpa_rescission(pship, y, mailedOn);
        effect create(fpa_rescinded(pship, y, mailedOn));
    };
}

// ============================================================================
// §6232(c) — Injunction against a premature assessment or collection
// ============================================================================

pub relation court_other_than_tax_court(court: Organ) kind empirical {
    label en official "the proper court (a court other than the Tax Court)";
}
pub relation court_enjoins_action(court: Organ, pship: Partnership, y: TaxableYear, actionOn: Date) kind empirical {
    label en official "a court enjoins an action that violates section 6232(b)";
}
pub relation action_violates_6232b(pship: Partnership, y: TaxableYear, actionOn: Date) kind institutional {
    label en unofficial "the action (assessment/levy/proceeding) is made before the 6232(b) conditions are met";
}
rule S6232cActionViolatesRestriction defeasible {
    label en unofficial "an attempted assessment during the 90-day window violates the 6232(b) restriction";
    for pship: Partnership;
    for y: TaxableYear;
    for mailedOn: Date;
    for attemptedOn: Date;
    when fpa_effective(pship, y, mailedOn)
        and attempted_assessment_of_imputed_underpayment(pship, y, attemptedOn)
        and attemptedOn < add_calendar_period(mailedOn, 90 calendar_day);
    then action_violates_6232b(pship, y, attemptedOn);
}
pub relation injunction_available(court: Organ, pship: Partnership, y: TaxableYear, actionOn: Date) kind institutional {
    label en unofficial "single-atom valid_when helper: the court may enjoin (Tax Court only if a timely petition was filed under section 6234)";
}
rule S6232cInjunctionByProperCourt defeasible {
    label en official "any action which violates subsection (b) may be enjoined in the proper court";
    for court: Organ;
    for pship: Partnership;
    for y: TaxableYear;
    for actionOn: Date;
    when court_enjoins_action(court, pship, y, actionOn)
        and court_other_than_tax_court(court)
        and action_violates_6232b(pship, y, actionOn);
    then injunction_available(court, pship, y, actionOn);
}
rule S6232cInjunctionByTaxCourtOnlyWithTimelyPetition defeasible {
    label en official "the Tax Court has no jurisdiction to enjoin unless a timely petition has been filed under section 6234";
    for pship: Partnership;
    for y: TaxableYear;
    for actionOn: Date;
    for pr: Proceeding;
    when court_enjoins_action(us.irc.core::TaxCourt, pship, y, actionOn)
        and action_violates_6232b(pship, y, actionOn)
        and readjustment_petition_filed_timely(pship, y, pr);
    then injunction_available(us.irc.core::TaxCourt, pship, y, actionOn);
}
pub relation action_enjoined(pship: Partnership, y: TaxableYear, actionOn: Date) kind institutional {
    label en official "the action that violates subsection (b) has been enjoined";
}
@source(IRC_S6232_C, relation = formalizes, coverage = exact, quote = "any action which violates subsection (b) may be enjoined in the proper court, including the Tax Court")
pub rule S6232cEnjoinViolatingAction defeasible {
    label en official "notwithstanding section 7421(a), an action which violates subsection (b) may be enjoined";
    for court: Organ;
    for pship: Partnership;
    for y: TaxableYear;
    for actionOn: Date;
    when court_enjoins_action(court, pship, y, actionOn);
    then power S6232cEnjoinActionPower {
        holder court;
        over pship;
        exercise court_enjoins_action(court, pship, y, actionOn);
        valid_when injunction_available(court, pship, y, actionOn);
        effect create(action_enjoined(pship, y, actionOn));
    };
}
// The Tax Court's further limit ("only in respect of the adjustments that are
// the subject of such petition") is not modelled item by item: the petition
// fact is keyed by partnership and year, not by adjustment (TECH_GAP G3702).

// ============================================================================
// §6232(d) — Math or clerical error and waiver
// ============================================================================

pub relation partnership_failure_adjustment_treated_as_math_error(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "an adjustment on account of a partnership's failure to comply with section 6222(a) with respect to its interest in another partnership is treated as a math-or-clerical-error adjustment, except that section 6213(b)(2) (abatement) does not apply";
}
@source(IRC_S6232_D, relation = formalizes, coverage = exact, quote = "any adjustment on account of such partnership's failure to comply with the requirements of section 6222(a) with respect to its interest in such other partnership shall be treated as an adjustment referred to in subparagraph (A)")
rule S6232d1BTieredPartnershipInconsistencyAsMathError defeasible {
    label en official "a tiered partnership's inconsistent treatment is a math-error-style adjustment without the section 6213(b)(2) abatement";
    for pship: Partnership;
    for other: Partnership;
    for y: TaxableYear;
    for item: Money;
    when partner_treatment_inconsistent(pship, other, y, item)
        and us.irc.partnerships::is_partner(pship, other);
    then partnership_failure_adjustment_treated_as_math_error(pship, y);
}
pub relation partnership_waives_restrictions(pship: Partnership, y: TaxableYear, waivedOn: Date) kind empirical {
    label en official "the partnership, by a signed notice in writing filed with the Secretary, waives the restrictions provided in subsection (b) on the making of any partnership adjustment";
}
pub relation partnership_waiver_signed_and_filed(pship: Partnership, y: TaxableYear, waivedOn: Date) kind empirical {
    label en official "the waiver is a signed notice in writing filed with the Secretary";
}
pub relation restrictions_waived_twin(pship: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "E-0134 twin of the waiver power's effect: the section 6232(b) restrictions are waived for the year";
}
rule S6232dWaiverTwin defeasible {
    label en unofficial "a signed and filed waiver removes the (b) restrictions (readable twin)";
    for pship: Partnership;
    for y: TaxableYear;
    for waivedOn: Date;
    when partnership_waives_restrictions(pship, y, waivedOn)
        and partnership_waiver_signed_and_filed(pship, y, waivedOn);
    then restrictions_waived_twin(pship, y);
}
pub relation partnership_restrictions_waived(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the restrictions provided in subsection (b) on the making of any partnership adjustment are waived";
}
@source(IRC_S6232_D, relation = formalizes, coverage = exact, quote = "The partnership may at any time (whether or not any notice of partnership adjustment has been issued), by a signed notice in writing filed with the Secretary, waive the restrictions provided in subsection (b)")
pub rule S6232d2WaiveRestrictions defeasible {
    label en official "the partnership may at any time waive the (b) restrictions by a signed notice in writing filed with the Secretary";
    for pship: Partnership;
    for y: TaxableYear;
    for waivedOn: Date;
    when partnership_waives_restrictions(pship, y, waivedOn);
    then power S6232d2WaiverPower {
        holder pship;
        over Secretary;
        exercise partnership_waives_restrictions(pship, y, waivedOn);
        valid_when partnership_waiver_signed_and_filed(pship, y, waivedOn);
        effect create(partnership_restrictions_waived(pship, y));
    };
}

// ============================================================================
// §6232(e) — Limit on the amount of liability when no petition is filed
// ============================================================================

pub relation fpa_imputed_underpayment_amount(pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount determined in accordance with the notice of final partnership adjustment";
}
pub relation partnership_liability_cap(pship: Partnership, y: TaxableYear, cap: Money) kind institutional {
    label en official "the amount for which the partnership is liable under section 6225 shall not exceed the amount determined in accordance with the notice";
}
@source(IRC_S6232_E, relation = formalizes, coverage = exact, quote = "the amount for which the partnership is liable under section 6225 shall not exceed the amount determined in accordance with such notice")
rule S6232eLiabilityCappedAtFpaAmount defeasible {
    label en official "if no proceeding under section 6234 is begun in the 90-day period, the liability under section 6225 does not exceed the FPA amount";
    for pship: Partnership;
    for y: TaxableYear;
    for mailedOn: Date;
    for asOf: Date;
    for amount: Money;
    when fpa_effective(pship, y, mailedOn)
        and finality_check_as_of(pship, y, asOf)
        and asOf >= add_calendar_period(mailedOn, 90 calendar_day)
        and not_known(exists_readjustment_petition_filed_timely(pship, y))
        and fpa_imputed_underpayment_amount(pship, y, amount);
    then partnership_liability_cap(pship, y, amount);
}

// ============================================================================
// §6232(f) — Failure to pay: assessment against partners
// ============================================================================

pub relation notice_and_demand_for_imputed_underpayment(pship: Partnership, y: TaxableYear, demandedOn: Date, amount: Money) kind empirical {
    label en official "the Secretary provides notice and demand for payment of an imputed underpayment (or a specified similar amount)";
}
pub relation imputed_underpayment_paid_by_partnership(pship: Partnership, y: TaxableYear, paidOn: Date) kind empirical {
    label en official "the partnership pays the amount";
}
pub relation exists_imputed_underpayment_paid_by_partnership(pship: Partnership, y: TaxableYear) kind institutional {
    label en unofficial "existential wrapper over `imputed_underpayment_paid_by_partnership` for not_known";
}
rule S6232fExistsPaymentByPartnership strict {
    label en unofficial "the partnership has paid";
    for pship: Partnership;
    for y: TaxableYear;
    for paidOn: Date;
    when imputed_underpayment_paid_by_partnership(pship, y, paidOn);
    then exists_imputed_underpayment_paid_by_partnership(pship, y);
}
pub relation unpaid_after_ten_days(pship: Partnership, y: TaxableYear, demandedOn: Date, amount: Money) kind institutional {
    label en official "the amount has not been paid by the date which is 10 days after the date on which the Secretary provides notice and demand";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "has not been paid by the date which is 10 days after the date on which the Secretary provides notice and demand for such payment")
rule S6232f1UnpaidAfterTenDays defeasible {
    label en official "the imputed underpayment is unpaid on the 10th day after notice and demand";
    for pship: Partnership;
    for y: TaxableYear;
    for demandedOn: Date;
    for amount: Money;
    for asOf: Date;
    when notice_and_demand_for_imputed_underpayment(pship, y, demandedOn, amount)
        and finality_check_as_of(pship, y, asOf)
        and asOf > add_calendar_period(demandedOn, 10 calendar_day)
        and not_known(exists_imputed_underpayment_paid_by_partnership(pship, y));
    then unpaid_after_ten_days(pship, y, demandedOn, amount);
}
pub relation section_6621_spread_points_after_ten_days(pship: Partnership, y: TaxableYear, points: Integer) kind institutional {
    label en official "section 6621(a)(2)(B) is applied by substituting 5 percentage points for 3 percentage points";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "section 6621(a)(2)(B) shall be applied by substituting \"5 percentage points\" for \"3 percentage points\" with respect to such amount")
rule S6232f1ARateSpreadFivePoints defeasible {
    label en official "after 10 days from notice and demand the underpayment rate spread is 5 percentage points (rate itself: chapter 67)";
    for pship: Partnership;
    for y: TaxableYear;
    for demandedOn: Date;
    for amount: Money;
    when unpaid_after_ten_days(pship, y, demandedOn, amount);
    then section_6621_spread_points_after_ten_days(pship, y, 5);
}
pub relation partner_proportionate_share(partner: Person, pship: Partnership, y: TaxableYear, share: Decimal) kind empirical {
    label en official "the partner's proportionate share as a fraction of 1: such percentage as the Secretary may determine on the basis of the partner's distributive share (section 6232(f)(3))";
}
pub relation partner_share_sum(pship: Partnership, y: TaxableYear, total: Decimal) kind institutional {
    label en unofficial "sum of the proportionate shares the Secretary determined";
}
rule S6232f3ShareSum defeasible {
    label en unofficial "the aggregate of the proportionate shares determined";
    for pship: Partnership;
    for y: TaxableYear;
    for partner0: Person;
    for share0: Decimal;
    when partner_proportionate_share(partner0, pship, y, share0);
    then partner_share_sum(pship, y, sum all s: Decimal for pt: Person where partner_proportionate_share(pt, pship, y, s));
}
pub relation proportionate_shares_total_one_hundred_percent(pship: Partnership, y: TaxableYear) kind institutional {
    label en official "the Secretary shall make determinations such that the aggregate proportionate shares so determined total 100 percent";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "The Secretary shall make determinations under the preceding sentence such that the aggregate proportionate shares so determined total 100 percent.")
rule S6232f3SharesTotalOneHundredPercent defeasible {
    label en official "the determined proportionate shares total 100 percent";
    for pship: Partnership;
    for y: TaxableYear;
    for total: Decimal;
    when partner_share_sum(pship, y, total)
        and total == 1.00;
    then proportionate_shares_total_one_hundred_percent(pship, y);
}
pub relation secretary_assesses_partner_share(partner: Person, pship: Partnership, y: TaxableYear, assessedOn: Date) kind empirical {
    label en official "the Secretary assesses upon a partner a tax equal to the partner's proportionate share of the unpaid amount";
}
pub relation partner_assessment_conditions_met(partner: Person, pship: Partnership, y: TaxableYear, assessedOn: Date) kind institutional {
    label en unofficial "single-atom valid_when helper: amount unpaid after 10 days, not paid by the partnership, shares total 100 percent, and the assessment is made within 2 years after notice and demand ((f)(6)(B))";
}
rule S6232f1BPartnerAssessmentConditions defeasible {
    label en official "the assessment upon a partner requires the amount to be unpaid after 10 days, not paid by the partnership, and made within 2 years after notice and demand";
    for partner: Person;
    for pship: Partnership;
    for y: TaxableYear;
    for assessedOn: Date;
    for demandedOn: Date;
    for amount: Money;
    when secretary_assesses_partner_share(partner, pship, y, assessedOn)
        and unpaid_after_ten_days(pship, y, demandedOn, amount)
        and not_known(exists_imputed_underpayment_paid_by_partnership(pship, y))
        and proportionate_shares_total_one_hundred_percent(pship, y)
        and assessedOn <= add_calendar_period(demandedOn, 2 calendar_year);
    then partner_assessment_conditions_met(partner, pship, y, assessedOn);
}
pub relation partner_assessed_proportionate_share(partner: Person, pship: Partnership, y: TaxableYear) kind institutional {
    label en official "a tax equal to the partner's proportionate share of the amount (including interest and penalties) has been assessed upon the partner";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "the Secretary may assess upon each partner of the partnership")
pub rule S6232f1BAssessPartner defeasible {
    label en official "the Secretary may assess upon each partner a tax equal to the partner's proportionate share of the unpaid amount";
    for partner: Person;
    for pship: Partnership;
    for y: TaxableYear;
    for assessedOn: Date;
    when secretary_assesses_partner_share(partner, pship, y, assessedOn);
    then power S6232f1BAssessPartnerPower {
        holder Secretary;
        over partner;
        exercise secretary_assesses_partner_share(partner, pship, y, assessedOn);
        valid_when partner_assessment_conditions_met(partner, pship, y, assessedOn);
        effect create(partner_assessed_proportionate_share(partner, pship, y));
    };
}
pub relation partner_assessment_amount(partner: Person, pship: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "the partner's proportionate share of the unpaid amount";
}
// JUDGMENT CALL: the statute names no rounding of the partner's share; the
// corpus convention (cents, HALF_UP) is applied to the product of the amount
// and the share fraction.
rule S6232f1BPartnerShareAmount defeasible {
    label en official "the partner's assessed tax equals the proportionate share of the amount";
    for partner: Person;
    for pship: Partnership;
    for y: TaxableYear;
    for demandedOn: Date;
    for amount: Money;
    for share: Decimal;
    when unpaid_after_ten_days(pship, y, demandedOn, amount)
        and partner_proportionate_share(partner, pship, y, share);
    then partner_assessment_amount(partner, pship, y, round(amount * share, 2, "HALF_UP"));
}
pub relation specified_similar_amount(pship: Partnership, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount described in subclause (II) of section 6226(b)(4)(A)(ii) (an imputed underpayment computed and paid by a tiered partner), or an amount assessed upon a partner which is a partnership";
}
pub relation tiered_imputed_underpayment_computed(pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en official "the imputed underpayment a tiered partner computes under section 6226(b)(4)(A)(ii)(II) (including a failure treated as a failure to pay under section 6651(i))";
}
@source(IRC_S6232_F, relation = formalizes, coverage = partial, quote = "the amount described in subclause (II) of section 6226(b)(4)(A)(ii)")
rule S6232f2ASpecifiedSimilarAmountTieredComputed defeasible {
    label en official "a specified similar amount includes the amount of the tiered partner's own imputed underpayment";
    for pship: Partnership;
    for y: TaxableYear;
    for amount: Money;
    when tiered_imputed_underpayment_computed(pship, y, amount);
    then specified_similar_amount(pship, y, amount);
}
// TECH_GAP G3703: (f)(2)(B) — any amount assessed under (f)(1)(B) upon a
// partner which is a partnership becomes itself a specified similar amount
// (a recursion through the ownership tiers, and the assessment is a power
// effect not readable by rules).
pub relation partner_paid_share(partner: Person, pship: Partnership, y: TaxableYear, amount: Money) kind empirical {
    label en official "the partner pays the amount for which it was made liable under paragraph (1)";
}
pub relation partnership_liability_after_partner_payments(pship: Partnership, y: TaxableYear, remaining: Money) kind institutional {
    label en official "the liability of the partnership shall be reduced upon payment by the partner";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "The liability of the partnership for any amount with respect to which a partner is made liable under paragraph (1) shall be reduced upon payment by the partner of such amount.")
rule S6232f4LiabilityReducedByPartnerPayments defeasible {
    label en official "the partnership's liability is reduced by the amounts paid by partners";
    for pship: Partnership;
    for y: TaxableYear;
    for demandedOn: Date;
    for amount: Money;
    when notice_and_demand_for_imputed_underpayment(pship, y, demandedOn, amount);
    then partnership_liability_after_partner_payments(pship, y, amount - sum all paid: Money for pt: Person where partner_paid_share(pt, pship, y, paid));
}
pub relation deficiency_procedures_inapplicable_to_partner_assessment(partner: Person, pship: Partnership, y: TaxableYear) kind institutional {
    label en official "subchapter B (deficiency procedures) shall not apply to any assessment or collection under this paragraph";
}
@source(IRC_S6232_F, relation = formalizes, coverage = exact, quote = "Subchapter B shall not apply to any assessment or collection under this paragraph.")
rule S6232f6ADeficiencyProceduresInapplicable defeasible {
    label en official "assessment on a partner under (f)(1) is outside the deficiency procedures of subchapter B";
    for partner: Person;
    for pship: Partnership;
    for y: TaxableYear;
    for assessedOn: Date;
    when secretary_assesses_partner_share(partner, pship, y, assessedOn);
    then deficiency_procedures_inapplicable_to_partner_assessment(partner, pship, y);
}
// (f)(5) — S corporation treated as a partnership: TECH_GAP G3704 (the
// relations of this module are typed `Partnership`; the statute makes the
// same rules apply to an S corporation and its shareholders — same shape,
// entity type not generalized this stage).

// ============================================================================
// §6233 — Interest and penalties
// ============================================================================

pub relation imputed_underpayment_paid_on(pship: Partnership, reviewedYear: TaxableYear, paidOn: Date) kind empirical {
    label en official "the date payment of the imputed underpayment is made";
}
pub relation exists_imputed_underpayment_paid_on(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en unofficial "existential wrapper over `imputed_underpayment_paid_on` for not_known";
}
rule S6233ExistsPaymentDate strict {
    label en unofficial "a payment date of the imputed underpayment is recorded";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for paidOn: Date;
    when imputed_underpayment_paid_on(pship, reviewedYear, paidOn);
    then exists_imputed_underpayment_paid_on(pship, reviewedYear);
}
pub relation bba_interest_period(pship: Partnership, reviewedYear: TaxableYear, startsOn: Date, endsOn: Date) kind institutional {
    label en official "the interest period of section 6233(a)(2): from the day after the return due date for the reviewed year to the return due date for the adjustment year (or, if earlier, the date payment of the imputed underpayment is made)";
}
@source(IRC_S6233_A, relation = formalizes, coverage = exact, quote = "the period beginning on the day after the return due date for the reviewed year and ending on the return due date for the adjustment year")
rule S6233a2InterestPeriodEndsAtAdjustmentYearDueDateNoPayment defeasible {
    label en official "interest runs from the day after the reviewed year's return due date to the adjustment year's return due date";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for adjYear: TaxableYear;
    for reviewedDue: Date;
    for adjustmentDue: Date;
    when bba_adjustment_year_derived(pship, reviewedYear, adjYear)
        and partnership_return_due_date(pship, reviewedYear, reviewedDue)
        and partnership_return_due_date(pship, adjYear, adjustmentDue)
        and not_known(exists_imputed_underpayment_paid_on(pship, reviewedYear))
        and not_known(push_out_election_effective_twin(pship, reviewedYear));
    then bba_interest_period(pship, reviewedYear, add_calendar_period(reviewedDue, 1 calendar_day), adjustmentDue);
}
@source(IRC_S6233_A, relation = formalizes, coverage = exact, quote = "(or, if earlier, the date payment of the imputed underpayment is made)")
rule S6233a2InterestPeriodEndsAtEarlierPayment defeasible {
    label en official "if payment of the imputed underpayment is made before the adjustment year's return due date, interest ends at payment";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for adjYear: TaxableYear;
    for reviewedDue: Date;
    for adjustmentDue: Date;
    for paidOn: Date;
    when bba_adjustment_year_derived(pship, reviewedYear, adjYear)
        and partnership_return_due_date(pship, reviewedYear, reviewedDue)
        and partnership_return_due_date(pship, adjYear, adjustmentDue)
        and imputed_underpayment_paid_on(pship, reviewedYear, paidOn)
        and paidOn <= adjustmentDue
        and not_known(push_out_election_effective_twin(pship, reviewedYear));
    then bba_interest_period(pship, reviewedYear, add_calendar_period(reviewedDue, 1 calendar_day), paidOn);
}
@source(IRC_S6233_A, relation = formalizes, coverage = exact, quote = "the period beginning on the day after the return due date for the reviewed year and ending on the return due date for the adjustment year")
rule S6233a2InterestPeriodLaterPaymentDoesNotExtend defeasible {
    label en official "payment after the adjustment year's return due date does not move the end of the interest period";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for adjYear: TaxableYear;
    for reviewedDue: Date;
    for adjustmentDue: Date;
    for paidOn: Date;
    when bba_adjustment_year_derived(pship, reviewedYear, adjYear)
        and partnership_return_due_date(pship, reviewedYear, reviewedDue)
        and partnership_return_due_date(pship, adjYear, adjustmentDue)
        and imputed_underpayment_paid_on(pship, reviewedYear, paidOn)
        and paidOn > adjustmentDue
        and not_known(push_out_election_effective_twin(pship, reviewedYear));
    then bba_interest_period(pship, reviewedYear, add_calendar_period(reviewedDue, 1 calendar_day), adjustmentDue);
}
// The second sentence of (a)(2) ("proper adjustments ... shall be made for
// adjustments required for partnership taxable years ...") is not modelled
// (TECH_GAP G3705: multi-year adjustment of the interest base). The interest
// amount itself is chapter 67 (owner `payment-refunds-interest`).
pub relation partnership_penalty_base_underpayment(pship: Partnership, reviewedYear: TaxableYear, amount: Money) kind institutional {
    label en official "penalties are determined at the partnership level as if the partnership were an individual subject to chapter 1 tax for the reviewed year and the imputed underpayment were an actual underpayment";
}
@source(IRC_S6233_A, relation = formalizes, coverage = partial, quote = "shall be determined at the partnership level as if such partnership had been an individual subject to tax under chapter 1 for the reviewed year and the imputed underpayment were an actual underpayment")
rule S6233a3PenaltyBaseIsImputedUnderpayment defeasible {
    label en official "the imputed underpayment is the underpayment on which partnership-level penalties are determined (the penalty computation is owned by `penalties`)";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    when imputed_underpayment(pship, reviewedYear, amount)
        and not_known(push_out_election_effective_twin(pship, reviewedYear));
    then partnership_penalty_base_underpayment(pship, reviewedYear, amount);
}
pub relation imputed_underpayment_not_paid_by_prescribed_date(pship: Partnership, reviewedYear: TaxableYear, prescribedOn: Date) kind empirical {
    label en official "failure to pay an imputed underpayment on the date prescribed therefor";
}
pub relation partnership_liable_for_nonpayment_interest(pship: Partnership, reviewedYear: TaxableYear, fromDate: Date) kind institutional {
    label en official "the partnership is liable for interest, determined by treating the imputed underpayment as an underpayment of tax imposed in the adjustment year";
}
pub relation partnership_liable_for_nonpayment_penalty(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en official "the partnership is liable for penalties determined by applying section 6651(a)(2) to the failure to pay and by treating the imputed underpayment as an underpayment of tax for part II of subchapter A of chapter 68";
}
@source(IRC_S6233_B, relation = formalizes, coverage = exact, quote = "In the case of any failure to pay an imputed underpayment on the date prescribed therefor, the partnership shall be liable—")
rule S6233bLiabilityForNonpaymentInterest defeasible {
    label en official "on failure to pay an imputed underpayment on the prescribed date the partnership is liable for interest as (b)(2) determines";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for prescribedOn: Date;
    when imputed_underpayment_not_paid_by_prescribed_date(pship, reviewedYear, prescribedOn);
    then partnership_liable_for_nonpayment_interest(pship, reviewedYear, prescribedOn);
}
@source(IRC_S6233_B, relation = formalizes, coverage = exact, quote = "In the case of any failure to pay an imputed underpayment on the date prescribed therefor, the partnership shall be liable—")
rule S6233bLiabilityForNonpaymentPenalty defeasible {
    label en official "on failure to pay an imputed underpayment on the prescribed date the partnership is liable for penalties as (b)(3) determines";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for prescribedOn: Date;
    when imputed_underpayment_not_paid_by_prescribed_date(pship, reviewedYear, prescribedOn);
    then partnership_liable_for_nonpayment_penalty(pship, reviewedYear);
}

// ============================================================================
// §6234(b)-(e) — Judicial review: deposit, jurisdiction, effect, dismissal
// ============================================================================

pub relation petition_in_district_or_claims_court(pr: Proceeding) kind empirical {
    label en official "the petition is filed in a district court of the United States or the Court of Federal Claims";
}
pub relation required_deposit_amount(pship: Partnership, reviewedYear: TaxableYear, amount: Money) kind empirical {
    label en official "the imputed underpayment, penalties, additions to tax, and additional amounts with respect to it, as of the date of the filing of the petition, if the adjustment were made as provided by the notice";
}
pub relation deposit_made(pship: Partnership, reviewedYear: TaxableYear, amount: Money, depositedOn: Date) kind empirical {
    label en official "the partnership deposits with the Secretary the required amount";
}
pub relation deposit_condition_met(pship: Partnership, reviewedYear: TaxableYear, pr: Proceeding) kind institutional {
    label en unofficial "single-atom valid_when helper: the required amount was deposited on or before the date the petition was filed";
}
rule S6234b1DepositConditionMet defeasible {
    label en official "the required amount is deposited on or before the date the petition is filed";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    for filedOn: Date;
    for required: Money;
    for deposited: Money;
    for depositedOn: Date;
    when readjustment_petition_filed(pship, reviewedYear, pr, filedOn)
        and required_deposit_amount(pship, reviewedYear, required)
        and deposit_made(pship, reviewedYear, deposited, depositedOn)
        and deposited >= required
        and depositedOn <= filedOn;
    then deposit_condition_met(pship, reviewedYear, pr);
}
pub relation district_or_claims_court_petition_admissible(pship: Partnership, reviewedYear: TaxableYear, pr: Proceeding) kind institutional {
    label en official "a readjustment petition may be filed in a district court or the Court of Federal Claims only if the deposit was made";
}
@source(IRC_S6234_B, relation = formalizes, coverage = exact, quote = "A readjustment petition under this section may be filed in a district court of the United States or the Court of Federal Claims only if the partnership filing the petition deposits with the Secretary")
pub rule S6234b1DepositRequiredForDistrictOrClaimsCourt defeasible {
    label en official "a petition in a district court or the Court of Federal Claims may be filed only if the partnership deposits the required amount";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    for filedOn: Date;
    when readjustment_petition_filed(pship, reviewedYear, pr, filedOn)
        and petition_in_district_or_claims_court(pr);
    then power S6234b1DistrictOrClaimsCourtPetitionPower {
        holder pship;
        over pship;
        exercise readjustment_petition_filed(pship, reviewedYear, pr, filedOn);
        valid_when deposit_condition_met(pship, reviewedYear, pr);
        effect create(district_or_claims_court_petition_admissible(pship, reviewedYear, pr));
    };
}
pub relation deposit_not_payment_of_tax(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en official "any amount deposited under paragraph (1), while deposited, shall not be treated as a payment of tax for purposes of this title (other than chapter 67)";
}
@source(IRC_S6234_B, relation = formalizes, coverage = exact, quote = "shall not be treated as a payment of tax for purposes of this title (other than chapter 67)")
rule S6234b2DepositIsNotPaymentOfTax defeasible {
    label en official "a deposit is not a payment of tax (except for chapter 67)";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for amount: Money;
    for depositedOn: Date;
    when deposit_made(pship, reviewedYear, amount, depositedOn);
    then deposit_not_payment_of_tax(pship, reviewedYear);
}
pub relation court_has_bba_jurisdiction(court: Organ, pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en official "the court has jurisdiction to determine all partnership-related items for the taxable year to which the notice relates, their allocation among the partners, and the applicability of any penalty, addition to tax, or additional amount";
}
@source(IRC_S6234_C, relation = formalizes, coverage = exact, quote = "shall have jurisdiction to determine all partnership-related items for the partnership taxable year to which the notice of final partnership adjustment relates")
rule S6234cJurisdictionOverPartnershipRelatedItems defeasible {
    label en official "a court with which a timely petition is filed has jurisdiction over all partnership-related items of the year";
    for court: Organ;
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    when readjustment_petition_filed_timely(pship, reviewedYear, pr)
        and us.irc.core::proceeding_court(pr, court);
    then court_has_bba_jurisdiction(court, pship, reviewedYear);
}
pub relation bba_court_determination_date(pr: Proceeding, determinedOn: Date) kind institutional {
    label en official "the date of any such determination is the date of the court's order entering the decision";
}
@source(IRC_S6234_D, relation = formalizes, coverage = exact, quote = "The date of any such determination shall be treated as being the date of the court's order entering the decision.")
rule S6234dDeterminationDateIsOrderDate defeasible {
    label en official "the date of a determination is the date of the order entering the decision";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    for decidedOn: Date;
    when readjustment_petition_filed_timely(pship, reviewedYear, pr)
        and us.irc.core::proceeding_decided_on(pr, decidedOn);
    then bba_court_determination_date(pr, decidedOn);
}
pub relation readjustment_action_dismissed(pship: Partnership, reviewedYear: TaxableYear, pr: Proceeding) kind empirical {
    label en official "an action brought under this section is dismissed";
}
pub relation dismissal_by_rescission(pship: Partnership, reviewedYear: TaxableYear, pr: Proceeding) kind empirical {
    label en official "the dismissal is by reason of a rescission under section 6231";
}
pub relation exists_dismissal_by_rescission(pship: Partnership, reviewedYear: TaxableYear, pr: Proceeding) kind institutional {
    label en unofficial "existential wrapper over `dismissal_by_rescission` for not_known";
}
rule S6234eExistsDismissalByRescission strict {
    label en unofficial "the dismissal is recorded as one by reason of rescission";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    when dismissal_by_rescission(pship, reviewedYear, pr);
    then exists_dismissal_by_rescission(pship, reviewedYear, pr);
}
pub relation fpa_considered_correct(pship: Partnership, reviewedYear: TaxableYear) kind institutional {
    label en official "the decision dismissing the action is considered a decision that the notice of final partnership adjustment is correct";
}
@source(IRC_S6234_E, relation = formalizes, coverage = exact, quote = "the decision of the court dismissing the action shall be considered as its decision that the notice of final partnership adjustment is correct")
rule S6234eDismissalIsDecisionThatFpaIsCorrect defeasible {
    label en official "a dismissal (other than by rescission) is considered a decision that the FPA is correct";
    for pship: Partnership;
    for reviewedYear: TaxableYear;
    for pr: Proceeding;
    when readjustment_action_dismissed(pship, reviewedYear, pr)
        and not_known(exists_dismissal_by_rescission(pship, reviewedYear, pr));
    then fpa_considered_correct(pship, reviewedYear);
}
