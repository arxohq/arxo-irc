// §6201 (assessment authority), §6203 (method of assessment), §6204
// (supplemental assessments).
//
// METHOD NOTE: PLAN §6.2 distinguishes the assessment EVENT from the notice
// and the deficiency amount. This module gives the assessment event itself
// (the power to assess and its recording) over `us.irc.core::Assessment`/
// `assessment_of`; §6212-6215's notice/deficiency/restriction layer is
// `02-deficiency-and-notice.law` and `03-restrictions-and-tax-court.law`.
// The central `power` declared here (`S6201AssessTaxPower`) is the ONE
// assessment act every later restriction (§6213(a) petition window, §6501
// limitations, §6503 suspension) blocks via `immunity`/`priority` — never a
// second, parallel assess-power per restricting section.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - (a) chapeau ("authorized and required ... to make ... assessments") is
//    modeled as the Secretary's general POWER to assess any tax not duly
//    paid; (a)(1) ("shall assess") narrows that same power into a mandatory
//    DUTY when a return or list determines the tax — the two coexist
//    (E-0239 idiom: an unconditional power plus a duty to exercise it in the
//    self-reported case), rather than one relation trying to carry both an
//    authorization and a mandate.
//  - (a)(2) (stamp-tax omissions, dishonored stamp payment) and (a)(4)
//    (restitution orders under 18 U.S.C. §3556) are narrower instances of
//    the same assessment mechanism; modeled lightly (own duty/power/
//    immunity/prohibition each) since the task's "incl." list names only
//    (a)(1) and (a)(3) as the sections to model in depth — (a)(2) and (a)(4)
//    get one rule each, not a full sub-family.
//  - (a)(3) (erroneous income tax prepayment credit) is modeled as its own
//    power, distinct from the general mathematical-or-clerical-error
//    assessment of §6213(b)(1): the text itself says the §6213(b)(2)
//    abatement right does NOT apply to a (a)(3) assessment, so folding the
//    two into one relation would let a (a)(3) case fact accidentally pick up
//    the (b)(2) abatement rule from `03-restrictions-and-tax-court.law`.
//  - (b)(1)-(2) are prohibitions ADDRESSED TO THE SECRETARY (assessing
//    unpaid estimated tax/FUTA amounts is barred outright — a different
//    mechanism from the deficiency-notice restriction of §6213(a)), per
//    `rights-positions.md`'s "prohibition addressed to authorities" row.
//  - (c) (child's tax deemed also assessed against the parent under §73(a))
//    is a `classification`/deeming rule, not a duty or power of its own.
//  - (d) (burden of production on a third-party information-return dispute)
//    is the institutional_effect the task calls out; "reasonable dispute"
//    is a DECISION-0194 evaluative element channeled as an
//    `external judgment relation` (authority: the court hearing the
//    proceeding — modeled as the Tax Court for this stage, an
//    INTERPRETATION flagged in the report since the text says "any court
//    proceeding").
//  - §6203's "in accordance with rules or regulations prescribed by the
//    Secretary" is not itself modeled (the manner of recording is a
//    regulatory detail, not a testable condition); the RIGHT to a copy on
//    request is modeled as a duty of the Secretary triggered by the
//    taxpayer's request, per the task's framing.
//  - §6204(b) is a pure cross-reference to §6213 — NON_NORMATIVE here (see
//    `03-restrictions-and-tax-court.law` for the actual restriction).

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    Assessment,
    IRC_S6201_A,
    IRC_S6201_B,
    IRC_S6201_C,
    IRC_S6201_D,
    IRC_S6203,
    IRC_S6204_A,
    Individual,
    Person,
    Return,
    Secretary,
    TaxKind,
    TaxableYear,
};

// ============================================================================
// §6201(a) — Authority of Secretary (general power to assess)
// ============================================================================

pub relation tax_not_duly_paid(p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "taxes ... which have not been duly paid by stamp at the time and in the manner provided by law";
}
pub relation secretary_makes_assessment(a: Assessment, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en unofficial "the Secretary's act of recording the assessment (§6203) that exercises the §6201(a) authority";
}

@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "The Secretary is authorized and required to make the inquiries, determinations, and assessments of all taxes (including interest, additional amounts, additions to the tax, and assessable penalties) imposed by this title, or accruing under any former internal revenue law, which have not been duly paid by stamp at the time and in the manner provided by law.")
pub rule S6201AssessTax strict {
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when tax_not_duly_paid(p, y, k) and secretary_makes_assessment(a, p, y, k, amount);
    then power S6201AssessTaxPower {
        holder Secretary;
        over p;
        exercise secretary_makes_assessment(a, p, y, k, amount);
        valid_when tax_not_duly_paid(p, y, k);
        effect create(us.irc.core::assessment_of(a, p, y, k, amount));
    };
}

// --- (a)(1) — Taxes shown on return: the power above becomes a mandatory
//     duty when the tax was self-determined (or Secretary-determined) on a
//     filed return or list. --------------------------------------------

pub relation tax_determined_on_return(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "taxes determined by the taxpayer or by the Secretary as to which returns or lists ... are made under this title";
}
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "The Secretary shall assess all taxes determined by the taxpayer or by the Secretary as to which returns or lists (or payments under section 6225(c)(2)(B)(i)) are made under this title.")
pub rule S6201MandatoryAssessSelfReportedTax defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when tax_determined_on_return(p, y, k, amount);
    then duty S6201MandatoryAssessSelfReportedTaxDuty {
        bearer Secretary;
        beneficiary p;
        goal maintenance {
            condition exists_assessment_of(p, y, k, amount);
            window [-infinity, infinity];
        }
    };
}
pub relation exists_assessment_of(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en unofficial "some assessment of this person's tax of this kind and amount for the year has been recorded (§6203); positive existential over `us.irc.core::assessment_of`";
}
@source(IRC_S6203, relation = formalizes, coverage = contextual, quote = "The assessment shall be made by recording the liability of the taxpayer in the office of the Secretary")
rule S6201ExistsAssessmentOf strict {
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when us.irc.core::assessment_of(a, p, y, k, amount);
    then exists_assessment_of(p, y, k, amount);
}

// --- (a)(2) — Unpaid taxes payable by stamp -------------------------------
//
// TECH_GAP noted for both rules below: a stamp-tax assessment is not tied to
// a `TaxableYear` in the statute at all (the tax is due at the moment of the
// untaxed transaction or the dishonored payment), but
// `us.irc.core::assessment_of`/`return_of` require a `TaxableYear` argument.
// This stage asks the case to supply a `y: TaxableYear` fact rather than
// inventing a date-keyed core shape (a core-level change outside this
// package's authority) — reported as TECH_GAP, not silently modeled as if
// year-keying were correct for a stamp tax.

relation article_sold_without_proper_stamp(article: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an article on which a stamp tax is required was sold, removed, or a transaction/act requiring a stamp occurred, without the proper stamp, for the estimated amount (§6201(a)(2)(A) — `article` is typed `Person` for lack of a sharper `Property`/`Transaction` shape this stage introduces)";
}
@source(IRC_S6201_A, relation = formalizes, coverage = partial, quote = "it shall be the duty of the Secretary, upon such information as he can obtain, to estimate the amount of tax which has been omitted to be paid and to make assessment therefor upon the person or persons the Secretary determines to be liable for such tax.")
rule S6201EstimateAndAssessOmittedStampTax defeasible {
    for article: Person;
    for y: TaxableYear;
    for amount: Money;
    when article_sold_without_proper_stamp(article, y, amount);
    then duty S6201EstimateOmittedStampTaxDuty {
        bearer Secretary;
        goal achievement {
            condition exists_assessment_of(article, y, us.irc.core::RetailExciseCh31, amount);
            window [-infinity, infinity];
        }
    };
}

relation check_or_money_order_not_duly_paid(p: Person, y: TaxableYear, amount: Money, receivedOn: Date) kind empirical;
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "In any case in which a check or money order received under authority of section 6311 as payment for stamps is not duly paid, the unpaid amount may be immediately assessed as if it were a tax imposed by this title, due at the time of such receipt, from the person who tendered such check or money order.")
rule S6201ImmediateAssessDishonoredStampPayment strict {
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for receivedOn: Date;
    when check_or_money_order_not_duly_paid(p, y, amount, receivedOn) and secretary_makes_assessment(a, p, y, us.irc.core::RetailExciseCh31, amount);
    then power S6201ImmediateAssessDishonoredStampPaymentPower {
        holder Secretary;
        over p;
        exercise secretary_makes_assessment(a, p, y, us.irc.core::RetailExciseCh31, amount);
        valid_when check_or_money_order_not_duly_paid(p, y, amount, receivedOn);
        effect create(us.irc.core::assessment_of(a, p, y, us.irc.core::RetailExciseCh31, amount));
    };
}

// --- (a)(3) — Erroneous income tax prepayment credits ---------------------

pub relation overstated_prepayment_credit(r: Return, amount: Money) kind empirical {
    label en official "an overstatement of the credit for income tax withheld at the source, or of the amount paid as estimated income tax";
}
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "If on any return or claim for refund of income taxes under subtitle A there is an overstatement of the credit for income tax withheld at the source, or of the amount paid as estimated income tax, the amount so overstated which is allowed against the tax shown on the return or which is allowed as a credit or refund may be assessed by the Secretary in the same manner as in the case of a mathematical or clerical error appearing upon the return, except that the provisions of section 6213(b)(2) (relating to abatement of mathematical or clerical error assessments) shall not apply with regard to any assessment under this paragraph.")
pub rule S6201AssessErroneousPrepaymentCredit strict {
    for a: Assessment;
    for r: Return;
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when overstated_prepayment_credit(r, amount)
        and us.irc.core::return_of(r, p, y, us.irc.core::IncomeCh1)
        and secretary_makes_assessment(a, p, y, us.irc.core::IncomeCh1, amount);
    then power S6201AssessErroneousPrepaymentCreditPower {
        holder Secretary;
        over p;
        exercise secretary_makes_assessment(a, p, y, us.irc.core::IncomeCh1, amount);
        valid_when overstated_prepayment_credit(r, amount);
        effect create(us.irc.core::assessment_of(a, p, y, us.irc.core::IncomeCh1, amount));
    };
}
// The last clause ("except that ... section 6213(b)(2) ... shall not apply")
// is modeled negatively in `03-restrictions-and-tax-court.law`: the §6213(b)
// abatement-request power's `valid_when` excludes an assessment made under
// `S6201AssessErroneousPrepaymentCreditPower`.

// --- (a)(4) — Restitution under 18 U.S.C. §3556 ---------------------------

relation restitution_ordered(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en unofficial "a restitution order under 18 U.S.C. §3556 for failure to pay a tax imposed by this title";
}
relation all_appeals_of_restitution_order_concluded(p: Person, y: TaxableYear, k: TaxKind) kind empirical;
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "The Secretary shall assess and collect the amount of restitution under an order pursuant to section 3556 of title 18, United States Code, for failure to pay any tax imposed under this title in the same manner as if such amount were such tax.")
pub rule S6201AssessRestitution defeasible {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when restitution_ordered(p, y, k, amount) and all_appeals_of_restitution_order_concluded(p, y, k);
    then duty S6201AssessAndCollectRestitutionDuty {
        bearer Secretary;
        goal achievement {
            condition exists_assessment_of(p, y, k, amount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "An assessment of an amount of restitution under an order described in subparagraph (A) shall not be made before all appeals of such order are concluded and the right to make all such appeals has expired.")
rule S6201RestitutionAssessmentBlockedPendingAppeals strict {
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when restitution_ordered(p, y, k, amount)
        and not_known(all_appeals_of_restitution_order_concluded(p, y, k))
        and secretary_makes_assessment(a, p, y, k, amount);
    then immunity S6201RestitutionAssessmentBlockedPendingAppealsImmunity {
        holder p;
        protected_effect us.irc.core::assessment_of(a, p, y, k, amount);
        window [-infinity, infinity];
    };
}
priority RestitutionAppealsImmunityOutranksAssessPower {
    prefer S6201RestitutionAssessmentBlockedPendingAppeals over S6201AssessTax;
    reason lex_specialis;
}

pub relation challenges_restitution_underlying_liability(p: Person, order: Person) kind empirical {
    label en unofficial "the person against whom restitution was assessed challenges the amount on the basis of the existence or amount of the underlying tax liability, in a proceeding authorized under this title (`order` typed `Person` for lack of a sharper `RestitutionOrder` shape this stage introduces)";
}
@source(IRC_S6201_A, relation = formalizes, coverage = exact, quote = "The amount of such restitution may not be challenged by the person against whom assessed on the basis of the existence or amount of the underlying tax liability in any proceeding authorized under this title (including in any suit or proceeding in court permitted under section 7422).")
pub rule S6201NoChallengeToRestitutionUnderlyingLiability strict {
    for p: Person;
    for order: Person;
    when person_subject_to_restitution_order(p, order);
    then prohibition S6201NoChallengeToRestitutionUnderlyingLiabilityProhibition {
        bearer p;
        action challenges_restitution_underlying_liability(p, order);
        window [-infinity, infinity];
    };
}
relation person_subject_to_restitution_order(p: Person, order: Person) kind empirical;

// ============================================================================
// §6201(b) — Prohibitions: no assessment of certain unpaid estimated amounts
// ============================================================================

pub relation assesses_estimated_income_tax_underpayment(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the Secretary assesses an unpaid amount of estimated income tax required to be paid under §6654 or §6655";
}
@source(IRC_S6201_B, relation = formalizes, coverage = exact, quote = "No unpaid amount of estimated income tax required to be paid under section 6654 or 6655 shall be assessed.")
rule S6201NoAssessmentOfEstimatedIncomeTaxUnderpayment strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when assesses_estimated_income_tax_underpayment(p, y, amount);
    then prohibition S6201NoAssessmentOfEstimatedIncomeTaxUnderpaymentProhibition {
        bearer Secretary;
        action assesses_estimated_income_tax_underpayment(p, y, amount);
        window [-infinity, infinity];
    };
}
relation person(p: Person) kind empirical {
    label en unofficial "positive anchor (§190): the person is a party to the case";
}

pub relation assesses_futa_underpayment(p: Person, quarter: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the Secretary assesses an unpaid amount of Federal unemployment tax for a calendar quarter or other period of a calendar year, computed as provided in section 6157";
}
@source(IRC_S6201_B, relation = formalizes, coverage = exact, quote = "No unpaid amount of Federal unemployment tax for any calendar quarter or other period of a calendar year, computed as provided in section 6157, shall be assessed.")
rule S6201NoAssessmentOfFutaUnderpayment strict {
    for p: Person;
    for quarter: TaxableYear;
    for amount: Money;
    when assesses_futa_underpayment(p, quarter, amount);
    then prohibition S6201NoAssessmentOfFutaUnderpaymentProhibition {
        bearer Secretary;
        action assesses_futa_underpayment(p, quarter, amount);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6201(c) — Child's tax deemed also assessed against the parent
// ============================================================================

pub relation includible_solely_by_reason_of_section_73a(child: Individual, parent: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en official "amounts includible in the gross income of the child, and not of the parent, solely by reason of section 73(a)";
}
pub relation child_did_not_pay(child: Individual, y: TaxableYear, amount: Money) kind empirical;
pub relation deemed_properly_assessed_against_parent(parent: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "shall, if not paid by the child, for all purposes be considered as having also been properly assessed against the parent";
}
@source(IRC_S6201_C, relation = formalizes, coverage = exact, quote = "Any income tax under chapter 1 assessed against a child, to the extent attributable to amounts includible in the gross income of the child, and not of the parent, solely by reason of section 73(a), shall, if not paid by the child, for all purposes be considered as having also been properly assessed against the parent.")
pub rule S6201ChildTaxDeemedAssessedAgainstParent strict {
    for a: Assessment;
    for child: Individual;
    for parent: Individual;
    for y: TaxableYear;
    for amount: Money;
    when us.irc.core::assessment_of(a, child, y, us.irc.core::IncomeCh1, amount)
        and includible_solely_by_reason_of_section_73a(child, parent, y, amount)
        and child_did_not_pay(child, y, amount);
    then deemed_properly_assessed_against_parent(parent, y, amount);
}

// ============================================================================
// §6201(d) — Burden of production on a third-party information-return
// dispute (institutional_effect)
// ============================================================================

external judgment relation reasonable_dispute_asserted(p: Person, item: Person) {
    authority TaxCourt;
    label en official "a taxpayer asserts a reasonable dispute with respect to any item of income reported on an information return filed with the Secretary by a third party";
}
pub relation taxpayer_fully_cooperated(p: Person, item: Person) kind empirical {
    label en official "the taxpayer has fully cooperated with the Secretary (including providing, within a reasonable period of time, access to and inspection of all witnesses, information, and documents within the control of the taxpayer as reasonably requested by the Secretary)";
}
pub relation secretary_bears_burden_of_production(p: Person, item: Person) kind institutional {
    label en official "the Secretary shall have the burden of producing reasonable and probative information concerning such deficiency in addition to such information return";
}
@source(IRC_S6201_D, relation = formalizes, coverage = exact, quote = "In any court proceeding, if a taxpayer asserts a reasonable dispute with respect to any item of income reported on an information return filed with the Secretary under subpart B or C of part III of subchapter A of chapter 61 by a third party and the taxpayer has fully cooperated with the Secretary (including providing, within a reasonable period of time, access to and inspection of all witnesses, information, and documents within the control of the taxpayer as reasonably requested by the Secretary), the Secretary shall have the burden of producing reasonable and probative information concerning such deficiency in addition to such information return.")
pub rule S6201SecretaryBearsBurdenOfProduction strict {
    for p: Person;
    for item: Person;
    when reasonable_dispute_asserted(p, item) and taxpayer_fully_cooperated(p, item);
    then secretary_bears_burden_of_production(p, item);
}

// (e) is a pure cross-reference to subchapter B (§§6211-6216) — NON_NORMATIVE
// here (the actual rules are `02-deficiency-and-notice.law` and
// `03-restrictions-and-tax-court.law`).

// ============================================================================
// §6203 — Method of assessment
// ============================================================================

@source(IRC_S6203, relation = formalizes, coverage = exact, quote = "The assessment shall be made by recording the liability of the taxpayer in the office of the Secretary in accordance with rules or regulations prescribed by the Secretary.")
rule S6203AssessmentIsTheRecordingEvent strict {
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when us.irc.core::assessment_of(a, p, y, k, amount);
    then exists_assessment_of(p, y, k, amount);
}

pub relation requests_copy_of_assessment_record(p: Person, a: Assessment) kind empirical {
    label en unofficial "positive anchor (§190): the taxpayer's request under §6203, second sentence";
}
pub relation furnishes_copy_of_assessment_record(p: Person, a: Assessment) kind empirical;
@source(IRC_S6203, relation = formalizes, coverage = exact, quote = "Upon request of the taxpayer, the Secretary shall furnish the taxpayer a copy of the record of the assessment.")
pub rule S6203FurnishCopyOfAssessmentRecord defeasible {
    for p: Person;
    for a: Assessment;
    when requests_copy_of_assessment_record(p, a);
    then duty S6203FurnishCopyOfAssessmentRecordDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition furnishes_copy_of_assessment_record(p, a);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// §6204 — Supplemental assessments
// ============================================================================

pub relation assessment_imperfect_or_incomplete(a: Assessment) kind empirical {
    label en official "any assessment is imperfect or incomplete in any material respect";
}
pub relation within_assessment_period(p: Person, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en unofficial "the date is within the period prescribed for assessment of this liability (bridged from `04-limitations.law`/`05-suspension.law`'s `assessment_period_ends`, not recomputed here)";
}
@source(IRC_S6204_A, relation = formalizes, coverage = exact, quote = "The Secretary may, at any time within the period prescribed for assessment, make a supplemental assessment whenever it is ascertained that any assessment is imperfect or incomplete in any material respect.")
pub rule S6204SupplementalAssessment strict {
    for a: Assessment;
    for supplement: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for d: Date;
    when us.irc.core::assessment_of(a, p, y, k, amount)
        and assessment_imperfect_or_incomplete(a)
        and secretary_makes_assessment(supplement, p, y, k, amount)
        and us.irc.core::assessed_on(supplement, d)
        and within_assessment_period(p, y, k, d);
    then power S6204SupplementalAssessmentPower {
        holder Secretary;
        over p;
        exercise secretary_makes_assessment(supplement, p, y, k, amount);
        valid_when within_assessment_period(p, y, k, d);
        effect create(us.irc.core::assessment_of(supplement, p, y, k, amount));
    };
}
// (b) is a pure cross-reference to §6213 — NON_NORMATIVE here.
