// Assessment -- stage 4b (26.09.2026, DECISION-0379, implemented_unverified): rows of sections 6225(c)(2)(D), (F),
// 6226(b)(2), (b)(4)(D) and 6232(f)(5) that stage 4 left as TECH_GAP and that admit a bounded statement.
//
// METHOD AND JUDGMENT CALLS.
//  - Tiered chains are unrolled to at most THREE links (the relevant partner, one or two intermediate partnerships or S
//    corporations, the audited partnership); the condition on every partnership of the chain is a conjunction of the
//    per-link `partner_requirements_satisfied` of module 19 (no count over a derived predicate). A longer chain is not
//    derived (TECH-GAPS G6894).
//  - An S corporation is treated as a partnership by an explicit alias: the case declares the Partnership entity that
//    stands for the S corporation; shareholders are its partners. This is the explicit incorporation of "treated in the
//    same manner as a partnership and its partners".
//  - Section 6226(b)(2): the two counterfactual tax amounts of each year (with and without the partner's share of the
//    adjustments) are computed by the chapter 1 owners (EXTERNAL_DEPENDENCY); the correction amount is their difference and
//    the year is classified as (A) or (B) by comparison of dates. The attribute adjustment of paragraph (3) is the same
//    external recomputation.
//  - Section 6225(c)(2)(D): the disapplication is a legal state keyed by the return or payment (an item), which the
//    limitation modules of this package (keyed by person, year and kind) do not read; consumers consult the new relation.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    Corporation,
    IRC_S6225_C,
    IRC_S6226_B,
    IRC_S6232_F,
    Partnership,
    Person,
    PushoutCorrection,
    TaxableYear,
    excluded_partner_portion,
    partner_adjustment_portion_taken_into_account,
    partner_is_partnership_or_s_corporation,
    partner_requirements_satisfied,
};

// ============================================================================
// section 6225(c)(2)(D): sections 6501 and 6511 do not apply to the modification return or payment
// ============================================================================

pub relation adjustments_are_attribute_adjustments_6225c2Aii(pship: Partnership, y: TaxableYear, partner: Person) kind empirical {
    label en official "section 6225(c)(2)(D): the adjustments are those referred to in subparagraph (A)(ii) (the effect of the adjustments on tax attributes)";
}
pub relation return_filed_for_6225c2Ai(item: Text, pship: Partnership, y: TaxableYear, partner: Person) kind empirical {
    label en official "section 6225(c)(2)(D): the item is a return filed for purposes of subparagraph (A)(i)";
}
pub relation amount_paid_under_6225c2Aiii_or_Bi(item: Text, pship: Partnership, y: TaxableYear, partner: Person) kind empirical {
    label en official "section 6225(c)(2)(D): the item is an amount paid under subparagraph (A)(iii) or (B)(i)";
}
pub relation sections_6501_6511_do_not_apply_to_item_6225c2D(item: Text) kind institutional {
    label en official "section 6225(c)(2)(D): sections 6501 and 6511 do not apply to the item (the assessment and refund limitation periods are disapplied for this return or payment)";
}
@source(IRC_S6225_C, quote = "In the case of adjustments referred to in subparagraph (A)(ii), sections 6501 and 6511 shall not apply with respect to any return filed for purposes of subparagraph (A)(i) or any amount paid under subparagraph (A)(iii) or (B)(i).")
rule LimitationsDisappliedForModificationReturn6225c2D(item: Text, pship: Partnership, y: TaxableYear, partner: Person) defeasible {
    label en official "section 6225(c)(2)(D): a return filed for (A)(i) when the adjustments are attribute adjustments";
    when adjustments_are_attribute_adjustments_6225c2Aii(pship, y, partner);
    when return_filed_for_6225c2Ai(item, pship, y, partner);
    then sections_6501_6511_do_not_apply_to_item_6225c2D(item);
}
@source(IRC_S6225_C, quote = "In the case of adjustments referred to in subparagraph (A)(ii), sections 6501 and 6511 shall not apply with respect to any return filed for purposes of subparagraph (A)(i) or any amount paid under subparagraph (A)(iii) or (B)(i).")
rule LimitationsDisappliedForModificationPayment6225c2D(item: Text, pship: Partnership, y: TaxableYear, partner: Person) defeasible {
    label en official "section 6225(c)(2)(D): an amount paid under (A)(iii) or (B)(i) when the adjustments are attribute adjustments";
    when adjustments_are_attribute_adjustments_6225c2Aii(pship, y, partner);
    when amount_paid_under_6225c2Aiii_or_Bi(item, pship, y, partner);
    then sections_6501_6511_do_not_apply_to_item_6225c2D(item);
}

// ============================================================================
// section 6225(c)(2)(F): tiered structures, at most three links
// ============================================================================

pub relation chain_link_6225c2F(rel: Person, audited: Partnership, i: Integer, link_pship: Partnership, link_partner: Person) kind empirical {
    label en official "section 6225(c)(2)(F)(i): the i-th link of the chain of ownership from the audited partnership (i = 1) down to the relevant partner: the partnership link_pship and its partner link_partner";
}
pub relation chain_information_furnished_6225c2Fi_I(rel: Person, audited: Partnership) kind empirical {
    label en official "section 6225(c)(2)(F)(i)(I): such information as the Secretary may require is furnished for purposes of the paragraph (including any information with respect to the chain of ownership of the relevant partner)";
}
pub relation relevant_partner_may_apply_6225c2AB_6225c2F(rel: Person, audited: Partnership, y: TaxableYear) kind institutional {
    label en official "section 6225(c)(2)(F)(i): subparagraph (A) or (B) may apply with respect to the relevant partner in the chain of ownership: the information is furnished and each partnership in the chain satisfies the requirements of (A) or (B)";
}
@source(IRC_S6225_C, quote = "(II) to such extent as the Secretary may require, each partnership in the chain of ownership between the relevant partner and the audited partnership satisfies the requirements of subparagraph (A) or (B).")
rule RelevantPartnerInTwoLinkChain6225c2F(rel: Person, audited: Partnership, y: TaxableYear, q1: Partnership) defeasible {
    label en official "section 6225(c)(2)(F)(i)(I)-(II): a chain of two links: the audited partnership with the intermediate partnership q1, and q1 with the relevant partner";
    when chain_link_6225c2F(rel, audited, 1, audited, q1);
    when chain_link_6225c2F(rel, audited, 2, q1, rel);
    when chain_information_furnished_6225c2Fi_I(rel, audited);
    when partner_requirements_satisfied(audited, y, q1);
    when partner_requirements_satisfied(q1, y, rel);
    then relevant_partner_may_apply_6225c2AB_6225c2F(rel, audited, y);
}
@source(IRC_S6225_C, quote = "(II) to such extent as the Secretary may require, each partnership in the chain of ownership between the relevant partner and the audited partnership satisfies the requirements of subparagraph (A) or (B).")
rule RelevantPartnerInThreeLinkChain6225c2F(rel: Person, audited: Partnership, y: TaxableYear, q1: Partnership, q2: Partnership) defeasible {
    label en official "section 6225(c)(2)(F)(i)(I)-(II): a chain of three links";
    when chain_link_6225c2F(rel, audited, 1, audited, q1);
    when chain_link_6225c2F(rel, audited, 2, q1, q2);
    when chain_link_6225c2F(rel, audited, 3, q2, rel);
    when chain_information_furnished_6225c2Fi_I(rel, audited);
    when partner_requirements_satisfied(audited, y, q1);
    when partner_requirements_satisfied(q1, y, q2);
    when partner_requirements_satisfied(q2, y, rel);
    then relevant_partner_may_apply_6225c2AB_6225c2F(rel, audited, y);
}
@source(IRC_S6225_C, quote = "In the case of any partnership any partner of which is a partnership, subparagraph (A) or (B) may apply with respect to any partner (hereafter in this subparagraph referred to as the \"relevant partner\") in the chain of ownership of such partnerships if—")
rule ExcludedPortionOfRelevantPartner6225c2F(rel: Person, audited: Partnership, y: TaxableYear, amount: Money) defeasible {
    label en official "section 6225(c)(2)(F)(i): the portion of the adjustments the relevant partner takes into account is left out of the imputed underpayment of the audited partnership";
    when relevant_partner_may_apply_6225c2AB_6225c2F(rel, audited, y);
    when partner_adjustment_portion_taken_into_account(audited, y, rel, amount);
    then excluded_partner_portion(audited, y, rel, amount);
}
pub relation s_corporation_treated_as_partnership_6225c2Fii(sc: Corporation, alias: Partnership) kind empirical {
    label en official "section 6225(c)(2)(F)(ii): the Partnership entity that stands for the S corporation in a chain of ownership";
}
pub relation s_corporation_shareholder_6225c2Fii(sc: Corporation, shareholder: Person) kind empirical {
    label en official "section 6225(c)(2)(F)(ii): the person is a shareholder of the S corporation";
}
pub relation shareholder_treated_as_partner_6225c2Fii(alias: Partnership, partner: Person) kind institutional {
    label en official "section 6225(c)(2)(F)(ii): for clause (i), an S corporation and its shareholders are treated in the same manner as a partnership and its partners";
}
@source(IRC_S6225_C, quote = "For purposes of clause (i), an S corporation and its shareholders shall be treated in the same manner as a partnership and its partners.")
rule ShareholderTreatedAsPartner6225c2Fii(sc: Corporation, alias: Partnership, shareholder: Person) defeasible {
    label en official "section 6225(c)(2)(F)(ii)";
    when s_corporation_treated_as_partnership_6225c2Fii(sc, alias);
    when s_corporation_shareholder_6225c2Fii(sc, shareholder);
    then shareholder_treated_as_partner_6225c2Fii(alias, shareholder);
}

// ============================================================================
// section 6226(b)(2): correction amounts as differences of two counterfactual tax amounts
// ============================================================================

pub relation partner_tax_with_share_of_adjustments_6226b2(c: PushoutCorrection, amount: Money) kind empirical {
    label en official "section 6226(b)(2)(A): the tax imposed under chapter 1 for the year if the partner's share of the adjustments were taken into account (EXTERNAL_DEPENDENCY: computed by the chapter 1 owners)";
}
pub relation partner_tax_without_share_of_adjustments_6226b2(c: PushoutCorrection, amount: Money) kind empirical {
    label en official "section 6226(b)(2)(A): the tax imposed under chapter 1 for the year as it stands (EXTERNAL_DEPENDENCY)";
}
pub relation correction_year_includes_end_of_reviewed_year_6226b2A(c: PushoutCorrection) kind empirical {
    label en official "section 6226(b)(2)(A): the year is the taxable year of the partner which includes the end of the reviewed year";
}
pub relation correction_year_after_A_and_before_statement_year_6226b2B(c: PushoutCorrection) kind empirical {
    label en official "section 6226(b)(2)(B): the year is after the year of subparagraph (A) and before the year of paragraph (1)";
}
pub relation correction_amount_6226b2A(c: PushoutCorrection, amount: Money) kind institutional {
    label en official "section 6226(b)(2)(A): the amount by which the tax would increase or decrease (with minus without; a negative amount is a decrease) for the year that includes the end of the reviewed year";
}
@source(IRC_S6226_B, quote = "(A) in the case of the taxable year of the partner which includes the end of the reviewed year, the amount by which the tax imposed under chapter 1 would increase or decrease if the partner's share of the adjustments described in subsection (a) were taken into account for such taxable year, and")
rule CorrectionAmount6226b2A(c: PushoutCorrection, withx: Money, withoutx: Money) defeasible {
    label en official "section 6226(b)(2)(A)";
    when correction_year_includes_end_of_reviewed_year_6226b2A(c);
    when partner_tax_with_share_of_adjustments_6226b2(c, withx);
    when partner_tax_without_share_of_adjustments_6226b2(c, withoutx);
    then correction_amount_6226b2A(c, withx - withoutx);
}
pub relation correction_amount_6226b2B(c: PushoutCorrection, amount: Money) kind institutional {
    label en official "section 6226(b)(2)(B): the amount by which the tax would increase or decrease by reason of the adjustment to tax attributes under paragraph (3) for a year between (A) and the statement year (the two tax amounts, with and without the attribute adjustment, are external)";
}
@source(IRC_S6226_B, quote = "(B) in the case of any taxable year after the taxable year referred to in subparagraph (A) and before the taxable year referred to in paragraph (1), the amount by which the tax imposed under chapter 1 would increase or decrease by reason of the adjustment to tax attributes under paragraph (3).")
rule CorrectionAmount6226b2B(c: PushoutCorrection, withx: Money, withoutx: Money) defeasible {
    label en official "section 6226(b)(2)(B)";
    when correction_year_after_A_and_before_statement_year_6226b2B(c);
    when partner_tax_with_share_of_adjustments_6226b2(c, withx);
    when partner_tax_without_share_of_adjustments_6226b2(c, withoutx);
    then correction_amount_6226b2B(c, withx - withoutx);
}

// ============================================================================
// section 6226(b)(4)(D): the audited partnership of a tiered partner
// ============================================================================

pub relation chain_member_6226b4D(partner: Person, i: Integer, member: Partnership) kind empirical {
    label en official "section 6226(b)(4)(D): the i-th partnership of the chain of ownership above the partner (i = 1 is the top)";
}
pub relation originally_elected_application_of_6226_6226b4D(member: Partnership) kind empirical {
    label en official "section 6226(b)(4)(D): the partnership originally elected the application of section 6226";
}
pub relation audited_partnership_6226b4D(partner: Person, audited: Partnership) kind institutional {
    label en official "section 6226(b)(4)(D): the audited partnership, for a partner described in subparagraph (A): the partnership in the chain of ownership originally electing the application of the section. Bounded: a chain of up to three partnerships";
}
@source(IRC_S6226_B, quote = "For purposes of this paragraph, the term \"audited partnership\" means, with respect to any partner described in subparagraph (A), the partnership in the chain of ownership originally electing the application of this section.")
rule AuditedPartnership6226b4D(partner: Person, i: Integer, member: Partnership) defeasible {
    label en official "section 6226(b)(4)(D): the chain member that originally elected, for a partner that is a partnership or an S corporation";
    when partner_is_partnership_or_s_corporation(partner);
    when chain_member_6226b4D(partner, i, member);
    when i >= 1;
    when i <= 3;
    when originally_elected_application_of_6226_6226b4D(member);
    then audited_partnership_6226b4D(partner, member);
}

// ============================================================================
// section 6232(f)(5): an S corporation and its shareholders as a partnership and its partners
// ============================================================================

pub relation s_corporation_treated_as_partnership_6232f5(sc: Corporation, alias: Partnership) kind empirical {
    label en official "section 6232(f)(5): the Partnership entity that stands for the S corporation for subsection (f)";
}
pub relation s_corporation_shareholder_6232f5(sc: Corporation, shareholder: Person) kind empirical {
    label en official "section 6232(f)(5): the person is a shareholder of the S corporation";
}
pub relation shareholder_treated_as_partner_6232f5(alias: Partnership, partner: Person) kind institutional {
    label en official "section 6232(f)(5): for subsection (f), an S corporation and its shareholders are treated in the same manner as a partnership and its partners (so the partnership rules of this package apply to the alias and its partners)";
}
@source(IRC_S6232_F, quote = "For purposes of this subsection, an S corporation and its shareholders shall be treated in the same manner as a partnership and its partners.")
rule ShareholderTreatedAsPartner6232f5(sc: Corporation, alias: Partnership, shareholder: Person) defeasible {
    label en official "section 6232(f)(5)";
    when s_corporation_treated_as_partnership_6232f5(sc, alias);
    when s_corporation_shareholder_6232f5(sc, shareholder);
    then shareholder_treated_as_partner_6232f5(alias, shareholder);
}
