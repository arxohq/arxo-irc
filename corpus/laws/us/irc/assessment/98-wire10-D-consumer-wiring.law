// Assessment -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The section 1 half of the highest rate of section 6225(b)(1)(B) is derived from the highest rate of section 1 that
// `us.irc.income_individual` states (taxable years beginning after 2017, which covers every reviewed year of the BBA regime).
// The case-fact channel stays valid; a case must not assert a different rate through both channels.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

import us.irc.income_individual version "0.1.1";
import us.irc.exempt_organizations version "0.1.1";

use self::{
    Person,
    TaxKind,
    TaxableYear,
    highest_section_1_rate_for_reviewed_year,
    private_foundation_termination_tax_507,
};

rule W10HighestSection1RateForReviewedYearFromIncomeIndividual strict {
    label en official "the highest rate of tax in effect for the reviewed year under section 1 is the highest rate the income-individual package states for the year";
    for y: us.irc.core::TaxableYear;
    for rate: Decimal;
    when us.irc.income_individual::highest_rate_under_section_1(y, rate);
    then highest_section_1_rate_for_reviewed_year(y, rate);
}

// --- section 507(c): the termination tax of a private foundation (owner: exempt_organizations) ---------------------------------

rule W10PrivateFoundationTerminationTaxFromExemptOrganizations strict {
    label en official "a tax imposed by section 507(c) on an organization referred to in section 507(a) is a tax on termination of private foundation status (chapter 1 tax)";
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when us.irc.exempt_organizations::section_507c_tax_imposed(p, y);
    then private_foundation_termination_tax_507(p, y, us.irc.core::IncomeCh1);
}
