// 26 U.S.C. §6215 — statutory note 5 (savingsprovision-note)
fragment IRC_S6215_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/6215/note/5";
    text en official """Savings Provision
For provisions that nothing in amendment by Pub. L. 115–141 be construed to affect treatment of certain transactions occurring, property acquired, or items of income, loss, deduction, or credit taken into account prior to Mar. 23, 2018, for purposes of determining liability for tax for periods ending after Mar. 23, 2018, see section 401(e) of Pub. L. 115–141, set out as a note under section 23 of this title.""";
    content_hash "sha256:36519b40b22c7a3ff692be94a8aecdf5abb5b2cd290e4c80dd5254a615052cf6";
}

// 26 U.S.C. §6216 — Cross references
fragment IRC_S6216 in IRC_2024_EDITION {
    kind section;
    locator "section/6216";
    text en official """Cross references
(1) For procedures relating to receivership proceedings, see subchapter B of chapter 70.
(2) For procedures relating to jeopardy assessments, see subchapter A of chapter 70.
(3) For procedures relating to claims against transferees and fiduciaries, see chapter 71.
(4) For procedures relating to partnership items, see subchapter C.""";
    content_hash "sha256:70d1e3fa1411e580439bafdd8b955c13f9eeba760068f1375cdf90353042b9ee";
