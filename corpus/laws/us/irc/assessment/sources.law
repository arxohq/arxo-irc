// 26 U.S.C. §6202 — Establishment by regulations of mode or time of assessment
fragment IRC_S6202 in IRC_2024_EDITION {
    kind section;
    locator "section/6202";
    text en official """Establishment by regulations of mode or time of assessment
If the mode or time for the assessment of any internal revenue tax (including interest, additional amounts, additions to the tax, and assessable penalties) is not otherwise provided for, the Secretary may establish the same by regulations.""";
    content_hash "sha256:be5ebbb34f6f1f663894671133f983fbbccc94d28b7bc129636eb39ba16f2e47";
}

// 26 U.S.C. §6203 — Method of assessment
fragment IRC_S6203 in IRC_2024_EDITION {
    kind section;
    locator "section/6203";
    text en official """Method of assessment
The assessment shall be made by recording the liability of the taxpayer in the office of the Secretary in accordance with rules or regulations prescribed by the Secretary. Upon request of the taxpayer, the Secretary shall furnish the taxpayer a copy of the record of the assessment.""";
    content_hash "sha256:f1e62180ab156acbaf39626a528a8e6213c85f1280ffeb219d306767929f9d0f";
}

