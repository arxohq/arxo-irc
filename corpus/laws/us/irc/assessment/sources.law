// 26 U.S.C. 6511(f) — Limitations on credit or refund
fragment IRC_S6511_F in IRC_2024_EDITION {
    kind subsection;
    locator "section/6511/f";
    text en official """(f) Special rule for chapter 42 and similar taxes
For purposes of any tax imposed by section 4912, chapter 42, or section 4975, the return referred to in subsection (a) shall be the return specified in section 6501(l)(1).""";
    content_hash "sha256:d88c60c1140f14b267f678d99db3817c13ac12ce10147edbb7c923859a74f284";
}

