// §6211 (definition of a deficiency), §6212 (notice of deficiency).
//
// METHOD NOTE: PLAN §6.2 — the assessment event (§6201/§6203), the notice
// (this module) and the deficiency amount (this module) are three distinct
// legal facts. `deficiency_amount` is computed here with exact Decimal
// arithmetic over `Money`; §6212's notice validity turns on the MAILING
// date (never the document date or the received date), per the task's
// framing.
//
// JUDGMENT CALLS AND GAPS (see report):
//  - §6211(a)'s "tax imposed by subtitle A or B" (the substantively correct
//    liability) and "the amount shown as the tax by the taxpayer" are read
//    as typed institutional dependency facts this package does not compute
//    (the correct-liability computation belongs to the substantive tax
//    packages, e.g. `income-individual`, `estate-gift`). "Amounts
//    previously assessed (or collected without assessment)" is likewise a
//    case-supplied SUM, not derived by an aggregate over every
//    `Assessment` — the language's runtime does not support a dynamic sum
//    over derived facts (§111); a case that needs a real sum computes it
//    outside the engine and asserts the total, same runtime-subset
//    limitation `calc-primitives-must-be-defeasible-under-legal-owners`-style
//    packages already document.
//  - (b)(4)'s "negative amounts of tax" are modeled as two adjustment
//    relations subtracted from `tax_imposed`/`amount_shown_as_tax_by_
//    taxpayer` respectively inside the deficiency formula, matching the
//    text's own instruction ("shall be taken into account as negative
//    amounts of tax") rather than as a separate additive term.
//  - (b)(1) ("determined without regard to ... estimated tax ... credit
//    under section 31 ... credit under section 33 ... termination
//    assessment credits") and (b)(3) (§6014 computation deemed the
//    taxpayer's own) are NOT separately modeled: they constrain HOW the
//    upstream `tax_imposed`/`amount_shown_as_tax_by_taxpayer` facts must
//    already have been computed by their producer packages, not a further
//    transformation this package's formula performs. Flagged as
//    INTERPRETATION — a producer package that gets this wrong will not be
//    caught by this package's own checks.
//  - (c) (BBA partnership-adjustment carve-out, "adjustments to
//    partnership-related items shall be made only as provided in
//    subchapter C") is a scope-limiting cross-reference to chapter 63
//    subchapter C (the `partnership-audit`/BBA package, not yet
//    formalized) — modeled as an `unless` defeater on the deficiency
//    formula itself, naming the pending fact rather than silently ignoring
//    the carve-out.
//  - §6212(a)'s "authorized to send notice ... by certified mail or
//    registered mail" is modeled as the Secretary's POWER (per the task);
//    the taxpayer-advocate-contact-information sentence is a duty
//    (content requirement of the notice), not a separate power.
//  - §6212(b)(1)/(3) ("last known address ... sufficient ... even if such
//    taxpayer is deceased, or is under a legal disability") is modeled as
//    `notice_of_deficiency_valid`'s sufficiency test; §6212(b)(2)'s joint-
//    notice rule is modeled as an alternative way validity is satisfied for
//    two spouses, not a duplicate deficiency.
//  - §6212(c) ("no right to determine any additional deficiency ... except
//    in the case of fraud, and except as provided in section 6214(a) ...")
//    is modeled as an immunity of the taxpayer against a SECOND notice of
//    deficiency for the same taxable year, `unless` the named exceptions —
//    `fraud` is channeled as an `external judgment relation` (DECISION-0194;
//    authority Tax Court).
//  - §6212(d) (rescission with consent) is modeled as a power of the
//    Secretary with `valid_when` the taxpayer's consent; its effect is to
//    make the notice NOT COUNT as a notice of deficiency for §6212(c),
//    §6213(a) and §6512(a) — modeled here as retracting
//    `notice_of_deficiency_valid` (§6512(a) itself is `payment-refunds-
//    interest`'s own norm and out of scope; the suspension carve-out in the
//    rescission sentence is read by `05-suspension.law`).

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6211_A,
    IRC_S6211_B,
    IRC_S6212_A,
    IRC_S6212_B,
    IRC_S6212_C,
    IRC_S6212_D,
    Individual,
    Notice,
    Person,
    Proceeding,
    Secretary,
    TaxKind,
    TaxableYear,
    fiduciary_relationship_noticed,
};

// ============================================================================
// §6211 — Definition of a deficiency
// ============================================================================

pub relation tax_imposed(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en unofficial "the correct amount of tax imposed by subtitle A or B, or chapter 41, 42, 43, or 44, for the year (pending: substantive tax packages — `income-individual`, `estate-gift`, `excise` families — not this package's norm; already computed per (b)(1)'s exclusions)";
}
pub relation amount_shown_as_tax_by_taxpayer(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en official "the amount shown as the tax by the taxpayer upon his return, if a return was made by the taxpayer and an amount was shown as the tax by the taxpayer thereon";
}
pub relation return_was_made(p: Person, y: TaxableYear, k: TaxKind) kind empirical;
pub relation amounts_previously_assessed(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "the amounts previously assessed (or collected without assessment) as a deficiency";
}
pub relation rebates_made(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "so much of an abatement, credit, refund, or other repayment, as was made on the ground that the tax imposed ... was less than the excess of the amount specified in subsection (a)(1) over the rebates previously made";
}
pub relation refundable_credit_excess_over_tax_imposed(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "any excess of the sum of the credits allowable under sections 21, 24, 25A, 32, 34, 35, 36, 36B, 6428, 6428A, 6428B, and 7527A over the tax imposed by subtitle A (determined without regard to such credits)";
}
pub relation refundable_credit_excess_over_shown_tax(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "any excess of the sum of such credits as shown by the taxpayer on his return over the amount shown as the tax by the taxpayer on such return (determined without regard to such credits)";
}
pub relation partnership_related_item_adjustment_pending_subchapter_c(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "an adjustment to a partnership-related item for this person/year must be made under chapter 63 subchapter C (BBA partnership audit regime; pending `partnership-audit`, not this package's norm)";
}

pub relation deficiency_amount(p: Person, y: TaxableYear, k: TaxKind, deficiency: Money) kind institutional {
    label en official "the term \"deficiency\" means the amount by which the tax imposed by subtitle A or B, or chapter 41, 42, 43, or 44 exceeds the excess of [(1)(A)+(B)] over [(2) rebates]";
}
@source(IRC_S6211_A, relation = formalizes, coverage = partial, quote = "For purposes of this title in the case of income, estate, and gift taxes imposed by subtitles A and B and excise taxes imposed by chapters 41, 42, 43, and 44 the term \"deficiency\" means the amount by which the tax imposed by subtitle A or B, or chapter 41, 42, 43, or 44 exceeds the excess of—")
pub rule S6211DeficiencyAmountWithReturn strict {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for imposed: Money;
    for shown: Money;
    for previouslyAssessed: Money;
    for rebates: Money;
    for imposedCreditExcess: Money;
    for shownCreditExcess: Money;
    when return_was_made(p, y, k)
        and tax_imposed(p, y, k, imposed)
        and amount_shown_as_tax_by_taxpayer(p, y, k, shown)
        and amounts_previously_assessed(p, y, k, previouslyAssessed)
        and rebates_made(p, y, k, rebates)
        and refundable_credit_excess_over_tax_imposed(p, y, k, imposedCreditExcess)
        and refundable_credit_excess_over_shown_tax(p, y, k, shownCreditExcess)
        and not_known(partnership_related_item_adjustment_pending_subchapter_c(p, y));
    then deficiency_amount(p, y, k,
        (imposed - imposedCreditExcess) - ((shown - shownCreditExcess) + previouslyAssessed) + rebates);
}
// No return was made: (a)(1)(A) contributes $0 ("if a return was made ...
// and an amount was shown"); (A) drops out of the sum entirely.
@source(IRC_S6211_A, relation = formalizes, coverage = partial, quote = "the term \"deficiency\" means the amount by which the tax imposed by subtitle A or B, or chapter 41, 42, 43, or 44 exceeds the excess of—")
pub rule S6211DeficiencyAmountNoReturn strict {
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for imposed: Money;
    for previouslyAssessed: Money;
    for rebates: Money;
    for imposedCreditExcess: Money;
    when not_known(return_was_made(p, y, k))
        and tax_imposed(p, y, k, imposed)
        and amounts_previously_assessed(p, y, k, previouslyAssessed)
        and rebates_made(p, y, k, rebates)
        and refundable_credit_excess_over_tax_imposed(p, y, k, imposedCreditExcess)
        and not_known(partnership_related_item_adjustment_pending_subchapter_c(p, y));
    then deficiency_amount(p, y, k, (imposed - imposedCreditExcess) - previouslyAssessed + rebates);
}

@source(IRC_S6211_B, relation = formalizes, coverage = exact, quote = "The computation by the Secretary, pursuant to section 6014, of the tax imposed by chapter 1 shall be considered as having been made by the taxpayer and the tax so computed considered as shown by the taxpayer upon his return.")
rule S6211Section6014ComputationDeemedShown strict {
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    when secretary_computes_tax_under_section_6014(p, y, amount);
    then amount_shown_as_tax_by_taxpayer(p, y, us.irc.core::IncomeCh1, amount);
}
relation secretary_computes_tax_under_section_6014(p: Person, y: TaxableYear, amount: Money) kind empirical;

// ============================================================================
// §6212 — Notice of deficiency
// ============================================================================

pub relation secretary_determines_deficiency(p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en unofficial "positive anchor (§190): the Secretary determines that there is a deficiency, triggering the §6212(a) power to send notice";
}
pub relation secretary_mails_notice(n: Notice, p: Person, mailedOn: Date) kind empirical {
    label en unofficial "the Secretary's act of mailing the notice by certified or registered mail (§6212(a))";
}
@source(IRC_S6212_A, relation = formalizes, coverage = exact, quote = "If the Secretary determines that there is a deficiency in respect of any tax imposed by subtitles A or B or chapter 41, 42, 43, or 44 he is authorized to send notice of such deficiency to the taxpayer by certified mail or registered mail.")
pub rule S6212SendNoticeOfDeficiency strict {
    for n: Notice;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    when secretary_determines_deficiency(p, y, k) and secretary_mails_notice(n, p, mailedOn);
    then power S6212SendNoticeOfDeficiencyPower {
        holder Secretary;
        over p;
        exercise secretary_mails_notice(n, p, mailedOn);
        valid_when secretary_determines_deficiency(p, y, k);
        effect create(us.irc.core::notice_of(n, us.irc.core::Deficiency, p));
    };
}

pub relation includes_taxpayer_advocate_contact_information(n: Notice) kind empirical;
@source(IRC_S6212_A, relation = formalizes, coverage = exact, quote = "Such notice shall include a notice to the taxpayer of the taxpayer's right to contact a local office of the taxpayer advocate and the location and phone number of the appropriate office.")
rule S6212NoticeMustIncludeAdvocateContactInfo defeasible {
    for n: Notice;
    for p: Person;
    when us.irc.core::notice_of(n, us.irc.core::Deficiency, p);
    then duty S6212NoticeMustIncludeAdvocateContactInfoDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition includes_taxpayer_advocate_contact_information(n);
            window [-infinity, infinity];
        }
    };
}

// --- (b)(1) — Sufficiency at the last known address ------------------------

pub relation notice_of_deficiency_valid(n: Notice, p: Person) kind institutional {
    label en unofficial "the notice of deficiency is sufficient (§6212(b)): mailed to the last known address, or joint-notice equivalent — sufficiency is validity of the notice, per the task's framing";
}
@source(IRC_S6212_B, relation = formalizes, coverage = exact, quote = "In the absence of notice to the Secretary under section 6903 of the existence of a fiduciary relationship, notice of a deficiency in respect of a tax imposed by subtitle A, chapter 12, chapter 41, chapter 42, chapter 43, or chapter 44 if mailed to the taxpayer at his last known address, shall be sufficient for purposes of subtitle A, chapter 12, chapter 41, chapter 42, chapter 43, chapter 44, and this chapter even if such taxpayer is deceased, or is under a legal disability, or, in the case of a corporation, has terminated its existence.")
pub rule S6212NoticeSufficientAtLastKnownAddress defeasible {
    for n: Notice;
    for p: Person;
    when us.irc.core::notice_of(n, us.irc.core::Deficiency, p)
        and us.irc.core::address_last_known(n)
        and not_known(fiduciary_relationship_noticed(p));
    then notice_of_deficiency_valid(n, p);
    unless notice_rescinded(n, p);
}

pub relation joint_income_tax_return_by(husband: Individual, wife: Individual, y: TaxableYear) kind empirical;
pub relation separate_residences_established_notified(husband: Individual, wife: Individual) kind empirical {
    label en unofficial "the Secretary has been notified by either spouse that separate residences have been established (§6212(b)(2))";
}
pub relation joint_notice_sent(n: Notice, husband: Individual, wife: Individual) kind empirical;
pub relation duplicate_originals_sent_to_each_spouse(n: Notice, husband: Individual, wife: Individual) kind empirical;
@source(IRC_S6212_B, relation = formalizes, coverage = exact, quote = "In the case of a joint income tax return filed by husband and wife, such notice of deficiency may be a single joint notice, except that if the Secretary has been notified by either spouse that separate residences have been established, then, in lieu of the single joint notice, a duplicate original of the joint notice shall be sent by certified mail or registered mail to each spouse at his last known address.")
rule S6212JointNoticeValidWithoutSeparateResidences defeasible {
    for n: Notice;
    for husband: Individual;
    for wife: Individual;
    for y: TaxableYear;
    when joint_income_tax_return_by(husband, wife, y)
        and joint_notice_sent(n, husband, wife)
        and us.irc.core::address_last_known(n)
        and not_known(separate_residences_established_notified(husband, wife));
    then notice_of_deficiency_valid(n, husband);
    unless notice_rescinded(n, husband);
}
@source(IRC_S6212_B, relation = formalizes, coverage = exact, quote = "then, in lieu of the single joint notice, a duplicate original of the joint notice shall be sent by certified mail or registered mail to each spouse at his last known address.")
rule S6212DuplicateOriginalsValidWithSeparateResidences defeasible {
    for n: Notice;
    for husband: Individual;
    for wife: Individual;
    when separate_residences_established_notified(husband, wife)
        and duplicate_originals_sent_to_each_spouse(n, husband, wife)
        and us.irc.core::address_last_known(n);
    then notice_of_deficiency_valid(n, husband);
    unless notice_rescinded(n, husband);
}

pub relation addressed_in_name_of_decedent_or_person_subject_to_liability(n: Notice, p: Person) kind empirical;
@source(IRC_S6212_B, relation = formalizes, coverage = exact, quote = "In the absence of notice to the Secretary under section 6903 of the existence of a fiduciary relationship, notice of a deficiency in respect of a tax imposed by chapter 11, if addressed in the name of the decedent or other person subject to liability and mailed to his last known address, shall be sufficient for purposes of chapter 11 and of this chapter.")
rule S6212EstateTaxNoticeSufficientAddressedToDecedent defeasible {
    for n: Notice;
    for p: Person;
    when us.irc.core::notice_of(n, us.irc.core::Deficiency, p)
        and addressed_in_name_of_decedent_or_person_subject_to_liability(n, p)
        and us.irc.core::address_last_known(n)
        and not_known(fiduciary_relationship_noticed(p));
    then notice_of_deficiency_valid(n, p);
    unless notice_rescinded(n, p);
}

// --- (c)(1) — Further deficiency letters restricted -------------------------

pub relation petition_filed_with_tax_court(pr: Proceeding, n: Notice, p: Person) kind empirical {
    label en unofficial "the taxpayer files a petition with the Tax Court within the §6213(a) time (positive anchor for the (c)(1) immunity)";
}
external judgment relation fraud_established(p: Person, y: TaxableYear, k: TaxKind) {
    authority TaxCourt;
    label en official "fraud, in respect of the deficiency for which a further deficiency letter is proposed";
}
pub relation same_taxable_period_deficiency(n: Notice, p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en unofficial "the additional deficiency the Secretary would determine is of income tax for the same taxable year, gift tax for the same calendar year, estate tax for the same decedent, or chapter 41/43/44 (or §4940) tax for the same taxable year, with respect to any act or failure to act to which the pending petition relates";
}
@source(IRC_S6212_C, relation = formalizes, coverage = exact, quote = "If the Secretary has mailed to the taxpayer a notice of deficiency as provided in subsection (a), and the taxpayer files a petition with the Tax Court within the time prescribed in section 6213(a), the Secretary shall have no right to determine any additional deficiency of income tax for the same taxable year, of gift tax for the same calendar year, of estate tax in respect of the taxable estate of the same decedent, of chapter 41 tax for the same taxable year, of chapter 43 tax for the same taxable year, of chapter 44 tax for the same taxable year, of section 4940 tax for the same taxable year, or of chapter 42 tax, (other than under section 4940) with respect to any act (or failure to act) to which such petition relates, except in the case of fraud, and except as provided in section 6214(a) (relating to assertion of greater deficiencies before the Tax Court), in section 6213(b)(1) (relating to mathematical or clerical errors), in section 6851 or 6852 (relating to termination assessments), or in section 6861(c) (relating to the making of jeopardy assessments).")
pub rule S6212FurtherDeficiencyLettersRestricted strict {
    for n: Notice;
    for n2: Notice;
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn2: Date;
    when notice_of_deficiency_valid(n, p)
        and petition_filed_with_tax_court(pr, n, p)
        and same_taxable_period_deficiency(n, p, y, k)
        and not_known(fraud_established(p, y, k))
        and secretary_mails_notice(n2, p, mailedOn2);
    then immunity S6212NoFurtherDeficiencyLetterImmunity {
        holder p;
        protected_effect us.irc.core::notice_of(n2, us.irc.core::Deficiency, p);
        window [-infinity, infinity];
    };
}
priority FurtherDeficiencyImmunityOutranksNoticePower {
    prefer S6212FurtherDeficiencyLettersRestricted over S6212SendNoticeOfDeficiency;
    reason lex_specialis;
}
// (c)(2)'s cross-references (§63(e)(3), §1033(a)(2)(C)/(D), §183(e)(4), 11
// U.S.C. §505(a)) are pure "see section" pointers — NON_NORMATIVE here; each
// names an exception to `S6212FurtherDeficiencyLettersRestricted` that its
// OWN owner package would express as a further `unless` defeater once
// formalized, not a rule this package writes for another section's text.

// --- (d) — Rescission with consent ------------------------------------------

pub relation taxpayer_consents_to_rescission(n: Notice, p: Person) kind empirical;
pub relation secretary_rescinds_notice(n: Notice, p: Person) kind empirical;
@source(IRC_S6212_D, relation = formalizes, coverage = exact, quote = "The Secretary may, with the consent of the taxpayer, rescind any notice of deficiency mailed to the taxpayer.")
pub rule S6212RescindNotice strict {
    for n: Notice;
    for p: Person;
    when us.irc.core::notice_of(n, us.irc.core::Deficiency, p)
        and secretary_rescinds_notice(n, p)
        and taxpayer_consents_to_rescission(n, p);
    then power S6212RescindNoticePower {
        holder Secretary;
        over p;
        exercise secretary_rescinds_notice(n, p);
        valid_when taxpayer_consents_to_rescission(n, p);
        effect create(notice_rescinded(n, p));
    };
}
pub relation notice_rescinded(n: Notice, p: Person) kind institutional {
    label en official "any notice so rescinded shall not be treated as a notice of deficiency for purposes of subsection (c)(1) ..., section 6213(a) ..., and section 6512(a)";
}
// `notice_rescinded` is read directly as an `unless` defeater on every
// §6212(b) sufficiency rule above (so a rescinded notice is simply never
// `notice_of_deficiency_valid`) rather than through a second immunity: an
// `immunity`/`priority` pair only intercepts a POWER's `effect`, and the
// sufficiency rules above are ordinary institutional derivations, not a
// power's effect — modeling the block as `unless` is the direct fit,
// `immunity` is reserved for §6213(a)'s taxpayer-facing restriction below.
// "The taxpayer shall have no right to file a petition with the Tax Court
// based on such notice" is read by `03-restrictions-and-tax-court.law`'s
// own petition-filing rule (`unless notice_rescinded(n, p)` there too), not
// duplicated here.
// "Nothing in this subsection shall affect any suspension of the running of
// any period of limitations during any period during which the rescinded
// notice was outstanding" is read by `05-suspension.law`
// (`RescindedNoticeSuspensionUnaffected`), not duplicated here.
