// 26 U.S.C. §6502 — Collection after assessment.
//
// NOTE (stage 3, 26.09.2026): the scope cuts below are SUPERSEDED — the two
// extension branches, the indefinite-window sentence and (b) are modelled at
// the end of this file.
//
// WIRE-2 (25.09.2026, coordinator instruction): this section was previously
// left as an explicit out-of-scope pending contract ("do NOT model it,
// reference as pending" — see the historical note still in package.law's
// header). The coordinator's integration pass supersedes that scope cut:
// this module implements §6502(a)'s general 10-year rule as the small,
// self-contained piece it is, so `us.irc.collection` (§6322's "becomes
// unenforceable by reason of lapse of time" branch) can import a real
// fact instead of a permanent stub. This does NOT attempt the rest of
// chapter 66 or the whole of §6502: only (a)'s general rule.
//
// SCOPE.
//  - (a) general rule: 10 years after the assessment — EXECUTABLE, from
//    `us.irc.core::assessed_on(a, d)`.
//  - (a)(1)-(2)'s installment-agreement/levy-release extensions and the
//    "timely court proceeding extends the period indefinitely until
//    satisfied or unenforceable" final sentence are NOT modelled here
//    (TECH_GAP — a second and a defeasible-indefinite-window branch,
//    genuinely more than the "small module" the coordinator asked for;
//    left for the next pass, same non-max-over-derived caveat as
//    `assessment_period_ends`'s own extension rows in 04-limitations.law
//    applies if a later pass adds them as SEPARATE tuples).
//  - (b) ("date when levy is considered made") is a definitional
//    cross-reference to §6335(a) notice-of-seizure timing — NON_NORMATIVE
//    for this module's purpose (no independent consequence of its own
//    beyond dating a levy this package does not otherwise model).

use self::{
    Assessment,
    IRC_S6502_A,
    IRC_S6502_B,
    Levy,
    Person,
    TaxKind,
    TaxableYear,
    assessment_period_ends,
};

pub relation collection_period_ends(a: Assessment, d: Date) kind institutional {
    label en official "the date by which a levy must be made or a court proceeding for collection must begin under section 6502(a): ordinarily 10 years after the assessment";
}
@source(IRC_S6502_A, relation = formalizes, coverage = partial, quote = "within 10 years after the assessment of the tax")
pub rule S6502aGeneralTenYearPeriod defeasible {
    for a: Assessment;
    for assessedOn: Date;
    when us.irc.core::assessed_on(a, assessedOn);
    then collection_period_ends(a, add_calendar_period(assessedOn, 10 calendar_year));
}

// ============================================================================
// STAGE 3 (26.09.2026) — §6502(a)(2), final sentence, (b)
// ============================================================================
//
// The header above described these as out of scope for WIRE-2; stage 3 models
// them. Every extension is an ADDITIONAL `collection_period_ends` tuple (the
// no-max-over-derived caveat of 04-limitations.law applies). To avoid a
// max/min, `collection_action_timely` asks whether the levy or proceeding is
// on or before SOME applicable date — the union reading of "(1) ... or (2)".

pub relation installment_agreement_entered(a: Assessment, enteredOn: Date) kind empirical {
    label en official "there is an installment agreement between the taxpayer and the Secretary";
}
pub relation collection_period_agreed_at_installment_agreement(a: Assessment, agreedUntil: Date) kind empirical {
    label en official "a period for collection agreed upon in writing by the Secretary and the taxpayer at the time the installment agreement was entered into (its expiration date)";
}
@source(IRC_S6502_A, relation = formalizes, coverage = exact, quote = "there is an installment agreement between the taxpayer and the Secretary, prior to the date which is 90 days after the expiration of any period for collection agreed upon in writing by the Secretary and the taxpayer at the time the installment agreement was entered into")
rule S6502a2AInstallmentAgreementExtension defeasible {
    label en official "with an installment agreement, collection may be made before the date 90 days after the expiration of the period agreed in writing when the agreement was entered into";
    for a: Assessment;
    for enteredOn: Date;
    for agreedUntil: Date;
    when installment_agreement_entered(a, enteredOn)
        and collection_period_agreed_at_installment_agreement(a, agreedUntil);
    then collection_period_ends(a, add_calendar_period(agreedUntil, 90 calendar_day));
}
pub relation levy_released_under_6343(a: Assessment, releasedOn: Date) kind empirical {
    label en official "a release of levy under section 6343";
}
pub relation collection_period_agreed_before_release(a: Assessment, agreedUntil: Date, agreedOn: Date) kind empirical {
    label en official "a period for collection agreed upon in writing by the Secretary and the taxpayer before the release of levy (its expiration date and the date of agreement)";
}
@source(IRC_S6502_A, relation = formalizes, coverage = exact, quote = "there is a release of levy under section 6343 after such 10-year period, prior to the expiration of any period for collection agreed upon in writing by the Secretary and the taxpayer before such release")
rule S6502a2BReleaseOfLevyAfterTenYearsExtension defeasible {
    label en official "with a release of levy after the 10-year period, collection may be made before the expiration of the period agreed in writing before the release";
    for a: Assessment;
    for assessedOn: Date;
    for releasedOn: Date;
    for agreedUntil: Date;
    for agreedOn: Date;
    when us.irc.core::assessed_on(a, assessedOn)
        and levy_released_under_6343(a, releasedOn)
        and collection_period_agreed_before_release(a, agreedUntil, agreedOn)
        and releasedOn > add_calendar_period(assessedOn, 10 calendar_year)
        and agreedOn < releasedOn;
    then collection_period_ends(a, agreedUntil);
}
pub relation timely_collection_proceeding_commenced(a: Assessment, commencedOn: Date) kind empirical {
    label en official "a proceeding in court for the collection of the tax is commenced";
}
pub relation collection_action_timely(a: Assessment, actionOn: Date) kind institutional {
    label en unofficial "the levy or the court proceeding is made or begun on or before some applicable collection-period date (union of the 10-year period and the (2)(A)/(B) extension dates)";
}
pub relation levy_or_proceeding_made_on(a: Assessment, actionOn: Date) kind empirical {
    label en official "a levy is made or a proceeding in court for collection is begun";
}
@source(IRC_S6502_A, relation = formalizes, coverage = exact, quote = "such tax may be collected by levy or by a proceeding in court, but only if the levy is made or the proceeding begun—")
rule S6502aCollectionOnlyWithinAnApplicablePeriod defeasible {
    label en official "the tax may be collected by levy or proceeding only if made or begun within an applicable period";
    for a: Assessment;
    for actionOn: Date;
    for periodEnd: Date;
    when levy_or_proceeding_made_on(a, actionOn)
        and collection_period_ends(a, periodEnd)
        and actionOn <= periodEnd;
    then collection_action_timely(a, actionOn);
}
pub relation collection_by_levy_period_extended_until_satisfied(a: Assessment) kind institutional {
    label en official "the period during which the tax may be collected by levy is extended and does not expire until the liability (or a judgment arising from it) is satisfied or becomes unenforceable";
}
@source(IRC_S6502_A, relation = formalizes, coverage = exact, quote = "If a timely proceeding in court for the collection of a tax is commenced, the period during which such tax may be collected by levy shall be extended and shall not expire until the liability for the tax (or a judgment against the taxpayer arising from such liability) is satisfied or becomes unenforceable.")
rule S6502aTimelyCourtProceedingExtendsLevyPeriodIndefinitely defeasible {
    label en official "a timely proceeding in court for collection extends the levy period until the liability is satisfied or becomes unenforceable";
    for a: Assessment;
    for commencedOn: Date;
    for periodEnd: Date;
    when timely_collection_proceeding_commenced(a, commencedOn)
        and collection_period_ends(a, periodEnd)
        and commencedOn <= periodEnd;
    then collection_by_levy_period_extended_until_satisfied(a);
}
// The lead condition of (a) ("where the assessment has been made within the
// period of limitation properly applicable thereto") is read by
// `assessment_made_within_limitation` below, not folded into the 10-year rule
// (the stage-2 rule and its scenarios are unchanged).
pub relation assessment_made_within_limitation(a: Assessment) kind institutional {
    label en official "the assessment has been made within the period of limitation properly applicable thereto";
}
@source(IRC_S6502_A, relation = formalizes, coverage = exact, quote = "Where the assessment of any tax imposed by this title has been made within the period of limitation properly applicable thereto")
rule S6502aAssessmentWithinLimitation defeasible {
    label en official "the assessment was made on or before the assessment-period end date";
    for a: Assessment;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for assessedOn: Date;
    for periodEnd: Date;
    when us.irc.core::assessment_of(a, p, y, k, amount)
        and us.irc.core::assessed_on(a, assessedOn)
        and assessment_period_ends(p, y, k, periodEnd)
        and assessedOn <= periodEnd;
    then assessment_made_within_limitation(a);
}
// (b): the date of a levy is the date on which the notice of seizure under
// §6335(a) is given (a definition of the levy date; §6335 is `collection`'s norm).
pub relation notice_of_seizure_given_on(l: Levy, givenOn: Date) kind empirical {
    label en official "the notice of seizure provided in section 6335(a) is given";
}
pub relation levy_made_on(l: Levy, madeOn: Date) kind institutional {
    label en official "the date on which a levy on property or rights to property is made is the date on which the notice of seizure is given";
}
@source(IRC_S6502_B, relation = formalizes, coverage = exact, quote = "The date on which a levy on property or rights to property is made shall be the date on which the notice of seizure provided in section 6335(a) is given.")
pub rule S6502bLevyDateIsNoticeOfSeizureDate defeasible {
    label en official "a levy is made on the date the notice of seizure is given";
    for l: Levy;
    for givenOn: Date;
    when notice_of_seizure_given_on(l, givenOn);
    then levy_made_on(l, givenOn);
}
