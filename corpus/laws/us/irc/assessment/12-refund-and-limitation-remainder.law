// 26 U.S.C. §§6511(f), (h); 6512; 6513(c)-(e); 6514; 6521; 6532(b) — limitations
// on credit or refund and mitigation, remainder. Stage 3 (26.09.2026,
// DECISION-0379). Status: implemented_unverified.
//
// SCOPE (what this module adds to 08-refund-claims-and-suits.law).
//  - §6511(f): the return referred to in §6511(a) for §4912 / chapter 42 /
//    §4975 taxes is the return specified in §6501(l)(1).
//  - §6511(h): the running of §6511(a)-(c) is suspended while an individual is
//    financially disabled. The suspended-day count is checked in COMPARISON
//    FORM against a caller-proposed candidate date (the same G243 idiom as
//    05-suspension.law: `add_calendar_period` needs a literal day count).
//  - §6512(a): after a timely Tax Court petition, no credit, refund or suit
//    for the same tax and year except in six named cases (a prohibition on
//    the Secretary and on the taxpayer with `unless` exceptions); §6512(b):
//    the Tax Court's power to determine an overpayment, the Secretary's duty
//    to credit or refund once the decision is final, the 120-day
//    enforcement power, the paid-after-notice / lookback limit of (b)(3)(A)-(B)
//    and the no-jurisdiction rule of (b)(4). (b)(3)(C) is NOT modelled.
//  - §6513(c)-(e): deemed filing / payment dates for chapters 3, 4, 21, 24
//    (April 15), the credit of an overpayment against the next year's
//    estimated tax, and chapter 23 payments under §6157.
//  - §6514: refunds and credits made after a period of limitation.
//  - §6521: the self-employment / FICA mitigation offset.
//  - §6532(b): the suit by the United States for an erroneous refund.
//
// E-0134 TWINS: a power's effect is not visible to defeasible rules and not to
// `not_known`; where a later rule needs the outcome (an overpayment
// determination, a timely suit) it reads a `*_twin` derived from the same
// premises as the power's valid_when.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6511_F,
    IRC_S6511_H,
    IRC_S6512_A,
    IRC_S6512_B,
    IRC_S6513_C,
    IRC_S6513_D,
    IRC_S6513_E,
    IRC_S6514_A,
    IRC_S6514_B,
    IRC_S6521_A,
    IRC_S6532_B,
    Individual,
    Notice,
    Person,
    Proceeding,
    Secretary,
    TaxCourt,
    TaxKind,
    TaxableYear,
    amount_paid_as_tax,
    april_15_of_succeeding_year,
    decision_final_on,
    deemed_filed_date_for_refund,
    deficiency_notice_for,
    is_chapter_3_4_21_or_24_return,
    notice_of_deficiency_valid,
    petition_filed_timely,
    petition_filed_with_tax_court,
    refund_claim_period_ends,
    refund_claim_three_year_end,
    refund_claim_timely,
    refund_suit_period_ends,
    refund_suit_window_open,
};

// ============================================================================
// §6511(f) — Chapter 42 and similar taxes
// ============================================================================

pub relation refund_tax_is_4912_chapter42_or_4975(p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "the tax is imposed by section 4912, chapter 42, or section 4975";
}
pub relation section_6501_l_1_return_filed_on(p: Person, y: TaxableYear, k: TaxKind, filedOn: Date) kind empirical {
    label en official "the return specified in section 6501(l)(1) is filed (its date)";
}
@source(IRC_S6511_F, relation = formalizes, coverage = exact, quote = "the return referred to in subsection (a) shall be the return specified in section 6501(l)(1)")
rule S6511fReturnIsTheSection6501l1Return defeasible {
    label en official "for section 4912, chapter 42 and section 4975 taxes the return referred to in section 6511(a) is the return specified in section 6501(l)(1)";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    when refund_tax_is_4912_chapter42_or_4975(p, y, k)
        and section_6501_l_1_return_filed_on(p, y, k, filedOn);
    then deemed_filed_date_for_refund(p, y, k, filedOn);
}
// JUDGMENT CALL: the generic `deemed_filed_date` bridge of module 08 can
// still produce a second `deemed_filed_date_for_refund` tuple from a return
// that is not the §6501(l)(1) return; a case for these taxes supplies only
// the §6501(l)(1) return (no max/min-over-derived, same caveat as module 04).
// TECH_GAP G3706: the content of §6501(l)(1) (which return it names) is not
// yet modelled in module 04.

// ============================================================================
// §6511(h) — Suspension while financially disabled
// ============================================================================

pub entity FinancialDisabilityPeriod {
    label en unofficial "a period of an individual's life claimed to be a period of financial disability";
}
pub relation financial_disability_period_of(fd: FinancialDisabilityPeriod, p: Individual, startsOn: Date, endsOn: Date) kind empirical {
    label en official "a period of the individual's life during which the individual claims to be financially disabled";
}
external judgment relation unable_to_manage_financial_affairs_due_to_impairment(fd: FinancialDisabilityPeriod) {
    authority Secretary;
    label en official "unable to manage his financial affairs by reason of a medically determinable physical or mental impairment of the individual";
}
pub relation impairment_expected_to_result_in_death_or_last_twelve_months(fd: FinancialDisabilityPeriod) kind empirical {
    label en official "the impairment can be expected to result in death or has lasted or can be expected to last for a continuous period of not less than 12 months";
}
pub relation proof_of_impairment_furnished(fd: FinancialDisabilityPeriod) kind empirical {
    label en official "proof of the existence of the impairment is furnished in such form and manner as the Secretary may require";
}
pub relation other_person_authorized_to_act_in_financial_matters(fd: FinancialDisabilityPeriod) kind empirical {
    label en official "the individual's spouse or any other person is authorized to act on behalf of the individual in financial matters";
}
pub relation exists_other_person_authorized(fd: FinancialDisabilityPeriod) kind institutional {
    label en unofficial "existential wrapper over `other_person_authorized_to_act_in_financial_matters` (the atom is already fully bound; kept for symmetry with sibling wrappers)";
}
rule S6511h2bExistsAuthorizedPerson strict {
    label en unofficial "some other person is authorized to act in financial matters for the period";
    for fd: FinancialDisabilityPeriod;
    when other_person_authorized_to_act_in_financial_matters(fd);
    then exists_other_person_authorized(fd);
}
pub relation financially_disabled_period(fd: FinancialDisabilityPeriod) kind institutional {
    label en official "the individual is financially disabled during the period";
}
@source(IRC_S6511_H, relation = formalizes, coverage = exact, quote = "an individual is financially disabled if such individual is unable to manage his financial affairs by reason of a medically determinable physical or mental impairment of the individual which can be expected to result in death or which has lasted or can be expected to last for a continuous period of not less than 12 months")
rule S6511h2aFinanciallyDisabled defeasible {
    label en official "financial disability: unable to manage financial affairs by reason of an impairment lasting at least 12 months (or expected to cause death), with proof furnished, and no other person authorized to act";
    for fd: FinancialDisabilityPeriod;
    when unable_to_manage_financial_affairs_due_to_impairment(fd)
        and impairment_expected_to_result_in_death_or_last_twelve_months(fd)
        and proof_of_impairment_furnished(fd)
        and not_known(exists_other_person_authorized(fd));
    then financially_disabled_period(fd);
}
pub relation financial_disability_counted_days(p: Individual, fd: FinancialDisabilityPeriod, days: Integer) kind institutional {
    label en unofficial "the number of days of a qualifying period of financial disability";
}
rule S6511h1CountedDaysOfDisabilityPeriod defeasible {
    label en official "each day of a period of financial disability suspends the running of the section 6511(a)-(c) periods";
    for fd: FinancialDisabilityPeriod;
    for p: Individual;
    for startsOn: Date;
    for endsOn: Date;
    when financial_disability_period_of(fd, p, startsOn, endsOn)
        and financially_disabled_period(fd)
        and endsOn >= startsOn;
    then financial_disability_counted_days(p, fd, days_between(startsOn, endsOn) + 1);
}
pub relation financial_disability_total_days(p: Individual, total: Integer) kind institutional {
    label en unofficial "the total number of days of qualifying financial disability";
}
rule S6511h1TotalDays defeasible {
    label en unofficial "the total of the counted days";
    for p: Individual;
    for fd0: FinancialDisabilityPeriod;
    for d0: Integer;
    when financial_disability_counted_days(p, fd0, d0);
    then financial_disability_total_days(p, sum all d: Integer for fd: FinancialDisabilityPeriod where financial_disability_counted_days(p, fd, d));
}
pub relation candidate_refund_claim_period_end_with_disability(p: Individual, y: TaxableYear, k: TaxKind, candidate: Date) kind empirical {
    label en unofficial "a candidate section 6511(a) claim-period end date, AS EXTENDED for the financial-disability suspension, proposed by the caller for validation (G243 comparison form)";
}
pub relation refund_claim_period_ends_with_disability(p: Individual, y: TaxableYear, k: TaxKind, d: Date) kind institutional {
    label en official "the running of the periods specified in subsections (a), (b), and (c) is suspended during any period of the individual's life that the individual is financially disabled: the candidate date equals the claim period end extended by exactly the counted disabled days";
}
@source(IRC_S6511_H, relation = formalizes, coverage = exact, quote = "the running of the periods specified in subsections (a), (b), and (c) shall be suspended during any period of such individual's life that such individual is financially disabled")
pub rule S6511h1SuspensionConfirmedForCandidate defeasible {
    label en official "the section 6511(a)-(c) periods are suspended during financial disability (candidate confirmed by exact day count)";
    for p: Individual;
    for y: TaxableYear;
    for k: TaxKind;
    for baseEnd: Date;
    for disabledDays: Integer;
    for candidate: Date;
    when refund_claim_period_ends(p, y, k, baseEnd)
        and financial_disability_total_days(p, disabledDays)
        and candidate_refund_claim_period_end_with_disability(p, y, k, candidate)
        and candidate >= baseEnd
        and days_between(baseEnd, candidate) == disabledDays;
    then refund_claim_period_ends_with_disability(p, y, k, candidate);
}
// TECH_GAP G3707: the extended date cannot be COMPUTED from the count
// (`add_calendar_period` takes a literal quantity, LDC-E2108); it is validated
// when the caller proposes it. Only individuals: the suspension is limited to
// "the case of an individual".

// ============================================================================
// §6512(a) — Effect of a Tax Court petition on credits, refunds and suits
// ============================================================================

pub enum RefundBarException {
    FinalTaxCourtOverpayment;
    CollectedInExcessOfDecision;
    CollectedAfterCollectionLimitation;
    PartnershipItemsSubchapterC;
    CollectedDuringAssessmentRestriction;
    RefundPendingAppeal;
    label en unofficial "the six exceptions of section 6512(a)(1)-(6) to the bar on credit, refund and suit after a timely Tax Court petition";
}
pub relation refund_barred_by_tax_court_petition(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en official "the Secretary has mailed a notice of deficiency for the tax and year and the taxpayer filed a Tax Court petition within the time prescribed in section 6213(a)";
}
@source(IRC_S6512_A, relation = formalizes, coverage = exact, quote = "If the Secretary has mailed to the taxpayer a notice of deficiency under section 6212(a)")
rule S6512aBarConditionsMet defeasible {
    label en official "a notice of deficiency was mailed and a Tax Court petition was filed within the time of section 6213(a)";
    for n: Notice;
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    when deficiency_notice_for(n, p, y, k)
        and notice_of_deficiency_valid(n, p)
        and petition_filed_timely(pr, n, p);
    then refund_barred_by_tax_court_petition(p, y, k);
}
pub relation refund_bar_exception_established(p: Person, y: TaxableYear, k: TaxKind, ex: RefundBarException) kind empirical {
    label en official "one of the six cases in which credit, refund or suit remains allowed after the petition";
}
pub relation refund_bar_exception_applies(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "some section 6512(a) exception applies to the credit, refund or suit";
}
@source(IRC_S6512_A, relation = formalizes, coverage = exact, quote = "(1) As to overpayments determined by a decision of the Tax Court which has become final, and")
rule S6512aExceptionsApply defeasible {
    label en official "a credit, refund or suit remains allowed in the six cases of (a)(1)-(6)";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for ex: RefundBarException;
    when refund_bar_exception_established(p, y, k, ex);
    then refund_bar_exception_applies(p, y, k);
}
pub relation secretary_allows_credit_or_refund(p: Person, y: TaxableYear, k: TaxKind, allowedOn: Date) kind empirical {
    label en official "the Secretary allows or makes a credit or refund";
}
pub relation taxpayer_institutes_recovery_suit(p: Person, y: TaxableYear, k: TaxKind, suedOn: Date) kind empirical {
    label en official "the taxpayer institutes a suit for the recovery of any part of the tax in any court";
}
@source(IRC_S6512_A, relation = formalizes, coverage = exact, quote = "no credit or refund of income tax for the same taxable year, of gift tax for the same calendar year or calendar quarter, of estate tax in respect of the taxable estate of the same decedent, or of tax imposed by chapter 41, 42, 43, or 44 with respect to any act (or failure to act) to which such petition relates, in respect of which the Secretary has determined the deficiency shall be allowed or made")
pub rule S6512aNoCreditOrRefundAfterPetition defeasible {
    label en official "no credit or refund of the tax for the same year in respect of which the Secretary determined the deficiency shall be allowed or made after the petition, except in the six cases";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for allowedOn: Date;
    when refund_barred_by_tax_court_petition(p, y, k)
        and secretary_allows_credit_or_refund(p, y, k, allowedOn);
    then prohibition S6512aNoCreditOrRefundProhibition {
        bearer Secretary;
        beneficiary p;
        action secretary_allows_credit_or_refund(p, y, k, allowedOn);
        window [-infinity, infinity];
    };
    unless refund_bar_exception_applies(p, y, k) and secretary_allows_credit_or_refund(p, y, k, allowedOn);
}
@source(IRC_S6512_A, relation = formalizes, coverage = exact, quote = "no suit by the taxpayer for the recovery of any part of the tax shall be instituted in any court except—")
pub rule S6512aNoSuitAfterPetition defeasible {
    label en official "no suit by the taxpayer for the recovery of any part of the tax shall be instituted in any court after the petition, except in the six cases";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for suedOn: Date;
    when refund_barred_by_tax_court_petition(p, y, k)
        and taxpayer_institutes_recovery_suit(p, y, k, suedOn);
    then prohibition S6512aNoRecoverySuitProhibition {
        bearer p;
        beneficiary Secretary;
        action taxpayer_institutes_recovery_suit(p, y, k, suedOn);
        window [-infinity, infinity];
    };
    unless refund_bar_exception_applies(p, y, k) and taxpayer_institutes_recovery_suit(p, y, k, suedOn);
}

// ============================================================================
// §6512(b) — Overpayment determined by the Tax Court
// ============================================================================

pub relation tax_court_finds_no_deficiency_or_deficiency_and_overpayment(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "the Tax Court finds that there is no deficiency and an overpayment, or a deficiency and an overpayment of such tax";
}
pub relation tax_court_determines_overpayment(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en official "the Tax Court determines the amount of the overpayment";
}
pub relation tax_court_overpayment_within_notice_case(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "single-atom valid_when helper: the petition relates to a notice of deficiency for the same tax and year and the Tax Court made the overpayment finding";
}
rule S6512b1OverpaymentFindingConditions defeasible {
    label en official "the Tax Court has jurisdiction where it finds an overpayment of the tax for the year in respect of which the Secretary determined the deficiency";
    for pr: Proceeding;
    for n: Notice;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    when deficiency_notice_for(n, p, y, k)
        and petition_filed_with_tax_court(pr, n, p)
        and tax_court_finds_no_deficiency_or_deficiency_and_overpayment(pr, p, y, k);
    then tax_court_overpayment_within_notice_case(pr, p, y, k);
}
pub relation tax_court_overpayment_determined(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "the amount of the overpayment determined by the Tax Court, to be credited or refunded when the decision has become final";
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "the Tax Court shall have jurisdiction to determine the amount of such overpayment")
pub rule S6512b1TaxCourtDeterminesOverpayment defeasible {
    label en official "the Tax Court has jurisdiction to determine the amount of the overpayment";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when tax_court_determines_overpayment(pr, p, y, k, amount);
    then power S6512b1DetermineOverpaymentPower {
        holder TaxCourt;
        over p;
        exercise tax_court_determines_overpayment(pr, p, y, k, amount);
        valid_when tax_court_overpayment_within_notice_case(pr, p, y, k);
        effect create(tax_court_overpayment_determined(pr, p, y, k, amount));
    };
}
pub relation tax_court_overpayment_determined_twin(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en unofficial "E-0134 twin of `tax_court_overpayment_determined`: derived from the same premises as the determination power's valid_when";
}
rule S6512b1OverpaymentDeterminedTwin defeasible {
    label en unofficial "the overpayment determination is readable to later rules";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when tax_court_determines_overpayment(pr, p, y, k, amount)
        and tax_court_overpayment_within_notice_case(pr, p, y, k);
    then tax_court_overpayment_determined_twin(pr, p, y, k, amount);
}
pub relation overpayment_credited_or_refunded(p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en official "the overpayment determined by the Tax Court is credited or refunded to the taxpayer";
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "such amount shall, when the decision of the Tax Court has become final, be credited or refunded to the taxpayer")
pub rule S6512b1CreditOrRefundWhenDecisionFinal defeasible {
    label en official "the overpayment determined by the Tax Court shall, when the decision has become final, be credited or refunded";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for finalOn: Date;
    when tax_court_overpayment_determined_twin(pr, p, y, k, amount)
        and decision_final_on(pr, finalOn);
    then duty S6512b1CreditOrRefundDuty {
        bearer Secretary;
        beneficiary p;
        goal achievement {
            condition overpayment_credited_or_refunded(p, y, k, amount);
            window [finalOn, infinity];
        }
    };
}
pub relation notice_of_appeal_filed_under_7483(pr: Proceeding) kind empirical {
    label en official "a notice of appeal in respect of the decision of the Tax Court is filed under section 7483";
}
pub relation overpayment_not_contested_on_appeal(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en official "the overpayment determined by the Tax Court is not contested on appeal (to that extent)";
}
pub relation secretary_refunds_pending_appeal(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind empirical {
    label en official "the Secretary refunds or credits the overpayment determined by the Tax Court while the appeal is pending";
}
pub relation pending_appeal_refund_conditions(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en unofficial "single-atom valid_when helper: a notice of appeal is filed and the amount is not contested on appeal";
}
rule S6512b1PendingAppealConditions defeasible {
    label en official "the Secretary may refund or credit to the extent the overpayment is not contested on appeal";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when notice_of_appeal_filed_under_7483(pr)
        and overpayment_not_contested_on_appeal(pr, p, y, k, amount)
        and tax_court_overpayment_determined_twin(pr, p, y, k, amount);
    then pending_appeal_refund_conditions(pr, p, y, k, amount);
}
pub relation pending_appeal_refund_authorized(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money) kind institutional {
    label en official "the refund or credit pending appeal is authorized (subsection (a)(6) exception)";
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to refund or credit the overpayment determined by the Tax Court to the extent the overpayment is not contested on appeal")
pub rule S6512b1RefundPendingAppeal defeasible {
    label en official "if a notice of appeal is filed, the Secretary is authorized to refund or credit the uncontested overpayment";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    when secretary_refunds_pending_appeal(pr, p, y, k, amount);
    then power S6512b1RefundPendingAppealPower {
        holder Secretary;
        over p;
        exercise secretary_refunds_pending_appeal(pr, p, y, k, amount);
        valid_when pending_appeal_refund_conditions(pr, p, y, k, amount);
        effect create(pending_appeal_refund_authorized(pr, p, y, k, amount));
    };
}
pub relation secretary_failed_to_refund_within_120_days(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money, asOf: Date) kind institutional {
    label en official "after 120 days after the decision of the Tax Court has become final, the Secretary has failed to refund the overpayment with interest";
}
pub relation refund_check_as_of(pr: Proceeding, asOf: Date) kind empirical {
    label en unofficial "the case-supplied date as of which the 120-day period is tested (this package has no current-date primitive)";
}
rule S6512b2FailureToRefundAfter120Days defeasible {
    label en official "120 days after finality without a refund of the overpayment";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for finalOn: Date;
    for asOf: Date;
    when tax_court_overpayment_determined_twin(pr, p, y, k, amount)
        and decision_final_on(pr, finalOn)
        and refund_check_as_of(pr, asOf)
        and asOf > add_calendar_period(finalOn, 120 calendar_day)
        and not_known(overpayment_credited_or_refunded(p, y, k, amount));
    then secretary_failed_to_refund_within_120_days(pr, p, y, k, amount, asOf);
}
pub relation tax_court_moved_to_order_refund(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money, asOf: Date) kind empirical {
    label en official "the taxpayer moves the Tax Court to order the refund of the overpayment and interest";
}
pub relation tax_court_refund_order_available(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, amount: Money, asOf: Date) kind institutional {
    label en official "the Tax Court has jurisdiction to order the refund of the overpayment and interest upon the taxpayer's motion";
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "the Tax Court, upon motion by the taxpayer, shall have jurisdiction to order the refund of such overpayment and interest")
pub rule S6512b2EnforcementJurisdiction defeasible {
    label en official "if after 120 days the Secretary has not refunded, the Tax Court on the taxpayer's motion may order the refund with interest";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for asOf: Date;
    when tax_court_moved_to_order_refund(pr, p, y, k, amount, asOf);
    then power S6512b2OrderRefundPower {
        holder TaxCourt;
        over p;
        exercise tax_court_moved_to_order_refund(pr, p, y, k, amount, asOf);
        valid_when secretary_failed_to_refund_within_120_days(pr, p, y, k, amount, asOf);
        effect create(tax_court_refund_order_available(pr, p, y, k, amount, asOf));
    };
}
// --- (b)(3): limit on the amount of credit or refund ------------------------

pub relation tax_court_notice_mailed_on(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, mailedOn: Date) kind empirical {
    label en official "the date of the mailing of the notice of deficiency in the proceeding";
}
pub relation exists_filed_return_for_refund(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "a return was filed for the tax and year (existential wrapper over `deemed_filed_date_for_refund`)";
}
rule S6512b3ExistsFiledReturn defeasible {
    label en unofficial "a deemed filing date exists";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for d: Date;
    when deemed_filed_date_for_refund(p, y, k, d);
    then exists_filed_return_for_refund(p, y, k);
}
pub relation tax_court_credit_refund_limit(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind, limit: Money) kind institutional {
    label en official "no credit or refund of any portion of the tax unless the Tax Court determines that it was paid after the mailing of the notice of deficiency, or within the period that would apply under section 6511(b)(2) had a claim been filed on the mailing date (subparagraph (C) is not modelled)";
}
@source(IRC_S6512_B, relation = formalizes, coverage = partial, quote = "(A) after the mailing of the notice of deficiency,")
rule S6512b3LimitThreeYearLookbackReturnFiled defeasible {
    label en official "return filed and the notice mailed within the 3-year claim period: payments after the notice or within 3 years before the mailing date (subparagraphs (A) and (B))";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    for threeYearEnd: Date;
    for calendar_before_1: Date;
    when tax_court_notice_mailed_on(pr, p, y, k, mailedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and mailedOn <= threeYearEnd
        and us.irc.core::civil_calendar_boundary_before(mailedOn, 3, us.irc.core::CalendarYear, calendar_before_1);
    then tax_court_credit_refund_limit(pr, p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn >= calendar_before_1);
}
@source(IRC_S6512_B, relation = formalizes, coverage = partial, quote = "(A) after the mailing of the notice of deficiency,")
rule S6512b3LimitTwoYearLookbackReturnFiled defeasible {
    label en official "return filed and the notice mailed after the 3-year claim period: payments after the notice or within 2 years before the mailing date";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    for threeYearEnd: Date;
    for calendar_before_1: Date;
    when tax_court_notice_mailed_on(pr, p, y, k, mailedOn)
        and refund_claim_three_year_end(p, y, k, threeYearEnd)
        and mailedOn > threeYearEnd
        and us.irc.core::civil_calendar_boundary_before(mailedOn, 2, us.irc.core::CalendarYear, calendar_before_1);
    then tax_court_credit_refund_limit(pr, p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn >= calendar_before_1);
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "the applicable period under subsections (a) and (b)(2) of section 6511 shall be 3 years")
rule S6512b3LimitNoReturnThirdYear defeasible {
    label en official "no return filed before the notice and the notice is mailed in the third year after the due date: the applicable period is 3 years";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    for dueOn: Date;
    for calendar_before_1: Date;
    when tax_court_notice_mailed_on(pr, p, y, k, mailedOn)
        and not_known(exists_filed_return_for_refund(p, y, k))
        and us.irc.returns::statutory_due_date(p, y, k, dueOn)
        and mailedOn > add_calendar_period(dueOn, 2 calendar_year)
        and mailedOn <= add_calendar_period(dueOn, 3 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(mailedOn, 3, us.irc.core::CalendarYear, calendar_before_1);
    then tax_court_credit_refund_limit(pr, p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn >= calendar_before_1);
}
@source(IRC_S6512_B, relation = formalizes, coverage = partial, quote = "(A) after the mailing of the notice of deficiency,")
rule S6512b3LimitNoReturnNoticeBeforeThirdYearTwoYears defeasible {
    label en official "no return filed and the notice is mailed no later than 2 years after the due date: the 2-year lookback of section 6511(b)(2)(B)";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    for dueOn: Date;
    for calendar_before_1: Date;
    when tax_court_notice_mailed_on(pr, p, y, k, mailedOn)
        and not_known(exists_filed_return_for_refund(p, y, k))
        and us.irc.returns::statutory_due_date(p, y, k, dueOn)
        and mailedOn <= add_calendar_period(dueOn, 2 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(mailedOn, 2, us.irc.core::CalendarYear, calendar_before_1);
    then tax_court_credit_refund_limit(pr, p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn >= calendar_before_1);
}
@source(IRC_S6512_B, relation = formalizes, coverage = partial, quote = "(A) after the mailing of the notice of deficiency,")
rule S6512b3LimitNoReturnNoticeAfterThirdYearTwoYears defeasible {
    label en official "no return filed and the notice is mailed after the third year after the due date: the 2-year lookback of section 6511(b)(2)(B)";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for mailedOn: Date;
    for dueOn: Date;
    for calendar_before_1: Date;
    when tax_court_notice_mailed_on(pr, p, y, k, mailedOn)
        and not_known(exists_filed_return_for_refund(p, y, k))
        and us.irc.returns::statutory_due_date(p, y, k, dueOn)
        and mailedOn > add_calendar_period(dueOn, 3 calendar_year)
        and us.irc.core::civil_calendar_boundary_before(mailedOn, 2, us.irc.core::CalendarYear, calendar_before_1);
    then tax_court_credit_refund_limit(pr, p, y, k,
        sum all amount: Money for paidOn: Date
            where amount_paid_as_tax(p, y, k, amount, paidOn)
                and paidOn >= calendar_before_1);
}
// JUDGMENT CALL: "the due date (with extensions)" is read as the unextended
// statutory due date bridged from `us.irc.returns::statutory_due_date` (the
// same simplification module 04 documents for §6501(b)(1)). Where no return
// was filed and the notice is not mailed in the third year, subparagraph (B)
// applies section 6511(b)(2)(B)'s 2-year period (a claim filed on the notice
// date for a tax with no return).
// TECH_GAP G3709: (b)(3)(C) — the period of a claim filed before the notice
// (not disallowed / disallowed but suit possible / suit begun in time) is a
// union of limits over several claims; "no max-over-derived" applies.

pub relation tax_court_reviews_section_6402_offset(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "the Tax Court is asked to restrain or review any credit or reduction made by the Secretary under section 6402";
}
pub relation section_6402_credit_or_reduction_made(p: Person, y: TaxableYear, k: TaxKind) kind empirical {
    label en official "the Secretary has made a credit or reduction under section 6402";
}
pub relation tax_court_review_of_offset_proceeds(pr: Proceeding, p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "the Tax Court reviews or restrains the section 6402 credit or reduction";
}
rule S6512b4ReviewProceeds defeasible {
    label en unofficial "a request to review a section 6402 offset would be entertained";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    when tax_court_reviews_section_6402_offset(pr, p, y, k)
        and section_6402_credit_or_reduction_made(p, y, k);
    then tax_court_review_of_offset_proceeds(pr, p, y, k);
}
@source(IRC_S6512_B, relation = formalizes, coverage = exact, quote = "The Tax Court shall have no jurisdiction under this subsection to restrain or review any credit or reduction made by the Secretary under section 6402.")
rule S6512b4NoJurisdictionOverSection6402Offsets defeasible {
    label en official "the Tax Court has no jurisdiction to restrain or review a section 6402 credit or reduction";
    for pr: Proceeding;
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    when tax_court_reviews_section_6402_offset(pr, p, y, k)
        and section_6402_credit_or_reduction_made(p, y, k);
    then immunity S6512b4NoReviewOfOffsetImmunity {
        holder Secretary;
        protected_effect tax_court_review_of_offset_proceeds(pr, p, y, k);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §6513(c)-(e) — Deemed filing and payment dates
// ============================================================================

pub relation withholding_return_filed_on(p: Person, y: TaxableYear, k: TaxKind, filedOn: Date) kind empirical {
    label en official "a return of tax imposed by chapter 3, 4, 21 or 24 for a period ending with or within a calendar year is filed";
}
@source(IRC_S6513_C, relation = formalizes, coverage = exact, quote = "such return shall be considered filed on April 15 of such succeeding calendar year")
rule S6513c1ReturnBeforeApril15ConsideredFiledApril15 defeasible {
    label en official "for section 6511 a chapter 3, 4, 21 or 24 return filed before April 15 of the succeeding calendar year is considered filed on April 15";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for april15: Date;
    when is_chapter_3_4_21_or_24_return(k)
        and withholding_return_filed_on(p, y, k, filedOn)
        and april_15_of_succeeding_year(y, april15)
        and filedOn < april15;
    then deemed_filed_date_for_refund(p, y, k, april15);
}
@source(IRC_S6513_C, relation = formalizes, coverage = exact, quote = "If a return for any period ending with or within a calendar year is filed before April 15 of the succeeding calendar year, such return shall be considered filed on April 15")
rule S6513c1ReturnOnOrAfterApril15KeepsFilingDate defeasible {
    label en official "a chapter 3, 4, 21 or 24 return filed on or after April 15 keeps its actual filing date";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for filedOn: Date;
    for april15: Date;
    when is_chapter_3_4_21_or_24_return(k)
        and withholding_return_filed_on(p, y, k, filedOn)
        and april_15_of_succeeding_year(y, april15)
        and filedOn >= april15;
    then deemed_filed_date_for_refund(p, y, k, filedOn);
}
pub relation withholding_tax_paid_on(p: Person, y: TaxableYear, k: TaxKind, amount: Money, paidOn: Date) kind empirical {
    label en official "tax with respect to remuneration or other amount paid during a period ending with or within a calendar year is paid";
}
@source(IRC_S6513_C, relation = formalizes, coverage = exact, quote = "such tax shall be considered paid on April 15 of such succeeding calendar year")
rule S6513c2PaymentBeforeApril15ConsideredPaidApril15 strict {
    label en official "for section 6511 a chapter 3, 4, 21 or 24 tax paid before April 15 of the succeeding calendar year is considered paid on April 15";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for paidOn: Date;
    for april15: Date;
    when is_chapter_3_4_21_or_24_return(k)
        and withholding_tax_paid_on(p, y, k, amount, paidOn)
        and april_15_of_succeeding_year(y, april15)
        and paidOn < april15;
    then amount_paid_as_tax(p, y, k, amount, april15);
}
@source(IRC_S6513_C, relation = formalizes, coverage = exact, quote = "If a tax with respect to remuneration or other amount paid during any period ending with or within a calendar year is paid before April 15 of the succeeding calendar year")
rule S6513c2PaymentOnOrAfterApril15KeepsDate strict {
    label en official "a chapter 3, 4, 21 or 24 tax paid on or after April 15 keeps its actual payment date";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for amount: Money;
    for paidOn: Date;
    for april15: Date;
    when is_chapter_3_4_21_or_24_return(k)
        and withholding_tax_paid_on(p, y, k, amount, paidOn)
        and april_15_of_succeeding_year(y, april15)
        and paidOn >= april15;
    then amount_paid_as_tax(p, y, k, amount, paidOn);
}
pub relation overpayment_credited_to_estimated_tax(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "an overpayment of income tax is, in accordance with section 6402(b), claimed as a credit against estimated tax for the succeeding taxable year";
}
pub relation succeeding_taxable_year(y: TaxableYear, next: TaxableYear) kind empirical {
    label en unofficial "the succeeding taxable year (a fact of the case: `us.irc.core` has no successor function, TECH-GAPS 'следующий год')";
}
@source(IRC_S6513_D, relation = formalizes, coverage = partial, quote = "such amount shall be considered as a payment of the income tax for the succeeding taxable year")
rule S6513dCreditedOverpaymentIsPaymentForSucceedingYear strict {
    label en official "an overpayment credited to estimated tax is a payment of income tax for the succeeding year, deemed paid on the last day prescribed for filing that year's return (section 6513(b)(2))";
    for p: Person;
    for y: TaxableYear;
    for next: TaxableYear;
    for amount: Money;
    for dueOn: Date;
    when overpayment_credited_to_estimated_tax(p, y, amount)
        and succeeding_taxable_year(y, next)
        and us.irc.returns::statutory_due_date(p, next, us.irc.core::IncomeCh1, dueOn);
    then amount_paid_as_tax(p, next, us.irc.core::IncomeCh1, amount, dueOn);
}
// JUDGMENT CALL: subsection (d) states no date of payment; the deemed-payment
// date is taken from (b)(2) because the credited amount is an estimated tax
// payment for the succeeding year. Recorded in the coverage row.
pub relation secretary_allows_claim_for_credited_overpayment(p: Person, y: TaxableYear, amount: Money, allowedOn: Date) kind empirical {
    label en official "a claim for credit or refund of the overpayment is allowed for the taxable year in which the overpayment arises";
}
@source(IRC_S6513_D, relation = formalizes, coverage = exact, quote = "no claim for credit or refund of such overpayment shall be allowed for the taxable year in which the overpayment arises")
pub rule S6513dNoClaimForCreditedOverpayment defeasible {
    label en official "no claim for credit or refund of an overpayment credited against estimated tax shall be allowed for the year of the overpayment";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for allowedOn: Date;
    when overpayment_credited_to_estimated_tax(p, y, amount)
        and secretary_allows_claim_for_credited_overpayment(p, y, amount, allowedOn);
    then prohibition S6513dNoClaimProhibition {
        bearer Secretary;
        beneficiary p;
        action secretary_allows_claim_for_credited_overpayment(p, y, amount, allowedOn);
        window [-infinity, infinity];
    };
}
pub relation futa_payment_under_6157(p: Person, y: TaxableYear, amount: Money, paidOn: Date) kind empirical {
    label en official "a payment of tax imposed by chapter 23 which, pursuant to section 6157, is made for a calendar quarter or other period within a calendar year";
}
@source(IRC_S6513_E, relation = formalizes, coverage = exact, quote = "if made before the last day prescribed for filing the return for the calendar year (determined without regard to any extension of time for filing), be considered made on such last day")
rule S6513eFutaPaymentBeforeReturnDueDateConsideredMadeThen strict {
    label en official "a chapter 23 payment under section 6157 made before the last day for filing the calendar-year return is considered made on that day";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for paidOn: Date;
    for dueOn: Date;
    when futa_payment_under_6157(p, y, amount, paidOn)
        and us.irc.returns::statutory_due_date(p, y, us.irc.core::FutaCh23, dueOn)
        and paidOn < dueOn;
    then amount_paid_as_tax(p, y, us.irc.core::FutaCh23, amount, dueOn);
}
rule S6513eFutaPaymentOnOrAfterDueDateKeepsDate strict {
    label en official "a chapter 23 payment made on or after the last day keeps its actual date";
    for p: Person;
    for y: TaxableYear;
    for amount: Money;
    for paidOn: Date;
    for dueOn: Date;
    when futa_payment_under_6157(p, y, amount, paidOn)
        and us.irc.returns::statutory_due_date(p, y, us.irc.core::FutaCh23, dueOn)
        and paidOn >= dueOn;
    then amount_paid_as_tax(p, y, us.irc.core::FutaCh23, amount, paidOn);
}

// ============================================================================
// §6514 — Credits or refunds after the period of limitation
// ============================================================================

pub relation refund_made_on(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind empirical {
    label en official "a refund of a portion of an internal revenue tax is made";
}
pub relation credit_made_on(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind empirical {
    label en official "a credit of a portion of an internal revenue tax is made";
}
pub relation refund_claim_period_covers(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind institutional {
    label en unofficial "some applicable claim period (base or extended) has not expired on the date of the refund or credit (existential over the derived period ends: no max-over-derived)";
}
rule S6514RefundCreditWithinSomeClaimPeriod defeasible {
    label en unofficial "the refund or credit date is on or before some applicable claim period end";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for periodEnd: Date;
    when refund_made_on(p, y, k, madeOn)
        and refund_claim_period_ends(p, y, k, periodEnd)
        and madeOn <= periodEnd;
    then refund_claim_period_covers(p, y, k, madeOn);
}
rule S6514CreditWithinSomeClaimPeriod defeasible {
    label en unofficial "the credit date is on or before some applicable claim period end";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for periodEnd: Date;
    when credit_made_on(p, y, k, madeOn)
        and refund_claim_period_ends(p, y, k, periodEnd)
        and madeOn <= periodEnd;
    then refund_claim_period_covers(p, y, k, madeOn);
}
pub relation refund_erroneous(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind institutional {
    label en official "a refund of any portion of an internal revenue tax shall be considered erroneous";
}
pub relation credit_void(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind institutional {
    label en official "a credit of any such portion shall be considered void";
}
@source(IRC_S6514_A, relation = formalizes, coverage = exact, quote = "If made after the expiration of the period of limitation for filing claim therefor, unless within such period claim was filed")
rule S6514a1RefundAfterClaimPeriodIsErroneous defeasible {
    label en official "a refund made after the expiration of the claim period, unless a claim was filed within it, is erroneous";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for someEnd: Date;
    when refund_made_on(p, y, k, madeOn)
        and refund_claim_period_ends(p, y, k, someEnd)
        and not_known(refund_claim_period_covers(p, y, k, madeOn))
        and not_known(refund_claim_timely(p, y, k));
    then refund_erroneous(p, y, k, madeOn);
}
@source(IRC_S6514_A, relation = formalizes, coverage = exact, quote = "If made after the expiration of the period of limitation for filing claim therefor, unless within such period claim was filed")
rule S6514a1CreditAfterClaimPeriodIsVoid defeasible {
    label en official "a credit made after the expiration of the claim period, unless a claim was filed within it, is void";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for someEnd: Date;
    when credit_made_on(p, y, k, madeOn)
        and refund_claim_period_ends(p, y, k, someEnd)
        and not_known(refund_claim_period_covers(p, y, k, madeOn))
        and not_known(refund_claim_timely(p, y, k));
    then credit_void(p, y, k, madeOn);
}
pub relation refund_suit_period_covers(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind institutional {
    label en unofficial "some applicable suit period has not expired on the date of the refund or credit";
}
rule S6514SuitPeriodCoversRefund defeasible {
    label en unofficial "the refund date is on or before some suit period end";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for suitEnd: Date;
    when refund_made_on(p, y, k, madeOn)
        and refund_suit_period_ends(p, y, k, suitEnd)
        and madeOn <= suitEnd;
    then refund_suit_period_covers(p, y, k, madeOn);
}
rule S6514SuitPeriodCoversCredit defeasible {
    label en unofficial "the credit date is on or before some suit period end";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for suitEnd: Date;
    when credit_made_on(p, y, k, madeOn)
        and refund_suit_period_ends(p, y, k, suitEnd)
        and madeOn <= suitEnd;
    then refund_suit_period_covers(p, y, k, madeOn);
}
@source(IRC_S6514_A, relation = formalizes, coverage = exact, quote = "if the credit or refund was made after the expiration of the period of limitation for filing suit, unless within such period suit was begun by the taxpayer")
rule S6514a2RefundAfterSuitPeriodIsErroneous defeasible {
    label en official "a refund of a timely claim that was disallowed, made after the suit period expired without a timely suit, is erroneous";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for someEnd: Date;
    when refund_made_on(p, y, k, madeOn)
        and refund_claim_timely(p, y, k)
        and refund_suit_period_ends(p, y, k, someEnd)
        and not_known(refund_suit_period_covers(p, y, k, madeOn))
        and not_known(refund_suit_window_open(p, y, k));
    then refund_erroneous(p, y, k, madeOn);
}
@source(IRC_S6514_A, relation = formalizes, coverage = exact, quote = "if the credit or refund was made after the expiration of the period of limitation for filing suit, unless within such period suit was begun by the taxpayer")
rule S6514a2CreditAfterSuitPeriodIsVoid defeasible {
    label en official "a credit of a timely disallowed claim, made after the suit period expired without a timely suit, is void";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for someEnd: Date;
    when credit_made_on(p, y, k, madeOn)
        and refund_claim_timely(p, y, k)
        and refund_suit_period_ends(p, y, k, someEnd)
        and not_known(refund_suit_period_covers(p, y, k, madeOn))
        and not_known(refund_suit_window_open(p, y, k));
    then credit_void(p, y, k, madeOn);
}
pub relation credit_against_liability(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind empirical {
    label en official "a credit against a liability in respect of a taxable year";
}
// Pending: `payment-refunds-interest` (§6401(a)) — when a payment is an
// overpayment; read as a typed institutional contract.
pub relation payment_would_be_overpayment_under_6401a(p: Person, y: TaxableYear, k: TaxKind) kind institutional {
    label en unofficial "any payment in respect of the liability would be considered an overpayment under section 6401(a) (pending: `payment-refunds-interest`, not this package's norm)";
}
@source(IRC_S6514_B, relation = formalizes, coverage = exact, quote = "Any credit against a liability in respect of any taxable year shall be void if any payment in respect of such liability would be considered an overpayment under section 6401(a).")
rule S6514bCreditVoidWhenPaymentWouldBeOverpayment defeasible {
    label en official "a credit against a liability is void if a payment in respect of that liability would be an overpayment under section 6401(a)";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    when credit_against_liability(p, y, k, madeOn)
        and payment_would_be_overpayment_under_6401a(p, y, k);
    then credit_void(p, y, k, madeOn);
}

// ============================================================================
// §6521 — Mitigation of effect of limitation: self-employment tax and FICA
// ============================================================================

pub enum SelfEmploymentOrFicaTax {
    SelfEmploymentTaxCh2;
    EmployeeFicaTax3101;
    label en unofficial "the two taxes of section 6521(a): chapter 2 self-employment tax, and the tax imposed by section 3101 on employees";
}
pub relation amount_erroneously_treated_as_se_income_or_wages(p: Person, y: TaxableYear) kind empirical {
    label en official "an amount is erroneously treated as self-employment income, or an amount is erroneously treated as wages";
}
pub relation correction_requires_assessment_of_one_and_refund_of_other(p: Person, y: TaxableYear) kind empirical {
    label en official "the correction of the error would require an assessment of one such tax and the refund or credit of the other tax";
}
pub relation correction_prevented_as_to_other_tax(p: Person, y: TaxableYear, blocked: SelfEmploymentOrFicaTax) kind empirical {
    label en official "the correction is authorized as to one such tax but prevented as to the other tax by any law or rule of law (other than section 7122)";
}
pub relation authorized_correction_amount(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the assessment, or of the credit or refund, authorized as to the tax on which correction is allowed";
}
pub relation prevented_correction_amount(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "the amount of the credit or refund, or the assessment, that would be required for the other tax if it were not prevented";
}
pub relation section_6521_conditions_met(p: Person, y: TaxableYear) kind institutional {
    label en unofficial "all three section 6521(a)(1)-(3) conditions hold";
}
@source(IRC_S6521_A, relation = formalizes, coverage = exact, quote = "If the correction of the error would require an assessment of one such tax and the refund or credit of the other tax")
rule S6521ConditionsMet defeasible {
    label en official "the error, the two-sided correction and the prevented side are all present";
    for p: Person;
    for y: TaxableYear;
    for blocked: SelfEmploymentOrFicaTax;
    when amount_erroneously_treated_as_se_income_or_wages(p, y)
        and correction_requires_assessment_of_one_and_refund_of_other(p, y)
        and correction_prevented_as_to_other_tax(p, y, blocked);
    then section_6521_conditions_met(p, y);
}
pub relation reduced_correction_amount(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the authorized assessment, credit or refund reduced by the amount that would be required for the other tax";
}
@source(IRC_S6521_A, relation = formalizes, coverage = exact, quote = "the amount of the assessment, or the amount of the credit or refund, as the case may be, authorized as to the one tax shall be reduced by the amount of the credit or refund, or the amount of the assessment, as the case may be, which would be required with respect to such other tax")
pub rule S6521ReduceAuthorizedCorrection defeasible {
    label en official "the authorized correction is reduced by the amount the prevented correction of the other tax would require";
    for p: Person;
    for y: TaxableYear;
    for authorized: Money;
    for prevented: Money;
    when section_6521_conditions_met(p, y)
        and authorized_correction_amount(p, y, authorized)
        and prevented_correction_amount(p, y, prevented);
    then reduced_correction_amount(p, y, authorized - prevented);
}
// JUDGMENT CALL: the reduction is applied as a plain difference; the text
// does not say what happens when the prevented amount exceeds the authorized
// one (a negative result is not floored; recorded in the coverage row).

// ============================================================================
// §6532(b) — Suits by the United States for recovery of erroneous refunds
// ============================================================================

external judgment relation refund_induced_by_fraud_or_misrepresentation(p: Person, y: TaxableYear, k: TaxKind) {
    authority DistrictCourt;
    label en official "any part of the refund was induced by fraud or misrepresentation of a material fact";
}
pub relation erroneous_refund_made_on(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind empirical {
    label en official "the making of the refund";
}
pub relation erroneous_refund_suit_begun(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date, beganOn: Date) kind empirical {
    label en official "a suit under section 7405 for recovery of the erroneous refund is begun";
}
pub relation erroneous_refund_suit_within_period(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date, beganOn: Date) kind institutional {
    label en unofficial "single-atom valid_when helper: the suit is begun within 2 years after the refund, or within 5 years if the refund was induced by fraud or misrepresentation";
}
@source(IRC_S6532_B, relation = formalizes, coverage = exact, quote = "Recovery of an erroneous refund by suit under section 7405 shall be allowed only if such suit is begun within 2 years after the making of such refund")
rule S6532bTwoYearsAfterRefund defeasible {
    label en official "the suit must be begun within 2 years after the making of the refund";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for beganOn: Date;
    when erroneous_refund_suit_begun(p, y, k, madeOn, beganOn)
        and beganOn <= add_calendar_period(madeOn, 2 calendar_year);
    then erroneous_refund_suit_within_period(p, y, k, madeOn, beganOn);
}
@source(IRC_S6532_B, relation = formalizes, coverage = exact, quote = "except that such suit may be brought at any time within 5 years from the making of the refund if it appears that any part of the refund was induced by fraud or misrepresentation of a material fact")
rule S6532bFiveYearsWhenInducedByFraud defeasible {
    label en official "5 years from the making of the refund if it was induced by fraud or misrepresentation of a material fact";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for beganOn: Date;
    when erroneous_refund_suit_begun(p, y, k, madeOn, beganOn)
        and refund_induced_by_fraud_or_misrepresentation(p, y, k)
        and beganOn <= add_calendar_period(madeOn, 5 calendar_year);
    then erroneous_refund_suit_within_period(p, y, k, madeOn, beganOn);
}
pub relation erroneous_refund_recovery_allowed(p: Person, y: TaxableYear, k: TaxKind, madeOn: Date) kind institutional {
    label en official "recovery of the erroneous refund by suit under section 7405 is allowed";
}
@source(IRC_S6532_B, relation = formalizes, coverage = exact, quote = "Recovery of an erroneous refund by suit under section 7405 shall be allowed only if such suit is begun")
pub rule S6532bBeginErroneousRefundSuit defeasible {
    label en official "the United States may recover an erroneous refund by suit under section 7405 only within the period";
    for p: Person;
    for y: TaxableYear;
    for k: TaxKind;
    for madeOn: Date;
    for beganOn: Date;
    when erroneous_refund_suit_begun(p, y, k, madeOn, beganOn);
    then power S6532bBeginErroneousRefundSuitPower {
        holder Secretary;
        over p;
        exercise erroneous_refund_suit_begun(p, y, k, madeOn, beganOn);
        valid_when erroneous_refund_suit_within_period(p, y, k, madeOn, beganOn);
        effect create(erroneous_refund_recovery_allowed(p, y, k, madeOn));
    };
}
