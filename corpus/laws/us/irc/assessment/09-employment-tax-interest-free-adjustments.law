// 26 U.S.C. §6205 — Special rules applicable to certain employment taxes:
// interest-free adjustments. Stage 2b (25.09.2026, coordinator instruction).
//
// SCOPE. §6205(a)(1) is modeled as a `power` (holder: the employer) — the
// employer's ability to make an interest-free adjustment of an underpaid
// employment tax (chapters 21/22/23/23A: sections 3101, 3111, 3201, 3221,
// 3402) rather than having the shortfall assessed as an ordinary
// deficiency. §6205(a)(2)-(5) ("deemed a separate employer" for the United
// States/Guam/American Samoa/D.C./States) are read as scope-widening
// definitions of WHO counts as the employer exercising the (a)(1) power,
// not separately computed events — a single `employer_for_6205_purposes`
// bridge relation lets a consumer assert any of the five without this
// package re-deriving federal/territorial/state instrumentality status.
// (b) (bond forfeiture penalty tax deposits) is NOT modeled — a narrow,
// self-contained cross-reference to chapter 22 bond amounts this package
// does not otherwise track; classified TECH_GAP.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    IRC_S6205_A,
    Person,
    TaxKind,
};

pub relation less_than_correct_amount_paid(p: Person, k: TaxKind, wagePaymentOn: Date, correctAmount: Money, actualAmount: Money) kind empirical {
    label en official "less than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid with respect to a payment of wages or compensation";
}
pub relation employer_for_6205_purposes(p: Person) kind institutional {
    label en unofficial "section 6205(a)(2)-(5): a person deemed a separate employer for section 6205(a) purposes — federal agency/instrumentality heads and their designated agents, the Governors of Guam/American Samoa, the Mayor of D.C., and State/political-subdivision agency heads, each making a return under section 3122/3125 — read as a bridge a consumer asserts directly rather than this package re-deriving federal/territorial/state instrumentality status";
}
pub relation interest_free_adjustment_made(p: Person, k: TaxKind, wagePaymentOn: Date, correctAmount: Money, actualAmount: Money, adjustedOn: Date) kind empirical {
    label en official "the employer makes the proper adjustment (without interest) with respect to both the tax and the amount to be deducted, in the manner and at the times the Secretary prescribes by regulations";
}
pub relation interest_free_adjustment_valid(p: Person, k: TaxKind, wagePaymentOn: Date) kind institutional {
    label en unofficial "helper for valid_when (single-atom compiler constraint): there was in fact a shortfall to adjust";
}
rule S6205AdjustmentConditionMet strict {
    for p: Person;
    for k: TaxKind;
    for wagePaymentOn: Date;
    for correctAmount: Money;
    for actualAmount: Money;
    when less_than_correct_amount_paid(p, k, wagePaymentOn, correctAmount, actualAmount)
        and actualAmount < correctAmount;
    then interest_free_adjustment_valid(p, k, wagePaymentOn);
}
@source(IRC_S6205_A, relation = formalizes, coverage = exact, quote = "If less than the correct amount of tax imposed by section 3101, 3111, 3201, 3221, or 3402 is paid with respect to any payment of wages or compensation, proper adjustments, with respect to both the tax and the amount to be deducted, shall be made, without interest, in such manner and at such times as the Secretary may by regulations prescribe.")
pub rule S6205InterestFreeAdjustment defeasible {
    label en official "proper adjustments, with respect to both the tax and the amount to be deducted, shall be made, without interest";
    for p: Person;
    for k: TaxKind;
    for wagePaymentOn: Date;
    for correctAmount: Money;
    for actualAmount: Money;
    for adjustedOn: Date;
    when interest_free_adjustment_made(p, k, wagePaymentOn, correctAmount, actualAmount, adjustedOn);
    then power S6205InterestFreeAdjustmentPower {
        holder p;
        over p;
        exercise interest_free_adjustment_made(p, k, wagePaymentOn, correctAmount, actualAmount, adjustedOn);
        valid_when interest_free_adjustment_valid(p, k, wagePaymentOn);
        effect create(employment_tax_adjusted_without_interest(p, k, wagePaymentOn, correctAmount));
    };
}
pub relation employment_tax_adjusted_without_interest(p: Person, k: TaxKind, wagePaymentOn: Date, correctAmount: Money) kind institutional {
    label en official "the section 6205(a)(1) interest-free adjustment took effect: the shortfall is corrected without the interest that would otherwise accrue on an ordinary deficiency";
}
// TECH_GAP: (b) (special deposit rules for chapter 22 bond forfeiture
// penalty tax) is not modeled.
