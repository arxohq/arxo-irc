// Assessment -- WIRE-10, group A (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 5703(d) (chapter 52 tax not paid in full when due): `us.irc.tobacco_firearms` formalizes the duty of the Secretary to determine and assess the omitted tax and the
// prior-notice prohibition. The machinery is here: section 6201 (power to assess, `tax_not_duly_paid`, `secretary_makes_assessment`) and section 6501 (the period). This package
// imports `tobacco_firearms` (the reverse import is a cycle: assessment -> partnerships -> accounting -> payment_refunds_interest -> alcohol -> tobacco_firearms), so it
//  - reads the omitted tax and the assessment made there as the facts that the section 6201 power reads (kind TobaccoExciseCh52), and
//  - derives the stub `tobacco_assessment_barred_by_6501` from `assessment_period_ends` for the year of the event.
//
// JUDGMENT CALLS
//  - The bar is decided against the day the duty is considered (`tobacco_assessment_considered_on`): the period end is strictly earlier than that day. The suspension and
//    no-limitation cases of module 04/05 are respected through `assessment_period_ends` itself (absent when section 6501(c) applies).
//  - Only chapter 52 (TobaccoExciseCh52) is wired; chapter 53 (firearms) is not part of section 5703(d) and stays out of this pass.

language "law.core" version "0.2";
package us.irc.assessment version "0.1.1";
namespace "urn:us:irc:assessment:clir";

use self::{
    Assessment,
    IRC_S6201_A,
    IRC_S6501_A,
    Person,
    TaxKind,
    TaxableYear,
    assessment_period_ends,
    assessment_period_unlimited,
    secretary_makes_assessment,
    tax_not_duly_paid,
};

@source(IRC_S6201_A, relation = formalizes, coverage = partial, quote = "The Secretary is authorized and required to make the inquiries, determinations, and assessments of all taxes")
rule W10ATobaccoOmittedTaxIsNotDulyPaid strict {
    label en official "section 6201(a): a chapter 52 tax omitted to be paid at the time required is a tax not duly paid";
    for e: us.irc.tobacco_firearms::TobaccoRemovalEvent;
    for p: Person;
    for y: TaxableYear;
    for omitted: Money;
    when us.irc.tobacco_firearms::tobacco_tax_omitted_from_payment(e, p, omitted)
        and us.irc.tobacco_firearms::tobacco_event_taxable_year(e, y);
    then tax_not_duly_paid(p, y, us.irc.core::TobaccoExciseCh52);
}
@source(IRC_S6201_A, relation = formalizes, coverage = partial, quote = "The Secretary is authorized and required to make the inquiries, determinations, and assessments of all taxes")
rule W10ATobaccoAssessmentIsAnAssessmentMade strict {
    label en official "section 5703(d) with section 6201(a): the assessment of the omitted chapter 52 tax is the Secretary's act of recording the assessment";
    for e: us.irc.tobacco_firearms::TobaccoRemovalEvent;
    for p: Person;
    for y: TaxableYear;
    for a: Assessment;
    for amount: Money;
    when us.irc.tobacco_firearms::tobacco_assessment_made(e, p, a, amount)
        and us.irc.tobacco_firearms::tobacco_event_taxable_year(e, y);
    then secretary_makes_assessment(a, p, y, us.irc.core::TobaccoExciseCh52, amount);
}
@source(IRC_S6501_A, relation = formalizes, coverage = partial, quote = "the amount of any tax imposed by this title shall be assessed within 3 years after the return was filed")
rule W10ATobaccoAssessmentBarredBy6501 defeasible {
    label en official "section 5703(d) subject to section 6501: the assessment is barred once the day it is considered is later than the end of the assessment period of the event's year";
    for e: us.irc.tobacco_firearms::TobaccoRemovalEvent;
    for p: Person;
    for y: TaxableYear;
    for periodEnd: Date;
    for consideredOn: Date;
    when us.irc.tobacco_firearms::tobacco_event_taxable_year(e, y)
        and us.irc.tobacco_firearms::tobacco_assessment_considered_on(e, consideredOn)
        and assessment_period_ends(p, y, us.irc.core::TobaccoExciseCh52, periodEnd)
        and periodEnd < consideredOn
        and not_known(assessment_period_unlimited(p, y, us.irc.core::TobaccoExciseCh52));
    then us.irc.tobacco_firearms::tobacco_assessment_barred_by_6501(e, p);
}
