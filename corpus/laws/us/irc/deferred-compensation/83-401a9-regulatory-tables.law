// Section 401(a)(9) regulatory tables + 401(k)/(m) regulatory delegations
// (G4-RMD wire, 27.09.2026, implemented_unverified; scenarios written,
// NOT executed; no legal review).
//
// FROM-PACKAGE: `us.cfr.t26_1_401a9` (26 CFR 1.401(a)(9)-0…-9, pinned
// eCFR 2026-09-24; tables -9 as `tables/*.lawtable.json`, structural
// mirrors, values as printed text). That package is rule-less by design:
// table values enter here as CASE-SELECTED facts (the case asserts the
// row it reads: Uniform Lifetime Table age -> divisor, Single Life Table
// age -> life expectancy), and the rules below apply the selected divisor
// as the `distribution_period` the RMD amount rule (module 02) divides by.
// Only key literals are modelled (Table 2, Table 1); the Joint and Last
// Survivor table, mortality rates (e) and applicability (f) stay
// case-asserted through the generic `distribution_period` fact.
// SSA-adjacent rows (covered compensation, PIA, SSRA, 215(i)(2)(A)
// procedure) are NOT touched by this wire.
//
// The (k)/(m) delegation rules below follow the standing pattern for
// unpinned Secretary's regulations: the regulatory permission itself is a
// case-asserted empirical fact, the statute's operative consequence is
// derived by the rule.

// =====================================================================
// (a)(9) regulatory tables: case-selected divisors (26/401/a/u31 bridge)
// =====================================================================

use self::{
    IRC_S401_A,
    IRC_S401_K,
    IRC_S401_M,
    Individual,
    Person,
    Plan,
    TaxableYear,
    distribution_period,
    excess_contributions_amount,
};

pub relation uniform_lifetime_divisor_selected(who: Individual, plan: Plan, y: TaxableYear, age: Integer, divisor: Decimal) kind empirical {
    label en unofficial "the Uniform Lifetime Table row the case selects for this employee and year: attained age -> applicable divisor (26 CFR 1.401(a)(9)-9(c), Table 2; case-asserted key literal)";
}
pub relation single_life_expectancy_selected(who: Individual, plan: Plan, y: TaxableYear, age: Integer, years: Decimal) kind empirical {
    label en unofficial "the Single Life Table row the case selects for this individual and year: age -> life expectancy (26 CFR 1.401(a)(9)-9(b), Table 1; case-asserted key literal)";
}
@source(IRC_S401_A, relation = formalizes, coverage = contextual, quote = "will be distributed, beginning not later than the required beginning date, in accordance with regulations, over the life of such employee or over the lives of such employee and a designated beneficiary (or over a period not extending beyond the life expectancy of such employee or the life expectancy of such employee and a designated beneficiary)")
rule UniformLifetimeDivisorSetsPeriod(who: Individual, plan: Plan, y: TaxableYear, age: Integer, divisor: Decimal) strict {
    label en official "the case-selected Uniform Lifetime Table divisor is the applicable distribution period for the year";
    when uniform_lifetime_divisor_selected(who, plan, y, age, divisor);
    then distribution_period(who, plan, y, divisor);
}
@source(IRC_S401_A, relation = formalizes, coverage = contextual, quote = "will be distributed, beginning not later than the required beginning date, in accordance with regulations, over the life of such employee or over the lives of such employee and a designated beneficiary (or over a period not extending beyond the life expectancy of such employee or the life expectancy of such employee and a designated beneficiary)")
rule SingleLifeExpectancySetsPeriod(who: Individual, plan: Plan, y: TaxableYear, age: Integer, years: Decimal) strict {
    label en official "the case-selected Single Life Table life expectancy is the applicable distribution period for the year";
    when single_life_expectancy_selected(who, plan, y, age, years);
    then distribution_period(who, plan, y, years);
}

// =====================================================================
// (k)(8)(A): excess-contribution recontribution election (26/401/k/8/a/u3)
// =====================================================================

pub relation regulation_permits_excess_recontribution_election(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary's regulations provide the section 401(k)(8)(A) election (treat excess contributions as distributed and recontributed) for this plan and year (EXTERNAL_DEPENDENCY, case-asserted; regulation not pinned)";
}
pub relation excess_recontribution_elected(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee elects to treat this amount of excess contributions as distributed and then contributed to the plan (case-asserted)";
}
pub relation excess_contributions_treated_as_distributed_and_recontributed(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "the excess contributions are treated as an amount distributed to the employee and then contributed by the employee to the plan (section 401(k)(8)(A))";
}
@source(IRC_S401_K, relation = formalizes, coverage = contextual, quote = "to the extent provided in regulations, the employee elects to treat the amount of the excess contributions as an amount distributed to the employee and then contributed by the employee to the plan")
rule ExcessRecontributionElectionApplies(employee: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "elected excess contributions are treated as distributed and recontributed where the regulations provide the election";
    when excess_contributions_amount(plan, y, amount)
        and regulation_permits_excess_recontribution_election(plan, y)
        and excess_recontribution_elected(employee, plan, y, amount);
    then excess_contributions_treated_as_distributed_and_recontributed(employee, plan, y, amount);
}

// =====================================================================
// (m)(9): aggregation regulations under (k) and (m) (26/401/m/9/u1)
// =====================================================================

pub relation km_aggregation_permitted_by_regulation(plan_a: Plan, plan_b: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary's regulations permit aggregating these plans and contributions for section 401(k)/(m) testing for this year (EXTERNAL_DEPENDENCY, case-asserted; regulation not pinned)";
}
pub relation km_plans_aggregated_for_testing(plan_a: Plan, plan_b: Plan, y: TaxableYear) kind institutional {
    label en official "the plans are aggregated for purposes of subsections (k) and (m) under the Secretary's regulations";
}
@source(IRC_S401_M, relation = formalizes, coverage = contextual, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out the purposes of this subsection and subsection (k), including regulations permitting appropriate aggregation of plans and contributions.")
rule KmAggregationRegulationApplies(plan_a: Plan, plan_b: Plan, y: TaxableYear) strict {
    label en official "plans are aggregated for (k)/(m) testing where the regulations permit the aggregation";
    when km_aggregation_permitted_by_regulation(plan_a, plan_b, y);
    then km_plans_aggregated_for_testing(plan_a, plan_b, y);
}
