// Section 401(a) — STAGE 2e residual, part 1 (IRC-09, DECISION-0379,
// 25.09.2026): the qualification requirements of paragraphs (1)-(16) that
// modules 02 and 15 left out — (1) purpose, (2) exclusive benefit, (5)
// deemed non-discrimination, (6) quarterly testing, (7)-(8), the
// deontic layer of (9) required distributions (the required beginning DATE,
// the administrator's distribution duties, the surviving-spouse election,
// life-payout exception, child remainder, incidental death benefits,
// multi-beneficiary trusts, the 2020 waiver, commercial annuity payments),
// (10) owner-employee and top-heavy provisions, (11) scope and exceptions,
// (12) mergers, (13)(C) offsets, (15) Social Security offsets, (16).
//
// Method. A requirement of the trust is a classification over the terms of
// the plan (empirical facts); where the Code names a person who must act
// (the plan administrator distributing by a date), a `duty` with an
// achievement goal and the statutory window carries it, so a breach is a
// VIOLATED position rather than a silent NEITHER. Absence of a
// disqualifying term is `not_known(...)`.

// =====================================================================
// (a)(1) Purpose of the contributions
// =====================================================================

use self::{
    Contribution,
    DefinedBenefitPlan,
    DefinedContributionPlan,
    Distribution,
    EligibleDesignatedBeneficiaryGround,
    IRC_S401_A,
    IRC_S415_A,
    Individual,
    Person,
    Plan,
    TaxableYear,
    db_limit_satisfied_415b,
    dc_limit_satisfied_415c,
    designated_beneficiary,
    distribution_began_before_death,
    eligible_designated_beneficiary,
    eligible_designated_beneficiary_ground,
    employee_died_on,
    participates_in,
    plan_administrator_of,
    plan_sponsor,
    post_death_distribution_deadline,
    qualified_plan_year_anchor,
    required_beginning_date_year,
    section415_limits_satisfied,
    top_heavy_plan_db,
    top_heavy_plan_dc,
};

pub enum TrustContributorKind401 {
    Employer;
    Employees;
    OtherEmployerDeductible404a3B;
    CharitableRemainderTrustQgt;
}

pub relation contribution_source_to_trust(plan: Plan, kind: TrustContributorKind401) kind empirical {
    label en unofficial "contributions are made to the trust by an employer, by employees, by another employer entitled to deduct under section 404(a)(3)(B), or by a charitable remainder trust in a qualified gratuitous transfer, case-asserted";
}

pub relation contributions_for_purpose_of_distributing_to_employees(plan: Plan) kind empirical {
    label en unofficial "the contributions are made for the purpose of distributing to the employees or their beneficiaries the corpus and income of the fund accumulated by the trust in accordance with the plan, case-asserted";
}

pub relation meets_401a1_purpose(plan: Plan) kind institutional {
    label en official "section 401(a)(1): contributions by a permitted contributor for the purpose of distributing the fund to employees or their beneficiaries";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "if contributions are made to the trust by such employer, or employees, or both, or by another employer who is entitled to deduct his contributions under section 404(a)(3)(B)")
rule Meets401a1Purpose(plan: Plan, kind: TrustContributorKind401) strict {
    label en official "a permitted contributor plus the distribution purpose";
    when contribution_source_to_trust(plan, kind) and contributions_for_purpose_of_distributing_to_employees(plan);
    then meets_401a1_purpose(plan);
}

// =====================================================================
// (a)(2) Exclusive benefit; return of mistaken contributions
// =====================================================================

pub relation diversion_possible_before_liabilities_satisfied(plan: Plan) kind empirical {
    label en unofficial "under the trust instrument some part of the corpus or income can, before all liabilities to employees and beneficiaries are satisfied, be used for or diverted to other purposes, case-asserted";
}

pub relation meets_401a2_exclusive_benefit(plan: Plan) kind institutional {
    label en official "section 401(a)(2): it is impossible under the trust instrument for any part of the corpus or income to be used for purposes other than the exclusive benefit of employees or their beneficiaries";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "if under the trust instrument it is impossible, at any time prior to the satisfaction of all liabilities with respect to employees and their beneficiaries under the trust, for any part of the corpus or income to be (within the taxable year or thereafter) used for, or diverted to, purposes other than for the exclusive benefit of his employees or their beneficiaries")
rule Meets401a2ExclusiveBenefit(plan: Plan) strict {
    label en official "holds while no diversion is possible under the instrument; a plan needs a recorded contribution source to be tested";
    when contribution_source_to_trust(plan, _) and not_known(diversion_possible_before_liabilities_satisfied(plan));
    then meets_401a2_exclusive_benefit(plan);
}

pub relation multiemployer_plan_401a2(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted";
}

pub relation contribution_returned_to_employer(plan: Plan, c: Contribution, mistake_determined_on: Date, returned_on: Date) kind empirical {
    label en unofficial "the contribution was returned to the employer after the plan administrator determined it was made by a mistake of fact or law, case-asserted (the determination date and the return date)";
}

pub relation mistake_concerns_plan_or_trust_qualification(plan: Plan, c: Contribution) kind empirical {
    label en unofficial "the mistake relates to whether the plan is described in section 401(a) or the trust is exempt under section 501(a), case-asserted";
}

pub relation return_of_contribution_permitted_401a2(plan: Plan, c: Contribution) kind institutional {
    label en official "section 401(a)(2) parenthetical: in a multiemployer plan, return within 6 months of the administrator's determination of a mistake (other than one about qualification) does not offend the exclusive-benefit rule";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "to prohibit the return of a contribution within 6 months after the plan administrator determines that the contribution was made by a mistake of fact or law")
rule ReturnOfContributionPermitted401a2(plan: Plan, c: Contribution, determined_on: Date, returned_on: Date) strict {
    label en official "exact boundary: on the 6-month date is allowed, one day later is not";
    when multiemployer_plan_401a2(plan)
        and contribution_returned_to_employer(plan, c, determined_on, returned_on)
        and returned_on <= add_calendar_period(determined_on, 6 calendar_month)
        and not_known(mistake_concerns_plan_or_trust_qualification(plan, c));
    then return_of_contribution_permitted_401a2(plan, c);
}

pub relation withdrawal_liability_overpayment_returned(plan: Plan, determined_on: Date, returned_on: Date) kind empirical {
    label en unofficial "a withdrawal liability payment determined to be an overpayment was returned, case-asserted with the determination and return dates";
}

pub relation withdrawal_liability_return_permitted_401a2(plan: Plan) kind institutional {
    label en official "section 401(a)(2) parenthetical: return of an overpaid withdrawal liability payment within 6 months of the determination";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "or the return of any withdrawal liability payment determined to be an overpayment within 6 months of such determination")
rule WithdrawalLiabilityReturnPermitted401a2(plan: Plan, determined_on: Date, returned_on: Date) strict {
    label en official "exact 6-month boundary";
    when multiemployer_plan_401a2(plan)
        and withdrawal_liability_overpayment_returned(plan, determined_on, returned_on)
        and returned_on <= add_calendar_period(determined_on, 6 calendar_month);
    then withdrawal_liability_return_permitted_401a2(plan);
}

// =====================================================================
// (a)(5) Special rules relating to nondiscrimination requirements
// =====================================================================

pub relation classification_limited_to_salaried_or_clerical(plan: Plan) kind empirical {
    label en unofficial "the plan's classification of covered employees is limited to salaried or clerical employees, case-asserted (section 401(a)(5)(A))";
}

pub relation contributions_or_benefits_uniform_to_compensation(plan: Plan) kind empirical {
    label en unofficial "the contributions or benefits bear a uniform relationship to compensation within the meaning of section 414(s), case-asserted (section 401(a)(5)(B))";
}

pub relation plan_favors_hce_only_as_401l_permits(plan: Plan) kind empirical {
    label en unofficial "the plan favors highly compensated employees only in the manner permitted under section 401(l), case-asserted (section 401(a)(5)(C); section 401(l) is in this package's queue)";
}

pub relation plan_is_governmental_414d(plan: Plan) kind empirical {
    label en unofficial "the plan is a governmental plan within the meaning of section 414(d), case-asserted";
}

pub enum Section401a5Ground {
    SalariedOrClerical;
    UniformRelationship;
    PermittedDisparity;
    IntegratedDefinedBenefit;
    SocialSecurityRetirementAge;
}

pub relation not_discriminatory_by_deeming_401a5(plan: Plan, ground: Section401a5Ground) kind institutional {
    label en official "section 401(a)(5): the plan is not considered discriminatory within paragraph (4) merely because of this ground";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A classification shall not be considered discriminatory within the meaning of paragraph (4) or section 410(b)(2)(A)(i) merely because it is limited to salaried or clerical employees.")
rule NotDiscriminatorySalariedOrClerical(plan: Plan) strict {
    label en official "(A)";
    when classification_limited_to_salaried_or_clerical(plan);
    then not_discriminatory_by_deeming_401a5(plan, SalariedOrClerical);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "merely because the contributions or benefits of, or on behalf of, the employees under the plan bear a uniform relationship to the compensation")
rule NotDiscriminatoryUniformRelationship(plan: Plan) strict {
    label en official "(B)";
    when contributions_or_benefits_uniform_to_compensation(plan);
    then not_discriminatory_by_deeming_401a5(plan, UniformRelationship);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "in the manner permitted under subsection (l)")
rule NotDiscriminatoryPermittedDisparity(plan: Plan) strict {
    label en official "(C)";
    when plan_favors_hce_only_as_401l_permits(plan);
    then not_discriminatory_by_deeming_401a5(plan, PermittedDisparity);
}

pub relation plan_uses_social_security_retirement_age(plan: Plan) kind empirical {
    label en unofficial "for testing discrimination the plan uses the social security retirement age as its retirement age, case-asserted (section 401(a)(5)(F))";
}

pub relation subsidized_benefits_based_on_ss_retirement_age(plan: Plan) kind empirical {
    label en unofficial "subsidized early retirement benefits and joint and survivor annuities are based in whole or in part on the social security retirement age, case-asserted";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the social security retirement age (as defined in section 415(b)(8)) shall be treated as a uniform retirement age")
rule SocialSecurityRetirementAgeUniform(plan: Plan) strict {
    label en official "(F)(i)-(ii): the age is treated as uniform, and benefits based on it are not treated as unavailable on the same terms";
    when plan_uses_social_security_retirement_age(plan) and subsidized_benefits_based_on_ss_retirement_age(plan);
    then not_discriminatory_by_deeming_401a5(plan, SocialSecurityRetirementAge);
}

// (D) Integrated defined benefit plan -------------------------------------

pub relation employer_derived_accrued_benefit_401a5D(plan: DefinedBenefitPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the participant's employer-derived accrued retirement benefit under the plan, an annual amount, case-asserted";
}

pub relation federal_retirement_benefit_full_service(participant: Person, amount: Money) kind empirical {
    label en unofficial "the employer-derived retirement benefit created under Federal law for a full 35 years of service with the employer, an annual amount, case-asserted";
}

pub relation service_years_with_employer_401a5D(participant: Person, years: Decimal) kind empirical {
    label en unofficial "the participant's years of service with the employer, case-asserted";
}

pub relation compensation_414q4_for_calendar_year(participant: Person, calendar_year: Integer, amount: Money) kind empirical {
    label en unofficial "the participant's compensation (section 414(q)(4)) paid by the employer for the calendar year, case-asserted";
}

pub relation separation_calendar_year(participant: Person, calendar_year: Integer) kind empirical {
    label en unofficial "the calendar year in which the participant separated from service, case-asserted";
}

pub relation final_pay_candidate(participant: Person, calendar_year: Integer, amount: Money) kind institutional {
    label en official "section 401(a)(5)(D)(ii)(I): a year ending during the 5-year period ending with the year of separation";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "which ends during the 5-year period ending with the year in which the participant separated from service for the employer")
rule FinalPayCandidate(participant: Person, n: Integer, sep: Integer, amount: Money) strict {
    label en official "exact window: the separation year and the four before it";
    when compensation_414q4_for_calendar_year(participant, n, amount)
        and separation_calendar_year(participant, sep)
        and n <= sep and n >= sep - 4;
    then final_pay_candidate(participant, n, amount);
}

pub relation final_pay_beaten(participant: Person, amount: Money) kind institutional {
    label en unofficial "helper: some candidate year has a strictly higher compensation (earliest/latest-of pattern, no strictly greater candidate)";
}

rule FinalPayBeaten(participant: Person, n1: Integer, n2: Integer, a1: Money, a2: Money) strict {
    label en unofficial "a higher candidate exists";
    when final_pay_candidate(participant, n1, a1) and final_pay_candidate(participant, n2, a2) and a2 > a1;
    then final_pay_beaten(participant, a1);
}

pub relation final_pay(participant: Person, amount: Money) kind institutional {
    label en official "section 401(a)(5)(D)(ii): the compensation for the candidate year in which total compensation from the employer was highest";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "for which the participant's total compensation from the employer was highest")
rule FinalPayHighest(participant: Person, n: Integer, amount: Money) strict {
    label en official "a candidate that no other candidate beats";
    when final_pay_candidate(participant, n, amount) and not_known(final_pay_beaten(participant, amount));
    then final_pay(participant, amount);
}

pub relation integrated_db_within_401a5D(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 401(a)(5)(D)(i): the employer-derived accrued benefit does not exceed final pay less the Federal benefit, accruing ratably over 35 years";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "For purposes of this clause, the employer-derived retirement benefit created under Federal law shall be treated as accruing ratably over 35 years.")
rule IntegratedDbWithin401a5D(plan: DefinedBenefitPlan, participant: Person, accrued: Money, fed: Money, years: Decimal, final: Money) strict {
    label en official "exact by cross-multiplication by 35: accrued x 35 <= final x 35 - fed x min(years, 35)";
    when employer_derived_accrued_benefit_401a5D(plan, participant, accrued)
        and federal_retirement_benefit_full_service(participant, fed)
        and service_years_with_employer_401a5D(participant, years)
        and final_pay(participant, final)
        and accrued * 35.0 <= final * 35.0 - fed * min(years, 35.0);
    then integrated_db_within_401a5D(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A defined benefit plan shall not be considered discriminatory within the meaning of paragraph (4) merely because the plan provides that the employer-derived accrued retirement benefit for any participant under the plan may not exceed the excess")
rule NotDiscriminatoryIntegratedDb(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(D)(i)";
    when integrated_db_within_401a5D(plan, participant);
    then not_discriminatory_by_deeming_401a5(plan, IntegratedDefinedBenefit);
}

pub relation paragraphs_3_and_4_inapplicable(plan: Plan) kind institutional {
    label en official "section 401(a)(5)(G): paragraphs (3) and (4) do not apply to a governmental plan";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "Paragraphs (3) and (4) shall not apply to a governmental plan (within the meaning of section 414(d)).")
rule Paragraphs3And4Inapplicable(plan: Plan) strict {
    label en official "governmental plans are outside the participation and nondiscrimination tests";
    when plan_is_governmental_414d(plan);
    then paragraphs_3_and_4_inapplicable(plan);
}

pub relation plans_single_plan_deduction_uniform(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contributions on behalf of employees allowed as a deduction under section 404 with respect to the plans taken together bear a uniform relationship to compensation, case-asserted (section 401(a)(5)(E)(i))";
}

pub relation plans_treated_as_nondiscriminatory_single_plan(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 401(a)(5)(E)(i): plans taken together as a single plan are not considered discriminatory";
}

@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "the plans shall not be considered discriminatory")
rule PlansTreatedAsNondiscriminatorySinglePlan(employer: Person, y: TaxableYear) strict {
    label en official "PARTIAL: clause (i) only; clause (ii) (different vesting rates) depends on regulations";
    when plans_single_plan_deduction_uniform(employer, y);
    then plans_treated_as_nondiscriminatory_single_plan(employer, y);
}

// =====================================================================
// (a)(6) Quarterly testing of paragraph (3); (a)(7); (a)(8)
// =====================================================================

pub relation satisfied_401a3_on_a_day_in_quarter(plan: Plan, y: TaxableYear, quarter: Integer) kind empirical {
    label en unofficial "on one day in this quarter (1-4) of the plan year the plan satisfied the requirements of paragraph (3), case-asserted";
}

pub relation meets_401a3_whole_year_by_quarters(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(6): the plan meets paragraph (3) for the whole taxable year if on one day in each quarter it satisfied the requirements";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A plan shall be considered as meeting the requirements of paragraph (3) during the whole of any taxable year of the plan if on one day in each quarter it satisfied such requirements.")
rule Meets401a3WholeYearByQuarters(plan: Plan, y: TaxableYear) strict {
    label en official "all four quarters need a satisfying day";
    when satisfied_401a3_on_a_day_in_quarter(plan, y, 1)
        and satisfied_401a3_on_a_day_in_quarter(plan, y, 2)
        and satisfied_401a3_on_a_day_in_quarter(plan, y, 3)
        and satisfied_401a3_on_a_day_in_quarter(plan, y, 4);
    then meets_401a3_whole_year_by_quarters(plan, y);
}

pub relation plan_satisfies_section_411(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan satisfies the minimum vesting standards of section 411, case-asserted (the plan-wide conjunction of the per-employee tests of module 11 is a universal check, section 111)";
}

pub relation meets_401a7_vesting(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(7): the plan satisfies the requirements of section 411";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A trust shall not constitute a qualified trust under this section unless the plan of which such trust is a part satisfies the requirements of section 411")
rule Meets401a7Vesting(plan: Plan, y: TaxableYear) strict {
    label en official "cross-reference to section 411";
    when plan_satisfies_section_411(plan, y);
    then meets_401a7_vesting(plan, y);
}

pub relation plan_applies_forfeitures_to_increase_benefits(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan applies forfeitures to increase the benefits any employee would otherwise receive, case-asserted";
}

pub relation meets_401a8_forfeitures(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(a)(8): the defined benefit plan provides that forfeitures must not be applied to increase benefits";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "unless the plan provides that forfeitures must not be applied to increase the benefits any employee would otherwise receive under the plan")
rule Meets401a8Forfeitures(plan: DefinedBenefitPlan, sponsor: Person) strict {
    label en official "no use of forfeitures to increase benefits";
    when plan_sponsor(plan, sponsor) and not_known(plan_applies_forfeitures_to_increase_benefits(plan));
    then meets_401a8_forfeitures(plan);
}

// =====================================================================
// (a)(9) Required distributions — the required beginning date and the
// administrator's duties
// =====================================================================

pub relation plan_is_individual_retirement_plan(plan: Plan) kind empirical {
    label en unofficial "the plan is an individual retirement account or annuity (section 408(a)(6) or (b)(3) applies in place of the retirement-year branch), case-asserted";
}

pub relation required_beginning_date(who: Individual, plan: Plan, on: Date) kind institutional {
    label en official "section 401(a)(9)(C)(i): April 1 of the calendar year following the controlling calendar year";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "The term \"required beginning date\" means April 1 of the calendar year following the later of")
rule RequiredBeginningDateFromYear(who: Individual, plan: Plan, controlling_year: Integer, y: TaxableYear, year_end: Date) strict {
    label en official "April 1 of the following year = the December 31 of the controlling calendar year plus 3 months plus 1 day (needs the IRC calendar-step policy)";
    when required_beginning_date_year(who, plan, controlling_year)
        and us.irc.core::calendar_year_of(y, controlling_year)
        and us.irc.core::ends(y, year_end);
    then required_beginning_date(who, plan, add_calendar_period(add_calendar_period(year_end, 3 calendar_month), 1 calendar_day));
}

pub relation required_interest_distribution_begun(who: Individual, plan: Plan) kind empirical {
    label en unofficial "the entire interest has been distributed, or distribution over life or life expectancy has begun, case-asserted (section 401(a)(9)(A)(i)-(ii))";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "unless the plan provides that the entire interest of each employee")
rule RequiredBeginningDateDuty(who: Individual, plan: Plan, administrator: Person, rbd: Date) strict {
    label en official "the administrator must see that the interest is distributed, or begins to be, not later than the required beginning date";
    when required_beginning_date(who, plan, rbd) and plan_administrator_of(plan, administrator);
    then duty RequiredBeginningDateDutyPosition {
        bearer administrator;
        beneficiary who;
        goal achievement {
            condition required_interest_distribution_begun(who, plan);
            window [-infinity, rbd];
        }
    };
}

pub relation entire_interest_distributed(employee: Individual, plan: Plan) kind empirical {
    label en unofficial "the employee's entire interest has been distributed, case-asserted";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the entire interest of the employee will be distributed within 5 years after the death of such employee")
rule PostDeathDistributionDuty(employee: Individual, plan: Plan, beneficiary: Person, administrator: Person, deadline: Date) strict {
    label en official "the administrator must distribute the entire interest by the post-death deadline (5 years, or 10 years for a defined contribution plan's non-eligible beneficiary)";
    when post_death_distribution_deadline(employee, plan, beneficiary, deadline) and plan_administrator_of(plan, administrator);
    then duty PostDeathDistributionDutyPosition {
        bearer administrator;
        beneficiary beneficiary;
        goal achievement {
            condition entire_interest_distributed(employee, plan);
            window [-infinity, deadline];
        }
    };
}

pub relation post_death_method_at_least_as_rapid(employee: Individual, plan: Plan) kind empirical {
    label en unofficial "after the employee's death the remaining interest is being distributed at least as rapidly as under the method used at death, case-asserted (section 401(a)(9)(B)(i))";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the remaining portion of such interest will be distributed at least as rapidly as under the method of distributions being used under subparagraph (A)(ii) as of the date of his death")
rule PostDeathContinuationDuty(employee: Individual, plan: Plan, administrator: Person, died: Date) strict {
    label en official "when distributions had begun, the remaining interest must keep at least the same pace";
    when employee_died_on(employee, plan, died) and distribution_began_before_death(employee, plan) and plan_administrator_of(plan, administrator);
    then duty PostDeathContinuationDutyPosition {
        bearer administrator;
        beneficiary employee;
        goal maintenance {
            condition post_death_method_at_least_as_rapid(employee, plan);
            window [died, infinity];
        }
    };
}

// (B)(iii)-(iv) life-payout exception and the spouse election ------------

pub relation portion_payable_over_beneficiary_life(employee: Individual, plan: Plan, beneficiary: Person) kind empirical {
    label en unofficial "a portion of the interest is payable to a designated beneficiary over the beneficiary's life or a period not beyond life expectancy, in accordance with regulations, case-asserted (section 401(a)(9)(B)(iii)(I)-(II))";
}

pub relation life_payout_begins_on(employee: Individual, plan: Plan, beneficiary: Person, on: Date) kind empirical {
    label en unofficial "the date those life-expectancy distributions begin, case-asserted";
}

pub relation life_payout_exception_applies(employee: Individual, plan: Plan, beneficiary: Person) kind institutional {
    label en official "section 401(a)(9)(B)(iii)/(H)(ii): life-expectancy payout beginning within 1 year of death (later if regulations allow) — for a defined contribution plan only for an eligible designated beneficiary";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "such distributions begin not later than 1 year after the date of the employee's death or such later date as the Secretary may by regulations prescribe")
rule LifePayoutExceptionDefinedBenefit(employee: Individual, plan: DefinedBenefitPlan, beneficiary: Person, died: Date, begins: Date) strict {
    label en official "exact boundary: beginning on the first anniversary of death qualifies";
    when employee_died_on(employee, plan, died)
        and designated_beneficiary(employee, plan, beneficiary)
        and portion_payable_over_beneficiary_life(employee, plan, beneficiary)
        and life_payout_begins_on(employee, plan, beneficiary, begins)
        and begins <= add_calendar_period(died, 1 calendar_year);
    then life_payout_exception_applies(employee, plan, beneficiary);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "Subparagraph (B)(iii) shall apply only in the case of an eligible designated beneficiary.")
rule LifePayoutExceptionDefinedContribution(employee: Individual, plan: DefinedContributionPlan, beneficiary: Person, died: Date, begins: Date) strict {
    label en official "defined contribution plan: only an eligible designated beneficiary";
    when employee_died_on(employee, plan, died)
        and eligible_designated_beneficiary(employee, plan, beneficiary)
        and portion_payable_over_beneficiary_life(employee, plan, beneficiary)
        and life_payout_begins_on(employee, plan, beneficiary, begins)
        and begins <= add_calendar_period(died, 1 calendar_year);
    then life_payout_exception_applies(employee, plan, beneficiary);
}

pub relation surviving_spouse_election_made(employee: Individual, plan: Plan, spouse: Person, on: Date) kind empirical {
    label en unofficial "the surviving spouse elects the treatment of section 401(a)(9)(B)(iv), case-asserted";
}

pub relation election_timely_notice_to_plan_administrator(employee: Individual, plan: Plan, spouse: Person) kind empirical {
    label en unofficial "the election included a timely notice to the plan administrator (made at the time and in the manner the Secretary prescribes), case-asserted";
}

pub relation spouse_treated_as_employee_401a9B4(employee: Individual, plan: Plan, spouse: Person) kind institutional {
    label en official "section 401(a)(9)(B)(iv): the surviving spouse is treated as the employee";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "If the designated beneficiary referred to in clause (iii)(I) is the surviving spouse of the employee and the surviving spouse elects the treatment in this clause")
rule SurvivingSpouseElectionPower(employee: Individual, plan: Plan, spouse: Person, on: Date) strict {
    label en official "the spouse's election; valid with a timely notice to the plan administrator; once made not revocable without the Secretary's consent (no revocation power is modelled)";
    when surviving_spouse_election_made(employee, plan, spouse, on) and designated_beneficiary(employee, plan, spouse);
    then power ElectSpouseAsEmployee {
        holder spouse;
        over plan;
        exercise surviving_spouse_election_made(employee, plan, spouse, on);
        valid_when election_timely_notice_to_plan_administrator(employee, plan, spouse);
        effect spouse_treated_as_employee_401a9B4(employee, plan, spouse);
    };
}

pub relation employee_would_attain_applicable_age_on(employee: Individual, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date on which the employee would have attained the applicable age, case-asserted";
}

pub relation spouse_distribution_start_floor(employee: Individual, plan: Plan, spouse: Person, not_before: Date) kind institutional {
    label en official "section 401(a)(9)(B)(iv)(II): with the election, distributions are not required to begin earlier than the date the employee would have attained the applicable age";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the date on which the distributions are required to begin under clause (iii)(III) shall not be earlier than the date on which the employee would have attained the applicable age")
rule SpouseDistributionStartFloor(employee: Individual, plan: Plan, spouse: Person, aged_on: Date) strict {
    label en official "the floor date";
    when spouse_treated_as_employee_401a9B4(employee, plan, spouse) and employee_would_attain_applicable_age_on(employee, plan, aged_on);
    then spouse_distribution_start_floor(employee, plan, spouse, aged_on);
}

// (D), (E)(iii), (G), (H) --------------------------------------------------

pub relation life_expectancy_redetermined_on(employee: Individual, plan: Plan, on: Date) kind empirical {
    label en unofficial "the life expectancy of the employee or spouse is redetermined on this date, case-asserted";
}

pub relation redetermination_more_often_than_annually(employee: Individual, plan: Plan) kind institutional {
    label en official "section 401(a)(9)(D): two redeterminations less than a year apart";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "may be redetermined but not more frequently than annually")
rule RedeterminationMoreOftenThanAnnually(employee: Individual, plan: Plan, d1: Date, d2: Date) strict {
    label en official "exact boundary: a second redetermination on the first anniversary is allowed, one day earlier is not";
    when life_expectancy_redetermined_on(employee, plan, d1)
        and life_expectancy_redetermined_on(employee, plan, d2)
        and d2 > d1
        and d2 < add_calendar_period(d1, 1 calendar_year);
    then redetermination_more_often_than_annually(employee, plan);
}

pub relation child_reaches_majority_on(employee: Individual, child: Person, on: Date) kind empirical {
    label en unofficial "the date the child of the employee reaches majority, case-asserted (section 401(a)(9)(F) defines majority by regulation)";
}

pub relation child_remainder_deadline(employee: Individual, plan: Plan, child: Person, deadline: Date) kind institutional {
    label en official "section 401(a)(9)(E)(iii): the child ceases to be an eligible designated beneficiary at majority and the remainder is distributed within 10 years after that date";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any remainder of the portion of the individual's interest to which subparagraph (H)(ii) applies shall be distributed within 10 years after such date")
rule ChildRemainderDeadline(employee: Individual, plan: Plan, child: Person, majority: Date) strict {
    label en official "majority date plus 10 years";
    when designated_beneficiary(employee, plan, child)
        and eligible_designated_beneficiary_ground(employee, child, MinorChild)
        and child_reaches_majority_on(employee, child, majority);
    then child_remainder_deadline(employee, plan, child, add_calendar_period(majority, 10 calendar_year));
}

pub relation incidental_death_benefit_distribution(d: Distribution, plan: Plan) kind empirical {
    label en unofficial "the distribution is required under the incidental death benefit requirements of section 401(a), case-asserted";
}

pub relation distribution_treated_as_required_under_401a9(d: Distribution) kind institutional {
    label en official "section 401(a)(9)(G): a distribution required by the incidental death benefit rule is treated as required by paragraph (9)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any distribution required under the incidental death benefit requirements of this subsection shall be treated as a distribution required under this paragraph")
rule IncidentalDeathBenefitDistributionTreatedAsRequired(d: Distribution, plan: Plan) strict {
    label en official "reclassification for all purposes of the title";
    when incidental_death_benefit_distribution(d, plan);
    then distribution_treated_as_required_under_401a9(d);
}

pub relation eligible_designated_beneficiary_died_on(employee: Individual, plan: Plan, edb: Person, on: Date) kind empirical {
    label en unofficial "an eligible designated beneficiary dies before the portion is entirely distributed, case-asserted";
}

pub relation edb_death_remainder_deadline(employee: Individual, plan: Plan, edb: Person, deadline: Date) kind institutional {
    label en official "section 401(a)(9)(H)(iii): the remainder is distributed within 10 years after the death of the eligible designated beneficiary and the exception does not pass to his beneficiaries";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the remainder of such portion shall be distributed within 10 years after the death of such eligible designated beneficiary")
rule EdbDeathRemainderDeadline(employee: Individual, plan: DefinedContributionPlan, edb: Person, died: Date) strict {
    label en official "death date plus 10 years";
    when eligible_designated_beneficiary(employee, plan, edb)
        and eligible_designated_beneficiary_died_on(employee, plan, edb, died);
    then edb_death_remainder_deadline(employee, plan, edb, add_calendar_period(died, 10 calendar_year));
}

pub entity MultiBeneficiaryTrust {
    label en unofficial "a trust named as beneficiary of an employee's interest (section 401(a)(9)(H)(v))";
}

pub relation trust_beneficiary_count(trust: MultiBeneficiaryTrust, beneficiaries: Integer) kind empirical {
    label en unofficial "the number of beneficiaries of the trust, case-asserted";
}

pub relation trust_all_beneficiaries_designated(trust: MultiBeneficiaryTrust) kind empirical {
    label en unofficial "all beneficiaries are treated as designated beneficiaries for determining the distribution period, case-asserted";
}

pub relation trust_has_disabled_or_chronically_ill_edb(trust: MultiBeneficiaryTrust) kind empirical {
    label en unofficial "at least one beneficiary is an eligible designated beneficiary under (E)(ii)(III) or (IV), case-asserted (a section 408(d)(8)(B)(i) charity counts as a (II) designated beneficiary in the (iv)(II) trust)";
}

pub relation applicable_multi_beneficiary_trust(trust: MultiBeneficiaryTrust) kind institutional {
    label en official "section 401(a)(9)(H)(v): more than one beneficiary, all designated beneficiaries, and at least one disabled or chronically ill eligible designated beneficiary";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the term \"applicable multi-beneficiary trust\" means a trust")
rule ApplicableMultiBeneficiaryTrust(trust: MultiBeneficiaryTrust, n: Integer) strict {
    label en official "(I)-(III) together";
    when trust_beneficiary_count(trust, n) and n > 1
        and trust_all_beneficiaries_designated(trust)
        and trust_has_disabled_or_chronically_ill_edb(trust);
    then applicable_multi_beneficiary_trust(trust);
}

pub relation retirement_plan_kind_defined_benefit_401a9H6(plan: Plan) kind empirical {
    label en unofficial "the eligible retirement plan is a defined benefit plan described in section 402(c)(8)(B)(iv) or (v) or a qualified trust that is part of a defined benefit plan, case-asserted";
}

pub relation eligible_retirement_plan_401a9H6(plan: Plan) kind empirical {
    label en unofficial "the plan is an eligible retirement plan within section 402(c)(8)(B), case-asserted";
}

pub relation treated_as_defined_contribution_plan_401a9H6(plan: Plan) kind institutional {
    label en official "section 401(a)(9)(H)(vi): for the amounts required to be distributed, eligible retirement plans other than the defined benefit kinds are treated as defined contribution plans";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "all eligible retirement plans (as defined in section 402(c)(8)(B), other than a defined benefit plan described in clause (iv) or (v) thereof or a qualified trust which is a part of a defined benefit plan) shall be treated as a defined contribution plan")
rule TreatedAsDefinedContributionPlan401a9H6(plan: Plan) strict {
    label en official "every eligible retirement plan except the defined benefit kinds";
    when eligible_retirement_plan_401a9H6(plan) and not_known(retirement_plan_kind_defined_benefit_401a9H6(plan));
    then treated_as_defined_contribution_plan_401a9H6(plan);
}

// (I) The 2020 waiver -----------------------------------------------------

pub relation plan_kind_waived_for_2020(plan: Plan) kind empirical {
    label en unofficial "the plan is a defined contribution plan described in subsection (a) or section 403(a) or 403(b), an eligible section 457(b) plan of a governmental employer, or an individual retirement plan, case-asserted (section 401(a)(9)(I)(i))";
}

pub relation required_distribution_waived_2020(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(9)(I): the requirements of paragraph (9) do not apply for calendar year 2020 to those plans";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "The requirements of this paragraph shall not apply for calendar year 2020 to")
rule RequiredDistributionWaived2020(plan: Plan, y: TaxableYear) strict {
    label en official "2020 only: the taxable year must be calendar year 2020";
    when plan_kind_waived_for_2020(plan) and us.irc.core::calendar_year_of(y, 2020);
    then required_distribution_waived_2020(plan, y);
}

// (J) Increases in commercial annuity payments -----------------------------

pub enum CommercialAnnuityPaymentKind401 {
    ConstantPercentageIncrease;
    LumpSumCommutation;
    LumpSumAcceleration12Months;
    DividendOrSimilar;
    FinalDeathPayment;
}

pub relation annuity_payment_after_starting_date(payment: Distribution, kind: CommercialAnnuityPaymentKind401) kind empirical {
    label en unofficial "a payment on or after the annuity starting date of a commercial annuity (section 3405(e)(6)) issued in connection with an eligible retirement plan other than a defined benefit plan, of this kind, case-asserted";
}

pub relation annuity_increase_rate_percent_per_year(payment: Distribution, rate: Decimal) kind empirical {
    label en unofficial "the constant annual percentage increase, as a percentage, case-asserted";
}

pub relation annuity_increase_applied_every_months(payment: Distribution, months: Integer) kind empirical {
    label en unofficial "the increase is applied at this interval in months, case-asserted";
}

pub relation issuer_used_reasonable_actuarial_methods_in_good_faith(payment: Distribution) kind empirical {
    label en unofficial "the issuer determined the amount using reasonable actuarial methods and assumptions in good faith (lump sum or dividend), case-asserted";
}

pub relation death_payment_amount(payment: Distribution, amount: Money) kind empirical {
    label en unofficial "the final payment upon death, case-asserted";
}

pub relation annuity_consideration_paid(payment: Distribution, amount: Money) kind empirical {
    label en unofficial "the total consideration paid for the annuity payments, case-asserted";
}

pub relation annuity_prior_distributions(payment: Distribution, amount: Money) kind empirical {
    label en unofficial "the aggregate prior distributions or payments from or under the contract, case-asserted";
}

pub relation commercial_annuity_payment_permitted_401a9J(payment: Distribution, kind: CommercialAnnuityPaymentKind401) kind institutional {
    label en official "section 401(a)(9)(J): nothing in the section prohibits these types of payment on or after the annuity starting date";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "annuity payments that increase by a constant percentage, applied not less frequently than annually, at a rate that is less than 5 percent per year")
rule CommercialAnnuityConstantIncreasePermitted(payment: Distribution, rate: Decimal, months: Integer) strict {
    label en official "exact boundary: 4.99 percent is permitted, 5 percent is not; at least annually";
    when annuity_payment_after_starting_date(payment, ConstantPercentageIncrease)
        and annuity_increase_rate_percent_per_year(payment, rate)
        and annuity_increase_applied_every_months(payment, months)
        and rate < 5.0 and months <= 12;
    then commercial_annuity_payment_permitted_401a9J(payment, ConstantPercentageIncrease);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "provided that such lump sum is determined using reasonable actuarial methods and assumptions, as determined in good faith by the issuer of the contract")
rule CommercialAnnuityCommutationPermitted(payment: Distribution) strict {
    label en official "lump sum shortening or commuting the annuity, actuarially reasonable";
    when annuity_payment_after_starting_date(payment, LumpSumCommutation) and issuer_used_reasonable_actuarial_methods_in_good_faith(payment);
    then commercial_annuity_payment_permitted_401a9J(payment, LumpSumCommutation);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "accelerates the receipt of annuity payments that are scheduled to be received within the ensuing 12 months")
rule CommercialAnnuityAccelerationPermitted(payment: Distribution) strict {
    label en official "acceleration of the next 12 months of payments";
    when annuity_payment_after_starting_date(payment, LumpSumAcceleration12Months);
    then commercial_annuity_payment_permitted_401a9J(payment, LumpSumAcceleration12Months);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "an amount which is in the nature of a dividend or similar distribution, provided that the issuer of the contract determines such amount using reasonable actuarial methods and assumptions")
rule CommercialAnnuityDividendPermitted(payment: Distribution) strict {
    label en official "dividend-type amount, actuarially reasonable";
    when annuity_payment_after_starting_date(payment, DividendOrSimilar) and issuer_used_reasonable_actuarial_methods_in_good_faith(payment);
    then commercial_annuity_payment_permitted_401a9J(payment, DividendOrSimilar);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "a final payment upon death that does not exceed the excess of the total amount of the consideration paid for the annuity payments, less the aggregate amount of prior distributions or payments from or under the contract")
rule CommercialAnnuityDeathPaymentPermitted(payment: Distribution, amount: Money, consideration: Money, prior: Money) strict {
    label en official "exact boundary: the payment may equal consideration less prior distributions";
    when annuity_payment_after_starting_date(payment, FinalDeathPayment)
        and death_payment_amount(payment, amount)
        and annuity_consideration_paid(payment, consideration)
        and annuity_prior_distributions(payment, prior)
        and amount <= consideration - prior;
    then commercial_annuity_payment_permitted_401a9J(payment, FinalDeathPayment);
}

// =====================================================================
// (a)(10) Other requirements
// =====================================================================

pub relation plan_has_owner_employees(plan: Plan) kind empirical {
    label en unofficial "the plan provides contributions or benefits for employees some of whom are owner-employees (section 401(c)(3)), case-asserted";
}

pub relation requirements_of_401d_met(plan: Plan) kind empirical {
    label en unofficial "the requirements of subsection (d) are also met, case-asserted (subsection (d) has no operative text left in the pinned edition)";
}

pub relation meets_401a10A_owner_employees(plan: Plan) kind institutional {
    label en official "section 401(a)(10)(A): a plan benefiting owner-employees qualifies only if subsection (d) is met";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "a trust forming part of such plan shall constitute a qualified trust under this section only if the requirements of subsection (d) are also met")
rule Meets401a10AWithOwnerEmployees(plan: Plan) strict {
    label en official "owner-employee plan: (d) must be met";
    when plan_has_owner_employees(plan) and requirements_of_401d_met(plan);
    then meets_401a10A_owner_employees(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "In the case of any plan which provides contributions or benefits for employees some or all of whom are owner-employees")
rule Meets401a10ANoOwnerEmployees(plan: Plan, sponsor: Person) strict {
    label en official "no owner-employee: the subparagraph is not triggered";
    when plan_sponsor(plan, sponsor) and not_known(plan_has_owner_employees(plan));
    then meets_401a10A_owner_employees(plan);
}

pub relation plan_is_top_heavy_401a10(plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: the plan is top-heavy for the year (defined benefit or defined contribution test of module 14)";
}

rule PlanIsTopHeavyDb(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en unofficial "defined benefit top-heavy test";
    when top_heavy_plan_db(plan, y);
    then plan_is_top_heavy_401a10(plan, y);
}

rule PlanIsTopHeavyDc(plan: DefinedContributionPlan, y: TaxableYear) strict {
    label en unofficial "defined contribution top-heavy test";
    when top_heavy_plan_dc(plan, y);
    then plan_is_top_heavy_401a10(plan, y);
}

pub relation section_416_requirements_met(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan meets the requirements of section 416 for the year, case-asserted";
}

pub relation plan_contains_top_heavy_contingent_provisions(plan: Plan) kind empirical {
    label en unofficial "the plan contains provisions that take effect if it becomes top-heavy and that meet section 416, case-asserted (section 401(a)(10)(B)(ii))";
}

pub relation meets_401a10B_top_heavy(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(10)(B): a top-heavy plan meets section 416, and every plan has provisions ready for the case it becomes top-heavy; governmental plans are exempt";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "In the case of any top-heavy plan, a trust forming part of such plan shall constitute a qualified trust under this section only if the requirements of section 416 are met.")
rule Meets401a10BTopHeavyMet(plan: Plan, y: TaxableYear) strict {
    label en official "top-heavy and section 416 met, with the contingent provisions in place";
    when plan_is_top_heavy_401a10(plan, y)
        and section_416_requirements_met(plan, y)
        and plan_contains_top_heavy_contingent_provisions(plan);
    then meets_401a10B_top_heavy(plan, y);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "Except to the extent provided in regulations, a trust forming part of a plan (whether or not a top-heavy plan) shall constitute a qualified trust under this section only if such plan contains provisions")
rule Meets401a10BNotTopHeavy(plan: Plan, y: TaxableYear) strict {
    label en official "not top-heavy: only the contingent provisions are required";
    when qualified_plan_year_anchor(plan, y)
        and plan_contains_top_heavy_contingent_provisions(plan)
        and not_known(plan_is_top_heavy_401a10(plan, y));
    then meets_401a10B_top_heavy(plan, y);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "This subparagraph shall not apply to any governmental plan.")
rule Meets401a10BGovernmental(plan: Plan, y: TaxableYear) strict {
    label en official "governmental plans are outside subparagraph (B)";
    when qualified_plan_year_anchor(plan, y) and plan_is_governmental_414d(plan);
    then meets_401a10B_top_heavy(plan, y);
}

// =====================================================================
// (a)(11) Scope and exceptions
// =====================================================================

pub relation dc_plan_subject_to_412_funding(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the defined contribution plan is subject to the funding standards of section 412, case-asserted";
}

pub relation dc_plan_pays_full_benefit_to_spouse_on_death(plan: DefinedContributionPlan, participant: Person) kind empirical {
    label en unofficial "the plan provides that the participant's nonforfeitable accrued benefit (reduced by loan security) is payable in full on death to the surviving spouse or, with consent under section 417(a)(2), a designated beneficiary, case-asserted (section 401(a)(11)(B)(iii)(I))";
}

pub relation participant_elects_life_annuity(participant: Person) kind empirical {
    label en unofficial "the participant elects payment in the form of a life annuity, case-asserted (section 401(a)(11)(B)(iii)(II))";
}

pub relation plan_is_transferee_after_1984(plan: DefinedContributionPlan, participant: Person) kind empirical {
    label en unofficial "the plan is a direct or indirect transferee, in a transfer after December 31, 1984, of a plan described in (B)(i) or (ii) or to which (B)(iii) applied with respect to the participant (limited to the transferred assets if separately accounted), case-asserted";
}

pub relation paragraph_11_applies(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(11)(B): the survivor annuity requirements apply to a defined benefit plan, a defined contribution plan subject to section 412, and a participant under another defined contribution plan unless all of (I)-(III) hold";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any defined benefit plan")
rule Paragraph11AppliesDefinedBenefit(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(B)(i)";
    when participates_in(participant, plan);
    then paragraph_11_applies(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any defined contribution plan which is subject to the funding standards of section 412")
rule Paragraph11AppliesFundedDc(plan: DefinedContributionPlan, participant: Person) strict {
    label en official "(B)(ii)";
    when participates_in(participant, plan) and dc_plan_subject_to_412_funding(plan);
    then paragraph_11_applies(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any participant under any other defined contribution plan unless")
rule Paragraph11AppliesOtherDcNoFullPayout(plan: DefinedContributionPlan, participant: Person) strict {
    label en official "(B)(iii): applies when (I) fails";
    when participates_in(participant, plan) and not_known(dc_plan_pays_full_benefit_to_spouse_on_death(plan, participant));
    then paragraph_11_applies(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "such participant does not elect a payment of benefits in the form of a life annuity")
rule Paragraph11AppliesOtherDcLifeAnnuity(plan: DefinedContributionPlan, participant: Person) strict {
    label en official "(B)(iii): applies when (II) fails";
    when participates_in(participant, plan) and participant_elects_life_annuity(participant);
    then paragraph_11_applies(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "such plan is not a direct or indirect transferee (in a transfer after December 31, 1984)")
rule Paragraph11AppliesOtherDcTransferee(plan: DefinedContributionPlan, participant: Person) strict {
    label en official "(B)(iii): applies when (III) fails";
    when participates_in(participant, plan) and plan_is_transferee_after_1984(plan, participant);
    then paragraph_11_applies(plan, participant);
}

pub relation esop_for_paragraph_11C(plan: Plan) kind empirical {
    label en unofficial "the plan is a tax credit employee stock ownership plan (section 409(a)) or an employee stock ownership plan (section 4975(e)(7)), case-asserted";
}

pub relation accrued_benefit_subject_to_409h(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the participant's accrued benefit portion to which the requirements of section 409(h) apply, case-asserted";
}

pub relation esop_portion_exempt_from_paragraph_11A(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(11)(C): subparagraph (A) does not apply to the ESOP portion subject to section 409(h), when (B)(iii)(I)-(III) are met for the participant";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "subparagraph (A) shall not apply to that portion of the employee's accrued benefit to which the requirements of section 409(h) apply")
rule EsopPortionExemptFromParagraph11A(plan: DefinedContributionPlan, participant: Person) strict {
    label en official "(C)(i) with the (C)(ii) condition that (I)-(III) are met (full payout to spouse, no life annuity election, not a transferee)";
    when esop_for_paragraph_11C(plan)
        and accrued_benefit_subject_to_409h(plan, participant)
        and dc_plan_pays_full_benefit_to_spouse_on_death(plan, participant)
        and not_known(participant_elects_life_annuity(participant))
        and not_known(plan_is_transferee_after_1984(plan, participant));
    then esop_portion_exempt_from_paragraph_11A(plan, participant);
}

pub relation married_throughout_year_ending_earlier_of_asd_or_death(participant: Person, spouse: Person) kind empirical {
    label en unofficial "the participant and spouse were married throughout the 1-year period ending on the earlier of the annuity starting date or the participant's death, case-asserted";
}

pub relation spousal_benefit_marriage_condition_allowed(plan: Plan, participant: Person, spouse: Person) kind institutional {
    label en official "section 401(a)(11)(D): the plan may deny survivor benefits unless the marriage lasted a year; that condition alone is not a failure of (B)(iii) or (C)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "merely because the plan provides that benefits will not be payable to the surviving spouse of the participant unless the participant and such spouse had been married throughout the 1-year period")
rule SpousalBenefitMarriageConditionAllowed(plan: Plan, participant: Person, spouse: Person) strict {
    label en official "the one-year marriage condition is permitted";
    when plan_provides_one_year_marriage_condition(plan) and participates_in(participant, plan)
        and married_throughout_year_ending_earlier_of_asd_or_death(participant, spouse);
    then spousal_benefit_marriage_condition_allowed(plan, participant, spouse);
}

pub relation plan_provides_one_year_marriage_condition(plan: Plan) kind empirical {
    label en unofficial "the plan denies the surviving spouse's benefit unless married for the 1-year period, case-asserted";
}

pub relation plan_described_in_404c_pre_1976(plan: Plan) kind empirical {
    label en unofficial "the Secretary has determined the plan is described in section 404(c) (or a continuation) with participation substantially limited to individuals who ceased covered employment before January 1, 1976, case-asserted";
}

pub relation paragraph_11_inapplicable_404c_plan(plan: Plan) kind institutional {
    label en official "section 401(a)(11)(E): the paragraph does not apply to such a plan";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to a plan which the Secretary has determined is a plan described in section 404(c)")
rule Paragraph11Inapplicable404cPlan(plan: Plan) strict {
    label en official "the Secretary's determination is a fact of record";
    when plan_described_in_404c_pre_1976(plan);
    then paragraph_11_inapplicable_404c_plan(plan);
}

// =====================================================================
// (a)(12) Mergers and transfers; (a)(13)(C) offsets; (a)(15); (a)(16)
// =====================================================================

pub relation merger_or_transfer_after_1974(plan: Plan, on: Date) kind empirical {
    label en unofficial "a merger or consolidation with, or transfer of assets or liabilities to, another plan occurs on this date, case-asserted";
}

pub relation benefit_if_terminated_before_merger(plan: Plan, participant: Person, on: Date, amount: Money) kind empirical {
    label en unofficial "the benefit the participant would have been entitled to if the plan had terminated immediately before the transaction, case-asserted";
}

pub relation benefit_if_terminated_after_merger(plan: Plan, participant: Person, on: Date, amount: Money) kind empirical {
    label en unofficial "the benefit the participant would receive if the plan then terminated immediately after the transaction, case-asserted";
}

pub relation merger_protection_met(plan: Plan, participant: Person, on: Date) kind institutional {
    label en official "section 401(a)(12): after the transaction the participant's benefit is equal to or greater than before";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "each participant in the plan would (if the plan then terminated) receive a benefit immediately after the merger, consolidation, or transfer which is equal to or greater than the benefit he would have been entitled to receive immediately before")
rule MergerProtectionMet(plan: Plan, participant: Person, on: Date, before: Money, after: Money) strict {
    label en official "exact: after >= before; only for transactions after September 2, 1974";
    when merger_or_transfer_after_1974(plan, on)
        and on > @1974-09-02
        and benefit_if_terminated_before_merger(plan, participant, on, before)
        and benefit_if_terminated_after_merger(plan, participant, on, after)
        and after >= before;
    then merger_protection_met(plan, participant, on);
}

pub relation offset_from_judgment_or_settlement(plan: Plan, participant: Person, amount: Money) kind empirical {
    label en unofficial "an offset of the participant's benefits against an amount he is ordered or required to pay to the plan, case-asserted";
}

pub enum OffsetSource401a13C {
    CriminalJudgment;
    ErisaCivilJudgment;
    LaborOrPbgcSettlement;
}

pub relation offset_source(plan: Plan, participant: Person, src: OffsetSource401a13C) kind empirical {
    label en unofficial "the order or requirement to pay arises under a judgment of conviction for a crime involving the plan, a civil judgment under ERISA part 4 of subtitle B of title I, or a settlement with the Secretary of Labor or the PBGC, case-asserted";
}

pub relation order_expressly_provides_offset(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the judgment, order, decree or settlement expressly provides for the offset, case-asserted";
}

pub relation participant_has_spouse_at_offset(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the participant has a spouse at the time the offset is made and section 401(a)(11) applies, case-asserted";
}

pub relation spouse_protection_401a13C3(plan: Plan, participant: Person) kind empirical {
    label en unofficial "one of (iii)(I) written witnessed consent or waiver in effect, (II) spouse ordered to pay in the same action, or (III) spouse retains the survivor annuity rights, case-asserted";
}

pub relation offset_permitted_401a13C(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(13)(C): the offset is not an assignment or alienation, and does not make the plan fail the section, section 401(k), 403(b) or 409(d)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to any offset of a participant's benefits provided under a plan against an amount that the participant is ordered or required to pay to the plan if")
rule OffsetPermitted401a13C(plan: Plan, participant: Person, src: OffsetSource401a13C, amount: Money) strict {
    label en official "source (i), express offset (ii), and spousal protection (iii) when there is a spouse";
    when offset_from_judgment_or_settlement(plan, participant, amount)
        and offset_source(plan, participant, src)
        and order_expressly_provides_offset(plan, participant)
        and not_known(participant_has_spouse_at_offset(plan, participant));
    then offset_permitted_401a13C(plan, participant);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "if the participant has a spouse at the time at which the offset is to be made")
rule OffsetPermitted401a13CWithSpouse(plan: Plan, participant: Person, src: OffsetSource401a13C, amount: Money) strict {
    label en official "with a spouse the (iii) protection is also required";
    when offset_from_judgment_or_settlement(plan, participant, amount)
        and offset_source(plan, participant, src)
        and order_expressly_provides_offset(plan, participant)
        and participant_has_spouse_at_offset(plan, participant)
        and spouse_protection_401a13C3(plan, participant);
    then offset_permitted_401a13C(plan, participant);
}

pub relation benefit_decreased_by_ss_increase(plan: Plan, participant: Person, increase_took_effect_on: Date, first_receipt_or_separation_on: Date) kind empirical {
    label en unofficial "a benefit of a participant receiving benefits (or separated with nonforfeitable rights) is decreased by reason of an increase in Social Security benefit levels or the wage base taking effect on the first date, with the earlier of first receipt or separation on the second, case-asserted";
}

pub relation ss_offset_violation_401a15(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(15): a decrease by reason of a Social Security increase that took effect after September 2, 1974 (or, if later, the earlier of first receipt or separation)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "such benefits are not decreased by reason of any increase in the benefit levels payable under title II of the Social Security Act or any increase in the wage base under such title II")
rule SsOffsetViolation401a15(plan: Plan, participant: Person, increase_on: Date, anchor_on: Date) strict {
    label en official "increase after September 2, 1974 and after the later-of anchor date";
    when benefit_decreased_by_ss_increase(plan, participant, increase_on, anchor_on)
        and increase_on > @1974-09-02
        and increase_on > anchor_on;
    then ss_offset_violation_401a15(plan, participant);
}

pub relation meets_401a15_ss_offsets(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(15): the plan's benefits are not decreased by reason of Social Security increases";
}

rule Meets401a15(plan: Plan, participant: Person) strict {
    label en unofficial "no violation for a participant of the plan";
    when participates_in(participant, plan) and not_known(ss_offset_violation_401a15(plan, participant));
    then meets_401a15_ss_offsets(plan, participant);
}

@source(IRC_S415_A, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan, the plan provides for the payment of benefits with respect to a participant which exceed the limitation of subsection (b)")
rule Section415LimitsSatisfiedDb(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) defeasible {
    label en official "section 401(a)(16) reads the final section 415(b) test for a defined benefit participant";
    when db_limit_satisfied_415b(plan, participant, y);
    then section415_limits_satisfied(plan, participant, y);
}

@source(IRC_S415_A, relation = formalizes, coverage = exact, quote = "in the case of a defined contribution plan, contributions and other additions under the plan with respect to any participant for any taxable year exceed the limitation of subsection (c)")
rule Section415LimitsSatisfiedDc(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) defeasible {
    label en official "section 401(a)(16) reads the final section 415(c) test for a defined contribution participant";
    when dc_limit_satisfied_415c(plan, participant, y);
    then section415_limits_satisfied(plan, participant, y);
}
