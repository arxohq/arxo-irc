// Shared ontology for Subchapter D (retirement arrangements): plan/trust
// shapes, participant role, contribution/distribution/election entities used
// across 401, 401(k)/(m), 402, 402A, 404, 408, 408A, 409A, 410, 411, 414,
// 415, 416, 417. Stage 1 (IRC-09), DECISION-0379.
//
// Method (task instruction): "a plan/arrangement is an entity with its terms
// case-asserted; qualification is a classification over the requirements."
// `Plan` is the case-asserted entity; `DefinedBenefitPlan`/
// `DefinedContributionPlan` are the two structural subtypes the Code
// distinguishes throughout (401(a)(9)(H), 411(a)(2), 415(b)/(c), 416(g)(1)).
// The qualified-trust fiction of section 401(a) ("A trust ... shall
// constitute a qualified trust") is modelled as a classification of the
// PLAN (not a separate `Trust` entity from `us.irc.core`, which already
// supplies `Trust : Person` for the section 7701(a) sense of "trust" as a
// taxpayer): the section 401(a) trust is the plan's own funding vehicle, and
// what the qualification requirements test is the terms of the PLAN.

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type OwnershipInterest = us.irc.core::OwnershipInterest;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;

const Secretary: Organ = us.irc.core::Secretary;

// Employer/employee membership uses `us.irc.core::Employer`/`::Employee`
// role facts directly (`has_role(p, us.irc.core::Employer, ctx, window)`)
// where a rule needs the role test; most rules below take "employer"/
// "employee" as ordinary named `Person` parameters, matching the convention
// of `us.irc.employment` (that package's wage-tax rules do the same).

// --- Plan and its structural kind -------------------------------------------

pub entity Plan {
    label en unofficial "a stock bonus, pension, or profit-sharing plan of an employer (section 401(a))";
}

pub entity DefinedBenefitPlan : Plan {
    label en unofficial "a plan under which benefits are determined by a formula rather than an account balance";
}

pub entity DefinedContributionPlan : Plan {
    label en unofficial "a plan under which each participant has an individual account credited with contributions, forfeitures and earnings (section 414(i))";
}

pub relation plan_sponsor(plan: Plan, employer: Person) kind institutional {
    label en unofficial "the employer maintaining this plan";
}

pub entity Participant {
    label en unofficial "an employee (or former employee) participating in a plan";
}

pub relation participates_in(who: Person, plan: Plan) kind empirical {
    label en unofficial "this person is a participant in this plan (case-asserted)";
}

// --- Contribution ------------------------------------------------------------

pub enum ContributionKind {
    EmployerNonelective;
    EmployerMatching;
    ElectiveDeferral;
    RothElectiveDeferral;
    AfterTaxEmployee;
    Rollover;
}

pub entity Contribution {
    label en unofficial "an amount contributed to a plan on behalf of a participant";
}

pub relation contribution(c: Contribution, plan: Plan, participant: Person, y: TaxableYear, kind: ContributionKind, amount: Money) kind empirical {
    label en unofficial "a contribution of this kind and amount, case-asserted";
}

// --- Distribution ------------------------------------------------------------

pub entity Distribution {
    label en unofficial "an amount paid or distributed out of a plan to a distributee";
}

pub relation distribution(d: Distribution, plan: Plan, distributee: Person, amount: Money, on: Date) kind empirical {
    label en unofficial "a distribution of this amount on this date, case-asserted";
}

// --- Election ------------------------------------------------------------------

pub entity Election {
    label en unofficial "a participant's or beneficiary's election under the plan (deferral, rollover, waiver, distribution timing)";
}

pub relation election_made_on(e: Election, by: Person, on: Date) kind empirical {
    label en unofficial "the date on which this election was made, case-asserted";
}

// --- Attained age (shared helper: many Subchapter D thresholds turn on the
// participant's age on a given date; the Code never gives an "age" term
// directly, only birth-date-derived facts). Modelled as a case-asserted
// empirical fact per individual/date pair rather than a computed function,
// because the standard term library (core-surfaces.md) has no birthdate-to-
// age primitive; recording the derived age at the relevant date is the
// scenario author's job, not a hidden computation.
pub relation age_on(who: Individual, on: Date, years: Integer) kind empirical {
    label en unofficial "this individual's age in completed years on this date, case-asserted (no birthdate-to-age standard term exists; TECH_GAP if a rule needs to derive it from a birth date instead of reading it directly)";
}
