// Section 411 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 11 carries the vesting schedules, the DC accrued benefit, the anti-cutback
// classification and the consent rules. This module adds the service rules of
// (a)(4)-(6) (years of service, breaks, the rule of parity, parental-leave
// hours), the accrued benefit of (a)(7) and (c), normal retirement age and
// benefit of (a)(8)-(9), the vesting schedule amendment protection of (a)(10),
// the accrual rule of (b)(2), the plan-termination vesting and the
// anti-cutback additions of (d), and the plans excluded by (e).
//
// Method: hours are integers; a period of service is a case-asserted
// 12-month period with its hours; thresholds are exact boundaries (1,000
// hours completes a year, 500 hours or fewer is a break, the parity period is
// the greater of 5 years and the earlier service). Dates use exact calendar
// arithmetic.

// =====================================================================
// (a)(5), (a)(6) Years of service and breaks in service
// =====================================================================

use self::{
    DefinedContributionPlan,
    IRC_S411_A,
    IRC_S411_B,
    IRC_S411_C,
    IRC_S411_D,
    IRC_S411_E,
    Person,
    Plan,
    TaxableYear,
    church_plan_414e,
    governmental_plan_414d,
    plan_sponsor,
};

pub relation service_period_hours_411(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) kind empirical {
    label en unofficial "the hours of service the employee completes in the plan's 12-consecutive-month computation period, case-asserted (section 411(a)(5), (6))";
}

pub relation year_of_service_411a5(employee: Person, plan: Plan, period: TaxableYear) kind institutional {
    label en official "section 411(a)(5)(A): a computation period in which the participant completed 1,000 hours of service";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "during which the participant has completed 1,000 hours of service")
rule YearOfService411a5(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) strict {
    label en official "exact boundary: 1,000 hours completes a year, 999 does not";
    when service_period_hours_411(employee, plan, period, hours) and hours >= 1000;
    then year_of_service_411a5(employee, plan, period);
}

pub relation maritime_days_of_service_411(employee: Person, plan: Plan, period: TaxableYear, days: Integer) kind empirical {
    label en unofficial "the days of service in a maritime industry, case-asserted (section 411(a)(5)(D))";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of any maritime industry, 125 days of service shall be treated as")
rule YearOfServiceMaritime411a5D(employee: Person, plan: Plan, period: TaxableYear, days: Integer) strict {
    label en official "125 days of service in a maritime industry equal a year of service (1,000 hours)";
    when maritime_days_of_service_411(employee, plan, period, days) and days >= 125;
    then year_of_service_411a5(employee, plan, period);
}

pub relation one_year_break_in_service_411a6(employee: Person, plan: Plan, period: TaxableYear) kind institutional {
    label en official "section 411(a)(6)(A): a computation period in which the participant has not completed more than 500 hours of service";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "during which the participant has not completed more than 500 hours of service")
rule OneYearBreakInService411a6(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) strict {
    label en official "exact boundary: 500 hours is a break, 501 is not";
    when service_period_hours_411(employee, plan, period, hours) and hours <= 500;
    then one_year_break_in_service_411a6(employee, plan, period);
}

pub relation year_of_service_after_return_411a6b(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee completed a year of service after returning from a one-year break, case-asserted";
}

pub relation service_before_break_may_be_disregarded_411a6b(employee: Person, plan: Plan, break_period: TaxableYear) kind institutional {
    label en official "section 411(a)(6)(B): years of service before a one-year break need not be taken into account until the employee completes a year of service after the return";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service before such break shall not be required to be taken into account until he has completed a year of service after his return")
rule ServiceBeforeBreakDisregarded411a6b(employee: Person, plan: Plan, break_period: TaxableYear) strict {
    label en official "the disregard ends once a year of service after the return is completed";
    when one_year_break_in_service_411a6(employee, plan, break_period) and not_known(year_of_service_after_return_411a6b(employee, plan));
    then service_before_break_may_be_disregarded_411a6b(employee, plan, break_period);
}

pub relation consecutive_one_year_breaks_411(employee: Person, plan: Plan, count: Integer) kind empirical {
    label en unofficial "the number of consecutive 1-year breaks in service, case-asserted";
}

pub relation dc_or_insured_db_plan_411a6c(plan: Plan) kind empirical {
    label en unofficial "the plan is a defined contribution plan or an insured defined benefit plan meeting section 411(b)(1)(F), case-asserted";
}

pub relation service_after_five_breaks_may_be_disregarded_411a6c(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(6)(C): after 5 consecutive 1-year breaks, later service need not be counted for the percentage of the benefit accrued before the breaks";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "who has 5 consecutive 1-year breaks in service")
rule ServiceAfterFiveBreaks411a6c(employee: Person, plan: Plan, breaks: Integer) strict {
    label en official "exact boundary: 5 consecutive breaks";
    when dc_or_insured_db_plan_411a6c(plan) and consecutive_one_year_breaks_411(employee, plan, breaks) and breaks >= 5;
    then service_after_five_breaks_may_be_disregarded_411a6c(employee, plan);
}

pub relation service_years_before_breaks_411a6d(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the aggregate years of service before the period of consecutive breaks, case-asserted";
}

pub relation participant_nonvested_411a6d(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the participant has no nonforfeitable right to an accrued benefit derived from employer contributions, case-asserted ((d)(iii))";
}

pub relation service_before_breaks_disregarded_by_parity_411a6d(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(6)(D)(i): the years of service of a nonvested participant before a period of consecutive breaks need not be counted when the period equals or exceeds the greater of 5 years and the aggregate earlier years";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a nonvested participant, years of service with the employer or employers maintaining the plan before any period of consecutive 1-year breaks in service shall not be required to be taken into account")
rule ParityRule411a6d(employee: Person, plan: Plan, breaks: Integer, before: Integer) strict {
    label en official "exact boundaries: the breaks equal or exceed 5 and equal or exceed the earlier service";
    when participant_nonvested_411a6d(employee, plan)
        and consecutive_one_year_breaks_411(employee, plan, breaks)
        and service_years_before_breaks_411a6d(employee, plan, before)
        and breaks >= 5
        and breaks >= before;
    then service_before_breaks_disregarded_by_parity_411a6d(employee, plan);
}

pub relation parental_leave_normal_hours_411a6e(employee: Person, plan: Plan, hours: Integer) kind empirical {
    label en unofficial "the hours of service that would normally have been credited but for the absence for pregnancy, birth, adoption placement or care of the child, case-asserted (section 411(a)(6)(E)(ii)(I))";
}

pub relation parental_leave_absence_days_411a6e(employee: Person, plan: Plan, days: Integer) kind empirical {
    label en unofficial "the days of the absence, used when the plan cannot determine the normal hours, case-asserted ((ii)(II))";
}

pub relation parental_leave_hours_credited_411a6e(employee: Person, plan: Plan, hours: Integer) kind institutional {
    label en official "section 411(a)(6)(E)(ii): the hours treated as hours of service for the break test, capped at 501 hours";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "except that the total number of hours treated as hours of service under this clause by reason of any such pregnancy or placement shall not exceed 501 hours")
rule ParentalLeaveHoursNormal411a6e(employee: Person, plan: Plan, normal: Integer) strict {
    label en official "the normally credited hours, at most 501";
    when parental_leave_normal_hours_411a6e(employee, plan, normal);
    then parental_leave_hours_credited_411a6e(employee, plan, min(normal, 501));
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "8 hours of service per day of absence")
rule ParentalLeaveHoursByDay411a6e(employee: Person, plan: Plan, days: Integer) strict {
    label en official "8 hours per day of absence when the normal hours cannot be determined, at most 501; only in that case";
    when parental_leave_absence_days_411a6e(employee, plan, days) and not_known(parental_leave_hours_determinable_411a6e(employee, plan));
    then parental_leave_hours_credited_411a6e(employee, plan, min(days * 8, 501));
}

pub relation parental_leave_hours_determinable_411a6e(employee: Person, plan: Plan) kind institutional {
    label en unofficial "helper: the normal hours are determinable (asserted)";
}

rule ParentalLeaveHoursDeterminable411a6e(employee: Person, plan: Plan, normal: Integer) strict {
    label en unofficial "derives the helper";
    when parental_leave_normal_hours_411a6e(employee, plan, normal);
    then parental_leave_hours_determinable_411a6e(employee, plan);
}

// =====================================================================
// (a)(4) Service that need not be taken into account
// =====================================================================

pub relation service_year_start_age_411(employee: Person, plan: Plan, period: TaxableYear, age: Integer) kind empirical {
    label en unofficial "the employee's age at the start of the service year, case-asserted";
}

pub relation service_year_ends_on_411(employee: Person, plan: Plan, period: TaxableYear, on: Date) kind empirical {
    label en unofficial "the last day of the service year, case-asserted";
}

pub relation employee_declined_to_contribute_411(employee: Person, plan: Plan, period: TaxableYear) kind empirical {
    label en unofficial "the employee declined to contribute to a plan requiring employee contributions during the period, case-asserted ((4)(B))";
}

pub relation employer_did_not_maintain_plan_411(employee: Person, plan: Plan, period: TaxableYear) kind empirical {
    label en unofficial "the employer did not maintain the plan or a predecessor during the period, case-asserted ((4)(C))";
}

pub relation three_years_of_service_after_1970_411(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee has at least 3 years of service after December 31, 1970, case-asserted ((4)(E))";
}

pub relation service_year_excludable_411a4(employee: Person, plan: Plan, period: TaxableYear) kind institutional {
    label en official "section 411(a)(4): the service year need not be taken into account in computing the nonforfeitable percentage";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service before age 18")
rule ServiceYearExcludableBeforeAge18(employee: Person, plan: Plan, period: TaxableYear, age: Integer) strict {
    label en official "(A): exact boundary: age 17 at the start of the year is under 18, age 18 is not";
    when service_year_start_age_411(employee, plan, period, age) and age < 18;
    then service_year_excludable_411a4(employee, plan, period);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service during a period for which the employee declined to contribute to a plan requiring employee contributions")
rule ServiceYearExcludableDeclinedContribution(employee: Person, plan: Plan, period: TaxableYear) strict {
    label en official "(B)";
    when employee_declined_to_contribute_411(employee, plan, period);
    then service_year_excludable_411a4(employee, plan, period);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service with an employer during any period for which the employer did not maintain the plan or a predecessor plan")
rule ServiceYearExcludableNoPlan(employee: Person, plan: Plan, period: TaxableYear) strict {
    label en official "(C)";
    when employer_did_not_maintain_plan_411(employee, plan, period);
    then service_year_excludable_411a4(employee, plan, period);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service before January 1, 1971, unless the employee has had at least 3 years of service after December 31, 1970")
rule ServiceYearExcludableBefore1971(employee: Person, plan: Plan, period: TaxableYear, ends: Date) strict {
    label en official "(E): a service year ending before 1971-01-01 is excludable unless the employee has 3 years of service after 1970";
    when service_year_ends_on_411(employee, plan, period, ends)
        and ends < @1971-01-01
        and not_known(three_years_of_service_after_1970_411(employee, plan));
    then service_year_excludable_411a4(employee, plan, period);
}

// =====================================================================
// (a)(7), (c) Accrued benefit
// =====================================================================

pub relation total_accrued_benefit_411c(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the employee's accrued benefit as of the applicable date, case-asserted (section 411(c)(1))";
}

pub relation accrued_benefit_from_employee_contributions_411c(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the accrued benefit derived from contributions made by the employee, case-asserted";
}

pub relation accrued_benefit_from_employer_contributions_411c1(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(c)(1): the excess of the accrued benefit over the part derived from the employee's own contributions";
}

@source(IRC_S411_C, relation = formalizes, coverage = exact, quote = "is the excess, if any, of the accrued benefit for such employee as of such applicable date over the accrued benefit derived from contributions made by such employee as of such date")
rule AccruedBenefitFromEmployerContributions411c1(employee: Person, plan: Plan, total: Money, own: Money) strict {
    label en official "total - own, floored at zero";
    when total_accrued_benefit_411c(employee, plan, total) and accrued_benefit_from_employee_contributions_411c(employee, plan, own);
    then accrued_benefit_from_employer_contributions_411c1(employee, plan, max(total - own, 0.00 USD));
}

pub relation prior_distribution_amount_and_present_value_411a7(employee: Person, plan: Plan, distributed: Money, present_value: Money) kind empirical {
    label en unofficial "the distribution received and the present value of the accrued benefit at the time, case-asserted (section 411(a)(7)(C)(i))";
}

pub relation employee_resumed_covered_employment_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the employee resumes employment covered under the plan, case-asserted ((C)(ii))";
}

pub relation repayment_made_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the employee repays the full amount of the distribution (with interest for a defined benefit plan), case-asserted ((C)(iii))";
}

pub relation repayment_of_withdrawal_at_separation_411a7c(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the distribution was a withdrawal on account of separation from service, case-asserted ((C) closing sentence, (I))";
}

pub relation first_reemployed_on_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first date after the withdrawal the participant is re-employed by the employer, case-asserted";
}

pub relation five_break_period_closed_on_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the close of the first period of 5 consecutive 1-year breaks commencing after the withdrawal, case-asserted";
}

pub relation withdrawal_date_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the withdrawal, case-asserted";
}

pub relation repayment_deadline_411a7c(employee: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 411(a)(7)(C): the last day for a repayment the plan may require (separation: the earlier of 5 years after re-employment and the close of the first 5-break period; otherwise 5 years after the withdrawal)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "before the earlier of 5 years after the first date on which the participant is subsequently re-employed by the employer, or the close of the first period of 5 consecutive 1-year breaks in service commencing after the withdrawal")
rule RepaymentDeadlineSeparation411a7c(employee: Person, plan: Plan, reemployed: Date, closed: Date) strict {
    label en official "earlier of the two dates";
    when repayment_of_withdrawal_at_separation_411a7c(employee, plan)
        and first_reemployed_on_411a7c(employee, plan, reemployed)
        and five_break_period_closed_on_411a7c(employee, plan, closed);
    then repayment_deadline_411a7c(employee, plan, min(add_calendar_period(reemployed, 5 calendar_year), closed));
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "(II) in the case of any other withdrawal, 5 years after the date of the withdrawal")
rule RepaymentDeadlineOther411a7c(employee: Person, plan: Plan, withdrawn: Date) strict {
    label en official "5 years after the withdrawal";
    when withdrawal_date_411a7c(employee, plan, withdrawn) and not_known(repayment_of_withdrawal_at_separation_411a7c(employee, plan));
    then repayment_deadline_411a7c(employee, plan, add_calendar_period(withdrawn, 5 calendar_year));
}

pub relation repayment_timely_411a7c(employee: Person, plan: Plan) kind institutional {
    label en official "the repayment is made on or before the plan's repayment deadline, after the participant resumes covered employment";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "repays the full amount of such distribution with, in the case of a defined benefit plan, interest at the rate determined for purposes of subsection (c)(2)(C)")
rule RepaymentTimely411a7c(employee: Person, plan: Plan, made: Date, deadline: Date, resumed: Date) strict {
    label en official "exact boundary: the deadline day is in time";
    when repayment_made_411a7c(employee, plan, made)
        and repayment_deadline_411a7c(employee, plan, deadline)
        and employee_resumed_covered_employment_411a7c(employee, plan, resumed)
        and made >= resumed
        and made <= deadline;
    then repayment_timely_411a7c(employee, plan);
}

pub relation accrued_benefit_recomputed_with_prior_service_411a7c(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(7)(C): on a timely repayment the accrued benefit is recomputed taking the disregarded service into account";
}

pub relation employee_repays_distribution_411a7c(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the employee exercises the repayment right on this date, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "provides an opportunity for the participant to repay the full amount of the distribution")
rule RepaymentRightPower411a7c(employee: Person, plan: Plan, on: Date, sponsor: Person) strict {
    label en official "PARTIAL: the participant's repayment right; the plan's duty to offer it is the position below; the interest rate is (c)(2)(C)";
    when employee_repays_distribution_411a7c(employee, plan, on) and plan_sponsor(plan, sponsor);
    then power RepayDistribution411a7c {
        holder employee;
        over sponsor;
        exercise employee_repays_distribution_411a7c(employee, plan, on);
        valid_when repayment_timely_411a7c(employee, plan);
        effect accrued_benefit_recomputed_with_prior_service_411a7c(employee, plan);
    };
}

pub relation plan_offers_repayment_opportunity_411a7c(plan: Plan) kind empirical {
    label en unofficial "the plan provides the opportunity to repay a distribution and recompute the accrued benefit, case-asserted";
}

pub relation plan_disregards_service_after_distribution_411a7b(plan: Plan) kind empirical {
    label en unofficial "the plan disregards service after a distribution as (a)(7)(B) permits, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the plan may not disregard service as provided in subparagraph (B) unless the plan provides an opportunity for the participant to repay")
rule RepaymentOpportunityDuty411a7c(plan: Plan, sponsor: Person) strict {
    label en official "a plan that disregards service after a distribution must offer the repayment opportunity";
    when plan_disregards_service_after_distribution_411a7b(plan) and plan_sponsor(plan, sponsor);
    then duty OfferRepaymentOpportunityDuty {
        bearer sponsor;
        beneficiary sponsor;
        goal maintenance {
            condition plan_offers_repayment_opportunity_411a7c(plan);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// (a)(8), (a)(9) Normal retirement age and benefit
// =====================================================================

pub relation plan_normal_retirement_date_411a8(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the participant attains the normal retirement age under the plan, case-asserted (section 411(a)(8)(A))";
}

pub relation birth_date_411(employee: Person, born: Date) kind empirical {
    label en unofficial "the employee's date of birth, case-asserted";
}

pub relation participation_commenced_on_411(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the participant commenced participation in the plan, case-asserted";
}

pub relation normal_retirement_date_411a8(employee: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 411(a)(8): the earlier of the plan's normal retirement age and the later of age 65 and the 5th anniversary of participation";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the term \"normal retirement age\" means the earlier of")
rule NormalRetirementDate411a8(employee: Person, plan: Plan, plan_date: Date, born: Date, start: Date) strict {
    label en official "min(plan date, max(65th birthday, 5th anniversary of participation)), exact dates";
    when plan_normal_retirement_date_411a8(employee, plan, plan_date)
        and birth_date_411(employee, born)
        and participation_commenced_on_411(employee, plan, start);
    then normal_retirement_date_411a8(employee, plan, min(plan_date, max(add_calendar_period(born, 65 calendar_year), add_calendar_period(start, 5 calendar_year))));
}

pub relation early_retirement_benefit_411a9(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the early retirement benefit under the plan, determined without regard to medical benefits and unreduced disability benefits, case-asserted";
}

pub relation benefit_at_normal_retirement_age_411a9(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the benefit under the plan commencing at normal retirement age, case-asserted";
}

pub relation normal_retirement_benefit_411a9(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(a)(9): the greater of the early retirement benefit and the benefit commencing at normal retirement age";
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "the term \"normal retirement benefit\" means the greater of the early retirement benefit under the plan, or the benefit under the plan commencing at normal retirement age")
rule NormalRetirementBenefit411a9(employee: Person, plan: Plan, early: Money, at_nra: Money) strict {
    label en official "PARTIAL: max of the two amounts; the exclusions of medical benefits and disability benefits above the qualified disability benefit are inside the asserted amounts";
    when early_retirement_benefit_411a9(employee, plan, early) and benefit_at_normal_retirement_age_411a9(employee, plan, at_nra);
    then normal_retirement_benefit_411a9(employee, plan, max(early, at_nra));
}

// =====================================================================
// (a)(10) Amendment of a vesting schedule
// =====================================================================

pub relation percentage_after_amendment_411a10(employee: Person, plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the nonforfeitable percentage under the amended schedule as of the later of adoption and effectiveness, case-asserted";
}

pub relation percentage_without_amendment_411a10(employee: Person, plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the nonforfeitable percentage computed without the amendment, case-asserted";
}

pub relation vesting_amendment_fails_411a10a(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(10)(A): an amendment changing a vesting schedule fails (a)(2) if any participant's percentage becomes less than under the old schedule";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "is less than such nonforfeitable percentage computed under the plan without regard to such amendment")
rule VestingAmendmentFails411a10a(employee: Person, plan: Plan, after: Decimal, before: Decimal) strict {
    label en official "exact boundary: an equal percentage does not fail";
    when percentage_after_amendment_411a10(employee, plan, after) and percentage_without_amendment_411a10(employee, plan, before) and after < before;
    then vesting_amendment_fails_411a10a(employee, plan);
}

pub relation employee_years_of_service_at_amendment_411a10(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the participant's years of service, case-asserted";
}

pub relation election_within_reasonable_period_411a10b(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the election is made within a reasonable period after the adoption of the amendment, case-asserted (INTERPRETATION: the period is a judgment supplied by the case)";
}

pub relation old_schedule_election_available_411a10b(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(10)(B): a participant with at least 3 years of service may elect the old schedule within a reasonable period";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "each participant having not less than 3 years of service is permitted to elect, within a reasonable period after the adoption of such amendment")
rule OldScheduleElectionAvailable411a10b(employee: Person, plan: Plan, years: Integer) strict {
    label en official "exact boundary: 3 years";
    when employee_years_of_service_at_amendment_411a10(employee, plan, years) and years >= 3 and election_within_reasonable_period_411a10b(employee, plan);
    then old_schedule_election_available_411a10b(employee, plan);
}

pub relation old_schedule_election_made_411a10b(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the participant elects the old schedule, case-asserted";
}

pub relation old_schedule_applies_411a10b(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(10)(B): the participant's nonforfeitable percentage is computed without regard to the amendment";
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "to have his nonforfeitable percentage computed under the plan without regard to such amendment")
rule ElectOldScheduleSchedulePower411a10b(employee: Person, plan: Plan, on: Date, sponsor: Person) strict {
    label en official "PARTIAL: the election is the participant's power; validity needs 3 years of service and a reasonable period";
    when old_schedule_election_made_411a10b(employee, plan, on) and plan_sponsor(plan, sponsor);
    then power ElectOldVestingSchedule {
        holder employee;
        over sponsor;
        exercise old_schedule_election_made_411a10b(employee, plan, on);
        valid_when old_schedule_election_available_411a10b(employee, plan);
        effect old_schedule_applies_411a10b(employee, plan);
    };
}

// =====================================================================
// (b)(2) Age-neutral allocations; (d)(3) termination; (e) excluded plans
// =====================================================================

pub relation dc_allocations_ceased_or_reduced_because_of_age_411b2(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "allocations to an employee's account cease or are reduced because of the attainment of any age, case-asserted";
}

pub relation dc_plan_meets_411b2(plan: DefinedContributionPlan) kind institutional {
    label en official "section 411(b)(2)(A): a defined contribution plan whose allocations do not cease or reduce because of age";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "allocations to the employee's account are not ceased, and the rate at which amounts are allocated to the employee's account is not reduced, because of the attainment of any age")
rule DcPlanMeets411b2(plan: DefinedContributionPlan) strict {
    label en official "the absence of an age-based cessation or reduction";
    when plan_sponsor(plan, _) and not_known(dc_allocations_ceased_or_reduced_because_of_age_411b2(plan));
    then dc_plan_meets_411b2(plan);
}

pub relation plan_terminated_or_partially_411d3(plan: Plan, on: Date) kind empirical {
    label en unofficial "the plan terminates, partially terminates, or (for a plan outside section 412) completely discontinues contributions, case-asserted (section 411(d)(3))";
}

pub relation employee_affected_by_termination_411d3(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is affected by the termination, partial termination or discontinuance, case-asserted";
}

pub relation affected_employee_fully_vested_411d3(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(d)(3): the rights of all affected employees to benefits accrued to the date of termination are nonforfeitable, to the extent funded";
}

@source(IRC_S411_D, relation = formalizes, coverage = partial, quote = "the rights of all affected employees to benefits accrued to the date of such termination, partial termination, or discontinuance, to the extent funded as of such date, or the amounts credited to the employees' accounts, are nonforfeitable")
rule AffectedEmployeeFullyVested411d3(employee: Person, plan: Plan, on: Date) strict {
    label en official "PARTIAL: the consequence is recorded; the extent of funding is not derived";
    when plan_terminated_or_partially_411d3(plan, on) and employee_affected_by_termination_411d3(employee, plan);
    then affected_employee_fully_vested_411d3(employee, plan);
}

pub relation church_plan_without_412_election_411e(plan: Plan) kind empirical {
    label en unofficial "the church plan has no election under section 410(d) in effect, case-asserted (section 411(e)(1)(B))";
}

pub relation plan_without_employer_contributions_since_1974_411e(plan: Plan) kind empirical {
    label en unofficial "the plan has not at any time after September 2, 1974 provided for employer contributions, case-asserted ((C))";
}

pub relation fraternal_society_plan_411e(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained by a society, order or association described in section 501(c)(8) or (9), no part of whose benefits is provided by employer contributions from employers of the participants, case-asserted ((D))";
}

pub relation section_411_inapplicable_411e1(plan: Plan) kind institutional {
    label en official "section 411(e)(1): the section (other than paragraph (2)) does not apply to a governmental plan, a church plan without the election, a plan with no employer contributions since September 2, 1974, or a qualifying society plan";
}

@source(IRC_S411_E, relation = formalizes, coverage = exact, quote = "a governmental plan (within the meaning of section 414(d))")
rule Section411InapplicableGovernmental(plan: Plan) strict {
    label en official "(A), through the section 414(d) classification of module 28";
    when governmental_plan_414d(plan);
    then section_411_inapplicable_411e1(plan);
}

@source(IRC_S411_E, relation = formalizes, coverage = exact, quote = "a church plan (within the meaning of section 414(e)) with respect to which the election provided by section 410(d) has not been made")
rule Section411InapplicableChurch(plan: Plan) strict {
    label en official "(B), through the section 414(e) classification of module 28";
    when church_plan_414e(plan) and church_plan_without_412_election_411e(plan);
    then section_411_inapplicable_411e1(plan);
}

@source(IRC_S411_E, relation = formalizes, coverage = exact, quote = "a plan which has not, at any time after September 2, 1974, provided for employer contributions")
rule Section411InapplicableNoEmployerContributions(plan: Plan) strict {
    label en official "(C)";
    when plan_without_employer_contributions_since_1974_411e(plan);
    then section_411_inapplicable_411e1(plan);
}

@source(IRC_S411_E, relation = formalizes, coverage = partial, quote = "a plan established and maintained by a society, order, or association described in section 501(c)(8) or (9)")
rule Section411InapplicableSociety(plan: Plan) strict {
    label en official "PARTIAL: (D); the condition on employer-provided benefits is inside the asserted fact";
    when fraternal_society_plan_411e(plan);
    then section_411_inapplicable_411e1(plan);
}

// =====================================================================
// (d)(6) Reduction of accrued benefits by amendment; DC transfers
// =====================================================================

pub relation amendment_eliminates_or_reduces_subsidy_411d6(plan: Plan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment eliminates or reduces an early retirement benefit or retirement-type subsidy, or eliminates an optional form of benefit, for benefits attributable to service before the amendment, case-asserted (section 411(d)(6)(B))";
}

pub relation amendment_treated_as_reducing_accrued_benefits_411d6B(plan: Plan, adopted_on: Date) kind institutional {
    label en official "section 411(d)(6)(B): such an amendment is treated as reducing accrued benefits";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "with respect to benefits attributable to service before the amendment shall be treated as reducing accrued benefits")
rule AmendmentTreatedAsReducing411d6B(plan: Plan, adopted_on: Date) strict {
    label en official "the elimination of a subsidy or an optional form counts as a reduction";
    when amendment_eliminates_or_reduces_subsidy_411d6(plan, adopted_on);
    then amendment_treated_as_reducing_accrued_benefits_411d6B(plan, adopted_on);
}

pub relation dc_transfer_forms_previously_available_411d6d(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the forms of distribution previously available under the transferor plan apply to the transferred account, case-asserted ((D)(i)(I))";
}

pub relation dc_transfer_plans_authorize_411d6d(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the terms of both plans authorize the transfer, case-asserted ((II))";
}

pub relation dc_transfer_voluntary_election_411d6d(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the transfer was made under a voluntary election, case-asserted ((III))";
}

pub relation dc_transfer_notice_before_election_411d6d(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the election was made after the participant received a notice describing the consequences, case-asserted ((IV))";
}

pub relation dc_transfer_allows_distribution_411d6d(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the transferee plan allows a distribution in a single sum or otherwise at the time the transferor plan would have, case-asserted ((V))";
}

pub relation dc_transferee_plan_not_reducing_411d6d(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(d)(6)(D)(i): the transferee defined contribution plan is not treated as reducing accrued benefits when all five conditions hold";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to meet the requirements of this paragraph merely because")
rule DcTransfereeNotReducing411d6d(plan: Plan, participant: Person) strict {
    label en official "(I)-(V) all required";
    when dc_transfer_forms_previously_available_411d6d(plan, participant)
        and dc_transfer_plans_authorize_411d6d(plan, participant)
        and dc_transfer_voluntary_election_411d6d(plan, participant)
        and dc_transfer_notice_before_election_411d6d(plan, participant)
        and dc_transfer_allows_distribution_411d6d(plan, participant);
    then dc_transferee_plan_not_reducing_411d6d(plan, participant);
}

pub relation dc_plan_single_sum_same_time_411d6e(plan: Plan, participant: Person) kind empirical {
    label en unofficial "a single sum payment is available at the same time or times as the eliminated form and is based on the same or greater portion of the account, case-asserted ((E)(i), (ii))";
}

pub relation dc_plan_elimination_of_form_permitted_411d6e(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(d)(6)(E): a defined contribution plan may eliminate a form of distribution if an equivalent single sum is available";
}

@source(IRC_S411_D, relation = formalizes, coverage = partial, quote = "a defined contribution plan shall not be treated as failing to meet the requirements of this section merely because of the elimination of a form of distribution previously available thereunder")
rule DcEliminationPermitted411d6e(plan: Plan, participant: Person) strict {
    label en official "PARTIAL: the single-sum condition; the regulatory limits are not pinned";
    when dc_plan_single_sum_same_time_411d6e(plan, participant);
    then dc_plan_elimination_of_form_permitted_411d6e(plan, participant);
}
