// Sections 404A, 406/407, 414A, 418E and 421-424 residual sentences — STAGE 3c
// (deferred-compensation, last TECH_GAP pass, 26.09.2026). Facts asserted by
// the case produce a treatment relation; duties and powers carry the deontic
// content of the sentences. Multi-year ledgers are unrolled to depth 1 (the
// previous year's balance is a case fact). Regulations the text delegates to
// the Secretary are not pinned and are supplied by the case.

// =====================================================================
// 404A(a), (c)(1), (d), (g): foreign plans
// =====================================================================

use self::{
    CompensatoryOptionPlan,
    IRC_S404A_A,
    IRC_S404A_C,
    IRC_S404A_D,
    IRC_S404A_G,
    IRC_S406_B,
    IRC_S406_D,
    IRC_S407_D,
    IRC_S414A_C,
    IRC_S418E_C,
    IRC_S418E_D,
    IRC_S418E_E,
    IRC_S418E_F,
    IRC_S421_C,
    IRC_S422_C,
    IRC_S423_B,
    IRC_S423_C,
    IRC_S424_A,
    IRC_S424_C,
    Individual,
    MultiemployerPlan,
    Person,
    Plan,
    StockOption,
    TaxableYear,
    TransferKind424,
    contribution_on_behalf_of_treated_employee_406d,
    contribution_on_behalf_of_treated_employee_407d,
    excess_resources_418Ec4B,
    multiemployer_plan_sponsor_432,
    plan_may_exclude_employee_423b4,
    qualified_foreign_plan_404Ae,
    qualified_reserve_plan_404Af2,
    resource_benefit_level_and_basic_418E,
    resource_benefit_level_determined_in_writing_418Ed3,
    retroactive_distribution_ceiling_418Ec5,
    selected_rate_within_permissible_range_404Ag3Biii,
    stock_transfer_424c,
    subsection_a_applies_as_if_by_decedent_421c1,
    total_compensation_for_american_employer_406b2A,
    total_compensation_for_parent_407b2,
    treated_as_employee_of_american_employer_406a,
};

pub relation foreign_plan_amount_paid_or_accrued_404Aa(plan: Plan, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount paid or accrued by the employer under a qualified foreign plan for the year, case-asserted";
}

pub relation otherwise_deductible_404Aa(plan: Plan, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the amount would otherwise be deductible under this chapter, case-asserted";
}

pub relation properly_taken_into_account_year_404Aa(plan: Plan, y: TaxableYear, taxable_year: TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the amounts paid or accrued for the year are properly taken into account under section 404A, case-asserted";
}

pub relation foreign_plan_amount_not_deductible_elsewhere_404Aa1(plan: Plan, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(a)(1): the amount is not allowable as a deduction under this chapter (other than under section 404A)";
}

pub relation foreign_plan_amount_deductible_under_404A_404Aa2(plan: Plan, employer: Person, deduction_year: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(a)(2): if otherwise deductible, the amount is allowed as a deduction under section 404A for the year in which it is properly taken into account";
}

@source(IRC_S404A_A, relation = formalizes, coverage = exact, quote = "(1) shall not be allowable as a deduction under this chapter, but")
rule ForeignPlanAmountNotDeductibleElsewhere404Aa1(plan: Plan, employer: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "gated by the qualified foreign plan status of module 38";
    when qualified_foreign_plan_404Ae(plan, y)
        and foreign_plan_amount_paid_or_accrued_404Aa(plan, employer, y, amount);
    then foreign_plan_amount_not_deductible_elsewhere_404Aa1(plan, employer, y, amount);
}

@source(IRC_S404A_A, relation = formalizes, coverage = exact, quote = "(2) if they would otherwise be deductible, shall be allowed as a deduction under this section for")
rule ForeignPlanAmountDeductibleUnder404A404Aa2(plan: Plan, employer: Person, y: TaxableYear, d: TaxableYear, amount: Money) defeasible {
    label en official "otherwise deductible amounts, in the year they are properly taken into account (module 38 amount rules fix the amount per year)";
    when qualified_foreign_plan_404Ae(plan, y)
        and foreign_plan_amount_paid_or_accrued_404Aa(plan, employer, y, amount)
        and otherwise_deductible_404Aa(plan, employer, y)
        and properly_taken_into_account_year_404Aa(plan, y, d);
    then foreign_plan_amount_deductible_under_404A_404Aa2(plan, employer, d, amount);
}

external judgment relation reserve_addition_reasonable_404Ac1(plan: Plan, y: TaxableYear) {
    authority Secretary;
    label en official "section 404A(c)(1): the addition for the year to the reserve for the taxpayer's liability is reasonable under the unit credit method modified by paragraphs (3) and (4) — an actuarial and evaluative determination, not computed by this package";
}

pub relation reserve_ledger_facts_404Ac1(plan: Plan, y: TaxableYear, reserve_at_start: Money, proposed_addition: Money, benefits_paid: Money) kind empirical {
    label en unofficial "the reserve at the start of the year (depth 1: the previous year's closing balance), the proposed addition and the benefits paid under the plan in the year, case-asserted";
}

pub relation amount_properly_taken_into_account_404Ac1(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(c)(1): for a qualified reserve plan the amount taken into account is the reasonable addition to the reserve";
}

pub relation reserve_at_end_of_year_404Ac1(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(c)(1): all benefits paid under the plan are charged to the reserve";
}

@source(IRC_S404A_C, relation = formalizes, coverage = partial, quote = "In the case of a qualified reserve plan, the amount properly taken into account for the taxable")
rule AmountTakenIntoAccountIsReasonableAddition404Ac1(plan: Plan, y: TaxableYear, start: Money, addition: Money, paid: Money) defeasible {
    label en official "PARTIAL/EVALUATIVE (DECISION-0194): the reasonableness is the Secretary's judgment channel; the unit credit method itself is not recomputed";
    when qualified_reserve_plan_404Af2(plan, y)
        and reserve_ledger_facts_404Ac1(plan, y, start, addition, paid)
        and reserve_addition_reasonable_404Ac1(plan, y);
    then amount_properly_taken_into_account_404Ac1(plan, y, addition);
}

@source(IRC_S404A_C, relation = formalizes, coverage = partial, quote = "In the case of a qualified reserve plan, the amount properly taken into account for the taxable")
rule BenefitsPaidChargedToReserve404Ac1(plan: Plan, y: TaxableYear, start: Money, addition: Money, paid: Money) defeasible {
    label en official "JUDGMENT CALL: closing reserve = opening + addition - benefits paid, no floor at zero (the text sets none)";
    when qualified_reserve_plan_404Af2(plan, y)
        and reserve_ledger_facts_404Ac1(plan, y, start, addition, paid)
        and reserve_addition_reasonable_404Ac1(plan, y);
    then reserve_at_end_of_year_404Ac1(plan, y, start + addition - paid);
}

pub relation cumulative_amount_facts_404Ad2(plan: Plan, y: TaxableYear, prior_cumulative_us_amount: Money, amount_for_year_without_paragraph_1: Money, prior_cumulative_foreign_amount: Money, foreign_deduction_for_year: Money) kind empirical {
    label en unofficial "the cumulative United States amount and cumulative foreign amount through the prior year (depth 1), and the year's amount without regard to paragraph (1) and the year's foreign deduction, case-asserted";
}

pub relation cumulative_us_amount_computed_404Ad2A(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(d)(2)(A): the aggregate amount determined under this section for the year and all prior years, each year without regard to paragraph (1)";
}

pub relation cumulative_foreign_amount_computed_404Ad2B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(d)(2)(B): the aggregate amount allowed as a deduction under the appropriate foreign tax laws for the year and all prior years";
}

@source(IRC_S404A_D, relation = formalizes, coverage = exact, quote = "The term \"cumulative United States amount\" means the aggregate amount determined with respect to")
rule CumulativeUsAmountComputed404Ad2A(plan: Plan, y: TaxableYear, prior: Money, current: Money, pf: Money, cf: Money) strict {
    label en official "prior cumulative plus the year's amount (bounded ledger, depth 1)";
    when cumulative_amount_facts_404Ad2(plan, y, prior, current, pf, cf);
    then cumulative_us_amount_computed_404Ad2A(plan, y, prior + current);
}

@source(IRC_S404A_D, relation = formalizes, coverage = exact, quote = "The term \"cumulative foreign amount\" means the aggregate amount allowed as a deduction under the")
rule CumulativeForeignAmountComputed404Ad2B(plan: Plan, y: TaxableYear, pu: Money, current: Money, prior: Money, foreign: Money) strict {
    label en official "prior cumulative plus the year's foreign deduction (bounded ledger, depth 1)";
    when cumulative_amount_facts_404Ad2(plan, y, pu, current, prior, foreign);
    then cumulative_foreign_amount_computed_404Ad2B(plan, y, prior + foreign);
}

pub relation foreign_corporation_earnings_facts_404Ad3(plan: Plan, y: TaxableYear, amount_under_paragraph_1: Money, deduction_under_foreign_law: Money) kind empirical {
    label en unofficial "for a foreign corporation's earnings and profits and accumulated profits: the amount determined under paragraph (1) and the amount allowed as a deduction under the appropriate foreign tax laws for the year, case-asserted";
}

pub relation amount_for_earnings_and_profits_404Ad3(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(d)(3): the amount taken into account may in no event exceed the amount allowed as a deduction under foreign tax laws for the year (except as regulations provide)";
}

@source(IRC_S404A_D, relation = formalizes, coverage = exact, quote = "In determining the earnings and profits and accumulated profits of any foreign corporation with")
rule AmountForEarningsAndProfits404Ad3(plan: Plan, y: TaxableYear, amount: Money, foreign: Money) strict {
    label en official "the lesser of the two; exact boundary: equal amounts give that amount";
    when foreign_corporation_earnings_facts_404Ad3(plan, y, amount, foreign);
    then amount_for_earnings_and_profits_404Ad3(plan, y, min(amount, foreign));
}

pub relation foreign_deduction_adjustment_facts_404Ag2B(taxpayer: Person, secretary: Person, y: TaxableYear, adjusted_on: Date, notice_due_by: Date) kind empirical {
    label en unofficial "the deduction under foreign tax law was adjusted on this date; the date prescribed by regulations by which the taxpayer must notify the Secretary (not pinned; supplied by the case), case-asserted";
}

pub relation secretary_notified_of_adjustment_404Ag2B(taxpayer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer notified the Secretary of the adjustment, case-asserted (goal atom)";
}

pub relation taxpayer_notified_secretary_on_404Ag2B(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the Secretary was notified, case-asserted";
}

pub relation tax_redetermined_for_affected_years_404Ag2B(taxpayer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary redetermined the amount of the tax for the year or years affected, case-asserted (goal atom)";
}

@source(IRC_S404A_G, relation = formalizes, coverage = partial, quote = "If the deduction under foreign tax law is adjusted, the taxpayer shall notify the Secretary of such")
rule NotifySecretaryOfForeignDeductionAdjustment404Ag2B(taxpayer: Person, secretary: Person, y: TaxableYear, adjusted: Date, due: Date) strict {
    label en official "PARTIAL: the duty of the taxpayer, due by the date prescribed by regulations; the analogy to section 905(c) is an unresolved dependency recorded in the deps file (section 905(c) is in us.irc.international, not imported)";
    when foreign_deduction_adjustment_facts_404Ag2B(taxpayer, secretary, y, adjusted, due);
    then duty NotifySecretaryOfForeignDeductionAdjustmentDuty {
        bearer taxpayer;
        beneficiary secretary;
        goal achievement {
            condition secretary_notified_of_adjustment_404Ag2B(taxpayer, y);
            window [adjusted, due];
        }
    };
}

@source(IRC_S404A_G, relation = formalizes, coverage = partial, quote = "If the deduction under foreign tax law is adjusted, the taxpayer shall notify the Secretary of such")
rule RedetermineTaxAfterNotice404Ag2B(taxpayer: Person, secretary: Person, y: TaxableYear, adjusted: Date, due: Date, on: Date) strict {
    label en official "PARTIAL: the duty of the Secretary to redetermine the tax for the year or years affected, once notified; no time limit in the text";
    when foreign_deduction_adjustment_facts_404Ag2B(taxpayer, secretary, y, adjusted, due)
        and taxpayer_notified_secretary_on_404Ag2B(taxpayer, y, on);
    then duty RedetermineTaxDuty {
        bearer secretary;
        beneficiary taxpayer;
        goal achievement {
            condition tax_redetermined_for_affected_years_404Ag2B(taxpayer, y);
            window [on, infinity];
        }
    };
}

pub relation rate_selection_exercise_404Ag3Bi(taxpayer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer selects a rate of interest for the qualified reserve plan, case-asserted (exercise atom)";
}

pub relation rate_selected_by_taxpayer_404Ag3Bi(taxpayer: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(3)(B)(i): the rate selected by the taxpayer is the rate of interest for the plan in lieu of the rates under subparagraph (A)";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "In the case of a qualified reserve plan, in lieu of taking rates of interest into account under")
rule SelectInterestRatePower404Ag3Bi(taxpayer: Person, plan: Plan, y: TaxableYear) strict {
    label en official "a power of the taxpayer valid only for a rate within the permissible range (module 79 range test); outside it the exercise is an invalid attempt";
    when qualified_reserve_plan_404Af2(plan, y)
        and rate_selection_exercise_404Ag3Bi(taxpayer, plan, y);
    then power SelectInterestRatePower {
        holder taxpayer;
        over plan;
        exercise rate_selection_exercise_404Ag3Bi(taxpayer, plan, y);
        valid_when selected_rate_within_permissible_range_404Ag3Biii(plan, y);
        effect rate_selected_by_taxpayer_404Ag3Bi(taxpayer, plan, y);
    };
}

pub relation prior_selected_rate_facts_404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear, prior_rate: Decimal, average_long_term_corporate_rate_15_years: Decimal) kind empirical {
    label en unofficial "the rate selected for the previous year (depth 1) and the 15-year average rate for this year, case-asserted";
}

pub relation new_rate_selected_404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer has selected a new rate within the permissible range, case-asserted (goal atom)";
}

pub relation selected_rate_remains_in_effect_404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "section 404A(g)(3)(B)(ii): the selected rate remains in effect until the first taxable year for which it is no longer within the permissible range";
}

pub relation new_rate_required_404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(3)(B)(ii): the previous rate is no longer within the permissible range, so a new rate must be selected";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "Any rate selected by the taxpayer for the plan under this subparagraph shall remain in effect for")
rule SelectedRateRemainsInEffect404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear, prior: Decimal, avg: Decimal) strict {
    label en official "exact boundaries of the plus and minus 20 percent range are included";
    when prior_selected_rate_facts_404Ag3Bii(taxpayer, plan, y, prior, avg)
        and prior >= avg * 0.8
        and prior <= avg * 1.2;
    then selected_rate_remains_in_effect_404Ag3Bii(taxpayer, plan, y, prior);
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "Any rate selected by the taxpayer for the plan under this subparagraph shall remain in effect for")
rule NewRateRequiredBelowRange404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear, prior: Decimal, avg: Decimal) strict {
    label en official "the previous rate is below the range";
    when prior_selected_rate_facts_404Ag3Bii(taxpayer, plan, y, prior, avg)
        and prior < avg * 0.8;
    then new_rate_required_404Ag3Bii(taxpayer, plan, y);
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "Any rate selected by the taxpayer for the plan under this subparagraph shall remain in effect for")
rule NewRateRequiredAboveRange404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear, prior: Decimal, avg: Decimal) strict {
    label en official "the previous rate is above the range";
    when prior_selected_rate_facts_404Ag3Bii(taxpayer, plan, y, prior, avg)
        and prior > avg * 1.2;
    then new_rate_required_404Ag3Bii(taxpayer, plan, y);
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "Any rate selected by the taxpayer for the plan under this subparagraph shall remain in effect for")
rule SelectNewRateDuty404Ag3Bii(taxpayer: Person, plan: Plan, y: TaxableYear) strict {
    label en official "the taxpayer shall select a new rate within the range applicable at that time (no deadline in the text: an open window)";
    when new_rate_required_404Ag3Bii(taxpayer, plan, y);
    then duty SelectNewRateDuty {
        bearer taxpayer;
        goal achievement {
            condition new_rate_selected_404Ag3Bii(taxpayer, plan, y);
            window [-infinity, infinity];
        }
    };
}

pub relation election_year_facts_404Ag5(taxpayer: Person, election_year: Integer) kind empirical {
    label en unofficial "the calendar year (start of the taxable year) for which the election under section 404A is made, case-asserted";
}

pub relation election_treated_as_method_change_481_404Ag5(taxpayer: Person, election_year: Integer) kind institutional {
    label en official "section 404A(g)(5): for purposes of section 481 any election under this section is treated as a change in the taxpayer's method of accounting";
}

pub relation section_481a2_adjustment_last_year_404Ag5(taxpayer: Person, election_year: Integer, last_year: Integer) kind institutional {
    label en official "section 404A(g)(5): the period for taking into account the section 481(a)(2) adjustment is the election year and the fourteen succeeding years";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "For purposes of section 481, any election under this section shall be treated as a change in the")
rule ElectionTreatedAsMethodChange404Ag5(taxpayer: Person, y: Integer) strict {
    label en official "the election is a method change";
    when election_year_facts_404Ag5(taxpayer, y);
    then election_treated_as_method_change_481_404Ag5(taxpayer, y);
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "For purposes of section 481, any election under this section shall be treated as a change in the")
rule Section481AdjustmentLastYear404Ag5(taxpayer: Person, y: Integer) strict {
    label en official "15 taxable years: the election year plus 14";
    when election_year_facts_404Ag5(taxpayer, y);
    then section_481a2_adjustment_last_year_404Ag5(taxpayer, y, y + 14);
}

// =====================================================================
// 406(b)(1)(B), 406(d)(3), 407(d)(3) and the timing sentences; 414A(c)
// =====================================================================

pub relation compensation_treated_as_paid_by_american_employer_406b1B(individual: Person, employer: Person, amount: Money) kind institutional {
    label en official "section 406(b)(1)(B): the highly compensated employee determination uses the total compensation as compensation paid by the American employer";
}

@source(IRC_S406_B, relation = formalizes, coverage = exact, quote = "(B) the determination of whether such individual is a highly compensated employee (as so defined)")
rule CompensationTreatedAsPaidByAmericanEmployer406b1B(individual: Person, employer: Person, plan: Plan, amount: Money) strict {
    label en official "wired to the (b)(2)(A) total compensation and the (a) treated-employee status; the status is determined with regard to the American employer via the derived capacity relation of module 50";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan)
        and total_compensation_for_american_employer_406b2A(individual, amount);
    then compensation_treated_as_paid_by_american_employer_406b1B(individual, employer, amount);
}

pub relation total_compensation_read_for_404_406d3(employer: Person, individual: Person, amount: Money) kind institutional {
    label en official "section 406(d)(3): any reference to compensation in section 404 is a reference to the total compensation of the individual (determined with subsection (b)(2))";
}

@source(IRC_S406_D, relation = formalizes, coverage = exact, quote = "(3) any reference to compensation shall be considered to be a reference to the total compensation")
rule TotalCompensationRead406d3(employer: Person, individual: Person, affiliate: Person, would_be: Money, amount: Money) strict {
    label en official "JUDGMENT CALL: derived for consumers of the section 404 modules (they take compensation as a fact and are not rewritten here)";
    when contribution_on_behalf_of_treated_employee_406d(employer, individual, affiliate, would_be)
        and total_compensation_for_american_employer_406b2A(individual, amount);
    then total_compensation_read_for_404_406d3(employer, individual, amount);
}

pub relation total_compensation_read_for_404_407d3(parent: Person, individual: Person, amount: Money) kind institutional {
    label en official "section 407(d)(3): any reference to compensation in section 404 is a reference to the total compensation of the individual (determined with subsection (b)(2))";
}

@source(IRC_S407_D, relation = formalizes, coverage = exact, quote = "(3) any reference to compensation shall be considered to be a reference to the total compensation")
rule TotalCompensationRead407d3(parent: Person, individual: Person, sub: Person, would_be: Money, amount: Money) strict {
    label en official "JUDGMENT CALL: derived for consumers of the section 404 modules (they take compensation as a fact and are not rewritten here)";
    when contribution_on_behalf_of_treated_employee_407d(parent, individual, sub, would_be)
        and total_compensation_for_parent_407b2(individual, amount);
    then total_compensation_read_for_404_407d3(parent, individual, amount);
}

pub relation taxable_years_facts_406d(employer: Person, employer_year_start: Date, employer_year_end: Date, affiliate: Person, affiliate_year_start: Date, affiliate_year_end: Date) kind empirical {
    label en unofficial "the taxable year of the American employer (or domestic parent) and a taxable year of the foreign affiliate (or domestic subsidiary), case-asserted";
}

pub relation deduction_year_of_affiliate_406d(employer: Person, affiliate: Person, affiliate_year_end: Date) kind institutional {
    label en official "section 406(d): the deduction of the foreign affiliate is deductible in its taxable year with or within which the taxable year of the American employer ends";
}

pub relation deduction_year_of_subsidiary_407d(parent: Person, sub: Person, subsidiary_year_end: Date) kind institutional {
    label en official "section 407(d): the deduction of the domestic subsidiary is deductible in its taxable year with or within which the taxable year of the domestic parent ends";
}

@source(IRC_S406_D, relation = formalizes, coverage = exact, quote = "Any amount deductible by a foreign affiliate under this subsection shall be deductible for its")
rule DeductionYearOfAffiliate406d(employer: Person, ey_start: Date, ey_end: Date, affiliate: Person, ay_start: Date, ay_end: Date) strict {
    label en official "the affiliate's year that contains the end date of the employer's year (with or within; exact boundaries included)";
    when taxable_years_facts_406d(employer, ey_start, ey_end, affiliate, ay_start, ay_end)
        and ay_start <= ey_end
        and ay_end >= ey_end;
    then deduction_year_of_affiliate_406d(employer, affiliate, ay_end);
}

@source(IRC_S407_D, relation = formalizes, coverage = exact, quote = "Any amount deductible by a domestic subsidiary under this subsection shall be deductible for its")
rule DeductionYearOfSubsidiary407d(parent: Person, py_start: Date, py_end: Date, sub: Person, sy_start: Date, sy_end: Date) strict {
    label en official "the subsidiary's year that contains the end date of the parent's year (with or within; exact boundaries included)";
    when taxable_years_facts_406d(parent, py_start, py_end, sub, sy_start, sy_end)
        and sy_start <= py_end
        and sy_end >= py_end;
    then deduction_year_of_subsidiary_407d(parent, sub, sy_end);
}

pub relation multiple_employer_adoption_facts_414Ac2B(plan: Plan, employer: Person, adopts_after_enactment_a_plan_maintained_by_more_than_one_employer: Boolean) kind empirical {
    label en unofficial "the employer adopts, after the date of enactment of section 414A, a plan maintained by more than one employer, case-asserted";
}

pub relation pre_enactment_exception_inapplicable_414Ac2B(plan: Plan, employer: Person) kind institutional {
    label en official "section 414A(c)(2)(B): subparagraph (A) does not apply to the employer";
}

pub relation subsection_a_applies_as_if_single_plan_414Ac2B(plan: Plan, employer: Person) kind institutional {
    label en official "section 414A(c)(2)(B): subsection (a) applies to the employer as if the plan were a single plan";
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply in the case of an employer adopting after such date of enactment a")
rule PreEnactmentExceptionInapplicable414Ac2B(plan: Plan, employer: Person) strict {
    label en official "adoption after enactment of a multiple employer plan";
    when multiple_employer_adoption_facts_414Ac2B(plan, employer, true);
    then pre_enactment_exception_inapplicable_414Ac2B(plan, employer);
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply in the case of an employer adopting after such date of enactment a")
rule SubsectionAAppliesAsIfSinglePlan414Ac2B(plan: Plan, employer: Person) strict {
    label en official "the same adoption";
    when multiple_employer_adoption_facts_414Ac2B(plan, employer, true);
    then subsection_a_applies_as_if_single_plan_414Ac2B(plan, employer);
}

pub relation multiple_employer_plan_employer_facts_414Ac4C(plan: Plan, employer: Person, subsection_a_applies_after_paragraph_4: Boolean) kind empirical {
    label en unofficial "a plan maintained by more than one employer, one of its employers, and whether subsection (a) applies to that employer after the application of paragraph (4), case-asserted";
}

pub relation subparagraphs_a_and_b_applied_to_employer_separately_414Ac4C(plan: Plan, employer: Person) kind institutional {
    label en official "section 414A(c)(4)(C): subparagraphs (A) and (B) are applied separately with respect to each employer";
}

pub relation employer_treated_as_maintaining_separate_plan_414Ac4C(plan: Plan, employer: Person) kind institutional {
    label en official "section 414A(c)(4)(C): all employers to which subsection (a) applies are treated as maintaining a separate plan";
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "In the case of a plan maintained by more than 1 employer, subparagraphs (A) and (B) shall be")
rule SubparagraphsAAndBAppliedSeparately414Ac4C(plan: Plan, employer: Person, a: Boolean) strict {
    label en official "each employer of the multiple employer plan";
    when multiple_employer_plan_employer_facts_414Ac4C(plan, employer, a);
    then subparagraphs_a_and_b_applied_to_employer_separately_414Ac4C(plan, employer);
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "In the case of a plan maintained by more than 1 employer, subparagraphs (A) and (B) shall be")
rule EmployerTreatedAsMaintainingSeparatePlan414Ac4C(plan: Plan, employer: Person) strict {
    label en official "only employers to which subsection (a) applies after paragraph (4)";
    when multiple_employer_plan_employer_facts_414Ac4C(plan, employer, true);
    then employer_treated_as_maintaining_separate_plan_414Ac4C(plan, employer);
}

// =====================================================================
// 418E(c), (d), (e), (f)
// =====================================================================

external judgment relation suspension_substantially_uniform_418Ec2A(plan: MultiemployerPlan, y: TaxableYear) {
    authority Secretary;
    label en official "section 418E(c)(2)(A): the suspension applies in substantially uniform proportions to the benefits of all persons in pay status (with the equitable variations the Secretary may prescribe) — an evaluative determination under regulations, not computed by this package";
}

pub relation suspension_applied_uniformly_418Ec2A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(c)(2)(A): the suspension of benefit payments is applied in substantially uniform proportions";
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "(A) The suspension of benefit payments under this section shall, in accordance with regulations")
rule SuspensionAppliedUniformly418Ec2A(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "EVALUATIVE (DECISION-0194): the judgment channel of the Secretary; the regulations are not pinned";
    when suspension_substantially_uniform_418Ec2A(plan, y);
    then suspension_applied_uniformly_418Ec2A(plan, y);
}

pub relation base_year_person_facts_418Ec2(plan: MultiemployerPlan, person: Person, participant_or_beneficiary_on_last_day_of_base_plan_year: Boolean, paid_retirement_type_benefit_during_base_year: Boolean) kind empirical {
    label en unofficial "whether the person was a participant or beneficiary on the last day of the base plan year and was paid, at any time during that year, an early, late, normal or disability retirement benefit (or a death benefit related to a retirement benefit), case-asserted";
}

pub relation person_in_pay_status_418Ec2Bi(plan: MultiemployerPlan, person: Person) kind institutional {
    label en official "section 418E(c)(2)(B)(i)(I): a participant or beneficiary on the last day of the base plan year who was paid such a benefit during that year is a person in pay status";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(I) a participant or beneficiary on the last day of the base plan year who, at any time during such")
rule PersonInPayStatus418Ec2(plan: MultiemployerPlan, person: Person) strict {
    label en official "both limbs of (I)";
    when base_year_person_facts_418Ec2(plan, person, true, true);
    then person_in_pay_status_418Ec2Bi(plan, person);
}

pub relation regulation_extends_pay_status_facts_418Ec2(plan: MultiemployerPlan, person: Person, entitled_to_such_a_benefit: Boolean, regulation_provides: Boolean) kind empirical {
    label en unofficial "the person is entitled to such a benefit under the plan and the Secretary's regulations provide that the person is in pay status (regulations not pinned; supplied by the case), case-asserted";
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "(II) to the extent provided in regulations prescribed by the Secretary of the Treasury, any other")
rule PersonInPayStatusByRegulation418Ec2(plan: MultiemployerPlan, person: Person) strict {
    label en official "EXTERNAL_DEPENDENCY: the extension is made only to the extent the Secretary's regulations provide";
    when regulation_extends_pay_status_facts_418Ec2(plan, person, true, true);
    then person_in_pay_status_418Ec2Bi(plan, person);
}

pub relation collective_bargaining_agreement_418Ec2(plan: MultiemployerPlan, cba: Integer, effective_date: Date, terminates_on: Date) kind empirical {
    label en unofficial "a collective bargaining agreement under the plan, its effective date and the date it ceases to be in effect (a date after the plan year end when it is still in effect), case-asserted";
}

pub relation plan_year_bounds_418Ec2(plan: MultiemployerPlan, year_start: Date, year_end: Date) kind empirical {
    label en unofficial "the first and last days of the plan year (bounded unrolling: one plan year), case-asserted";
}

pub relation cba_in_effect_six_months_418Ec2BiiiI(plan: MultiemployerPlan, cba: Integer) kind institutional {
    label en official "section 418E(c)(2)(B)(iii)(I): the agreement is in effect for at least 6 months during the plan year";
}

pub relation cba_not_in_effect_over_36_months_418Ec2BiiiII(plan: MultiemployerPlan, cba: Integer) kind institutional {
    label en official "section 418E(c)(2)(B)(iii)(II): the agreement has not been in effect for more than 36 months as of the end of the plan year";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(I) which is in effect for at least 6 months during the plan year, and")
rule CbaInEffectSixMonthsBothInside418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date, ys: Date, ye: Date) strict {
    label en official "agreement starts within the year and ends within or after it: the overlap runs from its effective date to the year end; JUDGMENT CALL: six calendar months counted with the end date inclusive (July 1 to December 31 is six months)";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and plan_year_bounds_418Ec2(plan, ys, ye)
        and eff >= ys
        and term >= ye
        and add_calendar_period(eff, 6 calendar_month) <= add_calendar_period(ye, 1 calendar_day);
    then cba_in_effect_six_months_418Ec2BiiiI(plan, cba);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(I) which is in effect for at least 6 months during the plan year, and")
rule CbaInEffectSixMonthsStartedEarlier418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date, ys: Date, ye: Date) strict {
    label en official "agreement started before the year began and ends within or after it";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and plan_year_bounds_418Ec2(plan, ys, ye)
        and eff < ys
        and term >= ye
        and add_calendar_period(ys, 6 calendar_month) <= add_calendar_period(ye, 1 calendar_day);
    then cba_in_effect_six_months_418Ec2BiiiI(plan, cba);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(I) which is in effect for at least 6 months during the plan year, and")
rule CbaInEffectSixMonthsEndsInside418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date, ys: Date, ye: Date) strict {
    label en official "agreement ends before the year ends and started within or before the year";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and plan_year_bounds_418Ec2(plan, ys, ye)
        and eff >= ys
        and term < ye
        and add_calendar_period(eff, 6 calendar_month) <= add_calendar_period(term, 1 calendar_day);
    then cba_in_effect_six_months_418Ec2BiiiI(plan, cba);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(I) which is in effect for at least 6 months during the plan year, and")
rule CbaInEffectSixMonthsSpansYear418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date, ys: Date, ye: Date) strict {
    label en official "agreement started before the year began and ends before it ends";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and plan_year_bounds_418Ec2(plan, ys, ye)
        and eff < ys
        and term < ye
        and add_calendar_period(ys, 6 calendar_month) <= add_calendar_period(term, 1 calendar_day);
    then cba_in_effect_six_months_418Ec2BiiiI(plan, cba);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(II) which has not been in effect for more than 36 months as of the end of the plan year.")
rule CbaNotInEffectOver36Months418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date, ys: Date, ye: Date) strict {
    label en official "exact boundary: an agreement in effect exactly 36 months at the year end qualifies";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and plan_year_bounds_418Ec2(plan, ys, ye)
        and add_calendar_period(eff, 36 calendar_month) >= ye;
    then cba_not_in_effect_over_36_months_418Ec2BiiiII(plan, cba);
}

pub relation relevant_cba_effective_date_418Ec2(plan: MultiemployerPlan, cba: Integer, effective_date: Date) kind institutional {
    label en official "section 418E(c)(2)(B)(iii): the agreement is a relevant collective bargaining agreement (I) and (II) and this is its effective date";
}

pub relation earlier_relevant_effective_date_exists_418Ec2(plan: MultiemployerPlan, effective_date: Date) kind institutional {
    label en official "helper: a relevant agreement has an effective date strictly earlier than this one";
}

pub relation relevant_effective_date_418Ec2Biv(plan: MultiemployerPlan, effective_date: Date) kind institutional {
    label en official "section 418E(c)(2)(B)(iv): the relevant effective date is the earliest of the effective dates for the relevant collective bargaining agreements";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(iv) the relevant effective date is the earliest of the effective dates for the relevant collective")
rule RelevantCbaEffectiveDate418Ec2(plan: MultiemployerPlan, cba: Integer, eff: Date, term: Date) strict {
    label en official "both time conditions (I) and (II)";
    when collective_bargaining_agreement_418Ec2(plan, cba, eff, term)
        and cba_in_effect_six_months_418Ec2BiiiI(plan, cba)
        and cba_not_in_effect_over_36_months_418Ec2BiiiII(plan, cba);
    then relevant_cba_effective_date_418Ec2(plan, cba, eff);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(iv) the relevant effective date is the earliest of the effective dates for the relevant collective")
rule EarlierRelevantEffectiveDateExists418Ec2(plan: MultiemployerPlan, c1: Integer, d1: Date, c2: Integer, d2: Date) strict {
    label en official "candidates and no strictly earlier candidate (TECH-GAPS G136 pattern)";
    when relevant_cba_effective_date_418Ec2(plan, c1, d1)
        and relevant_cba_effective_date_418Ec2(plan, c2, d2)
        and d2 < d1;
    then earlier_relevant_effective_date_exists_418Ec2(plan, d1);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "(iv) the relevant effective date is the earliest of the effective dates for the relevant collective")
rule RelevantEffectiveDateEarliest418Ec2Biv(plan: MultiemployerPlan, c1: Integer, d1: Date) strict {
    label en official "the earliest relevant effective date";
    when relevant_cba_effective_date_418Ec2(plan, c1, d1)
        and not_known(earlier_relevant_effective_date_exists_418Ec2(plan, d1));
    then relevant_effective_date_418Ec2Biv(plan, d1);
}

pub relation sponsor_determined_excess_resources_in_writing_418Ec4A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "by the end of the insolvency year the plan sponsor determined in writing that available resources could have supported payments above the resource benefit level, case-asserted";
}

pub relation excess_resources_distributed_418Ec4A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the excess resources were distributed to the participants and beneficiaries who received payments in the insolvency year, case-asserted (goal atom)";
}

pub relation excess_resources_to_distribute_418Ec4A(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(c)(4)(A): the amount of excess resources the sponsor shall distribute";
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "If, by the end of an insolvency year, the plan sponsor determines in writing that the plan's")
rule ExcessResourcesToDistribute418Ec4A(plan: MultiemployerPlan, y: TaxableYear, amount: Money) defeasible {
    label en official "PARTIAL: the amount is the (c)(4)(B) excess; the distribution manner is left to the Secretary's regulations";
    when sponsor_determined_excess_resources_in_writing_418Ec4A(plan, y)
        and excess_resources_418Ec4B(plan, y, amount);
    then excess_resources_to_distribute_418Ec4A(plan, y, amount);
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "If, by the end of an insolvency year, the plan sponsor determines in writing that the plan's")
rule DistributeExcessResourcesDuty418Ec4A(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person) strict {
    label en official "PARTIAL: the duty of the sponsor after a written determination; no deadline in the text (an open window)";
    when sponsor_determined_excess_resources_in_writing_418Ec4A(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty DistributeExcessResourcesDuty {
        bearer sponsor;
        goal achievement {
            condition excess_resources_distributed_418Ec4A(plan, y);
            window [-infinity, infinity];
        }
    };
}

pub relation retroactive_payment_required_by_c4_or_c5_418Ec6(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(c)(6): paragraph (4) or (5) requires a payment for the year";
}

pub relation suspended_benefit_portion_418Ec6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of a benefit that was suspended under this section, case-asserted";
}

pub relation no_retroactive_payment_required_418Ec6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(c)(6): the plan is not required to make retroactive benefit payments for the suspended portion";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (4) or (5), a plan is not required to make retroactive benefit")
rule RetroactivePaymentRequiredByParagraph4418Ec6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) defeasible {
    label en official "paragraph (4): a positive excess-resources amount";
    when excess_resources_418Ec4B(plan, y, amount)
        and amount > 0.00 USD;
    then retroactive_payment_required_by_c4_or_c5_418Ec6(plan, y);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (4) or (5), a plan is not required to make retroactive benefit")
rule RetroactivePaymentRequiredByParagraph5418Ec6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) defeasible {
    label en official "paragraph (5): a positive retroactive distribution ceiling";
    when retroactive_distribution_ceiling_418Ec5(plan, y, amount)
        and amount > 0.00 USD;
    then retroactive_payment_required_by_c4_or_c5_418Ec6(plan, y);
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (4) or (5), a plan is not required to make retroactive benefit")
rule NoRetroactivePaymentRequired418Ec6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) defeasible {
    label en official "the suspended portion, unless paragraph (4) or (5) requires a payment";
    when suspended_benefit_portion_418Ec6(plan, y, amount)
        and not_known(retroactive_payment_required_by_c4_or_c5_418Ec6(plan, y));
    then no_retroactive_payment_required_418Ec6(plan, y, amount);
}

pub relation plan_in_critical_status_418Ed2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan is in critical status as described in section 432(b)(2), case-asserted";
}

pub relation sponsor_reasonably_determined_insufficient_resources_418Ed2(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the sponsor reasonably determined, taking into account recent and anticipated financial experience, that the available resources are not sufficient to pay benefits when due for the next plan year, on this date, case-asserted";
}

pub relation determination_made_available_418Ed2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor made the determination available to interested parties, case-asserted (goal atom)";
}

@source(IRC_S418E_D, relation = formalizes, coverage = exact, quote = "If, at any time, the plan sponsor of a plan in critical status, as described in section 432(b)(2),")
rule MakeDeterminationAvailableDuty418Ed2(plan: MultiemployerPlan, sponsor: Person, on: Date) strict {
    label en official "no deadline in the text: an open window from the determination";
    when plan_in_critical_status_418Ed2(plan)
        and sponsor_reasonably_determined_insufficient_resources_418Ed2(plan, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty MakeDeterminationAvailableDuty {
        bearer sponsor;
        goal achievement {
            condition determination_made_available_418Ed2(plan);
            window [on, infinity];
        }
    };
}

pub relation may_become_insolvent_determination_418Ee1(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the sponsor determined under subsection (d)(1) or (2) that the plan may become insolvent, on this date, case-asserted";
}

pub relation impending_insolvency_notice_required_418Ee1(plan: MultiemployerPlan, on: Date) kind institutional {
    label en official "section 418E(e)(1): the sponsor of a plan in critical status has determined that the plan may become insolvent";
}

pub relation secretary_and_parties_notified_418Ee1A(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor notified the Secretary and the section 101(f)(1) ERISA parties of the determination, case-asserted (goal atom)";
}

pub relation parties_informed_of_suspension_consequences_418Ee1B(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor informed the section 101(f)(1) ERISA parties that if insolvency occurs certain benefit payments will be suspended but basic benefits will continue, case-asserted (goal atom)";
}

@source(IRC_S418E_E, relation = formalizes, coverage = exact, quote = "If the plan sponsor of a plan in critical status, as described in section 432(b)(2), determines")
rule ImpendingInsolvencyNoticeRequired418Ee1(plan: MultiemployerPlan, on: Date) strict {
    label en official "critical status and a determination that the plan may become insolvent";
    when plan_in_critical_status_418Ed2(plan)
        and may_become_insolvent_determination_418Ee1(plan, on);
    then impending_insolvency_notice_required_418Ee1(plan, on);
}

@source(IRC_S418E_E, relation = formalizes, coverage = exact, quote = "(A) notify the Secretary and the parties described in section 101(f)(1) of the Employee Retirement")
rule NotifySecretaryAndPartiesDuty418Ee1A(plan: MultiemployerPlan, sponsor: Person, on: Date) strict {
    label en official "no deadline in the text: an open window from the determination";
    when impending_insolvency_notice_required_418Ee1(plan, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty NotifySecretaryAndPartiesDuty {
        bearer sponsor;
        goal achievement {
            condition secretary_and_parties_notified_418Ee1A(plan);
            window [on, infinity];
        }
    };
}

@source(IRC_S418E_E, relation = formalizes, coverage = exact, quote = "(B) inform the parties described in section 101(f)(1) of the Employee Retirement Income Security")
rule InformPartiesOfSuspensionConsequencesDuty418Ee1B(plan: MultiemployerPlan, sponsor: Person, on: Date) strict {
    label en official "no deadline in the text: an open window from the determination";
    when impending_insolvency_notice_required_418Ee1(plan, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty InformPartiesOfSuspensionConsequencesDuty {
        bearer sponsor;
        goal achievement {
            condition parties_informed_of_suspension_consequences_418Ee1B(plan);
            window [on, infinity];
        }
    };
}

pub relation sponsor_anticipates_resource_level_not_above_basic_418Ee3(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the sponsor anticipates that the resource benefit level for the insolvency year may not exceed the level of basic benefits, from this date, case-asserted";
}

pub relation pbgc_notified_418Ee3(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor notified the Pension Benefit Guaranty Corporation, case-asserted (goal atom)";
}

@source(IRC_S418E_E, relation = formalizes, coverage = exact, quote = "In any case in which the plan sponsor anticipates that the resource benefit level for an insolvency")
rule NotifyPbgcDuty418Ee3(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, on: Date) strict {
    label en official "no deadline in the text: an open window from the anticipation";
    when sponsor_anticipates_resource_level_not_above_basic_418Ee3(plan, y, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty NotifyPbgcDuty {
        bearer sponsor;
        goal achievement {
            condition pbgc_notified_418Ee3(plan, y);
            window [on, infinity];
        }
    };
}

pub relation applied_for_pbgc_financial_assistance_418Ef2(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor applied for financial assistance from the PBGC under ERISA section 4261, case-asserted (goal atom)";
}

@source(IRC_S418E_F, relation = formalizes, coverage = exact, quote = "A plan sponsor who has determined a resource benefit level for an insolvency year which is below")
rule ApplyForPbgcAssistanceDuty418Ef2(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, level: Money, basic_level: Money) strict {
    label en official "exact boundary: a resource benefit level below the basic level (equal does not trigger the duty); no deadline in the text";
    when resource_benefit_level_determined_in_writing_418Ed3(plan, y)
        and resource_benefit_level_and_basic_418E(plan, y, level, basic_level)
        and level < basic_level
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty ApplyForPbgcAssistanceDuty {
        bearer sponsor;
        goal achievement {
            condition applied_for_pbgc_financial_assistance_418Ef2(plan, y);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// 421(c)(3), 422(c)(4), 423(b)(4)-(5), 423(c), 424(a), 424(c)(4)
// =====================================================================

pub relation estate_exercise_basis_facts_421c3(option: Person, option_basis_attributable_to_share: Money, hypothetical_423c_amount_at_death: Money, actual_423c_inclusion: Money) kind empirical {
    label en unofficial "the basis of the option attributable to the share, the amount that would have been includible under section 423(c) had the employee exercised on the date of death and held the share at death, and the amount actually includible under section 423(c), case-asserted";
}

pub relation share_acquired_under_paragraph_1_421c3(option: Person) kind institutional {
    label en official "section 421(c)(3): the share was acquired by the exercise of an option to which paragraph (1) applies";
}

pub relation share_basis_component_from_option_421c3A(option: Person, amount: Money) kind institutional {
    label en official "section 421(c)(3)(A): the basis of the share includes so much of the option basis as is attributable to it, reduced by the excess of the hypothetical over the actual section 423(c) inclusion";
}

pub relation amount_subject_to_423c_last_sentence_421c3B(option: Person, amount: Money) kind institutional {
    label en official "section 421(c)(3)(B): the last sentence of section 423(c) applies only to the extent the amount includible exceeds the option basis attributable to the share";
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "In the case of a share of stock acquired by the exercise of an option to which paragraph (1)")
rule ShareAcquiredUnderParagraph1421c3(option: Person) strict {
    label en official "wired to the section 421(c)(1) rule of module 17";
    when subsection_a_applies_as_if_by_decedent_421c1(option);
    then share_acquired_under_paragraph_1_421c3(option);
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "(A) the basis of such share shall include so much of the basis of the option as is attributable to")
rule ShareBasisComponentFromOption421c3A(option: Person, basis: Money, hypo: Money, actual: Money) strict {
    label en official "JUDGMENT CALL: the component added to the share's basis; the amount paid for the share is not restated (the clause says the basis 'shall include'); the reduction is floored at zero";
    when share_acquired_under_paragraph_1_421c3(option)
        and estate_exercise_basis_facts_421c3(option, basis, hypo, actual);
    then share_basis_component_from_option_421c3A(option, basis - max(0.00 USD, hypo - actual));
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "(B) the last sentence of section 423(c) shall apply only to the extent that the amount includible")
rule AmountSubjectTo423cLastSentence421c3B(option: Person, basis: Money, hypo: Money, actual: Money) strict {
    label en official "max(0, actual inclusion - option basis attributable)";
    when share_acquired_under_paragraph_1_421c3(option)
        and estate_exercise_basis_facts_421c3(option, basis, hypo, actual);
    then amount_subject_to_423c_last_sentence_421c3B(option, max(0.00 USD, actual - basis));
}

pub relation option_holder_property_right_facts_422c4B(opt: StockOption, property_is_cash: Boolean, section_83_applies_to_property: Boolean) kind empirical {
    label en unofficial "the employee has a right to receive property at the time of exercise; whether the property is cash; whether section 83 applies to the property transferred, case-asserted";
}

pub relation property_right_permitted_term_422c4B(opt: StockOption) kind institutional {
    label en official "section 422(c)(4)(B): a right to receive property at exercise does not prevent treating the option as an incentive stock option, and for a transfer of property other than cash only if section 83 applies to the property";
}

@source(IRC_S422_C, relation = formalizes, coverage = exact, quote = "Subparagraph (B) shall apply to a transfer of property (other than cash) only if section 83 applies")
rule PropertyRightPermittedCash422c4B(opt: StockOption, s: Boolean) strict {
    label en official "cash: the section 83 gate does not apply";
    when option_holder_property_right_facts_422c4B(opt, true, s);
    then property_right_permitted_term_422c4B(opt);
}

@source(IRC_S422_C, relation = formalizes, coverage = exact, quote = "Subparagraph (B) shall apply to a transfer of property (other than cash) only if section 83 applies")
rule PropertyRightPermittedNonCash422c4B(opt: StockOption) strict {
    label en official "other property: only if section 83 applies to the property (section 83 itself is not formalized by this package)";
    when option_holder_property_right_facts_422c4B(opt, false, true);
    then property_right_permitted_term_422c4B(opt);
}

pub relation employee_of_plan_corporation_423b4(plan: CompensatoryOptionPlan, employee: Individual) kind empirical {
    label en unofficial "the individual is an employee of a corporation whose employees are granted options under the plan by reason of their employment (the case asserts the complete roster), case-asserted";
}

pub relation employee_granted_option_under_plan_423b4(plan: CompensatoryOptionPlan, employee: Individual) kind empirical {
    label en unofficial "options are, under the terms of the plan, granted to the employee, case-asserted";
}

pub relation roster_of_employees_asserted_423b4(plan: CompensatoryOptionPlan) kind empirical {
    label en unofficial "the case asserts the complete roster of employees of the corporation (the closed-world premise of the population-wide test), case-asserted";
}

pub relation plan_omits_employee_423b4(plan: CompensatoryOptionPlan, employee: Individual) kind institutional {
    label en official "section 423(b)(4): an employee of the corporation is not granted options and is not within a permitted exclusion";
}

pub relation plan_has_omitted_employee_423b4(plan: CompensatoryOptionPlan) kind institutional {
    label en official "helper: at least one employee is omitted";
}

pub relation plan_grants_to_all_employees_423b4(plan: CompensatoryOptionPlan) kind institutional {
    label en official "section 423(b)(4): options are to be granted to all employees of the corporation, except the permitted exclusions";
}

@source(IRC_S423_B, relation = formalizes, coverage = exact, quote = "(4) under the terms of the plan, options are to be granted to all employees of any corporation")
rule PlanOmitsEmployee423b4(plan: CompensatoryOptionPlan, employee: Individual) strict {
    label en official "population-wide test over the case roster (TECH-GAPS G373 closed by a roster and a helper relation)";
    when employee_of_plan_corporation_423b4(plan, employee)
        and not_known(employee_granted_option_under_plan_423b4(plan, employee))
        and not_known(plan_may_exclude_employee_423b4(plan, employee));
    then plan_omits_employee_423b4(plan, employee);
}

@source(IRC_S423_B, relation = formalizes, coverage = exact, quote = "(4) under the terms of the plan, options are to be granted to all employees of any corporation")
rule PlanHasOmittedEmployee423b4(plan: CompensatoryOptionPlan, employee: Individual) strict {
    label en official "existential over the roster";
    when plan_omits_employee_423b4(plan, employee);
    then plan_has_omitted_employee_423b4(plan);
}

@source(IRC_S423_B, relation = formalizes, coverage = exact, quote = "(4) under the terms of the plan, options are to be granted to all employees of any corporation")
rule PlanGrantsToAllEmployees423b4(plan: CompensatoryOptionPlan) strict {
    label en official "a complete roster and no omitted employee";
    when roster_of_employees_asserted_423b4(plan)
        and not_known(plan_has_omitted_employee_423b4(plan));
    then plan_grants_to_all_employees_423b4(plan);
}

pub relation option_terms_423b5(plan: CompensatoryOptionPlan, employee: Individual, shares: Decimal, compensation: Money, at_plan_maximum: Boolean, other_rights_and_privileges_same: Boolean) kind empirical {
    label en unofficial "the amount of stock the employee may purchase, the employee's total (or basic or regular rate of) compensation, whether the employee is at the maximum fixed under the plan, and whether all other rights and privileges are the same as for the other employees, case-asserted";
}

pub relation amounts_not_uniform_to_compensation_423b5(plan: CompensatoryOptionPlan, first: Individual, second: Individual) kind institutional {
    label en official "section 423(b)(5): the purchasable amounts of two employees not at the plan maximum do not bear a uniform relationship to their compensation";
}

pub relation plan_has_nonuniform_terms_423b5(plan: CompensatoryOptionPlan) kind institutional {
    label en official "helper: some rights and privileges differ beyond the permitted variations";
}

pub relation plan_grants_uniform_rights_423b5(plan: CompensatoryOptionPlan) kind institutional {
    label en official "section 423(b)(5): all employees granted options have the same rights and privileges, except the permitted variations";
}

@source(IRC_S423_B, relation = formalizes, coverage = partial, quote = "(5) under the terms of the plan, all employees granted such options shall have the same rights and")
rule AmountsNotUniformToCompensation423b5(plan: CompensatoryOptionPlan, e1: Individual, e2: Individual, s1: Decimal, c1: Money, s2: Decimal, c2: Money) strict {
    label en official "PARTIAL/JUDGMENT CALL: pairwise cross-multiplication of shares and compensation for employees not at the plan maximum; the section 83(i) sentence is an external dependency (section 83(i) is not formalized)";
    when option_terms_423b5(plan, e1, s1, c1, false, _)
        and option_terms_423b5(plan, e2, s2, c2, false, _)
        and s1 * (c2 / 1.00 USD) != s2 * (c1 / 1.00 USD);
    then amounts_not_uniform_to_compensation_423b5(plan, e1, e2);
}

@source(IRC_S423_B, relation = formalizes, coverage = partial, quote = "(5) under the terms of the plan, all employees granted such options shall have the same rights and")
rule PlanHasNonuniformTermsByAmount423b5(plan: CompensatoryOptionPlan, e1: Individual, e2: Individual) strict {
    label en official "a non-uniform pair";
    when amounts_not_uniform_to_compensation_423b5(plan, e1, e2);
    then plan_has_nonuniform_terms_423b5(plan);
}

@source(IRC_S423_B, relation = formalizes, coverage = partial, quote = "(5) under the terms of the plan, all employees granted such options shall have the same rights and")
rule PlanHasNonuniformTermsByOtherRights423b5(plan: CompensatoryOptionPlan, e: Individual, s: Decimal, c: Money, m: Boolean) strict {
    label en official "other rights and privileges differ";
    when option_terms_423b5(plan, e, s, c, m, false);
    then plan_has_nonuniform_terms_423b5(plan);
}

@source(IRC_S423_B, relation = formalizes, coverage = partial, quote = "(5) under the terms of the plan, all employees granted such options shall have the same rights and")
rule PlanGrantsUniformRights423b5(plan: CompensatoryOptionPlan) strict {
    label en official "a complete roster and no non-uniform term";
    when roster_of_employees_asserted_423b4(plan)
        and not_known(plan_has_nonuniform_terms_423b5(plan));
    then plan_grants_uniform_rights_423b5(plan);
}

pub relation option_price_not_fixed_423c(opt: StockOption) kind empirical {
    label en unofficial "the option price is not fixed or determinable at the time the option is granted, case-asserted";
}

pub relation price_if_exercised_at_grant_423c(opt: StockOption, amount: Money) kind empirical {
    label en unofficial "the option price determined as if the option were exercised at the time of grant, case-asserted";
}

pub relation option_price_for_423c(opt: StockOption, amount: Money) kind institutional {
    label en official "section 423(c): where the price is not fixed, it is determined as if the option were exercised at the time of grant";
}

pub relation disposition_facts_423c(opt: StockOption, amount_includible_as_compensation: Money) kind empirical {
    label en unofficial "the individual disposed of the share (or died) and the amount includible in gross income as compensation under section 423(c), case-asserted";
}

pub relation basis_increase_on_disposition_423c(opt: StockOption, amount: Money) kind institutional {
    label en official "section 423(c): on disposition the basis of the share in the individual's hands is increased by the amount so includible";
}

pub relation no_withholding_on_423c_compensation(opt: StockOption) kind institutional {
    label en official "section 423(c): no amount is required to be deducted and withheld under chapter 24 on the amount treated as compensation";
}

@source(IRC_S423_C, relation = formalizes, coverage = exact, quote = "If the option price is not fixed or determinable at the time the option is granted, then for")
rule OptionPriceFor423c(opt: StockOption, amount: Money) strict {
    label en official "priced at the grant time";
    when option_price_not_fixed_423c(opt)
        and price_if_exercised_at_grant_423c(opt, amount);
    then option_price_for_423c(opt, amount);
}

@source(IRC_S423_C, relation = formalizes, coverage = exact, quote = "If the option price is not fixed or determinable at the time the option is granted, then for")
rule BasisIncreaseOnDisposition423c(opt: StockOption, amount: Money) strict {
    label en official "the increase equals the includible amount";
    when disposition_facts_423c(opt, amount);
    then basis_increase_on_disposition_423c(opt, amount);
}

@source(IRC_S423_C, relation = formalizes, coverage = exact, quote = "If the option price is not fixed or determinable at the time the option is granted, then for")
rule NoWithholdingOn423cCompensation(opt: StockOption, amount: Money) strict {
    label en official "no chapter 24 withholding on that amount";
    when disposition_facts_423c(opt, amount);
    then no_withholding_on_423c_compensation(opt);
}

pub relation parent_subsidiary_relationship_on_424a(parent: Person, subsidiary: Person, on: Date) kind empirical {
    label en unofficial "the parent-subsidiary relationship holds on this date, case-asserted";
}

pub relation transaction_date_424a(opt: StockOption, on: Date) kind empirical {
    label en unofficial "the date of the transaction under subsection (a), case-asserted";
}

pub relation parent_subsidiary_relationship_at_transaction_424a(parent: Person, subsidiary: Person, opt: StockOption) kind institutional {
    label en official "section 424(a): the parent-subsidiary relationship is determined at the time of the transaction";
}

@source(IRC_S424_A, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the parent-subsidiary relationship shall be determined at the time")
rule ParentSubsidiaryRelationshipAtTransaction424a(parent: Person, subsidiary: Person, opt: StockOption, on: Date) strict {
    label en official "only a relationship that holds on the transaction date counts; a relationship on another date does not";
    when transaction_date_424a(opt, on)
        and parent_subsidiary_relationship_on_424a(parent, subsidiary, on);
    then parent_subsidiary_relationship_at_transaction_424a(parent, subsidiary, opt);
}

pub relation spousal_transfer_parties_424c4(opt: StockOption, transferor: Person, transferee: Person) kind empirical {
    label en unofficial "the transferor and the transferee of a transfer described in section 1041(a), case-asserted";
}

pub relation same_tax_treatment_applies_to_transferee_424c4B(opt: StockOption, transferor: Person, transferee: Person) kind institutional {
    label en official "section 424(c)(4)(B): the same tax treatment under this part applies to the transferee as would have applied to the transferor";
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "(B) the same tax treatment under this part with respect to the transferred property shall apply to")
rule SameTaxTreatmentAppliesToTransferee424c4B(opt: StockOption, transferor: Person, transferee: Person) strict {
    label en official "a section 1041(a) transfer of option stock";
    when stock_transfer_424c(opt, SpousalTransfer1041)
        and spousal_transfer_parties_424c4(opt, transferor, transferee);
    then same_tax_treatment_applies_to_transferee_424c4B(opt, transferor, transferee);
}
