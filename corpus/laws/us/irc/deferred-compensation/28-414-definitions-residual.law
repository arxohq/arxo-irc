// Section 414 — STAGE 2e residual (IRC-09, DECISION-0379, 25.09.2026):
// definitions and special rules that module 12 left out: (a) predecessor
// service, (c)(2) church aggregation, (d) governmental plan, (e) church plan
// (correction period), (f) multiemployer plan, (g) plan administrator,
// (h) pick-up, (i)-(k) plan kinds, (l) merger and spin-off, (m) affiliated
// service groups, (n) leased employees, (p)(7) QDRO timing, (q) HCE residual,
// (r) separate lines of business, (s)-(t), (u) military service, (v) catch-up
// contributions, (w) permissible withdrawals, (y) CSEC plans, (z), (aa)-(cc).
//
// Method: a definition is a classification over facts about the entity; a
// limit is a calculation with the statutory base pinned and every indexed
// amount an explicit case input (SOURCE_GAP, never an invented value); a
// timing rule is exact calendar arithmetic (needs the IRC calendar-step
// policy in scenarios); ratio tests are exact integer cross-multiplication.

// =====================================================================
// (a) Service for predecessor employers
// =====================================================================

use self::{
    Contribution,
    DomesticRelationsOrder,
    IRC_S414_A,
    IRC_S414_BB,
    IRC_S414_C,
    IRC_S414_CC,
    IRC_S414_D,
    IRC_S414_E,
    IRC_S414_F,
    IRC_S414_G,
    IRC_S414_H,
    IRC_S414_I,
    IRC_S414_J,
    IRC_S414_K,
    IRC_S414_L,
    IRC_S414_M,
    IRC_S414_N,
    IRC_S414_P,
    IRC_S414_Q,
    IRC_S414_R,
    IRC_S414_V,
    IRC_S414_W,
    IRC_S414_Y,
    IRC_S414_Z,
    Person,
    Plan,
    TaxableYear,
    merger_protection_met,
    plan_sponsor,
};

pub relation employer_maintains_predecessor_plan(employer: Person, predecessor: Person) kind empirical {
    label en unofficial "the employer maintains a plan of a predecessor employer, case-asserted (section 414(a)(1))";
}

pub relation service_for_predecessor(employee: Person, predecessor: Person, years: Decimal) kind empirical {
    label en unofficial "the employee's years of service for the predecessor employer, case-asserted";
}

pub relation service_treated_as_for_employer(employee: Person, employer: Person, years: Decimal) kind institutional {
    label en official "section 414(a)(1): service for the predecessor is service for the employer when the employer maintains the predecessor's plan";
}

@source(IRC_S414_A, relation = formalizes, coverage = exact, quote = "in any case in which the employer maintains a plan of a predecessor employer, service for such predecessor shall be treated as service for the employer")
rule ServiceTreatedAsForEmployer(employee: Person, employer: Person, predecessor: Person, years: Decimal) strict {
    label en official "(a)(1); the regulatory extension of (a)(2) is not pinned";
    when employer_maintains_predecessor_plan(employer, predecessor) and service_for_predecessor(employee, predecessor, years);
    then service_treated_as_for_employer(employee, employer, years);
}

// =====================================================================
// (c)(2) Church organizations: aggregation
// =====================================================================

pub relation church_org_operating_funds_percent(recipient: Person, provider: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the recipient organization's operating funds provided directly or indirectly by the provider in the preceding taxable year, case-asserted (414(c)(2)(A)(i))";
}

pub relation church_org_common_management(recipient: Person, provider: Person) kind empirical {
    label en unofficial "there is a degree of common management or supervision such that the provider is directly involved in the day-to-day operations of the recipient, case-asserted ((A)(ii))";
}

pub relation nonqualified_church_controlled_org(org: Person) kind empirical {
    label en unofficial "the organization is a nonqualified church-controlled organization, case-asserted ((c)(2)(B))";
}

pub relation church_orgs_aggregated_414c2(a: Person, b: Person) kind institutional {
    label en official "section 414(c)(2): eligible church organizations are aggregated only when the provider supplies at least 80 percent of the recipient's operating funds and is involved in its day-to-day operations; nonqualified church-controlled organizations are aggregated";
}

@source(IRC_S414_C, relation = formalizes, coverage = exact, quote = "one such organization provides (directly or indirectly) at least 80 percent of the operating funds for the other organization during the preceding taxable year of the recipient organization")
rule ChurchOrgsAggregatedByFundingAndManagement(recipient: Person, provider: Person, pct: Decimal) strict {
    label en official "exact boundary: 80 percent and common management both required";
    when church_org_operating_funds_percent(recipient, provider, pct)
        and pct >= 80.0
        and church_org_common_management(recipient, provider);
    then church_orgs_aggregated_414c2(recipient, provider);
}

@source(IRC_S414_C, relation = formalizes, coverage = exact, quote = "an organization that is a nonqualified church-controlled organization shall be aggregated with 1 or more other nonqualified church-controlled organizations")
rule ChurchOrgsAggregatedNonqualified(a: Person, b: Person) strict {
    label en official "(B): two nonqualified church-controlled organizations are aggregated";
    when nonqualified_church_controlled_org(a) and nonqualified_church_controlled_org(b) and a != b;
    then church_orgs_aggregated_414c2(a, b);
}

// =====================================================================
// (d) Governmental plan; (e) Church plan
// =====================================================================

pub enum GovernmentalPlanSponsorKind414d {
    UnitedStatesGovernment;
    StateOrPoliticalSubdivision;
    AgencyOrInstrumentality;
    RailroadRetirementActPlan;
    InternationalOrganizationPlan;
    IndianTribalGovernmentEssentialFunctions;
}

pub relation plan_sponsor_kind_414d(plan: Plan, kind: GovernmentalPlanSponsorKind414d) kind empirical {
    label en unofficial "the plan is established and maintained for its employees by this kind of sponsor (or is a Railroad Retirement Act plan financed by contributions required under that Act, an international organization plan, or an Indian tribal government plan all of whose participants substantially all perform essential governmental functions), case-asserted";
}

pub relation governmental_plan_414d(plan: Plan) kind institutional {
    label en official "section 414(d): a plan of the Federal, State or local government or their agencies, a railroad retirement plan, an international organization plan, or a qualifying tribal government plan";
}

@source(IRC_S414_D, relation = formalizes, coverage = exact, quote = "the term \"governmental plan\" means a plan established and maintained for its employees by the Government of the United States, by the government of any State or political subdivision thereof, or by any agency or instrumentality of any of the foregoing")
rule GovernmentalPlan414d(plan: Plan, kind: GovernmentalPlanSponsorKind414d) strict {
    label en official "any listed sponsor kind";
    when plan_sponsor_kind_414d(plan, kind);
    then governmental_plan_414d(plan);
}

pub relation church_plan_established_by_church_or_association(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained (to the extent (2)(B) requires) for its employees by a church or a convention or association of churches exempt from tax under section 501, or by an organization whose principal purpose is administering or funding such a plan, case-asserted (section 414(e)(1), (3)(A))";
}

pub relation church_plan_primarily_for_unrelated_business_employees(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained primarily for employees of the church employed in connection with unrelated trades or businesses, case-asserted (414(e)(2)(A))";
}

pub relation church_plan_participants_substantially_all_church_employees(plan: Plan) kind empirical {
    label en unofficial "substantially all of the individuals included in the plan are church employees within (1) or (3)(B), case-asserted ((e)(2)(B))";
}

pub relation church_plan_414e(plan: Plan) kind institutional {
    label en official "section 414(e): a church plan, but not one primarily for unrelated-business employees or one whose participants are not substantially all church employees";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "the term \"church plan\" means a plan established and maintained (to the extent required in paragraph (2)(B)) for its employees (or their beneficiaries) by a church or by a convention or association of churches")
rule ChurchPlan414e(plan: Plan) strict {
    label en official "(1) with the (2) exclusions";
    when church_plan_established_by_church_or_association(plan)
        and church_plan_participants_substantially_all_church_employees(plan)
        and not_known(church_plan_primarily_for_unrelated_business_employees(plan));
    then church_plan_414e(plan);
}

pub relation church_plan_failure_notice_mailed_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the Secretary mailed a notice of default with respect to the church plan's failure to meet a requirement of subsection (e), on this date, case-asserted (section 414(e)(4)(C)(i))";
}

pub relation church_plan_court_correction_period_end(plan: Plan, on: Date) kind empirical {
    label en unofficial "the end of any period set by a court (or, absent one, a reasonable period determined by the Secretary) after a final determination of failure, case-asserted ((C)(ii))";
}

pub relation church_plan_additional_correction_period_end(plan: Plan, on: Date) kind empirical {
    label en unofficial "the end of any additional period the Secretary determines reasonable or necessary, case-asserted ((C)(iii))";
}

pub relation correction_period_candidate_end(plan: Plan, on: Date) kind institutional {
    label en official "section 414(e)(4)(C): a candidate end date of the correction period";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "the period, ending 270 days after the date of mailing by the Secretary of a notice of default with respect to the plan's failure to meet one or more of the requirements of this subsection")
rule CorrectionPeriodCandidateNotice(plan: Plan, mailed: Date) strict {
    label en official "clause (i): 270 days after mailing";
    when church_plan_failure_notice_mailed_on(plan, mailed);
    then correction_period_candidate_end(plan, add_calendar_period(mailed, 270 calendar_day));
}

rule CorrectionPeriodCandidateCourt(plan: Plan, on: Date) strict {
    label en unofficial "clause (ii)";
    when church_plan_court_correction_period_end(plan, on);
    then correction_period_candidate_end(plan, on);
}

rule CorrectionPeriodCandidateAdditional(plan: Plan, on: Date) strict {
    label en unofficial "clause (iii)";
    when church_plan_additional_correction_period_end(plan, on);
    then correction_period_candidate_end(plan, on);
}

pub relation correction_period_later_candidate_exists(plan: Plan, on: Date) kind institutional {
    label en unofficial "helper: a strictly later candidate end date exists (no strictly later candidate = the latest)";
}

rule CorrectionPeriodLaterCandidateExists(plan: Plan, on: Date, on2: Date) strict {
    label en unofficial "a strictly later candidate";
    when correction_period_candidate_end(plan, on) and correction_period_candidate_end(plan, on2) and on2 > on;
    then correction_period_later_candidate_exists(plan, on);
}

pub relation church_plan_correction_period_end(plan: Plan, on: Date) kind institutional {
    label en official "section 414(e)(4)(C): the correction period ends on whichever candidate date is latest";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "whichever has the latest ending date")
rule ChurchPlanCorrectionPeriodEnd(plan: Plan, on: Date) strict {
    label en official "the latest of the three candidates (G136 pattern)";
    when correction_period_candidate_end(plan, on) and not_known(correction_period_later_candidate_exists(plan, on));
    then church_plan_correction_period_end(plan, on);
}

pub relation church_plan_correction_made_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the plan corrects the failure on this date, case-asserted";
}

pub relation church_plan_deemed_not_meeting_requirements(plan: Plan, from: Date) kind institutional {
    label en official "section 414(e)(4)(B): if no correction is made within the correction period, the plan is deemed not to meet the requirements from the date of the earliest failure";
}

pub relation church_plan_earliest_failure_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the earliest failure to meet a requirement of subsection (e), case-asserted";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "If a correction is not made within the correction period, the plan shall be deemed not to meet the requirements of this subsection beginning with the date on which the earliest failure to meet one or more of such requirements occurred.")
rule ChurchPlanDeemedNotMeetingRequirements(plan: Plan, end: Date, first_failure: Date, decision_day: Date) strict {
    label en official "no correction on or before the period end (case supplies the evaluation date after the end)";
    when church_plan_correction_period_end(plan, end)
        and church_plan_earliest_failure_on(plan, first_failure)
        and church_plan_evaluated_on(plan, decision_day)
        and decision_day > end
        and not_known(church_plan_corrected_in_time(plan));
    then church_plan_deemed_not_meeting_requirements(plan, first_failure);
}

pub relation church_plan_evaluated_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date on which the compliance status is evaluated, case-asserted";
}

pub relation church_plan_corrected_in_time(plan: Plan) kind institutional {
    label en unofficial "helper: a correction was made on or before the correction period end";
}

rule ChurchPlanCorrectedInTime(plan: Plan, end: Date, corrected: Date) strict {
    label en unofficial "correction date not after the end";
    when church_plan_correction_period_end(plan, end) and church_plan_correction_made_on(plan, corrected) and corrected <= end;
    then church_plan_corrected_in_time(plan);
}

// =====================================================================
// (f) Multiemployer plan; (g) Plan administrator; (h) Pick-up
// =====================================================================

pub relation more_than_one_employer_required_to_contribute(plan: Plan) kind empirical {
    label en unofficial "more than one employer is required to contribute to the plan, case-asserted (414(f)(1)(A))";
}

pub relation maintained_under_collective_bargaining_with_more_than_one_employer(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained under one or more collective bargaining agreements between employee organizations and more than one employer, case-asserted ((f)(1)(B))";
}

pub relation satisfies_labor_secretary_regulation_requirements(plan: Plan) kind empirical {
    label en unofficial "the plan satisfies the other requirements the Secretary of Labor prescribes by regulation, case-asserted ((f)(1)(C))";
}

pub relation multiemployer_plan_414f(plan: Plan) kind institutional {
    label en official "section 414(f)(1): more than one employer contributes, collectively bargained, and meeting the Labor Secretary's other requirements";
}

@source(IRC_S414_F, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"multiemployer plan\" means a plan")
rule MultiemployerPlan414f(plan: Plan) strict {
    label en official "(A), (B) and (C)";
    when more_than_one_employer_required_to_contribute(plan)
        and maintained_under_collective_bargaining_with_more_than_one_employer(plan)
        and satisfies_labor_secretary_regulation_requirements(plan);
    then multiemployer_plan_414f(plan);
}

pub relation was_multiemployer_plan_for_preceding_plan_year(plan: Plan) kind empirical {
    label en unofficial "the plan was a multiemployer plan under this subsection for the plan year preceding its termination date under title IV of ERISA, case-asserted (414(f)(3))";
}

pub relation plan_terminated_under_erisa_title_iv(plan: Plan) kind empirical {
    label en unofficial "the plan has passed its termination date under title IV of ERISA, case-asserted";
}

@source(IRC_S414_F, relation = formalizes, coverage = exact, quote = "on and after its termination date under title IV of the Employee Retirement Income Security Act of 1974 if the plan was a multiemployer plan under this subsection for the plan year preceding its termination date")
rule MultiemployerPlanAfterTermination(plan: Plan) strict {
    label en official "status continues after the termination date";
    when plan_terminated_under_erisa_title_iv(plan) and was_multiemployer_plan_for_preceding_plan_year(plan);
    then multiemployer_plan_414f(plan);
}

pub relation plan_designated_administrator_by_instrument(plan: Plan, administrator: Person) kind empirical {
    label en unofficial "the person specifically so designated by the terms of the instrument under which the plan is operated, case-asserted (section 414(g)(1))";
}

pub relation plan_maintained_by_single_employer(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the plan is maintained by a single employer, case-asserted";
}

pub relation plan_maintained_by_group_representatives(plan: Plan, group: Person) kind empirical {
    label en unofficial "the plan is maintained by two or more employers (or jointly with employee organizations) and this association, committee or joint board of trustees represents the parties who maintain it, case-asserted ((g)(2)(B))";
}

pub relation plan_administrator_414g(plan: Plan, administrator: Person) kind institutional {
    label en official "section 414(g): the designated person, else the single employer, else the group of representatives of the parties maintaining the plan";
}

@source(IRC_S414_G, relation = formalizes, coverage = exact, quote = "the person specifically so designated by the terms of the instrument under which the plan is operated")
rule PlanAdministratorDesignated(plan: Plan, administrator: Person) strict {
    label en official "(1)";
    when plan_designated_administrator_by_instrument(plan, administrator);
    then plan_administrator_414g(plan, administrator);
}

@source(IRC_S414_G, relation = formalizes, coverage = exact, quote = "in the case of a plan maintained by a single employer, such employer")
rule PlanAdministratorSingleEmployer(plan: Plan, employer: Person) strict {
    label en official "(2)(A): only in the absence of a designation";
    when plan_maintained_by_single_employer(plan, employer) and not_known(plan_has_designated_administrator(plan));
    then plan_administrator_414g(plan, employer);
}

@source(IRC_S414_G, relation = formalizes, coverage = exact, quote = "in the case of a plan maintained by two or more employers or jointly by one or more employers and one or more employee organizations, the association, committee, joint board of trustees")
rule PlanAdministratorGroup(plan: Plan, group: Person) strict {
    label en official "(2)(B): only in the absence of a designation";
    when plan_maintained_by_group_representatives(plan, group) and not_known(plan_has_designated_administrator(plan));
    then plan_administrator_414g(plan, group);
}

pub relation plan_has_designated_administrator(plan: Plan) kind institutional {
    label en unofficial "helper: the instrument designates an administrator";
}

rule PlanHasDesignatedAdministrator(plan: Plan, administrator: Person) strict {
    label en unofficial "derives the helper";
    when plan_designated_administrator_by_instrument(plan, administrator);
    then plan_has_designated_administrator(plan);
}

pub relation contribution_designated_as_employee_contribution(c: Contribution) kind empirical {
    label en unofficial "the amount contributed to a section 401(a) trust or under a section 403(a) plan is designated as an employee contribution, case-asserted (section 414(h)(1))";
}

pub relation contribution_not_treated_as_made_by_employer(c: Contribution) kind institutional {
    label en official "section 414(h)(1): a designated employee contribution is not treated as made by the employer (taxable years beginning after 1973)";
}

@source(IRC_S414_H, relation = formalizes, coverage = exact, quote = "shall not be treated as having been made by the employer if it is designated as an employee contribution")
rule ContributionNotTreatedAsMadeByEmployer(c: Contribution) strict {
    label en official "the designation controls";
    when contribution_designated_as_employee_contribution(c) and not_known(governmental_pickup_of_designated_contribution(c));
    then contribution_not_treated_as_made_by_employer(c);
}

pub relation governmental_pickup_of_designated_contribution(c: Contribution) kind empirical {
    label en unofficial "in a governmental plan, an employing unit picks up a designated employee contribution, case-asserted (414(h)(2))";
}

pub relation pickup_treated_as_employer_contribution(c: Contribution) kind institutional {
    label en official "section 414(h)(2): contributions so picked up in a governmental plan are treated as employer contributions";
}

@source(IRC_S414_H, relation = formalizes, coverage = exact, quote = "the contributions so picked up shall be treated as employer contributions")
rule PickupTreatedAsEmployerContribution(c: Contribution) strict {
    label en official "the pick-up controls in a governmental plan";
    when contribution_designated_as_employee_contribution(c) and governmental_pickup_of_designated_contribution(c);
    then pickup_treated_as_employer_contribution(c);
}

// =====================================================================
// (i), (j), (k) Plan kinds; (l) merger and spin-off
// =====================================================================

pub relation plan_provides_individual_account_and_benefits_solely_from_account(plan: Plan) kind empirical {
    label en unofficial "the plan provides an individual account for each participant and benefits based solely on the amount contributed to the account and its income, expenses, gains and losses and forfeitures of other accounts, case-asserted (section 414(i))";
}

pub relation defined_contribution_plan_414i(plan: Plan) kind institutional {
    label en official "section 414(i): an individual account plan";
}

@source(IRC_S414_I, relation = formalizes, coverage = exact, quote = "the term \"defined contribution plan\" means a plan which provides for an individual account for each participant and for benefits based solely on the amount contributed to the participant's account")
rule DefinedContributionPlan414i(plan: Plan) strict {
    label en official "individual accounts and account-based benefits";
    when plan_provides_individual_account_and_benefits_solely_from_account(plan);
    then defined_contribution_plan_414i(plan);
}

pub relation defined_benefit_plan_414j(plan: Plan) kind institutional {
    label en official "section 414(j): any plan that is not a defined contribution plan";
}

@source(IRC_S414_J, relation = formalizes, coverage = exact, quote = "the term \"defined benefit plan\" means any plan which is not a defined contribution plan")
rule DefinedBenefitPlan414j(plan: Plan) defeasible {
    label en official "the complement of section 414(i), for a plan known to be a plan";
    when plan_sponsor(plan, _);
    unless defined_contribution_plan_414i(plan);
    then defined_benefit_plan_414j(plan);
}

pub relation db_plan_benefit_partly_based_on_separate_account(plan: Plan) kind empirical {
    label en unofficial "a defined benefit plan provides a benefit derived from employer contributions based partly on the balance of the participant's separate account, case-asserted (section 414(k))";
}

pub enum HybridPlanPurpose414k {
    Section410Participation;
    Section72dAnd411a7And415And401aMinimumRules;
    Section4975ProhibitedTransactions;
}

pub relation hybrid_plan_treated_as(plan: Plan, purpose: HybridPlanPurpose414k, treated_as_dc: Integer) kind institutional {
    label en official "section 414(k): a plan with a benefit partly based on a separate account is a defined contribution plan for section 410, a defined benefit plan (as to the account part and the rest, respectively) for sections 72(d), 411(a)(7)(A), 415 and 401(a)(4)/(1)-style rules, and a defined benefit plan for section 4975; the second argument is 1 for defined contribution treatment, 0 for defined benefit";
}

@source(IRC_S414_K, relation = formalizes, coverage = exact, quote = "for purposes of section 410 (relating to minimum participation standards), be treated as a defined contribution plan")
rule HybridPlanTreatedAsDcFor410(plan: Plan) strict {
    label en official "(1)";
    when db_plan_benefit_partly_based_on_separate_account(plan);
    then hybrid_plan_treated_as(plan, Section410Participation, 1);
}

@source(IRC_S414_K, relation = formalizes, coverage = exact, quote = "for purposes of section 4975 (relating to tax on prohibited transactions), be treated as a defined benefit plan")
rule HybridPlanTreatedAsDbFor4975(plan: Plan) strict {
    label en official "(3)";
    when db_plan_benefit_partly_based_on_separate_account(plan);
    then hybrid_plan_treated_as(plan, Section4975ProhibitedTransactions, 0);
}

pub relation merger_or_transfer_of_plan_after_1974(plan: Plan, on: Date) kind empirical {
    label en unofficial "a merger or consolidation with, or a transfer of assets or liabilities to, another plan on this date, case-asserted (section 414(l)(1))";
}

pub relation meets_414l1_merger_protection(plan: Plan, participant: Person, on: Date) kind institutional {
    label en official "section 414(l)(1): each participant would receive after the merger, consolidation or transfer a benefit at least equal to that before (as if the plan then terminated)";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "each participant in the plan would (if the plan then terminated) receive a benefit immediately after the merger, consolidation, or transfer which is equal to or greater than the benefit he would have been entitled to receive immediately before")
rule Meets414l1MergerProtection(plan: Plan, participant: Person, on: Date) strict {
    label en official "the same test as section 401(a)(12), read from module 23";
    when merger_protection_met(plan, participant, on);
    then meets_414l1_merger_protection(plan, participant, on);
}

pub relation spin_off_original_plan_fmv_before(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the fair market value of the assets of the original plan immediately before the spin-off, case-asserted (section 414(l)(2)(C)(i))";
}

pub relation spin_off_assets_required_after(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount of assets required to be allocated after the spin-off to all plans (without regard to paragraph (2)), case-asserted ((C)(ii))";
}

pub relation spin_off_excess_assets(plan: Plan, amount: Money) kind institutional {
    label en official "section 414(l)(2)(C): the excess of the original plan's assets before the spin-off over the assets required to be allocated to all plans afterwards";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "the term \"excess assets\" means an amount equal to the excess (if any) of")
rule SpinOffExcessAssets(plan: Plan, before: Money, required: Money) strict {
    label en official "before - required when positive (exact)";
    when spin_off_original_plan_fmv_before(plan, before) and spin_off_assets_required_after(plan, required) and before > required;
    then spin_off_excess_assets(plan, before - required);
}

pub relation plan_funding_target_plus_normal_cost(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the sum of the funding target and target normal cost determined under section 430, case-asserted (414(l)(2)(B)(i)(I))";
}

pub relation plan_assets_required_after_spin_off(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount of assets required to be allocated to the plan after the spin-off (without regard to paragraph (2)), case-asserted ((B)(i)(II))";
}

pub relation spin_off_plan_excess_amount(plan: Plan, amount: Money) kind institutional {
    label en official "section 414(l)(2)(B)(i): a plan's excess of (funding target + target normal cost) over its required assets";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "the sum of the funding target and target normal cost determined under section 430, over")
rule SpinOffPlanExcessAmount(plan: Plan, target: Money, required: Money) strict {
    label en official "target - required when positive";
    when plan_funding_target_plus_normal_cost(plan, target) and plan_assets_required_after_spin_off(plan, required) and target > required;
    then spin_off_plan_excess_amount(plan, target - required);
}

// =====================================================================
// (m) Affiliated service groups; (n) Leased employees
// =====================================================================

pub relation service_organization_shareholder_or_partner_regularly_performs_services(first: Person, org: Person) kind empirical {
    label en unofficial "the service organization is a shareholder or partner in the first organization and regularly performs services for it or is regularly associated with it in performing services for third persons, case-asserted (414(m)(2)(A))";
}

pub relation significant_portion_of_business_is_historically_employee_services(first: Person, org: Person) kind empirical {
    label en unofficial "a significant portion of the organization's business is performing services for the first organization (or the (A) organizations) of a type historically performed in that field by employees, case-asserted ((m)(2)(B)(i))";
}

pub relation interests_held_by_highly_compensated_of_first(org: Person, first: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the interests in the organization held by highly compensated employees of the first organization or a (A) organization, case-asserted ((m)(2)(B)(ii))";
}

pub relation affiliated_service_group_member_414m2(first: Person, org: Person) kind institutional {
    label en official "section 414(m)(2): an organization tied to the first service organization through (A) shareholder or partner services, or (B) historically-employee-type services and 10 percent HCE ownership";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "is a shareholder or partner in the first organization, and")
rule AffiliatedServiceGroupMemberA(first: Person, org: Person) strict {
    label en official "(A)";
    when service_organization_shareholder_or_partner_regularly_performs_services(first, org);
    then affiliated_service_group_member_414m2(first, org);
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "10 percent or more of the interests in such organization is held by persons who are highly compensated employees")
rule AffiliatedServiceGroupMemberB(first: Person, org: Person, pct: Decimal) strict {
    label en official "(B): exact boundary, 10 percent or more";
    when significant_portion_of_business_is_historically_employee_services(first, org)
        and interests_held_by_highly_compensated_of_first(org, first, pct)
        and pct >= 10.0;
    then affiliated_service_group_member_414m2(first, org);
}

pub relation leased_person_provided_under_agreement(person: Person, recipient: Person) kind empirical {
    label en unofficial "the person, not an employee of the recipient, provides services to the recipient under an agreement between the recipient and a leasing organization, case-asserted (section 414(n)(2)(A))";
}

pub relation leased_person_full_time_months(person: Person, recipient: Person, months: Integer) kind empirical {
    label en unofficial "the months the person has performed the services for the recipient (or the recipient and related persons) on a substantially full-time basis, case-asserted ((2)(B))";
}

pub relation services_under_recipient_primary_direction_or_control(person: Person, recipient: Person) kind empirical {
    label en unofficial "the services are performed under primary direction or control by the recipient, case-asserted ((2)(C))";
}

pub relation leased_employee_414n(person: Person, recipient: Person) kind institutional {
    label en official "section 414(n)(2): a non-employee who provides services under an agreement, full-time for at least 1 year, under the recipient's primary direction or control";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "such person has performed such services for the recipient (or for the recipient and related persons) on a substantially full-time basis for a period of at least 1 year")
rule LeasedEmployee414n(person: Person, recipient: Person, months: Integer) strict {
    label en official "exact boundary: 12 months";
    when leased_person_provided_under_agreement(person, recipient)
        and leased_person_full_time_months(person, recipient, months)
        and months >= 12
        and services_under_recipient_primary_direction_or_control(person, recipient);
    then leased_employee_414n(person, recipient);
}

pub relation leased_employee_treated_as_employee_of_recipient(person: Person, recipient: Person) kind institutional {
    label en official "section 414(n)(1)(A): for the listed requirements the leased employee is treated as the recipient's employee (only for periods after the 1-year period, (4)(A))";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "the leased employee shall be treated as an employee of the recipient")
rule LeasedEmployeeTreatedAsEmployeeOfRecipient(person: Person, recipient: Person) strict {
    label en official "(1)(A) once the person is a leased employee, subject to the safe harbor below";
    when leased_employee_414n(person, recipient) and not_known(leasing_org_safe_harbor_applies(person, recipient));
    then leased_employee_treated_as_employee_of_recipient(person, recipient);
}

pub relation leasing_org_plan_money_purchase_10_percent_rate(person: Person) kind empirical {
    label en unofficial "the leasing organization's plan is a money purchase pension plan with a nonintegrated employer contribution rate of at least 10 percent of compensation for each participant, case-asserted (414(n)(5)(B)(i))";
}

pub relation leasing_org_plan_full_immediate_vesting(person: Person) kind empirical {
    label en unofficial "the plan provides for full and immediate vesting, case-asserted ((5)(B)(ii))";
}

pub relation leasing_org_plan_immediate_participation(person: Person) kind empirical {
    label en unofficial "each employee of the leasing organization (other than those who perform substantially all of their services for it) immediately participates, case-asserted ((5)(B)(iii))";
}

pub relation leased_employees_count(recipient: Person, leased: Integer, nonhighly_compensated_work_force: Integer) kind empirical {
    label en unofficial "the number of leased employees (without regard to paragraph (5)) and of the recipient's nonhighly compensated work force, case-asserted ((5)(A)(ii), (c)(ii))";
}

pub relation leasing_org_safe_harbor_applies(person: Person, recipient: Person) kind institutional {
    label en official "section 414(n)(5)(A): the leased employee is not treated as the recipient's employee for the coverage and nondiscrimination requirements when covered by a qualifying plan of the leasing organization and leased employees are not more than 20 percent of the nonhighly compensated work force";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "leased employees (determined without regard to this paragraph) do not constitute more than 20 percent of the recipient's nonhighly compensated work force")
rule LeasingOrgSafeHarborApplies(person: Person, recipient: Person, leased: Integer, nhce: Integer) strict {
    label en official "exact by cross-multiplication: leased x 100 <= nhce x 20; the qualifying plan of (B)(i)-(iii)";
    when leased_employee_414n(person, recipient)
        and leasing_org_plan_money_purchase_10_percent_rate(person)
        and leasing_org_plan_full_immediate_vesting(person)
        and leasing_org_plan_immediate_participation(person)
        and leased_employees_count(recipient, leased, nhce)
        and leased * 100 <= nhce * 20;
    then leasing_org_safe_harbor_applies(person, recipient);
}

// =====================================================================
// (p)(7) QDRO timing; (q) HCE residual; (r) separate lines of business
// =====================================================================

pub relation first_payment_required_under_order_on(order: DomesticRelationsOrder, on: Date) kind empirical {
    label en unofficial "the date on which the first payment would be required to be made under the domestic relations order, case-asserted (414(p)(7)(E))";
}

pub relation qdro_determination_made_on(order: DomesticRelationsOrder, on: Date) kind empirical {
    label en unofficial "the date on which the order is determined to be a qualified domestic relations order, case-asserted";
}

pub relation qdro_determination_prospective_only(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(7)(D): a determination made after the 18-month period is applied prospectively only";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "Any determination that an order is a qualified domestic relations order which is made after the close of the 18-month period described in subparagraph (E) shall be applied prospectively only.")
rule QdroDeterminationProspectiveOnly(order: DomesticRelationsOrder, first: Date, determined: Date) strict {
    label en official "exact boundary: on the 18-month date the determination is still retroactive-capable, a day later is prospective only";
    when first_payment_required_under_order_on(order, first)
        and qdro_determination_made_on(order, determined)
        and determined > add_calendar_period(first, 18 calendar_month);
    then qdro_determination_prospective_only(order);
}

pub relation employee_rank_by_compensation(employee: Person, employer: Person, y: TaxableYear, rank: Integer) kind empirical {
    label en unofficial "the employee's rank (1 = highest) when the counted employees are ranked by compensation paid during the year, case-asserted (section 414(q)(3))";
}

pub relation counted_employees_for_top_paid_group(employer: Person, y: TaxableYear, total: Integer) kind empirical {
    label en unofficial "the number of employees ranked, after the (q)(5) exclusions, case-asserted";
}

pub relation in_top_paid_group_414q3(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 414(q)(3): among the top 20 percent of the employees ranked by compensation";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "An employee is in the top-paid group of employees for any year if such employee is in the group consisting of the top 20 percent of the employees when ranked on the basis of compensation paid during such year.")
rule InTopPaidGroup414q3(employee: Person, employer: Person, y: TaxableYear, rank: Integer, total: Integer) strict {
    label en official "exact: rank x 100 <= total x 20";
    when employee_rank_by_compensation(employee, employer, y, rank)
        and counted_employees_for_top_paid_group(employer, y, total)
        and rank * 100 <= total * 20;
    then in_top_paid_group_414q3(employee, employer, y);
}

pub enum Excludable414q5 {
    Under6MonthsOfService;
    Under17AndAHalfHoursPerWeek;
    WorksNotMoreThan6MonthsAYear;
    Under21;
    CollectivelyBargainedUnit;
}

pub relation employee_excludable_ground_414q5(employee: Person, ground: Excludable414q5) kind empirical {
    label en unofficial "the employee falls within this (q)(5) exclusion ground for the top-paid-group count and subsection (r), case-asserted";
}

pub relation employee_excluded_414q5(employee: Person) kind institutional {
    label en official "section 414(q)(5): employees with under 6 months of service, under 17 1/2 hours a week, working not more than 6 months a year, under 21, or in a collectively bargained unit are excluded";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who have not completed 6 months of service")
rule EmployeeExcluded414q5(employee: Person, ground: Excludable414q5) strict {
    label en official "any ground";
    when employee_excludable_ground_414q5(employee, ground);
    then employee_excluded_414q5(employee);
}

pub relation former_employee_hce_at_separation(employee: Person) kind empirical {
    label en unofficial "the former employee was a highly compensated employee when he separated from service, case-asserted (414(q)(6)(A))";
}

pub relation former_employee_hce_after_age_55(employee: Person) kind empirical {
    label en unofficial "the former employee was a highly compensated employee at any time after attaining age 55, case-asserted ((6)(B))";
}

pub relation former_employee_treated_as_hce(employee: Person) kind institutional {
    label en official "section 414(q)(6): a former employee is a highly compensated employee if he was one at separation or at any time after age 55";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "was a highly compensated employee when such employee separated from service")
rule FormerEmployeeHceAtSeparation(employee: Person) strict {
    label en official "(A)";
    when former_employee_hce_at_separation(employee);
    then former_employee_treated_as_hce(employee);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "was a highly compensated employee at any time after attaining age 55")
rule FormerEmployeeHceAfterAge55(employee: Person) strict {
    label en official "(B)";
    when former_employee_hce_after_age_55(employee);
    then former_employee_treated_as_hce(employee);
}

pub relation lob_employee_counts(employer: Person, lob_employees: Integer, lob_hces: Integer, all_employees: Integer, all_hces: Integer) kind empirical {
    label en unofficial "for a line of business: its employees and highly compensated employees, and the employer's totals, case-asserted (section 414(r)(3), (4))";
}

pub relation lob_hce_percentage_within_half_to_twice(employer: Person) kind institutional {
    label en official "section 414(r)(3)(A): the HCE percentage of the line of business is at least one-half and at most twice the HCE percentage of all employees";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "the highly compensated employee percentage with respect to such line of business is")
rule LobHcePercentageWithinHalfToTwice(employer: Person, le: Integer, lh: Integer, ae: Integer, ah: Integer) strict {
    label en official "exact integer cross-multiplication of the two percentages: lh/le >= (1/2) ah/ae and lh/le <= 2 ah/ae";
    when lob_employee_counts(employer, le, lh, ae, ah)
        and le > 0 and ae > 0
        and lh * ae * 2 >= ah * le
        and lh * ae <= ah * le * 2;
    then lob_hce_percentage_within_half_to_twice(employer);
}

pub relation lob_has_at_least_50_nonexcluded_employees(employer: Person, count: Integer) kind empirical {
    label en unofficial "the number of employees of the line of business not excluded under (q)(5), case-asserted (414(r)(2)(A))";
}

pub relation lob_notified_secretary(employer: Person) kind empirical {
    label en unofficial "the employer notifies the Secretary that the line of business is being treated as separate, case-asserted ((r)(2)(B))";
}

pub relation lob_meets_secretary_guidelines_or_determination(employer: Person) kind empirical {
    label en unofficial "the line of business meets the Secretary's guidelines or the employer received a determination, case-asserted ((r)(2)(C))";
}

pub relation separate_line_of_business_414r(employer: Person) kind institutional {
    label en official "section 414(r)(2): at least 50 nonexcluded employees, notice to the Secretary, and guidelines or determination — or the (3) percentage safe harbor in place of (C)";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "such line of business has at least 50 employees who are not excluded under subsection (q)(5)")
rule SeparateLineOfBusinessByGuidelines(employer: Person, n: Integer) strict {
    label en official "exact boundary: 50";
    when lob_has_at_least_50_nonexcluded_employees(employer, n)
        and n >= 50
        and lob_notified_secretary(employer)
        and lob_meets_secretary_guidelines_or_determination(employer);
    then separate_line_of_business_414r(employer);
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "The requirements of subparagraph (C) of paragraph (2) shall not apply to any line of business if the highly compensated employee percentage with respect to such line of business is")
rule SeparateLineOfBusinessByPercentageSafeHarbor(employer: Person, n: Integer) strict {
    label en official "(3)(A): the percentage test replaces (C)";
    when lob_has_at_least_50_nonexcluded_employees(employer, n)
        and n >= 50
        and lob_notified_secretary(employer)
        and lob_hce_percentage_within_half_to_twice(employer);
    then separate_line_of_business_414r(employer);
}

// =====================================================================
// (v) Catch-up contributions for individuals age 50 or over
// =====================================================================

pub enum CatchUpPlanKind414v {
    StandardPlan;
    SimplePlan;
    SmallEmployerSimplePlan110;
}

pub relation catch_up_plan_kind(plan: Plan, kind: CatchUpPlanKind414v) kind empirical {
    label en unofficial "the applicable employer plan is a standard plan (section 401(a), 403(b), 457(b), SEP), a section 401(k)(11) or 408(p) SIMPLE plan, or a SIMPLE plan of an employer with the 110-percent election, case-asserted (section 414(v)(2)(B))";
}

pub relation participant_attains_age_by_year_end(participant: Person, y: TaxableYear, age: Integer) kind empirical {
    label en unofficial "the age the participant attains by the close of the taxable year, case-asserted (section 414(v)(2)(B)(i) parenthetical, (5)(A))";
}

pub relation indexed_catch_up_2024_amount(kind: CatchUpPlanKind414v, amount: Money) kind empirical {
    label en unofficial "the cost-of-living adjusted dollar amount in effect under (B)(i) or (ii) for the calendar year 2024 (2025 for the SIMPLE adjusted amount), case-asserted (SOURCE_GAP: the indexed amounts are not pinned; only the statutory bases are)";
}

pub relation catch_up_applicable_dollar_amount(plan: Plan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(v)(2)(B),(E): the applicable dollar amount for the participant";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "the applicable dollar amount is $5,000 (the adjusted dollar amount, in the case of an eligible participant who would attain age 60 but would not attain age 64 before the close of the taxable year)")
rule CatchUpApplicableDollarAmountStandard(plan: Plan, participant: Person, y: TaxableYear, age: Integer) strict {
    label en official "$5,000 base (pinned statutory base; indexing SOURCE_GAP) when the participant does not attain 60 through 63";
    when catch_up_plan_kind(plan, StandardPlan)
        and participant_attains_age_by_year_end(participant, y, age)
        and (age < 60 or age >= 64);
    then catch_up_applicable_dollar_amount(plan, participant, y, CATCH_UP_CONTRIBUTION_LIMIT + 0.00 USD);
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "an amount equal to 150 percent of the dollar amount which would be in effect under such clause for 2024")
rule CatchUpApplicableDollarAmountStandardAge60To63(plan: Plan, participant: Person, y: TaxableYear, age: Integer, indexed: Money) strict {
    label en official "(E)(i): max($10,000, 150 percent of the 2024 indexed amount), for attaining 60 but not 64 (ages 60 to 63)";
    when catch_up_plan_kind(plan, StandardPlan)
        and participant_attains_age_by_year_end(participant, y, age)
        and age >= 60 and age < 64
        and indexed_catch_up_2024_amount(StandardPlan, indexed);
    then catch_up_applicable_dollar_amount(plan, participant, y, max(10000.00 USD, indexed * 1.5));
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "the applicable dollar amount is $2,500 (the adjusted dollar amount, in the case of an eligible participant who would attain age 60 but would not attain age 64 before the close of the taxable year)")
rule CatchUpApplicableDollarAmountSimple(plan: Plan, participant: Person, y: TaxableYear, age: Integer) strict {
    label en official "$2,500 base (statutory) for a SIMPLE plan outside ages 60-63";
    when catch_up_plan_kind(plan, SimplePlan)
        and participant_attains_age_by_year_end(participant, y, age)
        and (age < 60 or age >= 64);
    then catch_up_applicable_dollar_amount(plan, participant, y, 2500.00 USD);
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "an amount equal to equal to [3] 150 percent of the dollar amount which would be in effect under such clause for 2025")
rule CatchUpApplicableDollarAmountSimpleAge60To63(plan: Plan, participant: Person, y: TaxableYear, age: Integer, indexed: Money) strict {
    label en official "(E)(ii): max($5,000, 150 percent of the 2025 indexed amount) for ages 60 to 63";
    when catch_up_plan_kind(plan, SimplePlan)
        and participant_attains_age_by_year_end(participant, y, age)
        and age >= 60 and age < 64
        and indexed_catch_up_2024_amount(SimplePlan, indexed);
    then catch_up_applicable_dollar_amount(plan, participant, y, max(5000.00 USD, indexed * 1.5));
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "the applicable dollar amount is an amount equal to 110 percent of the dollar amount in effect under clause (ii) for calendar year 2024")
rule CatchUpApplicableDollarAmountSimple110(plan: Plan, participant: Person, y: TaxableYear, indexed: Money) strict {
    label en official "(B)(iii): 110 percent of the 2024 clause (ii) amount";
    when catch_up_plan_kind(plan, SmallEmployerSimplePlan110)
        and participant_attains_age_by_year_end(participant, y, _)
        and indexed_catch_up_2024_amount(SimplePlan, indexed);
    then catch_up_applicable_dollar_amount(plan, participant, y, indexed * 1.10);
}

pub relation catch_up_participant_compensation(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's compensation as defined in section 415(c)(3) for the year, case-asserted";
}

pub relation catch_up_other_elective_deferrals(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's other elective deferrals for the year, made without regard to the subsection, case-asserted";
}

pub relation catch_up_maximum_additional_deferrals(plan: Plan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(v)(2)(A): the lesser of the applicable dollar amount and the excess of compensation over other elective deferrals";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "A plan shall not permit additional elective deferrals under paragraph (1) for any year in an amount greater than the lesser of")
rule CatchUpMaximumAdditionalDeferrals(plan: Plan, participant: Person, y: TaxableYear, dollar: Money, comp: Money, other: Money) strict {
    label en official "min(dollar amount, max(0, compensation - other deferrals))";
    when catch_up_applicable_dollar_amount(plan, participant, y, dollar)
        and catch_up_participant_compensation(participant, y, comp)
        and catch_up_other_elective_deferrals(participant, y, other);
    then catch_up_maximum_additional_deferrals(plan, participant, y, min(dollar, max(comp - other, 0.00 USD)));
}

pub relation catch_up_additional_deferrals_made(plan: Plan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the additional elective deferrals the plan permits for the participant under paragraph (1), case-asserted";
}

pub relation plan_permits_excess_catch_up(plan: Plan, participant: Person, y: TaxableYear) kind institutional {
    label en official "the plan permits additional deferrals above the (2)(A) maximum (the breach of the limitation on the plan's terms)";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "A plan shall not permit additional elective deferrals under paragraph (1) for any year in an amount greater than the lesser of")
rule PlanPermitsExcessCatchUp(plan: Plan, participant: Person, y: TaxableYear, permitted: Money, maximum: Money) strict {
    label en official "exact: permitted > maximum";
    when catch_up_additional_deferrals_made(plan, participant, y, permitted)
        and catch_up_maximum_additional_deferrals(plan, participant, y, maximum)
        and permitted > maximum;
    then plan_permits_excess_catch_up(plan, participant, y);
}

pub relation eligible_participant_414v5(plan: Plan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 414(v)(5): a participant who attains age 50 by the end of the year and who can make no further elective deferrals because of a limit";
}

pub relation participant_hit_other_deferral_limit(plan: Plan, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "no other elective deferrals may be made for the plan year by reason of a limitation or restriction described in paragraph (3) or a plan-imposed limit, case-asserted (414(v)(5)(B))";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "who would attain age 50 by the end of the taxable year")
rule EligibleParticipant414v5(plan: Plan, participant: Person, y: TaxableYear, age: Integer) strict {
    label en official "exact boundary: age 50 by year end";
    when participant_attains_age_by_year_end(participant, y, age)
        and age >= 50
        and participant_hit_other_deferral_limit(plan, participant, y);
    then eligible_participant_414v5(plan, participant, y);
}

pub relation prior_year_fica_wages_from_employer(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's wages (section 3121(a)) for the preceding calendar year from the employer sponsoring the plan, case-asserted (section 414(v)(7)(A))";
}

pub relation roth_only_catch_up_required(plan: Plan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 414(v)(7)(A): for a participant whose prior-year wages exceed $145,000 additional deferrals are permitted only as designated Roth contributions (SIMPLE and SEP plans excepted); the indexed threshold is a case input";
}

pub relation roth_catch_up_wage_threshold(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the $145,000 amount as adjusted for the year after 2024 (SOURCE_GAP: the adjusted amount is not pinned), case-asserted";
}

pub relation catch_up_plan_is_simple_or_sep(plan: Plan) kind empirical {
    label en unofficial "the plan is an arrangement described in section 408(k) or (p) ((6)(A)(iv)), to which (7)(A) does not apply, case-asserted";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "whose wages (as defined in section 3121(a)) for the preceding calendar year from the employer sponsoring the plan exceed $145,000")
rule RothOnlyCatchUpRequired(plan: Plan, participant: Person, y: TaxableYear, wages: Money, threshold: Money) strict {
    label en official "exact boundary: wages above the threshold (equal is not above)";
    when plan_sponsor(plan, _) and prior_year_fica_wages_from_employer(participant, y, wages)
        and roth_catch_up_wage_threshold(y, threshold)
        and wages > threshold
        and not_known(catch_up_plan_is_simple_or_sep(plan));
    then roth_only_catch_up_required(plan, participant, y);
}

// =====================================================================
// (w) Permissible withdrawals from eligible automatic contribution arrangements
// =====================================================================

pub relation first_elective_contribution_under_eaca_on(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the first elective contribution with respect to the employee under the arrangement, case-asserted (section 414(w)(2)(B))";
}

pub relation permissible_withdrawal_election_made_on(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the employee elects a permissible withdrawal, case-asserted";
}

pub relation permissible_withdrawal_election_in_time(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(w)(2)(B): the election is made no later than 90 days after the first elective contribution";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "unless the election is made no later than the date which is 90 days after the date of the first elective contribution with respect to the employee under the arrangement")
rule PermissibleWithdrawalElectionInTime(employee: Person, plan: Plan, first: Date, on: Date) strict {
    label en official "exact boundary: day 90 is in time, day 91 is not";
    when first_elective_contribution_under_eaca_on(employee, plan, first)
        and permissible_withdrawal_election_made_on(employee, plan, on)
        and on <= add_calendar_period(first, 90 calendar_day);
    then permissible_withdrawal_election_in_time(employee, plan);
}

pub relation eaca_withdrawal_amount_and_first_payroll_contributions(employee: Person, plan: Plan, withdrawn: Money, first_payroll_contributions: Money) kind empirical {
    label en unofficial "the amount withdrawn and the elective contributions (and attributable earnings) of the first payroll period to which the automatic contribution applied through the election date, case-asserted (414(w)(2)(C))";
}

pub relation permissible_withdrawal_amount_ok(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(w)(2)(C): the distribution equals the elective contributions from the first payroll period through the election, adjusted for earnings";
}

@source(IRC_S414_W, relation = formalizes, coverage = partial, quote = "Subparagraph (A) shall not apply to any election by an employee unless the amount of any distribution by reason of the election is equal to the amount of elective contributions made with respect to the first payroll period")
rule PermissibleWithdrawalAmountOk(employee: Person, plan: Plan, withdrawn: Money, contributions: Money) strict {
    label en official "PARTIAL: equality of the two case-supplied amounts";
    when eaca_withdrawal_amount_and_first_payroll_contributions(employee, plan, withdrawn, contributions) and withdrawn <= contributions and withdrawn >= contributions;
    then permissible_withdrawal_amount_ok(employee, plan);
}

pub relation permissible_withdrawal_valid(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(w)(2): an election in time for the right amount is a permissible withdrawal";
}

rule PermissibleWithdrawalValid(employee: Person, plan: Plan) strict {
    label en official "both (B) and (C)";
    when permissible_withdrawal_election_in_time(employee, plan) and permissible_withdrawal_amount_ok(employee, plan);
    then permissible_withdrawal_valid(employee, plan);
}

pub relation withdrawal_includible_in_gross_income_414w(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(w)(1)(A)-(B): the withdrawal is includible in gross income for the year of the distribution and bears no section 72(t) tax";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "the amount of any such withdrawal shall be includible in the gross income of the employee for the taxable year of the employee in which the distribution is made")
rule WithdrawalIncludibleInGrossIncome414w(employee: Person, plan: Plan) strict {
    label en official "effect of a valid permissible withdrawal";
    when permissible_withdrawal_valid(employee, plan);
    then withdrawal_includible_in_gross_income_414w(employee, plan);
}

pub relation eaca_uniform_percentage_default(plan: Plan) kind empirical {
    label en unofficial "the participant is treated as electing a uniform percentage of compensation until he specifically elects otherwise, case-asserted (414(w)(3)(B))";
}

pub relation eaca_election_available(plan: Plan) kind empirical {
    label en unofficial "a participant may elect contributions or cash, case-asserted (414(w)(3)(A))";
}

pub relation eaca_notice_requirements_met(plan: Plan) kind empirical {
    label en unofficial "the notice requirements of paragraph (4) are met, case-asserted";
}

pub relation eligible_automatic_contribution_arrangement_414w(plan: Plan) kind institutional {
    label en official "section 414(w)(3): an arrangement under an applicable employer plan with an election, a uniform automatic percentage, and the notice requirements";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "the term \"eligible automatic contribution arrangement\" means an arrangement under an applicable employer plan")
rule EligibleAutomaticContributionArrangement414w(plan: Plan) strict {
    label en official "(A), (B), (C)";
    when eaca_election_available(plan) and eaca_uniform_percentage_default(plan) and eaca_notice_requirements_met(plan);
    then eligible_automatic_contribution_arrangement_414w(plan);
}

// =====================================================================
// (y) CSEC plans; (z) church plan transfers; (aa)-(cc)
// =====================================================================

pub relation csec_defined_benefit_not_multiemployer(plan: Plan) kind empirical {
    label en unofficial "the plan is a defined benefit plan other than a multiemployer plan to which section 104 of the Pension Protection Act of 2006 applies, case-asserted (section 414(y)(1)(A))";
}

pub relation csec_multiple_501c3_employers_at_june_25_2010(plan: Plan) kind empirical {
    label en unofficial "as of June 25, 2010 the plan was maintained by more than one employer, all section 501(c)(3) organizations, case-asserted ((1)(B))";
}

pub relation csec_children_services_employer_at_june_25_2010(plan: Plan) kind empirical {
    label en unofficial "as of June 25, 2010 the plan was maintained by a 501(c)(3) employer chartered under title 36 with employees in at least 40 States whose primary exempt purpose is services with respect to children, case-asserted ((1)(C))";
}

pub relation csec_medical_research_employer_at_jan_1_2000(plan: Plan) kind empirical {
    label en unofficial "as of January 1, 2000 the plan was maintained by a 501(c)(3) employer in existence since at least 1938 that conducts medical research and whose primary exempt purpose is services for mothers and children, case-asserted ((1)(D))";
}

pub relation csec_plan_414y(plan: Plan) kind institutional {
    label en official "section 414(y)(1): a defined benefit plan (not multiemployer) meeting one of (B), (C), (D)";
}

@source(IRC_S414_Y, relation = formalizes, coverage = exact, quote = "that, as of June 25, 2010, was maintained by more than one employer and all of the employers were organizations described in section 501(c)(3)")
rule CsecPlanB(plan: Plan) strict {
    label en official "(A) and (B)";
    when csec_defined_benefit_not_multiemployer(plan) and csec_multiple_501c3_employers_at_june_25_2010(plan);
    then csec_plan_414y(plan);
}

@source(IRC_S414_Y, relation = formalizes, coverage = exact, quote = "that, as of June 25, 2010, was maintained by an employer")
rule CsecPlanC(plan: Plan) strict {
    label en official "(A) and (C)";
    when csec_defined_benefit_not_multiemployer(plan) and csec_children_services_employer_at_june_25_2010(plan);
    then csec_plan_414y(plan);
}

@source(IRC_S414_Y, relation = formalizes, coverage = exact, quote = "that, as of January 1, 2000, was maintained by an employer")
rule CsecPlanD(plan: Plan) strict {
    label en official "(A) and (D)";
    when csec_defined_benefit_not_multiemployer(plan) and csec_medical_research_employer_at_jan_1_2000(plan);
    then csec_plan_414y(plan);
}

pub relation church_transfer_total_accrued_benefit_before_after(participant: Person, before: Money, after: Money) kind empirical {
    label en unofficial "the participant's total accrued benefit immediately before and after a church plan transfer or merger, case-asserted (section 414(z)(2))";
}

pub relation church_transfer_no_inclusion(participant: Person) kind institutional {
    label en official "section 414(z)(1)-(2): no amount is includible by reason of the transfer or merger when the total accrued benefit after is at least that before";
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to a transfer or merger unless the participant's or beneficiary's total accrued benefit immediately after the transfer or merger is equal to or greater than")
rule ChurchTransferNoInclusion(participant: Person, before: Money, after: Money) strict {
    label en official "exact: after >= before";
    when church_transfer_total_accrued_benefit_before_after(participant, before, after) and after >= before;
    then church_transfer_no_inclusion(participant);
}

pub relation error_first_occurred_plan_year_end(employee: Person, end: Date) kind empirical {
    label en unofficial "the last day of the plan year during which the implementation error with respect to the employee first occurred, case-asserted (section 414(cc)(2)(B)(i)(I))";
}

pub relation error_corrected_on(employee: Person, on: Date) kind empirical {
    label en unofficial "the date the implementation error is corrected (first payment of compensation on or after the relevant date), case-asserted";
}

pub relation error_correction_in_time_414cc(employee: Person) kind institutional {
    label en official "section 414(cc)(2)(B)(i)(I): corrected not later than the first payment of compensation on or after the last day of the 9 1/2 month period after the end of the plan year in which the error first occurred";
}

@source(IRC_S414_CC, relation = formalizes, coverage = partial, quote = "the date of the first payment of compensation made by the employer to the employee on or after the last day of the 9½ month-period after the end of the plan year during which such error with respect to the employee first occurred")
rule ErrorCorrectionInTime414cc(employee: Person, end: Date, on: Date) strict {
    label en official "PARTIAL: the first-payment-of-compensation refinement is the case supplying the correction date; the deadline is end + 9 months + 15 days";
    when error_first_occurred_plan_year_end(employee, end)
        and error_corrected_on(employee, on)
        and on <= add_calendar_period(add_calendar_period(end, 9 calendar_month), 15 calendar_day);
    then error_correction_in_time_414cc(employee);
}

pub relation error_notice_given_days_after_correct_deferrals_begin(employee: Person, days: Integer) kind empirical {
    label en unofficial "the number of days after the date correct deferrals begin on which notice of the error was given, case-asserted (section 414(cc)(2)(B)(iv))";
}

pub relation error_notice_in_time_414cc(employee: Person) kind institutional {
    label en official "section 414(cc)(2)(B)(iv): notice of the error is given not later than 45 days after correct deferrals begin";
}

@source(IRC_S414_CC, relation = formalizes, coverage = exact, quote = "notice of such error is given to the employee not later than 45 days after the date on which correct deferrals begin")
rule ErrorNoticeInTime414cc(employee: Person, days: Integer) strict {
    label en official "exact boundary: day 45 is in time, day 46 is not";
    when error_notice_given_days_after_correct_deferrals_begin(employee, days) and days <= 45;
    then error_notice_in_time_414cc(employee);
}

pub relation unenrolled_participant_furnished_initial_documents(employee: Person) kind empirical {
    label en unofficial "the employee has been furnished the summary plan description and the initial eligibility notices, is not participating, and meets any other criteria, case-asserted (section 414(bb)(2))";
}

pub relation unenrolled_participant_414bb(employee: Person) kind institutional {
    label en official "section 414(bb)(2): an eligible employee, furnished the initial documents, who is not participating";
}

pub relation employee_eligible_dc_plan_not_participating(employee: Person) kind empirical {
    label en unofficial "the employee is eligible to participate in a defined contribution plan and is not participating in it, case-asserted";
}

@source(IRC_S414_BB, relation = formalizes, coverage = partial, quote = "has been furnished")
rule UnenrolledParticipant414bb(employee: Person) strict {
    label en official "PARTIAL: (A)-(C); the Secretary's other criteria in (D) are not pinned";
    when employee_eligible_dc_plan_not_participating(employee) and unenrolled_participant_furnished_initial_documents(employee);
    then unenrolled_participant_414bb(employee);
}
