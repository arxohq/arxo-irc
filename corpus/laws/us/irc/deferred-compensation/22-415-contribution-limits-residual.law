// Section 415 — STAGE 2e residual, part 2 (IRC-09, DECISION-0379,
// 25.09.2026): (a)(1)(B)/(a)(2) consequences, (c) the defined contribution
// limitation chain — participant's compensation (3)(A)-(E) with the (8)
// difficulty-of-care increase, the ESOP and qualified-gratuitous-transfer
// adjustments of (6), church plan alternatives of (7) — (k)(2) qualified
// cost-of-living arrangements, (m) qualified governmental excess benefit
// arrangements, (n) permissive service credit.
//
// Method as in module 21: derived relations one statutory step at a time,
// the final `dc_addition_exceeds_415c` is what (a)(1)(B) and section
// 401(a)(16) read; module 13's headline test stays unchanged.

// =====================================================================
// (c)(3) Participant's compensation; (c)(8) difficulty of care payments
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    IRC_S415_A,
    IRC_S415_C,
    IRC_S415_K,
    IRC_S415_M,
    IRC_S415_N,
    Person,
    Plan,
    ServiceDisallowed404A,
    TaxableYear,
    annual_addition_computed,
    annual_benefit,
    db_benefit_exceeds_415b,
    db_compensation_limit_applicable,
    db_dollar_limit_applicable,
    highly_compensated_employee,
};

pub relation compensation_from_employer_415c3A(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation of the participant from the employer for the year, case-asserted (section 415(c)(3)(A))";
}

pub relation self_employed_415c3B(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant is an employee within section 401(c)(1), case-asserted";
}

pub relation earned_income_401c2_without_911(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "earned income within section 401(c)(2) determined without regard to any exclusion under section 911, case-asserted (section 415(c)(3)(B))";
}

pub relation annuity_contract_403b_participant(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contribution is for an annuity contract described in section 403(b), case-asserted";
}

pub relation includible_compensation_403b3(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's includible compensation determined under section 403(b)(3), case-asserted (section 415(c)(3)(E))";
}

pub relation permanently_totally_disabled_22e3(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant is permanently and totally disabled within section 22(e)(3), case-asserted";
}

pub relation employer_of_participant_415c(participant: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer maintaining the plan for this participant, case-asserted";
}

pub relation employer_elected_disability_rule_415c3C(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects, at the time and in the manner the Secretary prescribes, to have (c)(3)(C) apply, case-asserted";
}

pub relation disabled_contributions_nonforfeitable_when_made(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "contributions made with respect to the deemed compensation are nonforfeitable when made, case-asserted";
}

pub relation plan_continues_contributions_for_all_disabled(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the plan continues contributions on behalf of all participants who are permanently and totally disabled for a fixed or determinable period, case-asserted";
}

pub relation disability_rate_compensation(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation the participant would have received for the year at the rate paid immediately before becoming permanently and totally disabled, case-asserted";
}

pub relation disability_compensation_rule_applies(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(3)(C): disabled participant, deemed compensation applies (employer election and non-HCE, or a plan-wide continuation for a fixed period), contributions nonforfeitable when made";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "This subparagraph shall apply only if contributions made with respect to amounts treated as compensation under this subparagraph are nonforfeitable when made.")
rule DisabilityCompensationRuleApplies(participant: Person, y: TaxableYear, employer: Person) strict {
    label en official "clauses (i)-(iii) and nonforfeitability";
    when permanently_totally_disabled_22e3(participant, y)
        and employer_of_participant_415c(participant, employer, y)
        and not_known(highly_compensated_employee(participant, employer, y))
        and employer_elected_disability_rule_415c3C(participant, y)
        and disabled_contributions_nonforfeitable_when_made(participant, y);
    then disability_compensation_rule_applies(participant, y);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "this subparagraph shall be applied without regard to clauses (ii) and (iii)")
rule DisabilityCompensationRuleAppliesContinuation(participant: Person, y: TaxableYear) strict {
    label en official "plan-wide continuation for a fixed or determinable period drops clauses (ii) and (iii)";
    when permanently_totally_disabled_22e3(participant, y)
        and plan_continues_contributions_for_all_disabled(participant, y)
        and disabled_contributions_nonforfeitable_when_made(participant, y);
    then disability_compensation_rule_applies(participant, y);
}

pub relation compensation_415c3_base(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(3)(A)/(B)/(C)/(E): the base measure of compensation for the participant";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "The term \"participant's compensation\" means the compensation of the participant from the employer for the year.")
rule Compensation415c3BaseEmployee(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "ordinary employee: compensation from the employer";
    when compensation_from_employer_415c3A(participant, y, amount)
        and not_known(self_employed_415c3B(participant, y))
        and not_known(annuity_contract_403b_participant(participant, y))
        and not_known(disability_compensation_rule_applies(participant, y));
    then compensation_415c3_base(participant, y, amount);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "the participant's earned income (within the meaning of section 401(c)(2) but determined without regard to any exclusion under section 911)")
rule Compensation415c3BaseSelfEmployed(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "self-employed: earned income without the section 911 exclusion";
    when self_employed_415c3B(participant, y) and earned_income_401c2_without_911(participant, y, amount);
    then compensation_415c3_base(participant, y, amount);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "the compensation the participant would have received for the year if the participant was paid at the rate of compensation paid immediately before becoming permanently and totally disabled")
rule Compensation415c3BaseDisabled(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "disabled: deemed compensation at the pre-disability rate";
    when disability_compensation_rule_applies(participant, y) and disability_rate_compensation(participant, y, amount);
    then compensation_415c3_base(participant, y, amount);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "the term \"participant's compensation\" means the participant's includible compensation determined under section 403(b)(3)")
rule Compensation415c3Base403b(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "annuity contract under section 403(b): includible compensation";
    when annuity_contract_403b_participant(participant, y) and includible_compensation_403b3(participant, y, amount);
    then compensation_415c3_base(participant, y, amount);
}

pub enum CompensationAdditionKind415 {
    ElectiveDeferral402g3;
    CafeteriaOrSection457Deferral;
    DifficultyOfCarePayment;
}

pub relation compensation_addition_415c(participant: Person, y: TaxableYear, kind: CompensationAdditionKind415, amount: Money) kind empirical {
    label en unofficial "an amount added to the participant's compensation: an elective deferral (section 402(g)(3)), an employee-elected amount excluded under section 125, 132(f)(4) or 457 ((c)(3)(D)), or an excluded difficulty of care payment ((c)(8)(A)), case-asserted";
}

pub relation participant_compensation_415c(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(3)/(8): the participant's compensation for the year: the base plus the listed additions";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "The term \"participant's compensation\" shall include")
rule ParticipantCompensation415c(participant: Person, y: TaxableYear, base: Money) strict {
    label en official "base + sum of the additions (each kind added once as asserted)";
    when compensation_415c3_base(participant, y, base);
    then participant_compensation_415c(participant, y,
        base + sum all amt: Money for k: CompensationAdditionKind415 where compensation_addition_415c(participant, y, k, amt));
}

pub relation foster_care_contribution_allowable_due_to_increase(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution by the participant that is allowable only because of the (c)(8)(A) increase, case-asserted";
}

pub relation foster_care_contribution_is_investment_in_contract(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(8)(B)(i): the contribution is investment in the contract for the title";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "shall be treated for purposes of this title as investment in the contract")
rule FosterCareContributionInvestmentInContract(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "after-tax treatment of the contribution allowed by the increase";
    when foster_care_contribution_allowable_due_to_increase(participant, y, amount);
    then foster_care_contribution_is_investment_in_contract(participant, y, amount);
}

pub relation plan_not_failing_for_foster_care_contributions(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(8)(B)(ii): allowing such contributions does not by itself cause the plan to fail any requirement of the chapter";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "shall not cause a plan (and any arrangement which is part of such plan) to be treated as failing to meet any requirements of this chapter solely by reason of allowing any such contributions")
rule PlanNotFailingForFosterCareContributions(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "safe-harbor effect";
    when foster_care_contribution_allowable_due_to_increase(participant, y, amount);
    then plan_not_failing_for_foster_care_contributions(participant, y);
}

// =====================================================================
// (c)(6) ESOP and qualified gratuitous transfer adjustments
// =====================================================================

pub enum AnnualAdditionExclusionKind415 {
    LoanFundedForfeiture;
    DeductibleEsopContribution404a9B;
    QualifiedGratuitousTransfer;
}

pub relation annual_addition_exclusion_item(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, kind: AnnualAdditionExclusionKind415, amount: Money) kind empirical {
    label en unofficial "an amount included in the annual addition that (c)(6) may exclude: a forfeiture of employer securities acquired with a loan ((A)), an employer contribution deductible under section 404(a)(9)(B) and charged against the account ((B)), or a section 664(g) qualified gratuitous transfer, case-asserted";
}

pub relation esop_deductible_contributions_total(plan: DefinedContributionPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer contributions to the employee stock ownership plan for the year that are deductible under section 404(a)(9), case-asserted";
}

pub relation esop_allocated_to_highly_compensated(plan: DefinedContributionPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of those contributions allocated to highly compensated employees within section 414(q), case-asserted";
}

pub relation esop_one_third_test_met(plan: DefinedContributionPlan, y: TaxableYear) kind institutional {
    label en official "section 415(c)(6): no more than one-third of the deductible ESOP employer contributions are allocated to highly compensated employees";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "If no more than one-third of the employer contributions to an employee stock ownership plan")
rule EsopOneThirdTestMet(plan: DefinedContributionPlan, y: TaxableYear, hce: Money, total: Money) strict {
    label en official "exact boundary by cross-multiplication: 3 x HCE share <= total";
    when esop_allocated_to_highly_compensated(plan, y, hce)
        and esop_deductible_contributions_total(plan, y, total)
        and hce * 3 <= total;
    then esop_one_third_test_met(plan, y);
}

pub relation dc_annual_addition_adjusted(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(6): the annual addition after the ESOP exclusions (when the one-third test is met) and without a qualified gratuitous transfer";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "the limitations imposed by this section shall not apply to")
rule DcAnnualAdditionAdjustedEsop(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, total: Money) strict {
    label en official "the ESOP items and any qualified gratuitous transfer come out of the annual addition";
    when annual_addition_computed(plan, participant, y, total) and esop_one_third_test_met(plan, y);
    then dc_annual_addition_adjusted(plan, participant, y,
        total - sum all amt: Money for k: AnnualAdditionExclusionKind415 where annual_addition_exclusion_item(plan, participant, y, k, amt));
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "but such amount shall not be taken into account in determining whether any other amount exceeds the limitations imposed by this section")
rule DcAnnualAdditionAdjustedNoEsop(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, total: Money, qgt: Money) strict {
    label en official "one-third test not met: only a qualified gratuitous transfer comes out";
    when annual_addition_computed(plan, participant, y, total)
        and not_known(esop_one_third_test_met(plan, y))
        and annual_addition_exclusion_item(plan, participant, y, QualifiedGratuitousTransfer, qgt);
    then dc_annual_addition_adjusted(plan, participant, y, total - qgt);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "but such amount shall not be taken into account in determining whether any other amount exceeds the limitations imposed by this section")
rule DcAnnualAdditionAdjustedPlain(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, total: Money) strict {
    label en official "no adjustment applies";
    when annual_addition_computed(plan, participant, y, total)
        and not_known(esop_one_third_test_met(plan, y))
        and not_known(dc_has_qgt_item(plan, participant, y));
    then dc_annual_addition_adjusted(plan, participant, y, total);
}

pub relation dc_has_qgt_item(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en unofficial "helper: a qualified gratuitous transfer item is asserted (avoids an existential negation over the amount)";
}

rule DcHasQgtItem(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the helper";
    when annual_addition_exclusion_item(plan, participant, y, QualifiedGratuitousTransfer, amount);
    then dc_has_qgt_item(plan, participant, y);
}

pub relation qgt_exceeds_415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(6) last sentence: the qualified gratuitous transfer itself may not exceed the limitations";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "The amount of any qualified gratuitous transfer (as defined in section 664(g)(1)) allocated to a participant for any limitation year shall not exceed the limitations imposed by this section")
rule QgtExceeds415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, qgt: Money, comp: Money) strict {
    label en official "the transfer alone is tested against min(dollar limit, 100 percent of compensation)";
    when annual_addition_exclusion_item(plan, participant, y, QualifiedGratuitousTransfer, qgt)
        and participant_compensation_415c(participant, y, comp)
        and qgt > min(SECTION415C_DOLLAR_LIMIT, comp);
    then qgt_exceeds_415c(plan, participant, y);
}

// =====================================================================
// (c)(7) Church plans
// =====================================================================

pub relation church_employee_election_415c7(participant: Person, plan: DefinedContributionPlan, y: TaxableYear) kind empirical {
    label en unofficial "the participant is an employee of a church or convention or association of churches (including a section 414(e)(3)(B)(ii) organization) and elects the alternative limitation for a section 403(b) annuity contract or retirement income account, case-asserted";
}

pub relation church_alternative_additions_all_years(participant: Person, total: Money) kind empirical {
    label en unofficial "the total additions with respect to the participant taken into account under (c)(7)(A) for all years, case-asserted (section 415(c)(7)(A)(ii))";
}

pub relation church_alternative_limit_applies(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(7)(A): the annual addition is treated as within the limitation when it is at most $10,000 and the all-years total is at most $40,000";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "if such annual addition is not in excess of $10,000")
rule ChurchAlternativeLimitApplies(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, addition: Money, total: Money) strict {
    label en official "exact boundaries: $10,000 annual and $40,000 aggregate are both allowed, one cent above either is not";
    when church_employee_election_415c7(participant, plan, y)
        and annual_addition_computed(plan, participant, y, addition)
        and addition <= 10000.00 USD
        and church_alternative_additions_all_years(participant, total)
        and total <= 40000.00 USD;
    then church_alternative_limit_applies(plan, participant, y);
}

pub relation foreign_missionary_church_employee(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual performs services outside the United States as an employee described in (c)(7)(B), case-asserted";
}

pub relation adjusted_gross_income_415c7C(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "adjusted gross income for the year, determined separately and without regard to community property laws, case-asserted";
}

pub relation foreign_missionary_limit_applies(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(7)(C): at most $3,000 for a foreign missionary whose adjusted gross income does not exceed $17,000";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "shall not be treated as exceeding the limitation of paragraph (1) if such annual addition is not in excess of $3,000")
rule ForeignMissionaryLimitApplies(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, addition: Money, agi: Money) strict {
    label en official "exact boundaries: $3,000 and $17,000 are allowed, one cent above either is not";
    when foreign_missionary_church_employee(participant, y)
        and annual_addition_computed(plan, participant, y, addition)
        and addition <= 3000.00 USD
        and adjusted_gross_income_415c7C(participant, y, agi)
        and agi <= 17000.00 USD;
    then foreign_missionary_limit_applies(plan, participant, y);
}

// =====================================================================
// (a)(1)(B) Final exceedance and disqualification; (a)(2)
// =====================================================================

pub relation dc_addition_exceeds_415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(1): the adjusted annual addition is greater than the lesser of the dollar limit and 100 percent of the participant's compensation, unless (c)(7) treats it as within the limitation";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "such annual addition is greater than the lesser of")
rule DcAdditionExceeds415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, addition: Money, comp: Money) defeasible {
    label en official "adjusted addition > min(dollar limit, compensation), with the church and missionary alternatives as exceptions";
    when dc_annual_addition_adjusted(plan, participant, y, addition)
        and participant_compensation_415c(participant, y, comp)
        and addition > min(SECTION415C_DOLLAR_LIMIT, comp);
    unless church_alternative_limit_applies(plan, participant, y);
    then dc_addition_exceeds_415c(plan, participant, y);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "such annual addition is greater than the lesser of")
rule DcAdditionExceeds415cMissionary(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, addition: Money, comp: Money) defeasible {
    label en official "same test with the foreign missionary exception";
    when dc_annual_addition_adjusted(plan, participant, y, addition)
        and participant_compensation_415c(participant, y, comp)
        and addition > min(SECTION415C_DOLLAR_LIMIT, comp);
    unless foreign_missionary_limit_applies(plan, participant, y);
    then dc_addition_exceeds_415c(plan, participant, y);
}

pub relation trust_disqualified_by_415a1B(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(a)(1)(B): a trust that is part of a defined contribution plan with additions above the (c) limitation does not constitute a qualified trust under section 401(a)";
}

@source(IRC_S415_A, relation = formalizes, coverage = exact, quote = "in the case of a defined contribution plan, contributions and other additions under the plan with respect to any participant for any taxable year exceed the limitation of subsection (c)")
rule TrustDisqualifiedBy415a1B(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) defeasible {
    label en official "the final exceedance disqualifies";
    when dc_addition_exceeds_415c(plan, participant, y);
    then trust_disqualified_by_415a1B(plan, participant, y);
}

pub relation dc_limit_satisfied_415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c): the participant's annual addition does not exceed the limitation";
}

rule DcLimitSatisfied415c(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) defeasible {
    label en unofficial "no final exceedance for a participant with an annual addition";
    when annual_addition_computed(plan, participant, y, _)
        and not_known(dc_addition_exceeds_415c(plan, participant, y));
    then dc_limit_satisfied_415c(plan, participant, y);
}

pub relation plan_kind_403a_403b_408k(plan: Plan) kind empirical {
    label en unofficial "the contract, plan or pension is claimed to be an employee annuity plan under section 403(a), an annuity contract under section 403(b) or a simplified employee pension under section 408(k), case-asserted";
}

pub relation plan_has_participant_over_415_limit(plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: some participant exceeds the applicable section 415 limit (avoids an existential negation)";
}

rule PlanHasParticipantOverLimitDb(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person) defeasible {
    label en unofficial "a defined benefit participant over the limit";
    when db_benefit_exceeds_415b(plan, participant, y);
    then plan_has_participant_over_415_limit(plan, y);
}

rule PlanHasParticipantOverLimitDc(plan: DefinedContributionPlan, y: TaxableYear, participant: Person) defeasible {
    label en unofficial "a defined contribution participant over the limit";
    when dc_addition_exceeds_415c(plan, participant, y);
    then plan_has_participant_over_415_limit(plan, y);
}

pub relation disqualified_under_415g(plan: Plan) kind empirical {
    label en unofficial "the contract, plan or pension has been disqualified under subsection (g) (aggregation with a controlled-group plan), case-asserted (the Secretary's regulations under (g) are not modelled)";
}

pub relation described_in_403_or_408k_for_415(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 415(a)(2): the contract, plan or pension is considered described in section 403(a), 403(b) or 408(k) only if it satisfies (1)(A) or (1)(B) and has not been disqualified under (g)";
}

@source(IRC_S415_A, relation = formalizes, coverage = partial, quote = "such a contract, plan, or pension shall not be considered to be described in section 403(a), 403(b), or 408(k), as the case may be, unless it satisfies the requirements of subparagraph (A) or subparagraph (B) of paragraph (1)")
rule DescribedIn403Or408kFor415(plan: Plan, y: TaxableYear) defeasible {
    label en official "PARTIAL: the whole-contract test; the 403(b) sentence limiting the consequence to the excess portion is not modelled";
    when plan_kind_403a_403b_408k(plan) and qualified_plan_year_anchor(plan, y)
        and not_known(plan_has_participant_over_415_limit(plan, y))
        and not_known(disqualified_under_415g(plan));
    then described_in_403_or_408k_for_415(plan, y);
}

pub relation qualified_plan_year_anchor(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year under test, case-asserted (binds the year for the (a)(2) test)";
}

// =====================================================================
// (k)(2) Qualified cost-of-living arrangements
// =====================================================================

pub entity CostOfLivingArrangement {
    label en unofficial "an arrangement under a defined benefit plan that provides a cost-of-living adjustment (section 415(k)(2)(B))";
}

pub relation col_arrangement_of(arr: CostOfLivingArrangement, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the arrangement is maintained under this defined benefit plan, case-asserted";
}

pub relation col_provides_adjustment_to_benefit(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the arrangement provides a cost-of-living adjustment to a benefit under the plan or a separate plan subject to section 412, case-asserted (section 415(k)(2)(B)(i))";
}

pub relation col_based_on_post_annuity_start_increases(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the adjustment is based on increases in the cost of living after the annuity starting date, case-asserted (section 415(k)(2)(C)(i))";
}

pub relation col_based_on_prescribed_average_indexes(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the adjustment is based on average cost-of-living increases determined by reference to indexes prescribed by the Secretary, case-asserted (section 415(k)(2)(C)(ii))";
}

pub relation col_is_elective(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the arrangement is elective, case-asserted (section 415(k)(2)(D))";
}

pub relation col_same_terms_for_all_participants(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the arrangement is available under the same terms to all participants, case-asserted";
}

pub relation col_election_available_at_retirement_or_separation(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the election may at least be made in the year the participant attains the earliest retirement age (without regard to any separation requirement) or separates from service, case-asserted";
}

pub relation col_key_employee_eligible(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "a key employee (section 416(i)(1), except that in a plan that is not top-heavy an individual who is a key employee solely under 416(i)(1)(A)(i) is not one) is eligible to participate, case-asserted (section 415(k)(2)(F))";
}

pub relation col_pattern_of_discrimination_found(arr: CostOfLivingArrangement) kind empirical {
    label en unofficial "the Secretary has found that a pattern of discrimination exists with respect to participation (section 415(k)(2)(E)), case-asserted: the finding is an act of record of the Secretary, so its absence leaves the arrangement qualified; whether such a pattern exists is not computed here";
}

pub relation qualified_cost_of_living_arrangement(arr: CostOfLivingArrangement) kind institutional {
    label en official "section 415(k)(2)(B): an arrangement meeting (B)(i), (C), (D), (E) and (F)";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "the term \"qualified cost-of-living arrangement\" means an arrangement under a defined benefit plan which")
rule QualifiedCostOfLivingArrangement(arr: CostOfLivingArrangement, plan: DefinedBenefitPlan) defeasible {
    label en official "all four requirements; the Secretary's other requirements are not pinned";
    when col_arrangement_of(arr, plan)
        and col_provides_adjustment_to_benefit(arr)
        and col_based_on_post_annuity_start_increases(arr)
        and col_based_on_prescribed_average_indexes(arr)
        and col_is_elective(arr)
        and col_same_terms_for_all_participants(arr)
        and col_election_available_at_retirement_or_separation(arr)
        and not_known(col_key_employee_eligible(arr))
        and not_known(col_pattern_of_discrimination_found(arr));
    then qualified_cost_of_living_arrangement(arr);
}

pub relation col_employee_contribution(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution made directly by the employee under the arrangement, case-asserted";
}

pub relation col_contribution_not_annual_addition(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(k)(2)(A)(i): the contribution is not an annual addition for purposes of subsection (c)";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "any contribution made directly by an employee under such an arrangement shall not be treated as an annual addition for purposes of subsection (c)")
rule ColContributionNotAnnualAddition(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "effect for a qualified arrangement";
    when qualified_cost_of_living_arrangement(arr) and col_employee_contribution(arr, participant, y, amount);
    then col_contribution_not_annual_addition(arr, participant, y, amount);
}

pub relation col_benefit_from_transferred_employer_contribution(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a benefit under the arrangement allocable to an employer contribution transferred from a defined contribution plan to which subsection (c) was applied, case-asserted";
}

pub relation col_benefit_treated_as_employee_derived(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(k)(2)(A)(ii): for subsection (b) the benefit is treated as derived from an employee contribution, and subsection (c) does not apply again";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "shall, for purposes of subsection (b), be treated as a benefit derived from an employee contribution")
rule ColBenefitTreatedAsEmployeeDerived(arr: CostOfLivingArrangement, participant: Person, y: TaxableYear, amount: Money) defeasible {
    label en official "reclassification of the transferred-contribution benefit";
    when qualified_cost_of_living_arrangement(arr) and col_benefit_from_transferred_employer_contribution(arr, participant, y, amount);
    then col_benefit_treated_as_employee_derived(arr, participant, y, amount);
}

// =====================================================================
// (m) Qualified governmental excess benefit arrangements
// =====================================================================

pub entity GovernmentalPlanPortion {
    label en unofficial "a portion of a governmental plan (section 415(m)(3))";
}

pub relation portion_maintained_solely_for_excess_benefits(portion: GovernmentalPlanPortion) kind empirical {
    label en unofficial "the portion is maintained solely to provide that part of the annual benefit otherwise payable that exceeds the section 415 limitations, case-asserted (section 415(m)(3)(A))";
}

pub relation portion_provides_election_to_defer(portion: GovernmentalPlanPortion) kind empirical {
    label en unofficial "the portion provides at some time an election, directly or indirectly, to defer compensation, case-asserted (defeats (m)(3)(B))";
}

pub relation portion_benefits_paid_from_plan_trust(portion: GovernmentalPlanPortion) kind empirical {
    label en unofficial "the excess benefits are paid from a trust forming a part of the governmental plan, case-asserted";
}

pub relation trust_maintained_solely_for_excess_benefits(portion: GovernmentalPlanPortion) kind empirical {
    label en unofficial "that trust is maintained solely for the purpose of providing the excess benefits, case-asserted (section 415(m)(3)(C))";
}

pub relation qualified_governmental_excess_benefit_arrangement(portion: GovernmentalPlanPortion) kind institutional {
    label en official "section 415(m)(3): a portion of a governmental plan maintained solely for excess benefits, with no deferral election, and not paid from the plan trust unless that trust is solely for those benefits";
}

@source(IRC_S415_M, relation = formalizes, coverage = exact, quote = "the term \"qualified governmental excess benefit arrangement\" means a portion of a governmental plan if")
rule QgebaNotPaidFromTrust(portion: GovernmentalPlanPortion) strict {
    label en official "(A) and (B) met and benefits not paid from a plan trust";
    when portion_maintained_solely_for_excess_benefits(portion)
        and not_known(portion_provides_election_to_defer(portion))
        and not_known(portion_benefits_paid_from_plan_trust(portion));
    then qualified_governmental_excess_benefit_arrangement(portion);
}

@source(IRC_S415_M, relation = formalizes, coverage = exact, quote = "benefits described in subparagraph (A) are not paid from a trust forming a part of such governmental plan unless such trust is maintained solely for the purpose of providing such benefits")
rule QgebaPaidFromSoleTrust(portion: GovernmentalPlanPortion) strict {
    label en official "(A) and (B) met and paid from a trust maintained solely for those benefits";
    when portion_maintained_solely_for_excess_benefits(portion)
        and not_known(portion_provides_election_to_defer(portion))
        and portion_benefits_paid_from_plan_trust(portion)
        and trust_maintained_solely_for_excess_benefits(portion);
    then qualified_governmental_excess_benefit_arrangement(portion);
}

pub relation qgeba_benefit_amount(portion: GovernmentalPlanPortion, governmental_plan: Plan, amount: Money) kind empirical {
    label en unofficial "benefits provided under the arrangement, case-asserted";
}

pub relation qgeba_benefit_disregarded_for_415(portion: GovernmentalPlanPortion, governmental_plan: Plan, amount: Money) kind institutional {
    label en official "section 415(m)(1): benefits under a qualified governmental excess benefit arrangement are not taken into account in determining whether the governmental plan meets section 415";
}

@source(IRC_S415_M, relation = formalizes, coverage = exact, quote = "benefits provided under a qualified governmental excess benefit arrangement shall not be taken into account")
rule QgebaBenefitDisregarded(portion: GovernmentalPlanPortion, governmental_plan: Plan, amount: Money) strict {
    label en official "disregard for the plan's own limitation test";
    when qualified_governmental_excess_benefit_arrangement(portion) and qgeba_benefit_amount(portion, governmental_plan, amount);
    then qgeba_benefit_disregarded_for_415(portion, governmental_plan, amount);
}

pub relation qgeba_treated_as_nonqualified_deferral_plan(portion: GovernmentalPlanPortion) kind institutional {
    label en official "section 415(m)(2): participants are taxed as if the arrangement were a deferral plan of a taxable corporation that does not meet section 401";
}

@source(IRC_S415_M, relation = formalizes, coverage = exact, quote = "shall be determined as if such qualified governmental excess benefit arrangement were treated as a plan for the deferral of compensation which is maintained by a corporation not exempt from tax under this chapter")
rule QgebaTreatedAsNonqualifiedDeferralPlan(portion: GovernmentalPlanPortion) strict {
    label en official "the classification whose downstream taxation (sections 83, 409A, 451) belongs to other owners";
    when qualified_governmental_excess_benefit_arrangement(portion);
    then qgeba_treated_as_nonqualified_deferral_plan(portion);
}

// =====================================================================
// (n) Permissive service credit
// =====================================================================

pub entity PermissiveServiceCreditItem {
    label en unofficial "a block of service credit a participant may buy under a defined benefit governmental plan (section 415(n)(3))";
}

pub enum CreditServiceKind415n {
    GovernmentEmployee;
    EducationalOrganizationEmployee;
    EmployeeAssociationEmployee;
    MilitaryService;
    OtherService;
}

pub relation service_credit_recognized_by_plan(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "the credit is recognized by the governmental plan for calculating the benefit, case-asserted (section 415(n)(3)(A)(i))";
}

pub relation service_credit_not_yet_received(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "the participant has not received the credit under the plan (or it increases a benefit for credit being received), case-asserted (section 415(n)(3)(A)(ii))";
}

pub relation service_credit_only_by_voluntary_contribution(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "the credit may be received only by a voluntary additional contribution, in an amount determined under the plan, not exceeding the amount needed to fund the benefit, case-asserted (section 415(n)(3)(A)(iii))";
}

pub relation permissive_service_credit(item: PermissiveServiceCreditItem) kind institutional {
    label en official "section 415(n)(3)(A): service credit that is recognized, not yet received, and purchasable only by a capped voluntary contribution";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "The term \"permissive service credit\" means service credit")
rule PermissiveServiceCredit(item: PermissiveServiceCreditItem) strict {
    label en official "the three clauses together";
    when service_credit_recognized_by_plan(item)
        and service_credit_not_yet_received(item)
        and service_credit_only_by_voluntary_contribution(item);
    then permissive_service_credit(item);
}

pub relation service_credit_kind(item: PermissiveServiceCreditItem, kind: CreditServiceKind415n) kind empirical {
    label en unofficial "the kind of service the credit is for, case-asserted (section 415(n)(3)(C))";
}

pub relation credit_gives_second_benefit_for_same_service(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "recognition would cause the participant to receive a retirement benefit for the same service under more than one plan, case-asserted (section 415(n)(3)(C) last sentence)";
}

pub relation service_is_qualified_military_414u(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "the military service is qualified military service under section 414(u), case-asserted";
}

pub relation nonqualified_service_credit(item: PermissiveServiceCreditItem) kind institutional {
    label en official "section 415(n)(3)(C): permissive service credit other than for government service, educational organization service, employee-association service or military service (other than 414(u) service), and such government, educational or association service that duplicates another plan's benefit";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "the term \"nonqualified service credit\" means permissive service credit other than that allowed with respect to")
rule NonqualifiedServiceCreditOther(item: PermissiveServiceCreditItem) strict {
    label en official "service of a kind not listed in (i)-(iv)";
    when permissive_service_credit(item) and service_credit_kind(item, OtherService);
    then nonqualified_service_credit(item);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "In the case of service described in clause (i), (ii), or (iii), such service will be nonqualified service if recognition of such service would cause a participant to receive a retirement benefit for the same service under more than one plan.")
rule NonqualifiedServiceCreditDuplicateGovernment(item: PermissiveServiceCreditItem) strict {
    label en official "government service that duplicates a benefit";
    when permissive_service_credit(item)
        and service_credit_kind(item, GovernmentEmployee)
        and credit_gives_second_benefit_for_same_service(item);
    then nonqualified_service_credit(item);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "In the case of service described in clause (i), (ii), or (iii), such service will be nonqualified service if recognition of such service would cause a participant to receive a retirement benefit for the same service under more than one plan.")
rule NonqualifiedServiceCreditDuplicateEducation(item: PermissiveServiceCreditItem) strict {
    label en official "educational organization service that duplicates a benefit";
    when permissive_service_credit(item)
        and service_credit_kind(item, EducationalOrganizationEmployee)
        and credit_gives_second_benefit_for_same_service(item);
    then nonqualified_service_credit(item);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "In the case of service described in clause (i), (ii), or (iii), such service will be nonqualified service if recognition of such service would cause a participant to receive a retirement benefit for the same service under more than one plan.")
rule NonqualifiedServiceCreditDuplicateAssociation(item: PermissiveServiceCreditItem) strict {
    label en official "employee-association service that duplicates a benefit";
    when permissive_service_credit(item)
        and service_credit_kind(item, EmployeeAssociationEmployee)
        and credit_gives_second_benefit_for_same_service(item);
    then nonqualified_service_credit(item);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "military service (other than qualified military service under section 414(u)) recognized by such governmental plan")
rule NonqualifiedServiceCreditMilitary(item: PermissiveServiceCreditItem) strict {
    label en official "clause (iv) lists military service OTHER THAN qualified 414(u) service as allowed, so credit for qualified 414(u) military service falls outside the list and is nonqualified (textual reading, recorded as an interpretation in the coverage row)";
    when permissive_service_credit(item)
        and service_credit_kind(item, MilitaryService)
        and service_is_qualified_military_414u(item);
    then nonqualified_service_credit(item);
}

pub relation nonqualified_credit_years_total(participant: Person, plan: Plan, years: Decimal) kind empirical {
    label en unofficial "the total years of nonqualified service credit taken into account under subsection (n), case-asserted (an aggregate over the derived nonqualified_service_credit is a section 111 limitation; the per-item classification above is executable)";
}

pub relation years_of_participation_when_credit_counted(participant: Person, plan: Plan, item: PermissiveServiceCreditItem, years: Decimal) kind empirical {
    label en unofficial "the participant's years of participation under the plan at the time the credit is taken into account, case-asserted";
}

pub relation trustee_transfer_403b13_or_457e17(item: PermissiveServiceCreditItem) kind empirical {
    label en unofficial "the credit is purchased by a trustee-to-trustee transfer to which section 403(b)(13)(A) or 457(e)(17)(A) applies, case-asserted (section 415(n)(3)(D))";
}

pub relation plan_fails_415n3B(plan: Plan, participant: Person) kind institutional {
    label en official "section 415(n)(3)(B): more than 5 years of nonqualified service credit, or any such credit counted before 5 years of participation";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "more than 5 years of nonqualified service credit are taken into account for purposes of this subsection")
rule PlanFails415n3BTooMuch(plan: Plan, participant: Person, years: Decimal) defeasible {
    label en official "exact boundary: 5 years allowed, more than 5 fails";
    when nonqualified_credit_years_total(participant, plan, years) and years > 5.0;
    then plan_fails_415n3B(plan, participant);
}

pub relation credit_subject_to_5_year_participation_rule(item: PermissiveServiceCreditItem) kind institutional {
    label en unofficial "helper: nonqualified credit that is not bought by a section 403(b)(13)/457(e)(17) trustee-to-trustee transfer ((n)(3)(D)(i))";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "the limitations of subparagraph (B) shall not apply in determining whether the transfer is for the purchase of permissive service credit")
rule CreditSubjectTo5YearParticipationRule(item: PermissiveServiceCreditItem) strict {
    label en official "a trustee-to-trustee transfer is outside the (B) limitations";
    when nonqualified_service_credit(item) and not_known(trustee_transfer_403b13_or_457e17(item));
    then credit_subject_to_5_year_participation_rule(item);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "any nonqualified service credit is taken into account under this subsection before the employee has at least 5 years of participation under the plan")
rule PlanFails415n3BTooEarly(plan: Plan, participant: Person, item: PermissiveServiceCreditItem, years: Decimal) defeasible {
    label en official "exact boundary: 5 years of participation is enough, less fails";
    when credit_subject_to_5_year_participation_rule(item)
        and years_of_participation_when_credit_counted(participant, plan, item, years)
        and years < 5.0;
    then plan_fails_415n3B(plan, participant);
}

pub relation contributions_to_purchase_credit(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's contributions to purchase permissive service credit for the year, case-asserted (section 415(n)(1))";
}

pub relation accrued_benefit_from_credit_contributions(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the accrued benefit derived from all such contributions, treated as an annual benefit under (n)(1)(A), case-asserted";
}

pub relation section415_met_with_permissive_credit(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(n)(1): the section 415 requirements are treated as met only if (A) (b) is met with the credit-derived accrued benefit as an annual benefit, or (B) (c) is met with the contributions as annual additions";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "the requirements of subsection (b) are met, determined by treating the accrued benefit derived from all such contributions as an annual benefit for purposes of subsection (b)")
rule Section415MetWithPermissiveCreditViaB(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefit: Money, credit_benefit: Money, dollar: Money, comp: Money) strict {
    label en official "alternative (A): (annual benefit + credit-derived accrued benefit) <= min(dollar limit, compensation limit); the (2)(A) rule that the reduced (b)(2)(C) limit is not failed solely by reason of this subsection is not modelled";
    when contributions_to_purchase_credit(plan, participant, y, _)
        and annual_benefit(plan, participant, y, benefit)
        and accrued_benefit_from_credit_contributions(plan, participant, y, credit_benefit)
        and db_dollar_limit_applicable(plan, participant, y, dollar)
        and db_compensation_limit_applicable(plan, participant, y, comp)
        and benefit + credit_benefit <= min(dollar, comp);
    then section415_met_with_permissive_credit(plan, participant, y);
}
