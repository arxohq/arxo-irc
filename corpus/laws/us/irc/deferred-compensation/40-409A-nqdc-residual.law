// Section 409A — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 09 carries the distribution events, the specified employee delay, the
// acceleration prohibition, the deferral election timing, the plan failure
// inclusion, the 20 percent tax and interest. This module adds (a)(2)(B)
// and (C) the emergency and disability tests, (a)(4)(B)-(C) the subsequent
// election rules, (b) the funding rules (offshore trusts, financial health
// triggers, the restricted period of an underfunded plan, the tax
// gross-up), and (d) the definition of a nonqualified deferred compensation
// plan.
//
// Method: a test is a conjunction of case-asserted facts with exact
// thresholds; dates use exact calendar arithmetic (the IRC calendar-step
// policy is needed in a scenario).

// =====================================================================
// (a)(2)(B), (C) Unforeseeable emergency and disability
// =====================================================================

use self::{
    IRC_S409A_A,
    IRC_S409A_B,
    IRC_S409A_D,
    NonqualifiedDeferredCompensationPlan,
    Person,
    Plan,
};

pub relation emergency_distribution_amount_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the amount distributed by reason of an unforeseeable emergency, case-asserted (section 409A(a)(2)(B)(ii))";
}

pub relation emergency_need_amount_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, need: Money, taxes: Money, relieved: Money) kind empirical {
    label en unofficial "the amount necessary to satisfy the emergency, the taxes reasonably anticipated from the distribution, and the extent the hardship is or may be relieved by insurance, compensation or liquidation of assets, case-asserted";
}

pub relation emergency_distribution_within_need_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(a)(2)(B)(ii)(II): the distribution does not exceed the emergency amount plus anticipated taxes, after the relief available";
}

@source(IRC_S409A_A, relation = formalizes, coverage = partial, quote = "the amounts distributed with respect to an emergency do not exceed the amounts necessary to satisfy such emergency plus amounts necessary to pay taxes reasonably anticipated as a result of the distribution")
rule EmergencyDistributionWithinNeed409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money, need: Money, taxes: Money, relieved: Money) strict {
    label en official "PARTIAL: exact boundary: the distribution may equal need + taxes - relief; the severe hardship itself is a judgment (see the coverage row)";
    when emergency_distribution_amount_409A(plan, participant, amount)
        and emergency_need_amount_409A(plan, participant, need, taxes, relieved)
        and amount <= need + taxes - relieved;
    then emergency_distribution_within_need_409A(plan, participant);
}

pub relation unable_to_engage_in_gainful_activity_409A(participant: Person) kind empirical {
    label en unofficial "the participant is unable to engage in any substantial gainful activity by reason of a medically determinable impairment expected to result in death or to last at least 12 continuous months, case-asserted ((C)(i))";
}

pub relation income_replacement_months_409A(participant: Person, months: Integer) kind empirical {
    label en unofficial "the months the participant has received income replacement benefits under an employer accident and health plan, by reason of such an impairment, case-asserted ((C)(ii))";
}

pub relation participant_disabled_409A2C(participant: Person) kind institutional {
    label en official "section 409A(a)(2)(C): disabled when unable to engage in gainful activity, or receiving income replacement benefits for at least 3 months";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "is unable to engage in any substantial gainful activity by reason of any medically determinable physical or mental impairment")
rule ParticipantDisabledGainfulActivity409A2C(participant: Person) strict {
    label en official "(i)";
    when unable_to_engage_in_gainful_activity_409A(participant);
    then participant_disabled_409A2C(participant);
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "receiving income replacement benefits for a period of not less than 3 months under an accident and health plan covering employees of the participant's employer")
rule ParticipantDisabledIncomeReplacement409A2C(participant: Person, months: Integer) strict {
    label en official "(ii): exact boundary: 3 months";
    when income_replacement_months_409A(participant, months) and months >= 3;
    then participant_disabled_409A2C(participant);
}

// =====================================================================
// (a)(4) Subsequent elections
// =====================================================================

pub relation subsequent_election_made_on_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date a subsequent election delaying a payment or changing its form is made, case-asserted (section 409A(a)(4)(C))";
}

pub relation subsequent_election_takes_effect_on_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date the subsequent election takes effect, case-asserted";
}

pub relation subsequent_election_effective_delay_ok_409A4Ci(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(a)(4)(C)(i): the election does not take effect until at least 12 months after it is made";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "the plan requires that such election may not take effect until at least 12 months after the date on which the election is made")
rule SubsequentElectionEffectiveDelayOk409A4Ci(plan: NonqualifiedDeferredCompensationPlan, participant: Person, made: Date, effective_on: Date) strict {
    label en official "exact boundary: the 12-month anniversary itself is allowed";
    when subsequent_election_made_on_409A(plan, participant, made)
        and subsequent_election_takes_effect_on_409A(plan, participant, effective_on)
        and effective_on >= add_calendar_period(made, 12 calendar_month);
    then subsequent_election_effective_delay_ok_409A4Ci(plan, participant);
}

pub relation payment_otherwise_due_on_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date the payment would otherwise have been made, case-asserted ((C)(ii))";
}

pub relation payment_deferred_until_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date to which the payment is deferred by the subsequent election, case-asserted";
}

pub relation election_applies_to_event_payment_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind empirical {
    label en unofficial "the election relates to a payment described in (2)(A)(ii), (iii) or (vi) (disability, death, emergency), case-asserted ((C)(ii))";
}

pub relation subsequent_election_five_year_deferral_ok_409A4Cii(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(a)(4)(C)(ii): a payment other than disability, death or emergency must be deferred for at least 5 years from the date it would otherwise be made";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "the plan requires that the payment with respect to which such election is made be deferred for a period of not less than 5 years from the date such payment would otherwise have been made")
rule SubsequentElectionFiveYearDeferralOk409A4Cii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, due: Date, deferred: Date) strict {
    label en official "exact boundary: the fifth anniversary itself is allowed; an election on a disability, death or emergency payment needs no 5-year deferral";
    when payment_otherwise_due_on_409A(plan, participant, due)
        and payment_deferred_until_409A(plan, participant, deferred)
        and not_known(election_applies_to_event_payment_409A(plan, participant))
        and deferred >= add_calendar_period(due, 5 calendar_year);
    then subsequent_election_five_year_deferral_ok_409A4Cii(plan, participant);
}

pub relation first_scheduled_payment_on_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date of the first scheduled payment under the specified time or fixed schedule, case-asserted ((C)(iii))";
}

pub relation subsequent_election_lead_time_ok_409A4Ciii(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(a)(4)(C)(iii): an election related to a specified-time payment may not be made less than 12 months before the first scheduled payment";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "may not be made less than 12 months prior to the date of the first scheduled payment under such paragraph")
rule SubsequentElectionLeadTimeOk409A4Ciii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, made: Date, first_payment: Date, calendar_before_1: Date) strict {
    label en official "exact boundary: an election exactly 12 months before is allowed";
    when subsequent_election_made_on_409A(plan, participant, made)
        and first_scheduled_payment_on_409A(plan, participant, first_payment)
        and made <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(first_payment, 12, us.irc.core::CalendarMonth, calendar_before_1);
    then subsequent_election_lead_time_ok_409A4Ciii(plan, participant);
}

pub relation performance_period_end_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, end: Date) kind empirical {
    label en unofficial "the end of a performance period of at least 12 months over which performance-based compensation is earned, case-asserted (section 409A(a)(4)(B)(iii))";
}

pub relation performance_election_made_on_409A(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date the election to defer performance-based compensation is made, case-asserted";
}

pub relation performance_based_election_timely_409A4Biii(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(a)(4)(B)(iii): an election for performance-based compensation over at least 12 months may be made no later than 6 months before the end of the period";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "such election may be made no later than 6 months before the end of the period")
rule PerformanceBasedElectionTimely409A4Biii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, made: Date, end: Date, calendar_before_1: Date) strict {
    label en official "exact boundary: the date 6 months before the end is the last day";
    when performance_election_made_on_409A(plan, participant, made)
        and performance_period_end_409A(plan, participant, end)
        and made <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(end, 6, us.irc.core::CalendarMonth, calendar_before_1);
    then performance_based_election_timely_409A4Biii(plan, participant);
}

// =====================================================================
// (b) Rules relating to funding
// =====================================================================

pub relation assets_set_aside_outside_us_409Ab1(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind empirical {
    label en unofficial "assets are set aside in a trust or other arrangement located outside the United States, case-asserted (section 409A(b)(1))";
}

pub relation substantially_all_services_in_foreign_jurisdiction_409Ab1(plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "substantially all of the services to which the deferred compensation relates are performed in the foreign jurisdiction of the assets, case-asserted";
}

pub relation offshore_assets_treated_as_property_transferred_409Ab1(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(b)(1): assets set aside offshore are treated as property transferred in connection with the performance of services under section 83";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "at the time set aside if such assets (or such trust or other arrangement) are located outside of the United States")
rule OffshoreAssetsTreatedAsTransferred409Ab1(plan: NonqualifiedDeferredCompensationPlan, participant: Person) strict {
    label en official "subject to the foreign-services exception";
    when assets_set_aside_outside_us_409Ab1(plan, participant) and not_known(substantially_all_services_in_foreign_jurisdiction_409Ab1(plan));
    then offshore_assets_treated_as_property_transferred_409Ab1(plan, participant);
}

pub relation plan_provides_asset_restriction_on_409Ab2(plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the date the plan first provides that assets will become restricted to the provision of benefits in connection with a change in the employer's financial health, case-asserted (section 409A(b)(2)(A))";
}

pub relation assets_restricted_on_409Ab2(plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the date the assets are so restricted, case-asserted ((B))";
}

pub relation financial_health_transfer_date_409Ab2(plan: NonqualifiedDeferredCompensationPlan, on: Date) kind institutional {
    label en official "section 409A(b)(2): the transfer of property occurs on the earlier of the date the plan provides for the restriction and the date the assets are restricted";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "there is a transfer of property within the meaning of section 83 with respect to such compensation as of the earlier of")
rule FinancialHealthTransferDate409Ab2(plan: NonqualifiedDeferredCompensationPlan, provides: Date, restricted: Date) strict {
    label en official "min of the two dates";
    when plan_provides_asset_restriction_on_409Ab2(plan, provides) and assets_restricted_on_409Ab2(plan, restricted);
    then financial_health_transfer_date_409Ab2(plan, min(provides, restricted));
}

rule FinancialHealthTransferDatePlanOnly409Ab2(plan: NonqualifiedDeferredCompensationPlan, provides: Date) strict {
    label en official "only the plan provision exists";
    when plan_provides_asset_restriction_on_409Ab2(plan, provides) and not_known(assets_restricted_present_409Ab2(plan));
    then financial_health_transfer_date_409Ab2(plan, provides);
}

rule FinancialHealthTransferDateRestrictionOnly409Ab2(plan: NonqualifiedDeferredCompensationPlan, restricted: Date) strict {
    label en official "only the restriction exists";
    when assets_restricted_on_409Ab2(plan, restricted) and not_known(plan_provision_present_409Ab2(plan));
    then financial_health_transfer_date_409Ab2(plan, restricted);
}

pub relation assets_restricted_present_409Ab2(plan: NonqualifiedDeferredCompensationPlan) kind institutional {
    label en unofficial "helper: the restriction date exists";
}

rule AssetsRestrictedPresent409Ab2(plan: NonqualifiedDeferredCompensationPlan, on: Date) strict {
    label en unofficial "derives the helper";
    when assets_restricted_on_409Ab2(plan, on);
    then assets_restricted_present_409Ab2(plan);
}

pub relation plan_provision_present_409Ab2(plan: NonqualifiedDeferredCompensationPlan) kind institutional {
    label en unofficial "helper: the plan provision date exists";
}

rule PlanProvisionPresent409Ab2(plan: NonqualifiedDeferredCompensationPlan, on: Date) strict {
    label en unofficial "derives the helper";
    when plan_provides_asset_restriction_on_409Ab2(plan, on);
    then plan_provision_present_409Ab2(plan);
}

pub relation db_plan_in_at_risk_status_409Ab3(plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "the single-employer defined benefit plan of the sponsor is in at-risk status (section 430(i)), case-asserted ((b)(3)(B)(i))";
}

pub relation db_plan_sponsor_in_bankruptcy_409Ab3(plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "the plan sponsor is a debtor in a title 11 or similar case, case-asserted ((B)(ii))";
}

pub relation db_plan_termination_date_409Ab3(plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the termination date of the defined benefit plan, when it is not sufficient for benefit liabilities, case-asserted ((B)(iii))";
}

pub relation evaluated_on_409Ab3(plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the date on which the restricted period status is evaluated, case-asserted";
}

pub relation restricted_period_409Ab3B(plan: NonqualifiedDeferredCompensationPlan) kind institutional {
    label en official "section 409A(b)(3)(B): a period of at-risk status, bankruptcy of the sponsor, or the 12 months beginning 6 months before termination of an underfunded plan";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "any period during which the plan is in at-risk status (as defined in section 430(i))")
rule RestrictedPeriodAtRisk409Ab3B(plan: NonqualifiedDeferredCompensationPlan) strict {
    label en official "(i)";
    when db_plan_in_at_risk_status_409Ab3(plan);
    then restricted_period_409Ab3B(plan);
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "any period the plan sponsor is a debtor in a case under title 11, United States Code, or similar Federal or State law")
rule RestrictedPeriodBankruptcy409Ab3B(plan: NonqualifiedDeferredCompensationPlan) strict {
    label en official "(ii)";
    when db_plan_sponsor_in_bankruptcy_409Ab3(plan);
    then restricted_period_409Ab3B(plan);
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "the 12-month period beginning on the date which is 6 months before the termination date of the plan")
rule RestrictedPeriodTermination409Ab3B(plan: NonqualifiedDeferredCompensationPlan, termination: Date, today: Date, calendar_before_1: Date) strict {
    label en official "(iii): exact boundaries: from 6 months before the termination date through the day before the 12-month period ends";
    when db_plan_termination_date_409Ab3(plan, termination)
        and evaluated_on_409Ab3(plan, today)
        and today >= calendar_before_1
        and today < add_calendar_period(termination, 6 calendar_month)
        and us.irc.core::civil_calendar_boundary_before(termination, 6, us.irc.core::CalendarMonth, calendar_before_1);
    then restricted_period_409Ab3B(plan);
}

pub relation employer_pays_taxes_on_409A_inclusion_409Ab5(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "an employer provides directly or indirectly for the payment of taxes with respect to amounts included under subsection (b), case-asserted (section 409A(b)(3)(C))";
}

pub relation gross_up_payment_not_deductible_409Ab3C(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind institutional {
    label en official "section 409A(b)(3)(C)(iii): no deduction is allowed for the employer's payment of the participant's taxes";
}

@source(IRC_S409A_B, relation = formalizes, coverage = partial, quote = "no deduction shall be allowed under this title with respect to such payment")
rule GrossUpPaymentNotDeductible409Ab3C(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) strict {
    label en official "PARTIAL: the disallowance; the interest of clause (ii) and the additional tax base of clause (iii) are read through module 09";
    when employer_pays_taxes_on_409A_inclusion_409Ab5(plan, participant, amount);
    then gross_up_payment_not_deductible_409Ab3C(plan, participant);
}

pub enum CoveredEmployeeKind409A {
    CoveredEmployeeOfPlanSponsor;
    CoveredEmployeeOfControlledGroupMember;
    FormerCoveredEmployeeAtTermination;
    OtherIndividual;
}

pub relation employee_kind_409A(participant: Person, kind: CoveredEmployeeKind409A) kind empirical {
    label en unofficial "the individual's status relative to the plan sponsor and its controlled group, case-asserted (section 409A(b)(3)(D)(i))";
}

pub relation applicable_covered_employee_409Ab3D(participant: Person) kind institutional {
    label en official "section 409A(b)(3)(D)(i): a covered employee of the sponsor, a covered employee of a controlled group member, or a former covered employee at termination";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "The term \"applicable covered employee\" means any")
rule ApplicableCoveredEmployee409Ab3D(participant: Person, kind: CoveredEmployeeKind409A) strict {
    label en official "(I), (II) or (III)";
    when employee_kind_409A(participant, kind) and kind != OtherIndividual;
    then applicable_covered_employee_409Ab3D(participant);
}

// =====================================================================
// (d) Definitions
// =====================================================================

pub relation plan_provides_for_deferral_409Ad1(plan: Plan) kind empirical {
    label en unofficial "the plan provides for the deferral of compensation, case-asserted (section 409A(d)(1))";
}

pub enum QualifiedEmployerPlanKind409A {
    Section219g5Plan;
    EligibleDeferredCompensationPlan457b;
    Section415mPlan;
    NotQualified;
}

pub relation employer_plan_kind_409A(plan: Plan, kind: QualifiedEmployerPlanKind409A) kind empirical {
    label en unofficial "the plan's kind for the qualified employer plan test, case-asserted (section 409A(d)(2))";
}

pub relation qualified_employer_plan_409Ad2(plan: Plan) kind institutional {
    label en official "section 409A(d)(2): a plan described in section 219(g)(5)(A) or (B), an eligible deferred compensation plan under section 457(b), or a plan described in section 415(m)";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "The term \"qualified employer plan\" means")
rule QualifiedEmployerPlan409Ad2(plan: Plan, kind: QualifiedEmployerPlanKind409A) strict {
    label en official "(A), (B) or (C)";
    when employer_plan_kind_409A(plan, kind) and kind != NotQualified;
    then qualified_employer_plan_409Ad2(plan);
}

pub relation bona_fide_leave_or_disability_plan_409Ad1B(plan: Plan) kind empirical {
    label en unofficial "the plan is a bona fide vacation leave, sick leave, compensatory time, disability pay or death benefit plan, case-asserted ((d)(1)(B))";
}

pub relation nonqualified_deferred_compensation_plan_409Ad1(plan: Plan) kind institutional {
    label en official "section 409A(d)(1): a plan that provides for the deferral of compensation, other than a qualified employer plan or a bona fide leave, disability or death benefit plan";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "The term \"nonqualified deferred compensation plan\" means any plan that provides for the deferral of compensation")
rule NonqualifiedDeferredCompensationPlan409Ad1(plan: Plan) strict {
    label en official "the deferral plan minus the two exclusions";
    when plan_provides_for_deferral_409Ad1(plan)
        and not_known(qualified_employer_plan_409Ad2(plan))
        and not_known(bona_fide_leave_or_disability_plan_409Ad1B(plan));
    then nonqualified_deferred_compensation_plan_409Ad1(plan);
}

pub relation compensation_conditioned_on_future_substantial_services_409Ad4(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the person's rights to the compensation are conditioned upon the future performance of substantial services by any individual, case-asserted (section 409A(d)(4))";
}

pub relation subject_to_substantial_risk_of_forfeiture_409Ad4(participant: Person, plan: Plan) kind institutional {
    label en official "section 409A(d)(4): rights conditioned on future substantial services are subject to a substantial risk of forfeiture";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "such person's rights to such compensation are conditioned upon the future performance of substantial services by any individual")
rule SubjectToSubstantialRiskOfForfeiture409Ad4(participant: Person, plan: Plan) strict {
    label en official "the condition of future services; whether services are substantial is asserted";
    when compensation_conditioned_on_future_substantial_services_409Ad4(participant, plan);
    then subject_to_substantial_risk_of_forfeiture_409Ad4(participant, plan);
}

pub relation employee_may_receive_qualified_stock_409Ad7(plan: Plan, participant: Person) kind empirical {
    label en unofficial "an arrangement under which the employee may receive qualified stock (section 83(i)(2)), case-asserted (section 409A(d)(7))";
}

pub relation qualified_stock_arrangement_not_nqdc_409Ad7(plan: Plan, participant: Person) kind institutional {
    label en official "section 409A(d)(7): a qualified stock arrangement is not a nonqualified deferred compensation plan solely because of a section 83(i) election";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "shall not be treated as a nonqualified deferred compensation plan with respect to such employee solely because of such employee's election, or ability to make an election, to defer recognition of income under section 83(i)")
rule QualifiedStockArrangementNotNqdc409Ad7(plan: Plan, participant: Person) strict {
    label en official "the section 83(i) election alone does not make it a deferral plan";
    when employee_may_receive_qualified_stock_409Ad7(plan, participant);
    then qualified_stock_arrangement_not_nqdc_409Ad7(plan, participant);
}
