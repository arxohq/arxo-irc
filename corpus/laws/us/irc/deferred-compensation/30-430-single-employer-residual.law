// Section 430 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026):
// module 18 carries the target normal cost, the shortfall base and first
// installment, the at-risk loading, the due dates and installments, the
// section 430(k) lien and the section 436 restrictions. This module adds:
// (c)(2)(D) the 15-year amortization election, (c)(7) installment
// acceleration inputs, (c)(8) and (m) longer amortization periods and the
// newspaper alternative standards, (d)(2) the funding target attainment
// percentage, (e) waiver amortization, (f) prefunding and carryover balances
// and their reductions of plan assets, (g) valuation date and asset value,
// (h) the segment-rate application and corridor and the assumption-change
// approval test, (i)(4) the at-risk transition percentages, (j)(3)-(4)
// underpayment and liquidity shortfall, (l) qualified transfers.
//
// Method: percentages are fractions (0.80 = 80 percent), as in module 18.
// Actuarial values (present values, segment rates, the effective interest
// rate, mortality tables) are case inputs: the Secretary publishes them and
// the plan actuary computes with them. Statutory dollar bases are pinned as
// literals in the rule; their inflation adjustments are SOURCE_GAP.

// =====================================================================
// Case-asserted facts common to the module
// =====================================================================

use self::{
    DefinedBenefitPlan,
    IRC_S430_C,
    IRC_S430_D,
    IRC_S430_E,
    IRC_S430_F,
    IRC_S430_G,
    IRC_S430_H,
    IRC_S430_I,
    IRC_S430_J,
    IRC_S430_L,
    IRC_S430_M,
    Person,
    QuarterlyInstallmentOrdinal,
    TaxableYear,
    at_risk_funding_target_attainment_percentage_430,
    effective_interest_rate_430,
    five_hundred_or_fewer_participants_430,
    funding_target,
    funding_target_attainment_percentage_430,
    minimum_required_contribution_430,
    required_installment_amount_430,
    required_installment_due_date_430,
    shortfall_amortization_base_430,
    value_of_plan_assets_430,
};

pub relation db_plan_sponsor_430(plan: DefinedBenefitPlan, sponsor: Person) kind empirical {
    label en unofficial "the plan sponsor of the single-employer defined benefit plan (section 430(g)... generally the employer), case-asserted";
}

pub relation year_start_430(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted";
}

pub relation plan_year_ordinal_430(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the ordinal (1 = the election year) of the plan year inside the amortization period of an election, case-asserted (section 430(c)(2)(D)(ii))";
}

// =====================================================================
// (c)(8), (m)(4)(C) Amortization period length
// =====================================================================

pub relation shortfall_amortization_15_year_election_430c8(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor elected the 15-plan-year amortization of section 430(c)(8) for the year, case-asserted";
}

pub relation newspaper_election_in_effect_430m(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "an election under section 430(m)(1) is in effect for the plan year, case-asserted (once made, it applies to all later years unless revoked)";
}

pub relation amortization_period_years_430(plan: DefinedBenefitPlan, y: TaxableYear, years: Integer) kind institutional {
    label en official "the number of plan years over which shortfall amortization bases are amortized: 7, or 15 (section 430(c)(8)), or 30 (section 430(m)(4)(C)(i))";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "Subparagraphs (A) and (B) of subsection (c)(2) shall be applied by substituting \"30-plan-year\" for \"7-plan-year\" each place it appears.")
rule AmortizationPeriod30Years430(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "newspaper plan election: 30 plan years";
    when newspaper_election_in_effect_430m(plan, y);
    then amortization_period_years_430(plan, y, 30);
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "subparagraphs (A) and (B) of paragraph (2) shall each be applied by substituting \"15-plan-year period\" for \"7-plan-year period\"")
rule AmortizationPeriod15Years430(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "the section 430(c)(8) election: 15 plan years (the newspaper election displaces it under (m)(4)(C)(ii) only for the (D) election, not for this one; when both are in effect the 30-year rule of (m) governs as the special rule)";
    when shortfall_amortization_15_year_election_430c8(plan, y) and not_known(newspaper_election_in_effect_430m(plan, y));
    then amortization_period_years_430(plan, y, 15);
}

rule AmortizationPeriod7Years430(plan: DefinedBenefitPlan, y: TaxableYear, base: Money) strict {
    label en official "the general (c)(2)(A)-(B) period of 7 plan years, when neither election is in effect";
    when shortfall_amortization_base_430(plan, y, base)
        and not_known(shortfall_amortization_15_year_election_430c8(plan, y))
        and not_known(newspaper_election_in_effect_430m(plan, y));
    then amortization_period_years_430(plan, y, 7);
}

// =====================================================================
// (m) Newspaper plans: alternative standards
// =====================================================================

pub relation community_newspaper_plan_430m5(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a community newspaper plan as defined in section 430(m)(5) (maintained as of December 31, 2018, by a newspaper company meeting the control and non-public-trading conditions), case-asserted";
}

pub relation newspaper_plan_of_same_controlled_group_430m2b(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is sponsored, as of April 2, 2019, by a member of the same controlled group as the sponsor of a community newspaper plan, case-asserted (section 430(m)(2)(B))";
}

pub relation eligible_newspaper_plan_430m2(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 430(m)(2): a community newspaper plan or another plan of a member of the same controlled group";
}

@source(IRC_S430_M, relation = formalizes, coverage = partial, quote = "The term \"eligible newspaper plan sponsor\" means the plan sponsor of")
rule EligibleNewspaperPlanCommunity(plan: DefinedBenefitPlan) strict {
    label en official "(A)";
    when community_newspaper_plan_430m5(plan);
    then eligible_newspaper_plan_430m2(plan);
}

rule EligibleNewspaperPlanControlledGroup(plan: DefinedBenefitPlan) strict {
    label en official "(B)";
    when newspaper_plan_of_same_controlled_group_430m2b(plan);
    then eligible_newspaper_plan_430m2(plan);
}

pub relation participant_accrual_increased_after_april_2_2019_430(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "some participant's accrued benefit was increased (by service or compensation) after April 2, 2019, case-asserted";
}

pub relation newspaper_election_permitted_430m1(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 430(m)(1): the election is available to an eligible plan under which no accrued benefit was increased after April 2, 2019";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "of a plan under which no participant has had the participant's accrued benefit increased (whether because of service or compensation) after April 2, 2019")
rule NewspaperElectionPermitted(plan: DefinedBenefitPlan) strict {
    label en official "eligible sponsor and no post-April 2, 2019 accrual increase";
    when eligible_newspaper_plan_430m2(plan) and not_known(participant_accrual_increased_after_april_2_2019_430(plan));
    then newspaper_election_permitted_430m1(plan);
}

pub relation newspaper_election_made_430(sponsor: Person, plan: DefinedBenefitPlan, on: Date) kind empirical {
    label en unofficial "the sponsor elects the alternative standards, case-asserted";
}

pub relation newspaper_alternative_standards_apply_430m(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 430(m)(1): the alternative standards of paragraph (4) apply to the plan";
}

@source(IRC_S430_M, relation = formalizes, coverage = partial, quote = "may elect to have the alternative standards described in paragraph (4) apply to such plan")
rule NewspaperElectionPower(sponsor: Person, plan: DefinedBenefitPlan, on: Date) strict {
    label en official "PARTIAL: the time and manner of the election are the Secretary's ((m)(3)); the effect on later years is read through newspaper_election_in_effect_430m";
    when newspaper_election_made_430(sponsor, plan, on) and db_plan_sponsor_430(plan, sponsor);
    then power ElectNewspaperAlternativeStandards {
        holder sponsor;
        over plan;
        exercise newspaper_election_made_430(sponsor, plan, on);
        valid_when newspaper_election_permitted_430m1(plan);
        effect newspaper_alternative_standards_apply_430m(plan);
    };
}

pub relation newspaper_segment_rate_430m4(plan: DefinedBenefitPlan, y: TaxableYear, rate: Decimal) kind institutional {
    label en official "section 430(m)(4)(A)(i): the first, second and third segment rates are 8 percent";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "the first, second, and third segment rates in effect for any month for purposes of this section shall be 8 percent")
rule NewspaperSegmentRate(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "8 percent for each segment";
    when newspaper_election_in_effect_430m(plan, y);
    then newspaper_segment_rate_430m4(plan, y, 0.08);
}

pub relation newspaper_subsection_i_disapplied_430m4d(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(m)(4)(D): subsection (i) (at-risk plans) does not apply";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "Subsection (i) shall not apply.")
rule NewspaperAtRiskDisapplied(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "at-risk status is displaced for a plan under the election";
    when newspaper_election_in_effect_430m(plan, y);
    then newspaper_subsection_i_disapplied_430m4d(plan, y);
}

// =====================================================================
// (c)(2)(D) The 15-year and interest-only amortization election
// =====================================================================

pub relation eligible_plan_year_due_date_after_enactment_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the due date under subsection (j)(1) for the plan year's minimum required contribution occurs on or after the date of enactment of subparagraph (D), case-asserted (section 430(c)(2)(D)(v))";
}

pub relation eligible_plan_year_430c2Dv(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(c)(2)(D)(v): a plan year beginning in 2008, 2009, 2010 or 2011 whose contribution due date falls on or after enactment";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the term \"eligible plan year\" means any plan year beginning in 2008, 2009, 2010, or 2011")
rule EligiblePlanYear430c2Dv(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) strict {
    label en official "exact date range: begins on or after 2008-01-01 and on or before 2011-12-31";
    when year_start_430(plan, y, start)
        and start >= @2008-01-01
        and start <= @2011-12-31
        and eligible_plan_year_due_date_after_enactment_430(plan, y);
    then eligible_plan_year_430c2Dv(plan, y);
}

pub relation eligible_plan_years_elected_count_430(plan: DefinedBenefitPlan, n: Integer) kind empirical {
    label en unofficial "the number of eligible plan years for which the sponsor has elected the schedule, case-asserted";
}

pub relation shortfall_schedule_election_permitted_430c2Div(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(c)(2)(D)(iv)(I): the election is available for not more than 2 eligible plan years";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "may elect to have this subparagraph apply to not more than 2 eligible plan years")
rule ShortfallScheduleElectionPermitted(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) strict {
    label en official "exact boundary: at most 2 years";
    when eligible_plan_year_430c2Dv(plan, y) and eligible_plan_years_elected_count_430(plan, n) and n <= 2;
    then shortfall_schedule_election_permitted_430c2Div(plan, y);
}

pub relation shortfall_schedule_election_made_430(sponsor: Person, plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the sponsor elects the (D) schedule for the election year, case-asserted";
}

pub relation shortfall_schedule_applies_430c2D(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(c)(2)(D)(i): the (D) amortization schedule applies to the shortfall amortization base of the election year";
}

@source(IRC_S430_C, relation = formalizes, coverage = partial, quote = "The plan sponsor of a plan may elect to have this subparagraph apply to not more than 2 eligible plan years")
rule ShortfallScheduleElectionPower(sponsor: Person, plan: DefinedBenefitPlan, y: TaxableYear, on: Date) strict {
    label en official "PARTIAL: the election's time and manner are the Secretary's ((iv)(III))";
    when shortfall_schedule_election_made_430(sponsor, plan, y, on) and db_plan_sponsor_430(plan, sponsor);
    then power ElectShortfallAmortizationSchedule {
        holder sponsor;
        over plan;
        exercise shortfall_schedule_election_made_430(sponsor, plan, y, on);
        valid_when shortfall_schedule_election_permitted_430c2Div(plan, y);
        effect shortfall_schedule_applies_430c2D(plan, y);
    };
}

pub relation election_year_interest_only_installment_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(2)(D)(ii)(I): for each of the first 2 plan years of the 9-year period, interest on the election year base at the election year effective interest rate";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "in the case of the first 2 plan years in the 9-plan-year period beginning with the election year, interest on the shortfall amortization base of the plan for the election year")
rule ElectionYearInterestOnlyInstallment430(plan: DefinedBenefitPlan, y: TaxableYear, base: Money, r: Decimal, n: Integer) strict {
    label en official "base x effective rate, rounded to the cent; plan years 1 and 2 of the period (the base and the rate are those of the election year)";
    when shortfall_schedule_applies_430c2D(plan, y)
        and plan_year_ordinal_430(plan, y, n)
        and n >= 1 and n <= 2
        and shortfall_amortization_base_430(plan, y, base)
        and effective_interest_rate_430(plan, y, r);
    then election_year_interest_only_installment_430(plan, y, round(base * r, 2, "HALF_UP"));
}

// =====================================================================
// (c)(7) Excess compensation and extraordinary dividends (inputs)
// =====================================================================

pub relation employee_remuneration_for_calendar_year_430(plan: DefinedBenefitPlan, y: TaxableYear, employee: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate amount includible in income for remuneration for services performed for the plan sponsor in the calendar year in which the plan year begins, with the section 430(c)(7)(D)(ii)-(v) adjustments applied, case-asserted";
}

pub relation excess_employee_compensation_430c7D(plan: DefinedBenefitPlan, y: TaxableYear, employee: Person, amount: Money) kind institutional {
    label en official "section 430(c)(7)(D)(i): the excess of the remuneration over $1,000,000";
}

@source(IRC_S430_C, relation = formalizes, coverage = partial, quote = "the aggregate amount includible in income under this chapter for remuneration during the calendar year in which such plan year begins for services performed by the employee for the plan sponsor")
rule ExcessEmployeeCompensation430c7D(plan: DefinedBenefitPlan, y: TaxableYear, employee: Person, remuneration: Money) strict {
    label en official "PARTIAL: strictly the excess over the pinned $1,000,000 base (the inflation increase after 2010, (vii), is SOURCE_GAP); the clauses (ii)-(vi) adjustments are inside the asserted remuneration";
    when employee_remuneration_for_calendar_year_430(plan, y, employee, remuneration) and remuneration > 1000000.00 USD;
    then excess_employee_compensation_430c7D(plan, y, employee, remuneration - 1000000.00 USD);
}

pub relation dividends_and_redemptions_in_plan_year_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dividends declared plus the amount paid for redemptions of the sponsor's stock during the plan year, after the (E)(ii)-(v) exclusions, case-asserted";
}

pub relation adjusted_net_income_430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sponsor's adjusted net income for the preceding plan year without regard to reductions for interest, taxes, depreciation or amortization, case-asserted ((E)(i)(I))";
}

pub relation same_manner_dividends_for_plan_year_430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "for a sponsor that determined and declared dividends in the same manner for at least 5 consecutive years, the dividends determined for the plan year in that manner, case-asserted ((E)(i)(II))";
}

pub relation extraordinary_dividend_threshold_430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(7)(E)(i): the greater of the adjusted net income and the same-manner dividends";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "over the greater of")
rule ExtraordinaryDividendThreshold430c7E(plan: DefinedBenefitPlan, y: TaxableYear, income: Money, same_manner: Money) strict {
    label en official "max of the two measures";
    when adjusted_net_income_430c7E(plan, y, income) and same_manner_dividends_for_plan_year_430c7E(plan, y, same_manner);
    then extraordinary_dividend_threshold_430c7E(plan, y, max(income, same_manner));
}

pub relation same_manner_dividends_present_430c7E(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en unofficial "helper: the 5-year same-manner dividend measure exists";
}

rule SameMannerDividendsPresent430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the helper";
    when same_manner_dividends_for_plan_year_430c7E(plan, y, amount);
    then same_manner_dividends_present_430c7E(plan, y);
}

rule ExtraordinaryDividendThresholdIncomeOnly430c7E(plan: DefinedBenefitPlan, y: TaxableYear, income: Money) strict {
    label en official "no 5-year same-manner history: only the adjusted net income measure";
    when adjusted_net_income_430c7E(plan, y, income) and not_known(same_manner_dividends_present_430c7E(plan, y));
    then extraordinary_dividend_threshold_430c7E(plan, y, income);
}

pub relation extraordinary_dividends_and_redemptions_430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(7)(E)(i): the excess of dividends and redemptions over the threshold";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "The amount determined under this subparagraph for any plan year is the excess (if any) of the sum of the dividends declared during the plan year by the plan sponsor plus the aggregate amount paid for the redemption of stock of the plan sponsor redeemed during the plan year")
rule ExtraordinaryDividendsAndRedemptions430c7E(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, threshold: Money) strict {
    label en official "paid - threshold when positive";
    when dividends_and_redemptions_in_plan_year_430(plan, y, paid) and extraordinary_dividend_threshold_430c7E(plan, y, threshold) and paid > threshold;
    then extraordinary_dividends_and_redemptions_430c7E(plan, y, paid - threshold);
}

pub relation installment_acceleration_before_cap_430c7C(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(7)(C)(i): the aggregate excess employee compensation plus the extraordinary dividends and redemptions, before the clause (ii) limit";
}

pub relation extraordinary_dividends_present_430c7E(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en unofficial "helper: a positive extraordinary dividend and redemption amount exists (not_known cannot take a wildcard)";
}

rule ExtraordinaryDividendsPresent430c7E(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the helper";
    when extraordinary_dividends_and_redemptions_430c7E(plan, y, amount);
    then extraordinary_dividends_present_430c7E(plan, y);
}

@source(IRC_S430_C, relation = formalizes, coverage = partial, quote = "the sum of—")
rule InstallmentAccelerationBeforeCap430c7C(plan: DefinedBenefitPlan, y: TaxableYear, extra: Money) strict {
    label en official "PARTIAL: (I) is the sum over employees of the excess compensation, (II) the extraordinary dividends and redemptions; the cap of clause (ii) and the carryover of clause (iii) are not derived; a year in a restriction period is presumed";
    when extraordinary_dividends_and_redemptions_430c7E(plan, y, extra);
    then installment_acceleration_before_cap_430c7C(plan, y,
        extra + sum all amt: Money for e: Person where excess_employee_compensation_430c7D(plan, y, e, amt));
}

rule InstallmentAccelerationNoDividends430c7C(plan: DefinedBenefitPlan, y: TaxableYear, emp0: Person, first: Money) strict {
    label en official "PARTIAL: only excess compensation, no extraordinary dividends";
    when excess_employee_compensation_430c7D(plan, y, emp0, first) and not_known(extraordinary_dividends_present_430c7E(plan, y));
    then installment_acceleration_before_cap_430c7C(plan, y,
        sum all amt: Money for e: Person where excess_employee_compensation_430c7D(plan, y, e, amt));
}

pub relation restriction_period_length_years_430c7F(plan: DefinedBenefitPlan, y: TaxableYear, years: Integer) kind institutional {
    label en official "section 430(c)(7)(F)(ii): the restriction period is 3 years from the election year, or 5 years when the sponsor elects 15-year amortization";
}

pub relation fifteen_year_amortization_elected_for_election_year_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor elects 15-year amortization for the shortfall amortization base of the election year, case-asserted (section 430(c)(2)(D)(iii))";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the 3-year period beginning with the election year")
rule RestrictionPeriodLength3Years(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "3 years";
    when shortfall_schedule_applies_430c2D(plan, y) and not_known(fifteen_year_amortization_elected_for_election_year_430(plan, y));
    then restriction_period_length_years_430c7F(plan, y, 3);
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the 5-year period beginning with the election year")
rule RestrictionPeriodLength5Years(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "5 years for the 15-year amortization election";
    when shortfall_schedule_applies_430c2D(plan, y) and fifteen_year_amortization_elected_for_election_year_430(plan, y);
    then restriction_period_length_years_430c7F(plan, y, 5);
}

// =====================================================================
// (d)(2), (f)(4) Plan assets reduced by the balances; the FTAP
// =====================================================================

pub relation prefunding_balance_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the plan's prefunding balance for the plan year, case-asserted (section 430(f)(6))";
}

pub relation funding_standard_carryover_balance_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the plan's funding standard carryover balance for the plan year, case-asserted (section 430(f)(7))";
}

pub relation balance_credit_elected_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the balances the sponsor elects to credit against the minimum required contribution for the plan year, case-asserted (section 430(f)(3)(A))";
}

pub relation plan_assets_reduced_by_balances_430f4b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(f)(4)(B)(i): for subsections (a), (c)(4)(B) and (d)(2)(A), the value of plan assets less the prefunding and carryover balances";
}

@source(IRC_S430_F, relation = formalizes, coverage = exact, quote = "the value of plan assets is deemed to be such amount, reduced by the amount of the prefunding balance and the funding standard carryover balance")
rule PlanAssetsReducedByBalances430f4b(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, pb: Money, cb: Money) strict {
    label en official "assets - prefunding - carryover, exact (the binding-agreement exception of (B)(ii) is not derived)";
    when value_of_plan_assets_430(plan, y, assets)
        and prefunding_balance_430(plan, y, pb)
        and funding_standard_carryover_balance_430(plan, y, cb);
    then plan_assets_reduced_by_balances_430f4b(plan, y, assets - pb - cb);
}

pub relation funding_target_attainment_percentage_computed_430d2(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 430(d)(2): the plan assets (as reduced under (f)(4)(B)) divided by the funding target, as a fraction";
}

@source(IRC_S430_D, relation = formalizes, coverage = exact, quote = "The \"funding target attainment percentage\" of a plan for a plan year is the ratio (expressed as a percentage) which")
rule FundingTargetAttainmentPercentageComputed430d2(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money) strict {
    label en official "exact quotient (no rounding); the target is determined without regard to subsection (i)(1)";
    when plan_assets_reduced_by_balances_430f4b(plan, y, assets) and funding_target(plan, y, target) and target > 0.00 USD;
    then funding_target_attainment_percentage_computed_430d2(plan, y, assets / target);
}

pub relation plan_assets_reduced_by_prefunding_only_430f4c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(f)(4)(C): for the (f)(3)(C)(i) ratio, the value of plan assets less the prefunding balance";
}

@source(IRC_S430_F, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (3)(C)(i) of this subsection, the value of plan assets is deemed to be such amount, reduced by the amount of the prefunding balance.")
rule PlanAssetsReducedByPrefundingOnly430f4c(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, pb: Money) strict {
    label en official "assets - prefunding";
    when value_of_plan_assets_430(plan, y, assets) and prefunding_balance_430(plan, y, pb);
    then plan_assets_reduced_by_prefunding_only_430f4c(plan, y, assets - pb);
}

// =====================================================================
// (f)(3) Crediting the balances against the minimum required contribution
// =====================================================================

pub relation preceding_year_funding_target_430f3c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the funding target of the plan for the preceding plan year, determined without regard to subsection (i)(1), case-asserted";
}

pub relation preceding_year_assets_430f3c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of plan assets for the preceding plan year as reduced under paragraph (4)(C), case-asserted";
}

pub relation balance_credit_barred_430f3(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(f)(3)(C): no credit for a plan year if the preceding-year ratio of assets to funding target is under 80 percent";
}

@source(IRC_S430_F, relation = formalizes, coverage = exact, quote = "is less than 80 percent")
rule BalanceCreditBarredBelow80(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money) strict {
    label en official "exact by cross-multiplication: assets x 100 < target x 80; no ratio for a zero target";
    when preceding_year_assets_430f3c(plan, y, assets)
        and preceding_year_funding_target_430f3c(plan, y, target)
        and target > 0.00 USD
        and assets * 100.0 < target * 80.0;
    then balance_credit_barred_430f3(plan, y);
}

pub relation minimum_required_contribution_after_credit_430f3(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(f)(3)(A): the minimum required contribution reduced by the credited amount (not in excess of the contribution)";
}

@source(IRC_S430_F, relation = formalizes, coverage = partial, quote = "the minimum required contribution for the plan year shall be reduced as of the first day of the plan year by the amount so credited")
rule MinimumRequiredContributionAfterCredit430f3(plan: DefinedBenefitPlan, y: TaxableYear, mrc: Money, credit: Money) strict {
    label en official "PARTIAL: mrc - min(credit, mrc); (B) the carryover-before-prefunding order is not derived; a barred year takes no credit";
    when minimum_required_contribution_430(plan, y, mrc)
        and balance_credit_elected_430(plan, y, credit)
        and not_known(balance_credit_barred_430f3(plan, y));
    then minimum_required_contribution_after_credit_430f3(plan, y, mrc - min(credit, mrc));
}

rule MinimumRequiredContributionWhenCreditBarred430f3(plan: DefinedBenefitPlan, y: TaxableYear, mrc: Money) strict {
    label en official "a barred credit leaves the contribution unchanged";
    when minimum_required_contribution_430(plan, y, mrc) and balance_credit_barred_430f3(plan, y);
    then minimum_required_contribution_after_credit_430f3(plan, y, mrc);
}

pub relation prior_year_employer_contributions_430f6(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate employer contributions to the plan for the preceding plan year, case-asserted (section 430(f)(6)(B)(i)(I))";
}

pub relation prior_year_minimum_required_contribution_430f6(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the minimum required contribution for the preceding plan year, case-asserted ((B)(i)(II))";
}

pub relation prefunding_election_limit_430f6b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(f)(6)(B)(i): the elected increase of the prefunding balance may not exceed the excess of prior-year contributions over the prior-year minimum required contribution";
}

@source(IRC_S430_F, relation = formalizes, coverage = partial, quote = "Such amount shall not exceed the excess (if any) of")
rule PrefundingElectionLimit430f6b(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, required: Money) strict {
    label en official "PARTIAL: contributions - required, floored at zero; the interest adjustment ((ii)) and the section 436 reduction ((iii)) are not derived";
    when prior_year_employer_contributions_430f6(plan, y, paid) and prior_year_minimum_required_contribution_430f6(plan, y, required);
    then prefunding_election_limit_430f6b(plan, y, max(paid - required, 0.00 USD));
}

// =====================================================================
// (e) Waiver amortization
// =====================================================================

pub relation waived_funding_deficiency_430e4(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the waived funding deficiency for the plan year under section 412(c), case-asserted";
}

pub relation waiver_amortization_base_430e4(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(e)(4): the waiver amortization base is the waived funding deficiency for the plan year";
}

@source(IRC_S430_E, relation = formalizes, coverage = exact, quote = "The waiver amortization base of a plan for a plan year is the amount of the waived funding deficiency (if any) for such plan year under section 412(c).")
rule WaiverAmortizationBase430e4(plan: DefinedBenefitPlan, y: TaxableYear, waived: Money) strict {
    label en official "equal to the waived deficiency";
    when waived_funding_deficiency_430e4(plan, y, waived) and waived > 0.00 USD;
    then waiver_amortization_base_430e4(plan, y, waived);
}

pub relation waiver_interest_rate_430e3(plan: DefinedBenefitPlan, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the rate obtained by applying the segment rates under rules similar to section 430(h)(2)(B), case-asserted (section 430(e)(3))";
}

pub relation waiver_amortization_installment_430e2(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(e)(2)(A): the level annual installment amortizing the waiver base over 5 plan years beginning with the succeeding year";
}

@source(IRC_S430_E, relation = formalizes, coverage = partial, quote = "The waiver amortization installments are the amounts necessary to amortize the waiver amortization base of the plan for any plan year in level annual installments over a period of 5 plan years beginning with the succeeding plan year.")
rule WaiverAmortizationInstallment430e2(plan: DefinedBenefitPlan, y: TaxableYear, base: Money, r: Decimal) strict {
    label en official "PARTIAL: level ordinary-annuity payment base x r x (1+r)^5 / ((1+r)^5 - 1), an unrolled chain of 5 multiplications, rounded to the cent (the payment-timing convention is an open point noted in module 18)";
    when waiver_amortization_base_430e4(plan, y, base) and waiver_interest_rate_430e3(plan, y, r) and r > 0.0;
    then waiver_amortization_installment_430e2(plan, y,
        div_round(base * r * ((1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r)),
            ((1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r)) - 1.0,
            2, "HALF_UP"));
}

pub relation funding_shortfall_zero_430e5(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(e)(5): the funding shortfall of the plan is zero for the plan year, so earlier waiver bases are reduced to zero";
}

@source(IRC_S430_E, relation = formalizes, coverage = partial, quote = "In any case in which the funding shortfall of a plan for a plan year is zero")
rule FundingShortfallZero430e5(plan: DefinedBenefitPlan, y: TaxableYear, target: Money, assets: Money) strict {
    label en official "PARTIAL: the zero-shortfall test only; the reduction of earlier bases is a ledger not derived";
    when funding_target(plan, y, target) and value_of_plan_assets_430(plan, y, assets) and assets >= target;
    then funding_shortfall_zero_430e5(plan, y);
}

// =====================================================================
// (g) Valuation date and value of plan assets
// =====================================================================

pub relation max_participants_on_any_day_preceding_year_430g2(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the largest number of participants on any day of the preceding plan year (all plans of the employer and its controlled group treated as one), case-asserted (section 430(g)(2)(B))";
}

pub relation may_designate_valuation_date_430g2B(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(g)(2)(B): a plan with 100 or fewer participants on each day of the preceding plan year may designate any day of the plan year as its valuation date";
}

@source(IRC_S430_G, relation = formalizes, coverage = exact, quote = "If, on each day during the preceding plan year, a plan had 100 or fewer participants, the plan may designate any day during the plan year as its valuation date")
rule MayDesignateValuationDate430g2B(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) strict {
    label en official "exact boundary: 100 participants on every day qualifies, 101 on some day does not";
    when max_participants_on_any_day_preceding_year_430g2(plan, y, count) and count <= 100;
    then may_designate_valuation_date_430g2B(plan, y);
}

pub relation averaged_asset_value_430g3(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of plan assets determined by averaging fair market values, case-asserted (section 430(g)(3)(B))";
}

pub relation fair_market_value_of_assets_430g3(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the plan's assets at the time, case-asserted";
}

pub relation averaging_permitted_by_regulations_430g3(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the averaging method is permitted under the Secretary's regulations, case-asserted ((g)(3)(B)(i))";
}

pub relation averaging_period_within_25_months_430g3(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the averaging period does not begin before the last day of the 25th month preceding the month of the valuation date, case-asserted ((B)(ii))";
}

pub relation asset_averaging_permitted_430g3B(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(g)(3)(B): averaging is permitted if regulations allow it, the period is within 25 months and the averaged value stays within 90 to 110 percent of fair market value";
}

@source(IRC_S430_G, relation = formalizes, coverage = exact, quote = "does not result in a determination of the value of plan assets which, at any time, is lower than 90 percent or greater than 110 percent of the fair market value of such assets at such time")
rule AssetAveragingPermitted430g3B(plan: DefinedBenefitPlan, y: TaxableYear, averaged: Money, fmv: Money) strict {
    label en official "exact by cross-multiplication: 0.9 x fmv <= averaged <= 1.1 x fmv (the corridor is inclusive)";
    when averaging_permitted_by_regulations_430g3(plan)
        and averaging_period_within_25_months_430g3(plan)
        and averaged_asset_value_430g3(plan, y, averaged)
        and fair_market_value_of_assets_430g3(plan, y, fmv)
        and averaged * 10.0 >= fmv * 9.0
        and averaged * 10.0 <= fmv * 11.0;
    then asset_averaging_permitted_430g3B(plan, y);
}

pub relation qualified_transfer_amount_430l(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "assets transferred in a qualified transfer under section 420, case-asserted";
}

pub relation plan_assets_excluding_qualified_transfer_430l(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(l): assets transferred in a qualified transfer are not treated as assets in the plan";
}

@source(IRC_S430_L, relation = formalizes, coverage = exact, quote = "any assets so transferred shall not, for purposes of this section, be treated as assets in the plan")
rule PlanAssetsExcludingQualifiedTransfer430l(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, moved: Money) strict {
    label en official "assets - transferred amount";
    when value_of_plan_assets_430(plan, y, assets) and qualified_transfer_amount_430l(plan, y, moved);
    then plan_assets_excluding_qualified_transfer_430l(plan, y, assets - moved);
}

// =====================================================================
// (h) Segment rates: application by payment date, corridor, assumption changes
// =====================================================================

pub enum SegmentRate430 {
    FirstSegment;
    SecondSegment;
    ThirdSegment;
}

pub relation benefit_payment_date_430(plan: DefinedBenefitPlan, y: TaxableYear, payment: Date) kind empirical {
    label en unofficial "the date a benefit is reasonably determined to be payable, case-asserted";
}

pub relation valuation_date_430(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the valuation date of the plan for the plan year, case-asserted (section 430(g)(2))";
}

pub relation applicable_segment_430h2B(plan: DefinedBenefitPlan, y: TaxableYear, payment: Date, segment: SegmentRate430) kind institutional {
    label en official "section 430(h)(2)(B): the segment rate applying to a benefit by the period of its payment (first 5 years, next 15 years, later)";
}

@source(IRC_S430_H, relation = formalizes, coverage = exact, quote = "in the case of benefits reasonably determined to be payable during the 5-year period beginning on the valuation date for the plan year, the first segment rate")
rule ApplicableSegmentFirst430h2B(plan: DefinedBenefitPlan, y: TaxableYear, payment: Date, v: Date) strict {
    label en official "exact boundary: payable before the fifth anniversary of the valuation date";
    when valuation_date_430(plan, y, v) and benefit_payment_date_430(plan, y, payment)
        and payment >= v and payment < add_calendar_period(v, 5 calendar_year);
    then applicable_segment_430h2B(plan, y, payment, FirstSegment);
}

@source(IRC_S430_H, relation = formalizes, coverage = exact, quote = "in the case of benefits reasonably determined to be payable during the 15-year period beginning at the end of the period described in clause (i), the second segment rate")
rule ApplicableSegmentSecond430h2B(plan: DefinedBenefitPlan, y: TaxableYear, payment: Date, v: Date) strict {
    label en official "exact boundary: from the fifth anniversary up to the twentieth";
    when valuation_date_430(plan, y, v) and benefit_payment_date_430(plan, y, payment)
        and payment >= add_calendar_period(v, 5 calendar_year) and payment < add_calendar_period(v, 20 calendar_year);
    then applicable_segment_430h2B(plan, y, payment, SecondSegment);
}

@source(IRC_S430_H, relation = formalizes, coverage = exact, quote = "the third segment rate with respect to the applicable month")
rule ApplicableSegmentThird430h2B(plan: DefinedBenefitPlan, y: TaxableYear, payment: Date, v: Date) strict {
    label en official "from the twentieth anniversary on";
    when valuation_date_430(plan, y, v) and benefit_payment_date_430(plan, y, payment)
        and payment >= add_calendar_period(v, 20 calendar_year);
    then applicable_segment_430h2B(plan, y, payment, ThirdSegment);
}

pub relation segment_rate_unadjusted_430h2C(plan: DefinedBenefitPlan, y: TaxableYear, segment: SegmentRate430, rate: Decimal) kind empirical {
    label en unofficial "the segment rate determined from the corporate bond yield curve for the applicable month, case-asserted (published by the Secretary)";
}

pub relation segment_rate_25_year_average_430h2C(plan: DefinedBenefitPlan, y: TaxableYear, segment: SegmentRate430, average: Decimal) kind empirical {
    label en unofficial "the average of the segment rate over the 25-year period ending on September 30 of the preceding calendar year, case-asserted";
}

pub relation corridor_percentages_430h2C(plan: DefinedBenefitPlan, y: TaxableYear, minimum: Decimal, maximum: Decimal) kind empirical {
    label en unofficial "the applicable minimum and maximum percentages for the calendar year of the plan year, case-asserted (SOURCE_GAP: the table is not carried in the pinned text)";
}

pub relation segment_rate_adjusted_430h2C(plan: DefinedBenefitPlan, y: TaxableYear, segment: SegmentRate430, rate: Decimal) kind institutional {
    label en official "section 430(h)(2)(C)(iv): the segment rate limited to the corridor around the 25-year average";
}

@source(IRC_S430_H, relation = formalizes, coverage = partial, quote = "then the segment rate described in such clause with respect to the a")
rule SegmentRateAdjusted430h2C(plan: DefinedBenefitPlan, y: TaxableYear, segment: SegmentRate430, rate: Decimal, average: Decimal, lo: Decimal, hi: Decimal) strict {
    label en official "PARTIAL: rate limited to [lo x average, hi x average] (equal to a bound keeps the rate); the corridor percentages are inputs";
    when segment_rate_unadjusted_430h2C(plan, y, segment, rate)
        and segment_rate_25_year_average_430h2C(plan, y, segment, average)
        and corridor_percentages_430h2C(plan, y, lo, hi);
    then segment_rate_adjusted_430h2C(plan, y, segment, max(min(rate, average * hi), average * lo));
}

pub relation title_iv_single_employer_plan_430h5(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a defined benefit plan (not multiemployer) to which title IV of ERISA applies, case-asserted (section 430(h)(5)(B)(i))";
}

pub relation aggregate_unfunded_vested_benefits_exceed_threshold_430h5(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the aggregate unfunded vested benefits of the sponsor group exceed the statutory threshold, case-asserted (SOURCE_GAP: the dollar amount is cut off in the pinned text of (B)(ii))";
}

pub relation assumption_change_shortfall_decrease_430h5(plan: DefinedBenefitPlan, y: TaxableYear, decrease: Money, funding_target_before: Money) kind empirical {
    label en unofficial "the decrease in the funding shortfall from the change in assumptions and the funding target before the change, case-asserted ((B)(iii))";
}

pub relation assumption_change_needs_approval_430h5(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(h)(5): an actuarial assumption of the funding target may not be changed without the Secretary's approval when the plan and the change meet (B)(i)-(iii)";
}

@source(IRC_S430_H, relation = formalizes, coverage = partial, quote = "exceeds $50,000,000, or that exceeds $5,000,000 and that is 5 percent or more of the funding target of the plan before such change")
rule AssumptionChangeNeedsApprovalLarge(plan: DefinedBenefitPlan, y: TaxableYear, decrease: Money, target: Money) strict {
    label en official "PARTIAL: (iii) over $50,000,000; (i) and (ii) are case facts";
    when title_iv_single_employer_plan_430h5(plan)
        and aggregate_unfunded_vested_benefits_exceed_threshold_430h5(plan, y)
        and assumption_change_shortfall_decrease_430h5(plan, y, decrease, target)
        and decrease > 50000000.00 USD;
    then assumption_change_needs_approval_430h5(plan, y);
}

rule AssumptionChangeNeedsApprovalMedium(plan: DefinedBenefitPlan, y: TaxableYear, decrease: Money, target: Money) strict {
    label en official "PARTIAL: (iii) over $5,000,000 and at least 5 percent of the funding target before the change, exact by cross-multiplication decrease x 100 >= target x 5";
    when title_iv_single_employer_plan_430h5(plan)
        and aggregate_unfunded_vested_benefits_exceed_threshold_430h5(plan, y)
        and assumption_change_shortfall_decrease_430h5(plan, y, decrease, target)
        and decrease > 5000000.00 USD
        and decrease * 100.0 >= target * 5.0;
    then assumption_change_needs_approval_430h5(plan, y);
}

// =====================================================================
// (i)(4)(B) At-risk transition percentages
// =====================================================================

pub relation at_risk_applicable_percentage_430i4B(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 430(i)(4)(B): 65 percent for 2008, 70 percent for 2009 and 75 percent for 2010 (the general test of (A)(i) uses 80 percent after 2010)";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "65 percent in the case of 2008.")
rule AtRiskApplicablePercentage2008(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) strict {
    label en official "plan year beginning in 2008";
    when year_start_430(plan, y, start) and start >= @2008-01-01 and start <= @2008-12-31;
    then at_risk_applicable_percentage_430i4B(plan, y, 0.65);
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "70 percent in the case of 2009.")
rule AtRiskApplicablePercentage2009(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) strict {
    label en official "plan year beginning in 2009";
    when year_start_430(plan, y, start) and start >= @2009-01-01 and start <= @2009-12-31;
    then at_risk_applicable_percentage_430i4B(plan, y, 0.70);
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "75 percent in the case of 2010.")
rule AtRiskApplicablePercentage2010(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) strict {
    label en official "plan year beginning in 2010";
    when year_start_430(plan, y, start) and start >= @2010-01-01 and start <= @2010-12-31;
    then at_risk_applicable_percentage_430i4B(plan, y, 0.75);
}

pub relation in_at_risk_status_transition_430(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(i)(4)(A)(i) with the transition percentage: the preceding-year funding target attainment percentage is below the applicable percentage and below 70 percent with the at-risk assumptions";
}

@source(IRC_S430_I, relation = formalizes, coverage = partial, quote = "the funding target attainment percentage for the preceding plan year (determined under this section without regard to this subsection) is less than 80 percent")
rule InAtRiskStatusTransition430(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal, at_risk_pct: Decimal, applicable: Decimal) defeasible {
    label en official "PARTIAL: the (A)(i) test with the transition percentage in place of 80 percent; the (A)(ii) 70 percent test is kept; small plans (500 or fewer participants) are excepted by (i)(6)";
    when at_risk_applicable_percentage_430i4B(plan, y, applicable)
        and funding_target_attainment_percentage_430(plan, y, pct)
        and at_risk_funding_target_attainment_percentage_430(plan, y, at_risk_pct)
        and pct < applicable
        and at_risk_pct < 0.70;
    unless five_hundred_or_fewer_participants_430(plan, y);
    then in_at_risk_status_transition_430(plan, y);
}

// =====================================================================
// (j)(3) Underpayment and (j)(4) liquidity shortfall
// =====================================================================

pub relation installment_contributed_by_due_date_430j3(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, amount: Money) kind empirical {
    label en unofficial "the amount of the installment contributed on or before its due date, case-asserted (section 430(j)(3)(B)(i)(II))";
}

pub relation installment_underpayment_430j3B(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, amount: Money) kind institutional {
    label en official "section 430(j)(3)(B)(i): the underpayment of an installment is the required installment less the amount contributed by its due date";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "The amount of the underpayment shall be the excess of")
rule InstallmentUnderpayment430j3B(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, required: Money, paid: Money) strict {
    label en official "required - paid when positive; the required installment is that of module 18";
    when required_installment_amount_430(plan, y, required)
        and installment_contributed_by_due_date_430j3(plan, y, which, paid)
        and required > paid;
    then installment_underpayment_430j3B(plan, y, which, required - paid);
}

pub relation underpayment_contributed_on_430(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, on: Date) kind empirical {
    label en unofficial "the date the underpaid portion is contributed to or under the plan, case-asserted";
}

pub relation underpayment_interest_period_days_430j3Bii(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, days: Integer) kind institutional {
    label en official "section 430(j)(3)(B)(ii): the interest period runs from the due date of the installment to the date the portion is contributed";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "The period for which any interest is charged under this paragraph with respect to any portion of the underpayment shall run from the due date for the installment to the date on which such portion is contributed to or under the plan.")
rule UnderpaymentInterestPeriodDays430j3Bii(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, due: Date, paid_on: Date) strict {
    label en official "days between the two dates";
    when required_installment_due_date_430(plan, y, which, due) and underpayment_contributed_on_430(plan, y, which, paid_on) and paid_on >= due;
    then underpayment_interest_period_days_430j3Bii(plan, y, which, days_between(due, paid_on));
}

pub relation adjusted_disbursements_12_months_430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the sum of the adjusted disbursements from the plan for the 12 months ending on the last day of the quarter, case-asserted (section 430(j)(4)(E)(iv))";
}

pub relation liquid_assets_at_quarter_end_430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the value of the plan's liquid assets on the last day of the quarter, case-asserted ((E)(v))";
}

pub relation liquidity_base_amount_430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind institutional {
    label en official "section 430(j)(4)(E)(ii)(I): 3 times the adjusted disbursements of the 12 months ending on the quarter end";
}

@source(IRC_S430_J, relation = formalizes, coverage = partial, quote = "an amount equal to 3 times the sum of the adjusted disbursements from the plan for the 12 months ending on the last day of such quarter")
rule LiquidityBaseAmount430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, disbursements: Money) strict {
    label en official "PARTIAL: 3 x adjusted disbursements; the nonrecurring-circumstances exclusion of subclause (II) is not derived";
    when adjusted_disbursements_12_months_430j4(plan, y, quarter, disbursements);
    then liquidity_base_amount_430j4(plan, y, quarter, disbursements * 3.0);
}

pub relation liquidity_shortfall_430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind institutional {
    label en official "section 430(j)(4)(E)(i): the excess of the base amount over the liquid assets at the quarter end";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "the value (as of such last day) of the plan's liquid assets")
rule LiquidityShortfall430j4(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, base: Money, liquid: Money) strict {
    label en official "base - liquid assets when positive, exact";
    when liquidity_base_amount_430j4(plan, y, quarter, base) and liquid_assets_at_quarter_end_430j4(plan, y, quarter, liquid) and base > liquid;
    then liquidity_shortfall_430j4(plan, y, quarter, base - liquid);
}

pub relation liquidity_rule_applies_430j4b(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer) kind institutional {
    label en official "section 430(j)(4)(B): the liquidity rule applies to a plan (other than a small plan of (g)(2)(B)) that must pay installments and has a liquidity shortfall in a quarter";
}

pub relation plan_required_to_pay_installments_430j3(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is required to pay installments under paragraph (3) for the plan year, case-asserted";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "has a liquidity shortfall for any quarter during such plan year")
rule LiquidityRuleApplies430j4b(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, shortfall: Money) strict {
    label en official "not a plan that may designate its valuation date under (g)(2)(B); required to pay installments; a shortfall exists in the quarter";
    when plan_required_to_pay_installments_430j3(plan, y)
        and not_known(may_designate_valuation_date_430g2B(plan, y))
        and liquidity_shortfall_430j4(plan, y, quarter, shortfall);
    then liquidity_rule_applies_430j4b(plan, y, quarter);
}

// =====================================================================
// (c)(2)(D)(vi) Notice of the election
// =====================================================================

pub relation shortfall_election_notices_given_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor gave notice of the election to participants and beneficiaries and informed the PBGC, case-asserted";
}

@source(IRC_S430_C, relation = formalizes, coverage = partial, quote = "A plan sponsor of a plan who makes an election under clause (i) shall")
rule ShortfallElectionNoticeDuty(sponsor: Person, plan: DefinedBenefitPlan, y: TaxableYear, on: Date) strict {
    label en official "PARTIAL: the duty has no statutory time; the PBGC form and manner are the Director's";
    when shortfall_schedule_election_made_430(sponsor, plan, y, on) and db_plan_sponsor_430(plan, sponsor);
    then duty ShortfallElectionNoticeDutyPosition {
        bearer sponsor;
        beneficiary sponsor;
        goal maintenance {
            condition shortfall_election_notices_given_430(plan, y);
            window [-infinity, infinity];
        }
    };
}
