// Section 414 — definitions and special rules. Stage 1 (IRC-09),
// DECISION-0379. Priority: (q) highly compensated employee ($ threshold +
// 5%-owner test) fully. Also modelled to the extent PLAN family 8 requires:
// (b)/(c) controlled group / common control as a BRIEF CONTRACT to section
// 1563 (owned by `us.irc.corporations`, mid-write — pending dependency,
// see .deps.json), (m) affiliated service group (brief contract), (v)
// catch-up contributions (statutory base amounts), (w) eligible automatic
// contribution arrangements (brief).


// =====================================================================
// (q) Highly compensated employee
// =====================================================================

use self::{
    IRC_S402_E,
    IRC_S414_B,
    IRC_S414_C,
    IRC_S414_M,
    IRC_S414_P,
    IRC_S414_Q,
    IRC_S414_V,
    IRC_S414_W,
    Person,
    Plan,
    TaxableYear,
};

pub relation five_percent_owner_416i1(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee was a 5-percent owner (section 416(i)(1)) of the employer at any time during this year, case-asserted (the section 416(i)(1) ownership-attribution test itself is not separately reformalized in this stage)";
}

pub relation compensation_from_employer_preceding_year(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's compensation from the employer for the preceding year, within the meaning of section 415(c)(3), case-asserted";
}

pub relation top_paid_group_election_in_effect(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects the application of the top-paid-group limitation for the preceding year (section 414(q)(1)(B)(ii)), case-asserted";
}

pub relation in_top_paid_group(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is in the top 20 percent of employees ranked by compensation for this year (section 414(q)(3)), case-asserted (the ranking computation over the full census is not reformalized here — TECH_GAP, aggregate-over-derived-predicate limitation)";
}

pub relation highly_compensated_employee(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 414(q)(1): highly compensated employee — a 5-percent owner in the current or preceding year, or (if the employer elects the top-paid-group clause) an employee with preceding-year compensation over the section 414(q)(1)(B) threshold who is in the top-paid group";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "was a 5-percent owner at any time during the year or the preceding year")
rule HighlyCompensatedEmployeeFivePercentOwner(employee: Person, employer: Person, y: TaxableYear) strict {
    label en official "5-percent-owner branch of the HCE test";
    when five_percent_owner_416i1(employee, employer, y);
    then highly_compensated_employee(employee, employer, y);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "for the preceding year—")
rule HighlyCompensatedEmployeeCompensationAndTopPaid(employee: Person, employer: Person, y: TaxableYear, comp: Money) strict {
    label en official "compensation-and-top-paid-group branch, when the employer has elected the top-paid-group clause";
    when compensation_from_employer_preceding_year(employee, employer, y, comp)
        and comp > HCE_COMPENSATION_THRESHOLD
        and top_paid_group_election_in_effect(employer, y)
        and in_top_paid_group(employee, employer, y);
    then highly_compensated_employee(employee, employer, y);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "had compensation from the employer in excess of $80,000")
rule HighlyCompensatedEmployeeCompensationOnly(employee: Person, employer: Person, y: TaxableYear, comp: Money) strict {
    label en official "compensation-only branch, when the employer has NOT elected the top-paid-group clause (clause (ii) does not apply)";
    when compensation_from_employer_preceding_year(employee, employer, y, comp)
        and comp > HCE_COMPENSATION_THRESHOLD
        and not top_paid_group_election_in_effect(employer, y);
    then highly_compensated_employee(employee, employer, y);
}
// HCE_COMPENSATION_THRESHOLD is an A3 parameter
// (section-414q-hce-threshold.lawparam.json): statutory base $80,000 (the
// (q)(1) base period is the calendar quarter ending September 30, 1996).
// Only the statutory base is pinned; the annually adjusted amount is
// IRS-published, not in Title 26 text — SOURCE_GAP row.

// =====================================================================
// (b)/(c) Controlled group / common control — BRIEF CONTRACT
// =====================================================================
// `us.irc.corporations` (owner of section 1563) is mid-write per the task
// brief; this package cannot import a real `controlled_group_member`
// implementation yet. Recorded as a pending typed dependency
// (`.deps.json`), not an invented result.

pub relation controlled_group_member_1563(employer1: Person, employer2: Person, y: TaxableYear) kind empirical {
    label en unofficial "employer1 and employer2 are members of a controlled group of corporations within the meaning of section 1563(a) (section 414(b)), case-asserted pending the `us.irc.corporations` section 1563 implementation — EXTERNAL_DEPENDENCY, see coverage/.deps.json";
}

pub relation single_employer_controlled_group(employer1: Person, employer2: Person, y: TaxableYear) kind institutional {
    label en official "section 414(b): members of a controlled group of corporations are treated as a single employer for sections 401, 408(k), 408(p), 410, 411, 415 and 416";
}

@source(IRC_S414_B, relation = formalizes, coverage = exact, quote = "all employees of all corporations which are members of a controlled group of corporations (within the meaning of section 1563(a), determined without regard to section 1563(a)(4) and (e)(3)(C)) shall be treated as employed by a single employer")
rule SingleEmployerControlledGroup(employer1: Person, employer2: Person, y: TaxableYear) strict {
    label en official "controlled-group members are a single employer (pending the section 1563 test itself)";
    when controlled_group_member_1563(employer1, employer2, y);
    then single_employer_controlled_group(employer1, employer2, y);
}

pub relation common_control_trades_or_businesses(business1: Person, business2: Person, y: TaxableYear) kind empirical {
    label en unofficial "business1 and business2 (whether or not incorporated) are under common control within the meaning of section 414(c), case-asserted pending regulations based on section 414(b) principles — EXTERNAL_DEPENDENCY";
}

pub relation single_employer_common_control(business1: Person, business2: Person, y: TaxableYear) kind institutional {
    label en official "section 414(c): trades or businesses under common control are treated as a single employer";
}

@source(IRC_S414_C, relation = formalizes, coverage = exact, quote = "all employees of trades or businesses (whether or not incorporated) which are under common control shall be treated as employed by a single employer")
rule SingleEmployerCommonControl(business1: Person, business2: Person, y: TaxableYear) strict {
    label en official "common-control businesses are a single employer";
    when common_control_trades_or_businesses(business1, business2, y);
    then single_employer_common_control(business1, business2, y);
}

// =====================================================================
// (m) Affiliated service group — brief contract
// =====================================================================
pub relation affiliated_service_group_member(org1: Person, org2: Person, y: TaxableYear) kind empirical {
    label en unofficial "org1 and org2 are members of an affiliated service group within the meaning of section 414(m)(2), case-asserted (the (m)(2)(A)/(B) qualitative tests are not reformalized here)";
}

pub relation single_employer_affiliated_service_group(org1: Person, org2: Person, y: TaxableYear) kind institutional {
    label en official "section 414(m)(1): affiliated service group members are treated as a single employer for the listed employee-benefit requirements";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "all employees of the members of an affiliated service group shall be treated as employed by a single employer")
rule SingleEmployerAffiliatedServiceGroup(org1: Person, org2: Person, y: TaxableYear) strict {
    label en official "affiliated-service-group members are a single employer";
    when affiliated_service_group_member(org1, org2, y);
    then single_employer_affiliated_service_group(org1, org2, y);
}

// =====================================================================
// (v) Catch-up contributions for individuals age 50 or over
// =====================================================================
pub relation eligible_catch_up_participant(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant would attain age 50 by the end of the taxable year (section 414(v)(5)(A)), case-asserted";
}

pub relation catch_up_contribution_elected(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an additional elective deferral made under the catch-up provision, case-asserted";
}

pub relation catch_up_contribution_within_limit(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(v)(2)(A): the additional elective deferral does not exceed the applicable dollar amount for a general (non-SIMPLE) applicable employer plan (statutory base)";
}

@source(IRC_S414_V, relation = formalizes, coverage = partial, quote = "In the case of an applicable employer plan other than a plan described in section 401(k)(11) or 408(p), the applicable dollar amount is $5,000")
rule CatchUpContributionWithinLimit(participant: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "catch-up contribution at or below the statutory-base applicable dollar amount for general plans (the age-60-to-63 increased amount of (2)(E) and the SIMPLE-plan amount of (2)(B) are NOT modelled — TECH_GAP)";
    when eligible_catch_up_participant(participant, y)
        and catch_up_contribution_elected(participant, plan, y, amount)
        and amount <= CATCH_UP_CONTRIBUTION_LIMIT;
    then catch_up_contribution_within_limit(participant, plan, y, amount);
}
// CATCH_UP_CONTRIBUTION_LIMIT is an A3 parameter
// (section-414v-catch-up-limit.lawparam.json): statutory base $5,000 (the
// general, non-SIMPLE applicable-employer-plan amount; (v)(2)(C) base
// period is the calendar quarter beginning July 1, 2005). Only the
// statutory base is pinned — SOURCE_GAP for the annually adjusted amount.

// =====================================================================
// (w) Eligible automatic contribution arrangements — brief
// =====================================================================
pub relation permissible_withdrawal_elected(employee: Person, plan: Plan, on: Date, amount: Money) kind empirical {
    label en unofficial "the employee elects a permissible withdrawal from an eligible automatic contribution arrangement, case-asserted";
}

pub relation permissible_withdrawal_includible(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(w)(1)(A): the amount of a permissible withdrawal is includible in the employee's gross income for the year of distribution, with no section 72(t) tax";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "the amount of any such withdrawal shall be includible in the gross income of the employee for the taxable year of the employee in which the distribution is made")
rule PermissibleWithdrawalIncludible(employee: Person, plan: Plan, on: Date, y: TaxableYear, amount: Money) strict {
    label en official "a permissible EACA withdrawal is included in gross income for the distribution year";
    when permissible_withdrawal_elected(employee, plan, on, amount) and us.irc.core::year_of(employee, y);
    then permissible_withdrawal_includible(employee, plan, y, amount);
}

// =====================================================================
// STAGE 2 (25.09.2026): (p) Qualified domestic relations order — the QDRO
// as a POWER (the alternate payee's right to plan benefits is created by
// the order becoming "qualified"), with the (2)/(3) validity conditions
// folded into a single `qdro_eligible_to_be_recognized` helper relation
// per the one-atom `valid_when` constraint (core-surfaces.md/rights-
// positions.md; see the `04-402-distributions.law` rollover note for the
// same pattern). (4) earliest-retirement-age safe harbor to (3)(A), (5)
// former-spouse-as-surviving-spouse, (6)/(7) plan administrator notice/
// segregation procedures, and (9)-(13) are NOT modelled (TECH_GAP, stage 2
// — see coverage notes).
// =====================================================================

pub entity DomesticRelationsOrder {
    label en unofficial "a judgment, decree, or order (including approval of a property settlement agreement) under a State or Tribal domestic relations law (section 414(p)(1)(B))";
}

pub relation domestic_relations_order_of(order: DomesticRelationsOrder, participant: Person, alternate_payee: Person) kind empirical {
    label en unofficial "this order creates, recognizes, or assigns to this alternate payee the right to receive all or a portion of the benefits payable under a plan with respect to this participant, case-asserted (section 414(p)(1)(A)(i)/(8))";
}

pub relation domestic_relations_order_relates_to_marital_matter(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order relates to child support, alimony payments, or marital property rights to a spouse, former spouse, child, or other dependent of the participant, and is made pursuant to a State or Tribal domestic relations law, case-asserted (section 414(p)(1)(B))";
}

pub relation order_specifies_required_facts(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies: (A) the participant's and each alternate payee's name and mailing address, (B) the amount or percentage (or the manner of determining it), (C) the number of payments or period, and (D) each plan to which it applies, case-asserted (section 414(p)(2)(A)-(D))";
}

pub relation order_does_not_alter_plan_benefits(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order does not require the plan to provide a type, form, or option not otherwise provided, does not require increased (actuarially valued) benefits, and does not require payment of amounts already assigned to another alternate payee under a prior QDRO, case-asserted (section 414(p)(3)(A)-(C); the (4) earliest-retirement-age safe harbor to (3)(A) is not separately modelled — TECH_GAP)";
}

pub relation qdro_requirements_2_and_3_met(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(1)(A)(ii): the order meets both the (2) specificity requirements and the (3) no-benefit-alteration requirements";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "with respect to which the requirements of paragraphs (2) and (3) are met")
rule QdroRequirements2And3Met(order: DomesticRelationsOrder) strict {
    label en official "both the specificity and no-alteration requirements must hold";
    when order_specifies_required_facts(order) and order_does_not_alter_plan_benefits(order);
    then qdro_requirements_2_and_3_met(order);
}

pub relation qdro_eligible_to_be_recognized(order: DomesticRelationsOrder) kind institutional {
    label en official "the single valid_when atom combining all section 414(p) validity conditions: a (1)(B) domestic relations order that meets the (2)/(3) requirements";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "The term \"qualified domestic relations order\" means a domestic relations order")
rule QdroEligibleToBeRecognized(order: DomesticRelationsOrder) strict {
    label en official "a domestic relations order becomes eligible for QDRO recognition once it relates to a marital matter and meets the (2)/(3) requirements";
    when domestic_relations_order_relates_to_marital_matter(order) and qdro_requirements_2_and_3_met(order);
    then qdro_eligible_to_be_recognized(order);
}

pub relation qdro_recognized(order: DomesticRelationsOrder, participant: Person, alternate_payee: Person) kind institutional {
    label en official "section 414(p)(1)(A): this domestic relations order is a qualified domestic relations order, recognizing the alternate payee's right to plan benefits";
}

pub relation qdro_alternate_payee_treated_as_distributee(order: DomesticRelationsOrder, alternate_payee: Person) kind institutional {
    label en official "section 402(a)(9)/402(e)(1)(A)-style rule (cross-referenced from section 414(p)): a spouse or former spouse alternate payee under a QDRO is treated as the distributee of any distribution or payment made to the alternate payee";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "which creates or recognizes the existence of an alternate payee's right to, or assigns to an alternate payee the right to, receive all or a portion of the benefits payable with respect to a participant under a plan")
rule QdroRecognitionPowerRule(order: DomesticRelationsOrder, participant: Person, alternate_payee: Person) strict {
    label en official "the domestic relations order is recognized as QUALIFIED only when it satisfies all section 414(p) validity conditions; the effect is the alternate payee's recognized right to the assigned plan benefits";
    when domestic_relations_order_of(order, participant, alternate_payee);
    then power QdroRecognitionPower {
        holder alternate_payee;
        over participant;
        exercise domestic_relations_order_of(order, participant, alternate_payee);
        valid_when qdro_eligible_to_be_recognized(order);
        effect qdro_recognized(order, participant, alternate_payee);
    };
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "an alternate payee who is the spouse or former spouse of the participant shall be treated as the distributee of any distribution or payment made to the alternate payee under a qualified domestic relations order")
rule QdroAlternatePayeeTreatedAsDistributee(order: DomesticRelationsOrder, participant: Person, alternate_payee: Person) defeasible {
    label en official "the spouse/former-spouse alternate payee steps into the distributee role for tax purposes once the QDRO is recognized";
    when qdro_recognized(order, participant, alternate_payee);
    then qdro_alternate_payee_treated_as_distributee(order, alternate_payee);
}
// (p)(3)(A) itself is subject to the (4) earliest-retirement-age exception
// (payment before separation from service, valued without the early-
// retirement subsidy, in an otherwise-available form) — NOT modelled
// (TECH_GAP). (p)(5) former-spouse-as-surviving-spouse for sections
// 401(a)(11)/417 purposes, (p)(6)/(7) plan administrator notice/
// segregated-amount procedures (18-month determination period), (p)(9)
// section 403(b) extension, (p)(10) waiver of distribution-timing
// restrictions, (p)(11)-(13) are NOT modelled this stage (TECH_GAP).
