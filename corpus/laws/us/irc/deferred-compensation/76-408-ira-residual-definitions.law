// Section 408 residuals — STAGE 3b (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): (a) IRA trust conditions, (d)(3)(C) inherited IRAs, (d)(3)(H)(ii),
// (d)(4)-(5) returned and excess contributions, (d)(9)(D) HSA testing period,
// (e) tax treatment, (k)(2) SEP participation, (k)(6) SEP deferral tests,
// (m) collectibles, (q) deemed IRAs.
//
// Pattern as in modules 07/19/20/60: statutory conditions are case facts and
// the derived treatment relations carry the outcome; dollar amounts and dates
// are exact. The regulations of the Secretary are external.

// =====================================================================
// (a) Individual retirement account trust conditions
// =====================================================================

use self::{
    Distribution,
    IRC_S408_A,
    IRC_S408_D,
    IRC_S408_E,
    IRC_S408_K,
    IRC_S408_M,
    IRC_S408_Q,
    Person,
    Plan,
    TaxableYear,
};

pub relation trust_created_in_us_for_exclusive_benefit_408a(trust: Person) kind empirical {
    label en unofficial "the trust is created or organized in the United States for the exclusive benefit of an individual or his beneficiaries, case-asserted";
}

pub relation instrument_trustee_is_bank_or_approved_408a2(trust: Person) kind empirical {
    label en unofficial "the trustee is a bank (subsection (n)) or another person who demonstrates to the Secretary satisfactory administration, case-asserted";
}

pub relation instrument_no_life_insurance_investment_408a3(trust: Person) kind empirical {
    label en unofficial "no part of the trust funds will be invested in life insurance contracts, case-asserted";
}

pub relation instrument_not_commingled_408a5(trust: Person) kind empirical {
    label en unofficial "the assets are not commingled with other property except in a common trust fund or common investment fund, case-asserted";
}

pub relation instrument_distribution_rules_similar_to_401a9_408a6(trust: Person) kind empirical {
    label en unofficial "rules similar to section 401(a)(9) and the incidental death benefit requirements apply to the distribution of the entire interest, case-asserted";
}

pub relation instrument_meets_other_requirements_408a1_4(trust: Person) kind empirical {
    label en unofficial "the instrument meets paragraph (1) (annual contribution limit) and paragraph (4) (nonforfeitable), case-asserted (modules 07/19)";
}

pub relation individual_retirement_account_trust_408a(trust: Person) kind institutional {
    label en official "section 408(a): a domestic trust for the exclusive benefit of an individual whose instrument meets the six requirements";
}

@source(IRC_S408_A, relation = formalizes, coverage = exact, quote = "the term \"individual retirement account\" means a trust created or organized in the United States for the exclusive benefit of an individual or his beneficiaries, but only if the written governing instrument creating the trust meets the following requirements")
rule IndividualRetirementAccountTrust408a(trust: Person) strict {
    label en official "all requirements";
    when trust_created_in_us_for_exclusive_benefit_408a(trust)
        and instrument_meets_other_requirements_408a1_4(trust)
        and instrument_trustee_is_bank_or_approved_408a2(trust)
        and instrument_no_life_insurance_investment_408a3(trust)
        and instrument_not_commingled_408a5(trust)
        and instrument_distribution_rules_similar_to_401a9_408a6(trust);
    then individual_retirement_account_trust_408a(trust);
}

// =====================================================================
// (d)(3)(C) Inherited IRAs; (d)(3)(H)(ii)
// =====================================================================

pub relation ira_acquired_by_reason_of_death_408d3Cii(account: Person, beneficiary: Person, decedent: Person) kind empirical {
    label en unofficial "the individual for whom the account is maintained acquired it by reason of the death of another individual, case-asserted";
}

pub relation beneficiary_is_surviving_spouse_408d3Cii(beneficiary: Person, decedent: Person) kind empirical {
    label en unofficial "the individual was the surviving spouse of the decedent, case-asserted";
}

pub relation inherited_ira_408d3Cii(account: Person) kind institutional {
    label en official "section 408(d)(3)(C)(ii): an IRA is inherited if acquired by reason of another individual's death by a person who was not the surviving spouse";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "such individual was not the surviving spouse of such other individual")
rule InheritedIra408d3Cii(account: Person, beneficiary: Person, decedent: Person) strict {
    label en official "acquired by death; not the surviving spouse";
    when ira_acquired_by_reason_of_death_408d3Cii(account, beneficiary, decedent)
        and not_known(beneficiary_is_surviving_spouse_408d3Cii(beneficiary, decedent));
    then inherited_ira_408d3Cii(account);
}

pub relation inherited_ira_not_a_rollover_account_408d3Ci(account: Person) kind institutional {
    label en official "section 408(d)(3)(C)(i)(II): an inherited IRA is not treated as an IRA for determining whether any other amount is a rollover contribution";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "such inherited account or annuity shall not be treated as an individual retirement account or annuity for purposes of determining whether any other amount is a rollover contribution")
rule InheritedIraNotARolloverAccount408d3Ci(account: Person) strict {
    label en official "inherited IRA";
    when inherited_ira_408d3Cii(account);
    then inherited_ira_not_a_rollover_account_408d3Ci(account);
}

pub relation distribution_rolled_over_from_iras_408d3Hii(d: Distribution, rolled_over: Money, aggregate_ira_income: Money) kind empirical {
    label en unofficial "the portion of the distribution rolled over and the aggregate income on the contract from all the distributee's individual retirement plans, case-asserted";
}

pub relation rolled_over_portion_treated_as_income_408d3Hii(d: Distribution, income_portion: Money) kind institutional {
    label en official "section 408(d)(3)(H)(ii)(II): the rolled-over portion is treated as from income on the contract, to the extent of the aggregate income on the contract from all the distributee's IRAs";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the portion of such distribution rolled over to an eligible retirement plan described in clause (i) shall be treated as from income on the contract")
rule RolledOverPortionTreatedAsIncome408d3Hii(d: Distribution, rolled: Money, income: Money) strict {
    label en official "min(rolled over, aggregate income)";
    when distribution_rolled_over_from_iras_408d3Hii(d, rolled, income);
    then rolled_over_portion_treated_as_income_408d3Hii(d, min(rolled, income));
}

// =====================================================================
// (d)(4), (d)(5) Returned and excess contributions
// =====================================================================

pub relation returned_contribution_distributed_on_408d4A(individual: Person, y: TaxableYear, on: Date, return_due: Date) kind empirical {
    label en unofficial "the date the contribution is returned and the day prescribed by law (with extensions) for filing the individual's return for the year, case-asserted";
}

pub relation no_219_deduction_allowed_408d4B(individual: Person, y: TaxableYear) kind empirical {
    label en unofficial "no deduction is allowed under section 219 for the contribution, case-asserted";
}

pub relation net_income_returned_408d4C(individual: Person, y: TaxableYear, returned_with_contribution: Boolean) kind empirical {
    label en unofficial "the distribution is accompanied by the net income attributable to the contribution, case-asserted";
}

pub relation returned_contribution_outside_paragraph_1_408d4(individual: Person, y: TaxableYear) kind institutional {
    label en official "section 408(d)(4): a contribution returned by the return due date (with extensions) with its net income, and not deducted, is outside paragraph (1)";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "such distribution is received on or before the day prescribed by law (including extensions of time) for filing such individual's return for such taxable year")
rule ReturnedContributionOutsideParagraph1408d4(individual: Person, y: TaxableYear, on: Date, due: Date) strict {
    label en official "exact boundary: on the due date is timely";
    when returned_contribution_distributed_on_408d4A(individual, y, on, due)
        and on <= due
        and no_219_deduction_allowed_408d4B(individual, y)
        and net_income_returned_408d4C(individual, y, true);
    then returned_contribution_outside_paragraph_1_408d4(individual, y);
}

pub relation net_income_year_of_contribution_408d4(individual: Person, y: TaxableYear, income: Money) kind institutional {
    label en official "section 408(d)(4): the net income is deemed earned and receivable in the taxable year the contribution is made";
}

pub relation net_income_of_returned_contribution_408d4(individual: Person, y: TaxableYear, income: Money) kind empirical {
    label en unofficial "the amount of net income attributable to the returned contribution, case-asserted";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "any net income described in subparagraph (C) shall be deemed to have been earned and receivable in the taxable year in which such contribution is made")
rule NetIncomeYearOfContribution408d4(individual: Person, y: TaxableYear, income: Money) strict {
    label en official "year of the contribution";
    when returned_contribution_outside_paragraph_1_408d4(individual, y)
        and net_income_of_returned_contribution_408d4(individual, y, income);
    then net_income_year_of_contribution_408d4(individual, y, income);
}

pub relation aggregate_non_rollover_contributions_408d5A(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate contributions (other than rollovers) paid for the year to IRAs, case-asserted";
}

pub relation dollar_limit_219b1A_408d5A(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dollar amount in effect under section 219(b)(1)(A), case-asserted";
}

pub relation sep_employer_contribution_408d5A(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employer contributions to a simplified employee pension for the year, case-asserted";
}

pub relation section_415c1A_limit_408d5A(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dollar limitation in effect under section 415(c)(1)(A) for the year, case-asserted";
}

pub relation excess_rollover_relief_408d5B(individual: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the excess contribution attributable to erroneous information reasonably relied on for a rollover, case-asserted";
}

pub relation limit_for_late_excess_distribution_408d5A(individual: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(5)(A)-(B): the dollar limit for a late excess distribution: the 219(b)(1)(A) amount, increased by the lesser of SEP contributions and the 415(c)(1)(A) limit, and by the erroneous-information relief";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the dollar limitation of the preceding sentence shall be increased by the lesser of the amount of such contributions or the dollar limitation in effect under section 415(c)(1)(A) for such taxable year")
rule LimitForLateExcessDistribution408d5A(individual: Person, y: TaxableYear, base: Money, sep: Money, l415: Money, relief: Money) strict {
    label en official "base + min(SEP contributions, 415(c)(1)(A) limit) + erroneous-information relief";
    when dollar_limit_219b1A_408d5A(individual, y, base)
        and sep_employer_contribution_408d5A(individual, y, sep)
        and section_415c1A_limit_408d5A(individual, y, l415)
        and excess_rollover_relief_408d5B(individual, y, relief);
    then limit_for_late_excess_distribution_408d5A(individual, y, base + min(sep, l415) + relief);
}

pub relation late_excess_distribution_outside_paragraph_1_408d5A(individual: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(5)(A): the distribution of an excess contribution after the paragraph (4) date is outside paragraph (1) when the aggregate contributions do not exceed the limit, to the extent no section 219 deduction was allowed";
}

pub relation excess_contribution_distributed_after_4_date_408d5A(individual: Person, y: TaxableYear, excess: Money, deducted: Money) kind empirical {
    label en unofficial "the excess of the contribution over the section 219 allowable deduction, distributed after the paragraph (4) date, and the part for which a deduction has been allowed, case-asserted";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "but only to the extent that no deduction has been allowed under section 219 with respect to such excess contribution")
rule LateExcessDistributionOutsideParagraph1408d5A(individual: Person, y: TaxableYear, total: Money, limit: Money, excess: Money, deducted: Money) strict {
    label en official "exact boundary: aggregate contributions equal to the limit qualify; the amount is the excess less the deducted part";
    when aggregate_non_rollover_contributions_408d5A(individual, y, total)
        and limit_for_late_excess_distribution_408d5A(individual, y, limit)
        and total <= limit
        and excess_contribution_distributed_after_4_date_408d5A(individual, y, excess, deducted);
    then late_excess_distribution_outside_paragraph_1_408d5A(individual, y, max(0 USD, excess - deducted));
}

// =====================================================================
// (d)(9)(D) HSA funding distribution testing period
// =====================================================================

pub relation hsa_funding_distribution_contributed_month_408d9D(individual: Person, year: Integer, month: Integer) kind empirical {
    label en unofficial "the year and month (1 to 12) in which the qualified HSA funding distribution is contributed to a health savings account, case-asserted";
}

pub relation testing_period_end_408d9Diii(individual: Person, year: Integer, month: Integer) kind institutional {
    label en official "section 408(d)(9)(D)(iii): the testing period begins with the contribution month and ends on the last day of the 12th month following (the year and month of that 12th month)";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "ending on the last day of the 12th month following such month")
rule TestingPeriodEnd408d9Diii(individual: Person, year: Integer, month: Integer) strict {
    label en official "month + 12 lands on the same month one year later";
    when hsa_funding_distribution_contributed_month_408d9D(individual, year, month)
        and month >= 1 and month <= 12;
    then testing_period_end_408d9Diii(individual, year + 1, month);
}

pub relation eligible_individual_at_month_408d9D(individual: Person, year: Integer, month: Integer) kind empirical {
    label en unofficial "the individual is an eligible individual in the month, case-asserted (one row per month of the testing period)";
}

pub relation hsa_not_eligible_in_testing_period_408d9Di(individual: Person, year: Integer, month: Integer) kind empirical {
    label en unofficial "the individual is not an eligible individual in this month of the testing period, case-asserted";
}

pub relation death_or_disability_ended_eligibility_408d9Dii(individual: Person) kind empirical {
    label en unofficial "the individual ceased to be an eligible individual by reason of death or becoming disabled (section 72(m)(7)), case-asserted";
}

pub relation hsa_funding_amount_includible_408d9Di(individual: Person, includible: Money, additional_tax: Money) kind institutional {
    label en official "section 408(d)(9)(D)(i): failing to remain eligible in the testing period makes the funding amount includible and adds 10 percent (unless death or disability)";
}

pub relation hsa_funding_amount_408d9A(individual: Person, amount: Money) kind empirical {
    label en unofficial "the aggregate of the contributions to the health savings account under subparagraph (A), case-asserted";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the tax imposed by this chapter for any taxable year on the individual shall be increased by 10 percent of the amount which is so includible")
rule HsaFundingAmountIncludible408d9Di(individual: Person, year: Integer, month: Integer, amount: Money) strict {
    label en official "amount and 10 percent (HALF_UP) when the individual was ineligible in the testing period and not by death or disability";
    when hsa_not_eligible_in_testing_period_408d9Di(individual, year, month)
        and hsa_funding_amount_408d9A(individual, amount)
        and not_known(death_or_disability_ended_eligibility_408d9Dii(individual));
    then hsa_funding_amount_includible_408d9Di(individual, amount, round(amount * 0.10, 2, "HALF_UP"));
}

// =====================================================================
// (e) Tax treatment
// =====================================================================

pub relation ira_ceased_by_prohibited_transaction_or_pledge_408e1(account: Person) kind empirical {
    label en unofficial "the account ceased to be an IRA by reason of paragraph (2) or (3), case-asserted";
}

pub relation ira_exempt_from_tax_408e1(account: Person) kind institutional {
    label en official "section 408(e)(1): an IRA is exempt from tax unless it ceased to be an IRA under paragraph (2) or (3) (the section 511 tax still applies)";
}

pub relation is_ira_for_408e1(account: Person) kind empirical {
    label en unofficial "the account is an individual retirement account, case-asserted";
}

@source(IRC_S408_E, relation = formalizes, coverage = exact, quote = "Any individual retirement account is exempt from taxation under this subtitle unless such account has ceased to be an individual retirement account by reason of paragraph (2) or (3)")
rule IraExemptFromTax408e1(account: Person) strict {
    label en official "not ceased";
    when is_ira_for_408e1(account)
        and not_known(ira_ceased_by_prohibited_transaction_or_pledge_408e1(account));
    then ira_exempt_from_tax_408e1(account);
}

pub relation account_established_for_individual_408e2A(account: Person, individual: Person) kind empirical {
    label en unofficial "the individual for whose benefit the account was established, case-asserted";
}

pub relation individual_treated_as_creator_408e2A(account: Person, individual: Person) kind institutional {
    label en official "section 408(e)(2)(A)(i): the individual for whose benefit any account was established is treated as its creator";
}

@source(IRC_S408_E, relation = formalizes, coverage = exact, quote = "the individual for whose benefit any account was established is treated as the creator of such account")
rule IndividualTreatedAsCreator408e2A(account: Person, individual: Person) strict {
    label en official "beneficiary as creator";
    when account_established_for_individual_408e2A(account, individual);
    then individual_treated_as_creator_408e2A(account, individual);
}

pub relation employer_maintained_ira_separate_account_408e2Aii(account: Person, separate_account: Person) kind empirical {
    label en unofficial "a separate account within an IRA maintained by an employer or association of employees, case-asserted";
}

pub relation separate_account_treated_as_separate_ira_408e2Aii(separate_account: Person) kind institutional {
    label en official "section 408(e)(2)(A)(ii): a separate account within an employer-maintained IRA is a separate IRA";
}

@source(IRC_S408_E, relation = formalizes, coverage = exact, quote = "the separate account for any individual within an individual retirement account maintained by an employer or association of employees is treated as a separate individual retirement account")
rule SeparateAccountTreatedAsSeparateIra408e2Aii(account: Person, sep: Person) strict {
    label en official "separate accounts";
    when employer_maintained_ira_separate_account_408e2Aii(account, sep);
    then separate_account_treated_as_separate_ira_408e2Aii(sep);
}

pub relation each_ira_plan_of_individual_408e2Aiii(individual: Person, plan: Person) kind empirical {
    label en unofficial "an individual retirement plan of the individual, case-asserted";
}

pub relation ira_plan_treated_as_separate_contract_408e2Aiii(plan: Person) kind institutional {
    label en official "section 408(e)(2)(A)(iii): each individual retirement plan of the individual is treated as a separate contract";
}

@source(IRC_S408_E, relation = formalizes, coverage = exact, quote = "each individual retirement plan of the individual shall be treated as a separate contract")
rule IraPlanTreatedAsSeparateContract408e2Aiii(individual: Person, plan: Person) strict {
    label en official "each plan";
    when each_ira_plan_of_individual_408e2Aiii(individual, plan);
    then ira_plan_treated_as_separate_contract_408e2Aiii(plan);
}

pub relation endowment_purchase_with_ira_assets_408e5(account: Person, non_insurance_amount: Money, insurance_amount: Money) kind empirical {
    label en unofficial "the IRA assets used to purchase an endowment contract for the individual, split into the part not attributable to insurance and the part attributable to life, health, accident or other insurance, case-asserted";
}

pub relation endowment_purchase_treated_408e5(account: Person, rollover_part: Money, distributed_part: Money) kind institutional {
    label en official "section 408(e)(5): the part of the assets not attributable to insurance is a rollover contribution; the part attributable to insurance is treated as distributed (without subsection (f))";
}

@source(IRC_S408_E, relation = formalizes, coverage = exact, quote = "such amounts are treated as distributed to that individual")
rule EndowmentPurchaseTreated408e5(account: Person, non_ins: Money, ins: Money) strict {
    label en official "the two parts";
    when endowment_purchase_with_ira_assets_408e5(account, non_ins, ins);
    then endowment_purchase_treated_408e5(account, non_ins, ins);
}

pub relation common_fund_includes_501a_trust_408e6(fund: Person) kind empirical {
    label en unofficial "the common trust fund or common investment fund of IRA assets includes assets of a section 501(a) trust described in the provision, case-asserted";
}

pub relation common_fund_does_not_cease_exempt_408e6(fund: Person) kind institutional {
    label en official "section 408(e)(6): the fund does not cease to be exempt on account of the participation or inclusion of assets of an exempt section 401(a) trust";
}

@source(IRC_S408_E, relation = formalizes, coverage = partial, quote = "does not cease to be exempt on account of the participation or inclusion of assets of a trust exempt from taxation under section 501(a)")
rule CommonFundDoesNotCeaseExempt408e6(fund: Person) strict {
    label en official "PARTIAL: the described trust is one case fact";
    when common_fund_includes_501a_trust_408e6(fund);
    then common_fund_does_not_cease_exempt_408e6(fund);
}

// =====================================================================
// (k) Simplified employee pensions
// =====================================================================

pub relation sep_employee_age_408k2A(employee: Person, age: Integer) kind empirical {
    label en unofficial "the employee's age, case-asserted";
}

pub relation sep_years_of_service_in_preceding_5_408k2B(employee: Person, years: Integer) kind empirical {
    label en unofficial "the number of the immediately preceding 5 years during which the employee performed service, case-asserted";
}

pub relation sep_compensation_from_employer_408k2C(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation (section 414(q)(4)) received from the employer for the year, case-asserted";
}

pub relation sep_employee_excluded_by_410b3_408k2(employee: Person) kind empirical {
    label en unofficial "the employee is described in section 410(b)(3)(A) or (C), case-asserted";
}

pub relation sep_employee_must_receive_contribution_408k2(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(2): the employer must contribute for each employee who has attained age 21, performed service in at least 3 of the preceding 5 years and received at least $450 in compensation, excluding section 410(b)(3)(A) and (C) employees";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "received at least $450 in compensation (within the meaning of section 414(q)(4)) from the employer for the year")
rule SepEmployeeMustReceiveContribution408k2(employee: Person, y: TaxableYear, age: Integer, years: Integer, comp: Money) strict {
    label en official "exact boundaries: age 21, 3 years and $450 are inside";
    when sep_employee_age_408k2A(employee, age)
        and sep_years_of_service_in_preceding_5_408k2B(employee, years)
        and sep_compensation_from_employer_408k2C(employee, y, comp)
        and not_known(sep_employee_excluded_by_410b3_408k2(employee))
        and age >= 21 and years >= 3 and comp >= 450.00 USD;
    then sep_employee_must_receive_contribution_408k2(employee, y);
}

pub relation employee_eligible_under_k6_arrangement_408k2(employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is eligible to have employer contributions made under an arrangement described in subsection (k)(6), case-asserted";
}

pub relation employee_treated_as_contribution_made_408k2(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(2) last sentence: for a (k)(6) arrangement an eligible employee is treated as if a contribution was made";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "any employee who is eligible to have employer contributions made on the employee's behalf under such arrangement shall be treated as if such a contribution was made")
rule EmployeeTreatedAsContributionMade408k2(employee: Person, y: TaxableYear) strict {
    label en official "eligible under the (k)(6) arrangement";
    when employee_eligible_under_k6_arrangement_408k2(employee, y);
    then employee_treated_as_contribution_made_408k2(employee, y);
}

pub relation hce_deferral_percentage_408k6Aiii(employee: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the deferral percentage for the year of a highly compensated employee eligible to participate (0.06 = 6 percent), case-asserted";
}

pub relation nhce_average_deferral_percentage_408k6Aiii(plan: Plan, y: TaxableYear, avg: Decimal) kind empirical {
    label en unofficial "the average of the deferral percentages of all employees other than highly compensated employees eligible to participate, case-asserted";
}

pub relation hce_deferral_within_125_percent_408k6Aiii(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 408(k)(6)(A)(iii): the highly compensated employee's deferral percentage is not more than 1.25 times the nonhighly compensated average";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "is not more than the product of")
rule HceDeferralWithin125Percent408k6Aiii(employee: Person, plan: Plan, y: TaxableYear, hce: Decimal, avg: Decimal) strict {
    label en official "exact boundary: hce <= avg x 1.25 (equal is allowed)";
    when hce_deferral_percentage_408k6Aiii(employee, y, hce)
        and nhce_average_deferral_percentage_408k6Aiii(plan, y, avg)
        and hce <= avg * 1.25;
    then hce_deferral_within_125_percent_408k6Aiii(employee, plan, y);
}

pub relation sep_excess_contribution_k6c_408k6Ci(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an excess contribution under a simplified employee pension, case-asserted";
}

pub relation sep_excess_treated_for_4979_408k6Ci(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(k)(6)(C)(i): an excess contribution under a simplified employee pension is an excess contribution for purposes of section 4979, and rules similar to section 401(k)(8) apply";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "Any excess contribution under a simplified employee pension shall be treated as an excess contribution for purposes of section 4979")
rule SepExcessTreatedFor4979408k6Ci(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "excess contribution";
    when sep_excess_contribution_k6c_408k6Ci(plan, y, amount);
    then sep_excess_treated_for_4979_408k6Ci(plan, y, amount);
}

// =====================================================================
// (m) Collectibles
// =====================================================================

pub enum CollectibleKind408m {
    WorkOfArt;
    RugOrAntique;
    MetalOrGem;
    StampOrCoin;
    AlcoholicBeverage;
    OtherSpecifiedBySecretary;
    Other;
}

pub relation asset_kind_408m2(asset: Person, kind: CollectibleKind408m) kind empirical {
    label en unofficial "the kind of the tangible personal property, case-asserted";
}

pub relation collectible_408m2(asset: Person) kind institutional {
    label en official "section 408(m)(2): a work of art, rug or antique, metal or gem, stamp or coin, alcoholic beverage, or other tangible personal property the Secretary specifies";
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "any work of art")
rule Collectible408m2Art(asset: Person) strict {
    label en official "(A)";
    when asset_kind_408m2(asset, WorkOfArt);
    then collectible_408m2(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "any rug or antique")
rule Collectible408m2Rug(asset: Person) strict {
    label en official "(B)";
    when asset_kind_408m2(asset, RugOrAntique);
    then collectible_408m2(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "any metal or gem")
rule Collectible408m2Metal(asset: Person) strict {
    label en official "(C)";
    when asset_kind_408m2(asset, MetalOrGem);
    then collectible_408m2(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "any stamp or coin")
rule Collectible408m2Stamp(asset: Person) strict {
    label en official "(D)";
    when asset_kind_408m2(asset, StampOrCoin);
    then collectible_408m2(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "any alcoholic beverage")
rule Collectible408m2Alcohol(asset: Person) strict {
    label en official "(E)";
    when asset_kind_408m2(asset, AlcoholicBeverage);
    then collectible_408m2(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = partial, quote = "any other tangible personal property specified by the Secretary for purposes of this subsection")
rule Collectible408m2Other(asset: Person) strict {
    label en official "(F) PARTIAL: the Secretary's specification is a case fact";
    when asset_kind_408m2(asset, OtherSpecifiedBySecretary);
    then collectible_408m2(asset);
}

pub enum CollectibleExclusion408m3 {
    GoldCoin5112a;
    SilverCoin5112e;
    PlatinumCoin5112k;
    StateIssuedCoin;
    BullionInTrusteePossession;
    None;
}

pub relation asset_exclusion_408m3(asset: Person, exclusion: CollectibleExclusion408m3) kind empirical {
    label en unofficial "the exclusion that applies to the property (a listed coin, a state coin, or bullion of the required fineness in the trustee's physical possession), case-asserted";
}

pub relation collectible_408m3_excluded(asset: Person) kind institutional {
    label en official "section 408(m)(3): listed coins and bullion of the required fineness in a trustee's physical possession are not collectibles";
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "a gold coin described in paragraph (7), (8), (9), or (10) of section 5112(a) of title 31, United States Code")
rule CollectibleExcludedGold408m3(asset: Person) strict {
    label en official "(A)(i)";
    when asset_exclusion_408m3(asset, GoldCoin5112a);
    then collectible_408m3_excluded(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "a silver coin described in section 5112(e) of title 31, United States Code")
rule CollectibleExcludedSilver408m3(asset: Person) strict {
    label en official "(A)(ii)";
    when asset_exclusion_408m3(asset, SilverCoin5112e);
    then collectible_408m3_excluded(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "a platinum coin described in section 5112(k) of title 31, United States Code")
rule CollectibleExcludedPlatinum408m3(asset: Person) strict {
    label en official "(A)(iii)";
    when asset_exclusion_408m3(asset, PlatinumCoin5112k);
    then collectible_408m3_excluded(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "a coin issued under the laws of any State")
rule CollectibleExcludedStateCoin408m3(asset: Person) strict {
    label en official "(A)(iv)";
    when asset_exclusion_408m3(asset, StateIssuedCoin);
    then collectible_408m3_excluded(asset);
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "if such bullion is in the physical possession of a trustee described under subsection (a) of this section")
rule CollectibleExcludedBullion408m3(asset: Person) strict {
    label en official "(B): bullion of the required fineness in the trustee's physical possession";
    when asset_exclusion_408m3(asset, BullionInTrusteePossession);
    then collectible_408m3_excluded(asset);
}

pub relation treated_as_collectible_408m(asset: Person) kind institutional {
    label en official "section 408(m)(2)-(3): the property is a collectible unless an exclusion applies";
}

@source(IRC_S408_M, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"collectible\" shall not include")
rule TreatedAsCollectible408m(asset: Person) strict {
    label en official "a collectible kind without an exclusion";
    when collectible_408m2(asset)
        and not_known(collectible_408m3_excluded(asset));
    then treated_as_collectible_408m(asset);
}

// =====================================================================
// (q) Deemed IRAs
// =====================================================================

pub relation plan_elects_voluntary_contribution_account_408q1A(plan: Plan) kind empirical {
    label en unofficial "a qualified employer plan elects to allow employees to make voluntary employee contributions to a separate account or annuity established under the plan, case-asserted";
}

pub relation account_meets_ira_requirements_408q1B(plan: Plan) kind empirical {
    label en unofficial "under the plan's terms the account or annuity meets the applicable requirements of section 408 or 408A for an IRA, case-asserted";
}

pub relation program_established_408q1(plan: Plan) kind institutional {
    label en official "section 408(q)(1): a plan electing voluntary employee contribution accounts that meet the IRA requirements (a deemed IRA program)";
}

@source(IRC_S408_Q, relation = formalizes, coverage = exact, quote = "such account or annuity meets the applicable requirements of this section or section 408A for an individual retirement account or annuity")
rule ProgramEstablished408q1(plan: Plan) strict {
    label en official "both conditions";
    when plan_elects_voluntary_contribution_account_408q1A(plan)
        and account_meets_ira_requirements_408q1B(plan);
    then program_established_408q1(plan);
}

pub relation plan_not_failing_by_program_408q2(plan: Plan) kind institutional {
    label en official "section 408(q)(2): a qualified employer plan does not fail any requirement of the title solely by reason of establishing and maintaining the program";
}

@source(IRC_S408_Q, relation = formalizes, coverage = exact, quote = "a qualified employer plan shall not fail to meet any requirement of this title solely by reason of establishing and maintaining a program described in paragraph (1)")
rule PlanNotFailingByProgram408q2(plan: Plan) strict {
    label en official "the deemed IRA program";
    when program_established_408q1(plan);
    then plan_not_failing_by_program_408q2(plan);
}

pub enum QualifiedEmployerPlanKind408q3A {
    Section72p4Plan;
    Section457bPlanOfEligibleEmployer;
    Other;
}

pub relation employer_plan_kind_408q3A(plan: Plan, kind: QualifiedEmployerPlanKind408q3A) kind empirical {
    label en unofficial "the plan's kind: a qualified employer plan under section 72(p)(4)(A)(i) or an eligible section 457(b) plan of an eligible employer, case-asserted";
}

pub relation qualified_employer_plan_408q3A(plan: Plan) kind institutional {
    label en official "section 408(q)(3)(A): a qualified employer plan under section 72(p)(4)(A)(i), also including an eligible section 457(b) plan of an eligible employer";
}

@source(IRC_S408_Q, relation = formalizes, coverage = exact, quote = "except that such term shall also include an eligible deferred compensation plan (as defined in section 457(b)) of an eligible employer")
rule QualifiedEmployerPlan408q3A457b(plan: Plan) strict {
    label en official "457(b) plan";
    when employer_plan_kind_408q3A(plan, Section457bPlanOfEligibleEmployer);
    then qualified_employer_plan_408q3A(plan);
}

@source(IRC_S408_Q, relation = formalizes, coverage = exact, quote = "The term \"qualified employer plan\" has the meaning given such term by section 72(p)(4)(A)(i)")
rule QualifiedEmployerPlan408q3A72p(plan: Plan) strict {
    label en official "section 72(p)(4)(A)(i)";
    when employer_plan_kind_408q3A(plan, Section72p4Plan);
    then qualified_employer_plan_408q3A(plan);
}

pub relation contribution_facts_408q3B(contribution: Person, mandatory: Boolean, made_by_employee_under_plan: Boolean, designated_by_individual: Boolean) kind empirical {
    label en unofficial "whether the contribution is a mandatory contribution (section 411(c)(2)(C)), made by an individual as an employee under a qualified employer plan allowing such contributions, and designated by the individual as one to which the subsection applies, case-asserted";
}

pub relation voluntary_employee_contribution_408q3B(contribution: Person) kind institutional {
    label en official "section 408(q)(3)(B): a contribution other than a mandatory one, made as an employee under a plan that allows the election, and designated by the individual";
}

@source(IRC_S408_Q, relation = formalizes, coverage = exact, quote = "The term \"voluntary employee contribution\" means any contribution (other than a mandatory contribution within the meaning of section 411(c)(2)(C))")
rule VoluntaryEmployeeContribution408q3B(contribution: Person) strict {
    label en official "not mandatory, made under the plan, designated";
    when contribution_facts_408q3B(contribution, false, true, true);
    then voluntary_employee_contribution_408q3B(contribution);
}
