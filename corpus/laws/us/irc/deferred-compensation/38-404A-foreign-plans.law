// Section 404A — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): deductions for
// contributions to qualified foreign plans of an employer. The module derives
// the plan classification of (e) and (f), the timing and excess carryover of
// (b), the taking into account of items ((b)(5), (c)(3)), the reserve
// amortization of (c)(4), the cumulative deduction of (d)(1) and the
// disallowance of (g)(1).
//
// Method: exact Money arithmetic; the 90 percent test of (e)(2) is an exact
// integer cross-multiplication; the return due date rule is an exact date
// comparison. The reserve amortization is read as equal annual installments
// (INTERPRETATION: the statute says only "amortized over a 10-year period").

// ---------------------------------------------------------------------
// (e), (f) Qualified foreign plan
// ---------------------------------------------------------------------

use self::{
    CreditServiceKind415n,
    IRC_S404A_B,
    IRC_S404A_C,
    IRC_S404A_D,
    IRC_S404A_E,
    IRC_S404A_F,
    IRC_S404A_G,
    Plan,
    TaxableYear,
};

pub relation foreign_plan_written_for_deferral_404A(plan: Plan) kind empirical {
    label en unofficial "the plan is a written plan of an employer for deferring the receipt of compensation, case-asserted (section 404A(e))";
}

pub relation foreign_plan_exclusive_benefit_404A(plan: Plan) kind empirical {
    label en unofficial "the plan is for the exclusive benefit of the employer's employees or their beneficiaries, case-asserted ((e)(1))";
}

pub relation foreign_plan_amounts_by_source_404A(plan: Plan, y: TaxableYear, attributable_to_nonresident_aliens: Money, total: Money) kind empirical {
    label en unofficial "the amounts taken into account for the year attributable to services by nonresident aliens whose compensation is not subject to United States tax, and the total taken into account, case-asserted ((e)(2))";
}

pub relation foreign_plan_election_made_404A(plan: Plan) kind empirical {
    label en unofficial "the employer elects to have this section apply, case-asserted ((e)(3))";
}

pub relation qualified_foreign_plan_404Ae(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(e): a written deferral plan for the exclusive benefit of employees, 90 percent or more attributable to nonresident alien services not subject to United States tax, with the employer's election";
}

@source(IRC_S404A_E, relation = formalizes, coverage = exact, quote = "90 percent or more of the amounts taken into account for the taxable year under the plan are attributable to services")
rule QualifiedForeignPlan404Ae(plan: Plan, y: TaxableYear, alien: Money, total: Money) strict {
    label en official "exact boundary by cross-multiplication: alien x 100 >= total x 90; a zero total does not qualify";
    when foreign_plan_written_for_deferral_404A(plan)
        and foreign_plan_exclusive_benefit_404A(plan)
        and foreign_plan_amounts_by_source_404A(plan, y, alien, total)
        and total > 0.00 USD
        and alien * 100.0 >= total * 90.0
        and foreign_plan_election_made_404A(plan);
    then qualified_foreign_plan_404Ae(plan, y);
}

pub relation reserve_plan_election_in_effect_404A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer's election to treat the plan as a qualified reserve plan is in effect for the taxable year, case-asserted (section 404A(f)(2))";
}

pub relation qualified_reserve_plan_404Af2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(f)(2): a qualified foreign plan with the reserve election in effect";
}

@source(IRC_S404A_F, relation = formalizes, coverage = partial, quote = "The term \"qualified reserve plan\" means a qualified foreign plan with respect to which an election made by the taxpayer is in effect for the taxable year.")
rule QualifiedReservePlan404Af2(plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: the election's manner and revocation are the Secretary's";
    when qualified_foreign_plan_404Ae(plan, y) and reserve_plan_election_in_effect_404A(plan, y);
    then qualified_reserve_plan_404Af2(plan, y);
}

pub relation qualified_funded_plan_404Af1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(f)(1): a qualified foreign plan that is not a qualified reserve plan";
}

@source(IRC_S404A_F, relation = formalizes, coverage = exact, quote = "The term \"qualified funded plan\" means a qualified foreign plan which is not a qualified reserve plan.")
rule QualifiedFundedPlan404Af1(plan: Plan, y: TaxableYear) strict {
    label en official "the complement within qualified foreign plans";
    when qualified_foreign_plan_404Ae(plan, y) and not_known(qualified_reserve_plan_404Af2(plan, y));
    then qualified_funded_plan_404Af1(plan, y);
}

// ---------------------------------------------------------------------
// (b) Timing, carryover and contributions taken into account
// ---------------------------------------------------------------------

pub relation foreign_contribution_paid_on_404A(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date a contribution on account of the taxable year is paid, case-asserted (section 404A(b)(2))";
}

pub relation foreign_return_due_date_404A(y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the time prescribed by law for filing the return for the year, including extensions, case-asserted";
}

pub relation foreign_payment_treated_as_made_in_year_404Ab2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(b)(2): a payment after the close of the taxable year on account of the year and by the return due date is treated as made on the last day of that year";
}

@source(IRC_S404A_B, relation = formalizes, coverage = exact, quote = "not later than the time prescribed by law for filing the return for such year (including extensions thereof)")
rule ForeignPaymentTreatedAsMadeInYear404Ab2(plan: Plan, y: TaxableYear, paid: Date, due: Date) strict {
    label en official "exact boundary: the due date is in time";
    when foreign_contribution_paid_on_404A(plan, y, paid) and foreign_return_due_date_404A(y, due) and paid <= due;
    then foreign_payment_treated_as_made_in_year_404Ab2(plan, y);
}

pub relation foreign_contributions_paid_net_404Ab4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate contributions paid during the taxable year less those not allowable as a deduction under (g)(1) and (2), case-asserted ((b)(4)(A))";
}

pub relation foreign_deduction_allowable_404Ab4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount allowable as a deduction under subsection (a) without regard to subsection (d), case-asserted ((b)(4)(B))";
}

pub relation foreign_excess_treated_as_paid_next_year_404Ab4(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(b)(4): the excess of contributions over the allowable deduction is treated as paid in the succeeding taxable year";
}

@source(IRC_S404A_B, relation = formalizes, coverage = exact, quote = "such excess shall be treated as an amount paid in the succeeding taxable year")
rule ForeignExcessTreatedAsPaidNextYear404Ab4(plan: Plan, y: TaxableYear, paid: Money, allowable: Money) strict {
    label en official "paid - allowable when positive";
    when foreign_contributions_paid_net_404Ab4(plan, y, paid) and foreign_deduction_allowable_404Ab4(plan, y, allowable) and paid > allowable;
    then foreign_excess_treated_as_paid_next_year_404Ab4(plan, y, paid - allowable);
}

pub enum FundedPlanPayee404A {
    TrustMeeting401a2;
    RetirementAnnuity;
    ParticipantOrBeneficiary;
    OtherPayee;
}

pub relation foreign_contribution_payee_404A(plan: Plan, y: TaxableYear, payee: FundedPlanPayee404A) kind empirical {
    label en unofficial "to whom the contribution is paid, case-asserted (section 404A(b)(5))";
}

pub relation foreign_contribution_taken_into_account_404Ab5(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(b)(5): a contribution to a qualified funded plan is taken into account only if paid to a section 401(a)(2) trust, for a retirement annuity, or to a participant or beneficiary";
}

@source(IRC_S404A_B, relation = formalizes, coverage = exact, quote = "a contribution shall be taken into account only if it is paid")
rule ForeignContributionTakenIntoAccount404Ab5(plan: Plan, y: TaxableYear, payee: FundedPlanPayee404A) strict {
    label en official "the three permitted payees";
    when qualified_funded_plan_404Af1(plan, y) and foreign_contribution_payee_404A(plan, y, payee) and payee != OtherPayee;
    then foreign_contribution_taken_into_account_404Ab5(plan, y);
}

// ---------------------------------------------------------------------
// (c) Qualified reserve plans
// ---------------------------------------------------------------------

pub relation reserve_item_forfeiture_risk_404A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "there is a substantial risk that the employee's rights will be forfeited, case-asserted (section 404A(c)(3)(A))";
}

pub relation reserve_item_meets_regulatory_requirements_404A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the item meets the additional requirements the Secretary prescribes, case-asserted ((c)(3)(B))";
}

pub relation reserve_item_taken_into_account_404Ac3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(c)(3): an item is taken into account for a reserve plan only if there is no substantial risk of forfeiture and the regulatory requirements are met";
}

@source(IRC_S404A_C, relation = formalizes, coverage = partial, quote = "there is no substantial risk that the rights of the employee will be forfeited")
rule ReserveItemTakenIntoAccount404Ac3(plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: (A) and (B); the regulatory requirements are one asserted fact";
    when qualified_reserve_plan_404Af2(plan, y)
        and not_known(reserve_item_forfeiture_risk_404A(plan, y))
        and reserve_item_meets_regulatory_requirements_404A(plan, y);
    then reserve_item_taken_into_account_404Ac3(plan, y);
}

pub relation reserve_change_amount_404Ac4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an increase to the reserve on account of a plan amendment, experience, assumptions, interest rate or other factor, case-asserted (section 404A(c)(4))";
}

pub relation reserve_annual_amortization_404Ac4(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(c)(4): each reserve increase is amortized over 10 years (read as equal annual installments)";
}

@source(IRC_S404A_C, relation = formalizes, coverage = partial, quote = "There shall be amortized over a 10-year period any increase or decrease to the reserve on account of")
rule ReserveAnnualAmortization404Ac4(plan: Plan, y: TaxableYear, change: Money) strict {
    label en official "INTERPRETATION: equal annual installments, change / 10 (the statute and the Secretary's regulations may prescribe another schedule)";
    when reserve_change_amount_404Ac4(plan, y, change);
    then reserve_annual_amortization_404Ac4(plan, y, change * 0.1);
}

pub relation reserve_decrease_not_from_benefits_404Ac2(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the decrease for the year in the reserve not attributable to the payment of benefits, case-asserted (section 404A(c)(2))";
}

pub relation reserve_decrease_included_in_income_404Ac2(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(c)(2): the part of a reserve decrease not attributable to benefit payments is included in gross income";
}

@source(IRC_S404A_C, relation = formalizes, coverage = exact, quote = "an amount equal to that portion of any decrease for the taxable year in the reserve which is not attributable to the payment of benefits shall be included in gross income")
rule ReserveDecreaseIncluded404Ac2(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "the whole non-benefit decrease";
    when reserve_decrease_not_from_benefits_404Ac2(plan, y, amount);
    then reserve_decrease_included_in_income_404Ac2(plan, y, amount);
}

// ---------------------------------------------------------------------
// (d) Cumulative deduction; (g)(1) Disallowance
// ---------------------------------------------------------------------

pub relation cumulative_us_amount_404Ad(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the cumulative United States amount determined under this section for the year and all prior years, without regard to paragraph (1), case-asserted (section 404A(d)(2)(A))";
}

pub relation cumulative_foreign_amount_404Ad(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount allowed as a deduction under the appropriate foreign law, case-asserted ((d)(2)(B))";
}

pub relation prior_year_amounts_determined_404Ad(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount determined under this section for all prior taxable years, case-asserted ((d)(1)(B))";
}

pub relation foreign_plan_deduction_404Ad1(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404A(d)(1): the lesser of the cumulative United States and foreign amounts, reduced by the amounts of all prior years";
}

@source(IRC_S404A_D, relation = formalizes, coverage = exact, quote = "the amount allowed as a deduction under subsection (a) for any taxable year shall equal")
rule ForeignPlanDeduction404Ad1(plan: Plan, y: TaxableYear, us: Money, foreign: Money, prior: Money) strict {
    label en official "max(min(us, foreign) - prior, 0)";
    when cumulative_us_amount_404Ad(plan, y, us) and cumulative_foreign_amount_404Ad(plan, y, foreign) and prior_year_amounts_determined_404Ad(plan, y, prior);
    then foreign_plan_deduction_404Ad1(plan, y, max(min(us, foreign) - prior, 0.00 USD));
}

pub enum ServiceDisallowed404A {
    UsCitizenOrResidentHce;
    PerformedInUsSubjectToUsTax;
    OtherService;
}

pub relation item_attributable_to_service_404A(plan: Plan, y: TaxableYear, kind: ServiceDisallowed404A) kind empirical {
    label en unofficial "the services to which an item is attributable, case-asserted (section 404A(g)(1))";
}

pub relation item_not_deductible_404Ag1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(1): no deduction for an item attributable to services of a United States citizen or resident who is a highly compensated employee, or performed in the United States and subject to tax";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed under this section for any item to the extent such item is attributable to services")
rule ItemNotDeductible404Ag1(plan: Plan, y: TaxableYear, kind: ServiceDisallowed404A) strict {
    label en official "(A) or (B)";
    when item_attributable_to_service_404A(plan, y, kind) and kind != OtherService;
    then item_not_deductible_404Ag1(plan, y);
}
