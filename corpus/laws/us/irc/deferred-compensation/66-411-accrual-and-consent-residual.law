// Section 411 residuals — STAGE 3b (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): (a)(11)(B)-(D) consent rules, (a)(13) applicable defined benefit
// plans, (b)(1)(A) compensation basis and (D)-(H) further accrual rules,
// (b)(3) separate accounting, (b)(4) year of participation, (b)(5) age rules,
// (b)(6) projected crediting rate, (c)(2) contributions of the employee,
// (d)(5),(6) small rules, (f) normal retirement age.
//
// Pattern (as in modules 11/33): the statutory condition is decomposed into
// case-asserted facts and derived relations; percentages are Decimal
// fractions; arithmetic is exact. Regulations of the Secretary of Labor are
// case facts (external). The pre-amendment text of revised provisions is
// unpinned (G4601).

// =====================================================================
// (a)(11) consent rules
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    Distribution,
    IRC_S411_A,
    IRC_S411_B,
    IRC_S411_C,
    IRC_S411_F,
    Person,
    Plan,
    employee_years_of_service_411,
    nonforfeitable_accrued_benefit_present_value,
};

pub relation present_value_by_417e3_411a11B(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the present value of the nonforfeitable accrued benefit calculated in accordance with section 417(e)(3), case-asserted (the calculation itself is the 417(e)(3) rates of module 15)";
}

pub relation consent_test_present_value_411a11B(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(a)(11)(B): the present value used for the consent threshold is the section 417(e)(3) present value";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the present value shall be calculated in accordance with section 417(e)(3)")
rule ConsentTestPresentValue411a11B(employee: Person, plan: Plan, amount: Money) strict {
    label en official "the 417(e)(3) present value";
    when present_value_by_417e3_411a11B(employee, plan, amount);
    then consent_test_present_value_411a11B(employee, plan, amount);
}

pub relation distribution_of_404k_dividends_411a11C(d: Distribution) kind empirical {
    label en unofficial "the distribution is a distribution of dividends to which section 404(k) applies, case-asserted";
}

pub relation consent_paragraph_inapplicable_411a11C(d: Distribution) kind institutional {
    label en official "section 411(a)(11)(C): the paragraph does not apply to such a distribution";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to any distribution of dividends to which section 404(k) applies.")
rule ConsentParagraphInapplicable411a11C(d: Distribution) strict {
    label en official "ESOP dividend distributions";
    when distribution_of_404k_dividends_411a11C(d);
    then consent_paragraph_inapplicable_411a11C(d);
}

pub relation plan_disregards_rollover_portion_411a11D(plan: Plan) kind empirical {
    label en unofficial "under the terms of the plan the present value is determined without regard to the portion attributable to rollover contributions (and earnings), case-asserted";
}

pub relation rollover_portion_of_benefit_411a11D(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the portion of the nonforfeitable accrued benefit attributable to rollover contributions (sections 402(c), 403(a)(4), 403(b)(8), 408(d)(3)(A)(ii), 457(e)(16)) and earnings, case-asserted";
}

pub relation present_value_excluding_rollovers_411a11D(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(a)(11)(D): a plan does not fail the paragraph if the present value excludes the rollover portion";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the present value of the nonforfeitable accrued benefit is determined without regard to that portion of such benefit which is attributable to rollover contributions")
rule PresentValueExcludingRollovers411a11D(employee: Person, plan: Plan, total: Money, rollover: Money) strict {
    label en official "total present value minus the rollover portion (never below zero)";
    when plan_disregards_rollover_portion_411a11D(plan)
        and nonforfeitable_accrued_benefit_present_value(employee, plan, total)
        and rollover_portion_of_benefit_411a11D(employee, plan, rollover);
    then present_value_excluding_rollovers_411a11D(employee, plan, max(0 USD, total - rollover));
}

// =====================================================================
// (a)(13) Applicable defined benefit plans
// =====================================================================

pub relation accrued_benefit_is_hypothetical_account_balance_411a13Ci(plan: Plan) kind empirical {
    label en unofficial "the accrued benefit (or a portion) is calculated as the balance of a hypothetical account maintained for the participant, case-asserted";
}

pub relation accrued_benefit_is_percentage_of_final_average_pay_411a13Ci(plan: Plan) kind empirical {
    label en unofficial "the accrued benefit (or a portion) is calculated as an accumulated percentage of the participant's final average compensation, case-asserted";
}

pub relation applicable_defined_benefit_plan_by_definition_411a13C(plan: Plan) kind institutional {
    label en official "section 411(a)(13)(C)(i): a defined benefit plan whose accrued benefit is a hypothetical account balance or an accumulated percentage of final average compensation";
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "is calculated as the balance of a hypothetical account maintained for the participant")
rule ApplicableDefinedBenefitPlanHypotheticalAccount411a13C(plan: DefinedBenefitPlan) strict {
    label en official "PARTIAL: plans with a similar effect under the Secretary's regulations (clause (ii)) are not pinned";
    when accrued_benefit_is_hypothetical_account_balance_411a13Ci(plan);
    then applicable_defined_benefit_plan_by_definition_411a13C(plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "as an accumulated percentage of the participant's final average compensation")
rule ApplicableDefinedBenefitPlanAccumulatedPercentage411a13C(plan: DefinedBenefitPlan) strict {
    label en official "PARTIAL: as above";
    when accrued_benefit_is_percentage_of_final_average_pay_411a13Ci(plan);
    then applicable_defined_benefit_plan_by_definition_411a13C(plan);
}

pub relation employee_nonforfeitable_percentage_of_employer_accrued_411a13B(employee: Person, plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the employee's nonforfeitable percentage of the accrued benefit derived from employer contributions (1.00 = 100 percent), case-asserted";
}

pub relation applicable_plan_three_year_vesting_met_for_employee_411a13B(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(13)(B): an employee with at least 3 years of service has a nonforfeitable right to 100 percent of the accrued benefit from employer contributions";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "an employee who has completed at least 3 years of service has a nonforfeitable right to 100 percent of the employee's accrued benefit derived from employer contributions")
rule ApplicablePlanThreeYearVestingMet411a13B(employee: Person, plan: Plan, years: Integer, pct: Decimal) strict {
    label en official "exact boundary: 3 years and 100 percent";
    when employee_years_of_service_411(employee, plan, years)
        and years >= 3
        and employee_nonforfeitable_percentage_of_employer_accrued_411a13B(employee, plan, pct)
        and pct >= 1.00;
    then applicable_plan_three_year_vesting_met_for_employee_411a13B(employee, plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "an employee who has completed at least 3 years of service")
rule ApplicablePlanThreeYearVestingMetBelowThreshold411a13B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "an employee under 3 years is not caught by the clause (the vesting schedule of module 11 applies)";
    when employee_years_of_service_411(employee, plan, years)
        and years < 3;
    then applicable_plan_three_year_vesting_met_for_employee_411a13B(employee, plan);
}

pub relation plan_pv_equals_hypothetical_account_or_percentage_411a13A(plan: Plan) kind empirical {
    label en unofficial "under the terms of the plan the present value of the accrued benefit equals the hypothetical account balance or the accumulated percentage of final average compensation, case-asserted";
}

pub relation plan_meets_all_employees_three_year_vesting_411a13B(plan: Plan) kind empirical {
    label en unofficial "the plan meets the 3-year vesting requirement for every employee, case-asserted";
}

pub relation applicable_plan_not_failing_by_account_present_value_411a13A(plan: Plan, requirement: Integer) kind institutional {
    label en official "section 411(a)(13)(A): such an applicable plan does not fail (i) (a)(2) [requirement 2, subject to (B)] or (ii) (a)(11) or (c) or 417(e) [requirements 11, 3 and 417] solely because of that present value";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "(i) subject to subparagraph (B), the requirements of subsection (a)(2)")
rule ApplicablePlanNotFailingA2411a13A(plan: DefinedBenefitPlan) strict {
    label en official "clause (i): only if the 3-year vesting of (B) is met";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and plan_pv_equals_hypothetical_account_or_percentage_411a13A(plan)
        and plan_meets_all_employees_three_year_vesting_411a13B(plan);
    then applicable_plan_not_failing_by_account_present_value_411a13A(plan, 2);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the requirements of subsection (a)(11) or (c), or the requirements of section 417(e), with respect to accrued benefits derived from employer contributions")
rule ApplicablePlanNotFailingA11411a13A(plan: DefinedBenefitPlan, requirement: Integer) strict {
    label en official "clause (ii): requirements 11 (a)(11), 3 (subsection (c)) and 417 (section 417(e)); no (B) condition";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and plan_pv_equals_hypothetical_account_or_percentage_411a13A(plan)
        and applicable_plan_requirement_asked_411a13A(plan, requirement)
        and (requirement == 11 or requirement == 3 or requirement == 417);
    then applicable_plan_not_failing_by_account_present_value_411a13A(plan, requirement);
}

pub relation applicable_plan_requirement_asked_411a13A(plan: Plan, requirement: Integer) kind empirical {
    label en unofficial "the requirement asked about (2, 11, 3 for subsection (c), 417 for section 417(e)), case-asserted";
}

// =====================================================================
// (b)(1)(A) compensation basis and (D)-(H)
// =====================================================================

pub relation compensation_average_over_consecutive_years_411b1A(employee: Person, plan: DefinedBenefitPlan, years: Integer, average: Money) kind empirical {
    label en unofficial "the average rate of compensation over a period of consecutive years of service, case-asserted (one row per candidate period)";
}

pub relation compensation_basis_for_normal_retirement_benefit_411b1A(employee: Person, plan: DefinedBenefitPlan, basis: Money) kind institutional {
    label en official "section 411(b)(1)(A) last paragraph: compensation-based benefits are determined by the highest average over consecutive years of service not in excess of 10";
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "consecutive years of service, not in excess of 10, for which his compensation was the highest")
rule CompensationBasisForNormalRetirementBenefit411b1A(employee: Person, plan: DefinedBenefitPlan) strict {
    label en official "PARTIAL: the maximum over asserted candidate periods of at most 10 years";
    when compensation_average_over_consecutive_years_411b1A(employee, plan, _, _);
    then compensation_basis_for_normal_retirement_benefit_411b1A(employee, plan,
        max all avg: Money for n: Integer
            where compensation_average_over_consecutive_years_411b1A(employee, plan, n, avg) and n <= 10);
}

pub relation accrued_benefit_before_1974_411b1D(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the participant's accrued benefit for years of participation before the first plan year to which section 411 applies, determined under the plan as in effect before September 2, 1974, case-asserted";
}

pub relation accrued_benefit_if_abc_applied_pre_effective_years_411b1D(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the accrued benefit the participant would have had for those years if subparagraph (A), (B) or (C) applied, case-asserted";
}

pub relation accrued_benefit_for_pre_effective_years_411b1D(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the participant's actual accrued benefit for those years, case-asserted";
}

pub relation pre_effective_accrual_requirement_met_411b1D(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(D): the accrued benefit for those years is not less than the greater of the pre-September 2, 1974 benefit and one-half of the benefit that (A), (B) or (C) would give";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "an accrued benefit which is not less than one-half of the accrued benefit to which such participant would have been entitled if subparagraph (A), (B), or (C) applied with respect to such years of participation")
rule PreEffectiveAccrualRequirementMet411b1D(employee: Person, plan: DefinedBenefitPlan, old: Money, abc: Money, actual: Money) strict {
    label en official "exact boundary: actual >= max(old, half of the (A)-(C) benefit, HALF_UP to the cent)";
    when accrued_benefit_before_1974_411b1D(employee, plan, old)
        and accrued_benefit_if_abc_applied_pre_effective_years_411b1D(employee, plan, abc)
        and accrued_benefit_for_pre_effective_years_411b1D(employee, plan, actual)
        and actual >= max(old, round(abc * 0.50, 2, "HALF_UP"));
    then pre_effective_accrual_requirement_met_411b1D(employee, plan);
}

pub relation continuous_years_of_service_410a3A_411b1E(employee: Person, plan: DefinedBenefitPlan, years: Integer) kind empirical {
    label en unofficial "the employee's continuous years of service (section 410(a)(3)(A)) before benefit accrual becomes effective under the plan, case-asserted";
}

pub relation accrual_deferral_permitted_411b1E(employee: Person, plan: DefinedBenefitPlan, years: Integer) kind institutional {
    label en official "section 411(b)(1)(E): a plan may defer benefit accrual until the employee has two continuous years of service";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "does not become effective until the employee has two continuous years of service")
rule AccrualDeferralPermitted411b1E(employee: Person, plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "exact boundary: a deferral of up to 2 years is allowed; 3 is not";
    when continuous_years_of_service_410a3A_411b1E(employee, plan, years)
        and years <= 2;
    then accrual_deferral_permitted_411b1E(employee, plan, years);
}

pub relation plan_funded_exclusively_by_insurance_411b1F(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is funded exclusively by the purchase of insurance contracts, case-asserted";
}

pub relation plan_meets_412e3_B_and_C_411b1F(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan satisfies subparagraphs (B) and (C) of section 412(e)(3), case-asserted";
}

pub relation accrued_benefit_411b1F(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the employee's accrued benefit as of the applicable date, case-asserted";
}

pub relation cash_surrender_value_411b1F(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the cash surrender value the employee's insurance contracts would have on the date if the requirements of section 412(e)(3)(D), (E), (F) were satisfied, case-asserted";
}

pub relation insured_plan_accrual_requirement_met_411b1F(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(F): an insured plan satisfies the paragraph if the accrued benefit is not less than the cash surrender value";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "but only if an employee's accrued benefit as of any applicable date is not less than the cash surrender value his insurance contracts would have on such applicable date")
rule InsuredPlanAccrualRequirementMet411b1F(employee: Person, plan: DefinedBenefitPlan, accrued: Money, csv: Money) strict {
    label en official "exact boundary: equal is enough";
    when plan_funded_exclusively_by_insurance_411b1F(plan)
        and plan_meets_412e3_B_and_C_411b1F(plan)
        and accrued_benefit_411b1F(employee, plan, accrued)
        and cash_surrender_value_411b1F(employee, plan, csv)
        and accrued >= csv;
    then insured_plan_accrual_requirement_met_411b1F(employee, plan);
}

pub relation accrued_benefit_reduced_by_age_or_service_411b1G(employee: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the participant's accrued benefit is reduced on account of an increase in age or service, case-asserted";
}

pub relation benefit_bridge_to_social_security_411b1G(employee: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the reduced benefits commence before entitlement to social security benefits, do not exceed them, and terminate when they commence (both conditions (i) and (ii)), case-asserted";
}

pub relation accrued_benefit_reduction_prohibited_411b1G(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(G): a plan fails the paragraph if the accrued benefit is reduced on account of an increase in age or service, except for social security bridge benefits";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "a defined benefit plan shall be treated as not satisfying the requirements of this paragraph if the participant's accrued benefit is reduced on account of any increase in his age or service")
rule AccruedBenefitReductionProhibited411b1G(employee: Person, plan: DefinedBenefitPlan) strict {
    label en official "reduction without the bridge exception";
    when accrued_benefit_reduced_by_age_or_service_411b1G(employee, plan)
        and not_known(benefit_bridge_to_social_security_411b1G(employee, plan));
    then accrued_benefit_reduction_prohibited_411b1G(employee, plan);
}

pub relation accrual_ceased_or_reduced_because_of_age_411b1Hi(employee: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employee's benefit accrual is ceased, or its rate reduced, because of the attainment of any age, case-asserted";
}

pub relation limit_on_amount_or_years_without_regard_to_age_411b1Hii(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the cessation results from a limitation (imposed without regard to age) on the amount of benefits or on the years of service or participation taken into account, case-asserted";
}

pub relation early_retirement_subsidy_disregarded_only_411b1Hiv(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the reduction consists solely of disregarding the subsidized portion of an early retirement benefit in determining accruals, case-asserted";
}

pub relation continued_accrual_beyond_nra_requirement_violated_411b1H(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(H)(i): a plan fails the paragraph if accrual ceases or is reduced because of attained age (with the limitation and subsidy exceptions)";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "an employee's benefit accrual is ceased, or the rate of an employee's benefit accrual is reduced, because of the attainment of any age")
rule ContinuedAccrualBeyondNraViolated411b1H(employee: Person, plan: DefinedBenefitPlan) strict {
    label en official "age-based cessation or reduction, without either exception";
    when accrual_ceased_or_reduced_because_of_age_411b1Hi(employee, plan)
        and not_known(limit_on_amount_or_years_without_regard_to_age_411b1Hii(plan))
        and not_known(early_retirement_subsidy_disregarded_only_411b1Hiv(plan))
        and not_known(delayed_retirement_adjustment_satisfies_411b1Hiii(employee, plan));
    then continued_accrual_beyond_nra_requirement_violated_411b1H(employee, plan);
}

pub relation delayed_retirement_adjustment_satisfies_411b1Hiii(employee: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employee has attained normal retirement age and either distribution has commenced (accrual satisfied to the extent of the actuarial equivalent of in-service distribution) or distribution has not commenced and the benefit is adjusted for the delay, case-asserted (in accordance with the Secretary's regulations)";
}

// =====================================================================
// (b)(3), (b)(4), (b)(6)
// =====================================================================

pub relation separate_accounting_for_voluntary_contributions_411b3A(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the defined benefit plan requires separate accounting for the portion of each employee's accrued benefit derived from voluntary employee contributions, case-asserted";
}

pub relation separate_accounting_for_each_employee_411b3B(plan: Plan) kind empirical {
    label en unofficial "the plan (not a defined benefit plan) requires separate accounting for each employee's accrued benefit, case-asserted";
}

pub relation separate_accounting_requirement_met_411b3(plan: Plan) kind institutional {
    label en official "section 411(b)(3): separate accounting of accrued benefits";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "the plan requires separate accounting for the portion of each employee's accrued benefit derived from any voluntary employee contributions permitted under the plan")
rule SeparateAccountingRequirementMetDb411b3A(plan: DefinedBenefitPlan) strict {
    label en official "clause (A)";
    when separate_accounting_for_voluntary_contributions_411b3A(plan);
    then separate_accounting_requirement_met_411b3(plan);
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "the plan requires separate accounting for each employee's accrued benefit")
rule SeparateAccountingRequirementMetOther411b3B(plan: DefinedContributionPlan) strict {
    label en official "clause (B)";
    when separate_accounting_for_each_employee_411b3B(plan);
    then separate_accounting_requirement_met_411b3(plan);
}

pub relation year_of_participation_hours_411b4(employee: Person, plan: Plan, hours: Integer) kind empirical {
    label en unofficial "the employee's hours of service in the 12-consecutive-month period, case-asserted";
}

pub relation customary_employment_less_than_full_time_411b4B(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee's customary employment is less than full time, case-asserted";
}

pub relation service_calculation_ratable_portion_411b4B(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the calculation of the employee's service provides at least a ratable portion of the accrued benefit of a full-time employee, case-asserted";
}

pub relation service_calculation_reasonable_and_consistent_411b4B(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(b)(4)(B): for a less-than-full-time employee a basis giving less than a ratable portion is not reasonable and consistent (a ratable basis is not thereby made reasonable: the fact is not exclusive)";
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "the calculation of such employee's service on any basis which provides less than a ratable portion of the accrued benefit to which he would be entitled under the plan if his customary employment were full time shall not be treated as made on a reasonable and consistent basis")
rule ServiceCalculationReasonableAndConsistent411b4B(employee: Person, plan: Plan) strict {
    label en official "PARTIAL: only the ratable-portion floor; the general reasonable and consistent basis remains a regulation matter";
    when customary_employment_less_than_full_time_411b4B(employee, plan)
        and service_calculation_ratable_portion_411b4B(employee, plan);
    then service_calculation_reasonable_and_consistent_411b4B(employee, plan);
}

pub relation service_below_1000_hours_disregard_permitted_411b4C(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(b)(4)(C): under 1,000 hours in the 12-month period, disregarding that service is not, solely for that reason, an unreasonable or inconsistent basis";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "whose service is less than 1,000 hours during any calendar year, plan year or other 12-consecutive month period")
rule ServiceBelow1000HoursDisregardPermitted411b4C(employee: Person, plan: Plan, hours: Integer) strict {
    label en official "exact boundary: 999 hours below, 1,000 hours not";
    when year_of_participation_hours_411b4(employee, plan, hours)
        and hours < 1000;
    then service_below_1000_hours_disregard_permitted_411b4C(employee, plan);
}

pub relation maritime_days_in_year_411b4E(employee: Person, plan: Plan, days: Integer) kind empirical {
    label en unofficial "the employee's days of service in a maritime industry, case-asserted";
}

pub relation maritime_year_of_participation_411b4E(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(b)(4)(E): 125 days of service in a maritime industry are a year of participation";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "in the case of any maritime industry, 125 days of service shall be treated as a year of participation")
rule MaritimeYearOfParticipation411b4E(employee: Person, plan: Plan, days: Integer) strict {
    label en official "exact boundary: 125 days qualify, 124 do not";
    when maritime_days_in_year_411b4E(employee, plan, days)
        and days >= 125;
    then maritime_year_of_participation_411b4E(employee, plan);
}

pub relation seasonal_industry_customary_period_under_1000_hours_411b4D(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the industry is seasonal and the customary period of employment is under 1,000 hours a year, case-asserted";
}

pub relation seasonal_year_of_participation_by_labor_regulation_411b4D(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(b)(4)(D): in a seasonal industry the year of participation is the period determined under the Secretary of Labor's regulations (an external determination)";
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "the term \"year of participation\" shall be such period as determined under regulations prescribed by the Secretary of Labor")
rule SeasonalYearOfParticipationByLaborRegulation411b4D(employee: Person, plan: Plan) strict {
    label en official "PARTIAL: the regulations are not pinned";
    when seasonal_industry_customary_period_under_1000_hours_411b4D(employee, plan);
    then seasonal_year_of_participation_by_labor_regulation_411b4D(employee, plan);
}

pub relation variable_crediting_rate_projection_411b6(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the reasonable projection of the variable interest crediting rate (0.05 = 5 percent), case-asserted";
}

pub relation projected_interest_crediting_rate_411b6(plan: DefinedBenefitPlan, rate: Decimal) kind institutional {
    label en official "section 411(b)(6): the projected interest crediting rate is a reasonable projection not to exceed 6 percent";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "shall be a reasonable projection of such variable interest crediting rate, not to exceed 6 percent")
rule ProjectedInterestCreditingRate411b6(plan: DefinedBenefitPlan, rate: Decimal) strict {
    label en official "the projection, capped at 6 percent";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and variable_crediting_rate_projection_411b6(plan, rate);
    then projected_interest_crediting_rate_411b6(plan, min(rate, 0.06));
}

// =====================================================================
// (b)(5) Special rules relating to age
// =====================================================================

pub relation accrued_benefit_of_participant_411b5A(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the participant's accrued benefit as of the date, determined under the terms of the plan without the subsidized portion of early retirement benefits, case-asserted";
}

pub relation accrued_benefit_of_similarly_situated_younger_411b5A(employee: Person, plan: DefinedBenefitPlan, other: Person, amount: Money) kind empirical {
    label en unofficial "the accrued benefit of a similarly situated younger individual (identical in every respect except age) who is or could be a participant, case-asserted";
}

pub relation similarly_situated_younger_individual_411b5Aii(employee: Person, other: Person) kind empirical {
    label en unofficial "the other individual is identical to the participant in every respect except age and is younger, case-asserted";
}

pub relation accrual_not_age_discriminatory_by_comparison_411b5A(employee: Person, plan: DefinedBenefitPlan, other: Person) kind institutional {
    label en official "section 411(b)(5)(A)(i): the plan is not treated as failing (1)(H)(i) if the participant's accrued benefit is at least that of a similarly situated younger individual";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "would be equal to or greater than that of any similarly situated, younger individual who is or could be a participant")
rule AccrualNotAgeDiscriminatoryByComparison411b5A(employee: Person, plan: DefinedBenefitPlan, other: Person, mine: Money, theirs: Money) strict {
    label en official "exact boundary: equal is enough";
    when similarly_situated_younger_individual_411b5Aii(employee, other)
        and accrued_benefit_of_participant_411b5A(employee, plan, mine)
        and accrued_benefit_of_similarly_situated_younger_411b5A(employee, plan, other, theirs)
        and mine >= theirs;
    then accrual_not_age_discriminatory_by_comparison_411b5A(employee, plan, other);
}

pub relation interest_credit_rate_411b5Bi(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the interest credit rate provided by the plan terms for the plan year (0.04 = 4 percent), case-asserted";
}

pub relation market_rate_of_return_411b5Bi(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the market rate of return against which the credit is measured, case-asserted (the Secretary's regulations on the calculation are external)";
}

pub relation plan_provides_reasonable_minimum_guarantee_or_greater_of_411b5Bi1(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides a reasonable minimum guaranteed rate of return or the greater of a fixed or variable rate of return, case-asserted";
}

pub relation interest_credit_requirement_met_411b5Bi1(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(B)(i)(I): the interest credit is not greater than a market rate of return (a reasonable minimum guarantee or greater-of design is not a failure)";
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "any interest credit (or an equivalent amount) for any plan year shall be at a rate which is not greater than a market rate of return")
rule InterestCreditRequirementMet411b5Bi1(plan: DefinedBenefitPlan, credit: Decimal, market: Decimal) strict {
    label en official "PARTIAL: strict comparison for a single-rate plan (equal to the market rate is allowed)";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and interest_credit_rate_411b5Bi(plan, credit)
        and market_rate_of_return_411b5Bi(plan, market)
        and credit <= market;
    then interest_credit_requirement_met_411b5Bi1(plan);
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "A plan shall not be treated as failing to meet the requirements of this subclause merely because the plan provides for a reasonable minimum guaranteed rate of return or for a rate of return that is equal to the greater of a fixed or variable rate of return")
rule InterestCreditRequirementMetGuaranteedDesign411b5Bi1(plan: DefinedBenefitPlan) strict {
    label en official "PARTIAL: the minimum-guarantee or greater-of design does not itself fail the subclause";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and plan_provides_reasonable_minimum_guarantee_or_greater_of_411b5Bi1(plan);
    then interest_credit_requirement_met_411b5Bi1(plan);
}

pub relation plan_terms_preserve_capital_411b5Bi2(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides that an interest credit of less than zero shall not reduce the account balance below the aggregate contributions credited, case-asserted";
}

pub relation preservation_of_capital_requirement_met_411b5Bi2(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(B)(i)(II): preservation of capital";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "an interest credit (or equivalent amount) of less than zero shall in no event result in the account balance or similar amount being less than the aggregate amount of contributions credited to the account")
rule PreservationOfCapitalRequirementMet411b5Bi2(plan: DefinedBenefitPlan) strict {
    label en official "applicable plan with the capital preservation term";
    when applicable_defined_benefit_plan_by_definition_411a13C(plan)
        and plan_terms_preserve_capital_411b5Bi2(plan);
    then preservation_of_capital_requirement_met_411b5Bi2(plan);
}

pub relation accrued_benefit_after_conversion_amendment_411b5Biii(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the participant's accrued benefit under the plan as in effect after the conversion amendment, case-asserted";
}

pub relation accrued_benefit_for_years_before_amendment_411b5Biii1(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the accrued benefit for years of service before the effective date, determined under the plan as in effect before the amendment (plus the subsidy credit of clause (iv) where applicable), case-asserted";
}

pub relation accrued_benefit_for_years_after_amendment_411b5Biii2(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the accrued benefit for years of service after the effective date, determined under the plan as in effect after the amendment, case-asserted";
}

pub relation conversion_rate_of_accrual_requirement_met_411b5Biii(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(B)(iii): the post-amendment accrued benefit is not less than the sum of the pre-amendment accrued benefit and the post-amendment accrual";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "the accrued benefit of the participant under the terms of the plan as in effect after the amendment is not less than the sum of")
rule ConversionRateOfAccrualRequirementMet411b5Biii(employee: Person, plan: DefinedBenefitPlan, after: Money, before: Money, post: Money) strict {
    label en official "exact boundary: equal is enough";
    when accrued_benefit_after_conversion_amendment_411b5Biii(employee, plan, after)
        and accrued_benefit_for_years_before_amendment_411b5Biii1(employee, plan, before)
        and accrued_benefit_for_years_after_amendment_411b5Biii2(employee, plan, post)
        and after >= before + post;
    then conversion_rate_of_accrual_requirement_met_411b5Biii(employee, plan);
}

pub relation conversion_amendment_adopted_on_411b5Bii(plan: DefinedBenefitPlan, adopted: Date) kind empirical {
    label en unofficial "the date an applicable plan amendment (one converting the plan into an applicable defined benefit plan, including a coordination of benefits treated as an amendment) was adopted, case-asserted";
}

pub relation conversion_amendment_subject_to_clause_iii_411b5Bii(plan: DefinedBenefitPlan, adopted: Date) kind institutional {
    label en official "section 411(b)(5)(B)(ii): an applicable plan amendment adopted after June 29, 2005 must meet clause (iii) for each participant";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "If, after June 29, 2005, an applicable plan amendment is adopted")
rule ConversionAmendmentSubjectToClauseIii411b5Bii(plan: DefinedBenefitPlan, adopted: Date) strict {
    label en official "exact boundary: adopted after June 29, 2005 (June 29, 2005 itself is outside)";
    when conversion_amendment_adopted_on_411b5Bii(plan, adopted)
        and adopted > @2005-06-29;
    then conversion_amendment_subject_to_clause_iii_411b5Bii(plan, adopted);
}

pub relation interest_rate_variable_411b5Bvi(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the interest credit rate under the plan is a variable rate, case-asserted";
}

pub relation average_rates_used_in_5_years_ending_termination_411b5Bvi(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the average of the rates of interest used under the plan during the 5-year period ending on the termination date, case-asserted";
}

pub relation rate_used_at_termination_411b5Bvi1(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the rate of interest the plan uses to determine accrued benefits upon termination, case-asserted";
}

pub relation termination_interest_rate_requirement_met_411b5Bvi1(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(B)(vi)(I): on termination a variable rate is the 5-year average of the rates used";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "the rate of interest used to determine accrued benefits under the plan shall be equal to the average of the rates of interest used under the plan during the 5-year period ending on the termination date")
rule TerminationInterestRateRequirementMet411b5Bvi1(plan: DefinedBenefitPlan, used: Decimal, average: Decimal) strict {
    label en official "exact equality of the rate used and the 5-year average";
    when interest_rate_variable_411b5Bvi(plan)
        and rate_used_at_termination_411b5Bvi1(plan, used)
        and average_rates_used_in_5_years_ending_termination_411b5Bvi(plan, average)
        and used == average;
    then termination_interest_rate_requirement_met_411b5Bvi1(plan);
}

pub relation offset_allowable_under_401a_411b5C(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides offsets against benefits to the extent otherwise allowable in applying section 401(a), case-asserted";
}

pub relation offsets_do_not_fail_1H_411b5C(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(C): allowable offsets do not fail (1)(H)(i)";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "solely because the plan provides offsets against benefits under the plan to the extent such offsets are otherwise allowable in applying the requirements of section 401(a)")
rule OffsetsDoNotFail1H411b5C(plan: DefinedBenefitPlan) strict {
    label en official "allowable offsets";
    when offset_allowable_under_401a_411b5C(plan);
    then offsets_do_not_fail_1H_411b5C(plan);
}

pub relation disparity_meets_401l_411b5D(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides a disparity in contributions or benefits with respect to which the requirements of section 401(l) are met, case-asserted";
}

pub relation disparity_does_not_fail_1H_411b5D(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(D): a permitted disparity does not fail (1)(H)";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "solely because the plan provides a disparity in contributions or benefits with respect to which the requirements of section 401(l) are met")
rule DisparityDoesNotFail1H411b5D(plan: DefinedBenefitPlan) strict {
    label en official "401(l) disparity";
    when disparity_meets_401l_411b5D(plan);
    then disparity_does_not_fail_1H_411b5D(plan);
}

pub relation plan_provides_indexing_411b5E(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides for indexing of accrued benefits (periodic adjustment by a recognized investment index or methodology), case-asserted";
}

pub relation indexing_result_below_unindexed_benefit_411b5Eii(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the indexing results in an accrued benefit less than the benefit determined without indexing, case-asserted";
}

pub relation benefit_is_variable_annuity_411b5Eii(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the benefit is provided in the form of a variable annuity, case-asserted";
}

pub relation indexing_does_not_fail_1H_411b5E(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(5)(E): indexing does not fail (1)(H), except indexing that results in a benefit below the unindexed benefit (unless a variable annuity)";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "solely because the plan provides for indexing of accrued benefits under the plan")
rule IndexingDoesNotFail1H411b5E(plan: DefinedBenefitPlan) strict {
    label en official "indexing without a loss below the unindexed benefit, or a variable annuity";
    when plan_provides_indexing_411b5E(plan)
        and not_known(indexing_result_below_unindexed_benefit_411b5Eii(plan));
    then indexing_does_not_fail_1H_411b5E(plan);
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "Except in the case of any benefit provided in the form of a variable annuity")
rule IndexingVariableAnnuityDoesNotFail1H411b5E(plan: DefinedBenefitPlan) strict {
    label en official "variable annuity exception";
    when plan_provides_indexing_411b5E(plan)
        and benefit_is_variable_annuity_411b5Eii(plan);
    then indexing_does_not_fail_1H_411b5E(plan);
}

// =====================================================================
// (c)(2) Accrued benefit derived from employee contributions
// =====================================================================

pub relation mandatory_contributions_411c2C(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "all mandatory contributions made by the employee (required as a condition of employment, participation or obtaining benefits from employer contributions), case-asserted";
}

pub relation interest_to_end_of_last_pre_effective_year_411c2Cii(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "interest under the plan to the end of the last plan year to which subsection (a)(2) does not apply, case-asserted";
}

pub relation interest_at_120_percent_of_mid_term_rate_411c2Ciii1(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "interest on the sum of clauses (i) and (ii) compounded annually at 120 percent of the Federal mid-term rate, case-asserted (the rates are the section 1274 table)";
}

pub relation interest_at_417e3_rate_to_nra_411c2Ciii2(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "interest at the plan's 417(e)(3) rate from the determination date to normal retirement age, case-asserted";
}

pub relation accumulated_contributions_411c2C(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(c)(2)(C): accumulated contributions are mandatory contributions plus the two interest components";
}

@source(IRC_S411_C, relation = formalizes, coverage = partial, quote = "the term \"accumulated contribution\" means the total of")
rule AccumulatedContributions411c2C(employee: Person, plan: Plan, c1: Money, c2: Money, c3: Money, c4: Money) strict {
    label en official "PARTIAL: the sum of the four case-asserted components (the compounding and the rate tables are external)";
    when mandatory_contributions_411c2C(employee, plan, c1)
        and interest_to_end_of_last_pre_effective_year_411c2Cii(employee, plan, c2)
        and interest_at_120_percent_of_mid_term_rate_411c2Ciii1(employee, plan, c3)
        and interest_at_417e3_rate_to_nra_411c2Ciii2(employee, plan, c4);
    then accumulated_contributions_411c2C(employee, plan, c1 + c2 + c3 + c4);
}

pub relation accumulated_contributions_as_annual_benefit_411c2B(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the employee's accumulated contributions expressed as an annual benefit commencing at normal retirement age using the plan's 417(e)(3) rate as of the determination date, case-asserted";
}

pub relation employee_contribution_accrued_benefit_db_411c2B(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind institutional {
    label en official "section 411(c)(2)(B): in a defined benefit plan the accrued benefit derived from employee contributions is the accumulated contributions expressed as an annual benefit";
}

@source(IRC_S411_C, relation = formalizes, coverage = exact, quote = "the accrued benefit derived from contributions made by an employee as of any applicable date is the amount equal to the employee's accumulated contributions expressed as an annual benefit commencing at normal retirement age")
rule EmployeeContributionAccruedBenefitDb411c2B(employee: Person, plan: DefinedBenefitPlan, amount: Money) strict {
    label en official "the annual benefit conversion is case-asserted";
    when accumulated_contributions_as_annual_benefit_411c2B(employee, plan, amount);
    then employee_contribution_accrued_benefit_db_411c2B(employee, plan, amount);
}

pub relation separate_account_employee_contributions_balance_411c2Ai(employee: Person, plan: DefinedContributionPlan, amount: Money) kind empirical {
    label en unofficial "the balance of the separate account consisting only of the employee's contributions and the income, expenses, gains and losses attributable, case-asserted";
}

pub relation employee_contribution_accrued_benefit_dc_411c2Ai(employee: Person, plan: DefinedContributionPlan, amount: Money) kind institutional {
    label en official "section 411(c)(2)(A)(i): the separate account balance of the employee's own contributions";
}

@source(IRC_S411_C, relation = formalizes, coverage = exact, quote = "the balance of the employee's separate account consisting only of his contributions and the income, expenses, gains, and losses attributable thereto")
rule EmployeeContributionAccruedBenefitDc411c2Ai(employee: Person, plan: DefinedContributionPlan, amount: Money) strict {
    label en official "the separate account balance";
    when separate_account_employee_contributions_balance_411c2Ai(employee, plan, amount);
    then employee_contribution_accrued_benefit_dc_411c2Ai(employee, plan, amount);
}

// =====================================================================
// (f) Normal retirement age at 30 years of benefit accrual service
// =====================================================================

pub relation plan_normal_retirement_age_as_of_2014_411f2A(plan: DefinedBenefitPlan, years_of_service: Integer) kind empirical {
    label en unofficial "on or before December 8, 2014 the plan provided a normal retirement age that is the earlier of a permitted age and the age at which the participant completes this number of years of benefit accrual service, case-asserted";
}

pub relation applicable_plan_411f2A(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(f)(2)(A): an applicable plan has (as of December 8, 2014) a normal retirement age at the completion of at least 30 years of benefit accrual service";
}

@source(IRC_S411_F, relation = formalizes, coverage = exact, quote = "the age at which a participant completes the number of years (not less than 30 years) of benefit accrual service specified by the plan")
rule ApplicablePlan411f2A(plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "exact boundary: 30 years qualifies, 29 does not";
    when plan_normal_retirement_age_as_of_2014_411f2A(plan, years)
        and years >= 30;
    then applicable_plan_411f2A(plan);
}

pub relation individual_participant_on_or_before_2017_01_01_411f2C(plan: DefinedBenefitPlan, individual: Person, on: Date) kind empirical {
    label en unofficial "the individual became a participant on this date (or was an employee of an employer maintaining the plan on or before January 1, 2017 and later became a participant), case-asserted";
}

pub relation individual_covered_by_applicable_plan_411f2C(plan: DefinedBenefitPlan, individual: Person) kind institutional {
    label en official "section 411(f)(2)(C): a plan is an applicable plan only for an individual who is a participant on or before January 1, 2017 (or an employee on or before that date who later becomes a participant)";
}

@source(IRC_S411_F, relation = formalizes, coverage = exact, quote = "is a participant in the plan on or before January 1, 2017")
rule IndividualCoveredByApplicablePlan411f2C(plan: DefinedBenefitPlan, individual: Person, on: Date) strict {
    label en official "exact boundary: January 1, 2017 itself is inside";
    when applicable_plan_411f2A(plan)
        and individual_participant_on_or_before_2017_01_01_411f2C(plan, individual, on)
        and on <= @2017-01-01;
    then individual_covered_by_applicable_plan_411f2C(plan, individual);
}

pub relation applicable_plan_uniform_nra_exception_411f1(plan: DefinedBenefitPlan, individual: Person) kind institutional {
    label en official "section 411(f)(1): despite subsection (a)(8), an applicable plan is not treated as failing a requirement of the subchapter or as failing to have a uniform normal retirement age solely because of the earlier normal retirement age";
}

@source(IRC_S411_F, relation = formalizes, coverage = exact, quote = "Notwithstanding subsection (a)(8), an applicable plan shall not be treated as failing to meet any requirement of this subchapter")
rule ApplicablePlanUniformNraException411f1(plan: DefinedBenefitPlan, individual: Person) strict {
    label en official "applicable plan for the individual";
    when individual_covered_by_applicable_plan_411f2C(plan, individual);
    then applicable_plan_uniform_nra_exception_411f1(plan, individual);
}
