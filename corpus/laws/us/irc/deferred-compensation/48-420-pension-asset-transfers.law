// Section 420 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): transfers of
// excess pension assets of a defined benefit plan to a retiree health or
// life insurance account. The module derives the excess pension assets
// (with the reduced 110 percent threshold of (e)(7)), the conditions of a
// qualified transfer ((b): one transfer a year, the amount ceiling, the sunset
// date, the vesting and minimum cost requirements), the consequences of (a),
// the disallowance of deductions in (d) with the prohibition on contributing
// for the same liabilities, and the transfer period of (f)(5).
//
// Method: percentages are exact Decimal factors on Money; the reduced
// threshold and the 1.75 percent test are exact comparisons. The hypothetical
// deduction that defines the qualified current retiree liabilities is not
// derived: the case supplies it. Qualified future and collectively bargained
// transfers under (f) beyond the transfer period are not modelled.

// =====================================================================
// (e)(2) and (e)(7) Excess pension assets
// =====================================================================

use self::{
    IRC_S420_A,
    IRC_S420_B,
    IRC_S420_C,
    IRC_S420_D,
    IRC_S420_E,
    IRC_S420_F,
    Person,
    Plan,
    TaxableYear,
};

pub relation plan_assets_fair_market_less_balances_420e2A_i(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the plan's assets reduced by the prefunding balance and funding standard carryover balance, case-asserted (section 420(e)(2)(A)(i))";
}

pub relation plan_assets_value_430g3_less_430f_420e2A_ii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of plan assets under section 430(g)(3) after reduction under section 430(f), case-asserted (section 420(e)(2)(A)(ii))";
}

pub relation funding_target_and_normal_cost_420e2B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the funding target and the target normal cost determined under section 430 for the plan year, case-asserted";
}

pub relation excess_assets_lesser_amount_420e2A(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(e)(2)(A): the lesser of the two asset values";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "the fair market value of the plan's assets (reduced by the prefunding balance and funding standard carryover balance determined under section 430(f))")
rule ExcessAssetsLesserAmount420e2A(plan: Plan, y: TaxableYear, fmv: Money, actuarial: Money) strict {
    label en official "min(fair market value less balances, section 430(g)(3) value less the section 430(f) reduction)";
    when plan_assets_fair_market_less_balances_420e2A_i(plan, y, fmv) and plan_assets_value_430g3_less_430f_420e2A_ii(plan, y, actuarial);
    then excess_assets_lesser_amount_420e2A(plan, y, min(fmv, actuarial));
}

pub relation proposed_transfer_amount_420(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the proposed transfer, case-asserted";
}

pub relation assets_exceeded_110_percent_in_both_prior_years_420e7B(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "as of a valuation date in each of the 2 preceding plan years the amount of (e)(2)(A) exceeded 110 percent of the funding target and target normal cost, case-asserted (section 420(e)(7)(B))";
}

pub relation reduced_threshold_applies_420e7(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(e)(7): the 110 percent substitution applies to a small transfer by a plan meeting (B)";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "In the case of a transfer of an amount which is not more than 1.75 percent of the amount determined under paragraph (2)(A)")
rule ReducedThreshold420e7(plan: Plan, y: TaxableYear, transfer: Money, lesser: Money) strict {
    label en official "exact boundary: a transfer of exactly 1.75 percent qualifies";
    when proposed_transfer_amount_420(plan, y, transfer)
        and excess_assets_lesser_amount_420e2A(plan, y, lesser)
        and transfer <= lesser * 0.0175
        and assets_exceeded_110_percent_in_both_prior_years_420e7B(plan, y);
    then reduced_threshold_applies_420e7(plan, y);
}

pub relation excess_assets_threshold_percentage_420e2B(plan: Plan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 420(e)(2)(B) and (e)(7)(A): 125 percent, or 110 percent for the qualifying small transfer";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "125 percent of the sum of the funding target and the target normal cost determined under section 430 for such plan year")
rule ExcessThreshold125_420e2B(plan: Plan, y: TaxableYear) strict {
    label en official "125 percent unless the reduced threshold applies";
    when proposed_transfer_amount_420(plan, y, _) and not_known(reduced_threshold_applies_420e7(plan, y));
    then excess_assets_threshold_percentage_420e2B(plan, y, 1.25);
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "paragraph (2)(B) shall be applied by substituting \"110 percent\" for \"125 percent\"")
rule ExcessThreshold110_420e7(plan: Plan, y: TaxableYear) strict {
    label en official "110 percent for the qualifying small transfer";
    when reduced_threshold_applies_420e7(plan, y);
    then excess_assets_threshold_percentage_420e2B(plan, y, 1.10);
}

pub relation excess_pension_assets_420e2(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(e)(2): the excess, if any, of the lesser asset value over the percentage of the funding target and target normal cost";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "The term \"excess pension assets\" means the excess (if any) of")
rule ExcessPensionAssets420e2(plan: Plan, y: TaxableYear, lesser: Money, base: Money, pct: Decimal) strict {
    label en official "max(lesser - pct x base, 0), rounded to the cent";
    when excess_assets_lesser_amount_420e2A(plan, y, lesser)
        and funding_target_and_normal_cost_420e2B(plan, y, base)
        and excess_assets_threshold_percentage_420e2B(plan, y, pct);
    then excess_pension_assets_420e2(plan, y, max(lesser - round(base * pct, 2, "HALF_UP"), 0.00 USD));
}

// =====================================================================
// (b) Qualified transfer
// =====================================================================

pub relation transfer_to_health_or_life_account_420b1A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "excess pension assets of the defined benefit plan are transferred to a health benefits account or an applicable life insurance account that is part of the plan, case-asserted (section 420(b)(1)(A))";
}

pub relation transfer_contravenes_other_law_420b1B(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the transfer contravenes another provision of law, case-asserted";
}

pub relation transfer_on_420b4(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date of the transfer, case-asserted";
}

pub relation transfer_ordinal_in_year_420b2(plan: Plan, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "the ordinal of the transfer among the plan's transfers in the taxable year (a transfer to both a health and a life insurance account counts as 1), case-asserted";
}

pub relation estimated_payments_for_retiree_liabilities_420b3(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount reasonably estimated to be paid out of the account for qualified current retiree liabilities during the taxable year of the transfer, case-asserted";
}

pub relation transfer_within_estimated_payments_420b3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(b)(3): the transferred amount does not exceed the estimate";
}

@source(IRC_S420_B, relation = formalizes, coverage = exact, quote = "The amount of excess pension assets which may be transferred to an account in a qualified transfer shall not exceed")
rule TransferWithinEstimate420b3(plan: Plan, y: TaxableYear, transfer: Money, estimate: Money) strict {
    label en official "exact boundary: a transfer equal to the estimate is within it";
    when proposed_transfer_amount_420(plan, y, transfer) and estimated_payments_for_retiree_liabilities_420b3(plan, y, estimate) and transfer <= estimate;
    then transfer_within_estimated_payments_420b3(plan, y);
}

pub relation transfer_within_excess_assets_420b3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(b)(1)(A): only excess pension assets can be transferred";
}

@source(IRC_S420_B, relation = formalizes, coverage = partial, quote = "of excess pension assets of a defined benefit plan to a health benefits account")
rule TransferWithinExcessAssets420b1A(plan: Plan, y: TaxableYear, transfer: Money, excess: Money) strict {
    label en official "PARTIAL: the transfer does not exceed the excess pension assets of the plan year";
    when proposed_transfer_amount_420(plan, y, transfer) and excess_pension_assets_420e2(plan, y, excess) and transfer <= excess;
    then transfer_within_excess_assets_420b3(plan, y);
}

pub relation accrued_benefits_vest_as_on_termination_420c2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan provides that accrued pension benefits become nonforfeitable as if the plan had terminated immediately before the transfer (or before a separation in the preceding year), case-asserted (section 420(c)(2))";
}

pub relation use_requirements_met_420c1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the use requirements of subsection (c)(1) are met (assets used only for qualified current retiree liabilities), case-asserted";
}

pub relation applicable_employer_cost_420c3(plan: Plan, y: TaxableYear, cost: Money) kind empirical {
    label en unofficial "the applicable employer cost per covered individual for the taxable year, case-asserted (section 420(c)(3)(B))";
}

pub relation applicable_employer_cost_prior_two_420c3A(plan: Plan, y: TaxableYear, first: Money, second: Money) kind empirical {
    label en unofficial "the applicable employer costs for each of the 2 taxable years immediately preceding the year of the transfer, case-asserted";
}

pub relation minimum_cost_requirement_met_420c3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(c)(3)(A): the cost for a year in the cost maintenance period is not less than the higher of the 2 preceding years' costs";
}

@source(IRC_S420_C, relation = formalizes, coverage = partial, quote = "the applicable employer cost for each taxable year during the cost maintenance period shall not be less than the higher of the applicable employer costs for each of the 2 taxable years immediately preceding the taxable year of the qualified transfer")
rule MinimumCostRequirement420c3A(plan: Plan, y: TaxableYear, cost: Money, first: Money, second: Money) strict {
    label en official "PARTIAL: exact boundary: a cost equal to the higher earlier cost meets the requirement; the reduction rules of (c)(3)(E) are not derived";
    when applicable_employer_cost_420c3(plan, y, cost)
        and applicable_employer_cost_prior_two_420c3A(plan, y, first, second)
        and cost >= max(first, second);
    then minimum_cost_requirement_met_420c3(plan, y);
}

pub relation retiree_liabilities_and_covered_individuals_420c3B(plan: Plan, y: TaxableYear, liabilities: Money, individuals: Decimal) kind empirical {
    label en unofficial "the qualified current retiree liabilities and the number of individuals covered for the benefits during the taxable year, case-asserted (section 420(c)(3)(B))";
}

pub relation applicable_employer_cost_derived_420c3B(plan: Plan, y: TaxableYear, cost: Money) kind institutional {
    label en official "section 420(c)(3)(B): liabilities divided by the number of covered individuals";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "the term \"applicable employer cost\" means, with respect to any taxable year, the amount determined by dividing")
rule ApplicableEmployerCost420c3B(plan: Plan, y: TaxableYear, liabilities: Money, n: Decimal) strict {
    label en official "liabilities / individuals, rounded half up to the cent";
    when retiree_liabilities_and_covered_individuals_420c3B(plan, y, liabilities, n) and n > 0.0;
    then applicable_employer_cost_derived_420c3B(plan, y, div_round(liabilities, n, 2, "HALF_UP"));
}

pub relation cost_maintenance_period_years_420c3D(plan: Plan, y: TaxableYear, years: Integer) kind institutional {
    label en official "section 420(c)(3)(D): 5 taxable years, or 7 for a transfer to which (e)(7) applies";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "the period of 5 taxable years (7 taxable years in the case of a transfer to which subsection (e)(7) applies)")
rule CostMaintenancePeriod5_420c3D(plan: Plan, y: TaxableYear) strict {
    label en official "5 years";
    when proposed_transfer_amount_420(plan, y, _) and not_known(reduced_threshold_applies_420e7(plan, y));
    then cost_maintenance_period_years_420c3D(plan, y, 5);
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "7 taxable years in the case of a transfer to which subsection (e)(7) applies")
rule CostMaintenancePeriod7_420c3D(plan: Plan, y: TaxableYear) strict {
    label en official "7 years";
    when reduced_threshold_applies_420e7(plan, y);
    then cost_maintenance_period_years_420c3D(plan, y, 7);
}

pub relation qualified_transfer_420b(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(b)(1): a qualified transfer";
}

@source(IRC_S420_B, relation = formalizes, coverage = partial, quote = "The term \"qualified transfer\" means a transfer")
rule QualifiedTransfer420b(plan: Plan, y: TaxableYear, on: Date, k: Integer) strict {
    label en official "PARTIAL: (A) excess assets to the account within the section 420(b)(3) limit, (B) not contravening another law, (C) the use, vesting and minimum cost requirements; the first transfer of the year (b)(2); made before 2033 (b)(4)";
    when transfer_to_health_or_life_account_420b1A(plan, y)
        and transfer_within_excess_assets_420b3(plan, y)
        and transfer_within_estimated_payments_420b3(plan, y)
        and use_requirements_met_420c1(plan, y)
        and accrued_benefits_vest_as_on_termination_420c2(plan, y)
        and minimum_cost_requirement_met_420c3(plan, y)
        and transfer_on_420b4(plan, y, on)
        and on <= @2032-12-31
        and transfer_ordinal_in_year_420b2(plan, y, k)
        and k <= 1
        and not_known(transfer_contravenes_other_law_420b1B(plan, y));
    then qualified_transfer_420b(plan, y);
}

// =====================================================================
// (a) Consequences of a qualified transfer
// =====================================================================

pub relation transfer_treatment_420a(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(a): the trust keeps its qualification under section 401(a) and (h), no gross income of the employer, the transfer is not an employer reversion (section 4980) or a prohibited transaction (section 4975), and the limits of (d) apply";
}

@source(IRC_S420_A, relation = formalizes, coverage = exact, quote = "no amount shall be includible in the gross income of the employer maintaining the plan solely by reason of such transfer")
rule QualifiedTransferTreatment420a(plan: Plan, y: TaxableYear) strict {
    label en official "the four treatments follow a qualified transfer";
    when qualified_transfer_420b(plan, y);
    then transfer_treatment_420a(plan, y);
}

pub relation transferred_assets_excluded_from_plan_assets_420e5(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(e)(5): transferred assets are not assets of the plan for sections 420, 430 and 433";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "any assets so transferred shall not, for purposes of this section and sections 430 and 433, be treated as assets in the plan")
rule TransferredAssetsNotPlanAssets420e5(plan: Plan, y: TaxableYear) strict {
    label en official "after a qualified transfer";
    when qualified_transfer_420b(plan, y);
    then transferred_assets_excluded_from_plan_assets_420e5(plan, y);
}

// =====================================================================
// (d) Deductions and contributions
// =====================================================================

pub relation amount_transferred_with_income_420d1(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount transferred in the qualified transfer and the income allocable to it, case-asserted";
}

pub relation paid_out_of_transferred_assets_420d1B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified current retiree liabilities paid out of the transferred assets and their income, case-asserted";
}

pub relation paid_out_of_other_assets_420d1C(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts paid for qualified current retiree liabilities out of other than the transferred assets, case-asserted";
}

pub relation deduction_denied_for_transfer_420d1A(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(d)(1)(A): no deduction for the amount transferred";
}

@source(IRC_S420_D, relation = formalizes, coverage = exact, quote = "for the transfer of any amount to a health benefits account, or an applicable life insurance account, in a qualified transfer")
rule DeductionDeniedTransfer420d1A(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "the whole transferred amount";
    when qualified_transfer_420b(plan, y) and amount_transferred_with_income_420d1(plan, y, amount);
    then deduction_denied_for_transfer_420d1A(plan, y, amount);
}

pub relation deduction_denied_for_payments_from_assets_420d1B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(d)(1)(B): no deduction for liabilities paid out of the transferred assets";
}

@source(IRC_S420_D, relation = formalizes, coverage = exact, quote = "for qualified current retiree liabilities paid out of the assets (and income) described in subsection (c)(1)")
rule DeductionDeniedPaidFromAssets420d1B(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "the amount paid out of the transferred assets";
    when qualified_transfer_420b(plan, y) and paid_out_of_transferred_assets_420d1B(plan, y, amount);
    then deduction_denied_for_payments_from_assets_420d1B(plan, y, amount);
}

pub relation deduction_denied_for_other_payments_420d1C(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(d)(1)(C): no deduction for other payments up to the excess of the transferred amount over the (B) payments";
}

@source(IRC_S420_D, relation = formalizes, coverage = exact, quote = "for any amounts to which subparagraph (B) does not apply and which are paid for qualified current retiree liabilities for the taxable year to the extent such amounts are not greater than the excess (if any) of")
rule DeductionDeniedOtherPayments420d1C(plan: Plan, y: TaxableYear, other: Money, transferred: Money, from_assets: Money) strict {
    label en official "min(other payments, max(transferred - paid from assets, 0))";
    when qualified_transfer_420b(plan, y)
        and paid_out_of_other_assets_420d1C(plan, y, other)
        and amount_transferred_with_income_420d1(plan, y, transferred)
        and paid_out_of_transferred_assets_420d1B(plan, y, from_assets);
    then deduction_denied_for_other_payments_420d1C(plan, y, min(other, max(transferred - from_assets, 0.00 USD)));
}

pub relation plan_employer_420(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the employer maintaining the plan, case-asserted";
}

pub relation contributes_to_account_for_transferred_liabilities_420d2(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer contributes an amount to a health benefits account or welfare benefit fund for qualified current retiree liabilities for which transferred assets must be used, case-asserted (action atom)";
}

@source(IRC_S420_D, relation = formalizes, coverage = exact, quote = "An employer may not contribute any amount to a health benefits account or welfare benefit fund")
rule ContributionProhibition420d2(plan: Plan, y: TaxableYear, employer: Person) strict {
    label en official "after a qualified transfer the employer may not contribute for the liabilities the transferred assets must fund";
    when qualified_transfer_420b(plan, y) and plan_employer_420(plan, employer);
    then prohibition ContributeForTransferredLiabilitiesProhibition {
        bearer employer;
        action contributes_to_account_for_transferred_liabilities_420d2(employer, plan);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (f)(5) Transfer period
// =====================================================================

pub relation transfer_period_years_420f5(plan: Plan, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the number of consecutive taxable years of the transfer period specified in the election, case-asserted";
}

pub relation transfer_period_within_10_years_420f5(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the transfer period begins and ends during the 10-taxable-year period beginning with the taxable year of the transfer, case-asserted";
}

pub relation transfer_period_valid_420f5(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(5): a period of consecutive taxable years of not less than 2";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "a period of consecutive taxable years (not less than 2) specified in the election under paragraph (1)")
rule TransferPeriodValid420f5(plan: Plan, y: TaxableYear, years: Integer) strict {
    label en official "exact boundary: 2 years is valid, 1 is not";
    when transfer_period_years_420f5(plan, y, years) and years >= 2 and transfer_period_within_10_years_420f5(plan, y);
    then transfer_period_valid_420f5(plan, y);
}
