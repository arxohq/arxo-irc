// Sections 406, 407 and 414A — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026):
// (a) employees of foreign affiliates (406) and of domestic subsidiaries (407)
// treated as employees of the American or domestic parent for the plan of the
// parent, with the highly compensated employee capacity, the total
// compensation, the shift of the section 404 deduction and the additional
// employee treatment; (b) the automatic enrollment requirements of section
// 414A and its exceptions.
//
// Method: the ownership and income shares are exact Decimal fractions
// compared without rounding; dates are exact; the agreement under section
// 3121(l), the citizenship or residency of the individual and the parent plan
// terms are case-asserted.

// =====================================================================
// 407 Domestic subsidiaries
// =====================================================================

use self::{
    IRC_S406_A,
    IRC_S406_B,
    IRC_S406_D,
    IRC_S406_E,
    IRC_S407_A,
    IRC_S407_B,
    IRC_S407_D,
    IRC_S407_E,
    IRC_S414A_A,
    IRC_S414A_B,
    IRC_S414A_C,
    Person,
    Plan,
};

pub relation domestic_corporation_407(corp: Person) kind empirical {
    label en unofficial "the corporation is a domestic corporation, case-asserted";
}

pub relation voting_stock_owned_share_407(sub: Person, owner: Person, share: Decimal) kind empirical {
    label en unofficial "the share of the outstanding voting stock of the subsidiary the owner holds (a fraction), case-asserted";
}

pub relation gross_income_foreign_source_share_407a2Aii(sub: Person, share: Decimal) kind empirical {
    label en unofficial "the share of the corporation's gross income for the 3-year period derived from sources without the United States (a fraction), case-asserted";
}

pub relation gross_income_active_business_share_407a2Aiii(sub: Person, share: Decimal) kind empirical {
    label en unofficial "the share of the corporation's gross income for the period derived from the active conduct of a trade or business (a fraction), case-asserted";
}

pub relation no_gross_income_in_period_407a2A(sub: Person) kind empirical {
    label en unofficial "the corporation had no gross income for the period, case-asserted";
}

pub relation reasonable_to_anticipate_income_tests_407a2A(sub: Person) kind empirical {
    label en unofficial "it is reasonable to anticipate that the income tests will be satisfied for the first year with gross income, case-asserted";
}

pub relation domestic_subsidiary_407a2A(sub: Person) kind institutional {
    label en official "section 407(a)(2)(A): a domestic subsidiary for the taxable year";
}

@source(IRC_S407_A, relation = formalizes, coverage = exact, quote = "such corporation is a domestic corporation 80 percent or more of the outstanding voting stock of which is owned by another domestic corporation")
rule DomesticSubsidiary407a2A(sub: Person, parent: Person, share: Decimal, foreign: Decimal, active: Decimal) strict {
    label en official "exact boundaries: 80 percent ownership, 95 percent foreign source income, 90 percent active business income";
    when domestic_corporation_407(sub)
        and domestic_corporation_407(parent)
        and voting_stock_owned_share_407(sub, parent, share)
        and share >= 0.80
        and gross_income_foreign_source_share_407a2Aii(sub, foreign)
        and foreign >= 0.95
        and gross_income_active_business_share_407a2Aiii(sub, active)
        and active >= 0.90;
    then domestic_subsidiary_407a2A(sub);
}

@source(IRC_S407_A, relation = formalizes, coverage = exact, quote = "the provisions of clauses (ii) and (iii) shall be treated as satisfied if it is reasonable to anticipate")
rule DomesticSubsidiaryNoIncome407a2A(sub: Person, parent: Person, share: Decimal) strict {
    label en official "a corporation with no gross income for the period meets the income tests when it is reasonable to anticipate them";
    when domestic_corporation_407(sub)
        and domestic_corporation_407(parent)
        and voting_stock_owned_share_407(sub, parent, share)
        and share >= 0.80
        and no_gross_income_in_period_407a2A(sub)
        and reasonable_to_anticipate_income_tests_407a2A(sub);
    then domestic_subsidiary_407a2A(sub);
}

pub relation domestic_parent_of_407a2B(sub: Person, parent: Person) kind institutional {
    label en official "section 407(a)(2)(B): the domestic corporation that owns 80 percent or more of the voting stock of the domestic subsidiary";
}

@source(IRC_S407_A, relation = formalizes, coverage = exact, quote = "The domestic parent corporation of any domestic subsidiary is the domestic corporation which owns 80 percent or more of the outstanding voting stock of such domestic subsidiary")
rule DomesticParent407a2B(sub: Person, parent: Person, share: Decimal) strict {
    label en official "exact boundary: 80 percent";
    when domestic_subsidiary_407a2A(sub) and domestic_corporation_407(parent) and voting_stock_owned_share_407(sub, parent, share) and share >= 0.80;
    then domestic_parent_of_407a2B(sub, parent);
}

pub relation individual_us_citizen_or_resident_406_407(individual: Person) kind empirical {
    label en unofficial "the individual is a citizen or resident of the United States, case-asserted";
}

pub relation individual_employee_of_407(individual: Person, sub: Person) kind empirical {
    label en unofficial "the individual is an employee of the subsidiary or affiliate, case-asserted";
}

pub relation parent_plan_covers_subsidiary_employees_407a1A(plan: Plan, parent: Person) kind empirical {
    label en unofficial "the plan of the domestic parent corporation expressly provides for contributions or benefits for United States citizens and residents who are employees of its domestic subsidiaries, case-asserted";
}

pub relation other_person_funds_deferred_compensation_406_407(individual: Person) kind empirical {
    label en unofficial "contributions under a funded plan of deferred compensation are provided by another person for the remuneration the subsidiary or affiliate pays the individual, case-asserted";
}

pub relation treated_as_employee_of_parent_407a1(individual: Person, parent: Person, plan: Plan) kind institutional {
    label en official "section 407(a)(1): the individual is treated as an employee of the domestic parent corporation for the parent's plan";
}

@source(IRC_S407_A, relation = formalizes, coverage = exact, quote = "an individual who is a citizen or resident of the United States and who is an employee of a domestic subsidiary")
rule TreatedAsEmployeeOfParent407a1(individual: Person, sub: Person, parent: Person, plan: Plan) strict {
    label en official "(A) the parent plan expressly covers such individuals and (B) no other person provides funded deferred compensation";
    when individual_us_citizen_or_resident_406_407(individual)
        and individual_employee_of_407(individual, sub)
        and domestic_parent_of_407a2B(sub, parent)
        and parent_plan_covers_subsidiary_employees_407a1A(plan, parent)
        and not_known(other_person_funds_deferred_compensation_406_407(individual));
    then treated_as_employee_of_parent_407a1(individual, parent, plan);
}

pub relation individual_highly_compensated_414q_406_407(individual: Person) kind empirical {
    label en unofficial "the individual is a highly compensated employee within the meaning of section 414(q) (case-asserted, determined on total compensation with the parent as employer)";
}

pub relation highly_compensated_of_parent_407b1(individual: Person, parent: Person) kind institutional {
    label en official "section 407(b)(1)(A): for sections 401(a)(4) and 410(b) the individual has the highly compensated capacity with respect to the parent";
}

@source(IRC_S407_B, relation = formalizes, coverage = partial, quote = "if such individual is a highly compensated employee (within the meaning of section 414(q)), he shall be treated as having such capacity with respect to such domestic parent corporation")
rule HighlyCompensatedOfParent407b1A(individual: Person, parent: Person, plan: Plan) strict {
    label en official "PARTIAL: (A); the 414(q) test on total compensation of (B) is case-asserted";
    when treated_as_employee_of_parent_407a1(individual, parent, plan) and individual_highly_compensated_414q_406_407(individual);
    then highly_compensated_of_parent_407b1(individual, parent);
}

pub relation remuneration_paid_by_subsidiary_407b2(individual: Person, amount: Money) kind empirical {
    label en unofficial "the remuneration the domestic subsidiary pays the individual that would be total compensation if his services were for the parent, case-asserted";
}

pub relation total_compensation_for_parent_407b2(individual: Person, amount: Money) kind institutional {
    label en official "section 407(b)(2): the total compensation for section 401(a)(5) is the subsidiary's remuneration";
}

@source(IRC_S407_B, relation = formalizes, coverage = exact, quote = "the total compensation of such individual shall be the remuneration paid to such individual by the domestic subsidiary")
rule TotalCompensation407b2(individual: Person, parent: Person, plan: Plan, amount: Money) strict {
    label en official "the remuneration paid by the subsidiary";
    when treated_as_employee_of_parent_407a1(individual, parent, plan) and remuneration_paid_by_subsidiary_407b2(individual, amount);
    then total_compensation_for_parent_407b2(individual, amount);
}

pub relation contribution_on_behalf_of_treated_employee_407d(parent: Person, individual: Person, sub: Person, would_be_deductible: Money) kind empirical {
    label en unofficial "a contribution is made by the parent (or another corporation entitled to the section 404(a)(3)(B) deduction) on behalf of the individual; the amount that would be deductible by the parent if he were its employee, case-asserted";
}

pub relation deduction_denied_to_parent_407d1(parent: Person, individual: Person) kind institutional {
    label en official "section 407(d)(1): no deduction to the domestic parent or another corporation entitled to deduct";
}

pub relation deduction_allowed_to_subsidiary_407d2(sub: Person, individual: Person, amount: Money) kind institutional {
    label en official "section 407(d)(2): the domestic subsidiary deducts what the parent would have deducted";
}

@source(IRC_S407_D, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed to such domestic parent corporation")
rule DeductionDeniedToParent407d1(parent: Person, individual: Person, sub: Person, amount: Money, plan: Plan) strict {
    label en official "the parent's deduction is denied";
    when treated_as_employee_of_parent_407a1(individual, parent, plan) and contribution_on_behalf_of_treated_employee_407d(parent, individual, sub, amount);
    then deduction_denied_to_parent_407d1(parent, individual);
}

@source(IRC_S407_D, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction to the domestic subsidiary of which such individual is an employee an amount equal to the amount which (but for paragraph (1)) would be deductible under section 404 by the domestic parent corporation")
rule DeductionAllowedToSubsidiary407d2(parent: Person, individual: Person, sub: Person, amount: Money, plan: Plan) strict {
    label en official "the subsidiary deducts the amount the parent would have deducted";
    when treated_as_employee_of_parent_407a1(individual, parent, plan) and contribution_on_behalf_of_treated_employee_407d(parent, individual, sub, amount);
    then deduction_allowed_to_subsidiary_407d2(sub, individual, amount);
}

pub relation treated_as_employee_for_72f_and_2039_407e(individual: Person, parent: Person) kind institutional {
    label en official "section 407(e): the individual is also an employee of the parent for sections 72(f) and 2039";
}

@source(IRC_S407_E, relation = formalizes, coverage = exact, quote = "shall also be treated as an employee of such domestic parent corporation, with respect to the plan described in subsection (a)(1)(A)")
rule AlsoEmployeeForSections72fAnd2039_407e(individual: Person, parent: Person, plan: Plan) strict {
    label en official "sections 72(f) and 2039";
    when treated_as_employee_of_parent_407a1(individual, parent, plan);
    then treated_as_employee_for_72f_and_2039_407e(individual, parent);
}

// =====================================================================
// 406 Foreign affiliates
// =====================================================================

pub relation american_employer_3121h_406(employer: Person) kind empirical {
    label en unofficial "the employer is an American employer as defined in section 3121(h), case-asserted";
}

pub relation section_3121l_agreement_applies_to_affiliate_406a1(employer: Person, affiliate: Person) kind empirical {
    label en unofficial "the American employer has entered into an agreement under section 3121(l) that applies to the foreign affiliate, case-asserted";
}

pub relation american_plan_covers_affiliate_employees_406a2(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the plan of the American employer expressly provides for contributions or benefits for United States citizens and residents who are employees of its foreign affiliates covered by a section 3121(l) agreement, case-asserted";
}

pub relation treated_as_employee_of_american_employer_406a(individual: Person, employer: Person, plan: Plan) kind institutional {
    label en official "section 406(a): the individual is treated as an employee of the American employer for its plan";
}

@source(IRC_S406_A, relation = formalizes, coverage = exact, quote = "such American employer has entered into an agreement under section 3121(l) which applies to the foreign affiliate of which such individual is an employee")
rule TreatedAsEmployeeOfAmericanEmployer406a(individual: Person, affiliate: Person, employer: Person, plan: Plan) strict {
    label en official "(1) agreement, (2) plan terms, (3) no other person funds deferred compensation";
    when american_employer_3121h_406(employer)
        and individual_us_citizen_or_resident_406_407(individual)
        and individual_employee_of_407(individual, affiliate)
        and section_3121l_agreement_applies_to_affiliate_406a1(employer, affiliate)
        and american_plan_covers_affiliate_employees_406a2(plan, employer)
        and not_known(other_person_funds_deferred_compensation_406_407(individual));
    then treated_as_employee_of_american_employer_406a(individual, employer, plan);
}

pub relation highly_compensated_of_american_employer_406b1(individual: Person, employer: Person) kind institutional {
    label en official "section 406(b)(1)(A): the highly compensated capacity with respect to the American employer";
}

@source(IRC_S406_B, relation = formalizes, coverage = partial, quote = "if such individual is a highly compensated employee (within the meaning of section 414(q)), he shall be treated as having such capacity with respect to such American employer")
rule HighlyCompensatedOfAmericanEmployer406b1A(individual: Person, employer: Person, plan: Plan) strict {
    label en official "PARTIAL: (A); the 414(q) test on total compensation of (B) is case-asserted";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan) and individual_highly_compensated_414q_406_407(individual);
    then highly_compensated_of_american_employer_406b1(individual, employer);
}

pub relation remuneration_paid_by_affiliate_406b2A(individual: Person, amount: Money) kind empirical {
    label en unofficial "the remuneration the foreign affiliate pays the individual, case-asserted";
}

pub relation total_compensation_for_american_employer_406b2A(individual: Person, amount: Money) kind institutional {
    label en official "section 406(b)(2)(A): the total compensation is the affiliate's remuneration";
}

@source(IRC_S406_B, relation = formalizes, coverage = partial, quote = "the total compensation of such individual shall be the remuneration paid to such individual by the foreign affiliate")
rule TotalCompensation406b2A(individual: Person, employer: Person, plan: Plan, amount: Money) strict {
    label en official "PARTIAL: the basic or regular rate of compensation under regulations is not derived";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan) and remuneration_paid_by_affiliate_406b2A(individual, amount);
    then total_compensation_for_american_employer_406b2A(individual, amount);
}

pub relation american_employer_amount_equivalent_to_3101_tax_406b2B(individual: Person, amount: Money) kind empirical {
    label en unofficial "the amount paid by the American employer that is equivalent to the tax imposed by section 3101, case-asserted";
}

pub relation individual_treated_as_paid_3101_equivalent_406b2B(individual: Person, amount: Money) kind institutional {
    label en official "section 406(b)(2)(B): the individual is treated as having paid the equivalent amount";
}

@source(IRC_S406_B, relation = formalizes, coverage = exact, quote = "such individual shall be treated as having paid the amount paid by such American employer which is equivalent to the tax imposed by section 3101")
rule TreatedAsPaid3101Equivalent406b2B(individual: Person, employer: Person, plan: Plan, amount: Money) strict {
    label en official "the American employer's equivalent amount is treated as the individual's payment";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan) and american_employer_amount_equivalent_to_3101_tax_406b2B(individual, amount);
    then individual_treated_as_paid_3101_equivalent_406b2B(individual, amount);
}

pub relation contribution_on_behalf_of_treated_employee_406d(employer: Person, individual: Person, affiliate: Person, would_be_deductible: Money) kind empirical {
    label en unofficial "a contribution is made by the American employer (or another taxpayer entitled to the section 404(a)(3)(B) deduction) on behalf of the individual; the amount that would be deductible by the American employer, case-asserted";
}

pub relation deduction_denied_to_american_employer_406d1(employer: Person, individual: Person) kind institutional {
    label en official "section 406(d)(1): no deduction to the American employer or another taxpayer entitled to deduct";
}

pub relation deduction_allowed_to_foreign_affiliate_406d2(affiliate: Person, individual: Person, amount: Money) kind institutional {
    label en official "section 406(d)(2): the foreign affiliate deducts what the American employer would have deducted";
}

@source(IRC_S406_D, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed to such American employer")
rule DeductionDeniedToAmericanEmployer406d1(employer: Person, individual: Person, affiliate: Person, amount: Money, plan: Plan) strict {
    label en official "the American employer's deduction is denied";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan) and contribution_on_behalf_of_treated_employee_406d(employer, individual, affiliate, amount);
    then deduction_denied_to_american_employer_406d1(employer, individual);
}

@source(IRC_S406_D, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction to the foreign affiliate of which such individual is an employee an amount equal to the amount which (but for paragraph (1)) would be deductible under section 404 by the American employer")
rule DeductionAllowedToForeignAffiliate406d2(employer: Person, individual: Person, affiliate: Person, amount: Money, plan: Plan) strict {
    label en official "the foreign affiliate deducts the amount the American employer would have deducted";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan) and contribution_on_behalf_of_treated_employee_406d(employer, individual, affiliate, amount);
    then deduction_allowed_to_foreign_affiliate_406d2(affiliate, individual, amount);
}

pub relation treated_as_employee_for_72f_and_2039_406e(individual: Person, employer: Person) kind institutional {
    label en official "section 406(e): the individual is also an employee of the American employer for sections 72(f) and 2039";
}

@source(IRC_S406_E, relation = formalizes, coverage = exact, quote = "shall also be treated as an employee of such American employer, with respect to the plan described in subsection (a)(2)")
rule AlsoEmployeeForSections72fAnd2039_406e(individual: Person, employer: Person, plan: Plan) strict {
    label en official "sections 72(f) and 2039";
    when treated_as_employee_of_american_employer_406a(individual, employer, plan);
    then treated_as_employee_for_72f_and_2039_406e(individual, employer);
}

// =====================================================================
// 414A Automatic enrollment
// =====================================================================

pub relation arrangement_is_cash_or_deferred_414Aa(plan: Plan) kind empirical {
    label en unofficial "the arrangement is a cash or deferred arrangement described in section 401(k), or an annuity contract described in section 403(b) purchased under a salary reduction agreement, case-asserted";
}

pub relation eligible_automatic_contribution_arrangement_414Ab1(plan: Plan) kind empirical {
    label en unofficial "the arrangement is an eligible automatic contribution arrangement as defined in section 414(w)(3), case-asserted";
}

pub relation arrangement_allows_permissible_withdrawals_414Ab2(plan: Plan) kind empirical {
    label en unofficial "the arrangement allows employees to make permissible withdrawals as defined in section 414(w)(2), case-asserted";
}

pub relation initial_uniform_percentage_414Ab3Ai(plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the uniform percentage of compensation contributed during the first year of participation (a fraction), case-asserted";
}

pub relation escalation_step_and_cap_414Ab3Aii(plan: Plan, step: Decimal, cap: Decimal) kind empirical {
    label en unofficial "the annual increase in the uniform percentage and the percentage at which the increases stop (fractions), case-asserted";
}

pub relation plan_year_end_414Ab3B(plan: Plan, on: Date) kind empirical {
    label en unofficial "the end of the plan year, case-asserted";
}

pub relation arrangement_under_401k12_or_13_414Ab3B(plan: Plan) kind empirical {
    label en unofficial "the arrangement meets the requirements of paragraph (12) or (13) of section 401(k), case-asserted";
}

pub relation default_investment_meets_regulation_414Ab4(plan: Plan) kind empirical {
    label en unofficial "amounts contributed for which the participant elects no investment are invested in accordance with 29 CFR 2550.404c-5 or a successor, case-asserted";
}

pub relation initial_percentage_valid_414Ab3Ai(plan: Plan) kind institutional {
    label en official "section 414A(b)(3)(A)(i): the first-year uniform percentage is between 3 and 10 percent";
}

@source(IRC_S414A_B, relation = formalizes, coverage = partial, quote = "the uniform percentage of compensation contributed by the participant under such arrangement during the first year of participation is not less than 3 percent and not more than 10 percent")
rule InitialPercentageValid414Ab3Ai(plan: Plan, pct: Decimal) strict {
    label en official "PARTIAL: exact boundaries 0.03 and 0.10 inclusive; the participant's election out is not gated";
    when initial_uniform_percentage_414Ab3Ai(plan, pct) and pct >= 0.03 and pct <= 0.10;
    then initial_percentage_valid_414Ab3Ai(plan);
}

pub relation escalation_valid_414Ab3Aii(plan: Plan) kind institutional {
    label en official "section 414A(b)(3)(A)(ii) and (B): 1 point increases to a cap of at least 10 percent and at most 15 percent (10 percent for plan years ending before 2025 unless paragraph (12) or (13) of section 401(k) applies)";
}

@source(IRC_S414A_B, relation = formalizes, coverage = partial, quote = "such uniform percentage is increased by 1 percentage point (to at least 10 percent, but not more than 15 percent)")
rule EscalationValidLater414Ab3Aii(plan: Plan, step: Decimal, cap: Decimal, end: Date) strict {
    label en official "PARTIAL: step of 1 point; cap 0.10 to 0.15 for plan years ending on or after January 1, 2025 (or for a paragraph (12) or (13) arrangement)";
    when escalation_step_and_cap_414Ab3Aii(plan, step, cap)
        and plan_year_end_414Ab3B(plan, end)
        and step >= 0.01
        and cap >= 0.10
        and cap <= 0.15
        and end >= @2025-01-01;
    then escalation_valid_414Ab3Aii(plan);
}

@source(IRC_S414A_B, relation = formalizes, coverage = partial, quote = "for plan years ending before January 1, 2025, subparagraph (A)(ii) shall be applied by substituting \"10 percent\" for \"15 percent\"")
rule EscalationValidEarlier414Ab3B(plan: Plan, step: Decimal, cap: Decimal, end: Date) strict {
    label en official "PARTIAL: for plan years ending before January 1, 2025 the cap is exactly 0.10";
    when escalation_step_and_cap_414Ab3Aii(plan, step, cap)
        and plan_year_end_414Ab3B(plan, end)
        and step >= 0.01
        and cap >= 0.10
        and cap <= 0.10
        and end < @2025-01-01
        and not_known(arrangement_under_401k12_or_13_414Ab3B(plan));
    then escalation_valid_414Ab3Aii(plan);
}

@source(IRC_S414A_B, relation = formalizes, coverage = partial, quote = "(other than an arrangement that meets the requirements of paragraph (12) or (13) of section 401(k))")
rule EscalationValidEarlierSafeHarbor414Ab3B(plan: Plan, step: Decimal, cap: Decimal, end: Date) strict {
    label en official "PARTIAL: an arrangement under paragraph (12) or (13) keeps the 15 percent cap before 2025";
    when escalation_step_and_cap_414Ab3Aii(plan, step, cap)
        and plan_year_end_414Ab3B(plan, end)
        and arrangement_under_401k12_or_13_414Ab3B(plan)
        and step >= 0.01
        and cap >= 0.10
        and cap <= 0.15
        and end < @2025-01-01;
    then escalation_valid_414Ab3Aii(plan);
}

pub relation meets_automatic_enrollment_requirements_414Ab(plan: Plan) kind institutional {
    label en official "section 414A(b): an eligible automatic contribution arrangement meeting paragraphs (2) through (4)";
}

@source(IRC_S414A_B, relation = formalizes, coverage = exact, quote = "An arrangement or agreement meets the requirements of this subsection if such arrangement or agreement is an eligible automatic contribution arrangement (as defined in section 414(w)(3)) which meets the requirements of paragraphs (2) through (4)")
rule MeetsAutomaticEnrollment414Ab(plan: Plan) strict {
    label en official "all four paragraphs are conjunctive";
    when eligible_automatic_contribution_arrangement_414Ab1(plan)
        and arrangement_allows_permissible_withdrawals_414Ab2(plan)
        and initial_percentage_valid_414Ab3Ai(plan)
        and escalation_valid_414Ab3Aii(plan)
        and default_investment_meets_regulation_414Ab4(plan);
    then meets_automatic_enrollment_requirements_414Ab(plan);
}

pub relation simple_plan_414Ac1(plan: Plan) kind empirical {
    label en unofficial "the plan is a simple plan within the meaning of section 401(k)(11), case-asserted";
}

pub relation arrangement_established_on_414Ac2(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the qualified cash or deferred arrangement or the plan under which the annuity contract is purchased was established, case-asserted";
}

pub relation governmental_or_church_plan_414Ac3(plan: Plan) kind empirical {
    label en unofficial "the plan is a governmental plan (section 414(d)) or a church plan (section 414(e)), case-asserted";
}

pub relation employer_years_in_existence_414Ac4A(plan: Plan, years: Decimal) kind empirical {
    label en unofficial "how long the employer maintaining the plan (with any predecessor employer) has been in existence, in years, case-asserted";
}

pub relation first_year_over_10_employees_close_414Ac4B(plan: Plan, close: Date) kind empirical {
    label en unofficial "the close of the first taxable year for which the employer normally employed more than 10 employees, case-asserted";
}

pub relation subsection_414Aa_not_applicable_414Ac(plan: Plan) kind institutional {
    label en official "section 414A(c): subsection (a) does not apply";
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any simple plan (within the meaning of section 401(k)(11))")
rule ExemptSimple414Ac1(plan: Plan) strict {
    label en official "(1)";
    when simple_plan_414Ac1(plan);
    then subsection_414Aa_not_applicable_414Ac(plan);
}

@source(IRC_S414A_C, relation = formalizes, coverage = partial, quote = "any qualified cash or deferred arrangement established before the date of the enactment of this section")
rule ExemptEstablishedBefore414Ac2A(plan: Plan, on: Date) strict {
    label en official "PARTIAL (INTERPRETATION: the date of enactment is read as December 29, 2022, Pub. L. 117-328); exact boundary: established on December 28, 2022 is exempt, on December 29, 2022 is not; the multiple employer rule of (B) is not derived";
    when arrangement_established_on_414Ac2(plan, on) and on < @2022-12-29;
    then subsection_414Aa_not_applicable_414Ac(plan);
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any governmental plan (within the meaning of section 414(d)) or any church plan (within the meaning of section 414(e))")
rule ExemptGovernmentalOrChurch414Ac3(plan: Plan) strict {
    label en official "(3)";
    when governmental_or_church_plan_414Ac3(plan);
    then subsection_414Aa_not_applicable_414Ac(plan);
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "while the employer maintaining such plan (and any predecessor employer) has been in existence for less than 3 years")
rule ExemptNewEmployer414Ac4A(plan: Plan, years: Decimal) strict {
    label en official "(4)(A): exact boundary: existence of exactly 3 years is not less than 3";
    when employer_years_in_existence_414Ac4A(plan, years) and years < 3.0;
    then subsection_414Aa_not_applicable_414Ac(plan);
}

pub relation subsection_414Aa_applies_from_414Ac4B(plan: Plan, on: Date) kind institutional {
    label en official "section 414A(c)(4)(B): subsection (a) applies no earlier than 1 year after the close of the first taxable year in which the employer normally employed more than 10 employees";
}

@source(IRC_S414A_C, relation = formalizes, coverage = exact, quote = "earlier than the date that is 1 year after the close of the first taxable year with respect to which the employer maintaining the plan normally employed more than 10 employees")
rule EarliestApplication414Ac4B(plan: Plan, close: Date) strict {
    label en official "close + 1 calendar year";
    when first_year_over_10_employees_close_414Ac4B(plan, close);
    then subsection_414Aa_applies_from_414Ac4B(plan, add_calendar_period(close, 1 calendar_year));
}

pub relation qualified_cash_or_deferred_status_414Aa(plan: Plan) kind institutional {
    label en official "section 414A(a): the arrangement keeps its status as a qualified cash or deferred arrangement (or as a section 403(b) contract)";
}

@source(IRC_S414A_A, relation = formalizes, coverage = exact, quote = "an arrangement shall not be treated as a qualified cash or deferred arrangement described in section 401(k) unless such arrangement meets the automatic enrollment requirements of subsection (b)")
rule QualifiedStatusWithAutoEnrollment414Aa(plan: Plan) strict {
    label en official "the requirement is met";
    when arrangement_is_cash_or_deferred_414Aa(plan) and meets_automatic_enrollment_requirements_414Ab(plan);
    then qualified_cash_or_deferred_status_414Aa(plan);
}

@source(IRC_S414A_A, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this section")
rule QualifiedStatusExempt414Aa(plan: Plan) strict {
    label en official "an arrangement outside subsection (a) by an exception of subsection (c) keeps its status";
    when arrangement_is_cash_or_deferred_414Aa(plan) and subsection_414Aa_not_applicable_414Ac(plan);
    then qualified_cash_or_deferred_status_414Aa(plan);
}
