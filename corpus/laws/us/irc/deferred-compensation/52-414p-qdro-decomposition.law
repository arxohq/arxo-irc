// Section 414(p) — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): the qualified domestic relations order decomposed. Stage 1
// (module 12) and stage 2e (module 28) modelled the QDRO as a power whose
// (2)/(3) conditions are single case-asserted bundles and the (7)(D)
// prospective-only rule. This module unbundles what those modules left as
// TECH_GAP: (1)(B) State/Tribal law, (2)(A)-(D) specificity, (3)(A)-(C) the
// no-alteration tests, (4) the earliest-retirement-age exception, (5) former
// spouse as surviving spouse, (6) administrator notice and determination
// duties, (7)(A)-(C) segregation and payment duties, (8) the alternate-payee
// classes, (9)-(12) scope, waiver and other plans.
//
// Method: every requirement is a positive input fact (or, where the statute
// says "does not require", a positive violation fact read through
// `not_known`); the decomposed route CONCLUDES the same institutional heads
// as the bundled route (`qdro_requirements_2_and_3_met`,
// `qdro_eligible_to_be_recognized`), so a case may use either input style.
// "Promptly" and "within a reasonable period" are DECISION-0194 evaluative
// timing terms: the duty carries no numeric window and the coverage row says
// EVALUATIVE. The 18-month period is exact calendar arithmetic (needs the
// IRC calendar-step policy in scenarios).

// =====================================================================
// (1)(B) Domestic relations order: subject matter and State/Tribal law
// =====================================================================

use self::{
    Distribution,
    DomesticRelationsOrder,
    IRC_S414_P,
    Person,
    Plan,
    alternate_payee_treated_as_distributee_402e1,
    church_plan_414e,
    distribution,
    domestic_relations_order_of,
    first_payment_required_under_order_on,
    governmental_plan_414d,
    plan_administrator_of,
    qdro_eligible_to_be_recognized,
    qdro_recognized,
    qdro_requirements_2_and_3_met,
};

pub enum DomesticLawIssuer414p {
    StateGovernment;
    IndianTribalGovernment;
    SubdivisionOfIndianTribalGovernment;
    AgencyOrInstrumentalityOfIndianTribalGovernment;
}

pub enum FamilyMatter414p {
    ChildSupport;
    AlimonyPayments;
    MaritalPropertyRights;
}

pub enum AlternatePayeeClass414p {
    Spouse;
    FormerSpouse;
    Child;
    OtherDependent;
}

pub relation order_made_pursuant_to_law_issued_by(order: DomesticRelationsOrder, issuer: DomesticLawIssuer414p) kind empirical {
    label en unofficial "the order is made pursuant to a domestic relations law issued by this kind of government, case-asserted (section 414(p)(1)(B)(ii))";
}

pub relation order_made_pursuant_to_community_property_law(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order is made pursuant to a community property law of a State or Indian tribal government, case-asserted (section 414(p)(1)(B)(ii) parenthetical)";
}

pub relation order_relates_to_family_matter_414p1Bi(order: DomesticRelationsOrder, matter: FamilyMatter414p, beneficiary: AlternatePayeeClass414p) kind empirical {
    label en unofficial "the order relates to this matter (child support, alimony payments, or marital property rights) for this class of person, case-asserted (section 414(p)(1)(B)(i))";
}

pub relation domestic_relations_law_is_tribal_414p1B(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(1)(B) last sentence: \"Tribal\" means a law issued by or under the laws of an Indian tribal government, a subdivision of it, or an agency or instrumentality of either";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "issued by or under the laws of an Indian tribal government, a subdivision of such an Indian tribal government, or an agency or instrumentality of either")
rule TribalLawByGovernment414p1B(order: DomesticRelationsOrder) strict {
    label en official "issued by an Indian tribal government";
    when order_made_pursuant_to_law_issued_by(order, IndianTribalGovernment);
    then domestic_relations_law_is_tribal_414p1B(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "issued by or under the laws of an Indian tribal government, a subdivision of such an Indian tribal government, or an agency or instrumentality of either")
rule TribalLawBySubdivision414p1B(order: DomesticRelationsOrder) strict {
    label en official "issued by a subdivision of an Indian tribal government";
    when order_made_pursuant_to_law_issued_by(order, SubdivisionOfIndianTribalGovernment);
    then domestic_relations_law_is_tribal_414p1B(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "issued by or under the laws of an Indian tribal government, a subdivision of such an Indian tribal government, or an agency or instrumentality of either")
rule TribalLawByAgency414p1B(order: DomesticRelationsOrder) strict {
    label en official "issued by an agency or instrumentality of a tribal government or of its subdivision";
    when order_made_pursuant_to_law_issued_by(order, AgencyOrInstrumentalityOfIndianTribalGovernment);
    then domestic_relations_law_is_tribal_414p1B(order);
}

pub relation order_made_pursuant_to_state_or_tribal_law_414p1Bii(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(1)(B)(ii): the order is made pursuant to a State or Tribal domestic relations law (including a community property law)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "is made pursuant to a State or Tribal domestic relations law (including a community property law)")
rule OrderUnderStateLaw414p1Bii(order: DomesticRelationsOrder) strict {
    label en official "a State domestic relations law";
    when order_made_pursuant_to_law_issued_by(order, StateGovernment);
    then order_made_pursuant_to_state_or_tribal_law_414p1Bii(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "is made pursuant to a State or Tribal domestic relations law (including a community property law)")
rule OrderUnderTribalLaw414p1Bii(order: DomesticRelationsOrder) strict {
    label en official "a Tribal domestic relations law";
    when domestic_relations_law_is_tribal_414p1B(order);
    then order_made_pursuant_to_state_or_tribal_law_414p1Bii(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "is made pursuant to a State or Tribal domestic relations law (including a community property law)")
rule OrderUnderCommunityPropertyLaw414p1Bii(order: DomesticRelationsOrder) strict {
    label en official "a community property law is included";
    when order_made_pursuant_to_community_property_law(order);
    then order_made_pursuant_to_state_or_tribal_law_414p1Bii(order);
}

pub relation order_relates_to_family_matter_414p1Bi_holds(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(1)(B)(i): the order relates to child support, alimony payments, or marital property rights to a spouse, former spouse, child, or other dependent of a participant";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "relates to the provision of child support, alimony payments, or marital property rights to a spouse, former spouse, child, or other dependent of a participant")
rule OrderRelatesToFamilyMatter414p1Bi(order: DomesticRelationsOrder, matter: FamilyMatter414p, beneficiary: AlternatePayeeClass414p) strict {
    label en official "any matter for any listed class satisfies clause (i)";
    when order_relates_to_family_matter_414p1Bi(order, matter, beneficiary);
    then order_relates_to_family_matter_414p1Bi_holds(order);
}

pub relation domestic_relations_order_414p1B(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(1)(B): a judgment, decree or order that satisfies both clause (i) and clause (ii)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "The term \"domestic relations order\" means any judgment, decree, or order (including approval of a property settlement agreement) which")
rule DomesticRelationsOrder414p1B(order: DomesticRelationsOrder) strict {
    label en official "(i) and (ii) together";
    when order_relates_to_family_matter_414p1Bi_holds(order)
        and order_made_pursuant_to_state_or_tribal_law_414p1Bii(order);
    then domestic_relations_order_414p1B(order);
}

// =====================================================================
// (2) The order must clearly specify certain facts
// =====================================================================

pub relation order_specifies_participant_identity_414p2A(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies the name and the last known mailing address (if any) of the participant, case-asserted (section 414(p)(2)(A))";
}

pub relation order_specifies_alternate_payee_identity_414p2A(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies the name and mailing address of each alternate payee covered by the order, case-asserted (section 414(p)(2)(A))";
}

pub relation order_specifies_amount_or_manner_414p2B(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies the amount or percentage of the participant's benefits to be paid to each alternate payee, or the manner in which it is determined, case-asserted (section 414(p)(2)(B))";
}

pub relation order_specifies_payments_or_period_414p2C(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies the number of payments or the period to which it applies, case-asserted (section 414(p)(2)(C))";
}

pub relation order_specifies_each_plan_414p2D(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order clearly specifies each plan to which it applies, case-asserted (section 414(p)(2)(D))";
}

pub relation order_clearly_specifies_facts_414p2(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(2): the order clearly specifies all of the facts (A)-(D)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "A domestic relations order meets the requirements of this paragraph only if such order clearly specifies")
rule OrderClearlySpecifiesFacts414p2(order: DomesticRelationsOrder) strict {
    label en official "all four items must hold, the identity item being split for the participant and for each alternate payee";
    when order_specifies_participant_identity_414p2A(order)
        and order_specifies_alternate_payee_identity_414p2A(order)
        and order_specifies_amount_or_manner_414p2B(order)
        and order_specifies_payments_or_period_414p2C(order)
        and order_specifies_each_plan_414p2D(order);
    then order_clearly_specifies_facts_414p2(order);
}

// =====================================================================
// (3) The order may not alter amount, form, etc., of benefits
// =====================================================================

pub relation order_requires_benefit_type_form_or_option_not_provided_414p3A(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order requires the plan to provide a type or form of benefit, or an option, not otherwise provided under the plan, case-asserted (section 414(p)(3)(A) violation fact)";
}

pub relation order_requires_increased_benefits_by_actuarial_value_414p3B(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order requires the plan to provide increased benefits determined on the basis of actuarial value, case-asserted (section 414(p)(3)(B) violation fact)";
}

pub relation order_requires_payment_under_prior_qdro_414p3C(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order requires payment to an alternate payee of benefits that are required to be paid to another alternate payee under another order previously determined to be a qualified domestic relations order, case-asserted (section 414(p)(3)(C) violation fact; not derived from qdro_recognized because a not_known read of a power effect is a late status producer, LDC-E4103)";
}

pub relation order_meets_no_alteration_requirements_414p3(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(3): none of the (A), (B), (C) violations is present (clause (A) subject to the paragraph (4) exception)";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "A domestic relations order meets the requirements of this paragraph only if such order")
rule OrderMeetsNoAlterationRequirements414p3(order: DomesticRelationsOrder) strict {
    label en official "PARTIAL: absence of a violation fact is read as not-known, not as a proved negative; the (4) exception has its own rule";
    when domestic_relations_order_of(order, _, _)
        and not_known(order_requires_benefit_type_form_or_option_not_provided_414p3A(order))
        and not_known(order_requires_increased_benefits_by_actuarial_value_414p3B(order))
        and not_known(order_requires_payment_under_prior_qdro_414p3C(order));
    then order_meets_no_alteration_requirements_414p3(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "A domestic relations order shall not be treated as failing to meet the requirements of subparagraph (A) of paragraph (3) solely because")
rule OrderMeetsNoAlterationByEarliestRetirementAgeException414p4(order: DomesticRelationsOrder) strict {
    label en official "PARTIAL: with the (4)(A) exception the (3)(A) violation is disregarded; (B) and (C) must still be absent";
    when earliest_retirement_age_exception_414p4A(order)
        and domestic_relations_order_of(order, _, _)
        and not_known(order_requires_increased_benefits_by_actuarial_value_414p3B(order))
        and not_known(order_requires_payment_under_prior_qdro_414p3C(order));
    then order_meets_no_alteration_requirements_414p3(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "with respect to which the requirements of paragraphs (2) and (3) are met")
rule QdroRequirements2And3MetDecomposed(order: DomesticRelationsOrder) strict {
    label en official "the decomposed route to the same head as the bundled rule of module 12";
    when order_clearly_specifies_facts_414p2(order) and order_meets_no_alteration_requirements_414p3(order);
    then qdro_requirements_2_and_3_met(order);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "The term \"qualified domestic relations order\" means a domestic relations order")
rule QdroEligibleFromDecomposed414p1(order: DomesticRelationsOrder) strict {
    label en official "a (1)(B) domestic relations order that meets the (2)/(3) requirements, decomposed route";
    when domestic_relations_order_414p1B(order) and qdro_requirements_2_and_3_met(order);
    then qdro_eligible_to_be_recognized(order);
}

// =====================================================================
// (4) Exception for certain payments after the earliest retirement age
// =====================================================================

pub relation order_applies_to_plan_414p(order: DomesticRelationsOrder, plan: Plan) kind empirical {
    label en unofficial "the order applies to this plan, case-asserted (section 414(p)(2)(D))";
}

pub relation participant_entitled_to_distribution_on_414p4Bi(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date on which the participant is entitled to a distribution under the plan, case-asserted (section 414(p)(4)(B)(i))";
}

pub relation participant_attains_age_50_on_414p4BiiI(participant: Person, on: Date) kind empirical {
    label en unofficial "the date the participant attains age 50, case-asserted (section 414(p)(4)(B)(ii)(I); no birth-date-to-age term exists)";
}

pub relation earliest_date_participant_could_begin_receiving_414p4BiiII(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the earliest date on which the participant could begin receiving benefits under the plan if the participant separated from service, case-asserted (section 414(p)(4)(B)(ii)(II))";
}

pub relation entitlement_date_recorded_414p4Bi(participant: Person, plan: Plan) kind institutional {
    label en official "helper: an entitlement date under (4)(B)(i) has been established for the participant";
}

rule EntitlementDateRecorded414p4Bi(participant: Person, plan: Plan, on: Date) strict {
    label en official "helper for the not_known guard: the entitlement date is present";
    when participant_entitled_to_distribution_on_414p4Bi(participant, plan, on);
    then entitlement_date_recorded_414p4Bi(participant, plan);
}

pub relation later_of_age_50_and_earliest_begin_414p4BiiL(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 414(p)(4)(B)(ii): the later of the date the participant attains age 50 and the earliest date benefits could begin after separation";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the earliest date on which the participant could begin receiving benefits under the plan if the participant separated from service")
rule LaterOfAge50AndEarliestBeginAge50Later414p4Bii(participant: Person, plan: Plan, fifty: Date, begin: Date) strict {
    label en official "exact boundary: on equal dates the age-50 date is chosen and equals the other";
    when participant_attains_age_50_on_414p4BiiI(participant, fifty)
        and earliest_date_participant_could_begin_receiving_414p4BiiII(participant, plan, begin)
        and fifty >= begin;
    then later_of_age_50_and_earliest_begin_414p4BiiL(participant, plan, fifty);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the earliest date on which the participant could begin receiving benefits under the plan if the participant separated from service")
rule LaterOfAge50AndEarliestBeginEarliestBeginLater414p4Bii(participant: Person, plan: Plan, fifty: Date, begin: Date) strict {
    label en official "the earliest-begin date is strictly later";
    when participant_attains_age_50_on_414p4BiiI(participant, fifty)
        and earliest_date_participant_could_begin_receiving_414p4BiiII(participant, plan, begin)
        and fifty < begin;
    then later_of_age_50_and_earliest_begin_414p4BiiL(participant, plan, begin);
}

pub relation earliest_retirement_age_date_414p4B(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 414(p)(4)(B): the earliest retirement age is the earlier of the entitlement date and the later-of date";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the date on which the participant is entitled to a distribution under the plan")
rule EarliestRetirementAgeEntitlementFirst414p4B(participant: Person, plan: Plan, entitled: Date, later: Date) strict {
    label en official "the entitlement date is not after the later-of date";
    when participant_entitled_to_distribution_on_414p4Bi(participant, plan, entitled)
        and later_of_age_50_and_earliest_begin_414p4BiiL(participant, plan, later)
        and entitled <= later;
    then earliest_retirement_age_date_414p4B(participant, plan, entitled);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the date on which the participant is entitled to a distribution under the plan")
rule EarliestRetirementAgeLaterOfFirst414p4B(participant: Person, plan: Plan, entitled: Date, later: Date) strict {
    label en official "the later-of date is strictly earlier than the entitlement date";
    when participant_entitled_to_distribution_on_414p4Bi(participant, plan, entitled)
        and later_of_age_50_and_earliest_begin_414p4BiiL(participant, plan, later)
        and later < entitled;
    then earliest_retirement_age_date_414p4B(participant, plan, later);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the date on which the participant is entitled to a distribution under the plan")
rule EarliestRetirementAgeNoEntitlement414p4B(participant: Person, plan: Plan, later: Date) strict {
    label en official "without an entitlement date the later-of date is the only candidate";
    when later_of_age_50_and_earliest_begin_414p4BiiL(participant, plan, later)
        and not_known(entitlement_date_recorded_414p4Bi(participant, plan));
    then earliest_retirement_age_date_414p4B(participant, plan, later);
}

pub relation order_payment_start_before_separation_414p4Ai(order: DomesticRelationsOrder, start: Date) kind empirical {
    label en unofficial "the order requires payment of benefits to the alternate payee beginning on this date, before the participant has separated from service, case-asserted (section 414(p)(4)(A)(i))";
}

pub relation order_values_as_if_retired_on_payment_start_414p4Aii(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "payment is determined as if the participant had retired on the date payment is to begin, taking into account only the present value of benefits actually accrued and not any employer subsidy for early retirement, case-asserted (section 414(p)(4)(A)(ii))";
}

pub relation order_requires_form_available_to_participant_414p4Aiii(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "payment is required in a form in which benefits may be paid to the participant under the plan, case-asserted (section 414(p)(4)(A)(iii))";
}

pub relation order_requires_joint_survivor_form_with_subsequent_spouse_414p4Aiii(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the order requires a joint and survivor annuity with respect to the alternate payee and his or her subsequent spouse, case-asserted (section 414(p)(4)(A)(iii) parenthetical)";
}

pub relation earliest_retirement_age_exception_414p4A(order: DomesticRelationsOrder) kind institutional {
    label en official "section 414(p)(4)(A): the order requires payment before separation at or after the earliest retirement age, valued as if retired, in a form available to the participant (not a joint and survivor annuity with the alternate payee's subsequent spouse)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "in the case of any payment before a participant has separated from service, on or after the date on which the participant attains (or would have attained) the earliest retirement age")
rule EarliestRetirementAgeException414p4A(order: DomesticRelationsOrder, participant: Person, payee: Person, plan: Plan, start: Date, era: Date) strict {
    label en official "exact boundary: payment may begin on the earliest retirement age date itself; (ii) valuation and (iii) form must hold together";
    when domestic_relations_order_of(order, participant, payee)
        and order_applies_to_plan_414p(order, plan)
        and order_payment_start_before_separation_414p4Ai(order, start)
        and earliest_retirement_age_date_414p4B(participant, plan, era)
        and start >= era
        and order_values_as_if_retired_on_payment_start_414p4Aii(order)
        and order_requires_form_available_to_participant_414p4Aiii(order)
        and not_known(order_requires_joint_survivor_form_with_subsequent_spouse_414p4Aiii(order));
    then earliest_retirement_age_exception_414p4A(order);
}

pub relation plan_specified_interest_rate_414p4A(plan: Plan, rate: Decimal) kind empirical {
    label en unofficial "the interest rate specified in the plan for present-value determinations, case-asserted (section 414(p)(4)(A) last sentence)";
}

pub relation plan_specifies_interest_rate_414p4A(plan: Plan) kind institutional {
    label en official "helper: the plan specifies a present-value interest rate";
}

rule PlanSpecifiesInterestRate414p4A(plan: Plan, rate: Decimal) strict {
    label en official "helper for the not_known guard";
    when plan_specified_interest_rate_414p4A(plan, rate);
    then plan_specifies_interest_rate_414p4A(plan);
}

pub relation present_value_interest_rate_414p4A(plan: Plan, rate: Decimal) kind institutional {
    label en official "section 414(p)(4)(A): the interest rate for the present value is the plan's rate or, if none is specified, 5 percent";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the interest rate assumption used in determining the present value shall be the interest rate specified in the plan")
rule PresentValueRateFromPlan414p4A(plan: Plan, rate: Decimal) strict {
    label en official "the plan's specified rate";
    when plan_specified_interest_rate_414p4A(plan, rate);
    then present_value_interest_rate_414p4A(plan, rate);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "or, if no rate is specified, 5 percent")
rule PresentValueRateDefault414p4A(plan: Plan) strict {
    label en official "5 percent when the plan specifies no rate (exact fraction 0.05)";
    when order_applies_to_plan_414p(_, plan) and not_known(plan_specifies_interest_rate_414p4A(plan));
    then present_value_interest_rate_414p4A(plan, 0.05);
}

// =====================================================================
// (5) Former spouse treated as surviving spouse
// =====================================================================

pub relation qdro_provides_former_spouse_survivor_treatment_414p5(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the qualified domestic relations order provides that the former spouse is treated as the surviving spouse for sections 401(a)(11) and 417, case-asserted (\"to the extent provided in any qualified domestic relations order\")";
}

pub relation participant_current_spouse_414p5(participant: Person, spouse: Person) kind empirical {
    label en unofficial "this person is a spouse of the participant other than the former spouse named in the order, case-asserted (section 414(p)(5)(A) parenthetical)";
}

pub relation former_spouse_treated_as_surviving_spouse_414p5A(participant: Person, former_spouse: Person) kind institutional {
    label en official "section 414(p)(5)(A): the former spouse is treated as a surviving spouse of the participant for sections 401(a)(11) and 417";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the former spouse of a participant shall be treated as a surviving spouse of such participant for purposes of sections 401(a)(11) and 417")
rule FormerSpouseTreatedAsSurvivingSpouse414p5A(order: DomesticRelationsOrder, participant: Person, former_spouse: Person) strict {
    label en official "only to the extent the recognized QDRO so provides";
    when qdro_recognized(order, participant, former_spouse)
        and qdro_provides_former_spouse_survivor_treatment_414p5(order)
        and alternate_payee_class_414p8(order, former_spouse, FormerSpouse);
    then former_spouse_treated_as_surviving_spouse_414p5A(participant, former_spouse);
}

pub relation spouse_not_treated_as_spouse_for_survivor_rules_414p5A(participant: Person, spouse: Person) kind institutional {
    label en official "section 414(p)(5)(A) parenthetical: any spouse of the participant is not treated as a spouse for sections 401(a)(11) and 417";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "and any spouse of the participant shall not be treated as a spouse of the participant for such purposes")
rule SpouseNotTreatedAsSpouseWhenFormerSpouseSubstituted414p5A(order: DomesticRelationsOrder, participant: Person, former_spouse: Person, spouse: Person) strict {
    label en official "displacement of the current spouse for survivor-benefit purposes";
    when former_spouse_treated_as_surviving_spouse_414p5A(participant, former_spouse)
        and qdro_recognized(order, participant, former_spouse)
        and participant_current_spouse_414p5(participant, spouse);
    then spouse_not_treated_as_spouse_for_survivor_rules_414p5A(participant, spouse);
}

pub relation marriage_began_on_414p5B(participant: Person, former_spouse: Person, on: Date) kind empirical {
    label en unofficial "the date the participant's marriage to the former spouse began, case-asserted";
}

pub relation marriage_ended_on_414p5B(participant: Person, former_spouse: Person, on: Date) kind empirical {
    label en unofficial "the date the marriage to the former spouse ended, case-asserted";
}

pub relation former_spouse_treated_as_meeting_417d_414p5B(participant: Person, former_spouse: Person) kind institutional {
    label en official "section 414(p)(5)(B): if married for at least 1 year, the surviving former spouse is treated as meeting section 417(d)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "if married for at least 1 year, the surviving former spouse shall be treated as meeting the requirements of section 417(d)")
rule FormerSpouseTreatedAsMeeting417d414p5B(order: DomesticRelationsOrder, participant: Person, former_spouse: Person, began: Date, ended: Date) strict {
    label en official "exact boundary: a marriage of exactly one calendar year qualifies";
    when former_spouse_treated_as_surviving_spouse_414p5A(participant, former_spouse)
        and marriage_began_on_414p5B(participant, former_spouse, began)
        and marriage_ended_on_414p5B(participant, former_spouse, ended)
        and ended >= add_calendar_period(began, 1 calendar_year)
        and qdro_provides_former_spouse_survivor_treatment_414p5(order);
    then former_spouse_treated_as_meeting_417d_414p5B(participant, former_spouse);
}

// =====================================================================
// (6) Plan procedures with respect to orders
// =====================================================================

pub relation order_received_by_plan_on_414p6(order: DomesticRelationsOrder, plan: Plan, on: Date) kind empirical {
    label en unofficial "the plan received the domestic relations order on this date, case-asserted (section 414(p)(6)(A))";
}

pub relation participant_and_payees_notified_of_receipt_414p6Ai(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the plan administrator has notified the participant and each alternate payee of the receipt of the order and of the plan's procedures for determining qualified status, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "the plan administrator shall promptly notify the participant and each alternate payee of the receipt of such order and the plan's procedures for determining the qualified status of domestic relations orders")
rule NoticeOfReceiptDuty414p6Ai(order: DomesticRelationsOrder, plan: Plan, administrator: Person, received: Date) strict {
    label en official "PARTIAL/EVALUATIVE: \"promptly\" is a DECISION-0194 timing judgment; the duty is bounded below by the receipt date only";
    when order_received_by_plan_on_414p6(order, plan, received)
        and plan_administrator_of(plan, administrator);
    then duty NoticeOfReceiptOfOrderDuty {
        bearer administrator;
        goal achievement {
            condition participant_and_payees_notified_of_receipt_414p6Ai(order);
            window [received, infinity];
        }
    };
}

pub relation qdro_status_determined_414p6Aii(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the plan administrator has determined whether the order is a qualified domestic relations order, case-asserted (goal atom)";
}

pub relation determination_notified_to_participant_and_payees_414p6Aii(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the plan administrator has notified the participant and each alternate payee of the determination, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "within a reasonable period after receipt of such order, the plan administrator shall determine whether such order is a qualified domestic relations order")
rule DeterminationDuty414p6Aii(order: DomesticRelationsOrder, plan: Plan, administrator: Person, received: Date) strict {
    label en official "PARTIAL/EVALUATIVE: \"within a reasonable period\" is a DECISION-0194 timing judgment; the duty is bounded below by the receipt date only";
    when order_received_by_plan_on_414p6(order, plan, received)
        and plan_administrator_of(plan, administrator);
    then duty DetermineQdroStatusDuty {
        bearer administrator;
        goal achievement {
            condition qdro_status_determined_414p6Aii(order);
            window [received, infinity];
        }
    };
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "and notify the participant and each alternate payee of such determination")
rule DeterminationNoticeDuty414p6Aii(order: DomesticRelationsOrder, plan: Plan, administrator: Person, received: Date) strict {
    label en official "PARTIAL/EVALUATIVE: the notice follows the determination within the same reasonable period";
    when order_received_by_plan_on_414p6(order, plan, received)
        and plan_administrator_of(plan, administrator)
        and qdro_status_determined_414p6Aii(order);
    then duty NotifyQdroDeterminationDuty {
        bearer administrator;
        goal achievement {
            condition determination_notified_to_participant_and_payees_414p6Aii(order);
            window [received, infinity];
        }
    };
}

pub relation plan_has_reasonable_qdro_procedures_414p6B(plan: Plan) kind empirical {
    label en unofficial "the plan has established reasonable procedures to determine the qualified status of domestic relations orders and to administer distributions under qualified orders, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "Each plan shall establish reasonable procedures to determine the qualified status of domestic relations orders and to administer distributions under such qualified orders")
rule QdroProceduresDuty414p6B(plan: Plan, administrator: Person) strict {
    label en official "PARTIAL/EVALUATIVE: \"reasonable\" procedures are a judgment; the plan administrator bears the maintenance duty on behalf of the plan";
    when plan_administrator_of(plan, administrator);
    then duty EstablishQdroProceduresDuty {
        bearer administrator;
        goal maintenance {
            condition plan_has_reasonable_qdro_procedures_414p6B(plan);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// (7) Segregation and payment while the status is being determined
// =====================================================================

pub relation qdro_status_under_determination_414p7A(order: DomesticRelationsOrder, plan: Plan) kind empirical {
    label en unofficial "the issue whether the order is a qualified domestic relations order is being determined, by the plan administrator, a court of competent jurisdiction, or otherwise, case-asserted (section 414(p)(7)(A))";
}

pub relation segregated_amounts_separately_accounted_414p7A(order: DomesticRelationsOrder, plan: Plan) kind empirical {
    label en unofficial "the plan administrator separately accounts for the amounts that would have been payable to the alternate payee had the order been determined to be qualified, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the plan administrator shall separately account for the amounts (hereinafter in this paragraph referred to as the \"segregated amounts\") which would have been payable to the alternate payee during such period")
rule SegregationDuty414p7A(order: DomesticRelationsOrder, plan: Plan, administrator: Person) strict {
    label en official "while the qualified status is being determined the segregated amounts are separately accounted for";
    when qdro_status_under_determination_414p7A(order, plan)
        and plan_administrator_of(plan, administrator);
    then duty SegregateAmountsDuty {
        bearer administrator;
        goal maintenance {
            condition segregated_amounts_separately_accounted_414p7A(order, plan);
            window [-infinity, infinity];
        }
    };
}

pub relation qdro_determined_qualified_on_414p7B(order: DomesticRelationsOrder, on: Date) kind empirical {
    label en unofficial "the date the order (or a modification of it) is determined to be a qualified domestic relations order, case-asserted (section 414(p)(7)(B))";
}

pub relation qdro_determined_not_qualified_on_414p7Ci(order: DomesticRelationsOrder, on: Date) kind empirical {
    label en unofficial "the date it is determined that the order is not a qualified domestic relations order, case-asserted (section 414(p)(7)(C)(i))";
}

pub relation qdro_issue_resolved_414p7(order: DomesticRelationsOrder) kind institutional {
    label en official "helper: the qualified status of the order has been determined either way";
}

rule QdroIssueResolvedQualified414p7(order: DomesticRelationsOrder, on: Date) strict {
    label en official "resolved as qualified";
    when qdro_determined_qualified_on_414p7B(order, on);
    then qdro_issue_resolved_414p7(order);
}

rule QdroIssueResolvedNotQualified414p7(order: DomesticRelationsOrder, on: Date) strict {
    label en official "resolved as not qualified";
    when qdro_determined_not_qualified_on_414p7Ci(order, on);
    then qdro_issue_resolved_414p7(order);
}

pub relation segregated_amounts_paid_to_persons_entitled_under_order_414p7B(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the plan administrator has paid the segregated amounts, including interest, to the person or persons entitled thereto, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "If within the 18-month period described in subparagraph (E) the order (or modification thereof) is determined to be a qualified domestic relations order, the plan administrator shall pay the segregated amounts (including any interest thereon) to the person or persons entitled thereto")
rule PaySegregatedAmountsWhenQualified414p7B(order: DomesticRelationsOrder, plan: Plan, administrator: Person, first: Date, determined: Date) strict {
    label en official "exact boundary: a determination on the last day of the 18-month period is still within it";
    when qdro_status_under_determination_414p7A(order, plan)
        and plan_administrator_of(plan, administrator)
        and first_payment_required_under_order_on(order, first)
        and qdro_determined_qualified_on_414p7B(order, determined)
        and determined <= add_calendar_period(first, 18 calendar_month);
    then duty PaySegregatedAmountsToPayeeDuty {
        bearer administrator;
        goal achievement {
            condition segregated_amounts_paid_to_persons_entitled_under_order_414p7B(order);
            window [determined, infinity];
        }
    };
}

pub relation segregated_amounts_paid_as_if_no_order_414p7C(order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the plan administrator has paid the segregated amounts, including interest, to the person or persons who would have been entitled had there been no order, case-asserted (goal atom)";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "it is determined that the order is not a qualified domestic relations order")
rule PaySegregatedAmountsWhenNotQualified414p7Ci(order: DomesticRelationsOrder, plan: Plan, administrator: Person, first: Date, determined: Date) strict {
    label en official "exact boundary: a not-qualified determination on the last day of the 18-month period is within it";
    when qdro_status_under_determination_414p7A(order, plan)
        and plan_administrator_of(plan, administrator)
        and first_payment_required_under_order_on(order, first)
        and qdro_determined_not_qualified_on_414p7Ci(order, determined)
        and determined <= add_calendar_period(first, 18 calendar_month);
    then duty PaySegregatedAmountsToParticipantDuty {
        bearer administrator;
        goal achievement {
            condition segregated_amounts_paid_as_if_no_order_414p7C(order);
            window [determined, infinity];
        }
    };
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "the issue as to whether such order is a qualified domestic relations order is not resolved")
rule PaySegregatedAmountsWhenUnresolved414p7Cii(order: DomesticRelationsOrder, plan: Plan, administrator: Person, first: Date) strict {
    label en official "the payment obligation begins when the 18-month period closes without a resolution";
    when qdro_status_under_determination_414p7A(order, plan)
        and plan_administrator_of(plan, administrator)
        and first_payment_required_under_order_on(order, first)
        and not_known(qdro_issue_resolved_414p7(order));
    then duty PaySegregatedAmountsUnresolvedDuty {
        bearer administrator;
        goal achievement {
            condition segregated_amounts_paid_as_if_no_order_414p7C(order);
            window [add_calendar_period(first, 18 calendar_month), infinity];
        }
    };
}

// =====================================================================
// (8) Alternate payee
// =====================================================================

pub relation person_of_class_recognized_by_order_414p8(order: DomesticRelationsOrder, payee: Person, class: AlternatePayeeClass414p) kind empirical {
    label en unofficial "this person is a spouse, former spouse, child or other dependent of the participant recognized by the order as having a right to benefits, case-asserted";
}

pub relation alternate_payee_class_414p8(order: DomesticRelationsOrder, payee: Person, class: AlternatePayeeClass414p) kind institutional {
    label en official "section 414(p)(8): the alternate payee and the class (spouse, former spouse, child, other dependent) in which the order recognizes the payee";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "The term \"alternate payee\" means any spouse, former spouse, child or other dependent of a participant who is recognized by a domestic relations order as having a right to receive all, or a portion of, the benefits payable under a plan with respect to such participant")
rule AlternatePayeeClass414p8(order: DomesticRelationsOrder, participant: Person, payee: Person, class: AlternatePayeeClass414p) strict {
    label en official "a listed class of person that the order recognizes as having a right to the benefits";
    when domestic_relations_order_of(order, participant, payee)
        and person_of_class_recognized_by_order_414p8(order, payee, class);
    then alternate_payee_class_414p8(order, payee, class);
}

// =====================================================================
// (9)-(12) Scope, waiver of distribution restrictions, other plans
// =====================================================================

pub relation plan_excluded_from_401a13_414p9(plan: Plan) kind empirical {
    label en unofficial "section 401(a)(13) does not apply to this plan, case-asserted (section 414(p)(9))";
}

pub relation qdro_subsection_inapplicable_414p9(order: DomesticRelationsOrder, plan: Plan) kind institutional {
    label en official "section 414(p)(9): the subsection does not apply to a plan to which section 401(a)(13) does not apply";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any plan to which section 401(a)(13) does not apply")
rule QdroSubsectionInapplicable414p9(order: DomesticRelationsOrder, plan: Plan) strict {
    label en official "the order concerns a plan outside section 401(a)(13)";
    when order_applies_to_plan_414p(order, plan) and plan_excluded_from_401a13_414p9(plan);
    then qdro_subsection_inapplicable_414p9(order, plan);
}

pub relation distribution_from_403b_annuity_under_qdro_414p9(d: Distribution) kind empirical {
    label en unofficial "the distribution is from an annuity contract under section 403(b) and is made pursuant to a qualified domestic relations order, case-asserted (section 414(p)(9) last sentence)";
}

pub relation distribution_treated_as_from_401a13_plan_414p9(d: Distribution) kind institutional {
    label en official "section 414(p)(9): a section 403(b) annuity distribution under a QDRO is treated in the same manner as a distribution from a plan to which section 401(a)(13) applies (except as provided in regulations)";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "any distribution from an annuity contract under section 403(b) pursuant to a qualified domestic relations order shall be treated in the same manner as a distribution from a plan to which section 401(a)(13) applies")
rule Distribution403bUnderQdroTreatedAs401a13Plan414p9(d: Distribution) defeasible {
    label en official "PARTIAL: the regulatory exception is not pinned, so the rule is defeasible";
    when distribution_from_403b_annuity_under_qdro_414p9(d);
    then distribution_treated_as_from_401a13_plan_414p9(d);
}

pub relation qdro_payment_to_alternate_payee_414p10(plan: Plan, order: DomesticRelationsOrder) kind empirical {
    label en unofficial "a payment is made to an alternate payee pursuant to a qualified domestic relations order under the plan, case-asserted (section 414(p)(10))";
}

pub relation plan_not_failing_distribution_requirements_by_qdro_payment_414p10(plan: Plan) kind institutional {
    label en official "section 414(p)(10): the plan is not treated as failing the requirements of section 401(a) and (k), 403(b), 409(d) and 457(d) solely by reason of payments to an alternate payee under a QDRO";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "a plan shall not be treated as failing to meet such requirements solely by reason of payments to an alternative payee pursuant to a qualified domestic relations order")
rule QdroPaymentDoesNotViolateDistributionRestrictions414p10(plan: Plan, order: DomesticRelationsOrder, participant: Person, payee: Person) strict {
    label en official "one relation covers the listed requirements: sections 401(a), 401(k), 403(b), 409(d) and 457(d)";
    when qdro_payment_to_alternate_payee_414p10(plan, order)
        and qdro_recognized(order, participant, payee);
    then plan_not_failing_distribution_requirements_by_qdro_payment_414p10(plan);
}

pub relation distribution_pursuant_to_order_414p11(d: Distribution, order: DomesticRelationsOrder) kind empirical {
    label en unofficial "the distribution or payment is made pursuant to this domestic relations order, case-asserted (section 414(p)(11))";
}

pub relation plan_eligible_deferred_compensation_457b_414p11(plan: Plan) kind empirical {
    label en unofficial "the plan is an eligible deferred compensation plan within the meaning of section 457(b), case-asserted";
}

pub relation distribution_treated_as_pursuant_to_qdro_414p11(d: Distribution) kind institutional {
    label en official "section 414(p)(11): a distribution from a governmental plan, church plan or section 457(b) plan under an order meeting clause (i) of paragraph (1)(A) is treated as made pursuant to a QDRO";
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "shall be treated as made pursuant to a qualified domestic relations order if it is made pursuant to a domestic relations order which meets the requirement of clause (i) of paragraph (1)(A)")
rule GovernmentalPlanDistributionTreatedAsQdro414p11(d: Distribution, plan: Plan, order: DomesticRelationsOrder, participant: Person, payee: Person) strict {
    label en official "governmental plan (414(d)); the order need meet only (1)(A)(i), the recognition of the alternate payee's right";
    when distribution(d, plan, _, _, _)
        and governmental_plan_414d(plan)
        and distribution_pursuant_to_order_414p11(d, order)
        and domestic_relations_order_of(order, participant, payee);
    then distribution_treated_as_pursuant_to_qdro_414p11(d);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "shall be treated as made pursuant to a qualified domestic relations order if it is made pursuant to a domestic relations order which meets the requirement of clause (i) of paragraph (1)(A)")
rule ChurchPlanDistributionTreatedAsQdro414p11(d: Distribution, plan: Plan, order: DomesticRelationsOrder, participant: Person, payee: Person) strict {
    label en official "church plan (414(e))";
    when distribution(d, plan, _, _, _)
        and church_plan_414e(plan)
        and distribution_pursuant_to_order_414p11(d, order)
        and domestic_relations_order_of(order, participant, payee);
    then distribution_treated_as_pursuant_to_qdro_414p11(d);
}

@source(IRC_S414_P, relation = formalizes, coverage = exact, quote = "shall be treated as made pursuant to a qualified domestic relations order if it is made pursuant to a domestic relations order which meets the requirement of clause (i) of paragraph (1)(A)")
rule Plan457bDistributionTreatedAsQdro414p11(d: Distribution, plan: Plan, order: DomesticRelationsOrder, participant: Person, payee: Person) strict {
    label en official "eligible deferred compensation plan within the meaning of section 457(b)";
    when distribution(d, plan, _, _, _)
        and plan_eligible_deferred_compensation_457b_414p11(plan)
        and distribution_pursuant_to_order_414p11(d, order)
        and domestic_relations_order_of(order, participant, payee);
    then distribution_treated_as_pursuant_to_qdro_414p11(d);
}

pub relation distribution_from_457b_plan_under_qdro_414p12(d: Distribution, alternate_payee: Person, participant: Person) kind empirical {
    label en unofficial "the distribution or payment from a section 457(b) plan to this alternate payee is made pursuant to a qualified domestic relations order, case-asserted (section 414(p)(12))";
}

@source(IRC_S414_P, relation = formalizes, coverage = partial, quote = "rules similar to the rules of section 402(e)(1)(A) shall apply to such distribution or payment")
rule Plan457bQdroPaymentAlternatePayeeDistributee414p12(d: Distribution, alternate_payee: Person, participant: Person, order: DomesticRelationsOrder, class: AlternatePayeeClass414p) defeasible {
    label en official "PARTIAL: read as the section 402(e)(1)(A) rule for a spouse or former spouse alternate payee; a child or dependent is not covered by that rule";
    when distribution_from_457b_plan_under_qdro_414p12(d, alternate_payee, participant)
        and alternate_payee_class_414p8(order, alternate_payee, class)
        and class != Child
        and class != OtherDependent;
    then alternate_payee_treated_as_distributee_402e1(d, alternate_payee);
}
