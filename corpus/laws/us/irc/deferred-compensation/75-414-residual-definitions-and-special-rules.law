// Section 414 residuals — STAGE 3b (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): (b)(2)-(3), (c)(2)(C)-(D), (e)(3)-(5) church plans, (f)(2),
// (k), (l)(2) spin-offs, (q)(1),(2),(4),(5),(7)-(9), (r), (s), (t), (v)(2)(D)
// - (7) catch-up, (w) permissible withdrawals, (y), (z) church transfers,
// (aa) overpayments, (bb) unenrolled participants, (cc) corrected errors.
//
// Pattern (modules 12/28/55/56): each statutory sentence is a conjunction of
// case-asserted facts producing a treatment relation; percentages and dollar
// limits are exact; the Secretary's regulations and election forms are
// external. Dated SECURE 2.0 provisions ((v) 2025 catch-up amounts, (bb),
// (cc)) apply for the years the statute states; pre-amendment text is not
// pinned (G4601).

// =====================================================================
// (b)(2), (c)(2)
// =====================================================================

use self::{
    ApplicablePeriodEvent417a3Bii,
    CollectibleKind408m,
    DistributionKind402Ad2C,
    ElectiveDeferralKind402Af2,
    IRC_S414_AA,
    IRC_S414_B,
    IRC_S414_BB,
    IRC_S414_C,
    IRC_S414_CC,
    IRC_S414_E,
    IRC_S414_F,
    IRC_S414_K,
    IRC_S414_L,
    IRC_S414_Q,
    IRC_S414_R,
    IRC_S414_S,
    IRC_S414_T,
    IRC_S414_V,
    IRC_S414_W,
    IRC_S414_Y,
    IRC_S414_Z,
    LifetimeIncomeDistributionForm403b7,
    MatchingContributionKind402Af3,
    MaternityAbsenceReason410a5E,
    Person,
    Plan,
    PlanKind413,
    PlanKind415k1,
    QualifiedEmployerPlanKind408q3A,
    SecurityRegistrationClass409e4,
    SimpleRetirementAccount,
    TaxableYear,
};

pub relation controlled_group_ownership_community_property_414b2A(person: Person, corp: Person, percent: Decimal) kind empirical {
    label en unofficial "ownership determined with community property laws disregarded, case-asserted";
}

pub relation ownership_for_controlled_group_414b2A(person: Person, corp: Person, percent: Decimal) kind institutional {
    label en official "section 414(b)(2)(A): community property laws are disregarded in determining ownership";
}

@source(IRC_S414_B, relation = formalizes, coverage = exact, quote = "Community property laws shall be disregarded for purposes of determining ownership.")
rule OwnershipForControlledGroup414b2A(person: Person, corp: Person, percent: Decimal) strict {
    label en official "the case-asserted ownership without community property";
    when controlled_group_ownership_community_property_414b2A(person, corp, percent);
    then ownership_for_controlled_group_414b2A(person, corp, percent);
}

pub relation stock_attribution_to_spouse_by_combined_1563e_414b2B(individual: Person, spouse: Person) kind empirical {
    label en unofficial "stock of the individual not attributed to the spouse under section 1563(e)(5) would be attributed to the spouse only by the combined application of section 1563(e)(1) and (6)(A) (through a child), case-asserted";
}

pub relation individual_stock_attributed_to_spouse_1563e5_414b2B(individual: Person, spouse: Person) kind empirical {
    label en unofficial "the individual's stock is attributed to the spouse under section 1563(e)(5), case-asserted";
}

pub relation combined_attribution_to_spouse_disregarded_414b2B(individual: Person, spouse: Person) kind institutional {
    label en official "section 414(b)(2)(B): stock not attributed to the spouse under 1563(e)(5) is not attributed by the combined application of (e)(1) and (e)(6)(A) (except as the Secretary provides)";
}

@source(IRC_S414_B, relation = formalizes, coverage = partial, quote = "stock of an individual not attributed under section 1563(e)(5) to such individual's spouse shall not be attributed to such spouse by reason of the combined application of paragraphs (1) and (6)(A) of section 1563(e)")
rule CombinedAttributionToSpouseDisregarded414b2B(individual: Person, spouse: Person) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when stock_attribution_to_spouse_by_combined_1563e_414b2B(individual, spouse)
        and not_known(individual_stock_attributed_to_spouse_1563e5_414b2B(individual, spouse));
    then combined_attribution_to_spouse_disregarded_414b2B(individual, spouse);
}

pub relation child_attribution_from_each_parent_414b2C(corp_a: Person, corp_b: Person, child: Person) kind empirical {
    label en unofficial "stock in different corporations is attributed to the child under section 1563(e)(6)(A) from each parent and is not attributed to the parents as spouses under (e)(5), case-asserted";
}

pub relation child_attribution_alone_does_not_group_414b2C(corp_a: Person, corp_b: Person) kind institutional {
    label en official "section 414(b)(2)(C): the attribution to the child does not by itself make the corporations members of the same controlled group";
}

@source(IRC_S414_B, relation = formalizes, coverage = partial, quote = "such attribution to the child shall not by itself result in such corporations being members of the same controlled group")
rule ChildAttributionAloneDoesNotGroup414b2C(a: Person, b: Person, child: Person) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when child_attribution_from_each_parent_414b2C(a, b, child);
    then child_attribution_alone_does_not_group_414b2C(a, b);
}

pub relation church_organizations_election_to_aggregate_414c2C(church: Person, plan_year: TaxableYear) kind empirical {
    label en unofficial "the church (or convention or association of churches, or its designee) elects to treat the associated organizations as a single employer, case-asserted";
}

pub relation election_revoked_with_notice_414c2C(church: Person, plan_year: TaxableYear) kind empirical {
    label en unofficial "the election is revoked with notice to the Secretary, case-asserted";
}

pub relation church_aggregation_in_effect_414c2C(church: Person, plan_year: TaxableYear) kind institutional {
    label en official "section 414(c)(2)(C): the election applies to all succeeding plan years unless revoked with notice";
}

@source(IRC_S414_C, relation = formalizes, coverage = exact, quote = "Such election, once made, shall apply to all succeeding plan years unless revoked with notice provided to the Secretary in such manner as the Secretary shall prescribe.")
rule ChurchAggregationInEffect414c2C(church: Person, y: TaxableYear) strict {
    label en official "election made and not revoked";
    when church_organizations_election_to_aggregate_414c2C(church, y)
        and not_known(election_revoked_with_notice_414c2C(church, y));
    then church_aggregation_in_effect_414c2C(church, y);
}

pub relation church_plan_employer_election_to_disaggregate_414c2D(employer: Person, plan_year: TaxableYear) kind empirical {
    label en unofficial "in the case of a church plan the employer elects to treat churches separately from entities that are not churches, case-asserted";
}

pub relation church_disaggregation_in_effect_414c2D(employer: Person, plan_year: TaxableYear) kind institutional {
    label en official "section 414(c)(2)(D): the election applies to all succeeding plan years unless revoked with notice";
}

@source(IRC_S414_C, relation = formalizes, coverage = exact, quote = "an employer may elect to treat churches (as defined in section 403(b)(12)(B)) separately from entities that are not churches")
rule ChurchDisaggregationInEffect414c2D(employer: Person, y: TaxableYear) strict {
    label en official "election made and not revoked (the revocation fact of (C) is reused)";
    when church_plan_employer_election_to_disaggregate_414c2D(employer, y)
        and not_known(election_revoked_with_notice_414c2C(employer, y));
    then church_disaggregation_in_effect_414c2D(employer, y);
}

// =====================================================================
// (e) Church plans
// =====================================================================

pub enum ChurchEmployeeKind414e3B {
    OrdainedMinister;
    ExemptChurchAssociatedOrganizationEmployee;
    SeparatedEmployeeIncludedUnderE;
    Other;
}

pub relation church_employee_kind_414e3B(person: Person, kind: ChurchEmployeeKind414e3B) kind empirical {
    label en unofficial "the kind of person in relation to a church, case-asserted";
}

pub relation employee_of_church_414e3B(person: Person) kind institutional {
    label en official "section 414(e)(3)(B): a minister in the exercise of his ministry, an employee of an exempt organization controlled by or associated with a church, or an individual described in subparagraph (E)";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "a duly ordained, commissioned, or licensed minister of a church in the exercise of his ministry, regardless of the source of his compensation")
rule EmployeeOfChurchMinister414e3B(person: Person) strict {
    label en official "(i) a minister";
    when church_employee_kind_414e3B(person, OrdainedMinister);
    then employee_of_church_414e3B(person);
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "an employee of an organization, whether a civil law corporation or otherwise, which is exempt from tax under section 501 and which is controlled by or associated with a church")
rule EmployeeOfChurchAssociatedOrganization414e3B(person: Person) strict {
    label en official "(ii) an organization employee";
    when church_employee_kind_414e3B(person, ExemptChurchAssociatedOrganizationEmployee);
    then employee_of_church_414e3B(person);
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "an individual described in subparagraph (E)")
rule EmployeeOfChurchSeparated414e3B(person: Person) strict {
    label en official "(iii) an individual described in (E)";
    when church_employee_kind_414e3B(person, SeparatedEmployeeIncludedUnderE);
    then employee_of_church_414e3B(person);
}

pub relation church_deemed_employer_of_individual_414e3C(church: Person, person: Person) kind institutional {
    label en official "section 414(e)(3)(C): an exempt church is deemed the employer of an individual included as an employee under subparagraph (B)";
}

pub relation church_exempt_under_501_414e3C(church: Person) kind empirical {
    label en unofficial "the church or convention or association of churches is exempt from tax under section 501, case-asserted";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "shall be deemed the employer of any individual included as an employee under subparagraph (B)")
rule ChurchDeemedEmployerOfIndividual414e3C(church: Person, person: Person) strict {
    label en official "exempt church and an included employee";
    when church_exempt_under_501_414e3C(church)
        and employee_of_church_414e3B(person);
    then church_deemed_employer_of_individual_414e3C(church, person);
}

pub relation shares_common_religious_bonds_414e3D(org: Person, church: Person) kind empirical {
    label en unofficial "the organization shares common religious bonds and convictions with the church or convention or association of churches, case-asserted";
}

pub relation associated_with_church_414e3D(org: Person, church: Person) kind institutional {
    label en official "section 414(e)(3)(D): an organization is associated with a church if it shares common religious bonds and convictions";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "if it shares common religious bonds and convictions with that church or convention or association of churches")
rule AssociatedWithChurch414e3D(org: Person, church: Person) strict {
    label en official "common religious bonds";
    when shares_common_religious_bonds_414e3D(org, church);
    then associated_with_church_414e3D(org, church);
}

pub relation church_plan_employee_separated_from_service_414e3E(employee: Person, plan: Plan) kind empirical {
    label en unofficial "an employee included in a church plan separates from the service of a church or an organization described in (3)(B)(ii), case-asserted";
}

pub relation plan_retains_accrued_benefit_414e3Ei(plan: Plan) kind empirical {
    label en unofficial "the plan retains the employee's accrued benefit or account for payment of benefits, case-asserted";
}

pub relation contributions_after_separation_years_414e3Eii(employee: Person, plan: Plan, years_after: Integer, disabled: Boolean) kind empirical {
    label en unofficial "the plan receives contributions on the employee's behalf after separation, the years after separation, and whether the employee is disabled, case-asserted";
}

pub relation church_plan_meets_separation_rules_414e3E(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(e)(3)(E): a church plan does not fail because it retains the accrued benefit or receives contributions for the employee for 5 years after separation (or longer if the employee is disabled)";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "retains the employee's accrued benefit or account for the payment of benefits to the employee or his beneficiaries pursuant to the terms of the plan")
rule ChurchPlanMeetsSeparationRulesRetain414e3E(employee: Person, plan: Plan) strict {
    label en official "clause (i)";
    when church_plan_employee_separated_from_service_414e3E(employee, plan)
        and plan_retains_accrued_benefit_414e3Ei(plan);
    then church_plan_meets_separation_rules_414e3E(employee, plan);
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "but only for a period of 5 years after such separation, unless the employee is disabled")
rule ChurchPlanMeetsSeparationRulesContributions414e3E(employee: Person, plan: Plan, years: Integer) strict {
    label en official "clause (ii): exact boundary: 5 years are inside, 6 outside";
    when church_plan_employee_separated_from_service_414e3E(employee, plan)
        and contributions_after_separation_years_414e3Eii(employee, plan, years, false)
        and years <= 5;
    then church_plan_meets_separation_rules_414e3E(employee, plan);
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "unless the employee is disabled")
rule ChurchPlanMeetsSeparationRulesContributionsDisabled414e3E(employee: Person, plan: Plan, years: Integer) strict {
    label en official "clause (ii): a disabled employee has no 5-year limit";
    when church_plan_employee_separated_from_service_414e3E(employee, plan)
        and contributions_after_separation_years_414e3Eii(employee, plan, years, true);
    then church_plan_meets_separation_rules_414e3E(employee, plan);
}

pub enum MinisterEmploymentKind414e5Ai {
    SelfEmployed;
    EmployedByNon501c3Sharing;
    Other;
}

pub relation minister_employment_kind_414e5A(person: Person, kind: MinisterEmploymentKind414e5Ai) kind empirical {
    label en unofficial "in connection with the exercise of ministry, the minister is self-employed (section 401(c)(1)(B)) or employed by an organization other than a section 501(c)(3) organization with which the minister shares common religious bonds, case-asserted";
}

pub relation minister_described_in_414e3B_by_5Ai(person: Person) kind institutional {
    label en official "section 414(e)(5)(A)(i): a minister is described in paragraph (3)(B) if self-employed or employed by an organization other than a 501(c)(3) organization sharing common religious bonds";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "is a self-employed individual (within the meaning of section 401(c)(1)(B)")
rule MinisterDescribedSelfEmployed414e5Ai(person: Person) strict {
    label en official "(I)";
    when minister_employment_kind_414e5A(person, SelfEmployed);
    then minister_described_in_414e3B_by_5Ai(person);
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "is employed by an organization other than an organization which is described in section 501(c)(3)")
rule MinisterDescribedEmployed414e5Ai(person: Person) strict {
    label en official "(II)";
    when minister_employment_kind_414e5A(person, EmployedByNon501c3Sharing);
    then minister_described_in_414e3B_by_5Ai(person);
}

pub relation minister_treated_as_employed_by_501c3_414e5Aii(person: Person) kind institutional {
    label en official "section 414(e)(5)(A)(ii): for sections 403(b)(1)(A) and 404(a)(10), a self-employed minister is treated as employed by the minister's own exempt organization";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "a minister described in clause (i)(I) shall be treated as employed by the minister's own employer which is an organization described in section 501(c)(3)")
rule MinisterTreatedAsEmployedBy501c3414e5Aii(person: Person) strict {
    label en official "self-employed minister";
    when minister_employment_kind_414e5A(person, SelfEmployed);
    then minister_treated_as_employed_by_501c3_414e5Aii(person);
}

pub relation minister_earned_income_414e5B(person: Person, y: TaxableYear, earned: Money) kind empirical {
    label en unofficial "the self-employed minister's earned income (section 401(c)(2)) from the ministry, case-asserted";
}

pub relation minister_includible_compensation_414e5Bi(person: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(e)(5)(B)(i): a self-employed minister's includible compensation under section 403(b)(3) is the earned income from the ministry";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "the minister's includible compensation under section 403(b)(3) shall be determined by reference to the minister's earned income")
rule MinisterIncludibleCompensation414e5Bi(person: Person, y: TaxableYear, earned: Money) strict {
    label en official "earned income";
    when minister_employment_kind_414e5A(person, SelfEmployed)
        and minister_earned_income_414e5B(person, y, earned);
    then minister_includible_compensation_414e5Bi(person, y, earned);
}

pub relation minister_excluded_by_employer_election_414e5C(employer: Person, minister: Person) kind empirical {
    label en unofficial "the employer not otherwise participating in the church plan excludes the minister from being treated as its employee for the plan, case-asserted";
}

pub relation compensation_double_counted_in_church_plan_414e5D(person: Person, compensation: Money, other_plan: Boolean) kind empirical {
    label en unofficial "compensation used for a church plan is also proposed to be used for another plan, case-asserted";
}

pub relation compensation_not_taken_into_account_again_414e5D(person: Person, compensation: Money) kind institutional {
    label en official "section 414(e)(5)(D): compensation counted for a church plan is not also counted for another plan (with the further conditions of the paragraph)";
}

@source(IRC_S414_E, relation = formalizes, coverage = partial, quote = "such compensation shall not also be taken into account in determining the amount of any contributions made to, or benefits to be provided under, any other stock bonus, pension, profit-sharing, or annuity plan")
rule CompensationNotTakenIntoAccountAgain414e5D(person: Person, comp: Money) strict {
    label en official "PARTIAL: the further conditions of the paragraph (the plan being of the same employer) are one case fact";
    when compensation_double_counted_in_church_plan_414e5D(person, comp, true);
    then compensation_not_taken_into_account_again_414e5D(person, comp);
}

pub relation minister_contribution_amount_414e5E(minister: Person, amount: Money, excludable_if_church_employee: Money) kind empirical {
    label en unofficial "a contribution to a church plan on behalf of a minister described in (A)(i)(II), and the part that would be excludable if the minister were a church employee, case-asserted";
}

pub relation minister_contribution_excluded_from_income_414e5E(minister: Person, amount: Money) kind institutional {
    label en official "section 414(e)(5)(E): the contribution is not included in gross income to the extent it would not be for a church employee";
}

@source(IRC_S414_E, relation = formalizes, coverage = exact, quote = "such contribution shall not be included in the gross income of the minister to the extent that such contribution would not be so included if the minister was an employee of a church")
rule MinisterContributionExcludedFromIncome414e5E(minister: Person, amount: Money, excludable: Money) strict {
    label en official "min(contribution, the excludable part)";
    when minister_contribution_amount_414e5E(minister, amount, excludable);
    then minister_contribution_excluded_from_income_414e5E(minister, min(amount, excludable));
}

// =====================================================================
// (f)(2), (k)
// =====================================================================

pub relation trades_under_common_control_414f2(a: Person, b: Person) kind empirical {
    label en unofficial "the trades or businesses (whether or not incorporated) are under common control within the meaning of subsection (c), case-asserted";
}

pub relation single_employer_for_multiemployer_definition_414f2(a: Person, b: Person) kind institutional {
    label en official "section 414(f)(2): all trades or businesses under common control are considered a single employer";
}

@source(IRC_S414_F, relation = formalizes, coverage = exact, quote = "all trades or businesses (whether or not incorporated) which are under common control within the meaning of subsection (c) are considered a single employer")
rule SingleEmployerForMultiemployerDefinition414f2(a: Person, b: Person) strict {
    label en official "common control";
    when trades_under_common_control_414f2(a, b);
    then single_employer_for_multiemployer_definition_414f2(a, b);
}

pub relation defined_benefit_plan_with_employee_contribution_account_414k(plan: Plan) kind empirical {
    label en unofficial "a defined benefit plan provides for an individual account and the plan treats it as a defined contribution plan for the listed purposes (sections 72(d), 411(a)(7)(A), 415, 401(m)), case-asserted";
}

pub relation account_treated_as_dc_plan_for_listed_sections_414k(plan: Plan) kind institutional {
    label en official "section 414(k)(2): for sections 72(d), 411(a)(7)(A), 415 and 401(m) the individual account portion is treated as a defined contribution plan";
}

@source(IRC_S414_K, relation = formalizes, coverage = partial, quote = "for purposes of sections 72(d) (relating to treatment of employee contributions as separate contract), 411(a)(7)(A) (relating to minimum vesting standards), 415 (relating to limitations on benefits and contributions under qualified plans), and 401(m)")
rule AccountTreatedAsDcPlanForListedSections414k(plan: Plan) strict {
    label en official "PARTIAL: the text of the treatment clause is cut in the fragment (the (1) clause is module 12)";
    when defined_benefit_plan_with_employee_contribution_account_414k(plan);
    then account_treated_as_dc_plan_for_listed_sections_414k(plan);
}

// =====================================================================
// (l)(2) Spin-offs
// =====================================================================

pub relation spin_off_original_plan_assets_fmv_414l2C(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the fair market value of the assets of the original plan immediately before the spin-off, case-asserted";
}

pub relation spin_off_assets_required_after_all_plans_414l2Cii(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount of assets required to be allocated after the spin-off to all plans, determined without regard to the paragraph, case-asserted";
}

pub relation spin_off_excess_assets_414l2C(plan: Plan, amount: Money) kind institutional {
    label en official "section 414(l)(2)(C): the excess, if any, of the fair market value of the original plan's assets over the assets required to be allocated to all plans";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "the term \"excess assets\" means an amount equal to the excess (if any) of")
rule SpinOffExcessAssets414l2C(plan: Plan, fmv: Money, required: Money) strict {
    label en official "max(0, fmv - required)";
    when spin_off_original_plan_assets_fmv_414l2C(plan, fmv)
        and spin_off_assets_required_after_all_plans_414l2Cii(plan, required);
    then spin_off_excess_assets_414l2C(plan, max(0 USD, fmv - required));
}

pub relation spin_off_plan_liability_measure_414l2Bi(plan: Plan, funding_target_plus_normal_cost: Money, assets_required_after: Money) kind empirical {
    label en unofficial "a plan's funding target plus target normal cost (section 430) and the assets required to be allocated to it after the spin-off (without regard to the paragraph), case-asserted";
}

pub relation spin_off_plan_excess_amount_414l2Bi(plan: Plan, amount: Money) kind institutional {
    label en official "section 414(l)(2)(B)(i): the excess, if any, of the plan's funding target and target normal cost over the assets required to be allocated to it";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "the excess (if any) of")
rule SpinOffPlanExcessAmount414l2Bi(plan: Plan, liab: Money, assets: Money) strict {
    label en official "max(0, liability measure - assets required)";
    when spin_off_plan_liability_measure_414l2Bi(plan, liab, assets);
    then spin_off_plan_excess_amount_414l2Bi(plan, max(0 USD, liab - assets));
}

pub relation spin_off_applicable_percentage_414l2B(plan: Plan, pct: Decimal) kind institutional {
    label en official "section 414(l)(2)(B): the plan's excess amount divided by the sum of the excess amounts of all the plans (6 places HALF_UP: JUDGMENT CALL)";
}

pub relation spin_off_sum_of_excess_amounts_414l2Bii(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the sum of the excess amounts determined separately for all plans in the spin-off, case-asserted";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "the sum of the excess amounts determined separately under clause (i) for all such plans")
rule SpinOffApplicablePercentage414l2B(plan: Plan, excess: Money, total: Money) strict {
    label en official "excess / total";
    when spin_off_plan_excess_amount_414l2Bi(plan, excess)
        and spin_off_sum_of_excess_amounts_414l2Bii(plan, total)
        and total > 0 USD;
    then spin_off_applicable_percentage_414l2B(plan, div_round(excess / 1.00 USD, total / 1.00 USD, 6, "HALF_UP"));
}

pub relation spin_off_plan_allocated_excess_414l2A(plan: Plan, allocated: Money) kind institutional {
    label en official "section 414(l)(2)(A): the applicable percentage of the excess assets must be allocated to each plan (the required allocation)";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "shall not constitute a qualified trust under this section unless the applicable percentage of excess assets are allocated to each of such plans")
rule SpinOffPlanAllocatedExcess414l2A(plan: Plan, pct: Decimal, excess_assets: Money) strict {
    label en official "required allocation = excess assets x applicable percentage, HALF_UP to the cent";
    when spin_off_applicable_percentage_414l2B(plan, pct)
        and spin_off_excess_assets_414l2C(plan, excess_assets);
    then spin_off_plan_allocated_excess_414l2A(plan, round(excess_assets * pct, 2, "HALF_UP"));
}

pub enum SpinOffExclusion414l2D {
    OtherEmployerAfterSpinOff;
    NoOtherSharedPlan;
    TerminatedInTransaction;
    Other;
}

pub relation spin_off_plan_exclusion_414l2D(plan: Plan, kind: SpinOffExclusion414l2D, assets_allocated: Money) kind empirical {
    label en unofficial "a spun-off plan described in clause (ii), (iii) or (iv) and the assets allocated to it, case-asserted";
}

pub relation spin_off_plan_not_taken_into_account_414l2D(plan: Plan, added_to_C_ii: Money) kind institutional {
    label en official "section 414(l)(2)(D)(i): such a plan is not taken into account, and the (C)(ii) amount is increased by the assets allocated to it";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "shall not be taken into account for purposes of this paragraph, except that the amount determined under subparagraph (C)(ii) shall be increased by the amount of assets allocated to such plan")
rule SpinOffPlanNotTakenIntoAccountOther414l2D(plan: Plan, assets: Money) strict {
    label en official "clause (ii): maintained by an employer outside the controlled group";
    when spin_off_plan_exclusion_414l2D(plan, OtherEmployerAfterSpinOff, assets);
    then spin_off_plan_not_taken_into_account_414l2D(plan, assets);
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "does not maintain any other plan remaining after the spin-off")
rule SpinOffPlanNotTakenIntoAccountNoShared414l2D(plan: Plan, assets: Money) strict {
    label en official "clause (iii)";
    when spin_off_plan_exclusion_414l2D(plan, NoOtherSharedPlan, assets);
    then spin_off_plan_not_taken_into_account_414l2D(plan, assets);
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "pursuant to the transaction involving the spin-off, the plan is terminated")
rule SpinOffPlanNotTakenIntoAccountTerminated414l2D(plan: Plan, assets: Money) strict {
    label en official "clause (iv)";
    when spin_off_plan_exclusion_414l2D(plan, TerminatedInTransaction, assets);
    then spin_off_plan_not_taken_into_account_414l2D(plan, assets);
}

pub relation spin_off_participants_covered_by_multiemployer_title_iv_414l2e(plan: Plan) kind empirical {
    label en unofficial "the participants before or after the spin-off are covered under a multiemployer plan to which title IV of ERISA applies, case-asserted";
}

pub relation paragraph_2_inapplicable_to_multiemployer_spin_off_414l2e(plan: Plan) kind institutional {
    label en official "section 414(l)(2)(E): the paragraph does not apply to a multiemployer plan spin-off to the extent participants are covered under a title IV multiemployer plan";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "This paragraph does not apply to any multiemployer plan with respect to any spin-off to the extent that participants either before or after the spin-off are covered under a multiemployer plan")
rule Paragraph2InapplicableToMultiemployerSpinOff414l2e(plan: Plan) strict {
    label en official "title IV multiemployer coverage";
    when spin_off_participants_covered_by_multiemployer_title_iv_414l2e(plan);
    then paragraph_2_inapplicable_to_multiemployer_spin_off_414l2e(plan);
}

pub relation bridge_bank_closed_insured_bank_facts_414l2g(bank: Person, insured_bank: Person) kind empirical {
    label en unofficial "the insured bank maintains a defined benefit plan, is closed by the bank regulatory authorities, and its assets and liabilities are received by the bridge depository institution, case-asserted";
}

pub relation bridge_bank_treated_as_group_member_414l2g(bank: Person, insured_bank: Person) kind institutional {
    label en official "section 414(l)(2)(G)(i): the bridge depository institution is treated as a member of the controlled group of the closed insured bank";
}

@source(IRC_S414_L, relation = formalizes, coverage = exact, quote = "such bank shall be treated as a member of any controlled group which includes any insured bank")
rule BridgeBankTreatedAsGroupMember414l2g(bank: Person, insured: Person) strict {
    label en official "closed insured bank with a defined benefit plan";
    when bridge_bank_closed_insured_bank_facts_414l2g(bank, insured);
    then bridge_bank_treated_as_group_member_414l2g(bank, insured);
}

pub relation bridge_bank_transfer_right_percent_414l2gii(bank: Person, days_after_closing: Integer, excess_assets_percent: Decimal) kind empirical {
    label en unofficial "the bridge institution's right to require a transfer of excess assets, the days after the insured bank is closed, and the fraction of the excess assets (0.50 = 50 percent), case-asserted";
}

pub relation bridge_bank_transfer_right_valid_414l2gii(bank: Person) kind institutional {
    label en official "section 414(l)(2)(G)(ii)(I): during the 180-day period after closing the bridge institution has the right to require a transfer of not more than 50 percent of the excess assets";
}

@source(IRC_S414_L, relation = formalizes, coverage = partial, quote = "the bridge depository institution has the right to require the plan to transfer (subject to the provisions of this paragraph) not more than 50 percent of the excess assets")
rule BridgeBankTransferRightValid414l2gii(bank: Person, days: Integer, pct: Decimal) strict {
    label en official "PARTIAL: exact boundaries: day 180 and 50 percent are inside; the later text of the clause is one case fact";
    when bridge_bank_transfer_right_percent_414l2gii(bank, days, pct)
        and days >= 0 and days <= 180
        and pct <= 0.50;
    then bridge_bank_transfer_right_valid_414l2gii(bank);
}

// =====================================================================
// (q), (r), (s), (t)
// =====================================================================

pub relation employee_in_top_paid_group_preceding_year_414q1_414q1Bii(employee: Person, employer: Person) kind empirical {
    label en unofficial "the employer elects the clause and the employee was in the top-paid group for the preceding year, case-asserted";
}

pub relation employee_hce_by_top_paid_election_414q1B(employee: Person, employer: Person) kind institutional {
    label en official "section 414(q)(1)(B)(ii): with the employer's election, an employee in the top-paid group for the preceding year is highly compensated";
}

@source(IRC_S414_Q, relation = formalizes, coverage = partial, quote = "if the employer elects the application of this clause for such preceding year, was in the top-paid group of employees for such preceding year")
rule EmployeeHceByTopPaidElection414q1B(employee: Person, employer: Person) strict {
    label en official "PARTIAL: the other conditions of the clause (compensation over the amount for the preceding year) are module 12";
    when employee_in_top_paid_group_preceding_year_414q1_414q1Bii(employee, employer);
    then employee_hce_by_top_paid_election_414q1B(employee, employer);
}

pub relation five_percent_owner_at_any_time_in_year_414q2(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "at any time during the year the employee was a 5-percent owner (section 416(i)(1)) of the employer, case-asserted";
}

pub relation five_percent_owner_for_year_414q2(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 414(q)(2): an employee is a 5-percent owner for a year if at any time during the year the employee was one";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "An employee shall be treated as a 5-percent owner for any year if at any time during such year such employee was a 5-percent owner")
rule FivePercentOwnerForYear414q2(employee: Person, employer: Person, y: TaxableYear) strict {
    label en official "any time during the year";
    when five_percent_owner_at_any_time_in_year_414q2(employee, employer, y);
    then five_percent_owner_for_year_414q2(employee, employer, y);
}

pub relation compensation_415c3_for_414q4(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's compensation within the meaning of section 415(c)(3), case-asserted";
}

pub relation compensation_for_414q_414q4(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(q)(4): compensation has the meaning of section 415(c)(3)";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"compensation\" has the meaning given such term by section 415(c)(3).")
rule CompensationFor414q414q4(employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "cross-reference";
    when compensation_415c3_for_414q4(employee, y, amount);
    then compensation_for_414q_414q4(employee, y, amount);
}

pub enum ExcludedEmployeeKind414q5 {
    UnderSixMonthsOfService;
    UnderSeventeenAndAHalfHoursWeekly;
    WorksSixMonthsOrLessAYear;
    UnderAge21;
    CollectivelyBargained;
    Other;
}

pub relation excluded_employee_facts_414q5(employee: Person, kind: ExcludedEmployeeKind414q5, months_of_service: Integer, weekly_hours: Decimal, months_worked_in_year: Integer, age: Integer) kind empirical {
    label en unofficial "the employee's kind and the measures (months of service, normal weekly hours, months normally worked in a year, age), case-asserted";
}

pub relation employer_elects_shorter_requirement_414q5(employer: Person, kind: ExcludedEmployeeKind414q5, threshold: Decimal) kind empirical {
    label en unofficial "the employer elects a shorter period of service, smaller number of hours or months, or lower age than the statutory measure, case-asserted";
}

pub relation employee_excluded_by_kind_414q5(employee: Person, kind: ExcludedEmployeeKind414q5) kind institutional {
    label en official "section 414(q)(5): employees with under 6 months of service, under 17.5 weekly hours, working at most 6 months a year, under age 21, or covered by a collective bargaining agreement are excluded (for subsection (r) and the top-paid group count)";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who have not completed 6 months of service")
rule EmployeeExcludedUnderSixMonths414q5(employee: Person, months: Integer, hours: Decimal, worked: Integer, age: Integer) strict {
    label en official "(A): exact boundary: 6 months of service completed is not excluded";
    when excluded_employee_facts_414q5(employee, UnderSixMonthsOfService, months, hours, worked, age)
        and months < 6;
    then employee_excluded_by_kind_414q5(employee, UnderSixMonthsOfService);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who normally work less than 17½ hours per week")
rule EmployeeExcludedUnderSeventeenAndAHalfHours414q5(employee: Person, months: Integer, hours: Decimal, worked: Integer, age: Integer) strict {
    label en official "(B): exact boundary: 17.5 hours is not excluded";
    when excluded_employee_facts_414q5(employee, UnderSeventeenAndAHalfHoursWeekly, months, hours, worked, age)
        and hours < 17.5;
    then employee_excluded_by_kind_414q5(employee, UnderSeventeenAndAHalfHoursWeekly);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who normally work during not more than 6 months during any year")
rule EmployeeExcludedSixMonthsOrLess414q5(employee: Person, months: Integer, hours: Decimal, worked: Integer, age: Integer) strict {
    label en official "(C): exact boundary: 6 months is excluded, 7 is not";
    when excluded_employee_facts_414q5(employee, WorksSixMonthsOrLessAYear, months, hours, worked, age)
        and worked <= 6;
    then employee_excluded_by_kind_414q5(employee, WorksSixMonthsOrLessAYear);
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who have not attained age 21")
rule EmployeeExcludedUnderAge21414q5(employee: Person, months: Integer, hours: Decimal, worked: Integer, age: Integer) strict {
    label en official "(D): exact boundary: age 21 is not excluded";
    when excluded_employee_facts_414q5(employee, UnderAge21, months, hours, worked, age)
        and age < 21;
    then employee_excluded_by_kind_414q5(employee, UnderAge21);
}

@source(IRC_S414_Q, relation = formalizes, coverage = partial, quote = "employees who are included in a unit of employees covered by an agreement which the Secretary of Labor finds to be a collective bargaining agreement")
rule EmployeeExcludedCollectivelyBargained414q5(employee: Person, months: Integer, hours: Decimal, worked: Integer, age: Integer) strict {
    label en official "(E) PARTIAL: except as regulations provide";
    when excluded_employee_facts_414q5(employee, CollectivelyBargained, months, hours, worked, age);
    then employee_excluded_by_kind_414q5(employee, CollectivelyBargained);
}

pub relation aggregation_rules_applied_first_414q7(employer: Person) kind empirical {
    label en unofficial "the employer applies subsections (b), (c), (m), (n) and (o) before this subsection, case-asserted";
}

pub relation q_applied_after_aggregation_414q7(employer: Person) kind institutional {
    label en official "section 414(q)(7): subsections (b), (c), (m), (n) and (o) are applied before this subsection";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "Subsections (b), (c), (m), (n), and (o) shall be applied before the application of this subsection.")
rule QAppliedAfterAggregation414q7(employer: Person) strict {
    label en official "ordering";
    when aggregation_rules_applied_first_414q7(employer);
    then q_applied_after_aggregation_414q7(employer);
}

pub relation nonresident_alien_no_us_source_earned_income_414q8(employee: Person) kind empirical {
    label en unofficial "the nonresident alien receives no earned income from the employer that is income from sources within the United States, case-asserted";
}

pub relation employee_not_treated_as_employee_414q8(employee: Person) kind institutional {
    label en official "section 414(q)(8): such nonresident aliens are not treated as employees for subsections (q) and (r)";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "employees who are nonresident aliens and who receive no earned income")
rule EmployeeNotTreatedAsEmployee414q8(employee: Person) strict {
    label en official "nonresident alien without US-source earned income";
    when nonresident_alien_no_us_source_earned_income_414q8(employee);
    then employee_not_treated_as_employee_414q8(employee);
}

pub relation church_plan_employee_is_hce_under_q1_414q9(employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is a highly compensated employee under paragraph (1) for the year, case-asserted";
}

pub relation church_plan_employee_hce_status_414q9(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 414(q)(9): in a church plan no employee is an officer, supervisor or highly compensated employee for a year unless highly compensated under paragraph (1)";
}

@source(IRC_S414_Q, relation = formalizes, coverage = exact, quote = "no employee shall be considered an officer, a person whose principal duties consist of supervising the work of other employees, or a highly compensated employee for any year unless such employee is a highly compensated employee under paragraph (1) for such year")
rule ChurchPlanEmployeeHceStatus414q9(employee: Person, y: TaxableYear) strict {
    label en official "paragraph (1) status only";
    when church_plan_employee_is_hce_under_q1_414q9(employee, y);
    then church_plan_employee_hce_status_414q9(employee, y);
}

pub relation line_of_business_met_requirements_preceding_year_414r3B(line: Person) kind empirical {
    label en unofficial "the requirements of subparagraph (A) were met with respect to the line of business for the preceding year, case-asserted";
}

pub relation employees_shifted_de_minimis_414r3Bi(line: Person) kind empirical {
    label en unofficial "no more than a de minimis number of employees were shifted to or from the line of business after the close of the preceding year, case-asserted";
}

pub relation employees_shifted_proportional_hce_414r3Bii(line: Person) kind empirical {
    label en unofficial "the employees shifted contained a substantially proportional number of highly compensated employees, case-asserted";
}

pub relation line_of_business_requirements_met_414r3B(line: Person) kind institutional {
    label en official "section 414(r)(3)(B): the requirements are treated as met for a line of business that met them for the preceding year if the shifts were de minimis or proportional";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "no more than a de minimis number of employees were shifted to or from the line of business after the close of the preceding year")
rule LineOfBusinessRequirementsMetDeMinimis414r3B(line: Person) strict {
    label en official "(i)";
    when line_of_business_met_requirements_preceding_year_414r3B(line)
        and employees_shifted_de_minimis_414r3Bi(line);
    then line_of_business_requirements_met_414r3B(line);
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "the employees shifted to or from the line of business after the close of the preceding year contained a substantially proportional number of highly compensated employees")
rule LineOfBusinessRequirementsMetProportional414r3B(line: Person) strict {
    label en official "(ii)";
    when line_of_business_met_requirements_preceding_year_414r3B(line)
        and employees_shifted_proportional_hce_414r3Bii(line);
    then line_of_business_requirements_met_414r3B(line);
}

pub relation benefit_attributable_to_services_for_line_414r5(benefit: Person, line: Person) kind empirical {
    label en unofficial "the benefit is attributable to services provided to the line of business, case-asserted";
}

pub relation benefit_treated_as_provided_by_line_414r5(benefit: Person, line: Person) kind institutional {
    label en official "section 414(r)(5): benefits attributable to services provided to a line of business are treated as provided by it";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "benefits which are attributable to services provided to a line of business shall be treated as provided by such line of business")
rule BenefitTreatedAsProvidedByLine414r5(benefit: Person, line: Person) strict {
    label en official "attributable benefits";
    when benefit_attributable_to_services_for_line_414r5(benefit, line);
    then benefit_treated_as_provided_by_line_414r5(benefit, line);
}

pub relation operating_unit_separate_geographic_bona_fide_414r7(unit: Person) kind empirical {
    label en unofficial "the operating unit is in a separate geographic area, separately operated for a bona fide business reason, case-asserted";
}

pub relation separate_line_of_business_includes_unit_414r7(unit: Person) kind institutional {
    label en official "section 414(r)(7): a separate line of business includes such an operating unit";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "includes an operating unit in a separate geographic area separately operated for a bona fide business reason")
rule SeparateLineOfBusinessIncludesUnit414r7(unit: Person) strict {
    label en official "geographic unit";
    when operating_unit_separate_geographic_bona_fide_414r7(unit);
    then separate_line_of_business_includes_unit_414r7(unit);
}

pub relation employer_is_affiliated_service_group_414r8(employer: Person) kind empirical {
    label en unofficial "the employer is an affiliated service group within the meaning of section 414(m), case-asserted";
}

pub relation subsection_r_inapplicable_414r8(employer: Person) kind institutional {
    label en official "section 414(r)(8): the subsection does not apply to an affiliated service group";
}

@source(IRC_S414_R, relation = formalizes, coverage = exact, quote = "This subsection shall not apply in the case of any affiliated service group")
rule SubsectionRInapplicable414r8(employer: Person) strict {
    label en official "affiliated service group";
    when employer_is_affiliated_service_group_414r8(employer);
    then subsection_r_inapplicable_414r8(employer);
}

pub relation compensation_base_415c3_414s1(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "compensation within the meaning of section 415(c)(3), case-asserted";
}

pub relation salary_reduction_amount_not_includible_414s2(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount contributed under a salary reduction agreement and not includible under section 125, 132(f)(4), 402(e)(3), 402(h) or 403(b), case-asserted";
}

pub relation employer_elects_to_exclude_salary_reduction_414s2(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects not to include those amounts as compensation, case-asserted";
}

pub relation employee_employer_414s(employee: Person, employer: Person) kind empirical {
    label en unofficial "the employee's employer, case-asserted";
}

pub relation compensation_for_414s(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(s)(1)-(2): compensation is the section 415(c)(3) amount, less (at the employer's election) the excluded salary reduction amounts";
}

@source(IRC_S414_S, relation = formalizes, coverage = exact, quote = "An employer may elect not to include as compensation any amount which is contributed by the employer pursuant to a salary reduction agreement")
rule CompensationFor414sExcluded(employee: Person, employer: Person, y: TaxableYear, base: Money, sr: Money) strict {
    label en official "base - salary reduction amounts when the employer elects";
    when compensation_base_415c3_414s1(employee, y, base)
        and salary_reduction_amount_not_includible_414s2(employee, y, sr)
        and employer_elects_to_exclude_salary_reduction_414s2(employer, y);
    then compensation_for_414s(employee, employer, y, max(0 USD, base - sr));
}

@source(IRC_S414_S, relation = formalizes, coverage = exact, quote = "Except as provided in this subsection, the term \"compensation\" has the meaning given such term by section 415(c)(3).")
rule CompensationFor414sIncluded(employee: Person, employer: Person, y: TaxableYear, base: Money) strict {
    label en official "no election: the section 415(c)(3) amount";
    when compensation_base_415c3_414s1(employee, y, base)
        and employee_employer_414s(employee, employer)
        and not_known(employer_elects_to_exclude_salary_reduction_414s2(employer, y));
    then compensation_for_414s(employee, employer, y, base);
}

pub relation alternative_compensation_method_discriminates_414s3(employer: Person) kind empirical {
    label en unofficial "the alternative method of determining compensation discriminates in favor of highly compensated employees, case-asserted";
}

pub relation alternative_method_permitted_414s3(employer: Person) kind institutional {
    label en official "section 414(s)(3): an alternative method under the Secretary's regulations may not be used if it discriminates in favor of highly compensated employees";
}

pub relation employer_uses_alternative_method_414s3(employer: Person) kind empirical {
    label en unofficial "the employer uses an alternative method of determining compensation, case-asserted";
}

@source(IRC_S414_S, relation = formalizes, coverage = partial, quote = "an employer may not use an alternative method if the use of such method discriminates in favor of highly compensated employees")
rule AlternativeMethodPermitted414s3(employer: Person) strict {
    label en official "PARTIAL: the regulations' methods are not pinned";
    when employer_uses_alternative_method_414s3(employer)
        and not_known(alternative_compensation_method_discriminates_414s3(employer));
    then alternative_method_permitted_414s3(employer);
}

pub relation provision_refers_to_414s_414s4(provision: Person) kind empirical {
    label en unofficial "the provision specifically refers to section 414(s), case-asserted";
}

pub relation applicable_provision_414s4(provision: Person) kind institutional {
    label en official "section 414(s)(4): an applicable provision is any provision that specifically refers to the subsection";
}

@source(IRC_S414_S, relation = formalizes, coverage = exact, quote = "the term \"applicable provision\" means any provision which specifically refers to this subsection")
rule ApplicableProvision414s4(provision: Person) strict {
    label en official "provisions referring to the subsection";
    when provision_refers_to_414s_414s4(provision);
    then applicable_provision_414s4(provision);
}

pub relation employees_of_single_employer_by_414bcm_414t1(a: Person, b: Person) kind empirical {
    label en unofficial "the employees are treated as employed by a single employer under subsection (b), (c) or (m), case-asserted";
}

pub enum ApplicableSection414t2 {
    Section79;
    Section106;
    Section117d;
    Section125;
    Section127;
    Section129;
    Section132;
    Section137;
    Section274j;
    Section505;
    Section4980B;
    Other;
}

pub relation section_asked_414t(section: ApplicableSection414t2) kind empirical {
    label en unofficial "the section for which the single employer rule is asked, case-asserted";
}

pub relation single_employer_rule_applies_to_section_414t(a: Person, b: Person, section: ApplicableSection414t2) kind institutional {
    label en official "section 414(t)(1)-(2): employees treated as employed by a single employer under (b), (c) or (m) are treated so for sections 79, 106, 117(d), 125, 127, 129, 132, 137, 274(j), 505 and 4980B";
}

@source(IRC_S414_T, relation = formalizes, coverage = exact, quote = "All employees who are treated as employed by a single employer under subsection (b), (c), or (m) shall be treated as employed by a single employer for purposes of an applicable section.")
rule SingleEmployerRuleAppliesToSection414t(a: Person, b: Person, section: ApplicableSection414t2) strict {
    label en official "closed list (Other is not an applicable section)";
    when employees_of_single_employer_by_414bcm_414t1(a, b)
        and section_asked_414t(section)
        and section != Other;
    then single_employer_rule_applies_to_section_414t(a, b, section);
}

// =====================================================================
// (v), (w), (y)
// =====================================================================

pub enum ApplicablePlanKind414v6A {
    Section401aTrust;
    Section403bPlan;
    Section457bPlan;
    SimpleOrSep;
    Other;
}

pub relation employer_plan_of_kind_414v6A(plan: Plan, employer: Person, kind: ApplicablePlanKind414v6A) kind empirical {
    label en unofficial "the plan's kind and its employer (aggregation under subsection (b), (c), (m) or (o) is applied by the case), case-asserted";
}

pub relation applicable_employer_plan_414v6A(plan: Plan) kind institutional {
    label en official "section 414(v)(6)(A): a section 401(a) exempt trust, a section 403(b) plan, an eligible section 457(b) plan, or a section 408(k) or (p) arrangement";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "an employees' trust described in section 401(a) which is exempt from tax under section 501(a)")
rule ApplicableEmployerPlan401a414v6A(plan: Plan, employer: Person) strict {
    label en official "(i)";
    when employer_plan_of_kind_414v6A(plan, employer, Section401aTrust);
    then applicable_employer_plan_414v6A(plan);
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "a plan under which amounts are contributed by an individual's employer for an annuity contract described in section 403(b)")
rule ApplicableEmployerPlan403b414v6A(plan: Plan, employer: Person) strict {
    label en official "(ii)";
    when employer_plan_of_kind_414v6A(plan, employer, Section403bPlan);
    then applicable_employer_plan_414v6A(plan);
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "an eligible deferred compensation plan under section 457 of an eligible employer described in section 457(e)(1)(A)")
rule ApplicableEmployerPlan457b414v6A(plan: Plan, employer: Person) strict {
    label en official "(iii)";
    when employer_plan_of_kind_414v6A(plan, employer, Section457bPlan);
    then applicable_employer_plan_414v6A(plan);
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "an arrangement meeting the requirements of section 408(k) or (p)")
rule ApplicableEmployerPlanSimpleSep414v6A(plan: Plan, employer: Person) strict {
    label en official "(iv)";
    when employer_plan_of_kind_414v6A(plan, employer, SimpleOrSep);
    then applicable_employer_plan_414v6A(plan);
}

pub relation plans_of_same_employer_aggregated_kind_414v2D(employer: Person, group: Integer, plan_count: Integer) kind empirical {
    label en unofficial "the number of plans of the employer aggregated as a single plan: group 1 = the plans described in clauses (i), (ii) and (iv) of paragraph (6)(A), group 2 = the plans of clause (iii), case-asserted";
}

pub relation aggregated_as_single_plan_414v2D(employer: Person, group: Integer) kind institutional {
    label en official "section 414(v)(2)(D): clause (i), (ii) and (iv) plans of the same employer are one plan, and clause (iii) plans are one plan";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "shall be treated as a single plan, and plans described in clause (iii) of paragraph (6)(A) that are maintained by the same employer shall be treated as a single plan")
rule AggregatedAsSinglePlan414v2D(employer: Person, group: Integer, n: Integer) strict {
    label en official "group 1 or 2 with at least one plan";
    when plans_of_same_employer_aggregated_kind_414v2D(employer, group, n)
        and (group == 1 or group == 2) and n >= 1;
    then aggregated_as_single_plan_414v2D(employer, group);
}

pub relation catch_up_contribution_414v3(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution to a plan under paragraph (1) (a catch-up contribution), case-asserted";
}

pub relation catch_up_contribution_outside_limits_414v3A(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(v)(3)(A): the contribution is not subject to the limitations of sections 401(a)(30), 402(h), 403(b), 408, 415(c) and 457(b)(2) for the year, and is not counted against them";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "such contribution shall not, with respect to the year in which the contribution is made")
rule CatchUpContributionOutsideLimits414v3A(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "catch-up contributions";
    when catch_up_contribution_414v3(participant, y, amount);
    then catch_up_contribution_outside_limits_414v3A(participant, y, amount);
}

pub relation plan_failing_universal_availability_414v4A(plan: Plan) kind empirical {
    label en unofficial "the plan does not allow all eligible participants to make the same election with respect to the additional elective deferrals, case-asserted";
}

pub relation plan_fails_401a4_by_catch_up_universal_availability_414v4A(plan: Plan) kind institutional {
    label en official "section 414(v)(4)(A): an applicable plan fails section 401(a)(4) unless all eligible participants may make the same catch-up election";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "unless the plan allows all eligible participants to make the same election with respect to the additional elective deferrals under this subsection")
rule PlanFails401a4ByCatchUpUniversalAvailability414v4A(plan: Plan) strict {
    label en official "not universally available";
    when applicable_employer_plan_414v6A(plan)
        and plan_failing_universal_availability_414v4A(plan);
    then plan_fails_401a4_by_catch_up_universal_availability_414v4A(plan);
}

pub relation higher_457b3_limit_applies_414v6C(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "a higher limitation applies to the participant under section 457(b)(3) for the year, case-asserted";
}

pub relation subsection_v_applies_to_participant_414v6C(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 414(v)(6)(C): the subsection does not apply to a participant for a year in which a higher limitation applies under section 457(b)(3)";
}

pub relation participant_in_catch_up_year_414v6C(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the participant would otherwise be within the subsection for the year, case-asserted";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to a participant for any year for which a higher limitation applies to the participant under section 457(b)(3).")
rule SubsectionVAppliesToParticipant414v6C(participant: Person, y: TaxableYear) strict {
    label en official "no higher 457(b)(3) limitation";
    when participant_in_catch_up_year_414v6C(participant, y)
        and not_known(higher_457b3_limit_applies_414v6C(participant, y));
    then subsection_v_applies_to_participant_414v6C(participant, y);
}

pub relation plan_provides_roth_catch_up_for_eligible_participants_414v7B(plan: Plan) kind empirical {
    label en unofficial "the plan provides that any eligible participant may make the additional elective deferrals as designated Roth contributions, case-asserted";
}

pub relation subparagraph_A_applies_to_participant_for_year_414v7A(plan: Plan) kind empirical {
    label en unofficial "subparagraph (A) (the Roth-only catch-up for higher-paid participants) applies to a participant for the plan year, case-asserted";
}

pub relation paragraph_1_available_414v7B(plan: Plan) kind institutional {
    label en official "section 414(v)(7)(B): where subparagraph (A) applies to any participant, paragraph (1) applies to the plan only if it provides that any eligible participant may make the additional deferrals as designated Roth contributions";
}

@source(IRC_S414_V, relation = formalizes, coverage = exact, quote = "paragraph (1) shall not apply to the plan unless the plan provides that any eligible participant may make the participant's additional elective deferrals as designated Roth contributions")
rule Paragraph1Available414v7B(plan: Plan) strict {
    label en official "Roth availability";
    when subparagraph_A_applies_to_participant_for_year_414v7A(plan)
        and plan_provides_roth_catch_up_for_eligible_participants_414v7B(plan);
    then paragraph_1_available_414v7B(plan);
}

pub relation permissible_withdrawal_amount_414w1(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of a permissible withdrawal under an eligible automatic contribution arrangement, case-asserted";
}

pub relation permissible_withdrawal_treatment_414w1(employee: Person, y: TaxableYear, includible: Money) kind institutional {
    label en official "section 414(w)(1): the withdrawal is includible in gross income for the year, is not subject to section 72(t), and does not violate distribution restrictions";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "the amount of any such withdrawal shall be includible in the gross income of the employee for the taxable year of the employee in which the distribution is made")
rule PermissibleWithdrawalTreatment414w1(employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "includible amount";
    when permissible_withdrawal_amount_414w1(employee, y, amount);
    then permissible_withdrawal_treatment_414w1(employee, y, amount);
}

pub relation matching_contributions_on_withdrawal_treated_414w1(employee: Person, y: TaxableYear, forfeited: Boolean) kind empirical {
    label en unofficial "the employer matching contributions are forfeited (true) or receive another treatment the Secretary prescribes (false), case-asserted";
}

pub relation matching_contributions_forfeitable_on_withdrawal_414w1(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 414(w)(1) last sentence: employer matching contributions are forfeited or treated as the Secretary prescribes";
}

@source(IRC_S414_W, relation = formalizes, coverage = partial, quote = "employer matching contributions shall be forfeited or subject to such other treatment as the Secretary may prescribe")
rule MatchingContributionsForfeitableOnWithdrawal414w1(employee: Person, y: TaxableYear) strict {
    label en official "PARTIAL: forfeiture; other treatment is the Secretary's";
    when matching_contributions_on_withdrawal_treated_414w1(employee, y, true);
    then matching_contributions_forfeitable_on_withdrawal_414w1(employee, y);
}

pub relation w4_notice_facts(plan: Plan, y: TaxableYear, timely: Boolean, accurate: Boolean, understandable: Boolean, explains_election_right: Boolean, reasonable_period_to_elect: Boolean, explains_default_investment: Boolean) kind empirical {
    label en unofficial "the notice given before the plan year: its timing, accuracy and comprehensiveness, readability, explanation of the right to elect out or change the percentage, the reasonable period to elect before the first contribution, and the explanation of default investment, case-asserted";
}

pub relation w4_notice_requirement_met_414w4(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 414(w)(4): the administrator gives each employee, within a reasonable period before each plan year, an accurate and understandable notice explaining the right to elect out, the period to elect and the default investment";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "the notice includes an explanation of the employee's right under the arrangement to elect not to have elective contributions made on the employee's behalf")
rule W4NoticeRequirementMet414w4(plan: Plan, y: TaxableYear) strict {
    label en official "all six conditions";
    when w4_notice_facts(plan, y, true, true, true, true, true, true);
    then w4_notice_requirement_met_414w4(plan, y);
}

pub enum ApplicablePlanKind414w5 {
    Section401aTrust;
    Section403bPlan;
    Section457bPlan;
    SepSalaryReduction;
    SimpleRetirementAccount;
    Other;
}

pub relation plan_kind_414w5(plan: Plan, kind: ApplicablePlanKind414w5) kind empirical {
    label en unofficial "the plan's kind, case-asserted";
}

pub relation applicable_employer_plan_414w5(plan: Plan) kind institutional {
    label en official "section 414(w)(5): a section 401(a) trust, a section 403(b) plan, an eligible section 457(b) plan, a SEP with a salary reduction arrangement, or a SIMPLE retirement account";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "a simple retirement account (as defined in section 408(p))")
rule ApplicableEmployerPlanW5Simple414w5(plan: Plan) strict {
    label en official "(E)";
    when plan_kind_414w5(plan, SimpleRetirementAccount);
    then applicable_employer_plan_414w5(plan);
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "a simplified employee pension the terms of which provide for a salary reduction arrangement described in section 408(k)(6)")
rule ApplicableEmployerPlanW5Sep414w5(plan: Plan) strict {
    label en official "(D)";
    when plan_kind_414w5(plan, SepSalaryReduction);
    then applicable_employer_plan_414w5(plan);
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "an eligible deferred compensation plan described in section 457(b) which is maintained by an eligible employer described in section 457(e)(1)(A)")
rule ApplicableEmployerPlanW5457b414w5(plan: Plan) strict {
    label en official "(C)";
    when plan_kind_414w5(plan, Section457bPlan);
    then applicable_employer_plan_414w5(plan);
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "a plan under which amounts are contributed by an individual's employer for an annuity contract described in section 403(b)")
rule ApplicableEmployerPlanW5403b414w5(plan: Plan) strict {
    label en official "(B)";
    when plan_kind_414w5(plan, Section403bPlan);
    then applicable_employer_plan_414w5(plan);
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "an employees' trust described in section 401(a) which is exempt from tax under section 501(a)")
rule ApplicableEmployerPlanW5401a414w5(plan: Plan) strict {
    label en official "(A)";
    when plan_kind_414w5(plan, Section401aTrust);
    then applicable_employer_plan_414w5(plan);
}

pub relation permissible_withdrawal_disregarded_414w6(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(w)(6): a permissible withdrawal is not taken into account for section 401(k)(3) or the section 402(g)(1) limit";
}

@source(IRC_S414_W, relation = formalizes, coverage = exact, quote = "shall not be taken into account for purposes of section 401(k)(3) or for purposes of applying the limitation under section 402(g)(1)")
rule PermissibleWithdrawalDisregarded414w6(employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "permissible withdrawal";
    when permissible_withdrawal_amount_414w1(employee, y, amount);
    then permissible_withdrawal_disregarded_414w6(employee, y, amount);
}

pub relation employers_single_employer_414by_414y2(a: Person, b: Person) kind empirical {
    label en unofficial "the employers are treated as a single employer under subsection (b) or (c), case-asserted";
}

pub relation single_employer_for_csec_414y2(a: Person, b: Person) kind institutional {
    label en official "section 414(y)(2): employers treated as a single employer under (b) or (c) are a single employer for the more-than-one-employer test of paragraph (1)(B) and (C)";
}

@source(IRC_S414_Y, relation = formalizes, coverage = exact, quote = "All employers that are treated as a single employer under subsection (b) or (c) shall be treated as a single employer for purposes of determining if a plan was maintained by more than one employer")
rule SingleEmployerForCsec414y2(a: Person, b: Person) strict {
    label en official "section 414(b)/(c) group";
    when employers_single_employer_414by_414y2(a, b);
    then single_employer_for_csec_414y2(a, b);
}

pub relation csec_election_out_made_on_414y3A(plan: Plan, on: Date, first_plan_year_end_after_2013: Date) kind empirical {
    label en unofficial "the date the plan sponsor elects not to be treated as a CSEC plan and the close of the first plan year beginning after December 31, 2013, case-asserted";
}

pub relation csec_plan_by_default_414y3A(plan: Plan) kind empirical {
    label en unofficial "the plan falls within the definition of a CSEC plan without regard to the paragraph, case-asserted";
}

pub relation csec_plan_status_414y3A(plan: Plan, is_csec: Boolean) kind institutional {
    label en official "section 414(y)(3)(A): a plan within the definition is a CSEC plan unless the sponsor elects out not later than the close of the first plan year beginning after December 31, 2013";
}

@source(IRC_S414_Y, relation = formalizes, coverage = partial, quote = "such plan shall be a CSEC plan unless the plan sponsor elects not later than the close of the first plan year of the plan beginning after December 31, 2013, not to be treated as a CSEC plan")
rule CsecPlanStatusByElection414y3A(plan: Plan, on: Date, close: Date) strict {
    label en official "PARTIAL: an election on or before the close of that first plan year takes the plan out (exact boundary: on the close date is timely)";
    when csec_plan_by_default_414y3A(plan)
        and csec_election_out_made_on_414y3A(plan, on, close)
        and on <= close;
    then csec_plan_status_414y3A(plan, false);
}

@source(IRC_S414_Y, relation = formalizes, coverage = partial, quote = "If a plan falls within the definition of a CSEC plan under this subsection (without regard to this paragraph), such plan shall be a CSEC plan")
rule CsecPlanStatusDefault414y3A(plan: Plan) strict {
    label en official "PARTIAL: without an election out in time, the plan is a CSEC plan";
    when csec_plan_by_default_414y3A(plan)
        and not_known(csec_election_out_timely_present_414y3A(plan));
    then csec_plan_status_414y3A(plan, true);
}

pub relation csec_election_out_timely_present_414y3A(plan: Plan) kind institutional {
    label en unofficial "helper: a timely election out exists";
}

rule CsecElectionOutTimelyPresent414y3A(plan: Plan, on: Date, close: Date) strict {
    label en unofficial "derives the helper";
    when csec_election_out_made_on_414y3A(plan, on, close) and on <= close;
    then csec_election_out_timely_present_414y3A(plan);
}

pub relation plan_treated_as_csec_414y3B(plan: Plan) kind empirical {
    label en unofficial "a plan described in subparagraph (A) is treated as a CSEC plan, case-asserted";
}

pub relation ppa_section_104_ceases_to_apply_414y3B(plan: Plan) kind institutional {
    label en official "section 414(y)(3)(B): section 104 of the Pension Protection Act of 2006 ceases to apply to a plan treated as a CSEC plan";
}

@source(IRC_S414_Y, relation = formalizes, coverage = exact, quote = "shall cease to apply to such plan as of the first date as of which such plan is treated as a CSEC plan")
rule PpaSection104CeasesToApply414y3B(plan: Plan) strict {
    label en official "CSEC plan";
    when plan_treated_as_csec_414y3B(plan);
    then ppa_section_104_ceases_to_apply_414y3B(plan);
}

// =====================================================================
// (z), (aa), (bb), (cc)
// =====================================================================

pub enum ChurchTransferKind414z1 {
    PlanToAnnuity403b;
    Annuity403bToPlan;
    Merger;
    Other;
}

pub relation church_transfer_414z1(transfer: Person, kind: ChurchTransferKind414z1, same_church_maintains_both: Boolean) kind empirical {
    label en unofficial "a transfer of accrued benefit (whether or not vested) or a merger between a church plan and a section 403(b) annuity contract, and whether both are maintained by the same church or convention or association of churches, case-asserted";
}

pub relation church_transfer_within_z1(transfer: Person) kind institutional {
    label en official "section 414(z)(1)(A)-(C): a transfer of accrued benefit from a church plan to a section 403(b) contract, from a 403(b) contract to a church plan, or a merger of a church plan or 403(b) contract into a 403(b) contract, when the same church maintains both";
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "if such plan and annuity contract are both maintained by the same church or convention or association of churches")
rule ChurchTransferWithinZ1PlanToAnnuity(transfer: Person) strict {
    label en official "(A)";
    when church_transfer_414z1(transfer, PlanToAnnuity403b, true);
    then church_transfer_within_z1(transfer);
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "a transfer of all or a portion of the accrued benefit of a participant or beneficiary, whether or not vested, from an annuity contract described in section 403(b) to a church plan")
rule ChurchTransferWithinZ1AnnuityToPlan(transfer: Person) strict {
    label en official "(B)";
    when church_transfer_414z1(transfer, Annuity403bToPlan, true);
    then church_transfer_within_z1(transfer);
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "a merger of a church plan that is a plan described in section 401(a), or an annuity contract described in section 403(b), with an annuity contract described in section 403(b)")
rule ChurchTransferWithinZ1Merger(transfer: Person) strict {
    label en official "(C)";
    when church_transfer_414z1(transfer, Merger, true);
    then church_transfer_within_z1(transfer);
}

pub relation plan_or_contract_not_failing_by_z_transfer_414z3(transfer: Person) kind institutional {
    label en official "section 414(z)(3): a plan or annuity contract does not fail to be described in section 401(a) or 403(b) merely because of such a transfer or merger";
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "shall not fail to be considered to be described in section 401(a) or 403(b) merely because such plan or annuity contract engages in a transfer or merger described in this subsection")
rule PlanOrContractNotFailingByZTransfer414z3(transfer: Person) strict {
    label en official "qualifying transfer";
    when church_transfer_within_z1(transfer);
    then plan_or_contract_not_failing_by_z_transfer_414z3(transfer);
}

pub relation accrued_benefit_kind_414z4c(plan: Plan, defined_benefit: Boolean, benefit_under_plan: Money, account_balance: Money) kind empirical {
    label en unofficial "whether the plan is a defined benefit plan, the employee's accrued benefit under it, and the employee's account balance under a plan other than a defined benefit plan, case-asserted";
}

pub relation accrued_benefit_amount_414z4c(plan: Plan, amount: Money) kind institutional {
    label en official "section 414(z)(4)(C): the accrued benefit under the plan for a defined benefit plan, else the account balance";
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "in the case of a plan other than a defined benefit plan, the balance of the employee's account under the plan")
rule AccruedBenefitAmountDb414z4c(plan: Plan, b: Money, a: Money) strict {
    label en official "(i) defined benefit plan";
    when accrued_benefit_kind_414z4c(plan, true, b, a);
    then accrued_benefit_amount_414z4c(plan, b);
}

@source(IRC_S414_Z, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan, the employee's accrued benefit determined under the plan")
rule AccruedBenefitAmountOther414z4c(plan: Plan, b: Money, a: Money) strict {
    label en official "(ii) other plans";
    when accrued_benefit_kind_414z4c(plan, false, b, a);
    then accrued_benefit_amount_414z4c(plan, a);
}

pub relation inadvertent_overpayment_facts_414aa(plan: Plan, fails_to_recoup: Boolean, sponsor_amends_to_adjust: Boolean) kind empirical {
    label en unofficial "the plan fails to obtain payment on account of an inadvertent benefit overpayment (A), or the sponsor amends the plan to increase past or decrease future benefit payments to adjust for it (B), case-asserted";
}

pub relation plan_not_failing_by_overpayment_correction_414aa1(plan: Plan) kind institutional {
    label en official "section 414(aa)(1): a plan is not treated as failing to be described in section 219(g)(5)(A) or to satisfy sections 401(a) and 403 merely because of failing to recoup an inadvertent overpayment or amending to adjust for it";
}

@source(IRC_S414_AA, relation = formalizes, coverage = exact, quote = "the plan fails to obtain payment from any participant, beneficiary, employer, plan sponsor, fiduciary, or other party on account of any inadvertent benefit overpayment made by the plan")
rule PlanNotFailingByOverpaymentFailToRecoup414aa1(plan: Plan, amends: Boolean) strict {
    label en official "(A)";
    when inadvertent_overpayment_facts_414aa(plan, true, amends);
    then plan_not_failing_by_overpayment_correction_414aa1(plan);
}

@source(IRC_S414_AA, relation = formalizes, coverage = exact, quote = "the plan sponsor amends the plan to increase past, or decrease future, benefit payments to affected participants and beneficiaries in order to adjust for prior inadvertent benefit overpayments")
rule PlanNotFailingByOverpaymentAmendment414aa1(plan: Plan, fails: Boolean) strict {
    label en official "(B)";
    when inadvertent_overpayment_facts_414aa(plan, fails, true);
    then plan_not_failing_by_overpayment_correction_414aa1(plan);
}

pub relation plan_reduces_or_seeks_recovery_after_discovery_414aa2(plan: Plan) kind empirical {
    label en unofficial "after discovering an overpayment the plan reduces future benefit payments to the correct amount or seeks recovery from those responsible, case-asserted";
}

pub relation paragraph_1_still_applies_414aa2(plan: Plan) kind institutional {
    label en official "section 414(aa)(2): paragraph (1) continues to apply even if the plan reduces future payments or seeks recovery";
}

@source(IRC_S414_AA, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not fail to apply to a plan merely because, after discovering a benefit overpayment, such plan")
rule Paragraph1StillApplies414aa2(plan: Plan) strict {
    label en official "correction after discovery";
    when plan_reduces_or_seeks_recovery_after_discovery_414aa2(plan);
    then paragraph_1_still_applies_414aa2(plan);
}

pub relation employer_contribution_obligation_unaffected_414aa3(plan: Plan) kind empirical {
    label en unofficial "the employer's obligation to make contributions to meet the minimum funding standards (sections 412 and 430) or to restore an impermissible forfeiture (section 411) is in question, case-asserted";
}

pub relation contribution_obligation_remains_414aa3(plan: Plan) kind institutional {
    label en official "section 414(aa)(3): nothing in the subsection relieves an employer of its obligation to make minimum funding contributions or to restore an impermissible forfeiture";
}

@source(IRC_S414_AA, relation = formalizes, coverage = exact, quote = "Nothing in this subsection shall relieve an employer of any obligation imposed on it to make contributions to a plan to meet the minimum funding standards under sections 412 and 430")
rule ContributionObligationRemains414aa3(plan: Plan) strict {
    label en official "obligation in question";
    when employer_contribution_obligation_unaffected_414aa3(plan);
    then contribution_obligation_remains_414aa3(plan);
}

pub relation excess_over_401a17_or_415_limit_414aa4(plan: Plan, excess: Money) kind empirical {
    label en unofficial "benefits previously paid or allocations previously made in excess of the section 401(a)(17) or 415 limits, case-asserted";
}

pub relation limits_still_observed_414aa4(plan: Plan, amount_to_recoup: Money) kind institutional {
    label en official "section 414(aa)(4): the plan observes the section 401(a)(17) and 415 limits and may recoup the excess by any method the Secretary approves";
}

@source(IRC_S414_AA, relation = formalizes, coverage = exact, quote = "a plan to which paragraph (1) applies shall observe any limitations imposed on it by section 401(a)(17) or 415")
rule LimitsStillObserved414aa4(plan: Plan, excess: Money) strict {
    label en official "the excess over the limits";
    when excess_over_401a17_or_415_limit_414aa4(plan, excess);
    then limits_still_observed_414aa4(plan, excess);
}

pub relation unenrolled_participant_facts_414bb2(employee: Person, plan: Plan, eligible: Boolean, furnished_spd_and_notices: Boolean, participating: Boolean, other_criteria_met: Boolean) kind empirical {
    label en unofficial "the employee is eligible, has been furnished the summary plan description and initial eligibility notices, is not participating, and meets the Secretary's other criteria, case-asserted";
}

pub relation unenrolled_participant_414bb2(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(bb)(2): an eligible, notified, nonparticipating employee meeting the Secretary's other criteria";
}

@source(IRC_S414_BB, relation = formalizes, coverage = exact, quote = "the term \"unenrolled participant\" means an employee who")
rule UnenrolledParticipant414bb2(employee: Person, plan: Plan) strict {
    label en official "eligible (A), furnished (B), not participating (C), other criteria (D)";
    when unenrolled_participant_facts_414bb2(employee, plan, true, true, false, true);
    then unenrolled_participant_414bb2(employee, plan);
}

pub relation annual_reminder_and_requested_documents_furnished_414bb1(employee: Person, plan: Plan, reminder: Boolean, requested_docs: Boolean) kind empirical {
    label en unofficial "the unenrolled participant is furnished an annual reminder notice and any document requested, case-asserted";
}

pub relation other_notices_not_required_414bb1(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(bb)(1): no other disclosure, notice or plan document is required to be furnished to an unenrolled participant furnished the reminder notice and requested documents";
}

@source(IRC_S414_BB, relation = formalizes, coverage = exact, quote = "no disclosure, notice, or other plan document (other than the notices and documents described in subparagraphs (A) and (B)) shall be required to be furnished under this title to any unenrolled participant")
rule OtherNoticesNotRequired414bb1(employee: Person, plan: Plan) strict {
    label en official "unenrolled and furnished";
    when unenrolled_participant_414bb2(employee, plan)
        and annual_reminder_and_requested_documents_furnished_414bb1(employee, plan, true, true);
    then other_notices_not_required_414bb1(employee, plan);
}

pub relation eligibility_after_ineligible_period_414bb2(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee becomes eligible following a period of ineligibility, case-asserted";
}

pub relation treated_as_initial_eligibility_414bb2(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(bb)(2) last sentence: eligibility following a period of ineligibility is treated as initial eligibility";
}

@source(IRC_S414_BB, relation = formalizes, coverage = exact, quote = "any eligibility to participate in the plan following any period for which such employee was not eligible to participate shall be treated as initial eligibility")
rule TreatedAsInitialEligibility414bb2(employee: Person, plan: Plan) strict {
    label en official "renewed eligibility";
    when eligibility_after_ineligible_period_414bb2(employee, plan);
    then treated_as_initial_eligibility_414bb2(employee, plan);
}

pub relation notice_matches_erisa_111c_description_414bb3(notice: Person) kind empirical {
    label en unofficial "the notice is the notice described in ERISA section 111(c) (per Pub. L. 117-328 div. T section 343, pinned in us.erisa.definitions) — an external definition, case-asserted";
}

pub relation annual_reminder_notice_erisa_111c_414bb3(notice: Person) kind institutional {
    label en official "section 414(bb)(3): the annual reminder notice is the notice described in ERISA section 111(c) (an external definition)";
}

@source(IRC_S414_BB, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, the term \"annual reminder notice\" means the notice described in section 111(c) of the Employee Retirement Income Security Act of 1974.")
rule AnnualReminderNoticeErisa111c414bb3(notice: Person) strict {
    label en official "the 111(c) description is asserted, not derived";
    when notice_matches_erisa_111c_description_414bb3(notice);
    then annual_reminder_notice_erisa_111c_414bb3(notice);
}

pub relation corrected_error_facts_414cc(plan: Plan, employee: Person, reasonable_admin_error: Boolean, error_kind_a: Boolean, corrected_prospectively: Boolean, nondiscriminatory_correction: Boolean, notice_within_45_days: Boolean, matching_corrected: Boolean) kind empirical {
    label en unofficial "the error is a reasonable administrative error of a kind in (2)(A), corrected prospectively under an eligible automatic contribution arrangement, in a nondiscriminatory manner for all similarly situated participants, with notice within 45 days of the corrected deferrals beginning and with any missed matching contributions allocated, case-asserted";
}

pub relation corrected_error_414cc2(plan: Plan, employee: Person) kind institutional {
    label en official "section 414(cc)(2): a reasonable administrative error of the listed type, corrected prospectively with the corrective allocation, nondiscriminatorily and with timely notice";
}

@source(IRC_S414_CC, relation = formalizes, coverage = partial, quote = "such implementation error is of a type which is so corrected for all similarly situated participants in a nondiscriminatory manner")
rule CorrectedError414cc2(plan: Plan, employee: Person) strict {
    label en official "PARTIAL: the Secretary's guidance on the deadline and notice content is not pinned";
    when corrected_error_facts_414cc(plan, employee, true, true, true, true, true, true);
    then corrected_error_414cc2(plan, employee);
}

pub relation correction_payment_date_414cc2Bi(plan: Plan, employee: Person, error_first_occurred_plan_year_end: Date, correction_date: Date, notified_on: Date) kind empirical {
    label en unofficial "the close of the plan year in which the error first occurred, the date of the first payment of compensation on or after the deadline, and the employee's notification date if any, case-asserted";
}

pub relation correction_deadline_9_5_months_414cc2Bi(plan: Plan, employee: Person, deadline_date: Date) kind institutional {
    label en official "section 414(cc)(2)(B)(i)(I): the correction is made not later than the first payment of compensation on or after the last day of the 9.5-month period after the plan year end (JUDGMENT CALL: 9 months plus 15 days)";
}

@source(IRC_S414_CC, relation = formalizes, coverage = partial, quote = "the date of the first payment of compensation made by the employer to the employee on or after the last day of the 9½ month-period after the end of the plan year during which such error with respect to the employee first occurred")
rule CorrectionDeadline95Months414cc2Bi(plan: Plan, employee: Person, year_end: Date, correction: Date, notified: Date) strict {
    label en official "PARTIAL: year end + 9 months + 15 days is the period's last day (the first compensation payment on or after it is the case fact)";
    when correction_payment_date_414cc2Bi(plan, employee, year_end, correction, notified);
    then correction_deadline_9_5_months_414cc2Bi(plan, employee, add_calendar_period(add_calendar_period(year_end, 9 calendar_month), 15 calendar_day));
}

pub relation employer_not_required_qnec_for_missed_deferrals_414cc3(plan: Plan, employee: Person) kind institutional {
    label en official "section 414(cc)(3): with a corrected error the employer need not provide the missed deferrals through a qualified nonelective contribution or otherwise";
}

@source(IRC_S414_CC, relation = formalizes, coverage = exact, quote = "the employer will not be required to provide eligible employees with the missed amount of elective deferrals resulting from a reasonable administrative error")
rule EmployerNotRequiredQnecForMissedDeferrals414cc3(plan: Plan, employee: Person) strict {
    label en official "corrected error";
    when corrected_error_414cc2(plan, employee);
    then employer_not_required_qnec_for_missed_deferrals_414cc3(plan, employee);
}

pub relation plan_not_failing_by_corrected_error_414cc1(plan: Plan, employee: Person) kind institutional {
    label en official "section 414(cc)(1): a plan or arrangement does not fail to be described in sections 401(a), 403(b), 408 or 457(b) solely by reason of a corrected error";
}

@source(IRC_S414_CC, relation = formalizes, coverage = exact, quote = "Any plan or arrangement shall not fail to be treated as a plan described in sections 401(a), 403(b), 408, or 457(b), as applicable, solely by reason of a corrected error.")
rule PlanNotFailingByCorrectedError414cc1(plan: Plan, employee: Person) strict {
    label en official "corrected error";
    when corrected_error_414cc2(plan, employee);
    then plan_not_failing_by_corrected_error_414cc1(plan, employee);
}
