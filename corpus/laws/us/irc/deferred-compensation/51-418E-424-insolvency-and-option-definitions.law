// Sections 418E and 424 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026):
// (418E) insolvent multiemployer plans: insolvency, available resources, the
// benefit suspension, the triennial test, the written determination and the
// notices with their deadlines; (424) the definitions and special rules for
// statutory stock options: substitution and assumption, disposition, parent
// and subsidiary corporations, modification and the fair market value for a
// modified option.
//
// Method: amounts are exact Money; the 3 times assets test is an exact
// multiplication; deadlines are exact calendar arithmetic from the first day
// of the insolvency year; corporate chains are a recursive relation over the
// case-asserted voting power shares at the time of the grant.

// =====================================================================
// 418E(b) Insolvency
// =====================================================================

use self::{
    Corporation,
    IRC_S418E_A,
    IRC_S418E_B,
    IRC_S418E_C,
    IRC_S418E_D,
    IRC_S418E_E,
    IRC_S418E_F,
    IRC_S424_A,
    IRC_S424_B,
    IRC_S424_C,
    IRC_S424_E,
    IRC_S424_F,
    IRC_S424_H,
    IRC_S424_I,
    MultiemployerPlan,
    Person,
    StockOption,
    TaxableYear,
    multiemployer_plan_sponsor_432,
};

pub relation available_resource_components_418Eb3(plan: MultiemployerPlan, y: TaxableYear, cash_and_marketable: Money, contributions: Money, withdrawal_liability: Money, earnings: Money, administrative: Money, pbgc_owed: Money) kind empirical {
    label en unofficial "the components of the plan's available resources for the plan year, case-asserted (section 418E(b)(3))";
}

pub relation available_resources_418Eb3(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(b)(3): cash, marketable assets, contributions, withdrawal liability payments and earnings, less reasonable administrative expenses and the amounts owed to the PBGC under ERISA section 4261(b)(2)";
}

@source(IRC_S418E_B, relation = formalizes, coverage = exact, quote = "The term \"available resources\" means the plan's cash, marketable assets, contributions, withdrawal liability payments, and earnings, less reasonable administrative expenses and amounts owed for such plan year to the Pension Benefit Guaranty Corporation under section 4261(b)(2) of the Employee Retirement Income Security Act of 1974")
rule AvailableResources418Eb3(plan: MultiemployerPlan, y: TaxableYear, cash: Money, contributions: Money, withdrawal: Money, earnings: Money, admin: Money, pbgc: Money) strict {
    label en official "cash and marketable assets + contributions + withdrawal liability payments + earnings - administrative expenses - PBGC amounts";
    when available_resource_components_418Eb3(plan, y, cash, contributions, withdrawal, earnings, admin, pbgc);
    then available_resources_418Eb3(plan, y, cash + contributions + withdrawal + earnings - admin - pbgc);
}

pub relation benefits_due_418Eb1(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the benefits payable under the plan when due for the plan year, case-asserted";
}

pub relation determined_insolvent_418Ed(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is determined to be insolvent under subsection (d), case-asserted";
}

pub relation plan_insolvent_418Eb1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(b)(1): available resources are not sufficient to pay benefits when due, or the plan is determined insolvent under subsection (d)";
}

@source(IRC_S418E_B, relation = formalizes, coverage = exact, quote = "if the plan's available resources are not sufficient to pay benefits under the plan when due for the plan year")
rule PlanInsolventByResources418Eb1(plan: MultiemployerPlan, y: TaxableYear, resources: Money, due: Money) strict {
    label en official "exact boundary: resources equal to the benefits due are sufficient";
    when available_resources_418Eb3(plan, y, resources) and benefits_due_418Eb1(plan, y, due) and resources < due;
    then plan_insolvent_418Eb1(plan, y);
}

@source(IRC_S418E_B, relation = formalizes, coverage = exact, quote = "or if the plan is determined to be insolvent under subsection (d)")
rule PlanInsolventByDetermination418Eb1(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "a determination under subsection (d)";
    when determined_insolvent_418Ed(plan, y);
    then plan_insolvent_418Eb1(plan, y);
}

pub relation insolvency_year_418Eb4(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(b)(4): a plan year in which the plan is insolvent";
}

@source(IRC_S418E_B, relation = formalizes, coverage = exact, quote = "The term \"insolvency year\" means a plan year in which a plan is insolvent")
rule InsolvencyYear418Eb4(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "the plan is insolvent for the year";
    when plan_insolvent_418Eb1(plan, y);
    then insolvency_year_418Eb4(plan, y);
}

// =====================================================================
// 418E(a) and (c) Benefit suspension
// =====================================================================

pub relation resource_benefit_level_and_basic_418E(plan: MultiemployerPlan, y: TaxableYear, resource_level: Money, basic_level: Money) kind empirical {
    label en unofficial "the resource benefit level (the highest level of monthly benefits payable out of the available resources) and the level of basic benefits, case-asserted (section 418E(b)(2), (c)(1))";
}

pub relation benefit_payments_and_basic_payments_418Ea(plan: MultiemployerPlan, y: TaxableYear, total: Money, basic: Money) kind empirical {
    label en unofficial "the benefit payments under the plan and the payments of basic benefits, case-asserted";
}

pub relation pbgc_alternative_procedure_418Ea(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the PBGC prescribes an alternative procedure, case-asserted";
}

pub relation benefit_suspension_required_418Ea(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(a): the payments that are not basic benefits are suspended to the extent needed to reduce the payments to the greater of the resource benefit level and the level of basic benefits";
}

@source(IRC_S418E_A, relation = formalizes, coverage = partial, quote = "any such payments of benefits which are not basic benefits shall be suspended")
rule BenefitSuspensionRequired418Ea(plan: MultiemployerPlan, y: TaxableYear, level: Money, basic_level: Money, total: Money, basic: Money) strict {
    label en official "PARTIAL: total payments less the greater of the two levels, when positive, in an insolvency year and with no PBGC alternative procedure; the uniform proportions of (c)(2) are not derived";
    when insolvency_year_418Eb4(plan, y)
        and resource_benefit_level_and_basic_418E(plan, y, level, basic_level)
        and benefit_payments_and_basic_payments_418Ea(plan, y, total, basic)
        and total > max(level, basic_level)
        and not_known(pbgc_alternative_procedure_418Ea(plan, y));
    then benefit_suspension_required_418Ea(plan, y, total - max(level, basic_level));
}

pub relation all_nonbasic_benefits_suspended_418Ec3(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(c)(3): the resource benefit level is below the level of basic benefits, so all benefits other than basic benefits are suspended";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "if a plan sponsor determines in writing a resource benefit level for a plan year which is below the level of basic benefits, the payment of all benefits other than basic benefits shall be suspended for that plan year")
rule AllNonbasicSuspended418Ec3(plan: MultiemployerPlan, y: TaxableYear, level: Money, basic_level: Money) strict {
    label en official "exact boundary: a resource benefit level equal to the basic level does not trigger it";
    when insolvency_year_418Eb4(plan, y) and resource_benefit_level_and_basic_418E(plan, y, level, basic_level) and level < basic_level;
    then all_nonbasic_benefits_suspended_418Ec3(plan, y);
}

pub relation cost_at_resource_and_plan_levels_418Ec4(plan: MultiemployerPlan, y: TaxableYear, at_resource_level: Money, at_plan_levels: Money) kind empirical {
    label en unofficial "the amount necessary to support the resource benefit level and the amount necessary to pay the plan year's benefits at the benefit levels under the plan, case-asserted (section 418E(c)(4)(B))";
}

pub relation excess_resources_418Ec4B(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(c)(4)(B): available resources above the amount needed for the resource benefit level, but not above the amount needed to pay the plan-level benefits";
}

@source(IRC_S418E_C, relation = formalizes, coverage = exact, quote = "means available resources above the amount necessary to support the resource benefit level, but no greater than the amount necessary to pay benefits for the plan year at the benefit levels under the plan")
rule ExcessResources418Ec4B(plan: MultiemployerPlan, y: TaxableYear, resources: Money, low: Money, high: Money) strict {
    label en official "max(min(resources, plan-level cost) - resource-level cost, 0)";
    when available_resources_418Eb3(plan, y, resources) and cost_at_resource_and_plan_levels_418Ec4(plan, y, low, high);
    then excess_resources_418Ec4B(plan, y, max(min(resources, high) - low, 0.00 USD));
}

pub relation unpaid_at_resource_level_418Ec5(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts up to the resource benefit level that were not paid by the end of the insolvency year, case-asserted";
}

pub relation retroactive_distribution_ceiling_418Ec5(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 418E(c)(5): the unpaid amounts are distributed to the extent possible taking into account the available resources";
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "to the extent possible taking into account the plan's total available resources in that insolvency year")
rule RetroactiveDistributionCeiling418Ec5(plan: MultiemployerPlan, y: TaxableYear, unpaid: Money, resources: Money) strict {
    label en official "PARTIAL: the ceiling is the lesser of the unpaid amount and the available resources; the regulations on the distribution are not applied";
    when unpaid_at_resource_level_418Ec5(plan, y, unpaid) and available_resources_418Eb3(plan, y, resources);
    then retroactive_distribution_ceiling_418Ec5(plan, y, min(unpaid, max(resources, 0.00 USD)));
}

// =====================================================================
// 418E(d) Plan sponsor determinations
// =====================================================================

pub relation plan_assets_and_benefit_payments_418Ed1(plan: MultiemployerPlan, y: TaxableYear, assets: Money, payments: Money) kind empirical {
    label en unofficial "the value of plan assets and the total benefit payments for the plan year, case-asserted (section 418E(d)(1), (4))";
}

pub relation assets_exceed_three_times_payments_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(d)(1): the value of plan assets exceeds 3 times the benefit payments";
}

@source(IRC_S418E_D, relation = formalizes, coverage = exact, quote = "Unless the plan sponsor determines that the value of plan assets exceeds 3 times the total amount of benefit payments")
rule AssetsExceedThreeTimes418Ed1(plan: MultiemployerPlan, y: TaxableYear, assets: Money, payments: Money) strict {
    label en official "exact boundary: assets equal to 3 times the payments do not exceed it";
    when plan_assets_and_benefit_payments_418Ed1(plan, y, assets, payments) and assets > payments * 3.0;
    then assets_exceed_three_times_payments_418Ed1(plan, y);
}

pub relation insolvency_projection_required_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(d)(1): the sponsor must determine whether the plan will be insolvent in any of the next 5 plan years";
}

pub relation triennial_test_year_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year is the end of the first year in critical status, or a year at least every 3 years thereafter while the plan remains in critical status, or a year of the annual comparison, case-asserted";
}

@source(IRC_S418E_D, relation = formalizes, coverage = exact, quote = "the plan sponsor shall determine whether the plan will be insolvent in any of the next 5 plan years")
rule InsolvencyProjectionRequired418Ed1(plan: MultiemployerPlan, y: TaxableYear, assets: Money, payments: Money) strict {
    label en official "a comparison year in which the assets do not exceed 3 times the payments";
    when triennial_test_year_418Ed1(plan, y)
        and plan_assets_and_benefit_payments_418Ed1(plan, y, assets, payments)
        and assets <= payments * 3.0;
    then insolvency_projection_required_418Ed1(plan, y);
}

pub relation projected_insolvent_within_5_years_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor determines that the plan will be insolvent in any of the next 5 plan years, case-asserted";
}

pub relation annual_comparison_required_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(d)(1): after such a determination the comparison is made at least annually until the plan is projected not to be insolvent";
}

@source(IRC_S418E_D, relation = formalizes, coverage = exact, quote = "the plan sponsor shall make the comparison under this paragraph at least annually until the plan sponsor makes a determination that the plan will not be insolvent in any of the next 5 plan years")
rule AnnualComparisonRequired418Ed1(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "annual comparison after a projected insolvency";
    when projected_insolvent_within_5_years_418Ed1(plan, y);
    then annual_comparison_required_418Ed1(plan, y);
}

pub relation plan_year_end_418Ed1(plan: MultiemployerPlan, y: TaxableYear, end: Date) kind empirical {
    label en unofficial "the last day of the plan year, case-asserted";
}

pub relation insolvency_projection_determined_418Ed1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor has determined whether the plan will be insolvent in any of the next 5 plan years, case-asserted (goal atom)";
}

@source(IRC_S418E_D, relation = formalizes, coverage = partial, quote = "the plan sponsor shall compare the value of plan assets for that plan year with the total amount of benefit payments made under the plan for that plan year")
rule InsolvencyProjectionDuty418Ed1(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, end: Date) strict {
    label en official "PARTIAL: as of the end of the plan year; the duty to compare at least every 3 years is the case-asserted test year";
    when insolvency_projection_required_418Ed1(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and plan_year_end_418Ed1(plan, y, end);
    then duty DetermineInsolvencyProjectionDuty {
        bearer sponsor;
        goal achievement {
            condition insolvency_projection_determined_418Ed1(plan, y);
            window [-infinity, end];
        }
    };
}

pub relation insolvency_year_start_418E(plan: MultiemployerPlan, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the insolvency year, case-asserted";
}

pub relation resource_benefit_level_determined_in_writing_418Ed3(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor has determined in writing the resource benefit level and the level of basic benefits for the insolvency year, case-asserted (goal atom)";
}

@source(IRC_S418E_D, relation = formalizes, coverage = exact, quote = "shall determine in writing for each insolvency year the resource benefit level and the level of basic benefits no later than 3 months before the insolvency year")
rule ResourceLevelDeterminationDuty418Ed3(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, start: Date, calendar_before_1: Date) strict {
    label en official "the written determination is due 3 calendar months before the first day of the insolvency year";
    when insolvency_year_418Eb4(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and insolvency_year_start_418E(plan, y, start)
        and us.irc.core::civil_calendar_boundary_before(start, 3, us.irc.core::CalendarMonth, calendar_before_1);
    then duty DetermineResourceBenefitLevelDuty {
        bearer sponsor;
        goal achievement {
            condition resource_benefit_level_determined_in_writing_418Ed3(plan, y);
            window [-infinity, calendar_before_1];
        }
    };
}

pub relation resource_benefit_level_notified_418Ee2(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor has notified the Secretary, the PBGC, the parties described in section 418A(a)(2) and the participants and beneficiaries of the resource benefit level, case-asserted (goal atom)";
}

@source(IRC_S418E_E, relation = formalizes, coverage = exact, quote = "No later than 2 months before the first day of each insolvency year")
rule ResourceLevelNoticeDuty418Ee2(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, start: Date, calendar_before_1: Date) strict {
    label en official "the notice is due 2 calendar months before the first day of the insolvency year";
    when insolvency_year_418Eb4(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and insolvency_year_start_418E(plan, y, start)
        and us.irc.core::civil_calendar_boundary_before(start, 2, us.irc.core::CalendarMonth, calendar_before_1);
    then duty NotifyResourceBenefitLevelDuty {
        bearer sponsor;
        goal achievement {
            condition resource_benefit_level_notified_418Ee2(plan, y);
            window [-infinity, calendar_before_1];
        }
    };
}

// =====================================================================
// 418E(f) Financial assistance
// =====================================================================

pub relation applies_for_pbgc_assistance_418Ef1(sponsor: Person, pbgc: Person, plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor applies for financial assistance from the PBGC under ERISA section 4261, case-asserted (exercise atom)";
}

pub relation resource_level_above_basic_418Ef1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 418E(f)(1): the resource benefit level of the insolvent plan is above the level of basic benefits";
}

@source(IRC_S418E_F, relation = formalizes, coverage = exact, quote = "If the plan sponsor of an insolvent plan for which the resource benefit level is above the level of basic benefits")
rule ResourceLevelAboveBasic418Ef1(plan: MultiemployerPlan, y: TaxableYear, level: Money, basic_level: Money) strict {
    label en official "exact boundary: a resource benefit level equal to the basic level is not above it";
    when plan_insolvent_418Eb1(plan, y) and resource_benefit_level_and_basic_418E(plan, y, level, basic_level) and level > basic_level;
    then resource_level_above_basic_418Ef1(plan, y);
}

pub relation pbgc_assistance_applied_418Ef1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "the application for PBGC financial assistance is made for the plan year";
}

pub relation pbgc_party_418Ef(plan: MultiemployerPlan, pbgc: Person) kind empirical {
    label en unofficial "the Pension Benefit Guaranty Corporation as the recipient of the application, case-asserted";
}

@source(IRC_S418E_F, relation = formalizes, coverage = partial, quote = "the plan sponsor may apply for financial assistance from the Pension Benefit Guaranty Corporation under section 4261 of the Employee Retirement Income Security Act of 1974")
rule ApplyForPbgcAssistancePower418Ef1(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, pbgc: Person) strict {
    label en official "PARTIAL: the power exists for an insolvent plan; the anticipation of a funding shortfall for basic benefits is case-asserted by the exercise";
    when multiemployer_plan_sponsor_432(plan, sponsor) and pbgc_party_418Ef(plan, pbgc) and applies_for_pbgc_assistance_418Ef1(sponsor, pbgc, plan, y);
    then power ApplyForPbgcAssistancePower {
        holder sponsor;
        over pbgc;
        exercise applies_for_pbgc_assistance_418Ef1(sponsor, pbgc, plan, y);
        valid_when resource_level_above_basic_418Ef1(plan, y);
        effect pbgc_assistance_applied_418Ef1(plan, y);
    };
}

// =====================================================================
// 424(a) Substitution and assumption
// =====================================================================

pub relation option_transaction_424a(opt: StockOption) kind empirical {
    label en unofficial "a new option is substituted for the old option or the old option is assumed by an employer corporation or its parent or subsidiary by reason of a corporate merger, consolidation, acquisition of property or stock, separation, reorganization or liquidation, case-asserted";
}

pub relation option_spread_before_and_after_424a1(opt: StockOption, before: Money, after: Money) kind empirical {
    label en unofficial "the excess of the aggregate fair market value of the shares over the aggregate option price immediately before and immediately after the substitution or assumption, case-asserted";
}

pub relation new_option_gives_additional_benefits_424a2(opt: StockOption) kind empirical {
    label en unofficial "the new option or the assumption gives the employee additional benefits he did not have under the old option, case-asserted";
}

pub relation issuing_or_assuming_option_424a(opt: StockOption) kind institutional {
    label en official "section 424(a): issuing or assuming a stock option in a transaction to which section 424(a) applies";
}

@source(IRC_S424_A, relation = formalizes, coverage = exact, quote = "the excess of the aggregate fair market value of the shares subject to the option immediately after the substitution or assumption over the aggregate option price of such shares is not more than the excess of the aggregate fair market value of all shares subject to the option immediately before such substitution or assumption over the aggregate option price of such shares")
rule IssuingOrAssumingOption424a(opt: StockOption, before: Money, after: Money) strict {
    label en official "(1) the spread after is not more than the spread before (exact boundary: equal spreads qualify) and (2) no additional benefits";
    when option_transaction_424a(opt)
        and option_spread_before_and_after_424a1(opt, before, after)
        and after <= before
        and not_known(new_option_gives_additional_benefits_424a2(opt));
    then issuing_or_assuming_option_424a(opt);
}

// =====================================================================
// 424(b), (c) Distributions and dispositions
// =====================================================================

pub relation stock_received_in_distribution_on_exercise_424b(opt: StockOption) kind empirical {
    label en unofficial "stock is received in a distribution to which section 305, 354, 355, 356 or 1036 applies with respect to stock transferred upon exercise of the option, case-asserted";
}

pub relation stock_considered_transferred_on_exercise_424b(opt: StockOption) kind institutional {
    label en official "section 424(b): the distributed stock is considered as transferred on the exercise of the option";
}

@source(IRC_S424_B, relation = formalizes, coverage = exact, quote = "such stock shall be considered as having been transferred to him on his exercise of such option")
rule DistributedStockTransferredOnExercise424b(opt: StockOption) strict {
    label en official "the distributed stock is treated as transferred on exercise";
    when stock_received_in_distribution_on_exercise_424b(opt);
    then stock_considered_transferred_on_exercise_424b(opt);
}

pub enum TransferKind424 {
    Sale;
    ExchangeOfProperty;
    Gift;
    TransferOfLegalTitle;
    DecedentToEstate;
    BequestOrInheritance;
    TaxFreeExchange354To1036;
    PledgeOrHypothecation;
    JointOwnershipWithSurvivorship;
    SpousalTransfer1041;
}

pub relation stock_transfer_424c(opt: StockOption, kind: TransferKind424) kind empirical {
    label en unofficial "the kind of transfer of the option stock, case-asserted";
}

pub relation stock_is_statutory_option_stock_424c3B(opt: StockOption) kind empirical {
    label en unofficial "the stock was acquired through the exercise of an incentive stock option or an option granted under an employee stock purchase plan, case-asserted";
}

pub relation transfer_in_connection_with_iso_exercise_424c3A(opt: StockOption) kind empirical {
    label en unofficial "the transfer is in connection with the exercise of an incentive stock option, case-asserted";
}

pub relation holding_period_requirements_met_before_transfer_424c3A(opt: StockOption) kind empirical {
    label en unofficial "the holding period requirements under section 422(a)(1) or 423(a)(1) are met before the transfer, case-asserted";
}

pub relation disposition_424c1(opt: StockOption) kind institutional {
    label en official "section 424(c)(1): a sale, exchange, gift or transfer of legal title, other than the excluded transfers";
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "the term \"disposition\" includes a sale, exchange, gift, or a transfer of legal title")
rule DispositionSale424c1(opt: StockOption) strict {
    label en official "a sale";
    when stock_transfer_424c(opt, Sale);
    then disposition_424c1(opt);
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "the term \"disposition\" includes a sale, exchange, gift, or a transfer of legal title")
rule DispositionExchange424c1(opt: StockOption) strict {
    label en official "an exchange";
    when stock_transfer_424c(opt, ExchangeOfProperty);
    then disposition_424c1(opt);
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "the term \"disposition\" includes a sale, exchange, gift, or a transfer of legal title")
rule DispositionGift424c1(opt: StockOption) strict {
    label en official "a gift";
    when stock_transfer_424c(opt, Gift);
    then disposition_424c1(opt);
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "the term \"disposition\" includes a sale, exchange, gift, or a transfer of legal title")
rule DispositionLegalTitle424c1(opt: StockOption) strict {
    label en official "a transfer of legal title";
    when stock_transfer_424c(opt, TransferOfLegalTitle);
    then disposition_424c1(opt);
}

@source(IRC_S424_C, relation = formalizes, coverage = exact, quote = "then no section referred to in subparagraph (B) of paragraph (1) shall apply to such transfer")
rule DispositionTaxFreeExchangeOfStatutoryStock424c3(opt: StockOption) strict {
    label en official "(3): a tax-free exchange of statutory option stock in connection with an ISO exercise, before the holding period requirements are met, is a disposition";
    when stock_transfer_424c(opt, TaxFreeExchange354To1036)
        and stock_is_statutory_option_stock_424c3B(opt)
        and transfer_in_connection_with_iso_exercise_424c3A(opt)
        and not_known(holding_period_requirements_met_before_transfer_424c3A(opt));
    then disposition_424c1(opt);
}

// =====================================================================
// 424(e), (f) Parent and subsidiary corporations
// =====================================================================

pub relation voting_power_share_at_grant_424(owner: Corporation, owned: Corporation, share: Decimal) kind empirical {
    label en unofficial "the share of the total combined voting power of all classes of stock of the owned corporation that the owner holds at the time of the granting of the option (a fraction), case-asserted";
}

pub relation parent_corporation_424e(parent: Corporation, employer: Corporation) kind institutional {
    label en official "section 424(e): a corporation in an unbroken chain of corporations ending with the employer corporation, each owning 50 percent or more of the next (chains of up to 4 corporations are derived: the relation is not recursive)";
}

pub relation parent_chain_2_424e(parent: Corporation, employer: Corporation) kind institutional {
    label en unofficial "a parent that reaches the employer corporation through one intermediate corporation";
}

pub relation parent_chain_3_424e(parent: Corporation, employer: Corporation) kind institutional {
    label en unofficial "a parent that reaches the employer corporation through two intermediate corporations";
}

@source(IRC_S424_E, relation = formalizes, coverage = exact, quote = "owns stock possessing 50 percent or more of the total combined voting power of all classes of stock in one of the other corporations in such chain")
rule ParentCorporationDirect424e(parent: Corporation, employer: Corporation, share: Decimal) strict {
    label en official "exact boundary: 50 percent; the parent directly holds the employer corporation";
    when voting_power_share_at_grant_424(parent, employer, share) and share >= 0.50 and parent != employer;
    then parent_corporation_424e(parent, employer);
}

@source(IRC_S424_E, relation = formalizes, coverage = exact, quote = "in an unbroken chain of corporations ending with the employer corporation")
rule ParentChain2_424e(parent: Corporation, middle: Corporation, employer: Corporation, share: Decimal, share2: Decimal) strict {
    label en official "a chain of 3 corporations";
    when voting_power_share_at_grant_424(parent, middle, share) and share >= 0.50
        and voting_power_share_at_grant_424(middle, employer, share2) and share2 >= 0.50
        and parent != employer and parent != middle and middle != employer;
    then parent_chain_2_424e(parent, employer);
}

rule ParentChain3_424e(parent: Corporation, m1: Corporation, m2: Corporation, employer: Corporation, s1: Decimal, s2: Decimal, s3: Decimal) strict {
    label en official "a chain of 4 corporations";
    when voting_power_share_at_grant_424(parent, m1, s1) and s1 >= 0.50
        and voting_power_share_at_grant_424(m1, m2, s2) and s2 >= 0.50
        and voting_power_share_at_grant_424(m2, employer, s3) and s3 >= 0.50
        and parent != employer and parent != m1 and parent != m2 and m1 != m2 and m1 != employer and m2 != employer;
    then parent_chain_3_424e(parent, employer);
}

rule ParentCorporationViaChain2_424e(parent: Corporation, employer: Corporation) strict {
    label en official "the 3-corporation chain is a parent";
    when parent_chain_2_424e(parent, employer);
    then parent_corporation_424e(parent, employer);
}

rule ParentCorporationViaChain3_424e(parent: Corporation, employer: Corporation) strict {
    label en official "the 4-corporation chain is a parent";
    when parent_chain_3_424e(parent, employer);
    then parent_corporation_424e(parent, employer);
}

pub relation subsidiary_corporation_424f(sub: Corporation, employer: Corporation) kind institutional {
    label en official "section 424(f): a corporation in an unbroken chain of corporations beginning with the employer corporation, each owning 50 percent or more of the next (chains of up to 4 corporations are derived: the relation is not recursive)";
}

pub relation subsidiary_chain_2_424f(sub: Corporation, employer: Corporation) kind institutional {
    label en unofficial "a subsidiary reached from the employer corporation through one intermediate corporation";
}

pub relation subsidiary_chain_3_424f(sub: Corporation, employer: Corporation) kind institutional {
    label en unofficial "a subsidiary reached from the employer corporation through two intermediate corporations";
}

@source(IRC_S424_F, relation = formalizes, coverage = exact, quote = "owns stock possessing 50 percent or more of the total combined voting power of all classes of stock in one of the other corporations in such chain")
rule SubsidiaryCorporationDirect424f(sub: Corporation, employer: Corporation, share: Decimal) strict {
    label en official "exact boundary: 50 percent; the employer corporation directly holds the subsidiary";
    when voting_power_share_at_grant_424(employer, sub, share) and share >= 0.50 and sub != employer;
    then subsidiary_corporation_424f(sub, employer);
}

@source(IRC_S424_F, relation = formalizes, coverage = exact, quote = "in an unbroken chain of corporations beginning with the employer corporation")
rule SubsidiaryChain2_424f(sub: Corporation, middle: Corporation, employer: Corporation, share: Decimal, share2: Decimal) strict {
    label en official "a chain of 3 corporations";
    when voting_power_share_at_grant_424(employer, middle, share) and share >= 0.50
        and voting_power_share_at_grant_424(middle, sub, share2) and share2 >= 0.50
        and sub != employer and sub != middle and middle != employer;
    then subsidiary_chain_2_424f(sub, employer);
}

rule SubsidiaryChain3_424f(sub: Corporation, m1: Corporation, m2: Corporation, employer: Corporation, s1: Decimal, s2: Decimal, s3: Decimal) strict {
    label en official "a chain of 4 corporations";
    when voting_power_share_at_grant_424(employer, m1, s1) and s1 >= 0.50
        and voting_power_share_at_grant_424(m1, m2, s2) and s2 >= 0.50
        and voting_power_share_at_grant_424(m2, sub, s3) and s3 >= 0.50
        and sub != employer and sub != m1 and sub != m2 and m1 != m2 and m1 != employer and m2 != employer;
    then subsidiary_chain_3_424f(sub, employer);
}

rule SubsidiaryCorporationViaChain2_424f(sub: Corporation, employer: Corporation) strict {
    label en official "the 3-corporation chain is a subsidiary";
    when subsidiary_chain_2_424f(sub, employer);
    then subsidiary_corporation_424f(sub, employer);
}

rule SubsidiaryCorporationViaChain3_424f(sub: Corporation, employer: Corporation) strict {
    label en official "the 4-corporation chain is a subsidiary";
    when subsidiary_chain_3_424f(sub, employer);
    then subsidiary_corporation_424f(sub, employer);
}

// =====================================================================
// 424(h) Modification, extension, renewal
// =====================================================================

pub relation option_terms_changed_424h(opt: StockOption) kind empirical {
    label en unofficial "the terms of the option are modified, extended or renewed, case-asserted";
}

pub relation change_gives_additional_benefits_424h3(opt: StockOption) kind empirical {
    label en unofficial "the change in the terms gives the employee additional benefits under the option, case-asserted";
}

pub relation change_attributable_to_424a_424h3A(opt: StockOption) kind empirical {
    label en unofficial "the change is attributable to the issuance or assumption of an option under subsection (a), case-asserted";
}

pub relation change_permits_qualification_423b9_424h3B(opt: StockOption) kind empirical {
    label en unofficial "the change permits the option to qualify under section 423(b)(9), case-asserted";
}

pub relation change_accelerates_exercise_time_424h3C(opt: StockOption) kind empirical {
    label en unofficial "for an option not immediately exercisable in full, the change accelerates the time at which the option may be exercised, case-asserted";
}

pub relation modification_424h3(opt: StockOption) kind institutional {
    label en official "section 424(h)(3): a change that gives additional benefits, other than the three excepted changes";
}

@source(IRC_S424_H, relation = formalizes, coverage = exact, quote = "The term \"modification\" means any change in the terms of the option which gives the employee additional benefits under the option")
rule Modification424h3(opt: StockOption) strict {
    label en official "additional benefits and none of (A), (B), (C)";
    when change_gives_additional_benefits_424h3(opt)
        and not_known(change_attributable_to_424a_424h3A(opt))
        and not_known(change_permits_qualification_423b9_424h3B(opt))
        and not_known(change_accelerates_exercise_time_424h3C(opt));
    then modification_424h3(opt);
}

pub relation deemed_new_grant_424h1(opt: StockOption) kind institutional {
    label en official "section 424(h)(1): a modification, extension or renewal is considered as the granting of a new option";
}

@source(IRC_S424_H, relation = formalizes, coverage = partial, quote = "such modification, extension, or renewal shall be considered as the granting of a new option")
rule DeemedNewGrant424h1(opt: StockOption) strict {
    label en official "PARTIAL: an option whose terms are changed by a modification (extension and renewal are case-asserted as terms changes)";
    when option_terms_changed_424h(opt) and modification_424h3(opt);
    then deemed_new_grant_424h1(opt);
}

pub relation fair_market_values_for_modified_423_option_424h2(opt: StockOption, original: Money, at_modification: Money, intervening: Money) kind empirical {
    label en unofficial "the fair market value of the stock at the original grant, at the modification, extension or renewal, and at the highest intervening one, case-asserted";
}

pub relation fair_market_value_at_grant_of_modified_423_option_424h2(opt: StockOption, amount: Money) kind institutional {
    label en official "section 424(h)(2): for a modified section 423 option, the fair market value at the granting is the highest of the three";
}

@source(IRC_S424_H, relation = formalizes, coverage = exact, quote = "the fair market value of such stock at the time of the granting of the option shall be considered as whichever of the following is the highest")
rule FairMarketValueOfModified423Option424h2(opt: StockOption, a: Money, b: Money, c: Money) strict {
    label en official "max of the original grant value, the value at modification and the value at any intervening modification";
    when fair_market_values_for_modified_423_option_424h2(opt, a, b, c);
    then fair_market_value_at_grant_of_modified_423_option_424h2(opt, max(a, max(b, c)));
}

// =====================================================================
// 424(i) Stockholder approval
// =====================================================================

pub relation grant_date_apart_from_stockholder_approval_424i(opt: StockOption, on: Date) kind empirical {
    label en unofficial "the date of grant determined as if the option had not been subject to stockholder approval, case-asserted";
}

pub relation option_grant_subject_to_stockholder_approval_424i(opt: StockOption) kind empirical {
    label en unofficial "the grant of the option is subject to approval by stockholders, case-asserted";
}

pub relation date_of_grant_424i(opt: StockOption, on: Date) kind institutional {
    label en official "section 424(i): the date of grant is determined as if the option had not been subject to stockholder approval";
}

@source(IRC_S424_I, relation = formalizes, coverage = exact, quote = "the date of grant of the option shall be determined as if the option had not been subject to such approval")
rule DateOfGrantIgnoresApproval424i(opt: StockOption, on: Date) strict {
    label en official "the approval date does not move the date of grant";
    when option_grant_subject_to_stockholder_approval_424i(opt) and grant_date_apart_from_stockholder_approval_424i(opt, on);
    then date_of_grant_424i(opt, on);
}
