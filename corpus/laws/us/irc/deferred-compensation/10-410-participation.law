// Section 410 — minimum participation standards. Stage 1 (IRC-09),
// DECISION-0379. Priority: (a) age/service, (b) coverage tests (70 percent
// ratio percentage as an exact computation).


// =====================================================================
// (a) Participation: minimum age and service
// =====================================================================

use self::{
    IRC_S410_A,
    IRC_S410_B,
    Person,
    Plan,
    TaxableYear,
};

pub relation years_of_service(who: Person, plan: Plan, years: Decimal) kind empirical {
    label en unofficial "the individual's years of service with the employer(s) maintaining the plan, computed under the plan's own year-of-service rule (section 410(a)(3)); case-asserted rather than derived from an hours-of-service ledger (TECH_GAP: no standard aggregate over the 1,000-hours-per-12-month test is formalized in this stage)";
}

pub relation attained_age(who: Person, on: Date, age: Integer) kind empirical {
    label en unofficial "this individual's age on this date, case-asserted";
}

pub relation two_year_full_vesting_plan(plan: Plan) kind empirical {
    label en unofficial "the plan provides 100 percent nonforfeitable vesting after not more than 2 years of service (section 410(a)(1)(B)(i)), which substitutes \"2 years\" for \"1 year\" below, case-asserted";
}

pub relation meets_410a_participation(plan: Plan, y: TaxableYear) kind institutional {
    label en official "the plan's minimum age and service participation condition of section 410(a)(1) — this predicate reports the RULE, not a per-employee eligibility fact; see `eligible_to_participate_410a` for the per-employee test";
}

pub relation eligible_to_participate_410a(who: Person, plan: Plan, on: Date) kind institutional {
    label en official "this individual has satisfied the section 410(a)(1) minimum age and service conditions as of this date";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "the date on which the employee attains the age of 21")
rule EligibleToParticipate410aOneYear(who: Person, plan: Plan, on: Date, age: Integer, svc: Decimal) strict {
    label en official "eligible once both age 21 and 1 year of service are reached, for plans other than a 2-year-100%-vesting plan";
    when attained_age(who, on, age) and age >= 21
        and years_of_service(who, plan, svc) and svc >= 1.0
        and not two_year_full_vesting_plan(plan);
    then eligible_to_participate_410a(who, plan, on);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "clause (ii) of subparagraph (A) shall be applied by substituting \"2 years of service\" for \"1 year of service\"")
rule EligibleToParticipate410aTwoYear(who: Person, plan: Plan, on: Date, age: Integer, svc: Decimal) strict {
    label en official "eligible once both age 21 and 2 years of service are reached, for a plan with 100% vesting after at most 2 years";
    when attained_age(who, on, age) and age >= 21
        and years_of_service(who, plan, svc) and svc >= 2.0
        and two_year_full_vesting_plan(plan);
    then eligible_to_participate_410a(who, plan, on);
}
// Maximum age exclusion (a)(2), educational-institution 26/1-year special
// rule (a)(1)(B)(ii), time-of-participation entry-date rule (a)(4), and the
// break-in-service rules (a)(5) are NOT modelled in this stage (TECH_GAP /
// stage 2) — see coverage notes.

// =====================================================================
// (b) Minimum coverage: 70 percent ratio percentage test
// =====================================================================
// Method: counts of "employees who are not highly compensated employees"
// benefiting/total are read as CASE-ASSERTED aggregate facts rather than
// derived by summing over the section 414(q) `highly_compensated_employee`
// classification, because summing over a DERIVED predicate is this
// runtime's documented aggregate-over-derived-predicate limitation
// (section 111, core-surfaces.md "Classify an execution refusal"). The
// RATIO ARITHMETIC and the 70-percent comparison are the executable part.

pub relation nhce_count(plan: Plan, y: TaxableYear, total: Decimal, benefiting: Decimal) kind empirical {
    label en unofficial "the number of non-highly-compensated employees of the employer, and how many of them benefit under the plan, for this plan year (case-asserted census counts; section 410(b)(3)/(4) exclusions applied by the case, not re-derived here)";
}

pub relation hce_count(plan: Plan, y: TaxableYear, total: Decimal, benefiting: Decimal) kind empirical {
    label en unofficial "the number of highly compensated employees of the employer, and how many of them benefit under the plan, for this plan year (case-asserted census counts)";
}

pub relation ratio_percentage(plan: Plan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "the section 410(b)(1)(B) ratio percentage: the percentage of NHCEs benefiting, divided by the percentage of HCEs benefiting, times 100";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "a percentage of employees who are not highly compensated employees which is at least 70 percent of")
rule RatioPercentageComputation(plan: Plan, y: TaxableYear, nhce_total: Decimal, nhce_ben: Decimal, hce_total: Decimal, hce_ben: Decimal) strict {
    label en official "ratio percentage = (NHCE benefiting % ) / (HCE benefiting %) * 100";
    when nhce_count(plan, y, nhce_total, nhce_ben) and nhce_total > 0.0
        and hce_count(plan, y, hce_total, hce_ben) and hce_total > 0.0 and hce_ben > 0.0;
    then ratio_percentage(plan, y,
        div_round(div_round(nhce_ben, nhce_total, 10, "HALF_UP"), div_round(hce_ben, hce_total, 10, "HALF_UP"), 4, "HALF_UP") * 100.0);
}

pub relation meets_ratio_percentage_test(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(1)(B): the ratio percentage is at least 70";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the percentage of highly compensated employees benefiting under the plan")
rule MeetsRatioPercentageTest(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "the ratio percentage test is met at exactly 70 or above (a boundary scenario tests 70 vs 69.9)";
    when ratio_percentage(plan, y, pct) and pct >= 70.0;
    then meets_ratio_percentage_test(plan, y);
}

pub relation meets_70_percent_test(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(1)(A): the plan benefits at least 70 percent of employees who are not highly compensated employees";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "The plan benefits at least 70 percent of employees who are not highly compensated employees.")
rule Meets70PercentTest(plan: Plan, y: TaxableYear, total: Decimal, benefiting: Decimal) strict {
    label en official "at least 70 percent of NHCEs benefit under the plan";
    when nhce_count(plan, y, total, benefiting) and total > 0.0
        and div_round(benefiting, total, 4, "HALF_UP") >= 0.70;
    then meets_70_percent_test(plan, y);
}

pub relation meets_410b_coverage(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(1): the plan meets minimum coverage via the 70-percent test or the ratio-percentage test";
}

@source(IRC_S410_B, relation = formalizes, coverage = partial, quote = "A trust shall not constitute a qualified trust under section 401(a) unless such trust is designated by the employer as part of a plan which meets 1 of the following requirements")
rule Meets410bCoverage(plan: Plan, y: TaxableYear) strict {
    label en official "coverage requirement satisfied by either statutory test (the average benefit percentage test of (b)(2) is NOT modelled in this stage — TECH_GAP)";
    when meets_70_percent_test(plan, y) or meets_ratio_percentage_test(plan, y);
    then meets_410b_coverage(plan, y);
}
