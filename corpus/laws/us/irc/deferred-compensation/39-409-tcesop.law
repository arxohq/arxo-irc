// Section 409 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): tax credit
// employee stock ownership plans and the ESOP rules of section 409 that also
// bind other employee stock ownership plans: (a) the definition, (b)
// allocation in proportion to compensation, (c) nonforfeitability, (d) the
// 84-month distribution restriction, (e) voting rights, (f) establishment
// timing, (h) put options and repurchase installments, (i) expense
// reimbursement, (n) the nonallocation period of a section 1042 sale, (o)
// the distribution timing and period, and (p) S corporation nonallocation
// years and disqualified persons.
//
// Method: amounts are exact Money arithmetic; percentages are exact integer
// cross-multiplications; dates use exact calendar arithmetic (scenarios need
// the IRC calendar-step policy); position windows are stated where the text
// gives one. The dollar amounts of (b)(2) and (o)(1)(C) are the pinned bases
// (the latter is indexed under section 415(d): SOURCE_GAP).

// =====================================================================
// (a) Tax credit employee stock ownership plan
// =====================================================================

use self::{
    Distribution,
    IRC_S409_A,
    IRC_S409_B,
    IRC_S409_C,
    IRC_S409_D,
    IRC_S409_E,
    IRC_S409_F,
    IRC_S409_H,
    IRC_S409_I,
    IRC_S409_N,
    IRC_S409_O,
    IRC_S409_P,
    Person,
    Plan,
    TaxableYear,
};

pub relation tcesop_plan_meets_401a_409a(plan: Plan) kind empirical {
    label en unofficial "the plan meets the requirements of section 401(a), case-asserted (section 409(a)(1))";
}

pub relation tcesop_invests_primarily_in_employer_securities_409a(plan: Plan) kind empirical {
    label en unofficial "the plan is designed to invest primarily in employer securities, case-asserted ((a)(2))";
}

pub relation tcesop_meets_409_subsections_409a3(plan: Plan) kind empirical {
    label en unofficial "the plan meets subsections (b), (c), (d), (e), (f), (g), (h) and (o), case-asserted ((a)(3))";
}

pub relation tax_credit_employee_stock_ownership_plan_409a(plan: Plan) kind institutional {
    label en official "section 409(a): a plan that meets section 401(a), invests primarily in employer securities and meets subsections (b)-(h) and (o)";
}

@source(IRC_S409_A, relation = formalizes, coverage = exact, quote = "is designed to invest primarily in employer securities")
rule TaxCreditEsop409a(plan: Plan) strict {
    label en official "(1), (2), (3)";
    when tcesop_plan_meets_401a_409a(plan)
        and tcesop_invests_primarily_in_employer_securities_409a(plan)
        and tcesop_meets_409_subsections_409a3(plan);
    then tax_credit_employee_stock_ownership_plan_409a(plan);
}

// =====================================================================
// (b) Allocation in proportion to compensation
// =====================================================================

pub relation tcesop_pool_of_securities_409b(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of all employer securities allocated to all participants entitled to share for the plan year, case-asserted (section 409(b)(1)(A))";
}

pub relation tcesop_participant_compensation_409b(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind empirical {
    label en unofficial "the compensation paid to the participant during the year, case-asserted (section 409(b)(1)(B), (3))";
}

pub relation tcesop_capped_compensation_409b2(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind institutional {
    label en official "section 409(b)(2): compensation in excess of the first $100,000 per year is disregarded";
}

@source(IRC_S409_B, relation = formalizes, coverage = partial, quote = "compensation of any participant in excess of the first $100,000 per year shall be disregarded")
rule TcesopCappedCompensation409b2(plan: Plan, y: TaxableYear, participant: Person, comp: Money) strict {
    label en official "PARTIAL: min(compensation, $100,000); the pinned amount";
    when tcesop_participant_compensation_409b(plan, y, participant, comp);
    then tcesop_capped_compensation_409b2(plan, y, participant, min(comp, 100000.00 USD));
}

pub relation tcesop_expected_allocation_409b1(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind institutional {
    label en official "section 409(b)(1)(B): the participant's allocation in the proportion of the participant's capped compensation to all participants' capped compensation";
}

pub relation tcesop_total_capped_compensation_409b(plan: Plan, y: TaxableYear, total: Money) kind institutional {
    label en official "the compensation of all participants after the (b)(2) cap";
}

rule TcesopTotalCappedCompensation409b(plan: Plan, y: TaxableYear, first: Person, amount: Money) strict {
    label en unofficial "sum over the participants' capped compensation";
    when tcesop_capped_compensation_409b2(plan, y, first, amount);
    then tcesop_total_capped_compensation_409b(plan, y,
        sum all c: Money for p: Person where tcesop_capped_compensation_409b2(plan, y, p, c));
}

@source(IRC_S409_B, relation = formalizes, coverage = partial, quote = "the allocation to each participant so entitled is an amount which bears substantially the same proportion to the amount of all such securities allocated to all such participants in the plan for that year as the amount of compensation paid to such participant during that year bears to the compensation paid to all such participants during that year")
rule TcesopExpectedAllocation409b1(plan: Plan, y: TaxableYear, participant: Person, pool: Money, own: Money, total: Money) strict {
    label en official "PARTIAL: pool x (own capped compensation / total capped compensation), exact quotient rounded to the cent; the compensation of section 409(b)(3) is asserted";
    when tcesop_pool_of_securities_409b(plan, y, pool)
        and tcesop_capped_compensation_409b2(plan, y, participant, own)
        and tcesop_total_capped_compensation_409b(plan, y, total)
        and total > 0.00 USD;
    then tcesop_expected_allocation_409b1(plan, y, participant, round(pool * (own / total), 2, "HALF_UP"));
}

pub relation tcesop_actual_allocation_409b(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind empirical {
    label en unofficial "the amount actually allocated to the participant, case-asserted";
}

pub relation tcesop_allocation_tolerance_409b(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the difference from the exact proportion the reading of \"substantially\" allows, case-asserted (INTERPRETATION: the statute states no tolerance)";
}

pub relation tcesop_allocation_substantially_proportional_409b1(plan: Plan, y: TaxableYear, participant: Person) kind institutional {
    label en official "section 409(b)(1)(B): the actual allocation is within the tolerance of the exact proportional amount";
}

@source(IRC_S409_B, relation = formalizes, coverage = partial, quote = "bears substantially the same proportion")
rule TcesopAllocationSubstantiallyProportional409b1(plan: Plan, y: TaxableYear, participant: Person, expected: Money, actual: Money, tolerance: Money) strict {
    label en official "PARTIAL: |actual - expected| <= tolerance; the tolerance is a case-supplied reading of substantially";
    when tcesop_expected_allocation_409b1(plan, y, participant, expected)
        and tcesop_actual_allocation_409b(plan, y, participant, actual)
        and tcesop_allocation_tolerance_409b(plan, tolerance)
        and actual >= expected - tolerance
        and actual <= expected + tolerance;
    then tcesop_allocation_substantially_proportional_409b1(plan, y, participant);
}

// =====================================================================
// (c) Nonforfeitability; (d) 84-month distribution restriction
// =====================================================================

pub relation tcesop_plan_provides_nonforfeitable_409c(plan: Plan) kind empirical {
    label en unofficial "the plan provides that each participant has a nonforfeitable right to the employer securities allocated to the account, case-asserted (section 409(c))";
}

pub relation tcesop_meets_409c(plan: Plan) kind institutional {
    label en official "section 409(c): the plan provides full nonforfeitability of allocated employer securities";
}

@source(IRC_S409_C, relation = formalizes, coverage = exact, quote = "each participant has a nonforfeitable right to any employer security allocated to his account")
rule TcesopMeets409c(plan: Plan) strict {
    label en official "the plan term";
    when tcesop_plan_provides_nonforfeitable_409c(plan);
    then tcesop_meets_409c(plan);
}

pub relation esop_allocation_month_end_409d(security: Distribution, month_end: Date) kind empirical {
    label en unofficial "the last day of the month in which the employer security is allocated to the account, case-asserted (section 409(d))";
}

pub relation esop_distribution_of_security_on_409d(security: Distribution, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the allocated security is distributed from the account, case-asserted";
}

pub enum EarlyDistributionException409d {
    DeathDisabilitySeparationOrTermination;
    TransferToAcquiringEmployer;
    DispositionOfSellingCorporationInterest;
    NoException;
}

pub relation esop_early_distribution_exception_409d(security: Distribution, exception: EarlyDistributionException409d) kind empirical {
    label en unofficial "the exception, if any, the plan provides and the distribution falls in, case-asserted ((d)(1)-(3))";
}

pub relation esop_distribution_before_84_months_409d(security: Distribution, plan: Plan) kind institutional {
    label en official "section 409(d): a distribution before the end of the 84th month beginning after the allocation month, outside the listed events";
}

@source(IRC_S409_D, relation = formalizes, coverage = partial, quote = "may be distributed from that account before the end of the 84th month beginning after the month in which the security is allocated to the account")
rule EsopDistributionBefore84Months409d(security: Distribution, plan: Plan, month_end: Date, on: Date) strict {
    label en official "PARTIAL: exact boundary: on the last day of the 84th month the security may not yet be distributed, the next day it may; the exceptions apply only as the plan provides";
    when esop_allocation_month_end_409d(security, month_end)
        and esop_distribution_of_security_on_409d(security, plan, on)
        and on <= add_calendar_period(month_end, 84 calendar_month)
        and esop_early_distribution_exception_409d(security, NoException);
    then esop_distribution_before_84_months_409d(security, plan);
}

pub relation esop_plan_sponsor_409(plan: Plan, sponsor: Person) kind empirical {
    label en unofficial "the sponsor of the employee stock ownership plan, case-asserted";
}

pub relation esop_distributes_security_409d(sponsor: Person, security: Distribution) kind institutional {
    label en official "action atom of the 84-month prohibition";
}

rule EsopDistributesSecurity409d(sponsor: Person, security: Distribution, plan: Plan) strict {
    label en unofficial "the sponsor's plan distributes the security before the 84 months, outside an exception";
    when esop_plan_sponsor_409(plan, sponsor) and esop_distribution_before_84_months_409d(security, plan);
    then esop_distributes_security_409d(sponsor, security);
}

@source(IRC_S409_D, relation = formalizes, coverage = partial, quote = "no employer security allocated to a participant's account under subsection (b)")
rule EsopEarlyDistributionProhibition409d(sponsor: Person, plan: Plan, security: Distribution) strict {
    label en official "PARTIAL: the prohibition in force for a plan with allocated securities; the required-distribution carve-out of section 401(a)(9) is not gated";
    when esop_plan_sponsor_409(plan, sponsor) and esop_allocation_month_end_409d(security, _);
    then prohibition DistributeAllocatedSecurityBefore84Months {
        bearer sponsor;
        action esop_distributes_security_409d(sponsor, security);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (e) Voting rights; (f) Establishment timing
// =====================================================================

pub relation employer_has_registration_type_class_409e4(plan: Plan) kind empirical {
    label en unofficial "the employer has a registration-type class of securities, case-asserted (section 409(e)(4))";
}

pub relation participants_direct_voting_on_all_matters_409e2(plan: Plan) kind empirical {
    label en unofficial "each participant or beneficiary may direct the voting of the securities allocated to the account, case-asserted ((e)(2))";
}

pub relation participants_direct_voting_on_major_matters_409e3(plan: Plan) kind empirical {
    label en unofficial "each participant or beneficiary may direct the exercise of voting rights on corporate matters requiring approval by more than a majority vote, case-asserted ((e)(3))";
}

pub relation esop_voting_rights_requirement_met_409e(plan: Plan) kind institutional {
    label en official "section 409(e): a plan of an employer with a registration-type class gives pass-through voting on all matters; otherwise on the major corporate matters";
}

@source(IRC_S409_E, relation = formalizes, coverage = partial, quote = "If the employer has a registration-type class of securities, the plan meets the requirements of this paragraph only if each participant or beneficiary in the plan is entitled to direct the plan")
rule EsopVotingRegistered409e2(plan: Plan) strict {
    label en official "PARTIAL: (e)(2)";
    when employer_has_registration_type_class_409e4(plan) and participants_direct_voting_on_all_matters_409e2(plan);
    then esop_voting_rights_requirement_met_409e(plan);
}

@source(IRC_S409_E, relation = formalizes, coverage = partial, quote = "If the employer does not have a registration-type class of securities, the plan meets the requirements of this paragraph only if each participant or beneficiary in the plan is entitled to direct the plan")
rule EsopVotingUnregistered409e3(plan: Plan) strict {
    label en official "PARTIAL: (e)(3)";
    when not_known(employer_has_registration_type_class_409e4(plan)) and participants_direct_voting_on_major_matters_409e3(plan);
    then esop_voting_rights_requirement_met_409e(plan);
}

pub relation tcesop_established_on_409f(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the plan is established, case-asserted (section 409(f)(1))";
}

pub relation tcesop_return_due_date_409f(plan: Plan, due: Date) kind empirical {
    label en unofficial "the due date (including extensions) for the filing of the employer's return for the first taxable year for which a plan credit is claimed, case-asserted";
}

pub relation tcesop_established_in_time_409f1(plan: Plan) kind institutional {
    label en official "section 409(f)(1): the plan is established on or before the return due date, including extensions, for the first credit year";
}

@source(IRC_S409_F, relation = formalizes, coverage = exact, quote = "only if it is established on or before the due date (including any extension of such date) for the filing of the employer's tax return for the first taxable year of the employer for which an employee plan credit is claimed by the employer with respect to the plan")
rule TcesopEstablishedInTime409f1(plan: Plan, est_on: Date, due: Date) strict {
    label en official "exact boundary: the due date itself is in time";
    when tcesop_established_on_409f(plan, est_on) and tcesop_return_due_date_409f(plan, due) and est_on <= due;
    then tcesop_established_in_time_409f1(plan);
}

// =====================================================================
// (h) Put option and repurchase installments
// =====================================================================

pub relation participant_may_demand_securities_409h1A(plan: Plan) kind empirical {
    label en unofficial "a participant entitled to a distribution may demand it in employer securities, case-asserted (section 409(h)(1)(A))";
}

pub relation securities_readily_tradable_409h1B(plan: Plan) kind empirical {
    label en unofficial "the employer securities are readily tradable on an established market, case-asserted";
}

pub relation participant_has_put_option_409h1B(plan: Plan) kind empirical {
    label en unofficial "the participant may require the employer to repurchase the securities under a fair valuation formula, case-asserted ((h)(1)(B))";
}

pub relation esop_distribution_options_met_409h1(plan: Plan) kind institutional {
    label en official "section 409(h)(1): the plan lets a participant demand employer securities and, when they are not readily tradable, put them to the employer";
}

@source(IRC_S409_H, relation = formalizes, coverage = partial, quote = "has a right to demand that his benefits be distributed in the form of employer securities")
rule EsopDistributionOptionsMetTradable409h1(plan: Plan) strict {
    label en official "PARTIAL: (A) with readily tradable securities no put option is needed";
    when participant_may_demand_securities_409h1A(plan) and securities_readily_tradable_409h1B(plan);
    then esop_distribution_options_met_409h1(plan);
}

rule EsopDistributionOptionsMetPut409h1(plan: Plan) strict {
    label en official "PARTIAL: (A) and (B) for securities that are not readily tradable";
    when participant_may_demand_securities_409h1A(plan) and not_known(securities_readily_tradable_409h1B(plan)) and participant_has_put_option_409h1B(plan);
    then esop_distribution_options_met_409h1(plan);
}

pub relation repurchase_first_payment_days_after_put_409h5(plan: Plan, days: Integer) kind empirical {
    label en unofficial "how many days after the exercise of the put option the first installment is paid, case-asserted (section 409(h)(5)(A))";
}

pub relation repurchase_installment_years_409h5(plan: Plan, years: Integer) kind empirical {
    label en unofficial "the number of years over which the equal periodic payments are made, case-asserted";
}

pub relation repurchase_payments_at_least_annual_409h5(plan: Plan) kind empirical {
    label en unofficial "the payments are substantially equal and made not less frequently than annually, case-asserted";
}

pub relation repurchase_security_and_interest_409h5B(plan: Plan) kind empirical {
    label en unofficial "adequate security is provided and reasonable interest is paid on the unpaid amounts, case-asserted ((h)(5)(B))";
}

pub relation repurchase_installments_meet_409h5(plan: Plan) kind institutional {
    label en official "section 409(h)(5): a required repurchase in a total distribution may be paid in equal periodic payments starting within 30 days and lasting at most 5 years, with security and interest";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "over a period beginning not later than 30 days after the exercise of the put option described in paragraph (4) and not exceeding 5 years")
rule RepurchaseInstallmentsMeet409h5(plan: Plan, days: Integer, years: Integer) strict {
    label en official "exact boundaries: 30 days and 5 years are both allowed";
    when repurchase_first_payment_days_after_put_409h5(plan, days)
        and repurchase_installment_years_409h5(plan, years)
        and repurchase_payments_at_least_annual_409h5(plan)
        and repurchase_security_and_interest_409h5B(plan)
        and days <= 30
        and years <= 5;
    then repurchase_installments_meet_409h5(plan);
}

pub relation put_option_days_after_distribution_409h4(plan: Plan, first_period_days: Integer, second_period_days: Integer) kind empirical {
    label en unofficial "the length of the first put option period after the distribution date and of the additional period in the following plan year, case-asserted (section 409(h)(4))";
}

pub relation put_option_periods_deemed_sufficient_409h4(plan: Plan) kind institutional {
    label en official "section 409(h)(4): a put option of at least 60 days after distribution and, if unexercised, at least 60 days in the following plan year";
}

@source(IRC_S409_H, relation = formalizes, coverage = partial, quote = "if it provides a put option for a period of at least 60 days following the date of distribution of stock of the employer and, if the put option is not exercised within such 60-day period, for an additional period of at least 60 days in the following plan year")
rule PutOptionPeriodsDeemedSufficient409h4(plan: Plan, first_days: Integer, second_days: Integer) strict {
    label en official "PARTIAL: exact boundaries 60 and 60 days";
    when put_option_days_after_distribution_409h4(plan, first_days, second_days) and first_days >= 60 and second_days >= 60;
    then put_option_periods_deemed_sufficient_409h4(plan);
}

// =====================================================================
// (i) Reimbursement of expenses
// =====================================================================

pub relation amount_required_to_transfer_409i(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the employer is required to transfer to the plan for the taxable year, case-asserted (section 409(i)(1))";
}

pub relation establishment_expense_limit_409i1(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409(i)(1): establishment expenses may be reimbursed up to 10 percent of the first $100,000 plus 5 percent of the excess transferred";
}

@source(IRC_S409_I, relation = formalizes, coverage = exact, quote = "10 percent of the first $100,000 which the employer is required to transfer to the plan for that taxable year")
rule EstablishmentExpenseLimit409i1(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "0.10 x min(amount, 100000) + 0.05 x max(amount - 100000, 0), exact";
    when amount_required_to_transfer_409i(plan, y, amount);
    then establishment_expense_limit_409i1(plan, y, min(amount, 100000.00 USD) * 0.10 + max(amount - 100000.00 USD, 0.00 USD) * 0.05);
}

pub relation dividends_paid_to_plan_409i(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dividends paid to the plan on employer stock during the year, case-asserted (section 409(i)(2))";
}

pub relation administration_expense_limit_409i2(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409(i)(2): administration expenses may be reimbursed up to the lesser of $100,000 and 10 percent of the first $100,000 of dividends plus 5 percent of the excess";
}

@source(IRC_S409_I, relation = formalizes, coverage = exact, quote = "10 percent of the first $100,000 of the dividends paid to the plan with respect to stock of the employer during the plan year")
rule AdministrationExpenseLimit409i2(plan: Plan, y: TaxableYear, dividends: Money) strict {
    label en official "min(0.10 x min(d, 100000) + 0.05 x max(d - 100000, 0), 100000), exact";
    when dividends_paid_to_plan_409i(plan, y, dividends);
    then administration_expense_limit_409i2(plan, y,
        min(min(dividends, 100000.00 USD) * 0.10 + max(dividends - 100000.00 USD, 0.00 USD) * 0.05, 100000.00 USD));
}

// =====================================================================
// (n) Nonallocation period of a section 1042 sale
// =====================================================================

pub relation section_1042_sale_date_409n(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the sale of the qualified securities to the plan, case-asserted (section 409(n)(3)(C))";
}

pub relation final_acquisition_debt_allocation_date_409n(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the plan allocation attributable to the final payment of the acquisition indebtedness incurred in connection with the sale, case-asserted ((C)(ii))";
}

pub relation nonallocation_period_end_409n3C(plan: Plan, on: Date) kind institutional {
    label en official "section 409(n)(3)(C): the nonallocation period ends on the later of 10 years after the sale and the date of the allocation for the final acquisition debt payment";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "The term \"nonallocation period\" means the period beginning on the date of the sale of the qualified securities and ending on the later of")
rule NonallocationPeriodEnd409n3C(plan: Plan, sale: Date, final_allocation: Date) strict {
    label en official "max(sale + 10 years, final debt allocation date), exact dates";
    when section_1042_sale_date_409n(plan, sale) and final_acquisition_debt_allocation_date_409n(plan, final_allocation);
    then nonallocation_period_end_409n3C(plan, max(add_calendar_period(sale, 10 calendar_year), final_allocation));
}

pub relation class_ownership_percent_409n(person: Person, plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the person's ownership (after section 318(a)) of any class of outstanding stock of the issuing corporation or of its value, as a fraction, case-asserted (section 409(n)(1)(B))";
}

pub relation over_25_percent_owner_409n1B(person: Person, plan: Plan) kind institutional {
    label en official "section 409(n)(1)(B): a person who owns more than 25 percent of any class of stock or of its total value may not benefit during the nonallocation period";
}

@source(IRC_S409_N, relation = formalizes, coverage = partial, quote = "for the benefit of any other person who owns (after application of section 318(a)) more than 25 percent of")
rule Over25PercentOwner409n1B(person: Person, plan: Plan, pct: Decimal) strict {
    label en official "PARTIAL: exact boundary: more than 25 percent, 25 percent itself is not enough; the two measures (class, value) are one asserted percentage";
    when class_ownership_percent_409n(person, plan, pct) and pct > 0.25;
    then over_25_percent_owner_409n1B(person, plan);
}

pub relation lineal_descendant_allocation_within_5_percent_409n3A(plan: Plan, allocated: Money, attributable_securities: Money) kind empirical {
    label en unofficial "the aggregate allocated to lineal descendants of the taxpayer and the plan's securities attributable to a sale by persons related to them, case-asserted ((n)(3)(A)(ii))";
}

pub relation lineal_descendants_exception_409n3A(plan: Plan) kind institutional {
    label en official "section 409(n)(3)(A): the prohibition does not apply to lineal descendants when their aggregate allocation does not exceed 5 percent of the related securities";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "does not exceed more than 5 percent of the employer securities")
rule LinealDescendantsException409n3A(plan: Plan, allocated: Money, securities: Money) strict {
    label en official "exact by cross-multiplication: allocated x 100 <= securities x 5";
    when lineal_descendant_allocation_within_5_percent_409n3A(plan, allocated, securities) and allocated * 100.0 <= securities * 5.0;
    then lineal_descendants_exception_409n3A(plan);
}

// =====================================================================
// (o) Distribution timing and period
// =====================================================================

pub relation separation_reason_409o1A(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the participant separates from service by reason of normal retirement age, disability or death, case-asserted ((o)(1)(A)(i))";
}

pub relation separation_plan_year_end_409o1A(participant: Person, plan: Plan, end: Date) kind empirical {
    label en unofficial "the last day of the plan year in which the participant separates, case-asserted";
}

pub relation esop_distribution_commence_deadline_409o1A(participant: Person, plan: Plan, deadline: Date) kind institutional {
    label en official "section 409(o)(1)(A)(i): distribution commences not later than 1 year after the close of the plan year of separation by normal retirement, disability or death";
}

@source(IRC_S409_O, relation = formalizes, coverage = partial, quote = "the distribution of the participant's account balance in the plan will commence not later than 1 year after the close of the plan year")
rule EsopDistributionCommenceDeadline409o1A(participant: Person, plan: Plan, end: Date) strict {
    label en official "PARTIAL: (i); the 5th-plan-year alternative (ii) for other separations is not derived";
    when separation_reason_409o1A(participant, plan) and separation_plan_year_end_409o1A(participant, plan, end);
    then esop_distribution_commence_deadline_409o1A(participant, plan, add_calendar_period(end, 1 calendar_year));
}

pub relation esop_account_balance_409o1C(participant: Person, plan: Plan, balance: Money) kind empirical {
    label en unofficial "the participant's account balance (without the securities of (o)(1)(B)), case-asserted";
}

pub relation esop_distribution_period_years_409o1C(participant: Person, plan: Plan, years: Integer) kind institutional {
    label en official "section 409(o)(1)(C): equal periodic payments over at most 5 years, plus 1 year (up to 5 more) for each $160,000 or fraction by which the balance exceeds $800,000";
}

@source(IRC_S409_O, relation = formalizes, coverage = partial, quote = "in the case of a participant with an account balance in excess of $800,000, 5 years plus 1 additional year (but not more than 5 additional years) for each $160,000 or fraction thereof by which such balance exceeds $800,000")
rule EsopDistributionPeriod5Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "PARTIAL: balance up to $800,000: 5 years (pinned base; the section 415(d) indexing is SOURCE_GAP)";
    when esop_account_balance_409o1C(participant, plan, balance) and balance <= 800000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 5);
}

rule EsopDistributionPeriod6Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "over $800,000 and up to $960,000: 6 years";
    when esop_account_balance_409o1C(participant, plan, balance) and balance > 800000.00 USD and balance <= 960000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 6);
}

rule EsopDistributionPeriod7Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "over $960,000 and up to $1,120,000: 7 years";
    when esop_account_balance_409o1C(participant, plan, balance) and balance > 960000.00 USD and balance <= 1120000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 7);
}

rule EsopDistributionPeriod8Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "over $1,120,000 and up to $1,280,000: 8 years";
    when esop_account_balance_409o1C(participant, plan, balance) and balance > 1120000.00 USD and balance <= 1280000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 8);
}

rule EsopDistributionPeriod9Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "over $1,280,000 and up to $1,440,000: 9 years";
    when esop_account_balance_409o1C(participant, plan, balance) and balance > 1280000.00 USD and balance <= 1440000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 9);
}

rule EsopDistributionPeriod10Years409o1C(participant: Person, plan: Plan, balance: Money) strict {
    label en official "over $1,440,000: 10 years (the maximum of 5 additional years)";
    when esop_account_balance_409o1C(participant, plan, balance) and balance > 1440000.00 USD;
    then esop_distribution_period_years_409o1C(participant, plan, 10);
}

// =====================================================================
// (p) S corporation employee stock ownership plans
// =====================================================================

pub relation esop_holds_s_corporation_stock_409p(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan holds employer securities consisting of stock in an S corporation, case-asserted (section 409(p)(3)(A)(i))";
}

pub relation deemed_owned_shares_409p(person: Person, plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the person's deemed-owned shares (allocated shares plus the share of unallocated shares), case-asserted (section 409(p)(4)(C))";
}

pub relation total_deemed_owned_shares_409p(plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the number of deemed-owned shares of stock in the S corporation, case-asserted";
}

pub relation person_family_deemed_owned_shares_409p(person: Person, plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the aggregate deemed-owned shares of the person and the members of the person's family, case-asserted ((p)(4)(A)(i))";
}

pub relation disqualified_person_409p4A(person: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 409(p)(4)(A): a person whose family aggregate deemed-owned shares are at least 20 percent, or (otherwise) whose own deemed-owned shares are at least 10 percent";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "the aggregate number of deemed-owned shares of such person and the members of such person's family is at least 20 percent of the number of deemed-owned shares of stock in the S corporation")
rule DisqualifiedPersonFamily409p4A(person: Person, plan: Plan, y: TaxableYear, family: Integer, total: Integer) strict {
    label en official "(i): exact boundary by cross-multiplication: family x 100 >= total x 20";
    when person_family_deemed_owned_shares_409p(person, plan, y, family)
        and total_deemed_owned_shares_409p(plan, y, total)
        and total > 0
        and family * 100 >= total * 20;
    then disqualified_person_409p4A(person, plan, y);
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "the number of deemed-owned shares of such person is at least 10 percent of the number of deemed-owned shares of stock in such corporation")
rule DisqualifiedPersonOwn409p4A(person: Person, plan: Plan, y: TaxableYear, own: Integer, total: Integer) strict {
    label en official "(ii): exact boundary by cross-multiplication: own x 100 >= total x 10";
    when deemed_owned_shares_409p(person, plan, y, own)
        and total_deemed_owned_shares_409p(plan, y, total)
        and total > 0
        and own * 100 >= total * 10;
    then disqualified_person_409p4A(person, plan, y);
}

pub relation disqualified_persons_deemed_owned_shares_409p(plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the number of shares of the S corporation owned (deemed) by disqualified persons at any time during the plan year, case-asserted (section 409(p)(3)(A)(ii))";
}

pub relation nonallocation_year_409p3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 409(p)(3)(A): a plan year in which the plan holds S corporation stock and disqualified persons own at least 50 percent of the shares";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "disqualified persons own at least 50 percent of the number of shares of stock in the S corporation")
rule NonallocationYear409p3(plan: Plan, y: TaxableYear, disq: Integer, total: Integer) strict {
    label en official "exact boundary by cross-multiplication: disqualified x 100 >= total x 50";
    when esop_holds_s_corporation_stock_409p(plan, y)
        and disqualified_persons_deemed_owned_shares_409p(plan, y, disq)
        and total_deemed_owned_shares_409p(plan, y, total)
        and total > 0
        and disq * 100 >= total * 50;
    then nonallocation_year_409p3(plan, y);
}

pub relation allocation_to_disqualified_person_in_nonallocation_year_409p2(person: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an allocation to the account of a disqualified person in a nonallocation year, case-asserted (section 409(p)(1), (2)(A))";
}

pub relation treated_as_distributed_to_disqualified_person_409p2A(person: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409(p)(2)(A): the plan is treated as having distributed the allocation to the disqualified person at the time of allocation";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "the plan shall be treated as having distributed to any disqualified person the amount allocated to the account of such person in violation of paragraph (1) at the time of such allocation")
rule TreatedAsDistributedToDisqualifiedPerson409p2A(person: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "the allocation in a nonallocation year to a disqualified person";
    when nonallocation_year_409p3(plan, y)
        and disqualified_person_409p4A(person, plan, y)
        and allocation_to_disqualified_person_in_nonallocation_year_409p2(person, plan, y, amount);
    then treated_as_distributed_to_disqualified_person_409p2A(person, plan, y, amount);
}
