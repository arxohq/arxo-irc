// Sections 416 and 417 residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): 416(c), (e), (g)(2), (g)(4), (i) and 417(a)-(c),
// (f). Each sentence is a conjunction of case-asserted facts producing a
// treatment relation; the hypothetical benefit amounts of 417(c)(1) and the
// "reasonable period" of 417(a)(3)(B)(ii) are case inputs (evaluative).

// =====================================================================
// 416(i) Definitions
// =====================================================================

use self::{
    IRC_S416_C,
    IRC_S416_E,
    IRC_S416_G,
    IRC_S416_I,
    IRC_S417_A,
    IRC_S417_B,
    IRC_S417_C,
    IRC_S417_F,
    Person,
    Plan,
    TaxableYear,
};

pub relation officer_count_416i1A(plan: Plan, officers: Integer, employees: Integer) kind empirical {
    label en unofficial "the number of employees treated as officers and the number of employees of the employer, case-asserted";
}

pub relation officer_count_within_cap_416i1A(plan: Plan) kind institutional {
    label en official "section 416(i)(1)(A): no more than 50 employees (or, if lesser, the greater of 3 or 10 percent of the employees) are treated as officers";
}

@source(IRC_S416_I, relation = formalizes, coverage = partial, quote = "no more than 50 employees (or, if lesser, the greater of 3 or 10 percent of the employees) shall be treated as officers")
rule OfficerCountWithinCap416i1A(plan: Plan, officers: Integer, employees: Integer) strict {
    label en official "PARTIAL: the cap is the lesser of 50 and the greater of 3 and 10 percent of the employees (exact decimal, no rounding)";
    when officer_count_416i1A(plan, officers, employees)
        and 1.0 * officers <= min(50.0, max(3.0, 0.1 * employees));
    then officer_count_within_cap_416i1A(plan);
}

pub relation owner_capital_or_profits_percent_416i1Bi(person: Person, employer: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the capital or profits interest in a non-corporate employer owned by the person, case-asserted";
}

pub relation noncorporate_five_percent_owner_416i1Bi(person: Person, employer: Person) kind institutional {
    label en official "section 416(i)(1)(B)(i)(II): if the employer is not a corporation, any person who owns more than 5 percent of the capital or profits interest";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "any person who owns more than 5 percent of the capital or profits interest in the employer")
rule NoncorporateFiveOwner416i1Bi(person: Person, employer: Person, pct: Decimal) strict {
    label en official "more than 5 percent: exactly 5 is outside";
    when owner_capital_or_profits_percent_416i1Bi(person, employer, pct)
        and pct > 5.0;
    then noncorporate_five_percent_owner_416i1Bi(person, employer);
}

pub relation corporation_stock_owned_by_shareholder_416i1Biii(shareholder: Person, corp: Person, shareholder_pct: Decimal, corp_owned_shares: Decimal) kind empirical {
    label en unofficial "the shareholder's percentage of the corporation and the shares of another corporation the corporation owns, case-asserted";
}

pub relation stock_attributed_from_corporation_416i1Biii(shareholder: Person, corp: Person, shares: Decimal) kind institutional {
    label en official "section 416(i)(1)(B)(iii)(I): section 318(a)(2)(C) applied with 5 percent for 50 percent - stock owned by a corporation is attributed proportionately to a shareholder owning 5 percent or more";
}

@source(IRC_S416_I, relation = formalizes, coverage = partial, quote = "subparagraph (C) of section 318(a)(2) shall be applied by substituting \"5 percent\" for \"50 percent\"")
rule StockAttributedFromCorporation416i1Biii(shareholder: Person, corp: Person, pct: Decimal, owned: Decimal) strict {
    label en official "PARTIAL: the proportion is the shareholder's percentage of the value of the corporation";
    when corporation_stock_owned_by_shareholder_416i1Biii(shareholder, corp, pct, owned)
        and pct >= 5.0;
    then stock_attributed_from_corporation_416i1Biii(shareholder, corp, owned * pct / 100.0);
}

pub relation self_employed_individual_401c1_416i3(person: Person) kind empirical {
    label en unofficial "the individual is a self-employed individual described in section 401(c)(1), case-asserted";
}

pub relation earned_income_401c2_416i3(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the individual's earned income within the meaning of section 401(c)(2), case-asserted";
}

pub relation treated_as_employee_416i3A(person: Person) kind institutional {
    label en official "section 416(i)(3)(A): the self-employed individual is treated as an employee";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "such individual shall be treated as an employee")
rule SelfEmployedTreatedAsEmployee416i3A(person: Person) strict {
    label en official "a section 401(c)(1) individual";
    when self_employed_individual_401c1_416i3(person);
    then treated_as_employee_416i3A(person);
}

pub relation earned_income_treated_as_compensation_416i3B(person: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 416(i)(3)(B): the earned income is treated as compensation";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "such individual's earned income (within the meaning of section 401(c)(2)) shall be treated as compensation")
rule EarnedIncomeTreatedAsCompensation416i3B(person: Person, y: TaxableYear, amount: Money) strict {
    label en official "earned income of a section 401(c)(1) individual";
    when self_employed_individual_401c1_416i3(person)
        and earned_income_401c2_416i3(person, y, amount);
    then earned_income_treated_as_compensation_416i3B(person, y, amount);
}

pub relation employee_in_bargaining_unit_with_retirement_bargaining_416i4(employee: Person, bona_fide_agreement: Boolean, good_faith_bargaining_evidence: Boolean) kind empirical {
    label en unofficial "the employee is in a unit covered by an agreement the Secretary of Labor finds to be a collective bargaining agreement, and there is evidence that retirement benefits were the subject of good faith bargaining, case-asserted";
}

pub relation top_heavy_requirements_inapplicable_to_employee_416i4(employee: Person) kind institutional {
    label en official "section 416(i)(4): the requirements of subsections (b), (c) and (d) do not apply to an employee in such a unit";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The requirements of subsections (b), (c), and (d) shall not apply with respect to any employee included in a unit of employees covered by an agreement")
rule TopHeavyRequirementsInapplicableToEmployee416i4(employee: Person) strict {
    label en official "both facts";
    when employee_in_bargaining_unit_with_retirement_bargaining_416i4(employee, true, true);
    then top_heavy_requirements_inapplicable_to_employee_416i4(employee);
}

pub relation beneficiary_of_employee_416i5(beneficiary: Person, employee: Person) kind empirical {
    label en unofficial "the person is a beneficiary of the employee or key employee, case-asserted";
}

pub relation treated_as_employee_or_key_employee_by_beneficiary_416i5(beneficiary: Person, employee: Person) kind institutional {
    label en official "section 416(i)(5): the terms employee and key employee include their beneficiaries";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The terms \"employee\" and \"key employee\" include their beneficiaries")
rule BeneficiaryIncludedInEmployee416i5(beneficiary: Person, employee: Person) strict {
    label en official "a beneficiary";
    when beneficiary_of_employee_416i5(beneficiary, employee);
    then treated_as_employee_or_key_employee_by_beneficiary_416i5(beneficiary, employee);
}

pub relation is_simplified_employee_pension_416i6(plan: Plan) kind empirical {
    label en unofficial "the arrangement is a simplified employee pension, case-asserted";
}

pub relation treated_as_defined_contribution_plan_416i6A(plan: Plan) kind institutional {
    label en official "section 416(i)(6)(A): a simplified employee pension is a defined contribution plan";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "A simplified employee pension shall be treated as a defined contribution plan")
rule SepTreatedAsDefinedContributionPlan416i6A(plan: Plan) strict {
    label en official "simplified employee pension";
    when is_simplified_employee_pension_416i6(plan);
    then treated_as_defined_contribution_plan_416i6A(plan);
}

pub relation employer_elected_aggregate_contributions_416i6B(plan: Plan) kind empirical {
    label en unofficial "the employer elects to take into account aggregate employer contributions in lieu of the aggregate of the accounts of employees, case-asserted";
}

pub relation aggregate_employer_contributions_basis_416i6B(plan: Plan) kind institutional {
    label en official "section 416(i)(6)(B): paragraphs (1)(A)(ii) and (2)(B) of subsection (g) use aggregate employer contributions";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "at the election of the employer, paragraphs (1)(A)(ii) and (2)(B) of subsection (g) shall be applied by taking into account aggregate employer contributions")
rule AggregateEmployerContributionsBasis416i6B(plan: Plan) strict {
    label en official "SEP with the employer election";
    when is_simplified_employee_pension_416i6(plan)
        and employer_elected_aggregate_contributions_416i6B(plan);
    then aggregate_employer_contributions_basis_416i6B(plan);
}

// =====================================================================
// 416(c) Minimum benefits
// =====================================================================

pub relation year_of_service_facts_416c1C(employee: Person, plan: Plan, y: TaxableYear, not_top_heavy_any_year_ending_in_service_year: Boolean, plan_year_begin: Date) kind empirical {
    label en unofficial "whether the plan was not a top-heavy plan for any plan year ending during the year of service, and the date the plan year began, case-asserted";
}

pub relation year_of_service_disregarded_416c1Cii(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(c)(1)(C)(ii): a year of service is not taken into account if the plan was not top-heavy or the year was completed in a plan year beginning before January 1, 1984";
}

@source(IRC_S416_C, relation = formalizes, coverage = partial, quote = "the plan was not a top-heavy plan for any plan year ending during such year of service")
rule YearOfServiceDisregardedNotTopHeavy416c1Cii(employee: Person, plan: Plan, y: TaxableYear, d: Date) strict {
    label en official "PARTIAL: subclause (I)";
    when year_of_service_facts_416c1C(employee, plan, y, true, d);
    then year_of_service_disregarded_416c1Cii(employee, plan, y);
}

@source(IRC_S416_C, relation = formalizes, coverage = partial, quote = "such year of service was completed in a plan year beginning before January 1, 1984")
rule YearOfServiceDisregardedBefore1984416c1Cii(employee: Person, plan: Plan, y: TaxableYear, nt: Boolean, d: Date) strict {
    label en official "PARTIAL: subclause (II)";
    when year_of_service_facts_416c1C(employee, plan, y, nt, d)
        and d < @1984-01-01;
    then year_of_service_disregarded_416c1Cii(employee, plan, y);
}

pub relation plan_year_benefits_no_key_employee_416c1Ciii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "during the plan year the plan benefits (section 410(b)) no key employee or former key employee, case-asserted";
}

pub relation service_disregarded_in_plan_year_416c1Ciii(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(c)(1)(C)(iii): service during a plan year in which the plan benefits no key employee is disregarded";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "any service with the employer shall be disregarded to the extent that such service occurs during a plan year when the plan benefits (within the meaning of section 410(b)) no key employee or former key employee")
rule ServiceDisregardedNoKeyEmployeeBenefits416c1Ciii(employee: Person, plan: Plan, y: TaxableYear) strict {
    label en official "the plan year";
    when plan_year_benefits_no_key_employee_416c1Ciii(plan, y)
        and service_in_plan_year_416c1Ciii(employee, plan, y);
    then service_disregarded_in_plan_year_416c1Ciii(employee, plan, y);
}

pub relation service_in_plan_year_416c1Ciii(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee performed service with the employer in the plan year, case-asserted";
}

pub relation testing_year_facts_416c1Diii(employee: Person, plan: Plan, y: TaxableYear, year_end_plan_year_begins: Date, year_begin: Date, last_top_heavy_year_close: Date) kind empirical {
    label en unofficial "the plan year in which the year ends begins on the date, the year begins on the date, and the close of the last top-heavy year, case-asserted";
}

pub relation year_excluded_from_testing_period_416c1Diii(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(c)(1)(D)(iii): a year is not taken into account (except as the plan provides) if it ends in a plan year beginning before 1984 or begins after the close of the last top-heavy year";
}

@source(IRC_S416_C, relation = formalizes, coverage = partial, quote = "such year ends in a plan year beginning before January 1, 1984")
rule YearExcludedFromTestingPeriodBefore1984416c1Diii(employee: Person, plan: Plan, y: TaxableYear, pb: Date, yb: Date, cl: Date) strict {
    label en official "PARTIAL: subclause (I); the plan's own provision is a case fact";
    when testing_year_facts_416c1Diii(employee, plan, y, pb, yb, cl)
        and pb < @1984-01-01
        and not_known(plan_provides_year_counts_416c1Diii(plan));
    then year_excluded_from_testing_period_416c1Diii(employee, plan, y);
}

@source(IRC_S416_C, relation = formalizes, coverage = partial, quote = "such year begins after the close of the last year in which the plan was a top-heavy plan")
rule YearExcludedFromTestingPeriodAfterTopHeavy416c1Diii(employee: Person, plan: Plan, y: TaxableYear, pb: Date, yb: Date, cl: Date) strict {
    label en official "PARTIAL: subclause (II); the plan's own provision is a case fact";
    when testing_year_facts_416c1Diii(employee, plan, y, pb, yb, cl)
        and yb > cl
        and not_known(plan_provides_year_counts_416c1Diii(plan));
    then year_excluded_from_testing_period_416c1Diii(employee, plan, y);
}

pub relation plan_provides_year_counts_416c1Diii(plan: Plan) kind empirical {
    label en unofficial "the plan provides that such a year is taken into account, case-asserted";
}

pub relation dc_plans_in_group_facts_416c2Bii(plan: Plan, required_in_group_416g2Ai: Boolean, enables_db_plan_401a4_or_410: Boolean) kind empirical {
    label en unofficial "the defined contribution plan is required to be included in an aggregation group under subsection (g)(2)(A)(i), and whether it enables a defined benefit plan in the group to meet section 401(a)(4) or 410, case-asserted";
}

pub relation dc_plan_treated_as_one_plan_416c2Bii(plan: Plan) kind institutional {
    label en official "section 416(c)(2)(B)(ii): all defined contribution plans required to be aggregated are one plan, except a plan that enables a defined benefit plan to meet section 401(a)(4) or 410";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "all defined contribution plans required to be included in an aggregation group under subsection (g)(2)(A)(i) shall be treated as one plan")
rule DcPlanTreatedAsOnePlan416c2Bii(plan: Plan) strict {
    label en official "required in the group and not enabling a DB plan (subclause II)";
    when dc_plans_in_group_facts_416c2Bii(plan, true, false);
    then dc_plan_treated_as_one_plan_416c2Bii(plan);
}

pub relation employee_fails_410a1_age_or_service_416c2C(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee does not meet the age or service requirements of section 410(a)(1) (without regard to subparagraph (B)), case-asserted";
}

pub relation employee_may_be_excluded_416c2C(employee: Person, plan: Plan) kind institutional {
    label en official "section 416(c)(2)(C): an employee not meeting the age or service requirements may be excluded from consideration";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "Any employees not meeting the age or service requirements of section 410(a)(1) (without regard to subparagraph (B) thereof) may be excluded from consideration")
rule EmployeeMayBeExcluded416c2C(employee: Person, plan: Plan) strict {
    label en official "fails the age or service requirement";
    when employee_fails_410a1_age_or_service_416c2C(employee, plan);
    then employee_may_be_excluded_416c2C(employee, plan);
}

pub relation top_heavy_plan_offset_facts_416e(plan: Plan, is_top_heavy: Boolean, meets_without_federal_offsets: Boolean) kind empirical {
    label en unofficial "whether the plan is top-heavy and whether it meets the requirement without taking into account contributions or benefits under chapter 2, chapter 21, title II of the Social Security Act or other Federal or State law, case-asserted";
}

pub relation top_heavy_plan_meets_416b_or_c_416e(plan: Plan) kind institutional {
    label en official "section 416(e): a top-heavy plan meets the requirement of (b) or (c) only without counting Social Security and similar offsets";
}

@source(IRC_S416_E, relation = formalizes, coverage = exact, quote = "A top-heavy plan shall not be treated as meeting the requirement of subsection (b) or (c) unless such plan meets such requirement without taking into account contributions or benefits under chapter 2")
rule TopHeavyPlanMeetsWithoutOffsets416e(plan: Plan) strict {
    label en official "top-heavy and met without the offsets";
    when top_heavy_plan_offset_facts_416e(plan, true, true);
    then top_heavy_plan_meets_416b_or_c_416e(plan);
}

// =====================================================================
// 416(g) Aggregation and accrual
// =====================================================================

pub relation plan_required_in_group_facts_416g2Ai(plan: Plan, key_employee_participates: Boolean, enables_other_required_plan: Boolean) kind empirical {
    label en unofficial "a key employee participates in the plan, and the plan enables a plan of that kind to meet section 401(a)(4) or 410, case-asserted";
}

pub relation plan_required_in_aggregation_group_416g2Ai(plan: Plan) kind institutional {
    label en official "section 416(g)(2)(A)(i): each plan in which a key employee is a participant and each other plan that enables such a plan to meet section 401(a)(4) or 410";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "each plan of the employer in which a key employee is a participant")
rule PlanRequiredInGroupKeyParticipant416g2Ai(plan: Plan, enables: Boolean) strict {
    label en official "subclause (I)";
    when plan_required_in_group_facts_416g2Ai(plan, true, enables);
    then plan_required_in_aggregation_group_416g2Ai(plan);
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "each other plan of the employer which enables any plan described in subclause (I) to meet the requirements of section 401(a)(4) or 410")
rule PlanRequiredInGroupEnabling416g2Ai(plan: Plan, kp: Boolean) strict {
    label en official "subclause (II)";
    when plan_required_in_group_facts_416g2Ai(plan, kp, true);
    then plan_required_in_aggregation_group_416g2Ai(plan);
}

pub relation group_continues_to_meet_401a4_and_410_with_plan_416g2Aii(plan: Plan) kind empirical {
    label en unofficial "the aggregation group would continue to meet sections 401(a)(4) and 410 with the plan taken into account, case-asserted";
}

pub relation permissive_aggregation_allowed_416g2Aii(plan: Plan) kind institutional {
    label en official "section 416(g)(2)(A)(ii): the employer may treat a plan not required to be aggregated as part of the group if the group would continue to meet sections 401(a)(4) and 410";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "The employer may treat any plan not required to be included in an aggregation group under clause (i) as being part of such group if such group would continue to meet the requirements of sections 401(a)(4) and 410")
rule PermissiveAggregationAllowed416g2Aii(plan: Plan) strict {
    label en official "not required, and the group still meets the sections";
    when group_continues_to_meet_401a4_and_410_with_plan_416g2Aii(plan)
        and not_known(plan_required_in_aggregation_group_416g2Ai(plan));
    then permissive_aggregation_allowed_416g2Aii(plan);
}

pub relation accrual_method_facts_416g4F(plan: Plan, employer_uses_method_for_all_plans: Boolean) kind empirical {
    label en unofficial "whether one method is used for accrual purposes for all plans of the employer, case-asserted";
}

pub enum AccrualBasis416g4F {
    EmployerAccrualMethod;
    SlowestAccrualRate411b1C;
}

pub relation accrual_basis_416g4F(plan: Plan, basis: AccrualBasis416g4F) kind institutional {
    label en official "section 416(g)(4)(F): the accrued benefit is determined under the employer's method or, without one, as if it accrued at the slowest rate permitted under section 411(b)(1)(C)";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "under the method which is used for accrual purposes for all plans of the employer")
rule AccrualBasisEmployerMethod416g4F(plan: Plan) strict {
    label en official "clause (i)";
    when accrual_method_facts_416g4F(plan, true);
    then accrual_basis_416g4F(plan, EmployerAccrualMethod);
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "as if such benefit accrued not more rapidly than the slowest accrual rate permitted under section 411(b)(1)(C)")
rule AccrualBasisSlowest416g4F(plan: Plan) strict {
    label en official "clause (ii)";
    when accrual_method_facts_416g4F(plan, false);
    then accrual_basis_416g4F(plan, SlowestAccrualRate411b1C);
}

pub relation plan_top_heavy_only_by_401k15_exclusion_416g4H(plan: Plan) kind empirical {
    label en unofficial "the plan would be treated as top-heavy solely because it does not provide nonelective or matching contributions to section 401(k)(15)(B)(i) employees, case-asserted";
}

pub relation not_top_heavy_by_401k15_exclusion_416g4H(plan: Plan) kind institutional {
    label en official "section 416(g)(4)(H): the term top-heavy plan does not include a plan solely because it provides no contributions to section 401(k)(15)(B)(i) employees";
}

@source(IRC_S416_G, relation = formalizes, coverage = partial, quote = "Such term shall not include a plan solely because such plan does not provide nonelective or matching contributions to employees described in section 401(k)(15)(B)(i)")
rule NotTopHeavyBy401k15Exclusion416g4H(plan: Plan) strict {
    label en official "PARTIAL: the second sentence (aggregation group) is not modelled";
    when plan_top_heavy_only_by_401k15_exclusion_416g4H(plan);
    then not_top_heavy_by_401k15_exclusion_416g4H(plan);
}

// =====================================================================
// 417 Survivor annuities
// =====================================================================

pub relation plan_meets_417a_paragraphs_2_3_4_facts(plan: Plan, para2: Boolean, para3: Boolean, para4: Boolean) kind empirical {
    label en unofficial "whether the plan meets the requirements of paragraphs (2), (3) and (4) of subsection (a), case-asserted";
}

pub relation plan_meets_417a_paragraphs_2_3_4_417a1B(plan: Plan) kind institutional {
    label en official "section 417(a)(1)(B): the plan meets the requirements of paragraphs (2), (3) and (4)";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the plan meets the requirements of paragraphs (2), (3), and (4) of this subsection")
rule PlanMeetsParagraphs234417a1B(plan: Plan) strict {
    label en official "all three";
    when plan_meets_417a_paragraphs_2_3_4_facts(plan, true, true, true);
    then plan_meets_417a_paragraphs_2_3_4_417a1B(plan);
}

pub relation spouse_consent_given_417a2(consent: Person, consenting_spouse: Person) kind empirical {
    label en unofficial "the spouse gave the consent (or it was established that consent may not be obtained), case-asserted";
}

pub relation consent_effective_for_spouse_417a2(consent: Person, spouse: Person) kind institutional {
    label en official "section 417(a)(2): the consent is effective only with respect to the consenting spouse";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "shall be effective only with respect to such spouse")
rule ConsentEffectiveOnlyForConsentingSpouse417a2(consent: Person, spouse: Person) strict {
    label en official "the spouse who gave it";
    when spouse_consent_given_417a2(consent, spouse);
    then consent_effective_for_spouse_417a2(consent, spouse);
}

pub relation explanation_items_417a3A(explanation: Person, terms_and_conditions: Boolean, waiver_right_and_effect: Boolean, spouse_rights: Boolean, revocation_right_and_effect: Boolean) kind empirical {
    label en unofficial "the written explanation covers: (i) the terms of the qualified joint and survivor annuity and qualified optional survivor annuity, (ii) the right to waive and its effect, (iii) the spouse's rights, (iv) the right to revoke, case-asserted";
}

pub relation explanation_covers_all_required_items_417a3A(explanation: Person) kind institutional {
    label en official "section 417(a)(3)(A): the explanation covers items (i) through (iv)";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the participant's right to make, and the effect of, an election under paragraph (1) to waive the joint and survivor annuity form of benefit")
rule ExplanationCoversAllItems417a3A(explanation: Person) strict {
    label en official "all four items";
    when explanation_items_417a3A(explanation, true, true, true, true);
    then explanation_covers_all_required_items_417a3A(explanation);
}

pub enum ApplicablePeriodEvent417a3Bii {
    ParagraphFiveCeases;
    Section401a11Applies;
    Other;
}

pub relation applicable_period_facts_417a3Bii(participant: Person, trigger: ApplicablePeriodEvent417a3Bii, event_date: Date, period_end: Date, reasonable_period: Boolean) kind empirical {
    label en unofficial "the event, its date, the end of the period, and whether the period is a reasonable one (an evaluative case fact), case-asserted";
}

pub relation applicable_period_valid_417a3Bii(participant: Person, trigger: ApplicablePeriodEvent417a3Bii) kind institutional {
    label en official "section 417(a)(3)(B)(ii)(III)-(IV): a reasonable period ending after paragraph (5) ceases to apply or after section 401(a)(11) applies";
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "A reasonable period ending after paragraph (5) ceases to apply to the participant")
rule ApplicablePeriodAfterParagraphFive417a3Bii(participant: Person, event_date: Date, end: Date) strict {
    label en official "PARTIAL: subclause (III); reasonableness is a case fact (JUDGMENT CALL)";
    when applicable_period_facts_417a3Bii(participant, ParagraphFiveCeases, event_date, end, true)
        and end >= event_date;
    then applicable_period_valid_417a3Bii(participant, ParagraphFiveCeases);
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "A reasonable period ending after section 401(a)(11) applies to the participant")
rule ApplicablePeriodAfter401a11417a3Bii(participant: Person, event_date: Date, end: Date) strict {
    label en official "PARTIAL: subclause (IV); reasonableness is a case fact (JUDGMENT CALL)";
    when applicable_period_facts_417a3Bii(participant, Section401a11Applies, event_date, end, true)
        and end >= event_date;
    then applicable_period_valid_417a3Bii(participant, Section401a11Applies);
}

pub relation separated_before_age_35_facts_417a3Bii(participant: Person, age_at_separation: Integer, separation_date: Date, period_end: Date, reasonable_period: Boolean) kind empirical {
    label en unofficial "age at separation, the separation date, the end of the period and whether it is a reasonable period, case-asserted";
}

pub relation applicable_period_valid_after_early_separation_417a3Bii(participant: Person) kind institutional {
    label en official "section 417(a)(3)(B)(ii): for a participant who separates before age 35 the applicable period is a reasonable period after separation";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "In the case of a participant who separates from service before attaining age 35, the applicable period shall be a reasonable period after separation")
rule ApplicablePeriodAfterEarlySeparation417a3Bii(participant: Person, age: Integer, sd: Date, end: Date) strict {
    label en official "under 35 at separation; period ends after separation";
    when separated_before_age_35_facts_417a3Bii(participant, age, sd, end, true)
        and age < 35
        and end >= sd;
    then applicable_period_valid_after_early_separation_417a3Bii(participant);
}

pub relation loan_consent_comparable_requirements_417a4(consent: Person, comparable_to_paragraph_2: Boolean) kind empirical {
    label en unofficial "requirements comparable to those of paragraph (2) are met for the consent to the loan security, case-asserted";
}

pub relation loan_consent_requirements_met_417a4B(consent: Person) kind institutional {
    label en official "section 417(a)(4)(B): requirements comparable to paragraph (2) are met for the consent";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "requirements comparable to the requirements of paragraph (2) are met with respect to such consent")
rule LoanConsentRequirementsMet417a4B(consent: Person) strict {
    label en official "comparable requirements met";
    when loan_consent_comparable_requirements_417a4(consent, true);
    then loan_consent_requirements_met_417a4B(consent);
}

pub relation annuity_form_facts_417b(annuity: Person, actuarial_equivalent_of_single_life_annuity: Boolean, same_effect_as_described_annuity: Boolean) kind empirical {
    label en unofficial "the annuity is the actuarial equivalent of a single annuity for the participant's life, or has the effect of an annuity so described, case-asserted";
}

pub relation annuity_meets_actuarial_equivalence_417b2(annuity: Person) kind institutional {
    label en official "sections 417(b) and 417(g)(1): the annuity is the actuarial equivalent of a single annuity for the participant's life, and a form having that effect is included";
}

@source(IRC_S417_B, relation = formalizes, coverage = exact, quote = "which is the actuarial equivalent of a single annuity for the life of the participant")
rule AnnuityActuarialEquivalent417b2(annuity: Person, other: Boolean) strict {
    label en official "the actuarial equivalent";
    when annuity_form_facts_417b(annuity, true, other);
    then annuity_meets_actuarial_equivalence_417b2(annuity);
}

@source(IRC_S417_B, relation = formalizes, coverage = exact, quote = "Such term also includes any annuity in a form having the effect of an annuity described in the preceding sentence")
rule AnnuitySameEffect417b2(annuity: Person, eq: Boolean) strict {
    label en official "a form having the effect";
    when annuity_form_facts_417b(annuity, eq, true);
    then annuity_meets_actuarial_equivalence_417b2(annuity);
}

pub relation qpsa_facts_417c1(plan: Plan, payment: Money, hypothetical_qjsa_survivor_payment: Money, first_payment_date: Date, latest_permitted_first_payment: Date) kind empirical {
    label en unofficial "the surviving spouse's payment, the hypothetical survivor amount under the qualified joint and survivor annuity (a case input computed under (A)(i) or (ii)), the first payment date and the last day of the month in which the participant would have attained the earliest retirement age, case-asserted";
}

pub relation qualified_preretirement_survivor_annuity_417c1(plan: Plan) kind institutional {
    label en official "section 417(c)(1): a survivor annuity for the surviving spouse with payments not less than the hypothetical qualified joint and survivor amount, starting not later than the month of earliest retirement age";
}

@source(IRC_S417_C, relation = formalizes, coverage = partial, quote = "the earliest period for which the surviving spouse may receive a payment under such annuity is not later than the month in which the participant would have attained the earliest retirement age under the plan")
rule QualifiedPreretirementSurvivorAnnuity417c1(plan: Plan, pay: Money, hyp: Money, first: Date, latest: Date) strict {
    label en official "PARTIAL: the hypothetical amount (A) is a case input; (B) is the date test";
    when qpsa_facts_417c1(plan, pay, hyp, first, latest)
        and pay >= hyp
        and first <= latest;
    then qualified_preretirement_survivor_annuity_417c1(plan);
}

pub relation dc_qpsa_facts_417c2(plan: Plan, annuity_actuarial_value: Money, nonforfeitable_account_portion: Money) kind empirical {
    label en unofficial "the actuarial value of the survivor annuity and the portion of the participant's account balance (at death) to which the participant had a nonforfeitable right, case-asserted";
}

pub relation dc_qualified_preretirement_survivor_annuity_417c2(plan: Plan) kind institutional {
    label en official "section 417(c)(2): for a defined contribution plan the annuity's actuarial equivalent is not less than 50 percent of the nonforfeitable account portion";
}

@source(IRC_S417_C, relation = formalizes, coverage = exact, quote = "the actuarial equivalent of which is not less than 50 percent of the portion of the account balance of the participant")
rule DcQualifiedPreretirementSurvivorAnnuity417c2(plan: Plan, value: Money, portion: Money) strict {
    label en official "exact boundary: 50 percent is enough";
    when dc_qpsa_facts_417c2(plan, value, portion)
        and value >= portion * 0.5;
    then dc_qualified_preretirement_survivor_annuity_417c2(plan);
}

pub relation plan_loan_security_interest_417c3(plan: Plan, security_amount: Money) kind empirical {
    label en unofficial "the security interest held by the plan by reason of a loan outstanding to the participant, case-asserted";
}

pub relation account_portion_gross_417c3(plan: Plan, portion: Money) kind empirical {
    label en unofficial "the participant's account portion before the loan security is taken into account, case-asserted";
}

pub relation account_portion_after_loan_security_417c3(plan: Plan, portion: Money) kind institutional {
    label en official "section 417(c)(3): a plan's security interest by reason of a loan is taken into account in determining the amount of the qualified preretirement survivor annuity (JUDGMENT CALL: reduction of the portion, not below zero)";
}

@source(IRC_S417_C, relation = formalizes, coverage = partial, quote = "any security interest held by the plan by reason of a loan outstanding to the participant shall be taken into account in determining the amount of the qualified preretirement survivor annuity")
rule AccountPortionAfterLoanSecurity417c3(plan: Plan, gross: Money, sec: Money) strict {
    label en official "PARTIAL: reduction by the security, floored at zero (JUDGMENT CALL)";
    when account_portion_gross_417c3(plan, gross)
        and plan_loan_security_interest_417c3(plan, sec);
    then account_portion_after_loan_security_417c3(plan, max(0 USD, gross - sec));
}

pub relation nonforfeitable_accrued_benefit_417f1(participant: Person, amount: Money) kind empirical {
    label en unofficial "the portion of the accrued benefit to which the participant has a nonforfeitable right (section 411(a)), case-asserted";
}

pub relation vested_participant_417f1(participant: Person) kind institutional {
    label en official "section 417(f)(1): a participant who has a nonforfeitable right to any portion of the accrued benefit";
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "any participant who has a nonforfeitable right")
rule VestedParticipant417f1(participant: Person, amount: Money) strict {
    label en official "any portion above zero";
    when nonforfeitable_accrued_benefit_417f1(participant, amount)
        and amount > 0 USD;
    then vested_participant_417f1(participant);
}

pub enum BenefitForm417f2 {
    Annuity;
    NotAnnuity;
}

pub relation annuity_starting_date_facts_417f2A(participant: Person, form: BenefitForm417f2, first_period_first_day: Date, all_events_occurred_first_day: Date) kind empirical {
    label en unofficial "the form of the benefit, the first day of the first period for which an amount is payable as an annuity, and the first day on which all events entitling the participant to a non-annuity benefit have occurred, case-asserted";
}

pub relation annuity_starting_date_417f2A(participant: Person, on: Date) kind institutional {
    label en official "section 417(f)(2)(A): the first day of the first annuity period, or for a non-annuity benefit the first day all entitling events have occurred";
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "the first day of the first period for which an amount is payable as an annuity")
rule AnnuityStartingDateAnnuity417f2A(participant: Person, first: Date, ev: Date) strict {
    label en official "clause (i)";
    when annuity_starting_date_facts_417f2A(participant, Annuity, first, ev);
    then annuity_starting_date_417f2A(participant, first);
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "the first day on which all events have occurred which entitle the participant to such benefit")
rule AnnuityStartingDateNotAnnuity417f2A(participant: Person, first: Date, ev: Date) strict {
    label en official "clause (ii)";
    when annuity_starting_date_facts_417f2A(participant, NotAnnuity, first, ev);
    then annuity_starting_date_417f2A(participant, ev);
}

pub relation disability_benefit_first_day_facts_417f2B(participant: Person, auxiliary_benefit: Boolean) kind empirical {
    label en unofficial "the benefit is a disability benefit and whether it is an auxiliary benefit, case-asserted";
}

pub relation disability_benefit_first_day_is_starting_date_417f2B(participant: Person) kind institutional {
    label en official "section 417(f)(2)(B): the first day of the first period for a disability benefit is the annuity starting date only if the benefit is not an auxiliary benefit";
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "the first day of the first period for which a benefit is to be received by reason of disability shall be treated as the annuity starting date only if such benefit is not an auxiliary benefit")
rule DisabilityBenefitFirstDayIsStartingDate417f2B(participant: Person) strict {
    label en official "not an auxiliary benefit";
    when disability_benefit_first_day_facts_417f2B(participant, false);
    then disability_benefit_first_day_is_starting_date_417f2B(participant);
}

pub relation loan_security_meets_417a4_and_default_distribution_417f5(participant: Person, security_meets_a4: Boolean, distribution_required_by_default: Boolean) kind empirical {
    label en unofficial "the security meets the requirements of subsection (a)(4), and a distribution is required by reason of failure to comply with the loan terms, case-asserted";
}

pub relation default_distribution_not_prevented_417f5(participant: Person) kind institutional {
    label en official "section 417(f)(5): nothing in this section or section 411(a)(11) prevents a distribution required by reason of a failure to comply with the loan terms";
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "nothing in this section or section 411(a)(11) shall prevent any distribution required by reason of a failure to comply with the terms of such loan")
rule DefaultDistributionNotPrevented417f5(participant: Person) strict {
    label en official "both facts";
    when loan_security_meets_417a4_and_default_distribution_417f5(participant, true, true);
    then default_distribution_not_prevented_417f5(participant);
}

pub relation spousal_consent_for_417e_facts_417f6(consent: Person, comparable_to_417a1A: Boolean) kind empirical {
    label en unofficial "requirements comparable to those for spousal consent to an election under subsection (a)(1)(A) are met, case-asserted";
}

pub relation spousal_consent_effective_for_417e_417f6(consent: Person) kind institutional {
    label en official "section 417(f)(6): a spouse's consent is effective for subsection (e)(1) or (e)(2) only if comparable requirements are met";
}

@source(IRC_S417_F, relation = formalizes, coverage = exact, quote = "No consent of a spouse shall be effective for purposes of subsection (e)(1) or (e)(2) (as the case may be) unless requirements comparable to the requirements for spousal consent to an election under subsection (a)(1)(A) are met")
rule SpousalConsentEffectiveFor417e417f6(consent: Person) strict {
    label en official "comparable requirements met";
    when spousal_consent_for_417e_facts_417f6(consent, true);
    then spousal_consent_effective_for_417e_417f6(consent);
}
