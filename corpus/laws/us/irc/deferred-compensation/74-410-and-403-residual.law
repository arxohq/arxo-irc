// Sections 410 and 403 residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): 410(a)(4)-(5), (b)(2)-(6), (c), (d) and 403(a)-(c),
// (b)(3), (b)(5)-(9), (b)(12), (b)(15)-(16).
//
// Pattern (modules 10/36/41): each statutory sentence becomes case facts and a
// derived treatment relation; ages, hours, percentages and dollar limits are
// exact; the Secretary's findings and regulations are case facts. SECURE 2.0
// revisions (the 403(b)(15)/(16) additions) apply for years after 2022/2024
// and their pre-amendment text is not pinned (G4601).

// =====================================================================
// 410(a)
// =====================================================================

use self::{
    AbsenceReason411a6E,
    IRC_S403_A,
    IRC_S403_B,
    IRC_S403_C,
    IRC_S410_A,
    IRC_S410_B,
    IRC_S410_C,
    IRC_S410_D,
    Person,
    Plan,
    TaxableYear,
};

pub relation hour_of_service_by_labor_regulation_410a3C(item: Person) kind empirical {
    label en unofficial "the time of service is an hour of service determined under the Secretary of Labor's regulations, case-asserted";
}

pub relation hour_of_service_410a3C(item: Person) kind institutional {
    label en official "section 410(a)(3)(C): an hour of service is a time of service determined under regulations of the Secretary of Labor (external)";
}

@source(IRC_S410_A, relation = formalizes, coverage = partial, quote = "the term \"hour of service\" means a time of service determined under regulations prescribed by the Secretary of Labor")
rule HourOfService410a3C(item: Person) strict {
    label en official "PARTIAL: the regulation is not pinned";
    when hour_of_service_by_labor_regulation_410a3C(item);
    then hour_of_service_410a3C(item);
}

pub relation employee_separated_before_participation_date_410a4(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee was separated from the service before the participation date under clause (A) or (B) (whichever applies), case-asserted";
}

pub relation participation_date_exempt_410a4(employee: Person, plan: Plan, requirements_met_on: Date, commenced_on: Date) kind empirical {
    label en unofficial "the date the employee satisfied the age and service requirements and the date participation commenced, case-asserted";
}

pub relation participation_timing_ok_410a4(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(a)(4): participation commences by the earlier of the first day of the first plan year beginning after the requirements are satisfied and 6 months after (unless separated before that date)";
}

pub relation first_plan_year_start_after_requirements_410a4A(employee: Person, plan: Plan, start: Date) kind empirical {
    label en unofficial "the first day of the first plan year beginning after the date the requirements were satisfied, case-asserted";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "the date 6 months after the date on which he satisfied such requirements")
rule ParticipationTimingOk410a4(employee: Person, plan: Plan, met: Date, commenced: Date, start: Date) strict {
    label en official "exact boundary: commencement on the earlier of the plan year start and met + 6 months is timely";
    when participation_date_exempt_410a4(employee, plan, met, commenced)
        and first_plan_year_start_after_requirements_410a4A(employee, plan, start)
        and commenced <= (if start <= add_calendar_period(met, 6 calendar_month) then start else add_calendar_period(met, 6 calendar_month));
    then participation_timing_ok_410a4(employee, plan);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "unless such employee was separated from the service before the date referred to in subparagraph (A) or (B), whichever is applicable")
rule ParticipationTimingSeparated410a4(employee: Person, plan: Plan) strict {
    label en official "separated before the date: no participation is required";
    when employee_separated_before_participation_date_410a4(employee, plan);
    then participation_timing_ok_410a4(employee, plan);
}

pub relation years_of_service_with_employers_410a5A(employee: Person, plan: Plan, years: Integer, excluded_years: Integer) kind empirical {
    label en unofficial "all years of service with the employer or employers maintaining the plan, and the years that subparagraphs (B), (C) or (D) exclude, case-asserted";
}

pub relation period_of_service_years_410a5A(employee: Person, plan: Plan, years: Integer) kind institutional {
    label en official "section 410(a)(5)(A): all years of service are taken into account except as (B), (C) and (D) provide";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "all years of service with the employer or employers maintaining the plan shall be taken into account in computing the period of service for purposes of paragraph (1)")
rule PeriodOfServiceYears410a5A(employee: Person, plan: Plan, years: Integer, excluded: Integer) strict {
    label en official "years - excluded years, not below zero";
    when years_of_service_with_employers_410a5A(employee, plan, years, excluded);
    then period_of_service_years_410a5A(employee, plan, max(0, years - excluded));
}

pub relation consecutive_one_year_breaks_410a5D(employee: Person, plan: Plan, breaks: Integer) kind empirical {
    label en unofficial "the number of consecutive 1-year breaks in service in the period, case-asserted";
}

pub relation service_before_breaks_years_410a5D(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the aggregate years of service before the period (not previously disregarded), case-asserted";
}

pub relation participant_nonvested_410a5Diii(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the participant has no nonforfeitable right to an accrued benefit derived from employer contributions, case-asserted";
}

pub relation earlier_service_may_be_disregarded_410a5D(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(a)(5)(D): for a nonvested participant, service before a period of consecutive 1-year breaks may be disregarded if the breaks equal or exceed the greater of 5 and the aggregate prior years of service";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "if the number of consecutive 1-year breaks in service within such period equals or exceeds the greater of")
rule EarlierServiceMayBeDisregarded410a5D(employee: Person, plan: Plan, breaks: Integer, before: Integer) strict {
    label en official "exact boundary: breaks >= max(5, prior years) (equal is enough)";
    when participant_nonvested_410a5Diii(employee, plan)
        and consecutive_one_year_breaks_410a5D(employee, plan, breaks)
        and service_before_breaks_years_410a5D(employee, plan, before)
        and breaks >= 5
        and breaks >= before;
    then earlier_service_may_be_disregarded_410a5D(employee, plan);
}

pub relation service_previously_disregarded_410a5Dii(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "years of service already not taken into account by an earlier period of breaks, case-asserted";
}

pub relation years_available_for_subsequent_break_test_410a5Dii(employee: Person, plan: Plan, years: Integer) kind institutional {
    label en official "section 410(a)(5)(D)(ii): years already disregarded are not counted again in applying clause (i) to a later period of breaks";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "such years of service shall not be taken into account in applying clause (i) to a subsequent period of breaks in service")
rule YearsAvailableForSubsequentBreakTest410a5Dii(employee: Person, plan: Plan, total: Integer, disregarded: Integer) strict {
    label en official "total years - previously disregarded years";
    when years_of_service_with_employers_410a5A(employee, plan, total, _)
        and service_previously_disregarded_410a5Dii(employee, plan, disregarded);
    then years_available_for_subsequent_break_test_410a5Dii(employee, plan, max(0, total - disregarded));
}

pub enum MaternityAbsenceReason410a5E {
    Pregnancy;
    Birth;
    AdoptionPlacement;
    CareOfChildAfterBirthOrPlacement;
    Other;
}

pub relation absence_reason_410a5E(employee: Person, plan: Plan, reason: MaternityAbsenceReason410a5E) kind empirical {
    label en unofficial "the reason for the absence from work, case-asserted";
}

pub relation absence_for_maternity_or_paternity_410a5Ei(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(a)(5)(E)(i): an absence by reason of pregnancy, birth, adoption placement, or care of the child following birth or placement";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "by reason of the pregnancy of the individual")
rule AbsenceForMaternityOrPaternityPregnancy410a5Ei(employee: Person, plan: Plan) strict {
    label en official "(I) pregnancy";
    when absence_reason_410a5E(employee, plan, Pregnancy);
    then absence_for_maternity_or_paternity_410a5Ei(employee, plan);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "by reason of the birth of a child of the individual")
rule AbsenceForMaternityOrPaternityBirth410a5Ei(employee: Person, plan: Plan) strict {
    label en official "(II) birth";
    when absence_reason_410a5E(employee, plan, Birth);
    then absence_for_maternity_or_paternity_410a5Ei(employee, plan);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "by reason of the placement of a child with the individual in connection with the adoption of such child by such individual")
rule AbsenceForMaternityOrPaternityAdoption410a5Ei(employee: Person, plan: Plan) strict {
    label en official "(III) adoption placement";
    when absence_reason_410a5E(employee, plan, AdoptionPlacement);
    then absence_for_maternity_or_paternity_410a5Ei(employee, plan);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "for purposes of caring for such child for a period beginning immediately following such birth or placement")
rule AbsenceForMaternityOrPaternityCare410a5Ei(employee: Person, plan: Plan) strict {
    label en official "(IV) care";
    when absence_reason_410a5E(employee, plan, CareOfChildAfterBirthOrPlacement);
    then absence_for_maternity_or_paternity_410a5Ei(employee, plan);
}

pub relation break_avoided_in_absence_year_410a5Eiii(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the participant would be prevented from incurring a 1-year break in service in the year the absence begins solely because the absence is treated as hours of service, case-asserted";
}

pub relation maternity_hours_credit_year_410a5Eiii(employee: Person, plan: Plan, in_year_absence_begins: Boolean) kind institutional {
    label en official "section 410(a)(5)(E)(iii): the hours are credited only in the year the absence begins if that prevents a 1-year break in that year, otherwise in the following year";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "only in the year in which the absence from work begins, if a participant would be prevented from incurring a 1-year break in service in such year solely because the period of absence is treated as hours of service")
rule MaternityHoursCreditYearCurrent410a5Eiii(employee: Person, plan: Plan) strict {
    label en official "(I)";
    when absence_for_maternity_or_paternity_410a5Ei(employee, plan)
        and break_avoided_in_absence_year_410a5Eiii(employee, plan);
    then maternity_hours_credit_year_410a5Eiii(employee, plan, true);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "in any other case, in the immediately following year")
rule MaternityHoursCreditYearFollowing410a5Eiii(employee: Person, plan: Plan) strict {
    label en official "(II)";
    when absence_for_maternity_or_paternity_410a5Ei(employee, plan)
        and not_known(break_avoided_in_absence_year_410a5Eiii(employee, plan));
    then maternity_hours_credit_year_410a5Eiii(employee, plan, false);
}

pub relation information_furnished_timely_410a5Ev(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the individual furnishes the timely information the plan reasonably requires to establish the reason for the absence and the number of days, case-asserted";
}

pub relation plan_may_condition_credit_on_information_410a5Ev(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(a)(5)(E)(v): the plan may condition the credit on timely information establishing the reason and the number of days";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "unless the individual furnishes to the plan administrator such timely information as the plan may reasonably require to establish")
rule PlanMayConditionCreditOnInformation410a5Ev(employee: Person, plan: Plan) strict {
    label en official "information furnished";
    when information_furnished_timely_410a5Ev(employee, plan);
    then plan_may_condition_credit_on_information_410a5Ev(employee, plan);
}

// =====================================================================
// 410(b)
// =====================================================================

pub relation benefit_percentage_of_employee_410b2C(employee: Person, plan_year: TaxableYear, contribution_or_benefit: Money, compensation: Money) kind empirical {
    label en unofficial "the employer-provided contribution or benefit of the employee under all qualified plans and the employee's compensation (section 414(s)), case-asserted";
}

pub relation benefit_percentage_410b2Ci(employee: Person, plan_year: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 410(b)(2)(C)(i): the employer-provided contribution or benefit as a percentage of compensation (a fraction, 6 places HALF_UP)";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "expressed as a percentage of such employee's compensation (within the meaning of section 414(s))")
rule BenefitPercentage410b2Ci(employee: Person, y: TaxableYear, amount: Money, comp: Money) strict {
    label en official "contribution or benefit / compensation";
    when benefit_percentage_of_employee_410b2C(employee, y, amount, comp)
        and comp > 0 USD;
    then benefit_percentage_410b2Ci(employee, y, div_round(amount / 1.00 USD, comp / 1.00 USD, 6, "HALF_UP"));
}

pub relation employee_in_group_410b2B(employee: Person, plan_year: TaxableYear, group_is_hce: Boolean) kind empirical {
    label en unofficial "the employee belongs to the group of highly compensated employees (true) or nonhighly compensated employees (false), whether or not a participant in any plan, case-asserted";
}

pub relation employee_benefit_percentage_410b2B(employee: Person, plan: Plan, y: TaxableYear, hce_group: Boolean, pct: Decimal) kind empirical {
    label en unofficial "the employee's benefit percentage (a fraction) and whether the employee is highly compensated (true) or not (false); every employee in the group, whether or not a participant, case-asserted";
}

pub relation group_size_410b2B(plan: Plan, y: TaxableYear, hce_group: Boolean, n: Integer) kind empirical {
    label en unofficial "the number of employees in the group, case-asserted";
}

pub relation average_benefit_percentage_410b2B(plan: Plan, y: TaxableYear, hce_group: Boolean, avg: Decimal) kind institutional {
    label en official "section 410(b)(2)(B): the average of the benefit percentages calculated separately for each employee in the group, whether or not a participant in any plan (10 places HALF_UP: JUDGMENT CALL)";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the average of the benefit percentages calculated separately with respect to each employee in such group (whether or not a participant in any plan)")
rule AverageBenefitPercentage410b2B(plan: Plan, y: TaxableYear, hce: Boolean, n: Integer) strict {
    label en official "sum of the per-employee percentages divided by the group size";
    when group_size_410b2B(plan, y, hce, n) and n > 0;
    then average_benefit_percentage_410b2B(plan, y, hce,
        div_round(sum all r: Decimal for e: Person where employee_benefit_percentage_410b2B(e, plan, y, hce, r), 1.0 * n, 10, "HALF_UP"));
}

pub relation average_benefit_test_met_410b2Aii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(2)(A)(ii): the nonhighly compensated average benefit percentage is at least 70 percent of the highly compensated one";
}

@source(IRC_S410_B, relation = formalizes, coverage = partial, quote = "the average benefit percentage for employees who are not highly compensated employees is at least 70 percent of the average benefit percentage for highly compensated employees")
rule AverageBenefitTestMet410b2Aii(plan: Plan, y: TaxableYear, nhce: Decimal, hce: Decimal) strict {
    label en official "PARTIAL: exact boundary nhce >= 0.70 x hce (the classification of clause (i) is a case fact)";
    when average_benefit_percentage_410b2B(plan, y, false, nhce)
        and average_benefit_percentage_410b2B(plan, y, true, hce)
        and nhce >= hce * 0.70;
    then average_benefit_test_met_410b2Aii(plan, y);
}

pub relation benefit_percentage_period_years_410b2Cii(plan: Plan, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the number of consecutive plan years ending with the plan year over which the employer elects to compute the benefit percentage (1 = the plan year), case-asserted";
}

pub relation benefit_percentage_period_election_valid_410b2Cii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(2)(C)(ii): the benefit percentage may be computed over the plan year or a consecutive period of not more than 3 years ending with it";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "any consecutive plan year period (not greater than 3 years) which ends with such plan year and which is specified in such election")
rule BenefitPercentagePeriodElectionValid410b2Cii(plan: Plan, y: TaxableYear, years: Integer) strict {
    label en official "exact boundary: 3 years is allowed, 4 is not";
    when benefit_percentage_period_years_410b2Cii(plan, y, years)
        and years >= 1 and years <= 3;
    then benefit_percentage_period_election_valid_410b2Cii(plan, y);
}

pub relation employer_elects_lowest_age_service_410b2Dii(plan: Plan) kind empirical {
    label en unofficial "the employer elects to apply paragraph (4)(A) using the lowest age and service requirements of all its qualified plans, case-asserted";
}

pub relation employees_for_average_benefit_use_paragraph_4A_410b2D(plan: Plan, lowest_requirements: Boolean) kind institutional {
    label en official "section 410(b)(2)(D): for the employees in the average benefit percentage, paragraph (4)(A) does not apply (clause (i)), or applies with the lowest age and service requirements of all qualified plans if the employer elects (clause (ii))";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "if the employer elects, paragraph (4)(A) shall be applied by using the lowest age and service requirements of all qualified plans maintained by the employer")
rule EmployeesForAverageBenefitUseParagraph4AElected410b2D(plan: Plan) strict {
    label en official "clause (ii)";
    when employer_elects_lowest_age_service_410b2Dii(plan);
    then employees_for_average_benefit_use_paragraph_4A_410b2D(plan, true);
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "except as provided in clause (ii), paragraph (4)(A) shall not apply")
rule EmployeesForAverageBenefitUseParagraph4ADefault410b2D(plan: Plan) strict {
    label en official "clause (i) (an average benefit test plan without the election)";
    when average_benefit_plan_410b2(plan)
        and not_known(employer_elects_lowest_age_service_410b2Dii(plan));
    then employees_for_average_benefit_use_paragraph_4A_410b2D(plan, false);
}

pub relation average_benefit_plan_410b2(plan: Plan) kind empirical {
    label en unofficial "the plan is tested under the average benefit percentage test, case-asserted";
}

pub relation plan_meets_401a_without_410_410b2E(plan: Plan) kind empirical {
    label en unofficial "the plan (without regard to this subsection) meets the requirements of section 401(a), case-asserted";
}

pub relation qualified_plan_for_average_benefit_410b2E(plan: Plan) kind institutional {
    label en official "section 410(b)(2)(E): a qualified plan is a plan that meets section 401(a) without regard to the subsection";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the term \"qualified plan\" means any plan which (without regard to this subsection) meets the requirements of section 401(a)")
rule QualifiedPlanForAverageBenefit410b2E(plan: Plan) strict {
    label en official "cross-reference";
    when plan_meets_401a_without_410_410b2E(plan);
    then qualified_plan_for_average_benefit_410b2E(plan);
}

pub relation management_pilots_manage_flight_operations_410b3(plan: Plan) kind empirical {
    label en unofficial "management pilots not represented under title II of the Railway Labor Act manage the flight operations of air carriers whose pilots are so represented, case-asserted";
}

pub relation management_pilots_treated_as_covered_by_cba_410b3B(plan: Plan) kind institutional {
    label en official "section 410(b)(3): such management pilots are treated as covered by a collective bargaining agreement";
}

@source(IRC_S410_B, relation = formalizes, coverage = partial, quote = "management pilots who are not represented in accordance with title II of the Railway Labor Act shall be treated as covered by a collective bargaining agreement")
rule ManagementPilotsTreatedAsCoveredByCba410b3B(plan: Plan) strict {
    label en official "PARTIAL: the remainder of the sentence (the air carrier condition) is one case fact";
    when management_pilots_manage_flight_operations_410b3(plan);
    then management_pilots_treated_as_covered_by_cba_410b3B(plan);
}

pub relation employees_below_age_service_covered_by_separate_plan_410b4B(plan: Plan) kind empirical {
    label en unofficial "employees not meeting the minimum age or service requirements are covered under a plan of the employer that meets paragraph (1) separately with respect to them, case-asserted";
}

pub relation employees_may_be_excluded_from_410b1_410b4B(plan: Plan) kind institutional {
    label en official "section 410(b)(4)(B): such employees may be excluded from consideration in determining whether any plan of the employer meets paragraph (1)";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "such employees may be excluded from consideration in determining whether any plan of the employer meets the requirements of paragraph (1)")
rule EmployeesMayBeExcludedFrom410b1410b4B(plan: Plan) strict {
    label en official "separately tested group";
    when employees_below_age_service_covered_by_separate_plan_410b4B(plan);
    then employees_may_be_excluded_from_410b1_410b4B(plan);
}

pub relation earliest_entry_date_of_equal_employee_410b4C(employee: Person, plan: Plan, first_date: Date) kind empirical {
    label en unofficial "the first date on which, under the plan, any employee with the same age and service would be eligible to commence participation, case-asserted";
}

pub relation employee_treated_as_meeting_age_service_on_410b4C(employee: Person, plan: Plan, on: Date, asked_on: Date) kind institutional {
    label en official "section 410(b)(4)(C): an employee is not treated as meeting the age and service requirements until the first date any employee with the same age and service would be eligible to commence participation";
}

pub relation age_service_query_date_410b4C(employee: Person, plan: Plan, asked_on: Date) kind empirical {
    label en unofficial "the date for which the treatment is asked about, case-asserted";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "An employee shall not be treated as meeting the age and service requirements described in this paragraph until the first date on which, under the plan, any employee with the same age and service would be eligible to commence participation in the plan.")
rule EmployeeTreatedAsMeetingAgeService410b4C(employee: Person, plan: Plan, first: Date, asked_on: Date) strict {
    label en official "exact boundary: on the first date itself the employee is treated as meeting the requirements";
    when earliest_entry_date_of_equal_employee_410b4C(employee, plan, first)
        and age_service_query_date_410b4C(employee, plan, asked_on)
        and asked_on >= first;
    then employee_treated_as_meeting_age_service_on_410b4C(employee, plan, first, asked_on);
}

pub relation separate_line_of_business_election_410b5A(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "under section 414(r) the employer is treated as operating separate lines of business for the year and applies the subsection separately, case-asserted";
}

pub relation subsection_applied_by_line_of_business_410b5A(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 410(b)(5)(A): the requirements may be applied separately for each separate line of business";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the employer may apply the requirements of this subsection for such year separately with respect to employees in each separate line of business")
rule SubsectionAppliedByLineOfBusiness410b5A(employer: Person, y: TaxableYear) strict {
    label en official "separate lines of business";
    when separate_line_of_business_election_410b5A(employer, y);
    then subsection_applied_by_line_of_business_410b5A(employer, y);
}

pub relation classification_found_nondiscriminatory_by_secretary_410b5B(plan: Plan) kind empirical {
    label en unofficial "the plan benefits employees who qualify under a classification set up by the employer and found by the Secretary not to be discriminatory in favor of highly compensated employees, case-asserted";
}

pub relation subparagraph_A_applies_to_plan_410b5B(plan: Plan) kind institutional {
    label en official "section 410(b)(5)(B): subparagraph (A) applies to a plan only if its classification is found by the Secretary not to be discriminatory";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply with respect to any plan maintained by an employer unless such plan benefits such employees as qualify under a classification set up by the employer")
rule SubparagraphAAppliesToPlan410b5B(plan: Plan) strict {
    label en official "found nondiscriminatory";
    when classification_found_nondiscriminatory_by_secretary_410b5B(plan);
    then subparagraph_A_applies_to_plan_410b5B(plan);
}

pub relation hce_status_by_414q_410b6A(employee: Person) kind empirical {
    label en unofficial "the employee is a highly compensated employee within the meaning of section 414(q), case-asserted";
}

pub relation highly_compensated_by_414q_for_410b6A(employee: Person) kind institutional {
    label en official "section 410(b)(6)(A): highly compensated employee has the meaning of section 414(q)";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "The term \"highly compensated employee\" has the meaning given such term by section 414(q).")
rule HighlyCompensatedBy414qFor410b6A(employee: Person) strict {
    label en official "cross-reference";
    when hce_status_by_414q_410b6A(employee);
    then highly_compensated_by_414q_for_410b6A(employee);
}

pub enum DesignatedPlanKind410b6B {
    Trust;
    AnnuityPlan;
}

pub relation employer_designates_as_one_plan_410b6B(employer: Person, item: Person, kind: DesignatedPlanKind410b6B) kind empirical {
    label en unofficial "the employer designates the trust or annuity plan as part of 1 plan intended to qualify under section 401(a), case-asserted (one row per item)";
}

pub relation designated_as_one_plan_410b6B(employer: Person, trusts: Integer, annuities: Integer) kind institutional {
    label en official "section 410(b)(6)(B): 2 or more trusts, 1 or more trusts and 1 or more annuity plans, or 2 or more annuity plans may be designated as 1 plan";
}

pub relation designation_counts_410b6B(employer: Person, trusts: Integer, annuities: Integer) kind empirical {
    label en unofficial "the number of trusts and annuity plans the employer designates as 1 plan, case-asserted";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "An employer may elect to designate")
rule DesignatedAsOnePlan410b6B(employer: Person, trusts: Integer, annuities: Integer) strict {
    label en official "exact: (2+ trusts) or (1+ trust and 1+ annuity plan) or (2+ annuity plans)";
    when designation_counts_410b6B(employer, trusts, annuities)
        and (trusts >= 2 or (trusts >= 1 and annuities >= 1) or annuities >= 2);
    then designated_as_one_plan_410b6B(employer, trusts, annuities);
}

pub relation plan_described_in_410c1_410c2(plan: Plan) kind empirical {
    label en unofficial "the plan is described in paragraph (1) (a governmental plan, a church plan without an election, or another listed plan), case-asserted";
}

pub relation plan_described_in_410c1_kind_410c2(plan: Plan, kind: Integer) kind empirical {
    label en unofficial "the kind of paragraph (1) plan (1 = A, 2 = B, 3 = C, 4 = D), case-asserted";
}

pub relation plan_meets_401a3_as_of_1974_410c2(plan: Plan) kind empirical {
    label en unofficial "the plan meets the requirements of section 401(a)(3) as in effect on September 1, 1974, case-asserted";
}

pub relation plan_treated_as_meeting_410_for_401a_410c2(plan: Plan) kind institutional {
    label en official "section 410(c)(2): a paragraph (1) plan is treated as meeting the section for section 401(a), except that plans of kinds (B), (C) and (D) also need section 401(a)(3) as in effect on September 1, 1974";
}

@source(IRC_S410_C, relation = formalizes, coverage = exact, quote = "A plan described in paragraph (1) shall be treated as meeting the requirements of this section for purposes of section 401(a)")
rule PlanTreatedAsMeeting410For401aKindA410c2(plan: Plan) strict {
    label en official "kind (A)";
    when plan_described_in_410c1_kind_410c2(plan, 1);
    then plan_treated_as_meeting_410_for_401a_410c2(plan);
}

@source(IRC_S410_C, relation = formalizes, coverage = exact, quote = "this paragraph shall apply only if such plan meets the requirements of section 401(a)(3) (as in effect on September 1, 1974)")
rule PlanTreatedAsMeeting410For401aOther410c2(plan: Plan, kind: Integer) strict {
    label en official "kinds (B), (C), (D) with 401(a)(3) as of 1974";
    when plan_described_in_410c1_kind_410c2(plan, kind)
        and kind >= 2 and kind <= 4
        and plan_meets_401a3_as_of_1974_410c2(plan);
    then plan_treated_as_meeting_410_for_401a_410c2(plan);
}

pub relation church_plan_election_made_410d(plan: Plan, on: Date) kind empirical {
    label en unofficial "the church or convention or association of churches makes an election under the subsection for the church plan, case-asserted";
}

pub relation church_plan_election_effective_410d1(plan: Plan) kind institutional {
    label en official "section 410(d)(1): the title's participation, vesting, funding provisions then apply to the church plan as if they had no church plan exclusion";
}

@source(IRC_S410_D, relation = formalizes, coverage = partial, quote = "then the provisions of this title relating to participation, vesting, funding, etc. (as in effect from time to time) shall apply to such church plan as if such provisions did not contain an exclusion for church plans")
rule ChurchPlanElectionEffective410d1(plan: Plan, on: Date) strict {
    label en official "PARTIAL: the form and manner are the Secretary's";
    when church_plan_election_made_410d(plan, on);
    then church_plan_election_effective_410d1(plan);
}

pub relation church_plan_election_revoked_410d2(plan: Plan) kind empirical {
    label en unofficial "an attempt to revoke the election, case-asserted";
}

pub relation church_plan_election_binding_410d2(plan: Plan) kind institutional {
    label en official "section 410(d)(2): the election is binding and irrevocable once made (a revocation attempt has no effect)";
}

@source(IRC_S410_D, relation = formalizes, coverage = exact, quote = "An election under this subsection with respect to any church plan shall be binding with respect to such plan, and, once made, shall be irrevocable.")
rule ChurchPlanElectionBinding410d2(plan: Plan, on: Date) strict {
    label en official "irrevocable once made";
    when church_plan_election_made_410d(plan, on);
    then church_plan_election_binding_410d2(plan);
}

// =====================================================================
// 403
// =====================================================================

pub relation includible_compensation_base_403b3(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "compensation received from the employer includible in gross income (computed without regard to section 911) for the most recent 1-year-of-service period ending not later than the close of the taxable year and preceding it by no more than 5 years, excluding employer contributions for annuity contracts, case-asserted";
}

pub relation elective_deferrals_403b3A(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's elective deferrals (section 402(g)(3)), case-asserted";
}

pub relation employee_elected_excluded_amounts_403b3B(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts contributed or deferred at the employee's election and not includible under section 125, 132(f)(4) or 457, case-asserted";
}

pub relation includible_compensation_sum_403b3(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 403(b)(3): includible compensation is the includible compensation plus the elective deferrals and the elective amounts excluded under sections 125, 132(f)(4) and 457";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "any amount which is contributed or deferred by the employer at the election of the employee and which is not includible in the gross income of the employee by reason of section 125, 132(f)(4), or 457")
rule IncludibleCompensation403b3(employee: Person, y: TaxableYear, base: Money, deferrals: Money, elected: Money) strict {
    label en official "base + (A) + (B)";
    when includible_compensation_base_403b3(employee, y, base)
        and elective_deferrals_403b3A(employee, y, deferrals)
        and employee_elected_excluded_amounts_403b3B(employee, y, elected);
    then includible_compensation_sum_403b3(employee, y, base + deferrals + elected);
}

pub relation annuity_contract_amounts_403b5(employee: Person, y: TaxableYear, contract_count: Integer) kind empirical {
    label en unofficial "the number of annuity contracts purchased by the employer to which the subsection applies for the taxable year, case-asserted";
}

pub relation contracts_treated_as_one_contract_403b5(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 403(b)(5): if the subsection applies to 2 or more annuity contracts for a taxable year, they are treated as one contract";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "such contracts shall be treated as one contract")
rule ContractsTreatedAsOneContract403b5(employee: Person, y: TaxableYear, n: Integer) strict {
    label en official "exact boundary: 2 contracts are treated as one, 1 is not a combination";
    when annuity_contract_amounts_403b5(employee, y, n)
        and n >= 2;
    then contracts_treated_as_one_contract_403b5(employee, y);
}

pub relation custodial_account_investment_403b7(account: Person) kind empirical {
    label en unofficial "amounts paid by an employer to a custodial account satisfying section 401(f)(2), held and invested in regulated investment company stock (or a group trust satisfying the section 401(a) requirements), case-asserted";
}

pub relation custodial_account_amounts_treated_as_annuity_contributions_403b7a(account: Person) kind institutional {
    label en official "section 403(b)(7)(A): the amounts paid to the custodial account are treated as contributions for an annuity contract";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "shall be treated as amounts contributed by him for an annuity contract for his employee if the amounts are to be held in that custodial account and are invested in regulated investment company stock")
rule CustodialAccountAmountsTreatedAsAnnuityContributions403b7a(account: Person) strict {
    label en official "PARTIAL: the distribution restrictions of clause (ii) and the group trust alternative are one case fact";
    when custodial_account_investment_403b7(account);
    then custodial_account_amounts_treated_as_annuity_contributions_403b7a(account);
}

pub relation custodial_account_treated_as_401a_organization_403b7b(account: Person) kind institutional {
    label en official "section 403(b)(7)(B): a custodial account satisfying section 401(f)(2) is treated as an organization described in section 401(a) solely for subchapter F and subtitle F";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "shall be treated as an organization described in section 401(a) solely for purposes of subchapter F and subtitle F with respect to amounts received by it")
rule CustodialAccountTreatedAs401aOrganization403b7b(account: Person) strict {
    label en official "section 401(f)(2) account";
    when custodial_account_investment_403b7(account);
    then custodial_account_treated_as_401a_organization_403b7b(account);
}

pub enum LifetimeIncomeDistributionForm403b7 {
    QualifiedDistribution;
    QualifiedPlanDistributionAnnuityContract;
    Other;
}

pub relation lifetime_income_distribution_form_403b7Aii(account: Person, form: LifetimeIncomeDistributionForm403b7) kind empirical {
    label en unofficial "the form in which amounts described in clause (i)(VI) are distributed, case-asserted";
}

pub relation lifetime_income_form_permitted_403b7Aii(account: Person) kind institutional {
    label en official "section 403(b)(7)(A)(ii): those amounts are distributed only as a qualified distribution or a qualified plan distribution annuity contract";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "such amounts will be distributed only in the form of a qualified distribution")
rule LifetimeIncomeFormPermittedQualified403b7Aii(account: Person) strict {
    label en official "qualified distribution";
    when lifetime_income_distribution_form_403b7Aii(account, QualifiedDistribution);
    then lifetime_income_form_permitted_403b7Aii(account);
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "a qualified plan distribution annuity contract")
rule LifetimeIncomeFormPermittedAnnuity403b7Aii(account: Person) strict {
    label en official "annuity contract";
    when lifetime_income_distribution_form_403b7Aii(account, QualifiedPlanDistributionAnnuityContract);
    then lifetime_income_form_permitted_403b7Aii(account);
}

pub relation retirement_income_account_facts_403b9(account: Person, maintained_by_church: Boolean, defined_contribution: Boolean) kind empirical {
    label en unofficial "the account is a defined contribution program established or maintained by a church, or a convention or association of churches (including a section 414(e)(3)(A) organization), to provide section 403(b) benefits, case-asserted";
}

pub relation retirement_income_account_403b9b(account: Person) kind institutional {
    label en official "section 403(b)(9)(B): a defined contribution program of a church or convention or association of churches providing section 403(b) benefits";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "the term \"retirement income account\" means a defined contribution program established or maintained by a church")
rule RetirementIncomeAccount403b9b(account: Person) strict {
    label en official "church-maintained defined contribution program";
    when retirement_income_account_facts_403b9(account, true, true);
    then retirement_income_account_403b9b(account);
}

pub relation retirement_income_account_treated_as_annuity_403b9a(account: Person) kind institutional {
    label en official "section 403(b)(9)(A): a retirement income account is treated as an annuity contract and employer payments to it as contributions for an annuity contract";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "a retirement income account shall be treated as an annuity contract described in this subsection")
rule RetirementIncomeAccountTreatedAsAnnuity403b9a(account: Person) strict {
    label en official "church retirement income account";
    when retirement_income_account_403b9b(account);
    then retirement_income_account_treated_as_annuity_403b9a(account);
}

pub relation salary_reduction_contribution_one_time_irrevocable_403b12A(contribution: Person) kind empirical {
    label en unofficial "under the agreement the contribution is made pursuant to a 1-time irrevocable election at initial eligibility (or a similar arrangement in regulations), case-asserted";
}

pub relation contribution_treated_as_not_salary_reduction_403b12A(contribution: Person) kind institutional {
    label en official "section 403(b)(12)(A): a contribution under a one-time irrevocable election is treated as not made pursuant to a salary reduction agreement (for clause (i))";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "a contribution shall be treated as not made pursuant to a salary reduction agreement if under the agreement it is made pursuant to a 1-time irrevocable election")
rule ContributionTreatedAsNotSalaryReduction403b12A(contribution: Person) strict {
    label en official "one-time election";
    when salary_reduction_contribution_one_time_irrevocable_403b12A(contribution);
    then contribution_treated_as_not_salary_reduction_403b12A(contribution);
}

pub relation salary_reduction_offer_amount_403b12Aii(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount every employee may elect to have contributed pursuant to a salary reduction agreement, when any employee may, case-asserted";
}

pub relation all_employees_may_elect_more_than_200_403b12Aii(plan: Plan) kind institutional {
    label en official "section 403(b)(12)(A)(ii): all employees may elect contributions of more than $200 if any employee may";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "all employees of the organization may elect to have the employer make contributions of more than $200 pursuant to a salary reduction agreement")
rule AllEmployeesMayElectMoreThan200403b12Aii(plan: Plan, amount: Money) strict {
    label en official "PARTIAL: exact boundary: more than $200 (200.00 is not enough); the exclusions are case facts";
    when salary_reduction_offer_amount_403b12Aii(plan, amount)
        and amount > 200.00 USD;
    then all_employees_may_elect_more_than_200_403b12Aii(plan);
}

pub relation organization_is_church_403b12B(org: Person, church_kind: Integer) kind empirical {
    label en unofficial "the organization's kind (1 = a church under section 3121(w)(3)(A), 2 = a qualified church-controlled organization under section 3121(w)(3)(B)), case-asserted";
}

pub relation church_for_403b1D_403b12B(org: Person) kind institutional {
    label en official "section 403(b)(12)(B): church has the meaning of section 3121(w)(3)(A) and includes a qualified church-controlled organization";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "Such term shall include any qualified church-controlled organization")
rule ChurchFor403b1D403b12B(org: Person, kind: Integer) strict {
    label en official "kinds 1 and 2";
    when organization_is_church_403b12B(org, kind)
        and kind >= 1 and kind <= 2;
    then church_for_403b1D_403b12B(org);
}

pub relation governmental_plan_of_state_or_local_403b12C(plan: Plan) kind empirical {
    label en unofficial "the plan is a governmental plan (section 414(d)) maintained by a State or local government or political subdivision (or agency or instrumentality), case-asserted";
}

pub relation clause_i_requirements_relaxed_for_governmental_plan_403b12C(plan: Plan) kind institutional {
    label en official "section 403(b)(12)(C): subparagraph (A)(i) (other than the section 401(a)(17) part) does not apply to such a governmental plan";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "the requirements of subparagraph (A)(i) (other than those relating to section 401(a)(17)) shall not apply to a governmental plan")
rule ClauseIRequirementsRelaxedForGovernmentalPlan403b12C(plan: Plan) strict {
    label en official "state and local government plans";
    when governmental_plan_of_state_or_local_403b12C(plan);
    then clause_i_requirements_relaxed_for_governmental_plan_403b12C(plan);
}

pub relation eligible_solely_by_202c1B_ltpt_403b12D(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is eligible to participate solely by reason of section 202(c)(1)(B) of ERISA, case-asserted";
}

pub relation employer_not_required_to_contribute_for_ltpt_403b12D(employee: Person, plan: Plan) kind institutional {
    label en official "section 403(b)(12)(D)(i)(I): notwithstanding section 401(a)(4), no nonelective or matching contributions are required for such employees";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "notwithstanding section 401(a)(4), an employer shall not be required to make nonelective or matching contributions on behalf of such employees")
rule EmployerNotRequiredToContributeForLtpt403b12D(employee: Person, plan: Plan) strict {
    label en official "LTPT participants";
    when eligible_solely_by_202c1B_ltpt_403b12D(employee, plan);
    then employer_not_required_to_contribute_for_ltpt_403b12D(employee, plan);
}

pub relation plan_maintained_by_more_than_one_employer_403b15(plan: Plan, church_plan: Boolean) kind empirical {
    label en unofficial "the plan is maintained by more than 1 employer, and whether it is a church plan, case-asserted";
}

pub relation subsection_applies_despite_multiple_employers_403b15A(plan: Plan) kind institutional {
    label en official "section 403(b)(15)(A): except for a church plan, the subsection is not treated as failing to apply solely because the contract is purchased under a plan maintained by more than 1 employer";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "Except in the case of a church plan, this subsection shall not be treated as failing to apply to an annuity contract solely by reason of such contract being purchased under a plan maintained by more than 1 employer.")
rule SubsectionAppliesDespiteMultipleEmployers403b15A(plan: Plan) strict {
    label en official "multiple employer plan that is not a church plan";
    when plan_maintained_by_more_than_one_employer_403b15(plan, false);
    then subsection_applies_despite_multiple_employers_403b15A(plan);
}

pub relation plan_satisfies_413e2_similar_rules_403b15Bi(plan: Plan) kind empirical {
    label en unofficial "the plan satisfies rules similar to the rules of section 413(e)(2) with respect to an employer failure, case-asserted";
}

pub relation employer_failure_does_not_defeat_subsection_403b15Bi(plan: Plan) kind institutional {
    label en official "section 403(b)(15)(B)(i): an employer's failure does not defeat the subsection for a plan satisfying rules similar to section 413(e)(2)";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "merely because of one or more employers failing to meet the requirements of this subsection if such plan satisfies rules similar to the rules of section 413(e)(2)")
rule EmployerFailureDoesNotDefeatSubsection403b15Bi(plan: Plan) strict {
    label en official "multiple employer plan with the 413(e)(2) rules";
    when plan_maintained_by_more_than_one_employer_403b15(plan, _)
        and plan_satisfies_413e2_similar_rules_403b15Bi(plan);
    then employer_failure_does_not_defeat_subsection_403b15Bi(plan);
}

pub relation plan_satisfies_413e1_similar_rules_403b15Bii(plan: Plan, solely_governmental: Boolean) kind empirical {
    label en unofficial "the plan satisfies rules similar to section 413(e)(1)(A) or (B), or is a multiple employer plan maintained solely by a State, political subdivision or agency or instrumentality, case-asserted (true for the governmental exception)";
}

pub relation multiple_employer_plan_requirement_met_403b15Bii(plan: Plan) kind institutional {
    label en official "section 403(b)(15)(B)(ii): the plan meets the requirement only with rules similar to section 413(e)(1)(A) or (B), except for governmental multiple employer plans";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "unless the plan satisfies rules similar to the rules of subparagraph (A) or (B) of section 413(e)(1), except in the case of a multiple employer plan maintained solely by any of the following")
rule MultipleEmployerPlanRequirementMet403b15Bii(plan: Plan, governmental: Boolean) strict {
    label en official "the similar rules, or the governmental exception (both are one boolean case fact)";
    when plan_satisfies_413e1_similar_rules_403b15Bii(plan, governmental);
    then multiple_employer_plan_requirement_met_403b15Bii(plan);
}

pub relation eligible_employee_election_403b16Cii(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible employee is treated as having elected a qualified percentage under the safe harbor plan, case-asserted";
}

pub relation eligible_employee_affirmative_election_403b16Cii(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible employee makes an affirmative election not to have contributions made or to make them at a specified level, case-asserted";
}

pub relation safe_harbor_deemed_election_in_effect_403b16Cii(employee: Person, plan: Plan) kind institutional {
    label en official "section 403(b)(16)(C)(ii): the deemed election stands unless the eligible employee makes an affirmative election";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "The election treated as having been made under clause (i) shall cease to apply with respect to any eligible employee if such eligible employee makes an affirmative election")
rule SafeHarborDeemedElectionInEffect403b16Cii(employee: Person, plan: Plan) strict {
    label en official "no affirmative election";
    when eligible_employee_election_403b16Cii(employee, plan)
        and not_known(eligible_employee_affirmative_election_403b16Cii(employee, plan));
    then safe_harbor_deemed_election_in_effect_403b16Cii(employee, plan);
}

pub relation catch_up_age_50_before_close_403b16Diii(individual: Person, y: TaxableYear, base_limit: Money, catch_up: Money) kind empirical {
    label en unofficial "an individual who attained age 50 before the close of the taxable year: the base limit and the applicable amount under section 219(b)(5)(B)(ii) (after (C)(iii)), case-asserted";
}

pub relation safe_harbor_limit_with_catch_up_403b16Diii(individual: Person, y: TaxableYear, limit: Money) kind institutional {
    label en official "section 403(b)(16)(D)(iii): the $6,000 limit is increased by the age-50 catch-up amount";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "the limitation under clause (i)(II) shall be increased by the applicable amount determined under section 219(b)(5)(B)(ii)")
rule SafeHarborLimitWithCatchUp403b16Diii(individual: Person, y: TaxableYear, base: Money, extra: Money) strict {
    label en official "base + catch-up";
    when catch_up_age_50_before_close_403b16Diii(individual, y, base, extra);
    then safe_harbor_limit_with_catch_up_403b16Diii(individual, y, base + extra);
}

pub relation eligible_employee_excluded_by_12A_403b16F(employee: Person) kind empirical {
    label en unofficial "the employee is one who is permitted to be excluded under paragraph (12)(A), case-asserted";
}

pub relation employee_of_employer_403b16F(employee: Person) kind empirical {
    label en unofficial "the person is an employee of the employer, case-asserted";
}

pub relation eligible_employee_403b16F(employee: Person) kind institutional {
    label en official "section 403(b)(16)(F): any employee other than one permitted to be excluded under paragraph (12)(A)";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "the term \"eligible employee\" means any employee of the employer other than an employee who is permitted to be excluded under paragraph (12)(A)")
rule EligibleEmployee403b16F(employee: Person) strict {
    label en official "an employee not excludable";
    when employee_of_employer_403b16F(employee)
        and not_known(eligible_employee_excluded_by_12A_403b16F(employee));
    then eligible_employee_403b16F(employee);
}

pub relation annuity_premium_not_subject_to_subsection_a_403c(employee: Person, y: TaxableYear, premium: Money, excluded_under_b: Money) kind empirical {
    label en unofficial "the premium the employer paid for an annuity contract not subject to subsection (a), and the part excluded under subsection (b), case-asserted";
}

pub relation premium_included_under_section_83_403c(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 403(c): the premium (except the part excluded under subsection (b)) is included in gross income in accordance with section 83, valuing the contract";
}

@source(IRC_S403_C, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to that portion of the premiums paid which is excluded from gross income under subsection (b).")
rule PremiumIncludedUnderSection83403c(employee: Person, y: TaxableYear, premium: Money, excluded: Money) strict {
    label en official "premium - excluded part, not below zero";
    when annuity_premium_not_subject_to_subsection_a_403c(employee, y, premium, excluded);
    then premium_included_under_section_83_403c(employee, y, max(0 USD, premium - excluded));
}

pub relation employee_includes_self_employed_403a3(person: Person) kind empirical {
    label en unofficial "the individual is an employee within the meaning of section 401(c)(1), case-asserted";
}

pub relation employee_definition_includes_self_employed_403a3(person: Person) kind institutional {
    label en official "section 403(a)(3): the term employee includes a section 401(c)(1) employee, and the employer is the person treated as such under section 401(c)(4)";
}

@source(IRC_S403_A, relation = formalizes, coverage = exact, quote = "the term \"employee\" includes an individual who is an employee within the meaning of section 401(c)(1)")
rule EmployeeDefinitionIncludesSelfEmployed403a3(person: Person) strict {
    label en official "self-employed individual";
    when employee_includes_self_employed_403a3(person);
    then employee_definition_includes_self_employed_403a3(person);
}
