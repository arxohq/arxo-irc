// Section 409A — nonqualified deferred compensation plans. Stage 1
// (IRC-09), DECISION-0379. Priority: (a) fully — (a)(1) inclusion + 20%
// additional tax + interest on plan failure; the six permissible
// distribution events (a)(2); the acceleration prohibition (a)(3); the
// deferral-election-timing rules (a)(4)(B); specified-employee six-month
// delay (a)(2)(B)(i). (b) funding rules and (c)-(e) are NOT modelled in
// this stage (TECH_GAP / stage 2).


use self::{
    IRC_S409A_A,
    LumpSumTrigger402,
    Person,
    TaxableYear,
};

pub entity NonqualifiedDeferredCompensationPlan : Plan {
    label en unofficial "a nonqualified deferred compensation plan (section 409A)";
}

// =====================================================================
// (a)(2) Distributions — the six permissible events
// =====================================================================
pub enum PermissibleDistributionEvent {
    SeparationFromService;
    Disability;
    Death;
    SpecifiedTimeOrFixedSchedule;
    ChangeInControl;
    UnforeseeableEmergency;
}

pub relation plan_permits_distribution_only_on(plan: NonqualifiedDeferredCompensationPlan, evt: PermissibleDistributionEvent) kind empirical {
    label en unofficial "the plan's terms limit distributions to this permissible event (case-asserted per event the plan actually uses)";
}

pub relation actual_distribution_trigger(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date, evt: PermissibleDistributionEvent) kind empirical {
    label en unofficial "the event that actually triggered a distribution under the plan, case-asserted";
}

pub relation distribution_meets_2A_requirements(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date) kind institutional {
    label en official "section 409A(a)(2)(A): the distribution requirement is met when the triggering event is one the plan actually permits under (A)(i)-(vi)";
}

@source(IRC_S409A_A, relation = formalizes, coverage = partial, quote = "The requirements of this paragraph are met if the plan provides that compensation deferred under the plan may not be distributed earlier than—")
rule DistributionMeets2ARequirements(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date, evt: PermissibleDistributionEvent) strict {
    label en official "distribution is proper when the triggering event is one the plan permits and it is a recognized permissible event";
    when actual_distribution_trigger(plan, participant, on, evt)
        and plan_permits_distribution_only_on(plan, evt);
    then distribution_meets_2A_requirements(plan, participant, on);
}

// -- Specified employee six-month delay (a)(2)(B)(i) ---------------------

pub relation key_employee_publicly_traded(participant: Person, plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "the participant is a key employee (section 416(i), without regard to paragraph (5)) of a corporation with stock publicly traded on an established securities market or otherwise — a \"specified employee\" (section 409A(a)(2)(B)(i)), case-asserted";
}

pub relation separation_from_service_on(participant: Person, plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the participant's separation from service date, case-asserted";
}

pub relation earliest_permitted_distribution_date(participant: Person, plan: NonqualifiedDeferredCompensationPlan, separation: Date, earliest: Date) kind institutional {
    label en official "section 409A(a)(2)(B)(i): for a specified employee, distribution on account of separation from service may not occur before 6 months after separation (or, if earlier, death)";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "the requirement of subparagraph (A)(i) is met only if distributions may not be made before the date which is 6 months after the date of separation from service (or, if earlier, the date of death of the employee)")
rule EarliestPermittedDistributionDateSpecifiedEmployee(participant: Person, plan: NonqualifiedDeferredCompensationPlan, separation: Date) strict {
    label en official "earliest date = separation date + 6 months (the earlier death exception is a separate, unconditioned event under (a)(2)(A)(iii), not a further reduction of this date)";
    when separation_from_service_on(participant, plan, separation)
        and key_employee_publicly_traded(participant, plan);
    then earliest_permitted_distribution_date(participant, plan, separation, add_calendar_period(separation, 6 calendar_month));
}

pub relation distribution_violates_specified_employee_delay(participant: Person, plan: NonqualifiedDeferredCompensationPlan, on: Date) kind institutional {
    label en official "a distribution to a specified employee on account of separation from service, made before the earliest permitted date, violates (a)(2)(B)(i)";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "distributions may not be made before the date which is 6 months after the date of separation from service")
rule DistributionViolatesSpecifiedEmployeeDelay(participant: Person, plan: NonqualifiedDeferredCompensationPlan, separation: Date, on: Date, earliest: Date) strict {
    label en official "violated when the actual distribution date precedes the 6-month earliest date";
    when actual_distribution_trigger(plan, participant, on, SeparationFromService)
        and earliest_permitted_distribution_date(participant, plan, separation, earliest)
        and on < earliest;
    then distribution_violates_specified_employee_delay(participant, plan, on);
}

// =====================================================================
// (a)(3) Acceleration of benefits — prohibition
// =====================================================================
pub relation scheduled_payment_date(plan: NonqualifiedDeferredCompensationPlan, participant: Person, scheduled: Date) kind empirical {
    label en unofficial "the payment date or schedule fixed under the plan for a given deferred amount, case-asserted";
}

pub relation actual_payment_date(plan: NonqualifiedDeferredCompensationPlan, participant: Person, actual: Date) kind empirical {
    label en unofficial "the date the plan actually paid the amount, case-asserted";
}

pub relation secretary_permitted_acceleration(plan: NonqualifiedDeferredCompensationPlan, participant: Person, actual: Date) kind empirical {
    label en unofficial "the acceleration is permitted by Treasury regulations under section 409A(a)(3), case-asserted";
}

pub relation plan_sponsor_of_nqdc(sponsor: Person, plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "the employer sponsoring the nonqualified deferred compensation plan, case-asserted";
}

pub relation pays_before_schedule(sponsor: Person, plan: NonqualifiedDeferredCompensationPlan, participant: Person, actual: Date, scheduled: Date) kind institutional {
    label en unofficial "the plan sponsor paid before the scheduled date without a regulatory exception";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "The requirements of this paragraph are met if the plan does not permit the acceleration of the time or schedule of any payment under the plan, except as provided in regulations by the Secretary")
rule AccelerationOfBenefitsProhibition(sponsor: Person, plan: NonqualifiedDeferredCompensationPlan, participant: Person, actual: Date, scheduled: Date) strict {
    label en official "section 409A(a)(3): the plan sponsor may not permit the acceleration of the time or schedule of any payment, except as provided in Treasury regulations";
    when plan_sponsor_of_nqdc(sponsor, plan)
        and actual_payment_date(plan, participant, actual)
        and scheduled_payment_date(plan, participant, scheduled);
    then prohibition AccelerationOfBenefits {
        bearer sponsor;
        action pays_before_schedule(sponsor, plan, participant, actual, scheduled);
        window [-infinity, infinity];
    };
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "The requirements of this paragraph are met if the plan does not permit the acceleration of the time or schedule of any payment under the plan, except as provided in regulations by the Secretary")
rule PaysBeforeSchedule(sponsor: Person, plan: NonqualifiedDeferredCompensationPlan, participant: Person, actual: Date, scheduled: Date) strict {
    label en official "an early payment not excused by regulation is an acceleration, attributed to the plan sponsor as bearer";
    when plan_sponsor_of_nqdc(sponsor, plan)
        and actual_payment_date(plan, participant, actual)
        and scheduled_payment_date(plan, participant, scheduled)
        and actual < scheduled
        and not secretary_permitted_acceleration(plan, participant, actual);
    then pays_before_schedule(sponsor, plan, participant, actual, scheduled);
}

// =====================================================================
// (a)(4)(B) Initial deferral election timing
// =====================================================================
pub relation election_to_defer_made_on(participant: Person, plan: NonqualifiedDeferredCompensationPlan, service_year: TaxableYear, election_date: Date) kind empirical {
    label en unofficial "the date the participant elects to defer compensation for services performed during this taxable year, case-asserted";
}

pub relation preceding_taxable_year_close(service_year: TaxableYear, close: Date) kind empirical {
    label en unofficial "the close of the taxable year preceding the service year, case-asserted (no year-to-date constructor; see the same TECH_GAP noted for section 401(a)(9)/408A(d))";
}

pub relation first_year_of_eligibility(participant: Person, plan: NonqualifiedDeferredCompensationPlan) kind empirical {
    label en unofficial "this is the first year in which the participant becomes eligible to participate in the plan, case-asserted";
}

pub relation eligibility_date(participant: Person, plan: NonqualifiedDeferredCompensationPlan, on: Date) kind empirical {
    label en unofficial "the date the participant becomes eligible to participate, case-asserted";
}

pub relation deferral_election_timely(participant: Person, plan: NonqualifiedDeferredCompensationPlan, service_year: TaxableYear, election_date: Date) kind institutional {
    label en official "section 409A(a)(4)(B)(i): the election was made not later than the close of the preceding taxable year";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "The requirements of this subparagraph are met if the plan provides that compensation for services performed during a taxable year may be deferred at the participant's election only if the election to defer such compensation is made not later than the close of the preceding taxable year or at such other time as provided in regulations")
rule DeferralElectionTimelyGeneral(participant: Person, plan: NonqualifiedDeferredCompensationPlan, service_year: TaxableYear, election_date: Date, close: Date) strict {
    label en official "timely when made on or before the close of the preceding taxable year";
    when election_to_defer_made_on(participant, plan, service_year, election_date)
        and preceding_taxable_year_close(service_year, close)
        and election_date <= close
        and not first_year_of_eligibility(participant, plan);
    then deferral_election_timely(participant, plan, service_year, election_date);
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "In the case of the first year in which a participant becomes eligible to participate in the plan, such election may be made with respect to services to be performed subsequent to the election within 30 days after the date the participant becomes eligible to participate in such plan.")
rule DeferralElectionTimelyFirstYear(participant: Person, plan: NonqualifiedDeferredCompensationPlan, service_year: TaxableYear, election_date: Date, eligible_on: Date) strict {
    label en official "first-year exception: timely within 30 days of becoming eligible, for services performed after the election";
    when election_to_defer_made_on(participant, plan, service_year, election_date)
        and first_year_of_eligibility(participant, plan)
        and eligibility_date(participant, plan, eligible_on)
        and election_date <= add_calendar_period(eligible_on, 30 calendar_day);
    then deferral_election_timely(participant, plan, service_year, election_date);
}

// =====================================================================
// (a)(1) Plan failure — inclusion, 20% additional tax, interest
// =====================================================================
pub relation plan_fails_requirements(plan: NonqualifiedDeferredCompensationPlan, y: TaxableYear) kind institutional {
    label en unofficial "the plan fails one of paragraphs (2), (3) or (4) of section 409A(a), or is not operated accordingly, for this taxable year";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "fails to meet the requirements of paragraphs (2), (3), and (4), or")
rule PlanFailsRequirementsSpecifiedEmployeeDelay(plan: NonqualifiedDeferredCompensationPlan, participant: Person, on: Date, y: TaxableYear) strict {
    label en official "a specified-employee-delay violation is a plan failure for the taxable year of the violation";
    when distribution_violates_specified_employee_delay(participant, plan, on)
        and us.irc.core::year_of(participant, y);
    then plan_fails_requirements(plan, y);
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "fails to meet the requirements of paragraphs (2), (3), and (4), or")
rule PlanFailsRequirementsAcceleration(plan: NonqualifiedDeferredCompensationPlan, sponsor: Person, participant: Person, on: Date, y: TaxableYear) strict {
    label en official "an unregulated acceleration is a plan failure for the taxable year of the violation";
    when pays_before_schedule(sponsor, plan, participant, on, _)
        and us.irc.core::year_of(participant, y);
    then plan_fails_requirements(plan, y);
}

pub relation deferred_compensation_not_subject_to_substantial_risk_of_forfeiture(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "compensation deferred under the plan for this participant and taxable year that is not subject to a substantial risk of forfeiture and not previously included in gross income, case-asserted";
}

pub relation nqdc_failure_inclusion(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(a)(1)(A): on a plan failure, all compensation deferred for the year and all preceding years is includible in gross income, to the extent not subject to a substantial risk of forfeiture and not previously included";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "all compensation deferred under the plan for the taxable year and all preceding taxable years shall be includible in gross income for the taxable year to the extent not subject to a substantial risk of forfeiture and not previously included in gross income")
rule NqdcFailureInclusion(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "inclusion amount = the deferred, unforfeited, not-previously-included compensation, for a participant affected by the failure";
    when plan_fails_requirements(plan, y)
        and deferred_compensation_not_subject_to_substantial_risk_of_forfeiture(plan, participant, y, amount);
    then nqdc_failure_inclusion(plan, participant, y, amount);
}

pub relation nqdc_additional_tax_20_percent(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(a)(1)(B)(i)(II): additional tax equal to 20 percent of the compensation required to be included";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "an amount equal to 20 percent of the compensation which is required to be included in gross income")
rule NqdcAdditionalTax20Percent(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, included: Money) strict {
    label en official "20% additional tax on the section (a)(1)(A) inclusion amount";
    when nqdc_failure_inclusion(plan, participant, y, included);
    then nqdc_additional_tax_20_percent(plan, participant, y, round(included * 0.20, 2, "HALF_UP"));
}

pub relation nqdc_underpayment_interest_rate(y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the section 6621 underpayment rate applicable for the relevant period, plus 1 percentage point already added, case-asserted (EXTERNAL_DEPENDENCY: section 6621 is owned by a different package and is itself a quarterly-published rate, not reformalized here)";
}

pub relation nqdc_deferred_since_year(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money, first_deferred_year: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which this amount was first deferred (or, if later, the first year it was not subject to a substantial risk of forfeiture), case-asserted";
}

pub relation nqdc_interest_amount(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(a)(1)(B)(i)(I)/(ii): interest at the underpayment rate plus 1 point on the underpayments that would have occurred had the deferred compensation been included when first deferred (EXTERNAL_DEPENDENCY rate; this package computes the arithmetic once the rate and the affected principal are supplied)";
}

@source(IRC_S409A_A, relation = formalizes, coverage = partial, quote = "the interest determined under this clause for any taxable year is the amount of interest at the underpayment rate plus 1 percentage point on the underpayments that would have occurred had the deferred compensation been includible in gross income for the taxable year in which first deferred")
rule NqdcInterestAmount(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, included: Money, rate: Decimal) strict {
    label en official "brief one-period computation: interest = included amount * rate (a full multi-year underpayment recomputation across every intervening return is TECH_GAP, stage 2 — day-by-day/year-by-year ledgers are the LDC-E4102 self-recursive-arithmetic compiler trap)";
    when nqdc_failure_inclusion(plan, participant, y, included)
        and nqdc_underpayment_interest_rate(y, rate);
    then nqdc_interest_amount(plan, participant, y, round(included * rate, 2, "HALF_UP"));
}
