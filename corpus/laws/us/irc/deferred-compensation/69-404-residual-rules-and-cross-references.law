// Section 404 residuals — STAGE 3b (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): (a)(1)(B) amendment election, (a)(2) annuities, (a)(3)(A)(iii)-(v)
// and (B) profit-sharing trusts, (a)(4) foreign trusts, (a)(5) other plans,
// (a)(7)(A) tail and (C) exceptions, (a)(8) self-employed, (a)(9)(D), (a)(10)
// ministers, (a)(11)-(12), (b), (c), (d), (e), (g), (h), (j), (k), (m), (o).
//
// Pattern (as in modules 06/37): amounts are exact; the regulatory cost methods
// of (a)(1)(A)(ii)-(iii) are the Secretary's and stay outside; the statutory
// conditions become case facts feeding derived treatment relations.

// =====================================================================
// (a)(1)(B) Special rule for certain amendments (multiemployer plans)
// =====================================================================

use self::{
    DefinedBenefitPlan,
    Distribution,
    IRC_S404_A,
    IRC_S404_B,
    IRC_S404_C,
    IRC_S404_D,
    IRC_S404_E,
    IRC_S404_G,
    IRC_S404_H,
    IRC_S404_J,
    IRC_S404_K,
    IRC_S404_M,
    IRC_S404_O,
    Person,
    Plan,
    TaxableYear,
    applicable_dividend_404k2,
    dc_contributions_for_year_404a7c,
    minimum_funding_standard_amount,
    section404h_deduction_limit,
    section404o2_amount,
    sep_contribution_paid,
};

pub relation collectively_bargained_multiemployer_plan_election_404a1B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is a multiemployer plan the Secretary of Labor finds to be collectively bargained and the plan makes the election under subparagraph (B), case-asserted";
}

pub relation full_funding_limitation_zero_404a1B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the full funding limitation determined under section 431(c)(6) for the year is zero, case-asserted";
}

pub relation amendment_raises_431c6Aii_above_i_404a1B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "as a result of a plan amendment applying to the year, the amount under section 431(c)(6)(A)(ii) exceeds the amount under (A)(i), case-asserted";
}

pub relation full_funding_limitation_increased_by_decrease_404a1Bi(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the full funding limitation under section 431(c)(6) with the amount in subparagraph (A) increased by the decrease in the present value of all unamortized liabilities resulting from the amendment, case-asserted";
}

pub relation normal_cost_under_plan_404a1Bii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the normal cost under the plan, case-asserted";
}

pub relation liability_decrease_from_amendment_404a1Bii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the decrease in the present value of all unamortized liabilities resulting from the amendment (the clause (i) decrease), case-asserted";
}

pub relation maximum_deductible_after_amendment_404a1B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(1)(B): the lesser of the increased full funding limitation and the normal cost less the decrease amortized in equal annual installments over 10 years (JUDGMENT CALL: straight-line tenths, the statute gives no interest)";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "the maximum amount deductible in such year under the limitations of this paragraph shall be an amount equal to the lesser of")
rule MaximumDeductibleAfterAmendment404a1B(plan: DefinedBenefitPlan, y: TaxableYear, ffl: Money, nc: Money, dec: Money) strict {
    label en official "PARTIAL: min(ffl, max(0, normal cost - decrease / 10)); the years after the election year are the Secretary's regulations";
    when collectively_bargained_multiemployer_plan_election_404a1B(plan, y)
        and full_funding_limitation_zero_404a1B(plan, y)
        and amendment_raises_431c6Aii_above_i_404a1B(plan, y)
        and full_funding_limitation_increased_by_decrease_404a1Bi(plan, y, ffl)
        and normal_cost_under_plan_404a1Bii(plan, y, nc)
        and liability_decrease_from_amendment_404a1Bii(plan, y, dec);
    then maximum_deductible_after_amendment_404a1B(plan, y, min(ffl, max(0 USD, nc - round(dec * 0.10, 2, "HALF_UP"))));
}

// =====================================================================
// (a)(2), (a)(3), (a)(4), (a)(5)
// =====================================================================

pub relation contributions_toward_retirement_annuities_404a2(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions paid toward the purchase of retirement annuities (or annuities and medical benefits under section 401(h)), case-asserted";
}

pub relation annuity_plan_meets_listed_401a_requirements_404a2(plan: Plan) kind empirical {
    label en unofficial "the plan meets the listed requirements of section 401(a) (and, if applicable, 401(a)(10) and 401(d)), case-asserted";
}

pub relation refunds_of_premiums_applied_within_two_years_404a2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "refunds of premiums, if any, are applied within the current or next taxable year toward the purchase of annuities, case-asserted";
}

pub relation annuity_contributions_deductible_when_paid_404a2(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(2): contributions toward annuities are deductible in the taxable year when paid, in the amount determined under paragraph (1), if the plan meets the listed requirements and premium refunds are applied in time";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "if the contributions are paid toward the purchase of retirement annuities, or retirement annuities and medical benefits as described in section 401(h)")
rule AnnuityContributionsDeductibleWhenPaid404a2(employer: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the amount limit is paragraph (1) (module 06/37)";
    when contributions_toward_retirement_annuities_404a2(employer, plan, y, amount)
        and annuity_plan_meets_listed_401a_requirements_404a2(plan)
        and refunds_of_premiums_applied_within_two_years_404a2(plan, y);
    then annuity_contributions_deductible_when_paid_404a2(employer, plan, y, amount);
}

pub relation trust_designed_for_actuarially_determined_retirement_benefits_404a3Aiii(plan: Plan) kind empirical {
    label en unofficial "the trust is designed to provide benefits upon retirement and cover a period of years, and the plan's employer contributions can be determined actuarially as provided in paragraph (1), case-asserted";
}

pub relation stock_bonus_or_profit_sharing_trust_for_404a3A(plan: Plan) kind institutional {
    label en official "section 404(a)(3)(A)(iii): a trust designed for retirement benefits with actuarially determinable contributions is not a stock bonus or profit-sharing trust for the subparagraph";
}

pub relation trust_is_stock_bonus_or_profit_sharing_404a3(plan: Plan) kind empirical {
    label en unofficial "the trust is a stock bonus or profit-sharing trust, case-asserted";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "the term \"stock bonus or profit-sharing trust\" shall not include any trust designed to provide benefits upon retirement and covering a period of years")
rule StockBonusOrProfitSharingTrustFor404a3A(plan: Plan) strict {
    label en official "excluded when designed for actuarially determined retirement benefits";
    when trust_is_stock_bonus_or_profit_sharing_404a3(plan)
        and not_known(trust_designed_for_actuarially_determined_retirement_benefits_404a3Aiii(plan));
    then stock_bonus_or_profit_sharing_trust_for_404a3A(plan);
}

pub relation contributions_to_trust_404a3Aiv(employer: Person, y: TaxableYear, trust: Plan, amount: Money) kind empirical {
    label en unofficial "contributions the employer made for the year to one of its stock bonus or profit-sharing trusts, case-asserted";
}

pub relation combined_contributions_to_trusts_404a3Aiv(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(3)(A)(iv): contributions to 2 or more stock bonus or profit-sharing trusts are considered contributions to a single trust for the limitations";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "such trusts shall be considered a single trust for purposes of applying the limitations in this subparagraph")
rule CombinedContributionsToTrusts404a3Aiv(employer: Person, y: TaxableYear) strict {
    label en official "the sum over the employer's trusts";
    when contributions_to_trust_404a3Aiv(employer, y, _, _);
    then combined_contributions_to_trusts_404a3Aiv(employer, y,
        sum all amt: Money for tr: Plan where contributions_to_trust_404a3Aiv(employer, y, tr, amt));
}

pub relation dc_plan_subject_to_412_funding_standard_404a3Av(plan: Plan) kind empirical {
    label en unofficial "the defined contribution plan is subject to the funding standards of section 412 and the Secretary provides no exception, case-asserted";
}

pub relation dc_plan_treated_as_profit_sharing_for_404a3A(plan: Plan) kind institutional {
    label en official "section 404(a)(3)(A)(v): a defined contribution plan subject to the section 412 funding standards is treated as a stock bonus or profit-sharing plan for the subparagraph";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "a defined contribution plan which is subject to the funding standards of section 412 shall be treated in the same manner as a stock bonus or profit-sharing plan for purposes of this subparagraph")
rule DcPlanTreatedAsProfitSharingFor404a3A(plan: Plan) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when dc_plan_subject_to_412_funding_standard_404a3Av(plan);
    then dc_plan_treated_as_profit_sharing_for_404a3A(plan);
}

pub relation prevented_contribution_of_member_404a3B(member: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contribution a member of the affiliated group (section 1504) is prevented from making because it has no or insufficient current or accumulated earnings or profits, case-asserted";
}

pub relation earnings_and_profits_after_own_contributions_404a3B(member: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a member's current and accumulated earnings or profits remaining after adjustment for its contribution deductible without regard to the subparagraph, case-asserted";
}

pub relation group_files_consolidated_return_404a3B(group: Person) kind empirical {
    label en unofficial "the affiliated group files a consolidated return, case-asserted";
}

pub relation total_prevented_contribution_of_group_404a3B(group: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total prevented contribution of the group, case-asserted";
}

pub relation total_earnings_and_profits_of_group_after_adjustment_404a3B(group: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total current and accumulated earnings or profits of all the members after adjustment for all contributions deductible without regard to the subparagraph, case-asserted";
}

pub relation maximum_contribution_by_other_member_404a3B(group: Person, member: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(3)(B): another member may contribute the prevented amount to the extent of its earnings or profits; without a consolidated return, its share is limited to the proportion of its earnings that the total prevented contribution bears to the group's total earnings";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "to the extent of current or accumulated earnings or profits")
rule MaximumContributionByOtherMemberConsolidated404a3B(group: Person, member: Person, y: TaxableYear, prevented: Money, ep: Money) strict {
    label en official "PARTIAL: consolidated group: min(prevented contribution, the member's earnings or profits)";
    when group_files_consolidated_return_404a3B(group)
        and total_prevented_contribution_of_group_404a3B(group, y, prevented)
        and earnings_and_profits_after_own_contributions_404a3B(member, y, ep);
    then maximum_contribution_by_other_member_404a3B(group, member, y, min(prevented, ep));
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "limited, where the group does not file a consolidated return, to that proportion of its total current and accumulated earnings or profits")
rule MaximumContributionByOtherMemberSeparate404a3B(group: Person, member: Person, y: TaxableYear, prevented: Money, ep_member: Money, ep_group: Money) strict {
    label en official "PARTIAL: min(prevented, ep_member x prevented / ep_group), HALF_UP to the cent; the deemed-made-by-the-employer carryforward rule is not computed";
    when not_known(group_files_consolidated_return_404a3B(group))
        and total_prevented_contribution_of_group_404a3B(group, y, prevented)
        and earnings_and_profits_after_own_contributions_404a3B(member, y, ep_member)
        and total_earnings_and_profits_of_group_after_adjustment_404a3B(group, y, ep_group)
        and ep_group > 0 USD;
    then maximum_contribution_by_other_member_404a3B(group, member, y,
        min(prevented, round(ep_member * (prevented / 1.00 USD) / (ep_group / 1.00 USD), 2, "HALF_UP")));
}

pub relation trust_would_qualify_but_for_foreign_organization_404a4(plan: Plan) kind empirical {
    label en unofficial "the stock bonus, pension or profit-sharing trust would qualify for exemption under section 501(a) except that it is created or organized outside the United States, case-asserted";
}

pub relation employer_is_us_resident_or_entity_404a4(employer: Person) kind empirical {
    label en unofficial "the employer is a resident, corporation or other entity of the United States, case-asserted";
}

pub relation foreign_trust_contributions_deductible_under_preceding_paragraphs_404a4(employer: Person, plan: Plan) kind institutional {
    label en official "section 404(a)(4): contributions to such a foreign trust are deductible under paragraphs (1) to (3)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "contributions to such a trust by an employer which is a resident, or corporation, or other entity of the United States, shall be deductible under the preceding paragraphs")
rule ForeignTrustContributionsDeductibleUnderPrecedingParagraphs404a4(employer: Person, plan: Plan) strict {
    label en official "both conditions";
    when trust_would_qualify_but_for_foreign_organization_404a4(plan)
        and employer_is_us_resident_or_entity_404a4(employer);
    then foreign_trust_contributions_deductible_under_preceding_paragraphs_404a4(employer, plan);
}

pub relation contribution_includible_in_employee_gross_income_year_404a5(plan: Plan, employee: Person, contribution_year: TaxableYear, includible_year: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which an amount attributable to the contribution is includible in the gross income of the participating employee, case-asserted";
}

pub relation plan_not_within_paragraphs_1_2_3_404a5(plan: Plan) kind empirical {
    label en unofficial "the plan is not one included in paragraph (1), (2) or (3), case-asserted";
}

pub relation separate_accounts_for_each_employee_404a5(plan: Plan) kind empirical {
    label en unofficial "separate accounts are maintained for each employee (needed only when more than one employee participates), case-asserted";
}

pub relation more_than_one_employee_participates_404a5(plan: Plan) kind empirical {
    label en unofficial "more than one employee participates in the plan, case-asserted";
}

pub relation deduction_year_for_other_plan_404a5(plan: Plan, employee: Person, contribution_year: TaxableYear, deduction_year: TaxableYear) kind institutional {
    label en official "section 404(a)(5): a contribution to another plan is deductible in the taxable year in which the amount is includible in the employee's gross income (a plan of more than one employee only with separate accounts)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "in the taxable year in which an amount attributable to the contribution is includible in the gross income of employees participating in the plan")
rule DeductionYearForOtherPlan404a5(plan: Plan, employee: Person, cy: TaxableYear, iy: TaxableYear) strict {
    label en official "single-employee plan or separate accounts";
    when plan_not_within_paragraphs_1_2_3_404a5(plan)
        and contribution_includible_in_employee_gross_income_year_404a5(plan, employee, cy, iy)
        and (not_known(more_than_one_employee_participates_404a5(plan)) or separate_accounts_for_each_employee_404a5(plan));
    then deduction_year_for_other_plan_404a5(plan, employee, cy, iy);
}

pub relation vacation_pay_treated_as_deferred_compensation_404a5(employee: Person, paid_year: TaxableYear) kind empirical {
    label en unofficial "vacation pay treated as deferred compensation, and the taxable year of the employer in which it is paid to the employee, case-asserted";
}

pub relation vacation_pay_deductible_when_paid_404a5(employee: Person, paid_year: TaxableYear) kind institutional {
    label en official "section 404(a)(5) last sentence: vacation pay treated as deferred compensation is deductible for the taxable year in which it is paid to the employee";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "any vacation pay which is treated as deferred compensation shall be deductible for the taxable year of the employer in which paid to the employee")
rule VacationPayDeductibleWhenPaid404a5(employee: Person, py: TaxableYear) strict {
    label en official "year paid";
    when vacation_pay_treated_as_deferred_compensation_404a5(employee, py);
    then vacation_pay_deductible_when_paid_404a5(employee, py);
}

// =====================================================================
// (a)(7)(C), (D), (a)(9)(D), (a)(10)-(12)
// =====================================================================

pub relation no_employee_is_beneficiary_of_more_than_one_plan_404a7Ci(plan: Plan) kind empirical {
    label en unofficial "no employee is a beneficiary under more than 1 trust or under a trust and an annuity plan, case-asserted";
}

pub relation combined_limit_does_not_reduce_404a7Ci(plan: Plan) kind institutional {
    label en official "section 404(a)(7)(C)(i): paragraph (7) does not reduce the amount otherwise deductible under paragraphs (1), (2) and (3)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not have the effect of reducing the amount otherwise deductible under paragraphs (1), (2), and (3), if no employee is a beneficiary under more than 1 trust or under a trust and an annuity plan.")
rule CombinedLimitDoesNotReduce404a7Ci(plan: Plan) strict {
    label en official "no overlapping beneficiary";
    when no_employee_is_beneficiary_of_more_than_one_plan_404a7Ci(plan);
    then combined_limit_does_not_reduce_404a7Ci(plan);
}

pub relation only_elective_deferrals_contributed_to_dc_plans_404a7Cii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "no amounts other than elective deferrals (section 402(g)(3)) are contributed to any of the defined contribution plans for the taxable year, case-asserted";
}

pub relation combined_limit_inapplicable_elective_deferrals_only_404a7Cii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404(a)(7)(C)(ii): if only elective deferrals are contributed to the defined contribution plans, subparagraph (A) does not apply to those plans and the defined benefit plans";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "then subparagraph (A) shall not apply with respect to any of such defined contribution plans and defined benefit plans")
rule CombinedLimitInapplicableElectiveDeferralsOnly404a7Cii(plan: Plan, y: TaxableYear) strict {
    label en official "elective deferrals only";
    when only_elective_deferrals_contributed_to_dc_plans_404a7Cii(plan, y);
    then combined_limit_inapplicable_elective_deferrals_only_404a7Cii(plan, y);
}

pub relation carryover_treated_as_dc_contribution_404a7Ciii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts carried over from preceding taxable years under subparagraph (B) attributable to employer contributions to defined contribution plans in those years, case-asserted";
}

pub relation dc_contributions_including_carryover_404a7Ciii(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(7)(C)(iii) last sentence: carryovers attributable to defined contribution contributions are treated as employer contributions to defined contribution plans";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "amounts carried over from preceding taxable years under subparagraph (B) shall be treated as employer contributions to 1 or more defined contributions plans")
rule DcContributionsIncludingCarryover404a7Ciii(plan: Plan, y: TaxableYear, dc: Money, carried: Money) strict {
    label en official "current DC contributions + attributable carryover";
    when dc_contributions_for_year_404a7c(plan, y, dc)
        and carryover_treated_as_dc_contribution_404a7Ciii(plan, y, carried);
    then dc_contributions_including_carryover_404a7Ciii(plan, y, dc + carried);
}

pub relation plan_is_pbgc_covered_single_employer_404a7Civ(plan: Plan) kind empirical {
    label en unofficial "the plan is a single-employer plan covered under section 4021 of ERISA, case-asserted";
}

pub relation plan_is_multiemployer_404a7Cv(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted";
}

pub relation plan_taken_into_account_for_combined_limit_404a7C(plan: Plan) kind institutional {
    label en official "section 404(a)(7)(C)(iv), (v): a section 4021-covered single-employer plan and a multiemployer plan are not taken into account in applying paragraph (7)";
}

pub relation plan_subject_to_combined_limit_candidate_404a7(plan: Plan) kind empirical {
    label en unofficial "the plan is one of the plans the combined limit of paragraph (7) is being applied to, case-asserted";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "any single-employer plan covered under section 4021 of the Employee Retirement Income Security Act of 1974 shall not be taken into account")
rule PlanTakenIntoAccountForCombinedLimit404a7C(plan: Plan) strict {
    label en official "neither a PBGC-covered single-employer plan nor a multiemployer plan";
    when plan_subject_to_combined_limit_candidate_404a7(plan)
        and not_known(plan_is_pbgc_covered_single_employer_404a7Civ(plan))
        and not_known(plan_is_multiemployer_404a7Cv(plan));
    then plan_taken_into_account_for_combined_limit_404a7C(plan);
}

pub relation plan_described_in_412e3_404a7D(plan: Plan) kind empirical {
    label en unofficial "the plan is described in section 412(e)(3) (an insurance contract plan), case-asserted";
}

pub relation plan_treated_as_defined_benefit_for_404a7_404a7D(plan: Plan) kind institutional {
    label en official "section 404(a)(7)(D): a section 412(e)(3) plan is treated as a defined benefit plan for paragraph (7)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "a plan described in section 412(e)(3) shall be treated as a defined benefit plan")
rule PlanTreatedAsDefinedBenefitFor404a7D(plan: Plan) strict {
    label en official "insurance contract plans";
    when plan_described_in_412e3_404a7D(plan);
    then plan_treated_as_defined_benefit_for_404a7_404a7D(plan);
}

pub relation employer_contributions_limited_to_deductible_amount_404a7A(plan: Plan) kind empirical {
    label en unofficial "the defined contribution pension plan limits employer contributions to amounts deductible under the section, case-asserted";
}

pub relation dc_pension_plan_provides_definitely_determinable_benefits_404a7A(plan: Plan) kind institutional {
    label en official "section 404(a)(7)(A): a defined contribution pension plan is not treated as failing to provide definitely determinable benefits merely by limiting employer contributions to deductible amounts";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to provide definitely determinable benefits merely by limiting employer contributions to amounts deductible under this section")
rule DcPensionPlanProvidesDefinitelyDeterminableBenefits404a7A(plan: Plan) strict {
    label en official "deductibility-limited contributions";
    when employer_contributions_limited_to_deductible_amount_404a7A(plan);
    then dc_pension_plan_provides_definitely_determinable_benefits_404a7A(plan);
}

pub relation funding_target_430d1_404a7A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the plan's funding target (section 430(d)(1)) for the single employer plan, case-asserted";
}

pub relation plan_assets_430g3_404a7A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the plan's assets determined under section 430(g)(3), case-asserted";
}

pub relation minimum_funding_floor_single_employer_404a7A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(7)(A) last sentence: for a single employer defined benefit plan the amount necessary to satisfy the minimum funding standard is not less than the excess of the funding target over the value of the assets";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "the amount necessary to satisfy the minimum funding standard provided by section 412 shall not be less than the excess (if any) of the plan's funding target (as defined in section 430(d)(1)) over the value of the plan's assets")
rule MinimumFundingFloorSingleEmployer404a7A(plan: DefinedBenefitPlan, y: TaxableYear, target: Money, assets: Money, mfs: Money) strict {
    label en official "max(stated minimum funding amount, max(0, target - assets))";
    when funding_target_430d1_404a7A(plan, y, target)
        and plan_assets_430g3_404a7A(plan, y, assets)
        and minimum_funding_standard_amount(plan, y, mfs);
    then minimum_funding_floor_single_employer_404a7A(plan, y, max(mfs, max(0 USD, target - assets)));
}

pub relation qualified_gratuitous_transfer_664g1_404a9D(plan: Plan) kind empirical {
    label en unofficial "a qualified gratuitous transfer (section 664(g)(1)) was made, case-asserted";
}

pub relation gratuitous_transfer_no_effect_on_deductible_amounts_404a9D(plan: Plan) kind institutional {
    label en official "section 404(a)(9)(D): a qualified gratuitous transfer has no effect on the amounts otherwise deductible under paragraphs (3), (7) and (9)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "shall have no effect on the amount or amounts otherwise deductible under paragraph (3) or (7) or under this paragraph")
rule GratuitousTransferNoEffectOnDeductibleAmounts404a9D(plan: Plan) strict {
    label en official "qualified gratuitous transfer";
    when qualified_gratuitous_transfer_664g1_404a9D(plan);
    then gratuitous_transfer_no_effect_on_deductible_amounts_404a9D(plan);
}

pub relation minister_contribution_to_403b9_account_404a10(minister: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions made by a minister described in section 414(e)(5) to a retirement income account (section 403(b)(9)) and not by another person, case-asserted";
}

pub relation minister_elective_deferral_limit_402g_404a10B(minister: Person, y: TaxableYear, limit: Money) kind empirical {
    label en unofficial "the section 402(g) limit on elective deferrals applicable to the minister, case-asserted";
}

pub relation minister_annual_additions_limit_415_404a10B(minister: Person, y: TaxableYear, limit: Money) kind empirical {
    label en unofficial "the section 415 limit on annual additions applicable to the minister, taking all the minister's plans as one plan, case-asserted";
}

pub relation minister_contribution_deductible_404a10(minister: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(10): the minister's contributions are treated as made to an exempt trust of a section 401(a) plan and are deductible to the extent they do not exceed the section 402(g) limit or the section 415 limit";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "shall be deductible under this subsection to the extent such contributions do not exceed the limit on elective deferrals under section 402(g) or the limit on annual additions under section 415")
rule MinisterContributionDeductible404a10(minister: Person, y: TaxableYear, amount: Money, l402g: Money, l415: Money) strict {
    label en official "PARTIAL: min(contribution, the larger of the two limits) (the statute names an alternative bound); the aggregation of the minister's plans is in the case-asserted limits";
    when minister_contribution_to_403b9_account_404a10(minister, y, amount)
        and minister_elective_deferral_limit_402g_404a10B(minister, y, l402g)
        and minister_annual_additions_limit_415_404a10B(minister, y, l415);
    then minister_contribution_deductible_404a10(minister, y, min(amount, max(l402g, l415)));
}

pub relation amount_actually_received_or_paid_404a11(employee: Person, amount: Money, received_year: TaxableYear) kind empirical {
    label en unofficial "the amount is actually received by the employee in the taxable year, case-asserted";
}

pub relation amount_treated_as_received_or_paid_404a11(employee: Person, amount: Money, year: TaxableYear) kind institutional {
    label en official "section 404(a)(11): for determining whether compensation is deferred and when it is paid, no amount is treated as received or paid until actually received by the employee";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "no amount shall be treated as received by the employee, or paid, until it is actually received by the employee")
rule AmountTreatedAsReceivedOrPaid404a11(employee: Person, amount: Money, ry: TaxableYear) strict {
    label en official "year actually received";
    when amount_actually_received_or_paid_404a11(employee, amount, ry);
    then amount_treated_as_received_or_paid_404a11(employee, amount, ry);
}

pub relation participants_compensation_415c3_404a12(employee: Person, y: TaxableYear, base: Money, cd_amounts: Money) kind empirical {
    label en unofficial "compensation as otherwise determined and the amounts treated as participant's compensation under section 415(c)(3)(C) or (D), case-asserted";
}

pub relation compensation_for_404_paragraphs_404a12(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(12): for paragraphs (3), (7), (8) and (9) and subsection (h)(1)(C), compensation includes the amounts treated as participant's compensation under section 415(c)(3)(C) or (D)";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "the term \"compensation\" shall include amounts treated as \"participant's compensation\" under subparagraph (C) or (D) of section 415(c)(3)")
rule CompensationFor404Paragraphs404a12(employee: Person, y: TaxableYear, base: Money, cd: Money) strict {
    label en official "base + the (C)/(D) amounts";
    when participants_compensation_415c3_404a12(employee, y, base, cd);
    then compensation_for_404_paragraphs_404a12(employee, y, base + cd);
}

// (a)(8) self-employed

pub relation earned_income_401c2_404a8(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the earned income of the self-employed individual (section 401(c)(2)) derived from the trade or business, determined without regard to the deductions allowed by the section, case-asserted";
}

pub relation contribution_for_self_employed_404a8C(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contributions on behalf of the self-employed individual, case-asserted";
}

pub relation insurance_allocable_amount_404a8C(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the part of the contributions allocable to the purchase of life, accident, health or other insurance (regulations), case-asserted";
}

pub relation self_employed_contribution_meets_162_or_212_404a8C(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(8)(C): the contributions satisfy sections 162 or 212 to the extent they do not exceed the earned income and are not allocable to insurance";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "shall be considered to satisfy the conditions of section 162 or 212 to the extent that such contributions do not exceed the earned income of such individual")
rule SelfEmployedContributionMeets162Or212404a8C(employee: Person, y: TaxableYear, contrib: Money, earned: Money, ins: Money) strict {
    label en official "max(0, min(contribution, earned income) - insurance allocable amount)";
    when contribution_for_self_employed_404a8C(employee, y, contrib)
        and earned_income_401c2_404a8(employee, y, earned)
        and insurance_allocable_amount_404a8C(employee, y, ins);
    then self_employed_contribution_meets_162_or_212_404a8C(employee, y, max(0 USD, min(contrib, earned) - ins));
}

pub relation self_employed_employee_for_404_404a8A(person: Person) kind institutional {
    label en official "section 404(a)(8)(A): the term employee includes a section 401(c)(1) employee, and the employer is the person treated as the employer under section 401(c)(4); (B) earned income has the meaning of section 401(c)(2); (D) compensation means earned income for such an individual";
}

pub relation self_employed_individual_404a8(person: Person) kind empirical {
    label en unofficial "the person is an employee within the meaning of section 401(c)(1) in a plan included in paragraph (1), (2) or (3), case-asserted";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "the term \"employee\" includes an individual who is an employee within the meaning of section 401(c)(1)")
rule SelfEmployedEmployeeFor404404a8A(person: Person) strict {
    label en official "self-employed individual";
    when self_employed_individual_404a8(person);
    then self_employed_employee_for_404_404a8A(person);
}

pub relation earned_income_as_compensation_404a8D(person: Person, y: TaxableYear, earned: Money) kind institutional {
    label en official "section 404(a)(8)(D): a reference to compensation is a reference to earned income for a section 401(c)(1) employee";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "any reference to compensation shall, in the case of an individual who is an employee within the meaning of section 401(c)(1), be considered to be a reference to the earned income of such individual")
rule EarnedIncomeAsCompensation404a8D(person: Person, y: TaxableYear, earned: Money) strict {
    label en official "earned income substitutes for compensation";
    when self_employed_individual_404a8(person)
        and earned_income_401c2_404a8(person, y, earned);
    then earned_income_as_compensation_404a8D(person, y, earned);
}

// =====================================================================
// (b), (c), (d), (e)
// =====================================================================

pub relation no_plan_but_arrangement_with_effect_of_plan_404b1(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "there is no plan but there is a method or arrangement of employer contributions or compensation with the effect of a stock bonus, pension, profit-sharing, annuity or other deferral plan, case-asserted";
}

pub relation subsection_a_applies_as_if_plan_404b1(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 404(b)(1): subsection (a) applies as if there were a plan";
}

@source(IRC_S404_B, relation = formalizes, coverage = exact, quote = "subsection (a) shall apply as if there were such a plan")
rule SubsectionAAppliesAsIfPlan404b1(employer: Person, y: TaxableYear) strict {
    label en official "arrangement with the effect of a plan";
    when no_plan_but_arrangement_with_effect_of_plan_404b1(employer, y);
    then subsection_a_applies_as_if_plan_404b1(employer, y);
}

pub relation plan_providing_deferred_benefits_other_than_compensation_404b2A(plan: Plan) kind empirical {
    label en unofficial "the plan provides deferred benefits (other than compensation) for employees, their spouses or dependents, case-asserted";
}

pub relation benefit_provided_through_welfare_benefit_fund_404b2B(plan: Plan) kind empirical {
    label en unofficial "the benefit is provided through a welfare benefit fund (section 419(e)), case-asserted";
}

pub relation treated_as_plan_deferring_compensation_404b2A(plan: Plan) kind institutional {
    label en official "section 404(b)(2)(A)-(B): a plan providing deferred benefits (other than compensation) is treated as a plan deferring the receipt of compensation, except for welfare benefit fund benefits";
}

@source(IRC_S404_B, relation = formalizes, coverage = exact, quote = "any plan providing for deferred benefits (other than compensation) for employees, their spouses, or their dependents shall be treated as a plan deferring the receipt of compensation")
rule TreatedAsPlanDeferringCompensation404b2A(plan: Plan) strict {
    label en official "except benefits through a welfare benefit fund";
    when plan_providing_deferred_benefits_other_than_compensation_404b2A(plan)
        and not_known(benefit_provided_through_welfare_benefit_fund_404b2B(plan));
    then treated_as_plan_deferring_compensation_404b2A(plan);
}

pub relation contributions_under_negotiated_plan_404c(employer: Person, plan: Plan) kind empirical {
    label en unofficial "contributions are paid by an employer under a trust plan for at least medical or hospital care or pensions, case-asserted";
}

pub relation plan_established_before_1954_by_government_seizure_agreement_404c2(plan: Plan) kind empirical {
    label en unofficial "the plan was established before January 1, 1954 as a result of an agreement between employee representatives and the United States Government during a period of Government operation under seizure powers, case-asserted";
}

pub relation trust_qualified_for_exemption_on_contribution_date_404c(plan: Plan) kind empirical {
    label en unofficial "the trust is qualified for exemption under section 501(a) on the date of the contribution, case-asserted";
}

pub relation deductibility_governed_solely_by_162_404c(employer: Person, plan: Plan) kind institutional {
    label en official "section 404(c): such contributions are neither deductible under this section nor made nondeductible by it; deductibility is governed solely by section 162 (not after the trust qualifies under 501(a))";
}

@source(IRC_S404_C, relation = formalizes, coverage = exact, quote = "such contributions shall not be deductible under this section nor be made nondeductible by this section, but the deductibility thereof shall be governed solely by section 162")
rule DeductibilityGovernedSolelyBy162404c(employer: Person, plan: Plan) strict {
    label en official "both conditions; not once the trust is exempt";
    when contributions_under_negotiated_plan_404c(employer, plan)
        and plan_established_before_1954_by_government_seizure_agreement_404c2(plan)
        and not_known(trust_qualified_for_exemption_on_contribution_date_404c(plan));
    then deductibility_governed_solely_by_162_404c(employer, plan);
}

pub relation plan_participant_before_july_1_1974_404c(person: Person, plan: Plan) kind empirical {
    label en unofficial "before July 1, 1974 the individual was a participant in a plan described in subsection (c), case-asserted";
}

pub relation individual_treated_as_non_401c1_employee_404cA(person: Person, plan: Plan) kind institutional {
    label en official "section 404(c)(A): such an individual (a section 401(c)(1) employee) is treated, for service covered by the plan, as an employee other than one within section 401(c)(1)";
}

@source(IRC_S404_C, relation = formalizes, coverage = exact, quote = "shall be treated (with respect to service covered by the plan) as being an employee other than an employee within the meaning of section 401(c)(1)")
rule IndividualTreatedAsNon401c1Employee404cA(person: Person, plan: Plan) strict {
    label en official "pre-July 1, 1974 participant";
    when plan_participant_before_july_1_1974_404c(person, plan);
    then individual_treated_as_non_401c1_employee_404cA(person, plan);
}

pub relation earnings_from_covered_service_not_earned_income_404cB(person: Person, plan: Plan) kind institutional {
    label en official "section 404(c)(B): earnings derived from service covered by the plan are not earned income within section 401(c)(2)";
}

@source(IRC_S404_C, relation = formalizes, coverage = exact, quote = "earnings derived from service covered by the plan shall be treated as not being earned income within the meaning of section 401(c)(2)")
rule EarningsFromCoveredServiceNotEarnedIncome404cB(person: Person, plan: Plan) strict {
    label en official "pre-July 1, 1974 participant";
    when plan_participant_before_july_1_1974_404c(person, plan);
    then earnings_from_covered_service_not_earned_income_404cB(person, plan);
}

pub relation service_before_july_1_1975_covered_by_plan_404cC(person: Person, plan: Plan, service_end: Date) kind empirical {
    label en unofficial "the individual's service covered by the plan and the date it ended, case-asserted";
}

pub relation treated_as_employee_of_participating_employer_404cC(person: Person, plan: Plan) kind institutional {
    label en official "section 404(c)(C): the individual is treated as an employee of a participating employer with respect to service before July 1, 1975 covered by the plan";
}

@source(IRC_S404_C, relation = formalizes, coverage = exact, quote = "such individual shall be treated as an employee of a participating employer under the plan with respect to service before July 1, 1975, covered by the plan")
rule TreatedAsEmployeeOfParticipatingEmployer404cC(person: Person, plan: Plan, ended: Date) strict {
    label en official "exact boundary: service ending on June 30, 1975 is before July 1, 1975; July 1 is not";
    when plan_participant_before_july_1_1974_404c(person, plan)
        and service_before_july_1_1975_covered_by_plan_404cC(person, plan, ended)
        and ended < @1975-07-01;
    then treated_as_employee_of_participating_employer_404cC(person, plan);
}

pub relation payment_would_be_deductible_but_for_no_employment_404d(payor: Person, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "a plan would be described in subsection (a) as modified by (b) but for the absence of an employer-employee relationship, and the contribution or compensation would otherwise be deductible, case-asserted";
}

pub relation amount_includible_in_participant_gross_income_year_404d(payor: Person, participant: Person, y: TaxableYear, includible_year: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which an amount attributable to the contribution or compensation is includible in the participant's gross income, case-asserted";
}

pub relation independent_contractor_payment_not_deductible_by_payor_404d1(payor: Person, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 404(d)(1): the contributions or compensation are not deductible by the payor under the chapter";
}

@source(IRC_S404_D, relation = formalizes, coverage = exact, quote = "shall not be deductible by the payor thereof under this chapter")
rule IndependentContractorPaymentNotDeductibleByPayor404d1(payor: Person, participant: Person, y: TaxableYear) strict {
    label en official "no employer-employee relationship";
    when payment_would_be_deductible_but_for_no_employment_404d(payor, participant, y);
    then independent_contractor_payment_not_deductible_by_payor_404d1(payor, participant, y);
}

pub relation independent_contractor_deduction_year_404d2(payor: Person, participant: Person, y: TaxableYear, deduction_year: TaxableYear) kind institutional {
    label en official "section 404(d)(2): the amount that would be deductible is deductible in the taxable year in which it is includible in the participants' gross income";
}

@source(IRC_S404_D, relation = formalizes, coverage = exact, quote = "be deductible under this subsection for the taxable year in which an amount attributable to the contribution or compensation is includible in the gross income of the persons participating in the plan")
rule IndependentContractorDeductionYear404d2(payor: Person, participant: Person, y: TaxableYear, iy: TaxableYear) strict {
    label en official "year of inclusion";
    when payment_would_be_deductible_but_for_no_employment_404d(payor, participant, y)
        and amount_includible_in_participant_gross_income_year_404d(payor, participant, y, iy);
    then independent_contractor_deduction_year_404d2(payor, participant, y, iy);
}

pub relation contributions_allocable_to_insurance_self_employed_404e(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions for a self-employed individual allocable (under regulations) to the purchase of life, accident, health or other insurance, case-asserted";
}

pub relation contributions_for_self_employed_before_insurance_404e(person: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total contributions for the self-employed individual under paragraphs (1), (2) or (3) of subsection (a), case-asserted";
}

pub relation contributions_taken_into_account_for_self_employed_404e(person: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(e): contributions allocable to insurance protection for a self-employed individual are not taken into account under paragraph (1), (2) or (3) of subsection (a)";
}

@source(IRC_S404_E, relation = formalizes, coverage = exact, quote = "shall not be taken into account under paragraph (1), (2), or (3) of subsection (a)")
rule ContributionsTakenIntoAccountForSelfEmployed404e(person: Person, y: TaxableYear, total: Money, insurance: Money) strict {
    label en official "total - insurance allocable amount, not below zero";
    when contributions_for_self_employed_before_insurance_404e(person, y, total)
        and contributions_allocable_to_insurance_self_employed_404e(person, y, insurance);
    then contributions_taken_into_account_for_self_employed_404e(person, y, max(0 USD, total - insurance));
}

// =====================================================================
// (g) ERISA liability payments
// =====================================================================

pub relation erisa_liability_payment_404g1(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount paid by an employer under ERISA section 4041(b), 4062, 4063 or 4064 or part 1 of subtitle E of title IV, case-asserted";
}

pub relation liability_payment_treated_as_plan_contribution_404g1(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(g)(1): the payment is treated as a contribution to which the section applies";
}

@source(IRC_S404_G, relation = formalizes, coverage = exact, quote = "shall be treated as a contribution to which this section applies by such employer to or under a stock bonus, pension, profit-sharing, or annuity plan")
rule LiabilityPaymentTreatedAsPlanContribution404g1(employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "ERISA liability payments";
    when erisa_liability_payment_404g1(employer, y, amount);
    then liability_payment_treated_as_plan_contribution_404g1(employer, y, amount);
}

pub relation payer_is_controlled_group_member_not_direct_employer_404g2(payer: Person) kind empirical {
    label en unofficial "the paying entity is liable as a member of a commonly controlled group (section 414(b) or (c)) and did not directly employ participants of the plan, case-asserted";
}

pub relation payment_satisfies_162_or_212_404g2(payer: Person) kind empirical {
    label en unofficial "the payment otherwise satisfies the conditions of section 162 or 212, case-asserted";
}

pub relation controlled_group_payment_deductibility_unaffected_404g2(payer: Person) kind institutional {
    label en official "section 404(g)(2): the fact that the payer did not directly employ participants does not affect deductibility of a payment satisfying section 162 or 212";
}

@source(IRC_S404_G, relation = formalizes, coverage = exact, quote = "the fact that the entity did not directly employ participants of the plan with respect to which the liability payment was made shall not affect the deductibility")
rule ControlledGroupPaymentDeductibilityUnaffected404g2(payer: Person) strict {
    label en official "both facts";
    when payer_is_controlled_group_member_not_direct_employer_404g2(payer)
        and payment_satisfies_162_or_212_404g2(payer);
    then controlled_group_payment_deductibility_unaffected_404g2(payer);
}

pub enum LiabilityPaymentKind404g3 {
    General;
    StandardTerminationExcess;
    Section4062c;
}

pub relation liability_payment_kind_404g3(employer: Person, y: TaxableYear, kind: LiabilityPaymentKind404g3) kind empirical {
    label en unofficial "the kind of the ERISA liability payment, case-asserted";
}

pub relation liability_payment_timing_rule_404g3(employer: Person, y: TaxableYear, timing: Integer) kind institutional {
    label en official "section 404(g)(3): a general payment is deductible when paid (1); a standard termination payment to the extent it leaves assets above the guaranteed benefits falls under subsection (a)(1)(A) (2); a section 4062(c) payment is deductible as the regulations prescribe (3)";
}

@source(IRC_S404_G, relation = formalizes, coverage = exact, quote = "any payment described in paragraph (1) shall (subject to the last sentence of subsection (a)(1)(A)) be deductible under this section when paid")
rule LiabilityPaymentTimingRuleGeneral404g3(employer: Person, y: TaxableYear) strict {
    label en official "general";
    when liability_payment_kind_404g3(employer, y, General);
    then liability_payment_timing_rule_404g3(employer, y, 1);
}

@source(IRC_S404_G, relation = formalizes, coverage = exact, quote = "to the extent such payments result in the assets of the plan being in excess of the total amount of benefits under such plan which are guaranteed by the Pension Benefit Guaranty Corporation")
rule LiabilityPaymentTimingRuleTermination404g3(employer: Person, y: TaxableYear) strict {
    label en official "standard termination excess";
    when liability_payment_kind_404g3(employer, y, StandardTerminationExcess);
    then liability_payment_timing_rule_404g3(employer, y, 2);
}

@source(IRC_S404_G, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to any payment described in paragraph (1) which is made under section 4062(c) of such Act")
rule LiabilityPaymentTimingRule4062c404g3(employer: Person, y: TaxableYear) strict {
    label en official "section 4062(c)";
    when liability_payment_kind_404g3(employer, y, Section4062c);
    then liability_payment_timing_rule_404g3(employer, y, 3);
}

// =====================================================================
// (h), (j), (m)
// =====================================================================

pub enum SepBasis404h1A {
    CalendarYear;
    TaxableYearOfEmployer;
}

pub relation sep_maintained_on_basis_404h1A(employer: Person, basis: SepBasis404h1A) kind empirical {
    label en unofficial "the simplified employee pension is maintained on a calendar year basis or on the basis of the employer's taxable year, case-asserted";
}

pub relation sep_contribution_made_for_year_404h1A(employer: Person, calendar_year: Integer, deduction_taxable_year: TaxableYear) kind empirical {
    label en unofficial "the calendar year the contributions were made for, and the employer taxable year with or within which that calendar year ends (or the employer taxable year itself), case-asserted";
}

pub relation sep_contribution_deductible_year_404h1A(employer: Person, calendar_year: Integer, deduction_year: TaxableYear) kind institutional {
    label en official "section 404(h)(1)(A): contributions made for a year are deductible for the taxable year with or within which the calendar year ends (calendar year basis) or for the employer's taxable year (taxable year basis)";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "for the taxable year with or within which the calendar year ends")
rule SepContributionDeductibleYearCalendar404h1A(employer: Person, cy: Integer, ty: TaxableYear) strict {
    label en official "calendar year basis";
    when sep_maintained_on_basis_404h1A(employer, CalendarYear)
        and sep_contribution_made_for_year_404h1A(employer, cy, ty);
    then sep_contribution_deductible_year_404h1A(employer, cy, ty);
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "in the case of a simplified employee pension which is maintained on the basis of the taxable year of the employer, for such taxable year")
rule SepContributionDeductibleYearTaxableYear404h1A(employer: Person, cy: Integer, ty: TaxableYear) strict {
    label en official "taxable year basis";
    when sep_maintained_on_basis_404h1A(employer, TaxableYearOfEmployer)
        and sep_contribution_made_for_year_404h1A(employer, cy, ty);
    then sep_contribution_deductible_year_404h1A(employer, cy, ty);
}

pub relation sep_contribution_made_on_404h1B(employer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the SEP contribution on account of the taxable year was made, case-asserted";
}

pub relation sep_return_due_date_404h1B(employer: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the time prescribed by law (with extensions) for filing the return for the taxable year, case-asserted";
}

pub relation sep_contribution_treated_as_made_for_year_404h1B(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 404(h)(1)(B): contributions on account of a taxable year made not later than the return due date (with extensions) are treated as made for the year";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "not later than the time prescribed by law for filing the return for such taxable year (including extensions thereof)")
rule SepContributionTreatedAsMadeForYear404h1B(employer: Person, y: TaxableYear, made: Date, due: Date) strict {
    label en official "exact boundary: on the due date is timely";
    when sep_contribution_made_on_404h1B(employer, y, made)
        and sep_return_due_date_404h1B(employer, y, due)
        and made <= due;
    then sep_contribution_treated_as_made_for_year_404h1B(employer, y);
}

pub relation sep_carryover_deductible_404h1C(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(h)(1)(C): the excess of the amount contributed over the amount deductible carries to succeeding years, subject to the 25 percent limit";
}

pub relation sep_excess_contributed_over_deductible_404h1C(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess of the amount contributed over the amount deductible for a prior taxable year not yet deducted, case-asserted";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "The excess of the amount contributed over the amount deductible for a taxable year shall be deductible in the succeeding taxable years in order of time, subject to the 25 percent limit of the preceding sentence")
rule SepCarryoverDeductible404h1C(employer: Person, y: TaxableYear, excess: Money, limit: Money, paid: Money) strict {
    label en official "min(carryover, limit - paid this year), not below zero";
    when sep_excess_contributed_over_deductible_404h1C(employer, y, excess)
        and section404h_deduction_limit(employer, y, limit)
        and sep_contribution_paid(employer, y, paid);
    then sep_carryover_deductible_404h1C(employer, y, min(excess, max(0 USD, limit - paid)));
}

pub relation sep_treated_as_separate_trust_for_404a7_404h3(employer: Person) kind institutional {
    label en official "section 404(h)(3): for subsection (a)(7) a simplified employee pension is treated as a separate stock bonus or profit-sharing trust";
}

pub relation sep_present_for_a7_404h3(employer: Person) kind empirical {
    label en unofficial "the employer maintains a simplified employee pension in the application of paragraph (7), case-asserted";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "a simplified employee pension shall be treated as if it were a separate stock bonus or profit-sharing trust")
rule SepTreatedAsSeparateTrustFor404a7404h3(employer: Person) strict {
    label en official "SEP in paragraph (7)";
    when sep_present_for_a7_404h3(employer);
    then sep_treated_as_separate_trust_for_404a7_404h3(employer);
}

pub relation employer_contributions_to_simple_account_404m1(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employer contributions to a simple retirement account, case-asserted";
}

pub relation simple_contribution_treated_as_plan_contribution_404m1(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(m)(1): employer contributions to a simple retirement account are treated as made to a plan subject to the section";
}

@source(IRC_S404_M, relation = formalizes, coverage = exact, quote = "shall be treated as if they are made to a plan subject to the requirements of this section")
rule SimpleContributionTreatedAsPlanContribution404m1(employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "SIMPLE account contributions";
    when employer_contributions_to_simple_account_404m1(employer, y, amount);
    then simple_contribution_treated_as_plan_contribution_404m1(employer, y, amount);
}

pub relation simple_contribution_made_for_calendar_year_404m2A(employer: Person, calendar_year: Integer, taxable_year: TaxableYear) kind empirical {
    label en unofficial "the calendar year the contributions were made for and the employer taxable year with or within which it ends, case-asserted";
}

pub relation simple_contribution_deductible_taxable_year_404m2A(employer: Person, calendar_year: Integer, taxable_year: TaxableYear) kind institutional {
    label en official "section 404(m)(2)(A): the contributions are deductible in the employer taxable year with or within which the calendar year ends";
}

@source(IRC_S404_M, relation = formalizes, coverage = exact, quote = "Contributions described in paragraph (1) shall be deductible in the taxable year of the employer with or within which the calendar year for which the contributions were made ends.")
rule SimpleContributionDeductibleTaxableYear404m2A(employer: Person, cy: Integer, ty: TaxableYear) strict {
    label en official "the taxable year containing the calendar year end";
    when simple_contribution_made_for_calendar_year_404m2A(employer, cy, ty);
    then simple_contribution_deductible_taxable_year_404m2A(employer, cy, ty);
}

pub relation benefits_in_excess_of_415_limit_404j1A(plan: DefinedBenefitPlan, y: TaxableYear, taken_into_account: Money, limit415: Money) kind empirical {
    label en unofficial "the benefits otherwise taken into account for the year and the section 415 limitation on benefits, case-asserted";
}

pub relation benefits_taken_into_account_404j1A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(j)(1)(A): for a defined benefit plan, benefits in excess of the section 415 limitation are not taken into account";
}

@source(IRC_S404_J, relation = formalizes, coverage = exact, quote = "there shall not be taken into account any benefits for any year in excess of any limitation on such benefits under section 415 for such year")
rule BenefitsTakenIntoAccount404j1A(plan: DefinedBenefitPlan, y: TaxableYear, taken: Money, limit: Money) strict {
    label en official "min(benefits, limit)";
    when benefits_in_excess_of_415_limit_404j1A(plan, y, taken, limit);
    then benefits_taken_into_account_404j1A(plan, y, min(taken, limit));
}

pub relation cola_adjustment_effective_year_404j2(plan: DefinedBenefitPlan, y: TaxableYear, adjustment_takes_effect_year: Integer, year_number: Integer) kind empirical {
    label en unofficial "the calendar year the section 415(d)(1) adjustment first takes effect and the year being computed, case-asserted";
}

pub relation cola_adjustment_taken_into_account_404j2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 404(j)(2): a section 415(d)(1) adjustment is not taken into account for years before the year it first takes effect";
}

@source(IRC_S404_J, relation = formalizes, coverage = exact, quote = "there shall not be taken into account any adjustments under section 415(d)(1) for any year before the year for which such adjustment first takes effect")
rule ColaAdjustmentTakenIntoAccount404j2(plan: DefinedBenefitPlan, y: TaxableYear, first_year: Integer, current: Integer) strict {
    label en official "exact boundary: the effective year itself is inside";
    when cola_adjustment_effective_year_404j2(plan, y, first_year, current)
        and current >= first_year;
    then cola_adjustment_taken_into_account_404j2(plan, y);
}

// =====================================================================
// (k) Dividends on employer securities
// =====================================================================

pub relation dividend_on_employer_securities_404k(corp: Person, dividend: Distribution, amount: Money) kind empirical {
    label en unofficial "a dividend paid in cash by a C corporation with respect to employer securities, its amount, case-asserted";
}

pub relation payer_is_c_corporation_404k1(corp: Person) kind empirical {
    label en unofficial "the paying corporation is a C corporation, case-asserted";
}

pub relation securities_held_on_record_date_by_esop_of_group_404k3(dividend: Distribution) kind empirical {
    label en unofficial "the securities are held on the record date by an employee stock ownership plan maintained by the paying corporation or another member of its controlled group (section 409(l)(4)), case-asserted";
}

pub relation applicable_employer_securities_404k3(dividend: Distribution) kind institutional {
    label en official "section 404(k)(3): employer securities held on the record date by an ESOP maintained by the paying corporation or a member of its controlled group";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "employer securities which are held on the record date for such dividend by an employee stock ownership plan")
rule ApplicableEmployerSecurities404k3(dividend: Distribution) strict {
    label en official "held by an ESOP of the group on the record date";
    when securities_held_on_record_date_by_esop_of_group_404k3(dividend);
    then applicable_employer_securities_404k3(dividend);
}

pub relation loan_dividend_allocated_shares_fmv_at_least_dividend_404k2B(dividend: Distribution) kind empirical {
    label en unofficial "the plan provides that employer securities with a fair market value of not less than the dividend are allocated to the participant for the year the dividend would have been allocated, case-asserted";
}

pub relation dividend_on_allocated_security_used_for_loan_404k2B(dividend: Distribution) kind empirical {
    label en unofficial "the dividend is described in (A)(iv) and paid with respect to an employer security allocated to a participant, case-asserted";
}

pub relation loan_dividend_meets_limitation_404k2B(dividend: Distribution) kind institutional {
    label en official "section 404(k)(2)(B): a loan-repayment dividend on an allocated security is an applicable dividend only if securities of at least equal fair market value are allocated to the participant";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "shall not be treated as an applicable dividend unless the plan provides that employer securities with a fair market value of not less than the amount of such dividend are allocated to such participant")
rule LoanDividendMeetsLimitation404k2B(dividend: Distribution) strict {
    label en official "allocation of equal value";
    when dividend_on_allocated_security_used_for_loan_404k2B(dividend)
        and loan_dividend_allocated_shares_fmv_at_least_dividend_404k2B(dividend);
    then loan_dividend_meets_limitation_404k2B(dividend);
}

pub relation dividend_paid_or_distributed_in_year_404k4A(dividend: Distribution, corp: Person, y: TaxableYear) kind empirical {
    label en unofficial "the corporate taxable year in which the dividend is paid or distributed to a participant or beneficiary, case-asserted";
}

pub relation dividend_reinvested_in_year_404k4B(dividend: Distribution, reinvested_year: TaxableYear, election_year: TaxableYear) kind empirical {
    label en unofficial "the taxable years in which the dividend is reinvested and in which the election is made, case-asserted (the later governs)";
}

pub relation dividend_deduction_year_404k4(dividend: Distribution, y: TaxableYear) kind institutional {
    label en official "section 404(k)(4)(A)-(B): the deduction is allowable in the taxable year in which the dividend is paid or distributed";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "The deduction under paragraph (1) shall be allowable in the taxable year of the corporation in which the dividend is paid or distributed to a participant or his beneficiary.")
rule DividendDeductionYear404k4A(dividend: Distribution, corp: Person, y: TaxableYear) strict {
    label en official "year paid or distributed";
    when dividend_paid_or_distributed_in_year_404k4A(dividend, corp, y);
    then dividend_deduction_year_404k4(dividend, y);
}

pub relation dividend_used_to_repay_loan_in_year_404k4C(dividend: Distribution, y: TaxableYear) kind empirical {
    label en unofficial "the corporate taxable year in which an (A)(iv) dividend is used to repay the loan, case-asserted";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "the deduction under paragraph (1) shall be allowable in the taxable year of the corporation in which such dividend is used to repay the loan described in such clause")
rule DividendDeductionYearLoanRepayment404k4C(dividend: Distribution, y: TaxableYear) strict {
    label en official "year the loan is repaid";
    when dividend_used_to_repay_loan_in_year_404k4C(dividend, y);
    then dividend_deduction_year_404k4(dividend, y);
}

pub relation reinvestment_year_later_of_404k4B(dividend: Distribution, y: TaxableYear) kind institutional {
    label en official "section 404(k)(4)(B): a reinvested dividend is treated as paid in the taxable year of reinvestment or election, whichever is later";
}

pub relation election_year_not_after_reinvestment_year_404k4B(dividend: Distribution, reinvested_year: TaxableYear) kind empirical {
    label en unofficial "the election year is not later than the reinvestment year, case-asserted (the reinvestment year is then the later one)";
}

@source(IRC_S404_K, relation = formalizes, coverage = partial, quote = "shall be treated as paid in the taxable year of the corporation in which such dividend is reinvested in qualifying employer securities or in which the election under clause (iii) of paragraph (2)(A) is made, whichever is later")
rule ReinvestmentYearLaterOf404k4B(dividend: Distribution, ry: TaxableYear, ey: TaxableYear) strict {
    label en official "PARTIAL: taxable years are compared through the case-asserted ordering fact";
    when dividend_reinvested_in_year_404k4B(dividend, ry, ey)
        and election_year_not_after_reinvestment_year_404k4B(dividend, ry);
    then reinvestment_year_later_of_404k4B(dividend, ry);
}

pub relation dividend_plan_payment_described_in_404k2A(plan: Plan) kind empirical {
    label en unofficial "a payment or distribution described in paragraph (2)(A) is made by the plan, case-asserted";
}

pub relation plan_not_violating_401_409_4975_404k5B(plan: Plan) kind institutional {
    label en official "section 404(k)(5)(B): a plan is not treated as violating sections 401, 409 or 4975(e)(7), or as engaging in a prohibited transaction for section 4975(d)(3), merely by such a payment or distribution";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "A plan shall not be treated as violating the requirements of section 401, 409, or 4975(e)(7)")
rule PlanNotViolating401409497504k5B(plan: Plan) strict {
    label en official "dividend payments";
    when dividend_plan_payment_described_in_404k2A(plan);
    then plan_not_violating_401_409_4975_404k5B(plan);
}

pub relation reinvested_dividend_vested_100_percent_404k7(dividend: Distribution) kind institutional {
    label en official "section 404(k)(7): a reinvested applicable dividend is subject to the full vesting requirement of section 411(a)(1)";
}

pub relation reinvested_dividend_404k7(dividend: Distribution) kind empirical {
    label en unofficial "the dividend is an applicable dividend reinvested under (2)(A)(iii)(II), case-asserted";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "an applicable dividend described in clause (iii)(II) of paragraph (2)(A) shall be subject to the requirements of section 411(a)(1)")
rule ReinvestedDividendVested100Percent404k7(dividend: Distribution) strict {
    label en official "reinvested dividends";
    when reinvested_dividend_404k7(dividend);
    then reinvested_dividend_vested_100_percent_404k7(dividend);
}

// =====================================================================
// (o) Deduction limit for single-employer plans
// =====================================================================

pub relation section_430i_not_applicable_404o2B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "section 430(i) does not apply to the plan for the plan year, case-asserted";
}

pub relation funding_target_as_if_430i_404o2B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the funding target determined as if section 430(i) applied to the plan, case-asserted";
}

pub relation target_normal_cost_as_if_430i_404o2B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the target normal cost determined as if section 430(i) applied, case-asserted";
}

pub relation sum_i_floor_404o2B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(2)(B): if section 430(i) does not apply, the (A)(i) sum is no less than the funding target plus target normal cost determined as if it applied";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "the amount determined under subparagraph (A)(i) for the plan year shall in no event be less than the sum of")
rule SumIFloor404o2B(plan: DefinedBenefitPlan, y: TaxableYear, ft: Money, nc: Money) strict {
    label en official "funding target plus target normal cost as if 430(i) applied";
    when section_430i_not_applicable_404o2B(plan, y)
        and funding_target_as_if_430i_404o2B(plan, y, ft)
        and target_normal_cost_as_if_430i_404o2B(plan, y, nc);
    then sum_i_floor_404o2B(plan, y, ft + nc);
}

pub relation plan_year_participants_404o4B(plan: DefinedBenefitPlan, y: TaxableYear, own: Integer, group_plans: Integer) kind empirical {
    label en unofficial "participants of the employer (or controlled group member) in this plan and in the other defined benefit plans of the employer and its group, case-asserted";
}

pub relation participants_for_small_plan_test_404o4B(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind institutional {
    label en official "section 404(o)(4)(B): all defined benefit plans of the employer and its controlled group are one plan for the participant count";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "all defined benefit plans maintained by the same employer (or any member of such employer's controlled group")
rule ParticipantsForSmallPlanTest404o4B(plan: DefinedBenefitPlan, y: TaxableYear, own: Integer, others: Integer) strict {
    label en official "own plan plus the other plans' participants";
    when plan_year_participants_404o4B(plan, y, own, others);
    then participants_for_small_plan_test_404o4B(plan, y, own + others);
}

pub relation benefit_liabilities_sufficiency_amount_404o5(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount required to make the terminating plan sufficient for benefit liabilities (ERISA section 4041(d)), case-asserted";
}

pub relation plan_terminates_during_plan_year_404o5(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan terminates during the plan year, subject to ERISA section 4041, case-asserted";
}

pub relation terminating_plan_amount_floor_404o5(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(5): for a terminating plan the paragraph (2) amount is no less than the amount required to make the plan sufficient for benefit liabilities";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "shall in no event be less than the amount required to make the plan sufficient for benefit liabilities")
rule TerminatingPlanAmountFloor404o5(plan: DefinedBenefitPlan, y: TaxableYear, o2: Money, suff: Money) strict {
    label en official "max(paragraph (2) amount, sufficiency amount)";
    when plan_terminates_during_plan_year_404o5(plan, y)
        and section404o2_amount(plan, y, o2)
        and benefit_liabilities_sufficiency_amount_404o5(plan, y, suff);
    then terminating_plan_amount_floor_404o5(plan, y, max(o2, suff));
}

pub relation csec_plan_404o8(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a CSEC plan (section 414(y)), case-asserted";
}

pub relation csec_minimum_required_contribution_412a2D_404o8(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the minimum required contribution of a CSEC plan, the amount described in section 412(a)(2)(D), case-asserted";
}

pub relation csec_minimum_required_contribution_for_404o_404o8(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(8): for a CSEC plan the minimum required contribution is the amount described in section 412(a)(2)(D)";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "a CSEC plan shall be treated as though section 430 applied to such plan and the minimum required contribution for any plan year shall be the amount described in section 412(a)(2)(D)")
rule CsecMinimumRequiredContributionFor404o404o8(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "CSEC plan";
    when csec_plan_404o8(plan)
        and csec_minimum_required_contribution_412a2D_404o8(plan, y, amount);
    then csec_minimum_required_contribution_for_404o_404o8(plan, y, amount);
}

pub relation dividend_paid_in_cash_by_corporation_404k1(dividend: Distribution, corp: Person, amount: Money) kind empirical {
    label en unofficial "the applicable dividend was paid in cash by the corporation with respect to applicable employer securities, its amount, case-asserted";
}

pub relation dividend_deduction_allowed_404k1(dividend: Distribution, corp: Person, amount: Money) kind institutional {
    label en official "section 404(k)(1): a C corporation is allowed a deduction for an applicable dividend paid in cash on applicable employer securities, in addition to the deductions under subsection (a)";
}

@source(IRC_S404_K, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction for a taxable year the amount of any applicable dividend paid in cash by such corporation with respect to applicable employer securities")
rule DividendDeductionAllowed404k1(dividend: Distribution, corp: Person, amount: Money) strict {
    label en official "C corporation, applicable dividend (module 37), applicable employer securities, paid in cash";
    when payer_is_c_corporation_404k1(corp)
        and dividend_paid_in_cash_by_corporation_404k1(dividend, corp, amount)
        and applicable_dividend_404k2(dividend)
        and applicable_employer_securities_404k3(dividend);
    then dividend_deduction_allowed_404k1(dividend, corp, amount);
}
