// Section 416 — special rules for top-heavy plans. Stage 1 (IRC-09),
// DECISION-0379. Priority: (g) top-heavy plan definition (the 60 percent
// test) fully. Also modelled: (c) minimum contribution (3 percent) for
// defined contribution plans.


// =====================================================================
// (g)(1) Top-heavy plan — the 60 percent test
// =====================================================================
// Method: as in `10-410-participation.law`, the aggregate present values /
// account totals for "key employees" versus "all employees" are read as
// case-asserted counts rather than summed over the section 416(i)(1) key-
// employee classification, avoiding the aggregate-over-derived-predicate
// limitation; the 60% COMPARISON is executable arithmetic.

use self::{
    Corporation,
    DefinedBenefitPlan,
    DefinedContributionPlan,
    IRC_S416_C,
    IRC_S416_G,
    IRC_S416_I,
    Individual,
    Person,
    Plan,
    TaxableYear,
    participates_in,
};

pub relation key_employee_accrued_benefit_present_value(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of cumulative accrued benefits under the plan for key employees, as of the determination date, case-asserted";
}

pub relation all_employees_accrued_benefit_present_value(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of cumulative accrued benefits under the plan for all employees, as of the determination date, case-asserted";
}

pub relation top_heavy_plan_db(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 416(g)(1)(A)(i): a defined benefit plan is top-heavy when the key-employee present value exceeds 60 percent of the present value for all employees";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "any defined benefit plan if, as of the determination date, the present value of the cumulative accrued benefits under the plan for key employees exceeds 60 percent of the present value of the cumulative accrued benefits under the plan for all employees")
rule TopHeavyPlanDb(plan: DefinedBenefitPlan, y: TaxableYear, key_pv: Money, all_pv: Money) strict {
    label en official "top-heavy when key-employee PV strictly exceeds 60% of all-employee PV (boundary: exactly 60% is NOT top-heavy)";
    when key_employee_accrued_benefit_present_value(plan, y, key_pv)
        and all_employees_accrued_benefit_present_value(plan, y, all_pv)
        and all_pv > 0 USD
        and key_pv > round(all_pv * 0.60, 2, "HALF_UP");
    then top_heavy_plan_db(plan, y);
}

pub relation key_employee_account_total(plan: DefinedContributionPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate of the accounts of key employees under the plan, case-asserted";
}

pub relation all_employees_account_total(plan: DefinedContributionPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate of the accounts of all employees under the plan, case-asserted";
}

pub relation top_heavy_plan_dc(plan: DefinedContributionPlan, y: TaxableYear) kind institutional {
    label en official "section 416(g)(1)(A)(ii): a defined contribution plan is top-heavy when the aggregate key-employee accounts exceed 60 percent of the aggregate accounts of all employees";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "any defined contribution plan if, as of the determination date, the aggregate of the accounts of key employees under the plan exceeds 60 percent of the aggregate of the accounts of all employees under such plan")
rule TopHeavyPlanDc(plan: DefinedContributionPlan, y: TaxableYear, key_total: Money, all_total: Money) strict {
    label en official "top-heavy when key-employee account aggregate strictly exceeds 60% of the all-employee aggregate (boundary: exactly 60% is NOT top-heavy)";
    when key_employee_account_total(plan, y, key_total)
        and all_employees_account_total(plan, y, all_total)
        and all_total > 0 USD
        and key_total > round(all_total * 0.60, 2, "HALF_UP");
    then top_heavy_plan_dc(plan, y);
}
// Aggregation groups (required/permissive, (g)(2)) and the SIMPLE/safe-
// harbor-CODA carve-outs of (g)(4)(G)/(H) are NOT modelled in this stage
// (TECH_GAP / stage 2): `top_heavy_plan_db`/`top_heavy_plan_dc` test only a
// single plan, not an aggregation group.

// =====================================================================
// (c)(2) Minimum contribution — defined contribution plans
// =====================================================================

pub relation employer_contribution_for_nonkey_employee(plan: DefinedContributionPlan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer contribution (including matching contributions) for the year for a non-key employee, case-asserted";
}

pub relation nonkey_employee_compensation_415(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the non-key employee's compensation within the meaning of section 415, case-asserted";
}

pub relation minimum_contribution_required(plan: DefinedContributionPlan, employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 416(c)(2)(A): the minimum required employer contribution for a non-key employee is 3 percent of compensation";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "A defined contribution plan meets the requirements of the subsection if the employer contribution for the year for each participant who is a non-key employee is not less than 3 percent of such participant's compensation (within the meaning of section 415).")
rule MinimumContributionRequired(plan: DefinedContributionPlan, employee: Person, y: TaxableYear, comp: Money) strict {
    label en official "minimum = 3% of section 415 compensation (the (B) lesser-of-highest-key-employee-rate cap is NOT modelled — TECH_GAP)";
    when participates_in(employee, plan) and nonkey_employee_compensation_415(employee, y, comp);
    then minimum_contribution_required(plan, employee, y, round(comp * 0.03, 2, "HALF_UP"));
}

pub relation minimum_contribution_satisfied(plan: DefinedContributionPlan, employee: Person, y: TaxableYear) kind institutional {
    label en official "the minimum contribution requirement of section 416(c)(2) is satisfied for this non-key employee";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "the employer contribution for the year for each participant who is a non-key employee is not less than 3 percent of such participant's compensation")
rule MinimumContributionSatisfied(plan: DefinedContributionPlan, employee: Person, y: TaxableYear, actual: Money, required: Money) strict {
    label en official "satisfied when the actual contribution is at least the required minimum";
    when employer_contribution_for_nonkey_employee(plan, employee, y, actual)
        and minimum_contribution_required(plan, employee, y, required)
        and actual >= required;
    then minimum_contribution_satisfied(plan, employee, y);
}

// =====================================================================
// (i)(1) Key employee — DECISION-0379 stage 2c priority item
// =====================================================================
// Method: the 5-percent-owner and 1-percent-owner tests use section 318(a)
// attribution "within the meaning of section 318" (i)(1)(B)(i)(I)/(i)(1)(B)
// (ii)) — reusing `us.irc.corporations::total_constructive_ownership_share`
// (the section 318(a)/302(c)(1) sum this package's own new module 17 does
// NOT reuse for its 424(d) tests, since 424(d) is a narrower/different
// attribution rule; 416(i)(1)(C) expressly disables the 414(b)/(c)/(m)
// aggregation for this purpose, which `total_constructive_ownership_share`
// already does not apply, so no extra guard is needed). "Officer" status
// and the (i)(1)(A) 50-employee/greater-of-3-or-10%-of-employees officer
// CAP are read as case-asserted facts (TECH_GAP G375: the cap itself, a
// population-wide count, is not independently derived — see TECH-GAPS.md).
// Compensation has the section 414(q)(4) meaning by (i)(1)(D); this module
// reads it as a case fact via `key_employee_compensation` rather than
// re-deriving it from `12-414-definitions.law`'s own 414(q)(4) relation,
// disclosed as a wiring gap, not a modelling gap (both packages already
// compute "414(q)(4) compensation" for their own purposes).

pub relation employed_by_in_plan_year(individual: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual is an employee of the employer at some time during this plan year, case-asserted (binds the plan year for the ownership tests below, which section 318(a) attribution itself does not otherwise date-scope)";
}

pub relation officer_of_employer(individual: Individual, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual is an officer of the employer during the plan year, case-asserted (the (i)(1)(A) closing-sentence 50-employee/greater-of-3-or-10%-of-employees officer cap is assumed already applied by the case — TECH_GAP G375, not independently derived)";
}

pub relation key_employee_compensation(individual: Individual, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the individual's annual compensation from the employer, within the meaning of section 414(q)(4) (section 416(i)(1)(D)), case-asserted";
}

pub relation key_employee_officer(individual: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1)(A)(i): an officer of the employer with annual compensation greater than the indexed threshold (statutory base $130,000)";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "an officer of the employer having an annual compensation greater than $130,000")
rule KeyEmployeeOfficer(individual: Individual, employer: Person, y: TaxableYear, comp: Money) strict {
    label en official "officer with compensation strictly greater than the section 416(i)(1)(A)(i) threshold";
    when officer_of_employer(individual, employer, y)
        and key_employee_compensation(individual, employer, y, comp)
        and comp > SECTION416I_OFFICER_COMPENSATION_THRESHOLD;
    then key_employee_officer(individual, employer, y);
}

pub relation five_percent_owner_of_employer(individual: Individual, employer: Corporation, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1)(B)(i)(I): a person who owns (actually or under section 318(a) attribution) more than 5 percent of the employer's outstanding stock or voting power, where the employer is a corporation";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "if the employer is a corporation, any person who owns (or is considered as owning within the meaning of section 318) more than 5 percent of the outstanding stock of the corporation or stock possessing more than 5 percent of the total combined voting power of all stock of the corporation")
rule FivePercentOwnerOfEmployer(individual: Individual, employer: Corporation, y: TaxableYear, pct: Decimal) defeasible {
    label en official "more than 5 percent under the section 318(a) constructive-ownership total";
    when employed_by_in_plan_year(individual, employer, y);
    when us.irc.corporations::total_constructive_ownership_share(individual, employer, pct);
    when pct > 0.05;
    then five_percent_owner_of_employer(individual, employer, y);
}

pub relation one_percent_owner_of_employer(individual: Individual, employer: Corporation, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1)(B)(ii): a person who owns (actually or under section 318(a) attribution, substituting '1 percent' for '5 percent') more than 1 percent of the employer's stock";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "the term \"1-percent owner\" means any person who would be described in clause (i) if \"1 percent\" were substituted for \"5 percent\" each place it appears in clause (i)")
rule OnePercentOwnerOfEmployer(individual: Individual, employer: Corporation, y: TaxableYear, pct: Decimal) defeasible {
    label en official "more than 1 percent under the section 318(a) constructive-ownership total";
    when employed_by_in_plan_year(individual, employer, y);
    when us.irc.corporations::total_constructive_ownership_share(individual, employer, pct);
    when pct > 0.01;
    then one_percent_owner_of_employer(individual, employer, y);
}

pub relation key_employee_five_percent_owner(individual: Individual, employer: Corporation, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1)(A)(ii): a 5-percent owner of the employer is a key employee (no compensation threshold)";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "a 5-percent owner of the employer")
rule KeyEmployeeFivePercentOwner(individual: Individual, employer: Corporation, y: TaxableYear) defeasible {
    label en official "restates the 5-percent-owner test as the (A)(ii) key-employee ground";
    when five_percent_owner_of_employer(individual, employer, y);
    then key_employee_five_percent_owner(individual, employer, y);
}

pub relation key_employee_one_percent_owner(individual: Individual, employer: Corporation, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1)(A)(iii): a 1-percent owner of the employer with compensation over $150,000 is a key employee";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "a 1-percent owner of the employer having an annual compensation from the employer of more than $150,000")
rule KeyEmployeeOnePercentOwner(individual: Individual, employer: Corporation, y: TaxableYear, comp: Money) defeasible {
    label en official "1-percent owner with compensation strictly over $150,000 (a plain statutory figure — the text names no cost-of-living adjustment for this amount, unlike the (A)(i) $130,000 officer threshold)";
    when one_percent_owner_of_employer(individual, employer, y);
    when key_employee_compensation(individual, employer, y, comp);
    when comp > 150000.00 USD;
    then key_employee_one_percent_owner(individual, employer, y);
}

pub relation key_employee(individual: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 416(i)(1): the individual is a key employee for this plan year (officer over threshold, 5-percent owner, or 1-percent owner over $150,000 compensation)";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The term \"key employee\" means an employee who, at any time during the plan year, is")
rule KeyEmployeeViaOfficer(individual: Individual, employer: Person, y: TaxableYear) strict {
    label en unofficial "unifies the officer ground under the shared key_employee relation";
    when key_employee_officer(individual, employer, y);
    then key_employee(individual, employer, y);
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The term \"key employee\" means an employee who, at any time during the plan year, is")
rule KeyEmployeeViaFivePercentOwner(individual: Individual, employer: Corporation, y: TaxableYear) defeasible {
    label en unofficial "unifies the 5-percent-owner ground under the shared key_employee relation";
    when key_employee_five_percent_owner(individual, employer, y);
    then key_employee(individual, employer, y);
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The term \"key employee\" means an employee who, at any time during the plan year, is")
rule KeyEmployeeViaOnePercentOwner(individual: Individual, employer: Corporation, y: TaxableYear) defeasible {
    label en unofficial "unifies the 1-percent-owner ground under the shared key_employee relation";
    when key_employee_one_percent_owner(individual, employer, y);
    then key_employee(individual, employer, y);
}

pub relation non_key_employee(individual: Individual, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 416(i)(2): any employee who is not a key employee";
}

@source(IRC_S416_I, relation = formalizes, coverage = exact, quote = "The term \"non-key employee\" means any employee who is not a key employee")
rule NonKeyEmployee(individual: Individual, employer: Person, y: TaxableYear) defeasible {
    label en official "not a key employee (open-world default: absence of a key-employee finding, not an asserted negation, per this package's not_known convention)";
    when employed_by_in_plan_year(individual, employer, y);
    unless key_employee(individual, employer, y);
    then non_key_employee(individual, employer, y);
}
// (i)(3) (self-employed individuals under section 401(c)(1) treated as
// employees, earned income treated as compensation), (i)(4) (collective-
// bargaining carve-out from (b)/(c)/(d)), (i)(5) ("employee"/"key employee"
// include beneficiaries), and (i)(6) (SEP-specific rules) are NOT modelled
// this pass — independent, narrower branches (TECH_GAP, not reached under
// the stage 2c time budget).
