// Section 417 — definitions and special rules for the section 401(a)(11)
// survivor annuity requirements. Stage 1 (IRC-09), DECISION-0379. Priority:
// 417 fully — QJSA/QPSA definitions and the election to waive as a POWER
// with spousal consent as a VALIDITY condition.


// =====================================================================
// (b)/(c) Definitions
// =====================================================================

use self::{
    IRC_S401_A,
    IRC_S417_A,
    IRC_S417_B,
    Person,
    Plan,
    participates_in,
};

pub relation qjsa_provided(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the plan provides the participant's accrued benefit in the form of a qualified joint and survivor annuity meeting section 417(b) (survivor percentage between 50% and 100%, actuarially equivalent to a single life annuity), case-asserted";
}

pub relation qjsa_survivor_percentage(plan: Plan, participant: Person, pct: Decimal) kind empirical {
    label en unofficial "the survivor-annuity percentage of the joint annuity the plan proposes, case-asserted, for testing against the section 417(b) 50%-100% band";
}

pub relation is_qualified_joint_and_survivor_annuity(plan: Plan, participant: Person) kind institutional {
    label en official "section 417(b): an annuity for the participant's life with a survivor annuity for the spouse's life of not less than 50 percent and not more than 100 percent of the joint-life amount, which is the actuarial equivalent of a single life annuity";
}

@source(IRC_S417_B, relation = formalizes, coverage = exact, quote = "for the life of the participant with a survivor annuity for the life of the spouse which is not less than 50 percent of (and is not greater than 100 percent of) the amount of the annuity which is payable during the joint lives of the participant and the spouse")
rule QJSABandTest(plan: Plan, participant: Person, pct: Decimal) strict {
    label en official "the survivor percentage must be within the closed interval [50%, 100%]";
    when qjsa_survivor_percentage(plan, participant, pct) and pct >= 0.50 and pct <= 1.00;
    then is_qualified_joint_and_survivor_annuity(plan, participant);
}

pub relation qpsa_provided(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the plan provides a qualified preretirement survivor annuity meeting section 417(c), case-asserted";
}

// =====================================================================
// (a) Election to waive — POWER with spousal-consent VALIDITY
// =====================================================================
// Method: the participant's waiver is a power that changes the applicable
// form of benefit away from the QJSA/QPSA default; its exercise is valid
// only with the spouse's written, witnessed consent (or an excusing
// circumstance) — a validity condition on the exercise of the power, not a
// separate fact. An invalid attempted waiver has NO EFFECT
// (POWER_INVALID_EXERCISE), matching E-0239.

pub relation waiver_elected(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the participant's election to waive the QJSA/QPSA form of benefit, case-asserted";
}

pub relation spousal_consent_in_writing_witnessed(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the spouse's written consent to the waiver, witnessed by a plan representative or notary public, meeting section 417(a)(2)(A), case-asserted";
}

pub relation no_spouse_or_spouse_cannot_be_located(participant: Person, plan: Plan) kind empirical {
    label en unofficial "it is established to the plan's satisfaction that consent may not be obtained because there is no spouse or the spouse cannot be located (section 417(a)(2)(B)), case-asserted";
}

pub relation within_applicable_election_period(participant: Person, plan: Plan, on: Date, annuity_starting_date: Date) kind institutional {
    label en unofficial "the 180-day period ending on the annuity starting date (section 417(a)(6)(A))";
}

pub relation annuity_starting_date_of(participant: Person, plan: Plan, annuity_starting_date: Date) kind empirical {
    label en unofficial "the participant's annuity starting date under the plan (section 417(f)(2)), case-asserted";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the 180-day period ending on the annuity starting date")
rule ApplicableElectionPeriodQJSA(participant: Person, plan: Plan, on: Date, annuity_starting_date: Date) strict {
    label en official "the QJSA waiver election period is the 180 days ending on the annuity starting date";
    when waiver_elected(participant, plan, on)
        and annuity_starting_date_of(participant, plan, annuity_starting_date)
        and on <= annuity_starting_date
        and add_calendar_period(on, 180 calendar_day) >= annuity_starting_date;
    then within_applicable_election_period(participant, plan, on, annuity_starting_date);
}

pub relation spousal_consent_satisfied(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(2): the spousal-consent condition on a waiver is satisfied, either by actual written witnessed consent or by an excusing circumstance";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the spouse's consent acknowledges the effect of such election and is witnessed by a plan representative or a notary public")
rule SpousalConsentSatisfiedByConsent(participant: Person, plan: Plan) strict {
    label en official "actual written, witnessed spousal consent satisfies (a)(2)";
    when spousal_consent_in_writing_witnessed(participant, plan);
    then spousal_consent_satisfied(participant, plan);
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "it is established to the satisfaction of a plan representative that the consent required under subparagraph (A) may not be obtained because there is no spouse, because the spouse cannot be located, or because of such other circumstances as the Secretary may by regulations prescribe")
rule SpousalConsentSatisfiedByExcuse(participant: Person, plan: Plan) strict {
    label en official "no-spouse / spouse-cannot-be-located excuses the consent requirement";
    when no_spouse_or_spouse_cannot_be_located(participant, plan);
    then spousal_consent_satisfied(participant, plan);
}

pub relation qjsa_waived(participant: Person, plan: Plan) kind institutional {
    label en unofficial "the QJSA/QPSA default form of benefit has been validly waived; the plan may pay benefits in another form the participant elects";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "may elect at any time during the applicable election period to waive the qualified joint and survivor annuity form of benefit or the qualified preretirement survivor annuity form of benefit (or both)")
rule WaiveSurvivorAnnuityPower(participant: Person, plan: Plan, on: Date) strict {
    label en official "section 417(a)(1): the participant's election to waive the qualified joint and survivor annuity (or qualified preretirement survivor annuity) form of benefit";
    when participates_in(participant, plan) and waiver_elected(participant, plan, on);
    then power WaiveSurvivorAnnuity {
        holder participant;
        over plan;
        exercise waiver_elected(participant, plan, on);
        valid_when spousal_consent_satisfied(participant, plan);
        effect qjsa_waived(participant, plan);
    };
}

pub relation valid_waiver_of_survivor_annuity(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(11) cross-reference target: a valid section 417(a) waiver is in effect";
}

@source(IRC_S401_A, relation = formalizes, coverage = contextual, quote = "provisions under which participants may elect to waive the requirements of this paragraph")
rule ValidWaiverOfSurvivorAnnuity(plan: Plan, participant: Person) strict {
    label en official "wires the section 401(a)(11) cross-reference to the section 417(a) power's effect";
    when qjsa_waived(participant, plan);
    then valid_waiver_of_survivor_annuity(plan, participant);
}
// Full subsidization exception (a)(5), the written-explanation timing rules
// (a)(3)/(7), the loan-security consent (a)(4), the 1-year-marriage rule
// (d), and the cash-out restrictions (e) (which need the section 430(h)
// segment-rate/mortality-table EXTERNAL_DEPENDENCY) are NOT modelled in
// this stage — TECH_GAP / stage 2, see coverage notes.

// =====================================================================
// (a)(3) Written explanation duty — stage 2d
// =====================================================================
// Method: the "reasonable period ... consistent with regulations" timing
// standard is DECISION-0194 evaluative (Secretary regulations set the
// actual window, 26 CFR 1.417(e)-1); modelled as an achievement-goal duty
// whose deadline the case supplies directly (EXTERNAL_DEPENDENCY on the
// regulatory "reasonable period" content, not invented here).

pub relation explanation_reasonable_period_deadline(participant: Person, plan: Plan, deadline: Date) kind empirical {
    label en unofficial "the deadline for the section 417(a)(3)(A) written explanation, as fixed by Treasury regulations for this participant/plan (EXTERNAL_DEPENDENCY: 26 CFR 1.417(e)-1's 'reasonable period' content, not reformalized here), case-asserted";
}

pub relation qjsa_explanation_provided_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the plan provided the section 417(a)(3)(A) written explanation, case-asserted";
}

pub relation qjsa_explanation_was_provided(participant: Person, plan: Plan) kind institutional {
    label en unofficial "some qjsa_explanation_provided_on date exists — a proper unary relation for not_known (a wildcard-bearing argument is not permitted under not_known, LDC-E0207)";
}

rule QjsaExplanationWasProvided(participant: Person, plan: Plan, on: Date) strict {
    label en unofficial "derives the existence signal from the dated fact";
    when qjsa_explanation_provided_on(participant, plan, on);
    then qjsa_explanation_was_provided(participant, plan);
}

pub relation qjsa_explanation_duty_breached(participant: Person, plan: Plan, deadline: Date) kind institutional {
    label en official "section 417(a)(3)(A): the plan failed to provide the written QJSA/QOSA explanation by the applicable deadline";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "Each plan shall provide to each participant, within a reasonable period of time before the annuity starting date (and consistent with such regulations as the Secretary may prescribe), a written explanation of")
rule QjsaExplanationDutyBreached(participant: Person, plan: Plan, deadline: Date) strict {
    label en official "breach: no explanation asserted as provided by the regulatory deadline";
    when explanation_reasonable_period_deadline(participant, plan, deadline)
        and not_known(qjsa_explanation_was_provided(participant, plan));
    then qjsa_explanation_duty_breached(participant, plan, deadline);
}

// =====================================================================
// (a)(3)(B) QPSA written explanation — "applicable period", earliest-
// window candidates (age 32-34 window; reasonable period after becoming a
// participant); the (III)/(IV) candidates (tied to (a)(5) and section
// 401(a)(11) applicability windows) are NOT modelled (TECH_GAP).
// =====================================================================

pub relation attains_age_32_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first day of the plan year in which the participant attains age 32, case-asserted";
}

pub relation attains_age_35_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first day of the plan year in which the participant attains age 35, case-asserted";
}

pub relation becomes_participant_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the individual becomes a plan participant, case-asserted";
}

pub relation qpsa_applicable_period_candidate(participant: Person, plan: Plan, on: Date) kind institutional {
    label en unofficial "a candidate END date for the section 417(a)(3)(B)(ii) applicable period (the period whose LATEST end date governs)";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "The period beginning with the first day of the plan year in which the participant attains age 32 and ending with the close of the plan year preceding the plan year in which the participant attains")
rule QpsaApplicablePeriodCandidateAge32to34(participant: Person, plan: Plan, age35: Date, calendar_before_1: Date) strict {
    label en unofficial "(I): candidate end = the day before the age-35 plan year begins";
    when attains_age_35_on(participant, plan, age35)
        and us.irc.core::civil_calendar_boundary_before(age35, 1, us.irc.core::CalendarDay, calendar_before_1);
    then qpsa_applicable_period_candidate(participant, plan, calendar_before_1);
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "A reasonable period after the individual becomes a participant")
rule QpsaApplicablePeriodCandidateAfterParticipation(participant: Person, plan: Plan, joined: Date) strict {
    label en unofficial "(II): candidate end = a reasonable period (case-asserted as 1 year) after becoming a participant";
    when becomes_participant_on(participant, plan, joined);
    then qpsa_applicable_period_candidate(participant, plan, add_calendar_period(joined, 1 calendar_year));
}

pub relation qpsa_applicable_period_later_candidate_exists(participant: Person, plan: Plan, on: Date) kind institutional {
    label en unofficial "some OTHER qpsa_applicable_period_candidate is strictly later than `on` (TECH-GAPS G136 idiom)";
}

rule QpsaApplicablePeriodLaterCandidateExists(participant: Person, plan: Plan, on: Date, on2: Date) strict {
    label en unofficial "disqualifies a candidate when a strictly later one exists";
    when qpsa_applicable_period_candidate(participant, plan, on);
    when qpsa_applicable_period_candidate(participant, plan, on2);
    when on2 > on;
    then qpsa_applicable_period_later_candidate_exists(participant, plan, on);
}

pub relation qpsa_applicable_period_ends(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 417(a)(3)(B)(ii): the applicable period ends on the latest of the modelled candidates";
}

rule QpsaApplicablePeriodEndsAtLatestCandidate(participant: Person, plan: Plan, on: Date) defeasible {
    label en official "latest known candidate";
    when qpsa_applicable_period_candidate(participant, plan, on);
    unless qpsa_applicable_period_later_candidate_exists(participant, plan, on);
    then qpsa_applicable_period_ends(participant, plan, on);
}

pub relation qpsa_explanation_provided_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the plan provided the section 417(a)(3)(B) QPSA written explanation, case-asserted";
}

pub relation qpsa_explanation_was_provided(participant: Person, plan: Plan) kind institutional {
    label en unofficial "existence signal for not_known, see qjsa_explanation_was_provided above";
}

rule QpsaExplanationWasProvided(participant: Person, plan: Plan, on: Date) strict {
    label en unofficial "derives the existence signal from the dated fact";
    when qpsa_explanation_provided_on(participant, plan, on);
    then qpsa_explanation_was_provided(participant, plan);
}

pub relation qpsa_explanation_duty_breached(participant: Person, plan: Plan, deadline: Date) kind institutional {
    label en official "section 417(a)(3)(B): the plan failed to provide the QPSA written explanation by the close of the applicable period";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "Each plan shall provide to each participant, within the applicable period with respect to such participant (and consistent with such regulations as the Secretary may prescribe), a written explanation with respect to the qualified preretirement survivor annuity comparable to that required under subparagraph (A)")
rule QpsaExplanationDutyBreached(participant: Person, plan: Plan, deadline: Date) defeasible {
    label en official "breach: no QPSA explanation asserted as provided by the applicable-period deadline";
    when qpsa_applicable_period_ends(participant, plan, deadline)
        and not_known(qpsa_explanation_was_provided(participant, plan));
    then qpsa_explanation_duty_breached(participant, plan, deadline);
}

// =====================================================================
// (a)(4) Loan-security spousal consent — reuses the (a)(2) consent test
// =====================================================================

pub relation accrued_benefit_proposed_as_loan_security(participant: Person, plan: Plan, secured_on: Date) kind empirical {
    label en unofficial "part or all of the participant's accrued benefit is proposed to be used as security for a loan on this date, case-asserted";
}

pub relation loan_security_consent_given_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the spouse's written consent to the loan-security use was given, case-asserted";
}

pub relation loan_security_consent_within_90_days(participant: Person, plan: Plan, secured_on: Date) kind institutional {
    label en official "section 417(a)(4)(A): spousal consent given during the 90-day period ending on the date the loan is secured";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the spouse of the participant (if any) consents in writing to such use during the 90-day period ending on the date on which the loan is to be so secured")
rule LoanSecurityConsentWithin90Days(participant: Person, plan: Plan, secured_on: Date, consented_on: Date) strict {
    label en official "consent date within the 90 days ending on the secured date";
    when accrued_benefit_proposed_as_loan_security(participant, plan, secured_on)
        and loan_security_consent_given_on(participant, plan, consented_on)
        and consented_on <= secured_on
        and add_calendar_period(consented_on, 90 calendar_day) >= secured_on;
    then loan_security_consent_within_90_days(participant, plan, secured_on);
}

pub relation accrued_benefit_may_secure_loan(participant: Person, plan: Plan, secured_on: Date) kind institutional {
    label en official "section 417(a)(4): the accrued benefit may be used as loan security — timely consent (comparable to (a)(2)) satisfied";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "requirements comparable to the requirements of paragraph (2) are met with respect to such consent")
rule AccruedBenefitMaySecureLoan(participant: Person, plan: Plan, secured_on: Date) strict {
    label en official "timely consent (within 90 days) plus the (a)(2)-comparable consent-quality test (spousal_consent_satisfied, reused from the waiver rules above)";
    when loan_security_consent_within_90_days(participant, plan, secured_on)
        and spousal_consent_satisfied(participant, plan);
    then accrued_benefit_may_secure_loan(participant, plan, secured_on);
}

// =====================================================================
// (a)(5) Full-subsidization exception
// =====================================================================

pub relation benefit_not_waivable_or_reselectable(plan: Plan) kind empirical {
    label en unofficial "under the plan the QJSA/QPSA benefit may not be waived (or another beneficiary selected), case-asserted";
}

pub relation waiver_failure_causes_no_decrease_or_increased_contribution(plan: Plan) kind empirical {
    label en unofficial "failure to waive the benefit would not decrease any plan benefit or increase the participant's required contributions, section 417(a)(5)(B), case-asserted";
}

pub relation plan_fully_subsidizes_survivor_benefit(plan: Plan) kind institutional {
    label en official "section 417(a)(5)(B): the plan fully subsidizes the cost of the QJSA/QPSA benefit";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "a plan fully subsidizes the costs of a benefit if under the plan the failure to waive such benefit by a participant would not result in a decrease in any plan benefits with respect to such participant and would not result in increased contributions from such participant")
rule PlanFullySubsidizesSurvivorBenefit(plan: Plan) strict {
    label en official "restates the (5)(B) definition";
    when waiver_failure_causes_no_decrease_or_increased_contribution(plan);
    then plan_fully_subsidizes_survivor_benefit(plan);
}

pub relation section417_requirements_inapplicable(plan: Plan) kind institutional {
    label en official "section 417(a)(5)(A): the requirements of this subsection do not apply to a non-waivable, fully-subsidized benefit";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "The requirements of this subsection shall not apply with respect to the qualified joint and survivor annuity form of benefit or the qualified preretirement survivor annuity form of benefit, as the case may be, if such benefit may not be waived (or another beneficiary selected) and if the plan fully subsidizes the costs of such benefit")
rule Section417RequirementsInapplicable(plan: Plan) strict {
    label en official "non-waivable + fully subsidized => the whole subsection is inapplicable";
    when benefit_not_waivable_or_reselectable(plan)
        and plan_fully_subsidizes_survivor_benefit(plan);
    then section417_requirements_inapplicable(plan);
}

// =====================================================================
// (a)(6)(B) QPSA applicable election period
// =====================================================================

pub relation participant_died_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the participant's death, case-asserted";
}

pub relation within_applicable_election_period_qpsa(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 417(a)(6)(B): the period beginning on the first day of the plan year the participant attains age 35 and ending on the date of death";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "in the case of an election to waive the qualified preretirement survivor annuity, the period which begins on the first day of the plan year in which the participant attains age 35 and ends on the date of the participant's death")
rule WithinApplicableElectionPeriodQpsa(participant: Person, plan: Plan, on: Date, age35: Date, died: Date) strict {
    label en official "on is within [age-35-plan-year-start, date of death]";
    when waiver_elected(participant, plan, on)
        and attains_age_35_on(participant, plan, age35)
        and participant_died_on(participant, plan, died)
        and on >= age35
        and on <= died;
    then within_applicable_election_period_qpsa(participant, plan, on);
}
// (a)(6)(B)'s separation-from-service special rule (the period may not
// begin later than the separation date) is NOT modelled (TECH_GAP).

// =====================================================================
// (a)(7) Late explanation — 30-day extension and the 7-day waiver
// =====================================================================

pub relation qjsa_extended_election_period_end(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 417(a)(7)(A): if the written explanation is provided after the annuity starting date, the applicable election period does not end before the 30th day after the explanation is provided";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "In any case to which this subparagraph applies, the applicable election period under paragraph (6) shall not end before the 30th day after the date on which such explanation is provided")
rule QjsaExtendedElectionPeriodEnd(participant: Person, plan: Plan, asd: Date, explained_on: Date) strict {
    label en official "extension applies when the explanation is provided AFTER the annuity starting date";
    when annuity_starting_date_of(participant, plan, asd)
        and qjsa_explanation_provided_on(participant, plan, explained_on)
        and explained_on > asd;
    then qjsa_extended_election_period_end(participant, plan, add_calendar_period(explained_on, 30 calendar_day));
}

pub relation participant_waives_30_day_explanation_requirement(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the participant elects (with any applicable spousal consent) to waive the requirement that the explanation be provided at least 30 days before the annuity starting date, case-asserted";
}

pub relation distribution_commences_on(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the distribution commences, case-asserted";
}

pub relation thirty_day_notice_validly_waived(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(7)(B): the 30-day-advance-notice requirement is validly waived when the distribution commences more than 7 days after the explanation is provided";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "if the distribution commences more than 7 days after such explanation is provided")
rule ThirtyDayNoticeValidlyWaived(participant: Person, plan: Plan, explained_on: Date, commenced_on: Date) strict {
    label en official "valid only when the gap between explanation and commencement exceeds 7 days";
    when participant_waives_30_day_explanation_requirement(participant, plan)
        and qjsa_explanation_provided_on(participant, plan, explained_on)
        and distribution_commences_on(participant, plan, commenced_on)
        and add_calendar_period(explained_on, 7 calendar_day) < commenced_on;
    then thirty_day_notice_validly_waived(participant, plan);
}
// (a)(1)(A)(ii)/(iii) (the qualified optional survivor annuity election
// and the right to revoke any election, "at any time during the applicable
// election period") are NOT separately modelled (TECH_GAP: would reuse the
// same WaiveSurvivorAnnuity power machinery for a second, QOSA-specific
// election, not attempted this pass). The (d) 1-year-marriage rule and (e)
// cash-out restrictions remain NOT modelled (unchanged from stage 1).
