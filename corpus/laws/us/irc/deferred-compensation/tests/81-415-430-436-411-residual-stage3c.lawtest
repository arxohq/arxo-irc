    evaluate truth(excluded_plan_treated_as_meeting_411_for_401a_411e2(entity_ref("urn:test:s411e2-02-excluded-plan-not-meeting-the-1974-vesting-rules-does-not#pl")));
    expect truth_status == NEITHER;
}

