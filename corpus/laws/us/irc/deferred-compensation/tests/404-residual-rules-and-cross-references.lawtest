        assert "f1": applicable_dividend_404k2(entity_ref("urn:test:s404k1-02-a-non-c-corporation-gets-no-deduction#dv")) { origin adjudicated; }
        assert "f2": securities_held_on_record_date_by_esop_of_group_404k3(entity_ref("urn:test:s404k1-02-a-non-c-corporation-gets-no-deduction#dv")) { origin case_input; }
    }
    evaluate truth(dividend_deduction_allowed_404k1(entity_ref("urn:test:s404k1-02-a-non-c-corporation-gets-no-deduction#dv"), entity_ref("urn:test:s404k1-02-a-non-c-corporation-gets-no-deduction#cp"), 9000.00 USD));
    expect truth_status == NEITHER;
}

