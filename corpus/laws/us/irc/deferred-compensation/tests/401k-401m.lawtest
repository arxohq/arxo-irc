test "S401K8-02-CORRECTIVE-DISTRIBUTION-SATISFIED-WITHIN-FOLLOWING-PLAN-YEAR" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        assert "f0": hce_contributions_paid_over(entity_ref("urn:test:s401k8:c2#plan"), entity_ref("urn:test:s401k8:c2#y2025"), 50000 USD) { origin case_input; }
        assert "f1": max_permitted_under_adp(entity_ref("urn:test:s401k8:c2#plan"), entity_ref("urn:test:s401k8:c2#y2025"), 42000 USD) { origin case_input; }
        assert "f2": plan_year_ends(entity_ref("urn:test:s401k8:c2#plan"), entity_ref("urn:test:s401k8:c2#y2025"), @2025-12-31) { origin case_input; }
        assert "f3": plan_sponsor(entity_ref("urn:test:s401k8:c2#plan"), entity_ref("urn:test:s401k8:c2#er")) { origin case_input; }
        assert "f4": excess_contributions_distributed(entity_ref("urn:test:s401k8:c2#plan"), entity_ref("urn:test:s401k8:c2#y2025")) { origin case_input; }
    }
    // distributed before the close of the following plan year (2026-12-31)
    evaluate positions();
    expect position(ExcessContributionCorrectiveDistributionDutyPosition, SATISFIED);
}

test "S401K8-03-CORRECTIVE-DISTRIBUTION-ACTIVE-BEFORE-DEADLINE-NO-DISTRIBUTION-YET" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        assert "f0": hce_contributions_paid_over(entity_ref("urn:test:s401k8:c3#plan"), entity_ref("urn:test:s401k8:c3#y2025"), 50000 USD) { origin case_input; }
        assert "f1": max_permitted_under_adp(entity_ref("urn:test:s401k8:c3#plan"), entity_ref("urn:test:s401k8:c3#y2025"), 42000 USD) { origin case_input; }
        assert "f2": plan_year_ends(entity_ref("urn:test:s401k8:c3#plan"), entity_ref("urn:test:s401k8:c3#y2025"), @2025-12-31) { origin case_input; }
        assert "f3": plan_sponsor(entity_ref("urn:test:s401k8:c3#plan"), entity_ref("urn:test:s401k8:c3#er")) { origin case_input; }
        // no distribution asserted yet; before the 2026-12-31 deadline
    }
    evaluate positions();
    expect position(ExcessContributionCorrectiveDistributionDutyPosition, ACTIVE);
}

