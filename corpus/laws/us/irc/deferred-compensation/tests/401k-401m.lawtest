// =====================================================================
// STAGE 2 (25.09.2026): (k)(12)/(13) matching/nonelective formulas,
// (k)(8) excess contributions duty, (k)(15) long-term part-time.
// =====================================================================

test "S401K12-01-BASIC-MATCH-FORMULA-ABOVE-5-PERCENT-DEFERRAL" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // comp = 100,000; ec = 6,000 (6% of comp, above the 5% ceiling)
        // tier1 = min(6000, 3000) = 3000 at 100%
        // tier2 = 50% of (min(6000,5000) - 3000) = 50% of 2000 = 1000
        // total = 4000
        assert "f0": elective_contribution_amount(entity_ref("urn:test:s401k12:c1#emp"), entity_ref("urn:test:s401k12:c1#plan"), entity_ref("urn:test:s401k12:c1#y2026"), 6000 USD) { origin case_input; }
        assert "f1": employee_compensation_401k(entity_ref("urn:test:s401k12:c1#emp"), entity_ref("urn:test:s401k12:c1#plan"), entity_ref("urn:test:s401k12:c1#y2026"), 100000 USD) { origin case_input; }
    }
    evaluate truth(basic_matching_formula_amount(entity_ref("urn:test:s401k12:c1#emp"), entity_ref("urn:test:s401k12:c1#plan"), entity_ref("urn:test:s401k12:c1#y2026"), 4000 USD));
    expect truth_status == TRUE_ONLY;
}

