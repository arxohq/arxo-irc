        // total = 3500
        assert "f0": elective_contribution_amount(entity_ref("urn:test:s401k13:c1#emp"), entity_ref("urn:test:s401k13:c1#plan"), entity_ref("urn:test:s401k13:c1#y2026"), 8000 USD) { origin case_input; }
