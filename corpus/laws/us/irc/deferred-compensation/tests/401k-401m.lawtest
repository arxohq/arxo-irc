// Section 401(k)/(m) scenarios: ADP test at exactly 1.25x and at the
// 2x-and-2-points boundary; ACP test. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S401K3-01-ADP-AT-EXACTLY-1-25X-PASSES" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": adp_hce(entity_ref("urn:test:s401k3:c1#plan"), entity_ref("urn:test:s401k3:c1#y2025"), 5.0) { origin case_input; }
        assert "f1": adp_nhce_preceding_year(entity_ref("urn:test:s401k3:c1#plan"), entity_ref("urn:test:s401k3:c1#y2025"), 4.0) { origin case_input; }
    }
    // 4.0 * 1.25 = 5.0 exactly -> passes
    evaluate truth(adp_125x_test(entity_ref("urn:test:s401k3:c1#plan"), entity_ref("urn:test:s401k3:c1#y2025"), 5.0, 4.0));
    expect truth_status == TRUE_ONLY;
}

test "S401K3-02-ADP-ABOVE-1-25X-FAILS-FIRST-TEST" {
    given {
        context {
            legal_time @2026-01-01;
