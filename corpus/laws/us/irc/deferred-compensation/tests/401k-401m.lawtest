        assert "f0": adp_hce(entity_ref("urn:test:s401k3:c2#plan"), entity_ref("urn:test:s401k3:c2#y2025"), 5.01) { origin case_input; }
        assert "f1": adp_nhce_preceding_year(entity_ref("urn:test:s401k3:c2#plan"), entity_ref("urn:test:s401k3:c2#y2025"), 4.0) { origin case_input; }
    }
    evaluate truth(adp_125x_test(entity_ref("urn:test:s401k3:c2#plan"), entity_ref("urn:test:s401k3:c2#y2025"), 5.01, 4.0));
    expect truth_status == NEITHER;
}

test "S401K3-03-ADP-2X-AND-2-POINTS-BOUNDARY-PASSES" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // nhce = 2.0; hce = 4.0 (exactly 2x AND exactly +2 points) -> passes second test
        assert "f0": adp_hce(entity_ref("urn:test:s401k3:c3#plan"), entity_ref("urn:test:s401k3:c3#y2025"), 4.0) { origin case_input; }
        assert "f1": adp_nhce_preceding_year(entity_ref("urn:test:s401k3:c3#plan"), entity_ref("urn:test:s401k3:c3#y2025"), 2.0) { origin case_input; }
    }
    evaluate truth(adp_2x_test(entity_ref("urn:test:s401k3:c3#plan"), entity_ref("urn:test:s401k3:c3#y2025"), 4.0, 2.0));
    expect truth_status == TRUE_ONLY;
}

