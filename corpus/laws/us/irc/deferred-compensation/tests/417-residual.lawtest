test "S417A1-01-QOSA-ELECTION-AFTER-A-VALID-WAIVER-IS-VALID" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participates_in(entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#pt"), entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#plan")) { origin adjudicated; }
        assert "f1": waiver_elected(entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#pt"), entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#plan"), @2026-01-01) { origin case_input; }
        assert "f2": spousal_consent_in_writing_witnessed(entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#pt"), entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#plan")) { origin case_input; }
        assert "f3": qosa_election_made_417(entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#pt"), entity_ref("urn:test:s417a1-01-qosa-election-after-a-valid-waiver-is-valid#plan"), @2026-02-01) { origin case_input; }
    }
    evaluate positions();
    expect position(ElectQualifiedOptionalSurvivorAnnuity, VALIDLY_EXERCISED);
}

