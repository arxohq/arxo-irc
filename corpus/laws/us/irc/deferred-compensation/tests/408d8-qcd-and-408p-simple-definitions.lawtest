    evaluate truth(employee_excluded_from_participation_requirement_408p4B(entity_ref("urn:test:s408p4b-02-without-the-election-no-exclusion#ee"), entity_ref("urn:test:s408p4b-02-without-the-election-no-exclusion#em"), entity_ref("urn:test:s408p4b-02-without-the-election-no-exclusion#y")));
    expect truth_status == NEITHER;
}

