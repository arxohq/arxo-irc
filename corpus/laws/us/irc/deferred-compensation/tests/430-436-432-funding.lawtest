// Sections 430/436/432(b) scenarios: target normal cost formula, funding
// shortfall/base, year-1 shortfall amortization installment, at-risk
// status and loading factor, due date/quarterly installment arithmetic,
// section 430(k) lien trigger, section 436(d)/(e) AFTAP restrictions and
// the (h)(1) carryover presumption, section 432(b) endangered/critical
// status. NOT EXECUTED (implemented_unverified per AGENT-BRIEF.md).

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S430B-01-TARGET-NORMAL-COST-FORMULA" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": pv_accruing_benefits_430b(entity_ref("urn:test:s430b:c1#plan"), entity_ref("urn:test:s430b:c1#y2026"), 500000.00 USD) { origin case_input; }
        assert "f1": plan_related_expenses_430b(entity_ref("urn:test:s430b:c1#plan"), entity_ref("urn:test:s430b:c1#y2026"), 20000.00 USD) { origin case_input; }
        assert "f2": mandatory_employee_contributions_430b(entity_ref("urn:test:s430b:c1#plan"), entity_ref("urn:test:s430b:c1#y2026"), 30000.00 USD) { origin case_input; }
    }
    // 500,000 + 20,000 - 30,000 = 490,000
    evaluate truth(target_normal_cost(entity_ref("urn:test:s430b:c1#plan"), entity_ref("urn:test:s430b:c1#y2026"), 490000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S430C-01-FUNDING-SHORTFALL-AND-BASE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": funding_target(entity_ref("urn:test:s430c:c1#plan"), entity_ref("urn:test:s430c:c1#y2026"), 10000000.00 USD) { origin case_input; }
        assert "f1": value_of_plan_assets_430(entity_ref("urn:test:s430c:c1#plan"), entity_ref("urn:test:s430c:c1#y2026"), 9000000.00 USD) { origin case_input; }
        assert "f2": prior_shortfall_amortization_installments_pv_430(entity_ref("urn:test:s430c:c1#plan"), entity_ref("urn:test:s430c:c1#y2026"), 200000.00 USD) { origin case_input; }
    }
    // shortfall = 10,000,000 - 9,000,000 = 1,000,000; base = 1,000,000 - 200,000 = 800,000
    evaluate truth(funding_shortfall_430(entity_ref("urn:test:s430c:c1#plan"), entity_ref("urn:test:s430c:c1#y2026"), 1000000.00 USD));
    expect truth_status == TRUE_ONLY;

    evaluate truth(shortfall_amortization_base_430(entity_ref("urn:test:s430c:c1#plan"), entity_ref("urn:test:s430c:c1#y2026"), 800000.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S430C-02-YEAR-1-LEVEL-INSTALLMENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": funding_target(entity_ref("urn:test:s430c2:c1#plan"), entity_ref("urn:test:s430c2:c1#y2026"), 1000000.00 USD) { origin case_input; }
        assert "f1": value_of_plan_assets_430(entity_ref("urn:test:s430c2:c1#plan"), entity_ref("urn:test:s430c2:c1#y2026"), 0.00 USD) { origin case_input; }
        assert "f2": prior_shortfall_amortization_installments_pv_430(entity_ref("urn:test:s430c2:c1#plan"), entity_ref("urn:test:s430c2:c1#y2026"), 0.00 USD) { origin case_input; }
        assert "f3": effective_interest_rate_430(entity_ref("urn:test:s430c2:c1#plan"), entity_ref("urn:test:s430c2:c1#y2026"), 0.05) { origin case_input; }
    }
    // base = 1,000,000, r = 5%, n = 7: installment = base*r*(1+r)^7/((1+r)^7-1)
    // = 1,000,000*0.05*1.4071004226/(0.4071004226) ~= 172,819.87 (hand-
    // computed to the cent for this scenario; HALF_UP rounding to 2dp).
    evaluate truth(shortfall_amortization_charge(entity_ref("urn:test:s430c2:c1#plan"), entity_ref("urn:test:s430c2:c1#y2026"), 172819.87 USD));
    expect truth_status == TRUE_ONLY;
}

test "S430I-01-LOADING-FACTOR" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participant_count_430(entity_ref("urn:test:s430i:c1#plan"), entity_ref("urn:test:s430i:c1#y2026"), 100) { origin case_input; }
        assert "f1": funding_target(entity_ref("urn:test:s430i:c1#plan"), entity_ref("urn:test:s430i:c1#y2026"), 5000000.00 USD) { origin case_input; }
    }
    // 700 * 100 + 0.04 * 5,000,000 = 70,000 + 200,000 = 270,000
    evaluate truth(at_risk_loading_factor_430(entity_ref("urn:test:s430i:c1#plan"), entity_ref("urn:test:s430i:c1#y2026"), 270000.00 USD));
    expect truth_status == TRUE_ONLY;
}

