test "S430J-01-DUE-DATE-8-AND-HALF-MONTHS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        assert "f0": plan_year_ends_430(entity_ref("urn:test:s430j:c1#plan"), entity_ref("urn:test:s430j:c1#y2025"), @2025-12-31) { origin case_input; }
    }
    // Dec 31 + 8 months = Aug 31; + 15 days = Sep 15
    evaluate truth(minimum_required_contribution_due_date_430(entity_ref("urn:test:s430j:c1#plan"), entity_ref("urn:test:s430j:c1#y2025"), @2026-09-15));
    expect truth_status == TRUE_ONLY;
}

test "S430J-02-REQUIRED-INSTALLMENT-25-PERCENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": minimum_required_contribution_430(entity_ref("urn:test:s430j2:c1#plan"), entity_ref("urn:test:s430j2:c1#y2026"), 400000.00 USD) { origin case_input; }
        assert "f1": prior_year_minimum_required_contribution_430(entity_ref("urn:test:s430j2:c1#plan"), entity_ref("urn:test:s430j2:c1#y2026"), 500000.00 USD) { origin case_input; }
        assert "f2": preceding_plan_year_was_12_months_430(entity_ref("urn:test:s430j2:c1#plan"), entity_ref("urn:test:s430j2:c1#y2026")) { origin case_input; }
    }
    // lesser of (90% x 400,000 = 360,000) and (100% x 500,000 = 500,000) = 360,000
    evaluate truth(required_annual_payment_430(entity_ref("urn:test:s430j2:c1#plan"), entity_ref("urn:test:s430j2:c1#y2026"), 360000.00 USD));
    expect truth_status == TRUE_ONLY;
    // installment = 25% of 360,000 = 90,000
    evaluate truth(required_installment_amount_430(entity_ref("urn:test:s430j2:c1#plan"), entity_ref("urn:test:s430j2:c1#y2026"), 90000.00 USD));
    expect truth_status == TRUE_ONLY;
}

