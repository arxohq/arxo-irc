// Section 404 scenarios: 25% deduction limit, SEP deduction limit. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S404A3-01-DEDUCTION-LIMIT-25-PERCENT-OF-COMPENSATION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": compensation_paid_to_beneficiaries(entity_ref("urn:test:s404a3:c1#plan"), entity_ref("urn:test:s404a3:c1#y2026"), 400000 USD) { origin case_input; }
        assert "f1": contribution_required_under_401k11(entity_ref("urn:test:s404a3:c1#plan"), entity_ref("urn:test:s404a3:c1#y2026"), 0 USD) { origin case_input; }
    }
    evaluate truth(section404a3_deduction_limit(entity_ref("urn:test:s404a3:c1#plan"), entity_ref("urn:test:s404a3:c1#y2026"), 100000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S404A3-02-EXCESS-CONTRIBUTION-CARRIED-OVER" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": compensation_paid_to_beneficiaries(entity_ref("urn:test:s404a3:c2#plan"), entity_ref("urn:test:s404a3:c2#y2026"), 400000 USD) { origin case_input; }
        assert "f1": contribution_required_under_401k11(entity_ref("urn:test:s404a3:c2#plan"), entity_ref("urn:test:s404a3:c2#y2026"), 0 USD) { origin case_input; }
        assert "f2": contribution_paid_to_stock_bonus_or_profit_sharing_trust(entity_ref("urn:test:s404a3:c2#plan"), entity_ref("urn:test:s404a3:c2#y2026"), 120000 USD) { origin case_input; }
    }
    evaluate truth(section404a3_excess_contribution(entity_ref("urn:test:s404a3:c2#plan"), entity_ref("urn:test:s404a3:c2#y2026"), 20000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S404H-01-SEP-DEDUCTION-LIMIT-25-PERCENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sep_compensation_paid(entity_ref("urn:test:s404h:c1#er"), entity_ref("urn:test:s404h:c1#y2026"), 200000 USD) { origin case_input; }
        assert "f1": sep_contribution_paid(entity_ref("urn:test:s404h:c1#er"), entity_ref("urn:test:s404h:c1#y2026"), 50000 USD) { origin case_input; }
    }
    // limit = 50000, paid = 50000 -> fully deductible
    evaluate truth(section404h_deductible_amount(entity_ref("urn:test:s404h:c1#er"), entity_ref("urn:test:s404h:c1#y2026"), 50000 USD));
    expect truth_status == TRUE_ONLY;
}
