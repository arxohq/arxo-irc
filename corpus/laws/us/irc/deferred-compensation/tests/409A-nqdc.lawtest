// Section 409A scenarios: specified-employee 6-month delay, acceleration
// prohibition, plan failure with inclusion + 20% additional tax. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S409AA-01-SPECIFIED-EMPLOYEE-SIX-MONTH-DELAY-VIOLATED" {
    given {
        context {
            legal_time @2026-04-01;
            decision_time @2026-04-01T09:00:00-05:00;
            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": separation_from_service_on(entity_ref("urn:test:s409aa:c1#ee"), entity_ref("urn:test:s409aa:c1#plan"), @2026-01-01) { origin case_input; }
        assert "f1": key_employee_publicly_traded(entity_ref("urn:test:s409aa:c1#ee"), entity_ref("urn:test:s409aa:c1#plan")) { origin case_input; }
        assert "f2": actual_distribution_trigger(entity_ref("urn:test:s409aa:c1#plan"), entity_ref("urn:test:s409aa:c1#ee"), @2026-04-01, SeparationFromService) { origin case_input; }
    }
    // distribution attempted 3 months after separation; earliest permitted is July 1, 2026
    evaluate truth(distribution_violates_specified_employee_delay(entity_ref("urn:test:s409aa:c1#ee"), entity_ref("urn:test:s409aa:c1#plan"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
}

test "S409AA-02-SPECIFIED-EMPLOYEE-DISTRIBUTION-AFTER-SIX-MONTHS-OK" {
    given {
        context {
            legal_time @2026-07-01;
            decision_time @2026-07-01T09:00:00-05:00;
            knowledge_time @2026-07-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": separation_from_service_on(entity_ref("urn:test:s409aa:c2#ee"), entity_ref("urn:test:s409aa:c2#plan"), @2026-01-01) { origin case_input; }
        assert "f1": key_employee_publicly_traded(entity_ref("urn:test:s409aa:c2#ee"), entity_ref("urn:test:s409aa:c2#plan")) { origin case_input; }
        assert "f2": actual_distribution_trigger(entity_ref("urn:test:s409aa:c2#plan"), entity_ref("urn:test:s409aa:c2#ee"), @2026-07-01, SeparationFromService) { origin case_input; }
    }
    evaluate truth(distribution_violates_specified_employee_delay(entity_ref("urn:test:s409aa:c2#ee"), entity_ref("urn:test:s409aa:c2#plan"), @2026-07-01));
    expect truth_status == NEITHER;
}

test "S409AA-03-ACCELERATION-WITHOUT-REGULATORY-EXCEPTION-PROHIBITED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_sponsor_of_nqdc(entity_ref("urn:test:s409aa:c3#sponsor"), entity_ref("urn:test:s409aa:c3#plan")) { origin case_input; }
        assert "f1": actual_payment_date(entity_ref("urn:test:s409aa:c3#plan"), entity_ref("urn:test:s409aa:c3#ee"), @2026-01-01) { origin case_input; }
        assert "f2": scheduled_payment_date(entity_ref("urn:test:s409aa:c3#plan"), entity_ref("urn:test:s409aa:c3#ee"), @2027-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(AccelerationOfBenefits, VIOLATED);
}

test "S409AA1-01-PLAN-FAILURE-INCLUSION-AND-20-PERCENT-TAX" {
    given {
        context {
            legal_time @2026-04-01;
            decision_time @2026-04-01T09:00:00-05:00;
            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": separation_from_service_on(entity_ref("urn:test:s409aa1:c1#ee"), entity_ref("urn:test:s409aa1:c1#plan"), @2026-01-01) { origin case_input; }
        assert "f1": key_employee_publicly_traded(entity_ref("urn:test:s409aa1:c1#ee"), entity_ref("urn:test:s409aa1:c1#plan")) { origin case_input; }
        assert "f2": actual_distribution_trigger(entity_ref("urn:test:s409aa1:c1#plan"), entity_ref("urn:test:s409aa1:c1#ee"), @2026-04-01, SeparationFromService) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s409aa1:c1#ee"), entity_ref("urn:test:s409aa1:c1#y2026")) { origin case_input; }
        assert "f4": deferred_compensation_not_subject_to_substantial_risk_of_forfeiture(entity_ref("urn:test:s409aa1:c1#plan"), entity_ref("urn:test:s409aa1:c1#ee"), entity_ref("urn:test:s409aa1:c1#y2026"), 100000 USD) { origin case_input; }
    }
    evaluate truth(nqdc_failure_inclusion(entity_ref("urn:test:s409aa1:c1#plan"), entity_ref("urn:test:s409aa1:c1#ee"), entity_ref("urn:test:s409aa1:c1#y2026"), 100000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S409AA1-02-TWENTY-PERCENT-ADDITIONAL-TAX-COMPUTED" {
    given {
        context {
            legal_time @2026-04-01;
            decision_time @2026-04-01T09:00:00-05:00;
            knowledge_time @2026-04-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": separation_from_service_on(entity_ref("urn:test:s409aa1:c2#ee"), entity_ref("urn:test:s409aa1:c2#plan"), @2026-01-01) { origin case_input; }
        assert "f1": key_employee_publicly_traded(entity_ref("urn:test:s409aa1:c2#ee"), entity_ref("urn:test:s409aa1:c2#plan")) { origin case_input; }
        assert "f2": actual_distribution_trigger(entity_ref("urn:test:s409aa1:c2#plan"), entity_ref("urn:test:s409aa1:c2#ee"), @2026-04-01, SeparationFromService) { origin case_input; }
        assert "f3": us.irc.core::year_of(entity_ref("urn:test:s409aa1:c2#ee"), entity_ref("urn:test:s409aa1:c2#y2026")) { origin case_input; }
        assert "f4": deferred_compensation_not_subject_to_substantial_risk_of_forfeiture(entity_ref("urn:test:s409aa1:c2#plan"), entity_ref("urn:test:s409aa1:c2#ee"), entity_ref("urn:test:s409aa1:c2#y2026"), 100000 USD) { origin case_input; }
    }
    evaluate truth(nqdc_additional_tax_20_percent(entity_ref("urn:test:s409aa1:c2#plan"), entity_ref("urn:test:s409aa1:c2#ee"), entity_ref("urn:test:s409aa1:c2#y2026"), 20000 USD));
    expect truth_status == TRUE_ONLY;
}
