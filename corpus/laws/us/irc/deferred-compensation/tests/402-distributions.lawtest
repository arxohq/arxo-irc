test "S402E2-01-NONRESIDENT-ALIEN-RATIO-COMPUTATION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // US-source pay = 60,000 of total 100,000 -> ratio 0.6
        assert "f0": us_distribution_to_nonresident_alien(entity_ref("urn:test:s402e2:c1#ee"), entity_ref("urn:test:s402e2:c1#y2026"), 10000 USD) { origin case_input; }
        assert "f1": basic_pay_from_us_sources(entity_ref("urn:test:s402e2:c1#ee"), 60000 USD) { origin case_input; }
        assert "f2": basic_pay_total(entity_ref("urn:test:s402e2:c1#ee"), 100000 USD) { origin case_input; }
    }
    evaluate truth(nonresident_alien_us_distribution_includible(entity_ref("urn:test:s402e2:c1#ee"), entity_ref("urn:test:s402e2:c1#y2026"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

