// Section 402(a)/(c)/(g) scenarios: inclusion, 60-day rollover boundary
// (day 60 vs day 61), elective deferral excess. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S402A-01-DISTRIBUTION-INCLUDIBLE-WHEN-NOT-ROLLED-OVER" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_trust_distribution(entity_ref("urn:test:s402a:c1#dist"), entity_ref("urn:test:s402a:c1#plan")) { origin case_input; }
        assert "f1": distribution(entity_ref("urn:test:s402a:c1#dist"), entity_ref("urn:test:s402a:c1#plan"), entity_ref("urn:test:s402a:c1#ee"), 10000 USD, @2026-01-01) { origin case_input; }
        assert "f2": us.irc.core::year_of(entity_ref("urn:test:s402a:c1#ee"), entity_ref("urn:test:s402a:c1#y2026")) { origin case_input; }
        assert "f3": includible_under_section_72(entity_ref("urn:test:s402a:c1#dist"), entity_ref("urn:test:s402a:c1#ee"), entity_ref("urn:test:s402a:c1#y2026"), 10000 USD) { origin case_input; }
    }
    evaluate truth(section402a_includible_in_gross_income(entity_ref("urn:test:s402a:c1#dist"), entity_ref("urn:test:s402a:c1#ee"), entity_ref("urn:test:s402a:c1#y2026"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S402C-01-ROLLOVER-DAY-60-TIMELY" {
    given {
        context {
            legal_time @2026-03-02;
            decision_time @2026-03-02T09:00:00-05:00;
            knowledge_time @2026-03-02T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rollover_contribution_made(entity_ref("urn:test:s402c:c1#ee"), entity_ref("urn:test:s402c:c1#dist"), entity_ref("urn:test:s402c:c1#target"), @2026-03-02, 10000 USD) { origin case_input; }
        assert "f1": distribution(entity_ref("urn:test:s402c:c1#dist"), entity_ref("urn:test:s402c:c1#trustplan"), entity_ref("urn:test:s402c:c1#ee"), 10000 USD, @2026-01-01) { origin case_input; }
        assert "f2": frozen_deposit_period(entity_ref("urn:test:s402c:c1#dist"), 0) { origin case_input; }
    }
    // 2026 is not a leap year: Jan (31) + Feb (28) = 59 days to March 1; day 60 is March 2
    evaluate truth(rollover_timely(entity_ref("urn:test:s402c:c1#ee"), entity_ref("urn:test:s402c:c1#dist"), @2026-01-01, @2026-03-02, 0));
    expect truth_status == TRUE_ONLY;
}

test "S402C-02-ROLLOVER-DAY-61-UNTIMELY" {
    given {
        context {
            legal_time @2026-03-03;
            decision_time @2026-03-03T09:00:00-05:00;
            knowledge_time @2026-03-03T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": rollover_contribution_made(entity_ref("urn:test:s402c:c2#ee"), entity_ref("urn:test:s402c:c2#dist"), entity_ref("urn:test:s402c:c2#target"), @2026-03-03, 10000 USD) { origin case_input; }
        assert "f1": distribution(entity_ref("urn:test:s402c:c2#dist"), entity_ref("urn:test:s402c:c2#trustplan"), entity_ref("urn:test:s402c:c2#ee"), 10000 USD, @2026-01-01) { origin case_input; }
        assert "f2": frozen_deposit_period(entity_ref("urn:test:s402c:c2#dist"), 0) { origin case_input; }
    }
    evaluate truth(rollover_timely(entity_ref("urn:test:s402c:c2#ee"), entity_ref("urn:test:s402c:c2#dist"), @2026-01-01, @2026-03-03, 0));
    expect truth_status == NEITHER;
}

test "S402G-01-EXCESS-DEFERRAL-ABOVE-LIMIT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elective_deferral(entity_ref("urn:test:s402g:c1#ee"), entity_ref("urn:test:s402g:c1#plan"), entity_ref("urn:test:s402g:c1#y2024"), 16000 USD) { origin case_input; }
    }
    // statutory base limit $15,000; 16000 - 15000 = 1000
    evaluate truth(excess_deferral(entity_ref("urn:test:s402g:c1#ee"), entity_ref("urn:test:s402g:c1#y2024"), 1000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S402G-02-DEFERRAL-AT-LIMIT-NO-EXCESS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": elective_deferral(entity_ref("urn:test:s402g:c2#ee"), entity_ref("urn:test:s402g:c2#plan"), entity_ref("urn:test:s402g:c2#y2024"), 15000 USD) { origin case_input; }
    }
    evaluate truth(has_excess_deferral(entity_ref("urn:test:s402g:c2#ee"), entity_ref("urn:test:s402g:c2#y2024")));
    expect truth_status == NEITHER;
}

