test "S402F-01-WRITTEN-EXPLANATION-DUTY-SATISFIED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_administrator_of(entity_ref("urn:test:s402f:c1#plan"), entity_ref("urn:test:s402f:c1#admin")) { origin case_input; }
        assert "f1": eligible_rollover_distribution(entity_ref("urn:test:s402f:c1#dist")) { origin case_input; }
        assert "f2": distribution(entity_ref("urn:test:s402f:c1#dist"), entity_ref("urn:test:s402f:c1#plan"), entity_ref("urn:test:s402f:c1#recipient"), 10000 USD, @2026-01-01) { origin case_input; }
        assert "f3": written_rollover_explanation_provided(entity_ref("urn:test:s402f:c1#plan"), entity_ref("urn:test:s402f:c1#recipient"), entity_ref("urn:test:s402f:c1#dist")) { origin case_input; }
    }
    evaluate positions();
    expect position(Section402fWrittenExplanationDutyPosition, SATISFIED);
}

test "S402F-02-WRITTEN-EXPLANATION-DUTY-ACTIVE-WHEN-NOT-YET-PROVIDED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_administrator_of(entity_ref("urn:test:s402f:c2#plan"), entity_ref("urn:test:s402f:c2#admin")) { origin case_input; }
        assert "f1": eligible_rollover_distribution(entity_ref("urn:test:s402f:c2#dist")) { origin case_input; }
        assert "f2": distribution(entity_ref("urn:test:s402f:c2#dist"), entity_ref("urn:test:s402f:c2#plan"), entity_ref("urn:test:s402f:c2#recipient"), 10000 USD, @2026-01-01) { origin case_input; }
        // no explanation provided yet
    }
    evaluate positions();
    expect position(Section402fWrittenExplanationDutyPosition, ACTIVE);
}

test "S402H2-01-SEP-EXCESS-OVER-25-PERCENT-TREATED-AS-DISTRIBUTED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // 25% of 100,000 = 25,000; 415(c)(1)(A) limit = 40,000; lesser = 25,000; contributed 30,000 -> excess 5,000
        assert "f0": sep_employer_contribution(entity_ref("urn:test:s402h2:c1#er"), entity_ref("urn:test:s402h2:c1#ee"), entity_ref("urn:test:s402h2:c1#y2026"), 30000 USD) { origin case_input; }
        assert "f1": sep_compensation_includible(entity_ref("urn:test:s402h2:c1#ee"), entity_ref("urn:test:s402h2:c1#er"), entity_ref("urn:test:s402h2:c1#y2026"), 100000 USD) { origin case_input; }
        assert "f2": sep_415c1a_limit(entity_ref("urn:test:s402h2:c1#ee"), entity_ref("urn:test:s402h2:c1#y2026"), 40000 USD) { origin case_input; }
    }
    evaluate truth(sep_excess_contribution_treated_as_distributed(entity_ref("urn:test:s402h2:c1#ee"), entity_ref("urn:test:s402h2:c1#er"), entity_ref("urn:test:s402h2:c1#y2026"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S402L-01-PUBLIC-SAFETY-OFFICER-EXCLUSION-CAPPED-AT-3000" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": public_safety_officer_election_in_effect(entity_ref("urn:test:s402l:c1#officer"), entity_ref("urn:test:s402l:c1#y2026")) { origin case_input; }
        assert "f1": public_safety_officer_health_premiums_paid(entity_ref("urn:test:s402l:c1#officer"), entity_ref("urn:test:s402l:c1#y2026"), 4000 USD) { origin case_input; }
        assert "f2": public_safety_officer_distributions_for_year(entity_ref("urn:test:s402l:c1#officer"), entity_ref("urn:test:s402l:c1#y2026"), 4000 USD) { origin case_input; }
    }
    // premiums (4000) and distributions (4000) both exceed the $3,000 cap -> excluded = 3,000
    evaluate truth(public_safety_officer_premium_exclusion(entity_ref("urn:test:s402l:c1#officer"), entity_ref("urn:test:s402l:c1#y2026"), 3000 USD));
    expect truth_status == TRUE_ONLY;
}

