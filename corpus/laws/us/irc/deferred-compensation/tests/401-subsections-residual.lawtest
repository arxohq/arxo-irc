package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S401B1-01-CURE-ON-THE-RETURN-DUE-DATE-IS-TIMELY" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_failed_401a_from(entity_ref("urn:test:s401b1-01-cure-on-the-return-due-date-is-timely#plan"), @2024-01-01) { origin case_input; }
        assert "f1": plan_return_due_with_extensions(entity_ref("urn:test:s401b1-01-cure-on-the-return-due-date-is-timely#plan"), @2025-10-15) { origin case_input; }
        assert "f2": plan_cure_completed_on(entity_ref("urn:test:s401b1-01-cure-on-the-return-due-date-is-timely#plan"), @2025-10-15) { origin case_input; }
    }
    evaluate truth(plan_treated_as_satisfying_401a_retroactively(entity_ref("urn:test:s401b1-01-cure-on-the-return-due-date-is-timely#plan"), @2024-01-01, @2025-10-15));
    expect truth_status == TRUE_ONLY;
}

