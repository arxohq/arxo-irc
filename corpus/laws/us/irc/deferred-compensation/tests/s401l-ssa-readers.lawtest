language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S401L-SSA-01-PIA-PORTION-DERIVES" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": employer_derived_pia_replacement_rate_401l4c(entity_ref("urn:test:s401lssa:1#w"), 0.75) { origin case_input; }
    }
    evaluate truth(reduction_uses_employer_derived_pia_portion_401l4c(entity_ref("urn:test:s401lssa:1#w"), 0.75));
    expect truth_status == TRUE_ONLY;
}

