// Section 415 scenarios: DB/DC dollar limits binding vs not binding. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S415B-01-ANNUAL-BENEFIT-AT-DOLLAR-LIMIT-NOT-EXCEEDED" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annual_benefit(entity_ref("urn:test:s415b:c1#plan"), entity_ref("urn:test:s415b:c1#ee"), entity_ref("urn:test:s415b:c1#y2024"), 160000 USD) { origin case_input; }
        assert "f1": high_3_year_average_compensation(entity_ref("urn:test:s415b:c1#ee"), entity_ref("urn:test:s415b:c1#y2024"), 300000 USD) { origin case_input; }
    }
    evaluate truth(section415b_dollar_limit_exceeded(entity_ref("urn:test:s415b:c1#plan"), entity_ref("urn:test:s415b:c1#ee"), entity_ref("urn:test:s415b:c1#y2024")));
    expect truth_status == NEITHER;
}

test "S415B-02-ANNUAL-BENEFIT-ABOVE-DOLLAR-LIMIT-EXCEEDED" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annual_benefit(entity_ref("urn:test:s415b:c2#plan"), entity_ref("urn:test:s415b:c2#ee"), entity_ref("urn:test:s415b:c2#y2024"), 160000.01 USD) { origin case_input; }
        assert "f1": high_3_year_average_compensation(entity_ref("urn:test:s415b:c2#ee"), entity_ref("urn:test:s415b:c2#y2024"), 300000 USD) { origin case_input; }
    }
    evaluate truth(section415b_dollar_limit_exceeded(entity_ref("urn:test:s415b:c2#plan"), entity_ref("urn:test:s415b:c2#ee"), entity_ref("urn:test:s415b:c2#y2024")));
    expect truth_status == TRUE_ONLY;
}

test "S415B-03-COMPENSATION-LIMB-BINDS-BELOW-DOLLAR-LIMIT" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // compensation (100% of comp) is the BINDING (lower) limb here, not the $160,000 dollar limit
        assert "f0": annual_benefit(entity_ref("urn:test:s415b:c3#plan"), entity_ref("urn:test:s415b:c3#ee"), entity_ref("urn:test:s415b:c3#y2024"), 90000 USD) { origin case_input; }
        assert "f1": high_3_year_average_compensation(entity_ref("urn:test:s415b:c3#ee"), entity_ref("urn:test:s415b:c3#y2024"), 80000 USD) { origin case_input; }
    }
    evaluate truth(section415b_dollar_limit_exceeded(entity_ref("urn:test:s415b:c3#plan"), entity_ref("urn:test:s415b:c3#ee"), entity_ref("urn:test:s415b:c3#y2024")));
    expect truth_status == TRUE_ONLY;
}

test "S415C-01-ANNUAL-ADDITION-AT-DOLLAR-LIMIT-NOT-EXCEEDED" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annual_addition(entity_ref("urn:test:s415c:c1#plan"), entity_ref("urn:test:s415c:c1#ee"), entity_ref("urn:test:s415c:c1#y2024"), 40000 USD) { origin case_input; }
        assert "f1": participants_compensation_415c(entity_ref("urn:test:s415c:c1#ee"), entity_ref("urn:test:s415c:c1#y2024"), 200000 USD) { origin case_input; }
    }
    evaluate truth(section415c_dollar_limit_exceeded(entity_ref("urn:test:s415c:c1#plan"), entity_ref("urn:test:s415c:c1#ee"), entity_ref("urn:test:s415c:c1#y2024")));
    expect truth_status == NEITHER;
}

test "S415C-02-ANNUAL-ADDITION-ABOVE-DOLLAR-LIMIT-EXCEEDED" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
