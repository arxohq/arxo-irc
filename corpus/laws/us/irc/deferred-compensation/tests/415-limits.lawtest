        assert "f0": annual_addition(entity_ref("urn:test:s415c:c2#plan"), entity_ref("urn:test:s415c:c2#ee"), entity_ref("urn:test:s415c:c2#y2024"), 40000.01 USD) { origin case_input; }
        assert "f1": participants_compensation_415c(entity_ref("urn:test:s415c:c2#ee"), entity_ref("urn:test:s415c:c2#y2024"), 200000 USD) { origin case_input; }
    }
    evaluate truth(section415c_dollar_limit_exceeded(entity_ref("urn:test:s415c:c2#plan"), entity_ref("urn:test:s415c:c2#ee"), entity_ref("urn:test:s415c:c2#y2024")));
    expect truth_status == TRUE_ONLY;
}

// =====================================================================
// STAGE 2b (25.09.2026): (b)(4)/(5)/(11), (c)(2) scenarios.
// =====================================================================

test "S415B4-01-DEMINIMIS-FLOOR-AT-EXACTLY-10000-DEEMED-COMPLIANT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participant_db_benefits_from_employer(entity_ref("urn:test:s415b4:c1#plan"), entity_ref("urn:test:s415b4:c1#ee"), entity_ref("urn:test:s415b4:c1#y2026"), 10000 USD) { origin case_input; }
        assert "f1": employer_never_maintained_dc_plan_for_participant(entity_ref("urn:test:s415b4:c1#plan"), entity_ref("urn:test:s415b4:c1#ee")) { origin case_input; }
    }
    evaluate truth(section415b_deemed_not_exceeded_10000_floor(entity_ref("urn:test:s415b4:c1#plan"), entity_ref("urn:test:s415b4:c1#ee"), entity_ref("urn:test:s415b4:c1#y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S415B4-02-DEMINIMIS-FLOOR-FAILS-ABOVE-10000" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participant_db_benefits_from_employer(entity_ref("urn:test:s415b4:c2#plan"), entity_ref("urn:test:s415b4:c2#ee"), entity_ref("urn:test:s415b4:c2#y2026"), 10000.01 USD) { origin case_input; }
        assert "f1": employer_never_maintained_dc_plan_for_participant(entity_ref("urn:test:s415b4:c2#plan"), entity_ref("urn:test:s415b4:c2#ee")) { origin case_input; }
    }
    evaluate truth(section415b_deemed_not_exceeded_10000_floor(entity_ref("urn:test:s415b4:c2#plan"), entity_ref("urn:test:s415b4:c2#ee"), entity_ref("urn:test:s415b4:c2#y2026")));
    expect truth_status == NEITHER;
}

test "S415B5-01-PRORATED-LIMIT-AT-5-OF-10-YEARS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // 5/10 of $160,000 = $80,000; floor is $16,000 -> max(80000,16000)=80000
        assert "f0": years_of_participation_db(entity_ref("urn:test:s415b5:c1#ee"), entity_ref("urn:test:s415b5:c1#plan"), entity_ref("urn:test:s415b5:c1#y2026"), 5.0) { origin case_input; }
    }
    evaluate truth(section415b_dollar_limit_prorated(entity_ref("urn:test:s415b5:c1#ee"), entity_ref("urn:test:s415b5:c1#plan"), entity_ref("urn:test:s415b5:c1#y2026"), 80000 USD));
    expect truth_status == TRUE_ONLY;
}

