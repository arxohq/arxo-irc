}

test "S415C2-01-ANNUAL-ADDITION-EXACT-SUM" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employer_contribution_annual_addition(entity_ref("urn:test:s415c2:c1#plan"), entity_ref("urn:test:s415c2:c1#ee"), entity_ref("urn:test:s415c2:c1#y2026"), 15000 USD) { origin case_input; }
        assert "f1": employee_contribution_annual_addition(entity_ref("urn:test:s415c2:c1#plan"), entity_ref("urn:test:s415c2:c1#ee"), entity_ref("urn:test:s415c2:c1#y2026"), 10000 USD) { origin case_input; }
        assert "f2": forfeitures_annual_addition(entity_ref("urn:test:s415c2:c1#plan"), entity_ref("urn:test:s415c2:c1#ee"), entity_ref("urn:test:s415c2:c1#y2026"), 2000 USD) { origin case_input; }
    }
    evaluate truth(annual_addition_computed(entity_ref("urn:test:s415c2:c1#plan"), entity_ref("urn:test:s415c2:c1#ee"), entity_ref("urn:test:s415c2:c1#y2026"), 27000 USD));
    expect truth_status == TRUE_ONLY;
}
