        assert "f2": maximum_annual_elective_contribution_403b16D(entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#plan"), 6000 USD) { origin case_input; }
        assert "f3": meets_401k13E_notice_and_other_403b16(entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#plan")) { origin case_input; }
        assert "f4": plan_sponsor(entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#plan"), entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#er")) { origin adjudicated; }
    }
    evaluate truth(safe_harbor_plan_treated_as_meeting_403b12_403b16(entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#plan"), entity_ref("urn:test:s403b16a-01-safe-harbor-plan-of-an-eligible-employer-meets-paragraph-12#er")));
    expect truth_status == TRUE_ONLY;
}

