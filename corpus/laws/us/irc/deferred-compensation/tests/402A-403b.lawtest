// Section 402A / 403(b) scenarios. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S402A-01-DESIGNATED-ROTH-CONTRIBUTION-VALID-ELECTION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qualified_roth_contribution_program(entity_ref("urn:test:s402a2:c1#plan")) { origin case_input; }
        assert "f1": roth_election_made(entity_ref("urn:test:s402a2:c1#ee"), entity_ref("urn:test:s402a2:c1#plan"), entity_ref("urn:test:s402a2:c1#y2026"), 5000 USD) { origin case_input; }
    }
    evaluate truth(designated_roth_contribution(entity_ref("urn:test:s402a2:c1#ee"), entity_ref("urn:test:s402a2:c1#plan"), entity_ref("urn:test:s402a2:c1#y2026"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S402A-02-NO-DESIGNATED-ROTH-WITHOUT-PROGRAM" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": roth_election_made(entity_ref("urn:test:s402a2:c2#ee"), entity_ref("urn:test:s402a2:c2#plan"), entity_ref("urn:test:s402a2:c2#y2026"), 5000 USD) { origin case_input; }
    }
    // no qualified_roth_contribution_program asserted -> undetermined, not a designated Roth contribution
    evaluate truth(designated_roth_contribution(entity_ref("urn:test:s402a2:c2#ee"), entity_ref("urn:test:s402a2:c2#plan"), entity_ref("urn:test:s402a2:c2#y2026"), 5000 USD));
    expect truth_status == NEITHER;
}
