test "S408P2-01-SIMPLE-MATCHING-CONTRIBUTION-CAPPED-AT-3-PERCENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": simple_elective_contribution_amount(entity_ref("urn:test:s408p2:c1#ee"), entity_ref("urn:test:s408p2:c1#er"), entity_ref("urn:test:s408p2:c1#y2026"), 5000 USD) { origin case_input; }
        assert "f1": simple_employee_compensation(entity_ref("urn:test:s408p2:c1#ee"), entity_ref("urn:test:s408p2:c1#er"), entity_ref("urn:test:s408p2:c1#y2026"), 100000 USD) { origin case_input; }
        assert "f2": simple_applicable_percentage(entity_ref("urn:test:s408p2:c1#er"), entity_ref("urn:test:s408p2:c1#y2026"), 0.03) { origin case_input; }
    }
    // 3% of 100,000 = 3,000; elective (5,000) exceeds it, so match is capped at 3,000
    evaluate truth(simple_matching_contribution_required(entity_ref("urn:test:s408p2:c1#ee"), entity_ref("urn:test:s408p2:c1#er"), entity_ref("urn:test:s408p2:c1#y2026"), 3000 USD));
    expect truth_status == TRUE_ONLY;
}

