// Section 408 scenarios: IRA requirements, distributions, 60-day rollover,
// once-per-12-months limitation. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S408A-01-NONFORFEITABILITY-HOLDS-ABSENT-FORFEITURE-CLAUSE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ira_established_for(entity_ref("urn:test:s408a:c1#ira"), entity_ref("urn:test:s408a:c1#who")) { origin case_input; }
    }
    evaluate truth(meets_408a4_nonforfeitability(entity_ref("urn:test:s408a:c1#ira"), entity_ref("urn:test:s408a:c1#who")));
    expect truth_status == TRUE_ONLY;
}

