// Deferred-compensation WIRE-10 group B scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "W10B-DC-01-CHURCH-PLAN-DERIVES-THE-SECTION-9802F-STUB" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_of_group_health_plan(entity_ref("urn:test:w10b:g1#h"), entity_ref("urn:test:w10b:g1#p")) { origin case_input; }
        assert "f1": church_plan_414e(entity_ref("urn:test:w10b:g1#p")) { origin case_input; }
    }
    evaluate truth(us.irc.group_health::church_plan(entity_ref("urn:test:w10b:g1#h")));
    expect truth_status == TRUE_ONLY;
}

test "W10B-DC-02-NON-CHURCH-PLAN-IS-NOT-DERIVED" {
    given {
        context {
            legal_time @2024-12-31;
            decision_time @2024-12-31T09:00:00-05:00;
            knowledge_time @2024-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_of_group_health_plan(entity_ref("urn:test:w10b:g2#h"), entity_ref("urn:test:w10b:g2#p")) { origin case_input; }
    }
    evaluate truth(us.irc.group_health::church_plan(entity_ref("urn:test:w10b:g2#h")));
    expect truth_status == NEITHER;
}
