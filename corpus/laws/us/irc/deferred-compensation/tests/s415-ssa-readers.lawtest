// Section 415 SSA readers (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with the case-selected SSA content fact the
// section 415(b)(8)/(d)(2) consequent derives (TRUE_ONLY); without it
// nothing derives (NEITHER). Expectations come from the statutory text;
// the SSA values themselves enter as case facts (phase 0 source package
// `us.ssa.title42_values`, pinned govinfo bytes). NOT EXECUTED
// (implemented_unverified; execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S415-SSA-01-SSRA-DERIVES" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": ssra_value_as_applied_415b8(entity_ref("urn:test:s415ssa:1#p"), 67) { origin case_input; }
    }
    evaluate truth(social_security_retirement_age_415b8(entity_ref("urn:test:s415ssa:1#p"), 67));
    expect truth_status == TRUE_ONLY;
}

test "S415-SSA-02-WITHOUT-SSRA-NEITHER" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(social_security_retirement_age_415b8(entity_ref("urn:test:s415ssa:2#p"), 67));
    expect truth_status == NEITHER;
}

test "S415-SSA-03-215I2A-PROCEDURE-DERIVES" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": index_adjustment_follows_ssa_215i2A_procedure_415d2(entity_ref("urn:test:s415ssa:3#y"), 40000 USD, 46000 USD) { origin case_input; }
    }
    evaluate truth(section415d2_ssa_procedure_adjustment(entity_ref("urn:test:s415ssa:3#y"), 40000 USD, 46000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S415-SSA-04-WITHOUT-PROCEDURE-NEITHER" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(section415d2_ssa_procedure_adjustment(entity_ref("urn:test:s415ssa:4#y"), 40000 USD, 46000 USD));
    expect truth_status == NEITHER;
}
