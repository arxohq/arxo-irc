// Section 417 scenarios: QJSA band test, waiver power valid/invalid exercise
// (spousal consent). NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S417B-01-QJSA-AT-50-PERCENT-SURVIVOR-VALID" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qjsa_survivor_percentage(entity_ref("urn:test:s417b:c1#plan"), entity_ref("urn:test:s417b:c1#pp"), 0.50) { origin case_input; }
    }
    evaluate truth(is_qualified_joint_and_survivor_annuity(entity_ref("urn:test:s417b:c1#plan"), entity_ref("urn:test:s417b:c1#pp")));
    expect truth_status == TRUE_ONLY;
}

test "S417B-02-QJSA-BELOW-50-PERCENT-NOT-QUALIFIED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": qjsa_survivor_percentage(entity_ref("urn:test:s417b:c2#plan"), entity_ref("urn:test:s417b:c2#pp"), 0.40) { origin case_input; }
    }
    evaluate truth(is_qualified_joint_and_survivor_annuity(entity_ref("urn:test:s417b:c2#plan"), entity_ref("urn:test:s417b:c2#pp")));
    expect truth_status == NEITHER;
}

test "S417A-01-WAIVER-VALID-WITH-SPOUSAL-CONSENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participates_in(entity_ref("urn:test:s417a:c1#pp"), entity_ref("urn:test:s417a:c1#plan")) { origin case_input; }
        assert "f1": waiver_elected(entity_ref("urn:test:s417a:c1#pp"), entity_ref("urn:test:s417a:c1#plan"), @2026-01-01) { origin case_input; }
        assert "f2": spousal_consent_in_writing_witnessed(entity_ref("urn:test:s417a:c1#pp"), entity_ref("urn:test:s417a:c1#plan")) { origin case_input; }
    }
    evaluate positions();
    expect position(WaiveSurvivorAnnuity, ACTIVE);

    evaluate truth(qjsa_waived(entity_ref("urn:test:s417a:c1#pp"), entity_ref("urn:test:s417a:c1#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S417A-02-WAIVER-INVALID-WITHOUT-SPOUSAL-CONSENT-NO-EFFECT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participates_in(entity_ref("urn:test:s417a:c2#pp"), entity_ref("urn:test:s417a:c2#plan")) { origin case_input; }
        assert "f1": waiver_elected(entity_ref("urn:test:s417a:c2#pp"), entity_ref("urn:test:s417a:c2#plan"), @2026-01-01) { origin case_input; }
        // no spousal consent and no excusing circumstance asserted -> the power remains
        // ACTIVE (§127: valid_when is checked at exercise, not at position creation),
        // but the effect (qjsa_waived) does not take place (E-0239, POWER_INVALID_EXERCISE)
    }
    evaluate positions();
    expect position(WaiveSurvivorAnnuity, ACTIVE);

    evaluate truth(qjsa_waived(entity_ref("urn:test:s417a:c2#pp"), entity_ref("urn:test:s417a:c2#plan")));
    expect truth_status == NEITHER;
}

test "S417A-03-CONSENT-EXCUSED-NO-SPOUSE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": no_spouse_or_spouse_cannot_be_located(entity_ref("urn:test:s417a:c3#pp"), entity_ref("urn:test:s417a:c3#plan")) { origin case_input; }
    }
    evaluate truth(spousal_consent_satisfied(entity_ref("urn:test:s417a:c3#pp"), entity_ref("urn:test:s417a:c3#plan")));
    expect truth_status == TRUE_ONLY;
}
