// Section 414 scenarios: HCE threshold and 5-percent-owner branch, catch-up
// contribution limit. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S414Q-01-HCE-VIA-FIVE-PERCENT-OWNER" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": five_percent_owner_416i1(entity_ref("urn:test:s414q:c1#ee"), entity_ref("urn:test:s414q:c1#er"), entity_ref("urn:test:s414q:c1#y2026")) { origin case_input; }
    }
    evaluate truth(highly_compensated_employee(entity_ref("urn:test:s414q:c1#ee"), entity_ref("urn:test:s414q:c1#er"), entity_ref("urn:test:s414q:c1#y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S414Q-02-HCE-VIA-COMPENSATION-NO-TOP-PAID-ELECTION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": compensation_from_employer_preceding_year(entity_ref("urn:test:s414q:c2#ee"), entity_ref("urn:test:s414q:c2#er"), entity_ref("urn:test:s414q:c2#y2026"), 90000 USD) { origin case_input; }
    }
    // above statutory base $80,000, no top-paid-group election -> HCE
    evaluate truth(highly_compensated_employee(entity_ref("urn:test:s414q:c2#ee"), entity_ref("urn:test:s414q:c2#er"), entity_ref("urn:test:s414q:c2#y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S414Q-03-COMPENSATION-AT-THRESHOLD-NOT-HCE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": compensation_from_employer_preceding_year(entity_ref("urn:test:s414q:c3#ee"), entity_ref("urn:test:s414q:c3#er"), entity_ref("urn:test:s414q:c3#y2026"), 80000 USD) { origin case_input; }
    }
    // exactly at the $80,000 threshold: statute requires "in excess of" -> not HCE via this branch
    evaluate truth(highly_compensated_employee(entity_ref("urn:test:s414q:c3#ee"), entity_ref("urn:test:s414q:c3#er"), entity_ref("urn:test:s414q:c3#y2026")));
    expect truth_status == NEITHER;
}

test "S414V-01-CATCH-UP-WITHIN-STATUTORY-BASE-LIMIT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": eligible_catch_up_participant(entity_ref("urn:test:s414v:c1#ee"), entity_ref("urn:test:s414v:c1#y2026")) { origin case_input; }
        assert "f1": catch_up_contribution_elected(entity_ref("urn:test:s414v:c1#ee"), entity_ref("urn:test:s414v:c1#plan"), entity_ref("urn:test:s414v:c1#y2026"), 5000 USD) { origin case_input; }
    }
    evaluate truth(catch_up_contribution_within_limit(entity_ref("urn:test:s414v:c1#ee"), entity_ref("urn:test:s414v:c1#plan"), entity_ref("urn:test:s414v:c1#y2026"), 5000 USD));
    expect truth_status == TRUE_ONLY;
}

// =====================================================================
// STAGE 2 (25.09.2026): (p) qualified domestic relations order — power
// with validity conditions.
// =====================================================================

test "S414P-01-QDRO-VALIDLY-RECOGNIZED-ALL-CONDITIONS-MET" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": domestic_relations_order_of(entity_ref("urn:test:s414p:c1#order"), entity_ref("urn:test:s414p:c1#participant"), entity_ref("urn:test:s414p:c1#altpayee")) { origin case_input; }
        assert "f1": domestic_relations_order_relates_to_marital_matter(entity_ref("urn:test:s414p:c1#order")) { origin case_input; }
        assert "f2": order_specifies_required_facts(entity_ref("urn:test:s414p:c1#order")) { origin case_input; }
        assert "f3": order_does_not_alter_plan_benefits(entity_ref("urn:test:s414p:c1#order")) { origin case_input; }
    }
    evaluate positions();
    expect position(QdroRecognitionPower, VALIDLY_EXERCISED);
}

test "S414P-02-QDRO-INVALID-EXERCISE-MISSING-REQUIRED-FACTS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": domestic_relations_order_of(entity_ref("urn:test:s414p:c2#order"), entity_ref("urn:test:s414p:c2#participant"), entity_ref("urn:test:s414p:c2#altpayee")) { origin case_input; }
        assert "f1": domestic_relations_order_relates_to_marital_matter(entity_ref("urn:test:s414p:c2#order")) { origin case_input; }
        // order does NOT specify the required (2)(A)-(D) facts -> not eligible to be recognized
        assert "f2": order_does_not_alter_plan_benefits(entity_ref("urn:test:s414p:c2#order")) { origin case_input; }
    }
    evaluate positions();
    expect position(QdroRecognitionPower, INVALIDLY_EXERCISED);
}

test "S414P-03-QDRO-RECOGNIZED-ALTERNATE-PAYEE-TREATED-AS-DISTRIBUTEE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": domestic_relations_order_of(entity_ref("urn:test:s414p:c3#order"), entity_ref("urn:test:s414p:c3#participant"), entity_ref("urn:test:s414p:c3#altpayee")) { origin case_input; }
        assert "f1": domestic_relations_order_relates_to_marital_matter(entity_ref("urn:test:s414p:c3#order")) { origin case_input; }
        assert "f2": order_specifies_required_facts(entity_ref("urn:test:s414p:c3#order")) { origin case_input; }
        assert "f3": order_does_not_alter_plan_benefits(entity_ref("urn:test:s414p:c3#order")) { origin case_input; }
    }
    evaluate truth(qdro_alternate_payee_treated_as_distributee(entity_ref("urn:test:s414p:c3#order"), entity_ref("urn:test:s414p:c3#altpayee")));
    expect truth_status == TRUE_ONLY;
}
