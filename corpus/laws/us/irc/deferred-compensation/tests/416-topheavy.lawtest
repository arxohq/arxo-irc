// Section 416 scenarios: 60% top-heavy test boundary, 3% minimum contribution. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S416G-01-DC-TOP-HEAVY-AT-EXACTLY-60-PERCENT-NOT-TOP-HEAVY" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": key_employee_account_total(entity_ref("urn:test:s416g:c1#plan"), entity_ref("urn:test:s416g:c1#y2026"), 60000 USD) { origin case_input; }
        assert "f1": all_employees_account_total(entity_ref("urn:test:s416g:c1#plan"), entity_ref("urn:test:s416g:c1#y2026"), 100000 USD) { origin case_input; }
    }
    // exactly 60% -> the statute requires the key-employee share to EXCEED 60% -> not top-heavy
    evaluate truth(top_heavy_plan_dc(entity_ref("urn:test:s416g:c1#plan"), entity_ref("urn:test:s416g:c1#y2026")));
    expect truth_status == NEITHER;
}

test "S416G-02-DC-TOP-HEAVY-ABOVE-60-PERCENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": key_employee_account_total(entity_ref("urn:test:s416g:c2#plan"), entity_ref("urn:test:s416g:c2#y2026"), 60000.01 USD) { origin case_input; }
        assert "f1": all_employees_account_total(entity_ref("urn:test:s416g:c2#plan"), entity_ref("urn:test:s416g:c2#y2026"), 100000 USD) { origin case_input; }
    }
    evaluate truth(top_heavy_plan_dc(entity_ref("urn:test:s416g:c2#plan"), entity_ref("urn:test:s416g:c2#y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S416C-01-MINIMUM-CONTRIBUTION-THREE-PERCENT-SATISFIED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": participates_in(entity_ref("urn:test:s416c:c1#ee"), entity_ref("urn:test:s416c:c1#plan")) { origin case_input; }
        assert "f1": nonkey_employee_compensation_415(entity_ref("urn:test:s416c:c1#ee"), entity_ref("urn:test:s416c:c1#y2026"), 50000 USD) { origin case_input; }
        assert "f2": employer_contribution_for_nonkey_employee(entity_ref("urn:test:s416c:c1#plan"), entity_ref("urn:test:s416c:c1#ee"), entity_ref("urn:test:s416c:c1#y2026"), 1500 USD) { origin case_input; }
    }
    // 3% of 50,000 = 1,500
    evaluate truth(minimum_contribution_satisfied(entity_ref("urn:test:s416c:c1#plan"), entity_ref("urn:test:s416c:c1#ee"), entity_ref("urn:test:s416c:c1#y2026")));
    expect truth_status == TRUE_ONLY;
}
