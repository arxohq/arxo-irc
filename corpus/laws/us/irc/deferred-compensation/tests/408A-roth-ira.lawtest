// Section 408A scenarios: MAGI phase-out, 5-year rule at 4y364d vs 5y+1d,
// qualified distribution grounds. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S408AC-01-JOINT-MAGI-BELOW-PHASEOUT-NO-REDUCTION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": section219_deduction_amount(entity_ref("urn:test:s408ac:c1#who"), entity_ref("urn:test:s408ac:c1#y2026"), 7000 USD) { origin case_input; }
        assert "f1": contributions_to_other_iras(entity_ref("urn:test:s408ac:c1#who"), entity_ref("urn:test:s408ac:c1#y2026"), 0 USD) { origin case_input; }
    }
    evaluate truth(section408Ac2_base_limit(entity_ref("urn:test:s408ac:c1#who"), entity_ref("urn:test:s408ac:c1#y2026"), 7000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S408AD-01-FIVE-YEAR-PERIOD-NOT-SATISFIED-AT-4Y364D" {
    given {
        context {
            legal_time @2029-12-31;
            decision_time @2029-12-31T09:00:00-05:00;
            knowledge_time @2029-12-31T09:00:00-05:00;
            timezone "America/New_York";
        }
        // first contribution year 2025 -> 5-taxable-year period ends 2029-12-31; a distribution
        // ON that end date (4 years 364 days into the window since Jan 1 2025) is NOT "after" it
        assert "f0": nonexclusion_period_end(entity_ref("urn:test:s408ad:c1#who"), 2025, @2029-12-31) { origin case_input; }
    }
    evaluate truth(five_year_period_satisfied(entity_ref("urn:test:s408ad:c1#who"), @2029-12-31, 2025));
    expect truth_status == NEITHER;
}

test "S408AD-02-FIVE-YEAR-PERIOD-SATISFIED-DAY-AFTER" {
    given {
        context {
            legal_time @2030-01-01;
            decision_time @2030-01-01T09:00:00-05:00;
            knowledge_time @2030-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nonexclusion_period_end(entity_ref("urn:test:s408ad:c2#who"), 2025, @2029-12-31) { origin case_input; }
    }
    evaluate truth(five_year_period_satisfied(entity_ref("urn:test:s408ad:c2#who"), @2030-01-01, 2025));
    expect truth_status == TRUE_ONLY;
}

test "S408AD-03-QUALIFIED-DISTRIBUTION-AGE-59-HALF" {
    given {
        context {
            legal_time @2030-06-01;
            decision_time @2030-06-01T09:00:00-05:00;
            knowledge_time @2030-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": roth_ira_distribution(entity_ref("urn:test:s408ad:c3#dist"), entity_ref("urn:test:s408ad:c3#roth"), entity_ref("urn:test:s408ad:c3#who"), @2030-06-01) { origin case_input; }
        assert "f1": nonexclusion_period_end(entity_ref("urn:test:s408ad:c3#who"), 2020, @2024-12-31) { origin case_input; }
        assert "f2": age_59_and_half_or_older(entity_ref("urn:test:s408ad:c3#who"), @2030-06-01) { origin case_input; }
    }
    evaluate truth(roth_qualified_distribution(entity_ref("urn:test:s408ad:c3#dist"), entity_ref("urn:test:s408ad:c3#roth"), entity_ref("urn:test:s408ad:c3#who"), @2030-06-01));
    expect truth_status == TRUE_ONLY;
}

// =====================================================================
// STAGE 2b (25.09.2026): (c)(1)/(4)/(5), (d)(1), (e) scenarios.
// =====================================================================

test "S408AC1-01-ROTH-CONTRIBUTION-NOT-DEDUCTIBLE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": roth_ira_contribution(entity_ref("urn:test:s408ac1:c1#roth"), entity_ref("urn:test:s408ac1:c1#who"), entity_ref("urn:test:s408ac1:c1#y2026"), 7000 USD) { origin case_input; }
    }
    evaluate truth(roth_contribution_not_deductible(entity_ref("urn:test:s408ac1:c1#roth"), entity_ref("urn:test:s408ac1:c1#who"), entity_ref("urn:test:s408ac1:c1#y2026"), 7000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S408AC4-01-NO-LIFETIME-RMD-FOR-ROTH-IRA" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": roth_ira_established_for(entity_ref("urn:test:s408ac4:c1#roth"), entity_ref("urn:test:s408ac4:c1#who")) { origin case_input; }
    }
    evaluate truth(roth_401a9a_inapplicable_before_death(entity_ref("urn:test:s408ac4:c1#roth"), entity_ref("urn:test:s408ac4:c1#who")));
    expect truth_status == TRUE_ONLY;
}

test "S408AD1-01-QUALIFIED-DISTRIBUTION-EXCLUDED-FROM-GROSS-INCOME" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": roth_ira_contribution_first_year(entity_ref("urn:test:s408ad1:c1#who"), 2019) { origin case_input; }
        assert "f1": roth_ira_distribution(entity_ref("urn:test:s408ad1:c1#dist"), entity_ref("urn:test:s408ad1:c1#roth"), entity_ref("urn:test:s408ad1:c1#who"), @2026-01-01) { origin case_input; }
        assert "f2": nonexclusion_period_end(entity_ref("urn:test:s408ad1:c1#who"), 2019, @2024-12-31) { origin case_input; }
        assert "f3": age_59_and_half_or_older(entity_ref("urn:test:s408ad1:c1#who"), @2026-01-01) { origin case_input; }
        assert "f4": ira_distribution(entity_ref("urn:test:s408ad1:c1#dist"), entity_ref("urn:test:s408ad1:c1#roth"), entity_ref("urn:test:s408ad1:c1#who"), 20000 USD, @2026-01-01) { origin case_input; }
    }
    evaluate truth(roth_qualified_distribution_excluded_from_gross_income(entity_ref("urn:test:s408ad1:c1#dist"), entity_ref("urn:test:s408ad1:c1#roth"), entity_ref("urn:test:s408ad1:c1#who"), entity_ref("urn:test:s408ad1:c1#y2026"), 20000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S408AE-01-QUALIFIED-ROLLOVER-CONTRIBUTION-ROTH-TO-ROTH" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": ira_rollover_contribution_made(entity_ref("urn:test:s408ae:c1#who"), entity_ref("urn:test:s408ae:c1#dist"), entity_ref("urn:test:s408ae:c1#targetroth"), @2026-02-01, 5000 USD) { origin case_input; }
        assert "f1": ira_distribution(entity_ref("urn:test:s408ae:c1#dist"), entity_ref("urn:test:s408ae:c1#sourceroth"), entity_ref("urn:test:s408ae:c1#who"), 5000 USD, @2026-01-15) { origin case_input; }
        assert "f2": ira_rollover_valid(entity_ref("urn:test:s408ae:c1#who"), entity_ref("urn:test:s408ae:c1#dist"), @2026-02-01) { origin case_input; }
    }
    evaluate truth(qualified_rollover_contribution(entity_ref("urn:test:s408ae:c1#who"), entity_ref("urn:test:s408ae:c1#sourceroth"), entity_ref("urn:test:s408ae:c1#targetroth"), @2026-02-01, 5000 USD));
    expect truth_status == TRUE_ONLY;
}
