        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": service_credit_recognized_by_plan(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c")) { origin case_input; }
        assert "f1": service_credit_not_yet_received(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c")) { origin case_input; }
        assert "f2": service_credit_only_by_voluntary_contribution(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c")) { origin case_input; }
        assert "f3": service_credit_kind(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c"), OtherService) { origin case_input; }
        assert "f4": years_of_participation_when_credit_counted(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#p"), entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#plan"), entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c"), 1.0) { origin case_input; }
        assert "f5": trustee_transfer_403b13_or_457e17(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#c")) { origin case_input; }
    }
    evaluate truth(plan_fails_415n3B(entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#plan"), entity_ref("urn:test:s415n3d-01-trustee-transfer-outside-the-5-year-rule#p")));
    expect truth_status == NEITHER;
}

test "S415N1-01-BENEFIT-PLUS-CREDIT-BENEFIT-WITHIN-LIMIT" {
    given {
        context {
            legal_time @2024-06-01;
            decision_time @2024-06-01T09:00:00-05:00;
            knowledge_time @2024-06-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": contributions_to_purchase_credit(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 9000 USD) { origin case_input; }
        assert "f1": accrued_benefit_from_credit_contributions(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 20000 USD) { origin case_input; }
        assert "f2": high_3_year_average_compensation(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 300000 USD) { origin case_input; }
        assert "f3": years_of_participation_db(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 12.0) { origin case_input; }
        assert "f4": years_of_service_with_employer(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 12.0) { origin case_input; }
        assert "f5": annual_benefit(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y"), 100000 USD) { origin case_input; }
    }
    evaluate truth(section415_met_with_permissive_credit(entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#plan"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#p"), entity_ref("urn:test:s415n1-01-benefit-plus-credit-benefit-within-limit#y")));
    expect truth_status == TRUE_ONLY;
}

