            timezone "America/New_York";
        }
        assert "f0": separation_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2024) { origin case_input; }
        assert "f1": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2019, 90000 USD) { origin case_input; }
        assert "f2": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2020, 60000 USD) { origin case_input; }
        assert "f3": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2021, 62000 USD) { origin case_input; }
        assert "f4": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2022, 65000 USD) { origin case_input; }
        assert "f5": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2023, 64000 USD) { origin case_input; }
        assert "f6": compensation_414q4_for_calendar_year(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 2024, 70000 USD) { origin case_input; }
    }
    evaluate truth(final_pay(entity_ref("urn:test:s401a5d-01-final-pay-ignores-the-year-before-the-5-year-window#p"), 70000 USD));
    expect truth_status == TRUE_ONLY;
}

