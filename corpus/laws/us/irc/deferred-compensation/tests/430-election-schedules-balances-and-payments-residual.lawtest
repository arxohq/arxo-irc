test "S430C2B-01-THE-ANNUAL-INSTALLMENT-APPLIES-TO-EACH-YEAR" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annual_installment_for_base_430c2A(entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#p"), entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#y1"), 1000.00 USD) { origin case_input; }
        assert "f1": plan_year_within_amortization_period_430c2B(entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#p"), entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#y1"), entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#y2")) { origin case_input; }
    }
    evaluate truth(shortfall_amortization_installment_for_year_430c2B(entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#p"), entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#y1"), entity_ref("urn:test:s430c2b-01-the-annual-installment-applies-to-each-year#y2"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
}

