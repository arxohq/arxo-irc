        assert "f1": years_of_plan_participation(entity_ref("urn:test:s411b1a:c2#ee"), entity_ref("urn:test:s411b1a:c2#plan"), 10.0) { origin case_input; }
        assert "f2": accrued_benefit_at_separation(entity_ref("urn:test:s411b1a:c2#ee"), entity_ref("urn:test:s411b1a:c2#plan"), 29999.99 USD) { origin case_input; }
    }
    evaluate truth(accrual_3pct_method_satisfied(entity_ref("urn:test:s411b1a:c2#ee"), entity_ref("urn:test:s411b1a:c2#plan")));
