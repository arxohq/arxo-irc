test "S411B1C-01-FRACTIONAL-RULE-SATISFIED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // fraction = 10/20 = 0.5; projected = 100,000 -> required = 50,000
        assert "f0": projected_normal_retirement_benefit(entity_ref("urn:test:s411b1c:c1#ee"), entity_ref("urn:test:s411b1c:c1#plan"), 100000 USD) { origin case_input; }
        assert "f1": years_of_plan_participation(entity_ref("urn:test:s411b1c:c1#ee"), entity_ref("urn:test:s411b1c:c1#plan"), 10.0) { origin case_input; }
        assert "f2": years_would_have_participated_to_nra(entity_ref("urn:test:s411b1c:c1#ee"), entity_ref("urn:test:s411b1c:c1#plan"), 20.0) { origin case_input; }
        assert "f3": accrued_benefit_at_separation(entity_ref("urn:test:s411b1c:c1#ee"), entity_ref("urn:test:s411b1c:c1#plan"), 50000 USD) { origin case_input; }
    }
    evaluate truth(accrual_fractional_rule_satisfied(entity_ref("urn:test:s411b1c:c1#ee"), entity_ref("urn:test:s411b1c:c1#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S411C2A-01-ACCRUED-BENEFIT-FROM-EMPLOYEE-CONTRIBUTIONS-RATIO" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // ee = 20,000; er = 80,000; total accrued = 100,000 -> employee-derived = 100,000 x 20/100 = 20,000
        assert "f0": total_accrued_benefit(entity_ref("urn:test:s411c2a:c1#ee"), entity_ref("urn:test:s411c2a:c1#plan"), 100000 USD) { origin case_input; }
        assert "f1": employee_contributions_less_withdrawals(entity_ref("urn:test:s411c2a:c1#ee"), entity_ref("urn:test:s411c2a:c1#plan"), 20000 USD) { origin case_input; }
        assert "f2": employer_contributions_less_withdrawals(entity_ref("urn:test:s411c2a:c1#ee"), entity_ref("urn:test:s411c2a:c1#plan"), 80000 USD) { origin case_input; }
        // no separate account maintained
    }
    evaluate truth(accrued_benefit_from_employee_contributions_no_separate_account(entity_ref("urn:test:s411c2a:c1#ee"), entity_ref("urn:test:s411c2a:c1#plan"), 20000 USD));
    expect truth_status == TRUE_ONLY;
}
