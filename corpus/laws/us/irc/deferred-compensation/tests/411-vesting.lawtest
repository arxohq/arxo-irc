// Section 411 scenarios: vesting at 2/3 year cliff boundaries, anti-cutback
// immunity. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S411A-01-DC-THREE-YEAR-CLIFF-AT-EXACTLY-3-YEARS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employee_years_of_service_411(entity_ref("urn:test:s411a:c1#ee"), entity_ref("urn:test:s411a:c1#dcplan"), 3) { origin case_input; }
    }
    evaluate truth(nonforfeitable_percentage(entity_ref("urn:test:s411a:c1#ee"), entity_ref("urn:test:s411a:c1#dcplan"), 1.00));
    expect truth_status == TRUE_ONLY;
}

test "S411A-02-DC-BELOW-THREE-YEARS-NOT-100-PERCENT-VIA-CLIFF" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employee_years_of_service_411(entity_ref("urn:test:s411a:c2#ee"), entity_ref("urn:test:s411a:c2#dcplan"), 2) { origin case_input; }
    }
    // graded table gives 20% at 2 years (this is the honest state: both schedules are available;
    // the cliff rule (>= 3) simply does not fire at 2 years)
    evaluate truth(nonforfeitable_percentage(entity_ref("urn:test:s411a:c2#ee"), entity_ref("urn:test:s411a:c2#dcplan"), 0.20));
    expect truth_status == TRUE_ONLY;
}

