test "S411B1A-01-3-PERCENT-METHOD-SATISFIED-AT-EXACT-BOUNDARY" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // projected NRB = 100,000; years = 10; 3% x 100,000 x 10 = 30,000
        assert "f0": projected_normal_retirement_benefit(entity_ref("urn:test:s411b1a:c1#ee"), entity_ref("urn:test:s411b1a:c1#plan"), 100000 USD) { origin case_input; }
        assert "f1": years_of_plan_participation(entity_ref("urn:test:s411b1a:c1#ee"), entity_ref("urn:test:s411b1a:c1#plan"), 10.0) { origin case_input; }
        assert "f2": accrued_benefit_at_separation(entity_ref("urn:test:s411b1a:c1#ee"), entity_ref("urn:test:s411b1a:c1#plan"), 30000 USD) { origin case_input; }
    }
    evaluate truth(accrual_3pct_method_satisfied(entity_ref("urn:test:s411b1a:c1#ee"), entity_ref("urn:test:s411b1a:c1#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S411B1A-02-3-PERCENT-METHOD-FAILS-JUST-BELOW-BOUNDARY" {
    given {
        context {
