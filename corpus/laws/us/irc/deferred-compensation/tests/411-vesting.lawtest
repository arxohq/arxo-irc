            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employee_own_contribution_accrued_benefit(entity_ref("urn:test:s411a1:c1#ee"), entity_ref("urn:test:s411a1:c1#plan"), 15000 USD) { origin case_input; }
    }
    evaluate truth(employee_contribution_accrued_benefit_nonforfeitable(entity_ref("urn:test:s411a1:c1#ee"), entity_ref("urn:test:s411a1:c1#plan")));
