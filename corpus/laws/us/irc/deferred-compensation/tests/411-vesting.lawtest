test "S411A11-03-DISTRIBUTION-POWER-VALID-BY-CONSENT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution_without_consent_attempted(entity_ref("urn:test:s411a11:c3#dist"), entity_ref("urn:test:s411a11:c3#ee"), entity_ref("urn:test:s411a11:c3#plan")) { origin case_input; }
        assert "f1": participant_consents_to_distribution(entity_ref("urn:test:s411a11:c3#dist"), entity_ref("urn:test:s411a11:c3#ee")) { origin case_input; }
        assert "f2": plan_sponsor(entity_ref("urn:test:s411a11:c3#plan"), entity_ref("urn:test:s411a11:c3#sponsor")) { origin case_input; }
    }
    evaluate positions();
    expect position(ImmediateDistributionPower, VALIDLY_EXERCISED);
}

test "S411A11-04-DISTRIBUTION-POWER-INVALID-NO-CONSENT-ABOVE-THRESHOLD" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution_without_consent_attempted(entity_ref("urn:test:s411a11:c4#dist"), entity_ref("urn:test:s411a11:c4#ee"), entity_ref("urn:test:s411a11:c4#plan")) { origin case_input; }
        assert "f1": nonforfeitable_accrued_benefit_present_value(entity_ref("urn:test:s411a11:c4#ee"), entity_ref("urn:test:s411a11:c4#plan"), 20000 USD) { origin case_input; }
        assert "f2": plan_sponsor(entity_ref("urn:test:s411a11:c4#plan"), entity_ref("urn:test:s411a11:c4#sponsor")) { origin case_input; }
        // no consent given, PV exceeds $7,000
    }
    evaluate positions();
    expect position(ImmediateDistributionPower, INVALIDLY_EXERCISED);
}

