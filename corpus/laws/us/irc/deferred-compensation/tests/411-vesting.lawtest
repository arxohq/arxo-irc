}

test "S411D6-01-ANTI-CUTBACK-BLOCKS-BENEFIT-DECREASE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_amendment(entity_ref("urn:test:s411d6:c1#plan"), @2026-01-01) { origin case_input; }
        assert "f1": accrued_benefit_before_amendment(entity_ref("urn:test:s411d6:c1#ee"), entity_ref("urn:test:s411d6:c1#plan"), @2026-01-01, 1000 USD) { origin case_input; }
        assert "f2": accrued_benefit_after_amendment(entity_ref("urn:test:s411d6:c1#ee"), entity_ref("urn:test:s411d6:c1#plan"), @2026-01-01, 800 USD) { origin case_input; }
    }
    evaluate truth(accrued_benefit_decreased_by_amendment(entity_ref("urn:test:s411d6:c1#plan"), entity_ref("urn:test:s411d6:c1#ee"), @2026-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S411D6-02-SECTION-412D2-EXCEPTION-NOT-A-CUTBACK" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": plan_amendment(entity_ref("urn:test:s411d6:c2#plan"), @2026-01-01) { origin case_input; }
        assert "f1": accrued_benefit_before_amendment(entity_ref("urn:test:s411d6:c2#ee"), entity_ref("urn:test:s411d6:c2#plan"), @2026-01-01, 1000 USD) { origin case_input; }
        assert "f2": accrued_benefit_after_amendment(entity_ref("urn:test:s411d6:c2#ee"), entity_ref("urn:test:s411d6:c2#plan"), @2026-01-01, 800 USD) { origin case_input; }
        assert "f3": amendment_permitted_under_412d2_or_erisa4281(entity_ref("urn:test:s411d6:c2#plan"), @2026-01-01) { origin case_input; }
    }
    // no rule produces a negative for this predicate (open-world default): absent a
    // 412(d)(2)/ERISA-4281-permitted amendment, `AccruedBenefitDecreasedByAmendment`
    // does not fire and the predicate is honestly NEITHER, not FALSE_ONLY
    evaluate truth(accrued_benefit_decreased_by_amendment(entity_ref("urn:test:s411d6:c2#plan"), entity_ref("urn:test:s411d6:c2#ee"), @2026-01-01));
    expect truth_status == NEITHER;
}

