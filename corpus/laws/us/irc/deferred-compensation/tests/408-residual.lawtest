test "S408B-09-DISQUALIFICATION-CARRIES-TO-LATER-YEAR" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // the calendar-year relation of us.irc.core is asserted as a case input; a world with a derived calendar year gives the same result
        assert "f0": annuity_disqualified_from_calendar_year(entity_ref("urn:test:s408b-09-disqualification-carries-to-later-year#a"), 2024) { origin case_input; }
        assert "f1": us.irc.core::calendar_year_of(entity_ref("urn:test:s408b-09-disqualification-carries-to-later-year#y"), 2025) { origin case_input; }
    }
    evaluate truth(annuity_disqualified_in_or_before(entity_ref("urn:test:s408b-09-disqualification-carries-to-later-year#a"), entity_ref("urn:test:s408b-09-disqualification-carries-to-later-year#y")));
    expect truth_status == TRUE_ONLY;
}

