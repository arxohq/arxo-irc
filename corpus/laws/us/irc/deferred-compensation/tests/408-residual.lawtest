language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S408B-01-ANNUITY-ALL-REQUIREMENTS-MET" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": annuity_is_annuity_contract(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a")) { origin case_input; }
        assert "f1": annuity_issued_by_insurance_company(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a")) { origin case_input; }
        assert "f2": annuity_annual_premium(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a"), entity_ref("urn:test:s408b-01-annuity-all-requirements-met#i"), entity_ref("urn:test:s408b-01-annuity-all-requirements-met#y"), 7000 USD) { origin case_input; }
        assert "f3": section219_deduction_amount(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#i"), entity_ref("urn:test:s408b-01-annuity-all-requirements-met#y"), 7000 USD) { origin case_input; }
        assert "f4": annuity_premium_refund_applied_by_next_year_end(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a")) { origin case_input; }
        assert "f5": annuity_distribution_rules_per_regulations(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a")) { origin adjudicated; }
    }
    evaluate truth(annuity_meets_408b_requirements(entity_ref("urn:test:s408b-01-annuity-all-requirements-met#a"), entity_ref("urn:test:s408b-01-annuity-all-requirements-met#i"), entity_ref("urn:test:s408b-01-annuity-all-requirements-met#y")));
    expect truth_status == TRUE_ONLY;
}

