test "S408P11-03-AGGREGATE-ABOVE-PRORATED-SUM-EXCEEDS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // prorated sum = (16,000 x 200 + 23,000 x 165) / 365 = 19,164.38
        assert "f0": simple_last_plan_year_days(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er"), 200) { origin case_input; }
        assert "f1": simple_transition_year_days(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er"), 165) { origin case_input; }
        assert "f2": simple_applicable_dollar_last_year(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er"), 16000 USD) { origin case_input; }
        assert "f3": simple_402g_dollar_amount(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er"), 23000 USD) { origin case_input; }
        assert "f4": simple_aggregate_elective_last_and_transition(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er"), 19200 USD) { origin case_input; }
    }
    evaluate truth(simple_termination_limit_exceeded(entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#e"), entity_ref("urn:test:s408p11-03-aggregate-above-prorated-sum-exceeds#er")));
    expect truth_status == TRUE_ONLY;
}

