// Scenarios for 83-401a9-regulatory-tables.law: case-selected RMD table
// divisors and (k)/(m) regulatory delegations. NOT executed in this stage
// — `implemented_unverified`.
// Table values below are key literals read from the pinned renders
// (`us.cfr.t26_1_401a9`, eCFR 2026-09-24): Uniform Lifetime Table age 73
// -> 26.5; Single Life Table age 40 -> 45.7.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S401A9R-01-UNIFORM-LIFETIME-SELECTION-SETS-PERIOD" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": uniform_lifetime_divisor_selected(entity_ref("urn:test:s401a9r:emp1#who"), entity_ref("urn:test:s401a9r:emp1#plan"), entity_ref("urn:test:s401a9r:emp1#y2025"), 73, 26.5) { origin case_input; }
    }
    evaluate truth(distribution_period(entity_ref("urn:test:s401a9r:emp1#who"), entity_ref("urn:test:s401a9r:emp1#plan"), entity_ref("urn:test:s401a9r:emp1#y2025"), 26.5));
    expect truth_status == TRUE_ONLY;
}

test "S401A9R-02-NO-TABLE-SELECTION-PERIOD-UNDETERMINED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
    }
    // no uniform_lifetime_divisor_selected / single_life_expectancy_selected asserted
    evaluate truth(distribution_period(entity_ref("urn:test:s401a9r:emp2#who"), entity_ref("urn:test:s401a9r:emp2#plan"), entity_ref("urn:test:s401a9r:emp2#y2025"), 26.5));
    expect truth_status == NEITHER;
}

test "S401A9R-03-SINGLE-LIFE-SELECTION-SETS-PERIOD" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": single_life_expectancy_selected(entity_ref("urn:test:s401a9r:ben3#who"), entity_ref("urn:test:s401a9r:ben3#plan"), entity_ref("urn:test:s401a9r:ben3#y2025"), 40, 45.7) { origin case_input; }
    }
    evaluate truth(distribution_period(entity_ref("urn:test:s401a9r:ben3#who"), entity_ref("urn:test:s401a9r:ben3#plan"), entity_ref("urn:test:s401a9r:ben3#y2025"), 45.7));
    expect truth_status == TRUE_ONLY;
}

test "S401K8A-01-RECONTRIBUTION-ELECTION-APPLIES-WHEN-REGULATIONS-PROVIDE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": excess_contributions_amount(entity_ref("urn:test:s401k8a:k1#plan"), entity_ref("urn:test:s401k8a:k1#y2025"), 1200 USD) { origin case_input; }
        assert "f1": regulation_permits_excess_recontribution_election(entity_ref("urn:test:s401k8a:k1#plan"), entity_ref("urn:test:s401k8a:k1#y2025")) { origin case_input; }
        assert "f2": excess_recontribution_elected(entity_ref("urn:test:s401k8a:k1#emp"), entity_ref("urn:test:s401k8a:k1#plan"), entity_ref("urn:test:s401k8a:k1#y2025"), 1200 USD) { origin case_input; }
    }
    evaluate truth(excess_contributions_treated_as_distributed_and_recontributed(entity_ref("urn:test:s401k8a:k1#emp"), entity_ref("urn:test:s401k8a:k1#plan"), entity_ref("urn:test:s401k8a:k1#y2025"), 1200 USD));
    expect truth_status == TRUE_ONLY;
}

test "S401K8A-02-NO-ELECTION-WITHOUT-REGULATORY-PERMISSION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": excess_contributions_amount(entity_ref("urn:test:s401k8a:k2#plan"), entity_ref("urn:test:s401k8a:k2#y2025"), 1200 USD) { origin case_input; }
        assert "f1": excess_recontribution_elected(entity_ref("urn:test:s401k8a:k2#emp"), entity_ref("urn:test:s401k8a:k2#plan"), entity_ref("urn:test:s401k8a:k2#y2025"), 1200 USD) { origin case_input; }
    }
    // regulation_permits_excess_recontribution_election not asserted -> no derivation
    evaluate truth(excess_contributions_treated_as_distributed_and_recontributed(entity_ref("urn:test:s401k8a:k2#emp"), entity_ref("urn:test:s401k8a:k2#plan"), entity_ref("urn:test:s401k8a:k2#y2025"), 1200 USD));
    expect truth_status == NEITHER;
}

