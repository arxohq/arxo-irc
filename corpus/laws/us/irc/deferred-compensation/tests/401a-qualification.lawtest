// Section 401(a) scenarios: RMD (age boundary, 5-year/10-year post-death
// rules, 5-percent-owner exception), anti-alienation immunity, compensation
// limit. NOT EXECUTED (implemented_unverified per AGENT-BRIEF).

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S401A9-01-APPLICABLE-AGE-73-WINDOW" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attains_age_on(entity_ref("urn:test:s401a9:emp1#who"), 72, @2023-06-01) { origin case_input; }
        assert "f1": attains_age_on(entity_ref("urn:test:s401a9:emp1#who"), 73, @2024-06-01) { origin case_input; }
    }
    evaluate truth(applicable_age(entity_ref("urn:test:s401a9:emp1#who"), 73));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-02-APPLICABLE-AGE-75-AFTER-2032" {
    given {
        context {
            legal_time @2033-01-01;
            decision_time @2033-01-01T09:00:00-05:00;
            knowledge_time @2033-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attains_age_on(entity_ref("urn:test:s401a9:emp2#who"), 74, @2033-01-15) { origin case_input; }
    }
    evaluate truth(applicable_age(entity_ref("urn:test:s401a9:emp2#who"), 75));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-03-REQUIRED-BEGINNING-DATE-YEAR-RETIREMENT-LATER" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attains_age_on(entity_ref("urn:test:s401a9:emp3#who"), 72, @2023-06-01) { origin case_input; }
        assert "f1": attains_age_on(entity_ref("urn:test:s401a9:emp3#who"), 73, @2024-06-01) { origin case_input; }
        assert "f2": attains_applicable_age_in_year(entity_ref("urn:test:s401a9:emp3#who"), entity_ref("urn:test:s401a9:emp3#plan"), 2024) { origin case_input; }
        assert "f3": retires_in_year(entity_ref("urn:test:s401a9:emp3#who"), entity_ref("urn:test:s401a9:emp3#plan"), 2026) { origin case_input; }
    }
    evaluate truth(required_beginning_date_year(entity_ref("urn:test:s401a9:emp3#who"), entity_ref("urn:test:s401a9:emp3#plan"), 2026));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-04-FIVE-PERCENT-OWNER-IGNORES-RETIREMENT-YEAR" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attains_age_on(entity_ref("urn:test:s401a9:emp4#who"), 72, @2023-06-01) { origin case_input; }
        assert "f1": attains_age_on(entity_ref("urn:test:s401a9:emp4#who"), 73, @2024-06-01) { origin case_input; }
        assert "f2": attains_applicable_age_in_year(entity_ref("urn:test:s401a9:emp4#who"), entity_ref("urn:test:s401a9:emp4#plan"), 2024) { origin case_input; }
        assert "f3": retires_in_year(entity_ref("urn:test:s401a9:emp4#who"), entity_ref("urn:test:s401a9:emp4#plan"), 2028) { origin case_input; }
        assert "f4": five_percent_owner(entity_ref("urn:test:s401a9:emp4#who"), entity_ref("urn:test:s401a9:emp4#plan"), entity_ref("urn:test:s401a9:emp4#y2024")) { origin case_input; }
    }
    // even though retirement year (2028) is later, the 5-percent-owner rule ignores it
    evaluate truth(required_beginning_date_year(entity_ref("urn:test:s401a9:emp4#who"), entity_ref("urn:test:s401a9:emp4#plan"), 2024));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-05-POST-DEATH-TEN-YEAR-RULE-DC-NON-ELIGIBLE-BENEFICIARY" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": employee_died_on(entity_ref("urn:test:s401a9:emp5#who"), entity_ref("urn:test:s401a9:emp5#dcplan"), @2024-03-01) { origin case_input; }
        assert "f1": designated_beneficiary(entity_ref("urn:test:s401a9:emp5#who"), entity_ref("urn:test:s401a9:emp5#dcplan"), entity_ref("urn:test:s401a9:emp5#adultchild")) { origin case_input; }
    }
    // adult child (no eligible-designated-beneficiary ground asserted) -> 10-year rule
    evaluate truth(post_death_distribution_deadline(entity_ref("urn:test:s401a9:emp5#who"), entity_ref("urn:test:s401a9:emp5#dcplan"), entity_ref("urn:test:s401a9:emp5#adultchild"), @2034-03-01));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-06-RMD-AMOUNT-DIVIDES-BALANCE-BY-DISTRIBUTION-PERIOD" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": account_balance(entity_ref("urn:test:s401a9:emp6#who"), entity_ref("urn:test:s401a9:emp6#plan"), entity_ref("urn:test:s401a9:emp6#y2025"), 100000 USD) { origin case_input; }
        assert "f1": distribution_period(entity_ref("urn:test:s401a9:emp6#who"), entity_ref("urn:test:s401a9:emp6#plan"), entity_ref("urn:test:s401a9:emp6#y2025"), 25.5) { origin case_input; }
    }
    evaluate truth(required_minimum_distribution(entity_ref("urn:test:s401a9:emp6#who"), entity_ref("urn:test:s401a9:emp6#plan"), entity_ref("urn:test:s401a9:emp6#y2025"), 3921.57 USD));
    expect truth_status == TRUE_ONLY;
}

test "S401A9-07-UNKNOWN-BALANCE-UNDETERMINED" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": distribution_period(entity_ref("urn:test:s401a9:emp7#who"), entity_ref("urn:test:s401a9:emp7#plan"), entity_ref("urn:test:s401a9:emp7#y2025"), 20.0) { origin case_input; }
    }
    // no account_balance asserted -> amount undetermined
    evaluate truth(required_minimum_distribution(entity_ref("urn:test:s401a9:emp7#who"), entity_ref("urn:test:s401a9:emp7#plan"), entity_ref("urn:test:s401a9:emp7#y2025"), 5000 USD));
    expect truth_status == NEITHER;
}

