}

test "S401A13-02-QDRO-EXCEPTION-BLOCKS-REDUCTION" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attempted_assignment(entity_ref("urn:test:s401a13:c2#plan"), entity_ref("urn:test:s401a13:c2#participant"), entity_ref("urn:test:s401a13:c2#spouse"), 5000 USD, @2026-01-01) { origin case_input; }
        assert "f1": qualified_domestic_relations_order(entity_ref("urn:test:s401a13:c2#plan"), entity_ref("urn:test:s401a13:c2#participant"), 5000 USD) { origin case_input; }
    }
    evaluate truth(benefit_reduced_by_assignment(entity_ref("urn:test:s401a13:c2#plan"), entity_ref("urn:test:s401a13:c2#participant"), 5000 USD));
    expect truth_status == NEITHER;
}

test "S401A17-01-COMPENSATION-AT-LIMIT-NOT-EXCEEDED" {
    given {
        context {
            legal_time @2024-01-01;
            decision_time @2024-01-01T09:00:00-05:00;
            knowledge_time @2024-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": compensation_taken_into_account(entity_ref("urn:test:s401a17:c1#plan"), entity_ref("urn:test:s401a17:c1#employee"), entity_ref("urn:test:s401a17:c1#y2024"), 200000 USD) { origin case_input; }
    }
    evaluate truth(compensation_limit_exceeded(entity_ref("urn:test:s401a17:c1#plan"), entity_ref("urn:test:s401a17:c1#employee"), entity_ref("urn:test:s401a17:c1#y2024")));
    expect truth_status == NEITHER;
}

