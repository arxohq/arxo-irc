// Section 410 scenarios: age/service eligibility, ratio percentage test at
// 70% vs 69.9%. NOT EXECUTED.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

test "S410A-01-ELIGIBLE-AT-AGE-21-ONE-YEAR-SERVICE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attained_age(entity_ref("urn:test:s410a:c1#ee"), @2026-01-01, 21) { origin case_input; }
        assert "f1": years_of_service(entity_ref("urn:test:s410a:c1#ee"), entity_ref("urn:test:s410a:c1#plan"), 1.0) { origin case_input; }
    }
    evaluate truth(eligible_to_participate_410a(entity_ref("urn:test:s410a:c1#ee"), entity_ref("urn:test:s410a:c1#plan"), @2026-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S410A-02-NOT-ELIGIBLE-BELOW-ONE-YEAR-SERVICE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": attained_age(entity_ref("urn:test:s410a:c2#ee"), @2026-01-01, 25) { origin case_input; }
        assert "f1": years_of_service(entity_ref("urn:test:s410a:c2#ee"), entity_ref("urn:test:s410a:c2#plan"), 0.5) { origin case_input; }
    }
    evaluate truth(eligible_to_participate_410a(entity_ref("urn:test:s410a:c2#ee"), entity_ref("urn:test:s410a:c2#plan"), @2026-01-01));
    expect truth_status == NEITHER;
}

test "S410B-01-RATIO-PERCENTAGE-AT-70-PERCENT-PASSES" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // NHCE: 70/100 = 70%; HCE: 10/10 = 100%; ratio = 70/100*100 = 70
        assert "f0": nhce_count(entity_ref("urn:test:s410b:c1#plan"), entity_ref("urn:test:s410b:c1#y2026"), 100.0, 70.0) { origin case_input; }
        assert "f1": hce_count(entity_ref("urn:test:s410b:c1#plan"), entity_ref("urn:test:s410b:c1#y2026"), 10.0, 10.0) { origin case_input; }
    }
    evaluate truth(meets_ratio_percentage_test(entity_ref("urn:test:s410b:c1#plan"), entity_ref("urn:test:s410b:c1#y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S410B-02-RATIO-PERCENTAGE-AT-69-9-PERCENT-FAILS" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        // NHCE: 69.9/100 = 69.9%; HCE: 10/10 = 100%; ratio = 69.9
        assert "f0": nhce_count(entity_ref("urn:test:s410b:c2#plan"), entity_ref("urn:test:s410b:c2#y2026"), 100.0, 69.9) { origin case_input; }
        assert "f1": hce_count(entity_ref("urn:test:s410b:c2#plan"), entity_ref("urn:test:s410b:c2#y2026"), 10.0, 10.0) { origin case_input; }
    }
    evaluate truth(meets_ratio_percentage_test(entity_ref("urn:test:s410b:c2#plan"), entity_ref("urn:test:s410b:c2#y2026")));
    expect truth_status == NEITHER;
}

test "S410B-03-SEVENTY-PERCENT-TEST-DIRECT" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": nhce_count(entity_ref("urn:test:s410b:c3#plan"), entity_ref("urn:test:s410b:c3#y2026"), 100.0, 71.0) { origin case_input; }
    }
    evaluate truth(meets_70_percent_test(entity_ref("urn:test:s410b:c3#plan"), entity_ref("urn:test:s410b:c3#y2026")));
    expect truth_status == TRUE_ONLY;
}
