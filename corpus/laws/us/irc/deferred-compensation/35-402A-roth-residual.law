// Section 402A — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 05 carries the designated Roth contribution and the 403(b) limit. This
// module adds (b) the qualified Roth contribution program, (c)(2) the limit on
// designation, (c)(3) rollovers into a designated Roth account, (c)(4) in-plan
// rollovers, (d) the five-taxable-year period and the qualified distribution,
// (e) pension-linked emergency savings accounts (PLESA), and (f) the
// definition of an applicable retirement plan.
//
// Method: amounts are exact Money arithmetic; the five-year period is the
// earlier of two case-asserted starting dates; the PLESA contribution cap is
// the lesser of $2,500 and the sponsor's amount (the indexed amount after 2024
// is a SOURCE_GAP). PLESA rules take effect for plan years after 2023.

// =====================================================================
// (b) Qualified Roth contribution program
// =====================================================================

use self::{
    Distribution,
    IRC_S402A_B,
    IRC_S402A_C,
    IRC_S402A_D,
    IRC_S402A_E,
    IRC_S402A_F,
    Person,
    Plan,
    TaxableYear,
};

pub relation plan_designated_roth_accounts_separate_402Ab2A(plan: Plan) kind empirical {
    label en unofficial "the plan establishes separate designated Roth accounts for each employee's designated Roth contributions and earnings, case-asserted (section 402A(b)(2)(A))";
}

pub relation plan_separate_recordkeeping_402Ab2B(plan: Plan) kind empirical {
    label en unofficial "the plan maintains separate recordkeeping for each account, case-asserted ((b)(2)(B))";
}

pub relation program_permits_election_402Ab1(plan: Plan) kind empirical {
    label en unofficial "an employee may elect to make, or to have the employer make on the employee's behalf, designated Roth contributions instead of elective deferrals, case-asserted ((b)(1))";
}

pub relation qualified_roth_contribution_program_402Ab(plan: Plan) kind institutional {
    label en official "section 402A(b): a program with the election and with separate accounts and recordkeeping";
}

@source(IRC_S402A_B, relation = formalizes, coverage = exact, quote = "A program shall not be treated as a qualified Roth contribution program unless the applicable retirement plan")
rule QualifiedRothContributionProgram402Ab(plan: Plan) strict {
    label en official "(b)(1) with (b)(2)(A) and (B)";
    when program_permits_election_402Ab1(plan)
        and plan_designated_roth_accounts_separate_402Ab2A(plan)
        and plan_separate_recordkeeping_402Ab2B(plan);
    then qualified_roth_contribution_program_402Ab(plan);
}

// =====================================================================
// (c)(2) Limit on the amount designated; (c)(3) Roth rollovers
// =====================================================================

pub relation maximum_excludable_elective_deferrals_402Ac2(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the maximum amount of elective deferrals excludable from gross income for the taxable year without regard to this section, case-asserted (section 402A(c)(2)(A))";
}

pub relation nondesignated_elective_deferrals_402Ac2(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the elective deferrals of the taxable year the employee does not designate as Roth, case-asserted ((c)(2)(B))";
}

pub relation designated_roth_limit_402Ac2(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402A(c)(2): the excess of the maximum excludable elective deferrals over the nondesignated elective deferrals";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "The amount of elective deferrals which an employee may designate under paragraph (1) shall not exceed the excess (if any) of")
rule DesignatedRothLimit402Ac2(participant: Person, y: TaxableYear, maximum: Money, other: Money) strict {
    label en official "max - other, floored at zero";
    when maximum_excludable_elective_deferrals_402Ac2(participant, y, maximum) and nondesignated_elective_deferrals_402Ac2(participant, y, other);
    then designated_roth_limit_402Ac2(participant, y, max(maximum - other, 0.00 USD));
}

pub relation designated_amount_402Ac2(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of elective deferrals the employee designates as Roth, case-asserted";
}

pub relation designation_exceeds_limit_402Ac2(participant: Person, y: TaxableYear) kind institutional {
    label en official "the designated amount exceeds the section 402A(c)(2) limit";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "shall not exceed the excess (if any) of")
rule DesignationExceedsLimit402Ac2(participant: Person, y: TaxableYear, designated: Money, limit: Money) strict {
    label en official "exact boundary: designating the limit itself is allowed";
    when designated_amount_402Ac2(participant, y, designated) and designated_roth_limit_402Ac2(participant, y, limit) and designated > limit;
    then designation_exceeds_limit_402Ac2(participant, y);
}

pub enum RothRolloverSource402A {
    DesignatedRothAccountSameIndividual;
    RothIraSameIndividual;
    OtherSource;
}

pub relation rollover_into_designated_roth_account_402Ac3(participant: Person, source_kind: RothRolloverSource402A) kind empirical {
    label en unofficial "a rollover contribution into a designated Roth account from this kind of source, case-asserted";
}

pub relation roth_rollover_permitted_402Ac3(participant: Person) kind institutional {
    label en official "section 402A(c)(3)(A): a rollover into a designated Roth account is allowed only from another designated Roth account or a Roth IRA of the individual";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "another designated Roth account of the individual from whose account the payment or distribution was made")
rule RothRolloverFromDesignatedAccount402Ac3(participant: Person) strict {
    label en official "(i)";
    when rollover_into_designated_roth_account_402Ac3(participant, DesignatedRothAccountSameIndividual);
    then roth_rollover_permitted_402Ac3(participant);
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "a Roth IRA of such individual")
rule RothRolloverFromRothIra402Ac3(participant: Person) strict {
    label en official "(ii)";
    when rollover_into_designated_roth_account_402Ac3(participant, RothIraSameIndividual);
    then roth_rollover_permitted_402Ac3(participant);
}

// =====================================================================
// (c)(4) In-plan rollover to a designated Roth account
// =====================================================================

pub relation in_plan_roth_rollover_402Ac4(d: Distribution) kind empirical {
    label en unofficial "the distribution is an in-plan rollover to a designated Roth account within section 402A(c)(4), case-asserted";
}

pub relation amount_includible_without_roth_402Ac4(d: Distribution, amount: Money) kind empirical {
    label en unofficial "the amount that would be includible in gross income were it not part of a qualified rollover contribution, case-asserted";
}

pub relation in_plan_roth_rollover_included_402Ac4(d: Distribution, amount: Money) kind institutional {
    label en official "section 402A(c)(4)(A)(i): the amount that would otherwise be includible is included in gross income";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "there shall be included in gross income any amount which would be includible were it not part of a qualified rollover contribution")
rule InPlanRothRolloverIncluded402Ac4(d: Distribution, amount: Money) strict {
    label en official "the includible amount";
    when in_plan_roth_rollover_402Ac4(d) and amount_includible_without_roth_402Ac4(d, amount);
    then in_plan_roth_rollover_included_402Ac4(d, amount);
}

pub relation section_72t_disapplied_402Ac4(d: Distribution) kind institutional {
    label en official "section 402A(c)(4)(A)(ii): section 72(t) does not apply to the in-plan rollover";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "section 72(t) shall not apply")
rule Section72tDisapplied402Ac4(d: Distribution) strict {
    label en official "the additional tax does not apply to the rollover itself";
    when in_plan_roth_rollover_402Ac4(d);
    then section_72t_disapplied_402Ac4(d);
}

// =====================================================================
// (d) Distributions from a designated Roth account
// =====================================================================

pub relation first_designated_roth_contribution_year_start_402Ad2(individual: Person, plan: Plan, start: Date) kind empirical {
    label en unofficial "the first day of the first taxable year for which the individual made a designated Roth contribution to a designated Roth account under this plan, case-asserted (section 402A(d)(2)(B)(i))";
}

pub relation earlier_plan_roth_year_start_402Ad2(individual: Person, plan: Plan, start: Date) kind empirical {
    label en unofficial "when a rollover came from a designated Roth account under another plan, the first day of the first taxable year of designated Roth contributions to that account, case-asserted ((B)(ii))";
}

pub relation roth_five_year_period_start_402Ad2(individual: Person, plan: Plan, start: Date) kind institutional {
    label en official "section 402A(d)(2)(B): the 5-taxable-year period begins with the earlier of the two starting dates";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "the first taxable year for which the individual made a designated Roth contribution to any designated Roth account established for such individual under the same applicable retirement plan")
rule RothFiveYearPeriodStartSamePlan402Ad2(individual: Person, plan: Plan, start: Date) strict {
    label en official "only the same-plan year when there is no earlier-plan account";
    when first_designated_roth_contribution_year_start_402Ad2(individual, plan, start) and not_known(earlier_plan_roth_year_present_402Ad2(individual, plan));
    then roth_five_year_period_start_402Ad2(individual, plan, start);
}

pub relation earlier_plan_roth_year_present_402Ad2(individual: Person, plan: Plan) kind institutional {
    label en unofficial "helper: an earlier-plan starting date exists";
}

rule EarlierPlanRothYearPresent402Ad2(individual: Person, plan: Plan, start: Date) strict {
    label en unofficial "derives the helper";
    when earlier_plan_roth_year_start_402Ad2(individual, plan, start);
    then earlier_plan_roth_year_present_402Ad2(individual, plan);
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "if a rollover contribution was made to such designated Roth account from a designated Roth account previously established for such individual under another applicable retirement plan, the first taxable year for which the individual made a designated Roth contribution to such previously established account")
rule RothFiveYearPeriodStartEarlier402Ad2(individual: Person, plan: Plan, same: Date, earlier: Date) strict {
    label en official "the earlier of the two starting dates";
    when first_designated_roth_contribution_year_start_402Ad2(individual, plan, same) and earlier_plan_roth_year_start_402Ad2(individual, plan, earlier);
    then roth_five_year_period_start_402Ad2(individual, plan, min(same, earlier));
}

pub relation roth_distribution_made_on_402Ad(individual: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of a payment or distribution from the designated Roth account, case-asserted";
}

pub relation distribution_within_roth_five_year_period_402Ad2b(individual: Person, plan: Plan) kind institutional {
    label en official "section 402A(d)(2)(B): the distribution is made within the 5-taxable-year period, so it is not a qualified distribution";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "A payment or distribution from a designated Roth account shall not be treated as a qualified distribution if such payment or distribution is made within the 5-taxable-year period")
rule DistributionWithinRothFiveYearPeriod402Ad2b(individual: Person, plan: Plan, start: Date, on: Date) strict {
    label en official "exact boundary: a distribution before the fifth anniversary of the period start is within the period";
    when roth_five_year_period_start_402Ad2(individual, plan, start)
        and roth_distribution_made_on_402Ad(individual, plan, on)
        and on < add_calendar_period(start, 5 calendar_year);
    then distribution_within_roth_five_year_period_402Ad2b(individual, plan);
}

pub relation roth_distribution_meets_408Ad2A_events_402Ad(individual: Person, plan: Plan) kind empirical {
    label en unofficial "the distribution is made on or after age 59 1/2, on account of death or disability (the qualified special purpose distribution clause (iv) does not count), case-asserted (section 408A(d)(2)(A) as applied by 402A(d)(2)(A))";
}

pub relation qualified_roth_account_distribution_402Ad1(individual: Person, plan: Plan) kind institutional {
    label en official "section 402A(d)(1), (2): a qualified distribution from a designated Roth account is not includible in gross income";
}

@source(IRC_S402A_D, relation = formalizes, coverage = partial, quote = "Any qualified distribution from a designated Roth account shall not be includible in gross income.")
rule QualifiedRothAccountDistribution402Ad1(individual: Person, plan: Plan, start: Date, on: Date) strict {
    label en official "PARTIAL: outside the 5-year period and on a qualifying event; the qualifying events are one asserted fact";
    when roth_five_year_period_start_402Ad2(individual, plan, start)
        and roth_distribution_made_on_402Ad(individual, plan, on)
        and on >= add_calendar_period(start, 5 calendar_year)
        and roth_distribution_meets_408Ad2A_events_402Ad(individual, plan);
    then qualified_roth_account_distribution_402Ad1(individual, plan);
}

pub relation roth_account_exempt_from_lifetime_rmd_402Ad5(plan: Plan) kind institutional {
    label en official "section 402A(d)(5): section 401(a)(9)(A) and the incidental death benefit requirements do not apply to a designated Roth account";
}

pub relation plan_has_designated_roth_account_402Ad5(plan: Plan) kind empirical {
    label en unofficial "the plan has a designated Roth account, case-asserted";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "Notwithstanding sections 403(b)(10) and 457(d)(2), the following provisions shall not apply to any designated Roth account")
rule RothAccountExemptFromLifetimeRmd402Ad5(plan: Plan) strict {
    label en official "the lifetime required minimum distribution rules do not reach the designated Roth account";
    when plan_has_designated_roth_account_402Ad5(plan);
    then roth_account_exempt_from_lifetime_rmd_402Ad5(plan);
}

// =====================================================================
// (e) Pension-linked emergency savings accounts
// =====================================================================

pub relation plesa_participant_eligible_402Ae2(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the participant in a defined contribution plan meets the age, service and other eligibility requirements of the plan, case-asserted (section 402A(e)(2)(A)(i))";
}

pub relation highly_compensated_402Ae2(participant: Person) kind empirical {
    label en unofficial "the participant is a highly compensated employee under section 414(q), case-asserted ((A)(ii))";
}

pub relation plesa_eligible_participant_402Ae2(participant: Person, plan: Plan) kind institutional {
    label en official "section 402A(e)(2)(A): a participant who meets the plan's eligibility requirements and is not a highly compensated employee";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "is not a highly compensated employee (as defined in section 414(q))")
rule PlesaEligibleParticipant402Ae2(participant: Person, plan: Plan) strict {
    label en official "(i) and (ii)";
    when plesa_participant_eligible_402Ae2(participant, plan) and not_known(highly_compensated_402Ae2(participant));
    then plesa_eligible_participant_402Ae2(participant, plan);
}

pub relation plesa_balance_of_participant_contributions_402Ae3(participant: Person, plan: Plan, balance: Money) kind empirical {
    label en unofficial "the portion of the account balance attributable to participant contributions, case-asserted (section 402A(e)(3)(A))";
}

pub relation plesa_proposed_contribution_402Ae3(participant: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the contribution proposed to be accepted, case-asserted";
}

pub relation plesa_sponsor_cap_402Ae3(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount determined by the plan sponsor under (e)(3)(A)(ii), case-asserted";
}

pub relation plesa_cap_402Ae3(plan: Plan, amount: Money) kind institutional {
    label en official "section 402A(e)(3)(A): the lesser of $2,500 and the sponsor's amount";
}

@source(IRC_S402A_E, relation = formalizes, coverage = partial, quote = "the lesser of")
rule PlesaCap402Ae3(plan: Plan, sponsor: Money) strict {
    label en official "PARTIAL: min(2500, sponsor amount); the inflation adjustment after 2024 is not pinned";
    when plesa_sponsor_cap_402Ae3(plan, sponsor);
    then plesa_cap_402Ae3(plan, min(2500.00 USD, sponsor));
}

rule PlesaCapWithoutSponsorAmount402Ae3(plan: Plan, balance: Money) strict {
    label en official "PARTIAL: without a sponsor amount the cap is $2,500";
    when plesa_balance_of_participant_contributions_402Ae3(_, plan, balance) and not_known(plesa_sponsor_cap_present_402Ae3(plan));
    then plesa_cap_402Ae3(plan, 2500.00 USD);
}

pub relation plesa_sponsor_cap_present_402Ae3(plan: Plan) kind institutional {
    label en unofficial "helper: a sponsor amount exists";
}

rule PlesaSponsorCapPresent402Ae3(plan: Plan, amount: Money) strict {
    label en unofficial "derives the helper";
    when plesa_sponsor_cap_402Ae3(plan, amount);
    then plesa_sponsor_cap_present_402Ae3(plan);
}

pub relation plesa_contribution_acceptable_402Ae3(participant: Person, plan: Plan) kind institutional {
    label en official "section 402A(e)(3)(A): the contribution may be accepted only if the participant-contribution balance stays at or below the cap";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "no contribution shall be accepted to a pension-linked emergency savings account to the extent such contribution would cause the portion of the account balance attributable to participant contributions to exceed the lesser of")
rule PlesaContributionAcceptable402Ae3(participant: Person, plan: Plan, balance: Money, proposed: Money, cap: Money) strict {
    label en official "exact boundary: reaching the cap is allowed, exceeding it is not";
    when plesa_balance_of_participant_contributions_402Ae3(participant, plan, balance)
        and plesa_proposed_contribution_402Ae3(participant, plan, proposed)
        and plesa_cap_402Ae3(plan, cap)
        and balance + proposed <= cap;
    then plesa_contribution_acceptable_402Ae3(participant, plan);
}

pub relation plesa_participant_now_hce_402Ae2b(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the individual on whose behalf the account was established later becomes a highly compensated employee, case-asserted (section 402A(e)(2)(B))";
}

pub relation plesa_contributions_barred_402Ae2b(participant: Person, plan: Plan) kind institutional {
    label en official "section 402A(e)(2)(B): a participant who becomes highly compensated may not make further contributions but keeps the right to withdraw";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "may not make further contributions to such account, but retains the right to withdraw any account balance of such account")
rule PlesaContributionsBarred402Ae2b(participant: Person, plan: Plan) strict {
    label en official "the further contributions are barred";
    when plesa_participant_now_hce_402Ae2b(participant, plan);
    then plesa_contributions_barred_402Ae2b(participant, plan);
}

pub relation plesa_default_rate_402Ae4(plan: Plan, rate: Decimal) kind empirical {
    label en unofficial "the participant contribution rate the sponsor selects under the automatic contribution arrangement, as a fraction of compensation, case-asserted (section 402A(e)(4)(B)(i))";
}

pub relation plesa_default_rate_permitted_402Ae4(plan: Plan) kind institutional {
    label en official "section 402A(e)(4)(A): the automatic contribution rate is not more than 3 percent of compensation";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "at a participant contribution rate that is not more than 3 percent of the compensation of the eligible participant")
rule PlesaDefaultRatePermitted402Ae4(plan: Plan, rate: Decimal) strict {
    label en official "exact boundary: 3 percent is allowed";
    when plesa_default_rate_402Ae4(plan, rate) and rate <= 0.03;
    then plesa_default_rate_permitted_402Ae4(plan);
}

pub relation plesa_withdrawals_allowed_per_month_402Ae7(plan: Plan, per_month: Integer) kind empirical {
    label en unofficial "how many times per calendar month a participant may withdraw, case-asserted (section 402A(e)(7)(A))";
}

pub relation plesa_withdrawal_frequency_ok_402Ae7(plan: Plan) kind institutional {
    label en official "section 402A(e)(7)(A): the account allows withdrawal at least once per calendar month";
}

@source(IRC_S402A_E, relation = formalizes, coverage = partial, quote = "at least once per calendar month")
rule PlesaWithdrawalFrequencyOk402Ae7(plan: Plan, times: Integer) strict {
    label en official "PARTIAL: frequency only; prompt distribution is not derived";
    when plesa_withdrawals_allowed_per_month_402Ae7(plan, times) and times >= 1;
    then plesa_withdrawal_frequency_ok_402Ae7(plan);
}

pub relation plesa_plan_administrator_402(plan: Plan, sponsor: Person) kind empirical {
    label en unofficial "the plan sponsor of a plan that includes a pension-linked emergency savings account, case-asserted";
}

pub relation plesa_separate_accounting_402Ae1B(plan: Plan) kind empirical {
    label en unofficial "the plan separately accounts for PLESA contributions and earnings and keeps separate recordkeeping, case-asserted ((e)(1)(B)(i), (ii))";
}

@source(IRC_S402A_E, relation = formalizes, coverage = partial, quote = "separately account for contributions to such account and any earnings properly allocable to the contributions")
rule PlesaAccountingDuty402Ae1B(plan: Plan, sponsor: Person) strict {
    label en official "PARTIAL: separate accounting and recordkeeping; allowing withdrawals is the (e)(7) rule";
    when plesa_plan_administrator_402(plan, sponsor);
    then duty PlesaSeparateAccountingDuty {
        bearer sponsor;
        beneficiary sponsor;
        goal maintenance {
            condition plesa_separate_accounting_402Ae1B(plan);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// (f)(1) Applicable retirement plan
// =====================================================================

pub enum ApplicableRetirementPlanKind402A {
    QualifiedTrust401a;
    Annuity403b;
    GovernmentalPlan457b;
}

pub relation applicable_plan_kind_402A(plan: Plan, kind: ApplicableRetirementPlanKind402A) kind empirical {
    label en unofficial "the kind of plan, case-asserted (section 402A(f)(1))";
}

pub relation applicable_retirement_plan_402Af1(plan: Plan) kind institutional {
    label en official "section 402A(f)(1): a section 401(a) trust exempt under section 501(a), a section 403(b) plan, or a governmental section 457(b) plan";
}

@source(IRC_S402A_F, relation = formalizes, coverage = exact, quote = "The term \"applicable retirement plan\" means")
rule ApplicableRetirementPlan402Af1(plan: Plan, kind: ApplicableRetirementPlanKind402A) strict {
    label en official "(A), (B) or (C)";
    when applicable_plan_kind_402A(plan, kind);
    then applicable_retirement_plan_402Af1(plan);
}
