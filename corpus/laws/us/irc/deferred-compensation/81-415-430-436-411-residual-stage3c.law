// Sections 415, 430, 436 and 411 residual sentences — STAGE 3c (deferred-
// compensation, last TECH_GAP pass, 26.09.2026). Same pattern as modules
// 61-80: facts asserted by the case produce a treatment relation. Aggregates
// over derived predicates are impossible in the runtime subset (G64), so sums
// run over case facts; multi-year ledgers are unrolled to a stated depth and
// carried in from the previous year as case facts.

// =====================================================================
// 415(f)(2)(A), 415(n)(1)(B), (n)(2)
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    IRC_S411_A,
    IRC_S411_D,
    IRC_S411_E,
    IRC_S415_C,
    IRC_S415_F,
    IRC_S415_N,
    IRC_S430_B,
    IRC_S430_C,
    IRC_S430_J,
    IRC_S436_D,
    IRC_S436_F,
    PermissiveServiceCreditItem,
    Person,
    Plan,
    TaxableYear,
    accrual_requirement_satisfied,
    dc_plan_meets_411b2,
    employee_contribution_accrued_benefit_nonforfeitable,
    liquidity_shortfall_430j4,
    multiemployer_plan_415,
    participant_compensation_415c,
    prohibited_payment_50pct_limit_430d3,
    section415_met_with_permissive_credit,
    separate_accounting_requirement_met_411b3,
};

pub relation plan_pair_for_415f2(multiemployer_plan: Plan, other_plan: Plan) kind empirical {
    label en unofficial "a multiemployer plan and another plan that a combination would reach, case-asserted";
}

pub relation plans_not_combined_for_415b1B_415f2A(multiemployer_plan: Plan, other_plan: Plan) kind institutional {
    label en official "section 415(f)(2)(A): the multiemployer plan is not combined or aggregated with a plan that is not a multiemployer plan for purposes of applying subsection (b)(1)(B) to that other plan";
}

@source(IRC_S415_F, relation = formalizes, coverage = exact, quote = "(A) with any other plan which is not a multiemployer plan for purposes of applying subsection")
rule MultiemployerNotCombinedWithOtherPlan415f2A(multi: Plan, other: Plan) strict {
    label en official "the other plan must not be a multiemployer plan (closed-world over the case's multiemployer facts)";
    when plan_pair_for_415f2(multi, other)
        and multiemployer_plan_415(multi)
        and not_known(multiemployer_plan_415(other));
    then plans_not_combined_for_415b1B_415f2A(multi, other);
}

pub relation credit_contribution_415n1B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, item: PermissiveServiceCreditItem, amount: Money) kind empirical {
    label en unofficial "one contribution made by the participant to purchase permissive service credit, case-asserted (one fact per credit item)";
}

pub relation other_annual_additions_415n1B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's annual additions for the year other than the credit-purchase contributions, case-asserted";
}

pub relation credit_contributions_total_415n1B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "section 415(n)(1)(B): all such contributions, summed";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(B) the requirements of subsection (c) are met, determined by treating all such contributions as")
rule CreditContributionsTotal415n1B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "the sum over the credit items (a sum over case facts, not over a derived predicate)";
    when credit_contribution_415n1B(plan, participant, y, _, _);
    then credit_contributions_total_415n1B(plan, participant, y,
        sum all amt: Money for item: PermissiveServiceCreditItem
            where credit_contribution_415n1B(plan, participant, y, item, amt));
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(B) the requirements of subsection (c) are met, determined by treating all such contributions as")
rule Section415MetWithPermissiveCreditViaC(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, other: Money, credit: Money, comp: Money) defeasible {
    label en official "alternative (B): other annual additions plus all credit contributions do not exceed the lesser of the dollar limit and 100 percent of compensation";
    when other_annual_additions_415n1B(plan, participant, y, other)
        and credit_contributions_total_415n1B(plan, participant, y, credit)
        and participant_compensation_415c(participant, y, comp)
        and other + credit <= min(SECTION415C_DOLLAR_LIMIT, comp);
    then section415_met_with_permissive_credit(plan, participant, y);
}

pub relation reduced_limit_facts_415n2A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefit_without_credit: Money, reduced_limit_415b2C: Money, benefit_with_credit: Money, limit_without_reduction: Money) kind empirical {
    label en unofficial "the annual benefit without the credit-derived benefit and the reduced limit of subsection (b)(2)(C); the annual benefit with it and the limit without that reduction, case-asserted";
}

pub relation reduced_limit_not_failed_solely_by_415n_415n2A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(n)(2)(A): applying paragraph (1)(A), the plan does not fail the reduced limit of (b)(2)(C) solely by reason of subsection (n)";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(A) applying paragraph (1)(A), the plan shall not fail to meet the reduced limit under subsection")
rule ReducedLimitNotFailedSolelyBy415nChapeau(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, without: Money, reduced: Money, with_credit: Money, unreduced: Money) strict {
    label en official "JUDGMENT CALL: the lead-in binds the two relief rules; this rule is the (A) relief: the benefit without the credit fits the reduced limit and the benefit with the credit fits the limit without the reduction";
    when reduced_limit_facts_415n2A(plan, participant, y, without, reduced, with_credit, unreduced)
        and without <= reduced
        and with_credit <= unreduced;
    then reduced_limit_not_failed_solely_by_415n_415n2A(plan, participant, y);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(A) applying paragraph (1)(A), the plan shall not fail to meet the reduced limit under subsection")
rule Section415MetViaBWithReducedLimitRelief415n2A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "alternative (A) with the (n)(2)(A) relief";
    when reduced_limit_not_failed_solely_by_415n_415n2A(plan, participant, y);
    then section415_met_with_permissive_credit(plan, participant, y);
}

pub relation percentage_limit_facts_415n2B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, other_additions: Money, compensation: Money, additions_with_credit: Money, dollar_limit: Money) kind empirical {
    label en unofficial "the annual additions other than the credit contributions and the participant's compensation; all additions with the credit contributions and the dollar limit, case-asserted";
}

pub relation percentage_limit_not_failed_solely_by_415n_415n2B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(n)(2)(B): applying paragraph (1)(B), the plan does not fail the percentage limitation of (c)(1)(B) solely by reason of subsection (n)";
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(B) applying paragraph (1)(B), the plan shall not fail to meet the percentage limitation under")
rule PercentageLimitNotFailedSolelyBy415n2B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, other: Money, comp: Money, total: Money, dollar: Money) strict {
    label en official "JUDGMENT CALL: the percentage limit is tested without the credit contributions (they cannot make the plan fail it), the dollar limit with them";
    when percentage_limit_facts_415n2B(plan, participant, y, other, comp, total, dollar)
        and other <= comp
        and total <= dollar;
    then percentage_limit_not_failed_solely_by_415n_415n2B(plan, participant, y);
}

@source(IRC_S415_N, relation = formalizes, coverage = exact, quote = "(B) applying paragraph (1)(B), the plan shall not fail to meet the percentage limitation under")
rule Section415MetViaCWithPercentageRelief415n2B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "alternative (B) with the (n)(2)(B) relief";
    when percentage_limit_not_failed_solely_by_415n_415n2B(plan, participant, y);
    then section415_met_with_permissive_credit(plan, participant, y);
}

// =====================================================================
// 415(c)(7)(B) church employees: one employer
// =====================================================================

pub enum ChurchEmployeeClass415c7 {
    OrdainedCommissionedOrLicensedMinister;
    LayPerson;
}

pub enum ChurchEmployerKind415c7 {
    Church;
    ConventionOrAssociationOfChurches;
    OrganizationDescribedIn414e3Bii;
}

pub relation church_employer_kind_415c7B(org: Person, kind: ChurchEmployerKind415c7) kind empirical {
    label en unofficial "the organization is a church, a convention or association of churches, or an organization described in section 414(e)(3)(B)(ii), case-asserted";
}

pub relation church_employer_recognized_415c7B(org: Person) kind institutional {
    label en official "section 415(c)(7)(B): the employer is a church, a convention or association of churches, including an organization described in section 414(e)(3)(B)(ii)";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "as an employee of a church, a convention or association of churches, including an organization")
rule ChurchEmployerRecognizedChurch415c7B(org: Person) strict {
    label en official "a church";
    when church_employer_kind_415c7B(org, Church);
    then church_employer_recognized_415c7B(org);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "as an employee of a church, a convention or association of churches, including an organization")
rule ChurchEmployerRecognizedConvention415c7B(org: Person) strict {
    label en official "a convention or association of churches";
    when church_employer_kind_415c7B(org, ConventionOrAssociationOfChurches);
    then church_employer_recognized_415c7B(org);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "as an employee of a church, a convention or association of churches, including an organization")
rule ChurchEmployerRecognizedOrganization415c7B(org: Person) strict {
    label en official "an organization described in section 414(e)(3)(B)(ii)";
    when church_employer_kind_415c7B(org, OrganizationDescribedIn414e3Bii);
    then church_employer_recognized_415c7B(org);
}

pub relation church_employee_service_415c7B(person: Person, org: Person, class: ChurchEmployeeClass415c7, employer_recognized: Boolean, years: Decimal) kind empirical {
    label en unofficial "the years of service of the person, as a minister or lay person, as an employee of this organization; whether the employer is one recognized above (a sum cannot filter on a derived predicate, G64, so the flag repeats it); one fact per organization, case-asserted";
}

pub relation minister_service_recognized_415c7Bi(person: Person, org: Person) kind institutional {
    label en official "section 415(c)(7)(B)(i)(I): service as a duly ordained, commissioned, or licensed minister of a church for a recognized employer";
}

pub relation lay_service_recognized_415c7Bi(person: Person, org: Person) kind institutional {
    label en official "section 415(c)(7)(B)(i)(II): service as a lay person for a recognized employer";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "(I) a duly ordained, commissioned, or licensed minister of a church, or")
rule MinisterServiceRecognized415c7Bi(person: Person, org: Person) strict {
    label en official "a minister employed by a recognized employer";
    when church_employee_service_415c7B(person, org, OrdainedCommissionedOrLicensedMinister, true, _)
        and church_employer_recognized_415c7B(org);
    then minister_service_recognized_415c7Bi(person, org);
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "(II) a lay person,")
rule LayServiceRecognized415c7Bi(person: Person, org: Person) strict {
    label en official "a lay person employed by a recognized employer";
    when church_employee_service_415c7B(person, org, LayPerson, true, _)
        and church_employer_recognized_415c7B(org);
    then lay_service_recognized_415c7Bi(person, org);
}

pub relation church_service_years_as_one_employer_415c7Bi(person: Person, years: Decimal) kind institutional {
    label en official "section 415(c)(7)(B)(i): all such years of service are years of service for 1 employer";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "(i) all years of service by—")
rule ChurchServiceYearsAsOneEmployer415c7Bi(person: Person) strict {
    label en official "JUDGMENT CALL: sum of the years over the recognized employers (the flag on the case fact), one fact per organization";
    when church_employee_service_415c7B(person, _, _, true, _);
    then church_service_years_as_one_employer_415c7Bi(person,
        sum all yrs: Decimal for org: Person
            where church_employee_service_415c7B(person, org, _, true, yrs));
}

pub relation church_annuity_contribution_415c7B(person: Person, org: Person, y: TaxableYear, employer_recognized: Boolean, amount: Money) kind empirical {
    label en unofficial "the amount the organization contributed for annuity contracts for the minister or lay person in the year; whether the employer is a recognized one, case-asserted";
}

pub relation church_contributions_as_one_employer_415c7Bii(person: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "section 415(c)(7)(B)(ii): all amounts contributed for annuity contracts by each such church or organization during such years are considered contributed by 1 employer";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "(ii) all amounts contributed for annuity contracts by each such church (or convention or")
rule ChurchContributionsAsOneEmployer415c7Bii(person: Person, y: TaxableYear) strict {
    label en official "sum over the recognized organizations for the year";
    when church_annuity_contribution_415c7B(person, _, y, true, _);
    then church_contributions_as_one_employer_415c7Bii(person, y,
        sum all amt: Money for org: Person
            where church_annuity_contribution_415c7B(person, org, y, true, amt));
}

// =====================================================================
// 430(b)(2), 430(c)(7)(C)(iii)(IV), 430(j)(4)(C)
// =====================================================================

pub relation compensation_driven_benefit_increase_430b2(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person, increase: Money, attributable_to_service_in_preceding_year: Boolean, caused_by_increase_in_compensation_in_current_year: Boolean) kind empirical {
    label en unofficial "the increase in a benefit attributable to services in a preceding plan year, and whether it is caused by an increase in compensation during the current plan year, case-asserted";
}

pub relation benefit_increase_treated_as_accrued_in_current_year_430b2(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person, increase: Money) kind institutional {
    label en official "section 430(b)(2): the increase is treated as having accrued during the current plan year (it enters the target normal cost of the current year)";
}

@source(IRC_S430_B, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, if any benefit attributable to services performed in a preceding")
rule CompensationDrivenBenefitIncreaseAccruesInCurrentYear430b2(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person, inc: Money) strict {
    label en official "both limbs";
    when compensation_driven_benefit_increase_430b2(plan, y, participant, inc, true, true);
    then benefit_increase_treated_as_accrued_in_current_year_430b2(plan, y, participant, inc);
}

pub relation acceleration_ordering_facts_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, current_year_amount: Money, oldest_carryover: Money, middle_carryover: Money, newest_carryover: Money, limitation: Money) kind empirical {
    label en unofficial "the current year's acceleration amount (without carryover), the carryovers into the year by the year they came from (oldest first; bounded unrolling depth 3), and the clause (ii) limitation, case-asserted";
}

pub relation fifo_remaining_after_current_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, remaining: Money) kind institutional {
    label en official "section 430(c)(7)(C)(iii)(IV): the limitation left after the current year's amount is applied first";
}

pub relation fifo_remaining_after_oldest_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, remaining: Money) kind institutional {
    label en official "the limitation left after the oldest carryover";
}

pub relation fifo_remaining_after_middle_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, remaining: Money) kind institutional {
    label en official "the limitation left after the middle carryover";
}

pub relation acceleration_applied_fifo_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, applied_current: Money, applied_oldest: Money, applied_middle: Money, applied_newest: Money) kind institutional {
    label en official "section 430(c)(7)(C)(iii)(IV): the amounts applied against the limitation in the statutory order";
}

pub relation acceleration_carried_to_next_year_430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, unapplied_current: Money, unapplied_oldest: Money, unapplied_middle: Money, unapplied_newest: Money) kind institutional {
    label en official "section 430(c)(7)(C)(iii)(II): the portion above the limitation is treated as an acceleration amount of the next succeeding plan year (vintages kept)";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subclause (II), installment acceleration amounts for the plan year")
rule FifoRemainingAfterCurrent430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, cur: Money, old: Money, mid: Money, new_amt: Money, lim: Money) strict {
    label en official "current year first: limitation minus the smaller of the current amount and the limitation";
    when acceleration_ordering_facts_430c7Civ(plan, y, cur, old, mid, new_amt, lim);
    then fifo_remaining_after_current_430c7Civ(plan, y, lim - min(cur, lim));
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subclause (II), installment acceleration amounts for the plan year")
rule FifoRemainingAfterOldest430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, cur: Money, old: Money, mid: Money, new_amt: Money, lim: Money, rem: Money) strict {
    label en official "oldest carryover next";
    when acceleration_ordering_facts_430c7Civ(plan, y, cur, old, mid, new_amt, lim)
        and fifo_remaining_after_current_430c7Civ(plan, y, rem);
    then fifo_remaining_after_oldest_430c7Civ(plan, y, rem - min(old, rem));
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subclause (II), installment acceleration amounts for the plan year")
rule FifoRemainingAfterMiddle430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, cur: Money, old: Money, mid: Money, new_amt: Money, lim: Money, rem: Money) strict {
    label en official "middle carryover next";
    when acceleration_ordering_facts_430c7Civ(plan, y, cur, old, mid, new_amt, lim)
        and fifo_remaining_after_oldest_430c7Civ(plan, y, rem);
    then fifo_remaining_after_middle_430c7Civ(plan, y, rem - min(mid, rem));
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subclause (II), installment acceleration amounts for the plan year")
rule AccelerationAppliedFifo430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, cur: Money, old: Money, mid: Money, new_amt: Money, lim: Money, r0: Money, r1: Money, r2: Money) strict {
    label en official "each vintage is applied up to what is left of the limitation, newest last";
    when acceleration_ordering_facts_430c7Civ(plan, y, cur, old, mid, new_amt, lim)
        and fifo_remaining_after_current_430c7Civ(plan, y, r0)
        and fifo_remaining_after_oldest_430c7Civ(plan, y, r1)
        and fifo_remaining_after_middle_430c7Civ(plan, y, r2);
    then acceleration_applied_fifo_430c7Civ(plan, y, min(cur, lim), min(old, r0), min(mid, r1), min(new_amt, r2));
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "For purposes of applying subclause (II), installment acceleration amounts for the plan year")
rule AccelerationCarriedToNextYear430c7Civ(plan: DefinedBenefitPlan, y: TaxableYear, cur: Money, old: Money, mid: Money, new_amt: Money, lim: Money, a0: Money, a1: Money, a2: Money, a3: Money) strict {
    label en official "what is not applied is carried, vintage by vintage";
    when acceleration_ordering_facts_430c7Civ(plan, y, cur, old, mid, new_amt, lim)
        and acceleration_applied_fifo_430c7Civ(plan, y, a0, a1, a2, a3);
    then acceleration_carried_to_next_year_430c7Civ(plan, y, cur - a0, old - a1, mid - a2, new_amt - a3);
}

pub relation liquid_assets_paid_in_installment_430j4A(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the value of the liquid assets paid in the installment for the quarter, case-asserted";
}

pub relation quarter_close_of_due_date_430j4C(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, close: Date) kind empirical {
    label en unofficial "the close of the quarter in which the due date for the installment occurs, case-asserted (the Code's quarter definition and the installment due dates are left to the case)";
}

pub relation evaluated_on_430j4C(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, on: Date) kind empirical {
    label en unofficial "the date on which the treatment of the increased portion is read, case-asserted";
}

pub relation installment_portion_not_paid_430j4A(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, portion: Money) kind institutional {
    label en official "section 430(j)(4)(A): the part of the liquidity shortfall not covered by the liquid assets paid in the installment is treated as not paid";
}

@source(IRC_S430_J, relation = formalizes, coverage = partial, quote = "For purposes of paragraph (3)(A), any portion of an installment that is treated as not paid under")
rule InstallmentPortionNotPaid430j4A(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, shortfall: Money, paid: Money) strict {
    label en official "PARTIAL: (A) only as the helper of (C); the shortfall minus the liquid assets paid in the installment, when positive";
    when liquidity_shortfall_430j4(plan, y, quarter, shortfall)
        and liquid_assets_paid_in_installment_430j4A(plan, y, quarter, paid)
        and shortfall > paid;
    then installment_portion_not_paid_430j4A(plan, y, quarter, shortfall - paid);
}

pub relation portion_treated_as_unpaid_430j4C(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, portion: Money, on: Date) kind institutional {
    label en official "section 430(j)(4)(C): for paragraph (3)(A) the portion treated as not paid continues to be treated as unpaid until the close of the quarter in which the due date occurs";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (3)(A), any portion of an installment that is treated as not paid under")
rule PortionTreatedAsUnpaid430j4C(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, portion: Money, close: Date, on: Date) strict {
    label en official "exact boundary: through the close date inclusive";
    when installment_portion_not_paid_430j4A(plan, y, quarter, portion)
        and quarter_close_of_due_date_430j4C(plan, y, quarter, close)
        and evaluated_on_430j4C(plan, y, quarter, on)
        and on <= close;
    then portion_treated_as_unpaid_430j4C(plan, y, quarter, portion, on);
}

// =====================================================================
// 436(d)(3)(A)(ii), 436(f)(3)
// =====================================================================

pub relation pbgc_guarantee_present_value_436d3Aii(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of the maximum guarantee with respect to the participant under section 4022 of ERISA, determined under PBGC guidance with the interest and mortality assumptions of section 417(e), supplied by the case (EXTERNAL_DEPENDENCY: PBGC guidance)";
}

pub relation prohibited_payment_limit_lesser_of_436d3A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 436(d)(3)(A): the payment may not exceed the lesser of 50 percent of the payment that could be made and the present value of the maximum PBGC guarantee";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "(ii) the present value (determined under guidance prescribed by the Pension Benefit Guaranty")
rule ProhibitedPaymentLimitLesserOf436d3A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, half: Money, pv: Money) defeasible {
    label en official "min of clause (i) (module 18 rule) and clause (ii) (the case-supplied PBGC present value)";
    when prohibited_payment_50pct_limit_430d3(plan, participant, y, half)
        and pbgc_guarantee_present_value_436d3Aii(plan, participant, y, pv);
    then prohibited_payment_limit_lesser_of_436d3A(plan, participant, y, min(half, pv));
}

pub enum BenefitLimitationSubsection436 {
    SubsectionB;
    SubsectionC;
    SubsectionD;
    SubsectionE;
}

pub relation limitation_would_apply_436f3(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436, reduction_needed: Money) kind empirical {
    label en unofficial "a benefit limitation under subsection (b), (c), (d) or (e) would apply for the plan year (determined without regard to (b)(2), (c)(2), (e)(2)) and the reduction of the funding balance necessary for it not to apply, case-asserted";
}

pub relation funding_balances_available_436f3(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the prefunding balance and funding standard carryover balance available for reduction, case-asserted";
}

pub relation plan_maintained_under_collective_bargaining_436f3C(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is maintained pursuant to one or more collective bargaining agreements between employee representatives and one or more employers, case-asserted";
}

pub relation deemed_election_permitted_436f3C(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436) kind institutional {
    label en official "section 436(f)(3)(C): for a limitation under (b), (c) or (e) the deemed election applies only to a collectively bargained plan; for (d) there is no such restriction";
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "With respect to any benefit limitation under subsection (b), (c), or (e), subparagraph (A) shall")
rule DeemedElectionPermittedSubsectionB436f3C(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "(b), collectively bargained only";
    when plan_maintained_under_collective_bargaining_436f3C(plan)
        and limitation_would_apply_436f3(plan, y, SubsectionB, _);
    then deemed_election_permitted_436f3C(plan, y, SubsectionB);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "With respect to any benefit limitation under subsection (b), (c), or (e), subparagraph (A) shall")
rule DeemedElectionPermittedSubsectionC436f3C(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "(c), collectively bargained only";
    when plan_maintained_under_collective_bargaining_436f3C(plan)
        and limitation_would_apply_436f3(plan, y, SubsectionC, _);
    then deemed_election_permitted_436f3C(plan, y, SubsectionC);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "With respect to any benefit limitation under subsection (b), (c), or (e), subparagraph (A) shall")
rule DeemedElectionPermittedSubsectionE436f3C(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "(e), collectively bargained only";
    when plan_maintained_under_collective_bargaining_436f3C(plan)
        and limitation_would_apply_436f3(plan, y, SubsectionE, _);
    then deemed_election_permitted_436f3C(plan, y, SubsectionE);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "With respect to any benefit limitation under subsection (b), (c), or (e), subparagraph (A) shall")
rule DeemedElectionPermittedSubsectionD436f3C(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "(d), no collective bargaining condition";
    when limitation_would_apply_436f3(plan, y, SubsectionD, _);
    then deemed_election_permitted_436f3C(plan, y, SubsectionD);
}

pub relation funding_balances_sufficient_436f3B(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436) kind institutional {
    label en official "section 436(f)(3)(B): reducing the balances would result in the benefit limitation not applying";
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply with respect to a benefit limitation for any plan year if the")
rule FundingBalancesSufficient436f3B(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436, need: Money, avail: Money) strict {
    label en official "exact boundary: balances equal to the reduction needed are sufficient";
    when limitation_would_apply_436f3(plan, y, limitation, need)
        and funding_balances_available_436f3(plan, y, avail)
        and avail >= need;
    then funding_balances_sufficient_436f3B(plan, y, limitation);
}

pub relation deemed_election_to_reduce_balance_436f3A(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436, reduction: Money) kind institutional {
    label en official "section 436(f)(3)(A): the plan sponsor is treated as having made an election under section 430(f) to reduce the prefunding balance or funding standard carryover balance by the amount necessary";
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "Subject to subparagraph (C), in any case in which a benefit limitation under subsection (b), (c),")
rule DeemedElectionToReduceBalance436f3A(plan: DefinedBenefitPlan, y: TaxableYear, limitation: BenefitLimitationSubsection436, need: Money) strict {
    label en official "subject to (C) and (B): the amount necessary for the limitation not to apply";
    when limitation_would_apply_436f3(plan, y, limitation, need)
        and deemed_election_permitted_436f3C(plan, y, limitation)
        and funding_balances_sufficient_436f3B(plan, y, limitation);
    then deemed_election_to_reduce_balance_436f3A(plan, y, limitation, need);
}

// =====================================================================
// 411(a), (a)(9), (d), (e)
// =====================================================================

pub relation normal_retirement_benefit_nonforfeitable_411a(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the plan provides that the employee's right to the normal retirement benefit is nonforfeitable upon attainment of normal retirement age, case-asserted";
}

pub relation vesting_and_consent_provisions_411a(employee: Person, plan: Plan, meets_a2_vesting_schedule: Boolean, meets_a11_distribution_consent: Boolean) kind empirical {
    label en unofficial "the plan satisfies paragraphs (2) and (11) of subsection (a), case-asserted (the vesting schedules of module 11 are minimums, not tests)";
}

pub relation plan_meets_411a_for_db_employee(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(a): the defined benefit plan provides the nonforfeitable normal retirement benefit and satisfies paragraphs (1), (2), (11), subsection (b)(3) and (b)(1)";
}

pub relation plan_meets_411a_for_dc_employee(employee: Person, plan: DefinedContributionPlan) kind institutional {
    label en official "section 411(a): the defined contribution plan provides the nonforfeitable normal retirement benefit and satisfies paragraphs (1), (2), (11), subsection (b)(3) and (b)(2)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A trust shall not constitute a qualified trust under section 401(a) unless the plan of which such")
rule PlanMeets411aDb(employee: Person, plan: DefinedBenefitPlan) defeasible {
    label en official "wired to the module 11, 33 and 66 relations for (a)(1), (b)(3) and (b)(1)";
    when normal_retirement_benefit_nonforfeitable_411a(employee, plan)
        and vesting_and_consent_provisions_411a(employee, plan, true, true)
        and employee_contribution_accrued_benefit_nonforfeitable(employee, plan)
        and separate_accounting_requirement_met_411b3(plan)
        and accrual_requirement_satisfied(employee, plan);
    then plan_meets_411a_for_db_employee(employee, plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A trust shall not constitute a qualified trust under section 401(a) unless the plan of which such")
rule PlanMeets411aDc(employee: Person, plan: DefinedContributionPlan) defeasible {
    label en official "wired to the module 11 and 33 relations for (a)(1), (b)(3) and (b)(2)";
    when normal_retirement_benefit_nonforfeitable_411a(employee, plan)
        and vesting_and_consent_provisions_411a(employee, plan, true, true)
        and employee_contribution_accrued_benefit_nonforfeitable(employee, plan)
        and separate_accounting_requirement_met_411b3(plan)
        and dc_plan_meets_411b2(plan);
    then plan_meets_411a_for_dc_employee(employee, plan);
}

pub relation disability_benefit_facts_411a9(plan: Plan, participant: Person, disability_benefit: Money, benefit_if_separated_at_normal_retirement_age: Money) kind empirical {
    label en unofficial "the disability benefit the plan provides and the benefit the participant would receive if he separated from the service at normal retirement age, case-asserted";
}

pub relation bridge_benefit_facts_411a9(plan: Plan, participant: Person, bridge_benefit: Money, social_security_benefit: Money, terminates_when_social_security_commences: Boolean) kind empirical {
    label en unofficial "a benefit commencing before social security benefits become payable, the social security benefits, and whether it terminates when they commence, case-asserted";
}

pub relation qualified_disability_benefit_411a9(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(a)(9): a disability benefit that does not exceed the benefit that would be provided if the participant separated at normal retirement age";
}

pub relation bridge_within_social_security_411a9i(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(a)(9)(i): the benefits do not exceed such social security benefits";
}

pub relation bridge_terminates_with_social_security_411a9ii(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(a)(9)(ii): the benefits terminate when such social security benefits commence";
}

pub relation bridge_disregarded_for_early_retirement_411a9(plan: Plan, participant: Person) kind institutional {
    label en official "section 411(a)(9): the early retirement benefit is determined without regard to bridge benefits meeting (i) and (ii)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, a qualified disability benefit is a disability benefit provided by")
rule QualifiedDisabilityBenefit411a9(plan: Plan, participant: Person, disability: Money, nra: Money) strict {
    label en official "exact boundary: a disability benefit equal to the normal retirement age benefit qualifies";
    when disability_benefit_facts_411a9(plan, participant, disability, nra)
        and disability <= nra;
    then qualified_disability_benefit_411a9(plan, participant);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "(i) do not exceed such social security benefits, and")
rule BridgeWithinSocialSecurity411a9i(plan: Plan, participant: Person, bridge: Money, ss: Money, t: Boolean) strict {
    label en official "exact boundary: equal to the social security benefit is within it";
    when bridge_benefit_facts_411a9(plan, participant, bridge, ss, t)
        and bridge <= ss;
    then bridge_within_social_security_411a9i(plan, participant);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "(ii) terminate when such social security benefits commence.")
rule BridgeTerminatesWithSocialSecurity411a9ii(plan: Plan, participant: Person, bridge: Money, ss: Money) strict {
    label en official "terminates when the social security benefits commence";
    when bridge_benefit_facts_411a9(plan, participant, bridge, ss, true);
    then bridge_terminates_with_social_security_411a9ii(plan, participant);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, a qualified disability benefit is a disability benefit provided by")
rule BridgeDisregardedForEarlyRetirement411a9(plan: Plan, participant: Person) strict {
    label en official "both limbs (i) and (ii)";
    when bridge_within_social_security_411a9i(plan, participant)
        and bridge_terminates_with_social_security_411a9ii(plan, participant);
    then bridge_disregarded_for_early_retirement_411a9(plan, participant);
}

external judgment relation pattern_of_abuse_favoring_hce_411d1A(plan: Plan) {
    authority Secretary;
    label en official "section 411(d)(1)(A): there has been a pattern of abuse under the plan (such as a dismissal of employees before their accrued benefits become nonforfeitable) tending to discriminate in favor of highly compensated employees — an evaluative determination, not computed by this package";
}

external judgment relation accrual_or_forfeiture_favoring_hce_411d1B(plan: Plan) {
    authority Secretary;
    label en official "section 411(d)(1)(B): there have been, or there is reason to believe there will be, an accrual of benefits or forfeitures tending to discriminate in favor of highly compensated employees — an evaluative determination, not computed by this package";
}

pub relation plan_satisfies_section_411_411d1(plan: Plan) kind empirical {
    label en unofficial "the plan satisfies the requirements of section 411, case-asserted";
}

pub relation vesting_treated_as_satisfying_401a4_411d1(plan: Plan) kind institutional {
    label en official "section 411(d)(1): a plan that satisfies section 411 is treated as satisfying the vesting requirements resulting from section 401(a)(4) unless (A) or (B)";
}

pub relation vesting_treatment_overridden_411d1(plan: Plan) kind institutional {
    label en official "section 411(d)(1)(A) or (B): the section 401(a)(4) vesting override applies";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "(A) there has been a pattern of abuse under the plan (such as a dismissal of employees before their")
rule VestingTreatmentOverriddenByAbuse411d1A(plan: Plan) strict {
    label en official "EVALUATIVE (DECISION-0194): the pattern of abuse is the Secretary's judgment channel";
    when pattern_of_abuse_favoring_hce_411d1A(plan);
    then vesting_treatment_overridden_411d1(plan);
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "(B) there have been, or there is reason to believe there will be, an accrual of benefits or")
rule VestingTreatmentOverriddenByAccrual411d1B(plan: Plan) strict {
    label en official "EVALUATIVE (DECISION-0194): discriminatory accrual or forfeitures, the Secretary's judgment channel";
    when accrual_or_forfeiture_favoring_hce_411d1B(plan);
    then vesting_treatment_overridden_411d1(plan);
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "(A) there has been a pattern of abuse under the plan (such as a dismissal of employees before their")
rule VestingTreatedAsSatisfying401a4Unless411d1(plan: Plan) strict {
    label en official "the plan satisfies section 411 and neither exception is established (an unknown judgment does not defeat the treatment, but is also not a finding of no abuse)";
    when plan_satisfies_section_411_411d1(plan)
        and not_known(vesting_treatment_overridden_411d1(plan));
    then vesting_treated_as_satisfying_401a4_411d1(plan);
}

pub relation early_termination_designated_employee_benefit_facts_411d2(plan: Plan, employee: Person, benefit_may_not_be_provided_under_plan_provision_per_regulations: Boolean) kind empirical {
    label en unofficial "the benefit may not be provided for the designated employee in the event of early termination under a plan provision adopted pursuant to regulations under section 401(a)(4), case-asserted";
}

pub relation subsection_a_inapplicable_to_benefit_411d2(plan: Plan, employee: Person) kind institutional {
    label en official "section 411(d)(2): subsection (a) does not apply to such benefits";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to benefits which may not be provided for designated employees in")
rule SubsectionAInapplicableToDesignatedEmployeeBenefit411d2(plan: Plan, employee: Person) strict {
    label en official "the plan provision is adopted pursuant to the Secretary's regulations (case-asserted)";
    when early_termination_designated_employee_benefit_facts_411d2(plan, employee, true);
    then subsection_a_inapplicable_to_benefit_411d2(plan, employee);
}

pub enum PlanTransaction411d6D {
    DirectTransfer;
    PlanMerger;
    OtherTransactionHavingEffectOfDirectTransfer;
    ConsolidationOfBenefitsWithinMultipleEmployerPlan;
}

pub relation plan_transaction_411d6D(transferee_plan: Plan, transferor_plan: Plan, kind: PlanTransaction411d6D) kind empirical {
    label en unofficial "a transaction between a transferee plan and a transferor plan, case-asserted";
}

pub relation clause_i_applies_to_transaction_411d6Dii(transferee_plan: Plan, transferor_plan: Plan) kind institutional {
    label en official "section 411(d)(6)(D)(ii): clause (i) applies to plan mergers and other transactions having the effect of a direct transfer, including consolidations of benefits within a multiple employer plan";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "Clause (i) shall apply to plan mergers and other transactions having the effect of a direct")
rule ClauseIAppliesToMerger411d6Dii(transferee: Plan, transferor: Plan) strict {
    label en official "plan merger";
    when plan_transaction_411d6D(transferee, transferor, PlanMerger);
    then clause_i_applies_to_transaction_411d6Dii(transferee, transferor);
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "Clause (i) shall apply to plan mergers and other transactions having the effect of a direct")
rule ClauseIAppliesToTransferLike411d6Dii(transferee: Plan, transferor: Plan) strict {
    label en official "another transaction having the effect of a direct transfer";
    when plan_transaction_411d6D(transferee, transferor, OtherTransactionHavingEffectOfDirectTransfer);
    then clause_i_applies_to_transaction_411d6Dii(transferee, transferor);
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "Clause (i) shall apply to plan mergers and other transactions having the effect of a direct")
rule ClauseIAppliesToConsolidation411d6Dii(transferee: Plan, transferor: Plan) strict {
    label en official "consolidation of benefits attributable to different employers within a multiple employer plan";
    when plan_transaction_411d6D(transferee, transferor, ConsolidationOfBenefitsWithinMultipleEmployerPlan);
    then clause_i_applies_to_transaction_411d6Dii(transferee, transferor);
}

pub relation excluded_plan_1974_vesting_facts_411e2(plan: Plan, described_in_411e1: Boolean, meets_vesting_of_401a4_and_401a7_as_in_effect_1974_09_01: Boolean) kind empirical {
    label en unofficial "the plan is described in paragraph (1) and meets the vesting requirements resulting from sections 401(a)(4) and 401(a)(7) as in effect on September 1, 1974, case-asserted";
}

pub relation excluded_plan_treated_as_meeting_411_for_401a_411e2(plan: Plan) kind institutional {
    label en official "section 411(e)(2): the excluded plan is treated as meeting the requirements of this section for purposes of section 401(a)";
}

@source(IRC_S411_E, relation = formalizes, coverage = exact, quote = "(2) A plan described in paragraph (1) shall be treated as meeting the requirements of this section,")
rule ExcludedPlanTreatedAsMeeting411For401a411e2(plan: Plan) strict {
    label en official "both limbs";
    when excluded_plan_1974_vesting_facts_411e2(plan, true, true);
    then excluded_plan_treated_as_meeting_411_for_401a_411e2(plan);
}
