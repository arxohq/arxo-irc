// Section 415 — limitations on benefits and contributions under qualified
// plans. Stage 1 (IRC-09), DECISION-0379. Priority: (b) defined benefit
// dollar limit / 100% of compensation, (c) defined contribution lesser of
// dollar limit / 100% of compensation — both statutory base values. (d)
// COLA rule is a BRIEF contract (the actual annual adjustment mechanism is
// not reformalized; it is the source of every "SOURCE_GAP" note across this
// package's A3 parameters).


// =====================================================================
// (b) Limitation for defined benefit plans
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    IRC_S415_B,
    IRC_S415_C,
    IRC_S415_D,
    IRC_S415_F,
    IRC_S415_H,
    IRC_S415_K,
    IRC_S415_L,
    Person,
    Plan,
    TaxableYear,
    plan_sponsor,
    qualified_plan,
};

pub relation annual_benefit(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's benefit expressed as an annual benefit under section 415(b)(2)(A) (straight life annuity, no ancillary benefits, no employee contributions or rollovers), case-asserted; the (b)(2)(B)-(E) actuarial adjustments for other forms of benefit are NOT reformalized here (TECH_GAP)";
}

pub relation high_3_year_average_compensation(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's average compensation for the high 3 years (section 415(b)(3)), case-asserted";
}

pub relation section415b_dollar_limit_exceeded(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(1): the annual benefit exceeds the lesser of the dollar limit or 100 percent of high-3-year average compensation";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "Benefits with respect to a participant exceed the limitation of this subsection if, when expressed as an annual benefit (within the meaning of paragraph (2)), such annual benefit is greater than the lesser of—")
rule Section415bLimitExceeded(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefit: Money, comp: Money) strict {
    label en official "exceeded when the annual benefit is greater than min(dollar limit, 100% of high-3 average compensation)";
    when annual_benefit(plan, participant, y, benefit)
        and high_3_year_average_compensation(participant, y, comp)
        and benefit > min(SECTION415B_DOLLAR_LIMIT, comp);
    then section415b_dollar_limit_exceeded(plan, participant, y);
}
// SECTION415B_DOLLAR_LIMIT is an A3 parameter
// (section-415b-db-dollar-limit.lawparam.json): statutory base $160,000
// (Economic Growth and Tax Relief Reconciliation Act of 2001 base;
// COLA-adjusted under (d)). Only the statutory base is pinned —
// SOURCE_GAP for the annually adjusted amount. The age-62/65 adjustment
// ((b)(2)(C)/(D)), the $10,000 de minimis floor ((b)(4)), and the
// less-than-10-years-of-participation proration ((b)(5)) are NOT modelled
// in this stage (TECH_GAP / stage 2).

// =====================================================================
// (c) Limitation for defined contribution plans
// =====================================================================

pub relation annual_addition(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of employer contributions, employee contributions and forfeitures allocated to the participant's account for the year (section 415(c)(2)), case-asserted";
}

pub relation participants_compensation_415c(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's compensation from the employer for the year within the meaning of section 415(c)(3), case-asserted";
}

pub relation section415c_dollar_limit_exceeded(plan: DefinedContributionPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(c)(1): the annual addition exceeds the lesser of the dollar limit or 100 percent of the participant's compensation";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "Contributions and other additions with respect to a participant exceed the limitation of this subsection if, when expressed as an annual addition (within the meaning of paragraph (2)) to the participant's account, such annual addition is greater than the lesser of—")
rule Section415cLimitExceeded(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, addition: Money, comp: Money) strict {
    label en official "exceeded when the annual addition is greater than min(dollar limit, 100% of compensation)";
    when annual_addition(plan, participant, y, addition)
        and participants_compensation_415c(participant, y, comp)
        and addition > min(SECTION415C_DOLLAR_LIMIT, comp);
    then section415c_dollar_limit_exceeded(plan, participant, y);
}

pub relation section415_limits_satisfied(plan: Plan, participant: Person, y: TaxableYear) kind institutional {
    label en official "neither the section 415(b) nor the section 415(c) limitation is exceeded (used by section 401(a)(16))";
}

// =====================================================================
// STAGE 2b (25.09.2026): (b)(4)/(5)/(11) DB limitation refinements, (c)(2)
// annual addition definition (exact sum).
// =====================================================================

pub relation participant_db_benefits_from_employer(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate retirement benefits payable to the participant under all defined benefit plans of the employer for this plan year (or any prior plan year), case-asserted";
}

pub relation employer_never_maintained_dc_plan_for_participant(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the employer has never maintained a defined contribution plan in which the participant participated, case-asserted (section 415(b)(4)(B))";
}

pub relation section415b_deemed_not_exceeded_10000_floor(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(4): benefits are deemed not to exceed the (b) limitation when aggregate DB benefits are at or below $10,000 and no DC plan was ever maintained for the participant";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the retirement benefits payable with respect to such participant under such plan and under all other defined benefit plans of the employer do not exceed $10,000 for the plan year, or for any prior plan year, and")
rule Section415bDeemedNotExceeded10000Floor(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefits: Money) strict {
    label en official "exact boundary: aggregate benefits at exactly $10,000 are deemed compliant; $10,000.01 is not";
    when participant_db_benefits_from_employer(plan, participant, y, benefits)
        and benefits <= SECTION415B4_DEMINIMIS_FLOOR
        and employer_never_maintained_dc_plan_for_participant(plan, participant);
    then section415b_deemed_not_exceeded_10000_floor(plan, participant, y);
}

pub relation years_of_participation_db(participant: Person, plan: DefinedBenefitPlan, y: TaxableYear, years: Decimal) kind empirical {
    label en unofficial "the participant's years (or part thereof) of participation in the defined benefit plan, case-asserted (section 415(b)(5)(A))";
}

pub relation section415b_dollar_limit_prorated(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(b)(5)(A)/(C): for less than 10 years of participation, the dollar limit is prorated by years/10, never reduced below 1/10 of the unprorated limit";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the limitation referred to in paragraph (1)(A) shall be the limitation determined under such paragraph (without regard to this paragraph) multiplied by a fraction")
rule Section415bDollarLimitProrated(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, years: Decimal) strict {
    label en official "prorated limit = max(unprorated limit x min(years,10)/10, unprorated limit / 10)";
    when years_of_participation_db(participant, plan, y, years) and years < 10.0;
    then section415b_dollar_limit_prorated(plan, participant, y,
        // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
        max(div_round(SECTION415B_DOLLAR_LIMIT * min(years, 10.0), 10.0, 2, "HALF_UP"),
            round(div_round(SECTION415B_DOLLAR_LIMIT, 10.0, 2, "HALF_UP"), 2, "HALF_UP")));
}

pub relation governmental_plan_415(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a governmental plan (section 414(d)) or a multiemployer plan (section 414(f)), case-asserted";
}

pub relation section415b1B_comp_limit_inapplicable(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 415(b)(11): the 100%-of-high-3-compensation prong of the (b)(1) limitation does not apply to a governmental or multiemployer plan";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "In the case of a governmental plan (as defined in section 414(d)) or a multiemployer plan (as defined in section 414(f)), subparagraph (B) of paragraph (1) shall not apply.")
rule Section415b1BCompLimitInapplicable(plan: DefinedBenefitPlan) strict {
    label en official "governmental/multiemployer plans are tested only against the dollar limit, not the compensation percentage";
    when governmental_plan_415(plan);
    then section415b1B_comp_limit_inapplicable(plan);
}
// SECTION415B4_DEMINIMIS_FLOOR is an A3 parameter
// (section-415b4-de-minimis-floor.lawparam.json): flat, unindexed $10,000
// (no COLA paragraph in the pinned text for this specific figure — not a
// SOURCE_GAP). (b)(2)(B)-(E) actuarial-equivalence adjustments (age 62/65,
// interest-rate/mortality-table floors) are EXTERNAL_DEPENDENCY, same
// class as G66; (b)(3) high-3 compensation averaging, (b)(6)-(10)/(12)
// (computation-consistency rule, collectively-bargained-plan exception,
// social-security-retirement-age definition, commercial-airline-pilot/
// State-and-local-government special rules, rural-electric-cooperative
// rule) are NOT modelled (TECH_GAP, stage 2b).

pub relation employer_contribution_annual_addition(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employer contributions allocated to the participant's account for the year, case-asserted (section 415(c)(2)(A))";
}

pub relation employee_contribution_annual_addition(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employee (non-rollover) contributions to the account for the year, case-asserted (section 415(c)(2)(B))";
}

pub relation forfeitures_annual_addition(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "forfeitures allocated to the account for the year, case-asserted (section 415(c)(2)(C))";
}

pub relation annual_addition_computed(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(2): annual addition = employer contributions + employee contributions + forfeitures";
}

@source(IRC_S415_C, relation = formalizes, coverage = exact, quote = "the term \"annual addition\" means the sum of any year of")
rule AnnualAdditionComputed(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, er: Money, ee: Money, forf: Money) strict {
    label en official "exact sum of the three components";
    when employer_contribution_annual_addition(plan, participant, y, er)
        and employee_contribution_annual_addition(plan, participant, y, ee)
        and forfeitures_annual_addition(plan, participant, y, forf);
    then annual_addition_computed(plan, participant, y, er + ee + forf);
}
// (c)(3) participant's-compensation definition (including the (D)
// elective-deferral/cafeteria-plan inclusions and the (C) disability
// special rule), (c)(6) ESOP exception, (c)(7) church-plan alternative
// limitation, and (c)(8) difficulty-of-care-payment increase are NOT
// modelled (TECH_GAP, stage 2b).
// SECTION415C_DOLLAR_LIMIT is an A3 parameter
// (section-415c-dc-dollar-limit.lawparam.json): statutory base $40,000
// (same 2001 Act base; COLA-adjusted under (d)). Only the statutory base is
// pinned — SOURCE_GAP for the annually adjusted amount.

// =====================================================================
// (d) Cost-of-living adjustments — BRIEF contract
// =====================================================================
pub relation section415d_adjustment_published(y: TaxableYear, base_amount: Money, adjusted_amount: Money) kind empirical {
    label en unofficial "the Secretary's section 415(d) cost-of-living adjustment of a base dollar amount for this year, case-asserted from the IRS's own annual determination (EXTERNAL_DEPENDENCY: the adjustment FORMULA (CPI ratio, rounding to the next lowest $5,000/$1,000/$500 as each cross-referencing provision specifies) is not reformalized in this package; every SOURCE_GAP note above points here)";
}

// =====================================================================
// (f) Combining of plans — stage 2d
// =====================================================================
// Method: (f)(1)(B) DC combination is executable (sums annual_addition_
// computed across every DC plan of the same employer, mirroring
// us.irc.corporations's own 302(c)(1) sum-across-attribution-kinds
// pattern). (f)(1)(A) DB combination is TECH_GAP: this package's own
// `annual_benefit` is a case-asserted STRAIGHT-LIFE-ANNUITY-EQUIVALENT
// figure per plan, and combining requires the same actuarial-equivalence
// step across plans that (b)(2)(B)-(E) itself is already TECH_GAP for
// (see the annual_benefit relation's own doc comment above) — summing the
// case-asserted annual_benefit figures directly would double-count any
// actuarial-conversion error already disclosed there, so it is not done.
// (f)(2) multiemployer-plan carve-out is modelled as a defeater.

pub relation multiemployer_plan_415(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan within the meaning of section 414(f), case-asserted";
}

pub relation combined_annual_addition_415f(employer: Person, participant: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "section 415(f)(1)(B): the sum of annual additions across every (non-multiemployer) defined contribution plan of the same employer, treated as one plan";
}

@source(IRC_S415_F, relation = formalizes, coverage = exact, quote = "all defined contribution plans (whether or not terminated) of an employer are to be treated as one defined contribution plan")
rule CombinedAnnualAddition415f(employer: Person, participant: Person, y: TaxableYear, plan0: DefinedContributionPlan) defeasible {
    label en official "sums annual_addition_computed over every DC plan of the employer that is not a multiemployer plan (triggered once at least one such plan/participant/year fact exists)";
    when plan_sponsor(plan0, employer)
        and annual_addition_computed(plan0, participant, y, _)
        and not_known(multiemployer_plan_415(plan0));
    then combined_annual_addition_415f(employer, participant, y,
        sum all amt: Money for plan: DefinedContributionPlan
            where plan_sponsor(plan, employer)
                and not_known(multiemployer_plan_415(plan))
                and annual_addition_computed(plan, participant, y, amt));
}

pub relation combined_section415c_limit_exceeded(employer: Person, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(f)(1)(B) applied to the (c) dollar/compensation limit: the COMBINED annual addition across the employer's DC plans exceeds the limit";
}

@source(IRC_S415_C, relation = formalizes, coverage = contextual, quote = "the term \"annual addition\" means the sum of any year of")
rule CombinedSection415cLimitExceeded(employer: Person, participant: Person, y: TaxableYear, total: Money, comp: Money) defeasible {
    label en official "combined addition compared against the same min(dollar limit, 100% of compensation) test as the single-plan rule";
    when combined_annual_addition_415f(employer, participant, y, total)
        and participants_compensation_415c(participant, y, comp)
        and total > min(SECTION415C_DOLLAR_LIMIT, comp);
    then combined_section415c_limit_exceeded(employer, participant, y);
}
// (f)(2) multiemployer carve-out from combination is modelled via the
// `unless multiemployer_plan_415(_)`/`not_known` guards above (a defeasible
// rule, since it reads combined_annual_addition_415f -> a sum-over-derived
// aggregate, same LDC-E4103 cascade class as module 17's 424(d) chain).

// =====================================================================
// (g) Aggregation with plans of a controlled/affiliated group — EXTERNAL_DEPENDENCY
// =====================================================================
pub relation employer_treated_as_one_415g(employer1: Person, employer2: Person) kind empirical {
    label en unofficial "employer1 and employer2 are treated as the same employer under section 414(b)/(c) (as modified by section 415(h)) for purposes of section 415, case-asserted — EXTERNAL_DEPENDENCY pending us.irc.corporations's own section 1563(a) chain (see (h) below and this package's pre-existing 12-414-definitions.law controlled-group dependency row)";
}
// The Secretary's own disqualification-order regulations under (g) are not
// modelled (a delegation to regulations this package has no authority to
// exercise, not a computable norm — NON_NORMATIVE by nature, not TECH_GAP).

// =====================================================================
// (h) 50-percent control substitution
// =====================================================================
pub relation controlled_group_member_415h(employer1: Person, employer2: Person) kind empirical {
    label en unofficial "employer1 and employer2 are members of a parent-subsidiary controlled group within the meaning of section 1563(a)(1), substituting 'more than 50 percent' for 'at least 80 percent' per section 415(h), case-asserted — EXTERNAL_DEPENDENCY (the underlying ownership-chain computation is us.irc.corporations's, mid-write; this package cannot yet derive the 50-percent-substituted test from raw ownership facts)";
}

@source(IRC_S415_H, relation = formalizes, coverage = exact, quote = "the phrase \"more than 50 percent\" shall be substituted for the phrase \"at least 80 percent\" each place it appears in section 1563(a)(1)")
rule EmployerTreatedAsOneViaControlledGroup415h(employer1: Person, employer2: Person) strict {
    label en official "the 50-percent-substituted section 1563(a)(1) test is one way to satisfy the (g)/(h) common-control relation";
    when controlled_group_member_415h(employer1, employer2);
    then employer_treated_as_one_415g(employer1, employer2);
}

// =====================================================================
// (k) Defined benefit plan / defined contribution plan — cross-reference definitions
// =====================================================================
pub relation is_section415_defined_contribution_plan(plan: Plan) kind institutional {
    label en official "section 415(k)(1): a plan within section 415(k)(1)(A)-(D) is a defined contribution plan for this section";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "a plan described in section 401(a) which includes a trust which is exempt from tax under section 501(a)")
rule Section415kViaQualifiedTrust(plan: DefinedContributionPlan, y: TaxableYear) strict {
    label en official "(k)(1)(A): a section 401(a)/501(a) qualified-trust defined contribution plan";
    when qualified_plan(plan, y);
    then is_section415_defined_contribution_plan(plan);
}

pub relation individual_medical_benefit_account(account: Plan, participant: Person) kind empirical {
    label en unofficial "a separate individual medical benefit account under a pension or annuity plan, section 415(l)(2), case-asserted";
}

pub relation medical_benefit_account_part_of_plan(account: Plan, plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the individual medical benefit account is part of this defined contribution plan, case-asserted";
}

pub relation medical_account_contribution_415l(account: Plan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions allocated to the individual medical benefit account for the year, case-asserted";
}

pub relation medical_account_annual_addition_415l(plan: DefinedContributionPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(l)(1): contributions allocated to an individual medical benefit account are treated as an annual addition to the defined contribution plan of which it is a part";
}

@source(IRC_S415_L, relation = formalizes, coverage = exact, quote = "contributions allocated to any individual medical benefit account which is part of a pension or annuity plan shall be treated as an annual addition to a defined contribution plan for purposes of subsection (c)")
rule MedicalAccountAnnualAddition415l(plan: DefinedContributionPlan, account: Plan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "restates the medical-account contribution as a section 415(c) annual addition";
    when individual_medical_benefit_account(account, participant)
        and medical_benefit_account_part_of_plan(account, plan)
        and medical_account_contribution_415l(account, participant, y, amount);
    then medical_account_annual_addition_415l(plan, participant, y, amount);
}
// =====================================================================
// SSA readers (IRC-G/G6, 2026-09-27): section 415 rows citing the Social
// Security Act. Pattern G4/CFR: the SSA content enters as case-selected
// facts (values, not package pubs); the from-package leg — reading pubs of
// `us.ssa.title42_values` (govinfo bytes pinned in
// corpus/laws/us/ssa-title42-values/sources/) — waits for registry +
// lock --write + flip (step 6, owner gate).
// =====================================================================
// (b)(8) social security retirement age: (A) without the age increase
// factor, (B) early retirement age as if 62 (rows 26/415/b/8/u1–u3).
pub relation ssra_value_as_applied_415b8(p: Person, age: Integer) kind empirical {
    label en unofficial "the section 216(l) retirement age as applied by section 415(b)(8) for the participant — without the age increase factor, early retirement age 62 — case-asserted from the pinned 42 USC 416 text";
}
pub relation social_security_retirement_age_415b8(p: Person, age: Integer) kind institutional {
    label en official "section 415(b)(8): the social security retirement age of the participant";
}
@source(IRC_S415_B, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, the term \"social security retirement age\" means the age used as the retirement age under section 216(l) of the Social Security Act, except that such section shall be applied—")
rule S415B8SsraFromSsaContent(p: Person, age: Integer) strict {
    label en official "section 415(b)(8) with (A)-(B): the applied section 216(l) age is the social security retirement age";
    when ssra_value_as_applied_415b8(p, age);
    then social_security_retirement_age_415b8(p, age);
}
// (d)(2) cost-of-living procedures similar to section 215(i)(2)(A)
// (rows 26/415/d/2/u2–u3; u2 names the index mechanics, u3 the procedure).
pub relation index_adjustment_follows_ssa_215i2A_procedure_415d2(y: TaxableYear, base_amount: Money, adjusted_amount: Money) kind empirical {
    label en unofficial "the year-over-year index adjustment with section 215(i)(2)(A)-similar procedures, case-asserted from the pinned 42 USC 415 text";
}
pub relation section415d2_ssa_procedure_adjustment(y: TaxableYear, base_amount: Money, adjusted_amount: Money) kind institutional {
    label en official "section 415(d)(2): the cost-of-living adjustment computed with section 215(i)(2)(A)-similar procedures";
}
@source(IRC_S415_D, relation = formalizes, coverage = partial, quote = "(B) adjustment procedures which are similar to the procedures used to adjust benefit amounts under section 215(i)(2)(A) of the Social Security Act.")
rule S415D2SsaProcedureAdjustment(y: TaxableYear, base_amount: Money, adjusted_amount: Money) strict {
    label en official "section 415(d)(2)(B): the section 215(i)(2)(A)-similar adjustment derives the adjusted amount";
    when index_adjustment_follows_ssa_215i2A_procedure_415d2(y, base_amount, adjusted_amount);
    then section415d2_ssa_procedure_adjustment(y, base_amount, adjusted_amount);
}
// (k)(2) qualified cost-of-living arrangement (with its own (k)(2)(B)(i)-
// (F) requirements and (f)(ii) key-employee exclusion), (k)(3) governmental
// repayment carve-out, (k)(4) 403(b)/SEP cross-treatment are NOT modelled
// (TECH_GAP, scope cut this pass).
