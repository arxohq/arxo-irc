// Sections 419 and 419A — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026):
// contributions to welfare benefit funds. The module carries the definition
// of a welfare benefit fund (419(e)-(g)), the deduction limit by the fund's
// qualified cost (419(a)-(d)) and the account limits of section 419A with
// their safe harbors, the key employee separate account, the 10 or more
// employer plan exclusion and the no-limit cases.
//
// Method: the fund's dollar inputs (direct cost, after-tax income, account
// balance, claims) are case-asserted; the arithmetic on them is exact Money
// and percentages are exact decimal fractions rounded to the cent. The
// hypothetical deduction that defines qualified direct cost, the value of
// the account under regulations and the unrelated business income
// computation are not derived (see the coverage rows).

use self::{
    IRC_S419A_B,
    IRC_S419A_C,
    IRC_S419A_D,
    IRC_S419A_E,
    IRC_S419A_F,
    IRC_S419_B,
    IRC_S419_C,
    IRC_S419_D,
    IRC_S419_E,
    IRC_S419_F,
    IRC_S419_G,
    Person,
    TaxableYear,
};

pub entity WelfareBenefitFund419 {
    label en unofficial "a fund through which an employer provides welfare benefits (section 419(e)(1))";
}

pub entity WelfareBenefit419 {
    label en unofficial "a benefit provided through a fund (section 419(e)(2))";
}

pub relation employer_of_fund_419(fund: WelfareBenefitFund419, employer: Person) kind empirical {
    label en unofficial "the employer whose plan the fund is part of, case-asserted";
}

// =====================================================================
// 419(e)-(g) Welfare benefit fund
// =====================================================================

pub relation fund_is_part_of_employer_plan_419e1A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the fund is part of a plan of an employer, case-asserted (section 419(e)(1)(A))";
}

pub relation fund_provides_benefit_419e1B(fund: WelfareBenefitFund419, benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the employer provides this benefit to employees or their beneficiaries through the fund, case-asserted";
}

pub relation benefit_subject_to_83h_419e2A(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "section 83(h) applies to the benefit, case-asserted";
}

pub relation benefit_subject_to_404_419e2B(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "section 404 applies to the benefit (determined without regard to section 404(b)(2)), case-asserted";
}

pub relation benefit_subject_to_404A_419e2C(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "section 404A applies to the benefit, case-asserted";
}

pub relation welfare_benefit_419e2(benefit: WelfareBenefit419) kind institutional {
    label en official "section 419(e)(2): a benefit other than one to which section 83(h), 404 or 404A applies";
}

@source(IRC_S419_E, relation = formalizes, coverage = exact, quote = "The term \"welfare benefit\" means any benefit other than a benefit with respect to which")
rule WelfareBenefit419e2(benefit: WelfareBenefit419) strict {
    label en official "a benefit outside the three excluded regimes; the regimes are case-asserted";
    when fund_provides_benefit_419e1B(_, benefit)
        and not_known(benefit_subject_to_83h_419e2A(benefit))
        and not_known(benefit_subject_to_404_419e2B(benefit))
        and not_known(benefit_subject_to_404A_419e2C(benefit));
    then welfare_benefit_419e2(benefit);
}

pub relation welfare_benefit_fund_defined_419e1(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(e)(1): a fund that is part of an employer plan and through which the employer provides welfare benefits";
}

@source(IRC_S419_E, relation = formalizes, coverage = exact, quote = "The term \"welfare benefit fund\" means any fund")
rule WelfareBenefitFundDefined419e1(fund: WelfareBenefitFund419, benefit: WelfareBenefit419) strict {
    label en official "(A) part of an employer plan and (B) provides a welfare benefit";
    when fund_is_part_of_employer_plan_419e1A(fund)
        and fund_provides_benefit_419e1B(fund, benefit)
        and welfare_benefit_419e2(benefit);
    then welfare_benefit_fund_defined_419e1(fund);
}

pub relation fund_is_section_501c_organization_419e3A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the fund is an organization described in section 501(c)(7), (9) or (17), case-asserted";
}

pub relation fund_is_taxable_organization_419e3B(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the fund is a trust, corporation or other organization not exempt from tax under this chapter, case-asserted";
}

pub relation fund_within_definition_419e3(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(e)(3)(A) and (B): the kinds of organization that are a fund";
}

@source(IRC_S419_E, relation = formalizes, coverage = partial, quote = "any organization described in paragraph (7), (9), or (17) of section 501(c)")
rule FundKindExempt419e3A(fund: WelfareBenefitFund419) strict {
    label en official "PARTIAL: (A); (C) accounts by regulation is not derived";
    when fund_is_section_501c_organization_419e3A(fund);
    then fund_within_definition_419e3(fund);
}

@source(IRC_S419_E, relation = formalizes, coverage = partial, quote = "any trust, corporation, or other organization not exempt from the tax imposed by this chapter")
rule FundKindTaxable419e3B(fund: WelfareBenefitFund419) strict {
    label en official "PARTIAL: (B)";
    when fund_is_taxable_organization_419e3B(fund);
    then fund_within_definition_419e3(fund);
}

pub relation insurer_holds_fund_amounts_under_contract_419e4A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "amounts held by an insurance company under an insurance contract, case-asserted (section 419(e)(4)(A))";
}

pub relation contract_is_life_insurance_264a1_419e4Aii(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the contract is a life insurance contract described in section 264(a)(1), case-asserted";
}

pub relation contract_has_no_renewal_guarantee_419e4Bi_I(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "there is no guarantee of a renewal of the contract, case-asserted";
}

pub relation contract_pays_only_experience_amounts_419e4Bi_II(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "other than insurance protection the only payments to which the employer or employees are entitled are experience rated refunds or policy dividends, case-asserted";
}

pub relation contract_refunds_taken_into_account_in_year_419e4Bii(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the employer treats each experience rated refund or policy dividend as received or accrued in the taxable year in which the policy year ends, case-asserted";
}

pub relation qualified_nonguaranteed_contract_419e4Bi(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(e)(4)(B)(i): a qualified nonguaranteed contract";
}

@source(IRC_S419_E, relation = formalizes, coverage = partial, quote = "there is no guarantee of a renewal of such contract")
rule QualifiedNonguaranteedContract419e4Bi(fund: WelfareBenefitFund419) strict {
    label en official "PARTIAL: (I) and (II) as the two case-asserted elements";
    when contract_has_no_renewal_guarantee_419e4Bi_I(fund) and contract_pays_only_experience_amounts_419e4Bi_II(fund);
    then qualified_nonguaranteed_contract_419e4Bi(fund);
}

pub relation fund_excludes_insurance_amounts_419e4(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(e)(4): amounts held by an insurer under such a contract are not a fund";
}

@source(IRC_S419_E, relation = formalizes, coverage = exact, quote = "such contract is a life insurance contract described in section 264(a)(1)")
rule InsuranceExclusionLife419e4Aii(fund: WelfareBenefitFund419) strict {
    label en official "(A)(ii) first limb";
    when insurer_holds_fund_amounts_under_contract_419e4A(fund) and contract_is_life_insurance_264a1_419e4Aii(fund);
    then fund_excludes_insurance_amounts_419e4(fund);
}

@source(IRC_S419_E, relation = formalizes, coverage = exact, quote = "In the case of any qualified nonguaranteed contract, subparagraph (A) shall not apply unless")
rule InsuranceExclusionNonguaranteed419e4B(fund: WelfareBenefitFund419) strict {
    label en official "(A)(ii) second limb, conditioned by (B)(ii): the refunds are taken into account in the year the policy year ends";
    when insurer_holds_fund_amounts_under_contract_419e4A(fund)
        and qualified_nonguaranteed_contract_419e4Bi(fund)
        and contract_refunds_taken_into_account_in_year_419e4Bii(fund);
    then fund_excludes_insurance_amounts_419e4(fund);
}

pub relation no_plan_but_method_with_effect_of_plan_419f(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "there is no plan but there is a method or arrangement of employer contributions or benefits with the effect of a plan, case-asserted (section 419(f))";
}

pub relation section_419_applies_as_if_plan_419f(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(f): the section applies as if there were a plan";
}

@source(IRC_S419_F, relation = formalizes, coverage = exact, quote = "this section shall apply as if there were a plan")
rule MethodTreatedAsPlan419f(fund: WelfareBenefitFund419) strict {
    label en official "a method or arrangement with the effect of a plan";
    when no_plan_but_method_with_effect_of_plan_419f(fund);
    then section_419_applies_as_if_plan_419f(fund);
}

pub relation fund_lacks_only_employment_relationship_419g(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the fund would be a welfare benefit fund but for the absence of an employee-employer relationship, case-asserted (section 419(g))";
}

pub relation section_419_applies_as_if_employment_419g(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419(g): the section applies as if there were such a relationship and the employer references are to the person for whom services are performed";
}

@source(IRC_S419_G, relation = formalizes, coverage = exact, quote = "this section shall apply as if there were such a relationship")
rule NoEmploymentRelationship419g(fund: WelfareBenefitFund419) strict {
    label en official "the section applies as if there were an employment relationship";
    when fund_lacks_only_employment_relationship_419g(fund);
    then section_419_applies_as_if_employment_419g(fund);
}

// =====================================================================
// 419(b)-(d) Deduction limit by the qualified cost
// =====================================================================

pub relation qualified_direct_cost_419c3(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified direct cost of the taxable year, case-asserted (section 419(c)(3)); the hypothetical deduction that defines it is not derived";
}

pub relation account_addition_proposed_419c1B(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the addition to the qualified asset account for the taxable year, case-asserted";
}

pub relation account_balance_before_addition_419Ab(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount in the qualified asset account before the addition, case-asserted";
}

pub relation account_limit_419Ac(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the account limit of the year under section 419A(c), case-asserted (the sub-limits are derived below)";
}

pub relation account_addition_taken_into_account_419Ab(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(b): the part of the addition that does not lift the account above the account limit";
}

@source(IRC_S419A_B, relation = formalizes, coverage = exact, quote = "No addition to any qualified asset account may be taken into account under section 419(c)(1)(B) to the extent such addition results in the amount in such account exceeding the account limit")
rule AccountAdditionCapped419Ab(fund: WelfareBenefitFund419, y: TaxableYear, added: Money, before: Money, limit: Money) strict {
    label en official "exact boundary: an addition reaching the limit exactly is taken into account in full";
    when account_addition_proposed_419c1B(fund, y, added)
        and account_balance_before_addition_419Ab(fund, y, before)
        and account_limit_419Ac(fund, y, limit);
    then account_addition_taken_into_account_419Ab(fund, y, min(added, max(limit - before, 0.00 USD)));
}

pub relation after_tax_income_419c4(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fund's after-tax income of the taxable year, case-asserted (section 419(c)(4))";
}

pub relation qualified_cost_419c(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(c)(1)-(2): qualified direct cost plus the limited addition to the account, reduced by after-tax income";
}

@source(IRC_S419_C, relation = formalizes, coverage = partial, quote = "the qualified cost for any taxable year shall be reduced by such fund's after-tax income for such taxable year")
rule QualifiedCost419c(fund: WelfareBenefitFund419, y: TaxableYear, direct: Money, added: Money, income: Money) strict {
    label en official "PARTIAL: (1) direct cost plus (B) the limited addition, less (2) after-tax income; a result below zero is read as zero";
    when qualified_direct_cost_419c3(fund, y, direct)
        and account_addition_taken_into_account_419Ab(fund, y, added)
        and after_tax_income_419c4(fund, y, income);
    then qualified_cost_419c(fund, y, max(direct + added - income, 0.00 USD));
}

pub relation employer_contributions_paid_419(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contributions the employer paid to the fund in the taxable year, case-asserted";
}

pub relation excess_carried_in_419d(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess of the preceding year treated as paid in this year, case-asserted (section 419(d))";
}

pub relation contribution_otherwise_deductible_419a2(fund: WelfareBenefitFund419, y: TaxableYear) kind empirical {
    label en unofficial "the contribution would be deductible under this chapter but for section 419, case-asserted";
}

pub relation deductible_contribution_419(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 419(a)(2) and 419(b): the deduction, not above the qualified cost";
}

@source(IRC_S419_B, relation = formalizes, coverage = exact, quote = "The amount of the deduction allowable under subsection (a)(2) for any taxable year shall not exceed the welfare benefit fund's qualified cost for the taxable year")
rule DeductibleContribution419b(fund: WelfareBenefitFund419, y: TaxableYear, paid: Money, carried: Money, cost: Money) strict {
    label en official "exact boundary: contributions equal to the qualified cost are deductible in full; carried-in excess counts as paid";
    when contribution_otherwise_deductible_419a2(fund, y)
        and employer_contributions_paid_419(fund, y, paid)
        and excess_carried_in_419d(fund, y, carried)
        and qualified_cost_419c(fund, y, cost);
    then deductible_contribution_419(fund, y, min(paid + carried, cost));
}

pub relation excess_treated_as_paid_next_year_419d(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(d): the excess over the limit of subsection (b) is treated as paid in the succeeding taxable year";
}

@source(IRC_S419_D, relation = formalizes, coverage = exact, quote = "such excess shall be treated as an amount paid by the employer to such fund during the succeeding taxable year")
rule ExcessCarriedForward419d(fund: WelfareBenefitFund419, y: TaxableYear, paid: Money, carried: Money, cost: Money) strict {
    label en official "exact boundary: an excess of one cent is carried; no excess, no carryover";
    when employer_contributions_paid_419(fund, y, paid)
        and excess_carried_in_419d(fund, y, carried)
        and qualified_cost_419c(fund, y, cost)
        and paid + carried > cost;
    then excess_treated_as_paid_next_year_419d(fund, y, paid + carried - cost);
}

// =====================================================================
// 419A(c) Account limits
// =====================================================================

pub relation sub_direct_costs_two_selected_years_419Ac3A(fund: WelfareBenefitFund419, y: TaxableYear, first: Money, second: Money) kind empirical {
    label en unofficial "the qualified direct costs for SUB or severance pay benefits of the 2 immediately preceding 7 taxable years the fund selects, case-asserted";
}

pub relation sub_account_limit_419Ac3A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(3)(A): 75 percent of the average of the two selected years";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "The account limit for any taxable year with respect to SUB or severance pay benefits is 75 percent of the average annual qualified direct costs for SUB or severance pay benefits for any 2 of the immediately preceding 7 taxable years (as selected by the fund)")
rule SubAccountLimit419Ac3A(fund: WelfareBenefitFund419, y: TaxableYear, a: Money, b: Money) strict {
    label en official "0.75 x (a + b) / 2 = 0.375 x (a + b), rounded to the cent";
    when sub_direct_costs_two_selected_years_419Ac3A(fund, y, a, b);
    then sub_account_limit_419Ac3A(fund, y, round((a + b) * 0.375, 2, "HALF_UP"));
}

pub relation disability_benefit_payable_419Ac4A(fund: WelfareBenefitFund419, y: TaxableYear, benefit: Money, high3_average: Money, limit_415b1A: Money) kind empirical {
    label en unofficial "the annual disability benefit payable to an individual, that individual's high 3 years average compensation and the limitation in effect under section 415(b)(1)(A), case-asserted";
}

pub relation disability_benefit_taken_into_account_419Ac4A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(4)(A): disability benefits not counted above the lesser of 75 percent of high 3 years compensation and the section 415(b)(1)(A) limit";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "75 percent of such individual's average compensation for his high 3 years")
rule DisabilityBenefitCounted419Ac4A(fund: WelfareBenefitFund419, y: TaxableYear, benefit: Money, avg: Money, lim: Money) strict {
    label en official "min(benefit, min(0.75 x average, 415(b)(1)(A) limit))";
    when disability_benefit_payable_419Ac4A(fund, y, benefit, avg, lim);
    then disability_benefit_taken_into_account_419Ac4A(fund, y, min(benefit, min(round(avg * 0.75, 2, "HALF_UP"), lim)));
}

pub relation sub_benefit_payable_419Ac4B(fund: WelfareBenefitFund419, y: TaxableYear, benefit: Money, limit_415c1A: Money) kind empirical {
    label en unofficial "the annual SUB or severance pay benefit payable to an individual and the limitation in effect under section 415(c)(1)(A), case-asserted";
}

pub relation sub_benefit_taken_into_account_419Ac4B(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(4)(B): a SUB or severance pay benefit is not counted above 150 percent of the section 415(c)(1)(A) limit";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "in excess of 150 percent of the limitation in effect under section 415(c)(1)(A)")
rule SubBenefitCounted419Ac4B(fund: WelfareBenefitFund419, y: TaxableYear, benefit: Money, lim: Money) strict {
    label en official "min(benefit, 1.5 x limit)";
    when sub_benefit_payable_419Ac4B(fund, y, benefit, lim);
    then sub_benefit_taken_into_account_419Ac4B(fund, y, min(benefit, round(lim * 1.5, 2, "HALF_UP")));
}

pub relation prior_year_direct_costs_short_term_disability_419Ac5Bi(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified direct costs (other than insurance premiums) of the immediately preceding taxable year for short-term disability benefits, case-asserted";
}

pub relation safe_harbor_short_term_disability_419Ac5Bi(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(5)(B)(i): 17.5 percent of the preceding year's direct costs";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "the safe harbor limit for any taxable year is 17.5 percent of the qualified direct costs")
rule SafeHarborShortTermDisability419Ac5Bi(fund: WelfareBenefitFund419, y: TaxableYear, prior: Money) strict {
    label en official "0.175 x prior year direct costs, rounded to the cent";
    when prior_year_direct_costs_short_term_disability_419Ac5Bi(fund, y, prior);
    then safe_harbor_short_term_disability_419Ac5Bi(fund, y, round(prior * 0.175, 2, "HALF_UP"));
}

pub relation prior_year_direct_costs_medical_419Ac5Bii(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified direct costs (other than insurance premiums) of the immediately preceding taxable year for medical benefits, case-asserted";
}

pub relation safe_harbor_medical_419Ac5Bii(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(5)(B)(ii): 35 percent of the preceding year's direct costs";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "the safe harbor limit for any taxable year is 35 percent of the qualified direct costs")
rule SafeHarborMedical419Ac5Bii(fund: WelfareBenefitFund419, y: TaxableYear, prior: Money) strict {
    label en official "0.35 x prior year direct costs, rounded to the cent";
    when prior_year_direct_costs_medical_419Ac5Bii(fund, y, prior);
    then safe_harbor_medical_419Ac5Bii(fund, y, round(prior * 0.35, 2, "HALF_UP"));
}

pub relation regulation_safe_harbor_amount_419Ac5Biv(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the safe harbor limit for long-term disability and life insurance benefits as prescribed by regulations, case-asserted (SOURCE_GAP: the regulation is not pinned)";
}

pub relation account_limit_ceiling_without_certification_419Ac5A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(5)(A): without an actuarial certification the account limit does not exceed the sum of the safe harbor limits";
}

pub relation actuarial_certification_of_account_limit_419Ac5A(fund: WelfareBenefitFund419, y: TaxableYear) kind empirical {
    label en unofficial "there is an actuarial certification of the account limit for the taxable year, case-asserted";
}

@source(IRC_S419A_C, relation = formalizes, coverage = partial, quote = "Unless there is an actuarial certification of the account limit determined under this subsection for any taxable year, the account limit for such taxable year shall not exceed the sum of the safe harbor limits for such taxable year")
rule AccountLimitCeiling419Ac5A(fund: WelfareBenefitFund419, y: TaxableYear, st: Money, med: Money, sub: Money, reg: Money) strict {
    label en official "PARTIAL: short-term disability + medical + SUB limit of (3) + the regulation amount for long-term disability and life insurance, all case-supplied; no certification";
    when safe_harbor_short_term_disability_419Ac5Bi(fund, y, st)
        and safe_harbor_medical_419Ac5Bii(fund, y, med)
        and sub_account_limit_419Ac3A(fund, y, sub)
        and regulation_safe_harbor_amount_419Ac5Biv(fund, y, reg)
        and not_known(actuarial_certification_of_account_limit_419Ac5A(fund, y));
    then account_limit_ceiling_without_certification_419Ac5A(fund, y, st + med + sub + reg);
}

pub relation bona_fide_association_medical_plan_419Ac6B(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the account is for medical benefits provided through a plan maintained by a bona fide association, case-asserted (section 419A(c)(6)(B))";
}

pub relation medical_direct_costs_and_claims_change_419Ac6A(fund: WelfareBenefitFund419, y: TaxableYear, direct: Money, change: Money) kind empirical {
    label en unofficial "the qualified direct costs and the change in claims incurred but unpaid for medical benefits (other than post-retirement), case-asserted";
}

pub relation bona_fide_association_reserve_ceiling_419Ac6A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(c)(6)(A): the reserve does not exceed 35 percent of the sum of direct costs and the change in claims";
}

@source(IRC_S419A_C, relation = formalizes, coverage = exact, quote = "An applicable account limit for any taxable year may include a reserve in an amount not to exceed 35 percent of the sum of")
rule BonaFideAssociationReserve419Ac6A(fund: WelfareBenefitFund419, y: TaxableYear, direct: Money, change: Money) strict {
    label en official "0.35 x (direct costs + change in claims), rounded to the cent; only for an applicable account limit";
    when bona_fide_association_medical_plan_419Ac6B(fund) and medical_direct_costs_and_claims_change_419Ac6A(fund, y, direct, change);
    then bona_fide_association_reserve_ceiling_419Ac6A(fund, y, round((direct + change) * 0.35, 2, "HALF_UP"));
}

// =====================================================================
// 419A(d)-(e) Key employees and post-retirement reserves
// =====================================================================

pub relation reserve_first_taken_year_close_419Ad1(fund: WelfareBenefitFund419, close: Date) kind empirical {
    label en unofficial "the close of the first taxable year for which a reserve is taken into account under subsection (c)(2), case-asserted";
}

pub relation key_employee_separate_account_established_419Ad1A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "a separate account is established for the medical and life insurance benefits of the key employee, case-asserted";
}

pub relation pays_postretirement_benefit_of_key_employee_from_other_account_419Ad1B(employer: Person, fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the employer causes a post-retirement medical or life insurance benefit of a key employee to be paid from other than the separate account, case-asserted (action atom)";
}

pub relation key_employee_reserve_in_effect_419Ad1(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "a reserve for post-retirement medical or life insurance benefits of a key employee is taken into account, case-asserted";
}

@source(IRC_S419A_D, relation = formalizes, coverage = exact, quote = "a separate account shall be established for any medical benefits or life insurance benefits provided with respect to such employee")
rule KeyEmployeeSeparateAccountDuty419Ad1A(fund: WelfareBenefitFund419, employer: Person, close: Date) strict {
    label en official "(A): the duty falls due by the close of the first year a reserve is taken";
    when key_employee_reserve_in_effect_419Ad1(fund)
        and employer_of_fund_419(fund, employer)
        and reserve_first_taken_year_close_419Ad1(fund, close);
    then duty EstablishKeyEmployeeSeparateAccountDuty {
        bearer employer;
        goal achievement {
            condition key_employee_separate_account_established_419Ad1A(fund);
            window [-infinity, close];
        }
    };
}

@source(IRC_S419A_D, relation = formalizes, coverage = exact, quote = "medical benefits and life insurance benefits provided with respect to such employee after retirement may only be paid from such separate account")
rule KeyEmployeePaymentProhibition419Ad1B(fund: WelfareBenefitFund419, employer: Person) strict {
    label en official "(B): the post-retirement benefits of the key employee may be paid only from the separate account";
    when key_employee_reserve_in_effect_419Ad1(fund) and employer_of_fund_419(fund, employer);
    then prohibition PayKeyEmployeeBenefitFromOtherAccountProhibition {
        bearer employer;
        action pays_postretirement_benefit_of_key_employee_from_other_account_419Ad1B(employer, fund);
        window [-infinity, infinity];
    };
}

pub relation life_insurance_benefit_to_be_provided_419Ae2(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of life insurance benefits to be provided with respect to the employee, case-asserted";
}

pub relation life_insurance_reserve_base_419Ae2(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(e)(2): the life insurance benefits counted in the reserve do not exceed $50,000";
}

@source(IRC_S419A_E, relation = formalizes, coverage = exact, quote = "to the extent the aggregate amount of such benefits to be provided with respect to the employee exceeds $50,000")
rule LifeInsuranceReserveCap419Ae2(fund: WelfareBenefitFund419, y: TaxableYear, benefit: Money) strict {
    label en official "exact boundary: 50,000.00 is counted in full; the excess is not";
    when life_insurance_benefit_to_be_provided_419Ae2(fund, y, benefit);
    then life_insurance_reserve_base_419Ae2(fund, y, min(benefit, 50000.00 USD));
}

// =====================================================================
// 419A(f) Special cases
// =====================================================================

pub relation fund_covered_by_collective_bargaining_agreement_419Af5A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the separate welfare benefit fund is under a collective bargaining agreement, case-asserted";
}

pub relation pay_all_plan_employees_419Af5B(fund: WelfareBenefitFund419, employees: Integer) kind empirical {
    label en unofficial "the fund is an employee pay-all plan under section 501(c)(9) with this many employees (determined without regard to subsection (h)(1)), case-asserted";
}

pub relation employee_refund_other_than_experience_419Af5Bii(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "an employee is entitled to a refund other than one based on the experience of the entire fund, case-asserted";
}

pub relation no_account_limits_419Af5(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419A(f)(5): no account limits apply";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "(A) under a collective bargaining agreement")
rule NoAccountLimitsBargained419Af5A(fund: WelfareBenefitFund419) strict {
    label en official "(A)";
    when fund_covered_by_collective_bargaining_agreement_419Af5A(fund);
    then no_account_limits_419Af5(fund);
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "such plan has at least 50 employees")
rule NoAccountLimitsPayAll419Af5B(fund: WelfareBenefitFund419, n: Integer) strict {
    label en official "(B): exact boundary: 50 employees suffice; no employee refund other than experience-based";
    when pay_all_plan_employees_419Af5B(fund, n) and n >= 50 and not_known(employee_refund_other_than_experience_419Af5Bii(fund));
    then no_account_limits_419Af5(fund);
}

pub relation employers_contributing_419Af6(fund: WelfareBenefitFund419, count: Integer, largest_share: Decimal) kind empirical {
    label en unofficial "the number of employers that contribute to the plan and the largest share of total contributions any one employer normally contributes (a fraction), case-asserted";
}

pub relation plan_maintains_experience_rating_419Af6A(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "the plan maintains experience-rating arrangements with respect to individual employers, case-asserted";
}

pub relation ten_or_more_employer_plan_419Af6B(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419A(f)(6)(B): more than 1 employer contributes and none normally contributes more than 10 percent";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "to which no employer normally contributes more than 10 percent of the total contributions")
rule TenOrMoreEmployerPlan419Af6B(fund: WelfareBenefitFund419, n: Integer, share: Decimal) strict {
    label en official "exact boundary: a share of exactly 0.10 is not more than 10 percent";
    when employers_contributing_419Af6(fund, n, share) and n > 1 and share <= 0.10;
    then ten_or_more_employer_plan_419Af6B(fund);
}

pub relation subpart_does_not_apply_ten_or_more_employer_419Af6A(fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419A(f)(6)(A): the subpart does not apply to a fund of a 10 or more employer plan without experience rating";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "This subpart shall not apply in the case of any welfare benefit fund which is part of a 10 or more employer plan")
rule SubpartInapplicableTenOrMore419Af6A(fund: WelfareBenefitFund419) strict {
    label en official "the exclusion is withdrawn when the plan maintains experience rating for individual employers";
    when ten_or_more_employer_plan_419Af6B(fund) and not_known(plan_maintains_experience_rating_419Af6A(fund));
    then subpart_does_not_apply_ten_or_more_employer_419Af6A(fund);
}
