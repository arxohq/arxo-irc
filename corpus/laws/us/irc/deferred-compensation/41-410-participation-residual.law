// Section 410 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 10 carries the age and service requirement, the ratio percentage test, the
// 70 percent test and the coverage conclusion. This module adds (a)(1)(B)
// the educational institution rule, (a)(2) the age exclusion, (a)(4) the
// entry date, (b)(2) the average benefit percentage test, (b)(3) and (b)(4)
// the employees excluded from consideration, (b)(6) the transition, TCESOP,
// section 401(k) and HCE-only rules, and (c) the plans outside the section.
// The service computation of (a)(3) and (a)(5) uses the same rules as section
// 411(a)(5)-(6), which module 33 derives.
//
// Method: exact integer cross-multiplication for percentages, exact date
// arithmetic; the classification found by the Secretary not to be
// discriminatory is an asserted fact.

// =====================================================================
// (a)(1)(B) Educational institution plans; (a)(2) Age exclusions; (a)(4) Entry date
// =====================================================================

use self::{
    IRC_S410_A,
    IRC_S410_B,
    IRC_S410_C,
    Person,
    Plan,
    TaxableYear,
    church_plan_414e,
    governmental_plan_414d,
    plan_sponsor,
};

pub relation educational_institution_plan_immediate_vesting_410a1Bii(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained exclusively for employees of an educational institution by a section 501(a) exempt employer and gives each participant with at least 1 year of service full and immediate vesting, case-asserted (section 410(a)(1)(B)(ii))";
}

pub relation minimum_participation_age_410a(plan: Plan, age: Integer) kind institutional {
    label en official "section 410(a)(1)(A)(i), (B)(ii): the maximum minimum age the plan may require is 21 (26 for the educational institution plan with immediate vesting)";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "the age of 21")
rule MinimumParticipationAgeGeneral410a(plan: Plan) strict {
    label en official "age 21";
    when plan_sponsor(plan, _) and not_known(educational_institution_plan_immediate_vesting_410a1Bii(plan));
    then minimum_participation_age_410a(plan, 21);
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "clause (i) of subparagraph (A) shall be applied by substituting \"26\" for")
rule MinimumParticipationAgeEducational410a(plan: Plan) strict {
    label en official "age 26 for the educational institution plan";
    when educational_institution_plan_immediate_vesting_410a1Bii(plan);
    then minimum_participation_age_410a(plan, 26);
}

pub relation plan_requires_age_and_service_410a(plan: Plan, age: Integer) kind empirical {
    label en unofficial "the minimum age the plan requires as a condition of participation, case-asserted";
}

pub relation minimum_age_exceeds_limit_410a(plan: Plan) kind institutional {
    label en official "the plan requires a minimum age above the section 410(a)(1) limit";
}

@source(IRC_S410_A, relation = formalizes, coverage = partial, quote = "requires, as a condition of participation in the plan, that an employee complete a period of service with the employer or employers maintaining the plan extending beyond the later of the following dates")
rule MinimumAgeExceedsLimit410a(plan: Plan, required: Integer, limit: Integer) strict {
    label en official "PARTIAL: exact boundary: a required age equal to the limit is allowed; the 1-year service limb is module 10";
    when plan_requires_age_and_service_410a(plan, required) and minimum_participation_age_410a(plan, limit) and required > limit;
    then minimum_age_exceeds_limit_410a(plan);
}

pub relation plan_excludes_on_basis_of_age_410a2(plan: Plan) kind empirical {
    label en unofficial "the plan excludes from participation employees who have attained a specified age, case-asserted (section 410(a)(2))";
}

pub relation maximum_age_exclusion_violation_410a2(plan: Plan) kind institutional {
    label en official "section 410(a)(2): a plan may not exclude employees from participation on the basis of attaining a specified age";
}

@source(IRC_S410_A, relation = formalizes, coverage = exact, quote = "excludes from participation (on the basis of age) employees who have attained a specified age")
rule MaximumAgeExclusionViolation410a2(plan: Plan) strict {
    label en official "the exclusion is the violation";
    when plan_excludes_on_basis_of_age_410a2(plan);
    then maximum_age_exclusion_violation_410a2(plan);
}

pub relation requirements_satisfied_on_410a4(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the employee satisfied the minimum age and service requirements, case-asserted (section 410(a)(4))";
}

pub relation first_plan_year_start_after_410a4(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first day of the first plan year beginning after the date the requirements were satisfied, case-asserted ((A))";
}

pub relation latest_entry_date_410a4(employee: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 410(a)(4): participation must commence no later than the earlier of the first plan year start after satisfying the requirements and 6 months after";
}

@source(IRC_S410_A, relation = formalizes, coverage = partial, quote = "commences participation in the plan no later than the earlier of")
rule LatestEntryDate410a4(employee: Person, plan: Plan, satisfied: Date, plan_year: Date) strict {
    label en official "PARTIAL: min(first plan year start after, satisfied + 6 months); the exception for an employee who separated before the date is not gated";
    when requirements_satisfied_on_410a4(employee, plan, satisfied) and first_plan_year_start_after_410a4(employee, plan, plan_year);
    then latest_entry_date_410a4(employee, plan, min(plan_year, add_calendar_period(satisfied, 6 calendar_month)));
}

// =====================================================================
// (b)(2) Nondiscriminatory classification and average benefit percentage
// =====================================================================

pub relation classification_found_nondiscriminatory_410b2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan benefits employees who qualify under a classification set up by the employer and found by the Secretary not to be discriminatory in favor of highly compensated employees, case-asserted ((b)(2)(A)(i))";
}

pub relation average_benefit_percentages_410b2(plan: Plan, y: TaxableYear, nhce_pct: Decimal, hce_pct: Decimal) kind empirical {
    label en unofficial "the average benefit percentage of the group of employees who are not highly compensated and of the highly compensated group, each as a fraction of compensation, case-asserted ((b)(2)(A)(ii), (B))";
}

pub relation average_benefit_percentage_test_met_410b2Aii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(2)(A)(ii): the average benefit percentage of the nonhighly compensated group is at least 70 percent of that of the highly compensated group";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the average benefit percentage for employees who are not highly compensated employees is at least 70 percent of the average benefit percentage for highly compensated employees")
rule AverageBenefitPercentageTestMet410b2Aii(plan: Plan, y: TaxableYear, nhce: Decimal, hce: Decimal) strict {
    label en official "exact boundary by cross-multiplication: nhce x 100 >= hce x 70";
    when average_benefit_percentages_410b2(plan, y, nhce, hce) and nhce * 100.0 >= hce * 70.0;
    then average_benefit_percentage_test_met_410b2Aii(plan, y);
}

pub relation meets_410b2A_nondiscriminatory_classification_test(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(2)(A): the classification is found nondiscriminatory and the average benefit percentage test is met";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "A plan shall be treated as meeting the requirements of this paragraph if")
rule Meets410b2ATest(plan: Plan, y: TaxableYear) strict {
    label en official "(i) and (ii)";
    when classification_found_nondiscriminatory_410b2(plan, y) and average_benefit_percentage_test_met_410b2Aii(plan, y);
    then meets_410b2A_nondiscriminatory_classification_test(plan, y);
}

// =====================================================================
// (b)(3), (b)(4) Employees excluded from consideration
// =====================================================================

pub enum ExcludedEmployeeKind410b3 {
    CollectiveBargainingUnit;
    AirPilotAgreementNonCovered;
    NonresidentAlienWithoutUsSourceIncome;
    OrdinaryEmployee;
}

pub relation employee_kind_410b3(employee: Person, plan: Plan, kind: ExcludedEmployeeKind410b3) kind empirical {
    label en unofficial "the employee's status for the exclusions of section 410(b)(3), case-asserted";
}

pub relation employee_excluded_from_consideration_410b3(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(b)(3): employees in a collective bargaining unit (with good faith retirement bargaining), non-covered employees under an air pilot agreement, and nonresident aliens without United States source earned income are excluded from consideration";
}

@source(IRC_S410_B, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, there shall be excluded from consideration")
rule EmployeeExcludedFromConsideration410b3(employee: Person, plan: Plan, kind: ExcludedEmployeeKind410b3) strict {
    label en official "PARTIAL: the three kinds; the section 410(b)(3) last sentence on retirement benefit bargaining is inside the asserted kind";
    when employee_kind_410b3(employee, plan, kind) and kind != OrdinaryEmployee;
    then employee_excluded_from_consideration_410b3(employee, plan);
}

pub relation plan_prescribes_minimum_age_service_and_excludes_410b4A(plan: Plan) kind empirical {
    label en unofficial "the plan prescribes minimum age and service requirements and excludes all employees not meeting them, case-asserted (section 410(b)(4)(A))";
}

pub relation employee_of_plan_employer_410b4(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the person is an employee of an employer maintaining the plan, case-asserted";
}

pub relation employee_meets_age_service_410b4(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee meets the plan's minimum age and service requirements, case-asserted";
}

pub relation employee_excluded_by_age_service_410b4A(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(b)(4)(A): employees not meeting the minimum age and service requirements are excluded from consideration when the plan excludes them from participation";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "then such employees shall be excluded from consideration for purposes of this subsection")
rule EmployeeExcludedByAgeService410b4A(employee: Person, plan: Plan) strict {
    label en official "the plan excludes them and they do not meet the requirements";
    when plan_prescribes_minimum_age_service_and_excludes_410b4A(plan) and employee_of_plan_employer_410b4(employee, plan) and not_known(employee_meets_age_service_410b4(employee, plan));
    then employee_excluded_by_age_service_410b4A(employee, plan);
}

// =====================================================================
// (b)(6) Special rules
// =====================================================================

pub relation group_change_date_410b6C(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date a person becomes or ceases to be a member of a controlled group or affiliated service group, case-asserted (section 410(b)(6)(C))";
}

pub relation coverage_met_before_change_410b6C(plan: Plan) kind empirical {
    label en unofficial "the coverage requirements were met immediately before each change, case-asserted ((C)(i)(I))";
}

pub relation coverage_not_significantly_changed_410b6C(plan: Plan) kind empirical {
    label en unofficial "the coverage under the plan is not significantly changed during the transition period other than by reason of the change, case-asserted ((C)(i)(II))";
}

pub relation plan_year_end_after_change_410b6C(plan: Plan, on: Date) kind empirical {
    label en unofficial "the last day of the first plan year beginning after the date of the change, case-asserted ((C)(ii)(II))";
}

pub relation evaluated_on_410b6C(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date on which the transition relief is evaluated, case-asserted";
}

pub relation coverage_requirements_treated_as_met_410b6C(plan: Plan) kind institutional {
    label en official "section 410(b)(6)(C): during the transition period after a change in a controlled group the coverage requirements are treated as met when they were met before and coverage is not significantly changed";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "then the requirements of this subsection shall be treated as having been met during the transition period")
rule CoverageRequirementsTreatedAsMet410b6C(plan: Plan, change: Date, end: Date, today: Date) strict {
    label en official "exact boundaries: from the change date through the last day of the first plan year after it";
    when group_change_date_410b6C(plan, change)
        and plan_year_end_after_change_410b6C(plan, end)
        and evaluated_on_410b6C(plan, today)
        and coverage_met_before_change_410b6C(plan)
        and coverage_not_significantly_changed_410b6C(plan)
        and today >= change
        and today <= end;
    then coverage_requirements_treated_as_met_410b6C(plan);
}

pub relation tcesop_only_plan_410b6D(plan: Plan) kind empirical {
    label en unofficial "the plan is a tax credit employee stock ownership plan and the only plan of the employer intended to qualify under section 401(a), case-asserted (section 410(b)(6)(D))";
}

pub relation tcesop_benefiting_counts_410b6D(plan: Plan, eligible: Integer, benefiting: Integer) kind empirical {
    label en unofficial "the employees eligible under a nondiscriminatory classification and those benefiting, case-asserted ((D)(i))";
}

pub relation tcesop_allocation_and_compensation_410b6D(plan: Plan, allocated: Money, compensation: Money) kind empirical {
    label en unofficial "the sum of the amounts allocated to participants' accounts and their compensation, case-asserted ((D)(ii))";
}

pub relation tcesop_coverage_relief_410b6D(plan: Plan) kind institutional {
    label en official "section 410(b)(6)(D): a sole tax credit ESOP does not fail the section merely because it benefits at least 50 percent of eligible employees and allocates at most 2 percent of compensation";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "the sum of the amounts allocated to each participant's account for the year does not exceed 2 percent of the compensation of that participant for the year")
rule TcesopCoverageRelief410b6D(plan: Plan, eligible: Integer, benefiting: Integer, allocated: Money, compensation: Money) strict {
    label en official "exact boundaries by cross-multiplication: benefiting x 100 >= eligible x 50 and allocated x 100 <= compensation x 2";
    when tcesop_only_plan_410b6D(plan)
        and tcesop_benefiting_counts_410b6D(plan, eligible, benefiting)
        and tcesop_allocation_and_compensation_410b6D(plan, allocated, compensation)
        and eligible > 0
        and benefiting * 100 >= eligible * 50
        and allocated * 100.0 <= compensation * 2.0;
    then tcesop_coverage_relief_410b6D(plan);
}

pub relation employee_eligible_to_defer_410b6E(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is eligible to contribute (or elect contributions) under a section 401(k) or 401(m) plan, case-asserted (section 410(b)(6)(E))";
}

pub relation employee_treated_as_benefiting_410b6E(employee: Person, plan: Plan) kind institutional {
    label en official "section 410(b)(6)(E): employees eligible to make elective contributions are treated as benefiting (other than for the average benefit percentage test)";
}

@source(IRC_S410_B, relation = formalizes, coverage = partial, quote = "employees who are eligible to contribute (or elect to have contributions made on their behalf) shall be treated as benefiting under the plan")
rule EmployeeTreatedAsBenefiting410b6E(employee: Person, plan: Plan) strict {
    label en official "PARTIAL: the exclusion of the (b)(2)(A)(ii) test is not gated";
    when employee_eligible_to_defer_410b6E(employee, plan);
    then employee_treated_as_benefiting_410b6E(employee, plan);
}

pub relation employer_has_only_hces_410b6F(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer has no employees other than highly compensated employees for the year, case-asserted (section 410(b)(6)(F))";
}

pub relation plan_treated_as_meeting_410b_hce_only_410b6F(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 410(b)(6)(F): a plan of an employer with only highly compensated employees is treated as meeting the section";
}

@source(IRC_S410_B, relation = formalizes, coverage = exact, quote = "A plan maintained by an employer which has no employees other than highly compensated employees for any year shall be treated as meeting the requirements of this subsection for such year")
rule PlanTreatedAsMeeting410bHceOnly(plan: Plan, y: TaxableYear, employer: Person) strict {
    label en official "the sponsor has only highly compensated employees";
    when plan_sponsor(plan, employer) and employer_has_only_hces_410b6F(employer, y);
    then plan_treated_as_meeting_410b_hce_only_410b6F(plan, y);
}

// =====================================================================
// (c) Plans outside the section
// =====================================================================

pub relation church_plan_without_410d_election_410c(plan: Plan) kind empirical {
    label en unofficial "the church plan has no election under subsection (d) in effect, case-asserted (section 410(c)(1)(B))";
}

pub relation plan_without_employer_contributions_since_1974_410c(plan: Plan) kind empirical {
    label en unofficial "the plan has not at any time after September 2, 1974 provided for employer contributions, case-asserted ((C))";
}

pub relation fraternal_society_plan_410c(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained by a society, order or association described in section 501(c)(8) or (9), case-asserted ((D))";
}

pub relation section_410_inapplicable_410c1(plan: Plan) kind institutional {
    label en official "section 410(c)(1): the section (other than paragraph (2)) does not apply to a governmental plan, a church plan without the election, a plan with no employer contributions since September 2, 1974, or a qualifying society plan";
}

@source(IRC_S410_C, relation = formalizes, coverage = exact, quote = "a governmental plan (within the meaning of section 414(d))")
rule Section410InapplicableGovernmental(plan: Plan) strict {
    label en official "(A), through the section 414(d) classification of module 28";
    when governmental_plan_414d(plan);
    then section_410_inapplicable_410c1(plan);
}

@source(IRC_S410_C, relation = formalizes, coverage = exact, quote = "a church plan (within the meaning of section 414(e)) with respect to which the election provided by subsection (d) of this section has not been made")
rule Section410InapplicableChurch(plan: Plan) strict {
    label en official "(B), through the section 414(e) classification of module 28";
    when church_plan_414e(plan) and church_plan_without_410d_election_410c(plan);
    then section_410_inapplicable_410c1(plan);
}

@source(IRC_S410_C, relation = formalizes, coverage = exact, quote = "a plan which has not at any time after September 2, 1974, provided for employer contributions")
rule Section410InapplicableNoEmployerContributions(plan: Plan) strict {
    label en official "(C)";
    when plan_without_employer_contributions_since_1974_410c(plan);
    then section_410_inapplicable_410c1(plan);
}

@source(IRC_S410_C, relation = formalizes, coverage = partial, quote = "a plan established and maintained by a society, order, or association described in section 501(c)(8) or (9)")
rule Section410InapplicableSociety(plan: Plan) strict {
    label en official "PARTIAL: (D); the condition on employer-provided benefits is inside the asserted fact";
    when fraternal_society_plan_410c(plan);
    then section_410_inapplicable_410c1(plan);
}
