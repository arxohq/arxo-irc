// Sections 412, 413 and 408A residuals — STAGE 3b (deferred-compensation,
// TECH_GAP reduction, 26.09.2026). Section 413 deeming rules ("applied as if
// all employees were employed by a single employer") are one relation over
// an enumeration of the provisions so treated; the plan kind and the plan
// administrator's election are case-asserted. Allocations "in accordance with
// regulations" are not pinned.

// =====================================================================
// 413 Collectively bargained, multiple employer and CSEC plans
// =====================================================================

use self::{
    AffiliatedServiceRequirement414m4,
    IRC_S408A_B,
    IRC_S408A_C,
    IRC_S408A_D,
    IRC_S408A_E,
    IRC_S412_B,
    IRC_S412_C,
    IRC_S412_D,
    IRC_S412_E,
    IRC_S413_B,
    IRC_S413_C,
    IRC_S413_D,
    IRC_S413_E,
    LeasedEmployeeRequirement414n3,
    Person,
    Plan,
    PlanFundingKind412,
    TaxableYear,
};

pub enum SingleEmployerProvision413 {
    Section410;
    Section410a;
    Section401a4AndSection411d3;
    Section411;
    Section411ExceptD3;
    Section412;
    Section404a;
    ExclusiveBenefit401a;
}

pub enum PlanKind413 {
    CollectivelyBargained413b;
    MultipleEmployer413c;
    Csec413d;
    Other;
}

pub relation plan_kind_413(plan: Plan, kind: PlanKind413) kind empirical {
    label en unofficial "the plan is a collectively bargained plan (subsection (b)), a multiple employer plan (subsection (c)) or a CSEC plan (subsection (d)), case-asserted";
}

pub relation plan_covers_professional_employee_413b9(plan: Plan) kind empirical {
    label en unofficial "the plan covers a professional employee, case-asserted";
}

pub relation plan_administrator_elected_subparagraph_a_413c4B(plan: Plan) kind empirical {
    label en unofficial "the plan administrator made the election under paragraph (4)(B) to have subparagraph (A) apply, case-asserted";
}

pub relation single_employer_treatment_413(plan: Plan, provision: SingleEmployerProvision413) kind institutional {
    label en official "section 413: the provision is applied as if all employees or participants were employed by a single employer";
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "Section 410 shall be applied as if all employees of each of the employers who are parties to the collective-bargaining agreement and who are subject to the same benefit computation formula under the plan were employed by a single employer")
rule SingleEmployerSection410CollectivelyBargained413b1(plan: Plan) strict {
    label en official "(b)(1), except for a professional-employee plan (b)(9)";
    when plan_kind_413(plan, CollectivelyBargained413b)
        and not_known(plan_covers_professional_employee_413b9(plan));
    then single_employer_treatment_413(plan, Section410);
}

@source(IRC_S413_B, relation = formalizes, coverage = partial, quote = "paragraph (1) shall be applied by substituting \"section 410(a)\" for \"section 410\"")
rule SingleEmployerSection410aProfessional413b9(plan: Plan) strict {
    label en official "PARTIAL: (b)(9) first limb; the second limb (paragraph (2)) is not modelled";
    when plan_kind_413(plan, CollectivelyBargained413b)
        and plan_covers_professional_employee_413b9(plan);
    then single_employer_treatment_413(plan, Section410a);
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "Sections 401(a)(4) and 411(d)(3) shall be applied as if all participants who are subject to the same benefit computation formula")
rule SingleEmployerSections401a4And411d3413b2(plan: Plan) strict {
    label en official "(b)(2)";
    when plan_kind_413(plan, CollectivelyBargained413b);
    then single_employer_treatment_413(plan, Section401a4AndSection411d3);
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "all plan participants shall be considered to be his employees")
rule ExclusiveBenefitCollectivelyBargained413b3(plan: Plan) strict {
    label en official "(b)(3)";
    when plan_kind_413(plan, CollectivelyBargained413b);
    then single_employer_treatment_413(plan, ExclusiveBenefit401a);
}

@source(IRC_S413_B, relation = formalizes, coverage = partial, quote = "Section 411 (other than subsection (d)(3)) shall be applied as if all employers who have been parties to the collective-bargaining agreement constituted a single employer")
rule SingleEmployerSection411CollectivelyBargained413b4(plan: Plan) strict {
    label en official "PARTIAL: the break-in-service exception is the Secretary's regulations (not pinned)";
    when plan_kind_413(plan, CollectivelyBargained413b);
    then single_employer_treatment_413(plan, Section411ExceptD3);
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "The minimum funding standard provided by section 412 shall be determined as if all participants in the plan were employed by a single employer")
rule SingleEmployerSection412CollectivelyBargained413b5(plan: Plan) strict {
    label en official "(b)(5)";
    when plan_kind_413(plan, CollectivelyBargained413b);
    then single_employer_treatment_413(plan, Section412);
}

@source(IRC_S413_B, relation = formalizes, coverage = partial, quote = "Each applicable limitation provided by section 404(a) shall be determined as if all participants in the plan were employed by a single employer")
rule SingleEmployerSection404aCollectivelyBargained413b7(plan: Plan) strict {
    label en official "PARTIAL: the allocation of amounts contributed by each employer is the second sentence";
    when plan_kind_413(plan, CollectivelyBargained413b);
    then single_employer_treatment_413(plan, Section404a);
}

@source(IRC_S413_C, relation = formalizes, coverage = exact, quote = "Section 410(a) shall be applied as if all employees of each of the employers who maintain the plan were employed by a single employer")
rule SingleEmployerSection410aMultipleEmployer413c1(plan: Plan) strict {
    label en official "(c)(1); also (d)(2) for a CSEC plan";
    when plan_kind_413(plan, MultipleEmployer413c);
    then single_employer_treatment_413(plan, Section410a);
}

@source(IRC_S413_C, relation = formalizes, coverage = exact, quote = "all plan participants shall be considered to be his employees")
rule ExclusiveBenefitMultipleEmployer413c2(plan: Plan) strict {
    label en official "(c)(2)";
    when plan_kind_413(plan, MultipleEmployer413c);
    then single_employer_treatment_413(plan, ExclusiveBenefit401a);
}

@source(IRC_S413_C, relation = formalizes, coverage = partial, quote = "Section 411 shall be applied as if all employers who maintain the plan constituted a single employer")
rule SingleEmployerSection411MultipleEmployer413c3(plan: Plan) strict {
    label en official "PARTIAL: the break-in-service rule is the Secretary's regulations (not pinned)";
    when plan_kind_413(plan, MultipleEmployer413c);
    then single_employer_treatment_413(plan, Section411);
}

@source(IRC_S413_C, relation = formalizes, coverage = partial, quote = "the requirements of section 412 shall be determined as if all participants in the plan were employed by a single employer unless the plan administrator elects")
rule SingleEmployerSection412MultipleEmployer413c4B(plan: Plan) strict {
    label en official "PARTIAL: (c)(4)(B); the election deadline and effective plan year are not modelled";
    when plan_kind_413(plan, MultipleEmployer413c)
        and not_known(plan_administrator_elected_subparagraph_a_413c4B(plan));
    then single_employer_treatment_413(plan, Section412);
}

@source(IRC_S413_C, relation = formalizes, coverage = partial, quote = "each applicable limitation provided by section 404(a) shall be determined as if all participants in the plan were employed by a single employer, except that if an election is made under paragraph (4)(B), subparagraph (A) shall apply to such plan")
rule SingleEmployerSection404aMultipleEmployer413c6Bi(plan: Plan) strict {
    label en official "PARTIAL: (c)(6)(B)(i)";
    when plan_kind_413(plan, MultipleEmployer413c)
        and not_known(plan_administrator_elected_subparagraph_a_413c4B(plan));
    then single_employer_treatment_413(plan, Section404a);
}

@source(IRC_S413_D, relation = formalizes, coverage = exact, quote = "The requirements of section 412 shall be determined as if all participants in the plan were employed by a single employer")
rule SingleEmployerSection412Csec413d1(plan: Plan) strict {
    label en official "(d)(1)";
    when plan_kind_413(plan, Csec413d);
    then single_employer_treatment_413(plan, Section412);
}

@source(IRC_S413_D, relation = formalizes, coverage = exact, quote = "Paragraphs (1), (2), (3), and (5) of subsection (c) shall apply")
rule SingleEmployerSection410aCsec413d2(plan: Plan) strict {
    label en official "(d)(2): subsection (c)(1)";
    when plan_kind_413(plan, Csec413d);
    then single_employer_treatment_413(plan, Section410a);
}

@source(IRC_S413_D, relation = formalizes, coverage = exact, quote = "Paragraphs (1), (2), (3), and (5) of subsection (c) shall apply")
rule ExclusiveBenefitCsec413d2(plan: Plan) strict {
    label en official "(d)(2): subsection (c)(2)";
    when plan_kind_413(plan, Csec413d);
    then single_employer_treatment_413(plan, ExclusiveBenefit401a);
}

@source(IRC_S413_D, relation = formalizes, coverage = exact, quote = "Paragraphs (1), (2), (3), and (5) of subsection (c) shall apply")
rule SingleEmployerSection411Csec413d2(plan: Plan) strict {
    label en official "(d)(2): subsection (c)(3)";
    when plan_kind_413(plan, Csec413d);
    then single_employer_treatment_413(plan, Section411);
}

@source(IRC_S413_D, relation = formalizes, coverage = partial, quote = "Each applicable limitation provided by section 404(a) shall be determined as if all participants in the plan were employed by a single employer")
rule SingleEmployerSection404aCsec413d3(plan: Plan) strict {
    label en official "PARTIAL: (d)(3)";
    when plan_kind_413(plan, Csec413d);
    then single_employer_treatment_413(plan, Section404a);
}

pub relation representative_meets_401a4_and_410_413b8(representative: Person) kind empirical {
    label en unofficial "the employee representative meets the requirements of sections 401(a)(4) and 410 with respect to its employees, case-asserted";
}

pub relation representative_employees_treated_as_employer_employees_413b8(representative: Person) kind institutional {
    label en official "section 413(b)(8): employees of employee representatives are treated as employees of an employer described in subsection (a)(1)";
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "employees of employee representatives shall be treated as employees of an employer described in subsection (a)(1) if such representatives meet the requirements of sections 401(a)(4) and 410")
rule RepresentativeEmployeesTreatedAsEmployerEmployees413b8(representative: Person) strict {
    label en official "the representative meets sections 401(a)(4) and 410";
    when representative_meets_401a4_and_410_413b8(representative);
    then representative_employees_treated_as_employer_employees_413b8(representative);
}

pub relation employer_liability_facts_413b6(employer: Person, kind: Text, amount: Money) kind empirical {
    label en unofficial "an amount attributed to the employer for section 4971 purposes (kind is the text withdrawal_liability or contribution_liability), case-asserted";
}

pub relation liability_for_contributions_413b6(employer: Person, amount: Money) kind institutional {
    label en official "sections 413(b)(6) and 4971(e): withdrawal liability is not a liability for contributions under the plan";
}

@source(IRC_S413_B, relation = formalizes, coverage = exact, quote = "shall not be treated as a liability for contributions under the plan")
rule LiabilityForContributionsExcludesWithdrawalLiability413b6(employer: Person, amount: Money) strict {
    label en official "only contribution liability counts";
    when employer_liability_facts_413b6(employer, "contribution_liability", amount);
    then liability_for_contributions_413b6(employer, amount);
}

pub relation pooled_plan_requirements_facts_413e3A(plan: Plan, plan_meets_requirements: Boolean, employers_take_required_actions: Boolean) kind empirical {
    label en unofficial "the plan meets the ERISA and Code requirements applicable to a plan described in section 401(a) or of individual retirement accounts, and each employer takes the actions the Secretary or the provider determines necessary, case-asserted";
}

pub relation pooled_plan_meets_provider_requirements_413e3A(plan: Plan) kind institutional {
    label en official "section 413(e)(3)(A): the plan meets the requirements and each employer takes the necessary actions";
}

@source(IRC_S413_E, relation = formalizes, coverage = partial, quote = "each employer in the plan takes such actions as the Secretary or such person determines are necessary for the plan to meet the requirements described in subclause (I)")
rule PooledPlanMeetsProviderRequirements413e3A(plan: Plan) strict {
    label en official "PARTIAL: subclauses (I) and (II); the chapeau (provider duties) is a lead-in";
    when pooled_plan_requirements_facts_413e3A(plan, true, true);
    then pooled_plan_meets_provider_requirements_413e3A(plan);
}

// =====================================================================
// 412 Minimum funding standards
// =====================================================================

pub relation multiemployer_plan_critical_status_facts_412b3(plan: Plan, y: TaxableYear, critical_status_under_432: Boolean, adopted_rehabilitation_plan: Boolean, complies_with_plan: Boolean) kind empirical {
    label en unofficial "the multiemployer plan is in critical status for the plan year, the sponsor adopted a rehabilitation plan under section 432(e), and complies with it, case-asserted";
}

pub relation paragraph_1_inapplicable_in_critical_year_412b3(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(b)(3): paragraph (1) does not apply to a multiemployer plan in critical status for the plan year if the sponsor adopts and complies with a rehabilitation plan";
}

@source(IRC_S412_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply in the case of a multiemployer plan for any plan year in which the plan is in critical status pursuant to section 432")
rule Paragraph1InapplicableInCriticalYear412b3(plan: Plan, y: TaxableYear) strict {
    label en official "critical status, plus adopted and complied rehabilitation plan";
    when multiemployer_plan_critical_status_facts_412b3(plan, y, true, true, true);
    then paragraph_1_inapplicable_in_critical_year_412b3(plan, y);
}

pub relation waiver_effect_facts_412c1B(plan: Plan, y: TaxableYear, minimum_required_contribution: Money, waived_funding_deficiency: Money) kind empirical {
    label en unofficial "the minimum required contribution under section 430 for the year and the waived funding deficiency, case-asserted";
}

pub relation waiver_plan_kind_412c1B(plan: Plan, kind: PlanKind412c1B) kind empirical {
    label en unofficial "the plan is a single-employer defined benefit plan, a multiemployer plan or a CSEC plan, case-asserted";
}

pub enum PlanKind412c1B {
    SingleEmployerDefinedBenefit;
    Multiemployer;
    Csec;
}

pub relation reduced_minimum_required_contribution_412c1Bi(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 412(c)(1)(B)(i): the minimum required contribution under section 430 is reduced by the waived funding deficiency (and amortized under section 430(e))";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "the minimum required contribution under section 430 for the plan year shall be reduced by the amount of the waived funding deficiency")
rule ReducedMinimumRequiredContribution412c1Bi(plan: Plan, y: TaxableYear, mrc: Money, waived: Money) strict {
    label en official "PARTIAL: the amortization under section 430(e) is not computed; the result floors at zero";
    when waiver_plan_kind_412c1B(plan, SingleEmployerDefinedBenefit)
        and waiver_effect_facts_412c1B(plan, y, mrc, waived);
    then reduced_minimum_required_contribution_412c1Bi(plan, y, max(0 USD, mrc - waived));
}

pub relation funding_standard_account_credit_412c1B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 412(c)(1)(B)(ii)-(iii): for a multiemployer or CSEC plan the funding standard account is credited with the waived funding deficiency (amortized)";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "the funding standard account shall be credited under section 431(b)(3)(C) with the amount of the waived funding deficiency")
rule FundingStandardAccountCreditMultiemployer412c1Bii(plan: Plan, y: TaxableYear, mrc: Money, waived: Money) strict {
    label en official "PARTIAL: (ii) multiemployer; the amortization is not computed";
    when waiver_plan_kind_412c1B(plan, Multiemployer)
        and waiver_effect_facts_412c1B(plan, y, mrc, waived);
    then funding_standard_account_credit_412c1B(plan, y, waived);
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "the funding standard account shall be credited under section 433(b)(3)(C) with the amount of the waived funding deficiency")
rule FundingStandardAccountCreditCsec412c1Biii(plan: Plan, y: TaxableYear, mrc: Money, waived: Money) strict {
    label en official "PARTIAL: (iii) CSEC plan; the amortization is not computed";
    when waiver_plan_kind_412c1B(plan, Csec)
        and waiver_effect_facts_412c1B(plan, y, mrc, waived);
    then funding_standard_account_credit_412c1B(plan, y, waived);
}

pub relation minimum_funding_standard_and_prior_waiver_412c1C(plan: Plan, y: TaxableYear, standard: Money, attributable_to_prior_waived: Money) kind empirical {
    label en unofficial "the minimum funding standard for the year and the portion attributable to a waived funding deficiency of a preceding plan year, case-asserted";
}

pub relation maximum_waivable_portion_412c1C(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 412(c)(1)(C): the Secretary may not waive the portion attributable to a waived funding deficiency of a preceding plan year";
}

@source(IRC_S412_C, relation = formalizes, coverage = exact, quote = "The Secretary may not waive under subparagraph (A) any portion of the minimum funding standard under subsection (a) for a plan year which is attributable to any waived funding deficiency for any preceding plan year")
rule MaximumWaivablePortion412c1C(plan: Plan, y: TaxableYear, std: Money, prior: Money) strict {
    label en official "the standard less the portion attributable to earlier waivers, floored at zero";
    when minimum_funding_standard_and_prior_waiver_412c1C(plan, y, std, prior);
    then maximum_waivable_portion_412c1C(plan, y, max(0 USD, std - prior));
}

pub relation pbgc_notice_received_412c4B(application: Person, received_on: Date) kind empirical {
    label en unofficial "the date the Pension Benefit Guaranty Corporation received notice of the completed application, case-asserted";
}

pub relation pbgc_comment_period_end_412c4B(application: Person, last_day: Date) kind institutional {
    label en official "section 412(c)(4)(B)(i)(II): the Corporation has an opportunity to comment within 30 days after receipt of the notice";
}

@source(IRC_S412_C, relation = formalizes, coverage = exact, quote = "an opportunity to comment on such application within 30 days after receipt of such notice")
rule PbgcCommentPeriodEnd412c4B(application: Person, received: Date) strict {
    label en official "30 calendar days after receipt";
    when pbgc_notice_received_412c4B(application, received);
    then pbgc_comment_period_end_412c4B(application, add_calendar_period(received, 30 calendar_day));
}

// (c)(4)(A)(i)-(ii): security the Secretary may require; enforced only by
// the PBGC (G6-ERISA wire). G4-pattern: the Secretary's requirement and the
// PBGC-only enforcement are external administrative facts — asserted, not
// derived. (Threshold (C)(i) lives in module 43.)

pub relation secretary_required_security_412c4a(employer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the Secretary required the employer maintaining the single-employer defined benefit plan to provide security as a condition for the waiver/extension, case-asserted";
}

pub relation security_required_as_condition_412c4a(employer: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(c)(4)(A)(i): security required as a condition for granting or modifying the waiver or granting the extension";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "the Secretary may require an employer maintaining a defined benefit plan which is a single-employer plan (within the meaning of section 4001(a)(15) of the Employee Retirement Income Security Act of 1974) to provide security to such plan as a condition for granting or modifying a waiver under paragraph (1) or for granting an extension under section 433(d)")
rule SecurityRequiredAsCondition412c4a(employer: Person, plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: the Secretary's discretionary requirement is asserted as a case fact";
    when secretary_required_security_412c4a(employer, plan, y);
    then security_required_as_condition_412c4a(employer, plan, y);
}

pub relation security_enforcer_permitted_412c4aii(enforcer: Person, plan: Plan) kind empirical {
    label en unofficial "the person perfecting or enforcing the clause (i) security is the PBGC, or a contributing sponsor (or controlled-group member) acting at the Corporation's direction, case-asserted";
}

pub relation security_enforcement_permitted_412c4aii(enforcer: Person, plan: Plan) kind institutional {
    label en official "section 412(c)(4)(A)(ii): the security may be perfected and enforced only by the PBGC (or as directed)";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "Any security provided under clause (i) may be perfected and enforced only by the Pension Benefit Guaranty Corporation, or at the direction of the Corporation, by a contributing sponsor (within the meaning of section 4001(a)(13) of the Employee Retirement Income Security Act of 1974), or a member of such sponsor's controlled group (within the meaning of section 4001(a)(14) of such Act).")
rule SecurityEnforcementPermitted412c4aii(enforcer: Person, plan: Plan) strict {
    label en official "PARTIAL: the permitted-enforcer description is asserted as a case fact";
    when security_enforcer_permitted_412c4aii(enforcer, plan);
    then security_enforcement_permitted_412c4aii(enforcer, plan);
}

pub relation hardship_test_met_facts_412c5B(employer: Person, met_for_employer: Boolean, met_for_controlled_group: Boolean, plan_is_multiemployer: Boolean) kind empirical {
    label en unofficial "the temporary substantial business hardship requirements are met with respect to the employer and with respect to the controlled group, and whether the plan is multiemployer, case-asserted";
}

pub relation hardship_requirements_treated_as_met_412c5B(employer: Person) kind institutional {
    label en official "section 412(c)(5)(B): for a defined benefit plan that is not multiemployer, an employer in a controlled group meets the requirement only if met for the employer and for the controlled group";
}

@source(IRC_S412_C, relation = formalizes, coverage = exact, quote = "the temporary substantial business hardship requirements of paragraph (1) shall be treated as met only if such requirements are met")
rule HardshipRequirementsTreatedAsMet412c5B(employer: Person) strict {
    label en official "both, non-multiemployer plan";
    when hardship_test_met_facts_412c5B(employer, true, true, false);
    then hardship_requirements_treated_as_met_412c5B(employer);
}

pub relation waiver_applicant_notice_evidence_412c6A(application: Person, notice_given_to_each_affected_party: Boolean, evidence_satisfactory: Boolean) kind empirical {
    label en unofficial "the applicant provided notice of the filing to each affected party and gave evidence satisfactory to the Secretary, case-asserted";
}

pub relation waiver_may_be_granted_on_notice_412c6A(application: Person) kind institutional {
    label en official "section 412(c)(6)(A): the Secretary requires evidence of notice to each affected party before granting a waiver";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "require each applicant to provide evidence satisfactory to the Secretary that the applicant has provided notice of the filing of the application for such waiver to each affected party")
rule WaiverMayBeGrantedOnNotice412c6A(application: Person) strict {
    label en official "PARTIAL: the content of the notice is not modelled (necessary condition of the grant)";
    when waiver_applicant_notice_evidence_412c6A(application, true, true);
    then waiver_may_be_granted_on_notice_412c6A(application);
}

pub relation change_facts_412d1(plan: Plan, method_or_plan_year_changed: Boolean, approved_by_secretary: Boolean) kind empirical {
    label en unofficial "the funding method or the plan year was changed, and the Secretary approved the change, case-asserted";
}

pub relation change_takes_effect_412d1(plan: Plan) kind institutional {
    label en official "section 412(d)(1): a change of funding method or plan year takes effect only if approved by the Secretary";
}

@source(IRC_S412_D, relation = formalizes, coverage = exact, quote = "the change shall take effect only if approved by the Secretary")
rule ChangeTakesEffect412d1(plan: Plan) strict {
    label en official "changed and approved";
    when change_facts_412d1(plan, true, true);
    then change_takes_effect_412d1(plan);
}

pub relation terminated_multiemployer_plan_412e4(plan: Plan, last_day_of_termination_plan_year: Date, section_4021_applies: Boolean) kind empirical {
    label en unofficial "the terminated multiemployer plan to which ERISA section 4021 applies and the last day of the plan year in which it terminates, case-asserted";
}

pub relation section_412_applies_on_412e4(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date on which the question is asked, case-asserted";
}

pub relation section_412_applies_to_terminated_plan_412e4(plan: Plan, on: Date) kind institutional {
    label en official "section 412(e)(4): section 412 applies to a terminated multiemployer plan until the last day of the plan year in which it terminates";
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "This section applies with respect to a terminated multiemployer plan to which section 4021 of the Employee Retirement Income Security Act of 1974 applies until the last day of the plan year in which the plan terminates")
rule Section412AppliesToTerminatedPlan412e4(plan: Plan, last: Date, on: Date) strict {
    label en official "through the last day, inclusive";
    when terminated_multiemployer_plan_412e4(plan, last, true)
        and section_412_applies_on_412e4(plan, on)
        and on <= last;
    then section_412_applies_to_terminated_plan_412e4(plan, on);
}

pub relation excepted_plan_401a7_facts_412e2(plan: Plan, described_in_c_d_or_f: Boolean, meets_401a7_as_of_1974_09_01: Boolean) kind empirical {
    label en unofficial "the plan is described in subparagraph (C), (D) or (F), and meets section 401(a)(7) as in effect on September 1, 1974, case-asserted";
}

pub relation excepted_plan_qualified_for_401a_412e2(plan: Plan) kind institutional {
    label en official "section 412(e)(2): a plan described in subparagraph (C), (D) or (F) is a qualified plan under section 401(a) only if it meets section 401(a)(7) as in effect on September 1, 1974";
}

@source(IRC_S412_E, relation = formalizes, coverage = partial, quote = "unless such plan meets the requirements of section 401(a)(7) as in effect on September 1, 1974")
rule ExceptedPlanQualifiedFor401a412e2(plan: Plan) strict {
    label en official "PARTIAL: necessary condition, the other qualification requirements are separate";
    when excepted_plan_401a7_facts_412e2(plan, true, true);
    then excepted_plan_qualified_for_401a_412e2(plan);
}

// =====================================================================
// 408A Roth IRAs
// =====================================================================

pub relation roth_designation_facts_408Ab(plan: Plan, is_individual_retirement_plan: Boolean, designated_as_roth_at_establishment: Boolean) kind empirical {
    label en unofficial "the plan is an individual retirement plan (section 7701(a)(37)) and was designated as a Roth IRA at the time of establishment, case-asserted";
}

pub relation roth_ira_408Ab(plan: Plan) kind institutional {
    label en official "section 408A(b): an individual retirement plan designated at the time of establishment as a Roth IRA";
}

@source(IRC_S408A_B, relation = formalizes, coverage = exact, quote = "which is designated (in such manner as the Secretary may prescribe) at the time of establishment of the plan as a Roth IRA")
rule RothIra408Ab(plan: Plan) strict {
    label en official "individual retirement plan, designated at establishment";
    when roth_designation_facts_408Ab(plan, true, true);
    then roth_ira_408Ab(plan);
}

pub relation roth_ira_exempt_from_lifetime_distribution_rules_408Ac4(plan: Plan) kind institutional {
    label en official "section 408A(c)(4): section 401(a)(9)(A) and the incidental death benefit requirements of section 401(a) do not apply to a Roth IRA";
}

@source(IRC_S408A_C, relation = formalizes, coverage = partial, quote = "The incidental death benefit requirements of section 401(a)")
rule RothIraExemptFromLifetimeDistributionRules408Ac4(plan: Plan) strict {
    label en official "PARTIAL: the lead-in of paragraph (4) is not quoted in the fragment excerpt";
    when roth_ira_408Ab(plan);
    then roth_ira_exempt_from_lifetime_distribution_rules_408Ac4(plan);
}

pub enum RolloverSource408A {
    IndividualRetirementPlan;
    EligibleRetirementPlan;
    QualifiedTuitionProgram;
}

pub relation qualified_rollover_facts_408Ae1(rollover: Person, from_plan: RolloverSource408A, meets_source_requirements: Boolean) kind empirical {
    label en unofficial "the source (from_plan) of the rollover contribution and whether it meets the requirements of section 408(d)(3) (individual retirement plan), section 402(c), 403(b)(8) or 457(e)(16) (eligible retirement plan) or section 529(c)(3)(E) (qualified tuition program), case-asserted";
}

pub relation qualified_rollover_contribution_408Ae1(rollover: Person) kind institutional {
    label en official "section 408A(e)(1): a rollover contribution from an individual retirement plan, an eligible retirement plan, or a qualified tuition program meeting the source requirements";
}

@source(IRC_S408A_E, relation = formalizes, coverage = exact, quote = "such rollover contribution meets the requirements of section 408(d)(3)")
rule QualifiedRolloverFromIra408Ae1(rollover: Person) strict {
    label en official "(B)(i)";
    when qualified_rollover_facts_408Ae1(rollover, IndividualRetirementPlan, true);
    then qualified_rollover_contribution_408Ae1(rollover);
}

@source(IRC_S408A_E, relation = formalizes, coverage = partial, quote = "such rollover contribution meets the requirements of section 402(c), 403(b)(8), or 457(e)(16)")
rule QualifiedRolloverFromEligiblePlan408Ae1(rollover: Person) strict {
    label en official "PARTIAL: (B)(ii); the eligible retirement plan definition is a case fact";
    when qualified_rollover_facts_408Ae1(rollover, EligibleRetirementPlan, true);
    then qualified_rollover_contribution_408Ae1(rollover);
}

@source(IRC_S408A_E, relation = formalizes, coverage = partial, quote = "from a qualified tuition program to the extent provided in section 529(c)(3)(E)")
rule QualifiedRolloverFromTuitionProgram408Ae1(rollover: Person) strict {
    label en official "PARTIAL: (C); the extent is a case fact";
    when qualified_rollover_facts_408Ae1(rollover, QualifiedTuitionProgram, true);
    then qualified_rollover_contribution_408Ae1(rollover);
}

pub relation rollover_counted_for_annual_limit_facts_408Ac5(rollover: Person, from_plan: RolloverSource408A) kind empirical {
    label en unofficial "the source of the qualified rollover contribution, case-asserted";
}

pub relation rollover_counts_against_paragraph_2_limit_408Ac5(rollover: Person) kind institutional {
    label en official "section 408A(c)(5)(B): a qualified rollover contribution is not taken into account for paragraph (2), except a rollover described in subsection (e)(1)(C)";
}

@source(IRC_S408A_C, relation = formalizes, coverage = exact, quote = "Clause (i) shall not apply to any qualified rollover contribution described in subsection (e)(1)(C)")
rule RolloverCountsAgainstLimit408Ac5(rollover: Person) strict {
    label en official "a qualified tuition program rollover is taken into account";
    when rollover_counted_for_annual_limit_facts_408Ac5(rollover, QualifiedTuitionProgram);
    then rollover_counts_against_paragraph_2_limit_408Ac5(rollover);
}

pub relation distribution_of_408d4_contribution_408Ad2C(distribution: Person) kind empirical {
    label en unofficial "the distribution is of a contribution described in section 408(d)(4) or its allocable net income, case-asserted";
}

pub relation distribution_is_qualified_distribution_candidate_408Ad2(distribution: Person) kind empirical {
    label en unofficial "the distribution satisfies paragraph (2)(A)-(B), case-asserted";
}

pub relation qualified_distribution_408Ad2(distribution: Person) kind institutional {
    label en official "section 408A(d)(2): a qualified distribution, not including a section 408(d)(4) distribution";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "The term \"qualified distribution\" shall not include any distribution of any contribution described in section 408(d)(4)")
rule QualifiedDistribution408Ad2(distribution: Person) strict {
    label en official "candidate distribution that is not a 408(d)(4) return";
    when distribution_is_qualified_distribution_candidate_408Ad2(distribution)
        and not_known(distribution_of_408d4_contribution_408Ad2C(distribution));
    then qualified_distribution_408Ad2(distribution);
}

pub relation rollover_2010_facts_408Ad3Aiii(taxpayer: Person, y: Integer, amount: Money, elected_out: Boolean) kind empirical {
    label en unofficial "the amount includible for a taxable year beginning in 2010 by reason of paragraph (3), and whether the taxpayer elected out of clause (iii), case-asserted";
}

pub relation ratable_inclusion_408Ad3Aiii(taxpayer: Person, y: Integer, amount: Money) kind institutional {
    label en official "section 408A(d)(3)(A)(iii): the 2010 amount is included ratably over the 2 taxable years beginning with the first taxable year beginning in 2011";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "shall be so included ratably over the 2-taxable-year period beginning with the first taxable year beginning in 2011")
rule RatableInclusion2011408Ad3Aiii(taxpayer: Person, amount: Money) strict {
    label en official "half in 2011 (exact division in cents, HALF_UP)";
    when rollover_2010_facts_408Ad3Aiii(taxpayer, 2010, amount, false);
    then ratable_inclusion_408Ad3Aiii(taxpayer, 2011, round(amount * 0.5, 2, "HALF_UP"));
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "shall be so included ratably over the 2-taxable-year period beginning with the first taxable year beginning in 2011")
rule RatableInclusion2012408Ad3Aiii(taxpayer: Person, amount: Money) strict {
    label en official "half in 2012 (exact division in cents, HALF_UP)";
    when rollover_2010_facts_408Ad3Aiii(taxpayer, 2010, amount, false);
    then ratable_inclusion_408Ad3Aiii(taxpayer, 2012, round(amount * 0.5, 2, "HALF_UP"));
}

pub relation election_change_facts_408Ad3Aiii(taxpayer: Person, y: TaxableYear, changed_on: Date, due_date: Date) kind empirical {
    label en unofficial "the date the taxpayer changed the election and the due date for the taxable year, case-asserted";
}

pub relation election_change_effective_408Ad3Aiii(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 408A(d)(3)(A): an election for distributions of a taxable year may not be changed after the due date for that year";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "may not be changed after the due date for such taxable year")
rule ElectionChangeEffective408Ad3Aiii(taxpayer: Person, y: TaxableYear, changed: Date, due: Date) strict {
    label en official "on or before the due date";
    when election_change_facts_408Ad3Aiii(taxpayer, y, changed, due)
        and changed <= due;
    then election_change_effective_408Ad3Aiii(taxpayer, y);
}

pub relation distribution_is_72t2F_408Ad5(distribution: Person) kind empirical {
    label en unofficial "the distribution is one to which section 72(t)(2)(F) applies, case-asserted";
}

pub relation qualified_special_purpose_distribution_408Ad5(distribution: Person) kind institutional {
    label en official "section 408A(d)(5): a distribution to which section 72(t)(2)(F) applies";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "means any distribution to which subparagraph (F) of section 72(t)(2) applies")
rule QualifiedSpecialPurposeDistribution408Ad5(distribution: Person) strict {
    label en official "section 72(t)(2)(F)";
    when distribution_is_72t2F_408Ad5(distribution);
    then qualified_special_purpose_distribution_408Ad5(distribution);
}

pub relation transfer_contribution_facts_408Ad6B(taxpayer: Person, transferred: Money, deducted: Money) kind empirical {
    label en unofficial "the transferred contribution and the part for which a deduction was allowed in the transferor plan, case-asserted";
}

pub relation recharacterization_transfer_amount_408Ad6Bii(taxpayer: Person, amount: Money) kind institutional {
    label en official "section 408A(d)(6)(B)(ii): subparagraph (A) applies to the transfer only to the extent no deduction was allowed";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "only to the extent no deduction was allowed with respect to the contribution to the transferor plan")
rule RecharacterizationTransferAmount408Ad6Bii(taxpayer: Person, transferred: Money, deducted: Money) strict {
    label en official "the transferred amount less the deducted part, floored at zero";
    when transfer_contribution_facts_408Ad6B(taxpayer, transferred, deducted);
    then recharacterization_transfer_amount_408Ad6Bii(taxpayer, max(0 USD, transferred - deducted));
}

pub relation non_qualified_distribution_rollover_facts_408Ae2C(distribution: Person, amount_treated_as_rollover: Money) kind empirical {
    label en unofficial "the amount treated as a rollover by reason of subparagraph (A) in a distribution that is not a qualified distribution, case-asserted";
}

pub relation investment_in_contract_408Ae2C(distribution: Person, amount: Money) kind institutional {
    label en official "section 408A(e)(2)(C): for section 72 the amount treated as a rollover is investment in the contract";
}

@source(IRC_S408A_E, relation = formalizes, coverage = exact, quote = "the amount treated as a rollover by reason of subparagraph (A) shall be treated as investment in the contract")
rule InvestmentInContract408Ae2C(distribution: Person, amount: Money) strict {
    label en official "the amount";
    when non_qualified_distribution_rollover_facts_408Ae2C(distribution, amount);
    then investment_in_contract_408Ae2C(distribution, amount);
}

pub relation simple_account_distribution_facts_408Ae3(distribution: Person, from_simple_with_408p12_election: Boolean, paid_into_another_simple_account: Boolean) kind empirical {
    label en unofficial "the distribution is out of a simple retirement account with a section 408(p)(12) election to which section 72(t)(6) applies, and whether it is paid into another simple retirement account, case-asserted";
}

pub relation excluded_from_qualified_rollover_408Ae3(distribution: Person) kind institutional {
    label en official "section 408A(e)(3): a distribution out of such a simple retirement account paid into an account other than another simple retirement account is not a qualified rollover contribution";
}

@source(IRC_S408A_E, relation = formalizes, coverage = exact, quote = "shall not include any payment or distribution paid into an account other than another simple retirement account")
rule ExcludedFromQualifiedRollover408Ae3(distribution: Person) strict {
    label en official "simple account with the election, paid elsewhere";
    when simple_account_distribution_facts_408Ae3(distribution, true, false);
    then excluded_from_qualified_rollover_408Ae3(distribution);
}
