// Section 411(a)(3)-(7) residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026). Modules 11 and 33 carry the vesting schedules, year
// of service, breaks in service, parity rule, parental-leave hours, service
// excludable by paragraph (4), repayment of prior distributions and the
// accrued-benefit floor of (c)(2). Left as TECH_GAP and modelled here:
// (a)(3) the permitted forfeiture grounds (death, reemployment suspension,
// retroactive amendment, withdrawal of mandatory contributions with the
// 50-percent, restoration and pre-1974 conditions, multiemployer cessation,
// reduction and suspension, excess-contribution matching); (a)(4)(D), (F),
// (G) service that may be disregarded; (a)(5)(B) hours of service;
// (a)(6)(D)(ii) years not counted twice; (a)(6)(E) the reasons for a
// maternity or paternity absence, the year to which the hours are credited
// and the information condition; (a)(7)(B) service disregarded after a
// distribution; (a)(7)(D) the accrued benefit floor.
//
// Method. Each "shall not be treated as forfeitable solely because" is one
// derived relation per ground (`forfeiture_ground_permitted_411a3`), gated by
// the conditions the text states; conditions the text leaves to the Secretary
// or to the plan are case facts. Exact boundaries: 50 percent is not "less
// than 50", September 2, 1974, 501 hours. Dates use exact calendar arithmetic.

use self::{
    IRC_S411_A,
    Person,
    Plan,
    TaxableYear,
};

pub enum ForfeitureGround411a3 {
    DeathNonPayment;
    ReemploymentSuspension;
    RetroactiveAmendment;
    MandatoryContributionWithdrawal;
    Pre1974ProportionalForfeiture;
    MulticontributionCessation;
    MultiemployerReductionOrSuspension;
    ExcessMatchingContribution;
}

pub relation plan_provision_411a3(plan: Plan, ground: ForfeitureGround411a3) kind empirical {
    label en unofficial "the plan provides for a right to an accrued benefit derived from employer contributions to be unpayable, suspended or forfeitable on this ground, case-asserted (section 411(a)(3))";
}

pub relation forfeiture_ground_permitted_411a3(plan: Plan, ground: ForfeitureGround411a3) kind institutional {
    label en official "section 411(a)(3): the right is not treated as forfeitable solely because of the plan provision on this ground";
}

// (A) Death

pub relation survivor_annuity_under_401a11_payable_411a3A(plan: Plan) kind empirical {
    label en unofficial "the accrued benefit is a survivor annuity payable as provided in section 401(a)(11), case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "shall not be treated as forfeitable solely because the plan provides that it is not payable if the participant dies")
rule DeathNonPaymentPermitted411a3A(plan: Plan) strict {
    label en official "except for a survivor annuity payable under section 401(a)(11)";
    when plan_provision_411a3(plan, DeathNonPayment) and not_known(survivor_annuity_under_401a11_payable_411a3A(plan));
    then forfeiture_ground_permitted_411a3(plan, DeathNonPayment);
}

// (B) Suspension on reemployment

pub relation plan_is_multiemployer_411a3B(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted";
}

pub relation retiree_employed_by_plan_employer_411a3Bi(plan: Plan) kind empirical {
    label en unofficial "after benefits commenced the employee is employed by the employer who maintains the plan, case-asserted (clause (i))";
}

pub relation retiree_employed_in_same_industry_trade_and_area_411a3Bii(plan: Plan) kind empirical {
    label en unofficial "after benefits commenced the employee is employed in the same industry, the same trade or craft, and the same geographic area covered by the plan as when the benefits commenced, case-asserted (clause (ii))";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a plan other than a multi-employer plan, by the employer who maintains the plan under which such benefits were being paid")
rule ReemploymentSuspensionSingleEmployer411a3Bi(plan: Plan) strict {
    label en official "a plan other than a multiemployer plan: employment by the maintaining employer";
    when plan_provision_411a3(plan, ReemploymentSuspension)
        and not_known(plan_is_multiemployer_411a3B(plan))
        and retiree_employed_by_plan_employer_411a3Bi(plan);
    then forfeiture_ground_permitted_411a3(plan, ReemploymentSuspension);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a multiemployer plan, in the same industry, the same trade or craft, and the same geographic area covered by the plan as when such benefits commenced")
rule ReemploymentSuspensionMultiemployer411a3Bii(plan: Plan) strict {
    label en official "a multiemployer plan: same industry, trade or craft and geographic area";
    when plan_provision_411a3(plan, ReemploymentSuspension)
        and plan_is_multiemployer_411a3B(plan)
        and retiree_employed_in_same_industry_trade_and_area_411a3Bii(plan);
    then forfeiture_ground_permitted_411a3(plan, ReemploymentSuspension);
}

// (C) Retroactive amendment

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "solely because plan amendments may be given retroactive application as provided in section 412(d)(2)")
rule RetroactiveAmendmentPermitted411a3C(plan: Plan) strict {
    label en official "the retroactivity must be as provided in section 412(d)(2) (a case fact of the provision)";
    when plan_provision_411a3(plan, RetroactiveAmendment) and plan_amendment_retroactive_under_412d2_411a3C(plan);
    then forfeiture_ground_permitted_411a3(plan, RetroactiveAmendment);
}

pub relation plan_amendment_retroactive_under_412d2_411a3C(plan: Plan) kind empirical {
    label en unofficial "the retroactive application of plan amendments is as provided in section 412(d)(2), case-asserted";
}

// (D) Withdrawal of mandatory contributions

pub relation nonforfeitable_percentage_of_employer_benefit_411a3D(participant: Person, plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the fraction of the accrued benefit derived from employer contributions that is nonforfeitable, case-asserted (1.00 is 100 percent)";
}

pub relation plan_provides_restoration_on_repayment_411a3Dii(plan: Plan) kind empirical {
    label en unofficial "the plan provides that a forfeited accrued benefit is restored upon repayment of the full withdrawal (with interest for a defined benefit plan), case-asserted";
}

pub relation mandatory_withdrawal_forfeiture_permitted_411a3D(participant: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(3)(D)(i), (ii): forfeiture on withdrawal of mandatory contributions is permitted only for a participant with less than 50 percent nonforfeitable and only if the plan restores on repayment";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a participant who does not have a nonforfeitable right to at least 50 percent of his accrued benefit derived from employer contributions")
rule MandatoryWithdrawalForfeiturePermitted411a3D(participant: Person, plan: Plan, pct: Decimal) strict {
    label en official "exact boundary: exactly 50 percent is \"at least 50 percent\", so the forfeiture is not permitted";
    when nonforfeitable_percentage_of_employer_benefit_411a3D(participant, plan, pct)
        and pct < 0.50
        and plan_provides_restoration_on_repayment_411a3Dii(plan);
    then mandatory_withdrawal_forfeiture_permitted_411a3D(participant, plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "Clause (i) shall not apply to a plan unless the plan provides that any accrued benefit forfeited under a plan provision described in such clause shall be restored upon repayment")
rule MandatoryWithdrawalGroundPermitted411a3D(participant: Person, plan: Plan) strict {
    label en official "the plan-level ground follows from a permitted participant forfeiture";
    when plan_provision_411a3(plan, MandatoryContributionWithdrawal) and mandatory_withdrawal_forfeiture_permitted_411a3D(participant, plan);
    then forfeiture_ground_permitted_411a3(plan, MandatoryContributionWithdrawal);
}

pub relation accrued_before_sept_2_1974_411a3Diii(plan: Plan) kind empirical {
    label en unofficial "the accrued benefit accrued before September 2, 1974 and the withdrawn mandatory contribution was made before that date, case-asserted";
}

pub relation mandatory_contribution_made_after_sept_2_1974_411a3Diii(plan: Plan) kind empirical {
    label en unofficial "a mandatory contribution is made to the plan after September 2, 1974, case-asserted";
}

pub relation forfeited_amount_proportional_to_withdrawal_411a3Diii(plan: Plan) kind empirical {
    label en unofficial "the amount forfeited is proportional to the amount withdrawn, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "if such amount forfeited is proportional to such amount withdrawn")
rule Pre1974ProportionalForfeiturePermitted411a3Diii(plan: Plan) strict {
    label en official "not for a plan to which any mandatory contribution is made after September 2, 1974";
    when plan_provision_411a3(plan, Pre1974ProportionalForfeiture)
        and accrued_before_sept_2_1974_411a3Diii(plan)
        and forfeited_amount_proportional_to_withdrawal_411a3Diii(plan)
        and not_known(mandatory_contribution_made_after_sept_2_1974_411a3Diii(plan));
    then forfeiture_ground_permitted_411a3(plan, Pre1974ProportionalForfeiture);
}

pub relation withdrawal_date_and_separation_411a3Dii(participant: Person, plan: Plan, withdrawn_on: Date, on_separation: Boolean) kind empirical {
    label en unofficial "the date of the withdrawal and whether it is on account of separation from service, case-asserted";
}

pub relation first_reemployment_after_withdrawal_411a3Dii(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first date the participant is subsequently re-employed by the employer, case-asserted";
}

pub relation five_break_period_close_after_withdrawal_411a3Dii(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the close of the first period of 5 consecutive 1-year breaks in service commencing after the withdrawal, case-asserted";
}

pub relation restoration_repayment_latest_date_411a3Dii(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 411(a)(3)(D)(ii): the latest date the plan may require repayment: for a separation withdrawal the earlier of 5 years after first re-employment and the close of the first 5 consecutive breaks; otherwise 5 years after the withdrawal";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of any other withdrawal, 5 years after the date of the withdrawal")
rule RestorationLatestDateOtherWithdrawal411a3DiiII(participant: Person, plan: Plan, withdrawn: Date) strict {
    label en official "exact: withdrawal date + 5 calendar years";
    when withdrawal_date_and_separation_411a3Dii(participant, plan, withdrawn, false);
    then restoration_repayment_latest_date_411a3Dii(participant, plan, add_calendar_period(withdrawn, 5 calendar_year));
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "before the earlier of 5 years after the first date on which the participant is subsequently re-employed by the employer")
rule RestorationLatestDateSeparationReemploymentFirst411a3DiiI(participant: Person, plan: Plan, withdrawn: Date, reemployed: Date, closed: Date) strict {
    label en official "separation withdrawal: the 5-year re-employment date when it is not after the close of the 5 breaks";
    when withdrawal_date_and_separation_411a3Dii(participant, plan, withdrawn, true)
        and first_reemployment_after_withdrawal_411a3Dii(participant, plan, reemployed)
        and five_break_period_close_after_withdrawal_411a3Dii(participant, plan, closed)
        and add_calendar_period(reemployed, 5 calendar_year) <= closed;
    then restoration_repayment_latest_date_411a3Dii(participant, plan, add_calendar_period(reemployed, 5 calendar_year));
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "or the close of the first period of 5 consecutive 1-year breaks in service commencing after the withdrawal")
rule RestorationLatestDateSeparationBreaksFirst411a3DiiI(participant: Person, plan: Plan, withdrawn: Date, reemployed: Date, closed: Date) strict {
    label en official "separation withdrawal: the close of the breaks when it is earlier";
    when withdrawal_date_and_separation_411a3Dii(participant, plan, withdrawn, true)
        and first_reemployment_after_withdrawal_411a3Dii(participant, plan, reemployed)
        and five_break_period_close_after_withdrawal_411a3Dii(participant, plan, closed)
        and closed < add_calendar_period(reemployed, 5 calendar_year);
    then restoration_repayment_latest_date_411a3Dii(participant, plan, closed);
}

pub relation class_year_withdrawal_plan_year_order_411a3Div(plan: Plan) kind empirical {
    label en unofficial "in a class-year plan a withdrawal of employee contributions is treated as a withdrawal on a plan year by plan year basis in succeeding order of time, case-asserted";
}

pub relation class_year_withdrawal_treatment_ok_411a3Div(plan: Plan) kind institutional {
    label en official "section 411(a)(3)(D)(iv): class-year plan withdrawals are treated year by year in succeeding order of time";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "a withdrawal of employee contributions shall be treated as a withdrawal of such contributions on a plan year by plan year basis in succeeding order of time")
rule ClassYearWithdrawalTreatment411a3Div(plan: Plan) strict {
    label en official "the ordering convention for class-year plans";
    when class_year_withdrawal_plan_year_order_411a3Div(plan);
    then class_year_withdrawal_treatment_ok_411a3Div(plan);
}

// (E), (F), (G)

pub relation service_before_employer_obligation_not_payable_on_cessation_411a3E(plan: Plan) kind empirical {
    label en unofficial "the multiemployer plan provides that benefits accrued through service before the employer had an obligation to contribute may not be payable if the employer ceases contributions, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "may not be payable if the employer ceases contributions to the multiemployer plan")
rule MulticontributionCessationPermitted411a3E(plan: Plan) strict {
    label en official "multiemployer plans only";
    when plan_provision_411a3(plan, MulticontributionCessation)
        and plan_is_multiemployer_411a3B(plan)
        and service_before_employer_obligation_not_payable_on_cessation_411a3E(plan);
    then forfeiture_ground_permitted_411a3(plan, MulticontributionCessation);
}

pub enum MultiemployerReductionBasis411a3F {
    ErisaSection4281Amendment;
    Section418ESuspension;
    ErisaSection4281Suspension;
}

pub relation multiemployer_reduction_basis_411a3F(plan: Plan, basis: MultiemployerReductionBasis411a3F) kind empirical {
    label en unofficial "the plan is amended to reduce benefits under ERISA section 4281, or benefit payments may be suspended under section 418E or ERISA section 4281, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "shall not be treated as forfeitable solely because")
rule MultiemployerReductionPermitted411a3F(plan: Plan, basis: MultiemployerReductionBasis411a3F) strict {
    label en official "any of the three bases, for a multiemployer plan";
    when plan_provision_411a3(plan, MultiemployerReductionOrSuspension)
        and plan_is_multiemployer_411a3B(plan)
        and multiemployer_reduction_basis_411a3F(plan, basis);
    then forfeiture_ground_permitted_411a3(plan, MultiemployerReductionOrSuspension);
}

pub enum ExcessGround411a3G {
    ExcessContribution401k8B;
    ExcessDeferral402g2A;
    PermissibleWithdrawal414w;
    ExcessAggregateContribution401m6B;
}

pub relation related_contribution_ground_411a3G(plan: Plan, ground: ExcessGround411a3G) kind empirical {
    label en unofficial "the contribution to which the matching contribution relates is treated as an excess contribution, excess deferral, permissible withdrawal or excess aggregate contribution, case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "shall not be treated as forfeitable merely because such contribution is forfeitable if the contribution to which the matching contribution relates is treated as an excess contribution")
rule ExcessMatchingForfeiturePermitted411a3G(plan: Plan, ground: ExcessGround411a3G) strict {
    label en official "any of the four grounds";
    when plan_provision_411a3(plan, ExcessMatchingContribution) and related_contribution_ground_411a3G(plan, ground);
    then forfeiture_ground_permitted_411a3(plan, ExcessMatchingContribution);
}

// =====================================================================
// (a)(4)(D), (F), (G) service that may be disregarded; (a)(5)(B)
// =====================================================================

pub relation service_year_of_employee_411a4x(employee: Person, plan: Plan, period: TaxableYear) kind empirical {
    label en unofficial "a year of service of the employee under the plan, case-asserted";
}

pub relation service_year_not_required_under_break_rules_411a4D(employee: Person, plan: Plan, period: TaxableYear) kind empirical {
    label en unofficial "the year of service is not required to be taken into account under paragraph (6), case-asserted";
}

pub relation service_year_before_first_plan_year_disregarded_by_plan_411a4F(employee: Person, plan: Plan, period: TaxableYear) kind empirical {
    label en unofficial "the year is before the first plan year to which the section applies and would have been disregarded under the plan's break-in-service rules in effect on the applicable date, case-asserted";
}

pub relation service_year_after_withdrawal_or_termination_411a4G(employee: Person, plan: Plan, period: TaxableYear, basis: MultiemployerServiceBasis411a4G) kind empirical {
    label en unofficial "in a multiemployer plan the year of service is with an employer after a complete withdrawal, a partial withdrawal with decertification (as regulations permit), or with any employer after the plan's termination date, case-asserted";
}

pub enum MultiemployerServiceBasis411a4G {
    CompleteWithdrawal;
    PartialWithdrawalWithDecertification;
    AfterPlanTerminationDate;
}

pub relation service_year_disregardable_by_411a4_extension(employee: Person, plan: Plan, period: TaxableYear) kind institutional {
    label en official "section 411(a)(4)(D), (F), (G): a year of service that may be disregarded because paragraph (6) does not require it, it precedes the first plan year under prior break rules, or it follows a multiemployer withdrawal or termination";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "service not required to be taken into account under paragraph (6)")
rule DisregardableByBreakRules411a4D(employee: Person, plan: Plan, period: TaxableYear) strict {
    label en official "(D)";
    when service_year_not_required_under_break_rules_411a4D(employee, plan, period);
    then service_year_disregardable_by_411a4_extension(employee, plan, period);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "years of service before the first plan year to which this section applies, if such service would have been disregarded under the rules of the plan with regard to breaks in service as in effect on the applicable date")
rule DisregardableBeforeFirstPlanYear411a4F(employee: Person, plan: Plan, period: TaxableYear) strict {
    label en official "(F)";
    when service_year_before_first_plan_year_disregarded_by_plan_411a4F(employee, plan, period);
    then service_year_disregardable_by_411a4_extension(employee, plan, period);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a multiemployer plan, years of service")
rule DisregardableMultiemployer411a4G(employee: Person, plan: Plan, period: TaxableYear, basis: MultiemployerServiceBasis411a4G) strict {
    label en official "(G)(i)(I), (II) and (ii); the partial-withdrawal branch depends on regulations the case asserts";
    when plan_is_multiemployer_411a3B(plan) and service_year_after_withdrawal_or_termination_411a4G(employee, plan, period, basis);
    then service_year_disregardable_by_411a4_extension(employee, plan, period);
}

pub relation hours_credited_under_410a3C_411a5B(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) kind empirical {
    label en unofficial "the hours of service credited under the meaning of section 410(a)(3)(C), case-asserted";
}

pub relation hours_of_service_411a5B(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) kind institutional {
    label en official "section 411(a)(5)(B): hours of service have the meaning of section 410(a)(3)(C)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the term \"hours of service\" has the meaning provided by section 410(a)(3)(C)")
rule HoursOfService411a5B(employee: Person, plan: Plan, period: TaxableYear, hours: Integer) strict {
    label en official "the hours credited under section 410(a)(3)(C) (a case input)";
    when hours_credited_under_410a3C_411a5B(employee, plan, period, hours);
    then hours_of_service_411a5B(employee, plan, period, hours);
}

// (a)(6)(D)(ii) years not counted twice

pub relation aggregate_years_before_break_period_411a6D(participant: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the aggregate number of years of service before the period of breaks, case-asserted";
}

pub relation years_disregarded_by_earlier_break_period_411a6Dii(participant: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the years of service already not taken into account by reason of an earlier period of breaks, case-asserted";
}

pub relation adjusted_aggregate_years_411a6Dii(participant: Person, plan: Plan, years: Integer) kind institutional {
    label en official "section 411(a)(6)(D)(ii): years already disregarded are not taken into account in applying clause (i) to a later period";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "such years of service shall not be taken into account in applying clause (i) to a subsequent period of breaks in service")
rule AdjustedAggregateYears411a6Dii(participant: Person, plan: Plan, total: Integer, disregarded: Integer) strict {
    label en official "total less the years already disregarded, not below zero";
    when aggregate_years_before_break_period_411a6D(participant, plan, total)
        and years_disregarded_by_earlier_break_period_411a6Dii(participant, plan, disregarded);
    then adjusted_aggregate_years_411a6Dii(participant, plan, max(total - disregarded, 0));
}

// (a)(6)(E) maternity and paternity absences

pub enum AbsenceReason411a6E {
    Pregnancy;
    BirthOfChild;
    AdoptionPlacement;
    CareOfChildAfterBirthOrPlacement;
}

pub relation absence_reason_411a6Ei(individual: Person, plan: Plan, reason: AbsenceReason411a6E) kind empirical {
    label en unofficial "the individual is absent from work for this reason, case-asserted (clause (i)(I)-(IV))";
}

pub relation absence_reason_qualifies_411a6Ei(individual: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(6)(E)(i): absence by reason of pregnancy, birth, adoption placement or care of the child after birth or placement";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "for purposes of caring for such child for a period beginning immediately following such birth or placement")
rule AbsenceReasonQualifies411a6Ei(individual: Person, plan: Plan, reason: AbsenceReason411a6E) strict {
    label en official "any of the four reasons";
    when absence_reason_411a6Ei(individual, plan, reason);
    then absence_reason_qualifies_411a6Ei(individual, plan);
}

pub relation hours_absent_and_credited_411a6Eiii(individual: Person, plan: Plan, actual_hours_in_year: Integer, credited_hours: Integer) kind empirical {
    label en unofficial "the hours actually completed in the year in which the absence begins and the hours treated as hours of service under clause (ii), case-asserted";
}

pub relation absence_hours_credited_in_year_of_absence_411a6Eiii(individual: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(6)(E)(iii)(I): credited only in the year the absence begins if the participant would be prevented from incurring a 1-year break in that year solely because of the credit";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "only in the year in which the absence from work begins, if a participant would be prevented from incurring a 1-year break in service in such year solely because the period of absence is treated as hours of service")
rule AbsenceHoursCreditedInYearOfAbsence411a6EiiiI(individual: Person, plan: Plan, actual: Integer, credited: Integer) strict {
    label en official "exact boundary: 500 actual hours is a break (a break is not more than 500); the credit prevents it when actual <= 500 and actual + credited > 500";
    when absence_reason_qualifies_411a6Ei(individual, plan)
        and hours_absent_and_credited_411a6Eiii(individual, plan, actual, credited)
        and actual <= 500
        and actual + credited > 500;
    then absence_hours_credited_in_year_of_absence_411a6Eiii(individual, plan);
}

pub relation absence_hours_credited_in_following_year_411a6Eiii(individual: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(6)(E)(iii)(II): in any other case the hours are credited in the immediately following year";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in any other case, in the immediately following year")
rule AbsenceHoursCreditedInFollowingYear411a6EiiiII(individual: Person, plan: Plan) strict {
    label en official "when the year-of-absence condition does not hold";
    when absence_reason_qualifies_411a6Ei(individual, plan)
        and hours_absent_and_credited_411a6Eiii(individual, plan, _, _)
        and not_known(absence_hours_credited_in_year_of_absence_411a6Eiii(individual, plan));
    then absence_hours_credited_in_following_year_411a6Eiii(individual, plan);
}

pub relation year_is_computation_period_411a6Eiv(period: TaxableYear) kind empirical {
    label en unofficial "the period used in computations under paragraph (5), case-asserted";
}

pub relation year_defined_by_computation_period_411a6Eiv(period: TaxableYear) kind institutional {
    label en official "section 411(a)(6)(E)(iv): \"year\" means the period used in computations under paragraph (5)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "the term \"year\" means the period used in computations pursuant to paragraph (5)")
rule YearDefinedByComputationPeriod411a6Eiv(period: TaxableYear) strict {
    label en official "the computation period";
    when year_is_computation_period_411a6Eiv(period);
    then year_defined_by_computation_period_411a6Eiv(period);
}

pub relation plan_conditions_credit_on_timely_information_411a6Ev(plan: Plan) kind empirical {
    label en unofficial "the plan provides that no credit is given unless the individual furnishes to the plan administrator timely information the plan may reasonably require, case-asserted";
}

pub relation individual_furnished_reason_and_days_411a6Ev(individual: Person, plan: Plan) kind empirical {
    label en unofficial "the individual has furnished information establishing that the absence is for a reason in clause (i) and the number of days of absence, case-asserted (subclauses (I), (II))";
}

pub relation information_condition_permitted_411a6Ev(plan: Plan) kind institutional {
    label en official "section 411(a)(6)(E)(v): a plan does not fail the subparagraph solely because it conditions credit on timely information";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A plan shall not fail to satisfy the requirements of this subparagraph solely because it provides that no credit will be given pursuant to this subparagraph unless the individual furnishes to the plan administrator such timely information")
rule InformationConditionPermitted411a6Ev(plan: Plan) strict {
    label en official "the timeliness and reasonableness of the requirement are case facts";
    when plan_conditions_credit_on_timely_information_411a6Ev(plan);
    then information_condition_permitted_411a6Ev(plan);
}

pub relation credit_given_only_with_information_411a6Ev(individual: Person, plan: Plan) kind institutional {
    label en official "under a permitted information condition the credit is given only to an individual who furnished the information";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "that the absence from work is for reasons referred to in clause (i)")
rule CreditGivenOnlyWithInformation411a6Ev(individual: Person, plan: Plan) strict {
    label en official "both information items (I) and (II) furnished";
    when information_condition_permitted_411a6Ev(plan)
        and individual_furnished_reason_and_days_411a6Ev(individual, plan)
        and absence_reason_qualifies_411a6Ei(individual, plan);
    then credit_given_only_with_information_411a6Ev(individual, plan);
}

// (a)(7)(B), (D)

pub relation distribution_on_termination_411a7B(participant: Person, plan: Plan, entire_benefit: Boolean, amount: Money, limit: Money) kind empirical {
    label en unofficial "a distribution made on termination of the employee's participation: whether it is of the present value of the entire nonforfeitable benefit, its amount, and the dollar limit of section 411(a)(11)(A), case-asserted";
}

pub relation elected_distribution_of_service_benefit_411a7Bii(participant: Person, plan: Plan, on_termination_or_regs: Boolean) kind empirical {
    label en unofficial "a distribution of the present value of the nonforfeitable benefit attributable to the service which the employee elected to receive, and whether it was on termination of participation or under circumstances in regulations, case-asserted";
}

pub relation service_may_be_disregarded_after_distribution_411a7B(participant: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(7)(B): notwithstanding paragraph (4), the plan may disregard service for which the employee received a qualifying distribution";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "a distribution of the present value of his entire nonforfeitable benefit if such distribution was in an amount (not more than the dollar limit under section 411(a)(11)(A))")
rule ServiceDisregardedAfterEntireDistribution411a7Bi(participant: Person, plan: Plan, amount: Money, limit: Money) strict {
    label en official "exact boundary: an amount equal to the dollar limit is permitted; only on termination of participation";
    when distribution_on_termination_411a7B(participant, plan, true, amount, limit) and amount <= limit;
    then service_may_be_disregarded_after_distribution_411a7B(participant, plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "a distribution of the present value of his nonforfeitable benefit attributable to such service which he elected to receive")
rule ServiceDisregardedAfterElectedDistribution411a7Bii(participant: Person, plan: Plan) strict {
    label en official "on termination of participation or under regulatory circumstances (a case fact)";
    when elected_distribution_of_service_benefit_411a7Bii(participant, plan, true);
    then service_may_be_disregarded_after_distribution_411a7B(participant, plan);
}

pub relation accrued_benefit_computed_411a7D(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the accrued benefit determined under the plan, case-asserted";
}

pub relation employee_contribution_floor_411c2B_411a7D(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount determined under subsection (c)(2)(B) for the employee's accumulated contributions, case-asserted";
}

pub relation accrued_benefit_after_floor_411a7D(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(a)(7)(D): the accrued benefit is not less than the (c)(2)(B) amount for the employee's accumulated contributions";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "The accrued benefit of an employee shall not be less than the amount determined under subsection (c)(2)(B)")
rule AccruedBenefitAfterFloor411a7D(employee: Person, plan: Plan, benefit: Money, floor: Money) strict {
    label en official "max(benefit, floor)";
    when accrued_benefit_computed_411a7D(employee, plan, benefit) and employee_contribution_floor_411c2B_411a7D(employee, plan, floor);
    then accrued_benefit_after_floor_411a7D(employee, plan, max(benefit, floor));
}
