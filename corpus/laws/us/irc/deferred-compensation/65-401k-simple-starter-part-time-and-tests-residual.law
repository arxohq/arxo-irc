// Section 401(k) and (m) residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): (k)(2)(B)(iii) distribution form, (k)(3)(B),(D),(E),
// (F) ADP definitions, (k)(4)(C), (k)(8)(C)-(E) corrective distribution rules,
// (k)(11) SIMPLE 401(k), (k)(15) long-term part-time workers, (k)(16) starter
// 401(k), (l)(5)(C)-(D) average compensation, (m)(3) contribution percentage,
// (m)(5)(C), (m)(6)(C)-(D), (m)(13)(B)(iii)-(iv).
//
// The average of ratios is exact on case-asserted per-employee ratios (a
// ratio derived per employee cannot be summed: the aggregate-over-derived
// predicate limitation, G64); the ratio rounding to 10 places is a JUDGMENT
// CALL of the same kind as module 10. Amounts of the 408(p) cross-references
// are case inputs; SECURE 2.0 dated revisions are module 57 and the
// pre-amendment text is unpinned (G4601).

// =====================================================================
// (k)(2)(B)(iii) Lifetime income investment distribution form
// =====================================================================

use self::{
    IRC_S401_K,
    IRC_S401_L,
    IRC_S401_M,
    Person,
    Plan,
    TaxableYear,
    adp_test_deemed_satisfied_safe_harbor,
    excess_contributions_amount,
    hce_contributions_paid_over,
    qaca_notice_requirement_met_401k13E,
};

pub enum LifetimeIncomeDistributionForm401k2 {
    QualifiedDistribution38Bi;
    QualifiedPlanDistributionAnnuityContract38Biv;
    LumpSum;
    Installments;
}

pub relation lifetime_income_amount_distributed_in_form_401k2Biii(plan: Plan, y: TaxableYear, form: LifetimeIncomeDistributionForm401k2) kind empirical {
    label en unofficial "amounts distributed early under (B)(i)(VI) are distributed in this form, case-asserted";
}

pub relation regulations_provide_otherwise_401k2Biii(plan: Plan) kind empirical {
    label en unofficial "regulations provide otherwise for the form of the lifetime income distribution, case-asserted";
}

pub relation lifetime_income_distribution_form_permitted_401k2Biii(plan: Plan, y: TaxableYear, form: LifetimeIncomeDistributionForm401k2) kind institutional {
    label en official "section 401(k)(2)(B)(iii): the amounts of (i)(VI) are distributed only as a qualified distribution or a qualified plan distribution annuity contract";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "will be distributed only in the form of a qualified distribution")
rule LifetimeIncomeDistributionFormQualified401k2Biii(plan: Plan, y: TaxableYear) strict {
    label en official "a qualified distribution";
    when lifetime_income_amount_distributed_in_form_401k2Biii(plan, y, QualifiedDistribution38Bi);
    then lifetime_income_distribution_form_permitted_401k2Biii(plan, y, QualifiedDistribution38Bi);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "a qualified plan distribution annuity contract")
rule LifetimeIncomeDistributionFormAnnuity401k2Biii(plan: Plan, y: TaxableYear) strict {
    label en official "a qualified plan distribution annuity contract";
    when lifetime_income_amount_distributed_in_form_401k2Biii(plan, y, QualifiedPlanDistributionAnnuityContract38Biv);
    then lifetime_income_distribution_form_permitted_401k2Biii(plan, y, QualifiedPlanDistributionAnnuityContract38Biv);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "except as may be otherwise provided by regulations")
rule LifetimeIncomeDistributionFormOtherwiseByRegulation401k2Biii(plan: Plan, y: TaxableYear, form: LifetimeIncomeDistributionForm401k2) strict {
    label en official "another form only where regulations provide otherwise";
    when lifetime_income_amount_distributed_in_form_401k2Biii(plan, y, form)
        and regulations_provide_otherwise_401k2Biii(plan);
    then lifetime_income_distribution_form_permitted_401k2Biii(plan, y, form);
}

// =====================================================================
// (k)(3)(B),(D),(E),(F) Actual deferral percentage
// =====================================================================

pub enum SpecifiedGroup401k3 {
    HighlyCompensated;
    AllOtherEligible;
}

pub relation employee_deferral_ratio_401k3B(employee: Person, plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, ratio: Decimal) kind empirical {
    label en unofficial "the ratio of the employer contributions actually paid over to the trust on behalf of this employee for the plan year to the employee's compensation for the year, case-asserted (rounded to 10 places by the caller: JUDGMENT CALL)";
}

pub relation group_size_401k3B(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, n: Integer) kind empirical {
    label en unofficial "the number of employees in the specified group, case-asserted";
}

pub relation actual_deferral_percentage_of_group_401k3B(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, adp: Decimal) kind institutional {
    label en official "section 401(k)(3)(B): the average of the ratios calculated separately for each employee in the group";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the actual deferral percentage for a specified group of employees for a plan year shall be the average of the ratios")
rule ActualDeferralPercentageOfGroup401k3B(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, n: Integer) strict {
    label en official "sum of ratios over the group divided by its size (HALF_UP, 10 places)";
    when group_size_401k3B(plan, y, group, n) and n > 0;
    then actual_deferral_percentage_of_group_401k3B(plan, y, group,
        div_round(sum all r: Decimal for e: Person where employee_deferral_ratio_401k3B(e, plan, y, group, r), 1.0 * n, 10, "HALF_UP"));
}

pub relation matching_contributions_meeting_2B_2C_401k3Dii1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the matching contributions (401(m)(4)(A)) meet the requirements of paragraph (2)(B) and (C), case-asserted";
}

pub relation employer_elects_to_include_matching_401k3Dii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects to include matching contributions, case-asserted";
}

pub relation employer_elects_to_include_qnec_401k3Dii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects to include qualified nonelective contributions (401(m)(4)(C)), case-asserted";
}

pub relation matching_contributions_included_in_adp_401k3Dii1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(3)(D)(ii)(I): at the employer's election, matching contributions meeting (2)(B) and (C) are included in the contributions on behalf of an employee";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "matching contributions (as defined in 401(m)(4)(A)) which meet the requirements of paragraph (2)(B) and (C)")
rule MatchingContributionsIncludedInAdp401k3Dii1(plan: Plan, y: TaxableYear) strict {
    label en official "election and (2)(B)/(C) qualification";
    when employer_elects_to_include_matching_401k3Dii(plan, y)
        and matching_contributions_meeting_2B_2C_401k3Dii1(plan, y);
    then matching_contributions_included_in_adp_401k3Dii1(plan, y);
}

pub relation qnec_included_in_adp_401k3Dii2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(3)(D)(ii)(II): at the employer's election, qualified nonelective contributions are included";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "qualified nonelective contributions (within the meaning of section 401(m)(4)(C))")
rule QnecIncludedInAdp401k3Dii2(plan: Plan, y: TaxableYear) strict {
    label en official "election";
    when employer_elects_to_include_qnec_401k3Dii(plan, y);
    then qnec_included_in_adp_401k3Dii2(plan, y);
}

pub relation first_plan_year_of_non_successor_plan_401k3E(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year is the first plan year of the plan and the plan is not a successor plan, case-asserted";
}

pub relation employer_elects_actual_first_year_adp_401k3Eii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects to use the actual deferral percentage of nonhighly compensated employees for the first plan year, case-asserted";
}

pub relation actual_nhce_adp_for_first_year_401k3E(plan: Plan, y: TaxableYear, adp: Decimal) kind empirical {
    label en unofficial "the actual deferral percentage of nonhighly compensated employees determined for the first plan year, case-asserted";
}

pub relation preceding_year_nhce_adp_first_year_401k3E(plan: Plan, y: TaxableYear, adp: Decimal) kind institutional {
    label en official "section 401(k)(3)(E): for the first plan year the preceding-year NHCE percentage is 3 percent, or the actual first-year percentage if the employer so elects";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "(i) 3 percent, or")
rule PrecedingYearNhceAdpFirstYearDefault401k3E(plan: Plan, y: TaxableYear) strict {
    label en official "default 3 percent (0.03 as a fraction of compensation)";
    when first_plan_year_of_non_successor_plan_401k3E(plan, y)
        and not_known(employer_elects_actual_first_year_adp_401k3Eii(plan, y));
    then preceding_year_nhce_adp_first_year_401k3E(plan, y, 0.03);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the actual deferral percentage of nonhighly compensated employees determined for such first plan year")
rule PrecedingYearNhceAdpFirstYearElected401k3E(plan: Plan, y: TaxableYear, adp: Decimal) strict {
    label en official "election: the actual first-year percentage";
    when first_plan_year_of_non_successor_plan_401k3E(plan, y)
        and employer_elects_actual_first_year_adp_401k3Eii(plan, y)
        and actual_nhce_adp_for_first_year_401k3E(plan, y, adp);
    then preceding_year_nhce_adp_first_year_401k3E(plan, y, adp);
}

pub relation employer_elects_410b4B_401k3F(plan: Plan) kind empirical {
    label en unofficial "the employer elects to apply section 410(b)(4)(B) in the (A)(i) test, case-asserted";
}

pub relation employee_not_highly_compensated_below_minimum_age_or_service_401k3F(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible employee is not highly compensated and has not met the minimum age and service requirements of section 410(a)(1)(A), case-asserted";
}

pub relation employee_excludable_from_adp_test_401k3F(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(k)(3)(F): with the 410(b)(4)(B) election, such employees may be excluded from the (A)(ii) test";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "exclude from consideration all eligible employees (other than highly compensated employees) who have not met the minimum age and service requirements of section 410(a)(1)(A)")
rule EmployeeExcludableFromAdpTest401k3F(employee: Person, plan: Plan) strict {
    label en official "election and non-HCE not meeting age/service";
    when employer_elects_410b4B_401k3F(plan)
        and employee_not_highly_compensated_below_minimum_age_or_service_401k3F(employee, plan);
    then employee_excludable_from_adp_test_401k3F(employee, plan);
}

pub relation elective_contribution_counted_for_other_plan_test_401k4C(plan: Plan, other: Plan) kind institutional {
    label en official "section 401(k)(4)(C): elective contributions are not taken into account for testing another plan, except under section 401(m)";
}

pub relation elective_contribution_taken_into_account_for_other_plan_401k4C(plan: Plan, other: Plan) kind empirical {
    label en unofficial "the plan's elective contributions are proposed to be taken into account when testing the other plan under section 401(a) or 410(b), case-asserted";
}

pub relation test_is_401m_or_410b2Aii_401k4C(other: Plan) kind empirical {
    label en unofficial "the test is under section 401(m) or the 410(b)(2)(A)(ii) average benefit requirement, case-asserted";
}

pub relation elective_contribution_disregarded_for_other_plan_401k4C(plan: Plan, other: Plan) kind institutional {
    label en official "section 401(k)(4)(C): the contribution is disregarded for the other plan's test";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "shall not be taken into account for purposes of determining whether any other plan meets the requirements of section 401(a) or 410(b)")
rule ElectiveContributionDisregardedForOtherPlan401k4C(plan: Plan, other: Plan) strict {
    label en official "disregarded unless section 401(m) or the average benefit requirement is the test";
    when elective_contribution_taken_into_account_for_other_plan_401k4C(plan, other)
        and not_known(test_is_401m_or_410b2Aii_401k4C(other));
    then elective_contribution_disregarded_for_other_plan_401k4C(plan, other);
}

// =====================================================================
// (k)(8)(C)-(E) Corrective distribution rules
// =====================================================================

pub relation distribution_to_hce_basis_amount_401k8C(plan: Plan, y: TaxableYear, hce: Person, contributed: Money) kind empirical {
    label en unofficial "the amount of contributions by, or on behalf of, this highly compensated employee, case-asserted";
}

pub relation excess_contributions_distribution_share_401k8C(plan: Plan, y: TaxableYear, hce: Person, share: Money) kind institutional {
    label en official "section 401(k)(8)(C): the excess contributions are distributed to highly compensated employees on the basis of the amount of contributions by, or on behalf of, each of them (pro rata share, HALF_UP to the cent: JUDGMENT CALL)";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "shall be made to highly compensated employees on the basis of the amount of contributions by, or on behalf of, each of such employees")
rule ExcessContributionsDistributionShare401k8C(plan: Plan, y: TaxableYear, hce: Person, mine: Money, total: Money, excess: Money) strict {
    label en official "PARTIAL: the statute says on the basis of the amount of contributions; the proportional share is the reading here (the leveling order of (B)(ii) is the ceiling input)";
    when distribution_to_hce_basis_amount_401k8C(plan, y, hce, mine)
        and hce_contributions_paid_over(plan, y, total)
        and excess_contributions_amount(plan, y, excess)
        and total > 0 USD;
    then excess_contributions_distribution_share_401k8C(plan, y, hce, round(excess * (mine / 1.00 USD) / (total / 1.00 USD), 2, "HALF_UP"));
}

pub relation amount_required_to_be_distributed_under_401k8(amount: Person) kind empirical {
    label en unofficial "the person's amount is required to be distributed under paragraph (8), case-asserted";
}

pub relation section_72t_tax_not_imposed_401k8D(person: Person) kind institutional {
    label en official "section 401(k)(8)(D): no section 72(t) tax on an amount required to be distributed under the paragraph";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 72(t) on any amount required to be distributed under this paragraph.")
rule Section72tTaxNotImposed401k8D(person: Person) strict {
    label en official "required corrective distribution";
    when amount_required_to_be_distributed_under_401k8(person);
    then section_72t_tax_not_imposed_401k8D(person);
}

pub relation matching_contribution_forfeitable_only_by_related_event_401k8E(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the matching contribution is forfeitable only because the contribution to which it relates is an excess contribution, an excess deferral (402(g)(2)(A)), a permissible withdrawal (414(w)) or an excess aggregate contribution (401(m)(6)(B)), case-asserted";
}

pub relation matching_contribution_treated_as_nonforfeitable_401k8E(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(8)(E): for paragraph (2)(C) such a matching contribution is not treated as forfeitable";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "shall not be treated as forfeitable merely because such contribution is forfeitable")
rule MatchingContributionTreatedAsNonforfeitable401k8E(plan: Plan, y: TaxableYear) strict {
    label en official "related-event forfeiture does not make the match forfeitable";
    when matching_contribution_forfeitable_only_by_related_event_401k8E(plan, y);
    then matching_contribution_treated_as_nonforfeitable_401k8E(plan, y);
}

// =====================================================================
// (k)(11) SIMPLE 401(k)
// =====================================================================

pub relation simple_elective_percentage_within_limit_401k11Bi1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the elective contribution percentage never exceeds the 408(p)(2)(A)(ii) amount (after a 408(p)(2)(E)(i)(II) election), case-asserted";
}

pub relation simple_required_match_percentage_401k11Bi2(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the employer's required matching contribution as a fraction of compensation up to which it matches elective contributions (0.03 = 3 percent), case-asserted";
}

pub relation simple_nonelective_percentage_401k11Bi3(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the uniform nonelective contribution percentage (0.10 = 10 percent), case-asserted; a plan without nonelective contributions asserts none";
}

pub relation simple_nonelective_contributions_made_401k11Bi3(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer makes nonelective contributions under subclause (III) for the year, case-asserted";
}

pub relation simple_nonelective_within_408p2Aiv_401k11Bi3(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the nonelective contribution does not exceed the amount in effect under section 408(p)(2)(A)(iv), case-asserted";
}

pub relation simple_nonelective_employee_compensation_401k11Bi3(plan: Plan, y: TaxableYear, employee: Person, comp: Money) kind empirical {
    label en unofficial "a participating employee's compensation from the employer for the year, case-asserted";
}

pub relation simple_other_contributions_made_401k11Bi4(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "contributions other than those described in subclauses (I), (II) or (III) are made, case-asserted";
}

pub relation simple_nonelective_eligible_employee_401k11Bi3(plan: Plan, y: TaxableYear, employee: Person) kind institutional {
    label en official "section 401(k)(11)(B)(i)(III): the nonelective contribution is for each eligible employee with at least $5,000 of compensation from the employer for the year";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "for each employee who is eligible to participate in the arrangement and who has at least $5,000 of compensation from the employer for the year")
rule SimpleNonelectiveEligibleEmployee401k11Bi3(plan: Plan, y: TaxableYear, employee: Person, comp: Money) strict {
    label en official "exact boundary: $5,000 qualifies, $4,999.99 does not";
    when simple_nonelective_employee_compensation_401k11Bi3(plan, y, employee, comp)
        and comp >= 5000.00 USD;
    then simple_nonelective_eligible_employee_401k11Bi3(plan, y, employee);
}

pub relation simple_contribution_requirements_met_401k11B(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(B)(i): elective contributions within the limit, a required match of up to 3 percent, optional nonelective up to 10 percent within the 408(p)(2)(A)(iv) cap, and no other contributions";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "no other contributions may be made other than contributions described in subclause (I), (II), or (III)")
rule SimpleContributionRequirementsMet401k11B(plan: Plan, y: TaxableYear, mpct: Decimal) strict {
    label en official "exact: the match is required at 3 percent; a nonelective, if present, is at most 10 percent and within the cap; nothing else";
    when simple_elective_percentage_within_limit_401k11Bi1(plan, y)
        and simple_required_match_percentage_401k11Bi2(plan, y, mpct)
        and mpct >= 0.03
        and not_known(simple_other_contributions_made_401k11Bi4(plan, y))
        and not_known(simple_nonelective_contributions_made_401k11Bi3(plan, y));
    then simple_contribution_requirements_met_401k11B(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the employer may make nonelective contributions of a uniform percentage (up to 10 percent) of compensation")
rule SimpleContributionRequirementsMetWithNonelective401k11B(plan: Plan, y: TaxableYear, mpct: Decimal, nonel: Decimal) strict {
    label en official "with a nonelective contribution: at most 10 percent and within the 408(p)(2)(A)(iv) cap";
    when simple_elective_percentage_within_limit_401k11Bi1(plan, y)
        and simple_required_match_percentage_401k11Bi2(plan, y, mpct)
        and mpct >= 0.03
        and simple_nonelective_percentage_401k11Bi3(plan, y, nonel)
        and nonel <= 0.10
        and simple_nonelective_within_408p2Aiv_401k11Bi3(plan, y)
        and not_known(simple_other_contributions_made_401k11Bi4(plan, y));
    then simple_contribution_requirements_met_401k11B(plan, y);
}

pub relation simple_two_percent_election_made_401k11Bii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects, under the arrangement, 2 percent nonelective contributions in lieu of the match, case-asserted";
}

pub relation simple_two_percent_notice_given_on_401k11Bii(plan: Plan, y: TaxableYear, given: Date) kind empirical {
    label en unofficial "the date employees were notified of the election, case-asserted";
}

pub relation simple_year_begins_on_401k11Bii(plan: Plan, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the year, case-asserted";
}

pub relation simple_two_percent_election_notified_in_time_401k11Bii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(B)(ii): the employer notifies employees of the election within a reasonable period before the 60th day before the beginning of the year";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "the employer shall notify employees of such election within a reasonable period of time before the 60th day before the beginning of such year")
rule SimpleTwoPercentElectionNotifiedInTime401k11Bii(plan: Plan, y: TaxableYear, given: Date, start: Date) strict {
    label en official "PARTIAL: reasonable period is evaluative; the modelled boundary is: notice strictly before the 60th day before the year begins (given + 60 days < start)";
    when simple_two_percent_election_made_401k11Bii(plan, y)
        and simple_two_percent_notice_given_on_401k11Bii(plan, y, given)
        and simple_year_begins_on_401k11Bii(plan, y, start)
        and add_calendar_period(given, 60 calendar_day) < start;
    then simple_two_percent_election_notified_in_time_401k11Bii(plan, y);
}

pub relation simple_no_other_qualified_plan_contributions_401k11C(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "no contributions were made and no benefits accrued for services during the year under any other qualified plan of the employer for eligible employees, other than the (B) contributions, case-asserted";
}

pub relation simple_exclusive_plan_requirement_met_401k11C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(C): the exclusive plan requirement";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "if no contributions were made, or benefits were accrued, for services during such year under any qualified plan of the employer on behalf of any employee eligible to participate in the cash or deferred arrangement")
rule SimpleExclusivePlanRequirementMet401k11C(plan: Plan, y: TaxableYear) strict {
    label en official "exclusive plan";
    when simple_no_other_qualified_plan_contributions_401k11C(plan, y);
    then simple_exclusive_plan_requirement_met_401k11C(plan, y);
}

pub relation simple_vesting_requirement_408p3_met_401k11A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the vesting requirements of section 408(p)(3) are met, case-asserted";
}

pub relation eligible_employer_maintains_arrangement_401k11A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the arrangement is maintained by an eligible employer, case-asserted";
}

pub relation simple_401k_arrangement_meets_adp_test_401k11A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(A): a SIMPLE 401(k) arrangement is treated as meeting (3)(A)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the vesting requirements of section 408(p)(3)")
rule Simple401kArrangementMeetsAdpTest401k11A(plan: Plan, y: TaxableYear) strict {
    label en official "eligible employer, contribution requirements, exclusive plan and vesting";
    when eligible_employer_maintains_arrangement_401k11A(plan, y)
        and simple_contribution_requirements_met_401k11B(plan, y)
        and simple_exclusive_plan_requirement_met_401k11C(plan, y)
        and simple_vesting_requirement_408p3_met_401k11A(plan, y);
    then simple_401k_arrangement_meets_adp_test_401k11A(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement maintained by an eligible employer shall be treated as meeting the requirements of paragraph (3)(A)(ii)")
rule SafeHarborDeemedAdpFromSimple401k11(plan: Plan, y: TaxableYear) strict {
    label en official "the SIMPLE 401(k) also derives module 03's deemed-satisfaction relation (interface unchanged)";
    when simple_401k_arrangement_meets_adp_test_401k11A(plan, y);
    then adp_test_deemed_satisfied_safe_harbor(plan, y);
}

// =====================================================================
// (k)(15) Long-term part-time workers
// =====================================================================

pub relation ltpt_employee_solely_by_2D_ii_401k15(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is eligible to participate solely by reason of paragraph (2)(D)(ii), case-asserted";
}

pub relation employee_described_in_410b3_401k15C(employee: Person) kind empirical {
    label en unofficial "the employee is described in section 410(b)(3) (collective bargaining, nonresident alien), case-asserted";
}

pub relation ltpt_participation_rule_applies_401k15(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(k)(15)(C): (2)(D)(ii) does not apply to employees described in section 410(b)(3)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "Paragraph (2)(D)(ii) shall not apply to employees described in section 410(b)(3).")
rule LtptParticipationRuleApplies401k15C(employee: Person, plan: Plan) strict {
    label en official "eligibility by (2)(D)(ii) only when not a 410(b)(3) employee";
    when ltpt_employee_solely_by_2D_ii_401k15(employee, plan)
        and not_known(employee_described_in_410b3_401k15C(employee));
    then ltpt_participation_rule_applies_401k15(employee, plan);
}

pub relation ltpt_hours_in_12_month_period_401k15Biii(employee: Person, plan: Plan, hours: Integer) kind empirical {
    label en unofficial "the employee's hours of service in the 12-month period, case-asserted";
}

pub relation ltpt_period_is_year_of_service_401k15Biii(employee: Person, plan: Plan, hours: Integer) kind institutional {
    label en official "section 401(k)(15)(B)(iii): each 12-month period with at least 500 hours of service is a year of service for vesting";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "each 12-month period for which the employee has at least 500 hours of service shall be treated as a year of service")
rule LtptPeriodIsYearOfService401k15Biii(employee: Person, plan: Plan, hours: Integer) strict {
    label en official "exact boundary: 500 hours qualifies, 499 does not";
    when ltpt_employee_solely_by_2D_ii_401k15(employee, plan)
        and ltpt_hours_in_12_month_period_401k15Biii(employee, plan, hours)
        and hours >= 500;
    then ltpt_period_is_year_of_service_401k15Biii(employee, plan, hours);
}

pub relation employee_became_full_time_plan_year_401k15Biv(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year in which the employee meets the requirements of (2)(D) without regard to (2)(D)(ii), case-asserted";
}

pub relation year_after_becoming_full_time_401k15Biv(employee: Person, plan: Plan, y: TaxableYear, later: TaxableYear) kind empirical {
    label en unofficial "the later plan year is the first plan year beginning after that plan year, case-asserted";
}

pub relation ltpt_relief_ceases_401k15Biv(employee: Person, plan: Plan, later: TaxableYear) kind institutional {
    label en official "section 401(k)(15)(B)(iv): the relief (other than the vesting rule of clause (iii)) ceases as of the first plan year after the employee meets (2)(D) without regard to (2)(D)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "shall cease to apply to any employee as of the first plan year beginning after the plan year in which the employee meets the requirements of paragraph (2)(D)")
rule LtptReliefCeases401k15Biv(employee: Person, plan: Plan, y: TaxableYear, later: TaxableYear) strict {
    label en official "cessation year";
    when employee_became_full_time_plan_year_401k15Biv(employee, plan, y)
        and year_after_becoming_full_time_401k15Biv(employee, plan, y, later);
    then ltpt_relief_ceases_401k15Biv(employee, plan, later);
}

// =====================================================================
// (k)(16) Starter 401(k) deferral-only arrangement
// =====================================================================

pub relation starter_deferral_percentage_401k16Ciii(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage applied uniformly under the arrangement (0.03 = 3 percent), case-asserted";
}

pub relation starter_percentage_applied_uniformly_401k16Ciii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the percentage is applied uniformly, case-asserted";
}

pub relation starter_qualified_percentage_401k16Ciii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(C)(iii): a uniformly applied percentage not less than 3 nor more than 15 percent";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "is applied uniformly and is not less than 3 or more than 15 percent")
rule StarterQualifiedPercentage401k16Ciii(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "exact bounds: 3 and 15 percent are inside";
    when starter_deferral_percentage_401k16Ciii(plan, y, pct)
        and starter_percentage_applied_uniformly_401k16Ciii(plan, y)
        and pct >= 0.03 and pct <= 0.15;
    then starter_qualified_percentage_401k16Ciii(plan, y);
}

pub relation starter_each_eligible_employee_treated_as_electing_401k16Ci(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "each eligible employee is treated as having elected a qualified percentage, case-asserted";
}

pub relation starter_automatic_deferral_requirement_met_401k16C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(C): automatic deferral of a qualified percentage";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "each eligible employee is treated as having elected to have the employer make elective contributions in an amount equal to a qualified percentage of compensation")
rule StarterAutomaticDeferralRequirementMet401k16C(plan: Plan, y: TaxableYear) strict {
    label en official "deemed election and a qualified percentage";
    when starter_each_eligible_employee_treated_as_electing_401k16Ci(plan, y)
        and starter_qualified_percentage_401k16Ciii(plan, y);
    then starter_automatic_deferral_requirement_met_401k16C(plan, y);
}

pub relation starter_only_elective_contributions_401k16Di1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the only contributions that may be made are the elective contributions of employees described in subparagraph (C), case-asserted";
}

pub relation starter_annual_elective_limit_401k16Di2(plan: Plan, y: TaxableYear, limit: Money) kind empirical {
    label en unofficial "the aggregate elective contributions permitted for any employee for the calendar year, case-asserted";
}

pub relation starter_contribution_limitations_met_401k16D(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(D)(i): only elective contributions, aggregate not more than $6,000 for the calendar year (the inflation adjustment of clause (ii) and the age 50 catch-up of clause (iii) are dated inputs)";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "the aggregate amount of such elective contributions which may be made with respect to any employee for any calendar year shall not exceed $6,000")
rule StarterContributionLimitationsMet401k16D(plan: Plan, y: TaxableYear, limit: Money) strict {
    label en official "PARTIAL: the statutory dollar amount $6,000 (base year); the cost-of-living adjustment after 2024 and the catch-up increase are not computed here";
    when starter_only_elective_contributions_401k16Di1(plan, y)
        and starter_annual_elective_limit_401k16Di2(plan, y, limit)
        and limit <= 6000.00 USD;
    then starter_contribution_limitations_met_401k16D(plan, y);
}

pub relation starter_employer_maintains_no_other_qualified_plan_401k16Ei(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer does not maintain a qualified plan with respect to which contributions are made, or benefits are accrued, for service in the year, case-asserted (with the 410(b)(3)(A) carve-out folded into the assertion)";
}

pub relation starter_eligible_employer_401k16E(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(E)(i): an eligible employer maintains no other qualified plan for the year";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The term \"eligible employer\" means any employer if the employer does not maintain a qualified plan")
rule StarterEligibleEmployer401k16E(plan: Plan, y: TaxableYear) strict {
    label en official "no qualified plan with contributions or accruals";
    when starter_employer_maintains_no_other_qualified_plan_401k16Ei(plan, y);
    then starter_eligible_employer_401k16E(plan, y);
}

pub relation starter_notice_requirement_13E_met_401k16Biii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(B)(iii): the requirements of paragraph (13)(E) are met (module 64 derives them)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the requirements of subparagraph (E) of paragraph (13)")
rule StarterNoticeRequirement13EMet401k16Biii(plan: Plan, y: TaxableYear) strict {
    label en official "the (13)(E) notice relation";
    when qaca_notice_requirement_met_401k13E(plan, y);
    then starter_notice_requirement_13E_met_401k16Biii(plan, y);
}

pub relation starter_401k_deferral_only_arrangement_401k16B(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(B): automatic deferral, contribution limitations and the (13)(E) notice";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the term \"starter 401(k) deferral-only arrangement\" means any cash or deferred arrangement which meets")
rule Starter401kDeferralOnlyArrangement401k16B(plan: Plan, y: TaxableYear) strict {
    label en official "three requirements";
    when starter_automatic_deferral_requirement_met_401k16C(plan, y)
        and starter_contribution_limitations_met_401k16D(plan, y)
        and starter_notice_requirement_13E_met_401k16Biii(plan, y);
    then starter_401k_deferral_only_arrangement_401k16B(plan, y);
}

pub relation starter_arrangement_meets_adp_test_401k16A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(A): a starter arrangement maintained by an eligible employer is treated as meeting (3)(A)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A starter 401(k) deferral-only arrangement maintained by an eligible employer shall be treated as meeting the requirements of paragraph (3)(A)(ii)")
rule StarterArrangementMeetsAdpTest401k16A(plan: Plan, y: TaxableYear) strict {
    label en official "arrangement and eligible employer";
    when starter_401k_deferral_only_arrangement_401k16B(plan, y)
        and starter_eligible_employer_401k16E(plan, y);
    then starter_arrangement_meets_adp_test_401k16A(plan, y);
}

pub relation starter_eligible_employee_meets_410a1_401k16Fi(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee meets the minimum age and service conditions of section 410(a)(1), case-asserted";
}

pub relation starter_employee_excluded_by_election_410b3_or_4_401k16Fii(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employer elects to exclude the employee, who is described in paragraph (3) or (4) of section 410(b), case-asserted";
}

pub relation starter_eligible_employee_401k16F(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(k)(16)(F): an employee who meets the 410(a)(1) conditions, unless excluded by the employer's election";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The term \"eligible employee\" means any employee of the employer who meets the minimum age and service conditions described in section 410(a)(1).")
rule StarterEligibleEmployee401k16F(employee: Person, plan: Plan) strict {
    label en official "age and service conditions; the exclusion election defeats it";
    when starter_eligible_employee_meets_410a1_401k16Fi(employee, plan)
        and not_known(starter_employee_excluded_by_election_410b3_or_4_401k16Fii(employee, plan));
    then starter_eligible_employee_401k16F(employee, plan);
}

// =====================================================================
// (l)(5) Average annual compensation and final average compensation
// =====================================================================

pub relation average_compensation_for_period_401l5(participant: Person, plan: Plan, start_year: Integer, years: Integer, average: Money) kind empirical {
    label en unofficial "the participant's average annual compensation for a period of consecutive years beginning with this year, case-asserted (one row per candidate period)";
}

pub relation participant_full_period_of_service_years_401l5(participant: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the participant's full period of service in years, case-asserted";
}

pub relation highest_average_annual_compensation_401l5C(participant: Person, plan: Plan, average: Money) kind institutional {
    label en official "section 401(l)(5)(C): the highest average annual compensation for a period of at least 3 consecutive years, or the full period of service if shorter";
}

@source(IRC_S401_L, relation = formalizes, coverage = partial, quote = "the participant's highest average annual compensation for")
rule HighestAverageAnnualCompensation401l5C(participant: Person, plan: Plan) strict {
    label en official "PARTIAL: maximum over the asserted candidate periods of at least 3 years; the shorter-full-service alternative of (ii) is not computed (a participant with under 3 years asserts a 3-year row equal to the full period)";
    when participant_full_period_of_service_years_401l5(participant, plan, _);
    then highest_average_annual_compensation_401l5C(participant, plan,
        max all avg: Money for s: Integer, n: Integer
            where average_compensation_for_period_401l5(participant, plan, s, n, avg) and n >= 3);
}

pub relation final_average_period_years_401l5D(participant: Person, plan: Plan, years: Integer) kind institutional {
    label en official "section 401(l)(5)(D)(i): the period is the 3 consecutive years ending with the current year, or the full period of service if shorter";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "if shorter, the participant's full period of service")
rule FinalAveragePeriodYears401l5D(participant: Person, plan: Plan, service: Integer) strict {
    label en official "min(3, full period of service)";
    when participant_full_period_of_service_years_401l5(participant, plan, service);
    then final_average_period_years_401l5D(participant, plan, min(3, service));
}

pub relation annual_compensation_401l5(participant: Person, plan: Plan, year: Integer, comp: Money) kind empirical {
    label en unofficial "the participant's compensation for the year, case-asserted";
}

pub relation social_security_contribution_and_benefit_base_401l5(year: Integer, base: Money) kind empirical {
    label en unofficial "the contribution and benefit base in effect under section 230 of the Social Security Act for the year, case-asserted (an external table)";
}

pub relation compensation_counted_for_final_average_401l5Dii(participant: Person, plan: Plan, year: Integer, counted: Money) kind institutional {
    label en official "section 401(l)(5)(D)(ii): compensation in any year is not taken into account in excess of the contribution and benefit base for the year";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "compensation in excess of the contribution and benefit base in effect under section 230 of the Social Security Act for such year")
rule CompensationCountedForFinalAverage401l5Dii(participant: Person, plan: Plan, year: Integer, comp: Money, base: Money) strict {
    label en official "min(compensation, base)";
    when annual_compensation_401l5(participant, plan, year, comp)
        and social_security_contribution_and_benefit_base_401l5(year, base);
    then compensation_counted_for_final_average_401l5Dii(participant, plan, year, min(comp, base));
}

// =====================================================================
// (m)(3), (m)(5)(C), (m)(6)(C)-(D), (m)(13)(B)(iii)-(iv)
// =====================================================================

pub relation employee_contribution_ratio_401m3(employee: Person, plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, ratio: Decimal) kind empirical {
    label en unofficial "the ratio of the matching contributions and employee contributions paid under the plan on behalf of this employee for the plan year to the employee's compensation (section 414(s)) for the year, case-asserted (rounded to 10 places by the caller: JUDGMENT CALL)";
}

pub relation group_size_401m3(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, n: Integer) kind empirical {
    label en unofficial "the number of employees in the specified group, case-asserted";
}

pub relation contribution_percentage_of_group_401m3(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, cp: Decimal) kind institutional {
    label en official "section 401(m)(3): the average of the ratios calculated separately for each employee in the group";
}

@source(IRC_S401_M, relation = formalizes, coverage = partial, quote = "the contribution percentage for a specified group of employees for a plan year shall be the average of the ratios")
rule ContributionPercentageOfGroup401m3(plan: Plan, y: TaxableYear, group: SpecifiedGroup401k3, n: Integer) strict {
    label en official "PARTIAL: the regulatory elections to add elective deferrals and QNECs, and the exclusion of matching contributions counted in (k)(3), are not applied here";
    when group_size_401m3(plan, y, group, n) and n > 0;
    then contribution_percentage_of_group_401m3(plan, y, group,
        div_round(sum all r: Decimal for e: Person where employee_contribution_ratio_401m3(e, plan, y, group, r), 1.0 * n, 10, "HALF_UP"));
}

pub relation employer_elects_410b4B_401m5C(plan: Plan) kind empirical {
    label en unofficial "the employer elects to apply section 410(b)(4)(B) in the section 410(b) test, case-asserted";
}

pub relation employee_not_highly_compensated_below_minimum_age_or_service_401m5C(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible employee is not highly compensated and has not met the minimum age and service requirements of section 410(a)(1)(A), case-asserted";
}

pub relation employee_excludable_from_acp_test_401m5C(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(m)(5)(C): with the 410(b)(4)(B) election, such employees may be excluded from the paragraph (2) test";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "exclude from consideration all eligible employees (other than highly compensated employees) who have not met the minimum age and service requirements of section 410(a)(1)(A)")
rule EmployeeExcludableFromAcpTest401m5C(employee: Person, plan: Plan) strict {
    label en official "election and non-HCE not meeting age/service";
    when employer_elects_410b4B_401m5C(plan)
        and employee_not_highly_compensated_below_minimum_age_or_service_401m5C(employee, plan);
    then employee_excludable_from_acp_test_401m5C(employee, plan);
}

pub relation excess_aggregate_distribution_to_hce_basis_401m6C(plan: Plan, y: TaxableYear, hce: Person, contributed: Money) kind empirical {
    label en unofficial "the amount of contributions on behalf of, or by, this highly compensated employee, case-asserted";
}

pub relation excess_aggregate_contributions_401m6B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess aggregate contributions for the plan year, case-asserted (the (6)(B)(ii) leveling ceiling is not derived: G64)";
}

pub relation hce_matching_and_employee_contributions_total_401m6B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate matching and employee contributions made on behalf of highly compensated employees, case-asserted";
}

pub relation excess_aggregate_distribution_share_401m6C(plan: Plan, y: TaxableYear, hce: Person, share: Money) kind institutional {
    label en official "section 401(m)(6)(C): the excess aggregate contributions are distributed to highly compensated employees on the basis of the amount of contributions on behalf of, or by, each (pro rata, HALF_UP to the cent: JUDGMENT CALL)";
}

@source(IRC_S401_M, relation = formalizes, coverage = partial, quote = "shall be made to highly compensated employees on the basis of the amount of contributions on behalf of, or by, each such employee")
rule ExcessAggregateDistributionShare401m6C(plan: Plan, y: TaxableYear, hce: Person, mine: Money, total: Money, excess: Money) strict {
    label en official "PARTIAL: proportional reading";
    when excess_aggregate_distribution_to_hce_basis_401m6C(plan, y, hce, mine)
        and hce_matching_and_employee_contributions_total_401m6B(plan, y, total)
        and excess_aggregate_contributions_401m6B(plan, y, excess)
        and total > 0 USD;
    then excess_aggregate_distribution_share_401m6C(plan, y, hce, round(excess * (mine / 1.00 USD) / (total / 1.00 USD), 2, "HALF_UP"));
}

pub relation excess_aggregate_forfeiture_allocated_to_reduced_participant_401m6C(plan: Plan, y: TaxableYear, participant: Person) kind empirical {
    label en unofficial "a forfeiture of excess aggregate contributions is allocated to a participant whose contributions are reduced under paragraph (6), case-asserted";
}

pub relation forfeiture_allocation_prohibited_401m6C(plan: Plan, y: TaxableYear, participant: Person) kind institutional {
    label en official "section 401(m)(6)(C): forfeitures of excess aggregate contributions may not be allocated to participants whose contributions are reduced under the paragraph";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "Forfeitures of excess aggregate contributions may not be allocated to participants whose contributions are reduced under this paragraph.")
rule ForfeitureAllocationProhibited401m6C(plan: Plan, y: TaxableYear, participant: Person) strict {
    label en official "the prohibited allocation";
    when excess_aggregate_forfeiture_allocated_to_reduced_participant_401m6C(plan, y, participant);
    then forfeiture_allocation_prohibited_401m6C(plan, y, participant);
}

pub relation excess_deferrals_determined_first_401m6D(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the excess deferrals (402(g)) were determined first, then the excess contributions under (k), before the excess aggregate contributions, case-asserted";
}

pub relation excess_aggregate_determination_order_respected_401m6D(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(6)(D): the excess aggregate contributions are determined after the excess deferrals and the excess contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "The determination of the amount of excess aggregate contributions with respect to a plan shall be made after")
rule ExcessAggregateDeterminationOrderRespected401m6D(plan: Plan, y: TaxableYear) strict {
    label en official "order of determination";
    when excess_deferrals_determined_first_401m6D(plan, y);
    then excess_aggregate_determination_order_respected_401m6D(plan, y);
}

pub relation student_loan_payment_treated_as_elective_401m13Biii(plan: Plan, y: TaxableYear, requirement: Integer) kind empirical {
    label en unofficial "the plan treats a qualified student loan payment as an elective deferral or elective contribution to meet the listed requirement (11 = (m)(11)(B), 12 = (m)(12), 13 = (m)(13), 111 = (k)(11)(B)(i)(II), 112 = (k)(12)(B), 113 = (k)(13)(D), 116 = (k)(16)(D)), case-asserted";
}

pub relation student_loan_payment_counted_as_elective_for_safe_harbor_401m13Biii(plan: Plan, y: TaxableYear, requirement: Integer) kind institutional {
    label en official "section 401(m)(13)(B)(iii): solely for meeting the listed safe harbor requirements, a plan may treat a qualified student loan payment as an elective deferral or contribution";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "a plan may treat a qualified student loan payment as an elective deferral or an elective contribution, whichever is applicable")
rule StudentLoanPaymentCountedAsElective401m13Biii(plan: Plan, y: TaxableYear, requirement: Integer) strict {
    label en official "only for the listed requirements (11, 12, 13, 111, 112, 113, 116)";
    when student_loan_payment_treated_as_elective_401m13Biii(plan, y, requirement)
        and (requirement == 11 or requirement == 12 or requirement == 13 or requirement == 111 or requirement == 112 or requirement == 113 or requirement == 116);
    then student_loan_payment_counted_as_elective_for_safe_harbor_401m13Biii(plan, y, requirement);
}

pub relation adp_test_applied_separately_to_student_loan_matched_401m13Biv(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan applies (k)(3)(A)(ii) separately to all employees who receive matching contributions on account of qualified student loan payments, case-asserted";
}

pub relation separate_adp_testing_permitted_401m13Biv(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(13)(B)(iv): separate ADP testing of employees who receive student loan matching contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "the plan may apply the requirements of such subsection separately with respect to all employees who receive matching contributions")
rule SeparateAdpTestingPermitted401m13Biv(plan: Plan, y: TaxableYear) strict {
    label en official "separate application";
    when adp_test_applied_separately_to_student_loan_matched_401m13Biv(plan, y);
    then separate_adp_testing_permitted_401m13Biv(plan, y);
}
