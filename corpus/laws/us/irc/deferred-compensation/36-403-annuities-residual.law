// Section 403 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 05 carries the brief 403(b) contract (eligible employer, contribution, the
// section 402(g) cross-reference). This module adds (a) the taxation of
// employee annuities and its rollovers, (b)(1) the exclusion for a section
// 403(b) contract with its conditions, (b)(4) years of service, (b)(7) and
// (b)(11) the distribution restrictions with the hardship rules of (b)(17),
// (b)(12) the nondiscrimination requirements, (b)(13) transfers to governmental
// plans, and (b)(16) safe harbor deferral-only plans.
//
// Method: a condition is a conjunction of case-asserted facts; a limit is an
// exact comparison; distribution events are a closed enumeration. Indexed
// amounts ($6,000 after 2024) are SOURCE_GAP; the pinned base is used.

// =====================================================================
// (a) Employee annuities: taxation and rollover
// =====================================================================

use self::{
    Distribution,
    IRC_S403_A,
    IRC_S403_B,
    Person,
    Plan,
    plan_sponsor,
};

pub relation employee_annuity_distribution_403a(d: Distribution, distributee: Person) kind empirical {
    label en unofficial "an amount actually distributed to a distributee under an annuity contract purchased by an employer under a plan meeting section 404(a)(2), case-asserted (section 403(a)(1))";
}

pub relation employee_annuity_distribution_taxable_under_72_403a(d: Distribution, distributee: Person) kind institutional {
    label en official "section 403(a)(1): the distribution is taxable to the distributee under section 72 in the year distributed";
}

@source(IRC_S403_A, relation = formalizes, coverage = exact, quote = "the amount actually distributed to any distributee under the contract shall be taxable to the distributee (in the year in which so distributed) under section 72")
rule EmployeeAnnuityTaxableUnder72(d: Distribution, distributee: Person) strict {
    label en official "taxed on distribution, not on purchase";
    when employee_annuity_distribution_403a(d, distributee);
    then employee_annuity_distribution_taxable_under_72_403a(d, distributee);
}

pub relation employee_annuity_rollover_transferred_403a4(d: Distribution) kind empirical {
    label en unofficial "the employee transfers a portion of an eligible rollover distribution from an employee annuity to an eligible retirement plan (the property itself, if not money), case-asserted (section 403(a)(4)(A))";
}

pub relation employee_annuity_eligible_rollover_403a4(d: Distribution) kind empirical {
    label en unofficial "the distribution is an eligible rollover distribution within section 402(c)(4) from an employee annuity, case-asserted ((A)(i))";
}

pub relation employee_annuity_rollover_excluded_403a4(d: Distribution) kind institutional {
    label en official "section 403(a)(4)(A): the transferred part of an eligible rollover distribution is not includible in gross income";
}

@source(IRC_S403_A, relation = formalizes, coverage = partial, quote = "then such distribution (to the extent so transferred) shall not be includible in gross income for the taxable year in which paid")
rule EmployeeAnnuityRolloverExcluded403a4(d: Distribution) strict {
    label en official "PARTIAL: (i), (ii) and (iii) as asserted facts; the 60-day rule is read through section 402(c)(3) rules of module 04";
    when employee_annuity_eligible_rollover_403a4(d) and employee_annuity_rollover_transferred_403a4(d);
    then employee_annuity_rollover_excluded_403a4(d);
}

pub relation employee_annuity_direct_transfer_403a5(d: Distribution) kind empirical {
    label en unofficial "the amount is transferred in a direct trustee-to-trustee transfer in accordance with section 401(a)(31), case-asserted (section 403(a)(5))";
}

pub relation employee_annuity_direct_transfer_excluded_403a5(d: Distribution) kind institutional {
    label en official "section 403(a)(5): a direct trustee-to-trustee transfer is not includible for the year of the transfer";
}

@source(IRC_S403_A, relation = formalizes, coverage = exact, quote = "shall not be includible in gross income for the taxable year of such transfer")
rule EmployeeAnnuityDirectTransferExcluded403a5(d: Distribution) strict {
    label en official "no inclusion";
    when employee_annuity_direct_transfer_403a5(d);
    then employee_annuity_direct_transfer_excluded_403a5(d);
}

// =====================================================================
// (b)(1) The exclusion for a section 403(b) contract
// =====================================================================

pub enum Employer403bKind {
    Section501c3Organization;
    StateEducationalOrganization;
    MinisterContract;
}

pub relation contract_purchased_by_employer_403b1(contract: Plan, employee: Person, kind: Employer403bKind) kind empirical {
    label en unofficial "the annuity contract is purchased for the employee by this kind of employer or for a minister, case-asserted (section 403(b)(1)(A)(i)-(iii))";
}

pub relation contract_not_subject_to_403a_403b1B(contract: Plan) kind empirical {
    label en unofficial "the annuity contract is not subject to subsection (a), case-asserted ((B))";
}

pub relation contract_rights_nonforfeitable_403b1C(contract: Plan) kind empirical {
    label en unofficial "the employee's rights under the contract are nonforfeitable except for failure to pay future premiums, case-asserted ((C))";
}

pub relation contract_church_purchased_403b1D(contract: Plan) kind empirical {
    label en unofficial "the contract is purchased by a church, case-asserted ((D) exception)";
}

pub relation contract_plan_meets_nondiscrimination_403b12_403b1D(contract: Plan) kind empirical {
    label en unofficial "the plan meets the nondiscrimination requirements of paragraph (12), case-asserted (the paragraph (12) test is derived below)";
}

pub relation contract_salary_reduction_403b1E(contract: Plan) kind empirical {
    label en unofficial "the contract is purchased under a salary reduction agreement, case-asserted ((E))";
}

pub relation contract_meets_401a30_403b1E(contract: Plan) kind empirical {
    label en unofficial "the contract meets the requirements of section 401(a)(30), case-asserted ((E))";
}

pub relation contract_meets_401a37_403b14(contract: Plan) kind empirical {
    label en unofficial "the contract meets the requirements of section 401(a)(37) (death benefit for qualified reservists), case-asserted (section 403(b)(14))";
}

pub relation section_403b_exclusion_conditions_met_403b1(contract: Plan, employee: Person) kind institutional {
    label en official "section 403(b)(1): the purchase conditions (A)-(E) and the (14) requirement are met, so employer contributions are excluded from gross income within the section 415 limit";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "then contributions and other additions by such employer for such annuity contract shall be excluded from the gross income of the employee for the taxable year")
rule Section403bExclusionConditionsMet(contract: Plan, employee: Person, kind: Employer403bKind) strict {
    label en official "PARTIAL: (A) any of the three employer kinds, (B) not subject to (a), (C) nonforfeitable, (D) nondiscrimination unless a church contract, (E) 401(a)(30) for salary reduction contracts, (14) 401(a)(37); the section 415 limit on the excluded amount is (c) in module 05";
    when contract_purchased_by_employer_403b1(contract, employee, kind)
        and contract_not_subject_to_403a_403b1B(contract)
        and contract_rights_nonforfeitable_403b1C(contract)
        and contract_plan_meets_nondiscrimination_403b12_403b1D(contract)
        and not_known(contract_salary_reduction_without_401a30_403b1E(contract))
        and contract_meets_401a37_403b14(contract);
    then section_403b_exclusion_conditions_met_403b1(contract, employee);
}

pub relation contract_salary_reduction_without_401a30_403b1E(contract: Plan) kind institutional {
    label en unofficial "helper: a salary reduction contract that does not meet section 401(a)(30)";
}

rule ContractSalaryReductionWithout401a30(contract: Plan) strict {
    label en unofficial "the (E) failure";
    when contract_salary_reduction_403b1E(contract) and not_known(contract_meets_401a30_403b1E(contract));
    then contract_salary_reduction_without_401a30_403b1E(contract);
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "except in the case of a contract purchased by a church, such contract is purchased under a plan which meets the nondiscrimination requirements of paragraph (12)")
rule Section403bExclusionChurchContract(contract: Plan, employee: Person, kind: Employer403bKind) strict {
    label en official "PARTIAL: a church contract is exempt from the (D) nondiscrimination requirement";
    when contract_purchased_by_employer_403b1(contract, employee, kind)
        and contract_church_purchased_403b1D(contract)
        and contract_not_subject_to_403a_403b1B(contract)
        and contract_rights_nonforfeitable_403b1C(contract)
        and not_known(contract_salary_reduction_without_401a30_403b1E(contract))
        and contract_meets_401a37_403b14(contract);
    then section_403b_exclusion_conditions_met_403b1(contract, employee);
}

// =====================================================================
// (b)(4) Years of service
// =====================================================================

pub relation full_time_years_of_service_403b4(employee: Person, employer: Person, years: Decimal) kind empirical {
    label en unofficial "the number of full years during which the individual was a full-time employee of the organization purchasing the contract, case-asserted (section 403(b)(4)(A))";
}

pub relation fractional_years_of_service_403b4(employee: Person, employer: Person, fraction: Decimal) kind empirical {
    label en unofficial "the fraction of a year for part-time employment and for partial years, determined in accordance with the Secretary's regulations, case-asserted ((B))";
}

pub relation years_of_service_403b4(employee: Person, employer: Person, years: Decimal) kind institutional {
    label en official "section 403(b)(4): full years plus fractions, and never less than one";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "In no case shall the number of years of service be less than one.")
rule YearsOfService403b4(employee: Person, employer: Person, full: Decimal, fraction: Decimal) strict {
    label en official "PARTIAL: full + fraction, with a floor of 1; the fraction is regulatory";
    when full_time_years_of_service_403b4(employee, employer, full) and fractional_years_of_service_403b4(employee, employer, fraction);
    then years_of_service_403b4(employee, employer, max(full + fraction, 1.0));
}

// =====================================================================
// (b)(7), (b)(11), (b)(17) Distribution restrictions and hardship
// =====================================================================

pub enum DistributionEvent403b {
    EmployeeDeath;
    Age59AndAHalf;
    SeveranceFromEmployment;
    Disability;
    FinancialHardship;
    Section72t2GDistribution;
    LifetimeIncomeInvestmentNearEnd;
}

pub relation distribution_event_403b(d: Distribution, ev_kind: DistributionEvent403b) kind empirical {
    label en unofficial "the event upon which the distribution is made, case-asserted (section 403(b)(7)(A)(ii), (b)(11))";
}

pub relation distribution_permitted_403b11(d: Distribution) kind institutional {
    label en official "section 403(b)(11): distributions attributable to salary reduction contributions may be made only upon age 59 1/2, severance, death, disability, hardship, a section 72(t)(2)(G) distribution, or (with conditions) a lifetime income investment";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "when the employee attains age 59½, has a severance from employment, dies, or becomes disabled")
rule DistributionPermitted403b11Common(d: Distribution, ev_kind: DistributionEvent403b) strict {
    label en official "PARTIAL: (A) age 59 1/2, severance, death, disability; (B) hardship (needs the (17) test); (C) section 72(t)(2)(G); (D) lifetime income investment need the conditions of the rows below";
    when distribution_event_403b(d, ev_kind)
        and ev_kind != FinancialHardship
        and ev_kind != LifetimeIncomeInvestmentNearEnd;
    then distribution_permitted_403b11(d);
}

pub relation hardship_need_immediate_and_heavy_403b(d: Distribution) kind empirical {
    label en unofficial "the distribution is on account of a financial need of a type the regulations deem an immediate and heavy financial need, case-asserted (section 403(b)(7)(D)(i))";
}

pub relation hardship_amount_and_need_403b(d: Distribution, amount: Money, need: Money) kind empirical {
    label en unofficial "the distribution amount and the amount required to satisfy the financial need, case-asserted ((D)(ii))";
}

pub relation hardship_no_alternative_means_403b(d: Distribution) kind empirical {
    label en unofficial "the employee certifies that no alternative means are reasonably available to satisfy the need, case-asserted ((D) closing)";
}

pub relation hardship_distribution_403b17(d: Distribution) kind institutional {
    label en official "section 403(b)(7)(D), (11): a distribution is made upon hardship when it meets an immediate and heavy need, does not exceed it, and the employee has no alternative means";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "not in excess of the amount required to satisfy such financial need")
rule HardshipDistribution403b17(d: Distribution, amount: Money, need: Money) strict {
    label en official "PARTIAL: exact boundary: the distribution equal to the need is allowed; the regulatory exceptions for actual knowledge are not derived; the administrator may rely on the written certification";
    when hardship_need_immediate_and_heavy_403b(d)
        and hardship_amount_and_need_403b(d, amount, need)
        and amount <= need
        and hardship_no_alternative_means_403b(d);
    then hardship_distribution_403b17(d);
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "subject to the provisions of paragraph (17), in the case of hardship")
rule DistributionPermitted403b11Hardship(d: Distribution) strict {
    label en official "PARTIAL: (B) hardship, through paragraph (17)";
    when distribution_event_403b(d, FinancialHardship) and hardship_distribution_403b17(d);
    then distribution_permitted_403b11(d);
}

pub relation lifetime_income_days_before_end_403b(d: Distribution, days: Integer) kind empirical {
    label en unofficial "how many days before the lifetime income investment may no longer be held as an investment option the distribution is made, case-asserted (section 403(b)(11)(D)(i))";
}

pub relation lifetime_income_in_qualified_form_403b(d: Distribution) kind empirical {
    label en unofficial "the distribution is a qualified distribution or a qualified plan distribution annuity contract (section 401(a)(38)(B)), case-asserted ((D)(ii))";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "on or after the date that is 90 days prior to the date that such lifetime income investment may no longer be held as an investment option under the contract")
rule DistributionPermitted403b11LifetimeIncome(d: Distribution, days: Integer) strict {
    label en official "PARTIAL: exact boundary: 90 days before the date is allowed, 91 is not; only in a qualified form";
    when distribution_event_403b(d, LifetimeIncomeInvestmentNearEnd)
        and lifetime_income_days_before_end_403b(d, days)
        and days <= 90
        and lifetime_income_in_qualified_form_403b(d);
    then distribution_permitted_403b11(d);
}

pub enum HardshipAmountKind403b {
    SalaryReductionContribution;
    QualifiedNonelectiveContribution;
    QualifiedMatchingContribution;
    EarningsOnThose;
    OtherAmount;
}

pub relation hardship_amount_kind_403b(d: Distribution, kind: HardshipAmountKind403b) kind empirical {
    label en unofficial "the kind of amount distributed on hardship, case-asserted (section 403(b)(17)(A))";
}

pub relation hardship_amount_distributable_403b17A(d: Distribution) kind institutional {
    label en official "section 403(b)(17)(A): salary reduction contributions, qualified nonelective and matching contributions, and their earnings may be distributed on hardship";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "The following amounts may be distributed upon hardship of the employee")
rule HardshipAmountDistributable403b17A(d: Distribution, kind: HardshipAmountKind403b) strict {
    label en official "any of the four listed kinds";
    when hardship_amount_kind_403b(d, kind) and kind != OtherAmount;
    then hardship_amount_distributable_403b17A(d);
}

pub relation hardship_loan_available_not_taken_403b17B(d: Distribution) kind empirical {
    label en unofficial "the employee did not take an available loan under the plan, case-asserted (section 403(b)(17)(B))";
}

pub relation hardship_not_defeated_by_untaken_loan_403b17B(d: Distribution) kind institutional {
    label en official "section 403(b)(17)(B): not taking an available plan loan does not by itself defeat hardship";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "A distribution shall not be treated as failing to be made upon the hardship of an employee solely because the employee does not take any available loan under the plan")
rule HardshipNotDefeatedByUntakenLoan403b17B(d: Distribution) strict {
    label en official "the untaken loan is not a ground of failure";
    when hardship_loan_available_not_taken_403b17B(d);
    then hardship_not_defeated_by_untaken_loan_403b17B(d);
}

// =====================================================================
// (b)(12) Nondiscrimination requirements
// =====================================================================

pub relation nonsalary_reduction_contributions_meet_401a_403b12Ai(contract: Plan) kind empirical {
    label en unofficial "for contributions not made by salary reduction, the plan meets sections 401(a)(4), (5), (17), (26), 401(m) and 410(b) as if it were a section 401(a) plan, case-asserted (section 403(b)(12)(A)(i))";
}

pub relation all_employees_may_elect_over_200_403b12Aii(contract: Plan) kind empirical {
    label en unofficial "all employees of the organization may elect to have the employer contribute more than $200 by salary reduction if any employee may, case-asserted ((A)(ii))";
}

pub relation nondiscrimination_403b12A_met(contract: Plan) kind institutional {
    label en official "section 403(b)(12)(A): both the coverage-test clause (i) and the universal availability clause (ii) are met";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "all employees of the organization may elect to have the employer make contributions of more than $200 pursuant to a salary reduction agreement if any employee of the organization may elect to have the organization make contributions for such contracts pursuant to such agreement")
rule Nondiscrimination403b12AMet(contract: Plan) strict {
    label en official "(i) and (ii)";
    when nonsalary_reduction_contributions_meet_401a_403b12Ai(contract) and all_employees_may_elect_over_200_403b12Aii(contract);
    then nondiscrimination_403b12A_met(contract);
}

// =====================================================================
// (b)(13) Transfers to a defined benefit governmental plan
// =====================================================================

pub relation direct_transfer_to_governmental_db_plan_403b13(d: Distribution) kind empirical {
    label en unofficial "a direct trustee-to-trustee transfer to a defined benefit governmental plan, case-asserted (section 403(b)(13))";
}

pub relation transfer_for_permissive_service_credit_403b13A(d: Distribution) kind empirical {
    label en unofficial "the transfer is for the purchase of permissive service credit under the plan (section 415(n)(3)(A)), case-asserted ((A))";
}

pub relation transfer_is_repayment_outside_415_403b13B(d: Distribution) kind empirical {
    label en unofficial "the transfer is a repayment to which section 415 does not apply by reason of section 415(k)(3), case-asserted ((B))";
}

pub relation governmental_transfer_not_includible_403b13(d: Distribution) kind institutional {
    label en official "section 403(b)(13): no inclusion in gross income for a direct transfer to a defined benefit governmental plan for service credit or a section 415(k)(3) repayment";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "for the purchase of permissive service credit (as defined in section 415(n)(3)(A)) under such plan")
rule GovernmentalTransferNotIncludibleServiceCredit(d: Distribution) strict {
    label en official "(A)";
    when direct_transfer_to_governmental_db_plan_403b13(d) and transfer_for_permissive_service_credit_403b13A(d);
    then governmental_transfer_not_includible_403b13(d);
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "a repayment to which section 415 does not apply by reason of subsection (k)(3) thereof")
rule GovernmentalTransferNotIncludibleRepayment(d: Distribution) strict {
    label en official "(B)";
    when direct_transfer_to_governmental_db_plan_403b13(d) and transfer_is_repayment_outside_415_403b13B(d);
    then governmental_transfer_not_includible_403b13(d);
}

// =====================================================================
// (b)(16) Safe harbor deferral-only plans
// =====================================================================

pub relation employer_maintains_qualified_plan_for_year_403b16(employer: Person) kind empirical {
    label en unofficial "the employer maintains a qualified plan with respect to which contributions are made or benefits accrue for service in the year, case-asserted (section 403(b)(16)(E)(i))";
}

pub relation safe_harbor_eligible_employer_403b16E(employer: Person) kind institutional {
    label en official "section 403(b)(16)(E)(i): an employer that does not maintain such a qualified plan for the year";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "The term \"eligible employer\" means any employer if the employer does not maintain a qualified plan with respect to which contributions are made, or benefits are accrued, for service in the year for which the determination is being made")
rule SafeHarborEligibleEmployer403b16E(employer: Person, plan: Plan) strict {
    label en official "PARTIAL: the absence of a qualified plan; the 410(b)(3)(A) carve-out and the 408(p)(10) rules are not derived";
    when plan_sponsor(plan, employer) and not_known(employer_maintains_qualified_plan_for_year_403b16(employer));
    then safe_harbor_eligible_employer_403b16E(employer);
}

pub relation auto_deferral_qualified_percentage_403b16C(plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the qualified percentage of compensation each eligible employee is treated as having elected, applied uniformly, as a fraction, case-asserted (section 403(b)(16)(C)(iii))";
}

pub relation auto_deferral_requirement_met_403b16C(plan: Plan) kind institutional {
    label en official "section 403(b)(16)(C): each eligible employee is treated as electing a uniform percentage of not less than 3 nor more than 15 percent";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "any percentage determined under the plan if such percentage is applied uniformly and is not less than 3 or more than 15 percent")
rule AutoDeferralRequirementMet403b16C(plan: Plan, pct: Decimal) strict {
    label en official "exact boundaries: 3 percent and 15 percent are both allowed";
    when auto_deferral_qualified_percentage_403b16C(plan, pct) and pct >= 0.03 and pct <= 0.15;
    then auto_deferral_requirement_met_403b16C(plan);
}

pub relation only_elective_contributions_allowed_403b16D(plan: Plan) kind empirical {
    label en unofficial "the only contributions that may be made are elective contributions of eligible employees, case-asserted ((D)(i)(I))";
}

pub relation maximum_annual_elective_contribution_403b16D(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the aggregate elective contributions the plan permits for an employee for a calendar year, case-asserted ((D)(i)(II))";
}

pub relation contribution_limitation_requirement_met_403b16D(plan: Plan) kind institutional {
    label en official "section 403(b)(16)(D): only elective contributions, and not more than $6,000 per calendar year (indexed after 2024; the age-50 catch-up applies)";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "the aggregate amount of such elective contributions which may be made with respect to any employee for any calendar year shall not exceed $6,000")
rule ContributionLimitationRequirementMet403b16D(plan: Plan, maximum: Money) strict {
    label en official "PARTIAL: exact boundary $6,000 (the pinned base; the cost-of-living adjustment after 2024 and the age-50 catch-up are SOURCE_GAP)";
    when only_elective_contributions_allowed_403b16D(plan) and maximum_annual_elective_contribution_403b16D(plan, maximum) and maximum <= 6000.00 USD;
    then contribution_limitation_requirement_met_403b16D(plan);
}

pub relation meets_401k13E_notice_and_other_403b16(plan: Plan) kind empirical {
    label en unofficial "the plan meets the requirements of section 401(k)(13)(E), case-asserted ((b)(iii))";
}

pub relation safe_harbor_deferral_only_plan_403b16(plan: Plan) kind institutional {
    label en official "section 403(b)(16)(B): a plan with the automatic deferral, the contribution limitations and the section 401(k)(13)(E) requirements";
}

@source(IRC_S403_B, relation = formalizes, coverage = exact, quote = "the term \"safe harbor deferral-only plan\" means any plan which meets")
rule SafeHarborDeferralOnlyPlan403b16(plan: Plan) strict {
    label en official "(i), (ii) and (iii)";
    when auto_deferral_requirement_met_403b16C(plan)
        and contribution_limitation_requirement_met_403b16D(plan)
        and meets_401k13E_notice_and_other_403b16(plan);
    then safe_harbor_deferral_only_plan_403b16(plan);
}

pub relation safe_harbor_plan_treated_as_meeting_403b12_403b16(plan: Plan, employer: Person) kind institutional {
    label en official "section 403(b)(16)(A): a safe harbor deferral-only plan of an eligible employer is treated as meeting the nondiscrimination requirements of paragraph (12)";
}

@source(IRC_S403_B, relation = formalizes, coverage = partial, quote = "A safe harbor deferral-only plan maintained by an eligible employer shall be treated as meeting the requirements")
rule SafeHarborPlanTreatedAsMeeting403b12(plan: Plan, employer: Person) strict {
    label en official "PARTIAL: safe harbor plan and eligible employer";
    when safe_harbor_deferral_only_plan_403b16(plan) and plan_sponsor(plan, employer) and safe_harbor_eligible_employer_403b16E(employer);
    then safe_harbor_plan_treated_as_meeting_403b12_403b16(plan, employer);
}
