// Section 417 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 15 carries the QJSA percentage band, the waiver power with spousal
// consent, the 180-day election period and the explanation duty. This
// module adds (a)(1)(A) the qualified optional survivor annuity election and
// the revocation, (a)(4) loan security consent, (a)(5) the full subsidy
// exception, (a)(6)(B) and (a)(7) election period and explanation timing,
// (d) the marriage requirement, (e) cash-out of small annuities, and (g) the
// qualified optional survivor annuity percentage.
//
// Method: exact date arithmetic (scenarios need the IRC calendar-step
// policy) and exact comparison of the pinned mandatory distribution
// threshold (the A3 parameter of the package).

// =====================================================================
// (a)(1)(A) Qualified optional survivor annuity and revocation
// =====================================================================

use self::{
    IRC_S417_A,
    IRC_S417_D,
    IRC_S417_E,
    IRC_S417_G,
    Person,
    Plan,
    participates_in,
    qjsa_waived,
};

pub relation qosa_election_made_417(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the participant who has waived the qualified joint and survivor annuity elects the qualified optional survivor annuity, case-asserted (section 417(a)(1)(A)(ii))";
}

pub relation qosa_elected_417(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(1)(A)(ii): the qualified optional survivor annuity is elected";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "if the participant elects a waiver under clause (i), may elect the qualified optional survivor annuity at")
rule ElectQosaPower417(participant: Person, plan: Plan, on: Date) strict {
    label en official "the election is possible only after a valid waiver";
    when qosa_election_made_417(participant, plan, on) and participates_in(participant, plan);
    then power ElectQualifiedOptionalSurvivorAnnuity {
        holder participant;
        over plan;
        exercise qosa_election_made_417(participant, plan, on);
        valid_when qjsa_waived(participant, plan);
        effect qosa_elected_417(participant, plan);
    };
}

pub relation waiver_revocation_made_417(participant: Person, plan: Plan, on: Date, annuity_starting_date: Date) kind empirical {
    label en unofficial "the participant revokes the waiver on this date, before the annuity starting date, case-asserted (section 417(a)(1)(A)(iii))";
}

pub relation revocation_within_election_period_417(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "the revocation is made during the applicable election period, no later than the annuity starting date";
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "may revoke any such election at any time during the applicable election period")
rule RevocationWithinElectionPeriod417(participant: Person, plan: Plan, on: Date, asd: Date) strict {
    label en official "PARTIAL: exact boundary: the annuity starting date itself is in time; the 180-day start is module 15";
    when waiver_revocation_made_417(participant, plan, on, asd) and on <= asd;
    then revocation_within_election_period_417(participant, plan, on);
}

pub relation waiver_revoked_417(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(1)(A)(iii): the waiver is revoked and the default survivor form applies again";
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "may revoke any such election at any time during the applicable election period")
rule RevokeWaiverPower417(participant: Person, plan: Plan, on: Date, asd: Date) strict {
    label en official "PARTIAL: revocation of an existing waiver";
    when waiver_revocation_made_417(participant, plan, on, asd) and participates_in(participant, plan);
    then power RevokeSurvivorAnnuityWaiver {
        holder participant;
        over plan;
        exercise waiver_revocation_made_417(participant, plan, on, asd);
        valid_when revocation_within_election_period_417(participant, plan, on);
        effect waiver_revoked_417(participant, plan);
    };
}

// =====================================================================
// (a)(4) Loan security; (a)(5) Full subsidy exception
// =====================================================================

pub relation loan_secured_on_417a4(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the participant's accrued benefit is to be used as security for a loan, case-asserted (section 417(a)(4))";
}

pub relation spouse_loan_consent_on_417a4(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the spouse consents in writing to the use of the accrued benefit as security, case-asserted ((A))";
}

pub relation loan_security_spouse_consent_timely_417a4(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(4)(A): the spouse's written consent falls within the 90-day period ending on the date the loan is secured";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the spouse of the participant (if any) consents in writing to such use during the 90-day period ending on the date on which the loan is to be so secured")
rule LoanSecuritySpouseConsentTimely417a4(participant: Person, plan: Plan, loan: Date, consent: Date, calendar_before_1: Date) strict {
    label en official "exact boundaries: 90 days before the loan date through the loan date, inclusive";
    when loan_secured_on_417a4(participant, plan, loan)
        and spouse_loan_consent_on_417a4(participant, plan, consent)
        and consent >= calendar_before_1
        and consent <= loan
        and us.irc.core::civil_calendar_boundary_before(loan, 90, us.irc.core::CalendarDay, calendar_before_1);
    then loan_security_spouse_consent_timely_417a4(participant, plan);
}

pub relation plan_uses_benefit_as_security_417a4(sponsor: Person, participant: Person) kind institutional {
    label en official "action atom of the loan security prohibition";
}

pub relation plan_secures_loan_with_benefit_417a4(sponsor: Person, participant: Person, plan: Plan) kind empirical {
    label en unofficial "the plan takes the participant's accrued benefit as security for a loan, case-asserted";
}

rule PlanUsesBenefitAsSecurity417a4(sponsor: Person, participant: Person, plan: Plan) strict {
    label en unofficial "the action is realized when the plan takes the security";
    when plan_secures_loan_with_benefit_417a4(sponsor, participant, plan) and not_known(loan_security_spouse_consent_timely_417a4(participant, plan));
    then plan_uses_benefit_as_security_417a4(sponsor, participant);
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "no portion of the participant's accrued benefit may be used as security for such loan unless")
rule LoanSecurityWithoutConsentProhibition417a4(sponsor: Person, participant: Person, plan: Plan) strict {
    label en official "PARTIAL: the prohibition for a plan under which section 401(a)(11) applies; the comparable spousal consent formalities ((B)) are module 15";
    when plan_secures_loan_with_benefit_417a4(sponsor, participant, plan);
    then prohibition UseBenefitAsLoanSecurityWithoutConsent {
        bearer sponsor;
        action plan_uses_benefit_as_security_417a4(sponsor, participant);
        window [-infinity, infinity];
    };
}

pub relation benefit_may_not_be_waived_417a5(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the survivor benefit may not be waived (or another beneficiary selected), case-asserted (section 417(a)(5)(A))";
}

pub relation waiver_would_reduce_benefits_or_raise_contributions_417a5B(participant: Person, plan: Plan) kind empirical {
    label en unofficial "failure to waive the benefit would decrease plan benefits or increase the participant's contributions, case-asserted ((B))";
}

pub relation requirements_not_applicable_full_subsidy_417a5(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(5): the subsection does not apply to a non-waivable benefit whose cost the plan fully subsidizes";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "if such benefit may not be waived (or another beneficiary selected) and if the plan fully subsidizes the costs of such benefit")
rule RequirementsNotApplicableFullSubsidy417a5(participant: Person, plan: Plan) strict {
    label en official "non-waivable and fully subsidized (no benefit decrease, no contribution increase)";
    when benefit_may_not_be_waived_417a5(participant, plan) and not_known(waiver_would_reduce_benefits_or_raise_contributions_417a5B(participant, plan));
    then requirements_not_applicable_full_subsidy_417a5(participant, plan);
}

// =====================================================================
// (a)(6)(B), (a)(7) Election period and explanation timing
// =====================================================================

pub relation plan_year_start_age_35_417a6(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the first day of the plan year in which the participant attains age 35, case-asserted (section 417(a)(6)(B))";
}

pub relation separation_date_417a6(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the participant separates from service, case-asserted";
}

pub relation qpsa_election_period_start_417a6B(participant: Person, plan: Plan, start: Date) kind institutional {
    label en official "section 417(a)(6)(B): the election period to waive the qualified preretirement survivor annuity begins on the first day of the plan year in which the participant attains age 35 (for benefits accrued before a separation, not later than the separation date)";
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "the period which begins on the first day of the plan year in which the participant attains age 35 and ends on the date of the participant's death")
rule QpsaElectionPeriodStart417a6B(participant: Person, plan: Plan, age35: Date) strict {
    label en official "PARTIAL: the start for a participant not separated; the end is the date of death";
    when plan_year_start_age_35_417a6(participant, plan, age35) and not_known(participant_separated_417a6(participant, plan));
    then qpsa_election_period_start_417a6B(participant, plan, age35);
}

pub relation participant_separated_417a6(participant: Person, plan: Plan) kind institutional {
    label en unofficial "helper: a separation date exists";
}

rule ParticipantSeparated417a6(participant: Person, plan: Plan, on: Date) strict {
    label en unofficial "derives the helper";
    when separation_date_417a6(participant, plan, on);
    then participant_separated_417a6(participant, plan);
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the applicable election period under subparagraph (B) with respect to benefits accrued before the date of such separation from service shall not begin later than such date")
rule QpsaElectionPeriodStartSeparated417a6B(participant: Person, plan: Plan, age35: Date, separated: Date) strict {
    label en official "min(age-35 plan year start, separation date)";
    when plan_year_start_age_35_417a6(participant, plan, age35) and separation_date_417a6(participant, plan, separated);
    then qpsa_election_period_start_417a6B(participant, plan, min(age35, separated));
}

pub relation explanation_provided_after_asd_on_417a7(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the written explanation is provided after the annuity starting date, case-asserted (section 417(a)(7)(A)(i))";
}

pub relation election_period_earliest_end_417a7A(participant: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 417(a)(7)(A)(i): when the explanation follows the annuity starting date the election period does not end before the 30th day after the explanation";
}

@source(IRC_S417_A, relation = formalizes, coverage = exact, quote = "the applicable election period under paragraph (6) shall not end before the 30th day after the date on which such explanation is provided")
rule ElectionPeriodEarliestEnd417a7A(participant: Person, plan: Plan, provided: Date) strict {
    label en official "explanation + 30 days, exact";
    when explanation_provided_after_asd_on_417a7(participant, plan, provided);
    then election_period_earliest_end_417a7A(participant, plan, add_calendar_period(provided, 30 calendar_day));
}

pub relation explanation_provided_on_417a7B(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the written explanation is provided, case-asserted (section 417(a)(7)(B))";
}

pub relation distribution_commences_on_417a7B(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the distribution commences, case-asserted";
}

pub relation thirty_day_wait_waiver_permitted_417a7B(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(a)(7)(B): the 30-day explanation waiting period may be waived if the distribution commences more than 7 days after the explanation";
}

@source(IRC_S417_A, relation = formalizes, coverage = partial, quote = "if the distribution commences more than 7 days after such explanation is provided")
rule ThirtyDayWaitWaiverPermitted417a7B(participant: Person, plan: Plan, provided: Date, commences: Date) strict {
    label en official "PARTIAL: exact boundary: the 8th day is more than 7 days after, the 7th is not; the participant's election with any spousal consent is module 15";
    when explanation_provided_on_417a7B(participant, plan, provided)
        and distribution_commences_on_417a7B(participant, plan, commences)
        and commences > add_calendar_period(provided, 7 calendar_day);
    then thirty_day_wait_waiver_permitted_417a7B(participant, plan);
}

// =====================================================================
// (d) Marriage requirement
// =====================================================================

pub relation marriage_date_417d(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the participant's marriage to the spouse, case-asserted (section 417(d)(2))";
}

pub relation annuity_starting_date_417d(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the participant's annuity starting date, case-asserted";
}

pub relation date_of_death_417d(participant: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the participant's death, case-asserted ((d)(2)(B))";
}

pub relation treated_as_married_throughout_year_417d2(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(d)(2): a marriage within 1 year before the annuity starting date that lasts at least a year (ending on or before death) is treated as lasting throughout the 1-year period";
}

@source(IRC_S417_D, relation = formalizes, coverage = exact, quote = "the participant and the participant's spouse in such marriage have been married for at least a 1-year period ending on or before the date of the participant's death")
rule TreatedAsMarriedThroughoutYear417d2(participant: Person, plan: Plan, married: Date, asd: Date, death: Date, calendar_before_1: Date) strict {
    label en official "exact boundaries: married after one year before the starting date (the anniversary itself is not within 1 year before) and not after it; the 1-year period must end on or before death";
    when marriage_date_417d(participant, plan, married)
        and annuity_starting_date_417d(participant, plan, asd)
        and date_of_death_417d(participant, plan, death)
        and married > calendar_before_1
        and married <= asd
        and add_calendar_period(married, 1 calendar_year) <= death
        and us.irc.core::civil_calendar_boundary_before(asd, 1, us.irc.core::CalendarYear, calendar_before_1);
    then treated_as_married_throughout_year_417d2(participant, plan);
}

// =====================================================================
// (e) Cash-out of small survivor annuities
// =====================================================================

pub relation survivor_annuity_present_value_417e(participant: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the present value of the qualified joint and survivor annuity or qualified preretirement survivor annuity, computed under (e)(3), case-asserted";
}

pub relation distribution_after_annuity_starting_date_417e(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the distribution is made after the annuity starting date, case-asserted (section 417(e)(1))";
}

pub relation participant_and_spouse_consent_417e(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the participant and the spouse (or surviving spouse) consent in writing to the distribution, case-asserted (section 417(e)(1), (2)(B))";
}

pub relation immediate_distribution_permitted_417e(participant: Person, plan: Plan) kind institutional {
    label en official "section 417(e)(1)-(2): the present value may be distributed immediately when it does not exceed the threshold; a larger value or one after the annuity starting date needs the consent of both";
}

@source(IRC_S417_E, relation = formalizes, coverage = partial, quote = "will be immediately distributed if such value does not exceed the amount that can be distributed without the participant's consent under section 411(a)(11)")
rule ImmediateDistributionSmall417e1(participant: Person, plan: Plan, pv: Money) strict {
    label en official "PARTIAL: at or below the pinned threshold (the A3 parameter; the 2024 edition value), before the annuity starting date, no consent needed";
    when survivor_annuity_present_value_417e(participant, plan, pv)
        and pv <= MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD
        and not_known(distribution_after_annuity_starting_date_417e(participant, plan));
    then immediate_distribution_permitted_417e(participant, plan);
}

@source(IRC_S417_E, relation = formalizes, coverage = partial, quote = "No distribution may be made under the preceding sentence after the annuity starting date unless the participant and the spouse of the participant")
rule ImmediateDistributionSmallAfterAsd417e1(participant: Person, plan: Plan, pv: Money) strict {
    label en official "PARTIAL: after the annuity starting date the consent of both is required";
    when survivor_annuity_present_value_417e(participant, plan, pv)
        and pv <= MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD
        and distribution_after_annuity_starting_date_417e(participant, plan)
        and participant_and_spouse_consent_417e(participant, plan);
    then immediate_distribution_permitted_417e(participant, plan);
}

@source(IRC_S417_E, relation = formalizes, coverage = exact, quote = "the participant and the spouse of the participant (or where the participant has died, the surviving spouse) consent in writing to the distribution")
rule ImmediateDistributionLarge417e2(participant: Person, plan: Plan, pv: Money) strict {
    label en official "exact boundary: above the threshold, with the consent of both";
    when survivor_annuity_present_value_417e(participant, plan, pv)
        and pv > MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD
        and participant_and_spouse_consent_417e(participant, plan);
    then immediate_distribution_permitted_417e(participant, plan);
}

// =====================================================================
// (g) Qualified optional survivor annuity
// =====================================================================

pub relation qjsa_survivor_annuity_percentage_417g(plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "the percentage the survivor annuity under the plan's qualified joint and survivor annuity bears to the annuity payable during the joint lives, as a fraction, case-asserted (section 417(g)(2)(B))";
}

pub relation qosa_applicable_percentage_417g2(plan: Plan, pct: Decimal) kind institutional {
    label en official "section 417(g)(2)(A): 75 percent when the QJSA survivor percentage is under 75 percent, otherwise 50 percent";
}

@source(IRC_S417_G, relation = formalizes, coverage = exact, quote = "is less than 75 percent, the applicable percentage is 75 percent")
rule QosaApplicablePercentageLow417g2(plan: Plan, pct: Decimal) strict {
    label en official "(i): strictly under 75 percent gives 75 percent";
    when qjsa_survivor_annuity_percentage_417g(plan, pct) and pct < 0.75;
    then qosa_applicable_percentage_417g2(plan, 0.75);
}

@source(IRC_S417_G, relation = formalizes, coverage = exact, quote = "is greater than or equal to 75 percent, the applicable percentage is 50 percent")
rule QosaApplicablePercentageHigh417g2(plan: Plan, pct: Decimal) strict {
    label en official "(ii): 75 percent or more gives 50 percent";
    when qjsa_survivor_annuity_percentage_417g(plan, pct) and pct >= 0.75;
    then qosa_applicable_percentage_417g2(plan, 0.50);
}

pub relation joint_lives_annuity_amount_417g(plan: Plan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the annuity payable during the joint lives of the participant and the spouse, case-asserted";
}

pub relation qosa_survivor_annuity_amount_417g1A(plan: Plan, participant: Person, amount: Money) kind institutional {
    label en official "section 417(g)(1)(A): the survivor annuity equals the applicable percentage of the joint lives annuity";
}

@source(IRC_S417_G, relation = formalizes, coverage = partial, quote = "with a survivor annuity for the life of the spouse which is equal to the applicable percentage of the amount of the annuity which is payable during the joint lives of the participant and the spouse")
rule QosaSurvivorAnnuityAmount417g1A(plan: Plan, participant: Person, joint: Money, pct: Decimal) strict {
    label en official "PARTIAL: joint amount x applicable percentage; the actuarial equivalence of (B) is not derived";
    when joint_lives_annuity_amount_417g(plan, participant, joint) and qosa_applicable_percentage_417g2(plan, pct);
    then qosa_survivor_annuity_amount_417g1A(plan, participant, round(joint * pct, 2, "HALF_UP"));
}
