// Section 408 — individual retirement accounts: STAGE 2e residual (IRC-09,
// DECISION-0379, 25.09.2026). Adds what modules 07 (stage 1/2b) left out:
// (b) individual retirement annuity, (c) group trusts, (d)(2) aggregation,
// (d)(3)(A)(ii)/(D)/(E)/(G)/(H) rollover refinements, (d)(6) divorce
// transfer, (d)(7) SEP salary-reduction distributions and 402(h)/(k)
// treatment, (d)(9) HSA funding distributions, (g) community property,
// (h) custodial accounts, (i) trustee/issuer reports, (j) SEP limits,
// (n) bank. Module 20 continues with (k)-(l) SEP and (o)-(p) nondeductible /
// SIMPLE residual.
//
// Method: same as module 07 — the account or annuity is a case-asserted
// entity, its terms are empirical facts, each Code requirement is a
// classification over them, and an absent record is `not_known(...)`
// (never closed-world `not`). A duty of a trustee or issuer is a `duty`
// with an achievement goal and the statutory window; an election of the
// individual that changes the regime is a `power` whose single `valid_when`
// atom is a derived relation.

// =====================================================================
// (b) Individual retirement annuity
// =====================================================================

use self::{
    Distribution,
    IRC_S408_B,
    IRC_S408_C,
    IRC_S408_D,
    IRC_S408_G,
    IRC_S408_H,
    IRC_S408_I,
    IRC_S408_J,
    IRC_S408_N,
    Individual,
    IndividualRetirementAccount,
    Person,
    Plan,
    SimpleRetirementAccount,
    TaxableYear,
    frozen_deposit_period,
    ira_distribution,
    ira_established_for,
    participates_in,
    section219_deduction_amount,
};

pub entity IndividualRetirementAnnuity : Plan {
    label en official "individual retirement annuity (section 408(b))";
}

pub relation annuity_issued_by_insurance_company(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the annuity or endowment contract is issued by an insurance company, case-asserted (section 408(b) chapeau)";
}

pub relation annuity_transferable_by_owner(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the contract is transferable by the owner (defeats section 408(b)(1)), case-asserted";
}

pub relation annuity_premiums_fixed(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the premiums under the contract are fixed (defeats section 408(b)(2)(A)), case-asserted";
}

pub relation annuity_annual_premium(a: IndividualRetirementAnnuity, individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the annual premium paid on behalf of the individual for the year, case-asserted (section 408(b)(2)(B))";
}

pub relation annuity_premium_refund_applied_by_next_year_end(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "any refund of premiums is applied before the close of the calendar year following the year of the refund toward future premiums or additional benefits, case-asserted (section 408(b)(2)(C))";
}

pub relation annuity_owner_interest_forfeitable(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the entire interest of the owner is NOT nonforfeitable (defeats section 408(b)(4)), case-asserted";
}

external judgment relation annuity_distribution_rules_per_regulations(a: IndividualRetirementAnnuity) {
    authority Secretary;
    label en official "section 408(b)(3): rules similar to section 401(a)(9) and the incidental-death-benefit requirements of section 401(a) apply, under regulations prescribed by the Secretary, to the distribution of the owner's entire interest — the regulatory determination is the Secretary's, not computed by this package";
}

pub relation annuity_is_annuity_contract(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the contract is an annuity contract (not an endowment contract), case-asserted";
}

pub relation annuity_is_endowment_contract(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the contract is an endowment contract, case-asserted";
}

pub relation endowment_matures_after_applicable_age(a: IndividualRetirementAnnuity) kind empirical {
    label en unofficial "the endowment contract matures later than the taxable year in which the insured individual attains the section 401(a)(9)(C)(v) applicable age, case-asserted";
}

pub relation annuity_contract_form_permitted(a: IndividualRetirementAnnuity) kind institutional {
    label en official "section 408(b): an annuity contract, or an endowment contract that does not mature after the applicable-age year";
}

@source(IRC_S408_B, relation = formalizes, coverage = exact, quote = "means an annuity contract, or an endowment contract (as determined under regulations prescribed by the Secretary), issued by an insurance company")
rule AnnuityFormPermittedAnnuity(a: IndividualRetirementAnnuity) strict {
    label en official "an annuity contract issued by an insurance company has a permitted form";
    when annuity_is_annuity_contract(a) and annuity_issued_by_insurance_company(a);
    then annuity_contract_form_permitted(a);
}

@source(IRC_S408_B, relation = formalizes, coverage = exact, quote = "no contract shall be treated as an endowment contract if it matures later than the taxable year in which the individual in whose name such contract is purchased attains the applicable age")
rule AnnuityFormPermittedEndowment(a: IndividualRetirementAnnuity) strict {
    label en official "an endowment contract keeps its form only while it does not mature after the applicable-age year";
    when annuity_is_endowment_contract(a)
        and annuity_issued_by_insurance_company(a)
        and not_known(endowment_matures_after_applicable_age(a));
    then annuity_contract_form_permitted(a);
}

pub relation annuity_disqualified_from_calendar_year(a: IndividualRetirementAnnuity, first_year: Integer) kind empirical {
    label en unofficial "the contract is disqualified on the application of subsection (e) beginning with the owner's taxable year for this calendar year, case-asserted";
}

pub relation annuity_disqualified_in_or_before(a: IndividualRetirementAnnuity, y: TaxableYear) kind institutional {
    label en official "section 408(b) last paragraph: the year of disqualification under subsection (e) or any subsequent taxable year";
}

@source(IRC_S408_B, relation = formalizes, coverage = exact, quote = "Such term does not include such an annuity contract for any taxable year of the owner in which it is disqualified on the application of subsection (e) or for any subsequent taxable year.")
rule AnnuityDisqualifiedInOrBefore(a: IndividualRetirementAnnuity, y: TaxableYear, first_year: Integer, n: Integer) strict {
    label en official "disqualification carries forward to every later taxable year";
    when annuity_disqualified_from_calendar_year(a, first_year)
        and us.irc.core::calendar_year_of(y, n)
        and n >= first_year;
    then annuity_disqualified_in_or_before(a, y);
}

pub relation annuity_meets_408b_requirements(a: IndividualRetirementAnnuity, individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 408(b)(1)-(4): not transferable, premiums not fixed and within the section 219(b)(1)(A) amount, refunds applied forward, distribution rules per regulations, owner's interest nonforfeitable";
}

@source(IRC_S408_B, relation = formalizes, coverage = exact, quote = "the annual premium on behalf of any individual will not exceed the dollar amount in effect under section 219(b)(1)(A)")
rule AnnuityMeets408bRequirements(a: IndividualRetirementAnnuity, individual: Individual, y: TaxableYear, premium: Money, limit: Money) strict {
    label en official "all four requirements together; the premium test is exact (at the limit is allowed, one cent above is not)";
    when annuity_contract_form_permitted(a)
        and annuity_annual_premium(a, individual, y, premium)
        and section219_deduction_amount(individual, y, limit)
        and premium <= limit
        and annuity_premium_refund_applied_by_next_year_end(a)
        and annuity_distribution_rules_per_regulations(a)
        and not_known(annuity_transferable_by_owner(a))
        and not_known(annuity_premiums_fixed(a))
        and not_known(annuity_owner_interest_forfeitable(a));
    then annuity_meets_408b_requirements(a, individual, y);
}

pub relation individual_retirement_annuity_for_year(a: IndividualRetirementAnnuity, individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 408(b): the contract is an individual retirement annuity for this taxable year of the owner";
}

@source(IRC_S408_B, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"individual retirement annuity\" means an annuity contract")
rule IndividualRetirementAnnuityForYear(a: IndividualRetirementAnnuity, individual: Individual, y: TaxableYear) strict {
    label en official "requirements met and not disqualified under (e) in or before the year";
    when annuity_meets_408b_requirements(a, individual, y)
        and not_known(annuity_disqualified_in_or_before(a, y));
    then individual_retirement_annuity_for_year(a, individual, y);
}

// =====================================================================
// (c) Accounts set up by employers and certain associations of employees
// =====================================================================

pub relation trust_created_in_us_for_employees_or_members(t: Plan) kind empirical {
    label en unofficial "the trust is created or organized in the United States by an employer for the exclusive benefit of his employees (or their beneficiaries), or by an association of employees for the exclusive benefit of its members (or their beneficiaries), case-asserted";
}

pub relation trust_instrument_written_and_meets_408a1_to_6(t: Plan) kind empirical {
    label en unofficial "the written governing instrument satisfies the requirements of section 408(a)(1) through (6), case-asserted (section 408(c)(1))";
}

pub relation trust_separate_accounting_each_member(t: Plan) kind empirical {
    label en unofficial "there is separate accounting for the interest of each employee or member (or spouse), case-asserted (section 408(c)(2))";
}

pub relation trust_separate_accounting_roth_interest(t: Plan) kind empirical {
    label en unofficial "there is separate accounting for any interest of an employee or member (or spouse) in a Roth IRA, case-asserted (section 408(c)(3))";
}

pub relation trust_treated_as_ira_408c(t: Plan) kind institutional {
    label en official "section 408(c): the employer or association trust is treated as an individual retirement account described in subsection (a)";
}

@source(IRC_S408_C, relation = formalizes, coverage = exact, quote = "shall be treated as an individual retirement account (described in subsection (a)), but only if the written governing instrument creating the trust meets the following requirements")
rule TrustTreatedAsIra408c(t: Plan) strict {
    label en official "chapeau plus (1) satisfies 408(a)(1)-(6), (2) separate accounting, (3) separate accounting for any Roth interest";
    when trust_created_in_us_for_employees_or_members(t)
        and trust_instrument_written_and_meets_408a1_to_6(t)
        and trust_separate_accounting_each_member(t)
        and trust_separate_accounting_roth_interest(t);
    then trust_treated_as_ira_408c(t);
}

pub relation trust_assets_held_in_common_fund(t: Plan) kind empirical {
    label en unofficial "the assets of the section 408(c) trust are held in a common fund for the account of all individuals who have an interest in it, case-asserted";
}

pub relation trustee_of(trustee: Person, t: Plan) kind empirical {
    label en unofficial "this person is the trustee of the trust, case-asserted";
}

@source(IRC_S408_C, relation = formalizes, coverage = exact, quote = "The assets of the trust may be held in a common fund for the account of all individuals who have an interest in the trust.")
rule CommonFundLiberty408c(t: Plan, trustee: Person, m: Person) strict {
    label en official "the trustee is at liberty to hold the assets in a common fund; the liberty is against every interested individual";
    when trust_treated_as_ira_408c(t) and trustee_of(trustee, t) and participates_in(m, t);
    then liberty CommonFundHolding {
        holder trustee;
        against m;
        action trust_assets_held_in_common_fund(t);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (d)(2) Special rules for applying section 72 — one contract, one
// distribution, year-end valuation.
// =====================================================================

pub relation ira_value_at_calendar_year_close(ira: Plan, individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of this individual retirement plan at the close of the calendar year in which the taxable year begins, case-asserted (section 408(d)(2)(C))";
}

pub relation ira_distribution_in_taxable_year(ira: Plan, individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount distributed from this individual retirement plan during the taxable year, case-asserted";
}

pub relation ira_aggregate_distributions_treated_as_one(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(2)(B): all distributions during any taxable year are treated as 1 distribution";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "all distributions during any taxable year shall be treated as 1 distribution")
rule IraAggregateDistributionsTreatedAsOne(individual: Individual, y: TaxableYear, ira0: Plan) strict {
    label en official "one distribution equal to the sum over every individual retirement plan of the individual";
    when ira_distribution_in_taxable_year(ira0, individual, y, _);
    then ira_aggregate_distributions_treated_as_one(individual, y,
        sum all amt: Money for ira: Plan where ira_distribution_in_taxable_year(ira, individual, y, amt));
}

pub relation ira_contract_value_for_section72(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(2)(A)/(C): all individual retirement plans are one contract, valued at the close of the calendar year, increased by the distributions during that calendar year";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the value of the contract shall be increased by the amount of any distributions during the calendar year")
rule IraContractValueForSection72(individual: Individual, y: TaxableYear, ira0: Plan, dist: Money) strict {
    label en official "value of the one contract = sum of year-end values + the distributions of the year";
    when ira_value_at_calendar_year_close(ira0, individual, y, _)
        and ira_aggregate_distributions_treated_as_one(individual, y, dist);
    then ira_contract_value_for_section72(individual, y,
        dist + sum all amt: Money for ira: Plan where ira_value_at_calendar_year_close(ira, individual, y, amt));
}

// =====================================================================
// (d)(3) Rollover refinements — (A)(ii) plan-to-plan, (D) partial, (E)
// required distributions, (G) SIMPLE accounts, (H) Roth-type partial.
// =====================================================================

pub relation eligible_retirement_plan_408d3(plan: Plan) kind empirical {
    label en unofficial "the receiving plan is an eligible retirement plan described in clause (iii), (iv), (v) or (vi) of section 402(c)(8)(B), case-asserted (section 408(d)(3)(A) last sentence)";
}

pub relation ira_rollover_to_plan_made(individual: Individual, d: Distribution, target: Plan, on: Date, amount: Money) kind empirical {
    label en unofficial "the individual paid this amount from the distribution into an eligible retirement plan on this date, case-asserted";
}

pub relation ira_distribution_includible_before_rollover(d: Distribution, amount: Money) kind empirical {
    label en unofficial "the portion of the amount received that is includible in gross income determined without regard to section 408(d)(3), case-asserted (section 408(d)(3)(A)(ii))";
}

pub relation ira_rollover_to_plan_timely(individual: Individual, d: Distribution, target: Plan) kind institutional {
    label en official "section 408(d)(3)(A)(ii): the amount is paid into an eligible retirement plan not later than the 60th day after receipt";
}

pub relation plan_is_individual_retirement_account_or_annuity(plan: Plan) kind empirical {
    label en unofficial "the receiving plan is an individual retirement account or annuity (clause (i) of section 408(d)(3)(A)), case-asserted";
}

pub relation eligible_plan_408d3(plan: Plan) kind institutional {
    label en official "section 408(d)(3)(D)(ii): any account, annuity, contract or plan referred to in subparagraph (A) — an IRA or an eligible retirement plan";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"eligible plan\" means any account, annuity, contract, or plan referred to in subparagraph (A).")
rule EligiblePlan408d3ViaIra(plan: Plan) strict {
    label en official "an individual retirement account or annuity";
    when plan_is_individual_retirement_account_or_annuity(plan);
    then eligible_plan_408d3(plan);
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "For purposes of clause (i), the term \"eligible plan\" means any account, annuity, contract, or plan referred to in subparagraph (A).")
rule EligiblePlan408d3ViaRetirementPlan(plan: Plan) strict {
    label en official "an eligible retirement plan described in section 402(c)(8)(B)(iii)-(vi)";
    when eligible_retirement_plan_408d3(plan);
    then eligible_plan_408d3(plan);
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "not later than the 60th day after the date on which the payment or distribution is received")
rule IraRolloverToPlanTimely(individual: Individual, d: Distribution, target: Plan, distributed_on: Date, transferred_on: Date, amount: Money, extra_days: Integer) strict {
    label en official "timely at exactly day 60 (plus frozen-deposit days under (F)); day 61 is untimely";
    when ira_rollover_to_plan_made(individual, d, target, transferred_on, amount)
        and eligible_plan_408d3(target)
        and ira_distribution(d, _, individual, _, distributed_on)
        and frozen_deposit_period(d, extra_days)
        and days_between(distributed_on, transferred_on) <= 60 + extra_days;
    then ira_rollover_to_plan_timely(individual, d, target);
}

pub relation ira_rollover_to_plan_excluded_amount(individual: Individual, d: Distribution, target: Plan, amount: Money) kind institutional {
    label en official "section 408(d)(3)(A)(ii)/(D): the amount excluded is the amount paid in, never more than the includible portion of the amount received";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the maximum amount which may be paid into such plan may not exceed the portion of the amount received which is includible in gross income (determined without regard to this paragraph)")
rule IraRolloverToPlanExcludedAmount(individual: Individual, d: Distribution, target: Plan, on: Date, paid: Money, includible: Money) strict {
    label en official "excluded = min(paid into the eligible plan, includible portion); a partial rollover excludes only what was paid in (subparagraph (D)(i))";
    when ira_rollover_to_plan_timely(individual, d, target)
        and ira_rollover_to_plan_made(individual, d, target, on, paid)
        and ira_distribution_includible_before_rollover(d, includible);
    then ira_rollover_to_plan_excluded_amount(individual, d, target, min(paid, includible));
}

pub relation ira_required_distribution_portion(d: Distribution, amount: Money) kind empirical {
    label en unofficial "the portion of the distribution required to be distributed under subsection (a)(6) or (b)(3), case-asserted";
}

pub relation ira_rollover_eligible_amount(d: Distribution, amount: Money) kind institutional {
    label en official "section 408(d)(3)(E): the part of a distribution that is NOT a required minimum distribution and so may be rolled over";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to any amount to the extent such amount is required to be distributed under subsection (a)(6) or (b)(3).")
rule IraRolloverEligibleAmount(d: Distribution, gross: Money, required: Money) strict {
    label en official "eligible amount = distribution minus the required-distribution portion";
    when ira_distribution(d, _, _, gross, _)
        and ira_required_distribution_portion(d, required)
        and gross >= required;
    then ira_rollover_eligible_amount(d, gross - required);
}

pub relation ira_distribution_from_simple_account(d: Distribution) kind empirical {
    label en unofficial "the distribution is out of a simple retirement account to which section 72(t)(6)(A) applies (within 2 years of first participation), case-asserted";
}

pub relation rollover_target_is_simple_retirement_account(d: Distribution, target: Plan) kind empirical {
    label en unofficial "the receiving account is another simple retirement account, case-asserted";
}

pub relation simple_account_rollover_restricted(individual: Individual, d: Distribution, target: Plan) kind institutional {
    label en official "section 408(d)(3)(G): the rollover exclusion does not apply to a 72(t)(6)(A) SIMPLE payment paid into anything other than another simple retirement account";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "this paragraph shall not apply unless such payment or distribution is paid into another simple retirement account")
rule SimpleAccountRolloverRestricted(individual: Individual, d: Distribution, target: Plan, on: Date, amount: Money) strict {
    label en official "restriction applies when the receiving account is not a simple retirement account";
    when ira_distribution_from_simple_account(d)
        and ira_rollover_to_plan_made(individual, d, target, on, amount)
        and not_known(rollover_target_is_simple_retirement_account(d, target));
    then simple_account_rollover_restricted(individual, d, target);
}

pub relation ira_partial_rollover_to_roth_type(individual: Individual, d: Distribution, rolled: Money) kind empirical {
    label en unofficial "a distribution from an individual retirement plan of which this amount was rolled over to a plan described in section 402(c)(8)(B)(iii)-(vi), case-asserted (section 408(d)(3)(H)(i))";
}

pub relation ira_aggregate_income_on_contract(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate income on the contract from all individual retirement plans of the individual, case-asserted (section 408(d)(3)(H)(ii)(II))";
}

pub relation ira_rollover_portion_treated_as_income(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "section 408(d)(3)(H)(ii)(II): the rolled-over portion is treated as from income on the contract to the extent of the aggregate income from all IRAs";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the portion of such distribution rolled over to an eligible retirement plan described in clause (i) shall be treated as from income on the contract (to the extent of the aggregate income on the contract from all individual retirement plans of the distributee)")
rule IraRolloverPortionTreatedAsIncome(individual: Individual, d: Distribution, y: TaxableYear, rolled: Money, income: Money) strict {
    label en official "treated as income = min(rolled amount, aggregate income); clause (II) only";
    when ira_partial_rollover_to_roth_type(individual, d, rolled)
        and ira_aggregate_income_on_contract(individual, y, income);
    then ira_rollover_portion_treated_as_income(individual, d, min(rolled, income));
}

// =====================================================================
// (d)(6) Transfer incident to divorce
// =====================================================================

pub relation ira_interest_transferred_to_spouse(ira: Plan, from_individual: Individual, to_spouse: Individual, on: Date) kind empirical {
    label en unofficial "the individual's interest in the IRA is transferred to his spouse or former spouse, case-asserted";
}

pub relation transfer_under_divorce_or_separation_instrument(ira: Plan, from_individual: Individual, to_spouse: Individual) kind empirical {
    label en unofficial "the transfer is made under a divorce or separation instrument described in section 121(d)(3)(C)(i), case-asserted";
}

pub relation ira_transfer_nontaxable_divorce(ira: Plan, from_individual: Individual, to_spouse: Individual) kind institutional {
    label en official "section 408(d)(6): the transfer is not a taxable transfer made by the transferor";
}

pub relation ira_treated_as_ira_of_spouse(ira: Plan, to_spouse: Individual) kind institutional {
    label en official "section 408(d)(6): at the time of the transfer the interest is treated as an individual retirement account of the spouse, not of the transferor";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "is not to be considered a taxable transfer made by such individual notwithstanding any other provision of this subtitle")
rule IraDivorceTransferNontaxable(ira: Plan, from_individual: Individual, to_spouse: Individual, on: Date) strict {
    label en official "transfer under a divorce or separation instrument is not taxable to the transferor";
    when ira_interest_transferred_to_spouse(ira, from_individual, to_spouse, on)
        and transfer_under_divorce_or_separation_instrument(ira, from_individual, to_spouse);
    then ira_transfer_nontaxable_divorce(ira, from_individual, to_spouse);
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "such interest at the time of the transfer is to be treated as an individual retirement account of such spouse, and not of such individual")
rule IraDivorceTransferOwnerChanges(ira: Plan, from_individual: Individual, to_spouse: Individual, on: Date) strict {
    label en official "ownership passes to the spouse for purposes of the section";
    when ira_interest_transferred_to_spouse(ira, from_individual, to_spouse, on)
        and transfer_under_divorce_or_separation_instrument(ira, from_individual, to_spouse);
    then ira_treated_as_ira_of_spouse(ira, to_spouse);
}

// =====================================================================
// (d)(7) SEP salary-reduction distributions; 402(h)/402(k) amounts
// =====================================================================

pub relation sep_salary_reduction_contribution_distributed(individual: Individual, d: Distribution) kind empirical {
    label en unofficial "the distribution or transfer from a simplified employee pension is of a contribution under a section 408(k)(6) salary reduction arrangement (or income allocable to it), case-asserted";
}

pub relation sep_k6a3_determination_made(individual: Individual, d: Distribution) kind empirical {
    label en unofficial "a determination has been made whether the section 408(k)(6)(A)(iii) requirements are met for this contribution, case-asserted";
}

pub relation sep_salary_reduction_distribution_no_rollover_treatment(individual: Individual, d: Distribution) kind institutional {
    label en official "section 408(d)(7)(A): paragraph (1) and section 72(t)(1) apply to a transfer or distribution of a salary reduction SEP contribution made before the (k)(6)(A)(iii) determination";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "paragraph (1) and section 72(t)(1) shall apply to the transfer or distribution from a simplified employee pension of any contribution under a salary reduction arrangement described in subsection (k)(6)")
rule SepSalaryReductionDistributionBeforeDetermination(individual: Individual, d: Distribution) strict {
    label en official "before the determination the ordinary inclusion and the early-distribution tax rules apply (no rollover or exception treatment)";
    when sep_salary_reduction_contribution_distributed(individual, d)
        and not_known(sep_k6a3_determination_made(individual, d));
    then sep_salary_reduction_distribution_no_rollover_treatment(individual, d);
}

pub relation amount_excluded_under_402h_or_402k(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount excludable or excluded from gross income under section 402(h) or 402(k), case-asserted";
}

pub relation amount_treated_as_219_deduction(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(7)(B): for paragraphs (4) and (5) and section 4973 an amount excluded under section 402(h) or 402(k) is treated as an amount allowed as a deduction under section 219";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "any amount excludable or excluded from gross income under section 402(h) or 402(k) shall be treated as an amount allowable or allowed as a deduction under section 219")
rule AmountTreatedAs219Deduction(individual: Individual, y: TaxableYear, amount: Money) strict {
    label en official "deemed deduction for (d)(4), (d)(5) and section 4973";
    when amount_excluded_under_402h_or_402k(individual, y, amount);
    then amount_treated_as_219_deduction(individual, y, amount);
}

// =====================================================================
// (d)(9) Distributions for health savings account funding
// =====================================================================

pub relation eligible_individual_223c(individual: Individual, on: Date) kind empirical {
    label en unofficial "the individual is an eligible individual within the meaning of section 223(c) on this date, case-asserted (section 223 is owned by `deductions`)";
}

pub relation hsa_annual_limitation_223b(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the annual limitation under section 223(b) for the type of high deductible health plan coverage at the time of the distribution, case-asserted (dependency on `deductions`)";
}

pub relation ira_distribution_direct_to_hsa(d: Distribution) kind empirical {
    label en unofficial "the distribution from an individual retirement plan (other than a section 408(k) or (p) plan) is contributed to the individual's health savings account in a direct trustee-to-trustee transfer, case-asserted";
}

pub relation qualified_hsa_funding_distribution(individual: Individual, d: Distribution) kind institutional {
    label en official "section 408(d)(9)(B): a distribution from an IRA (not a SEP or SIMPLE) contributed to the individual's HSA by direct trustee-to-trustee transfer";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the term \"qualified HSA funding distribution\" means a distribution from an individual retirement plan (other than a plan described in subsection (k) or (p)) of the employee to the extent that such distribution is contributed to the health savings account of the individual in a direct trustee-to-trustee transfer")
rule QualifiedHsaFundingDistribution(individual: Individual, d: Distribution, on: Date) strict {
    label en official "eligible individual plus direct transfer to the HSA";
    when ira_distribution(d, _, individual, _, on)
        and ira_distribution_direct_to_hsa(d)
        and eligible_individual_223c(individual, on);
    then qualified_hsa_funding_distribution(individual, d);
}

pub relation prior_hsa_funding_election_in_lifetime(individual: Individual) kind empirical {
    label en unofficial "the individual has already made an election under section 408(d)(9)(A) for a qualified HSA funding distribution during his lifetime, case-asserted";
}

pub relation earlier_hsa_funding_distribution_amount(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the earlier qualified HSA funding distribution for the year when the (C)(ii)(II) family-coverage election is made, case-asserted";
}

pub relation additional_hsa_funding_election_permitted(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "self-only coverage as of the first day of the earlier distribution's month and family coverage as of the first day of the later month within the same taxable year, case-asserted (section 408(d)(9)(C)(ii)(II))";
}

pub relation hsa_funding_election_permitted(individual: Individual, d: Distribution) kind institutional {
    label en official "section 408(d)(9)(C)(ii): one election in a lifetime, or the additional election when self-only coverage is followed by family coverage in the same year";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "an individual may make an election under subparagraph (A) only for one qualified HSA funding distribution during the lifetime of the individual")
rule HsaFundingElectionPermittedFirst(individual: Individual, d: Distribution) strict {
    label en official "the first (and only ordinary) election is permitted when none was made before";
    when qualified_hsa_funding_distribution(individual, d)
        and not_known(prior_hsa_funding_election_in_lifetime(individual));
    then hsa_funding_election_permitted(individual, d);
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the individual may elect to make an additional qualified HSA funding distribution during a subsequent month in such taxable year during which the individual has family coverage under a high deductible health plan")
rule HsaFundingElectionPermittedAdditional(individual: Individual, d: Distribution, y: TaxableYear) strict {
    label en official "the additional election after a self-only distribution followed by family coverage";
    when qualified_hsa_funding_distribution(individual, d)
        and additional_hsa_funding_election_permitted(individual, y);
    then hsa_funding_election_permitted(individual, d);
}

pub relation hsa_funding_exclusion_elected(individual: Individual, d: Distribution) kind institutional {
    label en official "the individual elected the section 408(d)(9)(A) exclusion for this distribution (irrevocable once made)";
}

pub relation hsa_funding_election_exercised(individual: Individual, d: Distribution, on: Date) kind empirical {
    label en unofficial "the individual elects the application of section 408(d)(9) for this taxable year, case-asserted";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "who elects the application of this paragraph for a taxable year, gross income of the individual for the taxable year does not include a qualified HSA funding distribution")
rule HsaFundingElectionPower(individual: Individual, d: Distribution, on: Date) strict {
    label en official "power of the eligible individual to elect the exclusion; a valid exercise is irrevocable";
    when hsa_funding_election_exercised(individual, d, on)
        and qualified_hsa_funding_distribution(individual, d);
    then power ElectHsaFundingExclusion {
        holder individual;
        over d;
        exercise hsa_funding_election_exercised(individual, d, on);
        valid_when hsa_funding_election_permitted(individual, d);
        effect hsa_funding_exclusion_elected(individual, d);
    };
}

pub relation hsa_funding_excluded_amount(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "section 408(d)(9)(A)/(C)(i): excluded to the extent otherwise includible, not more than the section 223(b) limitation less any earlier distribution";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "The amount excluded from gross income by subparagraph (A) shall not exceed the excess of")
rule HsaFundingExcludedAmount(individual: Individual, d: Distribution, y: TaxableYear, includible: Money, limit: Money, earlier: Money) strict {
    label en official "excluded = min(otherwise includible, limitation - earlier distribution); the earlier-distribution term is zero unless the (C)(ii)(II) case applies";
    when hsa_funding_exclusion_elected(individual, d)
        and ira_distribution_includible_before_rollover(d, includible)
        and hsa_annual_limitation_223b(individual, y, limit)
        and earlier_hsa_funding_distribution_amount(individual, y, earlier)
        and limit >= earlier;
    then hsa_funding_excluded_amount(individual, d, min(includible, limit - earlier));
}

pub relation hsa_funding_testing_period(d: Distribution, starts: Date, ends: Date) kind empirical {
    label en unofficial "the testing period: the month of the contribution to the HSA through the last day of the 12th month following it, case-asserted (section 408(d)(9)(D)(iii); computing a month-end from a date is TECH-GAPS G9)";
}

pub relation individual_not_eligible_on(individual: Individual, on: Date) kind empirical {
    label en unofficial "the individual is not an eligible individual (section 223(c)) on this date, case-asserted";
}

pub relation individual_ceased_eligibility_by_death_or_disability(individual: Individual) kind empirical {
    label en unofficial "the individual ceased to be an eligible individual by reason of death or becoming disabled within the meaning of section 72(m)(7), case-asserted";
}

pub relation hsa_funding_contributions_total(individual: Individual, d: Distribution, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of contributions to the HSA made under section 408(d)(9)(A), case-asserted";
}

pub relation hsa_testing_period_failure(individual: Individual, d: Distribution, on: Date) kind institutional {
    label en official "section 408(d)(9)(D)(i): the individual was not an eligible individual at some time during the testing period";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "If, at any time during the testing period, the individual is not an eligible individual")
rule HsaTestingPeriodFailure(individual: Individual, d: Distribution, starts: Date, ends: Date, on: Date) strict {
    label en official "ineligible on a date inside the period, unless the cause was death or disability (clause (ii))";
    when hsa_funding_testing_period(d, starts, ends)
        and individual_not_eligible_on(individual, on)
        and on >= starts and on <= ends
        and not_known(individual_ceased_eligibility_by_death_or_disability(individual));
    then hsa_testing_period_failure(individual, d, on);
}

pub relation hsa_funding_recapture_includible(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "section 408(d)(9)(D)(i)(I): the aggregate amount contributed is includible in gross income for the year of the first ineligible month";
}

pub relation hsa_funding_recapture_additional_tax(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "section 408(d)(9)(D)(i)(II): the tax for the year is increased by 10 percent of the amount so includible";
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "shall be includible in the gross income of the individual for the taxable year in which occurs the first month in the testing period for which such individual is not an eligible individual")
rule HsaRecaptureIncludible(individual: Individual, d: Distribution, on: Date, total: Money) strict {
    label en official "the whole aggregate contribution becomes includible";
    when hsa_testing_period_failure(individual, d, on)
        and hsa_funding_contributions_total(individual, d, total);
    then hsa_funding_recapture_includible(individual, d, total);
}

@source(IRC_S408_D, relation = formalizes, coverage = exact, quote = "the tax imposed by this chapter for any taxable year on the individual shall be increased by 10 percent of the amount which is so includible")
rule HsaRecaptureAdditionalTax(individual: Individual, d: Distribution, on: Date, total: Money) strict {
    label en official "10 percent of the includible amount, exact";
    when hsa_testing_period_failure(individual, d, on)
        and hsa_funding_contributions_total(individual, d, total);
    then hsa_funding_recapture_additional_tax(individual, d, total * 0.10);
}

pub relation ira_total_includible_if_all_distributed(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount that would have been includible if all amounts from all individual retirement plans were distributed, case-asserted (section 408(d)(9)(E))";
}

pub relation hsa_funding_aggregate_includible_ceiling(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(d)(9)(E): for the exclusion the aggregate amount distributed is treated as includible up to the amount that would be includible if everything were distributed";
}

@source(IRC_S408_D, relation = formalizes, coverage = partial, quote = "the aggregate amount distributed from an individual retirement plan shall be treated as includible in gross income to the extent that such amount does not exceed the aggregate amount which would have been so includible if all amounts from all individual retirement plans were distributed")
rule HsaFundingAggregateIncludibleCeiling(individual: Individual, y: TaxableYear, distributed: Money, total_if_all: Money) strict {
    label en official "treated as includible = min(aggregate distributed, includible-if-all-distributed); the proper-adjustments sentence is not modelled";
    when ira_aggregate_distributions_treated_as_one(individual, y, distributed)
        and ira_total_includible_if_all_distributed(individual, y, total_if_all);
    then hsa_funding_aggregate_includible_ceiling(individual, y, min(distributed, total_if_all));
}

// =====================================================================
// (g) Community property; (h) custodial accounts; (n) bank
// =====================================================================

pub relation ira_subject_to_community_property_law(ira: Plan, individual: Individual) kind empirical {
    label en unofficial "state community property law would treat the account as partly the spouse's, case-asserted";
}

pub relation ira_owner_for_section_408(ira: IndividualRetirementAccount, individual: Individual) kind institutional {
    label en official "section 408(g): the account is applied to the individual for whom it is established without regard to any community property laws";
}

@source(IRC_S408_G, relation = formalizes, coverage = exact, quote = "This section shall be applied without regard to any community property laws.")
rule IraOwnerWithoutCommunityProperty(ira: IndividualRetirementAccount, individual: Individual) strict {
    label en official "community property never splits ownership for section 408; holds with or without a community-property fact";
    when ira_established_for(ira, individual);
    then ira_owner_for_section_408(ira, individual);
}

pub relation bank_408n(p: Person) kind institutional {
    label en official "section 408(n): a bank, an insured credit union, or a state-supervised banking corporation";
}

pub relation bank_defined_in_581(p: Person) kind empirical {
    label en unofficial "the person is a bank as defined in section 581, case-asserted";
}

pub relation insured_credit_union(p: Person) kind empirical {
    label en unofficial "the person is an insured credit union within the meaning of section 101(6) or (7) of the Federal Credit Union Act, case-asserted";
}

pub relation state_supervised_banking_corporation(p: Person) kind empirical {
    label en unofficial "the person is a corporation subject under the laws of its State of incorporation to supervision and examination by the State banking authority, case-asserted";
}

@source(IRC_S408_N, relation = formalizes, coverage = exact, quote = "any bank (as defined in section 581)")
rule Bank408nSection581(p: Person) strict {
    label en official "limb (1)";
    when bank_defined_in_581(p);
    then bank_408n(p);
}

@source(IRC_S408_N, relation = formalizes, coverage = exact, quote = "an insured credit union (within the meaning of paragraph (6) or (7) of section 101 of the Federal Credit Union Act)")
rule Bank408nCreditUnion(p: Person) strict {
    label en official "limb (2)";
    when insured_credit_union(p);
    then bank_408n(p);
}

@source(IRC_S408_N, relation = formalizes, coverage = exact, quote = "is subject to supervision and examination by the Commissioner of Banking or other officer of such State")
rule Bank408nStateSupervised(p: Person) strict {
    label en official "limb (3)";
    when state_supervised_banking_corporation(p);
    then bank_408n(p);
}

pub entity CustodialAccount : Plan {
    label en unofficial "a custodial account that would be an individual retirement account but for not being a trust (section 408(h))";
}

pub relation custodial_account_would_be_ira_but_for_trust_form(c: CustodialAccount) kind empirical {
    label en unofficial "except for not being a trust the account would constitute an individual retirement account described in subsection (a), case-asserted";
}

pub relation custodial_assets_held_by(c: CustodialAccount, holder: Person) kind empirical {
    label en unofficial "the assets of the custodial account are held by this person, case-asserted";
}

external judgment relation custodian_demonstrates_consistent_administration(c: CustodialAccount) {
    authority Secretary;
    label en official "section 408(h): another person demonstrates, to the satisfaction of the Secretary, that the manner of administering the account will be consistent with the requirements of the section — the Secretary's satisfaction is not computed here";
}

pub relation custodial_account_treated_as_trust(c: CustodialAccount) kind institutional {
    label en official "section 408(h): the custodial account is treated as a trust";
}

@source(IRC_S408_H, relation = formalizes, coverage = exact, quote = "a custodial account shall be treated as a trust if the assets of such account are held by a bank (as defined in subsection (n))")
rule CustodialAccountTreatedAsTrustBank(c: CustodialAccount, holder: Person) strict {
    label en official "assets held by a bank within (n)";
    when custodial_assets_held_by(c, holder)
        and bank_408n(holder)
        and custodial_account_would_be_ira_but_for_trust_form(c);
    then custodial_account_treated_as_trust(c);
}

@source(IRC_S408_H, relation = formalizes, coverage = exact, quote = "or another person who demonstrates, to the satisfaction of the Secretary, that the manner in which he will administer the account will be consistent with the requirements of this section")
rule CustodialAccountTreatedAsTrustOtherPerson(c: CustodialAccount, holder: Person) strict {
    label en official "assets held by another person whose administration the Secretary is satisfied with";
    when custodial_assets_held_by(c, holder)
        and custodian_demonstrates_consistent_administration(c)
        and custodial_account_would_be_ira_but_for_trust_form(c);
    then custodial_account_treated_as_trust(c);
}

// =====================================================================
// (i) Reports by trustee and issuer; (j) SEP limit increase
// =====================================================================

pub relation trustee_or_issuer_of(p: Person, plan: Plan) kind empirical {
    label en unofficial "this person is the trustee of the individual retirement account or the issuer of the contract or annuity, case-asserted";
}

pub relation account_holder_for(individual: Individual, plan: Plan) kind empirical {
    label en unofficial "the individual for whom the account, contract or annuity is or is to be maintained, case-asserted";
}

pub relation ira_reports_furnished_to_individual(plan: Plan, individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the reports required by section 408(i) were furnished to the individual, case-asserted";
}

pub relation ira_year_end(y: TaxableYear, end: Date) kind empirical {
    label en unofficial "the last day of the calendar year to which the reports relate, case-asserted (a calendar taxable year)";
}

@source(IRC_S408_I, relation = formalizes, coverage = exact, quote = "not later than January 31 of the calendar year following the calendar year to which such reports relate")
rule TrusteeReportDuty408i(plan: Plan, trustee: Person, individual: Individual, y: TaxableYear, year_end: Date) strict {
    label en official "the trustee or issuer must furnish the reports to the individual by January 31 of the following year (31 days after December 31)";
    when trustee_or_issuer_of(trustee, plan)
        and account_holder_for(individual, plan)
        and ira_year_end(y, year_end);
    then duty TrusteeReportsDuty {
        bearer trustee;
        beneficiary individual;
        goal achievement {
            condition ira_reports_furnished_to_individual(plan, individual, y);
            window [-infinity, add_calendar_period(year_end, 31 calendar_day)];
        }
    };
}

pub relation simple_account_statement_furnished(plan: Plan, individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the account-balance and activity statement for a simple retirement account was furnished to the individual, case-asserted (section 408(i) last sentence)";
}

@source(IRC_S408_I, relation = formalizes, coverage = exact, quote = "there shall be furnished, within 31 days after each calendar year, to the individual on whose behalf the account is maintained a statement")
rule SimpleAccountStatementDuty408i(plan: SimpleRetirementAccount, trustee: Person, individual: Individual, y: TaxableYear, year_end: Date) strict {
    label en official "in addition to the single report, a statement within 31 days after the calendar year";
    when trustee_or_issuer_of(trustee, plan)
        and account_holder_for(individual, plan)
        and ira_year_end(y, year_end);
    then duty SimpleAccountStatementDutyPosition {
        bearer trustee;
        beneficiary individual;
        goal achievement {
            condition simple_account_statement_furnished(plan, individual, y);
            window [-infinity, add_calendar_period(year_end, 31 calendar_day)];
        }
    };
}

pub relation sep_ira_contribution_ceiling(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(j): for a simplified employee pension the section 408(a)(1)/(b)(2) amount is increased by the section 415(c)(1)(A) limitation";
}

@source(IRC_S408_J, relation = formalizes, coverage = exact, quote = "subsections (a)(1) and (b)(2) of this section shall be applied by increasing the amounts contained therein by the amount of the limitation in effect under section 415(c)(1)(A)")
rule SepIraContributionCeiling(individual: Individual, y: TaxableYear, base: Money) strict {
    label en official "ceiling = section 219(b)(1)(A) amount + section 415(c)(1)(A) limitation";
    when section219_deduction_amount(individual, y, base);
    then sep_ira_contribution_ceiling(individual, y, base + SECTION415C_DOLLAR_LIMIT);
}
