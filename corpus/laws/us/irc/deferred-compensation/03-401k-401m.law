// Section 401(k)/(m) — cash or deferred arrangements and matching/employee
// contributions. Stage 1 (IRC-09), DECISION-0379. Priority: 401(k)(3) ADP
// test (the 1.25x / 2x-and-2-points formulas as exact computations over
// case-asserted group ADPs — see method note below). Also modelled to the
// extent PLAN family 8 requires: (k)(1)/(2) eligibility/distribution
// restrictions (brief), (k)(12)/(13) safe harbor (classification only,
// TECH_GAP for the notice/matching-formula machinery), (k)(14) hardship
// distributions (brief), 401(m) ACP test (mirrors the ADP arithmetic).
// Automatic enrollment (k)(13)(C)/section 414(w) is cross-referenced from
// `12-414-definitions.law`.


// =====================================================================
// (k)(3)(A) Actual deferral percentage ("ADP") test
// =====================================================================
// Method: the ADP for a group is the AVERAGE, over each employee in the
// group, of the ratio (that employee's elective employer contributions /
// that employee's compensation) — an average of per-employee RATIOS, not a
// sum of amounts. Averaging over the section 414(q) HCE/NHCE classification
// groups is a case-asserted aggregate fact here (as in `10-410-
// participation.law`'s ratio-percentage test), because summing/averaging
// over a DERIVED classification predicate is this runtime's documented
// aggregate-over-derived-predicate limitation (section 111). The 1.25x and
// 2x-and-2-points COMPARISON — the operative legal test and the part the
// task instruction calls an "exact computation with intermediate values" —
// is fully executable arithmetic below.

use self::{
    ContributionKind,
    Distribution,
    IRC_S401_K,
    IRC_S401_M,
    Person,
    Plan,
    TaxableYear,
    attained_age,
    plan_sponsor,
};

pub relation adp_hce(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the actual deferral percentage for the group of eligible highly compensated employees for the plan year, case-asserted (average of each such employee's employer-contribution/compensation ratio, section 401(k)(3)(B))";
}

pub relation adp_nhce_preceding_year(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the actual deferral percentage for all other eligible employees for the PRECEDING plan year (the default comparison year under (k)(3)(A)), case-asserted";
}

pub relation adp_125x_test(plan: Plan, y: TaxableYear, hce: Decimal, nhce: Decimal) kind institutional {
    label en official "section 401(k)(3)(A)(ii)(I): HCE ADP is not more than NHCE ADP multiplied by 1.25";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The actual deferral percentage for the group of eligible highly compensated employees is not more than the actual deferral percentage of all other eligible employees multiplied by 1.25.")
rule Adp125xTest(plan: Plan, y: TaxableYear, hce: Decimal, nhce: Decimal) strict {
    label en official "1.25x test: exact boundary at hce == nhce * 1.25 passes";
    when adp_hce(plan, y, hce) and adp_nhce_preceding_year(plan, y, nhce)
        and hce <= round(nhce * 1.25, 4, "HALF_UP");
    then adp_125x_test(plan, y, hce, nhce);
}

pub relation adp_2x_test(plan: Plan, y: TaxableYear, hce: Decimal, nhce: Decimal) kind institutional {
    label en official "section 401(k)(3)(A)(ii)(II): HCE ADP exceeds NHCE ADP by not more than 2 percentage points, and is not more than NHCE ADP multiplied by 2";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The excess of the actual deferral percentage for the group of eligible highly compensated employees over that of all other eligible employees is not more than 2 percentage points, and the actual deferral percentage for the group of eligible highly compensated employees is not more than the actual deferral percentage of all other eligible employees multiplied by 2.")
rule Adp2xTest(plan: Plan, y: TaxableYear, hce: Decimal, nhce: Decimal) strict {
    label en official "2x-and-2-points test: exact boundary at hce == nhce + 2 points AND hce == nhce * 2 both pass";
    when adp_hce(plan, y, hce) and adp_nhce_preceding_year(plan, y, nhce)
        and hce - nhce <= 2.0
        and hce <= round(nhce * 2.0, 4, "HALF_UP");
    then adp_2x_test(plan, y, hce, nhce);
}

pub relation adp_test_passed(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(3)(A)(ii): the ADP test is passed by either the 1.25x test or the 2x-and-2-points test";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "for the plan year bears a relationship to the actual deferral percentage for all other eligible employees for the preceding plan year which meets either of the following tests")
rule AdpTestPassed(plan: Plan, y: TaxableYear) strict {
    label en official "the plan passes when either alternative test is met";
    when adp_125x_test(plan, y, _, _) or adp_2x_test(plan, y, _, _);
    then adp_test_passed(plan, y);
}
// First-plan-year 3-percent default ((3)(E)) and the "current year testing"
// election are NOT modelled (TECH_GAP, stage 2): `adp_nhce_preceding_year`
// is always read as the preceding year per the statutory default.

// =====================================================================
// 401(m) — Actual contribution percentage ("ACP") test (mirrors ADP)
// =====================================================================

pub relation acp_hce(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the actual contribution percentage for eligible highly compensated employees, case-asserted";
}

pub relation acp_nhce_preceding_year(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the actual contribution percentage for all other eligible employees for the preceding plan year, case-asserted";
}

pub relation acp_test_passed(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(2): the ACP test, using the same 1.25x / 2x-and-2-points formulas as the ADP test";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "the contribution percentage for eligible highly compensated employees for such plan year does not exceed the greater of—")
rule AcpTestPassed(plan: Plan, y: TaxableYear, hce: Decimal, nhce: Decimal) strict {
    label en official "ACP test passed under either alternative formula, mirroring section 401(k)(3)(A)(ii)";
    when acp_hce(plan, y, hce) and acp_nhce_preceding_year(plan, y, nhce)
        and (hce <= round(nhce * 1.25, 4, "HALF_UP")
             or (hce - nhce <= 2.0 and hce <= round(nhce * 2.0, 4, "HALF_UP")));
    then acp_test_passed(plan, y);
}

// =====================================================================
// (k)(1)/(2) Eligibility and distribution restrictions — brief
// =====================================================================

pub relation coda_maintained(plan: Plan) kind empirical {
    label en unofficial "the plan includes a qualified cash or deferred arrangement (case-asserted)";
}

pub relation distributable_event_k2(d: Distribution) kind empirical {
    label en unofficial "one of the section 401(k)(2)(B)(i) distributable events (severance, death, disability, age 59 1/2 for profit-sharing/stock-bonus plans, qualified reservist distribution, hardship) has occurred, case-asserted";
}

pub relation coda_amount_distributable(d: Distribution) kind institutional {
    label en official "section 401(k)(2)(B): amounts attributable to elective contributions may be distributed only on a listed distributable event";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "may not be distributable to participants or other beneficiaries earlier than—")
rule CodaAmountDistributable(d: Distribution, plan: Plan) strict {
    label en official "distribution of elective-contribution amounts is proper only on a distributable event";
    when coda_maintained(plan) and distributable_event_k2(d);
    then coda_amount_distributable(d);
}

// =====================================================================
// (k)(12)/(13) Safe harbor — classification (brief; TECH_GAP for notice
// and matching-formula machinery)
// =====================================================================
pub relation safe_harbor_notice_and_matching_requirements_met(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan meets the section 401(k)(12) (traditional) or (k)(13) (qualified automatic contribution arrangement) notice and matching/nonelective contribution requirements, case-asserted (the specific matching formula and notice-timing tests of (12)(B)/(C) and (13)(C)/(D) are NOT reformalized in this stage — TECH_GAP)";
}

pub relation adp_test_deemed_satisfied_safe_harbor(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)/(13): a safe harbor plan is treated as satisfying the ADP test of (k)(3)(A)(ii) without actually running it";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement shall be treated as meeting the requirements of paragraph (3)(A)(ii) if such arrangement—")
rule SafeHarborDeemedAdp(plan: Plan, y: TaxableYear) strict {
    label en official "safe harbor status substitutes for running the ADP percentage test";
    when safe_harbor_notice_and_matching_requirements_met(plan, y);
    then adp_test_deemed_satisfied_safe_harbor(plan, y);
}

// =====================================================================
// (k)(14) Hardship distributions — brief
// =====================================================================
pub relation hardship_of_employee(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the employee has incurred a hardship recognized under the plan's hardship-distribution standard, case-asserted (the substantive hardship standard is an EVALUATIVE determination the regulations define, not reformalized here — DECISION-0194)";
}

pub relation hardship_distribution_permitted(employee: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 401(k)(2)(B)(i)(IV)/(k)(14): a hardship distribution of elective-contribution amounts is permitted";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "subject to the provisions of paragraph (14), upon hardship of the employee")
rule HardshipDistributionPermitted(employee: Person, plan: Plan, on: Date) strict {
    label en official "a recognized hardship permits the distribution";
    when hardship_of_employee(employee, plan, on);
    then hardship_distribution_permitted(employee, plan, on);
}

// =====================================================================
// STAGE 2 (25.09.2026): (k)(12)(B)/(13)(D)(i) safe harbor matching and
// nonelective FORMULAS as exact per-employee arithmetic — this replaces
// the black-box `safe_harbor_notice_and_matching_requirements_met` case
// fact above with the statute's own dollar formula for the specific
// dollar tests the task instruction calls out (100%/50%, 3% nonelective).
// The plan-wide "for every eligible NHCE" quantification stays a
// case-asserted aggregate (`safe_harbor_notice_and_matching_requirements_
// met`, unchanged above): summing per-employee compliance facts (each
// itself DERIVED/institutional) over the whole workforce is the same
// aggregate-over-derived-predicate limitation as G64/section 111 — this
// stage computes the formula and the per-employee compliance test exactly,
// not the workforce-wide universal quantifier.
// =====================================================================

pub relation elective_contribution_amount(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "this employee's elective contributions to the arrangement for the plan year, case-asserted";
}

pub relation employee_compensation_401k(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "this employee's compensation for the plan year within the meaning of section 414(s), case-asserted";
}

pub relation basic_matching_formula_amount(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(k)(12)(B)(i): the basic safe harbor matching formula — 100 percent of elective contributions up to 3 percent of compensation, plus 50 percent of elective contributions from 3 to 5 percent of compensation";
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "100 percent of the elective contributions of the employee to the extent such elective contributions do not exceed 3 percent of the employee's compensation")
rule BasicMatchingFormulaAmount(employee: Person, plan: Plan, y: TaxableYear, ec: Money, comp: Money) strict {
    label en official "match = 100% of elective contributions up to 3% of comp, plus 50% of the portion from 3% to 5% of comp";
    when elective_contribution_amount(employee, plan, y, ec)
        and employee_compensation_401k(employee, plan, y, comp);
    then basic_matching_formula_amount(employee, plan, y,
        min(ec, round(comp * 0.03, 2, "HALF_UP"))
        + round(max(0 USD, min(ec, round(comp * 0.05, 2, "HALF_UP")) - round(comp * 0.03, 2, "HALF_UP")) * 0.50, 2, "HALF_UP"));
}

pub relation aca_matching_formula_amount(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(k)(13)(D)(i)(I): the qualified automatic contribution arrangement matching formula — 100 percent of elective contributions up to 1 percent of compensation, plus 50 percent of elective contributions from 1 to 6 percent of compensation";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "100 percent of the elective contributions of the employee to the extent that such contributions do not exceed 1 percent of compensation plus 50 percent of so much of such contributions as exceed 1 percent but do not exceed 6 percent of compensation")
rule AcaMatchingFormulaAmount(employee: Person, plan: Plan, y: TaxableYear, ec: Money, comp: Money) strict {
    label en official "match = 100% of elective contributions up to 1% of comp, plus 50% of the portion from 1% to 6% of comp";
    when elective_contribution_amount(employee, plan, y, ec)
        and employee_compensation_401k(employee, plan, y, comp);
    then aca_matching_formula_amount(employee, plan, y,
        min(ec, round(comp * 0.01, 2, "HALF_UP"))
        + round(max(0 USD, min(ec, round(comp * 0.06, 2, "HALF_UP")) - round(comp * 0.01, 2, "HALF_UP")) * 0.50, 2, "HALF_UP"));
}

pub relation nonelective_safe_harbor_amount(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(k)(12)(C)/(13)(D)(i)(II): the 3-percent nonelective safe harbor contribution";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in an amount equal to at least 3 percent of the employee's compensation")
rule NonelectiveSafeHarborAmount(employee: Person, plan: Plan, y: TaxableYear, comp: Money) strict {
    label en official "the nonelective safe harbor is 3 percent of compensation, without regard to whether the employee makes an elective contribution";
    when employee_compensation_401k(employee, plan, y, comp);
    then nonelective_safe_harbor_amount(employee, plan, y, round(comp * 0.03, 2, "HALF_UP"));
}

pub relation employer_contribution_amount(employee: Person, plan: Plan, y: TaxableYear, kind: ContributionKind, amount: Money) kind empirical {
    label en unofficial "the actual amount contributed by the employer on behalf of this employee for this plan year, by kind, case-asserted";
}

pub relation basic_matching_formula_satisfied(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "the plan's actual matching contribution to this employee meets or exceeds the section 401(k)(12)(B) formula amount";
}

@source(IRC_S401_K, relation = formalizes, coverage = contextual, quote = "The requirements of this subparagraph are met if, under the arrangement, the employer makes matching contributions on behalf of each employee who is not a highly compensated employee in an amount equal to")
rule BasicMatchingFormulaSatisfied(employee: Person, plan: Plan, y: TaxableYear, actual: Money, required: Money) strict {
    label en official "per-employee compliance test: actual matching contribution at least the formula amount";
    when employer_contribution_amount(employee, plan, y, EmployerMatching, actual)
        and basic_matching_formula_amount(employee, plan, y, required)
        and actual >= required;
    then basic_matching_formula_satisfied(employee, plan, y);
}

// =====================================================================
// STAGE 2: (k)(8) Excess contributions — exact excess computation and the
// corrective-distribution deadline as a duty.
// =====================================================================

pub relation hce_contributions_paid_over(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of employer contributions actually paid over to the trust on behalf of highly compensated employees for the plan year, case-asserted";
}

pub relation max_permitted_under_adp(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the maximum amount of HCE contributions permitted under the section 401(k)(3)(A)(ii) limitations, case-asserted (the (B)(ii) leveling-down-by-highest-percentage computation that DERIVES this ceiling from individual ADPs is not reformalized — TECH_GAP, aggregate-over-derived-predicate class, see TECH-GAPS.md G64)";
}

pub relation excess_contributions_amount(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(k)(8)(B): excess contributions = HCE contributions actually paid over minus the maximum amount permitted under the ADP test";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the aggregate amount of employer contributions actually paid over to the trust on behalf of highly compensated employees for such plan year")
rule ExcessContributionsAmount(plan: Plan, y: TaxableYear, hce_paid: Money, max_permitted: Money) strict {
    label en official "excess = HCE contributions paid over minus the ADP-test ceiling, when positive";
    when hce_contributions_paid_over(plan, y, hce_paid)
        and max_permitted_under_adp(plan, y, max_permitted)
        and hce_paid > max_permitted;
    then excess_contributions_amount(plan, y, hce_paid - max_permitted);
}

pub relation plan_year_ends(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the last day of the plan year, case-asserted";
}

pub relation excess_contributions_distributed(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the excess contributions for the plan year (and income allocable through the end of the year) were distributed (or treated as distributed and recontributed per (A)(ii)), case-asserted";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "before the close of the following plan year")
pub rule ExcessContributionCorrectiveDistributionDuty defeasible {
    label en official "section 401(k)(8)(A): the arrangement is not disqualified for an ADP-test failure if the excess contributions are distributed before the close of the following plan year";
    for plan: Plan;
    for y: TaxableYear;
    for amount: Money;
    for end: Date;
    for employer: Person;
    when excess_contributions_amount(plan, y, amount)
        and plan_year_ends(plan, y, end)
        and plan_sponsor(plan, employer);
    then duty ExcessContributionCorrectiveDistributionDutyPosition {
        bearer employer;
        beneficiary employer;
        goal achievement {
            condition excess_contributions_distributed(plan, y);
            window [-infinity, add_calendar_period(end, 12 calendar_month)];
        }
    };
}
// (8)(C) method-of-distribution (HCEs ranked by contribution amount) and
// (8)(D) no §72(t) tax on the corrective distribution are NOT modelled
// (TECH_GAP, stage 2 — narrow follow-up, no new compiler class).

// =====================================================================
// STAGE 2: (k)(15) Long-term, part-time employees — the age-21 gate on
// the 500-hour/2-consecutive-12-month-period eligibility rule of
// (2)(D)(ii), and the nondiscrimination/top-heavy carve-out.
// =====================================================================

pub relation ltpt_eligible_500hr_rule(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is eligible to participate in the arrangement solely by reason of section 401(k)(2)(D)(ii) (the 500-hours-per-year/2-consecutive-12-month-period rule), case-asserted";
}

pub relation ltpt_age21_requirement_met(employee: Person, plan: Plan, on: Date) kind institutional {
    label en official "section 401(k)(15)(A): the age-21 requirement of section 410(a)(1)(A)(i) is met by the close of the last of the 12-month periods, gating the (2)(D)(ii) rule";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "Paragraph (2)(D)(ii) shall not apply to an employee unless the employee has met the requirement of section 410(a)(1)(A)(i) by the close of the last of the 12-month periods described in such paragraph.")
rule Ltpt401k15AAgeRequirementMet(employee: Person, plan: Plan, on: Date, age: Integer) strict {
    label en official "the long-term part-time 500-hour rule applies only once age 21 is attained";
    when ltpt_eligible_500hr_rule(employee, plan)
        and attained_age(employee, on, age)
        and age >= 21;
    then ltpt_age21_requirement_met(employee, plan, on);
}

pub relation ltpt_only_participants_present(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan has one or more participants eligible to participate solely by reason of section 401(k)(2)(D)(ii) (or that paragraph and ERISA section 202(c)(1)(B)), case-asserted";
}

pub relation ltpt_matching_or_nonelective_not_required(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(15)(B)(i)(I): the employer is not required to make nonelective or matching contributions on behalf of LTPT-500hr-only participants, even if made for other eligible employees";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "an employer shall not be required to make nonelective or matching contributions on behalf of such employees even if such contributions are made on behalf of other employees eligible to participate in the arrangement")
rule LtptMatchingOrNonelectiveNotRequired(plan: Plan, y: TaxableYear) strict {
    label en official "no mandatory match/nonelective for LTPT-500hr-only participants";
    when ltpt_only_participants_present(plan, y);
    then ltpt_matching_or_nonelective_not_required(plan, y);
}

pub relation ltpt_nondiscrimination_exclusion_elected(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer has elected to exclude LTPT-500hr-only participants from subsection (a)(4), paragraphs (3), (12), (13) of this subsection, paragraphs (2), (11), (12) of subsection (m), and section 410(b), case-asserted (the (B)(i)(II) election)";
}

pub relation ltpt_nondiscrimination_and_coverage_excluded(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(15)(B)(i)(II): on election, LTPT-500hr-only participants are excluded from the listed nondiscrimination/coverage tests";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "an employer may elect to exclude such employees from the application of subsection (a)(4), paragraphs (3), (12), and (13), paragraphs (2), (11), and (12) of subsection (m), and section 410(b).")
rule LtptNondiscriminationAndCoverageExcluded(plan: Plan, y: TaxableYear) strict {
    label en official "the (B)(i)(II) election removes LTPT-500hr-only participants from the listed tests";
    when ltpt_only_participants_present(plan, y)
        and ltpt_nondiscrimination_exclusion_elected(plan, y);
    then ltpt_nondiscrimination_and_coverage_excluded(plan, y);
}

pub relation ltpt_top_heavy_exclusion_elected(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer has elected to exclude LTPT-500hr-only participants from section 416(b)/(c) vesting and benefit requirements, case-asserted (the (B)(ii) election)";
}

pub relation ltpt_top_heavy_excluded(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(15)(B)(ii): on election, LTPT-500hr-only participants are excluded from section 416(b)/(c)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "An employer may elect to exclude all employees who are eligible to participate in a plan maintained by the employer solely by reason of paragraph (2)(D)(ii) from the application of the vesting and benefit requirements under subsections (b) and (c) of section 416.")
rule LtptTopHeavyExcluded(plan: Plan, y: TaxableYear) strict {
    label en official "the (B)(ii) election removes LTPT-500hr-only participants from section 416(b)/(c)";
    when ltpt_only_participants_present(plan, y)
        and ltpt_top_heavy_exclusion_elected(plan, y);
    then ltpt_top_heavy_excluded(plan, y);
}
// (15)(B)(iii) 500-hours-as-a-year-of-service vesting substitution,
// (15)(B)(iv) the full-time-conversion sunset, (15)(C) collectively-
// bargained exception and (15)(D) special timing/12-month-period rules are
// NOT modelled (TECH_GAP, stage 2).
