// Section 430(i) and 430(m) residuals — STAGE 3b (deferred-compensation,
// TECH_GAP reduction, 26.09.2026). Modules 18 and 30 carry the at-risk status
// test (with the 2008-2010 percentages), the loading factor and the at-risk
// target normal cost, and the newspaper election gates. Left as TECH_GAP and
// modelled here: (i)(1) the at-risk funding target and its additional
// actuarial assumptions, (i)(3) the minimum amount, (i)(4)(C) the 2006 early
// retirement carve-out for automobile manufacturers, (i)(5) the transition
// between applicable funding targets and target normal costs (table T2 of the
// model: 20, 40, 60, 80 percent), and (m)(4)-(6): the newspaper interest and
// yield-curve basis, the reset of shortfall amortization bases, the
// disapplication of the section 430(c)(2)(D) election, and the definitions of
// community newspaper plan, newspaper and control.
//
// Method. Present values and funding shortfalls are case inputs (actuarial
// computations of other rules); what the text fixes is exact: 700 and 4
// percent, the minimum, the transition interpolation (`ordinary + pct x
// (at-risk - ordinary)`, cents HALF_UP, JUDGMENT CALL), the percentages, the
// dates December 20, 2019 and December 31, 2018, and the counts (fewer than 5
// years, more than 5 States).

use self::{
    DefinedBenefitPlan,
    IRC_S430_I,
    IRC_S430_M,
    Person,
    TaxableYear,
    at_risk_2_of_4_preceding_years_430,
    at_risk_loading_factor_430,
    at_risk_target_normal_cost_430,
    funding_shortfall_430,
    funding_target,
    in_at_risk_status_430,
    newspaper_election_in_effect_430m,
    target_normal_cost,
};

pub enum AtRiskAmountKind430i5 {
    FundingTargetAmount;
    TargetNormalCostAmount;
}

// =====================================================================
// (i)(1) Funding target of an at-risk plan
// =====================================================================

pub relation at_risk_retirement_assumption_applied_430i1Bi(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "employees not otherwise assumed to retire but eligible to elect benefits during the plan year and the 10 succeeding plan years are assumed to retire at the earliest retirement date under the plan, but not before the end of the plan year, case-asserted (clause (i))";
}

pub relation at_risk_election_assumption_applied_430i1Bii(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "all employees are assumed to elect the retirement benefit at the assumed retirement age that results in the highest present value of benefits, case-asserted (clause (ii))";
}

pub relation additional_at_risk_assumptions_applied_430i1B(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(i)(1)(B): the additional actuarial assumptions of clauses (i) and (ii) are applied";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "The actuarial assumptions described in this subparagraph are as follows")
rule AdditionalAtRiskAssumptionsApplied430i1B(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "both clauses";
    when at_risk_retirement_assumption_applied_430i1Bi(plan, y) and at_risk_election_assumption_applied_430i1Bii(plan, y);
    then additional_at_risk_assumptions_applied_430i1B(plan, y);
}

pub relation at_risk_pv_of_accrued_benefits_430i1Ai(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of all benefits accrued or earned as of the beginning of the plan year determined with the additional assumptions, case-asserted (clause (A)(i))";
}

pub relation at_risk_funding_target_430i1A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(i)(1)(A): the present value with the additional assumptions plus, for a plan at risk in at least 2 of the 4 preceding plan years, the loading factor";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the present value of all benefits accrued or earned under the plan as of the beginning of the plan year, as determined by using the additional actuarial assumptions described in subparagraph (B)")
rule AtRiskFundingTargetWithoutLoading430i1A(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money) defeasible {
    label en official "present value only, when the plan has not been at risk in 2 of the 4 preceding years";
    when in_at_risk_status_430(plan, y)
        and additional_at_risk_assumptions_applied_430i1B(plan, y)
        and at_risk_pv_of_accrued_benefits_430i1Ai(plan, y, pv)
        and not_known(at_risk_2_of_4_preceding_years_430(plan, y));
    then at_risk_funding_target_430i1A(plan, y, pv);
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "in the case of a plan which also has been in at-risk status for at least 2 of the 4 preceding plan years, a loading factor determined under subparagraph (C)")
rule AtRiskFundingTargetWithLoading430i1A(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money, loading: Money) defeasible {
    label en official "present value plus the loading factor of module 18";
    when in_at_risk_status_430(plan, y)
        and additional_at_risk_assumptions_applied_430i1B(plan, y)
        and at_risk_pv_of_accrued_benefits_430i1Ai(plan, y, pv)
        and at_risk_2_of_4_preceding_years_430(plan, y)
        and at_risk_loading_factor_430(plan, y, loading);
    then at_risk_funding_target_430i1A(plan, y, pv + loading);
}

// =====================================================================
// (i)(3) Minimum amount
// =====================================================================

pub relation applicable_at_risk_funding_target_430i3A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(i)(3)(A): the at-risk funding target is not less than the funding target determined without regard to the subsection";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the at-risk funding target be less than the funding target, as determined without regard to this subsection")
rule ApplicableAtRiskFundingTarget430i3A(plan: DefinedBenefitPlan, y: TaxableYear, at_risk: Money, ordinary: Money) defeasible {
    label en official "max(at-risk, ordinary)";
    when at_risk_funding_target_430i1A(plan, y, at_risk) and funding_target(plan, y, ordinary);
    then applicable_at_risk_funding_target_430i3A(plan, y, max(at_risk, ordinary));
}

pub relation applicable_at_risk_target_normal_cost_430i3B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(i)(3)(B): the at-risk target normal cost is not less than the target normal cost determined without regard to the subsection";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the at-risk target normal cost be less than the target normal cost, as determined without regard to this subsection")
rule ApplicableAtRiskTargetNormalCost430i3B(plan: DefinedBenefitPlan, y: TaxableYear, at_risk: Money, ordinary: Money) defeasible {
    label en official "max(at-risk, ordinary)";
    when at_risk_target_normal_cost_430(plan, y, at_risk) and target_normal_cost(plan, y, ordinary);
    then applicable_at_risk_target_normal_cost_430i3B(plan, y, max(at_risk, ordinary));
}

// =====================================================================
// (i)(4)(C) Employees offered early retirement in 2006
// =====================================================================

pub relation manufacturer_of_automobiles_430i4Cii1(employer: Person) kind empirical {
    label en unofficial "the employer is a manufacturer of automobiles, case-asserted";
}

pub relation supplier_parts_left_controlled_group_in_1999_430i4CiiII(employer: Person) kind empirical {
    label en unofficial "the employer manufactures automobile parts supplied directly to a manufacturer of automobiles and, after a transaction or series of transactions ending in 1999, ceased to be a member of a controlled group that included that manufacturer, case-asserted";
}

pub relation specified_automobile_manufacturer_430i4Cii(employer: Person) kind institutional {
    label en official "section 430(i)(4)(C)(ii): a manufacturer of automobiles, or a former controlled group member parts supplier of one";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "any manufacturer of automobiles")
rule SpecifiedAutomobileManufacturer430i4CiiI(employer: Person) strict {
    label en official "subclause (I)";
    when manufacturer_of_automobiles_430i4Cii1(employer);
    then specified_automobile_manufacturer_430i4Cii(employer);
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "any manufacturer of automobile parts which supplies such parts directly to a manufacturer of automobiles")
rule SpecifiedAutomobileManufacturer430i4CiiII(employer: Person) strict {
    label en official "subclause (II)";
    when supplier_parts_left_controlled_group_in_1999_430i4CiiII(employer);
    then specified_automobile_manufacturer_430i4Cii(employer);
}

pub relation employee_offered_early_retirement_430i4C(employee: Person, employer: Person, offer_made_on: Date, offer_expires_on: Date, retire_by: Date) kind empirical {
    label en unofficial "the employee is offered substantial additional cash, substantially enhanced retirement benefits or materially reduced duties on the condition of retiring by a specified date, under a bona fide retirement incentive program, with the offer date and the expiry date, case-asserted (evaluative \"substantial\")";
}

pub relation employee_accepted_offer_before_expiry_430i4CiIV(employee: Person) kind empirical {
    label en unofficial "the employee elects to accept the offer before the specified date on which it expires, case-asserted";
}

pub relation employee_excluded_from_at_risk_assumptions_430i4C(employee: Person) kind institutional {
    label en official "section 430(i)(4)(C)(i): the additional assumptions are not taken into account, for the (A)(ii) test, with respect to an employee of a specified automobile manufacturer offered early retirement in 2006 who does not accept before the offer expires";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "such offer is made during 2006 and pursuant to a bona fide retirement incentive program")
rule EmployeeExcludedFromAtRiskAssumptions430i4C(employee: Person, employer: Person, made: Date, expires: Date, retire_by: Date) strict {
    label en official "exact boundaries: an offer made in 2006, expiring not later than December 31, 2006, calling for retirement not later than December 31, 2010; not accepted";
    when specified_automobile_manufacturer_430i4Cii(employer)
        and employee_offered_early_retirement_430i4C(employee, employer, made, expires, retire_by)
        and made >= @2006-01-01
        and made <= @2006-12-31
        and expires <= @2006-12-31
        and retire_by <= @2010-12-31
        and not_known(employee_accepted_offer_before_expiry_430i4CiIV(employee));
    then employee_excluded_from_at_risk_assumptions_430i4C(employee);
}

// =====================================================================
// (i)(5) Transition between applicable targets
// =====================================================================

pub relation consecutive_plan_years_in_at_risk_status_430i5(plan: DefinedBenefitPlan, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the number of consecutive plan years the plan has been in at-risk status, including the plan year, counting only plan years beginning in 2008 or later, case-asserted (clause (C))";
}

pub relation at_risk_and_ordinary_amounts_430i5(plan: DefinedBenefitPlan, y: TaxableYear, kind: AtRiskAmountKind430i5, at_risk: Money, ordinary: Money) kind empirical {
    label en unofficial "the amount determined under subsection (i) without regard to paragraph (5) and the amount determined without regard to the subsection, for the funding target or the target normal cost, case-asserted";
}

pub relation transition_percentage_430i5B(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 430(i)(5)(B) table: 20, 40, 60 and 80 percent for the 1st to 4th consecutive plan year in at-risk status (table T2 of the model)";
}

@source(IRC_S430_I, relation = formalizes, coverage = partial, quote = "the transition percentage shall be determined in accordance with the following table")
rule TransitionPercentageYear1430i5B(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "PARTIAL: table read from the model; 1st year 20 percent";
    when consecutive_plan_years_in_at_risk_status_430i5(plan, y, 1);
    then transition_percentage_430i5B(plan, y, 0.20);
}

@source(IRC_S430_I, relation = formalizes, coverage = partial, quote = "the transition percentage shall be determined in accordance with the following table")
rule TransitionPercentageYear2430i5B(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "PARTIAL: 2nd year 40 percent";
    when consecutive_plan_years_in_at_risk_status_430i5(plan, y, 2);
    then transition_percentage_430i5B(plan, y, 0.40);
}

@source(IRC_S430_I, relation = formalizes, coverage = partial, quote = "the transition percentage shall be determined in accordance with the following table")
rule TransitionPercentageYear3430i5B(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "PARTIAL: 3rd year 60 percent";
    when consecutive_plan_years_in_at_risk_status_430i5(plan, y, 3);
    then transition_percentage_430i5B(plan, y, 0.60);
}

@source(IRC_S430_I, relation = formalizes, coverage = partial, quote = "the transition percentage shall be determined in accordance with the following table")
rule TransitionPercentageYear4430i5B(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "PARTIAL: 4th year 80 percent";
    when consecutive_plan_years_in_at_risk_status_430i5(plan, y, 4);
    then transition_percentage_430i5B(plan, y, 0.80);
}

pub relation applicable_transition_amount_430i5A(plan: DefinedBenefitPlan, y: TaxableYear, kind: AtRiskAmountKind430i5, amount: Money) kind institutional {
    label en official "section 430(i)(5)(A): for a plan in at-risk status for fewer than 5 consecutive plan years, the ordinary amount plus the transition percentage of the excess of the at-risk amount over it; from the 5th year the at-risk amount";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the transition percentage for such plan year of the excess of the amount determined under this subsection (without regard to this paragraph) over the amount determined under this section without regard to this subsection")
rule ApplicableTransitionAmountFewerThanFive430i5A(plan: DefinedBenefitPlan, y: TaxableYear, kind: AtRiskAmountKind430i5, at_risk: Money, ordinary: Money, years: Integer, pct: Decimal) strict {
    label en official "exact: ordinary + percentage x (at-risk - ordinary), cents HALF_UP (JUDGMENT CALL); fewer than 5 years";
    when at_risk_and_ordinary_amounts_430i5(plan, y, kind, at_risk, ordinary)
        and consecutive_plan_years_in_at_risk_status_430i5(plan, y, years)
        and years >= 1
        and years < 5
        and transition_percentage_430i5B(plan, y, pct);
    then applicable_transition_amount_430i5A(plan, y, kind, round(ordinary + (at_risk - ordinary) * pct, 2, "HALF_UP"));
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "has been in such status for a consecutive period of fewer than 5 plan years")
rule ApplicableTransitionAmountFiveOrMore430i5A(plan: DefinedBenefitPlan, y: TaxableYear, kind: AtRiskAmountKind430i5, at_risk: Money, ordinary: Money, years: Integer) strict {
    label en official "exact boundary: 5 consecutive years is not fewer than 5, so the full at-risk amount applies";
    when at_risk_and_ordinary_amounts_430i5(plan, y, kind, at_risk, ordinary)
        and consecutive_plan_years_in_at_risk_status_430i5(plan, y, years)
        and years >= 5;
    then applicable_transition_amount_430i5A(plan, y, kind, at_risk);
}

// =====================================================================
// (m)(4)-(6) Community newspaper plans
// =====================================================================

pub relation newspaper_new_accruals_valued_on_treasury_yield_curve_430m4Aii(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(m)(4)(A)(ii): the present value of benefits accrued or earned for a plan year with an election in effect is determined on the Treasury obligation yield curve for the valuation date";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "shall be determined on the basis of the United States Treasury obligation yield curve for the day that is the valuation date of such plan for such plan year")
rule NewAccrualsOnTreasuryYieldCurve430m4Aii(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "only for a plan year with the election in effect (the curve itself is prescribed by the Secretary and is not pinned)";
    when newspaper_election_in_effect_430m(plan, y);
    then newspaper_new_accruals_valued_on_treasury_yield_curve_430m4Aii(plan, y);
}

pub relation first_plan_year_to_which_election_applies_430m4B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year is the first plan year to which the election under paragraph (1) applies, case-asserted";
}

pub relation prior_shortfall_bases_reduced_to_zero_430m4Bi(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(m)(4)(B)(i): the shortfall amortization bases (and installments) for all plan years before the first election year are reduced to zero";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "shall be reduced to zero under rules similar to the rules of subsection (c)(6)")
rule PriorShortfallBasesReducedToZero430m4Bi(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "at the first plan year to which the election applies (rules similar to (c)(6) are not reproduced)";
    when newspaper_election_in_effect_430m(plan, y) and first_plan_year_to_which_election_applies_430m4B(plan, y);
    then prior_shortfall_bases_reduced_to_zero_430m4Bi(plan, y);
}

pub relation newspaper_shortfall_amortization_base_430m4Bii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(m)(4)(B)(ii): the base for the first election year is the funding shortfall of the plan for that year (with the modified interest rates)";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "the shortfall amortization base for the first plan year to which the election under paragraph (1) applies shall be the funding shortfall of such plan for such plan year")
rule NewspaperShortfallAmortizationBase430m4Bii(plan: DefinedBenefitPlan, y: TaxableYear, shortfall: Money) strict {
    label en official "the funding shortfall (module 18) at the modified 8 percent rates";
    when newspaper_election_in_effect_430m(plan, y)
        and first_plan_year_to_which_election_applies_430m4B(plan, y)
        and funding_shortfall_430(plan, y, shortfall);
    then newspaper_shortfall_amortization_base_430m4Bii(plan, y, shortfall);
}

pub relation special_election_430c2D_inapplicable_430m4Cii(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(m)(4)(C)(ii): the election under section 430(c)(2)(D) does not apply to a plan year to which the newspaper election applies";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "The election under subparagraph (D) of subsection (c)(2) shall not apply to any plan year to which the election under paragraph (1) applies")
rule SpecialElection430c2DInapplicable430m4Cii(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "for a plan year with the newspaper election in effect";
    when newspaper_election_in_effect_430m(plan, y);
    then special_election_430c2D_inapplicable_430m4Cii(plan, y);
}

// (m)(5) definitions

pub relation employer_maintained_plan_at_end_of_2018_430m5A(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan (to which section 430 applies) was maintained as of December 31, 2018 by the employer, case-asserted";
}

pub relation employer_published_newspapers_in_11_year_period_430m5Ai(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employer maintains the plan for employment in the trade or business of publishing one or more newspapers published by it at any time during the 11-year period ending on December 20, 2019, case-asserted";
}

pub relation employer_not_publicly_traded_nor_controlled_by_such_430m5AiiI(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employer is not a company whose stock is publicly traded and is not controlled, directly or indirectly, by such a company, case-asserted";
}

pub relation employer_family_controlled_30_years_430m5AiiII(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employer is controlled, directly or indirectly, during the entire 30-year period ending on December 20, 2019 by members of the same family, case-asserted";
}

pub relation states_of_carrier_distributed_daily_newspaper_430m5AiiII(plan: DefinedBenefitPlan, states: Integer) kind empirical {
    label en unofficial "the number of States in which the employer publishes or distributes a daily newspaper carrier-distributed in printed form, case-asserted";
}

pub relation employer_control_basis_430m5Aiii(plan: DefinedBenefitPlan, basis: NewspaperControlBasis430m5Aiii) kind empirical {
    label en unofficial "the employer is controlled by persons residing primarily in a State where the newspaper has been published, by the same-family individuals for 30 years, by trusts whose sole trustees are such persons, or by a combination, case-asserted";
}

pub enum NewspaperControlBasis430m5Aiii {
    ResidentsOfPublicationState;
    SameFamilyFor30Years;
    TrustsOfSuchPersons;
    CombinationOfSuchPersons;
}

pub relation community_newspaper_plan_decomposed_430m5A(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 430(m)(5)(A): a plan maintained as of December 31, 2018 by a newspaper publisher meeting clauses (i)-(iii)";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "is not a company the stock of which is publicly traded")
rule CommunityNewspaperPlanNotPublic430m5A(plan: DefinedBenefitPlan, basis: NewspaperControlBasis430m5Aiii) strict {
    label en official "clauses (i), (ii)(I) and (iii)";
    when employer_maintained_plan_at_end_of_2018_430m5A(plan)
        and employer_published_newspapers_in_11_year_period_430m5Ai(plan)
        and employer_not_publicly_traded_nor_controlled_by_such_430m5AiiI(plan)
        and employer_control_basis_430m5Aiii(plan, basis);
    then community_newspaper_plan_decomposed_430m5A(plan);
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "does not publish or distribute a daily newspaper that is carrier-distributed in printed form in more than 5 States")
rule CommunityNewspaperPlanFamily430m5A(plan: DefinedBenefitPlan, basis: NewspaperControlBasis430m5Aiii, states: Integer) strict {
    label en official "clauses (i), (ii)(II) (not more than 5 States: 5 is allowed) and (iii)";
    when employer_maintained_plan_at_end_of_2018_430m5A(plan)
        and employer_published_newspapers_in_11_year_period_430m5Ai(plan)
        and employer_family_controlled_30_years_430m5AiiII(plan)
        and states_of_carrier_distributed_daily_newspaper_430m5AiiII(plan, states)
        and states <= 5
        and employer_control_basis_430m5Aiii(plan, basis);
    then community_newspaper_plan_decomposed_430m5A(plan);
}

pub enum NewspaperExclusion430m5B {
    NotInGeneralCirculation;
    PublishedLessThanThreeTimesPerWeek;
    NeverRegularlyPublishedOnNewsprint;
    NoBonaFideListOfPaidSubscribers;
}

pub relation publication_exclusion_ground_430m5B(paper: Integer, ground: NewspaperExclusion430m5B) kind empirical {
    label en unofficial "the publication is not in general circulation, is published less than 3 times per week, has never been regularly published on newsprint, or has no bona fide list of paid subscribers, case-asserted";
}

pub relation publication_is_a_newspaper_candidate_430m5B(paper: Integer) kind empirical {
    label en unofficial "the publication is a newspaper determined without regard to subparagraph (B), case-asserted";
}

pub relation newspaper_430m5B(paper: Integer) kind institutional {
    label en official "section 430(m)(5)(B): a newspaper other than one that is not in general circulation, is published less than 3 times a week, was never regularly published on newsprint or lacks a paid subscriber list";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "The term \"newspaper\" does not include any newspaper")
rule Newspaper430m5B(paper: Integer) strict {
    label en official "no exclusion ground on record";
    when publication_is_a_newspaper_candidate_430m5B(paper) and not_known(publication_excluded_430m5B(paper));
    then newspaper_430m5B(paper);
}

pub relation publication_excluded_430m5B(paper: Integer) kind institutional {
    label en official "helper: some exclusion ground applies";
}

rule PublicationExcluded430m5B(paper: Integer, ground: NewspaperExclusion430m5B) strict {
    label en official "helper for the not_known guard: any ground";
    when publication_exclusion_ground_430m5B(paper, ground);
    then publication_excluded_430m5B(paper);
}

pub relation power_to_direct_management_through_voting_securities_430m5C(controller: Person, controlled: Person) kind empirical {
    label en unofficial "the controller possesses, directly or indirectly, the power to direct or cause the direction and management of the other person (including the power to elect a majority of the board) through ownership of voting securities, case-asserted";
}

pub relation controlled_by_430m5C(controlled: Person, controller: Person) kind institutional {
    label en official "section 430(m)(5)(C): a person is controlled by another that possesses the power to direct its management through voting securities";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "A person shall be treated as controlled by another person if such other person possesses, directly or indirectly, the power to direct or cause the direction and management of such person")
rule ControlledBy430m5C(controlled: Person, controller: Person) strict {
    label en official "through ownership of voting securities";
    when power_to_direct_management_through_voting_securities_430m5C(controller, controlled);
    then controlled_by_430m5C(controlled, controller);
}

pub relation treated_as_single_employer_on_dec_20_2019_430m6(member: Person, other: Person) kind empirical {
    label en unofficial "the two persons are treated as a single employer under section 414(b), (c), (m) or (o) as of December 20, 2019, case-asserted";
}

pub relation controlled_group_member_430m6(member: Person, other: Person) kind institutional {
    label en official "section 430(m)(6): the controlled group is all persons treated as a single employer under section 414(b), (c), (m) or (o) as of December 20, 2019";
}

@source(IRC_S430_M, relation = formalizes, coverage = exact, quote = "the term \"controlled group\" means all persons treated as a single employer under subsection (b), (c), (m), or (o) of section 414 as of December 20, 2019")
rule ControlledGroupMember430m6(member: Person, other: Person) strict {
    label en official "membership fixed as of December 20, 2019 (a case fact)";
    when treated_as_single_employer_on_dec_20_2019_430m6(member, other);
    then controlled_group_member_430m6(member, other);
}
