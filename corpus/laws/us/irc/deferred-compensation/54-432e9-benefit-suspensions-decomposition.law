// Section 432(e)(9) — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): benefit suspensions for multiemployer plans in critical and
// declining status, decomposed. Stage 2f (module 29) carried the floor of
// clause (D)(i), the age-75 limit (D)(ii), the disability exclusion (D)(iii),
// the conditions (C)(i)-(ii), the systemically-important-plan threshold and
// the top-line permission for benefit improvements. This module adds the
// power itself and the conditions for it to take effect, the definition and
// duration of a suspension, the retiree representative, the partition and
// ordering limits, the benefit-improvement liability caps, the notice, the
// Treasury approval process with its 225-day deemed approval, the participant
// vote, the systemically-important-plan override, judicial review limits and
// the special rule blocking emergence from critical status.
//
// Method: a legal effect that takes effect only after several steps is a
// `power` whose `valid_when` is one derived atom (`suspension_may_take_effect`)
// built from the steps; each agency deadline is a duty of the Secretary with
// exact calendar windows ("within 225 days" is inclusive of day 225;
// "the 90-day period beginning on the date" ends on day 89 after it).
// The vote is exact integer arithmetic: a majority of ALL participants and
// beneficiaries is strictly more than half. The Secretary is the person of
// `secretary_431`. Evaluative wording ("equitably", "reasonably estimated",
// "clearly erroneous") is a case fact or an external judgment of the
// Secretary, with the coverage row marked EVALUATIVE.

// =====================================================================
// (A) The power; (B) definition, duration, liability, applicability
// =====================================================================

use self::{
    IRC_S432_E,
    MultiemployerPlan,
    Person,
    TaxableYear,
    critical_and_declining_status_432b6,
    multiemployer_plan_sponsor_432,
    secretary_431,
    suspension_conditions_met_432e9c,
    systemically_important_plan_432,
};

pub relation suspension_of_benefits_exercise_432e9A(plan: MultiemployerPlan, participant: Person) kind empirical {
    label en unofficial "the plan sponsor, by plan amendment, suspends benefits of this participant or beneficiary, case-asserted (exercise atom)";
}

pub relation suspension_may_take_effect_432e9(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(9)(A), (C), (F), (G), (H): the plan is in critical and declining status, the conditions of (C) are met, notice was given concurrently with the application, the application is approved (or deemed approved) and the vote did not reject the suspension (or the plan is systemically important)";
}

pub relation suspension_of_benefits_effect_432e9A(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(9)(A): the benefits of the participant are suspended notwithstanding section 411(d)(6)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "the plan sponsor of a plan in critical and declining status may, by plan amendment, suspend benefits which the sponsor deems appropriate")
rule SuspendBenefitsPower432e9A(plan: MultiemployerPlan, participant: Person, sponsor: Person, y: TaxableYear) strict {
    label en official "PARTIAL: the sponsor's appropriateness judgment is not gated; the power is valid only when every gate of (C), (F), (G), (H) is passed";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and suspension_of_benefits_exercise_432e9A(plan, participant)
        and critical_and_declining_status_432b6(plan, y);
    then power SuspendBenefitsPower {
        holder sponsor;
        over participant;
        exercise suspension_of_benefits_exercise_432e9A(plan, participant);
        valid_when suspension_may_take_effect_432e9(plan, y);
        effect suspension_of_benefits_effect_432e9A(plan, participant);
    };
}

pub enum PaymentObligationTiming432 {
    CurrentPayment;
    FuturePayment;
}

pub relation payment_obligation_reduced_432e9Bi(plan: MultiemployerPlan, participant: Person, timing: PaymentObligationTiming432) kind empirical {
    label en unofficial "the plan's current or future payment obligation to the participant or beneficiary is reduced, temporarily or permanently, whether or not in pay status, case-asserted (section 432(e)(9)(B)(i))";
}

pub relation suspension_of_benefits_432e9Bi(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(9)(B)(i): a temporary or permanent reduction of any current or future payment obligation of the plan to any participant or beneficiary";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the term \"suspension of benefits\" means the temporary or permanent reduction of any current or future payment obligation of the plan to any participant or beneficiary under the plan, whether or not in pay status at the time of the suspension of benefits")
rule SuspensionOfBenefitsDefined432e9Bi(plan: MultiemployerPlan, participant: Person, timing: PaymentObligationTiming432) strict {
    label en official "either a current or a future obligation";
    when payment_obligation_reduced_432e9Bi(plan, participant, timing);
    then suspension_of_benefits_432e9Bi(plan, participant);
}

pub relation suspension_effective_from_432e9B(plan: MultiemployerPlan, participant: Person, start: Date) kind empirical {
    label en unofficial "the date the suspension of the participant's benefits takes effect, case-asserted";
}

pub relation benefit_improvement_provided_on_432e9Bii(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the plan sponsor provides benefit improvements in accordance with subparagraph (E), case-asserted";
}

pub relation suspension_expires_by_its_own_terms_on_432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date the suspension expires by its own terms, case-asserted";
}

pub relation suspension_status_asked_on_432e9(plan: MultiemployerPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date on which the question whether the suspension is in effect is put, case-asserted";
}

pub relation suspension_ended_432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date) kind institutional {
    label en official "section 432(e)(9)(B)(ii): the suspension has ended by the date, the earlier of benefit improvements under (E) and expiry by its own terms";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "until the earlier of when the plan sponsor provides benefit improvements in accordance with subparagraph (E)")
rule SuspensionEndedByImprovement432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date, improved: Date) strict {
    label en official "exact boundary: on the improvement date the suspension has ended";
    when suspension_status_asked_on_432e9(plan, participant, on)
        and benefit_improvement_provided_on_432e9Bii(plan, improved)
        and improved <= on;
    then suspension_ended_432e9Bii(plan, participant, on);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "or the suspension of benefits expires by its own terms")
rule SuspensionEndedByExpiry432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date, expiry: Date) strict {
    label en official "exact boundary: on the expiry date the suspension has ended";
    when suspension_status_asked_on_432e9(plan, participant, on)
        and suspension_expires_by_its_own_terms_on_432e9Bii(plan, participant, expiry)
        and expiry <= on;
    then suspension_ended_432e9Bii(plan, participant, on);
}

pub relation suspension_in_effect_432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date) kind institutional {
    label en official "section 432(e)(9)(B)(ii): the suspension is in effect from its effective date until it ends";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Any suspension of benefits made under subparagraph (A) shall remain in effect until the earlier of")
rule SuspensionInEffect432e9Bii(plan: MultiemployerPlan, participant: Person, on: Date, start: Date) strict {
    label en official "in effect from the start date and not yet ended";
    when suspension_effective_from_432e9B(plan, participant, start)
        and suspension_status_asked_on_432e9(plan, participant, on)
        and on >= start
        and not_known(suspension_ended_432e9Bii(plan, participant, on));
    then suspension_in_effect_432e9Bii(plan, participant, on);
}

pub relation payment_not_made_by_reason_of_suspension_432e9Biii(plan: MultiemployerPlan, participant: Person) kind empirical {
    label en unofficial "a benefit payment is not made as a result of a suspension of benefits under this paragraph, case-asserted";
}

pub relation plan_not_liable_for_suspended_payments_432e9Biii(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(9)(B)(iii): the plan is not liable for benefit payments not made as a result of a suspension";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The plan shall not be liable for any benefit payments not made as a result of a suspension of benefits under this paragraph")
rule PlanNotLiableForSuspendedPayments432e9Biii(plan: MultiemployerPlan, participant: Person) strict {
    label en official "no liability for payments not made because of the suspension";
    when payment_not_made_by_reason_of_suspension_432e9Biii(plan, participant);
    then plan_not_liable_for_suspended_payments_432e9Biii(plan, participant);
}

pub enum SuspensionPersonRole432 {
    Participant;
    Beneficiary;
    AlternatePayeeOfParticipant;
}

pub relation person_role_under_plan_432e9Biv(plan: MultiemployerPlan, person: Person, person_role: SuspensionPersonRole432) kind empirical {
    label en unofficial "the person is a participant, a beneficiary or an alternate payee of a participant under the plan, case-asserted";
}

pub relation covered_by_suspension_rules_432e9Biv(plan: MultiemployerPlan, person: Person) kind institutional {
    label en official "section 432(e)(9)(B)(iv): the references to suspensions, increases and resumptions apply also to beneficiaries and alternate payees of participants";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "all references to suspensions of benefits, increases in benefits, or resumptions of suspended benefits with respect to participants shall also apply with respect to benefits of beneficiaries or alternative payees of participants")
rule CoveredBySuspensionRules432e9Biv(plan: MultiemployerPlan, person: Person, person_role: SuspensionPersonRole432) strict {
    label en official "any of the three roles";
    when person_role_under_plan_432e9Biv(plan, person, person_role);
    then covered_by_suspension_rules_432e9Biv(plan, person);
}

// (B)(v) Retiree representative

pub relation plan_participant_count_432e9(plan: MultiemployerPlan, count: Integer) kind empirical {
    label en unofficial "the number of participants of the plan, case-asserted";
}

pub relation suspension_application_submitted_on_432e9G(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the sponsor submits the application to suspend benefits to the Secretary of the Treasury, case-asserted";
}

pub relation retiree_representative_selected_432e9Bv(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor has selected a participant in pay status to act as retiree representative, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "In the case of a plan with 10,000 or more participants, not later than 60 days prior to the plan sponsor submitting an application to suspend benefits, the plan sponsor shall select a participant of the plan in pay status to act as a retiree representative")
rule SelectRetireeRepresentativeDuty432e9Bv(plan: MultiemployerPlan, sponsor: Person, n: Integer, submitted: Date, calendar_before_1: Date) strict {
    label en official "exact: 10,000 is included; the selection is due 60 calendar days before the application is submitted";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and plan_participant_count_432e9(plan, n)
        and n >= 10000
        and suspension_application_submitted_on_432e9G(plan, submitted)
        and us.irc.core::civil_calendar_boundary_before(submitted, 60, us.irc.core::CalendarDay, calendar_before_1);
    then duty SelectRetireeRepresentativeDuty {
        bearer sponsor;
        goal achievement {
            condition retiree_representative_selected_432e9Bv(plan);
            window [-infinity, calendar_before_1];
        }
    };
}

pub relation retiree_representative_reasonable_expenses_provided_432e9Bv(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan provides for reasonable expenses of the retiree representative, including reasonable legal and actuarial support commensurate with the plan's size and funded status, case-asserted (goal atom; evaluative \"reasonable\")";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan shall provide for reasonable expenses by the retiree representative, including reasonable legal and actuarial support, commensurate with the plan's size and funded status")
rule RetireeRepresentativeExpensesDuty432e9Bv(plan: MultiemployerPlan, sponsor: Person, n: Integer) strict {
    label en official "PARTIAL/EVALUATIVE: a maintenance duty of the sponsor for plans that must have a representative; what is reasonable is not tested";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and plan_participant_count_432e9(plan, n)
        and n >= 10000;
    then duty RetireeRepresentativeExpensesDuty {
        bearer sponsor;
        goal maintenance {
            condition retiree_representative_reasonable_expenses_provided_432e9Bv(plan);
            window [-infinity, infinity];
        }
    };
}

pub relation retiree_representative_duties_performed_432e9Bv(plan: MultiemployerPlan, rep: Person) kind empirical {
    label en unofficial "the person performs the duties of retiree representative, case-asserted";
}

pub relation representative_also_plan_trustee_432e9Bv(plan: MultiemployerPlan, rep: Person) kind empirical {
    label en unofficial "the retiree representative is also a plan trustee, case-asserted";
}

pub relation duties_associated_with_application_432e9G(plan: MultiemployerPlan, rep: Person) kind empirical {
    label en unofficial "the duties are those associated with an application to suspend benefits under subparagraph (G), case-asserted";
}

pub relation retiree_representative_duties_not_subject_to_4975_432e9Bv(plan: MultiemployerPlan, rep: Person) kind institutional {
    label en official "section 432(e)(9)(B)(v)(III): duties performed as retiree representative are not subject to section 4975, except application duties performed by a representative who is also a plan trustee";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Duties performed pursuant to subclause (I) shall not be subject to section 4975")
rule RetireeRepresentativeDutiesNot4975432e9Bv(plan: MultiemployerPlan, rep: Person) strict {
    label en official "the exception withdraws the rule for trustee-representatives performing application duties";
    when retiree_representative_duties_performed_432e9Bv(plan, rep)
        and not_known(retiree_representative_trustee_application_duties_432e9Bv(plan, rep));
    then retiree_representative_duties_not_subject_to_4975_432e9Bv(plan, rep);
}

pub relation retiree_representative_trustee_application_duties_432e9Bv(plan: MultiemployerPlan, rep: Person) kind institutional {
    label en official "helper: application duties (G) performed by a representative who is also a plan trustee";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to those duties associated with an application to suspend benefits pursuant to subparagraph (G) that are performed by the retiree representative who is also a plan trustee")
rule RetireeRepresentativeTrusteeApplicationDuties432e9Bv(plan: MultiemployerPlan, rep: Person) strict {
    label en official "trustee-representative performing application duties";
    when retiree_representative_duties_performed_432e9Bv(plan, rep)
        and representative_also_plan_trustee_432e9Bv(plan, rep)
        and duties_associated_with_application_432e9G(plan, rep);
    then retiree_representative_trustee_application_duties_432e9Bv(plan, rep);
}

// =====================================================================
// (D)(v), (D)(vii) Partition and ordering of suspensions
// =====================================================================

pub relation suspension_combined_with_partition_432e9Dv(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the suspension is made in combination with a partition of the plan under ERISA section 4233, case-asserted";
}

pub relation partition_effective_date_432e9Dv(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the effective date of the partition, case-asserted";
}

pub relation suspension_takes_effect_432e9Dv(sponsor: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the suspension of benefits takes effect, case-asserted (action atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the suspension of benefits may not take effect prior to the effective date of such partition")
rule SuspensionNotBeforePartition432e9Dv(plan: MultiemployerPlan, sponsor: Person, partition: Date, calendar_before_1: Date) strict {
    label en official "exact: the prohibited window ends on the day before the partition takes effect; an effect on the partition date is allowed";
    when suspension_combined_with_partition_432e9Dv(plan)
        and partition_effective_date_432e9Dv(plan, partition)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and us.irc.core::civil_calendar_boundary_before(partition, 1, us.irc.core::CalendarDay, calendar_before_1);
    then prohibition SuspendBeforePartitionProhibition {
        bearer sponsor;
        action suspension_takes_effect_432e9Dv(sponsor, plan);
        window [-infinity, calendar_before_1];
    };
}

pub enum SuspendedBenefitCategory432e9Dvii {
    WithdrawnEmployerFailedToPayLiability;
    AllOtherSuspendableBenefits;
    PaidWithdrawnEmployerWithAssumedLiability;
}

pub relation suspended_benefit_category_432e9Dvii(plan: MultiemployerPlan, item: Integer, category: SuspendedBenefitCategory432e9Dvii) kind empirical {
    label en unofficial "the suspended benefit is attributable to service for an employer of this category, case-asserted";
}

pub relation employer_withdrew_completely_and_paid_before_mprea_432e9Dviiiaa(employer: Person) kind empirical {
    label en unofficial "the employer withdrew from the plan in a complete withdrawal under ERISA section 4203 before the enactment of the Multiemployer Pension Reform Act of 2014 and has paid the full withdrawal liability, case-asserted (clause (vii)(III)(aa))";
}

pub relation employer_assumed_liability_under_single_employer_plan_432e9Dviiibb(employer: Person) kind empirical {
    label en unofficial "pursuant to a collective bargaining agreement the employer assumed liability for providing benefits under a separate single-employer plan in an amount equal to the benefits reduced by the plan's financial status, case-asserted (clause (vii)(III)(bb))";
}

pub relation benefit_attributable_to_employer_432e9Dvii(plan: MultiemployerPlan, item: Integer, employer: Person) kind empirical {
    label en unofficial "the suspended benefit is directly attributable to the participant's service with this employer, case-asserted";
}

pub relation employer_is_clause_vii_III_employer_432e9Dvii(employer: Person) kind institutional {
    label en official "section 432(e)(9)(D)(vii)(III)(aa) and (bb): the employer withdrew and paid before the 2014 Act and assumed the liability for the benefits under a separate single-employer plan";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "withdrawn from the plan in a complete withdrawal under section 4203 of the Employee Retirement Income Security Act of 1974 and has paid the full amount of the employer's withdrawal liability")
rule ClauseVIIIIIEmployer432e9Dvii(employer: Person) strict {
    label en official "(aa) and (bb) together";
    when employer_withdrew_completely_and_paid_before_mprea_432e9Dviiiaa(employer)
        and employer_assumed_liability_under_single_employer_plan_432e9Dviiibb(employer);
    then employer_is_clause_vii_III_employer_432e9Dvii(employer);
}

pub relation plan_includes_clause_vii_III_benefits_432e9Dvii(plan: MultiemployerPlan) kind institutional {
    label en official "helper: the plan includes benefits attributable to an employer described in clause (vii)(III)";
}

rule PlanIncludesClauseVIIIIIBenefits432e9Dvii(plan: MultiemployerPlan, item: Integer, employer: Person) strict {
    label en official "helper for the ordering rule";
    when benefit_attributable_to_employer_432e9Dvii(plan, item, employer)
        and employer_is_clause_vii_III_employer_432e9Dvii(employer);
    then plan_includes_clause_vii_III_benefits_432e9Dvii(plan);
}

pub relation suspension_order_rank_432e9Dvii(plan: MultiemployerPlan, item: Integer, rank: Integer) kind institutional {
    label en official "section 432(e)(9)(D)(vii): the order in which suspensions are applied, 1 first, 2 second, 3 third";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "first, be applied to the maximum extent permissible to benefits attributable to a participant's service for an employer which withdrew from the plan and failed to pay")
rule SuspensionOrderFirst432e9DviiI(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(I): benefits from a withdrawn employer that failed to pay come first";
    when plan_includes_clause_vii_III_benefits_432e9Dvii(plan)
        and suspended_benefit_category_432e9Dvii(plan, item, WithdrawnEmployerFailedToPayLiability);
    then suspension_order_rank_432e9Dvii(plan, item, 1);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "second, except as provided by subclause (III), be applied to all other benefits that may be suspended under this paragraph")
rule SuspensionOrderSecond432e9DviiII(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(II): all other benefits come second";
    when plan_includes_clause_vii_III_benefits_432e9Dvii(plan)
        and suspended_benefit_category_432e9Dvii(plan, item, AllOtherSuspendableBenefits);
    then suspension_order_rank_432e9Dvii(plan, item, 2);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "third, be applied to benefits under a plan that are directly attributable to a participant's service with any employer which has, prior to the date of enactment of the Multiemployer Pension Reform Act of 2014")
rule SuspensionOrderThird432e9DviiIII(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(III): benefits of a paid-up withdrawn employer that assumed the liability come third";
    when plan_includes_clause_vii_III_benefits_432e9Dvii(plan)
        and suspended_benefit_category_432e9Dvii(plan, item, PaidWithdrawnEmployerWithAssumedLiability);
    then suspension_order_rank_432e9Dvii(plan, item, 3);
}

// =====================================================================
// (E) Benefit improvements: liability caps and definition
// =====================================================================

pub relation improvement_liabilities_not_in_pay_status_432e9Eii(plan: MultiemployerPlan, amount: Money) kind empirical {
    label en unofficial "the projected value of the total liabilities for benefit improvements for participants and beneficiaries not in pay status by the first day of the plan year in which the improvements take effect, case-asserted (clause (ii)(I))";
}

pub relation improvement_liabilities_in_pay_status_432e9Eii(plan: MultiemployerPlan, amount: Money) kind empirical {
    label en unofficial "the projected value of the liabilities arising from benefit improvements for participants and beneficiaries with benefit commencement dates before that first day, case-asserted (clause (ii)(I))";
}

pub relation improvement_liability_limit_met_432e9EiiI(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(E)(ii)(I): the projected liabilities for participants not in pay status do not exceed those for participants in pay status";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may not exceed the projected value of the liabilities arising from benefit improvements for participants and beneficiaries with benefit commencement dates prior to the first day of such plan year")
rule ImprovementLiabilityLimitMet432e9EiiI(plan: MultiemployerPlan, not_in_pay: Money, in_pay: Money) strict {
    label en official "exact boundary: equal amounts are within the limit";
    when improvement_liabilities_not_in_pay_status_432e9Eii(plan, not_in_pay)
        and improvement_liabilities_in_pay_status_432e9Eii(plan, in_pay)
        and not_in_pay <= in_pay;
    then improvement_liability_limit_met_432e9EiiI(plan);
}

pub relation increase_equitably_distributed_to_pay_status_participants_432e9EiiII(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor equitably distributes any increase in total liabilities to some or all participants and beneficiaries whose benefit commencement dates are before the first day of the plan year, taking into account the (D)(vi) factors and the extent to which their benefits were suspended, case-asserted (goal atom; evaluative \"equitably\")";
}

pub relation improvement_increases_liabilities_432e9E(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the benefit improvement increases the liabilities of the plan, case-asserted";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan sponsor shall equitably distribute any increase in total liabilities for benefit improvements in clause (i)")
rule EquitableDistributionDuty432e9EiiII(plan: MultiemployerPlan, sponsor: Person) strict {
    label en official "PARTIAL/EVALUATIVE: a maintenance duty; what is equitable is a judgment not tested";
    when improvement_increases_liabilities_432e9E(plan)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty DistributeImprovementEquitablyDuty {
        bearer sponsor;
        goal maintenance {
            condition increase_equitably_distributed_to_pay_status_participants_432e9EiiII(plan);
            window [-infinity, infinity];
        }
    };
}

pub relation resumption_for_pay_status_participants_only_432e9Eiii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor increases liabilities through a resumption of benefits for participants and beneficiaries in pay status only, case-asserted";
}

pub relation resumption_value_equitably_distributed_432e9Eiii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor equitably distributes the value of resumed benefits to some or all participants and beneficiaries in pay status, taking into account the (D)(vi) factors, case-asserted";
}

pub relation pay_status_resumption_permitted_432e9Eiii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(E)(iii): liabilities may be increased through a resumption for participants in pay status only if the value is equitably distributed";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "only if the plan sponsor equitably distributes the value of resumed benefits to some or all of the participants and beneficiaries in pay status")
rule PayStatusResumptionPermitted432e9Eiii(plan: MultiemployerPlan) strict {
    label en official "PARTIAL/EVALUATIVE: equitable distribution is a case fact";
    when resumption_for_pay_status_participants_only_432e9Eiii(plan)
        and resumption_value_equitably_distributed_432e9Eiii(plan);
    then pay_status_resumption_permitted_432e9Eiii(plan);
}

pub relation secretary_determines_de_minimis_reasonable_increase_432e9Eiv1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary of the Treasury, in consultation with the PBGC and the Secretary of Labor, determines the increase to be reasonable and to provide for only de minimis increases in the liabilities of the plan, case-asserted (clause (iv)(I))";
}

pub relation improvement_required_for_qualification_or_law_432e9Eiv2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the increase is required as a condition of qualification under part I of subchapter D or to comply with other applicable law, as determined by the Secretary of the Treasury, case-asserted (clause (iv)(II))";
}

pub relation improvement_limits_inapplicable_432e9Eiv(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(E)(iv): subparagraph (E) does not apply to a de minimis increase the Secretary determines reasonable or to an increase required for qualification or by applicable law";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "determines to be reasonable and which provides for only de minimis increases in the liabilities of the plan")
rule ImprovementLimitsInapplicableDeMinimis432e9Eiv(plan: MultiemployerPlan) strict {
    label en official "(I)";
    when secretary_determines_de_minimis_reasonable_increase_432e9Eiv1(plan);
    then improvement_limits_inapplicable_432e9Eiv(plan);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "is required as a condition of qualification under part I of subchapter D of chapter 1 of subtitle A or to comply with other applicable law")
rule ImprovementLimitsInapplicableRequired432e9Eiv(plan: MultiemployerPlan) strict {
    label en official "(II)";
    when improvement_required_for_qualification_or_law_432e9Eiv2(plan);
    then improvement_limits_inapplicable_432e9Eiv(plan);
}

pub enum BenefitImprovementKind432 {
    ResumptionOfSuspendedBenefits;
    IncreaseInBenefits;
    IncreaseInAccrualRate;
    IncreaseInRateOfBecomingNonforfeitable;
}

pub relation plan_change_of_kind_432e9Evi(plan: MultiemployerPlan, kind: BenefitImprovementKind432) kind empirical {
    label en unofficial "the plan change is of this kind, case-asserted";
}

pub relation benefit_improvement_432e9Evi(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(E)(vi): a resumption of suspended benefits, an increase in benefits, in the accrual rate, or in the rate at which benefits become nonforfeitable";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the term \"benefit improvement\" means, with respect to a plan, a resumption of suspended benefits, an increase in benefits, an increase in the rate at which benefits accrue")
rule BenefitImprovementDefined432e9Evi(plan: MultiemployerPlan, kind: BenefitImprovementKind432) strict {
    label en official "any of the four kinds";
    when plan_change_of_kind_432e9Evi(plan, kind);
    then benefit_improvement_432e9Evi(plan);
}

// =====================================================================
// (F) Notice of the proposed suspension
// =====================================================================

pub relation suspension_notice_given_on_432e9F(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date notice of the proposed suspension is given by the plan sponsor, case-asserted";
}

pub relation notice_to_participants_reachable_by_reasonable_efforts_432e9Fi1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "notice was given to the participants and beneficiaries who may be contacted by reasonable efforts, case-asserted";
}

pub relation notice_to_contributing_employers_432e9Fi2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "notice was given to each employer with an obligation to contribute under ERISA section 4212(a), case-asserted";
}

pub relation notice_to_employee_organizations_432e9Fi3(plan: MultiemployerPlan) kind empirical {
    label en unofficial "notice was given to each employee organization representing participants employed by such an employer, case-asserted";
}

pub relation suspension_notice_recipients_complete_432e9Fi(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(F)(i): the notice went to the participants and beneficiaries, each contributing employer and each employee organization";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "such plan participants and beneficiaries who may be contacted by reasonable efforts")
rule SuspensionNoticeRecipientsComplete432e9Fi(plan: MultiemployerPlan) strict {
    label en official "(I), (II) and (III) together";
    when notice_to_participants_reachable_by_reasonable_efforts_432e9Fi1(plan)
        and notice_to_contributing_employers_432e9Fi2(plan)
        and notice_to_employee_organizations_432e9Fi3(plan);
    then suspension_notice_recipients_complete_432e9Fi(plan);
}

pub relation notice_content_effect_estimate_432e9Fii1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice has sufficient information to understand the effect, including an individualized annual or monthly estimate for each participant or beneficiary, case-asserted";
}

pub relation notice_content_factors_432e9Fii2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice describes the factors considered by the plan sponsor in designing the suspensions, case-asserted";
}

pub relation notice_content_website_and_comments_432e9Fii3(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice states that the application will be on the Treasury website and that comments will be accepted, case-asserted";
}

pub relation notice_content_rights_and_remedies_432e9Fii4(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice has information on the rights and remedies of participants and beneficiaries, case-asserted";
}

pub relation notice_content_retiree_representative_432e9Fii5(plan: MultiemployerPlan) kind empirical {
    label en unofficial "if applicable, the notice states the appointment, date, identity (including trustee status) and contact of the retiree representative, case-asserted";
}

pub relation notice_content_treasury_contact_432e9Fii6(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice has information on how to contact the Department of the Treasury, case-asserted";
}

pub relation retiree_representative_required_432e9Bv(plan: MultiemployerPlan) kind institutional {
    label en official "helper: the plan has 10,000 or more participants, so a retiree representative was to be appointed";
}

rule RetireeRepresentativeRequired432e9Bv(plan: MultiemployerPlan, n: Integer) strict {
    label en official "10,000 or more participants";
    when plan_participant_count_432e9(plan, n) and n >= 10000;
    then retiree_representative_required_432e9Bv(plan);
}

pub relation suspension_notice_content_complete_432e9Fii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(F)(ii): the notice contains the items (I)-(VI); item (V) is required only where a retiree representative applies";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The notice under clause (i) shall contain")
rule SuspensionNoticeContentCompleteWithRepresentative432e9Fii(plan: MultiemployerPlan) strict {
    label en official "all six items when a retiree representative is required";
    when retiree_representative_required_432e9Bv(plan)
        and notice_content_effect_estimate_432e9Fii1(plan)
        and notice_content_factors_432e9Fii2(plan)
        and notice_content_website_and_comments_432e9Fii3(plan)
        and notice_content_rights_and_remedies_432e9Fii4(plan)
        and notice_content_retiree_representative_432e9Fii5(plan)
        and notice_content_treasury_contact_432e9Fii6(plan);
    then suspension_notice_content_complete_432e9Fii(plan);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "if applicable, a statement describing the appointment of a retiree representative")
rule SuspensionNoticeContentCompleteWithoutRepresentative432e9Fii(plan: MultiemployerPlan) strict {
    label en official "five items when no retiree representative is required";
    when plan_participant_count_432e9(plan, _)
        and not_known(retiree_representative_required_432e9Bv(plan))
        and notice_content_effect_estimate_432e9Fii1(plan)
        and notice_content_factors_432e9Fii2(plan)
        and notice_content_website_and_comments_432e9Fii3(plan)
        and notice_content_rights_and_remedies_432e9Fii4(plan)
        and notice_content_treasury_contact_432e9Fii6(plan);
    then suspension_notice_content_complete_432e9Fii(plan);
}

pub relation notice_in_prescribed_form_and_manner_432e9Fiii1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice is provided in the form and manner prescribed in Treasury guidance, case-asserted (the guidance itself is not pinned)";
}

pub relation notice_understandable_by_average_participant_432e9Fiii2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice is written so as to be understood by the average plan participant, case-asserted (evaluative)";
}

pub relation notice_form_reasonably_accessible_432e9Fiii3(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice is in written, electronic or other appropriate form reasonably accessible to the persons to whom it must be provided, case-asserted";
}

pub relation suspension_notice_form_met_432e9Fiii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(F)(iii): prescribed form and manner, understandable by the average participant, in an accessible form";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall be written in a manner so as to be understood by the average plan participant")
rule SuspensionNoticeFormMet432e9Fiii(plan: MultiemployerPlan) strict {
    label en official "(I), (II) and (III) together; (III) is a permission read as the accessibility limit";
    when notice_in_prescribed_form_and_manner_432e9Fiii1(plan)
        and notice_understandable_by_average_participant_432e9Fiii2(plan)
        and notice_form_reasonably_accessible_432e9Fiii3(plan);
    then suspension_notice_form_met_432e9Fiii(plan);
}

pub relation suspension_notice_requirements_met_432e9F(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(F): notice given concurrently with the application to all recipients, with the required content and form";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "unless notice of such proposed suspension has been given by the plan sponsor concurrently with an application for approval of such suspension")
rule SuspensionNoticeRequirementsMet432e9F(plan: MultiemployerPlan, given: Date, applied: Date) strict {
    label en official "exact: the notice is concurrent when given on the day the application is submitted";
    when suspension_notice_given_on_432e9F(plan, given)
        and suspension_application_submitted_on_432e9G(plan, applied)
        and given == applied
        and suspension_notice_recipients_complete_432e9Fi(plan)
        and suspension_notice_content_complete_432e9Fii(plan)
        and suspension_notice_form_met_432e9Fiii(plan);
    then suspension_notice_requirements_met_432e9F(plan);
}

// =====================================================================
// (G) Approval process by the Secretary of the Treasury
// =====================================================================

pub relation application_criteria_satisfied_432e9Gi(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan is eligible for the suspensions and has satisfied the criteria of subparagraphs (C), (D), (E) and (F), as the Secretary finds, case-asserted";
}

pub relation application_approved_432e9Gi(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary of the Treasury has approved the application, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "the Secretary of the Treasury shall approve, in consultation with the Pension Benefit Guaranty Corporation and the Secretary of Labor, the application upon finding that the plan is eligible for the suspensions")
rule ApproveApplicationDuty432e9Gi(plan: MultiemployerPlan, sponsor: Person, secretary: Person, applied: Date) strict {
    label en official "PARTIAL: the duty to approve arises when the criteria are satisfied; the outer 225-day limit of clause (iii) is the second duty";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and application_criteria_satisfied_432e9Gi(plan)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and secretary_431(secretary);
    then duty ApproveSuspensionApplicationDuty {
        bearer secretary;
        beneficiary sponsor;
        goal achievement {
            condition application_approved_432e9Gi(plan);
            window [applied, add_calendar_period(applied, 225 calendar_day)];
        }
    };
}

pub relation federal_register_notice_published_432e9Gii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has published a notice in the Federal Register soliciting comments on the application, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Not later than 30 days after receipt of the application under clause (i), the Secretary of the Treasury")
rule PublishCommentNoticeDuty432e9Gii(plan: MultiemployerPlan, secretary: Person, applied: Date) strict {
    label en official "exact: the notice is due within 30 calendar days after receipt";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and secretary_431(secretary);
    then duty PublishSuspensionCommentNoticeDuty {
        bearer secretary;
        goal achievement {
            condition federal_register_notice_published_432e9Gii(plan);
            window [applied, add_calendar_period(applied, 30 calendar_day)];
        }
    };
}

pub relation secretary_decided_application_432e9Giii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has approved or denied the application, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall approve or deny any application for suspensions of benefits under this paragraph within 225 days after the submission of such application")
rule DecideApplicationWithin225DaysDuty432e9Giii(plan: MultiemployerPlan, secretary: Person, applied: Date) strict {
    label en official "exact: within 225 calendar days after submission; day 225 is still in time";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and secretary_431(secretary);
    then duty DecideSuspensionApplicationDuty {
        bearer secretary;
        goal achievement {
            condition secretary_decided_application_432e9Giii(plan);
            window [applied, add_calendar_period(applied, 225 calendar_day)];
        }
    };
}

pub relation secretary_notified_failure_of_criteria_on_432e9Giii(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the Secretary notifies the plan sponsor that it has failed to satisfy one or more of the criteria, case-asserted";
}

pub relation application_evaluated_on_432e9G(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date on which the status of the application is evaluated, case-asserted";
}

pub relation failure_notified_within_225_days_432e9Giii(plan: MultiemployerPlan) kind institutional {
    label en official "helper: the Secretary notified the sponsor of a failure within 225 days after the submission";
}

rule FailureNotifiedWithin225Days432e9Giii(plan: MultiemployerPlan, applied: Date, notified: Date) strict {
    label en official "exact boundary: a notice on day 225 is within the period";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and secretary_notified_failure_of_criteria_on_432e9Giii(plan, notified)
        and notified <= add_calendar_period(applied, 225 calendar_day);
    then failure_notified_within_225_days_432e9Giii(plan);
}

pub relation application_deemed_approved_432e9Giii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(G)(iii): an application is deemed approved unless, within the 225 days, the Secretary notifies the sponsor of a failure to satisfy the criteria";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "An application for suspension of benefits shall be deemed approved unless, within such 225 days, the Secretary of the Treasury notifies the plan sponsor that it has failed to satisfy one or more of the criteria")
rule ApplicationDeemedApproved432e9Giii(plan: MultiemployerPlan, applied: Date, on: Date) strict {
    label en official "exact boundary: deemed approved only after day 225 has passed without a timely notice";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and application_evaluated_on_432e9G(plan, on)
        and on > add_calendar_period(applied, 225 calendar_day)
        and not_known(failure_notified_within_225_days_432e9Giii(plan));
    then application_deemed_approved_432e9Giii(plan);
}

pub relation application_approved_or_deemed_approved_432e9G(plan: MultiemployerPlan) kind institutional {
    label en official "the application is approved by the Secretary or deemed approved";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Approval or denial by the Secretary of the Treasury")
rule ApplicationApprovedByDecision432e9G(plan: MultiemployerPlan) strict {
    label en official "express approval";
    when application_approved_432e9Gi(plan);
    then application_approved_or_deemed_approved_432e9G(plan);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall be deemed approved unless")
rule ApplicationApprovedByDeeming432e9G(plan: MultiemployerPlan) strict {
    label en official "deemed approval";
    when application_deemed_approved_432e9Giii(plan);
    then application_approved_or_deemed_approved_432e9G(plan);
}

pub relation rejection_notice_with_specific_reasons_432e9Giii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary's notice of rejection details the specific reasons, including reference to the specific requirement not satisfied, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the Secretary of the Treasury shall provide notice to the plan sponsor detailing the specific reasons for the rejection, including reference to the specific requirement not satisfied")
rule RejectionNoticeDuty432e9Giii(plan: MultiemployerPlan, secretary: Person, sponsor: Person, notified: Date) strict {
    label en official "a rejection carries a duty to state the specific reasons";
    when secretary_notified_failure_of_criteria_on_432e9Giii(plan, notified)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and secretary_431(secretary);
    then duty RejectionNoticeWithReasonsDuty {
        bearer secretary;
        beneficiary sponsor;
        goal maintenance {
            condition rejection_notice_with_specific_reasons_432e9Giii(plan);
            window [notified, infinity];
        }
    };
}

pub relation approval_or_denial_final_agency_action_432e9Giii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(G)(iii): approval or denial is final agency action for purposes of 5 U.S.C. 704";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall be treated as final agency action for purposes of section 704 of title 5, United States Code")
rule ApprovalOrDenialFinalAgencyAction432e9Giii(plan: MultiemployerPlan) strict {
    label en official "an express decision is final agency action";
    when secretary_decided_application_432e9Giii(plan);
    then approval_or_denial_final_agency_action_432e9Giii(plan);
}

pub relation secretary_reviewed_sponsor_factor_consideration_432e9Giv(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has reviewed the plan sponsor's consideration of the factors under clause (ii) of subparagraph (C), case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "shall review the plan sponsor's consideration of factors under such clause")
rule ReviewSponsorFactorsDuty432e9Giv(plan: MultiemployerPlan, secretary: Person, applied: Date) strict {
    label en official "PARTIAL/JUDGMENT: the statute gives no date; the review belongs to the evaluation, so the window is the 225-day decision period of clause (iii)";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and secretary_431(secretary);
    then duty ReviewSponsorFactorsDuty {
        bearer secretary;
        goal achievement {
            condition secretary_reviewed_sponsor_factor_consideration_432e9Giv(plan);
            window [applied, add_calendar_period(applied, 225 calendar_day)];
        }
    };
}

external judgment relation sponsor_determinations_clearly_erroneous_432e9Gv(plan: MultiemployerPlan) {
    authority Secretary;
    label en official "the plan sponsor's determinations were clearly erroneous, as the Secretary of the Treasury concludes in consultation with the PBGC and the Secretary of Labor (section 432(e)(9)(G)(v)) — an evaluative determination not computed by this package";
}

pub relation sponsor_determinations_accepted_432e9Gv(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(G)(v): the Secretary accepts the plan sponsor's determinations unless it concludes they were clearly erroneous";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the Secretary of the Treasury shall accept the plan sponsor's determinations unless it concludes")
rule SponsorDeterminationsAccepted432e9Gv(plan: MultiemployerPlan, applied: Date) strict {
    label en official "the default standard of review; an external judgment of clear error withdraws it";
    when suspension_application_submitted_on_432e9G(plan, applied)
        and not_known(sponsor_determinations_clearly_erroneous_432e9Gv(plan));
    then sponsor_determinations_accepted_432e9Gv(plan);
}

// =====================================================================
// (H) Participant ratification: the vote
// =====================================================================

pub relation approval_of_suspension_on_432e9Hii(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the Secretary of the Treasury approves the suspension under subparagraph (G), case-asserted";
}

pub relation participant_vote_administered_432e9Hii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has administered the vote of participants and beneficiaries, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Not later than 30 days after approval of the suspension by the Secretary of the Treasury")
rule AdministerVoteDuty432e9Hii(plan: MultiemployerPlan, secretary: Person, approved: Date) strict {
    label en official "exact: within 30 calendar days after approval";
    when approval_of_suspension_on_432e9Hii(plan, approved)
        and secretary_431(secretary);
    then duty AdministerSuspensionVoteDuty {
        bearer secretary;
        goal achievement {
            condition participant_vote_administered_432e9Hii(plan);
            window [approved, add_calendar_period(approved, 30 calendar_day)];
        }
    };
}

pub relation vote_counts_432e9Hii(plan: MultiemployerPlan, reject: Integer, total: Integer) kind empirical {
    label en unofficial "the number of participants and beneficiaries voting to reject the suspension, and the total number of all participants and beneficiaries of the plan, case-asserted";
}

pub relation vote_rejects_suspension_432e9Hii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(H)(ii): a majority of all participants and beneficiaries of the plan vote to reject the suspension";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "unless a majority of all participants and beneficiaries of the plan vote to reject the suspension")
rule VoteRejectsSuspension432e9Hii(plan: MultiemployerPlan, reject: Integer, total: Integer) strict {
    label en official "exact integer test: strictly more than half of ALL participants and beneficiaries (a tie is not a majority)";
    when vote_counts_432e9Hii(plan, reject, total) and reject * 2 > total;
    then vote_rejects_suspension_432e9Hii(plan);
}

pub relation vote_held_and_not_rejecting_432e9H(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(H)(i), (ii): the vote was held and a majority did not vote to reject the suspension, so the suspension goes into effect following the vote";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the suspension shall go into effect following the vote unless a majority of all participants and beneficiaries of the plan vote to reject the suspension")
rule VoteHeldAndNotRejecting432e9H(plan: MultiemployerPlan, reject: Integer, total: Integer) strict {
    label en official "exact: half or fewer of all participants and beneficiaries voting to reject";
    when vote_counts_432e9Hii(plan, reject, total) and reject * 2 <= total;
    then vote_held_and_not_rejecting_432e9H(plan);
}

pub relation new_application_allowed_after_rejecting_vote_432e9Hii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(H)(ii) last sentence: the sponsor may submit a new application when a vote prohibits the suspension from taking effect";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The plan sponsor may submit a new suspension application to the Secretary of the Treasury for approval in any case in which a suspension is prohibited from taking effect pursuant to a vote")
rule NewApplicationAllowed432e9Hii(plan: MultiemployerPlan) strict {
    label en official "a rejecting vote permits a new application";
    when vote_rejects_suspension_432e9Hii(plan);
    then new_application_allowed_after_rejecting_vote_432e9Hii(plan);
}

pub relation ballot_statement_sponsor_support_432e9Hiii1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement from the plan sponsor in support of the suspension, case-asserted";
}

pub relation ballot_statement_opposition_432e9Hiii2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement in opposition compiled from the comments received under (G)(ii), case-asserted";
}

pub relation ballot_statement_secretary_approved_432e9Hiii3(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement that the Secretary of the Treasury approved the suspension, case-asserted";
}

pub relation ballot_statement_insolvent_without_suspension_432e9Hiii4(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement that the sponsor determined the plan will become insolvent unless the suspension takes effect, case-asserted";
}

pub relation ballot_statement_plan_insolvency_lower_benefits_432e9Hiii5(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement that insolvency of the plan could result in benefits lower than under the suspension, case-asserted";
}

pub relation ballot_statement_pbgc_insolvency_lower_benefits_432e9Hiii6(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the ballot has a statement that insolvency of the PBGC would result in benefits lower than in the case of plan insolvency, case-asserted";
}

pub relation ballot_content_complete_432e9Hiii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(H)(iii): the ballot includes the six required statements";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The plan sponsor shall provide a ballot for the vote")
rule BallotContentComplete432e9Hiii(plan: MultiemployerPlan) strict {
    label en official "statements (I) to (VI) together";
    when ballot_statement_sponsor_support_432e9Hiii1(plan)
        and ballot_statement_opposition_432e9Hiii2(plan)
        and ballot_statement_secretary_approved_432e9Hiii3(plan)
        and ballot_statement_insolvent_without_suspension_432e9Hiii4(plan)
        and ballot_statement_plan_insolvency_lower_benefits_432e9Hiii5(plan)
        and ballot_statement_pbgc_insolvency_lower_benefits_432e9Hiii6(plan);
    then ballot_content_complete_432e9Hiii(plan);
}

pub relation rejecting_vote_on_432e9Hv(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date of a vote rejecting the suspension, case-asserted";
}

pub relation vote_results_certified_on_432e9Hv(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the results of the vote are certified, case-asserted";
}

pub relation systemic_importance_determined_432e9Hv1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has determined whether the plan is a systemically important plan, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Not later than 14 days after a vote under this subparagraph rejecting a suspension")
rule DetermineSystemicImportanceDuty432e9Hv1(plan: MultiemployerPlan, secretary: Person, voted: Date) strict {
    label en official "exact: within 14 calendar days after a rejecting vote";
    when rejecting_vote_on_432e9Hv(plan, voted)
        and vote_rejects_suspension_432e9Hii(plan)
        and secretary_431(secretary);
    then duty DetermineSystemicImportanceDuty {
        bearer secretary;
        goal achievement {
            condition systemic_importance_determined_432e9Hv1(plan);
            window [voted, add_calendar_period(voted, 14 calendar_day)];
        }
    };
}

pub relation secretary_permits_implementation_432e9Hv1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary permits the implementation of the sponsor's suspension or of a Treasury modification of it, notwithstanding the adverse vote, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "not later than the end of the 90-day period beginning on the date the results of the vote are certified")
rule PermitImplementationDuty432e9Hv1(plan: MultiemployerPlan, secretary: Person, certified: Date) strict {
    label en official "exact: the 90-day period begins on the certification date, so its last day is 89 days after it";
    when systemically_important_plan_432(plan)
        and vote_rejects_suspension_432e9Hii(plan)
        and vote_results_certified_on_432e9Hv(plan, certified)
        and secretary_431(secretary);
    then duty PermitImplementationOfSuspensionDuty {
        bearer secretary;
        goal achievement {
            condition secretary_permits_implementation_432e9Hv1(plan);
            window [certified, add_calendar_period(certified, 89 calendar_day)];
        }
    };
}

pub relation advocate_recommendations_submitted_432e9Hv2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Participant and Plan Sponsor Advocate submits recommendations on the suspension or its revision, case-asserted (exercise atom)";
}

pub relation systemic_importance_determined_on_432e9Hv2(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the Secretary determines that the plan is systemically important, case-asserted";
}

pub relation participant_and_plan_sponsor_advocate_432e9Hv2(advocate: Person) kind empirical {
    label en unofficial "the Participant and Plan Sponsor Advocate selected under ERISA section 4004, case-asserted";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may submit recommendations to the Secretary of the Treasury with respect to the suspension or any revisions to the suspension")
rule AdvocateRecommendationsLiberty432e9Hv2(plan: MultiemployerPlan, advocate: Person, secretary: Person, determined: Date) strict {
    label en official "exact: a liberty to recommend within 30 calendar days after the determination";
    when systemic_importance_determined_on_432e9Hv2(plan, determined)
        and participant_and_plan_sponsor_advocate_432e9Hv2(advocate)
        and secretary_431(secretary);
    then liberty AdvocateRecommendationsLiberty {
        holder advocate;
        against secretary;
        action advocate_recommendations_submitted_432e9Hv2(plan);
        window [determined, add_calendar_period(determined, 30 calendar_day)];
    };
}

pub relation vote_held_on_432e9Hvi(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date of the vote following which the suspension goes into effect, case-asserted";
}

pub relation final_authorization_issued_432e9Hvi(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has issued a final authorization to suspend, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "shall issue a final authorization to suspend with respect to the suspension not later than 7 days after such vote")
rule FinalAuthorizationDuty432e9Hvi(plan: MultiemployerPlan, secretary: Person, voted: Date) strict {
    label en official "PARTIAL: the 7-day rule after a vote; the systemically-important branch is timed by the 90-day period and is not a separate window";
    when vote_held_on_432e9Hvi(plan, voted)
        and vote_held_and_not_rejecting_432e9H(plan)
        and secretary_431(secretary);
    then duty IssueFinalAuthorizationDuty {
        bearer secretary;
        goal achievement {
            condition final_authorization_issued_432e9Hvi(plan);
            window [voted, add_calendar_period(voted, 7 calendar_day)];
        }
    };
}

// Assembly of the gates of (A): the suspension may take effect

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "No suspension of benefits may take effect pursuant to this paragraph prior to a vote of the participants of the plan with respect to the suspension")
rule SuspensionMayTakeEffectAfterVote432e9(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: the conditions of (C)(iii)-(vi) and (D) beyond the modelled floors are not gated";
    when critical_and_declining_status_432b6(plan, y)
        and suspension_conditions_met_432e9c(plan, y)
        and suspension_notice_requirements_met_432e9F(plan)
        and application_approved_or_deemed_approved_432e9G(plan)
        and vote_held_and_not_rejecting_432e9H(plan);
    then suspension_may_take_effect_432e9(plan, y);
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "notwithstanding such adverse vote")
rule SuspensionMayTakeEffectDespiteVote432e9Hv(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: a systemically important plan may implement the suspension notwithstanding an adverse vote when the Secretary permits it";
    when critical_and_declining_status_432b6(plan, y)
        and suspension_conditions_met_432e9c(plan, y)
        and suspension_notice_requirements_met_432e9F(plan)
        and application_approved_or_deemed_approved_432e9G(plan)
        and systemically_important_plan_432(plan)
        and vote_rejects_suspension_432e9Hii(plan)
        and secretary_permits_implementation_432e9Hv1(plan);
    then suspension_may_take_effect_432e9(plan, y);
}

// =====================================================================
// (I) Judicial review
// =====================================================================

pub relation action_filed_on_432e9I(suit: Integer, on: Date) kind empirical {
    label en unofficial "the date the action is brought, case-asserted";
}

pub relation application_denied_on_432e9Ii(suit: Integer, on: Date) kind empirical {
    label en unofficial "the date the Secretary denied the application challenged by the action, case-asserted";
}

pub relation final_authorization_on_432e9Iii(suit: Integer, on: Date) kind empirical {
    label en unofficial "the date of the final authorization to suspend challenged by the action, case-asserted";
}

pub relation action_challenges_denial_432e9Ii(suit: Integer) kind empirical {
    label en unofficial "the action is brought by the plan sponsor challenging the denial of an application, case-asserted";
}

pub relation action_challenges_suspension_432e9Iii(suit: Integer) kind empirical {
    label en unofficial "the action challenges a suspension of benefits, case-asserted";
}

pub relation challenge_action_timely_432e9I(suit: Integer) kind institutional {
    label en official "section 432(e)(9)(I)(i), (ii)(I): an action challenging a denial may be brought only following the denial, and an action challenging a suspension only following the final authorization";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may only be brought following such denial")
rule DenialChallengeAfterDenial432e9Ii(suit: Integer, filed: Date, denied: Date) strict {
    label en official "exact: not before the denial date";
    when action_challenges_denial_432e9Ii(suit)
        and action_filed_on_432e9I(suit, filed)
        and application_denied_on_432e9Ii(suit, denied)
        and filed >= denied;
    then challenge_action_timely_432e9I(suit);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may only be brought following a final authorization to suspend")
rule SuspensionChallengeAfterFinalAuthorization432e9Iii(suit: Integer, filed: Date, authorized: Date) strict {
    label en official "exact: not before the final authorization date";
    when action_challenges_suspension_432e9Iii(suit)
        and action_filed_on_432e9I(suit, filed)
        and final_authorization_on_432e9Iii(suit, authorized)
        and filed >= authorized;
    then challenge_action_timely_432e9I(suit);
}

pub relation court_finds_clear_and_convincing_likelihood_432e9Iiibb(suit: Integer) kind empirical {
    label en unofficial "the court finds a clear and convincing likelihood that the plaintiff will prevail on the merits, case-asserted";
}

pub relation court_grants_temporary_injunction_432e9Iiibb(court: Person, suit: Integer) kind empirical {
    label en unofficial "the court grants a temporary injunction with respect to the suspension, case-asserted (action atom)";
}

pub relation reviewing_court_of_action_432e9I(court: Person, suit: Integer) kind empirical {
    label en unofficial "this court reviews an action challenging a suspension of benefits, case-asserted";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may not grant a temporary injunction with respect to such suspension unless the court finds a clear and convincing likelihood that the plaintiff will prevail on the merits of the case")
rule NoTemporaryInjunctionWithoutFinding432e9Iiibb(court: Person, suit: Integer) strict {
    label en official "the court is forbidden to grant a temporary injunction unless it finds a clear and convincing likelihood of success; with the finding the prohibition does not arise";
    when reviewing_court_of_action_432e9I(court, suit)
        and action_challenges_suspension_432e9Iii(suit)
        and not_known(court_finds_clear_and_convincing_likelihood_432e9Iiibb(suit));
    then prohibition GrantTemporaryInjunctionProhibition {
        bearer court;
        action court_grants_temporary_injunction_432e9Iiibb(court, suit);
        window [-infinity, infinity];
    };
}

pub relation participant_affected_by_suspension_432e9Iiii(participant: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the participant or beneficiary is affected by a benefit suspension under this paragraph, case-asserted";
}

pub relation participant_has_no_cause_of_action_under_this_title_432e9Iiii(participant: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(I)(iii): an affected participant or beneficiary has no cause of action under this title";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall not have a cause of action under this title")
rule NoCauseOfActionUnderThisTitle432e9Iiii(participant: Person, plan: MultiemployerPlan) strict {
    label en official "a restriction on the affected participant's action under this title (the ERISA claims are outside this title)";
    when participant_affected_by_suspension_432e9Iiii(participant, plan);
    then participant_has_no_cause_of_action_under_this_title_432e9Iiii(participant, plan);
}

pub relation earliest_knowledge_of_cause_of_action_432e9Iiv(suit: Integer, on: Date) kind empirical {
    label en unofficial "the earliest date on which the plaintiff acquired or should have acquired actual knowledge of the cause of action, case-asserted";
}

pub relation challenge_action_time_barred_432e9Iiv(suit: Integer) kind institutional {
    label en official "section 432(e)(9)(I)(iv): no action may be brought after one year after the earliest date of actual knowledge";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may be brought after one year after the earliest date on which the plaintiff acquired or should have acquired actual knowledge of the existence of such cause of action")
rule ChallengeActionTimeBarred432e9Iiv(suit: Integer, filed: Date, knew: Date) strict {
    label en official "exact boundary: an action filed on the first anniversary of knowledge is still in time; one day later it is barred";
    when action_filed_on_432e9I(suit, filed)
        and earliest_knowledge_of_cause_of_action_432e9Iiv(suit, knew)
        and filed > add_calendar_period(knew, 1 calendar_year);
    then challenge_action_time_barred_432e9Iiv(suit);
}

// =====================================================================
// (J) Special rule for emergence from critical status
// =====================================================================

pub relation suspension_made_by_sponsor_432e9J(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan was certified in critical and declining status and the sponsor has made a suspension of benefits, case-asserted";
}

pub relation no_longer_certified_critical_or_endangered_432e9Ji(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is no longer certified to be in critical or endangered status under paragraphs (1) and (2) of subsection (b), case-asserted";
}

pub relation projected_to_avoid_insolvency_432e9Jii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is projected to avoid insolvency under section 418E, case-asserted";
}

pub relation emergence_permitted_after_suspension_432e9J(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(9)(J)(i), (ii): the plan is no longer certified critical or endangered and is projected to avoid insolvency";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the plan is projected to avoid insolvency under section 418E")
rule EmergencePermittedAfterSuspension432e9J(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(i) and (ii) together";
    when no_longer_certified_critical_or_endangered_432e9Ji(plan, y)
        and projected_to_avoid_insolvency_432e9Jii(plan, y);
    then emergence_permitted_after_suspension_432e9J(plan, y);
}

pub relation emergence_blocked_by_suspension_432e9J(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(9)(J): the plan shall not emerge from critical status under paragraph (4)(B) while (i) and (ii) are not both met";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall not emerge from critical status under paragraph (4)(B), until such time as")
rule EmergenceBlockedBySuspension432e9J(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "blocked after a suspension unless both conditions hold";
    when suspension_made_by_sponsor_432e9J(plan, y)
        and not_known(emergence_permitted_after_suspension_432e9J(plan, y));
    then emergence_blocked_by_suspension_432e9J(plan, y);
}
