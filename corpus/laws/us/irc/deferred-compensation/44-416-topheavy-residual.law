// Section 416 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 14 carries the key employee tests, the single-plan top-heavy tests and the 3
// percent minimum contribution. This module adds (b) the top-heavy vesting
// schedules, (c)(1) the defined benefit minimum benefit, (c)(2)(B) the cap by
// the highest key employee rate, (g)(2)(B) the top-heavy group test, (g)(3)
// the distribution look-back, (g)(4) the special rules for rollovers, former
// key employees, the determination date, inactive individuals, SIMPLE and
// safe harbor plans.
//
// Method: percentages are exact integer or fraction comparisons; the 60
// percent test is an exact cross-multiplication; amounts are exact Money.

// =====================================================================
// (b) Top-heavy vesting
// =====================================================================

use self::{
    DefinedContributionPlan,
    IRC_S416_B,
    IRC_S416_C,
    IRC_S416_G,
    Person,
    Plan,
    TaxableYear,
};

pub relation top_heavy_years_of_service_416b(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the employee's years of service with the employer, case-asserted (section 416(b))";
}

pub relation top_heavy_vesting_choice_416b1(plan: Plan, choice: TopHeavyVestingSchedule416) kind empirical {
    label en unofficial "the vesting schedule the top-heavy plan uses, case-asserted";
}

pub enum TopHeavyVestingSchedule416 {
    ThreeYearCliff;
    TwoToSixGraded;
}

pub relation top_heavy_minimum_nonforfeitable_percentage_416b1(employee: Person, plan: Plan, pct: Decimal) kind institutional {
    label en official "section 416(b)(1): the least nonforfeitable percentage a top-heavy plan must give under the schedule it uses";
}

@source(IRC_S416_B, relation = formalizes, coverage = exact, quote = "an employee who has completed at least 3 years of service with the employer or employers maintaining the plan has a nonforfeitable right to 100 percent of his accrued benefit derived from employer contributions")
rule TopHeavyCliff3OrMore416b1A(employee: Person, plan: Plan, years: Integer) strict {
    label en official "(A): 3 or more years: 100 percent";
    when top_heavy_vesting_choice_416b1(plan, ThreeYearCliff) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 3;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 1.0);
}

rule TopHeavyCliffUnder3416b1A(employee: Person, plan: Plan, years: Integer) strict {
    label en official "(A): fewer than 3 years: no minimum";
    when top_heavy_vesting_choice_416b1(plan, ThreeYearCliff) and top_heavy_years_of_service_416b(employee, plan, years) and years < 3;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.0);
}

@source(IRC_S416_B, relation = formalizes, coverage = partial, quote = "has a nonforfeitable right to a percentage of his accrued benefit derived from employer contributions determined under the following table")
rule TopHeavyGraded1Year416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) table, years under 2: 0 percent (the table body is not carried in the pinned text; the 2-to-6 schedule of section 411(a)(2)(B)(iii) is used)";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years < 2;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.0);
}

rule TopHeavyGraded2Years416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) 2 years: 20 percent";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 2 and years < 3;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.20);
}

rule TopHeavyGraded3Years416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) 3 years: 40 percent";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 3 and years < 4;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.40);
}

rule TopHeavyGraded4Years416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) 4 years: 60 percent";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 4 and years < 5;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.60);
}

rule TopHeavyGraded5Years416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) 5 years: 80 percent";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 5 and years < 6;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 0.80);
}

rule TopHeavyGraded6Years416b1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "PARTIAL: (B) 6 or more years: 100 percent";
    when top_heavy_vesting_choice_416b1(plan, TwoToSixGraded) and top_heavy_years_of_service_416b(employee, plan, years) and years >= 6;
    then top_heavy_minimum_nonforfeitable_percentage_416b1(employee, plan, 1.0);
}

// =====================================================================
// (c)(1) Defined benefit minimum benefit; (c)(2)(B) cap of the minimum contribution
// =====================================================================

pub relation nonkey_years_of_service_416c1(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the years of service with the employer taken into account, case-asserted (section 416(c)(1)(C))";
}

pub relation nonkey_average_compensation_testing_period_416c1(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the participant's average compensation for the years of the testing period (up to 5 consecutive years of greatest aggregate compensation), case-asserted ((c)(1)(A), (D))";
}

pub relation db_minimum_applicable_percentage_416c1B(employee: Person, plan: Plan, pct: Decimal) kind institutional {
    label en official "section 416(c)(1)(B): the applicable percentage is the lesser of 2 percent times the years of service and 20 percent";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"applicable percentage\" means the lesser of")
rule DbMinimumApplicablePercentage416c1B(employee: Person, plan: Plan, years: Integer) strict {
    label en official "min(0.02 x years, 0.20), exact";
    when nonkey_years_of_service_416c1(employee, plan, years);
    then db_minimum_applicable_percentage_416c1B(employee, plan, min(years * 0.02, 0.20));
}

pub relation db_minimum_annual_retirement_benefit_416c1(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 416(c)(1)(A): the minimum annual retirement benefit is the applicable percentage of average compensation";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "is not less than the applicable percentage of the participant's average compensation for years in the testing period")
rule DbMinimumAnnualRetirementBenefit416c1(employee: Person, plan: Plan, pct: Decimal, avg: Money) strict {
    label en official "percentage x average compensation, rounded to the cent";
    when db_minimum_applicable_percentage_416c1B(employee, plan, pct) and nonkey_average_compensation_testing_period_416c1(employee, plan, avg);
    then db_minimum_annual_retirement_benefit_416c1(employee, plan, round(avg * pct, 2, "HALF_UP"));
}

pub relation nonkey_accrued_annual_benefit_416c1(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the non-key employee's accrued benefit derived from employer contributions, expressed as an annual retirement benefit, case-asserted";
}

pub relation db_minimum_benefit_met_416c1(employee: Person, plan: Plan) kind institutional {
    label en official "section 416(c)(1)(A): the accrued benefit is not less than the minimum annual retirement benefit";
}

@source(IRC_S416_C, relation = formalizes, coverage = exact, quote = "is not less than the applicable percentage of the participant's average compensation")
rule DbMinimumBenefitMet416c1(employee: Person, plan: Plan, accrued: Money, minimum: Money) strict {
    label en official "exact boundary: accrued equal to the minimum meets it";
    when nonkey_accrued_annual_benefit_416c1(employee, plan, accrued) and db_minimum_annual_retirement_benefit_416c1(employee, plan, minimum) and accrued >= minimum;
    then db_minimum_benefit_met_416c1(employee, plan);
}

pub relation highest_key_employee_contribution_rate_416c2B(plan: DefinedContributionPlan, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the percentage at which contributions are made (or required) for the key employee for whom the percentage is highest for the year, as a fraction, case-asserted (section 416(c)(2)(B)(i))";
}

pub relation minimum_contribution_percentage_416c2(plan: DefinedContributionPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 416(c)(2)(A), (B)(i): 3 percent, but not more than the highest key employee contribution rate";
}

@source(IRC_S416_C, relation = formalizes, coverage = partial, quote = "The percentage referred to in subparagraph (A) for any year shall not exceed the percentage at which contributions are made (or required to be made) under the plan for the year for the key employee for whom such percentage is the highest for the year")
rule MinimumContributionPercentage416c2(plan: DefinedContributionPlan, y: TaxableYear, key_rate: Decimal) strict {
    label en official "PARTIAL: min(0.03, highest key employee rate); the aggregation group limit of (B)(ii) is not derived";
    when highest_key_employee_contribution_rate_416c2B(plan, y, key_rate);
    then minimum_contribution_percentage_416c2(plan, y, min(0.03, key_rate));
}

// =====================================================================
// (g)(2)(B) Top-heavy group; (g)(3) distributions look-back
// =====================================================================

pub relation aggregation_group_key_sum_416g2B(group: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum, as of the determination date, of the present value of the cumulative accrued benefits for key employees under the defined benefit plans and the accounts of key employees under the defined contribution plans of the group, case-asserted (section 416(g)(2)(B)(i))";
}

pub relation aggregation_group_all_sum_416g2B(group: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the similar sum determined for all employees, case-asserted ((B)(ii))";
}

pub relation top_heavy_group_416g2B(group: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(g)(2)(B): an aggregation group whose key employee sum exceeds 60 percent of the sum for all employees";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "exceeds 60 percent of a similar sum determined for all employees")
rule TopHeavyGroup416g2B(group: Plan, y: TaxableYear, key: Money, all: Money) strict {
    label en official "exact boundary by cross-multiplication: key x 100 > all x 60 (exactly 60 percent is not top-heavy)";
    when aggregation_group_key_sum_416g2B(group, y, key) and aggregation_group_all_sum_416g2B(group, y, all) and key * 100.0 > all * 60.0;
    then top_heavy_group_416g2B(group, y);
}

pub relation plan_required_in_aggregation_group_416g1B(plan: Plan, group: Plan) kind empirical {
    label en unofficial "the plan is required to be included in the aggregation group, case-asserted";
}

pub relation plan_treated_as_top_heavy_by_group_416g1B(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(g)(1)(B): each plan required to be in the aggregation group is treated as top-heavy if the group is a top-heavy group";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "Each plan of an employer required to be included in an aggregation group shall be treated as a top-heavy plan if such group is a top-heavy group")
rule PlanTreatedAsTopHeavyByGroup416g1B(plan: Plan, group: Plan, y: TaxableYear) strict {
    label en official "the group's status passes to its required members";
    when plan_required_in_aggregation_group_416g1B(plan, group) and top_heavy_group_416g2B(group, y);
    then plan_treated_as_top_heavy_by_group_416g1B(plan, y);
}

pub enum DistributionReason416 {
    SeveranceDeathOrDisability;
    OtherReason;
}

pub relation employee_amount_and_distributions_416g3(employee: Person, plan: Plan, y: TaxableYear, amount: Money, dist_1yr: Money, dist_5yr: Money, reason: DistributionReason416) kind empirical {
    label en unofficial "the present value of the cumulative accrued benefit or the account, the distributions in the 1-year period and in the 5-year period ending on the determination date, and the reason for the distributions, case-asserted (section 416(g)(3))";
}

pub relation top_heavy_amount_with_distributions_416g3(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 416(g)(3): the present value or account is increased by distributions in the 1-year period ending on the determination date (5 years for a distribution for a reason other than severance, death or disability)";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "such present value or amount shall be increased by the aggregate distributions made with respect to such employee under the plan during the 1-year period ending on the determination date")
rule TopHeavyAmountWithDistributions1Year416g3A(employee: Person, plan: Plan, y: TaxableYear, amount: Money, d1: Money, d5: Money) strict {
    label en official "amount + 1-year distributions";
    when employee_amount_and_distributions_416g3(employee, plan, y, amount, d1, d5, SeveranceDeathOrDisability);
    then top_heavy_amount_with_distributions_416g3(employee, plan, y, amount + d1);
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "In the case of any distribution made for a reason other than severance from employment, death, or disability, subparagraph (A) shall be applied by substituting \"5-year period\" for \"1-year period\"")
rule TopHeavyAmountWithDistributions5Year416g3B(employee: Person, plan: Plan, y: TaxableYear, amount: Money, d1: Money, d5: Money) strict {
    label en official "amount + 5-year distributions";
    when employee_amount_and_distributions_416g3(employee, plan, y, amount, d1, d5, OtherReason);
    then top_heavy_amount_with_distributions_416g3(employee, plan, y, amount + d5);
}

// =====================================================================
// (g)(4) Special rules
// =====================================================================

pub relation rollover_initiated_by_employee_after_1983_416g4A(plan: Plan, employee: Person) kind empirical {
    label en unofficial "a rollover contribution or similar transfer initiated by the employee and made after December 31, 1983 to the plan, case-asserted (section 416(g)(4)(A))";
}

pub relation rollover_excluded_from_top_heavy_416g4A(plan: Plan, employee: Person) kind institutional {
    label en official "section 416(g)(4)(A): such a rollover is not taken into account for the transferee plan's top-heavy tests";
}

@source(IRC_S416_G, relation = formalizes, coverage = partial, quote = "shall not be taken into account with respect to the transferee plan for purposes of determining whether such plan is a top-heavy plan")
rule RolloverExcludedFromTopHeavy416g4A(plan: Plan, employee: Person) strict {
    label en official "PARTIAL: except as regulations provide";
    when rollover_initiated_by_employee_after_1983_416g4A(plan, employee);
    then rollover_excluded_from_top_heavy_416g4A(plan, employee);
}

pub relation individual_key_employee_in_prior_year_416g4B(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the individual was a key employee with respect to the plan for a prior plan year, case-asserted (section 416(g)(4)(B))";
}

pub relation individual_nonkey_this_year_416g4B(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the individual is a non-key employee for the plan year, case-asserted";
}

pub relation former_key_employee_benefit_excluded_416g4B(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 416(g)(4)(B): the accrued benefit or account of a non-key employee who was a key employee in a prior year is not taken into account";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "any accrued benefit for such employee (and the account of such employee) shall not be taken into account")
rule FormerKeyEmployeeBenefitExcluded416g4B(employee: Person, plan: Plan, y: TaxableYear) strict {
    label en official "current non-key employee who was a key employee earlier";
    when individual_nonkey_this_year_416g4B(employee, plan, y) and individual_key_employee_in_prior_year_416g4B(employee, plan);
    then former_key_employee_benefit_excluded_416g4B(employee, plan, y);
}

pub relation plan_year_last_day_416g4C(plan: Plan, y: TaxableYear, last_day: Date) kind empirical {
    label en unofficial "the last day of the plan year, case-asserted";
}

pub relation preceding_plan_year_last_day_416g4C(plan: Plan, y: TaxableYear, last_day: Date) kind empirical {
    label en unofficial "the last day of the preceding plan year, case-asserted";
}

pub relation first_plan_year_416g4C(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year is the first plan year of the plan, case-asserted";
}

pub relation determination_date_416g4C(plan: Plan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 416(g)(4)(C): the last day of the preceding plan year, or the last day of the first plan year";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "the last day of the preceding plan year")
rule DeterminationDatePreceding416g4C(plan: Plan, y: TaxableYear, last_day: Date) strict {
    label en official "(i) for a plan year that is not the first";
    when preceding_plan_year_last_day_416g4C(plan, y, last_day) and not_known(first_plan_year_416g4C(plan, y));
    then determination_date_416g4C(plan, y, last_day);
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "in the case of the first plan year of any plan, the last day of such plan year")
rule DeterminationDateFirstYear416g4C(plan: Plan, y: TaxableYear, last_day: Date) strict {
    label en official "(ii) for the first plan year";
    when plan_year_last_day_416g4C(plan, y, last_day) and first_plan_year_416g4C(plan, y);
    then determination_date_416g4C(plan, y, last_day);
}

pub relation individual_last_service_date_416g4E(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the last date the individual performed services for the employer, case-asserted (section 416(g)(4)(E))";
}

pub relation determination_date_for_individual_416g4E(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the determination date, case-asserted";
}

pub relation inactive_individual_benefit_excluded_416g4E(employee: Person, plan: Plan) kind institutional {
    label en official "section 416(g)(4)(E): the benefit of an individual who performed no services in the 1-year period ending on the determination date is not taken into account";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "has not performed services for the employer maintaining the plan at any time during the 1-year period ending on the determination date")
rule InactiveIndividualBenefitExcluded416g4E(employee: Person, plan: Plan, last_service: Date, determination: Date, calendar_before_1: Date) strict {
    label en official "exact boundary: the 1-year period ends on the determination date; services on the day one year before are inside the period only if after the start (services on or before the day one year earlier are outside)";
    when individual_last_service_date_416g4E(employee, plan, last_service)
        and determination_date_for_individual_416g4E(employee, plan, determination)
        and last_service <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(determination, 1, us.irc.core::CalendarYear, calendar_before_1);
    then inactive_individual_benefit_excluded_416g4E(employee, plan);
}

pub relation plan_is_simple_retirement_account_416g4G(plan: Plan) kind empirical {
    label en unofficial "the plan is a simple retirement account under section 408(p), case-asserted";
}

pub relation plan_outside_top_heavy_definition_416g4G(plan: Plan) kind institutional {
    label en official "section 416(g)(4)(G): a simple retirement account is not a top-heavy plan";
}

@source(IRC_S416_G, relation = formalizes, coverage = exact, quote = "The term \"top-heavy plan\" shall not include a simple retirement account under section 408(p).")
rule PlanOutsideTopHeavyDefinitionSimple416g4G(plan: Plan) strict {
    label en official "SIMPLE accounts are never top-heavy";
    when plan_is_simple_retirement_account_416g4G(plan);
    then plan_outside_top_heavy_definition_416g4G(plan);
}

pub relation plan_solely_safe_harbor_coda_416g4H(plan: Plan) kind empirical {
    label en unofficial "the plan consists solely of a section 401(k)(12) or (13) arrangement with qualifying matching contributions, or a starter 401(k) or safe harbor deferral-only plan, case-asserted (section 416(g)(4)(H))";
}

rule PlanOutsideTopHeavyDefinitionSafeHarbor416g4H(plan: Plan) strict {
    label en official "safe harbor arrangements are never top-heavy";
    when plan_solely_safe_harbor_coda_416g4H(plan);
    then plan_outside_top_heavy_definition_416g4G(plan);
}
