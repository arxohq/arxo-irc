// Sections 419 and 419A definitions and special rules, and three cross
// references — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026). Module 47 carried the fund definition, the account addition
// cap, qualified cost and the deduction limit, the safe harbors and the key
// employee reserve. Left as TECH_GAP and modelled here: (a) qualified asset
// account benefit kinds; 419(c)(3) qualified direct cost (hypothetical
// deduction, timing of benefits, 60-month child care amortization);
// 419(c)(4) after-tax income; 419(c)(5) no double counting; 419(g)
// independent contractors; 419A(c)(2) post-retirement reserve; 419A(d)(2)
// annual additions; 419A(f)(1)-(3) benefit definitions and (f)(7) transition
// increase with the pinned table; 419A(g) employer inclusion of deemed
// unrelated income; 419A(h) aggregation; and the cross references of
// 415(l)(2)(B) (401(h) benefits) and 402(l)(7) (section 213).
//
// Method. Hypothetical deductions, unrelated business taxable income under
// section 512(a)(3) and actuarial reserves are case inputs (they are
// computations of other sections). What the text fixes is computed exactly:
// the 60-month ratable share, gross income of the fund (employer
// contributions excluded), the transition percentages 80/60/40/20 (table T1
// of model/sections/419A.json; the fragment carries only the placeholder
// [table T1]), and the last day of the taxable year. "Rules similar to"
// section 414 is analogical incorporation: INTERPRETATION with a case-asserted
// relationship.

// =====================================================================
// 419A(a) Qualified asset account; 419A(f)(1)-(3) benefit definitions
// =====================================================================

use self::{
    IRC_S402_L,
    IRC_S415_L,
    IRC_S419A_A,
    IRC_S419A_C,
    IRC_S419A_D,
    IRC_S419A_F,
    IRC_S419A_G,
    IRC_S419A_H,
    IRC_S419_C,
    IRC_S419_G,
    Person,
    Plan,
    QualifiedAssetAccountPurpose,
    RetireeBenefitKind420,
    TaxableYear,
    WelfareBenefit419,
    WelfareBenefitFund419,
    account_limit_419Ac,
    employer_of_fund_419,
    fund_is_section_501c_organization_419e3A,
    fund_lacks_only_employment_relationship_419g,
    psohealth_amount_includible_without_402l1_402,
};

pub enum WelfareBenefitKind419A {
    DisabilityBenefits;
    MedicalBenefits;
    SubOrSeverancePayBenefits;
    LifeInsuranceBenefits;
}

pub relation assets_set_aside_for_benefits_419Aa(fund: WelfareBenefitFund419, kind: WelfareBenefitKind419A) kind empirical {
    label en unofficial "the fund holds an account consisting of assets set aside to provide for the payment of this kind of benefit, case-asserted (section 419A(a))";
}

pub relation qualified_asset_account_419Aa(fund: WelfareBenefitFund419, kind: WelfareBenefitKind419A) kind institutional {
    label en official "section 419A(a): an account of assets set aside to pay disability, medical, SUB or severance pay, or life insurance benefits";
}

@source(IRC_S419A_A, relation = formalizes, coverage = exact, quote = "the term \"qualified asset account\" means any account consisting of assets set aside to provide for the payment of")
rule QualifiedAssetAccount419Aa(fund: WelfareBenefitFund419, kind: WelfareBenefitKind419A) strict {
    label en official "any of the four kinds of benefit";
    when assets_set_aside_for_benefits_419Aa(fund, kind);
    then qualified_asset_account_419Aa(fund, kind);
}

pub relation benefit_is_supplemental_unemployment_compensation_501c17D_419Af1A(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the benefit is a supplemental unemployment compensation benefit as defined in section 501(c)(17)(D), case-asserted";
}

pub relation benefit_is_severance_pay_419Af1B(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the benefit is a severance pay benefit, case-asserted";
}

pub relation sub_or_severance_pay_benefit_419Af1(benefit: WelfareBenefit419) kind institutional {
    label en official "section 419A(f)(1): any supplemental unemployment compensation benefit or any severance pay benefit";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "any supplemental unemployment compensation benefit (as defined in section 501(c)(17)(D))")
rule SubBenefit419Af1A(benefit: WelfareBenefit419) strict {
    label en official "clause (A)";
    when benefit_is_supplemental_unemployment_compensation_501c17D_419Af1A(benefit);
    then sub_or_severance_pay_benefit_419Af1(benefit);
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "any severance pay benefit")
rule SeveranceBenefit419Af1B(benefit: WelfareBenefit419) strict {
    label en official "clause (B)";
    when benefit_is_severance_pay_419Af1B(benefit);
    then sub_or_severance_pay_benefit_419Af1(benefit);
}

pub relation benefit_provides_medical_care_213d_419Af2(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the benefit consists of providing, directly or through insurance, medical care as defined in section 213(d), case-asserted";
}

pub relation medical_benefit_419Af2(benefit: WelfareBenefit419) kind institutional {
    label en official "section 419A(f)(2): a benefit that consists of providing (directly or through insurance) medical care as defined in section 213(d)";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "The term \"medical benefit\" means a benefit which consists of the providing (directly or through insurance) of medical care (as defined in section 213(d))")
rule MedicalBenefit419Af2(benefit: WelfareBenefit419) strict {
    label en official "section 213(d) medical care is a case fact";
    when benefit_provides_medical_care_213d_419Af2(benefit);
    then medical_benefit_419Af2(benefit);
}

pub relation benefit_is_life_insurance_419Af3(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the benefit is a life insurance benefit, case-asserted";
}

pub relation benefit_is_other_death_benefit_419Af3(benefit: WelfareBenefit419) kind empirical {
    label en unofficial "the benefit is any other death benefit, case-asserted";
}

pub relation life_insurance_benefit_419Af3(benefit: WelfareBenefit419) kind institutional {
    label en official "section 419A(f)(3): a life insurance benefit includes any other death benefit";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "The term \"life insurance benefit\" includes any other death benefit")
rule LifeInsuranceBenefitIsLife419Af3(benefit: WelfareBenefit419) strict {
    label en official "life insurance itself";
    when benefit_is_life_insurance_419Af3(benefit);
    then life_insurance_benefit_419Af3(benefit);
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "The term \"life insurance benefit\" includes any other death benefit")
rule LifeInsuranceBenefitIncludesDeathBenefit419Af3(benefit: WelfareBenefit419) strict {
    label en official "any other death benefit";
    when benefit_is_other_death_benefit_419Af3(benefit);
    then life_insurance_benefit_419Af3(benefit);
}

// =====================================================================
// 419(c)(3) Qualified direct cost
// =====================================================================

pub relation hypothetical_deduction_for_benefits_419c3A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount (including administrative expenses) that would have been allowable as a deduction to the employer for the benefits provided during the year if provided directly and with the cash receipts and disbursements method, case-asserted (a hypothetical computation of another section)";
}

pub relation qualified_direct_cost_derived_419c3A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(c)(3)(A): the hypothetical direct-provision, cash-method deduction for the benefits provided in the year";
}

@source(IRC_S419_C, relation = formalizes, coverage = partial, quote = "the aggregate amount (including administrative expenses) which would have been allowable as a deduction to the employer with respect to the benefits provided during the taxable year")
rule QualifiedDirectCostDerived419c3A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the amount is the case-asserted hypothetical deduction; the benefits counted are those provided under (B)";
    when hypothetical_deduction_for_benefits_419c3A(fund, y, amount);
    then qualified_direct_cost_derived_419c3A(fund, y, amount);
}

pub relation benefit_would_be_includible_in_employee_income_year_419c3B(benefit: WelfareBenefit419, y: TaxableYear) kind empirical {
    label en unofficial "the year in which the benefit would be includible in the employee's gross income if provided directly by the employer (or would be but for a provision of this chapter excluding it), case-asserted";
}

pub relation benefit_treated_as_provided_in_year_419c3B(benefit: WelfareBenefit419, y: TaxableYear) kind institutional {
    label en official "section 419(c)(3)(B): a benefit is treated as provided when it would be includible in the employee's gross income if provided directly (or would be but for an exclusion)";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "a benefit shall be treated as provided when such benefit would be includible in the gross income of the employee if provided directly by the employer")
rule BenefitTreatedAsProvided419c3B(benefit: WelfareBenefit419, y: TaxableYear) strict {
    label en official "the timing is the includibility year";
    when benefit_would_be_includible_in_employee_income_year_419c3B(benefit, y);
    then benefit_treated_as_provided_in_year_419c3B(benefit, y);
}

pub relation child_care_facility_basis_419c3C(facility: Integer, basis: Money) kind empirical {
    label en unofficial "the adjusted basis of the child care facility, case-asserted";
}

pub relation child_care_facility_months_in_year_419c3Ci(facility: Integer, y: TaxableYear, months: Integer) kind empirical {
    label en unofficial "the number of months of the 60-month period, beginning with the month the facility is placed in service, that fall in this taxable year, case-asserted (0 to 12)";
}

pub relation child_care_facility_deduction_419c3Ci(facility: Integer, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(c)(3)(C)(i): in lieu of depreciation the adjusted basis is deductible ratably over 60 months";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "the adjusted basis of such facility shall be allowable as a deduction ratably over a period of 60 months beginning with the month in which the facility is placed in service")
rule ChildCareFacilityDeduction419c3Ci(facility: Integer, y: TaxableYear, basis: Money, months: Integer) strict {
    label en official "basis x months / 60 with one rounding (cents, HALF_UP; JUDGMENT CALL: the statute names no rounding of a monthly share)";
    when child_care_facility_basis_419c3C(facility, basis)
        and child_care_facility_months_in_year_419c3Ci(facility, y, months)
        and months >= 0
        and months <= 12;
    then child_care_facility_deduction_419c3Ci(facility, y, div_round(basis * (months * 1.00), 60.0, 2, "HALF_UP"));
}

pub relation property_qualifies_as_child_care_center_under_regulations_419c3Cii(facility: Integer) kind empirical {
    label en unofficial "the tangible property qualifies under the Secretary's regulations as a child care center primarily for children of employees of the employer, case-asserted (the regulations are not pinned)";
}

pub relation property_not_of_depreciable_character_419c3CiiI(facility: Integer) kind empirical {
    label en unofficial "the property is not of a character subject to depreciation, case-asserted";
}

pub relation property_located_outside_united_states_419c3CiiII(facility: Integer) kind empirical {
    label en unofficial "the property is located outside the United States, case-asserted";
}

pub relation child_care_facility_419c3Cii(facility: Integer) kind institutional {
    label en official "section 419(c)(3)(C)(ii): tangible property qualifying as a child care center primarily for employees' children, excluding non-depreciable property and property outside the United States";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "The term \"child care facility\" means any tangible property which qualifies under regulations prescribed by the Secretary as a child care center primarily for children of employees of the employer")
rule ChildCareFacility419c3Cii(facility: Integer) strict {
    label en official "qualifying property that is neither non-depreciable nor located outside the United States";
    when property_qualifies_as_child_care_center_under_regulations_419c3Cii(facility)
        and not_known(property_not_of_depreciable_character_419c3CiiI(facility))
        and not_known(property_located_outside_united_states_419c3CiiII(facility));
    then child_care_facility_419c3Cii(facility);
}

// =====================================================================
// 419(c)(4) After-tax income; 419(c)(5) counted once
// =====================================================================

pub relation fund_gross_income_items_419c4B(fund: WelfareBenefitFund419, y: TaxableYear, employee_amounts: Money, other_income: Money, employer_contributions: Money) kind empirical {
    label en unofficial "the amounts received from employees, the fund's other gross income, and the employer contributions received, case-asserted";
}

pub relation fund_gross_income_419c4B(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(c)(4)(B): contributions and other amounts received from employees are taken into account, contributions from the employer are not";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "contributions from the employer shall not be taken into account")
rule FundGrossIncome419c4B(fund: WelfareBenefitFund419, y: TaxableYear, from_employees: Money, other: Money, from_employer: Money) strict {
    label en official "employee amounts plus other income; employer contributions excluded";
    when fund_gross_income_items_419c4B(fund, y, from_employees, other, from_employer);
    then fund_gross_income_419c4B(fund, y, from_employees + other);
}

pub relation fund_directly_connected_deductions_and_tax_419c4A(fund: WelfareBenefitFund419, y: TaxableYear, deductions: Money, tax: Money) kind empirical {
    label en unofficial "the deductions allowed by this chapter directly connected with the production of the fund's gross income, and the tax imposed by this chapter on the fund for the year, case-asserted";
}

pub relation after_tax_income_derived_419c4A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(c)(4)(A): the fund's gross income reduced by the directly connected deductions and by the tax imposed on the fund for the year";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "the gross income of the welfare benefit fund reduced by the sum of")
rule AfterTaxIncomeDerived419c4A(fund: WelfareBenefitFund419, y: TaxableYear, gross: Money, deductions: Money, tax: Money) strict {
    label en official "gross income - (deductions + tax); the result may be negative, and section 419(c)(2) then reads it through the existing QualifiedCost419c rule on the case-asserted after-tax income";
    when fund_gross_income_419c4B(fund, y, gross)
        and fund_directly_connected_deductions_and_tax_419c4A(fund, y, deductions, tax);
    then after_tax_income_derived_419c4A(fund, y, gross - (deductions + tax));
}

pub relation item_count_in_qualified_cost_419c5(fund: WelfareBenefitFund419, y: TaxableYear, item: Integer, times: Integer) kind empirical {
    label en unofficial "the number of times an item is taken into account in determining the qualified cost of the fund, case-asserted";
}

pub relation item_counted_more_than_once_419c5(fund: WelfareBenefitFund419, y: TaxableYear, item: Integer) kind institutional {
    label en official "section 419(c)(5): no item may be taken into account more than once (a count above 1 is a violation of the counting rule)";
}

@source(IRC_S419_C, relation = formalizes, coverage = exact, quote = "No item may be taken into account more than once in determining the qualified cost of any welfare benefit fund")
rule ItemCountedMoreThanOnce419c5(fund: WelfareBenefitFund419, y: TaxableYear, item: Integer, times: Integer) strict {
    label en official "exact boundary: a count of 1 is allowed, 2 is not";
    when item_count_in_qualified_cost_419c5(fund, y, item, times) and times > 1;
    then item_counted_more_than_once_419c5(fund, y, item);
}

// =====================================================================
// 419(g) Extension to plans for independent contractors
// =====================================================================

pub relation person_for_whom_services_provided_419g(fund: WelfareBenefitFund419, payer: Person) kind empirical {
    label en unofficial "the person for whom services are provided, where the fund would be a welfare benefit fund but for the lack of an employee-employer relationship, case-asserted";
}

pub relation person_providing_services_419g(fund: WelfareBenefitFund419, provider: Person) kind empirical {
    label en unofficial "the person providing the services, case-asserted";
}

pub relation employer_reference_read_as_service_recipient_419g2(fund: WelfareBenefitFund419, payer: Person) kind institutional {
    label en official "section 419(g)(2): a reference to the employer is a reference to the person for whom services are provided";
}

@source(IRC_S419_G, relation = formalizes, coverage = exact, quote = "any reference in this section to the employer shall be treated as a reference to the person for whom services are provided")
rule EmployerReferenceReadAsServiceRecipient419g2(fund: WelfareBenefitFund419, payer: Person) strict {
    label en official "for a fund lacking only the employment relationship";
    when fund_lacks_only_employment_relationship_419g(fund) and person_for_whom_services_provided_419g(fund, payer);
    then employer_reference_read_as_service_recipient_419g2(fund, payer);
}

pub relation employee_reference_read_as_service_provider_419g2(fund: WelfareBenefitFund419, provider: Person) kind institutional {
    label en official "section 419(g)(2): a reference to an employee is a reference to the person providing the services";
}

@source(IRC_S419_G, relation = formalizes, coverage = exact, quote = "any reference in this section to an employee shall be treated as a reference to the person providing the services")
rule EmployeeReferenceReadAsServiceProvider419g2(fund: WelfareBenefitFund419, provider: Person) strict {
    label en official "for a fund lacking only the employment relationship";
    when fund_lacks_only_employment_relationship_419g(fund) and person_providing_services_419g(fund, provider);
    then employee_reference_read_as_service_provider_419g2(fund, provider);
}

// =====================================================================
// 419A(c)(2) Post-retirement reserve; 419A(d)(2) annual additions
// =====================================================================

pub relation post_retirement_reserve_actuarial_419Ac2(fund: WelfareBenefitFund419, y: TaxableYear, kind: WelfareBenefitKind419A, amount: Money) kind empirical {
    label en unofficial "the reserve funded over the working lives of the covered employees and actuarially determined on a level basis (reasonable assumptions in the aggregate) as necessary for post-retirement medical benefits (determined on current medical costs) or post-retirement life insurance benefits, case-asserted";
}

pub relation account_limit_with_post_retirement_reserve_419Ac2(fund: WelfareBenefitFund419, y: TaxableYear, kind: WelfareBenefitKind419A, amount: Money) kind institutional {
    label en official "section 419A(c)(2): the account limit may include the post-retirement reserve for medical or life insurance benefits";
}

@source(IRC_S419A_C, relation = formalizes, coverage = partial, quote = "The account limit for any taxable year may include a reserve funded over the working lives of the covered employees and actuarially determined on a level basis")
rule AccountLimitWithReserveMedical419Ac2(fund: WelfareBenefitFund419, y: TaxableYear, base: Money, reserve: Money) strict {
    label en official "PARTIAL: base limit plus the medical reserve; the section 505(b) condition is read by module 47's (e)(1) rules";
    when account_limit_419Ac(fund, y, base)
        and post_retirement_reserve_actuarial_419Ac2(fund, y, MedicalBenefits, reserve);
    then account_limit_with_post_retirement_reserve_419Ac2(fund, y, MedicalBenefits, base + reserve);
}

@source(IRC_S419A_C, relation = formalizes, coverage = partial, quote = "post-retirement life insurance benefits to be provided to covered employees")
rule AccountLimitWithReserveLife419Ac2(fund: WelfareBenefitFund419, y: TaxableYear, base: Money, reserve: Money) strict {
    label en official "PARTIAL: base limit plus the life insurance reserve";
    when account_limit_419Ac(fund, y, base)
        and post_retirement_reserve_actuarial_419Ac2(fund, y, LifeInsuranceBenefits, reserve);
    then account_limit_with_post_retirement_reserve_419Ac2(fund, y, LifeInsuranceBenefits, base + reserve);
}

pub relation medical_amount_allocated_to_key_employee_account_419Ad2(fund: WelfareBenefitFund419, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount attributable to medical benefits allocated to the separate account established for a key employee under paragraph (1), case-asserted";
}

pub relation key_employee_medical_amount_annual_addition_419Ad2(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(d)(2): for section 415 the amount is an annual addition to a defined contribution plan for section 415(c)";
}

@source(IRC_S419A_D, relation = formalizes, coverage = exact, quote = "any amount attributable to medical benefits allocated to an account established under paragraph (1) shall be treated as an annual addition to a defined contribution plan for purposes of section 415(c)")
rule KeyEmployeeMedicalAmountAnnualAddition419Ad2(fund: WelfareBenefitFund419, employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "an annual addition; the section 415 modules read the relation only when a case asserts it";
    when medical_amount_allocated_to_key_employee_account_419Ad2(fund, employee, y, amount);
    then key_employee_medical_amount_annual_addition_419Ad2(employee, y, amount);
}

pub relation section_415c1B_inapplicable_to_key_employee_medical_419Ad2(employee: Person, y: TaxableYear) kind institutional {
    label en official "section 419A(d)(2) last sentence: section 415(c)(1)(B) (the percentage of compensation limit) does not apply to that annual addition";
}

@source(IRC_S419A_D, relation = formalizes, coverage = exact, quote = "Subparagraph (B) of section 415(c)(1) shall not apply to any amount treated as an annual addition under the preceding sentence")
rule Section415c1BInapplicableKeyEmployeeMedical419Ad2(employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "no percentage-of-compensation limit for the amount";
    when key_employee_medical_amount_annual_addition_419Ad2(employee, y, amount);
    then section_415c1B_inapplicable_to_key_employee_medical_419Ad2(employee, y);
}

// =====================================================================
// 419A(f)(7) Adjustments for existing excess reserves
// =====================================================================

pub relation fund_had_assets_set_aside_on_july_18_1984_419Af7D(fund: WelfareBenefitFund419) kind empirical {
    label en unofficial "as of July 18, 1984 the fund had assets set aside for the purposes of subsection (a), case-asserted";
}

pub relation assets_set_aside_at_close_of_first_year_after_july_18_1984_419Af7C(fund: WelfareBenefitFund419, amount: Money) kind empirical {
    label en unofficial "the amount of assets set aside at the close of the first taxable year ending after July 18, 1984 for the purposes of subsection (a), case-asserted";
}

pub relation account_limit_without_transition_419Af7C(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the account limit determined under the section without regard to paragraph (7) for the year, case-asserted";
}

pub relation existing_excess_reserve_419Af7C(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(f)(7)(C): the excess, if any, of the assets set aside at the close of the first taxable year ending after July 18, 1984 over the account limit without regard to the paragraph";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "the term \"existing excess reserve\" means the excess (if any) of")
rule ExistingExcessReserve419Af7C(fund: WelfareBenefitFund419, y: TaxableYear, assets: Money, limit: Money) strict {
    label en official "max(assets - limit, 0), only for a fund with assets set aside on July 18, 1984 (clause (D))";
    when fund_had_assets_set_aside_on_july_18_1984_419Af7D(fund)
        and assets_set_aside_at_close_of_first_year_after_july_18_1984_419Af7C(fund, assets)
        and account_limit_without_transition_419Af7C(fund, y, limit);
    then existing_excess_reserve_419Af7C(fund, y, max(assets - limit, 0.00 USD));
}

pub relation taxable_year_ordinal_419Af7(fund: WelfareBenefitFund419, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "the ordinal (1 to 4) of the taxable year among the taxable years to which section 419A applies, case-asserted";
}

pub relation transition_applicable_percentage_419Af7B(fund: WelfareBenefitFund419, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 419A(f)(7)(B) table: 80, 60, 40 and 20 percent for the first four taxable years to which the section applies (table T1 of the model)";
}

@source(IRC_S419A_F, relation = formalizes, coverage = partial, quote = "The account limit for any of the first 4 taxable years to which this section applies shall be increased by the applicable percentage of any existing excess reserves")
rule TransitionPercentageFirstYear419Af7B(fund: WelfareBenefitFund419, y: TaxableYear) strict {
    label en official "PARTIAL: table T1 read from the model, 1st year 80 percent";
    when taxable_year_ordinal_419Af7(fund, y, 1);
    then transition_applicable_percentage_419Af7B(fund, y, 0.80);
}

@source(IRC_S419A_F, relation = formalizes, coverage = partial, quote = "The account limit for any of the first 4 taxable years to which this section applies shall be increased by the applicable percentage of any existing excess reserves")
rule TransitionPercentageSecondYear419Af7B(fund: WelfareBenefitFund419, y: TaxableYear) strict {
    label en official "PARTIAL: 2nd year 60 percent";
    when taxable_year_ordinal_419Af7(fund, y, 2);
    then transition_applicable_percentage_419Af7B(fund, y, 0.60);
}

@source(IRC_S419A_F, relation = formalizes, coverage = partial, quote = "The account limit for any of the first 4 taxable years to which this section applies shall be increased by the applicable percentage of any existing excess reserves")
rule TransitionPercentageThirdYear419Af7B(fund: WelfareBenefitFund419, y: TaxableYear) strict {
    label en official "PARTIAL: 3rd year 40 percent";
    when taxable_year_ordinal_419Af7(fund, y, 3);
    then transition_applicable_percentage_419Af7B(fund, y, 0.40);
}

@source(IRC_S419A_F, relation = formalizes, coverage = partial, quote = "The account limit for any of the first 4 taxable years to which this section applies shall be increased by the applicable percentage of any existing excess reserves")
rule TransitionPercentageFourthYear419Af7B(fund: WelfareBenefitFund419, y: TaxableYear) strict {
    label en official "PARTIAL: 4th year 20 percent";
    when taxable_year_ordinal_419Af7(fund, y, 4);
    then transition_applicable_percentage_419Af7B(fund, y, 0.20);
}

pub relation transition_increase_419Af7A(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(f)(7)(A): the increase of the account limit is the applicable percentage of the existing excess reserve";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "shall be increased by the applicable percentage of any existing excess reserves")
rule TransitionIncrease419Af7A(fund: WelfareBenefitFund419, y: TaxableYear, excess: Money, pct: Decimal) strict {
    label en official "cents, HALF_UP on excess x percentage (JUDGMENT CALL: the statute names no rounding)";
    when existing_excess_reserve_419Af7C(fund, y, excess) and transition_applicable_percentage_419Af7B(fund, y, pct);
    then transition_increase_419Af7A(fund, y, round(excess * pct, 2, "HALF_UP"));
}

pub relation account_limit_after_transition_increase_419Af7(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(f)(7)(A): the account limit for the first four taxable years plus the increase";
}

@source(IRC_S419A_F, relation = formalizes, coverage = exact, quote = "The account limit for any of the first 4 taxable years to which this section applies shall be increased")
rule AccountLimitAfterTransitionIncrease419Af7(fund: WelfareBenefitFund419, y: TaxableYear, base: Money, increase: Money) strict {
    label en official "base limit plus the increase";
    when account_limit_without_transition_419Af7C(fund, y, base) and transition_increase_419Af7A(fund, y, increase);
    then account_limit_after_transition_increase_419Af7(fund, y, base + increase);
}

// =====================================================================
// 419A(g) Employer taxed on income of certain welfare benefit funds
// =====================================================================

pub relation hypothetical_ubti_512a3_419Ag2(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount that would have been the fund's unrelated business taxable income under section 512(a)(3) if it were an organization described in section 501(c)(7), (9) or (17), for the fund's taxable year ending within the employer's taxable year, case-asserted (a computation of another section)";
}

pub relation deemed_unrelated_income_419Ag2(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(g)(2): the amount that would have been the fund's unrelated business taxable income under section 512(a)(3) if it were an organization described in section 501(c)(7), (9) or (17)";
}

@source(IRC_S419A_G, relation = formalizes, coverage = exact, quote = "the deemed unrelated income of any welfare benefit fund shall be the amount which would have been its unrelated business taxable income under section 512(a)(3)")
rule DeemedUnrelatedIncome419Ag2(fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) strict {
    label en official "the case-asserted hypothetical UBTI";
    when hypothetical_ubti_512a3_419Ag2(fund, y, amount);
    then deemed_unrelated_income_419Ag2(fund, y, amount);
}

pub relation employer_gross_income_inclusion_419Ag1(employer: Person, fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419A(g)(1): for a fund that is not a section 501(c)(7), (9) or (17) organization, the employer includes in gross income the fund's deemed unrelated income";
}

@source(IRC_S419A_G, relation = formalizes, coverage = exact, quote = "the employer shall include in gross income for any taxable year an amount equal to such fund's deemed unrelated income")
rule EmployerGrossIncomeInclusion419Ag1(employer: Person, fund: WelfareBenefitFund419, y: TaxableYear, amount: Money) strict {
    label en official "only for a fund not described in section 501(c)(7), (9) or (17)";
    when employer_of_fund_419(fund, employer)
        and deemed_unrelated_income_419Ag2(fund, y, amount)
        and not_known(fund_is_section_501c_organization_419e3A(fund));
    then employer_gross_income_inclusion_419Ag1(employer, fund, y, amount);
}

pub relation tax_attributable_to_included_amount_419Ag3(employer: Person, fund: WelfareBenefitFund419, y: TaxableYear, tax: Money) kind empirical {
    label en unofficial "the amount of the tax imposed by this chapter attributable to the amount included in the employer's gross income under paragraph (1), case-asserted";
}

pub relation taxable_year_last_day_419Ag3(y: TaxableYear, last: Date) kind empirical {
    label en unofficial "the last day of the employer's taxable year, case-asserted";
}

pub relation attributable_tax_treated_as_contribution_419Ag3A(fund: WelfareBenefitFund419, y: TaxableYear, tax: Money, paid_on: Date) kind institutional {
    label en official "section 419A(g)(3)(A): the attributable tax is treated as a contribution paid to the fund on the last day of the taxable year";
}

@source(IRC_S419A_G, relation = formalizes, coverage = exact, quote = "shall be treated as a contribution paid to such welfare benefit fund on the last day of such taxable year")
rule AttributableTaxTreatedAsContribution419Ag3A(employer: Person, fund: WelfareBenefitFund419, y: TaxableYear, tax: Money, amount: Money, last: Date) strict {
    label en official "dated on the last day of the taxable year";
    when employer_gross_income_inclusion_419Ag1(employer, fund, y, amount)
        and tax_attributable_to_included_amount_419Ag3(employer, fund, y, tax)
        and taxable_year_last_day_419Ag3(y, last);
    then attributable_tax_treated_as_contribution_419Ag3A(fund, y, tax, last);
}

pub relation attributable_tax_treated_as_imposed_on_fund_419Ag3B(fund: WelfareBenefitFund419, y: TaxableYear, tax: Money) kind institutional {
    label en official "section 419A(g)(3)(B): the attributable tax is treated as imposed on the fund for purposes of section 419(c)(4)(A)";
}

@source(IRC_S419A_G, relation = formalizes, coverage = exact, quote = "the tax so attributable shall be treated as imposed on the fund for purposes of section 419(c)(4)(A)")
rule AttributableTaxTreatedAsImposedOnFund419Ag3B(employer: Person, fund: WelfareBenefitFund419, y: TaxableYear, tax: Money, amount: Money) strict {
    label en official "the tax joins the tax term of the after-tax income computation (as a relation; the case-asserted tax input of 419(c)(4)(A) is not rewritten)";
    when employer_gross_income_inclusion_419Ag1(employer, fund, y, amount)
        and tax_attributable_to_included_amount_419Ag3(employer, fund, y, tax);
    then attributable_tax_treated_as_imposed_on_fund_419Ag3B(fund, y, tax);
}

// =====================================================================
// 419A(h) Aggregation rules
// =====================================================================

pub relation treated_as_one_fund_for_mandatory_purposes_419Ah1A(employer: Person, fund: WelfareBenefitFund419) kind institutional {
    label en official "section 419A(h)(1)(A): for subsections (c)(4), (d)(2) and (e)(2) all welfare benefit funds of an employer are treated as one fund";
}

@source(IRC_S419A_H, relation = formalizes, coverage = exact, quote = "all welfare benefit funds of an employer shall be treated as 1 fund")
rule TreatedAsOneFundMandatory419Ah1A(employer: Person, fund: WelfareBenefitFund419) strict {
    label en official "every fund of the employer belongs to the one aggregated fund";
    when employer_of_fund_419(fund, employer);
    then treated_as_one_fund_for_mandatory_purposes_419Ah1A(employer, fund);
}

pub relation employer_elects_permissive_aggregation_419Ah1B(employer: Person, fund_a: WelfareBenefitFund419, fund_b: WelfareBenefitFund419) kind empirical {
    label en unofficial "the employer elects to treat two or more of its welfare benefit funds as one fund for purposes other than those of subparagraph (A), case-asserted (exercise atom)";
}

pub relation aggregation_not_inconsistent_with_purposes_419Ah1B(employer: Person) kind empirical {
    label en unofficial "the aggregation is not inconsistent with the purposes of this subpart and section 512, case-asserted (evaluative)";
}

pub relation funds_treated_as_one_permissive_419Ah1B(fund_a: WelfareBenefitFund419, fund_b: WelfareBenefitFund419) kind institutional {
    label en official "section 419A(h)(1)(B): two funds are treated as one at the employer's election, to the extent not inconsistent with the purposes of the subpart and section 512";
}

@source(IRC_S419A_H, relation = formalizes, coverage = partial, quote = "at the election of the employer, 2 or more welfare benefit funds of such employer may (to the extent not inconsistent with the purposes of this subpart and section 512) be treated as 1 fund")
rule PermissiveAggregationPower419Ah1B(employer: Person, fund_a: WelfareBenefitFund419, fund_b: WelfareBenefitFund419) strict {
    label en official "PARTIAL/EVALUATIVE: a power of the employer over its funds, valid only when the aggregation is consistent with the purposes (evaluative case fact)";
    when employer_of_fund_419(fund_a, employer)
        and employer_of_fund_419(fund_b, employer)
        and employer_elects_permissive_aggregation_419Ah1B(employer, fund_a, fund_b);
    then power ElectPermissiveAggregationPower {
        holder employer;
        over employer;
        exercise employer_elects_permissive_aggregation_419Ah1B(employer, fund_a, fund_b);
        valid_when aggregation_not_inconsistent_with_purposes_419Ah1B(employer);
        effect funds_treated_as_one_permissive_419Ah1B(fund_a, fund_b);
    };
}

pub relation related_employer_member_419Ah2(employer: Person, member: Person) kind empirical {
    label en unofficial "the person is treated as a member of a group with the employer under rules similar to section 414(b), (c), (m) and (n), case-asserted (analogical incorporation: the similarity mapping is not pinned)";
}

pub relation related_employers_treated_as_one_419Ah2(employer: Person, member: Person) kind institutional {
    label en official "section 419A(h)(2): rules similar to section 414(b), (c), (m) and (n) apply, so related employers are treated as one";
}

@source(IRC_S419A_H, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of subsections (b), (c), (m), and (n) of section 414 shall apply")
rule RelatedEmployersTreatedAsOne419Ah2(employer: Person, member: Person) strict {
    label en official "PARTIAL/INTERPRETATION: membership is case-asserted; the section 414 modules of this package are not reused because the text says only \"similar\" rules";
    when related_employer_member_419Ah2(employer, member);
    then related_employers_treated_as_one_419Ah2(employer, member);
}

// =====================================================================
// Cross references: 415(l)(2)(B) and 402(l)(7)
// =====================================================================

pub relation account_established_for_participant_under_pension_plan_415l2A(account: Plan, participant: Person) kind empirical {
    label en unofficial "the separate account is established for a participant under a pension or annuity plan, case-asserted (section 415(l)(2)(A))";
}

pub relation account_benefits_payable_solely_to_participant_spouse_dependents_415l2B(account: Plan, participant: Person) kind empirical {
    label en unofficial "the benefits described in section 401(h) payable from the account are payable solely to the participant, the participant's spouse or dependents, case-asserted (section 415(l)(2)(B))";
}

pub relation individual_medical_benefit_account_415l2(account: Plan, participant: Person) kind institutional {
    label en official "section 415(l)(2): a separate account established for a participant under a pension or annuity plan from which section 401(h) benefits are payable solely to the participant, spouse or dependents";
}

@source(IRC_S415_L, relation = formalizes, coverage = exact, quote = "from which benefits described in section 401(h) are payable solely to such participant, his spouse, or his dependents")
rule IndividualMedicalBenefitAccount415l2(account: Plan, participant: Person) strict {
    label en official "(A) and (B) together";
    when account_established_for_participant_under_pension_plan_415l2A(account, participant)
        and account_benefits_payable_solely_to_participant_spouse_dependents_415l2B(account, participant);
    then individual_medical_benefit_account_415l2(account, participant);
}

pub relation psohealth_excluded_amount_not_a_section_213_expense_402l7(officer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(l)(7): the amounts excluded from gross income under paragraph (1) are not taken into account under section 213";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "The amounts excluded from gross income under paragraph (1) shall not be taken into account under section 213")
rule PsohealthExcludedAmountNotSection213402l7(officer: Person, y: TaxableYear, amount: Money) strict {
    label en official "the excluded amount is not counted as a medical expense; the section 213 module (deductions) reads the relation only when a case asserts it";
    when psohealth_amount_includible_without_402l1_402(officer, y, amount);
    then psohealth_excluded_amount_not_a_section_213_expense_402l7(officer, y, amount);
}
