// Sections 431 and 433 residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): the multiemployer funding standard (b)(4), (b)(7),
// (b)(8), (c)(2)(B), (c)(4)-(7), (d) and the CSEC funding standard (b)(6),
// (c)(4)-(8),(10), (e)(3), (f)(2)-(6), (g), (h), (j).
//
// Pattern as in modules 31/32 and 67: exact arithmetic over case-asserted
// amounts; time limits by exact calendar arithmetic; the Secretary's approvals
// and ERISA cross-references are case facts. The interest between dates
// (JUDGMENT CALL) is simple interest on actual/365, as in module 67.

// =====================================================================
// 431: (b)(7), (b)(8), (c)(4), (c)(6)(C)-(D), (c)(7), (d)
// =====================================================================

use self::{
    DefinedBenefitPlan,
    IRC_S431_B,
    IRC_S431_C,
    IRC_S431_D,
    IRC_S433_C,
    IRC_S433_F,
    IRC_S433_G,
    IRC_S433_H,
    IRC_S433_J,
    MultiemployerPlan,
    Person,
    TaxableYear,
    csec_liquidity_shortfall_433f5,
};

pub relation withdrawal_liability_payment_received_431b7a(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount received by the plan in payment of an employer's withdrawal liability (ERISA part 1 of subtitle E of title IV), case-asserted";
}

pub relation withdrawal_liability_considered_contributed_431b7a(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(b)(7)(A): withdrawal liability received is considered an amount contributed by the employer";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "shall be considered an amount contributed by the employer to or under the plan")
rule WithdrawalLiabilityConsideredContributed431b7a(plan: MultiemployerPlan, y: TaxableYear, amount: Money) strict {
    label en official "received withdrawal liability";
    when withdrawal_liability_payment_received_431b7a(plan, y, amount);
    then withdrawal_liability_considered_contributed_431b7a(plan, y, amount);
}

pub relation balance_in_funding_account_at_close_of_reorganization_year_431b7b(plan: MultiemployerPlan, y: TaxableYear, balance: Money, section_4243a_deficiency: Money) kind empirical {
    label en unofficial "the balance in the funding standard account at the close of the plan's last reorganization year (and any accumulated funding deficiency under ERISA section 4243(a)), case-asserted";
}

pub relation not_in_reorganization_but_was_preceding_year_431b7b(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is not in reorganization in the plan year but was in reorganization in the immediately preceding plan year, case-asserted";
}

pub relation post_reorganization_balance_amortized_431b7b(plan: MultiemployerPlan, y: TaxableYear, annual_installment: Money) kind institutional {
    label en official "section 431(b)(7)(B): the balance (except the section 4243(a) deficiency) is eliminated by an offsetting credit or charge and amortized in equal annual installments over 30 plan years (straight-line: JUDGMENT CALL, the statute gives no interest here)";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "shall be taken into account in subsequent plan years by being amortized in equal annual installments (until fully amortized) over 30 plan years")
rule PostReorganizationBalanceAmortized431b7b(plan: MultiemployerPlan, y: TaxableYear, bal: Money, def4243: Money) strict {
    label en official "PARTIAL (JUDGMENT CALL): round((balance - section 4243(a) deficiency) / 30, 2, HALF_UP)";
    when not_in_reorganization_but_was_preceding_year_431b7b(plan, y)
        and balance_in_funding_account_at_close_of_reorganization_year_431b7b(plan, y, bal, def4243);
    then post_reorganization_balance_amortized_431b7b(plan, y, round(max(0 USD, bal - def4243) * (1.0 / 30.0), 2, "HALF_UP"));
}

pub relation amount_paid_to_pbgc_4222_or_4223_431b7c(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount paid by the plan during the year to the PBGC under ERISA section 4222 or to a section 501(c)(22) fund under section 4223, case-asserted";
}

pub relation contributions_considered_received_431b7c(plan: MultiemployerPlan, y: TaxableYear, contributions: Money) kind empirical {
    label en unofficial "the contributions considered received by the plan for the plan year before the reduction, case-asserted";
}

pub relation contributions_considered_received_after_4222_431b7c(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(b)(7)(C): an amount paid to the PBGC under section 4222 (or a section 4223 fund) reduces the contributions considered received";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "shall reduce the amount of contributions considered received by the plan for the plan year")
rule ContributionsConsideredReceivedAfter4222431b7c(plan: MultiemployerPlan, y: TaxableYear, contrib: Money, paid: Money) strict {
    label en official "max(0, contributions - payment)";
    when contributions_considered_received_431b7c(plan, y, contrib)
        and amount_paid_to_pbgc_4222_or_4223_431b7c(plan, y, paid);
    then contributions_considered_received_after_4222_431b7c(plan, y, max(0 USD, contrib - paid));
}

pub relation refunded_pending_withdrawal_liability_431b7d(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount paid by an employer pending the final determination of withdrawal liability and subsequently refunded, case-asserted";
}

pub relation refund_charged_to_funding_account_431b7d(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(b)(7)(D): the refund is charged to the funding standard account in accordance with regulations";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "shall be charged to the funding standard account in accordance with regulations prescribed by the Secretary")
rule RefundChargedToFundingAccount431b7d(plan: MultiemployerPlan, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the regulations on timing are not pinned";
    when refunded_pending_withdrawal_liability_431b7d(plan, y, amount);
    then refund_charged_to_funding_account_431b7d(plan, y, amount);
}

pub relation benefit_increase_payable_not_as_life_annuity_within_14_years_431b7g(plan: MultiemployerPlan, years: Integer, unfunded_increase: Money) kind empirical {
    label en unofficial "the years (from the effective date of the amendment) over which a benefit increase that is not a life annuity is payable, and the resulting increase in unfunded past service liability, case-asserted";
}

pub relation short_period_benefit_increase_amortization_years_431b7g(plan: MultiemployerPlan, amortization_years: Integer) kind institutional {
    label en official "section 431(b)(7)(G): for such a benefit increase payable over a period not exceeding 14 years, the amortization period under paragraph (2)(B)(ii) is the payment period (a period not longer than 14 years)";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "for a period that does not exceed 14 years from the effective date of the amendment")
rule ShortPeriodBenefitIncreaseAmortizationYears431b7g(plan: MultiemployerPlan, years: Integer, unfunded: Money) strict {
    label en official "PARTIAL: the amortization period is the payment period, when it is at most 14 years";
    when benefit_increase_payable_not_as_life_annuity_within_14_years_431b7g(plan, years, unfunded)
        and years >= 1 and years <= 14;
    then short_period_benefit_increase_amortization_years_431b7g(plan, years);
}

pub relation net_investment_loss_first_recognized_year_431b8Ai(plan: MultiemployerPlan, recognition_year: Integer, loss_year: Integer) kind empirical {
    label en unofficial "the plan year in which a portion of the net investment loss is first recognized in the actuarial value of assets, and the plan year in which the loss was incurred, case-asserted";
}

pub relation investment_loss_amortization_last_year_431b8Aii(plan: MultiemployerPlan, recognition_year: Integer, loss_year: Integer, last_year: Integer) kind institutional {
    label en official "section 431(b)(8)(A)(i): the separate amortization runs from the recognition year to the last plan year of the 30-plan-year period beginning with the plan year the loss was incurred";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "ending with the last plan year in the 30-plan year period beginning with the plan year in which such net investment loss was incurred")
rule InvestmentLossAmortizationLastYear431b8Aii(plan: MultiemployerPlan, recognized: Integer, incurred: Integer) strict {
    label en official "incurred + 29 (30 plan years counting the incurred year)";
    when net_investment_loss_first_recognized_year_431b8Ai(plan, recognized, incurred);
    then investment_loss_amortization_last_year_431b8Aii(plan, recognized, incurred, incurred + 29);
}

pub relation extension_granted_years_for_431b8Aii(plan: MultiemployerPlan, total_amortization_years: Integer) kind empirical {
    label en unofficial "the total amortization period after an extension granted under subsection (d) before the election, case-asserted";
}

pub relation b8A_election_in_effect_431b8Aii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "subparagraph (A) applies to the plan year, case-asserted";
}

pub relation amortization_period_after_b8A_431b8Aii(plan: MultiemployerPlan, y: TaxableYear, years: Integer) kind institutional {
    label en official "section 431(b)(8)(A)(ii)(II): an earlier extension does not result in an amortization period exceeding 30 years";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "such extension shall not result in such amortization period exceeding 30 years")
rule AmortizationPeriodAfterB8A431b8Aii(plan: MultiemployerPlan, y: TaxableYear, total: Integer) strict {
    label en official "min(total, 30)";
    when b8A_election_in_effect_431b8Aii(plan, y)
        and extension_granted_years_for_431b8Aii(plan, total);
    then amortization_period_after_b8A_431b8Aii(plan, y, min(total, 30));
}

pub relation asset_value_as_fraction_of_fmv_431b8Bi(plan: MultiemployerPlan, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the value of plan assets at a time as a fraction of the fair market value (1.00 = equal), case-asserted";
}

pub relation solvency_test_met_431b8B(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the solvency test of subparagraph (C) is met, case-asserted (module 31)";
}

pub relation asset_valuation_change_within_80_130_corridor_431b8Bi(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(b)(8)(B)(i)(II): for the first 2 plan years beginning after August 31, 2008 the value of plan assets at any time is not less than 80 percent nor greater than 130 percent of fair market value";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "the value of plan assets at any time shall not be less than 80 percent or greater than 130 percent of the fair market value of such assets at such time")
rule AssetValuationChangeWithinCorridor431b8Bi(plan: MultiemployerPlan, y: TaxableYear, fraction: Decimal) strict {
    label en official "exact boundaries: 0.80 and 1.30 are inside";
    when solvency_test_met_431b8B(plan)
        and asset_value_as_fraction_of_fmv_431b8Bi(plan, y, fraction)
        and fraction >= 0.80 and fraction <= 1.30;
    then asset_valuation_change_within_80_130_corridor_431b8Bi(plan, y);
}

pub relation return_spread_years_431b8Bi(plan: MultiemployerPlan, spread_years: Integer) kind empirical {
    label en unofficial "the number of years over which the difference between expected and actual returns for a first-2-year plan year is spread, case-asserted";
}

pub relation return_spread_permitted_431b8BiI(plan: MultiemployerPlan) kind institutional {
    label en official "section 431(b)(8)(B)(i)(I): the difference for the first 2 plan years ending after August 31, 2008 may be spread over a period of not more than 10 years";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "spreads the difference between expected and actual returns for either or both of the first 2 plan years ending after August 31, 2008, over a period of not more than 10 years")
rule ReturnSpreadPermitted431b8BiI(plan: MultiemployerPlan, years: Integer) strict {
    label en official "exact boundary: 10 years is allowed, 11 is not";
    when solvency_test_met_431b8B(plan)
        and return_spread_years_431b8Bi(plan, years)
        and years >= 1 and years <= 10;
    then return_spread_permitted_431b8BiI(plan);
}

pub relation b8_change_deemed_reasonable_and_approved_431b8Bii(plan: MultiemployerPlan) kind institutional {
    label en official "section 431(b)(8)(B)(ii): the asset valuation method changes are not treated as unreasonable and are deemed approved (section 302(d)(1) ERISA and section 412(d)(1))";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "the Secretary shall not treat the asset valuation method of the plan as unreasonable solely because of the changes in such method described in clause (i)")
rule B8ChangeDeemedReasonableAndApproved431b8Bii(plan: MultiemployerPlan) strict {
    label en official "a permitted spread or corridor change";
    when return_spread_permitted_431b8BiI(plan);
    then b8_change_deemed_reasonable_and_approved_431b8Bii(plan);
}

pub relation b8_benefit_amendment_facts_431b8d(plan: MultiemployerPlan, y: TaxableYear, plan_years_since_application: Integer) kind empirical {
    label en unofficial "the number of plan years since the plan year to which subparagraph (A) or (B) applied, at the time the amendment would go into effect, case-asserted";
}

pub relation actuary_certifies_amendment_conditions_431b8d(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the actuary certifies the increase is paid for out of additional contributions and the funded percentage and projected credit balances for the 2 plan years are reasonably expected to be at least as high as without the increase, case-asserted";
}

pub relation amendment_required_for_qualification_or_law_431b8d(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the amendment is required as a condition of qualification under part I of subchapter D or to comply with other law, case-asserted";
}

pub relation benefit_increase_may_take_effect_431b8d(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(b)(8)(D): an amendment increasing benefits may not take effect in either of the 2 plan years after the application unless certified or required";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "a plan amendment increasing benefits may not go into effect during either of the 2 plan years immediately following such plan year unless")
rule BenefitIncreaseMayTakeEffectCertified431b8d(plan: MultiemployerPlan, y: TaxableYear, n: Integer) strict {
    label en official "within the 2 following years (1 or 2): only with the actuary's certification";
    when b8_benefit_amendment_facts_431b8d(plan, y, n)
        and n >= 1 and n <= 2
        and actuary_certifies_amendment_conditions_431b8d(plan, y);
    then benefit_increase_may_take_effect_431b8d(plan, y);
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "the amendment is required as a condition of qualification under part I of subchapter D or to comply with other applicable law")
rule BenefitIncreaseMayTakeEffectRequired431b8d(plan: MultiemployerPlan, y: TaxableYear, n: Integer) strict {
    label en official "within the 2 following years: an amendment required by qualification or law";
    when b8_benefit_amendment_facts_431b8d(plan, y, n)
        and n >= 1 and n <= 2
        and amendment_required_for_qualification_or_law_431b8d(plan, y);
    then benefit_increase_may_take_effect_431b8d(plan, y);
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "If subparagraph (A) or (B) apply to a multiemployer plan for any plan year")
rule BenefitIncreaseMayTakeEffectAfterWindow431b8d(plan: MultiemployerPlan, y: TaxableYear, n: Integer) strict {
    label en official "outside the 2-year window (3 or more years after): no restriction of this paragraph";
    when b8_benefit_amendment_facts_431b8d(plan, y, n)
        and n >= 3;
    then benefit_increase_may_take_effect_431b8d(plan, y);
}

pub relation bond_value_amortized_431c2B(plan: MultiemployerPlan, y: TaxableYear, cost: Money, par: Money, years_elapsed: Integer, years_total: Integer) kind empirical {
    label en unofficial "the initial cost, par value, and elapsed and total years to maturity or earliest call of a bond not in default, case-asserted (the plan administrator elects the amortized basis)";
}

pub relation bond_amortized_value_431c2B(plan: MultiemployerPlan, y: TaxableYear, value: Money) kind institutional {
    label en official "section 431(c)(2)(B): at the administrator's election a bond not in default may be valued on an amortized basis from cost to par (straight-line: JUDGMENT CALL)";
}

@source(IRC_S431_C, relation = formalizes, coverage = partial, quote = "may, at the election of the plan administrator, be determined on an amortized basis running from initial cost at purchase to par value at maturity or earliest call date")
rule BondAmortizedValue431c2B(plan: MultiemployerPlan, y: TaxableYear, cost: Money, par: Money, elapsed: Integer, total: Integer) strict {
    label en official "PARTIAL (JUDGMENT CALL): straight-line cost + (par - cost) x elapsed / total; the election time is the Secretary's";
    when bond_value_amortized_431c2B(plan, y, cost, par, elapsed, total)
        and total > 0 and elapsed >= 0 and elapsed <= total;
    then bond_amortized_value_431c2B(plan, y, round(cost + (par - cost) * (1.0 * elapsed / (1.0 * total)), 2, "HALF_UP"));
}

pub relation liability_change_source_431c4(plan: MultiemployerPlan, y: TaxableYear, change_kind: Integer, increase_or_decrease: Money) kind empirical {
    label en unofficial "a change in benefits under the Social Security Act or other Federal or State retirement benefits (1), or a change in the definition of wages under section 3121 or in the wages taken into account under section 401(a)(5) regulations (2), and the resulting change in accrued liability (positive = increase), case-asserted";
}

pub relation change_treated_as_experience_gain_or_loss_431c4(plan: MultiemployerPlan, y: TaxableYear, loss: Money) kind institutional {
    label en official "section 431(c)(4): the change is treated as an experience loss (increase) or gain (decrease); a gain is a negative loss";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "such increase or decrease shall be treated as an experience loss or gain")
rule ChangeTreatedAsExperienceGainOrLoss431c4(plan: MultiemployerPlan, y: TaxableYear, kind: Integer, change: Money) strict {
    label en official "kinds 1 and 2";
    when liability_change_source_431c4(plan, y, kind, change)
        and kind >= 1 and kind <= 2;
    then change_treated_as_experience_gain_or_loss_431c4(plan, y, change);
}

pub relation plan_terminated_benefits_not_nonforfeitable_431c6C(plan: MultiemployerPlan, y: TaxableYear, accrued_liability: Money, forfeitable_after_termination: Money) kind empirical {
    label en unofficial "the accrued liability and the part attributable to benefits that are not nonforfeitable after termination (taking section 411(d)(3) into account), case-asserted";
}

pub relation accrued_liability_excluding_forfeitable_431c6C(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(c)(6)(C): unless the plan provides otherwise, accrued liability excludes benefits not nonforfeitable after termination";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "the accrued liability under a multiemployer plan shall not include benefits which are not nonforfeitable under the plan after the termination of the plan")
rule AccruedLiabilityExcludingForfeitable431c6C(plan: MultiemployerPlan, y: TaxableYear, liability: Money, forfeitable: Money) strict {
    label en official "liability - forfeitable part";
    when plan_terminated_benefits_not_nonforfeitable_431c6C(plan, y, liability, forfeitable);
    then accrued_liability_excluding_forfeitable_431c6C(plan, y, max(0 USD, liability - forfeitable));
}

pub enum ContingentEventKind431c6Dii {
    AgeServiceCompensationDeathDisability;
    ReasonablyAndReliablyPredictable;
    Unpredictable;
}

pub relation benefit_contingent_on_431c6Dii(plan: MultiemployerPlan, y: TaxableYear, benefit: Person, trigger: ContingentEventKind431c6Dii, amount: Money) kind empirical {
    label en unofficial "a benefit and the kind of the event it is contingent on, case-asserted";
}

pub relation event_has_occurred_431c6Dii(benefit: Person) kind empirical {
    label en unofficial "the event on which the benefit is contingent has occurred, case-asserted";
}

pub relation benefit_counted_in_current_liability_431c6D(plan: MultiemployerPlan, y: TaxableYear, benefit: Person, amount: Money) kind institutional {
    label en official "section 431(c)(6)(D): an unpredictable contingent event benefit is not taken into account until the event occurs";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "shall not be taken into account until the event on which the benefit is contingent occurs")
rule BenefitCountedInCurrentLiabilityPredictable431c6D(plan: MultiemployerPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "age, service, compensation, death or disability, or a predictable event";
    when benefit_contingent_on_431c6Dii(plan, y, benefit, AgeServiceCompensationDeathDisability, amount);
    then benefit_counted_in_current_liability_431c6D(plan, y, benefit, amount);
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "an event which is reasonably and reliably predictable (as determined by the Secretary)")
rule BenefitCountedInCurrentLiabilityReliable431c6D(plan: MultiemployerPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "reasonably and reliably predictable";
    when benefit_contingent_on_431c6Dii(plan, y, benefit, ReasonablyAndReliablyPredictable, amount);
    then benefit_counted_in_current_liability_431c6D(plan, y, benefit, amount);
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "any benefit contingent on an event other than")
rule BenefitCountedInCurrentLiabilityOccurred431c6D(plan: MultiemployerPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "unpredictable, once the event has occurred";
    when benefit_contingent_on_431c6Dii(plan, y, benefit, Unpredictable, amount)
        and event_has_occurred_431c6Dii(benefit);
    then benefit_counted_in_current_liability_431c6D(plan, y, benefit, amount);
}

pub relation assets_as_fraction_of_current_liability_431c7(plan: MultiemployerPlan, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the value of the plan's assets on the valuation date within the prior plan year as a fraction of the current liability, case-asserted";
}

pub relation prior_year_valuation_permitted_431c7bii(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(c)(7)(B)(ii): the valuation may be made as of a date within the prior plan year if assets are at least 100 percent of current liability";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "if, as of such date, the value of the assets of the plan are not less than 100 percent of the plan's current liability")
rule PriorYearValuationPermitted431c7bii(plan: MultiemployerPlan, y: TaxableYear, fraction: Decimal) strict {
    label en official "exact boundary: 100 percent is enough";
    when assets_as_fraction_of_current_liability_431c7(plan, y, fraction)
        and fraction >= 1.00;
    then prior_year_valuation_permitted_431c7bii(plan, y);
}

pub relation prior_year_valuation_method_change_permitted_431c7biv(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(c)(7)(B)(iv): a change to a prior-year valuation may not be made unless assets are at least 125 percent of current liability";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "may not be made unless as of the valuation date within the prior plan year, the value of the assets of the plan are not less than 125 percent of the plan's current liability")
rule PriorYearValuationMethodChangePermitted431c7biv(plan: MultiemployerPlan, y: TaxableYear, fraction: Decimal) strict {
    label en official "exact boundary: 125 percent is enough, 124.99 is not";
    when assets_as_fraction_of_current_liability_431c7(plan, y, fraction)
        and fraction >= 1.25;
    then prior_year_valuation_method_change_permitted_431c7biv(plan, y);
}

pub relation valuation_at_least_annually_431c7a(plan: MultiemployerPlan, y: TaxableYear, valuations_in_year: Integer) kind empirical {
    label en unofficial "the number of determinations of experience gains and losses and valuations of the plan's liability made for the year, case-asserted";
}

pub relation annual_valuation_requirement_met_431c7a(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(c)(7)(A): the determination and valuation are made not less frequently than once every year";
}

@source(IRC_S431_C, relation = formalizes, coverage = partial, quote = "a determination of experience gains and losses and a valuation of the plan's liability shall be made not less frequently than once every year")
rule AnnualValuationRequirementMet431c7a(plan: MultiemployerPlan, y: TaxableYear, n: Integer) strict {
    label en official "PARTIAL: at least one valuation per year; more frequent valuations by regulation are not pinned";
    when valuation_at_least_annually_431c7a(plan, y, n)
        and n >= 1;
    then annual_valuation_requirement_met_431c7a(plan, y);
}

pub relation extension_application_submitted_and_notice_431d3(plan: MultiemployerPlan, notice_provided_to_affected_parties: Boolean) kind empirical {
    label en unofficial "the applicant provided evidence satisfactory to the Secretary that notice of the filing was given to each affected party (ERISA section 4001(a)(21)), case-asserted";
}

pub relation extension_notice_requirement_met_431d3a(plan: MultiemployerPlan) kind institutional {
    label en official "section 431(d)(3)(A): before granting an extension the Secretary requires evidence that notice of the application was given to each affected party";
}

@source(IRC_S431_D, relation = formalizes, coverage = exact, quote = "The Secretary shall, before granting an extension under this subsection, require each applicant to provide evidence satisfactory to such Secretary that the applicant has provided notice of the filing of the application")
rule ExtensionNoticeRequirementMet431d3a(plan: MultiemployerPlan) strict {
    label en official "notice given";
    when extension_application_submitted_and_notice_431d3(plan, true);
    then extension_notice_requirement_met_431d3a(plan);
}

// =====================================================================
// 433: (b)(6), (c)(4)-(8),(10), (e)(3), (f)(2)-(6), (g), (h), (j)
// =====================================================================

pub relation csec_change_source_433c4(plan: DefinedBenefitPlan, y: TaxableYear, change_kind: Integer, increase_or_decrease: Money) kind empirical {
    label en unofficial "a change in Social Security or other Federal or State retirement benefits (1), or a change in the section 3121 wage definition or amount taken into account (2), and the resulting change in accrued liability, case-asserted";
}

pub relation csec_change_treated_as_experience_gain_or_loss_433c4(plan: DefinedBenefitPlan, y: TaxableYear, loss: Money) kind institutional {
    label en official "section 433(c)(4): the change is treated as an experience loss (increase) or gain (decrease)";
}

@source(IRC_S433_C, relation = formalizes, coverage = exact, quote = "such increase or decrease shall be treated as an experience loss or gain")
rule CsecChangeTreatedAsExperienceGainOrLoss433c4(plan: DefinedBenefitPlan, y: TaxableYear, kind: Integer, change: Money) strict {
    label en official "kinds 1 and 2";
    when csec_change_source_433c4(plan, y, kind, change)
        and kind >= 1 and kind <= 2;
    then csec_change_treated_as_experience_gain_or_loss_433c4(plan, y, change);
}

pub relation csec_funding_method_change_approved_433c5b(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the change of funding method (or plan year) is approved by the Secretary, case-asserted";
}

pub relation csec_funding_method_change_effective_433c5b(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 433(c)(5)(B): the new funding method or plan year becomes effective only if the Secretary approves";
}

@source(IRC_S433_C, relation = formalizes, coverage = exact, quote = "the new funding method shall become the funding method used to determine costs and liabilities under the plan only if the change is approved by the Secretary")
rule CsecFundingMethodChangeEffective433c5b(plan: DefinedBenefitPlan) strict {
    label en official "approved change";
    when csec_funding_method_change_approved_433c5b(plan);
    then csec_funding_method_change_effective_433c5b(plan);
}

pub relation csec_assets_as_fraction_of_current_liability_433c8(plan: DefinedBenefitPlan, y: TaxableYear, fraction: Decimal) kind empirical {
    label en unofficial "the value of the plan's assets on the prior-year valuation date as a fraction of the current liability, case-asserted";
}

pub relation csec_prior_year_valuation_permitted_433c8bii(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 433(c)(8)(B)(ii): a prior-year valuation date is permitted if assets are at least 100 percent of current liability";
}

@source(IRC_S433_C, relation = formalizes, coverage = exact, quote = "if, as of such date, the value of the assets of the plan are not less than 100 percent of the plan's current liability")
rule CsecPriorYearValuationPermitted433c8bii(plan: DefinedBenefitPlan, y: TaxableYear, fraction: Decimal) strict {
    label en official "exact boundary: 100 percent";
    when csec_assets_as_fraction_of_current_liability_433c8(plan, y, fraction)
        and fraction >= 1.00;
    then csec_prior_year_valuation_permitted_433c8bii(plan, y);
}

pub relation csec_prior_year_valuation_method_change_permitted_433c8biv(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 433(c)(8)(B)(iv): a change to a prior-year valuation requires assets of at least 125 percent of current liability";
}

@source(IRC_S433_C, relation = formalizes, coverage = exact, quote = "may not be made unless as of the valuation date within the prior plan year, the value of the assets of the plan are not less than 125 percent of the plan's current liability")
rule CsecPriorYearValuationMethodChangePermitted433c8biv(plan: DefinedBenefitPlan, y: TaxableYear, fraction: Decimal) strict {
    label en official "exact boundary: 125 percent";
    when csec_assets_as_fraction_of_current_liability_433c8(plan, y, fraction)
        and fraction >= 1.25;
    then csec_prior_year_valuation_method_change_permitted_433c8biv(plan, y);
}

pub relation csec_valuations_in_year_433c8a(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of determinations and valuations made for the year, case-asserted";
}

pub relation csec_annual_valuation_requirement_met_433c8a(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 433(c)(8)(A): determinations and valuations at least once every year";
}

@source(IRC_S433_C, relation = formalizes, coverage = partial, quote = "a determination of experience gains and losses and a valuation of the plan's liability shall be made not less frequently than once every year")
rule CsecAnnualValuationRequirementMet433c8a(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) strict {
    label en official "PARTIAL";
    when csec_valuations_in_year_433c8a(plan, y, n)
        and n >= 1;
    then csec_annual_valuation_requirement_met_433c8a(plan, y);
}

pub relation csec_interest_on_underpayment_period_433f2b(plan: DefinedBenefitPlan, y: TaxableYear, due: Date, contributed: Date, underpayment: Money, rate: Decimal) kind empirical {
    label en unofficial "the installment due date, the date the underpaid portion was contributed, the underpayment and the rate of interest under paragraph (1), case-asserted";
}

pub relation csec_underpayment_interest_433f2b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 433(f)(2)(B): interest runs from the due date to the date contributed (JUDGMENT CALL: simple interest, actual/365, HALF_UP)";
}

@source(IRC_S433_F, relation = formalizes, coverage = partial, quote = "shall run from the due date for the installment to the date on which such portion is contributed to or under the plan")
rule CsecUnderpaymentInterest433f2b(plan: DefinedBenefitPlan, y: TaxableYear, due: Date, cured: Date, under: Money, rate: Decimal) strict {
    label en official "PARTIAL: underpayment x rate x days/365";
    when csec_interest_on_underpayment_period_433f2b(plan, y, due, cured, under, rate)
        and cured >= due;
    then csec_underpayment_interest_433f2b(plan, y, round(under * rate * div_round(1.0 * days_between(due, cured), 365.0, 10, "HALF_UP"), 2, "HALF_UP"));
}

pub relation csec_lien_due_date_433g4b(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date) kind empirical {
    label en unofficial "the due date of the required installment or other payment on which the lien arose, case-asserted";
}

pub relation csec_last_day_of_first_year_plan_ceases_1B_433g4b(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, ends_on: Date) kind empirical {
    label en unofficial "the last day of the first plan year in which the plan ceases to be described in paragraph (1)(B), case-asserted";
}

pub relation csec_lien_query_date_433g4b(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date for which the lien period is asked about, case-asserted";
}

pub relation csec_lien_in_force_on_433g4b(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, on: Date) kind institutional {
    label en official "section 433(g)(4)(B): the lien arises on the due date and continues until the last day of the first plan year in which the plan ceases to be described in (1)(B)";
}

@source(IRC_S433_G, relation = formalizes, coverage = exact, quote = "The lien imposed by paragraph (1) shall arise on the due date for the required installment or other payment and shall continue until the last day of the first plan year")
rule CsecLienInForceOn433g4b(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, on: Date, due: Date, ends: Date) strict {
    label en official "exact boundaries: from the due date through the last day inclusive";
    when csec_lien_due_date_433g4b(plan, sponsor, y, due)
        and csec_last_day_of_first_year_plan_ceases_1B_433g4b(plan, sponsor, y, ends)
        and csec_lien_query_date_433g4b(plan, sponsor, y, on)
        and on >= due and on <= ends;
    then csec_lien_in_force_on_433g4b(plan, sponsor, y, on);
}

pub relation csec_lien_amount_components_433g3(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, unpaid_including_interest: Money, plan_year_begins_after_1987: Boolean, paid_before_due: Boolean) kind empirical {
    label en unofficial "the unpaid required installments and other payments (with interest), whether the plan year begins after 1987, and whether payment was made before the due date, case-asserted";
}

pub relation csec_lien_amount_433g3(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 433(g)(3): the aggregate unpaid balance (with interest) for plan years beginning after 1987 for which payment was not made before the due date";
}

@source(IRC_S433_G, relation = formalizes, coverage = exact, quote = "the amount of the lien shall be equal to the aggregate unpaid balance of required installments and other payments required under this section (including interest)")
rule CsecLienAmount433g3(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, unpaid: Money) strict {
    label en official "post-1987 unpaid payments";
    when csec_lien_amount_components_433g3(plan, sponsor, y, unpaid, true, false);
    then csec_lien_amount_433g3(plan, sponsor, y, unpaid);
}

pub relation csec_lien_enforcer_433g5(enforcer: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the person seeking to perfect or enforce the lien, case-asserted";
}

pub relation csec_enforcer_is_pbgc_433g5(enforcer: Person) kind empirical {
    label en unofficial "the enforcer is the PBGC, case-asserted";
}

pub relation csec_enforcer_directed_by_pbgc_433g5(enforcer: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the enforcer is a contributing employer (or controlled group member) acting at the PBGC's direction, case-asserted";
}

pub relation csec_lien_enforcement_permitted_433g5(enforcer: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 433(g)(5): a lien may be perfected and enforced only by the PBGC or, at its direction, by a contributing employer (or controlled group member)";
}

@source(IRC_S433_G, relation = formalizes, coverage = exact, quote = "may be perfected and enforced only by the Pension Benefit Guaranty Corporation")
rule CsecLienEnforcementPermittedPbgc433g5(enforcer: Person, plan: DefinedBenefitPlan) strict {
    label en official "PBGC";
    when csec_lien_enforcer_433g5(enforcer, plan) and csec_enforcer_is_pbgc_433g5(enforcer);
    then csec_lien_enforcement_permitted_433g5(enforcer, plan);
}

@source(IRC_S433_G, relation = formalizes, coverage = exact, quote = "or at the direction of the Pension Benefit Guaranty Corporation, by any contributing employer")
rule CsecLienEnforcementPermittedDirected433g5(enforcer: Person, plan: DefinedBenefitPlan) strict {
    label en official "at the PBGC's direction";
    when csec_lien_enforcer_433g5(enforcer, plan) and csec_enforcer_directed_by_pbgc_433g5(enforcer, plan);
    then csec_lien_enforcement_permitted_433g5(enforcer, plan);
}

pub relation csec_group_treated_as_single_employer_414_433g6b(a: Person, b: Person) kind empirical {
    label en unofficial "the persons are treated as a single employer under section 414(b), (c), (m) or (o), case-asserted";
}

pub relation csec_controlled_group_member_433g6b(a: Person, b: Person) kind institutional {
    label en official "section 433(g)(6)(B): controlled group means a group treated as a single employer under section 414(b), (c), (m) and (o)";
}

@source(IRC_S433_G, relation = formalizes, coverage = exact, quote = "The term \"controlled group\" means any group treated as a single employer under subsections (b), (c), (m), and (o) of section 414.")
rule CsecControlledGroupMember433g6b(a: Person, b: Person) strict {
    label en official "section 414 group";
    when csec_group_treated_as_single_employer_414_433g6b(a, b);
    then csec_controlled_group_member_433g6b(a, b);
}

pub enum CsecContingentEvent433h2 {
    AgeServiceCompensationDeathDisability;
    ReasonablyAndReliablyPredictable;
    Unpredictable;
}

pub relation csec_benefit_contingent_433h2(plan: DefinedBenefitPlan, y: TaxableYear, benefit: Person, trigger: CsecContingentEvent433h2, amount: Money) kind empirical {
    label en unofficial "a benefit and the kind of the event it is contingent on, case-asserted";
}

pub relation csec_event_occurred_433h2(benefit: Person) kind empirical {
    label en unofficial "the contingent event has occurred, case-asserted";
}

pub relation csec_benefit_counted_in_current_liability_433h2(plan: DefinedBenefitPlan, y: TaxableYear, benefit: Person, amount: Money) kind institutional {
    label en official "section 433(h)(2): an unpredictable contingent event benefit is not taken into account until the event occurs";
}

@source(IRC_S433_H, relation = formalizes, coverage = exact, quote = "any unpredictable contingent event benefit shall not be taken into account until the event on which the benefit is contingent occurs")
rule CsecBenefitCountedInCurrentLiabilityPredictable433h2(plan: DefinedBenefitPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "age, service, compensation, death, disability";
    when csec_benefit_contingent_433h2(plan, y, benefit, AgeServiceCompensationDeathDisability, amount);
    then csec_benefit_counted_in_current_liability_433h2(plan, y, benefit, amount);
}

@source(IRC_S433_H, relation = formalizes, coverage = exact, quote = "an event which is reasonably and reliably predictable (as determined by the Secretary)")
rule CsecBenefitCountedInCurrentLiabilityReliable433h2(plan: DefinedBenefitPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "reliably predictable";
    when csec_benefit_contingent_433h2(plan, y, benefit, ReasonablyAndReliablyPredictable, amount);
    then csec_benefit_counted_in_current_liability_433h2(plan, y, benefit, amount);
}

@source(IRC_S433_H, relation = formalizes, coverage = exact, quote = "The term \"unpredictable contingent event benefit\" means any benefit contingent on an event other than")
rule CsecBenefitCountedInCurrentLiabilityOccurred433h2(plan: DefinedBenefitPlan, y: TaxableYear, benefit: Person, amount: Money) strict {
    label en official "unpredictable, once the event has occurred";
    when csec_benefit_contingent_433h2(plan, y, benefit, Unpredictable, amount)
        and csec_event_occurred_433h2(benefit);
    then csec_benefit_counted_in_current_liability_433h2(plan, y, benefit, amount);
}

pub relation csec_participant_years_of_participation_433h4(participant: Person, plan: DefinedBenefitPlan, years: Integer) kind empirical {
    label en unofficial "the participant's years of participation, case-asserted";
}

pub relation csec_participant_condition_facts_433h4c(participant: Person, plan: DefinedBenefitPlan, no_other_db_benefit: Boolean, first_participant_after_1987: Boolean, service_exceeds_eligibility_minimum: Boolean) kind empirical {
    label en unofficial "the participant had accrued no other defined benefit (employer or controlled group), first became a participant in a plan year beginning after December 31, 1987, and has years of service greater than the eligibility minimum, case-asserted";
}

pub relation csec_employer_elects_out_433h4d(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employer elected that the paragraph does not apply, case-asserted";
}

pub relation csec_pre_participation_service_percentage_433h4b(participant: Person, plan: DefinedBenefitPlan, pct: Decimal) kind institutional {
    label en official "section 433(h)(4)(A)-(D): the applicable percentage of pre-participation service (1 year 20 percent, 2 years 40, 3 years 60, 4 years 80, 5 or more 100) for a participant meeting the conditions of (C), unless the employer elected out";
}

@source(IRC_S433_H, relation = formalizes, coverage = exact, quote = "only the applicable percentage of the years of service before such individual became a participant shall be taken into account in computing the current liability of the plan")
rule CsecPreParticipationServicePercentage433h4b(participant: Person, plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "the table of (B); the percentage is 1.00 from 5 years";
    when csec_participant_years_of_participation_433h4(participant, plan, years)
        and csec_participant_condition_facts_433h4c(participant, plan, true, true, true)
        and not_known(csec_employer_elects_out_433h4d(plan))
        and years >= 1;
    then csec_pre_participation_service_percentage_433h4b(participant, plan,
        if years >= 5 then 1.00 else 0.20 * years);
}

pub relation csec_normal_cost_entry_age_433j1b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the normal cost determined under the entry age normal funding method, case-asserted";
}

pub relation csec_plan_uses_spread_gain_method_433j1b(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan uses a spread gain funding method, case-asserted";
}

pub relation csec_normal_cost_for_restoration_433j1b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 433(j)(1)(B): for a CSEC plan using a spread gain method the normal cost is the entry age normal cost";
}

@source(IRC_S433_J, relation = formalizes, coverage = exact, quote = "the term \"normal cost\" means normal cost as determined under the entry age normal funding method")
rule CsecNormalCostForRestoration433j1b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "spread gain method";
    when csec_plan_uses_spread_gain_method_433j1b(plan)
        and csec_normal_cost_entry_age_433j1b(plan, y, amount);
    then csec_normal_cost_for_restoration_433j1b(plan, y, amount);
}

pub relation csec_funding_liability_estimate_433j4A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the estimate of the plan's funding liability based on the preceding year and reasonable actuarial estimates, case-asserted";
}

pub relation csec_anticipated_contributions_prior_year_433j4B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of contributions reasonably anticipated to be made for the preceding plan year, case-asserted";
}

pub relation csec_plan_assets_at_start_433j4(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of plan assets as of the beginning of the plan year, case-asserted";
}

pub relation csec_certification_funded_percentage_433j4(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 433(j)(4): the funded percentage as of the beginning of the year uses the estimated funding liability, with anticipated contributions counted";
}

@source(IRC_S433_J, relation = formalizes, coverage = exact, quote = "Contributions described in subparagraph (B) shall be taken into account in determining the plan's funded percentage as of the beginning of the plan year.")
rule CsecCertificationFundedPercentage433j4(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, contrib: Money, liability: Money) strict {
    label en official "(assets + anticipated contributions) / funding liability, 6 places HALF_UP";
    when csec_plan_assets_at_start_433j4(plan, y, assets)
        and csec_anticipated_contributions_prior_year_433j4B(plan, y, contrib)
        and csec_funding_liability_estimate_433j4A(plan, y, liability)
        and liability > 0 USD;
    then csec_certification_funded_percentage_433j4(plan, y, div_round((assets + contrib) / 1.00 USD, liability / 1.00 USD, 6, "HALF_UP"));
}

pub relation csec_certification_date_433j4(plan: DefinedBenefitPlan, y: TaxableYear, certified_on: Date, plan_year_start: Date) kind empirical {
    label en unofficial "the date the plan actuary certifies the funding restoration status and the first day of the plan year, case-asserted";
}

pub relation csec_certification_timely_433j4(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 433(j)(4): the certification is made not later than the 90th day of the plan year";
}

@source(IRC_S433_J, relation = formalizes, coverage = exact, quote = "Not later than the 90th day of each plan year of a CSEC plan, the plan actuary shall certify to the plan sponsor")
rule CsecCertificationTimely433j4(plan: DefinedBenefitPlan, y: TaxableYear, on: Date, start: Date) strict {
    label en official "exact boundary: day 90 of the plan year (the first day is day 1) is timely, day 91 is late";
    when csec_certification_date_433j4(plan, y, on, start)
        and on >= start
        and days_between(start, on) <= 89;
    then csec_certification_timely_433j4(plan, y);
}

pub relation csec_funding_liability_present_value_433j5c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 433(j)(5)(C): the funding liability is the present value of all benefits accrued or earned as of the beginning of the plan year, on the plan's assumptions with the (b)(5)(A) interest rate";
}

pub relation csec_pv_benefits_accrued_at_start_433j5c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of all benefits accrued or earned as of the beginning of the plan year, case-asserted";
}

@source(IRC_S433_J, relation = formalizes, coverage = partial, quote = "present value of all benefits accrued or earned under the plan as of the beginning of the plan year")
rule CsecFundingLiabilityPresentValue433j5c(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money) strict {
    label en official "PARTIAL: the present value is case-asserted";
    when csec_pv_benefits_accrued_at_start_433j5c(plan, y, pv);
    then csec_funding_liability_present_value_433j5c(plan, y, pv);
}

pub relation csec_sponsor_group_kind_433j5e(person: Person, plan: DefinedBenefitPlan, kind: Integer) kind empirical {
    label en unofficial "the person's kind (1 = the association, committee, joint board of trustees or similar group of representatives of the parties who establish or maintain the plan), case-asserted";
}

pub relation csec_plan_sponsor_433j5e(person: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 433(j)(5)(E): plan sponsor of a CSEC plan";
}

@source(IRC_S433_J, relation = formalizes, coverage = exact, quote = "The term \"plan sponsor\" means, with respect to a CSEC plan, the association, committee, joint board of trustees, or other similar group of representatives of the parties who establish or maintain the plan.")
rule CsecPlanSponsor433j5e(person: Person, plan: DefinedBenefitPlan, kind: Integer) strict {
    label en official "kind 1";
    when csec_sponsor_group_kind_433j5e(person, plan, kind) and kind == 1;
    then csec_plan_sponsor_433j5e(person, plan);
}

// =====================================================================
// 433(f)(5) liquidity requirement for CSEC plans
// =====================================================================

pub relation csec_liquid_assets_paid_in_installment_433f5a(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the value of the liquid assets paid in the installment, case-asserted";
}

pub relation csec_installment_treated_as_not_paid_liquidity_433f5a(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer) kind institutional {
    label en official "section 433(f)(5)(A): the installment is treated as not paid to the extent the liquid assets paid are less than the liquidity shortfall";
}

@source(IRC_S433_F, relation = formalizes, coverage = exact, quote = "to the extent that the value of the liquid assets paid in such installment is less than the liquidity shortfall")
rule CsecInstallmentTreatedAsNotPaidLiquidity433f5a(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, shortfall: Money, paid: Money) strict {
    label en official "exact boundary: liquid assets paid equal to the shortfall are enough";
    when csec_liquidity_shortfall_433f5(plan, y, quarter, shortfall)
        and csec_liquid_assets_paid_in_installment_433f5a(plan, y, quarter, paid)
        and paid < shortfall;
    then csec_installment_treated_as_not_paid_liquidity_433f5a(plan, y, quarter);
}

pub relation csec_required_to_pay_installments_433f5b(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is required to pay installments under the subsection for the plan year, case-asserted";
}

pub relation csec_liquidity_paragraph_applies_433f5b(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer) kind institutional {
    label en official "section 433(f)(5)(B): the paragraph applies to a plan required to pay installments that has a liquidity shortfall for a quarter";
}

@source(IRC_S433_F, relation = formalizes, coverage = exact, quote = "has a liquidity shortfall for any quarter during such plan year")
rule CsecLiquidityParagraphApplies433f5b(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, shortfall: Money) strict {
    label en official "installments required and a positive shortfall";
    when csec_required_to_pay_installments_433f5b(plan, y)
        and csec_liquidity_shortfall_433f5(plan, y, quarter, shortfall)
        and shortfall > 0 USD;
    then csec_liquidity_paragraph_applies_433f5b(plan, y, quarter);
}

pub relation csec_current_liability_with_expected_increase_433f5d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the current liability plus the expected increase due to benefits accruing or earned during the plan year, case-asserted";
}

pub relation csec_assets_and_prior_installments_433f5d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "plan assets plus the prior installments for the plan year, case-asserted";
}

pub relation csec_maximum_liquidity_increase_433f5d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 433(f)(5)(D): the increase cannot exceed the amount that brings the funded current liability percentage to 100 percent";
}

@source(IRC_S433_F, relation = formalizes, coverage = exact, quote = "in no event shall such increase exceed the amount which, when added to prior installments for the plan year, is necessary to increase the funded current liability percentage")
rule CsecMaximumLiquidityIncrease433f5d(plan: DefinedBenefitPlan, y: TaxableYear, liability: Money, have: Money) strict {
    label en official "max(0, liability - assets - prior installments)";
    when csec_current_liability_with_expected_increase_433f5d(plan, y, liability)
        and csec_assets_and_prior_installments_433f5d(plan, y, have);
    then csec_maximum_liquidity_increase_433f5d(plan, y, max(0 USD, liability - have));
}

pub relation csec_adjusted_disbursements_36_months_433f5eii2(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the sum of the adjusted disbursements for the 36 months ending on the last day of the quarter, case-asserted";
}

pub relation csec_nonrecurring_circumstances_certified_433f5eii2(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer) kind empirical {
    label en unofficial "an enrolled actuary certifies to the satisfaction of the Secretary that the excess is the result of nonrecurring circumstances, case-asserted";
}

pub relation csec_base_amount_without_nonrecurring_433f5eii2(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the base amount determined without regard to the amounts related to the nonrecurring circumstances, case-asserted";
}

pub relation csec_base_amount_twelve_months_433f5eii1(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind empirical {
    label en unofficial "the base amount under subclause (I): 3 times the adjusted disbursements for the 12 months ending on the last day of the quarter, case-asserted (module 32 computes the adjusted disbursements)";
}

pub relation csec_base_amount_433f5eii(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, amount: Money) kind institutional {
    label en official "section 433(f)(5)(E)(ii): 3 times the 12-month adjusted disbursements, or the alternative when the amount exceeds 2 times the 36-month figure and nonrecurring circumstances are certified";
}

@source(IRC_S433_F, relation = formalizes, coverage = exact, quote = "the base amount with respect to such quarter shall be determined without regard to amounts related to those nonrecurring circumstances")
rule CsecBaseAmountNonrecurring433f5eii(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, base: Money, adjusted36: Money, alt: Money) strict {
    label en official "exact boundary: the base must exceed 2 x the 36-month figure (equal does not exceed)";
    when csec_base_amount_twelve_months_433f5eii1(plan, y, quarter, base)
        and csec_adjusted_disbursements_36_months_433f5eii2(plan, y, quarter, adjusted36)
        and csec_nonrecurring_circumstances_certified_433f5eii2(plan, y, quarter)
        and csec_base_amount_without_nonrecurring_433f5eii2(plan, y, quarter, alt)
        and base > adjusted36 * 2.0;
    then csec_base_amount_433f5eii(plan, y, quarter, alt);
}

@source(IRC_S433_F, relation = formalizes, coverage = partial, quote = "an amount equal to 3 times the sum of the adjusted disbursements from the plan for the 12 months ending on the last day of such quarter")
rule CsecBaseAmountTwelveMonths433f5eii(plan: DefinedBenefitPlan, y: TaxableYear, quarter: Integer, base: Money) strict {
    label en official "PARTIAL: subclause (I) unless the special rule applies";
    when csec_base_amount_twelve_months_433f5eii1(plan, y, quarter, base)
        and not_known(csec_nonrecurring_circumstances_certified_433f5eii2(plan, y, quarter));
    then csec_base_amount_433f5eii(plan, y, quarter, base);
}
