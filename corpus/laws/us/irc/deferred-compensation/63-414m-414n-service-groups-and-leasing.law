// Sections 414(m) and 414(n) residuals — STAGE 3b (deferred-compensation,
// TECH_GAP reduction, 26.09.2026). Module 28 modelled the affiliated service
// group tests (m)(1)-(2) and the leased employee safe harbor core. Left as
// TECH_GAP and modelled here: (m)(3) service organization, (m)(4) the closed
// list of employee benefit requirements, (m)(5) management-function groups,
// (m)(6)(B) ownership with family attribution limits and their transaction
// treatment; (n)(1)(B) attribution of leasing contributions, (n)(3) the closed
// list of requirements, (n)(4) the time from which a leased employee counts
// and the years of service, (n)(5)(B) last sentence and (C) safe harbor
// definitions, (n)(6) related persons and common control.
//
// Method. A closed statutory list is an enumeration: membership in the enum
// IS the list (a member outside the enum cannot be asserted). Counts and
// amounts are exact; the section 318 attribution and the section 144(a)(3)
// related persons are case facts (analogical or cross-referenced text).

// =====================================================================
// (m)(3)-(5) Service organization, listed requirements, management groups
// =====================================================================

use self::{
    IRC_S414_M,
    IRC_S414_N,
    Person,
};

pub relation principal_business_is_performance_of_services_414m3(org: Person) kind empirical {
    label en unofficial "the principal business of the organization is the performance of services, case-asserted";
}

pub relation service_organization_414m3(org: Person) kind institutional {
    label en official "section 414(m)(3): an organization the principal business of which is the performance of services";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "the term \"service organization\" means an organization the principal business of which is the performance of services")
rule ServiceOrganization414m3(org: Person) strict {
    label en official "principal business of services";
    when principal_business_is_performance_of_services_414m3(org);
    then service_organization_414m3(org);
}

pub enum AffiliatedServiceRequirement414m4 {
    Section401a3;
    Section401a4;
    Section401a7;
    Section401a16;
    Section401a17;
    Section401a26;
    Section408k;
    Section408p;
    Section410;
    Section411;
    Section415;
    Section416;
}

pub relation requirement_under_affiliated_service_rule_414m4(requirement: AffiliatedServiceRequirement414m4) kind empirical {
    label en unofficial "the requirement is put to the affiliated service group rule of subsection (m)(1), case-asserted";
}

pub relation affiliated_service_rule_applies_to_requirement_414m4(requirement: AffiliatedServiceRequirement414m4) kind institutional {
    label en official "section 414(m)(4): the employee benefit requirements are paragraphs (3), (4), (7), (16), (17) and (26) of section 401(a) and sections 408(k), 408(p), 410, 411, 415 and 416 (the closed list is the enumeration)";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "the employee benefit requirements listed in this paragraph are")
rule AffiliatedServiceRuleAppliesToListedRequirement414m4(requirement: AffiliatedServiceRequirement414m4) strict {
    label en official "only listed requirements can be asserted";
    when requirement_under_affiliated_service_rule_414m4(requirement);
    then affiliated_service_rule_applies_to_requirement_414m4(requirement);
}

pub relation management_functions_principal_business_414m5A(manager: Person, managed: Person) kind empirical {
    label en unofficial "the principal business of the manager is performing, on a regular and continuing basis, management functions for the managed organization (or for it and organizations related to it), case-asserted";
}

pub relation related_organizations_144a3_414m5(a: Person, b: Person) kind empirical {
    label en unofficial "the organizations are related organizations in the sense of related persons under section 144(a)(3), case-asserted";
}

pub relation management_group_member_414m5(org: Person, manager: Person) kind institutional {
    label en official "section 414(m)(5): the manager, the organization for which it performs management functions, and organizations related to that organization are members of one affiliated service group";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "an organization the principal business of which is performing, on a regular and continuing basis, management functions for 1 organization")
rule ManagementGroupManager414m5A(manager: Person, managed: Person) strict {
    label en official "clause (A): the manager";
    when management_functions_principal_business_414m5A(manager, managed);
    then management_group_member_414m5(manager, manager);
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "the organization (and related organizations) for which such functions are so performed by the organization described in subparagraph (A)")
rule ManagementGroupManaged414m5B(manager: Person, managed: Person) strict {
    label en official "clause (B): the managed organization";
    when management_functions_principal_business_414m5A(manager, managed);
    then management_group_member_414m5(managed, manager);
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "the term \"related organizations\" has the same meaning as the term \"related persons\" when used in section 144(a)(3)")
rule ManagementGroupRelated414m5B(manager: Person, managed: Person, other: Person) strict {
    label en official "organizations related to the managed organization";
    when management_functions_principal_business_414m5A(manager, managed) and related_organizations_144a3_414m5(managed, other);
    then management_group_member_414m5(other, manager);
}

pub relation organization_is_corporation_partnership_or_other_414m6A(org: Person) kind empirical {
    label en unofficial "the organization is a corporation, partnership or other organization, case-asserted";
}

pub relation organization_414m6A(org: Person) kind institutional {
    label en official "section 414(m)(6)(A): a corporation, partnership or other organization";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "The term \"organization\" means a corporation, partnership, or other organization")
rule Organization414m6A(org: Person) strict {
    label en official "any of the three";
    when organization_is_corporation_partnership_or_other_414m6A(org);
    then organization_414m6A(org);
}

// (m)(6)(B) Ownership and family attribution

pub relation ownership_by_section_318_disregarding_community_property_414m6Bi(owner: Person, org: Person, percent: Decimal) kind empirical {
    label en unofficial "the owner's interest in the organization determined with the principles of section 318(a), disregarding community property laws, case-asserted (a computation of section 318)";
}

pub relation ownership_determined_414m6B(owner: Person, org: Person, percent: Decimal) kind institutional {
    label en official "section 414(m)(6)(B)(i), (ii)(I): ownership by the section 318(a) principles with community property laws disregarded";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "In determining ownership, the principles of section 318(a) shall apply, except that community property laws shall be disregarded for purposes of determining ownership")
rule OwnershipDetermined414m6B(owner: Person, org: Person, percent: Decimal) strict {
    label en official "the case-asserted section 318 computation without community property";
    when ownership_by_section_318_disregarding_community_property_414m6Bi(owner, org, percent);
    then ownership_determined_414m6B(owner, org, percent);
}

pub relation stock_attributed_to_spouse_from_child_under_21_414m6BiiII(individual: Person, spouse: Person) kind empirical {
    label en unofficial "stock of the individual would be attributed to the spouse only by the combined application of section 318(a)(1)(A)(ii) and (4), through a child who has not attained age 21, case-asserted";
}

pub relation individual_stock_attributed_to_spouse_under_318a1Ai_414m6BiiII(individual: Person, spouse: Person) kind empirical {
    label en unofficial "the individual's stock is attributed to the spouse under section 318(a)(1)(A)(i), case-asserted";
}

pub relation stock_not_attributed_to_spouse_via_child_414m6BiiII(individual: Person, spouse: Person) kind institutional {
    label en official "section 414(m)(6)(B)(ii)(II): except as the Secretary provides, stock not attributed to the spouse under 318(a)(1)(A)(i) is not attributed to the spouse through a child under age 21";
}

@source(IRC_S414_M, relation = formalizes, coverage = partial, quote = "stock of an individual not attributed under section 318(a)(1)(A)(i) to such individual's spouse shall not be attributed by reason of the combined application of paragraphs (1)(A)(ii) and (4) of section 318(a) to such spouse from a child who has not attained the age of 21 years")
rule StockNotAttributedToSpouseViaChild414m6BiiII(individual: Person, spouse: Person) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when stock_attributed_to_spouse_from_child_under_21_414m6BiiII(individual, spouse)
        and not_known(individual_stock_attributed_to_spouse_under_318a1Ai_414m6BiiII(individual, spouse));
    then stock_not_attributed_to_spouse_via_child_414m6BiiII(individual, spouse);
}

pub relation stock_in_different_organizations_attributed_to_child_under_21_414m6BiiIII(org_a: Person, org_b: Person, child: Person) kind empirical {
    label en unofficial "stock in two organizations is attributed to a child under age 21 from each parent under section 318(a)(1)(A)(ii), the parents not being spouses under section 318(a)(1)(A)(i), case-asserted";
}

pub relation organizations_not_grouped_by_child_attribution_alone_414m6BiiIII(org_a: Person, org_b: Person) kind institutional {
    label en official "section 414(m)(6)(B)(ii)(III): the attribution to the child does not by itself make the organizations members of the same affiliated service group";
}

@source(IRC_S414_M, relation = formalizes, coverage = partial, quote = "such attribution to the child shall not by itself result in such organizations being members of the same affiliated service group")
rule OrganizationsNotGroupedByChildAttribution414m6BiiIII(org_a: Person, org_b: Person, child: Person) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when stock_in_different_organizations_attributed_to_child_under_21_414m6BiiIII(org_a, org_b, child);
    then organizations_not_grouped_by_child_attribution_alone_414m6BiiIII(org_a, org_b);
}

pub relation family_attribution_rule_changed_group_status_414m6Biii(org_a: Person, org_b: Person) kind empirical {
    label en unofficial "the application of clause (ii) causes two or more entities to be an affiliated service group, or to no longer be, case-asserted";
}

pub relation change_treated_as_410b6C_transaction_414m6Biii(org_a: Person, org_b: Person) kind institutional {
    label en official "section 414(m)(6)(B)(iii): the change is treated as a transaction to which section 410(b)(6)(C) applies";
}

@source(IRC_S414_M, relation = formalizes, coverage = exact, quote = "such change shall be treated as a transaction to which section 410(b)(6)(C) applies")
rule ChangeTreatedAs410b6CTransaction414m6Biii(org_a: Person, org_b: Person) strict {
    label en official "a relation the section 410(b)(6)(C) module reads only when a case asserts it";
    when family_attribution_rule_changed_group_status_414m6Biii(org_a, org_b);
    then change_treated_as_410b6C_transaction_414m6Biii(org_a, org_b);
}

// =====================================================================
// (n)(1)(B), (n)(3), (n)(4), (n)(5)(B)-(C), (n)(6)
// =====================================================================

pub relation leasing_contribution_attributable_to_recipient_services_414n1B(recipient: Person, leased: Person, amount: Money) kind empirical {
    label en unofficial "contributions or benefits provided by the leasing organization attributable to services the leased employee performs for the recipient, case-asserted";
}

pub relation leasing_contribution_treated_as_provided_by_recipient_414n1B(recipient: Person, leased: Person, amount: Money) kind institutional {
    label en official "section 414(n)(1)(B): contributions or benefits provided by the leasing organization attributable to services for the recipient are treated as provided by the recipient";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "contributions or benefits provided by the leasing organization which are attributable to services performed for the recipient shall be treated as provided by the recipient")
rule LeasingContributionTreatedAsProvidedByRecipient414n1B(recipient: Person, leased: Person, amount: Money) strict {
    label en official "the attributable amount";
    when leasing_contribution_attributable_to_recipient_services_414n1B(recipient, leased, amount);
    then leasing_contribution_treated_as_provided_by_recipient_414n1B(recipient, leased, amount);
}

pub enum LeasedEmployeeRequirement414n3 {
    Section401a3;
    Section401a4;
    Section401a7;
    Section401a16;
    Section401a17;
    Section401a26;
    Section408k;
    Section408p;
    Section410;
    Section411;
    Section415;
    Section416;
    Section79;
    Section106;
    Section117d;
    Section125;
    Section127;
    Section129;
    Section132;
    Section137;
    Section274j;
    Section505;
    Section4980B;
}

pub relation requirement_under_leased_employee_rule_414n3(requirement: LeasedEmployeeRequirement414n3) kind empirical {
    label en unofficial "the requirement is put to the leased employee rule of subsection (n)(1), case-asserted";
}

pub relation leased_employee_rule_applies_to_requirement_414n3(requirement: LeasedEmployeeRequirement414n3) kind institutional {
    label en official "section 414(n)(3): section 401(a)(3), (4), (7), (16), (17), (26); sections 408(k), 408(p), 410, 411, 415, 416; and sections 79, 106, 117(d), 125, 127, 129, 132, 137, 274(j), 505 and 4980B (the closed list is the enumeration)";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "the requirements listed in this paragraph are")
rule LeasedEmployeeRuleAppliesToListedRequirement414n3(requirement: LeasedEmployeeRequirement414n3) strict {
    label en official "only listed requirements can be asserted";
    when requirement_under_leased_employee_rule_414n3(requirement);
    then leased_employee_rule_applies_to_requirement_414n3(requirement);
}

pub relation leased_employee_one_year_period_closed_on_414n4A(recipient: Person, leased: Person, on: Date) kind empirical {
    label en unofficial "the last day of the period referred to in paragraph (2)(B) (at least 1 year of substantially full-time services), case-asserted";
}

pub relation period_start_asked_414n4A(recipient: Person, leased: Person, start: Date) kind empirical {
    label en unofficial "the first day of the period for which the treatment as an employee is asked, case-asserted";
}

pub relation leased_employee_treated_as_employee_for_period_414n4A(recipient: Person, leased: Person, start: Date) kind institutional {
    label en official "section 414(n)(4)(A): paragraph (1) applies only for periods after the close of the 1-year period of paragraph (2)(B)";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "paragraph (1) shall apply only for purposes of determining whether the requirements listed in paragraph (3) are met for periods after the close of the period referred to in paragraph (2)(B)")
rule LeasedEmployeeTreatedAsEmployeeForPeriod414n4A(recipient: Person, leased: Person, start: Date, closed: Date) strict {
    label en official "exact boundary: a period beginning the day after the close is covered; the closing day itself is not";
    when leased_employee_one_year_period_closed_on_414n4A(recipient, leased, closed)
        and period_start_asked_414n4A(recipient, leased, start)
        and start > closed;
    then leased_employee_treated_as_employee_for_period_414n4A(recipient, leased, start);
}

pub relation years_of_service_for_recipient_414n4B(person: Person, recipient: Person, years: Decimal) kind empirical {
    label en unofficial "the person's years of service for the recipient without the leased period, case-asserted";
}

pub relation years_as_leased_employee_but_for_1_year_414n4B(person: Person, recipient: Person, years: Decimal) kind empirical {
    label en unofficial "the period for which the person would have been a leased employee but for the requirements of paragraph (2)(B), in years, case-asserted";
}

pub relation years_of_service_including_leased_period_414n4B(person: Person, recipient: Person, years: Decimal) kind institutional {
    label en official "section 414(n)(4)(B): years of service for the recipient include any period the person would have been a leased employee but for the 1-year requirement";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "years of service for the recipient shall be determined by taking into account any period for which such employee would have been a leased employee but for the requirements of paragraph (2)(B)")
rule YearsOfServiceIncludingLeasedPeriod414n4B(person: Person, recipient: Person, base: Decimal, leased: Decimal) strict {
    label en official "base years plus the leased period";
    when years_of_service_for_recipient_414n4B(person, recipient, base) and years_as_leased_employee_but_for_1_year_414n4B(person, recipient, leased);
    then years_of_service_including_leased_period_414n4B(person, recipient, base + leased);
}

pub relation leasing_org_compensation_each_year_of_4_414n5B(individual: Person, c1: Money, c2: Money, c3: Money, c4: Money) kind empirical {
    label en unofficial "the individual's compensation from the leasing organization in each plan year of the 4-year period ending with the plan year, case-asserted";
}

pub relation immediate_participation_not_required_414n5Biii(individual: Person) kind institutional {
    label en official "section 414(n)(5)(B) last sentence: clause (iii) (immediate participation) does not apply to an individual whose compensation from the leasing organization is under $1,000 in each plan year of the 4-year period";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "Clause (iii) shall not apply to any individual whose compensation from the leasing organization in each plan year during the 4-year period ending with the plan year is less than $1,000")
rule ImmediateParticipationNotRequired414n5Biii(individual: Person, c1: Money, c2: Money, c3: Money, c4: Money) strict {
    label en official "exact boundary: $999.99 is below $1,000, $1,000 is not";
    when leasing_org_compensation_each_year_of_4_414n5B(individual, c1, c2, c3, c4)
        and c1 < 1000.00 USD and c2 < 1000.00 USD and c3 < 1000.00 USD and c4 < 1000.00 USD;
    then immediate_participation_not_required_414n5Biii(individual);
}

pub relation employee_count_full_time_year_nonhighly_414n5Cii1(recipient: Person, count: Integer) kind empirical {
    label en unofficial "the number of individuals (other than highly compensated employees) who are employees of the recipient (without regard to the subsection) and have performed services for the recipient (or the recipient and related persons) substantially full-time for at least 1 year, case-asserted";
}

pub relation leased_employee_count_nonhighly_414n5Cii2(recipient: Person, count: Integer) kind empirical {
    label en unofficial "the number of leased employees with respect to the recipient (determined without regard to the paragraph) other than highly compensated employees, case-asserted";
}

pub relation nonhighly_compensated_work_force_414n5Cii(recipient: Person, count: Integer) kind institutional {
    label en official "section 414(n)(5)(C)(ii): the aggregate number of non-highly compensated individuals who are long-service employees of the recipient or leased employees";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "nonhighly compensated work force")
rule NonhighlyCompensatedWorkForce414n5Cii(recipient: Person, employees: Integer, leased: Integer) strict {
    label en official "sum of the two counts";
    when employee_count_full_time_year_nonhighly_414n5Cii1(recipient, employees) and leased_employee_count_nonhighly_414n5Cii2(recipient, leased);
    then nonhighly_compensated_work_force_414n5Cii(recipient, employees + leased);
}

pub relation leased_employees_within_20_percent_of_work_force_414n5Aii(recipient: Person) kind institutional {
    label en official "section 414(n)(5)(A)(ii): leased employees do not exceed 20 percent of the recipient's nonhighly compensated work force";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "leased employees (determined without regard to this paragraph) do not constitute more than 20 percent of the recipient's nonhighly compensated work force")
rule LeasedEmployeesWithin20Percent414n5Aii(recipient: Person, leased: Integer, force: Integer) strict {
    label en official "exact by cross-multiplication: leased x 100 <= force x 20 (exactly 20 percent is allowed)";
    when leased_employee_count_nonhighly_414n5Cii2(recipient, leased)
        and nonhighly_compensated_work_force_414n5Cii(recipient, force)
        and leased * 100 <= force * 20;
    then leased_employees_within_20_percent_of_work_force_414n5Aii(recipient);
}

pub relation compensation_section_415_and_additions_414n5Ciii(individual: Person, base_415: Money, cash_deferral: Money, cafeteria: Money, salary_reduction_403b: Money) kind empirical {
    label en unofficial "compensation as used in section 415 and the three additions: employer contributions under a qualified cash or deferred arrangement excluded under section 402(e)(3) or 402(h)(1)(B), amounts foregone under a cafeteria plan, and section 403(b) salary reduction contributions, case-asserted";
}

pub relation compensation_414n5Ciii(individual: Person, total: Money) kind institutional {
    label en official "section 414(n)(5)(C)(iii): compensation as in section 415 plus the CODA contributions, cafeteria plan amounts and 403(b) salary reduction amounts";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "The term \"compensation\" has the same meaning as when used in section 415; except that such term shall include")
rule Compensation414n5Ciii(individual: Person, base: Money, cash: Money, cafeteria: Money, tsa: Money) strict {
    label en official "sum of the four components";
    when compensation_section_415_and_additions_414n5Ciii(individual, base, cash, cafeteria, tsa);
    then compensation_414n5Ciii(individual, base + cash + cafeteria + tsa);
}

pub relation highly_compensated_414q_414n5Ci(individual: Person) kind empirical {
    label en unofficial "the individual is a highly compensated employee within the meaning of section 414(q), case-asserted (the classification is module 12/28)";
}

pub relation highly_compensated_employee_by_414q_414n5Ci(individual: Person) kind institutional {
    label en official "section 414(n)(5)(C)(i): highly compensated employee has the meaning of section 414(q)";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "The term \"highly compensated employee\" has the meaning given such term by section 414(q)")
rule HighlyCompensatedEmployeeBy414q414n5Ci(individual: Person) strict {
    label en official "the section 414(q) classification is a case fact here";
    when highly_compensated_414q_414n5Ci(individual);
    then highly_compensated_employee_by_414q_414n5Ci(individual);
}

pub relation related_persons_144a3_414n6A(a: Person, b: Person) kind empirical {
    label en unofficial "the persons are related persons in the sense of section 144(a)(3), case-asserted";
}

pub relation related_persons_for_leasing_414n6A(a: Person, b: Person) kind institutional {
    label en official "section 414(n)(6)(A): related persons has the meaning used in section 144(a)(3)";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "The term \"related persons\" has the same meaning as when used in section 144(a)(3)")
rule RelatedPersonsForLeasing414n6A(a: Person, b: Person) strict {
    label en official "section 144(a)(3) status is a case fact";
    when related_persons_144a3_414n6A(a, b);
    then related_persons_for_leasing_414n6A(a, b);
}

pub relation entities_under_common_control_or_affiliated_service_414n6B(a: Person, b: Person) kind empirical {
    label en unofficial "the entities are treated as one employer under section 414(b), (c), (m) or (o), case-asserted";
}

pub relation common_control_rules_apply_414n6B(a: Person, b: Person) kind institutional {
    label en official "section 414(n)(6)(B): the rules of subsections (b), (c), (m) and (o) apply";
}

@source(IRC_S414_N, relation = formalizes, coverage = exact, quote = "The rules of subsections (b), (c), (m), and (o) shall apply")
rule CommonControlRulesApply414n6B(a: Person, b: Person) strict {
    label en official "entities treated as one employer are one recipient or leasing organization";
    when entities_under_common_control_or_affiliated_service_414n6B(a, b);
    then common_control_rules_apply_414n6B(a, b);
}
