// Section 401 residual sentences and their special rules — STAGE 3c
// (deferred-compensation, last TECH_GAP pass, 26.09.2026). Same pattern as
// modules 61-79: facts asserted by the case produce a treatment relation;
// nothing here is a verified or legally reviewed reading. Amounts the Code
// leaves to the Secretary's regulations (actuarial reduction, equivalence) are
// supplied by the case and marked JUDGMENT CALL. Bounded unrolling depth,
// where used, is named in the rule label.

// =====================================================================
// 401(a)(14) early retirement benefit continuation
// =====================================================================

use self::{
    CustodialAccountOrContract401f,
    DefinedContributionPlan,
    Distribution,
    IRC_S401_A,
    IRC_S401_F,
    IRC_S401_M,
    IRC_S401_O,
    Person,
    Plan,
    TaxableYear,
    applicable_defined_contribution_plan,
    applicable_percentage_401a35H,
    coverage_not_significantly_changed_410b6C,
    custodial_assets_held_by_401f,
    evaluated_on_410b6C,
    group_change_date_410b6C,
    participant_age55_with_3_years_before_2006_plan_year,
    participates_in,
    plan_year_end_after_change_410b6C,
    would_be_qualified_trust_but_for_form,
};

pub relation early_retirement_continuation_facts_401a14(plan: Plan, participant: Person, plan_provides_early_retirement_benefit: Boolean, satisfied_service_requirement: Boolean, separated_before_age_requirement_with_nonforfeitable_benefit: Boolean) kind empirical {
    label en unofficial "the plan pays an early retirement benefit; the participant satisfied its service requirements but separated (with a nonforfeitable accrued benefit) before its age requirement, case-asserted";
}

pub relation early_retirement_continuation_amounts_401a14(plan: Plan, participant: Person, entitled_benefit: Money, normal_retirement_benefit_actuarially_reduced: Money) kind empirical {
    label en unofficial "the benefit the plan gives on satisfaction of the age requirement, and the normal retirement age benefit actuarially reduced under the Secretary's regulations (supplied by the case), case-asserted";
}

pub relation early_retirement_continuation_met_401a14(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(14): the participant is entitled upon the age requirement to a benefit not less than the actuarially reduced normal retirement benefit";
}

@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "In the case of a plan which provides for the payment of an early retirement benefit, a trust")
rule EarlyRetirementContinuationMet401a14(plan: Plan, participant: Person, entitled: Money, reduced: Money) strict {
    label en official "PARTIAL/JUDGMENT CALL: the actuarial reduction under regulations is a case-supplied amount; met when the entitlement is at least that amount (equality qualifies)";
    when early_retirement_continuation_facts_401a14(plan, participant, true, true, true)
        and early_retirement_continuation_amounts_401a14(plan, participant, entitled, reduced)
        and entitled >= reduced;
    then early_retirement_continuation_met_401a14(plan, participant);
}

// =====================================================================
// 401(a)(9): surviving spouse who dies before distributions begin;
// applicable multi-beneficiary trust (H)(iv)
// =====================================================================

pub relation surviving_spouse_death_facts_401a9B(spouse: Person, employee: Person, spouse_died_before_distributions_to_spouse_began: Boolean) kind empirical {
    label en unofficial "the surviving spouse who is treated as the employee died before distributions to the spouse began, case-asserted";
}

pub relation subparagraph_applied_as_if_spouse_is_employee_401a9B(spouse: Person, employee: Person) kind institutional {
    label en official "section 401(a)(9)(B): if the surviving spouse dies before her distributions begin, the subparagraph is applied as if the surviving spouse were the employee (a second application over the spouse's own beneficiaries)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(III) if the surviving spouse dies before the distributions to such spouse begin, this subparagraph")
rule SubparagraphAppliedAsIfSpouseIsEmployee401a9B(spouse: Person, employee: Person) strict {
    label en official "the second application of the same rule with the spouse in the employee's role is a relation over the pair; the chained beneficiaries are supplied by the case as new facts about the spouse";
    when surviving_spouse_death_facts_401a9B(spouse, employee, true);
    then subparagraph_applied_as_if_spouse_is_employee_401a9B(spouse, employee);
}

pub relation multi_beneficiary_trust_beneficiary_401a9H(trust: Plan, beneficiary: Person, is_eligible_designated_beneficiary_under_E_ii_III_or_IV: Boolean) kind empirical {
    label en unofficial "a beneficiary of the applicable multi-beneficiary trust and whether that beneficiary is an eligible designated beneficiary described in subclause (III) or (IV) of subparagraph (E)(ii), case-asserted";
}

pub relation trust_divided_on_death_into_separate_trusts_401a9Hiv(trust: Plan) kind empirical {
    label en unofficial "the terms of the trust divide it immediately upon the death of the employee into separate trusts for each beneficiary, case-asserted";
}

pub relation trust_no_beneficiary_right_until_edbs_die_401a9Hiv(trust: Plan) kind empirical {
    label en unofficial "no beneficiary (other than an eligible designated beneficiary described in subclause (III) or (IV) of (E)(ii)) has any right to the employee's interest until all such eligible designated beneficiaries die, case-asserted";
}

pub relation trust_described_in_401a9Hiv_I(trust: Plan) kind institutional {
    label en official "section 401(a)(9)(H)(iv)(I): the trust is divided on the employee's death into separate trusts for each beneficiary";
}

pub relation trust_described_in_401a9Hiv_II(trust: Plan) kind institutional {
    label en official "section 401(a)(9)(H)(iv)(II): no other beneficiary has a right to the interest until the death of all the eligible designated beneficiaries";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(I) it is to be divided immediately upon the death of the employee into separate trusts for each")
rule TrustDescribed401a9Hiv_I(trust: Plan) strict {
    label en official "divided into separate trusts";
    when trust_divided_on_death_into_separate_trusts_401a9Hiv(trust);
    then trust_described_in_401a9Hiv_I(trust);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(II) no beneficiary (other than a [1] eligible designated beneficiary described in subclause (III)")
rule TrustDescribed401a9Hiv_II(trust: Plan) strict {
    label en official "no other beneficiary's right until the eligible designated beneficiaries die";
    when trust_no_beneficiary_right_until_edbs_die_401a9Hiv(trust);
    then trust_described_in_401a9Hiv_II(trust);
}

pub relation clause_ii_applied_separately_to_portion_401a9Hiv(trust: Plan, edb: Person) kind institutional {
    label en official "section 401(a)(9)(H)(iv): clause (ii) is applied separately to the portion of the interest payable to the eligible designated beneficiary (one application per beneficiary portion)";
}

pub relation subparagraph_biii_applies_to_interest_401a9Hiv(trust: Plan) kind institutional {
    label en official "section 401(a)(9)(H)(iv): for a trust described in subclause (II), subparagraph (B)(iii) applies to the distribution of the employee's interest";
}

pub relation beneficiary_treated_as_beneficiary_of_edb_401a9Hiv(trust: Plan, other_beneficiary: Person, edb: Person) kind institutional {
    label en official "section 401(a)(9)(H)(iv): a beneficiary who is not such an eligible designated beneficiary is treated as a beneficiary of the eligible designated beneficiary upon that beneficiary's death";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "for purposes of a trust described in subclause (I), clause (ii) shall be applied separately with")
rule ClauseIiAppliedSeparately401a9Hiv(trust: Plan, edb: Person) strict {
    label en official "trust of subclause (I): one application per eligible designated beneficiary portion";
    when trust_described_in_401a9Hiv_I(trust)
        and multi_beneficiary_trust_beneficiary_401a9H(trust, edb, true);
    then clause_ii_applied_separately_to_portion_401a9Hiv(trust, edb);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "for purposes of a trust described in subclause (I), clause (ii) shall be applied separately with")
rule SubparagraphBiiiAppliesToInterest401a9Hiv(trust: Plan) strict {
    label en official "trust of subclause (II): (B)(iii) applies to the distribution of the interest";
    when trust_described_in_401a9Hiv_II(trust);
    then subparagraph_biii_applies_to_interest_401a9Hiv(trust);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "for purposes of a trust described in subclause (I), clause (ii) shall be applied separately with")
rule BeneficiaryTreatedAsBeneficiaryOfEdb401a9Hiv(trust: Plan, other: Person, edb: Person) strict {
    label en official "trust of subclause (II): a non-eligible beneficiary is treated as a beneficiary of the eligible designated beneficiary";
    when trust_described_in_401a9Hiv_II(trust)
        and multi_beneficiary_trust_beneficiary_401a9H(trust, other, false)
        and multi_beneficiary_trust_beneficiary_401a9H(trust, edb, true);
    then beneficiary_treated_as_beneficiary_of_edb_401a9Hiv(trust, other, edb);
}

// =====================================================================
// 401(a)(11)(D)-type survivor annuity for an offset (paragraph (13)(D))
// =====================================================================

pub enum SurvivorAssumption401a13D {
    TerminatedOnOffsetDate;
    NoOffset;
    CommencementOnlyAtNormalRetirementAge;
    OnlyMinimumRequiredQjsa;
    QpsaEqualsQjsaSurvivorAnnuity;
}

pub relation survivor_annuity_assumption_applied_401a13D(participant: Person, offset_on: Date, assumption: SurvivorAssumption401a13D) kind empirical {
    label en unofficial "the survivor annuity determination proceeded under this assumption of subparagraph (D)(i), case-asserted";
}

pub relation joint_life_annuity_amount_401a13D(participant: Person, offset_on: Date, joint_life_annuity: Money) kind empirical {
    label en unofficial "the annual amount payable during the joint lives under the qualified joint and survivor annuity that is the actuarial equivalent of the accrued benefit (section 411(a)(7)), supplied by the case as actuarial input";
}

pub relation minimum_required_qjsa_survivor_annuity_401a13Dii(participant: Person, offset_on: Date, survivor_annuity: Money) kind institutional {
    label en official "section 401(a)(13)(D)(ii): the survivor annuity under the minimum-required qualified joint and survivor annuity is 50 percent of the annuity payable during the joint lives";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(ii) Definition.—For purposes of this subparagraph, the term \"minimum-required qualified joint and")
rule MinimumRequiredQjsaSurvivorAnnuity401a13Dii(participant: Person, on: Date, joint: Money) strict {
    label en official "JUDGMENT CALL: the actuarial equivalence to the accrued benefit is the case-supplied joint-life amount; survivor = 50 percent of it, cents HALF_UP";
    when joint_life_annuity_amount_401a13D(participant, on, joint);
    then minimum_required_qjsa_survivor_annuity_401a13Dii(participant, on, round(joint * 0.5, 2, "HALF_UP"));
}

pub relation survivor_annuity_determined_under_assumptions_401a13Di(participant: Person, offset_on: Date, survivor_annuity: Money) kind institutional {
    label en official "section 401(a)(13)(D)(i): the survivor annuity of an offset, determined as if all five assumptions held";
}

@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "(I) the participant terminated employment on the date of the offset,")
@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "(II) there was no offset,")
@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "(III) the plan permitted commencement of benefits only on or after normal retirement age,")
@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "(IV) the plan provided only the minimum-required qualified joint and survivor annuity, and")
@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "(V) the amount of the qualified preretirement survivor annuity under the plan is equal to the")
rule SurvivorAnnuityDetermined401a13Di(participant: Person, on: Date, amount: Money) strict {
    label en official "PARTIAL/JUDGMENT CALL: the counterfactual plan is not rebuilt; the five assumptions (I)-(V) are asserted as applied, and under (IV)-(V) the preretirement survivor annuity equals the survivor annuity of the minimum-required qjsa";
    when survivor_annuity_assumption_applied_401a13D(participant, on, TerminatedOnOffsetDate)
        and survivor_annuity_assumption_applied_401a13D(participant, on, NoOffset)
        and survivor_annuity_assumption_applied_401a13D(participant, on, CommencementOnlyAtNormalRetirementAge)
        and survivor_annuity_assumption_applied_401a13D(participant, on, OnlyMinimumRequiredQjsa)
        and survivor_annuity_assumption_applied_401a13D(participant, on, QpsaEqualsQjsaSurvivorAnnuity)
        and minimum_required_qjsa_survivor_annuity_401a13Dii(participant, on, amount);
    then survivor_annuity_determined_under_assumptions_401a13Di(participant, on, amount);
}

// =====================================================================
// 401(a)(26)(E), (F) dispositions and lines of business
// =====================================================================

pub relation min_participation_met_before_change_401a26E(plan: Plan) kind empirical {
    label en unofficial "the paragraph (26) requirements were met immediately before each change in the group, case-asserted";
}

pub relation paragraph_26_treated_as_met_in_transition_401a26E(plan: Plan) kind institutional {
    label en official "section 401(a)(26)(E): rules similar to section 410(b)(6)(C): the paragraph is treated as met during the transition period after a disposition or acquisition";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(E) Special rule for certain dispositions or acquisitions.—Rules similar to the rules of section")
rule Paragraph26TreatedAsMetInTransition401a26E(plan: Plan, change: Date, end: Date, today: Date) strict {
    label en official "explicit incorporation of the section 410(b)(6)(C) rule (module 41): the same date window and the same not-significantly-changed gate, applied to the paragraph (26) requirements; exact boundaries from the change date through the last day of the first plan year after it";
    when min_participation_met_before_change_401a26E(plan)
        and group_change_date_410b6C(plan, change)
        and plan_year_end_after_change_410b6C(plan, end)
        and evaluated_on_410b6C(plan, today)
        and coverage_not_significantly_changed_410b6C(plan)
        and today >= change
        and today <= end;
    then paragraph_26_treated_as_met_in_transition_401a26E(plan);
}

pub relation line_of_business_separate_application_facts_401a26F(employer: Person, plan: Plan, line_of_business: Person, election_exercised: Boolean) kind empirical {
    label en unofficial "the employer elects to apply paragraph (26) separately to a separate line of business (section 414(r) without paragraphs (2)(A) or (7)), case-asserted (exercise atom)";
}

pub relation secretary_consents_to_line_of_business_election_401a26F(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the Secretary consented to the election, case-asserted";
}

pub relation election_exercise_401a26F(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer's election to apply the paragraph separately to each separate line of business, case-asserted (exercise atom)";
}

pub relation paragraph_26_applied_separately_by_line_of_business_401a26F(employer: Person, plan: Plan) kind institutional {
    label en official "section 401(a)(26)(F): the paragraph is applied separately with respect to each separate line of business of the employer";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(F) Separate lines of business.—At the election of the employer and with the consent of the")
rule ElectSeparateLineOfBusiness401a26F(employer: Person, plan: Plan) strict {
    label en official "a power of the employer valid only with the Secretary's consent; without consent the exercise is an invalid attempt and has no effect";
    when election_exercise_401a26F(employer, plan);
    then power ElectSeparateLineOfBusinessPower {
        holder employer;
        over plan;
        exercise election_exercise_401a26F(employer, plan);
        valid_when secretary_consents_to_line_of_business_election_401a26F(employer, plan);
        effect paragraph_26_applied_separately_by_line_of_business_401a26F(employer, plan);
    };
}

// =====================================================================
// 401(a)(26)(I)(iv) spun-off plans, 401(a)(28)(B), (31), (35)
// =====================================================================

pub relation spin_off_protected_treatment_facts_401a26Iiv(original: Plan, spun_off: Plan, other_employer: Person, spun_off_plan_treated_under_clause_i: Boolean) kind empirical {
    label en unofficial "a portion of a plan described in clause (i) is spun off to another employer, and the spun-off plan was treated under clause (i), case-asserted";
}

pub relation protected_treatment_continues_for_other_employer_401a26Iiv(spun_off: Plan, other_employer: Person) kind institutional {
    label en official "the treatment under clause (i) of the spun-off plan continues with respect to the other employer";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(iv) Spun-off plans.—For purposes of this subparagraph, if a portion of a plan described in clause")
rule ProtectedTreatmentContinuesForSpunOffPlan401a26Iiv(original: Plan, spun: Plan, other: Person) strict {
    label en official "spun-off portion of a protected plan";
    when spin_off_protected_treatment_facts_401a26Iiv(original, spun, other, true);
    then protected_treatment_continues_for_other_employer_401a26Iiv(spun, other);
}

pub relation first_plan_year_as_qualified_participant_401a28B(participant: Person, plan: Plan, year: Integer, employer_elects_1988_for_1987: Boolean) kind empirical {
    label en unofficial "the calendar year in which the plan year began in which the individual first became a qualified participant, and whether the employer elects to treat one first becoming a qualified participant in the first plan year beginning in 1987 as becoming one in 1988, case-asserted";
}

pub relation qualified_election_period_start_401a28B(participant: Person, plan: Plan, start_year: Integer) kind institutional {
    label en official "section 401(a)(28)(B)(iv): the qualified election period begins with the later of the first plan year as a qualified participant or the first plan year beginning after December 31, 1986 (with the 1988 election)";
}

pub relation qualified_election_period_end_401a28B(participant: Person, plan: Plan, end_year: Integer) kind institutional {
    label en official "section 401(a)(28)(B)(iv): the qualified election period is the 6-plan-year period beginning with the start year";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(I) the 1st plan year in which the individual first became a qualified participant, or")
rule QualifiedElectionPeriodStartFromParticipation401a28B(participant: Person, plan: Plan, y: Integer) strict {
    label en official "(I) is the later one when the year is 1987 or later and no 1988 election applies";
    when first_plan_year_as_qualified_participant_401a28B(participant, plan, y, false)
        and y >= 1987;
    then qualified_election_period_start_401a28B(participant, plan, y);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(I) the 1st plan year in which the individual first became a qualified participant, or")
rule QualifiedElectionPeriodStartFromParticipationAfter1987401a28B(participant: Person, plan: Plan, y: Integer) strict {
    label en official "(I) is the later one when the year is after 1987 (the election does not matter)";
    when first_plan_year_as_qualified_participant_401a28B(participant, plan, y, true)
        and y >= 1988;
    then qualified_election_period_start_401a28B(participant, plan, y);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(II) the 1st plan year beginning after December 31, 1986.")
rule QualifiedElectionPeriodStartFrom1987401a28B(participant: Person, plan: Plan, y: Integer, e: Boolean) strict {
    label en official "(II): a qualified participant before 1987 starts with the first plan year beginning after December 31, 1986 (calendar year 1987 for a calendar plan year)";
    when first_plan_year_as_qualified_participant_401a28B(participant, plan, y, e)
        and y < 1987;
    then qualified_election_period_start_401a28B(participant, plan, 1987);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, an employer may elect to treat an individual first becoming")
rule QualifiedElectionPeriodStartElection1988401a28B(participant: Person, plan: Plan) strict {
    label en official "the employer's election moves a first-1987 qualified participant to 1988";
    when first_plan_year_as_qualified_participant_401a28B(participant, plan, 1987, true);
    then qualified_election_period_start_401a28B(participant, plan, 1988);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(I) the 1st plan year in which the individual first became a qualified participant, or")
rule QualifiedElectionPeriodEnd401a28B(participant: Person, plan: Plan, s: Integer) strict {
    label en official "6 plan years: start year plus 5";
    when qualified_election_period_start_401a28B(participant, plan, s);
    then qualified_election_period_end_401a28B(participant, plan, s + 5);
}

pub relation diversification_election_inapplicable_401a28Bv(plan: DefinedContributionPlan) kind institutional {
    label en official "section 401(a)(28)(B)(v): subparagraph (B) does not apply to an applicable defined contribution plan";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(v) Exception.—This subparagraph shall not apply to an applicable defined contribution plan (as")
rule DiversificationElectionInapplicableToApplicableDcPlan401a28Bv(plan: DefinedContributionPlan) defeasible {
    label en official "wired to the paragraph (35)(E) definition (module 24)";
    when applicable_defined_contribution_plan(plan);
    then diversification_election_inapplicable_401a28Bv(plan);
}

pub relation transfer_target_facts_401a31C(d: Distribution, target: Plan, is_dc_qualified_trust_that_separately_accounts: Boolean, is_eligible_retirement_plan_402c8B_i_or_ii: Boolean) kind empirical {
    label en unofficial "the plan to which the eligible rollover distribution is transferred: a qualified defined contribution trust that agrees to separately account, or an eligible retirement plan described in section 402(c)(8)(B)(i) or (ii), case-asserted";
}

pub relation includible_portion_limit_inapplicable_401a31C(d: Distribution, target: Plan) kind institutional {
    label en official "section 401(a)(31)(C): the limit to the includible portion does not apply when the transferee is a separately accounting defined contribution trust or an eligible retirement plan under 402(c)(8)(B)(i) or (ii)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(i) is a qualified trust which is part of a plan which is a defined contribution plan and agrees to")
rule IncludiblePortionLimitInapplicableSeparateAccounting401a31C(d: Distribution, target: Plan, b: Boolean) strict {
    label en official "(i)";
    when transfer_target_facts_401a31C(d, target, true, b);
    then includible_portion_limit_inapplicable_401a31C(d, target);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(ii) is an eligible retirement plan described in clause (i) or (ii) of section 402(c)(8)(B).")
rule IncludiblePortionLimitInapplicableEligibleRetirementPlan401a31C(d: Distribution, target: Plan, a: Boolean) strict {
    label en official "(ii)";
    when transfer_target_facts_401a31C(d, target, a, true);
    then includible_portion_limit_inapplicable_401a31C(d, target);
}

pub relation applicable_percentage_for_participant_401a35H(plan: DefinedContributionPlan, who: Person, pct: Decimal) kind institutional {
    label en official "section 401(a)(35)(H): the applicable percentage for the participant: 100 percent for a participant aged 55 with 3 years of service before the 2006 plan year (the phase-in does not apply), otherwise the table percentage";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(II) Exception for certain participants aged 55 or over.—Subclause (I) shall not apply to an")
rule ApplicablePercentageParticipantException401a35H(plan: DefinedContributionPlan, who: Person) strict {
    label en official "(II): the phase-in of subclause (I) does not apply, so the whole account is covered";
    when participant_age55_with_3_years_before_2006_plan_year(plan, who);
    then applicable_percentage_for_participant_401a35H(plan, who, 100.0);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "(II) Exception for certain participants aged 55 or over.—Subclause (I) shall not apply to an")
rule ApplicablePercentageParticipantTable401a35H(plan: DefinedContributionPlan, who: Person, pct: Decimal) strict {
    label en official "otherwise the table percentage of subclause (I) applies (33/66/100)";
    when applicable_percentage_401a35H(plan, pct)
        and participates_in(who, plan)
        and not_known(participant_age55_with_3_years_before_2006_plan_year(plan, who));
    then applicable_percentage_for_participant_401a35H(plan, who, pct);
}

// =====================================================================
// 401(f), 401(m)(2)(A)
// =====================================================================

pub relation custodial_holder_treated_as_trustee_401f(account: CustodialAccountOrContract401f, holder: Person) kind institutional {
    label en official "section 401(f): for purposes of this title the person holding the assets of the custodial account (or holding the contract) is treated as the trustee";
}

@source(IRC_S401_F, relation = formalizes, coverage = exact, quote = "For purposes of this title, in the case of a custodial account or contract treated as a qualified")
rule CustodialHolderTreatedAsTrustee401f(account: CustodialAccountOrContract401f, holder: Person) strict {
    label en official "the account is treated as a qualified trust by reason of subsection (f), and the holder is read from the module 25 holder relation";
    when would_be_qualified_trust_but_for_form(account)
        and custodial_assets_held_by_401f(account, holder);
    then custodial_holder_treated_as_trustee_401f(account, holder);
}

pub relation acp_test_year_election_401m2A(plan: Plan, y: TaxableYear, employer_elects_plan_year: Boolean) kind empirical {
    label en unofficial "whether the employer elected to apply the contribution percentage test using the plan year rather than the preceding plan year, case-asserted";
}

pub relation acp_test_uses_plan_year_401m2A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(2)(A): the test is applied using the plan year when the employer so elects";
}

pub relation acp_test_uses_preceding_plan_year_401m2A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(2)(A): the test is applied using the preceding plan year unless the employer elects the plan year";
}

@source(IRC_S401_M, relation = formalizes, coverage = partial, quote = "This subparagraph may be applied by using the plan year rather than the preceding plan year if the")
rule AcpTestUsesPlanYearWhenElected401m2A(plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: the election to use the plan year";
    when acp_test_year_election_401m2A(plan, y, true);
    then acp_test_uses_plan_year_401m2A(plan, y);
}

@source(IRC_S401_M, relation = formalizes, coverage = partial, quote = "This subparagraph may be applied by using the plan year rather than the preceding plan year if the")
rule AcpTestUsesPrecedingYearWithoutElection401m2A(plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: without the election the preceding plan year is used";
    when acp_test_year_election_401m2A(plan, y, false);
    then acp_test_uses_preceding_plan_year_401m2A(plan, y);
}

pub relation acp_election_made_by_employer_401m2A(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the employer made the election of subparagraph (A), case-asserted (bearer atom)";
}

pub relation acp_election_changed_401m2A(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the employer changes the election, case-asserted (action atom)";
}

pub relation secretary_provides_election_change_401m2A(plan: Plan) kind empirical {
    label en unofficial "the Secretary has provided that the election may be changed, case-asserted";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "This subparagraph may be applied by using the plan year rather than the preceding plan year if the")
rule AcpElectionChangeProhibition401m2A(plan: Plan, employer: Person) strict {
    label en official "once made, the election may not be changed except as provided by the Secretary; the prohibition does not arise when the Secretary has so provided";
    when acp_election_made_by_employer_401m2A(plan, employer)
        and not_known(secretary_provides_election_change_401m2A(plan));
    then prohibition AcpElectionChangeProhibition {
        bearer employer;
        action acp_election_changed_401m2A(plan, employer);
        window [-infinity, infinity];
    };
}

// =====================================================================
// 401(o): matching contributions in the aggregated portion, merger
// changes, spin-offs, closed-class relief
// =====================================================================

pub relation aggregated_matching_contribution_401o1Bii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the matching contributions in the portion aggregated under subparagraph (B)(ii), case-asserted";
}

pub relation matching_treated_as_nonelective_401o1Bii(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(o)(1)(B)(ii)(II): the matching contributions are treated in the same manner as nonelective contributions";
}

pub relation matching_treated_as_nonelective_for_401l_401o1Bii(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(o)(1)(B)(ii)(II): the same treatment applies for the rules of subsection (l); consumers of the section 401(l) module read this relation for such matching contributions";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(II) such matching contributions shall be treated in the same manner as nonelective contributions,")
rule MatchingTreatedAsNonelective401o1Bii(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "same amount, nonelective treatment";
    when aggregated_matching_contribution_401o1Bii(plan, y, amount);
    then matching_treated_as_nonelective_401o1Bii(plan, y, amount);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(II) such matching contributions shall be treated in the same manner as nonelective contributions,")
rule MatchingTreatedAsNonelectiveFor401l401o1Bii(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "JUDGMENT CALL: the relation is derived for the section 401(l) module to read; that module is not rewritten here (pub interfaces unchanged)";
    when aggregated_matching_contribution_401o1Bii(plan, y, amount);
    then matching_treated_as_nonelective_for_401l_401o1Bii(plan, y, amount);
}

pub relation population_change_after_class_closed_401o1Biii(plan: Plan, individual: Person, by_reason_of_merger_acquisition_divestiture_or_similar_event: Boolean, after_class_closed: Boolean) kind empirical {
    label en unofficial "an individual became or ceased to be an employee by reason of a merger, acquisition, divestiture or similar event, and whether that was after the class was closed, case-asserted";
}

pub relation population_change_disregarded_401o1Ai(plan: Plan, individual: Person) kind institutional {
    label en official "section 401(o)(1)(A)(iii): the change in the employee population attributable to the individual is disregarded";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(iii) Changes in the employee population shall be disregarded to the extent attributable to")
rule PopulationChangeDisregarded401o1Ai(plan: Plan, individual: Person) strict {
    label en official "disregarded when after the closing and by reason of the event";
    when population_change_after_class_closed_401o1Biii(plan, individual, true, true);
    then population_change_disregarded_401o1Ai(plan, individual);
}

pub relation db_spin_off_facts_401o1j(original: Plan, spun_off: Plan, other_employer: Person, original_within_3_year_period: Boolean, spun_off_meets_clause_i: Boolean, spun_off_meets_clause_ii: Boolean) kind empirical {
    label en unofficial "a portion of a defined benefit plan described in subparagraph (A) or (B)(iii) is spun off to another employer; whether the original plan was still within the 3-year period; whether the spun-off plan continues to satisfy the applicable clause (i) and clause (ii), case-asserted";
}

pub relation db_spin_off_described_401o1j(spun_off: Plan, other_employer: Person) kind institutional {
    label en official "section 401(o)(1)(j): a portion of a plan described in (A) or (B)(iii) was spun off to another employer";
}

pub relation db_spin_off_clause_i_ok_401o1j(spun_off: Plan) kind institutional {
    label en official "section 401(o)(1)(j)(i): the spun-off plan continues to satisfy (A)(i) or (B)(iii)(II) if the original was still within the 3-year period; otherwise this clause is not required";
}

pub relation db_spin_off_clause_ii_ok_401o1j(spun_off: Plan) kind institutional {
    label en official "section 401(o)(1)(j)(ii): the spun-off plan continues to satisfy (A)(ii) or (B)(iii)(III)";
}

pub relation db_spin_off_treatment_continues_401o1j(spun_off: Plan, other_employer: Person) kind institutional {
    label en official "section 401(o)(1)(j): the treatment under subparagraph (A) or (B) of the spun-off plan continues with respect to the other employer";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, if a portion of a defined benefit plan described in subparagraph")
rule DbSpinOffDescribed401o1j(original: Plan, spun: Plan, other: Person) strict {
    label en official "chapeau";
    when db_spin_off_facts_401o1j(original, spun, other, _, _, _);
    then db_spin_off_described_401o1j(spun, other);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(i) subparagraph (A)(i) or (B)(iii)(II), whichever is applicable, if the original plan was still")
rule DbSpinOffClauseIRequired401o1j(original: Plan, spun: Plan, other: Person, b: Boolean) strict {
    label en official "in the 3-year period: clause (i) must be met";
    when db_spin_off_facts_401o1j(original, spun, other, true, true, b);
    then db_spin_off_clause_i_ok_401o1j(spun);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(i) subparagraph (A)(i) or (B)(iii)(II), whichever is applicable, if the original plan was still")
rule DbSpinOffClauseINotRequired401o1j(original: Plan, spun: Plan, other: Person, a: Boolean, b: Boolean) strict {
    label en official "after the 3-year period: clause (i) is not required";
    when db_spin_off_facts_401o1j(original, spun, other, false, a, b);
    then db_spin_off_clause_i_ok_401o1j(spun);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "(ii) subparagraph (A)(ii) or (B)(iii)(III), whichever is applicable,")
rule DbSpinOffClauseIiOk401o1j(original: Plan, spun: Plan, other: Person, w: Boolean, a: Boolean) strict {
    label en official "clause (ii) must be met";
    when db_spin_off_facts_401o1j(original, spun, other, w, a, true);
    then db_spin_off_clause_ii_ok_401o1j(spun);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the treatment under subparagraph (A) or (B) of the spun-off plan shall continue with respect to")
rule DbSpinOffTreatmentContinues401o1j(original: Plan, spun: Plan, other: Person) strict {
    label en official "both clauses satisfied";
    when db_spin_off_described_401o1j(spun, other)
        and db_spin_off_clause_i_ok_401o1j(spun)
        and db_spin_off_clause_ii_ok_401o1j(spun)
        and db_spin_off_facts_401o1j(original, spun, other, _, _, _);
    then db_spin_off_treatment_continues_401o1j(spun, other);
}

pub relation closed_class_dc_relief_facts_401o2C(dc_plan: Plan, db_plan: Plan, closed_class_accruals_reduced_or_eliminated: Boolean, otherwise_meets_subparagraph_A_but_for_matching: Boolean, make_whole_made_in_whole_or_part_through_matching: Boolean) kind empirical {
    label en unofficial "a defined contribution plan gives benefits, rights or features to a closed class whose defined benefit accruals were reduced or eliminated; the plans otherwise meet subparagraph (A) but for the make-whole contributions made through matching contributions, case-asserted";
}

pub relation dc_plan_not_failing_a4_by_closed_class_composition_401o2C(dc_plan: Plan) kind institutional {
    label en official "section 401(o)(2)(C): the plan does not fail section 401(a)(4) solely by reason of the composition of the closed class or the benefits, rights or features provided to it";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "In the case of a defined contribution plan which provides benefits, rights, or features to a closed")
rule DcClosedClassRelief401o2C(dc_plan: Plan, db_plan: Plan) strict {
    label en official "all three limbs";
    when closed_class_dc_relief_facts_401o2C(dc_plan, db_plan, true, true, true);
    then dc_plan_not_failing_a4_by_closed_class_composition_401o2C(dc_plan);
}

pub relation dc_spin_off_facts_401o2D(original: Plan, spun_off: Plan, other_employer: Person, original_within_3_year_period: Boolean, spun_off_meets_clause_ii: Boolean, spun_off_meets_clause_iii: Boolean) kind empirical {
    label en unofficial "a portion of a defined contribution plan described in (A) or (C) is spun off to another employer; whether the original was still within the 3-year period; whether the spun-off plan continues to comply with clause (ii) (if in the period) and clause (iii), case-asserted";
}

pub relation dc_spin_off_treatment_continues_401o2D(spun_off: Plan, other_employer: Person) kind institutional {
    label en official "section 401(o)(2)(D): the treatment under (A) or (C) of the spun-off plan continues with respect to the other employer";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, if a portion of a defined contribution plan described in")
rule DcSpinOffTreatmentContinuesInPeriod401o2D(original: Plan, spun: Plan, other: Person) strict {
    label en official "in the 3-year period: clauses (ii) and (iii) must both be met";
    when dc_spin_off_facts_401o2D(original, spun, other, true, true, true);
    then dc_spin_off_treatment_continues_401o2D(spun, other);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, if a portion of a defined contribution plan described in")
rule DcSpinOffTreatmentContinuesAfterPeriod401o2D(original: Plan, spun: Plan, other: Person, m: Boolean) strict {
    label en official "after the 3-year period: only clause (iii) must be met";
    when dc_spin_off_facts_401o2D(original, spun, other, false, m, true);
    then dc_spin_off_treatment_continues_401o2D(spun, other);
}
