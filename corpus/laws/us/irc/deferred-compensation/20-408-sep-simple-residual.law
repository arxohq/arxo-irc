// Section 408 — STAGE 2e residual, part 2 (IRC-09, DECISION-0379,
// 25.09.2026): (k) simplified employee pension (definition, (3) uniform
// relationship test, (4), (5), (6) salary-reduction SEP, (7)), (l) employer
// and trustee reports, (o) designated nondeductible contributions, (p)(5)-(12)
// SIMPLE retirement accounts. Module 07 holds (a), (d)-(e), (k)(2), (m), (p)(1)-(4).
//
// Conventions as in modules 07 and 19: empirical facts for the terms of an
// arrangement, `not_known` for the absence of a disqualifying term, `duty` /
// `power` / `prohibition` for who must do or may do what, one derived atom
// per `valid_when`. The uniform-relationship test of (k)(3)(C) is exact
// cross-multiplication over pairs of employees (no division, no rounding);
// the deferral-percentage averages of (k)(6)(A)(iii) are case-asserted
// because an average over a derived per-employee ratio is an aggregate over a
// derived predicate (section 111; TECH-GAPS registry).

// =====================================================================
// (k)(1)-(5) Simplified employee pension
// =====================================================================

use self::{
    IRC_S408_K,
    IRC_S408_L,
    IRC_S408_O,
    IRC_S408_P,
    Individual,
    Person,
    Plan,
    TaxableYear,
    highly_compensated_employee,
    ira_nondeductible_contribution_designated,
    ira_year_end,
    participates_in,
    section219_deduction_amount,
    sep_compensation_for_year,
    sep_employer_contribution,
    sep_participation_requirement_met,
    simple_matching_contribution_required,
};

pub relation sep_plan_of(sep: Plan, employer: Person) kind empirical {
    label en unofficial "this individual retirement account or annuity is a simplified employee pension arrangement of the employer, case-asserted";
}

pub relation sep_in_force(sep: Plan, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the arrangement is maintained by the employer as a simplified employee pension for this year, case-asserted";
}

pub relation sep_employee_received_contribution(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employee received an employer contribution to a simplified employee pension for the year (helper: a negated fully-bound atom instead of an existential negation)";
}

rule SepEmployeeReceivedContribution(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the helper from any employer contribution fact";
    when sep_employer_contribution(employer, employee, y, amount);
    then sep_employee_received_contribution(employee, employer, y);
}

pub relation sep_eligible_employee_omitted(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(2): some employee meeting the age, service and compensation conditions received no contribution";
}

@source(IRC_S408_K, relation = formalizes, coverage = partial, quote = "The requirements of this paragraph are met with respect to a simplified employee pension for a year if for such year the contributions made by the employer to simplified employee pensions for his employees do not discriminate in favor of any highly compensated employee")
rule SepEligibleEmployeeOmitted(employer: Person, y: TaxableYear, employee: Person) strict {
    label en unofficial "an employee for whom the (k)(2) participation requirement is met but no contribution was made";
    when sep_participation_requirement_met(employee, employer, y)
        and not_known(sep_employee_received_contribution(employee, employer, y));
    then sep_eligible_employee_omitted(employer, y);
}

pub relation sep_requirement_k2_met(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(1)(A) via (2): the employer contributes for every employee meeting the participation conditions";
}

rule SepRequirementK2Met(employer: Person, y: TaxableYear, sep: Plan) strict {
    label en unofficial "met while a simplified employee pension is in force for the year and no eligible employee is omitted";
    when sep_in_force(sep, employer, y)
        and not_known(sep_eligible_employee_omitted(employer, y));
    then sep_requirement_k2_met(employer, y);
}

// (3) Nondiscrimination -----------------------------------------------

external judgment relation sep_contributions_nondiscriminatory(employer: Person, y: TaxableYear) {
    authority Secretary;
    label en official "section 408(k)(3)(A): the employer's contributions to simplified employee pensions do not discriminate in favor of any highly compensated employee (section 414(q)) — an evaluative determination, not computed here";
}

pub relation sep_employee_excluded_410b3(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is described in section 410(b)(3)(A) or (C) (excluded from consideration under (k)(3)(B)), case-asserted";
}

pub relation sep_disparity_permitted_401l2(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contributions satisfy the permitted-disparity rules of section 401(l)(2) as applied by (k)(3)(D), case-asserted (section 401(l) is in this package's stage 2e queue)";
}

pub relation sep_contributions_nonuniform(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(3)(C): two employees' contributions do not bear a uniform relationship to compensation (each compensation limited to the first $200,000)";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "employer contributions to simplified employee pensions (other than contributions under an arrangement described in paragraph (6)) shall be considered discriminatory unless contributions thereto bear a uniform relationship to the compensation")
rule SepContributionsNonuniform(employer: Person, y: TaxableYear, e1: Person, e2: Person, c1: Money, c2: Money, comp1: Money, comp2: Money) strict {
    label en official "contribution1 / capped compensation1 differs from contribution2 / capped compensation2 (exact Money / Money quotients, no rounding)";
    when sep_employer_contribution(employer, e1, y, c1)
        and sep_employer_contribution(employer, e2, y, c2)
        and sep_compensation_for_year(e1, employer, y, comp1)
        and sep_compensation_for_year(e2, employer, y, comp2)
        and not_known(sep_employee_excluded_410b3(e1, employer, y))
        and not_known(sep_employee_excluded_410b3(e2, employer, y))
        and c1 / min(comp1, SECTION401A17_COMPENSATION_LIMIT) != c2 / min(comp2, SECTION401A17_COMPENSATION_LIMIT);
    then sep_contributions_nonuniform(employer, y);
}

pub relation sep_contributions_deemed_discriminatory(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(3)(C)/(D): non-uniform contributions are considered discriminatory unless the section 401(l)(2) disparity rules are met";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "the rules of section 401(l)(2) shall apply to contributions to simplified employee pensions")
rule SepContributionsDeemedDiscriminatory(employer: Person, y: TaxableYear) defeasible {
    label en official "non-uniform contributions are considered discriminatory unless the section 401(l)(2) disparity rules are met ((k)(3)(C) with the (D) exception)";
    when sep_contributions_nonuniform(employer, y);
    unless sep_disparity_permitted_401l2(employer, y);
    then sep_contributions_deemed_discriminatory(employer, y);
}

pub relation sep_requirement_k3_met(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(3): no discrimination in favor of highly compensated employees";
}

rule SepRequirementK3Met(employer: Person, y: TaxableYear) defeasible {
    label en unofficial "the (A) evaluative test holds and (C) does not deem the contributions discriminatory";
    when sep_contributions_nondiscriminatory(employer, y)
        and not_known(sep_contributions_deemed_discriminatory(employer, y));
    then sep_requirement_k3_met(employer, y);
}

// (4) and (5) -----------------------------------------------------------

pub relation sep_contribution_conditioned_on_retention(sep: Plan) kind empirical {
    label en unofficial "employer contributions are conditioned on the retention in the pension of any portion of the amount contributed (defeats (k)(4)(A)), case-asserted";
}

pub relation sep_withdrawals_prohibited_by_employer(sep: Plan) kind empirical {
    label en unofficial "the employer prohibits withdrawals from the simplified employee pension (defeats (k)(4)(B)), case-asserted";
}

pub relation sep_requirement_k4_met(sep: Plan) kind institutional {
    label en official "section 408(k)(4): no retention condition and no prohibition on withdrawals";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "employer contributions thereto are not conditioned on the retention in such pension of any portion of the amount contributed")
rule SepRequirementK4Met(sep: Plan, employer: Person) strict {
    label en official "both negative conditions together";
    when sep_plan_of(sep, employer)
        and not_known(sep_contribution_conditioned_on_retention(sep))
        and not_known(sep_withdrawals_prohibited_by_employer(sep));
    then sep_requirement_k4_met(sep);
}

pub relation sep_definite_written_formula(sep: Plan) kind empirical {
    label en unofficial "employer contributions are determined under a definite written allocation formula, case-asserted";
}

pub relation sep_formula_specifies_eligibility(sep: Plan) kind empirical {
    label en unofficial "the formula specifies the requirements an employee must satisfy to share in an allocation, case-asserted (k)(5)(A)";
}

pub relation sep_formula_specifies_computation(sep: Plan) kind empirical {
    label en unofficial "the formula specifies the manner in which the amount allocated is computed, case-asserted (k)(5)(B)";
}

pub relation sep_requirement_k5_met(sep: Plan) kind institutional {
    label en official "section 408(k)(5): a definite written allocation formula specifying eligibility and computation";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "employer contributions to such pension are determined under a definite written allocation formula which specifies")
rule SepRequirementK5Met(sep: Plan) strict {
    label en official "formula plus both specifications";
    when sep_definite_written_formula(sep)
        and sep_formula_specifies_eligibility(sep)
        and sep_formula_specifies_computation(sep);
    then sep_requirement_k5_met(sep);
}

// (1) definition ---------------------------------------------------------

pub relation sep_top_heavy(sep: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the account or annuity is part of a top-heavy plan (section 416), case-asserted";
}

pub relation sep_meets_416c2(sep: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of section 416(c)(2) are met, case-asserted";
}

pub relation simplified_employee_pension(sep: Plan, y: TaxableYear) kind institutional {
    label en official "section 408(k)(1): an individual retirement account or annuity meeting paragraphs (2)-(5) and, if top-heavy, section 416(c)(2)";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "the term \"simplified employee pension\" means an individual retirement account or individual retirement annuity")
rule SimplifiedEmployeePensionNotTopHeavy(sep: Plan, y: TaxableYear, employer: Person) defeasible {
    label en official "requirements (2)-(5) met, not top-heavy";
    when sep_plan_of(sep, employer)
        and sep_requirement_k2_met(employer, y)
        and sep_requirement_k3_met(employer, y)
        and sep_requirement_k4_met(sep)
        and sep_requirement_k5_met(sep)
        and not_known(sep_top_heavy(sep, y));
    then simplified_employee_pension(sep, y);
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "if such account or annuity is part of a top-heavy plan (as defined in section 416), with respect to which the requirements of section 416(c)(2) are met")
rule SimplifiedEmployeePensionTopHeavy(sep: Plan, y: TaxableYear, employer: Person) defeasible {
    label en official "requirements (2)-(5) met and, being top-heavy, section 416(c)(2) met";
    when sep_plan_of(sep, employer)
        and sep_requirement_k2_met(employer, y)
        and sep_requirement_k3_met(employer, y)
        and sep_requirement_k4_met(sep)
        and sep_requirement_k5_met(sep)
        and sep_top_heavy(sep, y)
        and sep_meets_416c2(sep, y);
    then simplified_employee_pension(sep, y);
}

// =====================================================================
// (k)(6) Salary reduction arrangements (SARSEP); (k)(7) Roth IRA
// =====================================================================

pub relation sep_elective_contributions_paid(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "elective employer contributions actually paid over to the simplified employee pension on behalf of the employee, case-asserted (section 408(k)(6)(D)(i))";
}

pub relation sep_eligible_employee_count(employer: Person, y: TaxableYear, eligible: Integer, electing: Integer) kind empirical {
    label en unofficial "employees eligible to participate and those with an election in effect, case-asserted (section 408(k)(6)(A)(ii))";
}

pub relation sep_employees_eligible_preceding_year(employer: Person, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "employees eligible to participate (or who would have been required to be eligible) at any time during the preceding year, case-asserted (section 408(k)(6)(B))";
}

pub relation sep_nhce_average_deferral_percentage(employer: Person, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the average of the deferral percentages of all eligible employees other than highly compensated employees, case-asserted (an average over a derived per-employee ratio is an aggregate over a derived predicate, section 111)";
}

pub relation sep_employer_is_governmental_or_exempt(employer: Person) kind empirical {
    label en unofficial "the employer is a State or local government (or instrumentality) or an organization exempt from tax (section 408(k)(6)(E)), case-asserted";
}

pub relation sep_meets_401a30(sep: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of section 401(a)(30) are met, case-asserted (section 408(k)(6)(A)(iv))";
}

pub relation sep_terms_as_of_1996_permit_election(employer: Person) kind empirical {
    label en unofficial "the terms of the employer's simplified employee pensions in effect on December 31, 1996 permit the salary reduction election, case-asserted (section 408(k)(6)(H) second sentence)";
}

pub relation sep_salary_reduction_50_percent_electing(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(6)(A)(ii): an election is made or in effect for not less than 50 percent of the eligible employees";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "unless an election described in clause (i)(I) is made or is in effect with respect to not less than 50 percent of the employees of the employer eligible to participate")
rule SepSalaryReduction50PercentElecting(employer: Person, y: TaxableYear, eligible: Integer, electing: Integer) strict {
    label en official "exact boundary: electing * 2 >= eligible (50 percent is enough, one fewer is not)";
    when sep_eligible_employee_count(employer, y, eligible, electing)
        and eligible > 0
        and electing * 2 >= eligible;
    then sep_salary_reduction_50_percent_electing(employer, y);
}

pub relation sep_hce_deferral_within_125_percent(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(6)(A)(iii): the highly compensated employee's deferral percentage is not more than 1.25 times the average of the non-highly-compensated employees";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "the deferral percentage for such year of each highly compensated employee eligible to participate is not more than the product of")
rule SepHceDeferralWithin125Percent(employee: Person, employer: Person, y: TaxableYear, elective: Money, comp: Money, avg: Decimal) strict {
    label en official "elective <= 1.25 x average x compensation (capped at the first $200,000), exact, no division";
    when highly_compensated_employee(employee, employer, y)
        and sep_elective_contributions_paid(employee, employer, y, elective)
        and sep_compensation_for_year(employee, employer, y, comp)
        and sep_nhce_average_deferral_percentage(employer, y, avg)
        and elective <= min(comp, SECTION401A17_COMPENSATION_LIMIT) * (avg * 1.25);
    then sep_hce_deferral_within_125_percent(employee, employer, y);
}

pub relation sep_hce_deferral_excess(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(k)(6)(C)(ii): the excess contribution of a highly compensated employee over the maximum allowable under (A)(iii)";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "the term \"excess contribution\" means, with respect to a highly compensated employee, the excess of elective employer contributions under this paragraph over the maximum amount of such contributions allowable under subparagraph (A)(iii)")
rule SepHceDeferralExcess(employee: Person, employer: Person, y: TaxableYear, elective: Money, comp: Money, avg: Decimal) strict {
    label en official "excess = elective - 1.25 x average x capped compensation when positive";
    when highly_compensated_employee(employee, employer, y)
        and sep_elective_contributions_paid(employee, employer, y, elective)
        and sep_compensation_for_year(employee, employer, y, comp)
        and sep_nhce_average_deferral_percentage(employer, y, avg)
        and elective > min(comp, SECTION401A17_COMPENSATION_LIMIT) * (avg * 1.25);
    then sep_hce_deferral_excess(employee, employer, y, elective - min(comp, SECTION401A17_COMPENSATION_LIMIT) * (avg * 1.25));
}

pub relation sep_salary_reduction_permitted(sep: Plan, y: TaxableYear) kind institutional {
    label en official "section 408(k)(6)(A)(i)-(iv) and (B), (E), (H): elective employer contributions do not disqualify the pension";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "A simplified employee pension shall not fail to meet the requirements of this subsection for a year merely because, under the terms of the pension, an employee may elect to have the employer make payments")
rule SepSalaryReductionPermitted(sep: Plan, y: TaxableYear, employer: Person, employees: Integer) strict {
    label en official "small-employer, non-government SARSEP with 50 percent participation, a passing 1.25 test (no failing highly compensated employee) and section 401(a)(30) met; only for years grandfathered from 1996";
    when sep_plan_of(sep, employer)
        and sep_employees_eligible_preceding_year(employer, y, employees)
        and employees <= 25
        and sep_salary_reduction_50_percent_electing(employer, y)
        and sep_meets_401a30(sep, y)
        and sep_terms_as_of_1996_permit_election(employer)
        and not_known(sep_hce_deferral_excess_exists(employer, y))
        and not_known(sep_employer_is_governmental_or_exempt(employer));
    then sep_salary_reduction_permitted(sep, y);
}

pub relation sep_hce_deferral_excess_exists(employer: Person, y: TaxableYear) kind institutional {
    label en unofficial "helper: some highly compensated employee has a section 408(k)(6)(C)(ii) excess contribution (avoids an existential negation)";
}

rule SepHceDeferralExcessExists(employer: Person, y: TaxableYear, employee: Person, amount: Money) strict {
    label en unofficial "derives the helper from any excess amount";
    when sep_hce_deferral_excess(employee, employer, y, amount);
    then sep_hce_deferral_excess_exists(employer, y);
}

pub relation sep_election_ended_after_1996(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(k)(6)(H): the paragraph does not apply to years beginning after 1996, except for an employer whose December 31, 1996 terms permit the election";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to years beginning after December 31, 1996.")
rule SepElectionEndedAfter1996(employer: Person, y: TaxableYear, first_day: Date) strict {
    label en official "the year begins after December 31, 1996 (exact date comparison) and no grandfathered terms exist";
    when us.irc.core::begins(y, first_day)
        and first_day > @1996-12-31
        and sep_plan_of(_, employer)
        and not_known(sep_terms_as_of_1996_permit_election(employer));
    then sep_election_ended_after_1996(employer, y);
}

pub relation roth_ira_sep_election_made(employee: Person, ira: Plan, on: Date) kind empirical {
    label en unofficial "the employee elects that the Roth IRA be treated as a simplified employee pension, case-asserted (section 408(k)(7))";
}

pub relation roth_ira_treated_as_sep(employee: Person, ira: Plan) kind institutional {
    label en official "section 408(k)(7): a Roth IRA is treated as a simplified employee pension only by the employee's election";
}

@source(IRC_S408_K, relation = formalizes, coverage = exact, quote = "shall not be treated as a simplified employee pension under this subsection unless the employee elects for such plan to be so treated")
rule RothIraSepElectionPower(employee: Person, ira: Plan, on: Date) strict {
    label en official "the election is the employee's power; the effect is SEP treatment of the Roth IRA";
    when roth_ira_sep_election_made(employee, ira, on);
    then power ElectRothIraAsSep {
        holder employee;
        over ira;
        exercise roth_ira_sep_election_made(employee, ira, on);
        valid_when participates_in(employee, ira);
        effect roth_ira_treated_as_sep(employee, ira);
    };
}

// =====================================================================
// (l) Employer and trustee reports for SEPs and SIMPLE accounts
// =====================================================================

pub relation sep_contribution_made_for_employee(employer: Person, employee: Person, y: TaxableYear) kind institutional {
    label en unofficial "the employer contributed to a simplified employee pension on behalf of the employee (helper)";
}

rule SepContributionMadeForEmployee(employer: Person, employee: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the helper from a contribution fact";
    when sep_employer_contribution(employer, employee, y, amount);
    then sep_contribution_made_for_employee(employer, employee, y);
}

pub relation sep_simplified_reports_provided(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the simplified reports required by regulations were provided, filed and furnished as those regulations require, case-asserted (section 408(l)(1))";
}

@source(IRC_S408_L, relation = formalizes, coverage = partial, quote = "An employer who makes a contribution on behalf of an employee to a simplified employee pension shall provide such simplified reports with respect to such contributions as the Secretary may require by regulations.")
rule SepEmployerReportsDuty(employer: Person, employee: Person, y: TaxableYear) strict {
    label en official "the reports, their timing and manner are set by regulations (EXTERNAL_DEPENDENCY: no regulation text is pinned), so the duty carries no window";
    when sep_contribution_made_for_employee(employer, employee, y);
    then duty SepEmployerReportsDutyPosition {
        bearer employer;
        beneficiary employee;
        goal maintenance {
            condition sep_simplified_reports_provided(employer, employee, y);
            window [-infinity, infinity];
        }
    };
}

pub relation employer_maintains_simple_arrangement(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer maintains a qualified salary reduction arrangement under subsection (p), case-asserted";
}

pub relation simple_employer_exempt_from_408l_report(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(l)(2)(A): no report is required under this section by an employer maintaining a SIMPLE arrangement, except as provided in the paragraph";
}

@source(IRC_S408_L, relation = formalizes, coverage = exact, quote = "no report shall be required under this section by an employer maintaining a qualified salary reduction arrangement under subsection (p)")
rule SimpleEmployerNoReport(employer: Person, y: TaxableYear) strict {
    label en official "exemption from the (l)(1) report for an employer maintaining a SIMPLE arrangement";
    when employer_maintains_simple_arrangement(employer, y);
    then simple_employer_exempt_from_408l_report(employer, y);
}

pub relation simple_description_name_and_address(account: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the description contains the name and address of the employer and the trustee or issuer, case-asserted (408(l)(2)(B)(i))";
}

pub relation simple_description_eligibility(account: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the description states the requirements for eligibility for participation, case-asserted (408(l)(2)(B)(ii))";
}

pub relation simple_description_benefits(account: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the description states the benefits provided, case-asserted (408(l)(2)(B)(iii))";
}

pub relation simple_description_election_time_and_method(account: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the description states the time and method of making elections, case-asserted (408(l)(2)(B)(iv))";
}

pub relation simple_description_withdrawals(account: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the description states the procedures for, and effects of, withdrawals including rollovers, case-asserted (408(l)(2)(B)(v))";
}

pub relation simple_description_complete(account: Plan, y: TaxableYear) kind institutional {
    label en official "section 408(l)(2)(B): the annual description contains all five items";
}

@source(IRC_S408_L, relation = formalizes, coverage = exact, quote = "each year a description containing the following information")
rule SimpleDescriptionComplete(account: Plan, y: TaxableYear) strict {
    label en official "all five listed items must be present";
    when simple_description_name_and_address(account, y)
        and simple_description_eligibility(account, y)
        and simple_description_benefits(account, y)
        and simple_description_election_time_and_method(account, y)
        and simple_description_withdrawals(account, y);
    then simple_description_complete(account, y);
}

pub relation simple_description_provided_to_employer(account: Plan, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the trustee or issuer provided the annual description to the employer, case-asserted";
}

pub relation simple_trustee_of_arrangement(trustee: Person, account: Plan, employer: Person) kind empirical {
    label en unofficial "the trustee or issuer of the simple retirement account established under the employer's arrangement, case-asserted";
}

@source(IRC_S408_L, relation = formalizes, coverage = exact, quote = "shall provide to the employer maintaining the arrangement, each year a description")
rule SimpleTrusteeDescriptionDuty(trustee: Person, account: Plan, employer: Person, y: TaxableYear, year_end: Date) strict {
    label en official "the trustee or issuer provides the description to the employer each year (window: the calendar year, ending December 31)";
    when simple_trustee_of_arrangement(trustee, account, employer)
        and employer_maintains_simple_arrangement(employer, y)
        and ira_year_end(y, year_end);
    then duty SimpleDescriptionDutyPosition {
        bearer trustee;
        beneficiary employer;
        goal achievement {
            condition simple_description_provided_to_employer(account, employer, y);
            window [-infinity, year_end];
        }
    };
}

pub relation simple_election_period_start(employer: Person, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the date on which the 60-day election period before the year begins, case-asserted (section 408(p)(5)(C))";
}

pub relation simple_employee_notified_of_election(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee was notified of the opportunity to make the election and given a copy of the description, case-asserted (section 408(l)(2)(C))";
}

pub relation simple_employee_eligible(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is eligible to participate in the employer's SIMPLE arrangement for the year, case-asserted";
}

@source(IRC_S408_L, relation = formalizes, coverage = partial, quote = "The employer shall notify each employee immediately before the period for which an election described in subsection (p)(5)(C) may be made of the employee's opportunity to make such election.")
rule SimpleEmployerNoticeDuty(employer: Person, employee: Person, y: TaxableYear, start: Date) strict {
    label en official "the notice is due before the election period begins; \"immediately before\" is read as: no later than the start of the period (interpretation recorded in the coverage row)";
    when employer_maintains_simple_arrangement(employer, y)
        and simple_employee_eligible(employee, employer, y)
        and simple_election_period_start(employer, y, start);
    then duty SimpleElectionNoticeDutyPosition {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition simple_employee_notified_of_election(employer, employee, y);
            window [-infinity, start];
        }
    };
}

// =====================================================================
// (o) Designated nondeductible contributions
// =====================================================================

pub relation deduction_219_without_219g(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount allowable as a deduction under section 219 determined without regard to section 219(g), case-asserted (section 219 is owned by `deductions`)";
}

pub relation deduction_219_with_219g(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount allowable as a deduction under section 219 determined with regard to section 219(g), case-asserted";
}

pub relation elected_not_to_deduct(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the taxpayer elects not to deduct an amount otherwise allowable under section 219, case-asserted (section 408(o)(2)(B)(ii))";
}

pub relation difficulty_of_care_election_increase(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(o)(5): the elective increase of the nondeductible limit for a difficulty of care payment";
}

pub relation foster_care_excluded_amount(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified foster care payment that is a difficulty of care payment excluded from gross income under section 131, case-asserted";
}

pub relation compensation_includible_in_gross_income(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation includible in the individual's gross income for the year, case-asserted";
}

pub relation difficulty_of_care_increase_elected(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual elects to increase the nondeductible limit under (o)(5), case-asserted";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "the individual may elect to increase the nondeductible limit under paragraph (2) for the taxable year by an amount equal to the lesser of such excess or the amount so excluded")
rule DifficultyOfCareElectionIncrease(individual: Individual, y: TaxableYear, deductible: Money, comp: Money, excluded: Money) strict {
    label en official "increase = min(219(b) deductible amount - includible compensation, excluded difficulty-of-care payment), only when the deductible amount exceeds compensation";
    when difficulty_of_care_increase_elected(individual, y)
        and section219_deduction_amount(individual, y, deductible)
        and compensation_includible_in_gross_income(individual, y, comp)
        and foster_care_excluded_amount(individual, y, excluded)
        and deductible > comp;
    then difficulty_of_care_election_increase(individual, y, min(deductible - comp, excluded));
}

pub relation nondeductible_limit(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(o)(2)(B): the excess of the section 219 amount without regard to (g) over the amount with regard to (g), increased by amounts elected not to be deducted and by the (o)(5) increase";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "The term \"nondeductible limit\" means the excess of")
rule NondeductibleLimitBase(individual: Individual, y: TaxableYear, without_g: Money, with_g: Money, elected: Money, foster: Money) strict {
    label en official "(without 219(g)) - (with 219(g)) + elected-not-to-deduct + difficulty-of-care increase (each term zero when its fact is asserted as zero)";
    when deduction_219_without_219g(individual, y, without_g)
        and deduction_219_with_219g(individual, y, with_g)
        and elected_not_to_deduct(individual, y, elected)
        and difficulty_of_care_election_increase(individual, y, foster)
        and without_g >= with_g;
    then nondeductible_limit(individual, y, (without_g - with_g) + elected + foster);
}

pub relation designated_nondeductible_total(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of designated nondeductible contributions made on behalf of the individual for the year, case-asserted";
}

pub relation designated_nondeductible_excess(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(o)(2)(A): designated nondeductible contributions above the nondeductible limit";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "The amount of the designated nondeductible contributions made on behalf of any individual for any taxable year shall not exceed the nondeductible limit for such taxable year.")
rule DesignatedNondeductibleExcess(individual: Individual, y: TaxableYear, total: Money, limit: Money) strict {
    label en official "exact boundary: at the limit no excess; one cent above is excess";
    when designated_nondeductible_total(individual, y, total)
        and nondeductible_limit(individual, y, limit)
        and total > limit;
    then designated_nondeductible_excess(individual, y, total - limit);
}

pub relation makes_excess_designated_contribution(individual: Individual, y: TaxableYear) kind institutional {
    label en official "the individual causes designated nondeductible contributions to exceed the limit (the breach of (o)(2)(A))";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "The amount of the designated nondeductible contributions made on behalf of any individual for any taxable year shall not exceed the nondeductible limit for such taxable year.")
rule DesignatedNondeductibleLimitProhibition(individual: Individual, y: TaxableYear, excess: Money) strict {
    label en official "prohibition on exceeding the limit; the breach is established by the excess itself (E-0179, no section 137 pair); the consequence is a section 6693(b)/4973 matter owned elsewhere";
    when designated_nondeductible_excess(individual, y, excess);
    then prohibition DesignatedNondeductibleLimit {
        bearer individual;
        action makes_excess_designated_contribution(individual, y);
        window [-infinity, infinity];
    };
}

rule MakesExcessDesignatedContribution(individual: Individual, y: TaxableYear, excess: Money) strict {
    label en unofficial "the action atom is derived from the excess";
    when designated_nondeductible_excess(individual, y, excess);
    then makes_excess_designated_contribution(individual, y);
}

pub relation info_designated_contributions_reported(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the return states the amount of designated nondeductible contributions for the year, case-asserted (408(o)(4)(B)(i))";
}

pub relation info_distributions_reported(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the return states the amount of distributions from individual retirement plans for the year, case-asserted (408(o)(4)(B)(ii))";
}

pub relation info_excess_prior_contributions_reported(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the return states the excess of aggregate designated nondeductible contributions for preceding years over the aggregate excludable distributions of those years, case-asserted (408(o)(4)(B)(iii))";
}

pub relation info_aggregate_balance_reported(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the return states the aggregate balance of all individual retirement plans at the close of the calendar year in which the taxable year begins, case-asserted (408(o)(4)(B)(iv))";
}

pub relation info_other_prescribed_reported(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the return states such other information as the Secretary prescribes, case-asserted (408(o)(4)(B)(v); the prescription itself is regulatory)";
}

pub relation nondeductible_information_on_return(individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 408(o)(4)(B): all listed items of information are included on the return";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "The following information is described in this subparagraph")
rule NondeductibleInformationOnReturn(individual: Individual, y: TaxableYear) strict {
    label en official "items (i)-(v) all present";
    when info_designated_contributions_reported(individual, y)
        and info_distributions_reported(individual, y)
        and info_excess_prior_contributions_reported(individual, y)
        and info_aggregate_balance_reported(individual, y)
        and info_other_prescribed_reported(individual, y);
    then nondeductible_information_on_return(individual, y);
}

pub relation individual_return_due(individual: Individual, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the date by which the individual's return for the year is due (with extensions), case-asserted";
}

pub relation individual_made_or_received_ira_amount(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual made a designated nondeductible contribution to, or received an amount from, an individual retirement plan for the year, case-asserted";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "shall include on his return of the tax imposed by chapter 1 for such taxable year and any succeeding taxable year")
rule NondeductibleReportingDuty(individual: Individual, y: TaxableYear, due: Date) strict {
    label en official "duty of the individual to report the (o)(4)(B) information on the return";
    when individual_made_or_received_ira_amount(individual, y)
        and individual_return_due(individual, y, due);
    then duty NondeductibleInformationDutyPosition {
        bearer individual;
        beneficiary individual;
        goal achievement {
            condition nondeductible_information_on_return(individual, y);
            window [-infinity, due];
        }
    };
}

pub relation designation_made_on_return(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the (o)(2)(C)(i) designation is made on the return of tax imposed by chapter 1 for the year, case-asserted";
}

pub relation designated_nondeductible_contribution_valid(individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 408(o)(2)(C): a contribution designated as one for which no deduction is allowable, the designation made on the return for the year";
}

@source(IRC_S408_O, relation = formalizes, coverage = exact, quote = "Any designation under clause (i) shall be made on the return of tax imposed by chapter 1 for the taxable year.")
rule DesignatedNondeductibleContributionValid(individual: Individual, y: TaxableYear, amount: Money) strict {
    label en official "a designated contribution counts only with a designation on the return";
    when ira_nondeductible_contribution_designated(individual, y, amount)
        and designation_made_on_return(individual, y);
    then designated_nondeductible_contribution_valid(individual, y);
}

// =====================================================================
// (p) SIMPLE retirement accounts — (5)-(12)
// =====================================================================

pub relation simple_elective_contribution_month(employer: Person, employee: Person, month_end: Date) kind empirical {
    label en unofficial "elective employer contributions are due for the month ending on this date, case-asserted (section 408(p)(5)(A)(i); computing a month-end from a date is TECH-GAPS G9)";
}

pub relation simple_elective_contribution_paid_over(employer: Person, employee: Person, month_end: Date) kind empirical {
    label en unofficial "the elective employer contribution for the month was paid over, case-asserted";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "not later than the close of the 30-day period following the last day of the month with respect to which the contributions are to be made")
rule SimpleElectiveContributionDuty(employer: Person, employee: Person, month_end: Date) strict {
    label en official "the employer must pay over elective contributions within 30 days after the last day of the month";
    when simple_elective_contribution_month(employer, employee, month_end);
    then duty SimpleElectiveContributionDutyPosition {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition simple_elective_contribution_paid_over(employer, employee, month_end);
            window [-infinity, add_calendar_period(month_end, 30 calendar_day)];
        }
    };
}

pub relation simple_employer_return_due_with_extensions(employer: Person, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the date described in section 404(m)(2)(B) (the due date of the employer's return including extensions), case-asserted";
}

pub relation simple_matching_or_nonelective_paid(employer: Person, employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the matching or nonelective contribution for the year was made, case-asserted";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "make the matching contributions under paragraph (2)(A)(iii) or the nonelective contributions under paragraph (2)(B) not later than the date described in section 404(m)(2)(B)")
rule SimpleMatchingContributionDuty(employer: Person, employee: Person, y: TaxableYear, due: Date) strict {
    label en official "matching or nonelective contributions are due by the section 404(m)(2)(B) date";
    when simple_matching_contribution_required(employee, employer, y, _)
        and simple_employer_return_due_with_extensions(employer, y, due);
    then duty SimpleMatchingContributionDutyPosition {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition simple_matching_or_nonelective_paid(employer, employee, y);
            window [-infinity, due];
        }
    };
}

pub relation simple_termination_of_participation_elected(employee: Person, employer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the employee elects to terminate participation at this time during the year, case-asserted (section 408(p)(5)(B))";
}

pub relation simple_participation_terminated(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(p)(5)(B): the employee's participation in the arrangement is terminated (resumption may be barred until the next year)";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "an employee may elect to terminate participation in such arrangement at any time during the year")
rule SimpleTerminationPower(employee: Person, employer: Person, y: TaxableYear, on: Date) strict {
    label en official "the employee may terminate at any time during the year";
    when simple_termination_of_participation_elected(employee, employer, y, on);
    then power TerminateSimpleParticipation {
        holder employee;
        over employer;
        exercise simple_termination_of_participation_elected(employee, employer, y, on);
        valid_when simple_employee_eligible(employee, employer, y);
        effect simple_participation_terminated(employee, employer, y);
    };
}

pub relation simple_election_made_on(employee: Person, employer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the employee elects to participate or to modify the amounts subject to the arrangement for the year, on this date, case-asserted (section 408(p)(5)(C))";
}

pub relation simple_election_in_60_day_period(employee: Person, employer: Person, y: TaxableYear, on: Date) kind institutional {
    label en official "section 408(p)(5)(C): the election is made during the 60-day period before the beginning of the year";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "each employee eligible to participate may elect, during the 60-day period before the beginning of any year")
rule SimpleElectionIn60DayPeriod(employee: Person, employer: Person, y: TaxableYear, on: Date, start: Date, year_start: Date, calendar_before_1: Date) strict {
    label en official "exact boundaries: the period opens 60 days before the year begins and ends before the year begins";
    when simple_election_made_on(employee, employer, y, on)
        and us.irc.core::begins(y, year_start)
        and on >= calendar_before_1
        and on < year_start
        and us.irc.core::civil_calendar_boundary_before(year_start, 60, us.irc.core::CalendarDay, calendar_before_1);
    then simple_election_in_60_day_period(employee, employer, y, on);
}

pub relation simple_participation_election_effective(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(p)(5)(C): the participation election or modification takes effect for the year";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "to participate in the arrangement, or to modify the amounts subject to such arrangement, for such year")
rule SimpleElectionPower(employee: Person, employer: Person, y: TaxableYear, on: Date) strict {
    label en official "power over the employee's participation, valid only inside the 60-day period";
    when simple_election_made_on(employee, employer, y, on);
    then power ElectSimpleParticipation {
        holder employee;
        over employer;
        exercise simple_election_made_on(employee, employer, y, on);
        valid_when simple_election_in_60_day_period(employee, employer, y, on);
        effect simple_participation_election_effective(employee, employer, y);
    };
}

// (6) definitions --------------------------------------------------------

pub relation simple_wages_6051a3_and_8(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amounts described in section 6051(a)(3) (determined without regard to section 3401(a)(3)) and (8), case-asserted";
}

pub relation simple_net_earnings_from_self_employment(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "net earnings from self-employment under section 1402(a) without regard to any contribution under the subsection, with section 1402(c)(6) service included, case-asserted";
}

pub relation simple_employee_is_self_employed(employee: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee is an employee within section 401(c)(1) (self-employed), case-asserted";
}

pub relation simple_compensation_408p6(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(p)(6)(A): compensation of an employee under a SIMPLE arrangement";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "The term \"compensation\" means amounts described in paragraphs (3) and (8) of section 6051(a).")
rule SimpleCompensationWages(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "for a non-self-employed employee: the section 6051(a)(3) and (8) amounts";
    when simple_wages_6051a3_and_8(employee, employer, y, amount)
        and not_known(simple_employee_is_self_employed(employee, y));
    then simple_compensation_408p6(employee, employer, y, amount);
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "the term \"compensation\" means net earnings from self-employment determined under section 1402(a) without regard to any contribution under this subsection")
rule SimpleCompensationSelfEmployed(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "for a self-employed employee: net earnings from self-employment";
    when simple_net_earnings_from_self_employment(employee, y, amount)
        and simple_employee_is_self_employed(employee, y)
        and sep_plan_of(_, employer);
    then simple_compensation_408p6(employee, employer, y, amount);
}

// (7), (8), (9) ---------------------------------------------------------

pub relation simple_all_contributions_to_designated_trustee(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer makes all contributions to the individual retirement accounts or annuities of a designated trustee or issuer, case-asserted";
}

pub relation simple_participants_notified_of_transfer_right(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "each plan participant is notified in writing (separately or as part of the (l)(2)(C) notice) that the balance may be transferred without cost or penalty to another individual retirement account or annuity, case-asserted";
}

pub relation simple_designated_trustee_arrangement_ok(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(p)(7): the plan does not fail the requirements merely because all contributions go to a designated trustee or issuer";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "merely because the employer makes all contributions to the individual retirement accounts or annuities of a designated trustee or issuer")
rule SimpleDesignatedTrusteeArrangementOk(employer: Person, y: TaxableYear) strict {
    label en official "protected only if every participant received the written transfer notice";
    when simple_all_contributions_to_designated_trustee(employer, y)
        and simple_participants_notified_of_transfer_right(employer, y);
    then simple_designated_trustee_arrangement_ok(employer, y);
}

pub relation simple_required_employer_contribution(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer contribution required under (p)(2)(A)(iii) or (p)(2)(B)(i), whichever applies, case-asserted";
}

pub relation simple_catch_up_contribution(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution meeting the requirement of (p)(2)(A)(iv) with respect to the employee, case-asserted";
}

pub relation simple_elective_dollar_amount(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the dollar amount in effect under (p)(2)(A)(ii) for the year, case-asserted (indexed amounts are TECH-GAPS G3/SOURCE_GAP unless pinned)";
}

pub relation simple_account_contribution_ceiling(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(p)(8): the section 408(a)(1) and (b)(2)(B) amount for a simple retirement account";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "the sum of the dollar amount in effect under subsection (p)(2)(A)(ii), the employer contribution required under subsection (p)(2)(A)(iii) or (p)(2)(B)(i), whichever is applicable, and a contribution which meets the requirement of subsection (p)(2)(A)(iv) with respect to the employee")
rule SimpleAccountContributionCeiling(employee: Person, employer: Person, y: TaxableYear, elective: Money, required: Money, catchup: Money) strict {
    label en official "ceiling = elective dollar amount + required employer contribution + catch-up contribution";
    when simple_elective_dollar_amount(employer, y, elective)
        and simple_required_employer_contribution(employee, employer, y, required)
        and simple_catch_up_contribution(employee, employer, y, catchup);
    then simple_account_contribution_ceiling(employee, employer, y, elective + required + catchup);
}

pub relation simple_matching_contribution_for_self_employed(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a matching contribution under (p)(2)(A)(iii) made on behalf of a self-employed individual within section 401(c), case-asserted";
}

pub relation simple_matching_not_elective_for_self_employed(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408(p)(9): the matching contribution for a self-employed individual is not an elective employer contribution for purposes of the title";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "shall not be treated as an elective employer contribution to a simple retirement account for purposes of this title")
rule SimpleMatchingNotElectiveForSelfEmployed(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "reclassification of the matching contribution";
    when simple_matching_contribution_for_self_employed(employee, employer, y, amount)
        and simple_employee_is_self_employed(employee, y);
    then simple_matching_not_elective_for_self_employed(employee, employer, y, amount);
}

// (10) acquisitions and dispositions -------------------------------------

pub relation simple_acquisition_transaction(employer: Person, transaction_on: Date, calendar_year: Integer) kind empirical {
    label en unofficial "an acquisition, disposition or similar transaction of the employer occurs on this date, in this calendar year, case-asserted (section 408(p)(10)(A))";
}

pub relation simple_similar_to_410b6C(employer: Person, transaction_on: Date) kind empirical {
    label en unofficial "the employer satisfies requirements similar to section 410(b)(6)(C)(i)(II), case-asserted";
}

pub relation simple_would_satisfy_as_separate_employer(employer: Person, transaction_on: Date) kind empirical {
    label en unofficial "the arrangement would satisfy subsection (p) after the transaction if the prior employer had remained separate, case-asserted";
}

pub relation simple_transition_period(employer: Person, transaction_on: Date, ends: Date) kind institutional {
    label en official "section 408(p)(10)(C): from the date of the transaction to the last day of the second calendar year following the year of the transaction";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "ending on the last day of the second calendar year following the calendar year in which such transaction occurs")
rule SimpleTransitionPeriod(employer: Person, transaction_on: Date, cy: Integer, y2: TaxableYear, ends: Date) strict {
    label en official "end = last day of the taxable year for calendar year (transaction year + 2)";
    when simple_acquisition_transaction(employer, transaction_on, cy)
        and us.irc.core::calendar_year_of(y2, cy + 2)
        and us.irc.core::ends(y2, ends);
    then simple_transition_period(employer, transaction_on, ends);
}

pub relation simple_failure_excused_during_transition(employer: Person, transaction_on: Date, ends: Date, on: Date) kind institutional {
    label en official "section 408(p)(10)(A): an applicable requirement failed by reason of the transaction is not treated as failed during the transition period";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to meet such requirement during the transition period if")
rule SimpleFailureExcusedDuringTransition(employer: Person, transaction_on: Date, ends: Date, on: Date) strict {
    label en official "excused on any date from the transaction date through the transition period's end when both conditions hold";
    when simple_transition_period(employer, transaction_on, ends)
        and simple_similar_to_410b6C(employer, transaction_on)
        and simple_would_satisfy_as_separate_employer(employer, transaction_on)
        and simple_requirement_failed_on(employer, on)
        and on >= transaction_on
        and on <= ends;
    then simple_failure_excused_during_transition(employer, transaction_on, ends, on);
}

pub relation simple_requirement_failed_on(employer: Person, on: Date) kind empirical {
    label en unofficial "the employer fails an applicable requirement (eligible employer, only-plan, participation) on this date by reason of the transaction, case-asserted (section 408(p)(10)(B))";
}

// (11) termination and replacement by a safe harbor plan ------------------

pub relation simple_safe_harbor_replacement_established(employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer establishes and maintains, as of the day after the termination date, a safe harbor plan (a qualified cash or deferred arrangement meeting section 401(k)(11), (12), (13) or (16)) to replace the terminated arrangement, case-asserted";
}

pub relation simple_termination_elected(employer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the employer elects at some time during the year to terminate the qualified salary reduction arrangement, case-asserted (section 408(p)(11)(A))";
}

pub relation simple_arrangement_terminated(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 408(p)(11)(A): the qualified salary reduction arrangement is terminated";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "an employer may elect (in such form and manner as the Secretary may prescribe) at any time during a year to terminate the qualified salary reduction arrangement under paragraph (2), but only if the employer establishes and maintains (as of the day after the termination date) a safe harbor plan to replace the terminated arrangement")
rule SimpleArrangementTerminationPower(employer: Person, y: TaxableYear, on: Date) strict {
    label en official "valid only with a replacement safe harbor plan";
    when simple_termination_elected(employer, y, on) and employer_maintains_simple_arrangement(employer, y);
    then power TerminateSimpleArrangement {
        holder employer;
        over employer;
        exercise simple_termination_elected(employer, y, on);
        valid_when simple_safe_harbor_replacement_established(employer, y);
        effect simple_arrangement_terminated(employer, y);
    };
}

pub relation simple_last_plan_year_days(employee: Person, employer: Person, days: Integer) kind empirical {
    label en unofficial "the number of days in the last plan year of the terminated arrangement, case-asserted (section 408(p)(11)(B)(i))";
}

pub relation simple_transition_year_days(employee: Person, employer: Person, days: Integer) kind empirical {
    label en unofficial "the number of days in the transition year (after the termination date to the end of that calendar year), case-asserted (section 408(p)(11)(C))";
}

pub relation simple_applicable_dollar_last_year(employee: Person, employer: Person, amount: Money) kind empirical {
    label en unofficial "the applicable dollar amount for the terminated arrangement on a full-year basis (after section 414(v)), case-asserted";
}

pub relation simple_402g_dollar_amount(employee: Person, employer: Person, amount: Money) kind empirical {
    label en unofficial "the applicable dollar amount under section 402(g)(1) for the safe harbor plan, case-asserted";
}

pub relation simple_aggregate_elective_last_and_transition(employee: Person, employer: Person, amount: Money) kind empirical {
    label en unofficial "the employee's aggregate elective contributions under the terminated arrangement in its last plan year and under the safe harbor plan in its transition year, case-asserted";
}

pub relation simple_termination_limit_exceeded(employee: Person, employer: Person) kind institutional {
    label en official "section 408(p)(11)(B): the aggregate elective contributions exceed the prorated sum of the two dollar amounts";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "if the aggregate elective contributions of the employee under the terminated arrangement during its last plan year and under the safe harbor plan during its transition year exceed the sum of")
rule SimpleTerminationLimitExceeded(employee: Person, employer: Person, d1: Integer, d2: Integer, a1: Money, a2: Money, total: Money) strict {
    label en official "total x 365 > a1 x days1 + a2 x days2 (exact, no division): the terminated arrangement and the safe harbor plan are then both treated as violating (p)(2)(A)(ii) or section 401(a)(30)";
    when simple_last_plan_year_days(employee, employer, d1)
        and simple_transition_year_days(employee, employer, d2)
        and simple_applicable_dollar_last_year(employee, employer, a1)
        and simple_402g_dollar_amount(employee, employer, a2)
        and simple_aggregate_elective_last_and_transition(employee, employer, total)
        and total * 365 > a1 * d1 + a2 * d2;
    then simple_termination_limit_exceeded(employee, employer);
}

pub relation roth_ira_simple_election_made(employee: Person, ira: Plan, on: Date) kind empirical {
    label en unofficial "the employee elects for the Roth IRA to be treated as a simple retirement account, case-asserted (section 408(p)(12))";
}

pub relation roth_ira_treated_as_simple_account(employee: Person, ira: Plan) kind institutional {
    label en official "section 408(p)(12): a Roth IRA is a simple retirement account only by the employee's election";
}

@source(IRC_S408_P, relation = formalizes, coverage = exact, quote = "shall not be treated as a simple retirement account under this subsection unless the employee elects for such plan to be so treated")
rule RothIraSimpleElectionPower(employee: Person, ira: Plan, on: Date) strict {
    label en official "election power; effect is simple-account treatment";
    when roth_ira_simple_election_made(employee, ira, on);
    then power ElectRothIraAsSimple {
        holder employee;
        over ira;
        exercise roth_ira_simple_election_made(employee, ira, on);
        valid_when participates_in(employee, ira);
        effect roth_ira_treated_as_simple_account(employee, ira);
    };
}
