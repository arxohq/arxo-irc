// Section 402 residuals — STAGE 3b (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): (b)(2)-(4) nonexempt trusts, (c) rollover details, (e)(1)(B),
// (e)(2), (e)(4) net unrealized appreciation and lump-sum definitions, (f)(1)
// explanation content, (g)(2)-(8) excess deferrals, (h) SEP, (i), (j), (k),
// (l) public safety officers.
//
// Pattern: a statutory condition is decomposed into case facts and a derived
// relation; amounts are exact; the section 72 computation stays with
// gross-income. Rules whose consequence is a "shall be treated" statement
// produce a treatment relation that consumers (module 04/34) may read.

// =====================================================================
// (b)(2)-(4) Nonexempt trusts
// =====================================================================

use self::{
    Distribution,
    IRC_S402_B,
    IRC_S402_C,
    IRC_S402_E,
    IRC_S402_F,
    IRC_S402_G,
    IRC_S402_H,
    IRC_S402_I,
    IRC_S402_J,
    IRC_S402_K,
    IRC_S402_L,
    Person,
    Plan,
    TaxableYear,
    direct_transfer_to_inherited_ira_402c11,
    distribution_includible_portion_402c2,
    excess_deferral_distribution_timely_402g2A,
    public_safety_officer_premium_exclusion,
    sep_415c1a_limit,
    sep_compensation_includible,
};

pub relation distribution_from_nonexempt_trust_402b2(d: Distribution, distributee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount actually distributed or made available to the distributee by a trust described in paragraph (1) (a trust not exempt under section 501(a)), case-asserted";
}

pub relation distribution_before_annuity_starting_date_income_402b2(d: Distribution) kind empirical {
    label en unofficial "the distribution is of trust income before the annuity starting date (section 72(c)(4)), case-asserted";
}

pub relation nonexempt_trust_distribution_taxable_under_72_402b2(d: Distribution, distributee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(b)(2): the distribution is taxable to the distributee under section 72 in the year distributed or made available";
}

@source(IRC_S402_B, relation = formalizes, coverage = partial, quote = "shall be taxable to the distributee, in the taxable year in which so distributed or made available, under section 72")
rule NonexemptTrustDistributionTaxableUnder72402b2(d: Distribution, distributee: Person, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the section 72 computation is gross-income";
    when distribution_from_nonexempt_trust_402b2(d, distributee, y, amount);
    then nonexempt_trust_distribution_taxable_under_72_402b2(d, distributee, y, amount);
}

pub relation income_included_without_72e5_402b2(d: Distribution) kind institutional {
    label en official "section 402(b)(2) exception: distributions of trust income before the annuity starting date are included without regard to section 72(e)(5)";
}

@source(IRC_S402_B, relation = formalizes, coverage = exact, quote = "distributions of income of such trust before the annuity starting date (as defined in section 72(c)(4)) shall be included in the gross income of the employee without regard to section 72(e)(5)")
rule IncomeIncludedWithout72e5402b2(d: Distribution) strict {
    label en official "pre-annuity-starting-date income";
    when distribution_before_annuity_starting_date_income_402b2(d);
    then income_included_without_72e5_402b2(d);
}

pub relation trust_is_nonexempt_employees_trust_402b3(trust: Plan) kind empirical {
    label en unofficial "the trust is an employees' trust described in paragraph (1), case-asserted";
}

pub relation beneficiary_of_trust_402b3(person: Person, trust: Plan) kind empirical {
    label en unofficial "the person is a beneficiary of the trust, case-asserted";
}

pub relation beneficiary_not_owner_under_subpart_e_402b3(person: Person, trust: Plan) kind institutional {
    label en official "section 402(b)(3): a beneficiary is not the owner of any portion of the trust under subpart E of part I of subchapter J";
}

@source(IRC_S402_B, relation = formalizes, coverage = exact, quote = "shall not be considered the owner of any portion of such trust under subpart E of part I of subchapter J")
rule BeneficiaryNotOwnerUnderSubpartE402b3(person: Person, trust: Plan) strict {
    label en official "beneficiary of a nonexempt employees' trust";
    when trust_is_nonexempt_employees_trust_402b3(trust) and beneficiary_of_trust_402b3(person, trust);
    then beneficiary_not_owner_under_subpart_e_402b3(person, trust);
}

pub relation trust_nonexempt_solely_by_failure_of_401a26_or_410b_402b4B(trust: Plan) kind empirical {
    label en unofficial "the trust is not exempt for the year solely because the plan fails section 401(a)(26) or 410(b), case-asserted";
}

pub relation employee_was_hce_in_year_or_prior_creditable_period_402b4B(employee: Person, trust: Plan) kind empirical {
    label en unofficial "the employee was a highly compensated employee (section 414(q)) during the taxable year or any preceding period for which service was creditable, case-asserted";
}

pub relation paragraphs_1_and_2_apply_to_employee_402b4B(employee: Person, trust: Plan) kind institutional {
    label en official "section 402(b)(4)(B): paragraphs (1) and (2) do not apply by reason of a coverage failure to an employee who was never a highly compensated employee in the year or a preceding creditable period";
}

@source(IRC_S402_B, relation = formalizes, coverage = exact, quote = "paragraphs (1) and (2) shall not apply by reason of such failure to any employee who was not a highly compensated employee during")
rule ParagraphsOneAndTwoApplyToEmployee402b4B(employee: Person, trust: Plan) strict {
    label en official "applies to the employee only if a highly compensated employee at some time in the period; an employee who was never one is exempted by (B) (the residual (1)/(2) application for other failures is module 34)";
    when trust_nonexempt_solely_by_failure_of_401a26_or_410b_402b4B(trust)
        and employee_was_hce_in_year_or_prior_creditable_period_402b4B(employee, trust);
    then paragraphs_1_and_2_apply_to_employee_402b4B(employee, trust);
}

pub relation hce_status_by_414q_402b4C(employee: Person) kind empirical {
    label en unofficial "the employee is a highly compensated employee within the meaning of section 414(q), case-asserted";
}

pub relation highly_compensated_by_414q_for_402b4(employee: Person) kind institutional {
    label en official "section 402(b)(4)(C): highly compensated employee has the meaning of section 414(q)";
}

@source(IRC_S402_B, relation = formalizes, coverage = exact, quote = "the term \"highly compensated employee\" has the meaning given such term by section 414(q)")
rule HighlyCompensatedBy414qFor402b4(employee: Person) strict {
    label en official "cross-reference";
    when hce_status_by_414q_402b4C(employee);
    then highly_compensated_by_414q_for_402b4(employee);
}

// =====================================================================
// (c) Rollover details
// =====================================================================

pub relation property_distributed_is_other_than_money_402c1C(d: Distribution) kind empirical {
    label en unofficial "the distribution is of property other than money, case-asserted";
}

pub relation amount_transferred_consists_of_property_distributed_402c1C(d: Distribution) kind empirical {
    label en unofficial "the amount transferred consists of the property distributed, case-asserted";
}

pub relation property_condition_of_rollover_met_402c1C(d: Distribution) kind institutional {
    label en official "section 402(c)(1)(C): for a distribution of property other than money, the amount transferred must consist of the property distributed (a distribution of money needs no such condition)";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "in the case of a distribution of property other than money, the amount so transferred consists of the property distributed")
rule PropertyConditionOfRolloverMetProperty402c1C(d: Distribution) strict {
    label en official "property distributed and transferred in kind";
    when property_distributed_is_other_than_money_402c1C(d)
        and amount_transferred_consists_of_property_distributed_402c1C(d);
    then property_condition_of_rollover_met_402c1C(d);
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "in the case of a distribution of property other than money")
rule PropertyConditionOfRolloverMetMoney402c1C(d: Distribution) strict {
    label en official "money: the condition does not apply";
    when distribution_includible_portion_402c2(d, _)
        and not_known(property_distributed_is_other_than_money_402c1C(d));
    then property_condition_of_rollover_met_402c1C(d);
}

pub relation transfer_amount_order_402c2_last(d: Distribution, transferred: Money, includible: Money) kind empirical {
    label en unofficial "the amount transferred in a transfer described in (c)(2)(A) or (B), and the includible portion of the distribution, case-asserted";
}

pub relation transferred_amount_treated_as_includible_402c2_last(d: Distribution, taxable_part: Money) kind institutional {
    label en official "section 402(c)(2) last sentence: the amount transferred is treated as consisting first of the portion includible in gross income";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the amount transferred shall be treated as consisting first of the portion of such distribution that is includible in gross income")
rule TransferredAmountTreatedAsIncludible402c2Last(d: Distribution, transferred: Money, includible: Money) strict {
    label en official "min(transferred, includible) is taxable part; the rest is basis";
    when transfer_amount_order_402c2_last(d, transferred, includible);
    then transferred_amount_treated_as_includible_402c2_last(d, min(transferred, includible));
}

pub relation loan_offset_distributed_solely_by_402c3Cii(d: Distribution) kind empirical {
    label en unofficial "the plan loan offset amount is treated as distributed solely by reason of the termination of the plan or failure to meet the repayment terms because of severance from employment, case-asserted";
}

pub relation loan_offset_reduces_accrued_benefit_402c3Ciii(d: Distribution, amount: Money) kind empirical {
    label en unofficial "the amount by which the participant's accrued benefit is reduced to repay a loan from the plan, case-asserted";
}

pub relation loan_excepted_from_72p1_by_72p2_402c3Civ(d: Distribution) kind empirical {
    label en unofficial "section 72(p)(1) does not apply to the loan by reason of section 72(p)(2), case-asserted";
}

pub relation qualified_plan_loan_offset_amount_402c3C(d: Distribution, amount: Money) kind institutional {
    label en official "section 402(c)(3)(C)(ii)-(iv): a plan loan offset amount treated as distributed solely by reason of plan termination or severance, for a loan to which section 72(p)(1) does not apply by reason of 72(p)(2)";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the term \"plan loan offset amount\" means the amount by which the participant's accrued benefit under the plan is reduced in order to repay a loan from the plan")
rule QualifiedPlanLoanOffsetAmount402c3C(d: Distribution, amount: Money) strict {
    label en official "all three conditions";
    when loan_offset_distributed_solely_by_402c3Cii(d)
        and loan_offset_reduces_accrued_benefit_402c3Ciii(d, amount)
        and loan_excepted_from_72p1_by_72p2_402c3Civ(d);
    then qualified_plan_loan_offset_amount_402c3C(d, amount);
}

pub relation distribution_would_not_be_treated_eligible_without_2020_rmd_waiver_402c4(d: Distribution) kind empirical {
    label en unofficial "the distribution was during 2020 and is treated as an eligible rollover distribution but would not be so treated if the minimum distribution requirements of section 401(a)(9) had applied during 2020, case-asserted";
}

pub relation not_eligible_rollover_distribution_by_2020_rule_402c4(d: Distribution) kind institutional {
    label en official "section 402(c)(4) last sentence: such a 2020 distribution is not an eligible rollover distribution for section 401(a)(31), 3405(c) or subsection (f)";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "such distribution shall not be treated as an eligible rollover distribution for purposes of section 401(a)(31) or 3405(c) or subsection (f) of this section")
rule NotEligibleRolloverDistributionBy2020Rule402c4(d: Distribution) strict {
    label en official "2020 waiver of minimum distributions";
    when distribution_would_not_be_treated_eligible_without_2020_rmd_waiver_402c4(d);
    then not_eligible_rollover_distribution_by_2020_rule_402c4(d);
}

pub relation transfer_excluded_under_402c1_to_ira_402c5(d: Distribution) kind empirical {
    label en unofficial "a transfer to an eligible retirement plan described in clause (i) or (ii) of paragraph (8)(B) results in an exclusion under paragraph (1), case-asserted";
}

pub relation transfer_is_rollover_contribution_408d3_402c5(d: Distribution) kind institutional {
    label en official "section 402(c)(5): such a transfer is treated as a rollover contribution described in section 408(d)(3)";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "shall be treated as a rollover contribution described in section 408(d)(3)")
rule TransferIsRolloverContribution408d3402c5(d: Distribution) strict {
    label en official "IRA transfer";
    when transfer_excluded_under_402c1_to_ira_402c5(d);
    then transfer_is_rollover_contribution_408d3_402c5(d);
}

pub relation sale_proceeds_transferred_402c6A(d: Distribution, proceeds: Money) kind empirical {
    label en unofficial "the amount transferred equals proceeds from the sale of property received in the distribution, case-asserted";
}

pub relation proceeds_treated_as_property_transferred_402c6A(d: Distribution, proceeds: Money) kind institutional {
    label en official "section 402(c)(6)(A): the transfer of the sale proceeds is treated as the transfer of the property received";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "shall be treated as the transfer of property received in the distribution")
rule ProceedsTreatedAsPropertyTransferred402c6A(d: Distribution, proceeds: Money) strict {
    label en official "sale proceeds";
    when sale_proceeds_transferred_402c6A(d, proceeds);
    then proceeds_treated_as_property_transferred_402c6A(d, proceeds);
}

pub relation fair_market_value_on_sale_402c6B(d: Distribution, value: Money) kind empirical {
    label en unofficial "the fair market value of the property on the sale, case-asserted";
}

pub relation fair_market_value_on_distribution_402c6B(d: Distribution, value: Money) kind empirical {
    label en unofficial "the fair market value of the property on distribution, case-asserted";
}

pub relation appreciation_treated_as_property_received_402c6B(d: Distribution, amount: Money) kind institutional {
    label en official "section 402(c)(6)(B): the excess of the sale value over the distribution value is treated as property received in the distribution";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "The excess of fair market value of property on sale over its fair market value on distribution shall be treated as property received in the distribution")
rule AppreciationTreatedAsPropertyReceived402c6B(d: Distribution, sale: Money, dist: Money) strict {
    label en official "exact boundary: an excess only (no result when the sale value is not above the distribution value)";
    when fair_market_value_on_sale_402c6B(d, sale)
        and fair_market_value_on_distribution_402c6B(d, dist)
        and sale > dist;
    then appreciation_treated_as_property_received_402c6B(d, sale - dist);
}

pub relation portion_attributable_to_nonincluded_amounts_402c6C(d: Distribution, portion: Money) kind empirical {
    label en unofficial "the ratable portion of the money or property attributable to amounts not included in gross income, case-asserted";
}

pub relation taxpayer_designation_402c6C(d: Distribution, portion: Money, made_on: Date) kind empirical {
    label en unofficial "the taxpayer's designation of the portion attributable to amounts not included, and the date made, case-asserted";
}

pub relation return_due_date_for_designation_402c6C(d: Distribution, due: Date) kind empirical {
    label en unofficial "the time prescribed by law (with extensions) for filing the return for the taxable year, case-asserted";
}

pub relation nonincluded_portion_402c6C(d: Distribution, portion: Money) kind institutional {
    label en official "section 402(c)(6)(C): the portion attributable to amounts not included is ratable unless the taxpayer timely designates otherwise (a designation is irrevocable)";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "shall be determined on a ratable basis unless the taxpayer designates otherwise")
rule NonincludedPortionRatable402c6C(d: Distribution, ratable: Money) strict {
    label en official "ratable basis absent a designation";
    when portion_attributable_to_nonincluded_amounts_402c6C(d, ratable)
        and not_known(taxpayer_designation_402c6C_present(d));
    then nonincluded_portion_402c6C(d, ratable);
}

pub relation taxpayer_designation_402c6C_present(d: Distribution) kind institutional {
    label en unofficial "helper: a designation was made";
}

rule TaxpayerDesignation402c6CPresent(d: Distribution, portion: Money, on: Date) strict {
    label en unofficial "derives the helper";
    when taxpayer_designation_402c6C(d, portion, on);
    then taxpayer_designation_402c6C_present(d);
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "Any designation under this subparagraph for a taxable year shall be made not later than the time prescribed by law for filing the return for such taxable year (including extensions thereof)")
rule NonincludedPortionDesignated402c6C(d: Distribution, portion: Money, made: Date, due: Date) strict {
    label en official "exact boundary: a designation on the due date is timely; the day after is not";
    when taxpayer_designation_402c6C(d, portion, made)
        and return_due_date_for_designation_402c6C(d, due)
        and made <= due;
    then nonincluded_portion_402c6C(d, portion);
}

pub relation sale_proceeds_transferred_amount_402c6D(d: Distribution, proceeds: Money, transferred: Money) kind empirical {
    label en unofficial "the sale proceeds and the amount transferred pursuant to paragraph (1), case-asserted";
}

pub relation gain_or_loss_recognized_on_sale_402c6D(d: Distribution, proceeds: Money, recognized_share: Money) kind institutional {
    label en official "section 402(c)(6)(D): no gain or loss is recognized on the sale to the extent an amount equal to the proceeds is transferred (the share of proceeds not transferred stays subject to recognition)";
}

@source(IRC_S402_C, relation = formalizes, coverage = partial, quote = "No gain or loss shall be recognized on any sale described in subparagraph (A) to the extent that an amount equal to the proceeds is transferred pursuant to paragraph (1)")
rule GainOrLossRecognizedOnSale402c6D(d: Distribution, proceeds: Money, transferred: Money) strict {
    label en official "PARTIAL: the proceeds share not transferred = proceeds - min(proceeds, transferred); the gain computation is gross-income";
    when sale_proceeds_transferred_amount_402c6D(d, proceeds, transferred);
    then gain_or_loss_recognized_on_sale_402c6D(d, proceeds, proceeds - min(proceeds, transferred));
}

pub relation frozen_deposit_reason_402c7B(d: Distribution) kind empirical {
    label en unofficial "the deposit may not be withdrawn because of the bankruptcy or insolvency of a financial institution, or a State requirement imposed by reason of the bankruptcy or insolvency (or threat thereof) of one or more financial institutions in the State, case-asserted";
}

pub relation deposit_frozen_on_a_day_in_the_60_day_period_402c7B(d: Distribution) kind empirical {
    label en unofficial "on at least 1 day of the 60-day period (without regard to paragraph (7)) the deposit is frozen, case-asserted";
}

pub relation frozen_deposit_402c7B(d: Distribution) kind institutional {
    label en official "section 402(c)(7)(B): a frozen deposit is one that may not be withdrawn for the described reasons and frozen on at least one day of the 60-day period";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "A deposit shall not be treated as a frozen deposit unless on at least 1 day during the 60-day period")
rule FrozenDeposit402c7B(d: Distribution) strict {
    label en official "both conditions";
    when frozen_deposit_reason_402c7B(d)
        and deposit_frozen_on_a_day_in_the_60_day_period_402c7B(d);
    then frozen_deposit_402c7B(d);
}

pub relation qualified_trust_402c8A(trust: Plan) kind institutional {
    label en official "section 402(c)(8)(A): an employees' trust described in section 401(a) which is exempt from tax under section 501(a)";
}

pub relation employees_trust_described_in_401a_402c8A(trust: Plan) kind empirical {
    label en unofficial "the trust is an employees' trust described in section 401(a), case-asserted";
}

pub relation trust_exempt_under_501a_402c8A(trust: Plan) kind empirical {
    label en unofficial "the trust is exempt from tax under section 501(a), case-asserted";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "The term \"qualified trust\" means an employees' trust described in section 401(a) which is exempt from tax under section 501(a).")
rule QualifiedTrust402c8A(trust: Plan) strict {
    label en official "both conditions";
    when employees_trust_described_in_401a_402c8A(trust)
        and trust_exempt_under_501a_402c8A(trust);
    then qualified_trust_402c8A(trust);
}

pub relation portion_attributable_to_designated_roth_account_402c8B(d: Distribution) kind empirical {
    label en unofficial "the portion of the eligible rollover distribution is attributable to a designated Roth account (section 402A), case-asserted";
}

pub relation receiving_plan_is_designated_roth_account_or_roth_ira_402c8B(target: Plan) kind empirical {
    label en unofficial "the receiving plan is another designated Roth account or a Roth IRA, case-asserted";
}

pub relation eligible_retirement_plan_for_roth_portion_402c8B(d: Distribution, target: Plan) kind institutional {
    label en official "section 402(c)(8)(B) last sentence: for a designated Roth account portion an eligible retirement plan includes only another designated Roth account or a Roth IRA";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "an eligible retirement plan with respect to such portion shall include only another designated Roth account and a Roth IRA")
rule EligibleRetirementPlanForRothPortion402c8B(d: Distribution, target: Plan) strict {
    label en official "Roth portion to a Roth account or Roth IRA";
    when portion_attributable_to_designated_roth_account_402c8B(d)
        and receiving_plan_is_designated_roth_account_or_roth_ira_402c8B(target);
    then eligible_retirement_plan_for_roth_portion_402c8B(d, target);
}

pub relation receiving_457b_plan_agrees_to_separate_accounting_402c10(target: Plan) kind empirical {
    label en unofficial "the section 457(b) plan agrees to separately account for amounts rolled into it from plans not described in clause (v), case-asserted";
}

pub relation transfer_from_non_457b_plan_402c10(from_plan: Plan, target: Plan) kind empirical {
    label en unofficial "the transfer or rollover comes from an eligible retirement plan not described in clause (v), case-asserted";
}

pub relation eligible_457b_plan_may_accept_transfer_402c10(from_plan: Plan, target: Plan) kind institutional {
    label en official "section 402(c)(10): an eligible 457(b) plan may accept transfers from other plans only if it agrees to separate accounting";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "Unless a plan described in clause (v) of paragraph (8)(B) agrees to separately account for amounts rolled into such plan")
rule Eligible457bPlanMayAcceptTransfer402c10(from_plan: Plan, target: Plan) strict {
    label en official "separate accounting agreement";
    when transfer_from_non_457b_plan_402c10(from_plan, target)
        and receiving_457b_plan_agrees_to_separate_accounting_402c10(target);
    then eligible_457b_plan_may_accept_transfer_402c10(from_plan, target);
}

pub relation inherited_ira_treatment_402c11(d: Distribution, beneficiary: Person) kind institutional {
    label en official "section 402(c)(11)(A)(ii)-(iii): the receiving IRA is an inherited IRA and section 401(a)(9)(B) (other than clause (iv)) applies to it";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the individual retirement plan shall be treated as an inherited individual retirement account or individual retirement annuity")
rule InheritedIraTreatment402c11(d: Distribution, beneficiary: Person) strict {
    label en official "a qualifying direct transfer (module 34)";
    when direct_transfer_to_inherited_ira_402c11(d, beneficiary);
    then inherited_ira_treatment_402c11(d, beneficiary);
}

pub relation overpayment_from_414aa1_plan_transferred_402c12(d: Distribution, overpayment: Money, recoupment_sought: Money) kind empirical {
    label en unofficial "an inadvertent benefit overpayment from a plan to which section 414(aa)(1) applies was transferred to an eligible retirement plan, its amount and the portion for which recoupment is sought, case-asserted";
}

pub relation overpayment_would_have_been_eligible_rollover_402c12A(d: Distribution) kind empirical {
    label en unofficial "the payment would have been an eligible rollover distribution but for being an overpayment, case-asserted";
}

pub relation overpayment_portion_treated_as_rollover_distribution_402c12A(d: Distribution, amount: Money) kind institutional {
    label en official "section 402(c)(12)(A): the portion for which recoupment is not sought is treated as paid in an eligible rollover distribution";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the portion of such overpayment with respect to which recoupment is not sought on behalf of the plan shall be treated as having been paid in an eligible rollover distribution")
rule OverpaymentPortionTreatedAsRolloverDistribution402c12A(d: Distribution, paid: Money, sought: Money) strict {
    label en official "overpayment - recoupment sought";
    when overpayment_from_414aa1_plan_transferred_402c12(d, paid, sought)
        and overpayment_would_have_been_eligible_rollover_402c12A(d);
    then overpayment_portion_treated_as_rollover_distribution_402c12A(d, max(0 USD, paid - sought));
}

pub relation overpayment_recouped_portion_treated_as_transfer_402c12B(d: Distribution, amount: Money) kind institutional {
    label en official "section 402(c)(12)(B): the portion for which recoupment is sought may be returned to the plan and is treated as an eligible rollover distribution transferred to the plan";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the portion of such overpayment with respect to which recoupment is sought on behalf of the plan shall be permitted to be returned to such plan")
rule OverpaymentRecoupedPortionTreatedAsTransfer402c12B(d: Distribution, paid: Money, sought: Money) strict {
    label en official "the recoupment portion";
    when overpayment_from_414aa1_plan_transferred_402c12(d, paid, sought);
    then overpayment_recouped_portion_treated_as_transfer_402c12B(d, min(paid, sought));
}

pub relation repayment_rules_72t11C_ii_iii_apply_402c13(d: Distribution) kind institutional {
    label en official "section 402(c)(13)(A)(ii): rules similar to section 72(t)(11)(C)(ii) and (iii) apply to repayments (an external cross-reference)";
}

// =====================================================================
// (e)(1)(B), (e)(2), (e)(4) NUA and lump sums
// =====================================================================

pub relation qdro_alternate_payee_spouse_distribution_402e1B(d: Distribution, alternate_payee: Person) kind empirical {
    label en unofficial "an amount is paid to an alternate payee who is the spouse or former spouse of the participant by reason of a qualified domestic relations order, case-asserted";
}

pub relation subsection_c_applies_to_alternate_payee_402e1B(d: Distribution, alternate_payee: Person) kind institutional {
    label en official "section 402(e)(1)(B): subsection (c) applies to the alternate payee spouse as if the alternate payee were the employee";
}

@source(IRC_S402_E, relation = formalizes, coverage = partial, quote = "to an alternate payee who is the spouse or former spouse of the participant by reason of any qualified domestic relations order")
rule SubsectionCAppliesToAlternatePayee402e1B(d: Distribution, alternate_payee: Person) strict {
    label en official "PARTIAL: the qualified domestic relations order determination is module 52";
    when qdro_alternate_payee_spouse_distribution_402e1B(d, alternate_payee);
    then subsection_c_applies_to_alternate_payee_402e1B(d, alternate_payee);
}

pub relation nua_in_securities_attributable_to_employee_contributions_402e4A(d: Distribution, amount: Money) kind empirical {
    label en unofficial "net unrealized appreciation in securities of the employer corporation attributable to amounts contributed by the employee (other than deductible employee contributions), case-asserted";
}

pub relation distribution_is_lump_sum_or_rollover_402e4A(d: Distribution) kind empirical {
    label en unofficial "the distribution is a lump sum distribution or a distribution to which subsection (c) applies, case-asserted";
}

pub relation nua_excluded_from_amount_distributed_402e4A(d: Distribution, amount: Money) kind institutional {
    label en official "section 402(e)(4)(A): in a distribution other than a lump sum, the amount distributed does not include NUA attributable to employee contributions";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "the amount actually distributed to any distributee from a trust described in subsection (a) shall not include any net unrealized appreciation in securities of the employer corporation attributable to amounts contributed by the employee")
rule NuaExcludedFromAmountDistributed402e4A(d: Distribution, amount: Money) strict {
    label en official "not a lump sum and not a subsection (c) distribution";
    when nua_in_securities_attributable_to_employee_contributions_402e4A(d, amount)
        and not_known(distribution_is_lump_sum_or_rollover_402e4A(d));
    then nua_excluded_from_amount_distributed_402e4A(d, amount);
}

pub relation nua_regulations_determine_402e4C(d: Distribution) kind institutional {
    label en official "section 402(e)(4)(C): net unrealized appreciation and resulting basis adjustments follow the Secretary's regulations (an external determination)";
}

pub relation qualified_trust_balance_of_plans_aggregated_402e4dii(employee: Person, amount: Money) kind empirical {
    label en unofficial "the balance to the credit of the employee after aggregating all trusts of a plan, all pension plans, all profit-sharing plans and all stock bonus plans of the employer as separate single plans, case-asserted";
}

pub relation excluded_nonqualified_balances_402e4dii2(employee: Person, amount: Money) kind empirical {
    label en unofficial "balances in trusts not qualified under section 401(a) and in annuity contracts that do not satisfy section 404(a)(2), case-asserted";
}

pub relation qdro_alternate_payee_balance_402e4dv(employee: Person, amount: Money) kind empirical {
    label en unofficial "the amount payable to an alternate payee under a qualified domestic relations order, case-asserted";
}

pub relation coli_transfer_balance_402e4dvi(employee: Person, amount: Money) kind empirical {
    label en unofficial "the amount transferred from a defined contribution plan to a qualified cost-of-living arrangement (section 415(k)(2)) under a defined benefit plan, case-asserted";
}

pub relation gross_balance_to_credit_402e4d(employee: Person, amount: Money) kind empirical {
    label en unofficial "the total balance to the credit of the employee across the aggregated plans before the exclusions of clauses (ii)(II), (v) and (vi), case-asserted";
}

pub relation balance_to_credit_of_employee_402e4d(employee: Person, amount: Money) kind institutional {
    label en official "section 402(e)(4)(D)(ii), (v), (vi): the balance to the credit excludes nonqualified trusts and contracts, amounts payable to an alternate payee under a QDRO and amounts transferred to a qualified cost-of-living arrangement";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "the balance to the credit of an employee shall not include any amount payable to an alternate payee under a qualified domestic relations order")
rule BalanceToCreditOfEmployee402e4d(employee: Person, gross: Money, nonq: Money, qdro: Money, coli: Money) strict {
    label en official "gross - nonqualified - QDRO amounts - cost-of-living transfers, not below zero";
    when gross_balance_to_credit_402e4d(employee, gross)
        and excluded_nonqualified_balances_402e4dii2(employee, nonq)
        and qdro_alternate_payee_balance_402e4dv(employee, qdro)
        and coli_transfer_balance_402e4dvi(employee, coli);
    then balance_to_credit_of_employee_402e4d(employee, max(0 USD, gross - nonq - qdro - coli));
}

pub relation distribution_amount_described_72m5A_402e4diii(d: Distribution) kind empirical {
    label en unofficial "the distribution consists of amounts described in section 72(m)(5)(A) to the extent that section 72(m)(5) applies, case-asserted";
}

pub relation lump_sum_paragraph_inapplicable_to_72m5_amounts_402e4div(d: Distribution) kind institutional {
    label en official "section 402(e)(4)(D)(iv): the paragraph does not apply to amounts described in section 72(m)(5)(A) to the extent section 72(m)(5) applies";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to amounts described in subparagraph (A) of section 72(m)(5) to the extent that section 72(m)(5) applies to such amounts.")
rule LumpSumParagraphInapplicableTo72m5Amounts402e4div(d: Distribution) strict {
    label en official "72(m)(5) amounts";
    when distribution_amount_described_72m5A_402e4diii(d);
    then lump_sum_paragraph_inapplicable_to_72m5_amounts_402e4div(d);
}

pub relation alternate_payee_spouse_balance_402e4dvii(alternate_payee: Person, amount: Money) kind empirical {
    label en unofficial "the balance to the credit of an alternate payee who is the spouse or former spouse, excluding any amount payable to the employee, case-asserted";
}

pub relation employee_distribution_would_be_lump_sum_402e4dvii(employee: Person) kind empirical {
    label en unofficial "a distribution or payment of the balance to the credit of the employee would be treated as a lump-sum distribution, case-asserted";
}

pub relation alternate_payee_payment_treated_as_lump_sum_402e4dvii(alternate_payee: Person, employee: Person, amount: Money) kind institutional {
    label en official "section 402(e)(4)(D)(vii): the QDRO payment of the alternate payee spouse's balance is treated as a lump-sum distribution";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "the payment under a qualified domestic relations order (within the meaning of section 414(p)) of the balance to the credit of an alternate payee who is the spouse or former spouse of the employee shall be treated as a lump-sum distribution")
rule AlternatePayeePaymentTreatedAsLumpSum402e4dvii(alternate_payee: Person, employee: Person, amount: Money) strict {
    label en official "when the employee's own distribution would be a lump sum";
    when employee_distribution_would_be_lump_sum_402e4dvii(employee)
        and alternate_payee_spouse_balance_402e4dvii(alternate_payee, amount);
    then alternate_payee_payment_treated_as_lump_sum_402e4dvii(alternate_payee, employee, amount);
}

pub enum SecurityKind402e4Ei {
    SharesOfStock;
    BondWithCoupons;
    BondRegistered;
    Debenture;
    OtherInstrument;
}

pub relation instrument_issued_by_corporation_402e4Ei(item: Person, kind: SecurityKind402e4Ei) kind empirical {
    label en unofficial "the instrument and its kind (shares of stock, or bonds or debentures with interest coupons or in registered form), issued by a corporation, case-asserted";
}

pub relation security_402e4Ei(item: Person) kind institutional {
    label en official "section 402(e)(4)(E)(i): only shares of stock and bonds or debentures issued by a corporation with interest coupons or in registered form";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "The term \"securities\" means only shares of stock and bonds or debentures issued by a corporation with interest coupons or in registered form.")
rule SecurityShares402e4Ei(item: Person) strict {
    label en official "shares of stock";
    when instrument_issued_by_corporation_402e4Ei(item, SharesOfStock);
    then security_402e4Ei(item);
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "bonds or debentures issued by a corporation with interest coupons or in registered form")
rule SecurityBondCoupons402e4Ei(item: Person) strict {
    label en official "bond with coupons";
    when instrument_issued_by_corporation_402e4Ei(item, BondWithCoupons);
    then security_402e4Ei(item);
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "bonds or debentures issued by a corporation with interest coupons or in registered form")
rule SecurityBondRegistered402e4Ei(item: Person) strict {
    label en official "registered bond";
    when instrument_issued_by_corporation_402e4Ei(item, BondRegistered);
    then security_402e4Ei(item);
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "bonds or debentures issued by a corporation with interest coupons or in registered form")
rule SecurityDebenture402e4Ei(item: Person) strict {
    label en official "debenture (with coupons or registered: the kind names are separate; a bare debenture is asserted as a coupon or registered bond)";
    when instrument_issued_by_corporation_402e4Ei(item, Debenture);
    then security_402e4Ei(item);
}

pub relation security_of_parent_or_subsidiary_402e4Eii(item: Person, employer_corporation: Person) kind empirical {
    label en unofficial "the security is issued by a parent or subsidiary corporation (section 424(e), (f)) of the employer corporation, case-asserted";
}

pub relation security_of_employer_corporation_402e4Eii(item: Person, employer_corporation: Person) kind institutional {
    label en official "section 402(e)(4)(E)(ii): securities of the employer corporation include securities of a parent or subsidiary corporation";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "The term \"securities of the employer corporation\" includes securities of a parent or subsidiary corporation")
rule SecurityOfEmployerCorporation402e4Eii(item: Person, employer_corporation: Person) strict {
    label en official "parent or subsidiary security that is a security";
    when security_402e4Ei(item)
        and security_of_parent_or_subsidiary_402e4Eii(item, employer_corporation);
    then security_of_employer_corporation_402e4Eii(item, employer_corporation);
}

// =====================================================================
// (f)(1) Written explanation content
// =====================================================================

pub enum ExplanationItem402f1 {
    DirectTransferAndAutomaticTransfer401a31B;
    WithholdingIfNotDirectlyTransferred;
    NoTaxIfTransferredWithin60Days;
    SubsectionsDAndEIfApplicable;
    ReceivingPlanRestrictionsAndTaxConsequences;
}

pub relation explanation_covers_item_402f1(plan: Plan, recipient: Person, d: Distribution, item: ExplanationItem402f1) kind empirical {
    label en unofficial "the written explanation covers the item, case-asserted";
}

pub relation subsections_d_and_e_applicable_402f1D(d: Distribution) kind empirical {
    label en unofficial "the provisions of subsections (d) and (e) apply to the distribution, case-asserted";
}

pub relation explanation_content_complete_402f1(plan: Plan, recipient: Person, d: Distribution) kind institutional {
    label en official "section 402(f)(1)(A)-(E): the explanation covers direct transfer and automatic transfer, withholding, the 60-day rule, subsections (d) and (e) if applicable, and the receiving plan's different restrictions";
}

@source(IRC_S402_F, relation = formalizes, coverage = exact, quote = "of the provisions under which distributions from the eligible retirement plan receiving the distribution may be subject to restrictions and tax consequences")
rule ExplanationContentComplete402f1(plan: Plan, recipient: Person, d: Distribution) strict {
    label en official "items A, B, C and E, and D when subsections (d) and (e) apply";
    when explanation_covers_item_402f1(plan, recipient, d, DirectTransferAndAutomaticTransfer401a31B)
        and explanation_covers_item_402f1(plan, recipient, d, WithholdingIfNotDirectlyTransferred)
        and explanation_covers_item_402f1(plan, recipient, d, NoTaxIfTransferredWithin60Days)
        and explanation_covers_item_402f1(plan, recipient, d, ReceivingPlanRestrictionsAndTaxConsequences)
        and not_known(subsections_d_and_e_applicable_402f1D(d));
    then explanation_content_complete_402f1(plan, recipient, d);
}

@source(IRC_S402_F, relation = formalizes, coverage = exact, quote = "if applicable, of the provisions of subsections (d) and (e) of this section")
rule ExplanationContentCompleteWithDE402f1(plan: Plan, recipient: Person, d: Distribution) strict {
    label en official "with the item D covered when subsections (d) and (e) apply";
    when explanation_covers_item_402f1(plan, recipient, d, DirectTransferAndAutomaticTransfer401a31B)
        and explanation_covers_item_402f1(plan, recipient, d, WithholdingIfNotDirectlyTransferred)
        and explanation_covers_item_402f1(plan, recipient, d, NoTaxIfTransferredWithin60Days)
        and explanation_covers_item_402f1(plan, recipient, d, SubsectionsDAndEIfApplicable)
        and explanation_covers_item_402f1(plan, recipient, d, ReceivingPlanRestrictionsAndTaxConsequences)
        and subsections_d_and_e_applicable_402f1D(d);
    then explanation_content_complete_402f1(plan, recipient, d);
}

// =====================================================================
// (g) Excess deferrals, elective deferrals, self-employed and 15-year rules
// =====================================================================

pub relation excess_deferral_distribution_made_on_402g2Aii(participant: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the plan distributes the allocated excess deferrals and allocable income, case-asserted";
}

pub relation distribution_may_be_made_notwithstanding_other_law_402g2A(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 402(g)(2)(A) last sentence: the distribution described in clause (ii) may be made notwithstanding any other provision of law";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "The distribution described in clause (ii) may be made notwithstanding any other provision of law.")
rule DistributionMayBeMadeNotwithstandingOtherLaw402g2A(participant: Person, y: TaxableYear) strict {
    label en official "a timely corrective distribution (module 34 tests timeliness)";
    when excess_deferral_distribution_timely_402g2A(participant, y);
    then distribution_may_be_made_notwithstanding_other_law_402g2A(participant, y);
}

pub relation excess_deferral_distribution_treated_as_employer_contribution_402g2B(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 402(g)(2)(B): a distributed excess deferral is treated as an employer contribution for section 401(k)(3)(A)(ii), except as the Secretary provides";
}

@source(IRC_S402_G, relation = formalizes, coverage = partial, quote = "such portion shall, for purposes of applying section 401(k)(3)(A)(ii), be treated as an employer contribution")
rule ExcessDeferralDistributionTreatedAsEmployerContribution402g2B(participant: Person, y: TaxableYear) strict {
    label en official "PARTIAL: the Secretary's rules are not pinned";
    when excess_deferral_distribution_timely_402g2A(participant, y);
    then excess_deferral_distribution_treated_as_employer_contribution_402g2B(participant, y);
}

pub relation income_on_excess_deferral_distributed_402g2C(participant: Person, y: TaxableYear, income: Money, distribution_year: TaxableYear) kind empirical {
    label en unofficial "the income on the excess deferral and the taxable year in which it is distributed, case-asserted";
}

pub relation income_taxable_in_year_distributed_402g2C(participant: Person, y: TaxableYear, distribution_year: TaxableYear, income: Money) kind institutional {
    label en official "section 402(g)(2)(C)(ii): the income on the excess deferral is treated as earned and received in the taxable year in which it is distributed";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "any income on the excess deferral shall, for purposes of this chapter, be treated as earned and received in the taxable year in which such income is distributed")
rule IncomeTaxableInYearDistributed402g2C(participant: Person, y: TaxableYear, income: Money, dy: TaxableYear) strict {
    label en official "the distribution year";
    when income_on_excess_deferral_distributed_402g2C(participant, y, income, dy);
    then income_taxable_in_year_distributed_402g2C(participant, y, dy, income);
}

pub relation no_72t_tax_on_corrective_distribution_402g2C(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 402(g)(2)(C) last sentence: no section 72(t) tax on such a distribution";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 72(t) on any distribution described in the preceding sentence.")
rule No72tTaxOnCorrectiveDistribution402g2C(participant: Person, y: TaxableYear) strict {
    label en official "timely corrective distribution";
    when excess_deferral_distribution_timely_402g2A(participant, y);
    then no_72t_tax_on_corrective_distribution_402g2C(participant, y);
}

pub relation partial_distribution_amount_402g2D(participant: Person, y: TaxableYear, distributed: Money, excess: Money, income: Money) kind empirical {
    label en unofficial "the portion distributed, the excess deferral and its income, case-asserted";
}

pub relation partial_distribution_ratable_excess_part_402g2D(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(g)(2)(D): a partial distribution is treated as distributed ratably from the excess deferral and the income (the excess deferral part, HALF_UP to the cent: JUDGMENT CALL)";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "such portion shall be treated as having been distributed ratably from the excess deferral and the income")
rule PartialDistributionRatableExcessPart402g2D(participant: Person, y: TaxableYear, distributed: Money, excess: Money, income: Money) strict {
    label en official "distributed x excess / (excess + income)";
    when partial_distribution_amount_402g2D(participant, y, distributed, excess, income)
        and excess + income > 0 USD;
    then partial_distribution_ratable_excess_part_402g2D(participant, y, round(distributed * (excess / 1.00 USD) / ((excess + income) / 1.00 USD), 2, "HALF_UP"));
}

pub relation contribution_kind_402g3(participant: Person, y: TaxableYear, kind: Integer, amount: Money) kind empirical {
    label en unofficial "employer contributions by kind (1 = qualified cash or deferred arrangement (e)(3), 2 = SEP election (h)(1)(B), 3 = section 403(b) salary reduction, 4 = SIMPLE elective (408(p)(2)(A)(i))), case-asserted";
}

pub relation one_time_irrevocable_election_402g3(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the salary reduction contribution is made under a one-time irrevocable election at initial eligibility (or a similar arrangement in regulations), case-asserted";
}

pub relation elective_deferrals_402g3(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(g)(3): the sum of the four kinds of employer contributions, but a 403(b) contribution under a one-time irrevocable election is not an elective deferral";
}

@source(IRC_S402_G, relation = formalizes, coverage = partial, quote = "the term \"elective deferrals\" means, with respect to any taxable year, the sum of")
rule ElectiveDeferrals402g3(participant: Person, y: TaxableYear) strict {
    label en official "PARTIAL: the sum of the kinds (1, 2, 4 and 3 unless a one-time irrevocable election); the one-time election marks the whole 403(b) kind";
    when contribution_kind_402g3(participant, y, _, _)
        and not_known(one_time_irrevocable_election_402g3(participant, y));
    then elective_deferrals_402g3(participant, y,
        sum all amt: Money for k: Integer where contribution_kind_402g3(participant, y, k, amt) and k >= 1 and k <= 4);
}

@source(IRC_S402_G, relation = formalizes, coverage = partial, quote = "An employer contribution shall not be treated as an elective deferral described in subparagraph (C) if under the salary reduction agreement such contribution is made pursuant to a one-time irrevocable election")
rule ElectiveDeferralsWithoutOneTimeElection402g3(participant: Person, y: TaxableYear) strict {
    label en official "PARTIAL: with a one-time irrevocable election, kind 3 is excluded";
    when contribution_kind_402g3(participant, y, _, _)
        and one_time_irrevocable_election_402g3(participant, y);
    then elective_deferrals_402g3(participant, y,
        sum all amt: Money for k: Integer where contribution_kind_402g3(participant, y, k, amt) and k >= 1 and k <= 4 and k != 3);
}

pub relation subsection_g_applied_without_community_property_402g5(participant: Person) kind institutional {
    label en official "section 402(g)(5): the subsection is applied without regard to community property laws (a rule of application for the case-asserted amounts)";
}

pub relation amount_includible_but_not_distributed_402g6(participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount includible in gross income under subsection (g) but not distributed from the plan during the taxable year, case-asserted";
}

pub relation not_investment_in_the_contract_402g6(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(g)(6): for section 72 such an amount is not investment in the contract";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "shall not be treated as investment in the contract")
rule NotInvestmentInTheContract402g6(participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "undistributed includible excess";
    when amount_includible_but_not_distributed_402g6(participant, y, amount);
    then not_investment_in_the_contract_402g6(participant, y, amount);
}

pub relation qualified_organization_kind_402g7B(org: Person, kind: Integer) kind empirical {
    label en unofficial "the organization's kind (1 = educational organization, 2 = hospital, 3 = home health service agency, 4 = health and welfare service agency, 5 = church, 6 = convention or association of churches, 7 = organization described in section 414(e)(3)(B)(ii)), case-asserted";
}

pub relation qualified_organization_402g7B(org: Person) kind institutional {
    label en official "section 402(g)(7)(B): an educational organization, hospital, home health service agency, health and welfare service agency, church, or convention or association of churches (and section 414(e)(3)(B)(ii) organizations)";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "the term \"qualified organization\" means any educational organization, hospital, home health service agency, health and welfare service agency, church, or convention or association of churches")
rule QualifiedOrganization402g7B(org: Person, kind: Integer) strict {
    label en official "kinds 1 to 7";
    when qualified_organization_kind_402g7B(org, kind)
        and kind >= 1 and kind <= 7;
    then qualified_organization_402g7B(org);
}

pub relation years_of_service_per_403b_402g7D(employee: Person, org: Person, years: Integer) kind empirical {
    label en unofficial "the employee's years of service with the organization determined under section 403(b), case-asserted";
}

pub relation qualified_employee_402g7C(employee: Person, org: Person) kind institutional {
    label en official "section 402(g)(7)(C): an employee with 15 years of service with the qualified organization";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "the term \"qualified employee\" means any employee who has completed 15 years of service with the qualified organization")
rule QualifiedEmployee402g7C(employee: Person, org: Person, years: Integer) strict {
    label en official "exact boundary: 15 years qualify, 14 do not";
    when qualified_organization_402g7B(org)
        and years_of_service_per_403b_402g7D(employee, org, years)
        and years >= 15;
    then qualified_employee_402g7C(employee, org);
}

pub relation matching_contribution_for_self_employed_402g8(employee: Person) kind empirical {
    label en unofficial "a matching contribution (401(m)(4)(A)) is made on behalf of a self-employed individual (section 401(c)), case-asserted";
}

pub relation included_by_401k3Dii_election_402g8(employee: Person) kind empirical {
    label en unofficial "the contribution is taken into account under section 401(k)(3)(D)(ii), case-asserted";
}

pub relation not_elective_employer_contribution_402g8(employee: Person) kind institutional {
    label en official "section 402(g)(8): such a matching contribution is not an elective employer contribution under a qualified cash or deferred arrangement";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "shall not be treated as an elective employer contribution under a qualified cash or deferred arrangement")
rule NotElectiveEmployerContribution402g8(employee: Person) strict {
    label en official "except as provided in 401(k)(3)(D)(ii)";
    when matching_contribution_for_self_employed_402g8(employee)
        and not_known(included_by_401k3Dii_election_402g8(employee));
    then not_elective_employer_contribution_402g8(employee);
}

// =====================================================================
// (h) SEP; (i), (j), (k), (l)
// =====================================================================

pub relation sep_contribution_402h1(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employer contributions on behalf of an employee to an individual retirement plan under a simplified employee pension, case-asserted";
}

pub relation sep_to_roth_ira_402h1C(employee: Person, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the contributions are made to an individual retirement plan designated as a Roth IRA, case-asserted";
}

pub relation sep_contribution_not_distributed_or_made_available_402h1A(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 402(h)(1)(A)-(B): SEP contributions are not treated as distributed, made available or contributed by the employee (including because an election is provided), except contributions to a Roth IRA and the excess of (h)(2)";
}

@source(IRC_S402_H, relation = formalizes, coverage = partial, quote = "shall not be treated as distributed or made available to the employee or as contributions made by the employee")
rule SepContributionNotDistributedOrMadeAvailable402h1A(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the (h)(2) excess (module 04) is separate";
    when sep_contribution_402h1(employee, employer, y, amount)
        and not_known(sep_to_roth_ira_402h1C(employee, employer, y));
    then sep_contribution_not_distributed_or_made_available_402h1A(employee, employer, y);
}

pub relation sep_contribution_excludable_from_gross_income_402h1C(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 402(h)(1)(C): a SEP contribution to a Roth IRA is not excludable from gross income";
}

pub relation sep_roth_contribution_not_excludable_402h1C(employee: Person, employer: Person, y: TaxableYear) kind institutional {
    label en official "section 402(h)(1)(C): the contribution is not excludable from gross income";
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "such contribution shall not be excludable from gross income")
rule SepRothContributionNotExcludable402h1C(employee: Person, employer: Person, y: TaxableYear, amount: Money) strict {
    label en official "Roth IRA";
    when sep_contribution_402h1(employee, employer, y, amount)
        and sep_to_roth_ira_402h1C(employee, employer, y);
    then sep_roth_contribution_not_excludable_402h1C(employee, employer, y);
}

pub relation hce_408k3D_amount_402h2B(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "for a highly compensated employee, the amount taken into account under section 408(k)(3)(D), case-asserted";
}

pub relation sep_limit_reduced_for_hce_402h2B(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(h)(2)(B): the section 415(c)(1)(A) limit reduced, for a highly compensated employee, by the amount taken into account under section 408(k)(3)(D)";
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "reduced in the case of any highly compensated employee (within the meaning of section 414(q)) by the amount taken into account with respect to such employee under section 408(k)(3)(D)")
rule SepLimitReducedForHce402h2B(employee: Person, y: TaxableYear, limit: Money, taken: Money) strict {
    label en official "max(0, limit - amount taken into account)";
    when sep_415c1a_limit(employee, y, limit)
        and hce_408k3D_amount_402h2B(employee, y, taken);
    then sep_limit_reduced_for_hce_402h2B(employee, y, max(0 USD, limit - taken));
}

pub relation sep_25_percent_of_compensation_402h2A(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(h)(2)(A): 25 percent of the section 414(s) compensation from the employer includible in gross income for the year, determined without regard to the SEP contributions";
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "25 percent of the compensation (within the meaning of section 414(s)) from such employer includible in the employee's gross income for the year")
rule Sep25PercentOfCompensation402h2A(employee: Person, employer: Person, y: TaxableYear, comp: Money) strict {
    label en official "round(comp x 0.25, 2, HALF_UP)";
    when sep_compensation_includible(employee, employer, y, comp);
    then sep_25_percent_of_compensation_402h2A(employee, employer, y, round(comp * 0.25, 2, "HALF_UP"));
}

pub relation amount_paid_out_of_sep_ira_402h3(payee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount paid or distributed out of an individual retirement plan under a simplified employee pension, case-asserted";
}

pub relation sep_ira_is_roth_402h3(payee: Person) kind empirical {
    label en unofficial "the individual retirement plan is designated as a Roth IRA, case-asserted";
}

pub relation sep_distribution_included_under_408d_402h3(payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(h)(3): included in gross income under section 408(d)";
}

pub relation sep_distribution_included_under_408Ad_402h3(payee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(h)(3): for a Roth IRA, included under section 408A(d)";
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "in accordance with the provisions of section 408(d)")
rule SepDistributionIncludedUnder408d402h3(payee: Person, y: TaxableYear, amount: Money) strict {
    label en official "traditional IRA";
    when amount_paid_out_of_sep_ira_402h3(payee, y, amount)
        and not_known(sep_ira_is_roth_402h3(payee));
    then sep_distribution_included_under_408d_402h3(payee, y, amount);
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "or section 408A(d) in the case of an individual retirement plan designated as a Roth IRA")
rule SepDistributionIncludedUnder408Ad402h3(payee: Person, y: TaxableYear, amount: Money) strict {
    label en official "Roth IRA";
    when amount_paid_out_of_sep_ira_402h3(payee, y, amount)
        and sep_ira_is_roth_402h3(payee);
    then sep_distribution_included_under_408Ad_402h3(payee, y, amount);
}

pub relation self_employed_individual_401c1B_402i(person: Person) kind empirical {
    label en unofficial "the person is a self-employed individual (section 401(c)(1)(B)), case-asserted";
}

pub relation employee_includes_self_employed_402i(person: Person) kind institutional {
    label en official "section 402(i): the term employee includes a self-employed individual (except in (e)(4)(D)(i)) and the employer is the person treated as employer under section 401(c)(4)";
}

@source(IRC_S402_I, relation = formalizes, coverage = exact, quote = "the term \"employee\" includes a self-employed individual")
rule EmployeeIncludesSelfEmployed402i(person: Person) strict {
    label en official "self-employed individual";
    when self_employed_individual_401c1B_402i(person);
    then employee_includes_self_employed_402i(person);
}

pub relation plan_trustee_exchanges_employer_securities_402j2A(plan: Plan, employee: Person) kind empirical {
    label en unofficial "the plan trustee exchanges the plan's securities of the employer corporation for other such securities, case-asserted";
}

pub relation plan_trustee_disposes_and_reacquires_402j2B(plan: Plan, employee: Person, disposed_on: Date, acquired_on: Date) kind empirical {
    label en unofficial "the plan trustee disposes of employer securities and uses the proceeds to acquire employer securities, and the dates, case-asserted";
}

pub relation money_distribution_between_disposition_and_acquisition_402j2B(plan: Plan, employee: Person) kind empirical {
    label en unofficial "a distribution of money was made to the employee after the disposition and before the acquisition, case-asserted";
}

pub relation subsection_j_transaction_402j2(plan: Plan, employee: Person) kind institutional {
    label en official "section 402(j)(2): an exchange of employer securities, or a disposition with reacquisition within 90 days (no money distribution to the employee in between)";
}

@source(IRC_S402_J, relation = formalizes, coverage = exact, quote = "the plan trustee exchanges the plan's securities of the employer corporation for other such securities")
rule SubsectionJTransactionExchange402j2A(plan: Plan, employee: Person) strict {
    label en official "clause (A)";
    when plan_trustee_exchanges_employer_securities_402j2A(plan, employee);
    then subsection_j_transaction_402j2(plan, employee);
}

@source(IRC_S402_J, relation = formalizes, coverage = partial, quote = "uses the proceeds of such disposition to acquire securities of the employer corporation within 90 days")
rule SubsectionJTransactionReacquisition402j2B(plan: Plan, employee: Person, disposed: Date, acquired: Date) strict {
    label en official "PARTIAL: exact boundary: within 90 days (day 90 is inside, day 91 is not); the Secretary's longer period is not pinned";
    when plan_trustee_disposes_and_reacquires_402j2B(plan, employee, disposed, acquired)
        and acquired >= disposed
        and days_between(disposed, acquired) <= 90
        and not_known(money_distribution_between_disposition_and_acquisition_402j2B(plan, employee));
    then subsection_j_transaction_402j2(plan, employee);
}

pub relation nua_determined_without_regard_to_transaction_402j1(plan: Plan, employee: Person) kind institutional {
    label en official "section 402(j)(1): for subsection (e)(4) the net unrealized appreciation is determined without regard to such a transaction";
}

@source(IRC_S402_J, relation = formalizes, coverage = exact, quote = "the determination of net unrealized appreciation shall be made without regard to such transaction")
rule NuaDeterminedWithoutRegardToTransaction402j1(plan: Plan, employee: Person) strict {
    label en official "subsection (j) transaction";
    when subsection_j_transaction_402j2(plan, employee);
    then nua_determined_without_regard_to_transaction_402j1(plan, employee);
}

pub relation simple_retirement_account_contribution_or_distribution_402k(person: Person) kind empirical {
    label en unofficial "a contribution to, or distribution from, a simple retirement account under section 408(p), case-asserted";
}

pub relation rules_of_402h1_and_h3_apply_402k(person: Person) kind institutional {
    label en official "section 402(k): rules similar to paragraphs (1) and (3) of subsection (h) apply to a simple retirement account";
}

@source(IRC_S402_K, relation = formalizes, coverage = exact, quote = "Rules similar to the rules of paragraphs (1) and (3) of subsection (h) shall apply to contributions and distributions with respect to a simple retirement account under section 408(p).")
rule RulesOf402h1AndH3Apply402k(person: Person) strict {
    label en official "SIMPLE retirement account";
    when simple_retirement_account_contribution_or_distribution_402k(person);
    then rules_of_402h1_and_h3_apply_402k(person);
}

pub relation psohealth_distributions_from_plan_402l3B(officer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate distributions from the eligible retirement plan in the taxable year, case-asserted";
}

pub relation psohealth_would_be_includible_if_all_distributed_402l3B(officer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount that would have been includible if all amounts to the credit of the officer in all eligible retirement plans of the employer were distributed in the year and all plans were treated as one contract, case-asserted";
}

pub relation psohealth_amount_treated_as_includible_distribution_402l3B(officer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(l)(3)(B): the distributions in the year (up to the amount excluded under paragraph (1)) are treated as includible to the extent of the aggregate that would have been includible on a one-contract basis";
}

@source(IRC_S402_L, relation = formalizes, coverage = partial, quote = "shall be treated as includible in gross income (without regard to subparagraph (A)) to the extent that such amount does not exceed the aggregate amount which would have been so includible")
rule PsohealthAmountTreatedAsIncludibleDistribution402l3B(officer: Person, y: TaxableYear, distributed: Money, would: Money, excludable: Money) strict {
    label en official "PARTIAL: min(distributions, excludable amount, would-be-includible); the adjustments to later years are not computed";
    when psohealth_distributions_from_plan_402l3B(officer, y, distributed)
        and psohealth_would_be_includible_if_all_distributed_402l3B(officer, y, would)
        and public_safety_officer_premium_exclusion(officer, y, excludable);
    then psohealth_amount_treated_as_includible_distribution_402l3B(officer, y, min(min(distributed, excludable), would));
}

pub relation plan_is_governmental_and_402c8B_iii_to_vi_402l4A(plan: Plan) kind empirical {
    label en unofficial "the plan is a governmental plan (section 414(d)) described in clause (iii), (iv), (v) or (vi) of subsection (c)(8)(B), case-asserted";
}

pub relation eligible_retirement_plan_for_402l_402l4A(plan: Plan) kind institutional {
    label en official "section 402(l)(4)(A): a governmental plan described in clause (iii), (iv), (v) or (vi) of (c)(8)(B)";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "the term \"eligible retirement plan\" means a governmental plan (within the meaning of section 414(d))")
rule EligibleRetirementPlanFor402l402l4A(plan: Plan) strict {
    label en official "governmental plan of the listed kinds";
    when plan_is_governmental_and_402c8B_iii_to_vi_402l4A(plan);
    then eligible_retirement_plan_for_402l_402l4A(plan);
}

pub relation separated_by_disability_or_normal_retirement_age_402l4B(officer: Person) kind empirical {
    label en unofficial "the individual is separated from service as a public safety officer by reason of disability or attainment of normal retirement age, case-asserted";
}

pub relation separated_from_the_employer_maintaining_the_plan_402l4B(officer: Person, plan: Plan) kind empirical {
    label en unofficial "the separation was from service with the employer who maintains the eligible retirement plan making the distributions, case-asserted";
}

pub relation eligible_retired_public_safety_officer_402l4B(officer: Person, plan: Plan) kind institutional {
    label en official "section 402(l)(4)(B): an individual separated from service as a public safety officer, by disability or normal retirement age, with the employer who maintains the plan";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "The term \"eligible retired public safety officer\" means an individual who, by reason of disability or attainment of normal retirement age, is separated from service as a public safety officer")
rule EligibleRetiredPublicSafetyOfficer402l4B(officer: Person, plan: Plan) strict {
    label en official "both conditions";
    when separated_by_disability_or_normal_retirement_age_402l4B(officer)
        and separated_from_the_employer_maintaining_the_plan_402l4B(officer, plan);
    then eligible_retired_public_safety_officer_402l4B(officer, plan);
}

pub enum PremiumCoveredPerson402l4D {
    Officer;
    Spouse;
    Dependent152;
    OtherPerson;
}

pub relation premium_paid_for_coverage_of_402l4D(officer: Person, y: TaxableYear, who: PremiumCoveredPerson402l4D, amount: Money) kind empirical {
    label en unofficial "premiums paid by the officer for coverage of this person by an accident or health plan or a qualified long-term care insurance contract, case-asserted";
}

pub relation qualified_health_insurance_premiums_402l4D(officer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(l)(4)(D): premiums for coverage of the officer, spouse and dependents";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "premiums for coverage for the eligible retired public safety officer, his spouse, and dependents (as defined in section 152)")
rule QualifiedHealthInsurancePremiums402l4D(officer: Person, y: TaxableYear) strict {
    label en official "sum over the officer, spouse and dependents; other persons are excluded";
    when premium_paid_for_coverage_of_402l4D(officer, y, _, _);
    then qualified_health_insurance_premiums_402l4D(officer, y,
        sum all amt: Money for w: PremiumCoveredPerson402l4D
            where premium_paid_for_coverage_of_402l4D(officer, y, w, amt) and w != OtherPerson);
}

pub relation payment_directly_to_insurer_or_to_employee_402l5A(officer: Person, y: TaxableYear, to_insurer: Boolean) kind empirical {
    label en unofficial "the premiums are paid directly to the provider by deduction from the distribution (true) or to the employee (false), case-asserted";
}

pub relation attestation_included_with_return_402l5Aii(officer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employee included with the return an attestation that the distribution does not exceed the premiums paid, case-asserted";
}

pub relation exclusion_form_of_payment_permitted_402l5A(officer: Person, y: TaxableYear) kind institutional {
    label en official "section 402(l)(5)(A): paragraph (1) applies whether the premiums are paid directly to the provider or to the employee; a payment to the employee requires the attestation";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply to a distribution without regard to whether payment of the premiums is made directly to the provider")
rule ExclusionFormOfPaymentPermittedDirect402l5A(officer: Person, y: TaxableYear) strict {
    label en official "direct payment to the insurer";
    when payment_directly_to_insurer_or_to_employee_402l5A(officer, y, true);
    then exclusion_form_of_payment_permitted_402l5A(officer, y);
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "the employee shall include with the return of tax for the taxable year in which the distribution is made an attestation")
rule ExclusionFormOfPaymentPermittedToEmployee402l5A(officer: Person, y: TaxableYear) strict {
    label en official "payment to the employee with the attestation";
    when payment_directly_to_insurer_or_to_employee_402l5A(officer, y, false)
        and attestation_included_with_return_402l5Aii(officer, y);
    then exclusion_form_of_payment_permitted_402l5A(officer, y);
}

pub relation all_eligible_retirement_plans_of_employer_single_plan_402l5B(employer: Person) kind institutional {
    label en official "section 402(l)(5)(B): all eligible retirement plans of an employer are treated as a single plan (the case aggregates the amounts of the officer)";
}

pub relation election_after_separation_402l6A(officer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the officer elects after separation from service, with respect to amounts not yet distributed from an eligible retirement plan, to have amounts distributed to pay qualified health insurance premiums, case-asserted";
}

pub relation election_described_in_402l6(officer: Person, y: TaxableYear) kind institutional {
    label en official "section 402(l)(6)(A): the election is made after separation from service with respect to amounts not distributed";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "an election is described in this paragraph if the election is made by an employee after separation from service")
rule ElectionDescribedIn402l6(officer: Person, y: TaxableYear) strict {
    label en official "post-separation election";
    when election_after_separation_402l6A(officer, y);
    then election_described_in_402l6(officer, y);
}

pub relation excluded_amount_taken_into_account_for_162l_402l8(officer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount excluded under paragraph (1) that is also asked to be taken into account under section 162(l), case-asserted";
}

pub relation excluded_amount_not_taken_into_account_for_162l_402l8(officer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(l)(8): the amounts excluded under paragraph (1) are not taken into account under section 162(l)";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "shall not be taken into account under section 162(l)")
rule ExcludedAmountNotTakenIntoAccountFor162l402l8(officer: Person, y: TaxableYear, amount: Money) strict {
    label en official "no double benefit";
    when excluded_amount_taken_into_account_for_162l_402l8(officer, y, amount);
    then excluded_amount_not_taken_into_account_for_162l_402l8(officer, y, amount);
}
