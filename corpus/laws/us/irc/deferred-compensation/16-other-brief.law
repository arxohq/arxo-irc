// Sections 412, 419, 419A, 420, 430, 436 — BRIEF contracts. Stage 1
// (IRC-09), DECISION-0379. These sections are in the assignment's stage-1
// scope but not in the "model fully" priority list; each is reduced to the
// smallest executable contract that lets a plan-qualification rule
// elsewhere in this package (401(a)(16)/(29), 404(a)(1)) reference its
// result, with the underlying actuarial computation recorded as an
// EXTERNAL_DEPENDENCY rather than reformalized. Full formalization of
// 430's funding-target/target-normal-cost/shortfall-amortization machinery
// and of 419/419A's welfare-benefit-fund account limits is stage 2.


use self::{
    DefinedBenefitPlan,
    IRC_S412_A,
    IRC_S419A_A,
    IRC_S419_A,
    IRC_S420_A,
    IRC_S430_A,
    IRC_S436_B,
    IRC_S436_C,
    Person,
    Plan,
    TaxableYear,
    participates_in,
};

// =====================================================================
// 412 — minimum funding standard (reference to 430)
// =====================================================================
pub relation minimum_required_contribution_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the minimum required contribution determined under section 430 for the plan year (EXTERNAL_DEPENDENCY: section 430's funding-target/target-normal-cost/shortfall-amortization computation, and the underlying actuarial assumptions and segment rates, are not reformalized in this package), case-asserted";
}

pub relation contributions_made_for_plan_year(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "aggregate employer contributions actually made to or under the plan for the plan year, case-asserted";
}

pub relation meets_412a_minimum_funding_standard(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 412(a)(2)(A): a single-employer, non-CSEC defined benefit plan meets the minimum funding standard when contributions are at least the section 430 minimum required contribution";
}

@source(IRC_S412_A, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan which is not a multiemployer plan or a CSEC plan, the employer makes contributions to or under the plan for the plan year which, in the aggregate, are not less than the minimum required contribution determined under section 430 for the plan for the plan year")
rule Meets412aMinimumFundingStandard(plan: DefinedBenefitPlan, y: TaxableYear, made: Money, required: Money) strict {
    label en official "satisfied when contributions made are at least the section 430 minimum required contribution";
    when contributions_made_for_plan_year(plan, y, made)
        and minimum_required_contribution_430(plan, y, required)
        and made >= required;
    then meets_412a_minimum_funding_standard(plan, y);
}

// =====================================================================
// 419 — welfare benefit funds (brief deduction contract)
// =====================================================================
pub relation welfare_benefit_fund_contribution(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions paid or accrued by an employer to a welfare benefit fund, case-asserted";
}

pub relation qualified_cost_limitation_419b(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 419(b) qualified-cost limitation for the year, case-asserted (the (c) qualified-cost computation and (e) fund-account rules are not reformalized here — TECH_GAP)";
}

pub relation welfare_benefit_fund_deductible_amount(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 419(a): contributions to a welfare benefit fund are deductible under this section (subject to the section 419(b) limitation) for the year paid";
}

@source(IRC_S419_A, relation = formalizes, coverage = exact, quote = "if they would otherwise be deductible, shall (subject to the limitation of subsection (b)) be deductible under this section for the taxable year in which paid")
rule WelfareBenefitFundDeductibleAmount(employer: Person, y: TaxableYear, contributed: Money, limit: Money) strict {
    label en official "deductible = min(contributed, section 419(b) qualified cost limitation)";
    when welfare_benefit_fund_contribution(employer, y, contributed)
        and qualified_cost_limitation_419b(employer, y, limit);
    then welfare_benefit_fund_deductible_amount(employer, y, min(contributed, limit));
}

// =====================================================================
// 419A — qualified asset account — brief classification
// =====================================================================
pub enum QualifiedAssetAccountPurpose {
    DisabilityBenefits;
    MedicalBenefits;
    SubOrSeverancePayBenefits;
    LifeInsuranceBenefits;
}

pub relation account_set_aside_for(fund: Person, purpose: QualifiedAssetAccountPurpose, y: TaxableYear) kind empirical {
    label en unofficial "assets are set aside in this welfare benefit fund's account to provide for the named benefit, case-asserted";
}

pub relation is_qualified_asset_account(fund: Person, y: TaxableYear) kind institutional {
    label en official "section 419A(a): the account is a qualified asset account when it is set aside to provide disability, medical, SUB/severance-pay, or life insurance benefits";
}

@source(IRC_S419A_A, relation = formalizes, coverage = exact, quote = "the term \"qualified asset account\" means any account consisting of assets set aside to provide for the payment of—")
rule IsQualifiedAssetAccount(fund: Person, purpose: QualifiedAssetAccountPurpose, y: TaxableYear) strict {
    label en official "any one of the four listed purposes qualifies the account";
    when account_set_aside_for(fund, purpose, y);
    then is_qualified_asset_account(fund, y);
}

// =====================================================================
// 420 — brief classification (qualified transfer does not disqualify the
// trust)
// =====================================================================
pub relation qualified_transfer_of_excess_pension_assets(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a qualified transfer of excess pension assets to a health benefits account or applicable life insurance account under section 420, case-asserted (the (e) excess-assets computation and (b) transfer conditions are not reformalized here — TECH_GAP)";
}

pub relation transfer_does_not_disqualify_trust(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 420(a)(1): a trust is not treated as failing section 401(a)/(h) solely because of a qualified transfer";
}

@source(IRC_S420_A, relation = formalizes, coverage = exact, quote = "a trust which is part of such plan shall not be treated as failing to meet the requirements of subsection (a) or (h) of section 401 solely by reason of such transfer (or any other action authorized under this section)")
rule TransferDoesNotDisqualifyTrust(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "a qualified transfer does not disqualify the section 401(a) trust";
    when qualified_transfer_of_excess_pension_assets(plan, y, amount);
    then transfer_does_not_disqualify_trust(plan, y);
}

// =====================================================================
// 430 — minimum required contribution: BRIEF contract (EXTERNAL_DEPENDENCY)
// =====================================================================
pub relation funding_target(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the plan's funding target for the plan year (section 430(d)(1)), case-asserted — EXTERNAL_DEPENDENCY (actuarial present value computed with prescribed mortality tables and segment interest rates, not reformalized here)";
}

pub relation value_of_plan_assets_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of plan assets as reduced under section 430(f)(4)(B), case-asserted";
}

pub relation target_normal_cost(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the target normal cost of the plan for the plan year (section 430(b)), case-asserted — EXTERNAL_DEPENDENCY";
}

pub relation shortfall_amortization_charge(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shortfall amortization charge, if any, for the plan year (section 430(c)), case-asserted — EXTERNAL_DEPENDENCY; 0 when none";
}

pub relation waiver_amortization_charge(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the waiver amortization charge, if any, for the plan year (section 430(e)), case-asserted — EXTERNAL_DEPENDENCY; 0 when none";
}

@source(IRC_S430_A, relation = formalizes, coverage = exact, quote = "in any case in which the value of plan assets of the plan (as reduced under subsection (f)(4)(B)) is less than the funding target of the plan for the plan year, the sum of—")
rule MinimumRequiredContribution430Underfunded(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money, tnc: Money, shortfall: Money, waiver: Money) strict {
    label en official "underfunded case: minimum required contribution = target normal cost + shortfall amortization charge + waiver amortization charge";
    when value_of_plan_assets_430(plan, y, assets)
        and funding_target(plan, y, target)
        and assets < target
        and target_normal_cost(plan, y, tnc)
        and shortfall_amortization_charge(plan, y, shortfall)
        and waiver_amortization_charge(plan, y, waiver);
    then minimum_required_contribution_430(plan, y, tnc + shortfall + waiver);
}

@source(IRC_S430_A, relation = formalizes, coverage = exact, quote = "equals or exceeds the funding target of the plan for the plan year, the target normal cost of the plan for the plan year reduced (but not below zero) by such excess")
rule MinimumRequiredContribution430Overfunded(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money, tnc: Money) strict {
    label en official "overfunded case: minimum required contribution = max(0, target normal cost - excess of assets over funding target)";
    when value_of_plan_assets_430(plan, y, assets)
        and funding_target(plan, y, target)
        and assets >= target
        and target_normal_cost(plan, y, tnc);
    then minimum_required_contribution_430(plan, y, max(0 USD, tnc - (assets - target)));
}

// =====================================================================
// 436 — benefit restrictions by AFTAP thresholds (60%/80%)
// =====================================================================
pub relation adjusted_funding_target_attainment_percentage(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the adjusted funding target attainment percentage (AFTAP) for the plan year, case-asserted — EXTERNAL_DEPENDENCY (computed from section 430 funding-target/asset values plus annuity-purchase and unpredictable-contingent-event adjustments not reformalized here)";
}

pub relation unpredictable_contingent_event_benefit_restricted(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 436(b)(1): an unpredictable contingent event benefit may not be provided when the AFTAP is (or would be) below 60 percent";
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "the plan shall provide that such benefit may not be provided if the adjusted funding target attainment percentage for such plan year—")
rule UnpredictableContingentEventBenefitRestricted(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, aftap: Decimal) defeasible {
    label en official "restricted when AFTAP is strictly below 60 percent (exact boundary: exactly 60% is not restricted)";
    when participates_in(participant, plan) and adjusted_funding_target_attainment_percentage(plan, y, aftap) and aftap < 0.60;
    then unpredictable_contingent_event_benefit_restricted(plan, participant, y);
}

pub relation plan_amendment_increasing_liability_restricted(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(c): a plan amendment increasing liability for benefits may not take effect when the AFTAP is below the applicable percentage (80 percent, per the pinned (c)(1) text) — the amendment's own conditions (c)(2)-(4) are NOT modelled here (brief)";
}

@source(IRC_S436_C, relation = formalizes, coverage = contextual, quote = "Limitations on plan amendments increasing liability for benefits")
rule PlanAmendmentIncreasingLiabilityRestricted(plan: DefinedBenefitPlan, y: TaxableYear, aftap: Decimal) defeasible {
    label en official "brief: below-80%-AFTAP amendments are restricted (statutory base threshold; the full (c)(2)-(4) exceptions are stage 2)";
    when adjusted_funding_target_attainment_percentage(plan, y, aftap) and aftap < 0.80;
    then plan_amendment_increasing_liability_restricted(plan, y);
}
