// Section 420 — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): transfers of excess pension assets, the parts module 48 left
// as TECH_GAP: (c)(1) use of transferred assets, unused amounts and ordering,
// (c)(3) applicable employer cost by benefit kind, the separate-computation
// election and insignificant cost reductions, (e)(1) qualified current retiree
// liabilities, applicable benefits and key employees, (e)(4) life insurance
// accounts, (e)(6) multiemployer plans, (f) qualified future transfers and
// collectively bargained transfers (election, 120 percent test, funded status
// maintenance, amount limits, minimum cost, conditions, use of assets,
// deduction rules, definitions, ending the transfer period with the pinned
// table of applicable percentages) and (g).
//
// Method. Hypothetical deductions, present values and cost figures are case
// inputs (they are not derivable from the text); what the text fixes is
// computed exactly: percentages of gross receipts and of the funding target
// (0.05, 1.20, 1.00, the table 104/108/112/116/120), ratios by
// `div_round(a * (b / 1.00 USD), c / 1.00 USD, 2, "HALF_UP")`, and dates.
// The table of (f)(7)(E)(ii) is read from the model of section 420
// (model/sections/420.json, T1): the fragment text carries only the
// placeholder [table T1]. Evaluative wording and Secretary guidance are case
// facts or EXTERNAL_DEPENDENCY rows.

use self::{
    IRC_S420_C,
    IRC_S420_E,
    IRC_S420_F,
    IRC_S420_G,
    Person,
    Plan,
    TaxableYear,
    applicable_employer_cost_420c3,
    excess_assets_lesser_amount_420e2A,
    funding_target_and_normal_cost_420e2B,
    plan_employer_420,
    qualified_transfer_420b,
    reduced_threshold_applies_420e7,
    transfer_on_420b4,
};

pub enum RetireeBenefitKind420 {
    HealthBenefits;
    LifeInsuranceBenefits;
}

pub relation multiemployer_plan_420(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted (section 420(e)(6), (f)(1))";
}

// =====================================================================
// (c)(1) Use of transferred assets
// =====================================================================

pub relation uses_transferred_assets_other_than_qcrl_420c1A(employer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer uses assets transferred in a qualified transfer (or income allocable to them) for a purpose other than paying qualified current retiree liabilities of the transfer year (and, for a future or collectively bargained transfer, the liabilities of (f)(2)(C) or (f)(2)(E)(ii)), case-asserted (action atom)";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "shall be used only to pay qualified current retiree liabilities")
rule TransferredAssetsUseProhibition420c1A(employer: Person, plan: Plan, y: TaxableYear) strict {
    label en official "the assets of a qualified transfer may be used only for qualified current retiree liabilities (other than those of key employees) of the transfer year";
    when qualified_transfer_420b(plan, y) and plan_employer_420(plan, employer);
    then prohibition UseTransferredAssetsOnlyForQcrlProhibition {
        bearer employer;
        action uses_transferred_assets_other_than_qcrl_420c1A(employer, plan, y);
        window [-infinity, infinity];
    };
}

pub relation unused_transferred_assets_returned_to_plan_420c1B(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the transferred assets (and income) not used for qualified current retiree liabilities have been transferred out of the account to the transferor plan, case-asserted (goal atom)";
}

@source(IRC_S420_C, relation = formalizes, coverage = partial, quote = "which are not used as provided in subparagraph (A) shall be transferred out of the account to the transferor plan")
rule ReturnUnusedTransferredAssetsDuty420c1B(plan: Plan, y: TaxableYear, employer: Person, on: Date) strict {
    label en official "PARTIAL: the statute sets no date for the retransfer; the duty runs from the date of the qualified transfer";
    when qualified_transfer_420b(plan, y)
        and plan_employer_420(plan, employer)
        and transfer_on_420b4(plan, y, on);
    then duty ReturnUnusedTransferredAssetsDuty {
        bearer employer;
        goal achievement {
            condition unused_transferred_assets_returned_to_plan_420c1B(plan, y);
            window [on, infinity];
        }
    };
}

pub relation amount_transferred_out_under_420c1B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount transferred out of an account to the plan under clause (i), case-asserted";
}

pub relation retransfer_not_gross_income_420c1Bii(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(c)(1)(B)(ii)(I): the amount transferred out of the account is not includible in the employer's gross income for the taxable year";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "shall not be includible in the gross income of the employer for such taxable year")
rule RetransferNotGrossIncome420c1Bii1(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "no inclusion";
    when amount_transferred_out_under_420c1B(plan, y, amount);
    then retransfer_not_gross_income_420c1Bii(plan, y, amount);
}

pub relation retransfer_treated_as_reversion_4980_420c1Bii(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(c)(1)(B)(ii)(II): the amount is treated as an employer reversion for section 4980, without regard to subsection (d) thereof";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "shall be treated as an employer reversion for purposes of section 4980 (without regard to subsection (d) thereof)")
rule RetransferTreatedAsReversion420c1Bii2(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "reversion for section 4980 (the section 4980 excise tax is owned by excise-entities)";
    when amount_transferred_out_under_420c1B(plan, y, amount);
    then retransfer_treated_as_reversion_4980_420c1Bii(plan, y, amount);
}

pub relation payment_out_of_account_420c1C(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount paid out of the health benefits account or applicable life insurance account, case-asserted";
}

pub relation transferred_assets_and_income_available_420c1C(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the assets and income described in subparagraph (A) available in the account, case-asserted";
}

pub relation paid_first_from_transferred_assets_420c1C(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(c)(1)(C): a payment out of the account is treated as paid first out of the assets and income of subparagraph (A)";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "any amount paid out of a health benefits account, or an applicable life insurance account, shall be treated as paid first out of the assets and income described in subparagraph (A)")
rule PaidFirstFromTransferredAssets420c1C(plan: Plan, y: TaxableYear, paid: Money, available: Money) strict {
    label en official "the amount treated as paid from transferred assets is the lesser of the payment and the available transferred assets";
    when payment_out_of_account_420c1C(plan, y, paid) and transferred_assets_and_income_available_420c1C(plan, y, available);
    then paid_first_from_transferred_assets_420c1C(plan, y, min(paid, available));
}

// =====================================================================
// (c)(3) Applicable employer cost by benefit kind; election; eligible employer
// =====================================================================

pub relation qcrl_before_reduction_420c3Bi(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the qualified current retiree liabilities for the taxable year determined separately for this kind of benefit and without regard to any reduction under subsection (e)(1)(B), case-asserted (a taxable year with no qualified transfer is determined as if there had been one at year end, clause (i)(III))";
}

pub relation covered_individuals_420c3Bii(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, individuals: Decimal) kind empirical {
    label en unofficial "the number of individuals to whom coverage was provided during the taxable year for this kind of benefit, case-asserted";
}

pub relation applicable_employer_cost_by_kind_420c3B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, cost: Money) kind institutional {
    label en official "section 420(c)(3)(B): the qualified current retiree liabilities for the year, for the kind of benefit, divided by the number of individuals covered";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "the term \"applicable employer cost\" means, with respect to any taxable year, the amount determined by dividing")
rule ApplicableEmployerCostByKind420c3B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, liabilities: Money, n: Decimal) strict {
    label en official "cents, HALF_UP (JUDGMENT CALL: the statute names no rounding of a Money result)";
    when qcrl_before_reduction_420c3Bi(plan, y, kind, liabilities)
        and covered_individuals_420c3Bii(plan, y, kind, n)
        and n > 0.0;
    then applicable_employer_cost_by_kind_420c3B(plan, y, kind, div_round(liabilities, n, 2, "HALF_UP"));
}

pub relation employer_elects_separate_cost_computation_420c3C(plan: Plan, employer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects to apply paragraph (3) separately for health benefits (medicare-eligible and other individuals) and for life insurance benefits (age 65 or older and younger individuals), case-asserted (exercise atom)";
}

pub relation separate_cost_computation_in_effect_420c3C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(c)(3)(C): the minimum cost paragraph is applied separately by eligibility class";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "An employer may elect to have this paragraph applied separately for applicable health benefits")
rule SeparateCostComputationPower420c3C(plan: Plan, employer: Person, y: TaxableYear) strict {
    label en official "a power of the employer, over the plan's benefit classes, valid for the employer maintaining the plan";
    when plan_employer_420(plan, employer)
        and employer_elects_separate_cost_computation_420c3C(plan, employer, y);
    then power ElectSeparateCostComputationPower {
        holder employer;
        over employer;
        exercise employer_elects_separate_cost_computation_420c3C(plan, employer, y);
        valid_when employer_maintains_qualified_transfer_plan_420(plan, y);
        effect separate_cost_computation_in_effect_420c3C(plan, y);
    };
}

pub relation employer_maintains_qualified_transfer_plan_420(plan: Plan, y: TaxableYear) kind institutional {
    label en official "helper: the plan made a qualified transfer for the year";
}

rule EmployerMaintainsQualifiedTransferPlan420(plan: Plan, y: TaxableYear) strict {
    label en official "helper for the power's single valid_when atom";
    when qualified_transfer_420b(plan, y);
    then employer_maintains_qualified_transfer_plan_420(plan, y);
}

pub relation qcrl_health_prior_year_420c3Eii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified current retiree liabilities with respect to applicable health benefits for the preceding taxable year, case-asserted";
}

pub relation gross_receipts_prior_year_420c3Eii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer's gross receipts for the preceding taxable year determined under section 448(c)(2), (3)(B), (3)(C), case-asserted";
}

pub relation eligible_employer_420c3Eii2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(c)(3)(E)(ii)(II): the qualified current retiree liabilities for applicable health benefits in the preceding year were at least 5 percent of gross receipts";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "the qualified current retiree liabilities of the employer with respect to applicable health benefits were at least 5 percent of the gross receipts of the employer")
rule EligibleEmployer420c3Eii2(plan: Plan, y: TaxableYear, qcrl: Money, receipts: Money) strict {
    label en official "exact boundary: exactly 5 percent qualifies (0.05)";
    when qcrl_health_prior_year_420c3Eii(plan, y, qcrl)
        and gross_receipts_prior_year_420c3Eii(plan, y, receipts)
        and qcrl >= receipts * 0.05;
    then eligible_employer_420c3Eii2(plan, y);
}

pub relation applicable_employer_cost_reduction_420c3Eii1(plan: Plan, y: TaxableYear, reduction: Money) kind empirical {
    label en unofficial "the reduction of applicable employer cost the employer makes in lieu of a reduction of retiree health coverage, case-asserted";
}

pub relation maximum_reduction_under_regulations_420c3Eii1(plan: Plan, y: TaxableYear, maximum: Money) kind empirical {
    label en unofficial "the reduction in costs that would have occurred had the employer made the maximum permissible reduction in retiree health coverage under the regulations, case-asserted (the regulations are not pinned)";
}

pub relation insignificant_cost_reduction_permitted_420c3Eii1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(c)(3)(E)(ii)(I): an eligible employer is not treated as failing the minimum cost requirement if it reduces applicable employer cost by no more than the maximum permissible coverage reduction would have achieved";
}

@source(IRC_S420_C, relation = formalizes, coverage = exact, quote = "reduces applicable employer cost by an amount not in excess of the reduction in costs which would have occurred if the employer had made the maximum permissible reduction in retiree health coverage")
rule InsignificantCostReductionPermitted420c3Eii1(plan: Plan, y: TaxableYear, reduction: Money, maximum: Money) strict {
    label en official "exact boundary: a reduction equal to the maximum permissible reduction is allowed; only an eligible employer";
    when eligible_employer_420c3Eii2(plan, y)
        and applicable_employer_cost_reduction_420c3Eii1(plan, y, reduction)
        and maximum_reduction_under_regulations_420c3Eii1(plan, y, maximum)
        and reduction <= maximum;
    then insignificant_cost_reduction_permitted_420c3Eii1(plan, y);
}

// =====================================================================
// (e)(1) Qualified current retiree liabilities and applicable benefits
// =====================================================================

pub relation hypothetical_deduction_amount_420e1A(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the aggregate amounts (including administrative expenses) that would have been allowable as a deduction for the year for the benefits provided during the year if provided directly by the employer using the cash method (with the section 419(c)(3)(B) rule), case-asserted (a hypothetical computation of another section)";
}

pub relation key_employee_amount_included_420e1E(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the part of the hypothetical deduction attributable to key employees (section 416(i)(1)) with respect to any plan year ending in the taxable year, case-asserted";
}

pub relation qcrl_after_key_employees_420e1(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind institutional {
    label en official "section 420(e)(1)(A), (E): the hypothetical deduction for the benefits, excluding key employees";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "such employee shall not be taken into account in computing qualified current retiree liabilities for such taxable year")
rule QcrlAfterKeyEmployees420e1(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, hypo: Money, key: Money) strict {
    label en official "hypothetical deduction less the key employees' part";
    when hypothetical_deduction_amount_420e1A(plan, y, kind, hypo) and key_employee_amount_included_420e1E(plan, y, kind, key);
    then qcrl_after_key_employees_420e1(plan, y, kind, hypo - key);
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "such employee shall not be taken into account in computing qualified current retiree liabilities for such taxable year")
rule QcrlNoKeyEmployees420e1(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, hypo: Money) strict {
    label en official "no key employee amount on record: the whole hypothetical deduction";
    when hypothetical_deduction_amount_420e1A(plan, y, kind, hypo) and not_known(key_employee_amount_recorded_420e1E(plan, y, kind));
    then qcrl_after_key_employees_420e1(plan, y, kind, hypo);
}

pub relation key_employee_amount_recorded_420e1E(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420) kind institutional {
    label en official "helper: a key employee amount is on record";
}

rule KeyEmployeeAmountRecorded420e1E(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, key: Money) strict {
    label en official "helper for the not_known guard";
    when key_employee_amount_included_420e1E(plan, y, kind, key);
    then key_employee_amount_recorded_420e1E(plan, y, kind);
}

pub relation set_aside_assets_value_420e1B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the value, as of the close of the plan year preceding the year of the qualified transfer, of the assets in all health benefits accounts, applicable life insurance accounts or welfare benefit funds set aside to pay for the qualified current retiree liability, case-asserted (clause (i))";
}

pub relation present_value_qcrl_all_years_420e1B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the present value of the qualified current retiree liabilities for all plan years determined without regard to the reduction, case-asserted (clause (ii))";
}

pub relation qcrl_reduction_420e1B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, reduction: Money) kind institutional {
    label en official "section 420(e)(1)(B): the reduction is the amount that bears to the qualified current retiree liabilities the same ratio as the set-aside assets bear to the present value of all-year liabilities";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "which bears the same ratio to such amount as")
rule QcrlReduction420e1B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, qcrl: Money, assets: Money, pv: Money) strict {
    label en official "one rounding (cents, HALF_UP) on the ratio; JUDGMENT CALL: the statute names no rounding";
    when qcrl_after_key_employees_420e1(plan, y, kind, qcrl)
        and set_aside_assets_value_420e1B(plan, y, kind, assets)
        and present_value_qcrl_all_years_420e1B(plan, y, kind, pv)
        and pv > 0.00 USD;
    then qcrl_reduction_420e1B(plan, y, kind, div_round(qcrl * (assets / 1.00 USD), pv / 1.00 USD, 2, "HALF_UP"));
}

pub relation qcrl_net_of_reduction_420e1(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind institutional {
    label en official "section 420(e)(1): the qualified current retiree liabilities reduced for amounts previously set aside";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "The amount determined under subparagraph (A) shall be reduced by the amount")
rule QcrlNetOfReduction420e1(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, qcrl: Money, reduction: Money) strict {
    label en official "qualified current retiree liabilities less the reduction";
    when qcrl_after_key_employees_420e1(plan, y, kind, qcrl) and qcrl_reduction_420e1B(plan, y, kind, reduction);
    then qcrl_net_of_reduction_420e1(plan, y, kind, qcrl - reduction);
}

pub relation retiree_entitled_to_benefits_by_retirement_before_transfer_420e1C(person: Person, plan: Plan) kind empirical {
    label en unofficial "the retired employee, immediately before the qualified transfer, is entitled to receive the health benefits or coverage by reason of retirement, case-asserted";
}

pub relation retiree_entitled_to_pension_benefits_under_plan_420e1C(person: Person, plan: Plan) kind empirical {
    label en unofficial "the retired employee is entitled to pension benefits under the plan, case-asserted";
}

pub relation spouse_or_dependent_of_retiree_420e1C(person: Person, retiree: Person) kind empirical {
    label en unofficial "the person is a spouse or dependent of the retired employee, case-asserted";
}

pub relation applicable_health_retiree_420e1C(person: Person, plan: Plan) kind institutional {
    label en official "helper: a retired employee entitled by retirement and to pension benefits (clause (i))";
}

pub relation applicable_health_benefit_recipient_420e1C(person: Person, plan: Plan) kind institutional {
    label en official "section 420(e)(1)(C): a retired employee entitled to the benefits by reason of retirement and to pension benefits under the plan, or a spouse or dependent of one";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "retired employees who, immediately before the qualified transfer, are entitled to receive such benefits by reason of retirement and who are entitled to pension benefits under the plan")
rule ApplicableHealthRetiree420e1Ci(person: Person, plan: Plan) strict {
    label en official "clause (i)";
    when retiree_entitled_to_benefits_by_retirement_before_transfer_420e1C(person, plan)
        and retiree_entitled_to_pension_benefits_under_plan_420e1C(person, plan);
    then applicable_health_retiree_420e1C(person, plan);
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "retired employees who, immediately before the qualified transfer, are entitled to receive such benefits by reason of retirement and who are entitled to pension benefits under the plan")
rule ApplicableHealthRecipientRetiree420e1Ci(person: Person, plan: Plan) strict {
    label en official "a qualifying retiree is a recipient";
    when applicable_health_retiree_420e1C(person, plan);
    then applicable_health_benefit_recipient_420e1C(person, plan);
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "their spouses and dependents")
rule ApplicableHealthRecipientSpouse420e1Cii(person: Person, retiree: Person, plan: Plan) strict {
    label en official "clause (ii)";
    when spouse_or_dependent_of_retiree_420e1C(person, retiree) and applicable_health_retiree_420e1C(retiree, plan);
    then applicable_health_benefit_recipient_420e1C(person, plan);
}

pub relation group_term_life_coverage_under_retiree_policy_420e1D(person: Person, plan: Plan) kind empirical {
    label en unofficial "group-term life insurance coverage provided to the retired employee under a policy for retired employees, case-asserted";
}

pub relation coverage_cost_excludable_under_section_79_420e1D(person: Person, plan: Plan) kind empirical {
    label en unofficial "the cost of the coverage is excludable from the retired employee's gross income under section 79, case-asserted";
}

pub relation applicable_life_insurance_recipient_420e1D(person: Person, plan: Plan) kind institutional {
    label en official "section 420(e)(1)(D): a retired employee entitled to group-term life coverage by reason of retirement and to pension benefits, to the extent provided under a policy for retired employees with a section 79 excludable cost";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "but only to the extent that such coverage is provided under a policy for retired employees and the cost of such coverage is excludable from the retired employee's gross income under section 79")
rule ApplicableLifeInsuranceRecipient420e1D(person: Person, plan: Plan) strict {
    label en official "entitlement by retirement, pension entitlement, retiree policy and section 79 exclusion together";
    when retiree_entitled_to_benefits_by_retirement_before_transfer_420e1C(person, plan)
        and retiree_entitled_to_pension_benefits_under_plan_420e1C(person, plan)
        and group_term_life_coverage_under_retiree_policy_420e1D(person, plan)
        and coverage_cost_excludable_under_section_79_420e1D(person, plan);
    then applicable_life_insurance_recipient_420e1D(person, plan);
}

pub relation separate_account_for_life_insurance_premiums_420e4(plan: Plan) kind empirical {
    label en unofficial "a separate account is established and maintained for amounts transferred for qualified current retiree liabilities based on premiums for applicable life insurance benefits, case-asserted";
}

pub relation applicable_life_insurance_account_420e4(plan: Plan) kind institutional {
    label en official "section 420(e)(4): a separate account for amounts transferred under this section for qualified current retiree liabilities based on premiums for applicable life insurance benefits";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "The term \"applicable life insurance account\" means a separate account established and maintained for amounts transferred under this section")
rule ApplicableLifeInsuranceAccount420e4(plan: Plan) strict {
    label en official "a separate account for life insurance premiums";
    when separate_account_for_life_insurance_premiums_420e4(plan);
    then applicable_life_insurance_account_420e4(plan);
}

pub relation employer_references_read_as_all_employers_420e6A(plan: Plan) kind institutional {
    label en official "section 420(e)(6)(A): for a multiemployer plan, a reference to an employer is a reference to all employers maintaining the plan (or, if appropriate, the plan sponsor)";
}

@source(IRC_S420_E, relation = formalizes, coverage = exact, quote = "by treating any reference in this section to an employer as a reference to all employers maintaining the plan (or, if appropriate, the plan sponsor)")
rule EmployerReferencesReadAsAllEmployers420e6A(plan: Plan) strict {
    label en official "multiemployer plans only";
    when multiemployer_plan_420(plan);
    then employer_references_read_as_all_employers_420e6A(plan);
}

// =====================================================================
// (f)(1)-(2)(A) Election of qualified future and collectively bargained transfers
// =====================================================================

pub enum FutureTransferKind420f {
    QualifiedFutureTransfer;
    CollectivelyBargainedTransfer;
}

pub relation employer_elects_future_transfer_420f1(plan: Plan, employer: Person, y: TaxableYear, kind: FutureTransferKind420f) kind empirical {
    label en unofficial "the employer maintaining a defined benefit plan elects, in lieu of a qualified transfer, a qualified future transfer or a collectively bargained transfer for the taxable year, case-asserted (exercise atom)";
}

pub relation plan_eligible_for_future_transfer_election_420f1(plan: Plan) kind institutional {
    label en official "section 420(f)(1): a defined benefit plan other than a multiemployer plan";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "An employer maintaining a defined benefit plan (other than a multiemployer plan) may")
rule PlanEligibleForFutureTransferElection420f1(plan: Plan) strict {
    label en official "a plan that is not known to be a multiemployer plan";
    when plan_employer_420(plan, _) and not_known(multiemployer_plan_420(plan));
    then plan_eligible_for_future_transfer_election_420f1(plan);
}

pub relation future_transfer_elected_420f1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "the election under section 420(f)(1) of a qualified future transfer or a collectively bargained transfer takes effect for the year";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "may, in lieu of a qualified transfer, elect for any taxable year to have the plan make")
rule FutureTransferElectionPower420f1(plan: Plan, employer: Person, y: TaxableYear, kind: FutureTransferKind420f) strict {
    label en official "a power of the employer valid only for a plan other than a multiemployer plan";
    when plan_employer_420(plan, employer) and employer_elects_future_transfer_420f1(plan, employer, y, kind);
    then power ElectFutureTransferPower {
        holder employer;
        over employer;
        exercise employer_elects_future_transfer_420f1(plan, employer, y, kind);
        valid_when plan_eligible_for_future_transfer_election_420f1(plan);
        effect future_transfer_elected_420f1(plan, y);
    };
}

pub relation future_transfer_requirements_met_420f2A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the transfer meets all the requirements for a qualified transfer except as modified by clauses (i)-(iv), case-asserted";
}

pub relation future_transfer_treated_as_qualified_420f1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(1) last sentence: except as provided in the subsection, a future or collectively bargained transfer is treated for this title and ERISA as if it were a qualified transfer";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "shall be treated for purposes of this title and the Employee Retirement Income Security Act of 1974 as if it were a qualified transfer")
rule FutureTransferTreatedAsQualified420f1(plan: Plan, y: TaxableYear) strict {
    label en official "an elected transfer meeting the modified requirements";
    when future_transfer_elected_420f1(plan, y) and future_transfer_requirements_met_420f2A(plan, y);
    then future_transfer_treated_as_qualified_420f1(plan, y);
}

// =====================================================================
// (f)(2)(B) Excess pension assets for future transfers; funded status
// =====================================================================

pub relation future_transfer_of_kind_420f(plan: Plan, y: TaxableYear, kind: FutureTransferKind420f) kind empirical {
    label en unofficial "the transfer for the year is of this kind, case-asserted";
}

pub relation excess_pension_assets_future_420f2Bi(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(f)(2)(B)(i)(I): excess pension assets computed with 120 percent substituted for 125 percent";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "subsection (e)(2)(B) shall be applied by substituting \"120 percent\" for \"125 percent\"")
rule ExcessPensionAssetsFuture420f2Bi(plan: Plan, y: TaxableYear, kind: FutureTransferKind420f, lesser: Money, base: Money) strict {
    label en official "max(lesser - 1.20 x base, 0) rounded to the cent";
    when future_transfer_of_kind_420f(plan, y, kind)
        and excess_assets_lesser_amount_420e2A(plan, y, lesser)
        and funding_target_and_normal_cost_420e2B(plan, y, base);
    then excess_pension_assets_future_420f2Bi(plan, y, max(lesser - round(base * 1.20, 2, "HALF_UP"), 0.00 USD));
}

pub relation de_minimis_threshold_inapplicable_to_collectively_bargained_420f2Bi2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(2)(B)(i)(II): for a collectively bargained transfer the section 420(e)(7) 110 percent rule does not apply";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "In determining excess pension assets for purposes of a collectively bargained transfer, subsection (e)(7) shall not apply")
rule DeMinimisInapplicableCollectivelyBargained420f2Bi2(plan: Plan, y: TaxableYear) strict {
    label en official "collectively bargained transfers only";
    when future_transfer_of_kind_420f(plan, y, CollectivelyBargainedTransfer);
    then de_minimis_threshold_inapplicable_to_collectively_bargained_420f2Bi2(plan, y);
}

pub relation valuation_date_asset_shortfall_420f2Bii(plan: Plan, valuation_date: Date, shortfall: Money) kind empirical {
    label en unofficial "as of a valuation date in the transfer period, the amount by which the (e)(2)(B) amount (after clause (i)) exceeds the (e)(2)(A) amount, case-asserted";
}

pub relation employer_contribution_to_reduce_shortfall_420f2Bii1(plan: Plan, valuation_date: Date, amount: Money) kind empirical {
    label en unofficial "the employer's contributions to the plan as of the valuation date, case-asserted (clause (ii)(I))";
}

pub relation transfer_back_to_reduce_shortfall_420f2Bii2(plan: Plan, valuation_date: Date, amount: Money) kind empirical {
    label en unofficial "the amount transferred from the health benefits or life insurance account to the plan as of the valuation date, case-asserted (clause (ii)(II))";
}

pub relation funded_status_maintained_420f2Bii(plan: Plan, valuation_date: Date) kind institutional {
    label en official "section 420(f)(2)(B)(ii): contributions (I) or transfers back (II) of at least the amount that reduces the excess to zero";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "the employer maintaining the plan shall make contributions to the plan in an amount not less than the amount required to reduce such excess to zero as of such date")
rule FundedStatusMaintainedByContribution420f2Bii1(plan: Plan, valuation_date: Date, shortfall: Money, contribution: Money) strict {
    label en official "exact boundary: a contribution equal to the shortfall is enough";
    when valuation_date_asset_shortfall_420f2Bii(plan, valuation_date, shortfall)
        and employer_contribution_to_reduce_shortfall_420f2Bii1(plan, valuation_date, contribution)
        and contribution >= shortfall;
    then funded_status_maintained_420f2Bii(plan, valuation_date);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "there is transferred from the health benefits account or applicable life insurance account, as the case may be, to the plan an amount not less than the amount required to reduce such excess to zero as of such date")
rule FundedStatusMaintainedByTransferBack420f2Bii2(plan: Plan, valuation_date: Date, shortfall: Money, back: Money) strict {
    label en official "exact boundary: a transfer back equal to the shortfall is enough";
    when valuation_date_asset_shortfall_420f2Bii(plan, valuation_date, shortfall)
        and transfer_back_to_reduce_shortfall_420f2Bii2(plan, valuation_date, back)
        and back >= shortfall;
    then funded_status_maintained_420f2Bii(plan, valuation_date);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "either")
rule MaintainFundedStatusDuty420f2Bii(plan: Plan, employer: Person, valuation_date: Date, shortfall: Money) strict {
    label en official "when a shortfall exists at a valuation date in the transfer period the employer must restore the funded status by contribution or transfer back";
    when valuation_date_asset_shortfall_420f2Bii(plan, valuation_date, shortfall)
        and shortfall > 0.00 USD
        and plan_employer_420(plan, employer);
    then duty MaintainFundedStatusDuty {
        bearer employer;
        goal achievement {
            condition funded_status_maintained_420f2Bii(plan, valuation_date);
            window [valuation_date, infinity];
        }
    };
}

// =====================================================================
// (f)(2)(C) Limitation on the amount transferred
// =====================================================================

pub relation transfer_amount_420f2C(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of excess pension assets transferred in the future or collectively bargained transfer, case-asserted";
}

pub relation current_year_limit_420b3_in_transfer_period_420f2Ci1(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount determined under subsection (b)(3) for the taxable year of the transfer, when the transfer period includes it, case-asserted (clause (i)(I))";
}

pub relation estimated_qcrl_other_transfer_period_year_420f2Ci2(plan: Plan, year: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the qualified current retiree liabilities the plan reasonably estimates, in accordance with Secretary guidance, will be incurred for another taxable year in the transfer period, case-asserted (clause (i)(II))";
}

pub relation qualified_future_transfer_limit_420f2Ci(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(f)(2)(C)(i): the (b)(3) amount for the transfer year plus the estimated liabilities for each other year of the transfer period";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "in the case of a qualified future transfer shall be equal to the sum of")
rule QualifiedFutureTransferLimit420f2Ci(plan: Plan, y: TaxableYear, current: Money) strict {
    label en official "exact sum over the other years of the transfer period (an aggregate over an empirical relation)";
    when current_year_limit_420b3_in_transfer_period_420f2Ci1(plan, y, current);
    then qualified_future_transfer_limit_420f2Ci(plan, y, current + sum all amt: Money for yr: TaxableYear where estimated_qcrl_other_transfer_period_year_420f2Ci2(plan, yr, amt));
}

pub relation collectively_bargained_estimated_payments_420f2Cii(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount reasonably estimated, in accordance with the collective bargaining agreement and generally accepted accounting principles, that the employer will pay out of the account during the collectively bargained cost maintenance period for collectively bargained retiree liabilities, case-asserted";
}

pub relation future_transfer_within_limit_420f2C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(2)(C): the transfer does not exceed the limit for its kind";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "shall not exceed the amount which is reasonably estimated, in accordance with the provisions of the collective bargaining agreement and generally accepted accounting principles")
rule CollectivelyBargainedTransferWithinLimit420f2Cii(plan: Plan, y: TaxableYear, amount: Money, estimate: Money) strict {
    label en official "exact boundary: a transfer equal to the estimate is within the limit";
    when future_transfer_of_kind_420f(plan, y, CollectivelyBargainedTransfer)
        and transfer_amount_420f2C(plan, y, amount)
        and collectively_bargained_estimated_payments_420f2Cii(plan, y, estimate)
        and amount <= estimate;
    then future_transfer_within_limit_420f2C(plan, y);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "in the case of a qualified future transfer shall be equal to the sum of")
rule QualifiedFutureTransferWithinLimit420f2Ci(plan: Plan, y: TaxableYear, amount: Money, limit: Money) strict {
    label en official "exact boundary: the transfer equals the limit (the statute says the amount transferred SHALL EQUAL the sum; JUDGMENT CALL: read as a ceiling, not a floor, as clause (ii) states \"shall not exceed\")";
    when future_transfer_of_kind_420f(plan, y, QualifiedFutureTransfer)
        and transfer_amount_420f2C(plan, y, amount)
        and qualified_future_transfer_limit_420f2Ci(plan, y, limit)
        and amount <= limit;
    then future_transfer_within_limit_420f2C(plan, y);
}

// =====================================================================
// (f)(2)(D) Minimum cost requirements for future transfers
// =====================================================================

pub relation average_applicable_employer_cost_over_future_period_420f2Di1(plan: Plan, y: TaxableYear, average: Money) kind empirical {
    label en unofficial "the annual average amount of applicable employer cost from the first year of the transfer period through the last day of the 4th year (6th under (e)(7)) following it, case-asserted (clause (i)(I))";
}

pub relation future_minimum_cost_period_years_420f2Di1(plan: Plan, y: TaxableYear, years: Integer) kind institutional {
    label en official "section 420(f)(2)(D)(i)(I): the period ends with the 4th year following the transfer period, or the 6th year for a transfer to which subsection (e)(7) applies";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "ending with the last day of the 4th year (the 6th year in the case of a transfer to which subsection (e)(7) applies) following the transfer period")
rule FutureMinimumCostPeriodFour420f2Di1(plan: Plan, y: TaxableYear) strict {
    label en official "4 years when the de minimis rule does not apply";
    when future_transfer_of_kind_420f(plan, y, QualifiedFutureTransfer) and not_known(reduced_threshold_applies_420e7(plan, y));
    then future_minimum_cost_period_years_420f2Di1(plan, y, 4);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "ending with the last day of the 4th year (the 6th year in the case of a transfer to which subsection (e)(7) applies) following the transfer period")
rule FutureMinimumCostPeriodSix420f2Di1(plan: Plan, y: TaxableYear) strict {
    label en official "6 years when the de minimis rule applies";
    when future_transfer_of_kind_420f(plan, y, QualifiedFutureTransfer) and reduced_threshold_applies_420e7(plan, y);
    then future_minimum_cost_period_years_420f2Di1(plan, y, 6);
}

pub relation future_minimum_cost_met_420f2Di1(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(2)(D)(i)(I): the annual average applicable employer cost over the period is not less than the applicable employer cost determined under (c)(3)(A) for the transfer";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "such that the annual average amount of the applicable employer cost during such period is not less than the applicable employer cost determined under subsection (c)(3)(A) with respect to the transfer")
rule FutureMinimumCostMet420f2Di1(plan: Plan, y: TaxableYear, average: Money, cost: Money) strict {
    label en official "exact boundary: an average equal to the (c)(3)(A) cost is enough";
    when average_applicable_employer_cost_over_future_period_420f2Di1(plan, y, average)
        and applicable_employer_cost_420c3(plan, y, cost)
        and average >= cost;
    then future_minimum_cost_met_420f2Di1(plan, y);
}

pub relation cb_employer_cost_each_year_and_specified_420f2Di2(plan: Plan, y: TaxableYear, cost: Money, specified: Money) kind empirical {
    label en unofficial "the collectively bargained employer cost for a taxable year of the cost maintenance period and the amount specified by the collective bargaining agreement, case-asserted";
}

pub relation cb_minimum_cost_year_met_420f2Di2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(2)(D)(i)(II): the collectively bargained employer cost for the year is not less than the amount specified by the agreement";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "provides that the collectively bargained employer cost for each taxable year during the collectively bargained cost maintenance period shall not be less than the amount specified by the collective bargaining agreement")
rule CbMinimumCostYearMet420f2Di2(plan: Plan, y: TaxableYear, cost: Money, specified: Money) strict {
    label en official "exact boundary: equal is enough";
    when cb_employer_cost_each_year_and_specified_420f2Di2(plan, y, cost, specified) and cost >= specified;
    then cb_minimum_cost_year_met_420f2Di2(plan, y);
}

pub relation employer_elects_pre_1999_cost_rules_420f2Dii(plan: Plan, employer: Person, y: TaxableYear, kind: RetireeBenefitKind420) kind empirical {
    label en unofficial "the employer elects, in lieu of clause (i)(I), to meet subsection (c)(3) as in effect before the amendments of section 535 of the Tax Relief Extension Act of 1999, separately for health or life benefits, case-asserted (exercise atom)";
}

pub relation pre_1999_cost_rules_in_effect_420f2Dii(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420) kind institutional {
    label en official "section 420(f)(2)(D)(ii): the election to maintain benefits under the earlier form of (c)(3) for each year of the period";
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "An employer may elect, in lieu of the requirements of clause (i)(I), to meet the requirements of subsection (c)(3)")
rule Pre1999CostRulesElectionPower420f2Dii(plan: Plan, employer: Person, y: TaxableYear, kind: RetireeBenefitKind420) strict {
    label en official "PARTIAL: a power valid for a qualified future transfer; the pre-1999 text of (c)(3) is not pinned so the alternative requirements themselves are not modelled";
    when plan_employer_420(plan, employer) and employer_elects_pre_1999_cost_rules_420f2Dii(plan, employer, y, kind);
    then power ElectPre1999CostRulesPower {
        holder employer;
        over employer;
        exercise employer_elects_pre_1999_cost_rules_420f2Dii(plan, employer, y, kind);
        valid_when future_transfer_is_qualified_future_420f2Dii(plan, y);
        effect pre_1999_cost_rules_in_effect_420f2Dii(plan, y, kind);
    };
}

pub relation future_transfer_is_qualified_future_420f2Dii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "helper: the transfer for the year is a qualified future transfer";
}

rule FutureTransferIsQualifiedFuture420f2Dii(plan: Plan, y: TaxableYear) strict {
    label en official "helper for the power's single valid_when atom";
    when future_transfer_of_kind_420f(plan, y, QualifiedFutureTransfer);
    then future_transfer_is_qualified_future_420f2Dii(plan, y);
}

pub relation cb_agreement_total_cost_and_individuals_420f2Diii(plan: Plan, y: TaxableYear, total: Money, individuals: Decimal) kind empirical {
    label en unofficial "the total cost of providing collectively bargained health or life insurance benefits under the agreement and the number of covered individuals, case-asserted";
}

pub relation cb_agreement_government_program_reduction_420f2Diii(plan: Plan, y: TaxableYear, reduction: Money) kind empirical {
    label en unofficial "the reduction the agreement provides for the part of the benefits provided or financed by a government program or other source, per covered individual, case-asserted";
}

pub relation collectively_bargained_employer_cost_420f2Diii(plan: Plan, y: TaxableYear, cost: Money) kind institutional {
    label en official "section 420(f)(2)(D)(iii): the average cost per covered individual of providing the collectively bargained benefits as determined under the agreement, reduced as the agreement provides for government-financed benefits";
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the term \"collectively bargained employer cost\" means the average cost per covered individual of providing collectively bargained health benefits")
rule CollectivelyBargainedEmployerCost420f2Diii(plan: Plan, y: TaxableYear, total: Money, n: Decimal, reduction: Money) strict {
    label en official "PARTIAL: average cost less the per-individual reduction; an agreement without a reduction is the plain average (second rule)";
    when cb_agreement_total_cost_and_individuals_420f2Diii(plan, y, total, n)
        and cb_agreement_government_program_reduction_420f2Diii(plan, y, reduction)
        and n > 0.0;
    then collectively_bargained_employer_cost_420f2Diii(plan, y, div_round(total, n, 2, "HALF_UP") - reduction);
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the term \"collectively bargained employer cost\" means the average cost per covered individual of providing collectively bargained health benefits")
rule CollectivelyBargainedEmployerCostNoReduction420f2Diii(plan: Plan, y: TaxableYear, total: Money, n: Decimal) strict {
    label en official "PARTIAL: without a government-program reduction the plain average";
    when cb_agreement_total_cost_and_individuals_420f2Diii(plan, y, total, n)
        and n > 0.0
        and not_known(cb_reduction_recorded_420f2Diii(plan, y));
    then collectively_bargained_employer_cost_420f2Diii(plan, y, div_round(total, n, 2, "HALF_UP"));
}

pub relation cb_reduction_recorded_420f2Diii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "helper: a government-program reduction is on record";
}

rule CbReductionRecorded420f2Diii(plan: Plan, y: TaxableYear, reduction: Money) strict {
    label en official "helper for the not_known guard";
    when cb_agreement_government_program_reduction_420f2Diii(plan, y, reduction);
    then cb_reduction_recorded_420f2Diii(plan, y);
}

// =====================================================================
// (f)(2)(E) Collectively bargained transfers: conditions and use of assets
// =====================================================================

pub relation transfer_made_under_collective_bargaining_agreement_420f2Ei1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the transfer is made in accordance with a collective bargaining agreement, case-asserted";
}

pub relation designation_notice_delivered_on_420f2Ei2(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the employer delivers written notice designating the transfer as a collectively bargained transfer to each employee organization that is a party to the agreement, case-asserted";
}

pub relation retiree_health_cost_2005_420f2Ei3(plan: Plan, cost: Money) kind empirical {
    label en unofficial "the aggregate cost (including administrative expenses) that would have been allowable as a deduction, on the cash method as if provided directly, of the retiree health benefits or coverage provided under all the employer's health benefit plans in its taxable year ending in 2005, case-asserted";
}

pub relation gross_receipts_2005_420f2Ei3(plan: Plan, receipts: Money) kind empirical {
    label en unofficial "the employer's gross receipts for the taxable year ending in 2005 determined under the last sentence of (c)(3)(E)(ii)(II), case-asserted";
}

pub relation plan_maintained_by_successor_of_2005_employer_420f2Ei3(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained by a successor to the employer that met the 2005 test, case-asserted";
}

pub relation predecessor_2005_test_met_420f2Ei3(plan: Plan) kind empirical {
    label en unofficial "the predecessor employer met the 2005 retiree health test (5 percent of gross receipts), case-asserted";
}

pub relation employer_2005_retiree_health_test_met_420f2Ei3(plan: Plan) kind institutional {
    label en official "section 420(f)(2)(E)(i)(III): the employer provided retiree health benefits in its 2005 taxable year with an aggregate deductible cost of at least 5 percent of its gross receipts, or a successor plan";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "is at least 5 percent of the gross receipts of the employer")
rule Employer2005RetireeHealthTestMet420f2Ei3(plan: Plan, cost: Money, receipts: Money) strict {
    label en official "exact boundary: exactly 5 percent qualifies (0.05)";
    when retiree_health_cost_2005_420f2Ei3(plan, cost) and gross_receipts_2005_420f2Ei3(plan, receipts) and cost >= receipts * 0.05;
    then employer_2005_retiree_health_test_met_420f2Ei3(plan);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "or a plan maintained by a successor to such employer")
rule Employer2005TestMetBySuccessor420f2Ei3(plan: Plan) strict {
    label en official "a successor plan takes the predecessor's status (the predecessor's test is a case fact)";
    when plan_maintained_by_successor_of_2005_employer_420f2Ei3(plan) and predecessor_2005_test_met_420f2Ei3(plan);
    then employer_2005_retiree_health_test_met_420f2Ei3(plan);
}

pub relation transfer_on_date_420f2E(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date of the collectively bargained transfer, case-asserted";
}

pub relation collectively_bargained_transfer_conditions_met_420f2Ei(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(2)(E)(i): the transfer is made under a collective bargaining agreement, designated by written notice before the transfer, and involves a plan of an employer meeting the 2005 retiree health test";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "A collectively bargained transfer shall only include a transfer which")
rule CollectivelyBargainedTransferConditionsMet420f2Ei(plan: Plan, y: TaxableYear, notice: Date, transfer: Date) strict {
    label en official "exact boundary: notice on the day before the transfer is timely, on the transfer day it is not \"before the transfer\"";
    when transfer_made_under_collective_bargaining_agreement_420f2Ei1(plan, y)
        and designation_notice_delivered_on_420f2Ei2(plan, y, notice)
        and transfer_on_date_420f2E(plan, y, transfer)
        and notice < transfer
        and employer_2005_retiree_health_test_met_420f2Ei3(plan);
    then collectively_bargained_transfer_conditions_met_420f2Ei(plan, y);
}

pub relation uses_cb_assets_for_other_purpose_420f2Eii(employer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer uses assets transferred in a collectively bargained transfer (or income allocable to them) for a purpose other than paying collectively bargained retiree liabilities (other than key employees' liabilities) for the transfer year or a later year in the cost maintenance period, case-asserted (action atom)";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "shall be used only to pay collectively bargained retiree liabilities")
rule CbAssetsUseProhibition420f2Eii(employer: Person, plan: Plan, y: TaxableYear) strict {
    label en official "the assets of a collectively bargained transfer may be used only for collectively bargained retiree liabilities";
    when plan_employer_420(plan, employer) and future_transfer_of_kind_420f(plan, y, CollectivelyBargainedTransfer);
    then prohibition UseCollectivelyBargainedAssetsOnlyForCbLiabilitiesProhibition {
        bearer employer;
        action uses_cb_assets_for_other_purpose_420f2Eii(employer, plan, y);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (f)(3), (f)(4) Coordination and deduction rules; (f)(6) definitions
// =====================================================================

pub relation qcrl_and_amount_taken_into_account_for_future_transfer_420f3(plan: Plan, y: TaxableYear, qcrl: Money, taken: Money) kind empirical {
    label en unofficial "the qualified current retiree liabilities for the subsequent transfer year and the liabilities taken into account for the qualified future or collectively bargained transfer to which the period relates, case-asserted";
}

pub relation qcrl_for_subsequent_transfer_420f3(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 420(f)(3): for a subsequent transfer in a transfer period or cost maintenance period, the liabilities are reduced by those taken into account for the future or collectively bargained transfer";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "qualified current retiree liabilities shall be reduced by any such liabilities taken into account with respect to the qualified future transfer or collectively bargained transfer to which such period relates")
rule QcrlForSubsequentTransfer420f3(plan: Plan, y: TaxableYear, qcrl: Money, taken: Money) strict {
    label en official "liabilities less those already taken into account";
    when qcrl_and_amount_taken_into_account_for_future_transfer_420f3(plan, y, qcrl, taken);
    then qcrl_for_subsequent_transfer_420f3(plan, y, qcrl - taken);
}

pub relation deduction_limit_420d1C_inapplicable_to_cb_420f4A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(f)(4)(A): for a collectively bargained transfer the limitation of subsection (d)(1)(C) does not apply";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "the limitation under subsection (d)(1)(C) shall not apply")
rule DeductionLimitInapplicableToCb420f4A(plan: Plan, y: TaxableYear) strict {
    label en official "collectively bargained transfers only";
    when future_transfer_of_kind_420f(plan, y, CollectivelyBargainedTransfer);
    then deduction_limit_420d1C_inapplicable_to_cb_420f4A(plan, y);
}

pub relation employer_contributes_for_cb_retiree_liabilities_420f4B(employer: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer contributes an amount to a health benefits account or welfare benefit fund with respect to collectively bargained retiree liabilities for which transferred assets are required to be used, case-asserted (action atom)";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "notwithstanding subsection (d)(2), an employer may contribute an amount to a health benefits account or welfare benefit fund")
rule CbContributionLiberty420f4B(employer: Person, plan: Plan, y: TaxableYear, party: Person) strict {
    label en official "a liberty of the employer notwithstanding the (d)(2) prohibition; the deductibility is governed by the section 419A(f)(5)(A) limits, not modelled here";
    when plan_employer_420(plan, employer)
        and future_transfer_of_kind_420f(plan, y, CollectivelyBargainedTransfer)
        and plan_beneficiary_party_420(plan, party);
    then liberty ContributeForCbLiabilitiesLiberty {
        holder employer;
        against party;
        action employer_contributes_for_cb_retiree_liabilities_420f4B(employer, plan, y);
        window [-infinity, infinity];
    };
}

pub relation plan_beneficiary_party_420(plan: Plan, party: Person) kind empirical {
    label en unofficial "a person against whom the employer's liberty is stated (the covered retirees' representative), case-asserted";
}

pub relation remaining_lifetime_end_420f6Ai(person: Person, on: Date) kind empirical {
    label en unofficial "the last day of the remaining lifetime of the covered retiree (and, for a transfer to a health benefits account, the covered spouse and dependents), case-asserted";
}

pub relation coverage_period_end_420f6Aii(person: Person, on: Date) kind empirical {
    label en unofficial "the last day of the period of coverage provided by the collectively bargained plan, determined as of the date of the transfer, case-asserted";
}

pub relation cb_cost_maintenance_period_end_420f6A(person: Person, on: Date) kind institutional {
    label en official "section 420(f)(6)(A): the shorter of the remaining lifetime and the period of coverage provided by the collectively bargained plan";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "the shorter of")
rule CbCostMaintenancePeriodLifetimeShorter420f6A(person: Person, life: Date, cover: Date) strict {
    label en official "the shorter period ends earlier; on equal dates either";
    when remaining_lifetime_end_420f6Ai(person, life) and coverage_period_end_420f6Aii(person, cover) and life <= cover;
    then cb_cost_maintenance_period_end_420f6A(person, life);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "the shorter of")
rule CbCostMaintenancePeriodCoverageShorter420f6A(person: Person, life: Date, cover: Date) strict {
    label en official "the period of coverage ends strictly earlier";
    when remaining_lifetime_end_420f6Ai(person, life) and coverage_period_end_420f6Aii(person, cover) and cover < life;
    then cb_cost_maintenance_period_end_420f6A(person, cover);
}

pub relation cb_retiree_liabilities_present_value_420f6Bi(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the present value, as of the beginning of the taxable year and determined in accordance with the agreement, of all collectively bargained benefits (including administrative expenses) for the year and each later year of the cost maintenance period, case-asserted";
}

pub relation cb_set_aside_assets_420f6Bii(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the value, as of the close of the plan year preceding the transfer year, of the assets in all accounts or welfare benefit funds set aside to pay for the collectively bargained retiree liabilities, case-asserted";
}

pub relation cb_key_employee_amount_420f6Biii(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind empirical {
    label en unofficial "the part of the liabilities attributable to key employees, case-asserted";
}

pub relation collectively_bargained_retiree_liabilities_420f6B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, amount: Money) kind institutional {
    label en official "section 420(f)(6)(B): the present value of the collectively bargained benefits over the cost maintenance period, less key employees and less the assets set aside (separately for health and life)";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "The amount determined under clause (i) shall be reduced by the value")
rule CollectivelyBargainedRetireeLiabilities420f6B(plan: Plan, y: TaxableYear, kind: RetireeBenefitKind420, pv: Money, assets: Money, key: Money) strict {
    label en official "JUDGMENT CALL: subtraction floored at zero";
    when cb_retiree_liabilities_present_value_420f6Bi(plan, y, kind, pv)
        and cb_set_aside_assets_420f6Bii(plan, y, kind, assets)
        and cb_key_employee_amount_420f6Biii(plan, y, kind, key);
    then collectively_bargained_retiree_liabilities_420f6B(plan, y, kind, max(0.00 USD, pv - key - assets));
}

pub relation retiree_entitled_before_cb_transfer_420f6C(person: Person, plan: Plan) kind empirical {
    label en unofficial "the retired employee, immediately before the collectively bargained transfer, is entitled to the benefits by reason of retirement and to pension benefits under the plan, case-asserted";
}

pub relation agreement_specifies_future_retirees_420f6Cii(plan: Plan) kind empirical {
    label en unofficial "the collective bargaining agreement specifies that the benefits will be provided at retirement to employees who are not retired at the transfer, case-asserted";
}

pub relation future_retiree_entitled_420f6Cii(person: Person, plan: Plan) kind empirical {
    label en unofficial "the non-retired employee is entitled to receive the benefits at retirement and to pension benefits under the plan, case-asserted";
}

pub relation cb_health_retiree_420f6C(person: Person, plan: Plan) kind institutional {
    label en official "helper: a retiree or future retiree covered by clause (i) or (ii)";
}

pub relation collectively_bargained_health_benefit_recipient_420f6C(person: Person, plan: Plan) kind institutional {
    label en official "section 420(f)(6)(C): retired employees entitled by retirement and to pension benefits (and their spouses and dependents), and, if the agreement so specifies, employees who will be so entitled at retirement (and their spouses and dependents)";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "which are provided to retired employees who, immediately before the collectively bargained transfer, are entitled to receive such benefits by reason of retirement")
rule CbHealthRetiree420f6Ci(person: Person, plan: Plan) strict {
    label en official "clause (i)";
    when retiree_entitled_before_cb_transfer_420f6C(person, plan);
    then cb_health_retiree_420f6C(person, plan);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "if specified by the provisions of the collective bargaining agreement governing the collectively bargained transfer, which will be provided at retirement")
rule CbHealthRetireeFuture420f6Cii(person: Person, plan: Plan) strict {
    label en official "clause (ii): only if the agreement specifies";
    when agreement_specifies_future_retirees_420f6Cii(plan) and future_retiree_entitled_420f6Cii(person, plan);
    then cb_health_retiree_420f6C(person, plan);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "which are provided to retired employees who, immediately before the collectively bargained transfer, are entitled to receive such benefits by reason of retirement")
rule CbHealthRecipientRetiree420f6Ci(person: Person, plan: Plan) strict {
    label en official "a covered retiree is a recipient";
    when cb_health_retiree_420f6C(person, plan);
    then collectively_bargained_health_benefit_recipient_420f6C(person, plan);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "and their spouses and dependents")
rule CbHealthRecipientSpouse420f6C(person: Person, retiree: Person, plan: Plan) strict {
    label en official "spouses and dependents of a recipient";
    when spouse_or_dependent_of_retiree_420e1C(person, retiree) and cb_health_retiree_420f6C(retiree, plan);
    then collectively_bargained_health_benefit_recipient_420f6C(person, plan);
}

pub relation cb_life_insurance_recipient_retired_420f6Di(person: Person, plan: Plan) kind empirical {
    label en unofficial "the retired employee is, immediately before the transfer, entitled to applicable life insurance benefits by reason of retirement, case-asserted";
}

pub relation cb_life_insurance_future_retiree_420f6Dii(person: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is not retired at the transfer and will receive applicable life insurance benefits at retirement as the agreement specifies, case-asserted";
}

pub relation collectively_bargained_life_insurance_recipient_420f6D(person: Person, plan: Plan) kind institutional {
    label en official "section 420(f)(6)(D): retired employees entitled by retirement to applicable life insurance benefits, and, if the agreement specifies, employees who will receive them at retirement";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "applicable life insurance benefits which are provided to retired employees who, immediately before the transfer, are entitled to receive such benefits by reason of retirement")
rule CbLifeRecipientRetired420f6Di(person: Person, plan: Plan) strict {
    label en official "clause (i)";
    when cb_life_insurance_recipient_retired_420f6Di(person, plan);
    then collectively_bargained_life_insurance_recipient_420f6D(person, plan);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "if specified by the provisions of the collective bargaining agreement governing the transfer")
rule CbLifeRecipientFuture420f6Dii(person: Person, plan: Plan) strict {
    label en official "clause (ii): only if the agreement specifies";
    when agreement_specifies_future_retirees_420f6Cii(plan) and cb_life_insurance_future_retiree_420f6Dii(person, plan);
    then collectively_bargained_life_insurance_recipient_420f6D(person, plan);
}

pub relation plan_maintained_pursuant_to_collective_bargaining_420f6E(plan: Plan) kind empirical {
    label en unofficial "a group health plan or arrangement for retired employees and their spouses and dependents, or a group-term life insurance plan or arrangement for retired employees, maintained pursuant to one or more collective bargaining agreements, case-asserted";
}

pub relation collectively_bargained_plan_420f6E(plan: Plan) kind institutional {
    label en official "section 420(f)(6)(E): a retiree group health or group-term life plan or arrangement maintained pursuant to collective bargaining agreements";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "The term \"collectively bargained plan\" means a group health plan or arrangement for retired employees and their spouses and dependents")
rule CollectivelyBargainedPlan420f6E(plan: Plan) strict {
    label en official "maintained pursuant to one or more agreements";
    when plan_maintained_pursuant_to_collective_bargaining_420f6E(plan);
    then collectively_bargained_plan_420f6E(plan);
}

// =====================================================================
// (f)(7) Election to end the transfer period
// =====================================================================

pub relation employer_elects_to_end_transfer_period_420f7A(plan: Plan, employer: Person, on: Date) kind empirical {
    label en unofficial "the date the employer elects to terminate the transfer period of a qualified future transfer effective as of a later taxable year, case-asserted (exercise atom)";
}

pub relation transfer_period_termination_elected_420f7A(plan: Plan) kind institutional {
    label en official "section 420(f)(7)(A): the election to terminate the transfer period made not later than December 31, 2021";
}

pub relation election_effective_year_start_420f7A(plan: Plan, start: Date) kind empirical {
    label en unofficial "the first day of the taxable year specified for the termination to be effective, case-asserted";
}

pub relation employer_of_qualified_future_transfer_420f7(plan: Plan, employer: Person) kind institutional {
    label en official "helper: the employer maintains a plan that made a qualified future transfer";
}

rule EmployerOfQualifiedFutureTransfer420f7(plan: Plan, employer: Person, y: TaxableYear) strict {
    label en official "helper for the power's valid_when";
    when plan_employer_420(plan, employer) and future_transfer_of_kind_420f(plan, y, QualifiedFutureTransfer);
    then employer_of_qualified_future_transfer_420f7(plan, employer);
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "such employer may, not later than December 31, 2021, elect to terminate the transfer period with respect to such transfer effective as of any taxable year specified by the taxpayer that begins after the date of such election")
rule EndTransferPeriodElectionPower420f7A(plan: Plan, employer: Person, elected: Date, start: Date) strict {
    label en official "exact boundary: the election on December 31, 2021 is timely, January 1, 2022 is not; the effective year must begin after the election date";
    when plan_employer_420(plan, employer)
        and employer_elects_to_end_transfer_period_420f7A(plan, employer, elected)
        and election_effective_year_start_420f7A(plan, start)
        and elected <= @2021-12-31
        and start > elected;
    then power EndTransferPeriodPower {
        holder employer;
        over employer;
        exercise employer_elects_to_end_transfer_period_420f7A(plan, employer, elected);
        valid_when employer_of_qualified_future_transfer_420f7(plan, employer);
        effect transfer_period_termination_elected_420f7A(plan);
    };
}

pub relation unused_assets_at_termination_returned_420f7B(plan: Plan) kind empirical {
    label en unofficial "the assets (and income) not used as of the effective date of the termination election have been transferred out of the account to the transferor plan within a reasonable period, case-asserted (goal atom)";
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "shall be transferred out of the account to the transferor plan within a reasonable period of time")
rule ReturnAssetsOnTerminationDuty420f7B(plan: Plan, employer: Person, start: Date) strict {
    label en official "PARTIAL/EVALUATIVE: \"within a reasonable period\" has no numeric end; the duty runs from the effective date of the termination";
    when transfer_period_termination_elected_420f7A(plan)
        and election_effective_year_start_420f7A(plan, start)
        and plan_employer_420(plan, employer);
    then duty ReturnAssetsOnTerminationDuty {
        bearer employer;
        goal achievement {
            condition unused_assets_at_termination_returned_420f7B(plan);
            window [start, infinity];
        }
    };
}

pub relation original_transfer_period_end_420f7F(plan: Plan, end: Date) kind empirical {
    label en unofficial "the last day of the original transfer period (the transfer period determined without regard to the termination election), case-asserted";
}

pub relation equivalent_amount_transferred_back_by_420f7B(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date an equivalent amount is transferred back to the account, case-asserted";
}

pub relation termination_transfer_is_reversion_420f7B(plan: Plan) kind institutional {
    label en official "section 420(f)(7)(B): the transfer out is an employer reversion for section 4980 (other than subsection (d)) unless an equivalent amount is transferred back before the end of the 5-year period beginning after the original transfer period";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "The transfer required by this subparagraph shall be treated as an employer reversion for purposes of section 4980 (other than subsection (d) thereof)")
rule TerminationTransferIsReversion420f7B(plan: Plan, original_end: Date) strict {
    label en official "a reversion when no equivalent amount is transferred back in time";
    when transfer_period_termination_elected_420f7A(plan)
        and original_transfer_period_end_420f7F(plan, original_end)
        and not_known(equivalent_transfer_back_in_time_420f7B(plan));
    then termination_transfer_is_reversion_420f7B(plan);
}

pub relation equivalent_transfer_back_in_time_420f7B(plan: Plan) kind institutional {
    label en official "helper: an equivalent amount is transferred back to the account within 5 years after the original transfer period";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "unless before the end of the 5-year period beginning after the original transfer period an equivalent amount is transferred back")
rule EquivalentTransferBackInTime420f7B(plan: Plan, original_end: Date, back: Date) strict {
    label en official "exact boundary: the 5-year period begins on the day after the original transfer period ends and ends on the day before the 5th anniversary of that day";
    when original_transfer_period_end_420f7F(plan, original_end)
        and equivalent_amount_transferred_back_by_420f7B(plan, back)
        and back < add_calendar_period(add_calendar_period(original_end, 1 calendar_day), 5 calendar_year);
    then equivalent_transfer_back_in_time_420f7B(plan);
}

pub relation minimum_cost_continues_after_termination_420f7C(plan: Plan) kind institutional {
    label en official "section 420(f)(7)(C): the requirements of subsection (c)(3) and paragraph (2)(D) continue to apply without regard to the termination election";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "shall apply with respect to a qualified future transfer without regard to any election under subparagraph (A) with respect to such transfer")
rule MinimumCostContinuesAfterTermination420f7C(plan: Plan) strict {
    label en official "after an election to terminate";
    when transfer_period_termination_elected_420f7A(plan);
    then minimum_cost_continues_after_termination_420f7C(plan);
}

pub relation funded_status_percentage_420f7D(plan: Plan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 420(f)(7)(D): during the original transfer period the (2)(B)(i) percentage is 100 percent instead of 120 percent after a termination election";
}

pub relation year_in_original_transfer_period_420f7D(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year is in the original transfer period, case-asserted";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "clause (i) thereof shall be applied by substituting \"100 percent\" for \"120 percent\" during the original transfer period")
rule FundedStatusPercentageHundred420f7D(plan: Plan, y: TaxableYear) strict {
    label en official "exact: 1.00";
    when transfer_period_termination_elected_420f7A(plan) and year_in_original_transfer_period_420f7D(plan, y);
    then funded_status_percentage_420f7D(plan, y, 1.00);
}

pub relation valuation_date_year_after_original_period_420f7E(plan: Plan, ordinal: Integer) kind empirical {
    label en unofficial "the valuation date of the plan year is the 1st, 2nd, 3rd, 4th or 5th plan year after the original transfer period, case-asserted";
}

pub relation excess_at_last_original_year_valuation_420f7Ei(plan: Plan) kind empirical {
    label en unofficial "the plan has an excess described in paragraph (2)(B)(ii) as of the valuation date of the last plan year of the original transfer period, case-asserted";
}

pub relation continued_maintenance_percentage_420f7Eii(plan: Plan, ordinal: Integer, pct: Decimal) kind institutional {
    label en official "section 420(f)(7)(E)(ii): the applicable percentage table: 104, 108, 112, 116 and 120 percent for the 1st to 5th year after the original transfer period (table T1 of the model)";
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the applicable percentage shall be determined under the following table")
rule ContinuedMaintenancePercentage1420f7Eii(plan: Plan) strict {
    label en official "PARTIAL: table T1 read from the model, 1st year 104 percent";
    when excess_at_last_original_year_valuation_420f7Ei(plan) and valuation_date_year_after_original_period_420f7E(plan, 1);
    then continued_maintenance_percentage_420f7Eii(plan, 1, 1.04);
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the applicable percentage shall be determined under the following table")
rule ContinuedMaintenancePercentage2420f7Eii(plan: Plan) strict {
    label en official "PARTIAL: 2nd year 108 percent";
    when excess_at_last_original_year_valuation_420f7Ei(plan) and valuation_date_year_after_original_period_420f7E(plan, 2);
    then continued_maintenance_percentage_420f7Eii(plan, 2, 1.08);
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the applicable percentage shall be determined under the following table")
rule ContinuedMaintenancePercentage3420f7Eii(plan: Plan) strict {
    label en official "PARTIAL: 3rd year 112 percent";
    when excess_at_last_original_year_valuation_420f7Ei(plan) and valuation_date_year_after_original_period_420f7E(plan, 3);
    then continued_maintenance_percentage_420f7Eii(plan, 3, 1.12);
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the applicable percentage shall be determined under the following table")
rule ContinuedMaintenancePercentage4420f7Eii(plan: Plan) strict {
    label en official "PARTIAL: 4th year 116 percent";
    when excess_at_last_original_year_valuation_420f7Ei(plan) and valuation_date_year_after_original_period_420f7E(plan, 4);
    then continued_maintenance_percentage_420f7Eii(plan, 4, 1.16);
}

@source(IRC_S420_F, relation = formalizes, coverage = partial, quote = "the applicable percentage shall be determined under the following table")
rule ContinuedMaintenancePercentage5420f7Eii(plan: Plan) strict {
    label en official "PARTIAL: 5th year 120 percent";
    when excess_at_last_original_year_valuation_420f7Ei(plan) and valuation_date_year_after_original_period_420f7E(plan, 5);
    then continued_maintenance_percentage_420f7Eii(plan, 5, 1.20);
}

pub relation no_excess_at_120_percent_at_valuation_420f7Eiii(plan: Plan) kind empirical {
    label en unofficial "as of the valuation date of a plan year in the first 4 years after the original transfer period there would be no excess were the applicable percentage 120 percent, case-asserted";
}

pub relation continued_maintenance_ceases_420f7Eiii(plan: Plan) kind institutional {
    label en official "section 420(f)(7)(E)(iii): the continued maintenance rule ceases when there would be no excess at 120 percent in the first 4 years";
}

@source(IRC_S420_F, relation = formalizes, coverage = exact, quote = "then this subparagraph shall cease to apply with respect to the plan")
rule ContinuedMaintenanceCeases420f7Eiii(plan: Plan, ordinal: Integer) strict {
    label en official "exact boundary: years 1 to 4 only (the 5th year is not \"the first 4 years\")";
    when no_excess_at_120_percent_at_valuation_420f7Eiii(plan)
        and valuation_date_year_after_original_period_420f7E(plan, ordinal)
        and ordinal >= 1
        and ordinal <= 4;
    then continued_maintenance_ceases_420f7Eiii(plan);
}

// =====================================================================
// (g) Segment rates without pension stabilization
// =====================================================================

pub relation section_430h2Civ_disregarded_for_section_420_420g(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 420(g): for purposes of section 420, section 430 is applied without regard to subsection (h)(2)(C)(iv) (the pension stabilization corridor)";
}

@source(IRC_S420_G, relation = formalizes, coverage = exact, quote = "section 430 shall be applied without regard to subsection (h)(2)(C)(iv) thereof")
rule Section430h2CivDisregarded420g(plan: Plan, y: TaxableYear) strict {
    label en official "for the funding target and target normal cost used in the excess pension assets test";
    when funding_target_and_normal_cost_420e2B(plan, y, _);
    then section_430h2Civ_disregarded_for_section_420_420g(plan, y);
}
