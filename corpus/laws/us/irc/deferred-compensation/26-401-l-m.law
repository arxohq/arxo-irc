// Section 401(l) (permitted disparity) and 401(m) (matching contributions
// and employee contributions) — STAGE 2e residual (IRC-09, DECISION-0379,
// 25.09.2026). Percentages are Decimals in percentage points (5.7 =
// 5.7 percent). Module 03 holds the ACP test itself (`acp_test_passed`); this
// module adds the surrounding requirement, the definitions, the correction
// duty and the safe harbor matching rules.

// =====================================================================
// (l) Permitted disparity in plan contributions or benefits
// =====================================================================

use self::{
    Contribution,
    DefinedBenefitPlan,
    Distribution,
    IRC_S401_L,
    IRC_S401_M,
    Person,
    Plan,
    TaxableYear,
    acp_test_passed,
    participates_in,
    plan_sponsor,
    plan_year_ends,
    safe_harbor_notice_and_matching_requirements_met,
    simple401k_satisfies_adp,
};

pub relation excess_contribution_percentage(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of compensation contributed by the employer on compensation above the integration level, case-asserted (section 401(l)(2)(B)(i))";
}

pub relation base_contribution_percentage(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the percentage of compensation contributed by the employer on compensation not above the integration level, case-asserted (section 401(l)(2)(B)(ii))";
}

pub relation oasdi_portion_of_3111a_rate(y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the portion of the section 3111(a) rate in effect at the start of the year attributable to old-age insurance, as a percentage, case-asserted";
}

pub relation dc_permitted_disparity_met(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(l)(2)(A): the excess contribution percentage does not exceed the base percentage by more than the lesser of the base percentage and the greater of 5.7 points and the old-age insurance portion of the section 3111(a) rate";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "A defined contribution plan meets the requirements of this paragraph if the excess contribution percentage does not exceed the base contribution percentage by more than the lesser of")
rule DcPermittedDisparityMet(plan: Plan, y: TaxableYear, excess: Decimal, base: Decimal, oasdi: Decimal) strict {
    label en official "excess <= base + min(base, max(5.7, oasdi)); exact boundary";
    when excess_contribution_percentage(plan, y, excess)
        and base_contribution_percentage(plan, y, base)
        and oasdi_portion_of_3111a_rate(y, oasdi)
        and excess <= base + min(base, max(5.7, oasdi));
    then dc_permitted_disparity_met(plan, y);
}

pub relation excess_benefit_percentage(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the benefit accrual percentage on compensation above the integration level, computed from benefits attributable to employer contributions, case-asserted (section 401(l)(3)(A)(ii))";
}

pub relation base_benefit_percentage(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the benefit accrual percentage on compensation not above the integration level, case-asserted";
}

pub enum AllowanceBasis401l {
    PerYearOfService;
    TotalBenefits;
}

pub relation years_of_service_taken_into_account(plan: DefinedBenefitPlan, participant: Person, years: Decimal) kind empirical {
    label en unofficial "the participant's years of service with the employer taken into account under the plan, case-asserted";
}

pub relation maximum_excess_allowance(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, basis: AllowanceBasis401l, pct: Decimal) kind institutional {
    label en official "section 401(l)(4)(A): 3/4 of a percentage point per year of service, or for total benefits 3/4 point times years of service (at most 35), never more than the base benefit percentage";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "in the case of benefits attributable to any year of service with the employer taken into account under the plan, ¾ of a percentage point")
rule MaximumExcessAllowancePerYear(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, base: Decimal) strict {
    label en official "min(0.75, base benefit percentage)";
    when years_of_service_taken_into_account(plan, participant, _) and base_benefit_percentage(plan, y, base);
    then maximum_excess_allowance(plan, participant, y, PerYearOfService, min(0.75, base));
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "in the case of total benefits, ¾ of a percentage point, multiplied by the participant's years of service (not in excess of 35) with the employer taken into account under the plan")
rule MaximumExcessAllowanceTotal(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, years: Decimal, base: Decimal) strict {
    label en official "min(0.75 x min(years, 35), base benefit percentage): exact";
    when years_of_service_taken_into_account(plan, participant, years) and base_benefit_percentage(plan, y, base);
    then maximum_excess_allowance(plan, participant, y, TotalBenefits, min(0.75 * min(years, 35.0), base));
}

pub relation db_optional_forms_equal_below_integration_level(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "any optional form of benefit, preretirement benefit, actuarial factor or other feature provided for compensation above the integration level is also provided for compensation not above it, case-asserted (401(l)(3)(A)(i)(II))";
}

pub relation db_benefits_based_on_average_annual_compensation(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "benefits are based on average annual compensation, case-asserted (401(l)(3)(A)(i)(III), (B)(ii))";
}

pub relation db_permitted_disparity_non_offset_met(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 401(l)(3)(A)(i): a plan other than an offset plan: excess benefit percentage not above base plus the maximum excess allowance, same features, average annual compensation";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "the excess benefit percentage does not exceed the base benefit percentage by more than the maximum excess allowance")
rule DbPermittedDisparityNonOffsetMet(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, excess: Decimal, base: Decimal, allowance: Decimal) strict {
    label en official "exact: excess <= base + allowance (total benefits basis)";
    when excess_benefit_percentage(plan, y, excess)
        and base_benefit_percentage(plan, y, base)
        and maximum_excess_allowance(plan, participant, y, TotalBenefits, allowance)
        and excess <= base + allowance
        and db_optional_forms_equal_below_integration_level(plan)
        and db_benefits_based_on_average_annual_compensation(plan);
    then db_permitted_disparity_non_offset_met(plan, participant, y);
}

pub relation final_average_compensation_401l(participant: Person, amount: Money) kind empirical {
    label en unofficial "the participant's final average compensation (the 3 consecutive years ending with the current year, or the full period if shorter, each year capped at the Social Security contribution and benefit base), case-asserted (a window average over yearly capped amounts, section 111 class)";
}

pub relation accrued_benefit_without_offset(participant: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the benefit that would have accrued without the offset reduction, case-asserted";
}

pub relation offset_reduction_amount(participant: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the reduction of the accrued benefit attributable to employer contributions by reason of the offset, case-asserted (section 401(l)(3)(B)(i))";
}

pub relation maximum_offset_allowance(participant: Person, plan: DefinedBenefitPlan, years: Decimal, allowance: Money) kind institutional {
    label en official "section 401(l)(4)(B): 3/4 percent of final average compensation times years of service (at most 35), never more than 50 percent of the benefit that would have accrued without the offset";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "In no event shall the maximum offset allowance exceed 50 percent of the benefit which would have accrued without regard to the offset reduction.")
rule MaximumOffsetAllowance(participant: Person, plan: DefinedBenefitPlan, years: Decimal, fac: Money, without_offset: Money) strict {
    label en official "min(0.0075 x FAC x min(years, 35), 0.5 x benefit without offset), exact";
    when years_of_service_taken_into_account(plan, participant, years)
        and final_average_compensation_401l(participant, fac)
        and accrued_benefit_without_offset(participant, plan, without_offset);
    then maximum_offset_allowance(participant, plan, years, min(fac * (0.0075 * min(years, 35.0)), without_offset * 0.5));
}

pub relation db_permitted_disparity_offset_met(participant: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(l)(3)(B): in an offset plan the reduction of the employer-derived accrued benefit is not above the maximum offset allowance, and benefits are based on average annual compensation";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "a participant's accrued benefit attributable to employer contributions (within the meaning of section 411(c)(1)) may not be reduced (by reason of the offset) by more than the maximum offset allowance")
rule DbPermittedDisparityOffsetMet(participant: Person, plan: DefinedBenefitPlan, years: Decimal, allowance: Money, reduction: Money) strict {
    label en official "exact: reduction <= allowance";
    when maximum_offset_allowance(participant, plan, years, allowance)
        and offset_reduction_amount(participant, plan, reduction)
        and reduction <= allowance
        and db_benefits_based_on_average_annual_compensation(plan);
    then db_permitted_disparity_offset_met(participant, plan);
}

pub relation integration_level_amount(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation amount at or below which the contribution or benefit rate is lower, case-asserted (section 401(l)(5)(A)(i))";
}

pub relation social_security_contribution_and_benefit_base(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contribution and benefit base under section 230 of the Social Security Act for the year, case-asserted (external data)";
}

pub relation integration_level_within_ss_base(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(l)(5)(A)(ii): the integration level for a year may not exceed the Social Security contribution and benefit base";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "The integration level for any year may not exceed the contribution and benefit base in effect under section 230 of the Social Security Act for such year.")
rule IntegrationLevelWithinSsBase(plan: Plan, y: TaxableYear, level: Money, base: Money) strict {
    label en official "exact boundary: the level may equal the base";
    when integration_level_amount(plan, y, level) and social_security_contribution_and_benefit_base(y, base) and level <= base;
    then integration_level_within_ss_base(plan, y);
}

pub relation meets_401l(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(l)(1): a defined contribution plan meets (2); a defined benefit plan meets (3)";
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "in the case of a defined contribution plan, the requirements of paragraph (2) are met")
rule Meets401lDefinedContribution(plan: Plan, y: TaxableYear) strict {
    label en official "(A)";
    when dc_permitted_disparity_met(plan, y) and integration_level_within_ss_base(plan, y);
    then meets_401l(plan, y);
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan, the requirements of paragraph (3) are met")
rule Meets401lDefinedBenefit(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person) strict {
    label en official "(B): non-offset test with the integration level within the base";
    when db_permitted_disparity_non_offset_met(plan, participant, y) and integration_level_within_ss_base(plan, y);
    then meets_401l(plan, y);
}

@source(IRC_S401_L, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan, the requirements of paragraph (3) are met")
rule Meets401lDefinedBenefitOffset(plan: DefinedBenefitPlan, y: TaxableYear, participant: Person) strict {
    label en official "(B): offset plan test with the integration level within the base";
    when db_permitted_disparity_offset_met(participant, plan) and integration_level_within_ss_base(plan, y);
    then meets_401l(plan, y);
}

pub relation plan_integration_level_applies_to_all_participants(plan: Plan) kind empirical {
    label en unofficial "the plan's integration level applies to all participants, case-asserted (section 401(l)(5)(A)(iii))";
}

// =====================================================================
// SSA readers (IRC-G/G6, 2026-09-27): section 401(l) rows citing the Social
// Security Act. Pattern G4/CFR: the SSA content enters as case-selected
// facts; the from-package leg — reading pubs of `us.ssa.title42_values`
// (govinfo bytes pinned in corpus/laws/us/ssa-title42-values/sources/) —
// waits for registry + lock --write + flip (step 6, owner gate).
// =====================================================================
// (l)(4)(C) reduction of the 3/4 factor above covered compensation, based
// on the employer-derived portions of primary insurance amounts
// (rows 26/401/l/4/c/i/u1–u3 trigger, 26/401/l/4/c/ii/u1 basis).
pub relation employer_derived_pia_replacement_rate_401l4c(participant: Person, rate: Decimal) kind empirical {
    label en unofficial "the Secretary-prescribed percentage of compensation above covered compensation replaced by the employer-derived portion of the primary insurance amount, case-asserted from the pinned 42 USC 415 primary-insurance-amount text";
}
pub relation reduction_uses_employer_derived_pia_portion_401l4c(participant: Person, rate: Decimal) kind institutional {
    label en official "section 401(l)(4)(C): the 3/4-factor reduction above covered compensation uses the employer-derived primary-insurance-amount portion";
}
@source(IRC_S401_L, relation = formalizes, coverage = partial, quote = "Any reductions under clause (i) shall be based on the percentages of compensation replaced by the employer-derived portions of primary insurance amounts under the Social Security Act for participants with compensation in excess of covered compensation.")
rule S401L4CReductionUsesEmployerDerivedPiaPortion(participant: Person, rate: Decimal) strict {
    label en official "section 401(l)(4)(C)(ii): the asserted employer-derived PIA replacement rate grounds the reduction";
    when employer_derived_pia_replacement_rate_401l4c(participant, rate);
    then reduction_uses_employer_derived_pia_portion_401l4c(participant, rate);
}
// (l)(5)(E) covered compensation: the average of the section 230 bases
// over the 35-year period ending with the SSRA year, with no-increase
// projection before SSRA (rows 26/401/l/5/e/i/u1–ii/u1).
pub relation covered_compensation_average_asserted_401l5e(employee: Person, amount: Money) kind empirical {
    label en unofficial "the 35-year average of the section 230 contribution and benefit bases ending with the employee's social security retirement age year (no increase assumed after the determination year), case-asserted from the pinned 42 USC 430 series";
}
pub relation covered_compensation_401l5e(employee: Person, amount: Money) kind institutional {
    label en official "section 401(l)(5)(E): the covered compensation of the employee";
}
@source(IRC_S401_L, relation = formalizes, coverage = partial, quote = "The term \"covered compensation\" means, with respect to an employee, the average of the contribution and benefit bases in effect under section 230 of the Social Security Act for each year in the 35-year period ending with the year in which the employee attains the social security retirement age.")
rule S401L5ECoveredCompensationFromBases(employee: Person, amount: Money) strict {
    label en official "section 401(l)(5)(E)(i)-(ii): the asserted 35-year base average (with the no-increase projection) is the covered compensation";
    when covered_compensation_average_asserted_401l5e(employee, amount);
    then covered_compensation_401l5e(employee, amount);
}
// (l)(5)(F)(i)-(ii) reduction of allowances for unreduced early benefits;
// disability benefits (within section 223(d)) are not unreduced benefits
// (rows 26/401/l/5/f/u2, 26/401/l/5/f/u4).
pub relation unreduced_benefit_commences_before_ssra_401l5f(participant: Person) kind empirical {
    label en unofficial "the defined benefit plan provides unreduced benefits commencing before the social security retirement age, case-asserted";
}
pub relation benefit_is_disability_within_223d_401l5f(participant: Person) kind empirical {
    label en unofficial "the benefit is for disability within the meaning of section 223(d) of the Social Security Act (42 USC 423), case-asserted from the pinned text";
}
pub relation early_benefit_allowance_reduced_401l5f(participant: Person) kind institutional {
    label en official "section 401(l)(5)(F)(i): the maximum excess/offset allowance is reduced for the unreduced early benefit";
}
@source(IRC_S401_L, relation = formalizes, coverage = partial, quote = "(i) in the case of a defined benefit plan which provides for unreduced benefits commencing before the social security retirement age (as defined in section 415(b)(8)), rules providing for the reduction of the maximum excess allowance and the maximum offset allowance, and")
rule S401L5FEarlyBenefitAllowanceReduced(participant: Person) strict {
    label en official "section 401(l)(5)(F)(i) with the (ii)/223(d) exclusion: a non-disability unreduced early benefit takes the allowance reduction";
    when unreduced_benefit_commences_before_ssra_401l5f(participant)
        and not_known(benefit_is_disability_within_223d_401l5f(participant));
    then early_benefit_allowance_reduced_401l5f(participant);
}

// =====================================================================
// (m) Nondiscrimination test for matching contributions and employee contributions
// =====================================================================

pub relation meets_401m1_contribution_percentage_requirement(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(1): a defined contribution plan meets (a)(4) for matching and employee contributions only if the contribution percentage requirement (the ACP test) is met";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "only if the contribution percentage requirement of paragraph (2) of this subsection is met for such plan year")
rule Meets401m1ContributionPercentageRequirement(plan: Plan, y: TaxableYear) strict {
    label en official "reads the ACP test of module 03";
    when acp_test_passed(plan, y);
    then meets_401m1_contribution_percentage_requirement(plan, y);
}

pub enum MatchingContributionGround401m4 {
    OnAccountOfEmployeeContribution;
    OnAccountOfElectiveDeferral;
    OnAccountOfQualifiedStudentLoanPayment;
}

pub relation employer_dc_contribution_on_account_of(c: Contribution, ground: MatchingContributionGround401m4) kind empirical {
    label en unofficial "an employer contribution to a defined contribution plan on behalf of an employee made on account of an employee contribution, an elective deferral, or (subject to paragraph (14)) a qualified student loan payment, case-asserted";
}

pub relation matching_contribution_401m4A(c: Contribution) kind institutional {
    label en official "section 401(m)(4)(A): a matching contribution";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "any employer contribution made to a defined contribution plan on behalf of an employee on account of an employee contribution made by such employee")
rule MatchingContribution401m4A(c: Contribution, ground: MatchingContributionGround401m4) strict {
    label en official "any of the three grounds";
    when employer_dc_contribution_on_account_of(c, ground);
    then matching_contribution_401m4A(c);
}

pub relation contribution_electable_in_cash(c: Contribution) kind empirical {
    label en unofficial "the employee may elect to have the contribution paid in cash instead of contributed to the plan, case-asserted";
}

pub relation contribution_meets_401k2B_and_C(c: Contribution) kind empirical {
    label en unofficial "the requirements of section 401(k)(2)(B) and (C) are met for the contribution (distribution limits and nonforfeitability), case-asserted";
}

pub relation employer_contribution_not_matching(c: Contribution) kind empirical {
    label en unofficial "the employer contribution is not a matching contribution, case-asserted";
}

pub relation qualified_nonelective_contribution_401m4C(c: Contribution) kind institutional {
    label en official "section 401(m)(4)(C): a non-matching employer contribution the employee cannot take in cash and that meets section 401(k)(2)(B) and (C)";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "The term \"qualified nonelective contribution\" means any employer contribution (other than a matching contribution) with respect to which")
rule QualifiedNonelectiveContribution401m4C(c: Contribution) strict {
    label en official "(i) and (ii)";
    when employer_contribution_not_matching(c)
        and not_known(contribution_electable_in_cash(c))
        and contribution_meets_401k2B_and_C(c);
    then qualified_nonelective_contribution_401m4C(c);
}

pub relation student_loan_payments_for_year(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "payments by the employee in repayment of a qualified education loan for the year, case-asserted (section 401(m)(4)(D))";
}

pub relation employee_compensation_415c3(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's compensation as defined in section 415(c)(3), case-asserted";
}

pub relation employee_elective_deferrals_for_year(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's elective deferrals for the year, case-asserted";
}

pub relation employee_certified_student_loan_payment(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee certifies annually to the employer that the payment has been made on the loan, case-asserted (401(m)(4)(D)(ii))";
}

pub relation qualified_student_loan_payment_limit(employee: Person, y: TaxableYear, limit: Money) kind institutional {
    label en official "section 401(m)(4)(D)(i): the section 402(g) limitation (or, if less, compensation) reduced by the employee's elective deferrals";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "the limitation applicable under section 402(g) for the year (or, if lesser, the employee's compensation (as defined in section 415(c)(3)) for the year), reduced by")
rule QualifiedStudentLoanPaymentLimit(employee: Person, y: TaxableYear, comp: Money, deferrals: Money) strict {
    label en official "min(402(g) limit, compensation) - elective deferrals, floored at zero";
    when employee_compensation_415c3(employee, y, comp) and employee_elective_deferrals_for_year(employee, y, deferrals);
    then qualified_student_loan_payment_limit(employee, y, max(min(ELECTIVE_DEFERRAL_LIMIT + 0.00 USD, comp) - deferrals, 0.00 USD));
}

pub relation qualified_student_loan_payment_counted(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(m)(4)(D): the payments count only up to the limit and only with the annual certification";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "if the employee certifies annually to the employer making the matching contribution under this paragraph that such payment has been made on such loan")
rule QualifiedStudentLoanPaymentCounted(employee: Person, plan: Plan, y: TaxableYear, paid: Money, limit: Money) strict {
    label en official "counted = min(payments, limit) with the certification";
    when student_loan_payments_for_year(employee, plan, y, paid)
        and qualified_student_loan_payment_limit(employee, y, limit)
        and employee_certified_student_loan_payment(employee, plan, y);
    then qualified_student_loan_payment_counted(employee, plan, y, min(paid, limit));
}

pub relation employee_may_make_or_receive_under_plan(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee is eligible to make an employee contribution (or elective contribution if taken into account) or to receive a matching contribution under the plan tested, case-asserted";
}

pub relation employee_contribution_required_for_participation(plan: Plan) kind empirical {
    label en unofficial "an employee contribution is required as a condition of participation, case-asserted (401(m)(5)(B))";
}

pub relation employee_would_participate_if_contributed(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee would be a participant if he made the required contribution, case-asserted";
}

pub relation eligible_employee_401m5(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(m)(5): an employee eligible to contribute or receive a match is an eligible employee; one who would participate if he contributed is an eligible employee with no employer contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "Any employee who is eligible to make an employee contribution (or, if the employer takes elective contributions into account, elective contributions) or to receive a matching contribution under the plan being tested under paragraph (1) shall be considered an eligible employee")
rule EligibleEmployee401m5A(employee: Person, plan: Plan) strict {
    label en official "(A)";
    when employee_may_make_or_receive_under_plan(employee, plan);
    then eligible_employee_401m5(employee, plan);
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "any employee who would be a participant in the plan if such employee made such a contribution shall be treated as an eligible employee on behalf of whom no employer contributions are made")
rule EligibleEmployee401m5B(employee: Person, plan: Plan) strict {
    label en official "(B)";
    when employee_contribution_required_for_participation(plan) and employee_would_participate_if_contributed(employee, plan);
    then eligible_employee_401m5(employee, plan);
}

// (m)(6) Correction of excess aggregate contributions -----------------------

pub relation hce_matching_and_employee_contributions(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate matching and employee contributions (and any QNEC or elective contribution taken into account) made on behalf of highly compensated employees, case-asserted (401(m)(6)(B)(i))";
}

pub relation max_permitted_acp(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the maximum amount permitted under the limitations of paragraph (2)(A), after reducing HCE contributions in order of contribution percentage, case-asserted (401(m)(6)(B)(ii); the ordered leveling-down is the ADP-side gap of module 03)";
}

pub relation excess_aggregate_contributions_amount(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(m)(6)(B): HCE contributions over the maximum permitted";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "the term \"excess aggregate contributions\" means, with respect to any plan year, the excess of")
rule ExcessAggregateContributionsAmount(plan: Plan, y: TaxableYear, hce: Money, permitted: Money) strict {
    label en official "hce - permitted when positive";
    when hce_matching_and_employee_contributions(plan, y, hce) and max_permitted_acp(plan, y, permitted) and hce > permitted;
    then excess_aggregate_contributions_amount(plan, y, hce - permitted);
}

pub relation excess_aggregate_contributions_distributed(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the excess aggregate contributions (and allocable income through the end of the year) were distributed or, if forfeitable, forfeited, case-asserted";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "before the close of the following plan year, the amount of the excess aggregate contributions for such plan year")
rule ExcessAggregateContributionsDuty(plan: Plan, y: TaxableYear, employer: Person, end: Date, amount: Money) strict {
    label en official "the employer must distribute or forfeit the excess before the close of the following plan year (12 calendar months after the plan year end)";
    when excess_aggregate_contributions_amount(plan, y, amount)
        and plan_year_ends(plan, y, end)
        and plan_sponsor(plan, employer);
    then duty ExcessAggregateContributionsDutyPosition {
        bearer employer;
        beneficiary employer;
        goal achievement {
            condition excess_aggregate_contributions_distributed(plan, y);
            window [-infinity, add_calendar_period(end, 12 calendar_month)];
        }
    };
}

pub relation distribution_of_excess_aggregate_contributions(d: Distribution) kind empirical {
    label en unofficial "the distribution is of excess aggregate contributions required under paragraph (6), case-asserted";
}

pub relation section_72t_tax_inapplicable_401m7A(d: Distribution) kind institutional {
    label en official "section 401(m)(7)(A): no section 72(t) tax on an amount required to be distributed under paragraph (6)";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 72(t) on any amount required to be distributed under paragraph (6).")
rule Section72tInapplicable401m7A(d: Distribution) strict {
    label en official "exemption from the early distribution tax";
    when distribution_of_excess_aggregate_contributions(d);
    then section_72t_tax_inapplicable_401m7A(d);
}

pub relation distribution_attributable_to_employee_contributions(d: Distribution, total: Money, income: Money) kind empirical {
    label en unofficial "a distribution attributable to employee contributions, with the part attributable to income on those contributions, case-asserted";
}

pub relation includible_portion_401m7B(d: Distribution, amount: Money) kind institutional {
    label en official "section 401(m)(7)(B): a distribution attributable to employee contributions is not included in gross income except the income on those contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "Any distribution attributable to employee contributions shall not be included in gross income except to the extent attributable to income on such contributions.")
rule IncludiblePortion401m7B(d: Distribution, total: Money, income: Money) strict {
    label en official "includible = the income part only";
    when distribution_attributable_to_employee_contributions(d, total, income);
    then includible_portion_401m7B(d, income);
}

// (m)(10)-(13) Safe harbors and student loan matching ---------------------

pub relation plan_meets_simple401k_contribution_and_exclusive_and_vesting(plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: a plan meeting section 401(k)(11)(B) contributions, (11)(C) exclusive plan requirements and section 408(p)(3) vesting (read from the (k)(11) rules)";
}

rule PlanMeetsSimple401kThree(plan: Plan, y: TaxableYear) strict {
    label en unofficial "the (k)(11) satisfaction relation";
    when simple401k_satisfies_adp(plan, y);
    then plan_meets_simple401k_contribution_and_exclusive_and_vesting(plan, y);
}

pub relation acp_satisfied_by_simple_401m10(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(10): a plan meeting section 401(k)(11)(B), (C) and section 408(p)(3) is treated as meeting the ACP requirement for matching contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "A defined contribution plan shall be treated as meeting the requirements of paragraph (2) with respect to matching contributions if the plan")
rule AcpSatisfiedBySimple401m10(plan: Plan, y: TaxableYear) strict {
    label en official "(A)-(C) via the (k)(11) relation";
    when plan_meets_simple401k_contribution_and_exclusive_and_vesting(plan, y);
    then acp_satisfied_by_simple_401m10(plan, y);
}

pub relation safe_harbor_match_up_to_percent(plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "matching contributions are made only on employee contributions or elective deferrals up to this percentage of compensation, case-asserted (section 401(m)(11)(B)(i))";
}

pub relation match_rate_does_not_increase_with_deferral(plan: Plan) kind empirical {
    label en unofficial "the rate of the employer's matching contribution does not increase as the employee's rate increases, case-asserted ((B)(ii))";
}

pub relation hce_match_not_greater_than_nonhce(plan: Plan) kind empirical {
    label en unofficial "the match for a highly compensated employee at any rate is not greater than for a non-highly-compensated employee, case-asserted ((B)(iii))";
}

pub relation safe_harbor_match_limits_401m11B(plan: Plan) kind institutional {
    label en official "section 401(m)(11)(B): the match caps at 6 percent of compensation, does not increase with the deferral rate, and does not favor highly compensated employees";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "matching contributions on behalf of any employee may not be made with respect to an employee's contributions or elective deferrals in excess of 6 percent of the employee's compensation")
rule SafeHarborMatchLimits401m11B(plan: Plan, pct: Decimal) strict {
    label en official "exact boundary: 6.0 percent is allowed";
    when safe_harbor_match_up_to_percent(plan, pct)
        and pct <= 6.0
        and match_rate_does_not_increase_with_deferral(plan)
        and hce_match_not_greater_than_nonhce(plan);
    then safe_harbor_match_limits_401m11B(plan);
}

pub relation plan_meets_401k12_contributions_and_notice(plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: the plan meets section 401(k)(12)(B) or (C) contributions and the (D) notice (read from module 03's safe harbor relation)";
}

rule PlanMeets401k12ContributionsAndNotice(plan: Plan, y: TaxableYear) strict {
    label en unofficial "reads module 03's safe harbor classification";
    when safe_harbor_notice_and_matching_requirements_met(plan, y);
    then plan_meets_401k12_contributions_and_notice(plan, y);
}

pub relation acp_satisfied_by_safe_harbor_401m11(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(11): the ACP requirement is met by the (k)(12) contributions and notice together with the (B) limits";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "meets the notice requirements of subsection (k)(12)(D), and")
rule AcpSatisfiedBySafeHarbor401m11(plan: Plan, y: TaxableYear) strict {
    label en official "(i)-(iii)";
    when plan_meets_401k12_contributions_and_notice(plan, y) and safe_harbor_match_limits_401m11B(plan);
    then acp_satisfied_by_safe_harbor_401m11(plan, y);
}

pub relation plan_is_qualified_automatic_contribution_arrangement(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is a qualified automatic contribution arrangement (section 401(k)(13)) that meets the (k)(13)(E) notice requirements, case-asserted";
}

pub relation acp_satisfied_by_qaca_401m12(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(m)(12): a QACA meeting the notice requirements and paragraph (11)(B) is treated as meeting the ACP requirement for matching contributions";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "is a qualified automatic contribution arrangement (as defined in subsection (k)(13))")
rule AcpSatisfiedByQaca401m12(plan: Plan, y: TaxableYear) strict {
    label en official "(A)-(C)";
    when plan_is_qualified_automatic_contribution_arrangement(plan, y) and safe_harbor_match_limits_401m11B(plan);
    then acp_satisfied_by_qaca_401m12(plan, y);
}

pub relation slp_match_same_rate_as_deferral_match(plan: Plan) kind empirical {
    label en unofficial "matching on qualified student loan payments is at the same rate as on elective deferrals, case-asserted (401(m)(13)(A)(i))";
}

pub relation slp_match_only_for_otherwise_eligible(plan: Plan) kind empirical {
    label en unofficial "matching on qualified student loan payments only for employees otherwise eligible for a deferral match, case-asserted ((A)(ii))";
}

pub relation slp_match_all_deferral_match_eligible_covered(plan: Plan) kind empirical {
    label en unofficial "all employees eligible for a deferral match are eligible for a student loan match, case-asserted ((A)(iii))";
}

pub relation slp_match_vests_like_deferral_match(plan: Plan) kind empirical {
    label en unofficial "student loan matching contributions vest in the same manner as deferral matching contributions, case-asserted ((A)(iv))";
}

pub relation qualified_student_loan_match_treated_as_matching_401m13(plan: Plan) kind institutional {
    label en official "section 401(m)(13)(A): an employer contribution on account of a qualified student loan payment is treated as a matching contribution if the plan meets clauses (i)-(iv)";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "an employer contribution made to a defined contribution plan on account of a qualified student loan payment shall be treated as a matching contribution for purposes of this title if")
rule QualifiedStudentLoanMatchTreatedAsMatching401m13(plan: Plan) strict {
    label en official "all four plan-term conditions";
    when slp_match_same_rate_as_deferral_match(plan)
        and slp_match_only_for_otherwise_eligible(plan)
        and slp_match_all_deferral_match_eligible_covered(plan)
        and slp_match_vests_like_deferral_match(plan);
    then qualified_student_loan_match_treated_as_matching_401m13(plan);
}

pub relation employee_has_qualified_education_loan_debt(employee: Person) kind empirical {
    label en unofficial "the employee has debt incurred under a qualified education loan, case-asserted";
}

pub relation slp_match_available_to_employee(plan: Plan, employee: Person) kind institutional {
    label en official "section 401(m)(13)(B)(i): a student loan match is treated as available to an employee even without a qualified education loan";
}

@source(IRC_S401_M, relation = formalizes, coverage = exact, quote = "shall not fail to be treated as available to an employee solely because such employee does not have debt incurred under a qualified education loan")
rule SlpMatchAvailableToEmployee(plan: Plan, employee: Person) strict {
    label en official "availability does not depend on having the debt";
    when qualified_student_loan_match_treated_as_matching_401m13(plan) and participates_in(employee, plan);
    then slp_match_available_to_employee(plan, employee);
}
