// Sections 409 and 409A residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): section 409(b)(1),(3),(4), (d), (e)(4)-(5), (f)(2),
// (g), (h)(2)-(7), (j), (k), (l) employer securities, (m), (n) section 1042
// restrictions, (o), (p) S corporation ESOPs; 409A(a)(1)(A)(ii), (b)(2)-(5),
// (c), (d)(3),(5),(6).
//
// Pattern (modules 39/40): each statutory sentence is a conjunction of
// case-asserted facts producing a derived relation; percentages are exact
// cross-multiplications. Regulations of the Secretary and the cross-referenced
// definitions (sections 4975(e)(7), 318(a), 267) stay external.

// =====================================================================
// 409(b), (d), (e), (f), (g), (j), (k), (m)
// =====================================================================

use self::{
    Distribution,
    IRC_S409A_A,
    IRC_S409A_B,
    IRC_S409A_C,
    IRC_S409A_D,
    IRC_S409_B,
    IRC_S409_D,
    IRC_S409_E,
    IRC_S409_F,
    IRC_S409_G,
    IRC_S409_H,
    IRC_S409_J,
    IRC_S409_K,
    IRC_S409_L,
    IRC_S409_M,
    IRC_S409_N,
    IRC_S409_O,
    IRC_S409_P,
    NonqualifiedDeferredCompensationPlan,
    Person,
    Plan,
    TaxableYear,
    deemed_owned_shares_409p,
    esop_account_balance_409o1C,
    person_family_deemed_owned_shares_409p,
    tcesop_established_on_409f,
    tcesop_return_due_date_409f,
    total_deemed_owned_shares_409p,
};

pub relation tcesop_allocates_all_securities_409b1A(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan provides for the allocation for the plan year of all employer securities transferred to or purchased by it to the accounts of all participants entitled to share, case-asserted";
}

pub relation tcesop_allocation_requirement_409b1A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 409(b)(1)(A): allocation of all securities transferred or purchased to the participants' accounts for the plan year";
}

@source(IRC_S409_B, relation = formalizes, coverage = exact, quote = "the plan provides for the allocation for the plan year of all employer securities transferred to it or purchased by it")
rule TcesopAllocationRequirement409b1A(plan: Plan, y: TaxableYear) strict {
    label en official "full allocation";
    when tcesop_allocates_all_securities_409b1A(plan, y);
    then tcesop_allocation_requirement_409b1A(plan, y);
}

pub relation participant_compensation_415c3_409b3(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind empirical {
    label en unofficial "the participant's compensation within the meaning of section 415(c)(3) for the period, case-asserted";
}

pub relation compensation_for_409b_allocation_409b3(plan: Plan, y: TaxableYear, participant: Person, amount: Money) kind institutional {
    label en official "section 409(b)(3): the compensation paid to a participant for a period is the section 415(c)(3) compensation";
}

@source(IRC_S409_B, relation = formalizes, coverage = exact, quote = "the amount of compensation paid to a participant for any period is the amount of such participant's compensation (within the meaning of section 415(c)(3)) for such period")
rule CompensationFor409bAllocation409b3(plan: Plan, y: TaxableYear, participant: Person, amount: Money) strict {
    label en official "the 415(c)(3) amount";
    when participant_compensation_415c3_409b3(plan, y, participant, amount);
    then compensation_for_409b_allocation_409b3(plan, y, participant, amount);
}

pub relation tcesop_extended_allocation_credit_409b4(plan: Plan, y: TaxableYear, extended_over_years: Integer) kind empirical {
    label en unofficial "the allocation attributable to the basic employee plan credit or the credit under section 41 is extended over this number of years to comply with the limitations of section 415, case-asserted";
}

pub relation allocation_extension_needed_for_415_409b4(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the extension is necessary to comply with the limitations of section 415, case-asserted";
}

pub relation allocation_may_be_extended_409b4(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 409(b)(4): notwithstanding paragraph (1), the allocation attributable to the credit may be extended over whatever period is necessary to comply with section 415";
}

@source(IRC_S409_B, relation = formalizes, coverage = partial, quote = "may be extended over whatever period may be necessary to comply with th")
rule AllocationMayBeExtended409b4(plan: Plan, y: TaxableYear, years: Integer) strict {
    label en official "PARTIAL: the extension is permitted only as needed for section 415";
    when tcesop_extended_allocation_credit_409b4(plan, y, years)
        and allocation_extension_needed_for_415_409b4(plan, y);
    then allocation_may_be_extended_409b4(plan, y);
}

pub relation distribution_required_by_401a9_or_401a28_409d(d: Distribution) kind empirical {
    label en unofficial "the distribution is required under section 401(a)(9), or the distribution or reinvestment is required under section 401(a)(28), case-asserted";
}

pub relation esop_early_distribution_rule_inapplicable_409d(d: Distribution) kind institutional {
    label en official "section 409(d) last sentence: the subsection does not apply to a distribution required under section 401(a)(9) or a distribution or reinvestment required under section 401(a)(28)";
}

@source(IRC_S409_D, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any distribution required under section 401(a)(9) or to any distribution or reinvestment required under section 401(a)(28).")
rule EsopEarlyDistributionRuleInapplicable409d(d: Distribution) strict {
    label en official "required distributions";
    when distribution_required_by_401a9_or_401a28_409d(d);
    then esop_early_distribution_rule_inapplicable_409d(d);
}

pub enum SecurityRegistrationClass409e4 {
    RegisteredUnderSection12;
    WouldBeRegisteredButForExemption12g2H;
    Other;
}

pub relation employer_securities_class_409e4(plan: Plan, class: SecurityRegistrationClass409e4) kind empirical {
    label en unofficial "the registration class of the employer's securities, case-asserted";
}

pub relation employer_has_registration_type_class_409e4_detail(plan: Plan) kind institutional {
    label en official "section 409(e)(4): a class of securities required to be registered under section 12 of the Securities Exchange Act of 1934, or that would be so required except for the section 12(g)(2)(H) exemption";
}

@source(IRC_S409_E, relation = formalizes, coverage = exact, quote = "a class of securities required to be registered under section 12 of the Securities Exchange Act of 1934")
rule EmployerHasRegistrationTypeClassRegistered409e4(plan: Plan) strict {
    label en official "(A)";
    when employer_securities_class_409e4(plan, RegisteredUnderSection12);
    then employer_has_registration_type_class_409e4_detail(plan);
}

@source(IRC_S409_E, relation = formalizes, coverage = exact, quote = "a class of securities which would be required to be so registered except for the exemption from registration provided in subsection (g)(2)(H) of such section 12")
rule EmployerHasRegistrationTypeClassExempt409e4(plan: Plan) strict {
    label en official "(B)";
    when employer_securities_class_409e4(plan, WouldBeRegisteredButForExemption12g2H);
    then employer_has_registration_type_class_409e4_detail(plan);
}

pub relation plan_permits_each_participant_one_vote_409e5A(plan: Plan) kind empirical {
    label en unofficial "the plan permits each participant 1 vote with respect to the issue, case-asserted";
}

pub relation trustee_votes_shares_in_proportion_409e5B(plan: Plan) kind empirical {
    label en unofficial "the trustee votes the shares held by the plan in the proportion determined after the one-vote-per-participant rule, case-asserted";
}

pub relation plan_meets_409e3_for_issue_409e5(plan: Plan) kind institutional {
    label en official "section 409(e)(5): a plan meets the requirements of paragraph (3) with respect to an issue if each participant has 1 vote and the trustee votes the plan's shares in that proportion";
}

@source(IRC_S409_E, relation = formalizes, coverage = exact, quote = "the trustee votes the shares held by the plan in the proportion determined after application of subparagraph (A)")
rule PlanMeets409e3ForIssue409e5(plan: Plan) strict {
    label en official "both subparagraphs";
    when plan_permits_each_participant_one_vote_409e5A(plan)
        and trustee_votes_shares_in_proportion_409e5B(plan);
    then plan_meets_409e3_for_issue_409e5(plan);
}

pub relation plan_established_after_first_credit_year_409f2(plan: Plan) kind empirical {
    label en unofficial "the plan was not established by the close of the first taxable year for which an employee plan credit is claimed but by the return due date, and otherwise meets the section, case-asserted";
}

pub relation plan_not_failing_401a_for_late_establishment_409f2(plan: Plan) kind institutional {
    label en official "section 409(f)(2): a plan meeting the section is not considered to fail section 401(a) merely because it was established late (by the return due date)";
}

@source(IRC_S409_F, relation = formalizes, coverage = partial, quote = "shall not be considered to have failed to meet the requirements of section 401(a) merely because it was not established by the close of the first taxable year")
rule PlanNotFailing401aForLateEstablishment409f2(plan: Plan, on: Date, due: Date) strict {
    label en official "PARTIAL: established on or before the return due date (module 39 tests the date)";
    when plan_established_after_first_credit_year_409f2(plan)
        and tcesop_established_on_409f(plan, on)
        and tcesop_return_due_date_409f(plan, due)
        and on <= due;
    then plan_not_failing_401a_for_late_establishment_409f2(plan);
}

pub relation plan_provides_transferred_amounts_remain_409g(plan: Plan) kind empirical {
    label en unofficial "the plan provides that transferred amounts (because of section 48(n)(1) or 41(c)(1)(B)) remain in the plan and, if allocated, remain allocated, even though the employer credit is recaptured or redetermined, case-asserted";
}

pub relation plan_meets_409g_transfer_retention_409g(plan: Plan) kind institutional {
    label en official "section 409(g): the plan meets the requirement only if it provides that transferred amounts remain in the plan (and remain allocated)";
}

@source(IRC_S409_G, relation = formalizes, coverage = exact, quote = "A plan meets the requirement of this subsection only if it provides that amounts which are transferred to the plan")
rule PlanMeets409gTransferRetention409g(plan: Plan) strict {
    label en official "the retention term";
    when plan_provides_transferred_amounts_remain_409g(plan);
    then plan_meets_409g_transfer_retention_409g(plan);
}

pub relation contribution_conditioned_on_determination_409j1(plan: Plan) kind empirical {
    label en unofficial "the contribution to the plan is conditioned on a determination by the Secretary that the plan meets the section, case-asserted";
}

pub relation determination_application_filed_on_409j2(plan: Plan, filed_on: Date) kind empirical {
    label en unofficial "the date the application for the determination was filed, case-asserted";
}

pub relation employee_plan_credit_claimed_on_409j2(plan: Plan, claimed_on: Date) kind empirical {
    label en unofficial "the date the employee plan credit was claimed, case-asserted";
}

pub relation contribution_returned_within_year_409j3(plan: Plan) kind empirical {
    label en unofficial "the contribution is returned within 1 year after the Secretary's notice that the plan does not satisfy the section, case-asserted";
}

pub relation plan_not_failing_for_conditional_contribution_409j(plan: Plan) kind institutional {
    label en official "section 409(j): a plan is not treated as failing the requirements merely because of a contribution conditioned on the Secretary's determination, filed within 90 days of the credit claim, and returned within 1 year of an adverse notice";
}

@source(IRC_S409_J, relation = formalizes, coverage = exact, quote = "the application for a determination described in paragraph (1) is filed with the Secretary not later than 90 days after the date on which an employee plan credit is claimed")
rule PlanNotFailingForConditionalContribution409j(plan: Plan, filed: Date, claimed: Date) strict {
    label en official "exact boundary: 90 days after the claim is timely (day 91 is not)";
    when contribution_conditioned_on_determination_409j1(plan)
        and determination_application_filed_on_409j2(plan, filed)
        and employee_plan_credit_claimed_on_409j2(plan, claimed)
        and filed >= claimed
        and days_between(claimed, filed) <= 90
        and contribution_returned_within_year_409j3(plan);
    then plan_not_failing_for_conditional_contribution_409j(plan);
}

pub relation employer_withdrew_unmatched_or_excess_matching_credit_amount_409k(plan: Plan) kind empirical {
    label en unofficial "the employer withdrew an amount contributed for the matching employee plan credit that was not matched by employee contributions or exceeded the section 415 limitations, case-asserted";
}

pub relation withdrawal_does_not_make_benefits_forfeitable_409k(plan: Plan) kind institutional {
    label en official "section 409(k): such a withdrawal does not make the benefits forfeitable and the plan does not fail the exclusive benefit requirement";
}

@source(IRC_S409_K, relation = formalizes, coverage = exact, quote = "the withdrawal from a plan which otherwise meets the requirements of this section by the employer of an amount contributed for purposes of the matching employee plan credit shall not be considered to make the benefits forfeitable")
rule WithdrawalDoesNotMakeBenefitsForfeitable409k(plan: Plan) strict {
    label en official "unmatched or excess amounts";
    when employer_withdrew_unmatched_or_excess_matching_credit_amount_409k(plan);
    then withdrawal_does_not_make_benefits_forfeitable_409k(plan);
}

pub relation transfer_required_under_41c1B_or_48n1_409m(taxpayer: Person, amount: Money) kind empirical {
    label en unofficial "the amount of employer securities transferred to a tax credit employee stock ownership plan, required under section 41(c)(1)(B) or 48(n)(1)(A) or (B), case-asserted";
}

pub relation transfer_amount_without_recognition_409m(taxpayer: Person, amount: Money) kind institutional {
    label en official "section 409(m): no gain or loss is recognized on the transfer to the extent it is required";
}

@source(IRC_S409_M, relation = formalizes, coverage = exact, quote = "No gain or loss shall be recognized to the taxpayer with respect to the transfer of employer securities to a tax credit employee stock ownership plan")
rule TransferAmountWithoutRecognition409m(taxpayer: Person, amount: Money) strict {
    label en official "required transfer";
    when transfer_required_under_41c1B_or_48n1_409m(taxpayer, amount);
    then transfer_amount_without_recognition_409m(taxpayer, amount);
}

// =====================================================================
// 409(h) put options and distribution forms
// =====================================================================

pub relation plan_distributes_cash_or_securities_409h2A(plan: Plan) kind empirical {
    label en unofficial "under the plan the benefits may be distributed in cash or in the form of employer securities, case-asserted";
}

pub relation cash_or_security_distribution_permitted_409h2A(plan: Plan) kind institutional {
    label en official "section 409(h)(2)(A): distribution in cash or securities does not fail section 401(a)";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "shall not be considered to have failed to meet the requirements of section 401(a) merely because under the plan the benefits may be distributed in cash or in the form of employer securities")
rule CashOrSecurityDistributionPermitted409h2A(plan: Plan) strict {
    label en official "cash or securities";
    when plan_distributes_cash_or_securities_409h2A(plan);
    then cash_or_security_distribution_permitted_409h2A(plan);
}

pub relation employer_charter_restricts_ownership_to_employees_409h2Bii1(plan: Plan) kind empirical {
    label en unofficial "the employer's charter or bylaws restrict ownership of substantially all outstanding employer securities to employees or to a section 401(a) trust, case-asserted";
}

pub relation employer_is_s_corporation_409h2Bii2(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained by an S corporation, case-asserted";
}

pub relation plan_grants_cash_right_with_resale_409h2Bi(plan: Plan) kind empirical {
    label en unofficial "the plan gives the participant a right to receive the distribution in cash, with any employer securities distributed subject to resale to the employer on terms meeting paragraph (1)(B), case-asserted";
}

pub relation restricted_plan_may_omit_securities_demand_right_409h2B(plan: Plan) kind institutional {
    label en official "section 409(h)(2)(B): a plan of a restricted employer (or an S corporation) that gives a right to cash need not permit the securities demand right";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "merely because it does not permit a participant to exercise the right described in paragraph (1)(A) if such plan provides that the participant entitled to a distribution has a right to receive the distribution in cash")
rule RestrictedPlanMayOmitSecuritiesDemandRightRestricted409h2B(plan: Plan) strict {
    label en official "charter restriction";
    when employer_charter_restricts_ownership_to_employees_409h2Bii1(plan)
        and plan_grants_cash_right_with_resale_409h2Bi(plan);
    then restricted_plan_may_omit_securities_demand_right_409h2B(plan);
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "an S corporation")
rule RestrictedPlanMayOmitSecuritiesDemandRightSCorp409h2B(plan: Plan) strict {
    label en official "S corporation";
    when employer_is_s_corporation_409h2Bii2(plan)
        and plan_grants_cash_right_with_resale_409h2Bi(plan);
    then restricted_plan_may_omit_securities_demand_right_409h2B(plan);
}

pub relation plan_maintained_by_bank_prohibited_from_redeeming_409h3(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained by a bank (section 581) that is prohibited by law from redeeming or purchasing its own securities, case-asserted";
}

pub relation participants_have_right_to_cash_distribution_409h3(plan: Plan) kind empirical {
    label en unofficial "participants entitled to a distribution have a right to receive it in cash, case-asserted";
}

pub relation bank_plan_exempt_from_put_option_requirement_409h3(plan: Plan) kind institutional {
    label en official "section 409(h)(3): for a bank plan the paragraph (1)(B) put option requirement does not apply if participants have a right to a cash distribution";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "the requirements of paragraph (1)(B) shall not apply if the plan provides that participants entitled to a distribution from the plan shall have a right to receive a distribution in cash")
rule BankPlanExemptFromPutOptionRequirement409h3(plan: Plan) strict {
    label en official "bank plan with a cash right";
    when plan_maintained_by_bank_prohibited_from_redeeming_409h3(plan)
        and participants_have_right_to_cash_distribution_409h3(plan);
    then bank_plan_exempt_from_put_option_requirement_409h3(plan);
}

pub relation distribution_is_total_distribution_409h5(d: Distribution, within_one_taxable_year: Boolean) kind empirical {
    label en unofficial "the distribution is of the balance to the credit of the recipient's account within 1 taxable year (true) or in installments (false), case-asserted";
}

pub relation distribution_is_total_distribution_409h5_derived(d: Distribution) kind institutional {
    label en official "section 409(h)(5): a total distribution is the distribution within 1 taxable year of the balance to the credit of the recipient's account";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "the term \"total distribution\" means the distribution within 1 taxable year to the recipient of the balance to the credit of the recipient's account")
rule DistributionIsTotalDistribution409h5(d: Distribution) strict {
    label en official "within one taxable year";
    when distribution_is_total_distribution_409h5(d, true);
    then distribution_is_total_distribution_409h5_derived(d);
}

pub relation installment_repurchase_payment_days_after_put_409h6(plan: Plan, days: Integer) kind empirical {
    label en unofficial "the number of days after the exercise of the put option by which the amount for securities is paid, for an installment distribution, case-asserted";
}

pub relation installment_repurchase_requirement_met_409h6(plan: Plan) kind institutional {
    label en official "section 409(h)(6): for an installment distribution the paragraph (1)(B) requirement is met if the amount is paid not later than 30 days after the exercise of the put option";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "the requirements of paragraph (1)(B) shall be treated as met if the amount to be paid for the employer securities is paid not later than 30 days after the exercise of the put option")
rule InstallmentRepurchaseRequirementMet409h6(plan: Plan, days: Integer) strict {
    label en official "exact boundary: 30 days is timely, 31 is not";
    when installment_repurchase_payment_days_after_put_409h6(plan, days)
        and days <= 30;
    then installment_repurchase_requirement_met_409h6(plan);
}

pub relation portion_reinvested_under_401a28B_or_401a35_409h7(plan: Plan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the portion of the participant's account the employee elected to have reinvested under section 401(a)(28)(B) or (35)(B) or (C), case-asserted";
}

pub relation securities_demand_right_inapplicable_to_reinvested_portion_409h7(plan: Plan, participant: Person, amount: Money) kind institutional {
    label en official "section 409(h)(7): the right to demand securities does not apply to the diversified portion";
}

@source(IRC_S409_H, relation = formalizes, coverage = exact, quote = "Paragraph (1)(A) shall not apply with respect to the portion of the participant's account which the employee elected to have reinvested")
rule SecuritiesDemandRightInapplicableToReinvestedPortion409h7(plan: Plan, participant: Person, amount: Money) strict {
    label en official "the diversified portion";
    when portion_reinvested_under_401a28B_or_401a35_409h7(plan, participant, amount);
    then securities_demand_right_inapplicable_to_reinvested_portion_409h7(plan, participant, amount);
}

// =====================================================================
// 409(l) Employer securities
// =====================================================================

pub relation common_stock_issued_by_group_readily_tradable_409l1(stock: Person, issuer: Person) kind empirical {
    label en unofficial "the common stock is issued by the employer (or a member of the same controlled group) and is readily tradable on an established securities market, case-asserted";
}

pub relation employer_securities_409l(stock: Person) kind institutional {
    label en official "section 409(l): readily tradable common stock; or, absent it, common stock with the greatest combined voting power and dividend rights; noncallable convertible preferred stock; nonvoting common stock held 24 months";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "The term \"employer securities\" means common stock issued by the employer (or by a corporation which is a member of the same controlled group) which is readily tradable on an established securities market.")
rule EmployerSecuritiesReadilyTradable409l1(stock: Person, issuer: Person) strict {
    label en official "paragraph (1)";
    when common_stock_issued_by_group_readily_tradable_409l1(stock, issuer);
    then employer_securities_409l(stock);
}

pub relation common_stock_class_voting_power_409l2(stock: Person, voting: Decimal) kind empirical {
    label en unofficial "the common stock's voting power as a fraction of the greatest voting power of any class of common stock of the employer or group (1.00 = the greatest), case-asserted";
}

pub relation common_stock_class_dividend_rights_409l2(stock: Person, dividends: Decimal) kind empirical {
    label en unofficial "the common stock's dividend rights as a fraction of the greatest dividend rights of any class (1.00 = the greatest), case-asserted";
}

pub relation no_readily_tradable_common_stock_exists_409l2(issuer: Person) kind empirical {
    label en unofficial "no common stock of the employer or group meets the readily tradable requirement, case-asserted";
}

pub relation common_stock_issued_by_group_409l2(stock: Person, issuer: Person) kind empirical {
    label en unofficial "the common stock is issued by the employer (or a member of the same controlled group), case-asserted";
}

@source(IRC_S409_L, relation = formalizes, coverage = partial, quote = "having a combination of voting power and dividend rights equal to or in excess of")
rule EmployerSecuritiesSpecialRule409l2(stock: Person, issuer: Person, voting: Decimal, dividends: Decimal) strict {
    label en official "PARTIAL: with no readily tradable stock, a class whose voting power reaches that of the class with the greatest voting power and whose dividend rights reach the greatest dividend rights (both at 1.00 or more)";
    when no_readily_tradable_common_stock_exists_409l2(issuer)
        and common_stock_issued_by_group_409l2(stock, issuer)
        and common_stock_class_voting_power_409l2(stock, voting)
        and common_stock_class_dividend_rights_409l2(stock, dividends)
        and voting >= 1.00 and dividends >= 1.00;
    then employer_securities_409l(stock);
}

pub relation noncallable_convertible_preferred_409l3(stock: Person) kind empirical {
    label en unofficial "the stock is noncallable preferred (or with a reasonable opportunity to convert after a call), convertible at any time into stock meeting paragraph (1) or (2), case-asserted";
}

pub relation conversion_price_reasonable_at_acquisition_409l3(stock: Person) kind empirical {
    label en unofficial "the conversion price is reasonable as of the acquisition date by the tax credit employee stock ownership plan, case-asserted (an evaluative element)";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "Noncallable preferred stock shall be treated as employer securities if such stock is convertible at any time")
rule EmployerSecuritiesPreferred409l3(stock: Person) strict {
    label en official "paragraph (3)";
    when noncallable_convertible_preferred_409l3(stock)
        and conversion_price_reasonable_at_acquisition_409l3(stock);
    then employer_securities_409l(stock);
}

pub relation nonvoting_common_stock_held_months_409l5(stock: Person, months: Integer) kind empirical {
    label en unofficial "the nonvoting common stock of an employer described in the second sentence of section 401(a)(22), and the months the specific shares have been issued and outstanding, case-asserted";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "the specific shares that the plan acquires have been issued and outstanding for at least 24 months")
rule EmployerSecuritiesNonvoting409l5(stock: Person, months: Integer) strict {
    label en official "exact boundary: 24 months qualify, 23 do not";
    when nonvoting_common_stock_held_months_409l5(stock, months)
        and months >= 24;
    then employer_securities_409l(stock);
}

pub relation parent_direct_ownership_of_first_tier_409l4B(parent: Person, subsidiary: Person, voting_pct: Decimal, nonvoting_pct: Decimal) kind empirical {
    label en unofficial "the common parent's direct ownership of the first tier subsidiary: voting power of all classes and the least percentage of each class of nonvoting stock (0.50 = 50 percent), case-asserted";
}

pub relation subsidiary_treated_as_includible_409l4B(parent: Person, subsidiary: Person) kind institutional {
    label en official "section 409(l)(4)(B): the common parent owning at least 50 percent of the voting power and of each class of nonvoting stock of a first tier subsidiary makes that subsidiary (and those below it meeting the 80 percent test) includible";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "the common parent owns directly stock possessing at least 50 percent of the voting power of all classes of stock and at least 50 percent of each class of nonvoting stock in a first tier subsidiary")
rule SubsidiaryTreatedAsIncludible409l4B(parent: Person, subsidiary: Person, voting: Decimal, nonvoting: Decimal) strict {
    label en official "exact boundary: 50 percent is enough";
    when parent_direct_ownership_of_first_tier_409l4B(parent, subsidiary, voting, nonvoting)
        and voting >= 0.50 and nonvoting >= 0.50;
    then subsidiary_treated_as_includible_409l4B(parent, subsidiary);
}

pub relation second_tier_ownership_409l4C(parent: Person, first_tier: Person, second_tier: Person, parent_all_first_tier: Boolean, first_tier_voting_pct: Decimal, first_tier_nonvoting_pct: Decimal) kind empirical {
    label en unofficial "the common parent owns all voting and nonvoting stock of the first tier subsidiary, and the first tier owns this percentage of the voting power and the least percentage of each nonvoting class of the second tier subsidiary, case-asserted";
}

pub relation second_tier_subsidiary_treated_as_includible_409l4C(parent: Person, second_tier: Person) kind institutional {
    label en official "section 409(l)(4)(C): a wholly owned first tier subsidiary owning at least 50 percent of the voting power and of each nonvoting class of a second tier subsidiary makes that subsidiary includible";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "such second tier subsidiary (and all other corporations below it in the chain which would meet the 80 percent test of section 1563(a) if the second tier subsidiary were the common parent) shall be treated as includible corporations")
rule SecondTierSubsidiaryTreatedAsIncludible409l4C(parent: Person, first: Person, second: Person, voting: Decimal, nonvoting: Decimal) strict {
    label en official "100 percent of the first tier and at least 50 percent of the second tier";
    when second_tier_ownership_409l4C(parent, first, second, true, voting, nonvoting)
        and voting >= 0.50 and nonvoting >= 0.50;
    then second_tier_subsidiary_treated_as_includible_409l4C(parent, second);
}

pub relation controlled_group_1563a_without_a4_e3C_409l4A(a: Person, b: Person) kind empirical {
    label en unofficial "the corporations are a controlled group of corporations within the meaning of section 1563(a), determined without regard to subsections (a)(4) and (e)(3)(C), case-asserted";
}

pub relation controlled_group_of_corporations_409l4A(a: Person, b: Person) kind institutional {
    label en official "section 409(l)(4)(A): controlled group of corporations under section 1563(a) (without (a)(4) and (e)(3)(C))";
}

@source(IRC_S409_L, relation = formalizes, coverage = exact, quote = "the term \"controlled group of corporations\" has the meaning given to such term by section 1563(a)")
rule ControlledGroupOfCorporations409l4A(a: Person, b: Person) strict {
    label en official "cross-reference";
    when controlled_group_1563a_without_a4_e3C_409l4A(a, b);
    then controlled_group_of_corporations_409l4A(a, b);
}

// =====================================================================
// 409(n) Section 1042 restrictions
// =====================================================================

pub relation taxpayer_elected_1042a_409n1A(person: Person) kind empirical {
    label en unofficial "the person is a taxpayer who made an election under section 1042(a) with respect to employer securities, case-asserted";
}

pub relation related_to_taxpayer_267b_409n1A(person: Person, taxpayer: Person) kind empirical {
    label en unofficial "the individual is related to the taxpayer within the meaning of section 267(b), case-asserted";
}

pub relation lineal_descendant_of_taxpayer_409n3Ai(person: Person, taxpayer: Person) kind empirical {
    label en unofficial "the individual is a lineal descendant of the taxpayer, case-asserted";
}

pub relation lineal_descendants_allocation_within_5_percent_409n3Aii(taxpayer: Person) kind empirical {
    label en unofficial "the aggregate amount allocated to all such lineal descendants during the nonallocation period does not exceed 5 percent of the employer securities attributable to a section 1042 sale by a related person, case-asserted";
}

pub relation excluded_person_during_nonallocation_period_409n1A(person: Person, taxpayer: Person) kind institutional {
    label en official "section 409(n)(1)(A) and (3)(A): the electing taxpayer and persons related under section 267(b) (except lineal descendants within the 5 percent limit) may not benefit during the nonallocation period";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "any taxpayer who makes an election under section 1042(a) with respect to employer securities")
rule ExcludedPersonElectingTaxpayer409n1A(person: Person) strict {
    label en official "(i) the electing taxpayer";
    when taxpayer_elected_1042a_409n1A(person);
    then excluded_person_during_nonallocation_period_409n1A(person, person);
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "any individual who is related to the taxpayer (within the meaning of section 267(b))")
rule ExcludedPersonRelated409n1A(person: Person, taxpayer: Person) strict {
    label en official "(ii) a related individual, not excepted as a lineal descendant within the 5 percent limit";
    when related_to_taxpayer_267b_409n1A(person, taxpayer)
        and not_known(lineal_descendant_within_limit_409n3A(person, taxpayer));
    then excluded_person_during_nonallocation_period_409n1A(person, taxpayer);
}

pub relation lineal_descendant_within_limit_409n3A(person: Person, taxpayer: Person) kind institutional {
    label en official "section 409(n)(3)(A): paragraph (1)(A)(ii) does not apply to a lineal descendant if the aggregate allocated to all such descendants stays within 5 percent";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "the aggregate amount allocated to the benefit of all such lineal descendants during the nonallocation period does not exceed more than 5 percent")
rule LinealDescendantWithinLimit409n3A(person: Person, taxpayer: Person) strict {
    label en official "descendant and the aggregate within 5 percent";
    when lineal_descendant_of_taxpayer_409n3Ai(person, taxpayer)
        and lineal_descendants_allocation_within_5_percent_409n3Aii(taxpayer);
    then lineal_descendant_within_limit_409n3A(person, taxpayer);
}

pub relation person_fails_25_percent_limit_within_1_year_before_sale_409n3Bi(person: Person) kind empirical {
    label en unofficial "the person fails the 25 percent stock ownership limitation at any time during the 1-year period ending on the date of sale of qualified securities, case-asserted";
}

pub relation person_fails_25_percent_limit_on_allocation_date_409n3Bii(person: Person) kind empirical {
    label en unofficial "the person fails the limitation on the date qualified securities are allocated, case-asserted";
}

pub relation person_treated_as_failing_25_percent_limit_409n3B(person: Person) kind institutional {
    label en official "section 409(n)(3)(B): a person fails the 25 percent limitation if it fails it at any time in the year before the sale or on the allocation date";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "at any time during the 1-year period ending on the date of sale of qualified securities to the plan or cooperative")
rule PersonTreatedAsFailing25PercentLimitBeforeSale409n3B(person: Person) strict {
    label en official "(i)";
    when person_fails_25_percent_limit_within_1_year_before_sale_409n3Bi(person);
    then person_treated_as_failing_25_percent_limit_409n3B(person);
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "on the date as of which qualified securities are allocated to participants in the plan or cooperative")
rule PersonTreatedAsFailing25PercentLimitOnAllocation409n3B(person: Person) strict {
    label en official "(ii)";
    when person_fails_25_percent_limit_on_allocation_date_409n3Bii(person);
    then person_treated_as_failing_25_percent_limit_409n3B(person);
}

pub relation plan_fails_409n1_allocation_409n2(person: Person, amount: Money) kind empirical {
    label en unofficial "the plan allocated an amount to the account of the person in violation of paragraph (1), case-asserted";
}

pub relation treated_as_distributed_by_409n2A(person: Person, amount: Money) kind institutional {
    label en official "section 409(n)(2)(A): the plan is treated as having distributed the violating allocation to the person at the time of the allocation";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "the plan shall be treated as having distributed to the person described in paragraph (1) the amount allocated to the account of such person in violation of paragraph (1) at the time of such allocation")
rule TreatedAsDistributedBy409n2A(person: Person, amount: Money) strict {
    label en official "violating allocation";
    when plan_fails_409n1_allocation_409n2(person, amount);
    then treated_as_distributed_by_409n2A(person, amount);
}

pub relation first_1042_allocation_on_409n2Ci(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date of the first allocation of employer securities in connection with a section 1042 sale, case-asserted";
}

pub relation secretary_notified_of_failure_on_409n2Cii(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the Secretary is notified of the failure, case-asserted";
}

pub relation assessment_period_4979A_earliest_end_409n2C(plan: Plan, on: Date) kind institutional {
    label en official "section 409(n)(2)(C): the assessment period for the section 4979A tax does not expire before 3 years from the later of the first allocation and the notification date";
}

@source(IRC_S409_N, relation = formalizes, coverage = exact, quote = "the statutory period for the assessment of any tax imposed by section 4979A shall not expire before the date which is 3 years from the later of")
rule AssessmentPeriod4979AEarliestEnd409n2C(plan: Plan, first: Date, notified: Date) strict {
    label en official "3 calendar years from the later date";
    when first_1042_allocation_on_409n2Ci(plan, first)
        and secretary_notified_of_failure_on_409n2Cii(plan, notified);
    then assessment_period_4979A_earliest_end_409n2C(plan, add_calendar_period(if first >= notified then first else notified, 3 calendar_year));
}

// =====================================================================
// 409(o), 409(p)
// =====================================================================

pub relation participant_separated_plan_year_end_409o1Aii(participant: Person, plan: Plan, end: Date) kind empirical {
    label en unofficial "the close of the plan year in which the participant otherwise separates from service, case-asserted";
}

pub relation participant_reemployed_before_required_start_409o1Aii(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the participant is reemployed by the employer before distribution is required to begin under the clause, case-asserted";
}

pub relation fifth_plan_year_distribution_start_deadline_409o1Aii(participant: Person, plan: Plan, deadline: Date) kind institutional {
    label en official "section 409(o)(1)(A)(ii): distribution commences not later than 1 year after the close of the 5th plan year following the plan year of separation (not if reemployed)";
}

@source(IRC_S409_O, relation = formalizes, coverage = partial, quote = "which is the 5th plan year following the plan year in which the participant otherwise separates from service")
rule FifthPlanYearDistributionStartDeadline409o1Aii(participant: Person, plan: Plan, end: Date) strict {
    label en official "PARTIAL: separation year end + 5 plan years + 1 year = 6 calendar years after the separation year end (plan years are 12-month years)";
    when participant_separated_plan_year_end_409o1Aii(participant, plan, end)
        and not_known(participant_reemployed_before_required_start_409o1Aii(participant, plan));
    then fifth_plan_year_distribution_start_deadline_409o1Aii(participant, plan, add_calendar_period(end, 6 calendar_year));
}

pub relation loan_proceeds_securities_balance_409o1B(participant: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "employer securities acquired with the proceeds of the section 404(a)(9) loan held for the participant's account, case-asserted";
}

pub relation loan_repaid_in_full_by_plan_year_end_409o1B(plan: Plan) kind empirical {
    label en unofficial "the loan has been repaid in full as of the close of the plan year, case-asserted";
}

pub relation account_balance_excluding_financed_securities_409o1B(participant: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 409(o)(1)(B): the account balance does not include securities acquired with loan proceeds until the close of the plan year in which the loan is repaid in full";
}

@source(IRC_S409_O, relation = formalizes, coverage = exact, quote = "the account balance of a participant shall not include any employer securities acquired with the proceeds of the loan described in section 404(a)(9) until the close of the plan year in which such loan is repaid in full")
rule AccountBalanceExcludingFinancedSecurities409o1B(participant: Person, plan: Plan, balance: Money, financed: Money) strict {
    label en official "balance - financed securities while the loan is outstanding";
    when esop_account_balance_409o1C(participant, plan, balance)
        and loan_proceeds_securities_balance_409o1B(participant, plan, financed)
        and not_known(loan_repaid_in_full_by_plan_year_end_409o1B(plan));
    then account_balance_excluding_financed_securities_409o1B(participant, plan, max(0 USD, balance - financed));
}

pub relation excise_tax_reference_409p2b(plan: Plan) kind institutional {
    label en official "section 409(p)(2)(B): a cross-reference to section 4979A for the excise tax on violations and synthetic equity";
}

pub relation family_attribution_rule_409p3Bi(person: Person, other: Person) kind empirical {
    label en unofficial "the other person is a member of the individual's family as defined in paragraph (4)(D), case-asserted (the section 318(a)(1) attribution includes them and section 318(a)(4) does not apply)";
}

pub relation member_of_family_409p4D(person: Person, other: Person, kind: Integer) kind empirical {
    label en unofficial "the relationship (1 = spouse, 2 = ancestor or lineal descendant of the individual or spouse, 3 = brother or sister of the individual or spouse or their lineal descendant, 4 = spouse of a person of kind 2 or 3), case-asserted";
}

pub relation legally_separated_by_decree_409p4D(person: Person, other: Person) kind empirical {
    label en unofficial "the spouse is legally separated from the individual under a decree of divorce or separate maintenance, case-asserted";
}

pub relation family_member_for_409p4D(person: Person, other: Person) kind institutional {
    label en official "section 409(p)(4)(D): the spouse, ancestors and lineal descendants, siblings and their lineal descendants, and the spouses of those; a legally separated spouse is not a spouse";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "the term \"member of the family\" means, with respect to any individual")
rule FamilyMemberFor409p4D(person: Person, other: Person, kind: Integer) strict {
    label en official "kinds 1 to 4, excluding a legally separated spouse (kind 1)";
    when member_of_family_409p4D(person, other, kind)
        and kind >= 1 and kind <= 4
        and not_known(legally_separated_by_decree_409p4D(person, other));
    then family_member_for_409p4D(person, other);
}

pub relation family_member_of_disqualified_person_deemed_shares_409p4B(person: Person, other: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 409(p)(4)(B): a family member with deemed-owned shares of a disqualified person described in (A)(i) is a disqualified person";
}

pub relation deemed_shares_positive_409p4B(other: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: the person has deemed-owned shares";
}

rule DeemedSharesPositive409p4B(other: Person, plan: Plan, y: TaxableYear, shares: Integer) strict {
    label en unofficial "derives the helper";
    when deemed_owned_shares_409p(other, plan, y, shares) and shares > 0;
    then deemed_shares_positive_409p4B(other, plan, y);
}

pub relation disqualified_by_family_aggregate_409p4Ai(person: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en unofficial "helper: the person is disqualified through clause (i) (family aggregate of at least 20 percent)";
}

rule DisqualifiedByFamilyAggregate409p4Ai(person: Person, plan: Plan, y: TaxableYear, family: Integer, total: Integer) strict {
    label en unofficial "derives the helper";
    when person_family_deemed_owned_shares_409p(person, plan, y, family)
        and total_deemed_owned_shares_409p(plan, y, total)
        and total > 0
        and family * 100 >= total * 20;
    then disqualified_by_family_aggregate_409p4Ai(person, plan, y);
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "any member of such person's family with deemed-owned shares shall be treated as a disqualified person if not otherwise treated as a disqualified person under subparagraph (A)")
rule FamilyMemberOfDisqualifiedPersonDeemedShares409p4B(person: Person, other: Person, plan: Plan, y: TaxableYear) strict {
    label en official "family member with deemed-owned shares of a person disqualified by clause (i)";
    when disqualified_by_family_aggregate_409p4Ai(person, plan, y)
        and family_member_for_409p4D(person, other)
        and deemed_shares_positive_409p4B(other, plan, y);
    then family_member_of_disqualified_person_deemed_shares_409p4B(person, other, plan, y);
}

pub relation allocated_shares_409p4Ci(person: Person, plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the S corporation stock constituting employer securities allocated to the person under the plan, case-asserted";
}

pub relation unallocated_shares_held_by_plan_409p4Cii(plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the S corporation stock held by the plan but not allocated to participants, case-asserted";
}

pub relation most_recent_allocation_share_409p4Cii(person: Person, plan: Plan, y: TaxableYear, allocated_to_person: Integer, allocated_total: Integer) kind empirical {
    label en unofficial "the person's number of shares and the total shares in the most recent stock allocation under the plan, case-asserted";
}

pub relation deemed_owned_shares_computed_409p4C(person: Person, plan: Plan, y: TaxableYear, shares: Decimal) kind institutional {
    label en official "section 409(p)(4)(C): allocated shares plus the person's share of the unallocated shares, in the proportions of the most recent stock allocation (whole shares, rounded down: JUDGMENT CALL)";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "the amount of the unallocated stock which would be allocated to such person if the unallocated stock were allocated to all participants in the same proportions as the most recent stock allocation under the plan")
rule DeemedOwnedSharesComputed409p4C(person: Person, plan: Plan, y: TaxableYear, own: Integer, unalloc: Integer, mine: Integer, total: Integer) strict {
    label en official "own allocated + floor(unallocated x mine / total)";
    when allocated_shares_409p4Ci(person, plan, y, own)
        and unallocated_shares_held_by_plan_409p4Cii(plan, y, unalloc)
        and most_recent_allocation_share_409p4Cii(person, plan, y, mine, total)
        and total > 0;
    then deemed_owned_shares_computed_409p4C(person, plan, y, 1.0 * own + div_round(1.0 * unalloc * mine, 1.0 * total, 0, "FLOOR"));
}

pub relation synthetic_equity_shares_409p5(person: Person, plan: Plan, y: TaxableYear, shares: Integer) kind empirical {
    label en unofficial "the shares of stock on which the person's synthetic equity is based, case-asserted";
}

pub relation synthetic_equity_makes_person_disqualified_409p5A(person: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "treating the synthetic equity as outstanding stock and deemed-owned shares results in the person being a disqualified person or the year a nonallocation year (and it is not so treated without paragraph (5)), case-asserted";
}

pub relation synthetic_equity_treated_as_deemed_owned_409p5(person: Person, plan: Plan, y: TaxableYear, shares: Integer) kind institutional {
    label en official "section 409(p)(5): the shares underlying synthetic equity are treated as outstanding and deemed-owned if that results in a disqualified person or a nonallocation year";
}

@source(IRC_S409_P, relation = formalizes, coverage = partial, quote = "the shares of stock in such corporation on which such synthetic equity is based shall be treated as outstanding stock in such corporation and deemed-owned shares of such person")
rule SyntheticEquityTreatedAsDeemedOwned409p5(person: Person, plan: Plan, y: TaxableYear, shares: Integer) strict {
    label en official "PARTIAL: regulations may provide otherwise";
    when synthetic_equity_shares_409p5(person, plan, y, shares)
        and synthetic_equity_makes_person_disqualified_409p5A(person, plan, y);
    then synthetic_equity_treated_as_deemed_owned_409p5(person, plan, y, shares);
}

pub relation right_to_acquire_or_receive_stock_409p6c(item: Person) kind empirical {
    label en unofficial "the interest gives the holder the right to acquire or receive stock of the S corporation in the future (stock option, warrant, restricted stock, deferred issuance stock right, or similar), case-asserted";
}

pub relation right_to_future_cash_payment_based_on_stock_409p6c(item: Person) kind empirical {
    label en unofficial "the right is to a future cash payment based on the value of the stock or its appreciation (SAR, phantom stock unit), case-asserted";
}

pub relation synthetic_equity_409p6c(item: Person) kind institutional {
    label en official "section 409(p)(6)(C): a stock option, warrant, restricted stock, deferred issuance stock right or similar right to acquire stock; and, except as regulations provide, a stock appreciation right or phantom stock unit";
}

@source(IRC_S409_P, relation = formalizes, coverage = exact, quote = "gives the holder the right to acquire or receive stock of the S corporation in the future")
rule SyntheticEquityAcquire409p6c(item: Person) strict {
    label en official "rights to acquire or receive stock";
    when right_to_acquire_or_receive_stock_409p6c(item);
    then synthetic_equity_409p6c(item);
}

@source(IRC_S409_P, relation = formalizes, coverage = partial, quote = "synthetic equity also includes a stock appreciation right, phantom stock unit, or similar right to a future cash payment based on the value of such stock or appreciation in such value")
rule SyntheticEquityCashBased409p6c(item: Person) strict {
    label en official "PARTIAL: regulations may except";
    when right_to_future_cash_payment_based_on_stock_409p6c(item);
    then synthetic_equity_409p6c(item);
}

// =====================================================================
// 409A residuals
// =====================================================================

pub relation failure_relates_to_participants_409Aa1Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person) kind empirical {
    label en unofficial "the failure of the plan relates to this participant, case-asserted";
}

pub relation deferred_compensation_of_participant_409Aa1Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "all compensation deferred under the plan for the participant, case-asserted";
}

pub relation income_inclusion_covers_participant_409Aa1Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind institutional {
    label en official "section 409A(a)(1)(A)(ii): clause (i) applies only to all compensation deferred under the plan for participants to whom the failure relates";
}

@source(IRC_S409A_A, relation = formalizes, coverage = exact, quote = "Clause (i) shall only apply with respect to all compensation deferred under the plan for participants with respect to whom the failure relates.")
rule IncomeInclusionCoversParticipant409Aa1Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) strict {
    label en official "affected participants only";
    when failure_relates_to_participants_409Aa1Aii(plan, participant)
        and deferred_compensation_of_participant_409Aa1Aii(plan, participant, amount);
    then income_inclusion_covers_participant_409Aa1Aii(plan, participant, amount);
}

pub relation earnings_on_transferred_assets_409Ab4(plan: NonqualifiedDeferredCompensationPlan, y: TaxableYear, increase: Money, previously_included: Money) kind empirical {
    label en unofficial "the increase in value or earnings on assets treated as transferred under subsection (b) for the year, and the part previously included in income, case-asserted";
}

pub relation additional_transfer_of_property_409Ab4(plan: NonqualifiedDeferredCompensationPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(b)(4): the increase in value or earnings on set-aside assets is an additional transfer (to the extent not previously included in income)";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "any increase in value in, or earnings with respect to, such assets shall be treated as an additional transfer of property under this subsection (to the extent not previously included in income)")
rule AdditionalTransferOfProperty409Ab4(plan: NonqualifiedDeferredCompensationPlan, y: TaxableYear, increase: Money, prior: Money) strict {
    label en official "max(0, increase - previously included)";
    when earnings_on_transferred_assets_409Ab4(plan, y, increase, prior);
    then additional_transfer_of_property_409Ab4(plan, y, max(0 USD, increase - prior));
}

pub relation amounts_included_by_409Ab_for_year_409Ab5(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "amounts required to be included in gross income by reason of paragraph (1), (2) or (3) for the taxable year, case-asserted";
}

pub relation additional_tax_20_percent_409Ab5Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(b)(5)(A)(ii): an additional tax of 20 percent of the amounts required to be included in gross income";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "an amount equal to 20 percent of the amounts required to be included in gross income")
rule AdditionalTax20Percent409Ab5Aii(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "round(amount x 0.20, 2, HALF_UP)";
    when amounts_included_by_409Ab_for_year_409Ab5(plan, participant, y, amount);
    then additional_tax_20_percent_409Ab5Aii(plan, participant, y, round(amount * 0.20, 2, "HALF_UP"));
}

pub relation underpayment_rate_409Ab5B(y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the underpayment rate for the period (0.07 = 7 percent, an annual rate), case-asserted";
}

pub relation underpayments_that_would_have_occurred_409Ab5B(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, underpayment: Money, years: Decimal) kind empirical {
    label en unofficial "the underpayments that would have occurred had the amounts been includible in the first year deferred (or later the first year not subject to a substantial risk of forfeiture), and the years outstanding (one row per underpayment), case-asserted";
}

pub relation additional_interest_409Ab5B(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 409A(b)(5)(B): interest at the underpayment rate plus 1 percentage point on the underpayments (JUDGMENT CALL: simple interest by year fractions, HALF_UP)";
}

@source(IRC_S409A_B, relation = formalizes, coverage = partial, quote = "the amount of interest at the underpayment rate plus 1 percentage point on the underpayments")
rule AdditionalInterest409Ab5B(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear, under: Money, years: Decimal, rate: Decimal) strict {
    label en official "PARTIAL: one underpayment row: underpayment x (rate + 0.01) x years";
    when underpayments_that_would_have_occurred_409Ab5B(plan, participant, y, under, years)
        and underpayment_rate_409Ab5B(y, rate);
    then additional_interest_409Ab5B(plan, participant, y, round(under * (rate + 0.01) * years, 2, "HALF_UP"));
}

pub relation employer_pays_taxes_gross_up_409Ab3C(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the employer provides directly or indirectly for the payment of income taxes on compensation included under paragraph (3), case-asserted";
}

pub relation gross_up_treated_as_deferred_compensation_409Ab3C(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) kind institutional {
    label en official "section 409A(b)(3)(C)(i)-(ii): the tax payment bears interest and the additional tax as if part of the deferred compensation to which it relates";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "such payment shall be taken into account in determining the amount of the additional tax under subsection (a)(1)(B)(i)(II) in the same manner as if such payment was part of the deferred compensation to which it relates")
rule GrossUpTreatedAsDeferredCompensation409Ab3C(plan: NonqualifiedDeferredCompensationPlan, participant: Person, amount: Money) strict {
    label en official "clauses (i) and (ii)";
    when employer_pays_taxes_gross_up_409Ab3C(plan, participant, amount);
    then gross_up_treated_as_deferred_compensation_409Ab3C(plan, participant, amount);
}

pub relation covered_employee_162m3_or_16a_409Ab3Dii(person: Person, is_162m3: Boolean, is_16a: Boolean) kind empirical {
    label en unofficial "whether the individual is described in section 162(m)(3) and whether subject to section 16(a) of the Securities Exchange Act of 1934, case-asserted";
}

pub relation covered_employee_409Ab3Dii(person: Person) kind institutional {
    label en official "section 409A(b)(3)(D)(ii): an individual described in section 162(m)(3) or subject to section 16(a) of the Securities Exchange Act of 1934";
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "The term \"covered employee\" means an individual described in section 162(m)(3)")
rule CoveredEmployee162m409Ab3Dii(person: Person) strict {
    label en official "section 162(m)(3)";
    when covered_employee_162m3_or_16a_409Ab3Dii(person, true, _);
    then covered_employee_409Ab3Dii(person);
}

@source(IRC_S409A_B, relation = formalizes, coverage = exact, quote = "an individual subject to the requirements of section 16(a) of the Securities Exchange Act of 1934")
rule CoveredEmployee16a409Ab3Dii(person: Person) strict {
    label en official "section 16(a)";
    when covered_employee_162m3_or_16a_409Ab3Dii(person, _, true);
    then covered_employee_409Ab3Dii(person);
}

pub relation inclusion_earlier_under_other_provision_409Ac(plan: NonqualifiedDeferredCompensationPlan, participant: Person, other_year: TaxableYear, this_year: TaxableYear) kind empirical {
    label en unofficial "an amount is included in gross income under another provision or rule of law in another taxable year, and the taxable year under section 409A, case-asserted";
}

pub relation inclusion_year_no_inference_409Ac(plan: NonqualifiedDeferredCompensationPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 409A(c): the section does not prevent earlier inclusion under another provision, and no amount included under it is required to be included later under another provision";
}

@source(IRC_S409A_C, relation = formalizes, coverage = partial, quote = "Nothing in this section shall be construed to prevent the inclusion of amounts in gross income under any other provision of this chapter or any other rule of law earlier than the time provided in this section.")
rule InclusionYearNoInference409Ac(plan: NonqualifiedDeferredCompensationPlan, participant: Person, oy: TaxableYear, ty: TaxableYear) strict {
    label en official "PARTIAL: the year of inclusion is the earlier of the other-provision year and the section 409A year; the ordering of years is a case fact";
    when inclusion_earlier_under_other_provision_409Ac(plan, participant, oy, ty)
        and other_year_not_after_409A_year_409Ac(oy, ty);
    then inclusion_year_no_inference_409Ac(plan, participant, oy);
}

pub relation other_year_not_after_409A_year_409Ac(other_year: TaxableYear, this_year: TaxableYear) kind empirical {
    label en unofficial "the other provision's taxable year is not later than the section 409A year, case-asserted";
}

pub relation arrangement_includes_one_person_409Ad3(plan: Plan, persons: Integer) kind empirical {
    label en unofficial "the agreement or arrangement and the number of persons it includes, case-asserted";
}

pub relation plan_includes_single_person_arrangement_409Ad3(plan: Plan) kind institutional {
    label en official "section 409A(d)(3): a plan includes any agreement or arrangement, including one that includes one person";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "The term \"plan\" includes any agreement or arrangement, including an agreement or arrangement that includes one person.")
rule PlanIncludesSinglePersonArrangement409Ad3(plan: Plan, persons: Integer) strict {
    label en official "one or more persons";
    when arrangement_includes_one_person_409Ad3(plan, persons)
        and persons >= 1;
    then plan_includes_single_person_arrangement_409Ad3(plan);
}

pub relation deferred_compensation_amount_409Ad5(plan: Plan, participant: Person, compensation: Money, earnings: Money) kind empirical {
    label en unofficial "the deferred compensation and the income (actual or notional) attributable to it, case-asserted";
}

pub relation deferred_compensation_including_earnings_409Ad5(plan: Plan, participant: Person, amount: Money) kind institutional {
    label en official "section 409A(d)(5): references to deferred compensation include income attributable to it";
}

@source(IRC_S409A_D, relation = formalizes, coverage = exact, quote = "References to deferred compensation shall be treated as including references to income (whether actual or notional) attributable to such compensation or such income.")
rule DeferredCompensationIncludingEarnings409Ad5(plan: Plan, participant: Person, comp: Money, earn: Money) strict {
    label en official "compensation + earnings";
    when deferred_compensation_amount_409Ad5(plan, participant, comp, earn);
    then deferred_compensation_including_earnings_409Ad5(plan, participant, comp + earn);
}

pub relation group_treated_as_single_employer_414bc_409Ad6(a: Person, b: Person) kind empirical {
    label en unofficial "the persons are treated as a single employer under rules similar to section 414(b) and (c), case-asserted";
}

pub relation aggregated_as_one_employer_409Ad6(a: Person, b: Person) kind institutional {
    label en official "section 409A(d)(6): except as the Secretary provides, rules similar to section 414(b) and (c) apply";
}

@source(IRC_S409A_D, relation = formalizes, coverage = partial, quote = "Except as provided by the Secretary, rules similar to the rules of subsections (b) and (c) of section 414 shall apply.")
rule AggregatedAsOneEmployer409Ad6(a: Person, b: Person) strict {
    label en official "PARTIAL: the Secretary's exceptions are not pinned";
    when group_treated_as_single_employer_414bc_409Ad6(a, b);
    then aggregated_as_one_employer_409Ad6(a, b);
}
