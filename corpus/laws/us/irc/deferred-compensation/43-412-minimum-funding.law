// Section 412 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): the minimum
// funding standard. The module derives (a) when a plan is treated as
// satisfying the standard, (b) who pays, (c) the waiver conditions, the
// waived deficiency, the security threshold, the application deadline and
// the amendment limitation, (d)(2) retroactive amendments, and (e) the plans
// to which the section applies and those outside it.
//
// Method: amounts are exact Money comparisons; dates use exact calendar
// arithmetic (the IRC calendar-step policy is needed in a scenario); the
// minimum required contribution and the accumulated deficiencies are those
// derived elsewhere (modules 16, 18, 30-32) or asserted.

// =====================================================================
// (a) Satisfying the minimum funding standard
// =====================================================================

use self::{
    IRC_S412_A,
    IRC_S412_B,
    IRC_S412_C,
    IRC_S412_D,
    IRC_S412_E,
    Person,
    Plan,
    PlanKind412c1B,
    TaxableYear,
    church_plan_414e,
    governmental_plan_414d,
};

pub enum PlanFundingKind412 {
    SingleEmployerDefinedBenefit;
    MoneyPurchase;
    Multiemployer;
    CsecPlan;
}

pub relation plan_funding_kind_412(plan: Plan, kind: PlanFundingKind412) kind empirical {
    label en unofficial "the kind of plan for the minimum funding standard, case-asserted (section 412(a)(2))";
}

pub relation employer_contributions_for_year_412(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contributions the employer makes to or under the plan for the plan year, case-asserted";
}

pub relation minimum_required_contribution_for_412(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the minimum required contribution under section 430 for the plan year, case-asserted (the derivation is modules 16, 18 and 30)";
}

pub relation contributions_required_by_plan_terms_412(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contributions required under the terms of a money purchase plan, case-asserted ((a)(2)(B))";
}

pub relation accumulated_funding_deficiency_at_year_end_412(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the accumulated funding deficiency as of the end of the plan year under section 431 or 433 given the contributions, case-asserted ((a)(2)(C), (D))";
}

pub relation satisfies_minimum_funding_standard_412a(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(a): the plan satisfies the minimum funding standard for the year";
}

@source(IRC_S412_A, relation = formalizes, coverage = partial, quote = "a plan shall be treated as satisfying the minimum funding standard for a plan year if")
rule SatisfiesFundingStandardDefinedBenefit412a(plan: Plan, y: TaxableYear, paid: Money, required: Money) strict {
    label en official "PARTIAL: (A) a single-employer defined benefit plan pays at least the minimum required contribution, exact boundary: paying exactly the requirement satisfies it";
    when plan_funding_kind_412(plan, SingleEmployerDefinedBenefit)
        and employer_contributions_for_year_412(plan, y, paid)
        and minimum_required_contribution_for_412(plan, y, required)
        and paid >= required;
    then satisfies_minimum_funding_standard_412a(plan, y);
}

@source(IRC_S412_A, relation = formalizes, coverage = exact, quote = "in the case of a money purchase plan which is not a multiemployer plan, the employer makes contributions to or under the plan for the plan year which are required under the terms of the plan")
rule SatisfiesFundingStandardMoneyPurchase412a(plan: Plan, y: TaxableYear, paid: Money, required: Money) strict {
    label en official "(B): contributions at least those the plan terms require";
    when plan_funding_kind_412(plan, MoneyPurchase)
        and employer_contributions_for_year_412(plan, y, paid)
        and contributions_required_by_plan_terms_412(plan, y, required)
        and paid >= required;
    then satisfies_minimum_funding_standard_412a(plan, y);
}

@source(IRC_S412_A, relation = formalizes, coverage = exact, quote = "in the case of a multiemployer plan, the employers make contributions to or under the plan for any plan year which, in the aggregate, are sufficient to ensure that the plan does not have an accumulated funding deficiency under section 431 as of the end of the plan year")
rule SatisfiesFundingStandardMultiemployer412a(plan: Plan, y: TaxableYear, deficiency: Money) strict {
    label en official "(C): no accumulated funding deficiency at year end";
    when plan_funding_kind_412(plan, Multiemployer)
        and accumulated_funding_deficiency_at_year_end_412(plan, y, deficiency)
        and deficiency <= 0.00 USD;
    then satisfies_minimum_funding_standard_412a(plan, y);
}

@source(IRC_S412_A, relation = formalizes, coverage = exact, quote = "in the case of a CSEC plan, the employers make contributions to or under the plan for any plan year which, in the aggregate, are sufficient to ensure that the plan does not have an accumulated funding deficiency under section 433 as of the end of the plan year")
rule SatisfiesFundingStandardCsec412a(plan: Plan, y: TaxableYear, deficiency: Money) strict {
    label en official "(D): no accumulated funding deficiency at year end";
    when plan_funding_kind_412(plan, CsecPlan)
        and accumulated_funding_deficiency_at_year_end_412(plan, y, deficiency)
        and deficiency <= 0.00 USD;
    then satisfies_minimum_funding_standard_412a(plan, y);
}

// =====================================================================
// (b) Liability for contributions
// =====================================================================

pub relation employer_responsible_for_contributions_412b(plan: Plan, employer: Person) kind empirical {
    label en unofficial "the employer responsible for making contributions to or under the plan, case-asserted (section 412(b)(1))";
}

pub relation controlled_group_member_412b2(employer: Person, member: Person) kind empirical {
    label en unofficial "the member is in the same controlled group as the responsible employer, case-asserted ((b)(2), (d)(3))";
}

pub relation jointly_and_severally_liable_412b2(plan: Plan, member: Person) kind institutional {
    label en official "section 412(b)(2): each member of the responsible employer's controlled group is jointly and severally liable for the required contributions";
}

@source(IRC_S412_B, relation = formalizes, coverage = exact, quote = "each member of such group shall be jointly and severally liable for payment of such contributions")
rule JointlyAndSeverallyLiable412b2(plan: Plan, employer: Person, member: Person) strict {
    label en official "every controlled group member";
    when employer_responsible_for_contributions_412b(plan, employer) and controlled_group_member_412b2(employer, member);
    then jointly_and_severally_liable_412b2(plan, member);
}

rule ResponsibleEmployerLiable412b1(plan: Plan, employer: Person) strict {
    label en official "the responsible employer itself is liable";
    when employer_responsible_for_contributions_412b(plan, employer);
    then jointly_and_severally_liable_412b2(plan, employer);
}

// =====================================================================
// (c) Waiver
// =====================================================================

pub relation employers_unable_without_hardship_412c1Ai(plan: Plan, y: TaxableYear, unable: Integer, total: Integer) kind empirical {
    label en unofficial "the number of contributing employers unable to satisfy the standard without temporary substantial business hardship and the total number of employers (a single employer plan has 1 and 1), case-asserted (section 412(c)(1)(A)(i))";
}

pub relation plan_is_multiemployer_or_csec_412c(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan or a CSEC plan, case-asserted (the 10 percent rule applies)";
}

pub relation application_of_standard_adverse_to_participants_412c1Aii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "application of the standard would be adverse to the interests of plan participants in the aggregate, case-asserted ((A)(ii))";
}

pub relation waiver_conditions_present_412c1A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(c)(1)(A): the employer (or 10 percent or more of the employers of a multiemployer or CSEC plan) cannot meet the standard without hardship, and applying the standard would be adverse to participants in the aggregate";
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "an employer is (or in the case of a multiemployer plan or a CSEC plan, 10 percent or more of the number of employers contributing to or under the plan are) unable to satisfy the minimum funding standard for a plan year without temporary substantial business hardship")
rule WaiverConditionsPresentSingle412c1A(plan: Plan, y: TaxableYear, unable: Integer, total: Integer) strict {
    label en official "PARTIAL: (i) for a single employer plan, the employer is unable; (ii) adverse to participants; the Secretary's waiver itself is a discretionary act";
    when employers_unable_without_hardship_412c1Ai(plan, y, unable, total)
        and not_known(plan_is_multiemployer_or_csec_412c(plan))
        and unable >= 1
        and application_of_standard_adverse_to_participants_412c1Aii(plan, y);
    then waiver_conditions_present_412c1A(plan, y);
}

rule WaiverConditionsPresentMulti412c1A(plan: Plan, y: TaxableYear, unable: Integer, total: Integer) strict {
    label en official "PARTIAL: (i) for a multiemployer or CSEC plan: exact boundary by cross-multiplication: unable x 100 >= total x 10; (ii) adverse to participants";
    when employers_unable_without_hardship_412c1Ai(plan, y, unable, total)
        and plan_is_multiemployer_or_csec_412c(plan)
        and total > 0
        and unable * 100 >= total * 10
        and application_of_standard_adverse_to_participants_412c1Aii(plan, y);
    then waiver_conditions_present_412c1A(plan, y);
}

pub relation waiver_application_submitted_on_412c5(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the waiver application is submitted to the Secretary, case-asserted (section 412(c)(5)(A))";
}

pub relation plan_year_close_412c5(plan: Plan, y: TaxableYear, close: Date) kind empirical {
    label en unofficial "the close of the plan year, case-asserted";
}

pub relation waiver_application_timely_412c5A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(c)(5)(A): for a single-employer defined benefit plan the application is submitted not later than the 15th day of the 3rd month beginning after the close of the plan year";
}

@source(IRC_S412_C, relation = formalizes, coverage = exact, quote = "not later than the 15th day of the 3rd month beginning after the close of such plan year")
rule WaiverApplicationTimely412c5A(plan: Plan, y: TaxableYear, submitted: Date, close: Date) strict {
    label en official "exact boundary: the close date + 2 months + 15 days is the last day (for a December 31 close, March 15)";
    when waiver_application_submitted_on_412c5(plan, y, submitted)
        and plan_year_close_412c5(plan, y, close)
        and plan_funding_kind_412(plan, SingleEmployerDefinedBenefit)
        and submitted <= add_calendar_period(add_calendar_period(close, 2 calendar_month), 15 calendar_day);
    then waiver_application_timely_412c5A(plan, y);
}

pub relation unpaid_minimum_required_contributions_412c4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate unpaid minimum required contributions for the plan year and all preceding years (or the section 433 accumulated funding deficiency), case-asserted (section 412(c)(4)(C)(i)(I))";
}

pub relation waiver_amortization_installments_present_value_412c4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of all waiver amortization installments for the year and succeeding years, case-asserted ((C)(i)(II))";
}

pub relation extension_amounts_not_paid_412c4(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total amounts not paid by reason of an extension in effect under section 433(d), case-asserted ((C)(i)(III))";
}

pub relation security_requirement_applies_412c4(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(c)(4)(C)(i): the security and notice provisions do not apply when the sum of the three amounts is less than $1,000,000";
}

@source(IRC_S412_C, relation = formalizes, coverage = exact, quote = "is less than $1,000,000")
rule SecurityRequirementApplies412c4(plan: Plan, y: TaxableYear, unpaid: Money, pv: Money, ext: Money) strict {
    label en official "exact boundary: a sum of exactly $1,000,000 is not less than $1,000,000, so the provisions apply";
    when unpaid_minimum_required_contributions_412c4(plan, y, unpaid)
        and waiver_amortization_installments_present_value_412c4(plan, y, pv)
        and extension_amounts_not_paid_412c4(plan, y, ext)
        and unpaid + pv + ext >= 1000000.00 USD;
    then security_requirement_applies_412c4(plan, y);
}

pub relation waiver_in_effect_412c7(plan: Plan) kind empirical {
    label en unofficial "a waiver under this subsection or an extension under section 431(d) or 433(d) is in effect, case-asserted (section 412(c)(7)(A))";
}

pub relation liability_increasing_amendment_adopted_412c7(sponsor: Person, plan: Plan) kind empirical {
    label en unofficial "an amendment increasing liabilities through increased benefits, accrual changes or vesting changes is adopted, case-asserted";
}

pub relation amendment_is_exempt_412c7B(plan: Plan) kind empirical {
    label en unofficial "the amendment is de minimis (as the Secretary determines), only repeals a retroactive amendment, or is required as a condition of qualification, case-asserted ((c)(7)(B))";
}

pub relation adopts_liability_increasing_amendment_412c7(sponsor: Person, plan: Plan) kind institutional {
    label en official "action atom of the amendment prohibition";
}

pub relation plan_sponsor_412(plan: Plan, sponsor: Person) kind empirical {
    label en unofficial "the plan sponsor, case-asserted";
}

rule AdoptsLiabilityIncreasingAmendment412c7(sponsor: Person, plan: Plan) strict {
    label en unofficial "the action is realized when a non-exempt liability-increasing amendment is adopted";
    when liability_increasing_amendment_adopted_412c7(sponsor, plan) and not_known(amendment_is_exempt_412c7B(plan));
    then adopts_liability_increasing_amendment_412c7(sponsor, plan);
}

@source(IRC_S412_C, relation = formalizes, coverage = partial, quote = "No amendment of a plan which increases the liabilities of the plan by reason of any increase in benefits, any change in the accrual of benefits, or any change in the rate at which benefits become nonforfeitable under the plan shall be adopted if a waiver under this subsection or an extension of time under section 431(d) or section 433(d) is in effect with respect to the plan")
rule AmendmentProhibitionDuringWaiver412c7(sponsor: Person, plan: Plan) strict {
    label en official "PARTIAL: while a waiver or extension is in effect; the second limb (a reducing retroactive amendment made under (d)(2)) is not derived";
    when plan_sponsor_412(plan, sponsor) and waiver_in_effect_412c7(plan);
    then prohibition AmendIncreasingLiabilityDuringWaiver {
        bearer sponsor;
        action adopts_liability_increasing_amendment_412c7(sponsor, plan);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (d)(2) Retroactive amendments
// =====================================================================

pub relation amendment_adopted_on_412d2(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the amendment applying to the plan year is adopted, case-asserted (section 412(d)(2))";
}

pub relation plan_year_close_412d2(plan: Plan, y: TaxableYear, close: Date) kind empirical {
    label en unofficial "the close of the plan year, case-asserted";
}

pub relation amendment_no_reduction_of_accrued_benefit_412d2BC(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the amendment does not reduce any participant's accrued benefit at the beginning of the year and does not reduce it at adoption except as the circumstances require, case-asserted ((B), (C))";
}

pub relation amendment_deemed_made_first_day_412d2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 412(d)(2): a qualifying amendment adopted within 2 1/2 months after the close of the plan year (2 years for a multiemployer plan) is, at the administrator's election, deemed made on the first day of the plan year";
}

@source(IRC_S412_D, relation = formalizes, coverage = partial, quote = "is adopted after the close of such plan year but no later than 2½ months after the close of the plan year")
rule AmendmentDeemedMadeFirstDay412d2(plan: Plan, y: TaxableYear, adopted: Date, close: Date) strict {
    label en official "PARTIAL: (A) for a plan other than multiemployer: adopted after the close and by 2 months and 15 days after it; (B) and (C) as asserted; the administrator's election and the approval of a reducing amendment are not derived";
    when amendment_adopted_on_412d2(plan, y, adopted)
        and plan_year_close_412d2(plan, y, close)
        and amendment_no_reduction_of_accrued_benefit_412d2BC(plan, y)
        and not_known(multiemployer_412d2(plan))
        and adopted > close
        and adopted <= add_calendar_period(add_calendar_period(close, 2 calendar_month), 15 calendar_day);
    then amendment_deemed_made_first_day_412d2(plan, y);
}

pub relation multiemployer_412d2(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted";
}

rule AmendmentDeemedMadeFirstDayMulti412d2(plan: Plan, y: TaxableYear, adopted: Date, close: Date) strict {
    label en official "PARTIAL: (A) for a multiemployer plan: adopted after the close and by 2 years after it";
    when amendment_adopted_on_412d2(plan, y, adopted)
        and plan_year_close_412d2(plan, y, close)
        and amendment_no_reduction_of_accrued_benefit_412d2BC(plan, y)
        and multiemployer_412d2(plan)
        and adopted > close
        and adopted <= add_calendar_period(close, 2 calendar_year);
    then amendment_deemed_made_first_day_412d2(plan, y);
}

// =====================================================================
// (e) Plans to which the section applies
// =====================================================================

pub relation plan_included_trust_qualified_412e1A(plan: Plan) kind empirical {
    label en unofficial "the plan included a trust that qualified under section 401(a) (or was determined to have), case-asserted (section 412(e)(1)(A))";
}

pub relation plan_satisfied_403a_412e1B(plan: Plan) kind empirical {
    label en unofficial "the plan satisfied the requirements of section 403(a) (or was determined to have), case-asserted ((e)(1)(B))";
}

pub relation section_412_applicable_plan_412e1(plan: Plan) kind institutional {
    label en official "section 412(e)(1): the section applies to a plan that included a qualified trust or a section 403(a) plan, subject to the exclusions";
}

@source(IRC_S412_E, relation = formalizes, coverage = partial, quote = "such plan included a trust which qualified")
rule Section412ApplicableTrust412e1(plan: Plan) strict {
    label en official "PARTIAL: (A), when no exclusion applies; the effective date under ERISA is not gated";
    when plan_included_trust_qualified_412e1A(plan) and not_known(section_412_excluded_plan_412e2(plan));
    then section_412_applicable_plan_412e1(plan);
}

rule Section412Applicable403a412e1(plan: Plan) strict {
    label en official "PARTIAL: (B), when no exclusion applies";
    when plan_satisfied_403a_412e1B(plan) and not_known(section_412_excluded_plan_412e2(plan));
    then section_412_applicable_plan_412e1(plan);
}

pub relation profit_sharing_or_stock_bonus_plan_412e2A(plan: Plan) kind empirical {
    label en unofficial "the plan is a profit-sharing or stock bonus plan, case-asserted ((e)(2)(A))";
}

pub relation insurance_contract_plan_412e3(plan: Plan) kind institutional {
    label en official "section 412(e)(3): a plan funded exclusively by individual insurance contracts with level premiums, guaranteed benefits, paid premiums, no security interest and no policy loans";
}

pub relation church_plan_without_410d_election_412e2D(plan: Plan) kind empirical {
    label en unofficial "the church plan has no election under section 410(d), case-asserted ((e)(2)(D))";
}

pub relation plan_without_employer_contributions_since_1974_412e2E(plan: Plan) kind empirical {
    label en unofficial "the plan has not at any time after September 2, 1974 provided for employer contributions, case-asserted ((E))";
}

pub relation fraternal_society_plan_412e2F(plan: Plan) kind empirical {
    label en unofficial "the plan is established and maintained by a society, order or association described in section 501(c)(8) or (9), case-asserted ((F))";
}

pub relation section_412_excluded_plan_412e2(plan: Plan) kind institutional {
    label en official "section 412(e)(2): the section does not apply to profit-sharing or stock bonus plans, insurance contract plans, governmental plans, church plans without the election, plans without employer contributions since 1974, and society plans";
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "any profit-sharing or stock bonus plan")
rule Section412ExcludedProfitSharing412e2A(plan: Plan) strict {
    label en official "(A)";
    when profit_sharing_or_stock_bonus_plan_412e2A(plan);
    then section_412_excluded_plan_412e2(plan);
}

rule Section412ExcludedInsurance412e2B(plan: Plan) strict {
    label en official "(B), through paragraph (3)";
    when insurance_contract_plan_412e3(plan);
    then section_412_excluded_plan_412e2(plan);
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "any governmental plan (within the meaning of section 414(d))")
rule Section412ExcludedGovernmental412e2C(plan: Plan) strict {
    label en official "(C), through the section 414(d) classification of module 28";
    when governmental_plan_414d(plan);
    then section_412_excluded_plan_412e2(plan);
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "any church plan (within the meaning of section 414(e)) with respect to which the election provided by section 410(d) has not been made")
rule Section412ExcludedChurch412e2D(plan: Plan) strict {
    label en official "(D), through the section 414(e) classification of module 28";
    when church_plan_414e(plan) and church_plan_without_410d_election_412e2D(plan);
    then section_412_excluded_plan_412e2(plan);
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "any plan which has not, at any time after September 2, 1974, provided for employer contributions")
rule Section412ExcludedNoContributions412e2E(plan: Plan) strict {
    label en official "(E)";
    when plan_without_employer_contributions_since_1974_412e2E(plan);
    then section_412_excluded_plan_412e2(plan);
}

rule Section412ExcludedSociety412e2F(plan: Plan) strict {
    label en official "PARTIAL: (F); the condition on employer contributions is inside the asserted fact";
    when fraternal_society_plan_412e2F(plan);
    then section_412_excluded_plan_412e2(plan);
}

pub relation insurance_plan_individual_contracts_412e3A(plan: Plan) kind empirical {
    label en unofficial "the plan is funded exclusively by individual insurance contracts, case-asserted ((e)(3)(A))";
}

pub relation insurance_plan_level_premiums_412e3B(plan: Plan) kind empirical {
    label en unofficial "the contracts provide level annual premiums to retirement age from the date of participation, case-asserted ((B))";
}

pub relation insurance_plan_benefits_guaranteed_412e3C(plan: Plan) kind empirical {
    label en unofficial "the benefits equal the contract benefits at normal retirement age and are guaranteed by a licensed carrier to the extent premiums are paid, case-asserted ((C))";
}

pub relation insurance_plan_premiums_paid_412e3D(plan: Plan) kind empirical {
    label en unofficial "premiums for the plan year and all prior years have been paid before lapse or the policy is reinstated, case-asserted ((D))";
}

pub relation insurance_plan_security_interest_412e3E(plan: Plan) kind empirical {
    label en unofficial "some rights under the contracts were subject to a security interest during the plan year, case-asserted ((E))";
}

pub relation insurance_plan_policy_loans_412e3F(plan: Plan) kind empirical {
    label en unofficial "some policy loan is outstanding during the plan year, case-asserted ((F))";
}

@source(IRC_S412_E, relation = formalizes, coverage = exact, quote = "no policy loans are outstanding at any time during the plan year")
rule InsuranceContractPlan412e3(plan: Plan) strict {
    label en official "(A)-(F), the last two as absences";
    when insurance_plan_individual_contracts_412e3A(plan)
        and insurance_plan_level_premiums_412e3B(plan)
        and insurance_plan_benefits_guaranteed_412e3C(plan)
        and insurance_plan_premiums_paid_412e3D(plan)
        and not_known(insurance_plan_security_interest_412e3E(plan))
        and not_known(insurance_plan_policy_loans_412e3F(plan));
    then insurance_contract_plan_412e3(plan);
}
