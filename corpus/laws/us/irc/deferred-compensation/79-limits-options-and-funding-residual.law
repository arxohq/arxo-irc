// Residuals of sections 404A, 406/407, 411(d), 415, 418E, 421-424, 436 —
// STAGE 3b (deferred-compensation, TECH_GAP reduction, 26.09.2026). Same
// pattern as modules 61-78: each sentence is a conjunction of case-asserted
// facts producing a treatment relation; exact percentages and dollar figures;
// the Secretary's regulations are not pinned.

// =====================================================================
// 415 Limitations
// =====================================================================

use self::{
    EligibleRetirementPlanKind402,
    IRC_S404A_G,
    IRC_S407_B,
    IRC_S411_D,
    IRC_S415_B,
    IRC_S415_C,
    IRC_S415_F,
    IRC_S415_K,
    IRC_S418E_C,
    IRC_S418E_G,
    IRC_S421_C,
    IRC_S421_D,
    IRC_S422_C,
    IRC_S422_D,
    IRC_S423_B,
    IRC_S424_D,
    IRC_S436_D,
    Person,
    Plan,
    TaxableYear,
};

pub relation small_db_benefit_facts_415b4(participant: Person, y: TaxableYear, retirement_benefits_within_10000_test: Boolean, employer_never_maintained_dc_plan: Boolean) kind empirical {
    label en unofficial "the participant's benefits meet subparagraph (A) (not more than the $10,000 amount for the year and prior years) and the employer has never maintained a defined contribution plan in which the participant participated, case-asserted";
}

pub relation db_benefit_deemed_within_limit_415b4(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(4): benefits under a defined benefit plan are deemed not to exceed the limitation if subparagraphs (A) and (B) hold";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the employer has not at any time maintained a defined contribution plan in which the participant participated")
rule DbBenefitDeemedWithinLimit415b4(participant: Person, y: TaxableYear) strict {
    label en official "both subparagraphs";
    when small_db_benefit_facts_415b4(participant, y, true, true);
    then db_benefit_deemed_within_limit_415b4(participant, y);
}

pub enum ParticipationBasis415b5 {
    YearsOfParticipation;
    YearsOfService;
}

pub relation reduction_facts_415b5(participant: Person, y: TaxableYear, basis: ParticipationBasis415b5, years: Decimal, limitation: Money) kind empirical {
    label en unofficial "the basis (years of participation in the plan for subparagraph (A), years of service with the employer for the (1)(B) and (4) limitations under subparagraph (B)), the years (or part thereof), and the limitation before reduction, case-asserted";
}

pub relation reduced_limitation_415b5(participant: Person, y: TaxableYear, basis: ParticipationBasis415b5, amount: Money) kind institutional {
    label en official "section 415(b)(5): the limitation is multiplied by years over 10, but never reduced below 1/10 of the limitation";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "In no event shall subparagraph (A) or (B) reduce the limitations referred to in paragraphs (1) and (4) to an amount less than 1/10 of such limitation")
rule ReducedLimitation415b5(participant: Person, y: TaxableYear, basis: ParticipationBasis415b5, years: Decimal, limit: Money) strict {
    label en official "max(limit x 0.1, limit x min(1, years / 10)), rounded to cents HALF_UP";
    when reduction_facts_415b5(participant, y, basis, years, limit);
    then reduced_limitation_415b5(participant, y, basis, round(max(limit * 0.1, limit * min(1.0, years / 10.0)), 2, "HALF_UP"));
}

pub relation employer_dbs_treated_as_one_plan_415f1_facts(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the defined benefit plan (whether or not terminated) of the employer, case-asserted";
}

pub relation db_plans_treated_as_one_415f1A(employer: Person, plan: Plan) kind institutional {
    label en official "section 415(f)(1)(A): all defined benefit plans (whether or not terminated) of an employer are one defined benefit plan";
}

@source(IRC_S415_F, relation = formalizes, coverage = exact, quote = "all defined benefit plans (whether or not terminated) of an employer are to be treated as one defined benefit plan")
rule DbPlansTreatedAsOne415f1A(employer: Person, plan: Plan) strict {
    label en official "each such plan";
    when employer_dbs_treated_as_one_plan_415f1_facts(employer, plan);
    then db_plans_treated_as_one_415f1A(employer, plan);
}

pub enum PlanKind415k1 {
    AnnuityPlan403a;
    AnnuityContract403b;
    SimplifiedEmployeePension;
    Other;
}

pub relation plan_kind_415k1(plan: Plan, kind: PlanKind415k1) kind empirical {
    label en unofficial "the kind of plan: an annuity plan described in section 403(a), an annuity contract described in section 403(b), or a simplified employee pension, case-asserted";
}

pub relation treated_as_defined_contribution_plan_415k1(plan: Plan) kind institutional {
    label en official "section 415(k)(1): the annuity plan, annuity contract or simplified employee pension is a defined contribution plan for this section";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "an annuity plan described in section 403(a)")
rule DcPlanAnnuity403a415k1(plan: Plan) strict {
    label en official "(B)";
    when plan_kind_415k1(plan, AnnuityPlan403a);
    then treated_as_defined_contribution_plan_415k1(plan);
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "an annuity contract described in section 403(b)")
rule DcPlanAnnuity403b415k1(plan: Plan) strict {
    label en official "(C)";
    when plan_kind_415k1(plan, AnnuityContract403b);
    then treated_as_defined_contribution_plan_415k1(plan);
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "a simplified employee pension")
rule DcPlanSep415k1(plan: Plan) strict {
    label en official "(D)";
    when plan_kind_415k1(plan, SimplifiedEmployeePension);
    then treated_as_defined_contribution_plan_415k1(plan);
}

pub relation participant_control_403b_contract_415k4(participant: Person, employer: Person, contract: Plan, control_under_414b_or_c_as_modified_by_415h: Boolean) kind empirical {
    label en unofficial "the participant has the control required under section 414(b) or (c) as modified by subsection (h) over the employer, and the section 403(b) annuity contract, case-asserted";
}

pub relation contract_treated_as_dc_plan_maintained_by_employer_415k4(contract: Plan, employer: Person) kind institutional {
    label en official "section 415(k)(4): a section 403(b) annuity contract is a defined contribution plan maintained by each employer the participant controls";
}

@source(IRC_S415_K, relation = formalizes, coverage = partial, quote = "any annuity contract described in section 403(b) for the benefit of a participant shall be treated as a defined contribution plan maintained by each employer with respect to which the participant has the control required under subsection (b) or (c) of section 414")
rule ContractTreatedAsDcPlanMaintainedByEmployer415k4(participant: Person, employer: Person, contract: Plan) strict {
    label en official "PARTIAL: the simplified employee pension sentence is not modelled";
    when participant_control_403b_contract_415k4(participant, employer, contract, true);
    then contract_treated_as_dc_plan_maintained_by_employer_415k4(contract, employer);
}

pub relation governmental_repayment_facts_415k3(participant: Person, repayment: Money, refunded_upon_forfeiture_of_service_credit: Boolean, same_state_governmental_plan: Boolean) kind empirical {
    label en unofficial "the repayment (with interest) to the governmental plan of an amount previously refunded upon a forfeiture of service credit under the plan or another governmental plan of a State or local employer in the same State, case-asserted";
}

pub relation repayment_not_taken_into_account_415k3(participant: Person, repayment: Money) kind institutional {
    label en official "section 415(k)(3): such a repayment is not taken into account for purposes of this section";
}

@source(IRC_S415_K, relation = formalizes, coverage = exact, quote = "any such repayment shall not be taken into account for purposes of this section")
rule RepaymentNotTakenIntoAccount415k3(participant: Person, repayment: Money) strict {
    label en official "a refunded-service-credit repayment within the same State";
    when governmental_repayment_facts_415k3(participant, repayment, true, true);
    then repayment_not_taken_into_account_415k3(participant, repayment);
}

pub relation annual_additions_components_415c2(participant: Person, y: TaxableYear, employer_contributions: Money, employee_contributions_excluding_rollovers: Money, forfeitures: Money) kind empirical {
    label en unofficial "employer contributions, employee contributions determined without regard to rollover contributions and section 408(k)(6) SEP employee contributions, and forfeitures, case-asserted";
}

pub relation annual_additions_sum_415c2(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(c)(2): the annual additions are employer contributions, employee contributions and forfeitures";
}

@source(IRC_S415_C, relation = formalizes, coverage = partial, quote = "employee contributions under subparagraph (B) are determined without regard to any rollover contributions")
rule AnnualAdditionsSum415c2(participant: Person, y: TaxableYear, er: Money, ee: Money, fo: Money) strict {
    label en official "PARTIAL: the medical benefit sentence is not modelled; the sum of the three components";
    when annual_additions_components_415c2(participant, y, er, ee, fo);
    then annual_additions_sum_415c2(participant, y, er + ee + fo);
}

// =====================================================================
// 421-424 Statutory stock options
// =====================================================================

pub relation option_exercised_by_estate_facts_421c1(option: Person, exercised_after_death: Boolean, by_estate_or_heir: Boolean) kind empirical {
    label en unofficial "the option was exercised after the death of the employee by the estate or a person who acquired the right by bequest, inheritance or reason of death, case-asserted";
}

pub relation subsection_a_applies_as_if_by_decedent_421c1(option: Person) kind institutional {
    label en official "section 421(c)(1): subsection (a) applies as if the option had been exercised by the decedent";
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "the provisions of subsection (a) shall apply to the same extent as if the option had been exercised by the decedent")
rule SubsectionAAppliesAsIfByDecedent421c1(option: Person) strict {
    label en official "exercised after death by the estate or an heir";
    when option_exercised_by_estate_facts_421c1(option, true, true);
    then subsection_a_applies_as_if_by_decedent_421c1(option);
}

pub relation holding_period_and_employment_not_required_421c1A(option: Person) kind institutional {
    label en official "section 421(c)(1)(A): the holding period and employment requirements of sections 422(a) and 423(a) do not apply";
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "the holding period and employment requirements of sections 422(a) and 423(a) shall not apply")
rule HoldingPeriodAndEmploymentNotRequired421c1A(option: Person) strict {
    label en official "subparagraph (A)";
    when subsection_a_applies_as_if_by_decedent_421c1(option);
    then holding_period_and_employment_not_required_421c1A(option);
}

pub relation stock_transfer_by_estate_is_disposition_421c1B(option: Person) kind institutional {
    label en official "section 421(c)(1)(B): any transfer by the estate of stock acquired is a disposition for section 423(c)";
}

@source(IRC_S421_C, relation = formalizes, coverage = exact, quote = "any transfer by the estate of stock acquired shall be considered a disposition of such stock for purposes of section 423(c)")
rule StockTransferByEstateIsDisposition421c1B(option: Person) strict {
    label en official "subparagraph (B)";
    when subsection_a_applies_as_if_by_decedent_421c1(option);
    then stock_transfer_by_estate_is_disposition_421c1B(option);
}

pub relation certificate_of_divestiture_facts_421d(share: Person, transferred_to_eligible_person_1043b1: Boolean, disposed_under_certificate_1043b2: Boolean) kind empirical {
    label en unofficial "the share was transferred to an eligible person under section 1043(b)(1) on the exercise of an option and disposed of under a certificate of divestiture under section 1043(b)(2), case-asserted";
}

pub relation disposition_treated_as_meeting_holding_period_421d(share: Person) kind institutional {
    label en official "section 421(d): the disposition is treated as meeting the requirements of section 422(a)(1) or 423(a)(1)";
}

@source(IRC_S421_D, relation = formalizes, coverage = exact, quote = "such disposition shall be treated as meeting the requirements of section 422(a)(1) or 423(a)(1), whichever is applicable")
rule DispositionTreatedAsMeetingHoldingPeriod421d(share: Person) strict {
    label en official "both conditions";
    when certificate_of_divestiture_facts_421d(share, true, true);
    then disposition_treated_as_meeting_holding_period_421d(share);
}

pub relation insolvency_transfer_facts_422c3(share: Person, insolvent_individual: Boolean, transferred_to_fiduciary_in_proceeding: Boolean) kind empirical {
    label en unofficial "the individual is insolvent and the share is transferred to a trustee, receiver or similar fiduciary in a title 11 or similar insolvency proceeding, or for the benefit of creditors in it, case-asserted";
}

pub relation insolvency_transfer_not_a_disposition_422c3(share: Person) kind institutional {
    label en official "section 422(c)(3): the transfer is not a disposition for section 422(a)(1)";
}

@source(IRC_S422_C, relation = formalizes, coverage = exact, quote = "neither such transfer, nor any other transfer of such share for the benefit of his creditors in such proceeding, shall constitute a disposition of such share for purposes of subsection (a)(1)")
rule InsolvencyTransferNotADisposition422c3(share: Person) strict {
    label en official "insolvent individual, transfer in the proceeding";
    when insolvency_transfer_facts_422c3(share, true, true);
    then insolvency_transfer_not_a_disposition_422c3(share);
}

pub relation iso_first_exercisable_in_year_422d2(option: Person, holder: Person, y: Integer, granted_on: Date, stock_fmv: Money) kind empirical {
    label en unofficial "an incentive stock option of the holder exercisable for the first time in the calendar year, the grant date and the fair market value of the stock at grant, case-asserted";
}

pub relation iso_within_100000_in_order_granted_422d2(option: Person, holder: Person, y: Integer) kind institutional {
    label en official "section 422(d)(2): options are taken into account in the order granted; the options whose cumulative value is within $100,000 stay incentive stock options (JUDGMENT CALL: options granted on the same date are counted together)";
}

@source(IRC_S422_D, relation = formalizes, coverage = partial, quote = "Paragraph (1) shall be applied by taking options into account in the order in which they were granted")
rule IsoWithin100000InOrderGranted422d2(option: Person, holder: Person, y: Integer, g: Date, fmv: Money) strict {
    label en official "PARTIAL: cumulative fair market value up to and including the option's grant date, at most $100,000";
    when iso_first_exercisable_in_year_422d2(option, holder, y, g, fmv)
        and (sum all v: Money for o2: Person, g2: Date where iso_first_exercisable_in_year_422d2(o2, holder, y, g2, v) and g2 <= g) <= 100000.00 USD;
    then iso_within_100000_in_order_granted_422d2(option, holder, y);
}

pub relation option_accrual_facts_423b8(option: Person, y: Integer, fmv_at_grant_of_stock_first_exercisable: Money, carried_over_from_another_option: Boolean) kind empirical {
    label en unofficial "the fair market value (at grant) of stock the right to purchase which accrues in the calendar year under the option, and whether a right accrued under another option is carried over, case-asserted";
}

pub relation accrual_within_25000_per_calendar_year_423b8(option: Person, y: Integer) kind institutional {
    label en official "section 423(b)(8): the right to purchase stock accrues at a rate of not more than $25,000 of fair market value (at grant) per calendar year and is not carried over to another option";
}

@source(IRC_S423_B, relation = formalizes, coverage = exact, quote = "in no case may such rate exceed $25,000 of fair market value of such stock (determined at the time such option is granted) for any one calendar year")
rule AccrualWithin25000PerCalendarYear423b8(option: Person, y: Integer, fmv: Money) strict {
    label en official "exact boundary: $25,000 is allowed; no carry-over (subparagraph (C))";
    when option_accrual_facts_423b8(option, y, fmv, false)
        and fmv <= 25000.00 USD;
    then accrual_within_25000_per_calendar_year_423b8(option, y);
}

pub relation entity_stock_ownership_424d(owner: Person, holder: Person, entity_shares_of_target: Decimal, owner_percent_of_entity: Decimal) kind empirical {
    label en unofficial "the shares of the target corporation owned by a corporation, partnership, estate or trust and the owner's percentage of that holder (0-100), case-asserted";
}

pub relation stock_attributed_proportionally_424d2(owner: Person, holder: Person, shares: Decimal) kind institutional {
    label en official "section 424(d)(2): stock owned by an holder is considered owned proportionately by its shareholders, partners or beneficiaries";
}

@source(IRC_S424_D, relation = formalizes, coverage = exact, quote = "shall be considered as being owned proportionately by or for its shareholders, partners, or beneficiaries")
rule StockAttributedProportionally424d2(owner: Person, holder: Person, shares: Decimal, pct: Decimal) strict {
    label en official "shares x percentage / 100";
    when entity_stock_ownership_424d(owner, holder, shares, pct);
    then stock_attributed_proportionally_424d2(owner, holder, shares * pct / 100.0);
}

// =====================================================================
// 436 Funding-based limits
// =====================================================================

pub relation prohibited_payments_in_limit_period_436d3(participant: Person, period_start: Integer, period_end: Integer, payments_meeting_subparagraph_a: Integer) kind empirical {
    label en unofficial "the number of prohibited payments meeting subparagraph (A) made to the participant during a period of consecutive plan years in which the limits apply, case-asserted";
}

pub relation only_one_prohibited_payment_allowed_436d3Bi(participant: Person, period_start: Integer, period_end: Integer) kind institutional {
    label en official "section 436(d)(3)(B)(i): only 1 prohibited payment meeting subparagraph (A) may be made during any such period";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "only 1 prohibited payment meeting the requirements of subparagraph (A) may be made with respect to any participant")
rule OnlyOnePaymentAllowed436d3Bi(participant: Person, s: Integer, e: Integer, n: Integer) strict {
    label en official "at most one";
    when prohibited_payments_in_limit_period_436d3(participant, s, e, n)
        and n <= 1;
    then only_one_prohibited_payment_allowed_436d3Bi(participant, s, e);
}

pub relation plan_accrual_freeze_facts_436d4(plan: Plan, y: TaxableYear, no_benefit_accruals_from_2005_09_01_through_year: Boolean) kind empirical {
    label en unofficial "the plan terms in effect from September 1, 2005 through the plan year provide for no benefit accruals for any participant, case-asserted";
}

pub relation subsection_d_inapplicable_436d4(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 436(d)(4): subsection (d) does not apply to a plan whose terms provide no benefit accruals since September 1, 2005";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "provide for no benefit accruals with respect to any participant during such period")
rule SubsectionDInapplicable436d4(plan: Plan, y: TaxableYear) strict {
    label en official "no accruals from September 1, 2005 through the plan year";
    when plan_accrual_freeze_facts_436d4(plan, y, true);
    then subsection_d_inapplicable_436d4(plan, y);
}

// =====================================================================
// 411(d), 406/407, 418E, 404A
// =====================================================================

pub relation voluntary_contribution_portion_facts_411d5(plan: Plan, employee: Person, derived_portion: Money) kind empirical {
    label en unofficial "the portion of the employee's accrued benefit derived from voluntary employee contributions under a defined benefit plan, case-asserted";
}

pub relation portion_treated_as_employee_contribution_benefit_411d5(plan: Plan, employee: Person, portion: Money) kind institutional {
    label en official "section 411(d)(5): the portion is treated as derived from employee contributions under a plan other than a defined benefit plan";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "shall be treated as an accrued benefit derived from employee contributions under a plan other than a defined benefit plan")
rule PortionTreatedAsEmployeeContributionBenefit411d5(plan: Plan, employee: Person, portion: Money) strict {
    label en official "the derived portion";
    when voluntary_contribution_portion_facts_411d5(plan, employee, portion);
    then portion_treated_as_employee_contribution_benefit_411d5(plan, employee, portion);
}

pub relation esop_distribution_options_modified_411d6c(plan: Plan, is_tax_credit_esop_or_esop: Boolean, modified_nondiscriminatorily: Boolean) kind empirical {
    label en unofficial "the plan is a tax credit employee stock ownership plan (section 409(a)) or an employee stock ownership plan (section 4975(e)(7)) and modifies distribution options in a nondiscriminatory manner, case-asserted";
}

pub relation esop_not_failing_411d6_by_option_modification_411d6c(plan: Plan) kind institutional {
    label en official "section 411(d)(6)(C): the ESOP is not treated as failing paragraph (6) merely because it modifies distribution options in a nondiscriminatory manner";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to meet the requirements of this paragraph merely because it modifies distribution options in a nondiscriminatory manner")
rule EsopNotFailing411d6ByOptionModification411d6c(plan: Plan) strict {
    label en official "ESOP, nondiscriminatory modification";
    when esop_distribution_options_modified_411d6c(plan, true, true);
    then esop_not_failing_411d6_by_option_modification_411d6c(plan);
}

pub relation foreign_parent_facts_407b1B(individual: Person, total_compensation_from_group: Money, domestic_parent: Person) kind empirical {
    label en unofficial "the individual's total compensation (with the application of paragraph (2)) treated as paid by the domestic parent corporation, case-asserted";
}

pub relation compensation_for_hce_determination_407b1B(individual: Person, domestic_parent: Person, amount: Money) kind institutional {
    label en official "section 407(b)(1)(B): the highly compensated employee determination uses the total compensation as paid by the domestic parent corporation";
}

@source(IRC_S407_B, relation = formalizes, coverage = exact, quote = "shall be made by treating such individual's total compensation (determined with the application of paragraph (2) of this subsection) as compensation paid by such domestic parent corporation")
rule CompensationForHceDetermination407b1B(individual: Person, parent: Person, amount: Money) strict {
    label en official "the total compensation as paid by the parent";
    when foreign_parent_facts_407b1B(individual, amount, parent);
    then compensation_for_hce_determination_407b1B(individual, parent, amount);
}

pub relation base_plan_year_facts_418Ec2(plan: Plan, relevant_cba_exists: Boolean, plan_year_end: Date, relevant_effective_date: Date, plan_year_begin: Date) kind empirical {
    label en unofficial "whether a relevant collective bargaining agreement exists, a candidate plan year end, the relevant effective date and the beginning of the insolvency plan year, case-asserted";
}

pub relation base_plan_year_end_valid_418Ec2(plan: Plan, plan_year_end: Date) kind institutional {
    label en official "section 418E(c)(2): the base plan year is the last plan year ending at least 6 months before the relevant effective date (with a collective bargaining agreement) or at least 12 months before the beginning of the plan year (without one)";
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "the last plan year ending at least 6 months before the relevant effective date")
rule BaseYearWithCba418Ec2(plan: Plan, end: Date, eff: Date, begin: Date) strict {
    label en official "PARTIAL: (I); the candidate year end is at least 6 calendar months before the effective date (the last such year is chosen by the case)";
    when base_plan_year_facts_418Ec2(plan, true, end, eff, begin)
        and add_calendar_period(end, 6 calendar_month) <= eff;
    then base_plan_year_end_valid_418Ec2(plan, end);
}

@source(IRC_S418E_C, relation = formalizes, coverage = partial, quote = "the last plan year ending at least 12 months before the beginning of the plan year")
rule BaseYearWithoutCba418Ec2(plan: Plan, end: Date, eff: Date, begin: Date) strict {
    label en official "PARTIAL: (II); the candidate year end is at least 12 calendar months before the beginning of the plan year";
    when base_plan_year_facts_418Ec2(plan, false, end, eff, begin)
        and add_calendar_period(end, 12 calendar_month) <= begin;
    then base_plan_year_end_valid_418Ec2(plan, end);
}

pub relation subsections_a_and_c_inapplicable_418Eg(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 418E(g)(h): subsections (a) and (c) do not apply to a plan operating under section 432(e)(9) for the plan year";
}

pub relation plan_operating_under_432e9_418Eg(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan operates under section 432(e)(9) (benefit suspensions by certain multiemployer plans in critical and declining status) for the plan year, case-asserted";
}

@source(IRC_S418E_G, relation = formalizes, coverage = exact, quote = "Subsections (a) and (c) shall not apply to a plan that, for the plan year, is operating under section 432(e)(9)")
rule SubsectionsAAndCInapplicable418Eg(plan: Plan, y: TaxableYear) strict {
    label en official "operating under 432(e)(9)";
    when plan_operating_under_432e9_418Eg(plan, y);
    then subsections_a_and_c_inapplicable_418Eg(plan, y);
}

pub relation interest_rate_facts_404Ag3B(plan: Plan, y: TaxableYear, selected_rate: Decimal, average_long_term_corporate_rate_15_years: Decimal) kind empirical {
    label en unofficial "the rate selected by the taxpayer and the average rate of interest for long-term corporate bonds in the appropriate country for the 15-year period ending on the last day before the taxable year, case-asserted";
}

pub relation selected_rate_within_permissible_range_404Ag3Biii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(3)(B)(iii): a rate not more than 20 percent above and not more than 20 percent below the 15-year average";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "a rate of interest which is not more than 20 percent above, and not more than 20 percent below, the average rate of interest for long-term corporate bonds in the appropriate country for the 15-year period ending on the last day before the beginning of the taxable year")
rule SelectedRateWithinPermissibleRange404Ag3Biii(plan: Plan, y: TaxableYear, rate: Decimal, avg: Decimal) strict {
    label en official "exact boundaries: avg x 0.8 <= rate <= avg x 1.2";
    when interest_rate_facts_404Ag3B(plan, y, rate, avg)
        and rate >= avg * 0.8
        and rate <= avg * 1.2;
    then selected_rate_within_permissible_range_404Ag3Biii(plan, y);
}

pub relation deduction_method_change_facts_404Ag4(taxpayer: Person, y: TaxableYear, method_changed: Boolean, only_actuarial_assumptions_changed: Boolean) kind empirical {
    label en unofficial "the method used to determine the deduction under subsection (a) changed, and whether only the actuarial assumptions changed, case-asserted";
}

pub relation treated_as_accounting_method_change_446e_404Ag4(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(4): a change in the method (but not the actuarial assumptions) is a change in accounting method under section 446(e)";
}

@source(IRC_S404A_G, relation = formalizes, coverage = exact, quote = "Any change in the method (but not the actuarial assumptions) used to determine the amount allowed as a deduction under subsection (a) shall be treated as a change in accounting method under section 446(e)")
rule TreatedAsAccountingMethodChange404Ag4(taxpayer: Person, y: TaxableYear) strict {
    label en official "a method change, not solely actuarial assumptions";
    when deduction_method_change_facts_404Ag4(taxpayer, y, true, false);
    then treated_as_accounting_method_change_446e_404Ag4(taxpayer, y);
}

pub relation foreign_deduction_evidence_facts_404Ag2(taxpayer: Person, y: TaxableYear, foreign_authority_statement: Boolean, separate_return_copy: Boolean, other_prescribed_evidence: Boolean) kind empirical {
    label en unofficial "the taxpayer furnished a statement from the foreign tax authorities, a copy of the foreign return showing the item separately, or other evidence prescribed by regulation, case-asserted";
}

pub relation deduction_allowable_on_evidence_404Ag2A(taxpayer: Person, y: TaxableYear) kind institutional {
    label en official "section 404A(g)(2)(A): no deduction unless the taxpayer furnishes one of the listed statements, returns or evidence";
}

@source(IRC_S404A_G, relation = formalizes, coverage = partial, quote = "a copy of the foreign tax return for the taxable year")
rule DeductionAllowableOnStatement404Ag2A(taxpayer: Person, y: TaxableYear, sep: Boolean, other: Boolean) strict {
    label en official "PARTIAL: (i) statement from the foreign authorities; the timing is the Secretary's regulations";
    when foreign_deduction_evidence_facts_404Ag2(taxpayer, y, true, sep, other);
    then deduction_allowable_on_evidence_404Ag2A(taxpayer, y);
}

@source(IRC_S404A_G, relation = formalizes, coverage = partial, quote = "a copy of the foreign tax return for the taxable year")
rule DeductionAllowableOnReturn404Ag2A(taxpayer: Person, y: TaxableYear, st: Boolean, other: Boolean) strict {
    label en official "PARTIAL: (ii) copy of the foreign return";
    when foreign_deduction_evidence_facts_404Ag2(taxpayer, y, st, true, other);
    then deduction_allowable_on_evidence_404Ag2A(taxpayer, y);
}

@source(IRC_S404A_G, relation = formalizes, coverage = partial, quote = "such other statement, return, or other evidence as the Secretary prescribes by regulation as being sufficient to establish the amount of the deduction under foreign law")
rule DeductionAllowableOnOtherEvidence404Ag2A(taxpayer: Person, y: TaxableYear, st: Boolean, sep: Boolean) strict {
    label en official "PARTIAL: (iii) other evidence the Secretary prescribes";
    when foreign_deduction_evidence_facts_404Ag2(taxpayer, y, st, sep, true);
    then deduction_allowable_on_evidence_404Ag2A(taxpayer, y);
}
