// Section 432 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026):
// module 18 carries the status tests of subsection (b)(1)-(4). This module
// adds the consequences and the mechanics around them: (a) the plan sponsor's
// obligations by status, (b)(6) critical and declining status, (c) funding
// improvement plans, (d) and (f) the restrictions during the plan periods,
// (e) rehabilitation plans (surcharge, adjustable benefits, benefit
// suspensions), (h) expedited dispute resolution, (j) definitions, (k)
// special financial assistance.
//
// Method: a sponsor obligation is a duty position with a calendar window
// (exact date arithmetic; the IRC calendar-step policy is needed in a
// scenario); a limit is exact arithmetic over case-supplied amounts;
// actuarial projections, the Secretary's and PBGC's procedures, and vote and
// notice content are not derived here (see the coverage rows).

// =====================================================================
// Case-asserted facts common to the module
// =====================================================================

use self::{
    IRC_S432_B,
    IRC_S432_C,
    IRC_S432_D,
    IRC_S432_E,
    IRC_S432_F,
    IRC_S432_H,
    IRC_S432_J,
    IRC_S432_K,
    MultiemployerPlan,
    Person,
    TaxableYear,
    critical_status_432,
    endangered_status_432b1,
    funded_percentage_432,
    has_accumulated_funding_deficiency_432,
    seriously_endangered_status_432b1,
};

pub relation multiemployer_plan_sponsor_432(plan: MultiemployerPlan, sponsor: Person) kind empirical {
    label en unofficial "the plan sponsor of the multiemployer plan (section 432(i)(9): the association, committee, joint board of trustees or similar group), case-asserted";
}

pub relation multiemployer_bargaining_party_432(plan: MultiemployerPlan, party: Person) kind empirical {
    label en unofficial "a bargaining party of the plan (an employer with an obligation to contribute, or the employee organization), case-asserted (section 432(j)(1))";
}

pub relation plan_in_effect_on_july_16_2006_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the multiemployer plan was in effect on July 16, 2006, case-asserted (section 432(a))";
}

pub relation year_in_earlier_plan_period_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year is in a funding plan adoption period, funding improvement period, rehabilitation plan adoption period or rehabilitation period by reason of an earlier certification, case-asserted (sections 432(c)(2), (e)(2))";
}

// =====================================================================
// (b)(6) Critical and declining status
// =====================================================================

pub relation projected_years_to_insolvency_432(plan: MultiemployerPlan, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the number of plan years from the current year (0 = the current plan year) after which the plan is projected to become insolvent within the meaning of section 418E, case-asserted; absent when no insolvency is projected";
}

pub relation inactive_and_active_participant_counts_432(plan: MultiemployerPlan, y: TaxableYear, inactive: Integer, active: Integer) kind empirical {
    label en unofficial "the numbers of inactive and active participants, case-asserted (section 432(j)(4), (5))";
}

pub relation critical_and_declining_status_432b6(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(6): a critical status plan projected to become insolvent within 14 years (19 years when the inactive-to-active ratio exceeds 2 to 1 or the funded percentage is under 80 percent)";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan is projected to become insolvent within the meaning of section 418E during the current plan year or any of the 14 succeeding plan years")
rule CriticalAndDeclining14Years(plan: MultiemployerPlan, y: TaxableYear, years: Integer) strict {
    label en official "exact boundary: 14 succeeding years";
    when critical_status_432(plan, y) and projected_years_to_insolvency_432(plan, y, years) and years <= 14;
    then critical_and_declining_status_432b6(plan, y);
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "19 succeeding plan years if the plan has a ratio of inactive participants to active participants that exceeds 2 to 1")
rule CriticalAndDeclining19YearsInactiveRatio(plan: MultiemployerPlan, y: TaxableYear, years: Integer, inactive: Integer, active: Integer) strict {
    label en official "exact by cross-multiplication: the ratio exceeds 2 to 1 when inactive > 2 x active";
    when critical_status_432(plan, y)
        and projected_years_to_insolvency_432(plan, y, years)
        and years <= 19
        and inactive_and_active_participant_counts_432(plan, y, inactive, active)
        and inactive > active * 2;
    then critical_and_declining_status_432b6(plan, y);
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "if the funded percentage of the plan is less than 80 percent")
rule CriticalAndDeclining19YearsFundedPercentage(plan: MultiemployerPlan, y: TaxableYear, years: Integer, pct: Decimal) strict {
    label en official "exact boundary: strictly less than 80 percent";
    when critical_status_432(plan, y)
        and projected_years_to_insolvency_432(plan, y, years)
        and years <= 19
        and funded_percentage_432(plan, y, pct)
        and pct < 0.80;
    then critical_and_declining_status_432b6(plan, y);
}

// =====================================================================
// (j) Definitions
// =====================================================================

pub relation plan_assets_value_431c2_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the plan's assets as determined under section 431(c)(2), case-asserted";
}

pub relation accrued_liability_431c3_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the accrued liability of the plan determined with the section 431(c)(3) assumptions, case-asserted";
}

pub relation funded_percentage_computed_432j2(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 432(j)(2): assets divided by accrued liability, expressed as a fraction (0.80 = 80 percent)";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "the numerator of which is the value of the plan's assets, as determined under section 431(c)(2)")
rule FundedPercentageComputed432j2(plan: MultiemployerPlan, y: TaxableYear, assets: Money, liability: Money) strict {
    label en official "exact quotient, a fraction like funded_percentage_432 (no rounding)";
    when plan_assets_value_431c2_432(plan, y, assets) and accrued_liability_431c3_432(plan, y, liability) and liability > 0.00 USD;
    then funded_percentage_computed_432j2(plan, y, assets / liability);
}

pub relation participant_in_covered_service_432(participant: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the participant is in covered service under the plan, case-asserted (section 432(j)(4))";
}

pub relation participant_in_pay_status_432(participant: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "at any time during the current plan year the person is paid an early, late, normal or disability retirement benefit (or a related death benefit), case-asserted ((j)(6)(A))";
}

pub relation participant_has_nonforfeitable_benefit_432(participant: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the person has a nonforfeitable right to benefits under the plan, case-asserted";
}

pub relation active_participant_432j4(participant: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(j)(4): a participant in covered service under the plan";
}

@source(IRC_S432_J, relation = formalizes, coverage = partial, quote = "The term \"active participant\" means, in connection with a multiemployer plan, a participant who is in covered service under the plan.")
rule ActiveParticipant432j4(participant: Person, plan: MultiemployerPlan) strict {
    label en official "PARTIAL: covered service is a case fact";
    when participant_in_covered_service_432(participant, plan);
    then active_participant_432j4(participant, plan);
}

pub relation inactive_participant_432j5(participant: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(j)(5): a participant, beneficiary or alternate payee not in covered service who is in pay status or has a nonforfeitable right to benefits";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "is not in covered service under the plan, and")
rule InactiveParticipantInPayStatus432j5(participant: Person, plan: MultiemployerPlan) strict {
    label en official "(A) and (B), pay status limb";
    when participant_in_pay_status_432(participant, plan) and not_known(participant_in_covered_service_432(participant, plan));
    then inactive_participant_432j5(participant, plan);
}

rule InactiveParticipantNonforfeitable432j5(participant: Person, plan: MultiemployerPlan) strict {
    label en official "(A) and (B), nonforfeitable right limb";
    when participant_has_nonforfeitable_benefit_432(participant, plan) and not_known(participant_in_covered_service_432(participant, plan));
    then inactive_participant_432j5(participant, plan);
}

// =====================================================================
// (a), (c), (e) Adoption duties and their windows
// =====================================================================

pub relation multiemployer_plan_year_start_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted";
}

pub relation funding_improvement_plan_adopted_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor has adopted a funding improvement plan for the year, case-asserted";
}

pub relation rehabilitation_plan_adopted_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor has adopted a rehabilitation plan for the year, case-asserted";
}

pub relation funding_improvement_plan_adopted_on_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the funding improvement plan was adopted, case-asserted";
}

pub relation rehabilitation_plan_adopted_on_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the rehabilitation plan was adopted, case-asserted";
}

pub relation schedules_provided_to_bargaining_parties_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor has provided the required schedules to the bargaining parties, case-asserted";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "shall adopt a funding improvement plan not later than 240 days following the required date for the actuarial certification of endangered status under subsection (b)(3)(A)")
rule FundingImprovementPlanAdoptionDuty(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person, start: Date) strict {
    label en official "the required certification date is the 90th day of the plan year (day 89 after its first day); the duty falls due 240 days later; a year already inside an earlier plan period is excluded ((c)(2))";
    when endangered_status_432b1(plan, y)
        and plan_in_effect_on_july_16_2006_432(plan)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and multiemployer_plan_year_start_432(plan, y, start)
        and not_known(year_in_earlier_plan_period_432(plan, y));
    then duty AdoptFundingImprovementPlanDuty {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition funding_improvement_plan_adopted_432(plan, y);
            window [-infinity, add_calendar_period(add_calendar_period(start, 89 calendar_day), 240 calendar_day)];
        }
    };
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "within 30 days after the adoption of the funding improvement plan")
rule FundingImprovementSchedulesDuty(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person, adopted: Date) strict {
    label en official "schedules to the bargaining parties within 30 days of adoption";
    when funding_improvement_plan_adopted_on_432(plan, y, adopted)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party);
    then duty ProvideFundingImprovementSchedulesDuty {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition schedules_provided_to_bargaining_parties_432(plan, y);
            window [-infinity, add_calendar_period(adopted, 30 calendar_day)];
        }
    };
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall adopt a rehabilitation plan not later than 240 days following the required date for the actuarial certification of critical status under subsection (b)(3)(A)")
rule RehabilitationPlanAdoptionDuty(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person, start: Date) strict {
    label en official "the same 240-day rule for critical status; a year already inside an earlier plan period is excluded ((e)(2))";
    when critical_status_432(plan, y)
        and plan_in_effect_on_july_16_2006_432(plan)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and multiemployer_plan_year_start_432(plan, y, start)
        and not_known(year_in_earlier_plan_period_432(plan, y));
    then duty AdoptRehabilitationPlanDuty {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition rehabilitation_plan_adopted_432(plan, y);
            window [-infinity, add_calendar_period(add_calendar_period(start, 89 calendar_day), 240 calendar_day)];
        }
    };
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "within 30 days after the adoption of the rehabilitation plan")
rule RehabilitationSchedulesDuty(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person, adopted: Date) strict {
    label en official "schedules to the bargaining parties within 30 days of adoption";
    when rehabilitation_plan_adopted_on_432(plan, y, adopted)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party);
    then duty ProvideRehabilitationSchedulesDuty {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition schedules_provided_to_bargaining_parties_432(plan, y);
            window [-infinity, add_calendar_period(adopted, 30 calendar_day)];
        }
    };
}

// =====================================================================
// (c)(3), (4), (5) Benchmarks and the funding improvement period
// =====================================================================

pub relation initial_endangered_funded_percentage_432(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the plan's funded percentage as of the beginning of the first plan year for which it is certified endangered, case-asserted (section 432(c)(3)(A)(i)(I))";
}

pub relation funding_improvement_benchmark_432c3(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 432(c)(3)(A)(i), (B): the base percentage plus 33 percent (20 percent for a seriously endangered plan) of the difference between 100 percent and the base";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "33 percent of the difference between 100 percent and the percentage under subclause (I)")
rule FundingImprovementBenchmarkGeneral(plan: MultiemployerPlan, y: TaxableYear, base: Decimal) strict {
    label en official "a plan not in seriously endangered status: base + 0.33 x (100 - base), exact";
    when endangered_status_432b1(plan, y)
        and not_known(seriously_endangered_status_432b1(plan, y))
        and initial_endangered_funded_percentage_432(plan, y, base);
    then funding_improvement_benchmark_432c3(plan, y, base + (100.0 - base) * 0.33);
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "subparagraph (A)(i)(II) shall be applied by substituting \"20 percent\" for \"33 percent\"")
rule FundingImprovementBenchmarkSeriouslyEndangered(plan: MultiemployerPlan, y: TaxableYear, base: Decimal) strict {
    label en official "a seriously endangered plan: base + 0.20 x (100 - base); the (c)(5) relief for plans above 70 percent is a certification not derived here";
    when seriously_endangered_status_432b1(plan, y) and initial_endangered_funded_percentage_432(plan, y, base);
    then funding_improvement_benchmark_432c3(plan, y, base + (100.0 - base) * 0.20);
}

pub relation funded_percentage_at_period_close_432(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the plan's funded percentage as of the close of the funding improvement period, case-asserted";
}

pub relation funding_improvement_benchmarks_met_432c3(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(3)(A): the funded percentage reaches the benchmark and no accumulated funding deficiency exists for the last plan year of the period";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "The plan's funded percentage as of the close of the funding improvement period equals or exceeds a percentage equal to the sum of")
rule FundingImprovementBenchmarksMet(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal, benchmark: Decimal) strict {
    label en official "exact boundary: equal to the benchmark meets it; the (A)(ii) deficiency condition is required";
    when funded_percentage_at_period_close_432(plan, y, pct)
        and funding_improvement_benchmark_432c3(plan, y, benchmark)
        and pct >= benchmark
        and not_known(has_accumulated_funding_deficiency_432(plan, y));
    then funding_improvement_benchmarks_met_432c3(plan, y);
}

pub relation improvement_period_first_plan_year_start_432(plan: MultiemployerPlan, start: Date) kind empirical {
    label en unofficial "the first day of the first plan year beginning after the earlier of the second anniversary of adoption and the expiration of the collective bargaining agreements in effect on the certification due date, case-asserted (sections 432(c)(4)(A), (e)(4)(A))";
}

pub relation funding_improvement_period_end_432c4(plan: MultiemployerPlan, end: Date) kind institutional {
    label en official "section 432(c)(4)(A), (B): the last day of the 10-year funding improvement period (15 years for a seriously endangered plan)";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "The funding improvement period for any funding improvement plan adopted pursuant to this subsection is the 10-year period")
rule FundingImprovementPeriodEnd10Years(plan: MultiemployerPlan, y: TaxableYear, start: Date, calendar_before_1: Date) strict {
    label en official "start + 10 years - 1 day";
    when improvement_period_first_plan_year_start_432(plan, start)
        and endangered_status_432b1(plan, y)
        and not_known(seriously_endangered_status_432b1(plan, y))
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 10 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then funding_improvement_period_end_432c4(plan, calendar_before_1);
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "subparagraph (A) shall be applied by substituting \"15-year period\" for \"10-year period\"")
rule FundingImprovementPeriodEnd15Years(plan: MultiemployerPlan, y: TaxableYear, start: Date, calendar_before_1: Date) strict {
    label en official "seriously endangered: start + 15 years - 1 day";
    when improvement_period_first_plan_year_start_432(plan, start) and seriously_endangered_status_432b1(plan, y)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 15 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then funding_improvement_period_end_432c4(plan, calendar_before_1);
}

pub relation rehabilitation_period_end_432e4(plan: MultiemployerPlan, end: Date) kind institutional {
    label en official "section 432(e)(4)(A): the last day of the 10-year rehabilitation period";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The rehabilitation period for a plan in critical status is the 10-year period")
rule RehabilitationPeriodEnd(plan: MultiemployerPlan, y: TaxableYear, start: Date, calendar_before_1: Date) strict {
    label en official "start + 10 years - 1 day; early emergence from critical status is not derived";
    when improvement_period_first_plan_year_start_432(plan, start) and critical_status_432(plan, y)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 10 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then rehabilitation_period_end_432e4(plan, calendar_before_1);
}

// =====================================================================
// (d), (f) Restrictions during the plan periods
// =====================================================================

pub relation plan_in_funding_period_432d(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is in the funding plan adoption period or the funding improvement period for the year, case-asserted (section 432(d))";
}

pub relation plan_in_rehabilitation_period_432f(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is in the rehabilitation plan adoption period or the rehabilitation period for the year, case-asserted (section 432(f))";
}

pub relation accepts_contribution_reducing_agreement_432(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "the plan sponsor accepts a collective bargaining or participation agreement that reduces contributions, suspends contributions for a period of service, or newly excludes younger or newly hired employees";
}

pub relation sponsor_accepts_agreement_with_reduction_432(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor accepts an agreement providing for a reduction in the level of contributions, a suspension of contributions with respect to any period of service, or a new exclusion of younger or newly hired employees, case-asserted (sections 432(d)(2)(A), (f)(3)(A))";
}

rule AcceptsContributionReducingAgreement(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) strict {
    label en unofficial "the action atom of the two prohibitions below";
    when sponsor_accepts_agreement_with_reduction_432(sponsor, plan, y);
    then accepts_contribution_reducing_agreement_432(sponsor, plan, y);
}

@source(IRC_S432_D, relation = formalizes, coverage = exact, quote = "the plan sponsor may not accept a collective bargaining agreement or participation agreement with respect to the multiemployer plan that provides for")
rule ProhibitionToAcceptReducingAgreementFundingPeriod(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear, party: Person) strict {
    label en official "while the plan is in the funding plan adoption or improvement period";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and plan_in_funding_period_432d(plan, y);
    then prohibition AcceptReducingAgreementFundingPeriod {
        bearer sponsor;
        action accepts_contribution_reducing_agreement_432(sponsor, plan, y);
        window [-infinity, infinity];
    };
}

@source(IRC_S432_F, relation = formalizes, coverage = exact, quote = "the plan sponsor may not accept a collective bargaining agreement or participation agreement with respect to the multiemployer plan that provides for")
rule ProhibitionToAcceptReducingAgreementRehabilitationPeriod(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear, party: Person) strict {
    label en official "while the plan is in the rehabilitation plan adoption or rehabilitation period";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and plan_in_rehabilitation_period_432f(plan, y);
    then prohibition AcceptReducingAgreementRehabilitationPeriod {
        bearer sponsor;
        action accepts_contribution_reducing_agreement_432(sponsor, plan, y);
        window [-infinity, infinity];
    };
}

pub relation sponsor_amends_plan_against_plan_432(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor amends the plan, after adoption of the improvement or rehabilitation plan, so as to be inconsistent with it or to increase benefits or liabilities against the statutory exceptions, case-asserted (sections 432(d)(1), (d)(2)(B), (f)(1), (f)(3)(B))";
}

@source(IRC_S432_D, relation = formalizes, coverage = partial, quote = "A plan may not be amended after the date of the adoption of a funding improvement plan under subsection (c) so as to be inconsistent")
rule ProhibitionToAmendAgainstFundingImprovementPlan(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: the exceptions (an increase certified by the actuary) are inside the asserted fact";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and funding_improvement_plan_adopted_432(plan, y);
    then prohibition AmendAgainstFundingImprovementPlan {
        bearer sponsor;
        action sponsor_amends_plan_against_plan_432(sponsor, plan, y);
        window [-infinity, infinity];
    };
}

@source(IRC_S432_F, relation = formalizes, coverage = partial, quote = "A plan may not be amended after the date of the adoption of a rehabilitation plan under subsection (e) so as to be inconsistent")
rule ProhibitionToAmendAgainstRehabilitationPlan(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: the exceptions are inside the asserted fact";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and rehabilitation_plan_adopted_432(plan, y);
    then prohibition AmendAgainstRehabilitationPlan {
        bearer sponsor;
        action sponsor_amends_plan_against_plan_432(sponsor, plan, y);
        window [-infinity, infinity];
    };
}

pub relation critical_status_notice_sent_on_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the notice of certification of critical status for the initial critical year is sent, case-asserted (section 432(f)(2)(A))";
}

pub relation annuity_starting_date_432(plan: MultiemployerPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the participant's annuity starting date, case-asserted";
}

pub relation pays_excess_over_single_life_annuity_432(sponsor: Person, plan: MultiemployerPlan, participant: Person) kind empirical {
    label en unofficial "the plan pays an amount in excess of the monthly single life annuity (plus social security supplements), case-asserted (section 432(f)(2)(A)(i))";
}

@source(IRC_S432_F, relation = formalizes, coverage = partial, quote = "in excess of the monthly amount paid under a single life annuity")
rule ProhibitionToPayExcessOverSingleLifeAnnuity(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear, participant: Person, notice: Date, asd: Date) strict {
    label en official "PARTIAL: from the notice date, for a participant whose annuity starting date is after it; the (B) exception for section 411(a)(11) distributions and the irrevocable-commitment purchase are not carved out";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and critical_status_notice_sent_on_432(plan, y, notice)
        and annuity_starting_date_432(plan, participant, asd)
        and asd > notice;
    then prohibition PayExcessOverSingleLifeAnnuity {
        bearer sponsor;
        action pays_excess_over_single_life_annuity_432(sponsor, plan, participant);
        window [notice, infinity];
    };
}

// =====================================================================
// (e)(7) Surcharge, (e)(8) adjustable benefits notice
// =====================================================================

pub relation contribution_otherwise_required_432(employer: Person, plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contribution otherwise required of the employer for the year under the applicable agreement, case-asserted (section 432(e)(7)(A))";
}

pub relation consecutive_critical_year_ordinal_432(plan: MultiemployerPlan, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "1 for the initial critical year, 2 and above for each succeeding plan year in a consecutive period in critical status, case-asserted";
}

pub relation critical_status_surcharge_432e7(employer: Person, plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 432(e)(7)(A): 5 percent of the contribution otherwise required for the initial critical year and 10 percent for each succeeding year";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "a surcharge equal to 5 percent of the contribution otherwise required under the applicable collective bargaining agreement")
rule CriticalStatusSurchargeInitialYear(employer: Person, plan: MultiemployerPlan, y: TaxableYear, base: Money) strict {
    label en official "5 percent, exact";
    when critical_status_432(plan, y)
        and contribution_otherwise_required_432(employer, plan, y, base)
        and consecutive_critical_year_ordinal_432(plan, y, 1);
    then critical_status_surcharge_432e7(employer, plan, y, base * 0.05);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the surcharge shall be 10 p")
rule CriticalStatusSurchargeSucceedingYears(employer: Person, plan: MultiemployerPlan, y: TaxableYear, base: Money, n: Integer) strict {
    label en official "10 percent, exact, for the second and later consecutive critical years";
    when critical_status_432(plan, y)
        and contribution_otherwise_required_432(employer, plan, y, base)
        and consecutive_critical_year_ordinal_432(plan, y, n)
        and n >= 2;
    then critical_status_surcharge_432e7(employer, plan, y, base * 0.10);
}

pub relation adjustable_benefit_reduction_effective_on_432(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the general effective date of a reduction of adjustable benefits under section 432(e)(8)(A), case-asserted";
}

pub relation adjustable_benefit_reduction_notice_given_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "notice of the reduction has been given to participants and beneficiaries, each contributing employer and each employee organization, case-asserted (section 432(e)(8)(C)(i))";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "unless notice of such reduction has been given at least 30 days before the general effective date of such reduction for all participants and beneficiaries")
rule AdjustableBenefitReductionNoticeDuty(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person, eff_on: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL: notice at least 30 days before the general effective date; the notice content is not derived";
    when critical_status_432(plan, y)
        and multiemployer_plan_year_start_432(plan, y, _)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and adjustable_benefit_reduction_effective_on_432(plan, eff_on)
        and us.irc.core::civil_calendar_boundary_before(eff_on, 30, us.irc.core::CalendarDay, calendar_before_1);
    then duty AdjustableBenefitReductionNoticeDutyPosition {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition adjustable_benefit_reduction_notice_given_432(plan);
            window [-infinity, calendar_before_1];
        }
    };
}

// =====================================================================
// (e)(9) Benefit suspensions of a critical and declining plan
// =====================================================================

pub relation suspension_proposed_monthly_benefit_432(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the participant's monthly benefit after the proposed suspension, case-asserted (section 432(e)(9)(D)(i))";
}

pub relation pbgc_guaranteed_monthly_benefit_432(participant: Person, amount: Money) kind empirical {
    label en unofficial "the monthly benefit guaranteed by the PBGC under section 4022A of ERISA on the date of the suspension, case-asserted";
}

pub relation suspension_below_floor_432e9d1(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(9)(D)(i): the suspension would reduce the monthly benefit below 110 percent of the PBGC-guaranteed benefit";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The monthly benefit of any participant or beneficiary may not be reduced below 110 percent of the monthly benefit which is guaranteed by the Pension Benefit Guaranty Corporation")
rule SuspensionBelowFloor(plan: MultiemployerPlan, participant: Person, proposed: Money, guaranteed: Money) strict {
    label en official "exact boundary: at 110 percent is allowed, below it is not";
    when suspension_proposed_monthly_benefit_432(plan, participant, proposed)
        and pbgc_guaranteed_monthly_benefit_432(participant, guaranteed)
        and proposed < guaranteed * 1.10;
    then suspension_below_floor_432e9d1(plan, participant);
}

pub relation suspends_benefit_below_floor_432(sponsor: Person, plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "action atom of the (D)(i) prohibition";
}

rule SuspendsBenefitBelowFloor(sponsor: Person, plan: MultiemployerPlan, participant: Person) strict {
    label en unofficial "the action is realized by the below-floor suspension of a plan the sponsor administers";
    when multiemployer_plan_sponsor_432(plan, sponsor) and suspension_below_floor_432e9d1(plan, participant);
    then suspends_benefit_below_floor_432(sponsor, plan, participant);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may not be reduced below 110 percent")
rule ProhibitionToSuspendBelowFloor(sponsor: Person, plan: MultiemployerPlan, y: TaxableYear, participant: Person) strict {
    label en official "in force for a plan in critical and declining status for every participant with a proposed suspension";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and critical_and_declining_status_432b6(plan, y)
        and multiemployer_plan_year_start_432(plan, y, _)
        and suspension_proposed_monthly_benefit_432(plan, participant, _);
    then prohibition SuspendBelowGuaranteeFloor {
        bearer sponsor;
        action suspends_benefit_below_floor_432(sponsor, plan, participant);
        window [-infinity, infinity];
    };
}

pub relation participant_age_at_suspension_432(participant: Person, age: Integer) kind empirical {
    label en unofficial "the participant's or beneficiary's age on the effective date of the suspension, case-asserted (section 432(e)(9)(D)(ii)(I))";
}

pub relation months_from_suspension_to_age_80_432(participant: Person, months: Decimal) kind empirical {
    label en unofficial "the number of months from the month after the effective date of the suspension through the month in which the individual attains age 80, case-asserted ((D)(ii)(III)(aa))";
}

pub relation maximum_suspendable_benefit_432(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the portion of the benefit that would be suspended without regard to clause (ii), case-asserted ((D)(ii)(II))";
}

pub relation suspended_amount_432(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the amount proposed to be suspended, case-asserted";
}

pub relation suspension_exceeds_age_75_limit_432(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(9)(D)(ii): for age 75 or over, the suspended part exceeds the applicable percentage (months to age 80 divided by 60) of the maximum suspendable benefit";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "not more than the applicable percentage of the maximum suspendable benefits of such participant or beneficiary may be suspended under this paragraph")
rule SuspensionExceedsAge75Limit(plan: MultiemployerPlan, participant: Person, age: Integer, months: Decimal, maximum: Money, suspended: Money) strict {
    label en official "exact by cross-multiplication: suspended x 60 > maximum x months; at age 80 or older months is 0 and nothing may be suspended";
    when participant_age_at_suspension_432(participant, age)
        and age >= 75
        and months_from_suspension_to_age_80_432(participant, months)
        and maximum_suspendable_benefit_432(plan, participant, maximum)
        and suspended_amount_432(plan, participant, suspended)
        and suspended * 60.0 > maximum * months;
    then suspension_exceeds_age_75_limit_432(plan, participant);
}

pub relation benefit_is_disability_based_432(participant: Person) kind empirical {
    label en unofficial "the benefit is based on disability as defined under the plan, case-asserted (section 432(e)(9)(D)(iii))";
}

pub relation suspends_disability_benefit_432(sponsor: Person, plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "action atom of the (D)(iii) prohibition";
}

rule SuspendsDisabilityBenefit(sponsor: Person, plan: MultiemployerPlan, participant: Person) strict {
    label en unofficial "the sponsor's suspension reaches a disability-based benefit";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and benefit_is_disability_based_432(participant)
        and suspended_amount_432(plan, participant, _);
    then suspends_disability_benefit_432(sponsor, plan, participant);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "No benefits based on disability (as defined under the plan) may be suspended under this paragraph.")
rule ProhibitionToSuspendDisabilityBenefits(sponsor: Person, plan: MultiemployerPlan, participant: Person) strict {
    label en official "absolute";
    when multiemployer_plan_sponsor_432(plan, sponsor) and benefit_is_disability_based_432(participant);
    then prohibition SuspendDisabilityBenefit {
        bearer sponsor;
        action suspends_disability_benefit_432(sponsor, plan, participant);
        window [-infinity, infinity];
    };
}

pub relation actuary_certifies_projected_to_avoid_insolvency_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan actuary certifies that, with the proposed suspensions (and any partition), the plan is projected to avoid insolvency, case-asserted (section 432(e)(9)(C)(i))";
}

pub relation sponsor_written_record_of_necessity_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor determines in a written record, maintained throughout the suspension, that the plan will become insolvent unless the suspension takes effect and that the suspension is reasonably estimated to avoid insolvency, case-asserted ((C)(ii))";
}

pub relation suspension_conditions_met_432e9c(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(9)(C): the plan is in critical and declining status, the actuary's certification and the sponsor's written determination are present; the further conditions of (C)(iii)-(vi) (factors, limits, notice, approval, vote) are separate";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "the plan actuary certifies that the plan is projected to avoid insolvency within the meaning of section 418E")
rule SuspensionConditionsMet(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: (i) and (ii) of subparagraph (C) together with critical and declining status";
    when critical_and_declining_status_432b6(plan, y)
        and actuary_certifies_projected_to_avoid_insolvency_432(plan, y)
        and sponsor_written_record_of_necessity_432(plan, y);
    then suspension_conditions_met_432e9c(plan, y);
}

pub relation pbgc_projected_assistance_pv_432(plan: MultiemployerPlan, amount: Money) kind empirical {
    label en unofficial "the present value of projected financial assistance payments the PBGC projects if suspensions are not implemented, case-asserted (section 432(e)(9)(H)(v)(iii)(aa))";
}

pub relation systemically_important_plan_432(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(H)(v)(iii)(aa): a plan for which the PBGC projects the present value of projected financial assistance payments exceeds $1,000,000,000 if suspensions are not implemented";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "a systemically important plan is a plan with respect to which the Pension Benefit Guaranty Corporation projects the present value of projected financial assistance payments exceeds $1,000,000,000 if suspensions are not implemented")
rule SystemicallyImportantPlan(plan: MultiemployerPlan, pv: Money) strict {
    label en official "PARTIAL: strictly above $1,000,000,000; the (bb) inflation indexing for years after 2015 is not pinned";
    when pbgc_projected_assistance_pv_432(plan, pv) and pv > 1000000000.00 USD;
    then systemically_important_plan_432(plan);
}

pub relation sponsor_elects_no_benefit_improvements_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor provides benefit improvements while a suspension remains in effect, case-asserted";
}

pub relation improvement_with_certified_solvency_and_equitable_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the improvement is accompanied by equitable improvements for all participants and the actuary certifies the plan is projected to avoid insolvency, case-asserted (section 432(e)(9)(E)(i)(I), (II))";
}

pub relation benefit_improvement_during_suspension_permitted_432e9e(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(9)(E)(i): benefit improvements while a suspension remains are permitted only with equitable improvements and an actuarial certification of solvency";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan sponsor may, in its sole discretion, provide benefit improvements while any suspension of benefits under the plan remains in effect")
rule BenefitImprovementDuringSuspensionPermitted(plan: MultiemployerPlan) strict {
    label en official "PARTIAL: (i) only; the liability caps of clauses (ii)-(v) are not derived";
    when sponsor_elects_no_benefit_improvements_432(plan) and improvement_with_certified_solvency_and_equitable_432(plan);
    then benefit_improvement_during_suspension_permitted_432e9e(plan);
}

// =====================================================================
// (h) Expedited dispute resolution
// =====================================================================

pub relation plan_due_date_for_adoption_432(plan: MultiemployerPlan, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the due date for adoption of the funding improvement plan or the rehabilitation plan, case-asserted (section 432(h))";
}

pub relation plan_sponsor_group_member_432(member: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the person is a member of the board or group that constitutes the plan sponsor, case-asserted";
}

pub relation evaluated_on_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date on which the state of agreement is evaluated, case-asserted";
}

pub relation no_agreement_on_plan_within_60_days_432h(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(h): 60 days after the due date the sponsor has still not agreed on a funding improvement or rehabilitation plan";
}

pub relation plan_agreed_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor has agreed on the funding improvement plan or rehabilitation plan, case-asserted";
}

@source(IRC_S432_H, relation = formalizes, coverage = exact, quote = "If, within 60 days of the due date for adoption of a funding improvement plan under subsection (c) or a rehabilitation plan under subsection (e), the plan sponsor of a plan in endangered status or a plan in critical status has not agreed")
rule NoAgreementWithin60Days(plan: MultiemployerPlan, y: TaxableYear, due: Date, on: Date) strict {
    label en official "exact boundary: the 60th day after the due date is still within the period; the day after is the first day the right exists";
    when plan_due_date_for_adoption_432(plan, y, due)
        and evaluated_on_432(plan, y, on)
        and on > add_calendar_period(due, 60 calendar_day)
        and not_known(plan_agreed_432(plan, y));
    then no_agreement_on_plan_within_60_days_432h(plan, y);
}

pub relation member_requires_expedited_procedure_432(member: Person, plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "a member of the board or group requires the plan sponsor to enter an expedited dispute resolution procedure, case-asserted";
}

pub relation expedited_dispute_resolution_required_432(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(h): the sponsor must enter an expedited dispute resolution procedure";
}

@source(IRC_S432_H, relation = formalizes, coverage = partial, quote = "then any member of the board or group that constitutes the plan sponsor may require that the plan sponsor enter into an expedited dispute resolution procedure")
rule RequireExpeditedProcedurePower(member: Person, plan: MultiemployerPlan, y: TaxableYear, on: Date, sponsor: Person) strict {
    label en official "PARTIAL: the procedure and its timetable are not derived";
    when member_requires_expedited_procedure_432(member, plan, y, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then power RequireExpeditedDisputeResolution {
        holder member;
        over sponsor;
        exercise member_requires_expedited_procedure_432(member, plan, y, on);
        valid_when no_agreement_on_plan_within_60_days_432h(plan, y);
        effect expedited_dispute_resolution_required_432(plan, y);
    };
}

// =====================================================================
// (k) Special financial assistance
// =====================================================================

pub relation plan_year_begins_in_2020_to_2022_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan year begins in 2020 through 2022, case-asserted (section 432(k)(3)(A))";
}

pub relation suspension_approved_before_sfa_enactment_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "a suspension of benefits was approved under subsection (e)(9) as of the date of enactment of the American Rescue Plan Act of 2021, case-asserted ((3)(A)(ii))";
}

pub relation modified_funded_percentage_inputs_432(plan: MultiemployerPlan, assets: Money, current_liabilities: Money) kind empirical {
    label en unofficial "the current value of plan assets and current liabilities (section 431(c)(6)(D)), case-asserted ((k)(3)(B))";
}

pub relation insolvent_after_dec_16_2014_and_not_terminated_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan became insolvent within the meaning of section 418E after December 16, 2014, has remained insolvent and has not been terminated, case-asserted ((3)(A)(iv))";
}

pub relation eligible_multiemployer_plan_432k3(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(3)(A): critical and declining in 2020-2022, or a suspension approved, or critical with modified funded percentage under 40 percent and active-to-inactive ratio under 2 to 3, or insolvent since December 16, 2014";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "the plan is in critical and declining status in any plan year beginning in 2020 through 2022")
rule EligibleMultiemployerPlanCriticalAndDeclining(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(i)";
    when critical_and_declining_status_432b6(plan, y) and plan_year_begins_in_2020_to_2022_432(plan, y);
    then eligible_multiemployer_plan_432k3(plan);
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "a suspension of benefits has been approved with respect to the plan under subsection (e)(9)")
rule EligibleMultiemployerPlanSuspensionApproved(plan: MultiemployerPlan) strict {
    label en official "(ii)";
    when suspension_approved_before_sfa_enactment_432(plan);
    then eligible_multiemployer_plan_432k3(plan);
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "has a modified funded percentage of less than 40 percent, and has a ratio of active to inactive participants which is less than 2 to 3")
rule EligibleMultiemployerPlanLowFunded(plan: MultiemployerPlan, y: TaxableYear, assets: Money, liabilities: Money, inactive: Integer, active: Integer) strict {
    label en official "exact by cross-multiplication: assets x 100 < liabilities x 40 and active x 3 < inactive x 2";
    when critical_status_432(plan, y)
        and plan_year_begins_in_2020_to_2022_432(plan, y)
        and modified_funded_percentage_inputs_432(plan, assets, liabilities)
        and inactive_and_active_participant_counts_432(plan, y, inactive, active)
        and liabilities > 0.00 USD
        and assets * 100.0 < liabilities * 40.0
        and active * 3 < inactive * 2;
    then eligible_multiemployer_plan_432k3(plan);
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "the plan became insolvent within the meaning of section 418E after December 16, 2014")
rule EligibleMultiemployerPlanInsolvent(plan: MultiemployerPlan) strict {
    label en official "(iv)";
    when insolvent_after_dec_16_2014_and_not_terminated_432(plan);
    then eligible_multiemployer_plan_432k3(plan);
}

pub relation sfa_effective_on_432(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the effective date of the special financial assistance, case-asserted (section 432(k)(2)(A))";
}

pub relation suspended_benefits_reinstated_432(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan reinstated benefits suspended under subsection (e)(9) or section 4245(a) of ERISA and paid the amounts previously suspended, case-asserted";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "reinstate any benefits that were suspended under subsection (e)(9) or section 4245(a)")
rule ReinstateSuspendedBenefitsDuty(plan: MultiemployerPlan, sponsor: Person, party: Person, eff_on: Date) strict {
    label en official "PARTIAL: reinstatement and the lump sum within 3 months of the effective date (the alternative 5-year installments are the second limb, not derived)";
    when eligible_multiemployer_plan_432k3(plan)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party)
        and sfa_effective_on_432(plan, eff_on);
    then duty ReinstateSuspendedBenefitsDutyPosition {
        bearer sponsor;
        beneficiary party;
        goal achievement {
            condition suspended_benefits_reinstated_432(plan);
            window [-infinity, add_calendar_period(eff_on, 3 calendar_month)];
        }
    };
}

pub relation applies_for_new_suspension_432(sponsor: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor applies for a new suspension of benefits under subsection (e)(9)(G), case-asserted";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "The plan shall not be eligible to apply for a new suspension of benefits under subsection (e)(9)(G).")
rule ProhibitionToApplyForNewSuspensionAfterSfa(sponsor: Person, plan: MultiemployerPlan, eff_on: Date) strict {
    label en official "from the effective date of the special financial assistance";
    when multiemployer_plan_sponsor_432(plan, sponsor) and sfa_effective_on_432(plan, eff_on);
    then prohibition ApplyForNewSuspensionAfterSfa {
        bearer sponsor;
        action applies_for_new_suspension_432(sponsor, plan);
        window [eff_on, infinity];
    };
}

// ---------------------------------------------------------------------
// (j)(7) obligation to contribute (G6-ERISA wire). G4-pattern: the ERISA
// §4212(a) meaning is a case-selected classification fact — the package
// does NOT re-derive ERISA. Pinned definition in `us.erisa.definitions`
// (erisa-sec4212-29usc1391-2023.pdf).
// ---------------------------------------------------------------------

pub relation obligation_to_contribute_erisa_4212a(employer: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the employer has an obligation to contribute within the meaning of ERISA section 4212(a) (29 USC 1391, pinned in us.erisa.definitions), case-asserted";
}

pub relation contributing_employer_432j7(employer: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(j)(7): an employer with an obligation to contribute under ERISA section 4212(a)";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "The term \"obligation to contribute\" has the meaning given such term under section 4212(a) of the Employee Retirement Income Security Act of 1974.")
rule ContributingEmployer432j7(employer: Person, plan: MultiemployerPlan) strict {
    label en official "the 4212(a) meaning is asserted, not derived";
    when obligation_to_contribute_erisa_4212a(employer, plan);
    then contributing_employer_432j7(employer, plan);
}
