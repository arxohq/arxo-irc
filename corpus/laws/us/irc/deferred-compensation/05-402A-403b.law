// Section 402A — Roth contributions; section 403(b) — annuities for public
// schools/501(c)(3) organizations. Stage 1 (IRC-09), DECISION-0379. 402A
// modelled to the extent PLAN family 8 requires (Roth election, treatment
// of designated Roth contributions as includible, not excludible);
// section 403(b) modelled BRIEFLY (eligibility contract and limit
// cross-reference) — full 403(b) formalization (church/school-specific
// rules, the (b)(1)(E) universal-availability requirement, the (c) custodial
// account and (b)(7)/(b)(9) shapes) is stage 2.


// =====================================================================
// 402A — Designated Roth contributions
// =====================================================================

use self::{
    IRC_S402A_A,
    IRC_S403_B,
    Person,
    Plan,
    TaxableYear,
    aggregate_elective_deferrals,
    has_excess_deferral,
};

pub relation qualified_roth_contribution_program(plan: Plan) kind empirical {
    label en unofficial "the plan maintains a qualified Roth contribution program with separate accounting for designated Roth accounts (section 402A(b)), case-asserted";
}

pub relation roth_election_made(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the participant's irrevocable election to treat all or a portion of an elective deferral as a designated Roth contribution (section 402A(c)(1)), case-asserted";
}

pub relation designated_roth_contribution(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402A(a)(1)/(c)(1): a designated Roth contribution is treated as an elective deferral not excludible from gross income";
}

@source(IRC_S402A_A, relation = formalizes, coverage = exact, quote = "any designated Roth contribution made by an employee pursuant to the program shall be treated as an elective deferral for purposes of this chapter, except that such contribution shall not be excludable from gross income")
rule DesignatedRothContribution(participant: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "a valid Roth election under a qualified Roth contribution program produces a (non-excludible) designated Roth contribution of the elected amount";
    when qualified_roth_contribution_program(plan) and roth_election_made(participant, plan, y, amount);
    then designated_roth_contribution(participant, plan, y, amount);
}

// =====================================================================
// 403(b) — brief contract
// =====================================================================
pub relation eligible_403b_employer(employer: Person) kind empirical {
    label en unofficial "the employer is described in section 501(c)(3) or is an educational institution described in section 170(b)(1)(A)(ii) (section 403(b)(1)(A)), case-asserted; the full employer/employee eligibility and universal-availability tests are stage 2";
}

pub relation section_403b_annuity_contribution(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution to purchase a section 403(b) annuity contract, case-asserted";
}

pub relation section_403b_contribution_within_402g_limit(participant: Person, y: TaxableYear) kind institutional {
    label en official "the participant's section 403(b) salary-reduction contributions, aggregated with other elective deferrals, do not exceed the section 402(g) limit (cross-reference; the 15-years-of-service special catch-up of section 402(g)(7) is NOT modelled, stage 2)";
}

@source(IRC_S403_B, relation = formalizes, coverage = contextual, quote = "for an employee by an employer described in section 501(c)(3) which is exempt from tax under section 501(a)")
rule Section403bWithinLimit(participant: Person, y: TaxableYear) strict {
    label en official "wires the section 402(g) aggregate-deferral limit to a 403(b) contributor (brief; does not model 403(b)'s own additional limits under (b)(1)(E)/(c))";
    when aggregate_elective_deferrals(participant, y, _) and not_known(has_excess_deferral(participant, y));
    then section_403b_contribution_within_402g_limit(participant, y);
}
