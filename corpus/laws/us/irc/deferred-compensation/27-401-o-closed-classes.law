// Section 401(o) — nondiscrimination relief for closed classes of
// participants, STAGE 2e residual (IRC-09, DECISION-0379, 25.09.2026).
//
// Method: the relief is a classification of the plan ("the plan shall not
// fail (a)(4) by reason of the composition of the closed class"), built from
// case facts about the class and exact arithmetic for the tests that name a
// number ("more than 50 percent greater"). The 3-year testing (A)(i), the
// no-significant-discrimination amendments (A)(ii) and similar plan-history
// facts are case-asserted: they are themselves section 401(a)(4) and 410(b)
// determinations. Counts are Integers; "more than 50 percent greater" is the
// exact comparison end x 100 > start x 150.

use self::{
    IRC_S401_O,
    Plan,
};

pub relation class_closed_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the class of participants was closed on this date, case-asserted (section 401(o)(1)(A))";
}

pub relation predecessor_plan_in_effect_years(plan: Plan, years: Decimal) kind empirical {
    label en unofficial "the number of years the plan, taking into account any predecessor plan, has been in effect as of the date the class is closed, case-asserted (section 401(o)(1)(C)(i))";
}

pub relation participants_at_start_of_five_year_period(plan: Plan, count: Integer) kind empirical {
    label en unofficial "the number of participants covered by the benefits, rights or features on the first day of the plan year in which the 5-year period began, case-asserted";
}

pub relation participants_at_end_of_five_year_period(plan: Plan, count: Integer) kind empirical {
    label en unofficial "the number covered on the date the 5-year period ends, case-asserted";
}

pub relation participants_added_by_merger_or_acquisition(plan: Plan, count: Integer) kind empirical {
    label en unofficial "participants who joined by a merger, acquisition or similar event in the 7-year period before the closing, or by a merger with a plan in effect at least 5 years (conformed prospectively), disregarded under (F), case-asserted";
}

pub relation amendments_substantially_increased_value(plan: Plan) kind empirical {
    label en unofficial "amendments modified the benefits, rights or features so that, at closing, their value to the closed class as a whole is substantially greater than at the start of the 5-year period, solely as a result of the amendments, case-asserted (section 401(o)(1)(D)(ii))";
}

pub relation substantial_increase_in_coverage_or_value_401o1D(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(D): more than 50 percent more participants covered, or amendments substantially raising the value";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the number of participants covered by such benefits, rights, or features on the date such period ends is more than 50 percent greater than the number of such participants on the first day of the plan year in which such period began")
rule SubstantialIncrease401o1DCount(plan: Plan, start: Integer, finish: Integer, merged: Integer) strict {
    label en official "exact by cross-multiplication after disregarding merger participants (F): (end - merged) x 100 > start x 150";
    when participants_at_start_of_five_year_period(plan, start)
        and participants_at_end_of_five_year_period(plan, finish)
        and participants_added_by_merger_or_acquisition(plan, merged)
        and (finish - merged) * 100 > start * 150;
    then substantial_increase_in_coverage_or_value_401o1D(plan);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "such benefits, rights, and features have been modified by 1 or more plan amendments in such a way that, as of the date the class is closed, the value of such benefits, rights, and features to the closed class as a whole is substantially greater")
rule SubstantialIncrease401o1DAmendments(plan: Plan) strict {
    label en official "clause (ii)";
    when amendments_substantially_increased_value(plan);
    then substantial_increase_in_coverage_or_value_401o1D(plan);
}

pub relation average_benefit_at_start(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the average benefit provided to participants on the first day of the plan year in which the 5-year period began, case-asserted (section 401(o)(1)(E)(ii))";
}

pub relation average_benefit_at_end(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the average benefit provided on the date the period ends, case-asserted";
}

pub relation benefit_formula_changed_between_dates(plan: Plan) kind empirical {
    label en unofficial "the benefit formula applicable to one or more participants changed between the two dates, case-asserted (section 401(o)(1)(G))";
}

pub relation normal_cost_total_at_end_formula(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the total amount under section 430(b)(1)(A)(i) (normal cost under a CSEC plan: section 433(j)(1)(B)) for all participants in the plan year the 5-year period ends, case-asserted";
}

pub relation normal_cost_total_at_start_formula(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the same total using the benefit formula in effect for each participant for the first plan year of the 5-year period, case-asserted";
}

pub relation average_benefit_increased_over_50_percent(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(E)(ii)/(G): the average benefit rose more than 50 percent, measured by the average benefit or, when the formula changed, by the two normal-cost totals";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the average benefit provided to such participants on the date such period ends is more than 50 percent greater than the average benefit provided on the first day of the plan year in which such period began")
rule AverageBenefitIncreasedOver50Percent(plan: Plan, start: Money, finish: Money) strict {
    label en official "exact: end > 1.5 x start, when the formula did not change the average benefit is treated as unchanged (G)(i)";
    when average_benefit_at_start(plan, start)
        and average_benefit_at_end(plan, finish)
        and benefit_formula_changed_between_dates(plan)
        and finish > start * 1.5;
    then average_benefit_increased_over_50_percent(plan);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "by more than 50 percent")
rule AverageBenefitIncreasedOver50PercentNormalCost(plan: Plan, start: Money, finish: Money) strict {
    label en official "(G)(ii): with a formula change, the normal cost totals decide";
    when benefit_formula_changed_between_dates(plan)
        and normal_cost_total_at_start_formula(plan, start)
        and normal_cost_total_at_end_formula(plan, finish)
        and finish > start * 1.5;
    then average_benefit_increased_over_50_percent(plan);
}

pub relation class_closed_before_april_5_2017(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(A)(iii)/(B)(iii)(IV): the class was closed before April 5, 2017";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the class was closed before April 5, 2017, or the plan is described in subparagraph (C)")
rule ClassClosedBeforeApril52017(plan: Plan, on: Date) strict {
    label en official "exact boundary: April 4, 2017 is before, April 5, 2017 is not";
    when class_closed_on(plan, on) and on < @2017-04-05;
    then class_closed_before_april_5_2017(plan);
}

pub relation plan_described_in_401o1C_for_A(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(C): in effect at least 5 years at closing and no substantial increase in the coverage or value of the class's benefits during the preceding 5 years";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "such plan has been in effect for at least 5 years as of the date the class is closed")
rule PlanDescribedIn401o1CForA(plan: Plan, years: Decimal) strict {
    label en official "exact boundary: 5 years qualifies";
    when predecessor_plan_in_effect_years(plan, years) and years >= 5.0 and not_known(substantial_increase_in_coverage_or_value_401o1D(plan));
    then plan_described_in_401o1C_for_A(plan);
}

pub relation plan_described_in_401o1C_for_B(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(C) as applied to (B)(iii)(IV): in effect 5 years, and no more than 50 percent growth in participants or average benefit";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the number of participants benefitting under the plan on the date such period ends is more than 50 percent greater than the number of such participants on the first day of the plan year in which such period began")
rule PlanDescribedIn401o1CForB(plan: Plan, years: Decimal) strict {
    label en official "5 years in effect and neither test of (E) triggered";
    when predecessor_plan_in_effect_years(plan, years) and years >= 5.0
        and not_known(substantial_increase_in_coverage_or_value_401o1D(plan))
        and not_known(average_benefit_increased_over_50_percent(plan));
    then plan_described_in_401o1C_for_B(plan);
}

pub relation db_benefits_satisfy_401a4_for_3_years(plan: Plan) kind empirical {
    label en unofficial "for the plan year in which the class closes and the 2 succeeding plan years the benefits, rights and features satisfy section 401(a)(4) (applying the (I) rules), case-asserted (section 401(o)(1)(A)(i))";
}

pub relation amendments_not_significantly_discriminatory(plan: Plan) kind empirical {
    label en unofficial "after the closing date any amendment modifying the closed class or its benefits does not discriminate significantly in favor of highly compensated employees, case-asserted (A)(ii)";
}

pub relation closed_class_relief_401o1A(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(A): a defined benefit plan providing benefits, rights or features to a closed class does not fail (a)(4) by reason of the composition of the class, if (i)-(iii)";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "shall not fail to satisfy the requirements of subsection (a)(4) by reason of the composition of such closed class or the benefits, rights, or features provided to such closed class")
rule ClosedClassRelief401o1AEarly(plan: Plan) defeasible {
    label en official "(i), (ii) and the pre-April-5-2017 closing";
    when db_benefits_satisfy_401a4_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and class_closed_before_april_5_2017(plan);
    then closed_class_relief_401o1A(plan);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the class was closed before April 5, 2017, or the plan is described in subparagraph (C)")
rule ClosedClassRelief401o1ALater(plan: Plan) defeasible {
    label en official "(i), (ii) and a plan described in (C)";
    when db_benefits_satisfy_401a4_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and plan_described_in_401o1C_for_A(plan);
    then closed_class_relief_401o1A(plan);
}

pub relation db_plan_satisfies_410b_and_401a4_for_3_years(plan: Plan) kind empirical {
    label en unofficial "for the plan year the class closes and the 2 succeeding years the plan satisfies section 410(b) and (a)(4) (applying the (I) rules), case-asserted (section 401(o)(1)(B)(iii)(II))";
}

pub relation db_plan_described_in_401o1B_iii(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(B)(iii): a plan providing benefits to a closed class that meets the 3-year test, the amendment condition and the closing-date or (C) condition";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "A defined benefit plan is described in this clause if")
rule DbPlanDescribedIn401o1BiiiEarly(plan: Plan) strict {
    label en official "(I)-(III) and (IV) by closing before April 5, 2017";
    when db_plan_satisfies_410b_and_401a4_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and class_closed_before_april_5_2017(plan);
    then db_plan_described_in_401o1B_iii(plan);
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "A defined benefit plan is described in this clause if")
rule DbPlanDescribedIn401o1BiiiLater(plan: Plan) strict {
    label en official "(I)-(III) and (IV) by a plan described in (C)";
    when db_plan_satisfies_410b_and_401a4_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and plan_described_in_401o1C_for_B(plan);
    then db_plan_described_in_401o1B_iii(plan);
}

pub relation db_plan_may_be_aggregated_and_tested_on_benefits_basis(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(B)(i): a plan described in clause (iii) may be aggregated and tested on a benefits basis with defined contribution plans (or portions)";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "a defined benefit plan described in clause (iii) may be aggregated and tested on a benefits basis with 1 or more defined contribution plans")
rule DbPlanMayBeAggregated(plan: Plan) strict {
    label en official "permission for a clause (iii) plan";
    when db_plan_described_in_401o1B_iii(plan);
    then db_plan_may_be_aggregated_and_tested_on_benefits_basis(plan);
}

pub relation dc_portion_provides_matching(plan: Plan) kind empirical {
    label en unofficial "the aggregated defined contribution portion provides matching contributions, case-asserted (B)(ii)";
}

pub relation dc_portion_provides_elective_deferrals_also_aggregated(plan: Plan) kind empirical {
    label en unofficial "the portion of the defined contribution plan providing elective deferrals is also aggregated with the defined benefit plan, case-asserted (B)(ii)(I)";
}

pub relation aggregation_with_matching_portion_valid(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(B)(ii): when aggregated with a matching-contribution portion, the elective deferral portion must be aggregated too; matches are treated as nonelective contributions";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "such defined benefit plan must also be aggregated with any portion of such defined contribution plan which provides elective deferrals")
rule AggregationWithMatchingPortionValid(plan: Plan) strict {
    label en official "the elective deferral portion accompanies the matching portion";
    when db_plan_may_be_aggregated_and_tested_on_benefits_basis(plan)
        and dc_portion_provides_matching(plan)
        and dc_portion_provides_elective_deferrals_also_aggregated(plan);
    then aggregation_with_matching_portion_valid(plan);
}

pub relation class_closing_not_significant_change_401o1I(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(I)(i): the closing of the class is not a significant change in coverage under section 410(b)(6)(C)(i)(II)";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the closing of the class of participants shall not be treated as a significant change in coverage under section 410(b)(6)(C)(i)(II)")
rule ClassClosingNotSignificantChange(plan: Plan, on: Date) strict {
    label en official "the rule applies once the class is closed";
    when class_closed_on(plan, on);
    then class_closing_not_significant_change_401o1I(plan);
}

pub relation plans_have_different_plan_years(plan1: Plan, plan2: Plan) kind empirical {
    label en unofficial "two plans have different plan years, case-asserted";
}

pub relation plans_eligible_for_aggregation_despite_plan_years(plan1: Plan, plan2: Plan) kind institutional {
    label en official "section 401(o)(1)(I)(ii): two plans are not ineligible for aggregation solely because of different plan years";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "2 or more plans shall not fail to be eligible to be aggregated and treated as a single plan solely by reason of having different plan years")
rule PlansEligibleForAggregationDespitePlanYears(plan1: Plan, plan2: Plan) strict {
    label en official "different plan years alone do not bar aggregation";
    when plans_have_different_plan_years(plan1, plan2);
    then plans_eligible_for_aggregation_despite_plan_years(plan1, plan2);
}

pub relation plan_covered_by_section_413c(plan: Plan) kind empirical {
    label en unofficial "the plan is a plan described in section 413(c), case-asserted";
}

pub relation multiple_employer_plan_treated_as_single_401o1H(plan: Plan) kind institutional {
    label en official "section 401(o)(1)(H): a section 413(c) plan is one plan, not separate plans of each employer, for subparagraphs (E) and (G)";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "a plan described in section 413(c) shall be treated as a single plan rather than as separate plans maintained by each employer in the plan")
rule MultipleEmployerPlanTreatedAsSingle(plan: Plan) strict {
    label en official "single plan";
    when plan_covered_by_section_413c(plan);
    then multiple_employer_plan_treated_as_single_401o1H(plan);
}

// (o)(2) Defined contribution plans: make-whole contributions ---------------

pub relation dc_provides_make_whole_to_closed_class(plan: Plan) kind empirical {
    label en unofficial "the defined contribution plan provides make-whole contributions to a closed class whose accruals under a defined benefit plan were reduced or eliminated, case-asserted (401(o)(2)(A)(i))";
}

pub relation closed_class_satisfies_410b2Ai_for_3_years(plan: Plan) kind empirical {
    label en unofficial "for the plan year the class closes and the 2 succeeding years the closed class satisfies section 410(b)(2)(A)(i) (applying the (1)(I) rules), case-asserted ((2)(A)(ii))";
}

pub relation dc_class_closed_before_2017_or_db_plan_in_C(plan: Plan, class_closed: Date) kind empirical {
    label en unofficial "the class was closed on this date, and whether the defined benefit plan is described in (1)(C) as applied for (1)(B)(iii)(IV), case-asserted ((2)(A)(iv))";
}

pub relation db_plan_under_A_i_described_in_1C(plan: Plan) kind empirical {
    label en unofficial "the defined benefit plan of clause (i) is described in paragraph (1)(C) as applied for paragraph (1)(B)(iii)(IV), case-asserted";
}

pub relation dc_plan_may_be_tested_on_benefits_basis_401o2A(plan: Plan) kind institutional {
    label en official "section 401(o)(2)(A): a defined contribution plan with make-whole contributions to a closed class may be tested on a benefits basis if (i)-(iv)";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "A defined contribution plan shall be permitted to be tested on a benefits basis if")
rule DcPlanMayBeTestedOnBenefitsBasis(plan: Plan, closed: Date) strict {
    label en official "(i)-(iii) and (iv): closed before April 5, 2017, or the defined benefit plan is described in (1)(C)";
    when dc_provides_make_whole_to_closed_class(plan)
        and closed_class_satisfies_410b2Ai_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and dc_class_closed_before_april_5_2017_fact(plan, closed)
        and closed < @2017-04-05;
    then dc_plan_may_be_tested_on_benefits_basis_401o2A(plan);
}

pub relation dc_class_closed_before_april_5_2017_fact(plan: Plan, closed: Date) kind empirical {
    label en unofficial "the date the closed class of the defined contribution plan was closed, case-asserted";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the class was closed before April 5, 2017, or the defined benefit plan under clause (i) is described in paragraph (1)(C)")
rule DcPlanMayBeTestedOnBenefitsBasisLater(plan: Plan) strict {
    label en official "(iv) via the (1)(C) route";
    when dc_provides_make_whole_to_closed_class(plan)
        and closed_class_satisfies_410b2Ai_for_3_years(plan)
        and amendments_not_significantly_discriminatory(plan)
        and db_plan_under_A_i_described_in_1C(plan);
    then dc_plan_may_be_tested_on_benefits_basis_401o2A(plan);
}

pub relation make_whole_contribution_reasonably_calculated(plan: Plan) kind empirical {
    label en unofficial "the nonelective allocations for each employee in the class are reasonably calculated, in a consistent manner, to replace some or all of the retirement benefits the employee would have received had no change been made, case-asserted (401(o)(3)(A))";
}

pub relation make_whole_contributions_401o3A(plan: Plan) kind institutional {
    label en official "section 401(o)(3)(A): nonelective allocations reasonably calculated in a consistent manner to replace lost benefits";
}

@source(IRC_S401_O, relation = formalizes, coverage = exact, quote = "the term \"make-whole contributions\" means nonelective allocations for each employee in the class which are reasonably calculated, in a consistent manner, to replace some or all of the retirement benefits")
rule MakeWholeContributions401o3A(plan: Plan) strict {
    label en official "the definition applied to the plan's allocations";
    when make_whole_contribution_reasonably_calculated(plan);
    then make_whole_contributions_401o3A(plan);
}
