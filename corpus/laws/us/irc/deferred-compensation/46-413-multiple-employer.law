// Section 413 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): collectively
// bargained plans and plans maintained by more than one employer. The module
// derives the classifications on which the deeming rules of the section turn:
// (a) plans to which subsection (b) applies, (c)(4)(A) and (c)(6)(A) the
// separate-plan treatment of plans established after 1988, and (e) the relief
// for pooled employer plans with the definition of a pooled plan provider.
//
// Method: classifications by conjunction of case-asserted facts; the date
// threshold is an exact comparison. The deeming rules themselves (testing
// other sections as if all employees were employed by a single employer) are
// not performed here: they are the aggregation the other modules take as
// input (see the coverage rows).

// =====================================================================
// (a) Collectively bargained plans
// =====================================================================

use self::{
    IRC_S413_A,
    IRC_S413_C,
    IRC_S413_E,
    Person,
    Plan,
};

pub relation plan_under_collective_bargaining_agreement_413a(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained pursuant to an agreement the Secretary of Labor finds to be a collective bargaining agreement between employee representatives and one or more employers, case-asserted (section 413(a)(1))";
}

pub relation subsection_413b_applies_413a(plan: Plan) kind institutional {
    label en official "section 413(a): subsection (b) applies to a collectively bargained plan and each trust that is part of it";
}

@source(IRC_S413_A, relation = formalizes, coverage = exact, quote = "a plan maintained pursuant to an agreement which the Secretary of Labor finds to be a collective-bargaining agreement between employee representatives and one or more employers")
rule Subsection413bApplies413a(plan: Plan) strict {
    label en official "(1); the trust of (2) follows the plan";
    when plan_under_collective_bargaining_agreement_413a(plan);
    then subsection_413b_applies_413a(plan);
}

// =====================================================================
// (c) Plans maintained by more than one employer
// =====================================================================

pub relation plan_maintained_by_more_than_one_employer_413c(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained by more than one employer, case-asserted (section 413(c))";
}

pub relation plan_established_on_413c(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the plan is established, case-asserted";
}

pub relation method_ensures_separate_plan_minimum_413c4A(plan: Plan) kind empirical {
    label en unofficial "the plan uses a method of determining required contributions under which each employer contributes at least what it would if it maintained a separate plan, case-asserted ((c)(4)(A))";
}

pub relation each_employer_separate_plan_for_412_413c4A(plan: Plan) kind institutional {
    label en official "section 413(c)(4)(A): for a plan established after 1988 each employer is treated as maintaining a separate plan for the minimum funding standard, unless the plan's method guarantees each employer's separate-plan contribution";
}

@source(IRC_S413_C, relation = formalizes, coverage = exact, quote = "In the case of a plan established after December 31, 1988, each employer shall be treated as maintaining a separate plan for purposes of section 412")
rule EachEmployerSeparatePlanFor412413c4A(plan: Plan, est: Date) strict {
    label en official "exact boundary: established on or after January 1, 1989; a plan established on December 31, 1988 is outside";
    when plan_maintained_by_more_than_one_employer_413c(plan)
        and plan_established_on_413c(plan, est)
        and est > @1988-12-31
        and not_known(method_ensures_separate_plan_minimum_413c4A(plan));
    then each_employer_separate_plan_for_412_413c4A(plan);
}

pub relation each_employer_separate_plan_for_404_413c6A(plan: Plan) kind institutional {
    label en official "section 413(c)(6)(A): for a plan established after 1988 each section 404(a) limitation is determined as if each employer maintained a separate plan";
}

@source(IRC_S413_C, relation = formalizes, coverage = exact, quote = "In the case of a plan established after December 31, 1988, each applicable limitation provided by section 404(a)")
rule EachEmployerSeparatePlanFor404413c6A(plan: Plan, est: Date) strict {
    label en official "exact boundary: established on or after January 1, 1989";
    when plan_maintained_by_more_than_one_employer_413c(plan) and plan_established_on_413c(plan, est) and est > @1988-12-31;
    then each_employer_separate_plan_for_404_413c6A(plan);
}

// =====================================================================
// (e) Pooled employer plans
// =====================================================================

pub relation pooled_plan_defined_contribution_413c_413e1(plan: Plan) kind empirical {
    label en unofficial "the plan is a defined contribution plan to which subsection (c) applies, case-asserted (section 413(e)(1))";
}

pub relation employers_share_common_interest_413e1A(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained by employers that have a common interest other than having adopted the plan, case-asserted ((A))";
}

pub relation plan_has_pooled_plan_provider_413e1B(plan: Plan) kind empirical {
    label en unofficial "the plan has a pooled plan provider, case-asserted ((B))";
}

pub relation plan_terms_transfer_and_liability_413e2A(plan: Plan) kind empirical {
    label en unofficial "the plan terms provide that on an employer's failure the assets attributable to its employees are transferred to a plan of that employer, an eligible retirement plan or another arrangement, and that the employer, not the plan or another employer, is liable for the liabilities attributable to its employees, case-asserted ((e)(2)(A)(i), (ii))";
}

pub relation ppp_performs_substantially_all_duties_413e2B(plan: Plan) kind empirical {
    label en unofficial "the pooled plan provider performs substantially all of the administrative duties required of it for the plan year, case-asserted ((e)(2)(B))";
}

pub relation pooled_plan_relief_413e1(plan: Plan) kind institutional {
    label en official "section 413(e)(1)-(2): the plan is not treated as failing plan requirements because of an employer's failure, when it has a common interest group or a pooled plan provider and the plan terms provide the transfer and liability rules";
}

@source(IRC_S413_E, relation = formalizes, coverage = partial, quote = "then the plan shall not be treated as failing to meet the requirements under this title applicable to a plan d")
rule PooledPlanReliefCommonInterest413e1(plan: Plan) strict {
    label en official "PARTIAL: (A) common interest employers with the (2)(A) plan terms";
    when pooled_plan_defined_contribution_413c_413e1(plan) and employers_share_common_interest_413e1A(plan) and plan_terms_transfer_and_liability_413e2A(plan);
    then pooled_plan_relief_413e1(plan);
}

@source(IRC_S413_E, relation = formalizes, coverage = partial, quote = "in the case of a plan not described in subparagraph (A), has a pooled plan provider")
rule PooledPlanReliefProvider413e1(plan: Plan) strict {
    label en official "PARTIAL: (B) a pooled plan provider that performs substantially all of its duties, with the (2)(A) plan terms; the Secretary's determination when it does not is not derived";
    when pooled_plan_defined_contribution_413c_413e1(plan)
        and not_known(employers_share_common_interest_413e1A(plan))
        and plan_has_pooled_plan_provider_413e1B(plan)
        and plan_terms_transfer_and_liability_413e2A(plan)
        and ppp_performs_substantially_all_duties_413e2B(plan);
    then pooled_plan_relief_413e1(plan);
}

pub relation person_designated_named_fiduciary_and_administrator_413e3Ai(person: Person, plan: Plan) kind empirical {
    label en unofficial "the person is designated by the plan terms as named fiduciary, plan administrator and the person responsible for all administrative duties, case-asserted (section 413(e)(3)(A)(i))";
}

pub relation person_registered_as_ppp_413e3Aii(person: Person) kind empirical {
    label en unofficial "the person registers as a pooled plan provider with the Secretary before beginning operations, case-asserted ((ii))";
}

pub relation person_acknowledged_fiduciary_413e3Aiii(person: Person, plan: Plan) kind empirical {
    label en unofficial "the person acknowledges in writing that it is a named fiduciary and the plan administrator, case-asserted ((iii))";
}

pub relation person_ensures_bonding_413e3Aiv(person: Person, plan: Plan) kind empirical {
    label en unofficial "the person is responsible for ensuring that everyone who handles plan assets is bonded, case-asserted ((iv))";
}

pub relation pooled_plan_provider_413e3A(person: Person, plan: Plan) kind institutional {
    label en official "section 413(e)(3)(A): a person designated as fiduciary and administrator, registered, acknowledging its role, and responsible for bonding";
}

@source(IRC_S413_E, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, the term \"pooled plan provider\" means, with respect to any plan, a person who")
rule PooledPlanProvider413e3A(person: Person, plan: Plan) strict {
    label en official "PARTIAL: (i)-(iv); the administrative duties of clause (i) are inside the asserted designation";
    when person_designated_named_fiduciary_and_administrator_413e3Ai(person, plan)
        and person_registered_as_ppp_413e3Aii(person)
        and person_acknowledged_fiduciary_413e3Aiii(person, plan)
        and person_ensures_bonding_413e3Aiv(person, plan);
    then pooled_plan_provider_413e3A(person, plan);
}

pub relation employer_in_plan_with_ppp_413e3D(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer is an employer in a plan that has a pooled plan provider, case-asserted (section 413(e)(3)(D))";
}

pub relation employer_treated_as_plan_sponsor_for_portion_413e3D(employer: Person, plan: Plan) kind institutional {
    label en official "section 413(e)(3)(D): each employer is treated as the plan sponsor for the portion attributable to its employees, except the administrative duties of the pooled plan provider";
}

@source(IRC_S413_E, relation = formalizes, coverage = partial, quote = "each employer in a plan which has a pooled plan provider shall be treated as the plan sponsor with respect to the portion of the plan attributable to employees of such employer")
rule EmployerTreatedAsPlanSponsor413e3D(employer: Person, plan: Plan) strict {
    label en official "PARTIAL: the exception for the provider's administrative duties is not gated";
    when employer_in_plan_with_ppp_413e3D(employer, plan);
    then employer_treated_as_plan_sponsor_for_portion_413e3D(employer, plan);
}
