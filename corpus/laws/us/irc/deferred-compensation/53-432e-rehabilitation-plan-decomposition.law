// Section 432(e)(1)-(8) — STAGE 3 (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): the rehabilitation plan for multiemployer plans in
// critical status, decomposed. Stage 2f (module 29) carried the adoption duty,
// the 5/10 percent surcharge, the 30-day adjustable-benefit notice and the
// rehabilitation period end. This module adds what was left as TECH_GAP:
// the default schedule and its accrual floor, the content and annual update of
// the rehabilitation plan, imposition of the default schedule after a
// collective bargaining agreement expires, emergence and re-entry, the
// adoption period, surcharge enforcement/cessation/notice, and the
// adjustable-benefit reductions (definition, retiree exception, notice
// content and form). The benefit suspensions of paragraph (9) are in module 54.
//
// Method: a content requirement is a conjunction of positive case facts (the
// text of the plan is not parsed); a date rule is exact calendar arithmetic
// (IRC calendar-step policy in scenarios); a discretionary "may" is a liberty
// or a power with `valid_when` one atom; evaluative wording ("reasonably
// necessary", "understood by the average plan participant") is a case fact
// with the coverage row marked EVALUATIVE (DECISION-0194), never a numeric
// guard.

// =====================================================================
// (1) Schedules and the default schedule
// =====================================================================

use self::{
    IRC_S432_E,
    MultiemployerPlan,
    Person,
    TaxableYear,
    adjustable_benefit_reduction_notice_given_432,
    critical_status_432,
    critical_status_surcharge_432e7,
    emergence_blocked_by_suspension_432e9J,
    multiemployer_bargaining_party_432,
    multiemployer_plan_sponsor_432,
    multiemployer_plan_year_start_432,
    rehabilitation_period_end_432e4,
    rehabilitation_plan_adopted_432,
    schedules_provided_to_bargaining_parties_432,
};

pub relation sponsor_provides_additional_information_432e1Bii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor prepares and provides the bargaining parties additional information on contribution rates or benefit reductions, alternative schedules, or other relevant information, case-asserted (exercise atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "may, if the plan sponsor deems appropriate, prepare and provide the bargaining parties with additional information")
rule AdditionalInformationLiberty432e1Bii(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person) strict {
    label en official "a liberty of the sponsor toward each bargaining party; whether it is appropriate is the sponsor's judgment and is not tested";
    when critical_status_432(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party);
    then liberty ProvideAdditionalInformationLiberty {
        holder sponsor;
        against party;
        action sponsor_provides_additional_information_432e1Bii(plan, y);
        window [-infinity, infinity];
    };
}

pub relation schedules_reflect_reductions_and_increases_432e1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the schedules reflect reductions in future benefit accruals and adjustable benefits, and increases in contributions, that the sponsor determines are reasonably necessary to emerge from critical status, case-asserted (evaluative \"reasonably necessary\")";
}

pub relation default_schedule_designated_432e1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "one schedule is designated as the default schedule, case-asserted";
}

pub relation default_schedule_assumes_only_necessary_increases_432e1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the default schedule assumes no increases in contributions other than those necessary to emerge from critical status, case-asserted";
}

pub relation default_schedule_reduces_to_maximum_permitted_432e1(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the default schedule assumes future accruals and other benefits (other than those protected by section 411(d)(6)) are reduced to the maximum extent permitted by law, case-asserted";
}

pub relation schedules_conform_to_432e1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(1) last paragraph: the schedules reflect the necessary reductions and increases and one is designated the default schedule on the stated assumptions";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "One schedule shall be designated as the default schedule and such schedule shall assume that there are no increases in contributions under the plan other than the increases necessary to emerge from critical status")
rule SchedulesConformTo432e1(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "all four facts must hold";
    when schedules_reflect_reductions_and_increases_432e1(plan, y)
        and default_schedule_designated_432e1(plan, y)
        and default_schedule_assumes_only_necessary_increases_432e1(plan, y)
        and default_schedule_reduces_to_maximum_permitted_432e1(plan, y);
    then schedules_conform_to_432e1(plan, y);
}

// =====================================================================
// (3)(A) The rehabilitation plan: its content
// =====================================================================

pub relation rehab_actions_formulated_to_cease_critical_status_432e3Ai(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan consists of actions (including options or a range of options for the bargaining parties), formulated on reasonably anticipated experience and reasonable actuarial assumptions, to enable the plan to cease to be in critical status by the end of the rehabilitation period, case-asserted (clause (i))";
}

pub relation sponsor_determines_plan_cannot_emerge_432e3Aii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor determines, on reasonable actuarial assumptions and after exhausting all reasonable measures, that the plan cannot reasonably be expected to emerge from critical status by the end of the rehabilitation period, case-asserted (clause (ii))";
}

pub relation rehab_reasonable_measures_to_emerge_later_432e3Aii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan consists of reasonable measures to emerge from critical status at a later time or to forestall possible insolvency within the meaning of ERISA section 4245, case-asserted (clause (ii))";
}

pub relation rehab_sets_forth_alternatives_and_explanation_432e3A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sets forth the alternatives considered, explains why it is not reasonably expected to emerge from critical status by the end of the rehabilitation period, and specifies when, if ever, it is expected to emerge, case-asserted (clause (ii) content)";
}

pub relation rehab_provides_annual_standards_432e3A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the rehabilitation plan provides annual standards for meeting its requirements, case-asserted";
}

pub relation rehab_includes_schedules_432e3A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the rehabilitation plan includes the schedules required by paragraph (1)(B)(i), case-asserted";
}

pub relation rehabilitation_plan_content_met_432e3A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(3)(A): the plan consists of clause (i) actions or, on the sponsor's determination, clause (ii) measures with the alternatives, explanation and expected emergence date, together with annual standards and the schedules";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "actions, including options or a range of options to be proposed to the bargaining parties")
rule RehabilitationPlanContentActions432e3Ai(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "route (i): actions to cease to be in critical status, with annual standards and schedules";
    when rehab_actions_formulated_to_cease_critical_status_432e3Ai(plan, y)
        and rehab_provides_annual_standards_432e3A(plan, y)
        and rehab_includes_schedules_432e3A(plan, y);
    then rehabilitation_plan_content_met_432e3A(plan, y);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "reasonable measures to emerge from critical status at a later time or to forestall possible insolvency")
rule RehabilitationPlanContentLaterMeasures432e3Aii(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "route (ii): the sponsor's determination, later-emergence measures, the alternatives and explanation, annual standards and schedules";
    when sponsor_determines_plan_cannot_emerge_432e3Aii(plan, y)
        and rehab_reasonable_measures_to_emerge_later_432e3Aii(plan, y)
        and rehab_sets_forth_alternatives_and_explanation_432e3A(plan, y)
        and rehab_provides_annual_standards_432e3A(plan, y)
        and rehab_includes_schedules_432e3A(plan, y);
    then rehabilitation_plan_content_met_432e3A(plan, y);
}

// =====================================================================
// (3)(B) Annual updates and the duration of a schedule
// =====================================================================

pub relation rehabilitation_plan_update_filed_with_annual_report_432e3Bi(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor has updated the rehabilitation plan for the year and filed the update with the plan's annual report under ERISA section 104, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan sponsor shall annually update the rehabilitation plan and shall file the update with the plan's annual report under section 104 of the Employee Retirement Income Security Act of 1974")
rule RehabilitationPlanAnnualUpdateDuty432e3Bi(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, start: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL/JUDGMENT: the statute sets no date; the update falls due within the plan year, so the window is the plan year (start + 1 year - 1 day); the ERISA section 104 filing date is not pinned";
    when critical_status_432(plan, y)
        and rehabilitation_plan_adopted_432(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_plan_year_start_432(plan, y, start)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 1 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then duty UpdateRehabilitationPlanDuty {
        bearer sponsor;
        goal achievement {
            condition rehabilitation_plan_update_filed_with_annual_report_432e3Bi(plan, y);
            window [start, calendar_before_1];
        }
    };
}

pub relation schedules_updated_to_reflect_experience_432e3Bii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the sponsor has updated each schedule of contribution rates provided to reflect the experience of the plan, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan sponsor shall annually update any schedule of contribution rates provided under this subsection to reflect the experience of the plan")
rule ScheduleAnnualUpdateDuty432e3Bii(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, start: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL/JUDGMENT: annual, within the plan year; whether the update reflects the plan's experience is a case fact";
    when critical_status_432(plan, y)
        and schedules_provided_to_bargaining_parties_432(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_plan_year_start_432(plan, y, start)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(start, 1 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then duty UpdateContributionSchedulesDuty {
        bearer sponsor;
        goal achievement {
            condition schedules_updated_to_reflect_experience_432e3Bii(plan, y);
            window [start, calendar_before_1];
        }
    };
}

pub entity CollectiveBargainingAgreement432 {
    label en unofficial "a collective bargaining agreement (or other agreement) providing for contributions under a multiemployer plan";
}

pub relation agreement_period_432(cba: CollectiveBargainingAgreement432, start: Date, end: Date) kind empirical {
    label en unofficial "the first and last day of the agreement's duration, case-asserted";
}

pub relation schedule_relied_upon_in_agreement_432e3Biii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "a schedule of contribution rates provided by the plan sponsor was relied upon by the bargaining parties in negotiating the agreement, case-asserted";
}

pub relation schedule_in_effect_for_agreement_432e3Biii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, on: Date) kind institutional {
    label en official "section 432(e)(3)(B)(iii): a schedule relied upon in negotiating an agreement remains in effect for the duration of that agreement";
}

pub relation schedule_status_asked_on_432(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, on: Date) kind empirical {
    label en unofficial "the date on which the question whether the schedule is in effect is put, case-asserted";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall remain in effect for the duration of that collective bargaining agreement")
rule ScheduleInEffectForAgreementDuration432e3Biii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, on: Date, start: Date, end: Date) strict {
    label en official "exact boundary: in effect from the first to the last day of the agreement, both included";
    when schedule_relied_upon_in_agreement_432e3Biii(plan, cba)
        and agreement_period_432(cba, start, end)
        and schedule_status_asked_on_432(plan, cba, on)
        and on >= start
        and on <= end;
    then schedule_in_effect_for_agreement_432e3Biii(plan, cba, on);
}

// =====================================================================
// (3)(C) Imposition of the default schedule
// =====================================================================

pub relation agreement_expired_on_432e3C(cba: CollectiveBargainingAgreement432, on: Date) kind empirical {
    label en unofficial "the date the agreement expires, case-asserted";
}

pub relation agreement_in_effect_when_plan_entered_critical_status_432e3Ci(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "the agreement providing for contributions was in effect at the time the plan entered critical status, case-asserted (clause (i)(I))";
}

pub relation parties_received_schedules_432e3C(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "after receiving one or more schedules (or updated schedules) from the plan sponsor, case-asserted";
}

pub relation parties_failed_to_adopt_consistent_schedule_432e3C(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "the bargaining parties failed to adopt a contribution schedule with terms consistent with the rehabilitation plan and a schedule from the sponsor, case-asserted";
}

pub relation agreement_under_sponsor_schedule_expired_while_critical_432e3Cii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "an agreement contributing in accordance with a schedule provided by the sponsor (or imposed under clause (i)) expires while the plan is still in critical status, case-asserted (clause (ii)(I))";
}

pub relation default_schedule_implementation_date_432e3Ciii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, on: Date) kind institutional {
    label en official "section 432(e)(3)(C)(iii): the date which is 180 days after the date on which the agreement expires";
}

pub relation default_schedule_to_implement_432e3Ci(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind institutional {
    label en official "section 432(e)(3)(C)(i): the initial agreement expired and the parties failed to adopt a consistent schedule, so the default schedule is to be implemented";
}

pub relation updated_schedule_to_implement_432e3Cii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind institutional {
    label en official "section 432(e)(3)(C)(ii): the subsequent agreement expired while the plan is critical and the parties failed to adopt a consistent schedule, so the schedule under the expired agreement, as updated, is to be implemented";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the plan sponsor shall implement the schedule described in the last sentence of paragraph (1) beginning on the date specified in clause (iii)")
rule DefaultScheduleToImplement432e3Ci(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) strict {
    label en official "(I) and (II) together";
    when agreement_in_effect_when_plan_entered_critical_status_432e3Ci(plan, cba)
        and agreement_expired_on_432e3C(cba, _)
        and parties_received_schedules_432e3C(plan, cba)
        and parties_failed_to_adopt_consistent_schedule_432e3C(plan, cba);
    then default_schedule_to_implement_432e3Ci(plan, cba);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall be implemented by the plan sponsor beginning on the date specified in clause (iii)")
rule UpdatedScheduleToImplement432e3Cii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) strict {
    label en official "(I) and (II) together";
    when agreement_under_sponsor_schedule_expired_while_critical_432e3Cii(plan, cba)
        and agreement_expired_on_432e3C(cba, _)
        and parties_received_schedules_432e3C(plan, cba)
        and parties_failed_to_adopt_consistent_schedule_432e3C(plan, cba);
    then updated_schedule_to_implement_432e3Cii(plan, cba);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The date specified in this subparagraph is the date which is 180 days after the date on which the collective bargaining agreement")
rule ImplementationDate432e3Ciii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, expired: Date) strict {
    label en official "exact: expiry + 180 calendar days, for either clause";
    when agreement_expired_on_432e3C(cba, expired)
        and default_schedule_to_implement_432e3Ci(plan, cba);
    then default_schedule_implementation_date_432e3Ciii(plan, cba, add_calendar_period(expired, 180 calendar_day));
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The date specified in this subparagraph is the date which is 180 days after the date on which the collective bargaining agreement")
rule ImplementationDateSubsequent432e3Ciii(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, expired: Date) strict {
    label en official "exact: expiry + 180 calendar days for the subsequent-schedule case";
    when agreement_expired_on_432e3C(cba, expired)
        and updated_schedule_to_implement_432e3Cii(plan, cba);
    then default_schedule_implementation_date_432e3Ciii(plan, cba, add_calendar_period(expired, 180 calendar_day));
}

pub relation schedule_implemented_by_sponsor_432e3C(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432) kind empirical {
    label en unofficial "the sponsor has implemented the schedule the statute requires it to implement, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the plan sponsor shall implement the schedule described in the last sentence of paragraph (1)")
rule ImplementScheduleDuty432e3C(plan: MultiemployerPlan, cba: CollectiveBargainingAgreement432, sponsor: Person, on: Date) strict {
    label en official "the sponsor implements the schedule beginning on the implementation date, and keeps it in force";
    when default_schedule_implementation_date_432e3Ciii(plan, cba, on)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty ImplementScheduleAfterExpiryDuty {
        bearer sponsor;
        goal maintenance {
            condition schedule_implemented_by_sponsor_432e3C(plan, cba);
            window [on, infinity];
        }
    };
}

// =====================================================================
// (4)(A) Start and early end of the rehabilitation period
// =====================================================================

pub relation rehabilitation_plan_adopted_date_432e4A(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date of the adoption of the rehabilitation plan, case-asserted (section 432(e)(4)(A)(i))";
}

pub relation agreements_covering_75_percent_expired_on_432e4Aii(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date on which the collective bargaining agreements in effect on the due date of the certification for the initial critical year, covering at least 75 percent of the active participants, have expired, case-asserted (section 432(e)(4)(A)(ii))";
}

pub relation rehabilitation_trigger_second_anniversary_432e4Ai(plan: MultiemployerPlan, on: Date) kind institutional {
    label en official "section 432(e)(4)(A)(i): the second anniversary of the adoption of the rehabilitation plan";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the second anniversary of the date of the adoption of the rehabilitation plan")
rule RehabilitationTriggerSecondAnniversary432e4Ai(plan: MultiemployerPlan, adopted: Date) strict {
    label en official "adoption date + 2 calendar years";
    when rehabilitation_plan_adopted_date_432e4A(plan, adopted);
    then rehabilitation_trigger_second_anniversary_432e4Ai(plan, add_calendar_period(adopted, 2 calendar_year));
}

pub relation rehabilitation_period_trigger_date_432e4A(plan: MultiemployerPlan, on: Date) kind institutional {
    label en official "section 432(e)(4)(A): the earlier of the second anniversary of adoption and the expiration of agreements covering at least 75 percent of the active participants; the rehabilitation period begins on the first day of the first plan year following it";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the second anniversary of the date of the adoption of the rehabilitation plan")
rule RehabilitationTriggerAnniversaryEarlier432e4A(plan: MultiemployerPlan, anniversary: Date, expiry: Date) strict {
    label en official "the anniversary is not later than the expiry date";
    when rehabilitation_trigger_second_anniversary_432e4Ai(plan, anniversary)
        and agreements_covering_75_percent_expired_on_432e4Aii(plan, expiry)
        and anniversary <= expiry;
    then rehabilitation_period_trigger_date_432e4A(plan, anniversary);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the expiration of the collective bargaining agreements in effect on the due date for the actuarial certification of critical status")
rule RehabilitationTriggerExpiryEarlier432e4A(plan: MultiemployerPlan, anniversary: Date, expiry: Date) strict {
    label en official "the expiry date is strictly earlier than the anniversary";
    when rehabilitation_trigger_second_anniversary_432e4Ai(plan, anniversary)
        and agreements_covering_75_percent_expired_on_432e4Aii(plan, expiry)
        and expiry < anniversary;
    then rehabilitation_period_trigger_date_432e4A(plan, expiry);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the second anniversary of the date of the adoption of the rehabilitation plan")
rule RehabilitationTriggerAnniversaryOnly432e4A(plan: MultiemployerPlan, anniversary: Date) strict {
    label en official "without an agreements-expiry date only the anniversary is a candidate";
    when rehabilitation_trigger_second_anniversary_432e4Ai(plan, anniversary)
        and not_known(agreement_expiry_date_recorded_432e4A(plan));
    then rehabilitation_period_trigger_date_432e4A(plan, anniversary);
}

pub relation agreement_expiry_date_recorded_432e4A(plan: MultiemployerPlan) kind institutional {
    label en official "helper: an agreements-expiry date under clause (ii) is present";
}

rule AgreementExpiryDateRecorded432e4A(plan: MultiemployerPlan, on: Date) strict {
    label en official "helper for the not_known guard";
    when agreements_covering_75_percent_expired_on_432e4Aii(plan, on);
    then agreement_expiry_date_recorded_432e4A(plan);
}

pub relation early_rehabilitation_period_end_432e4A(plan: MultiemployerPlan, end: Date) kind institutional {
    label en official "section 432(e)(4)(A) last sentence: if the plan emerges before the end of the 10 years, the rehabilitation period ends with the plan year preceding the plan year of the emergence determination";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the rehabilitation period shall end with the plan year preceding the plan year for which the determination under subparagraph (B) is made")
rule EarlyRehabilitationPeriodEnd432e4A(plan: MultiemployerPlan, y: TaxableYear, start: Date, ten_year_end: Date, calendar_before_1: Date, calendar_before_2: Date) strict {
    label en official "the last day of the preceding plan year is the day before the first day of the emergence year, and it falls before the 10-year end";
    when plan_emerges_from_critical_status_432e4B(plan, y)
        and multiemployer_plan_year_start_432(plan, y, start)
        and rehabilitation_period_end_432e4(plan, ten_year_end)
        and calendar_before_2 < ten_year_end
        and us.irc.core::civil_calendar_boundary_before(start, 1, us.irc.core::CalendarDay, calendar_before_1)
        and us.irc.core::civil_calendar_boundary_before(start, 1, us.irc.core::CalendarDay, calendar_before_2);
    then early_rehabilitation_period_end_432e4A(plan, calendar_before_1);
}

// =====================================================================
// (4)(B) Emergence from critical status, re-entry
// =====================================================================

pub relation actuary_certifies_emergence_432e4B(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan actuary certifies, in accordance with subsection (b)(3)(A), the matters of the emergence test for the plan year, case-asserted";
}

pub relation plan_not_described_in_b2_at_year_start_432e4Bi(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is not described in one or more of the subparagraphs of subsection (b)(2) as of the beginning of the plan year, case-asserted (clause (i)(I))";
}

pub relation no_projected_deficiency_10_years_432e4B(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is not projected to have an accumulated funding deficiency for the plan year or any of the 9 succeeding plan years, without regard to the shortfall method, taking into account amortization extensions, case-asserted";
}

pub relation no_projected_insolvency_30_years_432e4B(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is not projected to become insolvent within the meaning of section 418E for any of the 30 succeeding plan years, case-asserted";
}

pub relation plan_has_automatic_amortization_extension_431d1_432e4Bii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan in critical status has an automatic extension of amortization periods under section 431(d)(1), case-asserted (clause (ii)(I))";
}

pub relation emergence_test_met_by_general_rule_432e4Bi(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(4)(B)(i): the certification and the three conditions (I)-(III) hold";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "A plan in critical status shall remain in such status until a plan year for which the plan actuary certifies")
rule EmergenceTestGeneral432e4Bi(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "certification and (I), (II), (III) together";
    when actuary_certifies_emergence_432e4B(plan, y)
        and plan_not_described_in_b2_at_year_start_432e4Bi(plan, y)
        and no_projected_deficiency_10_years_432e4B(plan, y)
        and no_projected_insolvency_30_years_432e4B(plan, y);
    then emergence_test_met_by_general_rule_432e4Bi(plan, y);
}

pub relation emergence_test_met_by_special_rule_432e4Bii(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(4)(B)(ii)(I): a plan with an automatic amortization extension emerges on the certification of the (aa) and (bb) tests regardless of subsection (b)(2)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall no longer be in critical status if the plan actuary certifies for a plan year")
rule EmergenceTestSpecial432e4Bii(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(aa) and (bb) with the certification; the (b)(2) condition is not required";
    when plan_has_automatic_amortization_extension_431d1_432e4Bii(plan, y)
        and actuary_certifies_emergence_432e4B(plan, y)
        and no_projected_deficiency_10_years_432e4B(plan, y)
        and no_projected_insolvency_30_years_432e4B(plan, y);
    then emergence_test_met_by_special_rule_432e4Bii(plan, y);
}

pub relation plan_emerges_from_critical_status_432e4B(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(4)(B): the plan ceases to be in critical status for the plan year (subject to the (9)(J) special rule after a benefit suspension)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "A plan in critical status shall remain in such status until a plan year for which the plan actuary certifies")
rule PlanEmergesGeneral432e4B(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "the general emergence test, unless a benefit suspension blocks emergence";
    when emergence_test_met_by_general_rule_432e4Bi(plan, y)
        and not_known(emergence_blocked_by_suspension_432e9J(plan, y));
    then plan_emerges_from_critical_status_432e4B(plan, y);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall no longer be in critical status if the plan actuary certifies for a plan year")
rule PlanEmergesSpecial432e4Bii(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "the special emergence test, unless a benefit suspension blocks emergence";
    when emergence_test_met_by_special_rule_432e4Bii(plan, y)
        and not_known(emergence_blocked_by_suspension_432e9J(plan, y));
    then plan_emerges_from_critical_status_432e4B(plan, y);
}

pub relation projected_deficiency_10_years_432e4BiiII(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is projected to have an accumulated funding deficiency for the plan year or any of the 9 succeeding plan years, without regard to the shortfall method, taking into account extensions under section 431(d), case-asserted";
}

pub relation projected_insolvency_30_years_432e4BiiII(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is projected to become insolvent within the meaning of section 418E for any of the 30 succeeding plan years, case-asserted";
}

pub relation plan_emerged_under_special_rule_432e4BiiI(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan emerged from critical status under the special rule of clause (ii)(I) in an earlier plan year, case-asserted";
}

pub relation reentry_into_critical_status_permitted_432e4BiiII(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(e)(4)(B)(ii)(II): a plan that emerged under the special rule reenters critical status only if projected to have a funding deficiency within 10 years or to become insolvent within 30 years";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the plan is projected to have an accumulated funding deficiency for the plan year or any of the 9 succeeding plan years")
rule ReentryPermittedByDeficiency432e4BiiII(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(aa)";
    when plan_emerged_under_special_rule_432e4BiiI(plan) and projected_deficiency_10_years_432e4BiiII(plan, y);
    then reentry_into_critical_status_permitted_432e4BiiII(plan, y);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the plan is projected to become insolvent within the meaning of section 418E for any of the 30 succeeding plan years")
rule ReentryPermittedByInsolvency432e4BiiII(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(bb)";
    when plan_emerged_under_special_rule_432e4BiiI(plan) and projected_insolvency_30_years_432e4BiiII(plan, y);
    then reentry_into_critical_status_permitted_432e4BiiII(plan, y);
}

// =====================================================================
// (5) Rehabilitation plan adoption period
// =====================================================================

pub relation initial_critical_year_certification_date_432e5(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date of the certification under subsection (b)(3)(A) for the initial critical year, case-asserted";
}

pub relation rehabilitation_period_first_day_432e5(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the first day of the rehabilitation period, case-asserted";
}

pub relation rehabilitation_plan_adoption_period_432e5(plan: MultiemployerPlan, start: Date, end: Date) kind institutional {
    label en official "section 432(e)(5): the period beginning on the date of the certification for the initial critical year and ending on the day before the first day of the rehabilitation period";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the term \"rehabilitation plan adoption period\" means the period beginning on the date of the certification under subsection (b)(3)(A) for the initial critical year")
rule RehabilitationPlanAdoptionPeriod432e5(plan: MultiemployerPlan, certified: Date, first_day: Date, calendar_before_1: Date) strict {
    label en official "closed at the start, ends on the day before the rehabilitation period begins";
    when initial_critical_year_certification_date_432e5(plan, certified)
        and rehabilitation_period_first_day_432e5(plan, first_day)
        and us.irc.core::civil_calendar_boundary_before(first_day, 1, us.irc.core::CalendarDay, calendar_before_1);
    then rehabilitation_plan_adoption_period_432e5(plan, certified, calendar_before_1);
}

// =====================================================================
// (6) Limitation on reduction in rates of future accruals
// =====================================================================

pub relation contributions_required_for_participant_432e6(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the contributions required to be made with respect to the participant under the agreements in effect on the first day of the initial critical year (monthly basis), case-asserted";
}

pub relation accrual_rate_on_first_day_of_initial_critical_year_432e6B(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the monthly benefit (single life annuity at normal retirement age) accrual rate under the plan on the first day of the initial critical year, case-asserted (clause (B))";
}

pub relation equivalent_standard_accrual_rate_432e6A(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the equivalent standard accrual rate, determined by the sponsor on the standard or average contribution base units it determines to be representative, case-asserted (last paragraph; a sponsor determination)";
}

pub relation accrual_floor_clause_a_432e6(plan: MultiemployerPlan, participant: Person, amount: Money) kind institutional {
    label en official "section 432(e)(6)(A): a monthly benefit equal to 1 percent of the contributions required for the participant";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "a monthly benefit (payable as a single life annuity commencing at the participant's normal retirement age) equal to 1 percent of the contributions required to be made with respect to a participant")
rule AccrualFloorClauseA432e6(plan: MultiemployerPlan, participant: Person, contributions: Money) strict {
    label en official "PARTIAL: the 1 percent branch, exact fraction 0.01; the alternative equivalent standard accrual rate is a sponsor determination read from its own fact";
    when contributions_required_for_participant_432e6(plan, participant, contributions);
    then accrual_floor_clause_a_432e6(plan, participant, contributions * 0.01);
}

pub relation accrual_floor_432e6(plan: MultiemployerPlan, participant: Person, amount: Money) kind institutional {
    label en official "section 432(e)(6): the lower of clause (A) and the accrual rate on the first day of the initial critical year";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "if lower, the accrual rate under the plan on such first day")
rule AccrualFloorBranchLower432e6(plan: MultiemployerPlan, participant: Person, a: Money, b: Money) strict {
    label en official "clause (B) applies when it is strictly lower than clause (A)";
    when accrual_floor_clause_a_432e6(plan, participant, a)
        and accrual_rate_on_first_day_of_initial_critical_year_432e6B(plan, participant, b)
        and b < a;
    then accrual_floor_432e6(plan, participant, b);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall not reduce the rate of future accruals below")
rule AccrualFloorBranchA432e6(plan: MultiemployerPlan, participant: Person, a: Money, b: Money) strict {
    label en official "clause (A) applies when clause (B) is equal or higher";
    when accrual_floor_clause_a_432e6(plan, participant, a)
        and accrual_rate_on_first_day_of_initial_critical_year_432e6B(plan, participant, b)
        and b >= a;
    then accrual_floor_432e6(plan, participant, a);
}

pub relation default_schedule_accrual_rate_432e6(plan: MultiemployerPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the rate of future accruals under the default schedule (monthly), case-asserted";
}

pub relation default_schedule_accrual_below_floor_432e6(plan: MultiemployerPlan, participant: Person) kind institutional {
    label en official "section 432(e)(6): the default schedule reduces the rate of future accruals below the floor";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Any reduction in the rate of future accruals under the default schedule described in the last sentence of paragraph (1) shall not reduce the rate of future accruals below")
rule DefaultScheduleAccrualBelowFloor432e6(plan: MultiemployerPlan, participant: Person, floor: Money, rate: Money) strict {
    label en official "exact boundary: a rate equal to the floor is permitted";
    when accrual_floor_432e6(plan, participant, floor)
        and default_schedule_accrual_rate_432e6(plan, participant, rate)
        and rate < floor;
    then default_schedule_accrual_below_floor_432e6(plan, participant);
}

pub relation sets_default_schedule_accrual_below_floor_432e6(sponsor: Person, plan: MultiemployerPlan, participant: Person) kind empirical {
    label en unofficial "the sponsor adopts a default schedule that reduces the rate of future accruals of this participant below the floor, case-asserted (action atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall not reduce the rate of future accruals below")
rule DefaultScheduleAccrualFloorProhibition432e6(plan: MultiemployerPlan, participant: Person, sponsor: Person, floor: Money) strict {
    label en official "the sponsor is forbidden to set the default-schedule accrual rate below the floor; the alternative schedules of the last sentence are unrestricted";
    when accrual_floor_432e6(plan, participant, floor)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then prohibition ReduceDefaultAccrualBelowFloorProhibition {
        bearer sponsor;
        action sets_default_schedule_accrual_below_floor_432e6(sponsor, plan, participant);
        window [-infinity, infinity];
    };
}

// =====================================================================
// (7)(B)-(E) Surcharge: enforcement, cessation, notice, no accrual
// =====================================================================

pub relation contribution_due_date_432e7(employer: Person, plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the due date of the contribution on which the surcharge is based, case-asserted";
}

pub relation surcharge_due_date_432e7B(employer: Person, plan: MultiemployerPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 432(e)(7)(B): the surcharge is due and payable on the same schedule as the contributions on which it is based";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The surcharges under subparagraph (A) shall be due and payable on the same schedule as the contributions on which the surcharges are based")
rule SurchargeDueDate432e7B(employer: Person, plan: MultiemployerPlan, y: TaxableYear, amount: Money, due: Date) strict {
    label en official "the surcharge due date is the contribution due date";
    when critical_status_surcharge_432e7(employer, plan, y, amount)
        and contribution_due_date_432e7(employer, plan, y, due);
    then surcharge_due_date_432e7B(employer, plan, y, due);
}

pub relation surcharge_paid_432e7B(employer: Person, plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the employer has paid the surcharge, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "Any failure to make a surcharge payment shall be treated as a delinquent contribution under section 515 of the Employee Retirement Income Security Act of 1974")
rule PaySurchargeDuty432e7B(employer: Person, plan: MultiemployerPlan, y: TaxableYear, due: Date) strict {
    label en official "the employer must pay by the due date; a failure is treated as a delinquent contribution under ERISA section 515 (the ERISA enforcement is not modelled)";
    when surcharge_due_date_432e7B(employer, plan, y, due);
    then duty PaySurchargeDuty {
        bearer employer;
        goal achievement {
            condition surcharge_paid_432e7B(employer, plan, y);
            window [-infinity, due];
        }
    };
}

pub relation agreement_effective_with_terms_consistent_with_schedule_432e7C(cba: CollectiveBargainingAgreement432, on: Date) kind empirical {
    label en unofficial "the effective date of an agreement (or other agreement pursuant to which the employer contributes) that includes terms consistent with a schedule presented by the sponsor under paragraph (1)(B)(i), as modified under (3)(B), case-asserted";
}

pub relation surcharge_ceases_for_covered_employees_432e7C(cba: CollectiveBargainingAgreement432, on: Date) kind institutional {
    label en official "section 432(e)(7)(C): the surcharge ceases to be effective beginning on the effective date of an agreement with terms consistent with the sponsor's schedule";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "beginning on the effective date of a collective bargaining agreement (or other such agreement) that includes terms consistent with a schedule presented by the plan sponsor")
rule SurchargeCeases432e7C(cba: CollectiveBargainingAgreement432, on: Date) strict {
    label en official "the cessation date is the effective date itself";
    when agreement_effective_with_terms_consistent_with_schedule_432e7C(cba, on);
    then surcharge_ceases_for_covered_employees_432e7C(cba, on);
}

pub relation sponsor_notified_employer_of_critical_status_and_surcharge_on_432e7D(employer: Person, plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the plan sponsor notified the employer both that the plan is in critical status and that the surcharge is in effect, case-asserted";
}

pub relation surcharge_first_applicable_date_432e7D(employer: Person, plan: MultiemployerPlan, on: Date) kind institutional {
    label en official "section 432(e)(7)(D): the surcharge does not apply to an employer until 30 days after the employer has been notified";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The surcharge under this paragraph shall not apply to an employer until 30 days after the employer has been notified by the plan sponsor")
rule SurchargeFirstApplicableDate432e7D(employer: Person, plan: MultiemployerPlan, notified: Date) strict {
    label en official "exact: the surcharge applies from notice + 30 calendar days";
    when sponsor_notified_employer_of_critical_status_and_surcharge_on_432e7D(employer, plan, notified);
    then surcharge_first_applicable_date_432e7D(employer, plan, add_calendar_period(notified, 30 calendar_day));
}

pub relation surcharge_excluded_from_benefit_accrual_432e7E(employer: Person, plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 432(e)(7)(E): the amount of a surcharge is not the basis for any benefit accrual under the plan, notwithstanding any plan provision";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "the amount of any surcharge under this paragraph shall not be the basis for any benefit accrual under the plan")
rule SurchargeNotBasisForAccrual432e7E(employer: Person, plan: MultiemployerPlan, y: TaxableYear, amount: Money) strict {
    label en official "a surcharge amount is excluded from the accrual base";
    when critical_status_surcharge_432e7(employer, plan, y, amount);
    then surcharge_excluded_from_benefit_accrual_432e7E(employer, plan, y, amount);
}

// =====================================================================
// (8) Benefit adjustments: adjustable benefits
// =====================================================================

pub enum AdjustableBenefitKind432 {
    PostRetirementDeathBenefit;
    SixtyMonthGuarantee;
    DisabilityBenefitNotInPayStatus;
    OtherBenefitRightOrFeature;
    EarlyRetirementBenefitOrSubsidy;
    BenefitPaymentOption;
    QualifiedJointAndSurvivorAnnuity;
    RecentBenefitIncrease;
    NormalRetirementAccruedBenefit;
}

pub relation plan_benefit_item_of_kind_432e8(plan: MultiemployerPlan, item: Integer, kind: AdjustableBenefitKind432) kind empirical {
    label en unofficial "this benefit, right or feature of the plan is of this kind, case-asserted (section 432(e)(8)(A)(iv))";
}

pub relation benefit_increase_adoption_and_effect_dates_432e8Aiv(plan: MultiemployerPlan, item: Integer, adopted: Date, took_effect: Date) kind empirical {
    label en unofficial "the dates the benefit increase was adopted and took effect, case-asserted (clause (iv)(III))";
}

pub relation initial_critical_year_first_day_432e8(plan: MultiemployerPlan, first_day: Date) kind empirical {
    label en unofficial "the first day of the initial critical year, case-asserted";
}

pub relation benefit_increase_without_4022A_guarantee_432e8Aiv3(plan: MultiemployerPlan, item: Integer) kind empirical {
    label en unofficial "the increase would not be eligible for a guarantee under ERISA section 4022A on the first day of the initial critical year because it was adopted or took effect less than 60 months before that day, case-asserted (clause (iv)(III); the guarantee test itself is the PBGC's)";
}

pub relation adjustable_benefit_432e8Aiv(plan: MultiemployerPlan, item: Integer) kind institutional {
    label en official "section 432(e)(8)(A)(iv): an adjustable benefit is a benefit, right or feature (I), an early retirement benefit, retirement-type subsidy or benefit payment option other than the QJSA (II), or a recent benefit increase without a 4022A guarantee (III)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "benefits, rights, and features under the plan, including post-retirement death benefits, 60-month guarantees, disability benefits not yet in pay status, and similar benefits")
rule AdjustableBenefitClauseI432e8Aiv(plan: MultiemployerPlan, item: Integer, kind: AdjustableBenefitKind432) strict {
    label en official "(I): the four listed kinds";
    when plan_benefit_item_of_kind_432e8(plan, item, kind)
        and kind != EarlyRetirementBenefitOrSubsidy
        and kind != BenefitPaymentOption
        and kind != QualifiedJointAndSurvivorAnnuity
        and kind != RecentBenefitIncrease
        and kind != NormalRetirementAccruedBenefit;
    then adjustable_benefit_432e8Aiv(plan, item);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "any early retirement benefit or retirement-type subsidy (within the meaning of section 411(d)(6)(B)(i)) and any benefit payment option (other than the qualified joint and survivor annuity)")
rule AdjustableBenefitEarlyRetirement432e8Aiv(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(II): early retirement benefit or retirement-type subsidy";
    when plan_benefit_item_of_kind_432e8(plan, item, EarlyRetirementBenefitOrSubsidy);
    then adjustable_benefit_432e8Aiv(plan, item);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "any benefit payment option (other than the qualified joint and survivor annuity)")
rule AdjustableBenefitPaymentOption432e8Aiv(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(II): a benefit payment option; the QJSA is a separate kind and is not adjustable";
    when plan_benefit_item_of_kind_432e8(plan, item, BenefitPaymentOption);
    then adjustable_benefit_432e8Aiv(plan, item);
}

pub relation recent_benefit_increase_432e8Aiv3(plan: MultiemployerPlan, item: Integer) kind institutional {
    label en official "section 432(e)(8)(A)(iv)(III): a benefit increase adopted (or, if later, effective) less than 60 months before the first day of the initial critical year and not eligible for a 4022A guarantee";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "because the increases were adopted (or, if later, took effect) less than 60 months before such first day")
rule RecentBenefitIncreaseEffectLater432e8Aiv3(plan: MultiemployerPlan, item: Integer, adopted: Date, took_effect: Date, first_day: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL: the later of adoption and effect is strictly after first day - 60 months; the 4022A guarantee itself is a case input";
    when plan_benefit_item_of_kind_432e8(plan, item, RecentBenefitIncrease)
        and benefit_increase_adoption_and_effect_dates_432e8Aiv(plan, item, adopted, took_effect)
        and initial_critical_year_first_day_432e8(plan, first_day)
        and benefit_increase_without_4022A_guarantee_432e8Aiv3(plan, item)
        and took_effect >= adopted
        and took_effect > calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(first_day, 60, us.irc.core::CalendarMonth, calendar_before_1);
    then recent_benefit_increase_432e8Aiv3(plan, item);
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "because the increases were adopted (or, if later, took effect) less than 60 months before such first day")
rule RecentBenefitIncreaseAdoptionLater432e8Aiv3(plan: MultiemployerPlan, item: Integer, adopted: Date, took_effect: Date, first_day: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL: adoption strictly later than the effective date";
    when plan_benefit_item_of_kind_432e8(plan, item, RecentBenefitIncrease)
        and benefit_increase_adoption_and_effect_dates_432e8Aiv(plan, item, adopted, took_effect)
        and initial_critical_year_first_day_432e8(plan, first_day)
        and benefit_increase_without_4022A_guarantee_432e8Aiv3(plan, item)
        and adopted > took_effect
        and adopted > calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(first_day, 60, us.irc.core::CalendarMonth, calendar_before_1);
    then recent_benefit_increase_432e8Aiv3(plan, item);
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "benefit increases that would not be eligible for a guarantee under section 4022A of the Employee Retirement Income Security Act of 1974 on the first day of initial critical year")
rule AdjustableBenefitRecentIncrease432e8Aiv(plan: MultiemployerPlan, item: Integer) strict {
    label en official "(III)";
    when recent_benefit_increase_432e8Aiv3(plan, item);
    then adjustable_benefit_432e8Aiv(plan, item);
}

pub relation benefit_commencement_date_432e8Aii(plan: MultiemployerPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the participant's or beneficiary's benefit commencement date, case-asserted";
}

pub relation initial_critical_year_notice_given_on_432e8Aii(plan: MultiemployerPlan, participant: Person, on: Date) kind empirical {
    label en unofficial "the date the plan provides the participant or beneficiary the notice under subsection (b)(3)(D) for the initial critical year, case-asserted";
}

pub relation retiree_adjustable_benefit_protected_432e8Aii(plan: MultiemployerPlan, participant: Person, item: Integer) kind institutional {
    label en official "section 432(e)(8)(A)(ii): the adjustable benefits of a participant or beneficiary whose benefit commencement date is before the (b)(3)(D) notice date are not reducible, except recent benefit increases under (iv)(III)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "shall not reduce adjustable benefits of any participant or beneficiary whose benefit commencement date is before the date on which the plan provides notice")
rule RetireeAdjustableBenefitProtected432e8Aii(plan: MultiemployerPlan, participant: Person, item: Integer, commenced: Date, noticed: Date) strict {
    label en official "exact boundary: a commencement date equal to the notice date is not before it; recent increases are outside the protection";
    when adjustable_benefit_432e8Aiv(plan, item)
        and benefit_commencement_date_432e8Aii(plan, participant, commenced)
        and initial_critical_year_notice_given_on_432e8Aii(plan, participant, noticed)
        and commenced < noticed
        and not_known(recent_benefit_increase_432e8Aiv3(plan, item));
    then retiree_adjustable_benefit_protected_432e8Aii(plan, participant, item);
}

pub relation adjustable_benefit_reduction_exercise_432e8(plan: MultiemployerPlan, participant: Person, item: Integer) kind empirical {
    label en unofficial "the sponsor reduces this adjustable benefit of the participant, case-asserted (exercise atom)";
}

pub relation adjustable_benefit_reduction_valid_432e8A(plan: MultiemployerPlan, participant: Person, item: Integer) kind institutional {
    label en official "section 432(e)(8)(A)(i): the plan is in critical status, the item is an adjustable benefit, the retiree exception does not apply, and the notice requirement is met";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "the plan sponsor shall, subject to the notice requirement under subparagraph (C), make any reductions to adjustable benefits which the plan sponsor deems appropriate")
rule AdjustableBenefitReductionValid432e8A(plan: MultiemployerPlan, participant: Person, item: Integer, y: TaxableYear) strict {
    label en official "PARTIAL: the outcome of collective bargaining over the schedules and the sponsor's appropriateness judgment are not gated";
    when critical_status_432(plan, y)
        and adjustable_benefit_reduction_exercise_432e8(plan, participant, item)
        and adjustable_benefit_432e8Aiv(plan, item)
        and adjustable_benefit_reduction_notice_given_432(plan)
        and not_known(retiree_adjustable_benefit_protected_432e8Aii(plan, participant, item));
    then adjustable_benefit_reduction_valid_432e8A(plan, participant, item);
}

pub relation adjustable_benefit_reduced_432e8A(plan: MultiemployerPlan, participant: Person, item: Integer) kind institutional {
    label en official "the adjustable benefit of the participant is reduced notwithstanding section 411(d)(6)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "Notwithstanding section 411(d)(6), the plan sponsor shall, subject to the notice requirement under subparagraph (C), make any reductions to adjustable benefits")
rule AdjustableBenefitReductionPower432e8A(plan: MultiemployerPlan, participant: Person, item: Integer, sponsor: Person) strict {
    label en official "the power to reduce adjustable benefits is valid only when the statutory conditions hold";
    when multiemployer_plan_sponsor_432(plan, sponsor)
        and adjustable_benefit_reduction_exercise_432e8(plan, participant, item);
    then power ReduceAdjustableBenefitPower {
        holder sponsor;
        over participant;
        exercise adjustable_benefit_reduction_exercise_432e8(plan, participant, item);
        valid_when adjustable_benefit_reduction_valid_432e8A(plan, participant, item);
        effect adjustable_benefit_reduced_432e8A(plan, participant, item);
    };
}

pub relation schedule_allowance_for_noncontributing_participants_432e8Aiii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the schedules provided to the bargaining parties include an allowance for funding the benefits of participants for whom contributions are not currently required, case-asserted (goal atom)";
}

@source(IRC_S432_E, relation = formalizes, coverage = partial, quote = "The plan sponsor shall include in the schedules provided to the bargaining parties an allowance for funding the benefits of participants with respect to whom contributions are not currently required to be made")
rule ScheduleAllowanceDuty432e8Aiii(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person) strict {
    label en official "PARTIAL/EVALUATIVE: the allowance is a maintenance duty tied to the schedules; the sponsor's reduction of those participants' benefits \"considered appropriate\" is a judgment not tested";
    when critical_status_432(plan, y)
        and schedules_provided_to_bargaining_parties_432(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor);
    then duty IncludeAllowanceForNoncontributingParticipantsDuty {
        bearer sponsor;
        goal maintenance {
            condition schedule_allowance_for_noncontributing_participants_432e8Aiii(plan, y);
            window [-infinity, infinity];
        }
    };
}

pub relation accrued_benefit_at_normal_retirement_age_432e8B(plan: MultiemployerPlan, participant: Person, item: Integer) kind empirical {
    label en unofficial "this is the level of the participant's accrued benefit payable at normal retirement age, case-asserted";
}

pub relation normal_retirement_accrued_benefit_reduced_432e8B(plan: MultiemployerPlan, participant: Person, item: Integer) kind empirical {
    label en unofficial "the level of the participant's accrued benefit payable at normal retirement age is reduced, case-asserted (protected effect)";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "nothing in this paragraph shall be construed to permit a plan to reduce the level of a participant's accrued benefit payable at normal retirement age")
rule NormalRetirementBenefitImmunity432e8B(plan: MultiemployerPlan, participant: Person, item: Integer, sponsor: Person) strict {
    label en official "the participant is protected against a reduction of the accrued benefit payable at normal retirement age under this paragraph, except a recent benefit increase (iv)(III)";
    when accrued_benefit_at_normal_retirement_age_432e8B(plan, participant, item)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and not_known(recent_benefit_increase_432e8Aiv3(plan, item));
    then immunity NormalRetirementBenefitProtected {
        holder participant;
        against sponsor;
        protected_effect normal_retirement_accrued_benefit_reduced_432e8B(plan, participant, item);
        window [-infinity, infinity];
    };
}

pub relation notice_info_enables_understanding_and_estimate_432e8Cii1(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice has sufficient information to enable participants and beneficiaries to understand the effect of any reduction, including an annual or monthly estimate of any affected adjustable benefit, case-asserted (clause (ii)(I))";
}

pub relation notice_states_rights_remedies_and_dol_contact_432e8Cii2(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice has information on the rights and remedies of participants and beneficiaries and how to contact the Department of Labor, case-asserted (clause (ii)(II))";
}

pub relation adjustable_benefit_notice_content_met_432e8Cii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(e)(8)(C)(ii): the notice contains the effect information with an estimate and the rights, remedies and Department of Labor information";
}

@source(IRC_S432_E, relation = formalizes, coverage = exact, quote = "The notice under clause (i) shall contain")
rule AdjustableBenefitNoticeContentMet432e8Cii(plan: MultiemployerPlan) strict {
    label en official "(I) and (II)";
    when notice_info_enables_understanding_and_estimate_432e8Cii1(plan)
        and notice_states_rights_remedies_and_dol_contact_432e8Cii2(plan);
    then adjustable_benefit_notice_content_met_432e8Cii(plan);
}
