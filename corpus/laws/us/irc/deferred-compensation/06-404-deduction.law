// Section 404 — deduction for employer contributions. Stage 1 (IRC-09),
// DECISION-0379. Priority: (a)(3) 25%-of-compensation limit (stock bonus
// and profit-sharing trusts) as an exact computation. Also modelled: (a)(1)
// defined benefit contribution deduction as a BRIEF contract to section 430
// (the minimum-funding/full-funding-limitation computation is section 430's
// own executable content, not reformalized here), (h) SEP deduction limit.
// (a)(7) combined-plan limit, (j) coordination with section 415, (o) are
// NOT modelled in this stage (TECH_GAP / stage 2).


// =====================================================================
// (a)(3)(A) Stock bonus and profit-sharing trusts — 25% deduction limit
// =====================================================================

use self::{
    DefinedBenefitPlan,
    IRC_S404_A,
    IRC_S404_H,
    Person,
    Plan,
    TaxableYear,
};

pub relation compensation_paid_to_beneficiaries(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "compensation otherwise paid or accrued during the taxable year to the beneficiaries under the stock bonus or profit-sharing plan, case-asserted";
}

pub relation contribution_required_under_401k11(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount the employer is required to contribute under section 401(k)(11) for the year (SIMPLE 401(k) plans), case-asserted; 0 when inapplicable";
}

pub relation section404a3_deduction_limit(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(3)(A)(i): the deductible-contribution limit is the greater of 25 percent of compensation paid to beneficiaries, or the section 401(k)(11) required contribution";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "25 percent of the compensation otherwise paid or accrued during the taxable year to the beneficiaries under the stock bonus or profit-sharing plan")
rule Section404a3DeductionLimit(plan: Plan, y: TaxableYear, comp: Money, required_401k11: Money) strict {
    label en official "limit = max(25% of compensation, section 401(k)(11) required contribution)";
    when compensation_paid_to_beneficiaries(plan, y, comp)
        and contribution_required_under_401k11(plan, y, required_401k11);
    then section404a3_deduction_limit(plan, y, max(round(comp * 0.25, 2, "HALF_UP"), required_401k11));
}

pub relation contribution_paid_to_stock_bonus_or_profit_sharing_trust(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount actually paid into the stock bonus or profit-sharing trust for this taxable year, case-asserted";
}

pub relation section404a3_deductible_amount(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount deductible under section 404(a)(3)(A)(i) for the year: the lesser of the amount paid or the deduction limit";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "In the taxable year when paid, if the contributions are paid into a stock bonus or profit-sharing trust")
rule Section404a3DeductibleAmount(plan: Plan, y: TaxableYear, paid: Money, limit: Money) strict {
    label en official "deductible amount = min(amount paid, section 404(a)(3) limit)";
    when contribution_paid_to_stock_bonus_or_profit_sharing_trust(plan, y, paid)
        and section404a3_deduction_limit(plan, y, limit);
    then section404a3_deductible_amount(plan, y, min(paid, limit));
}

pub relation section404a3_excess_contribution(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(3)(A)(ii): the amount paid in excess of the section 404(a)(3) limit, carried over to succeeding taxable years";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "Any amount paid into the trust in any taxable year in excess of the limitation of clause (i) (or the corresponding provision of prior law) shall be deductible in the succeeding taxable years in order of time")
rule Section404a3ExcessContribution(plan: Plan, y: TaxableYear, paid: Money, limit: Money) strict {
    label en official "excess = amount paid minus the limit, when positive";
    when contribution_paid_to_stock_bonus_or_profit_sharing_trust(plan, y, paid)
        and section404a3_deduction_limit(plan, y, limit)
        and paid > limit;
    then section404a3_excess_contribution(plan, y, paid - limit);
}

// =====================================================================
// (a)(1) Defined benefit plan deduction — BRIEF contract to section 430
// =====================================================================
pub relation minimum_funding_standard_amount(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount necessary to satisfy the section 412(a)/430 minimum funding standard for plan years ending within or with this taxable year, case-asserted (section 430's funding-target/target-normal-cost/shortfall-amortization computation is NOT reformalized in this package — brief contract, see `16-other-brief.law`)";
}

pub relation section404a1_deductible_amount(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(1)(A)(i): the deductible amount for a defined benefit plan is at least the minimum funding standard amount (contract; the full-funding-limitation ceiling of section 431 is not modelled)";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "the amount necessary to satisfy the minimum funding standard provided by section 412(a) for plan years ending within or with such taxable year")
rule Section404a1DeductibleAmount(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "brief contract: the minimum funding standard amount is deductible (ceiling and alternative bases (ii)/(iii) not modelled)";
    when minimum_funding_standard_amount(plan, y, amount);
    then section404a1_deductible_amount(plan, y, amount);
}

// =====================================================================
// (h) Simplified employee pensions — deduction limit
// =====================================================================
pub relation sep_compensation_paid(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "compensation paid to employees during the calendar year ending with or within the taxable year (or the taxable year itself for a fiscal-year SEP), case-asserted";
}

pub relation sep_contribution_paid(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "employer contributions to the simplified employee pension for the taxable year, case-asserted";
}

pub relation section404h_deduction_limit(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(h)(1)(C): the amount deductible for a SEP shall not exceed 25 percent of compensation paid to the employees";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "The amount deductible in a taxable year for a simplified employee pension shall not exceed 25 percent of the compensation paid to the employees during the calendar year ending with or within the taxable year")
rule Section404hDeductionLimit(employer: Person, y: TaxableYear, comp: Money) strict {
    label en official "SEP deduction limit = 25% of compensation paid to employees";
    when sep_compensation_paid(employer, y, comp);
    then section404h_deduction_limit(employer, y, round(comp * 0.25, 2, "HALF_UP"));
}

pub relation section404h_deductible_amount(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount deductible for a SEP for the year: the lesser of the amount contributed or the 25 percent limit";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "The excess of the amount contributed over the amount deductible for a taxable year shall be deductible in the succeeding taxable years in order of time")
rule Section404hDeductibleAmount(employer: Person, y: TaxableYear, paid: Money, limit: Money) strict {
    label en official "deductible = min(contribution paid, 25% limit)";
    when sep_contribution_paid(employer, y, paid) and section404h_deduction_limit(employer, y, limit);
    then section404h_deductible_amount(employer, y, min(paid, limit));
}
