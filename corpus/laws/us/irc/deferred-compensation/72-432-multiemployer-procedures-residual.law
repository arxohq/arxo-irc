// Section 432 residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): (b)(2) projected deficiency horizon, (b)(3) status
// certification, (b)(5)-(7) endangered-but-for, critical and declining,
// special financial assistance, (c) funding improvement plan proposals,
// adoption period and schedules, (f), (g) withdrawal liability disregards,
// (i) nonbargained employees, (j) definitions, (k) special financial
// assistance.
//
// Pattern (modules 29/53/54): statutory conditions are case facts feeding
// derived relations; percentages are Decimal fractions; time limits use exact
// calendar arithmetic. ERISA references and Secretary/PBGC guidance are
// external. SECURE 2.0 / ARP revisions of the special financial assistance
// rules have no pre-amendment text pinned (G4601).

// =====================================================================
// (b)(2), (b)(3), (b)(5), (b)(6), (b)(7)
// =====================================================================

use self::{
    IRC_S432_B,
    IRC_S432_C,
    IRC_S432_F,
    IRC_S432_G,
    IRC_S432_I,
    IRC_S432_J,
    IRC_S432_K,
    MultiemployerPlan,
    Person,
    TaxableYear,
    critical_status_432,
    funded_percentage_computed_432j2,
    inactive_and_active_participant_counts_432,
    projected_years_to_insolvency_432,
};

pub relation projected_deficiency_within_years_432b2(plan: MultiemployerPlan, y: TaxableYear, years: Integer) kind empirical {
    label en unofficial "the plan is projected to have an accumulated funding deficiency for a plan year this many years ahead (not taking into account amortization extensions under section 431(d)), case-asserted (one row per year)";
}

pub relation funded_percentage_of_plan_432b2(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the funded percentage of the plan (0.65 = 65 percent), case-asserted";
}

pub relation deficiency_horizon_years_432b2ii(plan: MultiemployerPlan, y: TaxableYear, horizon: Integer) kind institutional {
    label en official "section 432(b)(2)(ii): the projection horizon is the 3 succeeding plan years, or 4 if the funded percentage is 65 percent or less";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "(4 succeeding plan years if the funded percentage of the plan is 65 percent or less)")
rule DeficiencyHorizonYears432b2ii(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) strict {
    label en official "exact boundary: 65 percent gives 4 years, above 65 percent 3 years";
    when funded_percentage_of_plan_432b2(plan, y, pct);
    then deficiency_horizon_years_432b2ii(plan, y, if pct <= 0.65 then 4 else 3);
}

pub relation deficiency_projected_within_horizon_432b2ii(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2)(ii): the plan is projected to have an accumulated funding deficiency within the horizon";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan is projected to have an accumulated funding deficiency for any of the 3 succeeding plan years")
rule DeficiencyProjectedWithinHorizon432b2ii(plan: MultiemployerPlan, y: TaxableYear, ahead: Integer, horizon: Integer) strict {
    label en official "a projected deficiency 1 to horizon years ahead";
    when projected_deficiency_within_years_432b2(plan, y, ahead)
        and deficiency_horizon_years_432b2ii(plan, y, horizon)
        and ahead >= 1 and ahead <= horizon;
    then deficiency_projected_within_horizon_432b2ii(plan, y);
}

pub relation certification_of_status_content_432b3Aii(plan: MultiemployerPlan, y: TaxableYear, in_endangered: Boolean, in_critical: Boolean, in_declining: Boolean, projected_5_years: Boolean) kind empirical {
    label en unofficial "the actuary's certification states whether the plan is in endangered status (or would be but for paragraph (5)), whether it is or will be in critical status for the year or the succeeding 5 years, and whether it is in critical and declining status, case-asserted";
}

pub relation certification_content_complete_432b3A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(A): the certification addresses endangered status, critical status (this and the succeeding 5 years) and critical and declining status";
}

@source(IRC_S432_B, relation = formalizes, coverage = partial, quote = "whether or not the plan is in endangered status for such plan year, or would be in endangered status for such plan year but for paragraph (5)")
rule CertificationContentComplete432b3A(plan: MultiemployerPlan, y: TaxableYear, e: Boolean, c: Boolean, d: Boolean, p: Boolean) strict {
    label en official "PARTIAL: the four determinations are made (any values); the first item of (A)(i) is module 29";
    when certification_of_status_content_432b3Aii(plan, y, e, c, d, p);
    then certification_content_complete_432b3A(plan, y);
}

pub relation actuary_failed_to_certify_by_due_date_432b3c(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan's actuary did not certify the plan's status by the date specified in subparagraph (A), case-asserted";
}

pub relation failure_treated_as_failure_to_file_annual_report_432b3c(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(C): the failure to certify is treated as a failure or refusal to file the annual report under ERISA section 502(c)(2)";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "Any failure of the plan's actuary to certify the plan's status under this subsection by the date specified in subparagraph (A) shall be treated")
rule FailureTreatedAsFailureToFileAnnualReport432b3c(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "missed certification";
    when actuary_failed_to_certify_by_due_date_432b3c(plan, y);
    then failure_treated_as_failure_to_file_annual_report_432b3c(plan, y);
}

pub relation critical_status_certified_or_projected_432b3dii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "it is certified that the plan is or will be in critical status, case-asserted";
}

pub relation notice_explains_adjustable_benefit_reductions_432b3dii(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the notice includes an explanation that adjustable benefits (section 432(e)(8)) may be reduced and that the reductions may apply to participants whose benefit commencement date is on or after the notice date for the first critical year, case-asserted";
}

pub relation critical_status_notice_content_ok_432b3dii(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(D)(ii): for a critical plan the notice explains the possible reduction of adjustable benefits";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan sponsor shall include in the notice under clause (i) an explanation of the possibility that")
rule CriticalStatusNoticeContentOk432b3dii(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "critical status and the explanation";
    when critical_status_certified_or_projected_432b3dii(plan, y)
        and notice_explains_adjustable_benefit_reductions_432b3dii(plan, y);
    then critical_status_notice_content_ok_432b3dii(plan, y);
}

pub relation plan_would_be_endangered_but_for_432b5_notice_on_432b3diii(plan: MultiemployerPlan, y: TaxableYear, notice_given: Boolean) kind empirical {
    label en unofficial "the plan would be in endangered status but for paragraph (5), and whether the sponsor notified the bargaining parties and the PBGC of that, case-asserted";
}

pub relation endangered_but_for_notice_given_432b3diii(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(D)(iii): the sponsor notifies the bargaining parties and the PBGC that the plan would be endangered but for paragraph (5)";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan sponsor shall provide notice to the bargaining parties and the Pension Benefit Guaranty Corporation that the plan would be in endangered status but for such paragraph")
rule EndangeredButForNoticeGiven432b3diii(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "notice given";
    when plan_would_be_endangered_but_for_432b5_notice_on_432b3diii(plan, y, true);
    then endangered_but_for_notice_given_432b3diii(plan, y);
}

pub relation projected_critical_within_5_years_certified_on_432b3dv(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date) kind empirical {
    label en unofficial "the date it is certified that the plan will be in critical status for any of the succeeding 5 plan years (but not the current year), case-asserted";
}

pub relation sponsor_notified_pbgc_on_432b3dv(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the plan sponsor notified the PBGC of the projected critical status, case-asserted";
}

pub relation pbgc_notification_timely_432b3dv(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(D)(v): the sponsor notifies the PBGC of the projected critical status not later than 30 days after the certification (when it has not elected critical status)";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "not later than 30 days after the date of the certification, provide notification of the projected critical status to the Pension Benefit Guaranty Corporation")
rule PbgcNotificationTimely432b3dv(plan: MultiemployerPlan, y: TaxableYear, certified: Date, notified: Date) strict {
    label en official "exact boundary: 30 days after is timely, 31 is late";
    when projected_critical_within_5_years_certified_on_432b3dv(plan, y, certified)
        and sponsor_notified_pbgc_on_432b3dv(plan, y, notified)
        and not_known(sponsor_elected_critical_status_432b3dv(plan, y))
        and notified >= certified
        and notified <= add_calendar_period(certified, 30 calendar_day);
    then pbgc_notification_timely_432b3dv(plan, y);
}

pub relation sponsor_elected_critical_status_432b3dv(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor has made an election to be in critical status for the plan year under paragraph (4), case-asserted";
}

pub relation actuary_certifies_not_endangered_in_10_years_432b5A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "as part of the certification of endangered status the actuary certifies the plan is projected to no longer be described in paragraph (1)(A) or (1)(B) as of the end of the tenth plan year ending after the certification year, case-asserted";
}

pub relation plan_not_critical_or_endangered_preceding_year_432b5B(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan was not in critical or endangered status for the immediately preceding plan year, case-asserted";
}

pub relation plan_described_in_paragraph_5_432b5(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(5): the plan actuary certifies the 10-year projection and the plan was not critical or endangered in the preceding year";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan was not in critical or endangered status for the immediately preceding plan year")
rule PlanDescribedInParagraph5432b5(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "both conditions";
    when actuary_certifies_not_endangered_in_10_years_432b5A(plan, y)
        and plan_not_critical_or_endangered_preceding_year_432b5B(plan, y);
    then plan_described_in_paragraph_5_432b5(plan, y);
}

pub relation eligible_plan_receiving_sfa_meets_432k2_432b7(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "an eligible multiemployer plan receiving special financial assistance under ERISA section 4262 meets the requirements of subsection (k)(2), case-asserted";
}

pub relation sfa_effective_year_432b7(plan: MultiemployerPlan, y: TaxableYear, effective_year: Integer, year_number: Integer) kind empirical {
    label en unofficial "the calendar year the assistance takes effect and the calendar year of the plan year in question, case-asserted";
}

pub relation deemed_critical_after_sfa_432b7(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(7): such a plan is deemed to be in critical status from the plan year in which the assistance takes effect through the last plan year ending in 2051";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan shall be deemed to be in critical status for plan years beginning with the plan year in which the effective date for such assistance occurs and ending with the last plan year ending in 2051")
rule DeemedCriticalAfterSfa432b7(plan: MultiemployerPlan, y: TaxableYear, eff_year: Integer, current: Integer) strict {
    label en official "exact boundaries: the effective year through 2051 inclusive";
    when eligible_plan_receiving_sfa_meets_432k2_432b7(plan, y)
        and sfa_effective_year_432b7(plan, y, eff_year, current)
        and current >= eff_year and current <= 2051;
    then deemed_critical_after_sfa_432b7(plan, y);
}

pub relation critical_and_declining_by_horizon_432b6(plan: MultiemployerPlan, y: TaxableYear, years_to_insolvency: Integer, inactive: Integer, active: Integer, funded_pct: Decimal) kind institutional {
    label en official "section 432(b)(6): critical status is critical and declining status if projected to become insolvent within 14 succeeding plan years (19 when inactive participants exceed twice the active ones, or the funded percentage is under 80 percent)";
}

@source(IRC_S432_B, relation = formalizes, coverage = partial, quote = "the plan is projected to become insolvent within the meaning of section 418E during the current plan year or any of the 14 succeeding plan years (19 succeeding plan years if the plan has a ratio of inactive participants to active participants that exceeds 2 to 1")
rule CriticalAndDecliningByHorizon432b6(plan: MultiemployerPlan, y: TaxableYear, years: Integer, inactive: Integer, active: Integer, pct: Decimal) strict {
    label en official "PARTIAL: the horizon is 19 years if inactive > 2 x active, or the funded percentage is under 0.80 (the text is cut before the funded-percentage threshold; 0.80 is the module 29 value); else 14; the plan is critical (module 18) and years is the projected number of years to insolvency";
    when critical_status_432(plan, y)
        and projected_years_to_insolvency_432(plan, y, years)
        and inactive_and_active_participant_counts_432(plan, y, inactive, active)
        and funded_percentage_computed_432j2(plan, y, pct)
        and years <= (if inactive > 2 * active or pct < 0.80 then 19 else 14);
    then critical_and_declining_by_horizon_432b6(plan, y, years, inactive, active, pct);
}

// =====================================================================
// (c) Funding improvement plans
// =====================================================================

pub relation funding_improvement_plan_proposals_432c1B(plan: MultiemployerPlan, y: TaxableYear, has_benefit_reduction_proposal: Boolean, has_contribution_increase_proposal: Boolean) kind empirical {
    label en unofficial "the plan sponsor provides one proposal for future benefit accrual reductions and one for contribution increases, case-asserted";
}

pub relation funding_improvement_proposals_provided_432c1B(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(1)(B)(i): the sponsor provides the bargaining parties one benefit-reduction proposal (assuming no contribution increases) and one contribution-increase proposal (assuming no benefit reductions)";
}

@source(IRC_S432_C, relation = formalizes, coverage = partial, quote = "one proposal for increases in contributions under the plan necessary to achieve the applicable benchmarks")
rule FundingImprovementProposalsProvided432c1B(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: both proposals are provided; the additional information of clause (ii) is optional";
    when funding_improvement_plan_proposals_432c1B(plan, y, true, true);
    then funding_improvement_proposals_provided_432c1B(plan, y);
}

pub relation funding_improvement_plan_actions_meet_benchmarks_432c3A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the actions, including options or a range of options, are formulated to attain the requirements of the plan during the funding improvement period on reasonably anticipated experience and reasonable actuarial assumptions, case-asserted";
}

pub relation funding_improvement_plan_valid_432c3A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(3)(A): a funding improvement plan is a plan of actions formulated to attain the requirements during the funding improvement period";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "A funding improvement plan is a plan which consists of the actions, including options or a range of options to be proposed to the bargaining parties")
rule FundingImprovementPlanValid432c3A(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "formulated to attain the benchmarks";
    when funding_improvement_plan_actions_meet_benchmarks_432c3A(plan, y);
    then funding_improvement_plan_valid_432c3A(plan, y);
}

pub relation funding_plan_certification_on_432c4a(plan: MultiemployerPlan, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the due date for the actuarial certification of endangered status for the initial determination year, case-asserted";
}

pub relation plan_adoption_date_432c4a(plan: MultiemployerPlan, y: TaxableYear, adopted_on: Date) kind empirical {
    label en unofficial "the date the funding improvement plan is adopted, case-asserted";
}

pub relation earliest_cba_expiration_after_certification_432c4aii(plan: MultiemployerPlan, y: TaxableYear, expires_on: Date) kind empirical {
    label en unofficial "the expiration of the collective bargaining agreements in effect on the certification due date, covering at least 75 percent of the active participants (the latest such date), case-asserted";
}

pub relation funding_plan_adoption_deadline_432c4a(plan: MultiemployerPlan, y: TaxableYear, deadline: Date) kind institutional {
    label en official "section 432(c)(4)(A): the funding improvement plan is adopted not later than the later of the second anniversary of the adoption of the plan and the expiration of the bargaining agreements (the deadline for the schedule of the period, JUDGMENT CALL: the second anniversary of the certification due date for adoption)";
}

@source(IRC_S432_C, relation = formalizes, coverage = partial, quote = "(i) the second anniversary of the date of the adoption of the funding improvement plan, or")
rule FundingPlanAdoptionDeadline432c4a(plan: MultiemployerPlan, y: TaxableYear, adopted: Date, expires: Date) strict {
    label en official "PARTIAL: the later of the second anniversary of the adoption and the agreements' expiration";
    when plan_adoption_date_432c4a(plan, y, adopted)
        and earliest_cba_expiration_after_certification_432c4aii(plan, y, expires);
    then funding_plan_adoption_deadline_432c4a(plan, y,
        if add_calendar_period(adopted, 2 calendar_year) >= expires then add_calendar_period(adopted, 2 calendar_year) else expires);
}

pub relation actuary_certifies_no_longer_endangered_432c4ci(plan: MultiemployerPlan, y: TaxableYear, previous_year_end: Date) kind empirical {
    label en unofficial "the actuary certifies for a plan year in a funding period that the plan is no longer endangered and not critical, and the close of the preceding plan year, case-asserted";
}

pub relation funding_period_ends_432c4ci(plan: MultiemployerPlan, y: TaxableYear, ends_on: Date) kind institutional {
    label en official "section 432(c)(4)(C)(i): the funding plan adoption period or funding improvement period ends as of the close of the preceding plan year";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "the funding plan adoption period or funding improvement period, whichever is applicable, shall end as of the close of the preceding plan year")
rule FundingPeriodEnds432c4ci(plan: MultiemployerPlan, y: TaxableYear, prev: Date) strict {
    label en official "close of the preceding plan year";
    when actuary_certifies_no_longer_endangered_432c4ci(plan, y, prev);
    then funding_period_ends_432c4ci(plan, y, prev);
}

pub relation actuary_certifies_critical_in_funding_period_432c4cii(plan: MultiemployerPlan, y: TaxableYear, plan_year_before_first_rehab_year_end: Date) kind empirical {
    label en unofficial "the actuary certifies the plan is in critical status for a plan year in a funding period, and the close of the plan year preceding the first plan year in the rehabilitation period, case-asserted";
}

pub relation funding_period_ends_when_critical_432c4cii(plan: MultiemployerPlan, y: TaxableYear, ends_on: Date) kind institutional {
    label en official "section 432(c)(4)(C)(ii): the funding period ends as of the close of the plan year preceding the first plan year of the rehabilitation period";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "shall end as of the close of the plan year preceding the first plan year in the rehabilitation period with respect to such status")
rule FundingPeriodEndsWhenCritical432c4cii(plan: MultiemployerPlan, y: TaxableYear, prev: Date) strict {
    label en official "close of the year before the rehabilitation period";
    when actuary_certifies_critical_in_funding_period_432c4cii(plan, y, prev);
    then funding_period_ends_when_critical_432c4cii(plan, y, prev);
}

pub relation initial_funded_percentage_432c5a(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the funded percentage as of the beginning of the initial determination year of a plan in seriously endangered status, case-asserted";
}

pub relation actuary_certifies_within_30_days_432c5A(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date, initial_certification_on: Date) kind empirical {
    label en unofficial "the date the actuary certifies that the plan is not projected to meet the requirements without paragraphs (3)(B) and (4)(B), and the date of the certification for the initial determination year, case-asserted";
}

pub relation paragraphs_3B_4B_apply_432c5A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(5)(A): for a plan above 70 percent funded, paragraphs (3)(B) and (4)(B) apply only if the actuary certifies within 30 days after the certification for the initial determination year";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "paragraphs (3)(B) and (4)(B) shall apply only if the plan's actuary certifies, within 30 days after the certification under subsection (b)(3)(A) for the initial determination year")
rule Paragraphs3B4BApply432c5A(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal, on: Date, initial: Date) strict {
    label en official "exact boundary: funded percentage above 70 percent; certification within 30 days (day 30 timely, day 31 late)";
    when initial_funded_percentage_432c5a(plan, y, pct)
        and pct > 0.70
        and actuary_certifies_within_30_days_432c5A(plan, y, on, initial)
        and on >= initial
        and on <= add_calendar_period(initial, 30 calendar_day);
    then paragraphs_3B_4B_apply_432c5A(plan, y);
}

pub relation plan_sponsor_updates_filed_with_annual_report_432c6A(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor annually updates the funding improvement plan and files the update with the plan's annual report (ERISA section 104), case-asserted";
}

pub relation annual_update_requirement_met_432c6A(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(6)(A): the sponsor annually updates the plan and files it with the annual report";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "The plan sponsor shall annually update the funding improvement plan and shall file the update with the plan's annual report")
rule AnnualUpdateRequirementMet432c6A(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "update and filing";
    when plan_sponsor_updates_filed_with_annual_report_432c6A(plan, y);
    then annual_update_requirement_met_432c6A(plan, y);
}

pub relation cba_expiration_date_432c7(plan: MultiemployerPlan, y: TaxableYear, expired_on: Date) kind empirical {
    label en unofficial "the expiration date of the collective bargaining agreement, case-asserted";
}

pub relation bargaining_parties_failed_to_adopt_schedule_432c7(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "after receiving the schedules, the bargaining parties failed to adopt a contribution schedule consistent with the funding improvement plan, case-asserted";
}

pub relation plan_still_endangered_at_expiration_432c7b(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the agreement under a sponsor schedule (or imposed schedule) expires while the plan is still in endangered status, case-asserted";
}

pub relation default_schedule_implementation_date_432c7C(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 432(c)(7)(A)-(C): if the bargaining parties fail to adopt a schedule, the sponsor implements the default schedule beginning 180 days after the agreement expires";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "The date specified in this subparagraph is the date which is 180 days after the date on which the collective bargaining agreement described in subparagraph (A) or (B) expires.")
rule DefaultScheduleImplementationDate432c7C(plan: MultiemployerPlan, y: TaxableYear, expired: Date) strict {
    label en official "expiration + 180 days";
    when cba_expiration_date_432c7(plan, y, expired)
        and bargaining_parties_failed_to_adopt_schedule_432c7(plan, y);
    then default_schedule_implementation_date_432c7C(plan, y, add_calendar_period(expired, 180 calendar_day));
}

pub relation schedule_stays_in_effect_for_agreement_432c6c(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(c)(6)(C): a schedule relied upon in negotiating an agreement remains in effect for the duration of that agreement";
}

pub relation schedule_relied_upon_in_negotiation_432c6c(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "a schedule provided by the sponsor was relied upon by the bargaining parties in negotiating an agreement, case-asserted";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "shall remain in effect for the duration of that collective bargaining agreement")
rule ScheduleStaysInEffectForAgreement432c6c(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "relied-upon schedule";
    when schedule_relied_upon_in_negotiation_432c6c(plan, y);
    then schedule_stays_in_effect_for_agreement_432c6c(plan, y);
}

pub relation funding_plan_adoption_period_end_432c8(plan: MultiemployerPlan, y: TaxableYear, day_before_improvement_period: Date) kind empirical {
    label en unofficial "the day before the first day of the funding improvement period, case-asserted";
}

pub relation funding_plan_adoption_period_432c8(plan: MultiemployerPlan, y: TaxableYear, from_date: Date, to_date: Date) kind institutional {
    label en official "section 432(c)(8): the funding plan adoption period begins on the date of the certification for the initial determination year and ends on the day before the first day of the funding improvement period";
}

@source(IRC_S432_C, relation = formalizes, coverage = exact, quote = "the term \"funding plan adoption period\" means the period beginning on the date of the certification")
rule FundingPlanAdoptionPeriod432c8(plan: MultiemployerPlan, y: TaxableYear, certified: Date, ends: Date) strict {
    label en official "certification date to the day before the improvement period";
    when funding_plan_certification_on_432c4a(plan, y, certified)
        and funding_plan_adoption_period_end_432c8(plan, y, ends);
    then funding_plan_adoption_period_432c8(plan, y, certified, ends);
}

// =====================================================================
// (f), (g), (i), (j)
// =====================================================================

pub relation payment_is_irrevocable_commitment_purchase_432f2a(payment: Person) kind empirical {
    label en unofficial "the payment is for the purchase of an irrevocable commitment from an insurer to pay benefits, case-asserted";
}

pub relation payment_within_restricted_payment_class_432f2a(payment: Person) kind institutional {
    label en official "section 432(f)(2)(A)(ii): a payment for the purchase of an irrevocable commitment from an insurer to pay benefits is a payment restricted by the paragraph";
}

@source(IRC_S432_F, relation = formalizes, coverage = exact, quote = "any payment for the purchase of an irrevocable commitment from an insurer to pay benefits")
rule PaymentWithinRestrictedPaymentClass432f2a(payment: Person) strict {
    label en official "irrevocable commitment";
    when payment_is_irrevocable_commitment_purchase_432f2a(payment);
    then payment_within_restricted_payment_class_432f2a(payment);
}

pub relation benefit_immediately_distributable_without_consent_411a11_432f2b(payment: Person) kind empirical {
    label en unofficial "the benefit may be immediately distributed without the participant's consent under section 411(a)(11), or is a makeup payment for a retroactive annuity starting date, case-asserted";
}

pub relation restriction_of_subparagraph_A_inapplicable_432f2b(payment: Person) kind institutional {
    label en official "section 432(f)(2)(B): subparagraph (A) does not apply to a benefit that may be distributed without consent or to a makeup payment";
}

@source(IRC_S432_F, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to a benefit which under section 411(a)(11) may be immediately distributed without the consent of the participant")
rule RestrictionOfSubparagraphAInapplicable432f2b(payment: Person) strict {
    label en official "small benefits and makeup payments";
    when benefit_immediately_distributable_without_consent_411a11_432f2b(payment);
    then restriction_of_subparagraph_A_inapplicable_432f2b(payment);
}

pub enum WithdrawalLiabilityDisregard432g {
    BenefitReductionsUnder10Years;
    Surcharges;
    ContributionIncreaseForPlan;
}

pub relation withdrawal_liability_item_432g(plan: MultiemployerPlan, employer: Person, kind: WithdrawalLiabilityDisregard432g, amount: Money) kind empirical {
    label en unofficial "an item in the withdrawal liability computation: benefit reductions (section 432(e)(8), (f), (e)(9)), surcharges under (e)(7), or a contribution increase required to meet the plan, case-asserted";
}

pub relation withdrawal_occurs_within_10_years_of_suspension_432g1(plan: MultiemployerPlan, employer: Person, years: Integer) kind empirical {
    label en unofficial "the number of years between the effective date of a benefit suspension and the withdrawal, case-asserted";
}

pub relation increase_due_to_increased_work_or_benefits_432g3b(plan: MultiemployerPlan, employer: Person) kind empirical {
    label en unofficial "the contribution increase is due to increased levels of work, employment or periods for which compensation is provided, or funds an increase in benefits, case-asserted";
}

pub relation item_disregarded_for_withdrawal_liability_432g(plan: MultiemployerPlan, employer: Person, kind: WithdrawalLiabilityDisregard432g) kind institutional {
    label en official "section 432(g): benefit reductions (unless the withdrawal occurs more than 10 years after the suspension), surcharges and required contribution increases (unless due to increased work or benefit increases) are disregarded in the withdrawal liability computation";
}

@source(IRC_S432_G, relation = formalizes, coverage = partial, quote = "unless the withdrawal occurs more than ten years after the effective date of a benefit suspension")
rule ItemDisregardedBenefitReductions432g1(plan: MultiemployerPlan, employer: Person, amount: Money, years: Integer) strict {
    label en official "PARTIAL: reductions disregarded when the withdrawal is within 10 years of the suspension (10 years is inside; the suspension effective date is a case fact)";
    when withdrawal_liability_item_432g(plan, employer, BenefitReductionsUnder10Years, amount)
        and withdrawal_occurs_within_10_years_of_suspension_432g1(plan, employer, years)
        and years <= 10;
    then item_disregarded_for_withdrawal_liability_432g(plan, employer, BenefitReductionsUnder10Years);
}

@source(IRC_S432_G, relation = formalizes, coverage = exact, quote = "Any surcharges under subsection (e)(7) shall be disregarded in determining the allocation of unfunded vested benefits to an employer under section 4211")
rule ItemDisregardedSurcharges432g2(plan: MultiemployerPlan, employer: Person, amount: Money) strict {
    label en official "surcharges";
    when withdrawal_liability_item_432g(plan, employer, Surcharges, amount);
    then item_disregarded_for_withdrawal_liability_432g(plan, employer, Surcharges);
}

@source(IRC_S432_G, relation = formalizes, coverage = exact, quote = "Any increase in the contribution rate (or other increase in contribution requirements unless due to increased levels of work, employment, or periods for which compensation is provided)")
rule ItemDisregardedContributionIncrease432g3(plan: MultiemployerPlan, employer: Person, amount: Money) strict {
    label en official "required increases, unless due to increased work or funding benefit increases";
    when withdrawal_liability_item_432g(plan, employer, ContributionIncreaseForPlan, amount)
        and not_known(increase_due_to_increased_work_or_benefits_432g3b(plan, employer));
    then item_disregarded_for_withdrawal_liability_432g(plan, employer, ContributionIncreaseForPlan);
}

pub relation employer_contributes_for_bargained_and_nonbargained_432i1(employer: Person, plan: MultiemployerPlan) kind empirical {
    label en unofficial "the employer contributes to the plan for employees covered by collective bargaining agreements and employees who are not, case-asserted";
}

pub relation nonbargained_employees_treated_as_covered_by_first_expiring_cba_432i1(employer: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(i)(1): when the plan is endangered or critical, the nonbargained employees' benefits and contributions (including surcharges) are determined as if covered under the first to expire of the employer's collective bargaining agreements";
}

@source(IRC_S432_I, relation = formalizes, coverage = partial, quote = "benefits of and contributions for the nonbargained employees, including surcharges on those contributions, shall be determined as if those nonbargained employees were covered under the first to expire")
rule NonbargainedEmployeesTreatedAsCoveredByFirstExpiringCba432i1(employer: Person, plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: while the plan is critical (endangered status is module 18)";
    when employer_contributes_for_bargained_and_nonbargained_432i1(employer, plan)
        and critical_status_432(plan, y);
    then nonbargained_employees_treated_as_covered_by_first_expiring_cba_432i1(employer, plan);
}

pub relation employer_contributes_only_for_nonbargained_432i2(employer: Person, plan: MultiemployerPlan, schedules_provided_on: Date) kind empirical {
    label en unofficial "the employer contributes only for employees not covered by a collective bargaining agreement, and the date the schedules are provided, case-asserted";
}

pub relation deemed_agreement_end_date_432i2(employer: Person, plan: MultiemployerPlan, ends_on: Date) kind institutional {
    label en official "section 432(i)(2): the employer is treated as the bargaining party and its participation agreement as an agreement ending on the first day of the plan year beginning after the employer is provided the schedules";
}

pub relation next_plan_year_start_after_schedules_432i2(employer: Person, plan: MultiemployerPlan, start: Date) kind empirical {
    label en unofficial "the first day of the plan year beginning after the employer is provided the schedules, case-asserted";
}

@source(IRC_S432_I, relation = formalizes, coverage = exact, quote = "with a term ending on the first day of the plan year beginning after the employer is provided the schedule or schedules")
rule DeemedAgreementEndDate432i2(employer: Person, plan: MultiemployerPlan, provided: Date, start: Date) strict {
    label en official "first day of the plan year after the schedules";
    when employer_contributes_only_for_nonbargained_432i2(employer, plan, provided)
        and next_plan_year_start_after_schedules_432i2(employer, plan, start);
    then deemed_agreement_end_date_432i2(employer, plan, start);
}

pub relation benefit_commencement_annuity_starting_date_432j10(participant: Person, on: Date) kind empirical {
    label en unofficial "the participant's annuity starting date, and for a retroactive annuity starting date the date on which benefit payments begin, case-asserted";
}

pub relation benefit_commencement_payments_begin_432j10(participant: Person, on: Date) kind empirical {
    label en unofficial "the date on which benefit payments begin, case-asserted";
}

pub relation retroactive_annuity_starting_date_432j10(participant: Person) kind empirical {
    label en unofficial "the annuity starting date is retroactive, case-asserted";
}

pub relation benefit_commencement_date_432j10(participant: Person, on: Date) kind institutional {
    label en official "section 432(j)(10): the annuity starting date, or for a retroactive annuity starting date the date on which benefit payments begin";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "The term \"benefit commencement date\" means the annuity starting date")
rule BenefitCommencementDateOrdinary432j10(participant: Person, on: Date) strict {
    label en official "ordinary annuity starting date";
    when benefit_commencement_annuity_starting_date_432j10(participant, on)
        and not_known(retroactive_annuity_starting_date_432j10(participant));
    then benefit_commencement_date_432j10(participant, on);
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "in the case of a retroactive annuity starting date, the date on which benefit payments begin")
rule BenefitCommencementDateRetroactive432j10(participant: Person, on: Date) strict {
    label en official "retroactive: the date payments begin";
    when retroactive_annuity_starting_date_432j10(participant)
        and benefit_commencement_payments_begin_432j10(participant, on);
    then benefit_commencement_date_432j10(participant, on);
}

pub relation bargaining_parties_employer_or_association_432j1(party: Person, plan: MultiemployerPlan, kind: Integer) kind empirical {
    label en unofficial "the party's kind (1 = an employer with an obligation to contribute, 2 = the association of employers that is the employer settlor of a section 404(c) plan, 3 = an employee organization representing plan participants employed by a contributing employer), case-asserted";
}

pub relation bargaining_party_432j1(party: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(j)(1): the bargaining parties are the employers with an obligation to contribute (or the settlor association of a section 404(c) plan) and the employee organizations representing participants employed by them";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "an employee organization which, for purposes of collective bargaining, represents plan participants employed by an employer who has an obligation to contribute under the plan")
rule BargainingParty432j1(party: Person, plan: MultiemployerPlan, kind: Integer) strict {
    label en official "kinds 1 to 3";
    when bargaining_parties_employer_or_association_432j1(party, plan, kind)
        and kind >= 1 and kind <= 3;
    then bargaining_party_432j1(party, plan);
}

pub relation accumulated_funding_deficiency_431a_432j3(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(j)(3): accumulated funding deficiency has the meaning of section 431(a)";
}

pub relation plan_sponsor_group_kind_432j9(person: Person, plan: MultiemployerPlan, kind: Integer) kind empirical {
    label en unofficial "the person's kind (1 = the association, committee, joint board of trustees or similar group of representatives of the parties who establish or maintain the plan, 2 = for a section 404(c) plan or its continuation, the bargaining parties), case-asserted";
}

pub relation plan_sponsor_432j9(person: Person, plan: MultiemployerPlan) kind institutional {
    label en official "section 432(j)(9): the plan sponsor of a multiemployer plan is the group of representatives of the parties who establish or maintain it (for a section 404(c) plan, the bargaining parties)";
}

@source(IRC_S432_J, relation = formalizes, coverage = exact, quote = "The term \"plan sponsor\" means, with respect to any multiemployer plan, the association, committee, joint board of trustees, or other similar group of representatives of the parties who establish or maintain the plan.")
rule PlanSponsor432j9(person: Person, plan: MultiemployerPlan, kind: Integer) strict {
    label en official "kinds 1 and 2";
    when plan_sponsor_group_kind_432j9(person, plan, kind)
        and (kind == 1 or kind == 2);
    then plan_sponsor_432j9(person, plan);
}

// =====================================================================
// (k) Special financial assistance
// =====================================================================

pub relation sfa_interest_rate_used_by_plan_432k1c(plan: MultiemployerPlan, rate: Decimal) kind empirical {
    label en unofficial "the interest rate the plan used in its most recently completed certification of plan status before January 1, 2021 (0.05 = 5 percent), case-asserted";
}

pub relation interest_rate_limit_430h2Ciii_plus_200bp_432k1cii(plan: MultiemployerPlan, rate: Decimal) kind empirical {
    label en unofficial "the rate specified in section 430(h)(2)(C)(iii) (without the (iv) modifications) for the month of the application or the 3 preceding months, case-asserted (the rate to be increased by 200 basis points)";
}

pub relation sfa_interest_rate_for_application_432k1ci(plan: MultiemployerPlan, rate: Decimal) kind institutional {
    label en official "section 432(k)(1)(C)(i)-(ii): the plan's prior interest rate, provided it does not exceed the interest rate limit (the specified rate plus 200 basis points)";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "with such specified rate increased by 200 basis points")
rule SfaInterestRateForApplication432k1ci(plan: MultiemployerPlan, used: Decimal, specified: Decimal) strict {
    label en official "PARTIAL: used <= specified + 0.02 (exact boundary: equal is allowed); the month selection (the application month or the 3 preceding) is a case input";
    when sfa_interest_rate_used_by_plan_432k1c(plan, used)
        and interest_rate_limit_430h2Ciii_plus_200bp_432k1cii(plan, specified)
        and used <= specified + 0.02;
    then sfa_interest_rate_for_application_432k1ci(plan, used);
}

pub relation sfa_payment_installments_432k2a(plan: MultiemployerPlan, months: Integer, commenced_within_months: Integer, interest_adjustment: Boolean) kind empirical {
    label en unofficial "the assistance is paid in equal monthly installments over 5 years, commencing within 3 months of the effective date, with (true) or without (false) an interest adjustment, case-asserted";
}

pub relation sfa_installment_payment_option_valid_432k2aII(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(2)(A)(ii)(II): equal monthly installments over a period of 5 years, commencing within 3 months of the effective date, with no adjustment for interest";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "in equal monthly installments over a period of 5 years, commencing within 3 months of such effective date, with no adjustment for interest")
rule SfaInstallmentPaymentOptionValid432k2aII(plan: MultiemployerPlan, months: Integer, within: Integer) strict {
    label en official "exact: 60 monthly installments, commencing within 3 months, no interest adjustment";
    when sfa_payment_installments_432k2a(plan, months, within, false)
        and months == 60 and within <= 3;
    then sfa_installment_payment_option_valid_432k2aII(plan);
}

pub relation sfa_amount_used_for_432k2d(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "special financial assistance received by the plan, case-asserted";
}

pub relation sfa_excluded_from_431_contributions_432k2di(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 432(k)(2)(D)(i): special financial assistance is not taken into account in determining the contributions required under section 431";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "shall not be taken into account for determining contributions required under section 431")
rule SfaExcludedFrom431Contributions432k2di(plan: MultiemployerPlan, y: TaxableYear, amount: Money) strict {
    label en official "received assistance";
    when sfa_amount_used_for_432k2d(plan, y, amount);
    then sfa_excluded_from_431_contributions_432k2di(plan, y, amount);
}

pub relation plan_insolvent_418E_after_sfa_432k2dii(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan becomes insolvent within the meaning of section 418E after receiving special financial assistance, case-asserted";
}

pub relation insolvent_plan_rules_apply_432k2dii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(2)(D)(ii): the plan is subject to all rules applicable to insolvent plans";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "the plan shall be subject to all rules applicable to insolvent plans")
rule InsolventPlanRulesApply432k2dii(plan: MultiemployerPlan) strict {
    label en official "insolvent after assistance";
    when plan_insolvent_418E_after_sfa_432k2dii(plan);
    then insolvent_plan_rules_apply_432k2dii(plan);
}

pub relation sfa_assistance_segregated_and_invested_432k2b(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the assistance is segregated from other plan assets and invested in investment-grade bonds or other investments the PBGC permits, case-asserted";
}

pub relation sfa_use_restriction_met_432k2b(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(2)(B): assistance may be used to pay benefits and expenses, must be segregated and invested as permitted";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "Such assistance shall be segregated from other plan assets")
rule SfaUseRestrictionMet432k2b(plan: MultiemployerPlan) strict {
    label en official "PARTIAL: the PBGC investment guidance is not pinned";
    when sfa_assistance_segregated_and_invested_432k2b(plan);
    then sfa_use_restriction_met_432k2b(plan);
}

pub relation suspended_benefit_reinstatement_described_432k1b(plan: MultiemployerPlan) kind empirical {
    label en unofficial "for a plan with an approved suspension under (e)(9), the application describes how suspended benefits will be reinstated, case-asserted";
}

pub relation sfa_application_reinstatement_description_ok_432k1b(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(1)(B): the application describes the reinstatement of suspended benefits";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "the application shall describe the manner in which suspended benefits will be reinstated")
rule SfaApplicationReinstatementDescriptionOk432k1b(plan: MultiemployerPlan) strict {
    label en official "PARTIAL: the section 4262 guidance is not pinned";
    when suspended_benefit_reinstatement_described_432k1b(plan);
    then sfa_application_reinstatement_description_ok_432k1b(plan);
}

pub relation sfa_changed_assumption_reasonable_432k1ciii(plan: MultiemployerPlan, is_interest_rate: Boolean) kind empirical {
    label en unofficial "a proposed change of a prior assumption in the application, and whether it is a change of the interest rate, case-asserted";
}

pub relation sfa_assumption_change_permitted_432k1ciii(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(1)(C)(iii): a plan may propose to change prior assumptions found unreasonable, disclosing the changes, but not the interest rate";
}

@source(IRC_S432_K, relation = formalizes, coverage = exact, quote = "The plan may not propose a change to the interest rate otherwise required under this subsection")
rule SfaAssumptionChangePermitted432k1ciii(plan: MultiemployerPlan) strict {
    label en official "assumptions other than the interest rate";
    when sfa_changed_assumption_reasonable_432k1ciii(plan, false);
    then sfa_assumption_change_permitted_432k1ciii(plan);
}

// =====================================================================
// (b)(3)(B)(i), (k)(1)(A), (k)(4) — ERISA/external basis and procedure
// gates (G6-ERISA wire). G4-pattern: the ERISA-side content (the §103(d)
// statement, the §4262 requirements and guidance, the PBGC/Secretary
// coordination) is a case-selected fact — the package does NOT re-derive
// ERISA. Pinned definitions live in `us.erisa.definitions`.
// =====================================================================

pub relation actuarial_statement_103d_available_432b3Bi(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the actuarial statement required under ERISA section 103(d) (29 USC 1023, pinned in us.erisa.definitions) with respect to the most recently filed annual report is available for the determination, case-asserted";
}

pub relation prior_year_valuation_available_432b3Bi(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the actuarial valuation for the preceding plan year is available for the determination, case-asserted";
}

pub relation actuary_basis_complete_432b3Bi(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(3)(B)(i)(I)-(II): the actuary's determinations and projections rest on the section 103(d) statement and the preceding-year valuation";
}

@source(IRC_S432_B, relation = formalizes, coverage = partial, quote = "the actuarial statement required under section 103(d) of the Employee Retirement Income Security Act of 1974 with respect to the most recently filed annual report, or")
rule ActuaryBasisComplete432b3Bi(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "PARTIAL: (I) is the section 103(d) statement, (II) the preceding-year valuation — both asserted as case facts";
    when actuarial_statement_103d_available_432b3Bi(plan, y)
        and prior_year_valuation_available_432b3Bi(plan, y);
    then actuary_basis_complete_432b3Bi(plan, y);
}

pub relation sfa_application_meets_pbgc_requirements_432k1a(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the special financial assistance application is submitted in accordance with the requirements of ERISA section 4262, including PBGC guidance — an external procedure, case-asserted";
}

pub relation sfa_application_requirements_met_432k1a(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(1)(A): the application meets the section 4262 requirements including PBGC guidance";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "Such application shall be submitted in accordance with the requirements of such section, including any guidance issued thereunder by the Pension Benefit Guaranty Corporation.")
rule SfaApplicationRequirementsMet432k1a(plan: MultiemployerPlan) strict {
    label en official "PARTIAL: the section 4262 requirements and PBGC guidance are external, asserted as one case fact";
    when sfa_application_meets_pbgc_requirements_432k1a(plan);
    then sfa_application_requirements_met_432k1a(plan);
}

pub relation pbgc_secretary_coordination_done_432k4(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the PBGC coordinated with the Secretary in prescribing the application process and reviewing the plan's application — an external procedure, case-asserted";
}

pub relation sfa_process_coordination_ok_432k4(plan: MultiemployerPlan) kind institutional {
    label en official "section 432(k)(4): PBGC/Secretary coordination in prescribing the process and reviewing applications";
}

@source(IRC_S432_K, relation = formalizes, coverage = partial, quote = "In prescribing the application process for eligible multiemployer plans to receive special financial assistance under section 4262 of the Employee Retirement Income Security Act of 1974 and reviewing applications of such plans, the Pension Benefit Guaranty Corporation shall coordinate with the Secretary in the following manner:")
rule SfaProcessCoordinationOk432k4(plan: MultiemployerPlan) strict {
    label en official "PARTIAL: the coordination manner is an external procedure, asserted as one case fact";
    when pbgc_secretary_coordination_done_432k4(plan);
    then sfa_process_coordination_ok_432k4(plan);
}
