// Section 431 — STAGE 2f (IRC-09, DECISION-0379, 25.09.2026): the funding
// standard account of a multiemployer plan. (a) accumulated funding
// deficiency as charges minus credits, (b)(2)-(3) the charge and credit
// items and their amortization periods, (b)(8) the 2008 investment loss
// election, (c)(5)-(6) the full-funding limitation, (c)(7)-(8) valuation date
// and contributions deemed made on the last day, (d) extensions of the
// amortization period, and the sponsor's and Secretary's duties.
//
// Method: each account item is a case-asserted amount by kind and plan year;
// the totals are sums over the items, the accumulated deficiency an exact
// difference. Level amortization installments use the ordinary-annuity
// payment with the discount growth written as an unrolled product (5 years
// is one factor, longer periods are products of it), rounded to the cent.
// Percentages are fractions (0.90 = 90 percent). Actuarial values (normal
// cost, past service liability, experience and assumption gains and losses,
// current liability) are case inputs.

use self::{
    CsecChargeKind433,
    IRC_S431_A,
    IRC_S431_B,
    IRC_S431_C,
    IRC_S431_D,
    MultiemployerPlan,
    Person,
    TaxableYear,
    multiemployer_bargaining_party_432,
    multiemployer_plan_sponsor_432,
};

pub enum FundingChargeKind431 {
    NormalCost;
    PastServiceLiabilityAmortization;
    AmendmentIncreaseAmortization;
    ExperienceLossAmortization;
    AssumptionLossAmortization;
    WaivedDeficiencyAmortization;
    CreditBalanceAmortization5Years;
    ContributionsButForOldLawAmortization20Years;
}

pub enum FundingCreditKind431 {
    EmployerContribution;
    AmendmentDecreaseAmortization;
    ExperienceGainAmortization;
    AssumptionGainAmortization;
    WaivedFundingDeficiency;
    DebitBalanceAfterAlternativeStandard;
}

pub relation funding_standard_account_maintained_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan has established and maintains a funding standard account, case-asserted (section 431(b)(1))";
}

pub relation funding_account_charge_item_431(plan: MultiemployerPlan, y: TaxableYear, kind: FundingChargeKind431, amount: Money) kind empirical {
    label en unofficial "a charge to the funding standard account for the plan year, by kind, case-asserted (section 431(b)(2))";
}

pub relation funding_account_credit_item_431(plan: MultiemployerPlan, y: TaxableYear, kind: FundingCreditKind431, amount: Money) kind empirical {
    label en unofficial "a credit to the funding standard account for the plan year, by kind, case-asserted (section 431(b)(3))";
}

// ---------------------------------------------------------------------
// (b)(2), (b)(3), (a) Totals and the accumulated funding deficiency
// ---------------------------------------------------------------------

pub relation funding_charges_for_year_431(plan: MultiemployerPlan, y: TaxableYear, total: Money) kind institutional {
    label en official "section 431(b)(2): the sum of the charges to the funding standard account for the plan year";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "For a plan year, the funding standard account shall be charged with the sum of")
rule FundingChargesForYear431(plan: MultiemployerPlan, y: TaxableYear, first: FundingChargeKind431, first_amount: Money) strict {
    label en official "sum over the recorded items of the plan year";
    when funding_account_charge_item_431(plan, y, first, first_amount);
    then funding_charges_for_year_431(plan, y,
        sum all amt: Money for k: FundingChargeKind431 where funding_account_charge_item_431(plan, y, k, amt));
}

pub relation funding_credits_for_year_431(plan: MultiemployerPlan, y: TaxableYear, total: Money) kind institutional {
    label en official "section 431(b)(3): the sum of the credits to the funding standard account for the plan year";
}

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "For a plan year, the funding standard account shall be credited with the sum of")
rule FundingCreditsForYear431(plan: MultiemployerPlan, y: TaxableYear, first: FundingCreditKind431, first_amount: Money) strict {
    label en official "sum over the recorded items of the plan year";
    when funding_account_credit_item_431(plan, y, first, first_amount);
    then funding_credits_for_year_431(plan, y,
        sum all amt: Money for k: FundingCreditKind431 where funding_account_credit_item_431(plan, y, k, amt));
}

pub relation accumulated_funding_deficiency_431a(plan: MultiemployerPlan, amount: Money) kind institutional {
    label en official "section 431(a): the excess, as of the end of the plan year, of the total charges for all plan years over the total credits";
}

@source(IRC_S431_A, relation = formalizes, coverage = exact, quote = "the excess (if any) of the total charges to the funding standard account of the plan for all plan years (beginning with the first plan year for which this part applies to the plan) over the total credits to such account for such years")
rule AccumulatedFundingDeficiency431a(plan: MultiemployerPlan) strict {
    label en official "exact difference of the two all-year sums, when positive";
    when funding_standard_account_maintained_431(plan)
        and (sum all c: Money for y: TaxableYear where funding_charges_for_year_431(plan, y, c))
            > (sum all d: Money for y2: TaxableYear where funding_credits_for_year_431(plan, y2, d));
    then accumulated_funding_deficiency_431a(plan,
        (sum all c: Money for y: TaxableYear where funding_charges_for_year_431(plan, y, c))
        - (sum all d: Money for y2: TaxableYear where funding_credits_for_year_431(plan, y2, d)));
}

pub relation funding_deficiency_exists_431a(plan: MultiemployerPlan) kind institutional {
    label en official "helper for not_known: a positive accumulated funding deficiency exists";
}

rule FundingDeficiencyExists431a(plan: MultiemployerPlan, amount: Money) strict {
    label en unofficial "derives the helper";
    when accumulated_funding_deficiency_431a(plan, amount);
    then funding_deficiency_exists_431a(plan);
}

// ---------------------------------------------------------------------
// (b)(1) Account maintenance
// ---------------------------------------------------------------------

@source(IRC_S431_B, relation = formalizes, coverage = exact, quote = "Each multiemployer plan to which this part applies shall establish and maintain a funding standard account.")
rule FundingStandardAccountDuty431(plan: MultiemployerPlan, sponsor: Person, party: Person) strict {
    label en official "the sponsor keeps the account for as long as the plan exists (no window)";
    when multiemployer_plan_sponsor_432(plan, sponsor) and multiemployer_bargaining_party_432(plan, party);
    then duty MaintainFundingStandardAccountDuty {
        bearer sponsor;
        beneficiary party;
        goal maintenance {
            condition funding_standard_account_maintained_431(plan);
            window [-infinity, infinity];
        }
    };
}

// ---------------------------------------------------------------------
// (b)(2)(B)-(E) Amortization periods and level installments
// ---------------------------------------------------------------------

pub relation amortization_growth_5_years_431(plan: MultiemployerPlan, y: TaxableYear, factor: Decimal) kind institutional {
    label en unofficial "(1 + r)^5 for the plan's interest rate, an unrolled product of 5 factors";
}

pub relation amortization_interest_rate_431(plan: MultiemployerPlan, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the interest rate at which the account is charged and credited with interest (section 431(b)(6)), case-asserted";
}

rule AmortizationGrowth5Years431(plan: MultiemployerPlan, y: TaxableYear, r: Decimal) strict {
    label en unofficial "(1+r) five times";
    when amortization_interest_rate_431(plan, y, r);
    then amortization_growth_5_years_431(plan, y, (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r));
}

pub relation amortization_base_431(plan: MultiemployerPlan, y: TaxableYear, kind: FundingChargeKind431, base: Money) kind empirical {
    label en unofficial "the amount to be amortized for the kind, case-asserted";
}

pub relation level_installment_15_years_431(plan: MultiemployerPlan, y: TaxableYear, kind: FundingChargeKind431, amount: Money) kind institutional {
    label en official "section 431(b)(2)(B)-(C): the equal annual installment amortizing the base over 15 plan years";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "the amounts necessary to amortize in equal annual installments (until fully amortized)")
rule LevelInstallment15Years431(plan: MultiemployerPlan, y: TaxableYear, kind: FundingChargeKind431, base: Money, r: Decimal, f5: Decimal) strict {
    label en official "PARTIAL: only the 15-year kinds ((B)(i)-(iv) and (C)); ordinary-annuity payment base x r x g / (g - 1) with g = (1+r)^15 = f5^3, rounded to the cent; the timing convention is an open point, as in module 18 for section 430";
    when amortization_base_431(plan, y, kind, base)
        and kind != NormalCost
        and kind != CreditBalanceAmortization5Years
        and kind != ContributionsButForOldLawAmortization20Years
        and amortization_interest_rate_431(plan, y, r)
        and amortization_growth_5_years_431(plan, y, f5)
        and r > 0.0
        and base > 0.00 USD;
    then level_installment_15_years_431(plan, y, kind, div_round(base * r * (f5 * f5 * f5), (f5 * f5 * f5) - 1.0, 2, "HALF_UP"));
}

pub relation level_installment_5_years_431(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(b)(2)(D): the equal annual installment amortizing a credit balance over 5 plan years";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "over a period of 5 plan years any amount credited to the funding standard account under section 412(b)(3)(D)")
rule LevelInstallment5Years431(plan: MultiemployerPlan, y: TaxableYear, base: Money, r: Decimal, f5: Decimal) strict {
    label en official "PARTIAL: base x r x f5 / (f5 - 1)";
    when amortization_base_431(plan, y, CreditBalanceAmortization5Years, base)
        and amortization_interest_rate_431(plan, y, r)
        and amortization_growth_5_years_431(plan, y, f5)
        and r > 0.0 and base > 0.00 USD;
    then level_installment_5_years_431(plan, y, div_round(base * r * f5, f5 - 1.0, 2, "HALF_UP"));
}

pub relation level_installment_20_years_431(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(b)(2)(E): the equal annual installment amortizing the old-law contributions over 20 years";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "over a period of 20 years the contributions which would be required to be made under the plan but for the provisions of section 412(c)(7)(A)(i)(I)")
rule LevelInstallment20Years431(plan: MultiemployerPlan, y: TaxableYear, base: Money, r: Decimal, f5: Decimal) strict {
    label en official "PARTIAL: base x r x g / (g - 1) with g = f5^4";
    when amortization_base_431(plan, y, ContributionsButForOldLawAmortization20Years, base)
        and amortization_interest_rate_431(plan, y, r)
        and amortization_growth_5_years_431(plan, y, f5)
        and r > 0.0 and base > 0.00 USD;
    then level_installment_20_years_431(plan, y, div_round(base * r * (f5 * f5 * f5 * f5), (f5 * f5 * f5 * f5) - 1.0, 2, "HALF_UP"));
}

// ---------------------------------------------------------------------
// (b)(8) Election for net investment losses of the first two plan years
// ending after August 31, 2008
// ---------------------------------------------------------------------

pub relation solvency_test_certified_431b8c(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan actuary certifies that the plan is projected to have sufficient assets to timely pay expected benefits and anticipated expenditures over the amortization period, case-asserted (section 431(b)(8)(C))";
}

pub relation investment_loss_year_ordinal_after_aug_31_2008_431(plan: MultiemployerPlan, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "1 or 2 when the plan year is the first or second plan year ending after August 31, 2008, case-asserted";
}

pub relation separate_30_year_investment_loss_amortization_431b8a(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(b)(8)(A)(i): a plan meeting the solvency test may amortize the investment-loss part of an experience loss or gain separately over 30 plan years";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "A multiemployer plan with respect to which the solvency test under subparagraph (C) is met may treat the portion of any experience loss or gain attributable to net investment losses incurred in either or both of the first two plan years ending after August 31, 2008")
rule Separate30YearAmortization431b8a(plan: MultiemployerPlan, y: TaxableYear, n: Integer) strict {
    label en official "PARTIAL: eligibility only; the schedule is a ledger not derived";
    when solvency_test_certified_431b8c(plan)
        and investment_loss_year_ordinal_after_aug_31_2008_431(plan, y, n)
        and n >= 1 and n <= 2;
    then separate_30_year_investment_loss_amortization_431b8a(plan, y);
}

pub relation b8_notices_given_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor gave notice of the application to participants and beneficiaries and informed the PBGC, case-asserted";
}

@source(IRC_S431_B, relation = formalizes, coverage = partial, quote = "A plan sponsor of a plan to which this paragraph applies shall")
rule B8NoticeDuty431(plan: MultiemployerPlan, y: TaxableYear, sponsor: Person, party: Person) strict {
    label en official "PARTIAL: no statutory time; the PBGC form and manner are the Director's";
    when separate_30_year_investment_loss_amortization_431b8a(plan, y)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and multiemployer_bargaining_party_432(plan, party);
    then duty B8NoticeDutyPosition {
        bearer sponsor;
        beneficiary party;
        goal maintenance {
            condition b8_notices_given_431(plan);
            window [-infinity, infinity];
        }
    };
}

// ---------------------------------------------------------------------
// (c)(5), (c)(6) Full-funding limitation
// ---------------------------------------------------------------------

pub relation accrued_liability_entry_age_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the accrued liability including normal cost (entry age normal if it cannot be calculated directly), case-asserted (section 431(c)(6)(A)(i))";
}

pub relation asset_fair_market_value_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the plan's assets, case-asserted ((A)(ii)(I))";
}

pub relation asset_actuarial_value_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the assets determined under paragraph (2), case-asserted ((A)(ii)(II))";
}

pub relation current_liability_with_accruals_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the current liability including the expected increase due to benefits accruing during the plan year, case-asserted ((B)(i)(I))";
}

pub relation full_funding_limitation_a_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(c)(6)(A): the excess of the accrued liability over the lesser of fair market value and the actuarial value of assets";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "the term \"full-funding limitation\" means the excess (if any) of")
rule FullFundingLimitationA431c6(plan: MultiemployerPlan, y: TaxableYear, liability: Money, fmv: Money, actuarial: Money) strict {
    label en official "liability - min(fmv, actuarial value), floored at zero";
    when accrued_liability_entry_age_431c6(plan, y, liability)
        and asset_fair_market_value_431c6(plan, y, fmv)
        and asset_actuarial_value_431c6(plan, y, actuarial);
    then full_funding_limitation_a_431c6(plan, y, max(liability - min(fmv, actuarial), 0.00 USD));
}

pub relation full_funding_limitation_431c6(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(c)(6): the (A) limitation, but not less than the excess of 90 percent of the current liability over the actuarial value of assets";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "In no event shall the full-funding limitation determined under subparagraph (A) be less than the excess (if any) of")
rule FullFundingLimitation431c6(plan: MultiemployerPlan, y: TaxableYear, base: Money, current: Money, actuarial: Money) strict {
    label en official "max of the (A) amount and 0.9 x current liability - actuarial value (assets are not reduced by a credit balance, (B)(ii))";
    when full_funding_limitation_a_431c6(plan, y, base)
        and current_liability_with_accruals_431c6(plan, y, current)
        and asset_actuarial_value_431c6(plan, y, actuarial);
    then full_funding_limitation_431c6(plan, y, max(base, max(current * 0.90 - actuarial, 0.00 USD)));
}

pub relation deficiency_before_ffl_431c5(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the accumulated funding deficiency the plan would have as of the close of the plan year without regard to paragraph (5), case-asserted";
}

pub relation ffl_credit_431c5(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 431(c)(5)(A): the funding standard account is credited with the excess of the deficiency over the full-funding limitation";
}

@source(IRC_S431_C, relation = formalizes, coverage = partial, quote = "the funding standard account shall be credited with the amount of such excess")
rule FflCredit431c5(plan: MultiemployerPlan, y: TaxableYear, deficiency: Money, limit: Money) strict {
    label en official "PARTIAL: deficiency - limitation when positive; the reduction of the amortization charges to zero ((B)) is a ledger not derived";
    when deficiency_before_ffl_431c5(plan, y, deficiency) and full_funding_limitation_431c6(plan, y, limit) and deficiency > limit;
    then ffl_credit_431c5(plan, y, deficiency - limit);
}

// ---------------------------------------------------------------------
// (c)(7), (c)(8) Valuation date and contributions deemed made
// ---------------------------------------------------------------------

pub relation valuation_date_431c7(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date as of which the valuation is made, case-asserted";
}

pub relation valuation_year_bounds_431c7(plan: MultiemployerPlan, y: TaxableYear, first_day: Date, last_day: Date) kind empirical {
    label en unofficial "the first and last day of the plan year the valuation refers to, case-asserted";
}

pub relation valuation_date_permitted_431c7b(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(c)(7)(B)(i): the valuation date is within the plan year or within one month before its beginning";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "shall be made as of a date within the plan year to which the valuation refers or within one month prior to the beginning of such year")
rule ValuationDatePermitted431c7b(plan: MultiemployerPlan, y: TaxableYear, v: Date, first_day: Date, last_day: Date, calendar_before_1: Date) strict {
    label en official "exact boundaries: one calendar month before the first day through the last day, inclusive";
    when valuation_date_431c7(plan, y, v)
        and valuation_year_bounds_431c7(plan, y, first_day, last_day)
        and v >= calendar_before_1
        and v <= last_day
        and us.irc.core::civil_calendar_boundary_before(first_day, 1, us.irc.core::CalendarMonth, calendar_before_1);
    then valuation_date_permitted_431c7b(plan, y);
}

pub relation employer_contribution_made_on_431(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date an employer contribution for the plan year is made, case-asserted";
}

pub relation contribution_deemed_made_on_last_day_431c8(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 431(c)(8): a contribution made within two and one-half months after the last day of the plan year is deemed made on that day";
}

@source(IRC_S431_C, relation = formalizes, coverage = exact, quote = "any contributions for a plan year made by an employer after the last day of such plan year, but not later than two and one-half months after such day, shall be deemed to have been made on such last day")
rule ContributionDeemedMadeOnLastDay431c8(plan: MultiemployerPlan, y: TaxableYear, made: Date, last_day: Date) strict {
    label en official "INTERPRETATION: two and one-half months is read as 2 calendar months and 15 days (the reading used for section 430(j)); the boundary day is inclusive; the regulatory extension of up to six months is not derived";
    when employer_contribution_made_on_431(plan, y, made)
        and valuation_year_bounds_431c7(plan, y, _, last_day)
        and made > last_day
        and made <= add_calendar_period(add_calendar_period(last_day, 2 calendar_month), 15 calendar_day);
    then contribution_deemed_made_on_last_day_431c8(plan, y);
}

// ---------------------------------------------------------------------
// (d) Extension of the amortization period
// ---------------------------------------------------------------------

pub relation extension_application_submitted_431d1(plan: MultiemployerPlan, sponsor: Person, years: Integer) kind empirical {
    label en unofficial "the sponsor submits an application for an extension of the amortization period for this number of years, with the actuary's certification, case-asserted (section 431(d)(1)(A))";
}

pub relation d1_certification_absent_extension_deficiency_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the actuary certifies that, absent the extension, the plan would have an accumulated funding deficiency in the current or any of the 9 succeeding plan years, case-asserted ((B)(i))";
}

pub relation d1_certification_plan_adopted_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the sponsor has adopted a plan to improve the plan's funding status, case-asserted ((B)(ii))";
}

pub relation d1_certification_sufficient_assets_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the plan is projected to have sufficient assets to timely pay expected benefits and anticipated expenditures, case-asserted ((B)(iii))";
}

pub relation d1_notice_provided_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the notice required under paragraph (3)(A) has been provided, case-asserted ((B)(iv))";
}

pub relation d1_certification_complete_431(plan: MultiemployerPlan) kind institutional {
    label en official "section 431(d)(1)(B): the actuary's certification meets all four conditions";
}

@source(IRC_S431_D, relation = formalizes, coverage = exact, quote = "the notice required under paragraph (3)(A) has been provided")
rule D1CertificationComplete431(plan: MultiemployerPlan) strict {
    label en official "(i), (ii), (iii) and (iv)";
    when d1_certification_absent_extension_deficiency_431(plan)
        and d1_certification_plan_adopted_431(plan)
        and d1_certification_sufficient_assets_431(plan)
        and d1_notice_provided_431(plan);
    then d1_certification_complete_431(plan);
}

pub relation amortization_extension_required_431d1(plan: MultiemployerPlan, years: Integer) kind institutional {
    label en official "section 431(d)(1)(A): the Secretary shall extend the amortization period for the period specified in the application, at most 5 years";
}

@source(IRC_S431_D, relation = formalizes, coverage = exact, quote = "the Secretary shall extend the amortization period for the period of time (not in excess of 5 years) specified in the application")
rule AmortizationExtensionRequired431d1(plan: MultiemployerPlan, sponsor: Person, years: Integer) strict {
    label en official "exact boundary: 5 years is allowed, 6 is not";
    when extension_application_submitted_431d1(plan, sponsor, years)
        and d1_certification_complete_431(plan)
        and years >= 1 and years <= 5;
    then amortization_extension_required_431d1(plan, years);
}

pub relation extension_granted_under_d1_years_431(plan: MultiemployerPlan, years: Integer) kind empirical {
    label en unofficial "the number of years of extension already granted under paragraph (1) for the same unfunded liability, case-asserted";
}

pub relation maximum_discretionary_extension_431d2(plan: MultiemployerPlan, years: Integer) kind institutional {
    label en official "section 431(d)(2)(A): the Secretary may extend by up to 10 years reduced by the years of any extension under paragraph (1)";
}

@source(IRC_S431_D, relation = formalizes, coverage = exact, quote = "not in excess of 10 years reduced by the number of years of any extension under paragraph (1) with respect to such unfunded liability")
rule MaximumDiscretionaryExtension431d2(plan: MultiemployerPlan, granted: Integer) strict {
    label en official "10 - years already granted (never below zero)";
    when extension_granted_under_d1_years_431(plan, granted) and granted <= 10;
    then maximum_discretionary_extension_431d2(plan, 10 - granted);
}

pub relation d2_application_submitted_on_431(plan: MultiemployerPlan, on: Date) kind empirical {
    label en unofficial "the date the plan sponsor submits an application under paragraph (2), case-asserted";
}

pub relation secretary_431(secretary: Person) kind empirical {
    label en unofficial "the Secretary of the Treasury as the acting person, case-asserted";
}

pub relation d2_application_acted_upon_431(plan: MultiemployerPlan) kind empirical {
    label en unofficial "the Secretary has acted upon the application, case-asserted";
}

@source(IRC_S431_D, relation = formalizes, coverage = partial, quote = "The Secretary shall act upon any application for an extension under this paragraph within 180 days of the submission of such application.")
rule SecretaryActsOnExtensionDuty431(plan: MultiemployerPlan, sponsor: Person, secretary: Person, applied: Date) strict {
    label en official "PARTIAL: the 180-day window; the notice of rejection with reasons is not derived";
    when d2_application_submitted_on_431(plan, applied)
        and multiemployer_plan_sponsor_432(plan, sponsor)
        and secretary_431(secretary);
    then duty SecretaryActsOnExtensionDutyPosition {
        bearer secretary;
        beneficiary sponsor;
        goal achievement {
            condition d2_application_acted_upon_431(plan);
            window [-infinity, add_calendar_period(applied, 180 calendar_day)];
        }
    };
}
