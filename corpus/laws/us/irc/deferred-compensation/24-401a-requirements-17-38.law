// Section 401(a) — STAGE 2e residual, part 2 (IRC-09, DECISION-0379,
// 25.09.2026): paragraphs (19), (20), (22)-(27), (28) remainder, (29),
// (32)-(38) and the closing sentence. Same method as module 23: a
// requirement is a classification over plan terms; a prohibition or duty
// carries a person's conduct where the text names one.
//
// Not attempted here (recorded in the coverage rows and TECH-GAPS): the
// paragraph (17)(B) indexed amount (SOURCE_GAP), the survivor annuity
// computation of (13)(D) (actuarial), paragraph (35)(B)-(C) election
// mechanics beyond the eligibility test (the reinvestment itself).

// =====================================================================
// (a)(19) Forfeiture on withdrawal of employee contributions
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    Distribution,
    IRC_S401_A,
    IRC_S401_TABLE_1,
    Individual,
    Person,
    Plan,
    TaxableYear,
    plan_is_governmental_414d,
};

pub relation accrued_benefit_forfeited_solely_for_withdrawal(plan: Plan, participant: Person) kind empirical {
    label en unofficial "a part of the accrued benefit derived from employer contributions is forfeitable solely because the participant withdrew amounts attributable to his own contributions, case-asserted";
}

pub relation nonforfeitable_percentage_at_withdrawal(plan: Plan, participant: Person, pct: Decimal) kind empirical {
    label en unofficial "the percentage of the accrued benefit that was nonforfeitable when the participant withdrew, as a percentage such as 50.0, case-asserted";
}

pub relation proportional_forfeiture_permitted_411a3Diii(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the forfeiture is permitted under section 411(a)(3)(D)(iii) (proportional forfeiture of benefits accrued before September 2, 1974 on withdrawal of certain mandatory contributions), case-asserted";
}

pub relation forfeiture_on_withdrawal_violation_401a19(plan: Plan, participant: Person) kind institutional {
    label en official "section 401(a)(19): employer-derived accrued benefit forfeitable solely by reason of the participant's withdrawal, where he was at least 50 percent vested at the time";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to the accrued benefit of any participant unless, at the time of such withdrawal, such participant has a nonforfeitable right to at least 50 percent of such accrued benefit")
rule ForfeitureOnWithdrawalViolation401a19(plan: Plan, participant: Person, pct: Decimal) strict {
    label en official "exact boundary: 50 percent vested triggers the rule, 49.99 does not; the section 411(a)(3)(D)(iii) exception defeats it";
    when accrued_benefit_forfeited_solely_for_withdrawal(plan, participant)
        and nonforfeitable_percentage_at_withdrawal(plan, participant, pct)
        and pct >= 50.0
        and not_known(proportional_forfeiture_permitted_411a3Diii(plan, participant));
    then forfeiture_on_withdrawal_violation_401a19(plan, participant);
}

// =====================================================================
// (a)(20) Distributions on plan termination
// =====================================================================

pub relation termination_distribution_made_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "one or more distributions within a taxable year on account of a termination of the plan (pension plan) or a complete discontinuance of contributions (profit-sharing or stock bonus plan), made on this date, case-asserted";
}

pub relation pbgc_notice_filed_on(plan: DefinedBenefitPlan, on: Date) kind empirical {
    label en unofficial "the employer filed the notice of the payment or distribution with the PBGC, at the time and in the manner the PBGC prescribes, on this date, case-asserted";
}

pub relation pbgc_approved_distribution(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the PBGC approved the payment or distribution, case-asserted";
}

pub relation pbgc_disapproved_within_90_days(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the PBGC disapproved the payment or distribution within 90 days after the notice was filed, case-asserted";
}

pub relation termination_distribution_not_disqualifying(plan: Plan) kind institutional {
    label en official "section 401(a)(20): termination distributions do not by themselves stop the trust being qualified; for a defined benefit plan the PBGC notice and approval (or 90 days of non-disapproval) is required";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to constitute a qualified trust under this section merely because the pension plan of which such trust is a part makes 1 or more distributions within 1 taxable year to a distributee on account of a termination of the plan")
rule TerminationDistributionNotDisqualifyingNonDb(plan: DefinedContributionPlan, on: Date) strict {
    label en official "profit-sharing, stock bonus and other defined contribution plans need no PBGC notice";
    when termination_distribution_made_on(plan, on);
    then termination_distribution_not_disqualifying(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the Corporation has approved such payment or distribution or, within 90 days after the date on which such notice was filed, has failed to disapprove such payment or distribution")
rule TerminationDistributionNotDisqualifyingDbApproved(plan: DefinedBenefitPlan, on: Date, filed: Date) strict {
    label en official "defined benefit plan: notice filed and approved by the PBGC";
    when termination_distribution_made_on(plan, on)
        and pbgc_notice_filed_on(plan, filed)
        and pbgc_approved_distribution(plan);
    then termination_distribution_not_disqualifying(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the Corporation has approved such payment or distribution or, within 90 days after the date on which such notice was filed, has failed to disapprove such payment or distribution")
rule TerminationDistributionNotDisqualifyingDbSilence(plan: DefinedBenefitPlan, on: Date, filed: Date) strict {
    label en official "defined benefit plan: 90 days passed without disapproval; the distribution is on or after day 90";
    when termination_distribution_made_on(plan, on)
        and pbgc_notice_filed_on(plan, filed)
        and on >= add_calendar_period(filed, 90 calendar_day)
        and not_known(pbgc_disapproved_within_90_days(plan));
    then termination_distribution_not_disqualifying(plan);
}

// =====================================================================
// (a)(22)-(25) Employer securities, group trusts, actuarial assumptions
// =====================================================================

pub relation dc_plan_other_than_profit_sharing(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the defined contribution plan is not a profit-sharing plan, case-asserted";
}

pub relation employer_stock_not_readily_tradable(plan: Plan) kind empirical {
    label en unofficial "the employer's stock is not readily tradable on an established market, case-asserted";
}

pub relation employer_securities_percent_of_assets(plan: Plan, pct: Decimal) kind empirical {
    label en unofficial "after acquiring securities of the employer, the percentage of the plan's total assets that are securities of the employer, case-asserted";
}

pub relation employer_publishes_newspaper_of_general_circulation(plan: Plan) kind empirical {
    label en unofficial "the employer's trade or business consists of publishing on a regular basis a newspaper for general circulation, case-asserted (section 401(a)(22) second sentence)";
}

pub relation plan_meets_409e_pass_through_voting(plan: Plan) kind empirical {
    label en unofficial "the plan meets the requirements of section 409(e), case-asserted";
}

pub relation section_409e_required_401a22(plan: Plan) kind institutional {
    label en official "section 401(a)(22): a non-profit-sharing defined contribution plan of an employer whose stock is not readily tradable, holding more than 10 percent employer securities, must meet section 409(e) (newspaper publishers excepted)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "after acquiring securities of the employer, more than 10 percent of the total assets of the plan are securities of the employer")
rule Section409eRequired401a22(plan: DefinedContributionPlan, pct: Decimal) defeasible {
    label en official "exact boundary: more than 10 percent (10.0 itself does not trigger)";
    when dc_plan_other_than_profit_sharing(plan)
        and employer_stock_not_readily_tradable(plan)
        and employer_securities_percent_of_assets(plan, pct)
        and pct > 10.0;
    unless employer_publishes_newspaper_of_general_circulation(plan);
    then section_409e_required_401a22(plan);
}

pub relation meets_401a22(plan: Plan) kind institutional {
    label en official "section 401(a)(22): section 409(e) is met where required";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "any trust forming part of such plan shall not constitute a qualified trust under this section unless the plan meets the requirements of subsection (e) of section 409")
rule Meets401a22Required(plan: Plan) defeasible {
    label en official "required and met";
    when section_409e_required_401a22(plan) and plan_meets_409e_pass_through_voting(plan);
    then meets_401a22(plan);
}

pub relation stock_bonus_plan_401a23(plan: Plan) kind empirical {
    label en unofficial "the plan is a stock bonus plan, case-asserted";
}

pub relation plan_meets_409h_and_409o(plan: Plan) kind empirical {
    label en unofficial "the plan meets section 409(h) (put option, with employer securities including any securities of the employer held by the plan) and section 409(o) (distribution rules), case-asserted";
}

pub relation meets_401a23_stock_bonus(plan: Plan) kind institutional {
    label en official "section 401(a)(23): a stock bonus plan meets subsections (h) and (o) of section 409";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A stock bonus plan shall not be treated as meeting the requirements of this section unless such plan meets the requirements of subsections (h) and (o) of section 409")
rule Meets401a23StockBonus(plan: Plan) strict {
    label en official "stock bonus plan with 409(h) and 409(o) met";
    when stock_bonus_plan_401a23(plan) and plan_meets_409h_and_409o(plan);
    then meets_401a23_stock_bonus(plan);
}

pub relation group_trust_moneys_of_818a6_plan_or_unit(plan: Plan) kind empirical {
    label en unofficial "the group trust includes the moneys of a plan or governmental unit described in section 818(a)(6), case-asserted";
}

pub relation group_trust_otherwise_qualified(plan: Plan) kind empirical {
    label en unofficial "the group trust otherwise meets the requirements of the section, case-asserted";
}

pub relation group_trust_not_disqualified_by_818a6_moneys(plan: Plan) kind institutional {
    label en official "section 401(a)(24): the participation or inclusion of section 818(a)(6) moneys does not by itself disqualify the group trust";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "shall not be treated as not meeting such requirements on account of the participation or inclusion in such trust of the moneys of any plan or governmental unit described in section 818(a)(6)")
rule GroupTrustNotDisqualifiedBy818a6Moneys(plan: Plan) strict {
    label en official "the inclusion is disregarded";
    when group_trust_otherwise_qualified(plan) and group_trust_moneys_of_818a6_plan_or_unit(plan);
    then group_trust_not_disqualified_by_818a6_moneys(plan);
}

pub relation actuarial_assumptions_specified_without_discretion(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "whenever a benefit amount depends on actuarial assumptions, the plan specifies them in a way that precludes employer discretion, case-asserted";
}

pub relation benefit_determined_by_actuarial_assumptions(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "some benefit amount under the plan is determined on the basis of actuarial assumptions, case-asserted";
}

pub relation definitely_determinable_benefits_401a25(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(a)(25): the plan provides definitely determinable benefits";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A defined benefit plan shall not be treated as providing definitely determinable benefits unless, whenever the amount of any benefit is to be determined on the basis of actuarial assumptions, such assumptions are specified in the plan in a way which precludes employer discretion")
rule DefinitelyDeterminableBenefits401a25(plan: DefinedBenefitPlan) strict {
    label en official "assumptions specified without employer discretion where used";
    when benefit_determined_by_actuarial_assumptions(plan) and actuarial_assumptions_specified_without_discretion(plan);
    then definitely_determinable_benefits_401a25(plan);
}

// =====================================================================
// (a)(26) Additional participation requirements for defined benefit plans
// =====================================================================

pub relation employees_benefiting_count(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the number of employees the trust benefits on each day of the plan year (the minimum over the year), after the (B) exclusions, case-asserted";
}

pub relation employees_of_employer_count(plan: DefinedBenefitPlan, y: TaxableYear, total: Integer) kind empirical {
    label en unofficial "the number of employees of the employer after the (B) exclusions, case-asserted";
}

pub relation meets_401a26A_minimum_participation(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(26)(A): the trust benefits at least the lesser of 50 employees or the greater of 40 percent of all employees and 2 employees (or the single employee)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "50 employees of the employer")
rule Meets401a26AFifty(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) strict {
    label en official "exact boundary: 50 employees always suffice";
    when employees_benefiting_count(plan, y, n) and n >= 50;
    then meets_401a26A_minimum_participation(plan, y);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "40 percent of all employees of the employer")
rule Meets401a26AFortyPercentOrTwo(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer, total: Integer) strict {
    label en official "below 50: n x 100 >= 40 x total (exact) and n >= 2, or n = total when there is a single employee";
    when employees_benefiting_count(plan, y, n)
        and employees_of_employer_count(plan, y, total)
        and n < 50
        and n * 100 >= total * 40
        and (n >= 2 or n >= total);
    then meets_401a26A_minimum_participation(plan, y);
}

pub relation separate_excludable_group_ok_401a26B(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(a)(26)(B)(ii): employees described in section 410(b)(4)(B) may be excluded where they are covered separately under the same plan on no greater benefits and no highly compensated employee is in the group for more than one year";
}

pub relation excludable_group_benefits_same_plan(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the benefits for the section 410(b)(4)(B) employees are provided under the same plan as for the others, case-asserted";
}

pub relation excludable_group_benefits_not_greater(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "their benefits are not greater than comparable benefits for other employees, case-asserted";
}

pub relation excludable_group_hce_years(plan: DefinedBenefitPlan, years: Integer) kind empirical {
    label en unofficial "the longest number of years a highly compensated employee is included in the group, case-asserted";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "no highly compensated employee (within the meaning of section 414(q)) is included in the group of such employees for more than 1 year")
rule SeparateExcludableGroupOk401a26B(plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "exact boundary: 1 year allowed, 2 years not";
    when excludable_group_benefits_same_plan(plan)
        and excludable_group_benefits_not_greater(plan)
        and excludable_group_hce_years(plan, years)
        and years <= 1;
    then separate_excludable_group_ok_401a26B(plan);
}

pub relation multiemployer_collectively_bargained_employees(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employees are covered by collective bargaining agreements under a multiemployer plan (section 414(f)), case-asserted";
}

pub relation paragraph_26_inapplicable(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(a)(26)(D)/(G): the paragraph does not apply to collectively bargained employees of a multiemployer plan (except as regulations provide) or to a governmental plan";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "this paragraph shall not apply to employees in a multiemployer plan (within the meaning of section 414(f)) who are covered by collective bargaining agreements")
rule Paragraph26InapplicableMultiemployer(plan: DefinedBenefitPlan) strict {
    label en official "(D)";
    when multiemployer_collectively_bargained_employees(plan);
    then paragraph_26_inapplicable(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to a governmental plan (within the meaning of section 414(d)).")
rule Paragraph26InapplicableGovernmental(plan: DefinedBenefitPlan) strict {
    label en official "(G)";
    when plan_is_governmental_414d(plan);
    then paragraph_26_inapplicable(plan);
}

pub relation protected_participants_amendment(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "the plan is amended to cease all benefit accruals or to provide future accruals only to a closed class of participants, adopted on this date, case-asserted (section 401(a)(26)(I)(i)(I))";
}

pub relation plan_satisfied_26A_on_amendment_effective_date(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan satisfies subparagraph (A) (without regard to (I)) as of the effective date of the amendment, case-asserted";
}

pub relation plan_described_in_401a26I_ii(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is described in clause (ii) (the section 401(o)(1)(C) class-closing rule), case-asserted";
}

pub relation deemed_to_satisfy_401a26A_protected(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 401(a)(26)(I): a frozen or closed-class plan amended before April 5, 2017 (or described in clause (ii)) that met (A) when amended is deemed to satisfy (A)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the amendment was adopted before April 5, 2017, or the plan is described in clause (ii)")
rule DeemedToSatisfy401a26AProtectedEarly(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "exact boundary: April 4, 2017 qualifies, April 5, 2017 does not";
    when protected_participants_amendment(plan, adopted_on)
        and adopted_on < @2017-04-05
        and plan_satisfied_26A_on_amendment_effective_date(plan);
    then deemed_to_satisfy_401a26A_protected(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the amendment was adopted before April 5, 2017, or the plan is described in clause (ii)")
rule DeemedToSatisfy401a26AProtectedClauseIi(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "a plan described in clause (ii) needs no early adoption";
    when protected_participants_amendment(plan, adopted_on)
        and plan_satisfied_26A_on_amendment_effective_date(plan)
        and plan_described_in_401a26I_ii(plan);
    then deemed_to_satisfy_401a26A_protected(plan);
}

// =====================================================================
// (a)(27) Profit-sharing plans
// =====================================================================

pub relation plan_designates_type_401a27B(plan: Plan) kind empirical {
    label en unofficial "a plan intended to be a money purchase pension plan or a profit-sharing plan designates that intent, at the time and in the manner the Secretary prescribes, case-asserted";
}

pub relation plan_intended_money_purchase_or_profit_sharing(plan: Plan) kind empirical {
    label en unofficial "the plan is intended to be a money purchase pension plan or a profit-sharing plan, case-asserted";
}

pub relation meets_401a27B_type_designation(plan: Plan) kind institutional {
    label en official "section 401(a)(27)(B): the plan designates its intended type";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "a trust forming part of such plan shall not constitute a qualified trust under this subsection unless the plan designates such intent")
rule Meets401a27BTypeDesignation(plan: Plan) strict {
    label en official "designation required for the two plan types";
    when plan_intended_money_purchase_or_profit_sharing(plan) and plan_designates_type_401a27B(plan);
    then meets_401a27B_type_designation(plan);
}

pub relation plan_is_profit_sharing_plan(plan: Plan) kind institutional {
    label en official "section 401(a)(27)(A): the profit-sharing character of a plan is determined without regard to current or accumulated profits and without regard to whether the employer is tax-exempt";
}

pub relation plan_labelled_profit_sharing(plan: Plan) kind empirical {
    label en unofficial "the plan is a plan under which contributions are made and distributed as a profit-sharing plan, whether or not there are profits and whether or not the employer is tax-exempt, case-asserted";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "The determination of whether the plan under which any contributions are made is a profit-sharing plan shall be made without regard to current or accumulated profits of the employer and without regard to whether the employer is a tax-exempt organization.")
rule PlanIsProfitSharingPlan(plan: Plan) strict {
    label en official "profits and exempt status are irrelevant: the classification reads only the plan's own character";
    when plan_labelled_profit_sharing(plan);
    then plan_is_profit_sharing_plan(plan);
}

// =====================================================================
// (a)(28) remainder: methods of meeting diversification, appraiser
// =====================================================================

pub relation esop_or_409a_plan(plan: Plan) kind empirical {
    label en unofficial "the trust is part of an employee stock ownership plan (section 4975(e)(7)) or a plan meeting section 409(a), case-asserted";
}

pub relation esop_distributes_covered_portion_within_90_days(plan: Plan) kind empirical {
    label en unofficial "the portion of the account covered by the election is distributed within 90 days after the election period, case-asserted (section 401(a)(28)(B)(ii)(I))";
}

pub relation esop_offers_3_options_and_invests_within_90_days(plan: Plan, options: Integer) kind empirical {
    label en unofficial "the plan offers this number of investment options to a participant making the election and invests the covered portion in accordance with the election within 90 days after the election period, case-asserted (section 401(a)(28)(B)(ii)(II))";
}

pub relation diversification_method_met_401a28B(plan: Plan) kind institutional {
    label en official "section 401(a)(28)(B)(ii): the election requirement is treated as met by distribution within 90 days or by at least 3 options with timely investment";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the portion of the participant's account covered by the election under clause (i) is distributed within 90 days after the period during which the election may be made")
rule DiversificationMethodMetByDistribution(plan: Plan) strict {
    label en official "clause (ii)(I)";
    when esop_or_409a_plan(plan) and esop_distributes_covered_portion_within_90_days(plan);
    then diversification_method_met_401a28B(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the plan offers at least 3 investment options (not inconsistent with regulations prescribed by the Secretary) to each participant making an election under clause (i)")
rule DiversificationMethodMetByOptions(plan: Plan, options: Integer) strict {
    label en official "clause (ii)(II): exact boundary 3 options";
    when esop_or_409a_plan(plan) and esop_offers_3_options_and_invests_within_90_days(plan, options) and options >= 3;
    then diversification_method_met_401a28B(plan);
}

pub relation esop_valuations_by_independent_appraiser(plan: Plan) kind empirical {
    label en unofficial "all valuations of employer securities not readily tradable on an established securities market, with respect to the plan's activities, are by an independent appraiser meeting requirements similar to the regulations under section 170(a)(1), case-asserted";
}

pub relation meets_401a28C_appraiser(plan: Plan) kind institutional {
    label en official "section 401(a)(28)(C): independent appraiser for non-tradable employer securities";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "all valuations of employer securities which are not readily tradable on an established securities market with respect to activities carried on by the plan are by an independent appraiser")
rule Meets401a28CAppraiser(plan: Plan) strict {
    label en official "independent appraiser";
    when esop_or_409a_plan(plan) and esop_valuations_by_independent_appraiser(plan);
    then meets_401a28C_appraiser(plan);
}

pub relation meets_401a28_esop_requirements(plan: Plan) kind institutional {
    label en official "section 401(a)(28)(A): an ESOP (or section 409(a) plan) needs the diversification method of (B) and the appraiser of (C)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "such trust shall not constitute a qualified trust under this section unless such plan meets the requirements of subparagraphs (B) and (C)")
rule Meets401a28EsopRequirements(plan: Plan) strict {
    label en official "(B) and (C) both";
    when diversification_method_met_401a28B(plan) and meets_401a28C_appraiser(plan);
    then meets_401a28_esop_requirements(plan);
}

// =====================================================================
// (a)(29) Benefit limitations; (a)(32) liquidity shortfall; (a)(33)
// bankruptcy amendments; (a)(34) missing participants
// =====================================================================

pub relation plan_subject_to_412_funding_401a29(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the defined benefit plan (other than a multiemployer plan or a CSEC plan) is one to which the requirements of section 412 apply, case-asserted";
}

pub relation plan_meets_section_436(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan meets the benefit limitations of section 436 for the year, case-asserted (the individual section 436 restrictions are in module 18)";
}

pub relation meets_401a29_benefit_limitations(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 401(a)(29): a defined benefit plan subject to section 412 meets section 436";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the trust of which the plan is a part shall not constitute a qualified trust under this subsection unless the plan meets the requirements of section 436")
rule Meets401a29BenefitLimitations(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "scope and section 436";
    when plan_subject_to_412_funding_401a29(plan) and plan_meets_section_436(plan, y);
    then meets_401a29_benefit_limitations(plan, y);
}

pub enum Section401a32PaymentKind {
    ExcessOverSingleLifeAnnuity;
    InsurerIrrevocableCommitment;
    OtherSpecifiedByRegulation;
}

pub relation liquidity_shortfall_underpayment_period(plan: Plan, starts: Date, ends: Date) kind empirical {
    label en unofficial "the period during which an installment under section 430(j)(3) or 433(f) is underpaid by reason of section 430(j)(4)(A) or 433(f)(5), case-asserted (section 401(a)(32)(C))";
}

pub relation payment_ceased_during_shortfall(plan: Plan, kind: Section401a32PaymentKind, on: Date) kind empirical {
    label en unofficial "the plan ceases to make a payment of this kind on this date, case-asserted";
}

pub relation nonpayment_excused_401a32(plan: Plan, kind: Section401a32PaymentKind, on: Date) kind institutional {
    label en official "section 401(a)(32): the trust is not treated as failing to be qualified merely because the plan ceases a described payment during a liquidity shortfall";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "shall not be treated as failing to constitute a qualified trust under this section merely because such plan ceases to make any payment described in subparagraph (B) during any period that such plan has a liquidity shortfall")
rule NonpaymentExcused401a32(plan: Plan, kind: Section401a32PaymentKind, on: Date, starts: Date, ends: Date) strict {
    label en official "exact boundaries: the first and last days of the shortfall period are inside it";
    when payment_ceased_during_shortfall(plan, kind, on)
        and liquidity_shortfall_underpayment_period(plan, starts, ends)
        and on >= starts and on <= ends;
    then nonpayment_excused_401a32(plan, kind, on);
}

pub relation plan_covered_by_title_IV_erisa(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is covered under section 4021 of ERISA (and is not a multiemployer or CSEC plan), case-asserted";
}

pub relation amendment_adopted_on(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "a plan amendment is adopted on this date, case-asserted";
}

pub relation employer_debtor_period(plan: DefinedBenefitPlan, starts: Date, ends: Date) kind empirical {
    label en unofficial "the employer is a debtor in a case under title 11 (or a similar law) from this date until the effective date of its plan of reorganization, case-asserted";
}

pub relation amendment_increases_liabilities_by_benefits_accrual_or_vesting(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment increases plan liabilities by reason of an increase in benefits, a change in accrual, or a change in the vesting rate, case-asserted (section 401(a)(33)(A)(i)-(iii))";
}

pub relation amendment_effective_on(plan: DefinedBenefitPlan, adopted_on: Date, effective_on: Date) kind empirical {
    label en unofficial "the effective date of the amendment, case-asserted";
}

pub relation funding_target_attainment_100_percent_after_amendment(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "the plan, were the amendment to take effect, would have a funding target attainment percentage (section 430(d)(2)) of 100 percent or more, case-asserted (section 401(a)(33)(B)(i))";
}

pub relation amendment_repeals_412d2_amendment(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment only repeals an amendment described in section 412(d)(2), case-asserted (B)(iii)";
}

pub relation amendment_required_for_qualification(plan: DefinedBenefitPlan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment is required as a condition of qualification under this part, case-asserted (B)(iv)";
}

external judgment relation amendment_reasonable_and_de_minimis(plan: DefinedBenefitPlan, adopted_on: Date) {
    authority Secretary;
    label en official "section 401(a)(33)(B)(ii): the Secretary determines that the amendment is reasonable and provides for only de minimis increases in the liabilities of the plan with respect to employees of the debtor";
}

pub relation bankruptcy_amendment_disqualifies(plan: DefinedBenefitPlan, adopted_on: Date) kind institutional {
    label en official "section 401(a)(33): an amendment adopted while the employer is a debtor, increasing liabilities, and effective before the reorganization plan takes effect, disqualifies the trust unless an exception applies";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "if an amendment to such plan is adopted while the employer is a debtor in a case under title 11, United States Code, or similar Federal or State law, if such amendment increases liabilities of the plan")
rule BankruptcyAmendmentDisqualifies(plan: DefinedBenefitPlan, adopted_on: Date, effective_on: Date, starts: Date, ends: Date) defeasible {
    label en official "adopted within the debtor period, increasing liabilities, effective before the reorganization effective date; exceptions (B)(i)-(iv) defeat it";
    when plan_covered_by_title_IV_erisa(plan)
        and amendment_adopted_on(plan, adopted_on)
        and employer_debtor_period(plan, starts, ends)
        and adopted_on >= starts and adopted_on <= ends
        and amendment_increases_liabilities_by_benefits_accrual_or_vesting(plan, adopted_on)
        and amendment_effective_on(plan, adopted_on, effective_on)
        and effective_on < ends;
    unless bankruptcy_amendment_excepted(plan, adopted_on);
    then bankruptcy_amendment_disqualifies(plan, adopted_on);
}

pub relation bankruptcy_amendment_excepted(plan: DefinedBenefitPlan, adopted_on: Date) kind institutional {
    label en official "section 401(a)(33)(B): fully funded after the amendment, a de minimis reasonable amendment, a repeal of a section 412(d)(2) amendment, or an amendment required for qualification";
}

rule BankruptcyAmendmentExceptedFunded(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "(B)(i)";
    when funding_target_attainment_100_percent_after_amendment(plan, adopted_on);
    then bankruptcy_amendment_excepted(plan, adopted_on);
}

rule BankruptcyAmendmentExceptedDeMinimis(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "(B)(ii): the Secretary's determination";
    when amendment_reasonable_and_de_minimis(plan, adopted_on);
    then bankruptcy_amendment_excepted(plan, adopted_on);
}

rule BankruptcyAmendmentExceptedRepeal(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "(B)(iii)";
    when amendment_repeals_412d2_amendment(plan, adopted_on);
    then bankruptcy_amendment_excepted(plan, adopted_on);
}

rule BankruptcyAmendmentExceptedRequired(plan: DefinedBenefitPlan, adopted_on: Date) strict {
    label en official "(B)(iv)";
    when amendment_required_for_qualification(plan, adopted_on);
    then bankruptcy_amendment_excepted(plan, adopted_on);
}

pub relation employer_of_plan_debtor(employer: Person, plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the employer referred to in section 412(b)(1) (without regard to 412(b)(2)) is the person adopting the amendment, case-asserted (section 401(a)(33)(D))";
}

pub relation adopts_disqualifying_bankruptcy_amendment(employer: Person, plan: DefinedBenefitPlan, adopted_on: Date) kind institutional {
    label en official "the employer adopts an amendment that section 401(a)(33) makes disqualifying";
}

rule AdoptsDisqualifyingBankruptcyAmendment(employer: Person, plan: DefinedBenefitPlan, adopted_on: Date) defeasible {
    label en unofficial "the action atom is the disqualifying adoption";
    when bankruptcy_amendment_disqualifies(plan, adopted_on) and employer_of_plan_debtor(employer, plan);
    then adopts_disqualifying_bankruptcy_amendment(employer, plan, adopted_on);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A trust which is part of a plan to which this paragraph applies shall not constitute a qualified trust under this section if an amendment to such plan is adopted while the employer is a debtor")
rule BankruptcyAmendmentProhibition(employer: Person, plan: DefinedBenefitPlan, adopted_on: Date) defeasible {
    label en official "the employer may not adopt such an amendment; the breach is established by the adoption itself (E-0179, no section 137 pair)";
    when adopts_disqualifying_bankruptcy_amendment(employer, plan, adopted_on);
    then prohibition BankruptcyAmendmentBar {
        bearer employer;
        action adopts_disqualifying_bankruptcy_amendment(employer, plan, adopted_on);
        window [-infinity, infinity];
    };
}

pub relation plan_covered_by_title_IV_missing_participants(plan: Plan) kind empirical {
    label en unofficial "the plan is covered by title IV of ERISA and terminates, case-asserted (section 401(a)(34))";
}

pub relation missing_participant_benefit_transferred_as_permitted(plan: Plan) kind empirical {
    label en unofficial "the plan transfers a missing participant's benefit in the manner title IV of ERISA and the PBGC provide, case-asserted";
}

pub relation missing_participant_transfer_not_disqualifying(plan: Plan) kind institutional {
    label en official "section 401(a)(34): a title IV plan's payment or transfer of missing participants' benefits on termination does not by itself disqualify the trust";
}

@source(IRC_S401_A, relation = formalizes, coverage = partial, quote = "In the case of a plan covered by title IV of the Employee Retirement Income Security Act of 1974, a trust forming part of such plan shall not be treated as failing to constitute a qualified trust under this section merely because")
rule MissingParticipantTransferNotDisqualifying(plan: Plan) strict {
    label en official "PARTIAL: the pinned sentence is longer than the anchored quotation; the permitted transfer is one case fact";
    when plan_covered_by_title_IV_missing_participants(plan) and missing_participant_benefit_transferred_as_permitted(plan);
    then missing_participant_transfer_not_disqualifying(plan);
}

// =====================================================================
// (a)(35) Diversification requirements for certain defined contribution plans
// =====================================================================

pub relation holds_publicly_traded_employer_securities(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the defined contribution plan holds publicly traded employer securities (employer securities readily tradable on an established securities market), case-asserted (section 401(a)(35)(E)(i), (G)(v))";
}

pub relation controlled_group_issued_publicly_traded_class(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "an employer corporation, or a member of its controlled group (section 1563(a) with 50 percent for 80 percent), has issued a class of publicly traded employer security, case-asserted (section 401(a)(35)(F)(i))";
}

pub relation controlled_group_no_public_securities_or_special_class(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "no employer corporation or parent corporation has issued any publicly traded employer security or any special class of stock of the kind described in (F)(ii)(II), case-asserted";
}

pub relation esop_no_kb_contributions_and_separate_plan(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the ESOP holds no contributions or earnings subject to section 401(k) or (m), and is a separate plan under section 414(l), case-asserted (section 401(a)(35)(E)(ii))";
}

pub relation one_participant_plan_401a35(plan: DefinedContributionPlan, covered: Integer, sole_owner_or_partners_only: Integer) kind empirical {
    label en unofficial "on the first day of the plan year the plan covered this number of individuals, with 1 in the second argument when they are only the owner (and spouse) of 100 percent of the sponsor or only partners (and spouses), case-asserted (section 401(a)(35)(E)(iii)-(iv))";
}

pub relation applicable_defined_contribution_plan(plan: DefinedContributionPlan) kind institutional {
    label en official "section 401(a)(35)(E): a defined contribution plan that holds publicly traded employer securities, other than a qualifying ESOP or a one-participant plan";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "The term \"applicable defined contribution plan\" means any defined contribution plan which holds any publicly traded employer securities.")
rule ApplicableDefinedContributionPlanDirect(plan: DefinedContributionPlan) defeasible {
    label en official "holding publicly traded employer securities, unless an exception applies";
    when holds_publicly_traded_employer_securities(plan);
    unless plan_excluded_from_applicable_dc_plan(plan);
    then applicable_defined_contribution_plan(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "a plan holding employer securities which are not publicly traded employer securities shall be treated as holding publicly traded employer securities if any employer corporation, or any member of a controlled group of corporations which includes such employer corporation, has issued a class of stock which is a publicly traded employer security")
rule ApplicableDefinedContributionPlanControlledGroup(plan: DefinedContributionPlan) defeasible {
    label en official "(F)(i), unless (F)(ii) or an (E) exception applies";
    when controlled_group_issued_publicly_traded_class(plan);
    unless plan_excluded_from_applicable_dc_plan(plan);
    then applicable_defined_contribution_plan(plan);
}

pub relation plan_excluded_from_applicable_dc_plan(plan: DefinedContributionPlan) kind institutional {
    label en official "section 401(a)(35)(E)(ii)-(iii), (F)(ii): a qualifying ESOP, a one-participant retirement plan, or a controlled-group plan with no public or special-class securities";
}

rule PlanExcludedEsop(plan: DefinedContributionPlan) strict {
    label en official "(E)(ii)";
    when esop_no_kb_contributions_and_separate_plan(plan);
    then plan_excluded_from_applicable_dc_plan(plan);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the term \"one-participant retirement plan\" means a retirement plan that on the first day of the plan year")
rule PlanExcludedOneParticipant(plan: DefinedContributionPlan, covered: Integer) strict {
    label en official "(E)(iii)-(iv): the plan covered one individual (with spouse) owning the whole sponsor, or only partners (with spouses)";
    when one_participant_plan_401a35(plan, covered, 1);
    then plan_excluded_from_applicable_dc_plan(plan);
}

rule PlanExcludedControlledGroupNoPublicSecurities(plan: DefinedContributionPlan) strict {
    label en official "(F)(ii)";
    when controlled_group_no_public_securities_or_special_class(plan);
    then plan_excluded_from_applicable_dc_plan(plan);
}

pub relation applicable_individual_participates(plan: DefinedContributionPlan, who: Person) kind empirical {
    label en unofficial "the person is a participant, or a beneficiary entitled to exercise a participant's rights over an account, case-asserted (section 401(a)(35)(G)(i))";
}

pub relation individual_years_of_service_411a5(who: Person, plan: DefinedContributionPlan, years: Integer) kind empirical {
    label en unofficial "the years of service within section 411(a)(5), case-asserted";
}

pub relation may_elect_divestment_employer_contributions(plan: DefinedContributionPlan, who: Person) kind institutional {
    label en official "section 401(a)(35)(C): a participant with at least 3 years of service (or a beneficiary of one or of a deceased participant) may elect to divest employer-contribution securities and reinvest";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "is a participant who has completed at least 3 years of service")
rule MayElectDivestmentEmployerContributions(plan: DefinedContributionPlan, who: Person, years: Integer) defeasible {
    label en official "exact boundary: 3 years";
    when applicable_defined_contribution_plan(plan)
        and applicable_individual_participates(plan, who)
        and individual_years_of_service_411a5(who, plan, years)
        and years >= 3;
    then may_elect_divestment_employer_contributions(plan, who);
}

pub relation plan_offers_investment_options_401a35D(plan: DefinedContributionPlan, options: Integer, diversified_distinct_risk: Integer) kind empirical {
    label en unofficial "the plan offers this number of investment options, other than employer securities, of which this many are each diversified and have materially different risk and return characteristics, case-asserted";
}

pub relation plan_imposes_extra_restrictions_on_employer_securities(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the plan imposes restrictions or conditions on the investment of employer securities that are not imposed on other assets (other than by reason of securities laws), case-asserted";
}

pub relation plan_limits_divestment_windows_less_than_quarterly(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the plan limits divestment and reinvestment to opportunities less frequent than quarterly, case-asserted";
}

pub relation meets_401a35D_options(plan: DefinedContributionPlan) kind institutional {
    label en official "section 401(a)(35)(D): at least 3 diversified options with materially different risk and return, quarterly-or-better windows, and no extra restrictions on employer securities";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "the plan offers not less than 3 investment options, other than employer securities, to which an applicable individual may direct the proceeds from the divestment of employer securities pursuant to this paragraph, each of which is diversified and has materially different risk and return characteristics")
rule Meets401a35DOptions(plan: DefinedContributionPlan, options: Integer, diversified: Integer) strict {
    label en official "exact boundary: 3 options, all diversified and distinct; windows at least quarterly (clause (ii)(I)); no extra restrictions (clause (ii)(II))";
    when plan_offers_investment_options_401a35D(plan, options, diversified)
        and options >= 3
        and diversified >= options
        and not_known(plan_imposes_extra_restrictions_on_employer_securities(plan))
        and not_known(plan_limits_divestment_windows_less_than_quarterly(plan));
    then meets_401a35D_options(plan);
}

pub relation may_elect_divestment_employee_contributions(plan: DefinedContributionPlan, who: Person) kind empirical {
    label en unofficial "an applicable individual may elect to divest employee-contribution and elective-deferral securities and reinvest in the (D) options, case-asserted (section 401(a)(35)(B))";
}

pub relation meets_401a35_diversification(plan: DefinedContributionPlan, who: Person) kind institutional {
    label en official "section 401(a)(35)(A): an applicable defined contribution plan meets (B), (C) and (D) for the applicable individual";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A trust which is part of an applicable defined contribution plan shall not be treated as a qualified trust unless the plan meets the diversification requirements of subparagraphs (B), (C), and (D).")
rule Meets401a35Diversification(plan: DefinedContributionPlan, who: Person) defeasible {
    label en official "all three subparagraphs for a participant whose plan is an applicable defined contribution plan";
    when applicable_defined_contribution_plan(plan)
        and may_elect_divestment_employee_contributions(plan, who)
        and may_elect_divestment_employer_contributions(plan, who)
        and meets_401a35D_options(plan);
    then meets_401a35_diversification(plan, who);
}

pub relation phase_in_plan_year_ordinal(plan: DefinedContributionPlan, ordinal: Integer) kind empirical {
    label en unofficial "the ordinal of the plan year within the (H)(i) phase-in (1st, 2d, 3d and following), case-asserted";
}

pub relation employer_securities_acquired_before_2007(plan: DefinedContributionPlan) kind empirical {
    label en unofficial "the securities were acquired in a plan year beginning before January 1, 2007, case-asserted (section 401(a)(35)(H)(i)(I))";
}

pub relation participant_age55_with_3_years_before_2006_plan_year(plan: DefinedContributionPlan, who: Person) kind empirical {
    label en unofficial "the participant attained age 55 and completed at least 3 years of service before the first plan year beginning after December 31, 2005, case-asserted (section 401(a)(35)(H)(i)(II))";
}

pub relation applicable_percentage_401a35H(plan: DefinedContributionPlan, pct: Decimal) kind institutional {
    label en official "section 401(a)(35)(H)(ii) table: 33 percent in the 1st plan year, 66 in the 2d, 100 from the 3d";
}

@source(IRC_S401_TABLE_1, relation = formalizes, coverage = exact)
rule ApplicablePercentageFirstYear(plan: DefinedContributionPlan) strict {
    label en official "1st year: 33";
    when phase_in_plan_year_ordinal(plan, 1);
    then applicable_percentage_401a35H(plan, 33.0);
}

@source(IRC_S401_TABLE_1, relation = formalizes, coverage = exact)
rule ApplicablePercentageSecondYear(plan: DefinedContributionPlan) strict {
    label en official "2d year: 66";
    when phase_in_plan_year_ordinal(plan, 2);
    then applicable_percentage_401a35H(plan, 66.0);
}

@source(IRC_S401_TABLE_1, relation = formalizes, coverage = exact)
rule ApplicablePercentageThirdYearOn(plan: DefinedContributionPlan, n: Integer) strict {
    label en official "3d and following years: 100";
    when phase_in_plan_year_ordinal(plan, n) and n >= 3;
    then applicable_percentage_401a35H(plan, 100.0);
}

// =====================================================================
// (a)(36) Working retirement; (a)(37) USERRA; (a)(38) lifetime income
// =====================================================================

pub relation distribution_to_employee_not_separated(plan: Plan, d: Distribution, employee: Individual) kind empirical {
    label en unofficial "a distribution from a pension plan trust to an employee who is not separated from employment, case-asserted";
}

pub relation employee_age_at_distribution(employee: Individual, d: Distribution, age: Decimal) kind empirical {
    label en unofficial "the employee's age at the distribution, in years with any fraction (59.5 = age 59 and 6 months), case-asserted";
}

pub relation building_trades_multiemployer_plan_401a36B(plan: Plan) kind empirical {
    label en unofficial "the plan is a multiemployer plan described in section 4203(b)(1)(B)(i) of ERISA, the trust existed before January 1, 1970, and before December 31, 2011 the plan received a written IRS determination while permitting distributions from age 55, case-asserted (section 401(a)(36)(B)(i)-(ii))";
}

pub relation participant_in_plan_on_or_before_2013_04_30(plan: Plan, employee: Individual) kind empirical {
    label en unofficial "the individual was a participant in the plan on or before April 30, 2013, case-asserted";
}

pub relation working_retirement_distribution_permitted(plan: Plan, d: Distribution, employee: Individual) kind institutional {
    label en official "section 401(a)(36): a pension plan may pay a distribution to an employee aged 59 1/2 (55 in the building and construction case) who is not separated from employment without losing qualification";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "to an employee who has attained age 59½ and who is not separated from employment at the time of such distribution")
rule WorkingRetirementDistributionPermitted(plan: Plan, d: Distribution, employee: Individual, age: Decimal) strict {
    label en official "exact boundary: age 59.5 is enough";
    when distribution_to_employee_not_separated(plan, d, employee)
        and employee_age_at_distribution(employee, d, age)
        and age >= 59.5;
    then working_retirement_distribution_permitted(plan, d, employee);
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall be applied by substituting \"age 55\" for \"age 59½\" in the case of a multiemployer plan described in section 4203(b)(1)(B)(i) of the Employee Retirement Income Security Act of 1974")
rule WorkingRetirementDistributionPermittedBuilding(plan: Plan, d: Distribution, employee: Individual, age: Decimal) strict {
    label en official "exact boundary: age 55 for the qualifying multiemployer building trades plan and participants on or before April 30, 2013";
    when distribution_to_employee_not_separated(plan, d, employee)
        and employee_age_at_distribution(employee, d, age)
        and building_trades_multiemployer_plan_401a36B(plan)
        and participant_in_plan_on_or_before_2013_04_30(plan, employee)
        and age >= 55.0;
    then working_retirement_distribution_permitted(plan, d, employee);
}

pub relation plan_provides_military_death_survivor_benefits(plan: Plan) kind empirical {
    label en unofficial "the plan provides that survivors of a participant who dies while performing qualified military service (section 414(u)) are entitled to any additional benefits (other than accruals for the military period) that would apply had he resumed and then terminated employment on account of death, case-asserted";
}

pub relation meets_401a37_userra(plan: Plan) kind institutional {
    label en official "section 401(a)(37): survivors of a participant who dies in qualified military service receive the additional benefits";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "A trust shall not constitute a qualified trust unless the plan provides that, in the case of a participant who dies while performing qualified military service")
rule Meets401a37Userra(plan: Plan) strict {
    label en official "the plan term";
    when plan_provides_military_death_survivor_benefits(plan);
    then meets_401a37_userra(plan);
}

pub relation lifetime_income_investment_no_longer_authorized_on(plan: DefinedContributionPlan, on: Date) kind empirical {
    label en unofficial "the date on which the lifetime income investment is no longer authorized to be held as an investment option under the plan, case-asserted";
}

pub relation lifetime_income_distribution_made_on(plan: DefinedContributionPlan, d: Distribution, on: Date) kind empirical {
    label en unofficial "a qualified distribution (direct trustee-to-trustee transfer) or an annuity-contract distribution of a lifetime income investment is made on this date, case-asserted";
}

pub relation lifetime_income_distribution_permitted(plan: DefinedContributionPlan, d: Distribution) kind institutional {
    label en official "section 401(a)(38): the trust is not treated as failing to be qualified solely by allowing such distributions on or after 90 days before the investment is no longer authorized";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "on or after the date that is 90 days prior to the date on which such lifetime income investment is no longer authorized to be held as an investment option under the plan")
rule LifetimeIncomeDistributionPermitted(plan: DefinedContributionPlan, d: Distribution, on: Date, ends: Date, calendar_before_1: Date) strict {
    label en official "exact boundary: on the 90th day before is allowed, one day earlier is not";
    when lifetime_income_distribution_made_on(plan, d, on)
        and lifetime_income_investment_no_longer_authorized_on(plan, ends)
        and on >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(ends, 90, us.irc.core::CalendarDay, calendar_before_1);
    then lifetime_income_distribution_permitted(plan, d);
}

pub relation plan_subject_to_411_without_e2(plan: Plan) kind empirical {
    label en unofficial "section 411 applies to the plan without regard to subsection (e)(2) of that section, case-asserted";
}

pub relation paragraphs_11_to_20_apply(plan: Plan) kind institutional {
    label en official "section 401(a) last sentence: paragraphs (11), (12), (13), (14), (15), (19) and (20) apply only to a plan to which section 411 applies without regard to subsection (e)(2)";
}

@source(IRC_S401_A, relation = formalizes, coverage = exact, quote = "shall apply only in the case of a plan to which section 411 (relating to minimum vesting standards) applies without regard to subsection (e)(2) of such section")
rule Paragraphs11To20Apply(plan: Plan) strict {
    label en official "scope condition";
    when plan_subject_to_411_without_e2(plan);
    then paragraphs_11_to_20_apply(plan);
}
