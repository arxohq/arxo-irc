// Section 404 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 06 carries the (a)(3) 25 percent limit, the (a)(1) minimum funding
// deduction and the (h) SEP limit. This module adds (o) the defined benefit
// deduction limit (funding target, target normal cost, cushion), (a)(1)(D)
// the multiemployer floor, (a)(1)(E) and (a)(7)(B) carryovers, (a)(6) the
// timing of payment, (a)(7) the combined limit and its exceptions, (a)(9) the
// ESOP loan rules, (h)(2), (j)(1), (l) and (m), (n), and (k) the dividend
// deduction.
//
// Method: amounts are exact Money arithmetic; percentages are fractions;
// dates are exact calendar comparisons. The compensation limit of (l) is
// pinned at its statutory base ($200,000); its indexing is a SOURCE_GAP.

// =====================================================================
// (o) Deduction limit of a single-employer defined benefit plan
// =====================================================================

use self::{
    DefinedBenefitPlan,
    Distribution,
    IRC_S404_A,
    IRC_S404_H,
    IRC_S404_J,
    IRC_S404_K,
    IRC_S404_L,
    IRC_S404_M,
    IRC_S404_N,
    IRC_S404_O,
    Person,
    Plan,
    TaxableYear,
    plan_sponsor,
};

pub relation funding_target_404o(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the funding target for the plan year (section 430(d)), determined as section 404(o)(2)(B) directs when section 430(i) does not apply, case-asserted";
}

pub relation target_normal_cost_404o(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the target normal cost for the plan year, case-asserted (section 404(o)(2)(A)(i)(II))";
}

pub relation funding_target_increase_for_expected_growth_404o(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount by which the funding target would increase if the plan took into account expected increases in compensation or benefits in succeeding plan years, case-asserted (section 404(o)(3)(A)(ii))";
}

pub relation plan_assets_404o(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value, determined under section 430(g)(3), of the plan's assets held as of the valuation date, case-asserted ((o)(2)(A)(ii))";
}

pub relation cushion_amount_404o3(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(3)(A): 50 percent of the funding target plus the increase for expected growth";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "50 percent of the funding target for the plan year")
rule CushionAmount404o3(plan: DefinedBenefitPlan, y: TaxableYear, target: Money, growth: Money) strict {
    label en official "0.5 x funding target + growth increase, exact";
    when funding_target_404o(plan, y, target) and funding_target_increase_for_expected_growth_404o(plan, y, growth);
    then cushion_amount_404o3(plan, y, target * 0.5 + growth);
}

pub relation section404o2_amount(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(2)(A): the excess of funding target plus target normal cost plus cushion over the plan's assets";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "The amount determined under this paragraph for any plan year shall be equal to the excess (if any) of")
rule Section404o2Amount(plan: DefinedBenefitPlan, y: TaxableYear, target: Money, cost: Money, cushion: Money, assets: Money) strict {
    label en official "max(FT + TNC + cushion - assets, 0)";
    when funding_target_404o(plan, y, target)
        and target_normal_cost_404o(plan, y, cost)
        and cushion_amount_404o3(plan, y, cushion)
        and plan_assets_404o(plan, y, assets);
    then section404o2_amount(plan, y, max(target + cost + cushion - assets, 0.00 USD));
}

pub relation sum_of_minimum_required_contributions_404o1B(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the minimum required contributions under section 430 for the plan years ending with or within the taxable year, case-asserted ((o)(1)(B))";
}

pub relation sum_of_404o2_amounts_404o1A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the sum of the (o)(2) amounts for the plan years ending with or within the taxable year, case-asserted ((o)(1)(A))";
}

pub relation db_deduction_limit_404o1(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(1): the greater of the (o)(2) sum and the minimum required contributions";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "In the case of a defined benefit plan to which subsection (a)(1)(A) applies (other than a multiemployer plan)")
rule DbDeductionLimit404o1(plan: DefinedBenefitPlan, y: TaxableYear, a: Money, b: Money) strict {
    label en official "max of the two sums";
    when sum_of_404o2_amounts_404o1A(plan, y, a) and sum_of_minimum_required_contributions_404o1B(plan, y, b);
    then db_deduction_limit_404o1(plan, y, max(a, b));
}

pub relation small_plan_participants_404o4(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of plan participants for the plan year, all defined benefit plans of the employer and its controlled group counted together, case-asserted (section 404(o)(4))";
}

pub relation hce_benefit_increase_liability_404o4(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the liability attributable to benefit increases for highly compensated employees from an amendment made or effective within the last 2 years, case-asserted";
}

pub relation liability_disregarded_404o4(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(o)(4)(A): for a plan with 100 or fewer participants, the liability attributable to recent benefit increases for highly compensated employees is not taken into account in the target liability";
}

@source(IRC_S404_O, relation = formalizes, coverage = exact, quote = "in the case of a plan which has 100 or fewer participants for the plan year")
rule LiabilityDisregarded404o4(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer, amount: Money) strict {
    label en official "exact boundary: 100 participants";
    when small_plan_participants_404o4(plan, y, count) and count <= 100 and hce_benefit_increase_liability_404o4(plan, y, amount);
    then liability_disregarded_404o4(plan, y, amount);
}

// =====================================================================
// (a)(1)(D) Multiemployer floor; (a)(1)(E) carryover of excess payments
// =====================================================================

pub relation current_liability_404a1d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the current liability of the multiemployer plan determined under section 431(c)(6)(D), case-asserted (section 404(a)(1)(D)(i))";
}

pub relation plan_assets_value_404a1d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the value of the plan's assets determined under section 431(c)(2), case-asserted ((D)(ii))";
}

pub relation multiemployer_minimum_deduction_404a1d(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(1)(D): the maximum deduction of a multiemployer defined benefit plan is not less than 140 percent of current liability over the asset value";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "140 percent of the current liability of the plan determined under section 431(c)(6)(D)")
rule MultiemployerMinimumDeduction404a1d(plan: DefinedBenefitPlan, y: TaxableYear, liability: Money, assets: Money) strict {
    label en official "max(1.40 x current liability - assets, 0), exact";
    when current_liability_404a1d(plan, y, liability) and plan_assets_value_404a1d(plan, y, assets);
    then multiemployer_minimum_deduction_404a1d(plan, y, max(liability * 1.40 - assets, 0.00 USD));
}

pub relation excess_payment_carried_over_404a1e(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount paid in earlier taxable years in excess of the amount deductible, still to be deducted, case-asserted (section 404(a)(1)(E))";
}

pub relation amount_paid_this_year_404a1e(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount paid in the taxable year, case-asserted";
}

pub relation maximum_deductible_this_year_404a1e(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the maximum amount deductible for the taxable year under the limitations, case-asserted";
}

pub relation carryover_deductible_this_year_404a1e(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(1)(E): a carried-over excess is deductible in a later year to the extent of the difference between the maximum deductible amount and the amount paid";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "to the extent of the difference between the amount paid and deductible in each such succeeding year and the maximum amount deductible for such year under the foregoing limitations")
rule CarryoverDeductibleThisYear404a1e(plan: DefinedBenefitPlan, y: TaxableYear, carried: Money, paid: Money, maximum: Money) strict {
    label en official "min(carried excess, max(maximum - paid, 0))";
    when excess_payment_carried_over_404a1e(plan, y, carried)
        and amount_paid_this_year_404a1e(plan, y, paid)
        and maximum_deductible_this_year_404a1e(plan, y, maximum);
    then carryover_deductible_this_year_404a1e(plan, y, min(carried, max(maximum - paid, 0.00 USD)));
}

// =====================================================================
// (a)(6), (m)(2)(B) Timing of payment
// =====================================================================

pub relation contribution_paid_on_404a6(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date a contribution on account of the taxable year is paid, case-asserted (section 404(a)(6))";
}

pub relation return_due_date_with_extensions_404(y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the time prescribed by law for filing the return for the taxable year, including extensions, case-asserted";
}

pub relation payment_deemed_made_last_day_of_preceding_year_404a6(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404(a)(6): a payment on account of the taxable year made by the return due date (with extensions) is deemed made on the last day of that year";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "a taxpayer shall be deemed to have made a payment on the last day of the preceding taxable year if the payment is on account of such taxable year and is made not later than the time prescribed by law for filing the return for such taxable year (including extensions thereof)")
rule PaymentDeemedMadeLastDay404a6(plan: Plan, y: TaxableYear, paid: Date, due: Date) strict {
    label en official "exact boundary: the due date itself is in time";
    when contribution_paid_on_404a6(plan, y, paid) and return_due_date_with_extensions_404(y, due) and paid <= due;
    then payment_deemed_made_last_day_of_preceding_year_404a6(plan, y);
}

pub relation simple_contribution_paid_on_404m(employer: Person, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date a SIMPLE retirement account contribution on account of the taxable year is made, case-asserted (section 404(m)(2)(B))";
}

pub relation simple_contribution_treated_as_made_for_year_404m2B(employer: Person, y: TaxableYear) kind institutional {
    label en official "section 404(m)(2)(B): a SIMPLE contribution is treated as made for the taxable year if made on account of it by the return due date (with extensions)";
}

@source(IRC_S404_M, relation = formalizes, coverage = exact, quote = "contributions shall be treated as made for a taxable year if they are made on account of the taxable year and are made not later than the time prescribed by law for filing the return for the taxable year (including extensions thereof)")
rule SimpleContributionTreatedAsMade404m2B(employer: Person, y: TaxableYear, paid: Date, due: Date) strict {
    label en official "exact boundary: the due date itself is in time";
    when simple_contribution_paid_on_404m(employer, y, paid) and return_due_date_with_extensions_404(y, due) and paid <= due;
    then simple_contribution_treated_as_made_for_year_404m2B(employer, y);
}

// =====================================================================
// (a)(7) Combined limit for defined contribution and defined benefit plans
// =====================================================================

pub relation compensation_paid_to_beneficiaries_404a7(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation otherwise paid or accrued during the taxable year to the beneficiaries under the plans, case-asserted";
}

pub relation db_contributions_up_to_minimum_funding_404a7(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contributions made to the defined benefit plans, to the extent not above the employer contributions necessary to meet the section 412 minimum funding standard, case-asserted ((7)(A)(ii))";
}

pub relation combined_deduction_limit_404a7A(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(7)(A): the total deduction under plans of two or more kinds may not exceed the greater of 25 percent of compensation and the minimum-funding contributions to the defined benefit plans";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "25 percent of the compensation otherwise paid or accrued during the taxable year to the beneficiaries under such plans")
rule CombinedDeductionLimit404a7A(plan: Plan, y: TaxableYear, comp: Money, db: Money) strict {
    label en official "max(0.25 x compensation, db contributions up to the minimum funding standard), exact";
    when compensation_paid_to_beneficiaries_404a7(plan, y, comp) and db_contributions_up_to_minimum_funding_404a7(plan, y, db);
    then combined_deduction_limit_404a7A(plan, y, max(comp * 0.25, db));
}

pub relation carryover_limit_404a7B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(7)(B): a later-year carryover together with the (A) allowance may not exceed 25 percent of compensation";
}

pub relation combined_allowance_used_404a7B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount allowable under subparagraph (A) for the later taxable year, case-asserted";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "together with the amount allowable under subparagraph (A) shall not exceed 25 percent of the compensation otherwise paid or accrued during such taxable year to the beneficiaries under the plans")
rule CarryoverLimit404a7B(plan: Plan, y: TaxableYear, comp: Money, used: Money) strict {
    label en official "max(0.25 x compensation - (A) allowance, 0)";
    when compensation_paid_to_beneficiaries_404a7(plan, y, comp) and combined_allowance_used_404a7B(plan, y, used);
    then carryover_limit_404a7B(plan, y, max(comp * 0.25 - used, 0.00 USD));
}

pub relation dc_contributions_for_year_404a7c(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employer contributions to defined contribution plans for the taxable year, case-asserted ((7)(C)(iii))";
}

pub relation dc_contributions_counted_in_combined_limit_404a7c3(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(7)(C)(iii): defined contribution contributions up to 6 percent of compensation are outside the combined limit; only the excess over 6 percent is taken into account";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "this paragraph shall be applied by only taking into account such contributions to the extent of such excess")
rule DcContributionsCounted404a7c3(plan: Plan, y: TaxableYear, dc: Money, comp: Money) strict {
    label en official "max(contributions - 0.06 x compensation, 0); at or below 6 percent nothing is counted";
    when dc_contributions_for_year_404a7c(plan, y, dc) and compensation_paid_to_beneficiaries_404a7(plan, y, comp);
    then dc_contributions_counted_in_combined_limit_404a7c3(plan, y, max(dc - comp * 0.06, 0.00 USD));
}

// =====================================================================
// (a)(9) ESOP loan payments; (n) elective deferrals; (j), (l), (h)(2)
// =====================================================================

pub relation esop_compensation_404a9(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the compensation paid or accrued during the taxable year to the beneficiaries under the employee stock ownership plan, case-asserted";
}

pub relation esop_principal_repayment_404a9A(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions applied by the plan by the return due date to repay the principal of a loan to acquire qualifying employer securities, case-asserted";
}

pub relation esop_principal_deduction_limit_404a9A(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(9)(A): contributions applied to loan principal are deductible up to 25 percent of the compensation of the plan's beneficiaries";
}

@source(IRC_S404_A, relation = formalizes, coverage = partial, quote = "such contributions shall be deductible under this paragraph")
rule EsopPrincipalDeductionLimit404a9A(plan: Plan, y: TaxableYear, comp: Money, principal: Money) strict {
    label en official "PARTIAL: min(principal contributions, 0.25 x compensation); the S corporation exclusion of (c) is separate";
    when esop_compensation_404a9(plan, y, comp) and esop_principal_repayment_404a9A(plan, y, principal);
    then esop_principal_deduction_limit_404a9A(plan, y, min(principal, comp * 0.25));
}

pub relation esop_interest_repayment_404a9B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "contributions applied by the plan to repay interest on a loan to acquire qualifying employer securities, case-asserted";
}

pub relation esop_interest_deductible_404a9B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(a)(9)(B): contributions applied to loan interest are deductible without the 25 percent limit";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "such contributions shall be deductible for the taxable year with respect to which such contributions are made as determined under paragraph (6)")
rule EsopInterestDeductible404a9B(plan: Plan, y: TaxableYear, interest: Money) strict {
    label en official "the full interest amount";
    when esop_interest_repayment_404a9B(plan, y, interest);
    then esop_interest_deductible_404a9B(plan, y, interest);
}

pub relation employer_is_s_corporation_404(employer: Person) kind empirical {
    label en unofficial "the employer is an S corporation, case-asserted (section 404(a)(9)(C))";
}

pub relation esop_special_rules_apply_404a9(plan: Plan, employer: Person) kind institutional {
    label en official "section 404(a)(9): the ESOP loan deduction rules apply, but not to an S corporation";
}

@source(IRC_S404_A, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to an S corporation.")
rule EsopSpecialRulesApply404a9(plan: Plan, employer: Person) strict {
    label en official "the loan deduction rules are for a C corporation sponsor";
    when plan_sponsor(plan, employer) and not_known(employer_is_s_corporation_404(employer));
    then esop_special_rules_apply_404a9(plan, employer);
}

pub relation elective_deferrals_outside_limits_404n(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 404(n): elective deferrals are not subject to the (a)(3), (a)(7) and (a)(9) limits and are not taken into account applying them to other contributions";
}

pub relation elective_deferrals_made_404n(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "elective deferrals (section 402(g)(3)) made under the plan for the taxable year, case-asserted";
}

@source(IRC_S404_N, relation = formalizes, coverage = exact, quote = "shall not be subject to any limitation contained in paragraph (3), (7), or (9) of subsection (a)")
rule ElectiveDeferralsOutsideLimits404n(plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "elective deferrals are outside the percentage limits";
    when elective_deferrals_made_404n(plan, y, amount);
    then elective_deferrals_outside_limits_404n(plan, y);
}

pub relation contributions_for_deduction_404(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the defined contribution contributions otherwise taken into account for the deduction, case-asserted";
}

pub relation excess_annual_additions_404j1B(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the annual additions in excess of the section 415 limit, case-asserted (section 404(j)(1)(B))";
}

pub relation contributions_after_415_reduction_404j1B(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(j)(1)(B): contributions taken into account are reduced by annual additions above the section 415 limit";
}

@source(IRC_S404_J, relation = formalizes, coverage = exact, quote = "the amount of any contributions otherwise taken into account shall be reduced by any annual additions in excess of the limitation under section 415 for such year")
rule ContributionsAfter415Reduction404j1B(plan: Plan, y: TaxableYear, contributions: Money, excess: Money) strict {
    label en official "max(contributions - excess additions, 0)";
    when contributions_for_deduction_404(plan, y, contributions) and excess_annual_additions_404j1B(plan, y, excess);
    then contributions_after_415_reduction_404j1B(plan, y, max(contributions - excess, 0.00 USD));
}

pub relation employee_annual_compensation_404l(plan: Plan, y: TaxableYear, employee: Person, amount: Money) kind empirical {
    label en unofficial "the employee's annual compensation under the plan for the year, case-asserted";
}

pub relation compensation_taken_into_account_404l(plan: Plan, y: TaxableYear, employee: Person, amount: Money) kind institutional {
    label en official "section 404(l): the annual compensation of each employee taken into account may not exceed $200,000 (the pinned base; the adjustment under section 401(a)(17)(B) is a SOURCE_GAP)";
}

@source(IRC_S404_L, relation = formalizes, coverage = partial, quote = "the amount of annual compensation of each employee taken into account under the plan for any year shall not exceed $200,000")
rule CompensationTakenIntoAccount404l(plan: Plan, y: TaxableYear, employee: Person, comp: Money) strict {
    label en official "PARTIAL: min(compensation, $200,000); the indexing is SOURCE_GAP";
    when employee_annual_compensation_404l(plan, y, employee, comp);
    then compensation_taken_into_account_404l(plan, y, employee, min(comp, 200000.00 USD));
}

pub relation sep_deduction_under_404h1_404h2(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the allowable deductions under paragraph (1) with respect to participants in the trust subject to subsection (a)(3)(A), case-asserted";
}

pub relation a3A_limit_before_sep_404h2(employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the otherwise applicable limitation of subsection (a)(3)(A), case-asserted";
}

pub relation a3A_limit_after_sep_404h2(employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 404(h)(2): the (a)(3)(A) limit is reduced by the SEP deduction allowed";
}

@source(IRC_S404_H, relation = formalizes, coverage = exact, quote = "the otherwise applicable limitations in subsection (a)(3)(A) shall be reduced by the amount of the allowable deductions under paragraph (1)")
rule A3ALimitAfterSep404h2(employer: Person, y: TaxableYear, limit: Money, sep: Money) strict {
    label en official "max(limit - SEP deduction, 0)";
    when a3A_limit_before_sep_404h2(employer, y, limit) and sep_deduction_under_404h1_404h2(employer, y, sep);
    then a3A_limit_after_sep_404h2(employer, y, max(limit - sep, 0.00 USD));
}

// =====================================================================
// (k) Dividends paid on employer securities held by an ESOP
// =====================================================================

pub relation dividend_paid_in_cash_to_participants_404k2A(dividend: Distribution) kind empirical {
    label en unofficial "the dividend is paid in cash to the participants or beneficiaries, case-asserted ((k)(2)(A)(i))";
}

pub relation dividend_paid_to_plan_and_distributed_in_cash_404k2A(dividend: Distribution) kind empirical {
    label en unofficial "the dividend is paid to the plan and distributed in cash to participants within 90 days after the plan year, case-asserted ((ii))";
}

pub relation dividend_at_election_paid_or_reinvested_404k2A(dividend: Distribution) kind empirical {
    label en unofficial "at the election of participants the dividend is payable in cash or reinvested in qualifying employer securities, case-asserted ((iii))";
}

pub relation dividend_used_for_loan_payments_404k2A(dividend: Distribution) kind empirical {
    label en unofficial "the dividend is used to make payments on a section 404(a)(9) loan, case-asserted ((iv))";
}

pub relation applicable_dividend_404k2(dividend: Distribution) kind institutional {
    label en official "section 404(k)(2)(A): a dividend paid in cash, distributed, elected, or applied to an ESOP loan under the plan provisions";
}

@source(IRC_S404_K, relation = formalizes, coverage = partial, quote = "is paid in cash to the participants in the plan or their beneficiaries")
rule ApplicableDividendCash404k2(dividend: Distribution) strict {
    label en official "PARTIAL: (i)";
    when dividend_paid_in_cash_to_participants_404k2A(dividend);
    then applicable_dividend_404k2(dividend);
}

rule ApplicableDividendPassThrough404k2(dividend: Distribution) strict {
    label en official "PARTIAL: (ii)";
    when dividend_paid_to_plan_and_distributed_in_cash_404k2A(dividend);
    then applicable_dividend_404k2(dividend);
}

rule ApplicableDividendElection404k2(dividend: Distribution) strict {
    label en official "PARTIAL: (iii)";
    when dividend_at_election_paid_or_reinvested_404k2A(dividend);
    then applicable_dividend_404k2(dividend);
}

rule ApplicableDividendLoan404k2(dividend: Distribution) strict {
    label en official "PARTIAL: (iv)";
    when dividend_used_for_loan_payments_404k2A(dividend);
    then applicable_dividend_404k2(dividend);
}
