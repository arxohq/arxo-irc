// Section 402A residuals — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026): (a)(2)-(4) treatment of designated Roth
// contributions, (c)(3)-(4) rollovers, (d)(2)(C), (d)(3), (d)(4), (e)
// pension-linked emergency savings accounts, (f)(2)-(3) definitions.
//
// Pattern as in modules 05/35: each sentence is a set of case facts and a
// derived treatment relation. Dates: the section 402A(e) provisions were
// added by section 127 of Pub. L. 117-328 and apply to plan years beginning
// after December 31, 2023 (a new provision: no pre-amendment text exists to
// preserve). The dollar limit of (e)(3)(A)(i) is $2,500 with the cost-of-living
// adjustment as a case input.

// =====================================================================
// (a)(2)-(4) Treatment of employer designated Roth contributions
// =====================================================================

use self::{
    Distribution,
    ElectiveDeferralSource414u2C,
    IRC_S402A_A,
    IRC_S402A_C,
    IRC_S402A_D,
    IRC_S402A_E,
    IRC_S402A_F,
    Person,
    Plan,
    TaxableYear,
};

pub enum EmployerRothContributionKind402Aa {
    MatchingOnAccountOfEmployee;
    Nonelective;
}

pub relation employer_designated_roth_contribution_402Aa(plan: Plan, employee: Person, kind: EmployerRothContributionKind402Aa, amount: Money) kind empirical {
    label en unofficial "a designated Roth contribution made by the employer under the program on the employee's behalf, its kind (a matching contribution on account of the employee's contribution, elective deferral or qualified student loan payment, or a nonelective contribution), case-asserted";
}

pub relation roth_matching_treated_as_matching_not_excludable_402Aa2(plan: Plan, employee: Person, amount: Money) kind institutional {
    label en official "section 402A(a)(2): such a contribution is a matching contribution but is not excludable from gross income";
}

@source(IRC_S402A_A, relation = formalizes, coverage = exact, quote = "shall be treated as a matching contribution for purposes of this chapter, except that such contribution shall not be excludable from gross income")
rule RothMatchingTreatedAsMatchingNotExcludable402Aa2(plan: Plan, employee: Person, amount: Money) strict {
    label en official "matching kind";
    when employer_designated_roth_contribution_402Aa(plan, employee, MatchingOnAccountOfEmployee, amount);
    then roth_matching_treated_as_matching_not_excludable_402Aa2(plan, employee, amount);
}

pub relation roth_nonelective_nonforfeitable_not_excludable_402Aa3(plan: Plan, employee: Person, amount: Money) kind institutional {
    label en official "section 402A(a)(3): a nonelective designated Roth contribution is nonforfeitable and not excludable from gross income";
}

@source(IRC_S402A_A, relation = formalizes, coverage = exact, quote = "shall be nonforfeitable and shall not be excludable from gross income")
rule RothNonelectiveNonforfeitableNotExcludable402Aa3(plan: Plan, employee: Person, amount: Money) strict {
    label en official "nonelective kind";
    when employer_designated_roth_contribution_402Aa(plan, employee, Nonelective, amount);
    then roth_nonelective_nonforfeitable_not_excludable_402Aa3(plan, employee, amount);
}

pub relation plan_includes_qualified_roth_program_402Aa4(plan: Plan) kind empirical {
    label en unofficial "the plan (or an arrangement that is part of it) includes a qualified Roth contribution program, case-asserted";
}

pub relation program_alone_does_not_disqualify_402Aa4(plan: Plan) kind institutional {
    label en official "section 402A(a)(4): the plan is not treated as failing any requirement of the chapter solely by reason of including the program";
}

@source(IRC_S402A_A, relation = formalizes, coverage = exact, quote = "such plan (and any arrangement which is part of such plan) shall not be treated as failing to meet any requirement of this chapter solely by reason of including such program")
rule ProgramAloneDoesNotDisqualify402Aa4(plan: Plan) strict {
    label en official "qualified Roth program";
    when plan_includes_qualified_roth_program_402Aa4(plan);
    then program_alone_does_not_disqualify_402Aa4(plan);
}

// =====================================================================
// (c)(3)-(4) Rollovers
// =====================================================================

pub relation roth_rollover_not_counted_for_limit_402Ac3B(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 402A(c)(3)(B): a rollover contribution to a designated Roth account under subparagraph (A) is not taken into account for the paragraph (1) limit";
}

pub relation permitted_roth_rollover_contribution_402Ac3B(participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "the individual makes a rollover contribution of a designated Roth account distribution to another designated Roth account of the individual or to a Roth IRA, case-asserted";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "Any rollover contribution to a designated Roth account under subparagraph (A) shall not be taken into account for purposes of paragraph (1).")
rule RothRolloverNotCountedForLimit402Ac3B(participant: Person, y: TaxableYear) strict {
    label en official "permitted rollover";
    when permitted_roth_rollover_contribution_402Ac3B(participant, y);
    then roth_rollover_not_counted_for_limit_402Ac3B(participant, y);
}

pub relation taxable_roth_rollover_election_2010_402Ac4Aiii(d: Distribution, elects_out: Boolean) kind empirical {
    label en unofficial "the taxpayer elects out of the 2-year spread (true) or does not (false) for a distribution in 2010, case-asserted";
}

pub relation amount_included_for_2010_distribution_402Ac4Aiii(d: Distribution, amount: Money) kind empirical {
    label en unofficial "the amount required to be included in gross income by reason of paragraph (4) for a taxable year beginning in 2010, case-asserted";
}

pub relation spread_inclusion_2011_402Ac4Aiii(d: Distribution, amount: Money) kind institutional {
    label en official "section 402A(c)(4)(A)(iii): unless the taxpayer elects out, the 2010 inclusion is included ratably over 2011 and 2012 (each half, HALF_UP: JUDGMENT CALL for an odd cent)";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "shall be so included ratably over the 2-taxable-year period beginning with the first taxable year beginning in 2011")
rule SpreadInclusion2011402Ac4Aiii(d: Distribution, total: Money) strict {
    label en official "half of the amount in 2011 (and the same in 2012); the taxpayer has not elected out";
    when amount_included_for_2010_distribution_402Ac4Aiii(d, total)
        and taxable_roth_rollover_election_2010_402Ac4Aiii(d, false);
    then spread_inclusion_2011_402Ac4Aiii(d, round(total * 0.50, 2, "HALF_UP"));
}

pub relation election_change_made_on_402Ac4Aiii(d: Distribution, on: Date) kind empirical {
    label en unofficial "the date the taxpayer changes the election for the taxable year's distributions, case-asserted";
}

pub relation election_due_date_402Ac4Aiii(d: Distribution, due: Date) kind empirical {
    label en unofficial "the due date for the taxable year, case-asserted";
}

pub relation election_change_permitted_402Ac4Aiii(d: Distribution) kind institutional {
    label en official "section 402A(c)(4)(A) last sentence: an election may not be changed after the due date for the taxable year";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "Any election under clause (iii) for any distributions during a taxable year may not be changed after the due date for such taxable year.")
rule ElectionChangePermitted402Ac4Aiii(d: Distribution, on: Date, due: Date) strict {
    label en official "exact boundary: a change on the due date is allowed, the day after is not";
    when election_change_made_on_402Ac4Aiii(d, on)
        and election_due_date_402Ac4Aiii(d, due)
        and on <= due;
    then election_change_permitted_402Ac4Aiii(d);
}

pub relation distribution_from_non_roth_account_rolled_to_roth_402Ac4B(d: Distribution) kind empirical {
    label en unofficial "a distribution from an applicable retirement plan with a qualified Roth program, other than from a designated Roth account, is contributed in a qualified rollover contribution to the designated Roth account maintained under the plan for the distributee, case-asserted";
}

pub relation paragraph_4_applies_402Ac4B(d: Distribution) kind institutional {
    label en official "section 402A(c)(4)(B): the paragraph applies to such a distribution";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "this paragraph shall apply to a distribution from such plan other than from a designated Roth account which is contributed in a qualified rollover contribution")
rule Paragraph4Applies402Ac4B(d: Distribution) strict {
    label en official "qualifying distribution";
    when distribution_from_non_roth_account_rolled_to_roth_402Ac4B(d);
    then paragraph_4_applies_402Ac4B(d);
}

pub relation rollover_not_counted_for_limit_402Ac4C(d: Distribution) kind institutional {
    label en official "section 402A(c)(4)(C): a distribution to which the paragraph applies is not taken into account for the paragraph (1) limit";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "Any distribution to which this paragraph applies shall not be taken into account for purposes of paragraph (1).")
rule RolloverNotCountedForLimit402Ac4C(d: Distribution) strict {
    label en official "taxable rollover";
    when paragraph_4_applies_402Ac4B(d);
    then rollover_not_counted_for_limit_402Ac4C(d);
}

pub relation plan_allows_transfer_election_402Ac4Ei(plan: Plan, individual: Person) kind empirical {
    label en unofficial "the plan allows the individual to elect to transfer an amount not otherwise distributable to a designated Roth account, and the individual so elects, case-asserted";
}

pub relation in_plan_transfer_treated_as_rollover_402Ac4Eii(plan: Plan, individual: Person) kind institutional {
    label en official "section 402A(c)(4)(E)(ii)-(iii): the transfer is a distribution to which paragraph (4) applies contributed in a qualified rollover, and the plan does not violate 401(k)(2)(B)(i), 403(b)(7)(A)(ii), 403(b)(11), 457(d)(1)(A) or 5 U.S.C. 8433";
}

@source(IRC_S402A_C, relation = formalizes, coverage = exact, quote = "such transfer shall be treated as a distribution to which this paragraph applies which was contributed in a qualified rollover contribution")
rule InPlanTransferTreatedAsRollover402Ac4Eii(plan: Plan, individual: Person) strict {
    label en official "elected in-plan transfer";
    when plan_allows_transfer_election_402Ac4Ei(plan, individual);
    then in_plan_transfer_treated_as_rollover_402Ac4Eii(plan, individual);
}

pub relation rules_408Ad3_DEF_apply_402Ac4D(d: Distribution) kind institutional {
    label en official "section 402A(c)(4)(D): rules of subparagraphs (D), (E) and (F) of section 408A(d)(3) apply (external cross-reference)";
}

// =====================================================================
// (d)(2)(C), (d)(3), (d)(4)
// =====================================================================

pub enum DistributionKind402Ad2C {
    ExcessDeferral402g2;
    ExcessContribution401k8;
    IncomeOnExcess;
    Other;
}

pub relation roth_distribution_kind_402Ad2C(individual: Person, plan: Plan, kind: DistributionKind402Ad2C) kind empirical {
    label en unofficial "the kind of the distribution from the designated Roth account, case-asserted";
}

pub relation distribution_excluded_from_qualified_402Ad2C(individual: Person, plan: Plan) kind institutional {
    label en official "section 402A(d)(2)(C): a distribution of an excess deferral or excess contribution, or income on them, is not a qualified distribution";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "The term \"qualified distribution\" shall not include any distribution of any excess deferral under section 402(g)(2) or any excess contribution under section 401(k)(8)")
rule DistributionExcludedFromQualifiedExcessDeferral402Ad2C(individual: Person, plan: Plan) strict {
    label en official "excess deferral";
    when roth_distribution_kind_402Ad2C(individual, plan, ExcessDeferral402g2);
    then distribution_excluded_from_qualified_402Ad2C(individual, plan);
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "or any excess contribution under section 401(k)(8), and any income on the excess deferral or contribution")
rule DistributionExcludedFromQualifiedExcessContribution402Ad2C(individual: Person, plan: Plan) strict {
    label en official "excess contribution";
    when roth_distribution_kind_402Ad2C(individual, plan, ExcessContribution401k8);
    then distribution_excluded_from_qualified_402Ad2C(individual, plan);
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "and any income on the excess deferral or contribution")
rule DistributionExcludedFromQualifiedIncome402Ad2C(individual: Person, plan: Plan) strict {
    label en official "income on either";
    when roth_distribution_kind_402Ad2C(individual, plan, IncomeOnExcess);
    then distribution_excluded_from_qualified_402Ad2C(individual, plan);
}

pub relation roth_excess_deferral_distributed_on_402Ad3(participant: Person, y: TaxableYear, distributed_on: Date, distribution_year: TaxableYear) kind empirical {
    label en unofficial "the date a Roth excess deferral is distributed and the taxable year of the distribution, case-asserted";
}

pub relation roth_excess_deferral_deadline_402Ad3(participant: Person, y: TaxableYear, april_15: Date) kind empirical {
    label en unofficial "the first April 15 following the close of the taxable year in which the excess deferral was made, case-asserted";
}

pub relation late_roth_excess_deferral_no_basis_402Ad3A(participant: Person, y: TaxableYear) kind institutional {
    label en official "section 402A(d)(3)(A): a Roth excess deferral not distributed by the first April 15 is not investment in the contract";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "is not distributed on or before the 1st April 15 following the close of the taxable year in which such excess deferral is made")
rule LateRothExcessDeferralNoBasis402Ad3A(participant: Person, y: TaxableYear, on: Date, deadline: Date, dy: TaxableYear) strict {
    label en official "exact boundary: distributed on April 15 is timely, April 16 is late";
    when roth_excess_deferral_distributed_on_402Ad3(participant, y, on, dy)
        and roth_excess_deferral_deadline_402Ad3(participant, y, deadline)
        and on > deadline;
    then late_roth_excess_deferral_no_basis_402Ad3A(participant, y);
}

pub relation late_roth_excess_deferral_included_in_year_402Ad3B(participant: Person, y: TaxableYear, distribution_year: TaxableYear) kind institutional {
    label en official "section 402A(d)(3)(B): the late excess deferral is included in gross income for the taxable year in which it is distributed";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "be included in gross income for the taxable year in which such excess is distributed")
rule LateRothExcessDeferralIncludedInYear402Ad3B(participant: Person, y: TaxableYear, on: Date, deadline: Date, dy: TaxableYear) strict {
    label en official "year of distribution";
    when roth_excess_deferral_distributed_on_402Ad3(participant, y, on, dy)
        and roth_excess_deferral_deadline_402Ad3(participant, y, deadline)
        and on > deadline;
    then late_roth_excess_deferral_included_in_year_402Ad3B(participant, y, dy);
}

pub relation distribution_from_plan_402Ad4(individual: Person, plan: Plan, from_roth_account: Boolean, amount: Money) kind empirical {
    label en unofficial "a distribution from the plan and whether it is from the designated Roth account, case-asserted";
}

pub relation section_72_separate_pool_402Ad4(individual: Person, plan: Plan, from_roth_account: Boolean) kind institutional {
    label en official "section 402A(d)(4): section 72 is applied separately to distributions from a designated Roth account and to other distributions from the plan";
}

@source(IRC_S402A_D, relation = formalizes, coverage = exact, quote = "Section 72 shall be applied separately with respect to distributions and payments from a designated Roth account and other distributions and payments from the plan.")
rule Section72SeparatePool402Ad4(individual: Person, plan: Plan, roth: Boolean, amount: Money) strict {
    label en official "the pool is chosen by the source of the distribution";
    when distribution_from_plan_402Ad4(individual, plan, roth, amount);
    then section_72_separate_pool_402Ad4(individual, plan, roth);
}

// =====================================================================
// (e) Pension-linked emergency savings accounts
// =====================================================================

pub relation plan_year_begins_on_402Ae(plan: Plan, start: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted";
}

pub relation plesa_provisions_in_effect_402Ae(plan: Plan) kind institutional {
    label en official "section 127(g) of Pub. L. 117-328: the section 402A(e) provisions apply to plan years beginning after December 31, 2023 (an added provision: no earlier text)";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "An applicable retirement plan")
rule PlesaProvisionsInEffect402Ae(plan: Plan, start: Date) strict {
    label en official "exact boundary: a plan year beginning December 31, 2023 is outside; January 1, 2024 is inside";
    when plan_year_begins_on_402Ae(plan, start)
        and start > @2023-12-31;
    then plesa_provisions_in_effect_402Ae(plan);
}

pub relation plesa_included_by_plan_402Ae1A(plan: Plan) kind empirical {
    label en unofficial "the plan includes a pension-linked emergency savings account established under ERISA section 801, treated as a designated Roth account, case-asserted";
}

pub relation plesa_enrollment_by_offer_402Ae1Aii1(plan: Plan) kind empirical {
    label en unofficial "the plan offers to enroll an eligible participant in the account, case-asserted";
}

pub relation plesa_enrollment_automatic_402Ae1Aii2(plan: Plan) kind empirical {
    label en unofficial "the plan automatically enrolls an eligible participant under an automatic contribution arrangement described in paragraph (4), case-asserted";
}

pub relation plesa_separately_accounted_402Ae1Bi(plan: Plan) kind empirical {
    label en unofficial "the plan separately accounts for contributions to the account and their earnings, case-asserted";
}

pub relation plesa_separate_recordkeeping_402Ae1Bii(plan: Plan) kind empirical {
    label en unofficial "the plan maintains separate recordkeeping for each account, case-asserted";
}

pub relation plesa_withdrawals_allowed_402Ae1Biii(plan: Plan) kind empirical {
    label en unofficial "the plan allows withdrawals in accordance with paragraph (7), case-asserted";
}

pub relation plesa_plan_requirements_met_402Ae1(plan: Plan) kind institutional {
    label en official "section 402A(e)(1): the account is included, enrollment is by offer or automatic, and the plan separately accounts, keeps separate records and allows withdrawals";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "separately account for contributions to such account and any earnings properly allocable to the contributions")
rule PlesaPlanRequirementsMetOffer402Ae1(plan: Plan) strict {
    label en official "enrollment by offer";
    when plesa_included_by_plan_402Ae1A(plan)
        and plesa_enrollment_by_offer_402Ae1Aii1(plan)
        and plesa_separately_accounted_402Ae1Bi(plan)
        and plesa_separate_recordkeeping_402Ae1Bii(plan)
        and plesa_withdrawals_allowed_402Ae1Biii(plan);
    then plesa_plan_requirements_met_402Ae1(plan);
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "automatically enroll an eligible participant in such account pursuant to an automatic contribution arrangement described in paragraph (4)")
rule PlesaPlanRequirementsMetAutomatic402Ae1(plan: Plan) strict {
    label en official "automatic enrollment";
    when plesa_included_by_plan_402Ae1A(plan)
        and plesa_enrollment_automatic_402Ae1Aii2(plan)
        and plesa_separately_accounted_402Ae1Bi(plan)
        and plesa_separate_recordkeeping_402Ae1Bii(plan)
        and plesa_withdrawals_allowed_402Ae1Biii(plan);
    then plesa_plan_requirements_met_402Ae1(plan);
}

pub relation participant_balance_of_own_contributions_402Ae3A(participant: Person, plan: Plan, balance: Money) kind empirical {
    label en unofficial "the portion of the account balance attributable to participant contributions, case-asserted";
}

pub relation proposed_contribution_to_plesa_402Ae3A(participant: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the contribution proposed to be accepted, case-asserted";
}

pub relation sponsor_determined_limit_402Ae3Aii(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the amount determined by the plan sponsor of the account, case-asserted";
}

pub relation indexed_dollar_limit_402Ae3Ai(plan: Plan, amount: Money) kind empirical {
    label en unofficial "the $2,500 limit (as adjusted for later years by the Secretary, rounded down to a multiple of $100), case-asserted";
}

pub relation plesa_limit_402Ae3A(plan: Plan, amount: Money) kind institutional {
    label en official "section 402A(e)(3)(A): the lesser of $2,500 (indexed) and the sponsor's amount";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "the lesser of")
rule PlesaLimit402Ae3A(plan: Plan, dollar: Money, sponsor: Money) strict {
    label en official "min(indexed dollar limit, sponsor amount)";
    when indexed_dollar_limit_402Ae3Ai(plan, dollar)
        and sponsor_determined_limit_402Ae3Aii(plan, sponsor);
    then plesa_limit_402Ae3A(plan, min(dollar, sponsor));
}

pub relation plesa_contribution_accepted_amount_402Ae3A(participant: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 402A(e)(3)(A): a contribution is accepted only to the extent the balance attributable to participant contributions does not exceed the limit";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "no contribution shall be accepted to a pension-linked emergency savings account to the extent such contribution would cause the portion of the account balance attributable to participant contributions to exceed the lesser of")
rule PlesaContributionAcceptedAmount402Ae3A(participant: Person, plan: Plan, bal: Money, prop: Money, limit: Money) strict {
    label en official "min(proposed, max(0, limit - balance))";
    when participant_balance_of_own_contributions_402Ae3A(participant, plan, bal)
        and proposed_contribution_to_plesa_402Ae3A(participant, plan, prop)
        and plesa_limit_402Ae3A(plan, limit);
    then plesa_contribution_accepted_amount_402Ae3A(participant, plan, min(prop, max(0 USD, limit - bal)));
}

pub relation plesa_excess_contribution_amount_402Ae3B(participant: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 402A(e)(3)(B): the contribution to the extent it would exceed the limit";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "To the extent any contribution to the pension-linked emergency savings account of a participant for a taxable year would exceed the limitation of subparagraph (A)")
rule PlesaExcessContributionAmount402Ae3B(participant: Person, plan: Plan, bal: Money, prop: Money, limit: Money) strict {
    label en official "max(0, proposed - accepted amount)";
    when participant_balance_of_own_contributions_402Ae3A(participant, plan, bal)
        and proposed_contribution_to_plesa_402Ae3A(participant, plan, prop)
        and plesa_limit_402Ae3A(plan, limit);
    then plesa_excess_contribution_amount_402Ae3B(participant, plan, prop - min(prop, max(0 USD, limit - bal)));
}

pub relation participant_has_other_designated_roth_account_402Ae3Bi(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible participant has another designated Roth account under the defined contribution plan, case-asserted";
}

pub relation plesa_excess_treatment_402Ae3B(participant: Person, plan: Plan, treatment: Integer) kind institutional {
    label en official "section 402A(e)(3)(B): 1 = the excess may be redirected to the other designated Roth account (election or deemed election); 2 = the excess contributions are not accepted";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "in the case of an eligible participant with another designated Roth account under the defined contribution plan, the plan may provide that")
rule PlesaExcessTreatmentRedirect402Ae3B(participant: Person, plan: Plan) strict {
    label en official "clause (i)";
    when participant_has_other_designated_roth_account_402Ae3Bi(participant, plan);
    then plesa_excess_treatment_402Ae3B(participant, plan, 1);
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "in any other case, such plan shall provide that such excess contributions will not be accepted")
rule PlesaExcessTreatmentRefuse402Ae3B(participant: Person, plan: Plan) strict {
    label en official "clause (ii)";
    when participant_balance_of_own_contributions_402Ae3A(participant, plan, _)
        and plesa_limit_402Ae3A(plan, _)
        and not_known(participant_has_other_designated_roth_account_402Ae3Bi(participant, plan));
    then plesa_excess_treatment_402Ae3B(participant, plan, 2);
}

pub relation eligible_participant_contribution_rate_402Ae4A(participant: Person, plan: Plan, rate: Decimal) kind empirical {
    label en unofficial "the participant contribution rate under the automatic arrangement as a fraction of compensation (0.03 = 3 percent), case-asserted";
}

pub relation participant_affirmatively_elects_otherwise_402Ae4A(participant: Person, plan: Plan) kind empirical {
    label en unofficial "the eligible participant affirmatively elects a different rate or to opt out, case-asserted";
}

pub relation automatic_arrangement_rate_valid_402Ae4A(participant: Person, plan: Plan) kind institutional {
    label en official "section 402A(e)(4)(A): the rate is not more than 3 percent of compensation";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "at a participant contribution rate that is not more than 3 percent of the compensation of the eligible participant")
rule AutomaticArrangementRateValid402Ae4A(participant: Person, plan: Plan, rate: Decimal) strict {
    label en official "exact boundary: 3 percent is allowed, 3.01 is not";
    when eligible_participant_contribution_rate_402Ae4A(participant, plan, rate)
        and rate <= 0.03;
    then automatic_arrangement_rate_valid_402Ae4A(participant, plan);
}

pub relation automatic_contribution_in_effect_402Ae4A(participant: Person, plan: Plan) kind institutional {
    label en official "section 402A(e)(4)(A): the deemed election stands unless the participant affirmatively elects a different rate or to opt out";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "unless the eligible participant, at any time (subject to such reasonable advance notice as is required by the plan administrator), affirmatively elects to")
rule AutomaticContributionInEffect402Ae4A(participant: Person, plan: Plan) strict {
    label en official "valid rate and no affirmative election";
    when automatic_arrangement_rate_valid_402Ae4A(participant, plan)
        and not_known(participant_affirmatively_elects_otherwise_402Ae4A(participant, plan));
    then automatic_contribution_in_effect_402Ae4A(participant, plan);
}

pub relation rate_amendments_in_plan_year_402Ae4Bii(plan: Plan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of times the plan sponsor amends the rate for the plan year, each effective for a later plan year and made before it begins, case-asserted";
}

pub relation rate_amendment_frequency_ok_402Ae4Bii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 402A(e)(4)(B)(ii): the sponsor may amend the rate (before the plan year it takes effect) not more than once annually";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "may amend such rate (prior to the plan year for which such amendment would take effect) not more than once annually")
rule RateAmendmentFrequencyOk402Ae4Bii(plan: Plan, y: TaxableYear, count: Integer) strict {
    label en official "exact boundary: 1 is allowed, 2 is not";
    when rate_amendments_in_plan_year_402Ae4Bii(plan, y, count)
        and count <= 1;
    then rate_amendment_frequency_ok_402Ae4Bii(plan, y);
}

pub relation plesa_notice_furnished_on_402Ae5A(plan: Plan, participant: Person, notice: Date, first_contribution: Date) kind empirical {
    label en unofficial "the date the notice was furnished and the date of the first contribution (or rate adjustment), case-asserted";
}

pub relation plesa_notice_timing_ok_402Ae5A(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(5)(A): the notice is furnished not less than 30 days and not more than 90 days before the first contribution or rate adjustment";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "not less than 30 days and not more than 90 days prior to the date of the first contribution to the pension-linked emergency savings account")
rule PlesaNoticeTimingOk402Ae5A(plan: Plan, participant: Person, notice: Date, first: Date) strict {
    label en official "exact boundary: 30 days and 90 days before are both timely; 29 and 91 are not";
    when plesa_notice_furnished_on_402Ae5A(plan, participant, notice, first)
        and notice <= first
        and days_between(notice, first) >= 30
        and days_between(notice, first) <= 90;
    then plesa_notice_timing_ok_402Ae5A(plan, participant);
}

pub enum PlesaNoticeItem402Ae5A {
    Purpose;
    LimitsAndTaxTreatment;
    FeesAndRestrictions;
    ProceduresForElectionsAndWithdrawals;
    IntendedContribution;
    BalanceAndContributed;
    DesignatedInvestment;
    OptionsAfterTermination;
    HighlyCompensatedEffect;
}

pub relation plesa_notice_covers_402Ae5A(plan: Plan, participant: Person, item: PlesaNoticeItem402Ae5A) kind empirical {
    label en unofficial "the notice describes the item, case-asserted";
}

pub relation plesa_notice_content_complete_402Ae5A(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(5)(A)(i)-(ix): the notice describes all nine items";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "the ability of a participant who becomes a highly compensated employee")
rule PlesaNoticeContentComplete402Ae5A(plan: Plan, participant: Person) strict {
    label en official "all nine items";
    when plesa_notice_covers_402Ae5A(plan, participant, Purpose)
        and plesa_notice_covers_402Ae5A(plan, participant, LimitsAndTaxTreatment)
        and plesa_notice_covers_402Ae5A(plan, participant, FeesAndRestrictions)
        and plesa_notice_covers_402Ae5A(plan, participant, ProceduresForElectionsAndWithdrawals)
        and plesa_notice_covers_402Ae5A(plan, participant, IntendedContribution)
        and plesa_notice_covers_402Ae5A(plan, participant, BalanceAndContributed)
        and plesa_notice_covers_402Ae5A(plan, participant, DesignatedInvestment)
        and plesa_notice_covers_402Ae5A(plan, participant, OptionsAfterTermination)
        and plesa_notice_covers_402Ae5A(plan, participant, HighlyCompensatedEffect);
    then plesa_notice_content_complete_402Ae5A(plan, participant);
}

pub relation plesa_notice_accurate_and_comprehensible_402Ae5B(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the notice is sufficiently accurate and comprehensive and written in a manner calculated to be understood by the average participant, case-asserted (evaluative elements)";
}

pub relation plesa_notice_requirements_met_402Ae5(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(5): timing, content and quality of the notice";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "written in a manner calculated to be understood by the average participant")
rule PlesaNoticeRequirementsMet402Ae5(plan: Plan, participant: Person) strict {
    label en official "timing, content and quality";
    when plesa_notice_timing_ok_402Ae5A(plan, participant)
        and plesa_notice_content_complete_402Ae5A(plan, participant)
        and plesa_notice_accurate_and_comprehensible_402Ae5B(plan, participant);
    then plesa_notice_requirements_met_402Ae5(plan, participant);
}

pub relation employer_matches_elective_contributions_402Ae6A(plan: Plan) kind empirical {
    label en unofficial "the employer makes matching contributions to the defined contribution plan of which the account is part, case-asserted";
}

pub relation match_rate_on_elective_402Ae6A(plan: Plan, rate: Decimal) kind empirical {
    label en unofficial "the matching rate on an elective contribution (0.50 = 50 percent), case-asserted";
}

pub relation participant_plesa_contribution_402Ae6A(participant: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the participant's contribution to the account, case-asserted";
}

pub relation plesa_match_amount_402Ae6A(participant: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 402A(e)(6)(A): matching at the same rate as for elective contributions, on contributions to the account, not exceeding the paragraph (3)(A) maximum balance";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "the employer shall make matching contributions on behalf of an eligible participant on account of the participant's contributions to the pension-linked emergency savings account at the same rate as any other matching contribution")
rule PlesaMatchAmount402Ae6A(participant: Person, plan: Plan, rate: Decimal, contrib: Money, limit: Money) strict {
    label en official "min(round(contribution x rate), limit), HALF_UP to the cent";
    when employer_matches_elective_contributions_402Ae6A(plan)
        and match_rate_on_elective_402Ae6A(plan, rate)
        and participant_plesa_contribution_402Ae6A(participant, plan, contrib)
        and plesa_limit_402Ae3A(plan, limit);
    then plesa_match_amount_402Ae6A(participant, plan, min(round(contrib * rate, 2, "HALF_UP"), limit));
}

pub relation matching_contributions_made_for_limit_402Ae6B(plan: Plan, participant: Person, amount: Money, elective_deferrals: Money) kind empirical {
    label en unofficial "the matching contributions made under the plan and the participant's elective deferrals other than contributions to the account, case-asserted";
}

pub relation matching_attributed_first_to_other_deferrals_402Ae6B(plan: Plan, participant: Person, attributed_to_other: Money, attributed_to_plesa: Money) kind institutional {
    label en official "section 402A(e)(6)(B): for any limitation on matching contributions, matching contributions are treated first as attributable to the elective deferrals other than the account contributions";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "any matching contributions made under the plan shall be treated first as attributable to the elective deferrals of the participant other than contributions to a pension-linked emergency savings account")
rule MatchingAttributedFirstToOtherDeferrals402Ae6B(plan: Plan, participant: Person, matching: Money, other_deferrals: Money) strict {
    label en official "min(matching, other deferrals to the extent matched at 100 percent of them) goes to other deferrals; the rest to the account (the rate is the plan's; here the attribution is by amount)";
    when matching_contributions_made_for_limit_402Ae6B(plan, participant, matching, other_deferrals)
        and matching >= other_deferrals;
    then matching_attributed_first_to_other_deferrals_402Ae6B(plan, participant, other_deferrals, matching - other_deferrals);
}

pub relation plesa_withdrawals_per_month_402Ae7A(plan: Plan, participant: Person, per_month: Integer) kind empirical {
    label en unofficial "the number of withdrawals per calendar month the account allows, case-asserted";
}

pub relation plesa_withdrawal_right_ok_402Ae7A(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(7)(A): withdrawal of the balance, in whole or in part, at least once per calendar month";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "at least once per calendar month")
rule PlesaWithdrawalRightOk402Ae7A(plan: Plan, participant: Person, n: Integer) strict {
    label en official "exact boundary: 1 per month is enough, 0 is not";
    when plesa_withdrawals_per_month_402Ae7A(plan, participant, n)
        and n >= 1;
    then plesa_withdrawal_right_ok_402Ae7A(plan, participant);
}

pub relation distribution_in_accordance_with_402Ae7A(d: Distribution) kind empirical {
    label en unofficial "the distribution from the account is made in accordance with subparagraph (A), case-asserted";
}

pub relation plesa_distribution_treated_as_qualified_402Ae7B(d: Distribution) kind institutional {
    label en official "section 402A(e)(7)(B): the distribution is a qualified distribution for subsection (d) and meets sections 401(k)(2)(B)(i), 403(b)(7)(A)(i), 403(b)(11) and 457(d)(1)(A)";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "shall be treated as a qualified distribution for purposes of subsection (d)")
rule PlesaDistributionTreatedAsQualified402Ae7B(d: Distribution) strict {
    label en official "withdrawal in accordance with (A)";
    when distribution_in_accordance_with_402Ae7A(d);
    then plesa_distribution_treated_as_qualified_402Ae7B(d);
}

pub relation account_terminates_or_participant_leaves_402Ae8A(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the participant's employment terminates, or the plan sponsor terminates the account, case-asserted";
}

pub relation plan_allows_transfer_to_other_roth_account_402Ae8Ai(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the plan allows the participant to transfer the balance, in whole or in part, to another designated Roth account of the participant, case-asserted";
}

pub relation plan_makes_remainder_available_within_reasonable_time_402Ae8Aii(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the plan makes amounts not transferred available to the participant within a reasonable time, case-asserted";
}

pub relation account_termination_requirements_met_402Ae8A(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(8)(A): on termination the account allows a transfer to another designated Roth account and makes the rest available within a reasonable time";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "make such amounts available within a reasonable time to the participant")
rule AccountTerminationRequirementsMet402Ae8A(plan: Plan, participant: Person) strict {
    label en official "both clauses on termination";
    when account_terminates_or_participant_leaves_402Ae8A(plan, participant)
        and plan_allows_transfer_to_other_roth_account_402Ae8Ai(plan, participant)
        and plan_makes_remainder_available_within_reasonable_time_402Ae8Aii(plan, participant);
    then account_termination_requirements_met_402Ae8A(plan, participant);
}

pub relation transfer_into_plesa_from_other_account_402Ae8B(plan: Plan, participant: Person) kind empirical {
    label en unofficial "the participant transfers amounts from another account of the participant under a plan of the employer into the account, case-asserted";
}

pub relation transfer_into_plesa_prohibited_402Ae8B(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(8)(B): no amounts may be transferred from another account under any plan of the employer into the account";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "No amounts shall be transferred by the participant from another account of the participant under any plan of the employer into the pension-linked emergency savings account of the participant.")
rule TransferIntoPlesaProhibited402Ae8B(plan: Plan, participant: Person) strict {
    label en official "prohibited transfers";
    when transfer_into_plesa_from_other_account_402Ae8B(plan, participant);
    then transfer_into_plesa_prohibited_402Ae8B(plan, participant);
}

pub relation excess_deferrals_distribution_amount_402Ae9(participant: Person, y: TaxableYear, excess: Money, plesa_contributions: Money) kind empirical {
    label en unofficial "the excess deferrals to be distributed under section 402(g)(2)(A) and the contributions made to the account for the taxable year, case-asserted";
}

pub relation excess_deferrals_from_plesa_first_402Ae9(participant: Person, y: TaxableYear, from_plesa: Money, from_other: Money) kind institutional {
    label en official "section 402A(e)(9): excess deferrals are distributed first from the account to the extent of the year's contributions to it";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "such amounts shall be distributed first from any pension-linked emergency savings account of the participant to the extent contributions were made to such account for the taxable year")
rule ExcessDeferralsFromPlesaFirst402Ae9(participant: Person, y: TaxableYear, excess: Money, plesa: Money) strict {
    label en official "from the account: min(excess, contributions); the rest from other accounts";
    when excess_deferrals_distribution_amount_402Ae9(participant, y, excess, plesa);
    then excess_deferrals_from_plesa_first_402Ae9(participant, y, min(excess, plesa), excess - min(excess, plesa));
}

pub relation distribution_from_plesa_402Ae10(d: Distribution, on_termination_transfer: Boolean) kind empirical {
    label en unofficial "a distribution from the account, and whether it is contributed to another designated Roth account on termination under paragraph (8)(A)(i), case-asserted";
}

pub relation plesa_distribution_eligible_rollover_402Ae10(d: Distribution) kind institutional {
    label en official "section 402A(e)(10): a distribution from the account is not an eligible rollover distribution, except one contributed as provided in (8)(A)(i) on termination";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "a distribution from a pension-linked emergency savings account which is contributed as provided in paragraph (8)(A)(i) shall be treated as an eligible rollover distribution")
rule PlesaDistributionEligibleRollover402Ae10(d: Distribution) strict {
    label en official "the termination exception";
    when distribution_from_plesa_402Ae10(d, true);
    then plesa_distribution_eligible_rollover_402Ae10(d);
}

pub relation plesa_distribution_not_eligible_rollover_402Ae10A(d: Distribution) kind institutional {
    label en official "section 402A(e)(10)(A): otherwise not an eligible rollover distribution for sections 401(a)(31), 402(f) and 3405";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "a distribution from a pension-linked emergency savings account shall not be treated as an eligible rollover distribution for purposes of sections 401(a)(31), 402(f), and 3405")
rule PlesaDistributionNotEligibleRollover402Ae10A(d: Distribution) strict {
    label en official "not on a termination transfer";
    when distribution_from_plesa_402Ae10(d, false);
    then plesa_distribution_not_eligible_rollover_402Ae10A(d);
}

pub relation plan_ceases_to_offer_plesa_402Ae11(plan: Plan) kind empirical {
    label en unofficial "the plan ceases to offer pension-linked emergency savings accounts, case-asserted";
}

pub relation plesa_cessation_permitted_despite_411d6_402Ae11(plan: Plan) kind institutional {
    label en official "section 402A(e)(11): notwithstanding section 411(d)(6), a plan may cease to offer such accounts at any time";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "a plan which includes a pension-linked emergency savings account may cease to offer such accounts at any time")
rule PlesaCessationPermittedDespite411d6402Ae11(plan: Plan) strict {
    label en official "cessation";
    when plan_ceases_to_offer_plesa_402Ae11(plan);
    then plesa_cessation_permitted_despite_411d6_402Ae11(plan);
}

pub relation plan_limits_matching_frequency_only_to_prevent_manipulation_402Ae12A(plan: Plan) kind empirical {
    label en unofficial "the plan limits the frequency or amount of matching contributions solely to the extent necessary to prevent manipulation, case-asserted (an evaluative element)";
}

pub relation matching_limit_procedures_permitted_402Ae12A(plan: Plan) kind institutional {
    label en official "section 402A(e)(12)(A): reasonable anti-abuse procedures are permitted";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "may employ reasonable procedures to limit the frequency or amount of matching contributions with respect to contributions to such account")
rule MatchingLimitProceduresPermitted402Ae12A(plan: Plan) strict {
    label en official "necessary and reasonable";
    when plan_limits_matching_frequency_only_to_prevent_manipulation_402Ae12A(plan);
    then matching_limit_procedures_permitted_402Ae12A(plan);
}

pub relation participant_withdrew_from_plesa_402Ae12B(plan: Plan, participant: Person) kind empirical {
    label en unofficial "a participant withdrew contributions (including elective deferrals and employee contributions), case-asserted";
}

pub relation matching_suspension_not_required_402Ae12B(plan: Plan, participant: Person) kind institutional {
    label en official "section 402A(e)(12)(B): the plan is not required to suspend matching contributions following a participant withdrawal";
}

@source(IRC_S402A_E, relation = formalizes, coverage = exact, quote = "shall not be required to suspend matching contributions following any participant withdrawal of contributions")
rule MatchingSuspensionNotRequired402Ae12B(plan: Plan, participant: Person) strict {
    label en official "withdrawal";
    when participant_withdrew_from_plesa_402Ae12B(plan, participant);
    then matching_suspension_not_required_402Ae12B(plan, participant);
}

// =====================================================================
// (f)(2), (f)(3) definitions
// =====================================================================

pub enum ElectiveDeferralKind402Af2 {
    Section402g3A;
    Section402g3C;
    Section457bDeferral;
    Other;
}

pub relation deferral_kind_402Af2(item: Person, kind: ElectiveDeferralKind402Af2) kind empirical {
    label en unofficial "the kind of the deferral, case-asserted";
}

pub relation elective_deferral_402Af2(item: Person) kind institutional {
    label en official "section 402A(f)(2): an elective deferral described in section 402(g)(3)(A) or (C), or an elective deferral under a section 457(b) plan of an eligible employer";
}

@source(IRC_S402A_F, relation = formalizes, coverage = exact, quote = "any elective deferral described in subparagraph (A) or (C) of section 402(g)(3)")
rule ElectiveDeferral402Af2Coda(item: Person) strict {
    label en official "402(g)(3)(A)";
    when deferral_kind_402Af2(item, Section402g3A);
    then elective_deferral_402Af2(item);
}

@source(IRC_S402A_F, relation = formalizes, coverage = exact, quote = "any elective deferral described in subparagraph (A) or (C) of section 402(g)(3)")
rule ElectiveDeferral402Af2Tsa(item: Person) strict {
    label en official "402(g)(3)(C)";
    when deferral_kind_402Af2(item, Section402g3C);
    then elective_deferral_402Af2(item);
}

@source(IRC_S402A_F, relation = formalizes, coverage = exact, quote = "any elective deferral of compensation by an individual under an eligible deferred compensation plan (as defined in section 457(b)) of an eligible employer described in section 457(e)(1)(A)")
rule ElectiveDeferral402Af2457b(item: Person) strict {
    label en official "section 457(b)";
    when deferral_kind_402Af2(item, Section457bDeferral);
    then elective_deferral_402Af2(item);
}

pub enum MatchingContributionKind402Af3 {
    Section401m4A;
    Section457bMatch;
    Other;
}

pub relation matching_kind_402Af3(item: Person, kind: MatchingContributionKind402Af3) kind empirical {
    label en unofficial "the kind of the contribution, case-asserted";
}

pub relation nonforfeitable_when_received_402Af3(item: Person) kind empirical {
    label en unofficial "the contribution is nonforfeitable at the time received, case-asserted";
}

pub relation matching_contribution_402Af3(item: Person) kind institutional {
    label en official "section 402A(f)(3): a section 401(m)(4)(A) matching contribution or a matching contribution to a section 457(b) plan, only if nonforfeitable when received";
}

@source(IRC_S402A_F, relation = formalizes, coverage = exact, quote = "but only if such contribution is nonforfeitable at the time received")
rule MatchingContribution402Af3Qualified(item: Person) strict {
    label en official "401(m)(4)(A) or 457(b), nonforfeitable when received";
    when (matching_kind_402Af3(item, Section401m4A) or matching_kind_402Af3(item, Section457bMatch))
        and nonforfeitable_when_received_402Af3(item);
    then matching_contribution_402Af3(item);
}
