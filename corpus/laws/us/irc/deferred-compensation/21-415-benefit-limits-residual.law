// Section 415 — STAGE 2e residual, part 1 (IRC-09, DECISION-0379,
// 25.09.2026): (a) the disqualification consequence, (b) the defined
// benefit limitation chain — early/late retirement adjustment applicability,
// qualified participants, the collectively bargained plan rule, proration,
// the State-plan accrued-benefit floor, the compensation-prong exemptions
// of (b)(7)/(11)/(12), interest-rate limits on actuarial assumptions — and
// (d) rounding of the cost-of-living adjustment.
//
// Method. Module 13 keeps the two headline tests (`Section415bLimitExceeded`,
// `Section415cLimitExceeded`) as they were. This module builds the
// APPLICABLE limit for a participant as a chain of derived relations, one
// statutory step per relation, and concludes the FINAL exceedance
// (`db_benefit_exceeds_415b`), which is what section 401(a)(16) and the
// section 415(a)(1) disqualification read:
//   step 0  the (1)(A) dollar limit, replaced by the regulatory actuarial
//           figure when (2)(C)/(D) applies (the figure itself is a regulatory
//           computation supplied as a fact);
//   step 1  halved for a collectively bargained plan under (b)(7);
//   step 2  prorated below 10 years of participation under (b)(5)(A),
//           never below 1/10 (exact Money x Decimal, no rounding);
//   floor   the (b)(10) State-plan accrued-benefit floor.
// The compensation prong (1)(B) is prorated by years of SERVICE under
// (b)(5)(B) and is dropped for the plans of (b)(7), (b)(11), (b)(12).
// What is not computed: the actuarial equivalence itself ((2)(B)-(E) and
// regulations), the high-3 window selection ((b)(3), TECH-GAPS), the
// separate-change proration of (5)(D).

// =====================================================================
// (b)(2)(C)-(I), (b)(9) Early and late retirement; special participants
// =====================================================================

use self::{
    DefinedBenefitPlan,
    IRC_S415_A,
    IRC_S415_B,
    IRC_S415_D,
    Person,
    TaxableYear,
    annual_benefit,
    high_3_year_average_compensation,
    section415b1B_comp_limit_inapplicable,
    section415b_deemed_not_exceeded_10000_floor,
    years_of_participation_db,
};

pub relation retirement_income_benefit_start_age(plan: DefinedBenefitPlan, participant: Person, age: Decimal) kind empirical {
    label en unofficial "the age at which the retirement income benefit begins, in years with any fraction, case-asserted (section 415(b)(2)(C)/(D))";
}

pub relation actuarially_adjusted_dollar_limit(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the $160,000 limitation as reduced or increased by the regulatory actuarial-equivalence computation for the start age, case-asserted (EXTERNAL_DEPENDENCY: regulations under section 415(b)(2)(C)/(D); the interest and mortality limits of (E) constrain the inputs, see below)";
}

pub relation plan_maintained_by_state_or_subdivision(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is maintained by a State, an Indian tribal government (section 7701(a)(40)) or a political subdivision, case-asserted (section 415(b)(2)(H)(i))";
}

pub relation public_safety_or_armed_forces_service_years(plan: DefinedBenefitPlan, participant: Person, years: Decimal) kind empirical {
    label en unofficial "years of service taken into account in the benefit as a full-time police, fire or emergency medical employee of the maintaining government, or as a member of the Armed Forces, case-asserted (section 415(b)(2)(H)(ii))";
}

pub relation qualified_participant_415b2H(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 415(b)(2)(H): a participant in a State or tribal plan with at least 15 years of police, fire, emergency medical or armed forces service";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "includes at least 15 years of service of the participant")
rule QualifiedParticipant415b2H(plan: DefinedBenefitPlan, participant: Person, years: Decimal) strict {
    label en official "exact boundary: 15 years qualifies, less does not";
    when plan_maintained_by_state_or_subdivision(plan)
        and public_safety_or_armed_forces_service_years(plan, participant, years)
        and years >= 15.0;
    then qualified_participant_415b2H(plan, participant);
}

pub relation disability_or_death_benefit_from_governmental_plan(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the amount is income from a governmental plan paid because the recipient became disabled by personal injuries or sickness, or an amount paid to beneficiaries, survivors or the estate because of the employee's death, case-asserted (section 415(b)(2)(I))";
}

pub relation commercial_airline_pilot(participant: Person) kind empirical {
    label en unofficial "the participant is a commercial airline pilot, case-asserted (section 415(b)(9))";
}

pub relation faa_mandatory_separation_age(participant: Person, age: Decimal) kind empirical {
    label en unofficial "the age at which FAA regulations, as of retirement, require separation from service as a commercial airline pilot, case-asserted";
}

pub relation separated_from_service_at_age(participant: Person, age: Decimal) kind empirical {
    label en unofficial "the age at which the participant separated from service, case-asserted (section 415(b)(9)(B))";
}

pub relation early_retirement_threshold_age(plan: DefinedBenefitPlan, participant: Person, age: Decimal) kind institutional {
    label en official "section 415(b)(2)(C)/(9): the age below which the $160,000 limitation is reduced — 62, or the FAA mandatory separation age (60 to under 62) for a pilot who separated no earlier than that age";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "If the retirement income benefit under the plan begins before age 62")
rule EarlyRetirementThresholdDefault(plan: DefinedBenefitPlan, participant: Person, age0: Decimal) strict {
    label en official "62 unless the pilot rule substitutes another age";
    when retirement_income_benefit_start_age(plan, participant, age0)
        and not_known(pilot_threshold_substituted(participant));
    then early_retirement_threshold_age(plan, participant, 62.0);
}

pub relation pilot_threshold_substituted(participant: Person) kind institutional {
    label en unofficial "helper: the section 415(b)(9)(A) substitution applies to this participant";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "paragraph (2)(C) shall be applied by substituting such age for age 62")
rule PilotThresholdSubstituted(participant: Person, faa_age: Decimal, sep_age: Decimal) strict {
    label en official "FAA age within [60, 62) and separation at or after 60";
    when commercial_airline_pilot(participant)
        and faa_mandatory_separation_age(participant, faa_age)
        and separated_from_service_at_age(participant, sep_age)
        and faa_age >= 60.0 and faa_age < 62.0
        and sep_age >= 60.0;
    then pilot_threshold_substituted(participant);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "paragraph (2)(C) shall be applied by substituting such age for age 62")
rule EarlyRetirementThresholdPilot(plan: DefinedBenefitPlan, participant: Person, faa_age: Decimal) strict {
    label en official "the pilot's threshold is the FAA mandatory separation age";
    when pilot_threshold_substituted(participant)
        and faa_mandatory_separation_age(participant, faa_age)
        and retirement_income_benefit_start_age(plan, participant, _);
    then early_retirement_threshold_age(plan, participant, faa_age);
}

pub relation early_retirement_reduction_applies(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 415(b)(2)(C): the benefit begins before the threshold age and neither (G) qualified participant nor (I) disability/death benefit removes the reduction";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "by reducing the limitation of paragraph (1)(A) so that such limitation (as so reduced) equals an annual benefit")
rule EarlyRetirementReductionApplies(plan: DefinedBenefitPlan, participant: Person, start: Decimal, threshold: Decimal) strict {
    label en official "exact boundary: a start age equal to the threshold is not early";
    when retirement_income_benefit_start_age(plan, participant, start)
        and early_retirement_threshold_age(plan, participant, threshold)
        and start < threshold
        and not_known(qualified_participant_415b2H(plan, participant))
        and not_known(disability_or_death_benefit_from_governmental_plan(plan, participant));
    then early_retirement_reduction_applies(plan, participant);
}

pub relation late_retirement_increase_applies(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 415(b)(2)(D): the retirement income benefit begins after age 65";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "If the retirement income benefit under the plan begins after age 65")
rule LateRetirementIncreaseApplies(plan: DefinedBenefitPlan, participant: Person, start: Decimal) strict {
    label en official "exact boundary: age 65 is not late";
    when retirement_income_benefit_start_age(plan, participant, start) and start > 65.0;
    then late_retirement_increase_applies(plan, participant);
}

// (b)(2)(E) Limits on the interest and mortality assumptions ---------------

pub enum ActuarialAdjustmentKind415 {
    BenefitFormAdjustment;
    EarlyRetirementLimit;
    LateRetirementLimit;
}

pub relation assumed_interest_rate(plan: DefinedBenefitPlan, kind: ActuarialAdjustmentKind415, rate: Decimal) kind empirical {
    label en unofficial "the interest rate assumption used in the adjustment, as a percentage such as 5.0, case-asserted";
}

pub relation plan_specified_interest_rate(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the interest rate specified in the plan, as a percentage, case-asserted";
}

pub relation rate_giving_105_percent_of_417e3_benefit(plan: DefinedBenefitPlan, rate: Decimal) kind empirical {
    label en unofficial "the rate that provides a benefit of not more than 105 percent of the benefit under the section 417(e)(3) applicable interest rate, as a percentage (an actuarial computation supplied by the case), case-asserted (section 415(b)(2)(E)(ii)(II))";
}

pub relation benefit_form_subject_to_417e3(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the form of benefit being adjusted is subject to section 417(e)(3), case-asserted";
}

pub relation plan_of_eligible_employer_408p2C(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is maintained by an eligible employer within section 408(p)(2)(C)(i), case-asserted (section 415(b)(2)(E)(vi))";
}

pub relation mortality_table_is_417e3B_applicable(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the mortality table used is the applicable mortality table within the meaning of section 417(e)(3)(B), case-asserted";
}

pub relation interest_assumption_permitted_415b2E(plan: DefinedBenefitPlan, kind: ActuarialAdjustmentKind415) kind institutional {
    label en official "section 415(b)(2)(E): the interest rate assumption respects the statutory floor or ceiling and the mortality table is the applicable one";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the interest rate assumption shall not be less than the greater of 5 percent or the rate specified in the plan")
rule InterestAssumptionFloorEarlyOrForm(plan: DefinedBenefitPlan, rate: Decimal, plan_rate: Decimal) strict {
    label en official "clause (i): early-retirement limit adjustment, or a benefit-form adjustment for a form not subject to section 417(e)(3): rate >= max(5, plan rate)";
    when assumed_interest_rate(plan, EarlyRetirementLimit, rate)
        and plan_specified_interest_rate(plan, plan_rate)
        and rate >= max(5.0, plan_rate)
        and mortality_table_is_417e3B_applicable(plan);
    then interest_assumption_permitted_415b2E(plan, EarlyRetirementLimit);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the interest rate assumption shall not be less than the greater of 5 percent or the rate specified in the plan")
rule InterestAssumptionFloorFormNot417e3(plan: DefinedBenefitPlan, rate: Decimal, plan_rate: Decimal) strict {
    label en official "clause (i) for a benefit form NOT subject to section 417(e)(3)";
    when assumed_interest_rate(plan, BenefitFormAdjustment, rate)
        and plan_specified_interest_rate(plan, plan_rate)
        and not_known(benefit_form_subject_to_417e3(plan))
        and rate >= max(5.0, plan_rate)
        and mortality_table_is_417e3B_applicable(plan);
    then interest_assumption_permitted_415b2E(plan, BenefitFormAdjustment);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the interest rate assumption shall not be less than the greatest of")
rule InterestAssumptionFloor417e3(plan: DefinedBenefitPlan, rate: Decimal, plan_rate: Decimal, rate105: Decimal) strict {
    label en official "clause (ii): a form subject to section 417(e)(3): rate >= max(5.5, 105-percent rate, plan rate); clause (vi) drops the 105-percent rate for an eligible employer, handled by the next rule";
    when assumed_interest_rate(plan, BenefitFormAdjustment, rate)
        and benefit_form_subject_to_417e3(plan)
        and plan_specified_interest_rate(plan, plan_rate)
        and rate_giving_105_percent_of_417e3_benefit(plan, rate105)
        and not_known(plan_of_eligible_employer_408p2C(plan))
        and rate >= max(5.5, max(rate105, plan_rate))
        and mortality_table_is_417e3B_applicable(plan);
    then interest_assumption_permitted_415b2E(plan, BenefitFormAdjustment);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "clause (ii) shall be applied without regard to subclause (II) thereof")
rule InterestAssumptionFloor417e3EligibleEmployer(plan: DefinedBenefitPlan, rate: Decimal, plan_rate: Decimal) strict {
    label en official "clause (vi): an eligible employer's plan is held only to max(5.5, plan rate)";
    when assumed_interest_rate(plan, BenefitFormAdjustment, rate)
        and benefit_form_subject_to_417e3(plan)
        and plan_of_eligible_employer_408p2C(plan)
        and plan_specified_interest_rate(plan, plan_rate)
        and rate >= max(5.5, plan_rate)
        and mortality_table_is_417e3B_applicable(plan);
    then interest_assumption_permitted_415b2E(plan, BenefitFormAdjustment);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the interest rate assumption shall not be greater than the lesser of 5 percent or the rate specified in the plan")
rule InterestAssumptionCeilingLate(plan: DefinedBenefitPlan, rate: Decimal, plan_rate: Decimal) strict {
    label en official "clause (iii): the late-retirement increase uses a rate no greater than min(5, plan rate)";
    when assumed_interest_rate(plan, LateRetirementLimit, rate)
        and plan_specified_interest_rate(plan, plan_rate)
        and rate <= min(5.0, plan_rate)
        and mortality_table_is_417e3B_applicable(plan);
    then interest_assumption_permitted_415b2E(plan, LateRetirementLimit);
}

// =====================================================================
// (b)(7) Collectively bargained plans; (b)(11); (b)(12)
// =====================================================================

pub relation collectively_bargained_db_plan_year(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is maintained for the year pursuant to a collective bargaining agreement and is not a multiemployer plan, case-asserted (section 415(b)(7) chapeau and (A))";
}

pub relation plan_participant_count(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the minimum number of participants at all times during the year, case-asserted (section 415(b)(7)(B))";
}

pub relation benefits_determined_solely_by_service_age_dates(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "benefits are determined solely by reference to length of service, the years during which service was rendered, age at retirement, and date of retirement, case-asserted (section 415(b)(7)(C))";
}

pub relation nonforfeitable_after_four_years(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "an employee with at least 4 years of service has a nonforfeitable right to 100 percent of the accrued benefit derived from employer contributions, case-asserted (section 415(b)(7)(D))";
}

pub relation participation_condition_at_most_60_days(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "participation requires no more than 60 consecutive days of service, case-asserted (section 415(b)(7)(E))";
}

pub relation participant_comp_exceeded_all_participants_average(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the participant's compensation for any 3 years in the 10-year period preceding separation exceeded the average compensation for those years of all participants (section 415(b)(7) last paragraph, first sentence), case-asserted";
}

pub relation participant_in_other_plan_of_same_employer(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind empirical {
    label en unofficial "for the period the participant is a participant under another plan to which section 415 applies maintained by an employer maintaining this plan, case-asserted";
}

pub relation collectively_bargained_plan_conditions_met(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 415(b)(7)(A)-(E) all met for the year";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "which, at all times during such year, has at least 100 participants")
rule CollectivelyBargainedPlanConditionsMet(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) strict {
    label en official "exact boundary: 100 participants qualifies, 99 does not";
    when collectively_bargained_db_plan_year(plan, y)
        and plan_participant_count(plan, y, n)
        and n >= 100
        and benefits_determined_solely_by_service_age_dates(plan)
        and nonforfeitable_after_four_years(plan)
        and participation_condition_at_most_60_days(plan);
    then collectively_bargained_plan_conditions_met(plan, y);
}

pub relation section415b7_applies(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(7) applies to this participant: the plan conditions hold and neither exception removes the participant";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply to a participant whose compensation for any 3 years during the 10-year period immediately preceding the year in which he separates from service exceeded the average compensation for such 3 years of all participants in such plan.")
rule Section415b7Applies(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "conditions met, participant not above the plan average, not in another section 415 plan of the employer";
    when collectively_bargained_plan_conditions_met(plan, y)
        and annual_benefit(plan, participant, y, _)
        and not_known(participant_comp_exceeded_all_participants_average(plan, participant))
        and not_known(participant_in_other_plan_of_same_employer(plan, participant, y));
    then section415b7_applies(plan, participant, y);
}

pub relation highly_compensated_benefits_org_3121w(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is maintained by an organization described in section 3121(w)(3)(A) (church or church-controlled organization), case-asserted (section 415(b)(11) second sentence)";
}

pub relation participant_benefits_accrued_as_hce(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the benefits are highly compensated benefits: accrued in a year on or after the first year the employee is a highly compensated employee of the organization, case-asserted";
}

pub relation eligible_rural_electric_cooperative_plan(plan: DefinedBenefitPlan, employers: Integer, cooperatives: Integer) kind empirical {
    label en unofficial "the plan is maintained by more than 1 employer, counting employers and rural cooperatives (or national associations of them) among them, case-asserted (section 415(b)(12)(B)(i))";
}

pub relation rural_cooperative_plan_employer_elected_out(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "an employer maintaining the eligible rural cooperative plan elects not to have (12)(A) apply to its employees, case-asserted (section 415(b)(12)(B)(ii))";
}

pub relation participant_hce_in_lookback_415b12(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the participant was a highly compensated employee in the plan year of termination or of first distribution, or in any of the 5 plan years before that year, case-asserted (section 415(b)(12)(A))";
}

pub relation eligible_rural_electric_plan_85_percent(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 415(b)(12)(B)(i): more than 1 employer and at least 85 percent of them rural cooperatives or their national association";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "with respect to which at least 85 percent of the employers maintaining the plan are rural cooperatives")
rule EligibleRuralElectricPlan85Percent(plan: DefinedBenefitPlan, employers: Integer, coops: Integer) strict {
    label en official "exact boundary by cross-multiplication: coops x 100 >= employers x 85, and more than one employer";
    when eligible_rural_electric_cooperative_plan(plan, employers, coops)
        and employers > 1
        and coops * 100 >= employers * 85;
    then eligible_rural_electric_plan_85_percent(plan);
}

pub relation compensation_prong_inapplicable(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(1)(B) does not apply: collectively bargained plan (b)(7), governmental or multiemployer plan (b)(11), or rural electric cooperative plan (b)(12)";
}

rule CompensationProngInapplicableCollective(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en unofficial "(b)(7)";
    when section415b7_applies(plan, participant, y);
    then compensation_prong_inapplicable(plan, participant, y);
}

rule CompensationProngInapplicableGovernmental(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en unofficial "(b)(11) first sentence, through module 13's classification";
    when section415b1B_comp_limit_inapplicable(plan) and annual_benefit(plan, participant, y, _);
    then compensation_prong_inapplicable(plan, participant, y);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "Subparagraph (B) of paragraph (1) shall not apply to a plan maintained by an organization described in section 3121(w)(3)(A) except with respect to highly compensated benefits.")
rule CompensationProngInapplicableChurchOrg(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "(b)(11) second sentence: the church-organization plan is exempt except for highly compensated benefits";
    when highly_compensated_benefits_org_3121w(plan)
        and annual_benefit(plan, participant, y, _)
        and not_known(participant_benefits_accrued_as_hce(plan, participant));
    then compensation_prong_inapplicable(plan, participant, y);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "Subparagraph (B) of paragraph (1) shall not apply to a participant in an eligible rural electric cooperative plan, except in the case of a participant who was a highly compensated employee")
rule CompensationProngInapplicableRuralElectric(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en official "(b)(12)(A) unless the participant was an HCE in the look-back or the employer elected out";
    when eligible_rural_electric_plan_85_percent(plan)
        and annual_benefit(plan, participant, y, _)
        and not_known(participant_hce_in_lookback_415b12(plan, participant))
        and not_known(rural_cooperative_plan_employer_elected_out(plan));
    then compensation_prong_inapplicable(plan, participant, y);
}

// =====================================================================
// (b)(5) Proration; (b)(10) State-plan floor; the applicable limit chain
// =====================================================================

pub relation db_dollar_limit_step0(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(b)(1)(A)/(2)(C)-(D): the dollar limit, or the actuarially adjusted figure when the start age is early or late";
}

rule DbDollarLimitStep0Adjusted(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, adjusted: Money) strict {
    label en unofficial "(2)(C)/(D) replaced figure";
    when annual_benefit(plan, participant, y, _)
        and actuarially_adjusted_dollar_limit(plan, participant, y, adjusted)
        and early_retirement_reduction_applies(plan, participant);
    then db_dollar_limit_step0(plan, participant, y, adjusted);
}

rule DbDollarLimitStep0AdjustedLate(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, adjusted: Money) strict {
    label en unofficial "(2)(D) replaced figure";
    when annual_benefit(plan, participant, y, _)
        and actuarially_adjusted_dollar_limit(plan, participant, y, adjusted)
        and late_retirement_increase_applies(plan, participant);
    then db_dollar_limit_step0(plan, participant, y, adjusted);
}

rule DbDollarLimitStep0Base(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en unofficial "no adjustment applies: the pinned statutory base";
    when annual_benefit(plan, participant, y, _)
        and not_known(early_retirement_reduction_applies(plan, participant))
        and not_known(late_retirement_increase_applies(plan, participant));
    then db_dollar_limit_step0(plan, participant, y, SECTION415B_DOLLAR_LIMIT + 0.00 USD);
}

pub relation db_dollar_limit_step1(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(b)(7) last sentence: one-half of the (1)(A) amount for a participant of a qualifying collectively bargained plan";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "by substituting one-half the amount otherwise applicable for such year under paragraph (1)(A) for \"$160,000\"")
rule DbDollarLimitStep1Halved(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "half of step 0 when (b)(7) applies";
    when db_dollar_limit_step0(plan, participant, y, amount) and section415b7_applies(plan, participant, y);
    then db_dollar_limit_step1(plan, participant, y, amount / 2.0);
}

rule DbDollarLimitStep1Unchanged(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "step 0 unchanged when (b)(7) does not apply";
    when db_dollar_limit_step0(plan, participant, y, amount) and not_known(section415b7_applies(plan, participant, y));
    then db_dollar_limit_step1(plan, participant, y, amount);
}

pub relation db_dollar_limit_step2(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(b)(5)(A)/(C): prorated by years of participation below 10, never below one-tenth";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "the limitation referred to in paragraph (1)(A) shall be the limitation determined under such paragraph (without regard to this paragraph) multiplied by a fraction")
rule DbDollarLimitStep2Prorated(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money, years: Decimal) strict {
    label en official "max(amount x years/10, amount/10) with exact arithmetic; years is the participation years (or part thereof)";
    when db_dollar_limit_step1(plan, participant, y, amount)
        and years_of_participation_db(participant, plan, y, years)
        and years < 10.0
        and not_known(disability_or_death_benefit_from_governmental_plan(plan, participant));
    then db_dollar_limit_step2(plan, participant, y, max(amount * (years / 10.0), amount / 10.0));
}

rule DbDollarLimitStep2Full(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money, years: Decimal) strict {
    label en unofficial "10 or more years: no proration";
    when db_dollar_limit_step1(plan, participant, y, amount)
        and years_of_participation_db(participant, plan, y, years)
        and years >= 10.0;
    then db_dollar_limit_step2(plan, participant, y, amount);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "Subparagraph (C) of this paragraph and paragraph (5) shall not apply to")
rule DbDollarLimitStep2DisabilityOrDeathExempt(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "(b)(2)(I): paragraph (5) does not apply to a governmental plan's disability or death benefit, so no proration";
    when db_dollar_limit_step1(plan, participant, y, amount)
        and disability_or_death_benefit_from_governmental_plan(plan, participant);
    then db_dollar_limit_step2(plan, participant, y, amount);
}

pub relation state_plan_election_in_effect_415b10(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "each employer maintaining the plan elected before the close of the first plan year beginning after December 31, 1989 to have the subsection apply, and did not revoke, case-asserted (section 415(b)(10)(C))";
}

pub relation first_became_participant_on(participant: Person, plan: DefinedBenefitPlan, on: Date) kind empirical {
    label en unofficial "the date the participant first became a participant in the plan, case-asserted (section 415(b)(10)(B))";
}

pub relation accrued_benefit_ignoring_post_1987_amendments(plan: DefinedBenefitPlan, participant: Person, amount: Money) kind empirical {
    label en unofficial "the participant's accrued benefit under the plan determined without regard to any amendment made after October 14, 1987, case-asserted (section 415(b)(10)(A))";
}

pub relation db_limit_floor_415b10(plan: DefinedBenefitPlan, participant: Person, amount: Money) kind institutional {
    label en official "section 415(b)(10): for a State or tribal plan participant who became a participant before January 1, 1990, the limitation is not less than the pre-October-15-1987 accrued benefit";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "means a participant who first became a participant in the plan maintained by the employer before January 1, 1990")
rule DbLimitFloor415b10(plan: DefinedBenefitPlan, participant: Person, accrued: Money, first_on: Date) strict {
    label en official "exact boundary: first participation on December 31, 1989 qualifies; on January 1, 1990 does not";
    when plan_maintained_by_state_or_subdivision(plan)
        and state_plan_election_in_effect_415b10(plan)
        and first_became_participant_on(participant, plan, first_on)
        and first_on < @1990-01-01
        and accrued_benefit_ignoring_post_1987_amendments(plan, participant, accrued);
    then db_limit_floor_415b10(plan, participant, accrued);
}

pub relation db_dollar_limit_applicable(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the dollar limit applicable to the participant after adjustment, halving, proration and the State-plan floor";
}

pub relation db_limit_floor_applies(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en unofficial "helper: some section 415(b)(10) floor exists for this participant (avoids an existential negation over the amount)";
}

rule DbLimitFloorApplies(plan: DefinedBenefitPlan, participant: Person, amount: Money) strict {
    label en unofficial "derives the helper from the floor relation";
    when db_limit_floor_415b10(plan, participant, amount);
    then db_limit_floor_applies(plan, participant);
}

rule DbDollarLimitApplicableNoFloor(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "no floor: step 2";
    when db_dollar_limit_step2(plan, participant, y, amount)
        and not_known(db_limit_floor_applies(plan, participant));
    then db_dollar_limit_applicable(plan, participant, y, amount);
}

rule DbDollarLimitApplicableFloorHigher(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money, floor: Money) strict {
    label en unofficial "the floor is at least step 2: the floor applies";
    when db_dollar_limit_step2(plan, participant, y, amount)
        and db_limit_floor_415b10(plan, participant, floor)
        and floor >= amount;
    then db_dollar_limit_applicable(plan, participant, y, floor);
}

rule DbDollarLimitApplicableFloorLower(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money, floor: Money) strict {
    label en unofficial "the floor is below step 2: step 2 stands";
    when db_dollar_limit_step2(plan, participant, y, amount)
        and db_limit_floor_415b10(plan, participant, floor)
        and floor < amount;
    then db_dollar_limit_applicable(plan, participant, y, amount);
}

pub relation years_of_service_with_employer(participant: Person, plan: DefinedBenefitPlan, y: TaxableYear, years: Decimal) kind empirical {
    label en unofficial "the participant's years (or part thereof) of service with the employer, case-asserted (section 415(b)(5)(B))";
}

pub relation db_compensation_limit_applicable(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(b)(1)(B)/(5)(B)/(C): 100 percent of high-3 average compensation, prorated by years of service below 10, never below one-tenth";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "The provisions of subparagraph (A) shall apply to the limitations under paragraphs (1)(B) and (4), except that such subparagraph shall be applied with respect to years of service with an employer rather than years of participation in a plan.")
rule DbCompensationLimitProrated(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, comp: Money, years: Decimal) strict {
    label en official "comp x years/10 with a floor of comp/10 when service is under 10 years";
    when high_3_year_average_compensation(participant, y, comp)
        and years_of_service_with_employer(participant, plan, y, years)
        and years < 10.0
        and not_known(disability_or_death_benefit_from_governmental_plan(plan, participant));
    then db_compensation_limit_applicable(plan, participant, y, max(comp * (years / 10.0), comp / 10.0));
}

rule DbCompensationLimitFull(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, comp: Money, years: Decimal) strict {
    label en unofficial "10 or more years of service";
    when high_3_year_average_compensation(participant, y, comp)
        and years_of_service_with_employer(participant, plan, y, years)
        and years >= 10.0;
    then db_compensation_limit_applicable(plan, participant, y, comp);
}

rule DbCompensationLimitDisabilityOrDeathExempt(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, comp: Money) strict {
    label en unofficial "(b)(2)(I): paragraph (5) does not apply: no proration of the compensation limit";
    when high_3_year_average_compensation(participant, y, comp)
        and annual_benefit(plan, participant, y, _)
        and disability_or_death_benefit_from_governmental_plan(plan, participant);
    then db_compensation_limit_applicable(plan, participant, y, comp);
}

pub relation db_benefit_exceeds_415b(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b)(1): the annual benefit is greater than the applicable limitation (the lesser of the dollar and compensation limits, the dollar limit alone where the compensation prong is inapplicable), unless the (b)(4) $10,000 floor deems it within";
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "such annual benefit is greater than the lesser of")
rule DbBenefitExceedsWithCompProng(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefit: Money, dollar: Money, comp: Money) defeasible {
    label en official "benefit > min(applicable dollar limit, applicable compensation limit)";
    when annual_benefit(plan, participant, y, benefit)
        and db_dollar_limit_applicable(plan, participant, y, dollar)
        and db_compensation_limit_applicable(plan, participant, y, comp)
        and benefit > min(dollar, comp)
        and not_known(compensation_prong_inapplicable(plan, participant, y));
    unless section415b_deemed_not_exceeded_10000_floor(plan, participant, y);
    then db_benefit_exceeds_415b(plan, participant, y);
}

@source(IRC_S415_B, relation = formalizes, coverage = exact, quote = "such annual benefit is greater than the lesser of")
rule DbBenefitExceedsDollarOnly(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, benefit: Money, dollar: Money) defeasible {
    label en official "benefit > applicable dollar limit where the compensation prong does not apply";
    when annual_benefit(plan, participant, y, benefit)
        and db_dollar_limit_applicable(plan, participant, y, dollar)
        and benefit > dollar
        and compensation_prong_inapplicable(plan, participant, y);
    unless section415b_deemed_not_exceeded_10000_floor(plan, participant, y);
    then db_benefit_exceeds_415b(plan, participant, y);
}

// =====================================================================
// (a)(1)(A) Disqualification of the trust for a DB plan that exceeds (b)
// =====================================================================

pub relation trust_disqualified_by_415a1A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(a)(1)(A): a trust that is part of a defined benefit plan providing benefits above the (b) limitation does not constitute a qualified trust under section 401(a)";
}

@source(IRC_S415_A, relation = formalizes, coverage = exact, quote = "in the case of a defined benefit plan, the plan provides for the payment of benefits with respect to a participant which exceed the limitation of subsection (b)")
rule TrustDisqualifiedBy415a1A(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) defeasible {
    label en official "the final exceedance disqualifies";
    when db_benefit_exceeds_415b(plan, participant, y);
    then trust_disqualified_by_415a1A(plan, participant, y);
}

pub relation db_limit_satisfied_415b(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 415(b): the participant's benefit does not exceed the limitation";
}

rule DbLimitSatisfied415b(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) defeasible {
    label en unofficial "no final exceedance for a participant with a benefit fact";
    when annual_benefit(plan, participant, y, _)
        and not_known(db_benefit_exceeds_415b(plan, participant, y));
    then db_limit_satisfied_415b(plan, participant, y);
}

// =====================================================================
// (d)(4) Rounding of the cost-of-living adjustment
// =====================================================================

pub enum Section415dAmount {
    DbDollarLimit;
    DcDollarLimit;
}

pub relation section415d_unrounded_increase(kind: Section415dAmount, y: TaxableYear, base: Money, increase: Money) kind empirical {
    label en unofficial "the increase over the base amount produced by the regulatory index computation of section 415(d)(1)-(3) (index for the quarter ending September 30 of the prior year over the base-period index), case-asserted (EXTERNAL_DEPENDENCY: regulations and the CPI series are not pinned)";
}

pub relation section415d_rounded_amount(kind: Section415dAmount, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 415(d)(4): an increase that is not a multiple of $5,000 (defined benefit dollar limit) or $1,000 (defined contribution dollar limit) is rounded to the next lowest multiple";
}

@source(IRC_S415_D, relation = formalizes, coverage = exact, quote = "Any increase under subparagraph (A) of paragraph (1) which is not a multiple of $5,000 shall be rounded to the next lowest multiple of $5,000.")
rule Section415dRoundedDb(y: TaxableYear, base: Money, increase: Money) strict {
    label en official "adjusted amount = base + 5,000 x floor(increase / 5,000), exact";
    when section415d_unrounded_increase(DbDollarLimit, y, base, increase);
    then section415d_rounded_amount(DbDollarLimit, y, base + 5000.00 USD * div_round(increase, 5000.00 USD, 0, "DOWN"));
}

@source(IRC_S415_D, relation = formalizes, coverage = exact, quote = "Any increase under subparagraph (C) of paragraph (1) which is not a multiple of $1,000 shall be rounded to the next lowest multiple of $1,000.")
rule Section415dRoundedDc(y: TaxableYear, base: Money, increase: Money) strict {
    label en official "adjusted amount = base + 1,000 x floor(increase / 1,000), exact";
    when section415d_unrounded_increase(DcDollarLimit, y, base, increase);
    then section415d_rounded_amount(DcDollarLimit, y, base + 1000.00 USD * div_round(increase, 1000.00 USD, 0, "DOWN"));
}
