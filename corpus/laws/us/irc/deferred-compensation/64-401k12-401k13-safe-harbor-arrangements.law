// Section 401(k)(12) and (k)(13) — STAGE 3b (deferred-compensation, TECH_GAP
// reduction, 26.09.2026). Stage 1/2 (module 03) carried the safe harbor as a
// black-box case fact `safe_harbor_notice_and_matching_requirements_met` and
// computed the matching formulas. This module decomposes the requirements
// themselves: matching alternatives (12)(B), the nonelective contribution
// (12)(C), notice (12)(D), the other requirements (12)(E), the late-amendment
// timing (12)(F), the other-plan rule (12)(G); and the qualified automatic
// contribution arrangement (13)(A)-(F). The universal quantifier "for every
// nonhighly compensated employee" stays a case-asserted plan-wide fact (the
// aggregate-over-derived limitation, see module 03 and G64); the per-employee
// formulas are module 03's.
//
// Wiring: the module derives `adp_test_deemed_satisfied_safe_harbor` from the
// decomposed arrangement, in addition to module 03's black-box path. Module
// 03 and its interface are unchanged. SECURE 2.0 revisions (e.g., the
// qualified percentage caps and the long-term part-time rules) are date-gated
// by module 57; the pre-amendment text is not pinned (G4601).

// =====================================================================
// (12)(B) Matching contributions
// =====================================================================

use self::{
    IRC_S401_K,
    Person,
    Plan,
    TaxableYear,
    adp_test_deemed_satisfied_safe_harbor,
    plan_year_ends,
};

pub relation basic_match_made_for_all_nonhighly_compensated_401k12Bi(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer makes, for every eligible employee who is not highly compensated, matching contributions at least equal to the 100 percent / 50 percent formula of clause (i) (the per-employee computation is module 03), case-asserted";
}

pub relation hce_match_rate_greater_than_nonhce_401k12Bii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "under the arrangement the rate of matching contribution with respect to a highly compensated employee, at any rate of elective contribution, is greater than that of a nonhighly compensated employee, case-asserted";
}

pub relation match_rate_does_not_increase_with_deferral_401k12Biii1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the rate of the employer's matching contribution does not increase as the employee's rate of elective contributions increases, case-asserted";
}

pub relation aggregate_matching_at_alternative_rate_401k12Biii2(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate matching contributions at the alternative rate, case-asserted";
}

pub relation aggregate_matching_on_clause_i_percentages_401k12Biii2(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate matching contributions if matching contributions were made on the clause (i) percentages, case-asserted";
}

pub relation alternative_match_design_meets_clause_i_401k12Biii(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(B)(iii): an alternative plan design is not treated as failing clause (i) if the rate does not increase with deferrals and the aggregate matching amount is at least the clause (i) aggregate";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the aggregate amount of matching contributions at such rate of elective contribution is at least equal to the aggregate amount of matching contributions which would be made if matching contributions were made on the basis of the percentages described in clause (i)")
rule AlternativeMatchDesign401k12Biii(plan: Plan, y: TaxableYear, alt: Money, base: Money) strict {
    label en official "both subclauses; the aggregate comparison is exact (equal is enough)";
    when match_rate_does_not_increase_with_deferral_401k12Biii1(plan, y)
        and aggregate_matching_at_alternative_rate_401k12Biii2(plan, y, alt)
        and aggregate_matching_on_clause_i_percentages_401k12Biii2(plan, y, base)
        and alt >= base;
    then alternative_match_design_meets_clause_i_401k12Biii(plan, y);
}

pub relation matching_contribution_requirement_met_401k12B(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(B): clause (i) (or an alternative design under clause (iii)) is met and clause (ii) (no higher rate for highly compensated employees) is not violated";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the employer makes matching contributions on behalf of each employee who is not a highly compensated employee in an amount equal to")
rule MatchingRequirementMetBasic401k12B(plan: Plan, y: TaxableYear) strict {
    label en official "clause (i) formula met and no clause (ii) violation";
    when basic_match_made_for_all_nonhighly_compensated_401k12Bi(plan, y)
        and not_known(hce_match_rate_greater_than_nonhce_401k12Bii(plan, y));
    then matching_contribution_requirement_met_401k12B(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "an arrangement shall not be treated as failing to meet the requirements of clause (i)")
rule MatchingRequirementMetAlternative401k12B(plan: Plan, y: TaxableYear) strict {
    label en official "clause (iii) alternative design and no clause (ii) violation";
    when alternative_match_design_meets_clause_i_401k12Biii(plan, y)
        and not_known(hce_match_rate_greater_than_nonhce_401k12Bii(plan, y));
    then matching_contribution_requirement_met_401k12B(plan, y);
}

// =====================================================================
// (12)(C) Nonelective contributions
// =====================================================================

pub relation nonelective_contribution_required_regardless_of_deferral_401k12C(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer is required, without regard to whether the employee makes an elective or employee contribution, to contribute to a defined contribution plan for each eligible nonhighly compensated employee, case-asserted";
}

pub relation required_nonelective_percentage_401k12C(plan: Plan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the required nonelective contribution as a fraction of compensation (0.03 means 3 percent), case-asserted";
}

pub relation nonelective_contribution_requirement_met_401k12C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(C): a required nonelective contribution of at least 3 percent of compensation";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in an amount equal to at least 3 percent of the employee's compensation")
rule NonelectiveContributionRequirementMet401k12C(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "exact boundary: 3 percent is enough, 2.99 percent is not";
    when nonelective_contribution_required_regardless_of_deferral_401k12C(plan, y)
        and required_nonelective_percentage_401k12C(plan, y, pct)
        and pct >= 0.03;
    then nonelective_contribution_requirement_met_401k12C(plan, y);
}

// =====================================================================
// (12)(D) Notice, (12)(E) other requirements, (12)(G) other plans
// =====================================================================

pub relation written_notice_given_within_reasonable_period_401k12D(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "each eligible employee is, within a reasonable period before the year, given written notice of the employee's rights and obligations, case-asserted";
}

pub relation notice_sufficiently_accurate_and_comprehensive_401k12Di(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the notice is sufficiently accurate and comprehensive to apprise the employee of the rights and obligations, case-asserted (an evaluative element)";
}

pub relation notice_written_for_average_employee_401k12Dii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the notice is written in a manner calculated to be understood by the average eligible employee, case-asserted (an evaluative element)";
}

pub relation notice_requirement_met_401k12D(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(D): the written notice requirement";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "is sufficiently accurate and comprehensive to apprise the employee of such rights and obligations")
rule NoticeRequirementMet401k12D(plan: Plan, y: TaxableYear) strict {
    label en official "timing and both content conditions";
    when written_notice_given_within_reasonable_period_401k12D(plan, y)
        and notice_sufficiently_accurate_and_comprehensive_401k12Di(plan, y)
        and notice_written_for_average_employee_401k12Dii(plan, y);
    then notice_requirement_met_401k12D(plan, y);
}

pub relation withdrawal_and_vesting_restrictions_met_for_all_employer_contributions_401k12Ei(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of paragraph (2)(B) and (C) are met with respect to all employer contributions (including matching contributions) taken into account, case-asserted";
}

pub relation requirements_met_without_regard_to_401l_401k12Eii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of (B) or (C) are met without regard to subsection (l), and the safe harbor contributions are not taken into account for subsection (l), case-asserted";
}

pub relation other_requirements_met_401k12E(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(E): both the withdrawal/vesting restrictions and the social security integration exclusion";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "employer contributions under subparagraph (B) or (C) shall not be taken into account")
rule OtherRequirementsMet401k12E(plan: Plan, y: TaxableYear) strict {
    label en official "clauses (i) and (ii)";
    when withdrawal_and_vesting_restrictions_met_for_all_employer_contributions_401k12Ei(plan, y)
        and requirements_met_without_regard_to_401l_401k12Eii(plan, y);
    then other_requirements_met_401k12E(plan, y);
}

pub relation other_plan_meets_contribution_requirements_for_eligible_employees_401k12G(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "another plan maintained by the employer meets the contribution requirements of (B) or (C) with respect to the employees eligible under the arrangement, case-asserted";
}

pub relation contribution_requirements_met_through_other_plan_401k12G(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(G): the arrangement is treated as meeting the contribution requirements through another plan of the employer";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "if any other plan maintained by the employer meets such requirements with respect to employees eligible under the arrangement")
rule ContributionRequirementsMetThroughOtherPlan401k12G(plan: Plan, y: TaxableYear) strict {
    label en official "other plan carries the requirements";
    when other_plan_meets_contribution_requirements_for_eligible_employees_401k12G(plan, y);
    then contribution_requirements_met_through_other_plan_401k12G(plan, y);
}

// =====================================================================
// (12)(A) The alternative methods; (12)(F) late amendment
// =====================================================================

pub relation arrangement_meets_adp_alternative_401k12A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(A): the arrangement is treated as meeting (3)(A)(ii) if it meets the matching contribution and notice requirements, or the nonelective contribution requirements";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "meets the contribution requirements of subparagraph (B) and the notice requirements of subparagraph (D)")
rule ArrangementMeetsAdpAlternativeMatching401k12A(plan: Plan, y: TaxableYear) strict {
    label en official "clause (i): matching (through the plan or another plan), other requirements and notice";
    when matching_contribution_requirement_met_401k12B(plan, y)
        and other_requirements_met_401k12E(plan, y)
        and notice_requirement_met_401k12D(plan, y);
    then arrangement_meets_adp_alternative_401k12A(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "meets the contribution requirements of subparagraph (C)")
rule ArrangementMeetsAdpAlternativeNonelective401k12A(plan: Plan, y: TaxableYear) strict {
    label en official "clause (ii): nonelective contribution and the other requirements; notice is not required by clause (ii)";
    when nonelective_contribution_requirement_met_401k12C(plan, y)
        and other_requirements_met_401k12E(plan, y);
    then arrangement_meets_adp_alternative_401k12A(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = partial, quote = "An arrangement shall be treated as meeting the contribution requirements under subparagraph (B) or (C)")
rule ArrangementMeetsAdpAlternativeViaOtherPlan401k12G(plan: Plan, y: TaxableYear) strict {
    label en official "PARTIAL: the other plan carries the contribution requirements; the notice requirement remains an arrangement fact";
    when contribution_requirements_met_through_other_plan_401k12G(plan, y)
        and other_requirements_met_401k12E(plan, y)
        and notice_requirement_met_401k12D(plan, y);
    then arrangement_meets_adp_alternative_401k12A(plan, y);
}

pub relation plan_amendment_adopted_on_401k12F(plan: Plan, y: TaxableYear, adopted: Date) kind empirical {
    label en unofficial "the date the plan was amended after the beginning of the plan year to apply the nonelective contribution requirements (subparagraph (C)) for the plan year, case-asserted";
}

pub relation plan_provided_matching_requirement_during_year_401k12Fii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan provided at any time during the plan year that the requirements of (B) or paragraph (13)(D)(i)(I) applied, case-asserted";
}

pub relation late_nonelective_amendment_permitted_401k12F(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(12)(F): a plan may be amended after the beginning of the plan year to apply the nonelective requirements, if adopted before the 30th day before the close of the year, or (with a 4 percent contribution) before the last day for distributing excess contributions; not if the plan provided for matching contributions";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "at any time before the 30th day before the close of the plan year")
rule LateNonelectiveAmendmentBeforeDay30401k12F(plan: Plan, y: TaxableYear, adopted: Date, end: Date) strict {
    label en official "exact boundary: adopted + 30 days must be before the close (the 30th day before close itself is too late)";
    when plan_amendment_adopted_on_401k12F(plan, y, adopted)
        and plan_year_ends(plan, y, end)
        and add_calendar_period(adopted, 30 calendar_day) < end
        and not_known(plan_provided_matching_requirement_during_year_401k12Fii(plan, y));
    then late_nonelective_amendment_permitted_401k12F(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "at any time before the last day under paragraph (8)(A) for distributing excess contributions for the plan year")
rule LateNonelectiveAmendmentBeforeDistributionDeadline401k12F(plan: Plan, y: TaxableYear, adopted: Date, end: Date, pct: Decimal) strict {
    label en official "the 4 percent contribution requirement of clause (iii) applies to this route; the last day under (8)(A) is the close of the following plan year (module 03 window)";
    when plan_amendment_adopted_on_401k12F(plan, y, adopted)
        and plan_year_ends(plan, y, end)
        and required_nonelective_percentage_401k12C(plan, y, pct)
        and pct >= 0.04
        and adopted < add_calendar_period(end, 12 calendar_month)
        and not_known(plan_provided_matching_requirement_during_year_401k12Fii(plan, y));
    then late_nonelective_amendment_permitted_401k12F(plan, y);
}

// =====================================================================
// (13)(C) Automatic deferral
// =====================================================================

pub relation each_eligible_employee_treated_as_electing_qualified_percentage_401k13Ci(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "under the arrangement each eligible employee is treated as having elected to have the employer make elective contributions of a qualified percentage of compensation, case-asserted";
}

pub relation deferral_percentage_in_period_401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal, period: Integer) kind empirical {
    label en unofficial "the percentage applied under the arrangement and the period it applies to: 1 = through the end of the first plan year after the first contribution, 2 = the next plan year, 3 = the second following plan year, 4 = any later plan year, case-asserted";
}

pub relation deferral_percentage_applied_uniformly_401k13Ciii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the percentage is applied uniformly, case-asserted";
}

pub relation qualified_percentage_401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal, period: Integer) kind institutional {
    label en official "section 401(k)(13)(C)(iii): a uniformly applied percentage of at most 15 percent (10 percent in period 1) and at least 3, 4, 5 or 6 percent by period";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "(I) 3 percent during the period ending on the last day of the first plan year which begins after the date on which the first elective contribution described in clause (i) is made with respect to such employee")
rule QualifiedPercentagePeriod1401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "period 1: at least 3 percent and (in the period described in subclause (I)) at most 10 percent";
    when deferral_percentage_in_period_401k13Ciii(plan, y, pct, 1)
        and deferral_percentage_applied_uniformly_401k13Ciii(plan, y)
        and pct >= 0.03 and pct <= 0.10;
    then qualified_percentage_401k13Ciii(plan, y, pct, 1);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "(II) 4 percent during the first plan year following the plan year described in subclause (I)")
rule QualifiedPercentagePeriod2401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "period 2: at least 4 percent, at most 15 percent";
    when deferral_percentage_in_period_401k13Ciii(plan, y, pct, 2)
        and deferral_percentage_applied_uniformly_401k13Ciii(plan, y)
        and pct >= 0.04 and pct <= 0.15;
    then qualified_percentage_401k13Ciii(plan, y, pct, 2);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "(III) 5 percent during the second plan year following the plan year described in subclause (I)")
rule QualifiedPercentagePeriod3401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "period 3: at least 5 percent, at most 15 percent";
    when deferral_percentage_in_period_401k13Ciii(plan, y, pct, 3)
        and deferral_percentage_applied_uniformly_401k13Ciii(plan, y)
        and pct >= 0.05 and pct <= 0.15;
    then qualified_percentage_401k13Ciii(plan, y, pct, 3);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "(IV) 6 percent during any subsequent plan year")
rule QualifiedPercentagePeriod4401k13Ciii(plan: Plan, y: TaxableYear, pct: Decimal) strict {
    label en official "period 4: at least 6 percent, at most 15 percent";
    when deferral_percentage_in_period_401k13Ciii(plan, y, pct, 4)
        and deferral_percentage_applied_uniformly_401k13Ciii(plan, y)
        and pct >= 0.06 and pct <= 0.15;
    then qualified_percentage_401k13Ciii(plan, y, pct, 4);
}

pub relation automatic_election_in_effect_401k13C(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(C)(i)-(ii): the deemed election of the qualified percentage is in effect unless the employee has made an affirmative election";
}

pub relation employee_treated_as_electing_401k13Ci(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee is treated as having elected the qualified percentage, case-asserted";
}

pub relation affirmative_election_made_401k13Cii(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee makes an affirmative election to have no contributions, or contributions at a specified level, case-asserted";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The election treated as having been made under clause (i) shall cease to apply with respect to any employee if such employee makes an affirmative election")
rule AutomaticElectionInEffect401k13C(employee: Person, plan: Plan, y: TaxableYear) strict {
    label en official "the deemed election ends on an affirmative election";
    when employee_treated_as_electing_401k13Ci(employee, plan, y)
        and not_known(affirmative_election_made_401k13Cii(employee, plan, y));
    then automatic_election_in_effect_401k13C(employee, plan, y);
}

pub relation employee_eligible_and_electing_before_qaca_date_401k13Civ(employee: Person, plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee was eligible to participate in the arrangement (or a predecessor) immediately before it became a qualified automatic contribution arrangement and had an election in effect that date either to participate or not to participate, case-asserted";
}

pub relation employee_excluded_from_automatic_deferral_401k13Civ(employee: Person, plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(C)(iv): clause (i) may be applied without taking such an employee into account";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "Clause (i) may be applied without taking into account any employee who")
rule EmployeeExcludedFromAutomaticDeferral401k13Civ(employee: Person, plan: Plan, y: TaxableYear) strict {
    label en official "both subclauses are one case fact";
    when employee_eligible_and_electing_before_qaca_date_401k13Civ(employee, plan, y);
    then employee_excluded_from_automatic_deferral_401k13Civ(employee, plan, y);
}

pub relation automatic_deferral_requirement_met_401k13C(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(C): every eligible employee (other than an excluded one) is treated as electing a qualified percentage";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "each employee eligible to participate in the arrangement is treated as having elected to have the employer make elective contributions in an amount equal to a qualified percentage of compensation")
rule AutomaticDeferralRequirementMet401k13C(plan: Plan, y: TaxableYear, pct: Decimal, period: Integer) strict {
    label en official "the deemed election and a qualified percentage";
    when each_eligible_employee_treated_as_electing_qualified_percentage_401k13Ci(plan, y)
        and qualified_percentage_401k13Ciii(plan, y, pct, period);
    then automatic_deferral_requirement_met_401k13C(plan, y);
}

// =====================================================================
// (13)(D) Matching or nonelective contributions
// =====================================================================

pub relation qaca_matching_formula_made_for_all_nonhighly_compensated_401k13Di1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer makes, for every nonhighly compensated employee, matching contributions at least equal to the (13)(D)(i)(I) formula (the per-employee computation is module 03), case-asserted";
}

pub relation two_year_full_vesting_401k13Diii1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "any employee with at least 2 years of service (section 411(a)) has a nonforfeitable right to 100 percent of the accrued benefit from the employer contributions, case-asserted";
}

pub relation withdrawal_restrictions_2B_met_401k13Diii2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the requirements of paragraph (2)(B) are met for all such employer contributions, case-asserted";
}

pub relation rules_12Eii_and_12G_applied_401k13Div(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the rules of (12)(E)(ii) and (12)(G) are satisfied for the clause (i) contributions, case-asserted";
}

pub relation qaca_contribution_requirement_met_401k13D(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(D): a matching or nonelective contribution with the 2-year vesting and withdrawal restrictions";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "any employee who has completed at least 2 years of service (within the meaning of section 411(a)) has a nonforfeitable right to 100 percent of the employee's accrued benefit derived from such employer contributions")
rule QacaContributionRequirementMatching401k13D(plan: Plan, y: TaxableYear) strict {
    label en official "subclause (I) match, no (12)(B)(ii) violation (rules of (12)(B)(ii)-(iii) apply), vesting, withdrawal";
    when qaca_matching_formula_made_for_all_nonhighly_compensated_401k13Di1(plan, y)
        and two_year_full_vesting_401k13Diii1(plan, y)
        and withdrawal_restrictions_2B_met_401k13Diii2(plan, y)
        and rules_12Eii_and_12G_applied_401k13Div(plan, y)
        and not_known(hce_match_rate_greater_than_nonhce_401k12Bii(plan, y));
    then qaca_contribution_requirement_met_401k13D(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the requirements of subparagraph (B) of paragraph (2) are met with respect to all such employer contributions")
rule QacaContributionRequirementNonelective401k13D(plan: Plan, y: TaxableYear) strict {
    label en official "subclause (II) nonelective 3 percent, vesting, withdrawal";
    when nonelective_contribution_requirement_met_401k12C(plan, y)
        and two_year_full_vesting_401k13Diii1(plan, y)
        and withdrawal_restrictions_2B_met_401k13Diii2(plan, y)
        and rules_12Eii_and_12G_applied_401k13Div(plan, y);
    then qaca_contribution_requirement_met_401k13D(plan, y);
}

// =====================================================================
// (13)(E) Notice
// =====================================================================

pub relation qaca_notice_given_within_reasonable_period_401k13Ei(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "each eligible employee receives written notice within a reasonable period before each plan year, accurate, comprehensive and understandable, case-asserted";
}

pub relation notice_explains_right_to_opt_out_or_change_401k13Eii1(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the notice explains the right to elect not to have elective contributions made (or to elect a different percentage), case-asserted";
}

pub relation arrangement_offers_two_or_more_investment_options_401k13Eii2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee may elect among 2 or more investment options, case-asserted";
}

pub relation notice_explains_default_investment_401k13Eii2(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the notice explains how contributions are invested absent an election, case-asserted";
}

pub relation reasonable_period_to_elect_after_notice_401k13Eii3(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employee has a reasonable period after receipt of the notice and before the first elective contribution to elect, case-asserted";
}

pub relation qaca_notice_requirement_met_401k13E(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(E): the notice requirements";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the employee has a reasonable period of time after receipt of the notice described in subclauses (I) and (II) and before the first elective contribution is made to make either such election")
rule QacaNoticeRequirementMetWithInvestmentExplanation401k13E(plan: Plan, y: TaxableYear) strict {
    label en official "content, default investment explanation and the election period";
    when qaca_notice_given_within_reasonable_period_401k13Ei(plan, y)
        and notice_explains_right_to_opt_out_or_change_401k13Eii1(plan, y)
        and notice_explains_default_investment_401k13Eii2(plan, y)
        and reasonable_period_to_elect_after_notice_401k13Eii3(plan, y);
    then qaca_notice_requirement_met_401k13E(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in the case of an arrangement under which the employee may elect among 2 or more investment options")
rule QacaNoticeRequirementMetSingleInvestment401k13E(plan: Plan, y: TaxableYear) strict {
    label en official "no default investment explanation is required when there are not 2 or more options";
    when qaca_notice_given_within_reasonable_period_401k13Ei(plan, y)
        and notice_explains_right_to_opt_out_or_change_401k13Eii1(plan, y)
        and reasonable_period_to_elect_after_notice_401k13Eii3(plan, y)
        and not_known(arrangement_offers_two_or_more_investment_options_401k13Eii2(plan, y));
    then qaca_notice_requirement_met_401k13E(plan, y);
}

// =====================================================================
// (13)(B) The arrangement, (13)(A) deemed satisfaction, (13)(F) amendments
// =====================================================================

pub relation described_in_13Di_subclause_I_401k13B(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the arrangement uses the matching contribution alternative of (D)(i)(I), case-asserted";
}

pub relation described_in_13Di_subclause_II_401k13B(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the arrangement uses the nonelective contribution alternative of (D)(i)(II), case-asserted";
}

pub relation qualified_automatic_contribution_arrangement_401k13B(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(B): a cash or deferred arrangement meeting subparagraphs (C) through (E) with matching, or (C) and (D) with nonelective contributions";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "which is described in subparagraph (D)(i)(I) and meets the applicable requirements of subparagraphs (C) through (E)")
rule QualifiedAutomaticContributionArrangementMatching401k13B(plan: Plan, y: TaxableYear) strict {
    label en official "clause (i): matching alternative";
    when described_in_13Di_subclause_I_401k13B(plan, y)
        and automatic_deferral_requirement_met_401k13C(plan, y)
        and qaca_contribution_requirement_met_401k13D(plan, y)
        and qaca_notice_requirement_met_401k13E(plan, y);
    then qualified_automatic_contribution_arrangement_401k13B(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "which is described in subparagraph (D)(i)(II) and meets the applicable requirements of subparagraphs (C) and (D)")
rule QualifiedAutomaticContributionArrangementNonelective401k13B(plan: Plan, y: TaxableYear) strict {
    label en official "clause (ii): nonelective alternative (the notice of (E) is not required by clause (ii))";
    when described_in_13Di_subclause_II_401k13B(plan, y)
        and automatic_deferral_requirement_met_401k13C(plan, y)
        and qaca_contribution_requirement_met_401k13D(plan, y);
    then qualified_automatic_contribution_arrangement_401k13B(plan, y);
}

pub relation adp_test_deemed_satisfied_401k13A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(A): a qualified automatic contribution arrangement is treated as meeting the requirements of paragraph (3)(A)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A qualified automatic contribution arrangement shall be treated as meeting the requirements of paragraph (3)(A)(ii)")
rule AdpTestDeemedSatisfiedQaca401k13A(plan: Plan, y: TaxableYear) strict {
    label en official "QACA status";
    when qualified_automatic_contribution_arrangement_401k13B(plan, y);
    then adp_test_deemed_satisfied_401k13A(plan, y);
}

// Wiring into module 03: the decomposed alternatives also derive the
// existing deemed-satisfaction relation (the interface is unchanged).
@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement shall be treated as meeting the requirements of paragraph (3)(A)(ii) if such arrangement")
rule SafeHarborDeemedAdpFromDecomposition401k12(plan: Plan, y: TaxableYear) strict {
    label en official "the decomposed (12) alternative substitutes for the ADP test";
    when arrangement_meets_adp_alternative_401k12A(plan, y);
    then adp_test_deemed_satisfied_safe_harbor(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A qualified automatic contribution arrangement shall be treated as meeting the requirements of paragraph (3)(A)(ii)")
rule SafeHarborDeemedAdpFromQaca401k13(plan: Plan, y: TaxableYear) strict {
    label en official "the QACA substitutes for the ADP test";
    when adp_test_deemed_satisfied_401k13A(plan, y);
    then adp_test_deemed_satisfied_safe_harbor(plan, y);
}

pub relation qaca_nonelective_amendment_adopted_on_401k13F(plan: Plan, y: TaxableYear, adopted: Date) kind empirical {
    label en unofficial "the date the plan was amended after the beginning of the plan year to apply the (D)(i)(II) requirements, case-asserted";
}

pub relation plan_provided_qaca_matching_during_year_401k13Fii(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan provided at any time during the year that (D)(i)(I) or paragraph (12)(B) applied, case-asserted";
}

pub relation qaca_late_nonelective_amendment_permitted_401k13F(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(13)(F): the late amendment to apply the nonelective requirements";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "a plan may be amended after the beginning of a plan year to provide that the requirements of subparagraph (D)(i)(II) shall apply to the arrangement for the plan year")
rule QacaLateNonelectiveAmendmentBeforeDay30401k13F(plan: Plan, y: TaxableYear, adopted: Date, end: Date) strict {
    label en official "exact boundary: adopted + 30 days before the close";
    when qaca_nonelective_amendment_adopted_on_401k13F(plan, y, adopted)
        and plan_year_ends(plan, y, end)
        and add_calendar_period(adopted, 30 calendar_day) < end
        and not_known(plan_provided_qaca_matching_during_year_401k13Fii(plan, y));
    then qaca_late_nonelective_amendment_permitted_401k13F(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "Clause (i)(II) shall not apply to an arrangement unless the amount of the contributions described in subparagraph (D)(i)(II)")
rule QacaLateNonelectiveAmendmentBeforeDistributionDeadline401k13F(plan: Plan, y: TaxableYear, adopted: Date, end: Date, pct: Decimal) strict {
    label en official "the 4 percent requirement of clause (iii) applies to this route";
    when qaca_nonelective_amendment_adopted_on_401k13F(plan, y, adopted)
        and plan_year_ends(plan, y, end)
        and required_nonelective_percentage_401k12C(plan, y, pct)
        and pct >= 0.04
        and adopted < add_calendar_period(end, 12 calendar_month)
        and not_known(plan_provided_qaca_matching_during_year_401k13Fii(plan, y));
    then qaca_late_nonelective_amendment_permitted_401k13F(plan, y);
}
