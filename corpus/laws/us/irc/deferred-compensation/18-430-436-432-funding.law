// Sections 430, 436, 432(b) — single-employer minimum funding, benefit
// restrictions, and multiemployer endangered/critical status. Stage 2d
// (IRC-09), DECISION-0379. Extends the stage-1 BRIEF contracts in
// `16-other-brief.law` (funding_target/target_normal_cost/shortfall_
// amortization_charge/waiver_amortization_charge/minimum_required_
// contribution_430; adjusted_funding_target_attainment_percentage/
// unpredictable_contingent_event_benefit_restricted/plan_amendment_
// increasing_liability_restricted) WITHOUT re-declaring those relations
// (multi-file package, same namespace): this module adds NEW rules that
// also derive `target_normal_cost` and `shortfall_amortization_charge`
// from their own statutory formulas, alongside the pre-existing direct
// case-assertion path (a scenario should supply ONE path, not both, to
// avoid a disputed/BOTH-supported fact — disclosed here rather than
// silently assumed harmless).
//
// Required owner-interface names per the task: `minimum_required_
// contribution` (alias over the pre-existing `minimum_required_
// contribution_430`) and `aftap_restriction` (unifies the (d)/(e)/(b)/(c)
// restriction relations under one name).
//
// SCOPE, per the task's own priority order — done vs. not, TECH-GAPS
// G376-G381 for the reproductions:
//   §430(b) target normal cost formula: EXECUTABLE (arithmetic only; the
//     underlying present-value/expense inputs remain EXTERNAL_DEPENDENCY,
//     unchanged from stage 1).
//   §430(c): funding shortfall (c)(4), shortfall base (c)(3)/(5), and the
//     (c)(2)(A) YEAR-1 level-installment amount (7-year chain of exactly
//     7 multiplications — a BOUNDED constant, not a variable-arity
//     computation) are EXECUTABLE with intermediate values exposed; the
//     full 7-year MULTI-YEAR schedule (installments for years 2-7, which
//     needs a running remaining-balance ledger), the (c)(2)(D) 15/9-year
//     elections, and the (c)(7) installment-acceleration machinery are
//     TECH_GAP G376 (G1-class recursive-ledger gap, exactly as the task
//     itself frames it).
//   §430(i): the (i)(1)(C)/(i)(2)(B) loading-factor arithmetic and the
//     (i)(4)(A)/(i)(6) at-risk-status 80%/70% and 500-participant tests
//     are EXECUTABLE; the (i)(1)(B) additional actuarial assumptions
//     themselves, (i)(4)(B)-(C) transition percentages/auto-manufacturer
//     carve-out, and (i)(5) 5-year phase-in are TECH_GAP G377.
//   §430(j): the (j)(1) 8.5-month due date and (j)(3)(D) 25%-of-required-
//     annual-payment quarterly installment amount are EXECUTABLE exact
//     date/dollar arithmetic; the (j)(2) interest adjustment, (j)(3)(A)
//     underpayment-interest-rate increase, and (j)(4) liquidity-shortfall
//     regime are TECH_GAP G378.
//   §430(k): the >$1,000,000 lien trigger, the lien's institutional
//     effect, and the (k)(4)(A) 10-day PBGC notice duty are EXECUTABLE.
//   §436(d)/(e): the 60%/80% payment and accrual restrictions are
//     EXECUTABLE (reusing the existing AFTAP relation); the (d)(3)(B)
//     one-payment-per-participant limit, the (d)(5) prohibited-payment
//     sub-definitions, and the (f) security/prefunding-balance rules are
//     TECH_GAP G379 (declared, not derived).
//   §436(f)(2): the prefunding-balance-use prohibition is EXECUTABLE as a
//     classification; (f)(1) security and (f)(3) deemed election are
//     TECH_GAP G379.
//   §436(h)(1): modelled as a genuine `presumption` construct (rebutted by
//     certification) per the task's own instruction; (h)(2)/(h)(3) are
//     modelled as ordinary conclusive/deemed rules (their own rebuttal
//     conditions are narrower one-shot certifications, not naturally a
//     second `presumption` layered on the first — a disclosed modelling
//     choice, not a gap).
//   §432(b): the (1)(A)/(B) endangered-status tests, (2)(A)-(D) critical-
//     status tests (arithmetic over case-asserted present-value inputs),
//     the (3)(A) 90-day actuarial-certification duty, the (3)(d)(i) 30-day
//     notification duty, and the (4) election-to-be-critical power are
//     EXECUTABLE; the (5) improving-plan exception, (6) critical-and-
//     declining status, and (7) special-financial-assistance deeming are
//     TECH_GAP G380. The funding-improvement/rehabilitation-plan DUTIES
//     themselves (subsections (c)/(e), not (b)) are OUT OF SCOPE this pass
//     (G381: (b) is a status-determination subsection; the plan-adoption
//     duties with their own windows live in (c)/(e), not reached).

// =====================================================================
// §430(b) — target normal cost formula
// =====================================================================

use self::{
    DefinedBenefitPlan,
    IRC_S430_B,
    IRC_S430_C,
    IRC_S430_I,
    IRC_S430_J,
    IRC_S430_K,
    IRC_S432_B,
    IRC_S436_D,
    IRC_S436_E,
    IRC_S436_F,
    IRC_S436_H,
    Person,
    TaxableYear,
    adjusted_funding_target_attainment_percentage,
    funding_target,
    minimum_required_contribution_430,
    plan_amendment_increasing_liability_restricted,
    shortfall_amortization_charge,
    target_normal_cost,
    unpredictable_contingent_event_benefit_restricted,
    value_of_plan_assets_430,
};

pub relation pv_accruing_benefits_430b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of all benefits expected to accrue or be earned during the plan year, section 430(b)(1)(A)(i), case-asserted — EXTERNAL_DEPENDENCY (actuarial present value)";
}

pub relation plan_related_expenses_430b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "plan-related expenses expected to be paid from plan assets during the plan year, section 430(b)(1)(A)(ii), case-asserted";
}

pub relation mandatory_employee_contributions_430b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "mandatory employee contributions expected to be made during the plan year, section 430(b)(1)(B), case-asserted";
}

@source(IRC_S430_B, relation = formalizes, coverage = exact, quote = "the excess of")
rule TargetNormalCostComputed430b(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money, expenses: Money, ee: Money) strict {
    label en official "target normal cost = PV of accruing benefits + plan expenses - mandatory employee contributions";
    when pv_accruing_benefits_430b(plan, y, pv)
        and plan_related_expenses_430b(plan, y, expenses)
        and mandatory_employee_contributions_430b(plan, y, ee);
    then target_normal_cost(plan, y, pv + expenses - ee);
}

// =====================================================================
// §430(c) — shortfall amortization
// =====================================================================

pub relation funding_shortfall_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(4): funding shortfall = excess (if any) of the funding target over the value of plan assets";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the funding shortfall of a plan for any plan year is the excess (if any) of")
rule FundingShortfall430(plan: DefinedBenefitPlan, y: TaxableYear, target: Money, assets: Money) strict {
    label en official "excess, if any, of funding target over plan assets — floored at zero";
    when funding_target(plan, y, target) and value_of_plan_assets_430(plan, y, assets);
    then funding_shortfall_430(plan, y, max(0.00 USD, target - assets));
}

pub relation prior_shortfall_amortization_installments_pv_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of the aggregate shortfall/waiver amortization installments already determined for this and succeeding plan years with respect to PRECEDING plan years' bases, section 430(c)(3)(B), case-asserted (TECH_GAP G376: a genuine running total across all preceding bases, not derived)";
}

pub relation shortfall_amortization_base_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(3): shortfall amortization base = funding shortfall - PV of already-scheduled installments for preceding bases";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the shortfall amortization base of a plan for a plan year is")
rule ShortfallAmortizationBase430(plan: DefinedBenefitPlan, y: TaxableYear, shortfall: Money, prior_pv: Money) strict {
    label en official "base = funding shortfall - PV of already-scheduled installments (can be negative in principle; the statute does not floor this specific subtraction, unlike (c)(5))";
    when funding_shortfall_430(plan, y, shortfall)
        and prior_shortfall_amortization_installments_pv_430(plan, y, prior_pv);
    then shortfall_amortization_base_430(plan, y, shortfall - prior_pv);
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "In any case in which the value of plan assets of the plan (as reduced under subsection (f)(4)(A)) is equal to or greater than the funding target of the plan for the plan year, the shortfall amortization base of the plan for such plan year shall be zero")
rule ShortfallAmortizationBaseZeroWhenFunded430(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money) strict {
    label en official "section 430(c)(5): base is zero when assets >= funding target";
    when value_of_plan_assets_430(plan, y, assets)
        and funding_target(plan, y, target)
        and assets >= target;
    then shortfall_amortization_base_430(plan, y, 0.00 USD);
}

pub relation effective_interest_rate_430(plan: DefinedBenefitPlan, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the plan's effective interest rate for the plan year (segment rates under section 430(h)(2)(C), applied per (h)(2)(B)), case-asserted — EXTERNAL_DEPENDENCY (segment-rate/actuarial-assumption SOURCE_GAP, same class as this package's other section 430(h) inputs)";
}

pub relation shortfall_amortization_installment_year1_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(c)(2)(A)-(B): the level annual installment amortizing the shortfall amortization base over a 7-plan-year period, for the FIRST year of that period — a bounded 7-term geometric chain, not a recursive multi-year ledger";
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "The shortfall amortization installments are the amounts necessary to amortize the shortfall amortization base of the plan for any plan year in level annual installments over the 7-plan-year period beginning with such plan year")
rule ShortfallAmortizationInstallmentYear1_430(plan: DefinedBenefitPlan, y: TaxableYear, base: Money, r: Decimal) strict {
    label en official "level-annuity payment formula: installment = base * r * (1+r)^7 / ((1+r)^7 - 1); (1+r)^7 is an UNROLLED chain of exactly 7 multiplications (a fixed statutory constant, not a variable-arity computation) — a modelling choice for the ordinary-annuity convention, disclosed as not necessarily matching the annuity-due convention Treasury regulations may prescribe (EVALUATIVE/EXTERNAL_DEPENDENCY as to which convention governs)";
    when shortfall_amortization_base_430(plan, y, base)
        and effective_interest_rate_430(plan, y, r)
        and base > 0.00 USD;
    then shortfall_amortization_installment_year1_430(plan, y,
        div_round(base * r * ((1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r)),
            ((1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r) * (1.0 + r)) - 1.0,
            2, "HALF_UP"));
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "the shortfall amortization charge for a plan for any plan year is the aggregate total (not less than zero) of the shortfall amortization installments for such plan year with respect to any shortfall amortization base which has not been fully amortized under this subsection")
rule ShortfallAmortizationChargeFromYear1Installment430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "single-base simplification: the charge equals the one base's year-1 installment (TECH_GAP G376 for aggregating multiple simultaneous bases)";
    when shortfall_amortization_installment_year1_430(plan, y, amount);
    then shortfall_amortization_charge(plan, y, amount);
}

@source(IRC_S430_C, relation = formalizes, coverage = exact, quote = "In any case in which the funding shortfall of a plan for a plan year is zero, for purposes of determining the shortfall amortization charge for such plan year and succeeding plan years, the shortfall amortization bases for all preceding plan years (and all shortfall amortization installments determined with respect to such bases) shall be reduced to zero")
rule ShortfallAmortizationChargeZeroWhenNoShortfall430(plan: DefinedBenefitPlan, y: TaxableYear, shortfall: Money) strict {
    label en official "section 430(c)(6): the charge is zero for a year with zero funding shortfall (this year's own zeroing; the retroactive zeroing of PRECEDING years' bases is TECH_GAP G376, a multi-year ledger effect)";
    when funding_shortfall_430(plan, y, shortfall) and shortfall == 0.00 USD;
    then shortfall_amortization_charge(plan, y, 0.00 USD);
}

// =====================================================================
// §430(i) — at-risk plans
// =====================================================================

pub relation participant_count_430(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "the number of participants in the plan for the plan year, case-asserted";
}

pub relation at_risk_loading_factor_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(i)(1)(C): loading factor = $700 x number of participants + 4% of the funding target determined without regard to at-risk status";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "4 percent of the funding target (determined without regard to this paragraph) of the plan for the plan year")
rule AtRiskLoadingFactor430(plan: DefinedBenefitPlan, y: TaxableYear, count: Integer, target: Money) strict {
    label en official "$700 per participant plus 4% of the (non-at-risk) funding target";
    when participant_count_430(plan, y, count) and funding_target(plan, y, target);
    then at_risk_loading_factor_430(plan, y, round(700.00 USD * count + target * 0.04, 2, "HALF_UP"));
}

pub relation funding_target_attainment_percentage_430(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the (non-AFTAP) funding target attainment percentage for the PRECEDING plan year, determined without the at-risk assumptions, section 430(i)(4)(A)(i), case-asserted";
}

pub relation at_risk_funding_target_attainment_percentage_430(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the funding target attainment percentage for the PRECEDING plan year computed WITH the additional at-risk actuarial assumptions, section 430(i)(4)(A)(ii), case-asserted";
}

pub relation in_at_risk_status_430(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 430(i)(4)(A): the plan is in at-risk status for the plan year";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the funding target attainment percentage for the preceding plan year (determined under this section without regard to this subsection) is less than 80 percent")
rule InAtRiskStatus430(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal, at_risk_pct: Decimal) defeasible {
    label en official "both the 80% and 70% thresholds must be crossed (statutory percentages for plan years after 2010; the 2008-2010 transition percentages of (i)(4)(B) are TECH_GAP G377)";
    when funding_target_attainment_percentage_430(plan, y, pct)
        and at_risk_funding_target_attainment_percentage_430(plan, y, at_risk_pct)
        and pct < 0.80
        and at_risk_pct < 0.70;
    unless five_hundred_or_fewer_participants_430(plan, y);
    then in_at_risk_status_430(plan, y);
}

pub relation five_hundred_or_fewer_participants_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "on each day during the preceding plan year the plan had 500 or fewer participants, section 430(i)(6), case-asserted";
}

pub relation at_risk_target_normal_cost_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(i)(2): at-risk target normal cost, including the loading factor when the plan has been at-risk for 2 of the preceding 4 plan years";
}

pub relation at_risk_2_of_4_preceding_years_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan has been in at-risk status for at least 2 of the 4 preceding plan years, section 430(i)(1)(A)(ii)/(i)(2)(B), case-asserted";
}

pub relation at_risk_pv_accruing_benefits_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of benefits expected to accrue during the plan year, computed using the additional at-risk actuarial assumptions, section 430(i)(2)(A)(i)(I), case-asserted — EXTERNAL_DEPENDENCY";
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "a loading factor equal to 4 percent of the amount determined under subsection (b)(1)(A)(i) with respect to the plan for the plan year")
rule AtRiskTargetNormalCostWithLoading430(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money, expenses: Money, ee: Money, pv_normal: Money) defeasible {
    label en official "at-risk TNC with the 2-of-4-years loading factor (4% of the ordinary (b)(1)(A)(i) accruing-benefit PV)";
    when in_at_risk_status_430(plan, y)
        and at_risk_2_of_4_preceding_years_430(plan, y)
        and at_risk_pv_accruing_benefits_430(plan, y, pv)
        and plan_related_expenses_430b(plan, y, expenses)
        and mandatory_employee_contributions_430b(plan, y, ee)
        and pv_accruing_benefits_430b(plan, y, pv_normal);
    then at_risk_target_normal_cost_430(plan, y, pv + expenses - ee + round(pv_normal * 0.04, 2, "HALF_UP"));
}

@source(IRC_S430_I, relation = formalizes, coverage = exact, quote = "the present value of all benefits which are expected to accrue or to be earned under the plan during the plan year, determined using the additional actuarial assumptions described in paragraph (1)(B)")
rule AtRiskTargetNormalCostNoLoading430(plan: DefinedBenefitPlan, y: TaxableYear, pv: Money, expenses: Money, ee: Money) defeasible {
    label en official "at-risk TNC without the loading factor (fewer than 2 of the preceding 4 years at-risk)";
    when in_at_risk_status_430(plan, y)
        and not_known(at_risk_2_of_4_preceding_years_430(plan, y))
        and at_risk_pv_accruing_benefits_430(plan, y, pv)
        and plan_related_expenses_430b(plan, y, expenses)
        and mandatory_employee_contributions_430b(plan, y, ee);
    then at_risk_target_normal_cost_430(plan, y, pv + expenses - ee);
}
// (i)(3) the floor (at-risk TNC/funding target never less than the
// ordinary figures) is NOT separately wired (the case's own PV inputs are
// expected to already respect it — disclosed, not enforced by a rule).

// =====================================================================
// §430(j) — due dates and quarterly installments
// =====================================================================

pub relation plan_year_ends_430(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the close of the plan year, case-asserted";
}

pub relation minimum_required_contribution_due_date_430(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 430(j)(1): due date = 8 1/2 months after the close of the plan year";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "the due date for any payment of any minimum required contribution for any plan year shall be 8½ months after the close of the plan year")
rule MinimumRequiredContributionDueDate430(plan: DefinedBenefitPlan, y: TaxableYear, close: Date) strict {
    label en official "8 months + 15 days after the plan year close (e.g. Dec 31 -> Sep 15), exact date arithmetic";
    when plan_year_ends_430(plan, y, close);
    then minimum_required_contribution_due_date_430(plan, y, add_calendar_period(add_calendar_period(close, 8 calendar_month), 15 calendar_day));
}

pub relation prior_year_minimum_required_contribution_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the minimum required contribution for the PRECEDING plan year (determined without regard to subsection (j) or any section 412(c) waiver), case-asserted";
}

pub relation preceding_plan_year_was_12_months_430(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the preceding plan year referred to in (j)(3)(D)(ii)(II) was a year of 12 months, case-asserted";
}

pub relation required_annual_payment_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(j)(3)(D)(ii): required annual payment = lesser of 90% of this year's MRC or 100% of last year's MRC (the 100%-of-prior-year branch only when the prior year was a full 12-month year)";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "90 percent of the minimum required contribution (determined without regard to this subsection) to the plan for the plan year under this section")
rule RequiredAnnualPayment430WithPriorYear(plan: DefinedBenefitPlan, y: TaxableYear, current_mrc: Money, prior_mrc: Money) strict {
    label en official "lesser of 90% current-year MRC and 100% prior-year MRC, when the prior year qualifies";
    when minimum_required_contribution_430(plan, y, current_mrc)
        and prior_year_minimum_required_contribution_430(plan, y, prior_mrc)
        and preceding_plan_year_was_12_months_430(plan, y);
    then required_annual_payment_430(plan, y, min(round(current_mrc * 0.90, 2, "HALF_UP"), prior_mrc));
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "Subclause (II) shall not apply if the preceding plan year referred to in such clause was not a year of 12 months")
rule RequiredAnnualPayment430NoPriorYear(plan: DefinedBenefitPlan, y: TaxableYear, current_mrc: Money) strict {
    label en official "90% of current-year MRC only, when the prior-year branch is unavailable";
    when minimum_required_contribution_430(plan, y, current_mrc)
        and not_known(preceding_plan_year_was_12_months_430(plan, y));
    then required_annual_payment_430(plan, y, round(current_mrc * 0.90, 2, "HALF_UP"));
}

pub relation required_installment_amount_430(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(j)(3)(D)(i): each of the 4 required installments equals 25 percent of the required annual payment";
}

@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "The amount of any required installment shall be 25 percent of the required annual payment")
rule RequiredInstallmentAmount430(plan: DefinedBenefitPlan, y: TaxableYear, annual: Money) strict {
    label en official "25% of the required annual payment";
    when required_annual_payment_430(plan, y, annual);
    then required_installment_amount_430(plan, y, round(annual * 0.25, 2, "HALF_UP"));
}

pub enum QuarterlyInstallmentOrdinal {
    First;
    Second;
    Third;
    Fourth;
    label en unofficial "which of the 4 required section 430(j)(3) installments (calendar-year-plan due dates: April 15 / July 15 / October 15 / January 15 of the following year)";
}

pub relation required_installment_due_date_430(plan: DefinedBenefitPlan, y: TaxableYear, which: QuarterlyInstallmentOrdinal, on: Date) kind institutional {
    label en official "section 430(j)(3)(C): the due date for each of the 4 required installments";
}

// Bind the actual start of THIS plan year. A reverse date expression in
// plan_year_ends_430 cannot bind plan_year_start (§190), and deriving from
// the end of this year would incorrectly schedule the next year's installments.
// Unadjusted calendar anniversaries only. Holiday extensions are separate
// statutory rules; a nonexistent monthly date is refused, not guessed.
// Kept in this owner so a relation-scoped execution includes the policy.
pub deadline policy IRC_PLAN_CALENDAR_STEP {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end reject_nonexistent;
}
pub relation plan_year_starts_430(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "actual first day of this plan year for section 430(j)(3); supplied calendar-year convention";
}
@source(IRC_S430_J, relation = formalizes, coverage = exact, quote = "There shall be 4 required installments for each plan year")
rule RequiredInstallmentDueDates430(plan: DefinedBenefitPlan, y: TaxableYear, plan_year_start: Date) strict {
    label en official "15th day of the 4th/7th/10th month of the plan year, and the 1st month of the following plan year (calendar-year convention; the (j)(3)(E) non-calendar-year substitution rule is applied by the case supplying plan_year_start)";
    when plan_year_starts_430(plan, y, plan_year_start);
    then required_installment_due_date_430(plan, y, First, add_calendar_period(add_calendar_period(plan_year_start, 3 calendar_month), 14 calendar_day));
    then required_installment_due_date_430(plan, y, Second, add_calendar_period(add_calendar_period(plan_year_start, 6 calendar_month), 14 calendar_day));
    then required_installment_due_date_430(plan, y, Third, add_calendar_period(add_calendar_period(plan_year_start, 9 calendar_month), 14 calendar_day));
    then required_installment_due_date_430(plan, y, Fourth, add_calendar_period(add_calendar_period(plan_year_start, 12 calendar_month), 14 calendar_day));
}

// =====================================================================
// §430(k) — liens for missed contributions exceeding $1,000,000
// =====================================================================

pub relation contribution_payment_due(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date, amount: Money) kind empirical {
    label en unofficial "a contribution payment (including a required installment) required under section 412/430 for this plan/sponsor/year, case-asserted";
}

pub relation contribution_payment_made_by_due_date(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date, amount_paid: Money) kind empirical {
    label en unofficial "the amount of the payment actually made by the due date, case-asserted";
}

pub relation aggregate_unpaid_balance_430k(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate unpaid balance (including interest) of ALL preceding required payments not made by their due dates, section 430(k)(1)(B)/(3), case-asserted (TECH_GAP: a genuine running total across every prior missed payment, same class as the (c) shortfall-installment ledger)";
}

pub relation section430k_plan_applicability(plan: DefinedBenefitPlan, y: TaxableYear, ftap: Decimal) kind institutional {
    label en unofficial "section 430(k)(2): this subsection applies to a covered single-employer plan whose funding target attainment percentage for the plan year is less than 100 percent";
}

@source(IRC_S430_K, relation = formalizes, coverage = exact, quote = "This subsection shall apply to a defined benefit plan (other than a multiemployer plan) covered under section 4021 of the Employee Retirement Income Security Act of 1974 for any plan year for which the funding target attainment percentage (as defined in subsection (d)(2)) of such plan is less than 100 percent")
rule Section430kPlanApplicability(plan: DefinedBenefitPlan, y: TaxableYear, ftap: Decimal) strict {
    label en official "applies when FTAP < 100 percent";
    when funding_target_attainment_percentage_430(plan, y, ftap) and ftap < 1.00;
    then section430k_plan_applicability(plan, y, ftap);
}

pub relation section430k_lien_triggered(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear) kind institutional {
    label en official "section 430(k)(1): a failure to pay, when the aggregate unpaid balance (with this payment) exceeds $1,000,000, triggers a lien";
}

@source(IRC_S430_K, relation = formalizes, coverage = exact, quote = "the unpaid balance of such payment (including interest), when added to the aggregate unpaid balance of all preceding such payments for which payment was not made before the due date (including interest), exceeds $1,000,000")
rule Section430kLienTriggered(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, ftap: Decimal, due_on: Date, due_amount: Money, paid: Money, prior_unpaid: Money) strict {
    label en official "triggered when this payment's shortfall plus the prior aggregate unpaid balance exceeds $1,000,000";
    when section430k_plan_applicability(plan, y, ftap)
        and contribution_payment_due(plan, sponsor, y, due_on, due_amount)
        and contribution_payment_made_by_due_date(plan, sponsor, y, due_on, paid)
        and paid < due_amount
        and aggregate_unpaid_balance_430k(plan, sponsor, y, prior_unpaid)
        and (due_amount - paid) + prior_unpaid > 1000000.00 USD;
    then section430k_lien_triggered(plan, sponsor, y);
}

pub relation section430k_lien_amount(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 430(k)(3): the lien amount equals the aggregate unpaid balance of required contribution payments";
}

@source(IRC_S430_K, relation = formalizes, coverage = exact, quote = "the amount of the lien shall be equal to the aggregate unpaid balance of contribution payments required under this section and section 412 for which payment has not been made before the due date")
rule Section430kLienAmount(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_amount: Money, paid: Money, prior_unpaid: Money) strict {
    label en official "lien amount = this payment's shortfall + prior aggregate unpaid balance";
    when section430k_lien_triggered(plan, sponsor, y)
        and contribution_payment_due(plan, sponsor, y, _, due_amount)
        and contribution_payment_made_by_due_date(plan, sponsor, y, _, paid)
        and aggregate_unpaid_balance_430k(plan, sponsor, y, prior_unpaid);
    then section430k_lien_amount(plan, sponsor, y, (due_amount - paid) + prior_unpaid);
}

pub relation notify_pbgc_of_failure_duty_breached(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date) kind institutional {
    label en official "section 430(k)(4)(A): the person committing the failure must notify PBGC within 10 days of the due date";
}

pub relation pbgc_notified_of_failure_on(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date, notified_on: Date) kind empirical {
    label en unofficial "the date PBGC was notified of the failure, case-asserted";
}

@source(IRC_S430_K, relation = formalizes, coverage = exact, quote = "A person committing a failure described in paragraph (1) shall notify the Pension Benefit Guaranty Corporation of such failure within 10 days of the due date for the required contribution payment")
rule NotifyPbgcOfFailureDutyBreached(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date) strict {
    label en official "breach: lien triggered but no timely PBGC notice asserted within 10 days of the due date";
    when section430k_lien_triggered(plan, sponsor, y)
        and contribution_payment_due(plan, sponsor, y, due_on, _)
        and not_known(pbgc_notified_within_10_days_430k(plan, sponsor, y, due_on));
    then notify_pbgc_of_failure_duty_breached(plan, sponsor, y, due_on);
}

pub relation pbgc_notified_within_10_days_430k(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date) kind institutional {
    label en unofficial "existence signal: PBGC was notified within 10 days of the due date (a proper unary-per-key relation for not_known, avoiding a wildcard-bearing negated date argument)";
}

rule PbgcNotifiedWithin10Days430k(plan: DefinedBenefitPlan, sponsor: Person, y: TaxableYear, due_on: Date, notified_on: Date) strict {
    label en unofficial "derives the existence signal when notice was given within the 10-day window";
    when pbgc_notified_of_failure_on(plan, sponsor, y, due_on, notified_on)
        and notified_on <= add_calendar_period(due_on, 10 calendar_day);
    then pbgc_notified_within_10_days_430k(plan, sponsor, y, due_on);
}

// =====================================================================
// §436(d)/(e)/(f) — benefit restrictions
// =====================================================================

pub relation prohibited_payment_proposed(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a prohibited payment (section 436(d)(5)) proposed to be made to the participant, case-asserted";
}

pub relation plan_sponsor_debtor_in_bankruptcy(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan sponsor is a debtor in a title 11 (or similar) case during the period, case-asserted";
}

pub relation prohibited_payment_restricted_below_60(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 436(d)(1): no prohibited payment when AFTAP is below 60 percent";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "in any case in which the plan's adjusted funding target attainment percentage for a plan year is less than 60 percent, the plan may not pay any prohibited payment after the valuation date for the plan year")
rule ProhibitedPaymentRestrictedBelow60(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, aftap: Decimal, amount: Money) defeasible {
    label en official "restricted when AFTAP < 60 percent and a prohibited payment is proposed";
    when adjusted_funding_target_attainment_percentage(plan, y, aftap)
        and aftap < 0.60
        and prohibited_payment_proposed(plan, participant, y, amount);
    then prohibited_payment_restricted_below_60(plan, participant, y);
}

pub relation prohibited_payment_restricted_bankruptcy(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) kind institutional {
    label en official "section 436(d)(2): no prohibited payment while the plan sponsor is a debtor in bankruptcy";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "during any period in which the plan sponsor is a debtor in a case under title 11, United States Code, or similar Federal or State law, the plan may not pay any prohibited payment")
rule ProhibitedPaymentRestrictedBankruptcy(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) strict {
    label en official "restricted while the sponsor is a bankruptcy debtor (the enrolled-actuary AFTAP-certification cure is TECH_GAP G379)";
    when plan_sponsor_debtor_in_bankruptcy(plan, y)
        and prohibited_payment_proposed(plan, participant, y, amount);
    then prohibited_payment_restricted_bankruptcy(plan, participant, y);
}

pub relation prohibited_payment_50pct_limit_430d3(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 436(d)(3)(A): between 60% and 80% AFTAP, a prohibited payment may not exceed 50% of the amount that could be paid without regard to this section (the (ii) PBGC-guarantee-present-value alternative is TECH_GAP G379)";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "in any case in which the plan's adjusted funding target attainment percentage for a plan year is 60 percent or greater but less than 80 percent, the plan may not pay any prohibited payment after the valuation date for the plan year to the extent the amount of the payment exceeds the lesser of")
rule ProhibitedPayment50PctLimit(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, aftap: Decimal, amount: Money) defeasible {
    label en official "limit = 50% of the amount that could be paid absent section 436";
    when adjusted_funding_target_attainment_percentage(plan, y, aftap)
        and aftap >= 0.60 and aftap < 0.80
        and prohibited_payment_proposed(plan, participant, y, amount);
    then prohibited_payment_50pct_limit_430d3(plan, participant, y, round(amount * 0.50, 2, "HALF_UP"));
}

pub relation benefit_accruals_cease_436e(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(e)(1): benefit accruals cease as of the valuation date when AFTAP is below 60 percent";
}

@source(IRC_S436_E, relation = formalizes, coverage = exact, quote = "in any case in which the plan's adjusted funding target attainment percentage for a plan year is less than 60 percent, benefit accruals under the plan shall cease as of the valuation date for the plan year")
rule BenefitAccrualsCease436e(plan: DefinedBenefitPlan, y: TaxableYear, aftap: Decimal) defeasible {
    label en official "accruals cease when AFTAP < 60 percent";
    when adjusted_funding_target_attainment_percentage(plan, y, aftap) and aftap < 0.60;
    then benefit_accruals_cease_436e(plan, y);
}

pub relation sponsor_contribution_to_cure_436e2(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an additional contribution (beyond the section 430 minimum required contribution) made by the plan sponsor sufficient to bring the AFTAP to 60 percent, case-asserted";
}

pub relation benefit_accrual_cessation_cured_436e2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(e)(2): the (e)(1) cessation ceases to apply, effective as of the first day of the plan year, upon the sponsor's curative contribution";
}

@source(IRC_S436_E, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall cease to apply with respect to any plan year, effective as of the first day of the plan year, upon payment by the plan sponsor of a contribution (in addition to any minimum required contribution under section 430) equal to the amount sufficient to result in an adjusted funding target attainment percentage of 60 percent")
rule BenefitAccrualCessationCured436e2(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) defeasible {
    label en official "a power the sponsor exercises by contributing: gated on benefit_accruals_cease_436e already applying";
    when benefit_accruals_cease_436e(plan, y)
        and sponsor_contribution_to_cure_436e2(plan, y, amount)
        and amount > 0.00 USD;
    then power CureAccrualCessation436e {
        holder plan;
        over plan;
        exercise sponsor_contribution_to_cure_436e2(plan, y, amount);
        valid_when benefit_accruals_cease_436e(plan, y);
        effect benefit_accrual_cessation_cured_436e2(plan, y);
    };
}

pub relation prefunding_balance_used_to_avoid_restriction(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an attempt to use the plan's section 430(f) prefunding balance or funding standard carryover balance to satisfy a payment made to avoid or terminate a (b)/(c)/(e) restriction, case-asserted";
}

pub relation prefunding_balance_use_prohibited_436f2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(f)(2): no prefunding or funding standard carryover balance may be used to satisfy a payment made to avoid or terminate a (b)/(c)/(e) restriction";
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "No prefunding balance or funding standard carryover balance under section 430(f) may be used under subsection (b), (c), or (e) to satisfy any payment an employer may make under any such subsection to avoid or terminate the application of any limitation under such subsection")
rule PrefundingBalanceUseProhibited436f2(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "classifies any such attempted use as prohibited";
    when prefunding_balance_used_to_avoid_restriction(plan, y, amount) and amount > 0.00 USD;
    then prefunding_balance_use_prohibited_436f2(plan, y);
}

// --- shared alias per the task's required owner-interface name ------------
pub relation aftap_restriction(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "unifies every section 436 AFTAP-triggered restriction (unpredictable-contingent-event benefits, plan amendments, prohibited payments, accrual cessation) under one owner-interface name";
}

rule AftapRestrictionViaUnpredictableContingentEvent(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) defeasible {
    label en unofficial "436(b)";
    when unpredictable_contingent_event_benefit_restricted(plan, participant, y);
    then aftap_restriction(plan, y);
}
rule AftapRestrictionViaPlanAmendment(plan: DefinedBenefitPlan, y: TaxableYear) defeasible {
    label en unofficial "436(c)";
    when plan_amendment_increasing_liability_restricted(plan, y);
    then aftap_restriction(plan, y);
}
rule AftapRestrictionViaProhibitedPaymentBelow60(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) defeasible {
    label en unofficial "436(d)(1)";
    when prohibited_payment_restricted_below_60(plan, participant, y);
    then aftap_restriction(plan, y);
}
rule AftapRestrictionViaBankruptcy(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear) strict {
    label en unofficial "436(d)(2)";
    when prohibited_payment_restricted_bankruptcy(plan, participant, y);
    then aftap_restriction(plan, y);
}
rule AftapRestrictionViaAccrualCessation(plan: DefinedBenefitPlan, y: TaxableYear) defeasible {
    label en unofficial "436(e)(1)";
    when benefit_accruals_cease_436e(plan, y);
    then aftap_restriction(plan, y);
}

// --- shared alias per the task's required owner-interface name ------------
pub relation minimum_required_contribution(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "alias over the pre-existing minimum_required_contribution_430 (stage 1), under the exact owner-interface name the task requires";
}

rule MinimumRequiredContributionAlias(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en unofficial "restates minimum_required_contribution_430 under the shorter name";
    when minimum_required_contribution_430(plan, y, amount);
    then minimum_required_contribution(plan, y, amount);
}

// =====================================================================
// §436(h) — presumptions
// =====================================================================

pub relation benefit_limitation_applied_preceding_year_436(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "a section 436(b)/(c)/(d)/(e) benefit limitation was applied to the plan with respect to the PRECEDING plan year, case-asserted";
}

pub relation preceding_year_aftap_436(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the plan's AFTAP for the preceding plan year, case-asserted";
}

pub relation actuary_certified_current_year_aftap_436(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the enrolled actuary has certified the actual AFTAP for the current plan year, case-asserted";
}

pub relation section436h1_carryover_presumed(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en unofficial "section 436(h)(1)'s presumption is in effect (not yet rebutted by certification) for this plan/year";
}

presumption Section436hCarryoverPresumption {
    for plan: DefinedBenefitPlan;
    for y: TaxableYear;
    when benefit_limitation_applied_preceding_year_436(plan, y);
    presume section436h1_carryover_presumed(plan, y);
    unless actuary_certified_current_year_aftap_436(plan, y) then not section436h1_carryover_presumed(plan, y);
}
// section 436(h)(1): until the actuary certifies the actual current-year
// AFTAP, it is PRESUMED equal to the preceding year's AFTAP — modelled as
// a genuine `presumption` construct (rebutted by certification), per the
// task's own instruction. The presumed VALUE is carried separately (below)
// because a presumption's rebuttal branch (`unless ... then not P`) must
// bind every argument of its own head from the `unless` condition itself
// (LDC-E4101) — `actuary_certified_current_year_aftap_436(plan, y)` alone
// cannot bind a `pct` argument, so the presumption's own head is kept
// boolean-shaped and the numeric AFTAP value is propagated by an ordinary
// rule that reads the presumption's (rebuttable) positive conclusion.

@source(IRC_S436_H, relation = formalizes, coverage = exact, quote = "the adjusted funding target attainment percentage of the plan for the current plan year shall be presumed to be equal to the adjusted funding target attainment percentage of the plan for the preceding plan year")
rule Section436h1CarryoverValue(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) defeasible {
    label en official "propagates the preceding year's AFTAP as the current year's AFTAP while the presumption is in effect";
    when section436h1_carryover_presumed(plan, y)
        and preceding_year_aftap_436(plan, y, pct);
    then adjusted_funding_target_attainment_percentage(plan, y, pct);
}

pub relation no_certification_by_10th_month_436h2(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "no certification of the current-year AFTAP has been made before the first day of the 10th month of the plan year, case-asserted";
}

pub relation aftap_conclusively_presumed_below_60_436h2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(h)(2): AFTAP is conclusively presumed below 60 percent once the 10th-month deadline passes without certification";
}

@source(IRC_S436_H, relation = formalizes, coverage = exact, quote = "such first day shall be deemed, for purposes of such subsection, to be the valuation date of the plan for the current plan year and the plan's adjusted funding target attainment percentage shall be conclusively presumed to be less than 60 percent")
rule AftapConclusivelyPresumedBelow60_436h2(plan: DefinedBenefitPlan, y: TaxableYear) strict {
    label en official "conclusive (not rebuttable by a later certification, per the statute's own 'conclusively' language) once the 10th-month deadline passes";
    when no_certification_by_10th_month_436h2(plan, y);
    then aftap_conclusively_presumed_below_60_436h2(plan, y);
}
// (h)(3) (the 4th-month deadline / 10-percentage-point deemed reduction
// when the preceding year was within 10 points of a threshold) is NOT
// modelled this pass (TECH_GAP G379: a third overlapping presumption
// layer, scope cut for time).

// =====================================================================
// §432(b) — multiemployer endangered/critical status
// =====================================================================

pub entity MultiemployerPlan : DefinedBenefitPlan {
    label en unofficial "a multiemployer plan within the meaning of section 414(f), for purposes of section 432";
}

pub relation funded_percentage_432(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the plan's funded percentage for the plan year, case-asserted";
}

pub relation has_accumulated_funding_deficiency_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan has an accumulated funding deficiency for the plan year, case-asserted";
}

pub relation projected_accumulated_funding_deficiency_within_6_years_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is projected to have an accumulated funding deficiency for any of the 6 succeeding plan years (taking into account section 431(d) amortization extensions), case-asserted (TECH_GAP G380: a genuine year-by-year projection, not derived)";
}

pub relation not_in_critical_status_or_paragraph5_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is not in critical status for the plan year and is not described in paragraph (5), case-asserted (this module's own critical-status test is NOT wired as a negative precondition here to avoid a same-predicate cycle; the case bears the consistency burden, disclosed)";
}

pub relation endangered_status_432b1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(1): endangered status — funded percentage below 80% OR an actual/projected accumulated funding deficiency, and not critical/paragraph-(5)";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan's funded percentage for such plan year is less than 80 percent")
rule EndangeredStatusFundedPercentage432b1A(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) strict {
    label en official "(A): funded percentage < 80%";
    when not_in_critical_status_or_paragraph5_432(plan, y)
        and funded_percentage_432(plan, y, pct)
        and pct < 0.80;
    then endangered_status_432b1(plan, y);
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan has an accumulated funding deficiency for such plan year, or is projected to have such an accumulated funding deficiency for any of the 6 succeeding plan years")
rule EndangeredStatusFundingDeficiency432b1B(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "(B): actual or 6-year-projected accumulated funding deficiency";
    when not_in_critical_status_or_paragraph5_432(plan, y)
        and (has_accumulated_funding_deficiency_432(plan, y)
            or projected_accumulated_funding_deficiency_within_6_years_432(plan, y));
    then endangered_status_432b1(plan, y);
}

pub relation seriously_endangered_status_432b1(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(1) last sentence: seriously endangered when BOTH (A) and (B) are described";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "a plan shall be treated as in seriously endangered status for a plan year if the plan is described in both subparagraphs (A) and (B)")
rule SeriouslyEndangeredStatus432b1(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal) strict {
    label en official "both the funded-percentage and funding-deficiency grounds hold simultaneously";
    when not_in_critical_status_or_paragraph5_432(plan, y)
        and funded_percentage_432(plan, y, pct)
        and pct < 0.80
        and (has_accumulated_funding_deficiency_432(plan, y)
            or projected_accumulated_funding_deficiency_within_6_years_432(plan, y));
    then seriously_endangered_status_432b1(plan, y);
}

pub relation fmv_plan_assets_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of plan assets, case-asserted";
}

pub relation pv_anticipated_employer_contributions_6yr_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of reasonably anticipated employer contributions for the current and 6 succeeding plan years, section 432(b)(2)(A)(ii), case-asserted";
}

pub relation pv_nonforfeitable_benefits_7yr_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the present value of nonforfeitable benefits (plus administrative expenses) projected payable for the current and 6 succeeding plan years, section 432(b)(2)(A) closing clause, case-asserted";
}

pub relation critical_status_432b2a(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2)(A): critical status — funded percentage < 65% AND (assets + 6-year contribution PV) < 6-year benefit PV";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the funded percentage of the plan is less than 65 percent")
rule CriticalStatus432b2A(plan: MultiemployerPlan, y: TaxableYear, pct: Decimal, assets: Money, contrib_pv: Money, benefit_pv: Money) strict {
    label en official "both the 65% funded-percentage test and the asset/contribution-vs-benefit test";
    when funded_percentage_432(plan, y, pct)
        and pct < 0.65
        and fmv_plan_assets_432(plan, y, assets)
        and pv_anticipated_employer_contributions_6yr_432(plan, y, contrib_pv)
        and pv_nonforfeitable_benefits_7yr_432(plan, y, benefit_pv)
        and (assets + contrib_pv) < benefit_pv;
    then critical_status_432b2a(plan, y);
}

pub relation projected_accumulated_funding_deficiency_within_horizon_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan has an accumulated funding deficiency for the current plan year, or is projected to have one within the applicable (3- or 4-year) horizon, section 432(b)(2)(B), case-asserted";
}

pub relation critical_status_432b2b(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2)(B): critical status via an actual or projected accumulated funding deficiency";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan has an accumulated funding deficiency for the current plan year, not taking into account any extension of amortization periods under section 431(d)")
rule CriticalStatus432b2B(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en official "restates the case-asserted (B) determination as the classification";
    when projected_accumulated_funding_deficiency_within_horizon_432(plan, y);
    then critical_status_432b2b(plan, y);
}

pub relation normal_cost_plus_interest_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "normal cost for the year plus interest on unfunded benefit liabilities as of the last date of the preceding year, section 432(b)(2)(C)(i)(I), case-asserted";
}

pub relation pv_anticipated_contributions_current_year_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of reasonably anticipated employer and employee contributions for the current plan year, section 432(b)(2)(C)(i)(II), case-asserted";
}

pub relation pv_inactive_nonforfeitable_benefits_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of nonforfeitable benefits of INACTIVE participants, section 432(b)(2)(C)(ii), case-asserted";
}

pub relation pv_active_nonforfeitable_benefits_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of nonforfeitable benefits of ACTIVE participants, section 432(b)(2)(C)(ii), case-asserted";
}

pub relation critical_status_432b2c(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2)(C): critical status via the (i) cost-exceeds-contributions test, (ii) inactive-exceeds-active-liability test, and (iii) funding-deficiency test, ALL three together";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan's normal cost for the current plan year, plus interest (determined at the rate used for determining costs under the plan) for the current plan year on the amount of unfunded benefit liabilities under the plan as of the last date of the preceding plan year, exceeds")
rule CriticalStatus432b2C(plan: MultiemployerPlan, y: TaxableYear, cost: Money, contrib_pv: Money, inactive_pv: Money, active_pv: Money) strict {
    label en official "(i) cost > contribution PV, AND (ii) inactive PV > active PV, AND (iii) funding deficiency (projected or actual, reusing the (B) relation)";
    when normal_cost_plus_interest_432(plan, y, cost)
        and pv_anticipated_contributions_current_year_432(plan, y, contrib_pv)
        and cost > contrib_pv
        and pv_inactive_nonforfeitable_benefits_432(plan, y, inactive_pv)
        and pv_active_nonforfeitable_benefits_432(plan, y, active_pv)
        and inactive_pv > active_pv
        and projected_accumulated_funding_deficiency_within_horizon_432(plan, y);
    then critical_status_432b2c(plan, y);
}

pub relation pv_anticipated_employer_contributions_5yr_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of reasonably anticipated employer contributions for the current and 4 succeeding plan years, section 432(b)(2)(D)(ii), case-asserted";
}

pub relation pv_all_benefits_5yr_432(plan: MultiemployerPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "present value of ALL benefits (not only nonforfeitable) projected payable during the current and 4 succeeding plan years, plus administrative expenses, section 432(b)(2)(D) closing clause, case-asserted";
}

pub relation critical_status_432b2d(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2)(D): critical status — (assets + 5-year contribution PV) < 5-year all-benefits PV";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the fair market value of plan assets, plus")
rule CriticalStatus432b2D(plan: MultiemployerPlan, y: TaxableYear, assets: Money, contrib_pv: Money, benefit_pv: Money) strict {
    label en official "assets + 5-year contribution PV < 5-year all-benefits PV";
    when fmv_plan_assets_432(plan, y, assets)
        and pv_anticipated_employer_contributions_5yr_432(plan, y, contrib_pv)
        and pv_all_benefits_5yr_432(plan, y, benefit_pv)
        and (assets + contrib_pv) < benefit_pv;
    then critical_status_432b2d(plan, y);
}

pub relation critical_status_432(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(2): critical status via any one of (A)-(D)";
}

rule CriticalStatusViaA(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en unofficial "unifies (A)"; when critical_status_432b2a(plan, y); then critical_status_432(plan, y);
}
rule CriticalStatusViaB(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en unofficial "unifies (B)"; when critical_status_432b2b(plan, y); then critical_status_432(plan, y);
}
rule CriticalStatusViaC(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en unofficial "unifies (C)"; when critical_status_432b2c(plan, y); then critical_status_432(plan, y);
}
rule CriticalStatusViaD(plan: MultiemployerPlan, y: TaxableYear) strict {
    label en unofficial "unifies (D)"; when critical_status_432b2d(plan, y); then critical_status_432(plan, y);
}

pub relation plan_year_starts_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted";
}

pub relation actuarial_certification_duty_breached_432b3a(plan: MultiemployerPlan, y: TaxableYear, deadline: Date) kind institutional {
    label en official "section 432(b)(3)(A): the plan actuary must certify status to the Secretary and plan sponsor not later than the 90th day of the plan year";
}

pub relation actuarial_certification_made_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the plan actuary made the section 432(b)(3)(A) certification, case-asserted";
}

pub relation actuarial_certification_was_made_432(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en unofficial "existence signal for not_known, mirroring the module-17 wildcard-avoidance pattern";
}

rule ActuarialCertificationWasMade432(plan: MultiemployerPlan, y: TaxableYear, on: Date) strict {
    label en unofficial "derives the existence signal";
    when actuarial_certification_made_432(plan, y, on);
    then actuarial_certification_was_made_432(plan, y);
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "Not later than the 90th day of each plan year of a multiemployer plan, the plan actuary shall certify to the Secretary and to the plan sponsor")
rule ActuarialCertificationDutyBreached432b3a(plan: MultiemployerPlan, y: TaxableYear, plan_year_start: Date) strict {
    label en official "breach: no certification asserted by the 90th day of the plan year";
    when plan_year_starts_432(plan, y, plan_year_start)
        and not_known(actuarial_certification_was_made_432(plan, y));
    then actuarial_certification_duty_breached_432b3a(plan, y, add_calendar_period(plan_year_start, 89 calendar_day));
}

pub relation notification_of_status_given_on_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date the plan sponsor provided the section 432(b)(3)(D)(i) notification, case-asserted";
}

pub relation notification_duty_breached_432b3di(plan: MultiemployerPlan, y: TaxableYear, deadline: Date) kind institutional {
    label en official "section 432(b)(3)(D)(i): the plan sponsor must notify participants/beneficiaries/bargaining parties/PBGC within 30 days after the certification date";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan sponsor shall, not later than 30 days after the date of the certification, provide notification of the endangered or critical status")
rule NotificationDutyBreached432b3di(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date) strict {
    label en official "breach: no notification asserted within 30 days of certification, when the plan is endangered or critical";
    when actuarial_certification_made_432(plan, y, certified_on)
        and (endangered_status_432b1(plan, y) or critical_status_432(plan, y))
        and not_known(notification_given_within_30_days_432(plan, y, certified_on));
    then notification_duty_breached_432b3di(plan, y, add_calendar_period(certified_on, 30 calendar_day));
}

pub relation notification_given_within_30_days_432(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date) kind institutional {
    label en unofficial "existence signal: notice was given within 30 days of certification";
}

rule NotificationGivenWithin30Days432(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date, notified_on: Date) strict {
    label en unofficial "derives the existence signal";
    when actuarial_certification_made_432(plan, y, certified_on)
        and notification_of_status_given_on_432(plan, y, notified_on)
        and notified_on <= add_calendar_period(certified_on, 30 calendar_day);
    then notification_given_within_30_days_432(plan, y, certified_on);
}

pub relation projected_critical_status_within_5_years_432(plan: MultiemployerPlan, y: TaxableYear) kind empirical {
    label en unofficial "the plan is projected by the actuary to be in critical status in any of the succeeding 5 plan years, section 432(b)(4)(A), case-asserted";
}

pub relation sponsor_elects_critical_status_432(plan: MultiemployerPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the plan sponsor's election to be in critical status effective for the current plan year, case-asserted";
}

pub relation critical_status_by_election_432b4(plan: MultiemployerPlan, y: TaxableYear) kind institutional {
    label en official "section 432(b)(4): the plan is treated as in critical status for the current plan year by sponsor election";
}

@source(IRC_S432_B, relation = formalizes, coverage = exact, quote = "the plan sponsor of a multiemployer plan that is not in critical status for a plan year but that is projected by the plan actuary, pursuant to the determination under paragraph (3), to be in critical status in any of the succeeding 5 plan years may, not later than 30 days after the date of the certification under paragraph (3)(A), elect to be in critical status effective for the current plan year")
rule CriticalStatusByElection432b4(plan: MultiemployerPlan, y: TaxableYear, certified_on: Date, elected_on: Date) strict {
    label en official "power: the sponsor elects critical status within 30 days of the (3)(A) certification, valid only when not already in critical status and projected critical within 5 years";
    when actuarial_certification_made_432(plan, y, certified_on)
        and not_known(critical_status_432(plan, y))
        and projected_critical_status_within_5_years_432(plan, y)
        and sponsor_elects_critical_status_432(plan, y, elected_on)
        and elected_on <= add_calendar_period(certified_on, 30 calendar_day);
    then power ElectCriticalStatus432b4 {
        holder plan;
        over plan;
        exercise sponsor_elects_critical_status_432(plan, y, elected_on);
        valid_when projected_critical_status_within_5_years_432(plan, y);
        effect critical_status_by_election_432b4(plan, y);
    };
}
// (5) the improving-endangered-plan exception, (6) critical-and-declining
// status (needs an insolvency-projection horizon), and (7) special-
// financial-assistance deeming are NOT modelled this pass (TECH_GAP G380).
// The funding-improvement-plan (subsection (c)) and rehabilitation-plan
// (subsection (e)) ADOPTION DUTIES with their own windows are OUT OF SCOPE
// (G381): (b) is only the status-DETERMINATION subsection; the duties
// belong to (c)/(e), not reached this pass.
