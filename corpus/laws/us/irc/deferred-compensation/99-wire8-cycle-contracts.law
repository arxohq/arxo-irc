// Deferred compensation -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower packages `definitions` (section 7705(e)(3)) and `gross_income` (section 132(j)(6)) declare local contracts for section
// 414(q) classifications owned here and cannot import this package (it imports `gross_income`, and `gross_income` imports
// `definitions`; a direct import back would be an import cycle). The owner DERIVES the lower packages' `pub` relations from its own
// relations with qualified rule heads (Д-13 item 5); this package gains the direct import of `definitions` (acyclic: `definitions`
// reaches only `core`, `inflation_adjustments`, `temporal`). The case-fact channel stays valid: scenarios of the lower packages never
// load this package.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

use self::{
    Individual,
    Person,
    TaxableYear,
    employee_excluded_414q5,
    highly_compensated_employee,
};

rule W8ExcludedEmployeeForSection7705(i: Individual) strict {
    label en official "section 7705(e)(3): an individual who is an excluded employee within the meaning of section 414(q)(5) is this package's section 414(q)(5) excluded employee";
    when employee_excluded_414q5(i);
    then us.irc.definitions::excluded_employee_under_414q5(i);
}

// JUDGMENT CALL: the section 132(j)(6) classification carries no employer argument; an individual is highly compensated for it when
// the section 414(q) test is met with respect to some employer (the employer variable is existential).
rule W8HighlyCompensatedForSection132(employee: Individual, employer: Person, y: TaxableYear) strict {
    label en official "section 132(j)(6): a highly compensated employee within the meaning of section 414(q) is this package's section 414(q)(1) highly compensated employee";
    when highly_compensated_employee(employee, employer, y);
    then us.irc.gross_income::highly_compensated_individual_132(employee, y);
}
