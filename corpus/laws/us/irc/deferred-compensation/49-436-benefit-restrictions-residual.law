// Section 436 — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 16 (brief) and module 18 carry the AFTAP thresholds of (b) and (c), the
// payment and accrual limits of (d) and (e), the prefunding balance rule of
// (f)(2) and the presumption of (h)(1). This module adds the forward-looking
// test of (b)(1)(B) and (c)(1)(B), the cessation of the limits on a
// contribution ((b)(2), (c)(2)), the unpredictable contingent event benefit
// definition ((b)(3)), the formula exception of (c)(3), the definition of a
// prohibited payment ((d)(5)), the security of (f)(1), the first 5 plan years
// of (g), the presumption of (h)(3), the resumption of (i), the adjusted
// percentage of (j) and the applicability rules of (a) and (l).
//
// Method: percentages are compared by exact cross-multiplication of Money
// values; only the adjusted percentage of (j)(2), an output, is rounded (to
// 6 decimal places, HALF_UP).

use self::{
    DefinedBenefitPlan,
    IRC_S436_A,
    IRC_S436_B,
    IRC_S436_C,
    IRC_S436_D,
    IRC_S436_F,
    IRC_S436_G,
    IRC_S436_H,
    IRC_S436_I,
    IRC_S436_J,
    IRC_S436_L,
    Person,
    Plan,
    Section401a32PaymentKind,
    TaxableYear,
    adjusted_funding_target_attainment_percentage,
    funding_target_attainment_percentage_430,
    participates_in,
    plan_sponsor_412,
    unpredictable_contingent_event_benefit_restricted,
};

pub enum BenefitTrigger436 {
    PlantShutdown;
    OtherNonExcludedEvent;
    AgeAttainment;
    ServicePerformance;
    CompensationReceipt;
    Death;
    Disability;
}

pub enum PaymentKind436 {
    ExcessOverSingleLifeAnnuity;
    IrrevocableCommitmentPurchase;
    RegulationSpecified;
    OtherPayment;
}

pub enum SecurityForm436 {
    SuretyBond;
    EscrowedCash;
    EscrowedUsObligation;
    OtherSatisfactory;
}

// =====================================================================
// (l) and (a) Single-employer plans and the section 401(a)(29) treatment
// =====================================================================

pub relation plan_is_multiemployer_436l(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a multiemployer plan, case-asserted";
}

pub relation single_employer_plan_436l(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 436(l): a plan that is not a multiemployer plan";
}

@source(IRC_S436_L, relation = formalizes, coverage = exact, quote = "the term \"single-employer plan\" means a plan which is not a multiemployer plan")
rule SingleEmployerPlan436l(plan: DefinedBenefitPlan) strict {
    label en official "every defined benefit plan not shown to be multiemployer";
    when plan_sponsor_412(plan, _) and not_known(plan_is_multiemployer_436l(plan));
    then single_employer_plan_436l(plan);
}

pub relation csec_plan_436a(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is a CSEC plan, case-asserted";
}

pub relation plan_meets_subsection_436b(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan meets the requirements of subsection (b), case-asserted";
}

pub relation plan_meets_subsection_436c(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan meets the requirements of subsection (c), case-asserted";
}

pub relation plan_meets_subsection_436d(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan meets the requirements of subsection (d), case-asserted";
}

pub relation plan_meets_subsection_436e(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan meets the requirements of subsection (e), case-asserted";
}

pub relation plan_treated_as_meeting_436_for_401a29(plan: DefinedBenefitPlan) kind institutional {
    label en official "section 436(a): for section 401(a)(29) the plan is treated as meeting the section";
}

@source(IRC_S436_A, relation = formalizes, coverage = exact, quote = "a defined benefit plan which is a single-employer plan (other than a CSEC plan) shall be treated as meeting the requirements of this section if the plan meets the requirements of subsections (b), (c), (d), and (e)")
rule PlanTreatedAsMeeting436a(plan: DefinedBenefitPlan) strict {
    label en official "single-employer, not a CSEC plan, and (b), (c), (d) and (e) met";
    when single_employer_plan_436l(plan)
        and not_known(csec_plan_436a(plan))
        and plan_meets_subsection_436b(plan)
        and plan_meets_subsection_436c(plan)
        and plan_meets_subsection_436d(plan)
        and plan_meets_subsection_436e(plan);
    then plan_treated_as_meeting_436_for_401a29(plan);
}

// =====================================================================
// (b) and (c) Forward-looking test and cessation on contribution
// =====================================================================

pub relation adjusted_assets_436(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the plan assets used in the adjusted funding target attainment percentage, case-asserted";
}

pub relation adjusted_funding_target_436(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the funding target used in the adjusted funding target attainment percentage, case-asserted";
}

pub relation funding_target_increase_by_event_436b(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the increase in the funding target attributable to the occurrence of the event, case-asserted (section 436(b)(1))";
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "would be less than 60 percent taking into account such occurrence")
rule UnpredictableBenefitRestrictedByOccurrence436b1B(plan: DefinedBenefitPlan, participant: Person, y: TaxableYear, assets: Money, target: Money, inc: Money) defeasible {
    label en official "exact boundary: assets / (target + increase) below 0.60 by cross-multiplication; exactly 60 percent is not restricted";
    when participates_in(participant, plan)
        and adjusted_assets_436(plan, y, assets)
        and adjusted_funding_target_436(plan, y, target)
        and funding_target_increase_by_event_436b(plan, y, inc)
        and assets < (target + inc) * 0.60;
    then unpredictable_contingent_event_benefit_restricted(plan, participant, y);
}

pub relation sponsor_contribution_in_addition_436(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the contribution the plan sponsor pays in addition to any minimum required contribution under section 430, case-asserted";
}

pub relation unpredictable_restriction_ceases_436b2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(b)(2): the restriction ceases as of the first day of the plan year upon the additional contribution";
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "the amount of the increase in the funding target of the plan (under section 430) for the plan year attributable to the occurrence referred to in paragraph (1)")
rule UnpredictableRestrictionCeasesIncrease436b2A(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, inc: Money) strict {
    label en official "(A): a contribution at least the funding target increase";
    when sponsor_contribution_in_addition_436(plan, y, paid) and funding_target_increase_by_event_436b(plan, y, inc) and paid >= inc;
    then unpredictable_restriction_ceases_436b2(plan, y);
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "the amount sufficient to result in an adjusted funding target attainment percentage of 60 percent")
rule UnpredictableRestrictionCeasesTo60Percent436b2B(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, assets: Money, target: Money) strict {
    label en official "(B): assets plus the contribution reach 0.60 of the target; exact boundary";
    when sponsor_contribution_in_addition_436(plan, y, paid)
        and adjusted_assets_436(plan, y, assets)
        and adjusted_funding_target_436(plan, y, target)
        and assets + paid >= target * 0.60;
    then unpredictable_restriction_ceases_436b2(plan, y);
}

pub relation benefit_trigger_436b3(plan: DefinedBenefitPlan, participant: Person, trigger: BenefitTrigger436) kind empirical {
    label en unofficial "the event by reason of which the benefit is payable, case-asserted (section 436(b)(3))";
}

pub relation unpredictable_contingent_event_benefit_436b3(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 436(b)(3): a benefit payable solely by reason of a plant shutdown or another event that is not an age, service, compensation, death or disability event";
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "a plant shutdown (or similar event, as determined by the Secretary)")
rule UcebPlantShutdown436b3A(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(A)";
    when benefit_trigger_436b3(plan, participant, PlantShutdown);
    then unpredictable_contingent_event_benefit_436b3(plan, participant);
}

@source(IRC_S436_B, relation = formalizes, coverage = exact, quote = "an event other than the attainment of any age, performance of any service, receipt or derivation of any compensation, or occurrence of death or disability")
rule UcebOtherEvent436b3B(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(B)";
    when benefit_trigger_436b3(plan, participant, OtherNonExcludedEvent);
    then unpredictable_contingent_event_benefit_436b3(plan, participant);
}

pub relation funding_target_increase_by_amendment_436c(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the increase in the funding target attributable to the amendment, case-asserted (section 436(c))";
}

pub relation amendment_formula_not_compensation_based_436c3(plan: DefinedBenefitPlan, y: TaxableYear, rate: Decimal, wage_rate: Decimal) kind empirical {
    label en unofficial "the amendment increases benefits under a formula not based on compensation; the rate of increase and the contemporaneous rate of increase in average wages of the covered participants, case-asserted";
}

pub relation amendment_formula_exception_436c3(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(c)(3): the formula amendment exception";
}

@source(IRC_S436_C, relation = formalizes, coverage = exact, quote = "but only if the rate of such increase is not in excess of the contemporaneous rate of increase in average wages of participants covered by the amendment")
rule AmendmentFormulaException436c3(plan: DefinedBenefitPlan, y: TaxableYear, rate: Decimal, wage: Decimal) strict {
    label en official "exact boundary: a rate equal to the wage increase is not in excess of it";
    when amendment_formula_not_compensation_based_436c3(plan, y, rate, wage) and rate <= wage;
    then amendment_formula_exception_436c3(plan, y);
}

pub relation amendment_restriction_applies_436c1(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(c)(1): the amendment may not take effect when the AFTAP is, or with the amendment would be, below 80 percent, unless the formula exception applies";
}

@source(IRC_S436_C, relation = formalizes, coverage = exact, quote = "less than 80 percent")
rule AmendmentRestrictionByAftap436c1A(plan: DefinedBenefitPlan, y: TaxableYear, aftap: Decimal) defeasible {
    label en official "(A): strictly below 0.80; the (c)(3) exception withdraws it";
    when adjusted_funding_target_attainment_percentage(plan, y, aftap) and aftap < 0.80 and not_known(amendment_formula_exception_436c3(plan, y));
    then amendment_restriction_applies_436c1(plan, y);
}

@source(IRC_S436_C, relation = formalizes, coverage = exact, quote = "would be less than 80 percent taking into account such amendment")
rule AmendmentRestrictionByOccurrence436c1B(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money, inc: Money) strict {
    label en official "(B): assets / (target + increase) below 0.80 by cross-multiplication";
    when adjusted_assets_436(plan, y, assets)
        and adjusted_funding_target_436(plan, y, target)
        and funding_target_increase_by_amendment_436c(plan, y, inc)
        and assets < (target + inc) * 0.80
        and not_known(amendment_formula_exception_436c3(plan, y));
    then amendment_restriction_applies_436c1(plan, y);
}

pub relation amendment_restriction_ceases_436c2(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(c)(2): the restriction ceases upon the additional contribution";
}

@source(IRC_S436_C, relation = formalizes, coverage = exact, quote = "the amount of the increase in the funding target of the plan (under section 430) for the plan year attributable to the amendment")
rule AmendmentRestrictionCeasesIncrease436c2A(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, inc: Money) strict {
    label en official "(A): a contribution at least the funding target increase";
    when sponsor_contribution_in_addition_436(plan, y, paid) and funding_target_increase_by_amendment_436c(plan, y, inc) and paid >= inc;
    then amendment_restriction_ceases_436c2(plan, y);
}

@source(IRC_S436_C, relation = formalizes, coverage = exact, quote = "the amount sufficient to result in an adjusted funding target attainment percentage of 80 percent")
rule AmendmentRestrictionCeasesTo80Percent436c2B(plan: DefinedBenefitPlan, y: TaxableYear, paid: Money, assets: Money, target: Money) strict {
    label en official "(B): assets plus the contribution reach 0.80 of the target; exact boundary";
    when sponsor_contribution_in_addition_436(plan, y, paid)
        and adjusted_assets_436(plan, y, assets)
        and adjusted_funding_target_436(plan, y, target)
        and assets + paid >= target * 0.80;
    then amendment_restriction_ceases_436c2(plan, y);
}

// =====================================================================
// (d)(5) Prohibited payment
// =====================================================================

pub relation payment_kind_436d5(plan: DefinedBenefitPlan, participant: Person, kind: PaymentKind436) kind empirical {
    label en unofficial "the kind of payment, case-asserted (section 436(d)(5))";
}

pub relation annuity_starting_date_in_limitation_period_436d5A(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the participant's annuity starting date occurs during a period a limitation under (d)(1) or (d)(2) is in effect, case-asserted";
}

pub relation payment_distributable_without_consent_411a11_436d5(plan: DefinedBenefitPlan, participant: Person) kind empirical {
    label en unofficial "the payment may under section 411(a)(11) be immediately distributed without the consent of the participant, case-asserted";
}

pub relation prohibited_payment_436d5(plan: DefinedBenefitPlan, participant: Person) kind institutional {
    label en official "section 436(d)(5): a prohibited payment";
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "any payment, in excess of the monthly amount paid under a single life annuity (plus any social security supplements described in the last sentence of section 411(a)(9))")
rule ProhibitedPaymentExcess436d5A(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(A): an excess over the single life annuity with an annuity starting date in a limitation period; the 411(a)(11) payment is excluded";
    when payment_kind_436d5(plan, participant, ExcessOverSingleLifeAnnuity)
        and annuity_starting_date_in_limitation_period_436d5A(plan, participant)
        and not_known(payment_distributable_without_consent_411a11_436d5(plan, participant));
    then prohibited_payment_436d5(plan, participant);
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "any payment for the purchase of an irrevocable commitment from an insurer to pay benefits")
rule ProhibitedPaymentCommitment436d5B(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(B)";
    when payment_kind_436d5(plan, participant, IrrevocableCommitmentPurchase) and not_known(payment_distributable_without_consent_411a11_436d5(plan, participant));
    then prohibited_payment_436d5(plan, participant);
}

@source(IRC_S436_D, relation = formalizes, coverage = exact, quote = "any other payment specified by the Secretary by regulations")
rule ProhibitedPaymentRegulation436d5C(plan: DefinedBenefitPlan, participant: Person) strict {
    label en official "(C): a payment the regulations specify (case-asserted kind)";
    when payment_kind_436d5(plan, participant, RegulationSpecified) and not_known(payment_distributable_without_consent_411a11_436d5(plan, participant));
    then prohibited_payment_436d5(plan, participant);
}

// =====================================================================
// (f)(1) Security
// =====================================================================

pub relation security_provided_436f1(plan: DefinedBenefitPlan, y: TaxableYear, form: SecurityForm436, amount: Money) kind empirical {
    label en unofficial "the security the plan sponsor provides, its form and amount, case-asserted (section 436(f)(1))";
}

pub relation escrowed_obligation_maturity_years_436f1B(plan: DefinedBenefitPlan, y: TaxableYear, years: Decimal) kind empirical {
    label en unofficial "the remaining maturity in years of the escrowed United States obligations, case-asserted";
}

pub relation qualifying_security_436f1(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 436(f)(1)(B): a security in an accepted form, treated as a plan asset";
}

@source(IRC_S436_F, relation = formalizes, coverage = partial, quote = "a bond issued by a corporate surety company that is an acceptable surety for purposes of section 412 of the Employee Retirement Income Security Act of 1974")
rule QualifyingSecuritySurety436f1Bi(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: (i) a surety bond; the acceptability of the surety is case-asserted by the form";
    when security_provided_436f1(plan, y, SuretyBond, amount);
    then qualifying_security_436f1(plan, y, amount);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "cash, or United States obligations which mature in 3 years or less, held in escrow by a bank or similar financial institution")
rule QualifyingSecurityEscrowCash436f1Bii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "(ii) cash in escrow";
    when security_provided_436f1(plan, y, EscrowedCash, amount);
    then qualifying_security_436f1(plan, y, amount);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "United States obligations which mature in 3 years or less")
rule QualifyingSecurityEscrowObligation436f1Bii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money, years: Decimal) strict {
    label en official "(ii) United States obligations maturing in 3 years or less; exact boundary: 3 years qualifies";
    when security_provided_436f1(plan, y, EscrowedUsObligation, amount) and escrowed_obligation_maturity_years_436f1B(plan, y, years) and years <= 3.0;
    then qualifying_security_436f1(plan, y, amount);
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "such other form of security as is satisfactory to the Secretary and the parties involved")
rule QualifyingSecurityOther436f1Biii(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) strict {
    label en official "(iii) another form the Secretary and the parties accept (case-asserted by the form)";
    when security_provided_436f1(plan, y, OtherSatisfactory, amount);
    then qualifying_security_436f1(plan, y, amount);
}

pub relation adjusted_assets_with_security_436f1A(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 436(f)(1)(A): the security is treated as an asset in determining the adjusted percentage";
}

@source(IRC_S436_F, relation = formalizes, coverage = exact, quote = "the adjusted funding target attainment percentage shall be determined by treating as an asset of the plan any security provided by a plan sponsor")
rule AdjustedAssetsWithSecurity436f1A(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, security: Money) strict {
    label en official "assets plus the qualifying security";
    when adjusted_assets_436(plan, y, assets) and qualifying_security_436f1(plan, y, security);
    then adjusted_assets_with_security_436f1A(plan, y, assets + security);
}

pub relation security_trigger_date_436f1C(plan: DefinedBenefitPlan, y: TaxableYear, kind: SecurityTrigger436, on: Date) kind empirical {
    label en unofficial "the date of an event that allows the security to be perfected and enforced, case-asserted (section 436(f)(1)(C))";
}

pub enum SecurityTrigger436 {
    PlanTermination;
    MissedMinimumContribution;
    SevenYearsBelow60Percent;
}

pub relation security_enforceable_from_436f1C(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 436(f)(1)(C): the security may be perfected and enforced from an event date (the earliest of the case-asserted event dates is the operative one)";
}

@source(IRC_S436_F, relation = formalizes, coverage = partial, quote = "Any security provided under subparagraph (A) may be perfected and enforced at any time after the earlier of")
rule SecurityEnforceableFromEvent436f1C(plan: DefinedBenefitPlan, y: TaxableYear, kind: SecurityTrigger436, on: Date) strict {
    label en official "PARTIAL: each event date is derived as a date from which enforcement is possible; the choice of the earliest is left to the case";
    when security_trigger_date_436f1C(plan, y, kind, on);
    then security_enforceable_from_436f1C(plan, y, on);
}

// =====================================================================
// (g) First 5 plan years
// =====================================================================

pub relation plan_year_ordinal_with_predecessors_436g(plan: DefinedBenefitPlan, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "the ordinal of the plan year counting the years of any predecessor plan, case-asserted (section 436(g))";
}

pub relation subsections_bce_do_not_apply_436g(plan: DefinedBenefitPlan, y: TaxableYear) kind institutional {
    label en official "section 436(g): subsections (b), (c) and (e) do not apply in the first 5 plan years";
}

@source(IRC_S436_G, relation = formalizes, coverage = exact, quote = "Subsections (b), (c), and (e) shall not apply to a plan for the first 5 plan years of the plan")
rule FirstFivePlanYears436g(plan: DefinedBenefitPlan, y: TaxableYear, n: Integer) strict {
    label en official "exact boundary: the 5th plan year is inside, the 6th is outside";
    when plan_year_ordinal_with_predecessors_436g(plan, y, n) and n <= 5;
    then subsections_bce_do_not_apply_436g(plan, y);
}

// =====================================================================
// (h)(3) Presumption when the actuary has not certified
// =====================================================================

pub relation preceding_year_aftap_436h3(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal, trigger_pct: Decimal) kind empirical {
    label en unofficial "the adjusted percentage for the preceding plan year and the percentage that would have caused the benefit limitation to apply for that year, case-asserted (section 436(h)(3)(A))";
}

pub relation limitation_did_not_apply_preceding_year_436h3A(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "a benefit limitation under subsection (b), (c), (d) or (e) did not apply to the plan for the preceding plan year, case-asserted";
}

pub relation actuary_certified_by_fourth_month_436h3B(plan: DefinedBenefitPlan, y: TaxableYear) kind empirical {
    label en unofficial "the enrolled actuary has certified the actual percentage as of the first day of the 4th month of the plan year, case-asserted";
}

pub relation plan_year_first_day_436h3(plan: DefinedBenefitPlan, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted";
}

pub relation presumed_aftap_436h3(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 436(h)(3): until certified, the percentage is presumed to be 10 percentage points less than the preceding year's";
}

@source(IRC_S436_H, relation = formalizes, coverage = exact, quote = "the adjusted funding target attainment percentage of the plan as of such first day shall, for purposes of such subsection, be presumed to be equal to 10 percentage points less than the adjusted funding target attainment percentage of the plan for such preceding plan year")
rule PresumedAftap436h3(plan: DefinedBenefitPlan, y: TaxableYear, prev: Decimal, trigger: Decimal) strict {
    label en official "exact boundary: a margin of exactly 10 points over the trigger qualifies; the presumed value is prev - 0.10";
    when preceding_year_aftap_436h3(plan, y, prev, trigger)
        and limitation_did_not_apply_preceding_year_436h3A(plan, y)
        and prev - trigger <= 0.10
        and not_known(actuary_certified_by_fourth_month_436h3B(plan, y));
    then presumed_aftap_436h3(plan, y, prev - 0.10);
}

pub relation deemed_valuation_date_436h3(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 436(h)(3): until the actuary certifies, the first day of the 4th month is the deemed valuation date";
}

@source(IRC_S436_H, relation = formalizes, coverage = exact, quote = "until the enrolled actuary so certifies, such first day shall be deemed, for purposes of such subsection, to be the valuation date of the plan for the current plan year")
rule DeemedValuationDate436h3(plan: DefinedBenefitPlan, y: TaxableYear, start: Date, prev: Decimal, trigger: Decimal) strict {
    label en official "the first day of the 4th month: three calendar months after the plan year start";
    when plan_year_first_day_436h3(plan, y, start)
        and preceding_year_aftap_436h3(plan, y, prev, trigger)
        and limitation_did_not_apply_preceding_year_436h3A(plan, y)
        and prev - trigger <= 0.10
        and not_known(actuary_certified_by_fourth_month_436h3B(plan, y));
    then deemed_valuation_date_436h3(plan, y, add_calendar_period(start, 3 calendar_month));
}

// =====================================================================
// (i) Resumption
// =====================================================================

pub relation limitation_period_close_436i(plan: DefinedBenefitPlan, y: TaxableYear, close: Date) kind empirical {
    label en unofficial "the close of the period for which a limitation of payment or accrual under (d) or (e) applies, case-asserted";
}

pub relation plan_provides_otherwise_436i1(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan provides that payments and accruals do not resume automatically, case-asserted";
}

pub relation resumption_date_436i1(plan: DefinedBenefitPlan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 436(i)(1): payments and accruals resume the day after the limitation period closes";
}

@source(IRC_S436_I, relation = formalizes, coverage = exact, quote = "payments and accruals will resume effective as of the day following the close of the period for which any limitation of payment or accrual of benefits under subsection (d) or (e) applies")
rule ResumptionDate436i1(plan: DefinedBenefitPlan, y: TaxableYear, close: Date) strict {
    label en official "close + 1 day unless the plan provides otherwise";
    when limitation_period_close_436i(plan, y, close) and not_known(plan_provides_otherwise_436i1(plan));
    then resumption_date_436i1(plan, y, add_calendar_period(close, 1 calendar_day));
}

// =====================================================================
// (j) Adjusted percentage
// =====================================================================

pub relation funding_target_and_assets_430d2_436j(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money) kind empirical {
    label en unofficial "the amounts of section 430(d)(2)(A) and (B) (the assets and the funding target), case-asserted";
}

pub relation annuity_purchases_for_nonhighly_compensated_436j2(plan: DefinedBenefitPlan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate amount of purchases of annuities for employees other than highly compensated employees made by the plan during the preceding 2 plan years, case-asserted";
}

pub relation adjusted_aftap_computed_436j2(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 436(j)(2): the percentage with both amounts increased by the annuity purchases (INTERPRETATION: rounded to 6 decimal places, HALF_UP)";
}

@source(IRC_S436_J, relation = formalizes, coverage = partial, quote = "the funding target attainment percentage which is determined under paragraph (1) by increasing each of the amounts under subparagraphs (A) and (B) of section 430(d)(2) by the aggregate amount of purchases of annuities")
rule AdjustedAftapComputed436j2(plan: DefinedBenefitPlan, y: TaxableYear, assets: Money, target: Money, purchases: Money) strict {
    label en official "PARTIAL: (assets + purchases) / (target + purchases); the preceding 2 plan years window is case-asserted";
    when funding_target_and_assets_430d2_436j(plan, y, assets, target)
        and annuity_purchases_for_nonhighly_compensated_436j2(plan, y, purchases)
        and target + purchases > 0.00 USD;
    then adjusted_aftap_computed_436j2(plan, y, div_round(assets + purchases, target + purchases, 6, "HALF_UP"));
}

pub relation ftap_without_430f4_reduction_436j3(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind empirical {
    label en unofficial "the funding target attainment percentage determined without regard to the reduction of assets under section 430(f)(4), case-asserted";
}

pub relation ftap_used_436j3(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 436(j)(3): the percentage determined without the section 430(f)(4) reduction when it is 100 percent or more";
}

@source(IRC_S436_J, relation = formalizes, coverage = exact, quote = "if the funding target attainment percentage is 100 percent or more (determined without regard to the reduction in the value of assets under section 430(f)(4))")
rule FtapUsedWithoutReduction436j3(plan: DefinedBenefitPlan, y: TaxableYear, without: Decimal) strict {
    label en official "exact boundary: exactly 100 percent uses the unreduced percentage";
    when ftap_without_430f4_reduction_436j3(plan, y, without) and without >= 1.00;
    then ftap_used_436j3(plan, y, without);
}

@source(IRC_S436_J, relation = formalizes, coverage = partial, quote = "the funding target attainment percentage for purposes of paragraphs (1) and (2) shall be determined without regard to such reduction")
rule FtapUsedWithReduction436j3(plan: DefinedBenefitPlan, y: TaxableYear, pct: Decimal, without: Decimal) strict {
    label en official "PARTIAL: below 100 percent the reduced percentage of section 430 applies (case-asserted)";
    when funding_target_attainment_percentage_430(plan, y, pct) and ftap_without_430f4_reduction_436j3(plan, y, without) and without < 1.00;
    then ftap_used_436j3(plan, y, pct);
}
