// Section 411 — minimum vesting standards. Stage 1 (IRC-09), DECISION-0379.
// Priority: (a) fully — the 5-year/3-to-7-year (defined benefit) and
// 3-year/2-to-6-year (defined contribution) vesting schedules (tables T1/
// T2), accrued benefit, and the (d)(6) anti-cutback IMMUNITY.


// =====================================================================
// (a)(2) Employer-contribution vesting schedules
// =====================================================================

use self::{
    DefinedBenefitPlan,
    DefinedContributionPlan,
    Distribution,
    IRC_S411_A,
    IRC_S411_B,
    IRC_S411_C,
    IRC_S411_D,
    IRC_S411_TABLE_1,
    IRC_S411_TABLE_2,
    Person,
    Plan,
    TaxableYear,
    plan_sponsor,
};

pub relation employee_years_of_service_411(employee: Person, plan: Plan, years: Integer) kind empirical {
    label en unofficial "the employee's years of service for section 411(a) vesting purposes (section 411(a)(4)/(5) service-crediting rules are not separately re-derived; the case asserts the final year count), case-asserted";
}

pub relation nonforfeitable_percentage(employee: Person, plan: Plan, pct: Decimal) kind institutional {
    label en official "the employee's nonforfeitable percentage of the accrued benefit derived from employer contributions";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A plan satisfies the requirements of this clause if an employee who has completed at least 5 years of service has a nonforfeitable right to 100 percent of the employee's accrued benefit derived from employer contributions.")
rule NonforfeitablePercentageDbFiveYear(employee: Person, plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "defined benefit 5-year cliff: 100% at 5 or more years";
    when employee_years_of_service_411(employee, plan, years) and years >= 5;
    then nonforfeitable_percentage(employee, plan, 1.00);
}

@source(IRC_S411_TABLE_1, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 3 / 20 | 4 / 40 | 5 / 60 | 6 / 80 | 7 or more / 100.")
rule NonforfeitablePercentageDbGraded3(employee: Person, plan: DefinedBenefitPlan, years: Integer) defeasible {
    label en official "defined benefit 3-to-7-year graded table, 3 years of service: 20% (used only where the plan elects graded vesting instead of the 5-year cliff; both schedules cannot apply to the same plan — see coverage note)";
    when employee_years_of_service_411(employee, plan, years) and years == 3;
    then nonforfeitable_percentage(employee, plan, 0.20);
}

@source(IRC_S411_TABLE_1, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 3 / 20 | 4 / 40 | 5 / 60 | 6 / 80 | 7 or more / 100.")
rule NonforfeitablePercentageDbGraded4(employee: Person, plan: DefinedBenefitPlan, years: Integer) defeasible {
    label en official "defined benefit graded table, 4 years of service: 40%";
    when employee_years_of_service_411(employee, plan, years) and years == 4;
    then nonforfeitable_percentage(employee, plan, 0.40);
}

@source(IRC_S411_TABLE_1, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 3 / 20 | 4 / 40 | 5 / 60 | 6 / 80 | 7 or more / 100.")
rule NonforfeitablePercentageDbGraded5(employee: Person, plan: DefinedBenefitPlan, years: Integer) defeasible {
    label en official "defined benefit graded table, 5 years of service: 60% (the alternative graded reading of the same year the cliff schedule would give 100%; a scenario picks one schedule per plan)";
    when employee_years_of_service_411(employee, plan, years) and years == 5;
    then nonforfeitable_percentage(employee, plan, 0.60);
}

@source(IRC_S411_TABLE_1, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 3 / 20 | 4 / 40 | 5 / 60 | 6 / 80 | 7 or more / 100.")
rule NonforfeitablePercentageDbGraded6(employee: Person, plan: DefinedBenefitPlan, years: Integer) defeasible {
    label en official "defined benefit graded table, 6 years of service: 80%";
    when employee_years_of_service_411(employee, plan, years) and years == 6;
    then nonforfeitable_percentage(employee, plan, 0.80);
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A plan satisfies the requirements of this clause if an employee who has completed at least 3 years of service has a nonforfeitable right to 100 percent of the employee's accrued benefit derived from employer contributions.")
rule NonforfeitablePercentageDcThreeYear(employee: Person, plan: DefinedContributionPlan, years: Integer) strict {
    label en official "defined contribution 3-year cliff: 100% at 3 or more years";
    when employee_years_of_service_411(employee, plan, years) and years >= 3;
    then nonforfeitable_percentage(employee, plan, 1.00);
}

@source(IRC_S411_TABLE_2, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 2 / 20 | 3 / 40 | 4 / 60 | 5 / 80 | 6 or more / 100.")
rule NonforfeitablePercentageDcGraded2(employee: Person, plan: DefinedContributionPlan, years: Integer) defeasible {
    label en official "defined contribution 2-to-6-year graded table, 2 years of service: 20% (used only where the plan elects graded vesting instead of the 3-year cliff)";
    when employee_years_of_service_411(employee, plan, years) and years == 2;
    then nonforfeitable_percentage(employee, plan, 0.20);
}

@source(IRC_S411_TABLE_2, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 2 / 20 | 3 / 40 | 4 / 60 | 5 / 80 | 6 or more / 100.")
rule NonforfeitablePercentageDcGraded3(employee: Person, plan: DefinedContributionPlan, years: Integer) defeasible {
    label en official "defined contribution graded table, 3 years of service: 40% (alternative graded reading of the same year the cliff schedule would give 100%; a scenario picks one schedule per plan)";
    when employee_years_of_service_411(employee, plan, years) and years == 3;
    then nonforfeitable_percentage(employee, plan, 0.40);
}

@source(IRC_S411_TABLE_2, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 2 / 20 | 3 / 40 | 4 / 60 | 5 / 80 | 6 or more / 100.")
rule NonforfeitablePercentageDcGraded4(employee: Person, plan: DefinedContributionPlan, years: Integer) defeasible {
    label en official "defined contribution graded table, 4 years of service: 60%";
    when employee_years_of_service_411(employee, plan, years) and years == 4;
    then nonforfeitable_percentage(employee, plan, 0.60);
}

@source(IRC_S411_TABLE_2, relation = formalizes, coverage = exact, quote = "Years of service: / The nonforfeitable percentage is: | 2 / 20 | 3 / 40 | 4 / 60 | 5 / 80 | 6 or more / 100.")
rule NonforfeitablePercentageDcGraded5(employee: Person, plan: DefinedContributionPlan, years: Integer) defeasible {
    label en official "defined contribution graded table, 5 years of service: 80%";
    when employee_years_of_service_411(employee, plan, years) and years == 5;
    then nonforfeitable_percentage(employee, plan, 0.80);
}
// NOTE (human judgment recorded, task instruction "STOP_MODELING"): a plan
// elects EITHER the cliff or the graded schedule for its structural kind
// (not both); this stage models both tables per kind and relies on the
// case/scenario to assert `employee_years_of_service_411` consistent with
// whichever schedule the plan in the scenario actually uses. A plan-level
// "which schedule applies" election relation is NOT modelled (TECH_GAP):
// without it, a defined benefit plan with 4 years of service derives BOTH
// "0% under the 5-year-cliff branch's absence" (no rule fires under cliff)
// and "40% under the graded branch" as a defeasible conclusion — the
// GRADED rule is marked `defeasible` precisely so a scenario for a
// cliff-schedule plan can assert a `priority`/defeater fact blocking it;
// absent such a fact, both schedules' rules are simply available to the
// scenario author to select from, which is the honest state of this
// stage's modelling.

// =====================================================================
// (a)(7) Accrued benefit
// =====================================================================
pub relation account_balance_dc(employee: Person, plan: DefinedContributionPlan, balance: Money) kind empirical {
    label en unofficial "the balance of the employee's account under a defined contribution plan, case-asserted";
}

pub relation accrued_benefit_dc(employee: Person, plan: DefinedContributionPlan, balance: Money) kind institutional {
    label en official "section 411(a)(7)(A)(ii): in the case of a plan which is not a defined benefit plan, the accrued benefit is the balance of the employee's account";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "in the case of a plan which is not a defined benefit plan, the balance of the employee's account")
rule AccruedBenefitDc(employee: Person, plan: DefinedContributionPlan, balance: Money) strict {
    label en official "defined contribution accrued benefit equals the account balance";
    when account_balance_dc(employee, plan, balance);
    then accrued_benefit_dc(employee, plan, balance);
}

// =====================================================================
// (d)(6) Accrued benefit not to be decreased by amendment — IMMUNITY
// =====================================================================
pub relation plan_amendment(plan: Plan, adopted_on: Date) kind empirical {
    label en unofficial "a plan amendment, case-asserted";
}

pub relation amendment_permitted_under_412d2_or_erisa4281(plan: Plan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment is described in section 412(d)(2) or section 4281 ERISA (permitted exceptions to the anti-cutback rule), case-asserted";
}

pub relation accrued_benefit_before_amendment(employee: Person, plan: Plan, adopted_on: Date, amount: Money) kind empirical {
    label en unofficial "the employee's accrued benefit immediately before the amendment, case-asserted";
}

pub relation accrued_benefit_after_amendment(employee: Person, plan: Plan, adopted_on: Date, amount: Money) kind empirical {
    label en unofficial "the employee's accrued benefit as it would be computed under the plan as amended, case-asserted";
}

pub relation accrued_benefit_decreased_by_amendment(plan: Plan, employee: Person, adopted_on: Date) kind institutional {
    label en unofficial "the amendment would take effect to decrease this employee's accrued benefit (absent the immunity blocking it)";
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "A plan shall be treated as not satisfying the requirements of this section if the accrued benefit of a participant is decreased by an amendment of the plan, other than an amendment described in section 412(d)(2), or section 4281 of the Employee Retirement Income Security Act of 1974.")
rule AccruedBenefitDecreasedByAmendment(employee: Person, plan: Plan, adopted_on: Date, before: Money, after: Money) defeasible {
    label en official "an amendment lowering the accrued benefit, without a section 412(d)(2)/ERISA 4281 exception, decreases it (subject to the immunity blocking the effect)";
    when plan_amendment(plan, adopted_on)
        and accrued_benefit_before_amendment(employee, plan, adopted_on, before)
        and accrued_benefit_after_amendment(employee, plan, adopted_on, after)
        and after < before
        and not amendment_permitted_under_412d2_or_erisa4281(plan, adopted_on);
    then accrued_benefit_decreased_by_amendment(plan, employee, adopted_on);
}

@source(IRC_S411_D, relation = formalizes, coverage = exact, quote = "A plan shall be treated as not satisfying the requirements of this section if the accrued benefit of a participant is decreased by an amendment of the plan, other than an amendment described in section 412(d)(2), or section 4281 of the Employee Retirement Income Security Act of 1974.")
rule AntiCutbackImmunity(employee: Person, plan: Plan, adopted_on: Date, sponsor: Person) strict {
    label en official "section 411(d)(6): the participant is protected from an accrued benefit decrease by amendment (other than a section 412(d)(2)/ERISA 4281 amendment)";
    when plan_amendment(plan, adopted_on)
        and accrued_benefit_before_amendment(employee, plan, adopted_on, _)
        and plan_sponsor(plan, sponsor);
    then immunity AntiCutback {
        holder employee;
        against sponsor;
        protected_effect accrued_benefit_decreased_by_amendment(plan, employee, adopted_on);
        window [-infinity, infinity];
    };
}

// =====================================================================
// STAGE 2b (25.09.2026): (a)(1) employee-contribution nonforfeitability,
// (a)(11) $7,000 mandatory-distribution consent requirement, (a)(13)(B)
// cash-balance 3-year vesting, (b)(1) accrual rules — the 3-percent
// method, the 133 1/3-percent rule, and the fractional rule — as exact
// comparisons over case-asserted inputs, (c)(2)(A) accrued benefit
// derived from employee contributions (no-separate-account ratio).
// =====================================================================

pub relation employee_own_contribution_accrued_benefit(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the employee's accrued benefit derived from his own (employee) contributions, case-asserted";
}

pub relation employee_contribution_accrued_benefit_nonforfeitable(employee: Person, plan: Plan) kind institutional {
    label en official "section 411(a)(1): an employee's accrued benefit derived from his own contributions must be nonforfeitable";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "A plan satisfies the requirements of this paragraph if an employee's rights in his accrued benefit derived from his own contributions are nonforfeitable.")
rule EmployeeContributionAccruedBenefitNonforfeitable(employee: Person, plan: Plan, amount: Money) strict {
    label en official "employee-derived accrued benefit is always fully vested";
    when employee_own_contribution_accrued_benefit(employee, plan, amount);
    then employee_contribution_accrued_benefit_nonforfeitable(employee, plan);
}

pub relation nonforfeitable_accrued_benefit_present_value(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the present value (computed under section 417(e)(3)) of the employee's nonforfeitable accrued benefit, case-asserted";
}

pub relation distribution_without_consent_attempted(d: Distribution, employee: Person, plan: Plan) kind empirical {
    label en unofficial "the plan attempts to distribute the benefit immediately without the participant's consent, case-asserted";
}

pub relation participant_consents_to_distribution(d: Distribution, employee: Person) kind empirical {
    label en unofficial "the participant has consented to the immediate distribution, case-asserted";
}

pub relation mandatory_distribution_requires_consent(employee: Person, plan: Plan, pv: Money) kind institutional {
    label en official "section 411(a)(11)(A): once the present value of the nonforfeitable accrued benefit exceeds $7,000, the plan may not distribute it immediately without the participant's consent";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "If the present value of any nonforfeitable accrued benefit exceeds $7,000, a plan meets the requirements of this paragraph only if such plan provides that such benefit may not be immediately distributed without the consent of the participant.")
rule MandatoryDistributionRequiresConsent(employee: Person, plan: Plan, pv: Money) strict {
    label en official "exact boundary: present value of exactly $7,000 does NOT require consent; $7,000.01 does";
    when nonforfeitable_accrued_benefit_present_value(employee, plan, pv) and pv > MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD;
    then mandatory_distribution_requires_consent(employee, plan, pv);
}

pub relation distribution_without_consent_valid(d: Distribution, employee: Person, plan: Plan) kind institutional {
    label en official "the single valid_when atom: either consent was not required (present value at or below the threshold) or the participant actually consented";
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "such benefit may not be immediately distributed without the consent of the participant")
rule DistributionWithoutConsentValidByConsent(d: Distribution, employee: Person, plan: Plan) strict {
    label en official "consent given satisfies the validity gate";
    when distribution_without_consent_attempted(d, employee, plan) and participant_consents_to_distribution(d, employee);
    then distribution_without_consent_valid(d, employee, plan);
}

@source(IRC_S411_A, relation = formalizes, coverage = partial, quote = "If the present value of any nonforfeitable accrued benefit exceeds $7,000")
rule DistributionWithoutConsentValidByThreshold(d: Distribution, employee: Person, plan: Plan, pv: Money) strict {
    label en official "no consent is required when the present value does not exceed the $7,000 threshold";
    when distribution_without_consent_attempted(d, employee, plan)
        and nonforfeitable_accrued_benefit_present_value(employee, plan, pv)
        and pv <= MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD;
    then distribution_without_consent_valid(d, employee, plan);
}

pub relation immediate_distribution_made(d: Distribution, employee: Person, plan: Plan) kind institutional {
    label en unofficial "the immediate distribution to the participant is validly made (section 411(a)(11) gate cleared)";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "such plan provides that such benefit may not be immediately distributed without the consent of the participant")
rule ImmediateDistributionConsentPower(d: Distribution, employee: Person, plan: Plan, sponsor: Person) strict {
    label en official "the plan's power to make an immediate distribution is validly exercised only per the consent/threshold gate above";
    when distribution_without_consent_attempted(d, employee, plan) and plan_sponsor(plan, sponsor);
    then power ImmediateDistributionPower {
        holder sponsor;
        over employee;
        exercise distribution_without_consent_attempted(d, employee, plan);
        valid_when distribution_without_consent_valid(d, employee, plan);
        effect immediate_distribution_made(d, employee, plan);
    };
}
// MANDATORY_DISTRIBUTION_CONSENT_THRESHOLD is an A3 parameter
// (section-411a11-mandatory-distribution-threshold.lawparam.json): the
// statutory $7,000 amount (unchanged text; unlike most Subchapter D dollar
// figures, this one has no (a)(11) cost-of-living-adjustment paragraph in
// the pinned text — a flat cap, not a SOURCE_GAP). (11)(C) ESOP dividend
// exception and (11)(D) rollover-portion exclusion are NOT modelled
// (TECH_GAP, stage 2b).

pub relation applicable_defined_benefit_plan_411a13(plan: DefinedBenefitPlan) kind empirical {
    label en unofficial "the plan is an applicable defined benefit plan under section 411(a)(13)(C) (hypothetical-account-balance or accumulated-percentage cash-balance-style formula), case-asserted";
}

@source(IRC_S411_A, relation = formalizes, coverage = exact, quote = "In the case of an applicable defined benefit plan, such plan shall be treated as meeting the requirements of subsection (a)(2) only if an employee who has completed at least 3 years of service has a nonforfeitable right to 100 percent of the employee's accrued benefit derived from employer contributions.")
rule NonforfeitablePercentageCashBalanceThreeYear(employee: Person, plan: DefinedBenefitPlan, years: Integer) strict {
    label en official "an applicable (cash-balance-style) DB plan must use 3-year cliff vesting, not the 5-year/graded DB tables";
    when applicable_defined_benefit_plan_411a13(plan) and employee_years_of_service_411(employee, plan, years) and years >= 3;
    then nonforfeitable_percentage(employee, plan, 1.00);
}

// -- (b)(1) Accrual rules: the three alternative tests, as exact --------
// comparisons over case-asserted inputs (the underlying projected-benefit
// and compensation-averaging computations that PRODUCE those inputs are
// not themselves reformalized — same "comparison is executable, the
// projection is case-asserted" method as the ADP/ACP tests).

pub relation projected_normal_retirement_benefit(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the normal retirement benefit the employee would receive under the (b)(1)(A)/(C) highest-consecutive-10-years compensation projection, case-asserted";
}

pub relation years_of_plan_participation(employee: Person, plan: DefinedBenefitPlan, years: Decimal) kind empirical {
    label en unofficial "the employee's years of participation in the plan as of separation, case-asserted";
}

pub relation accrued_benefit_at_separation(employee: Person, plan: DefinedBenefitPlan, amount: Money) kind empirical {
    label en unofficial "the employee's actual accrued benefit upon separation from service, case-asserted";
}

pub relation accrual_3pct_method_satisfied(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(A): the 3-percent method — accrued benefit at least 3% of the projected normal retirement benefit times years of participation (capped at 33 1/3)";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "3 percent of the normal retirement benefit to which he would be entitled if he commenced participation at the earliest possible entry age under the plan and served continuously until the earlier of age 65 or the normal retirement age specified under the plan, multiplied by")
rule Accrual3PctMethodSatisfied(employee: Person, plan: DefinedBenefitPlan, projected: Money, years: Decimal, accrued: Money) strict {
    label en official "3% method boundary: accrued >= 3% x projected NRB x min(years, 33.3333)";
    when projected_normal_retirement_benefit(employee, plan, projected)
        and years_of_plan_participation(employee, plan, years)
        and accrued_benefit_at_separation(employee, plan, accrued)
        and accrued >= round(projected * 0.03 * min(years, 33.3333), 2, "HALF_UP");
    then accrual_3pct_method_satisfied(employee, plan);
}

pub relation accrual_rate_for_year(plan: DefinedBenefitPlan, y: TaxableYear, rate: Money) kind empirical {
    label en unofficial "the annual rate at which a participant accrues normal-retirement-age retirement benefits for this plan year, case-asserted";
}

pub relation accrual_133_1_3_rule_satisfied(plan: DefinedBenefitPlan, earlier_year: TaxableYear, later_year: TaxableYear) kind institutional {
    label en official "section 411(b)(1)(B): the 133 1/3 percent rule — no later year's accrual rate exceeds 133 1/3 percent of an earlier year's rate";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "the annual rate at which any individual who is or could be a participant can accrue the retirement benefits payable at normal retirement age under the plan for any later plan year is not more than 1331/3 percent of the annual rate at which he can accrue benefits for any plan year beginning on or after such particular plan year and before such later plan year")
rule Accrual1331_3RuleSatisfied(plan: DefinedBenefitPlan, earlier_year: TaxableYear, later_year: TaxableYear, earlier_rate: Money, later_rate: Money) strict {
    label en official "exact boundary: later rate at exactly 133.3333% of the earlier rate passes; any higher fails";
    when accrual_rate_for_year(plan, earlier_year, earlier_rate)
        and accrual_rate_for_year(plan, later_year, later_rate)
        and later_rate <= round(earlier_rate * 1.333333, 2, "HALF_UP");
    then accrual_133_1_3_rule_satisfied(plan, earlier_year, later_year);
}

pub relation years_would_have_participated_to_nra(employee: Person, plan: DefinedBenefitPlan, years: Decimal) kind empirical {
    label en unofficial "the total years the employee would have participated in the plan had he separated from service at normal retirement age, case-asserted";
}

pub relation accrual_fractional_rule_satisfied(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1)(C): the fractional rule — accrued benefit at least (years participated / years would have participated to NRA) times the projected NRA annual benefit";
}

@source(IRC_S411_B, relation = formalizes, coverage = exact, quote = "Such fraction shall be a fraction, not exceeding 1, the numerator of which is the total number of his years of participation in the plan (as of the date of his separation from the service) and the denominator of which is the total number of years he would have participated in the plan if he separated from the service at the normal retirement age.")
rule AccrualFractionalRuleSatisfied(employee: Person, plan: DefinedBenefitPlan, projected: Money, years_participated: Decimal, years_would: Decimal, accrued: Money) strict {
    label en official "exact boundary: accrued >= projected x min(years_participated / years_would, 1)";
    when projected_normal_retirement_benefit(employee, plan, projected)
        and years_of_plan_participation(employee, plan, years_participated)
        and years_would_have_participated_to_nra(employee, plan, years_would)
        and accrued_benefit_at_separation(employee, plan, accrued)
        and years_would > 0.0
        and accrued >= round(projected * min(div_round(years_participated, years_would, 6, "HALF_UP"), 1.0), 2, "HALF_UP");
    then accrual_fractional_rule_satisfied(employee, plan);
}

pub relation accrual_requirement_satisfied(employee: Person, plan: DefinedBenefitPlan) kind institutional {
    label en official "section 411(b)(1): the accrual requirement is met by any ONE of the 3-percent, 133 1/3-percent, or fractional methods";
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "A defined benefit plan satisfies the requirements of this paragraph")
rule AccrualRequirementSatisfiedBy3Pct(employee: Person, plan: DefinedBenefitPlan) strict {
    label en official "the 3-percent method alone suffices";
    when accrual_3pct_method_satisfied(employee, plan);
    then accrual_requirement_satisfied(employee, plan);
}

@source(IRC_S411_B, relation = formalizes, coverage = partial, quote = "A defined benefits plan satisfies the requirements of this paragraph if the accrued benefit to which any participant is entitled upon his separation from the service is not less than a fraction")
rule AccrualRequirementSatisfiedByFractional(employee: Person, plan: DefinedBenefitPlan) strict {
    label en official "the fractional rule alone suffices";
    when accrual_fractional_rule_satisfied(employee, plan);
    then accrual_requirement_satisfied(employee, plan);
}
// The 133 1/3 rule ((B)) is a PLAN-WIDE test over every pair of years
// (`accrual_133_1_3_rule_satisfied`), not a per-employee accrued-benefit
// floor like (A)/(C) — it is not folded into `accrual_requirement_
// satisfied` for that reason (a modelling note, not a gap). (b)(1)(D)-(H)
// (pre-effective-date accruals, the first-two-years exception, insured
// plans, the no-decrease-on-age/service rule, continued accrual beyond
// NRA), (b)(2)-(6) (DC no-age-cutoff rule, separate accounting, year of
// participation, age-related special rules, the interest-crediting-rate
// cap) are NOT modelled (TECH_GAP, stage 2b — each is its own multi-part
// sub-rule; the priority accrual COMPARISONS above are what the task
// instruction singled out as "exact tests").

// -- (c)(2)(A) Accrued benefit derived from employee contributions ------

pub relation employee_separate_account_maintained(employee: Person, plan: Plan) kind empirical {
    label en unofficial "a separate account is maintained for the employee's own contributions, case-asserted";
}

pub relation employee_contributions_less_withdrawals(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the employee's contributions, less withdrawals, case-asserted";
}

pub relation employer_contributions_less_withdrawals(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the employer's contributions on the employee's behalf, less withdrawals, case-asserted";
}

pub relation total_accrued_benefit(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the employee's total accrued benefit under the plan, case-asserted";
}

pub relation accrued_benefit_from_employee_contributions_no_separate_account(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 411(c)(2)(A)(ii): without a separate account, the employee-derived accrued benefit is the total accrued benefit times the ratio of employee contributions to total (employee + employer) contributions";
}

@source(IRC_S411_C, relation = formalizes, coverage = exact, quote = "the amount which bears the same ratio to his total accrued benefit as the total amount of the employee's contributions (less withdrawals) bears to the sum of such contributions and the contributions made on his behalf by the employer (less withdrawals)")
rule AccruedBenefitFromEmployeeContributionsNoSeparateAccount(employee: Person, plan: Plan, total: Money, ee: Money, er: Money) strict {
    label en official "exact ratio computation, only when no separate account is maintained";
    when not_known(employee_separate_account_maintained(employee, plan))
        and total_accrued_benefit(employee, plan, total)
        and employee_contributions_less_withdrawals(employee, plan, ee)
        and employer_contributions_less_withdrawals(employee, plan, er)
        and (ee + er) > 0 USD;
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then accrued_benefit_from_employee_contributions_no_separate_account(employee, plan, div_round(total * (ee / 1.00 USD), (ee + er) / 1.00 USD, 2, "HALF_UP"));
}
// (c)(2)(A)(i) (separate-account case — trivially the account balance,
// same shape as `accrued_benefit_dc`), (c)(2)(B)-(D) (defined benefit
// plan's accumulated-contribution annuity conversion with the 120%-AFR/
// section 417(e)(3) blended interest rate — EXTERNAL_DEPENDENCY, same
// class as G66), and (c)(1)/(3) (the employer-derived-benefit subtraction
// definition and the actuarial-equivalence adjustment) are NOT modelled
// (TECH_GAP, stage 2b).
