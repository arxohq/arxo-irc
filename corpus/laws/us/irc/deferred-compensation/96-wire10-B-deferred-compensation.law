// Deferred compensation -- WIRE-10, group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Owner-derives-consumer technique: `group_health` cannot import this package's `Plan` (it imports only core) and `Plan` is not a
// subtype of its `GroupHealthPlan`, so this package derives the pub stub of the lower consumer through an identity bridge fact.

language "law.core" version "0.2";
package us.irc.deferred_compensation version "0.1.1";
namespace "urn:us:irc:deferred_compensation:clir";

use self::{
    IRC_S414_E,
    Plan,
    church_plan_414e,
};

pub relation plan_of_group_health_plan(health_plan: us.irc.group_health::GroupHealthPlan, plan: Plan) kind empirical {
    label en unofficial "identity bridge: the group health plan of chapter 100 is the plan whose church-plan status section 414(e) tests";
}

@source(IRC_S414_E, relation = formalizes, coverage = partial, quote = "the term \"church plan\" means a plan established and maintained")
rule W10ChurchPlanFor9802f(health_plan: us.irc.group_health::GroupHealthPlan, plan: Plan) strict {
    label en official "a group health plan that is a church plan under section 414(e) is a church plan for section 9802(f)";
    when plan_of_group_health_plan(health_plan, plan);
    when church_plan_414e(plan);
    then us.irc.group_health::church_plan(health_plan);
}
