// Section 402 — taxability of beneficiary of employees' trust. Stage 1
// (IRC-09), DECISION-0379. Priority: (a) inclusion when distributed,
// (c) rollovers (60-day rule as a power/validity condition with exact date
// arithmetic), (g) elective deferral limit with catch-up (section 414(v)).
// Also modelled: (e)(4) NUA brief stub.


// =====================================================================
// (a) Taxability of distributee of an exempt trust
// =====================================================================

use self::{
    Distribution,
    IRC_S402_A,
    IRC_S402_B,
    IRC_S402_C,
    IRC_S402_D,
    IRC_S402_E,
    IRC_S402_F,
    IRC_S402_G,
    IRC_S402_H,
    IRC_S402_L,
    Person,
    Plan,
    TaxableYear,
    distribution,
    sep_employer_contribution,
};

pub relation qualified_trust_distribution(d: Distribution, trust_plan: Plan) kind empirical {
    label en unofficial "the distribution is from an employees' trust described in section 401(a) exempt under section 501(a) (case-asserted; the section 401(a)/501(a) qualification itself is tested in `02-401a-qualification.law`)";
}

pub relation includible_under_section_72(d: Distribution, distributee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "the section 72 annuity-taxation amount for this distribution (this package does not reformalize section 72's investment-in-the-contract exclusion ratio; the case asserts the section 72 amount as an input to this section's inclusion rule — TECH_GAP: section 72 itself is `gross-income`'s pending Part II contract per the task instruction)";
}

pub relation section402a_includible_in_gross_income(d: Distribution, distributee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(a): amount actually distributed by a qualified trust is taxable to the distributee, in the year distributed, under section 72";
}

@source(IRC_S402_A, relation = formalizes, coverage = exact, quote = "any amount actually distributed to any distributee by any employees' trust described in section 401(a) which is exempt from tax under section 501(a) shall be taxable to the distributee, in the taxable year of the distributee in which distributed, under section 72")
rule Section402aInclusion(d: Distribution, trust_plan: Plan, distributee: Person, y: TaxableYear, on: Date, amount: Money) defeasible {
    label en official "a qualified-trust distribution is included in the distributee's gross income for the year distributed, at the section 72 amount, unless excluded (e.g. a valid rollover under (c))";
    when qualified_trust_distribution(d, trust_plan)
        and distribution(d, trust_plan, distributee, _, on)
        and us.irc.core::year_of(distributee, y)
        and includible_under_section_72(d, distributee, y, amount)
        and not_known(rollover_excluded_from_income(d));
    then section402a_includible_in_gross_income(d, distributee, y, amount);
}

pub relation rollover_excluded_from_income(d: Distribution) kind institutional {
    label en unofficial "this distribution (or the transferred portion) is excluded from gross income under section 402(c)(1) by reason of a valid rollover";
}

// =====================================================================
// (c) Rollovers — POWER with the 60-day rule as a VALIDITY condition
// =====================================================================

pub relation eligible_rollover_distribution(d: Distribution) kind institutional {
    label en official "section 402(c)(4): a distribution of all or part of the employee's balance in a qualified trust, other than a substantially-equal-periodic-payment series, an RMD under section 401(a)(9), or a hardship distribution";
}

pub relation part_of_substantially_equal_periodic_payment_series(d: Distribution) kind empirical {
    label en unofficial "the distribution is one of a series of substantially equal periodic payments excluded by section 402(c)(4)(A), case-asserted";
}

pub relation required_by_401a9(d: Distribution) kind empirical {
    label en unofficial "the distribution is required under section 401(a)(9) (excluded by section 402(c)(4)(B)), case-asserted";
}

pub relation made_upon_hardship(d: Distribution) kind empirical {
    label en unofficial "the distribution is made upon hardship of the employee (excluded by section 402(c)(4)(C)), case-asserted";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the term \"eligible rollover distribution\" means any distribution to an employee of all or any portion of the balance to the credit of the employee in a qualified trust; except that such term shall not include—")
rule EligibleRolloverDistribution(d: Distribution, trust_plan: Plan, employee: Person) strict {
    label en official "a distribution from the balance to the credit of the employee in a qualified trust is an eligible rollover distribution unless one of the three (c)(4) exclusions applies";
    when qualified_trust_distribution(d, trust_plan)
        and distribution(d, trust_plan, employee, _, _)
        and not part_of_substantially_equal_periodic_payment_series(d)
        and not required_by_401a9(d)
        and not made_upon_hardship(d);
    then eligible_rollover_distribution(d);
}

pub relation rollover_contribution_made(distributee: Person, d: Distribution, target: Plan, on: Date, amount: Money) kind empirical {
    label en unofficial "the distributee transferred this amount of the distributed property to an eligible retirement plan on this date, case-asserted";
}

pub relation frozen_deposit_period(d: Distribution, extra_days: Integer) kind empirical {
    label en unofficial "additional days excluded from the 60-day count because the amount was a frozen deposit under section 402(c)(7), case-asserted; 0 when not applicable";
}

pub relation rollover_timely(distributee: Person, d: Distribution, distributed_on: Date, transferred_on: Date, extra_days: Integer) kind institutional {
    label en official "section 402(c)(3)(A): the transfer occurred not later than the 60th day (extended by any frozen-deposit days) after the day the distributee received the distribution";
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "paragraph (1) shall not apply to any transfer of a distribution made after the 60th day following the day on which the distributee received the property distributed")
rule RolloverTimely(distributee: Person, d: Distribution, target: Plan, distributed_on: Date, transferred_on: Date, extra_days: Integer) strict {
    label en official "timely when transferred on or before day 60 (plus frozen-deposit extension); day 61 (with no extension) is untimely — exact boundary";
    when rollover_contribution_made(distributee, d, target, transferred_on, _)
        and distribution(d, _, distributee, _, distributed_on)
        and frozen_deposit_period(d, extra_days)
        and days_between(distributed_on, transferred_on) <= 60 + extra_days;
    then rollover_timely(distributee, d, distributed_on, transferred_on, extra_days);
}

pub relation rollover_valid(distributee: Person, d: Distribution, on: Date) kind institutional {
    label en official "the single valid_when atom combining timeliness (a power's valid_when takes exactly one atom, core-surfaces.md/rights-positions.md)";
}

@source(IRC_S402_C, relation = formalizes, coverage = partial, quote = "Except as provided in subparagraphs (B) and (C), paragraph (1) shall not apply to any transfer of a distribution made after the 60th day following the day on which the distributee received the property distributed.")
rule RolloverValid(distributee: Person, d: Distribution, distributed_on: Date, on: Date, extra_days: Integer) strict {
    label en official "valid when the transfer is timely under the 60-day (plus frozen-deposit) rule";
    when rollover_timely(distributee, d, distributed_on, on, extra_days);
    then rollover_valid(distributee, d, on);
}

@source(IRC_S402_C, relation = formalizes, coverage = exact, quote = "the distributee transfers any portion of the property received in such distribution to an eligible retirement plan")
rule RolloverElectionPower(distributee: Person, d: Distribution, trust_plan: Plan, target: Plan, on: Date, amount: Money) strict {
    label en official "section 402(c)(1): the distributee's rollover of an eligible rollover distribution to an eligible retirement plan within the 60-day window excludes the transferred amount from gross income";
    when eligible_rollover_distribution(d) and distribution(d, trust_plan, distributee, _, _) and rollover_contribution_made(distributee, d, target, on, amount);
    then power RolloverElection {
        holder distributee;
        over d;
        exercise rollover_contribution_made(distributee, d, target, on, amount);
        valid_when rollover_valid(distributee, d, on);
        effect rollover_excluded_from_income(d);
    };
}
// NOTE (human judgment recorded): the (c)(2) "maximum amount" cap (only the
// includible portion may be excluded, subject to the direct-trustee-to-
// trustee-transfer exception) and the (c)(8) "eligible retirement plan"
// enumeration are NOT separately gated in `RolloverElection.valid_when`
// (which takes exactly one atom, `rules-positions`/core-surfaces.md
// constraint); they are left as TECH_GAP refinements of `rollover_timely`'s
// sibling conditions rather than folded into one compound `valid_when` atom
// (which the compiler rejects, LDC-E1305/E4101). A full model would derive
// a single `rollover_valid(distributee, d, on)` helper relation conjoining
// all validity facts and use THAT as the one `valid_when` atom; this stage
// only wires the 60-day rule, the priority item.

// =====================================================================
// (g) Limitation on exclusion for elective deferrals
// =====================================================================

pub relation elective_deferral(participant: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an elective deferral (section 402(g)(3): 401(k) employer contribution under a CODA, 403(b) salary-reduction annuity purchase, or 408(p)(2)(A)(i) SIMPLE elective contribution) made on behalf of this participant for this taxable year under this plan, case-asserted";
}

pub relation aggregate_elective_deferrals(participant: Person, y: TaxableYear, total: Money) kind institutional {
    label en official "the sum of this individual's elective deferrals under this plan and all other plans, contracts or arrangements for the calendar year (section 402(g)(1)(A)/section 401(a)(30) aggregation)";
}

@source(IRC_S402_G, relation = formalizes, coverage = partial, quote = "the elective deferrals of any individual for any taxable year shall be included in such individual's gross income to the extent the amount of such deferrals for the taxable year exceeds the applicable dollar amount")
rule AggregateElectiveDeferralsSum(participant: Person, y: TaxableYear) strict {
    label en official "aggregate = sum of elective deferrals under every plan for this individual and year (a case-asserted-fact aggregate, not an aggregate over a derived predicate)";
    when elective_deferral(participant, _, y, _);
    then aggregate_elective_deferrals(participant, y,
        sum all amount: Money for plan: Plan
            where elective_deferral(participant, plan, y, amount));
}

pub relation excess_deferral(participant: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(g)(1): the amount by which aggregate elective deferrals for the year exceed the applicable dollar amount (excess must be included in gross income unless it is a designated Roth contribution, section 402(g)(1)(A) last sentence)";
}

@source(IRC_S402_G, relation = formalizes, coverage = exact, quote = "the elective deferrals of any individual for any taxable year shall be included in such individual's gross income to the extent the amount of such deferrals for the taxable year exceeds the applicable dollar amount")
rule ExcessDeferralComputation(participant: Person, y: TaxableYear, total: Money) strict {
    label en official "excess = aggregate deferrals minus the applicable dollar amount, when positive";
    when aggregate_elective_deferrals(participant, y, total) and total > ELECTIVE_DEFERRAL_LIMIT;
    then excess_deferral(participant, y, total - ELECTIVE_DEFERRAL_LIMIT);
}

pub relation has_excess_deferral(participant: Person, y: TaxableYear) kind institutional {
    label en unofficial "true when this participant has any excess deferral for this year (boolean-shaped helper so other rules can negate a fully-bound, argument-free fact instead of an existentially quantified one)";
}

@source(IRC_S402_G, relation = formalizes, coverage = contextual, quote = "the elective deferrals of any individual for any taxable year shall be included in such individual's gross income to the extent the amount of such deferrals for the taxable year exceeds the applicable dollar amount")
rule HasExcessDeferral(participant: Person, y: TaxableYear, amount: Money) strict {
    label en unofficial "derives the boolean helper from any excess_deferral amount";
    when excess_deferral(participant, y, amount);
    then has_excess_deferral(participant, y);
}
// ELECTIVE_DEFERRAL_LIMIT is an A3 parameter
// (section-402g-elective-deferral-limit.lawparam.json): statutory base
// $15,000 (as this 2024-edition pin shows it after Pub. L. 119-21's
// increase; the section (g)(4) cost-of-living-adjustment base period is the
// calendar quarter beginning July 1, 2005). Only the statutory base is
// pinned; the annually adjusted dollar amount is IRS-published, not in
// Title 26 text — SOURCE_GAP row in the parameter dataset.
// Catch-up contributions under section 414(v) (which raise the effective
// limit for participants age 50+) are declared and formalized in
// `12-414-definitions.law`; this rule does NOT net catch-up against the
// excess computation (TECH_GAP: needs a `catch_up_elective_deferral` split
// of `elective_deferral` by contribution kind, see `01-ontology.law`
// `ContributionKind`, which this stage's `elective_deferral` relation does
// not yet carry — recorded, not silently ignored).

// =====================================================================
// (e)(4) Lump-sum distribution — brief (NUA) stub
// =====================================================================
pub relation employer_securities_distribution_value_and_basis(d: Distribution, value: Money, basis: Money) kind empirical {
    label en unofficial "the distributed value of employer securities and the trust's cost basis in them, case-asserted";
}

pub relation net_unrealized_appreciation(d: Distribution, employer_securities_value: Money, cost_basis: Money, amount: Money) kind institutional {
    label en unofficial "section 402(e)(4): net unrealized appreciation in employer securities distributed as part of a lump-sum distribution — amount = value at distribution minus the trust's cost basis; NOT separately gated on the full lump-sum-distribution definition of (e)(4)(D) in this stage (TECH_GAP, stage 2)";
}

@source(IRC_S402_E, relation = formalizes, coverage = partial, quote = "there shall be excluded from gross income the net unrealized appreciation attributable to that part of the distribution which consists of securities of the employer corporation")
rule NetUnrealizedAppreciationComputation(d: Distribution, value: Money, basis: Money) strict {
    label en official "NUA = distributed value of employer securities minus the trust's cost basis in them (brief stub; the full lump-sum qualification test of (e)(4)(D) is stage 2)";
    when employer_securities_distribution_value_and_basis(d, value, basis) and value > basis;
    then net_unrealized_appreciation(d, value, basis, value - basis);
}

// =====================================================================
// STAGE 2b (25.09.2026): (b) nonexempt-trust taxability (brief), (d)
// foreign-situs trusts, (e)(2) nonresident-alien ratio, (e)(3) CODA
// contributions not treated as distributed, (f) written-explanation duty,
// (h)(2) SEP contribution-excess-treated-as-distributed limitation, (l)
// public safety officer $3,000 health/long-term-care premium exclusion.
// =====================================================================

pub relation nonexempt_trust_contribution(trust_plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an employer contribution to an employees' trust which is not exempt under section 501(a) for the taxable year, case-asserted";
}

pub relation nonexempt_trust_contribution_included_section83(trust_plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(b)(1): contributions to a nonexempt trust are included in the employee's gross income under section 83 (property transferred for services)";
}

@source(IRC_S402_B, relation = formalizes, coverage = partial, quote = "shall be included in the gross income of the employee in accordance with section 83 (relating to property transferred in connection with performance of services)")
rule NonexemptTrustContributionIncludedSection83(trust_plan: Plan, employee: Person, y: TaxableYear, amount: Money) strict {
    label en official "brief stub: the value of the employee's trust interest is included under section 83 (the section 83 computation itself is owned elsewhere)";
    when nonexempt_trust_contribution(trust_plan, employee, y, amount);
    then nonexempt_trust_contribution_included_section83(trust_plan, employee, y, amount);
}
// (b)(2) distribution taxation under section 72, (b)(3) grantor-trust
// non-attribution, and (b)(4) the highly-compensated-employee vested-
// accrued-benefit override on a section 410(b)/401(a)(26) coverage failure
// are NOT modelled (TECH_GAP, stage 2b).

pub relation foreign_situs_trust_would_qualify_but_for_situs(trust_plan: Plan) kind empirical {
    label en unofficial "the trust would qualify for section 501(a) exemption but for being created or organized outside the United States, case-asserted";
}

pub relation foreign_situs_trust_treated_as_exempt(trust_plan: Plan) kind institutional {
    label en official "section 402(d): for purposes of (a)-(c), a qualifying-but-for-situs foreign trust is treated as exempt under section 501(a)";
}

@source(IRC_S402_D, relation = formalizes, coverage = exact, quote = "shall be treated as if it were a trust exempt from tax under section 501(a)")
rule ForeignSitusTrustTreatedAsExempt(trust_plan: Plan) strict {
    label en official "situs alone does not defeat the exemption fiction";
    when foreign_situs_trust_would_qualify_but_for_situs(trust_plan);
    then foreign_situs_trust_treated_as_exempt(trust_plan);
}

pub relation us_distribution_to_nonresident_alien(employee: Person, y: TaxableYear, amount_without_ratio: Money) kind empirical {
    label en unofficial "the amount includible under (a) without regard to the (e)(2) ratio, for a United States distribution to a nonresident alien for services as a US government employee, case-asserted";
}

pub relation basic_pay_from_us_sources(employee: Person, amount: Money) kind empirical {
    label en unofficial "aggregate basic pay paid by the United States to the employee, reduced by pay not includible in gross income for being from sources without the United States, case-asserted (section 402(e)(2)(A))";
}

pub relation basic_pay_total(employee: Person, amount: Money) kind empirical {
    label en unofficial "aggregate basic pay paid by the United States to the employee for the services, case-asserted (section 402(e)(2)(B))";
}

pub relation nonresident_alien_us_distribution_includible(employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(e)(2): the includible amount is capped at the ratio of US-source basic pay to total basic pay";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "shall not exceed an amount which bears the same ratio to the amount includible in gross income without regard to this paragraph as")
rule NonresidentAlienUsDistributionIncludible(employee: Person, y: TaxableYear, without_ratio: Money, us_source: Money, total: Money) strict {
    label en official "includible = amount-without-ratio times (US-source basic pay / total basic pay)";
    when us_distribution_to_nonresident_alien(employee, y, without_ratio)
        and basic_pay_from_us_sources(employee, us_source)
        and basic_pay_total(employee, total)
        and total > 0 USD;
    // One proportion, one rounding (TECH-GAPS G499, 26.09.2026).
    then nonresident_alien_us_distribution_includible(employee, y, div_round(without_ratio * (us_source / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

pub relation coda_contribution_election(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an employer contribution to a qualified cash-or-deferred-arrangement trust (or a section 403(b) salary-reduction agreement) on behalf of the employee, where the employee could have elected cash instead, case-asserted";
}

pub relation coda_contribution_not_distributed_or_made_available(employee: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(e)(3): a CODA/403(b) salary-reduction contribution is not treated as distributed, made available, or contributed by the employee merely because of the cash election";
}

@source(IRC_S402_E, relation = formalizes, coverage = exact, quote = "shall not be treated as distributed or made available to the employee nor as contributions made to the trust by the employee merely because the arrangement includes provisions under which the employee has an election whether the contribution will be made to the trust or received by the employee in cash")
rule CodaContributionNotDistributedOrMadeAvailable(employee: Person, plan: Plan, y: TaxableYear, amount: Money) strict {
    label en official "the cash-or-deferred election itself does not trigger constructive receipt";
    when coda_contribution_election(employee, plan, y, amount);
    then coda_contribution_not_distributed_or_made_available(employee, plan, y, amount);
}
// (e)(5) is repealed (NON_NORMATIVE); (e)(6) direct trustee-to-trustee
// transfer exclusion is NOT separately modelled (TECH_GAP, stage 2b — the
// rollover-power machinery already models the (c) case, not this generic
// (a)(31) transfer case).

pub relation plan_administrator_of(plan: Plan, administrator: Person) kind empirical {
    label en unofficial "the plan administrator of this plan, case-asserted";
}

pub relation written_rollover_explanation_provided(plan: Plan, recipient: Person, d: Distribution) kind empirical {
    label en unofficial "the plan administrator provided the section 402(f) written explanation to the recipient before making this eligible rollover distribution, case-asserted";
}

@source(IRC_S402_F, relation = formalizes, coverage = exact, quote = "The plan administrator of any plan shall, within a reasonable period of time before making an eligible rollover distribution, provide a written explanation to the recipient")
pub rule Section402fWrittenExplanationDuty defeasible {
    label en official "section 402(f)(1): the plan administrator's duty to explain rollover rights before an eligible rollover distribution (the \"reasonable period of time\" timing is a DECISION-0194 evaluative element, not tested here as a window boundary)";
    for plan: Plan;
    for administrator: Person;
    for recipient: Person;
    for d: Distribution;
    when plan_administrator_of(plan, administrator)
        and eligible_rollover_distribution(d)
        and distribution(d, plan, recipient, _, _);
    then duty Section402fWrittenExplanationDutyPosition {
        bearer administrator;
        beneficiary recipient;
        goal maintenance {
            condition written_rollover_explanation_provided(plan, recipient, d);
            window [-infinity, infinity];
        }
    };
}
// (f)(2) the "eligible rollover distribution"/"eligible retirement plan"
// cross-reference definitions reuse this module's own
// `eligible_rollover_distribution`/`04-402-distributions.law` vocabulary
// rather than a separate relation.

pub relation sep_compensation_includible(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's section 414(s) compensation from the employer includible in gross income for the year, determined without regard to the SEP contribution, case-asserted (section 402(h)(2)(A))";
}

pub relation sep_415c1a_limit(employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 415(c)(1)(A) dollar limitation in effect for the year, case-asserted (section 402(h)(2)(B); the highly-compensated-employee reduction for 408(k)(3)(D) elective deferrals is NOT modelled — TECH_GAP)";
}

pub relation sep_excess_contribution_treated_as_distributed(employee: Person, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(h)(2): SEP contributions in excess of the lesser of 25% of includible compensation or the section 415(c)(1)(A) limit are treated as distributed to (and contributed by) the employee";
}

@source(IRC_S402_H, relation = formalizes, coverage = exact, quote = "to the extent such contributions exceed the lesser of")
rule SepExcessContributionTreatedAsDistributed(employee: Person, employer: Person, y: TaxableYear, contributed: Money, comp: Money, limit415c: Money) strict {
    label en official "excess = contributed minus min(25% of includible compensation, section 415(c)(1)(A) limit), when positive";
    when sep_employer_contribution(employer, employee, y, contributed)
        and sep_compensation_includible(employee, employer, y, comp)
        and sep_415c1a_limit(employee, y, limit415c)
        and contributed > min(round(comp * 0.25, 2, "HALF_UP"), limit415c);
    then sep_excess_contribution_treated_as_distributed(employee, employer, y,
        contributed - min(round(comp * 0.25, 2, "HALF_UP"), limit415c));
}

pub relation public_safety_officer_health_premiums_paid(officer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount paid by an eligible retired public safety officer for qualified health insurance premiums for the year, case-asserted";
}

pub relation public_safety_officer_election_in_effect(officer: Person, y: TaxableYear) kind empirical {
    label en unofficial "the officer made the section 402(l)(6) election for the year, case-asserted";
}

pub relation public_safety_officer_distributions_for_year(officer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the aggregate distributions from the eligible retirement plan for the year used to pay the premiums, case-asserted";
}

pub relation public_safety_officer_premium_exclusion(officer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 402(l)(1)-(2): distributions used for qualified health/long-term-care insurance premiums are excluded from gross income, up to the lesser of the premiums paid, the distributions made, and $3,000";
}

@source(IRC_S402_L, relation = formalizes, coverage = exact, quote = "The amount which may be excluded from gross income for the taxable year by reason of paragraph (1) shall not exceed $3,000.")
rule PublicSafetyOfficerPremiumExclusion(officer: Person, y: TaxableYear, premiums: Money, distributed: Money) strict {
    label en official "exclusion = min(premiums paid, distributions made, $3,000 statutory cap) — exact boundary at exactly $3,000";
    when public_safety_officer_election_in_effect(officer, y)
        and public_safety_officer_health_premiums_paid(officer, y, premiums)
        and public_safety_officer_distributions_for_year(officer, y, distributed);
    then public_safety_officer_premium_exclusion(officer, y, min(min(premiums, distributed), PUBLIC_SAFETY_OFFICER_PREMIUM_EXCLUSION_LIMIT));
}
// PUBLIC_SAFETY_OFFICER_PREMIUM_EXCLUSION_LIMIT is an A3 parameter
// (section-402l2-public-safety-officer-limit.lawparam.json): $3,000,
// NOT indexed by the statute (no cost-of-living-adjustment paragraph exists
// in (l) — this is a flat, unindexed statutory cap, not a SOURCE_GAP).
// (l)(3)-(8) (the section-72-aggregation special rule, the "eligible
// retired public safety officer"/"public safety officer" classification
// definitions, direct-payment-to-insurer mechanics, and the medical-
// expense/self-employed-health-insurance coordination) are NOT modelled
// (TECH_GAP, stage 2b).
