// Section 414(u) — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026): veterans' reemployment rights under USERRA (chapter 43 of
// title 38) and differential wage payments. Stage 2e left paragraphs (1)-(12)
// as TECH_GAP. Modelled here: qualified military service and individual
// account plans (5), (6); the USERRA-required contribution and its three
// consequences (1); the elective-deferral make-up right and its matching
// contribution (2); no retroactive earnings or forfeiture allocation (3);
// loan repayment suspensions (4); deemed compensation (7); the qualified plan
// USERRA requirements (8); death or disability (9); plans outside title 38
// (10), the frozen reference date (11); and differential wage payments (12).
//
// Method. Consequences are derived relations that the section 402(g), 415,
// 401(a)(4) ... modules read only when a case asserts them (no rewriting of
// stage-1 rules). JUDGMENT CALL / RESIDUAL GAP (TECH-GAPS G4600): the make-up
// period is "the same length as the lesser of 3 times the period of
// qualified military service and 5 years"; a calendar period whose length is
// a variable is not expressible (`add_calendar_period` needs a literal
// quantity, LDC-E2108), so the date that is the reemployment date plus three
// times the service period is a CASE-ASSERTED date and only the exact
// 5-year cap is computed.

use self::{
    IRC_S414_U,
    Person,
    Plan,
    TaxableYear,
    participates_in,
};

pub enum IndividualAccountPlanKind414u6 {
    DefinedContributionPlan;
    TaxShelteredAnnuity403b;
    SimplifiedEmployeePension408k;
    QualifiedSalaryReductionArrangement408p;
    EligibleDeferredCompensationPlan457b;
}

pub relation plan_kind_414u6(plan: Plan, kind: IndividualAccountPlanKind414u6) kind empirical {
    label en unofficial "the plan is of this kind, case-asserted (section 414(u)(6))";
}

pub relation individual_account_plan_414u6(plan: Plan) kind institutional {
    label en official "section 414(u)(6): any defined contribution plan, including a section 403(b) annuity plan, a simplified employee pension, a qualified salary reduction arrangement and an eligible deferred compensation plan under section 457(b)";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the term \"individual account plan\" means any defined contribution plan (including any tax-sheltered annuity plan under section 403(b), any simplified employee pension under section 408(k), any qualified salary reduction arrangement under section 408(p), and any eligible deferred compensation plan (as defined in section 457(b)))")
rule IndividualAccountPlan414u6(plan: Plan, kind: IndividualAccountPlanKind414u6) strict {
    label en official "any listed kind";
    when plan_kind_414u6(plan, kind);
    then individual_account_plan_414u6(plan);
}

pub relation uniformed_service_414u5(employee: Person, start: Date, end: Date) kind empirical {
    label en unofficial "the individual serves in the uniformed services (as defined in chapter 43 of title 38) from start to end, case-asserted";
}

pub relation entitled_to_reemployment_rights_414u5(employee: Person, start: Date, end: Date) kind empirical {
    label en unofficial "the individual is entitled to reemployment rights under chapter 43 of title 38 with respect to that service, case-asserted";
}

pub relation qualified_military_service_414u5(employee: Person, start: Date, end: Date) kind institutional {
    label en official "section 414(u)(5): service in the uniformed services by an individual entitled to reemployment rights under chapter 43 with respect to it";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the term \"qualified military service\" means any service in the uniformed services (as defined in chapter 43 of title 38, United States Code) by any individual if such individual is entitled to reemployment rights under such chapter with respect to such service")
rule QualifiedMilitaryService414u5(employee: Person, start: Date, end: Date) strict {
    label en official "service and entitlement together";
    when uniformed_service_414u5(employee, start, end) and entitled_to_reemployment_rights_414u5(employee, start, end);
    then qualified_military_service_414u5(employee, start, end);
}

// =====================================================================
// (1) Contributions required by reason of USERRA rights
// =====================================================================

pub relation userra_required_contribution_414u1(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a contribution by an employer or an employee under an individual account plan (or by an employee to a defined benefit plan providing for employee contributions), made in one year and relating to another, that is required by reason of the employee's rights under chapter 43 resulting from qualified military service, case-asserted";
}

pub relation deferral_made_under_414u2_414u1(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an elective deferral or employee contribution made under paragraph (2), case-asserted";
}

pub relation contribution_treated_as_userra_required_414u1(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) kind institutional {
    label en official "section 414(u)(1): a contribution required by reason of chapter 43 rights, including any elective deferral or employee contribution made under paragraph (2)";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "and such contribution is required by reason of such employee's rights under chapter 43 of title 38, United States Code, resulting from qualified military service")
rule ContributionRequiredByUserra414u1(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "a contribution the case asserts is required by the rights";
    when userra_required_contribution_414u1(employee, plan, made_in, relates_to, amount);
    then contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "any elective deferral or employee contribution made under paragraph (2) shall be treated as required by reason of the employee's rights under such chapter 43")
rule ParagraphTwoDeferralTreatedAsRequired414u1(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "the make-up deferral is deemed required";
    when deferral_made_under_414u2_414u1(employee, plan, made_in, relates_to, amount);
    then contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
}

pub relation contribution_exempt_from_limitations_in_year_made_414u1A(employee: Person, plan: Plan, made_in: TaxableYear) kind institutional {
    label en official "section 414(u)(1)(A): not subject to the limitations of sections 402(g), 402(h), 403(b), 404(a), 404(h), 408, 415 or 457, and not taken into account in applying them to other contributions or benefits under any plan, for the year in which it is made";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "such contribution shall not be subject to any otherwise applicable limitation contained in section 402(g), 402(h), 403(b), 404(a), 404(h), 408, 415, or 457")
rule ContributionExemptInYearMade414u1A(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "the year of making";
    when contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
    then contribution_exempt_from_limitations_in_year_made_414u1A(employee, plan, made_in);
}

pub relation contribution_subject_to_limitations_for_year_414u1B(employee: Person, plan: Plan, relates_to: TaxableYear) kind institutional {
    label en official "section 414(u)(1)(B): the contribution is subject to the limitations with respect to the year to which it relates, in accordance with rules prescribed by the Secretary";
}

@source(IRC_S414_U, relation = formalizes, coverage = partial, quote = "such contribution shall be subject to the limitations referred to in subparagraph (A) with respect to the year to which the contribution relates")
rule ContributionSubjectToLimitationsForRelatedYear414u1B(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "PARTIAL: the Secretary's rules for applying the limitations to the related year are not pinned";
    when contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
    then contribution_subject_to_limitations_for_year_414u1B(employee, plan, relates_to);
}

pub relation plan_not_failing_listed_requirements_by_userra_contribution_414u1C(plan: Plan) kind institutional {
    label en official "section 414(u)(1)(C): the plan is not treated as failing sections 401(a)(4), 401(a)(26), 401(k)(3), 401(k)(11), 401(k)(12), 401(m), 403(b)(12), 408(k)(3), 408(k)(6), 408(p), 410(b) or 416 by reason of the making of, or the right to make, the contribution";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "such plan shall not be treated as failing to meet the requirements of section 401(a)(4), 401(a)(26), 401(k)(3), 401(k)(11), 401(k)(12), 401(m), 403(b)(12), 408(k)(3), 408(k)(6), 408(p), 410(b), or 416 by reason of the making of (or the right to make) such contribution")
rule PlanNotFailingByUserraContribution414u1C(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "one relation stands for the listed sections";
    when contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
    then plan_not_failing_listed_requirements_by_userra_contribution_414u1C(plan);
}

// =====================================================================
// (2) Elective deferral make-up rights
// =====================================================================

pub relation plan_provides_elective_deferrals_414u2A(plan: Plan) kind empirical {
    label en unofficial "the plan provides for elective deferrals, case-asserted";
}

pub relation reemployment_date_414u2A(employee: Person, employer: Person, on: Date) kind empirical {
    label en unofficial "the date of the employee's reemployment with the employer, case-asserted";
}

pub relation three_times_service_end_414u2Ai(employee: Person, employer: Person, on: Date) kind empirical {
    label en unofficial "the last day of a period beginning on the reemployment date whose length is 3 times the period of qualified military service, case-asserted (RESIDUAL GAP G4600: a variable-length calendar period is not expressible)";
}

pub relation makeup_period_end_414u2Ai(employee: Person, employer: Person, on: Date) kind institutional {
    label en official "section 414(u)(2)(A)(i): the last day of the make-up period, of the same length as the lesser of 3 times the period of service and 5 years";
}

@source(IRC_S414_U, relation = formalizes, coverage = partial, quote = "the period of qualified military service which resulted in such rights, and")
rule MakeupPeriodEndThreeTimes414u2Ai(employee: Person, employer: Person, reemployed: Date, three: Date, calendar_before_1: Date) strict {
    label en official "PARTIAL: the 3-times end date is a case input; chosen when it is not later than the 5-year end";
    when reemployment_date_414u2A(employee, employer, reemployed)
        and three_times_service_end_414u2Ai(employee, employer, three)
        and three <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(reemployed, 5 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then makeup_period_end_414u2Ai(employee, employer, three);
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "5 years")
rule MakeupPeriodEndFiveYears414u2Ai(employee: Person, employer: Person, reemployed: Date, three: Date, calendar_before_1: Date, calendar_before_2: Date) strict {
    label en official "exact: the 5-year period beginning on the reemployment date ends the day before its 5th anniversary; chosen when the 3-times end date is later";
    when reemployment_date_414u2A(employee, employer, reemployed)
        and three_times_service_end_414u2Ai(employee, employer, three)
        and three > calendar_before_2
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(reemployed, 5 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(reemployed, 5 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_2);
    then makeup_period_end_414u2Ai(employee, employer, calendar_before_1);
}

pub relation max_deferral_had_continued_employment_414u2B(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the maximum elective deferrals the individual would have been permitted to make during the period of service under the limitations of paragraph (1)(A) had the individual continued to be employed and received the compensation of paragraph (7), case-asserted";
}

pub relation deferrals_actually_made_during_service_414u2B(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the elective deferrals actually made during the period of service, case-asserted";
}

pub relation makeup_amount_414u2B(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 414(u)(2)(B): the maximum deferrals permitted had employment continued, adjusted for deferrals actually made during the service";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "Proper adjustment shall be made to the amount determined under the preceding sentence for any elective deferrals actually made during the period of such qualified military service")
rule MakeupAmount414u2B(employee: Person, plan: Plan, maximum: Money, actual: Money) strict {
    label en official "JUDGMENT CALL: the proper adjustment is subtraction, floored at zero";
    when max_deferral_had_continued_employment_414u2B(employee, plan, maximum)
        and deferrals_actually_made_during_service_414u2B(employee, plan, actual);
    then makeup_amount_414u2B(employee, plan, max(0 USD, maximum - actual));
}

pub relation employer_permits_additional_deferrals_until_414u2Ai(employee: Person, employer: Person, plan: Plan, amount: Money, until: Date) kind empirical {
    label en unofficial "the employer permits the employee to make additional elective deferrals of up to this amount during a period ending on this date, beginning on the reemployment date, case-asserted (clause (i))";
}

pub relation employee_elects_lesser_deferral_414u2Ai(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee elects a lesser amount than the make-up amount, case-asserted";
}

pub relation employer_matches_makeup_deferrals_414u2Aii(employee: Person, employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer makes the matching contribution that would have been required had the deferral been made during the period of service, case-asserted (clause (ii))";
}

pub relation employer_meets_chapter43_for_deferrals_414u2A(employee: Person, employer: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(2)(A): the employer is treated as meeting chapter 43 for elective deferrals only if it permits the make-up deferrals during the make-up period and makes the matching contribution";
}

@source(IRC_S414_U, relation = formalizes, coverage = partial, quote = "the employer sponsoring the plan shall be treated as meeting the requirements of such chapter 43 with respect to such elective deferrals only if such employer")
rule EmployerMeetsChapter43ForDeferrals414u2A(employee: Person, employer: Person, plan: Plan, amount: Money, until: Date, makeup: Money, end: Date) strict {
    label en official "PARTIAL: (i) the permitted amount is at least the make-up amount (or the employee elected less) and the period reaches the make-up period end; (ii) the match; exact boundary: the period may end on the make-up period end date";
    when plan_provides_elective_deferrals_414u2A(plan)
        and makeup_amount_414u2B(employee, plan, makeup)
        and makeup_period_end_414u2Ai(employee, employer, end)
        and employer_permits_additional_deferrals_until_414u2Ai(employee, employer, plan, amount, until)
        and amount >= makeup
        and until >= end
        and employer_matches_makeup_deferrals_414u2Aii(employee, employer, plan);
    then employer_meets_chapter43_for_deferrals_414u2A(employee, employer, plan);
}

@source(IRC_S414_U, relation = formalizes, coverage = partial, quote = "in the amount determined under subparagraph (B) or such lesser amount as is elected by the employee")
rule EmployerMeetsChapter43LesserElected414u2A(employee: Person, employer: Person, plan: Plan, amount: Money, until: Date, makeup: Money, end: Date) strict {
    label en official "PARTIAL: with a lesser amount elected by the employee the permitted amount need not reach the make-up amount";
    when plan_provides_elective_deferrals_414u2A(plan)
        and employee_elects_lesser_deferral_414u2Ai(employee, plan)
        and makeup_amount_414u2B(employee, plan, makeup)
        and makeup_period_end_414u2Ai(employee, employer, end)
        and employer_permits_additional_deferrals_until_414u2Ai(employee, employer, plan, amount, until)
        and until >= end
        and employer_matches_makeup_deferrals_414u2Aii(employee, employer, plan);
    then employer_meets_chapter43_for_deferrals_414u2A(employee, employer, plan);
}

pub relation employee_contribution_included_414u2D(plan: Plan) kind institutional {
    label en official "section 414(u)(2)(D): references to elective deferrals in (A) and (B) include after-tax employee contributions";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "References in subparagraphs (A) and (B) to elective deferrals shall be treated as including references to employee contributions")
rule EmployeeContributionsIncluded414u2D(plan: Plan) strict {
    label en official "plans providing employee contributions are treated like plans providing elective deferrals";
    when plan_provides_employee_contributions_414u2D(plan);
    then employee_contribution_included_414u2D(plan);
}

pub relation plan_provides_employee_contributions_414u2D(plan: Plan) kind empirical {
    label en unofficial "the plan provides for after-tax employee contributions, case-asserted";
}

pub enum ElectiveDeferralSource414u2C {
    Section402g3Deferral;
    Section457bDeferral;
}

pub relation deferral_source_414u2C(deferral: Integer, basis: ElectiveDeferralSource414u2C) kind empirical {
    label en unofficial "the deferral is an elective deferral under section 402(g)(3) or a deferral under an eligible deferred compensation plan (section 457(b)), case-asserted";
}

pub relation elective_deferral_414u2C(deferral: Integer) kind institutional {
    label en official "section 414(u)(2)(C): the meaning of section 402(g)(3), including any deferral of compensation under a section 457(b) plan";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the term \"elective deferral\" has the meaning given such term by section 402(g)(3); except that such term shall include any deferral of compensation under an eligible deferred compensation plan (as defined in section 457(b))")
rule ElectiveDeferral414u2C(deferral: Integer, basis: ElectiveDeferralSource414u2C) strict {
    label en official "either source";
    when deferral_source_414u2C(deferral, basis);
    then elective_deferral_414u2C(deferral);
}

// =====================================================================
// (3) No retroactive earnings or forfeiture allocation; (4) loans
// =====================================================================

pub relation earnings_credit_before_contribution_not_required_414u3A(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(3)(A): chapter 43 is not construed to require crediting earnings for a contribution before it is actually made";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "any crediting of earnings to an employee with respect to any contribution before such contribution is actually made")
rule EarningsNotRequiredBeforeContribution414u3A(employee: Person, plan: Plan, made_in: TaxableYear, relates_to: TaxableYear, amount: Money) strict {
    label en official "for any USERRA-required contribution";
    when contribution_treated_as_userra_required_414u1(employee, plan, made_in, relates_to, amount);
    then earnings_credit_before_contribution_not_required_414u3A(employee, plan);
}

pub relation forfeiture_allocation_for_service_period_not_required_414u3B(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(3)(B): chapter 43 is not construed to require an allocation of forfeitures for the period of qualified military service";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "any allocation of any forfeiture with respect to the period of qualified military service")
rule ForfeitureAllocationNotRequired414u3B(employee: Person, plan: Plan, start: Date, end: Date) strict {
    label en official "for an employee with qualified military service under the plan";
    when qualified_military_service_414u5(employee, start, end) and participates_in(employee, plan);
    then forfeiture_allocation_for_service_period_not_required_414u3B(employee, plan);
}

pub relation loan_repayment_suspended_during_uniformed_service_414u4(plan: Plan, loan: Integer, employee: Person) kind empirical {
    label en unofficial "the plan suspends the obligation to repay a loan for any part of a period in which the employee performs service in the uniformed services (whether or not qualified military service), case-asserted";
}

pub relation loan_suspension_disregarded_414u4(plan: Plan, loan: Integer) kind institutional {
    label en official "section 414(u)(4): the suspension is not taken into account for sections 72(p), 401(a) or 4975(d)(1)";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "such suspension shall not be taken into account for purposes of section 72(p), 401(a), or 4975(d)(1)")
rule LoanSuspensionDisregarded414u4(plan: Plan, loan: Integer, employee: Person) strict {
    label en official "any uniformed-service suspension";
    when loan_repayment_suspended_during_uniformed_service_414u4(plan, loan, employee);
    then loan_suspension_disregarded_414u4(plan, loan);
}

// =====================================================================
// (7) Compensation during qualified military service
// =====================================================================

pub relation compensation_would_have_received_414u7A(employee: Person, employer: Person, amount: Money) kind empirical {
    label en unofficial "the compensation the employee would have received during the period of service if not in qualified military service, at the rate of pay the employee would have received but for the absence, case-asserted (clause (A))";
}

pub relation compensation_not_reasonably_certain_414u7B(employee: Person, employer: Person) kind empirical {
    label en unofficial "the compensation the employee would have received during the period was not reasonably certain, case-asserted (evaluative)";
}

pub relation average_compensation_preceding_12_months_414u7B(employee: Person, employer: Person, amount: Money) kind empirical {
    label en unofficial "the employee's average compensation from the employer during the 12-month period immediately preceding the service (or, if shorter, the period of employment immediately preceding it), case-asserted (clause (B))";
}

pub relation deemed_compensation_during_service_414u7(employee: Person, employer: Person, amount: Money) kind institutional {
    label en official "section 414(u)(7): for sections 403(b)(3), 415(c)(3) and 457(e)(5), the compensation the employee would have received, or, if not reasonably certain, the average over the preceding 12 months";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the compensation the employee would have received during such period if the employee were not in qualified military service, determined based on the rate of pay the employee would have received from the employer but for absence during the period of qualified military service")
rule DeemedCompensationRateOfPay414u7A(employee: Person, employer: Person, amount: Money) strict {
    label en official "clause (A) unless the compensation was not reasonably certain";
    when compensation_would_have_received_414u7A(employee, employer, amount)
        and not_known(compensation_not_reasonably_certain_414u7B(employee, employer));
    then deemed_compensation_during_service_414u7(employee, employer, amount);
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "if the compensation the employee would have received during such period was not reasonably certain, the employee's average compensation from the employer during the 12-month period immediately preceding the qualified military service")
rule DeemedCompensationAverage414u7B(employee: Person, employer: Person, amount: Money) strict {
    label en official "clause (B) when the clause (A) compensation was not reasonably certain";
    when compensation_not_reasonably_certain_414u7B(employee, employer)
        and average_compensation_preceding_12_months_414u7B(employee, employer, amount);
    then deemed_compensation_during_service_414u7(employee, employer, amount);
}

// =====================================================================
// (8) USERRA requirements for qualified retirement plans
// =====================================================================

pub relation plan_treats_reemployed_as_no_break_in_service_414u8A(plan: Plan) kind empirical {
    label en unofficial "an individual reemployed under chapter 43 is treated as not having incurred a break in service by reason of the period of qualified military service, case-asserted";
}

pub relation plan_counts_service_for_vesting_and_accrual_414u8B(plan: Plan) kind empirical {
    label en unofficial "each period of qualified military service is deemed service with the employer for determining nonforfeitability and accrual of benefits, case-asserted";
}

pub relation plan_conditions_employee_funded_benefits_on_payment_414u8C(plan: Plan) kind empirical {
    label en unofficial "the reemployed individual is entitled to accrued benefits contingent on, or derived from, employee contributions or elective deferrals only to the extent the individual makes payment, case-asserted";
}

pub relation makeup_payment_and_cap_414u8C(employee: Person, plan: Plan, paid: Money, cap: Money) kind empirical {
    label en unofficial "the payment made by the reemployed individual and the amount the individual would have been permitted or required to contribute had employment continued, case-asserted";
}

pub relation makeup_payment_made_on_414u8C(employee: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the payment is made, case-asserted";
}

pub relation payment_within_cap_414u8C(employee: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(8)(C): no payment may exceed the amount the individual would have been permitted or required to contribute had the individual remained continuously employed";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "No such payment may exceed the amount the individual would have been permitted or required to contribute")
rule PaymentWithinCap414u8C(employee: Person, plan: Plan, paid: Money, cap: Money) strict {
    label en official "exact boundary: a payment equal to the cap is allowed";
    when makeup_payment_and_cap_414u8C(employee, plan, paid, cap) and paid <= cap;
    then payment_within_cap_414u8C(employee, plan);
}

pub relation payment_in_period_414u8C(employee: Person, employer: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(8)(C): the payment is made during the period beginning with the reemployment date and lasting 3 times the period of service (not more than 5 years)";
}

@source(IRC_S414_U, relation = formalizes, coverage = partial, quote = "Any payment to such plan shall be made during the period beginning with the date of reemployment and whose duration is 3 times the period of the qualified military service (but not greater than 5 years)")
rule PaymentInPeriod414u8C(employee: Person, employer: Person, plan: Plan, reemployed: Date, paid_on: Date, end: Date) strict {
    label en official "PARTIAL: the end date is the make-up period end (3-times date case-asserted, exact 5-year cap); exact boundaries: the reemployment date and the last day are inside";
    when reemployment_date_414u2A(employee, employer, reemployed)
        and makeup_payment_made_on_414u8C(employee, plan, paid_on)
        and makeup_period_end_414u2Ai(employee, employer, end)
        and paid_on >= reemployed
        and paid_on <= end;
    then payment_in_period_414u8C(employee, employer, plan);
}

pub relation employer_meets_chapter43_for_retirement_plan_414u8(employee: Person, employer: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(8): the employer sponsoring a retirement plan is treated as meeting chapter 43 only if requirements (A), (B) and (C) are met";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "an employer sponsoring a retirement plan shall be treated as meeting the requirements of chapter 43 of title 38, United States Code, only if each of the following requirements is met")
rule EmployerMeetsChapter43ForRetirementPlan414u8(employee: Person, employer: Person, plan: Plan) strict {
    label en official "(A), (B) and (C) together, with the payment within the cap and the period";
    when plan_treats_reemployed_as_no_break_in_service_414u8A(plan)
        and plan_counts_service_for_vesting_and_accrual_414u8B(plan)
        and plan_conditions_employee_funded_benefits_on_payment_414u8C(plan)
        and payment_within_cap_414u8C(employee, plan)
        and payment_in_period_414u8C(employee, employer, plan);
    then employer_meets_chapter43_for_retirement_plan_414u8(employee, employer, plan);
}

// =====================================================================
// (9) Death or disability while performing qualified military service
// =====================================================================

pub relation individual_died_or_disabled_in_service_414u9A(employee: Person, employer: Person, plan: Plan) kind empirical {
    label en unofficial "the individual dies or becomes disabled (as defined under the terms of the plan) while performing qualified military service with respect to the employer, case-asserted";
}

pub relation employer_treats_as_resumed_employment_414u9A(employee: Person, employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer treats the individual for benefit accrual purposes as having resumed employment on the day before death or disability and terminated on the actual date, case-asserted (exercise atom)";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "an employer sponsoring a retirement plan may treat an individual who dies or becomes disabled")
rule ResumedEmploymentLiberty414u9A(employee: Person, employer: Person, plan: Plan) strict {
    label en official "a liberty of the employer for benefit accrual purposes";
    when individual_died_or_disabled_in_service_414u9A(employee, employer, plan);
    then liberty TreatAsResumedEmploymentLiberty {
        holder employer;
        against employee;
        action employer_treats_as_resumed_employment_414u9A(employee, employer, plan);
        window [-infinity, infinity];
    };
}

pub relation all_individuals_credited_on_reasonably_equivalent_terms_414u9B(employer: Person) kind empirical {
    label en unofficial "all individuals performing qualified military service with respect to the employer (determined under section 414(b), (c), (m), (o)) who died or became disabled before reemployment are credited with service and benefits on reasonably equivalent terms, case-asserted (evaluative)";
}

pub relation accrual_compliance_treated_as_required_414u9A(employee: Person, employer: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(9)(A), (B): compliance with the benefit accrual requirements of paragraph (8) for the individual is treated for paragraph (1) as required by chapter 43, only if the nondiscrimination requirement is met";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "any full or partial compliance by such plan with respect to the benefit accrual requirements of paragraph (8) with respect to such individual shall be treated for purposes of paragraph (1) as if such compliance were required under such chapter 43")
rule AccrualComplianceTreatedAsRequired414u9A(employee: Person, employer: Person, plan: Plan) strict {
    label en official "the treatment applies only if the employer treated the individual as resumed and the equal-terms condition holds";
    when individual_died_or_disabled_in_service_414u9A(employee, employer, plan)
        and employer_treats_as_resumed_employment_414u9A(employee, employer, plan)
        and all_individuals_credited_on_reasonably_equivalent_terms_414u9B(employer);
    then accrual_compliance_treated_as_required_414u9A(employee, employer, plan);
}

pub relation months_of_service_before_military_414u9C(employee: Person, employer: Person, months: Integer) kind empirical {
    label en unofficial "the number of months of continuous service with the employer immediately prior to the qualified military service (12 or more counts as 12), case-asserted";
}

pub relation averaging_period_months_414u9C(employee: Person, employer: Person, months: Integer) kind institutional {
    label en official "section 414(u)(9)(C): the lesser of the 12-month period of service immediately prior to the service and the actual length of continuous service";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the 12-month period of service with the employer immediately prior to qualified military service")
rule AveragingPeriodTwelveMonths414u9C(employee: Person, employer: Person, months: Integer) strict {
    label en official "exact: 12 months when the service is at least 12 months";
    when months_of_service_before_military_414u9C(employee, employer, months) and months >= 12;
    then averaging_period_months_414u9C(employee, employer, 12);
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "if service with the employer is less than such 12-month period, the actual length of continuous service with the employer")
rule AveragingPeriodActualLength414u9C(employee: Person, employer: Person, months: Integer) strict {
    label en official "the actual length when service is less than 12 months";
    when months_of_service_before_military_414u9C(employee, employer, months) and months < 12;
    then averaging_period_months_414u9C(employee, employer, months);
}

pub relation average_actual_contributions_over_period_414u9C(employee: Person, plan: Plan, amount: Money) kind empirical {
    label en unofficial "the individual's average actual employee contributions or elective deferrals over the averaging period, case-asserted (the average is not recomputed here)";
}

pub relation deemed_contribution_for_paragraph_8C_414u9C(employee: Person, plan: Plan, amount: Money) kind institutional {
    label en official "section 414(u)(9)(C): for paragraph (8)(C), the employee contributions and elective deferrals are the individual's average actual amounts over the averaging period";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "shall be determined on the basis of the individual's average actual employee contributions or elective deferrals")
rule DeemedContributionAverage414u9C(employee: Person, plan: Plan, employer: Person, months: Integer, avg: Money) strict {
    label en official "the average over the averaging period for an individual treated as reemployed";
    when averaging_period_months_414u9C(employee, employer, months)
        and average_actual_contributions_over_period_414u9C(employee, plan, avg)
        and employer_treats_as_resumed_employment_414u9A(employee, employer, plan);
    then deemed_contribution_for_paragraph_8C_414u9C(employee, plan, avg);
}

// =====================================================================
// (10) Plans not subject to title 38; (11) frozen reference
// =====================================================================

pub relation plan_outside_chapter43_414u10(plan: Plan) kind empirical {
    label en unofficial "chapter 43 of title 38 does not apply to the retirement plan, case-asserted";
}

pub relation subsection_u_inapplicable_414u10(plan: Plan) kind institutional {
    label en official "section 414(u)(10): this subsection does not apply to a retirement plan to which chapter 43 does not apply";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any retirement plan to which chapter 43 of title 38, United States Code, does not apply")
rule SubsectionInapplicable414u10(plan: Plan) strict {
    label en official "plans outside chapter 43";
    when plan_outside_chapter43_414u10(plan);
    then subsection_u_inapplicable_414u10(plan);
}

pub relation chapter43_reference_date_414u11(employee: Person, on: Date) kind institutional {
    label en official "section 414(u)(11): a reference to chapter 43 is a reference to that chapter as in effect on December 12, 1994, without regard to later amendment";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "as in effect on December 12, 1994 (without regard to any subsequent amendment)")
rule Chapter43ReferenceDate414u11(employee: Person, start: Date, end: Date) strict {
    label en official "the fixed version date for a qualified military service";
    when qualified_military_service_414u5(employee, start, end);
    then chapter43_reference_date_414u11(employee, @1994-12-12);
}

// =====================================================================
// (12) Differential wage payments
// =====================================================================

pub relation differential_wage_payment_414u12(payer: Person, individual: Person, amount: Money) kind empirical {
    label en unofficial "the employer makes a differential wage payment (as defined in section 3401(h)(2)) to an individual performing service in the uniformed services, case-asserted (clause (D))";
}

pub relation plan_subject_to_414u_414u12(plan: Plan) kind empirical {
    label en unofficial "the retirement plan is one to which subsection (u) applies, case-asserted";
}

pub relation individual_treated_as_employee_of_payer_414u12Ai(individual: Person, payer: Person) kind institutional {
    label en official "section 414(u)(12)(A)(i): an individual receiving a differential wage payment is treated as an employee of the employer making the payment";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "an individual receiving a differential wage payment shall be treated as an employee of the employer making the payment")
rule IndividualTreatedAsEmployee414u12Ai(payer: Person, individual: Person, amount: Money, plan: Plan) strict {
    label en official "for a plan to which subsection (u) applies";
    when differential_wage_payment_414u12(payer, individual, amount) and plan_subject_to_414u_414u12(plan) and not_known(subsection_u_inapplicable_414u10(plan));
    then individual_treated_as_employee_of_payer_414u12Ai(individual, payer);
}

pub relation differential_wage_payment_treated_as_compensation_414u12Aii(payer: Person, individual: Person, amount: Money) kind institutional {
    label en official "section 414(u)(12)(A)(ii): the differential wage payment is treated as compensation";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the differential wage payment shall be treated as compensation")
rule DifferentialWagePaymentIsCompensation414u12Aii(payer: Person, individual: Person, amount: Money, plan: Plan) strict {
    label en official "for a plan to which subsection (u) applies";
    when differential_wage_payment_414u12(payer, individual, amount) and plan_subject_to_414u_414u12(plan) and not_known(subsection_u_inapplicable_414u10(plan));
    then differential_wage_payment_treated_as_compensation_414u12Aii(payer, individual, amount);
}

pub relation all_uniformed_service_employees_entitled_on_equivalent_terms_414u12C(employer: Person) kind empirical {
    label en unofficial "all employees of the employer (determined under section 414(b), (c), (m), (o)) performing uniformed service are entitled to differential wage payments, and if eligible to participate in a retirement plan of the employer to make contributions on them, on reasonably equivalent terms (with section 410(b)(3), (4), (5) applying), case-asserted (evaluative)";
}

pub relation plan_not_failing_by_differential_wage_contribution_414u12Aiii(plan: Plan) kind institutional {
    label en official "section 414(u)(12)(A)(iii), (C): the plan is not treated as failing the provisions of paragraph (1)(C) by reason of a contribution or benefit based on a differential wage payment, only if the equivalent-terms requirement is met";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "Subparagraph (A)(iii) shall apply only if all employees of an employer")
rule PlanNotFailingByDifferentialWage414u12Aiii(payer: Person, individual: Person, amount: Money, plan: Plan) strict {
    label en official "the equivalent-terms condition gates clause (A)(iii)";
    when differential_wage_payment_414u12(payer, individual, amount)
        and plan_subject_to_414u_414u12(plan)
        and all_uniformed_service_employees_entitled_on_equivalent_terms_414u12C(payer);
    then plan_not_failing_by_differential_wage_contribution_414u12Aiii(plan);
}

pub relation individual_performing_3401h2A_service_414u12B(individual: Person, plan: Plan) kind empirical {
    label en unofficial "the individual is performing service in the uniformed services described in section 3401(h)(2)(A) during the period, case-asserted";
}

pub relation treated_as_severed_from_employment_414u12Bi(individual: Person, plan: Plan) kind institutional {
    label en official "section 414(u)(12)(B)(i): for section 401(k)(2)(B)(i)(I), 403(b)(7)(A)(ii), 403(b)(11)(A) or 457(d)(1)(A)(ii), the individual is treated as severed from employment during any period of that uniformed service";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "an individual shall be treated as having been severed from employment during any period the individual is performing service in the uniformed services described in section 3401(h)(2)(A)")
rule TreatedAsSeveredFromEmployment414u12Bi(individual: Person, plan: Plan) strict {
    label en official "for the distribution provisions listed";
    when individual_performing_3401h2A_service_414u12B(individual, plan) and plan_subject_to_414u_414u12(plan);
    then treated_as_severed_from_employment_414u12Bi(individual, plan);
}

pub relation distribution_elected_by_reason_of_414u12Bi_on(individual: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the individual elects to receive a distribution by reason of clause (i), case-asserted";
}

pub relation individual_makes_deferral_or_employee_contribution_414u12Bii(individual: Person, plan: Plan) kind empirical {
    label en unofficial "the individual makes an elective deferral or employee contribution, case-asserted (action atom)";
}

@source(IRC_S414_U, relation = formalizes, coverage = exact, quote = "the plan shall provide that the individual may not make an elective deferral or employee contribution during the 6-month period beginning on the date of the distribution")
rule NoDeferralForSixMonthsAfterDistribution414u12Bii(individual: Person, plan: Plan, on: Date, calendar_before_1: Date) strict {
    label en official "exact: the 6-month period begins on the distribution date and ends the day before the 6-month anniversary";
    when distribution_elected_by_reason_of_414u12Bi_on(individual, plan, on) and treated_as_severed_from_employment_414u12Bi(individual, plan)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(on, 6 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then prohibition NoDeferralAfterUniformedServiceDistributionProhibition {
        bearer individual;
        action individual_makes_deferral_or_employee_contribution_414u12Bii(individual, plan);
        window [on, calendar_before_1];
    };
}
