// Section 401(b)-(k) — STAGE 2e residual (IRC-09, DECISION-0379,
// 25.09.2026): (b) retroactive plan changes, (c) self-employed definitions,
// (d) owner-employee contributions, (f) custodial accounts, (g) annuity,
// (h) retiree medical benefits, (i) union-negotiated plans, and the residual
// of (k) cash or deferred arrangements: the qualified arrangement
// classification, permitted distribution events, (k)(4) conditions, the
// pre-ERISA and rural cooperative definitions, (k)(10), (k)(11) SIMPLE 401(k),
// (k)(14) hardship, (k)(16) starter 401(k).
//
// Method: classifications over plan terms (empirical facts), `power` for the
// elections of the employer under (b)(2)/(b)(3), exact date and percentage
// arithmetic, absence of a disqualifying term as `not_known`. Percentages
// are Decimals in percentage points (5.0 = 5 percent).

// =====================================================================
// (b) Certain plan amendments
// =====================================================================

use self::{
    BenefitTrigger436,
    Distribution,
    DistributionEvent403b,
    IRC_S401_B,
    IRC_S401_C,
    IRC_S401_D,
    IRC_S401_F,
    IRC_S401_G,
    IRC_S401_H,
    IRC_S401_I,
    IRC_S401_K,
    Individual,
    PermissibleDistributionEvent,
    Person,
    Plan,
    TaxableYear,
    adp_test_deemed_satisfied_safe_harbor,
    adp_test_passed,
    bank_408n,
    meets_410b_coverage,
    participates_in,
    plan_is_governmental_414d,
    qualified_plan_year_anchor,
};

pub relation plan_cure_completed_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "all provisions of the plan necessary to satisfy section 401(a) are in effect by this date, and made effective for all purposes for the whole retroactive period, case-asserted (section 401(b)(1))";
}

pub relation plan_return_due_with_extensions(plan: Plan, due: Date) kind empirical {
    label en unofficial "the time prescribed by law for filing the employer's return for the taxable year in which the plan or amendment was adopted, including extensions, case-asserted";
}

pub relation plan_failed_401a_from(plan: Plan, from: Date) kind empirical {
    label en unofficial "the earlier of the date the plan was put into effect or the date of an amendment that caused it to fail section 401(a), case-asserted";
}

pub relation plan_treated_as_satisfying_401a_retroactively(plan: Plan, from: Date, until: Date) kind institutional {
    label en official "section 401(b)(1): the plan is considered as satisfying section 401(a) from the start date through the return due date";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "if all provisions of the plan which are necessary to satisfy such requirements are in effect by the end of such period")
rule PlanTreatedAsSatisfying401aRetroactively(plan: Plan, from: Date, due: Date, cured_on: Date) strict {
    label en official "exact boundary: a cure on the due date is in time, one day later is not";
    when plan_failed_401a_from(plan, from)
        and plan_return_due_with_extensions(plan, due)
        and plan_cure_completed_on(plan, cured_on)
        and cured_on <= due;
    then plan_treated_as_satisfying_401a_retroactively(plan, from, due);
}

pub relation retroactive_plan_adopted_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date the employer adopts the plan, case-asserted";
}

pub relation employer_of_plan_401b(employer: Person, plan: Plan) kind empirical {
    label en unofficial "the employer adopting or amending the plan, case-asserted";
}

pub relation taxable_year_close_of_employer(plan: Plan, year_end: Date) kind empirical {
    label en unofficial "the last day of the employer's taxable year with respect to which the plan is adopted, case-asserted";
}

pub relation adoption_election_exercised(employer: Person, plan: Plan, on: Date) kind empirical {
    label en unofficial "the employer elects to treat the plan as adopted on the last day of the taxable year, case-asserted";
}

pub relation adoption_after_year_close_before_return_due(plan: Plan) kind institutional {
    label en official "section 401(b)(2): the plan is adopted after the close of the taxable year but before the return due date (including extensions)";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "If an employer adopts a stock bonus, pension, profit-sharing, or annuity plan after the close of a taxable year but before the time prescribed by law for filing the return of the employer for the taxable year")
rule AdoptionAfterYearCloseBeforeReturnDue(plan: Plan, adopted: Date, year_end: Date, due: Date) strict {
    label en official "exact boundaries: the day after the year close and the return due date are both inside";
    when retroactive_plan_adopted_on(plan, adopted)
        and taxable_year_close_of_employer(plan, year_end)
        and plan_return_due_with_extensions(plan, due)
        and adopted > year_end and adopted <= due;
    then adoption_after_year_close_before_return_due(plan);
}

pub relation plan_treated_as_adopted_on_year_close(plan: Plan, year_end: Date) kind institutional {
    label en official "section 401(b)(2): the plan is treated as adopted as of the last day of the taxable year";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "the employer may elect to treat the plan as having been adopted as of the last day of the taxable year")
rule AdoptionElectionPower(employer: Person, plan: Plan, on: Date, year_end: Date) strict {
    label en official "the employer's election, valid only for an adoption between the year close and the return due date";
    when adoption_election_exercised(employer, plan, on)
        and employer_of_plan_401b(employer, plan)
        and taxable_year_close_of_employer(plan, year_end);
    then power ElectPlanAdoptedAtYearClose {
        holder employer;
        over plan;
        exercise adoption_election_exercised(employer, plan, on);
        valid_when adoption_after_year_close_before_return_due(plan);
        effect plan_treated_as_adopted_on_year_close(plan, year_end);
    };
}

pub relation sole_owner_deferral_made_on(owner: Individual, plan: Plan, on: Date, amount: Money) kind empirical {
    label en unofficial "an elective deferral by the individual who owns the entire interest in an unincorporated business and is its only employee, made on this date, case-asserted (section 401(b)(2) second sentence)";
}

pub relation sole_owner_return_due_without_extension(owner: Individual, due: Date) kind empirical {
    label en unofficial "the time for filing the owner's return for the year ending after or with the end of the plan's first plan year, determined without extensions, case-asserted";
}

pub relation sole_owner_deferral_treated_in_first_plan_year(owner: Individual, plan: Plan, amount: Money) kind institutional {
    label en official "section 401(b)(2): such a deferral made before the return due date (without extensions) is treated as made before the end of the first plan year";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "shall be treated as having been made before the end of such first plan year")
rule SoleOwnerDeferralTreatedInFirstPlanYear(owner: Individual, plan: Plan, on: Date, amount: Money, due: Date) strict {
    label en official "exact boundary: on the due date is in time";
    when adoption_after_year_close_before_return_due(plan)
        and sole_owner_deferral_made_on(owner, plan, on, amount)
        and sole_owner_return_due_without_extension(owner, due)
        and on <= due;
    then sole_owner_deferral_treated_in_first_plan_year(owner, plan, amount);
}

pub relation amendment_increases_accruals_retroactively(plan: Plan, effective_on: Date, adopted_on: Date) kind empirical {
    label en unofficial "the employer amends the plan to increase accrued benefits (other than matching contributions) effective as of a date in the immediately preceding plan year, adopted on this date, case-asserted (section 401(b)(3)(A))";
}

pub relation amendment_otherwise_meets_requirements(plan: Plan, adopted_on: Date) kind empirical {
    label en unofficial "the amendment would not otherwise cause the plan to fail any requirement of the subchapter, case-asserted (section 401(b)(3)(B))";
}

pub relation retroactive_amendment_election_exercised(employer: Person, plan: Plan, adopted_on: Date) kind empirical {
    label en unofficial "the employer elects to treat the amendment as adopted on the last day of the plan year in which it is effective, case-asserted";
}

pub relation retroactive_accrual_amendment_eligible(plan: Plan, adopted_on: Date) kind institutional {
    label en official "section 401(b)(3)(A)-(C): an accrual-increasing amendment effective in the preceding plan year, otherwise compliant, adopted by the return due date";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "such amendment is adopted before the time prescribed by law for filing the return of the employer for the taxable year (including extensions thereof) which includes the date described in subparagraph (A)")
rule RetroactiveAccrualAmendmentEligible(plan: Plan, effective_on: Date, adopted_on: Date, due: Date) strict {
    label en official "(A), (B) and (C); exact boundary on the return due date";
    when amendment_increases_accruals_retroactively(plan, effective_on, adopted_on)
        and amendment_otherwise_meets_requirements(plan, adopted_on)
        and plan_return_due_with_extensions(plan, due)
        and adopted_on <= due;
    then retroactive_accrual_amendment_eligible(plan, adopted_on);
}

pub relation amendment_treated_as_adopted_at_plan_year_end(plan: Plan, adopted_on: Date) kind institutional {
    label en official "section 401(b)(3): the amendment is treated as adopted on the last day of the plan year in which it is effective";
}

@source(IRC_S401_B, relation = formalizes, coverage = exact, quote = "the employer may elect to treat such amendment as having been adopted as of the last day of the plan year in which the amendment is effective")
rule RetroactiveAmendmentElectionPower(employer: Person, plan: Plan, adopted_on: Date) strict {
    label en official "the employer's election; valid when the amendment is eligible";
    when retroactive_amendment_election_exercised(employer, plan, adopted_on);
    then power ElectRetroactiveAmendment {
        holder employer;
        over plan;
        exercise retroactive_amendment_election_exercised(employer, plan, adopted_on);
        valid_when retroactive_accrual_amendment_eligible(plan, adopted_on);
        effect amendment_treated_as_adopted_at_plan_year_end(plan, adopted_on);
    };
}

// =====================================================================
// (c) Definitions relating to self-employed individuals
// =====================================================================

pub enum EarnedIncomeItem401c {
    NetEarningsFromSelfEmployment;
    ExcludedItemsAndTheirDeductions;
    Section404Deduction;
    Section164fDeduction;
    PropertyCreatedByPersonalEfforts;
}

pub relation earned_income_component(individual: Individual, y: TaxableYear, item: EarnedIncomeItem401c, amount: Money) kind empirical {
    label en unofficial "a component of earned income, signed as it enters the total: net earnings from self-employment under section 1402(a) (from a business in which personal services are a material income-producing factor, without regard to section 1402(c)(4)-(5), and (2)(A)(iii) items), the removal of items not included in gross income with their deductions, the section 404 deduction, the section 164(f) deduction, and gains from property created by the individual's personal efforts ((c)(2)(C)), case-asserted";
}

pub relation personal_services_material_income_factor(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "personal services of the taxpayer are a material income-producing factor in the trade or business, case-asserted (section 401(c)(2)(A)(i))";
}

pub relation earned_income_401c2(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(c)(2): net earnings from self-employment as adjusted by (A)(i)-(vi) plus the (C) gains";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "The term \"earned income\" means the net earnings from self-employment (as defined in section 1402(a))")
rule EarnedIncome401c2(individual: Individual, y: TaxableYear, base: Money) strict {
    label en official "sum of the signed components; requires the material-factor condition";
    when personal_services_material_income_factor(individual, y)
        and earned_income_component(individual, y, NetEarningsFromSelfEmployment, base);
    then earned_income_401c2(individual, y,
        base + sum all amt: Money for k: EarnedIncomeItem401c where earned_income_component(individual, y, k, amt) and k != NetEarningsFromSelfEmployment);
}

pub relation self_employed_individual_401c1B(individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 401(c)(1)(B): an individual who has earned income for the taxable year";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "The term \"self-employed individual\" means, with respect to any taxable year, an individual who has earned income (as defined in paragraph (2)) for such taxable year.")
rule SelfEmployedIndividual401c1B(individual: Individual, y: TaxableYear, amount: Money) strict {
    label en official "earned income exists for the year";
    when earned_income_401c2(individual, y, amount);
    then self_employed_individual_401c1B(individual, y);
}

pub relation fisherman_3121b20(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual is described in section 3121(b)(20) (certain fishermen), case-asserted";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "the term \"self-employed individual\" includes an individual described in section 3121(b)(20) (relating to certain fishermen)")
rule SelfEmployedIndividualFisherman(individual: Individual, y: TaxableYear) strict {
    label en official "(c)(6) for purposes of subsection (k)";
    when fisherman_3121b20(individual, y);
    then self_employed_individual_401c1B(individual, y);
}

pub relation employee_including_self_employed_401c1A(individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 401(c)(1)(A): the term employee includes, for a taxable year, a self-employed individual";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "The term \"employee\" includes, for any taxable year, an individual who is a self-employed individual for such taxable year.")
rule EmployeeIncludingSelfEmployed401c1A(individual: Individual, y: TaxableYear) strict {
    label en official "self-employed individuals are employees";
    when self_employed_individual_401c1B(individual, y);
    then employee_including_self_employed_401c1A(individual, y);
}

pub relation owns_entire_interest_in_unincorporated_business(individual: Individual) kind empirical {
    label en unofficial "the employee owns the entire interest in an unincorporated trade or business, case-asserted";
}

pub relation partner_capital_percent(individual: Individual, pct: Decimal) kind empirical {
    label en unofficial "the partner's percentage of the capital interest of the partnership, case-asserted";
}

pub relation partner_profits_percent(individual: Individual, pct: Decimal) kind empirical {
    label en unofficial "the partner's percentage of the profits interest of the partnership, case-asserted";
}

pub relation owner_employee_401c3(individual: Individual) kind institutional {
    label en official "section 401(c)(3): an employee who owns the entire interest in an unincorporated business, or a partner who owns more than 10 percent of the capital or profits interest";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "owns the entire interest in an unincorporated trade or business")
rule OwnerEmployeeSoleProprietor(individual: Individual) strict {
    label en official "(A)";
    when owns_entire_interest_in_unincorporated_business(individual);
    then owner_employee_401c3(individual);
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "is a partner who owns more than 10 percent of either the capital interest or the profits interest in such partnership")
rule OwnerEmployeePartnerCapital(individual: Individual, pct: Decimal) strict {
    label en official "(B): exact boundary, more than 10 percent (10.0 does not qualify)";
    when partner_capital_percent(individual, pct) and pct > 10.0;
    then owner_employee_401c3(individual);
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "is a partner who owns more than 10 percent of either the capital interest or the profits interest in such partnership")
rule OwnerEmployeePartnerProfits(individual: Individual, pct: Decimal) strict {
    label en official "(B), profits branch";
    when partner_profits_percent(individual, pct) and pct > 10.0;
    then owner_employee_401c3(individual);
}

pub relation employer_of_self_employed_401c4(employer: Person, employee: Individual) kind institutional {
    label en official "section 401(c)(4): a sole proprietor is his own employer; a partnership is the employer of each partner who is an employee";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "An individual who owns the entire interest in an unincorporated trade or business shall be treated as his own employer.")
rule SoleProprietorIsOwnEmployer(individual: Individual) strict {
    label en official "own employer";
    when owns_entire_interest_in_unincorporated_business(individual);
    then employer_of_self_employed_401c4(individual, individual);
}

pub relation partner_of_partnership_employee(partnership: Person, partner: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the individual is a partner of the partnership who is an employee within paragraph (1), case-asserted";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "A partnership shall be treated as the employer of each partner who is an employee within the meaning of paragraph (1).")
rule PartnershipIsEmployerOfPartner(partnership: Person, partner: Individual, y: TaxableYear) strict {
    label en official "partnership employer";
    when partner_of_partnership_employee(partnership, partner, y) and employee_including_self_employed_401c1A(partner, y);
    then employer_of_self_employed_401c4(partnership, partner);
}

pub relation contribution_on_behalf_of_owner_employee(plan: Plan, owner: Individual, y: TaxableYear, by_employer: Money, by_owner_as_employee: Money) kind empirical {
    label en unofficial "contributions under the plan for the owner-employee, by the employer and by the owner as an employee, case-asserted (section 401(c)(5))";
}

pub relation contribution_on_behalf_of_owner_employee_total(plan: Plan, owner: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(c)(5): a contribution on behalf of an owner-employee includes those by the employer and by the owner as an employee";
}

@source(IRC_S401_C, relation = formalizes, coverage = exact, quote = "The term \"contribution on behalf of an owner-employee\" includes, except as the context otherwise requires, a contribution under a plan")
rule ContributionOnBehalfOfOwnerEmployeeTotal(plan: Plan, owner: Individual, y: TaxableYear, er: Money, ee: Money) strict {
    label en official "both kinds are counted";
    when contribution_on_behalf_of_owner_employee(plan, owner, y, er, ee);
    then contribution_on_behalf_of_owner_employee_total(plan, owner, y, er + ee);
}

// =====================================================================
// (d) Contribution limit on owner-employees; (f); (g); (h); (i)
// =====================================================================

pub relation earned_income_from_plan_business(owner: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the owner-employee's earned income derived from the trade or business with respect to which the plan is established, case-asserted";
}

pub relation owner_employee_contributions_within_earned_income(plan: Plan, owner: Individual, y: TaxableYear) kind institutional {
    label en official "section 401(d): contributions on behalf of an owner-employee are made only with respect to his earned income from the plan's business";
}

@source(IRC_S401_D, relation = formalizes, coverage = exact, quote = "contributions on behalf of any owner-employee may be made only with respect to the earned income of such owner-employee which is derived from the trade or business with respect to which such plan is established")
rule OwnerEmployeeContributionsWithinEarnedIncome(plan: Plan, owner: Individual, y: TaxableYear, total: Money, earned: Money) strict {
    label en official "exact: contributions not above earned income from the plan business";
    when contribution_on_behalf_of_owner_employee_total(plan, owner, y, total)
        and earned_income_from_plan_business(owner, y, earned)
        and total <= earned;
    then owner_employee_contributions_within_earned_income(plan, owner, y);
}

pub entity CustodialAccountOrContract401f : Plan {
    label en unofficial "a custodial account, annuity contract or insurer-issued contract that would be a qualified trust but for not being a trust (section 401(f))";
}

pub relation contract_kind_excluded_from_401f(c: CustodialAccountOrContract401f) kind empirical {
    label en unofficial "the contract is a life, health or accident, property, casualty or liability insurance contract, case-asserted";
}

pub relation would_be_qualified_trust_but_for_form(c: CustodialAccountOrContract401f) kind empirical {
    label en unofficial "the account or contract would, except for not being a trust, constitute a qualified trust, case-asserted (section 401(f)(1))";
}

pub relation custodial_assets_held_by_401f(c: CustodialAccountOrContract401f, holder: Person) kind empirical {
    label en unofficial "the assets of the custodial account are held by this person, case-asserted";
}

external judgment relation holder_demonstrates_consistent_holding_401f(c: CustodialAccountOrContract401f) {
    authority Secretary;
    label en official "section 401(f)(2): a person other than a bank demonstrates to the Secretary's satisfaction that the manner of holding the assets is consistent with the requirements of the section";
}

pub relation treated_as_qualified_trust_401f(c: CustodialAccountOrContract401f) kind institutional {
    label en official "section 401(f): treated as a qualified trust; the holder is treated as the trustee";
}

@source(IRC_S401_F, relation = formalizes, coverage = exact, quote = "in the case of a custodial account the assets thereof are held by a bank (as defined in section 408(n))")
rule TreatedAsQualifiedTrust401fBank(c: CustodialAccountOrContract401f, holder: Person) strict {
    label en official "custodial account held by a bank";
    when would_be_qualified_trust_but_for_form(c)
        and custodial_assets_held_by_401f(c, holder)
        and bank_408n(holder);
    then treated_as_qualified_trust_401f(c);
}

@source(IRC_S401_F, relation = formalizes, coverage = exact, quote = "or another person who demonstrates, to the satisfaction of the Secretary, that the manner in which he will hold the assets will be consistent with the requirements of this section")
rule TreatedAsQualifiedTrust401fOther(c: CustodialAccountOrContract401f, holder: Person) strict {
    label en official "custodial account held by another person satisfying the Secretary";
    when would_be_qualified_trust_but_for_form(c)
        and custodial_assets_held_by_401f(c, holder)
        and holder_demonstrates_consistent_holding_401f(c);
    then treated_as_qualified_trust_401f(c);
}

@source(IRC_S401_F, relation = formalizes, coverage = exact, quote = "a custodial account, an annuity contract, or a contract (other than a life, health or accident, property, casualty, or liability insurance contract) issued by an insurance company qualified to do business in a State")
rule TreatedAsQualifiedTrust401fContract(c: CustodialAccountOrContract401f) strict {
    label en official "an annuity or other non-insurance-line contract issued by a qualified insurer";
    when would_be_qualified_trust_but_for_form(c)
        and contract_issued_by_state_qualified_insurer(c)
        and not_known(contract_kind_excluded_from_401f(c));
    then treated_as_qualified_trust_401f(c);
}

pub relation contract_issued_by_state_qualified_insurer(c: CustodialAccountOrContract401f) kind empirical {
    label en unofficial "the contract is issued by an insurance company qualified to do business in a State, case-asserted";
}

pub relation annuity_401g_kind_face_amount_certificate(contract: Person) kind empirical {
    label en unofficial "the instrument is a face-amount certificate as defined in section 2(a)(15) of the Investment Company Act of 1940, case-asserted";
}

pub relation contract_issued_after_1962_transferable_owner_not_trustee(contract: Person) kind empirical {
    label en unofficial "the contract or certificate was issued after December 31, 1962, is transferable, and is owned by a person other than the trustee of a section 401(a)/501(a) trust, case-asserted";
}

pub relation annuity_for_401_403_404(contract: Person) kind institutional {
    label en official "section 401(g): for sections 401, 402, 403 and 404 the term annuity includes a face-amount certificate, but not a transferable post-1962 contract owned by someone other than the trustee";
}

@source(IRC_S401_G, relation = formalizes, coverage = exact, quote = "the term \"annuity\" includes a face-amount certificate")
rule AnnuityIncludesFaceAmountCertificate(contract: Person) strict {
    label en official "inclusion, unless the exclusion applies";
    when annuity_401g_kind_face_amount_certificate(contract)
        and not_known(contract_issued_after_1962_transferable_owner_not_trustee(contract));
    then annuity_for_401_403_404(contract);
}

pub relation retiree_medical_benefits_subordinate(plan: Plan) kind empirical {
    label en unofficial "the medical benefits are subordinate to the retirement benefits, case-asserted (section 401(h)(1))";
}

pub relation retiree_medical_separate_account(plan: Plan) kind empirical {
    label en unofficial "a separate account is established and maintained for the benefits, case-asserted (h)(2)";
}

pub relation retiree_medical_contributions_reasonable_ascertainable(plan: Plan) kind empirical {
    label en unofficial "the employer's contributions to the account are reasonable and ascertainable, case-asserted (h)(3)";
}

pub relation retiree_medical_no_diversion_possible(plan: Plan) kind empirical {
    label en unofficial "it is impossible before all liabilities are satisfied for the account's corpus or income to be diverted, case-asserted (h)(4)";
}

pub relation retiree_medical_remainder_returned_to_employer(plan: Plan) kind empirical {
    label en unofficial "on satisfaction of all liabilities any remaining amount must be returned to the employer under the plan terms, case-asserted (h)(5)";
}

pub relation retiree_medical_key_employee_separate_account(plan: Plan) kind empirical {
    label en unofficial "for each key employee a separate account is maintained and payable only to him, his spouse and dependents (h)(6), or the plan has no key employee, case-asserted";
}

pub relation retiree_medical_contributions_and_life_insurance(plan: Plan, medical_plus_life: Money, total_actual: Money) kind empirical {
    label en unofficial "aggregate actual contributions for medical benefits plus life insurance protection, and total actual contributions (other than for past service credits) after the account was established, case-asserted";
}

pub relation retiree_medical_25_percent_limit_ok(plan: Plan) kind institutional {
    label en official "section 401(h): the requirement that benefits be subordinate is not treated as met if medical plus life insurance contributions exceed 25 percent of total contributions";
}

@source(IRC_S401_H, relation = formalizes, coverage = exact, quote = "In no event shall the requirements of paragraph (1) be treated as met if the aggregate actual contributions for medical benefits, when added to actual contributions for life insurance protection under the plan, exceed 25 percent of the total actual contributions to the plan")
rule RetireeMedical25PercentLimitOk(plan: Plan, part: Money, total: Money) strict {
    label en official "exact by cross-multiplication: exactly 25 percent is allowed";
    when retiree_medical_contributions_and_life_insurance(plan, part, total) and part * 4.0 <= total;
    then retiree_medical_25_percent_limit_ok(plan);
}

pub relation retiree_medical_plan_permitted_401h(plan: Plan) kind institutional {
    label en official "section 401(h): a pension or annuity plan may provide retiree medical benefits only if conditions (1)-(6) hold and the 25 percent limit is met";
}

@source(IRC_S401_H, relation = formalizes, coverage = exact, quote = "a pension or annuity plan may provide for the payment of benefits for sickness, accident, hospitalization, and medical expenses of retired employees, their spouses and their dependents, but only if")
rule RetireeMedicalPlanPermitted401h(plan: Plan) strict {
    label en official "all six conditions and the 25 percent limit";
    when retiree_medical_benefits_subordinate(plan)
        and retiree_medical_separate_account(plan)
        and retiree_medical_contributions_reasonable_ascertainable(plan)
        and retiree_medical_no_diversion_possible(plan)
        and retiree_medical_remainder_returned_to_employer(plan)
        and retiree_medical_key_employee_separate_account(plan)
        and retiree_medical_25_percent_limit_ok(plan);
    then retiree_medical_plan_permitted_401h(plan);
}

pub relation retired_employee_child_age_at_year_end(child: Person, age: Integer) kind empirical {
    label en unofficial "the age at the end of the calendar year of a child (section 152(f)(1)) of a retired employee, case-asserted";
}

pub relation dependent_for_401h(child: Person) kind institutional {
    label en official "section 401(h): a dependent includes a child of a retired employee who has not attained age 27 by the end of the calendar year";
}

@source(IRC_S401_H, relation = formalizes, coverage = exact, quote = "the term \"dependent\" shall include any individual who is a child (as defined in section 152(f)(1)) of a retired employee who as of the end of the calendar year has not attained age 27")
rule DependentFor401h(child: Person, age: Integer) strict {
    label en official "exact boundary: age 26 qualifies, age 27 does not";
    when retired_employee_child_age_at_year_end(child, age) and age < 27;
    then dependent_for_401h(child);
}

pub relation union_trust_created_under_collective_bargaining(plan: Plan) kind empirical {
    label en unofficial "the trust was created pursuant to a collective bargaining agreement between employee representatives and one or more employers, case-asserted (section 401(i)(1))";
}

pub relation union_trust_disbursements_substantially_complied(plan: Plan) kind empirical {
    label en unofficial "disbursements before qualification substantially complied with the terms of the trust and the plan as subsequently qualified, case-asserted (401(i)(2))";
}

pub relation union_trust_contributions_not_jeopardizing(plan: Plan) kind empirical {
    label en unofficial "before qualification the contributions were not used in a manner jeopardizing the beneficiaries' interests, case-asserted (401(i)(3))";
}

pub relation union_plan_qualified_determination(plan: Plan, first_contributions_on: Date, first_qualified_on: Date) kind empirical {
    label en unofficial "the Secretary determined the trust qualified for a period beginning after contributions were first made; the first contribution date and the date it first qualified without subsection (i), case-asserted";
}

external judgment relation union_plan_shown_to_secretary(plan: Plan) {
    authority Secretary;
    label en official "section 401(i): it is shown to the satisfaction of the Secretary that the three conditions are met";
}

pub relation union_trust_treated_as_qualified_from(plan: Plan, start: Date, end: Date) kind institutional {
    label en official "section 401(i): the trust is considered qualified and exempt from the first contribution date until it first qualified without the subsection";
}

@source(IRC_S401_I, relation = formalizes, coverage = exact, quote = "then such trust shall be considered as having constituted a qualified trust under subsection (a) and as having been exempt from taxation under section 501(a) for the period beginning on the date on which contributions were first made")
rule UnionTrustTreatedAsQualifiedFrom(plan: Plan, start: Date, end: Date) strict {
    label en official "the three conditions plus the Secretary's satisfaction (judgment channel)";
    when union_plan_qualified_determination(plan, start, end)
        and union_trust_created_under_collective_bargaining(plan)
        and union_trust_disbursements_substantially_complied(plan)
        and union_trust_contributions_not_jeopardizing(plan)
        and union_plan_shown_to_secretary(plan);
    then union_trust_treated_as_qualified_from(plan, start, end);
}

// =====================================================================
// (k)(1)-(2) The qualified cash or deferred arrangement; distribution events
// =====================================================================

pub enum CodaPlanKind401k {
    ProfitSharingOrStockBonus;
    PreErisaMoneyPurchase;
    RuralCooperative;
}

pub relation coda_plan_kind(plan: Plan, kind: CodaPlanKind401k) kind empirical {
    label en unofficial "the plan of which the arrangement is a part is a profit-sharing or stock bonus plan, a pre-ERISA money purchase plan, or a rural cooperative plan meeting subsection (a), case-asserted (section 401(k)(1), (2))";
}

pub relation coda_election_available(plan: Plan) kind empirical {
    label en unofficial "a covered employee may elect to have the employer make payments as contributions to the trust or to the employee in cash, case-asserted (401(k)(2)(A))";
}

pub relation coda_amounts_subject_to_distribution_limits(plan: Plan) kind empirical {
    label en unofficial "amounts attributable to elective contributions may not be distributed earlier than the (B)(i) events and not merely by the lapse of a stated period, and lifetime income amounts only as (B)(iii) provides, case-asserted";
}

pub relation coda_elective_benefit_nonforfeitable(plan: Plan) kind empirical {
    label en unofficial "the employee's right to the accrued benefit derived from election contributions is nonforfeitable, case-asserted (401(k)(2)(C))";
}

pub relation coda_service_requirement_months(plan: Plan, months: Integer) kind empirical {
    label en unofficial "the period of service the arrangement requires as a condition of participation, in months, case-asserted";
}

pub relation coda_allowed_410a1_months(plan: Plan, months: Integer) kind empirical {
    label en unofficial "the period permitted under section 410(a)(1) (without regard to subparagraph (B)(i)), in months, case-asserted";
}

pub relation coda_two_consecutive_500_hour_periods_months(plan: Plan, months: Integer) kind empirical {
    label en unofficial "the first period of 2 consecutive 12-month periods in each of which the employee has at least 500 hours of service, in months, case-asserted (subject to paragraph (15))";
}

pub relation coda_service_condition_ok(plan: Plan) kind institutional {
    label en official "section 401(k)(2)(D): no service requirement beyond the earlier of the section 410(a)(1) period or the two consecutive 500-hour years";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "which does not require, as a condition of participation in the arrangement, that an employee complete a period of service with the employer (or employers) maintaining the plan extending beyond the close of the earlier of")
rule CodaServiceConditionOk(plan: Plan, required: Integer, m1: Integer, m2: Integer) strict {
    label en official "exact boundary: the required months not above min(m1, m2)";
    when coda_service_requirement_months(plan, required)
        and coda_allowed_410a1_months(plan, m1)
        and coda_two_consecutive_500_hour_periods_months(plan, m2)
        and required <= min(m1, m2);
    then coda_service_condition_ok(plan);
}

pub relation plan_type_permits_coda(plan: Plan) kind institutional {
    label en official "section 401(k)(1)/(2): a profit-sharing, stock bonus, pre-ERISA money purchase or rural cooperative plan is not disqualified merely for including a qualified arrangement";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A profit-sharing or stock bonus plan, a pre-ERISA money purchase plan, or a rural cooperative plan shall not be considered as not satisfying the requirements of subsection (a) merely because the plan includes a qualified cash or deferred arrangement.")
rule PlanTypePermitsCoda(plan: Plan, kind: CodaPlanKind401k) strict {
    label en official "any of the three plan kinds";
    when coda_plan_kind(plan, kind);
    then plan_type_permits_coda(plan);
}

pub relation coda_benefit_conditioned_on_election(plan: Plan) kind empirical {
    label en unofficial "some other benefit (beyond a de minimis financial incentive not paid from plan assets, and beyond a matching contribution) is conditioned directly or indirectly on the employee's election to make or not make contributions, case-asserted (section 401(k)(4)(A))";
}

pub relation plan_maintained_by_state_or_local_government(plan: Plan) kind empirical {
    label en unofficial "the plan is maintained by a State or local government, political subdivision, agency or instrumentality, case-asserted (section 401(k)(4)(B)(ii))";
}

pub relation plan_maintained_by_tribal_government_employer(plan: Plan) kind empirical {
    label en unofficial "the employer is an Indian tribal government, subdivision, agency or instrumentality, or a corporation owned in whole or part by them, case-asserted (401(k)(4)(B)(iii))";
}

pub relation government_plan_ineligible_for_coda(plan: Plan) kind institutional {
    label en official "section 401(k)(4)(B)(ii): a State or local government plan cannot include a qualified arrangement, unless it is a rural cooperative plan or a tribal employer's plan";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement shall not be treated as a qualified cash or deferred arrangement if it is part of a plan maintained by a State or local government or political subdivision thereof, or any agency or instrumentality thereof.")
rule GovernmentPlanIneligibleForCoda(plan: Plan) strict {
    label en official "governments ineligible, with the two carve-outs";
    when plan_maintained_by_state_or_local_government(plan)
        and not_known(coda_plan_kind(plan, RuralCooperative))
        and not_known(plan_maintained_by_tribal_government_employer(plan));
    then government_plan_ineligible_for_coda(plan);
}

pub relation coda_nondiscrimination_and_coverage_ok(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(3): coverage under section 410(b)(1) and the ADP test (or a safe harbor, or a governmental plan)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "those employees eligible to benefit under the arrangement satisfy the provisions of section 410(b)(1)")
rule CodaNondiscriminationAndCoverageOk(plan: Plan, y: TaxableYear) defeasible {
    label en official "coverage plus an ADP test passed";
    when meets_410b_coverage(plan, y) and adp_test_passed(plan, y);
    then coda_nondiscrimination_and_coverage_ok(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A governmental plan (within the meaning of section 414(d)) shall be treated as meeting the requirements of this paragraph.")
rule CodaNondiscriminationGovernmental(plan: Plan, y: TaxableYear) defeasible {
    label en official "(3)(G)";
    when plan_is_governmental_414d(plan) and qualified_plan_year_anchor(plan, y);
    then coda_nondiscrimination_and_coverage_ok(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the actual deferral percentage")
rule CodaNondiscriminationSafeHarbor(plan: Plan, y: TaxableYear) defeasible {
    label en official "a safe harbor arrangement is treated as meeting (3)(A)(ii); coverage is still required";
    when meets_410b_coverage(plan, y) and adp_test_deemed_satisfied_safe_harbor(plan, y);
    then coda_nondiscrimination_and_coverage_ok(plan, y);
}

pub relation qualified_cash_or_deferred_arrangement(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(2)-(4): an arrangement in an eligible plan kind with the election, distribution limits, nonforfeitability, service condition, nondiscrimination, no contingent benefits, and an eligible sponsor";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A qualified cash or deferred arrangement is any arrangement which is part of a profit-sharing or stock bonus plan, a pre-ERISA money purchase plan, or a rural cooperative plan which meets the requirements of subsection (a)")
rule QualifiedCashOrDeferredArrangement(plan: Plan, y: TaxableYear) defeasible {
    label en official "all conjuncts; the (3) result is defeasible so this rule is too";
    when plan_type_permits_coda(plan)
        and coda_election_available(plan)
        and coda_amounts_subject_to_distribution_limits(plan)
        and coda_elective_benefit_nonforfeitable(plan)
        and coda_service_condition_ok(plan)
        and coda_nondiscrimination_and_coverage_ok(plan, y)
        and not_known(coda_benefit_conditioned_on_election(plan))
        and not_known(government_plan_ineligible_for_coda(plan));
    then qualified_cash_or_deferred_arrangement(plan, y);
}

pub enum CodaDistributionEvent {
    SeveranceFromEmployment;
    Death;
    Disability;
    PlanTerminationEvent;
    Age59AndAHalf;
    Hardship;
    QualifiedReservistDistribution;
    LifetimeIncomeWindow;
}

pub relation coda_distribution_event_fact(d: Distribution, ev: CodaDistributionEvent) kind empirical {
    label en unofficial "the event on which the distribution is made, case-asserted";
}

pub relation distributee_age_on_coda_distribution(d: Distribution, age: Decimal) kind empirical {
    label en unofficial "the distributee's age at the distribution, in years with fractions, case-asserted";
}

pub relation coda_plan_of_distribution(d: Distribution, plan: Plan) kind empirical {
    label en unofficial "the plan from which the elective amounts are distributed, case-asserted";
}

pub relation coda_distribution_event_permitted(d: Distribution, ev: CodaDistributionEvent) kind institutional {
    label en official "section 401(k)(2)(B)(i): elective amounts are distributable only on severance, death, disability, a (10) event, age 59 1/2 (profit-sharing or stock bonus plans), hardship, a qualified reservist distribution, or the lifetime income window";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "severance from employment, death, or disability")
rule CodaEventSeverance(d: Distribution) strict {
    label en official "(I): severance";
    when coda_distribution_event_fact(d, SeveranceFromEmployment);
    then coda_distribution_event_permitted(d, SeveranceFromEmployment);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "severance from employment, death, or disability")
rule CodaEventDeath(d: Distribution) strict {
    label en official "(I): death";
    when coda_distribution_event_fact(d, Death);
    then coda_distribution_event_permitted(d, Death);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "severance from employment, death, or disability")
rule CodaEventDisability(d: Distribution) strict {
    label en official "(I): disability";
    when coda_distribution_event_fact(d, Disability);
    then coda_distribution_event_permitted(d, Disability);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "an event described in paragraph (10)")
rule CodaEventPlanTermination(d: Distribution) strict {
    label en official "(II): a (10) termination event";
    when coda_distribution_event_fact(d, PlanTerminationEvent);
    then coda_distribution_event_permitted(d, PlanTerminationEvent);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in the case of a profit-sharing or stock bonus plan, the attainment of age 59½")
rule CodaEventAge59AndAHalf(d: Distribution, plan: Plan, age: Decimal) strict {
    label en official "(III): exact boundary 59.5; only profit-sharing or stock bonus plans";
    when coda_distribution_event_fact(d, Age59AndAHalf)
        and coda_plan_of_distribution(d, plan)
        and coda_plan_kind(plan, ProfitSharingOrStockBonus)
        and distributee_age_on_coda_distribution(d, age)
        and age >= 59.5;
    then coda_distribution_event_permitted(d, Age59AndAHalf);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "shall not be treated as violating the requirements of section 401(a) or of paragraph (2) merely by reason of a hardship distribution or a distribution to a participant after attainment of age 59½")
rule CodaEventAge59AndAHalfRuralCooperative(d: Distribution, plan: Plan, age: Decimal) strict {
    label en official "(k)(7)(C): a rural cooperative plan may distribute at age 59 1/2 as well (exact boundary 59.5)";
    when coda_distribution_event_fact(d, Age59AndAHalf)
        and coda_plan_of_distribution(d, plan)
        and coda_plan_kind(plan, RuralCooperative)
        and distributee_age_on_coda_distribution(d, age)
        and age >= 59.5;
    then coda_distribution_event_permitted(d, Age59AndAHalf);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in the case of a qualified reservist distribution (as defined in section 72(t)(2)(G)(iii))")
rule CodaEventReservist(d: Distribution) strict {
    label en official "(V)";
    when coda_distribution_event_fact(d, QualifiedReservistDistribution);
    then coda_distribution_event_permitted(d, QualifiedReservistDistribution);
}

pub relation coda_lifetime_income_no_longer_held_on(d: Distribution, on: Date) kind empirical {
    label en unofficial "the date the lifetime income investment may no longer be held as an option under the arrangement, case-asserted";
}

pub relation coda_lifetime_income_distribution_on(d: Distribution, on: Date) kind empirical {
    label en unofficial "the date of the distribution of amounts invested in a lifetime income investment, case-asserted";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the date that is 90 days prior to the date that such lifetime income investment may no longer be held as an investment option under the arrangement")
rule CodaEventLifetimeIncomeWindow(d: Distribution, ends: Date, on: Date, calendar_before_1: Date) strict {
    label en official "(VI): exact boundary at 90 days before";
    when coda_distribution_event_fact(d, LifetimeIncomeWindow)
        and coda_lifetime_income_no_longer_held_on(d, ends)
        and coda_lifetime_income_distribution_on(d, on)
        and on >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(ends, 90, us.irc.core::CalendarDay, calendar_before_1);
    then coda_distribution_event_permitted(d, LifetimeIncomeWindow);
}

pub relation coda_distribution_by_stated_period_only(d: Distribution) kind empirical {
    label en unofficial "the amount is distributable merely by reason of the completion of a stated period of participation or the lapse of a fixed number of years, case-asserted (401(k)(2)(B)(ii))";
}

pub relation coda_distribution_lawful(d: Distribution) kind institutional {
    label en official "section 401(k)(2)(B)(i)-(ii): a permitted event and no distribution merely by lapse of a stated period";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "will not be distributable merely by reason of the completion of a stated period of participation or the lapse of a fixed number of years")
rule CodaDistributionLawful(d: Distribution, ev: CodaDistributionEvent) strict {
    label en official "a permitted event, without the stated-period ground";
    when coda_distribution_event_permitted(d, ev) and not_known(coda_distribution_by_stated_period_only(d));
    then coda_distribution_lawful(d);
}

// (k)(10) Termination events; (k)(6)-(7) definitions ----------------------

pub relation plan_terminated_without_other_dc_plan(plan: Plan) kind empirical {
    label en unofficial "the plan terminates without the establishment or maintenance of another defined contribution plan (other than an ESOP), case-asserted (401(k)(10)(A))";
}

pub relation employee_received_lump_sum_on_termination(employee: Person, plan: Plan) kind empirical {
    label en unofficial "the employee receives a lump sum distribution by reason of the termination (section 402(e)(4)(D) without subclauses (I)-(IV), including a distribution of an annuity contract from a qualifying trust or annuity plan), case-asserted";
}

pub relation termination_event_described_401k10(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(k)(10): a termination without a successor defined contribution plan, and only for an employee who receives a lump sum by reason of it";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A termination shall not be treated as described in subparagraph (A) with respect to any employee unless the employee receives a lump sum distribution by reason of the termination.")
rule TerminationEventDescribed401k10(employee: Person, plan: Plan) strict {
    label en official "(A) and (B)(i)";
    when plan_terminated_without_other_dc_plan(plan) and employee_received_lump_sum_on_termination(employee, plan);
    then termination_event_described_401k10(employee, plan);
}

pub relation plan_is_dc_plan_414i(plan: Plan) kind empirical {
    label en unofficial "the pension plan is a defined contribution plan within section 414(i), case-asserted";
}

pub relation plan_in_existence_june_27_1974_with_salary_reduction(plan: Plan, existed_on: Date) kind empirical {
    label en unofficial "the plan was in existence on this date and on that date included a salary reduction arrangement, case-asserted";
}

pub relation contributions_within_1974_formula_levels(plan: Plan) kind empirical {
    label en unofficial "neither employee nor employer contributions exceed the levels of the contribution formula in effect on June 27, 1974, case-asserted (401(k)(6)(C))";
}

pub relation pre_erisa_money_purchase_plan(plan: Plan) kind institutional {
    label en official "section 401(k)(6): a defined contribution pension plan in existence on June 27, 1974 with a salary reduction arrangement then, contributions capped at the 1974 formula levels";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "which was in existence on June 27, 1974, and which, on such date, included a salary reduction arrangement")
rule PreErisaMoneyPurchasePlan(plan: Plan, existed_on: Date) strict {
    label en official "exact date June 27, 1974";
    when plan_is_dc_plan_414i(plan)
        and plan_in_existence_june_27_1974_with_salary_reduction(plan, existed_on)
        and existed_on >= @1974-06-27 and existed_on <= @1974-06-27
        and contributions_within_1974_formula_levels(plan);
    then pre_erisa_money_purchase_plan(plan);
}

pub enum RuralCooperativeKind401k7 {
    ElectricServiceCooperative;
    ElectricServiceToPublicExemptOrGovernment;
    Section501c4Or6Organization80PercentMembers;
    CooperativeTelephoneCompany;
    IrrigationOrDitchCompany;
    IrrigationDistrict;
    NationalAssociationOfRuralCooperatives;
}

pub relation rural_cooperative_kind(org: Person, kind: RuralCooperativeKind401k7) kind empirical {
    label en unofficial "the organization is a rural cooperative of this kind (section 401(k)(7)(B)(i)-(v)), case-asserted";
}

pub relation plan_established_by(plan: Plan, org: Person) kind empirical {
    label en unofficial "the pension plan is established and maintained by this organization, case-asserted";
}

pub relation rural_cooperative(org: Person) kind institutional {
    label en official "section 401(k)(7)(B): the listed kinds of rural cooperative";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"rural cooperative\" means")
rule RuralCooperativeAnyKind(org: Person, kind: RuralCooperativeKind401k7) strict {
    label en official "any listed kind qualifies";
    when rural_cooperative_kind(org, kind);
    then rural_cooperative(org);
}

pub relation rural_cooperative_plan(plan: Plan) kind institutional {
    label en official "section 401(k)(7)(A): a defined contribution pension plan established and maintained by a rural cooperative";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The term \"rural cooperative plan\" means any pension plan")
rule RuralCooperativePlanRule(plan: Plan, org: Person) strict {
    label en official "(i) defined contribution and (ii) maintained by a rural cooperative";
    when plan_is_dc_plan_414i(plan) and plan_established_by(plan, org) and rural_cooperative(org);
    then rural_cooperative_plan(plan);
}

// (k)(11) SIMPLE 401(k); (k)(14) hardship; (k)(16) starter 401(k) -----------

pub relation simple401k_elective_percent_within_limit(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "employee elective contributions are expressed as a percentage of compensation and never exceed the section 408(p)(2)(A)(ii) amount, case-asserted (section 401(k)(11)(B)(i)(I))";
}

pub relation simple401k_elective_deferral(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's elective contributions for the year, case-asserted";
}

pub relation simple401k_compensation(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the employee's compensation for the year, case-asserted";
}

pub relation simple401k_match(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the matching contribution the employer makes for the employee, case-asserted";
}

pub relation simple401k_required_match(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 401(k)(11)(B)(i)(II): a matching contribution equal to the elective amount up to 3 percent of compensation";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the employer is required to make a matching contribution to the trust for the year in an amount equal to so much of the amount the employee elects under subclause (I) as does not exceed 3 percent of compensation for the year")
rule Simple401kRequiredMatch(plan: Plan, employee: Person, y: TaxableYear, elective: Money, comp: Money) strict {
    label en official "required match = min(elective, 3 percent of compensation)";
    when simple401k_elective_deferral(plan, employee, y, elective) and simple401k_compensation(plan, employee, y, comp);
    then simple401k_required_match(plan, employee, y, min(elective, comp * 0.03));
}

pub relation simple401k_match_requirement_met(plan: Plan, employee: Person, y: TaxableYear) kind institutional {
    label en official "the employer's matching contribution is at least the required amount";
}

rule Simple401kMatchRequirementMet(plan: Plan, employee: Person, y: TaxableYear, required: Money, actual: Money) strict {
    label en unofficial "exact: actual >= required";
    when simple401k_required_match(plan, employee, y, required)
        and simple401k_match(plan, employee, y, actual)
        and actual >= required;
    then simple401k_match_requirement_met(plan, employee, y);
}

pub relation simple401k_nonelective_election_2_percent(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer elects to make 2 percent nonelective contributions in lieu of the match, case-asserted (401(k)(11)(B)(ii))";
}

pub relation simple401k_nonelective(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the nonelective contribution for an eligible employee with at least $5,000 of compensation, case-asserted";
}

pub relation simple401k_nonelective_requirement_met(plan: Plan, employee: Person, y: TaxableYear) kind institutional {
    label en official "the 2 percent nonelective alternative: at least 2 percent of compensation for each eligible employee with at least $5,000 of compensation";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the employer elects (pursuant to the terms of the arrangement) to make nonelective contributions of 2 percent of compensation for each employee who is eligible to participate in the arrangement and who has at least $5,000 of compensation from the employer for the year")
rule Simple401kNonelectiveRequirementMet(plan: Plan, employee: Person, y: TaxableYear, comp: Money, actual: Money) strict {
    label en official "exact boundaries: 2 percent, and the $5,000 compensation threshold";
    when simple401k_nonelective_election_2_percent(plan, y)
        and simple401k_compensation(plan, employee, y, comp)
        and simple401k_nonelective(plan, employee, y, actual)
        and comp >= 5000.00 USD
        and actual >= comp * 0.02;
    then simple401k_nonelective_requirement_met(plan, employee, y);
}

pub relation simple401k_no_other_contributions_or_accruals(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "no contributions were made, or benefits accrued, for services during the year under any qualified plan of the employer for an eligible employee, other than the (B) contributions, case-asserted (401(k)(11)(C))";
}

pub relation simple401k_vesting_full(plan: Plan) kind empirical {
    label en unofficial "the vesting requirements of section 408(p)(3) are met (full and immediate), case-asserted";
}

pub relation simple401k_eligible_employer(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer is an eligible employer under section 408(p)(2)(C)(i), case-asserted";
}

pub relation simple401k_satisfies_adp(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(A): an arrangement of an eligible employer meeting (B) contributions, (C) exclusive plan and 408(p)(3) vesting is treated as meeting (3)(A)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement maintained by an eligible employer shall be treated as meeting the requirements of paragraph (3)(A)(ii) if such arrangement meets")
rule Simple401kSatisfiesAdp(plan: Plan, y: TaxableYear, employee: Person) strict {
    label en official "contribution requirement for a participant (match or the 2 percent alternative), exclusive plan and vesting";
    when simple401k_eligible_employer(plan, y)
        and simple401k_elective_percent_within_limit(plan, y)
        and simple401k_match_requirement_met(plan, employee, y)
        and simple401k_no_other_contributions_or_accruals(plan, y)
        and simple401k_vesting_full(plan);
    then simple401k_satisfies_adp(plan, y);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A cash or deferred arrangement maintained by an eligible employer shall be treated as meeting the requirements of paragraph (3)(A)(ii) if such arrangement meets")
rule Simple401kSatisfiesAdpNonelective(plan: Plan, y: TaxableYear, employee: Person) strict {
    label en official "the 2 percent nonelective alternative in place of the match";
    when simple401k_eligible_employer(plan, y)
        and simple401k_elective_percent_within_limit(plan, y)
        and simple401k_nonelective_requirement_met(plan, employee, y)
        and simple401k_no_other_contributions_or_accruals(plan, y)
        and simple401k_vesting_full(plan);
    then simple401k_satisfies_adp(plan, y);
}

pub relation simple401k_only_required_contributions(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the plan allows only contributions required under paragraph (11), case-asserted";
}

pub relation simple401k_not_top_heavy(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(11)(D)(ii): a plan meeting paragraph (11) that allows only the required contributions is not top-heavy";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A plan meeting the requirements of this paragraph for any year shall not be treated as a top-heavy plan under section 416 for such year if such plan allows only contributions required under this paragraph.")
rule Simple401kNotTopHeavy(plan: Plan, y: TaxableYear) strict {
    label en official "exempt from top-heavy status";
    when simple401k_satisfies_adp(plan, y) and simple401k_only_required_contributions(plan, y);
    then simple401k_not_top_heavy(plan, y);
}

pub enum HardshipDistributableAmountKind401k14 {
    ElectiveContributionsSection402e3;
    QualifiedNonelective;
    QualifiedMatching;
    EarningsOnThoseAmounts;
}

pub relation hardship_distribution_amount_kind(d: Distribution, kind: HardshipDistributableAmountKind401k14) kind empirical {
    label en unofficial "the kind of amount distributed on hardship, case-asserted (section 401(k)(14)(A)(i)-(iv))";
}

pub relation hardship_distribution_amount_permitted(d: Distribution) kind institutional {
    label en official "section 401(k)(14)(A): elective contributions, qualified nonelective, qualified matching contributions and their earnings may be distributed on hardship";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The following amounts may be distributed upon hardship of the employee")
rule HardshipDistributionAmountPermitted(d: Distribution, kind: HardshipDistributableAmountKind401k14) strict {
    label en official "any listed kind";
    when hardship_distribution_amount_kind(d, kind);
    then hardship_distribution_amount_permitted(d);
}

pub relation employee_did_not_take_available_loan(d: Distribution) kind empirical {
    label en unofficial "the employee did not take an available loan under the plan, case-asserted";
}

pub relation employee_certified_immediate_heavy_need(d: Distribution) kind empirical {
    label en unofficial "the employee certified in writing that the distribution is on account of a financial need of a type the regulations deem an immediate and heavy financial need, case-asserted (section 401(k)(14)(C)(i))";
}

pub relation employee_certified_not_above_need(d: Distribution) kind empirical {
    label en unofficial "the employee certified the distribution is not above the amount required to satisfy the need, case-asserted ((C)(ii))";
}

pub relation employee_certified_no_alternative_means(d: Distribution) kind empirical {
    label en unofficial "the employee certified that he has no alternative means reasonably available, case-asserted";
}

pub relation administrator_has_actual_knowledge_to_contrary(d: Distribution) kind empirical {
    label en unofficial "the plan administrator has actual knowledge contrary to the certification, case-asserted";
}

pub relation administrator_may_rely_on_certification(d: Distribution) kind institutional {
    label en official "section 401(k)(14)(C): the administrator may rely on the written certification, except on actual knowledge to the contrary (regulations may address misrepresentation)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the administrator of the plan may rely on a written certification by the employee that the distribution is")
rule AdministratorMayRelyOnCertification(d: Distribution) strict {
    label en official "the three certifications and no contrary knowledge";
    when employee_certified_immediate_heavy_need(d)
        and employee_certified_not_above_need(d)
        and employee_certified_no_alternative_means(d)
        and not_known(administrator_has_actual_knowledge_to_contrary(d));
    then administrator_may_rely_on_certification(d);
}

pub relation hardship_not_defeated_by_unused_loan(d: Distribution) kind institutional {
    label en official "section 401(k)(14)(B): a distribution is not failing the hardship condition solely because the employee took no available loan";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A distribution shall not be treated as failing to be made upon the hardship of an employee solely because the employee does not take any available loan under the plan.")
rule HardshipNotDefeatedByUnusedLoan(d: Distribution) strict {
    label en official "the unused loan is disregarded";
    when employee_did_not_take_available_loan(d);
    then hardship_not_defeated_by_unused_loan(d);
}

pub relation starter401k_qualified_percentage(plan: Plan, pct: Decimal, uniform: Integer) kind empirical {
    label en unofficial "the percentage of compensation each eligible employee is treated as electing, and 1 in the second argument when it is applied uniformly, case-asserted (section 401(k)(16)(C)(iii))";
}

pub relation starter401k_only_elective_contributions(plan: Plan) kind empirical {
    label en unofficial "the only contributions that may be made are the automatic elective contributions, case-asserted ((D)(i)(I))";
}

pub relation starter401k_annual_deferral_cap(plan: Plan, y: TaxableYear, cap: Money) kind empirical {
    label en unofficial "the amount that limits the aggregate elective contributions for a calendar year (the statutory $6,000, adjusted after 2024, plus the age-50 increase), case-asserted (indexing is a recorded gap)";
}

pub relation starter401k_employee_deferrals(plan: Plan, employee: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the elective contributions made for the employee for the calendar year, case-asserted";
}

pub relation employer_maintains_other_qualified_plan_for_year(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer maintains a qualified plan with respect to which contributions are made or benefits accrued for service in the year, case-asserted (section 401(k)(16)(E)(i))";
}

pub relation starter401k_arrangement(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(B): automatic deferral of a uniform 3 to 15 percent, only elective contributions within the cap, and the (13)(E) requirements";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "the term \"qualified percentage\" means, with respect to any employee, any percentage determined under the arrangement if such percentage is applied uniformly and is not less than 3 or more than 15 percent")
rule Starter401kArrangement(plan: Plan, y: TaxableYear, pct: Decimal, employee: Person, deferrals: Money, cap: Money) strict {
    label en official "exact boundaries: 3.0 and 15.0 percent, uniform; deferrals at the cap allowed";
    when starter401k_qualified_percentage(plan, pct, 1)
        and pct >= 3.0 and pct <= 15.0
        and starter401k_only_elective_contributions(plan)
        and starter401k_annual_deferral_cap(plan, y, cap)
        and starter401k_employee_deferrals(plan, employee, y, deferrals)
        and deferrals <= cap;
    then starter401k_arrangement(plan, y);
}

pub relation starter401k_eligible_employer(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(E)(i): an employer that maintains no other qualified plan for the year";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The term \"eligible employer\" means any employer if the employer does not maintain a qualified plan with respect to which contributions are made, or benefits are accrued, for service in the year for which the determination is being made.")
rule Starter401kEligibleEmployer(plan: Plan, y: TaxableYear) strict {
    label en official "no other qualified plan in the year";
    when qualified_plan_year_anchor(plan, y) and not_known(employer_maintains_other_qualified_plan_for_year(plan, y));
    then starter401k_eligible_employer(plan, y);
}

pub relation starter401k_treated_as_meeting_adp(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 401(k)(16)(A): a starter 401(k) deferral-only arrangement of an eligible employer is treated as meeting (3)(A)(ii)";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "A starter 401(k) deferral-only arrangement maintained by an eligible employer shall be treated as meeting the requirements of paragraph (3)(A)(ii).")
rule Starter401kTreatedAsMeetingAdp(plan: Plan, y: TaxableYear) strict {
    label en official "arrangement plus eligible employer";
    when starter401k_arrangement(plan, y) and starter401k_eligible_employer(plan, y);
    then starter401k_treated_as_meeting_adp(plan, y);
}

pub relation starter401k_affirmative_election(employee: Person, plan: Plan, on: Date, level_percent: Decimal) kind empirical {
    label en unofficial "the employee affirmatively elects not to have contributions made (level 0.0) or to contribute at a specified level, case-asserted (401(k)(16)(C)(ii))";
}

pub relation starter401k_deemed_election_ceased(employee: Person, plan: Plan) kind institutional {
    label en official "section 401(k)(16)(C)(ii): the deemed election ceases to apply once the employee makes an affirmative election";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "The election treated as having been made under clause (i) shall cease to apply with respect to any employee if such employee makes an affirmative election")
rule Starter401kDeemedElectionCeased(employee: Person, plan: Plan, on: Date, level: Decimal) strict {
    label en official "the affirmative election ends the automatic one";
    when starter401k_affirmative_election(employee, plan, on, level);
    then power ElectOutOfStarter401kDeemedElection {
        holder employee;
        over plan;
        exercise starter401k_affirmative_election(employee, plan, on, level);
        valid_when participates_in(employee, plan);
        effect starter401k_deemed_election_ceased(employee, plan);
    };
}

// =====================================================================
// (k)(3)(E) First plan year of a plan: the NHCE ADP taken into account
// =====================================================================

pub relation first_plan_year_of_plan_not_successor(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "this is the first plan year of the plan and the plan is not a successor plan, case-asserted (section 401(k)(3)(E))";
}

pub relation first_year_actual_nhce_adp_election(plan: Plan, y: TaxableYear, actual_pct: Decimal) kind empirical {
    label en unofficial "the employer elects to use the actual deferral percentage of non-highly-compensated employees determined for the first plan year, with that percentage, case-asserted (401(k)(3)(E)(ii))";
}

pub relation first_year_election_in_effect(plan: Plan, y: TaxableYear) kind empirical {
    label en unofficial "the employer's election to use the actual first-year percentage is in effect, case-asserted";
}

pub relation nhce_adp_taken_into_account_first_year(plan: Plan, y: TaxableYear, pct: Decimal) kind institutional {
    label en official "section 401(k)(3)(E): in the first plan year of a plan the NHCE ADP for the preceding year is taken as 3 percent, or the actual first-year percentage if the employer so elects";
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "in the case of the first plan year of any plan (other than a successor plan), the amount taken into account as the actual deferral percentage of nonhighly compensated employees for the preceding plan year shall be")
rule NhceAdpFirstYearDefault(plan: Plan, y: TaxableYear) defeasible {
    label en official "3 percent unless the employer elects the actual percentage";
    when first_plan_year_of_plan_not_successor(plan, y);
    unless first_year_election_in_effect(plan, y);
    then nhce_adp_taken_into_account_first_year(plan, y, 3.0);
}

@source(IRC_S401_K, relation = formalizes, coverage = exact, quote = "if the employer makes an election under this subclause, the actual deferral percentage of nonhighly compensated employees determined for such first plan year")
rule NhceAdpFirstYearElected(plan: Plan, y: TaxableYear, actual: Decimal) defeasible {
    label en official "the election replaces the default";
    when first_plan_year_of_plan_not_successor(plan, y)
        and first_year_election_in_effect(plan, y)
        and first_year_actual_nhce_adp_election(plan, y, actual);
    then nhce_adp_taken_into_account_first_year(plan, y, actual);
}
