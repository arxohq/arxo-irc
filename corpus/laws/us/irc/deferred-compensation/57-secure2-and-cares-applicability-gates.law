// SECURE 2.0 (Pub. L. 117-328, div. T) and CARES Act (Pub. L. 116-136) dated
// applicability — STAGE 3 (deferred-compensation, TECH_GAP reduction,
// 26.09.2026). The 2024 Edition text pinned in `sources.law` is the
// POST-amendment text; the statutory notes give the dates from which the
// amended text applies. Stage 2f left the dated notes as TECH_GAP ("not
// carried"). This module carries the dates as executable applicability gates:
// a gate relation is established only from the date the note names, exactly
// (plan years or taxable years "beginning after December 31, 2024" start on
// or after January 1, 2025).
//
// What the pinned sources allow. `us.irc.temporal` pins the amending text of
// the 119th Congress only (PL 119-21 ... 119-86); AMENDMENTS.json records NO
// entry for a section owned by this package, so no `revision` with a pinned
// amendment fragment exists here. PL 117-328 itself is not pinned: the
// PRE-amendment rules (the 3-year long-term part-time rule before 2025, the
// pre-2025 catch-up limits, the pre-2028 text of 401(a)(35)) are therefore
// NOT invented; the coverage rows for those notes are SOURCE_GAP with the
// gate attached. A query about a plan year before the gate date gives NEITHER
// on the gate relation, never the new rule answered as if it applied.
// The gates are not wired into the stage-1 rules (401(k)(2)(D), 414(v)(2)(E))
// to keep the stage-1 scenarios unchanged (TECH-GAPS G4601).

// =====================================================================
// Plan year and taxable year start dates (case inputs)
// =====================================================================

use self::{
    IRC_S401_NOTE_6,
    IRC_S403_NOTE_6,
    IRC_S414A_NOTE_4,
    IRC_S414_NOTE_6,
    Plan,
    TaxableYear,
    governmental_plan_414d,
};

pub relation plan_year_begin_date_secure2(plan: Plan, y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the plan year, case-asserted (dated applicability rules of the notes are keyed to plan years beginning after a date)";
}

pub relation taxable_year_begin_date_secure2(y: TaxableYear, start: Date) kind empirical {
    label en unofficial "the first day of the taxable year, case-asserted";
}

// =====================================================================
// SECURE 2.0 section 101(c): section 414A applies to plan years beginning after 2024
// =====================================================================

pub relation secure2_101_applies_414A(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 101(c) of Pub. L. 117-328 (note under section 414A): section 414A applies to plan years beginning after December 31, 2024";
}

@source(IRC_S414A_NOTE_4, relation = formalizes, coverage = exact, quote = "shall apply to plan years beginning after December 31, 2024")
rule Secure2Section101Applies414A(plan: Plan, y: TaxableYear, start: Date) strict {
    label en official "exact boundary: a plan year beginning on December 31, 2024 is outside, one beginning on January 1, 2025 is inside";
    when plan_year_begin_date_secure2(plan, y, start) and start > @2024-12-31;
    then secure2_101_applies_414A(plan, y);
}

pub relation section_414A_not_yet_applicable_secure2(plan: Plan, y: TaxableYear) kind institutional {
    label en official "before the dated applicability the section enacted by section 101 of Pub. L. 117-328 does not apply to the plan year";
}

@source(IRC_S414A_NOTE_4, relation = formalizes, coverage = exact, quote = "The amendments made by this section [enacting this section] shall apply to plan years beginning after December 31, 2024")
rule Section414ANotYetApplicable(plan: Plan, y: TaxableYear, start: Date) strict {
    label en official "a plan year beginning on or before December 31, 2024";
    when plan_year_begin_date_secure2(plan, y, start) and start <= @2024-12-31;
    then section_414A_not_yet_applicable_secure2(plan, y);
}

// =====================================================================
// SECURE 2.0 section 109(d): the increased catch-up limit of section 414(v)(2)(E)
// =====================================================================

pub relation secure2_109_applies_414v2E(y: TaxableYear) kind institutional {
    label en official "section 109(d) of Pub. L. 117-328 (note under section 414): the amendments (increased catch-up limit for ages 60 to 63 in section 414(v)(2)(E)) apply to taxable years beginning after December 31, 2024";
}

@source(IRC_S414_NOTE_6, relation = formalizes, coverage = exact, quote = "shall apply to taxable years beginning after December 31, 2024")
rule Secure2Section109Applies414v2E(y: TaxableYear, start: Date) strict {
    label en official "exact boundary: a taxable year beginning on January 1, 2025 is inside";
    when taxable_year_begin_date_secure2(y, start) and start > @2024-12-31;
    then secure2_109_applies_414v2E(y);
}

// =====================================================================
// SECURE 2.0 section 125(f): long-term part-time employees
// =====================================================================

pub relation secure2_125_applies_401k2D(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 125(f)(1) of Pub. L. 117-328 (note under section 401): the amendments of section 125 (two consecutive 12-month periods instead of three in section 401(k)(2)(D)(ii); also sections 403 and 416) apply to plan years beginning after December 31, 2024";
}

@source(IRC_S401_NOTE_6, relation = formalizes, coverage = exact, quote = "shall apply to plan years beginning after December 31, 2024")
rule Secure2Section125Applies401k2D(plan: Plan, y: TaxableYear, start: Date) strict {
    label en official "exact boundary: January 1, 2025 is inside";
    when plan_year_begin_date_secure2(plan, y, start) and start > @2024-12-31;
    then secure2_125_applies_401k2D(plan, y);
}

pub relation secure2_125_applies_403b(plan: Plan, y: TaxableYear) kind institutional {
    label en official "note under section 403: the amendment by section 125(a)(2)(A), (B)(i) of Pub. L. 117-328 applies to plan years beginning after December 31, 2024 (section 125(f)(1))";
}

@source(IRC_S403_NOTE_6, relation = formalizes, coverage = exact, quote = "Amendment by section 125(a)(2)(A), (B)(i) of Pub. L. 117–328 applicable to plan years beginning after Dec. 31, 2024")
rule Secure2Section125Applies403b(plan: Plan, y: TaxableYear) strict {
    label en official "the section 403 note points to the section 125(f)(1) date";
    when secure2_125_applies_401k2D(plan, y);
    then secure2_125_applies_403b(plan, y);
}

// =====================================================================
// SECURE 2.0 section 123(b): section 401(a)(35)(I) (text not in the pinned edition)
// =====================================================================

pub relation secure2_123_applies_401a35I(plan: Plan, y: TaxableYear) kind institutional {
    label en official "section 123(b) of Pub. L. 117-328 (note under section 401): the amendments apply to plan years beginning after December 31, 2027";
}

@source(IRC_S401_NOTE_6, relation = formalizes, coverage = exact, quote = "shall apply to plan years beginning after December 31, 2027")
rule Secure2Section123Applies401a35I(plan: Plan, y: TaxableYear, start: Date) strict {
    label en official "exact boundary: January 1, 2028 is inside; the paragraph itself is not in the pinned statute body (SOURCE_GAP), so the gate governs nothing yet";
    when plan_year_begin_date_secure2(plan, y, start) and start > @2027-12-31;
    then secure2_123_applies_401a35I(plan, y);
}

// =====================================================================
// CARES Act section 2203(c)(2): plan amendment deadline
// =====================================================================

pub relation first_plan_year_beginning_on_or_after_jan_1_2025_ends_on_cares2203(plan: Plan, end: Date) kind empirical {
    label en unofficial "the last day of the first plan year beginning on or after January 1, 2025, case-asserted (the plan year cycle is not derived)";
}

pub relation first_plan_year_beginning_on_or_after_jan_1_2027_ends_on_cares2203(plan: Plan, end: Date) kind empirical {
    label en unofficial "the last day of the first plan year beginning on or after January 1, 2027, case-asserted (governmental plans, subclause (II) with '2027' for '2025')";
}

pub relation amendment_made_pursuant_to_cares2203_on(plan: Plan, on: Date) kind empirical {
    label en unofficial "the date a plan or annuity contract amendment made pursuant to the amendments of CARES Act section 2203 is made, case-asserted (subclause (I))";
}

pub relation plan_operated_as_if_amendment_in_effect_through_2020_cares2203(plan: Plan) kind empirical {
    label en unofficial "during the period beginning on the effective date of the amendment and ending on December 31, 2020 the plan or contract is operated as if the amendment were in effect, case-asserted (clause (ii))";
}

pub relation cares2203_amendment_protection_applies(plan: Plan, amended_on: Date) kind institutional {
    label en official "CARES Act section 2203(c)(2): the amendment is made pursuant to section 2203, on or before the last day of the first plan year beginning on or after January 1, 2025 (2027 for a governmental plan), and the plan was operated as if it were in effect through December 31, 2020";
}

@source(IRC_S401_NOTE_6, relation = formalizes, coverage = exact, quote = "is made on or before the last day of the first plan year beginning on or after January 1, 2025")
rule Cares2203AmendmentTimelyNonGovernmental(plan: Plan, amended_on: Date, deadline: Date) strict {
    label en official "exact boundary: an amendment on the last day of that plan year is still timely; a governmental plan takes the 2027 branch";
    when amendment_made_pursuant_to_cares2203_on(plan, amended_on)
        and first_plan_year_beginning_on_or_after_jan_1_2025_ends_on_cares2203(plan, deadline)
        and plan_operated_as_if_amendment_in_effect_through_2020_cares2203(plan)
        and amended_on <= deadline
        and not_known(governmental_plan_414d(plan));
    then cares2203_amendment_protection_applies(plan, amended_on);
}

@source(IRC_S401_NOTE_6, relation = formalizes, coverage = exact, quote = "In the case of a governmental plan, subclause (II) shall be applied by substituting '2027' for '2025'")
rule Cares2203AmendmentTimelyGovernmental(plan: Plan, amended_on: Date, deadline: Date) strict {
    label en official "governmental plan (section 414(d)): the first plan year beginning on or after January 1, 2027";
    when amendment_made_pursuant_to_cares2203_on(plan, amended_on)
        and first_plan_year_beginning_on_or_after_jan_1_2027_ends_on_cares2203(plan, deadline)
        and plan_operated_as_if_amendment_in_effect_through_2020_cares2203(plan)
        and governmental_plan_414d(plan)
        and amended_on <= deadline;
    then cares2203_amendment_protection_applies(plan, amended_on);
}
