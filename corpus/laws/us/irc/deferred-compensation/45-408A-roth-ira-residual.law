// Section 408A — STAGE 2f residual (IRC-09, DECISION-0379, 25.09.2026): module
// 08 carries the contribution limit with the MAGI phase-out, the five-year
// period, the qualified distributions and the conversion inclusion. This
// module adds (c)(3)(E) the education credit increase, (d)(3)(E) acceleration
// at death, (d)(3)(F) the five-year rule for conversions, (d)(4)(B) the
// ordering of distributions from contributions, (d)(6) the trustee transfer of
// a contribution, and (e)(2) rollovers of military death gratuities.
//
// Method: amounts are exact Money arithmetic; dates use exact calendar
// arithmetic (scenarios need the IRC calendar-step policy).

// =====================================================================
// (c)(3)(E) Increase of the reduced limit
// =====================================================================

use self::{
    Distribution,
    IRC_S408A_C,
    IRC_S408A_D,
    IRC_S408A_E,
    Individual,
    TaxableYear,
};

pub relation roth_reduction_amount_408Ac3E(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the (c)(3)(A) reduction (determined without regard to subparagraph (E)), case-asserted";
}

pub relation education_contributions_529c3E_408A(individual: Individual, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of contributions described in section 529(c)(3)(E) for the taxable year, case-asserted ((c)(3)(E)(i))";
}

pub relation roth_limit_increase_408Ac3E(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408A(c)(3)(E): the reduced amount is increased by the lesser of the section 529(c)(3)(E) contributions and the amount of the reduction";
}

@source(IRC_S408A_C, relation = formalizes, coverage = exact, quote = "The amount determined under subparagraph (A) shall be increased by the lesser of")
rule RothLimitIncrease408Ac3E(individual: Individual, y: TaxableYear, contributions: Money, reduction: Money) strict {
    label en official "min of the two amounts";
    when education_contributions_529c3E_408A(individual, y, contributions) and roth_reduction_amount_408Ac3E(individual, y, reduction);
    then roth_limit_increase_408Ac3E(individual, y, min(contributions, reduction));
}

// =====================================================================
// (d)(3) Conversions
// =====================================================================

pub relation inclusion_year_remaining_408Ad3E(individual: Individual, amount: Money) kind empirical {
    label en unofficial "the amount still to be included in gross income under the ratable inclusion, case-asserted ((d)(3)(E)(ii))";
}

pub relation individual_dies_on_408Ad3E(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year that includes the individual's date of death, case-asserted";
}

pub relation remaining_conversion_income_accelerated_408Ad3E(individual: Individual, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 408A(d)(3)(E)(ii)(I): on the individual's death all remaining amounts are included in the taxable year that includes the date of death";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "all remaining amounts shall be included in gross income for the taxable year which includes the date of death")
rule RemainingConversionIncomeAccelerated408Ad3E(individual: Individual, y: TaxableYear, remaining: Money) strict {
    label en official "the whole remaining amount in the year of death";
    when individual_dies_on_408Ad3E(individual, y) and inclusion_year_remaining_408Ad3E(individual, remaining) and remaining > 0.00 USD;
    then remaining_conversion_income_accelerated_408Ad3E(individual, y, remaining);
}

pub relation roth_distribution_allocable_to_conversion_408Ad3F(d: Distribution, includible_part: Money) kind empirical {
    label en unofficial "the portion of a Roth IRA distribution allocable to a qualified rollover contribution includible in gross income, case-asserted ((d)(3)(F)(i)(I))";
}

pub relation conversion_year_start_408Ad3F(d: Distribution, start: Date) kind empirical {
    label en unofficial "the first day of the taxable year in which the rollover contribution was made, case-asserted";
}

pub relation distribution_made_on_408Ad3F(d: Distribution, on: Date) kind empirical {
    label en unofficial "the date of the distribution, case-asserted";
}

pub relation section_72t_applies_to_conversion_portion_408Ad3F(d: Distribution, amount: Money) kind institutional {
    label en official "section 408A(d)(3)(F): a distribution within the 5-taxable-year period beginning with the year of the rollover contribution is subject to section 72(t) as if the includible portion were includible in gross income";
}

@source(IRC_S408A_D, relation = formalizes, coverage = partial, quote = "such distribution is made within the 5-taxable year period beginning with the taxable year in which such contribution was made")
rule Section72tAppliesToConversionPortion408Ad3F(d: Distribution, portion: Money, start: Date, on: Date) strict {
    label en official "PARTIAL: exact boundary: before the fifth anniversary of the first day of the conversion year; only to the extent of the amount includible (clause (ii))";
    when roth_distribution_allocable_to_conversion_408Ad3F(d, portion)
        and conversion_year_start_408Ad3F(d, start)
        and distribution_made_on_408Ad3F(d, on)
        and on < add_calendar_period(start, 5 calendar_year)
        and portion > 0.00 USD;
    then section_72t_applies_to_conversion_portion_408Ad3F(d, portion);
}

// =====================================================================
// (d)(4)(B) Ordering of distributions from contributions
// =====================================================================

pub relation roth_aggregate_contributions_408Ad4B(individual: Individual, amount: Money) kind empirical {
    label en unofficial "the aggregate contributions to the Roth IRAs, case-asserted (section 408A(d)(4)(B)(i))";
}

pub relation roth_previous_distributions_408Ad4B(individual: Individual, amount: Money) kind empirical {
    label en unofficial "all previous distributions from the Roth IRAs, case-asserted";
}

pub relation roth_current_distribution_408Ad4B(individual: Individual, d: Distribution, amount: Money) kind empirical {
    label en unofficial "the amount of the current distribution, case-asserted";
}

pub relation roth_distribution_from_contributions_408Ad4B(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "section 408A(d)(4)(B)(i): a distribution is treated as made from contributions to the extent that, with the previous distributions, it does not exceed the aggregate contributions";
}

@source(IRC_S408A_D, relation = formalizes, coverage = exact, quote = "from contributions to the extent that the amount of such distribution, when added to all previous distributions from the Roth IRA, does not exceed the aggregate contributions to the Roth IRA")
rule RothDistributionFromContributions408Ad4B(individual: Individual, d: Distribution, contributions: Money, previous: Money, current: Money) strict {
    label en official "min(current, max(contributions - previous, 0)), exact";
    when roth_aggregate_contributions_408Ad4B(individual, contributions)
        and roth_previous_distributions_408Ad4B(individual, previous)
        and roth_current_distribution_408Ad4B(individual, d, current);
    then roth_distribution_from_contributions_408Ad4B(individual, d, min(current, max(contributions - previous, 0.00 USD)));
}

pub relation roth_distribution_from_earnings_408Ad4B(individual: Individual, d: Distribution, amount: Money) kind institutional {
    label en official "the part of a distribution above the contributions is a distribution of earnings";
}

rule RothDistributionFromEarnings408Ad4B(individual: Individual, d: Distribution, contributions: Money, previous: Money, current: Money) strict {
    label en official "current - the contribution part, when positive";
    when roth_aggregate_contributions_408Ad4B(individual, contributions)
        and roth_previous_distributions_408Ad4B(individual, previous)
        and roth_current_distribution_408Ad4B(individual, d, current)
        and current > max(contributions - previous, 0.00 USD);
    then roth_distribution_from_earnings_408Ad4B(individual, d, current - max(contributions - previous, 0.00 USD));
}

// =====================================================================
// (d)(6) Transfer of a contribution by the due date
// =====================================================================

pub relation contribution_transferred_on_408Ad6(individual: Individual, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the date a contribution made during the taxable year is transferred in a trustee-to-trustee transfer to another individual retirement plan, case-asserted (section 408A(d)(6)(A))";
}

pub relation due_date_for_year_408Ad7(individual: Individual, y: TaxableYear, due: Date) kind empirical {
    label en unofficial "the due date for the taxable year (including extensions), case-asserted ((d)(7))";
}

pub relation transfer_includes_net_income_408Ad6Bi(individual: Individual, y: TaxableYear) kind empirical {
    label en unofficial "the transfer is accompanied by the net income allocable to the contribution, case-asserted ((B)(i))";
}

pub relation contribution_treated_as_made_to_transferee_408Ad6(individual: Individual, y: TaxableYear) kind institutional {
    label en official "section 408A(d)(6): a contribution transferred by the due date with its net income is treated as made to the transferee plan";
}

@source(IRC_S408A_D, relation = formalizes, coverage = partial, quote = "if, on or before the due date for any taxable year, a taxpayer transfers in a trustee-to-trustee transfer any contribution to an individual retirement plan made during such taxable year from such plan to any other individual retirement plan")
rule ContributionTreatedAsMadeToTransferee408Ad6(individual: Individual, y: TaxableYear, moved: Date, due: Date) strict {
    label en official "PARTIAL: exact boundary: the due date is in time; the no-deduction limit of (B)(ii) and the conversion exception of (B)(iii) are not gated";
    when contribution_transferred_on_408Ad6(individual, y, moved)
        and due_date_for_year_408Ad7(individual, y, due)
        and transfer_includes_net_income_408Ad6Bi(individual, y)
        and moved <= due;
    then contribution_treated_as_made_to_transferee_408Ad6(individual, y);
}

// =====================================================================
// (e)(2) Military death gratuity and SGLI rollovers
// =====================================================================

pub relation gratuity_received_on_408Ae2(individual: Individual, on: Date) kind empirical {
    label en unofficial "the date the individual receives an amount under 10 U.S.C. 1477 or 38 U.S.C. 1967 for a person, case-asserted (section 408A(e)(2)(A))";
}

pub relation roth_contribution_on_408Ae2(individual: Individual, on: Date, amount: Money) kind empirical {
    label en unofficial "a contribution to a Roth IRA and its date, case-asserted";
}

pub relation gratuity_amounts_408Ae2(individual: Individual, received: Money, coverdell: Money) kind empirical {
    label en unofficial "the sum received during the period and the amounts contributed to a Coverdell education savings account, case-asserted ((A)(i), (ii))";
}

pub relation gratuity_qualified_rollover_limit_408Ae2A(individual: Individual, amount: Money) kind institutional {
    label en official "section 408A(e)(2)(A): the qualified rollover contribution is limited to the sum received less the Coverdell contributions";
}

@source(IRC_S408A_E, relation = formalizes, coverage = exact, quote = "the amounts so received which were contributed to a Coverdell education savings account under section 530")
rule GratuityQualifiedRolloverLimit408Ae2A(individual: Individual, received: Money, coverdell: Money) strict {
    label en official "received - Coverdell contributions, floored at zero";
    when gratuity_amounts_408Ae2(individual, received, coverdell);
    then gratuity_qualified_rollover_limit_408Ae2A(individual, max(received - coverdell, 0.00 USD));
}

pub relation gratuity_rollover_timely_408Ae2A(individual: Individual, on: Date) kind institutional {
    label en official "section 408A(e)(2)(A): the contribution is made before the end of the 1-year period beginning on the date the amount is received";
}

@source(IRC_S408A_E, relation = formalizes, coverage = exact, quote = "made before the end of the 1-year period beginning on the date on which such individual receives an amount under section 1477 of title 10, United States Code, or section 1967 of title 38 of such Code")
rule GratuityRolloverTimely408Ae2A(individual: Individual, received: Date, contributed: Date, amount: Money) strict {
    label en official "exact boundary: before the first anniversary of receipt (the anniversary itself is outside)";
    when gratuity_received_on_408Ae2(individual, received)
        and roth_contribution_on_408Ae2(individual, contributed, amount)
        and contributed >= received
        and contributed < add_calendar_period(received, 1 calendar_year);
    then gratuity_rollover_timely_408Ae2A(individual, contributed);
}
