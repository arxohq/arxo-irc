// Stage 3 (TECH_GAP reduction), part A: section 9701(c)(8) successor in interest, 9702(a)(2) and (b)(3), 9703(b)(2)
// plan payment rates, 9711(b)-(c) coverage and security, 9712 (transfers, managed care, guarantee of benefits).
//
// The multi-year ledgers the earlier stages recorded as one gap (G204, G221) are written as sums over recorded
// per-year or per-item facts (empirical relations), not as self-recursive balances: every "carryover" or
// "remaining" amount is a sum over the recorded earlier items, so no rule reads what it produces.

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

use self::{
    CombinedFund,
    IRC_S9701_C,
    IRC_S9702_A,
    IRC_S9702_B,
    IRC_S9703_B,
    IRC_S9711_B,
    IRC_S9711_C,
    IRC_S9712_A,
    IRC_S9712_C,
    IRC_S9712_D,
    Period,
    Person,
    Plan1992,
    UmwaBenefitPlan,
    employer_plan_coverage_provided,
    is_1950_umwa_benefit_plan,
    is_1988_agreement_operator,
    is_last_signatory_operator_of,
    is_related_person,
    is_trustee_of_combined_fund,
    security_shields_related_person,
    successor_of,
};

// =====================================================================
// Section 9701(c)(8): successor in interest
// =====================================================================

relation bears_267b_relationship(purchaser: Person, seller: Person) kind empirical {
    label en official "the purchaser bears a relationship to the seller described in section 267(b) (EXTERNAL_DEPENDENCY on section 267(b), carried as a fact)";
}
relation unrelated_person_to_eligible_seller(purchaser: Person, seller: Person) kind institutional {
    label en official "section 9701(c)(8)(B): an unrelated person: a purchaser who does not bear a relationship to the eligible seller described in section 267(b)";
}
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "The term \"unrelated person\" means a purchaser who does not bear a relationship to the eligible seller described in section 267(b).")
rule UnrelatedPersonToEligibleSeller(p: Person, s: Person, r: Person) strict {
    when purchases_assets_or_all_stock_of_related_person_of_seller(p, r, s) and eligible_seller_9701c8(s) and not_known(bears_267b_relationship(p, s));
    then unrelated_person_to_eligible_seller(p, s);
}
relation eligible_seller_9701c8(seller: Person) kind institutional {
    label en official "section 9701(c)(8)(C): an eligible seller: an assigned operator described in section 9704(j)(2) or a related person to such an assigned operator";
}
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"eligible seller\" means an assigned operator described in section 9704(j)(2) or a related person to such assigned operator.")
rule EligibleSellerIsAssignedOperatorOfJ2(s: Person) strict {
    when assigned_operator_described_in_9704j2(s);
    then eligible_seller_9701c8(s);
}
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, the term \"eligible seller\" means an assigned operator described in section 9704(j)(2) or a related person to such assigned operator.")
rule EligibleSellerIsRelatedPersonOfJ2Operator(s: Person, op: Person) strict {
    when assigned_operator_described_in_9704j2(op) and is_related_person(s, op);
    then eligible_seller_9701c8(s);
}
relation purchases_assets_or_all_stock_of_related_person_of_seller(purchaser: Person, related: Person, seller: Person) kind empirical {
    label en official "section 9701(c)(8)(A)(ii): the purchaser purchases assets, or all of the stock, of a person related to the eligible seller";
}
relation purchase_for_fair_market_value_in_bona_fide_arms_length_sale(purchaser: Person, related: Person) kind empirical {
    label en official "section 9701(c)(8)(A)(ii): the purchase is for fair market value in a bona fide, arm's-length sale (an evaluative finding, DECISION-0194: a court's finding, asserted with origin adjudicated)";
}
relation excluded_from_successor_in_interest(purchaser: Person, seller: Person) kind institutional {
    label en official "section 9701(c)(8)(A): the safe harbor: the purchaser is not a successor in interest";
}
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "(ii) purchases for fair market value assets, or all of the stock, of a related person to such seller, in a bona fide, arm's-length sale.")
rule SuccessorInInterestSafeHarbor(p: Person, r: Person, s: Person) strict {
    when unrelated_person_to_eligible_seller(p, s)
        and purchases_assets_or_all_stock_of_related_person_of_seller(p, r, s)
        and purchase_for_fair_market_value_in_bona_fide_arms_length_sale(p, r);
    then excluded_from_successor_in_interest(p, s);
}
relation is_successor_in_interest(successor: Person, operator: Person) kind institutional {
    label en official "the person is a successor in interest of the operator (a related person by section 9701(c)(2)(A) last sentence), unless within the safe harbor of section 9701(c)(8)";
}
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "The term \"successor in interest\" shall not include any person who—")
rule SuccessorInInterestUnlessSafeHarbor(s: Person, op: Person) defeasible {
    when successor_of(s, op);
    unless excluded_from_successor_in_interest(s, op) and successor_of(s, op);
    then is_successor_in_interest(s, op);
}

// =====================================================================
// Section 9702(a)(2): merger of the 1950 and 1974 benefit plans into the Combined Fund as of February 1, 1993
// =====================================================================

relation settlor_of_plan(p: Person, plan: UmwaBenefitPlan) kind empirical {
    label en official "the person is a settlor of the plan";
}
relation plan_merged_into_combined_fund_by(plan: UmwaBenefitPlan, on: Date) kind empirical {
    label en official "the plan was merged into the Combined Fund as of the date";
}
relation plan_merged_into_combined_fund_as_of_february_1_1993(plan: UmwaBenefitPlan) kind institutional {
    label en official "section 9702(a)(2): the plan was merged into the Combined Fund as of February 1, 1993";
}
@source(IRC_S9702_A, relation = formalizes, coverage = exact, quote = "As of February 1, 1993, the settlors of the 1950 UMWA Benefit Plan and the 1974 UMWA Benefit Plan shall cause such plans to be merged into the Combined Fund")
rule PlanMergedAsOfFebruary1993(plan: UmwaBenefitPlan, d: Date) strict {
    when plan_merged_into_combined_fund_by(plan, d) and d <= @1993-02-01;
    then plan_merged_into_combined_fund_as_of_february_1_1993(plan);
}
@source(IRC_S9702_A, relation = formalizes, coverage = exact, quote = "As of February 1, 1993, the settlors of the 1950 UMWA Benefit Plan and the 1974 UMWA Benefit Plan shall cause such plans to be merged into the Combined Fund")
rule SettlorsMergeDutyRule(p: Person, plan: UmwaBenefitPlan) strict {
    when settlor_of_plan(p, plan) and (is_1950_umwa_benefit_plan(plan));
    then duty SettlorsCausePlanMergerIntoCombinedFund {
        bearer p;
        goal achievement {
            condition plan_merged_into_combined_fund_as_of_february_1_1993(plan);
            window [-infinity, @1993-02-01];
        }
    };
}
relation merger_not_treated_as_employer_withdrawal(plan: UmwaBenefitPlan) kind institutional {
    label en official "section 9702(a)(2): the merger is not treated as an employer withdrawal for purposes of any 1988 coal wage agreement";
}
@source(IRC_S9702_A, relation = formalizes, coverage = exact, quote = "and such merger shall not be treated as an employer withdrawal for purposes of any 1988 coal wage agreement.")
rule MergerNotAnEmployerWithdrawal(plan: UmwaBenefitPlan) strict {
    when plan_merged_into_combined_fund_as_of_february_1_1993(plan);
    then merger_not_treated_as_employer_withdrawal(plan);
}

// =====================================================================
// Section 9702(b)(3): if the BCOA ceases to exist, the three employers with the most assigned beneficiaries designate
// =====================================================================

relation bcoa_ceased_to_exist() kind empirical {
    label en official "the BCOA has ceased to exist";
}
relation bcoa_member_on_enactment_date(employer: Person) kind empirical {
    label en official "the employer was a member of the BCOA on the enactment date";
}
relation assigned_eligible_beneficiary_count_9706(employer: Person, count: Integer) kind empirical {
    label en official "the number of eligible beneficiaries assigned to the employer under section 9706";
}
relation among_three_bcoa_employers_with_most_assigned_beneficiaries(employer: Person) kind institutional {
    label en official "section 9702(b)(3): one of the 3 employers who were BCOA members on the enactment date and have been assigned the greatest number of eligible beneficiaries (JUDGMENT CALL: an employer tied for the third place is admitted, so a tie can yield more than 3)";
}
@source(IRC_S9702_B, relation = formalizes, coverage = exact, quote = "the 3 employers who were members of the BCOA on the enactment date and who have been assigned the greatest number of eligible beneficiaries under section 9706.")
rule AmongThreeBcoaEmployersWithMostAssignedBeneficiaries(e: Person, n: Integer) strict {
    when bcoa_member_on_enactment_date(e)
        and assigned_eligible_beneficiary_count_9706(e, n)
        and count(collect m: Person, k: Integer where bcoa_member_on_enactment_date(m) and assigned_eligible_beneficiary_count_9706(m, k) and k > n) < 3;
    then among_three_bcoa_employers_with_most_assigned_beneficiaries(e);
}
relation designated_trustee_by_employer_after_bcoa_ceased(employer: Person, trustee: Person) kind empirical {
    label en official "the employer designates the individual as a trustee of the Combined Fund in place of a BCOA designee";
}
@source(IRC_S9702_B, relation = formalizes, coverage = exact, quote = "If the BCOA ceases to exist, any trustee or successor under paragraph (1)(A) shall be designated by the 3 employers")
rule TrusteeDesignatedByThreeEmployersAfterBcoaCeased(e: Person, t: Person) strict {
    when bcoa_ceased_to_exist() and among_three_bcoa_employers_with_most_assigned_beneficiaries(e) and designated_trustee_by_employer_after_bcoa_ceased(e, t);
    then is_trustee_of_combined_fund(t, "BCOA employers (section 9702(b)(3))");
}

// =====================================================================
// Section 9703(b)(2): plan payment rates
// =====================================================================

relation total_premium_payments_required_9704a(plan_year: Period, amount: Money) kind empirical {
    label en official "the total premium payments required to be paid to the Combined Fund under section 9704(a) for the plan year (a total over the assigned operators, supplied by the case)";
}
relation aggregate_death_benefit_premiums_9704c(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9703(b)(2)(B)(i): the aggregate death benefit premiums determined under section 9704(c) for the plan year";
}
relation amount_reserved_for_plan_administration_9703d(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9703(b)(2)(B)(ii): the amount reserved for plan administration under subsection (d)";
}
relation premium_reduction_by_9705_transfers(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9703(b)(2)(C)(i): the reduction in the total premium payments required under section 9704(a) by reason of transfers described in section 9705";
}
relation carryover_from_preceding_year_9704e3Bi(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9703(b)(2)(C)(ii)(I): a carryover to the plan year from a preceding plan year derived from amounts described in section 9704(e)(3)(B)(i)";
}
relation trustees_elect_to_use_carryover(plan_year: Period) kind empirical {
    label en official "section 9703(b)(2)(C)(ii)(II): the trustees elect to use the carryover to pay benefits for the current plan year";
}
relation interest_earned_by_combined_fund(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9703(b)(2)(C)(iii): the interest earned by the Combined Fund";
}
relation trustees_elect_to_use_interest(plan_year: Period) kind empirical {
    label en official "section 9703(b)(2)(C)(iii): the trustees elect to use the interest to pay benefits for the current plan year";
}
relation carryover_used_for_benefits(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9703(b)(2)(C)(ii): the carryover the trustees elected to use for the plan year";
}
relation interest_used_for_benefits(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9703(b)(2)(C)(iii): the interest the trustees elected to use for the plan year";
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(II) the trustees elect to use to pay benefits for the current plan year, and")
rule CarryoverUsedForBenefits(py: Period, a: Money) strict {
    when carryover_from_preceding_year_9704e3Bi(py, a) and trustees_elect_to_use_carryover(py);
    then carryover_used_for_benefits(py, a);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(iii) any interest earned by the Combined Fund which the trustees elect to use to pay benefits for the current plan year.")
rule InterestUsedForBenefits(py: Period, a: Money) strict {
    when interest_earned_by_combined_fund(py, a) and trustees_elect_to_use_interest(py);
    then interest_used_for_benefits(py, a);
}
relation combined_fund_benefit_payment_limit_before_adjustments(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9703(b)(2)(A)(ii): the total premium payments required to be paid to the Combined Fund under section 9704(a) for the plan year";
}
relation combined_fund_benefit_payment_limit_after_reductions(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9703(b)(2)(B): the amount reduced by the aggregate death benefit premiums and the amount reserved for plan administration";
}
relation combined_fund_benefit_payment_limit(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9703(b)(2)(A)(ii), (B), (C): the limit on aggregate payments for the plan year: total premium payments less the reductions plus the increases";
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(ii) result in aggregate payments for such plan year from the Combined Fund which do not exceed the total premium payments required to be paid to the Combined Fund under section 9704(a) for the plan year, adjusted as provided in subparagraphs (B) and (C).")
rule LimitBeforeAdjustments(py: Period, total: Money) strict {
    when total_premium_payments_required_9704a(py, total);
    then combined_fund_benefit_payment_limit_before_adjustments(py, total);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(i) by the aggregate death benefit premiums determined under section 9704(c) for the plan year, and")
rule LimitAfterReductions(py: Period, total: Money, death: Money, admin: Money) strict {
    when combined_fund_benefit_payment_limit_before_adjustments(py, total)
        and aggregate_death_benefit_premiums_9704c(py, death)
        and amount_reserved_for_plan_administration_9703d(py, admin);
    then combined_fund_benefit_payment_limit_after_reductions(py, total - death - admin);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(i) by any reduction in the total premium payments required to be paid under section 9704(a) by reason of transfers described in section 9705,")
rule LimitAfterIncreasesAllElected(py: Period, base: Money, tr: Money, co: Money, it: Money) strict {
    when combined_fund_benefit_payment_limit_after_reductions(py, base)
        and premium_reduction_by_9705_transfers(py, tr)
        and carryover_used_for_benefits(py, co)
        and interest_used_for_benefits(py, it);
    then combined_fund_benefit_payment_limit(py, base + tr + co + it);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "The amount determined under subparagraph (A)(ii) shall be increased—")
rule LimitAfterIncreasesNoCarryoverNoInterest(py: Period, base: Money, tr: Money) strict {
    when combined_fund_benefit_payment_limit_after_reductions(py, base)
        and premium_reduction_by_9705_transfers(py, tr)
        and not_known(carryover_elected_marker(py))
        and not_known(interest_elected_marker(py));
    then combined_fund_benefit_payment_limit(py, base + tr);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "The amount determined under subparagraph (A)(ii) shall be increased—")
rule LimitAfterIncreasesCarryoverOnly(py: Period, base: Money, tr: Money, co: Money) strict {
    when combined_fund_benefit_payment_limit_after_reductions(py, base)
        and premium_reduction_by_9705_transfers(py, tr)
        and carryover_used_for_benefits(py, co)
        and not_known(interest_elected_marker(py));
    then combined_fund_benefit_payment_limit(py, base + tr + co);
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "The amount determined under subparagraph (A)(ii) shall be increased—")
rule LimitAfterIncreasesInterestOnly(py: Period, base: Money, tr: Money, it: Money) strict {
    when combined_fund_benefit_payment_limit_after_reductions(py, base)
        and premium_reduction_by_9705_transfers(py, tr)
        and interest_used_for_benefits(py, it)
        and not_known(carryover_elected_marker(py));
    then combined_fund_benefit_payment_limit(py, base + tr + it);
}
relation carryover_elected_marker(plan_year: Period) kind institutional {
    label en official "marker: a carryover was elected for the plan year";
}
relation interest_elected_marker(plan_year: Period) kind institutional {
    label en official "marker: interest was elected for the plan year";
}
rule CarryoverElectedMarker(py: Period, a: Money) strict {
    when carryover_used_for_benefits(py, a);
    then carryover_elected_marker(py);
}
rule InterestElectedMarker(py: Period, a: Money) strict {
    when interest_used_for_benefits(py, a);
    then interest_elected_marker(py);
}
relation aggregate_payments_from_combined_fund(plan_year: Period, amount: Money) kind empirical {
    label en official "the aggregate payments for the plan year from the Combined Fund to the health care services plans";
}
relation plan_payment_rates_ensure_uniform_health_benefits(plan_year: Period) kind empirical {
    label en official "section 9703(b)(2)(A)(i): the negotiated rates vary as necessary to ensure that beneficiaries in different geographic areas have access to a uniform level of health benefits";
}
relation aggregate_payments_within_limit(plan_year: Period) kind institutional {
    label en official "section 9703(b)(2)(A)(ii): the aggregate payments for the plan year do not exceed the adjusted limit";
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(ii) result in aggregate payments for such plan year from the Combined Fund which do not exceed the total premium payments required to be paid to the Combined Fund under section 9704(a) for the plan year, adjusted as provided in subparagraphs (B) and (C).")
rule AggregatePaymentsWithinLimit(py: Period, paid: Money, limit: Money) strict {
    when aggregate_payments_from_combined_fund(py, paid) and combined_fund_benefit_payment_limit(py, limit) and paid <= limit;
    then aggregate_payments_within_limit(py);
}
relation plan_year_payment_rates_under_negotiation(plan_year: Period) kind empirical {
    label en official "the plan year for which the trustees negotiate payment rates with the health care services plans";
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "The trustees of the Combined Fund shall negotiate payment rates with the health care services plans described in paragraph (1) for each plan year which are in amounts which—")
rule PaymentRatesNegotiationDutyRule(py: Period) strict {
    when plan_year_payment_rates_under_negotiation(py);
    then duty S9703NegotiateRatesWithinLimit {
        bearer CombinedFund;
        goal achievement {
            condition aggregate_payments_within_limit(py);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9703_B, relation = formalizes, coverage = exact, quote = "(i) vary as necessary to ensure that beneficiaries in different geographic areas have access to a uniform level of health benefits; and")
rule PaymentRatesUniformityDutyRule(py: Period) strict {
    when plan_year_payment_rates_under_negotiation(py);
    then duty S9703RatesEnsureUniformBenefits {
        bearer CombinedFund;
        goal achievement {
            condition plan_payment_rates_ensure_uniform_health_benefits(py);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 9711(b): coverage of eligible recipients not receiving benefits on February 1, 1993
// =====================================================================

relation not_receiving_retiree_health_benefits_feb_1993(retiree: Person) kind empirical {
    label en official "section 9711(b)(1): as of February 1, 1993 the individual is not receiving retiree health benefits under the individual employer plan";
}
relation met_age_and_service_requirements_of_individual_employer_plan_feb_1993(retiree: Person) kind empirical {
    label en official "section 9711(b)(1): the individual has met the age and service requirements for eligibility under the plan as of February 1, 1993";
}
relation retired_from_coal_industry_after_sept_30_1994(retiree: Person) kind empirical {
    label en official "section 9711(b)(1): the individual retired from the coal industry after September 30, 1994";
}
relation becomes_eligible_for_individual_employer_plan_benefits_on(retiree: Person, on: Date) kind empirical {
    label en official "the date the individual becomes eligible to receive benefits under the plan";
}
relation eligible_recipient_coverage_required_9711b(operator: Person, retiree: Person, from: Date) kind institutional {
    label en official "section 9711(b)(1): the last signatory operator must provide the coverage to the individual (and the individual's eligible beneficiaries) from the time the individual becomes eligible";
}
@source(IRC_S9711_B, relation = formalizes, coverage = exact, quote = "shall, at such time as such individual becomes eligible to receive benefits under such plan, provide health benefits coverage to such individual and the individual's eligible beneficiaries which is described in paragraph (2).")
rule EligibleRecipientCoverageRequired(op: Person, r: Person, d: Date) strict {
    when is_last_signatory_operator_of(op, r)
        and not_receiving_retiree_health_benefits_feb_1993(r)
        and met_age_and_service_requirements_of_individual_employer_plan_feb_1993(r)
        and becomes_eligible_for_individual_employer_plan_benefits_on(r, d)
        and not_known(retired_from_coal_industry_after_sept_30_1994(r));
    then eligible_recipient_coverage_required_9711b(op, r, d);
}
@source(IRC_S9711_B, relation = formalizes, coverage = exact, quote = "The last signatory operator of any individual who, as of February 1, 1993, is not receiving retiree health benefits under the individual employer plan maintained by the last signatory operator pursuant to a 1978 or subsequent coal wage agreement")
rule EligibleRecipientCoverageDutyRule(op: Person, r: Person, d: Date) defeasible {
    when eligible_recipient_coverage_required_9711b(op, r, d);
    then duty S9711CoverageOfEligibleRecipients {
        bearer op;
        beneficiary r;
        goal maintenance {
            condition employer_plan_coverage_provided(op, r);
            window [d, infinity];
        }
    };
}

// =====================================================================
// Section 9711(c)(3), (4): the security that limits the related persons' liability; its refund
// =====================================================================

enum SecurityForm { Bond; LetterOfCredit; CashEscrow; OtherForm; }
relation security_9711_form(operator: Person, form: SecurityForm) kind empirical {
    label en official "section 9711(c)(3)(A)(i): the form of the security";
}
relation security_9711_provided_to_1992_plan_trustees_solely_for_premiums(operator: Person) kind empirical {
    label en official "section 9711(c)(3)(A)(ii): the security is provided to the trustees of the 1992 UMWA Benefit Plan solely for the purpose of paying premiums for beneficiaries who would be described in section 9712(b)(2)(B) if the requirements of section 9711 were not met";
}
relation operator_liability_cost_in_calendar_year(operator: Person, year: Integer, cost: Money) kind empirical {
    label en official "the cost of the last signatory operator's liability under section 9711 in the given calendar year";
}
relation security_9711_prior_calendar_years(operator: Person, y1: Integer, y2: Integer, y3: Integer) kind empirical {
    label en official "the 3 calendar years preceding the security";
}
relation security_9711_amount(operator: Person, amount: Money) kind empirical {
    label en official "the amount of the security";
}
relation security_9711_in_addition_to_other_security_required(operator: Person) kind empirical {
    label en official "section 9711(c)(3)(B): the security is in addition to any other security required under any other provision of this title";
}
relation security_9711_provided_on(operator: Person, on: Date) kind empirical {
    label en official "the date the security is provided";
}
relation security_9711_remains_in_place_until(operator: Person, until: Date) kind empirical {
    label en official "the date until which the security remains in place";
}
relation one_year_liability_average_of_prior_three_years(operator: Person, amount: Money) kind institutional {
    label en official "section 9711(c)(3)(A)(iii): 1 year of liability, determined by using the average cost of the operator's liability during the prior 3 calendar years";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(iii) is in an amount equal to 1 year of liability of the last signatory operator under this section, determined by using the average cost of such operator's liability during the prior 3 calendar years;")
rule OneYearLiabilityAverageOfPriorThreeYears(op: Person, y1: Integer, y2: Integer, y3: Integer, c1: Money, c2: Money, c3: Money) strict {
    when security_9711_prior_calendar_years(op, y1, y2, y3)
        and operator_liability_cost_in_calendar_year(op, y1, c1)
        and operator_liability_cost_in_calendar_year(op, y2, c2)
        and operator_liability_cost_in_calendar_year(op, y3, c3);
    then one_year_liability_average_of_prior_three_years(op, div_round(c1 + c2 + c3, 3.0, 2, "HALF_UP"));
}
relation security_9711_form_permitted(operator: Person) kind institutional {
    label en official "section 9711(c)(3)(A)(i): the security is a bond, letter of credit, or cash escrow";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(i) is in the form of a bond, letter of credit, or cash escrow,")
rule SecurityFormBond(op: Person) strict {
    when security_9711_form(op, Bond);
    then security_9711_form_permitted(op);
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(i) is in the form of a bond, letter of credit, or cash escrow,")
rule SecurityFormLetterOfCredit(op: Person) strict {
    when security_9711_form(op, LetterOfCredit);
    then security_9711_form_permitted(op);
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(i) is in the form of a bond, letter of credit, or cash escrow,")
rule SecurityFormCashEscrow(op: Person) strict {
    when security_9711_form(op, CashEscrow);
    then security_9711_form_permitted(op);
}
relation security_9711_amount_sufficient(operator: Person) kind institutional {
    label en official "section 9711(c)(3)(A)(iii): the security is in an amount equal to 1 year of liability";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(iii) is in an amount equal to 1 year of liability of the last signatory operator under this section")
rule SecurityAmountEqualsOneYearLiability(op: Person, amount: Money, oneyear: Money) strict {
    when security_9711_amount(op, amount) and one_year_liability_average_of_prior_three_years(op, oneyear) and amount == oneyear;
    then security_9711_amount_sufficient(op);
}
relation security_9711_assessed_on(operator: Person, on: Date) kind empirical {
    label en official "the date on which the security is examined for the 5-year requirement";
}
relation security_9711_in_place_five_years(operator: Person) kind institutional {
    label en official "section 9711(c)(3)(C): the security remains in place for 5 years";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(C) the security remains in place for 5 years.")
rule SecurityInPlaceFiveYears(op: Person, from: Date, until: Date) strict {
    when security_9711_provided_on(op, from) and security_9711_remains_in_place_until(op, until) and until >= add_calendar_period(from, 5 calendar_year);
    then security_9711_in_place_five_years(op);
}
relation security_meets_9711c3(operator: Person) kind institutional {
    label en official "section 9711(c)(3): the security meets the requirements of the paragraph";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "Security meets the requirements of this paragraph if—")
rule SecurityMeetsRequirements(op: Person) strict {
    when security_9711_form_permitted(op)
        and security_9711_provided_to_1992_plan_trustees_solely_for_premiums(op)
        and security_9711_amount_sufficient(op)
        and security_9711_in_addition_to_other_security_required(op)
        and security_9711_in_place_five_years(op);
    then security_meets_9711c3(op);
}
@source(IRC_S9711_C, relation = formalizes, coverage = partial, quote = "(A) security meeting the requirements of paragraph (3) is provided by or on behalf of—")
rule S9711SecurityShieldsRelatedPersonDerived(related: Person, operator: Person) strict {
    when is_related_person(related, operator) and security_meets_9711c3(operator);
    then security_shields_related_person(related, operator);
}
relation obligations_of_last_signatory_operator_terminated_on(operator: Person, on: Date) kind empirical {
    label en official "section 9711(c)(4)(A): the date the obligations of the last signatory operator under section 9711 terminate";
}
relation security_refund_date(operator: Person, on: Date) kind institutional {
    label en official "section 9711(c)(4): the earlier of the termination of the obligations and the end of the 5-year period";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "(B) the end of the 5-year period described in paragraph (3)(C).")
rule SecurityRefundDateFiveYearEndOnly(op: Person, from: Date) strict {
    when security_9711_provided_on(op, from) and not_known(obligations_termination_stated(op));
    then security_refund_date(op, add_calendar_period(from, 5 calendar_year));
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "The remaining amount of any security provided under this subsection (and earnings thereon) shall be refunded to the last signatory operator as of the earlier of—")
rule SecurityRefundDateEarlierOfTwo(op: Person, from: Date, term: Date) strict {
    when security_9711_provided_on(op, from) and obligations_of_last_signatory_operator_terminated_on(op, term);
    then security_refund_date(op, min(term, add_calendar_period(from, 5 calendar_year)));
}
relation obligations_termination_stated(operator: Person) kind institutional {
    label en official "marker: the termination date of the obligations is stated";
}
rule ObligationsTerminationStatedMarker(op: Person, d: Date) strict {
    when obligations_of_last_signatory_operator_terminated_on(op, d);
    then obligations_termination_stated(op);
}
relation security_remaining_amount_refunded_to(operator: Person) kind empirical {
    label en official "the remaining amount of the security (and earnings) was refunded to the last signatory operator";
}
@source(IRC_S9711_C, relation = formalizes, coverage = exact, quote = "The remaining amount of any security provided under this subsection (and earnings thereon) shall be refunded to the last signatory operator as of the earlier of—")
rule SecurityRefundDutyRule(op: Person, d: Date) strict {
    when security_refund_date(op, d);
    then duty S9711RefundRemainingSecurity {
        bearer Plan1992;
        beneficiary op;
        goal achievement {
            condition security_remaining_amount_refunded_to(op);
            window [d, infinity];
        }
    };
}

// =====================================================================
// Section 9712(a)(3), (4): the use of amounts transferred under the Surface Mining Control and Reclamation Act
// =====================================================================

enum SmcraTransferUse { PayHealthBenefitsUnder9712c; PayBenefitsUnderSmcra402h2C; PayCombinedFundBenefitsAndAdministration; OtherPurposeSpecifiedInSmcra; OtherUse; }
relation smcra_transfer_to_1992_plan_used_for(fiscal_year: Text, use: SmcraTransferUse) kind empirical {
    label en official "how an amount transferred to the 1992 UMWA Benefit Plan under subsections (h) and (i) of section 402 of the Surface Mining Control and Reclamation Act of 1977 was used for the fiscal year";
}
relation beneficiary_without_per_beneficiary_premium_9712d(p: Person) kind empirical {
    label en official "section 9712(a)(3)(B): the beneficiary for whom no monthly per beneficiary premium is paid pursuant to subsection (d)(1)(A) or (3)";
}
relation smcra_1992_plan_transfer_use_permitted(fiscal_year: Text) kind institutional {
    label en official "section 9712(a)(3)(B): the transferred amount is used to provide the health benefits of subsection (c) to beneficiaries for whom no monthly per beneficiary premium is paid";
}
@source(IRC_S9712_A, relation = formalizes, coverage = exact, quote = "Any amount transferred under subparagraph (A) for any fiscal year shall be used to provide the health benefits described in subsection (c) with respect to any beneficiary for whom no monthly per beneficiary premium is paid pursuant to paragraph (1)(A) or (3) of subsection (d).")
rule Smcra1992PlanTransferUsePermitted(fy: Text) strict {
    when smcra_transfer_to_1992_plan_used_for(fy, PayHealthBenefitsUnder9712c);
    then smcra_1992_plan_transfer_use_permitted(fy);
}
relation smcra_1993_plan_transfer_use_permitted(fiscal_year: Text) kind institutional {
    label en official "section 9712(a)(4)(B): the transferred amount is used to provide the health benefits described in section 402(h)(2)(C)(i) of the Surface Mining Control and Reclamation Act of 1977 to individuals described in section 402(h)(2)(C)";
}
@source(IRC_S9712_A, relation = formalizes, coverage = exact, quote = "Any amount transferred under subparagraph (A) for any fiscal year shall be used to provide the health benefits described in section 402(h)(2)(C)(i) of the Surface Mining Control and Reclamation Act of 1977 (30 U.S.C. 1232(h)(2)(C)(i)) to individuals described in section 402(h)(2)(C) of such Act (30 U.S.C. 1232(h)(2)(C)).")
rule Smcra1993PlanTransferUsePermitted(fy: Text) strict {
    when smcra_transfer_to_1992_plan_used_for(fy, PayBenefitsUnderSmcra402h2C);
    then smcra_1993_plan_transfer_use_permitted(fy);
}

// =====================================================================
// Section 9712(c)(2), (4), (5): managed care and cost containment
// =====================================================================

relation managed_care_rules_developed_by_1992_plan() kind empirical {
    label en official "section 9712(c)(2): the 1992 UMWA Benefit Plan has developed managed care and cost containment rules";
}
relation plan_1992_exists() kind empirical {
    label en official "the 1992 UMWA Benefit Plan exists";
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "The 1992 UMWA Benefit Plan shall develop managed care and cost containment rules which shall be applicable to the payment of benefits under this subsection.")
rule ManagedCareRulesDevelopmentDutyRule strict {
    when plan_1992_exists();
    then duty S9712DevelopManagedCareRules {
        bearer Plan1992;
        goal achievement {
            condition managed_care_rules_developed_by_1992_plan();
            window [-infinity, infinity];
        }
    };
}
relation last_signatory_operator_elects_to_use_managed_care(operator: Person) kind empirical {
    label en official "section 9712(c)(4): the last signatory operator required to maintain an individual employer plan under section 9711 elects to use the managed care and cost containment rules and programs";
}
relation trustees_permit_operator_to_use_managed_care(operator: Person) kind empirical {
    label en official "the board of trustees permits the operator to use the managed care and cost containment rules and programs";
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "The board of trustees of the 1992 UMWA Benefit Plan shall permit any last signatory operator required to maintain an individual employer plan under section 9711 to utilize the managed care and cost containment rules and programs developed under this subsection if the operator elects to do so.")
rule PermitOperatorManagedCareDutyRule(op: Person) strict {
    when last_signatory_operator_elects_to_use_managed_care(op);
    then duty S9712PermitOperatorToUseManagedCare {
        bearer Plan1992;
        beneficiary op;
        goal achievement {
            condition trustees_permit_operator_to_use_managed_care(op);
            window [-infinity, infinity];
        }
    };
}
relation peer_review_panel_established_by_settlors(panel: Text) kind empirical {
    label en official "section 9712(c)(5)(A): the medical peer review panel has been established by the settlors";
}
relation peer_review_panel_established_by_umwa_and_operators(panel: Text) kind empirical {
    label en official "section 9712(c)(5)(B): the medical peer review panel has been established by the United Mine Workers of America and a last signatory operator or group of operators";
}
relation peer_review_panel_validly_established(panel: Text) kind institutional {
    label en official "section 9712(c)(5): the panel was established under subparagraph (A) or (B)";
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "(A) by the settlors, or")
rule PeerReviewPanelEstablishedBySettlors(p: Text) strict {
    when peer_review_panel_established_by_settlors(p);
    then peer_review_panel_validly_established(p);
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "(B) by the United Mine Workers of America and a last signatory operator or group of operators.")
rule PeerReviewPanelEstablishedByUmwaAndOperators(p: Text) strict {
    when peer_review_panel_established_by_umwa_and_operators(p);
    then peer_review_panel_validly_established(p);
}
relation panel_standards_of_quality_include_accessibility(panel: Text) kind empirical {
    label en official "section 9712(c)(5) last sentence: the standards of quality include accessibility to medical care, taking into account that accessibility requirements may differ depending on the nature of the medical need";
}
relation managed_care_system_approved_by_panel(system: Text, panel: Text) kind empirical {
    label en official "the managed care system or cost containment is approved by the panel and meets its standards of quality";
}
relation managed_care_system_approved_under_standards_of_quality(system: Text) kind institutional {
    label en official "section 9712(c)(5): the system is approved by, and meets the standards of quality adopted by, a validly established medical peer review panel whose standards include accessibility";
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "Standards of quality shall include accessibility to medical care, taking into account that accessibility requirements may differ depending on the nature of the medical need.")
rule ManagedCareSystemApprovedUnderStandards(s: Text, p: Text) strict {
    when managed_care_system_approved_by_panel(s, p) and peer_review_panel_validly_established(p) and panel_standards_of_quality_include_accessibility(p);
    then managed_care_system_approved_under_standards_of_quality(s);
}
relation managed_care_system_implemented_by(p: Person, system: Text) kind empirical {
    label en official "the person (the board of trustees or a last signatory operator) implements the managed care system or cost containment";
}
@source(IRC_S9712_C, relation = formalizes, coverage = exact, quote = "may not be implemented unless it is approved by, and meets the standards of quality adopted by, a medical peer review panel")
rule ManagedCareImplementationProhibitionRule(p: Person, s: Text) defeasible {
    when managed_care_system_implemented_by(p, s);
    unless managed_care_system_approved_under_standards_of_quality(s) and managed_care_system_implemented_by(p, s);
    then prohibition ManagedCareSystemNotImplementedWithoutPeerReviewApproval {
        bearer p;
        action managed_care_system_implemented_by(p, s);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 9712(d): guarantee of benefits by the last signatory operators
// =====================================================================

relation is_1988_last_signatory_operator(operator: Person) kind institutional {
    label en official "section 9712(d)(6): a last signatory operator which is a 1988 agreement operator";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "For purposes of this section, the term \"1988 last signatory operator\" means a last signatory operator which is a 1988 agreement operator.")
rule Is1988LastSignatoryOperator(op: Person, r: Person) strict {
    when is_last_signatory_operator_of(op, r) and is_1988_agreement_operator(op);
    then is_1988_last_signatory_operator(op);
}
relation eligible_beneficiary_of_operator_receiving_1992_plan_benefits(operator: Person, beneficiary: Person) kind empirical {
    label en official "section 9712(d)(1)(A): the eligible beneficiary of the operator is described in subsection (b)(2) and is receiving benefits under the 1992 UMWA Benefit Plan";
}
relation monthly_per_beneficiary_premium_paid(operator: Person, beneficiary: Person) kind empirical {
    label en official "the operator pays the monthly per beneficiary premium for the beneficiary";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "(A) The payment of a monthly per beneficiary premium by each 1988 last signatory operator for each eligible beneficiary of such operator who is described in subsection (b)(2) and who is receiving benefits under the 1992 UMWA Benefit Plan.")
rule PerBeneficiaryPremiumDuty1988Rule(op: Person, b: Person) defeasible {
    when is_1988_last_signatory_operator(op) and eligible_beneficiary_of_operator_receiving_1992_plan_benefits(op, b);
    then duty S9712PayMonthlyPerBeneficiaryPremium {
        bearer op;
        beneficiary Plan1992;
        goal maintenance {
            condition monthly_per_beneficiary_premium_paid(op, b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "Any last signatory operator who is not a 1988 last signatory operator shall pay the monthly per beneficiary premium under paragraph (1)(A) for each eligible beneficiary described in such paragraph attributable to that operator.")
rule PerBeneficiaryPremiumDutyNon1988Rule(op: Person, b: Person, r: Person) defeasible {
    when is_last_signatory_operator_of(op, r) and eligible_beneficiary_of_operator_receiving_1992_plan_benefits(op, b) and not_known(is_1988_last_signatory_operator(op));
    then duty S9712PayMonthlyPerBeneficiaryPremiumNon1988 {
        bearer op;
        beneficiary Plan1992;
        goal maintenance {
            condition monthly_per_beneficiary_premium_paid(op, b);
            window [-infinity, infinity];
        }
    };
}
relation security_for_1992_plan_provided_by(operator: Person) kind empirical {
    label en official "section 9712(d)(1)(B): the operator has provided a bond, letter of credit, or cash escrow in an amount equal to a portion of the projected future cost to the 1992 UMWA Benefit Plan (the portion is fixed by the plan's contribution requirements: EXTERNAL_DEPENDENCY)";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "(B) The provision of a security (in the form of a bond, letter of credit, or cash escrow) in an amount equal to a portion of the projected future cost to the 1992 UMWA Benefit Plan of providing health benefits for eligible and potentially eligible beneficiaries attributable to the 1988 last signatory operator.")
rule SecurityForProjectedCostDuty1988Rule(op: Person) defeasible {
    when is_1988_last_signatory_operator(op);
    then duty S9712ProvideSecurityForProjectedCost {
        bearer op;
        beneficiary Plan1992;
        goal maintenance {
            condition security_for_1992_plan_provided_by(op);
            window [-infinity, infinity];
        }
    };
}
relation amounts_transferred_under_9712a3(fiscal_year: Text, amount: Money) kind empirical {
    label en official "section 9712(d)(1)(C): the amounts transferred to the 1992 UMWA Benefit Plan under subsection (a)(3)";
}
relation amounts_required_to_be_transferred_under_smcra_402h_i(fiscal_year: Text, amount: Money) kind empirical {
    label en official "section 9712(d)(1)(C): the amounts required to be transferred to the 1992 UMWA Benefit Plan under subsections (h) and (i) of section 402 of the Surface Mining Control and Reclamation Act of 1977";
}
relation attributable_beneficiaries_count(operator: Person, fiscal_year: Text, count: Integer) kind empirical {
    label en official "section 9712(d)(1)(C): the number of eligible and potentially eligible beneficiaries attributable to the operator";
}
relation total_attributable_beneficiaries_count(fiscal_year: Text, count: Integer) kind empirical {
    label en official "the number of eligible and potentially eligible beneficiaries attributable to all 1988 last signatory operators";
}
relation transfer_shortfall_for_backstop(fiscal_year: Text, shortfall: Money) kind institutional {
    label en official "section 9712(d)(1)(C): the amounts required to be transferred which were not so transferred";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "(C) If the amounts transferred under subsection (a)(3) are less than the amounts required to be transferred to the 1992 UMWA Benefit Plan under subsections (h) and (i) of section 402 of the Surface Mining Control and Reclamation Act of 1977 (30 U.S.C. 1232), the payment of an additional backstop premium by each 1988 last signatory operator which is equal to such operator's share of the amounts required to be so transferred but which were not so transferred, determined on the basis of the number of eligible and potentially eligible beneficiaries attributable to the operator.")
rule TransferShortfallForBackstop(fy: Text, got: Money, need: Money) strict {
    when amounts_transferred_under_9712a3(fy, got) and amounts_required_to_be_transferred_under_smcra_402h_i(fy, need) and got < need;
    then transfer_shortfall_for_backstop(fy, need - got);
}
relation backstop_premium(operator: Person, fiscal_year: Text, amount: Money) kind institutional {
    label en official "section 9712(d)(1)(C): the operator's share of the shortfall, by the number of eligible and potentially eligible beneficiaries attributable to it";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "the payment of an additional backstop premium by each 1988 last signatory operator which is equal to such operator's share of the amounts required to be so transferred but which were not so transferred")
rule BackstopPremiumShare(op: Person, fy: Text, short: Money, n: Integer, total: Integer) strict {
    when is_1988_last_signatory_operator(op)
        and transfer_shortfall_for_backstop(fy, short)
        and attributable_beneficiaries_count(op, fy, n)
        and total_attributable_beneficiaries_count(fy, total)
        and total > 0;
    then backstop_premium(op, fy, div_round(short * n, total * 1.0, 2, "HALF_UP"));
}
relation plan_1992_adjusts_per_beneficiary_premium_annually() kind empirical {
    label en official "section 9712(d)(2)(A): the 1992 UMWA Benefit Plan provides for annual adjustments of the per beneficiary premium to cover changes in the cost of benefits";
}
relation plan_1992_adjusts_backstop_premium() kind empirical {
    label en official "section 9712(d)(2)(B): the plan provides for adjustments as necessary to the annual backstop premium to reflect changes in the cost of benefits to beneficiaries for whom per beneficiary premiums are not paid";
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "(A) annual adjustments of the per beneficiary premium to cover changes in the cost of providing benefits to eligible beneficiaries, and")
rule PlanAdjustsPerBeneficiaryPremiumDutyRule strict {
    when plan_1992_exists();
    then duty S9712AdjustPerBeneficiaryPremiumAnnually {
        bearer Plan1992;
        goal maintenance {
            condition plan_1992_adjusts_per_beneficiary_premium_annually();
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9712_D, relation = formalizes, coverage = exact, quote = "(B) adjustments as necessary to the annual backstop premium to reflect changes in the cost of providing benefits to eligible beneficiaries for whom per beneficiary premiums are not paid.")
rule PlanAdjustsBackstopPremiumDutyRule strict {
    when plan_1992_exists();
    then duty S9712AdjustBackstopPremium {
        bearer Plan1992;
        goal maintenance {
            condition plan_1992_adjusts_backstop_premium();
            window [-infinity, infinity];
        }
    };
}

// Declared here for section 9701(c)(8)(C); the derivation is in module 05 (section 9704(j)(2)).
relation assigned_operator_described_in_9704j2(operator: Person) kind institutional {
    label en official "section 9704(j)(2): an assigned operator to which the prepayment subsection applies";
}
