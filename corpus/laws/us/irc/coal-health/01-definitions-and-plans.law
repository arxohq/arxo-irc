// 26 U.S.C. §9701 (definitions), §9702 (Combined Fund establishment), §9703
// (plan benefits), §9711 (continued obligations of individual employer
// plans), §9712 (1992 UMWA Benefit Plan).
//
// JUDGMENT CALLS:
//  - §9701's plan/agreement/operator definitions are `classification`
//    relations over locally declared entities (`UmwaBenefitPlan`,
//    `SignatoryOperator` as roles/relations on `Person`). §404(c) (pension
//    plan qualification), ERISA §3(1)/(37), and Labor Management Relations
//    Act §302(c)(5) cross-references are EXTERNAL_DEPENDENCY, not
//    reproduced.
//  - §9701(c)(2) "related person" tests (i)-(iii) reference §52(a)/(b)
//    controlled-group/common-control tests — EXTERNAL_DEPENDENCY (owned, if
//    anywhere, by a controlled-group package this task does not touch);
//    represented as a single case-supplied classification fact.
//  - §9702(a)(2)-(4) (plan merger, ERISA/LMRA plan-type classification, tax-
//    exempt treatment) and §9703(b)-(c) (health/death benefit PROVISION
//    duties) are the substantive institutional content; the underlying
//    health-care-services-plan negotiation and actuarial computations
//    ((b)(2), (c)) are TECH_GAP (no health-cost ledger).
//  - §9711/§9712: the "last signatory operator" coverage duty and the 1992
//    UMWA Benefit Plan's own eligibility gate (coverage ONLY of individuals
//    not eligible under the Combined Fund) are executable; the managed-care
//    standards-of-quality list (§9712(c)(3)) and the security/backstop
//    premium computations (§9711(c)(3), §9712(d)) are TECH_GAP (no
//    actuarial/cost-ledger machinery).

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

use self::{
    IRC_S9701_A,
    IRC_S9701_C,
    IRC_S9702_A,
    IRC_S9702_B,
    IRC_S9703_B,
    IRC_S9703_C,
    IRC_S9703_D,
    IRC_S9703_E,
    IRC_S9703_F,
    IRC_S9711_A,
    IRC_S9711_C,
    IRC_S9712_A,
    IRC_S9712_B,
    IRC_S9712_C,
    Organ,
    Person,
};

// --- §9701 Definitions -----------------------------------------------------

entity UmwaBenefitPlan { label en unofficial "a plan described in §404(c) providing health benefits to retirees/beneficiaries of the industry maintaining the 1950 UMWA Pension Plan"; }
const The1950UmwaBenefitPlan: UmwaBenefitPlan = entity_ref("urn:us:irc:coal_health:clir#The1950UmwaBenefitPlan") { label en official "1950 UMWA Benefit Plan"; }
const The1974UmwaBenefitPlan: UmwaBenefitPlan = entity_ref("urn:us:irc:coal_health:clir#The1974UmwaBenefitPlan") { label en official "1974 UMWA Benefit Plan"; }

relation retired_before_1976(p: Person) kind empirical;
relation is_1950_umwa_benefit_plan(plan: UmwaBenefitPlan) kind institutional {
    label en unofficial "the plan's participation is substantially limited to individuals who retired before 1976 (§9701(a)(1)(B))";
}
@source(IRC_S9701_A, relation = formalizes, coverage = partial, quote = "The term \"1950 UMWA Benefit Plan\" means a UMWA Benefit Plan, participation in which is substantially limited to individuals who retired before 1976.")
rule S9701Is1950Plan strict { then is_1950_umwa_benefit_plan(The1950UmwaBenefitPlan); }
@source(IRC_S9701_A, relation = formalizes, coverage = partial, quote = "The term \"1974 UMWA Benefit Plan\" means a UMWA Benefit Plan, participation in which is substantially limited to individuals who retired on or after January 1, 1976.")
rule S9701Is1974Plan strict { then is_1950_umwa_benefit_plan(The1974UmwaBenefitPlan); } // reuses the same classification shape; see note

entity UmwaPensionPlan { label en unofficial "a pension plan described in §404(c) or a continuation thereof"; }
const The1950UmwaPensionPlan: UmwaPensionPlan = entity_ref("urn:us:irc:coal_health:clir#The1950UmwaPensionPlan") { label en official "1950 UMWA Pension Plan"; }
const The1974UmwaPensionPlan: UmwaPensionPlan = entity_ref("urn:us:irc:coal_health:clir#The1974UmwaPensionPlan") { label en official "1974 UMWA Pension Plan"; }

relation is_signatory_operator(p: Person) kind institutional {
    label en unofficial "the person is or was a signatory to a coal wage agreement (§9701(c)(1))";
}
relation signatory_to_coal_wage_agreement(p: Person) kind empirical;
@source(IRC_S9701_C, relation = formalizes, coverage = exact, quote = "The term \"signatory operator\" means a person which is or was a signatory to a coal wage agreement.")
rule S9701SignatoryOperator strict {
    for p: Person;
    when signatory_to_coal_wage_agreement(p);
    then is_signatory_operator(p);
}

relation related_person_controlled_group(p: Person, operator: Person) kind empirical {
    label en unofficial "the person is a member of the §52(a) controlled group of corporations including the signatory operator — EXTERNAL_DEPENDENCY as to the §52(a) test itself";
}
relation is_related_person(p: Person, operator: Person) kind institutional {
    label en unofficial "the person is a related person to the signatory operator (§9701(c)(2))";
}
@source(IRC_S9701_C, relation = formalizes, coverage = partial, quote = "(i) a member of the controlled group of corporations (within the meaning of section 52(a)) which includes such signatory operator;")
rule S9701RelatedPersonControlledGroup strict {
    for p: Person;
    for operator: Person;
    when related_person_controlled_group(p, operator);
    then is_related_person(p, operator);
}

relation employed_in_coal_industry(p: Person, employer: Person) kind empirical;
relation is_last_signatory_operator(retiree: Person, operator: Person) kind institutional {
    label en unofficial "the operator was the most recent coal-industry employer of the retiree (§9701(c)(4)) — a case-supplied classification, not a computed 'most recent' over an employment history this package does not model as a ledger";
}

relation is_1988_agreement_operator(p: Person) kind institutional {
    label en unofficial "the person is a 1988 agreement operator per §9701(c)(3)(A)-(C)";
}
relation signatory_to_1988_agreement(p: Person) kind empirical;
@source(IRC_S9701_C, relation = formalizes, coverage = partial, quote = "(A) a signatory operator which was a signatory to the 1988 National Bituminous Coal Wage Agreement,")
rule S97011988AgreementOperatorA strict {
    for p: Person;
    when signatory_to_1988_agreement(p);
    then is_1988_agreement_operator(p);
}

// --- §9702 Establishment of the Combined Fund --------------------------------

const CombinedFund: Organ = entity_ref("urn:us:irc:coal_health:clir#CombinedFund") { label en official "United Mine Workers of America Combined Benefit Fund"; }

relation combined_fund_established(f: Organ) kind institutional;
relation trustees_designated(f: Organ) kind empirical {
    label en unofficial "the persons described in §9702(b) have designated the individuals to serve as trustees of the Combined Fund";
}
relation chapter_99_enacted() kind empirical {
    label en unofficial "a case-supplied fact standing for 'after the enactment date' — the trigger for the one-time §9702(a)(1) trustee-designation duty";
}
@source(IRC_S9702_A, relation = formalizes, coverage = partial, quote = "As soon as practicable (but not later than 60 days) after the enactment date, the persons described in subsection (b) shall designate the individuals to serve as trustees.")
rule S9702TrusteeDesignationDuty defeasible {
    when chapter_99_enacted();
    then duty S9702DesignateTrustees {
        bearer CombinedFund;
        beneficiary CombinedFund;
        goal achievement {
            condition trustees_designated(CombinedFund);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9702_A, relation = formalizes, coverage = partial, quote = "Such trustees shall create a new private plan to be known as the United Mine Workers of ")
rule S9702EstablishCombinedFund strict {
    when trustees_designated(CombinedFund);
    then combined_fund_established(CombinedFund);
}

relation tax_exempt_under_501a(f: Organ) kind institutional {
    label en unofficial "the Combined Fund and any related trust is treated as an organization exempt from tax under §501(a)";
}
@source(IRC_S9702_A, relation = formalizes, coverage = exact, quote = "For purposes of this title, the Combined Fund and any related trust shall be treated as an organization exempt from tax under section 501(a).")
rule S9702TaxExempt strict {
    when combined_fund_established(CombinedFund);
    then tax_exempt_under_501a(CombinedFund);
}

// --- §9702(a)(3) / §9712(a)(2) plan-type classification (ERISA/LMRA) ---------
//
// G4-pattern (G6-ERISA wire): the three limbs are case-selected classification
// facts — the package does NOT re-derive ERISA §3(1)/(37) or LMRA §302(c)(5).
// The pinned definitions live in `us.erisa.definitions`
// (erisa-sec3-29usc1002-2023.pdf); readers assert the classification.

relation plan_described_in_lmra_302c5(plan: UmwaBenefitPlan) kind empirical {
    label en unofficial "case fact/classification: the plan is described in LMRA section 302(c)(5) (§9702(a)(3)(A) / §9712(a)(2)(A)) — EXTERNAL_DEPENDENCY, classification asserted, not derived";
}
relation plan_is_ewbp_erisa_3_1(plan: UmwaBenefitPlan) kind empirical {
    label en unofficial "case fact/classification: the plan is an employee welfare benefit plan within ERISA section 3(1) (29 USC 1002(1), pinned in us.erisa.definitions) — EXTERNAL_DEPENDENCY, asserted, not derived";
}
relation plan_is_multiemployer_erisa_3_37(plan: UmwaBenefitPlan) kind empirical {
    label en unofficial "case fact/classification: the plan is a multiemployer plan within ERISA section 3(37) (29 USC 1002(37), pinned in us.erisa.definitions) — EXTERNAL_DEPENDENCY, asserted, not derived";
}
relation combined_fund_plan_type_ok_9702a3(plan: UmwaBenefitPlan) kind institutional {
    label en official "section 9702(a)(3): the plan is described in LMRA 302(c)(5) and is an ERISA 3(1) welfare plan and an ERISA 3(37) multiemployer plan";
}
@source(IRC_S9702_A, relation = formalizes, coverage = exact, quote = "(A) a plan described in section 302(c)(5) of the Labor Management Relations Act, 1947 (29 U.S.C. 186(c)(5)),\n(B) an employee welfare benefit plan within the meaning of section 3(1) of the Employee Retirement Income Security Act of 1974 (29 U.S.C. 1002(1)), and\n(C) a multiemployer plan within the meaning of section 3(37) of such Act (29 U.S.C. 1002(37)).")
rule CombinedFundPlanTypeOk9702a3(plan: UmwaBenefitPlan) strict {
    when plan_described_in_lmra_302c5(plan)
        and plan_is_ewbp_erisa_3_1(plan)
        and plan_is_multiemployer_erisa_3_37(plan);
    then combined_fund_plan_type_ok_9702a3(plan);
}
relation plan_1992_plan_type_ok_9712a2(plan: UmwaBenefitPlan) kind institutional {
    label en official "section 9712(a)(2): the 1992-plan limbs — LMRA 302(c)(5), ERISA 3(1), ERISA 3(37)";
}
@source(IRC_S9712_A, relation = formalizes, coverage = exact, quote = "(A) a plan described in section 302(c)(5) of the Labor Management Relations Act, 1947 (29 U.S.C. 186(c)(5)),\n(B) an employee welfare benefit plan within the meaning of section 3(1) of the Employee Retirement Income Security Act of 1974 (29 U.S.C. 1002(1)), and\n(C) a multiemployer plan within the meaning of section 3(37) of such Act (29 U.S.C. 1002(37)).")
rule Plan1992PlanTypeOk9712a2(plan: UmwaBenefitPlan) strict {
    when plan_described_in_lmra_302c5(plan)
        and plan_is_ewbp_erisa_3_1(plan)
        and plan_is_multiemployer_erisa_3_37(plan);
    then plan_1992_plan_type_ok_9712a2(plan);
}

relation is_trustee_of_combined_fund(p: Person, designated_by: Text) kind institutional;
relation designated_by_bcoa(p: Person) kind empirical;
@source(IRC_S9702_B, relation = formalizes, coverage = partial, quote = "(A) 2 individuals who represent employers in the coal mining industry shall be designated by the BCOA;")
rule S9702TrusteeByBcoa strict {
    for p: Person;
    when designated_by_bcoa(p);
    then is_trustee_of_combined_fund(p, "BCOA");
}

// --- §9703 Plan benefits ------------------------------------------------------

relation is_eligible_beneficiary_combined_fund(p: Person) kind institutional {
    label en unofficial "the person is an eligible beneficiary of the Combined Fund under §9703(f)";
}
relation receiving_benefits_july_20_1992(p: Person, plan: UmwaBenefitPlan) kind empirical;
@source(IRC_S9703_F, relation = formalizes, coverage = partial, quote = "(1) is a coal industry retiree who, on July 20, 1992, was eligible to receive, and receiving, benefits from the 1950 UMWA Benefit Plan or the 1974 UMWA Benefit Plan, or")
rule S9703EligibleBeneficiary strict {
    for p: Person;
    for plan: UmwaBenefitPlan;
    when receiving_benefits_july_20_1992(p, plan);
    then is_eligible_beneficiary_combined_fund(p);
}

relation health_benefits_provided(p: Person) kind empirical;
@source(IRC_S9703_B, relation = formalizes, coverage = partial, quote = "The trustees of the Combined Fund shall provide health care benefits to each eligible beneficiary by enrolling the beneficiary in a health care services plan which undertakes to provide such benefits on a prepaid risk basis.")
rule S9703HealthBenefitsDuty defeasible {
    for p: Person;
    when is_eligible_beneficiary_combined_fund(p);
    then duty S9703ProvideHealthBenefits {
        bearer CombinedFund;
        beneficiary p;
        goal maintenance {
            condition health_benefits_provided(p);
            window [-infinity, infinity];
        }
    };
}

relation death_benefits_eligible(p: Person) kind empirical {
    label en unofficial "the person is an eligible beneficiary described in §9703(f)(1) (a coal industry retiree, not a survivor deriving eligibility through one) — the (a)(2)/(c)(1) condition for death benefits coverage";
}
relation death_benefits_provided(p: Person) kind empirical;
@source(IRC_S9703_C, relation = formalizes, coverage = partial, quote = "The trustees of the Combined Fund shall provide death benefits coverage to each eligible beneficiary described in subsection (f)(1) which is identical to the benefits provided under the 1950 UMWA Pension Plan or 1974 UMWA Pension Plan, whichever is applicable,")
rule S9703DeathBenefitsDuty defeasible {
    for p: Person;
    when is_eligible_beneficiary_combined_fund(p) and death_benefits_eligible(p);
    then duty S9703ProvideDeathBenefits {
        bearer CombinedFund;
        beneficiary p;
        goal maintenance {
            condition death_benefits_provided(p);
            window [-infinity, infinity];
        }
    };
}

relation reserved_for_administration(amount: Money, premiums: Money) kind institutional {
    label en unofficial "the trustees' reservation for administrative costs, capped at 5 percent of the plan-year §9704(a) premiums (§9703(d))";
}
relation admin_reserve_requested(amount: Money, premiums: Money) kind empirical {
    label en unofficial "the trustees propose to reserve the stated amount out of the stated total plan-year premiums";
}
@source(IRC_S9703_D, relation = formalizes, coverage = exact, quote = "The trustees of the Combined Fund may reserve for each plan year, for use in payment of the administrative costs of the Combined Fund, an amount not to exceed 5 percent of the premiums to be paid to the Combined Fund under section 9704(a) during the plan year.")
rule S9703AdminReserveCap strict {
    for amount: Money;
    for premiums: Money;
    when admin_reserve_requested(amount, premiums) and amount <= round(premiums * 0.05, 2, "HALF_UP");
    then reserved_for_administration(amount, premiums);
}

relation not_receiving_benefits_july_20_1992(p: Person) kind empirical;
relation enrollment_barred(p: Person) kind institutional {
    label en unofficial "the Combined Fund may not enroll the individual — the §9703(e) limitation on enrollment";
}
@source(IRC_S9703_E, relation = formalizes, coverage = exact, quote = "The Combined Fund shall not enroll any individual who is not receiving benefits under the 1950 UMWA Benefit Plan or the 1974 UMWA Benefit Plan as of July 20, 1992.")
rule S9703EnrollmentLimitation strict {
    for p: Person;
    when not_receiving_benefits_july_20_1992(p);
    then enrollment_barred(p);
}

// --- §9711 Continued obligations of individual employer plans ----------------

relation is_last_signatory_operator_of(operator: Person, retiree: Person) kind empirical;
relation receiving_retiree_health_benefits_feb_1993(retiree: Person) kind empirical;
relation employer_plan_coverage_provided(operator: Person, retiree: Person) kind empirical;
@source(IRC_S9711_A, relation = formalizes, coverage = partial, quote = "The last signatory operator of any individual who, as of February 1, 1993, is receiving retiree health benefits from an individual employer plan maintained pursuant to a 1978 or subsequent coal wage a")
rule S9711CoverageOfCurrentRecipientsDuty defeasible {
    for operator: Person;
    for retiree: Person;
    when is_last_signatory_operator_of(operator, retiree) and receiving_retiree_health_benefits_feb_1993(retiree);
    then duty S9711CoverageOfCurrentRecipients {
        bearer operator;
        beneficiary retiree;
        goal maintenance {
            condition employer_plan_coverage_provided(operator, retiree);
            window [-infinity, infinity];
        }
    };
}

relation related_person_jointly_liable_9711(related: Person, operator: Person) kind institutional {
    label en unofficial "the related person of the last signatory operator is jointly and severally liable for the §9711 coverage obligation (absent the (c)(2) security exception)";
}
relation security_provided_9711(operator: Person) kind empirical {
    label en unofficial "security meeting §9711(c)(3)'s requirements (bond/letter of credit/cash escrow, 1-year liability amount, 5-year duration) has been provided — the amount computation itself is TECH_GAP";
}
relation security_shields_related_person(related: Person, operator: Person) kind institutional {
    label en unofficial "security meeting §9711(c)(3) has been provided for the operator, shielding this related person from joint-and-several liability";
}
@source(IRC_S9711_C, relation = formalizes, coverage = partial, quote = "(A) security meeting the requirements of paragraph (3) is provided by or on behalf of—")
rule S9711SecurityShieldsRelatedPerson strict {
    for related: Person;
    for operator: Person;
    when is_related_person(related, operator) and security_provided_9711(operator);
    then security_shields_related_person(related, operator);
}
@source(IRC_S9711_C, relation = formalizes, coverage = partial, quote = "Except as provided in paragraph (2), each related person of a last signatory operator to which subsection (a) or (b) applies shall be jointly and severally liable with the last signatory operator for ")
rule S9711RelatedPersonJointlyLiable defeasible {
    for related: Person;
    for operator: Person;
    when is_related_person(related, operator);
    then related_person_jointly_liable_9711(related, operator);
    unless security_shields_related_person(related, operator);
}

// --- §9712 1992 UMWA Benefit Plan ---------------------------------------------

const Plan1992: Organ = entity_ref("urn:us:irc:coal_health:clir#Plan1992") { label en official "United Mine Workers of America 1992 Benefit Plan"; }
relation plan_1992_established(f: Organ) kind institutional;
@source(IRC_S9712_A, relation = formalizes, coverage = partial, quote = "As soon as practicable after the enactment date, the settlors shall create a separate private plan which shall be known as the United Mine Workers of America 1992 Benefit Plan.")
rule S9712EstablishPlan strict { then plan_1992_established(Plan1992); }

relation eligible_for_combined_fund(p: Person) kind institutional;
relation is_eligible_beneficiary_1992_plan(p: Person) kind institutional {
    label en unofficial "the individual is an eligible beneficiary of the 1992 UMWA Benefit Plan (§9712(b)(2)) — NOT eligible under the Combined Fund";
}
relation would_be_eligible_1950_or_1974_plan(p: Person) kind empirical;
@source(IRC_S9712_B, relation = formalizes, coverage = partial, quote = "(A) but for the enactment of this chapter, would be eligible to receive benefits from the 1950 UMWA Benefit Plan or the 1974 UMWA Benefit Plan, based upon age and service earned as of February 1, 1993")
rule S9712EligibleBeneficiary defeasible {
    for p: Person;
    when would_be_eligible_1950_or_1974_plan(p);
    then is_eligible_beneficiary_1992_plan(p);
    unless eligible_for_combined_fund(p);
}

relation plan_1992_health_benefits_provided(p: Person) kind empirical;
@source(IRC_S9712_C, relation = formalizes, coverage = partial, quote = "The 1992 UMWA Benefit Plan shall provide health care benefits coverage to each eligible beneficiary which is substantially the same as (and subject to all the limitations of) coverage provided under t")
rule S9712HealthBenefitsDuty defeasible {
    for p: Person;
    when is_eligible_beneficiary_1992_plan(p);
    then duty S9712ProvideHealthBenefits {
        bearer Plan1992;
        beneficiary p;
        goal maintenance {
            condition plan_1992_health_benefits_provided(p);
            window [-infinity, infinity];
        }
    };
}
