// Stage 3 (TECH_GAP reduction), part B: sections 9704(b)(3), (d)(2)(B), (e), (f)(2), (i), (j); 9705(a)(2)-(3), (b)(2);
// 9706(b)(1), (h)(1); 9707(d)(1).
//
// The premium accounts, transfers and carryovers are computed from RECORDED per-year items (sums over empirical
// relations); nothing here reads a balance that a rule of the same chain produced (LDC-E4102).

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

use self::{
    CombinedFund,
    CommissionerOfSocialSecurity,
    IRC_S9704_B,
    IRC_S9704_D,
    IRC_S9704_E,
    IRC_S9704_F,
    IRC_S9704_I,
    IRC_S9704_J,
    IRC_S9705_A,
    IRC_S9705_B,
    IRC_S9706_B,
    IRC_S9706_H,
    IRC_S9707_D,
    Organ,
    Period,
    Person,
    The1950UmwaBenefitPlan,
    annual_premium,
    applicable_percentage,
    assigned_operator_described_in_9704j2,
    assigned_to,
    chapter_99_enacted,
    common_parent_jointly_liable,
    common_parent_solely_liable,
    death_benefit_premium,
    health_benefit_premium,
    is_1988_agreement_operator,
    is_related_person,
    is_signatory_operator,
    per_beneficiary_premium,
    reassignment_valid,
    umwa_1950_plan_transfer,
    unassigned_beneficiaries_premium,
};

relation plan_year_begins_on(plan_year: Period, begins: Date) kind empirical {
    label en official "the first day of the plan year of the Combined Fund";
}
relation plan_year_number(plan_year: Period, number: Integer) kind empirical {
    label en official "the ordinal number of the plan year (1 for the plan year beginning February 1, 1993)";
}

// =====================================================================
// Section 9704(b)(3): adjustment for medicare reductions
// =====================================================================

relation medicare_reduction_occurs_in_plan_year_beginning(begins: Date) kind empirical {
    label en official "section 9704(b)(3): by reason of a reduction in benefits under title XVIII of the Social Security Act the level of health benefits under the Combined Fund would be reduced, in the plan year beginning on the given date";
}
relation amount_necessary_to_maintain_health_benefit_level(amount: Money) kind empirical {
    label en official "section 9704(b)(3): the amount necessary to maintain the level of health benefits which would have been provided without the reduction (the per beneficiary premium increase)";
}
relation medicare_adjustment_applies(plan_year: Period) kind institutional {
    label en official "section 9704(b)(3): the plan year is the plan year in which the reduction occurs or a subsequent plan year";
}
@source(IRC_S9704_B, relation = formalizes, coverage = exact, quote = "the trustees of the Combined Fund shall increase the per beneficiary premium for the plan year in which the reduction occurs and each subsequent plan year")
rule MedicareAdjustmentApplies(py: Period, begins: Date, d0: Date) strict {
    when plan_year_begins_on(py, begins) and medicare_reduction_occurs_in_plan_year_beginning(d0) and begins >= d0;
    then medicare_adjustment_applies(py);
}
relation per_beneficiary_premium_adjusted_for_medicare(plan_year: Period, amount: Money) kind institutional {
    label en official "section 9704(b)(2), (3): the per beneficiary premium, increased by the amount necessary to maintain the level of health benefits from the plan year of a medicare reduction on";
}
@source(IRC_S9704_B, relation = formalizes, coverage = exact, quote = "by the amount necessary to maintain the level of health benefits which would have been provided without such reduction.")
rule PerBeneficiaryPremiumWithMedicareAdjustment(py: Period, base: Money, add: Money) strict {
    when per_beneficiary_premium(py, base) and medicare_adjustment_applies(py) and amount_necessary_to_maintain_health_benefit_level(add);
    then per_beneficiary_premium_adjusted_for_medicare(py, base + add);
}
@source(IRC_S9704_B, relation = formalizes, coverage = exact, quote = "The Commissioner of Social Security shall calculate a per beneficiary premium for each plan year beginning on or after February 1, 1993, which is equal to the sum of—")
rule PerBeneficiaryPremiumWithoutMedicareAdjustment(py: Period, base: Money) strict {
    when per_beneficiary_premium(py, base) and not_known(medicare_adjustment_applies(py));
    then per_beneficiary_premium_adjusted_for_medicare(py, base);
}

// =====================================================================
// Section 9704(d)(2)(B): inadequate transfers
// =====================================================================

relation amounts_transferred_under_9705b(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9704(d)(2)(B): the amounts transferred to the Combined Fund under section 9705(b) for the plan year";
}
relation amounts_required_to_be_transferred_under_smcra_402h2A_or_i(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9704(d)(2)(B): the amounts required to be transferred to the Combined Fund under subsection (h)(2)(A) or (i) of section 402 of the Surface Mining Control and Reclamation Act of 1977";
}
relation smcra_transfers_inadequate_for_plan_year(plan_year: Period, shortfall: Money) kind institutional {
    label en official "section 9704(d)(2)(B): for a plan year beginning on or after October 1, 2006 the transfers under section 9705(b) are less than the amounts required: the amount not transferred";
}
@source(IRC_S9704_D, relation = formalizes, coverage = exact, quote = "If, for any plan year beginning on or after October 1, 2006, the amounts transferred under section 9705(b) are less than the amounts required to be transferred to the Combined Fund under subsection (h)(2)(A) or (i) of section 402")
rule SmcraTransfersInadequate(py: Period, begins: Date, got: Money, need: Money) strict {
    when plan_year_begins_on(py, begins)
        and begins >= @2006-10-01
        and amounts_transferred_under_9705b(py, got)
        and amounts_required_to_be_transferred_under_smcra_402h2A_or_i(py, need)
        and got < need;
    then smcra_transfers_inadequate_for_plan_year(py, need - got);
}
relation smcra_transfers_inadequate_stated(plan_year: Period) kind institutional {
    label en official "marker: inadequate transfers are established for the plan year";
}
rule SmcraTransfersInadequateMarker(py: Period, s: Money) strict {
    when smcra_transfers_inadequate_for_plan_year(py, s);
    then smcra_transfers_inadequate_stated(py);
}
@source(IRC_S9704_D, relation = formalizes, coverage = exact, quote = "then the unassigned beneficiaries premium for any assigned operator shall be equal to the operator's applicable percentage of the amount required to be so transferred which was not so transferred.")
rule UnassignedPremiumOnInadequateTransfers(op: Person, py: Period, pct: Decimal, short: Money) strict {
    when applicable_percentage(op, py, pct) and smcra_transfers_inadequate_for_plan_year(py, short);
    then unassigned_beneficiaries_premium(op, py, round(short * pct, 2, "HALF_UP"));
}

// =====================================================================
// Section 9704(e): premium accounts, allocations, shortfalls and surpluses
// =====================================================================

enum PremiumAccount { HealthBenefitAccount; DeathBenefitAccount; UnassignedBeneficiariesAccount; }
relation premium_account_maintained(account: PremiumAccount) kind empirical {
    label en official "section 9704(e)(1): the trustees have established and maintain the separate account";
}
relation combined_fund_operating() kind empirical {
    label en official "the Combined Fund is established and operating";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "The trustees of the Combined Fund shall establish and maintain 3 separate accounts for each of the premiums described in subsections (b), (c), and (d).")
rule HealthAccountDutyRule strict {
    when combined_fund_operating();
    then duty S9704eMaintainHealthBenefitAccount {
        bearer CombinedFund;
        goal maintenance {
            condition premium_account_maintained(HealthBenefitAccount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "The trustees of the Combined Fund shall establish and maintain 3 separate accounts for each of the premiums described in subsections (b), (c), and (d).")
rule DeathAccountDutyRule strict {
    when combined_fund_operating();
    then duty S9704eMaintainDeathBenefitAccount {
        bearer CombinedFund;
        goal maintenance {
            condition premium_account_maintained(DeathBenefitAccount);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "The trustees of the Combined Fund shall establish and maintain 3 separate accounts for each of the premiums described in subsections (b), (c), and (d).")
rule UnassignedAccountDutyRule strict {
    when combined_fund_operating();
    then duty S9704eMaintainUnassignedBeneficiariesAccount {
        bearer CombinedFund;
        goal maintenance {
            condition premium_account_maintained(UnassignedBeneficiariesAccount);
            window [-infinity, infinity];
        }
    };
}
relation account_credited_with_premiums(plan_year: Period, account: PremiumAccount, amount: Money) kind empirical {
    label en official "section 9704(e)(1): the premiums received and credited to the account for the plan year";
}
relation account_credited_with_9705b_transfers(plan_year: Period, account: PremiumAccount, amount: Money) kind empirical {
    label en official "section 9704(e)(1): the amounts transferred under section 9705(b) and credited to the account";
}
relation account_debited_with_benefit_expenditures(plan_year: Period, account: PremiumAccount, amount: Money) kind empirical {
    label en official "section 9704(e)(1): the benefit expenditures allocable to the premiums and debited to the account (other than administrative costs)";
}
relation nonadministrative_expenditures_of_account_in_preceding_plan_year(plan_year: Period, account: PremiumAccount, amount: Money) kind empirical {
    label en official "section 9704(e)(2)(A): the expenditures (other than administrative costs) from the account during the plan year preceding the plan year";
}
relation administrative_costs_of_plan_year(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9704(e)(2)(A): the administrative costs of the plan year";
}
relation interest_earned_for_plan_year(plan_year: Period, amount: Money) kind empirical {
    label en official "section 9704(e)(2)(B): the interest earned by the Combined Fund for the plan year";
}
relation administrative_cost_allocated_to_account(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(2)(A): the share of the administrative costs allocated to the account on the basis of expenditures (other than administrative costs) from the accounts during the preceding plan year";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Administrative costs for any plan year shall be allocated to premium accounts under paragraph (1) on the basis of expenditures (other than administrative costs) from such accounts during the preceding plan year.")
rule AdministrativeCostAllocatedToAccount(py: Period, a: PremiumAccount, admin: Money, e: Money) strict {
    when administrative_costs_of_plan_year(py, admin)
        and nonadministrative_expenditures_of_account_in_preceding_plan_year(py, a, e)
        and sum(collect all x: Money, k: PremiumAccount where nonadministrative_expenditures_of_account_in_preceding_plan_year(py, k, x), empty: 0.00 USD) > 0.00 USD;
    then administrative_cost_allocated_to_account(py, a,
        div_round(admin * (e / 1.00 USD), sum(collect all x2: Money, k2: PremiumAccount where nonadministrative_expenditures_of_account_in_preceding_plan_year(py, k2, x2), empty: 0.00 USD) / 1.00 USD, 2, "HALF_UP"));
}
relation interest_allocated_to_account(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(2)(B): interest is allocated to the account established for health benefit premiums";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Interest shall be allocated to the account established for health benefit premiums.")
rule InterestAllocatedToHealthAccount(py: Period, i: Money) strict {
    when interest_earned_for_plan_year(py, i);
    then interest_allocated_to_account(py, HealthBenefitAccount, i);
}
relation premium_account_result_before_transfers(plan_year: Period, account: PremiumAccount, result: Money) kind institutional {
    label en official "section 9704(e)(3)(A): the premiums credited (and, for the health benefit account, the interest) less the benefit expenditures and the allocated administrative costs; amounts credited from section 9705(b) transfers are not taken into account";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Amounts credited to an account from amounts transferred under section 9705(b) shall not be taken into account in determining whether there is a surplus in the account for purposes of this paragraph.")
rule PremiumAccountResultHealth(py: Period, prem: Money, ben: Money, adm: Money, i: Money) strict {
    when account_credited_with_premiums(py, HealthBenefitAccount, prem)
        and account_debited_with_benefit_expenditures(py, HealthBenefitAccount, ben)
        and administrative_cost_allocated_to_account(py, HealthBenefitAccount, adm)
        and interest_allocated_to_account(py, HealthBenefitAccount, i);
    then premium_account_result_before_transfers(py, HealthBenefitAccount, prem + i - ben - adm);
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "if, for any plan year, there is a shortfall or surplus in any premium account")
rule PremiumAccountResultOther(py: Period, a: PremiumAccount, prem: Money, ben: Money, adm: Money) strict {
    when account_credited_with_premiums(py, a, prem)
        and account_debited_with_benefit_expenditures(py, a, ben)
        and administrative_cost_allocated_to_account(py, a, adm)
        and (a == DeathBenefitAccount or a == UnassignedBeneficiariesAccount);
    then premium_account_result_before_transfers(py, a, prem - ben - adm);
}
relation premium_account_shortfall(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(3)(A): a shortfall in the account for the plan year";
}
relation premium_account_surplus(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(3)(A): a surplus in the account for the plan year";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "if, for any plan year, there is a shortfall or surplus in any premium account, the premium for the following plan year for each assigned operator shall be proportionately reduced or increased, whichever is applicable, by the amount of such shortfall or surplus.")
rule AccountShortfall(py: Period, a: PremiumAccount, r: Money) strict {
    when premium_account_result_before_transfers(py, a, r) and r < 0.00 USD;
    then premium_account_shortfall(py, a, 0.00 USD - r);
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "if, for any plan year, there is a shortfall or surplus in any premium account, the premium for the following plan year for each assigned operator shall be proportionately reduced or increased, whichever is applicable, by the amount of such shortfall or surplus.")
rule AccountSurplus(py: Period, a: PremiumAccount, r: Money) strict {
    when premium_account_result_before_transfers(py, a, r) and r > 0.00 USD;
    then premium_account_surplus(py, a, r);
}
relation surplus_reserved_for_carryover(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(3)(B)(i): a surplus in the health benefit or unassigned beneficiaries account attributable to the excess of premiums over benefits and administrative costs is available only for the carryover of section 9703(b)(2)(C)(ii), not for the reproration";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "(i) the excess of the premiums credited to such account for a plan year over the benefits (and administrative costs) debited to such account for the plan year, but such excess shall only be available for purposes of the carryover described in section 9703(b)(2)(C)(ii) (relating to carryovers of premiums not used to provide benefits), or")
rule SurplusReservedForCarryoverHealth(py: Period, s: Money) strict {
    when premium_account_surplus(py, HealthBenefitAccount, s);
    then surplus_reserved_for_carryover(py, HealthBenefitAccount, s);
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to any surplus in the health benefit premium account or the unassigned beneficiaries premium account which is attributable to—")
rule SurplusReservedForCarryoverUnassigned(py: Period, s: Money) strict {
    when premium_account_surplus(py, UnassignedBeneficiariesAccount, s);
    then surplus_reserved_for_carryover(py, UnassignedBeneficiariesAccount, s);
}
relation premium_account_adjustment_for_next_plan_year(plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(3)(A): the amount by which the premiums for the following plan year are changed: a shortfall increases them, a surplus (other than one reserved by subparagraph (B)) reduces them";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), if, for any plan year, there is a shortfall or surplus in any premium account")
rule AdjustmentForShortfall(py: Period, a: PremiumAccount, s: Money) strict {
    when premium_account_shortfall(py, a, s);
    then premium_account_adjustment_for_next_plan_year(py, a, s);
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "Except as provided in subparagraph (B), if, for any plan year, there is a shortfall or surplus in any premium account")
rule AdjustmentForDeathAccountSurplus(py: Period, s: Money) strict {
    when premium_account_surplus(py, DeathBenefitAccount, s);
    then premium_account_adjustment_for_next_plan_year(py, DeathBenefitAccount, 0.00 USD - s);
}
relation operator_account_premium(operator: Person, plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "the premium of the operator credited to the account for the plan year";
}
rule OperatorHealthAccountPremium(op: Person, py: Period, a: Money) strict {
    when health_benefit_premium(op, py, a);
    then operator_account_premium(op, py, HealthBenefitAccount, a);
}
rule OperatorDeathAccountPremium(op: Person, py: Period, a: Money) strict {
    when death_benefit_premium(op, py, a);
    then operator_account_premium(op, py, DeathBenefitAccount, a);
}
rule OperatorUnassignedAccountPremium(op: Person, py: Period, a: Money) strict {
    when unassigned_beneficiaries_premium(op, py, a);
    then operator_account_premium(op, py, UnassignedBeneficiariesAccount, a);
}
relation operator_premium_adjustment_next_plan_year(operator: Person, plan_year: Period, account: PremiumAccount, amount: Money) kind institutional {
    label en official "section 9704(e)(3)(A): the operator's proportionate share of the adjustment (positive increases, negative reduces the premium of the following plan year)";
}
@source(IRC_S9704_E, relation = formalizes, coverage = exact, quote = "the premium for the following plan year for each assigned operator shall be proportionately reduced or increased, whichever is applicable, by the amount of such shortfall or surplus.")
rule OperatorPremiumAdjustmentShare(op: Person, py: Period, a: PremiumAccount, adj: Money, mine: Money, credited: Money) strict {
    when premium_account_adjustment_for_next_plan_year(py, a, adj)
        and operator_account_premium(op, py, a, mine)
        and account_credited_with_premiums(py, a, credited)
        and credited > 0.00 USD;
    then operator_premium_adjustment_next_plan_year(op, py, a, div_round(adj * (mine / 1.00 USD), credited / 1.00 USD, 2, "HALF_UP"));
}

// =====================================================================
// Section 9704(f)(2): the annual redetermination of the applicable percentage
// =====================================================================

relation assigned_beneficiaries_as_of_october_1_1993(operator: Person, count: Decimal) kind empirical {
    label en official "section 9704(f)(1): the number of eligible beneficiaries assigned to the operator as of October 1, 1993";
}
relation total_assigned_beneficiaries_as_of_october_1_1993(count: Decimal) kind empirical {
    label en official "section 9704(f)(1): the total number of eligible beneficiaries assigned to all operators as of October 1, 1993";
}
relation assignment_change_by_appeal(operator: Person, on: Date, change: Decimal) kind empirical {
    label en official "section 9704(f)(2)(A): a change in the operator's assigned eligible beneficiaries pursuant to the appeals process under section 9706(f) (positive adds, negative removes)";
}
relation beneficiaries_of_operators_that_ceased_business_by(plan_year: Period, count: Decimal) kind empirical {
    label en official "section 9704(f)(2)(B): the eligible beneficiaries of assigned operators which (and all related persons with respect to which) ceased business during the period";
}
relation beneficiaries_whose_assignments_revoked_9706h(plan_year: Period, count: Decimal) kind empirical {
    label en official "section 9704(f)(2)(C): the eligible beneficiaries whose assignments have been revoked under section 9706(h)";
}
relation redetermined_operator_count(operator: Person, plan_year: Period, count: Decimal) kind institutional {
    label en official "section 9704(f)(2): the operator's assignments as of October 1, 1993 modified by the appeals of section 9706(f) through the last day of the preceding plan year";
}
relation redetermined_total_count(plan_year: Period, count: Decimal) kind institutional {
    label en official "section 9704(f)(2): the total number of assigned eligible beneficiaries, modified by appeals, reduced by the beneficiaries of operators that ceased business and, from plan years beginning on or after October 1, 2007, by revoked assignments";
}
@source(IRC_S9704_F, relation = formalizes, coverage = exact, quote = "(A) Such assignments shall be modified to reflect any changes during the period beginning October 1, 1993, and ending on the last day of the preceding plan year pursuant to the appeals process under section 9706(f).")
rule RedeterminedOperatorCount(op: Person, py: Period, begins: Date, base: Decimal) strict {
    when plan_year_begins_on(py, begins) and begins >= @1994-10-01 and assigned_beneficiaries_as_of_october_1_1993(op, base);
    then redetermined_operator_count(op, py,
        base + sum(collect all c: Decimal, dt: Date where assignment_change_by_appeal(op, dt, c) and dt >= @1993-10-01 and dt < begins, empty: 0.0));
}
@source(IRC_S9704_F, relation = formalizes, coverage = exact, quote = "(B) The total number of assigned eligible beneficiaries shall be reduced by the eligible beneficiaries of assigned operators which (and all related persons with respect to which) had ceased business (within the meaning of section 9701(c)(6)) during the period described in subparagraph (A).")
rule RedeterminedTotalCountBefore2007(py: Period, begins: Date, base: Decimal, ceased: Decimal) strict {
    when plan_year_begins_on(py, begins)
        and begins >= @1994-10-01
        and begins < @2007-10-01
        and total_assigned_beneficiaries_as_of_october_1_1993(base)
        and beneficiaries_of_operators_that_ceased_business_by(py, ceased);
    then redetermined_total_count(py,
        base + sum(collect all c: Decimal, o: Person, dt: Date where assignment_change_by_appeal(o, dt, c) and dt >= @1993-10-01 and dt < begins, empty: 0.0) - ceased);
}
@source(IRC_S9704_F, relation = formalizes, coverage = exact, quote = "(C) In the case of plan years beginning on or after October 1, 2007, the total number of assigned eligible beneficiaries shall be reduced by the eligible beneficiaries whose assignments have been revoked under section 9706(h).")
rule RedeterminedTotalCountFrom2007(py: Period, begins: Date, base: Decimal, ceased: Decimal, revoked: Decimal) strict {
    when plan_year_begins_on(py, begins)
        and begins >= @2007-10-01
        and total_assigned_beneficiaries_as_of_october_1_1993(base)
        and beneficiaries_of_operators_that_ceased_business_by(py, ceased)
        and beneficiaries_whose_assignments_revoked_9706h(py, revoked);
    then redetermined_total_count(py,
        base + sum(collect all c: Decimal, o: Person, dt: Date where assignment_change_by_appeal(o, dt, c) and dt >= @1993-10-01 and dt < begins, empty: 0.0) - ceased - revoked);
}
@source(IRC_S9704_F, relation = formalizes, coverage = exact, quote = "In the case of any plan year beginning on or after October 1, 1994, the applicable percentage for any assigned operator shall be redetermined under paragraph (1) by making the following changes to the assignments as of October 1, 1993:")
rule ApplicablePercentageRedetermined(op: Person, py: Period, own: Decimal, total: Decimal) strict {
    when redetermined_operator_count(op, py, own) and redetermined_total_count(py, total) and total > 0.0;
    then applicable_percentage(op, py, round(own / total, 6, "HALF_UP"));
}

// =====================================================================
// Section 9704(i): transition rules for the 1988 agreement operators
// =====================================================================

relation first_plan_year_benefits_and_administrative_costs(amount: Money) kind empirical {
    label en official "section 9704(i)(1)(A): the benefits and administrative costs of the Combined Fund incurred during the plan year beginning February 1, 1993";
}
relation contributions_under_1988_agreements_as_of_january_31_1993(operator: Person, amount: Money) kind empirical {
    label en official "section 9704(i)(1)(E): the aggregate contributions made by the operator under the applicable 1988 coal wage agreements as of January 31, 1993";
}
relation first_year_contributions_required_total(amount: Money) kind institutional {
    label en official "section 9704(i)(1)(A): the contributions the 1988 agreement operators make: the costs incurred, reduced by the amount transferred under section 9705(a) on February 1, 1993";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "reduced by the amount transferred to the Combined Fund under section 9705(a) on February 1, 1993.")
rule FirstYearContributionsRequiredTotal(costs: Money, t: Money) strict {
    when first_plan_year_benefits_and_administrative_costs(costs) and umwa_1950_plan_transfer("1993-02-01", t);
    then first_year_contributions_required_total(max(0.00 USD, costs - t));
}
relation first_year_contribution_required_of_operator(operator: Person, amount: Money) kind institutional {
    label en official "section 9704(i)(1)(A), (E): the 1988 agreement operator's ratable share of the first year contributions";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "Contributions under subparagraphs (A) and (B), and premium reductions under subparagraph (D)(ii), shall be made ratably on the basis of aggregate contributions made by such operators under the applicable 1988 coal wage agreements as of January 31, 1993.")
rule FirstYearContributionRequiredOfOperator(op: Person, req: Money, mine: Money) strict {
    when first_year_contributions_required_total(req)
        and contributions_under_1988_agreements_as_of_january_31_1993(op, mine)
        and is_1988_agreement_operator(op)
        and sum(collect all c: Money, o: Person where contributions_under_1988_agreements_as_of_january_31_1993(o, c) and is_1988_agreement_operator(o), empty: 0.00 USD) > 0.00 USD;
    then first_year_contribution_required_of_operator(op, div_round(req * (mine / 1.00 USD), sum(collect all c2: Money, o2: Person where contributions_under_1988_agreements_as_of_january_31_1993(o2, c2) and is_1988_agreement_operator(o2), empty: 0.00 USD) / 1.00 USD, 2, "HALF_UP"));
}
relation first_year_contribution_paid_by(operator: Person, amount: Money) kind empirical {
    label en official "the operator paid this amount under section 9704(i)(1)(A)";
}
relation first_year_contribution_met(operator: Person) kind institutional {
    label en official "the operator paid at least its ratable share of the first year contributions";
}
rule FirstYearContributionMet(op: Person, req: Money, paid: Money) strict {
    when first_year_contribution_required_of_operator(op, req) and first_year_contribution_paid_by(op, paid) and paid >= req;
    then first_year_contribution_met(op);
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "During the plan year of the Combined Fund beginning February 1, 1993, the 1988 agreement operators shall make contributions to the Combined Fund in amounts necessary to pay benefits and administrative costs of the Combined Fund incurred during such year")
rule FirstYearContributionDutyRule(op: Person, req: Money) strict {
    when first_year_contribution_required_of_operator(op, req);
    then duty S9704iFirstYearContribution {
        bearer op;
        beneficiary CombinedFund;
        goal achievement {
            condition first_year_contribution_met(op);
            window [@1993-02-01, @1994-01-31];
        }
    };
}
relation accrued_unpaid_expenses_of_merged_plans_feb_1_1993(amount: Money) kind empirical {
    label en official "section 9704(i)(1)(B): the expenses accrued (and remaining unpaid) by the 1950 and 1974 UMWA Benefit Plans as of February 1, 1993";
}
relation assets_of_merged_plans_feb_1_1993(amount: Money) kind empirical {
    label en official "section 9704(i)(1)(B): the assets of such plans as of that date";
}
relation deficit_contributions_required_total(amount: Money) kind institutional {
    label en official "section 9704(i)(1)(B): the contributions necessary to pay off the accrued unpaid expenses, reduced by the assets of the plans";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "as are necessary to pay off the expenses accrued (and remaining unpaid) by the 1950 UMWA Benefit Plan and the 1974 UMWA Benefit Plan as of February 1, 1993, reduced by the assets of such plans as of such date.")
rule DeficitContributionsRequiredTotal(exp: Money, assets: Money) strict {
    when accrued_unpaid_expenses_of_merged_plans_feb_1_1993(exp) and assets_of_merged_plans_feb_1_1993(assets);
    then deficit_contributions_required_total(max(0.00 USD, exp - assets));
}
relation deficit_contribution_required_of_operator(operator: Person, amount: Money) kind institutional {
    label en official "section 9704(i)(1)(B), (E): the 1988 agreement operator's ratable share of the deficit contributions";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "During the period beginning February 1, 1993, and ending September 30, 1994, the 1988 agreement operators shall make contributions to the Combined Fund as are necessary")
rule DeficitContributionRequiredOfOperator(op: Person, req: Money, mine: Money) strict {
    when deficit_contributions_required_total(req)
        and contributions_under_1988_agreements_as_of_january_31_1993(op, mine)
        and is_1988_agreement_operator(op)
        and sum(collect all c: Money, o: Person where contributions_under_1988_agreements_as_of_january_31_1993(o, c) and is_1988_agreement_operator(o), empty: 0.00 USD) > 0.00 USD;
    then deficit_contribution_required_of_operator(op, div_round(req * (mine / 1.00 USD), sum(collect all c2: Money, o2: Person where contributions_under_1988_agreements_as_of_january_31_1993(o2, c2) and is_1988_agreement_operator(o2), empty: 0.00 USD) / 1.00 USD, 2, "HALF_UP"));
}
relation deficit_contribution_paid_by(operator: Person, amount: Money) kind empirical {
    label en official "the operator paid this amount under section 9704(i)(1)(B)";
}
relation deficit_contribution_met(operator: Person) kind institutional {
    label en official "the operator paid at least its ratable share of the deficit contributions";
}
rule DeficitContributionMet(op: Person, req: Money, paid: Money) strict {
    when deficit_contribution_required_of_operator(op, req) and deficit_contribution_paid_by(op, paid) and paid >= req;
    then deficit_contribution_met(op);
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "(B) Deficits from merged plans")
rule DeficitContributionDutyRule(op: Person, req: Money) strict {
    when deficit_contribution_required_of_operator(op, req);
    then duty S9704iDeficitContribution {
        bearer op;
        beneficiary CombinedFund;
        goal achievement {
            condition deficit_contribution_met(op);
            window [@1993-02-01, @1994-09-30];
        }
    };
}
relation transition_obligation_failed_by(operator: Person) kind empirical {
    label en official "section 9704(i)(1)(C): the 1988 agreement operator fails to meet an obligation under paragraph (1)";
}
relation transition_failure_corrected(operator: Person) kind empirical {
    label en official "the failure has been corrected";
}
relation contributions_not_deductible_until_failure_corrected(operator: Person) kind institutional {
    label en official "section 9704(i)(1)(C): the operator's contributions to the Combined Fund or any other plan described in section 404(c) are not deductible until the failure is corrected";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "shall not be deductible under this title until such time as the failure is corrected.")
rule ContributionsNotDeductibleUntilFailureCorrected(op: Person) strict {
    when transition_obligation_failed_by(op) and not_known(transition_failure_corrected(op));
    then contributions_not_deductible_until_failure_corrected(op);
}
relation claims_payments_to_combined_fund_as_of_feb_1_1993(amount: Money) kind empirical {
    label en official "section 9704(i)(1)(D)(ii): the amounts paid to the Combined Fund by reason of claims arising in connection with the 1950 and 1974 UMWA Benefit Plans as of February 1, 1993, including claims based on the \"evergreen clause\"";
}
relation transition_premium_reduction_available(operator: Person, amount: Money) kind institutional {
    label en official "section 9704(i)(1)(D): the premium reduction available: the first year contributions paid, plus the claim payments allocated to the operator, not beyond the deficit contributions the operator paid";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "(i) 1st year payments")
rule TransitionPremiumReductionAvailable(op: Person, paidA: Money, paidB: Money, claims: Money, mine: Money) strict {
    when first_year_contribution_paid_by(op, paidA)
        and deficit_contribution_paid_by(op, paidB)
        and claims_payments_to_combined_fund_as_of_feb_1_1993(claims)
        and contributions_under_1988_agreements_as_of_january_31_1993(op, mine)
        and is_1988_agreement_operator(op)
        and sum(collect all c: Money, o: Person where contributions_under_1988_agreements_as_of_january_31_1993(o, c) and is_1988_agreement_operator(o), empty: 0.00 USD) > 0.00 USD;
    then transition_premium_reduction_available(op,
        paidA + min(paidB, div_round(claims * (mine / 1.00 USD), sum(collect all c2: Money, o2: Person where contributions_under_1988_agreements_as_of_january_31_1993(o2, c2) and is_1988_agreement_operator(o2), empty: 0.00 USD) / 1.00 USD, 2, "HALF_UP")));
}
relation transition_reduction_applied_in_plan_year(operator: Person, plan_year_number: Integer, amount: Money) kind empirical {
    label en official "section 9704(i)(1)(D)(iv): the premium reduction already applied in an earlier plan year";
}
relation transition_premium_reduction_for_plan_year(operator: Person, plan_year: Period, amount: Money) kind institutional {
    label en official "section 9704(i)(1)(D)(iv): the premium of the plan year is reduced by the reduction still available, until the amounts are exhausted";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "Premiums under subsection (a) shall be reduced for the first plan year for which amounts described in clause (i) or (ii) are available and for any succeeding plan year until such amounts are exhausted.")
rule TransitionPremiumReductionForPlanYear(op: Person, py: Period, n: Integer, avail: Money, prem: Money) strict {
    when transition_premium_reduction_available(op, avail)
        and plan_year_number(py, n)
        and annual_premium(op, py, prem);
    then transition_premium_reduction_for_plan_year(op, py,
        min(prem, max(0.00 USD, avail - sum(collect all u: Money, k: Integer where transition_reduction_applied_in_plan_year(op, k, u) and k < n, empty: 0.00 USD))));
}
relation combined_fund_first_plan_year(plan_year: Period) kind institutional {
    label en official "section 9704(i)(2): the plan year of the Combined Fund beginning February 1, 1993";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "In the case of the plan year of the Combined Fund beginning February 1, 1993—")
rule CombinedFundFirstPlanYear(py: Period) strict {
    when plan_year_begins_on(py, @1993-02-01);
    then combined_fund_first_plan_year(py);
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "(A) the premiums under subsections (a)(1) and (a)(3) shall be 67 percent of such premiums without regard to this paragraph, and")
rule AnnualPremiumFirstPlanYear(op: Person, py: Period, health: Money, death: Money, unassigned: Money) strict {
    when combined_fund_first_plan_year(py)
        and health_benefit_premium(op, py, health)
        and death_benefit_premium(op, py, death)
        and unassigned_beneficiaries_premium(op, py, unassigned);
    then annual_premium(op, py, round(health * 0.67, 2, "HALF_UP") + death + round(unassigned * 0.67, 2, "HALF_UP"));
}
relation startup_costs_before_february_1_1993(amount: Money) kind empirical {
    label en official "section 9704(i)(3): the costs of the Combined Fund incurred before February 1, 1993";
}
relation startup_costs_paid_by_1950_and_1974_plans() kind empirical {
    label en official "the 1950 and 1974 UMWA Benefit Plans paid the costs incurred before February 1, 1993";
}
relation startup_costs_treated_as_administrative_expenses_of_first_plan_year(amount: Money) kind institutional {
    label en official "section 9704(i)(3): for purposes of the section, such costs are treated as administrative expenses incurred for the plan year beginning February 1, 1993";
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "For purposes of this section, such costs shall be treated as administrative expenses incurred for the plan year beginning February 1, 1993.")
rule StartupCostsTreatedAsAdministrativeExpenses(a: Money) strict {
    when startup_costs_before_february_1_1993(a);
    then startup_costs_treated_as_administrative_expenses_of_first_plan_year(a);
}
@source(IRC_S9704_I, relation = formalizes, coverage = exact, quote = "The 1950 UMWA Benefit Plan and the 1974 UMWA Benefit Plan shall pay the costs of the Combined Fund incurred before February 1, 1993.")
rule StartupCostsDutyRule(a: Money) strict {
    when startup_costs_before_february_1_1993(a);
    then duty S9704iPayStartupCosts {
        bearer The1950UmwaBenefitPlan;
        beneficiary CombinedFund;
        goal achievement {
            condition startup_costs_paid_by_1950_and_1974_plans();
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 9704(j): prepayment of premium liability
// =====================================================================

relation contributed_to_1950_and_1974_plans_for_1988_agreement_period(person: Person) kind empirical {
    label en official "section 9704(j)(2)(A)(i)(I): the assigned operator (or a related person) made contributions to the 1950 and 1974 UMWA Benefit Plans for employment during the period covered by the 1988 agreement";
}
relation not_actively_engaged_in_coal_production_on_july_1_2005(operator: Person) kind empirical {
    label en official "section 9704(j)(2)(A)(ii): the assigned operator is not actively engaged in the production of coal as of July 1, 2005";
}
relation related_person_actively_engaged_in_coal_production_on_july_1_2005(operator: Person) kind empirical {
    label en official "section 9704(j)(2)(A)(ii): a related person to the assigned operator is actively engaged in the production of coal as of July 1, 2005";
}
relation member_of_controlled_group_on_july_20_1992(operator: Person, common_parent: Person) kind empirical {
    label en official "section 9704(j)(2)(A)(iii): as of July 20, 1992 the assigned operator was a member of a controlled group of corporations (section 52(a): EXTERNAL_DEPENDENCY) with the given common parent";
}
relation common_parent_shares_publicly_traded_on_us_exchange(parent: Person) kind empirical {
    label en official "section 9704(j)(2)(B): the common parent is a corporation the shares of which are publicly traded on a United States exchange";
}
relation controlled_group_described_in_9704j2B(operator: Person, common_parent: Person) kind institutional {
    label en official "section 9704(j)(2)(B): a controlled group whose common parent is a publicly traded corporation";
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "A controlled group of corporations is described in this subparagraph if the common parent of such group is a corporation the shares of which are publicly traded on a United States exchange.")
rule ControlledGroupDescribed(op: Person, parent: Person) strict {
    when member_of_controlled_group_on_july_20_1992(op, parent) and common_parent_shares_publicly_traded_on_us_exchange(parent);
    then controlled_group_described_in_9704j2B(op, parent);
}
relation ceased_to_be_assigned_operator_by_9706h1(operator: Person) kind empirical {
    label en official "section 9704(j)(2)(C): the person ceases to be an assigned operator by reason of section 9706(h)(1)";
}
relation liable_for_premiums_under_9706h3(operator: Person) kind empirical {
    label en official "section 9704(j)(2)(C): the person is liable for the payment of premiums under section 9706(h)(3)";
}
relation meets_9704j2A_conditions_other_than_status(operator: Person) kind institutional {
    label en official "section 9704(j)(2)(A)(i)-(iii): contributions made by the operator or a related person, not a 1988 agreement operator; neither the operator nor a related person engaged in coal production on July 1, 2005; a member of a described controlled group on July 20, 1992";
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(iii) the assigned operator was, as of July 20, 1992, a member of a controlled group of corporations described in subparagraph (B).")
rule MeetsJ2ConditionsOtherThanStatus(op: Person, parent: Person) strict {
    when contributed_to_1950_and_1974_plans_for_1988_agreement_period(op)
        and not_known(is_1988_agreement_operator(op))
        and not_actively_engaged_in_coal_production_on_july_1_2005(op)
        and not_known(related_person_actively_engaged_in_coal_production_on_july_1_2005(op))
        and controlled_group_described_in_9704j2B(op, parent);
    then meets_9704j2A_conditions_other_than_status(op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "This subsection shall apply to any assigned operator if—")
rule AssignedOperatorDescribedInJ2(op: Person, r: Person) strict {
    when assigned_to(r, op) and meets_9704j2A_conditions_other_than_status(op);
    then assigned_operator_described_in_9704j2(op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "A person shall not fail to be treated as an assigned operator to which this subsection applies solely because the person ceases to be an assigned operator by reason of section 9706(h)(1) if the person otherwise meets the requirements of this subsection and is liable for the payment of premiums under section 9706(h)(3).")
rule AssignedOperatorDescribedInJ2AfterRevocation(op: Person) strict {
    when ceased_to_be_assigned_operator_by_9706h1(op) and liable_for_premiums_under_9706h3(op) and meets_9704j2A_conditions_other_than_status(op);
    then assigned_operator_described_in_9704j2(op);
}
relation prepayment_amount_made(payer: Person, operator: Person, amount: Money) kind empirical {
    label en official "section 9704(j)(1)(A): the payment made to the Combined Fund by or on behalf of the assigned operator or a related person";
}
relation enrolled_actuary_present_value_of_premium_liability(payer: Person, operator: Person, value: Money) kind empirical {
    label en official "section 9704(j)(3)(A): the present value of the total premium liability as determined by the enrolled actuary using reasonable actuarial methods and assumptions (an evaluative determination of the actuary, DECISION-0194: an input)";
}
relation actuarial_report_filed_with_secretary_of_labor_on(payer: Person, operator: Person, on: Date) kind empirical {
    label en official "section 9704(j)(3)(B): the date the enrolled actuary files the signed actuarial report with the Secretary of Labor";
}
relation actuarial_report_states_valuation_date(payer: Person, operator: Person) kind empirical {
    label en official "section 9704(j)(3)(B)(i): the report states the date of the actuarial valuation";
}
relation actuary_statement_complete_accurate_and_reasonable_assumptions(payer: Person, operator: Person) kind empirical {
    label en official "section 9704(j)(3)(B)(ii): the actuary states that the report is complete and accurate and that the assumptions are in the aggregate reasonably related to the operator's experience and to reasonable expectations";
}
relation secretary_of_labor_notified_requirements_not_satisfied(payer: Person, operator: Person) kind empirical {
    label en official "section 9704(j)(3)(C): the Secretary of Labor has notified the assigned operator in writing that the requirements have not been satisfied";
}
relation prepayment_assessed_on(payer: Person, operator: Person, on: Date) kind empirical {
    label en official "the date on which the requirements of paragraph (3) are examined";
}
relation prepayment_amount_requirement_met(payer: Person, operator: Person) kind institutional {
    label en official "section 9704(j)(3)(A): the payment is not less than the present value of the total premium liability";
}
relation prepayment_report_requirement_met(payer: Person, operator: Person) kind institutional {
    label en official "section 9704(j)(3)(B): the actuarial report is filed with the Secretary of Labor with the valuation date and the actuary's statement";
}
relation prepayment_waiting_requirement_met(payer: Person, operator: Person) kind institutional {
    label en official "section 9704(j)(3)(C): 90 calendar days have elapsed after the report is filed and the Secretary of Labor has not notified that the requirements are not satisfied";
}
relation prepayment_meets_9704j3(payer: Person, operator: Person) kind institutional {
    label en official "section 9704(j)(3): the payment meets the requirements of the paragraph";
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(A) the amount of the payment is not less than the present value of the total premium liability under this chapter with respect to the Combined Fund")
rule PrepaymentAmountRequirementMet(p: Person, op: Person, amt: Money, pv: Money) strict {
    when prepayment_amount_made(p, op, amt) and enrolled_actuary_present_value_of_premium_liability(p, op, pv) and amt >= pv;
    then prepayment_amount_requirement_met(p, op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(B) such enrolled actuary files with the Secretary of Labor a signed actuarial report containing—")
rule PrepaymentReportRequirementMet(p: Person, op: Person, d: Date) strict {
    when actuarial_report_filed_with_secretary_of_labor_on(p, op, d)
        and actuarial_report_states_valuation_date(p, op)
        and actuary_statement_complete_accurate_and_reasonable_assumptions(p, op);
    then prepayment_report_requirement_met(p, op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(C) 90 calendar days have elapsed after the report required by subparagraph (B) is filed with the Secretary of Labor, and the Secretary of Labor has not notified the assigned operator in writing that the requirements of this paragraph have not been satisfied.")
rule PrepaymentWaitingRequirementMet(p: Person, op: Person, filed: Date, eval: Date) strict {
    when actuarial_report_filed_with_secretary_of_labor_on(p, op, filed)
        and prepayment_assessed_on(p, op, eval)
        and eval >= add_calendar_period(filed, 90 calendar_day)
        and not_known(secretary_of_labor_notified_requirements_not_satisfied(p, op));
    then prepayment_waiting_requirement_met(p, op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "A payment meets the requirements of this paragraph if—")
rule PrepaymentMeets9704j3(p: Person, op: Person) strict {
    when prepayment_amount_requirement_met(p, op) and prepayment_report_requirement_met(p, op) and prepayment_waiting_requirement_met(p, op);
    then prepayment_meets_9704j3(p, op);
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "then such common parent (and no other person) shall be liable for such premium.")
rule PrepaymentSubstitutionFromRequirements(parent: Person, op: Person, p: Person) strict {
    when prepayment_meets_9704j3(p, op) and common_parent_jointly_liable(parent, op);
    then common_parent_solely_liable(parent, op);
}
relation prepayment_account_established_for(payer: Person) kind empirical {
    label en official "section 9704(j)(4)(A): the Combined Fund established and maintains an account for the payer";
}
relation prepayment_credited_to_account_with_earnings(payer: Person) kind empirical {
    label en official "section 9704(j)(4)(B): the account is credited with the payment (and any earnings)";
}
relation prepayment_account_used_exclusively_for_premiums(payer: Person) kind empirical {
    label en official "section 9704(j)(4)(C): all amounts in the account are used exclusively to pay premiums that would (but for the subsection) be required to be paid by the assigned operator";
}
relation prepayment_account_obligations_terminated(payer: Person) kind empirical {
    label en official "section 9704(j)(4): the obligations for the premium liability for which the account is maintained have terminated";
}
relation remaining_prepayment_funds_refunded_to_designee(payer: Person) kind empirical {
    label en official "section 9704(j)(4): the remaining funds (and earnings) were refunded to the person designated by the common parent";
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(A) establish and maintain an account for each assigned operator or related person by, or on whose behalf, a payment described in paragraph (3) was made,")
rule PrepaymentAccountEstablishDutyRule(p: Person, op: Person) strict {
    when prepayment_meets_9704j3(p, op);
    then duty S9704jEstablishPrepaymentAccount {
        bearer CombinedFund;
        beneficiary p;
        goal maintenance {
            condition prepayment_account_established_for(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(B) credit such account with such payment (and any earnings thereon), and")
rule PrepaymentAccountCreditDutyRule(p: Person, op: Person) strict {
    when prepayment_meets_9704j3(p, op);
    then duty S9704jCreditPrepaymentAccount {
        bearer CombinedFund;
        beneficiary p;
        goal maintenance {
            condition prepayment_credited_to_account_with_earnings(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "(C) use all amounts in such account exclusively to pay premiums that would (but for this subsection) be required to be paid by the assigned operator.")
rule PrepaymentAccountUseDutyRule(p: Person, op: Person) strict {
    when prepayment_meets_9704j3(p, op);
    then duty S9704jUsePrepaymentAccountForPremiums {
        bearer CombinedFund;
        beneficiary p;
        goal maintenance {
            condition prepayment_account_used_exclusively_for_premiums(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9704_J, relation = formalizes, coverage = exact, quote = "Upon termination of the obligations for the premium liability of any assigned operator or related person for which such account is maintained, all funds remaining in such account (and earnings thereon) shall be refunded to such person as may be designated by the common parent described in paragraph (1)(B).")
rule PrepaymentAccountRefundDutyRule(p: Person) strict {
    when prepayment_account_obligations_terminated(p);
    then duty S9704jRefundPrepaymentAccount {
        bearer CombinedFund;
        beneficiary p;
        goal achievement {
            condition remaining_prepayment_funds_refunded_to_designee(p);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 9705(a)(2), (3) and (b)(2)
// =====================================================================

const Board1950UmwaPensionPlan: Organ = entity_ref("urn:us:irc:coal_health:clir#Board1950UmwaPensionPlan") {
    label en official "the board of trustees of the 1950 UMWA Pension Plan";
}
relation board_segregated_210_million_from_general_assets() kind empirical {
    label en official "section 9705(a)(2): the board segregated $210,000,000 from the general assets of the plan";
}
relation reserved_funds_held_in_plan_until_disbursed() kind empirical {
    label en official "section 9705(a)(2): the segregated funds are held in the plan until disbursed pursuant to paragraph (1)";
}
relation interest_on_reserved_funds_deposited_to_general_assets() kind empirical {
    label en official "section 9705(a)(2): any interest on the funds was deposited into the general assets of the plan";
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "Immediately upon the enactment date, the board of trustees of the 1950 UMWA Pension Plan shall segregate $210,000,000 from the general assets of the plan.")
rule SegregateReservationDutyRule strict {
    when chapter_99_enacted();
    then duty S9705aSegregate210Million {
        bearer Board1950UmwaPensionPlan;
        goal achievement {
            condition board_segregated_210_million_from_general_assets();
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "Such funds shall be held in the plan until disbursed pursuant to paragraph (1).")
rule HoldReservationDutyRule strict {
    when chapter_99_enacted();
    then duty S9705aHoldReservedFunds {
        bearer Board1950UmwaPensionPlan;
        goal maintenance {
            condition reserved_funds_held_in_plan_until_disbursed();
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "Any interest on such funds shall be deposited into the general assets of the 1950 UMWA Pension Plan.")
rule DepositInterestDutyRule strict {
    when chapter_99_enacted();
    then duty S9705aDepositInterestToGeneralAssets {
        bearer Board1950UmwaPensionPlan;
        goal maintenance {
            condition interest_on_reserved_funds_deposited_to_general_assets();
            window [-infinity, infinity];
        }
    };
}
relation premium_reduction_from_february_1993_transfer(operator: Person, plan_year: Period, amount: Money) kind institutional {
    label en official "section 9705(a)(3)(A): the transfer on February 1, 1993 proportionately reduces the premium of each assigned operator for the plan year beginning February 1, 1993 (the operator's applicable percentage of the transfer)";
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "(A) in the case of the transfer on February 1, 1993, be used to proportionately reduce the premium of each assigned operator under section 9704(a) for the plan year of the Fund beginning February 1, 1993, and")
rule PremiumReductionFromFebruary1993Transfer(op: Person, py: Period, t: Money, pct: Decimal) strict {
    when combined_fund_first_plan_year(py) and umwa_1950_plan_transfer("1993-02-01", t) and applicable_percentage(op, py, pct);
    then premium_reduction_from_february_1993_transfer(op, py, round(t * pct, 2, "HALF_UP"));
}
relation transfer_funds_applied_in_plan_year(occasion: Text, plan_year_number: Integer, amount: Money) kind empirical {
    label en official "the part of the transfer already used in an earlier plan year";
}
relation transfer_occasion_first_plan_year_number(occasion: Text, number: Integer) kind empirical {
    label en official "the number of the plan year in which the transfer was made";
}
relation later_transfer_reduction_of_death_and_unassigned_premium(occasion: Text, operator: Person, plan_year: Period, amount: Money) kind institutional {
    label en official "section 9705(a)(3)(B): any other transfer proportionately reduces the unassigned beneficiary premium and the death benefit premium of each assigned operator for the plan year of the transfer and for any subsequent plan year in which the funds remain available";
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "(B) in the case of any other such transfer, be used to proportionately reduce the unassigned beneficiary premium under section 9704(a)(3) and the death benefit premium under section 9704(a)(2) of each assigned operator for the plan year in which transferred and for any subsequent plan year in which such funds remain available.")
rule LaterTransferReductionOfDeathAndUnassignedPremium(op: Person, py: Period, occ: Text, t: Money, n0: Integer, n: Integer, pct: Decimal, death: Money, un: Money) strict {
    when umwa_1950_plan_transfer(occ, t)
        and occ != "1993-02-01"
        and transfer_occasion_first_plan_year_number(occ, n0)
        and plan_year_number(py, n)
        and n >= n0
        and applicable_percentage(op, py, pct)
        and death_benefit_premium(op, py, death)
        and unassigned_beneficiaries_premium(op, py, un);
    then later_transfer_reduction_of_death_and_unassigned_premium(occ, op, py,
        min(death + un, round(max(0.00 USD, t - sum(collect all u: Money, k: Integer where transfer_funds_applied_in_plan_year(occ, k, u) and k < n, empty: 0.00 USD)) * pct, 2, "HALF_UP")));
}
relation uses_transferred_funds_to_pay_9704i1B_amounts(user: Organ) kind empirical {
    label en official "section 9705(a)(3) last sentence: the funds are used to pay amounts required to be paid by the 1988 agreement operators under section 9704(i)(1)(B)";
}
@source(IRC_S9705_A, relation = formalizes, coverage = exact, quote = "Such funds may not be used to pay any amounts required to be paid by the 1988 agreement operators under section 9704(i)(1)(B).")
rule TransferFundsNotUsedForDeficitContributionsRule(u: Organ) strict {
    when uses_transferred_funds_to_pay_9704i1B_amounts(u);
    then prohibition TransferredFundsNotUsedForDeficitContributions {
        bearer u;
        action uses_transferred_funds_to_pay_9704i1B_amounts(u);
        window [-infinity, infinity];
    };
}
enum SmcraCombinedFundUse { PayBenefitsOfCombinedFundBeneficiaries; PayAdministrativeCosts; OtherPurposeSpecificallyProvidedInSmcra; UnauthorizedUse; }
relation smcra_combined_fund_transfer_used_for(fiscal_year: Text, use: SmcraCombinedFundUse) kind empirical {
    label en official "how an amount transferred to the Combined Fund under subsections (h) and (i) of section 402 of the Surface Mining Control and Reclamation Act of 1977 was used for the fiscal year";
}
relation smcra_combined_fund_transfer_use_permitted(fiscal_year: Text) kind institutional {
    label en official "section 9705(b)(2): the amount is used to pay benefits and administrative costs of beneficiaries of the Combined Fund or for other purposes specifically provided in the Act";
}
@source(IRC_S9705_B, relation = formalizes, coverage = exact, quote = "shall be used to pay benefits and administrative costs of beneficiaries of the Combined Fund or for such other purposes as are specifically provided in the Act described in paragraph (1).")
rule SmcraCombinedFundUsePermittedBenefits(fy: Text) strict {
    when smcra_combined_fund_transfer_used_for(fy, PayBenefitsOfCombinedFundBeneficiaries);
    then smcra_combined_fund_transfer_use_permitted(fy);
}
@source(IRC_S9705_B, relation = formalizes, coverage = exact, quote = "shall be used to pay benefits and administrative costs of beneficiaries of the Combined Fund or for such other purposes as are specifically provided in the Act described in paragraph (1).")
rule SmcraCombinedFundUsePermittedAdministration(fy: Text) strict {
    when smcra_combined_fund_transfer_used_for(fy, PayAdministrativeCosts);
    then smcra_combined_fund_transfer_use_permitted(fy);
}
@source(IRC_S9705_B, relation = formalizes, coverage = exact, quote = "shall be used to pay benefits and administrative costs of beneficiaries of the Combined Fund or for such other purposes as are specifically provided in the Act described in paragraph (1).")
rule SmcraCombinedFundUsePermittedOtherSpecified(fy: Text) strict {
    when smcra_combined_fund_transfer_used_for(fy, OtherPurposeSpecificallyProvidedInSmcra);
    then smcra_combined_fund_transfer_use_permitted(fy);
}

// =====================================================================
// Section 9706(b)(1): aggregation of employment
// =====================================================================

relation coal_industry_employment_of_retiree(retiree: Person, employer: Person) kind empirical {
    label en official "the coal industry retiree was employed in the coal industry by the signatory operator";
}
relation employer_and_related_persons_no_longer_in_business(employer: Person) kind empirical {
    label en official "section 9706(b)(1)(B)(i): the person is (and all related persons with respect to which are) no longer in business";
}
relation employment_period_without_coal_wage_agreement(retiree: Person, employer: Person) kind empirical {
    label en official "section 9706(b)(1)(B)(ii): the employment was during a period during which the person was not a signatory to a coal wage agreement";
}
relation employment_taken_into_account(retiree: Person, employer: Person) kind institutional {
    label en official "section 9706(b)(1): the employment counts for the assignment, unless disregarded";
}
@source(IRC_S9706_B, relation = formalizes, coverage = exact, quote = "shall not be taken into account.")
rule EmploymentTakenIntoAccount(r: Person, e: Person) strict {
    when coal_industry_employment_of_retiree(r, e)
        and not_known(employer_and_related_persons_no_longer_in_business(e))
        and not_known(employment_period_without_coal_wage_agreement(r, e));
    then employment_taken_into_account(r, e);
}
relation employment_treated_as_by_related_person(retiree: Person, related: Person, employer: Person) kind institutional {
    label en official "section 9706(b)(1)(A): employment of a coal industry retiree by a signatory operator is treated as employment by any related person to the operator";
}
@source(IRC_S9706_B, relation = formalizes, coverage = exact, quote = "Any employment of a coal industry retiree in the coal industry by a signatory operator shall be treated as employment by any related persons to such operator.")
rule EmploymentTreatedAsByRelatedPerson(r: Person, rel: Person, e: Person) strict {
    when employment_taken_into_account(r, e) and is_signatory_operator(e) and is_related_person(rel, e);
    then employment_treated_as_by_related_person(r, rel, e);
}

// =====================================================================
// Section 9706(h)(1): revocation of assignments as of October 1, 2007
// =====================================================================

relation assignment_to_non_1988_agreement_operator_in_effect(retiree: Person, operator: Person) kind institutional {
    label en official "section 9706(h)(1)(A): an assignment to a person other than a 1988 agreement operator";
}
@source(IRC_S9706_H, relation = formalizes, coverage = exact, quote = "(A) revoke all assignments to persons other than 1988 agreement operators for purposes of assessing premiums for plan years beginning on and after October 1, 2007; and")
rule AssignmentToNon1988OperatorInEffect(r: Person, op: Person) strict {
    when assigned_to(r, op) and not_known(is_1988_agreement_operator(op));
    then assignment_to_non_1988_agreement_operator_in_effect(r, op);
}
relation assignment_revoked_for_premiums(retiree: Person, operator: Person) kind empirical {
    label en official "the Commissioner has revoked the assignment for purposes of assessing premiums";
}
@source(IRC_S9706_H, relation = formalizes, coverage = exact, quote = "(A) revoke all assignments to persons other than 1988 agreement operators for purposes of assessing premiums for plan years beginning on and after October 1, 2007; and")
rule RevokeAssignmentsDutyRule(r: Person, op: Person) defeasible {
    when assignment_to_non_1988_agreement_operator_in_effect(r, op);
    then duty S9706hRevokeAssignmentsToNon1988Operators {
        bearer CommissionerOfSocialSecurity;
        goal achievement {
            condition assignment_revoked_for_premiums(r, op);
            window [@2007-10-01, infinity];
        }
    };
}
relation assignment_made_on(retiree: Person, operator: Person, on: Date) kind empirical {
    label en official "the Commissioner makes an assignment of the retiree to the operator on the date";
}
@source(IRC_S9706_H, relation = formalizes, coverage = exact, quote = "(B) make no further assignments to persons other than 1988 agreement operators, except that no individual who becomes an unassigned beneficiary by reason of subparagraph (A) may be assigned to a 1988 agreement operator.")
rule NoFurtherAssignmentsToNon1988OperatorsRule(r: Person, op: Person, d: Date) defeasible {
    when assignment_made_on(r, op, d) and d >= @2007-10-01 and not_known(is_1988_agreement_operator(op));
    unless reassignment_valid(r, _, op) and assignment_made_on(r, op, d);
    then prohibition NoFurtherAssignmentsToNon1988AgreementOperators {
        bearer CommissionerOfSocialSecurity;
        action assignment_made_on(r, op, d);
        window [@2007-10-01, infinity];
    };
}
relation individual_unassigned_by_revocation(retiree: Person) kind empirical {
    label en official "section 9706(h)(1)(B): the individual became an unassigned beneficiary by reason of the revocation";
}
@source(IRC_S9706_H, relation = formalizes, coverage = exact, quote = "except that no individual who becomes an unassigned beneficiary by reason of subparagraph (A) may be assigned to a 1988 agreement operator.")
rule NoAssignmentOfRevokedIndividualTo1988OperatorRule(r: Person, op: Person, d: Date) strict {
    when individual_unassigned_by_revocation(r) and assignment_made_on(r, op, d) and is_1988_agreement_operator(op);
    then prohibition NoAssignmentOfRevokedIndividualTo1988Operator {
        bearer CommissionerOfSocialSecurity;
        action assignment_made_on(r, op, d);
        window [@2007-10-01, infinity];
    };
}

// =====================================================================
// Section 9707(d)(1): no penalty where nobody responsible knew or would have known
// =====================================================================

external judgment relation secretary_satisfied_no_person_responsible_knew_of_failure(operator: Person, retiree: Person, due: Date) {
    authority Secretary;
    label en official "section 9707(d)(1): it is established to the satisfaction of the Secretary of the Treasury that none of the persons responsible for the failure knew, or exercising reasonable diligence would have known, that the failure existed (DECISION-0194)";
}
relation no_penalty_for_failure_without_knowledge(operator: Person, retiree: Person, due: Date) kind institutional {
    label en official "section 9707(d)(1): no penalty is imposed on the failure during that period";
}
@source(IRC_S9707_D, relation = formalizes, coverage = exact, quote = "No penalty shall be imposed by subsection (a) on any failure during any period for which it is established to the satisfaction of the Secretary of the Treasury that none of the persons responsible for such failure knew, or exercising reasonable diligence would have known, that such failure existed.")
rule NoPenaltyForFailureWithoutKnowledge(op: Person, r: Person, d: Date) strict {
    when secretary_satisfied_no_person_responsible_knew_of_failure(op, r, d);
    then no_penalty_for_failure_without_knowledge(op, r, d);
}
