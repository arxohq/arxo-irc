// 26 U.S.C. §9706 (assignment of eligible beneficiaries), §9707 (failure to
// pay premium — $100/day penalty with reasonable cause), §9708 (effect on
// pending claims), §9721 (civil enforcement), §9722 (sham transactions).
//
// JUDGMENT CALLS:
//  - §9706(a)'s three-tier assignment ordering is the Commissioner of Social
//    Security's POWER, exercised in tiers 1→2→3, `valid_when` the tier's own
//    employment-history condition; each tier's condition is a case-supplied
//    classification (this package does not compute "most recent signatory
//    employer for at least 2 years" from a raw employment ledger).
//  - `CommissionerOfSocialSecurity` is declared LOCALLY in this package (an
//    `Organ` constant), not imported: `us.irc.core` names only Secretary/
//    IRS/TaxCourt/DistrictCourt/CourtOfFederalClaims/Congress (CONTRACT.md);
//    the Commissioner of Social Security is this chapter's own addressee,
//    so a local constant is correct per the layout convention (ask for a
//    core `pub` only when MULTIPLE owners need the same organ).
//  - §9706(f)(1)-(2) (30-day windows for requesting information and for
//    requesting review) are EXECUTABLE exact-window duties/powers.
//  - §9706(h)(3)'s declining percentage schedule (55%/40%/15% for FY2007-
//    2009) is EXECUTABLE as three dated facts, same style as trust-funds'
//    lump-sum rows.
//  - §9707's $100/day penalty is EXECUTABLE with the (d)(2) reasonable-cause
//    two-step (DECISION-0194: a `not_known(reasonable_cause)` defeater plus
//    the 30-day correction window) and the (d)(3) Secretary WAIVER power.
//  - §9721 (civil enforcement under ERISA §4301) and §9722 (sham
//    transactions, a Secretary power to disregard) are each modelled as a
//    single institutional_effect/power, the underlying ERISA §4301 procedure
//    itself EXTERNAL_DEPENDENCY.

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

use self::{
    IRC_S9706_A,
    IRC_S9706_B,
    IRC_S9706_F,
    IRC_S9706_H,
    IRC_S9707_B,
    IRC_S9707_C,
    IRC_S9707_D,
    IRC_S9707_E,
    IRC_S9708,
    IRC_S9721,
    IRC_S9722,
    Organ,
    Period,
    Person,
    no_penalty_for_failure_without_knowledge,
};

const CommissionerOfSocialSecurity: Organ = entity_ref("urn:us:irc:coal_health:clir#CommissionerOfSocialSecurity") {
    label en official "Commissioner of Social Security";
}

// --- §9706(a) Assignment ordering ---------------------------------------------

relation assigned_to(retiree: Person, operator: Person) kind institutional {
    label en unofficial "the Commissioner of Social Security has assigned the coal industry retiree to the signatory operator";
}
relation assignment_requested(retiree: Person, operator: Person) kind empirical;

relation tier1_condition(retiree: Person, operator: Person) kind empirical {
    label en unofficial "the operator was a signatory to the 1978 (or subsequent) coal wage agreement AND was the most recent signatory employer of the retiree for at least 2 years (§9706(a)(1))";
}
@source(IRC_S9706_A, relation = formalizes, coverage = partial, quote = "(1) First, to the signatory operator which—")
rule S9706AssignTier1 strict {
    for retiree: Person;
    for operator: Person;
    when assignment_requested(retiree, operator) and tier1_condition(retiree, operator);
    then power S9706AssignTier1Power {
        holder CommissionerOfSocialSecurity;
        over retiree;
        exercise assignment_requested(retiree, operator);
        valid_when tier1_condition(retiree, operator);
        effect create(assigned_to(retiree, operator));
    };
}

relation tier2_condition(retiree: Person, operator: Person) kind empirical {
    label en unofficial "the operator was a signatory to the 1978 (or subsequent) coal wage agreement and was the most recent signatory employer of the retiree (no 2-year minimum) — §9706(a)(2), applicable only if no tier-1 operator exists";
}
relation no_tier1_operator(retiree: Person) kind empirical {
    label en unofficial "no signatory operator satisfies tier 1 for this retiree — a case-supplied negative (not derived by this package from an employment ledger)";
}
relation tier2_eligible(retiree: Person, operator: Person) kind institutional {
    label en unofficial "tier 2 is reached and satisfied for this retiree/operator pair";
}
@source(IRC_S9706_A, relation = formalizes, coverage = partial, quote = "(2) Second, if the retiree is not assigned under paragraph (1), to the signatory operator which—")
rule S9706Tier2Eligible strict {
    for retiree: Person;
    for operator: Person;
    when tier2_condition(retiree, operator) and no_tier1_operator(retiree);
    then tier2_eligible(retiree, operator);
}
@source(IRC_S9706_A, relation = formalizes, coverage = partial, quote = "(2) Second, if the retiree is not assigned under paragraph (1), to the signatory operator which—")
rule S9706AssignTier2 strict {
    for retiree: Person;
    for operator: Person;
    when assignment_requested(retiree, operator) and tier2_eligible(retiree, operator);
    then power S9706AssignTier2Power {
        holder CommissionerOfSocialSecurity;
        over retiree;
        exercise assignment_requested(retiree, operator);
        valid_when tier2_eligible(retiree, operator);
        effect create(assigned_to(retiree, operator));
    };
}

relation tier3_condition(retiree: Person, operator: Person) kind empirical {
    label en unofficial "the operator employed the retiree in the coal industry longer than any other signatory operator (§9706(a)(3)), applicable only absent a tier-1 or tier-2 operator";
}
relation no_tier2_operator(retiree: Person) kind empirical;
relation tier3_eligible(retiree: Person, operator: Person) kind institutional;
@source(IRC_S9706_A, relation = formalizes, coverage = partial, quote = "(3) Third, if the retiree is not assigned under paragraph (1) or (2), to the signatory operator which employed the coal industry retiree in the coal industry for a longer period of time than any other")
rule S9706Tier3Eligible strict {
    for retiree: Person;
    for operator: Person;
    when tier3_condition(retiree, operator) and no_tier1_operator(retiree) and no_tier2_operator(retiree);
    then tier3_eligible(retiree, operator);
}
@source(IRC_S9706_A, relation = formalizes, coverage = partial, quote = "(3) Third, if the retiree is not assigned under paragraph (1) or (2), to the signatory operator which employed the coal industry retiree in the coal industry for a longer period of time than any other")
rule S9706AssignTier3 strict {
    for retiree: Person;
    for operator: Person;
    when assignment_requested(retiree, operator) and tier3_eligible(retiree, operator);
    then power S9706AssignTier3Power {
        holder CommissionerOfSocialSecurity;
        over retiree;
        exercise assignment_requested(retiree, operator);
        valid_when tier3_eligible(retiree, operator);
        effect create(assigned_to(retiree, operator));
    };
}

// --- §9706(b) Reassignment upon purchase --------------------------------------

relation successor_of(successor: Person, operator: Person) kind empirical;
relation reassignment_requested(retiree: Person, operator: Person, successor: Person) kind empirical;
relation reassignment_valid(retiree: Person, operator: Person, successor: Person) kind institutional;
@source(IRC_S9706_B, relation = formalizes, coverage = partial, quote = "If a person becomes a successor of an assigned operator after the enactment date, the assigned operator may transfer the assignment of an eligible beneficiary under subsection (a) to such successor, a")
rule S9706ReassignmentValid strict {
    for retiree: Person;
    for operator: Person;
    for successor: Person;
    when successor_of(successor, operator) and assigned_to(retiree, operator);
    then reassignment_valid(retiree, operator, successor);
}
@source(IRC_S9706_B, relation = formalizes, coverage = partial, quote = "If a person becomes a successor of an assigned operator after the enactment date, the assigned operator may transfer the assignment of an eligible beneficiary under subsection (a) to such successor, a")
rule S9706ReassignmentGrant strict {
    for retiree: Person;
    for operator: Person;
    for successor: Person;
    when reassignment_requested(retiree, operator, successor) and reassignment_valid(retiree, operator, successor);
    then power S9706ReassignmentPower {
        holder operator;
        over retiree;
        exercise reassignment_requested(retiree, operator, successor);
        valid_when reassignment_valid(retiree, operator, successor);
        effect create(assigned_to(retiree, successor));
    };
}

// --- §9706(f) Reconsideration by Commissioner: 30-day windows -----------------

relation notice_received_on(operator: Person, retiree: Person, received: Date) kind empirical;
relation info_request_made_on(operator: Person, retiree: Person, requested_on: Date) kind empirical;
relation info_requested_within_30_days(operator: Person, retiree: Person, requested_on: Date, received: Date) kind institutional {
    label en unofficial "the assigned operator requested information within the 30-day window of §9706(f)(1)";
}
@source(IRC_S9706_F, relation = formalizes, coverage = partial, quote = "Any assigned operator receiving a notice under subsection (e)(2) with respect to an eligible beneficiary may, within 30 days of receipt of such notice, request from the Commissioner of Social Security")
rule S9706InfoRequestWindow strict {
    for operator: Person;
    for retiree: Person;
    for requested_on: Date;
    for received: Date;
    when notice_received_on(operator, retiree, received)
        and info_request_made_on(operator, retiree, requested_on)
        and requested_on <= add_calendar_period(received, 30 calendar_day);
    then info_requested_within_30_days(operator, retiree, requested_on, received);
}

relation review_request_made_on(operator: Person, retiree: Person, requested_on: Date) kind empirical;
relation info_received_on(operator: Person, retiree: Person, info_received: Date) kind empirical {
    label en unofficial "the date the assigned operator received the (f)(1) information from the Commissioner, starting the (f)(2) 30-day review-request window";
}
relation review_requested_within_30_days(operator: Person, retiree: Person, requested_on: Date, info_received: Date) kind institutional;
@source(IRC_S9706_F, relation = formalizes, coverage = partial, quote = "An assigned operator may, within 30 days of receipt of the information under paragraph (1), request review of the assignment.")
rule S9706ReviewRequestWindow strict {
    for operator: Person;
    for retiree: Person;
    for requested_on: Date;
    for info_received: Date;
    when review_request_made_on(operator, retiree, requested_on)
        and info_received_on(operator, retiree, info_received)
        and requested_on <= add_calendar_period(info_received, 30 calendar_day);
    then review_requested_within_30_days(operator, retiree, requested_on, info_received);
}

relation review_error_found(operator: Person, retiree: Person) kind empirical;
relation premium_reduced_for_error(operator: Person, retiree: Person) kind institutional;
@source(IRC_S9706_F, relation = formalizes, coverage = partial, quote = "the Commissioner shall notify the assigned operator and the trustees of the Combined Fund and the trustees shall reduce the premiums of the operator under section 9704 by (or if there are no such ")
rule S9706ErrorReducesPremium strict {
    for operator: Person;
    for retiree: Person;
    when review_error_found(operator, retiree);
    then premium_reduced_for_error(operator, retiree);
}

relation pays_premiums_pending_review(operator: Person) kind empirical;
@source(IRC_S9706_F, relation = formalizes, coverage = exact, quote = "An assigned operator shall pay the premiums under section 9704 pending review by the Commissioner of Social Security or by a court under this subsection.")
rule S9706PayPendingReviewDuty defeasible {
    for operator: Person;
    for retiree: Person;
    when assigned_to(retiree, operator);
    then duty S9706PayPendingReview {
        bearer operator;
        beneficiary CommissionerOfSocialSecurity;
        goal maintenance {
            condition pays_premiums_pending_review(operator);
            window [-infinity, infinity];
        }
    };
}

// --- §9706(h) Assignments as of October 1, 2007 -------------------------------

relation not_1988_agreement_operator(p: Person) kind empirical;
relation liability_percentage_fy2007(p: Person) kind institutional;
@source(IRC_S9706_H, relation = formalizes, coverage = partial, quote = "(A) For the fiscal year beginning on October 1, 2007, 55 percent.")
rule S9706LiabilityPercentageFy2007 strict {
    for p: Person;
    when not_1988_agreement_operator(p);
    then liability_percentage_fy2007(p);
}
relation liability_percentage_value(p: Person, fy: Text, pct: Decimal) kind institutional;
@source(IRC_S9706_H, relation = formalizes, coverage = partial, quote = "(A) For the fiscal year beginning on October 1, 2007, 55 percent.")
rule S9706LiabilityPercentageFy2007Value strict { for p: Person; when not_1988_agreement_operator(p); then liability_percentage_value(p, "FY2007", 0.55); }
@source(IRC_S9706_H, relation = formalizes, coverage = partial, quote = "(B) For the fiscal year beginning on October 1, 2008, 40 percent.")
rule S9706LiabilityPercentageFy2008Value strict { for p: Person; when not_1988_agreement_operator(p); then liability_percentage_value(p, "FY2008", 0.40); }
@source(IRC_S9706_H, relation = formalizes, coverage = partial, quote = "(C) For the fiscal year beginning on October 1, 2009, 15 percent.")
rule S9706LiabilityPercentageFy2009Value strict { for p: Person; when not_1988_agreement_operator(p); then liability_percentage_value(p, "FY2009", 0.15); }

// --- §9707 Failure to pay premium -----------------------------------------------

relation premium_due_unpaid(operator: Person, retiree: Person, due: Date) kind empirical {
    label en unofficial "the assigned operator has not paid a §9704 premium/installment with respect to the eligible beneficiary by its due date";
}
relation premium_paid_on(operator: Person, retiree: Person, due: Date, paid_on: Date) kind empirical;
relation noncompliance_days(operator: Person, retiree: Person, due: Date, paid_on: Date, days: Integer) kind institutional {
    label en unofficial "the number of days in the noncompliance period: due date to date of payment (§9707(c))";
}
@source(IRC_S9707_C, relation = formalizes, coverage = exact, quote = "(1) beginning on the due date for such premium or installment, and")
rule S9707NoncompliancePeriod strict {
    for operator: Person;
    for retiree: Person;
    for due: Date;
    for paid_on: Date;
    when premium_paid_on(operator, retiree, due, paid_on);
    then noncompliance_days(operator, retiree, due, paid_on, days_between(due, paid_on));
}

relation penalty_amount(operator: Person, retiree: Person, due: Date, paid_on: Date, amount: Money) kind institutional {
    label en unofficial "the §9707(b) penalty: $100 per day in the noncompliance period";
}
@source(IRC_S9707_B, relation = formalizes, coverage = exact, quote = "The amount of the penalty imposed by subsection (a) on any failure with respect to any eligible beneficiary shall be $100 per day in the noncompliance period with respect to any such failure.")
rule S9707PenaltyAmount defeasible {
    for operator: Person;
    for retiree: Person;
    for due: Date;
    for paid_on: Date;
    for days: Integer;
    when noncompliance_days(operator, retiree, due, paid_on, days);
    then penalty_amount(operator, retiree, due, paid_on, round(100.00 USD * days, 2, "HALF_UP"));
    unless reasonable_cause_and_corrected_within_30_days(operator, retiree, due) and noncompliance_days(operator, retiree, due, paid_on, days);
    unless no_penalty_for_failure_without_knowledge(operator, retiree, due) and noncompliance_days(operator, retiree, due, paid_on, days);
}

relation reasonable_cause(operator: Person, retiree: Person, due: Date) kind empirical {
    label en unofficial "the failure was due to reasonable cause and not willful neglect — DECISION-0194 evaluative channel: external judgment relation naming the Secretary of the Treasury as authority";
}
relation corrected_within_30_days_of_knowledge(operator: Person, retiree: Person, due: Date) kind empirical;
relation reasonable_cause_and_corrected_within_30_days(operator: Person, retiree: Person, due: Date) kind institutional {
    label en unofficial "§9707(d)(2)'s two-step defeater: reasonable cause AND correction within the 30-day knowledge window";
}
@source(IRC_S9707_D, relation = formalizes, coverage = partial, quote = "(A) such failure was due to reasonable cause and not to willful neglect, and")
rule S9707ReasonableCauseDefeater strict {
    for operator: Person;
    for retiree: Person;
    for due: Date;
    when reasonable_cause(operator, retiree, due) and corrected_within_30_days_of_knowledge(operator, retiree, due);
    then reasonable_cause_and_corrected_within_30_days(operator, retiree, due);
}

relation waiver_requested(operator: Person, retiree: Person, due: Date) kind empirical;
@source(IRC_S9707_D, relation = formalizes, coverage = partial, quote = "In the case of a failure that is due to reasonable cause and not to willful neglect, the Secretary of the Treasury may waive all or part of the penalty imposed by subsection (a) for failures to the ex")
rule S9707GrantWaiver strict {
    for operator: Person;
    for retiree: Person;
    for due: Date;
    when waiver_requested(operator, retiree, due) and reasonable_cause(operator, retiree, due);
    then power S9707WaiverPower {
        holder us.irc.core::Secretary;
        over operator;
        exercise waiver_requested(operator, retiree, due);
        valid_when reasonable_cause(operator, retiree, due);
        effect create(penalty_waived(operator, retiree, due));
    };
}
relation penalty_waived(operator: Person, retiree: Person, due: Date) kind institutional;

relation liable_for_penalty(operator: Person, retiree: Person, due: Date) kind institutional;
@source(IRC_S9707_E, relation = formalizes, coverage = exact, quote = "The person failing to meet the requirements of section 9704 shall be liable for the penalty imposed by subsection (a).")
rule S9707LiabilityForPenalty defeasible {
    for operator: Person;
    for retiree: Person;
    for due: Date;
    for paid_on: Date;
    for amount: Money;
    when penalty_amount(operator, retiree, due, paid_on, amount);
    then liable_for_penalty(operator, retiree, due);
}

// --- §9708 Effect on pending claims or obligations ----------------------------

relation liability_determined_exclusively_under_chapter_99(operator: Person, plan_year: Period) kind institutional {
    label en unofficial "liability for contributions to the Combined Fund arising on/after February 1, 1993 is determined exclusively under this chapter (§9708)";
}
relation contribution_liability_arises_on_or_after_feb_1993(operator: Person, plan_year: Period, arises_on: Date) kind empirical;
@source(IRC_S9708, relation = formalizes, coverage = partial, quote = "All liability for contributions to the Combined Fund that arises on and after February 1, 1993, shall be determined exclusively under this chapter, including all liability for contributions to the 195")
rule S9708ExclusivelyUnderChapter strict {
    for operator: Person;
    for plan_year: Period;
    for arises_on: Date;
    when contribution_liability_arises_on_or_after_feb_1993(operator, plan_year, arises_on) and arises_on >= @1993-02-01;
    then liability_determined_exclusively_under_chapter_99(operator, plan_year);
}

// --- §9721 Civil enforcement ---------------------------------------------------

relation obligation_to_pay_under_chapter_99(operator: Person, amount: Money) kind empirical;
relation erisa_4301_enforcement_available(operator: Person, amount: Money) kind institutional {
    label en unofficial "ERISA §4301 civil enforcement (29 U.S.C. §1451) applies to the obligation, as it would to withdrawal liability — the ERISA procedure itself is EXTERNAL_DEPENDENCY, not reproduced";
}
@source(IRC_S9721, relation = formalizes, coverage = partial, quote = "The provisions of section 4301 of the Employee Retirement Income Security Act of 1974 shall apply, in the same manner as any claim arising out of an obligation to pay withdrawal liability under subtit")
rule S9721CivilEnforcement strict {
    for operator: Person;
    for amount: Money;
    when obligation_to_pay_under_chapter_99(operator, amount);
    then erisa_4301_enforcement_available(operator, amount);
}

// --- §9722 Sham transactions ---------------------------------------------------

relation transaction_principal_purpose_evade_liability(t: Text) kind empirical {
    label en unofficial "a principal purpose of the named transaction is to evade or avoid liability under this chapter — DECISION-0194 evaluative fact (adjudicated or conceded, per the pattern used for fraud findings elsewhere in this corpus)";
}
relation transaction_disregarded(t: Text) kind institutional;
@source(IRC_S9722, relation = formalizes, coverage = exact, quote = "If a principal purpose of any transaction is to evade or avoid liability under this chapter, this chapter shall be applied (and such liability shall be imposed) without regard to such transaction.")
rule S9722DisregardShamTransaction strict {
    for t: Text;
    when transaction_principal_purpose_evade_liability(t);
    then power S9722DisregardPower {
        holder us.irc.core::Secretary;
        over t;
        exercise transaction_principal_purpose_evade_liability(t);
        valid_when transaction_principal_purpose_evade_liability(t);
        effect create(transaction_disregarded(t));
    };
}
