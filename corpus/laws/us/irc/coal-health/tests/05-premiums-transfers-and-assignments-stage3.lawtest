// Stage 3 part B: medicare adjustment, inadequate transfers, premium accounts, applicable percentage redetermination, transition rules, prepayment, transfers, aggregation, revocation of assignments and no-knowledge relief (module 05) scenarios. NOT EXECUTED (implemented_unverified): written from the pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

test "S9704B3-01-PLAN-YEAR-AFTER-REDUCTION-PREMIUM-INCREASED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": per_beneficiary_premium(entity_ref("urn:test:s9704b301planyearafterreductionpremiumin#py"), 3000.00 USD) { origin case_input; }
        assert "f1": plan_year_begins_on(entity_ref("urn:test:s9704b301planyearafterreductionpremiumin#py"), @2020-02-01) { origin case_input; }
        assert "f2": medicare_reduction_occurs_in_plan_year_beginning(@2019-02-01) { origin case_input; }
        assert "f3": amount_necessary_to_maintain_health_benefit_level(150.00 USD) { origin case_input; }
    }
    evaluate truth(per_beneficiary_premium_adjusted_for_medicare(entity_ref("urn:test:s9704b301planyearafterreductionpremiumin#py"), 3150.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
