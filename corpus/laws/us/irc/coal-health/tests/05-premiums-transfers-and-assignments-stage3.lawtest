        assert "f0": assignment_made_on(entity_ref("urn:test:s9706h1b03reassignmentuponpurchasenotpro#r"), entity_ref("urn:test:s9706h1b03reassignmentuponpurchasenotpro#op"), @2008-06-01) { origin case_input; }
        assert "f1": reassignment_valid(entity_ref("urn:test:s9706h1b03reassignmentuponpurchasenotpro#r"), entity_ref("urn:test:s9706h1b03reassignmentuponpurchasenotpro#old"), entity_ref("urn:test:s9706h1b03reassignmentuponpurchasenotpro#op")) { origin case_input; }
    }
    evaluate positions();
    expect position(NoFurtherAssignmentsToNon1988AgreementOperators, DEFEATED);
}
