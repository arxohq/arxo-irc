        assert no_tier1_operator(entity_ref("urn:us:irc:coal_health:clir#R2")) { id "f2"; origin case_input; }
    }
    evaluate truth(assigned_to(entity_ref("urn:us:irc:coal_health:clir#R2"), entity_ref("urn:us:irc:coal_health:clir#Op2")));
    expect truth_status == TRUE_ONLY;
}

test "S9706-04-TIER3-VALID-WHEN-NO-TIER1-OR-TIER2" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
