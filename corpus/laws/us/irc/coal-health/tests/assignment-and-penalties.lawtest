// Scenarios for §§9706-9708, 9721-9722 (assignment tiers, failure to pay
// premium, pending claims, civil enforcement, sham transactions). NOT
// executed (NO-HEAVY-CHECKS) — implemented_unverified.

language "law.core" version "0.2";
package us.irc.coal_health version "0.1.1";
namespace "urn:us:irc:coal_health:clir";

test "S9706-01-TIER1-ASSIGNMENT-VALID" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; }
        assert assignment_requested(entity_ref("urn:us:irc:coal_health:clir#R1"), entity_ref("urn:us:irc:coal_health:clir#Op1")) { id "f0"; origin case_input; }
        assert tier1_condition(entity_ref("urn:us:irc:coal_health:clir#R1"), entity_ref("urn:us:irc:coal_health:clir#Op1")) { id "f1"; origin case_input; }
    }
    evaluate truth(assigned_to(entity_ref("urn:us:irc:coal_health:clir#R1"), entity_ref("urn:us:irc:coal_health:clir#Op1")));
    expect truth_status == TRUE_ONLY;
}

