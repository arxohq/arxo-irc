        assert tier3_condition(entity_ref("urn:us:irc:coal_health:clir#R3"), entity_ref("urn:us:irc:coal_health:clir#Op3")) { id "f1"; origin case_input; }
        assert no_tier1_operator(entity_ref("urn:us:irc:coal_health:clir#R3")) { id "f2"; origin case_input; }
        assert no_tier2_operator(entity_ref("urn:us:irc:coal_health:clir#R3")) { id "f3"; origin case_input; }
    }
    evaluate truth(assigned_to(entity_ref("urn:us:irc:coal_health:clir#R3"), entity_ref("urn:us:irc:coal_health:clir#Op3")));
    expect truth_status == TRUE_ONLY;
}

