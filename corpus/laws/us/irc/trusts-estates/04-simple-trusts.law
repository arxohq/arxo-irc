// 26 U.S.C. §651 (deduction for simple trusts) and §652 (inclusion by
// beneficiaries of simple trusts).
//
// JUDGMENT CALLS:
//  - §651(a) requires BOTH conditions ((1) all income required to be
//    distributed currently, (2) no section 642(c) set-aside/use provision)
//    to be a "trust described in section 651"; both are case-asserted
//    classification facts about the governing instrument.
//  - §651(b)'s cap uses `distributable_net_income_for_simple_trust`
//    (section 643(a)(4)'s subpart-B-only DNI, see 03-definitions-and-dni.law)
//    and further excludes tax-exempt income per the cross-reference to
//    section 643(a) generally — modeled as the DNI figure already having
//    tax-exempt interest netted through section 643(a)(5)/(6) (no double
//    subtraction needed: DNI's own construction already nets it).
//  - §652(c) (different taxable years) computes the beneficiary's inclusion
//    year directly from the trust's year-end falling within the
//    beneficiary's year.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    IRC_S651_A,
    IRC_S651_B,
    IRC_S652_A,
    IRC_S652_B,
    IRC_S652_C,
    IncomeCharacterClass,
    Person,
    TaxableYear,
    Trust,
    distributable_net_income_for_simple_trust,
    trust_income_by_character,
};

// ============================================================================
// §651(a): the trust is a "simple trust" and the deduction is allowed
// ============================================================================

pub relation trust_terms_require_all_income_distributed_currently(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the terms of the trust provide that all of its income is required to be distributed currently for the year (case-asserted; section 651(a)(1))";
}
pub relation trust_terms_provide_no_642c_set_aside_or_use(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the terms of the trust do NOT provide that any amounts are to be paid, permanently set aside, or used for a section 642(c) purpose (case-asserted; section 651(a)(2))";
}
@source(IRC_S651_A, relation = formalizes, coverage = exact, quote = "In the case of any trust the terms of which—")
pub relation is_section_651_simple_trust(t: Trust, y: TaxableYear) kind institutional {
    label en official "a trust is described in section 651 for the year when its terms require all of its income to be distributed currently and do not provide for any section 642(c) charitable set-aside or use (section 651(a)(1)-(2))";
}
rule S651IsSimpleTrust(t: Trust, y: TaxableYear) defeasible {
    when trust_terms_require_all_income_distributed_currently(t, y);
    when trust_terms_provide_no_642c_set_aside_or_use(t, y);
    then is_section_651_simple_trust(t, y);
}

pub relation income_required_to_be_distributed_currently(t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of income for the taxable year which is required to be distributed currently, for a section 651 trust (case-asserted; section 651(a) flush language)";
}
@source(IRC_S651_A, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction in computing the taxable income of the trust the amount of the income for the taxable year which is required to be distributed currently")
pub relation section_651_distribution_deduction(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "a section 651 trust is allowed a deduction in computing its taxable income equal to the amount of income required to be distributed currently for the year, limited to distributable net income (section 651(a)-(b))";
}
rule S651DeductionWithinDni(t: Trust, y: TaxableYear, required: Money, dni: Money) defeasible {
    when is_section_651_simple_trust(t, y);
    when income_required_to_be_distributed_currently(t, y, required);
    when distributable_net_income_for_simple_trust(t, y, dni);
    when required <= dni;
    then section_651_distribution_deduction(t, y, required);
}
@source(IRC_S651_B, relation = formalizes, coverage = exact, quote = "If the amount of income required to be distributed currently exceeds the distributable net income of the trust for the taxable year, the deduction shall be limited to the amount of the distributable net income.")
rule S651DeductionCappedAtDni(t: Trust, y: TaxableYear, required: Money, dni: Money) defeasible {
    label en official "if income required to be distributed currently exceeds distributable net income, the section 651 deduction is limited to distributable net income (section 651(b))";
    when is_section_651_simple_trust(t, y);
    when income_required_to_be_distributed_currently(t, y, required);
    when distributable_net_income_for_simple_trust(t, y, dni);
    when required > dni;
    then section_651_distribution_deduction(t, y, dni);
}

// ============================================================================
// §652(a)-(c): inclusion by the beneficiary of a simple trust
// ============================================================================

pub relation beneficiary_share_of_income_required_currently(b: Person, t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the beneficiary's share of the section 651 income required to be distributed currently for the year (case-asserted per beneficiary; section 652(a))";
}
@source(IRC_S652_A, relation = formalizes, coverage = exact, quote = "Subject to subsection (b), the amount of income for the taxable year required to be distributed currently by a trust described in section 651 shall be")
pub relation section_652_beneficiary_inclusion(b: Person, t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "a beneficiary of a section 651 trust includes in gross income the amount of income for the year required to be distributed currently, whether or not actually distributed, subject to the section 652(a) sentence-2 DNI proration when required distributions to all beneficiaries exceed DNI (section 652(a))";
}
rule S652BeneficiaryInclusionWithinDni(b: Person, t: Trust, y: TaxableYear, share: Money, dni: Money, total_required: Money) defeasible {
    when beneficiary_share_of_income_required_currently(b, t, y, share);
    when distributable_net_income_for_simple_trust(t, y, dni);
    when total_income_required_currently_all_beneficiaries(t, y, total_required);
    when total_required <= dni;
    then section_652_beneficiary_inclusion(b, t, y, share);
}
pub relation total_income_required_currently_all_beneficiaries(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "intermediate value: the sum, over all beneficiaries, of the section 652(a) income required to be distributed currently (used for the DNI-proration test)";
}
rule S652TotalIncomeRequiredCurrently(t: Trust, y: TaxableYear) defeasible {
    when is_section_651_simple_trust(t, y);
    then total_income_required_currently_all_beneficiaries(t, y,
        sum all a: Money for b: Person where beneficiary_share_of_income_required_currently(b, t, y, a));
}
@source(IRC_S652_A, relation = formalizes, coverage = exact, quote = "there shall be included in the gross income of each beneficiary an amount which bears the same ratio to distributable net income as the amount of income required to be distributed to such beneficiary bears to the amount of income required to be distributed to all beneficiaries")
rule S652BeneficiaryInclusionProratedOverDni(b: Person, t: Trust, y: TaxableYear, share: Money, dni: Money, total_required: Money) defeasible {
    label en official "when the total income required to be distributed currently to all beneficiaries exceeds distributable net income, each beneficiary's inclusion is prorated: DNI times (that beneficiary's currently-distributable share divided by the total currently distributable to all beneficiaries) (section 652(a), sentence 2)";
    when beneficiary_share_of_income_required_currently(b, t, y, share);
    when distributable_net_income_for_simple_trust(t, y, dni);
    when total_income_required_currently_all_beneficiaries(t, y, total_required);
    when total_required > dni;
    when total_required > 0 USD;
    then section_652_beneficiary_inclusion(b, t, y, dni * (share / total_required));
}

@source(IRC_S652_B, relation = formalizes, coverage = exact, quote = "The amounts specified in subsection (a) shall have the same character in the hands of the beneficiary as in the hands of the trust.")
pub relation beneficiary_inclusion_same_character_652(b: Person, t: Trust, y: TaxableYear, cls: IncomeCharacterClass, amount: Money) kind institutional {
    label en official "the section 652(a) amounts have the same character in the hands of the beneficiary as in the hands of the trust (section 652(b))";
}
rule S652SameCharacter(b: Person, t: Trust, y: TaxableYear, cls: IncomeCharacterClass, trust_amount: Money, inclusion: Money, trust_total: Money) defeasible {
    when trust_income_by_character(t, y, cls, trust_amount);
    when section_652_beneficiary_inclusion(b, t, y, inclusion);
    when trust_gross_income_total(t, y, trust_total);
    when trust_total > 0 USD;
    then beneficiary_inclusion_same_character_652(b, t, y, cls, inclusion * (trust_amount / trust_total));
}
pub relation trust_gross_income_total(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "intermediate value: the trust's total gross income for the year, summed over character classes (the base for the section 652(b)/662(b) proportionate-character allocation)";
}
rule S652TrustGrossIncomeTotal(t: Trust, y: TaxableYear) defeasible {
    when is_section_651_simple_trust(t, y);
    then trust_gross_income_total(t, y,
        sum all a: Money for cls: IncomeCharacterClass where trust_income_by_character(t, y, cls, a));
}

pub relation beneficiary_taxable_year(b: Person, y: TaxableYear) kind empirical {
    label en unofficial "the beneficiary's own taxable year (case-asserted year identity)";
}
pub relation trust_year_ends_within_beneficiary_year(t: Trust, trust_y: TaxableYear, b: Person, ben_y: TaxableYear) kind empirical {
    label en unofficial "the trust's taxable year trust_y ends within the beneficiary's taxable year ben_y (case-asserted date fact; section 652(c))";
}
@source(IRC_S652_C, relation = formalizes, coverage = exact, quote = "If the taxable year of a beneficiary is different from that of the trust, the amount which the beneficiary is required to include in gross income in accordance with the provisions of this section shall be based upon the amount of income of the trust for any taxable year or years of the trust ending within or with his taxable year.")
pub relation beneficiary_inclusion_year_652(b: Person, t: Trust, ben_y: TaxableYear) kind institutional {
    label en official "when the beneficiary's taxable year differs from the trust's, the beneficiary's section 652 inclusion is based on the trust's taxable year or years ending within or with the beneficiary's taxable year (section 652(c))";
}
rule S652DifferentYearInclusion(b: Person, t: Trust, trust_y: TaxableYear, ben_y: TaxableYear) defeasible {
    when trust_year_ends_within_beneficiary_year(t, trust_y, b, ben_y);
    when section_652_beneficiary_inclusion(b, t, trust_y, _);
    then beneficiary_inclusion_year_652(b, t, ben_y);
}
