// Trusts and estates -- WIRE-8 (26.09.2026, DECISION-0379 Д-22 item (б), implemented_unverified).
//
// The lower package `income_individual` (section 56 AMT adjustments) declares a local contract for the section 642(b) deduction
// "claimed in computing the regular tax" and cannot import this package (this package imports `income_individual`; a direct import
// would be an import cycle). The owner therefore DERIVES the lower package's `pub` relation from its own section 642(b) relation
// (qualified rule head, Д-13 item 5). The case-fact channel stays valid: scenarios of `income_individual` never load this package.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    Person,
    TaxableYear,
    section_642b_deduction,
};

rule W8Section642bDeductionClaimedForAmt strict {
    label en official "section 56(b)(1)(D): the section 642(b) deduction claimed for the regular tax is the deduction allowed to the estate or trust under section 642(b)";
    for et: Person;
    for y: TaxableYear;
    for amount: Money;
    when section_642b_deduction(et, y, amount);
    then us.irc.income_individual::section_642b_deduction_claimed(et, y, amount);
}
