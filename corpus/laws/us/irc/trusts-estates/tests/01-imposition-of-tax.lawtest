// Scenarios for 26 U.S.C. §641 (imposition of tax; ESBT), module
// 01-imposition-of-tax.law. Written from the text; NOT executed in this
// stage — `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S641-01-ESTATE-TAXABLE-INCOME-SUBJECT-TO-1E" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert us.irc.income_individual::taxable_income(entity_ref("urn:us:irc:trusts_estates:clir#E1"), entity_ref("urn:us:irc:trusts_estates:clir#Y2026"), 50000 USD) { id "f0"; origin case_input; }
        assert us.irc.income_individual::filing_status(entity_ref("urn:us:irc:trusts_estates:clir#E1"), entity_ref("urn:us:irc:trusts_estates:clir#Y2026"), us.irc.income_individual::EstateOrTrust) { id "f1"; origin case_input; }
    }
    evaluate truth(section_1e_tax_applies(entity_ref("urn:us:irc:trusts_estates:clir#E1"), entity_ref("urn:us:irc:trusts_estates:clir#Y2026")));
    expect truth_status == TRUE_ONLY;
}

