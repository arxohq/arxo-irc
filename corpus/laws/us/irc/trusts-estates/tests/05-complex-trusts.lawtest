// Scenarios for 26 U.S.C. §661-663, module 05-complex-trusts.law.
// implemented_unverified (NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S661-01-DEDUCTION-WITHIN-DNI-ESTATE" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f0"; origin case_input; }
        assert tier1_amount_required_currently(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 5000 USD) { id "f1"; origin case_input; }
        assert tier2_amount_other_properly_paid(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 3000 USD) { id "f2"; origin case_input; }
        assert distributable_net_income(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_661_distribution_deduction(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S662-01-TIER1-WITHIN-DNI" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#E2"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f0"; origin case_input; }
        assert distributable_net_income(entity_ref("urn:...#E2"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f1"; origin case_input; }
        assert beneficiary_tier1_share(entity_ref("urn:...#B1"), entity_ref("urn:...#E2"), entity_ref("urn:...#Y2026"), 6000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(section_662a1_beneficiary_inclusion(entity_ref("urn:...#B1"), entity_ref("urn:...#E2"), entity_ref("urn:...#Y2026"), 6000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S662-02-TIER1-PRORATED-OVER-DNI" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#E3"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f0"; origin case_input; }
        assert distributable_net_income(entity_ref("urn:...#E3"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f1"; origin case_input; }
        assert beneficiary_tier1_share(entity_ref("urn:...#B2"), entity_ref("urn:...#E3"), entity_ref("urn:...#Y2026"), 15000 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(section_662a1_beneficiary_inclusion(entity_ref("urn:...#B2"), entity_ref("urn:...#E3"), entity_ref("urn:...#Y2026"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S663a1-01-SPECIFIC-BEQUEST-EXCLUDED" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert specific_bequest_paid_or_credited(entity_ref("urn:...#E4"), entity_ref("urn:...#B3"), entity_ref("urn:...#Y2026"), 25000 USD) { id "f0"; origin case_input; }
        assert specific_bequest_installment_count_within_limit(entity_ref("urn:...#E4"), entity_ref("urn:...#B3"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
    }
    evaluate truth(section_663a1_specific_bequest_excluded(entity_ref("urn:...#E4"), entity_ref("urn:...#B3"), entity_ref("urn:...#Y2026"), 25000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S663b-01-65-DAY-ELECTION-DAY-65-VALID" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert amount_paid_or_credited_within_65_days(entity_ref("urn:...#T5"), entity_ref("urn:...#Y2026"), 4000 USD, @2026-03-07, @2026-01-01) { id "f0"; origin case_input; }
        assert section_663b_election_made(entity_ref("urn:...#T5"), entity_ref("urn:...#Y2026"), entity_ref("urn:...#Elec1")) { id "f1"; origin case_input; }
        assert section_663b_election_timely_and_proper(entity_ref("urn:...#T5"), entity_ref("urn:...#Y2026"), entity_ref("urn:...#Elec1")) { id "f2"; origin case_input; }
    }
    evaluate positions();
    expect position(S663bElectionPower, ACTIVE);
}

test "S663b-02-DAY-66-OUTSIDE-WINDOW-NO-POWER" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert amount_paid_or_credited_within_65_days(entity_ref("urn:...#T6"), entity_ref("urn:...#Y2026"), 4000 USD, @2026-03-08, @2026-01-01) { id "f0"; origin case_input; }
        assert section_663b_election_made(entity_ref("urn:...#T6"), entity_ref("urn:...#Y2026"), entity_ref("urn:...#Elec2")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect not position(S663bElectionPower, ACTIVE);
}
