// Section 642(b)(2)(C)(ii) SSA reader (IRC-G/G6, 27.09.2026).
// Вывод / нет факта источника: with both case-selected SSA content facts
// the requirements-met consequent derives (TRUE_ONLY); without them
// nothing derives (NEITHER). Expectations come from the statutory text.
// Honest boundary (see the SSA-reader block in 02-special-rules-642.law):
// the 1917 leg reads the pinned 42 USC 1396p text; the Commissioner /
// 1614(a)(3) test is a case fact. NOT EXECUTED (implemented_unverified;
// execution is step 6, owner gate).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S642-SSA-01-REQUIREMENTS-MET" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
        assert trust_is_1917_disability_trust_642b2cii(entity_ref("urn:test:s642ssa:1#t")) { id "f0"; origin case_input; }
        assert commissioner_determined_beneficiaries_disabled_642b2cii(entity_ref("urn:test:s642ssa:1#t"), entity_ref("urn:test:s642ssa:1#y")) { id "f1"; origin case_input; }
    }
    evaluate truth(qualified_disability_trust_requirements_met_642b2cii(entity_ref("urn:test:s642ssa:1#t"), entity_ref("urn:test:s642ssa:1#y")));
    expect truth_status == TRUE_ONLY;
}

test "S642-SSA-02-WITHOUT-SSA-FACTS-NEITHER" {
    given {
        context { legal_time @2024-12-31; decision_time @2024-12-31T09:00:00-05:00; knowledge_time @2024-12-31T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(qualified_disability_trust_requirements_met_642b2cii(entity_ref("urn:test:s642ssa:2#t"), entity_ref("urn:test:s642ssa:2#y")));
    expect truth_status == NEITHER;
}
