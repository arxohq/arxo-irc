// Scenarios for 26 U.S.C. §651-652, module 04-simple-trusts.law.
// implemented_unverified (NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S651-01-DEDUCTION-BELOW-DNI" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert trust_terms_require_all_income_distributed_currently(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert trust_terms_provide_no_642c_set_aside_or_use(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
        assert income_required_to_be_distributed_currently(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 8000 USD) { id "f2"; origin case_input; }
        assert distributable_net_income_for_simple_trust(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_651_distribution_deduction(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S651-02-DEDUCTION-CAPPED-AT-DNI-ABOVE" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert trust_terms_require_all_income_distributed_currently(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert trust_terms_provide_no_642c_set_aside_or_use(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
        assert income_required_to_be_distributed_currently(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 12000 USD) { id "f2"; origin case_input; }
        assert distributable_net_income_for_simple_trust(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_651_distribution_deduction(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S652-01-BENEFICIARY-INCLUSION-WITHIN-DNI" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert trust_terms_require_all_income_distributed_currently(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert trust_terms_provide_no_642c_set_aside_or_use(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
        assert beneficiary_share_of_income_required_currently(entity_ref("urn:...#B1"), entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 8000 USD) { id "f2"; origin case_input; }
        assert distributable_net_income_for_simple_trust(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 10000 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(section_652_beneficiary_inclusion(entity_ref("urn:...#B1"), entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S652-02-UNKNOWN-DNI-UNDETERMINED" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert beneficiary_share_of_income_required_currently(entity_ref("urn:...#B2"), entity_ref("urn:...#T4"), entity_ref("urn:...#Y2026"), 8000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(section_652_beneficiary_inclusion(entity_ref("urn:...#B2"), entity_ref("urn:...#T4"), entity_ref("urn:...#Y2026"), 8000 USD));
    expect truth_status == NEITHER;
}
