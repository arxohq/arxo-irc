        assert us_person_transfers_property_to_foreign_trust(entity_ref("urn:us:irc:trusts_estates:clir#Tr91"), entity_ref("urn:us:irc:trusts_estates:clir#T91"), entity_ref("urn:us:irc:trusts_estates:clir#Y")) { id "f0"; origin case_input; }
        assert secretary_treats_trust_as_having_us_beneficiary_679d(entity_ref("urn:us:irc:trusts_estates:clir#T91")) { id "f1"; origin case_input; }
        assert us_person_submitted_information_679d1(entity_ref("urn:us:irc:trusts_estates:clir#Tr91"), entity_ref("urn:us:irc:trusts_estates:clir#T91")) { id "f2"; origin case_input; }
        assert secretary_satisfied_trust_has_no_us_beneficiary_679d2(entity_ref("urn:us:irc:trusts_estates:clir#Tr91"), entity_ref("urn:us:irc:trusts_estates:clir#T91")) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(S679dSecretaryPresumesUsBeneficiary, ACTIVE);
    evaluate truth(trust_treated_as_having_us_beneficiary_by_presumption_679d(entity_ref("urn:us:irc:trusts_estates:clir#T91")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

