// Scenarios for 26 U.S.C. §643-645, module 03-definitions-and-dni.law.
// implemented_unverified (NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S643a-01-DNI-BASE-NO-MODIFICATIONS" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(distributable_net_income(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S643a-02-DNI-WITH-TAX-EXEMPT-INTEREST-ADDBACK" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f0"; origin case_input; }
        assert tax_exempt_interest_net_of_disbursements(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 2000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(distributable_net_income(entity_ref("urn:...#T2"), entity_ref("urn:...#Y2026"), 42000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S643a-03-DNI-WITH-CAPITAL-GAIN-EXCLUSION" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 40000 USD) { id "f0"; origin case_input; }
        assert capital_gain_allocated_to_corpus_not_distributable(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 5000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(distributable_net_income(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 35000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S643e-01-BENEFICIARY-BASIS-DEFAULT" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert distributed_to(entity_ref("urn:...#Prop1"), entity_ref("urn:...#B1")) { id "f0"; origin case_input; }
        assert adjusted_basis_in_hands_of_estate_or_trust_before_distribution(entity_ref("urn:...#Prop1"), @2026-06-01, 10000 USD) { id "f1"; origin case_input; }
        assert gain_or_loss_recognized_on_distribution(entity_ref("urn:...#Prop1"), 0 USD) { id "f2"; origin case_input; }
    }
    evaluate truth(distributed_property_basis_to_beneficiary(entity_ref("urn:...#Prop1"), entity_ref("urn:...#B1"), 10000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S644-01-TRUST-CALENDAR-YEAR-DEFAULT" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert us.irc.core::year_of(entity_ref("urn:...#T4"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
    }
    evaluate truth(trust_taxable_year_is_calendar_year(entity_ref("urn:...#T4"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S645-01-APPLICABLE-DATE-NO-CHAPTER-11-RETURN" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert decedent_death_date(entity_ref("urn:...#D1"), @2026-01-01) { id "f0"; origin case_input; }
    }
    evaluate truth(section_645_applicable_date(entity_ref("urn:...#D1"), @2028-01-01));
    expect truth_status == TRUE_ONLY;
}
