// Scenarios for 26 U.S.C. §664/§665-668, module
// 06-charitable-remainder-and-throwback.law. implemented_unverified.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S664b-01-TIER1-ORDINARY-INCOME-WITHIN-BALANCE" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert crt_annuity_or_unitrust_amount_paid(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 8000 USD) { id "f0"; origin case_input; }
        assert crt_tier_available_balance(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), OrdinaryIncomeTier, 10000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(crt_tier1_ordinary_income_amount(entity_ref("urn:...#T1"), entity_ref("urn:...#Y2026"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S664d-01-CRAT-PAYOUT-5-PERCENT-VALID" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert crt_payout_percentage(entity_ref("urn:...#T2"), 0.05) { id "f0"; origin case_input; }
    }
    evaluate truth(crat_payout_percentage_within_range(entity_ref("urn:...#T2")));
    expect truth_status == TRUE_ONLY;
}

test "S664d-02-PAYOUT-4.9-PERCENT-BELOW-MINIMUM" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert crt_payout_percentage(entity_ref("urn:...#T3"), 0.049) { id "f0"; origin case_input; }
    }
    evaluate truth(crat_payout_percentage_within_range(entity_ref("urn:...#T3")));
    expect truth_status == FALSE_ONLY;
}

test "S664d-03-10-PERCENT-REMAINDER-TEST-SATISFIED" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert crt_remainder_interest_value_under_7520(entity_ref("urn:...#T4"), 15000 USD) { id "f0"; origin case_input; }
        assert crt_initial_net_fmv(entity_ref("urn:...#T4"), 100000 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(crt_10_percent_remainder_test_satisfied(entity_ref("urn:...#T4")));
    expect truth_status == TRUE_ONLY;
}

test "S665c-01-QUALIFIED-TRUST-NO-THROWBACK" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert qualified_trust_665c(entity_ref("urn:...#T5")) { id "f0"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:...#T5"), entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
    }
    evaluate truth(throwback_inapplicable_qualified_trust(entity_ref("urn:...#T5"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
}
