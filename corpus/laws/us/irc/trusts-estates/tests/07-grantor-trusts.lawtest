// Scenarios for 26 U.S.C. §§671-679, module 07-grantor-trusts.law.
// implemented_unverified.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S673-01-REVERSION-OVER-5-PERCENT-GRANTOR-OWNER" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert reversionary_interest_value_percentage(entity_ref("urn:...#G1"), entity_ref("urn:...#T1"), "entire", 0.051) { id "f0"; origin case_input; }
    }
    evaluate truth(reversionary_interest_owner_673(entity_ref("urn:...#G1"), entity_ref("urn:...#T1"), "entire"));
    expect truth_status == TRUE_ONLY;
}

