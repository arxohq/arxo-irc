// Scenarios for 26 U.S.C. §§681-685, 691-692, module
// 08-limitations-and-ird.law. implemented_unverified.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S684-01-GAIN-ON-TRANSFER-TO-FOREIGN-TRUST" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert us_person_transfers_property_to_foreign_estate_or_trust(entity_ref("urn:...#P1"), entity_ref("urn:...#T1"), entity_ref("urn:...#Tx1"), 100000 USD, 60000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(section_684a_gain_recognized(entity_ref("urn:...#P1"), entity_ref("urn:...#T1"), entity_ref("urn:...#Tx1"), 40000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S684-02-NO-GAIN-WHEN-671-OWNER" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert us_person_transfers_property_to_foreign_estate_or_trust(entity_ref("urn:...#P2"), entity_ref("urn:...#T2"), entity_ref("urn:...#Tx2"), 100000 USD, 60000 USD) { id "f0"; origin case_input; }
        assert treated_as_owner_of_portion(entity_ref("urn:...#P2"), entity_ref("urn:...#T2"), "entire") { id "f1"; origin case_input; }
    }
    evaluate truth(section_684a_gain_recognized(entity_ref("urn:...#P2"), entity_ref("urn:...#T2"), entity_ref("urn:...#Tx2"), 40000 USD));
    expect truth_status == FALSE_ONLY;
}

test "S685-01-QUALIFIED-FUNERAL-TRUST-CLASSIFICATION" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert funeral_trust_arises_from_funeral_services_contract(entity_ref("urn:...#T3")) { id "f0"; origin case_input; }
        assert funeral_trust_sole_purpose_hold_invest_pay(entity_ref("urn:...#T3")) { id "f1"; origin case_input; }
        assert funeral_trust_beneficiaries_are_contract_individuals(entity_ref("urn:...#T3")) { id "f2"; origin case_input; }
        assert funeral_trust_contributions_only_by_beneficiaries(entity_ref("urn:...#T3")) { id "f3"; origin case_input; }
        assert funeral_trustee_elects_685(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), entity_ref("urn:...#Elec1")) { id "f4"; origin case_input; }
        assert funeral_trust_would_be_671_owned_by_purchasers(entity_ref("urn:...#T3")) { id "f5"; origin case_input; }
    }
    evaluate truth(qualified_funeral_trust(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026")));
    expect truth_status == TRUE_ONLY;
}

test "S691a-01-IRD-INCLUSION-BY-ESTATE" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert ird_item_not_includible_before_death(entity_ref("urn:...#D1"), "final-paycheck", 8000 USD) { id "f0"; origin case_input; }
        assert ird_recipient(entity_ref("urn:...#D1"), "final-paycheck", entity_ref("urn:...#Estate1"), DecedentsEstateAcquiredFromDecedent) { id "f1"; origin case_input; }
    }
    evaluate truth(income_in_respect_of_decedent_691a(entity_ref("urn:...#D1"), "final-paycheck", entity_ref("urn:...#Estate1"), 8000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S691c-01-ESTATE-TAX-DEDUCTION-RATIO" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert estate_tax_under_2001_or_2101(entity_ref("urn:...#D2"), 200000 USD) { id "f0"; origin case_input; }
        assert estate_tax_computed_excluding_net_value(entity_ref("urn:...#D2"), 150000 USD) { id "f1"; origin case_input; }
        assert ird_items_value_for_estate_tax_purposes(entity_ref("urn:...#D2"), 100000 USD) { id "f2"; origin case_input; }
        assert deductions_from_gross_estate_for_691b_claims(entity_ref("urn:...#D2"), 0 USD) { id "f3"; origin case_input; }
        assert ird_item_value_for_recipients_deduction(entity_ref("urn:...#D2"), "item1", entity_ref("urn:...#Recip1"), 100000 USD) { id "f4"; origin case_input; }
        assert us.irc.core::year_of(entity_ref("urn:...#Recip1"), entity_ref("urn:...#Y2026")) { id "f5"; origin case_input; }
    }
    evaluate truth(irc_691c_deduction(entity_ref("urn:...#Recip1"), entity_ref("urn:...#D2"), entity_ref("urn:...#Y2026"), 50000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S692a-01-COMBAT-ZONE-DEATH-FORGIVENESS-IMMUNITY" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert died_in_active_service_combat_zone_692a(entity_ref("urn:...#D3"), @2026-05-01) { id "f0"; origin case_input; }
        assert tax_year_within_692a_forgiveness_window(entity_ref("urn:...#D3"), @2026-05-01, entity_ref("urn:...#Y2026")) { id "f1"; origin case_input; }
    }
    evaluate positions();
    expect position(Section692aForgiveness, ACTIVE);
}
