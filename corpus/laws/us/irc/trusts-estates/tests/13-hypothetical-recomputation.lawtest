// Stage 4 (26.09.2026): hypothetical recomputation of tax (module 13-hypothetical-recomputation.law): section 641(c)(2)(A), (E)(ii), 646(b)(2), 667(a)(1), 667(b)(1), 667(d)(1)(A), (D), 668(a)(2)-(3). NOT EXECUTED (implemented_unverified). Tax figures use the tables pinned in income-individual (TCJA 2018 amounts).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S667a1-01-PARTIAL-TAX-ON-INCOME-REDUCED-BY-THE-INCLUDED-AMOUNT" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert accumulation_distribution_paid_credited_or_required_to_beneficiary(entity_ref("urn:test:s4t:a1#b"), entity_ref("urn:test:s4t:a1#t"), entity_ref("urn:test:s4t:a1#ad"), entity_ref("urn:test:s4t:a1#y")) { id "f0"; origin case_input; }
        assert amount_includible_under_662a2_if_paid_last_day_of_preceding_year(entity_ref("urn:test:s4t:a1#b"), entity_ref("urn:test:s4t:a1#t"), entity_ref("urn:test:s4t:a1#ad"), 10000.00 USD) { id "f1"; origin case_input; }
        assert beneficiary_taxable_income_for_year(entity_ref("urn:test:s4t:a1#b"), entity_ref("urn:test:s4t:a1#y"), 60000.00 USD) { id "f2"; origin case_input; }
        assert us.irc.income_individual::filing_status(entity_ref("urn:test:s4t:a1#b"), entity_ref("urn:test:s4t:a1#y"), Unmarried) { id "f3"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:test:s4t:a1#y"), @2024-01-01) { id "f4"; origin case_input; }
    }
    // income 60000 - 10000 = 50000; TCJA unmarried: 4453.50 + 22 percent of (50000 - 38700) = 6939.50
    evaluate truth(partial_tax_on_reduced_income_667a1_computed(entity_ref("urn:test:s4t:a1#b"), entity_ref("urn:test:s4t:a1#y"), 6939.50 USD));
    expect truth_status == TRUE_ONLY;
}

test "S667a1-02-REDUCED-INCOME-NOT-BELOW-ZERO" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert accumulation_distribution_paid_credited_or_required_to_beneficiary(entity_ref("urn:test:s4t:a2#b"), entity_ref("urn:test:s4t:a2#t"), entity_ref("urn:test:s4t:a2#ad"), entity_ref("urn:test:s4t:a2#y")) { id "f0"; origin case_input; }
        assert amount_includible_under_662a2_if_paid_last_day_of_preceding_year(entity_ref("urn:test:s4t:a2#b"), entity_ref("urn:test:s4t:a2#t"), entity_ref("urn:test:s4t:a2#ad"), 80000.00 USD) { id "f1"; origin case_input; }
        assert beneficiary_taxable_income_for_year(entity_ref("urn:test:s4t:a2#b"), entity_ref("urn:test:s4t:a2#y"), 60000.00 USD) { id "f2"; origin case_input; }
        assert us.irc.income_individual::filing_status(entity_ref("urn:test:s4t:a2#b"), entity_ref("urn:test:s4t:a2#y"), Unmarried) { id "f3"; origin case_input; }
        assert us.irc.core::begins(entity_ref("urn:test:s4t:a2#y"), @2024-01-01) { id "f4"; origin case_input; }
    }
    // the reduction exceeds the income: the income is zero and the tax is the base tax of the first bracket
    evaluate truth(partial_tax_on_reduced_income_667a1_computed(entity_ref("urn:test:s4t:a2#b"), entity_ref("urn:test:s4t:a2#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

