test "S642h-01-NOL-CARRYOVER-TO-BENEFICIARY-ON-TERMINATION" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert estate_or_trust_terminated(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026")) { id "f0"; origin case_input; }
        assert nol_carryover_at_termination(entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), 15000 USD) { id "f1"; origin case_input; }
        assert beneficiary_succeeds_to_property(entity_ref("urn:...#B1"), entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026")) { id "f2"; origin case_input; }
    }
    evaluate truth(beneficiary_succeeds_to_642h_carryover_or_excess(entity_ref("urn:...#B1"), entity_ref("urn:...#T3"), entity_ref("urn:...#Y2026"), "NetOperatingLossCarryover", 15000 USD));
    expect truth_status == TRUE_ONLY;
}

test "S642bC3I-01-ZERO-EXEMPTION-YEAR-2017-DISABILITY-TRUST-GETS-4150" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert qualified_disability_trust(entity_ref("urn:us:irc:trusts_estates:clir#TD1"), entity_ref("urn:us:irc:trusts_estates:clir#YD1")) { id "f0"; origin case_input; }
        assert section_151d_exemption_amount(entity_ref("urn:us:irc:trusts_estates:clir#YD1"), 0.00 USD) { id "f1"; origin case_input; }
        assert us.irc.core::calendar_year_of(entity_ref("urn:us:irc:trusts_estates:clir#YD1"), 2017) { id "f2"; origin case_input; }
    }
    evaluate truth(trust_personal_exemption_deduction(entity_ref("urn:us:irc:trusts_estates:clir#TD1"), entity_ref("urn:us:irc:trusts_estates:clir#YD1"), 4150.00 USD));
    expect truth_status == TRUE_ONLY;
}

