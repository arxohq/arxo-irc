// Scenarios for 26 U.S.C. §642 (special rules), module
// 02-special-rules-642.law. implemented_unverified (NO-HEAVY-CHECKS).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

test "S642b-01-ESTATE-600-EXEMPTION" {
    given {
        context { decision_time @2027-04-15T09:00:00-04:00; knowledge_time @2027-04-15T09:00:00-04:00; legal_time @2027-04-15; timezone "America/New_York"; }
        assert taxable_income_before_distribution_and_exemption(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 30000 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(estate_personal_exemption_deduction(entity_ref("urn:...#E1"), entity_ref("urn:...#Y2026"), 600 USD));
    expect truth_status == TRUE_ONLY;
}

