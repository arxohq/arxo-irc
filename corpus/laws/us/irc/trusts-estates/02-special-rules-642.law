// 26 U.S.C. §642 — special rules for credits and deductions: (b) the
// personal-exemption-equivalent deduction, (c) the charitable set-aside
// deduction, (g) no double deduction against both income and estate tax,
// (h) unused loss carryovers and excess deductions on termination.
//
// JUDGMENT CALLS:
//  - §642(b)(2)(C) "qualified disability trust" exemption amount is modeled
//    down to its section 151(d)/68(b)(1)(C) cross-reference as a PENDING
//    dependency (us.irc.deductions owns section 151/67); the STATUTORY
//    branching (disability trust vs. not) is executable.
//  - §642(c)(2)-(6) (the pre-1969 grandfather clause and the pooled-income-
//    fund definition) are TECH_GAP/NON_NORMATIVE by clause: (2) is a
//    grandfather test over instrument-execution dates before Oct. 9, 1969 —
//    executable as a date test, modeled directly; (5) the six-part pooled-
//    income-fund definition is modeled as a closed-list classification;
//    (6) the private-foundation carve-out is a cross-reference to section
//    509/4947, EXTERNAL_DEPENDENCY.
//  - §642(h): the "in accordance with regulations prescribed by the
//    Secretary" apportionment among multiple succeeding beneficiaries is
//    EXTERNAL_DEPENDENCY for the apportionment FORMULA; the STATUTORY
//    trigger (termination + carryover/excess-deduction) and the beneficiary
//    inclusion are executable directly, apportioning pro rata by each
//    beneficiary's `is_beneficiary` share is NOT assumed (regulations
//    actually apportion by relative shares of the residuary corpus, a fact
//    this package does not have a shape for) — a case must assert each
//    beneficiary's succeeded-to amount directly.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    Estate,
    IRC_S642_B,
    IRC_S642_C,
    IRC_S642_G,
    IRC_S642_H,
    Person,
    TaxableYear,
    Trust,
    taxable_income_before_distribution_and_exemption,
};

// ============================================================================
// §642(b): deduction in lieu of the personal exemption
// ============================================================================

@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "An estate shall be allowed a deduction of $600.")
pub relation estate_personal_exemption_deduction(e: Estate, y: TaxableYear, amount: Money) kind institutional {
    label en official "an estate is allowed a deduction of $600 in lieu of the personal exemption (section 642(b)(1))";
}
// The guard is the section 641(b) pre-exemption base, not `taxable_income`:
// taxable income is computed AFTER this deduction (03-definitions-and-dni.law,
// S641bFinal*), so guarding on it closed a predicate cycle (Ф1 baseline
// 06.10.2026: NON_EXECUTABLE_UNSTRATIFIED, 1 690 scenarios). The statute grants
// the $600 to an estate without any income condition; the pre-exemption base
// only marks that the estate computes taxable income for the year. The base is
// produced by defeasible rules (01-imposition-of-tax.law), so the estate branch
// is defeasible like the trust branches (a strict reader would be LDC-E4103).
rule S642bEstateExemption(e: Estate, y: TaxableYear) defeasible {
    when taxable_income_before_distribution_and_exemption(e, y, _);
    then estate_personal_exemption_deduction(e, y, 600 USD);
}

pub relation qualified_disability_trust(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the trust is a qualified disability trust under section 642(b)(2)(C)(ii) for the year (case-asserted: a section-1917-Social-Security-Act disability trust whose beneficiaries the Commissioner of Social Security determines to have been disabled) — the underlying Social Security Act test is EXTERNAL_DEPENDENCY";
}
// SSA reader (IRC-G/G6, 2026-09-27): section 642(b)(2)(C)(ii) qualified
// disability trust (rows 26/642/b/2/c/ii/u1–u4). Pattern G4/CFR: the SSA
// content enters as case-selected facts; the from-package leg — reading
// pubs of `us.ssa.title42_values` (govinfo bytes pinned in
// corpus/laws/us/ssa-title42-values/sources/) — waits for registry +
// lock --write + flip (step 6, owner gate). Honest boundary: the 1917
// leg (u2) reads the pinned 42 USC 1396p text; the Commissioner/
// 1614(a)(3) disability test (u3) is a case fact (42 USC 1382c not
// pinned); the u4 reversion savings holds trivially — the rule requires
// no non-reversion. The existing case-asserted `qualified_disability_trust`
// relation is untouched.
pub relation trust_is_1917_disability_trust_642b2cii(t: Trust) kind empirical {
    label en unofficial "the trust is a disability trust described in section 1917(c)(2)(B)(iv) of the Social Security Act (42 USC 1396p), case-asserted from the pinned text";
}
pub relation commissioner_determined_beneficiaries_disabled_642b2cii(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "all beneficiaries of the trust as of the close of the taxable year were determined by the Commissioner of Social Security to have been disabled (within section 1614(a)(3)) for some portion of the year, case-asserted";
}
pub relation qualified_disability_trust_requirements_met_642b2cii(t: Trust, y: TaxableYear) kind institutional {
    label en official "section 642(b)(2)(C)(ii): the trust meets the qualified disability trust requirements";
}
@source(IRC_S642_B, relation = formalizes, coverage = partial, quote = "(I) such trust is a disability trust described in subsection (c)(2)(B)(iv) of section 1917 of the Social Security Act (42 U.S.C. 1396p), and")
rule S642B2CiiQualifiedDisabilityTrustRequirementsMet(t: Trust, y: TaxableYear) strict {
    label en official "section 642(b)(2)(C)(ii)(I)-(II): the 1917 trust with the Commissioner disability determination meets the requirements";
    when trust_is_1917_disability_trust_642b2cii(t)
        and commissioner_determined_beneficiaries_disabled_642b2cii(t, y);
    then qualified_disability_trust_requirements_met_642b2cii(t, y);
}
pub relation trust_required_to_distribute_all_income_currently(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "under its governing instrument, the trust is required to distribute all of its income currently for the year (the section 651(a)(1) condition, read here for section 642(b)(2)(B))";
}

@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "A trust which, under its governing instrument, is required to distribute all of its income currently shall be allowed a deduction of $300.")
pub relation trust_personal_exemption_deduction(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "a trust required by its governing instrument to distribute all of its income currently is allowed a deduction of $300 (section 642(b)(2)(B))";
}
rule S642bMandatoryIncomeTrustExemption(t: Trust, y: TaxableYear) defeasible {
    when taxable_income_before_distribution_and_exemption(t, y, _);
    when trust_required_to_distribute_all_income_currently(t, y);
    unless qualified_disability_trust(t, y) and trust_required_to_distribute_all_income_currently(t, y);
    then trust_personal_exemption_deduction(t, y, 300 USD);
}

@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this paragraph, a trust shall be allowed a deduction of $100.")
rule S642bOrdinaryTrustExemption(t: Trust, y: TaxableYear) defeasible {
    when taxable_income_before_distribution_and_exemption(t, y, _);
    unless trust_required_to_distribute_all_income_currently(t, y) and taxable_income_before_distribution_and_exemption(t, y, _);
    unless qualified_disability_trust(t, y) and taxable_income_before_distribution_and_exemption(t, y, _);
    then trust_personal_exemption_deduction(t, y, 100 USD);
}

pub relation section_151d_exemption_amount(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the section 151(d) exemption amount for the year, computed as an individual described in section 68(b)(1)(C) and applying section 67(e) — EXTERNAL_DEPENDENCY on us.irc.deductions (sections 67/68/151), asserted here as a case fact rather than recomputed";
}
@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "A qualified disability trust shall be allowed a deduction equal to the exemption amount under section 151(d)")
rule S642bQualifiedDisabilityTrustExemption(t: Trust, y: TaxableYear, amount: Money) defeasible {
    when qualified_disability_trust(t, y);
    when section_151d_exemption_amount(y, amount);
    when amount > 0 USD;
    then trust_personal_exemption_deduction(t, y, amount);
}

// §642(b)(2)(C)(iii): years in which the section 151(d) exemption amount is zero.
// (I) substitutes $4,150; (II) increases it "in the same manner as provided in
// section 6334(d)(4)(C)" for taxable years beginning in a calendar year after
// 2018. The published increased amounts are an IRB value (Rev. Proc.) not pinned
// for this row: a post-2018 zero-exemption year without the asserted adjusted
// amount is NEITHER, never the unadjusted $4,150 (SOURCE_GAP, TECH-GAPS G42xx).
pub relation disability_trust_zero_exemption_year(y: TaxableYear) kind institutional {
    label en official "a taxable year in which the exemption amount under section 151(d) is zero (section 642(b)(2)(C)(iii)(I))";
}
@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "In the case of any taxable year in which the exemption amount under section 151(d) is zero")
rule S642bC3IZeroExemptionYear(y: TaxableYear) defeasible {
    when section_151d_exemption_amount(y, 0 USD);
    then disability_trust_zero_exemption_year(y);
}
@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "clause (i) shall be applied by substituting \"$4,150\" for \"the exemption amount under section 151(d)\"")
rule S642bC3IQualifiedDisabilityTrustFourThousandOneFifty(t: Trust, y: TaxableYear, n: Integer) defeasible {
    label en official "in a year in which the section 151(d) exemption amount is zero, a qualified disability trust is allowed $4,150 (section 642(b)(2)(C)(iii)(I)); for years after 2018 the amount is increased under (II)";
    when qualified_disability_trust(t, y);
    when disability_trust_zero_exemption_year(y);
    when us.irc.core::calendar_year_of(y, n);
    when n <= 2018;
    then trust_personal_exemption_deduction(t, y, 4150 USD);
}
pub relation inflation_adjusted_disability_trust_amount_after_2018(y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the $4,150 amount increased in the same manner as section 6334(d)(4)(C) for a taxable year beginning in a calendar year after 2018 (an IRB-published value, case-asserted with its source — SOURCE_GAP: not pinned in this package; section 642(b)(2)(C)(iii)(II))";
}
@source(IRC_S642_B, relation = formalizes, coverage = partial, quote = "In the case of any taxable year beginning in a calendar year after 2018, the $4,150 amount in subparagraph (A) shall be increased in the same manner as provided in section 6334(d)(4)(C).")
rule S642bC3IIInflationAdjusted(t: Trust, y: TaxableYear, n: Integer, amount: Money) defeasible {
    label en official "for a taxable year beginning in a calendar year after 2018 the substituted $4,150 is the asserted inflation-adjusted amount (section 642(b)(2)(C)(iii)(II))";
    when qualified_disability_trust(t, y);
    when disability_trust_zero_exemption_year(y);
    when us.irc.core::calendar_year_of(y, n);
    when n > 2018;
    when inflation_adjusted_disability_trust_amount_after_2018(y, amount);
    then trust_personal_exemption_deduction(t, y, amount);
}

@source(IRC_S642_B, relation = formalizes, coverage = exact, quote = "The deductions allowed by this subsection shall be in lieu of the deductions allowed under section 151")
pub relation section_642b_in_lieu_of_151(et: Person, y: TaxableYear) kind institutional {
    label en official "the section 642(b) deduction is allowed IN LIEU OF the section 151 personal-exemption deduction (section 642(b)(3))";
}
rule S642bInLieuOf151Estate(e: Estate, y: TaxableYear) defeasible {
    when estate_personal_exemption_deduction(e, y, _);
    then section_642b_in_lieu_of_151(e, y);
}
rule S642bInLieuOf151Trust(t: Trust, y: TaxableYear) defeasible {
    when trust_personal_exemption_deduction(t, y, _);
    then section_642b_in_lieu_of_151(t, y);
}

// This package's single pub name for whichever section 642(b) amount
// applies, feeding the section 641(b) taxable-income assembly.
pub relation section_642b_deduction(et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the section 642(b) personal-exemption-equivalent deduction allowed to the estate or trust for the year (alias combining the estate/trust branches)";
}
rule S642bDeductionAliasEstate(e: Estate, y: TaxableYear, amount: Money) defeasible {
    when estate_personal_exemption_deduction(e, y, amount);
    then section_642b_deduction(e, y, amount);
}
rule S642bDeductionAliasTrust(t: Trust, y: TaxableYear, amount: Money) defeasible {
    when trust_personal_exemption_deduction(t, y, amount);
    then section_642b_deduction(t, y, amount);
}

// ============================================================================
// §642(c): deduction for amounts paid or permanently set aside for charity
// ============================================================================

pub relation gross_income_paid_for_charitable_purpose(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount of the estate's or trust's gross income paid for a section 170(c) charitable purpose pursuant to the governing instrument, for the year (case-asserted; section 642(c)(1))";
}
pub relation gross_income_permanently_set_aside_for_charitable_purpose(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "an amount of gross income permanently set aside for a section 170(c) charitable purpose, for an estate or a governing-instrument-required trust (case-asserted; section 642(c)(2))";
}
@source(IRC_S642_C, relation = formalizes, coverage = exact, quote = "there shall be allowed as a deduction in computing its taxable income (in lieu of the deduction allowed by section 170(a), relating to deduction for charitable, etc., contributions and gifts) any amount of the gross income")
pub relation charitable_set_aside_deduction(et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "an estate or trust is allowed a deduction (in lieu of section 170(a)) for gross income paid or permanently set aside for a section 170(c) charitable purpose pursuant to the governing instrument (section 642(c)(1)-(2))";
}
rule S642cCharitableSetAsidePaid(et: Person, y: TaxableYear, amount: Money) strict {
    when gross_income_paid_for_charitable_purpose(et, y, amount);
    then charitable_set_aside_deduction(et, y, amount);
}
rule S642cCharitableSetAsideBoth(et: Person, y: TaxableYear, paid: Money, set_aside: Money) strict {
    when gross_income_paid_for_charitable_purpose(et, y, paid);
    when gross_income_permanently_set_aside_for_charitable_purpose(et, y, set_aside);
    then charitable_set_aside_deduction(et, y, paid + set_aside);
}

// ============================================================================
// §642(g): no double deduction against income and estate tax
// ============================================================================

pub relation claimed_as_estate_tax_deduction_2053_2054(et: Person, y: TaxableYear, item: Text, amount: Money) kind empirical {
    label en unofficial "an amount is claimed as a section 2053 or 2054 deduction in computing the taxable estate for estate-tax purposes (case-asserted per item; the estate-tax computation itself belongs to us.irc.estate-gift, EXTERNAL_DEPENDENCY)";
}
@source(IRC_S642_G, relation = formalizes, coverage = exact, quote = "Amounts allowable under section 2053 or 2054 as a deduction in computing the taxable estate of a decedent shall not be allowed as a deduction (or as an offset against the sales price of property in determining gain or loss) in computing the taxable income of the estate or of any other person, unless there is filed, within the time and in the manner and form prescribed by the Secretary, a statement that the amounts have not been allowed as deductions under section 2053 or 2054 and a waiver of the right to have such amounts allowed at any time as deductions under section 2053 or 2054.")
pub relation income_tax_deduction_barred_by_642g(et: Person, y: TaxableYear, item: Text, amount: Money) kind institutional {
    label en official "an amount claimed as a section 2053/2054 estate-tax deduction may not also be deducted (or used as an offset against sales price) in computing income tax, unless a timely statement and waiver of the estate-tax deduction is filed (section 642(g))";
}
rule S642gDoubleDeductionBarredAbsentWaiver(et: Person, y: TaxableYear, item: Text, amount: Money) defeasible {
    when claimed_as_estate_tax_deduction_2053_2054(et, y, item, amount);
    unless section_2053_2054_waiver_filed(et, y, item) and claimed_as_estate_tax_deduction_2053_2054(et, y, item, amount);
    then income_tax_deduction_barred_by_642g(et, y, item, amount);
}
pub relation section_2053_2054_waiver_filed(et: Person, y: TaxableYear, item: Text) kind empirical {
    label en unofficial "a timely statement and waiver of the section 2053/2054 estate-tax deduction was filed for the item, in the time/manner/form the Secretary prescribes (case-asserted; the manner-of-filing regulatory conditions are EXTERNAL_DEPENDENCY)";
}

// ============================================================================
// §642(h): unused loss carryovers and excess deductions on termination
// ============================================================================

pub relation estate_or_trust_terminated(et: Person, y: TaxableYear) kind empirical {
    label en unofficial "the estate or trust terminated in the taxable year y (case-asserted)";
}
pub relation nol_carryover_at_termination(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a section 172 net operating loss carryover the estate or trust has as of its last taxable year (case-asserted; section 642(h)(1))";
}
pub relation capital_loss_carryover_at_termination(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "a section 1212 capital loss carryover the estate or trust has as of its last taxable year (case-asserted; section 642(h)(1))";
}
pub relation excess_deductions_at_termination(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess, if any, of the estate's or trust's last-year deductions (other than section 642(b)/(c)) over its last-year gross income (case-asserted; section 642(h)(2))";
}
pub relation beneficiary_succeeds_to_property(b: Person, et: Person, y: TaxableYear) kind empirical {
    label en unofficial "the beneficiary succeeds to the property of the estate or trust on its termination (case-asserted; section 642(h) chapeau)";
}

@source(IRC_S642_H, relation = formalizes, coverage = exact, quote = "then such carryover or such excess shall be allowed as a deduction, in accordance with regulations prescribed by the Secretary, to the beneficiaries succeeding to the property of the estate or trust")
pub relation beneficiary_succeeds_to_642h_carryover_or_excess(b: Person, et: Person, y: TaxableYear, kind: Text, amount: Money) kind institutional {
    label en official "on termination of an estate or trust, its unused net operating loss carryover, capital loss carryover, or excess of last-year deductions over gross income is allowed as a deduction to the beneficiaries succeeding to its property, in accordance with regulations prescribed by the Secretary (section 642(h))";
}
rule S642hNolCarryoverToBeneficiary(b: Person, et: Person, y: TaxableYear, amount: Money) strict {
    when estate_or_trust_terminated(et, y);
    when nol_carryover_at_termination(et, y, amount);
    when beneficiary_succeeds_to_property(b, et, y);
    then beneficiary_succeeds_to_642h_carryover_or_excess(b, et, y, "NetOperatingLossCarryover", amount);
}
rule S642hCapitalLossCarryoverToBeneficiary(b: Person, et: Person, y: TaxableYear, amount: Money) strict {
    when estate_or_trust_terminated(et, y);
    when capital_loss_carryover_at_termination(et, y, amount);
    when beneficiary_succeeds_to_property(b, et, y);
    then beneficiary_succeeds_to_642h_carryover_or_excess(b, et, y, "CapitalLossCarryover", amount);
}
rule S642hExcessDeductionsToBeneficiary(b: Person, et: Person, y: TaxableYear, amount: Money) strict {
    when estate_or_trust_terminated(et, y);
    when excess_deductions_at_termination(et, y, amount);
    when beneficiary_succeeds_to_property(b, et, y);
    then beneficiary_succeeds_to_642h_carryover_or_excess(b, et, y, "ExcessDeductionsOnTermination", amount);
}
