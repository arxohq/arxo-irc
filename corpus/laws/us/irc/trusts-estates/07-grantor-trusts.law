// 26 U.S.C. §§671-679 — Subpart E, grantor trusts: §671 (consequence of
// owner treatment), §672 (definitions: adverse/nonadverse/related-or-
// subordinate party, spousal attribution, the section 672(f) foreign-
// grantor limitation), §673 (reversionary interests), §674 (power to
// control beneficial enjoyment, with the (b)-(d) exceptions), §675
// (administrative powers), §676 (power to revoke), §677 (income for
// benefit of grantor), §678 (a non-grantor person treated as owner), §679
// (foreign trusts with US beneficiaries).
//
// JUDGMENT CALLS:
//  - §672(a) "adverse party... substantial beneficial interest... adversely
//    affected" is DECISION-0194 EVALUATIVE: modeled as an
//    `external judgment relation` with the Secretary/court as authority (no
//    bright-line percentage in the statute).
//  - §672(c)'s enumerated relatives/employees/controlled-corporation list is
//    a closed-list classification, EXECUTABLE directly; the "presumed
//    subservient" rebuttable presumption (sentence 2) is modeled as a
//    defeasible default, defeated by a case-asserted rebuttal fact.
//  - §673(c)'s valuation ("assuming maximum exercise of discretion in favor
//    of the grantor") is EXTERNAL_DEPENDENCY on the section 7520-style
//    actuarial tables (no us.irc.* owner); the STATUTORY >5% test is
//    executable over a case-asserted value that already reflects this
//    assumption.
//  - §674(b)'s eight excepted powers are modeled as a closed-list
//    classification (EXECUTABLE — each is a distinct case-assertable power
//    description), NOT as re-derivations of trust-instrument text.
//  - §675/§676/§677 are modeled directly; §677(b)'s "power exercisable only
//    with the consent of an adverse party" reuses the section 672(a)
//    evaluative channel.
//  - §678 mirrors §671's structure for a person OTHER than the grantor;
//    §678(e)'s S-corporation cross-reference is NON_NORMATIVE (a pointer to
//    section 1361(d), not itself a Subchapter J rule).
//  - §679's residency/controlled-foreign-corporation/loan-as-distribution
//    tests ((a)(3)-(5), (c)(2)-(6), (d)) are EXTERNAL_DEPENDENCY/TECH_GAP in
//    part (they read section 957, section 7701(b), and regulatory
//    "obligation" tracing this package does not own); the CORE structure —
//    a US person transferring to a foreign trust with a US beneficiary is
//    treated as the owner, subject to the two named exceptions — is
//    executable directly.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    IRC_S671,
    IRC_S672_A,
    IRC_S672_B,
    IRC_S672_C,
    IRC_S672_D,
    IRC_S672_E,
    IRC_S672_F,
    IRC_S673_A,
    IRC_S673_B,
    IRC_S673_D,
    IRC_S674_A,
    IRC_S674_B,
    IRC_S674_C,
    IRC_S674_D,
    IRC_S675,
    IRC_S676_A,
    IRC_S677_A,
    IRC_S677_B,
    IRC_S678_A,
    IRC_S678_D,
    IRC_S679_A,
    IRC_S679_C,
    Person,
    TaxableYear,
    Trust,
    fmv_consideration_exception_applies_679,
    is_grantor_of,
};

// ============================================================================
// §671: consequences of grantor/other-person owner treatment
// ============================================================================

pub relation portion_of_trust(t: Trust, portion: Text) kind empirical {
    label en unofficial "an identified portion of the trust (case-asserted identifier — a whole trust is the degenerate case of a single portion covering everything)";
}
pub relation treated_as_owner_of_portion(owner: Person, t: Trust, portion: Text) kind institutional {
    label en unofficial "owner is treated, under one of sections 673-679, as the owner of the stated portion of trust t (the union of every subpart-E owner-treatment rule's conclusion — each section's own rule below also produces this)";
}
@source(IRC_S671, relation = formalizes, coverage = exact, quote = "Where it is specified in this subpart that the grantor or another person shall be treated as the owner of any portion of a trust, there shall then be included in computing the taxable income and credits of the grantor or the other person those items of income, deductions, and credits against tax of the trust which are attributable to that portion of the trust to the extent that such items would be taken into account under this chapter in computing taxable income or credits against the tax of an individual.")
pub relation owner_includes_trust_items_671(owner: Person, t: Trust, portion: Text) kind institutional {
    label en official "a person treated under this subpart as the owner of a portion of a trust includes, in computing that person's own taxable income and credits, the items of income, deduction, and credit of the trust attributable to that portion, to the extent such items would be taken into account computing an individual's taxable income or credits (section 671, sentence 1)";
}
rule S671OwnerIncludesTrustItems(owner: Person, t: Trust, portion: Text) defeasible {
    when treated_as_owner_of_portion(owner, t, portion);
    then owner_includes_trust_items_671(owner, t, portion);
}

// ============================================================================
// §672(a)-(f): definitions
// ============================================================================

pub relation has_beneficial_interest_in_trust(p: Person, t: Trust) kind empirical {
    label en unofficial "p has a beneficial interest in the trust (case-asserted; section 672(a) chapeau)";
}
external judgment relation interest_substantial_and_adversely_affected(p: Person, t: Trust, power_or_interest: Text) {
    authority Secretary;
    label en official "p's beneficial interest in the trust is SUBSTANTIAL and would be ADVERSELY AFFECTED by the exercise or nonexercise of the stated power the person possesses respecting the trust (section 672(a)) — an open-textured standard committed to adjudication, DECISION-0194 channel";
}
@source(IRC_S672_A, relation = formalizes, coverage = exact, quote = "the term \"adverse party\" means any person having a substantial beneficial interest in the trust which would be adversely affected by the exercise or nonexercise of the power which he possesses respecting the trust")
pub relation adverse_party(p: Person, t: Trust, power_or_interest: Text) kind institutional {
    label en official "an adverse party: any person having a substantial beneficial interest in the trust which would be adversely affected by the exercise or nonexercise of the power the person possesses respecting the trust (section 672(a))";
}
rule S672aAdverseParty(p: Person, t: Trust, power_or_interest: Text) strict {
    when has_beneficial_interest_in_trust(p, t);
    when interest_substantial_and_adversely_affected(p, t, power_or_interest);
    then adverse_party(p, t, power_or_interest);
}

@source(IRC_S672_B, relation = formalizes, coverage = exact, quote = "the term \"nonadverse party\" means any person who is not an adverse party")
pub relation nonadverse_party(p: Person, t: Trust, power_or_interest: Text) kind institutional {
    label en official "a nonadverse party: any person who is not an adverse party with respect to the stated power (section 672(b))";
}
rule S672bNonadverseParty(p: Person, t: Trust, power_or_interest: Text) defeasible {
    when has_beneficial_interest_in_trust(p, t);
    when person_considered_for_trust_power(p, t, power_or_interest);
    unless adverse_party(p, t, power_or_interest) and has_beneficial_interest_in_trust(p, t) and person_considered_for_trust_power(p, t, power_or_interest);
    then nonadverse_party(p, t, power_or_interest);
}
rule S672bNonadversePartyNoInterest(p: Person, t: Trust, power_or_interest: Text) defeasible {
    label en unofficial "a person with no beneficial interest at all is a fortiori not an adverse party, hence nonadverse";
    when person_considered_for_trust_power(p, t, power_or_interest);
    unless has_beneficial_interest_in_trust(p, t) and person_considered_for_trust_power(p, t, power_or_interest);
    then nonadverse_party(p, t, power_or_interest);
}
pub relation person_considered_for_trust_power(p: Person, t: Trust, power_or_interest: Text) kind empirical {
    label en unofficial "p is a person whose adverse/nonadverse status with respect to the stated power over the trust is at issue (case-asserted, binds the classification even absent a beneficial interest)";
}

enum RelatedOrSubordinateCategory {
    GrantorsSpouseLivingWithGrantor;
    GrantorsFatherMotherIssueBrotherSister;
    EmployeeOfGrantor;
    CorporationOrEmployeeInWhichGrantorHoldingsAreSignificant;
    SubordinateEmployeeOfCorporationInWhichGrantorIsExecutive;
}
pub relation related_or_subordinate_category_of(p: Person, t: Trust, category: RelatedOrSubordinateCategory) kind empirical {
    label en unofficial "p falls within the stated section 672(c) enumerated category with respect to the grantor of trust t (case-asserted classification)";
}
@source(IRC_S672_C, relation = formalizes, coverage = exact, quote = "the term \"related or subordinate party\" means any nonadverse party who is—")
pub relation related_or_subordinate_party(p: Person, t: Trust) kind institutional {
    label en official "a related or subordinate party: a nonadverse party who is the grantor's spouse living with the grantor, or falls within one of the other enumerated relationships of section 672(c) (section 672(c))";
}
rule S672cRelatedOrSubordinateParty(p: Person, t: Trust, category: RelatedOrSubordinateCategory, power_or_interest: Text) defeasible {
    when nonadverse_party(p, t, power_or_interest);
    when related_or_subordinate_category_of(p, t, category);
    then related_or_subordinate_party(p, t);
}

pub relation presumed_subservient_rebutted(p: Person, t: Trust) kind empirical {
    label en unofficial "the presumption that the related or subordinate party is subservient to the grantor has been rebutted by a preponderance of the evidence (case-asserted; section 672(c), sentence 2)";
}
@source(IRC_S672_C, relation = formalizes, coverage = exact, quote = "a related or subordinate party shall be presumed to be subservient to the grantor in respect")
pub relation presumed_subservient_to_grantor(p: Person, t: Trust) kind institutional {
    label en official "for purposes of section 672(f) and sections 674 and 675, a related or subordinate party is presumed subservient to the grantor with respect to the exercise or nonexercise of the powers conferred on that party, unless rebutted by a preponderance of the evidence (section 672(c), sentence 2)";
}
rule S672cPresumedSubservient(p: Person, t: Trust) defeasible {
    when related_or_subordinate_party(p, t);
    unless presumed_subservient_rebutted(p, t) and related_or_subordinate_party(p, t);
    then presumed_subservient_to_grantor(p, t);
}

pub relation power_subject_to_precedent_notice_or_lapse(p: Person, t: Trust, power_or_interest: Text) kind empirical {
    label en unofficial "the exercise of the stated power is subject to a precedent giving of notice, or takes effect only on the expiration of a required notice period, or can be terminated by another person's exercise of a power in a fiduciary capacity (case-asserted; section 672(d))";
}
@source(IRC_S672_D, relation = formalizes, coverage = exact, quote = "A person shall be considered to have a power described in this subpart even though the exercise of the power is subject to a precedent giving of notice")
pub relation considered_to_have_power_672d(p: Person, t: Trust, power_or_interest: Text) kind institutional {
    label en official "a person is considered to have a power described in this subpart even though its exercise is conditioned on precedent notice, a notice-expiration delay, or is terminable by a fiduciary power of another (section 672(d))";
}
rule S672dConsideredToHavePower(p: Person, t: Trust, power_or_interest: Text) strict {
    when power_subject_to_precedent_notice_or_lapse(p, t, power_or_interest);
    then considered_to_have_power_672d(p, t, power_or_interest);
}

pub relation spouse_of_grantor_at_creation(spouse: Person, t: Trust) kind empirical {
    label en unofficial "the person was the grantor's spouse at the time of creation of the power or interest (case-asserted; section 672(e)(1)(A))";
}
pub relation spouse_became_grantors_spouse_after_creation(spouse: Person, t: Trust) kind empirical {
    label en unofficial "the person became the grantor's spouse after creation of the power or interest (case-asserted; section 672(e)(1)(B))";
}
pub relation legally_separated_from_grantor(spouse: Person, t: Trust) kind empirical {
    label en unofficial "the individual is legally separated from the grantor under a decree of divorce or separate maintenance (case-asserted; section 672(e)(2) exception)";
}
@source(IRC_S672_E, relation = formalizes, coverage = exact, quote = "a grantor shall be treated as holding any power or interest held by—")
pub relation grantor_treated_as_holding_spouses_power(grantor: Person, t: Trust, power_or_interest: Text) kind institutional {
    label en official "the grantor is treated as holding any power or interest held by an individual who was the grantor's spouse at creation, or who became the grantor's spouse afterward (with respect to periods after becoming spouse), unless legally separated (section 672(e)(1)-(2))";
}
rule S672eSpouseAtCreation(grantor: Person, spouse: Person, t: Trust, power_or_interest: Text) defeasible {
    when spouse_of_grantor_at_creation(spouse, t);
    when is_grantor_of(grantor, t);
    when person_considered_for_trust_power(spouse, t, power_or_interest);
    unless legally_separated_from_grantor(spouse, t) and spouse_of_grantor_at_creation(spouse, t) and is_grantor_of(grantor, t) and person_considered_for_trust_power(spouse, t, power_or_interest);
    then grantor_treated_as_holding_spouses_power(grantor, t, power_or_interest);
}
rule S672eSpouseAfterCreation(grantor: Person, spouse: Person, t: Trust, power_or_interest: Text) defeasible {
    when spouse_became_grantors_spouse_after_creation(spouse, t);
    when is_grantor_of(grantor, t);
    when person_considered_for_trust_power(spouse, t, power_or_interest);
    unless legally_separated_from_grantor(spouse, t) and spouse_became_grantors_spouse_after_creation(spouse, t) and is_grantor_of(grantor, t) and person_considered_for_trust_power(spouse, t, power_or_interest);
    then grantor_treated_as_holding_spouses_power(grantor, t, power_or_interest);
}

pub relation grantor_is_foreign_person_672f(g: Person, t: Trust) kind empirical {
    label en unofficial "the grantor is a foreign person for purposes of section 672(f) (not a United States person) (case-asserted)";
}
@source(IRC_S672_F, relation = formalizes, coverage = exact, quote = "this subpart shall apply only to the extent such application results in an amount (if any) being currently taken into account")
pub relation subpart_e_limited_to_us_taxation_672f(g: Person, t: Trust) kind institutional {
    label en official "when the grantor is a foreign person, subpart E (grantor-trust owner treatment) applies only to the extent it results in an amount being currently taken into account under chapter 1 in computing the income of a United States citizen, resident, or domestic corporation (section 672(f)(1))";
}
rule S672fForeignGrantorLimitation(g: Person, t: Trust) strict {
    when grantor_is_foreign_person_672f(g, t);
    then subpart_e_limited_to_us_taxation_672f(g, t);
}
pub relation grantor_can_revest_solely_and_amounts_only_to_grantor_or_spouse(g: Person, t: Trust) kind empirical {
    label en unofficial "the power to revest trust property in the grantor is exercisable solely by the grantor without another's consent, and the only amounts distributable during the grantor's lifetime are to the grantor or the grantor's spouse (case-asserted; section 672(f)(2)(A))";
}
@source(IRC_S672_F, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to any portion of a trust if—")
pub relation section_672f1_limitation_inapplicable(g: Person, t: Trust) kind institutional {
    label en official "the section 672(f)(1) limitation to US taxation does not apply to a portion of the trust the grantor can revest solely in himself, from which only the grantor or the grantor's spouse may receive distributions during the grantor's lifetime (section 672(f)(2)(A))";
}
rule S672f2aExceptionToLimitation(g: Person, t: Trust) strict {
    when grantor_can_revest_solely_and_amounts_only_to_grantor_or_spouse(g, t);
    then section_672f1_limitation_inapplicable(g, t);
}

// ============================================================================
// §673: reversionary interests
// ============================================================================

pub relation reversionary_interest_value_percentage(g: Person, t: Trust, portion: Text, pct: Decimal) kind empirical {
    label en unofficial "the value of the grantor's reversionary interest in the portion, expressed as a percentage of the value of that portion, determined by assuming the maximum exercise of discretion in favor of the grantor (case-asserted; section 673(a)/(c)) — the section 7520-style actuarial computation itself is EXTERNAL_DEPENDENCY";
}
@source(IRC_S673_A, relation = formalizes, coverage = exact, quote = "The grantor shall be treated as the owner of any portion of a trust in which he has a reversionary interest in either the corpus or the income therefrom")
pub relation reversionary_interest_owner_673(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "the grantor is treated as the owner of any portion of a trust in which the grantor has a reversionary interest in the corpus or income, if, as of the trust's inception, the value of that interest exceeds 5 percent of the value of that portion (section 673(a))";
}
rule S673aOver5PercentReversion(g: Person, t: Trust, portion: Text, pct: Decimal) defeasible {
    when reversionary_interest_value_percentage(g, t, portion, pct);
    when pct > 0.05;
    unless reversion_exception_lineal_descendant_673b(g, t, portion) and reversionary_interest_value_percentage(g, t, portion, pct);
    then reversionary_interest_owner_673(g, t, portion);
    then treated_as_owner_of_portion(g, t, portion);
}

pub relation beneficiary_is_lineal_descendant_of_grantor(b: Person, g: Person) kind empirical {
    label en unofficial "the beneficiary is a lineal descendant of the grantor (case-asserted; section 673(b)(1))";
}
pub relation beneficiary_holds_all_present_interests(b: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "the beneficiary holds all of the present interests in the stated portion of the trust (case-asserted; section 673(b)(2))";
}
@source(IRC_S673_B, relation = formalizes, coverage = exact, quote = "the grantor shall not be treated under subsection (a) as the owner of such portion solely by reason of a reversionary interest in such portion which")
pub relation reversion_exception_lineal_descendant_673b(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "the grantor is not treated as owner solely by reason of a reversionary interest, where the sole beneficiary holding all present interests in the portion is the grantor's lineal descendant and the reversion takes effect only on that descendant's death before age 21 (section 673(b))";
}
rule S673bLinealDescendantException(g: Person, b: Person, t: Trust, portion: Text) strict {
    when beneficiary_is_lineal_descendant_of_grantor(b, g);
    when beneficiary_holds_all_present_interests(b, t, portion);
    then reversion_exception_lineal_descendant_673b(g, t, portion);
}

@source(IRC_S673_D, relation = formalizes, coverage = exact, quote = "Any postponement of the date specified for the reacquisition of possession or enjoyment of the reversionary interest shall be treated as a new transfer")
pub relation postponement_treated_as_new_transfer_673d(g: Person, t: Trust, portion: Text, postponed_on: Date) kind institutional {
    label en official "a postponement of the date for the grantor's reacquisition of the reversionary interest is treated as a new transfer in trust, commencing on the date of postponement, for purposes of applying section 673(a) (section 673(d))";
}
pub relation reversion_date_postponed(g: Person, t: Trust, portion: Text, postponed_on: Date) kind empirical {
    label en unofficial "the date specified for the grantor's reacquisition of possession or enjoyment of the reversionary interest was postponed (case-asserted; section 673(d))";
}
rule S673dPostponementNewTransfer(g: Person, t: Trust, portion: Text, postponed_on: Date) strict {
    when reversion_date_postponed(g, t, portion, postponed_on);
    then postponement_treated_as_new_transfer_673d(g, t, portion, postponed_on);
}

// ============================================================================
// §674: power to control beneficial enjoyment
// ============================================================================

pub relation power_to_control_beneficial_enjoyment(holder: Person, g: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "a power exists, exercisable by the grantor or a nonadverse party or both, without the approval or consent of any adverse party, to dispose of the beneficial enjoyment of the corpus or income of the stated portion (case-asserted; section 674(a))";
}
@source(IRC_S674_A, relation = formalizes, coverage = exact, quote = "The grantor shall be treated as the owner of any portion of a trust in respect of which the beneficial enjoyment of the corpus or the income therefrom")
pub relation section_674a_owner_by_default(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "the grantor is treated as the owner of any portion of a trust over which the beneficial enjoyment of corpus or income is subject to a power of disposition (by the grantor or a nonadverse party, or both) without an adverse party's approval, except as the section 674(b)-(d) exceptions provide (section 674(a))";
}
enum Section674bExceptedPower {
    Section677bPowerNotSubjectToOwnerTax;
    PowerEffectiveOnlyAfterEventBeyondControl;
    PowerExercisableOnlyByWill;
    PowerToDetermineEnjoymentForCharityOr170cPurpose;
    LimitedPowerToDistributeCorpusPerAscertainableStandard;
    PowerToWithholdIncomeDuringDisabilityOrMinorityWithReversionOnTermination;
    PowerExercisableOnlyDuringDisabilityOrMinorityOfBeneficiary;
    PowerToAllocateReceiptsAndDisbursementsBetweenCorpusAndIncome;
}
pub relation power_falls_within_674b_exception(holder: Person, g: Person, t: Trust, portion: Text, exception: Section674bExceptedPower) kind empirical {
    label en unofficial "the power described falls within one of the eight section 674(b) excepted-power categories (case-asserted classification against the statute's own closed list)";
}
@source(IRC_S674_B, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to the following powers regardless of by whom held:")
pub relation section_674a_inapplicable_674b(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "section 674(a) does not apply to a power falling within one of the eight excepted categories of section 674(b), regardless of who holds it (section 674(b))";
}
rule S674bExceptedPower(holder: Person, g: Person, t: Trust, portion: Text, exception: Section674bExceptedPower) strict {
    when power_falls_within_674b_exception(holder, g, t, portion, exception);
    then section_674a_inapplicable_674b(g, t, portion);
}
rule S674aOwnerAbsentException(g: Person, t: Trust, portion: Text, holder: Person) defeasible {
    when power_to_control_beneficial_enjoyment(holder, g, t, portion);
    unless section_674a_inapplicable_674b(g, t, portion) and power_to_control_beneficial_enjoyment(holder, g, t, portion);
    unless section_674a_inapplicable_674c(g, t, portion) and power_to_control_beneficial_enjoyment(holder, g, t, portion);
    unless section_674a_inapplicable_674d(g, t, portion) and power_to_control_beneficial_enjoyment(holder, g, t, portion);
    then section_674a_owner_by_default(g, t, portion);
    then treated_as_owner_of_portion(g, t, portion);
}

pub relation power_held_solely_by_independent_trustees_674c(t: Trust, portion: Text) kind empirical {
    label en unofficial "the power to distribute, apportion, or accumulate income, or pay out corpus, is solely exercisable (without any other person's approval) by a trustee or trustees none of whom is the grantor or a related or subordinate party subservient to the grantor's wishes (case-asserted; section 674(c))";
}
@source(IRC_S674_C, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to a power solely exercisable (without the approval or consent of any other person) by a trustee or trustees, none of w")
pub relation section_674a_inapplicable_674c(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "section 674(a) does not apply to an income/corpus power solely exercisable by independent trustees (none the grantor, none a subservient related-or-subordinate party) (section 674(c))";
}
rule S674cIndependentTrusteeException(g: Person, t: Trust, portion: Text) strict {
    when power_held_solely_by_independent_trustees_674c(t, portion);
    when is_grantor_of(g, t);
    then section_674a_inapplicable_674c(g, t, portion);
}

pub relation power_held_solely_by_trustees_other_than_grantor_or_spouse_674d(t: Trust, portion: Text) kind empirical {
    label en unofficial "the power to distribute, apportion, or accumulate income for a beneficiary, limited by a reasonably definite external standard, is solely exercisable by a trustee or trustees none of whom is the grantor or the grantor's spouse living with the grantor (case-asserted; section 674(d))";
}
@source(IRC_S674_D, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to a power solely exercisable (without the approval or consent of any other person) by a trustee or trustees, none of w")
pub relation section_674a_inapplicable_674d(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "section 674(a) does not apply to a power to distribute, apportion, or accumulate income, limited by a reasonably definite external standard, solely exercisable by trustees other than the grantor or the grantor's spouse (section 674(d))";
}
rule S674dTrusteeOtherThanGrantorException(g: Person, t: Trust, portion: Text) strict {
    when power_held_solely_by_trustees_other_than_grantor_or_spouse_674d(t, portion);
    when is_grantor_of(g, t);
    then section_674a_inapplicable_674d(g, t, portion);
}

// ============================================================================
// §675: administrative powers
// ============================================================================

pub relation power_to_deal_for_less_than_adequate_consideration_675_1(holder: Person, g: Person, t: Trust) kind empirical {
    label en unofficial "a power, exercisable by the grantor or a nonadverse party or both, without any adverse party's approval, enables the grantor or any person to purchase, exchange, or otherwise deal with or dispose of trust corpus or income for less than adequate and full consideration (case-asserted; section 675(1))";
}
pub relation power_to_borrow_without_adequate_interest_or_security_675_2(holder: Person, g: Person, t: Trust) kind empirical {
    label en unofficial "a power, exercisable by the grantor or a nonadverse party or both, enables the grantor to borrow trust corpus or income directly or indirectly without adequate interest or adequate security (case-asserted; section 675(2))";
}
pub relation grantor_borrowed_and_not_repaid_before_year_675_3(g: Person, t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the grantor has directly or indirectly borrowed trust corpus or income and has not completely repaid the loan (including interest) before the beginning of the taxable year (case-asserted; section 675(3))";
}
pub relation power_of_administration_held_nonfiduciary_675_4(t: Trust) kind empirical {
    label en unofficial "a power of administration is exercisable in a nonfiduciary capacity by any person without the approval or consent of any fiduciary (case-asserted; section 675(4))";
}
@source(IRC_S675, relation = formalizes, coverage = exact, quote = "The grantor shall be treated as the owner of any portion of a trust in respect of which—")
pub relation administrative_power_owner_675(g: Person, t: Trust) kind institutional {
    label en official "the grantor is treated as the owner of any portion of a trust over which an administrative power described in section 675(1)-(4) exists — dealing for inadequate consideration, borrowing without adequate interest/security, an unrepaid loan outstanding at year's start, or nonfiduciary administrative control (section 675)";
}
rule S675InadequateConsiderationPower(g: Person, t: Trust, holder: Person) strict {
    when power_to_deal_for_less_than_adequate_consideration_675_1(holder, g, t);
    then administrative_power_owner_675(g, t);
    then treated_as_owner_of_portion(g, t, "entire");
}
rule S675InadequateInterestBorrowingPower(g: Person, t: Trust, holder: Person) strict {
    when power_to_borrow_without_adequate_interest_or_security_675_2(holder, g, t);
    then administrative_power_owner_675(g, t);
    then treated_as_owner_of_portion(g, t, "entire");
}
rule S675UnrepaidLoan(g: Person, t: Trust, y: TaxableYear) strict {
    when grantor_borrowed_and_not_repaid_before_year_675_3(g, t, y);
    then administrative_power_owner_675(g, t);
    then treated_as_owner_of_portion(g, t, "entire");
}
rule S675NonfiduciaryAdministrativePower(g: Person, t: Trust) strict {
    when power_of_administration_held_nonfiduciary_675_4(t);
    when is_grantor_of(g, t);
    then administrative_power_owner_675(g, t);
    then treated_as_owner_of_portion(g, t, "entire");
}

// ============================================================================
// §676: power to revoke
// ============================================================================

pub relation power_to_revest_title_in_grantor(holder: Person, g: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "a power exists, exercisable by the grantor or a nonadverse party or both, without any adverse party's approval, to revest in the grantor title to the stated portion of the trust (case-asserted; section 676(a))";
}
@source(IRC_S676_A, relation = formalizes, coverage = exact, quote = "The grantor shall be treated as the owner of any portion of a trust, whether or not he is treated as such owner under any other provision of this part")
pub relation power_to_revoke_owner_676(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "the grantor is treated as the owner of any portion of a trust over which a power to revest title in the grantor exists (exercisable by the grantor or a nonadverse party, or both, without an adverse party's approval), whether or not the grantor is otherwise treated as owner (section 676(a))";
}
rule S676PowerToRevoke(g: Person, t: Trust, portion: Text, holder: Person) defeasible {
    when power_to_revest_title_in_grantor(holder, g, t, portion);
    unless power_effective_only_after_future_event_676b(g, t, portion) and power_to_revest_title_in_grantor(holder, g, t, portion);
    then power_to_revoke_owner_676(g, t, portion);
    then treated_as_owner_of_portion(g, t, portion);
}
pub relation power_effective_only_after_future_event_676b(g: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "the power to revest can only affect beneficial enjoyment of income for a period commencing after the occurrence of a future event that section 673's reversionary-interest rules would treat as not yet giving rise to a >5% reversion (case-asserted; section 676(b))";
}

// ============================================================================
// §677: income for benefit of grantor
// ============================================================================

pub relation trust_income_without_adverse_party_consent_may_be(g: Person, t: Trust, portion: Text, disposition: Section677Disposition) kind empirical {
    label en unofficial "without the consent of an adverse party, trust income of the stated portion is, or in the discretion of the grantor/nonadverse party/both may be, subject to the stated section 677(a) disposition (case-asserted)";
}
enum Section677Disposition {
    DistributedToGrantorOrSpouse;
    HeldOrAccumulatedForFutureDistributionToGrantorOrSpouse;
    AppliedToPayPremiumsOnGrantorOrSpouseLifeInsurance;
}
@source(IRC_S677_A, relation = formalizes, coverage = exact, quote = "The grantor shall be treated as the owner of any portion of a trust, whether or not he is treated as such owner under section 674, whose income without the approval or consent of any adverse party is, or, in the discretion of the grantor or a nonadverse party, or both, may be—")
pub relation income_for_benefit_of_grantor_677(g: Person, t: Trust, portion: Text) kind institutional {
    label en official "the grantor is treated as the owner of any portion of a trust whose income, without an adverse party's consent, is or may be distributed to, accumulated for, or used to pay life-insurance premiums for the grantor or the grantor's spouse (section 677(a))";
}
rule S677IncomeForGrantorBenefit(g: Person, t: Trust, portion: Text, disposition: Section677Disposition) defeasible {
    when trust_income_without_adverse_party_consent_may_be(g, t, portion, disposition);
    unless power_effective_only_after_future_event_676b(g, t, portion) and trust_income_without_adverse_party_consent_may_be(g, t, portion, disposition);
    then income_for_benefit_of_grantor_677(g, t, portion);
    then treated_as_owner_of_portion(g, t, portion);
}

pub relation income_used_to_discharge_legal_support_obligation(g: Person, t: Trust, b: Person, amount: Money) kind empirical {
    label en unofficial "trust income is applied or distributed for the support or maintenance of a beneficiary whom the grantor is legally obligated to support, but only to the extent so applied or distributed (case-asserted; section 677(b))";
}
@source(IRC_S677_B, relation = formalizes, coverage = exact, quote = "Income of a trust shall not be considered taxable to the grantor under subsection (a) or any other provision of this chapter merely because such income")
pub relation support_use_not_taxable_to_grantor_677b(g: Person, t: Trust, b: Person, amount: Money) kind institutional {
    label en official "trust income used to discharge the grantor's legal support obligation to a beneficiary is not, merely for that reason, taxable to the grantor under section 677(a) or any other provision of this chapter, EXCEPT to the extent so applied or distributed (section 677(b))";
}
rule S677bSupportUseException(g: Person, t: Trust, b: Person, amount: Money) strict {
    when income_used_to_discharge_legal_support_obligation(g, t, b, amount);
    then support_use_not_taxable_to_grantor_677b(g, t, b, amount);
}

// ============================================================================
// §678: person other than grantor treated as owner
// ============================================================================

pub relation person_has_sole_power_to_vest_in_self(p: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "a person other than the grantor has a power exercisable solely by that person to vest the corpus or income of the stated portion in himself (case-asserted; section 678(a)(1))";
}
@source(IRC_S678_A, relation = formalizes, coverage = exact, quote = "A person other than the grantor shall be treated as the owner of any portion of a trust with respect to which:")
pub relation non_grantor_owner_678(p: Person, t: Trust, portion: Text) kind institutional {
    label en official "a person other than the grantor is treated as the owner of any portion of a trust over which that person has a sole power to vest corpus or income in himself, or previously partially released or modified such a power while retaining control that would make a grantor an owner under sections 671-677 (section 678(a))";
}
rule S678SolePowerToVest(p: Person, t: Trust, portion: Text) defeasible {
    when person_has_sole_power_to_vest_in_self(p, t, portion);
    unless section_678b_grantor_taxable_exception(p, t, portion) and person_has_sole_power_to_vest_in_self(p, t, portion);
    then non_grantor_owner_678(p, t, portion);
    then treated_as_owner_of_portion(p, t, portion);
}
pub relation section_678b_grantor_taxable_exception(p: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "the grantor of the trust, or a transferor to whom section 679 applies, is otherwise taxable under subpart E on the power over income the person holds — the section 678(b) exception (case-asserted)";
}
pub relation power_renounced_or_disclaimed_within_reasonable_time_678d(p: Person, t: Trust, portion: Text) kind empirical {
    label en unofficial "the person renounced or disclaimed the power within a reasonable time after first becoming aware of its existence (case-asserted; section 678(d))";
}
@source(IRC_S678_D, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply with respect to a power which has been renounced or disclaimed within a reasonable time after")
pub relation section_678a_inapplicable_renounced_678d(p: Person, t: Trust, portion: Text) kind institutional {
    label en official "section 678(a) does not apply to a power renounced or disclaimed within a reasonable time after the holder first became aware of its existence (section 678(d))";
}
rule S678dRenouncedException(p: Person, t: Trust, portion: Text) strict {
    when power_renounced_or_disclaimed_within_reasonable_time_678d(p, t, portion);
    then section_678a_inapplicable_renounced_678d(p, t, portion);
}

// ============================================================================
// §679: foreign trusts having a United States beneficiary
// ============================================================================

pub relation us_person_transfers_property_to_foreign_trust(transferor: Person, t: Trust, transfer_year: TaxableYear) kind empirical {
    label en unofficial "a United States person directly or indirectly transfers property to a foreign trust (case-asserted; section 679(a)(1))";
}
pub relation transfer_by_reason_of_death_679a2a(transferor: Person, t: Trust) kind empirical {
    label en unofficial "the transfer is by reason of the death of the transferor (case-asserted exception; section 679(a)(2)(A))";
}
pub relation transfer_for_fmv_consideration_679a2b(transferor: Person, t: Trust) kind empirical {
    label en unofficial "the transfer is for consideration of at least the fair market value of the transferred property (case-asserted exception; section 679(a)(2)(B))";
}
@source(IRC_S679_A, relation = formalizes, coverage = exact, quote = "A United States person who directly or indirectly transfers property to a foreign trust")
pub relation us_transferor_treated_as_owner_679(transferor: Person, t: Trust) kind institutional {
    label en official "a United States person who directly or indirectly transfers property to a foreign trust is treated as the owner of the portion of the trust attributable to the transferred property, if for the taxable year the trust has a United States beneficiary, except for a transfer by reason of death or for full fair-market-value consideration (section 679(a)(1)-(2))";
}
rule S679UsTransferorOwner(transferor: Person, t: Trust, transfer_year: TaxableYear) defeasible {
    when us_person_transfers_property_to_foreign_trust(transferor, t, transfer_year);
    when trust_has_us_beneficiary_679c(t, transfer_year);
    unless transfer_by_reason_of_death_679a2a(transferor, t) and us_person_transfers_property_to_foreign_trust(transferor, t, transfer_year);
    unless fmv_consideration_exception_applies_679(transferor, t) and us_person_transfers_property_to_foreign_trust(transferor, t, transfer_year);
    then us_transferor_treated_as_owner_679(transferor, t);
    then treated_as_owner_of_portion(transferor, t, "attributable-to-transfer");
}

pub relation trust_terms_bar_all_payment_to_us_persons(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "under the trust's terms, no income or corpus may be paid or accumulated during the year to or for the benefit of a United States person (case-asserted; section 679(c)(1)(A))";
}
pub relation trust_would_bar_payment_to_us_persons_if_terminated(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "if the trust were terminated at any time during the year, no income or corpus could be paid to or for the benefit of a United States person (case-asserted; section 679(c)(1)(B))";
}
@source(IRC_S679_C, relation = formalizes, coverage = exact, quote = "a trust shall be treated as having a United States beneficiary for the taxable year unless—")
pub relation trust_has_us_beneficiary_679c(t: Trust, y: TaxableYear) kind institutional {
    label en official "a trust is treated as having a United States beneficiary for the year UNLESS both the trust's terms bar payment to US persons during the year and would bar it on termination during the year (section 679(c)(1))";
}
rule S679cHasUsBeneficiaryDefault(t: Trust, y: TaxableYear) defeasible {
    when us_person_transfers_property_to_foreign_trust(_, t, y);
    unless trust_terms_bar_all_payment_to_us_persons(t, y) and trust_would_bar_payment_to_us_persons_if_terminated(t, y) and us_person_transfers_property_to_foreign_trust(_, t, y);
    then trust_has_us_beneficiary_679c(t, y);
}
