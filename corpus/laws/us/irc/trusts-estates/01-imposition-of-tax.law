// 26 U.S.C. §641 — imposition of the section 1(e) tax on estates and trusts,
// and the electing-small-business-trust (ESBT) special rules of §641(c).
//
// JUDGMENT CALLS:
//  - §641(a)(1)-(4) are read as ILLUSTRATIVE of what "taxable income of
//    estates or trusts" includes ("including—" introduces the list), not as
//    four independently operative rules: the CURRENT operative allocation
//    between the entity and its beneficiaries is entirely the DNI/
//    distribution-deduction machinery of §§642(b), 651-663, which this
//    package formalizes directly. §641(a)(1)-(4) are therefore
//    NON_NORMATIVE (superseded in operative effect by the later subparts,
//    though never repealed text) — see coverage row note.
//  - §641(b): "computed in the same manner as in the case of an individual,
//    except as otherwise provided" is modeled as gross income (imported
//    from us.irc.gross_income) reduced by (i) deductions this package does
//    not own (case-asserted aggregate `other_allowable_deductions`), (ii)
//    the section 642(c) charitable set-aside, (iii) the section 651/661
//    distribution deduction, and (iv) the section 642(b) personal-exemption
//    deduction — the final assembly rule lives in
//    03-definitions-and-dni.law once the distribution deduction exists.
//  - §641(c) ESBT: the separate-trust classification, item list, no-double-
//    benefit and no-642(c) rules are executable directly from the text; the
//    ACTUAL highest-marginal-rate figure section 641(c)(2)(A) cross-
//    references (section 1(e)'s top rate) is not exposed by
//    `us.irc.income_individual` as a bare rate constant — recorded
//    EXTERNAL_DEPENDENCY/pending in coverage/trusts-estates.deps.json rather
//    than hardcoded.

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    Estate,
    IRC_S641_A,
    IRC_S641_B,
    IRC_S641_C,
    Person,
    TaxableYear,
    Trust,
    charitable_set_aside_deduction,
    section_646b_tax_in_lieu_of_chapter_1_tax,
};

// ============================================================================
// §641(a): the section 1(e) tax applies to estate/trust taxable income
// ============================================================================

@source(IRC_S641_A, relation = formalizes, coverage = exact, quote = "The tax imposed by section 1(e) shall apply to the taxable income of estates or of any kind of property held in trust")
pub relation section_1e_tax_applies(et: Person, y: TaxableYear) kind institutional {
    label en official "the tax imposed by section 1(e) applies to the taxable income of an estate or of property held in trust (section 641(a))";
}
rule S641aTaxAppliesToEstate(et: Estate, y: TaxableYear) defeasible {
    when us.irc.income_individual::taxable_income(et, y, _);
    then section_1e_tax_applies(et, y);
}
rule S641aTaxAppliesToTrust(et: Trust, y: TaxableYear) defeasible {
    when us.irc.income_individual::taxable_income(et, y, _);
    unless section_646b_tax_in_lieu_of_chapter_1_tax(et, y);
    then section_1e_tax_applies(et, y);
}

// The actual amount is `us.irc.income_individual::tax_under_section_1`,
// already computed for filing_status(p, y, EstateOrTrust) — see that
// package's rates.law (Table T5/TCJA-E). This package's own pub name:
pub relation section_641a_tax(et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "the amount of tax imposed by section 1(e) on the estate's or trust's taxable income (section 641(a))";
}
rule S641aTaxAmount(et: Person, y: TaxableYear, amount: Money) defeasible {
    when section_1e_tax_applies(et, y);
    when us.irc.income_individual::tax_under_section_1(et, y, amount);
    then section_641a_tax(et, y, amount);
}

// §641(a)(1)-(4): illustrative categories (NON_NORMATIVE per header note) —
// still anchored so a reader can find where the pinned text sits, but no
// rule derives from them beyond the pass-through below (they describe WHICH
// trust income counts, which the DNI/distribution machinery already governs).
@source(IRC_S641_A, relation = formalizes, coverage = contextual, quote = "income accumulated in trust for the benefit of unborn or unascertained persons or persons with contingent interests")
pub relation section_641a_illustrative_category(et: Trust, y: TaxableYear, note: Text) kind institutional {
    label en unofficial "illustrative, non-operative category of trust income section 641(a) lists as included (superseded in operative effect by the DNI/distribution rules; section 641(a)(1)-(4))";
}

// ============================================================================
// §641(b): taxable income computed as for an individual, except as provided
// ============================================================================

@source(IRC_S641_B, relation = formalizes, coverage = exact, quote = "The taxable income of an estate or trust shall be computed in the same manner as in the case of an individual, except as otherwise provided in this part.")
pub relation estate_or_trust_taxable_income_computed_as_individual(et: Person, y: TaxableYear) kind institutional {
    label en official "the taxable income of an estate or trust is computed in the same manner as for an individual, except as otherwise provided in this part (section 641(b))";
}
rule S641bComputedAsIndividual(et: Estate, y: TaxableYear) defeasible {
    when us.irc.gross_income::gross_income(et, y, _);
    then estate_or_trust_taxable_income_computed_as_individual(et, y);
}
rule S641bComputedAsIndividualTrust(et: Trust, y: TaxableYear) defeasible {
    when us.irc.gross_income::gross_income(et, y, _);
    then estate_or_trust_taxable_income_computed_as_individual(et, y);
}

// This package's own aggregate of deductions it does NOT own (interest,
// taxes, administration expenses, depletion, etc. — chapter 1 provisions
// outside Subchapter J) — a case-supplied net figure, not invented here.
pub relation other_allowable_deductions(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the total of deductions allowable to the estate or trust under provisions OTHER than section 642(b)/(c) and section 651/661 (e.g. sections 162, 163, 164, 212, 611) — a case-supplied aggregate; this package does not own or recompute those sections";
}

// Taxable income BEFORE the distribution deduction and personal exemption —
// the figure section 643(a)'s modifications (1)-(2) start from (see
// 03-definitions-and-dni.law for the DNI computation itself).
pub relation taxable_income_before_distribution_and_exemption(et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "intermediate value: gross income less deductions this package does not own and less the section 642(c) charitable set-aside, but BEFORE the section 642(b) personal-exemption deduction and the section 651/661 distribution deduction";
}
rule S641bPretaxIncomeEstate(et: Estate, y: TaxableYear, gross: Money, other: Money, charitable: Money) defeasible {
    when us.irc.gross_income::gross_income(et, y, gross);
    when other_allowable_deductions(et, y, other);
    when charitable_set_aside_deduction(et, y, charitable);
    then taxable_income_before_distribution_and_exemption(et, y, gross - other - charitable);
}
rule S641bPretaxIncomeEstateNoCharitable(et: Estate, y: TaxableYear, gross: Money, other: Money) defeasible {
    label en unofficial "same computation when no section 642(c) charitable set-aside deduction is claimed for the year (defeated once a charitable amount is asserted, to avoid double-counting with the rule above)";
    when us.irc.gross_income::gross_income(et, y, gross);
    when other_allowable_deductions(et, y, other);
    unless charitable_set_aside_deduction(et, y, _) and us.irc.gross_income::gross_income(et, y, gross) and other_allowable_deductions(et, y, other);
    then taxable_income_before_distribution_and_exemption(et, y, gross - other);
}
rule S641bPretaxIncomeTrust(et: Trust, y: TaxableYear, gross: Money, other: Money, charitable: Money) defeasible {
    when us.irc.gross_income::gross_income(et, y, gross);
    when other_allowable_deductions(et, y, other);
    when charitable_set_aside_deduction(et, y, charitable);
    then taxable_income_before_distribution_and_exemption(et, y, gross - other - charitable);
}
rule S641bPretaxIncomeTrustNoCharitable(et: Trust, y: TaxableYear, gross: Money, other: Money) defeasible {
    label en unofficial "same computation when no section 642(c) charitable set-aside deduction is claimed for the year";
    when us.irc.gross_income::gross_income(et, y, gross);
    when other_allowable_deductions(et, y, other);
    unless charitable_set_aside_deduction(et, y, _) and us.irc.gross_income::gross_income(et, y, gross) and other_allowable_deductions(et, y, other);
    then taxable_income_before_distribution_and_exemption(et, y, gross - other);
}

// ============================================================================
// §641(c): electing small business trusts (ESBT)
// ============================================================================

pub relation esbt_election_in_effect(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "a section 1361(e)(1) election that the trust is an electing small business trust is in effect for the year (case-asserted; section 1361(e)(1) itself is owned by us.irc.s_corporations, EXTERNAL_DEPENDENCY, see coverage/trusts-estates.deps.json)";
}
pub relation esbt_s_corporation_stock_portion(t: Trust, y: TaxableYear) kind empirical {
    label en unofficial "the trust holds stock in one or more S corporations for the taxable year, i.e. it has a portion described in section 641(c)(1)(A) (case-asserted)";
}

@source(IRC_S641_C, relation = formalizes, coverage = exact, quote = "the portion of any electing small business trust which consists of stock in 1 or more S corporations shall be treated as a separate trust")
pub relation esbt_s_corp_portion_treated_as_separate_trust(t: Trust, y: TaxableYear) kind institutional {
    label en official "the portion of an electing small business trust which consists of stock in one or more S corporations is treated as a separate trust for purposes of computing the tax attributable to that portion (section 641(c)(1)(A))";
}
rule S641cSeparateTrustTreatment(t: Trust, y: TaxableYear) defeasible {
    when esbt_election_in_effect(t, y);
    when esbt_s_corporation_stock_portion(t, y);
    then esbt_s_corp_portion_treated_as_separate_trust(t, y);
}

enum EsbtItemKind {
    Section1366PassThroughItem;
    GainOrLossFromSCorpStockDisposition;
    AllocableStateOrLocalTaxOrAdminExpense;
    InterestOnSCorpStockAcquisitionDebt;
}
pub relation esbt_separate_trust_item(t: Trust, y: TaxableYear, kind: EsbtItemKind, amount: Money) kind empirical {
    label en unofficial "an item of income, loss, deduction or credit of the described kind, taken into account for the ESBT separate-trust computation (case-asserted per item)";
}
@source(IRC_S641_C, relation = formalizes, coverage = exact, quote = "The only items of income, loss, deduction, or credit to be taken into account are the following")
pub relation esbt_separate_trust_taxable_income(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "the electing small business trust's separate-trust taxable income equals the sum of the section 641(c)(2)(C) items only — no other item of income, loss, deduction or credit is taken into account (section 641(c)(2)(C)-(D))";
}
rule S641cSeparateTrustTaxableIncome(t: Trust, y: TaxableYear) defeasible {
    when esbt_s_corp_portion_treated_as_separate_trust(t, y);
    then esbt_separate_trust_taxable_income(t, y,
        sum all amount: Money for kind: EsbtItemKind where esbt_separate_trust_item(t, y, kind, amount));
}

@source(IRC_S641_C, relation = formalizes, coverage = exact, quote = "No amount shall be allowed under paragraph (1) or (2) of section 1211(b).")
pub relation esbt_no_1211b_capital_loss_deduction(t: Trust, y: TaxableYear) kind institutional {
    label en official "no amount is allowed under section 1211(b)(1) or (2) (the individual $3,000 capital-loss offset) in computing the ESBT separate-trust tax (section 641(c)(2)(D))";
}
rule S641cNo1211bDeduction(t: Trust, y: TaxableYear) defeasible {
    when esbt_s_corp_portion_treated_as_separate_trust(t, y);
    then esbt_no_1211b_capital_loss_deduction(t, y);
}

@source(IRC_S641_C, relation = formalizes, coverage = exact, quote = "Section 642(c) shall not apply.")
pub relation esbt_no_charitable_set_aside_deduction(t: Trust, y: TaxableYear) kind institutional {
    label en official "section 642(c) (the charitable set-aside deduction) does not apply to the ESBT separate-trust computation (section 641(c)(2)(E)(i))";
}
rule S641cNoCharitableSetAside(t: Trust, y: TaxableYear) defeasible {
    when esbt_s_corp_portion_treated_as_separate_trust(t, y);
    then esbt_no_charitable_set_aside_deduction(t, y);
}

@source(IRC_S641_C, relation = formalizes, coverage = exact, quote = "the items referred to in paragraph (2)(C) shall be excluded")
pub relation esbt_items_excluded_from_entire_trust_dni(t: Trust, y: TaxableYear) kind institutional {
    label en official "the section 641(c)(2)(C) items taken into account on the ESBT separate-trust computation are excluded in determining the distributable net income of the entire trust (section 641(c)(3))";
}
rule S641cItemsExcludedFromEntireTrustDNI(t: Trust, y: TaxableYear) defeasible {
    when esbt_s_corp_portion_treated_as_separate_trust(t, y);
    then esbt_items_excluded_from_entire_trust_dni(t, y);
}

// §641(c)(2)(A)-(B), (c)(2)(B), (c)(4): TECH_GAP/EXTERNAL_DEPENDENCY —
// see coverage row notes and coverage/trusts-estates.deps.json:
//  - (c)(2)(A): the highest section 1(e) rate is not exposed as a bare
//    constant by us.irc.income_individual (pending).
//  - (c)(2)(B): the section 55(d) exemption-amount-is-zero rule reads a
//    us.irc.amt (not yet an owner package) relation (pending).
//  - (c)(4): carryover/excess-deduction reallocation on a portion ceasing
//    separate-trust treatment is a TECH_GAP (multi-year ledger, same class
//    as TECH-GAPS.md's day-by-day-ledger family).
