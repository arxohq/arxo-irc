// Shared ontology for Subchapter J: type aliases onto `us.irc.core`, the
// beneficiary/fiduciary vocabulary every later module uses, and the
// character-of-income and DNI-adjustment enums §652(b)/§662(b)/§643(a) need.
// Nothing here duplicates a `us.irc.core` symbol; `Trust`/`Estate` ARE core's
// `Person` subtypes (CONTRACT.md), so a rule typed over `Estate` or `Trust`
// feeds a `Person`-typed relation head directly (see
// `us.irc.income_individual::filing_status`'s own `EstateOrTrust` pattern).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

import us.irc.core version "0.1.1";
import us.irc.income_individual version "0.1.1";
import us.irc.gross_income version "0.1.1";
import us.irc.definitions version "0.1.1";

use self::{
    IRC_S643_C,
};

type Person = us.irc.core::Person;
type Trust = us.irc.core::Trust;
type Estate = us.irc.core::Estate;
type Individual = us.irc.core::Individual;
type TaxableYear = us.irc.core::TaxableYear;
type Election = us.irc.core::Election;
type Asset = us.irc.core::Asset;
type Transaction = us.irc.core::Transaction;

const Secretary: us.irc.core::Organ = us.irc.core::Secretary;

// --- Beneficiary and fiduciary vocabulary -----------------------------------

pub relation is_beneficiary(b: Person, et: Person) kind empirical {
    label en unofficial "b is a beneficiary of the estate or trust et (a case-asserted relation of the governing instrument/probate facts, no single defining section in this subchapter — section 643(c) only extends the WORD to heirs, legatees, devisees)";
}

@source(IRC_S643_C, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"beneficiary\" includes heir, legatee, devisee.")
pub relation beneficiary_includes_heir_legatee_devisee(b: Person, et: Person) kind institutional {
    label en official "the term \"beneficiary\" (for purposes of this part) includes an heir, legatee, or devisee (section 643(c))";
}
rule S643cBeneficiaryIncludesHeirLegateeDevisee(b: Person, et: Person) strict {
    when is_beneficiary(b, et);
    then beneficiary_includes_heir_legatee_devisee(b, et);
}

// §671's "fiduciary" and "grantor" are read against core's role Fiduciary /
// fiduciary_for(fiduciary, principal); "grantor" itself has no core role —
// it is the person who created the trust, a fact this package asserts
// directly (no defining section anchors "grantor" in Subchapter J; subpart E
// USES the term throughout without defining it).
pub relation is_grantor_of(g: Person, t: Trust) kind empirical {
    label en unofficial "g is the grantor of trust t (a case-asserted fact of trust formation; subpart E uses the term without its own defining section)";
}

// --- Character of amounts distributed (§652(b)/§662(b)/§664(b)) ------------

enum IncomeCharacterClass {
    OrdinaryIncomeOtherThanCapitalGain;
    NetCapitalGain;
    TaxExemptInterest;
    OtherIncomeCharacterClass;
}

pub relation trust_income_by_character(et: Person, y: TaxableYear, cls: IncomeCharacterClass, amount: Money) kind empirical {
    label en unofficial "the estate's or trust's own gross income for the year broken down by character class (case-asserted, feeds the section 652(b)/662(b) same-character-in-the-beneficiary's-hands rule)";
}

// --- §643(a) distributable net income: shared adjustment vocabulary --------

enum DniAdjustmentKind {
    CapitalGainAllocatedToCorpusNotDistributable;
    TaxExemptInterestNetOfDisbursements;
    ForeignTrustForeignSourceGrossIncomeAddback;
    ForeignTrustCharitableAllocableReduction;
    ExtraordinaryDividendAllocatedToCorpusSimpleTrustOnly;
    Section646fEarningsAndProfitsIncrease;
}

pub relation dni_addition(et: Person, y: TaxableYear, kind: DniAdjustmentKind, amount: Money) kind empirical {
    label en unofficial "an amount added back in computing distributable net income under one of the section 643(a) modifications that increase the figure (case-asserted per component)";
}
pub relation dni_subtraction(et: Person, y: TaxableYear, kind: DniAdjustmentKind, amount: Money) kind empirical {
    label en unofficial "an amount subtracted in computing distributable net income under one of the section 643(a) modifications that decrease the figure (case-asserted per component)";
}
