// 26 U.S.C. §§681-685 (Part I subpart F limitations on the charitable
// deduction, the CRT/pooled-fund-adjacent investment-company anti-abuse
// rule, foreign-transfer gain recognition, funeral trusts) and §§691-692
// (Part II: income in respect of a decedent (IRD) and the armed-forces/
// terrorist-victim tax forgiveness rules).
//
// JUDGMENT CALLS:
//  - §681(a)'s "unrelated business income" cross-references section 512;
//    modeled as a case-asserted amount (EXTERNAL_DEPENDENCY on
//    us.irc.exempt-organizations, which owns section 511-514).
//  - §682 is REPEALED (Pub. L. 115-97 §11051(b)(1)(C), for divorces/
//    separation instruments executed after Dec. 31, 2018): the pinned
//    fragment IRC_S682 carries no operative text, confirming the repeal on
//    the face of the pinned snapshot — classified `repealed_or_reserved`,
//    no rule written.
//  - §683 (investment-company anti-abuse on funding a trust in exchange for
//    an interest in other trust property) reads section 351's "investment
//    company" test — EXTERNAL_DEPENDENCY (no us.irc.* owner formalizes it);
//    the STATUTORY consequence (gain recognized) is executable over a
//    case-asserted classification fact.
//  - §684 (gain recognition on transfers to foreign trusts/estates) is
//    executable directly, including its section 671 owner-trust exception
//    (which reuses this package's OWN `treated_as_owner_of_portion`, no
//    external dependency) and the deemed-transfer rule for a trust that
//    becomes foreign.
//  - §685 (funeral trusts) is executable: the qualification test (b)(1)-(6)
//    as a closed-list classification, and the consequences (a)(1)-(2), (c),
//    (d) directly. (e)'s simplified-reporting authority is NON_NORMATIVE
//    (a delegation, not a rule).
//  - §691(a): the three alternative recipients (A)/(B)/(C) are modeled as a
//    single classification with a `recipient_kind` tag, since exactly one
//    applies to a given right depending on case facts; §691(a)(4)
//    (installment obligations) is TECH_GAP (a distinct valuation regime this
//    package does not further formalize).
//  - §691(c): the estate-tax-attributable deduction is modeled with the
//    exact intermediate values the statute names (net value, estate tax
//    attributable), reading the ESTATE TAX figures themselves as
//    EXTERNAL_DEPENDENCY case facts from us.irc.estate-gift (pending — no
//    owner package yet formalizes section 2001).
//  - §692: the armed-forces/terrorist-victim tax forgiveness is modeled as
//    an `immunity` (protected_effect: no tax imposed for the stated years)
//    per the brief's own deontic classification for statutory protections;
//    §692(d)(2)'s $10,000-floor rule and (d)(3)'s deferred-compensation
//    carve-out are executable directly; the "terroristic or military
//    action" determination (c)(2) is EVALUATIVE (a factual/political
//    determination, no bright line) — DECISION-0194, modeled as an
//    external judgment relation with the Secretary as the nominal
//    authority (the statute itself commits it to "a preponderance of the
//    evidence", i.e. adjudicated fact channel).

language "law.core" version "0.2";
package us.irc.trusts_estates version "0.1.1";
namespace "urn:us:irc:trusts_estates:clir";

use self::{
    Election,
    IRC_S681_A,
    IRC_S683_A,
    IRC_S684_A,
    IRC_S684_C,
    IRC_S685_A,
    IRC_S685_C,
    IRC_S691_A,
    IRC_S691_B,
    IRC_S691_C,
    IRC_S692_A,
    IRC_S692_D,
    IncomeCharacterClass,
    Person,
    TaxableYear,
    Transaction,
    Trust,
    is_beneficiary,
    is_section_651_simple_trust,
    section_1e_tax_applies,
    section_651_distribution_deduction,
    section_652_beneficiary_inclusion,
    section_661_distribution_deduction,
    section_662a1_beneficiary_inclusion,
    section_662a2_beneficiary_inclusion,
    section_692b_cutoff_bars_forgiveness,
    treated_as_owner_of_portion,
};

// ============================================================================
// §681: limitation on charitable deduction for unrelated business income
// ============================================================================

pub relation trust_unrelated_business_income_amount(t: Trust, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the trust's unrelated business income allocable to income of the year, within the meaning of section 681(b) (case-asserted; EXTERNAL_DEPENDENCY on us.irc.exempt-organizations' section 511-514 computation)";
}
@source(IRC_S681_A, relation = formalizes, coverage = exact, quote = "no amount otherwise allowable under section 642(c) as a deduction shall be allowed as a deduction with respect to income of the taxable year which is allocable to its unrelated business income for such year")
pub relation section_681a_charitable_deduction_disallowed(t: Trust, y: TaxableYear, amount: Money) kind institutional {
    label en official "no section 642(c) charitable-set-aside deduction is allowed with respect to trust income for the year allocable to its unrelated business income (section 681(a))";
}
rule S681aUnrelatedBusinessIncomeLimitation(t: Trust, y: TaxableYear, amount: Money) strict {
    when trust_unrelated_business_income_amount(t, y, amount);
    when amount > 0 USD;
    then section_681a_charitable_deduction_disallowed(t, y, amount);
}

// §682: REPEALED (Pub. L. 115-97 §11051(b)(1)(C)) — the pinned fragment
// carries no operative text; `repealed_or_reserved`, no rule.

// ============================================================================
// §683: gain on transfer in exchange for an interest in an investment trust
// ============================================================================

pub relation transfer_to_trust_in_exchange_for_interest(t: Trust, transferor: Person, transaction: Transaction) kind empirical {
    label en unofficial "property is transferred to a trust in exchange for an interest in other trust property (case-asserted; section 683(a))";
}
pub relation trust_would_be_investment_company_under_351(t: Trust) kind empirical {
    label en unofficial "the trust would be an investment company within the meaning of section 351 if it were a corporation — EXTERNAL_DEPENDENCY on the section 351 test (case-asserted; section 683(a))";
}
pub relation transfer_to_pooled_income_fund(t: Trust, transaction: Transaction) kind empirical {
    label en unofficial "the transfer is to a pooled income fund within the meaning of section 642(c)(5) (case-asserted exception; section 683(b))";
}
@source(IRC_S683_A, relation = formalizes, coverage = exact, quote = "if property is transferred to a trust in exchange for an interest in other trust property and if the trust would be an investment company (within the meaning of section 351) if it were a corporation, then gain shall be recognized to the transferor")
pub relation gain_recognized_on_investment_trust_exchange_683(t: Trust, transferor: Person, transaction: Transaction) kind institutional {
    label en official "gain is recognized to the transferor on a transfer of property to a trust in exchange for an interest in other trust property, when the trust would be an investment company under section 351 if it were a corporation, except for a transfer to a pooled income fund (section 683(a)-(b))";
}
rule S683aGainRecognized(t: Trust, transferor: Person, transaction: Transaction) defeasible {
    when transfer_to_trust_in_exchange_for_interest(t, transferor, transaction);
    when trust_would_be_investment_company_under_351(t);
    unless transfer_to_pooled_income_fund(t, transaction) and transfer_to_trust_in_exchange_for_interest(t, transferor, transaction);
    then gain_recognized_on_investment_trust_exchange_683(t, transferor, transaction);
}

// ============================================================================
// §684: gain on transfers to foreign trusts and estates
// ============================================================================

pub relation us_person_transfers_property_to_foreign_estate_or_trust(transferor: Person, et: Person, transaction: Transaction, fmv: Money, basis: Money) kind empirical {
    label en unofficial "a United States person transfers property to a foreign estate or trust, with the property's fair market value and adjusted basis (case-asserted; section 684(a))";
}
@source(IRC_S684_A, relation = formalizes, coverage = exact, quote = "in the case of any transfer of property by a United States person to a foreign estate or trust, for purposes of this subtitle, such transfer shall be treated as a sale or exchange for an amount equal to the fair market value of the property transferred")
pub relation section_684a_gain_recognized(transferor: Person, et: Person, transaction: Transaction, amount: Money) kind institutional {
    label en official "a transfer of property by a United States person to a foreign estate or trust is treated as a sale or exchange at fair market value, and the transferor recognizes gain equal to fair market value less adjusted basis, except to the extent any person is treated as owner of the trust under section 671 (section 684(a)-(b))";
}
rule S684aGainOnForeignTransfer(transferor: Person, et: Person, transaction: Transaction, fmv: Money, basis: Money) defeasible {
    when us_person_transfers_property_to_foreign_estate_or_trust(transferor, et, transaction, fmv, basis);
    when fmv > basis;
    unless treated_as_owner_of_portion(_, et, _) and us_person_transfers_property_to_foreign_estate_or_trust(transferor, et, transaction, fmv, basis);
    then section_684a_gain_recognized(transferor, et, transaction, fmv - basis);
}

pub relation trust_becomes_foreign_trust(t: Trust, d: Date) kind empirical {
    label en unofficial "a trust which is not a foreign trust becomes a foreign trust on the stated date (case-asserted; section 684(c))";
}
@source(IRC_S684_C, relation = formalizes, coverage = exact, quote = "If a trust which is not a foreign trust becomes a foreign trust, such trust shall be treated for purposes of this section as having transferred, immediately before becoming a foreign trust, all of its assets to a foreign trust.")
pub relation deemed_transfer_of_all_assets_684c(t: Trust, d: Date) kind institutional {
    label en official "a trust that becomes a foreign trust is treated, for purposes of section 684, as having transferred all of its assets to a foreign trust immediately before becoming one (section 684(c))";
}
rule S684cBecomesForeignTrust(t: Trust, d: Date) strict {
    when trust_becomes_foreign_trust(t, d);
    then deemed_transfer_of_all_assets_684c(t, d);
}

// ============================================================================
// §685: qualified funeral trusts
// ============================================================================

pub relation funeral_trust_arises_from_funeral_services_contract(t: Trust) kind empirical {
    label en unofficial "the trust arises from a contract with a person in the trade or business of providing funeral or burial services or property (case-asserted; section 685(b)(1))";
}
pub relation funeral_trust_sole_purpose_hold_invest_pay(t: Trust) kind empirical {
    label en unofficial "the trust's sole purpose is to hold, invest, and reinvest funds and use them solely to pay for the funeral services or property at the beneficiaries' deaths (case-asserted; section 685(b)(2))";
}
pub relation funeral_trust_beneficiaries_are_contract_individuals(t: Trust) kind empirical {
    label en unofficial "the only beneficiaries are individuals for whom the services or property are to be provided at death under the funeral contracts (case-asserted; section 685(b)(3))";
}
pub relation funeral_trust_contributions_only_by_beneficiaries(t: Trust) kind empirical {
    label en unofficial "the only contributions to the trust are by or for the benefit of the contract beneficiaries (case-asserted; section 685(b)(4))";
}
pub relation funeral_trustee_elects_685(t: Trust, y: TaxableYear, e: Election) kind empirical {
    label en unofficial "the trustee elects the application of section 685 (case-asserted; section 685(b)(5))";
}
pub relation funeral_trust_would_be_671_owned_by_purchasers(t: Trust) kind empirical {
    label en unofficial "but for the section 685(b)(5) election, the trust would be treated as owned under subpart E by the purchasers of the funeral contracts (case-asserted; section 685(b)(6))";
}
@source(IRC_S685_A, relation = formalizes, coverage = exact, quote = "In the case of a qualified funeral trust—")
pub relation qualified_funeral_trust(t: Trust, y: TaxableYear) kind institutional {
    label en official "a trust satisfying the section 685(b)(1)-(6) conditions (funeral-services contract, sole purpose, contract-beneficiaries only, contract-beneficiary contributions only, a proper trustee election, and would otherwise be section 671-owned by the purchasers) is a qualified funeral trust (section 685(b))";
}
rule S685bQualifiedFuneralTrust(t: Trust, y: TaxableYear, e: Election) strict {
    when funeral_trust_arises_from_funeral_services_contract(t);
    when funeral_trust_sole_purpose_hold_invest_pay(t);
    when funeral_trust_beneficiaries_are_contract_individuals(t);
    when funeral_trust_contributions_only_by_beneficiaries(t);
    when funeral_trustee_elects_685(t, y, e);
    when funeral_trust_would_be_671_owned_by_purchasers(t);
    then qualified_funeral_trust(t, y);
}

@source(IRC_S685_A, relation = formalizes, coverage = exact, quote = "subparts B, C, D, and E shall not apply, and")
pub relation subparts_bcde_inapplicable_to_qft(t: Trust, y: TaxableYear) kind institutional {
    label en official "for a qualified funeral trust, subparts B, C, D, and E (sections 651-679) do not apply (section 685(a)(1))";
}
rule S685a1SubpartsInapplicable(t: Trust, y: TaxableYear) strict {
    when qualified_funeral_trust(t, y);
    then subparts_bcde_inapplicable_to_qft(t, y);
}
@source(IRC_S685_A, relation = formalizes, coverage = exact, quote = "no deduction shall be allowed by section 642(b)")
pub relation section_642b_inapplicable_to_qft(t: Trust, y: TaxableYear) kind institutional {
    label en official "for a qualified funeral trust, no deduction is allowed by section 642(b) (section 685(a)(2))";
}
rule S685a2NoExemptionDeduction(t: Trust, y: TaxableYear) strict {
    when qualified_funeral_trust(t, y);
    then section_642b_inapplicable_to_qft(t, y);
}
@source(IRC_S685_C, relation = formalizes, coverage = exact, quote = "Section 1(e) shall be applied to each qualified funeral trust by treating each beneficiary's interest in each such trust as a separate trust.")
pub relation each_beneficiary_interest_separate_trust_685c(t: Trust, y: TaxableYear, b: Person) kind institutional {
    label en official "section 1(e) is applied to a qualified funeral trust by treating each beneficiary's interest in the trust as a separate trust (section 685(c))";
}
rule S685cSeparateTrustPerBeneficiary(t: Trust, y: TaxableYear, b: Person) strict {
    when qualified_funeral_trust(t, y);
    when is_beneficiary(b, t);
    then each_beneficiary_interest_separate_trust_685c(t, y, b);
}

// ============================================================================
// §691(a): income in respect of a decedent (IRD)
// ============================================================================

enum Ird691RecipientKind {
    DecedentsEstateAcquiredFromDecedent;
    PersonAcquiringRightByReasonOfDeath;
    PersonAcquiringByBequestDeviseInheritanceAfterEstateDistribution;
}
pub relation ird_item_not_includible_before_death(decedent: Person, item: Text, amount: Money) kind empirical {
    label en unofficial "an item of gross income in respect of a decedent, not properly includible for the period through the date of death or a prior period (case-asserted; section 691(a)(1) chapeau)";
}
pub relation ird_recipient(decedent: Person, item: Text, recipient: Person, kind: Ird691RecipientKind) kind empirical {
    label en unofficial "the recipient of the IRD item and which of the three section 691(a)(1)(A)-(C) categories describes the recipient's acquisition (case-asserted)";
}
@source(IRC_S691_A, relation = formalizes, coverage = exact, quote = "The amount of all items of gross income in respect of a decedent which are not properly includible in respect of the taxable period in which falls the date of his death or a prior period")
pub relation income_in_respect_of_decedent_691a(decedent: Person, item: Text, recipient: Person, amount: Money) kind institutional {
    label en official "an item of gross income in respect of a decedent, not properly includible for the period through death or a prior period, is included in the gross income, for the taxable year received, of the decedent's estate, the person acquiring the right by reason of death, or the person acquiring it by bequest/devise/inheritance after estate distribution, as section 691(a)(1)(A)-(C) direct (section 691(a)(1))";
}
rule S691aIrdInclusion(decedent: Person, item: Text, recipient: Person, kind: Ird691RecipientKind, amount: Money) strict {
    when ird_item_not_includible_before_death(decedent, item, amount);
    when ird_recipient(decedent, item, recipient, kind);
    then income_in_respect_of_decedent_691a(decedent, item, recipient, amount);
}
pub relation beneficiary_inclusion_ird(b: Person, decedent: Person, item: Text, amount: Money) kind institutional {
    label en unofficial "alias: this package's pub name for the section 691(a) inclusion by the beneficiary/recipient of an IRD item";
}
rule S691aInclusionAlias(decedent: Person, item: Text, recipient: Person, amount: Money) strict {
    when income_in_respect_of_decedent_691a(decedent, item, recipient, amount);
    then beneficiary_inclusion_ird(recipient, decedent, item, amount);
}

@source(IRC_S691_A, relation = formalizes, coverage = exact, quote = "The right, described in paragraph (1), to receive an amount shall be treated, in the hands of the estate of the decedent or any person who acquired such right by reason of the death of the decedent, or by bequest, devise, or inheritance from the decedent, as if it had been acquired by the estate or such person in the transaction in which the right to receive the income was originally derived")
pub relation ird_right_retains_original_transaction_character(decedent: Person, item: Text, recipient: Person, cls: IncomeCharacterClass) kind institutional {
    label en official "the right to receive an IRD amount is treated, in the recipient's hands, as if acquired in the transaction in which the right to receive the income was originally derived, so the amount has the SAME CHARACTER it would have had in the decedent's hands (section 691(a)(3))";
}
pub relation ird_item_character_in_decedents_hands(decedent: Person, item: Text, cls: IncomeCharacterClass) kind empirical {
    label en unofficial "the character the IRD item would have had, includible in the decedent's own gross income, had the decedent lived to receive it (case-asserted; section 691(a)(3))";
}
rule S691a3CharacterCarriesOver(decedent: Person, item: Text, recipient: Person, cls: IncomeCharacterClass) strict {
    when ird_item_character_in_decedents_hands(decedent, item, cls);
    when income_in_respect_of_decedent_691a(decedent, item, recipient, _);
    then ird_right_retains_original_transaction_character(decedent, item, recipient, cls);
}

pub relation ird_right_transferred(decedent: Person, item: Text, transferor: Person, fmv_at_transfer: Money, consideration_excess: Money) kind empirical {
    label en unofficial "the right to receive an IRD amount is transferred by the estate or a person who received it by reason of death or by bequest/devise/inheritance, with the right's fair market value at the time of transfer and the excess (if any) of consideration received over that fair market value (case-asserted; section 691(a)(2))";
}
@source(IRC_S691_A, relation = formalizes, coverage = exact, quote = "there shall be included in the gross income of the estate or such person, as the case may be, for the taxable period in which the transfer occurs, the fair market value of such right at the time of such transfer plus the amount by which any consideration for the")
pub relation gross_income_on_ird_right_transfer_691a2(decedent: Person, item: Text, transferor: Person, amount: Money) kind institutional {
    label en official "on a transfer of the right to receive an IRD amount, the transferor includes in gross income, for the taxable period of transfer, the right's fair market value at the time of transfer plus any consideration received in excess of that value (section 691(a)(2))";
}
rule S691a2TransferInclusion(decedent: Person, item: Text, transferor: Person, fmv: Money, excess: Money) strict {
    when ird_right_transferred(decedent, item, transferor, fmv, excess);
    then gross_income_on_ird_right_transfer_691a2(decedent, item, transferor, fmv + excess);
}

// ============================================================================
// §691(b): deductions and credits in respect of a decedent
// ============================================================================

pub relation ird_162_163_164_212_deduction_or_27_credit_not_allowable_before_death(decedent: Person, item: Text, amount: Money) kind empirical {
    label en unofficial "an amount of a section 162/163/164/212 deduction or section 27 credit in respect of the decedent, not properly allowable for the period through death or a prior period (case-asserted; section 691(b)(1))";
}
pub relation ird_611_depletion_deduction_not_allowable_before_death(decedent: Person, item: Text, amount: Money) kind empirical {
    label en unofficial "an amount of a section 611 depletion deduction in respect of the decedent, not properly allowable for the period through death or a prior period (case-asserted; section 691(b)(2))";
}
@source(IRC_S691_B, relation = formalizes, coverage = exact, quote = "The amount of any deduction specified in section 162, 163, 164, 212, or 611")
pub relation deduction_or_credit_allowed_in_respect_of_decedent_691b(payer: Person, decedent: Person, item: Text, amount: Money) kind institutional {
    label en official "a section 162/163/164/212 deduction or section 27 credit in respect of a decedent, not properly allowable through the date of death, is allowed to the person who, by reason of acquiring the decedent's property (or the estate, if it is liable), pays the amount, in the taxable year paid; a section 611 depletion deduction is instead allowed to the section 691(a)(1) recipient (section 691(b)(1)-(2))";
}
rule S691bDeductionToPayer(payer: Person, decedent: Person, item: Text, amount: Money) strict {
    when ird_162_163_164_212_deduction_or_27_credit_not_allowable_before_death(decedent, item, amount);
    when payer_pays_ird_item(payer, decedent, item);
    then deduction_or_credit_allowed_in_respect_of_decedent_691b(payer, decedent, item, amount);
}
pub relation payer_pays_ird_item(payer: Person, decedent: Person, item: Text) kind empirical {
    label en unofficial "payer is the estate of the decedent (or, if the estate is not liable to discharge the obligation, the person who by reason of the decedent's death acquires subject to the obligation the property to which it relates) (case-asserted; section 691(b)(1)(A)-(B))";
}
rule S691bDepletionDeduction(payer: Person, decedent: Person, item: Text, amount: Money) strict {
    label en official "the section 611 depletion deduction in respect of a decedent is allowed to the section 691(a)(1)(A)/(B)/(C) recipient who, in the manner described there, receives the income to which the deduction relates (section 691(b)(2))";
    when ird_611_depletion_deduction_not_allowable_before_death(decedent, item, amount);
    when ird_recipient(decedent, item, payer, _);
    then deduction_or_credit_allowed_in_respect_of_decedent_691b(payer, decedent, item, amount);
}

// ============================================================================
// §691(c): deduction for estate tax attributable to IRD
// ============================================================================

pub relation estate_tax_under_2001_or_2101(decedent: Person, amount: Money) kind empirical {
    label en unofficial "the tax imposed on the decedent's (or a prior decedent's) estate under section 2001 or 2101, reduced by credits against that tax — EXTERNAL_DEPENDENCY: us.irc.estate-gift does not yet exist as an owner package; case-asserted (section 691(c)(2)(A))";
}
pub relation ird_items_value_for_estate_tax_purposes(decedent: Person, amount: Money) kind empirical {
    label en unofficial "the value for estate tax purposes of all the section 691(a)(1) items (case-asserted; section 691(c)(2)(B))";
}
pub relation deductions_from_gross_estate_for_691b_claims(decedent: Person, amount: Money) kind empirical {
    label en unofficial "the deductions from the gross estate in respect of claims which represent the section 691(b) deductions and credit (case-asserted; section 691(c)(2)(B))";
}
@source(IRC_S691_C, relation = formalizes, coverage = exact, quote = "The net value for estate tax purposes of all the items described in subsection (a)(1) shall be the excess of the value for estate tax purposes of all the items described in subsection (a)(1) over the deductions from the gross estate in respect of claims which represent the deductions and credit described in subsection (b).")
pub relation net_value_for_estate_tax_purposes_691c(decedent: Person, amount: Money) kind institutional {
    label en official "the net value for estate tax purposes of the section 691(a)(1) items: their value for estate tax purposes, less the deductions from the gross estate representing the section 691(b) deductions and credit (section 691(c)(2)(B))";
}
rule S691c2bNetValue(decedent: Person, items_value: Money, claim_deductions: Money) strict {
    when ird_items_value_for_estate_tax_purposes(decedent, items_value);
    when deductions_from_gross_estate_for_691b_claims(decedent, claim_deductions);
    then net_value_for_estate_tax_purposes_691c(decedent, items_value - claim_deductions);
}

pub relation estate_tax_computed_excluding_net_value(decedent: Person, amount: Money) kind empirical {
    label en unofficial "the estate tax computed without including the section 691(c)(2)(B) net value in the gross estate — a case-asserted counterfactual estate-tax recomputation, EXTERNAL_DEPENDENCY on us.irc.estate-gift (section 691(c)(2)(C))";
}
@source(IRC_S691_C, relation = formalizes, coverage = exact, quote = "The estate tax attributable to such net value shall be an amount equal to the excess of the estate tax over the estate tax computed without including in the gross estate such net value.")
pub relation estate_tax_attributable_to_net_value_691c(decedent: Person, amount: Money) kind institutional {
    label en official "the estate tax attributable to the section 691(c)(2)(B) net value: the excess of the actual estate tax (reduced by credits, section 691(c)(2)(A)) over the estate tax computed without including that net value in the gross estate (section 691(c)(2)(C))";
}
rule S691c2cAttributableEstateTax(decedent: Person, actual_tax: Money, excluding_net_value: Money) strict {
    when estate_tax_under_2001_or_2101(decedent, actual_tax);
    when estate_tax_computed_excluding_net_value(decedent, excluding_net_value);
    when actual_tax > excluding_net_value;
    then estate_tax_attributable_to_net_value_691c(decedent, actual_tax - excluding_net_value);
}

pub relation ird_item_value_for_recipients_deduction(decedent: Person, item: Text, recipient: Person, value_or_included: Money) kind empirical {
    label en unofficial "the value for estate tax purposes of the item (or portion) in respect of which the recipient included the amount in gross income, or the amount so included, WHICHEVER IS LOWER — case-supplied as the already-lower figure (section 691(c)(1)(A))";
}
@source(IRC_S691_C, relation = formalizes, coverage = exact, quote = "A person who includes an amount in gross income under subsection (a) shall be allowed, for the same taxable year, as a deduction an amount which bears the same ratio to the estate tax attributable to the net value for estate tax purposes of all the items described in subsection (a)(1) as the value for estate tax purposes of the items of gross income or portions thereof in respect of which such person included the amount in gross income (or the amount included in gross income, whichever is lower)")
pub relation irc_691c_deduction(recipient: Person, decedent: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "a person who includes an IRD amount in gross income is allowed, for the same taxable year, a deduction bearing the same ratio to the section 691(c)(2)(C) estate-tax-attributable amount as the value (or amount included, whichever lower) of that person's included items bears to the section 691(c)(2)(B) net value of ALL section 691(a)(1) items (section 691(c)(1)(A))";
}
rule S691c1DeductionRatio(recipient: Person, decedent: Person, y: TaxableYear, item_value: Money, net_value: Money, attributable_tax: Money) strict {
    when ird_item_value_for_recipients_deduction(decedent, _, recipient, item_value);
    when net_value_for_estate_tax_purposes_691c(decedent, net_value);
    when estate_tax_attributable_to_net_value_691c(decedent, attributable_tax);
    when net_value > 0 USD;
    when us.irc.core::year_of(recipient, y);
    then irc_691c_deduction(recipient, decedent, y, attributable_tax * (item_value / net_value));
}

pub relation portion_of_691a1_items_distributed_to_beneficiaries(et: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the portion of the section 691(a)(1) items that is properly paid, credited, or to be distributed to the beneficiaries during the taxable year (case-asserted; section 691(c)(1)(B))";
}
@source(IRC_S691_C, relation = formalizes, coverage = exact, quote = "the amount allowed as a deduction under subparagraph (A) shall be computed by excluding from the gross income of the estate or trust the portion (if any) of the items described in subsection (a)(1) which is properly paid, credited, or to be distributed to the beneficiaries during the taxable year")
pub relation estate_or_trust_691c_deduction_excludes_distributed_portion(et: Person, y: TaxableYear, gross_ird: Money, distributed_portion: Money) kind institutional {
    label en official "for an estate or trust, the section 691(c)(1)(A) deduction ratio is computed by excluding, from the estate's or trust's own gross income, the portion of section 691(a)(1) items properly paid, credited, or to be distributed to beneficiaries during the year (section 691(c)(1)(B))";
}
rule S691c1bExcludeDistributedPortion(et: Person, y: TaxableYear, gross_ird: Money, distributed: Money) strict {
    when ird_item_value_for_recipients_deduction(_, _, et, gross_ird);
    when portion_of_691a1_items_distributed_to_beneficiaries(et, y, distributed);
    then estate_or_trust_691c_deduction_excludes_distributed_portion(et, y, gross_ird, distributed);
}

// ============================================================================
// §692: forgiveness of tax for members of Armed Forces / terrorist victims
// ============================================================================

pub relation died_in_active_service_combat_zone_692a(decedent: Person, death_date: Date) kind empirical {
    label en unofficial "the individual died while in active service as a member of the Armed Forces, from wounds/disease incurred while serving in a combat zone or from certain terrorist/military actions (case-asserted; section 692(a))";
}
@source(IRC_S692_A, relation = formalizes, coverage = exact, quote = "In the case of any individual who dies while in active service as a member of the Armed Forces of the United States, if such death occurred while serving in a combat zone")
pub relation section_692a_tax_forgiveness(decedent: Person, y: TaxableYear) kind institutional {
    label en official "no tax imposed by this subtitle applies with respect to the taxable year in which death falls, or a prior taxable year in the period from the year before entering the combat zone through death, for a member of the Armed Forces who dies in active service from combat-zone-related causes (section 692(a)(1))";
}
rule S692aForgivenessImmunity(decedent: Person, death_date: Date, y: TaxableYear) defeasible {
    label en official "the forgiveness of tax for a member of the Armed Forces dying in a combat zone is modeled as an immunity: no assessment/liability for the stated taxable years (section 692(a))";
    when died_in_active_service_combat_zone_692a(decedent, death_date);
    when tax_year_within_692a_forgiveness_window(decedent, death_date, y);
    unless section_692b_cutoff_bars_forgiveness(decedent, death_date, y);
    then immunity Section692aForgiveness {
        holder decedent;
        protected_effect section_1e_tax_applies(decedent, y);
        window [-infinity, infinity];
    };
}
pub relation tax_year_within_692a_forgiveness_window(decedent: Person, death_date: Date, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year y falls within the section 692(a)(1) forgiveness window (the year of death or a qualifying prior year) — case-asserted year-matching fact, since the exact prior-year boundary depends on when the decedent entered the combat zone (case fact, not re-derived here)";
}

pub relation specified_terrorist_victim(decedent: Person) kind empirical {
    label en unofficial "the decedent is a specified terrorist victim within the meaning of section 692(d)(4) (case-asserted classification against the closed statutory list: April 19, 1995 or September 11, 2001 attacks, or the anthrax attacks between September 11, 2001 and January 1, 2002, excluding a participant/conspirator) (section 692(d)(4))";
}
pub relation tax_year_within_692d_forgiveness_window(decedent: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year y falls within the section 692(d)(1) forgiveness window for a specified terrorist victim (case-asserted)";
}
@source(IRC_S692_D, relation = formalizes, coverage = exact, quote = "In the case of a specified terrorist victim, any tax imposed by this chapter shall not apply")
rule S692dTerroristVictimForgiveness(decedent: Person, y: TaxableYear) strict {
    label en official "no tax imposed by this chapter applies, for a specified terrorist victim, with respect to the year of death or the qualifying prior-year period (section 692(d)(1))";
    when specified_terrorist_victim(decedent);
    when tax_year_within_692d_forgiveness_window(decedent, y);
    then immunity Section692dForgiveness {
        holder decedent;
        protected_effect section_1e_tax_applies(decedent, y);
        window [-infinity, infinity];
    };
}
pub relation tax_not_imposed_amount_692d(decedent: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of tax that would not be imposed by paragraph (1) for the specified terrorist victim (case-asserted; section 692(d)(2))";
}
@source(IRC_S692_D, relation = formalizes, coverage = exact, quote = "If, but for this paragraph, the amount of tax not imposed by paragraph (1) with respect to a specified terrorist victim is less than $10,000")
pub relation section_692d2_10000_floor_applies(decedent: Person, y: TaxableYear) kind institutional {
    label en official "if the amount of tax that would not be imposed for a specified terrorist victim is less than $10,000, the victim is treated as if the amount not imposed were exactly $10,000 (section 692(d)(2))";
}
rule S692d2TenThousandFloor(decedent: Person, y: TaxableYear, amount: Money) strict {
    when tax_not_imposed_amount_692d(decedent, y, amount);
    when amount < 10000 USD;
    then section_692d2_10000_floor_applies(decedent, y);
}

// ============================================================================
// Package-level pub interface aliases (named per the task's interface list)
// ============================================================================

pub relation distribution_deduction(et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "alias: the section 651 (simple trust) or section 661 (estate/complex trust) distribution deduction for the year, whichever applies";
}
rule DistributionDeductionAliasSimple(t: Trust, y: TaxableYear, amount: Money) defeasible {
    when section_651_distribution_deduction(t, y, amount);
    then distribution_deduction(t, y, amount);
}
rule DistributionDeductionAliasComplex(et: Person, y: TaxableYear, amount: Money) defeasible {
    when section_661_distribution_deduction(et, y, amount);
    then distribution_deduction(et, y, amount);
}

pub relation beneficiary_inclusion(b: Person, et: Person, y: TaxableYear, amount: Money) kind institutional {
    label en unofficial "alias: the beneficiary's gross-income inclusion under section 652 (simple trust) or section 662 tier 1/tier 2 (estate/complex trust)";
}
rule BeneficiaryInclusionAliasSimple(b: Person, t: Trust, y: TaxableYear, amount: Money) defeasible {
    when section_652_beneficiary_inclusion(b, t, y, amount);
    then beneficiary_inclusion(b, t, y, amount);
}
rule BeneficiaryInclusionAliasTier1(b: Person, et: Person, y: TaxableYear, amount: Money) defeasible {
    when section_662a1_beneficiary_inclusion(b, et, y, amount);
    then beneficiary_inclusion(b, et, y, amount);
}
rule BeneficiaryInclusionAliasTier2(b: Person, et: Person, y: TaxableYear, amount: Money) defeasible {
    when section_662a2_beneficiary_inclusion(b, et, y, amount);
    then beneficiary_inclusion(b, et, y, amount);
}

pub relation simple_trust(t: Trust, y: TaxableYear) kind institutional {
    label en unofficial "alias: the trust is a section 651 simple trust for the year";
}
rule SimpleTrustAlias(t: Trust, y: TaxableYear) defeasible {
    when is_section_651_simple_trust(t, y);
    then simple_trust(t, y);
}

pub relation grantor_trust_owner(owner: Person, t: Trust) kind institutional {
    label en unofficial "alias: owner is treated as the owner of some portion of the trust under one of sections 673-679 (the grantor-trust rules)";
}
rule GrantorTrustOwnerAlias(owner: Person, t: Trust, portion: Text) defeasible {
    when treated_as_owner_of_portion(owner, t, portion);
    then grantor_trust_owner(owner, t);
}

pub relation income_in_respect_of_decedent(decedent: Person, item: Text, recipient: Person, amount: Money) kind institutional {
    label en unofficial "alias: the section 691(a) income-in-respect-of-a-decedent inclusion";
}
rule IncomeInRespectOfDecedentAlias(decedent: Person, item: Text, recipient: Person, amount: Money) strict {
    when income_in_respect_of_decedent_691a(decedent, item, recipient, amount);
    then income_in_respect_of_decedent(decedent, item, recipient, amount);
}
