}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction which is exempt from section 406 of such Act by reason of section 408(e) of such Act (or which would be so exempt if such section 406 applied to such transaction) or which is exempt from section 406 of such Act by reason of section 408(b)(12) of such Act;")
rule Exemption4975d13(a: ExciseAct) defeasible {
    label en official "section 4975(d)(13): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d13_exempt_from_erisa_406_by_408e_or_408b12(a);
    unless owner_employee_transaction_4975f6(a) and d13_exempt_from_erisa_406_by_408e_or_408b12(a);
