    label en official "section 4975(d)(18): (A) the transaction involves a block trade";
}

pub relation d18_plan_interest_at_most_10_percent_of_block(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(18): (B) the plan's interest (with other plans of the same sponsor) does not exceed 10 percent of the aggregate size of the block trade";
}

pub relation d18_terms_at_least_as_favorable_as_arms_length(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(18): (C) the terms, including price, are at least as favorable to the plan as an arm's length transaction";
}

pub relation d18_compensation_not_greater_than_arms_length(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(18): (D) the compensation is not greater than in an arm's length transaction with an unrelated party";
}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction involving the purchase or sale of securities, or other property (as determined by the Secretary of Labor), between a plan and a disqualified person (other than a fiduciary described in subsection (e)(3)) with respect to a plan if—")
rule Exemption4975d18(a: ExciseAct) defeasible {
    label en official "section 4975(d)(18): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d18_block_trade(a);
    when d18_plan_interest_at_most_10_percent_of_block(a);
    when d18_terms_at_least_as_favorable_as_arms_length(a);
    when d18_compensation_not_greater_than_arms_length(a);
    unless owner_employee_transaction_4975f6(a) and d18_block_trade(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d19_executed_through_regulated_trading_system(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(19): (A) the transaction is executed through a regulated electronic communication network, alternative trading system, or similar venue";
}

pub relation d19_matching_rules_or_anonymous_execution(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(19): (B) the transaction is effected under best-price matching rules or the identity of the parties is not taken into account";
}

pub relation d19_price_and_compensation_not_greater_than_arms_length(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(19): (C) the price and compensation are not greater than in an arm's length transaction with an unrelated party";
}

pub relation d19_system_authorized_by_independent_fiduciary_if_owned(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(19): (D) if the disqualified person owns an interest in the system, it was authorized by the plan sponsor or an independent fiduciary";
}

pub relation d19_30_day_advance_notice_to_plan_fiduciary(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(19): (E) at least 30 days before the initial transaction a plan fiduciary received notice of execution through the system";
}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction involving the purchase or sale of securities, or other property (as determined by the Secretary of Labor), between a plan and a disqualified person if—")
rule Exemption4975d19(a: ExciseAct) defeasible {
    label en official "section 4975(d)(19): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d19_executed_through_regulated_trading_system(a);
    when d19_matching_rules_or_anonymous_execution(a);
    when d19_price_and_compensation_not_greater_than_arms_length(a);
    when d19_system_authorized_by_independent_fiduciary_if_owned(a);
    when d19_30_day_advance_notice_to_plan_fiduciary(a);
    unless owner_employee_transaction_4975f6(a) and d19_executed_through_regulated_trading_system(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d20_transaction_type_a_b_or_d_by_service_provider_only_dq(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(20): the transaction is of the (c)(1)(A), (B) or (D) kind with a disqualified person that is not an investment fiduciary and is disqualified solely by providing services or by a (e)(2)(F)-(I) relationship to a service provider";
}

pub relation d20_plan_receives_no_less_nor_pays_more_than_adequate_consideration(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(20): the plan receives no less, nor pays more, than adequate consideration";
}

@source(IRC_S4975_D, coverage = exact, quote = "transactions described in subparagraphs (A), (B), and (D) of subsection (c)(1) between a plan and a person that is a disqualified person other than a fiduciary (or an affiliate) who has or exercises any discretionary authority or control with respect to the investment of the plan assets involved in the transaction or renders investment advice (within the meaning of subsection (e)(3)(B)) with respect to those assets, solely by reason of providing services to the plan or solely by reason of a relationship to such a service provider described in subparagraph (F), (G), (H), or (I) of subsection (e)(2), or both, but only if in connection with such transaction the plan receives no less, nor pays no more, than adequate consideration,")
rule Exemption4975d20(a: ExciseAct) defeasible {
    label en official "section 4975(d)(20): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d20_transaction_type_a_b_or_d_by_service_provider_only_dq(a);
    when d20_plan_receives_no_less_nor_pays_more_than_adequate_consideration(a);
    unless owner_employee_transaction_4975f6(a) and d20_transaction_type_a_b_or_d_by_service_provider_only_dq(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d21_connected_with_securities_or_investment_assets(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(21): (A) the transaction is in connection with the purchase, holding or sale of securities or other investment assets";
}

pub relation d21_terms_not_less_favorable_than_comparable_arms_length(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(21): (B) the terms are not less favorable to the plan than comparable arm's length foreign exchange transactions";
}

pub relation d21_rate_within_3_percent_of_interbank_rates(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(21): (C) the exchange rate does not deviate by more than 3 percent from the interbank bid and asked rates";
}

pub relation d21_no_investment_discretion_or_advice(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(21): (D) the bank or broker-dealer has no investment discretion and provides no investment advice with respect to the transaction";
}

@source(IRC_S4975_D, coverage = exact, quote = "any foreign exchange transactions, between a bank or broker-dealer (or any affiliate of either) and a plan (as defined in this section) with respect to which such bank or broker-dealer (or affiliate) is a trustee, custodian, fiduciary, or other disqualified person, if—")
rule Exemption4975d21(a: ExciseAct) defeasible {
    label en official "section 4975(d)(21): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d21_connected_with_securities_or_investment_assets(a);
    when d21_terms_not_less_favorable_than_comparable_arms_length(a);
    when d21_rate_within_3_percent_of_interbank_rates(a);
    when d21_no_investment_discretion_or_advice(a);
    unless owner_employee_transaction_4975f6(a) and d21_connected_with_securities_or_investment_assets(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d22_cash_against_prompt_delivery_market_quoted_security(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (A) the transaction is for cash against prompt delivery of a security with readily available market quotations";
}

pub relation d22_at_independent_current_market_price(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (B) the transaction is effected at the independent current market price";
}

pub relation d22_no_commission_or_fee(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (C) no brokerage commission, fee or other remuneration is paid (customary transfer fees disclosed excepted)";
}

pub relation d22_advance_written_authorization_by_independent_fiduciary(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (D) an independent fiduciary for each plan authorized cross trading in advance in a separate document after disclosure";
}

pub relation d22_each_plan_has_assets_of_at_least_100_million(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (E) each plan (or master trust) participating has assets of at least $100,000,000";
}

pub relation d22_quarterly_report_to_authorizing_fiduciary(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (F) the investment manager gives the authorizing fiduciary a quarterly report of all cross trades";
}

pub relation d22_fee_schedule_and_services_not_conditioned_on_consent(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (G) the manager's fee schedule and other services are not conditioned on consent to cross trading";
}

pub relation d22_written_cross_trading_policies_followed(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (H) written cross-trading policies and procedures are adopted and followed";
}

pub relation d22_designated_reviewer_annual_written_report(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(22): (I) a designated individual reviews the trades and issues an annual written report within 90 days, notifying the fiduciary of the right to terminate";
}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction described in subsection (c)(1)(A) involving the purchase and sale of a security between a plan and any other account managed by the same investment manager, if—")
rule Exemption4975d22(a: ExciseAct) defeasible {
    label en official "section 4975(d)(22): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d22_cash_against_prompt_delivery_market_quoted_security(a);
    when d22_at_independent_current_market_price(a);
    when d22_no_commission_or_fee(a);
    when d22_advance_written_authorization_by_independent_fiduciary(a);
    when d22_each_plan_has_assets_of_at_least_100_million(a);
    when d22_quarterly_report_to_authorizing_fiduciary(a);
    when d22_fee_schedule_and_services_not_conditioned_on_consent(a);
    when d22_written_cross_trading_policies_followed(a);
    when d22_designated_reviewer_annual_written_report(a);
    unless owner_employee_transaction_4975f6(a) and d22_cash_against_prompt_delivery_market_quoted_security(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d23_transaction_a_b_c_or_d_in_connection_with_security_or_commodity(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(23): the transaction is of the (c)(1)(A)-(D) kind in connection with the acquisition, holding or disposition of a security or commodity";
}

pub relation d23_corrected_before_end_of_correction_period(a: ExciseAct) kind institutional {
    label en official "section 4975(d)(23): the transaction is corrected before the end of the correction period (f)(11)";
}

@source(IRC_S4975_D, coverage = exact, quote = "except as provided in subsection (f)(11), a transaction described in subparagraph (A), (B), (C), or (D) of subsection (c)(1) in connection with the acquisition, holding, or disposition of any security or commodity, if the transaction is corrected before the end of the correction period,")
rule Exemption4975d23(a: ExciseAct) defeasible {
    label en official "section 4975(d)(23): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d23_transaction_a_b_c_or_d_in_connection_with_security_or_commodity(a);
    when d23_corrected_before_end_of_correction_period(a);
    unless owner_employee_transaction_4975f6(a) and d23_transaction_a_b_c_or_d_in_connection_with_security_or_commodity(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d24_de_minimis_financial_incentive_401k4A(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(24): the provision of a de minimis financial incentive described in section 401(k)(4)(A)";
}

@source(IRC_S4975_D, coverage = exact, quote = "the provision of a de minimis financial incentive described in section 401(k)(4)(A),")
rule Exemption4975d24(a: ExciseAct) defeasible {
    label en official "section 4975(d)(24): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d24_de_minimis_financial_incentive_401k4A(a);
    unless owner_employee_transaction_4975f6(a) and d24_de_minimis_financial_incentive_401k4A(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d25_fees_of_automatic_portability_provider(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(25): the receipt of fees and compensation by the automatic portability provider for services provided in connection with an automatic portability transaction";
}

pub relation d25_f12_conditions_met(a: ExciseAct) kind institutional {
    label en official "section 4975(d)(25): the (f)(12) requirements for the automatic portability transaction are satisfied";
}

@source(IRC_S4975_D, coverage = exact, quote = "the receipt of fees and compensation by the automatic portability provider for services provided in connection with an automatic portability transaction.")
rule Exemption4975d25(a: ExciseAct) defeasible {
    label en official "section 4975(d)(25): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d25_fees_of_automatic_portability_provider(a);
    when d25_f12_conditions_met(a);
    unless owner_employee_transaction_4975f6(a) and d25_fees_of_automatic_portability_provider(a);
    then prohibited_transaction_exempt_4975(a);
