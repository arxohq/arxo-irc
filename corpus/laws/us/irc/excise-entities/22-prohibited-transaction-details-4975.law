}

pub relation d15_not_fiduciary_self_dealing_or_kickback(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(15): the transaction is not one described in (c)(1)(E) or (F)";
}

@source(IRC_S4975_D, coverage = exact, quote = "a merger of multiemployer plans, or the transfer of assets or liabilities between multiemployer plans, determined by the Pension Benefit Guaranty Corporation to meet the requirements of section 4231 of such Act, but this paragraph shall not apply with respect to the application of subsection (c)(1)(E) or (F);")
rule Exemption4975d15(a: ExciseAct) defeasible {
    label en official "section 4975(d)(15): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d15_multiemployer_merger_or_transfer_meeting_erisa_4231(a);
    when d15_not_fiduciary_self_dealing_or_kickback(a);
    unless owner_employee_transaction_4975f6(a) and d15_multiemployer_merger_or_transfer_meeting_erisa_4231(a);
