// Section 4975 — supplements to 10-prohibited-transactions-4975.law (Stage 2, DECISION-0379):
//  - (c)(2) the Secretary's special exemption procedure (a POWER with three findings, notice
//    and, for (c)(1)(E)-(F), a hearing) and (c)(3)-(7) the exemptions of the account holder
//    from the tax;
//  - (d)(1)-(25) the twenty-five exemptions from the prohibitions (generated block at the end);
//  - (e)(2)(E)-(I) the ownership, family, attribution and officer categories of "disqualified
//    person", (e)(3) fiduciary, (e)(4)-(6) attribution and family, (e)(7)-(9) ESOP,
//    qualifying employer security, withdrawal liability funds;
//  - (f)(3) encumbered property, (f)(4)-(5) amount involved and correction, (f)(6) the
//    owner-employee override of the exemptions, (f)(7) S corporation loan repayments,
//    (f)(8) the eligible investment advice arrangement (a conjunction of its requirements),
//    (f)(9)-(12) block trade, adequate consideration, correction period, automatic
//    portability transactions (with the provider's duties);
//  - (g) the exclusions from the section, (h) the Secretary's duty to notify the Secretary of Labor.
//
// WIRING. The classification rule of section 4975(c)(1) and both tax rules of module 10 read
// `prohibited_transaction_exempt_4975(a)` (any (d) paragraph or a (c)(2) exemption granted) and
// `plan_outside_4975g(plan)`; the two tax rules also read `participant_exempt_from_tax_4975c(a, p)`.
// The multi-condition exemptions are conjunctions of case facts: reasonable compensation, adequate
// consideration, adequate security and fair market value are DECISION-0194 judgments whose outcome
// the case supplies (each condition names the judgment in its label).
//
// The (f)(2) taxable period (three candidates, including correction) is section 4975's own and is
// the shared machinery of 01-excise-act-and-taxable-period.law.

// ============================================================================
// (e): plan, disqualified person categories (E)-(I), fiduciary, definitions
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4975_C,
    IRC_S4975_D,
    IRC_S4975_E,
    IRC_S4975_F,
    IRC_S4975_H,
    Notice,
    Person,
    disqualified_person_4975,
    excise_act_kind,
    is_covering_employee_organization_4975,
    is_covering_employer_4975,
    is_fiduciary_4975,
    is_plan,
    is_service_provider_4975,
    member_of_family,
    notice_for_act,
    prohibited_transaction,
    prohibited_transaction_disqualified_person,
    prohibited_transaction_plan,
};

pub relation owner_50_percent_of_employer_or_org_4975E(p: Person, e: Person) kind empirical {
    label en official "section 4975(e)(2)(E): p directly or indirectly owns 50 percent or more of the combined voting power or total value of stock of a corporation, the capital or profits interest of a partnership, or the beneficial interest of a trust or unincorporated enterprise which is the employer (C) or employee organization (D) (indirect stock under section 267(c); partnership and trust interests by 267(c) other than (c)(3); family per (e)(6)) — a lower percentage may be prescribed by regulation";
}
pub relation entity_50_percent_owned_by_dq_persons_4975G(g: Person, plan: Person) kind empirical {
    label en official "section 4975(e)(2)(G): a corporation, partnership, trust or estate 50 percent or more of which is owned directly or indirectly, or held, by persons described in (A)-(E)";
}
pub relation officer_director_10_percent_shareholder_or_hce_4975H(p: Person, q: Person) kind empirical {
    label en official "section 4975(e)(2)(H): p is an officer, director (or similar), a 10 percent or more shareholder, or a highly compensated employee (10 percent or more of the employer's yearly wages) of q, where q is described in (C), (D), (E) or (G)";
}
pub relation partner_or_joint_venturer_10_percent_4975I(p: Person, q: Person) kind empirical {
    label en official "section 4975(e)(2)(I): p is a 10 percent or more (in capital or profits) partner or joint venturer of q, where q is described in (C), (D), (E) or (G)";
}
pub relation category_a_to_e_4975(p: Person, plan: Person) kind institutional {
    label en unofficial "p is described in (e)(2)(A), (B), (C), (D) or (E) — the base of the family and entity categories";
}
rule CategoryAToE4975A(p: Person, plan: Person) defeasible { label en unofficial "(A)"; when is_fiduciary_4975(p, plan); then category_a_to_e_4975(p, plan); }
rule CategoryAToE4975B(p: Person, plan: Person) defeasible { label en unofficial "(B)"; when is_service_provider_4975(p, plan); then category_a_to_e_4975(p, plan); }
rule CategoryAToE4975C(p: Person, plan: Person) defeasible { label en unofficial "(C)"; when is_covering_employer_4975(p, plan); then category_a_to_e_4975(p, plan); }
rule CategoryAToE4975D(p: Person, plan: Person) defeasible { label en unofficial "(D)"; when is_covering_employee_organization_4975(p, plan); then category_a_to_e_4975(p, plan); }
rule CategoryAToE4975E(p: Person, plan: Person, e: Person) defeasible {
    label en unofficial "(E): a 50 percent owner of an employer or employee organization";
    when is_covering_employer_4975(e, plan);
    when owner_50_percent_of_employer_or_org_4975E(p, e);
    then category_a_to_e_4975(p, plan);
}
rule CategoryAToE4975EOrg(p: Person, plan: Person, e: Person) defeasible {
    label en unofficial "(E): a 50 percent owner of an employee organization";
    when is_covering_employee_organization_4975(e, plan);
    when owner_50_percent_of_employer_or_org_4975E(p, e);
    then category_a_to_e_4975(p, plan);
}
@source(IRC_S4975_E, coverage = exact, quote = "a person who is—")
rule DisqualifiedPerson4975ViaOwner(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(E): an owner of 50 percent or more of the employer or employee organization";
    when category_a_to_e_4975(p, plan);
    when owner_of_covering_employer_or_organization(p, plan);
    then disqualified_person_4975(p, plan);
}
pub relation owner_of_covering_employer_or_organization(p: Person, plan: Person) kind institutional {
    label en unofficial "p is a 50 percent owner of a covering employer or employee organization";
}
rule OwnerOfCoveringEmployer(p: Person, plan: Person, e: Person) defeasible { label en unofficial "(E) employer"; when is_covering_employer_4975(e, plan); when owner_50_percent_of_employer_or_org_4975E(p, e); then owner_of_covering_employer_or_organization(p, plan); }
rule OwnerOfCoveringOrganization(p: Person, plan: Person, e: Person) defeasible { label en unofficial "(E) employee organization"; when is_covering_employee_organization_4975(e, plan); when owner_50_percent_of_employer_or_org_4975E(p, e); then owner_of_covering_employer_or_organization(p, plan); }
rule DisqualifiedPerson4975ViaFamily(p: Person, plan: Person, q: Person) defeasible {
    label en official "section 4975(e)(2)(F), (e)(6): a member of the family (spouse, ancestor, lineal descendant, spouse of a lineal descendant) of an individual described in (A), (B), (C) or (E)";
    when category_a_to_e_4975(q, plan);
    when member_of_family(p, q);
    then disqualified_person_4975(p, plan);
}
rule DisqualifiedPerson4975ViaOwnedEntity(g: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(G): an entity 50 percent or more owned by persons described in (A)-(E)";
    when entity_50_percent_owned_by_dq_persons_4975G(g, plan);
    then disqualified_person_4975(g, plan);
}
rule DisqualifiedPerson4975ViaOfficerOrShareholder(p: Person, plan: Person, q: Person) defeasible {
    label en official "section 4975(e)(2)(H): an officer, director, 10 percent shareholder or highly compensated employee of a (C), (D), (E) or (G) person";
    when officer_director_10_percent_shareholder_or_hce_4975H(p, q);
    when disqualified_person_4975_base_for_h_and_i(q, plan);
    then disqualified_person_4975(p, plan);
}
rule DisqualifiedPerson4975ViaPartner(p: Person, plan: Person, q: Person) defeasible {
    label en official "section 4975(e)(2)(I): a 10 percent or more partner or joint venturer of a (C), (D), (E) or (G) person";
    when partner_or_joint_venturer_10_percent_4975I(p, q);
    when disqualified_person_4975_base_for_h_and_i(q, plan);
    then disqualified_person_4975(p, plan);
}
pub relation disqualified_person_4975_base_for_h_and_i(q: Person, plan: Person) kind institutional {
    label en unofficial "q is described in (e)(2)(C), (D), (E) or (G)";
}
rule BaseForHAndIC(q: Person, plan: Person) defeasible { label en unofficial "(C)"; when is_covering_employer_4975(q, plan); then disqualified_person_4975_base_for_h_and_i(q, plan); }
rule BaseForHAndID(q: Person, plan: Person) defeasible { label en unofficial "(D)"; when is_covering_employee_organization_4975(q, plan); then disqualified_person_4975_base_for_h_and_i(q, plan); }
rule BaseForHAndIE(q: Person, plan: Person) defeasible { label en unofficial "(E)"; when owner_of_covering_employer_or_organization(q, plan); then disqualified_person_4975_base_for_h_and_i(q, plan); }
rule BaseForHAndIG(q: Person, plan: Person) defeasible { label en unofficial "(G)"; when entity_50_percent_owned_by_dq_persons_4975G(q, plan); then disqualified_person_4975_base_for_h_and_i(q, plan); }
pub relation withdrawal_liability_trust_501c22(t: Person) kind empirical {
    label en official "section 4975(e)(9)(A): a trust described in section 501(c)(22)";
}
pub relation disqualified_wrt_plan_paid_by_withdrawal_trust(p: Person, t: Person) kind empirical {
    label en official "section 4975(e)(9)(B): the person is a disqualified person with respect to a plan to which the withdrawal liability trust is permitted to make payments under ERISA section 4223";
}
rule DisqualifiedPerson4975WithdrawalLiabilityTrust(p: Person, t: Person) defeasible {
    label en official "section 4975(e)(9)(B)";
    when withdrawal_liability_trust_501c22(t);
    when disqualified_wrt_plan_paid_by_withdrawal_trust(p, t);
    then disqualified_person_4975(p, t);
}
pub relation fiduciary_authority_control_or_advice_4975e3(p: Person, plan: Person) kind empirical {
    label en official "section 4975(e)(3)(A)-(C): the person exercises discretionary authority or control over management of the plan or any authority over management or disposition of its assets, renders investment advice for a fee, or has discretionary responsibility in administration (including a person designated under ERISA 405(c)(1)(B))";
}
@source(IRC_S4975_E, coverage = exact, quote = "the term \"fiduciary\" means any person who—")
rule FiduciaryDefinition4975e3(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(3): a person with authority or control over the plan, an investment adviser for a fee, or with discretionary administrative responsibility is a fiduciary (category (A) of the disqualified persons)";
    when fiduciary_authority_control_or_advice_4975e3(p, plan);
    then category_a_to_e_4975(p, plan);
}
pub relation registered_investment_company_shares_held_by_plan(plan: Person, company: Person) kind empirical {
    label en official "section 4975(e)(8): plan assets are invested in shares of a registered investment company — the company and its adviser or principal underwriter are not thereby fiduciaries or disqualified persons, except for a plan covering their own employees";
}
pub relation plan_covers_employees_of_investment_company_or_adviser(plan: Person, company: Person) kind empirical {
    label en official "section 4975(e)(8): the plan covers employees of the investment company, its investment adviser or principal underwriter";
}
pub relation esop_4975e7_requirements_met(plan: Person) kind institutional {
    label en official "section 4975(e)(7): a defined contribution plan that is a qualified stock bonus plan (or stock bonus and money purchase plans) designed to invest primarily in qualifying employer securities, meeting 409(h), 409(o) and, if applicable, 409(n), 409(p), 664(g) and 409(e) (which relation is imported by section 4978(e)(1) and 4943(d)(4))";
}

// ============================================================================
// (c)(2): the Secretary's special exemption power; (c)(3)-(7): account holder exemptions
// ============================================================================

pub relation exemption_application_for(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4975(c)(2): an exemption is sought for the disqualified person or transaction";
}
pub relation secretary_grants_exemption_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(c)(2): the Secretary grants a conditional or unconditional exemption on this date";
}
pub relation exemption_after_consultation_with_labor(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2): the action is taken after consultation and coordination with the Secretary of Labor";
}
pub relation exemption_administratively_feasible(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2)(A): the Secretary finds the exemption administratively feasible";
}
pub relation exemption_in_interests_of_plan_and_participants(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2)(B): the Secretary finds the exemption in the interests of the plan and its participants and beneficiaries";
}
pub relation exemption_protective_of_participant_rights(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2)(C): the Secretary finds the exemption protective of the rights of participants and beneficiaries";
}
pub relation exemption_notice_given_and_published(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2): adequate notice was given to interested persons, notice of the pendency was published in the Federal Register and interested persons had an opportunity to present views";
}
pub relation exemption_hearing_and_record_findings(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(2): for a (c)(1)(E) or (F) transaction, the Secretary afforded an opportunity for a hearing and determined on the record (or accepted the Secretary of Labor's ERISA 408(a) record)";
}
pub relation transaction_is_fiduciary_self_dealing_or_kickback(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(1)(E) or (F): the transaction is a fiduciary's dealing in his own interest or receipt of consideration for his own account";
}
pub relation exemption_conditions_met(a: ExciseAct) kind institutional {
    label en official "section 4975(c)(2): consultation with the Secretary of Labor, the three findings, notice, and (for (E)/(F)) a hearing";
}
rule ExemptionConditionsMetOrdinary(a: ExciseAct) defeasible {
    label en official "section 4975(c)(2)(A)-(C) and notice, for a transaction other than (c)(1)(E)/(F)";
    when exemption_after_consultation_with_labor(a);
    when exemption_administratively_feasible(a);
    when exemption_in_interests_of_plan_and_participants(a);
    when exemption_protective_of_participant_rights(a);
    when exemption_notice_given_and_published(a);
    unless transaction_is_fiduciary_self_dealing_or_kickback(a) and exemption_notice_given_and_published(a);
    then exemption_conditions_met(a);
}
rule ExemptionConditionsMetFiduciary(a: ExciseAct) defeasible {
    label en official "section 4975(c)(2): for a (c)(1)(E) or (F) transaction a hearing and determination on the record are also required";
    when exemption_after_consultation_with_labor(a);
    when exemption_administratively_feasible(a);
    when exemption_in_interests_of_plan_and_participants(a);
    when exemption_protective_of_participant_rights(a);
    when exemption_notice_given_and_published(a);
    when transaction_is_fiduciary_self_dealing_or_kickback(a);
    when exemption_hearing_and_record_findings(a);
    then exemption_conditions_met(a);
}
pub relation exemption_granted_4975c2(a: ExciseAct) kind institutional {
    label en official "section 4975(c)(2): the Secretary's exemption of the disqualified person or transaction from the restrictions of paragraph (1)";
}
@source(IRC_S4975_C, coverage = exact, quote = "Pursuant to such procedure, he may grant a conditional or unconditional exemption of any disqualified person or transaction, orders of disqualified persons or transactions, from all or part of the restrictions imposed by paragraph (1) of this subsection.")
rule S4975SpecialExemptionPowerRule(a: ExciseAct, p: Person, on: Date) defeasible {
    label en official "section 4975(c)(2): the Secretary may grant an exemption only after consultation, the three findings, notice, and (for (E)/(F)) a hearing; an exemption granted without them is an invalid exercise (E-0239)";
    when exemption_application_for(a, p);
    when secretary_grants_exemption_on(a, on);
    then power S4975GrantSpecialExemption {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_grants_exemption_on(a, on);
        valid_when exemption_conditions_met(a);
        effect create(exemption_granted_4975c2(a));
        window [-infinity, infinity];
    };
}
rule ExemptionGrantedIsExempt(a: ExciseAct) defeasible {
    label en official "section 4975(c)(2): a granted exemption takes the transaction outside the prohibitions";
    when exemption_granted_4975c2(a);
    then prohibited_transaction_exempt_4975(a);
}
pub relation prohibited_transaction_exempt_4975(a: ExciseAct) kind institutional {
    label en official "sections 4975(c)(2), (d): the transaction is exempt from the prohibitions of (c)(1) (a (d) exemption applies or the Secretary granted an exemption)";
}
pub relation owner_employee_transaction_4975f6(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(6): a transaction in which a 401(a) trust of a plan with owner-employees (401(c)(3), including shareholder-employees and IRA participants) lends corpus or income to, pays compensation for personal services to, or acquires property from or sells property to an owner-employee, a family member, or a corporation 50 percent or more owned by an owner-employee";
}
pub relation holder_account_ceases_to_be_ira_408e(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(3): the account ceases to be an IRA by reason of section 408(e)(2)(A) or section 408(e)(4) applies";
}
pub relation section_220e2_applies_to_transaction(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(4): section 220(e)(2) applies to the transaction concerning the Archer MSA";
}
pub relation section_530d_applies_to_transaction(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(5): section 530(d) applies to the transaction concerning the Coverdell education savings account";
}
pub relation account_ceases_to_be_hsa_223e2(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(6): the account ceases to be a health savings account by reason of section 223(e)(2)";
}
pub relation arrangement_satisfies_erisa_408h(a: ExciseAct) kind empirical {
    label en official "section 4975(c)(7): the arrangement satisfies the requirements of ERISA section 408(h) (pharmacy benefit services)";
}
pub relation account_beneficiary_or_contributor(a: ExciseAct, p: Person) kind empirical {
    label en official "sections 4975(c)(3)-(6): p is the individual for whose benefit the IRA, Archer MSA, Coverdell account or HSA is established (and his beneficiaries, or for a Coverdell account any contributor)";
}
pub relation party_to_erisa_408h_arrangement(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4975(c)(7): p is a party to the pharmacy benefit services arrangement";
}
pub relation participant_exempt_from_tax_4975c(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4975(c)(3)-(7): the account holder (or party) is exempt from the section 4975 tax for the transaction";
}
rule ParticipantExemptIra(a: ExciseAct, p: Person) defeasible { label en official "4975(c)(3)"; when account_beneficiary_or_contributor(a, p); when holder_account_ceases_to_be_ira_408e(a); then participant_exempt_from_tax_4975c(a, p); }
rule ParticipantExemptMsa(a: ExciseAct, p: Person) defeasible { label en official "4975(c)(4)"; when account_beneficiary_or_contributor(a, p); when section_220e2_applies_to_transaction(a); then participant_exempt_from_tax_4975c(a, p); }
rule ParticipantExemptCoverdell(a: ExciseAct, p: Person) defeasible { label en official "4975(c)(5)"; when account_beneficiary_or_contributor(a, p); when section_530d_applies_to_transaction(a); then participant_exempt_from_tax_4975c(a, p); }
rule ParticipantExemptHsa(a: ExciseAct, p: Person) defeasible { label en official "4975(c)(6)"; when account_beneficiary_or_contributor(a, p); when account_ceases_to_be_hsa_223e2(a); then participant_exempt_from_tax_4975c(a, p); }
rule ParticipantExemptPharmacy(a: ExciseAct, p: Person) defeasible { label en official "4975(c)(7)"; when party_to_erisa_408h_arrangement(a, p); when arrangement_satisfies_erisa_408h(a); then participant_exempt_from_tax_4975c(a, p); }

// ============================================================================
// (f): special rules
// ============================================================================

pub relation transfer_of_property_by_dq_to_plan(a: ExciseAct) kind empirical {
    label en official "section 4975(f)(3): real or personal property is transferred by a disqualified person to the plan";
}
pub relation property_subject_to_lien_assumed_by_plan(a: ExciseAct) kind empirical {
    label en official "section 4975(f)(3): the property is subject to a mortgage or similar lien which the plan assumes";
}
pub relation lien_placed_by_dq_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(f)(3): the date a disqualified person placed a mortgage or similar lien on the property";
}
pub relation transfer_date_4975f3(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(f)(3): the date of the transfer";
}
pub relation treated_as_sale_or_exchange_4975f3(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(3): the transfer is treated as a sale or exchange (encumbered property)";
}
rule TreatedAsSaleOrExchangeAssumedLien(a: ExciseAct) defeasible {
    label en official "section 4975(f)(3): a lien which the plan assumes";
    when transfer_of_property_by_dq_to_plan(a);
    when property_subject_to_lien_assumed_by_plan(a);
    then treated_as_sale_or_exchange_4975f3(a);
}
rule TreatedAsSaleOrExchangeRecentLien(a: ExciseAct, liened: Date, transferred: Date, calendar_before_1: Date) defeasible {
    label en official "section 4975(f)(3): a lien a disqualified person placed within the 10-year period ending on the date of the transfer";
    when transfer_of_property_by_dq_to_plan(a);
    when lien_placed_by_dq_on(a, liened);
    when transfer_date_4975f3(a, transferred);
    when liened <= transferred;
    when liened >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(transferred, 10, us.irc.core::CalendarYear, calendar_before_1);
    then treated_as_sale_or_exchange_4975f3(a);
}
rule ProhibitedTransactionEncumberedTransfer(a: ExciseAct, p: Person, plan: Person, on: Date) defeasible {
    label en official "section 4975(c)(1)(A), (f)(3): a transfer of encumbered property by a disqualified person to the plan is a sale or exchange, hence a prohibited transaction";
    when excise_act_kind(a, ProhibitedTransaction);
    when treated_as_sale_or_exchange_4975f3(a);
    when prohibited_transaction_disqualified_person(a, p);
    when prohibited_transaction_plan(a, plan);
    when disqualified_person_4975(p, plan);
    when is_plan(plan, on);
    unless prohibited_transaction_exempt_4975(a) and treated_as_sale_or_exchange_4975f3(a);
    then prohibited_transaction(a);
}
pub relation money_and_property_given(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4975(f)(4): the amount of money and the fair market value of the other property given";
}
pub relation money_and_property_received(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4975(f)(4): the amount of money and the fair market value of the other property received";
}
pub relation excess_compensation_for_services_4975f4(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4975(f)(4): for services described in (d)(2) and (d)(10) the amount involved is only the excess compensation";
}
pub relation amount_involved_4975f4(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4975(f)(4): the greater of the money and property given and received (for (d)(2)/(d)(10) services, only the excess compensation); valued at the transaction date for (a) and at the highest value in the taxable period for (b)";
}
rule AmountInvolved4975f4(a: ExciseAct, g: Money, r: Money) defeasible {
    label en official "section 4975(f)(4): max(given, received)";
    when money_and_property_given(a, g);
    when money_and_property_received(a, r);
    unless excess_compensation_for_services_4975f4(a, _) and money_and_property_given(a, g) and money_and_property_received(a, r);
    then amount_involved_4975f4(a, max(g, r));
}
rule AmountInvolved4975f4Services(a: ExciseAct, x: Money) defeasible {
    label en official "section 4975(f)(4): only the excess compensation for services described in (d)(2) and (d)(10)";
    when excess_compensation_for_services_4975f4(a, x);
    then amount_involved_4975f4(a, x);
}
pub relation correction_undoes_transaction_and_meets_fiduciary_standard_4975f5(a: ExciseAct) kind empirical {
    label en official "section 4975(f)(5): the transaction is undone to the extent possible and the plan is placed in a financial position not worse than if the disqualified person acted under the highest fiduciary standards (the case asserts the correction date as `act_corrected_on` once this holds)";
}
pub relation s_corp_distribution_used_for_loan_payments_4975f7(plan: Person) kind empirical {
    label en official "section 4975(f)(7): a distribution on S corporation stock that is qualifying employer securities is used under the plan provisions to make payments on a (d)(3) loan (not treated as a prohibited transaction; for allocated securities the plan must allocate securities of at least equal fair market value to the participant)";
}
pub relation allocated_securities_of_equal_value_provided_4975f7(plan: Person) kind empirical {
    label en official "section 4975(f)(7): for a distribution on allocated employer securities, the plan provides for allocation to the participant of employer securities with a fair market value not less than the distribution";
}
pub relation s_corp_loan_repayment_not_prohibited_4975f7(plan: Person) kind institutional {
    label en official "section 4975(f)(7): the S corporation distribution used for loan payments is not a prohibited transaction for (d)(3)";
}
rule SCorpLoanRepaymentNotProhibited(plan: Person) defeasible {
    label en official "section 4975(f)(7)";
    when s_corp_distribution_used_for_loan_payments_4975f7(plan);
    when allocated_securities_of_equal_value_provided_4975f7(plan);
    then s_corp_loan_repayment_not_prohibited_4975f7(plan);
}
// (f)(8): eligible investment advice arrangement — a conjunction of its requirements.
pub relation advice_fees_do_not_vary_by_option_or_computer_model_program(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(B)(i): fees do not vary by the investment option selected, or a certified computer model program is used (C)";
}
pub relation advice_separate_fiduciary_authorization(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(D): the arrangement is expressly authorized by a plan fiduciary other than the adviser, an option provider, or their affiliates";
}
pub relation advice_annual_independent_audit_and_report(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(E): an independent auditor conducts an annual audit and reports findings to the authorizing fiduciary (Secretary of Labor's schedule for IRAs)";
}
pub relation advice_disclosure_requirements_met(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(F), (H): the required written notification before the initial advice and the ongoing information, in the required presentation";
}
pub relation advice_other_conditions_met(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(G): appropriate securities-law disclosure, transaction solely at the recipient's direction, reasonable compensation, terms at least as favorable as arm's length";
}
pub relation advice_records_maintained_six_years(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(I): the fiduciary adviser maintains the records for not less than 6 years";
}
rule EligibleInvestmentAdviceArrangement(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(A)-(I): an arrangement meeting (B)(i) and (D)-(I) satisfies (f)(8)";
    when advice_fees_do_not_vary_by_option_or_computer_model_program(a);
    when advice_separate_fiduciary_authorization(a);
    when advice_annual_independent_audit_and_report(a);
    when advice_disclosure_requirements_met(a);
    when advice_other_conditions_met(a);
    when advice_records_maintained_six_years(a);
    then d17_eligible_investment_advice_arrangement_f8(a);
}
// (f)(9)-(10): block trade and adequate consideration.
pub relation trade_shares_and_value(a: ExciseAct, shares: Integer, value: Money, unrelated_client_accounts: Integer) kind empirical {
    label en official "section 4975(f)(9): the number of shares, the market value, and the number of unrelated client accounts the trade is allocated across";
}
pub relation block_trade_4975f9(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(9): a trade of at least 10,000 shares or with a market value of at least $200,000 allocated across two or more unrelated client accounts of a fiduciary";
}
rule BlockTradeBySharesOrValue(a: ExciseAct, sh: Integer, v: Money, n: Integer) defeasible {
    label en official "section 4975(f)(9): 10,000 shares or $200,000 market value, across at least two unrelated accounts";
    when trade_shares_and_value(a, sh, v, n);
    when n >= 2;
    when sh >= 10000;
    then block_trade_4975f9(a);
}
rule BlockTradeByValue(a: ExciseAct, sh: Integer, v: Money, n: Integer) defeasible {
    label en official "section 4975(f)(9): market value of at least $200,000";
    when trade_shares_and_value(a, sh, v, n);
    when n >= 2;
    when v >= 200000.00 USD;
    then block_trade_4975f9(a);
}
rule Block18FromBlockTrade(a: ExciseAct) defeasible { label en official "(d)(18)(A): the transaction involves a block trade (f)(9)"; when block_trade_4975f9(a); then d18_block_trade(a); }
pub relation adequate_consideration_4975f10(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(10): adequate consideration — for a security with a generally recognized market, the exchange price (or independent bid and asked quotations) taking into account size and marketability; otherwise fair market value determined in good faith by a fiduciary under Secretary of Labor regulations";
}
// (f)(11): correction period of (d)(23).
pub relation dq_discovered_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(f)(11)(A): the date the disqualified person discovers, or reasonably should have discovered, that the transaction would constitute a prohibited transaction";
}
pub relation correction_period_end_4975f11(a: ExciseAct, on: Date) kind institutional {
    label en official "section 4975(f)(11)(A): the 14-day period beginning on the discovery date";
}
rule CorrectionPeriodEnd4975f11(a: ExciseAct, disc: Date) defeasible {
    label en official "section 4975(f)(11)(A): 14 days beginning on the discovery date, so the last day is the 13th day after it";
    when dq_discovered_on(a, disc);
    then correction_period_end_4975f11(a, add_calendar_period(disc, 13 calendar_day));
}
pub relation employer_security_or_real_property_with_plan_sponsor(a: ExciseAct) kind empirical {
    label en official "section 4975(f)(11)(B)(i): the transaction is between the plan and the plan sponsor or its affiliates and involves the acquisition or sale of an employer security or the acquisition, sale or lease of employer real property (ERISA 407(d))";
}
pub relation dq_knew_transaction_would_be_prohibited(a: ExciseAct) kind empirical {
    label en official "section 4975(f)(11)(B)(ii): at the time of the transaction the disqualified person knew (or reasonably should have known) that it would constitute a prohibited transaction";
}
pub relation d23_available_4975f11(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(11)(B): paragraph (d)(23) is available (not for employer securities or real property with the sponsor, nor where the disqualified person knew)";
}
rule D23Available(a: ExciseAct) defeasible {
    label en official "section 4975(f)(11)(B)";
    when d23_corrected_before_end_of_correction_period(a);
    unless employer_security_or_real_property_with_plan_sponsor(a) and d23_corrected_before_end_of_correction_period(a);
    unless dq_knew_transaction_would_be_prohibited(a) and d23_corrected_before_end_of_correction_period(a);
    then d23_available_4975f11(a);
}
// (f)(12): automatic portability transaction — the provider's obligations as duties.
pub relation portability_provider(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(A)(ii): the automatic portability provider — a person other than an individual who executes the transfers";
}
pub relation portability_transaction_date(txn: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(f)(12)(A)(i): the date of the automatic portability transaction";
}
pub relation portability_pre_transaction_notice_given(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(v): notice given at least 60 days before the transaction describing it, all fees, the right to opt out, the deadline and procedures, the beneficiary designation right, and other required disclosures";
}
pub relation portability_post_transaction_notice_given(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(vi): notice given not later than 3 business days after the transaction (actions, location and amount of assets, fees, a telephone number, other disclosures)";
}
pub relation portability_written_fiduciary_acknowledgment(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(i): the provider acknowledged in writing that it is a fiduciary with respect to the individual retirement plan";
}
pub relation portability_records_kept_six_years(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(xi)(I): the provider maintains records demonstrating compliance for not less than 6 years and produces them within 30 calendar days of a written request";
}
pub relation portability_annual_audit_submitted(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(xi)(II): the provider conducted the annual audit and submitted it to the Secretary of Labor";
}
pub relation portability_monthly_search_made(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(viii): the provider queries at least monthly whether individuals with the individual retirement plans have an account in a plan described in (A)(i)(II)";
}
pub relation portability_website_maintained(p: Person, txn: ExciseAct) kind empirical {
    label en official "section 4975(f)(12)(B)(xii): the provider maintains a website with the list of recordkeepers and the fees paid to it";
}
@source(IRC_S4975_F, coverage = exact, quote = "At least 60 days in advance of an automatic portability transaction, the automatic portability provider shall provide notice to the individual")
rule S4975PortabilityPreNoticeDutyRule(p: Person, txn: ExciseAct, on: Date, calendar_before_1: Date) defeasible {
    label en official "section 4975(f)(12)(B)(v): the provider shall give the individual notice at least 60 days before the transaction";
    when portability_provider(p, txn);
    when portability_transaction_date(txn, on)
        and us.irc.core::civil_calendar_boundary_before(on, 60, us.irc.core::CalendarDay, calendar_before_1);
    then duty S4975PortabilityPreTransactionNotice {
        bearer p;
        goal achievement {
            condition portability_pre_transaction_notice_given(p, txn);
            window [-infinity, calendar_before_1];
        }
    };
}
@source(IRC_S4975_F, coverage = exact, quote = "Not later than 3 business days after an automatic portability transaction, the automatic portability provider shall provide notice to the individual")
pub relation portability_post_notice_deadline(txn: ExciseAct, on: Date) kind empirical {
    label en official "section 4975(f)(12)(B)(vi): the last of the 3 business days after the transaction (business-day counting needs the federal calendar snapshot of us.irc.administration, which this package does not pin — G2524)";
}
rule S4975PortabilityPostNoticeDutyRule(p: Person, txn: ExciseAct, on: Date, deadline: Date) defeasible {
    label en official "section 4975(f)(12)(B)(vi): the provider shall give the individual notice not later than 3 business days after the transaction";
    when portability_provider(p, txn);
    when portability_transaction_date(txn, on);
    when portability_post_notice_deadline(txn, deadline);
    then duty S4975PortabilityPostTransactionNotice {
        bearer p;
        goal achievement {
            condition portability_post_transaction_notice_given(p, txn);
            window [on, deadline];
        }
    };
}
@source(IRC_S4975_F, coverage = exact, quote = "An automatic portability provider shall, for not less than 6 years after the automatic portability transaction has occurred, maintain the records sufficient to demonstrate the terms of this subparagraph have been met.")
rule S4975PortabilityRecordsDutyRule(p: Person, txn: ExciseAct, on: Date) defeasible {
    label en official "section 4975(f)(12)(B)(xi)(I): the provider shall maintain the records for not less than 6 years after the transaction";
    when portability_provider(p, txn);
    when portability_transaction_date(txn, on);
    then duty S4975PortabilityKeepRecords {
        bearer p;
        goal maintenance {
            condition portability_records_kept_six_years(p, txn);
            window [on, add_calendar_period(on, 6 calendar_year)];
        }
    };
}
@source(IRC_S4975_F, coverage = exact, quote = "An automatic portability provider shall conduct an annual audit, in accordance with regulations promulgated by the Secretary of Labor, of automatic portability transactions occurring during the calendar year")
rule S4975PortabilityAuditDutyRule(p: Person, txn: ExciseAct, on: Date) defeasible {
    label en official "section 4975(f)(12)(B)(xi)(II): the provider shall conduct an annual audit and submit it to the Secretary of Labor";
    when portability_provider(p, txn);
    when portability_transaction_date(txn, on);
    then duty S4975PortabilityAnnualAudit {
        bearer p;
        goal achievement {
            condition portability_annual_audit_submitted(p, txn);
            window [on, infinity];
        }
    };
}
rule D25PortabilityConditionsMet(txn: ExciseAct, p: Person) defeasible {
    label en official "section 4975(f)(12)(B): the (d)(25) exemption is available only if the provider's acknowledgment, fee, notice, search, record and website requirements are met";
    when portability_provider(p, txn);
    when portability_written_fiduciary_acknowledgment(p, txn);
    when portability_pre_transaction_notice_given(p, txn);
    when portability_post_transaction_notice_given(p, txn);
    when portability_monthly_search_made(p, txn);
    when portability_records_kept_six_years(p, txn);
    when portability_website_maintained(p, txn);
    then d25_f12_conditions_met(txn);
}
// --- (d): the 25 exemptions. Each paragraph is a defeasible rule whose elements are the paragraph's own conditions, asserted by the case;
// the (f)(6) owner-employee override removes every paragraph except (d)(9) and (d)(12). Evaluative parts (reasonable compensation, adequate consideration, adequate security, fair market value) are folded into the
// asserted condition facts and are named in the coverage rows (DECISION-0194: the case supplies the outcome of the judgment channel). ---

pub relation d1_available_to_all_on_equivalent_basis(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(1): (A) the loan is available to all participants or beneficiaries on a reasonably equivalent basis";
}

pub relation d1_not_greater_for_highly_compensated(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(1): (B) the loan is not made available to highly compensated employees (414(q)) in an amount greater than to other employees";
}

pub relation d1_made_under_plan_loan_provisions(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(1): (C) the loan is made in accordance with specific provisions regarding such loans set forth in the plan";
}

pub relation d1_reasonable_interest_rate(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(1): (D) the loan bears a reasonable rate of interest";
}

pub relation d1_adequately_secured(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(1): (E) the loan is adequately secured";
}

@source(IRC_S4975_D, coverage = exact, quote = "any loan made by the plan to a disqualified person who is a participant or beneficiary of the plan if such loan—")
rule Exemption4975d1(a: ExciseAct) defeasible {
    label en official "section 4975(d)(1): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d1_available_to_all_on_equivalent_basis(a);
    when d1_not_greater_for_highly_compensated(a);
    when d1_made_under_plan_loan_provisions(a);
    when d1_reasonable_interest_rate(a);
    when d1_adequately_secured(a);
    unless owner_employee_transaction_4975f6(a) and d1_available_to_all_on_equivalent_basis(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d2_office_space_or_services_necessary(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(2): the contract or arrangement is for office space or legal, accounting or other services necessary for the establishment or operation of the plan";
}

pub relation d2_no_more_than_reasonable_compensation(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(2): no more than reasonable compensation is paid";
}

@source(IRC_S4975_D, coverage = exact, quote = "any contract, or reasonable arrangement, made with a disqualified person for office space, or legal, accounting, or other services necessary for the establishment or operation of the plan, if no more than reasonable compensation is paid therefor;")
rule Exemption4975d2(a: ExciseAct) defeasible {
    label en official "section 4975(d)(2): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d2_office_space_or_services_necessary(a);
    when d2_no_more_than_reasonable_compensation(a);
    unless owner_employee_transaction_4975f6(a) and d2_office_space_or_services_necessary(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d3_primarily_for_participants_benefit(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(3): (A) the loan is primarily for the benefit of participants and beneficiaries of the plan";
}

pub relation d3_reasonable_rate_and_collateral_only_employer_securities(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(3): (B) the loan is at a reasonable rate of interest and any collateral given to a disqualified person by the plan consists only of qualifying employer securities";
}

@source(IRC_S4975_D, coverage = exact, quote = "any loan to a leveraged employee stock ownership plan (as defined in subsection (e)(7)), if—")
rule Exemption4975d3(a: ExciseAct) defeasible {
    label en official "section 4975(d)(3): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d3_primarily_for_participants_benefit(a);
    when d3_reasonable_rate_and_collateral_only_employer_securities(a);
    unless owner_employee_transaction_4975f6(a) and d3_primarily_for_participants_benefit(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d4_deposits_reasonable_rate_in_supervised_fiduciary_bank(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(4): the plan assets are invested in deposits bearing a reasonable interest rate in a supervised bank or similar institution that is a fiduciary of the plan";
}

pub relation d4_plan_covers_only_bank_employees_or_expressly_authorized(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(4): (A) the plan covers only employees of the bank and its affiliates, or (B) the investment is expressly authorized by the plan or by an independent fiduciary expressly empowered to instruct the trustee";
}

@source(IRC_S4975_D, coverage = exact, quote = "the investment of all or part of a plan's assets in deposits which bear a reasonable interest rate in a bank or similar financial institution supervised by the United States or a State, if such bank or other institution is a fiduciary of such plan and if—")
rule Exemption4975d4(a: ExciseAct) defeasible {
    label en official "section 4975(d)(4): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d4_deposits_reasonable_rate_in_supervised_fiduciary_bank(a);
    when d4_plan_covers_only_bank_employees_or_expressly_authorized(a);
    unless owner_employee_transaction_4975f6(a) and d4_deposits_reasonable_rate_in_supervised_fiduciary_bank(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d5_insurers_qualified_and_adequate_consideration(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(5): the contract is with insurers qualified to do business in a State and the plan pays no more than adequate consideration";
}

pub relation d5_insurer_is_employer_or_wholly_owned_within_5_percent_limit(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(5): (A) the insurer is the employer maintaining the plan, or (B) a wholly owned disqualified person whose premiums for such plans do not exceed 5 percent of its total premiums";
}

@source(IRC_S4975_D, coverage = exact, quote = "any contract for life insurance, health insurance, or annuities with one or more insurers which are qualified to do business in a State if the plan pays no more than adequate consideration, and if each such insurer or insurers is—")
rule Exemption4975d5(a: ExciseAct) defeasible {
    label en official "section 4975(d)(5): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d5_insurers_qualified_and_adequate_consideration(a);
    when d5_insurer_is_employer_or_wholly_owned_within_5_percent_limit(a);
    unless owner_employee_transaction_4975f6(a) and d5_insurers_qualified_and_adequate_consideration(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d6_ancillary_service_reasonable_compensation_by_fiduciary_bank(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(6): the ancillary service is provided by a supervised bank that is a fiduciary of the plan at not more than reasonable compensation";
}

pub relation d6_adequate_internal_safeguards(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(6): (A) the bank has adopted adequate internal safeguards consistent with sound banking and financial practice";
}

pub relation d6_guidelines_not_excessive_or_against_participants(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(6): (B) specific guidelines apply and the service is not provided in an excessive or unreasonable manner or inconsistently with participants' best interests";
}

@source(IRC_S4975_D, coverage = exact, quote = "the provision of any ancillary service by a bank or similar financial institution supervised by the United States or a State, if such service is provided at not more than reasonable compensation, if such bank or other institution is a fiduciary of such plan, and if—")
rule Exemption4975d6(a: ExciseAct) defeasible {
    label en official "section 4975(d)(6): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d6_ancillary_service_reasonable_compensation_by_fiduciary_bank(a);
    when d6_adequate_internal_safeguards(a);
    when d6_guidelines_not_excessive_or_against_participants(a);
    unless owner_employee_transaction_4975f6(a) and d6_ancillary_service_reasonable_compensation_by_fiduciary_bank(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d7_conversion_privilege_within_regulations(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(7): the exercise of a privilege to convert securities, to the extent provided in regulations";
}

pub relation d7_plan_receives_adequate_consideration(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(7): the plan receives no less than adequate consideration";
}

@source(IRC_S4975_D, coverage = exact, quote = "the exercise of a privilege to convert securities, to the extent provided in regulations of the Secretary, but only if the plan receives no less than adequate consideration pursuant to such conversion;")
rule Exemption4975d7(a: ExciseAct) defeasible {
    label en official "section 4975(d)(7): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d7_conversion_privilege_within_regulations(a);
    when d7_plan_receives_adequate_consideration(a);
    unless owner_employee_transaction_4975f6(a) and d7_conversion_privilege_within_regulations(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d8_sale_or_purchase_of_interest_in_pooled_fund(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(8): (A) the transaction is a sale or purchase of an interest in the fund";
}

pub relation d8_not_more_than_reasonable_compensation(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(8): (B) the bank, trust company or insurance company receives not more than reasonable compensation";
}

pub relation d8_expressly_permitted_by_plan_or_independent_fiduciary(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(8): (C) the transaction is expressly permitted by the plan instrument or by an independent fiduciary with authority to manage and control the plan assets";
}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction between a plan and a common or collective trust fund or pooled investment fund maintained by a disqualified person which is a bank or trust company supervised by a State or Federal agency or between a plan and a pooled investment fund of an insurance company qualified to do business in a State if—")
rule Exemption4975d8(a: ExciseAct) defeasible {
    label en official "section 4975(d)(8): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d8_sale_or_purchase_of_interest_in_pooled_fund(a);
    when d8_not_more_than_reasonable_compensation(a);
    when d8_expressly_permitted_by_plan_or_independent_fiduciary(a);
    unless owner_employee_transaction_4975f6(a) and d8_sale_or_purchase_of_interest_in_pooled_fund(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d9_benefit_entitled_as_participant(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(9): the disqualified person receives a benefit to which he is entitled as a participant or beneficiary";
}

pub relation d9_computed_and_paid_consistently_with_plan_terms(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(9): the benefit is computed and paid consistently with the plan terms as applied to all other participants and beneficiaries";
}

@source(IRC_S4975_D, coverage = exact, quote = "receipt by a disqualified person of any benefit to which he may be entitled as a participant or beneficiary in the plan, so long as the benefit is computed and paid on a basis which is consistent with the terms of the plan as applied to all other participants and beneficiaries;")
rule Exemption4975d9(a: ExciseAct) defeasible {
    label en official "section 4975(d)(9): the exemption applies when all its conditions are met ((f)(6) does not remove this paragraph)";
    when d9_benefit_entitled_as_participant(a);
    when d9_computed_and_paid_consistently_with_plan_terms(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d10_reasonable_compensation_or_expense_reimbursement(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(10): the disqualified person receives reasonable compensation for services rendered, or reimbursement of expenses properly and actually incurred, in the performance of duties with the plan";
}

pub relation d10_not_already_receiving_full_time_pay_from_plan_employer_or_union(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(10): the person does not already receive full-time pay from an employer (or association) whose employees participate, or from an employee organization whose members participate (except expense reimbursement)";
}

@source(IRC_S4975_D, coverage = exact, quote = "receipt by a disqualified person of any reasonable compensation for services rendered, or for the reimbursement of expenses properly and actually incurred, in the performance of his duties with the plan")
rule Exemption4975d10(a: ExciseAct) defeasible {
    label en official "section 4975(d)(10): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d10_reasonable_compensation_or_expense_reimbursement(a);
    when d10_not_already_receiving_full_time_pay_from_plan_employer_or_union(a);
    unless owner_employee_transaction_4975f6(a) and d10_reasonable_compensation_or_expense_reimbursement(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d11_dual_service_as_fiduciary_and_representative(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(11): a disqualified person serves as a fiduciary in addition to being an officer, employee, agent or other representative of a disqualified person";
}

@source(IRC_S4975_D, coverage = exact, quote = "service by a disqualified person as a fiduciary in addition to being an officer, employee, agent, or other representative of a disqualified person;")
rule Exemption4975d11(a: ExciseAct) defeasible {
    label en official "section 4975(d)(11): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d11_dual_service_as_fiduciary_and_representative(a);
    unless owner_employee_transaction_4975f6(a) and d11_dual_service_as_fiduciary_and_representative(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d12_distribution_per_plan_terms_and_erisa_4044_allocation(a: ExciseAct) kind empirical {
