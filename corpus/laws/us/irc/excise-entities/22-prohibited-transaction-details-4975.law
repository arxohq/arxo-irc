// ============================================================================
// (g), (h): application and the Secretary's duty to notify the Secretary of Labor
// ============================================================================

pub relation plan_has_guaranteed_benefit_policy_assets(plan: Person) kind empirical {
    label en official "section 4975(g)(1): the assets of the insurance company, insurance service or insurance organization that issued a guaranteed benefit policy (ERISA 401(b)(2)(B)) to the plan, merely because of the policy";
}
pub relation governmental_plan_4975g2(plan: Person) kind empirical {
    label en official "section 4975(g)(2): a governmental plan (section 414(d))";
}
pub relation church_plan_without_410d_election_4975g3(plan: Person) kind empirical {
    label en official "section 4975(g)(3): a church plan (section 414(e)) with respect to which the 410(d) election has not been made";
}
pub relation plan_outside_4975g(plan: Person) kind institutional {
    label en official "section 4975(g): the section does not apply to a governmental plan, a church plan without the election, or (for the issuer of a guaranteed benefit policy) its own assets";
}
rule PlanOutside4975gGovernmental(plan: Person) defeasible { label en official "4975(g)(2)"; when governmental_plan_4975g2(plan); then plan_outside_4975g(plan); }
rule PlanOutside4975gChurch(plan: Person) defeasible { label en official "4975(g)(3)"; when church_plan_without_410d_election_4975g3(plan); then plan_outside_4975g(plan); }
rule PlanOutside4975gInsurerAssets(plan: Person) defeasible { label en official "4975(g)(1)"; when plan_has_guaranteed_benefit_policy_assets(plan); then plan_outside_4975g(plan); }
pub relation secretary_notified_labor_before_deficiency_notice_4975h(a: ExciseAct) kind empirical {
    label en official "section 4975(h): before sending the notice of deficiency the Secretary notified the Secretary of Labor and provided a reasonable opportunity to obtain a correction of the prohibited transaction or to comment on the tax";
}
@source(IRC_S4975_H, coverage = exact, quote = "Before sending a notice of deficiency with respect to the tax imposed by subsection (a) or (b), the Secretary shall notify the Secretary of Labor and provide him a reasonable opportunity to obtain a correction of the prohibited transaction or to comment on the imposition of such tax.")
rule S4975hNotifyLaborDutyRule(a: ExciseAct, n: Notice, mailed: Date) defeasible {
    label en official "section 4975(h): before sending a notice of deficiency the Secretary shall notify the Secretary of Labor";
    when prohibited_transaction(a);
    when notice_for_act(n, a);
    when us.irc.core::mailed_on(n, mailed);
    then duty S4975hNotifySecretaryOfLabor {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_notified_labor_before_deficiency_notice_4975h(a);
            window [-infinity, mailed];
        }
    };
}
