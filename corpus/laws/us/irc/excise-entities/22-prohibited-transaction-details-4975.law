}

@source(IRC_S4975_D, coverage = exact, quote = "the making by a fiduciary of a distribution of the assets of the trust in accordance with the terms of the plan if such assets are distributed in the same manner as provided under section 4044 of title IV of the Employee Retirement Income Security Act of 1974 (relating to allocation of assets);")
rule Exemption4975d12(a: ExciseAct) defeasible {
    label en official "section 4975(d)(12): the exemption applies when all its conditions are met ((f)(6) does not remove this paragraph)";
    when d12_distribution_per_plan_terms_and_erisa_4044_allocation(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d13_exempt_from_erisa_406_by_408e_or_408b12(a: ExciseAct) kind empirical {
