}

pub relation d14_not_fiduciary_self_dealing_or_kickback(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(14): the transaction is not one described in (c)(1)(E) or (F)";
}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction required or permitted under part 1 of subtitle E of title IV or section 4223 of the Employee Retirement Income Security Act of 1974, but this paragraph shall not apply with respect to the application of subsection (c)(1) (E) or (F);")
rule Exemption4975d14(a: ExciseAct) defeasible {
    label en official "section 4975(d)(14): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d14_required_or_permitted_under_erisa_title_iv_part_1_or_4223(a);
    when d14_not_fiduciary_self_dealing_or_kickback(a);
    unless owner_employee_transaction_4975f6(a) and d14_required_or_permitted_under_erisa_title_iv_part_1_or_4223(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d15_multiemployer_merger_or_transfer_meeting_erisa_4231(a: ExciseAct) kind empirical {
