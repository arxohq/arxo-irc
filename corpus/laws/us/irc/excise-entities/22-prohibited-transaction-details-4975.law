}

pub relation d16_sale_at_appraised_fair_market_value_on_favorable_terms(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(16): (D) the sale is for fair market value established by an independent appraiser on terms at least as favorable as to an unrelated party";
}

pub relation d16_trust_pays_no_commissions_or_expenses(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(16): (E) the trust pays no commissions, costs or other expenses in connection with the sale";
}

pub relation d16_single_cash_transaction_within_120_days(a: ExciseAct) kind empirical {
    label en official "section 4975(d)(16): (F) the stock is sold in a single transaction for cash not later than 120 days after the S corporation election";
}

@source(IRC_S4975_D, coverage = exact, quote = "a sale of stock held by a trust which constitutes an individual retirement account under section 408(a) to the individual for whose benefit such account is established if—")
rule Exemption4975d16(a: ExciseAct) defeasible {
    label en official "section 4975(d)(16): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d16_stock_in_bank_or_depository_holding_company(a);
    when d16_stock_held_at_enactment_date(a);
    when d16_sale_pursuant_to_s_corporation_election(a);
    when d16_sale_at_appraised_fair_market_value_on_favorable_terms(a);
    when d16_trust_pays_no_commissions_or_expenses(a);
    when d16_single_cash_transaction_within_120_days(a);
    unless owner_employee_transaction_4975f6(a) and d16_stock_in_bank_or_depository_holding_company(a);
    then prohibited_transaction_exempt_4975(a);
}

pub relation d17_transaction_in_connection_with_investment_advice_to_directing_participant(a: ExciseAct) kind empirical {
