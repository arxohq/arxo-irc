}

@source(IRC_S4975_D, coverage = exact, quote = "any transaction in connection with the provision of investment advice described in subsection (e)(3)(B) to a participant or beneficiary in a plan that permits such participant or beneficiary to direct the investment of plan assets in an individual account, if—")
rule Exemption4975d17(a: ExciseAct) defeasible {
    label en official "section 4975(d)(17): the exemption applies when all its conditions are met (not to an owner-employee transaction, (f)(6))";
    when d17_transaction_in_connection_with_investment_advice_to_directing_participant(a);
