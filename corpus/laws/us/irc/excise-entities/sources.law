// 26 U.S.C. §4979 — statutory note 5 (effectivedate-note)
fragment IRC_S4979_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/4979/note/5";
    text en official """Effective Date
Section applicable to plan years beginning after Dec. 31, 1986, with special provisions for plans maintained pursuant to collective bargaining agreements ratified before Mar. 1, 1986, and for annuity contracts under section 403(b) of this title, see section 1117(d) of Pub. L. 99–514, set out as an Effective Date of 1986 Amendment note under section 401 of this title.""";
    content_hash "sha256:6f8491059fbded2f266cb3aa39234090ce62155ece5e5bf0d0d2b9ced67f4c1c";
}

// 26 U.S.C. 4980(a) — Tax on reversion of qualified plan assets to employer
fragment IRC_S4980_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4980/a";
    text en official """(a) Imposition of tax
There is hereby imposed a tax of 20 percent of the amount of any employer reversion from a qualified plan.""";
    content_hash "sha256:347a577f85a89c4172f8f4baf2f848dcadb552d8d0f84f36d2936d06cd7a7897";
}

// 26 U.S.C. 4980(b) — Tax on reversion of qualified plan assets to employer
fragment IRC_S4980_B in IRC_2024_EDITION {
