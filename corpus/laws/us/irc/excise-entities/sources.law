// 26 U.S.C. §4972 — statutory note 10 (terminationdate-note)
fragment IRC_S4972_NOTE_10 in IRC_2024_EDITION {
    kind note;
    locator "section/4972/note/10";
    text en official """Increase in Amount for Plan Termination Insurance Under Employee Retirement Insurance Security Act of 1974
