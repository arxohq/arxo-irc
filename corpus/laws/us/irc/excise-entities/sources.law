// 26 U.S.C. 4977(a) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/a";
    text en official """(a) Imposition of tax
In the case of an employer to whom an election under this section applies for any calendar year, there is hereby imposed a tax for such calendar year equal to 30 percent of the excess fringe benefits.""";
    content_hash "sha256:1612e9af26bb09a580027022f1f0d14e66cc933535c6413b9466ffc20d81ed11";
}

// 26 U.S.C. 4977(b) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/b";
    text en official """(b) Excess fringe benefits
For purposes of subsection (a), the term "excess fringe benefits" means, with respect to any calendar year—
(1) the aggregate value of the fringe benefits provided by the employer during the calendar year which were not includible in gross income under paragraphs (1) and (2) of section 132(a), over
(2) 1 percent of the aggregate amount of compensation—
(A) which was paid by the employer during such calendar year to employees, and
(B) was includible in gross income for purposes of chapter 1.""";
    content_hash "sha256:ccf1ed5fb38c97c6b29d016435497393525d55e673de93b42a1069570b355542";
}

// 26 U.S.C. 4977(c) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/c";
    text en official """(c) Effect of election on section 132(a)
If—
(1) an election under this section is in effect with respect to an employer for any calendar year, and
(2) at all times on or after January 1, 1984, and before the close of the calendar year involved, substantially all of the employees of the employer were entitled to employee discounts on goods or services provided by the employer in 1 line of business,
for purposes of paragraphs (1) and (2) of section 132(a) (but not for purposes of section 132(h)), all employees of any line of business of the employer which was in existence on January 1, 1984, shall be treated as employees of the line of business referred to in paragraph (2).""";
    content_hash "sha256:c0c4164d6f17e8fda0f53ea261b3c92d12610ec6298b79210da4165958f2303d";
}

// 26 U.S.C. 4977(d) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/d";
    text en official """(d) Period of election
An election under this section shall apply to the calendar year for which made and all subsequent calendar years unless revoked by the employer.""";
    content_hash "sha256:76e7d5c366a5f0848ff90f7658d29425d3a77408fa100de4520232fa36e35461";
}

// 26 U.S.C. 4977(e) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_E in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/e";
    text en official """(e) Treatment of controlled groups
All employees treated as employed by a single employer under subsection (b), (c), or (m) of section 414 shall be treated as employed by a single employer for purposes of this section.""";
    content_hash "sha256:960e57eb4c9ea87ec2e80de35b75d1ce0e5f0c4f8e0060b26f1e34ecf7e154f3";
}

// 26 U.S.C. 4977(f) — Tax on certain fringe benefits provided by an employer
fragment IRC_S4977_F in IRC_2024_EDITION {
    kind subsection;
    locator "section/4977/f";
    text en official """(f) Section to apply only to employment within the United States
Except as otherwise provided in regulations, this section shall apply only with respect to employment within the United States.""";
    content_hash "sha256:1ea2f370489835684c02b627b8f5d14232040d0100eaf85b06beafd90e424798";
}

// 26 U.S.C. §4977 — statutory note 4 (effectivedate-amendment-note)
