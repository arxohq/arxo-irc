// 26 U.S.C. 4999(a) — Golden parachute payments
fragment IRC_S4999_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4999/a";
    text en official """(a) Imposition of tax
There is hereby imposed on any person who receives an excess parachute payment a tax equal to 20 percent of the amount of such payment.""";
    content_hash "sha256:a06b7ced8fdcaeccaad66164ee99f29c742d098c1db898a1014ce80081369194";
}

// 26 U.S.C. 4999(b) — Golden parachute payments
fragment IRC_S4999_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4999/b";
    text en official """(b) Excess parachute payment defined
For purposes of this section, the term "excess parachute payment" has the meaning given to such term by section 280G(b).""";
    content_hash "sha256:5e8b1c68fcc86c60716ab09d7a9eb12ced23dd0d66595929794acb45d1c399a5";
}

// 26 U.S.C. 4999(c) — Golden parachute payments
fragment IRC_S4999_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4999/c";
    text en official """(c) Administrative provisions
(1) Withholding
In the case of any excess parachute payment which is wages (within the meaning of section 3401) the amount deducted and withheld under section 3402 shall be increased by the amount of the tax imposed by this section on such payment.
(2) Other administrative provisions
For purposes of subtitle F, any tax imposed by this section shall be treated as a tax imposed by subtitle A.""";
    content_hash "sha256:57b39cd1897b4ceaeace28188f8a47c5ab78686e30a9e023bd13a5f73bcd1286";
}

// 26 U.S.C. §4999 — statutory note 2 (effectivedate-note)
