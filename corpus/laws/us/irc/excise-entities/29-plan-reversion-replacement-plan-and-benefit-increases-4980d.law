// Stage 3 (26.09.2026). Section 4980(d)(2)-(6): the qualified replacement plan
// ((2)(A) 95 percent participation, (B) the direct transfer of the 25 percent
// cushion less the (ii) benefit increases and its tax treatment (iii), (C)
// allocation of a defined contribution transfer with the suspense account),
// the pro rata benefit increases of (3), the section 401(a)(4)/415 limits of
// (4) and the definitions of (5). Module 17 read the two outcomes as case facts
// (`replacement_plan_established_or_maintained`, `pro_rata_benefit_increases_provided`);
// this module derives them from the components, and `ReversionIncreasedRateApplies`
// is blocked by either derivation as well.
//
// JUDGMENT CALLS. (a) "in an amount equal to the excess" is exact equality of
// the transferred amount and the required cushion. (b) The pro rata test is run
// participant by participant against the aggregate; a qualified participant
// with no increase fact is not flagged. (c) Aggregation of the employers of
// section 414(b), (c), (m) and (o) for (2)(A) is left to the case: the
// participant counts are group counts (TECH-GAPS G5908). (d) The Secretary's
// authority to treat plans as one ((5)(D)) is regulatory, not computed.
// Status: implemented_unverified; scenarios not executed; no legal review.

// --- common inputs ---

use self::{
    IRC_S4980_D,
    Person,
    PlanReversion,
    employer_reversion,
    reversion_employer,
    reversion_occurs_on,
};

@source(IRC_S4980_D, coverage = partial, quote = "the maximum amount which the employer could receive as an employer reversion without regard to this subsection")
pub relation maximum_reversion_without_4980d(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(2)(B)(i)(I), (3)(A)(i): the maximum amount which the employer could receive as an employer reversion without regard to subsection (d)";
}
pub relation plan_termination_date(r: PlanReversion, on: Date) kind empirical {
    label en unofficial "section 4980(d): the termination date of the qualified plan";
}
@source(IRC_S4980_D, coverage = partial, quote = "Present value shall be determined as of the termination date and on the same basis as liabilities of the plan are determined on termination.")
pub relation present_values_determined_on_termination_basis(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(5)(B): present values are determined as of the termination date and on the same basis as the plan's liabilities on termination";
}

// --- (5)(A): qualified participant ---

pub relation participant_of_terminated_plan(r: PlanReversion, p: Person) kind empirical {
    label en unofficial "p is a participant or beneficiary of the terminated plan";
}
pub relation participant_is_active(r: PlanReversion, p: Person) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(i): p is an active participant";
}
pub relation participant_in_pay_status_at_termination(r: PlanReversion, p: Person) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(ii): p is a participant or beneficiary in pay status as of the termination date";
}
pub relation participant_has_nonforfeitable_accrued_benefit(r: PlanReversion, p: Person) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(iii)(I), (iv): p has a nonforfeitable right to an accrued benefit under the terminated plan as of the termination date";
}
pub relation participant_service_terminated_on(r: PlanReversion, p: Person, on: Date) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(iii)(II): the date the participant's creditable service terminated";
}
pub relation final_distribution_of_assets_on(r: PlanReversion, on: Date) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(iii)(II): the date on which the final distribution of assets occurs";
}
pub relation beneficiary_of_participant(r: PlanReversion, b: Person, p: Person) kind empirical {
    label en unofficial "section 4980(d)(5)(A)(iv): b is a beneficiary of participant p";
}
pub relation service_ended_within_window_before_termination(r: PlanReversion, p: Person) kind institutional {
    label en official "section 4980(d)(5)(A)(iii)(II): service terminated during the period beginning 3 years before the termination date and ending with the final distribution of assets";
}
rule ServiceEndedWithinWindow(r: PlanReversion, p: Person, t: Date, ended: Date, fin: Date, calendar_before_1: Date) defeasible {
    label en official "section 4980(d)(5)(A)(iii)(II): 3 calendar years before the termination date through the final distribution";
    when plan_termination_date(r, t);
    when participant_service_terminated_on(r, p, ended);
    when final_distribution_of_assets_on(r, fin);
    when ended >= calendar_before_1;
    when ended <= fin
        and us.irc.core::civil_calendar_boundary_before(t, 3, us.irc.core::CalendarYear, calendar_before_1);
    then service_ended_within_window_before_termination(r, p);
}
pub relation qualified_participant_4980d5(r: PlanReversion, p: Person) kind institutional {
    label en official "section 4980(d)(5)(A): an active participant, a participant or beneficiary in pay status, a vested participant whose service ended in the window, or a vested beneficiary of such a participant";
}
rule QualifiedParticipantActive(r: PlanReversion, p: Person) defeasible {
    label en official "section 4980(d)(5)(A)(i)";
    when participant_of_terminated_plan(r, p);
    when participant_is_active(r, p);
    then qualified_participant_4980d5(r, p);
}
rule QualifiedParticipantInPayStatus(r: PlanReversion, p: Person) defeasible {
    label en official "section 4980(d)(5)(A)(ii)";
    when participant_of_terminated_plan(r, p);
    when participant_in_pay_status_at_termination(r, p);
    then qualified_participant_4980d5(r, p);
}
rule QualifiedParticipantVestedWithRecentService(r: PlanReversion, p: Person) defeasible {
    label en official "section 4980(d)(5)(A)(iii): not active and not in pay status, vested, service ended in the window";
    when participant_of_terminated_plan(r, p);
    when participant_has_nonforfeitable_accrued_benefit(r, p);
    when service_ended_within_window_before_termination(r, p);
    unless participant_is_active(r, p) and participant_of_terminated_plan(r, p) and participant_has_nonforfeitable_accrued_benefit(r, p) and service_ended_within_window_before_termination(r, p);
    unless participant_in_pay_status_at_termination(r, p) and participant_of_terminated_plan(r, p) and participant_has_nonforfeitable_accrued_benefit(r, p) and service_ended_within_window_before_termination(r, p);
    then qualified_participant_4980d5(r, p);
}
rule QualifiedParticipantBeneficiaryOfVested(r: PlanReversion, b: Person, p: Person) defeasible {
    label en official "section 4980(d)(5)(A)(iv): a vested beneficiary of a participant described in (iii)(II)";
    when beneficiary_of_participant(r, b, p);
    when participant_has_nonforfeitable_accrued_benefit(r, b);
    when service_ended_within_window_before_termination(r, p);
    then qualified_participant_4980d5(r, b);
}

// --- (3): pro rata benefit increases ---

pub relation benefit_increase_amendment_adopted_in_connection_with_termination(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(3)(A): a plan amendment to the terminated plan is adopted in connection with the termination";
}
pub relation benefit_increase_effective_on_termination_date(r: PlanReversion) kind empirical {
    label en unofficial "sections 4980(d)(2)(B)(ii)(II), (3)(A)(ii): the increases take effect immediately on the termination date";
}
pub relation aggregate_benefit_increase_present_value(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(3)(A)(i): the aggregate present value of the pro rata increases in accrued benefits of qualified participants";
}
pub relation non_active_qualified_participants_increase_present_value(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(3)(B) last sentence: the aggregate increases in present value for qualified participants who are not active participants";
}
pub relation aggregate_accrued_benefit_present_value(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(3)(B)(ii): the aggregate present value of accrued benefits of the terminated plan (without regard to subsection (d))";
}
pub relation participant_accrued_benefit_present_value(r: PlanReversion, p: Person, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(3)(B)(i): the present value of the participant's accrued benefit (without regard to subsection (d))";
}
pub relation participant_benefit_increase_present_value(r: PlanReversion, p: Person, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(3)(B): the increase in the present value of the participant's accrued benefit";
}
pub relation expected_pro_rata_increase(r: PlanReversion, p: Person, amount: Money) kind institutional {
    label en official "section 4980(d)(3)(B): the increase bearing the same ratio to the aggregate amount as the participant's accrued benefit bears to the aggregate accrued benefits (one rounding, cents HALF_UP)";
}
rule ExpectedProRataIncrease(r: PlanReversion, p: Person, agg: Money, pv: Money, total: Money) defeasible {
    label en official "section 4980(d)(3)(B): aggregate * (participant present value / total present value)";
    when aggregate_benefit_increase_present_value(r, agg);
    when participant_accrued_benefit_present_value(r, p, pv);
    when aggregate_accrued_benefit_present_value(r, total);
    when total > 0.00 USD;
    then expected_pro_rata_increase(r, p, div_round(agg * (pv / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation participant_increase_not_pro_rata(r: PlanReversion) kind institutional {
    label en official "helper: some qualified participant's increase differs from the pro rata amount";
}
rule ParticipantIncreaseNotProRata(r: PlanReversion, p: Person, inc: Money, expected: Money) defeasible {
    label en official "section 4980(d)(3)(B): a qualified participant's increase is not the pro rata amount";
    when qualified_participant_4980d5(r, p);
    when participant_benefit_increase_present_value(r, p, inc);
    when expected_pro_rata_increase(r, p, expected);
    when inc != expected;
    then participant_increase_not_pro_rata(r);
}
pub relation benefit_increase_causing_401a4_or_415_failure(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(4)(A): the increase or allocation would result in a failure to meet a requirement under section 401(a)(4) or 415";
}
pub relation benefit_increase_requirements_met_4980d3(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(3): a pro rata increase amendment adopted in connection with the termination, effective on the termination date, of aggregate present value at least 20 percent of the maximum reversion, with non-active participants' increases at most 40 percent of the 20 percent amount";
}
rule BenefitIncreaseRequirementsMet(r: PlanReversion, agg: Money, maxr: Money, nonactive: Money) defeasible {
    label en official "section 4980(d)(3)(A)-(B), (5)(B), (4)(A)";
    when benefit_increase_amendment_adopted_in_connection_with_termination(r);
    when benefit_increase_effective_on_termination_date(r);
    when present_values_determined_on_termination_basis(r);
    when aggregate_benefit_increase_present_value(r, agg);
    when maximum_reversion_without_4980d(r, maxr);
    when agg >= maxr * 0.20;
    when non_active_qualified_participants_increase_present_value(r, nonactive);
    when nonactive <= maxr * 0.20 * 0.40;
    unless participant_increase_not_pro_rata(r) and maximum_reversion_without_4980d(r, maxr);
    unless benefit_increase_causing_401a4_or_415_failure(r) and maximum_reversion_without_4980d(r, maxr);
    then benefit_increase_requirements_met_4980d3(r);
}
pub relation reversion_employer_of_terminated_plan(r: PlanReversion, emp: Person) kind institutional {
    label en official "the employer maintaining the terminated plan";
}
rule ReversionEmployerOfTerminatedPlan(r: PlanReversion, emp: Person) defeasible {
    label en official "section 4980(b)";
    when reversion_employer(r, emp);
    then reversion_employer_of_terminated_plan(r, emp);
}
@source(IRC_S4980_D, coverage = partial, quote = "A benefit may not be increased under paragraph (2)(B)(ii) or (3)(A), and an amount may not be allocated to a participant under paragraph (2)(C), if such increase or allocation would result in a failure to meet any requirement under section 401(a)(4) or 415.")
rule S4980DBenefitIncreaseProhibitionRule(r: PlanReversion, emp: Person) defeasible {
    label en official "section 4980(d)(4)(A): no benefit increase or allocation that would fail section 401(a)(4) or 415 — VIOLATED on itself when established (E-0179)";
    when reversion_employer_of_terminated_plan(r, emp);
    when benefit_increase_causing_401a4_or_415_failure(r);
    then prohibition S4980DBenefitIncreaseCausingFailure {
        bearer emp;
        action benefit_increase_causing_401a4_or_415_failure(r);
        window [-infinity, infinity];
    };
}
pub relation benefit_increase_treated_as_annual_benefit_415(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(4)(B): the increase or allocation is treated as an annual benefit or annual addition for section 415";
}
rule BenefitIncreaseTreatedAsAnnualBenefit(r: PlanReversion, agg: Money) defeasible {
    label en official "section 4980(d)(4)(B)";
    when aggregate_benefit_increase_present_value(r, agg);
    then benefit_increase_treated_as_annual_benefit_415(r);
}
pub relation increase_nondiscriminatory_in_favor_of_hce(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(4)(C): the application of the exception does not discriminate in favor of highly compensated employees (section 414(q))";
}
pub relation secretary_provides_otherwise_4980d4c(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(4)(C): the Secretary provides otherwise";
}
pub relation section_415b5D_not_applied_to_increase(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(4)(C): except as the Secretary provides, section 415(b)(5)(D) does not apply to the increase to the extent it does not discriminate in favor of highly compensated employees";
}
rule Section415b5DNotApplied(r: PlanReversion) defeasible {
    label en official "section 4980(d)(4)(C)";
    when increase_nondiscriminatory_in_favor_of_hce(r);
    unless secretary_provides_otherwise_4980d4c(r) and increase_nondiscriminatory_in_favor_of_hce(r);
    then section_415b5D_not_applied_to_increase(r);
}
pub relation reduced_increase_reallocated_pro_rata(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(5)(C): the amount of a reduction (by the last sentence of (3)(A)(ii) or by (4)) was allocated to the remaining participants on the same basis as other increases";
}
pub relation reduction_allocation_treated_as_meeting_requirement(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(5)(C): the reallocation is treated as meeting any allocation requirement of subsection (d)";
}
rule ReductionAllocationTreatedAsMeeting(r: PlanReversion) defeasible {
    label en official "section 4980(d)(5)(C)";
    when reduced_increase_reallocated_pro_rata(r);
    then reduction_allocation_treated_as_meeting_requirement(r);
}

// --- (2): qualified replacement plan ---

pub relation replacement_plan_of(r: PlanReversion, plan: Person) kind empirical {
    label en unofficial "the replacement plan established or maintained by the employer in connection with the qualified plan termination";
}
pub relation replacement_plan_is_qualified_plan(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2): the replacement plan is a qualified plan established or maintained by the employer in connection with the termination";
}
pub relation remaining_active_participants_count(r: PlanReversion, n: Integer) kind empirical {
    label en unofficial "section 4980(d)(2)(A): the number of active participants in the terminated plan who remain employees of the employer after the termination (a section 414(b), (c), (m), (o) group count)";
}
pub relation active_participants_in_replacement_plan_count(r: PlanReversion, n: Integer) kind empirical {
    label en unofficial "section 4980(d)(2)(A): how many of them are active participants in the replacement plan";
}
pub relation replacement_participation_95_percent_met(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(A): at least 95 percent of the remaining active participants are active participants in the replacement plan";
}
rule ReplacementParticipation95(r: PlanReversion, n: Integer, m: Integer) defeasible {
    label en official "section 4980(d)(2)(A): m * 100 >= n * 95 in exact integers";
    when remaining_active_participants_count(r, n);
    when active_participants_in_replacement_plan_count(r, m);
    when n > 0;
    when m * 100 >= n * 95;
    then replacement_participation_95_percent_met(r);
}
pub relation benefit_increase_amendment_adopted_on(r: PlanReversion, on: Date) kind empirical {
    label en unofficial "section 4980(d)(2)(B)(ii)(I): the date the accrued-benefit increase amendment was adopted";
}
pub relation clause_ii_increase_present_value(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(2)(B)(ii): the present value of the aggregate increases in accrued benefits pursuant to the amendment";
}
pub relation clause_ii_amount(r: PlanReversion, amount: Money) kind institutional {
    label en official "section 4980(d)(2)(B)(ii): the present value of the increases pursuant to an amendment adopted during the 60-day period ending on the termination date and effective immediately on that date; zero otherwise";
}
rule ClauseIiAmountValid(r: PlanReversion, adopted: Date, t: Date, pv: Money, calendar_before_1: Date) defeasible {
    label en official "section 4980(d)(2)(B)(ii)(I)-(II)";
    when clause_ii_increase_present_value(r, pv);
    when benefit_increase_amendment_adopted_on(r, adopted);
    when plan_termination_date(r, t);
    when benefit_increase_effective_on_termination_date(r);
    when adopted >= calendar_before_1;
    when adopted <= t
        and us.irc.core::civil_calendar_boundary_before(t, 60, us.irc.core::CalendarDay, calendar_before_1);
    then clause_ii_amount(r, pv);
}
rule ClauseIiAmountNone(r: PlanReversion, maxr: Money) defeasible {
    label en official "section 4980(d)(2)(B)(ii): no qualifying amendment, so zero";
    when maximum_reversion_without_4980d(r, maxr);
    unless benefit_increase_amendment_adopted_on(r, _) and maximum_reversion_without_4980d(r, maxr) and clause_ii_increase_present_value(r, _) and benefit_increase_effective_on_termination_date(r);
    then clause_ii_amount(r, 0.00 USD);
}
pub relation required_direct_transfer_amount(r: PlanReversion, amount: Money) kind institutional {
    label en official "section 4980(d)(2)(B)(i): 25 percent of the maximum reversion over the clause (ii) amount, when positive";
}
rule RequiredDirectTransferPositive(r: PlanReversion, maxr: Money, ii: Money) defeasible {
    label en official "section 4980(d)(2)(B)(i)";
    when maximum_reversion_without_4980d(r, maxr);
    when clause_ii_amount(r, ii);
    when maxr * 0.25 > ii;
    then required_direct_transfer_amount(r, maxr * 0.25 - ii);
}
rule RequiredDirectTransferNone(r: PlanReversion, maxr: Money, ii: Money) defeasible {
    label en official "section 4980(d)(2)(B)(i): the clause (ii) amount covers the 25 percent";
    when maximum_reversion_without_4980d(r, maxr);
    when clause_ii_amount(r, ii);
    when maxr * 0.25 <= ii;
    then required_direct_transfer_amount(r, 0.00 USD);
}
pub relation direct_transfer_made_on(r: PlanReversion, on: Date) kind empirical {
    label en unofficial "section 4980(d)(2)(B)(i): the date of the direct transfer from the terminated plan to the replacement plan";
}
pub relation direct_transfer_amount(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(2)(B)(i): the amount transferred";
}
pub relation direct_transfer_requirement_met(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(B)(i): the transfer is made before any employer reversion and equals the required amount";
}
rule DirectTransferRequirementMet(r: PlanReversion, made: Date, occurs: Date, amt: Money, required: Money) defeasible {
    label en official "section 4980(d)(2)(B)(i)";
    when direct_transfer_made_on(r, made);
    when reversion_occurs_on(r, occurs);
    when made < occurs;
    when direct_transfer_amount(r, amt);
    when required_direct_transfer_amount(r, required);
    when amt == required;
    then direct_transfer_requirement_met(r);
}
pub relation transfer_excluded_from_employer_gross_income(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(B)(iii)(I): the transferred amount is not includible in the gross income of the employer";
}
pub relation transfer_deduction_disallowed(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(B)(iii)(II): no deduction is allowable with respect to the transfer";
}
pub relation transfer_not_an_employer_reversion(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(B)(iii)(III): the transfer is not treated as an employer reversion for purposes of this section";
}
rule TransferTaxTreatmentExclusion(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(B)(iii)(I)";
    when direct_transfer_requirement_met(r);
    then transfer_excluded_from_employer_gross_income(r);
}
rule TransferTaxTreatmentNoDeduction(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(B)(iii)(II)";
    when direct_transfer_requirement_met(r);
    then transfer_deduction_disallowed(r);
}
rule TransferTaxTreatmentNotReversion(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(B)(iii)(III)";
    when direct_transfer_requirement_met(r);
    then transfer_not_an_employer_reversion(r);
}
pub relation replacement_plan_is_defined_contribution(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C): the replacement plan is a defined contribution plan";
}
pub relation transfer_allocated_in_year_of_transfer(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(i)(I): the transferred portion is allocated to participants' accounts in the plan year of the transfer";
}
pub relation suspense_allocation_plan_years(r: PlanReversion, n: Integer) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(i)(II): the number of plan years, beginning with the year of the transfer, over which the suspense account is allocated no less rapidly than ratably";
}
pub relation suspense_allocation_ratable_within_7_years(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(C)(i)(II): credited to a suspense account and allocated no less rapidly than ratably over at most 7 plan years";
}
rule SuspenseAllocationRatable(r: PlanReversion, n: Integer) defeasible {
    label en official "section 4980(d)(2)(C)(i)(II): at most 7 plan years";
    when suspense_allocation_plan_years(r, n);
    when n >= 1;
    when n <= 7;
    then suspense_allocation_ratable_within_7_years(r);
}
pub relation section_415_limited_amount_reallocated(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(ii): an amount that section 415 bars from allocation to a participant is allocated to other participants, and any portion barred there is allocated to the participant as section 415 provides";
}
pub relation suspense_income_allocated_ratably(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(iii): income on the suspense account is allocated to participants no less rapidly than ratably over the remainder of the period";
}
pub relation section_415_limit_applies_to_allocation(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(ii): a section 415 limitation bars allocation of an amount to a participant before the close of the period";
}
pub relation section_415_limit_handled(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(C)(ii): no section 415 limitation applies, or the barred amount was reallocated as the paragraph requires";
}
rule Section415LimitNotApplicable(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(C)(ii): no limitation applies";
    when replacement_plan_is_defined_contribution(r);
    unless section_415_limit_applies_to_allocation(r) and replacement_plan_is_defined_contribution(r);
    then section_415_limit_handled(r);
}
rule Section415LimitReallocated(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(C)(ii)(I)-(II): the barred amount was reallocated";
    when section_415_limit_applies_to_allocation(r);
    when section_415_limited_amount_reallocated(r);
    then section_415_limit_handled(r);
}
pub relation replacement_allocation_requirement_met(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2)(C): the defined contribution allocation requirement is met";
}
rule ReplacementAllocationViaYearOfTransfer(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(C)(i)(I): allocated in the transfer year";
    when replacement_plan_is_defined_contribution(r);
    when transfer_allocated_in_year_of_transfer(r);
    when section_415_limit_handled(r);
    then replacement_allocation_requirement_met(r);
}
rule ReplacementAllocationViaSuspense(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(C)(i)(II), (ii), (iii): suspense account ratably over at most 7 years, with the section 415 reallocation and ratable income allocation";
    when replacement_plan_is_defined_contribution(r);
    when suspense_allocation_ratable_within_7_years(r);
    when section_415_limit_handled(r);
    when suspense_income_allocated_ratably(r);
    then replacement_allocation_requirement_met(r);
}
pub relation suspense_amount_unallocated_at_replacement_termination(r: PlanReversion, amount: Money) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(iv): the portion of the suspense account not allocated as of the termination date of the replacement plan that section 415 bars from allocation to any participant";
}
pub relation deemed_employer_reversion_4980d2Civ(r: PlanReversion, amount: Money) kind institutional {
    label en official "section 4980(d)(2)(C)(iv)(II): the portion that cannot be allocated to other participants by reason of section 415 is treated as an employer reversion to which this section applies";
}
rule DeemedReversionFromReplacementSuspense(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(d)(2)(C)(iv)(II)";
    when suspense_amount_unallocated_at_replacement_termination(r, amt);
    then deemed_employer_reversion_4980d2Civ(r, amt);
}
rule EmployerReversionFromReplacementSuspense(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(d)(2)(C)(iv)(II): the deemed reversion is an employer reversion (it carries the tax of subsection (a))";
    when deemed_employer_reversion_4980d2Civ(r, amt);
    then employer_reversion(r, amt);
}
@source(IRC_S4980_D, coverage = partial, quote = "no less rapidly than ratably over the 7-plan-year period beginning with the year of the transfer")
rule S4980DSuspenseAllocationDutyRule(r: PlanReversion, plan: Person, made: Date) defeasible {
    label en official "section 4980(d)(2)(C)(i)(II): the replacement plan shall allocate the suspense account no less rapidly than ratably over the 7-plan-year period beginning with the year of the transfer";
    when replacement_plan_of(r, plan);
    when replacement_plan_is_defined_contribution(r);
    when direct_transfer_made_on(r, made);
    when transfer_credited_to_suspense_account(r);
    then duty S4980DAllocateSuspenseAccount {
        bearer plan;
        goal achievement {
            condition suspense_allocation_ratable_within_7_years(r);
            window [made, add_calendar_period(made, 7 calendar_year)];
        }
    };
}
pub relation transfer_credited_to_suspense_account(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(d)(2)(C)(i)(II): the transferred portion was credited to a suspense account rather than allocated in the plan year of the transfer";
}
pub relation qualified_replacement_plan_4980d2(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(2): a qualified replacement plan: 95 percent participation, the direct transfer of the required cushion, and (for a defined contribution plan) the allocation requirement";
}
rule QualifiedReplacementPlanDefinedContribution(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(A)-(C) for a defined contribution replacement plan";
    when replacement_plan_is_qualified_plan(r);
    when replacement_participation_95_percent_met(r);
    when direct_transfer_requirement_met(r);
    when replacement_plan_is_defined_contribution(r);
    when replacement_allocation_requirement_met(r);
    unless benefit_increase_causing_401a4_or_415_failure(r) and replacement_plan_is_qualified_plan(r);
    then qualified_replacement_plan_4980d2(r);
}
rule QualifiedReplacementPlanOther(r: PlanReversion) defeasible {
    label en official "section 4980(d)(2)(A)-(B) for a replacement plan that is not a defined contribution plan (paragraph (C) applies only to defined contribution plans)";
    when replacement_plan_is_qualified_plan(r);
    when replacement_participation_95_percent_met(r);
    when direct_transfer_requirement_met(r);
    unless replacement_plan_is_defined_contribution(r) and replacement_plan_is_qualified_plan(r);
    unless benefit_increase_causing_401a4_or_415_failure(r) and replacement_plan_is_qualified_plan(r);
    then qualified_replacement_plan_4980d2(r);
}

// --- wiring into section 4980(d)(1) ---

rule ReversionIncreasedRateBlockedByDerivedReplacementPlan(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(d)(1)(A): the derived qualified replacement plan means the 50 percent rate does not apply";
    when employer_reversion(r, amt);
    when qualified_replacement_plan_4980d2(r);
    then reversion_normal_rate_applies_4980d1(r);
}
rule ReversionIncreasedRateBlockedByDerivedBenefitIncreases(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(d)(1)(B): derived pro rata benefit increases mean the 50 percent rate does not apply";
    when employer_reversion(r, amt);
    when benefit_increase_requirements_met_4980d3(r);
    then reversion_normal_rate_applies_4980d1(r);
}
pub relation reversion_normal_rate_applies_4980d1(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(1): a qualified replacement plan or pro rata benefit increases exist derived from the components (module 29), so the 20 percent rate applies";
}
