// Stage 3 (26.09.2026). Section 4975 definitions and rules that modules 10 and 22
// read as case flags, now derived from their components: (e)(1) plan
// categories, (e)(4)-(5) constructive ownership for the 50 percent owner
// categories, (e)(7) employee stock ownership plan, (e)(8) registered
// investment company shares, (e)(9)(A) withdrawal liability trust, (f)(5)
// correction, (f)(6) owner-employee transactions, (f)(8)(B)-(I) the eligible
// investment advice arrangement, (f)(10) adequate consideration, and (f)(11)
// the (d)(23) correction, assessment bar and the definition of "correct".
//
// WIRING. `is_plan`, `esop_4975e7_requirements_met`, `owner_employee_transaction_4975f6`,
// `adequate_consideration_4975f10`, `d23_corrected_before_end_of_correction_period`
// and the six `advice_*` flags were empirical; they are `institutional` now and a
// case may still assert them directly (the derivation rules below are
// additional producers). Status: implemented_unverified; scenarios not executed;
// no legal review. JUDGMENT CALLS: the constructive ownership share of
// `us.irc.corporations::total_constructive_ownership_share` is used as given for the
// 267(c) rules of (e)(4) (no single-step family limit is reproduced,
// INTERPRETATION); profits and beneficial interests read the module 25 inputs.

// --- (e)(1): plan categories ---

use self::{
    Corporation,
    ExcessContributionAccountKind,
    ExciseAct,
    IRC_S4975_F,
    Person,
    adequate_consideration_4975f10,
    advice_annual_independent_audit_and_report,
    advice_disclosure_requirements_met,
    advice_fees_do_not_vary_by_option_or_computer_model_program,
    advice_other_conditions_met,
    advice_records_maintained_six_years,
    advice_separate_fiduciary_authorization,
    constructive_beneficial_interest_share,
    constructive_profits_interest_share,
    correction_period_end_4975f11,
    d23_available_4975f11,
    d23_corrected_before_end_of_correction_period,
    esop_4975e7_requirements_met,
    is_covering_employer_4975,
    is_plan,
    owner_employee_transaction_4975f6,
    owner_of_covering_employer_or_organization,
    plan_covers_employees_of_investment_company_or_adviser,
    registered_investment_company_shares_held_by_plan,
    withdrawal_liability_trust_501c22,
};

enum PlanCategory4975 {
    Trust401aOr403a;
    IndividualRetirementAccount;
    IndividualRetirementAnnuity;
    ArcherMsa;
    HealthSavingsAccount;
    CoverdellEducationSavingsAccount;
    SecretaryDetermined;
}
pub relation plan_category_on(plan: Person, cat: PlanCategory4975, on: Date) kind empirical {
    label en unofficial "section 4975(e)(1)(A)-(G): the entity falls in this plan category on the date";
}
pub relation trust_or_plan_exempt_under_501a(plan: Person, on: Date) kind empirical {
    label en unofficial "section 4975(e)(1)(A): the trust or plan is exempt from tax under section 501(a)";
}
rule PlanTrust401aOr403a(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(A): a section 401(a) trust or section 403(a) plan that is exempt under section 501(a)";
    when plan_category_on(plan, Trust401aOr403a, on);
    when trust_or_plan_exempt_under_501a(plan, on);
    then is_plan(plan, on);
}
rule PlanIndividualRetirementAccount(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(B): an individual retirement account under section 408(a)";
    when plan_category_on(plan, IndividualRetirementAccount, on);
    then is_plan(plan, on);
}
rule PlanIndividualRetirementAnnuity(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(C): an individual retirement annuity under section 408(b)";
    when plan_category_on(plan, IndividualRetirementAnnuity, on);
    then is_plan(plan, on);
}
rule PlanArcherMsa(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(D): an Archer MSA under section 220(d)";
    when plan_category_on(plan, ArcherMsa, on);
    then is_plan(plan, on);
}
rule PlanHealthSavingsAccount(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(E): a health savings account under section 223(d)";
    when plan_category_on(plan, HealthSavingsAccount, on);
    then is_plan(plan, on);
}
rule PlanCoverdell(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(F): a Coverdell education savings account under section 530";
    when plan_category_on(plan, CoverdellEducationSavingsAccount, on);
    then is_plan(plan, on);
}
rule PlanSecretaryDetermined(plan: Person, on: Date) defeasible {
    label en official "section 4975(e)(1)(G): determined by the Secretary at any time to be described in (A)-(F)";
    when plan_category_on(plan, SecretaryDetermined, on);
    then is_plan(plan, on);
}

// --- (e)(4)-(5): constructive ownership for the 50 percent owner category ---

rule OwnerOfCoveringEmployerCorporationByConstructiveShare(p: Person, plan: Person, e: Corporation, share: Decimal) defeasible {
    label en official "section 4975(e)(2)(E)(i), (e)(4): 50 percent or more of a covering corporate employer, counting indirect stockholdings under section 267(c) with the (e)(6) family";
    when is_covering_employer_4975(e, plan);
    when us.irc.corporations::total_constructive_ownership_share(p, e, share);
    when share >= 0.50;
    then owner_of_covering_employer_or_organization(p, plan);
}
rule OwnerOfCoveringPartnershipByConstructiveProfits(p: Person, plan: Person, e: Person, share: Decimal) defeasible {
    label en official "section 4975(e)(2)(E)(ii), (e)(5): 50 percent or more of the profits interest of a covering employer or employee organization that is a partnership, by the section 267(c) rules";
    when is_covering_employer_4975(e, plan);
    when constructive_profits_interest_share(p, e, share);
    when share >= 0.50;
    then owner_of_covering_employer_or_organization(p, plan);
}
rule OwnerOfCoveringTrustByConstructiveBeneficialInterest(p: Person, plan: Person, e: Person, share: Decimal) defeasible {
    label en official "section 4975(e)(2)(E)(iii), (e)(5): 50 percent or more of the beneficial interest of a covering employer that is a trust or unincorporated enterprise";
    when is_covering_employer_4975(e, plan);
    when constructive_beneficial_interest_share(p, e, share);
    when share >= 0.50;
    then owner_of_covering_employer_or_organization(p, plan);
}

// --- (e)(7): employee stock ownership plan ---

pub relation esop_defined_contribution_plan(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7): the plan is a defined contribution plan";
}
pub relation esop_qualified_stock_bonus_plan_designed_to_invest_in_employer_securities(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7)(A): a stock bonus plan which is qualified, or a stock bonus and a money purchase plan both qualified under section 401(a), designed to invest primarily in qualifying employer securities";
}
pub relation esop_meets_409h_and_409o(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7), last sentence: the plan meets the requirements of section 409(h) and section 409(o)";
}
pub relation esop_409n_409p_664g_applicable(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7): section 409(n), 409(p) or 664(g) applies to the plan";
}
pub relation esop_meets_409n_409p_664g(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7): the plan meets the applicable requirements of sections 409(n), 409(p) and 664(g)";
}
pub relation employer_has_registration_type_class_of_securities(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7): the employer has a registration-type class of securities (section 409(e)(4))";
}
pub relation esop_meets_409e(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7): the plan meets the requirements of section 409(e)";
}
pub relation esop_otherwise_defined_by_regulations(plan: Person) kind empirical {
    label en unofficial "section 4975(e)(7)(B): the plan is otherwise defined in regulations prescribed by the Secretary (the regulation is not pinned)";
}
pub relation esop_409n_409p_664g_satisfied(plan: Person) kind institutional {
    label en official "section 4975(e)(7): sections 409(n), 409(p) and 664(g) are met if applicable (not applicable counts as satisfied)";
}
rule Esop409nNotApplicable(plan: Person) defeasible {
    label en official "section 4975(e)(7): none of sections 409(n), 409(p), 664(g) applies";
    when esop_defined_contribution_plan(plan);
    unless esop_409n_409p_664g_applicable(plan) and esop_defined_contribution_plan(plan);
    then esop_409n_409p_664g_satisfied(plan);
}
rule Esop409nApplicableAndMet(plan: Person) defeasible {
    label en official "section 4975(e)(7): an applicable section 409(n), 409(p) or 664(g) requirement is met";
    when esop_409n_409p_664g_applicable(plan);
    when esop_meets_409n_409p_664g(plan);
    then esop_409n_409p_664g_satisfied(plan);
}
pub relation esop_409e_satisfied(plan: Person) kind institutional {
    label en official "section 4975(e)(7): section 409(e) is met if the employer has a registration-type class of securities (otherwise not required)";
}
rule Esop409eNotRequired(plan: Person) defeasible {
    label en official "section 4975(e)(7): no registration-type class of securities";
    when esop_defined_contribution_plan(plan);
    unless employer_has_registration_type_class_of_securities(plan) and esop_defined_contribution_plan(plan);
    then esop_409e_satisfied(plan);
}
rule Esop409eRequiredAndMet(plan: Person) defeasible {
    label en official "section 4975(e)(7): the employer has a registration-type class of securities and the plan meets section 409(e)";
    when employer_has_registration_type_class_of_securities(plan);
    when esop_meets_409e(plan);
    then esop_409e_satisfied(plan);
}
rule EsopRequirementsMet(plan: Person) defeasible {
    label en official "section 4975(e)(7): a defined contribution qualified stock bonus plan designed to invest primarily in qualifying employer securities, otherwise defined in regulations, meeting sections 409(h), 409(o) and (when applicable) 409(n), 409(p), 664(g) and 409(e)";
    when esop_defined_contribution_plan(plan);
    when esop_qualified_stock_bonus_plan_designed_to_invest_in_employer_securities(plan);
    when esop_otherwise_defined_by_regulations(plan);
    when esop_meets_409h_and_409o(plan);
    when esop_409n_409p_664g_satisfied(plan);
    when esop_409e_satisfied(plan);
    then esop_4975e7_requirements_met(plan);
}

// --- (e)(8), (e)(9)(A) ---

pub relation investment_company_not_fiduciary_or_disqualified_4975e8(plan: Person, company: Person) kind institutional {
    label en official "section 4975(e)(8): investing plan assets in registered investment company shares does not make the company or its adviser or principal underwriter a fiduciary or disqualified person, unless the plan covers their own employees";
}
rule InvestmentCompanyNotFiduciary(plan: Person, company: Person) defeasible {
    label en official "section 4975(e)(8)";
    when registered_investment_company_shares_held_by_plan(plan, company);
    unless plan_covers_employees_of_investment_company_or_adviser(plan, company) and registered_investment_company_shares_held_by_plan(plan, company);
    then investment_company_not_fiduciary_or_disqualified_4975e8(plan, company);
}
pub relation qualifying_employer_security_409l(sec: Person) kind empirical {
    label en unofficial "section 4975(e)(8): an employer security within the meaning of section 409(l)";
}
pub relation withdrawal_liability_trust_is_plan_4975e9(t: Person) kind institutional {
    label en official "section 4975(e)(9)(A): a trust described in section 501(c)(22) is a plan";
}
rule WithdrawalLiabilityTrustIsPlan(t: Person) defeasible {
    label en official "section 4975(e)(9)(A)";
    when withdrawal_liability_trust_501c22(t);
    then withdrawal_liability_trust_is_plan_4975e9(t);
}

// --- (f)(5): correction ---

pub relation transaction_undone_to_extent_possible_4975(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(5): the transaction has been undone to the extent possible";
}
pub relation plan_position_not_worse_than_highest_fiduciary_standard(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(5): the plan is in a financial position not worse than that in which it would be if the disqualified person were acting under the highest fiduciary standards";
}
pub relation prohibited_transaction_corrected_4975f5(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(5): the transaction is corrected (the act_corrected_on date of the case is meaningful only when this holds)";
}
rule ProhibitedTransactionCorrected(a: ExciseAct) defeasible {
    label en official "section 4975(f)(5)";
    when transaction_undone_to_extent_possible_4975(a);
    when plan_position_not_worse_than_highest_fiduciary_standard(a);
    then prohibited_transaction_corrected_4975f5(a);
}

// --- (f)(6): owner-employee transactions ---

pub relation plan_is_401a_trust_with_owner_employees(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A): the plan is a section 401(a) trust of a plan providing contributions or benefits for employees some or all of whom are owner-employees (section 401(c)(3))";
}
pub relation counterparty_is_401c3_owner_employee(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A): the other party is an owner-employee as defined in section 401(c)(3)";
}
pub relation counterparty_is_shareholder_employee(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(B)(i)(I), (C): the other party is an employee or officer of an S corporation owning (or considered owning under section 318(a)(1)) more than 5 percent of the outstanding stock on any day of the corporation's taxable year";
}
pub relation counterparty_is_ira_participant_or_beneficiary(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(B)(i)(II): the other party is a participant or beneficiary of an individual retirement plan (section 7701(a)(37))";
}
pub relation counterparty_is_ira_establisher(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(B)(i)(III): the other party is an employer or association of employees which establishes an individual retirement plan under section 408(c)";
}
pub relation counterparty_is_family_member_of_owner_employee(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A): the other party is a member of the family (section 267(c)(4)) of an owner-employee";
}
pub relation counterparty_corporation_owner_employee_share(a: ExciseAct, share: Decimal) kind empirical {
    label en unofficial "section 4975(f)(6)(A): the share (of voting power or of value, whichever is larger) of the counterparty corporation owned directly or indirectly by an owner-employee";
}
pub relation plan_lends_to_counterparty(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A)(i): the plan lends any part of the corpus or income of the plan to the counterparty";
}
pub relation plan_pays_compensation_to_counterparty(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A)(ii): the plan pays any compensation for personal services rendered to the plan to the counterparty";
}
pub relation plan_acquires_from_or_sells_to_counterparty(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(A)(iii): the plan acquires property for the plan from, or sells property to, the counterparty";
}
pub relation sale_of_employer_securities_to_esop_by_shareholder_employee_or_related(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(6)(B)(ii): the transaction consists of a sale of employer securities to an ESOP by a shareholder-employee, a member of his family or a corporation in which he owns 50 percent or more";
}
pub relation owner_employee_party_any(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(6)(A), (B)(i): the party is an owner-employee, a shareholder-employee, an IRA participant or beneficiary, or an IRA establisher, or a family member or a 50-percent corporation of an owner-employee";
}
rule PartyIs401c3OwnerEmployee(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(A)"; when counterparty_is_401c3_owner_employee(a); then owner_employee_party_any(a); }
rule PartyIsShareholderEmployee(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(B)(i)(I)"; when counterparty_is_shareholder_employee(a); then owner_employee_party_any(a); }
rule PartyIsIraParticipant(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(B)(i)(II)"; when counterparty_is_ira_participant_or_beneficiary(a); then owner_employee_party_any(a); }
rule PartyIsIraEstablisher(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(B)(i)(III)"; when counterparty_is_ira_establisher(a); then owner_employee_party_any(a); }
rule PartyIsFamilyMember(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(A): a member of the family of an owner-employee"; when counterparty_is_family_member_of_owner_employee(a); then owner_employee_party_any(a); }
rule PartyIsFiftyPercentCorporation(a: ExciseAct, share: Decimal) defeasible {
    label en official "section 4975(f)(6)(A): a corporation in which an owner-employee owns directly or indirectly 50 percent or more";
    when counterparty_corporation_owner_employee_share(a, share);
    when share >= 0.50;
    then owner_employee_party_any(a);
}
pub relation owner_employee_party_for_loans(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(6)(B)(iii): for a loan ((A)(i)) the owner-employee is only an IRA participant or beneficiary or an IRA establisher (or a family member or a 50-percent corporation of one)";
}
rule LoanPartyIraParticipant(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(B)(iii)"; when counterparty_is_ira_participant_or_beneficiary(a); then owner_employee_party_for_loans(a); }
rule LoanPartyIraEstablisher(a: ExciseAct) defeasible { label en official "section 4975(f)(6)(B)(iii)"; when counterparty_is_ira_establisher(a); then owner_employee_party_for_loans(a); }
rule LoanPartyIraRelatedFamily(a: ExciseAct) defeasible {
    label en official "section 4975(f)(6)(B)(iii) with (A): a family member of an IRA owner-employee";
    when counterparty_is_family_member_of_owner_employee(a);
    when counterparty_family_of_ira_party(a);
    then owner_employee_party_for_loans(a);
}
pub relation counterparty_family_of_ira_party(a: ExciseAct) kind empirical {
    label en unofficial "the owner-employee of whom the counterparty is a family member (or whose 50-percent corporation it is) is a person described in (B)(i)(II) or (III)";
}
rule LoanPartyIraRelatedCorporation(a: ExciseAct, share: Decimal) defeasible {
    label en official "section 4975(f)(6)(B)(iii) with (A): a corporation 50 percent owned by an IRA owner-employee";
    when counterparty_corporation_owner_employee_share(a, share);
    when share >= 0.50;
    when counterparty_family_of_ira_party(a);
    then owner_employee_party_for_loans(a);
}
rule OwnerEmployeeTransactionLoan(a: ExciseAct) defeasible {
    label en official "section 4975(f)(6)(A)(i), (B)(iii): a plan loan to a (B)(iii) owner-employee party";
    when plan_is_401a_trust_with_owner_employees(a);
    when plan_lends_to_counterparty(a);
    when owner_employee_party_for_loans(a);
    then owner_employee_transaction_4975f6(a);
}
rule OwnerEmployeeTransactionCompensation(a: ExciseAct) defeasible {
    label en official "section 4975(f)(6)(A)(ii): the plan pays compensation for personal services to an owner-employee party";
    when plan_is_401a_trust_with_owner_employees(a);
    when plan_pays_compensation_to_counterparty(a);
    when owner_employee_party_any(a);
    then owner_employee_transaction_4975f6(a);
}
rule OwnerEmployeeTransactionAcquireOrSell(a: ExciseAct) defeasible {
    label en official "section 4975(f)(6)(A)(iii): the plan acquires property from or sells property to an owner-employee party, except the (B)(ii) ESOP sale";
    when plan_is_401a_trust_with_owner_employees(a);
    when plan_acquires_from_or_sells_to_counterparty(a);
    when owner_employee_party_any(a);
    unless sale_of_employer_securities_to_esop_by_shareholder_employee_or_related(a) and plan_acquires_from_or_sells_to_counterparty(a);
    then owner_employee_transaction_4975f6(a);
}
pub relation shareholder_employee_5_percent(p: Person) kind institutional {
    label en official "section 4975(f)(6)(C): an employee or officer of an S corporation who owns (or is considered as owning within the meaning of section 318(a)(1)) more than 5 percent of the outstanding stock on any day during the corporation's taxable year";
}
pub relation s_corporation_employee_or_officer(p: Person) kind empirical {
    label en unofficial "section 4975(f)(6)(C): p is an employee or officer of an S corporation";
}
pub relation greatest_stock_share_including_318a1_on_any_day(p: Person, share: Decimal) kind empirical {
    label en unofficial "section 4975(f)(6)(C): the largest share of the outstanding stock p owns or is considered as owning under section 318(a)(1) on any day of the taxable year";
}
rule ShareholderEmployee5Percent(p: Person, share: Decimal) defeasible {
    label en official "section 4975(f)(6)(C)";
    when s_corporation_employee_or_officer(p);
    when greatest_stock_share_including_318a1_on_any_day(p, share);
    when share > 0.05;
    then shareholder_employee_5_percent(p);
}

// --- (f)(8): eligible investment advice arrangement ---

pub relation advice_fees_do_not_vary_by_investment_option(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(B)(i)(I): fees (including commissions or other compensation) received by the fiduciary adviser do not vary depending on the investment option selected";
}
pub relation advice_uses_computer_model_program(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(B)(i)(II): the arrangement uses a computer model under an investment advice program meeting subparagraph (C)";
}
pub relation cm_generally_accepted_investment_theories(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(ii)(I): the model applies generally accepted investment theories taking into account historic returns of different asset classes over defined periods";
}
pub relation cm_uses_relevant_participant_information(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(ii)(II): the model utilizes relevant information about the participant (age, life expectancy, retirement age, risk tolerance, other assets or income, preferences)";
}
pub relation cm_uses_prescribed_objective_criteria_over_plan_options(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(ii)(III): the model utilizes prescribed objective criteria to provide asset allocation portfolios comprised of the plan's investment options";
}
pub relation cm_not_biased_toward_adviser_investments(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(ii)(IV): the model operates in a manner that is not biased in favor of investments offered by the fiduciary adviser or a person affiliated or contracting with it";
}
pub relation cm_considers_all_plan_options_without_inappropriate_weighting(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(ii)(V): the model takes into account all investment options under the plan and is not inappropriately weighted toward any";
}
pub relation cm_certified_by_eligible_expert_before_use(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iii)(I): an eligible investment expert certified, prior to the utilization of the computer model and under the Secretary of Labor's rules, that the model meets clause (ii)";
}
pub relation cm_certifier_meets_eligible_expert_definition(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iii)(III): the certifier meets the requirements of the Secretary of Labor and bears no material affiliation or contractual relationship with any investment adviser or related person";
}
pub relation cm_materially_modified(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iii)(II): as determined under regulations, there are material modifications to the computer model";
}
pub relation cm_modified_model_recertified(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iii)(II): a certification was obtained for the model as modified";
}
pub relation cm_only_advice_is_model_generated(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iv)(I): the only investment advice provided under the program is the advice generated by the computer model";
}
pub relation cm_transactions_solely_at_participant_direction(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iv)(II): any (d)(17)(A)(ii) transaction occurs solely at the direction of the participant or beneficiary";
}
pub relation cm_certification_valid(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(C)(iii): certified before use by an eligible investment expert, and recertified after any material modification";
}
rule CmCertificationValidUnmodified(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(C)(iii)(I)";
    when cm_certified_by_eligible_expert_before_use(a);
    when cm_certifier_meets_eligible_expert_definition(a);
    unless cm_materially_modified(a) and cm_certified_by_eligible_expert_before_use(a) and cm_certifier_meets_eligible_expert_definition(a);
    then cm_certification_valid(a);
}
rule CmCertificationValidRecertified(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(C)(iii)(II)";
    when cm_certified_by_eligible_expert_before_use(a);
    when cm_certifier_meets_eligible_expert_definition(a);
    when cm_materially_modified(a);
    when cm_modified_model_recertified(a);
    then cm_certification_valid(a);
}
pub relation advice_program_meets_subparagraph_c(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(8)(C)(i): the requirements of clauses (ii), (iii) and (iv) are met";
}
rule AdviceProgramMeetsC(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(C)(i)-(iv)";
    when cm_generally_accepted_investment_theories(a);
    when cm_uses_relevant_participant_information(a);
    when cm_uses_prescribed_objective_criteria_over_plan_options(a);
    when cm_not_biased_toward_adviser_investments(a);
    when cm_considers_all_plan_options_without_inappropriate_weighting(a);
    when cm_certification_valid(a);
    when cm_only_advice_is_model_generated(a);
    when cm_transactions_solely_at_participant_direction(a);
    then advice_program_meets_subparagraph_c(a);
}
rule AdviceFeesFlat(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(B)(i)(I)";
    when advice_fees_do_not_vary_by_investment_option(a);
    then advice_fees_do_not_vary_by_option_or_computer_model_program(a);
}
rule AdviceComputerModel(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(B)(i)(II)";
    when advice_uses_computer_model_program(a);
    when advice_program_meets_subparagraph_c(a);
    then advice_fees_do_not_vary_by_option_or_computer_model_program(a);
}
pub relation advice_requested_other_advice_unsolicited(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iv), last sentence: the participant requested advice other than the model's, and the request was not solicited by any person connected with carrying out the arrangement (allowed)";
}
pub relation advice_other_advice_solicited(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(C)(iv), last sentence: the participant's request for other advice was solicited by a person connected with carrying out the arrangement";
}
pub relation authorized_by_a_plan_fiduciary(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(D): the arrangement is expressly authorized by a plan fiduciary";
}
pub relation authorizer_is_adviser_option_provider_or_affiliate(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(D): the authorizing fiduciary is the person offering the advice program, a person providing investment options under the plan, or an affiliate of either";
}
rule AdviceSeparateFiduciaryAuthorization(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(D)";
    when authorized_by_a_plan_fiduciary(a);
    unless authorizer_is_adviser_option_provider_or_affiliate(a) and authorized_by_a_plan_fiduciary(a);
    then advice_separate_fiduciary_authorization(a);
}
pub relation auditor_conducts_annual_audit(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(E)(i)(I): an independent auditor with appropriate technical training or experience and proficiency, who so represents in writing, conducts an annual audit of the arrangement";
}
pub relation auditor_issues_written_report_to_authorizing_fiduciary(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(E)(i)(II): after the audit the auditor issues a written report presenting specific findings to the fiduciary who authorized the arrangement";
}
pub relation auditor_related_to_offeror_or_option_provider(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(E)(iii): the auditor is related to the person offering the arrangement or to a person providing investment options under the plan";
}
pub relation advice_plan_is_ira_type_plan(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(E)(ii): the plan is described in (e)(1)(B)-(F) (and (G) as it relates to them)";
}
pub relation audit_conducted_as_secretary_of_labor_prescribes(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(E)(ii): audits are conducted at the times and in the manner the Secretary of Labor prescribes";
}
rule AdviceAuditRequirementMet(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(E)(i), (iii): an independent annual audit and a written report to the authorizing fiduciary";
    when auditor_conducts_annual_audit(a);
    when auditor_issues_written_report_to_authorizing_fiduciary(a);
    unless auditor_related_to_offeror_or_option_provider(a) and auditor_conducts_annual_audit(a) and auditor_issues_written_report_to_authorizing_fiduciary(a);
    then advice_annual_independent_audit_and_report(a);
}
rule AdviceAuditRequirementMetForIraTypePlans(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(E)(ii): for individual retirement and similar plans, audits as the Secretary of Labor prescribes";
    when advice_plan_is_ira_type_plan(a);
    when audit_conducted_as_secretary_of_labor_prescribes(a);
    then advice_annual_independent_audit_and_report(a);
}
pub relation notification_item_role_of_affiliated_parties(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(I): written notification of the role of any party with a material affiliation or contractual relationship in developing the program and selecting the options";
}
pub relation notification_item_past_performance(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(II): of the past performance and historical rates of return of the investment options";
}
pub relation notification_item_fees_and_compensation(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(III): of all fees or other compensation relating to the advice, including third-party compensation";
}
pub relation notification_item_material_affiliations(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(IV): of any material affiliation or contractual relationship of the adviser or affiliates in the security or property";
}
pub relation notification_item_use_of_participant_information(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(V): of the manner and circumstances in which participant information will be used or disclosed";
}
pub relation notification_item_types_of_services(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(VI): of the types of services provided by the adviser";
}
pub relation notification_item_acting_as_fiduciary(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(VII): that the adviser is acting as a fiduciary of the plan";
}
pub relation notification_item_may_arrange_separate_advice(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i)(VIII): that the recipient may separately arrange advice by another adviser with no material affiliation and no compensation in connection with the security";
}
pub relation notification_given_before_initial_advice(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(i): the written notification (possibly electronic) is provided before the initial provision of the advice";
}
pub relation ongoing_information_maintained_accurate(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(ii)(I): at all times the adviser maintains the information in accurate form";
}
pub relation ongoing_information_provided_annually_free(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(ii)(II): accurate information provided without charge at least annually";
}
pub relation ongoing_information_provided_on_request_free(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(ii)(III): accurate information provided without charge on request";
}
pub relation ongoing_information_material_changes_provided_free(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(F)(ii)(IV): accurate information about any material change provided without charge at a time reasonably contemporaneous to the change";
}
@source(IRC_S4975_F, coverage = partial, quote = "written in a clear and conspicuous manner and in a manner calculated to be understood by the average plan participant")
external judgment relation notification_presentation_clear_and_understood_by_average_participant(a: ExciseAct) {
    authority Secretary;
    label en official "section 4975(f)(8)(H)(i): the notification is written in a clear and conspicuous manner, in a manner calculated to be understood by the average plan participant, and is sufficiently accurate and comprehensive to reasonably apprise participants and beneficiaries of the required information";
}
rule AdviceDisclosureRequirementsMet(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(F), (H)(i): the eight notification items before the initial advice, the ongoing four items, in the required presentation";
    when notification_given_before_initial_advice(a);
    when notification_item_role_of_affiliated_parties(a);
    when notification_item_past_performance(a);
    when notification_item_fees_and_compensation(a);
    when notification_item_material_affiliations(a);
    when notification_item_use_of_participant_information(a);
    when notification_item_types_of_services(a);
    when notification_item_acting_as_fiduciary(a);
    when notification_item_may_arrange_separate_advice(a);
    when ongoing_information_maintained_accurate(a);
    when ongoing_information_provided_annually_free(a);
    when ongoing_information_provided_on_request_free(a);
    when ongoing_information_material_changes_provided_free(a);
    when notification_presentation_clear_and_understood_by_average_participant(a);
    then advice_disclosure_requirements_met(a);
}
pub relation advice_securities_law_disclosure_given(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(G)(i): appropriate disclosure in connection with the sale, acquisition or holding, in accordance with all applicable securities laws";
}
pub relation advice_transaction_solely_at_recipient_direction(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(G)(ii): the sale, acquisition or holding occurs solely at the direction of the recipient of the advice";
}
pub relation advice_compensation_reasonable(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(G)(iii): the compensation received by the adviser and affiliates in connection with the sale, acquisition or holding is reasonable";
}
pub relation advice_terms_at_least_as_favorable_as_arms_length(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(G)(iv): the terms are at least as favorable to the plan as an arm's length transaction would be";
}
rule AdviceOtherConditionsMet(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(G)(i)-(iv)";
    when advice_securities_law_disclosure_given(a);
    when advice_transaction_solely_at_recipient_direction(a);
    when advice_compensation_reasonable(a);
    when advice_terms_at_least_as_favorable_as_arms_length(a);
    then advice_other_conditions_met(a);
}
pub relation advice_records_kept_years(a: ExciseAct, years: Integer) kind empirical {
    label en unofficial "section 4975(f)(8)(I): the number of whole years after the advice for which the fiduciary adviser maintained the records";
}
pub relation advice_records_lost_beyond_adviser_control(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(I), last sentence: the records were lost or destroyed before the end of the 6-year period due to circumstances beyond the control of the fiduciary adviser";
}
rule AdviceRecordsMaintainedSixYears(a: ExciseAct, years: Integer) defeasible {
    label en official "section 4975(f)(8)(I): records maintained for not less than 6 years";
    when advice_records_kept_years(a, years);
    when years >= 6;
    then advice_records_maintained_six_years(a);
}
rule AdviceRecordsLossBeyondControlDoesNotBreakRequirement(a: ExciseAct) defeasible {
    label en official "section 4975(f)(8)(I), last sentence: a prohibited transaction is not considered to have occurred solely because the records were lost or destroyed beyond the adviser's control";
    when advice_records_lost_beyond_adviser_control(a);
    then advice_records_maintained_six_years(a);
}
pub relation fiduciary_adviser_of_advice(p: Person, a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(8)(I), (J): p is the fiduciary adviser who provided the advice";
}
pub relation advice_provided_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "the date the advice was provided";
}
@source(IRC_S4975_F, coverage = partial, quote = "maintains, for a period of not less than 6 years after the provision of the advice, any records necessary for determining whether the requirements of the preceding provisions of this paragraph and of subsection (d)(17) have been met")
rule S4975F8IRecordsDutyRule(a: ExciseAct, p: Person, on: Date) defeasible {
    label en official "section 4975(f)(8)(I): the fiduciary adviser shall maintain the records for not less than 6 years after the advice";
    when fiduciary_adviser_of_advice(p, a);
    when advice_provided_on(a, on);
    then duty S4975F8IMaintainAdviceRecords {
        bearer p;
        goal maintenance {
            condition advice_records_maintained_six_years(a);
            window [on, add_calendar_period(on, 6 calendar_year)];
        }
    };
}

// --- (f)(10): adequate consideration ---

pub relation security_has_generally_recognized_market(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(10)(A): the security has a generally recognized market";
}
pub relation price_equals_national_exchange_price(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(10)(A)(i): the price is the price prevailing on a registered national securities exchange, taking into account size and marketability";
}
pub relation price_not_less_favorable_than_independent_bid_and_asked(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(10)(A)(ii): the security is not exchange-traded and the price is not less favorable to the plan than the offering price established by current independent bid and asked quotations, taking into account size and marketability";
}
pub relation security_traded_on_registered_national_exchange(a: ExciseAct) kind empirical {
    label en unofficial "the security is traded on a national securities exchange registered under section 6 of the Securities Exchange Act of 1934";
}
pub relation asset_fmv_determined_in_good_faith_by_fiduciary(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(10)(B): the fair market value of an asset other than a security with a generally recognized market, determined in good faith by a fiduciary or fiduciaries under the Secretary of Labor's regulations";
}
rule AdequateConsiderationExchange(a: ExciseAct) defeasible {
    label en official "section 4975(f)(10)(A)(i)";
    when security_has_generally_recognized_market(a);
    when security_traded_on_registered_national_exchange(a);
    when price_equals_national_exchange_price(a);
    then adequate_consideration_4975f10(a);
}
rule AdequateConsiderationBidAndAsked(a: ExciseAct) defeasible {
    label en official "section 4975(f)(10)(A)(ii)";
    when security_has_generally_recognized_market(a);
    when price_not_less_favorable_than_independent_bid_and_asked(a);
    unless security_traded_on_registered_national_exchange(a) and security_has_generally_recognized_market(a);
    then adequate_consideration_4975f10(a);
}
rule AdequateConsiderationOtherAsset(a: ExciseAct) defeasible {
    label en official "section 4975(f)(10)(B)";
    when asset_fmv_determined_in_good_faith_by_fiduciary(a);
    unless security_has_generally_recognized_market(a) and asset_fmv_determined_in_good_faith_by_fiduciary(a);
    then adequate_consideration_4975f10(a);
}

// --- (f)(11): (d)(23) correction, assessment bar ---

pub relation d23_correction_undid_transaction_and_made_good_losses(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(11)(D)(iii)(I): the transaction was undone to the extent possible and in any case any losses resulting from it were made good to the plan or affected account";
}
pub relation d23_correction_restored_profits(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(f)(11)(D)(iii)(II): any profits made through the use of plan assets were restored to the plan or affected account";
}
pub relation d23_correction_made_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "the date the (d)(23) transaction was corrected";
}
pub relation d23_corrected_within_the_definition(a: ExciseAct) kind institutional {
    label en official "section 4975(f)(11)(D)(iii): 'correct': undo the transaction to the extent possible and make good losses, and restore profits";
}
rule D23CorrectedWithinTheDefinition(a: ExciseAct) defeasible {
    label en official "section 4975(f)(11)(D)(iii)(I)-(II)";
    when d23_correction_undid_transaction_and_made_good_losses(a);
    when d23_correction_restored_profits(a);
    then d23_corrected_within_the_definition(a);
}
rule D23CorrectedBeforeEndOfCorrectionPeriod(a: ExciseAct, made: Date, endd: Date) defeasible {
    label en official "section 4975(f)(11)(A), (D)(iii): the transaction was corrected, as defined, no later than the last day of the 14-day correction period";
    when d23_corrected_within_the_definition(a);
    when d23_correction_made_on(a, made);
    when correction_period_end_4975f11(a, endd);
    when made <= endd;
    then d23_corrected_before_end_of_correction_period(a);
}
pub relation d23_transaction_disqualified_person(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the disqualified person to whom a tax under section 4975(a) or (b) could be assessed for the (d)(23) transaction";
}
pub relation prohibited_transaction_tax_assessed_against(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the tax under section 4975(a) or (b) has been assessed against the person with respect to the transaction";
}
pub relation prohibited_transaction_tax_assessment_abated(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the assessment has been abated (and any collected amount credited or refunded as an overpayment)";
}
@source(IRC_S4975_F, coverage = partial, quote = "then no tax under subsections (a) and (b) shall be assessed with respect to such transaction")
rule S4975D23NotAssessedImmunityRule(a: ExciseAct, p: Person) defeasible {
    label en official "section 4975(f)(11)(C): a transaction not treated as prohibited by reason of (d)(23) bears no assessed tax under (a) or (b)";
    when d23_available_4975f11(a);
    when d23_transaction_disqualified_person(a, p);
    then immunity S4975NoAssessmentForD23Transaction {
        holder p;
        against us.irc.core::IRS;
        protected_effect prohibited_transaction_tax_assessed_against(a, p);
        window [-infinity, infinity];
    };
}
@source(IRC_S4975_F, coverage = partial, quote = "and if assessed the assessment shall be abated, and if collected shall be credited or refunded as an overpayment")
rule S4975D23AbatementDutyRule(a: ExciseAct, p: Person) defeasible {
    label en official "section 4975(f)(11)(C): if assessed the assessment shall be abated, and if collected credited or refunded as an overpayment";
    when d23_available_4975f11(a);
    when d23_transaction_disqualified_person(a, p);
    when prohibited_transaction_tax_assessed_against(a, p);
    then duty S4975D23AbateAssessment {
        bearer us.irc.core::IRS;
        beneficiary p;
        goal achievement {
            condition prohibited_transaction_tax_assessment_abated(a, p);
            window [-infinity, infinity];
        }
    };
}
