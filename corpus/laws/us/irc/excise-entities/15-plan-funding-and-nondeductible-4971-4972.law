// Sections 4971 (taxes on failure to meet minimum funding standards) and 4972
// (tax on nondeductible contributions to qualified employer plans). Stage 2
// (DECISION-0379).
//
// SECTION 4971
//  - an ExciseAct of kind FundingDeficiency stands for one (employer, plan, plan
//    year) failure; the initial tax (a)(1)-(a)(3) and the additional tax (b) populate
//    the shared `initial_tax` / `additional_tax` heads, so 4963's first/second tier,
//    the payment duties and the abatement immunities reach them.
//  - the taxable period ends at the earlier of the notice of deficiency and the
//    assessment (4971(c)(3)) — the two-candidate machinery of
//    12-jeopardy-trusts-political-4944-4951-4955.law; "corrected within the taxable
//    period" is `corrected_within_notice_or_assessment_period` with the correction
//    (payment / contribution) date as the shared `act_corrected_on` fact.
//  - the multiemployer accumulated funding deficiency (431) and the CSEC
//    accumulated funding deficiency (433) are IMPORTED from
//    us.irc.deferred_compensation; the aggregate unpaid minimum required
//    contribution of a single-employer plan is a case figure (the FIFO ordering
//    rule of (c)(4)(B) allocates payments over years: a multi-year ledger, G2508).
//  - liquidity shortfalls (f), endangered/critical multiemployer plans (g) and CSEC
//    funding restoration (h) have their own acts; the day counts of (g)(4) and (h)
//    are computed from dates (`days_between`), clipped to the taxable year.
//  - waivers (f)(4), (g)(5), (h)(3) are powers of the Secretary; the Secretary's
//    duty to notify the Secretary of Labor before a notice of deficiency (d) is a duty.
//
// SECTION 4972: 10 percent of nondeductible contributions, with the prior-year
// carryover supplied as a fact (multi-year recursion, G2504 pattern) and the
// exceptions of (c)(3)-(c)(7) as case amounts or elections.

// ============================================================================
// Section 4971
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4971_A,
    IRC_S4971_B,
    IRC_S4971_D,
    IRC_S4971_E,
    IRC_S4971_F,
    IRC_S4971_G,
    IRC_S4971_H,
    IRC_S4972_A,
    IRC_S4972_C,
    IRC_S4972_D,
    Notice,
    Person,
    Plan,
    TaxableYear,
    additional_tax,
    excise_act_kind,
    initial_tax,
    liquidity_second_tier_tax_paid_for_quarter,
    notice_for_act,
    taxable_event,
};

enum FundingPlanKind4971 {
    SingleEmployerPlan;
    MultiemployerPlan4971;
    CsecPlan;
}
pub relation funding_event_kind(a: ExciseAct, k: FundingPlanKind4971) kind empirical {
    label en unofficial "which kind of plan the funding failure concerns (4971(a)(1), (2), (3))";
}
pub relation funding_event_employer(a: ExciseAct, employer: Person) kind empirical {
    label en official "sections 4971(a), (e)(1): the employer responsible for contributing to or under the plan";
}
pub relation employer_maintains_412_plan(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 4971(a): at some time during the taxable year the employer maintains a plan to which section 412 applies";
}
pub relation funding_event_taxable_year(a: ExciseAct, y: TaxableYear) kind empirical {
    label en unofficial "the employer's taxable year for which the tax is imposed";
}
pub relation funding_event_multiemployer_plan(a: ExciseAct, plan: us.irc.deferred_compensation::MultiemployerPlan) kind empirical {
    label en unofficial "the multiemployer plan of the funding failure (section 431 accumulated funding deficiency imported from us.irc.deferred_compensation)";
}
pub relation funding_event_csec_plan(a: ExciseAct, plan: us.irc.deferred_compensation::DefinedBenefitPlan) kind empirical {
    label en unofficial "the CSEC plan of the funding failure (section 433 CSEC accumulated funding deficiency imported from us.irc.deferred_compensation)";
}
pub relation aggregate_unpaid_minimum_required_contributions(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(a)(1), (c)(4)(A): the aggregate unpaid minimum required contributions for all plan years remaining unpaid as of the end of any plan year ending with or within the taxable year (the FIFO ordering of (c)(4)(B) is applied by the case — G2508)";
}
pub relation plan_in_critical_status_for_year(a: ExciseAct) kind empirical {
    label en official "section 4971(g)(1)(A): the multiemployer plan is in critical status pursuant to section 432 for the plan years ending with or within the taxable year (EXTERNAL_DEPENDENCY on the section 432 status determination)";
}
@source(IRC_S4971_A, coverage = exact, quote = "If at any time during any taxable year an employer maintains a plan to which section 412 applies, there is hereby imposed for the taxable year a tax equal to—")
pub relation funding_deficiency_event(a: ExciseAct) kind institutional {
    label en official "section 4971(a): an employer maintains a section 412 plan and a funding failure exists for a plan year ending with or within its taxable year";
}
rule FundingDeficiencyEvent(a: ExciseAct, e: Person, y: TaxableYear) defeasible {
    label en official "section 4971(a): a funding failure of an employer that maintains a section 412 plan during the taxable year";
    when excise_act_kind(a, FundingDeficiency);
    when funding_event_employer(a, e);
    when funding_event_taxable_year(a, y);
    when employer_maintains_412_plan(e, y);
    then funding_deficiency_event(a);
}
@source(IRC_S4971_A, coverage = exact, quote = "(1) in the case of a single-employer plan, 10 percent of the aggregate unpaid minimum required contributions for all plan years remaining unpaid as of the end of any plan year ending with or within the taxable year,")
rule InitialTaxSingleEmployerFunding(a: ExciseAct, e: Person, base: Money) defeasible {
    label en official "section 4971(a)(1): 10 percent of the aggregate unpaid minimum required contributions, paid by the employer (4971(e)(1))";
    when funding_deficiency_event(a);
    when funding_event_kind(a, SingleEmployerPlan);
    when funding_event_employer(a, e);
    when aggregate_unpaid_minimum_required_contributions(a, base);
    then initial_tax(a, e, base * SingleEmployerFundingTaxRate4971);
}
@source(IRC_S4971_A, coverage = exact, quote = "(2) in the case of a multiemployer plan, 5 percent of the accumulated funding deficiency determined under section 431 as of the end of any plan year ending with or within the taxable year, and")
rule InitialTaxMultiemployerFunding(a: ExciseAct, e: Person, plan: us.irc.deferred_compensation::MultiemployerPlan, base: Money) defeasible {
    label en official "section 4971(a)(2): 5 percent of the accumulated funding deficiency determined under section 431 (imported), paid by the employer; no tax while the plan is in critical status (4971(g)(1)(A))";
    when funding_deficiency_event(a);
    when funding_event_kind(a, MultiemployerPlan4971);
    when funding_event_employer(a, e);
    when funding_event_multiemployer_plan(a, plan);
    when us.irc.deferred_compensation::accumulated_funding_deficiency_431a(plan, base);
    unless plan_in_critical_status_for_year(a) and funding_event_employer(a, e) and funding_event_multiemployer_plan(a, plan) and us.irc.deferred_compensation::accumulated_funding_deficiency_431a(plan, base);
    then initial_tax(a, e, base * MultiemployerFundingTaxRate4971);
}
@source(IRC_S4971_A, coverage = exact, quote = "(3) in the case of a CSEC plan, 10 percent of the CSEC accumulated funding deficiency as of the end of the plan year ending with or within the taxable year.")
rule InitialTaxCsecFunding(a: ExciseAct, e: Person, plan: us.irc.deferred_compensation::DefinedBenefitPlan, base: Money) defeasible {
    label en official "section 4971(a)(3): 10 percent of the CSEC accumulated funding deficiency (section 433, imported), paid by the employer";
    when funding_deficiency_event(a);
    when funding_event_kind(a, CsecPlan);
    when funding_event_employer(a, e);
    when funding_event_csec_plan(a, plan);
    when us.irc.deferred_compensation::csec_accumulated_funding_deficiency_433a(plan, base);
    then initial_tax(a, e, base * CsecFundingTaxRate4971);
}
pub relation amount_paid_or_corrected_within_taxable_period(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(b): the part of the unpaid minimum required contribution or deficiency that was paid or corrected within the taxable period";
}
@source(IRC_S4971_B, coverage = exact, quote = "there is hereby imposed a tax equal to 100 percent of the unpaid minimum required contribution, accumulated funding deficiency, or CSEC accumulated funding deficiency, whichever is applicable, to the extent not so paid or corrected.")
rule AdditionalTaxSingleEmployerFunding(a: ExciseAct, e: Person, base: Money, paid: Money) defeasible {
    label en official "section 4971(b)(1): 100 percent of the unpaid minimum required contribution to the extent it remains unpaid at the close of the taxable period";
    when funding_deficiency_event(a);
    when funding_event_kind(a, SingleEmployerPlan);
    when funding_event_employer(a, e);
    when aggregate_unpaid_minimum_required_contributions(a, base);
    when amount_paid_or_corrected_within_taxable_period(a, paid);
    when base > paid;
    then additional_tax(a, e, (base - paid) * FundingAdditionalTaxRate4971);
}
rule AdditionalTaxSingleEmployerFundingNothingPaid(a: ExciseAct, e: Person, base: Money) defeasible {
    label en official "section 4971(b)(1): with no payment in the taxable period the whole unpaid amount is taxed";
    when funding_deficiency_event(a);
    when funding_event_kind(a, SingleEmployerPlan);
    when funding_event_employer(a, e);
    when aggregate_unpaid_minimum_required_contributions(a, base);
    unless amount_paid_or_corrected_within_taxable_period(a, _) and funding_event_employer(a, e) and aggregate_unpaid_minimum_required_contributions(a, base);
    then additional_tax(a, e, base * FundingAdditionalTaxRate4971);
}
rule AdditionalTaxMultiemployerFunding(a: ExciseAct, e: Person, plan: us.irc.deferred_compensation::MultiemployerPlan, base: Money, paid: Money) defeasible {
    label en official "section 4971(b)(2): 100 percent of the accumulated funding deficiency to the extent not corrected within the taxable period";
    when funding_deficiency_event(a);
    when funding_event_kind(a, MultiemployerPlan4971);
    when funding_event_employer(a, e);
    when funding_event_multiemployer_plan(a, plan);
    when us.irc.deferred_compensation::accumulated_funding_deficiency_431a(plan, base);
    when amount_paid_or_corrected_within_taxable_period(a, paid);
    when base > paid;
    unless plan_in_critical_status_for_year(a) and funding_event_employer(a, e) and funding_event_multiemployer_plan(a, plan) and us.irc.deferred_compensation::accumulated_funding_deficiency_431a(plan, base) and amount_paid_or_corrected_within_taxable_period(a, paid);
    then additional_tax(a, e, (base - paid) * FundingAdditionalTaxRate4971);
}
rule AdditionalTaxCsecFunding(a: ExciseAct, e: Person, plan: us.irc.deferred_compensation::DefinedBenefitPlan, base: Money, paid: Money) defeasible {
    label en official "section 4971(b)(3): 100 percent of the CSEC accumulated funding deficiency to the extent not corrected within the taxable period";
    when funding_deficiency_event(a);
    when funding_event_kind(a, CsecPlan);
    when funding_event_employer(a, e);
    when funding_event_csec_plan(a, plan);
    when us.irc.deferred_compensation::csec_accumulated_funding_deficiency_433a(plan, base);
    when amount_paid_or_corrected_within_taxable_period(a, paid);
    when base > paid;
    then additional_tax(a, e, (base - paid) * FundingAdditionalTaxRate4971);
}
pub relation controlled_group_member_414(e: Person, member: Person) kind institutional {
    label en official "section 4971(e)(2)(B): the member is in a controlled group of the employer — treated as a single employer under section 414(b), (c), (m), or (o); derived in 99-wire9-owner-contracts.law from `us.irc.deductions::employers_treated_as_single_employer_414` (symmetric), a case may still assert it directly";
}
@source(IRC_S4971_E, coverage = exact, quote = "If an employer referred to in paragraph (1) is a member of a controlled group, each member of such group shall be jointly and severally liable for the tax imposed by subsection (a), (b), (f), or (g).")
pub relation funding_jointly_and_severally_liable(a: ExciseAct, e: Person, member: Person) kind institutional {
    label en official "section 4971(e)(2): each member of the employer's controlled group is jointly and severally liable for the tax";
}
rule FundingJointAndSeveral(a: ExciseAct, e: Person, member: Person, amount: Money) defeasible {
    label en official "section 4971(e)(2)(A)";
    when funding_event_employer(a, e);
    when controlled_group_member_414(e, member);
    when initial_tax(a, e, amount);
    then funding_jointly_and_severally_liable(a, e, member);
}
// (d): notification of the Secretary of Labor.
pub relation secretary_of_labor_notified_before_notice(a: ExciseAct) kind empirical {
    label en official "section 4971(d): before the notice of deficiency the Secretary notified the Secretary of Labor and provided a reasonable opportunity (not more than 60 days) to require elimination of the deficiency or to comment";
}
@source(IRC_S4971_D, coverage = exact, quote = "Before issuing a notice of deficiency with respect to the tax imposed by subsection (a) or (b), the Secretary shall notify the Secretary of Labor")
rule S4971NotifySecretaryOfLaborDutyRule(a: ExciseAct, n: Notice, mailed: Date) defeasible {
    label en official "section 4971(d): before issuing a notice of deficiency the Secretary shall notify the Secretary of Labor";
    when funding_deficiency_event(a);
    when notice_for_act(n, a);
    when us.irc.core::mailed_on(n, mailed);
    then duty S4971NotifySecretaryOfLabor {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition secretary_of_labor_notified_before_notice(a);
            window [-infinity, mailed];
        }
    };
}

// (f): liquidity shortfall.
pub relation liquidity_shortfall_amount(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(f)(1)(A): the amount of the liquidity shortfall for the quarter";
}
pub relation liquidity_installment_paid_on_time(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(f)(1)(B): the amount of the shortfall paid by the required installment for the quarter, if paid on or before the installment's due date";
}
pub relation liquidity_shortfall_tax_base(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4971(f)(1): the excess of the liquidity shortfall over the amount paid by the timely required installment";
}
rule LiquidityShortfallTaxBase(a: ExciseAct, s: Money, paid: Money) defeasible {
    label en official "section 4971(f)(1): shortfall − timely installment, when positive";
    when excise_act_kind(a, LiquidityShortfall);
    when liquidity_shortfall_amount(a, s);
    when liquidity_installment_paid_on_time(a, paid);
    when s > paid;
    then liquidity_shortfall_tax_base(a, s - paid);
}
rule LiquidityShortfallTaxBaseNoInstallment(a: ExciseAct, s: Money) defeasible {
    label en official "section 4971(f)(1): with no timely installment the whole shortfall is the base";
    when excise_act_kind(a, LiquidityShortfall);
    when liquidity_shortfall_amount(a, s);
    unless liquidity_installment_paid_on_time(a, _) and liquidity_shortfall_amount(a, s);
    then liquidity_shortfall_tax_base(a, s);
}
@source(IRC_S4971_F, coverage = exact, quote = "there is hereby imposed a tax of 10 percent of the excess (if any) of—")
rule LiquidityShortfallTax(a: ExciseAct, e: Person, base: Money) defeasible {
    label en official "section 4971(f)(1): 10 percent of the excess of the liquidity shortfall over the timely installment, paid by the employer";
    when excise_act_kind(a, LiquidityShortfall);
    when funding_event_employer(a, e);
    when liquidity_shortfall_tax_base(a, base);
    // Stage 3: section 4971(f)(3)(B) - no further tax once the paragraph (2) tax is paid for the quarter (34-*.law).
    unless liquidity_second_tier_tax_paid_for_quarter(a) and funding_event_employer(a, e) and liquidity_shortfall_tax_base(a, base);
    then initial_tax(a, e, base * LiquidityShortfallTaxRate4971);
}
pub relation shortfall_persists_at_close_of_quarter_and_next_four(a: ExciseAct) kind empirical {
    label en official "section 4971(f)(2): the plan has a liquidity shortfall as of the close of the quarter and as of the close of each of the following 4 quarters (quarter counting per section 430(j)/433(f) — G2509)";
}
@source(IRC_S4971_F, coverage = exact, quote = "there is hereby imposed a tax equal to 100 percent of the amount on which tax was imposed by paragraph (1) for such first quarter.")
rule LiquidityShortfallAdditionalTax(a: ExciseAct, e: Person, base: Money) defeasible {
    label en official "section 4971(f)(2): 100 percent of the amount taxed under (f)(1) for the first quarter if the shortfall persists for five quarter-ends";
    when excise_act_kind(a, LiquidityShortfall);
    when funding_event_employer(a, e);
    when liquidity_shortfall_tax_base(a, base);
    when shortfall_persists_at_close_of_quarter_and_next_four(a);
    unless liquidity_second_tier_tax_paid_for_quarter(a) and funding_event_employer(a, e) and liquidity_shortfall_tax_base(a, base);
    then additional_tax(a, e, base * LiquidityShortfallAdditionalRate4971);
}

// (g), (h): multiemployer critical status and CSEC funding restoration.
enum PlanFailureKind4971 {
    RequiredContributionMissed;
    RehabilitationPlanNotAdopted;
    FundingRestorationPlanNotAdopted;
}
pub relation plan_failure_kind(a: ExciseAct, k: PlanFailureKind4971) kind empirical {
    label en unofficial "which failure of 4971(g)(2), (g)(4) or (h)(1) the act is";
}
pub relation missed_required_contribution_amount(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(g)(2)(B): the amount of the required contribution the employer failed to make in a timely manner";
}
@source(IRC_S4971_G, coverage = exact, quote = "there is hereby imposed a tax on each failure of the employer to make the required contribution within the time required under such plan.")
pub relation improvement_plan_contribution_failure_tax(a: ExciseAct, e: Person, amount: Money) kind institutional {
    label en official "section 4971(g)(2): a tax equal to the required contribution the employer failed to make, paid by the employer responsible for contributing";
}
rule ImprovementPlanContributionFailureTax(a: ExciseAct, e: Person, amt: Money) defeasible {
    label en official "section 4971(g)(2)(A)-(C)";
    when excise_act_kind(a, PlanFundingFailure);
    when plan_failure_kind(a, RequiredContributionMissed);
    when funding_event_employer(a, e);
    when missed_required_contribution_amount(a, amt);
    then improvement_plan_contribution_failure_tax(a, e, amt);
}
pub relation penalty_period_start(a: ExciseAct, on: Date) kind empirical {
    label en official "sections 4971(g)(4)(B)(ii), (h)(2): the day following the close of the 240-day (or 180-day) period within which the plan was required to adopt the plan (section 432(e)(1)(A) / 433(j)(3) — EXTERNAL_DEPENDENCY)";
}
pub relation plan_adoption_date(a: ExciseAct, on: Date) kind empirical {
    label en official "sections 4971(g)(4)(B)(ii), (h)(2): the day on which the rehabilitation (or funding restoration) plan is adopted";
}
pub relation failure_taxable_year(a: ExciseAct, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the daily tax is computed";
}
pub relation penalty_period_lower_bound(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "the later of the penalty period start and the first day of the taxable year";
}
rule PenaltyPeriodLowerStart(a: ExciseAct, y: TaxableYear, s: Date, ys: Date) defeasible {
    label en unofficial "the period starts within the taxable year";
    when failure_taxable_year(a, y);
    when penalty_period_start(a, s);
    when us.irc.core::begins(y, ys);
    when s >= ys;
    then penalty_period_lower_bound(a, s);
}
rule PenaltyPeriodLowerYearStart(a: ExciseAct, y: TaxableYear, s: Date, ys: Date) defeasible {
    label en unofficial "the period started before the taxable year";
    when failure_taxable_year(a, y);
    when penalty_period_start(a, s);
    when us.irc.core::begins(y, ys);
    when s < ys;
    then penalty_period_lower_bound(a, ys);
}
pub relation penalty_period_upper_bound(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "the earlier of the adoption date and the last day of the taxable year (the last day when the plan has not been adopted)";
}
rule PenaltyPeriodUpperAdopted(a: ExciseAct, y: TaxableYear, ad: Date, ye: Date) defeasible {
    label en unofficial "adopted within the taxable year";
    when failure_taxable_year(a, y);
    when plan_adoption_date(a, ad);
    when us.irc.core::ends(y, ye);
    when ad <= ye;
    then penalty_period_upper_bound(a, ad);
}
rule PenaltyPeriodUpperAdoptedLater(a: ExciseAct, y: TaxableYear, ad: Date, ye: Date) defeasible {
    label en unofficial "adopted after the taxable year";
    when failure_taxable_year(a, y);
    when plan_adoption_date(a, ad);
    when us.irc.core::ends(y, ye);
    when ad > ye;
    then penalty_period_upper_bound(a, ye);
}
rule PenaltyPeriodUpperNotAdopted(a: ExciseAct, y: TaxableYear, ye: Date) defeasible {
    label en unofficial "the plan has not been adopted: the period runs to the end of the taxable year";
    when failure_taxable_year(a, y);
    when us.irc.core::ends(y, ye);
    unless plan_adoption_date(a, _) and failure_taxable_year(a, y) and us.irc.core::ends(y, ye);
    then penalty_period_upper_bound(a, ye);
}
pub relation penalty_days_in_taxable_year(a: ExciseAct, n: Integer) kind institutional {
    label en official "sections 4971(g)(4)(B)(ii), (h)(2): the number of days during the taxable year included in the period";
}
rule PenaltyDaysInTaxableYear(a: ExciseAct, lo: Date, hi: Date) defeasible {
    label en official "inclusive day count of the period clipped to the taxable year";
    when penalty_period_lower_bound(a, lo);
    when penalty_period_upper_bound(a, hi);
    when hi >= lo;
    then penalty_days_in_taxable_year(a, days_between(lo, hi) + 1);
}
pub relation tax_under_4971a_for_year(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4971(g)(4)(B)(i): the amount of tax imposed under subsection (a) for the taxable year, determined without regard to subsection (g)";
}
pub relation plan_sponsor_4971(a: ExciseAct, sponsor: Person) kind empirical {
    label en official "sections 4971(g)(4)(C), (h)(4): the plan sponsor (section 432(j)(9) / 433(j)(5)(E))";
}
@source(IRC_S4971_G, coverage = exact, quote = "there is hereby imposed a tax on the failure of such plan to adopt a rehabilitation plan within the time prescribed under section 432.")
pub relation rehabilitation_plan_failure_tax(a: ExciseAct, sponsor: Person, amount: Money) kind institutional {
    label en official "section 4971(g)(4): the greater of the section 4971(a) tax for the year and $1,100 times the days from the end of the 240-day period to adoption, paid by each plan sponsor";
}
rule RehabilitationPlanFailureTaxDaily(a: ExciseAct, sp: Person, n: Integer, base: Money) defeasible {
    label en official "section 4971(g)(4)(B): the greater of the (a) tax and $1,100 per day";
    when excise_act_kind(a, PlanFundingFailure);
    when plan_failure_kind(a, RehabilitationPlanNotAdopted);
    when plan_sponsor_4971(a, sp);
    when penalty_days_in_taxable_year(a, n);
    when tax_under_4971a_for_year(a, base);
    then rehabilitation_plan_failure_tax(a, sp, max(base, RehabilitationPlanDailyTax4971 * n));
}
rule RehabilitationPlanFailureTaxDailyOnly(a: ExciseAct, sp: Person, n: Integer) defeasible {
    label en official "section 4971(g)(4)(B)(ii): $1,100 per day when no (a) tax is imposed for the year";
    when excise_act_kind(a, PlanFundingFailure);
    when plan_failure_kind(a, RehabilitationPlanNotAdopted);
    when plan_sponsor_4971(a, sp);
    when penalty_days_in_taxable_year(a, n);
    unless tax_under_4971a_for_year(a, _) and plan_sponsor_4971(a, sp) and penalty_days_in_taxable_year(a, n);
    then rehabilitation_plan_failure_tax(a, sp, RehabilitationPlanDailyTax4971 * n);
}
@source(IRC_S4971_H, coverage = exact, quote = "there is hereby imposed a tax on the failure of such plan to adopt a funding restoration plan within the time prescribed under section 433(j)(3).")
pub relation funding_restoration_plan_failure_tax(a: ExciseAct, sponsor: Person, amount: Money) kind institutional {
    label en official "section 4971(h): $100 times the days from the end of the 180-day period to adoption, paid by the plan sponsor";
}
rule FundingRestorationPlanFailureTax(a: ExciseAct, sp: Person, n: Integer) defeasible {
    label en official "section 4971(h)(2), (4)";
    when excise_act_kind(a, PlanFundingFailure);
    when plan_failure_kind(a, FundingRestorationPlanNotAdopted);
    when plan_sponsor_4971(a, sp);
    when penalty_days_in_taxable_year(a, n);
    then funding_restoration_plan_failure_tax(a, sp, FundingRestorationPlanDailyTax4971 * n);
}
// Waivers (powers of the Secretary).
pub relation secretary_waives_liquidity_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4971(f)(4): the Secretary waives all or part of the tax";
}
pub relation liquidity_shortfall_reasonable_cause_and_remedy_established(a: ExciseAct) kind institutional {
    label en official "section 4971(f)(4): the taxpayer established to the Secretary's satisfaction that the shortfall was due to reasonable cause and not willful neglect and reasonable steps have been taken to remedy it";
}
rule LiquidityWaiverConditions(a: ExciseAct) defeasible {
    label en official "section 4971(f)(4)(A)-(B)";
    when liquidity_shortfall_due_to_reasonable_cause(a);
    when reasonable_steps_taken_to_remedy_shortfall(a);
    then liquidity_shortfall_reasonable_cause_and_remedy_established(a);
}
external judgment relation liquidity_shortfall_due_to_reasonable_cause(a: ExciseAct) {
    authority Secretary;
    label en official "section 4971(f)(4)(A): the liquidity shortfall was due to reasonable cause and not willful neglect";
}
external judgment relation reasonable_steps_taken_to_remedy_shortfall(a: ExciseAct) {
    authority Secretary;
    label en official "section 4971(f)(4)(B): reasonable steps have been taken to remedy the liquidity shortfall";
}
pub relation liquidity_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4971(f)(4): the tax under subsection (f) is waived";
}
@source(IRC_S4971_F, coverage = exact, quote = "the Secretary may waive all or part of the tax imposed by this subsection.")
rule S4971LiquidityWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4971(f)(4): the Secretary may waive all or part of the liquidity shortfall tax when reasonable cause and remedial steps are established";
    when excise_act_kind(a, LiquidityShortfall);
    when secretary_waives_liquidity_tax_on(a, on);
    then power S4971LiquidityWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_liquidity_tax_on(a, on);
        valid_when liquidity_shortfall_reasonable_cause_and_remedy_established(a);
        effect create(liquidity_tax_waived(a));
        window [-infinity, infinity];
    };
}
pub relation secretary_waives_plan_failure_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en official "sections 4971(g)(5), (h)(3): the Secretary waives part or all of the tax";
}
external judgment relation plan_failure_due_to_reasonable_cause(a: ExciseAct) {
    authority Secretary;
    label en official "sections 4971(g)(5), (h)(3): the failure is due to reasonable cause and not to willful neglect (for (g)(5) reasonable cause includes market fluctuations, loss of a significant contributing employer, or where the tax would be excessive or inequitable)";
}
pub relation plan_failure_tax_waived(a: ExciseAct) kind institutional {
    label en official "sections 4971(g)(5), (h)(3): the tax on the failure is waived in whole or in part";
}
@source(IRC_S4971_G, coverage = exact, quote = "the Secretary may waive part or all of the tax imposed by this subsection.")
rule S4971PlanFailureWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "sections 4971(g)(5), (h)(3): the Secretary may waive part or all of the tax for a failure due to reasonable cause and not to willful neglect";
    when excise_act_kind(a, PlanFundingFailure);
    when secretary_waives_plan_failure_tax_on(a, on);
    then power S4971PlanFailureWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_plan_failure_tax_on(a, on);
        valid_when plan_failure_due_to_reasonable_cause(a);
        effect create(plan_failure_tax_waived(a));
        window [-infinity, infinity];
    };
}
rule TaxableEventFundingDeficiency(a: ExciseAct) defeasible { label en official "4963(c): section 4971"; when excise_act_kind(a, FundingDeficiency); then taxable_event(a); }

// ============================================================================
// Section 4972
// ============================================================================

enum QualifiedEmployerPlanKind {
    Section401aTrustPlan;
    Section403aAnnuityPlan;
    SimplifiedEmployeePension;
    SimpleRetirementAccount;
}
pub relation qualified_employer_plan_kind(plan: Plan, k: QualifiedEmployerPlanKind) kind empirical {
    label en official "section 4972(d)(1)(A)(i)-(iv): a section 401(a) plan with a section 501(a) trust, a section 403(a) annuity plan, a simplified employee pension (408(k)), or a simple retirement account (408(p))";
}
pub relation governmental_or_tax_exempt_plan_4980c1(plan: Plan) kind empirical {
    label en official "section 4972(d)(1)(B): a plan described in subparagraph (A) or (B) of section 4980(c)(1) (governmental and tax-exempt plans)";
}
@source(IRC_S4972_D, coverage = exact, quote = "The term \"qualified employer plan\" means—")
pub relation qualified_employer_plan(plan: Plan) kind institutional {
    label en official "section 4972(d)(1): a qualified employer plan, excluding governmental and tax-exempt plans";
}
rule QualifiedEmployerPlan(plan: Plan, k: QualifiedEmployerPlanKind) defeasible {
    label en official "section 4972(d)(1)(A)-(B)";
    when qualified_employer_plan_kind(plan, k);
    unless governmental_or_tax_exempt_plan_4980c1(plan) and qualified_employer_plan_kind(plan, k);
    then qualified_employer_plan(plan);
}
pub relation employer_contributed_for_year(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(1)(A)(i): the amount contributed for the taxable year by the employer to or under the plan";
}
pub relation deduction_allowable_under_404_for_contributions(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(1)(A)(ii), (c)(2): the amount allowable as a deduction under section 404 (determined without regard to subsection (e)), treated first as from carryforwards and then from the year's contributions; including the (c)(4) self-employed deemed deduction";
}
pub relation prior_year_nondeductible_contributions(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(1)(B): the amount determined under this subsection for the preceding taxable year, carried in as a fact (year-to-year recursion is not expressed — G2504 pattern)";
}
pub relation prior_nondeductible_returned_to_employer(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(1)(B)(i): the portion of the prior-year amount returned to the employer during the taxable year";
}
pub relation prior_nondeductible_deductible_this_year(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(1)(B)(ii): the portion of the prior-year amount deductible under section 404 for the taxable year (without regard to 404(e))";
}
pub relation section_4972c3_returnable_contribution(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(3): contributions for the year distributed to the employer in a 4980(c)(2)(B)(ii) distribution on or before the last day for a 404(a)(6) contribution";
}
pub relation section_4972c6A_excluded_amount(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(6)(A): contributions to defined contribution plans not deductible solely because of 404(a)(7), up to the 401(m)(4)(A) amount (404(a)(7) limits applied first to defined benefit plans)";
}
pub relation section_4972c6B_excluded_amount(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(6)(B): contributions to SIMPLE, simple plan or SEP not deductible solely because not made in connection with a trade or business (not for the employer or family, 447(e)(1))";
}
pub relation election_4972c7_made(employer: Person, y: TaxableYear) kind empirical {
    label en official "section 4972(c)(7): the employer elected for the year not to take defined benefit plan contributions into account";
}
pub relation section_4972c7_excluded_defined_benefit_contributions(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4972(c)(7): defined benefit plan contributions not taken into account (for a multiemployer plan, only up to the full-funding limitation)";
}
@source(IRC_S4972_C, coverage = exact, quote = "The term \"nondeductible contributions\" means, with respect to any qualified employer plan, the sum of—")
pub relation nondeductible_contributions(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4972(c)(1): (A) contributions for the year over the section 404 deduction plus (B) the prior-year amount reduced by amounts returned and amounts deductible for the year, less the (c)(3), (c)(6), (c)(7) exclusions";
}
// JUDGMENT CALL: (c)(1)(A) and (c)(1)(B) are each floored at zero (an excess or carryover cannot be negative),
// and the (c)(3), (c)(6), (c)(7) exclusions are applied as subtractions from the year's total, floored at zero.
rule NondeductibleContributions(employer: Person, plan: Plan, y: TaxableYear, c: Money, d: Money, prior: Money, ret: Money, ded: Money, x3: Money, x6a: Money, x6b: Money, begin: Date) defeasible {
    label en official "section 4972(c)(1), (3), (5), (6): contributions over the deduction, plus carried-in amount less returns and deductible portion, less exclusions; nothing for years beginning before 1987";
    when qualified_employer_plan(plan);
    when us.irc.core::begins(y, begin);
    when begin >= @1987-01-01;
    when employer_contributed_for_year(employer, plan, y, c);
    when deduction_allowable_under_404_for_contributions(employer, plan, y, d);
    when prior_year_nondeductible_contributions(employer, plan, y, prior);
    when prior_nondeductible_returned_to_employer(employer, plan, y, ret);
    when prior_nondeductible_deductible_this_year(employer, plan, y, ded);
    when section_4972c3_returnable_contribution(employer, plan, y, x3);
    when section_4972c6A_excluded_amount(employer, plan, y, x6a);
    when section_4972c6B_excluded_amount(employer, plan, y, x6b);
    unless election_4972c7_made(employer, y) and qualified_employer_plan(plan) and employer_contributed_for_year(employer, plan, y, c) and deduction_allowable_under_404_for_contributions(employer, plan, y, d) and prior_year_nondeductible_contributions(employer, plan, y, prior) and prior_nondeductible_returned_to_employer(employer, plan, y, ret) and prior_nondeductible_deductible_this_year(employer, plan, y, ded) and section_4972c3_returnable_contribution(employer, plan, y, x3) and section_4972c6A_excluded_amount(employer, plan, y, x6a) and section_4972c6B_excluded_amount(employer, plan, y, x6b);
    then nondeductible_contributions(employer, plan, y, max(max(c - d, 0.00 USD) + max(prior - (ret + ded), 0.00 USD) - x3 - x6a - x6b, 0.00 USD));
}
rule NondeductibleContributionsWithElection(employer: Person, plan: Plan, y: TaxableYear, c: Money, d: Money, prior: Money, ret: Money, ded: Money, x3: Money, x7: Money, begin: Date) defeasible {
    label en official "section 4972(c)(7): with the election, (6) does not apply and the elected defined benefit contributions are not taken into account";
    when qualified_employer_plan(plan);
    when us.irc.core::begins(y, begin);
    when begin >= @1987-01-01;
    when election_4972c7_made(employer, y);
    when employer_contributed_for_year(employer, plan, y, c);
    when deduction_allowable_under_404_for_contributions(employer, plan, y, d);
    when prior_year_nondeductible_contributions(employer, plan, y, prior);
    when prior_nondeductible_returned_to_employer(employer, plan, y, ret);
    when prior_nondeductible_deductible_this_year(employer, plan, y, ded);
    when section_4972c3_returnable_contribution(employer, plan, y, x3);
    when section_4972c7_excluded_defined_benefit_contributions(employer, plan, y, x7);
    then nondeductible_contributions(employer, plan, y, max(max(c - d, 0.00 USD) + max(prior - (ret + ded), 0.00 USD) - x3 - x7, 0.00 USD));
}
@source(IRC_S4972_A, coverage = exact, quote = "In the case of any qualified employer plan, there is hereby imposed a tax equal to 10 percent of the nondeductible contributions under the plan (determined as of the close of the taxable year of the employer).")
pub relation nondeductible_contributions_tax(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 4972(a), (b): 10 percent of the nondeductible contributions, paid by the employer making the contributions";
}
rule NondeductibleContributionsTax(employer: Person, plan: Plan, y: TaxableYear, base: Money) defeasible {
    label en official "section 4972(a): 10 percent of the nondeductible contributions; cents HALF_UP (JUDGMENT CALL: no rounding is named)";
    when nondeductible_contributions(employer, plan, y, base);
    when base > 0.00 USD;
    then nondeductible_contributions_tax(employer, plan, y, round(base * NondeductibleContributionsTaxRate4972, 2, "HALF_UP"));
}
