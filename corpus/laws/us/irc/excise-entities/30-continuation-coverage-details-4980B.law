// Stage 3 (26.09.2026). Section 4980B(f)(4) (applicable premium: the general
// rule, the self-insured plan rules and the 12-month determination), (f)(5)(B)
// (an election deemed to cover other qualified beneficiaries), (f)(5)(C) (the
// TAA-eligible individual's temporary election power), (f)(2)(B)(i)(V)-(VI)
// (the PBGC and TAA period rules), (f)(8) (optional extension safe harbor) and
// (g)(4) (correction).
//
// JUDGMENT CALLS. (a) The actuarial estimate of a self-insured plan is an
// amount supplied by the case with an external judgment that it is a reasonable
// actuarial estimate (DECISION-0194); the computation itself is not done
// (G2519 is narrowed to that). (b) The past-cost method rounds to cents
// HALF_UP (the statute names no rounding). (c) The GNP deflator change is a
// fraction supplied by the case (0.03 for +3 percent). (d) The 60-day TAA
// election period that begins on the first day of the month is read as ending
// on the 60th day counted from and including that day (start + 59 days).
// (e) The PBGC and TAA special periods are capped at January 1, 2014 by the
// statute; for a qualifying event after that date they require nothing beyond
// the cap and are read as displaced (INTERPRETATION, G5909).
// Status: implemented_unverified; scenarios not executed; no legal review.

// --- (f)(4): applicable premium ---

use self::{
    BeneficiaryRole,
    CobraQualifyingEvent,
    ExciseAct,
    IRC_S4980B_F,
    Person,
    QualifyingEventKind4980B,
    applicable_premium_for_period,
    cobra_event_covered_employee,
    cobra_event_kind,
    cobra_event_on,
    cobra_failure_plan,
    cobra_period_end_candidate,
    continuation_coverage_elected,
    event_causes_loss_of_coverage,
    qualified_beneficiary,
    second_qualifying_event_within_18_months_on,
    was_beneficiary_day_before_event_as,
};

pub relation continuation_coverage_period_start(plan: Person, qb: Person, ev: CobraQualifyingEvent, start: Date) kind empirical {
    label en unofficial "section 4980B(f)(4)(C): the first day of the 12-month determination period that applies to the continuation coverage period of the qualified beneficiary";
}
pub relation cost_for_similarly_situated_beneficiaries(plan: Person, start: Date, amount: Money) kind empirical {
    label en unofficial "section 4980B(f)(4)(A): the cost to the plan for the period of the coverage for similarly situated beneficiaries with respect to whom a qualifying event has not occurred (whether paid by the employer or the employee)";
}
pub relation self_insured_plan(plan: Person) kind empirical {
    label en unofficial "section 4980B(f)(4)(B): the plan is a self-insured plan";
}
pub relation actuarial_cost_estimate(plan: Person, start: Date, amount: Money) kind empirical {
    label en unofficial "section 4980B(f)(4)(B)(i): the estimate of the cost of providing coverage for the period for similarly situated beneficiaries";
}
@source(IRC_S4980B_F, coverage = partial, quote = "a reasonable estimate of the cost of providing coverage for such period for similarly situated beneficiaries which")
external judgment relation estimate_is_reasonable_and_actuarial(plan: Person, start: Date) {
    authority Secretary;
    label en official "section 4980B(f)(4)(B)(i): the estimate is reasonable, determined on an actuarial basis and takes into account the factors the Secretary prescribes";
}
pub relation administrator_elects_past_cost_method(plan: Person, start: Date) kind empirical {
    label en unofficial "section 4980B(f)(4)(B)(ii): the plan administrator elects the determination on the basis of past cost";
}
pub relation preceding_period_cost(plan: Person, start: Date, amount: Money) kind empirical {
    label en unofficial "section 4980B(f)(4)(B)(ii)(I): the cost to the plan for similarly situated beneficiaries for the same period in the preceding determination period";
}
pub relation gnp_deflator_change(plan: Person, start: Date, change: Decimal) kind empirical {
    label en unofficial "section 4980B(f)(4)(B)(ii)(II): the percentage increase or decrease (as a fraction, 0.03 for 3 percent) in the implicit price deflator of the gross national product for the 12-month period ending on the last day of the sixth month of the preceding determination period";
}
@source(IRC_S4980B_F, coverage = partial, quote = "any significant difference between the determination period and the preceding determination period, in coverage under, or in employees covered by, the plan")
external judgment relation significant_difference_from_preceding_period(plan: Person, start: Date) {
    authority Secretary;
    label en official "section 4980B(f)(4)(B)(iii): there is a significant difference between the determination period and the preceding determination period in coverage under, or in employees covered by, the plan";
}
pub relation applicable_premium_determined_on(plan: Person, start: Date, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(4)(C): the date the applicable premium was determined";
}
pub relation applicable_premium_determination_timely(plan: Person, start: Date) kind institutional {
    label en official "section 4980B(f)(4)(C): the determination is made before the beginning of the 12-month period";
}
rule ApplicablePremiumDeterminationTimely(plan: Person, start: Date, on: Date) defeasible {
    label en official "section 4980B(f)(4)(C): the determination date precedes the period start";
    when applicable_premium_determined_on(plan, start, on);
    when on < start;
    then applicable_premium_determination_timely(plan, start);
}
pub relation past_cost_method_applies(plan: Person, start: Date) kind institutional {
    label en official "section 4980B(f)(4)(B)(ii)-(iii): the administrator elected the past-cost method and there is no significant difference from the preceding determination period";
}
rule PastCostMethodApplies(plan: Person, start: Date) defeasible {
    label en official "section 4980B(f)(4)(B)(ii)-(iii)";
    when self_insured_plan(plan);
    when administrator_elects_past_cost_method(plan, start);
    unless significant_difference_from_preceding_period(plan, start) and administrator_elects_past_cost_method(plan, start);
    then past_cost_method_applies(plan, start);
}
pub relation applicable_premium_4980B(plan: Person, qb: Person, ev: CobraQualifyingEvent, amount: Money) kind institutional {
    label en official "section 4980B(f)(4): the applicable premium for the coverage period: the cost for similarly situated beneficiaries (A); for a self-insured plan a reasonable actuarial estimate (B)(i) or, on election, the preceding period's cost adjusted by the GNP deflator (B)(ii); determined before the 12-month period (C); or the asserted amount of module 18";
}
rule ApplicablePremiumGeneral(plan: Person, qb: Person, ev: CobraQualifyingEvent, start: Date, cost: Money) defeasible {
    label en official "section 4980B(f)(4)(A): the cost to the plan for similarly situated beneficiaries";
    when continuation_coverage_period_start(plan, qb, ev, start);
    when cost_for_similarly_situated_beneficiaries(plan, start, cost);
    when applicable_premium_determination_timely(plan, start);
    unless self_insured_plan(plan) and continuation_coverage_period_start(plan, qb, ev, start) and cost_for_similarly_situated_beneficiaries(plan, start, cost);
    then applicable_premium_4980B(plan, qb, ev, cost);
}
rule ApplicablePremiumSelfInsuredEstimate(plan: Person, qb: Person, ev: CobraQualifyingEvent, start: Date, est: Money) defeasible {
    label en official "section 4980B(f)(4)(B)(i): a reasonable actuarial estimate for a self-insured plan";
    when self_insured_plan(plan);
    when continuation_coverage_period_start(plan, qb, ev, start);
    when actuarial_cost_estimate(plan, start, est);
    when estimate_is_reasonable_and_actuarial(plan, start);
    when applicable_premium_determination_timely(plan, start);
    unless past_cost_method_applies(plan, start) and continuation_coverage_period_start(plan, qb, ev, start) and actuarial_cost_estimate(plan, start, est);
    then applicable_premium_4980B(plan, qb, ev, est);
}
rule ApplicablePremiumSelfInsuredPastCost(plan: Person, qb: Person, ev: CobraQualifyingEvent, start: Date, prior: Money, change: Decimal) defeasible {
    label en official "section 4980B(f)(4)(B)(ii): the preceding period's cost adjusted by the deflator change (cents HALF_UP, JUDGMENT CALL)";
    when past_cost_method_applies(plan, start);
    when continuation_coverage_period_start(plan, qb, ev, start);
    when preceding_period_cost(plan, start, prior);
    when gnp_deflator_change(plan, start, change);
    when applicable_premium_determination_timely(plan, start);
    then applicable_premium_4980B(plan, qb, ev, round(prior * (1.00 + change), 2, "HALF_UP"));
}
rule ApplicablePremiumAsserted(plan: Person, qb: Person, ev: CobraQualifyingEvent, amount: Money) defeasible {
    label en official "module 18 input: the case asserts the applicable premium directly";
    when applicable_premium_for_period(plan, qb, ev, amount);
    unless continuation_coverage_period_start(plan, qb, ev, _) and applicable_premium_for_period(plan, qb, ev, amount);
    then applicable_premium_4980B(plan, qb, ev, amount);
}

// --- (f)(5)(B): deemed election on behalf of the other qualified beneficiaries ---

pub relation election_specifies_no_election_for(ev: CobraQualifyingEvent, elector: Person, other: Person) kind empirical {
    label en unofficial "section 4980B(f)(5)(B): the election specifies otherwise for the other qualified beneficiary";
}
pub relation election_by_spouse_or_covered_employee_beneficiary(ev: CobraQualifyingEvent, qb: Person) kind institutional {
    label en official "section 4980B(f)(5)(B): the electing qualified beneficiary is described in section 4980B(g)(1)(A)(i) (the spouse) or (B) (the covered employee on a termination or reduced hours)";
}
rule ElectorIsSpouse(ev: CobraQualifyingEvent, qb: Person) defeasible {
    label en official "section 4980B(g)(1)(A)(i)";
    when was_beneficiary_day_before_event_as(qb, ev, SpouseOfCoveredEmployee);
    then election_by_spouse_or_covered_employee_beneficiary(ev, qb);
}
rule ElectorIsCoveredEmployeeOnTermination(ev: CobraQualifyingEvent, qb: Person) defeasible {
    label en official "section 4980B(g)(1)(B)";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when cobra_event_covered_employee(ev, qb);
    then election_by_spouse_or_covered_employee_beneficiary(ev, qb);
}
pub relation continuation_coverage_elected_or_deemed(ev: CobraQualifyingEvent, qb: Person) kind institutional {
    label en official "section 4980B(f)(1), (5)(B): the qualified beneficiary elected continuation coverage, or an election on his behalf is deemed made by the electing spouse or covered employee";
}
rule ElectedDirectly(ev: CobraQualifyingEvent, qb: Person) defeasible {
    label en official "section 4980B(f)(5)(A): the qualified beneficiary's own election";
    when continuation_coverage_elected(ev, qb);
    then continuation_coverage_elected_or_deemed(ev, qb);
}
rule DeemedElectionOnBehalfOfOthers(ev: CobraQualifyingEvent, elector: Person, other: Person) defeasible {
    label en official "section 4980B(f)(5)(B): an election by a spouse or the covered employee is deemed to include an election on behalf of any other qualified beneficiary who would lose coverage by reason of the qualifying event, unless it specifies otherwise";
    when continuation_coverage_elected(ev, elector);
    when election_by_spouse_or_covered_employee_beneficiary(ev, elector);
    when qualified_beneficiary(other, ev);
    when event_causes_loss_of_coverage(ev, other);
    when elector != other;
    unless election_specifies_no_election_for(ev, elector, other) and continuation_coverage_elected(ev, elector);
    then continuation_coverage_elected_or_deemed(ev, other);
}
pub relation coverage_type_selected(ev: CobraQualifyingEvent, qb: Person, coverage_type: Person) kind empirical {
    label en unofficial "section 4980B(f)(5)(B) last sentence: where the plan offers a choice among types of coverage, each qualified beneficiary's own separate selection among them";
}

// --- (f)(5)(C): TAA-eligible individuals ---

pub relation taa_eligible_individual(qb: Person) kind empirical {
    label en unofficial "section 4980B(f)(5)(C)(iv)(II): an eligible TAA recipient or an eligible alternative TAA recipient (section 35(c)(2)-(3), not modelled)";
}
pub relation taa_related_loss_of_coverage_on(qb: Person, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(5)(C)(iv)(IV): the date of the loss of health benefits coverage associated with the separation from employment that gives rise to TAA eligibility";
}
pub relation becomes_taa_eligible_on(qb: Person, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(5)(C)(i): the date the individual becomes a TAA-eligible individual";
}
pub relation elected_during_taa_related_election_period(qb: Person) kind empirical {
    label en unofficial "section 4980B(f)(5)(C)(iv)(I): the individual elected continuation coverage during the TAA-related election period (the 60-day election period that is a direct consequence of the loss, (iv)(III))";
}
pub relation nonelecting_taa_eligible_individual(qb: Person) kind institutional {
    label en official "section 4980B(f)(5)(C)(iv)(I): a TAA-eligible individual with a TAA-related loss of coverage who did not elect during the TAA-related election period";
}
rule NonelectingTaaEligibleIndividual(qb: Person, loss: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(iv)(I)";
    when taa_eligible_individual(qb);
    when taa_related_loss_of_coverage_on(qb, loss);
    unless elected_during_taa_related_election_period(qb) and taa_eligible_individual(qb) and taa_related_loss_of_coverage_on(qb, loss);
    then nonelecting_taa_eligible_individual(qb);
}
pub relation taa_election_period_start(qb: Person, on: Date) kind institutional {
    label en official "section 4980B(f)(5)(C)(i): the first day of the month in which the individual becomes a TAA-eligible individual";
}
rule TaaElectionPeriodStart(qb: Person, eligible: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(i)";
    when becomes_taa_eligible_on(qb, eligible);
    then taa_election_period_start(qb, month_start_of(eligible));
}
pub relation taa_election_period_end(qb: Person, on: Date) kind institutional {
    label en official "section 4980B(f)(5)(C)(i): the 60-day period that begins on the first day of the month (read as start + 59 days, JUDGMENT CALL)";
}
rule TaaElectionPeriodEnd(qb: Person, start: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(i)";
    when taa_election_period_start(qb, start);
    then taa_election_period_end(qb, add_calendar_period(start, 59 calendar_day));
}
pub relation taa_election_made_on(qb: Person, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(5)(C)(i): the date the nonelecting TAA-eligible individual elects continuation coverage";
}
pub relation taa_election_plan(qb: Person, plan: Person) kind empirical {
    label en unofficial "the group health plan under which the individual elects";
}
pub relation taa_election_valid(qb: Person) kind institutional {
    label en official "section 4980B(f)(5)(C)(i): a nonelecting TAA-eligible individual elects during the 60-day period and not later than 6 months after the TAA-related loss of coverage";
}
rule TaaElectionValid(qb: Person, on: Date, start: Date, endd: Date, loss: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(i)";
    when nonelecting_taa_eligible_individual(qb);
    when taa_election_made_on(qb, on);
    when taa_election_period_start(qb, start);
    when taa_election_period_end(qb, endd);
    when taa_related_loss_of_coverage_on(qb, loss);
    when on >= start;
    when on <= endd;
    when on <= add_calendar_period(loss, 6 calendar_month);
    then taa_election_valid(qb);
}
pub relation taa_continuation_coverage_elected(qb: Person) kind institutional {
    label en official "section 4980B(f)(5)(C)(i): the temporary TAA election is effective";
}
rule S4980BTaaElectionPowerRule(qb: Person, plan: Person, on: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(i): a nonelecting TAA-eligible individual may elect continuation coverage during the 60-day period that begins on the first day of the month in which the individual becomes TAA-eligible, but only if the election is made not later than 6 months after the loss of coverage";
    when taa_election_made_on(qb, on);
    when taa_election_plan(qb, plan);
    then power S4980BTaaElection {
        holder qb;
        over plan;
        exercise taa_election_made_on(qb, on);
        valid_when taa_election_valid(qb);
        effect create(taa_continuation_coverage_elected(qb));
        window [-infinity, infinity];
    };
}
pub relation taa_coverage_commences_on(qb: Person, on: Date) kind institutional {
    label en official "section 4980B(f)(5)(C)(ii): the coverage commences at the beginning of the 60-day election period and includes no earlier period (no reach-back)";
}
rule TaaCoverageCommences(qb: Person, start: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(ii)";
    when taa_continuation_coverage_elected(qb);
    when taa_election_period_start(qb, start);
    then taa_coverage_commences_on(qb, start);
}
pub relation taa_period_disregarded_for_63_day_rule(qb: Person, from: Date, to: Date) kind institutional {
    label en official "section 4980B(f)(5)(C)(iii): the period from the TAA-related loss of coverage to the first day of the 60-day election period is disregarded for the 63-day periods of section 9801(c)(2), ERISA 701(c)(2) and PHSA 2704(c)(2)";
}
rule TaaPeriodDisregarded(qb: Person, loss: Date, start: Date) defeasible {
    label en official "section 4980B(f)(5)(C)(iii)";
    when taa_continuation_coverage_elected(qb);
    when taa_related_loss_of_coverage_on(qb, loss);
    when taa_election_period_start(qb, start);
    then taa_period_disregarded_for_63_day_rule(qb, loss, start);
}

// --- (f)(2)(B)(i)(V)-(VI): PBGC recipients and TAA-eligible individuals ---

pub relation covered_employee_has_pbgc_paid_benefit(ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "section 4980B(f)(2)(B)(i)(V): as of the qualifying event the covered employee has a nonforfeitable right to a benefit any portion of which is to be paid by the PBGC under title IV of ERISA";
}
pub relation covered_employee_death_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(2)(B)(i)(V): the date of the death of the covered employee";
}
pub relation pbgc_special_period_rule_applies(ev: CobraQualifyingEvent) kind institutional {
    label en official "section 4980B(f)(2)(B)(i)(V): a termination or reduced hours event on or before January 1, 2014 for a covered employee with a PBGC-paid benefit displaces subclauses (I) and (II)";
}
rule PbgcSpecialPeriodRuleApplies(ev: CobraQualifyingEvent, evd: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(V)";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when covered_employee_has_pbgc_paid_benefit(ev);
    when cobra_event_on(ev, evd);
    when evd <= @2014-01-01;
    then pbgc_special_period_rule_applies(ev);
}
rule PeriodCandidatePbgcCap(ev: CobraQualifyingEvent, qb: Person) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(V), last sentence: no period of coverage is required to extend beyond January 1, 2014";
    when pbgc_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    then cobra_period_end_candidate(ev, qb, @2014-01-01);
}
rule PeriodCandidatePbgcEmployeeDeath(ev: CobraQualifyingEvent, qb: Person, death: Date, e0: Person) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(V): the covered employee's coverage runs to the date of his death";
    when pbgc_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_covered_employee(ev, e0);
    when qb == e0;
    when covered_employee_death_on(ev, death);
    then cobra_period_end_candidate(ev, qb, death);
}
rule PeriodCandidatePbgcDependentsDeath(ev: CobraQualifyingEvent, qb: Person, death: Date, e0: Person) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(V): the surviving spouse or dependent children's coverage runs to 24 months after the covered employee's death";
    when pbgc_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_covered_employee(ev, e0);
    when qb != e0;
    when covered_employee_death_on(ev, death);
    then cobra_period_end_candidate(ev, qb, add_calendar_period(death, 24 calendar_month));
}
pub relation covered_employee_taa_eligible_when_period_would_end(ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "section 4980B(f)(2)(B)(i)(VI): as of the date the period would otherwise terminate under (I) or (II) the covered employee is a TAA-eligible individual";
}
pub relation covered_employee_taa_eligibility_ceases_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en unofficial "section 4980B(f)(2)(B)(i)(VI): the date on which the individual ceases to be a TAA-eligible individual";
}
pub relation taa_special_period_rule_applies(ev: CobraQualifyingEvent) kind institutional {
    label en official "section 4980B(f)(2)(B)(i)(VI): a termination or reduced hours event on or before January 1, 2014 for a covered employee who is a TAA-eligible individual when the period would otherwise end";
}
rule TaaSpecialPeriodRuleApplies(ev: CobraQualifyingEvent, evd: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VI)";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when covered_employee_taa_eligible_when_period_would_end(ev);
    when cobra_event_on(ev, evd);
    when evd <= @2014-01-01;
    then taa_special_period_rule_applies(ev);
}
rule PeriodCandidateTaaLaterOfBaseAndCeasing18(ev: CobraQualifyingEvent, qb: Person, evd: Date, ceases: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VI): not before the later of the 18-month date and the date the individual ceases to be TAA-eligible (capped at January 1, 2014)";
    when taa_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when covered_employee_taa_eligibility_ceases_on(ev, ceases);
    when ceases > add_calendar_period(evd, 18 calendar_month);
    when ceases <= @2014-01-01;
    unless second_qualifying_event_within_18_months_on(ev, _) and cobra_event_on(ev, evd) and qualified_beneficiary(qb, ev) and covered_employee_taa_eligibility_ceases_on(ev, ceases);
    then cobra_period_end_candidate(ev, qb, ceases);
}
rule PeriodCandidateTaaBaseStands18(ev: CobraQualifyingEvent, qb: Person, evd: Date, ceases: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VI): the 18-month date is later than (or equal to) the ceasing date, so it stands";
    when taa_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when covered_employee_taa_eligibility_ceases_on(ev, ceases);
    when ceases <= add_calendar_period(evd, 18 calendar_month);
    unless second_qualifying_event_within_18_months_on(ev, _) and cobra_event_on(ev, evd) and qualified_beneficiary(qb, ev);
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 18 calendar_month));
}
rule PeriodCandidateTaaCapWhenCeasingAfterCap18(ev: CobraQualifyingEvent, qb: Person, evd: Date, ceases: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VI), last sentence: no required period beyond January 1, 2014";
    when taa_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when covered_employee_taa_eligibility_ceases_on(ev, ceases);
    when ceases > @2014-01-01;
    when @2014-01-01 > add_calendar_period(evd, 18 calendar_month);
    unless second_qualifying_event_within_18_months_on(ev, _) and cobra_event_on(ev, evd) and qualified_beneficiary(qb, ev);
    then cobra_period_end_candidate(ev, qb, @2014-01-01);
}
rule PeriodCandidateTaaCapBelowBase18(ev: CobraQualifyingEvent, qb: Person, evd: Date, ceases: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VI): the 18-month date is already past January 1, 2014, so it stands";
    when taa_special_period_rule_applies(ev);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when covered_employee_taa_eligibility_ceases_on(ev, ceases);
    when ceases > @2014-01-01;
    when @2014-01-01 <= add_calendar_period(evd, 18 calendar_month);
    unless second_qualifying_event_within_18_months_on(ev, _) and cobra_event_on(ev, evd) and qualified_beneficiary(qb, ev);
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 18 calendar_month));
}

// --- (f)(8): optional extension safe harbor ---

pub relation plan_period_of_coverage_runs_from_loss_of_coverage(plan: Person) kind empirical {
    label en unofficial "section 4980B(f)(8)(A): the plan provides that the period of extended coverage in paragraph (2)(B) commences with the date of the loss of coverage";
}
pub relation plan_notice_period_runs_from_loss_of_coverage(plan: Person) kind empirical {
    label en unofficial "section 4980B(f)(8)(B): the plan provides that the applicable notice period under paragraph (6)(B) commences with the date of the loss of coverage";
}
pub relation optional_extension_is_not_a_failure(plan: Person) kind institutional {
    label en official "section 4980B(f)(8): a plan providing both (A) and (B) is not treated as failing to meet subsection (f) solely because of it";
}
rule OptionalExtensionIsNotAFailure(plan: Person) defeasible {
    label en official "section 4980B(f)(8)";
    when plan_period_of_coverage_runs_from_loss_of_coverage(plan);
    when plan_notice_period_runs_from_loss_of_coverage(plan);
    then optional_extension_is_not_a_failure(plan);
}
pub relation cobra_failure_solely_from_loss_dating(a: ExciseAct) kind empirical {
    label en unofficial "the only failure alleged is that the plan dates the coverage period and the notice period from the date of the loss of coverage";
}
pub relation cobra_failure_excused_by_optional_extension(a: ExciseAct) kind institutional {
    label en official "section 4980B(f)(8): the failure arises solely from the optional dating and the plan provides both (A) and (B)";
}
rule CobraFailureExcusedByOptionalExtension(a: ExciseAct, plan: Person) defeasible {
    label en official "section 4980B(f)(8)";
    when cobra_failure_plan(a, plan);
    when cobra_failure_solely_from_loss_dating(a);
    when optional_extension_is_not_a_failure(plan);
    then cobra_failure_excused_by_optional_extension(a);
}

// --- (g)(4): correction ---

pub relation failure_retroactively_undone_to_extent_possible(a: ExciseAct) kind empirical {
    label en unofficial "section 4980B(g)(4)(A): the failure is retroactively undone to the extent possible";
}
pub relation beneficiary_placed_in_as_good_position(a: ExciseAct) kind empirical {
    label en unofficial "section 4980B(g)(4)(B): the qualified beneficiary is placed in a financial position as good as he would have been in had the failure not occurred, treating him as having elected the most favorable coverage in light of the expenses incurred since the failure first occurred";
}
pub relation cobra_failure_corrected_4980Bg4(a: ExciseAct) kind institutional {
    label en official "section 4980B(g)(4): the failure is treated as corrected (the act_corrected_on date of the case is meaningful only when this holds)";
}
rule CobraFailureCorrected(a: ExciseAct) defeasible {
    label en official "section 4980B(g)(4)(A)-(B)";
    when failure_retroactively_undone_to_extent_possible(a);
    when beneficiary_placed_in_as_good_position(a);
    then cobra_failure_corrected_4980Bg4(a);
}
