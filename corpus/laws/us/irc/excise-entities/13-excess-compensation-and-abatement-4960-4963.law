// Section 4960 (tax on excess tax-exempt organization executive compensation)
// with the Pub. L. 119-21 section 70416 revision of the covered-employee
// definition, and subchapter E of chapter 42: sections 4961 (abatement of second
// tier taxes when the event is corrected), 4962 (abatement of qualified first tier
// taxes for reasonable cause), 4963 (definitions: first/second tier tax, taxable
// event, correct, correction period). Stage 2 (DECISION-0379).
//
// SECTION 4960
//  - (a)/(b): rate under section 11 times (remuneration over $1,000,000 excluding
//    excess parachute payments + excess parachute payments), owed by the employer.
//    The section 11 rate is a case-asserted fact (`section_11_rate`): the
//    `us.irc.corporations::corporate_tax_rate` head is keyed by a Corporation with
//    taxable income, and an exempt organization is not one (EXTERNAL_DEPENDENCY,
//    see coverage row).
//  - (c)(2) covered employee has TWO editions. 2024 text: one of the 5 highest
//    compensated employees, or covered for an earlier year after 2016. Pub. L.
//    119-21 section 70416(a) (enacted 2025-07-04): every employee or former
//    employee of an applicable tax-exempt organization who was such in any taxable
//    year beginning after Dec. 31, 2016; applicable to taxable years BEGINNING after
//    Dec. 31, 2025 (section 70416(b)). Both rules guard on the beginning date of the
//    taxable year; the amending rule additionally carries the `effective` window
//    from the enactment date and cites the temporal fragment.
//  - (c)(3) remuneration: wages under section 3401(a) less designated Roth
//    contributions plus section 457(f) inclusions less medical-services portions;
//    (c)(6): remuneration whose deduction is disallowed by section 162(m) is
//    disregarded. Each component is a case fact (wages under 3401(a) and 457(f) are
//    other owners' computations — EXTERNAL_DEPENDENCY).
//  - (c)(4): related-organization remuneration is added; liability among several
//    employers is proportional to remuneration paid (`div_round`, cents HALF_UP —
//    JUDGMENT CALL, the statute names no rounding).
//  - (c)(5): excess parachute payment: separation-contingent present value at
//    least 3 times the base amount, less the base amount allocated; the base amount
//    and its allocation are case facts because "rules similar to section 280G(b)(3)"
//    and 280G(d)(3)-(4) are not implemented for this section (G2505).
//
// SUBCHAPTER E
//  - 4963 definitions: the taxable events, first and second tier taxes over the
//    shared `initial_tax` / `additional_tax` heads; correction period with the
//    90-day rule (literal day count) and the two extension candidates (later of).
//  - 4961/4962: the abatement is modelled as an IMMUNITY of the taxpayer against
//    assessment of the tax, with a Secretary duty to abate/refund where an
//    assessment exists; "established to the satisfaction of the Secretary" is an
//    external judgment relation (DECISION-0194). 4961(b) is a power of the court.

// ============================================================================
// Section 4960
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4960_A,
    IRC_S4960_B,
    IRC_S4960_C,
    IRC_S4961_A,
    IRC_S4961_B,
    IRC_S4961_C,
    IRC_S4962_A,
    IRC_S4962_B,
    IRC_S4962_C,
    IRC_S4963_A,
    IRC_S4963_B,
    IRC_S4963_C,
    IRC_S4963_D,
    IRC_S4963_E,
    Notice,
    Person,
    TaxableYear,
    act_corrected_on,
    additional_tax,
    excise_act_kind,
    excise_act_occurred_on,
    initial_tax,
    investment_removed_from_jeopardy_on,
};

pub relation farmers_cooperative_521b1(org: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(1)(B): the organization is a farmers' cooperative organization described in section 521(b)(1) for the taxable year";
}
pub relation income_excluded_under_section_115_1(org: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(1)(C): the organization has income excluded from taxation under section 115(1) for the taxable year";
}
pub relation political_organization_527e1(org: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(1)(D): the organization is a political organization described in section 527(e)(1) for the taxable year";
}
@source(IRC_S4960_C, coverage = exact, quote = "The term \"applicable tax-exempt organization\" means any organization which for the taxable year—")
pub relation applicable_tax_exempt_organization_4960(org: Person, y: TaxableYear) kind institutional {
    label en official "section 4960(c)(1): exempt under 501(a), a farmers' cooperative, an organization with section 115(1) income, or a section 527(e)(1) political organization";
}
@source(IRC_S4960_C, coverage = exact, quote = "is exempt from taxation under section 501(a),")
rule ApplicableOrganizationExempt501a(org: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(1)(A): exempt from taxation under section 501(a)";
    when us.irc.exempt_organizations::exempt_organization(org, y);
    then applicable_tax_exempt_organization_4960(org, y);
}
@source(IRC_S4960_C, coverage = exact, quote = "is a farmers' cooperative organization described in section 521(b)(1),")
rule ApplicableOrganizationFarmersCooperative(org: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(1)(B): farmers' cooperative organization";
    when farmers_cooperative_521b1(org, y);
    then applicable_tax_exempt_organization_4960(org, y);
}
@source(IRC_S4960_C, coverage = exact, quote = "has income excluded from taxation under section 115(1), or")
rule ApplicableOrganizationSection115(org: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(1)(C): income excluded under section 115(1)";
    when income_excluded_under_section_115_1(org, y);
    then applicable_tax_exempt_organization_4960(org, y);
}
@source(IRC_S4960_C, coverage = exact, quote = "is a political organization described in section 527(e)(1).")
rule ApplicableOrganizationPolitical(org: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(1)(D): political organization";
    when political_organization_527e1(org, y);
    then applicable_tax_exempt_organization_4960(org, y);
}

// (c)(2): covered employee — two editions.
pub relation one_of_five_highest_compensated_employees(e: Person, org: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(2)(A), 2024 text: the employee is one of the 5 highest compensated employees of the organization for the taxable year";
}
pub relation covered_employee_of_org_or_predecessor_for_earlier_year(e: Person, org: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(2)(B), 2024 text: the employee was a covered employee of the organization (or any predecessor) for a preceding taxable year beginning after December 31, 2016";
}
pub relation employee_or_former_employee_in_year_after_2016(e: Person, org: Person) kind empirical {
    label en official "section 4960(c)(2) as amended by Pub. L. 119-21 section 70416(a): the person is an employee or former employee of the organization (or predecessor) who was such an employee during any taxable year beginning after December 31, 2016";
}
@source(IRC_S4960_C, coverage = exact, quote = "the term \"covered employee\" means any employee (including any former employee) of an applicable tax-exempt organization if the employee—")
pub relation covered_employee_4960(e: Person, org: Person, y: TaxableYear) kind institutional {
    label en official "section 4960(c)(2): a covered employee of the applicable tax-exempt organization for the taxable year";
}
@source(IRC_S4960_C, coverage = exact, quote = "is one of the 5 highest compensated employees of the organization for the taxable year, or")
rule CoveredEmployeeTopFiveBeforeAmendment(e: Person, org: Person, y: TaxableYear, d: Date) defeasible {
    label en official "section 4960(c)(2)(A), 2024 text: one of the 5 highest compensated employees, for taxable years beginning before 2026 (applicability of Pub. L. 119-21 section 70416(b) is by the taxable year's beginning date)";
    when applicable_tax_exempt_organization_4960(org, y);
    when us.irc.core::begins(y, d);
    when d <= @2025-12-31;
    when one_of_five_highest_compensated_employees(e, org, y);
    then covered_employee_4960(e, org, y);
}
@source(IRC_S4960_C, coverage = exact, quote = "was a covered employee of the organization (or any predecessor) for any preceding taxable year beginning after December 31, 2016.")
rule CoveredEmployeeCoveredBeforeBeforeAmendment(e: Person, org: Person, y: TaxableYear, d: Date) defeasible {
    label en official "section 4960(c)(2)(B), 2024 text: covered for a preceding taxable year beginning after 2016, for taxable years beginning before 2026";
    when applicable_tax_exempt_organization_4960(org, y);
    when us.irc.core::begins(y, d);
    when d <= @2025-12-31;
    when covered_employee_of_org_or_predecessor_for_earlier_year(e, org, y);
    then covered_employee_4960(e, org, y);
}
@source(us.irc.temporal::PL119_21_S70416, relation = derives_from, quote = "any employee of an applicable tax-exempt organization (or any predecessor of such an organization) and any former employee of such an organization (or predecessor) who was such an employee during any taxable year beginning after December 31, 2016")
rule CoveredEmployeeAfterPl11921(e: Person, org: Person, y: TaxableYear, d: Date) defeasible {
    label en official "Pub. L. 119-21 section 70416(a): every employee or former employee who was such an employee in any taxable year beginning after 2016 is covered, for taxable years beginning after December 31, 2025";
    effective [@2025-07-04, infinity);
    when applicable_tax_exempt_organization_4960(org, y);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    when employee_or_former_employee_in_year_after_2016(e, org);
    then covered_employee_4960(e, org, y);
}

// (c)(3), (c)(6): remuneration of one employer.
pub relation wages_3401a_paid(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(3)(A): wages (as defined in section 3401(a)) paid by the organization to the employee for the taxable year (EXTERNAL_DEPENDENCY: the wages computation is another owner's)";
}
pub relation designated_roth_contributions_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(3)(A): designated Roth contributions (section 402A(c)), excluded from remuneration";
}
pub relation section_457f_inclusions_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(3)(A): amounts required to be included in gross income under section 457(f), included in remuneration";
}
pub relation medical_services_portion_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(3)(B): the portion of remuneration paid to a licensed medical professional for the performance of medical or veterinary services";
}
pub relation deduction_disallowed_under_162m(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(6): remuneration whose deduction is not allowed by reason of section 162(m)";
}
@source(IRC_S4960_C, coverage = exact, quote = "The term \"remuneration\" means wages (as defined in section 3401(a)), except that such term shall not include any designated Roth contribution (as defined in section 402A(c)) and shall include amounts required to be included in gross income under section 457(f).")
pub relation remuneration_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4960(c)(3), (6): remuneration of the covered employee paid by this employer: wages less designated Roth contributions plus section 457(f) inclusions, less the medical-services portion and the amounts disallowed under section 162(m)";
}
rule Remuneration4960(org: Person, e: Person, y: TaxableYear, w: Money, roth: Money, inc: Money, med: Money, dis: Money) defeasible {
    label en official "section 4960(c)(3), (6): wages − designated Roth + 457(f) inclusions − medical portion − 162(m)-disallowed remuneration";
    when wages_3401a_paid(org, e, y, w);
    when designated_roth_contributions_4960(org, e, y, roth);
    when section_457f_inclusions_4960(org, e, y, inc);
    when medical_services_portion_4960(org, e, y, med);
    when deduction_disallowed_under_162m(org, e, y, dis);
    then remuneration_4960(org, e, y, w - roth + inc - med - dis);
}

// (c)(4): remuneration from related persons or governmental entities.
pub relation controls_or_controlled_by_org_4960(org: Person, other: Person) kind empirical {
    label en official "section 4960(c)(4)(B)(i): the person controls, or is controlled by, the organization";
}
pub relation controlled_by_controllers_of_org_4960(org: Person, other: Person) kind empirical {
    label en official "section 4960(c)(4)(B)(ii): the person is controlled by one or more persons which control the organization";
}
pub relation supported_organization_of_org_4960(org: Person, other: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(4)(B)(iii): the person is a supported organization (section 509(f)(3)) of the organization during the taxable year";
}
pub relation supporting_organization_of_org_4960(org: Person, other: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(4)(B)(iv): the person is a section 509(a)(3) supporting organization of the organization during the taxable year";
}
pub relation voluntary_employees_beneficiary_association_sponsor_4960(org: Person, other: Person) kind empirical {
    label en official "section 4960(c)(4)(B)(v): for a section 501(c)(9) organization, the person establishes, maintains, or contributes to it";
}
@source(IRC_S4960_C, coverage = exact, quote = "A person or governmental entity shall be treated as related to an applicable tax-exempt organization if such person or governmental entity—")
pub relation related_to_applicable_organization_4960(org: Person, other: Person, y: TaxableYear) kind institutional {
    label en official "section 4960(c)(4)(B): the person or governmental entity is related to the applicable tax-exempt organization";
}
rule RelatedByControl(org: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(4)(B)(i)";
    when applicable_tax_exempt_organization_4960(org, y);
    when controls_or_controlled_by_org_4960(org, other);
    then related_to_applicable_organization_4960(org, other, y);
}
rule RelatedByCommonControl(org: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(4)(B)(ii)";
    when applicable_tax_exempt_organization_4960(org, y);
    when controlled_by_controllers_of_org_4960(org, other);
    then related_to_applicable_organization_4960(org, other, y);
}
rule RelatedAsSupportedOrganization(org: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(4)(B)(iii)";
    when applicable_tax_exempt_organization_4960(org, y);
    when supported_organization_of_org_4960(org, other, y);
    then related_to_applicable_organization_4960(org, other, y);
}
rule RelatedAsSupportingOrganization(org: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(4)(B)(iv)";
    when applicable_tax_exempt_organization_4960(org, y);
    when supporting_organization_of_org_4960(org, other, y);
    then related_to_applicable_organization_4960(org, other, y);
}
rule RelatedAsVebaSponsor(org: Person, other: Person, y: TaxableYear) defeasible {
    label en official "section 4960(c)(4)(B)(v)";
    when applicable_tax_exempt_organization_4960(org, y);
    when voluntary_employees_beneficiary_association_sponsor_4960(org, other);
    then related_to_applicable_organization_4960(org, other, y);
}
pub relation related_remuneration_paid(org: Person, related: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(4)(A): the remuneration (determined under (c)(3), (c)(6)) paid by the related person or governmental entity with respect to the covered employee's employment by it";
}
@source(IRC_S4960_C, coverage = exact, quote = "Remuneration of a covered employee by an applicable tax-exempt organization shall include any remuneration paid with respect to employment of such employee by any related person or governmental entity.")
pub relation remuneration_by_employer_4960(org: Person, e: Person, y: TaxableYear, employer: Person, amount: Money) kind institutional {
    label en official "section 4960(c)(4)(A): one employer's remuneration of the covered employee that counts toward the organization's tax (the organization's own and each related person's)";
}
rule OwnRemunerationByEmployer(org: Person, e: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "the organization's own remuneration counts";
    when covered_employee_4960(e, org, y);
    when remuneration_4960(org, e, y, amt);
    then remuneration_by_employer_4960(org, e, y, org, amt);
}
rule RelatedRemunerationByEmployer(org: Person, e: Person, y: TaxableYear, rel: Person, amt: Money) defeasible {
    label en official "section 4960(c)(4)(A): a related person's remuneration counts";
    when covered_employee_4960(e, org, y);
    when related_to_applicable_organization_4960(org, rel, y);
    when related_remuneration_paid(org, rel, e, y, amt);
    then remuneration_by_employer_4960(org, e, y, rel, amt);
}
pub relation total_remuneration_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4960(a)(1), (c)(4): the sum of remuneration by all employers counted for the covered employee";
}
rule TotalRemuneration4960(org: Person, e: Person, y: TaxableYear) defeasible {
    label en official "sum of the remuneration counted for the covered employee across the organization and its related persons";
    when covered_employee_4960(e, org, y);
    then total_remuneration_4960(org, e, y, sum(collect all a: Money, emp: Person where remuneration_by_employer_4960(org, e, y, emp, a), empty: 0.00 USD));
}

// (c)(5): excess parachute payment.
pub relation separation_contingent_payments_present_value(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(5)(B)(ii): the aggregate present value of payments in the nature of compensation contingent on the employee's separation from employment (present value by section 280G(d)(4) rules — G2505)";
}
pub relation base_amount_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(5)(D): the base amount, by rules similar to section 280G(b)(3) (G2505)";
}
pub relation base_amount_allocated_to_parachute_payment(org: Person, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4960(c)(5)(A): the portion of the base amount allocated to the parachute payment";
}
pub relation parachute_payment_excepted_4960(org: Person, e: Person, y: TaxableYear) kind empirical {
    label en official "section 4960(c)(5)(C): the payment is (i) described in 280G(b)(6), (ii) under a 403(b) annuity contract or 457(b) plan, (iii) to a licensed medical professional for medical or veterinary services, or (iv) to an individual who is not a highly compensated employee under 414(q)";
}
@source(IRC_S4960_C, coverage = exact, quote = "The term \"excess parachute payment\" means an amount equal to the excess of any parachute payment over the portion of the base amount allocated to such payment.")
pub relation excess_parachute_payment_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4960(c)(5)(A): the excess of the parachute payment over the base amount allocated to it, where the separation-contingent payments equal or exceed 3 times the base amount";
}
@source(IRC_S4960_C, coverage = exact, quote = "the aggregate present value of the payments in the nature of compensation to (or for the benefit of) such individual which are contingent on such separation equals or exceeds an amount equal to 3 times the base amount.")
rule ExcessParachutePayment4960(org: Person, e: Person, y: TaxableYear, pv: Money, base: Money, alloc: Money) defeasible {
    label en official "section 4960(c)(5): a separation-contingent payment whose present value is at least 3 times the base amount is a parachute payment; the excess over the allocated base amount is an excess parachute payment";
    when covered_employee_4960(e, org, y);
    when separation_contingent_payments_present_value(org, e, y, pv);
    when base_amount_4960(org, e, y, base);
    when base_amount_allocated_to_parachute_payment(org, e, y, alloc);
    when pv >= base * ParachuteTriggerMultiple4960;
    when pv > alloc;
    unless parachute_payment_excepted_4960(org, e, y) and separation_contingent_payments_present_value(org, e, y, pv) and base_amount_4960(org, e, y, base) and base_amount_allocated_to_parachute_payment(org, e, y, alloc);
    then excess_parachute_payment_4960(org, e, y, pv - alloc);
}

// (a): the tax.
pub relation section_11_rate(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "section 4960(a): the rate of tax under section 11 for the taxable year (EXTERNAL_DEPENDENCY on us.irc.corporations, whose corporate_tax_rate head is keyed by a Corporation)";
}
pub relation remuneration_over_threshold_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4960(a)(1): remuneration (other than excess parachute payments) in excess of $1,000,000";
}
rule RemunerationOverThreshold4960(org: Person, e: Person, y: TaxableYear, total: Money, ep: Money) defeasible {
    label en official "section 4960(a)(1): total remuneration less excess parachute payments, over $1,000,000";
    when total_remuneration_4960(org, e, y, total);
    when excess_parachute_payment_4960(org, e, y, ep);
    when total - ep > CoveredRemunerationThreshold4960;
    then remuneration_over_threshold_4960(org, e, y, total - ep - CoveredRemunerationThreshold4960);
}
rule RemunerationOverThreshold4960NoParachute(org: Person, e: Person, y: TaxableYear, total: Money) defeasible {
    label en official "section 4960(a)(1): with no excess parachute payment, total remuneration over $1,000,000";
    when total_remuneration_4960(org, e, y, total);
    when total > CoveredRemunerationThreshold4960;
    unless excess_parachute_payment_4960(org, e, y, _) and total_remuneration_4960(org, e, y, total);
    then remuneration_over_threshold_4960(org, e, y, total - CoveredRemunerationThreshold4960);
}
@source(IRC_S4960_A, coverage = exact, quote = "There is hereby imposed a tax equal to the product of the rate of tax under section 11 and the sum of—")
pub relation excess_remuneration_tax_4960(org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4960(a): the section 11 rate times the sum of the remuneration over $1,000,000 and the excess parachute payments, for one covered employee (before allocation among employers)";
}
rule ExcessRemunerationTaxWithBoth(org: Person, e: Person, y: TaxableYear, r: Decimal, ov: Money, ep: Money) defeasible {
    label en official "section 4960(a)(1)+(2): rate × (remuneration over $1,000,000 + excess parachute payments)";
    when section_11_rate(y, r);
    when remuneration_over_threshold_4960(org, e, y, ov);
    when excess_parachute_payment_4960(org, e, y, ep);
    then excess_remuneration_tax_4960(org, e, y, round((ov + ep) * r, 2, "HALF_UP"));
}
rule ExcessRemunerationTaxOverOnly(org: Person, e: Person, y: TaxableYear, r: Decimal, ov: Money) defeasible {
    label en official "section 4960(a)(1): rate × remuneration over $1,000,000 when there is no excess parachute payment";
    when section_11_rate(y, r);
    when remuneration_over_threshold_4960(org, e, y, ov);
    unless excess_parachute_payment_4960(org, e, y, _) and section_11_rate(y, r) and remuneration_over_threshold_4960(org, e, y, ov);
    then excess_remuneration_tax_4960(org, e, y, round(ov * r, 2, "HALF_UP"));
}
rule ExcessRemunerationTaxParachuteOnly(org: Person, e: Person, y: TaxableYear, r: Decimal, ep: Money) defeasible {
    label en official "section 4960(a)(2): rate × excess parachute payments when the remuneration does not exceed $1,000,000";
    when section_11_rate(y, r);
    when excess_parachute_payment_4960(org, e, y, ep);
    unless remuneration_over_threshold_4960(org, e, y, _) and section_11_rate(y, r) and excess_parachute_payment_4960(org, e, y, ep);
    then excess_remuneration_tax_4960(org, e, y, round(ep * r, 2, "HALF_UP"));
}
@source(IRC_S4960_B, coverage = exact, quote = "The employer shall be liable for the tax imposed under subsection (a).")
pub relation liable_for_4960_tax(employer: Person, org: Person, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 4960(b), (c)(4)(C): each employer whose remuneration is counted is liable for the share of the tax equal to its share of the total remuneration";
}
rule LiableForShareOf4960Tax(employer: Person, org: Person, e: Person, y: TaxableYear, tax: Money, own: Money, total: Money) defeasible {
    label en official "section 4960(c)(4)(C): tax × (this employer's remuneration ÷ all employers' remuneration), cents HALF_UP (JUDGMENT CALL: no rounding is named)";
    when excess_remuneration_tax_4960(org, e, y, tax);
    when remuneration_by_employer_4960(org, e, y, employer, own);
    when total_remuneration_4960(org, e, y, total);
    then liable_for_4960_tax(employer, org, e, y, div_round(tax * (own / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}

// ============================================================================
// Section 4963 — definitions
// ============================================================================

@source(IRC_S4963_C, coverage = exact, quote = "the term \"taxable event\" means any act (or failure to act) giving rise to liability for tax under section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4966, 4967, 4971, or 4975.")
pub relation taxable_event(a: ExciseAct) kind institutional {
    label en official "section 4963(c): an act (or failure to act) giving rise to liability for tax under section 4941-4945, 4951, 4952, 4955, 4958, 4966, 4967, 4971 or 4975";
}
rule TaxableEventSelfDealing(a: ExciseAct) defeasible { label en official "4963(c): section 4941"; when excise_act_kind(a, SelfDealingAct); then taxable_event(a); }
rule TaxableEventUndistributedIncome(a: ExciseAct) defeasible { label en official "4963(c): section 4942"; when excise_act_kind(a, UndistributedIncomeYear); then taxable_event(a); }
rule TaxableEventExcessBusinessHoldings(a: ExciseAct) defeasible { label en official "4963(c): section 4943"; when excise_act_kind(a, ExcessBusinessHolding); then taxable_event(a); }
rule TaxableEventJeopardizingInvestment(a: ExciseAct) defeasible { label en official "4963(c): section 4944"; when excise_act_kind(a, JeopardizingInvestment); then taxable_event(a); }
rule TaxableEventTaxableExpenditure(a: ExciseAct) defeasible { label en official "4963(c): section 4945"; when excise_act_kind(a, TaxableExpenditure); then taxable_event(a); }
rule TaxableEventTrustSelfDealing(a: ExciseAct) defeasible { label en official "4963(c): section 4951"; when excise_act_kind(a, TrustSelfDealingAct); then taxable_event(a); }
rule TaxableEventTrustExpenditure(a: ExciseAct) defeasible { label en official "4963(c): section 4952"; when excise_act_kind(a, TrustTaxableExpenditure); then taxable_event(a); }
rule TaxableEventPoliticalExpenditure(a: ExciseAct) defeasible { label en official "4963(c): section 4955"; when excise_act_kind(a, PoliticalExpenditure); then taxable_event(a); }
rule TaxableEventExcessBenefit(a: ExciseAct) defeasible { label en official "4963(c): section 4958"; when excise_act_kind(a, ExcessBenefitTransaction); then taxable_event(a); }
rule TaxableEventProhibitedTransaction(a: ExciseAct) defeasible { label en official "4963(c): section 4975"; when excise_act_kind(a, ProhibitedTransaction); then taxable_event(a); }

@source(IRC_S4963_A, coverage = exact, quote = "the term \"first tier tax\" means any tax imposed by subsection (a) of section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4966, 4967, 4971, or 4975.")
pub relation first_tier_tax(a: ExciseAct, bearer: Person, amount: Money) kind institutional {
    label en official "section 4963(a): a tax imposed by subsection (a) of the listed sections on a taxable event";
}
rule FirstTierTax(a: ExciseAct, bearer: Person, amount: Money) defeasible {
    label en official "section 4963(a): the shared initial tax on a taxable event is a first tier tax";
    when taxable_event(a);
    when initial_tax(a, bearer, amount);
    then first_tier_tax(a, bearer, amount);
}
@source(IRC_S4963_B, coverage = exact, quote = "the term \"second tier tax\" means any tax imposed by subsection (b) of section 4941, 4942, 4943, 4944, 4945, 4951, 4952, 4955, 4958, 4971, or 4975.")
pub relation second_tier_tax(a: ExciseAct, bearer: Person, amount: Money) kind institutional {
    label en official "section 4963(b): a tax imposed by subsection (b) of the listed sections on a taxable event";
}
rule SecondTierTax(a: ExciseAct, bearer: Person, amount: Money) defeasible {
    label en official "section 4963(b): the shared additional tax on a taxable event is a second tier tax";
    when taxable_event(a);
    when additional_tax(a, bearer, amount);
    then second_tier_tax(a, bearer, amount);
}

// (d): correct.
pub relation undistributed_income_reduced_to_zero_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4963(d)(2)(A): the date the amount of the undistributed income was reduced to zero";
}
pub relation excess_business_holdings_reduced_to_zero_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4963(d)(2)(B): the date the amount of the excess business holdings was reduced to zero";
}
@source(IRC_S4963_D, coverage = exact, quote = "Except as provided in paragraph (2), the term \"correct\" has the same meaning as when used in the section which imposes the second tier tax.")
pub relation corrected_on_for_4963(a: ExciseAct, on: Date) kind institutional {
    label en official "section 4963(d): the date of correction — the correction date of the imposing section, or reduction of undistributed income / excess business holdings to zero, or removal of the investment from jeopardy";
}
rule CorrectedOnGeneral(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(d)(1): correction in the sense of the section imposing the second tier tax";
    when act_corrected_on(a, on);
    then corrected_on_for_4963(a, on);
}
rule CorrectedOnUndistributedIncome(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(d)(2)(A): reducing the undistributed income to zero";
    when excise_act_kind(a, UndistributedIncomeYear);
    when undistributed_income_reduced_to_zero_on(a, on);
    then corrected_on_for_4963(a, on);
}
rule CorrectedOnExcessBusinessHoldings(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(d)(2)(B): reducing the excess business holdings to zero";
    when excise_act_kind(a, ExcessBusinessHolding);
    when excess_business_holdings_reduced_to_zero_on(a, on);
    then corrected_on_for_4963(a, on);
}
rule CorrectedOnJeopardy(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(d)(2)(C): removing the investment from jeopardy";
    when excise_act_kind(a, JeopardizingInvestment);
    when investment_removed_from_jeopardy_on(a, on);
    then corrected_on_for_4963(a, on);
}

// (e)(2): when the taxable event occurs.
pub relation first_day_of_failure_or_holdings(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4963(e)(2)(A)-(B): the first day of the taxable year for which there was a failure to distribute income (4942), or the first day on which there are excess business holdings (4943)";
}
@source(IRC_S4963_E, coverage = exact, quote = "the taxable event shall be treated as occurring—")
pub relation taxable_event_occurs_on(a: ExciseAct, on: Date) kind institutional {
    label en official "section 4963(e)(2): the date the taxable event is treated as occurring";
}
rule TaxableEventOccursOnActDate(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(e)(2)(D): in any other case, the date on which the event occurred";
    when taxable_event(a);
    when excise_act_occurred_on(a, on);
    unless excise_act_kind(a, UndistributedIncomeYear) and excise_act_occurred_on(a, on);
    unless excise_act_kind(a, ExcessBusinessHolding) and excise_act_occurred_on(a, on);
    then taxable_event_occurs_on(a, on);
}
rule TaxableEventOccursOnFirstDay4942(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(e)(2)(A): section 4942 — the first day of the taxable year for which there was a failure to distribute income";
    when excise_act_kind(a, UndistributedIncomeYear);
    when first_day_of_failure_or_holdings(a, on);
    then taxable_event_occurs_on(a, on);
}
rule TaxableEventOccursOnFirstDay4943(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(e)(2)(B): section 4943 — the first day on which there are excess business holdings";
    when excise_act_kind(a, ExcessBusinessHolding);
    when first_day_of_failure_or_holdings(a, on);
    then taxable_event_occurs_on(a, on);
}

// (e)(1): correction period.
pub relation second_tier_notice_of_deficiency(n: Notice, a: ExciseAct) kind institutional {
    label en official "section 4963(e)(1): the section 6212 notice of deficiency is with respect to the second tier tax imposed on this taxable event";
}
pub relation deficiency_assessment_barred_until(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4963(e)(1)(A): the last day of a period in which a deficiency cannot be assessed under section 6213(a) (determined without regard to the last sentence of section 4961(b))";
}
pub relation secretary_determined_correction_extension_until(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4963(e)(1)(B): the last day of any other period the Secretary determines is reasonable and necessary to bring about correction";
}
relation correction_period_end_candidate(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a candidate end of the correction period: 90 days after the notice of deficiency, or an extension end";
}
rule CorrectionPeriodCandidateNinetyDays(a: ExciseAct, n: Notice, mailed: Date) defeasible {
    label en official "section 4963(e)(1): 90 days after the date of mailing of a notice of deficiency with respect to the second tier tax";
    when second_tier_notice_of_deficiency(n, a);
    when us.irc.core::mailed_on(n, mailed);
    then correction_period_end_candidate(a, add_calendar_period(mailed, 90 calendar_day));
}
rule CorrectionPeriodCandidateDeficiencyBar(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(e)(1)(A): extension by the period in which a deficiency cannot be assessed";
    when deficiency_assessment_barred_until(a, on);
    then correction_period_end_candidate(a, on);
}
rule CorrectionPeriodCandidateSecretary(a: ExciseAct, on: Date) defeasible {
    label en official "section 4963(e)(1)(B): extension by any other period the Secretary determines is reasonable and necessary";
    when secretary_determined_correction_extension_until(a, on);
    then correction_period_end_candidate(a, on);
}
relation later_correction_period_end_candidate_exists(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a strictly later candidate exists (pairwise maximum without an aggregate — G136 pattern)";
}
rule LaterCorrectionPeriodCandidateExists(a: ExciseAct, on: Date, on2: Date) defeasible {
    label en unofficial "a strictly later candidate disqualifies this one";
    when correction_period_end_candidate(a, on);
    when correction_period_end_candidate(a, on2);
    when on2 > on;
    then later_correction_period_end_candidate_exists(a, on);
}
@source(IRC_S4963_E, coverage = exact, quote = "The term \"correction period\" means, with respect to any taxable event, the period beginning on the date on which such event occurs and ending 90 days after the date of mailing under section 6212 of a notice of deficiency with respect to the second tier tax imposed on such taxable event, extended by—")
pub relation correction_period(a: ExciseAct, begins: Date, ends: Date) kind institutional {
    label en official "section 4963(e)(1): from the date the taxable event occurs to 90 days after mailing of the second tier notice of deficiency, extended by the (A) and (B) periods";
}
rule CorrectionPeriod(a: ExciseAct, begins: Date, ends: Date) defeasible {
    label en official "section 4963(e)(1): begins when the event occurs and ends at the latest of the 90-day date and the extensions";
    when taxable_event_occurs_on(a, begins);
    when correction_period_end_candidate(a, ends);
    unless later_correction_period_end_candidate_exists(a, ends) and taxable_event_occurs_on(a, begins);
    then correction_period(a, begins, ends);
}
pub relation corrected_during_correction_period(a: ExciseAct) kind institutional {
    label en official "section 4961(a), 4962(a)(2): the taxable event was corrected on or after its occurrence and on or before the end of the correction period";
}
rule CorrectedDuringCorrectionPeriod(a: ExciseAct, begins: Date, ends: Date, con: Date) defeasible {
    label en official "sections 4961(a), 4962(a)(2): correction within the correction period";
    when correction_period(a, begins, ends);
    when corrected_on_for_4963(a, con);
    when con >= begins;
    when con <= ends;
    then corrected_during_correction_period(a);
}

// ============================================================================
// Section 4961 — abatement of second tier taxes
// ============================================================================

pub relation second_tier_tax_assessed_against(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4961(a): the second tier tax on the taxable event has been assessed against the person";
}
pub relation second_tier_tax_assessment_abated(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4961(a): the assessment of the second tier tax has been abated (and any collected amount credited or refunded as an overpayment)";
}
@source(IRC_S4961_A, coverage = exact, quote = "If any taxable event is corrected during the correction period for such event, then any second tier tax imposed with respect to such event (including interest, additions to the tax, and additional amounts) shall not be assessed")
rule S4961SecondTierTaxNotAssessedImmunity(a: ExciseAct, p: Person, amount: Money) defeasible {
    label en official "section 4961(a): the taxpayer is protected from assessment of the second tier tax when the taxable event was corrected during the correction period";
    when second_tier_tax(a, p, amount);
    when corrected_during_correction_period(a);
    then immunity S4961NoAssessmentOfSecondTierTax {
        holder p;
        against us.irc.core::IRS;
        protected_effect second_tier_tax_assessed_against(a, p);
        window [-infinity, infinity];
    };
}
@source(IRC_S4961_A, coverage = exact, quote = "and if assessed the assessment shall be abated, and if collected shall be credited or refunded as an overpayment.")
rule S4961AbatementDuty(a: ExciseAct, p: Person, amount: Money) defeasible {
    label en official "section 4961(a): if the second tier tax was assessed although the event was corrected during the correction period, the assessment shall be abated and any collected amount credited or refunded";
    when second_tier_tax(a, p, amount);
    when corrected_during_correction_period(a);
    when second_tier_tax_assessed_against(a, p);
    then duty S4961AbateAssessmentDuty {
        bearer us.irc.core::IRS;
        beneficiary p;
        goal achievement {
            condition second_tier_tax_assessment_abated(a, p);
            window [-infinity, infinity];
        }
    };
}
pub relation second_tier_liability_determination_final_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4961(b): the date the court's determination that the taxpayer is liable for the second tier tax became final";
}
pub relation correction_period_last_day(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "the last day of the correction period, as a date";
}
rule CorrectionPeriodLastDay(a: ExciseAct, begins: Date, ends: Date) defeasible {
    label en unofficial "the end of the correction period";
    when correction_period(a, begins, ends);
    then correction_period_last_day(a, ends);
}
pub relation supplemental_proceeding_begun_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4961(b): a supplemental proceeding to determine whether the taxable event was corrected during the correction period has begun";
}
pub relation supplemental_proceeding_valid(a: ExciseAct) kind institutional {
    label en official "section 4961(b): a supplemental proceeding begun within the 90 days after the last day of the correction period";
}
@source(IRC_S4961_B, coverage = exact, quote = "such court shall have jurisdiction to conduct any necessary supplemental proceeding to determine whether the taxable event was corrected during the correction period.")
rule S4961SupplementalProceedingPower(a: ExciseAct, fin: Date, last: Date, begun: Date) defeasible {
    label en official "section 4961(b): after a final determination of liability for the second tier tax the court has jurisdiction over a supplemental proceeding, which may be begun only during the period ending on the 90th day after the last day of the correction period";
    when second_tier_liability_determination_final_on(a, fin);
    when correction_period_last_day(a, last);
    when supplemental_proceeding_begun_on(a, begun);
    then power S4961SupplementalProceeding {
        holder us.irc.core::TaxCourt;
        over a;
        exercise supplemental_proceeding_begun_on(a, begun);
        valid_when supplemental_proceeding_valid(a);
        effect create(supplemental_proceeding_valid(a));
        window [fin, add_calendar_period(last, 90 calendar_day)];
    };
}
rule SupplementalProceedingWithinNinetyDays(a: ExciseAct, last: Date, begun: Date) defeasible {
    label en official "section 4961(b): begun no later than the 90th day after the last day of the correction period";
    when correction_period_last_day(a, last);
    when supplemental_proceeding_begun_on(a, begun);
    when begun <= add_calendar_period(last, 90 calendar_day);
    then supplemental_proceeding_valid(a);
}

// 4961(c): suspension of collection of the second tier tax.
pub relation first_tier_tax_paid_in_full_and_refund_claim_filed(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "section 4961(c)(1): the first tier tax has been paid in full and a claim for refund of the amount paid has been filed (date of the later of the two)";
}
pub relation second_tier_tax_assessed_on(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "section 4961(c)(1): the date the second tier tax was assessed";
}
pub relation refund_claim_denied_on(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "section 4961(c)(2): the date the claim for refund was denied";
}
pub relation section_7422_proceeding_begun_on(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "section 4961(c)(2): the person began a proceeding described in section 7422 for the determination of liability for the second tier tax";
}
pub relation jeopardy_collection_finding_second_tier(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4961(c)(4): the Secretary has found that collection of the second tier tax is in jeopardy";
}
pub relation levy_or_collection_proceeding_on_second_tier_tax(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4961(c)(1): a levy or proceeding in court for the collection of the second tier tax is made, begun, or prosecuted";
}
pub relation collection_stay_within_ninety_days_of_assessment(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4961(c)(1): the first tier tax was paid in full and the refund claim filed not later than 90 days after the second tier tax was assessed";
}
rule CollectionStayConditionMet(a: ExciseAct, p: Person, claimed: Date, assessed: Date) defeasible {
    label en official "section 4961(c)(1): claim filed and first tier tax paid in full not later than 90 days after assessment of the second tier tax";
    when first_tier_tax_paid_in_full_and_refund_claim_filed(a, p, claimed);
    when second_tier_tax_assessed_on(a, p, assessed);
    when claimed <= add_calendar_period(assessed, 90 calendar_day);
    then collection_stay_within_ninety_days_of_assessment(a, p);
}
pub relation refund_suit_window_lapsed(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4961(c)(2): the 90 days after denial of the refund claim have closed without the person beginning a section 7422 proceeding (the stay then ceases the following day). Asserted as a fact: the closing of a period without an event is a statement about the reading date, not a rule the case can derive from the denial date alone";
}
@source(IRC_S4961_C, coverage = exact, quote = "no levy or proceeding in court for the collection of the second tier tax shall be made, begun, or prosecuted until a final resolution of a proceeding begun as provided in paragraph (2)")
rule S4961CollectionStayImmunity(a: ExciseAct, p: Person) defeasible {
    label en official "section 4961(c)(1): once the first tier tax is paid in full and a refund claim filed within 90 days of the second tier assessment, no levy or collection proceeding on the second tier tax until final resolution; ceases under (c)(2) when no suit is brought in time; does not prevent jeopardy collection (c)(4)";
    when collection_stay_within_ninety_days_of_assessment(a, p);
    unless refund_suit_window_lapsed(a, p) and collection_stay_within_ninety_days_of_assessment(a, p);
    unless jeopardy_collection_finding_second_tier(a, p) and collection_stay_within_ninety_days_of_assessment(a, p);
    then immunity S4961NoCollectionPendingRefundSuit {
        holder p;
        against us.irc.core::IRS;
        protected_effect levy_or_collection_proceeding_on_second_tier_tax(a, p);
        window [-infinity, infinity];
    };
}

// ============================================================================
// Section 4962 — abatement of qualified first tier taxes
// ============================================================================

@source(IRC_S4962_A, coverage = exact, quote = "a taxable event was due to reasonable cause and not to willful neglect, and")
external judgment relation event_due_to_reasonable_cause_not_willful_neglect(a: ExciseAct) {
    authority Secretary;
    label en official "section 4962(a)(1): it is established to the satisfaction of the Secretary that the taxable event was due to reasonable cause and not to willful neglect";
}
@source(IRC_S4962_C, coverage = exact, quote = "not willful and flagrant")
external judgment relation event_not_willful_and_flagrant(a: ExciseAct) {
    authority Secretary;
    label en official "section 4962(c): for the section 4955(a) tax, it is established that the event was not willful and flagrant";
}
@source(IRC_S4962_B, coverage = exact, quote = "the term \"qualified first tier tax\" means any first tier tax imposed by subchapter A, C, D, or G of this chapter, except that such term shall not include the tax imposed by section 4941(a) (relating to initial tax on self-dealing).")
pub relation qualified_first_tier_tax(a: ExciseAct, bearer: Person, amount: Money) kind institutional {
    label en official "section 4962(b): a first tier tax of subchapter A (4940-4948), C (4955), D (4958) or G (4966-4967) other than the section 4941(a) tax (the black lung trust taxes 4951-4952 are subchapter B and are not qualified)";
}
rule QualifiedFirstTierTax4942(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter A, section 4942(a)"; when excise_act_kind(a, UndistributedIncomeYear); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }
rule QualifiedFirstTierTax4943(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter A, section 4943(a)"; when excise_act_kind(a, ExcessBusinessHolding); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }
rule QualifiedFirstTierTax4944(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter A, section 4944(a)"; when excise_act_kind(a, JeopardizingInvestment); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }
rule QualifiedFirstTierTax4945(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter A, section 4945(a)"; when excise_act_kind(a, TaxableExpenditure); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }
rule QualifiedFirstTierTax4955(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter C, section 4955(a)"; when excise_act_kind(a, PoliticalExpenditure); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }
rule QualifiedFirstTierTax4958(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter D, section 4958(a)"; when excise_act_kind(a, ExcessBenefitTransaction); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }

pub relation qualified_first_tier_tax_assessed_against(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4962(a): the qualified first tier tax on the event has been assessed against the person";
}
pub relation qualified_first_tier_tax_assessment_abated(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4962(a): the assessment has been abated (and any collected amount credited or refunded as an overpayment)";
}
pub relation section_4962_abatement_conditions_met(a: ExciseAct) kind institutional {
    label en official "section 4962(a), (c): the event was due to reasonable cause and not to willful neglect (for the 4955(a) tax: not willful and flagrant) and was corrected within the correction period";
}
rule Section4962ConditionsMet(a: ExciseAct) defeasible {
    label en official "section 4962(a): reasonable cause and not willful neglect, and corrected within the correction period";
    when event_due_to_reasonable_cause_not_willful_neglect(a);
    when corrected_during_correction_period(a);
    unless excise_act_kind(a, PoliticalExpenditure) and event_due_to_reasonable_cause_not_willful_neglect(a) and corrected_during_correction_period(a);
    then section_4962_abatement_conditions_met(a);
}
rule Section4962ConditionsMetPolitical(a: ExciseAct) defeasible {
    label en official "section 4962(c): for the section 4955(a) tax, 'not willful and flagrant' substitutes for reasonable cause and not willful neglect";
    when excise_act_kind(a, PoliticalExpenditure);
    when event_not_willful_and_flagrant(a);
    when corrected_during_correction_period(a);
    then section_4962_abatement_conditions_met(a);
}
@source(IRC_S4962_A, coverage = exact, quote = "then any qualified first tier tax imposed with respect to such event (including interest) shall not be assessed")
rule S4962NotAssessedImmunity(a: ExciseAct, p: Person, amount: Money) defeasible {
    label en official "section 4962(a): a qualified first tier tax is not assessed when the event was due to reasonable cause and corrected within the correction period";
    when qualified_first_tier_tax(a, p, amount);
    when section_4962_abatement_conditions_met(a);
    then immunity S4962NoAssessmentOfQualifiedFirstTierTax {
        holder p;
        against us.irc.core::IRS;
        protected_effect qualified_first_tier_tax_assessed_against(a, p);
        window [-infinity, infinity];
    };
}
@source(IRC_S4962_A, coverage = exact, quote = "and, if assessed, the assessment shall be abated and, if collected, shall be credited or refunded as an overpayment.")
rule S4962AbatementDuty(a: ExciseAct, p: Person, amount: Money) defeasible {
    label en official "section 4962(a): if assessed the assessment shall be abated and, if collected, credited or refunded";
    when qualified_first_tier_tax(a, p, amount);
    when section_4962_abatement_conditions_met(a);
    when qualified_first_tier_tax_assessed_against(a, p);
    then duty S4962AbateAssessmentDuty {
        bearer us.irc.core::IRS;
        beneficiary p;
        goal achievement {
            condition qualified_first_tier_tax_assessment_abated(a, p);
            window [-infinity, infinity];
        }
    };
}
