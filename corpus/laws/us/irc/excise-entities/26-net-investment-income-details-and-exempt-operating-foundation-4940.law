// Stage 3 (26.09.2026). Section 4940(c)(3)(A)-(B) (allowed deductions with the
// straight-line and no-percentage-depletion modifications), (c)(4)(A)-(D)
// (capital gain net income adjustments), (d)(2)-(3) (exempt operating
// foundation and "disqualified individual") of module 04.
//
// Design. Module 04 keeps its case-asserted aggregates (`section_4940_allowed_deductions`,
// `section_4940_capital_gain_net_income`). This module adds the component
// path: when the case supplies the components, `NetInvestmentIncomeFromComponents`
// derives the net investment income and the aggregate rule of module 04 is
// blocked by `unless section_4940_components_supplied`. Per-disposition gain
// and loss are derived one disposition at a time; the foundation-level totals
// are case inputs (aggregates over a derived relation are the section 111 runtime
// subset limit, TECH-GAPS G5903).
//
// JUDGMENT CALLS. (c)(3)(B)(i)-(ii): the allowed deduction is the smaller of the
// amount claimed and the amount on the prescribed basis (straight line; cost
// depletion). (c)(4)(B): the December 31, 1969 floor applies to the basis for
// determining gain only; a loss uses the ordinary adjusted basis.
// (d)(2)(C)(i): "at all times during the taxable year" is read as a test of the
// composition at its worst point, supplied by the case. Status:
// implemented_unverified; scenarios not executed; no legal review.

// --- (c)(3): allowed deductions ---

use self::{
    Corporation,
    IRC_S4940_C,
    IRC_S4940_D,
    Person,
    TaxableYear,
    constructive_beneficial_interest_share,
    constructive_profits_interest_share,
    foundation_net_investment_income,
    gross_investment_income,
    member_of_family,
    substantial_contributor,
};

@source(IRC_S4940_C, coverage = partial, quote = "ordinary and necessary expenses paid or incurred for the production or collection of gross investment income")
pub relation section_4940_ordinary_and_necessary_expenses(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3)(A): ordinary and necessary expenses for the production or collection of gross investment income or the management, conservation or maintenance of income-producing property, other than depreciation and depletion";
}
@source(IRC_S4940_C, coverage = partial, quote = "The deduction provided by section 167 shall be allowed, but only on the basis of the straight line method of depreciation.")
pub relation section_167_depreciation_claimed(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3)(B)(i): the section 167 deduction claimed on whatever method the foundation used";
}
pub relation section_167_depreciation_straight_line(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3)(B)(i): the section 167 deduction that the straight line method of depreciation gives";
}
@source(IRC_S4940_C, coverage = partial, quote = "such deduction shall be determined without regard to section 613 (relating to percentage depletion)")
pub relation section_611_depletion_claimed(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3)(B)(ii): the section 611 depletion deduction claimed";
}
pub relation section_611_depletion_cost_basis(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3)(B)(ii): the section 611 depletion deduction determined without regard to section 613 (cost depletion)";
}
pub relation section_4940_deduction_components_supplied(f: Person, y: TaxableYear) kind institutional {
    label en official "the case supplied the section 4940(c)(3) deduction components (so the aggregate of module 04 is not used)";
}
rule Section4940DeductionComponentsSupplied(f: Person, y: TaxableYear, x: Money) defeasible {
    label en official "the ordinary and necessary expense component is present";
    when section_4940_ordinary_and_necessary_expenses(f, y, x);
    then section_4940_deduction_components_supplied(f, y);
}
pub relation section_167_allowed_for_4940(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(3)(B)(i): the section 167 deduction allowed, only on the straight line basis";
}
rule Section167AllowedClaimedNotAboveStraightLine(f: Person, y: TaxableYear, claimed: Money, sl: Money) defeasible {
    label en official "section 4940(c)(3)(B)(i): a claimed deduction not above the straight line amount is allowed as claimed";
    when section_167_depreciation_claimed(f, y, claimed);
    when section_167_depreciation_straight_line(f, y, sl);
    when claimed <= sl;
    then section_167_allowed_for_4940(f, y, claimed);
}
rule Section167AllowedLimitedToStraightLine(f: Person, y: TaxableYear, claimed: Money, sl: Money) defeasible {
    label en official "section 4940(c)(3)(B)(i): a claimed deduction above the straight line amount is limited to it";
    when section_167_depreciation_claimed(f, y, claimed);
    when section_167_depreciation_straight_line(f, y, sl);
    when claimed > sl;
    then section_167_allowed_for_4940(f, y, sl);
}
pub relation section_611_allowed_for_4940(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(3)(B)(ii): the section 611 depletion deduction allowed, without regard to percentage depletion";
}
rule Section611AllowedClaimedNotAboveCost(f: Person, y: TaxableYear, claimed: Money, cost: Money) defeasible {
    label en official "section 4940(c)(3)(B)(ii): a claimed depletion not above cost depletion is allowed as claimed";
    when section_611_depletion_claimed(f, y, claimed);
    when section_611_depletion_cost_basis(f, y, cost);
    when claimed <= cost;
    then section_611_allowed_for_4940(f, y, claimed);
}
rule Section611AllowedLimitedToCost(f: Person, y: TaxableYear, claimed: Money, cost: Money) defeasible {
    label en official "section 4940(c)(3)(B)(ii): a claimed depletion above cost depletion is limited to it";
    when section_611_depletion_claimed(f, y, claimed);
    when section_611_depletion_cost_basis(f, y, cost);
    when claimed > cost;
    then section_611_allowed_for_4940(f, y, cost);
}
pub relation section_4940_allowed_deductions_computed(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(3): expenses plus the section 167 deduction on the straight line basis plus the section 611 deduction without percentage depletion";
}
rule Section4940AllowedDeductionsComputed(f: Person, y: TaxableYear, expenses: Money, dep: Money, depl: Money) defeasible {
    label en official "section 4940(c)(3)(A)-(B): the sum of ordinary and necessary expenses and the two modified deductions";
    when section_4940_ordinary_and_necessary_expenses(f, y, expenses);
    when section_167_allowed_for_4940(f, y, dep);
    when section_611_allowed_for_4940(f, y, depl);
    then section_4940_allowed_deductions_computed(f, y, expenses + dep + depl);
}

// --- (c)(4): capital gain net income adjustments ---

entity FoundationPropertyDisposition { label en unofficial "a sale or other disposition of property by a private foundation (section 4940(c)(4))"; }

pub relation disposition_by_foundation(d: FoundationPropertyDisposition, f: Person, y: TaxableYear) kind empirical {
    label en unofficial "the disposition was made by the private foundation in the taxable year";
}
pub relation disposition_amount_realized(d: FoundationPropertyDisposition, amount: Money) kind empirical {
    label en unofficial "the amount realized on the disposition";
}
pub relation disposition_adjusted_basis(d: FoundationPropertyDisposition, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the property disposed of, under the principles of subtitle A";
}
@source(IRC_S4940_C, coverage = partial, quote = "held by the private foundation on December 31, 1969, and continuously thereafter to the date of its disposition")
pub relation held_continuously_since_1969_12_31(d: FoundationPropertyDisposition) kind empirical {
    label en unofficial "section 4940(c)(4)(B): the foundation held the property on December 31, 1969, and continuously thereafter to the date of disposition";
}
pub relation fair_market_value_on_1969_12_31(d: FoundationPropertyDisposition, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(4)(B): the fair market value of the property on December 31, 1969";
}
@source(IRC_S4940_C, coverage = partial, quote = "to the extent that such gain or loss is taken into account for purposes of computing the tax imposed by section 511")
pub relation disposition_gain_or_loss_in_section_511_tax(d: FoundationPropertyDisposition) kind empirical {
    label en unofficial "section 4940(c)(4)(A): the gain or loss is taken into account in computing the tax imposed by section 511";
}
@source(IRC_S4940_C, coverage = partial, quote = "no gain or loss shall be taken into account with respect to any portion of property used for a period of not less than 1 year for a purpose or function constituting the basis of the private foundation's exemption")
pub relation exempt_function_property_exchanged_for_like_kind(d: FoundationPropertyDisposition) kind empirical {
    label en unofficial "section 4940(c)(4)(D): the property was used for at least 1 year for a function constituting the basis of exemption and the entire property was exchanged immediately following that period solely for like-kind property to be used for such a function (rules similar to section 1031)";
}
pub relation disposition_excluded_from_4940_net_gain(d: FoundationPropertyDisposition) kind institutional {
    label en official "section 4940(c)(4)(A), (D): the gain or loss is not taken into account";
}
rule DispositionExcludedBy511(d: FoundationPropertyDisposition) defeasible {
    label en official "section 4940(c)(4)(A): gain or loss taken into account for the section 511 tax is not taken into account";
    when disposition_gain_or_loss_in_section_511_tax(d);
    then disposition_excluded_from_4940_net_gain(d);
}
rule DispositionExcludedByLikeKindExchange(d: FoundationPropertyDisposition) defeasible {
    label en official "section 4940(c)(4)(D): exempt-function property exchanged for like-kind property is not taken into account";
    when exempt_function_property_exchanged_for_like_kind(d);
    then disposition_excluded_from_4940_net_gain(d);
}
pub relation disposition_basis_for_gain_4940(d: FoundationPropertyDisposition, amount: Money) kind institutional {
    label en official "section 4940(c)(4)(B): the basis for determining gain, not less than the December 31, 1969 fair market value for property held continuously since then";
}
rule BasisForGainFloorAppliesAbove(d: FoundationPropertyDisposition, basis: Money, fmv: Money) defeasible {
    label en official "section 4940(c)(4)(B): the December 31, 1969 value exceeds the adjusted basis, so it is the basis for gain";
    when held_continuously_since_1969_12_31(d);
    when disposition_adjusted_basis(d, basis);
    when fair_market_value_on_1969_12_31(d, fmv);
    when fmv > basis;
    then disposition_basis_for_gain_4940(d, fmv);
}
rule BasisForGainAdjustedBasisAtOrAboveFloor(d: FoundationPropertyDisposition, basis: Money, fmv: Money) defeasible {
    label en official "section 4940(c)(4)(B): the adjusted basis is not below the December 31, 1969 value";
    when held_continuously_since_1969_12_31(d);
    when disposition_adjusted_basis(d, basis);
    when fair_market_value_on_1969_12_31(d, fmv);
    when fmv <= basis;
    then disposition_basis_for_gain_4940(d, basis);
}
rule BasisForGainNotHeldSince1969(d: FoundationPropertyDisposition, basis: Money) defeasible {
    label en official "section 4940(c)(4)(B) applies only to property held on December 31, 1969 and continuously thereafter";
    when disposition_adjusted_basis(d, basis);
    unless held_continuously_since_1969_12_31(d) and disposition_adjusted_basis(d, basis);
    then disposition_basis_for_gain_4940(d, basis);
}
pub relation disposition_gain_4940(d: FoundationPropertyDisposition, amount: Money) kind institutional {
    label en official "section 4940(c)(4): the gain from the disposition taken into account (amount realized over the basis for gain)";
}
rule DispositionGain4940(d: FoundationPropertyDisposition, realized: Money, basis: Money) defeasible {
    label en official "section 4940(c)(4)(A)-(B), (D): gain is the amount realized over the basis for gain, unless excluded";
    when disposition_amount_realized(d, realized);
    when disposition_basis_for_gain_4940(d, basis);
    when realized > basis;
    unless disposition_excluded_from_4940_net_gain(d) and disposition_amount_realized(d, realized) and disposition_basis_for_gain_4940(d, basis);
    then disposition_gain_4940(d, realized - basis);
}
pub relation disposition_loss_4940(d: FoundationPropertyDisposition, amount: Money) kind institutional {
    label en official "section 4940(c)(4): the loss from the disposition taken into account (adjusted basis over the amount realized)";
}
rule DispositionLoss4940(d: FoundationPropertyDisposition, realized: Money, basis: Money) defeasible {
    label en official "section 4940(c)(4)(A), (D): loss is the adjusted basis over the amount realized, unless excluded";
    when disposition_amount_realized(d, realized);
    when disposition_adjusted_basis(d, basis);
    when basis > realized;
    unless disposition_excluded_from_4940_net_gain(d) and disposition_amount_realized(d, realized) and disposition_adjusted_basis(d, basis);
    then disposition_loss_4940(d, basis - realized);
}

pub relation section_4940_included_gains_total(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(4): the total of the per-disposition gains taken into account for the year (aggregate of disposition_gain_4940, case input - section 111 aggregate limit)";
}
pub relation section_4940_included_losses_total(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(4): the total of the per-disposition losses taken into account for the year (aggregate of disposition_loss_4940, case input)";
}
pub relation section_4940_capital_gain_net_income_computed(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(4)(C): capital gain net income, losses allowed only to the extent of gains and no capital loss carryovers or carrybacks";
}
rule CapitalGainNetIncomeGainsExceedLosses(f: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 4940(c)(4)(C): gains over losses";
    when section_4940_included_gains_total(f, y, gains);
    when section_4940_included_losses_total(f, y, losses);
    when gains > losses;
    then section_4940_capital_gain_net_income_computed(f, y, gains - losses);
}
rule CapitalGainNetIncomeLossesLimitedToGains(f: Person, y: TaxableYear, gains: Money, losses: Money) defeasible {
    label en official "section 4940(c)(4)(C): losses are allowed only to the extent of gains, so the result is never negative and no loss is carried";
    when section_4940_included_gains_total(f, y, gains);
    when section_4940_included_losses_total(f, y, losses);
    when gains <= losses;
    then section_4940_capital_gain_net_income_computed(f, y, 0.00 USD);
}

rule NetInvestmentIncomeFromComponents(f: Person, y: TaxableYear, gross: Money, capgain: Money, deductions: Money) defeasible {
    label en official "section 4940(c)(1): net investment income from the derived deductions (c)(3) and capital gain net income (c)(4)";
    when gross_investment_income(f, y, gross);
    when section_4940_capital_gain_net_income_computed(f, y, capgain);
    when section_4940_allowed_deductions_computed(f, y, deductions);
    then foundation_net_investment_income(f, y, gross + capgain - deductions);
}

// --- (d)(2)-(3): exempt operating foundation ---

@source(IRC_S4940_D, coverage = partial, quote = "such foundation is an operating foundation (as defined in section 4942(j)(3))")
pub relation operating_foundation_4942j3(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4940(d)(2)(A): the foundation is an operating foundation as defined in section 4942(j)(3) (the test itself is not modelled here; case input)";
}
@source(IRC_S4940_D, coverage = partial, quote = "A private foundation is publicly supported for a taxable year if it meets the requirements of section 170(b)(1)(A)(vi) or 509(a)(2) for such taxable year.")
pub relation meets_170b1Avi_for_year(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4940(d)(3)(A): the foundation meets the requirements of section 170(b)(1)(A)(vi) for the taxable year (case input)";
}
pub relation publicly_supported_for_year_4940d3a(f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(3)(A): publicly supported for the taxable year: meets section 170(b)(1)(A)(vi) or 509(a)(2)";
}
rule PubliclySupportedVia170b1Avi(f: Person, y: TaxableYear) defeasible {
    label en official "section 4940(d)(3)(A): meets section 170(b)(1)(A)(vi)";
    when meets_170b1Avi_for_year(f, y);
    then publicly_supported_for_year_4940d3a(f, y);
}
rule PubliclySupportedVia509a2(f: Person, y: TaxableYear) defeasible {
    label en official "section 4940(d)(3)(A): meets section 509(a)(2) (the one-third support and investment-income tests of us.irc.exempt_organizations)";
    when us.irc.exempt_organizations::meets_509a2A_more_than_one_third_support(f, y);
    when us.irc.exempt_organizations::meets_509a2B_not_more_than_one_third_investment(f, y);
    then publicly_supported_for_year_4940d3a(f, y);
}
@source(IRC_S4940_D, coverage = partial, quote = "such foundation has been publicly supported for at least 10 taxable years")
pub relation publicly_supported_taxable_years_count(f: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "section 4940(d)(2)(B): the number of taxable years, up to and including y, for which the foundation was publicly supported (count of publicly_supported_for_year_4940d3a; case input)";
}

// (d)(3)(B): disqualified individual.
pub relation individual_owns_more_than_20_percent_of_contributor_entity(p: Person, f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(3)(B)(ii), (e): p owns more than 20 percent of the voting power of a corporation, the profits interest of a partnership or the beneficial interest of a trust or unincorporated enterprise which is a substantial contributor to f (constructive ownership per section 4946(a)(3)-(4))";
}
rule Owner20PercentOfContributorCorporation(p: Person, f: Person, y: TaxableYear, corp: Corporation, share: Decimal) defeasible {
    label en official "section 4940(d)(3)(B)(ii)(I): more than 20 percent of the total combined voting power of a contributor corporation";
    when us.irc.corporations::total_constructive_ownership_share(p, corp, share);
    when share > 0.20;
    when substantial_contributor(corp, f);
    when foundation_year_4940(f, y);
    then individual_owns_more_than_20_percent_of_contributor_entity(p, f, y);
}
rule Owner20PercentOfContributorPartnership(p: Person, f: Person, y: TaxableYear, ent: Person, share: Decimal) defeasible {
    label en official "section 4940(d)(3)(B)(ii)(II): more than 20 percent of the profits interest of a contributor partnership";
    when constructive_profits_interest_share(p, ent, share);
    when share > 0.20;
    when substantial_contributor(ent, f);
    when foundation_year_4940(f, y);
    then individual_owns_more_than_20_percent_of_contributor_entity(p, f, y);
}
rule Owner20PercentOfContributorTrust(p: Person, f: Person, y: TaxableYear, ent: Person, share: Decimal) defeasible {
    label en official "section 4940(d)(3)(B)(ii)(III): more than 20 percent of the beneficial interest of a contributor trust or unincorporated enterprise";
    when constructive_beneficial_interest_share(p, ent, share);
    when share > 0.20;
    when substantial_contributor(ent, f);
    when foundation_year_4940(f, y);
    then individual_owns_more_than_20_percent_of_contributor_entity(p, f, y);
}
pub relation foundation_year_4940(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "the foundation and taxable year for which the section 4940(d) test is asked";
}
@source(IRC_S4940_D, coverage = partial, quote = "The term \"disqualified individual\" means, with respect to any private foundation, an individual who is—")
pub relation disqualified_individual_4940d3(p: Person, f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(3)(B): a substantial contributor, an owner of more than 20 percent of a contributor entity, or a member of the family of either";
}
rule DisqualifiedIndividualSubstantialContributor(p: Person, f: Person, y: TaxableYear) defeasible {
    label en official "section 4940(d)(3)(B)(i): a substantial contributor";
    when substantial_contributor(p, f);
    when foundation_year_4940(f, y);
    then disqualified_individual_4940d3(p, f, y);
}
rule DisqualifiedIndividualEntityOwner(p: Person, f: Person, y: TaxableYear) defeasible {
    label en official "section 4940(d)(3)(B)(ii): an owner of more than 20 percent of a contributor entity";
    when individual_owns_more_than_20_percent_of_contributor_entity(p, f, y);
    then disqualified_individual_4940d3(p, f, y);
}
rule DisqualifiedIndividualFamilyOfContributor(p: Person, f: Person, y: TaxableYear, q: Person) defeasible {
    label en official "section 4940(d)(3)(B)(iii): a member of the family of a substantial contributor";
    when member_of_family(p, q);
    when substantial_contributor(q, f);
    when foundation_year_4940(f, y);
    then disqualified_individual_4940d3(p, f, y);
}
rule DisqualifiedIndividualFamilyOfEntityOwner(p: Person, f: Person, y: TaxableYear, q: Person) defeasible {
    label en official "section 4940(d)(3)(B)(iii): a member of the family of an owner of more than 20 percent of a contributor entity";
    when member_of_family(p, q);
    when individual_owns_more_than_20_percent_of_contributor_entity(q, f, y);
    then disqualified_individual_4940d3(p, f, y);
}

// (d)(2)(C)-(D).
@source(IRC_S4940_D, coverage = partial, quote = "consists of individuals at least 75 percent of whom are not disqualified individuals")
pub relation governing_body_size_at_worst_point(f: Person, y: TaxableYear, members: Integer) kind empirical {
    label en unofficial "section 4940(d)(2)(C)(i): the number of individuals on the governing body at the point in the year when the disqualified share was highest (case input; 'at all times')";
}
pub relation governing_body_disqualified_at_worst_point(f: Person, y: TaxableYear, disqualified: Integer) kind empirical {
    label en unofficial "section 4940(d)(2)(C)(i): the number of those individuals who are disqualified individuals at that point";
}
pub relation governing_body_at_least_75_percent_not_disqualified(f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(2)(C)(i): at least 75 percent of the governing body are not disqualified individuals (at least three quarters of the members)";
}
rule GoverningBodyAtLeast75PercentNotDisqualified(f: Person, y: TaxableYear, members: Integer, bad: Integer) defeasible {
    label en official "section 4940(d)(2)(C)(i): (members - disqualified) * 4 >= members * 3, in exact integers";
    when governing_body_size_at_worst_point(f, y, members);
    when governing_body_disqualified_at_worst_point(f, y, bad);
    when members > 0;
    when (members - bad) * 4 >= members * 3;
    then governing_body_at_least_75_percent_not_disqualified(f, y);
}
@source(IRC_S4940_D, coverage = partial, quote = "is broadly representative of the general public")
external judgment relation governing_body_broadly_representative_of_public(f: Person, y: TaxableYear) {
    authority Secretary;
    label en official "section 4940(d)(2)(C)(ii): the governing body is broadly representative of the general public";
}
@source(IRC_S4940_D, coverage = partial, quote = "at no time during the taxable year does such foundation have an officer who is a disqualified individual")
pub relation officer_of_foundation_during_year(p: Person, f: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4940(d)(2)(D): p is an officer of the foundation at some time during the taxable year";
}
pub relation foundation_has_disqualified_officer(f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(2)(D): at some time in the year the foundation has an officer who is a disqualified individual";
}
rule FoundationHasDisqualifiedOfficer(f: Person, y: TaxableYear, p: Person) defeasible {
    label en official "section 4940(d)(2)(D): an officer during the year who is a disqualified individual";
    when officer_of_foundation_during_year(p, f, y);
    when disqualified_individual_4940d3(p, f, y);
    then foundation_has_disqualified_officer(f, y);
}
@source(IRC_S4940_D, coverage = partial, quote = "For purposes of this subsection, the term \"exempt operating foundation\" means, with respect to any taxable year, any private foundation if")
pub relation exempt_operating_foundation_4940d2(f: Person, y: TaxableYear) kind institutional {
    label en official "section 4940(d)(2): an operating foundation, publicly supported for at least 10 taxable years, with a governing body at least 75 percent non-disqualified and broadly representative, and no disqualified officer at any time in the year";
}
rule ExemptOperatingFoundation4940d2(f: Person, y: TaxableYear, n: Integer) defeasible {
    label en official "section 4940(d)(2)(A)-(D): all four conditions";
    when operating_foundation_4942j3(f, y);
    when publicly_supported_taxable_years_count(f, y, n);
    when n >= 10;
    when governing_body_at_least_75_percent_not_disqualified(f, y);
    when governing_body_broadly_representative_of_public(f, y);
    unless foundation_has_disqualified_officer(f, y);
    then exempt_operating_foundation_4940d2(f, y);
}
