// 26 U.S.C. Chapters 41-50A of Subtitle D — Entity-Level Excise Taxes: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package excise-entities` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.
//
// STAGE 1 (IRC-13 stage 1, D02): of the 65-section, 2,557-row scope this
// change models the reusable two-tier excise shape (taxable period /
// initial tax / additional tax, `01-excise-act-and-taxable-period.law`),
// its first full instantiation on section 4941 (self-dealing,
// `03-self-dealing-4941.law`), a partial section 4946 (disqualified
// person, only the categories 4941's scenarios need,
// `02-disqualified-persons-4946.law`), and section 4940 (excise on net
// investment income, `04-net-investment-income-4940.law`) up to the (d)
// exempt-operating-foundation exception, which stays an external
// dependency. Every other section of the assignment's scope stays
// `unreviewed` ("stage 2") — see the appended HANDOFF.md section for the
// fully/partially/not-done accounting.
//
// STAGE 2 (DECISION-0379, deontics): modules 11-23 add sections 4911-4912
// (lobbying), 4944 and 4951-4955 (jeopardy investments, split-interest trusts,
// political expenditures), 4960-4963 (excess compensation, abatement), 4965-4968
// (tax shelters, donor advised funds, college endowments), 4971-4972 (plan
// funding, nondeductible contributions), 4973-4979A, 4980-4980G, 4980B (COBRA),
// 4980H-5000D and 5000A, the chapter 42 supplements (4942(f), 4943, 4945, 4947,
// 4948, 4958, 4959), the section 4975 exemption details and the "shall be paid
// by" payment duties. Amendment editions (Public Law 119-21, 119-75) are modelled
// through `us.irc.temporal`; rates and thresholds are `lawparam` datasets. Every
// coverage row is classified in `coverage/excise-entities.json`; the technical
// gaps are TECH-GAPS.md G2500-G2557. Status: implemented_unverified — scenarios
// were lowered statically and never executed; nothing here is legally reviewed.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

import us.irc.core version "0.1.1";
import us.irc.exempt_organizations version "0.1.1";
import us.irc.corporations version "0.1.1";
// WIRE-2 (25.09.2026): `us.irc.deferred_compensation` publishes
// `pub required_minimum_distribution(who: Individual, plan: Plan, y:
// TaxableYear, amount: Money)` — imported for §4974(b)'s "minimum required
// distribution" (05-rmd-shortfall-4974.law), replacing the TECH-GAPS G216
// case-asserted placeholder for the (Individual, Plan, TaxableYear) shape
// that module can now actually supply (via a new bridging fact,
// `rmd_plan_and_year`, since this package tracks the RMD shortfall by
// `ExciseAct`, not by (Individual, Plan, TaxableYear) directly).
import us.irc.deferred_compensation version "0.1.1";
// Stage 2: Public Law 119-21 (sections 70204, 70415, 70416) and 119-75 (section 6701) fragments for the revisions of
// sections 4973, 4968, 4960 and 4980D.
import us.irc.temporal version "0.1.1";
// Stage 2: `us.irc.group_health` publishes `chapter_100_failure_subject_to_4980d_excise` — the chapter 100 failure that section 4980D taxes.
import us.irc.group_health version "0.1.1";
// Stage 2: `us.irc.deductions` publishes `excess_parachute_payment` (section 280G(b)), the meaning section 4999(b) adopts.
import us.irc.deductions version "0.1.1";

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type Corporation = us.irc.core::Corporation;
type Trust = us.irc.core::Trust;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;
type Notice = us.irc.core::Notice;
type Assessment = us.irc.core::Assessment;
type Plan = us.irc.deferred_compensation::Plan;

const Secretary: Organ = us.irc.core::Secretary;
const IRS: Organ = us.irc.core::IRS;
const TaxCourt: Organ = us.irc.core::TaxCourt;
