// Section 4945 — taxes on taxable expenditures. Second full instantiation
// of the shared two-tier shape (01-excise-act-and-taxable-period.law),
// reusing `taxable_period`/`taxable_period_ends`/`corrected_within_taxable_period`
// UNCHANGED (INTERPRETATION: section 4945 itself has no (e)/(f)-lettered
// "taxable period" definition of its own in the rows this pass read — the
// term is presumably defined once, generically, for chapter 42 first-tier
// taxes by section 4963's own "correction period"/definitions subchapter,
// not modelled this stage; this module assumes it is the SAME
// earliest-of-notice/assessment/correction shape as section 4941(e)(1) and
// reuses the shared relations directly rather than re-deriving them —
// flagged as an assumption, not a verified cross-reference).
//
// KEY DIFFERENCE FROM SECTION 4941: the (a)(1)/(b)(1) tax bearer is the
// PRIVATE FOUNDATION itself, not a disqualified person — `initial_tax`/
// `additional_tax`'s `bearer` slot is the foundation for those two rules.
//
// SCOPE:
//  - (a)(1)/(a)(2), (b)(1)/(b)(2): modelled fully (20%/5% initial,
//    100%/50% additional, manager caps $10,000/$20,000 per (c)(2)).
//  - (c)(1) joint-and-several liability for the (a)(2)/(b)(2) manager taxes:
//    modelled.
//  - (d)(1)-(5): modelled as a case-asserted classification
//    (`TaxableExpenditurePurpose` enum) mirroring the statute's own five
//    categories, WITHOUT the (d)(3) "objective and nondiscriminatory basis"
//    exception, the (d)(4)(A)/(B) organization-status/expenditure-
//    responsibility requirements, or the (f) electioneering exception —
//    a case wanting an exception simply does not assert the category
//    (same convention as section 4941(d)(2)), documented TECH_GAP.
//  - (e) (the "specific legislation"/"nonpartisan analysis" carve-outs for
//    (d)(1) lobbying), (f) (voter registration exception detail), (g)
//    (`expenditure responsibility` itself), (h) (§501(c)(3)/(c)(4)
//    correspondent-organization notice-and-taxable-period-extension rules),
//    (i) (abatement cross-reference): NOT modelled this stage.

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4945_A,
    IRC_S4945_B,
    IRC_S4945_C,
    IRC_S4945_D,
    Person,
    additional_tax,
    corrected_within_notice_or_assessment_period,
    excise_act_kind,
    foundation_manager,
    initial_tax,
    taxed_under_4955_as_same_expenditure,
};

enum TaxableExpenditurePurpose {
    Lobbying;
    ElectioneeringOrPoliticalCampaign;
    GrantToIndividualForTravelOrStudy;
    GrantToOrganizationWithoutRequirements;
    OtherNonCharitablePurpose;
}

@source(IRC_S4945_D, coverage = partial, quote = "the term \"taxable expenditure\" means any amount paid or incurred by a private foundation")
pub relation taxable_expenditure_purpose(a: ExciseAct, purpose: TaxableExpenditurePurpose) kind empirical {
    label en unofficial "case-asserted: which of section 4945(d)(1)-(5)'s five categories the expenditure falls into, WITHOUT any of the (d)(3)/(d)(4)/(f) exceptions — see module header";
}
pub relation taxable_expenditure_foundation(a: ExciseAct, f: Person) kind empirical {
    label en unofficial "the private foundation that made the expenditure";
}
pub relation taxable_expenditure_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount of the taxable expenditure";
}

@source(IRC_S4945_D, coverage = partial, quote = "the term \"taxable expenditure\" means any amount paid or incurred by a private foundation")
pub relation taxable_expenditure(a: ExciseAct) kind institutional {
    label en official "section 4945(d): the payment or incurrence is a taxable expenditure";
}
rule TaxableExpenditureClassification(a: ExciseAct, purpose: TaxableExpenditurePurpose, f: Person) defeasible {
    label en official "section 4945(d)(1)-(5): an amount paid or incurred by a private foundation for one of the five listed purposes is a taxable expenditure";
    when excise_act_kind(a, TaxableExpenditure);
    when taxable_expenditure_purpose(a, purpose);
    when taxable_expenditure_foundation(a, f);
    // Stage 2: section 4955(e) — tax imposed under 4955 on the same expenditure displaces this classification.
    unless taxed_under_4955_as_same_expenditure(a) and taxable_expenditure_purpose(a, purpose) and taxable_expenditure_foundation(a, f);
    then taxable_expenditure(a);
}

@source(IRC_S4945_A, coverage = partial, quote = "the agreement of any foundation manager to the making of an expenditure, knowing that it is a taxable expenditure")
external judgment relation expenditure_manager_knew_expenditure_was_taxable(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4945(a)(2): the foundation manager agreed to the expenditure knowing it was a taxable expenditure";
}
@source(IRC_S4945_A, coverage = partial, quote = "unless such agreement is not willful and is due to reasonable cause")
external judgment relation expenditure_manager_agreement_not_willful_and_reasonable_cause(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4945(a)(2): the foundation manager's agreement was not willful and was due to reasonable cause";
}
@source(IRC_S4945_B, coverage = partial, quote = "if a foundation manager refused to agree to part or all of the correction")
pub relation expenditure_manager_refused_to_agree_to_correction(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the foundation manager refused to agree to part or all of the correction of the taxable expenditure";
}

@source(IRC_S4945_A, coverage = partial, quote = "There is hereby imposed on each taxable expenditure (as defined in subsection (d)) a tax equal to 20 percent of the amount thereof. The tax imposed by this paragraph shall be paid by the private foundation.")
rule InitialTaxOnFoundationExpenditure(a: ExciseAct, f: Person, amount: Money, base: Money) defeasible {
    label en official "section 4945(a)(1): 20 percent of the taxable expenditure, paid by the private foundation";
    when taxable_expenditure(a);
    when taxable_expenditure_foundation(a, f);
    when taxable_expenditure_amount(a, base);
    then initial_tax(a, f, base * TaxableExpenditureInitialTaxRateFoundation);
}
rule InitialTaxOnExpenditureManager(a: ExciseAct, p: Person, amount: Money, base: Money, f: Person) defeasible {
    label en official "section 4945(a)(2): 5 percent of the taxable expenditure, capped at $10,000, paid by a foundation manager who knowingly agreed, unless not willful and due to reasonable cause";
    when taxable_expenditure(a);
    when foundation_manager(p, f);
    when taxable_expenditure_foundation(a, f);
    when expenditure_manager_knew_expenditure_was_taxable(a, p);
    when taxable_expenditure_amount(a, base);
    unless expenditure_manager_agreement_not_willful_and_reasonable_cause(a, p) and foundation_manager(p, f) and taxable_expenditure_amount(a, base);
    then initial_tax(a, p, min(base * TaxableExpenditureInitialTaxRateManager, TaxableExpenditureManagerInitialTaxCap));
}

@source(IRC_S4945_B, coverage = partial, quote = "In any case in which an initial tax is imposed by subsection (a)(1) on a taxable expenditure and such expenditure is not corrected within the taxable period, there is hereby imposed a tax equal to 100 percent of the amount of the expenditure. The tax imposed by this paragraph shall be paid by the private foundation.")
rule AdditionalTaxOnFoundationExpenditure(a: ExciseAct, f: Person, amount: Money, base: Money) defeasible {
    label en official "section 4945(b)(1): if not corrected within the taxable period, 100 percent of the expenditure, paid by the private foundation";
    when taxable_expenditure(a);
    when taxable_expenditure_foundation(a, f);
    when taxable_expenditure_amount(a, base);
    unless corrected_within_notice_or_assessment_period(a) and taxable_expenditure_foundation(a, f) and taxable_expenditure_amount(a, base);
    then additional_tax(a, f, base * TaxableExpenditureAdditionalTaxRateFoundation);
}
rule AdditionalTaxOnExpenditureManagerRefusingCorrection(a: ExciseAct, p: Person, amount: Money, f: Person, base: Money) defeasible {
    label en official "section 4945(b)(2): 50 percent of the expenditure, capped at $20,000, paid by a manager who refused to agree to correction";
    when taxable_expenditure(a);
    when foundation_manager(p, f);
    when taxable_expenditure_foundation(a, f);
    when expenditure_manager_refused_to_agree_to_correction(a, p);
    when taxable_expenditure_amount(a, base);
    then additional_tax(a, p, min(base * TaxableExpenditureAdditionalTaxRateManager, TaxableExpenditureManagerAdditionalTaxCap));
}

@source(IRC_S4945_C, coverage = partial, quote = "If more than one person is liable under subsection (a)(2) or (b)(2) with respect to the making of a taxable expenditure, all such persons shall be jointly and severally liable under such paragraph with respect to such expenditure.")
pub relation expenditure_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4945(c)(1): p1 and p2 (both liable managers under the same paragraph) are jointly and severally liable";
}
rule JointAndSeveralExpenditureManagerTax(a: ExciseAct, p1: Person, p2: Person, amount1: Money, amount2: Money) defeasible {
    label en official "section 4945(c)(1): two managers both liable under (a)(2) for the same expenditure are jointly and severally liable";
    when taxable_expenditure(a);
    when initial_tax(a, p1, amount1);
    when initial_tax(a, p2, amount2);
    when p1 != p2;
    then expenditure_jointly_and_severally_liable(a, p1, p2);
}
