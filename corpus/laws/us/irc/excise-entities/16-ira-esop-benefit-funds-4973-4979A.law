// Sections 4973 (excess contributions to IRAs, Archer MSAs, Coverdell, HSAs,
// ABLE and 403(b) custodial accounts, and the Trump account rule of Pub. L.
// 119-21 section 70204), 4976 (welfare benefit fund disqualified benefits),
// 4977 (excess fringe benefits of electing employers), 4978 (ESOP dispositions
// within the holding period), 4979 (excess contributions and excess aggregate
// contributions to plans) and 4979A (prohibited ESOP allocations). Stage 2
// (DECISION-0379). These are annual/per-event taxes on an employer or an
// individual, not the two-tier act shape; their heads are their own relations.
//
// 4973: the carried-in prior-year excess is a case fact (multi-year recursion is
// LDC-E4102, G2504 pattern). The tax is 6 percent of the LESSER of the excess and the
// value of the account at the close of the year (the second sentence of (a)).
// The insurance-allocation carve-out for endowment contracts is not modelled (G2510).
// 4979: the "first 2 1/2 months" (6 months for an eligible automatic contribution
// arrangement) of the following plan year is read as through the 15th day of the
// third month (30 June for six months) — JUDGMENT CALL recorded in the coverage row.

// ============================================================================
// Section 4973
// ============================================================================

use self::{
    IRC_S4973_A,
    IRC_S4973_B,
    IRC_S4973_C,
    IRC_S4973_D,
    IRC_S4973_E,
    IRC_S4973_F,
    IRC_S4973_G,
    IRC_S4973_H,
    IRC_S4976_A,
    IRC_S4976_B,
    IRC_S4977_A,
    IRC_S4977_B,
    IRC_S4977_C,
    IRC_S4977_D,
    IRC_S4978_A,
    IRC_S4978_B,
    IRC_S4979A_A,
    IRC_S4979_A,
    Person,
    Plan,
    PlanCategory4975,
    TaxableYear,
};

enum ExcessContributionAccountKind {
    IndividualRetirementAccountOrAnnuity;
    RothIra;
    ArcherMsa;
    CoverdellEsa;
    HealthSavingsAccount;
    AbleAccount;
    Section403bCustodialAccount;
    TrumpAccount;
}
pub relation account_value_at_close_of_year(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, value: Money) kind empirical {
    label en official "section 4973(a): the value of the account or annuity determined as of the close of the taxable year (the tax may not exceed 6 percent of it)";
}
pub relation prior_year_excess_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "section 4973(b)(2), (c)(2), (d)(2), (e)(1)(B), (f)(2), (g)(2): the amount determined for the preceding taxable year, carried in as a fact (year-to-year recursion is not expressed — G2504 pattern)";
}
pub relation contributions_for_year_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "sections 4973(b)(1)(A), (c)(1), (d)(1), (e)(1)(A), (f)(1)(A), (g)(1), (h)(1): the amount contributed for the taxable year, net of the statutory exclusions (rollovers, Roth contributions for the IRA rule, contributions returned under 408(d)(4)/220(f)(3)/223(f)(3)/530(d)(4)(C)/529A distributions)";
}
pub relation allowable_amount_for_year_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "sections 4973(b)(1)(B), (c)(1), (d)(1), (f)(1)(B), (g)(1), (h)(1): the deduction / exclusion / permitted contribution against which the contribution is measured (219 computed without 219(g); 408A(c)(2)-(3); 403(b) and 415; 106(b)/220; 106(d)/223; 529A(b)(2)(B))";
}
pub relation maximum_allowable_for_year_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "sections 4973(b)(2)(C), (c)(2)(A), (d)(2)(B)(i), (e)(1)(B)(ii), (f)(2)(B), (g)(2)(B)(i): the maximum amount allowable for the taxable year (unused room reduces the carried-in excess)";
}
pub relation contributed_including_roth_for_year_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "sections 4973(b)(2)(C), (f)(2)(B): the amount contributed to all individual retirement plans (including Roth IRAs) for the year, used to compute the unused room";
}
pub relation reducing_distributions_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind empirical {
    label en official "sections 4973(b)(2)(A)-(B), (c)(2)(B), (d)(2)(A), (e)(1)(B)(i), (f)(2)(A), (g)(2)(A): distributions that reduce the carried-in excess";
}
pub relation coverdell_permitted_contributor_maxima(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4973(e)(1)(A): the sum of the maximum amounts permitted to be contributed under section 530(c) by the contributors to the beneficiary's accounts";
}

@source(IRC_S4973_B, coverage = exact, quote = "the term \"excess contributions\" means the sum of—")
pub relation excess_contributions_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind institutional {
    label en official "section 4973(b)-(h): the excess contributions of the individual for the account kind";
}
// JUDGMENT CALL: each of the two components is floored at zero (the statute's "excess (if any)" and "reduced by" cannot
// produce a negative excess).
@source(IRC_S4973_B, coverage = exact, quote = "the excess (if any) of—")
rule ExcessContributionsIra(p: Person, y: TaxableYear, c: Money, a: Money, prior: Money, dist: Money, m: Money, all: Money) defeasible {
    label en official "section 4973(b): IRAs and IRAs annuities: max(0, contributed − deduction) + max(0, prior − (distributions + max(0, maximum deduction − contributed including Roth)))";
    when contributions_for_year_4973(p, y, IndividualRetirementAccountOrAnnuity, c);
    when allowable_amount_for_year_4973(p, y, IndividualRetirementAccountOrAnnuity, a);
    when prior_year_excess_4973(p, y, IndividualRetirementAccountOrAnnuity, prior);
    when reducing_distributions_4973(p, y, IndividualRetirementAccountOrAnnuity, dist);
    when maximum_allowable_for_year_4973(p, y, IndividualRetirementAccountOrAnnuity, m);
    when contributed_including_roth_for_year_4973(p, y, IndividualRetirementAccountOrAnnuity, all);
    then excess_contributions_4973(p, y, IndividualRetirementAccountOrAnnuity, max(c - a, 0.00 USD) + max(prior - (dist + max(m - all, 0.00 USD)), 0.00 USD));
}
@source(IRC_S4973_F, coverage = exact, quote = "in the case of contributions to a Roth IRA (within the meaning of section 408A(b)), the term \"excess contributions\" means the sum of—")
rule ExcessContributionsRoth(p: Person, y: TaxableYear, c: Money, a: Money, prior: Money, dist: Money, m: Money, all: Money) defeasible {
    label en official "section 4973(f): Roth IRAs: max(0, contributed − allowable under 408A(c)(2)-(3)) + max(0, prior − (distributions + max(0, maximum allowable − contributed to all individual retirement plans)))";
    when contributions_for_year_4973(p, y, RothIra, c);
    when allowable_amount_for_year_4973(p, y, RothIra, a);
    when prior_year_excess_4973(p, y, RothIra, prior);
    when reducing_distributions_4973(p, y, RothIra, dist);
    when maximum_allowable_for_year_4973(p, y, RothIra, m);
    when contributed_including_roth_for_year_4973(p, y, RothIra, all);
    then excess_contributions_4973(p, y, RothIra, max(c - a, 0.00 USD) + max(prior - (dist + max(m - all, 0.00 USD)), 0.00 USD));
}
@source(IRC_S4973_C, coverage = exact, quote = "in the case of a custodial account referred to in subsection (a)(3), the term \"excess contributions\" means the sum of—")
rule ExcessContributions403b(p: Person, y: TaxableYear, c: Money, a: Money, prior: Money, dist: Money) defeasible {
    label en official "section 4973(c): 403(b)(7) custodial accounts: max(0, contributed − lesser of exclusion and 415 limit) + max(0, prior − (max(0, that limit − contributed) + distributions included under 72(e)))";
    when contributions_for_year_4973(p, y, Section403bCustodialAccount, c);
    when allowable_amount_for_year_4973(p, y, Section403bCustodialAccount, a);
    when prior_year_excess_4973(p, y, Section403bCustodialAccount, prior);
    when reducing_distributions_4973(p, y, Section403bCustodialAccount, dist);
    then excess_contributions_4973(p, y, Section403bCustodialAccount, max(c - a, 0.00 USD) + max(prior - (max(a - c, 0.00 USD) + dist), 0.00 USD));
}
@source(IRC_S4973_D, coverage = exact, quote = "in the case of Archer MSAs (within the meaning of section 220(d)), the term \"excess contributions\" means the sum of—")
rule ExcessContributionsArcher(p: Person, y: TaxableYear, c: Money, a: Money, prior: Money, dist: Money, m: Money) defeasible {
    label en official "section 4973(d): Archer MSAs: contributions neither excludable nor deductible plus max(0, prior − (distributions + max(0, maximum deduction − contributed)))";
    when contributions_for_year_4973(p, y, ArcherMsa, c);
    when allowable_amount_for_year_4973(p, y, ArcherMsa, a);
    when prior_year_excess_4973(p, y, ArcherMsa, prior);
    when reducing_distributions_4973(p, y, ArcherMsa, dist);
    when maximum_allowable_for_year_4973(p, y, ArcherMsa, m);
    then excess_contributions_4973(p, y, ArcherMsa, max(c - a, 0.00 USD) + max(prior - (dist + max(m - c, 0.00 USD)), 0.00 USD));
}
@source(IRC_S4973_G, coverage = exact, quote = "in the case of health savings accounts (within the meaning of section 223(d)), the term \"excess contributions\" means the sum of—")
rule ExcessContributionsHsa(p: Person, y: TaxableYear, c: Money, a: Money, prior: Money, dist: Money, m: Money) defeasible {
    label en official "section 4973(g): HSAs: contributions neither excludable nor deductible plus max(0, prior − (distributions + max(0, maximum deduction − contributed)))";
    when contributions_for_year_4973(p, y, HealthSavingsAccount, c);
    when allowable_amount_for_year_4973(p, y, HealthSavingsAccount, a);
    when prior_year_excess_4973(p, y, HealthSavingsAccount, prior);
    when reducing_distributions_4973(p, y, HealthSavingsAccount, dist);
    when maximum_allowable_for_year_4973(p, y, HealthSavingsAccount, m);
    then excess_contributions_4973(p, y, HealthSavingsAccount, max(c - a, 0.00 USD) + max(prior - (dist + max(m - c, 0.00 USD)), 0.00 USD));
}
@source(IRC_S4973_E, coverage = exact, quote = "the amount by which the amount contributed for the taxable year to such accounts exceeds $2,000 (or, if less, the sum of the maximum amounts permitted to be contributed under section 530(c) by the contributors to such accounts for such year)")
rule ExcessContributionsCoverdell(p: Person, y: TaxableYear, c: Money, prior: Money, dist: Money, m: Money, sumMax: Money) defeasible {
    label en official "section 4973(e): Coverdell accounts of one beneficiary: max(0, contributed − min($2,000, sum of contributor maxima)) + max(0, prior − (distributions + max(0, maximum − contributed)))";
    when contributions_for_year_4973(p, y, CoverdellEsa, c);
    when coverdell_permitted_contributor_maxima(p, y, sumMax);
    when prior_year_excess_4973(p, y, CoverdellEsa, prior);
    when reducing_distributions_4973(p, y, CoverdellEsa, dist);
    when maximum_allowable_for_year_4973(p, y, CoverdellEsa, m);
    then excess_contributions_4973(p, y, CoverdellEsa, max(c - min(CoverdellContributionLimit4973, sumMax), 0.00 USD) + max(prior - (dist + max(m - c, 0.00 USD)), 0.00 USD));
}
@source(IRC_S4973_H, coverage = exact, quote = "the term \"excess contributions\" means the amount by which the amount contributed for the taxable year to such account (other than contributions under section 529A(c)(1)(C)) exceeds the contribution limit under section 529A(b)(2)(B).")
rule ExcessContributionsAble(p: Person, y: TaxableYear, c: Money, a: Money) defeasible {
    label en official "section 4973(h): ABLE accounts: contributions over the section 529A(b)(2)(B) limit";
    when contributions_for_year_4973(p, y, AbleAccount, c);
    when allowable_amount_for_year_4973(p, y, AbleAccount, a);
    when c > a;
    then excess_contributions_4973(p, y, AbleAccount, c - a);
}
// Pub. L. 119-21 section 70204: the section 530A(h)(5) rule for Trump accounts.
pub relation trump_account_year_begins_before_age_18_calendar_year(p: Person, y: TaxableYear) kind empirical {
    label en official "Pub. L. 119-21 section 70204 (section 530A(h)(5)): the taxable year begins before the first day of the calendar year in which the account beneficiary attains age 18";
}
pub relation trump_account_permitted_contribution(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 530A(h)(5)(A): the amount permitted to be contributed to the account under section 530A(c)(2) for the calendar year in which the taxable year begins";
}
pub relation trump_account_prior_year_excess(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 530A(h)(5)(B): the amount determined under the paragraph for the preceding taxable year (carried in as a fact — G2504 pattern)";
}
pub relation trump_account_distributions_under_530A_d5(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 530A(h)(5): distributions to which section 530A(d)(5) applies made during the taxable year or by the return due date (with extensions), reducing the excess contributions";
}
@source(us.irc.temporal::PL119_21_S70204, relation = derives_from, quote = "For purposes of applying section 4973(b) to a Trump account for any taxable year beginning before the first day of the calendar year in which the account beneficiary attains age 18, the term ‘excess contributions’ means the sum of—")
rule ExcessContributionsTrumpAccount(p: Person, y: TaxableYear, c: Money, permitted: Money, prior: Money, dist: Money) defeasible {
    label en official "Pub. L. 119-21 section 70204 (530A(h)(5)): for taxable years beginning before the calendar year of the beneficiary's 18th birthday: max(0, contributed − permitted under 530A(c)(2)) + prior-year amount, reduced by the (d)(5) distributions";
    effective [@2025-07-04, infinity);
    when trump_account_year_begins_before_age_18_calendar_year(p, y);
    when contributions_for_year_4973(p, y, TrumpAccount, c);
    when trump_account_permitted_contribution(p, y, permitted);
    when trump_account_prior_year_excess(p, y, prior);
    when trump_account_distributions_under_530A_d5(p, y, dist);
    then excess_contributions_4973(p, y, TrumpAccount, max(max(c - permitted, 0.00 USD) + prior - dist, 0.00 USD));
}
@source(IRC_S4973_A, coverage = exact, quote = "there is imposed for each taxable year a tax in an amount equal to 6 percent of the amount of the excess contributions to such individual's accounts or annuities (determined as of the close of the taxable year). The amount of such tax for any taxable year shall not exceed 6 percent of the value of the account or annuity (determined as of the close of the taxable year).")
pub relation excess_contributions_tax_4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, amount: Money) kind institutional {
    label en official "section 4973(a): 6 percent of the excess contributions, not more than 6 percent of the value of the account or annuity, paid by the individual";
}
rule ExcessContributionsTax4973(p: Person, y: TaxableYear, k: ExcessContributionAccountKind, e: Money, v: Money) defeasible {
    label en official "section 4973(a): 6 percent × the lesser of the excess contributions and the account value at the close of the year; cents HALF_UP (JUDGMENT CALL)";
    when excess_contributions_4973(p, y, k, e);
    when account_value_at_close_of_year(p, y, k, v);
    when e > 0.00 USD;
    then excess_contributions_tax_4973(p, y, k, round(min(e, v) * ExcessContributionsTaxRate4973, 2, "HALF_UP"));
}

// ============================================================================
// Section 4976 — welfare benefit funds
// ============================================================================

enum DisqualifiedBenefitCategory {
    KeyEmployeePostRetirementNotFromSeparateAccount;
    DiscriminatoryPostRetirementBenefit;
    ReversionToEmployer;
}
pub relation employer_maintains_welfare_benefit_fund(emp: Person, fund: Person, y: TaxableYear) kind empirical {
    label en official "section 4976(a)(1): the employer maintains a welfare benefit fund";
}
pub relation benefit_provided_in_year(emp: Person, fund: Person, y: TaxableYear, cat: DisqualifiedBenefitCategory, amount: Money) kind empirical {
    label en official "section 4976(b)(1)(A)-(C): the amount of a post-retirement medical/life benefit (with the (A) key-employee separate account requirement not met, or the (B) discrimination requirement not met) or of a reversion to the employer, provided during the year";
}
pub relation collective_bargaining_exception_4976b2(emp: Person, fund: Person, y: TaxableYear) kind empirical {
    label en official "section 4976(b)(2): the plan is maintained under an agreement the Secretary finds to be a collective bargaining agreement whose benefits were the subject of good faith bargaining";
}
pub relation reversion_from_nondeductible_contribution(emp: Person, fund: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4976(b)(3): the part of a reversion attributable to a contribution not allowable as a deduction under section 419 for the year or a prior year";
}
pub relation charged_against_existing_reserve_4976b4(emp: Person, fund: Person, y: TaxableYear, cat: DisqualifiedBenefitCategory) kind empirical {
    label en official "section 4976(b)(4): the post-retirement benefits were charged against an existing reserve (or the income on it) as defined in section 512(a)(3)(E)";
}
@source(IRC_S4976_B, coverage = exact, quote = "The term \"disqualified benefit\" means—")
pub relation disqualified_benefit(emp: Person, fund: Person, y: TaxableYear, cat: DisqualifiedBenefitCategory, amount: Money) kind institutional {
    label en official "section 4976(b): a disqualified benefit provided during the taxable year, net of the (b)(2)-(4) exceptions";
}
rule DisqualifiedBenefitKeyEmployee(emp: Person, fund: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 4976(b)(1)(A): a post-retirement benefit for a key employee not paid from the required separate account (unless charged against an existing reserve, (b)(4))";
    when employer_maintains_welfare_benefit_fund(emp, fund, y);
    when benefit_provided_in_year(emp, fund, y, KeyEmployeePostRetirementNotFromSeparateAccount, amt);
    unless charged_against_existing_reserve_4976b4(emp, fund, y, KeyEmployeePostRetirementNotFromSeparateAccount) and benefit_provided_in_year(emp, fund, y, KeyEmployeePostRetirementNotFromSeparateAccount, amt);
    then disqualified_benefit(emp, fund, y, KeyEmployeePostRetirementNotFromSeparateAccount, amt);
}
rule DisqualifiedBenefitDiscriminatory(emp: Person, fund: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 4976(b)(1)(B): a post-retirement benefit for a person in whose favor discrimination is prohibited unless section 505(b) is met (not for collective bargaining plans, (b)(2), nor charged against an existing reserve, (b)(4))";
    when employer_maintains_welfare_benefit_fund(emp, fund, y);
    when benefit_provided_in_year(emp, fund, y, DiscriminatoryPostRetirementBenefit, amt);
    unless collective_bargaining_exception_4976b2(emp, fund, y) and benefit_provided_in_year(emp, fund, y, DiscriminatoryPostRetirementBenefit, amt);
    unless charged_against_existing_reserve_4976b4(emp, fund, y, DiscriminatoryPostRetirementBenefit) and benefit_provided_in_year(emp, fund, y, DiscriminatoryPostRetirementBenefit, amt);
    then disqualified_benefit(emp, fund, y, DiscriminatoryPostRetirementBenefit, amt);
}
rule DisqualifiedBenefitReversion(emp: Person, fund: Person, y: TaxableYear, amt: Money, nd: Money) defeasible {
    label en official "section 4976(b)(1)(C), (b)(3): a reversion of any portion of the fund to the employer, excluding the part attributable to nondeductible contributions";
    when employer_maintains_welfare_benefit_fund(emp, fund, y);
    when benefit_provided_in_year(emp, fund, y, ReversionToEmployer, amt);
    when reversion_from_nondeductible_contribution(emp, fund, y, nd);
    when amt > nd;
    then disqualified_benefit(emp, fund, y, ReversionToEmployer, amt - nd);
}
rule DisqualifiedBenefitReversionAllDeductible(emp: Person, fund: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 4976(b)(1)(C): a reversion with no part attributable to nondeductible contributions";
    when employer_maintains_welfare_benefit_fund(emp, fund, y);
    when benefit_provided_in_year(emp, fund, y, ReversionToEmployer, amt);
    unless reversion_from_nondeductible_contribution(emp, fund, y, _) and benefit_provided_in_year(emp, fund, y, ReversionToEmployer, amt);
    then disqualified_benefit(emp, fund, y, ReversionToEmployer, amt);
}
@source(IRC_S4976_A, coverage = exact, quote = "there is hereby imposed on such employer a tax equal to 100 percent of such disqualified benefit.")
pub relation disqualified_benefit_tax(emp: Person, fund: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4976(a): 100 percent of the disqualified benefits provided during the taxable year, imposed on the employer";
}
rule DisqualifiedBenefitTax(emp: Person, fund: Person, y: TaxableYear) defeasible {
    label en official "section 4976(a): 100 percent of the sum of the disqualified benefits";
    when employer_maintains_welfare_benefit_fund(emp, fund, y);
    when disqualified_benefit(emp, fund, y, _, _);
    then disqualified_benefit_tax(emp, fund, y, sum(collect all a: Money, c: DisqualifiedBenefitCategory where disqualified_benefit(emp, fund, y, c, a), empty: 0.00 USD) * DisqualifiedBenefitTaxRate4976);
}

// ============================================================================
// Section 4977 — excess fringe benefits
// ============================================================================

pub relation election_4977_made_for_calendar_year(emp: Person, cy: Integer) kind empirical {
    label en official "sections 4977(a), (d): the employer made an election under section 4977 for this calendar year (the first year it applies)";
}
pub relation election_4977_revoked_effective_calendar_year(emp: Person, cy: Integer) kind empirical {
    label en official "section 4977(d): the employer revoked the election, effective for this calendar year (a later re-election is a new election year; only one election/revocation cycle is modelled — G2511)";
}
pub relation calendar_year_4977(emp: Person, cy: Integer) kind empirical {
    label en unofficial "the calendar year for which the section 4977 consequences are asked (binds the year of the rules below)";
}
@source(IRC_S4977_D, coverage = exact, quote = "An election under this section shall apply to the calendar year for which made and all subsequent calendar years unless revoked by the employer.")
pub relation election_4977_in_effect(emp: Person, cy: Integer) kind institutional {
    label en official "section 4977(d): the election applies to the year made and all later years unless revoked";
}
rule Election4977InEffect(emp: Person, cy: Integer, n: Integer, m: Integer) defeasible {
    label en official "section 4977(d): in effect from the election year until a revocation takes effect";
    when calendar_year_4977(emp, cy);
    when election_4977_made_for_calendar_year(emp, n);
    when cy >= n;
    when election_4977_revoked_effective_calendar_year(emp, m);
    when cy < m;
    then election_4977_in_effect(emp, cy);
}
rule Election4977InEffectNoRevocation(emp: Person, cy: Integer, n: Integer) defeasible {
    label en official "section 4977(d): never revoked";
    when calendar_year_4977(emp, cy);
    when election_4977_made_for_calendar_year(emp, n);
    when cy >= n;
    unless election_4977_revoked_effective_calendar_year(emp, _) and election_4977_made_for_calendar_year(emp, n) and calendar_year_4977(emp, cy);
    then election_4977_in_effect(emp, cy);
}
pub relation fringe_benefits_not_excluded_under_132a1_or_2(emp: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4977(b)(1): the aggregate value of fringe benefits provided by the employer during the calendar year which were not includible in gross income under paragraphs (1) and (2) of section 132(a) — as computed with the (c) line-of-business treatment when the election is in effect";
}
pub relation employer_compensation_includible_4977(emp: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4977(b)(2): the aggregate compensation paid by the employer during the calendar year to employees that was includible in gross income for chapter 1 (employees of a controlled group are one employer, (e))";
}
pub relation employment_within_united_states_4977(emp: Person, cy: Integer) kind empirical {
    label en official "section 4977(f): the employment is within the United States (the section applies only to such employment except as regulations provide)";
}
pub relation discount_line_of_business_treatment_4977c(emp: Person, cy: Integer) kind empirical {
    label en official "section 4977(c)(2): at all times from January 1, 1984 to the close of the calendar year substantially all employees were entitled to employee discounts in 1 line of business";
}
@source(IRC_S4977_C, coverage = exact, quote = "all employees of any line of business of the employer which was in existence on January 1, 1984, shall be treated as employees of the line of business referred to in paragraph (2).")
pub relation line_of_business_employee_treatment_applies(emp: Person, cy: Integer) kind institutional {
    label en official "section 4977(c): with an election in effect and the discount condition met, all employees of any line of business existing on January 1, 1984 are treated as employees of the discount line for section 132(a)(1)-(2) (not for 132(h))";
}
rule LineOfBusinessEmployeeTreatment(emp: Person, cy: Integer) defeasible {
    label en official "section 4977(c)";
    when election_4977_in_effect(emp, cy);
    when discount_line_of_business_treatment_4977c(emp, cy);
    then line_of_business_employee_treatment_applies(emp, cy);
}
@source(IRC_S4977_B, coverage = exact, quote = "For purposes of subsection (a), the term \"excess fringe benefits\" means, with respect to any calendar year—")
pub relation excess_fringe_benefits(emp: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4977(b): fringe benefits not excluded under 132(a)(1)-(2) over 1 percent of includible compensation";
}
rule ExcessFringeBenefits(emp: Person, cy: Integer, f: Money, comp: Money) defeasible {
    label en official "section 4977(b): fringe benefits − 1 percent of compensation, when positive";
    when election_4977_in_effect(emp, cy);
    when employment_within_united_states_4977(emp, cy);
    when fringe_benefits_not_excluded_under_132a1_or_2(emp, cy, f);
    when employer_compensation_includible_4977(emp, cy, comp);
    when f > comp * ExcessFringeCompensationShare4977;
    then excess_fringe_benefits(emp, cy, f - comp * ExcessFringeCompensationShare4977);
}
@source(IRC_S4977_A, coverage = exact, quote = "there is hereby imposed a tax for such calendar year equal to 30 percent of the excess fringe benefits.")
pub relation excess_fringe_benefit_tax(emp: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4977(a): 30 percent of the excess fringe benefits";
}
rule ExcessFringeBenefitTax(emp: Person, cy: Integer, x: Money) defeasible {
    label en official "section 4977(a): 30 percent of the excess fringe benefits";
    when election_4977_in_effect(emp, cy);
    when excess_fringe_benefits(emp, cy, x);
    then excess_fringe_benefit_tax(emp, cy, round(x * ExcessFringeBenefitTaxRate4977, 2, "HALF_UP"));
}

// ============================================================================
// Section 4978 — ESOP dispositions within 3 years
// ============================================================================

entity EsopDisposition { label en unofficial "a disposition (including a distribution) of qualified securities by an employee stock ownership plan or eligible worker-owned cooperative"; }
enum EsopAcquisitionKind { Sale1042; QualifiedGratuitousTransfer664g; }
pub relation esop_disposition_holder(d: EsopDisposition, plan: Person) kind empirical {
    label en unofficial "the employee stock ownership plan or eligible worker-owned cooperative making the disposition";
}
pub relation esop_acquisition_kind(d: EsopDisposition, k: EsopAcquisitionKind) kind empirical {
    label en official "section 4978(a): the securities were acquired in a sale to which section 1042 applied, or in a qualified gratuitous transfer to which section 664(g) applied";
}
pub relation esop_acquired_on(d: EsopDisposition, on: Date) kind empirical {
    label en official "section 4978(a): the date the plan or cooperative acquired the securities";
}
pub relation esop_disposed_on(d: EsopDisposition, on: Date) kind empirical {
    label en official "section 4978(a): the date of the disposition";
}
pub relation shares_held_after_disposition(d: EsopDisposition, n: Integer) kind empirical {
    label en official "section 4978(a)(1): the total number of shares held after the disposition";
}
pub relation shares_held_immediately_after_sale(d: EsopDisposition, n: Integer) kind empirical {
    label en official "section 4978(a)(1): the total number of employer securities held immediately after the sale";
}
pub relation qualified_securities_value_after_disposition(d: EsopDisposition, amount: Money) kind empirical {
    label en official "section 4978(a)(2): the value of qualified securities held after the disposition";
}
pub relation employer_securities_total_value_at_disposition(d: EsopDisposition, amount: Money) kind empirical {
    label en official "section 4978(a)(2): the total value of all employer securities as of the disposition";
}
pub relation esop_disposition_excepted_reason(d: EsopDisposition, reason: EsopExceptionReason) kind empirical {
    label en official "section 4978(d): the disposition is by reason of death, retirement after 59½, disability, a one-year break in service, a section 368(a)(1) reorganization exchange, a liquidation into a cooperative, or a section 401(a)(28) diversification requirement";
}
enum EsopExceptionReason {
    DeathOfEmployee;
    RetirementAfterAge59Half;
    DisabilityOfEmployee;
    OneYearBreakInService;
    Reorganization368a1;
    LiquidationIntoCooperative332;
    DiversificationRequirement401a28;
}
pub relation esop_amount_realized(d: EsopDisposition, amount: Money) kind institutional {
    label en official "section 4978(b)(1), (b)(3): the amount realized on the disposition (a distribution to an employee for less than fair market value is measured as if sold to the employee at fair market value)";
}
pub relation esop_amount_allocable_to_protected_securities(d: EsopDisposition, amount: Money) kind empirical {
    label en official "section 4978(b)(2): the portion of the amount realized allocable to securities acquired in the 1042 sale / 664(g) transfer, determined by the ordering rule (first-acquired within the 3-year period first; the reverse order if (d) applies) — the ordering is applied by the case (G2512)";
}
pub relation written_statement_maker(d: EsopDisposition, payer: Person) kind empirical {
    label en official "section 4978(c): the employer or eligible worker-owned cooperative that made the written statement described in section 664(g)(1)(E) or 1042(b)(3)";
}
@source(IRC_S4978_A, coverage = exact, quote = "If, during the 3-year period after the date on which the employee stock ownership plan or eligible worker-owned cooperative acquired any qualified securities in a sale to which section 1042 applied")
pub relation esop_early_disposition_taxable(d: EsopDisposition) kind institutional {
    label en official "section 4978(a): a disposition within the 3-year period that reduces the shares held below the post-sale number or the value held below 30 percent (60 percent for a qualified gratuitous transfer) of all employer securities, and is not excepted by (d)";
}
pub relation esop_within_three_year_period(d: EsopDisposition) kind institutional {
    label en official "section 4978(a): the disposition is within 3 years after the acquisition";
}
rule EsopWithinThreeYears(d: EsopDisposition, acq: Date, disp: Date) defeasible {
    label en official "section 4978(a): during the 3-year period after the acquisition date";
    when esop_acquired_on(d, acq);
    when esop_disposed_on(d, disp);
    when disp >= acq;
    when disp <= add_calendar_period(acq, 3 calendar_year);
    then esop_within_three_year_period(d);
}
pub relation esop_holdings_test_failed(d: EsopDisposition) kind institutional {
    label en official "section 4978(a)(1)-(2): after the disposition the plan holds fewer shares than immediately after the sale, or qualified securities worth less than 30 percent (60 percent for a section 664(g) qualified gratuitous transfer) of all employer securities";
}
rule EsopHoldingsTestSharesReduced(d: EsopDisposition, after: Integer, before: Integer) defeasible {
    label en official "section 4978(a)(1): fewer shares held after the disposition than immediately after the sale";
    when shares_held_after_disposition(d, after);
    when shares_held_immediately_after_sale(d, before);
    when after < before;
    then esop_holdings_test_failed(d);
}
rule EsopHoldingsTestValueBelowShare1042(d: EsopDisposition, held: Money, total: Money) defeasible {
    label en official "section 4978(a)(2): qualified securities held are worth less than 30 percent of all employer securities (section 1042 sale)";
    when esop_acquisition_kind(d, Sale1042);
    when qualified_securities_value_after_disposition(d, held);
    when employer_securities_total_value_at_disposition(d, total);
    when held < total * EsopMinimumValueShare1042;
    then esop_holdings_test_failed(d);
}
rule EsopHoldingsTestValueBelowShare664g(d: EsopDisposition, held: Money, total: Money) defeasible {
    label en official "section 4978(a)(2): qualified employer securities held are worth less than 60 percent of all employer securities (section 664(g) qualified gratuitous transfer)";
    when esop_acquisition_kind(d, QualifiedGratuitousTransfer664g);
    when qualified_securities_value_after_disposition(d, held);
    when employer_securities_total_value_at_disposition(d, total);
    when held < total * EsopMinimumValueShare664g;
    then esop_holdings_test_failed(d);
}
rule EsopEarlyDispositionTaxable(d: EsopDisposition, r: EsopExceptionReason) defeasible {
    label en official "section 4978(a), (d): a disposition within the 3-year period that fails the holdings test, unless excepted";
    when esop_within_three_year_period(d);
    when esop_holdings_test_failed(d);
    unless esop_disposition_excepted_reason(d, r) and esop_within_three_year_period(d) and esop_holdings_test_failed(d);
    then esop_early_disposition_taxable(d);
}
@source(IRC_S4978_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) shall be equal to 10 percent of the amount realized on the disposition.")
pub relation esop_disposition_tax(d: EsopDisposition, payer: Person, amount: Money) kind institutional {
    label en official "section 4978(a)-(c): 10 percent of the amount realized (limited to the portion allocable to the protected securities), paid by the employer or cooperative that made the written statement";
}
rule EsopDispositionTax(d: EsopDisposition, payer: Person, realized: Money, allocable: Money) defeasible {
    label en official "section 4978(b)(1)-(2), (c): 10 percent of the lesser of the amount realized and the allocable portion; cents HALF_UP (JUDGMENT CALL)";
    when esop_early_disposition_taxable(d);
    when written_statement_maker(d, payer);
    when esop_amount_realized(d, realized);
    when esop_amount_allocable_to_protected_securities(d, allocable);
    then esop_disposition_tax(d, payer, round(min(realized, allocable) * EsopDispositionTaxRate4978, 2, "HALF_UP"));
}

// ============================================================================
// Section 4979 — excess contributions and excess aggregate contributions
// ============================================================================

enum PlanKind4979 {
    Section401aTrustPlan4979;
    Section403aAnnuityPlan4979;
    Section403bAnnuityContract4979;
    SimplifiedEmployeePension4979;
    Section501c18Plan4979;
}
pub relation plan_kind_4979(plan: Plan, k: PlanKind4979) kind empirical {
    label en official "section 4979(e)(1)-(5): the plan is a 401(a) plan with a section 501(a) trust, a 403(a) annuity plan, a 403(b) annuity contract, a simplified employee pension satisfying 408(k), or a 501(c)(18) plan (or one the Secretary has determined to be such at any time)";
}
pub relation excess_contributions_for_plan_year(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4979(a)(1), (c): the excess contributions (401(k)(8)(B), 408(k)(6)(C), 501(c)(18)) for the plan year ending in the taxable year; the section 401(k)(8)(B) branch is derived in 99-wire9-owner-contracts.law from `us.irc.deferred_compensation::excess_contributions_amount`, the other branches stay case facts";
}
pub relation excess_aggregate_contributions_for_plan_year(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4979(a)(2), (d): the excess aggregate contributions (401(m)(6)(B)) for the plan year ending in the taxable year; derived in 99-wire9-owner-contracts.law from `us.irc.deferred_compensation::excess_aggregate_contributions_amount`, a case may still assert it directly";
}
pub relation excess_distributed_or_forfeited_in_window(plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4979(f)(1): the part of the excess (with allocable income through the end of the plan year) distributed, or forfeited if forfeitable, before the close of the first 2½ months (6 months for an eligible automatic contribution arrangement) of the following plan year";
}
pub relation plan_sponsoring_employer_4979(plan: Plan, employer: Person) kind empirical {
    label en official "section 4979(b): the employer that pays the tax";
}
pub relation plan_year_end_4979(plan: Plan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "the last day of the plan year ending in the taxable year";
}
pub relation eligible_automatic_contribution_arrangement_4979(plan: Plan) kind empirical {
    label en official "section 4979(f)(1): the excess relates to an eligible automatic contribution arrangement (414(w)(3))";
}
pub relation distribution_window_end_4979(plan: Plan, y: TaxableYear, on: Date) kind institutional {
    label en official "section 4979(f)(1): the last day of the window: the 15th day of the third month of the following plan year (2½ months: first day of the following year plus 2 months plus 14 days), or the last day of its sixth month (6 months) — JUDGMENT CALL on the half month";
}
rule DistributionWindowEnd25Months(plan: Plan, y: TaxableYear, endd: Date) defeasible {
    label en official "section 4979(f)(1): first 2½ months of the following plan year";
    when plan_year_end_4979(plan, y, endd);
    unless eligible_automatic_contribution_arrangement_4979(plan) and plan_year_end_4979(plan, y, endd);
    then distribution_window_end_4979(plan, y, add_calendar_period(add_calendar_period(add_calendar_period(endd, 1 calendar_day), 2 calendar_month), 14 calendar_day));
}
rule DistributionWindowEndSixMonths(plan: Plan, y: TaxableYear, endd: Date, calendar_before_1: Date) defeasible {
    label en official "section 4979(f)(1): first 6 months of the following plan year for an eligible automatic contribution arrangement";
    when plan_year_end_4979(plan, y, endd);
    when eligible_automatic_contribution_arrangement_4979(plan)
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(add_calendar_period(endd, 1 calendar_day), 6 calendar_month), 1, us.irc.core::CalendarDay, calendar_before_1);
    then distribution_window_end_4979(plan, y, calendar_before_1);
}
pub relation excess_distributed_on(plan: Plan, y: TaxableYear, amount: Money, on: Date) kind empirical {
    label en official "section 4979(f)(1): an amount of the excess distributed (or forfeited) on this date";
}
pub relation excess_timely_distributed_amount(plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4979(f)(1): the part of the excess distributed or forfeited within the window";
}
rule ExcessTimelyDistributedAmount(plan: Plan, y: TaxableYear, amt: Money, on: Date, endw: Date) defeasible {
    label en official "section 4979(f)(1): the part distributed or forfeited on or before the window end";
    when excess_distributed_on(plan, y, amt, on);
    when distribution_window_end_4979(plan, y, endw);
    when on <= endw;
    then excess_timely_distributed_amount(plan, y, amt);
}
@source(IRC_S4979_A, coverage = exact, quote = "there is hereby imposed a tax for the taxable year equal to 10 percent of the sum of—")
pub relation excess_contributions_plan_tax(plan: Plan, employer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 4979(a), (b), (f): 10 percent of the excess contributions and excess aggregate contributions not timely distributed, paid by the employer";
}
rule ExcessContributionsPlanTax(plan: Plan, employer: Person, y: TaxableYear, ec: Money, eac: Money, timely: Money, k: PlanKind4979, begin: Date) defeasible {
    label en official "section 4979(a), (f)(1): 10 percent × (excess contributions + excess aggregate contributions − timely distributed part); cents HALF_UP (JUDGMENT CALL)";
    when plan_kind_4979(plan, k);
    when plan_sponsoring_employer_4979(plan, employer);
    when excess_contributions_for_plan_year(plan, y, ec);
    when excess_aggregate_contributions_for_plan_year(plan, y, eac);
    when excess_timely_distributed_amount(plan, y, timely);
    when ec + eac > timely;
    then excess_contributions_plan_tax(plan, employer, y, round((ec + eac - timely) * ExcessContributionsPlanTaxRate4979, 2, "HALF_UP"));
}
rule ExcessContributionsPlanTaxNothingDistributed(plan: Plan, employer: Person, y: TaxableYear, ec: Money, eac: Money, k: PlanKind4979) defeasible {
    label en official "section 4979(a): with no timely distribution the whole excess is taxed";
    when plan_kind_4979(plan, k);
    when plan_sponsoring_employer_4979(plan, employer);
    when excess_contributions_for_plan_year(plan, y, ec);
    when excess_aggregate_contributions_for_plan_year(plan, y, eac);
    unless excess_timely_distributed_amount(plan, y, _) and plan_kind_4979(plan, k) and plan_sponsoring_employer_4979(plan, employer) and excess_contributions_for_plan_year(plan, y, ec) and excess_aggregate_contributions_for_plan_year(plan, y, eac);
    then excess_contributions_plan_tax(plan, employer, y, round((ec + eac) * ExcessContributionsPlanTaxRate4979, 2, "HALF_UP"));
}

// ============================================================================
// Section 4979A — prohibited ESOP allocations
// ============================================================================

enum Prohibited4979AKind {
    ProhibitedAllocation409n;
    Allocation664g5A;
    Allocation409pViolation;
    SyntheticEquityOfDisqualifiedPerson;
}
entity EsopAllocationEvent { label en unofficial "an allocation or ownership event described in section 4979A(a)"; }
pub relation esop_event_kind_4979A(a: EsopAllocationEvent, k: Prohibited4979AKind) kind empirical {
    label en official "section 4979A(a)(1)-(4): which of the four events the allocation or ownership is";
}
pub relation esop_event_amount_involved(a: EsopAllocationEvent, amount: Money) kind institutional {
    label en official "section 4979A(a), (e)(2): the amount involved (for (a)(3): the amount allocated to the account of a person in violation of 409(p)(1); for (a)(4): the value of the shares on which the synthetic equity is based; for the first nonallocation year the total deemed-owned shares of disqualified persons)";
}
pub relation esop_event_payer(a: EsopAllocationEvent, payer: Person) kind empirical {
    label en official "section 4979A(c): for (a)(1)-(2) the employer sponsoring the plan or the cooperative that made the written statement (664(g)(1)(E)/1042(b)(3)(B)); for (a)(3)-(4) the S corporation whose stock was allocated or owned";
}
@source(IRC_S4979A_A, coverage = exact, quote = "there is hereby imposed a tax on such allocation or ownership equal to 50 percent of the amount involved.")
pub relation prohibited_esop_allocation_tax(a: EsopAllocationEvent, payer: Person, amount: Money) kind institutional {
    label en official "section 4979A(a), (c): 50 percent of the amount involved, paid by the employer/cooperative or, for (a)(3)-(4), the S corporation";
}
rule ProhibitedEsopAllocationTax(a: EsopAllocationEvent, payer: Person, amt: Money, k: Prohibited4979AKind) defeasible {
    label en official "section 4979A(a): 50 percent of the amount involved; cents HALF_UP (JUDGMENT CALL)";
    when esop_event_kind_4979A(a, k);
    when esop_event_payer(a, payer);
    when esop_event_amount_involved(a, amt);
    then prohibited_esop_allocation_tax(a, payer, round(amt * ProhibitedAllocationTaxRate4979A, 2, "HALF_UP"));
}
pub relation esop_event_first_allocation_or_notice_date(a: EsopAllocationEvent, on: Date) kind empirical {
    label en official "sections 4979A(d), (e)(2)(D): the later of the allocation/ownership (or first allocation in connection with a qualified gratuitous transfer) and the date the Secretary is notified";
}
pub relation special_assessment_period_not_before(a: EsopAllocationEvent, on: Date) kind institutional {
    label en official "sections 4979A(d), (e)(2)(D): the statutory period for assessment does not expire before 3 years from the later of the allocation/ownership and the Secretary's notification";
}
rule SpecialAssessmentPeriodNotBefore(a: EsopAllocationEvent, later: Date) defeasible {
    label en official "sections 4979A(d), (e)(2)(D): three years from the later date (the later date is asserted; a maximum over the two dates is not computed)";
    when esop_event_first_allocation_or_notice_date(a, later);
    then special_assessment_period_not_before(a, add_calendar_period(later, 3 calendar_year));
}
