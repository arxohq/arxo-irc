        assert "f2": rmd_shortfall_due_to_reasonable_error(entity_ref("urn:test:s4958x:t23#a")) { origin case_input; }
        assert "f3": rmd_reasonable_steps_being_taken_to_remedy(entity_ref("urn:test:s4958x:t23#a")) { origin case_input; }
    }
    // Section 4974(d): the Secretary's exercise with both showings (valid_when).
    evaluate truth(rmd_waiver_conditions_met(entity_ref("urn:test:s4958x:t23#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
