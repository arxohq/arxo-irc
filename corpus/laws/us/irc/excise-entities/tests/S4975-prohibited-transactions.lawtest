// Scenarios for 26 U.S.C. §4975 (prohibited transactions), module
// 10-prohibited-transactions-4975.law. NOT executed this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4975-01-INITIAL-TAX-15-PERCENT-FIDUCIARY-SELF-DEALING" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4975:t1#a"), ProhibitedTransaction) { origin case_input; }
        assert "f1": prohibited_transaction_type(entity_ref("urn:test:s4975:t1#a"), FiduciarySelfDealing) { origin case_input; }
        assert "f2": prohibited_transaction_disqualified_person(entity_ref("urn:test:s4975:t1#a"), entity_ref("urn:test:s4975:t1#p")) { origin case_input; }
        assert "f3": prohibited_transaction_plan(entity_ref("urn:test:s4975:t1#a"), entity_ref("urn:test:s4975:t1#plan")) { origin case_input; }
        assert "f4": is_fiduciary_4975(entity_ref("urn:test:s4975:t1#p"), entity_ref("urn:test:s4975:t1#plan")) { origin case_input; }
        assert "f5": is_plan(entity_ref("urn:test:s4975:t1#plan"), @2026-01-01) { origin case_input; }
        assert "f6": prohibited_transaction_amount_involved(entity_ref("urn:test:s4975:t1#a"), 50000.00 USD) { origin case_input; }
        assert "f7": prohibited_transaction_years_in_taxable_period(entity_ref("urn:test:s4975:t1#a"), 1) { origin case_input; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4975:t1#a"), entity_ref("urn:test:s4975:t1#p"), 7500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4975-02-ADDITIONAL-TAX-NOT-CORRECTED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4975:t2#a"), ProhibitedTransaction) { origin case_input; }
        assert "f1": prohibited_transaction_type(entity_ref("urn:test:s4975:t2#a"), LendingOrExtensionOfCredit) { origin case_input; }
        assert "f2": prohibited_transaction_disqualified_person(entity_ref("urn:test:s4975:t2#a"), entity_ref("urn:test:s4975:t2#p")) { origin case_input; }
        assert "f3": prohibited_transaction_plan(entity_ref("urn:test:s4975:t2#a"), entity_ref("urn:test:s4975:t2#plan")) { origin case_input; }
        assert "f4": is_service_provider_4975(entity_ref("urn:test:s4975:t2#p"), entity_ref("urn:test:s4975:t2#plan")) { origin case_input; }
        assert "f5": is_plan(entity_ref("urn:test:s4975:t2#plan"), @2025-01-01) { origin case_input; }
        assert "f6": prohibited_transaction_amount_involved(entity_ref("urn:test:s4975:t2#a"), 100000.00 USD) { origin case_input; }
        assert "f7": excise_act_occurred_on(entity_ref("urn:test:s4975:t2#a"), @2025-01-10) { origin case_input; }
    }
    evaluate truth(additional_tax(entity_ref("urn:test:s4975:t2#a"), entity_ref("urn:test:s4975:t2#p"), 100000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4975-03-EXEMPT-PARTICIPANT-LOAN-NO-TAX" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4975:t3#a"), ProhibitedTransaction) { origin case_input; }
        assert "f1": prohibited_transaction_type(entity_ref("urn:test:s4975:t3#a"), LendingOrExtensionOfCredit) { origin case_input; }
        assert "f2": prohibited_transaction_disqualified_person(entity_ref("urn:test:s4975:t3#a"), entity_ref("urn:test:s4975:t3#p")) { origin case_input; }
        assert "f3": prohibited_transaction_plan(entity_ref("urn:test:s4975:t3#a"), entity_ref("urn:test:s4975:t3#plan")) { origin case_input; }
        assert "f4": is_service_provider_4975(entity_ref("urn:test:s4975:t3#p"), entity_ref("urn:test:s4975:t3#plan")) { origin case_input; }
        assert "f5": is_plan(entity_ref("urn:test:s4975:t3#plan"), @2025-01-01) { origin case_input; }
        assert "f6": prohibited_transaction_amount_involved(entity_ref("urn:test:s4975:t3#a"), 5000.00 USD) { origin case_input; }
        assert "f7": prohibited_transaction_years_in_taxable_period(entity_ref("urn:test:s4975:t3#a"), 1) { origin case_input; }
        assert "f8": participant_loan_reasonably_equivalent_basis(entity_ref("urn:test:s4975:t3#a")) { origin case_input; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4975:t3#a"), entity_ref("urn:test:s4975:t3#p"), 750.00 USD));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
