// Excise entities WIRE-10 group D scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "W10-D-EE-01-NO-OFFER-PAYMENT-MAKES-AN-ASSESSABLE-PAYMENT-FOR-THE-YEAR" {
    given {
        context {
            legal_time @2014-08-01;
            decision_time @2014-08-01T09:00:00-05:00;
            knowledge_time @2014-08-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": full_time_employees_average_preceding_year(entity_ref("urn:test:w10dee:n1#e"), 2014, 120.0) { origin case_input; }
        assert "f1": non_full_time_hours_of_service_average_month(entity_ref("urn:test:w10dee:n1#e"), 2014, 0.0) { origin case_input; }
        assert "f2": payment_year_4980H(2014) { origin case_input; }
        assert "f3": full_time_employees_in_month(entity_ref("urn:test:w10dee:n1#e"), 2014, 201406, 100) { origin case_input; }
        assert "f4": full_time_employees_certified_for_credit_or_reduction(entity_ref("urn:test:w10dee:n1#e"), 201406, 3) { origin case_input; }
        assert "f5": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dee:n1#y"), 2014) { origin case_input; }
    }
    evaluate truth(us.irc.assessment::assessable_payment_4980h(entity_ref("urn:test:w10dee:n1#e"), entity_ref("urn:test:w10dee:n1#y")));
    expect truth_status == TRUE_ONLY;
}

test "W10-D-EE-02-NO-MONTHLY-PAYMENT-NO-ASSESSABLE-PAYMENT-FOR-THE-YEAR" {
    given {
        context {
            legal_time @2014-08-01;
            decision_time @2014-08-01T09:00:00-05:00;
            knowledge_time @2014-08-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": us.irc.core::calendar_year_of(entity_ref("urn:test:w10dee:n2#y"), 2014) { origin case_input; }
    }
    evaluate truth(us.irc.assessment::assessable_payment_4980h(entity_ref("urn:test:w10dee:n2#e"), entity_ref("urn:test:w10dee:n2#y")));
    expect truth_status == FALSE_ONLY;
}
