// Scenarios for 26 U.S.C. §4958 (excess benefit transactions), module
// 07-excess-benefit-4958.law. NOT executed this stage (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4958-01-INITIAL-TAX-25-PERCENT-DISQUALIFIED-PERSON-WITHIN-5-YEAR-LOOKBACK" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4958:t1#a"), ExcessBenefitTransaction) { origin case_input; }
        assert "f1": excess_benefit_organization(entity_ref("urn:test:s4958:t1#a"), entity_ref("urn:test:s4958:t1#org")) { origin case_input; }
        assert "f2": excess_benefit_disqualified_person(entity_ref("urn:test:s4958:t1#a"), entity_ref("urn:test:s4958:t1#p")) { origin case_input; }
        assert "f3": excess_benefit_transaction_date(entity_ref("urn:test:s4958:t1#a"), @2027-03-01) { origin case_input; }
        assert "f4": applicable_tax_exempt_organization(entity_ref("urn:test:s4958:t1#org"), @2027-03-01) { origin case_input; }
        assert "f5": position_of_substantial_influence_on(entity_ref("urn:test:s4958:t1#p"), entity_ref("urn:test:s4958:t1#org"), @2024-06-01) { origin case_input; }
        assert "f6": economic_benefit_provided(entity_ref("urn:test:s4958:t1#a"), 100000.00 USD) { origin case_input; }
        assert "f7": consideration_received(entity_ref("urn:test:s4958:t1#a"), 60000.00 USD) { origin case_input; }
    }
    // held the position in 2024-06, within the 5 years ending 2027-03-01 -> disqualified person.
    evaluate truth(initial_tax(entity_ref("urn:test:s4958:t1#a"), entity_ref("urn:test:s4958:t1#p"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4958-02-OUTSIDE-5-YEAR-LOOKBACK-NOT-DISQUALIFIED" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4958:t2#a"), ExcessBenefitTransaction) { origin case_input; }
        assert "f1": excess_benefit_organization(entity_ref("urn:test:s4958:t2#a"), entity_ref("urn:test:s4958:t2#org")) { origin case_input; }
        assert "f2": excess_benefit_disqualified_person(entity_ref("urn:test:s4958:t2#a"), entity_ref("urn:test:s4958:t2#p")) { origin case_input; }
        assert "f3": excess_benefit_transaction_date(entity_ref("urn:test:s4958:t2#a"), @2027-03-01) { origin case_input; }
        assert "f4": applicable_tax_exempt_organization(entity_ref("urn:test:s4958:t2#org"), @2027-03-01) { origin case_input; }
        // position held 2021-06-01 — more than 5 years before 2027-03-01.
        assert "f5": position_of_substantial_influence_on(entity_ref("urn:test:s4958:t2#p"), entity_ref("urn:test:s4958:t2#org"), @2021-06-01) { origin case_input; }
        assert "f6": economic_benefit_provided(entity_ref("urn:test:s4958:t2#a"), 100000.00 USD) { origin case_input; }
        assert "f7": consideration_received(entity_ref("urn:test:s4958:t2#a"), 60000.00 USD) { origin case_input; }
    }
    evaluate truth(disqualified_person_4958(entity_ref("urn:test:s4958:t2#p"), entity_ref("urn:test:s4958:t2#org"), entity_ref("urn:test:s4958:t2#a")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4958-03-MANAGER-TAX-CAPPED-AT-20000" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4958:t3#a"), ExcessBenefitTransaction) { origin case_input; }
        assert "f1": excess_benefit_organization(entity_ref("urn:test:s4958:t3#a"), entity_ref("urn:test:s4958:t3#org")) { origin case_input; }
        assert "f2": excess_benefit_disqualified_person(entity_ref("urn:test:s4958:t3#a"), entity_ref("urn:test:s4958:t3#p")) { origin case_input; }
        assert "f3": excess_benefit_transaction_date(entity_ref("urn:test:s4958:t3#a"), @2027-03-01) { origin case_input; }
        assert "f4": applicable_tax_exempt_organization(entity_ref("urn:test:s4958:t3#org"), @2027-03-01) { origin case_input; }
        assert "f5": position_of_substantial_influence_on(entity_ref("urn:test:s4958:t3#p"), entity_ref("urn:test:s4958:t3#org"), @2026-06-01) { origin case_input; }
        assert "f6": economic_benefit_provided(entity_ref("urn:test:s4958:t3#a"), 1000000.00 USD) { origin case_input; }
        assert "f7": consideration_received(entity_ref("urn:test:s4958:t3#a"), 0.00 USD) { origin case_input; }
        assert "f8": excess_benefit_organization_manager(entity_ref("urn:test:s4958:t3#mgr"), entity_ref("urn:test:s4958:t3#org")) { origin case_input; }
        assert "f9": manager_knew_excess_benefit_transaction(entity_ref("urn:test:s4958:t3#a"), entity_ref("urn:test:s4958:t3#mgr")) { origin adjudicated; }
    }
    // raw 10% * $1,000,000 = $100,000, far above the $20,000 (d)(2) cap.
    evaluate truth(initial_tax(entity_ref("urn:test:s4958:t3#a"), entity_ref("urn:test:s4958:t3#mgr"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
