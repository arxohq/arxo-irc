        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": drug_is_designated_drug(entity_ref("urn:test:s5000D:t4#s")) { origin case_input; }
        assert "f1": drug_sale_seller(entity_ref("urn:test:s5000D:t4#s"), entity_ref("urn:test:s5000D:t4#seller")) { origin case_input; }
        assert "f2": drug_sale_price(entity_ref("urn:test:s5000D:t4#s"), 1000.00 USD) { origin case_input; }
        assert "f3": drug_sale_on_noncompliance_day(entity_ref("urn:test:s5000D:t4#s"), 300) { origin case_input; }
    }
    evaluate truth(designated_drug_sale_tax(entity_ref("urn:test:s5000D:t4#s"), entity_ref("urn:test:s5000D:t4#seller"), 19000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

