test "S4942I-02-SIX-YEAR-PERIOD-IS-NOT-AN-ADJUSTMENT-PERIOD" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942x:t44#a"), 10000000.00 USD) { origin case_input; }
        assert "f1": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942x:t44#a"), 2000000.00 USD) { origin case_input; }
        assert "f2": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942x:t44#a"), 20000.00 USD) { origin case_input; }
        assert "f3": excise_act_kind(entity_ref("urn:test:s4942x:t44#a"), UndistributedIncomeYear) { origin case_input; }
        assert "f4": undistributed_income_foundation(entity_ref("urn:test:s4942x:t44#a"), entity_ref("urn:test:s4942x:t44#f")) { origin case_input; }
        assert "f5": undistributed_income_year(entity_ref("urn:test:s4942x:t44#a"), entity_ref("urn:test:s4942x:t44#y")) { origin case_input; }
        assert "f6": adjustment_period_years(entity_ref("urn:test:s4942x:t44#f"), entity_ref("urn:test:s4942x:t44#y"), 6) { origin case_input; }
        assert "f7": adjustment_period_qualifying_distributions(entity_ref("urn:test:s4942x:t44#f"), entity_ref("urn:test:s4942x:t44#y"), 500000.00 USD) { origin case_input; }
        assert "f8": adjustment_period_distributable_amounts(entity_ref("urn:test:s4942x:t44#f"), entity_ref("urn:test:s4942x:t44#y"), 420000.00 USD) { origin case_input; }
    }
    // Section 4942(i)(2): not exceeding 5 taxable years.
    evaluate truth(distributable_amount_reduction_4942i(entity_ref("urn:test:s4942x:t44#f"), entity_ref("urn:test:s4942x:t44#y"), 80000.00 USD));
    expect truth_status == NEITHER;
}

test "S4942I-03-NO-EXCESS-NO-ADJUSTMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942x:t45#a"), 10000000.00 USD) { origin case_input; }
        assert "f1": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942x:t45#a"), 2000000.00 USD) { origin case_input; }
        assert "f2": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942x:t45#a"), 20000.00 USD) { origin case_input; }
        assert "f3": excise_act_kind(entity_ref("urn:test:s4942x:t45#a"), UndistributedIncomeYear) { origin case_input; }
        assert "f4": undistributed_income_foundation(entity_ref("urn:test:s4942x:t45#a"), entity_ref("urn:test:s4942x:t45#f")) { origin case_input; }
        assert "f5": undistributed_income_year(entity_ref("urn:test:s4942x:t45#a"), entity_ref("urn:test:s4942x:t45#y")) { origin case_input; }
        assert "f6": adjustment_period_years(entity_ref("urn:test:s4942x:t45#f"), entity_ref("urn:test:s4942x:t45#y"), 5) { origin case_input; }
        assert "f7": adjustment_period_qualifying_distributions(entity_ref("urn:test:s4942x:t45#f"), entity_ref("urn:test:s4942x:t45#y"), 400000.00 USD) { origin case_input; }
        assert "f8": adjustment_period_distributable_amounts(entity_ref("urn:test:s4942x:t45#f"), entity_ref("urn:test:s4942x:t45#y"), 420000.00 USD) { origin case_input; }
    }
    // Section 4942(i)(1): distributions do not exceed the distributable amounts.
    evaluate truth(distributable_amount_after_4942i(entity_ref("urn:test:s4942x:t45#a"), 380000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4942I-04-REDUCED-DISTRIBUTABLE-AMOUNT-LOWERS-UNDISTRIBUTED-INCOME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942x:t46#a"), 10000000.00 USD) { origin case_input; }
        assert "f1": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942x:t46#a"), 2000000.00 USD) { origin case_input; }
        assert "f2": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942x:t46#a"), 20000.00 USD) { origin case_input; }
        assert "f3": qualifying_distributions_made(entity_ref("urn:test:s4942x:t46#a"), 100000.00 USD) { origin case_input; }
        assert "f4": excise_act_kind(entity_ref("urn:test:s4942x:t46#a"), UndistributedIncomeYear) { origin case_input; }
        assert "f5": undistributed_income_foundation(entity_ref("urn:test:s4942x:t46#a"), entity_ref("urn:test:s4942x:t46#f")) { origin case_input; }
        assert "f6": undistributed_income_year(entity_ref("urn:test:s4942x:t46#a"), entity_ref("urn:test:s4942x:t46#y")) { origin case_input; }
        assert "f7": adjustment_period_years(entity_ref("urn:test:s4942x:t46#f"), entity_ref("urn:test:s4942x:t46#y"), 5) { origin case_input; }
        assert "f8": adjustment_period_qualifying_distributions(entity_ref("urn:test:s4942x:t46#f"), entity_ref("urn:test:s4942x:t46#y"), 500000.00 USD) { origin case_input; }
        assert "f9": adjustment_period_distributable_amounts(entity_ref("urn:test:s4942x:t46#f"), entity_ref("urn:test:s4942x:t46#y"), 420000.00 USD) { origin case_input; }
    }
    // Section 4942(c) with (i): distributable 300,000 - 100,000 distributed = 200,000.
    evaluate truth(undistributed_income(entity_ref("urn:test:s4942x:t46#a"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
