// Scenarios for 26 U.S.C. §4974 (RMD shortfall), module 05-rmd-shortfall-4974.law.
// Written from the text; NOT executed this stage (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4974-01-STANDARD-25-PERCENT-NO-CORRECTION" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4974:t1#a"), RmdShortfall) { origin case_input; }
        assert "f1": rmd_payee(entity_ref("urn:test:s4974:t1#a"), entity_ref("urn:test:s4974:t1#payee")) { origin case_input; }
        assert "f2": rmd_minimum_required_distribution(entity_ref("urn:test:s4974:t1#a"), 10000.00 USD) { origin case_input; }
        assert "f3": rmd_actual_distribution(entity_ref("urn:test:s4974:t1#a"), 4000.00 USD) { origin case_input; }
    }
    evaluate truth(rmd_shortfall_tax(entity_ref("urn:test:s4974:t1#a"), entity_ref("urn:test:s4974:t1#payee"), 1500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4974-02-REDUCED-10-PERCENT-CORRECTED-WITHIN-WINDOW" {
    given {
        context { decision_time @2027-06-01T09:00:00-04:00; knowledge_time @2027-06-01T09:00:00-04:00; legal_time @2027-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4974:t2#a"), RmdShortfall) { origin case_input; }
        assert "f1": rmd_payee(entity_ref("urn:test:s4974:t2#a"), entity_ref("urn:test:s4974:t2#payee")) { origin case_input; }
        assert "f2": rmd_minimum_required_distribution(entity_ref("urn:test:s4974:t2#a"), 10000.00 USD) { origin case_input; }
        assert "f3": rmd_actual_distribution(entity_ref("urn:test:s4974:t2#a"), 4000.00 USD) { origin case_input; }
        assert "f4": rmd_shortfall_tax_imposed_on(entity_ref("urn:test:s4974:t2#a"), @2027-04-01) { origin case_input; }
        assert "f5": rmd_second_taxable_year_end(entity_ref("urn:test:s4974:t2#a"), @2029-12-31) { origin case_input; }
        assert "f6": rmd_shortfall_distributed_during_window(entity_ref("urn:test:s4974:t2#a"), @2027-05-01) { origin case_input; }
        assert "f7": rmd_return_submitted_during_window(entity_ref("urn:test:s4974:t2#a"), @2027-05-01) { origin case_input; }
    }
    evaluate truth(rmd_shortfall_tax(entity_ref("urn:test:s4974:t2#a"), entity_ref("urn:test:s4974:t2#payee"), 600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

