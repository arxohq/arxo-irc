// Exempt purpose expenditures 400,000: table row 1 gives 20% = 80,000 lobbying nontaxable amount; grass roots nontaxable 25% = 20,000.
// Lobbying excess 100,000-80,000 = 20,000; grass roots excess 30,000-20,000 = 10,000; the greater is 20,000; tax 25% = 5,000.
test "S4911-01-EXCESS-LOBBYING-TAX-25-PERCENT-OF-GREATER-EXCESS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.exempt_organizations::section_501h_election_in_effect(entity_ref("urn:test:s4911:t1#o"), entity_ref("urn:test:s4911:t1#y")) { origin case_input; }
        assert "f1": exempt_purpose_expenditures(entity_ref("urn:test:s4911:t1#o"), entity_ref("urn:test:s4911:t1#y"), 400000.00 USD) { origin case_input; }
        assert "f2": lobbying_expenditures_4911(entity_ref("urn:test:s4911:t1#o"), entity_ref("urn:test:s4911:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f3": grass_roots_expenditures_4911(entity_ref("urn:test:s4911:t1#o"), entity_ref("urn:test:s4911:t1#y"), 30000.00 USD) { origin case_input; }
    }
    evaluate truth(excess_lobbying_tax(entity_ref("urn:test:s4911:t1#o"), entity_ref("urn:test:s4911:t1#y"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

