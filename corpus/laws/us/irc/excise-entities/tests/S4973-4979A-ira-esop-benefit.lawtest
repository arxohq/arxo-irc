        assert "f1": prior_year_excess_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 1000.00 USD) { origin case_input; }
        assert "f2": reducing_distributions_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 500.00 USD) { origin case_input; }
        assert "f3": account_value_at_close_of_year(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 20000.00 USD) { origin case_input; }
        assert "f4": allowable_amount_for_year_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 5000.00 USD) { origin case_input; }
        assert "f5": maximum_allowable_for_year_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 5000.00 USD) { origin case_input; }
        assert "f6": contributed_including_roth_for_year_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 8000.00 USD) { origin case_input; }
    }
    evaluate truth(excess_contributions_tax_4973(entity_ref("urn:test:s4973:t1#p"), entity_ref("urn:test:s4973:t1#y"), IndividualRetirementAccountOrAnnuity, 210.00 USD));
