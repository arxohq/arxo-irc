        assert "f6": institution_own_net_investment_income(entity_ref("urn:test:s4968:t5#i"), entity_ref("urn:test:s4968:t5#y"), 10000000.00 USD) { origin case_input; }
        assert "f7": student_loan_interest_income(entity_ref("urn:test:s4968:t5#i"), entity_ref("urn:test:s4968:t5#y"), 0.00 USD) { origin case_input; }
        assert "f8": federally_subsidized_royalty_income(entity_ref("urn:test:s4968:t5#i"), entity_ref("urn:test:s4968:t5#y"), 0.00 USD) { origin case_input; }
    }
    evaluate truth(applicable_educational_institution(entity_ref("urn:test:s4968:t5#i"), entity_ref("urn:test:s4968:t5#y")));
    expect truth_status == NEITHER;
}

// Assets 2,000,000,000 + 400,000,000 over 4,000 students = 600,000 (tier 1, 1.4%); net investment income 50,000,000 + 5,000,000 + 1,000,000 + 10,000,000 = 66,000,000; tax 924,000.
test "S4968-06-2026-RELATED-ORGANIZATION-AND-OVERRIDE-ITEMS-COUNTED" {
    given {
        context { decision_time @2026-09-01T09:00:00-04:00; knowledge_time @2026-09-01T09:00:00-04:00; legal_time @2026-09-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": eligible_educational_institution_25Af2(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s4968:t6#y"), @2026-01-01) { origin case_input; }
        assert "f2": tuition_paying_students_preceding_year(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 4000) { origin case_input; }
        assert "f3": share_of_tuition_paying_students_in_united_states(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 0.7) { origin case_input; }
        assert "f4": own_nonexempt_use_assets_end_of_preceding_year(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 2000000000.00 USD) { origin case_input; }
        assert "f5": number_of_students_for_endowment(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 4000) { origin case_input; }
        assert "f6": institution_own_net_investment_income(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 50000000.00 USD) { origin case_input; }
        assert "f7": student_loan_interest_income(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 5000000.00 USD) { origin case_input; }
        assert "f8": federally_subsidized_royalty_income(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 1000000.00 USD) { origin case_input; }
        assert "f9": controls_or_controlled_by_institution(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#r")) { origin case_input; }
        assert "f10": related_organization_controlled_by_or_509a3_of_institution(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#r"), entity_ref("urn:test:s4968:t6#y")) { origin case_input; }
        assert "f11": related_organization_assets(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#r"), entity_ref("urn:test:s4968:t6#y"), 400000000.00 USD) { origin case_input; }
        assert "f12": related_organization_net_investment_income(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#r"), entity_ref("urn:test:s4968:t6#y"), 10000000.00 USD) { origin case_input; }
    }
    evaluate truth(college_investment_income_tax(entity_ref("urn:test:s4968:t6#i"), entity_ref("urn:test:s4968:t6#y"), 924000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

