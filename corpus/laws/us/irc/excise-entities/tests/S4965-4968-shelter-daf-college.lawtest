// Net income 100,000; 75% of proceeds 200,000 = 150,000; the greater is 150,000; 21% = 31,500.
test "S4965-01-ENTITY-TAX-HIGHEST-RATE-TIMES-GREATER-OF-NET-INCOME-AND-75-PERCENT-PROCEEDS" {
    given {
        context { decision_time @2025-06-01T09:00:00-04:00; knowledge_time @2025-06-01T09:00:00-04:00; legal_time @2025-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4965:t1#a"), ProhibitedTaxShelter) { origin case_input; }
        assert "f1": tax_exempt_entity_kind_4965(entity_ref("urn:test:s4965:t1#e"), Section501cOr501dOrganization) { origin case_input; }
        assert "f2": listed_transaction(entity_ref("urn:test:s4965:t1#a")) { origin case_input; }
        assert "f3": entity_party_to_transaction_at_time_became(entity_ref("urn:test:s4965:t1#a"), entity_ref("urn:test:s4965:t1#e"), entity_ref("urn:test:s4965:t1#y")) { origin case_input; }
        assert "f4": us.irc.core::begins(entity_ref("urn:test:s4965:t1#y"), @2024-01-01) { origin case_input; }
        assert "f5": highest_section_11_rate(entity_ref("urn:test:s4965:t1#y"), 0.21) { origin case_input; }
        assert "f6": net_income_attributable_to_transaction(entity_ref("urn:test:s4965:t1#a"), entity_ref("urn:test:s4965:t1#e"), entity_ref("urn:test:s4965:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f7": proceeds_attributable_to_transaction(entity_ref("urn:test:s4965:t1#a"), entity_ref("urn:test:s4965:t1#e"), entity_ref("urn:test:s4965:t1#y"), 200000.00 USD) { origin case_input; }
    }
    evaluate truth(tax_shelter_entity_tax(entity_ref("urn:test:s4965:t1#a"), entity_ref("urn:test:s4965:t1#e"), entity_ref("urn:test:s4965:t1#y"), 31500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

