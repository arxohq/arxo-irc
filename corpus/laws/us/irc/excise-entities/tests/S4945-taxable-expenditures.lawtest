// Scenarios for 26 U.S.C. §4945 (taxable expenditures), module
// 06-taxable-expenditures-4945.law. NOT executed this stage (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4945-01-INITIAL-TAX-ON-FOUNDATION-CORRECTED-IN-TIME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4945:t1#a"), TaxableExpenditure) { origin case_input; }
        assert "f1": taxable_expenditure_purpose(entity_ref("urn:test:s4945:t1#a"), Lobbying) { origin case_input; }
        assert "f2": taxable_expenditure_foundation(entity_ref("urn:test:s4945:t1#a"), entity_ref("urn:test:s4945:t1#f")) { origin case_input; }
        assert "f3": taxable_expenditure_amount(entity_ref("urn:test:s4945:t1#a"), 40000.00 USD) { origin case_input; }
        assert "f4": excise_act_occurred_on(entity_ref("urn:test:s4945:t1#a"), @2026-01-10) { origin case_input; }
        assert "f5": act_corrected_on(entity_ref("urn:test:s4945:t1#a"), @2026-02-01) { origin case_input; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4945:t1#a"), entity_ref("urn:test:s4945:t1#f"), 8000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4945-02-ADDITIONAL-TAX-WHEN-NOT-CORRECTED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4945:t2#a"), TaxableExpenditure) { origin case_input; }
        assert "f1": taxable_expenditure_purpose(entity_ref("urn:test:s4945:t2#a"), OtherNonCharitablePurpose) { origin case_input; }
        assert "f2": taxable_expenditure_foundation(entity_ref("urn:test:s4945:t2#a"), entity_ref("urn:test:s4945:t2#f")) { origin case_input; }
        assert "f3": taxable_expenditure_amount(entity_ref("urn:test:s4945:t2#a"), 40000.00 USD) { origin case_input; }
        assert "f4": excise_act_occurred_on(entity_ref("urn:test:s4945:t2#a"), @2025-01-10) { origin case_input; }
    }
    evaluate truth(additional_tax(entity_ref("urn:test:s4945:t2#a"), entity_ref("urn:test:s4945:t2#f"), 40000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4945-03-MANAGER-TAX-CAPPED-AT-10000" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4945:t3#a"), TaxableExpenditure) { origin case_input; }
        assert "f1": taxable_expenditure_purpose(entity_ref("urn:test:s4945:t3#a"), GrantToOrganizationWithoutRequirements) { origin case_input; }
        assert "f2": taxable_expenditure_foundation(entity_ref("urn:test:s4945:t3#a"), entity_ref("urn:test:s4945:t3#f")) { origin case_input; }
        assert "f3": taxable_expenditure_amount(entity_ref("urn:test:s4945:t3#a"), 1000000.00 USD) { origin case_input; }
        assert "f4": officer_director_or_trustee(entity_ref("urn:test:s4945:t3#mgr"), entity_ref("urn:test:s4945:t3#f")) { origin case_input; }
        assert "f5": expenditure_manager_knew_expenditure_was_taxable(entity_ref("urn:test:s4945:t3#a"), entity_ref("urn:test:s4945:t3#mgr")) { origin adjudicated; }
    }
    // raw 5% * $1,000,000 = $50,000, far above the $10,000 (c)(2) cap.
    evaluate truth(initial_tax(entity_ref("urn:test:s4945:t3#a"), entity_ref("urn:test:s4945:t3#mgr"), 10000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4945-04-UNKNOWN-AMOUNT-NEITHER" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4945:t4#a"), TaxableExpenditure) { origin case_input; }
        assert "f1": taxable_expenditure_purpose(entity_ref("urn:test:s4945:t4#a"), Lobbying) { origin case_input; }
        assert "f2": taxable_expenditure_foundation(entity_ref("urn:test:s4945:t4#a"), entity_ref("urn:test:s4945:t4#f")) { origin case_input; }
        // taxable_expenditure_amount unknown
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4945:t4#a"), entity_ref("urn:test:s4945:t4#f"), 8000.00 USD));
    expect truth_status == NEITHER;
}
