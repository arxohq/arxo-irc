test "S5000A-23-PAYMENT-DUTY-ACTIVE-AFTER-NOTICE-AND-DEMAND" {
    given {
        context { decision_time @2015-07-01T09:00:00-04:00; knowledge_time @2015-07-01T09:00:00-04:00; legal_time @2015-07-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": shared_responsibility_penalty(entity_ref("urn:test:s5000A:t23#T"), entity_ref("urn:test:s5000A:t23#y"), 100.00 USD) { origin case_input; }
        assert "f1": notice_and_demand_for_5000A_on(entity_ref("urn:test:s5000A:t23#T"), entity_ref("urn:test:s5000A:t23#y"), @2015-06-01) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5000A:t23#T"));
    expect position(S5000APayPenaltyOnDemand, ACTIVE);
}

test "S5000A-24-NO-CRIMINAL-PROSECUTION-IMMUNITY-ACTIVE" {
    given {
        context { decision_time @2015-07-01T09:00:00-04:00; knowledge_time @2015-07-01T09:00:00-04:00; legal_time @2015-07-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": shared_responsibility_penalty(entity_ref("urn:test:s5000A:t24#T"), entity_ref("urn:test:s5000A:t24#y"), 100.00 USD) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:s5000A:t24#T"));
    expect position(S5000ANoCriminalProsecutionForNonpayment, ACTIVE);
    expect position(S5000ANoLienOrLevyForNonpayment, ACTIVE);
}

