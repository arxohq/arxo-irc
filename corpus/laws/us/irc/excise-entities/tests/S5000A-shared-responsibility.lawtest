// Module 20-individual-shared-responsibility-5000A.law.
// Scenarios written from the pinned statutory text; NOT executed (owner restriction) — implemented_unverified.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

// Flat: 2 x 95 + 1 x 47.50 = 237.50 (cap 285). Percentage: 1% x (80,000 - 20,000) = 600. Monthly = 600 / 12 = 50.00; two months = 100.00 (below the bronze premium 9,000).
test "S5000A-01-2014-PENALTY-GREATER-OF-FLAT-AND-INCOME-PERCENTAGE" {
    given {
        context { decision_time @2014-06-01T09:00:00-04:00; knowledge_time @2014-06-01T09:00:00-04:00; legal_time @2014-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": taxpayer_for_individual(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#p"), entity_ref("urn:test:s5000A:t1#y")) { origin case_input; }
        assert "f1": household_income_for_penalty(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 80000.00 USD) { origin case_input; }
        assert "f2": filing_threshold_for_penalty(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 20000.00 USD) { origin case_input; }
        assert "f3": national_average_bronze_premium(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 9000.00 USD) { origin case_input; }
        assert "f4": coverage_failure_month(entity_ref("urn:test:s5000A:t1#p"), 201401) { origin case_input; }
        assert "f5": failing_individuals_in_month(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 201401, 2, 1) { origin case_input; }
        assert "f6": coverage_failure_month(entity_ref("urn:test:s5000A:t1#p"), 201402) { origin case_input; }
        assert "f7": failing_individuals_in_month(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 201402, 2, 1) { origin case_input; }
    }
    evaluate truth(shared_responsibility_penalty(entity_ref("urn:test:s5000A:t1#T"), entity_ref("urn:test:s5000A:t1#y"), 100.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

