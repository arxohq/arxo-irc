test "S4982C4B-02-PAYMENT-FOR-YEAR-ENDING-IN-THE-SAME-CALENDAR-YEAR-NOT-QUALIFIED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": estimated_payment_of_described_tax(entity_ref("urn:test:s4982x:t26#pay")) { origin case_input; }
        assert "f1": estimated_payment_year_begins_in(entity_ref("urn:test:s4982x:t26#pay"), 2026) { origin case_input; }
        assert "f2": estimated_payment_year_ends_in(entity_ref("urn:test:s4982x:t26#pay"), 2026) { origin case_input; }
    }
    // Section 4982(c)(4)(B): 'begins (but does not end)'.
    evaluate truth(qualified_estimated_tax_payment(entity_ref("urn:test:s4982x:t26#pay"), 2026));
    expect truth_status == NEITHER;
}

test "S4982B-01-REQUIRED-DISTRIBUTION-USES-THE-DERIVED-CAPITAL-GAIN-NET-INCOME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": entity_is_ric(entity_ref("urn:test:s4982x:t27#t"), 2026) { origin case_input; }
        assert "f1": distribution_ordinary_income(entity_ref("urn:test:s4982x:t27#t"), 2026, 1000000.00 USD) { origin case_input; }
        assert "f2": ric_capital_gain_net_income_before_loss(entity_ref("urn:test:s4982x:t27#t"), 2026, 500000.00 USD) { origin case_input; }
        assert "f3": ric_net_capital_gain(entity_ref("urn:test:s4982x:t27#t"), 2026, 300000.00 USD) { origin case_input; }
        assert "f4": ric_net_ordinary_loss_before_deferral(entity_ref("urn:test:s4982x:t27#t"), 2026, 100000.00 USD) { origin case_input; }
        assert "f5": prior_year_grossed_up_required_distribution(entity_ref("urn:test:s4982x:t27#t"), 2026, 0.00 USD) { origin case_input; }
        assert "f6": prior_year_distributed_amount(entity_ref("urn:test:s4982x:t27#t"), 2026, 0.00 USD) { origin case_input; }
    }
    // Section 4982(b)(1) with (e)(2)(B): 98% of 1,000,000 ordinary income + 98.2% of 400,000 derived capital gain net income = 980,000 + 392,800 = 1,372,800.
    evaluate truth(ric_required_distribution(entity_ref("urn:test:s4982x:t27#t"), 2026, 1372800.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
