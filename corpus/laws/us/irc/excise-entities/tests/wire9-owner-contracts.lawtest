        assert "f0": us.irc.deferred_compensation::hce_matching_and_employee_contributions(entity_ref("urn:test:w9exc:c#plan"), entity_ref("urn:test:w9exc:c#y"), 90000.00 USD) { origin case_input; }
        assert "f1": us.irc.deferred_compensation::max_permitted_acp(entity_ref("urn:test:w9exc:c#plan"), entity_ref("urn:test:w9exc:c#y"), 100000.00 USD) { origin case_input; }
