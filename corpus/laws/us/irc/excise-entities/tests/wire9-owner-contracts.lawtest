// Excise entities WIRE-9 owner-contract scenarios. NOT EXECUTED (implemented_unverified); no legal review.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "W9-EXC-01-EXCESS-AGGREGATE-CONTRIBUTIONS-FROM-THE-401M-COMPUTATION" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": us.irc.deferred_compensation::hce_matching_and_employee_contributions(entity_ref("urn:test:w9exc:a#plan"), entity_ref("urn:test:w9exc:a#y"), 150000.00 USD) { origin case_input; }
        assert "f1": us.irc.deferred_compensation::max_permitted_acp(entity_ref("urn:test:w9exc:a#plan"), entity_ref("urn:test:w9exc:a#y"), 100000.00 USD) { origin case_input; }
    }
    evaluate truth(excess_aggregate_contributions_for_plan_year(entity_ref("urn:test:w9exc:a#plan"), entity_ref("urn:test:w9exc:a#y"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
}

