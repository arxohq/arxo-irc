}

test "W9-EXC-04-SECTION-4979-TAX-READS-BOTH-DERIVED-EXCESS-AMOUNTS" {
    given {
        context {
            legal_time @2026-06-01;
            decision_time @2026-06-01T09:00:00-05:00;
            knowledge_time @2026-06-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": plan_kind_4979(entity_ref("urn:test:w9exc:d#plan"), Section401aTrustPlan4979) { origin case_input; }
        assert "f1": plan_sponsoring_employer_4979(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#emp")) { origin case_input; }
        assert "f2": us.irc.deferred_compensation::hce_contributions_paid_over(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), 300000.00 USD) { origin case_input; }
        assert "f3": us.irc.deferred_compensation::max_permitted_under_adp(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), 200000.00 USD) { origin case_input; }
        assert "f4": us.irc.deferred_compensation::hce_matching_and_employee_contributions(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), 150000.00 USD) { origin case_input; }
        assert "f5": us.irc.deferred_compensation::max_permitted_acp(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), 130000.00 USD) { origin case_input; }
        assert "f6": plan_year_end_4979(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), @2025-12-31) { origin case_input; }
        assert "f7": excess_distributed_on(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#y"), 60000.00 USD, @2026-03-10) { origin case_input; }
    }
    evaluate truth(excess_contributions_plan_tax(entity_ref("urn:test:w9exc:d#plan"), entity_ref("urn:test:w9exc:d#emp"), entity_ref("urn:test:w9exc:d#y"), 6000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

