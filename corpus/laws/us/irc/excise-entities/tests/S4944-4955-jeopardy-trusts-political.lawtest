// Section 4955(e): once tax is imposed under 4955 on the expenditure it is not a section 4945 taxable expenditure.
test "S4955-05-4945-TAXABLE-EXPENDITURE-DISPLACED-BY-4955" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4955:t5#b"), PoliticalExpenditure) { origin case_input; }
        assert "f1": political_expenditure_org(entity_ref("urn:test:s4955:t5#b"), entity_ref("urn:test:s4955:t5#o")) { origin case_input; }
        assert "f2": political_expenditure_year(entity_ref("urn:test:s4955:t5#b"), entity_ref("urn:test:s4955:t5#y")) { origin case_input; }
        assert "f3": section_501c3_organization_4955(entity_ref("urn:test:s4955:t5#o"), entity_ref("urn:test:s4955:t5#y")) { origin case_input; }
        assert "f4": participates_in_political_campaign(entity_ref("urn:test:s4955:t5#b")) { origin case_input; }
        assert "f5": political_expenditure_amount(entity_ref("urn:test:s4955:t5#b"), 40000.00 USD) { origin case_input; }
        assert "f6": same_expenditure_as(entity_ref("urn:test:s4955:t5#a"), entity_ref("urn:test:s4955:t5#b")) { origin case_input; }
        assert "f7": excise_act_kind(entity_ref("urn:test:s4955:t5#a"), TaxableExpenditure) { origin case_input; }
        assert "f8": taxable_expenditure_purpose(entity_ref("urn:test:s4955:t5#a"), ElectioneeringOrPoliticalCampaign) { origin case_input; }
        assert "f9": taxable_expenditure_foundation(entity_ref("urn:test:s4955:t5#a"), entity_ref("urn:test:s4955:t5#f")) { origin case_input; }
    }
    evaluate truth(taxable_expenditure(entity_ref("urn:test:s4955:t5#a")));
    expect truth_status == NEITHER;
}

