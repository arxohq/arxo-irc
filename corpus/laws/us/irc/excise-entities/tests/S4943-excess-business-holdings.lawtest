// Scenarios for 26 U.S.C. §4943 (excess business holdings), module
// 08-excess-business-holdings-4943.law. NOT executed this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4943-01-AT-20-PERCENT-NO-EXCESS-HOLDINGS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excess_business_holdings_disqualified_persons_voting_percentage(entity_ref("urn:test:s4943:t1#a"), 0.05) { origin case_input; }
        assert "f1": excess_business_holdings_foundation_voting_percentage(entity_ref("urn:test:s4943:t1#a"), 0.15) { origin case_input; }
    }
    // permitted = 20% - 5% = 15%; foundation holds exactly 15% -> not > permitted.
    evaluate truth(excess_business_holdings_exist(entity_ref("urn:test:s4943:t1#a")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4943-02-AT-20-POINT-1-PERCENT-EXCESS-HOLDINGS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excess_business_holdings_disqualified_persons_voting_percentage(entity_ref("urn:test:s4943:t2#a"), 0.05) { origin case_input; }
        assert "f1": excess_business_holdings_foundation_voting_percentage(entity_ref("urn:test:s4943:t2#a"), 0.151) { origin case_input; }
    }
    // permitted = 15%; foundation holds 15.1% -> exceeds by 0.1 point.
    evaluate truth(excess_business_holdings_exist(entity_ref("urn:test:s4943:t2#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4943-03-INITIAL-TAX-CORRECTED-WITHIN-TAXABLE-PERIOD-NO-ADDITIONAL-TAX" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excess_business_holdings_disqualified_persons_voting_percentage(entity_ref("urn:test:s4943:t3#a"), 0.05) { origin case_input; }
        assert "f1": excess_business_holdings_foundation_voting_percentage(entity_ref("urn:test:s4943:t3#a"), 0.25) { origin case_input; }
        assert "f2": excess_business_holdings_foundation(entity_ref("urn:test:s4943:t3#a"), entity_ref("urn:test:s4943:t3#f")) { origin case_input; }
        assert "f3": excess_business_holdings_value(entity_ref("urn:test:s4943:t3#a"), 500000.00 USD) { origin case_input; }
        assert "f4": excise_act_occurred_on(entity_ref("urn:test:s4943:t3#a"), @2026-01-10) { origin case_input; }
        assert "f5": act_corrected_on(entity_ref("urn:test:s4943:t3#a"), @2026-03-01) { origin case_input; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4943:t3#a"), entity_ref("urn:test:s4943:t3#f"), 50000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4943-04-C6-GRACE-PERIOD-END-DATE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": involuntary_change_in_holdings_on(entity_ref("urn:test:s4943:t4#a"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(c6_grace_period_ends(entity_ref("urn:test:s4943:t4#a"), @2031-03-15));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
