language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S5000D-SSA-01-TERM-APPLIES" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": ssa_1191_term_meaning_asserted_5000De3(MaximumFairPrice) { origin case_input; }
    }
    evaluate truth(ssa_1191_term_applies_5000De3(MaximumFairPrice));
    expect truth_status == TRUE_ONLY;
}

test "S5000D-SSA-02-WITHOUT-TERM-NEITHER" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
    }
    evaluate truth(ssa_1191_term_applies_5000De3(MaximumFairPrice));
    expect truth_status == NEITHER;
