test "S4941-07-UNKNOWN-CORRECTION-DATE-UNDETERMINED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t7#dp"), entity_ref("urn:test:s4941:t7#f")) { origin case_input; }
        assert "f9": excise_act_occurred_on(entity_ref("urn:test:s4941:t7#a"), @2026-01-10) { origin case_input; }
        // no `act_corrected_on`, `notice_for_act`, or `assessment_for_act`
        // asserted at all: whether the act was ever corrected is simply
        // unknown on these facts, so the taxable period's end is
        // unknown (§4941(e)(1) reads as an open-ended period rather
        // than a fact the case failed to prove) — modelled as absence, not
        // a negative assumption per AGENT-BRIEF's "unknown is not
        // negative".
    }
    evaluate truth(taxable_period_ends(entity_ref("urn:test:s4941:t7#a"), @2026-01-10));
    expect truth_status == NEITHER;
}
