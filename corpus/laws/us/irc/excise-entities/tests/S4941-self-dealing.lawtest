// Scenarios for 26 U.S.C. §4941 (self-dealing), modules
// 01-excise-act-and-taxable-period.law, 02-disqualified-persons-4946.law,
// 03-self-dealing-4941.law. Written from the text; NOT executed in this
// stage (owner's NO-HEAVY-CHECKS restriction) — `implemented_unverified`
// per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4941-01-INITIAL-TAX-ON-DISQUALIFIED-PERSON-CORRECTED-IN-TIME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t1#dp"), entity_ref("urn:test:s4941:t1#f")) { origin case_input; }
        assert "f1": us.irc.exempt_organizations::private_foundation(entity_ref("urn:test:s4941:t1#f"), entity_ref("urn:test:s4941:t1#y")) { origin case_input; }
        assert "f2": excise_act_kind(entity_ref("urn:test:s4941:t1#a"), SelfDealingAct) { origin case_input; }
        assert "f3": self_dealing_act_type(entity_ref("urn:test:s4941:t1#a"), SaleExchangeOrLease) { origin case_input; }
        assert "f4": self_dealing_disqualified_person(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#dp")) { origin case_input; }
        assert "f5": self_dealing_foundation(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#f")) { origin case_input; }
        assert "f6": self_dealing_taxable_year(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#y")) { origin case_input; }
        assert "f7": self_dealing_amount_involved(entity_ref("urn:test:s4941:t1#a"), 50000.00 USD) { origin case_input; }
        assert "f8": self_dealing_years_in_taxable_period(entity_ref("urn:test:s4941:t1#a"), 1) { origin case_input; }
        assert "f9": excise_act_occurred_on(entity_ref("urn:test:s4941:t1#a"), @2026-01-10) { origin case_input; }
        assert "f10": act_corrected_on(entity_ref("urn:test:s4941:t1#a"), @2026-02-15) { origin case_input; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#dp"), 5000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4941-02-NO-ADDITIONAL-TAX-WHEN-CORRECTED-WITHIN-TAXABLE-PERIOD" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t1#dp"), entity_ref("urn:test:s4941:t1#f")) { origin case_input; }
        assert "f4": self_dealing_disqualified_person(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#dp")) { origin case_input; }
        assert "f5": self_dealing_foundation(entity_ref("urn:test:s4941:t1#a"), entity_ref("urn:test:s4941:t1#f")) { origin case_input; }
        assert "f7": self_dealing_amount_involved(entity_ref("urn:test:s4941:t1#a"), 50000.00 USD) { origin case_input; }
        assert "f9": excise_act_occurred_on(entity_ref("urn:test:s4941:t1#a"), @2026-01-10) { origin case_input; }
        assert "f10": act_corrected_on(entity_ref("urn:test:s4941:t1#a"), @2026-02-15) { origin case_input; }
    }
    evaluate truth(corrected_within_taxable_period(entity_ref("urn:test:s4941:t1#a")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    // The (b)(1) additional tax rule is blocked by `unless
    // corrected_within_taxable_period(a)` — no fact of `additional_tax` for
    // this act is derivable, matching "the act is not corrected within the
    // taxable period" NOT being satisfied.
}

test "S4941-03-ADDITIONAL-TAX-WHEN-NOT-CORRECTED-WITHIN-TAXABLE-PERIOD" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t3#dp"), entity_ref("urn:test:s4941:t3#f")) { origin case_input; }
        assert "f1": us.irc.exempt_organizations::private_foundation(entity_ref("urn:test:s4941:t3#f"), entity_ref("urn:test:s4941:t3#y")) { origin case_input; }
        assert "f2": excise_act_kind(entity_ref("urn:test:s4941:t3#a"), SelfDealingAct) { origin case_input; }
        assert "f3": self_dealing_act_type(entity_ref("urn:test:s4941:t3#a"), LendingOrExtensionOfCredit) { origin case_input; }
        assert "f4": self_dealing_disqualified_person(entity_ref("urn:test:s4941:t3#a"), entity_ref("urn:test:s4941:t3#dp")) { origin case_input; }
        assert "f5": self_dealing_foundation(entity_ref("urn:test:s4941:t3#a"), entity_ref("urn:test:s4941:t3#f")) { origin case_input; }
        assert "f6": self_dealing_taxable_year(entity_ref("urn:test:s4941:t3#a"), entity_ref("urn:test:s4941:t3#y")) { origin case_input; }
        assert "f7": self_dealing_amount_involved(entity_ref("urn:test:s4941:t3#a"), 100000.00 USD) { origin case_input; }
        assert "f9": excise_act_occurred_on(entity_ref("urn:test:s4941:t3#a"), @2025-01-10) { origin case_input; }
        // no correction, no notice, no assessment asserted: the taxable
        // period never closes on the known facts, so "not corrected within
        // the taxable period" is established by the ABSENCE of a
        // corrected-in-time fact together with the act's own occurrence.
    }
    evaluate truth(additional_tax(entity_ref("urn:test:s4941:t3#a"), entity_ref("urn:test:s4941:t3#dp"), 200000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4941-04-MANAGER-TAX-CAPPED-AT-20000" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t4#dp"), entity_ref("urn:test:s4941:t4#f")) { origin case_input; }
        assert "f1": us.irc.exempt_organizations::private_foundation(entity_ref("urn:test:s4941:t4#f"), entity_ref("urn:test:s4941:t4#y")) { origin case_input; }
        assert "f2": excise_act_kind(entity_ref("urn:test:s4941:t4#a"), SelfDealingAct) { origin case_input; }
        assert "f3": self_dealing_act_type(entity_ref("urn:test:s4941:t4#a"), TransferOrUseOfIncomeOrAssets) { origin case_input; }
        assert "f4": self_dealing_disqualified_person(entity_ref("urn:test:s4941:t4#a"), entity_ref("urn:test:s4941:t4#dp")) { origin case_input; }
        assert "f5": self_dealing_foundation(entity_ref("urn:test:s4941:t4#a"), entity_ref("urn:test:s4941:t4#f")) { origin case_input; }
        assert "f6": self_dealing_taxable_year(entity_ref("urn:test:s4941:t4#a"), entity_ref("urn:test:s4941:t4#y")) { origin case_input; }
        assert "f7": self_dealing_amount_involved(entity_ref("urn:test:s4941:t4#a"), 10000000.00 USD) { origin case_input; }
        assert "f8": self_dealing_years_in_taxable_period(entity_ref("urn:test:s4941:t4#a"), 1) { origin case_input; }
        assert "f9": officer_director_or_trustee(entity_ref("urn:test:s4941:t4#mgr"), entity_ref("urn:test:s4941:t4#f")) { origin case_input; }
        assert "f10": manager_knew_act_was_self_dealing(entity_ref("urn:test:s4941:t4#a"), entity_ref("urn:test:s4941:t4#mgr")) { origin adjudicated; }
    }
    // raw 5% * $10,000,000 = $500,000, far above the $20,000 (c)(2) cap.
    evaluate truth(initial_tax(entity_ref("urn:test:s4941:t4#a"), entity_ref("urn:test:s4941:t4#mgr"), 20000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4941-05-MANAGER-NOT-WILLFUL-REASONABLE-CAUSE-NO-TAX" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t5#dp"), entity_ref("urn:test:s4941:t5#f")) { origin case_input; }
        assert "f1": us.irc.exempt_organizations::private_foundation(entity_ref("urn:test:s4941:t5#f"), entity_ref("urn:test:s4941:t5#y")) { origin case_input; }
        assert "f2": excise_act_kind(entity_ref("urn:test:s4941:t5#a"), SelfDealingAct) { origin case_input; }
        assert "f3": self_dealing_act_type(entity_ref("urn:test:s4941:t5#a"), FurnishingGoodsServicesOrFacilities) { origin case_input; }
        assert "f4": self_dealing_disqualified_person(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#dp")) { origin case_input; }
        assert "f5": self_dealing_foundation(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#f")) { origin case_input; }
        assert "f6": self_dealing_taxable_year(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#y")) { origin case_input; }
        assert "f7": self_dealing_amount_involved(entity_ref("urn:test:s4941:t5#a"), 30000.00 USD) { origin case_input; }
        assert "f9": officer_director_or_trustee(entity_ref("urn:test:s4941:t5#mgr"), entity_ref("urn:test:s4941:t5#f")) { origin case_input; }
        assert "f10": manager_knew_act_was_self_dealing(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#mgr")) { origin adjudicated; }
        assert "f11": manager_participation_not_willful_and_reasonable_cause(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#mgr")) { origin adjudicated; }
    }
    evaluate truth(initial_tax(entity_ref("urn:test:s4941:t5#a"), entity_ref("urn:test:s4941:t5#mgr"), 1500.00 USD));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4941-06-FAMILY-MEMBER-IS-DISQUALIFIED-PERSON" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": substantial_contributor(entity_ref("urn:test:s4941:t6#dp"), entity_ref("urn:test:s4941:t6#f")) { origin case_input; }
        assert "f1": family_spouse_of(entity_ref("urn:test:s4941:t6#spouse"), entity_ref("urn:test:s4941:t6#dp")) { origin case_input; }
    }
    evaluate truth(disqualified_person(entity_ref("urn:test:s4941:t6#spouse"), entity_ref("urn:test:s4941:t6#f")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
