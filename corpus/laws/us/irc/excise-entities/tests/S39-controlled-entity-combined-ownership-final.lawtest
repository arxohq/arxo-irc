// Final TECH_GAP pass (26.09.2026): section 4958(f)(3)(B) (G6891). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4958F3B-01-COMBINED-OWNERSHIP-DIRECT-AND-ONE-TIER" {
    // a1 (category A) 20 percent, b1 (sibling, category B) 10 percent, an unrelated person 40 percent (not counted), a1 through the intermediary m: 50 percent x 20 percent = 10 percent: 40 percent.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excess_benefit_organization(entity_ref("urn:test:s4958f3:1#act"), entity_ref("urn:test:s4958f3:1#org")) { origin case_input; }
        assert "f1": excess_benefit_transaction_date(entity_ref("urn:test:s4958f3:1#act"), @2024-06-01) { origin case_input; }
        assert "f2": position_of_substantial_influence_on(entity_ref("urn:test:s4958f3:1#a1"), entity_ref("urn:test:s4958f3:1#org"), @2023-01-01) { origin case_input; }
        assert "f3": sibling_or_sibling_spouse_of(entity_ref("urn:test:s4958f3:1#b1"), entity_ref("urn:test:s4958f3:1#a1")) { origin case_input; }
        assert "f4": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:1#a1"), entity_ref("urn:test:s4958f3:1#e"), 0.2) { origin case_input; }
        assert "f5": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:1#b1"), entity_ref("urn:test:s4958f3:1#e"), 0.1) { origin case_input; }
        assert "f6": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:1#c"), entity_ref("urn:test:s4958f3:1#e"), 0.4) { origin case_input; }
        assert "f7": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:1#a1"), entity_ref("urn:test:s4958f3:1#m"), 0.5) { origin case_input; }
        assert "f8": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:1#m"), entity_ref("urn:test:s4958f3:1#e"), 0.2) { origin case_input; }
    }
    evaluate truth(combined_ownership_computed_4958f3(entity_ref("urn:test:s4958f3:1#e"), entity_ref("urn:test:s4958f3:1#org"), entity_ref("urn:test:s4958f3:1#act"), 0.40));
    expect truth_status == TRUE_ONLY;
}

test "S4958F3B-02-ENTITY-OVER-35-PERCENT-IS-A-DISQUALIFIED-PERSON" {
    // the combined 40 percent exceeds 35 percent: the entity is a disqualified person (section 4958(f)(1)(C)).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excess_benefit_organization(entity_ref("urn:test:s4958f3:2#act"), entity_ref("urn:test:s4958f3:2#org")) { origin case_input; }
        assert "f1": excess_benefit_transaction_date(entity_ref("urn:test:s4958f3:2#act"), @2024-06-01) { origin case_input; }
        assert "f2": position_of_substantial_influence_on(entity_ref("urn:test:s4958f3:2#a1"), entity_ref("urn:test:s4958f3:2#org"), @2023-01-01) { origin case_input; }
        assert "f3": sibling_or_sibling_spouse_of(entity_ref("urn:test:s4958f3:2#b1"), entity_ref("urn:test:s4958f3:2#a1")) { origin case_input; }
        assert "f4": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:2#a1"), entity_ref("urn:test:s4958f3:2#e"), 0.2) { origin case_input; }
        assert "f5": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:2#b1"), entity_ref("urn:test:s4958f3:2#e"), 0.1) { origin case_input; }
        assert "f6": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:2#c"), entity_ref("urn:test:s4958f3:2#e"), 0.4) { origin case_input; }
        assert "f7": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:2#a1"), entity_ref("urn:test:s4958f3:2#m"), 0.5) { origin case_input; }
        assert "f8": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:2#m"), entity_ref("urn:test:s4958f3:2#e"), 0.2) { origin case_input; }
    }
    evaluate truth(disqualified_person_4958(entity_ref("urn:test:s4958f3:2#e"), entity_ref("urn:test:s4958f3:2#org"), entity_ref("urn:test:s4958f3:2#act")));
    expect truth_status == TRUE_ONLY;
}

test "S4958F3B-03-ENTITY-AT-30-PERCENT-IS-NOT-DISQUALIFIED" {
    // 20 + 10 = 30 percent, not more than 35 percent.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excess_benefit_organization(entity_ref("urn:test:s4958f3:3#act"), entity_ref("urn:test:s4958f3:3#org")) { origin case_input; }
        assert "f1": excess_benefit_transaction_date(entity_ref("urn:test:s4958f3:3#act"), @2024-06-01) { origin case_input; }
        assert "f2": position_of_substantial_influence_on(entity_ref("urn:test:s4958f3:3#a1"), entity_ref("urn:test:s4958f3:3#org"), @2023-01-01) { origin case_input; }
        assert "f3": sibling_or_sibling_spouse_of(entity_ref("urn:test:s4958f3:3#b1"), entity_ref("urn:test:s4958f3:3#a1")) { origin case_input; }
        assert "f4": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:3#a1"), entity_ref("urn:test:s4958f3:3#e"), 0.2) { origin case_input; }
        assert "f5": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:3#b1"), entity_ref("urn:test:s4958f3:3#e"), 0.1) { origin case_input; }
        assert "f6": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:3#c"), entity_ref("urn:test:s4958f3:3#e"), 0.4) { origin case_input; }
    }
    evaluate truth(disqualified_person_4958(entity_ref("urn:test:s4958f3:3#e"), entity_ref("urn:test:s4958f3:3#org"), entity_ref("urn:test:s4958f3:3#act")));
    expect truth_status == NEITHER;
}

test "S4958F3B-04-INTERMEDIARY-THAT-IS-A-CATEGORY-B-PERSON-NOT-DOUBLE-COUNTED" {
    // m is not a person of (A) or (B); a1 and b1 each hold 50 percent of m, m holds 50 percent of e, a1 holds 10 percent: 10 + 25 + 25 = 60 percent.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excess_benefit_organization(entity_ref("urn:test:s4958f3:4#act"), entity_ref("urn:test:s4958f3:4#org")) { origin case_input; }
        assert "f1": excess_benefit_transaction_date(entity_ref("urn:test:s4958f3:4#act"), @2024-06-01) { origin case_input; }
        assert "f2": position_of_substantial_influence_on(entity_ref("urn:test:s4958f3:4#a1"), entity_ref("urn:test:s4958f3:4#org"), @2023-01-01) { origin case_input; }
        assert "f3": sibling_or_sibling_spouse_of(entity_ref("urn:test:s4958f3:4#b1"), entity_ref("urn:test:s4958f3:4#a1")) { origin case_input; }
        assert "f4": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:4#a1"), entity_ref("urn:test:s4958f3:4#e"), 0.1) { origin case_input; }
        assert "f5": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:4#a1"), entity_ref("urn:test:s4958f3:4#m"), 0.5) { origin case_input; }
        assert "f6": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:4#m"), entity_ref("urn:test:s4958f3:4#e"), 0.5) { origin case_input; }
        assert "f7": direct_ownership_share_4958f3(entity_ref("urn:test:s4958f3:4#b1"), entity_ref("urn:test:s4958f3:4#m"), 0.5) { origin case_input; }
    }
    evaluate truth(combined_ownership_computed_4958f3(entity_ref("urn:test:s4958f3:4#e"), entity_ref("urn:test:s4958f3:4#org"), entity_ref("urn:test:s4958f3:4#act"), 0.60));
    expect truth_status == TRUE_ONLY;
}

test "S4958F3B-05-ASSERTED-COMBINED-OWNERSHIP-WHEN-NO-DIRECT-SHARE" {
    // no direct share: the asserted combined ownership (40 percent) is read.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": excess_benefit_organization(entity_ref("urn:test:s4958f3:5#act"), entity_ref("urn:test:s4958f3:5#org")) { origin case_input; }
        assert "f1": combined_ownership_by_a_or_b_persons(entity_ref("urn:test:s4958f3:5#e"), entity_ref("urn:test:s4958f3:5#org"), entity_ref("urn:test:s4958f3:5#act"), 0.40) { origin case_input; }
    }
    evaluate truth(combined_ownership_for_controlled_entity_4958(entity_ref("urn:test:s4958f3:5#e"), entity_ref("urn:test:s4958f3:5#org"), entity_ref("urn:test:s4958f3:5#act"), 0.40));
    expect truth_status == TRUE_ONLY;
}
