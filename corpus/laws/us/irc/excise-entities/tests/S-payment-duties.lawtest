// Module 23-payment-duties.law.
// Scenarios written from the pinned statutory text; NOT executed (owner restriction) — implemented_unverified.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "SPAY-01-INITIAL-TAX-PAYMENT-DUTY-ACTIVE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:pay:t1#a"), SelfDealingAct) { origin case_input; }
        assert "f1": initial_tax(entity_ref("urn:test:pay:t1#a"), entity_ref("urn:test:pay:t1#p"), 10000.00 USD) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:pay:t1#p"));
    expect position(S4941InitialTaxPayment, ACTIVE);
}

test "SPAY-02-INITIAL-TAX-PAYMENT-DUTY-SATISFIED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:pay:t2#a"), SelfDealingAct) { origin case_input; }
        assert "f1": initial_tax(entity_ref("urn:test:pay:t2#a"), entity_ref("urn:test:pay:t2#p"), 10000.00 USD) { origin case_input; }
        assert "f2": excise_initial_tax_paid(entity_ref("urn:test:pay:t2#a"), entity_ref("urn:test:pay:t2#p")) { origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:pay:t2#p"));
    expect position(S4941InitialTaxPayment, SATISFIED);
}

// Asserted negation of the payment goal (E-0179 / section 113: absence of a paid fact is not a violation).
test "SPAY-03-INITIAL-TAX-PAYMENT-DUTY-VIOLATED-WHEN-UNPAID-ASSERTED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:pay:t3#a"), SelfDealingAct) { origin case_input; }
        assert "f1": initial_tax(entity_ref("urn:test:pay:t3#a"), entity_ref("urn:test:pay:t3#p"), 10000.00 USD) { origin case_input; }
        assert not excise_initial_tax_paid(entity_ref("urn:test:pay:t3#a"), entity_ref("urn:test:pay:t3#p")) { id "f2"; origin case_input; }
    }
    evaluate positions(entity_ref("urn:test:pay:t3#p"));
    expect position(S4941InitialTaxPayment, VIOLATED);
}

