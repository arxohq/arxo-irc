// Scenarios for 26 U.S.C. §4942 (undistributed income), module
// 09-undistributed-income-4942.law. NOT executed this stage
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4942-01-MINIMUM-INVESTMENT-RETURN-INTERMEDIATE-VALUE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942:t1#a"), 10000000.00 USD) { origin case_input; }
        assert "f1": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942:t1#a"), 2000000.00 USD) { origin case_input; }
    }
    // 5% * (10,000,000 - 2,000,000) = 400,000
    evaluate truth(minimum_investment_return(entity_ref("urn:test:s4942:t1#a"), 400000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4942-02-DISTRIBUTABLE-AMOUNT-AND-UNDISTRIBUTED-INCOME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942:t2#a"), 10000000.00 USD) { origin case_input; }
        assert "f1": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942:t2#a"), 2000000.00 USD) { origin case_input; }
        assert "f2": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942:t2#a"), 20000.00 USD) { origin case_input; }
        assert "f3": qualifying_distributions_made(entity_ref("urn:test:s4942:t2#a"), 100000.00 USD) { origin case_input; }
    }
    // distributable = 400,000 - 20,000 = 380,000; undistributed = 380,000 - 100,000 = 280,000
    evaluate truth(undistributed_income(entity_ref("urn:test:s4942:t2#a"), 280000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4942-03-INITIAL-TAX-30-PERCENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4942:t3#a"), UndistributedIncomeYear) { origin case_input; }
        assert "f1": undistributed_income_foundation(entity_ref("urn:test:s4942:t3#a"), entity_ref("urn:test:s4942:t3#f")) { origin case_input; }
        assert "f2": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942:t3#a"), 10000000.00 USD) { origin case_input; }
        assert "f3": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942:t3#a"), 2000000.00 USD) { origin case_input; }
        assert "f4": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942:t3#a"), 20000.00 USD) { origin case_input; }
        assert "f5": qualifying_distributions_made(entity_ref("urn:test:s4942:t3#a"), 100000.00 USD) { origin case_input; }
    }
    // 30% * 280,000 = 84,000
    evaluate truth(initial_tax(entity_ref("urn:test:s4942:t3#a"), entity_ref("urn:test:s4942:t3#f"), 84000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4942-04-ADDITIONAL-TAX-100-PERCENT-NOT-CORRECTED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4942:t4#a"), UndistributedIncomeYear) { origin case_input; }
        assert "f1": undistributed_income_foundation(entity_ref("urn:test:s4942:t4#a"), entity_ref("urn:test:s4942:t4#f")) { origin case_input; }
        assert "f2": undistributed_income_non_exempt_use_asset_value(entity_ref("urn:test:s4942:t4#a"), 10000000.00 USD) { origin case_input; }
        assert "f3": undistributed_income_acquisition_indebtedness(entity_ref("urn:test:s4942:t4#a"), 2000000.00 USD) { origin case_input; }
        assert "f4": subtitle_a_and_4940_tax_for_year(entity_ref("urn:test:s4942:t4#a"), 20000.00 USD) { origin case_input; }
        assert "f5": qualifying_distributions_made(entity_ref("urn:test:s4942:t4#a"), 100000.00 USD) { origin case_input; }
        assert "f6": undistributed_income_remaining_at_close_of_taxable_period(entity_ref("urn:test:s4942:t4#a"), 280000.00 USD) { origin case_input; }
        assert "f7": excise_act_occurred_on(entity_ref("urn:test:s4942:t4#a"), @2025-01-10) { origin case_input; }
    }
    evaluate truth(additional_tax(entity_ref("urn:test:s4942:t4#a"), entity_ref("urn:test:s4942:t4#f"), 280000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
