// Scenarios for 26 U.S.C. §4940 (excise tax based on investment income),
// module 04-net-investment-income-4940.law. Written from the text; NOT
// executed in this stage (owner's NO-HEAVY-CHECKS restriction) —
// `implemented_unverified` per AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

test "S4940-01-FLAT-1-39-PERCENT-ON-NET-INVESTMENT-INCOME" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; }
        assert "f0": us.irc.exempt_organizations::exempt_organization(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y")) { origin case_input; }
        assert "f1": us.irc.exempt_organizations::private_foundation(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y")) { origin case_input; }
        assert "f2": section_4940_interest_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 200000.00 USD) { origin case_input; }
        assert "f3": section_4940_dividend_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 300000.00 USD) { origin case_input; }
        assert "f4": section_4940_rental_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 0.00 USD) { origin case_input; }
        assert "f5": section_4940_securities_loan_payments(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 0.00 USD) { origin case_input; }
        assert "f6": section_4940_royalty_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 0.00 USD) { origin case_input; }
        assert "f7": section_4940_similar_investment_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 0.00 USD) { origin case_input; }
        assert "f8": section_4940_capital_gain_net_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 100000.00 USD) { origin case_input; }
        assert "f9": section_4940_allowed_deductions(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 100000.00 USD) { origin case_input; }
    }
    // gross investment income 500,000 + capital gain 100,000 - deductions
    // 100,000 = net investment income 500,000; 1.39% * 500,000 = 6,950.00
    evaluate truth(foundation_net_investment_income(entity_ref("urn:test:s4940:t1#f"), entity_ref("urn:test:s4940:t1#y"), 500000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

