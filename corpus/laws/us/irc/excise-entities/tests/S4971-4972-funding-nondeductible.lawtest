        assert "f5": prior_nondeductible_returned_to_employer(entity_ref("urn:test:s4972:t1#e"), entity_ref("urn:test:s4972:t1#plan"), entity_ref("urn:test:s4972:t1#y"), 10000.00 USD) { origin case_input; }
        assert "f6": prior_nondeductible_deductible_this_year(entity_ref("urn:test:s4972:t1#e"), entity_ref("urn:test:s4972:t1#plan"), entity_ref("urn:test:s4972:t1#y"), 15000.00 USD) { origin case_input; }
        assert "f7": section_4972c3_returnable_contribution(entity_ref("urn:test:s4972:t1#e"), entity_ref("urn:test:s4972:t1#plan"), entity_ref("urn:test:s4972:t1#y"), 0.00 USD) { origin case_input; }
