        assert "f3": designated_roth_contributions_4960(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 0.00 USD) { origin case_input; }
        assert "f4": section_457f_inclusions_4960(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 0.00 USD) { origin case_input; }
        assert "f5": medical_services_portion_4960(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 0.00 USD) { origin case_input; }
        assert "f6": deduction_disallowed_under_162m(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 0.00 USD) { origin case_input; }
        assert "f7": section_11_rate(entity_ref("urn:test:s4960:t4#y"), 0.21) { origin case_input; }
        assert "f8": one_of_five_highest_compensated_employees(entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#y")) { origin case_input; }
        assert "f9": separation_contingent_payments_present_value(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 900000.00 USD) { origin case_input; }
        assert "f10": base_amount_4960(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 250000.00 USD) { origin case_input; }
        assert "f11": base_amount_allocated_to_parachute_payment(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 250000.00 USD) { origin case_input; }
    }
    evaluate truth(excess_remuneration_tax_4960(entity_ref("urn:test:s4960:t4#o"), entity_ref("urn:test:s4960:t4#e"), entity_ref("urn:test:s4960:t4#y"), 136500.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

