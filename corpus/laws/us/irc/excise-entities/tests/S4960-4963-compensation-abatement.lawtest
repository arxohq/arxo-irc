// Wages 1,500,000 less the 1,000,000 threshold = 500,000; 21% (section 11 rate) = 105,000; one employer, so the whole tax.
test "S4960-01-TAX-21-PERCENT-OF-REMUNERATION-OVER-1000000-2024-EDITION" {
    given {
        context { decision_time @2025-06-01T09:00:00-04:00; knowledge_time @2025-06-01T09:00:00-04:00; legal_time @2025-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": us.irc.exempt_organizations::exempt_organization(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#y")) { origin case_input; }
        assert "f1": us.irc.core::begins(entity_ref("urn:test:s4960:t1#y"), @2024-01-01) { origin case_input; }
        assert "f2": wages_3401a_paid(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 1500000.00 USD) { origin case_input; }
        assert "f3": designated_roth_contributions_4960(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 0.00 USD) { origin case_input; }
        assert "f4": section_457f_inclusions_4960(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 0.00 USD) { origin case_input; }
        assert "f5": medical_services_portion_4960(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 0.00 USD) { origin case_input; }
        assert "f6": deduction_disallowed_under_162m(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 0.00 USD) { origin case_input; }
        assert "f7": section_11_rate(entity_ref("urn:test:s4960:t1#y"), 0.21) { origin case_input; }
        assert "f8": one_of_five_highest_compensated_employees(entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#y")) { origin case_input; }
    }
    evaluate truth(liable_for_4960_tax(entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#o"), entity_ref("urn:test:s4960:t1#e"), entity_ref("urn:test:s4960:t1#y"), 105000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

