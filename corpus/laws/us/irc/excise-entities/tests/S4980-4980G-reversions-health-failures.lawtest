        assert "f7": multiemployer_plan_4980F(entity_ref("urn:test:s4980F:t4#plan")) { origin case_input; }
    }
    evaluate truth(benefit_accrual_notice_failure_tax(entity_ref("urn:test:s4980F:t4#a"), entity_ref("urn:test:s4980F:t4#plan"), 4100.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Notice on 2026-03-20, 15 days after knowledge: section 4980F(c)(2).
test "S4980F-05-NOTICE-WITHIN-30-DAYS-OF-KNOWLEDGE-EXCUSED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excise_act_kind(entity_ref("urn:test:s4980F:t5#a"), BenefitAccrualNoticeFailure) { origin case_input; }
        assert "f1": notice_failure_plan_4980F(entity_ref("urn:test:s4980F:t5#a"), entity_ref("urn:test:s4980F:t5#plan")) { origin case_input; }
        assert "f2": applicable_pension_plan_4980F(entity_ref("urn:test:s4980F:t5#plan")) { origin case_input; }
        assert "f3": failure_first_occurs_on(entity_ref("urn:test:s4980F:t5#a"), @2026-03-01) { origin case_input; }
        assert "f4": failure_notice_provided_on(entity_ref("urn:test:s4980F:t5#a"), @2026-03-20) { origin case_input; }
        assert "f5": failure_employer(entity_ref("urn:test:s4980F:t5#a"), entity_ref("urn:test:s4980F:t5#emp")) { origin case_input; }
        assert "f6": first_knew_or_would_have_known_on(entity_ref("urn:test:s4980F:t5#a"), @2026-03-05) { origin case_input; }
        assert "f7": failure_due_to_reasonable_cause(entity_ref("urn:test:s4980F:t5#a")) { origin adjudicated; }
    }
    evaluate truth(benefit_accrual_notice_failure_tax(entity_ref("urn:test:s4980F:t5#a"), entity_ref("urn:test:s4980F:t5#emp"), 2000.00 USD));
    expect truth_status == NEITHER;
}

