// 2,000 of 3,000 (66.7%) versus 1,500 of 3,000 (50%): neither the same amount nor the same percentage. 35% of 3,500 = 1,225.
test "S4980E-01-NOT-COMPARABLE-35-PERCENT-OF-AGGREGATE-CONTRIBUTIONS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": employer_contributes_to_archer_msa(entity_ref("urn:test:s4980E:t1#emp"), 2026) { origin case_input; }
        assert "f1": msa_participant(entity_ref("urn:test:s4980E:t1#emp"), 2026, entity_ref("urn:test:s4980E:t1#e1"), SelfOnly, false, false) { origin case_input; }
        assert "f2": msa_participant(entity_ref("urn:test:s4980E:t1#emp"), 2026, entity_ref("urn:test:s4980E:t1#e2"), SelfOnly, false, false) { origin case_input; }
        assert "f3": msa_contribution(entity_ref("urn:test:s4980E:t1#emp"), 2026, entity_ref("urn:test:s4980E:t1#e1"), 2000.00 USD, 3000.00 USD) { origin case_input; }
        assert "f4": msa_contribution(entity_ref("urn:test:s4980E:t1#emp"), 2026, entity_ref("urn:test:s4980E:t1#e2"), 1500.00 USD, 3000.00 USD) { origin case_input; }
        assert "f5": aggregate_archer_msa_contributions(entity_ref("urn:test:s4980E:t1#emp"), 2026, 3500.00 USD) { origin case_input; }
    }
    evaluate truth(archer_msa_comparability_tax(entity_ref("urn:test:s4980E:t1#emp"), 2026, 1225.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

