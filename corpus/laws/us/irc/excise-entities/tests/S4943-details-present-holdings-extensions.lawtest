test "S4943A2-01-GREATEST-VALUE-DAY-IS-USED" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert "f0": excess_holdings_daily_value(entity_ref("urn:test:s4943x:t1#a"), @2026-03-01, 500000.00 USD) { origin case_input; }
        assert "f1": excess_holdings_daily_value(entity_ref("urn:test:s4943x:t1#a"), @2026-07-01, 700000.00 USD) { origin case_input; }
        assert "f2": excess_holdings_daily_value(entity_ref("urn:test:s4943x:t1#a"), @2026-12-31, 600000.00 USD) { origin case_input; }
    }
    // Section 4943(a)(2)(B): the value on the greatest day (700,000), not the first or last day.
    evaluate truth(excess_holdings_greatest_value(entity_ref("urn:test:s4943x:t1#a"), 700000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

