// Stage 3 (26.09.2026). Section 4911(e)(2)-(4) (legislation, action, capital
// items and depreciation), (f)(1) (affiliated group treated as one organization,
// proportionate share of the excess, loss of section 501(c)(3) status), (f)(3)
// (different taxable years) and (f)(4) (limited control).
//
// DESIGN. The affiliated group is a `Person` (the group) whose aggregated
// amounts are asserted with the ordinary relations of module 11, so the
// existing rules compute the group's excess "as though such affiliated group is
// one organization" ((f)(1)(A)). `section_4911_applies` is concluded for the
// group when at least two section 501(c)(3) members are affiliated and one
// section 501(h) election is effective. `not_501c3_by_reason_of_lobbying` is now
// institutional (still assertable) to carry (f)(1)(C).
//
// JUDGMENT CALLS. The "proportionate share" of (f)(1)(B) is not defined by the
// statute; it is read here as the member's share of the group's lobbying
// expenditures, cents HALF_UP. The (f)(4) amounts are derived in separate relations
// and are not wired into the excess computation of module 11. Status:
// implemented_unverified; scenarios not executed; no legal review.

// --- (e)(2)-(3): legislation and action ---

use self::{
    LobbyingCommunication,
    Person,
    TaxableYear,
    excess_lobbying_expenditures,
    lobbying_expenditures_4911,
    not_501c3_by_reason_of_lobbying,
    section_4911_applies,
};

enum LegislativeBodyKind4911 {
    Congress;
    StateLegislature;
    LocalCouncilOrSimilar;
    PublicReferendumOrInitiative;
    OtherBody;
}
enum LegislativeActionKind4911 {
    Introduction;
    Amendment;
    Enactment;
    Defeat;
    Repeal;
    OtherAction;
}
pub relation communication_concerns_body(c: LobbyingCommunication, b: LegislativeBodyKind4911) kind empirical {
    label en unofficial "section 4911(e)(2): the communication concerns action by this body";
}
pub relation communication_concerns_action(c: LobbyingCommunication, k: LegislativeActionKind4911) kind empirical {
    label en unofficial "section 4911(e)(3): the kind of action the communication concerns";
}
pub relation communication_concerns_act_bill_or_similar_item(c: LobbyingCommunication) kind empirical {
    label en unofficial "section 4911(e)(2): the item is an Act, bill, resolution or similar item";
}
pub relation legislative_body_4911e2(c: LobbyingCommunication) kind institutional {
    label en official "section 4911(e)(2): the body is the Congress, a State legislature, a local council or similar governing body, or the public in a referendum, initiative, constitutional amendment or similar procedure";
}
rule LegislativeBodyCongress(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(2)"; when communication_concerns_body(c, Congress); then legislative_body_4911e2(c); }
rule LegislativeBodyState(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(2)"; when communication_concerns_body(c, StateLegislature); then legislative_body_4911e2(c); }
rule LegislativeBodyLocal(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(2)"; when communication_concerns_body(c, LocalCouncilOrSimilar); then legislative_body_4911e2(c); }
rule LegislativeBodyPublic(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(2)"; when communication_concerns_body(c, PublicReferendumOrInitiative); then legislative_body_4911e2(c); }
pub relation legislative_action_4911e3(c: LobbyingCommunication) kind institutional {
    label en official "section 4911(e)(3): 'action' is limited to the introduction, amendment, enactment, defeat or repeal of Acts, bills, resolutions or similar items";
}
rule LegislativeActionIntroduction(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(3)"; when communication_concerns_action(c, Introduction); then legislative_action_4911e3(c); }
rule LegislativeActionAmendment(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(3)"; when communication_concerns_action(c, Amendment); then legislative_action_4911e3(c); }
rule LegislativeActionEnactment(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(3)"; when communication_concerns_action(c, Enactment); then legislative_action_4911e3(c); }
rule LegislativeActionDefeat(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(3)"; when communication_concerns_action(c, Defeat); then legislative_action_4911e3(c); }
rule LegislativeActionRepeal(c: LobbyingCommunication) defeasible { label en official "section 4911(e)(3)"; when communication_concerns_action(c, Repeal); then legislative_action_4911e3(c); }
pub relation communication_concerns_legislation_4911e(c: LobbyingCommunication) kind institutional {
    label en official "section 4911(e)(2)-(3): the communication concerns 'legislation': action, as limited by (e)(3), on an Act, bill, resolution or similar item before a body of (e)(2) (a classification not wired into influencing_legislation of module 11, which reads the (d) flags)";
}
rule CommunicationConcernsLegislation(c: LobbyingCommunication) defeasible {
    label en official "section 4911(e)(2)-(3)";
    when legislative_body_4911e2(c);
    when legislative_action_4911e3(c);
    when communication_concerns_act_bill_or_similar_item(c);
    then communication_concerns_legislation_4911e(c);
}

// --- (e)(4): capital items and depreciation ---

entity ExpenditureItem4911 { label en unofficial "an amount paid or incurred that is tested as a lobbying or exempt purpose expenditure (section 4911(e)(4))"; }
pub relation item_amount_4911(item: ExpenditureItem4911, amount: Money) kind empirical {
    label en unofficial "the amount paid or incurred";
}
pub relation item_properly_chargeable_to_capital_account(item: ExpenditureItem4911) kind empirical {
    label en unofficial "section 4911(e)(4): the amount is properly chargeable to capital account, on the principles of subtitle A for a trade or business";
}
pub relation item_straight_line_allowance(item: ExpenditureItem4911, amount: Money) kind empirical {
    label en unofficial "section 4911(e)(4): the reasonable allowance for exhaustion, wear and tear, obsolescence or amortization, computed only on the straight-line method";
}
pub relation counted_expenditure_4911e4(item: ExpenditureItem4911, amount: Money) kind institutional {
    label en official "section 4911(e)(4): the amount taken into account: the full amount, or for a capital item only the straight-line allowance";
}
rule CountedExpenditureNotCapital(item: ExpenditureItem4911, amt: Money) defeasible {
    label en official "section 4911(e)(4): an amount not chargeable to capital account is taken into account in full";
    when item_amount_4911(item, amt);
    unless item_properly_chargeable_to_capital_account(item) and item_amount_4911(item, amt);
    then counted_expenditure_4911e4(item, amt);
}
rule CountedExpenditureCapitalAllowance(item: ExpenditureItem4911, amt: Money, allowance: Money) defeasible {
    label en official "section 4911(e)(4): a capital item counts only through the straight-line allowance";
    when item_amount_4911(item, amt);
    when item_properly_chargeable_to_capital_account(item);
    when item_straight_line_allowance(item, allowance);
    then counted_expenditure_4911e4(item, allowance);
}

// --- (f)(1): affiliated group treated as one organization ---

pub relation group_member_501c3(m: Person, g: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f)(1): m is an organization described in section 501(c)(3) and a member of the affiliated group g for the taxable year";
}
pub relation group_members_affiliated_4911f2(g: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f)(2): the members are members of an affiliated group of organizations as defined in paragraph (2) (see affiliated_for_4911f)";
}
pub relation group_has_two_or_more_members(g: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f)(1): two or more organizations described in section 501(c)(3) are members of the group";
}
pub relation group_limited_control_4911f4(g: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f)(4): the limited control conditions hold, so paragraph (1) does not govern (except as provided in paragraph (4))";
}
pub relation group_treated_as_one_organization_4911f1(g: Person, y: TaxableYear) kind institutional {
    label en official "section 4911(f)(1): two or more 501(c)(3) organizations are members of an affiliated group and an election under section 501(h) is effective for at least one member";
}
rule GroupTreatedAsOneOrganization(g: Person, y: TaxableYear, m: Person) defeasible {
    label en official "section 4911(f)(1)";
    when group_has_two_or_more_members(g, y);
    when group_members_affiliated_4911f2(g, y);
    when group_member_501c3(m, g, y);
    when us.irc.exempt_organizations::section_501h_election_in_effect(m, y);
    unless group_limited_control_4911f4(g, y) and group_has_two_or_more_members(g, y) and group_members_affiliated_4911f2(g, y);
    then group_treated_as_one_organization_4911f1(g, y);
}
rule GroupIsAnOrganizationToWhichSection4911Applies(g: Person, y: TaxableYear) defeasible {
    label en official "section 4911(f)(1)(A): the determinations of excess lobbying expenditures and of the section 501(h)(1) limits are made as though the group is one organization";
    when group_treated_as_one_organization_4911f1(g, y);
    then section_4911_applies(g, y);
}
pub relation member_lobbying_expenditures_4911(m: Person, g: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4911(f)(1)(B): the member's lobbying expenditures for the year";
}
pub relation member_proportionate_share_of_group_excess(m: Person, g: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(f)(1)(B): each member with an effective election is treated as having excess lobbying expenditures equal to its proportionate share of the group's excess (read as its share of the group's lobbying expenditures, cents HALF_UP)";
}
rule MemberProportionateShare(m: Person, g: Person, y: TaxableYear, excess: Money, mine: Money, total: Money) defeasible {
    label en official "section 4911(f)(1)(B)";
    when group_treated_as_one_organization_4911f1(g, y);
    when group_member_501c3(m, g, y);
    when us.irc.exempt_organizations::section_501h_election_in_effect(m, y);
    when excess_lobbying_expenditures(g, y, excess);
    when member_lobbying_expenditures_4911(m, g, y, mine);
    when lobbying_expenditures_4911(g, y, total);
    when total > 0.00 USD;
    then member_proportionate_share_of_group_excess(m, g, y, div_round(excess * (mine / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation group_exceeds_501h1_limits(g: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4911(f)(1)(C): the expenditure limits of section 501(h)(1) are exceeded, determined for the group as one organization";
}
rule MemberNotDescribedBecauseOfGroupLimits(m: Person, g: Person, y: TaxableYear) defeasible {
    label en official "section 4911(f)(1)(C): each member with an effective election is treated as not described in section 501(c)(3) by reason of section 501(h)";
    when group_treated_as_one_organization_4911f1(g, y);
    when group_exceeds_501h1_limits(g, y);
    when group_member_501c3(m, g, y);
    when us.irc.exempt_organizations::section_501h_election_in_effect(m, y);
    then not_501c3_by_reason_of_lobbying(m, y);
}
pub relation group_treated_as_one_for_d2_d3_e1C(g: Person, y: TaxableYear) kind institutional {
    label en official "section 4911(f)(1)(D): subparagraphs (C) and (D) of subsection (d)(2), paragraph (3) of subsection (d), and clause (i) of subsection (e)(1)(C) are applied as if the group were one organization";
}
rule GroupTreatedAsOneForRelatedRules(g: Person, y: TaxableYear) defeasible {
    label en official "section 4911(f)(1)(D)";
    when group_treated_as_one_organization_4911f1(g, y);
    then group_treated_as_one_for_d2_d3_e1C(g, y);
}

// --- (f)(3): different taxable years ---

pub relation group_members_have_different_taxable_years(g: Person) kind empirical {
    label en unofficial "section 4911(f)(3): members of the affiliated group have different taxable years";
}
pub relation expenditure_computation_rule_prescribed_by_regulation(g: Person) kind empirical {
    label en unofficial "section 4911(f)(3): the manner of computing expenditures is prescribed by regulations promulgated by the Secretary (not pinned)";
}

// --- (f)(4): limited control ---

pub relation org_binds_members_on_legislative_issues(o: Person, g: Person) kind empirical {
    label en unofficial "section 4911(f)(4)(A): the decisions of the organization bind one or more members of the group, directly or indirectly";
}
pub relation congress_lobbying_expenditures_of_member(m: Person, g: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4911(f)(4)(A): amounts the member paid or incurred to influence legislation with respect to Acts, bills, resolutions or similar items by the Congress";
}
pub relation group_member_of_limited_control_group(m: Person, g: Person) kind empirical {
    label en unofficial "section 4911(f)(4): m is a member of the limited-control group g";
}
pub relation own_lobbying_expenditures_4911(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the organization's own lobbying expenditures for the year";
}
pub relation lobbying_for_determination_under_f4(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(f)(4)(A)-(B): for an organization whose decisions bind members, its own amounts plus the members' amounts to influence Congress legislation; for a non-binding member, only its own amounts (not wired into module 11)";
}
rule LobbyingForDeterminationBinding(o: Person, g: Person, y: TaxableYear, own: Money) defeasible {
    label en official "section 4911(f)(4)(A)";
    when group_limited_control_4911f4(g, y);
    when org_binds_members_on_legislative_issues(o, g);
    when own_lobbying_expenditures_4911(o, y, own);
    then lobbying_for_determination_under_f4(o, y, own + sum(collect all v: Money, m: Person where group_member_of_limited_control_group(m, g) and congress_lobbying_expenditures_of_member(m, g, y, v), empty: 0.00 USD));
}
rule LobbyingForDeterminationNonBinding(o: Person, g: Person, y: TaxableYear, own: Money) defeasible {
    label en official "section 4911(f)(4)(B)";
    when group_limited_control_4911f4(g, y);
    when group_member_of_limited_control_group(o, g);
    when own_lobbying_expenditures_4911(o, y, own);
    unless org_binds_members_on_legislative_issues(o, g) and group_limited_control_4911f4(g, y) and group_member_of_limited_control_group(o, g) and own_lobbying_expenditures_4911(o, y, own);
    then lobbying_for_determination_under_f4(o, y, own);
}
