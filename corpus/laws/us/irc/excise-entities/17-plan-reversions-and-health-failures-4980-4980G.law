// Sections 4980 (employer reversions from qualified plans), 4980C (long-term care
// insurance requirements), 4980D (group health plan failures, including the
// pharmacy benefit management provisions of Pub. L. 119-75 section 6701 that add
// section 9826 to chapter 100), 4980E (Archer MSA comparability), 4980F (notice of
// significant benefit accrual reductions) and 4980G (HSA comparability); 4980A and
// 4980I are repealed (notes only). Stage 2 (DECISION-0379). Section 4980B (COBRA) is
// in 18-continuation-coverage-4980B.law and section 4980H in 19-employer-shared-
// responsibility-4980H.law.
//
// SHARED PER-DAY FAILURE MACHINERY (4980B, 4980C, 4980D, 4980F): one ExciseAct is one
// failure with respect to one individual (the unit the $100-a-day tax attaches to).
// The noncompliance period runs from the date the failure first occurs to the
// EARLIEST candidate end (correction, the notice date for 4980F, the COBRA outer
// limit for 4980B) — the pairwise earliest pattern of TECH-GAPS G136. Both end days
// are counted (JUDGMENT CALL: "for each day in the noncompliance period" is read as
// an inclusive count `days_between(start, end) + 1`). An ongoing, uncorrected failure
// has no end candidate: its tax is unknown, not zero (G2513).
//
// SECTION 9826 (PL 119-75 section 6701) has no owner package (DECISIONS.md D-09); the
// requirement is modelled here under 4980D because a failure of chapter 100 is a
// failure under 4980D(a): a prohibition on the group health plan or PBM entering a
// contract without the required agreements, and the PBM's duty to report. The
// effective date is 30 months after enactment; the enactment date is the pinned
// parameter `PbmEnactmentDate9826` (SOURCE_GAP recorded in the coverage rows).

// ============================================================================
// Shared per-day noncompliance machinery
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4980C_B,
    IRC_S4980C_C,
    IRC_S4980C_D,
    IRC_S4980D_A,
    IRC_S4980D_B,
    IRC_S4980D_C,
    IRC_S4980E_B,
    IRC_S4980E_C,
    IRC_S4980E_D,
    IRC_S4980F_B,
    IRC_S4980F_E,
    IRC_S4980G_A,
    IRC_S4980_A,
    IRC_S4980_B,
    IRC_S4980_C,
    Person,
    TaxableYear,
    act_corrected_on,
    excise_act_kind,
    notice_requirement_relaxed_4980F_e2,
    reversion_normal_rate_applies_4980d1,
};

pub relation failure_first_occurs_on(a: ExciseAct, on: Date) kind empirical {
    label en official "sections 4980B(b)(2)(A), 4980D(b)(2)(A), 4980F(b)(2): the date the failure first occurs";
}
pub relation failure_notice_provided_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4980F(b)(2): the date the notice to which the failure relates is provided";
}
pub relation failure_affected_individual(a: ExciseAct, i: Person) kind empirical {
    label en unofficial "the individual (qualified beneficiary, insured, applicable individual, or individual to whom a group health plan failure relates) with respect to whom the failure exists";
}
pub relation failure_taxable_year_of_employer(a: ExciseAct, y: TaxableYear) kind empirical {
    label en unofficial "the employer's taxable year during which the failure occurs (annual limitations)";
}
pub relation failure_employer(a: ExciseAct, emp: Person) kind empirical {
    label en unofficial "the employer (or sponsor) responsible for the plan";
}
relation noncompliance_end_candidate(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a candidate end of the noncompliance period";
}
rule NoncomplianceEndFromCorrection(a: ExciseAct, on: Date) defeasible {
    label en official "sections 4980B(b)(2)(B)(i), 4980D(b)(2)(B), 4980F(b)(2): the date the failure is corrected";
    when act_corrected_on(a, on);
    then noncompliance_end_candidate(a, on);
}
rule NoncomplianceEndFromNotice(a: ExciseAct, on: Date) defeasible {
    label en official "section 4980F(b)(2): the date the notice to which the failure relates is provided";
    when failure_notice_provided_on(a, on);
    then noncompliance_end_candidate(a, on);
}
relation earlier_noncompliance_end_candidate_exists(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a strictly earlier candidate exists";
}
rule EarlierNoncomplianceEndCandidateExists(a: ExciseAct, on: Date, on2: Date) defeasible {
    label en unofficial "a strictly earlier candidate disqualifies this one";
    when noncompliance_end_candidate(a, on);
    when noncompliance_end_candidate(a, on2);
    when on2 < on;
    then earlier_noncompliance_end_candidate_exists(a, on);
}
pub relation noncompliance_period_end(a: ExciseAct, on: Date) kind institutional {
    label en official "the end of the noncompliance period: the earliest candidate";
}
rule NoncompliancePeriodEnd(a: ExciseAct, on: Date) defeasible {
    label en official "the earliest of the candidate ends";
    when noncompliance_end_candidate(a, on);
    unless earlier_noncompliance_end_candidate_exists(a, on);
    then noncompliance_period_end(a, on);
}
pub relation noncompliance_days(a: ExciseAct, n: Integer) kind institutional {
    label en official "the number of days in the noncompliance period, both end days counted";
}
rule NoncomplianceDays(a: ExciseAct, s: Date, e: Date) defeasible {
    label en official "days from the date the failure first occurs to the end of the noncompliance period, inclusive";
    when failure_first_occurs_on(a, s);
    when noncompliance_period_end(a, e);
    when e >= s;
    then noncompliance_days(a, days_between(s, e) + 1);
}
external judgment relation failure_due_to_reasonable_cause(a: ExciseAct) {
    authority Secretary;
    label en official "sections 4980B(c)(2)(A), 4980C(b)(2), 4980D(c)(2)(A), 4980F: the failure was due to reasonable cause and not to willful neglect (established to the satisfaction of the Secretary)";
}
external judgment relation failure_not_discoverable_with_diligence(a: ExciseAct) {
    authority Secretary;
    label en official "sections 4980B(c)(1), 4980D(c)(1), 4980F(c)(1): it is established to the satisfaction of the Secretary that no liable person knew, and exercising reasonable diligence would not have known, that the failure existed";
}
pub relation first_knew_or_would_have_known_on(a: ExciseAct, on: Date) kind empirical {
    label en official "sections 4980B(c)(2)(B), 4980D(c)(2)(B), 4980F(c)(2): the first date a liable person knew, or exercising reasonable diligence would have known, that the failure existed";
}
pub relation failure_corrected_within_30_days_of_knowledge(a: ExciseAct) kind institutional {
    label en official "sections 4980B(c)(2)(B), 4980D(c)(2)(B)(i), 4980F(c)(2)(B): the failure is corrected (the notice provided) during the 30-day period beginning on the first date of knowledge";
}
rule FailureCorrectedWithin30Days(a: ExciseAct, k: Date, c: Date) defeasible {
    label en official "correction on or after the knowledge date and on or before 30 days later (the 30-day period begins on that date, so its last day is the 29th day after it)";
    when first_knew_or_would_have_known_on(a, k);
    when noncompliance_period_end(a, c);
    when c >= k;
    when c <= add_calendar_period(k, 29 calendar_day);
    then failure_corrected_within_30_days_of_knowledge(a);
}
pub relation failure_prompt_correction_excuse(a: ExciseAct) kind institutional {
    label en official "sections 4980B(c)(2), 4980D(c)(2), 4980F(c)(2): reasonable cause and prompt (30-day) correction excuse the failure";
}
rule FailurePromptCorrectionExcuse(a: ExciseAct) defeasible {
    label en official "reasonable cause and not willful neglect plus correction within 30 days of knowledge";
    when failure_due_to_reasonable_cause(a);
    when failure_corrected_within_30_days_of_knowledge(a);
    then failure_prompt_correction_excuse(a);
}
pub relation failure_excused_by_limitations(a: ExciseAct) kind institutional {
    label en official "section (c)(1) or (c)(2) of 4980B, 4980D, 4980F: no tax is imposed on the failure";
}
rule FailureExcusedNotDiscoverable(a: ExciseAct) defeasible { label en official "(c)(1): not discoverable with reasonable diligence"; when failure_not_discoverable_with_diligence(a); then failure_excused_by_limitations(a); }
rule FailureExcusedPromptCorrection(a: ExciseAct) defeasible { label en official "(c)(2): reasonable cause and prompt correction"; when failure_prompt_correction_excuse(a); then failure_excused_by_limitations(a); }
pub relation uncorrected_at_notice_of_examination(a: ExciseAct) kind empirical {
    label en official "sections 4980B(b)(3)(A), 4980D(b)(3)(A): the failure was not corrected before the date a notice of examination of income tax liability was sent to the employer and occurred or continued during the period under examination";
}
pub relation violations_more_than_de_minimis(emp: Person, y: TaxableYear) kind empirical {
    label en official "sections 4980B(b)(3)(B), 4980D(b)(3)(B): the employer's (or plan's) violations for the year are more than de minimis";
}
pub relation church_plan_414e(plan: Person) kind empirical {
    label en official "sections 4980B(d)(3), 4980D(b)(3)(C), (c)(2)(B)(ii): the plan is a church plan (section 414(e))";
}

// ============================================================================
// Section 4980 — employer reversion from a qualified plan
// ============================================================================

entity PlanReversion { label en unofficial "an employer reversion from a qualified plan (section 4980)"; }
pub relation reversion_employer(r: PlanReversion, emp: Person) kind empirical {
    label en official "section 4980(b): the employer maintaining the plan";
}
pub relation reversion_amount_received(r: PlanReversion, amount: Money) kind empirical {
    label en official "section 4980(c)(2)(A): the cash and fair market value of other property received (directly or indirectly) by the employer from the qualified plan";
}
pub relation reversion_occurs_on(r: PlanReversion, on: Date) kind empirical {
    label en official "section 4980(c)(4): the date the employer reversion occurs";
}
pub relation reversion_plan_meets_401a_or_403a(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(1): the plan meets the requirements of 401(a) or 403(a), or has at any time been determined by the Secretary to be such a plan";
}
pub relation employer_always_exempt_from_subtitle_a(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(1)(A): the plan is maintained by an employer that has at all times been exempt from tax under subtitle A";
}
pub relation reversion_plan_governmental(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(1)(B): a governmental plan (section 414(d))";
}
@source(IRC_S4980_C, coverage = exact, quote = "The term \"qualified plan\" means any plan meeting the requirements of section 401(a) or 403(a), other than—")
pub relation qualified_plan_4980(r: PlanReversion) kind institutional {
    label en official "section 4980(c)(1): a plan meeting 401(a) or 403(a) other than one maintained by an always-exempt employer or a governmental plan";
}
rule QualifiedPlan4980(r: PlanReversion) defeasible {
    label en official "section 4980(c)(1)";
    when reversion_plan_meets_401a_or_403a(r);
    unless employer_always_exempt_from_subtitle_a(r) and reversion_plan_meets_401a_or_403a(r);
    unless reversion_plan_governmental(r) and reversion_plan_meets_401a_or_403a(r);
    then qualified_plan_4980(r);
}
pub relation reversion_exception_4980c2B(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(2)(B): the amount is (i) a distribution to employees that could have been made before termination, (ii) a 401(a)(2) distribution by mistake of law or fact / failure to qualify / failure of deductibility, or (iii) a transfer described in 420(f)(2)(B)(ii)(II)";
}
pub relation reversion_esop_transfer_requirements_met(r: PlanReversion) kind institutional {
    label en official "section 4980(c)(3): an applicable amount transferred to an ESOP with the investment (B), allocation (C), participant (D) requirements met is not an employer reversion";
}
pub relation esop_transfer_amount_is_applicable_amount(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(3)(E): transferred after March 31, 1985 and before January 1, 1989, or after 1988 pursuant to a termination after March 31, 1985 and before January 1, 1989";
}
pub relation esop_transfer_invested_within_90_days(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(3)(B): within 90 days (or a longer period the Secretary prescribes) the amount was invested in employer securities or used to repay loans used to buy them";
}
pub relation esop_transfer_suspense_allocation_met(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(3)(C): the unallocated portion is credited to a suspense account and allocated at least ratably over at most 7 years, with the section 415(c) treatment and minimum first-year allocation (the lesser of the 415 maximum or 1/8), and dividends on suspense shares applied as stated";
}
pub relation esop_transfer_half_of_participants_met(r: PlanReversion) kind empirical {
    label en official "section 4980(c)(3)(D): at least half of the participants in the qualified plan are participants in the ESOP as of the close of the first plan year for which an allocation is required";
}
rule EsopTransferRequirementsMet(r: PlanReversion) defeasible {
    label en official "section 4980(c)(3)(A)-(E)";
    when esop_transfer_amount_is_applicable_amount(r);
    when esop_transfer_invested_within_90_days(r);
    when esop_transfer_suspense_allocation_met(r);
    when esop_transfer_half_of_participants_met(r);
    then reversion_esop_transfer_requirements_met(r);
}
@source(IRC_S4980_C, coverage = exact, quote = "The term \"employer reversion\" means the amount of cash and the fair market value of other property received (directly or indirectly) by an employer from the qualified plan.")
pub relation employer_reversion(r: PlanReversion, amount: Money) kind institutional {
    label en official "section 4980(c)(2): the amount received by the employer from the qualified plan, other than the (B) exceptions and an ESOP transfer meeting (c)(3)";
}
rule EmployerReversion(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(c)(2)(A), (B), (3)";
    when qualified_plan_4980(r);
    when reversion_amount_received(r, amt);
    unless reversion_exception_4980c2B(r) and qualified_plan_4980(r) and reversion_amount_received(r, amt);
    unless reversion_esop_transfer_requirements_met(r) and qualified_plan_4980(r) and reversion_amount_received(r, amt);
    then employer_reversion(r, amt);
}
pub relation replacement_plan_established_or_maintained(r: PlanReversion) kind empirical {
    label en official "section 4980(d)(1)(A), (2): the employer establishes or maintains a qualified replacement plan meeting the participation (95 percent), asset transfer (25 percent cushion) and allocation requirements";
}
pub relation pro_rata_benefit_increases_provided(r: PlanReversion) kind empirical {
    label en official "section 4980(d)(1)(B), (3): the terminated plan provides pro rata increases in accrued benefits of qualified participants with aggregate present value at least 20 percent of the maximum reversion, effective on the termination date";
}
pub relation employer_in_chapter_7_liquidation_at_termination(r: PlanReversion) kind empirical {
    label en official "section 4980(d)(6): as of the termination date the employer is in bankruptcy liquidation under chapter 7 of title 11 or similar State proceedings";
}
pub relation reversion_increased_rate_applies(r: PlanReversion) kind institutional {
    label en official "section 4980(d)(1): the 50 percent rate applies unless a qualified replacement plan or pro rata benefit increases exist; not to a chapter 7 employer";
}
rule ReversionIncreasedRateApplies(r: PlanReversion, amt: Money) defeasible {
    label en official "section 4980(d)(1), (6)";
    when employer_reversion(r, amt);
    unless replacement_plan_established_or_maintained(r) and employer_reversion(r, amt);
    unless pro_rata_benefit_increases_provided(r) and employer_reversion(r, amt);
    unless employer_in_chapter_7_liquidation_at_termination(r) and employer_reversion(r, amt);
    // Stage 3: the derived qualified replacement plan / benefit increases of 29-*.law.
    unless reversion_normal_rate_applies_4980d1(r) and employer_reversion(r, amt);
    then reversion_increased_rate_applies(r);
}
@source(IRC_S4980_A, coverage = exact, quote = "There is hereby imposed a tax of 20 percent of the amount of any employer reversion from a qualified plan.")
pub relation employer_reversion_tax(r: PlanReversion, emp: Person, amount: Money) kind institutional {
    label en official "section 4980(a), (b), (d): 20 percent (50 percent under (d)(1)) of the employer reversion, paid by the employer maintaining the plan";
}
rule EmployerReversionTax20(r: PlanReversion, emp: Person, amt: Money) defeasible {
    label en official "section 4980(a): 20 percent of the amount of the employer reversion, paid by the employer";
    when employer_reversion(r, amt);
    when reversion_employer(r, emp);
    unless reversion_increased_rate_applies(r) and reversion_employer(r, emp) and employer_reversion(r, amt);
    then employer_reversion_tax(r, emp, round(amt * EmployerReversionTaxRate4980, 2, "HALF_UP"));
}
rule EmployerReversionTax50(r: PlanReversion, emp: Person, amt: Money) defeasible {
    label en official "section 4980(d)(1): 50 percent substituted for 20 percent";
    when employer_reversion(r, amt);
    when reversion_employer(r, emp);
    when reversion_increased_rate_applies(r);
    then employer_reversion_tax(r, emp, round(amt * EmployerReversionIncreasedTaxRate4980, 2, "HALF_UP"));
}
pub relation employer_reversion_tax_due_on(r: PlanReversion, on: Date) kind institutional {
    label en official "section 4980(c)(4): the time for payment is the last day of the month following the month in which the reversion occurs";
}
rule EmployerReversionTaxDueDate(r: PlanReversion, occurs: Date) defeasible {
    label en official "section 4980(c)(4): last day of the following month";
    when reversion_occurs_on(r, occurs);
    then employer_reversion_tax_due_on(r, month_end_of(add_calendar_period(month_start_of(occurs), 1 calendar_month)));
}
pub relation employer_reversion_tax_paid(r: PlanReversion, emp: Person) kind empirical {
    label en official "section 4980(b): the tax has been paid by the employer maintaining the plan";
}
@source(IRC_S4980_B, coverage = exact, quote = "The tax imposed by subsection (a) shall be paid by the employer maintaining the plan.")
rule S4980PayTaxDutyRule(r: PlanReversion, emp: Person, amt: Money, due: Date) defeasible {
    label en official "sections 4980(b), (c)(4): the employer maintaining the plan shall pay the reversion tax by the last day of the month following the reversion";
    when employer_reversion_tax(r, emp, amt);
    when employer_reversion_tax_due_on(r, due);
    then duty S4980PayReversionTax {
        bearer emp;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition employer_reversion_tax_paid(r, emp);
            window [-infinity, due];
        }
    };
}

// ============================================================================
// Section 4980C — long-term care insurance requirements
// ============================================================================

pub relation ltc_contract_issuer(a: ExciseAct, issuer: Person) kind empirical {
    label en official "section 4980C(a): the person (issuer) failing to meet the requirements of (c) or (d) with respect to a qualified long-term care insurance contract";
}
@source(IRC_S4980C_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) shall be $100 per insured for each day any requirement of subsection (c) or (d) is not met with respect to each qualified long-term care insurance contract.")
pub relation ltc_failure_tax(a: ExciseAct, issuer: Person, amount: Money) kind institutional {
    label en official "section 4980C(a), (b)(1): $100 per insured for each day a requirement is not met with respect to each qualified long-term care insurance contract, imposed on the person failing to meet the requirements";
}
rule LtcFailureTax(a: ExciseAct, issuer: Person, n: Integer) defeasible {
    label en official "section 4980C(b)(1): $100 × days of noncompliance for this insured and contract, unless waived (b)(2)";
    when excise_act_kind(a, LongTermCareInsuranceFailure);
    when ltc_contract_issuer(a, issuer);
    when noncompliance_days(a, n);
    unless ltc_failure_tax_waived(a) and ltc_contract_issuer(a, issuer) and noncompliance_days(a, n);
    then ltc_failure_tax(a, issuer, LtcFailureDailyTax4980C * n);
}
pub relation secretary_waives_ltc_failure_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4980C(b)(2): the Secretary waives part or all of the tax to the extent payment would be excessive relative to the failure";
}
pub relation ltc_failure_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4980C(b)(2): the tax on the failure is waived";
}
@source(IRC_S4980C_B, coverage = exact, quote = "In the case of a failure which is due to reasonable cause and not to willful neglect, the Secretary may waive part or all of the tax imposed by subsection (a) to the extent that payment of the tax would be excessive relative to the failure involved.")
rule S4980CWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4980C(b)(2): the Secretary may waive part or all of the tax for a failure due to reasonable cause and not to willful neglect";
    when excise_act_kind(a, LongTermCareInsuranceFailure);
    when secretary_waives_ltc_failure_tax_on(a, on);
    then power S4980CWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_ltc_failure_tax_on(a, on);
        valid_when failure_reasonable_cause_established_for_waiver(a);
        effect create(ltc_failure_tax_waived(a));
        window [-infinity, infinity];
    };
}
pub relation failure_reasonable_cause_established_for_waiver(a: ExciseAct) kind institutional {
    label en official "sections 4980B(c)(5), 4980C(b)(2), 4980D(c)(4), 4980E(c), 4980F(c)(4): the failure was due to reasonable cause and not to willful neglect";
}
rule FailureReasonableCauseEstablishedForWaiver(a: ExciseAct) defeasible {
    label en official "the judgment relation about reasonable cause";
    when failure_due_to_reasonable_cause(a);
    then failure_reasonable_cause_established_for_waiver(a);
}
// (c)(2), (c)(3): the issuer's delivery and explanation duties.
pub relation ltc_application_approved_on(c: Person, applicant: Person, on: Date) kind empirical {
    label en official "section 4980C(c)(2): the date an application for a qualified long-term care insurance contract (or a group certificate) is approved";
}
pub relation ltc_contract_delivered(c: Person, applicant: Person) kind empirical {
    label en official "section 4980C(c)(2): the issuer delivered the contract (or certificate) to the applicant, policyholder or certificateholder";
}
@source(IRC_S4980C_C, coverage = exact, quote = "the issuer shall deliver to the applicant (or policyholder or certificateholder) the contract (or certificate) of insurance not later than 30 days after the date of the approval.")
rule S4980CDeliveryDutyRule(issuer: Person, applicant: Person, approved: Date) defeasible {
    label en official "section 4980C(c)(2): the issuer shall deliver the contract not later than 30 days after approval of the application";
    when ltc_application_approved_on(issuer, applicant, approved);
    then duty S4980CDeliverPolicy {
        bearer issuer;
        beneficiary applicant;
        goal achievement {
            condition ltc_contract_delivered(issuer, applicant);
            window [approved, add_calendar_period(approved, 30 calendar_day)];
        }
    };
}
pub relation ltc_denial_explanation_requested_on(issuer: Person, holder: Person, on: Date) kind empirical {
    label en official "section 4980C(c)(3): the date of a written request by the policyholder or certificateholder for the reasons a claim was denied";
}
pub relation ltc_denial_explained_and_information_made_available(issuer: Person, holder: Person) kind empirical {
    label en official "section 4980C(c)(3)(A)-(B): the issuer provided a written explanation of the reasons and made available all information directly relating to the denial";
}
@source(IRC_S4980C_C, coverage = exact, quote = "the issuer shall, within 60 days of the date of a written request by the policyholder or certificateholder (or representative)—")
rule S4980CDenialExplanationDutyRule(issuer: Person, holder: Person, requested: Date) defeasible {
    label en official "section 4980C(c)(3): within 60 days of a written request the issuer shall explain the reasons for a claim denial and make available all information directly relating to it";
    when ltc_denial_explanation_requested_on(issuer, holder, requested);
    then duty S4980CExplainDenial {
        bearer issuer;
        beneficiary holder;
        goal achievement {
            condition ltc_denial_explained_and_information_made_available(issuer, holder);
            window [requested, add_calendar_period(requested, 60 calendar_day)];
        }
    };
}
pub relation ltc_policy_discloses_intended_qualified(issuer: Person, contract: Person) kind empirical {
    label en official "section 4980C(d): the policy and the outline of coverage disclose that the policy is intended to be a qualified long-term care insurance contract under section 7702B(b)";
}
@source(IRC_S4980C_D, coverage = exact, quote = "The requirements of this subsection are met if the issuer of a long-term care insurance policy discloses in such policy and in the outline of coverage required under subsection (c)(1)(B)(ii) that the policy is intended to be a qualified long-term care insurance contract under section 7702B(b).")
rule S4980CDisclosureDutyRule(issuer: Person, contract: Person) defeasible {
    label en official "section 4980C(d): the issuer discloses in the policy and outline of coverage that the policy is intended to be a qualified long-term care insurance contract";
    when ltc_contract_delivered(issuer, contract);
    then duty S4980CDisclosure {
        bearer issuer;
        goal maintenance {
            condition ltc_policy_discloses_intended_qualified(issuer, contract);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// Section 4980D — group health plan failures
// ============================================================================

pub relation ghp_failure_plan(a: ExciseAct, plan: us.irc.group_health::GroupHealthPlan) kind empirical {
    label en official "section 4980D(a): the group health plan whose failure to meet the requirements of chapter 100 gives rise to the tax (section 9834 cross-reference: us.irc.group_health::chapter_100_failure_subject_to_4980d_excise)";
}
pub relation chapter_100_requirement_failed(a: ExciseAct) kind empirical {
    label en official "section 4980D(a): the plan failed to meet a requirement of chapter 100 with respect to the individual (which requirement is the group-health owner's; EXTERNAL_DEPENDENCY, no per-requirement failure head is exported)";
}
pub relation multiemployer_plan_ghp(plan: us.irc.group_health::GroupHealthPlan) kind empirical {
    label en official "section 4980D(e)(2): the plan is a multiemployer plan";
}
pub relation guaranteed_renewability_failure_of_maep_plan(a: ExciseAct) kind empirical {
    label en official "section 4980D(e)(3): a failure under section 9803 with respect to a plan described in (f)(2)(B) (a multiple employer welfare arrangement)";
}
pub relation small_employer_insured_plan_exception(a: ExciseAct) kind empirical {
    label en official "section 4980D(d): a group health plan of a small employer (an average of at least 2 but not more than 50 employees in the preceding calendar year, at least 2 on the first day of the plan year, 414 aggregation) providing coverage solely through a health insurance issuer, and the failure is solely because of the issuer's coverage and is not attributable to section 9811";
}
@source(IRC_S4980D_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) on any failure shall be $100 for each day in the noncompliance period with respect to each individual to whom such failure relates.")
pub relation ghp_failure_gross_tax(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4980D(b)(1): $100 × noncompliance days for the individual, before the (b)(3) and (c) modifications";
}
rule GhpFailureGrossTax(a: ExciseAct, plan: us.irc.group_health::GroupHealthPlan, n: Integer) defeasible {
    label en official "section 4980D(a), (b)(1)";
    when excise_act_kind(a, GroupHealthPlanFailure);
    when ghp_failure_plan(a, plan);
    when chapter_100_requirement_failed(a);
    when noncompliance_days(a, n);
    then ghp_failure_gross_tax(a, GroupHealthPlanFailureDailyTax4980D * n);
}
pub relation ghp_failure_minimum_tax_cap(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4980D(b)(3): the ceiling of the minimum tax: $2,500, or $15,000 where the violations are more than de minimis";
}
rule GhpMinimumTaxCapOrdinary(a: ExciseAct, emp: Person, y: TaxableYear) defeasible {
    label en official "section 4980D(b)(3)(A): $2,500";
    when failure_employer(a, emp);
    when failure_taxable_year_of_employer(a, y);
    unless violations_more_than_de_minimis(emp, y) and failure_employer(a, emp) and failure_taxable_year_of_employer(a, y);
    then ghp_failure_minimum_tax_cap(a, MinimumTaxAfterExamination4980D);
}
rule GhpMinimumTaxCapDeMinimis(a: ExciseAct, emp: Person, y: TaxableYear) defeasible {
    label en official "section 4980D(b)(3)(B): $15,000";
    when failure_employer(a, emp);
    when failure_taxable_year_of_employer(a, y);
    when violations_more_than_de_minimis(emp, y);
    then ghp_failure_minimum_tax_cap(a, MinimumTaxDeMinimisExceeded4980D);
}
pub relation ghp_liable_person(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4980D(e): the employer; for a multiemployer plan, the plan; for a section 9803 failure of a (f)(2)(B) plan, the plan";
}
rule GhpLiableEmployer(a: ExciseAct, emp: Person, plan: us.irc.group_health::GroupHealthPlan) defeasible {
    label en official "section 4980D(e)(1): except as otherwise provided, the employer";
    when ghp_failure_plan(a, plan);
    when failure_employer(a, emp);
    unless multiemployer_plan_ghp(plan) and ghp_failure_plan(a, plan) and failure_employer(a, emp);
    unless guaranteed_renewability_failure_of_maep_plan(a) and ghp_failure_plan(a, plan) and failure_employer(a, emp);
    then ghp_liable_person(a, emp);
}
rule GhpLiableMultiemployerPlan(a: ExciseAct, plan: us.irc.group_health::GroupHealthPlan, plan_person: Person) defeasible {
    label en official "section 4980D(e)(2): in the case of a multiemployer plan, the plan";
    when ghp_failure_plan(a, plan);
    when multiemployer_plan_ghp(plan);
    when ghp_plan_as_person(plan, plan_person);
    then ghp_liable_person(a, plan_person);
}
pub relation ghp_plan_as_person(plan: us.irc.group_health::GroupHealthPlan, p: Person) kind empirical {
    label en unofficial "the plan viewed as a taxpayer (a liable person) for section 4980D(e)(2)-(3)";
}
@source(IRC_S4980D_A, coverage = exact, quote = "There is hereby imposed a tax on any failure of a group health plan to meet the requirements of chapter 100 (relating to group health plan requirements).")
pub relation ghp_failure_tax(a: ExciseAct, liable: Person, amount: Money) kind institutional {
    label en official "sections 4980D(a)-(e): the tax on the failure after the limitations: $100 a day, none if not discoverable or promptly corrected for reasonable cause or excepted for a small insured employer, but not less than the (b)(3) minimum where uncorrected at the examination notice";
}
rule GhpFailureTaxOrdinary(a: ExciseAct, g: Money, p: Person) defeasible {
    label en official "section 4980D(b)(1), (c)(1)-(2), (d): the gross tax unless excused or excepted";
    when ghp_failure_gross_tax(a, g);
    when ghp_liable_person(a, p);
    unless failure_excused_by_limitations(a) and ghp_failure_gross_tax(a, g) and ghp_liable_person(a, p);
    unless small_employer_insured_plan_exception(a) and ghp_failure_gross_tax(a, g) and ghp_liable_person(a, p);
    then ghp_failure_tax(a, p, g);
}
rule GhpFailureTaxMinimumAfterExamination(a: ExciseAct, g: Money, p: Person, cap: Money) defeasible {
    label en official "section 4980D(b)(3): a failure uncorrected at the examination notice is taxed at least the lesser of the cap and the tax without the (c)(1)-(2) limitations, notwithstanding those limitations";
    when ghp_failure_gross_tax(a, g);
    when ghp_liable_person(a, p);
    when uncorrected_at_notice_of_examination(a);
    when failure_excused_by_limitations(a);
    when ghp_failure_minimum_tax_cap(a, cap);
    unless small_employer_insured_plan_exception(a) and ghp_failure_gross_tax(a, g) and ghp_liable_person(a, p) and uncorrected_at_notice_of_examination(a) and ghp_failure_minimum_tax_cap(a, cap);
    then ghp_failure_tax(a, p, min(cap, g));
}
pub relation ghp_prior_year_plan_cost(emp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4980D(c)(3)(A)(i)(I): the aggregate amount paid or incurred by the employer (or predecessor) during the preceding taxable year for group health plans";
}
pub relation ghp_reasonable_cause_failure(a: ExciseAct) kind institutional {
    label en official "section 4980D(c)(3): the failure is due to reasonable cause and not to willful neglect (the overall limitation applies only to such failures)";
}
rule GhpReasonableCauseFailure(a: ExciseAct) defeasible {
    label en official "the judgment relation about reasonable cause";
    when failure_due_to_reasonable_cause(a);
    then ghp_reasonable_cause_failure(a);
}
pub relation ghp_annual_tax_before_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980D(c)(3): the taxes on the employer's reasonable-cause failures during its taxable year, before the overall limitation";
}
rule GhpAnnualTaxBeforeLimit(emp: Person, y: TaxableYear, a0: ExciseAct) defeasible {
    label en official "sum of the failure taxes of the year (aggregate over a derived relation — G2514)";
    when failure_employer(a0, emp);
    when failure_taxable_year_of_employer(a0, y);
    then ghp_annual_tax_before_limit(emp, y, sum(collect all x: Money, a: ExciseAct where ghp_failure_tax(a, emp, x) and failure_taxable_year_of_employer(a, y) and ghp_reasonable_cause_failure(a), empty: 0.00 USD));
}
pub relation ghp_annual_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980D(c)(3)(A)(i): the lesser of 10 percent of the preceding year's group health plan cost and $500,000";
}
rule GhpAnnualLimit(emp: Person, y: TaxableYear, cost: Money) defeasible {
    label en official "section 4980D(c)(3)(A)(i)";
    when ghp_prior_year_plan_cost(emp, y, cost);
    then ghp_annual_limit(emp, y, min(cost * OverallLimitShare4980D, OverallLimitDollar4980D));
}
pub relation ghp_annual_tax_after_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980D(c)(3): the reasonable-cause failure taxes after the overall limitation";
}
rule GhpAnnualTaxAfterLimit(emp: Person, y: TaxableYear, t: Money, l: Money) defeasible {
    label en official "the lesser of the taxes and the limit";
    when ghp_annual_tax_before_limit(emp, y, t);
    when ghp_annual_limit(emp, y, l);
    then ghp_annual_tax_after_limit(emp, y, min(t, l));
}
pub relation secretary_waives_ghp_failure_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4980D(c)(4): the Secretary waives part or all of the tax to the extent payment would be excessive relative to the failure";
}
pub relation ghp_failure_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4980D(c)(4): the tax on the failure is waived";
}
@source(IRC_S4980D_C, coverage = exact, quote = "the Secretary may waive part or all of the tax imposed by subsection (a) to the extent that the payment of such tax would be excessive relative to the failure involved.")
rule S4980DWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4980D(c)(4): waiver for a failure due to reasonable cause and not to willful neglect";
    when excise_act_kind(a, GroupHealthPlanFailure);
    when secretary_waives_ghp_failure_tax_on(a, on);
    then power S4980DWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_ghp_failure_tax_on(a, on);
        valid_when failure_reasonable_cause_established_for_waiver(a);
        effect create(ghp_failure_tax_waived(a));
        window [-infinity, infinity];
    };
}

// Pub. L. 119-75 section 6701 — section 9826, oversight of pharmacy benefit management services.
pub relation pbm_contract_entered_on(plan: Person, applicable_entity: Person, on: Date) kind empirical {
    label en official "section 9826(a): a group health plan (or an entity providing pharmacy benefit management services on its behalf) enters into a contract, including an extension or renewal, with an applicable entity on this date";
}
pub relation applicable_entity_agrees_to_reporting_terms(plan: Person, applicable_entity: Person) kind empirical {
    label en official "section 9826(a)(1)-(2): the applicable entity agrees not to limit or delay disclosure of information that prevents the reports of (b), and to provide the relevant information necessary to make them";
}
@source(us.irc.temporal::PL119_75_S6701, relation = derives_from, quote = "shall not enter into a contract, including an extension or renewal of a contract, entered into on or after the effective date, with an applicable entity unless such applicable entity agrees to—")
rule S9826ContractProhibitionRule(plan: Person, applicant: Person, on: Date) defeasible {
    label en official "section 9826(a) (Pub. L. 119-75 section 6701): for plan years beginning on or after the date 30 months after enactment, a group health plan (or its PBM) shall not enter into or renew a contract with an applicable entity unless the entity agrees to the disclosure and information terms — VIOLATED on itself when the contract is entered into without the agreement";
    effective [@2026-02-03, infinity);
    when pbm_contract_entered_on(plan, applicant, on);
    when on >= add_calendar_period(PbmEnactmentDate9826, 30 calendar_month);
    unless applicable_entity_agrees_to_reporting_terms(plan, applicant) and pbm_contract_entered_on(plan, applicant, on);
    then prohibition S9826ContractWithoutReportingAgreement {
        bearer plan;
        action pbm_contract_entered_on(plan, applicant, on);
        window [add_calendar_period(PbmEnactmentDate9826, 30 calendar_month), infinity];
    };
}
pub relation pbm_reporting_contract(pbm: Person, plan: Person, contract_on: Date, period_start: Date) kind empirical {
    label en official "section 9826(b)(1): a contract between a group health plan and an entity providing pharmacy benefit management services entered into (or renewed) on or after the effective date, and the start of the reporting period";
}
pub relation pbm_report_submitted(pbm: Person, plan: Person, period_start: Date) kind empirical {
    label en official "section 9826(b)(1): the entity providing pharmacy benefit management services has submitted the report for the period to the group health plan";
}
@source(us.irc.temporal::PL119_75_S6701, relation = derives_from, quote = "not less frequently than every 6 months (or, at the request of a group health plan, not less frequently than quarterly, and under the same conditions, terms, and cost of the semiannual report under this subsection), shall submit to the group health plan a report in accordance with this section.")
rule S9826SemiannualReportDutyRule(pbm: Person, plan: Person, cdate: Date, start: Date) defeasible {
    label en official "section 9826(b)(1) (Pub. L. 119-75 section 6701): for plan years beginning on or after the effective date the PBM shall submit a report to the group health plan at least every 6 months";
    effective [@2026-02-03, infinity);
    when pbm_reporting_contract(pbm, plan, cdate, start);
    when cdate >= add_calendar_period(PbmEnactmentDate9826, 30 calendar_month);
    then duty S9826SubmitPbmReport {
        bearer pbm;
        beneficiary plan;
        goal achievement {
            condition pbm_report_submitted(pbm, plan, start);
            window [start, add_calendar_period(start, 6 calendar_month)];
        }
    };
}

// ============================================================================
// Sections 4980E and 4980G — Archer MSA and HSA comparability
// ============================================================================

pub relation employer_contributes_to_archer_msa(emp: Person, cy: Integer) kind empirical {
    label en official "section 4980E(a): the employer makes a contribution to the Archer MSA of an employee with respect to coverage under a high deductible health plan during the calendar year";
}
pub relation employer_contributes_to_hsa(emp: Person, cy: Integer) kind empirical {
    label en official "section 4980G(a): the employer makes a contribution to the health savings account of an employee during the calendar year";
}
enum MsaCoverageCategory { SelfOnly; Family; }
pub relation msa_participant(emp: Person, cy: Integer, e: Person, cat: MsaCoverageCategory, part_time: Boolean, highly_compensated: Boolean) kind empirical {
    label en official "section 4980E(d)(3)-(4): an employee who is an eligible individual covered under a high deductible health plan of the employer, with the category of coverage, part-time status (customarily fewer than 30 hours a week) and highly compensated status (4980G(d))";
}
pub relation msa_contribution(emp: Person, cy: Integer, e: Person, amount: Money, annual_deductible: Money) kind empirical {
    label en official "section 4980E(d)(2): the employer's contribution for the employee (already prorated for part-year employees under (d)(2)(B)) and the annual deductible limit of the high deductible health plan covering the employee";
}
relation comparable_msa_pair(emp: Person, cy: Integer, e1: Person, e2: Person) kind institutional {
    label en unofficial "two comparable participating employees: same category of coverage, both part-time or both not";
}
rule ComparableMsaPair(emp: Person, cy: Integer, e1: Person, e2: Person, cat: MsaCoverageCategory, pt: Boolean, h1: Boolean, h2: Boolean) defeasible {
    label en official "section 4980E(d)(3)-(4): all employees with the same category of coverage, part-time employees separately";
    when msa_participant(emp, cy, e1, cat, pt, h1);
    when msa_participant(emp, cy, e2, cat, pt, h2);
    when e1 != e2;
    then comparable_msa_pair(emp, cy, e1, e2);
}
pub relation msa_contributions_not_comparable(emp: Person, cy: Integer) kind institutional {
    label en official "section 4980E(d)(1)-(2): two comparable employees received contributions that are neither the same amount nor the same percentage of the annual deductible limit";
}
rule MsaContributionsNotComparable(emp: Person, cy: Integer, e1: Person, e2: Person, a1: Money, d1: Money, a2: Money, d2: Money) defeasible {
    label en official "section 4980E(d)(2)(A): contributions are comparable if the same amount or the same percentage of the annual deductible limit";
    when comparable_msa_pair(emp, cy, e1, e2);
    when msa_contribution(emp, cy, e1, a1, d1);
    when msa_contribution(emp, cy, e2, a2, d2);
    when a1 != a2;
    when (a1 / 1.00 USD) * (d2 / 1.00 USD) != (a2 / 1.00 USD) * (d1 / 1.00 USD);
    then msa_contributions_not_comparable(emp, cy);
}
pub relation aggregate_archer_msa_contributions(emp: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4980E(b): the aggregate amount contributed by the employer to Archer MSAs of employees for taxable years of such employees ending with or within the calendar year (controlled group treated as one employer, (e))";
}
pub relation aggregate_hsa_contributions(emp: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4980G(a), (b): the aggregate amount contributed by the employer to health savings accounts of employees for the calendar year";
}
@source(IRC_S4980E_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) on any failure for any calendar year is the amount equal to 35 percent of the aggregate amount contributed by the employer to Archer MSAs of employees for taxable years of such employees ending with or within such calendar year.")
pub relation archer_msa_comparability_tax(emp: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4980E(a), (b): 35 percent of the employer's aggregate Archer MSA contributions for a calendar year in which the comparability requirement failed";
}
rule ArcherMsaComparabilityTax(emp: Person, cy: Integer, agg: Money) defeasible {
    label en official "section 4980E(b)";
    when employer_contributes_to_archer_msa(emp, cy);
    when msa_contributions_not_comparable(emp, cy);
    when aggregate_archer_msa_contributions(emp, cy, agg);
    then archer_msa_comparability_tax(emp, cy, round(agg * ArcherMsaComparabilityTaxRate4980E, 2, "HALF_UP"));
}
@source(IRC_S4980G_A, coverage = exact, quote = "there is hereby imposed a tax on the failure of such employer to meet the requirements of subsection (b) for such calendar year.")
pub relation hsa_comparability_tax(emp: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4980G(a), (b): the section 4980E tax (35 percent of aggregate contributions) for health savings accounts";
}
rule HsaComparabilityTax(emp: Person, cy: Integer, agg: Money) defeasible {
    label en official "section 4980G(b): rules similar to 4980E; 35 percent of the aggregate HSA contributions for a year the comparability requirement failed";
    when employer_contributes_to_hsa(emp, cy);
    when msa_contributions_not_comparable(emp, cy);
    when aggregate_hsa_contributions(emp, cy, agg);
    then hsa_comparability_tax(emp, cy, round(agg * HsaComparabilityTaxRate4980G, 2, "HALF_UP"));
}
pub relation comparable_contributions_made_for_year(emp: Person, cy: Integer) kind empirical {
    label en official "section 4980E(d)(1): the employer makes available comparable contributions to the Archer MSAs (HSAs, 4980G(b)) of all comparable participating employees for each coverage period during the calendar year";
}
@source(IRC_S4980E_D, coverage = exact, quote = "An employer meets the requirements of this subsection for any calendar year if the employer makes available comparable contributions to the Archer MSAs of all comparable participating employees for each coverage period during such calendar year.")
rule S4980EComparabilityDutyRule(emp: Person, cy: Integer) defeasible {
    label en official "sections 4980E(d)(1), 4980G(b): an employer that contributes to Archer MSAs (or HSAs) shall make comparable contributions available to all comparable participating employees for each coverage period";
    when employer_contributes_to_archer_msa(emp, cy);
    then duty S4980EMakeComparableContributions {
        bearer emp;
        goal maintenance {
            condition comparable_contributions_made_for_year(emp, cy);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_waives_msa_comparability_tax_on(emp: Person, cy: Integer, on: Date) kind empirical {
    label en official "section 4980E(c): the Secretary waives part or all of the tax to the extent payment would be excessive relative to the failure";
}
pub relation msa_comparability_tax_waived(emp: Person, cy: Integer) kind institutional {
    label en official "section 4980E(c): the tax is waived";
}
external judgment relation msa_failure_due_to_reasonable_cause(emp: Person, cy: Integer) {
    authority Secretary;
    label en official "section 4980E(c): the failure was due to reasonable cause and not to willful neglect";
}
@source(IRC_S4980E_C, coverage = exact, quote = "the Secretary may waive part or all of the tax imposed by subsection (a) to the extent that the payment of such tax would be excessive relative to the failure involved.")
rule S4980EWaiverPowerRule(emp: Person, cy: Integer, on: Date) defeasible {
    label en official "section 4980E(c): waiver for a failure due to reasonable cause and not to willful neglect";
    when secretary_waives_msa_comparability_tax_on(emp, cy, on);
    then power S4980EWaiver {
        holder us.irc.core::Secretary;
        over emp;
        exercise secretary_waives_msa_comparability_tax_on(emp, cy, on);
        valid_when msa_failure_due_to_reasonable_cause(emp, cy);
        effect create(msa_comparability_tax_waived(emp, cy));
        window [-infinity, infinity];
    };
}

// ============================================================================
// Section 4980F — notice of significant reduction in benefit accrual
// ============================================================================

pub relation applicable_pension_plan_4980F(plan: Person) kind empirical {
    label en official "section 4980F(f)(2): a defined benefit plan described in 401(a) with a 501(a) trust, or an individual account plan subject to the section 412 funding standards; not a governmental plan or a church plan without the 410(d) election";
}
pub relation plan_amended_for_significant_accrual_reduction(plan: Person, amendment_effective_on: Date) kind empirical {
    label en official "section 4980F(e)(1): the plan is amended to provide for a significant reduction in the rate of future benefit accrual (including elimination or reduction of an early retirement benefit or retirement-type subsidy, (f)(3))";
}
pub relation applicable_individual_4980F(i: Person, plan: Person) kind empirical {
    label en official "section 4980F(f)(1): a participant, or an alternate payee under an applicable QDRO, whose rate of future benefit accrual may reasonably be expected to be significantly reduced by the amendment";
}
pub relation plan_administrator_4980F(admin: Person, plan: Person) kind empirical {
    label en official "section 4980F(e)(1): the plan administrator";
}
pub relation accrual_reduction_notice_given(admin: Person, i: Person, plan: Person) kind institutional {
    label en official "section 4980F(e)(1)-(2), (4): the notice described in (e)(2) was provided to the applicable individual (or a written designee)";
}
@source(IRC_S4980F_E, coverage = exact, quote = "the plan administrator shall provide the notice described in paragraph (2) to each applicable individual (and to each employee organization representing applicable individuals) and to each employer who has an obligation to contribute to the plan.")
rule S4980FNoticeDutyRule(admin: Person, i: Person, plan: Person, eff: Date) defeasible {
    label en official "section 4980F(e)(1), (3): the plan administrator shall provide the notice to each applicable individual within a reasonable time before the effective date of the amendment (window ends on the effective date; 'reasonable time' is left to regulations — G2515)";
    when applicable_pension_plan_4980F(plan);
    when plan_amended_for_significant_accrual_reduction(plan, eff);
    when plan_administrator_4980F(admin, plan);
    when applicable_individual_4980F(i, plan);
    // Stage 3: section 4980F(e)(2) - a plan for which the Secretary provided a simplified notice or exemption (34-*.law).
    unless notice_requirement_relaxed_4980F_e2(plan) and applicable_pension_plan_4980F(plan) and plan_amended_for_significant_accrual_reduction(plan, eff) and plan_administrator_4980F(admin, plan) and applicable_individual_4980F(i, plan);
    then duty S4980FProvideAccrualReductionNotice {
        bearer admin;
        beneficiary i;
        goal achievement {
            condition accrual_reduction_notice_given(admin, i, plan);
            window [-infinity, eff];
        }
    };
}
pub relation notice_failure_plan_4980F(a: ExciseAct, plan: Person) kind empirical {
    label en official "section 4980F(a): the applicable pension plan that failed to meet the (e) requirements with respect to the applicable individual";
}
pub relation reasonable_diligence_exercised_4980F(a: ExciseAct) kind empirical {
    label en official "section 4980F(c)(2)-(3): the person liable exercised reasonable diligence to meet the (e) requirements";
}
pub relation multiemployer_plan_4980F(plan: Person) kind empirical {
    label en official "section 4980F(d)(2): the plan is a multiemployer plan (the plan, not the employer, is liable)";
}
@source(IRC_S4980F_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) on any failure with respect to any applicable individual shall be $100 for each day in the noncompliance period with respect to such failure.")
pub relation benefit_accrual_notice_failure_gross_tax(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4980F(b): $100 × noncompliance days, before the (c) limitations";
}
rule BenefitAccrualNoticeFailureGrossTax(a: ExciseAct, plan: Person, n: Integer) defeasible {
    label en official "section 4980F(a), (b)(1)";
    when excise_act_kind(a, BenefitAccrualNoticeFailure);
    when notice_failure_plan_4980F(a, plan);
    when applicable_pension_plan_4980F(plan);
    when noncompliance_days(a, n);
    then benefit_accrual_notice_failure_gross_tax(a, BenefitAccrualNoticeFailureDailyTax4980F * n);
}
pub relation benefit_accrual_notice_failure_tax(a: ExciseAct, liable: Person, amount: Money) kind institutional {
    label en official "section 4980F(a), (c), (d): the tax on the failure after the limitations, on the employer (or, for a multiemployer plan, the plan)";
}
rule BenefitAccrualNoticeFailureTax(a: ExciseAct, g: Money, emp: Person, plan: Person) defeasible {
    label en official "section 4980F(a)-(d): $100 a day unless not discovered despite reasonable diligence or the notice is provided within 30 days of knowledge; the employer is liable";
    when benefit_accrual_notice_failure_gross_tax(a, g);
    when notice_failure_plan_4980F(a, plan);
    when failure_employer(a, emp);
    unless multiemployer_plan_4980F(plan) and benefit_accrual_notice_failure_gross_tax(a, g) and notice_failure_plan_4980F(a, plan) and failure_employer(a, emp);
    unless failure_excused_by_limitations(a) and benefit_accrual_notice_failure_gross_tax(a, g) and notice_failure_plan_4980F(a, plan) and failure_employer(a, emp);
    then benefit_accrual_notice_failure_tax(a, emp, g);
}
rule BenefitAccrualNoticeFailureTaxMultiemployer(a: ExciseAct, g: Money, plan: Person) defeasible {
    label en official "section 4980F(d)(2): in the case of a multiemployer plan, the plan is liable";
    when benefit_accrual_notice_failure_gross_tax(a, g);
    when notice_failure_plan_4980F(a, plan);
    when multiemployer_plan_4980F(plan);
    unless failure_excused_by_limitations(a) and benefit_accrual_notice_failure_gross_tax(a, g) and notice_failure_plan_4980F(a, plan) and multiemployer_plan_4980F(plan);
    then benefit_accrual_notice_failure_tax(a, plan, g);
}
pub relation benefit_accrual_notice_annual_before_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980F(c)(3)(A): the taxes on the failures of a diligent liable person for its taxable year, before the $500,000 limit";
}
rule BenefitAccrualNoticeAnnualBeforeLimit(emp: Person, y: TaxableYear, a0: ExciseAct) defeasible {
    label en official "sum of the diligent failure taxes of the year (aggregate over a derived relation — G2514)";
    when failure_employer(a0, emp);
    when failure_taxable_year_of_employer(a0, y);
    then benefit_accrual_notice_annual_before_limit(emp, y, sum(collect all x: Money, a: ExciseAct where benefit_accrual_notice_failure_tax(a, emp, x) and failure_taxable_year_of_employer(a, y) and reasonable_diligence_exercised_4980F(a), empty: 0.00 USD));
}
pub relation benefit_accrual_notice_annual_after_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980F(c)(3)(A): the diligent failure taxes after the $500,000 overall limitation";
}
rule BenefitAccrualNoticeAnnualAfterLimit(emp: Person, y: TaxableYear, t: Money) defeasible {
    label en official "the lesser of the taxes and $500,000";
    when benefit_accrual_notice_annual_before_limit(emp, y, t);
    then benefit_accrual_notice_annual_after_limit(emp, y, min(t, BenefitAccrualNoticeOverallLimit4980F));
}
