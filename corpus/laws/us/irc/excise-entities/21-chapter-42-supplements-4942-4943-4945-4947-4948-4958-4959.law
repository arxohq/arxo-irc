// Supplements to the stage 1 chapter 42 modules (Stage 2, DECISION-0379):
//  - 4942(f): adjusted net income and the 12/31/1969 basis floor;
//  - 4943: (c)(3) unincorporated enterprises, (e)(2)-(3) donor advised funds, (f)
//    supporting organizations treated as private foundations, (g) the philanthropic
//    business exemption;
//  - 4945: (d)(4) grants to organizations, (e) lobbying, (f) voter registration,
//    (g) individual grants, (h) expenditure responsibility, (i) correction;
//  - 4947: charitable and split-interest trusts;
//  - 4948: foreign private foundations;
//  - 4958: the disqualified-person categories (B)-(F), the special excess benefit
//    rules for donor advised funds and supporting organizations, definitions;
//  - 4959: the $50,000 tax on a hospital organization failing section 501(r)(3).
//
// WIRING. `chapter_42_foundation(f, y)` is the status test that the section 4941 and
// 4944 classifications now read: a private foundation under section 509 (from
// us.irc.exempt_organizations) OR a split-interest trust treated as one by 4947(a)(2),
// except a foreign organization excluded by 4948(b). The four "taxable period"
// definitions of 4942(j)(1), 4943(d)(2), 4945(i)(2) and 4958(f)(5) end at the earlier
// of the notice of deficiency and the assessment; their additional taxes now read
// `corrected_within_notice_or_assessment_period` (12-jeopardy-...law), not the
// three-candidate period of 4941(e).

// ============================================================================
// Wiring: chapter 42 foundation status
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4942_F,
    IRC_S4943_C,
    IRC_S4943_F,
    IRC_S4943_G,
    IRC_S4945_E,
    IRC_S4945_F,
    IRC_S4945_G,
    IRC_S4945_H,
    IRC_S4947_A,
    IRC_S4947_B,
    IRC_S4948_A,
    IRC_S4948_C,
    IRC_S4958_C,
    IRC_S4958_F,
    IRC_S4959_NOTE_2,
    LobbyingCommunication,
    Person,
    TaxableYear,
    attempts_to_affect_opinions_of_public,
    combined_ownership_for_controlled_entity_4958,
    communicates_with_legislator_or_participating_official,
    disqualified_person_4958,
    excess_benefit_amount,
    excess_benefit_organization,
    excess_benefit_transaction,
    excess_benefit_transaction_date,
    excess_business_holdings_foundation,
    excise_act_kind,
    grant_excepted_from_4945d4_and_h_note7_5,
    is_nonpartisan_analysis,
    is_self_defense_communication,
    is_technical_advice_on_written_request,
    member_of_family,
    person_described_in_4958f7_for_daf,
    position_of_substantial_influence_on,
    taxable_expenditure,
    taxable_expenditure_foundation,
};

pub relation split_interest_trust_4947a2(t: Person) kind empirical {
    label en official "section 4947(a)(2): a trust not exempt under 501(a), not all of whose unexpired interests are devoted to 170(c)(2)(B) purposes, with amounts in trust for which a deduction was allowed under 170, 545(b)(2), 642(c), 2055, 2106(a)(2) or 2522";
}
pub relation trust_amounts_excluded_4947a2(t: Person) kind empirical {
    label en official "section 4947(a)(2)(A)-(C): the amounts are payable to income beneficiaries (absent a 170(f)(2)(B)/2055(e)(2)(B)/2522(c)(2)(B) deduction), are non-deduction amounts segregated from deduction amounts, or were transferred before May 27, 1969 (the split-interest rules do not apply to those amounts)";
}
pub relation foreign_organization_excluded_by_4948b(f: Person) kind empirical {
    label en official "section 4948(b): a foreign organization that received substantially all of its support (other than gross investment income) from sources outside the United States — sections 507, 508 and chapter 42 (other than 4948) do not apply";
}
pub relation trust_taxable_year_4947(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the trust's status is asked";
}
@source(IRC_S4947_A, coverage = exact, quote = "section 4941 (relating to taxes on self-dealing), section 4943 (relating to taxes on excess business holdings) except as provided in subsection (b)(3), section 4944 (relating to investments which jeopardize charitable purpose) except as provided in subsection (b)(3), and section 4945 (relating to taxes on taxable expenditures) shall apply as if such trust were a private foundation.")
pub relation chapter_42_foundation(f: Person, y: TaxableYear) kind institutional {
    label en official "sections 4947(a)(2), 4948(b): a private foundation, or a split-interest trust treated as one, other than a foreign organization excluded by 4948(b)";
}
rule Chapter42FoundationPrivateFoundation(f: Person, y: TaxableYear) defeasible {
    label en official "a private foundation for the year (section 509(a))";
    when us.irc.exempt_organizations::private_foundation(f, y);
    unless foreign_organization_excluded_by_4948b(f) and us.irc.exempt_organizations::private_foundation(f, y);
    then chapter_42_foundation(f, y);
}
rule Chapter42FoundationSplitInterestTrust(f: Person, y: TaxableYear) defeasible {
    label en official "section 4947(a)(2): a split-interest trust is treated as a private foundation for sections 507, 508(e), 4941, 4943, 4944 and 4945";
    when split_interest_trust_4947a2(f);
    when trust_taxable_year_4947(f, y);
    then chapter_42_foundation(f, y);
}

// ============================================================================
// Section 4947
// ============================================================================

pub relation charitable_trust_all_interests_charitable(t: Person) kind empirical {
    label en official "section 4947(a)(1): all of the unexpired interests in the trust are devoted to one or more 170(c)(2)(B) purposes";
}
pub relation trust_not_exempt_under_501a(t: Person) kind empirical {
    label en official "section 4947(a): the trust is not exempt from taxation under section 501(a)";
}
pub relation deduction_allowed_for_trust_transfers(t: Person) kind empirical {
    label en official "section 4947(a): a deduction was allowed under section 170, 545(b)(2), 642(c), 2055, 2106(a)(2) or 2522 (or the corresponding provisions of prior law)";
}
@source(IRC_S4947_A, coverage = exact, quote = "a trust which is not exempt from taxation under section 501(a), all of the unexpired interests in which are devoted to one or more of the purposes described in section 170(c)(2)(B), and for which a deduction was allowed under section 170, 545(b)(2), 642(c), 2055, 2106(a)(2), or 2522 (or the corresponding provisions of prior law), shall be treated as an organization described in section 501(c)(3).")
pub relation charitable_trust_treated_as_501c3(t: Person) kind institutional {
    label en official "section 4947(a)(1): the charitable trust is treated as a section 501(c)(3) organization for part II of subchapter F (other than 508(a)-(c)) and chapter 42";
}
rule CharitableTrustTreatedAs501c3(t: Person) defeasible {
    label en official "section 4947(a)(1)";
    when trust_not_exempt_under_501a(t);
    when charitable_trust_all_interests_charitable(t);
    when deduction_allowed_for_trust_transfers(t);
    then charitable_trust_treated_as_501c3(t);
}
pub relation deduction_amounts_value_in_trust(t: Person, amount: Money) kind empirical {
    label en official "section 4947(b)(3)(A): the aggregate value of all amounts in the trust for which a deduction was allowed";
}
pub relation total_fair_market_value_in_trust(t: Person, amount: Money) kind empirical {
    label en official "section 4947(b)(3)(A): the aggregate fair market value of all amounts in such trusts";
}
pub relation only_income_interest_devoted_to_charity(t: Person) kind empirical {
    label en official "section 4947(b)(3)(A): all the income interest (and none of the remainder interest) of the trust is devoted solely to 170(c)(2)(B) purposes";
}
pub relation deduction_allowed_for_every_remainder_beneficiary_only(t: Person) kind empirical {
    label en official "section 4947(b)(3)(B): a deduction was allowed for amounts payable to every remainder beneficiary but not to any income beneficiary";
}
@source(IRC_S4947_B, coverage = exact, quote = "Sections 4943 and 4944 shall not apply to a trust which is described in subsection (a)(2) if—")
pub relation split_interest_trust_exempt_from_4943_and_4944(t: Person) kind institutional {
    label en official "section 4947(b)(3): sections 4943 and 4944 do not apply to a split-interest trust with only the income interest charitable and deduction amounts at most 60 percent of the total, or with deductions for every remainder beneficiary and none for an income beneficiary";
}
rule SplitInterestExemptIncomeInterestOnly(t: Person, d: Money, v: Money) defeasible {
    label en official "section 4947(b)(3)(A): income interest only devoted to charity and deduction amounts not more than 60 percent of the aggregate fair market value";
    when split_interest_trust_4947a2(t);
    when only_income_interest_devoted_to_charity(t);
    when deduction_amounts_value_in_trust(t, d);
    when total_fair_market_value_in_trust(t, v);
    when d <= v * SplitInterestTrustNonCharitableShareLimit4947;
    then split_interest_trust_exempt_from_4943_and_4944(t);
}
rule SplitInterestExemptRemainderOnly(t: Person) defeasible {
    label en official "section 4947(b)(3)(B)";
    when split_interest_trust_4947a2(t);
    when deduction_allowed_for_every_remainder_beneficiary_only(t);
    then split_interest_trust_exempt_from_4943_and_4944(t);
}
pub relation trust_value_of_net_assets_limited_to_segregated(t: Person, amount: Money) kind empirical {
    label en official "section 4947(b)(2): if amounts are segregated the value of net assets for section 507(c)(2) and (g) is limited to the segregated amounts";
}
pub relation trust_qualified_gratuitous_transfer_to_esop(t: Person) kind empirical {
    label en official "section 4947(b)(4): a distribution of qualified employer securities to an ESOP in a qualified gratuitous transfer (664(g)) — section 507(a) does not apply";
}

// ============================================================================
// Section 4948
// ============================================================================

pub relation foreign_organization_private_foundation(o: Person, y: TaxableYear) kind empirical {
    label en official "section 4948(a): the foreign organization is a private foundation for the taxable year";
}
pub relation us_source_gross_investment_income_4948(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4948(a): gross investment income (within the meaning of section 4940(c)(2)) derived from sources within the United States (section 861)";
}
@source(IRC_S4948_A, coverage = exact, quote = "In lieu of the tax imposed by section 4940, there is hereby imposed for each taxable year on the gross investment income")
pub relation foreign_foundation_tax_4948(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4948(a): in lieu of the section 4940 tax, 4 percent of the U.S.-source gross investment income of a foreign private foundation";
}
rule ForeignFoundationTax4948(o: Person, y: TaxableYear, income: Money) defeasible {
    label en official "section 4948(a); cents HALF_UP (JUDGMENT CALL)";
    when foreign_organization_private_foundation(o, y);
    when us_source_gross_investment_income_4948(o, y, income);
    then foreign_foundation_tax_4948(o, y, round(income * ForeignPrivateFoundationTaxRate4948, 2, "HALF_UP"));
}
pub relation foreign_org_engaged_in_prohibited_transaction_after_1969(o: Person) kind empirical {
    label en official "section 4948(c)(1)-(2): a foreign organization described in (b) has engaged, after December 31, 1969, in an act or failure to act (other than under 4942(e)) that would subject it or a disqualified person to a 6684 penalty or a 507 tax if it were domestic";
}
pub relation secretary_notifies_foreign_org_of_prohibited_transaction_on(o: Person, on: Date) kind empirical {
    label en official "section 4948(c)(3)(A): the date the Secretary notifies the foreign organization that it has engaged in a prohibited transaction";
}
pub relation prohibited_transaction_notice_published_on(o: Person, on: Date) kind empirical {
    label en official "section 4948(c)(3)(A): the date the Secretary publishes the notice in the Federal Register";
}
pub relation foreign_org_notice_valid(o: Person) kind institutional {
    label en official "section 4948(c): the organization is a (b) organization that engaged in a prohibited transaction after 1969 — the notice is valid";
}
rule ForeignOrgNoticeValid(o: Person) defeasible {
    label en official "section 4948(c)(1)";
    when foreign_organization_excluded_by_4948b(o);
    when foreign_org_engaged_in_prohibited_transaction_after_1969(o);
    then foreign_org_notice_valid(o);
}
pub relation foreign_org_exemption_denied_from(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4948(c)(3)(A): exemption under 501(a) is denied for all taxable years beginning with the year in which the Secretary notified the organization";
}
@source(IRC_S4948_C, coverage = exact, quote = "The Secretary shall publish such notice in the Federal Register on the day on which he so notifies such foreign organization.")
rule S4948NotifyForeignOrganizationPowerRule(o: Person, on: Date, y: TaxableYear) defeasible {
    label en official "section 4948(c)(3)(A): the Secretary's notification of a prohibited transaction denies exemption from the taxable year of notification; invalid unless the organization is a (b) organization that engaged in a prohibited transaction";
    when secretary_notifies_foreign_org_of_prohibited_transaction_on(o, on);
    when foreign_org_notice_year(o, y);
    then power S4948DenyExemptionByNotice {
        holder us.irc.core::Secretary;
        over o;
        exercise secretary_notifies_foreign_org_of_prohibited_transaction_on(o, on);
        valid_when foreign_org_notice_valid(o);
        effect create(foreign_org_exemption_denied_from(o, y));
        window [-infinity, infinity];
    };
}
pub relation foreign_org_notice_year(o: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year of the organization in which it is notified";
}
@source(IRC_S4948_C, coverage = exact, quote = "The Secretary shall publish such notice in the Federal Register on the day on which he so notifies such foreign organization.")
rule S4948PublishNoticeDutyRule(o: Person, on: Date) defeasible {
    label en official "section 4948(c)(3)(A): the Secretary shall publish the notice in the Federal Register on the day on which he notifies the organization";
    when secretary_notifies_foreign_org_of_prohibited_transaction_on(o, on);
    then duty S4948PublishNotice {
        bearer us.irc.core::Secretary;
        goal achievement {
            condition prohibited_transaction_notice_published_on(o, on);
            window [on, on];
        }
    };
}
pub relation foreign_org_claim_for_exemption_filed_for_year(o: Person, y: TaxableYear) kind empirical {
    label en official "section 4948(c)(3)(B): the organization filed a claim for exemption for the second taxable year after the notice year or a later year";
}
pub relation secretary_satisfied_no_further_prohibited_transactions(o: Person) kind empirical {
    label en official "section 4948(c)(3)(B): the Secretary is satisfied that the organization will not knowingly again engage in a prohibited transaction";
}
pub relation foreign_org_exemption_restored_from(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4948(c)(3)(B): exemption is not denied for taxable years beginning with the claim year (for earlier transactions)";
}
rule ForeignOrgExemptionRestored(o: Person, y: TaxableYear) defeasible {
    label en official "section 4948(c)(3)(B)";
    when foreign_org_claim_for_exemption_filed_for_year(o, y);
    when secretary_satisfied_no_further_prohibited_transactions(o);
    then foreign_org_exemption_restored_from(o, y);
}
pub relation gift_to_foreign_org_after_notice(gift: Person, o: Person, y: TaxableYear) kind empirical {
    label en official "section 4948(c)(4): a gift or bequest made to the foreign organization after the Secretary published the notice, in a taxable year of the organization for which it is not exempt by reason of (c)(1)";
}
pub relation charitable_deduction_disallowed_4948c4(gift: Person) kind institutional {
    label en official "section 4948(c)(4): no deduction under 170, 545(b)(2), 642(c), 2055, 2106(a)(2) or 2522 for such a gift or bequest";
}
rule CharitableDeductionDisallowed4948c4(gift: Person, o: Person, y: TaxableYear) defeasible {
    label en official "section 4948(c)(4)(A)-(B)";
    when gift_to_foreign_org_after_notice(gift, o, y);
    when foreign_org_exemption_denied_from(o, y);
    then charitable_deduction_disallowed_4948c4(gift);
}

// ============================================================================
// Section 4959
// ============================================================================

pub relation hospital_org_fails_501r3_for_year(o: Person, y: TaxableYear) kind empirical {
    label en official "section 4959: the hospital organization fails to meet the requirement of section 501(r)(3) (community health needs assessment) for the taxable year";
}
@source(IRC_S4959_NOTE_2, coverage = partial, quote = "Section applicable to failures occurring after Mar. 23, 2010")
pub relation hospital_needs_assessment_failure_tax(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4959: $50,000 on a hospital organization to which section 501(r) applies that fails the section 501(r)(3) requirement for a taxable year";
}
rule HospitalNeedsAssessmentFailureTax(o: Person, y: TaxableYear) defeasible {
    label en official "section 4959";
    when us.irc.exempt_organizations::section_501r_applies(o);
    when hospital_org_fails_501r3_for_year(o, y);
    then hospital_needs_assessment_failure_tax(o, y, HospitalCommunityNeedsFailureTax4959);
}

// ============================================================================
// Section 4942(f): adjusted net income
// ============================================================================

pub relation gross_income_before_modifications_4942f(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(1)(A): the gross income for the taxable year before the paragraph (2) modifications and without capital gains and losses";
}
pub relation tax_exempt_interest_included_4942f2A(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(2)(A): section 103 does not apply — interest on State and local bonds is taken into account";
}
pub relation net_short_term_capital_gain_4942f2B(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(2)(B): capital gains and losses are taken into account only in an amount equal to any net short-term capital gain for the taxable year";
}
pub relation qualifying_distribution_repayments_4942f2Ci(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(2)(C)(i): amounts received or accrued as repayments of amounts taken into account as qualifying distributions (g)(1)(A)";
}
pub relation property_sale_proceeds_previously_qualifying_4942f2Cii(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(2)(C)(ii): amounts received or accrued from the sale of property whose acquisition was taken into account as a qualifying distribution (g)(1)(B)";
}
pub relation set_aside_amount_released_4942f2Ciii(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(2)(C)(iii): any amount set aside under (g)(2) determined not necessary for the purposes for which it was set aside";
}
pub relation allowed_deductions_4942f3(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4942(f)(3): the deductions allowed to a corporation subject to section 11 — only ordinary and necessary expenses for the production or collection of gross income or management of property held for the production of income, plus depreciation and depletion under 4940(c)(3)(B); section 265 does not apply";
}
@source(IRC_S4942_F, coverage = exact, quote = "For purposes of subsection (j), the term \"adjusted net income\" means the excess (if any) of—")
pub relation adjusted_net_income_4942f(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4942(f)(1): gross income with the (2) modifications over the deductions with the (3) modifications";
}
rule AdjustedNetIncome4942f(f: Person, y: TaxableYear, g: Money, ti: Money, st: Money, rp: Money, sp: Money, sa: Money, d: Money) defeasible {
    label en official "section 4942(f)(1)-(3): (gross income + tax-exempt interest + net short-term gain + repayments + prior qualifying property proceeds + released set-asides) − allowed deductions, when positive";
    when gross_income_before_modifications_4942f(f, y, g);
    when tax_exempt_interest_included_4942f2A(f, y, ti);
    when net_short_term_capital_gain_4942f2B(f, y, st);
    when qualifying_distribution_repayments_4942f2Ci(f, y, rp);
    when property_sale_proceeds_previously_qualifying_4942f2Cii(f, y, sp);
    when set_aside_amount_released_4942f2Ciii(f, y, sa);
    when allowed_deductions_4942f3(f, y, d);
    when g + ti + st + rp + sp + sa > d;
    then adjusted_net_income_4942f(f, y, g + ti + st + rp + sp + sa - d);
}
pub relation basis_and_fair_market_value_at_1969(f: Person, prop: Person, actual_basis: Money, fmv_1969: Money) kind empirical {
    label en official "section 4942(f)(4): the basis of property held on December 31, 1969 and continuously thereafter to its disposition, and its fair market value on that date";
}
pub relation basis_for_gain_4942f4(f: Person, prop: Person, amount: Money) kind institutional {
    label en official "section 4942(f)(4): the basis for determining gain is deemed not less than the fair market value on December 31, 1969";
}
rule BasisForGain4942f4(f: Person, prop: Person, b: Money, v: Money) defeasible {
    label en official "section 4942(f)(4): max(basis, fair market value at December 31, 1969)";
    when basis_and_fair_market_value_at_1969(f, prop, b, v);
    then basis_for_gain_4942f4(f, prop, max(b, v));
}

// ============================================================================
// Section 4943 supplements
// ============================================================================

enum EnterpriseKind4943 { Corporation4943; Partnership4943; JointVenture4943; Proprietorship4943; OtherUnincorporated4943; }
pub relation business_enterprise_kind(a: ExciseAct, k: EnterpriseKind4943) kind empirical {
    label en official "section 4943(c)(3): the kind of business enterprise (incorporated, partnership or joint venture, proprietorship, other unincorporated)";
}
pub relation foundation_proprietorship_holds_any_interest(a: ExciseAct) kind empirical {
    label en official "section 4943(c)(3)(B): the foundation holds an interest in a proprietorship";
}
@source(IRC_S4943_C, coverage = exact, quote = "(B) in the case of a proprietorship, there shall be no permitted holdings, and")
pub relation proprietorship_excess_business_holdings(a: ExciseAct) kind institutional {
    label en official "section 4943(c)(3)(B): for a proprietorship there are no permitted holdings, so any holding is excess (the (c)(3)(A) and (C) substitutions of profits/capital/beneficial interest for voting/nonvoting stock are applied by the case: the percentages asserted are the substituted ones)";
}
rule ProprietorshipExcessBusinessHoldings(a: ExciseAct) defeasible {
    label en official "section 4943(c)(3)(B)";
    when business_enterprise_kind(a, Proprietorship4943);
    when foundation_proprietorship_holds_any_interest(a);
    then proprietorship_excess_business_holdings(a);
}
pub relation donor_advised_fund_person_4943e2(p: Person, fund: Person) kind empirical {
    label en official "section 4943(e)(2): a person described in 4966(d)(2)(A)(iii) (donor or advisor), a family member, or a 35-percent controlled entity — a disqualified person of the donor advised fund";
}
pub relation donor_advised_fund_treated_as_private_foundation_4943e(fund: Person) kind empirical {
    label en official "section 4943(e): the donor advised fund is treated as a private foundation for the section 4943 rules similar to (c)(4)-(6), with the enactment date and January 1, 2007 substitutions of (e)(3)";
}
pub relation supporting_org_type_iii_not_functionally_integrated_4943f(o: Person) kind empirical {
    label en official "section 4943(f)(3)(A), (f)(5): a type III supporting organization that is not functionally integrated";
}
pub relation supporting_org_supervised_and_accepts_509f2B_gift(o: Person) kind empirical {
    label en official "section 4943(f)(3)(B): meets 509(a)(3)(A) and (C), is supervised or controlled in connection with 509(a)(1)/(2) organizations, and accepted a gift or contribution from a person described in section 509(f)(2)(B)";
}
@source(IRC_S4943_F, coverage = exact, quote = "An organization is described in this paragraph if such organization is—")
pub relation organization_described_in_4943f3(o: Person) kind institutional {
    label en official "section 4943(f)(3): a non-integrated type III supporting organization, or a section 509(a)(3) organization accepting a 509(f)(2)(B) gift";
}
rule OrganizationDescribedIn4943f3TypeIII(o: Person) defeasible { label en official "4943(f)(3)(A)"; when supporting_org_type_iii_not_functionally_integrated_4943f(o); then organization_described_in_4943f3(o); }
rule OrganizationDescribedIn4943f3Gift(o: Person) defeasible { label en official "4943(f)(3)(B)"; when supporting_org_supervised_and_accepts_509f2B_gift(o); then organization_described_in_4943f3(o); }
pub relation treated_as_private_foundation_4943f1(o: Person) kind institutional {
    label en official "section 4943(f)(1): an organization described in paragraph (3) is treated as a private foundation for section 4943";
}
rule TreatedAsPrivateFoundation4943f1(o: Person) defeasible {
    label en official "section 4943(f)(1)";
    when organization_described_in_4943f3(o);
    then treated_as_private_foundation_4943f1(o);
}
pub relation influence_position_within_5_years_4943f4(p: Person, o: Person) kind empirical {
    label en official "section 4943(f)(4)(A)(i): the person was, at any time during the 5-year period ending on the date described in (a)(2)(A), in a position to exercise substantial influence over the organization";
}
pub relation substantial_contributor_4943f4B(p: Person, o: Person) kind empirical {
    label en official "section 4943(f)(4)(B)(i)-(iii): a substantial contributor, an officer/director/trustee, or a more than 20 percent owner of a substantial contributor";
}
pub relation family_member_of_influential_4943f4(p: Person, q: Person) kind empirical {
    label en official "section 4943(f)(4)(A)(ii): a member of the family (4958(f)(4)) of a person in clause (i)";
}
pub relation controlled_entity_35_of_influential_4943f4(p: Person, o: Person) kind empirical {
    label en official "section 4943(f)(4)(A)(iii): a 35-percent controlled entity of persons described in clause (i) or (ii)";
}
pub relation same_control_or_same_contributors_4943f4(p: Person, o: Person) kind empirical {
    label en official "section 4943(f)(4)(A)(v): an organization effectively controlled by the same persons, or substantially all of whose contributions came from the same persons or their families";
}
@source(IRC_S4943_F, coverage = exact, quote = "In applying this section to any organization described in paragraph (3), the term \"disqualified person\" means, with respect to the organization—")
pub relation disqualified_person_4943f4(p: Person, o: Person) kind institutional {
    label en official "section 4943(f)(4): the disqualified persons of a paragraph (3) organization";
}
rule DisqualifiedPerson4943f4Influence(p: Person, o: Person) defeasible { label en official "4943(f)(4)(A)(i)"; when organization_described_in_4943f3(o); when influence_position_within_5_years_4943f4(p, o); then disqualified_person_4943f4(p, o); }
rule DisqualifiedPerson4943f4Family(p: Person, o: Person, q: Person) defeasible { label en official "4943(f)(4)(A)(ii)"; when organization_described_in_4943f3(o); when influence_position_within_5_years_4943f4(q, o); when family_member_of_influential_4943f4(p, q); then disqualified_person_4943f4(p, o); }
rule DisqualifiedPerson4943f4Entity(p: Person, o: Person) defeasible { label en official "4943(f)(4)(A)(iii)"; when organization_described_in_4943f3(o); when controlled_entity_35_of_influential_4943f4(p, o); then disqualified_person_4943f4(p, o); }
rule DisqualifiedPerson4943f4Contributor(p: Person, o: Person) defeasible { label en official "4943(f)(4)(A)(iv): a person described in 4958(c)(3)(B) (substantial contributor, family, 35 percent entity)"; when organization_described_in_4943f3(o); when substantial_contributor_4943f4B(p, o); then disqualified_person_4943f4(p, o); }
rule DisqualifiedPerson4943f4RelatedOrganization(p: Person, o: Person) defeasible { label en official "4943(f)(4)(A)(v)"; when organization_described_in_4943f3(o); when same_control_or_same_contributors_4943f4(p, o); then disqualified_person_4943f4(p, o); }
pub relation holdings_of_type_iii_held_for_community_since_2005(a: ExciseAct) kind empirical {
    label en official "section 4943(f)(6): as of November 18, 2005, and at all times thereafter, the type III supporting organization's holdings were held for the benefit of the community pursuant to the direction of a State attorney general or State official";
}
@source(IRC_S4943_F, coverage = exact, quote = "the term \"excess business holdings\" shall not include any holdings of a type III supporting organization in any business enterprise if, as of November 18, 2005, the holdings were held (and at all times thereafter, are held) for the benefit of the community pursuant to the direction of a State attorney general or a State official with jurisdiction over such organization.")
pub relation excess_holdings_excluded_4943f6(a: ExciseAct) kind institutional {
    label en official "section 4943(f)(6): holdings held for the community since November 18, 2005 under a State official's direction are not excess business holdings";
}
rule ExcessHoldingsExcluded4943f6(a: ExciseAct, f: Person) defeasible {
    label en official "section 4943(f)(6)";
    when excess_business_holdings_foundation(a, f);
    when supporting_org_type_iii_not_functionally_integrated_4943f(f);
    when holdings_of_type_iii_held_for_community_since_2005(a);
    then excess_holdings_excluded_4943f6(a);
}
pub relation secretary_exempts_excess_holdings_4943f2(a: ExciseAct) kind empirical {
    label en official "section 4943(f)(2): the Secretary exempts the excess business holdings of the organization because they are consistent with its section 501 exempt purpose";
}
// (g): the philanthropic business holdings exemption.
pub relation foundation_holds_all_voting_stock_all_year(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(2)(A): 100 percent of the voting stock in the business enterprise is held by the private foundation at all times during the taxable year";
}
pub relation all_interests_acquired_other_than_by_purchase(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(2)(B): all the foundation's ownership interests in the enterprise were acquired by means other than purchase";
}
pub relation taxable_year_close_of_business_enterprise(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4943(g)(3): the close of the taxable year of the enterprise";
}
pub relation net_operating_income_distributed_on(a: ExciseAct, amount: Money, on: Date) kind empirical {
    label en official "section 4943(g)(3): an amount distributed by the enterprise to the foundation on this date";
}
pub relation enterprise_net_operating_income(a: ExciseAct, amount: Money) kind empirical {
    label en official "section 4943(g)(3)(B): gross income less directly connected deductions, chapter 1 tax and a reasonable working capital reserve";
}
pub relation net_operating_income_distributed_within_120_days(a: ExciseAct) kind institutional {
    label en official "section 4943(g)(3)(A): the enterprise distributes an amount equal to its net operating income to the foundation not later than 120 days after the close of the taxable year";
}
rule NetOperatingIncomeDistributedWithin120Days(a: ExciseAct, close: Date, amt: Money, noi: Money, on: Date) defeasible {
    label en official "section 4943(g)(3)";
    when taxable_year_close_of_business_enterprise(a, close);
    when enterprise_net_operating_income(a, noi);
    when net_operating_income_distributed_on(a, amt, on);
    when amt >= noi;
    when on <= add_calendar_period(close, 120 calendar_day);
    then net_operating_income_distributed_within_120_days(a);
}
pub relation contributor_or_family_serves_in_enterprise(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(4)(A): a substantial contributor or family member is a director, officer, trustee, manager, employee or contractor of the enterprise (at any time during the year)";
}
pub relation board_majority_independent_of_enterprise_and_contributors(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(4)(B): at least a majority of the foundation's board are not directors or officers of the enterprise and not family members of a substantial contributor (at all times during the year)";
}
pub relation loan_outstanding_to_contributor_or_family(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(4)(C): a loan is outstanding from the enterprise to a substantial contributor or a family member";
}
pub relation independence_requirements_met_4943g4(a: ExciseAct) kind institutional {
    label en official "section 4943(g)(4): no contributor or family member in the enterprise, an independent board majority, and no loan to a contributor or family member";
}
rule IndependenceRequirementsMet4943g4(a: ExciseAct) defeasible {
    label en official "section 4943(g)(4)(A)-(C)";
    when board_majority_independent_of_enterprise_and_contributors(a);
    unless contributor_or_family_serves_in_enterprise(a) and board_majority_independent_of_enterprise_and_contributors(a);
    unless loan_outstanding_to_contributor_or_family(a) and board_majority_independent_of_enterprise_and_contributors(a);
    then independence_requirements_met_4943g4(a);
}
pub relation trust_or_treated_foundation_outside_4943g(a: ExciseAct) kind empirical {
    label en official "section 4943(g)(5): the holder is a fund or organization treated as a private foundation by (e) or (f), a 4947(a)(1) charitable trust, or a 4947(a)(2) split-interest trust — subsection (g) does not apply";
}
@source(IRC_S4943_G, coverage = exact, quote = "Subsection (a) shall not apply with respect to the holdings of a private foundation in any business enterprise which meets the requirements of paragraphs (2), (3), and (4) for the taxable year.")
pub relation philanthropic_business_exemption_4943g(a: ExciseAct) kind institutional {
    label en official "section 4943(g)(1): the holdings of a private foundation in an enterprise meeting (g)(2), (3) and (4) are outside subsection (a)";
}
rule PhilanthropicBusinessExemption4943g(a: ExciseAct) defeasible {
    label en official "section 4943(g)(1)-(5)";
    when foundation_holds_all_voting_stock_all_year(a);
    when all_interests_acquired_other_than_by_purchase(a);
    when net_operating_income_distributed_within_120_days(a);
    when independence_requirements_met_4943g4(a);
    unless trust_or_treated_foundation_outside_4943g(a) and independence_requirements_met_4943g4(a);
    then philanthropic_business_exemption_4943g(a);
}
pub relation excess_holdings_of_split_interest_trust_exempt(a: ExciseAct) kind institutional {
    label en official "section 4947(b)(3): the holder is a split-interest trust exempt from 4943 and 4944";
}
rule ExcessHoldingsOfSplitInterestTrustExempt(a: ExciseAct, f: Person) defeasible {
    label en official "section 4947(b)(3)";
    when excess_business_holdings_foundation(a, f);
    when split_interest_trust_exempt_from_4943_and_4944(f);
    then excess_holdings_of_split_interest_trust_exempt(a);
}
// the tax rules of 08-excess-business-holdings-4943.law consult these exclusions through `excess_holdings_are_outside_4943`.
pub relation excess_holdings_are_outside_4943(a: ExciseAct) kind institutional {
    label en official "sections 4943(f)(2), (f)(6), (g), 4947(b)(3): the holdings are exempt, excluded or outside the tax";
}
rule OutsideBy4943g(a: ExciseAct) defeasible { label en official "4943(g)"; when philanthropic_business_exemption_4943g(a); then excess_holdings_are_outside_4943(a); }
rule OutsideBy4943f6(a: ExciseAct) defeasible { label en official "4943(f)(6)"; when excess_holdings_excluded_4943f6(a); then excess_holdings_are_outside_4943(a); }
rule OutsideBy4943f2(a: ExciseAct) defeasible { label en official "4943(f)(2)"; when secretary_exempts_excess_holdings_4943f2(a); then excess_holdings_are_outside_4943(a); }
rule OutsideBy4947b3(a: ExciseAct) defeasible { label en official "4947(b)(3)"; when excess_holdings_of_split_interest_trust_exempt(a); then excess_holdings_are_outside_4943(a); }

// ============================================================================
// Section 4945 supplements
// ============================================================================

pub relation expenditure_communication(a: ExciseAct, c: LobbyingCommunication) kind empirical {
    label en unofficial "the communication the expenditure paid for (section 4945(e))";
}
@source(IRC_S4945_E, coverage = exact, quote = "For purposes of subsection (d)(1), the term \"taxable expenditure\" means any amount paid or incurred by a private foundation for—")
pub relation lobbying_attempt_4945e(c: LobbyingCommunication) kind institutional {
    label en official "section 4945(e): an attempt to influence legislation through the general public, or through communication with legislators or participating officials (except technical advice on a written request), other than nonpartisan analysis, study or research; the (2) limb does not reach self-defense appearances";
}
rule LobbyingAttemptPublic4945e(c: LobbyingCommunication) defeasible {
    label en official "section 4945(e)(1)";
    when attempts_to_affect_opinions_of_public(c);
    unless is_nonpartisan_analysis(c) and attempts_to_affect_opinions_of_public(c);
    then lobbying_attempt_4945e(c);
}
rule LobbyingAttemptDirect4945e(c: LobbyingCommunication) defeasible {
    label en official "section 4945(e)(2)";
    when communicates_with_legislator_or_participating_official(c);
    unless is_technical_advice_on_written_request(c) and communicates_with_legislator_or_participating_official(c);
    unless is_nonpartisan_analysis(c) and communicates_with_legislator_or_participating_official(c);
    unless is_self_defense_communication(c) and communicates_with_legislator_or_participating_official(c);
    then lobbying_attempt_4945e(c);
}
rule TaxableExpenditureLobbyingDerived(a: ExciseAct, c: LobbyingCommunication, f: Person) defeasible {
    label en official "section 4945(d)(1): an amount paid or incurred by a private foundation to influence legislation within the meaning of (e) is a taxable expenditure";
    when excise_act_kind(a, TaxableExpenditure);
    when taxable_expenditure_foundation(a, f);
    when expenditure_communication(a, c);
    when lobbying_attempt_4945e(c);
    then taxable_expenditure(a);
}
// (d)(4): grants to organizations.
pub relation grant_to_organization_4945(a: ExciseAct, org: Person) kind empirical {
    label en official "section 4945(d)(4): the expenditure is a grant to an organization";
}
pub relation grantee_described_in_509a1_or_2(org: Person) kind empirical {
    label en official "section 4945(d)(4)(A)(i): the grantee is described in section 509(a)(1) or (2)";
}
pub relation grantee_509a3_other_than_4942g4A(org: Person) kind empirical {
    label en official "section 4945(d)(4)(A)(ii): the grantee is a 509(a)(3) organization other than one described in 4942(g)(4)(A)(i) or (ii)";
}
pub relation grantee_exempt_operating_foundation(org: Person) kind empirical {
    label en official "section 4945(d)(4)(A)(iii): the grantee is an exempt operating foundation (section 4940(d)(2))";
}
pub relation grantee_meets_voter_registration_requirements_4945f(org: Person) kind empirical {
    label en official "section 4945(f): the grantee meets the (f) requirements, so (d)(4) does not apply to the grant";
}
pub relation expenditure_responsibility_exercised_4945h(a: ExciseAct) kind empirical {
    label en official "section 4945(d)(4)(B), (h): the private foundation exercises expenditure responsibility with respect to the grant";
}
pub relation grant_organization_requirements_met(a: ExciseAct, org: Person) kind institutional {
    label en official "section 4945(d)(4): the grant to an organization is not taxable because the grantee is a (d)(4)(A) organization, the grant is under expenditure responsibility, or the grantee meets (f)";
}
rule GrantRequirementsMetGrantee1(a: ExciseAct, org: Person) defeasible { label en official "4945(d)(4)(A)(i)"; when grant_to_organization_4945(a, org); when grantee_described_in_509a1_or_2(org); then grant_organization_requirements_met(a, org); }
rule GrantRequirementsMetGrantee2(a: ExciseAct, org: Person) defeasible { label en official "4945(d)(4)(A)(ii)"; when grant_to_organization_4945(a, org); when grantee_509a3_other_than_4942g4A(org); then grant_organization_requirements_met(a, org); }
rule GrantRequirementsMetGrantee3(a: ExciseAct, org: Person) defeasible { label en official "4945(d)(4)(A)(iii)"; when grant_to_organization_4945(a, org); when grantee_exempt_operating_foundation(org); then grant_organization_requirements_met(a, org); }
rule GrantRequirementsMetResponsibility(a: ExciseAct, org: Person) defeasible { label en official "4945(d)(4)(B)"; when grant_to_organization_4945(a, org); when expenditure_responsibility_exercised_4945h(a); then grant_organization_requirements_met(a, org); }
rule GrantRequirementsMetVoterRegistrationOrganization(a: ExciseAct, org: Person) defeasible { label en official "4945(f)"; when grant_to_organization_4945(a, org); when grantee_meets_voter_registration_requirements_4945f(org); then grant_organization_requirements_met(a, org); }
rule TaxableExpenditureGrantToOrganization(a: ExciseAct, org: Person, f: Person) defeasible {
    label en official "section 4945(d)(4): a grant to an organization is a taxable expenditure unless the grantee is a (d)(4)(A) organization or expenditure responsibility is exercised";
    when excise_act_kind(a, TaxableExpenditure);
    when taxable_expenditure_foundation(a, f);
    when grant_to_organization_4945(a, org);
    unless grant_organization_requirements_met(a, org) and taxable_expenditure_foundation(a, f) and grant_to_organization_4945(a, org);
    unless grant_excepted_from_4945d4_and_h_note7_5(a) and taxable_expenditure_foundation(a, f) and grant_to_organization_4945(a, org);  // Stage 4: note 7(5), 38-*.law
    then taxable_expenditure(a);
}
// (f): voter registration drives by qualifying organizations.
pub relation org_described_501c3_and_exempt(org: Person) kind empirical {
    label en official "section 4945(f)(1): the organization is described in section 501(c)(3) and exempt under 501(a)";
}
pub relation org_activities_nonpartisan_5_states(org: Person) kind empirical {
    label en official "section 4945(f)(2): the activities are nonpartisan, not confined to one specific election period, and carried on in 5 or more States";
}
pub relation org_income_expended_directly_for_purpose(org: Person) kind empirical {
    label en official "section 4945(f)(3): substantially all of its income is expended directly for the active conduct of its purpose or function";
}
pub relation org_support_from_exempt_public_govt_with_25_percent_limit(org: Person) kind empirical {
    label en official "section 4945(f)(4): substantially all support (other than gross investment income) from exempt organizations, the public or governmental units, not more than 25 percent from any one exempt organization, and not more than half from gross investment income — measured over the year and the preceding 4 taxable years";
}
pub relation org_voter_contributions_not_restricted(org: Person) kind empirical {
    label en official "section 4945(f)(5): contributions for voter registration drives are not conditioned on use only in specified States, areas or one specific election period";
}
@source(IRC_S4945_F, coverage = exact, quote = "Subsection (d)(2) shall not apply to any amount paid or incurred by any organization—")
pub relation voter_registration_organization_4945f(org: Person) kind institutional {
    label en official "section 4945(f): an organization meeting all five requirements";
}
rule VoterRegistrationOrganization4945f(org: Person) defeasible {
    label en official "section 4945(f)(1)-(5)";
    when org_described_501c3_and_exempt(org);
    when org_activities_nonpartisan_5_states(org);
    when org_income_expended_directly_for_purpose(org);
    when org_support_from_exempt_public_govt_with_25_percent_limit(org);
    when org_voter_contributions_not_restricted(org);
    then voter_registration_organization_4945f(org);
}
rule GranteeMeetsVoterRegistrationRequirements(org: Person) defeasible {
    label en official "section 4945(f): the last sentence — (d)(4) does not apply to a grant to an organization meeting (f)";
    when voter_registration_organization_4945f(org);
    then grantee_meets_voter_registration_requirements_4945f(org);
}
// (g): individual grants.
pub relation grant_to_individual_4945(a: ExciseAct) kind empirical {
    label en official "section 4945(d)(3): a grant to an individual for travel, study, or other similar purposes by that individual";
}
external judgment relation individual_grant_objective_nondiscriminatory_procedure_approved(a: ExciseAct) {
    authority Secretary;
    label en official "section 4945(g): the grant is awarded on an objective and nondiscriminatory basis pursuant to a procedure approved in advance by the Secretary, demonstrated to the satisfaction of the Secretary";
}
pub relation individual_grant_is_scholarship_prize_or_specific_objective(a: ExciseAct) kind empirical {
    label en official "section 4945(g)(1)-(3): the grant is (1) a scholarship or fellowship (former 117(a)) for study at a 170(b)(1)(A)(ii) organization, (2) a prize or award under 74(b) to a recipient selected from the general public, or (3) for a specific objective, a report, or to improve a capacity, skill or talent";
}
@source(IRC_S4945_G, coverage = exact, quote = "Subsection (d)(3) shall not apply to an individual grant awarded on an objective and nondiscriminatory basis pursuant to a procedure approved in advance by the Secretary")
pub relation individual_grant_requirements_met_4945g(a: ExciseAct) kind institutional {
    label en official "section 4945(g): the grant meets the objective procedure requirement and one of the three purposes";
}
rule IndividualGrantRequirementsMet4945g(a: ExciseAct) defeasible {
    label en official "section 4945(g)(1)-(3)";
    when individual_grant_objective_nondiscriminatory_procedure_approved(a);
    when individual_grant_is_scholarship_prize_or_specific_objective(a);
    then individual_grant_requirements_met_4945g(a);
}
rule TaxableExpenditureIndividualGrant(a: ExciseAct, f: Person) defeasible {
    label en official "section 4945(d)(3): a grant to an individual for travel or study is a taxable expenditure unless it satisfies (g)";
    when excise_act_kind(a, TaxableExpenditure);
    when taxable_expenditure_foundation(a, f);
    when grant_to_individual_4945(a);
    unless individual_grant_requirements_met_4945g(a) and taxable_expenditure_foundation(a, f) and grant_to_individual_4945(a);
    then taxable_expenditure(a);
}
// (h): expenditure responsibility — the foundation's duties.
pub relation grant_spent_solely_for_purpose(a: ExciseAct) kind empirical {
    label en official "section 4945(h)(1): the grant is spent solely for the purpose for which it was made";
}
pub relation full_reports_obtained_from_grantee(a: ExciseAct) kind empirical {
    label en official "section 4945(h)(2): the foundation obtained full and complete reports from the grantee on how the funds are spent";
}
pub relation detailed_reports_made_to_secretary(a: ExciseAct) kind empirical {
    label en official "section 4945(h)(3): the foundation made full and detailed reports with respect to the expenditures to the Secretary";
}
@source(IRC_S4945_H, coverage = exact, quote = "(1) to see that the grant is spent solely for the purpose for which made,")
rule S4945hSeeGrantSpentDutyRule(a: ExciseAct, f: Person) defeasible {
    label en official "section 4945(h)(1): the foundation exercising expenditure responsibility is responsible to exert all reasonable efforts to see that the grant is spent solely for its purpose";
    when expenditure_responsibility_exercised_4945h(a);
    when taxable_expenditure_foundation(a, f);
    unless grant_excepted_from_4945d4_and_h_note7_5(a) and expenditure_responsibility_exercised_4945h(a) and taxable_expenditure_foundation(a, f);  // Stage 4: note 7(5)
    then duty S4945hSeeGrantSpentSolelyForPurpose {
        bearer f;
        goal maintenance {
            condition grant_spent_solely_for_purpose(a);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S4945_H, coverage = exact, quote = "(2) to obtain full and complete reports from the grantee on how the funds are spent, and")
rule S4945hObtainReportsDutyRule(a: ExciseAct, f: Person) defeasible {
    label en official "section 4945(h)(2): the foundation shall obtain full and complete reports from the grantee";
    when expenditure_responsibility_exercised_4945h(a);
    when taxable_expenditure_foundation(a, f);
    unless grant_excepted_from_4945d4_and_h_note7_5(a) and expenditure_responsibility_exercised_4945h(a) and taxable_expenditure_foundation(a, f);  // Stage 4: note 7(5)
    then duty S4945hObtainGranteeReports {
        bearer f;
        goal achievement {
            condition full_reports_obtained_from_grantee(a);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S4945_H, coverage = exact, quote = "(3) to make full and detailed reports with respect to such expenditures to the Secretary.")
rule S4945hReportToSecretaryDutyRule(a: ExciseAct, f: Person) defeasible {
    label en official "section 4945(h)(3): the foundation shall make full and detailed reports on the expenditures to the Secretary";
    when expenditure_responsibility_exercised_4945h(a);
    when taxable_expenditure_foundation(a, f);
    unless grant_excepted_from_4945d4_and_h_note7_5(a) and expenditure_responsibility_exercised_4945h(a) and taxable_expenditure_foundation(a, f);  // Stage 4: note 7(5)
    then duty S4945hReportToSecretary {
        bearer f;
        beneficiary us.irc.core::Secretary;
        goal achievement {
            condition detailed_reports_made_to_secretary(a);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// Section 4958 supplements
// ============================================================================

pub relation category_a_person_4958(q: Person, org: Person, a: ExciseAct) kind institutional {
    label en official "section 4958(f)(1)(A): a person in a position to exercise substantial influence over the organization at any time in the 5 years ending on the transaction date";
}
rule CategoryAPerson4958(q: Person, org: Person, a: ExciseAct, transaction_on: Date, held_on: Date, calendar_before_1: Date) defeasible {
    label en official "section 4958(f)(1)(A)";
    when excess_benefit_transaction_date(a, transaction_on);
    when position_of_substantial_influence_on(q, org, held_on);
    when held_on <= transaction_on;
    when held_on >= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(transaction_on, 5, us.irc.core::CalendarYear, calendar_before_1);
    then category_a_person_4958(q, org, a);
}
pub relation sibling_or_sibling_spouse_of(p: Person, q: Person) kind empirical {
    label en official "section 4958(f)(4): a brother or sister (whole or half blood) of the individual, or their spouse";
}
pub relation family_member_4958(p: Person, q: Person) kind institutional {
    label en official "section 4958(f)(4): the members of an individual's family under section 4946(d) plus brothers and sisters (whole or half blood) and their spouses";
}
rule FamilyMember4958Base(p: Person, q: Person) defeasible { label en official "4958(f)(4): section 4946(d) family"; when member_of_family(p, q); then family_member_4958(p, q); }
rule FamilyMember4958Siblings(p: Person, q: Person) defeasible { label en official "4958(f)(4): siblings and their spouses"; when sibling_or_sibling_spouse_of(p, q); then family_member_4958(p, q); }
@source(IRC_S4958_F, coverage = exact, quote = "a member of the family of an individual described in subparagraph (A),")
rule DisqualifiedPerson4958Family(p: Person, org: Person, a: ExciseAct, q: Person) defeasible {
    label en official "section 4958(f)(1)(B): a family member of a category (A) person";
    when category_a_person_4958(q, org, a);
    when family_member_4958(p, q);
    then disqualified_person_4958(p, org, a);
}
pub relation combined_ownership_by_a_or_b_persons(e: Person, org: Person, a: ExciseAct, share: Decimal) kind empirical {
    label en official "section 4958(f)(3)(A): the share of the corporation's voting power, the partnership's profits interest, or the trust or estate's beneficial interest owned by category (A) or (B) persons (constructive ownership by rules similar to 4946(a)(3)-(4))";
}
@source(IRC_S4958_F, coverage = exact, quote = "a 35-percent controlled entity,")
rule DisqualifiedPerson4958ControlledEntity(e: Person, org: Person, a: ExciseAct, share: Decimal) defeasible {
    label en official "section 4958(f)(1)(C), (f)(3)(A): an entity more than 35 percent owned by category (A) or (B) persons";
    when combined_ownership_for_controlled_entity_4958(e, org, a, share);
    when share > ControlledEntityShare4958;
    then disqualified_person_4958(e, org, a);
}
pub relation disqualified_wrt_supporting_organization_4958(p: Person, org: Person, a: ExciseAct) kind empirical {
    label en official "section 4958(f)(1)(D): the person is described in (A), (B) or (C) with respect to a 509(a)(3) organization organized and operated exclusively for the benefit of, to perform the functions of, or to carry out the purposes of the applicable tax-exempt organization";
}
@source(IRC_S4958_F, coverage = exact, quote = "any person who is described in subparagraph (A), (B), or (C) with respect to an organization described in section 509(a)(3)")
rule DisqualifiedPerson4958ViaSupportingOrganization(p: Person, org: Person, a: ExciseAct) defeasible {
    label en official "section 4958(f)(1)(D)";
    when disqualified_wrt_supporting_organization_4958(p, org, a);
    then disqualified_person_4958(p, org, a);
}
pub relation transaction_involves_donor_advised_fund(a: ExciseAct, fund: Person) kind empirical {
    label en official "section 4958(f)(1)(E): the transaction involves a donor advised fund";
}
@source(IRC_S4958_F, coverage = exact, quote = "which involves a donor advised fund (as defined in section 4966(d)(2)), any person who is described in paragraph (7) with respect to such donor advised fund")
rule DisqualifiedPerson4958DonorAdvisedFund(p: Person, org: Person, a: ExciseAct, fund: Person) defeasible {
    label en official "section 4958(f)(1)(E), (f)(7): a donor, donor advisor, family member or 35-percent controlled entity of a donor advised fund";
    when excess_benefit_organization(a, org);
    when transaction_involves_donor_advised_fund(a, fund);
    when person_described_in_4958f7_for_daf(p, fund);
    then disqualified_person_4958(p, org, a);
}
pub relation transaction_involves_sponsoring_organization(a: ExciseAct, sponsor: Person) kind empirical {
    label en official "section 4958(f)(1)(F): the transaction involves a sponsoring organization (4966(d)(1))";
}
pub relation investment_advisor_of_sponsor(p: Person, sponsor: Person) kind institutional {
    label en official "section 4958(f)(8)(B): any person (other than an employee) compensated by the sponsoring organization for managing the investment of, or advising on, assets maintained in its donor advised funds";
}
pub relation person_described_in_4958f8(p: Person, sponsor: Person) kind institutional {
    label en official "section 4958(f)(8): an investment advisor, a family member of one, or a 35-percent controlled entity of such persons";
}
rule PersonDescribedIn4958f8Advisor(p: Person, sponsor: Person) defeasible { label en official "4958(f)(8)(A)(i)"; when investment_advisor_of_sponsor(p, sponsor); then person_described_in_4958f8(p, sponsor); }
rule PersonDescribedIn4958f8Family(p: Person, sponsor: Person, q: Person) defeasible { label en official "4958(f)(8)(A)(ii)"; when investment_advisor_of_sponsor(q, sponsor); when family_member_4958(p, q); then person_described_in_4958f8(p, sponsor); }
@source(IRC_S4958_F, coverage = exact, quote = "which involves a sponsoring organization (as defined in section 4966(d)(1)), any person who is described in paragraph (8) with respect to such sponsoring organization")
rule DisqualifiedPerson4958SponsoringOrganization(p: Person, org: Person, a: ExciseAct, sponsor: Person) defeasible {
    label en official "section 4958(f)(1)(F), (f)(8)";
    when excess_benefit_organization(a, org);
    when transaction_involves_sponsoring_organization(a, sponsor);
    when person_described_in_4958f8(p, sponsor);
    then disqualified_person_4958(p, org, a);
}
// (c)(2): donor advised fund payments; (c)(3): supporting organizations.
pub relation daf_payment_to_f7_person(a: ExciseAct, fund: Person, p: Person, amount: Money) kind empirical {
    label en official "section 4958(c)(2)(A): a grant, loan, compensation or other similar payment from the donor advised fund to a person described in (f)(7)";
}
@source(IRC_S4958_C, coverage = exact, quote = "the term \"excess benefit transaction\" includes any grant, loan, compensation, or other similar payment from such fund to a person described in subsection (f)(7) with respect to such fund")
rule DafPaymentIsExcessBenefitTransaction(a: ExciseAct, fund: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(2): a payment from a donor advised fund to a (f)(7) person is an excess benefit transaction and the excess benefit is the whole payment";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when daf_payment_to_f7_person(a, fund, p, amt);
    then excess_benefit_transaction(a);
}
rule DafPaymentIsExcessBenefitAmount(a: ExciseAct, fund: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(2)(B): the excess benefit includes the amount of the payment";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when daf_payment_to_f7_person(a, fund, p, amt);
    then excess_benefit_amount(a, amt);
}
pub relation aggregate_contributions_of_person(p: Person, org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4958(c)(3)(C)(i): the amount the person contributed or bequeathed to the organization in the aggregate";
}
pub relation total_contributions_received_by_org(org: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4958(c)(3)(C)(i): the total contributions and bequests received before the close of the taxable year of the organization in which the contribution is received";
}
pub relation contributor_is_excepted_organization_4958c3Cii(p: Person, org: Person) kind institutional {
    label en official "section 4958(c)(3)(C)(ii): a 509(a)(1), (2) or (4) organization, or a supported organization treated as a 509(a)(2) organization";
}
pub relation trust_creator_of(p: Person, org: Person) kind empirical {
    label en official "section 4958(c)(3)(C)(i): in the case of a trust, the creator of the trust";
}
@source(IRC_S4958_C, coverage = exact, quote = "The term \"substantial contributor\" means any person who contributed or bequeathed an aggregate amount of more than $5,000 to the organization, if such amount is more than 2 percent of the total contributions and bequests received by the organization")
pub relation substantial_contributor_4958c3C(p: Person, org: Person) kind institutional {
    label en official "section 4958(c)(3)(C): more than $5,000 and more than 2 percent of total contributions, or the creator of a trust, other than the excepted organizations";
}
rule SubstantialContributor4958c3C(p: Person, org: Person, y: TaxableYear, amt: Money, total: Money) defeasible {
    label en official "section 4958(c)(3)(C)(i)";
    when aggregate_contributions_of_person(p, org, y, amt);
    when total_contributions_received_by_org(org, y, total);
    when amt > SupportingOrganizationSubstantialContributorAmount4958;
    when amt > total * SupportingOrganizationSubstantialContributorShare4958;
    unless contributor_is_excepted_organization_4958c3Cii(p, org) and aggregate_contributions_of_person(p, org, y, amt) and total_contributions_received_by_org(org, y, total);
    then substantial_contributor_4958c3C(p, org);
}
rule SubstantialContributor4958c3CTrustCreator(p: Person, org: Person) defeasible {
    label en official "section 4958(c)(3)(C)(i): the creator of a trust";
    when trust_creator_of(p, org);
    then substantial_contributor_4958c3C(p, org);
}
pub relation supporting_org_payment_to_contributor_group(a: ExciseAct, org: Person, p: Person, amount: Money) kind empirical {
    label en official "section 4958(c)(3)(A)(i)(I), (B): a grant, loan, compensation or similar payment by a 509(a)(3) organization to a substantial contributor, a family member, or a 35-percent controlled entity";
}
pub relation supporting_org_loan_to_disqualified_person(a: ExciseAct, org: Person, p: Person, amount: Money) kind empirical {
    label en official "section 4958(c)(3)(A)(i)(II): any loan provided by the 509(a)(3) organization to a disqualified person (other than an organization described in (C)(ii))";
}
@source(IRC_S4958_C, coverage = exact, quote = "the term \"excess benefit transaction\" includes—")
rule SupportingOrgPaymentIsExcessBenefitTransaction(a: ExciseAct, org: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(3)(A)(i)(I): a payment by a supporting organization to a (B) person is an excess benefit transaction, for the whole payment";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when supporting_org_payment_to_contributor_group(a, org, p, amt);
    then excess_benefit_transaction(a);
}
rule SupportingOrgPaymentIsExcessBenefitAmount(a: ExciseAct, org: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(3)(A)(ii): the excess benefit includes the amount of the payment";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when supporting_org_payment_to_contributor_group(a, org, p, amt);
    then excess_benefit_amount(a, amt);
}
rule SupportingOrgLoanIsExcessBenefitTransaction(a: ExciseAct, org: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(3)(A)(i)(II): a loan by a supporting organization to a disqualified person is an excess benefit transaction";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when supporting_org_loan_to_disqualified_person(a, org, p, amt);
    then excess_benefit_transaction(a);
}
rule SupportingOrgLoanIsExcessBenefitAmount(a: ExciseAct, org: Person, p: Person, amt: Money) defeasible {
    label en official "section 4958(c)(3)(A)(ii): the excess benefit includes the amount of the loan";
    when excise_act_kind(a, ExcessBenefitTransaction);
    when supporting_org_loan_to_disqualified_person(a, org, p, amt);
    then excess_benefit_amount(a, amt);
}
