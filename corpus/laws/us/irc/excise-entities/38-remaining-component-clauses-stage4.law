// Stage 4 (26.09.2026): the last technical-gap rows of the excise package that can be stated over EMPIRICAL relations or with
// day counts: the special note 7(3)(F) treatment of a note 7(4)(A) organization (G5914), the exclusion of a note 7(3)(C) grant
// from section 4945(d)(4) and (h) (G5916), the section 4942(g)(2)(E) adjustment period as a bounded unrolling (G5907), the
// section 4961(c)(3) suspension by day counts (G5912), the section 4980(d)(5)(E) controlled-group participation count (G5908),
// the section 4980B(c)(3)(B) family maximum by day (G5911) and the section 5000A(d)(2)(A)(ii) service classification (G5913).
// Status: implemented_unverified; scenarios not executed; no legal review. Bounded readings are stated in each label.

// --- note 7(3)(F) under section 4940: the note 7(4)(A) organization and the special distributable amount ---

use self::{
    CobraQualifyingEvent,
    DistributionPayment,
    ExciseAct,
    IRC_S4940_NOTE_7,
    IRC_S4942_G,
    IRC_S4946_A,
    IRC_S4961_C,
    IRC_S4980B_C,
    IRC_S4980_D,
    IRC_S5000A_D,
    Person,
    PlanReversion,
    TaxableYear,
    distributable_amount,
    incorporated_before_1951_01_01,
    more_than_90_percent_stock_of_regulated_enterprise_on_1969_05_26,
    replacement_participation_95_percent_met,
    required_cash_distribution_4942g2B,
    stock_acquired_solely_by_gift_devise_or_bequest,
    substantial_contributor,
    subtitle_a_and_4940_tax_for_year,
    transition_grant_treated_as_to_operating_foundation,
    twenty_percent_corporate_owner_of_substantial_contributor,
    undistributed_income_acquisition_indebtedness,
    undistributed_income_foundation,
    undistributed_income_non_exempt_use_asset_value,
    year_distributable_amount_without_i,
};

pub relation foundation_described_in_note7_4A(f: Person) kind institutional {
    label en official "note 7(4)(A): a private foundation incorporated before January 1, 1951, substantially all of whose assets on May 26, 1969 are more than 90 percent of the stock of a regulated enterprise, acquired solely by gift, devise or bequest (clauses (i)-(iii); the (B) conditions are not required for note 7(3)(F))";
}
rule FoundationDescribedInNote7_4A(f: Person) defeasible {
    label en official "note 7(4)(A)(i)-(iii)";
    when incorporated_before_1951_01_01(f);
    when more_than_90_percent_stock_of_regulated_enterprise_on_1969_05_26(f);
    when stock_acquired_solely_by_gift_devise_or_bequest(f);
    then foundation_described_in_note7_4A(f);
}
pub relation act_uses_note7_3F_special_stock_treatment(a: ExciseAct) kind institutional {
    label en official "note 7(3)(F): section 4942 is applied to the act's foundation, an organization described in paragraph (4)(A), without the special stock";
}
rule ActUsesNote7_3F(a: ExciseAct, f: Person) defeasible {
    label en official "note 7(3)(F)";
    when undistributed_income_foundation(a, f);
    when foundation_described_in_note7_4A(f);
    then act_uses_note7_3F_special_stock_treatment(a);
}
pub relation special_stock_fair_market_value_note7_4A(a: ExciseAct, amount: Money) kind empirical {
    label en official "note 7(3)(F)(i): the fair market value, within the non-exempt-use assets, of the stock to which paragraph (4)(A)(ii) applies";
}
pub relation special_stock_dividend_income_note7_4A(a: ExciseAct, amount: Money) kind empirical {
    label en official "note 7(3)(F)(ii)-(iii): the dividend income from that stock";
}
pub relation minimum_investment_return_without_special_stock_note7_3Fi(a: ExciseAct, amount: Money) kind institutional {
    label en official "note 7(3)(F)(i): section 4942(e) applied without regard to the special stock: 5 percent of (non-exempt-use assets other than the stock minus acquisition indebtedness). JUDGMENT CALL: the whole acquisition indebtedness is attributed to the other assets";
}
@source(IRC_S4940_NOTE_7, quote = "(i) by applying section 4942(e) without regard to the stock to which paragraph (4)(A)(ii) of this subsection applies,")
rule MinimumInvestmentReturnWithoutSpecialStock(a: ExciseAct, fmv: Money, stock: Money, debt: Money) defeasible {
    label en official "note 7(3)(F)(i)";
    when act_uses_note7_3F_special_stock_treatment(a);
    when undistributed_income_non_exempt_use_asset_value(a, fmv);
    when special_stock_fair_market_value_note7_4A(a, stock);
    when undistributed_income_acquisition_indebtedness(a, debt);
    when fmv - stock > debt;
    then minimum_investment_return_without_special_stock_note7_3Fi(a, (fmv - stock - debt) * MinimumInvestmentReturnRate);
}
@source(IRC_S4940_NOTE_7, quote = "(ii) by applying section 4942(f) without regard to dividend income for such stock, and")
@source(IRC_S4940_NOTE_7, quote = "(iii) by defining the distributable amount as the sum of the amount determined under section 4942(d) (after the application of clauses (i) and (ii)), and the amount of the dividend income from such stock.")
rule DistributableAmountNote7_3FAboveTaxes(a: ExciseAct, mir: Money, taxes: Money, dividends: Money) defeasible {
    label en official "note 7(3)(F)(iii): the section 4942(d) amount (minimum investment return without the stock less the section 4940 and subtitle A taxes) plus the dividend income from the stock; the (f)(2)(C) addition of section 4942(f) stays outside as in module 09";
    when act_uses_note7_3F_special_stock_treatment(a);
    when minimum_investment_return_without_special_stock_note7_3Fi(a, mir);
    when subtitle_a_and_4940_tax_for_year(a, taxes);
    when special_stock_dividend_income_note7_4A(a, dividends);
    when mir > taxes;
    then distributable_amount(a, mir - taxes + dividends);
}
@source(IRC_S4940_NOTE_7, quote = "(iii) by defining the distributable amount as the sum of the amount determined under section 4942(d) (after the application of clauses (i) and (ii)), and the amount of the dividend income from such stock.")
rule DistributableAmountNote7_3FTaxesConsumeReturn(a: ExciseAct, mir: Money, taxes: Money, dividends: Money) defeasible {
    label en official "note 7(3)(F)(iii): the taxes consume the minimum investment return, so only the dividend income remains";
    when act_uses_note7_3F_special_stock_treatment(a);
    when minimum_investment_return_without_special_stock_note7_3Fi(a, mir);
    when subtitle_a_and_4940_tax_for_year(a, taxes);
    when special_stock_dividend_income_note7_4A(a, dividends);
    when mir <= taxes;
    then distributable_amount(a, dividends);
}

// --- note 7(5) under section 4940: a note 7(3)(C) grant is outside section 4945(d)(4) and (h) ---

pub relation grant_payment_of_act_note7_5(a: ExciseAct, p: DistributionPayment) kind empirical {
    label en official "note 7(5): the grant of the act is the payment described in paragraph (3)(C)";
}
pub relation grant_excepted_from_4945d4_and_h_note7_5(a: ExciseAct) kind institutional {
    label en official "note 7(5): section 4945(d)(4) and (h) do not apply to the grant";
}
@source(IRC_S4940_NOTE_7, quote = "(5) Section 4945.—Section 4945(d)(4) and (h) shall not apply to a grant which is described in paragraph (3)(C) of this subsection.")
rule GrantExceptedFrom4945d4AndHNote7_5(a: ExciseAct, p: DistributionPayment) defeasible {
    label en official "note 7(5): the grant described in paragraph (3)(C) (binding commitment, section 170(c)(2)(B) purposes, paid on or before December 31, 1974)";
    when grant_payment_of_act_note7_5(a, p);
    when transition_grant_treated_as_to_operating_foundation(p);
    then grant_excepted_from_4945d4_and_h_note7_5(a);
}

// --- section 4942(g)(2)(E): the adjustment period, unrolled over at most five preceding years ---

pub relation prior_year_begins_4942g2E(f: Person, y: TaxableYear, k: Integer, start: Date) kind empirical {
    label en official "section 4942(g)(2)(E): the taxable year k years before the year (k = 1 is the immediately preceding one) begins on the date";
}
pub relation prior_year_was_private_foundation_4942g2E(f: Person, y: TaxableYear, k: Integer) kind empirical {
    label en official "section 4942(g)(2)(D): the organization was a private foundation in that preceding year";
}
pub relation prior_year_cash_distributions_4942g2E(f: Person, y: TaxableYear, k: Integer, amount: Money) kind empirical {
    label en official "section 4942(g)(2)(D): the amounts distributed in cash or its equivalent in that preceding year";
}
pub relation prior_year_required_cash_distribution_4942g2E(f: Person, y: TaxableYear, k: Integer, amount: Money) kind empirical {
    label en official "section 4942(g)(2)(D): the amount required to be distributed under clause (ii)(II) of subparagraph (B) for that preceding year. JUDGMENT CALL: the year's own requirement is taken before any reduction of that year (no recursion over years)";
}
pub relation computed_adjustment_period_excess_cash_distributions(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4942(g)(2)(D)-(E): the sum, over at most 5 preceding taxable years that begin after December 31, 1975 and in which the organization was a private foundation, of the cash distributions exceeding the requirement. Bounded unrolling: the years are given by ordinal k = 1..5";
}
@source(IRC_S4942_G, quote = "For purposes of subparagraph (D), with respect to any taxable year of a private foundation, the taxable years in the adjustment period are the taxable years (not exceeding 5) beginning after December 31, 1975, and immediately preceding the taxable year.")
rule ComputedAdjustmentPeriodExcess(f: Person, y: TaxableYear) defeasible {
    label en official "section 4942(g)(2)(E): excess = sum of cash minus sum of requirement over the years where cash exceeds the requirement (a difference of two sums over empirical relations)";
    when prior_year_begins_4942g2E(f, y, _, _);
    then computed_adjustment_period_excess_cash_distributions(f, y, sum(collect all c: Money, k: Integer, r: Money, s: Date where prior_year_cash_distributions_4942g2E(f, y, k, c) and prior_year_required_cash_distribution_4942g2E(f, y, k, r) and prior_year_begins_4942g2E(f, y, k, s) and prior_year_was_private_foundation_4942g2E(f, y, k) and k >= 1 and k <= 5 and s > @1975-12-31 and c > r, empty: 0.00 USD) - sum(collect all c: Money, k: Integer, r: Money, s: Date where prior_year_cash_distributions_4942g2E(f, y, k, c) and prior_year_required_cash_distribution_4942g2E(f, y, k, r) and prior_year_begins_4942g2E(f, y, k, s) and prior_year_was_private_foundation_4942g2E(f, y, k) and k >= 1 and k <= 5 and s > @1975-12-31 and c > r, empty: 0.00 USD));
}
rule RequiredCashDistributionReducedByComputedExcess(f: Person, y: TaxableYear, dist: Money, excess: Money) defeasible {
    label en official "section 4942(g)(2)(D): requirement minus the computed adjustment-period excess, when positive";
    when year_distributable_amount_without_i(f, y, dist);
    when computed_adjustment_period_excess_cash_distributions(f, y, excess);
    when dist > excess;
    then required_cash_distribution_4942g2B(f, y, dist - excess);
}
rule RequiredCashDistributionFullyOffsetByComputedExcess(f: Person, y: TaxableYear, dist: Money, excess: Money) defeasible {
    label en official "section 4942(g)(2)(D): the computed excess covers the requirement";
    when year_distributable_amount_without_i(f, y, dist);
    when computed_adjustment_period_excess_cash_distributions(f, y, excess);
    when dist <= excess;
    then required_cash_distribution_4942g2B(f, y, 0.00 USD);
}

// --- section 4961(c)(3): the section 6502 period is suspended while collection is prohibited ---

pub relation second_tier_tax_assessed_on_4961c3(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "section 4961(c)(3): the date the second tier tax was assessed (start of the section 6502 period)";
}
pub relation collection_limitation_end_without_suspension_4961c3(a: ExciseAct, p: Person, lim_end: Date) kind empirical {
    label en official "section 4961(c)(3): the last day of the section 6502 period without the suspension (the section 6502 length itself is the collection owner's rule)";
}
pub relation collection_prohibited_from_4961c3(a: ExciseAct, p: Person, from_day: Date) kind empirical {
    label en official "section 4961(c)(3): the first day of the period in which the Secretary is prohibited from collecting by levy or a proceeding in court";
}
pub relation collection_prohibited_until_4961c3(a: ExciseAct, p: Person, until_day: Date) kind empirical {
    label en official "section 4961(c)(3): the end of that period";
}
pub relation collection_limitation_tested_on_4961c3(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en official "the date on which the running of the period is tested";
}
pub relation collection_limitation_expired_4961c3(a: ExciseAct, p: Person, on: Date) kind institutional {
    label en official "section 4961(c)(3): the section 6502 period, suspended for the days of the prohibition, has run out before the tested date. Bounded reading: add_calendar_period takes a literal day count, so the extended end date is not built; expiry is decided by comparing elapsed days minus suspended days with the period length in days (the last day of the extended period is still within it)";
}
@source(IRC_S4961_C, quote = "The running of the period of limitations provided in section 6502 on the collection by levy or by a proceeding in court with respect to any second tier tax described in paragraph (1) shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court.")
rule CollectionLimitationExpiredAfterSuspension4961c3(a: ExciseAct, p: Person, assessed: Date, lim_end: Date, from_day: Date, until_day: Date, on: Date) defeasible {
    label en official "section 4961(c)(3)";
    when second_tier_tax_assessed_on_4961c3(a, p, assessed);
    when collection_limitation_end_without_suspension_4961c3(a, p, lim_end);
    when collection_prohibited_from_4961c3(a, p, from_day);
    when collection_prohibited_until_4961c3(a, p, until_day);
    when collection_limitation_tested_on_4961c3(a, p, on);
    when days_between(assessed, on) - days_between(from_day, until_day) > days_between(assessed, lim_end);
    then collection_limitation_expired_4961c3(a, p, on);
}
@source(IRC_S4961_C, quote = "The running of the period of limitations provided in section 6502 on the collection by levy or by a proceeding in court with respect to any second tier tax described in paragraph (1) shall be suspended for the period during which the Secretary is prohibited from collecting by levy or a proceeding in court.")
rule CollectionLimitationExpiredWithoutSuspension4961c3(a: ExciseAct, p: Person, assessed: Date, lim_end: Date, on: Date) defeasible {
    label en official "section 4961(c)(3): no prohibition period recorded, so the period runs unsuspended";
    when second_tier_tax_assessed_on_4961c3(a, p, assessed);
    when collection_limitation_end_without_suspension_4961c3(a, p, lim_end);
    when collection_limitation_tested_on_4961c3(a, p, on);
    unless collection_prohibited_from_4961c3(a, p, _) and second_tier_tax_assessed_on_4961c3(a, p, assessed) and collection_limitation_end_without_suspension_4961c3(a, p, lim_end) and collection_limitation_tested_on_4961c3(a, p, on);
    when days_between(assessed, on) > days_between(assessed, lim_end);
    then collection_limitation_expired_4961c3(a, p, on);
}

// --- section 4980(d)(5)(E): all employers treated as one under section 414(b), (c), (m) or (o) ---

pub relation employer_treated_as_one_employer_414_4980d5E(r: PlanReversion, employer: Person) kind empirical {
    label en official "section 4980(d)(5)(E): the employer is treated as 1 employer with the employer of the plan under section 414(b), (c), (m) or (o) (membership is a case fact; the section 414 owner is the corporations / controlled group side)";
}
pub relation employer_remaining_active_participants_count_4980d5E(r: PlanReversion, employer: Person, n: Integer) kind empirical {
    label en official "section 4980(d)(2)(A): the number of active participants in the terminated plan who remain employees of this member employer";
}
pub relation employer_active_participants_in_replacement_plan_count_4980d5E(r: PlanReversion, employer: Person, n: Integer) kind empirical {
    label en official "section 4980(d)(2)(A): how many of the member employer's remaining active participants are active participants in the replacement plan";
}
@source(IRC_S4980_D, quote = "For purposes of paragraph (2)(A), all employers treated as 1 employer under section 414(b), (c), (m), or (o) shall be treated as 1 employer.")
rule ReplacementParticipation95AcrossControlledGroup(r: PlanReversion) defeasible {
    label en official "section 4980(d)(5)(E) with (2)(A): the counts of all member employers are added and the 95 percent test is applied in exact integers to the totals (a sum over empirical relations)";
    when employer_treated_as_one_employer_414_4980d5E(r, _);
    when sum(collect all n: Integer, e: Person where employer_treated_as_one_employer_414_4980d5E(r, e) and employer_remaining_active_participants_count_4980d5E(r, e, n), empty: 0) > 0;
    when sum(collect all m: Integer, e: Person where employer_treated_as_one_employer_414_4980d5E(r, e) and employer_active_participants_in_replacement_plan_count_4980d5E(r, e, m), empty: 0) * 100 >= sum(collect all n: Integer, e: Person where employer_treated_as_one_employer_414_4980d5E(r, e) and employer_remaining_active_participants_count_4980d5E(r, e, n), empty: 0) * 95;
    then replacement_participation_95_percent_met(r);
}

// --- section 4980B(c)(3)(B): the $200-a-day maximum for several qualified beneficiaries of one event ---

pub relation cobra_family_failure_day_count_4980Bc3B(ev: CobraQualifyingEvent, day: Date, n: Integer) kind empirical {
    label en official "section 4980B(c)(3)(B): the number of qualified beneficiaries with respect to the same qualifying event that have a failure on the day (across separate acts)";
}
pub relation cobra_family_daily_tax_4980Bc3B(ev: CobraQualifyingEvent, day: Date, amount: Money) kind institutional {
    label en official "section 4980B(c)(3)(B): the tax on all failures on the day, the per-beneficiary daily tax times the count, but not more than $200 when there is more than 1 qualified beneficiary";
}
@source(IRC_S4980B_C, quote = "If there is more than 1 qualified beneficiary with respect to the same qualifying event, the maximum amount of tax imposed by subsection (a) on all failures on any day during the noncompliance period with respect to such qualified beneficiaries shall be $200.")
rule CobraFamilyDailyTax(ev: CobraQualifyingEvent, day: Date, n: Integer) defeasible {
    label en official "section 4980B(c)(3)(B): min($200, daily tax x count) for a day with more than 1 beneficiary; one beneficiary pays the daily tax alone";
    when cobra_family_failure_day_count_4980Bc3B(ev, day, n);
    when n >= 1;
    then cobra_family_daily_tax_4980Bc3B(ev, day, min(200.00 USD, CobraFailureDailyTax4980B * n));
}
pub relation cobra_family_total_tax_4980Bc3B(ev: CobraQualifyingEvent, amount: Money) kind institutional {
    label en official "section 4980B(c)(3)(B): the total over the days: the daily tax times the count on days with at most 2 beneficiaries plus $200 for each day with more than 2 (computed by sums over the empirical day counts; the per-day results above are the same values)";
}
rule CobraFamilyTotalTax(ev: CobraQualifyingEvent) defeasible {
    label en official "section 4980B(c)(3)(B): total = daily tax x (sum of counts on days with at most 2) + 200 x (number of days with more than 2)";
    when cobra_family_failure_day_count_4980Bc3B(ev, _, _);
    then cobra_family_total_tax_4980Bc3B(ev, CobraFailureDailyTax4980B * sum(collect all n: Integer, d: Date where cobra_family_failure_day_count_4980Bc3B(ev, d, n) and n <= 2, empty: 0) + 200.00 USD * count(collect d: Date, n: Integer where cobra_family_failure_day_count_4980Bc3B(ev, d, n) and n > 2));
}

// --- section 5000A(d)(2)(A)(i)-(ii): the religious conscience exemption ---

enum HealthServiceCategory5000A {
    RoutineDental;
    RoutineVision;
    RoutineHearing;
    Midwifery;
    Vaccination;
    NecessaryServiceToChild;
    ServiceRequiredByLawOrThirdParty;
    OtherService;
}
pub relation health_service_category_5000A(service: Text, cat: HealthServiceCategory5000A) kind empirical {
    label en official "section 5000A(d)(2)(A)(ii)(I): the category of the service received (a fact of the Exchange form)";
}
pub relation service_excluded_by_hhs_1311d4H(service: Text) kind empirical {
    label en official "section 5000A(d)(2)(A)(ii)(I): a further service the Secretary of Health and Human Services provides in implementing ACA section 1311(d)(4)(H) (EXTERNAL_DEPENDENCY on the HHS rules, taken as a fact)";
}
pub relation service_of_record_5000A(service: Text) kind empirical {
    label en official "a health service in the record of the individual's preceding year";
}
pub relation service_excluded_from_medical_health_services_5000Ad2AiiI(service: Text) kind institutional {
    label en official "section 5000A(d)(2)(A)(ii)(I): the service is one that the term medical health services does not include";
}
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceRoutineDental5000A(service: Text) defeasible { label en official "routine dental services"; when health_service_category_5000A(service, RoutineDental); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceRoutineVision5000A(service: Text) defeasible { label en official "routine vision services"; when health_service_category_5000A(service, RoutineVision); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceRoutineHearing5000A(service: Text) defeasible { label en official "routine hearing services"; when health_service_category_5000A(service, RoutineHearing); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceMidwifery5000A(service: Text) defeasible { label en official "midwifery services"; when health_service_category_5000A(service, Midwifery); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceVaccination5000A(service: Text) defeasible { label en official "vaccinations"; when health_service_category_5000A(service, Vaccination); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceChild5000A(service: Text) defeasible { label en official "necessary medical services provided to children"; when health_service_category_5000A(service, NecessaryServiceToChild); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceRequired5000A(service: Text) defeasible { label en official "services required by law or by a third party"; when health_service_category_5000A(service, ServiceRequiredByLawOrThirdParty); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
@source(IRC_S5000A_D, quote = "For purposes of this subparagraph, the term \"medical health services\" does not include routine dental, vision and hearing services, midwifery services, vaccinations, necessary medical services provided to children, services required by law or by a third party, and such other services as the Secretary of Health and Human Services may provide in implementing section 1311(d)(4)(H) of the Patient Protection and Affordable Care Act.")
rule ExcludedServiceByHhs5000A(service: Text) defeasible { label en official "such other services as the Secretary of Health and Human Services may provide"; when service_excluded_by_hhs_1311d4H(service); then service_excluded_from_medical_health_services_5000Ad2AiiI(service); }
pub relation medical_health_service_5000A(service: Text) kind institutional {
    label en official "section 5000A(d)(2)(A)(ii)(I): a service of the record that the term medical health services includes (not excluded)";
}
rule MedicalHealthService5000A(service: Text) defeasible {
    label en official "section 5000A(d)(2)(A)(ii)(I): a recorded service that is not one of the excluded services";
    when service_of_record_5000A(service);
    unless service_excluded_from_medical_health_services_5000Ad2AiiI(service) and service_of_record_5000A(service);
    then medical_health_service_5000A(service);
}
pub relation exemption_certifies_religious_sect_1402g1_5000Ad2AiI(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(d)(2)(A)(i)(I): the exemption certifies membership in a recognized religious sect described in section 1402(g)(1) and adherence to its tenets";
}
pub relation exemption_certifies_reliance_on_religious_healing_5000Ad2AiII(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(d)(2)(A)(i)(II): the exemption certifies membership in a religious sect not described in section 1402(g)(1), sole reliance on a religious method of healing, and that accepting medical health services is inconsistent with the beliefs";
}
pub relation taxable_year_of_month_5000A(ym: Integer, y: TaxableYear) kind empirical {
    label en official "the taxable year of the month";
}
pub relation attestation_of_no_medical_health_services_5000Ad2AiiII(p: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(d)(2)(A)(ii)(II): the information provided under ACA section 1411(b)(5)(A) includes an attestation that the individual has not received medical health services during the preceding taxable year";
}
pub relation individual_received_service_in_preceding_year_5000A(p: Person, y: TaxableYear, service: Text) kind empirical {
    label en official "the individual received the recorded service in the taxable year preceding y";
}
pub relation religious_exemption_effective_5000Ad2A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(d)(2)(A): the exemption applies: clause (i)(I), or clause (i)(II) only with the attestation of (ii)(II)";
}
@source(IRC_S5000A_D, quote = "(I) such individual is a member of a recognized religious sect or division thereof which is described in section 1402(g)(1), and is adherent of established tenets or teachings of such sect or division as described in such section; or")
rule ReligiousExemptionEffectiveViaSect5000A(p: Person, ym: Integer) defeasible {
    label en official "section 5000A(d)(2)(A)(i)(I)";
    when exemption_certifies_religious_sect_1402g1_5000Ad2AiI(p, ym);
    then religious_exemption_effective_5000Ad2A(p, ym);
}
@source(IRC_S5000A_D, quote = "Clause (i)(II) shall apply to an individual for months in a taxable year only if the information provided by the individual under section 1411(b)(5)(A) of such Act includes an attestation that the individual has not received medical health services during the preceding taxable year.")
rule ReligiousExemptionEffectiveViaHealingWithAttestation5000A(p: Person, ym: Integer, y: TaxableYear) defeasible {
    label en official "section 5000A(d)(2)(A)(i)(II) with (ii)(II): the attestation is a condition of application";
    when exemption_certifies_reliance_on_religious_healing_5000Ad2AiII(p, ym);
    when taxable_year_of_month_5000A(ym, y);
    when attestation_of_no_medical_health_services_5000Ad2AiiII(p, y);
    then religious_exemption_effective_5000Ad2A(p, ym);
}
pub relation individual_received_medical_health_services_in_preceding_year_5000A(p: Person, y: TaxableYear) kind institutional {
    label en official "section 5000A(d)(2)(A)(ii): the individual received a service that is a medical health service in the preceding taxable year (so an attestation of no such services would be inaccurate). The statute conditions the exemption on the attestation, not on its accuracy; this relation only records the accuracy";
}
rule IndividualReceivedMedicalHealthServices5000A(p: Person, y: TaxableYear, service: Text) defeasible {
    label en official "section 5000A(d)(2)(A)(ii)(I) applied to the record";
    when individual_received_service_in_preceding_year_5000A(p, y, service);
    when medical_health_service_5000A(service);
    then individual_received_medical_health_services_in_preceding_year_5000A(p, y);
}

// --- section 4946(a)(4): constructive ownership of profits and beneficial interests (section 267(c) other than (3)) ---
// Bounded unrolling: the owner's direct interest, the interest held through ONE entity tier (paragraph (1) of section 267(c),
// proportionately), and the same two terms for each member of the owner's family (paragraph (2), family per section 4946(d)).
// Interest held through two or more entity tiers is not attributed (recorded as TECH-GAPS G6890); the products of the tier
// are formed inside the collection.

pub relation interest_holder_4946a4(p: Person, ent: Person) kind empirical {
    label en official "section 4946(a)(4): the person is considered for constructive ownership of the profits interest or beneficial interest of the entity (marker)";
}
pub relation direct_interest_share_4946a4(owner: Person, ent: Person, share: Decimal) kind empirical {
    label en official "section 4946(a)(4): the share of the profits interest of a partnership, or of the beneficial interest of a trust or unincorporated enterprise, that the owner holds directly";
}
pub relation family_member_of_holder_4946a4(q: Person, p: Person) kind empirical {
    label en official "section 4946(a)(4), section 267(c)(2), (4): the person q is a member of the family of the individual p within the meaning of section 4946(d) (asserted; the derived member_of_family of module 02 is a derived relation and cannot be summed over at runtime, section 111)";
}
pub relation constructive_interest_share_4946a4(p: Person, ent: Person, share: Decimal) kind institutional {
    label en official "section 4946(a)(4): the owner's actual plus constructive share (one entity tier and the family, section 267(c)(1), (2), (4), (5)); capped only by the record, not at 100 percent";
}
@source(IRC_S4946_A, quote = "For purposes of paragraphs (1)(C)(ii) and (iii), (1)(F), and (1)(G), the ownership of profits or beneficial interests shall be determined in accordance with the rules for constructive ownership of stock provided in section 267(c) (other than paragraph (3) thereof), except that section 267(c)(4) shall be treated as providing that the members of the family of an individual are the members within the meaning of subsection (d).")
rule ConstructiveInterestShare4946a4(p: Person, ent: Person) defeasible {
    label en official "section 4946(a)(4): direct + one entity tier (proportionately) + the family's direct and one-tier shares";
    when interest_holder_4946a4(p, ent);
    then constructive_interest_share_4946a4(p, ent, sum(collect all d: Decimal where direct_interest_share_4946a4(p, ent, d), empty: 0.00) + sum(collect all x: Decimal, m: Person, a: Decimal, b: Decimal where direct_interest_share_4946a4(p, m, a) and direct_interest_share_4946a4(m, ent, b) and x == a * b, empty: 0.00) + sum(collect all d2: Decimal, q: Person where family_member_of_holder_4946a4(q, p) and direct_interest_share_4946a4(q, ent, d2), empty: 0.00) + sum(collect all x2: Decimal, q2: Person, m2: Person, a2: Decimal, b2: Decimal where family_member_of_holder_4946a4(q2, p) and direct_interest_share_4946a4(q2, m2, a2) and direct_interest_share_4946a4(m2, ent, b2) and x2 == a2 * b2, empty: 0.00));
}
rule TwentyPercentOwnerViaConstructiveShare4946a4(p: Person, f: Person, ent: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(C)(ii)-(iii) with (a)(4): more than 20 percent of the profits or beneficial interest of an entity that is a substantial contributor, by the derived constructive share";
    when constructive_interest_share_4946a4(p, ent, share);
    when share > 0.20;
    when substantial_contributor(ent, f);
    then twenty_percent_corporate_owner_of_substantial_contributor(p, f);
}
