// Stage 3 (26.09.2026), audit of EXECUTABLE rows that rested only on case
// facts: definitions that modules of stages 1-2 read as inputs are derived
// from their components here. Relations that were empirical and are now
// `institutional` (still assertable): `self_dealing_amount_involved`,
// `excess_benefit_organization_manager`, `trust_payment_of_benefits_4951f`,
// `investment_advisor_of_sponsor`, `refund_suit_window_lapsed`,
// `continuation_coverage_provided_to`, `expatriation_date_4985`,
// `plan_covers_employer_with_100_or_more_employees`,
// `health_care_sharing_ministry_member`. Status: implemented_unverified;
// scenarios not executed; no legal review.

// --- 4941(e)(2): amount involved ---

use self::{
    CobraQualifyingEvent,
    ExciseAct,
    ExciseActKind,
    Person,
    PlanReversion,
    TaxableYear,
    cobra_failure_tax,
    cobra_reasonable_cause_failure,
    continuation_coverage_provided_to,
    distribution_ordinary_income,
    employee_with_authority_over_act,
    entity_is_ric,
    esop_transfer_invested_within_90_days,
    esop_transfer_suspense_allocation_met,
    excess_benefit_organization_manager,
    excise_act_kind,
    expatriation_date_4985,
    failure_reasonable_cause_established_for_waiver,
    health_care_sharing_ministry_member,
    investment_advisor_of_sponsor,
    officer_director_or_trustee,
    plan_covers_employer_with_100_or_more_employees,
    prior_year_distributed_amount,
    prior_year_grossed_up_required_distribution,
    refund_claim_denied_on,
    refund_suit_window_lapsed,
    reversion_esop_transfer_requirements_met,
    ric_capital_gain_net_income_used,
    section_7422_proceeding_begun_on,
    self_dealing_amount_involved,
    trust_payment_of_benefits_4951f,
    trust_qualified_gratuitous_transfer_to_esop,
    trust_value_of_net_assets_limited_to_segregated,
};

pub relation self_dealing_value_given(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(e)(2): the amount of money and the fair market value of the other property given";
}
pub relation self_dealing_value_received(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(e)(2): the amount of money and the fair market value of the other property received";
}
rule AmountInvolvedGivenIsGreater(a: ExciseAct, given: Money, received: Money) defeasible {
    label en official "section 4941(e)(2): the greater of the value given and the value received - given";
    when self_dealing_value_given(a, given);
    when self_dealing_value_received(a, received);
    when given >= received;
    then self_dealing_amount_involved(a, given);
}
rule AmountInvolvedReceivedIsGreater(a: ExciseAct, given: Money, received: Money) defeasible {
    label en official "section 4941(e)(2): the greater of the value given and the value received - received";
    when self_dealing_value_given(a, given);
    when self_dealing_value_received(a, received);
    when received > given;
    then self_dealing_amount_involved(a, received);
}

// --- 4958(f)(2): organization manager ---

rule OrganizationManager4958Officer(p: Person, org: Person) defeasible {
    label en official "section 4958(f)(2): any officer, director or trustee of the organization (or an individual having similar powers or responsibilities)";
    when officer_director_or_trustee(p, org);
    then excess_benefit_organization_manager(p, org);
}
rule OrganizationManager4958Employee(p: Person, org: Person, a: ExciseAct) defeasible {
    label en official "section 4958(f)(2), (b)(2) pattern: with respect to any transaction, an employee having authority or responsibility with respect to it";
    when employee_with_authority_over_act(p, org, a);
    then excess_benefit_organization_manager(p, org);
}

// --- 4947(b)(2), (b)(4) ---

pub relation trust_has_segregated_amounts_4947a2B(t: Person) kind empirical {
    label en unofficial "section 4947(b)(2): amounts in the trust are segregated within the meaning of subsection (a)(2)(B)";
}
pub relation trust_segregated_amounts_value(t: Person, amount: Money) kind empirical {
    label en unofficial "the value of the segregated amounts";
}
pub relation trust_total_net_assets_value(t: Person, amount: Money) kind empirical {
    label en unofficial "the value of all the net assets of the trust";
}
rule NetAssetsLimitedToSegregated(t: Person, seg: Money) defeasible {
    label en official "section 4947(b)(2): where amounts are segregated the value of the net assets for section 507(c)(2) and (g) is limited to the segregated amounts";
    when trust_has_segregated_amounts_4947a2B(t);
    when trust_segregated_amounts_value(t, seg);
    then trust_value_of_net_assets_limited_to_segregated(t, seg);
}
pub relation trust_net_assets_for_507c2_and_g(t: Person, amount: Money) kind institutional {
    label en official "section 4947(b)(2): the value of the net assets for section 507(c)(2) and (g): the segregated amounts when there are any, otherwise all the net assets";
}
rule NetAssetsFor507SegregatedOnly(t: Person, seg: Money) defeasible {
    label en official "section 4947(b)(2)";
    when trust_value_of_net_assets_limited_to_segregated(t, seg);
    then trust_net_assets_for_507c2_and_g(t, seg);
}
rule NetAssetsFor507AllAssets(t: Person, total: Money) defeasible {
    label en official "section 4947(b)(2): no segregated amounts, so all the net assets";
    when trust_total_net_assets_value(t, total);
    unless trust_has_segregated_amounts_4947a2B(t) and trust_total_net_assets_value(t, total);
    then trust_net_assets_for_507c2_and_g(t, total);
}
pub relation section_507a_not_applicable_to_trust_4947b4(t: Person) kind institutional {
    label en official "section 4947(b)(4): section 507(a) does not apply to a trust described in subsection (a)(2) by reason of a qualified gratuitous transfer of qualified employer securities to an ESOP";
}
rule Section507aNotApplicableToQgtTrust(t: Person) defeasible {
    label en official "section 4947(b)(4)";
    when trust_qualified_gratuitous_transfer_to_esop(t);
    then section_507a_not_applicable_to_trust_4947b4(t);
}

// --- 4951(f): payments of benefits ---

pub relation trust_payment_for_501c21_A_i_I_or_IV_purposes(a: ExciseAct) kind empirical {
    label en unofficial "section 4951(f): the payment out of assets or income of a section 501(c)(21) trust is for the purposes described in subclause (I) or (IV) of section 501(c)(21)(A)(i)";
}
rule TrustPaymentOfBenefitsFromPurposes(a: ExciseAct) defeasible {
    label en official "section 4951(f): a payment for the (I) or (IV) purposes is not an act of self-dealing";
    when trust_payment_for_501c21_A_i_I_or_IV_purposes(a);
    then trust_payment_of_benefits_4951f(a);
}

// --- 4958(f)(8)(B): investment advisor ---

pub relation compensated_by_sponsor_for_daf_investment_management_or_advice(p: Person, sponsor: Person) kind empirical {
    label en unofficial "section 4958(f)(8)(B): p is compensated by the sponsoring organization for managing the investment of, or providing investment advice for, assets maintained in donor advised funds owned by the organization";
}
pub relation employee_of_sponsor(p: Person, sponsor: Person) kind empirical {
    label en unofficial "p is an employee of the sponsoring organization";
}
rule InvestmentAdvisorOfSponsor(p: Person, sponsor: Person) defeasible {
    label en official "section 4958(f)(8)(B): a person other than an employee compensated for managing or advising on donor advised fund assets";
    when compensated_by_sponsor_for_daf_investment_management_or_advice(p, sponsor);
    unless employee_of_sponsor(p, sponsor) and compensated_by_sponsor_for_daf_investment_management_or_advice(p, sponsor);
    then investment_advisor_of_sponsor(p, sponsor);
}

// --- 4961(c)(2): the 90-day refund suit window ---

pub relation refund_suit_determination_date_4961(a: ExciseAct, p: Person, on: Date) kind empirical {
    label en unofficial "the date as of which the closing of the 90-day period is tested";
}
pub relation proceeding_begun_within_90_days_of_denial(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4961(c)(2): a section 7422 proceeding was begun within 90 days after the refund claim was denied";
}
rule ProceedingBegunWithin90Days(a: ExciseAct, p: Person, denied: Date, begun: Date) defeasible {
    label en official "section 4961(c)(2): begun no later than the 90th day after the denial";
    when refund_claim_denied_on(a, p, denied);
    when section_7422_proceeding_begun_on(a, p, begun);
    when begun >= denied;
    when begun <= add_calendar_period(denied, 90 calendar_day);
    then proceeding_begun_within_90_days_of_denial(a, p);
}
rule RefundSuitWindowLapsed(a: ExciseAct, p: Person, denied: Date, tested: Date) defeasible {
    label en official "section 4961(c)(2): the 90 days after the denial closed without a section 7422 proceeding, so paragraph (1) ceases to apply effective the following day";
    when refund_claim_denied_on(a, p, denied);
    when refund_suit_determination_date_4961(a, p, tested);
    when tested > add_calendar_period(denied, 90 calendar_day);
    unless proceeding_begun_within_90_days_of_denial(a, p) and refund_claim_denied_on(a, p, denied) and refund_suit_determination_date_4961(a, p, tested);
    then refund_suit_window_lapsed(a, p);
}

// --- 4980(c)(3)(F)-(G): ESOP transfer ---

pub relation esop_transfer_deduction_disallowed_4980c3F(r: PlanReversion) kind institutional {
    label en official "section 4980(c)(3)(F): no credit or deduction is allowed under chapter 1 for an amount transferred to an ESOP in a transfer to which paragraph (3) applies";
}
rule EsopTransferDeductionDisallowed(r: PlanReversion) defeasible {
    label en official "section 4980(c)(3)(F)";
    when reversion_esop_transfer_requirements_met(r);
    then esop_transfer_deduction_disallowed_4980c3F(r);
}
pub relation esop_transfer_attributable_amounts_meet_requirements(r: PlanReversion) kind empirical {
    label en unofficial "section 4980(c)(3)(G): amounts attributable to the amount transferred also meet the requirements of subparagraphs (B) and (C)";
}
pub relation esop_transfer_amount_meets_B_and_C(r: PlanReversion) kind institutional {
    label en official "section 4980(c)(3)(G): the amount transferred meets (B) and (C) only if the amounts attributable to it also meet them";
}
rule EsopTransferAmountMeetsBAndC(r: PlanReversion) defeasible {
    label en official "section 4980(c)(3)(G)";
    when esop_transfer_invested_within_90_days(r);
    when esop_transfer_suspense_allocation_met(r);
    when esop_transfer_attributable_amounts_meet_requirements(r);
    then esop_transfer_amount_meets_B_and_C(r);
}

// --- 4980B(c)(4)(C): $2,000,000 for benefit providers; (f)(2)(A), (D) ---

pub relation cobra_provider_only_under_e1B(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "section 4980B(c)(4)(C): the person is described in subsection (e)(1)(B) and not in (e)(1)(A) with respect to the failure";
}
pub relation cobra_failure_taxable_year_of_provider(a: ExciseAct, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year of the provider in which the failure occurs";
}
pub relation cobra_provider_annual_tax_before_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980B(c)(4)(C): the tax on failures during the taxable year with respect to all plans for a person described in (e)(1)(B) and not (e)(1)(A) (aggregate over failure taxes, like module 18)";
}
rule CobraProviderAnnualTaxBeforeLimit(p: Person, y: TaxableYear, a0: ExciseAct) defeasible {
    label en official "sum of the failure taxes of the year of the provider";
    when cobra_provider_only_under_e1B(a0, p);
    when cobra_failure_taxable_year_of_provider(a0, p, y);
    then cobra_provider_annual_tax_before_limit(p, y, sum(collect all x: Money, a: ExciseAct where cobra_failure_tax(a, p, x) and cobra_failure_taxable_year_of_provider(a, p, y) and cobra_provider_only_under_e1B(a, p) and cobra_reasonable_cause_failure(a), empty: 0.00 USD));
}
pub relation cobra_provider_annual_tax_after_limit(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980B(c)(4)(C): the aggregate tax for failures during the year with respect to all plans shall not exceed $2,000,000";
}
rule CobraProviderAnnualTaxAfterLimit(p: Person, y: TaxableYear, t: Money) defeasible {
    label en official "section 4980B(c)(4)(C)";
    when cobra_provider_annual_tax_before_limit(p, y, t);
    then cobra_provider_annual_tax_after_limit(p, y, min(t, CobraBenefitProviderLimit4980B));
}
pub relation coverage_identical_to_similarly_situated_beneficiaries(plan: Person, qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "section 4980B(f)(2)(A): as of the time it is provided, the coverage is identical to the coverage under the plan to similarly situated beneficiaries with respect to whom a qualifying event has not occurred";
}
pub relation coverage_modified_in_same_manner_for_group(plan: Person, qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "section 4980B(f)(2)(A), second sentence: if coverage is modified for a group of similarly situated beneficiaries, it is modified in the same manner for the qualified beneficiaries in connection with that group (or no modification occurred)";
}
pub relation coverage_conditioned_on_insurability(plan: Person, qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "section 4980B(f)(2)(D): the coverage is conditioned upon, or discriminates on the basis of lack of, evidence of insurability";
}
rule ContinuationCoverageProvidedDerived(plan: Person, qb: Person, ev: CobraQualifyingEvent) defeasible {
    label en official "section 4980B(f)(2)(A), (D): identical coverage, modified in the same manner, and not conditioned on evidence of insurability";
    when coverage_identical_to_similarly_situated_beneficiaries(plan, qb, ev);
    when coverage_modified_in_same_manner_for_group(plan, qb, ev);
    unless coverage_conditioned_on_insurability(plan, qb, ev) and coverage_identical_to_similarly_situated_beneficiaries(plan, qb, ev) and coverage_modified_in_same_manner_for_group(plan, qb, ev);
    then continuation_coverage_provided_to(plan, qb, ev);
}

// --- 4980F(c)(4): waiver ---

pub relation secretary_waives_accrual_notice_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "section 4980F(c)(4): the Secretary waives part or all of the tax to the extent payment would be excessive or otherwise inequitable relative to the failure";
}
pub relation accrual_notice_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4980F(c)(4): the tax on the failure is waived";
}
rule S4980FWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4980F(c)(4): the Secretary may waive part or all of the tax for a failure due to reasonable cause and not to willful neglect; an exercise for another failure has no effect (E-0239)";
    when excise_act_kind(a, BenefitAccrualNoticeFailure);
    when secretary_waives_accrual_notice_tax_on(a, on);
    then power S4980FWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_accrual_notice_tax_on(a, on);
        valid_when failure_reasonable_cause_established_for_waiver(a);
        effect create(accrual_notice_tax_waived(a));
        window [-infinity, infinity];
    };
}

// --- 4982(b)(3): grossed up required distribution ---

pub relation ric_grossed_up_required_distribution(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4982(b)(3): the required distribution determined with the application of paragraph (2) and with 100 percent substituted for each percentage of paragraph (1)";
}
rule RicGrossedUpRequiredDistribution(t: Person, cy: Integer, oi: Money, cg: Money, gu: Money, pd: Money) defeasible {
    label en official "section 4982(b)(3): ordinary income + capital gain net income + max(0, prior grossed-up required - prior distributed)";
    when entity_is_ric(t, cy);
    when distribution_ordinary_income(t, cy, oi);
    when ric_capital_gain_net_income_used(t, cy, cg);
    when prior_year_grossed_up_required_distribution(t, cy, gu);
    when prior_year_distributed_amount(t, cy, pd);
    then ric_grossed_up_required_distribution(t, cy, oi + cg + max(gu - pd, 0.00 USD));
}

// --- 4985(e)(2)(B): expatriation date ---

pub relation corporation_is_expatriated_on(corp: Person, on: Date) kind empirical {
    label en unofficial "section 4985(e)(2)(A): a date on which the corporation is an expatriated corporation (an expatriated entity under section 7874(a)(2))";
}
pub relation earlier_expatriated_date_exists(corp: Person, on: Date) kind institutional {
    label en official "helper: a strictly earlier date on which the corporation is expatriated exists";
}
rule EarlierExpatriatedDateExists(corp: Person, on: Date, on2: Date) defeasible {
    label en official "helper";
    when corporation_is_expatriated_on(corp, on);
    when corporation_is_expatriated_on(corp, on2);
    when on2 < on;
    then earlier_expatriated_date_exists(corp, on);
}
rule ExpatriationDateIsTheFirstDate(corp: Person, on: Date) defeasible {
    label en official "section 4985(e)(2)(B): the date on which the corporation first becomes an expatriated corporation";
    when corporation_is_expatriated_on(corp, on);
    unless earlier_expatriated_date_exists(corp, on);
    then expatriation_date_4985(corp, on);
}

// --- 5000(b): large group health plan ---

pub relation employer_normally_employed_count_previous_year(emp: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 5000(b)(2): the number of employees the employer normally employed on a typical business day during the previous calendar year";
}
pub relation section_52_single_employer_extra_employees(emp: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 5000(b)(2)(A): employees of the other employers treated as a single employer under section 52(a) or (b)";
}
pub relation affiliated_service_group_employees(emp: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 5000(b)(2)(B): employees of the members of an affiliated service group (section 414(m)) treated as employed by a single employer";
}
pub relation leased_employees_treated_as_employees(emp: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 5000(b)(2)(C): leased employees (section 414(n)(2)) treated as employees of the person for whom they perform services, to the extent required by that section";
}
pub relation plan_covers_employees_of(plan: Person, emp: Person) kind empirical {
    label en unofficial "the plan covers employees of the employer";
}
pub relation employer_normally_employed_at_least_100_5000b(emp: Person, cy: Integer) kind institutional {
    label en official "section 5000(b)(2): the employer (with the (A)-(C) aggregation) normally employed at least 100 employees on a typical business day during the previous calendar year";
}
rule EmployerNormallyEmployedAtLeast100(emp: Person, cy: Integer, a: Integer, b: Integer, c: Integer, d: Integer) defeasible {
    label en official "section 5000(b)(2)(A)-(C): the sum of the four counts is at least 100";
    when employer_normally_employed_count_previous_year(emp, cy, a);
    when section_52_single_employer_extra_employees(emp, cy, b);
    when affiliated_service_group_employees(emp, cy, c);
    when leased_employees_treated_as_employees(emp, cy, d);
    when a + b + c + d >= 100;
    then employer_normally_employed_at_least_100_5000b(emp, cy);
}
rule LargeGroupHealthPlanFromEmployerSize(plan: Person, cy: Integer, emp: Person) defeasible {
    label en official "section 5000(b)(2): a plan covering employees of at least one employer that normally employed at least 100 employees";
    when plan_covers_employees_of(plan, emp);
    when employer_normally_employed_at_least_100_5000b(emp, cy);
    then plan_covers_employer_with_100_or_more_employees(plan, cy);
}

// --- 5000A(d)(2)(B): health care sharing ministry ---

pub relation ministry_is_501c3_exempt(org: Person) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(ii)(I): the organization is described in section 501(c)(3) and exempt from tax under section 501(a)";
}
pub relation ministry_members_share_beliefs_and_expenses_regardless_of_state(org: Person) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(ii)(II): members share a common set of ethical or religious beliefs and share medical expenses in accordance with them without regard to the State in which a member resides or is employed";
}
pub relation ministry_members_retain_membership_after_condition(org: Person) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(ii)(III): members retain membership even after they develop a medical condition";
}
pub relation ministry_shared_expenses_continuously_since_1999_12_31(org: Person) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(ii)(IV): the organization (or a predecessor) has been in existence at all times since December 31, 1999, and expenses of members have been shared continuously and without interruption since at least that date";
}
pub relation ministry_annual_independent_cpa_audit_public(org: Person) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(ii)(V): an annual audit by an independent certified public accounting firm under generally accepted accounting principles, available to the public on request";
}
pub relation health_care_sharing_ministry(org: Person) kind institutional {
    label en official "section 5000A(d)(2)(B)(ii): a health care sharing ministry meeting (I)-(V)";
}
rule HealthCareSharingMinistry(org: Person) defeasible {
    label en official "section 5000A(d)(2)(B)(ii)(I)-(V)";
    when ministry_is_501c3_exempt(org);
    when ministry_members_share_beliefs_and_expenses_regardless_of_state(org);
    when ministry_members_retain_membership_after_condition(org);
    when ministry_shared_expenses_continuously_since_1999_12_31(org);
    when ministry_annual_independent_cpa_audit_public(org);
    then health_care_sharing_ministry(org);
}
pub relation member_of_organization_in_month(p: Person, org: Person, ym: Integer) kind empirical {
    label en unofficial "section 5000A(d)(2)(B)(i): the individual is a member of the organization for the month";
}
rule MemberOfHealthCareSharingMinistry(p: Person, org: Person, ym: Integer) defeasible {
    label en official "section 5000A(d)(2)(B)(i): a member of a health care sharing ministry for the month is not an applicable individual";
    when member_of_organization_in_month(p, org, ym);
    when health_care_sharing_ministry(org);
    then health_care_sharing_ministry_member(p, ym);
}
