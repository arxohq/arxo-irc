// Sections 4965 (prohibited tax shelter transactions), 4966 (taxable
// distributions of donor advised funds), 4967 (prohibited benefits from donor
// advised funds) and 4968 (excise tax on investment income of private colleges
// and universities), with the two editions of section 4968 (2024 text and the
// Pub. L. 119-21 section 70415 text for taxable years beginning after Dec. 31,
// 2025). Stage 2 (DECISION-0379).
//
// SECTION 4965
//  - the transaction instance is an `ExciseAct` of kind ProhibitedTaxShelter; the
//    tax attaches per (tax-exempt entity, taxable year), so the tax heads are the
//    relations `tax_shelter_entity_tax` / `tax_shelter_manager_tax`, not the shared
//    two-tier heads (there is no second tier).
//  - "listed transaction" (6707A(c)(2)), "reportable transaction" (6707A(c)(1)) and
//    "confidential transaction / contractual protection" are case facts
//    (EXTERNAL_DEPENDENCY on subtitle F owners; no such owner package exists yet).
//  - net income and proceeds "attributable" to the transaction, including the
//    allocation to the post-listing period for a subsequently listed transaction,
//    are asserted amounts; the tax applies the highest section 11 rate (a fact).
//  - years: for a transaction that was prohibited when the entity became a party
//    the tax runs from the year the entity became a party and every later year; for
//    a subsequently listed transaction, every year in which the entity is a party
//    at any time.
//
// SECTIONS 4966-4967: donor advised fund taxes. "More than incidental benefit" and
// "knowing" are external judgments (DECISION-0194). Both sections' taxes are single
// tier and are populated into the shared `initial_tax` head so that the payment
// duties of 23-payment-duties.law and the first-tier definition of 4963(a) reach
// them; their bearers are the sponsoring organization, the fund manager and (4967)
// the person advising or benefiting.
//
// SECTION 4968: two editions selected by the beginning date of the taxable year
// (Pub. L. 119-21 section 70415(b) applies to taxable years beginning after
// December 31, 2025) and by the `effective` window from enactment, with the
// amending fragment `us.irc.temporal::PL119_21_S70415` as the source. Net
// investment income is the asserted result of "rules similar to section 4940(c)"
// (the package's own 4940 computation is keyed to private foundations — G2506).

// ============================================================================
// Section 4965
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4965_A,
    IRC_S4965_B,
    IRC_S4965_C,
    IRC_S4965_D,
    IRC_S4965_E,
    IRC_S4966_A,
    IRC_S4966_B,
    IRC_S4966_C,
    IRC_S4966_D,
    IRC_S4967_A,
    IRC_S4967_C,
    IRC_S4968_A,
    IRC_S4968_B,
    IRC_S4968_D,
    Person,
    TaxableYear,
    excise_act_kind,
    first_tier_tax,
    initial_tax,
    qualified_first_tier_tax,
    taxable_event,
};

enum TaxExemptEntityKind {
    Section501cOr501dOrganization;
    Section170cOrganization;
    IndianTribalGovernment;
    Section4979eEntity;
    Section529Program;
    Section457bPlanOfSection457e1AEmployer;
    Section4973aArrangement;
    Section529AProgram;
}
pub relation tax_exempt_entity_kind_4965(e: Person, k: TaxExemptEntityKind) kind empirical {
    label en official "section 4965(c)(1)-(8): the entity is of this listed kind (a 170(c) organization other than the United States)";
}
@source(IRC_S4965_C, coverage = exact, quote = "For purposes of this section, the term \"tax-exempt entity\" means an entity which is—")
pub relation tax_exempt_entity_4965(e: Person) kind institutional {
    label en official "section 4965(c): the entity is a tax-exempt entity";
}
rule TaxExemptEntity4965(e: Person, k: TaxExemptEntityKind) defeasible {
    label en official "section 4965(c): an entity of any listed kind";
    when tax_exempt_entity_kind_4965(e, k);
    then tax_exempt_entity_4965(e);
}
pub relation tax_exempt_entity_paragraphs_1_to_3(e: Person) kind institutional {
    label en official "section 4965(a)(1): the entity is described in paragraph (1), (2), or (3) of subsection (c) (501(c)/501(d), 170(c), Indian tribal government)";
}
rule EntityParagraph1(e: Person) defeasible { label en official "4965(c)(1)"; when tax_exempt_entity_kind_4965(e, Section501cOr501dOrganization); then tax_exempt_entity_paragraphs_1_to_3(e); }
rule EntityParagraph2(e: Person) defeasible { label en official "4965(c)(2)"; when tax_exempt_entity_kind_4965(e, Section170cOrganization); then tax_exempt_entity_paragraphs_1_to_3(e); }
rule EntityParagraph3(e: Person) defeasible { label en official "4965(c)(3)"; when tax_exempt_entity_kind_4965(e, IndianTribalGovernment); then tax_exempt_entity_paragraphs_1_to_3(e); }

// (e): prohibited tax shelter transaction.
@source(IRC_S4965_E, coverage = exact, quote = "The term \"listed transaction\" has the meaning given such term by section 6707A(c)(2).")
pub relation listed_transaction(a: ExciseAct) kind empirical {
    label en official "section 4965(e)(1)(B): a listed transaction within section 6707A(c)(2) (EXTERNAL_DEPENDENCY)";
}
pub relation confidential_or_contractual_protection_transaction(a: ExciseAct) kind empirical {
    label en official "section 4965(e)(1)(C): a confidential transaction or a transaction with contractual protection (as defined by regulations)";
}
pub relation reportable_transaction(a: ExciseAct) kind empirical {
    label en official "section 4965(e)(1)(C): a reportable transaction within section 6707A(c)(1) (EXTERNAL_DEPENDENCY)";
}
@source(IRC_S4965_E, coverage = exact, quote = "The term \"prohibited reportable transaction\" means any confidential transaction or any transaction with contractual protection (as defined under regulations prescribed by the Secretary) which is a reportable transaction (as defined in section 6707A(c)(1)).")
pub relation prohibited_reportable_transaction(a: ExciseAct) kind institutional {
    label en official "section 4965(e)(1)(C): a confidential or contractually protected transaction which is a reportable transaction";
}
rule ProhibitedReportableTransaction(a: ExciseAct) defeasible {
    label en official "section 4965(e)(1)(C)";
    when confidential_or_contractual_protection_transaction(a);
    when reportable_transaction(a);
    then prohibited_reportable_transaction(a);
}
@source(IRC_S4965_E, coverage = exact, quote = "The term \"prohibited tax shelter transaction\" means—")
pub relation prohibited_tax_shelter_transaction(a: ExciseAct) kind institutional {
    label en official "section 4965(e)(1)(A): a listed transaction or a prohibited reportable transaction";
}
rule PtstListed(a: ExciseAct) defeasible { label en official "4965(e)(1)(A)(i): any listed transaction"; when listed_transaction(a); then prohibited_tax_shelter_transaction(a); }
rule PtstReportable(a: ExciseAct) defeasible { label en official "4965(e)(1)(A)(ii): any prohibited reportable transaction"; when prohibited_reportable_transaction(a); then prohibited_tax_shelter_transaction(a); }
pub relation determined_listed_after_entity_became_party(a: ExciseAct, e: Person) kind empirical {
    label en official "section 4965(e)(2): the Secretary determined the transaction to be a listed transaction at a time after the entity became a party to it";
}
pub relation prohibited_reportable_when_entity_became_party(a: ExciseAct, e: Person) kind empirical {
    label en official "section 4965(e)(2): the transaction was a prohibited reportable transaction at the time the entity became a party";
}
@source(IRC_S4965_E, coverage = exact, quote = "The term \"subsequently listed transaction\" means any transaction to which a tax-exempt entity is a party and which is determined by the Secretary to be a listed transaction at any time after the entity has become a party to the transaction.")
pub relation subsequently_listed_transaction(a: ExciseAct, e: Person) kind institutional {
    label en official "section 4965(e)(2): a transaction the Secretary listed after the entity became a party, other than one that was a prohibited reportable transaction when the entity became a party";
}
rule SubsequentlyListedTransaction(a: ExciseAct, e: Person) defeasible {
    label en official "section 4965(e)(2)";
    when tax_exempt_entity_4965(e);
    when determined_listed_after_entity_became_party(a, e);
    unless prohibited_reportable_when_entity_became_party(a, e) and determined_listed_after_entity_became_party(a, e);
    then subsequently_listed_transaction(a, e);
}

// (a)(1): the years for which the entity pays.
pub relation entity_party_to_transaction_at_time_became(a: ExciseAct, e: Person, y0: TaxableYear) kind empirical {
    label en official "section 4965(a)(1)(A): the entity became a party to the transaction in this taxable year";
}
pub relation entity_party_to_transaction_in_year(a: ExciseAct, e: Person, y: TaxableYear) kind empirical {
    label en official "section 4965(a)(1)(B): the entity is a party to the transaction at any time during the taxable year";
}
pub relation entity_became_party_on(a: ExciseAct, e: Person, on: Date) kind empirical {
    label en official "section 4965(b)(1)(B): the date the entity became a party to the transaction";
}
@source(IRC_S4965_B, coverage = exact, quote = "In the case of a tax-exempt entity which knew, or had reason to know, a transaction was a prohibited tax shelter transaction at the time the entity became a party to the transaction")
external judgment relation entity_knew_or_had_reason_to_know_pts(a: ExciseAct, e: Person) {
    authority TaxCourt;
    label en official "section 4965(b)(1)(B): the entity knew, or had reason to know, that the transaction was a prohibited tax shelter transaction when it became a party (evaluative standard, DECISION-0194)";
}
@source(IRC_S4965_A, coverage = exact, quote = "such entity shall pay a tax for the taxable year in which the entity becomes such a party and any subsequent taxable year in the amount determined under subsection (b)(1).")
pub relation entity_liable_for_year_4965(a: ExciseAct, e: Person, y: TaxableYear) kind institutional {
    label en official "section 4965(a)(1): the entity pays the tax for the year it became a party to a prohibited tax shelter transaction and every later year, or for a year in which it is a party to a subsequently listed transaction";
}
rule EntityLiableFromYearBecameParty(a: ExciseAct, e: Person, y0: TaxableYear, y: TaxableYear, d0: Date, d: Date) defeasible {
    label en official "section 4965(a)(1)(A): the year of becoming a party and any subsequent taxable year";
    when tax_exempt_entity_paragraphs_1_to_3(e);
    when prohibited_tax_shelter_transaction(a);
    when entity_party_to_transaction_at_time_became(a, e, y0);
    when us.irc.core::begins(y0, d0);
    when us.irc.core::begins(y, d);
    when d >= d0;
    unless subsequently_listed_transaction(a, e) and entity_party_to_transaction_at_time_became(a, e, y0) and us.irc.core::begins(y0, d0) and us.irc.core::begins(y, d);
    then entity_liable_for_year_4965(a, e, y);
}
rule EntityLiableForSubsequentlyListed(a: ExciseAct, e: Person, y: TaxableYear) defeasible {
    label en official "section 4965(a)(1)(B): party to a subsequently listed transaction at any time during the taxable year";
    when tax_exempt_entity_paragraphs_1_to_3(e);
    when subsequently_listed_transaction(a, e);
    when entity_party_to_transaction_in_year(a, e, y);
    then entity_liable_for_year_4965(a, e, y);
}

// (b)(1): the amount.
pub relation highest_section_11_rate(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "section 4965(b)(1)(A): the highest rate of tax under section 11 for the taxable year (EXTERNAL_DEPENDENCY on us.irc.corporations)";
}
pub relation net_income_attributable_to_transaction(a: ExciseAct, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4965(b)(1)(A)(i)(I), (B)(i): the entity's net income for the year (after taking into account other tax imposed by this subtitle with respect to the transaction) attributable to the transaction";
}
pub relation net_income_allocable_to_post_listing_period(a: ExciseAct, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4965(b)(1)(A)(i)(II): for a subsequently listed transaction, net income attributable to it and properly allocable to the period beginning on the later of the listing date and the first day of the year (allocation guidance is section 4965(f) — G2507)";
}
pub relation proceeds_attributable_to_transaction(a: ExciseAct, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4965(b)(1)(A)(ii)(I), (B)(ii): proceeds received by the entity for the year attributable to the transaction";
}
pub relation proceeds_allocable_to_post_listing_period(a: ExciseAct, e: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4965(b)(1)(A)(ii)(II): for a subsequently listed transaction, proceeds attributable to it and properly allocable to the post-listing period";
}
@source(IRC_S4965_B, coverage = exact, quote = "the amount of the tax imposed under subsection (a)(1) with respect to any transaction for a taxable year shall be an amount equal to the product of the highest rate of tax under section 11, and the greater of—")
pub relation tax_shelter_entity_tax(a: ExciseAct, e: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4965(a)(1), (b)(1): the entity's tax for the taxable year";
}
rule EntityTaxOrdinary(a: ExciseAct, e: Person, y: TaxableYear, r: Decimal, ni: Money, pr: Money) defeasible {
    label en official "section 4965(b)(1)(A): highest section 11 rate × the greater of net income attributable and 75 percent of proceeds attributable (a prohibited tax shelter transaction other than a subsequently listed one)";
    when entity_liable_for_year_4965(a, e, y);
    when highest_section_11_rate(y, r);
    when net_income_attributable_to_transaction(a, e, y, ni);
    when proceeds_attributable_to_transaction(a, e, y, pr);
    unless subsequently_listed_transaction(a, e) and net_income_attributable_to_transaction(a, e, y, ni) and proceeds_attributable_to_transaction(a, e, y, pr) and highest_section_11_rate(y, r);
    unless knowing_increase_applies_4965(a, e) and net_income_attributable_to_transaction(a, e, y, ni) and proceeds_attributable_to_transaction(a, e, y, pr) and highest_section_11_rate(y, r);
    then tax_shelter_entity_tax(a, e, y, round(r * max(ni, pr * ProceedsShare4965), 2, "HALF_UP"));
}
rule EntityTaxSubsequentlyListed(a: ExciseAct, e: Person, y: TaxableYear, r: Decimal, ni: Money, pr: Money) defeasible {
    label en official "section 4965(b)(1)(A)(i)(II), (ii)(II): for a subsequently listed transaction the amounts are those allocable to the period beginning on the later of the listing date and the first day of the year";
    when entity_liable_for_year_4965(a, e, y);
    when subsequently_listed_transaction(a, e);
    when highest_section_11_rate(y, r);
    when net_income_allocable_to_post_listing_period(a, e, y, ni);
    when proceeds_allocable_to_post_listing_period(a, e, y, pr);
    then tax_shelter_entity_tax(a, e, y, round(r * max(ni, pr * ProceedsShare4965), 2, "HALF_UP"));
}
relation knowing_increase_applies_4965(a: ExciseAct, e: Person) kind institutional {
    label en unofficial "section 4965(b)(1)(B) applies: the entity knew or had reason to know, and became a party after the enactment date (May 17, 2006)";
}
rule KnowingIncreaseApplies4965(a: ExciseAct, e: Person, d: Date) defeasible {
    label en official "section 4965(b)(1)(B), last sentence: not applicable to a transaction the entity became a party to on or before the date of enactment";
    when entity_knew_or_had_reason_to_know_pts(a, e);
    when entity_became_party_on(a, e, d);
    when d > @2006-05-17;
    then knowing_increase_applies_4965(a, e);
}
@source(IRC_S4965_B, coverage = exact, quote = "the amount of the tax imposed under subsection (a)(1)(A) with respect to any transaction for a taxable year shall be the greater of—")
rule EntityTaxKnowing(a: ExciseAct, e: Person, y: TaxableYear, ni: Money, pr: Money) defeasible {
    label en official "section 4965(b)(1)(B): for an entity that knew or had reason to know, the greater of 100 percent of net income and 75 percent of proceeds";
    when entity_liable_for_year_4965(a, e, y);
    when knowing_increase_applies_4965(a, e);
    when net_income_attributable_to_transaction(a, e, y, ni);
    when proceeds_attributable_to_transaction(a, e, y, pr);
    unless subsequently_listed_transaction(a, e) and net_income_attributable_to_transaction(a, e, y, ni) and proceeds_attributable_to_transaction(a, e, y, pr);
    then tax_shelter_entity_tax(a, e, y, max(ni * KnowingNetIncomeShare4965, pr * ProceedsShare4965));
}

// (d), (a)(2), (b)(2): entity manager.
pub relation entity_manager_authority_4965(m: Person, e: Person) kind empirical {
    label en official "section 4965(d)(1)(A): the person has authority or responsibility similar to that of an officer, director, or trustee of the entity";
}
pub relation entity_manager_authority_over_act_4965(m: Person, e: Person) kind empirical {
    label en official "section 4965(d)(1)(B): with respect to the act, the person has authority or responsibility with respect to it";
}
pub relation person_approving_or_causing_entity_participation(m: Person, e: Person) kind empirical {
    label en official "section 4965(d)(2): for a 4979(e), 529, 457(b) or 4973(a) entity, the person who approves or otherwise causes the entity to be a party to the transaction";
}
@source(IRC_S4965_D, coverage = exact, quote = "For purposes of this section, the term \"entity manager\" means—")
pub relation entity_manager_4965(m: Person, e: Person) kind institutional {
    label en official "section 4965(d): the entity manager";
}
rule EntityManagerByAuthority(m: Person, e: Person) defeasible {
    label en official "section 4965(d)(1)(A): for a paragraph (1)-(3) entity, a person with authority similar to an officer, director or trustee";
    when tax_exempt_entity_paragraphs_1_to_3(e);
    when entity_manager_authority_4965(m, e);
    then entity_manager_4965(m, e);
}
rule EntityManagerByActAuthority(m: Person, e: Person) defeasible {
    label en official "section 4965(d)(1)(B): for a paragraph (1)-(3) entity, the person having authority or responsibility with respect to the act";
    when tax_exempt_entity_paragraphs_1_to_3(e);
    when entity_manager_authority_over_act_4965(m, e);
    then entity_manager_4965(m, e);
}
rule EntityManagerByApproval(m: Person, e: Person) defeasible {
    label en official "section 4965(d)(2): for other entities, the person who approves or causes the entity to be a party";
    when tax_exempt_entity_4965(e);
    when person_approving_or_causing_entity_participation(m, e);
    unless tax_exempt_entity_paragraphs_1_to_3(e) and person_approving_or_causing_entity_participation(m, e);
    then entity_manager_4965(m, e);
}
pub relation manager_approvals_in_year(m: Person, e: Person, a: ExciseAct, y: TaxableYear, n: Integer) kind empirical {
    label en official "section 4965(a)(2), (b)(2): the number of approvals (or other acts causing participation) by the manager in the taxable year";
}
@source(IRC_S4965_A, coverage = exact, quote = "and knows or has reason to know that the transaction is a prohibited tax shelter transaction")
external judgment relation manager_knew_or_had_reason_to_know_pts(m: Person, a: ExciseAct) {
    authority TaxCourt;
    label en official "section 4965(a)(2): the entity manager knows or has reason to know that the transaction is a prohibited tax shelter transaction";
}
@source(IRC_S4965_B, coverage = exact, quote = "the amount of the tax imposed under subsection (a)(2) shall be $20,000 for each approval (or other act causing participation) described in subsection (a)(2).")
pub relation tax_shelter_manager_tax(m: Person, e: Person, a: ExciseAct, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4965(a)(2), (b)(2): $20,000 for each approval by an entity manager who knew or had reason to know";
}
rule TaxShelterManagerTax(m: Person, e: Person, a: ExciseAct, y: TaxableYear, n: Integer) defeasible {
    label en official "section 4965(a)(2), (b)(2): $20,000 × approvals";
    when tax_exempt_entity_4965(e);
    when entity_manager_4965(m, e);
    when prohibited_tax_shelter_transaction(a);
    when manager_approvals_in_year(m, e, a, y, n);
    when manager_knew_or_had_reason_to_know_pts(m, a);
    then tax_shelter_manager_tax(m, e, a, y, EntityManagerTax4965 * n);
}

// ============================================================================
// Sections 4966 and 4967 — donor advised funds
// ============================================================================

pub relation sponsoring_organization_described_in_170c(o: Person) kind empirical {
    label en official "section 4966(d)(1)(A): described in section 170(c) (other than paragraph (1) thereof, and without regard to paragraph (2)(A))";
}
pub relation organization_is_private_foundation_509a(o: Person, y: TaxableYear) kind empirical {
    label en official "section 4966(d)(1)(B): the organization is a private foundation (as defined in section 509(a)) for the taxable year";
}
pub relation maintains_donor_advised_fund(o: Person, fund: Person) kind empirical {
    label en official "section 4966(d)(1)(C): the organization maintains the donor advised fund";
}
@source(IRC_S4966_D, coverage = exact, quote = "The term \"sponsoring organization\" means any organization which—")
pub relation sponsoring_organization(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4966(d)(1): an organization described in 170(c) (other than the United States), not a private foundation, that maintains one or more donor advised funds";
}
rule SponsoringOrganization(o: Person, y: TaxableYear, fund: Person) defeasible {
    label en official "section 4966(d)(1)(A)-(C)";
    when sponsoring_organization_described_in_170c(o);
    when maintains_donor_advised_fund(o, fund);
    when us.irc.core::year_of(o, y);
    unless organization_is_private_foundation_509a(o, y) and sponsoring_organization_described_in_170c(o) and maintains_donor_advised_fund(o, fund) and us.irc.core::year_of(o, y);
    then sponsoring_organization(o, y);
}
pub relation fund_separately_identified_by_donor_contributions(fund: Person) kind empirical {
    label en official "section 4966(d)(2)(A)(i): the fund or account is separately identified by reference to contributions of a donor or donors";
}
pub relation fund_owned_and_controlled_by_sponsor(fund: Person, sponsor: Person) kind empirical {
    label en official "section 4966(d)(2)(A)(ii): the fund is owned and controlled by a sponsoring organization";
}
pub relation donor_has_advisory_privileges(fund: Person) kind empirical {
    label en official "section 4966(d)(2)(A)(iii): a donor (or a person appointed or designated by the donor) has, or reasonably expects to have, advisory privileges over distributions or investment by reason of donor status";
}
pub relation fund_distributes_only_to_single_identified_organization(fund: Person) kind empirical {
    label en official "section 4966(d)(2)(B)(i): the fund makes distributions only to a single identified organization or governmental entity";
}
pub relation fund_is_committee_advised_objective_travel_study_grants(fund: Person) kind empirical {
    label en official "section 4966(d)(2)(B)(ii)(I)-(III): the fund advises only on individual travel/study grants through a sponsor-appointed committee not controlled by the donor persons, all grants awarded on an objective and nondiscriminatory basis under a board-approved procedure meeting section 4945(g)";
}
pub relation secretary_exempts_fund_from_daf_treatment(fund: Person) kind institutional {
    label en official "section 4966(d)(2)(C): the Secretary exempts the fund (committee-advised not controlled by the donor, or benefiting a single identified charitable purpose) from treatment as a donor advised fund";
}
@source(IRC_S4966_D, coverage = exact, quote = "Except as provided in subparagraph (B) or (C), the term \"donor advised fund\" means a fund or account—")
pub relation donor_advised_fund(fund: Person, sponsor: Person) kind institutional {
    label en official "section 4966(d)(2): a separately identified, sponsor-owned fund over which a donor has advisory privileges, except the (B) and (C) exceptions";
}
rule DonorAdvisedFund(fund: Person, sponsor: Person) defeasible {
    label en official "section 4966(d)(2)(A), (B), (C)";
    when fund_separately_identified_by_donor_contributions(fund);
    when fund_owned_and_controlled_by_sponsor(fund, sponsor);
    when donor_has_advisory_privileges(fund);
    unless fund_distributes_only_to_single_identified_organization(fund) and fund_owned_and_controlled_by_sponsor(fund, sponsor);
    unless fund_is_committee_advised_objective_travel_study_grants(fund) and fund_owned_and_controlled_by_sponsor(fund, sponsor);
    unless secretary_exempts_fund_from_daf_treatment(fund) and fund_owned_and_controlled_by_sponsor(fund, sponsor);
    then donor_advised_fund(fund, sponsor);
}
pub relation officer_director_trustee_of_sponsor(p: Person, sponsor: Person) kind empirical {
    label en official "section 4966(d)(3)(A): an officer, director, or trustee of the sponsoring organization (or with similar powers or responsibilities)";
}
pub relation employee_with_authority_over_sponsor_act(p: Person, sponsor: Person) kind empirical {
    label en official "section 4966(d)(3)(B): with respect to any act (or failure to act), an employee of the sponsoring organization having authority or responsibility with respect to it";
}
@source(IRC_S4966_D, coverage = exact, quote = "The term \"fund manager\" means, with respect to any sponsoring organization—")
pub relation fund_manager(p: Person, sponsor: Person) kind institutional {
    label en official "section 4966(d)(3): the fund manager of a sponsoring organization";
}
rule FundManagerOfficer(p: Person, sponsor: Person) defeasible { label en official "4966(d)(3)(A)"; when officer_director_trustee_of_sponsor(p, sponsor); then fund_manager(p, sponsor); }
rule FundManagerEmployee(p: Person, sponsor: Person) defeasible { label en official "4966(d)(3)(B)"; when employee_with_authority_over_sponsor_act(p, sponsor); then fund_manager(p, sponsor); }

// (d)(4): disqualified supporting organization.
pub relation type_iii_supporting_organization_not_functionally_integrated(o: Person) kind empirical {
    label en official "section 4966(d)(4)(A)(i): a type III supporting organization (4943(f)(5)(A)) that is not functionally integrated (4943(f)(5)(B))";
}
pub relation type_i_or_ii_supporting_organization_4966(o: Person) kind empirical {
    label en official "section 4966(d)(4)(B): meets 509(a)(3)(A) and (C) and is operated, supervised or controlled by, or supervised or controlled in connection with, 509(a)(1)-(2) organizations";
}
pub relation functionally_integrated_type_iii_4966(o: Person) kind empirical {
    label en official "section 4966(d)(4)(C): a functionally integrated type III supporting organization";
}
pub relation donor_controls_supported_organization(o: Person) kind empirical {
    label en official "section 4966(d)(4)(A)(ii)(I): the donor or a person designated by the donor for advice (and related parties) directly or indirectly controls a supported organization of the organization";
}
pub relation secretary_determines_distribution_inappropriate(o: Person) kind institutional {
    label en official "section 4966(d)(4)(A)(ii)(II): the Secretary determines by regulations that a distribution to the organization is otherwise inappropriate";
}
@source(IRC_S4966_D, coverage = exact, quote = "The term \"disqualified supporting organization\" means, with respect to any distribution—")
pub relation disqualified_supporting_organization(o: Person) kind institutional {
    label en official "section 4966(d)(4): a non-integrated type III supporting organization, or a type I/II or functionally integrated type III supporting organization whose supported organization is donor-controlled or as to which the Secretary so determines";
}
rule DisqualifiedSupportingOrganizationTypeIII(o: Person) defeasible { label en official "4966(d)(4)(A)(i)"; when type_iii_supporting_organization_not_functionally_integrated(o); then disqualified_supporting_organization(o); }
rule DisqualifiedSupportingOrganizationDonorControl(o: Person) defeasible {
    label en official "4966(d)(4)(A)(ii)(I): described in (B) or (C) and donor-controlled";
    when type_i_or_ii_supporting_organization_4966(o);
    when donor_controls_supported_organization(o);
    then disqualified_supporting_organization(o);
}
rule DisqualifiedSupportingOrganizationDonorControlIntegrated(o: Person) defeasible {
    label en official "4966(d)(4)(A)(ii)(I): functionally integrated type III (C) and donor-controlled";
    when functionally_integrated_type_iii_4966(o);
    when donor_controls_supported_organization(o);
    then disqualified_supporting_organization(o);
}
rule DisqualifiedSupportingOrganizationSecretary(o: Person) defeasible {
    label en official "4966(d)(4)(A)(ii)(II): described in (B) or (C) and the Secretary so determines";
    when type_i_or_ii_supporting_organization_4966(o);
    when secretary_determines_distribution_inappropriate(o);
    then disqualified_supporting_organization(o);
}

// (c): taxable distribution.
pub relation daf_distribution_fund(a: ExciseAct, fund: Person) kind empirical {
    label en unofficial "the donor advised fund the distribution is made from";
}
pub relation daf_distribution_sponsor(a: ExciseAct, sponsor: Person) kind empirical {
    label en unofficial "the sponsoring organization of the fund";
}
pub relation daf_distribution_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount of the distribution";
}
pub relation daf_distribution_recipient(a: ExciseAct, r: Person) kind empirical {
    label en unofficial "the recipient of the distribution";
}
pub relation recipient_is_natural_person(r: Person) kind empirical {
    label en official "section 4966(c)(1)(A): the recipient is a natural person";
}
pub relation distribution_for_170c2B_purpose(a: ExciseAct) kind empirical {
    label en official "section 4966(c)(1)(B)(i): the distribution is for a purpose specified in section 170(c)(2)(B)";
}
pub relation sponsor_exercises_expenditure_responsibility(a: ExciseAct) kind empirical {
    label en official "section 4966(c)(1)(B)(ii): the sponsoring organization exercises expenditure responsibility with respect to the distribution in accordance with section 4945(h)";
}
pub relation recipient_described_in_170b1A(r: Person) kind empirical {
    label en official "section 4966(c)(2)(A): the recipient is an organization described in section 170(b)(1)(A)";
}
pub relation recipient_is_sponsoring_organization_of_fund(r: Person, a: ExciseAct) kind empirical {
    label en official "section 4966(c)(2)(B): the recipient is the sponsoring organization of the donor advised fund";
}
pub relation recipient_is_donor_advised_fund(r: Person) kind empirical {
    label en official "section 4966(c)(2)(C): the recipient is another donor advised fund";
}
@source(IRC_S4966_C, coverage = exact, quote = "The term \"taxable distribution\" means any distribution from a donor advised fund—")
pub relation taxable_distribution(a: ExciseAct) kind institutional {
    label en official "section 4966(c): a distribution from a donor advised fund to a natural person, or to another person for a non-170(c)(2)(B) purpose or without expenditure responsibility, other than the (c)(2) exceptions";
}
rule TaxableDistributionToNaturalPerson(a: ExciseAct, r: Person, fund: Person, s: Person) defeasible {
    label en official "section 4966(c)(1)(A): a distribution to any natural person";
    when excise_act_kind(a, DonorAdvisedFundDistribution);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when daf_distribution_recipient(a, r);
    when recipient_is_natural_person(r);
    unless recipient_described_in_170b1A(r) and daf_distribution_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s) and recipient_is_natural_person(r);
    then taxable_distribution(a);
}
rule TaxableDistributionWrongPurpose(a: ExciseAct, r: Person, fund: Person, s: Person) defeasible {
    label en official "section 4966(c)(1)(B)(i): to any other person for a purpose other than 170(c)(2)(B)";
    when excise_act_kind(a, DonorAdvisedFundDistribution);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when daf_distribution_recipient(a, r);
    unless distribution_for_170c2B_purpose(a) and daf_distribution_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    unless recipient_is_natural_person(r) and daf_distribution_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    unless taxable_distribution_exception_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    then taxable_distribution(a);
}
rule TaxableDistributionNoExpenditureResponsibility(a: ExciseAct, r: Person, fund: Person, s: Person) defeasible {
    label en official "section 4966(c)(1)(B)(ii): to any other person without expenditure responsibility under 4945(h)";
    when excise_act_kind(a, DonorAdvisedFundDistribution);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when daf_distribution_recipient(a, r);
    unless sponsor_exercises_expenditure_responsibility(a) and daf_distribution_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    unless recipient_is_natural_person(r) and daf_distribution_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    unless taxable_distribution_exception_recipient(a, r) and daf_distribution_fund(a, fund) and donor_advised_fund(fund, s);
    then taxable_distribution(a);
}
pub relation taxable_distribution_exception_recipient(a: ExciseAct, r: Person) kind institutional {
    label en official "section 4966(c)(2): the recipient is a 170(b)(1)(A) organization other than a disqualified supporting organization, the sponsoring organization, or another donor advised fund";
}
rule DistributionExceptionPublicCharity(a: ExciseAct, r: Person) defeasible {
    label en official "section 4966(c)(2)(A): to a 170(b)(1)(A) organization other than a disqualified supporting organization";
    when daf_distribution_recipient(a, r);
    when recipient_described_in_170b1A(r);
    unless disqualified_supporting_organization(r) and daf_distribution_recipient(a, r) and recipient_described_in_170b1A(r);
    then taxable_distribution_exception_recipient(a, r);
}
rule DistributionExceptionSponsor(a: ExciseAct, r: Person) defeasible {
    label en official "section 4966(c)(2)(B): to the sponsoring organization of the fund";
    when daf_distribution_recipient(a, r);
    when recipient_is_sponsoring_organization_of_fund(r, a);
    then taxable_distribution_exception_recipient(a, r);
}
rule DistributionExceptionOtherDaf(a: ExciseAct, r: Person) defeasible {
    label en official "section 4966(c)(2)(C): to any other donor advised fund";
    when daf_distribution_recipient(a, r);
    when recipient_is_donor_advised_fund(r);
    then taxable_distribution_exception_recipient(a, r);
}

@source(IRC_S4966_A, coverage = exact, quote = "There is hereby imposed on each taxable distribution a tax equal to 20 percent of the amount thereof. The tax imposed by this paragraph shall be paid by the sponsoring organization with respect to the donor advised fund.")
rule InitialTaxOnSponsorTaxableDistribution(a: ExciseAct, s: Person, amt: Money, fund: Person) defeasible {
    label en official "section 4966(a)(1): 20 percent of the taxable distribution, paid by the sponsoring organization";
    when taxable_distribution(a);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when daf_distribution_amount(a, amt);
    then initial_tax(a, s, amt * DafDistributionTaxRateSponsor);
}
@source(IRC_S4966_A, coverage = exact, quote = "knowing that it is a taxable distribution")
external judgment relation fund_manager_knew_distribution_taxable(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4966(a)(2): the fund manager agreed to the distribution knowing that it is a taxable distribution (no reasonable-cause exception is stated in this paragraph)";
}
pub relation fund_manager_agreed_to_distribution(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4966(a)(2): the fund manager agreed to the making of the distribution";
}
@source(IRC_S4966_A, coverage = exact, quote = "a tax equal to 5 percent of the amount thereof. The tax imposed by this paragraph shall be paid by any fund manager who agreed to the making of the distribution.")
rule InitialTaxOnFundManagerTaxableDistribution(a: ExciseAct, p: Person, amt: Money, fund: Person, s: Person) defeasible {
    label en official "section 4966(a)(2), (b)(2): 5 percent of the distribution on a fund manager who agreed knowing it is taxable, capped at $10,000";
    when taxable_distribution(a);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when fund_manager(p, s);
    when fund_manager_agreed_to_distribution(a, p);
    when fund_manager_knew_distribution_taxable(a, p);
    when daf_distribution_amount(a, amt);
    then initial_tax(a, p, min(amt * DafDistributionTaxRateFundManager, DafFundManagerTaxCap4966));
}
@source(IRC_S4966_B, coverage = exact, quote = "If more than one person is liable under subsection (a)(2) with respect to the making of a taxable distribution, all such persons shall be jointly and severally liable under such paragraph with respect to such distribution.")
pub relation daf_distribution_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4966(b)(1): fund managers both liable under (a)(2) for the same distribution are jointly and severally liable";
}
rule JointAndSeveralDafFundManagers(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money, fund: Person, s: Person) defeasible {
    label en official "section 4966(b)(1)";
    when taxable_distribution(a);
    when daf_distribution_fund(a, fund);
    when donor_advised_fund(fund, s);
    when fund_manager(p1, s);
    when fund_manager(p2, s);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then daf_distribution_jointly_and_severally_liable(a, p1, p2);
}
rule TaxableEventDafDistribution(a: ExciseAct) defeasible { label en official "4963(c): section 4966"; when excise_act_kind(a, DonorAdvisedFundDistribution); when taxable_distribution(a); then taxable_event(a); }
rule QualifiedFirstTierTax4966(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter G, section 4966(a)"; when excise_act_kind(a, DonorAdvisedFundDistribution); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }

// 4967.
pub relation person_described_in_4958f7_for_daf(p: Person, fund: Person) kind empirical {
    label en official "section 4967(d): the person is described in section 4958(f)(7) with respect to the donor advised fund (a donor, donor advisor, or related person)";
}
pub relation daf_advice_fund(a: ExciseAct, fund: Person) kind empirical {
    label en unofficial "the donor advised fund the advised distribution is made from";
}
pub relation daf_advice_sponsor(a: ExciseAct, s: Person) kind empirical {
    label en unofficial "the sponsoring organization that makes the advised distribution";
}
pub relation daf_advice_advisor(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the person described in 4967(d) who gave the advice";
}
pub relation daf_advice_beneficiary(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the person described in 4967(d) who received a benefit as a result of the distribution";
}
pub relation daf_benefit_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount of the benefit conferred";
}
@source(IRC_S4967_A, coverage = exact, quote = "receiving, directly or indirectly, a more than incidental benefit as a result of such distribution")
external judgment relation benefit_is_more_than_incidental(a: ExciseAct) {
    authority Secretary;
    label en official "section 4967(a)(1): the benefit received as a result of the distribution is more than incidental (evaluative standard, DECISION-0194)";
}
pub relation tax_imposed_under_4958_on_distribution(a: ExciseAct) kind empirical {
    label en official "section 4967(b): a tax has been imposed with respect to the distribution under section 4958";
}
@source(IRC_S4967_A, coverage = exact, quote = "a tax equal to 125 percent of such benefit. The tax imposed by this paragraph shall be paid by any person described in subsection (d) who advises as to the distribution or who receives such a benefit as a result of the distribution.")
rule InitialTaxOnAdvisorOrBeneficiary(a: ExciseAct, p: Person, amt: Money, fund: Person) defeasible {
    label en official "section 4967(a)(1): 125 percent of the benefit, paid by the 4967(d) person who advised or benefited; not imposed if a section 4958 tax was imposed on the distribution (4967(b))";
    when excise_act_kind(a, DonorAdvisedFundAdvice);
    when daf_advice_fund(a, fund);
    when person_described_in_4958f7_for_daf(p, fund);
    when benefit_is_more_than_incidental(a);
    when daf_benefit_amount(a, amt);
    when daf_advice_advisor(a, p);
    unless tax_imposed_under_4958_on_distribution(a) and daf_advice_fund(a, fund) and person_described_in_4958f7_for_daf(p, fund) and daf_benefit_amount(a, amt) and daf_advice_advisor(a, p);
    then initial_tax(a, p, amt * DafBenefitTaxRate4967);
}
rule InitialTaxOnBeneficiary4967(a: ExciseAct, p: Person, amt: Money, fund: Person) defeasible {
    label en official "section 4967(a)(1): the same 125 percent tax on a 4967(d) person who received the benefit";
    when excise_act_kind(a, DonorAdvisedFundAdvice);
    when daf_advice_fund(a, fund);
    when person_described_in_4958f7_for_daf(p, fund);
    when benefit_is_more_than_incidental(a);
    when daf_benefit_amount(a, amt);
    when daf_advice_beneficiary(a, p);
    unless tax_imposed_under_4958_on_distribution(a) and daf_advice_fund(a, fund) and person_described_in_4958f7_for_daf(p, fund) and daf_benefit_amount(a, amt) and daf_advice_beneficiary(a, p);
    then initial_tax(a, p, amt * DafBenefitTaxRate4967);
}
@source(IRC_S4967_A, coverage = exact, quote = "knowing that such distribution would confer a benefit described in paragraph (1)")
external judgment relation fund_manager_knew_distribution_confers_benefit(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4967(a)(2): the fund manager agreed to the distribution knowing that it would confer a benefit described in (a)(1)";
}
pub relation fund_manager_agreed_to_advised_distribution(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4967(a)(2): the fund manager agreed to the making of the distribution";
}
@source(IRC_S4967_A, coverage = exact, quote = "a tax equal to 10 percent of the amount of such benefit. The tax imposed by this paragraph shall be paid by any fund manager who agreed to the making of the distribution.")
rule InitialTaxOnFundManager4967(a: ExciseAct, p: Person, amt: Money, s: Person) defeasible {
    label en official "section 4967(a)(2), (c)(2): 10 percent of the benefit on a fund manager who agreed knowing, capped at $10,000; not imposed if a section 4958 tax was imposed on the distribution";
    when excise_act_kind(a, DonorAdvisedFundAdvice);
    when daf_advice_sponsor(a, s);
    when fund_manager(p, s);
    when fund_manager_agreed_to_advised_distribution(a, p);
    when fund_manager_knew_distribution_confers_benefit(a, p);
    when benefit_is_more_than_incidental(a);
    when daf_benefit_amount(a, amt);
    unless tax_imposed_under_4958_on_distribution(a) and fund_manager(p, s) and daf_benefit_amount(a, amt) and daf_advice_sponsor(a, s);
    then initial_tax(a, p, min(amt * DafBenefitFundManagerTaxRate4967, DafBenefitFundManagerTaxCap4967));
}
@source(IRC_S4967_C, coverage = exact, quote = "If more than one person is liable under paragraph (1) or (2) of subsection (a) with respect to a distribution described in subsection (a), all such persons shall be jointly and severally liable under such paragraph with respect to such distribution.")
pub relation daf_advice_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4967(c)(1): persons liable under the same paragraph for the same distribution are jointly and severally liable";
}
rule JointAndSeveralDafAdvice(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money) defeasible {
    label en official "section 4967(c)(1)";
    when excise_act_kind(a, DonorAdvisedFundAdvice);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then daf_advice_jointly_and_severally_liable(a, p1, p2);
}
rule TaxableEventDafAdvice(a: ExciseAct) defeasible { label en official "4963(c): section 4967"; when excise_act_kind(a, DonorAdvisedFundAdvice); then taxable_event(a); }
rule QualifiedFirstTierTax4967(a: ExciseAct, b: Person, m: Money) defeasible { label en official "4962(b): subchapter G, section 4967(a)"; when excise_act_kind(a, DonorAdvisedFundAdvice); when first_tier_tax(a, b, m); then qualified_first_tier_tax(a, b, m); }

// ============================================================================
// Section 4968 — private colleges and universities
// ============================================================================

pub relation eligible_educational_institution_25Af2(inst: Person, y: TaxableYear) kind empirical {
    label en official "section 4968(b)(1) (2024) / (c) (2025 amendment): an eligible educational institution as defined in section 25A(f)(2)";
}
pub relation tuition_paying_students_preceding_year(inst: Person, y: TaxableYear, n: Integer) kind empirical {
    label en official "sections 4968(b)(1)(A), (b)(2): the number of tuition-paying students during the preceding taxable year (daily average of full-time students, part-time on a full-time-equivalent basis)";
}
pub relation share_of_tuition_paying_students_in_united_states(inst: Person, y: TaxableYear, share: Decimal) kind empirical {
    label en official "sections 4968(b)(1)(B), (c)(2): the share of tuition-paying students located in the United States";
}
pub relation state_college_or_university_511a2B(inst: Person, y: TaxableYear) kind empirical {
    label en official "sections 4968(b)(1)(C), (c)(4): described in the first sentence of section 511(a)(2)(B) (State colleges and universities)";
}
pub relation own_nonexempt_use_assets_end_of_preceding_year(inst: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "sections 4968(b)(1)(D), (d)(1): the aggregate fair market value of the institution's assets at the end of the preceding taxable year other than those used directly in carrying out its exempt purpose";
}
pub relation number_of_students_for_endowment(inst: Person, y: TaxableYear, n: Integer) kind empirical {
    label en official "sections 4968(b)(2), (d)(2), (e): the number of students of the institution (daily average FTE)";
}

// (d) related organizations.
pub relation controls_or_controlled_by_institution(inst: Person, rel: Person) kind empirical {
    label en official "section 4968(d)(2)(A): the organization controls, or is controlled by, the institution";
}
pub relation controlled_by_persons_controlling_institution(inst: Person, rel: Person) kind empirical {
    label en official "section 4968(d)(2)(B): the organization is controlled by one or more persons which also control the institution";
}
pub relation supported_or_509a3_organization_of_institution(inst: Person, rel: Person, y: TaxableYear) kind empirical {
    label en official "section 4968(d)(2)(C): a supported organization (509(f)(3)) or a 509(a)(3) organization with respect to the institution during the taxable year";
}
@source(IRC_S4968_D, coverage = exact, quote = "the term \"related organization\" means, with respect to an educational institution, any organization which—")
pub relation related_organization_4968(inst: Person, rel: Person, y: TaxableYear) kind institutional {
    label en official "section 4968(d)(2): a related organization of the institution";
}
rule RelatedOrganization4968ByControl(inst: Person, rel: Person, y: TaxableYear) defeasible { label en official "4968(d)(2)(A)"; when controls_or_controlled_by_institution(inst, rel); when eligible_educational_institution_25Af2(inst, y); then related_organization_4968(inst, rel, y); }
rule RelatedOrganization4968ByCommonControl(inst: Person, rel: Person, y: TaxableYear) defeasible { label en official "4968(d)(2)(B)"; when controlled_by_persons_controlling_institution(inst, rel); when eligible_educational_institution_25Af2(inst, y); then related_organization_4968(inst, rel, y); }
rule RelatedOrganization4968BySupport(inst: Person, rel: Person, y: TaxableYear) defeasible { label en official "4968(d)(2)(C)"; when supported_or_509a3_organization_of_institution(inst, rel, y); when eligible_educational_institution_25Af2(inst, y); then related_organization_4968(inst, rel, y); }
pub relation related_organization_controlled_by_or_509a3_of_institution(inst: Person, rel: Person, y: TaxableYear) kind empirical {
    label en official "section 4968(d)(1)(B): the related organization is controlled by the institution or is described in section 509(a)(3) with respect to it for the taxable year";
}
pub relation related_organization_amounts_available_to_institution(inst: Person, rel: Person, y: TaxableYear) kind empirical {
    label en official "section 4968(d)(1)(B): the related organization's assets and net investment income are intended or available for the use or benefit of the institution";
}
pub relation related_organization_counted_for_another_institution(inst: Person, rel: Person, y: TaxableYear) kind empirical {
    label en official "section 4968(d)(1)(A): the related organization's amounts are taken into account for another educational institution";
}
pub relation related_organization_assets(inst: Person, rel: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4968(d)(1): the assets (other than exempt-use assets, end of preceding year) of the related organization";
}
pub relation related_organization_net_investment_income(inst: Person, rel: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4968(d)(1): the net investment income of the related organization";
}
relation counted_related_organization(inst: Person, rel: Person, y: TaxableYear) kind institutional {
    label en unofficial "the related organization's assets and net investment income are treated as the institution's";
}
@source(IRC_S4968_D, coverage = exact, quote = "assets and net investment income of any related organization with respect to an educational institution shall be treated as assets and net investment income, respectively, of the educational institution, except that—")
rule CountedRelatedOrganizationControlled(inst: Person, rel: Person, y: TaxableYear) defeasible {
    label en official "section 4968(d)(1): a controlled or 509(a)(3) related organization counts, unless already counted for another institution";
    when related_organization_4968(inst, rel, y);
    when related_organization_controlled_by_or_509a3_of_institution(inst, rel, y);
    unless related_organization_counted_for_another_institution(inst, rel, y) and related_organization_4968(inst, rel, y) and related_organization_controlled_by_or_509a3_of_institution(inst, rel, y);
    then counted_related_organization(inst, rel, y);
}
rule CountedRelatedOrganizationAvailable(inst: Person, rel: Person, y: TaxableYear) defeasible {
    label en official "section 4968(d)(1)(B): any other related organization counts only for amounts intended or available for the institution, unless already counted for another institution";
    when related_organization_4968(inst, rel, y);
    when related_organization_amounts_available_to_institution(inst, rel, y);
    unless related_organization_counted_for_another_institution(inst, rel, y) and related_organization_4968(inst, rel, y) and related_organization_amounts_available_to_institution(inst, rel, y);
    then counted_related_organization(inst, rel, y);
}
pub relation aggregate_assets_4968(inst: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 4968(b)(1)(D), (d)(1): the institution's own assets plus those of counted related organizations";
}
rule AggregateAssets4968(inst: Person, y: TaxableYear, own: Money) defeasible {
    label en official "own assets + counted related organizations' assets";
    when own_nonexempt_use_assets_end_of_preceding_year(inst, y, own);
    then aggregate_assets_4968(inst, y, own + sum(collect all a: Money, r: Person where counted_related_organization(inst, r, y) and related_organization_assets(inst, r, y, a), empty: 0.00 USD));
}
pub relation institution_own_net_investment_income(inst: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "sections 4968(c) (2024) / (f)(1) (2025 amendment): the institution's own net investment income determined under rules similar to section 4940(c) (G2506)";
}
pub relation student_loan_interest_income(inst: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4968(f)(2)(A) as amended: interest income from a student loan made by the institution (or a related organization) — gross investment income notwithstanding regulatory exceptions";
}
pub relation federally_subsidized_royalty_income(inst: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4968(f)(2)(B) as amended: otherwise regulatory-exempt royalty income from property developed with any Federal funds — gross investment income";
}
pub relation aggregate_net_investment_income_4968(inst: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "sections 4968(c), (d)(1): the institution's net investment income including that of counted related organizations (and, for years after 2025, the override items)";
}
rule AggregateNetInvestmentIncome4968Before2026(inst: Person, y: TaxableYear, own: Money, d: Date) defeasible {
    label en official "section 4968(c), (d)(1), 2024 text: own net investment income plus counted related organizations' (taxable years beginning before 2026)";
    when institution_own_net_investment_income(inst, y, own);
    when us.irc.core::begins(y, d);
    when d <= @2025-12-31;
    then aggregate_net_investment_income_4968(inst, y, own + sum(collect all a: Money, r: Person where counted_related_organization(inst, r, y) and related_organization_net_investment_income(inst, r, y, a), empty: 0.00 USD));
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "Net investment income shall be determined by taking into account any interest income from a student loan made by the applicable educational institution (or any related organization) as gross investment income.")
rule AggregateNetInvestmentIncome4968From2026(inst: Person, y: TaxableYear, own: Money, sl: Money, rs: Money, d: Date) defeasible {
    label en official "Pub. L. 119-21 section 70415: for taxable years beginning after 2025, student loan interest and federally-subsidized royalty income are added to the net investment income (the asserted own figure being determined without them, as under the regulatory exceptions)";
    effective [@2025-07-04, infinity);
    when institution_own_net_investment_income(inst, y, own);
    when student_loan_interest_income(inst, y, sl);
    when federally_subsidized_royalty_income(inst, y, rs);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    then aggregate_net_investment_income_4968(inst, y, own + sl + rs + sum(collect all a: Money, r: Person where counted_related_organization(inst, r, y) and related_organization_net_investment_income(inst, r, y, a), empty: 0.00 USD));
}

@source(IRC_S4968_B, coverage = exact, quote = "The term \"applicable educational institution\" means an eligible educational institution (as defined in section 25A(f)(2))—")
pub relation applicable_educational_institution(inst: Person, y: TaxableYear) kind institutional {
    label en official "section 4968(b)(1) (2024) / (c) (2025 amendment): an applicable educational institution";
}
@source(IRC_S4968_B, coverage = exact, quote = "which had at least 500 tuition-paying students during the preceding taxable year,")
rule ApplicableEducationalInstitution2024(inst: Person, y: TaxableYear, n: Integer, share: Decimal, assets: Money, students: Integer, d: Date) defeasible {
    label en official "section 4968(b)(1), 2024 text: at least 500 tuition-paying students, more than 50 percent in the United States, not a State college, and non-exempt-use assets of at least $500,000 per student (taxable years beginning before 2026)";
    when eligible_educational_institution_25Af2(inst, y);
    when us.irc.core::begins(y, d);
    when d <= @2025-12-31;
    when tuition_paying_students_preceding_year(inst, y, n);
    when n >= EducationMinimumStudents4968;
    when share_of_tuition_paying_students_in_united_states(inst, y, share);
    when share > 0.50;
    when aggregate_assets_4968(inst, y, assets);
    when number_of_students_for_endowment(inst, y, students);
    when students > 0;
    when assets >= EducationMinimumEndowmentPerStudent4968 * students;
    unless state_college_or_university_511a2B(inst, y) and eligible_educational_institution_25Af2(inst, y) and tuition_paying_students_preceding_year(inst, y, n) and share_of_tuition_paying_students_in_united_states(inst, y, share) and aggregate_assets_4968(inst, y, assets) and number_of_students_for_endowment(inst, y, students);
    then applicable_educational_institution(inst, y);
}
pub relation student_adjusted_endowment(inst: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4968(d) as amended by Pub. L. 119-21: the aggregate fair market value of the institution's non-exempt-use assets at the end of the preceding taxable year divided by the number of students";
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "the aggregate fair market value of the assets of such institution (determined as of the end of the preceding taxable year), other than those assets which are used directly in carrying out the institution’s exempt purpose, divided by")
rule StudentAdjustedEndowment(inst: Person, y: TaxableYear, assets: Money, students: Integer, d: Date) defeasible {
    label en official "section 4968(d) as amended: assets ÷ students, cents HALF_UP (JUDGMENT CALL: no rounding is named)";
    effective [@2025-07-04, infinity);
    when aggregate_assets_4968(inst, y, assets);
    when number_of_students_for_endowment(inst, y, students);
    when students > 0;
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    then student_adjusted_endowment(inst, y, div_round(assets, students * 1.0, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "which had at least 3,000 tuition-paying students during the preceding taxable year")
rule ApplicableEducationalInstitutionFrom2026(inst: Person, y: TaxableYear, n: Integer, share: Decimal, sae: Money, d: Date) defeasible {
    label en official "section 4968(c) as amended: at least 3,000 tuition-paying students, more than 50 percent in the United States, student adjusted endowment of at least $500,000, not a State college (taxable years beginning after 2025)";
    effective [@2025-07-04, infinity);
    when eligible_educational_institution_25Af2(inst, y);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    when tuition_paying_students_preceding_year(inst, y, n);
    when n >= EducationMinimumStudents4968;
    when share_of_tuition_paying_students_in_united_states(inst, y, share);
    when share > 0.50;
    when student_adjusted_endowment(inst, y, sae);
    when sae >= EducationMinimumEndowmentPerStudent4968;
    unless state_college_or_university_511a2B(inst, y) and eligible_educational_institution_25Af2(inst, y) and tuition_paying_students_preceding_year(inst, y, n) and share_of_tuition_paying_students_in_united_states(inst, y, share) and student_adjusted_endowment(inst, y, sae);
    then applicable_educational_institution(inst, y);
}

@source(IRC_S4968_A, coverage = exact, quote = "There is hereby imposed on each applicable educational institution for the taxable year a tax equal to 1.4 percent of the net investment income of such institution for the taxable year.")
pub relation college_investment_income_tax(inst: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4968(a): the tax of the applicable percentage of the net investment income";
}
rule CollegeInvestmentIncomeTax2024(inst: Person, y: TaxableYear, nii: Money, d: Date) defeasible {
    label en official "section 4968(a), 2024 text: 1.4 percent of net investment income (taxable years beginning before 2026); cents HALF_UP (JUDGMENT CALL)";
    when applicable_educational_institution(inst, y);
    when aggregate_net_investment_income_4968(inst, y, nii);
    when us.irc.core::begins(y, d);
    when d <= @2025-12-31;
    then college_investment_income_tax(inst, y, round(nii * EducationTaxRateBase4968, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "1.4 percent in the case of an institution with a student adjusted endowment of at least $500,000, and not in excess of $750,000")
rule CollegeInvestmentIncomeTaxTier1(inst: Person, y: TaxableYear, nii: Money, sae: Money, d: Date) defeasible {
    label en official "section 4968(b)(1) as amended: 1.4 percent for a student adjusted endowment of at least $500,000 and not over $750,000";
    effective [@2025-07-04, infinity);
    when applicable_educational_institution(inst, y);
    when aggregate_net_investment_income_4968(inst, y, nii);
    when student_adjusted_endowment(inst, y, sae);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    when sae >= EducationMinimumEndowmentPerStudent4968;
    when sae <= EducationEndowmentTier1Top4968;
    then college_investment_income_tax(inst, y, round(nii * EducationTaxRateBase4968, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "4 percent in the case of an institution with a student adjusted endowment in excess of $750,000, and not in excess of $2,000,000")
rule CollegeInvestmentIncomeTaxTier2(inst: Person, y: TaxableYear, nii: Money, sae: Money, d: Date) defeasible {
    label en official "section 4968(b)(2) as amended: 4 percent for a student adjusted endowment over $750,000 and not over $2,000,000";
    effective [@2025-07-04, infinity);
    when applicable_educational_institution(inst, y);
    when aggregate_net_investment_income_4968(inst, y, nii);
    when student_adjusted_endowment(inst, y, sae);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    when sae > EducationEndowmentTier1Top4968;
    when sae <= EducationEndowmentTier2Top4968;
    then college_investment_income_tax(inst, y, round(nii * EducationTaxRateTier2From2026, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70415, relation = derives_from, quote = "8 percent in the case of an institution with a student adjusted endowment in excess of $2,000,000")
rule CollegeInvestmentIncomeTaxTier3(inst: Person, y: TaxableYear, nii: Money, sae: Money, d: Date) defeasible {
    label en official "section 4968(b)(3) as amended: 8 percent for a student adjusted endowment over $2,000,000";
    effective [@2025-07-04, infinity);
    when applicable_educational_institution(inst, y);
    when aggregate_net_investment_income_4968(inst, y, nii);
    when student_adjusted_endowment(inst, y, sae);
    when us.irc.core::begins(y, d);
    when d > @2025-12-31;
    when sae > EducationEndowmentTier2Top4968;
    then college_investment_income_tax(inst, y, round(nii * EducationTaxRateTier3From2026, 2, "HALF_UP"));
}
