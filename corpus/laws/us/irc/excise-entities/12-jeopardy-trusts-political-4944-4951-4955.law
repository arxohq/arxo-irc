// Sections 4944 (jeopardizing investments), 4951-4953 (taxes on section
// 501(c)(21) black lung benefit trusts) and 4955 (political expenditures of
// section 501(c)(3) organizations). Stage 2 (DECISION-0379). All but 4953 are
// instantiations of the shared two-tier shape of
// 01-excise-act-and-taxable-period.law: the section-specific rules populate the
// shared `initial_tax` / `additional_tax` heads keyed by an `ExciseAct`.
//
// TAXABLE PERIOD
//  - 4944(e)(1) and 4951(e)(1): earliest of notice of deficiency, assessment,
//    and (removal from jeopardy / correction) — the shared machinery is reused;
//    4944(e)(2) "removal from jeopardy" feeds the shared candidate set.
//  - 4952(e)(2) and 4955(f)(4): the EARLIER OF notice and assessment only — the
//    correction date is NOT a period end. The shared machinery would wrongly
//    include a correction candidate, so a separate two-candidate period is
//    built below (`notice_or_assessment_period_ends`).
//  - "for each year (or part thereof) in the taxable period" multipliers are the
//    case-asserted count `taxable_period_years` (TECH-GAPS G130, unchanged).
//
// EVALUATIVE ELEMENTS (DECISION-0194): "jeopardize the carrying out of exempt
// purposes" (4944(a)(1)), the (c) program-related tests, "knowing", "not
// willful and due to reasonable cause" are external judgment relations with the
// court/Secretary as authority — never arithmetic guards.
//
// DEONTICS: the sections say "shall be paid by"; the payment duties are in
// 23-payment-duties.law over the shared tax heads. No section here states an
// independent prohibition.

use self::{
    Assessment,
    ExciseAct,
    ExciseActKind,
    IRC_S4944_A,
    IRC_S4944_B,
    IRC_S4944_C,
    IRC_S4944_D,
    IRC_S4944_E,
    IRC_S4951_A,
    IRC_S4951_B,
    IRC_S4951_C,
    IRC_S4951_D,
    IRC_S4951_E,
    IRC_S4952_A,
    IRC_S4952_B,
    IRC_S4952_C,
    IRC_S4952_D,
    IRC_S4953_A,
    IRC_S4953_B,
    IRC_S4955_A,
    IRC_S4955_B,
    IRC_S4955_C,
    IRC_S4955_D,
    IRC_S4955_E,
    IRC_S4955_F,
    Notice,
    Person,
    SelfDealingActType,
    TaxableYear,
    Trust,
    act_corrected_on,
    additional_tax,
    assessment_for_act,
    chapter_42_foundation,
    corrected_within_taxable_period,
    excise_act_kind,
    foundation_manager,
    initial_tax,
    notice_for_act,
    taxable_period_end_candidate,
    taxable_period_ends,
};

pub relation taxable_period_years(a: ExciseAct, n: Integer) kind empirical {
    label en unofficial "case-asserted count of years (or parts thereof) in the taxable period, the multiplier in the initial taxes of 4944(a) and 4951(a) (TECH-GAPS G130 — calendar-year counting over a date interval is not computed)";
}

// ============================================================================
// Section 4944 — investments which jeopardize charitable purpose
// ============================================================================

pub relation jeopardizing_investment_foundation(a: ExciseAct, f: Person) kind empirical {
    label en unofficial "the private foundation that made the investment";
}
pub relation jeopardizing_investment_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount so invested";
}
@source(IRC_S4944_A, coverage = exact, quote = "If a private foundation invests any amount in such a manner as to jeopardize the carrying out of any of its exempt purposes")
external judgment relation investment_jeopardizes_exempt_purposes(a: ExciseAct, f: Person) {
    authority Secretary;
    label en official "section 4944(a)(1): the foundation invested the amount in such a manner as to jeopardize the carrying out of any of its exempt purposes (evaluative standard, DECISION-0194 channel: the Secretary's determination, reviewable by the Tax Court)";
}
@source(IRC_S4944_C, coverage = exact, quote = "the primary purpose of which is to accomplish one or more of the purposes described in section 170(c)(2)(B)")
external judgment relation investment_primary_purpose_is_charitable(a: ExciseAct) {
    authority Secretary;
    label en official "section 4944(c): the primary purpose of the investment is to accomplish one or more purposes described in section 170(c)(2)(B)";
}
@source(IRC_S4944_C, coverage = exact, quote = "no significant purpose of which is the production of income or the appreciation of property")
external judgment relation investment_has_significant_income_or_appreciation_purpose(a: ExciseAct) {
    authority Secretary;
    label en official "section 4944(c): a significant purpose of the investment is the production of income or the appreciation of property";
}
@source(IRC_S4944_C, coverage = exact, quote = "shall not be considered as investments which jeopardize the carrying out of exempt purposes")
pub relation program_related_investment(a: ExciseAct) kind institutional {
    label en official "section 4944(c): a program-related investment is not an investment that jeopardizes the carrying out of exempt purposes";
}
rule ProgramRelatedInvestment(a: ExciseAct) defeasible {
    label en official "section 4944(c): primary charitable purpose and no significant income or appreciation purpose";
    when investment_primary_purpose_is_charitable(a);
    unless investment_has_significant_income_or_appreciation_purpose(a) and investment_primary_purpose_is_charitable(a);
    then program_related_investment(a);
}

@source(IRC_S4944_A, coverage = exact, quote = "If a private foundation invests any amount in such a manner as to jeopardize the carrying out of any of its exempt purposes")
pub relation jeopardizing_investment(a: ExciseAct) kind institutional {
    label en official "section 4944(a)(1): the investment jeopardizes the carrying out of the foundation's exempt purposes and is not excepted by 4944(c)";
}
rule JeopardizingInvestmentClassification(a: ExciseAct, f: Person, y: TaxableYear) defeasible {
    label en official "section 4944(a)(1), (c): a private foundation's investment that jeopardizes exempt purposes, other than a program-related investment, is a jeopardizing investment";
    when excise_act_kind(a, JeopardizingInvestment);
    when jeopardizing_investment_foundation(a, f);
    when investment_jeopardizes_exempt_purposes(a, f);
    when jeopardizing_investment_year(a, y);
    when chapter_42_foundation(f, y);  // Stage 2: private foundation or a split-interest trust (4947(a)(2)), not a 4948(b) organization
    unless program_related_investment(a) and jeopardizing_investment_foundation(a, f) and jeopardizing_investment_year(a, y);
    then jeopardizing_investment(a);
}
pub relation jeopardizing_investment_year(a: ExciseAct, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year used to test the foundation's private-foundation status for the investment";
}

// (e)(1)-(2): the taxable period; removal from jeopardy is a period-end candidate.
@source(IRC_S4944_E, coverage = exact, quote = "An investment which jeopardizes the carrying out of exempt purposes shall be considered to be removed from jeopardy when such investment is sold or otherwise disposed of, and the proceeds of such sale or other disposition are not investments which jeopardize the carrying out of exempt purposes.")
pub relation investment_removed_from_jeopardy_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4944(e)(2): the date the investment was sold or disposed of with proceeds that are not jeopardizing investments";
}
@source(IRC_S4944_E, coverage = exact, quote = "the date on which the amount so invested is removed from jeopardy")
rule TaxablePeriodEndCandidateFromRemovalFromJeopardy(a: ExciseAct, on: Date) defeasible {
    label en official "section 4944(e)(1)(C): the date the amount invested is removed from jeopardy is a candidate end of the taxable period";
    when excise_act_kind(a, JeopardizingInvestment);
    when investment_removed_from_jeopardy_on(a, on);
    then taxable_period_end_candidate(a, on);
}
pub relation removed_from_jeopardy_within_taxable_period(a: ExciseAct) kind institutional {
    label en official "section 4944(b)(1): the investment was removed from jeopardy on or before the end of the taxable period";
}
rule RemovedFromJeopardyWithinTaxablePeriod(a: ExciseAct, on: Date, ends: Date) defeasible {
    label en official "section 4944(b)(1): removal from jeopardy within the taxable period avoids the additional tax";
    when investment_removed_from_jeopardy_on(a, on);
    when taxable_period_ends(a, ends);
    when on <= ends;
    then removed_from_jeopardy_within_taxable_period(a);
}

@source(IRC_S4944_A, coverage = exact, quote = "there is hereby imposed on the making of such investment a tax equal to 10 percent of the amount so invested for each year (or part thereof) in the taxable period. The tax imposed by this paragraph shall be paid by the private foundation.")
rule InitialTaxOnFoundationJeopardizingInvestment(a: ExciseAct, f: Person, amount: Money, base: Money, n: Integer) defeasible {
    label en official "section 4944(a)(1): 10 percent of the amount invested for each year (or part thereof) in the taxable period, paid by the private foundation";
    when jeopardizing_investment(a);
    when jeopardizing_investment_foundation(a, f);
    when jeopardizing_investment_amount(a, base);
    when taxable_period_years(a, n);
    then initial_tax(a, f, base * JeopardizingInitialTaxRateFoundation * n);
}
@source(IRC_S4944_A, coverage = exact, quote = "knowing that it is jeopardizing the carrying out of any of the foundation's exempt purposes")
external judgment relation manager_knew_investment_jeopardizing(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4944(a)(2): the foundation manager participated knowing that the investment jeopardizes the carrying out of the foundation's exempt purposes";
}
@source(IRC_S4944_A, coverage = exact, quote = "unless such participation is not willful and is due to reasonable cause")
external judgment relation manager_investment_participation_not_willful_and_reasonable_cause(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4944(a)(2): the manager's participation was not willful and was due to reasonable cause";
}
@source(IRC_S4944_A, coverage = exact, quote = "a tax equal to 10 percent of the amount so invested for each year (or part thereof) in the taxable period, unless such participation is not willful and is due to reasonable cause. The tax imposed by this paragraph shall be paid by any foundation manager who participated in the making of the investment.")
rule InitialTaxOnManagerJeopardizingInvestment(a: ExciseAct, p: Person, amount: Money, base: Money, n: Integer, f: Person) defeasible {
    label en official "section 4944(a)(2): 10 percent per year (or part) on a knowing participating foundation manager, capped at $10,000 by 4944(d)(2), unless not willful and due to reasonable cause";
    when jeopardizing_investment(a);
    when foundation_manager(p, f);
    when jeopardizing_investment_foundation(a, f);
    when manager_knew_investment_jeopardizing(a, p);
    when jeopardizing_investment_amount(a, base);
    when taxable_period_years(a, n);
    unless manager_investment_participation_not_willful_and_reasonable_cause(a, p) and foundation_manager(p, f) and jeopardizing_investment_amount(a, base) and taxable_period_years(a, n);
    then initial_tax(a, p, min(base * JeopardizingInitialTaxRateManager * n, JeopardizingManagerInitialTaxCap));
}
@source(IRC_S4944_B, coverage = exact, quote = "such investment is not removed from jeopardy within the taxable period, there is hereby imposed a tax equal to 25 percent of the amount of the investment. The tax imposed by this paragraph shall be paid by the private foundation.")
rule AdditionalTaxOnFoundationJeopardizingInvestment(a: ExciseAct, f: Person, amount: Money, base: Money) defeasible {
    label en official "section 4944(b)(1): if the investment is not removed from jeopardy within the taxable period, 25 percent of the amount of the investment, paid by the private foundation";
    when jeopardizing_investment(a);
    when jeopardizing_investment_foundation(a, f);
    when jeopardizing_investment_amount(a, base);
    unless removed_from_jeopardy_within_taxable_period(a) and jeopardizing_investment_foundation(a, f) and jeopardizing_investment_amount(a, base);
    then additional_tax(a, f, base * JeopardizingAdditionalTaxRateFoundation);
}
@source(IRC_S4944_B, coverage = exact, quote = "if a foundation manager refused to agree to part or all of the removal from jeopardy")
pub relation manager_refused_removal_from_jeopardy(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4944(b)(2): the foundation manager refused to agree to part or all of the removal from jeopardy";
}
@source(IRC_S4944_B, coverage = exact, quote = "there is hereby imposed a tax equal to 5 percent of the amount of the investment. The tax imposed by this paragraph shall be paid by any foundation manager who refused to agree to part or all of the removal from jeopardy.")
rule AdditionalTaxOnManagerRefusingRemoval(a: ExciseAct, p: Person, amount: Money, base: Money, f: Person) defeasible {
    label en official "section 4944(b)(2): 5 percent of the amount of the investment on a manager who refused to agree to removal from jeopardy, capped at $20,000 by 4944(d)(2), if the additional tax on the foundation is imposed";
    when jeopardizing_investment(a);
    when foundation_manager(p, f);
    when jeopardizing_investment_foundation(a, f);
    when manager_refused_removal_from_jeopardy(a, p);
    when jeopardizing_investment_amount(a, base);
    unless removed_from_jeopardy_within_taxable_period(a) and foundation_manager(p, f) and jeopardizing_investment_amount(a, base);
    then additional_tax(a, p, min(base * JeopardizingAdditionalTaxRateManager, JeopardizingManagerAdditionalTaxCap));
}
@source(IRC_S4944_D, coverage = exact, quote = "If more than one person is liable under subsection (a)(2) or (b)(2) with respect to any one investment, all such persons shall be jointly and severally liable under such paragraph with respect to such investment.")
pub relation jeopardizing_investment_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4944(d)(1): managers both liable under the same paragraph for the same investment are jointly and severally liable";
}
rule JointAndSeveralJeopardizingInvestmentManagers(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money, f: Person) defeasible {
    label en official "section 4944(d)(1): two managers both liable for the same investment are jointly and severally liable";
    when jeopardizing_investment(a);
    when jeopardizing_investment_foundation(a, f);
    when foundation_manager(p1, f);
    when foundation_manager(p2, f);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then jeopardizing_investment_jointly_and_severally_liable(a, p1, p2);
}

// ============================================================================
// Sections 4951-4953 — section 501(c)(21) black lung benefit trusts
// ============================================================================

pub relation trust_501c21_act_trust(a: ExciseAct, t: Trust) kind empirical {
    label en unofficial "the section 501(c)(21) trust that is a party to the act or expenditure";
}
pub relation trust_501c21_act_person(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the disqualified person (4951) on the other side of the act";
}
pub relation trust_501c21_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount involved (4951(e)(2)) or the amount of the expenditure (4952)";
}
pub relation trustee_of_501c21(p: Person, t: Trust) kind empirical {
    label en unofficial "p is a trustee of the section 501(c)(21) trust";
}
pub relation trust_is_501c21(t: Trust) kind empirical {
    label en official "the trust is a trust described in section 501(c)(21)";
}

@source(IRC_S4951_E, coverage = exact, quote = "The term \"disqualified person\" means, with respect to a trust described in section 501(c)(21), a person who is—")
pub relation contributor_to_501c21_trust(p: Person, t: Trust) kind empirical {
    label en official "section 4951(e)(4)(A): p is a contributor to the trust";
}
pub relation employed_by_contributor(p: Person, contributor: Person) kind empirical {
    label en official "section 4951(e)(4)(D): p is an officer, director, or employee of a contributor";
}
pub relation owner_over_10_percent_of_contributor(p: Person, contributor: Person) kind empirical {
    label en official "section 4951(e)(4)(C): p owns more than 10 percent of the combined voting power, profits interest or beneficial interest of a contributor (with section 267(c) indirect ownership — TECH-GAPS G2503)";
}
pub relation family_member_4951(p: Person, of: Person) kind empirical {
    label en official "section 4951(e)(4)(E): spouse, ancestor, lineal descendant, or spouse of a lineal descendant of `of` (the family is exactly this set, per 267(c)(4) as modified)";
}
pub relation owns_over_35_percent_of_entity(ent: Person, holders_combined_share: Decimal) kind empirical {
    label en official "section 4951(e)(4)(F)-(H): persons described in (A)-(E) own more than 35 percent of the voting power / profits interest / beneficial interest of the entity";
}
@source(IRC_S4951_E, coverage = partial, quote = "The term \"disqualified person\" means, with respect to a trust described in section 501(c)(21), a person who is—")
pub relation disqualified_person_4951(p: Person, t: Trust) kind institutional {
    label en official "section 4951(e)(4): p is a disqualified person with respect to the section 501(c)(21) trust";
}
rule DisqualifiedPerson4951Contributor(p: Person, t: Trust) defeasible {
    label en official "section 4951(e)(4)(A): a contributor to the trust";
    when contributor_to_501c21_trust(p, t);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951Trustee(p: Person, t: Trust) defeasible {
    label en official "section 4951(e)(4)(B): a trustee of the trust";
    when trustee_of_501c21(p, t);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951OwnerOfContributor(p: Person, t: Trust, c: Person) defeasible {
    label en official "section 4951(e)(4)(C): an owner of more than 10 percent of a contributor";
    when contributor_to_501c21_trust(c, t);
    when owner_over_10_percent_of_contributor(p, c);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951OfficerOfContributor(p: Person, t: Trust, c: Person) defeasible {
    label en official "section 4951(e)(4)(D): an officer, director, or employee of a contributor";
    when contributor_to_501c21_trust(c, t);
    when employed_by_contributor(p, c);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951FamilyOfContributor(p: Person, t: Trust, q: Person) defeasible {
    label en official "section 4951(e)(4)(E): family of a contributor";
    when contributor_to_501c21_trust(q, t);
    when family_member_4951(p, q);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951FamilyOfTrustee(p: Person, t: Trust, q: Person) defeasible {
    label en official "section 4951(e)(4)(E): family of a trustee";
    when trustee_of_501c21(q, t);
    when family_member_4951(p, q);
    then disqualified_person_4951(p, t);
}
rule DisqualifiedPerson4951ControlledEntity(p: Person, t: Trust, share: Decimal) defeasible {
    label en official "section 4951(e)(4)(F)-(H): an entity in which persons described in (A)-(E) own more than 35 percent";
    when owns_over_35_percent_of_entity(p, share);
    when share > 0.35;
    when trust_is_501c21(t);
    then disqualified_person_4951(p, t);
}

pub relation trust_self_dealing_type(a: ExciseAct, k: SelfDealingActType) kind empirical {
    label en unofficial "case-asserted: which of section 4951(d)(1)(A)-(E)'s categories the act falls into";
}
pub relation trust_self_dealing_excepted_furnishing_without_charge(a: ExciseAct) kind empirical {
    label en official "section 4951(d)(2)(B): the furnishing by a disqualified person is without charge and used exclusively for section 501(c)(21)(A) purposes";
}
pub relation trust_self_dealing_reasonable_compensation(a: ExciseAct) kind empirical {
    label en official "section 4951(d)(2)(C): compensation or reimbursement for personal services reasonable and necessary to the exempt purpose and not excessive (evaluative; asserted as the outcome of the judgment channel, DECISION-0194)";
}
pub relation trust_payment_of_benefits_4951f(a: ExciseAct) kind institutional {
    label en official "section 4951(f): payment out of trust assets for the purposes of section 501(c)(21)(A)(i)(I) or (IV)";
}
pub relation trust_excess_contribution_withdrawal_act(a: ExciseAct) kind empirical {
    label en official "section 4953(c): the act is a distribution to the contributor within the amount of his excess contribution";
}
@source(IRC_S4951_D, coverage = exact, quote = "For purposes of this section, the term \"self-dealing\" means any direct or indirect—")
pub relation trust_self_dealing_act(a: ExciseAct) kind institutional {
    label en official "section 4951(d): an act of self-dealing between a section 501(c)(21) trust and a disqualified person";
}
rule TrustSelfDealingActClassification(a: ExciseAct, t: Trust, p: Person, k: SelfDealingActType) defeasible {
    label en official "section 4951(d)(1): a direct or indirect sale/exchange/lease, loan, furnishing, payment of compensation or expenses, or transfer/use of income or assets between the trust and a disqualified person is self-dealing, except (d)(2)(B)-(C), (f) and 4953(c)";
    when excise_act_kind(a, TrustSelfDealingAct);
    when trust_is_501c21(t);
    when trust_501c21_act_trust(a, t);
    when trust_501c21_act_person(a, p);
    when disqualified_person_4951(p, t);
    when trust_self_dealing_type(a, k);
    unless trust_self_dealing_excepted_furnishing_without_charge(a) and trust_501c21_act_trust(a, t) and trust_501c21_act_person(a, p) and trust_self_dealing_type(a, k);
    unless trust_self_dealing_reasonable_compensation(a) and trust_501c21_act_trust(a, t) and trust_501c21_act_person(a, p) and trust_self_dealing_type(a, k);
    unless trust_payment_of_benefits_4951f(a) and trust_501c21_act_trust(a, t) and trust_501c21_act_person(a, p) and trust_self_dealing_type(a, k);
    unless trust_excess_contribution_withdrawal_act(a) and trust_501c21_act_trust(a, t) and trust_501c21_act_person(a, p) and trust_self_dealing_type(a, k);
    then trust_self_dealing_act(a);
}

@source(IRC_S4951_A, coverage = exact, quote = "The rate of tax shall be equal to 10 percent of the amount involved with respect to the act of self-dealing for each year (or part thereof) in the taxable period. The tax imposed by this paragraph shall be paid by any disqualified person (other than a trustee acting only as a trustee of the trust) who participates in the act of self-dealing.")
rule InitialTaxOnTrustSelfDealer(a: ExciseAct, p: Person, amount: Money, base: Money, n: Integer) defeasible {
    label en official "section 4951(a)(1): 10 percent of the amount involved per year (or part) in the taxable period, paid by the participating disqualified person other than a trustee acting only as such";
    when trust_self_dealing_act(a);
    when trust_501c21_act_person(a, p);
    when trust_501c21_amount(a, base);
    when taxable_period_years(a, n);
    unless trustee_acting_only_as_trustee(a, p) and trust_501c21_amount(a, base) and taxable_period_years(a, n);
    then initial_tax(a, p, base * TrustSelfDealingInitialTaxRateSelfDealer * n);
}
pub relation trustee_acting_only_as_trustee(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4951(a)(1): the participant acted only as a trustee of the trust";
}
@source(IRC_S4951_A, coverage = exact, quote = "knowing that it is such an act")
external judgment relation trustee_knew_act_was_trust_self_dealing(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4951(a)(2): the trustee participated knowing that it is an act of self-dealing";
}
@source(IRC_S4951_A, coverage = exact, quote = "unless such participation is not willful and is due to reasonable cause")
external judgment relation trustee_participation_not_willful_and_reasonable_cause(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4951(a)(2): the trustee's participation was not willful and was due to reasonable cause";
}
@source(IRC_S4951_A, coverage = exact, quote = "a tax equal to 2½ percent of the amount involved with respect to the act of self-dealing for each year (or part thereof) in the taxable period")
rule InitialTaxOnTrustee(a: ExciseAct, p: Person, amount: Money, base: Money, n: Integer, t: Trust) defeasible {
    label en official "section 4951(a)(2): 2.5 percent of the amount involved per year (or part), on a trustee who knowingly participated, unless not willful and due to reasonable cause";
    when trust_self_dealing_act(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trustee_knew_act_was_trust_self_dealing(a, p);
    when trust_501c21_amount(a, base);
    when taxable_period_years(a, n);
    unless trustee_participation_not_willful_and_reasonable_cause(a, p) and trustee_of_501c21(p, t) and trust_501c21_amount(a, base) and taxable_period_years(a, n);
    then initial_tax(a, p, base * TrustSelfDealingInitialTaxRateTrustee * n);
}
@source(IRC_S4951_B, coverage = exact, quote = "and in which the act is not corrected within the taxable period, there is hereby imposed a tax equal to 100 percent of the amount involved.")
rule AdditionalTaxOnTrustSelfDealer(a: ExciseAct, p: Person, amount: Money, base: Money) defeasible {
    label en official "section 4951(b)(1): 100 percent of the amount involved if the act is not corrected within the taxable period, paid by the participating disqualified person other than a trustee acting only as such";
    when trust_self_dealing_act(a);
    when trust_501c21_act_person(a, p);
    when trust_501c21_amount(a, base);
    unless trustee_acting_only_as_trustee(a, p) and trust_501c21_amount(a, base);
    unless corrected_within_taxable_period(a) and trust_501c21_act_person(a, p) and trust_501c21_amount(a, base);
    then additional_tax(a, p, base * TrustSelfDealingAdditionalTaxRateSelfDealer);
}
pub relation trustee_refused_to_agree_to_correction(a: ExciseAct, p: Person) kind empirical {
    label en official "sections 4951(b)(2), 4952(b)(2): the trustee refused to agree to part or all of the correction";
}
@source(IRC_S4951_B, coverage = exact, quote = "if a trustee of such a trust refused to agree to part or all of the correction, there is hereby imposed a tax equal to 50 percent of the amount involved.")
rule AdditionalTaxOnTrusteeRefusingCorrection(a: ExciseAct, p: Person, amount: Money, base: Money, t: Trust) defeasible {
    label en official "section 4951(b)(2): 50 percent of the amount involved on a trustee who refused to agree to the correction";
    when trust_self_dealing_act(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trustee_refused_to_agree_to_correction(a, p);
    when trust_501c21_amount(a, base);
    unless corrected_within_taxable_period(a) and trustee_of_501c21(p, t) and trust_501c21_amount(a, base);
    then additional_tax(a, p, base * TrustSelfDealingAdditionalTaxRateTrustee);
}
@source(IRC_S4951_C, coverage = exact, quote = "If more than one person is liable under any paragraph of subsection (a) or (b) with respect to any one act of self-dealing, all such persons shall be jointly and severally liable under such paragraph with respect to such act.")
pub relation trust_self_dealing_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4951(c): p1 and p2 liable under the same paragraph for the same act are jointly and severally liable";
}
rule JointAndSeveralTrustSelfDealing(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money) defeasible {
    label en official "section 4951(c): two persons both liable for the same act of self-dealing are jointly and severally liable";
    when trust_self_dealing_act(a);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then trust_self_dealing_jointly_and_severally_liable(a, p1, p2);
}

// --- 4952: taxable expenditures of the trust ---------------------------------

@source(IRC_S4952_D, coverage = exact, quote = "the term \"taxable expenditure\" means any amount paid or incurred by a trust described in section 501(c)(21) other than for a purpose specified in such section.")
pub relation trust_expenditure_for_specified_purpose(a: ExciseAct) kind empirical {
    label en official "section 4952(d): the amount was paid or incurred for a purpose specified in section 501(c)(21)";
}
pub relation trust_taxable_expenditure(a: ExciseAct) kind institutional {
    label en official "section 4952(d): the amount paid or incurred by a section 501(c)(21) trust other than for a purpose specified in that section";
}
rule TrustTaxableExpenditureClassification(a: ExciseAct, t: Trust) defeasible {
    label en official "section 4952(d): an expenditure by a section 501(c)(21) trust other than for a specified purpose is a taxable expenditure, except a withdrawal of excess contributions (4953(c))";
    when excise_act_kind(a, TrustTaxableExpenditure);
    when trust_is_501c21(t);
    when trust_501c21_act_trust(a, t);
    unless trust_expenditure_for_specified_purpose(a) and trust_501c21_act_trust(a, t);
    unless trust_excess_contribution_withdrawal_act(a) and trust_501c21_act_trust(a, t);
    then trust_taxable_expenditure(a);
}
@source(IRC_S4952_A, coverage = exact, quote = "a tax equal to 10 percent of the amount thereof. The tax imposed by this paragraph shall be paid by the trustee out of the assets of the trust.")
rule InitialTaxOnTrustExpenditure(a: ExciseAct, t: Trust, base: Money, p: Person) defeasible {
    label en official "section 4952(a)(1): 10 percent of the amount of the taxable expenditure, paid by the trustee out of the trust assets";
    when trust_taxable_expenditure(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trust_501c21_amount(a, base);
    then initial_tax(a, p, base * TrustExpenditureInitialTaxRateFund);
}
@source(IRC_S4952_A, coverage = exact, quote = "knowing that it is a taxable expenditure, a tax equal to 2½ percent of the amount thereof, unless such agreement is not willful and is due to reasonable cause.")
external judgment relation trustee_knew_expenditure_taxable(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4952(a)(2): the trustee agreed to the expenditure knowing that it is a taxable expenditure";
}
external judgment relation trustee_expenditure_agreement_not_willful_and_reasonable_cause(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4952(a)(2): the trustee's agreement was not willful and was due to reasonable cause";
}
@source(IRC_S4952_A, coverage = exact, quote = "a tax equal to 2½ percent of the amount thereof, unless such agreement is not willful and is due to reasonable cause. The tax imposed by this paragraph shall be paid by the trustee who agreed to the making of the expenditure.")
rule InitialTaxOnTrusteeForExpenditure(a: ExciseAct, t: Trust, base: Money, p: Person) defeasible {
    label en official "section 4952(a)(2): 2.5 percent of the amount on a trustee who knowingly agreed, unless not willful and due to reasonable cause";
    when trust_taxable_expenditure(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trustee_knew_expenditure_taxable(a, p);
    when trust_501c21_amount(a, base);
    unless trustee_expenditure_agreement_not_willful_and_reasonable_cause(a, p) and trustee_of_501c21(p, t) and trust_501c21_amount(a, base);
    then initial_tax(a, p, base * TrustExpenditureInitialTaxRateTrustee);
}

// (e)(2): taxable period = earlier of notice and assessment only.
relation notice_or_assessment_period_end_candidate(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a candidate end date for the two-candidate taxable period of 4952(e)(2) / 4955(f)(4): notice mailing or assessment";
}
rule NoticeOrAssessmentCandidateFromNotice(a: ExciseAct, on: Date, n: Notice) defeasible {
    label en official "sections 4952(e)(2)(A), 4955(f)(4)(A): the date of mailing a notice of deficiency";
    when notice_for_act(n, a);
    when us.irc.core::mailed_on(n, on);
    then notice_or_assessment_period_end_candidate(a, on);
}
rule NoticeOrAssessmentCandidateFromAssessment(a: ExciseAct, on: Date, asmt: Assessment) defeasible {
    label en official "sections 4952(e)(2)(B), 4955(f)(4)(B): the date on which the tax is assessed";
    when assessment_for_act(asmt, a);
    when us.irc.core::assessed_on(asmt, on);
    then notice_or_assessment_period_end_candidate(a, on);
}
relation earlier_notice_or_assessment_candidate_exists(a: ExciseAct, on: Date) kind institutional {
    label en unofficial "a strictly earlier notice/assessment candidate exists (pairwise minimum without an aggregate — G136 pattern)";
}
rule EarlierNoticeOrAssessmentCandidateExists(a: ExciseAct, on: Date, on2: Date) defeasible {
    label en unofficial "a strictly earlier candidate disqualifies this one";
    when notice_or_assessment_period_end_candidate(a, on);
    when notice_or_assessment_period_end_candidate(a, on2);
    when on2 < on;
    then earlier_notice_or_assessment_candidate_exists(a, on);
}
@source(IRC_S4955_F, coverage = exact, quote = "ending on the earlier of—")
pub relation notice_or_assessment_period_ends(a: ExciseAct, on: Date) kind institutional {
    label en official "sections 4952(e)(2), 4955(f)(4): the taxable period ends on the earlier of the notice-of-deficiency mailing and the assessment";
}
rule NoticeOrAssessmentPeriodEnds(a: ExciseAct, on: Date) defeasible {
    label en official "the two-candidate taxable period ends at the earliest candidate";
    when notice_or_assessment_period_end_candidate(a, on);
    unless earlier_notice_or_assessment_candidate_exists(a, on);
    then notice_or_assessment_period_ends(a, on);
}
pub relation notice_or_assessment_period_closed(a: ExciseAct) kind institutional {
    label en unofficial "the two-candidate taxable period has ended";
}
rule NoticeOrAssessmentPeriodClosed(a: ExciseAct, on: Date) defeasible {
    label en unofficial "a period end exists";
    when notice_or_assessment_period_ends(a, on);
    then notice_or_assessment_period_closed(a);
}
pub relation corrected_within_notice_or_assessment_period(a: ExciseAct) kind institutional {
    label en official "sections 4952(b), 4955(b): the act was corrected within the (two-candidate) taxable period — corrected on or before its end, or corrected while the period is still open";
}
rule CorrectedBeforeNoticeOrAssessmentPeriodEnd(a: ExciseAct, con: Date, ends: Date) defeasible {
    label en official "correction on or before the end of the taxable period";
    when act_corrected_on(a, con);
    when notice_or_assessment_period_ends(a, ends);
    when con <= ends;
    then corrected_within_notice_or_assessment_period(a);
}
rule CorrectedWhilePeriodOpen(a: ExciseAct, con: Date) defeasible {
    label en official "correction completed while no notice or assessment has ended the period";
    when act_corrected_on(a, con);
    unless notice_or_assessment_period_closed(a) and act_corrected_on(a, con);
    then corrected_within_notice_or_assessment_period(a);
}

@source(IRC_S4952_B, coverage = exact, quote = "and such expenditure is not corrected within the taxable period, there is hereby imposed a tax equal to 100 percent of the amount of the expenditure. The tax imposed by this paragraph shall be paid by the trustee out of the assets of the trust.")
rule AdditionalTaxOnTrustExpenditure(a: ExciseAct, t: Trust, base: Money, p: Person) defeasible {
    label en official "section 4952(b)(1): 100 percent of the expenditure if not corrected within the taxable period, paid by the trustee out of the trust assets";
    when trust_taxable_expenditure(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trust_501c21_amount(a, base);
    unless corrected_within_notice_or_assessment_period(a) and trust_501c21_act_trust(a, t) and trustee_of_501c21(p, t) and trust_501c21_amount(a, base);
    then additional_tax(a, p, base * TrustExpenditureAdditionalTaxRateFund);
}
@source(IRC_S4952_B, coverage = exact, quote = "if a trustee refused to agree to a part or all of the correction, there is hereby imposed a tax equal to 50 percent of the amount of the taxable expenditure.")
rule AdditionalTaxOnTrusteeRefusingExpenditureCorrection(a: ExciseAct, t: Trust, base: Money, p: Person) defeasible {
    label en official "section 4952(b)(2): 50 percent of the expenditure on a trustee who refused to agree to the correction";
    when trust_taxable_expenditure(a);
    when trust_501c21_act_trust(a, t);
    when trustee_of_501c21(p, t);
    when trustee_refused_to_agree_to_correction(a, p);
    when trust_501c21_amount(a, base);
    unless corrected_within_notice_or_assessment_period(a) and trustee_of_501c21(p, t) and trust_501c21_amount(a, base);
    then additional_tax(a, p, base * TrustExpenditureAdditionalTaxRateTrustee);
}
@source(IRC_S4952_C, coverage = exact, quote = "if more than one person is liable under subsection (a)(2) or (b)(2) with respect to the making of a taxable expenditure, all such persons shall be jointly and severally liable under such paragraph with respect to such expenditure.")
pub relation trust_expenditure_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4952(c): trustees both liable under (a)(2) or (b)(2) for the same expenditure are jointly and severally liable";
}
rule JointAndSeveralTrustExpenditureTrustees(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money) defeasible {
    label en official "section 4952(c): two trustees both liable for the same expenditure are jointly and severally liable";
    when trust_taxable_expenditure(a);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then trust_expenditure_jointly_and_severally_liable(a, p1, p2);
}

// --- 4953: excess contributions ------------------------------------------------

pub relation contributed_to_501c21_trusts(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4953(b)(1): the amount contributed for the taxable year to trusts described in section 501(c)(21)";
}
pub relation deduction_allowable_under_192(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4953(b)(1): the deduction allowable to the person for the contributions under section 192";
}
pub relation maximum_deduction_under_192(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4953(b)(2)(A): the maximum amount allowable as a deduction under section 192 for the taxable year";
}
pub relation prior_year_excess_contribution(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4953(b)(2): the amount determined under section 4953(b) for the preceding taxable year, carried in as a fact — the year-to-year recursion is not expressed (TECH-GAPS G2504, LDC-E4102 pattern)";
}
pub relation excess_contribution_distributed_to_contributor(p: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4953(b)(2)(B): amounts distributed from the trust to the contributor which were excess contributions for the preceding taxable year";
}
@source(IRC_S4953_B, coverage = exact, quote = "the term \"excess contribution\" means the sum of—")
pub relation excess_contribution(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4953(b): the sum of (1) the current-year contribution above the section 192 deduction and (2) the prior-year excess reduced by the (A) unused deduction room and (B) distributions";
}
// JUDGMENT CALL: the statute does not floor paragraph (2) at zero; the reduction cannot make the
// carried excess negative in substance (an excess cannot be negative), so it is floored at zero.
rule ExcessContribution(p: Person, y: TaxableYear, c: Money, d: Money, prior: Money, m: Money, w: Money) defeasible {
    label en official "section 4953(b): (1) max(0, contributed − allowable deduction) plus (2) max(0, prior excess − (max(0, deduction ceiling − contributed) + distributed))";
    when contributed_to_501c21_trusts(p, y, c);
    when deduction_allowable_under_192(p, y, d);
    when prior_year_excess_contribution(p, y, prior);
    when maximum_deduction_under_192(p, y, m);
    when excess_contribution_distributed_to_contributor(p, y, w);
    then excess_contribution(p, y, max(c - d, 0.00 USD) + max(prior - (max(m - c, 0.00 USD) + w), 0.00 USD));
}
@source(IRC_S4953_A, coverage = exact, quote = "a tax in an amount equal to 5 percent of the amount of the excess contributions made by a person to or under a trust or trusts described in section 501(c)(21). The tax imposed by this subsection shall be paid by the person making the excess contribution.")
pub relation excess_contribution_tax(p: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4953(a): 5 percent of the excess contributions, paid by the person making them, for each taxable year";
}
rule ExcessContributionTax(p: Person, y: TaxableYear, e: Money) defeasible {
    label en official "section 4953(a): 5 percent of the excess contributions for the taxable year";
    when excess_contribution(p, y, e);
    when e > 0.00 USD;
    then excess_contribution_tax(p, y, e * ExcessContributionTaxRate);
}

// ============================================================================
// Section 4955 — political expenditures of section 501(c)(3) organizations
// ============================================================================

pub relation political_expenditure_org(a: ExciseAct, org: Person) kind empirical {
    label en unofficial "the section 501(c)(3) organization that paid or incurred the expenditure";
}
pub relation political_expenditure_amount(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "the amount paid or incurred";
}
@source(IRC_S4955_F, coverage = exact, quote = "The term \"section 501(c)(3) organization\" means any organization which (without regard to any political expenditure) would be described in section 501(c)(3) and exempt from taxation under section 501(a).")
pub relation section_501c3_organization_4955(org: Person, y: TaxableYear) kind empirical {
    label en official "section 4955(f)(1): the organization would, without regard to any political expenditure, be described in section 501(c)(3) and exempt under section 501(a)";
}
pub relation political_expenditure_year(a: ExciseAct, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year in which the expenditure was paid or incurred";
}
@source(IRC_S4955_D, coverage = exact, quote = "in any participation in, or intervention in (including the publication or distribution of statements), any political campaign on behalf of (or in opposition to) any candidate for public office")
pub relation participates_in_political_campaign(a: ExciseAct) kind empirical {
    label en official "section 4955(d)(1): the amount was paid or incurred in participation in, or intervention in (including publishing or distributing statements), a political campaign for or against a candidate for public office";
}
@source(IRC_S4955_D, coverage = exact, quote = "In the case of an organization which is formed primarily for purposes of promoting the candidacy (or prospective candidacy) of an individual for public office")
pub relation organization_formed_primarily_to_promote_candidacy(org: Person) kind empirical {
    label en official "section 4955(d)(2): the organization is formed primarily for promoting a candidacy or is effectively controlled by a candidate and availed of primarily for such purposes";
}
enum CandidateExpenseKind {
    SpeechOrServicePayment;
    TravelExpense;
    PollOrStudyExpense;
    AdvertisingPublicityFundraising;
    OtherPrimaryBenefitExpense;
}
@source(IRC_S4955_D, coverage = exact, quote = "Amounts paid or incurred to such individual for speeches or other services.")
pub relation candidate_related_expense_kind(a: ExciseAct, k: CandidateExpenseKind) kind empirical {
    label en official "section 4955(d)(2)(A)-(E): which listed kind of candidate-related amount was paid or incurred";
}
@source(IRC_S4955_D, coverage = exact, quote = "The term \"political expenditure\" means any amount paid or incurred by a section 501(c)(3) organization")
pub relation political_expenditure(a: ExciseAct) kind institutional {
    label en official "section 4955(d): a political expenditure of a section 501(c)(3) organization";
}
rule PoliticalExpenditureCampaign(a: ExciseAct, org: Person, y: TaxableYear) defeasible {
    label en official "section 4955(d)(1): participation or intervention in a political campaign by a section 501(c)(3) organization";
    when excise_act_kind(a, PoliticalExpenditure);
    when political_expenditure_org(a, org);
    when political_expenditure_year(a, y);
    when section_501c3_organization_4955(org, y);
    when participates_in_political_campaign(a);
    then political_expenditure(a);
}
rule PoliticalExpenditureCandidateOrganization(a: ExciseAct, org: Person, y: TaxableYear, k: CandidateExpenseKind) defeasible {
    label en official "section 4955(d)(2): for a candidacy-promoting organization the listed candidate-related amounts are political expenditures";
    when excise_act_kind(a, PoliticalExpenditure);
    when political_expenditure_org(a, org);
    when political_expenditure_year(a, y);
    when section_501c3_organization_4955(org, y);
    when organization_formed_primarily_to_promote_candidacy(org);
    when candidate_related_expense_kind(a, k);
    then political_expenditure(a);
}

@source(IRC_S4955_F, coverage = exact, quote = "any officer, director, or trustee of the organization (or individual having powers or responsibilities similar to those of officers, directors, or trustees of the organization)")
pub relation officer_director_or_trustee_of(p: Person, org: Person) kind empirical {
    label en official "section 4955(f)(2)(A): p is an officer, director, or trustee of the organization, or has similar powers or responsibilities";
}
@source(IRC_S4955_F, coverage = exact, quote = "with respect to any expenditure, any employee of the organization having authority or responsibility with respect to such expenditure")
pub relation employee_with_authority_over_expenditure(p: Person, org: Person) kind empirical {
    label en official "section 4955(f)(2)(B): p is an employee of the organization having authority or responsibility with respect to the expenditure";
}
@source(IRC_S4955_F, coverage = exact, quote = "The term \"organization manager\" means—")
pub relation organization_manager(p: Person, org: Person) kind institutional {
    label en official "section 4955(f)(2): an officer, director, trustee (or similar) of the organization, or an employee with authority or responsibility with respect to the expenditure (used by section 4912(d)(2) as well)";
}
rule OrganizationManagerOfficer(p: Person, org: Person) defeasible {
    label en official "section 4955(f)(2)(A): officer, director, or trustee";
    when officer_director_or_trustee_of(p, org);
    then organization_manager(p, org);
}
rule OrganizationManagerEmployee(p: Person, org: Person) defeasible {
    label en official "section 4955(f)(2)(B): employee with authority or responsibility over the expenditure";
    when employee_with_authority_over_expenditure(p, org);
    then organization_manager(p, org);
}

@source(IRC_S4955_A, coverage = exact, quote = "There is hereby imposed on each political expenditure by a section 501(c)(3) organization a tax equal to 10 percent of the amount thereof. The tax imposed by this paragraph shall be paid by the organization.")
rule InitialTaxOnOrganizationPoliticalExpenditure(a: ExciseAct, org: Person, base: Money) defeasible {
    label en official "section 4955(a)(1): 10 percent of the political expenditure, paid by the organization";
    when political_expenditure(a);
    when political_expenditure_org(a, org);
    when political_expenditure_amount(a, base);
    then initial_tax(a, org, base * PoliticalExpenditureInitialTaxRateOrganization);
}
external judgment relation manager_knew_expenditure_political(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4955(a)(2): the organization manager agreed to the expenditure knowing that it is a political expenditure";
}
external judgment relation manager_political_agreement_not_willful_and_reasonable_cause(a: ExciseAct, p: Person) {
    authority TaxCourt;
    label en official "section 4955(a)(2): the manager's agreement was not willful and was due to reasonable cause";
}
@source(IRC_S4955_A, coverage = exact, quote = "a tax equal to 2½ percent of the amount thereof, unless such agreement is not willful and is due to reasonable cause.")
rule InitialTaxOnOrganizationManagerPolitical(a: ExciseAct, p: Person, org: Person, base: Money) defeasible {
    label en official "section 4955(a)(2): 2.5 percent of the expenditure on a knowing organization manager who agreed, capped at $5,000 by 4955(c)(2), unless not willful and due to reasonable cause";
    when political_expenditure(a);
    when political_expenditure_org(a, org);
    when organization_manager(p, org);
    when manager_knew_expenditure_political(a, p);
    when political_expenditure_amount(a, base);
    unless manager_political_agreement_not_willful_and_reasonable_cause(a, p) and organization_manager(p, org) and political_expenditure_amount(a, base);
    then initial_tax(a, p, min(base * PoliticalExpenditureInitialTaxRateManager, PoliticalExpenditureManagerInitialTaxCap));
}
@source(IRC_S4955_B, coverage = exact, quote = "and such expenditure is not corrected within the taxable period, there is hereby imposed a tax equal to 100 percent of the amount of the expenditure. The tax imposed by this paragraph shall be paid by the organization.")
rule AdditionalTaxOnOrganizationPoliticalExpenditure(a: ExciseAct, org: Person, base: Money) defeasible {
    label en official "section 4955(b)(1): 100 percent of the expenditure if not corrected within the taxable period, paid by the organization";
    when political_expenditure(a);
    when political_expenditure_org(a, org);
    when political_expenditure_amount(a, base);
    unless corrected_within_notice_or_assessment_period(a) and political_expenditure_org(a, org) and political_expenditure_amount(a, base);
    then additional_tax(a, org, base * PoliticalExpenditureAdditionalTaxRateOrganization);
}
pub relation political_manager_refused_to_agree_to_correction(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4955(b)(2): the organization manager refused to agree to part or all of the correction";
}
@source(IRC_S4955_B, coverage = exact, quote = "if an organization manager refused to agree to part or all of the correction, there is hereby imposed a tax equal to 50 percent of the amount of the political expenditure.")
rule AdditionalTaxOnManagerRefusingPoliticalCorrection(a: ExciseAct, p: Person, org: Person, base: Money) defeasible {
    label en official "section 4955(b)(2): 50 percent of the political expenditure on a manager who refused to agree to correction, capped at $10,000 by 4955(c)(2)";
    when political_expenditure(a);
    when political_expenditure_org(a, org);
    when organization_manager(p, org);
    when political_manager_refused_to_agree_to_correction(a, p);
    when political_expenditure_amount(a, base);
    unless corrected_within_notice_or_assessment_period(a) and organization_manager(p, org) and political_expenditure_amount(a, base);
    then additional_tax(a, p, min(base * PoliticalExpenditureAdditionalTaxRateManager, PoliticalExpenditureManagerAdditionalTaxCap));
}
@source(IRC_S4955_C, coverage = exact, quote = "If more than 1 person is liable under subsection (a)(2) or (b)(2) with respect to the making of a political expenditure, all such persons shall be jointly and severally liable under such subsection with respect to such expenditure.")
pub relation political_expenditure_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4955(c)(1): managers both liable for the same political expenditure are jointly and severally liable";
}
rule JointAndSeveralPoliticalExpenditureManagers(a: ExciseAct, p1: Person, p2: Person, a1: Money, a2: Money) defeasible {
    label en official "section 4955(c)(1): two managers both liable for the same expenditure are jointly and severally liable";
    when political_expenditure(a);
    when initial_tax(a, p1, a1);
    when initial_tax(a, p2, a2);
    when p1 != p2;
    then political_expenditure_jointly_and_severally_liable(a, p1, p2);
}
// 4955(e): coordination with sections 4945 and 4958.
pub relation same_expenditure_as(a: ExciseAct, b: ExciseAct) kind empirical {
    label en unofficial "the two act instances describe the same expenditure (a chapter 42 taxable expenditure / excess benefit view and a section 4955 political expenditure view)";
}
@source(IRC_S4955_E, coverage = exact, quote = "If tax is imposed under this section with respect to any political expenditure, such expenditure shall not be treated as a taxable expenditure for purposes of section 4945 or an excess benefit for purposes of section 4958.")
pub relation taxed_under_4955_as_same_expenditure(a: ExciseAct) kind institutional {
    label en official "section 4955(e): tax is imposed under section 4955 with respect to the very expenditure represented by this act, so it is neither a section 4945 taxable expenditure nor a section 4958 excess benefit";
}
// JUDGMENT CALL: "if tax is imposed under this section" is read as "the expenditure is a political
// expenditure with a positive amount" (the (a)(1) tax on the organization then follows). Reading the shared
// `initial_tax` head instead would make the 4945/4958 classifications and the shared head mutually
// dependent (LDC-E4102).
rule TaxedUnder4955AsSameExpenditure(a: ExciseAct, b: ExciseAct, amount: Money) defeasible {
    label en official "section 4955(e): a political expenditure on which the (a)(1) tax is imposed displaces sections 4945 and 4958 for the same expenditure";
    when same_expenditure_as(a, b);
    when excise_act_kind(b, PoliticalExpenditure);
    when political_expenditure(b);
    when political_expenditure_amount(b, amount);
    when amount > 0.00 USD;
    then taxed_under_4955_as_same_expenditure(a);
}
