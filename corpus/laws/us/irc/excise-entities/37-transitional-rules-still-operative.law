// Stage 3 (26.09.2026). Transitional rules in the statutory notes that are still
// operative (or bounded by an explicit date that a case dated in the window can
// reach): the Tax Reform Act of 1969 transitional rules printed as note 7 under
// section 4940 ((2) section 4941, (3) section 4942, (4) section 4943), the ERISA
// savings rules of note 6 under section 4975 ((2)(A)-(E)), and the 1996
// binding-contract rule of note 4 under section 4955 (section 4958).
//
// The dates are the notes' own (May 26 and 27, 1969; October 9, 1969; July 1,
// 1974; September 13, 1995); the windows are written with the same comparison
// on taxable-year start dates or on the act date. Rules of the notes that are
// expired by their own terms and cannot change a present-day answer are
// classified NON_NORMATIVE in the coverage file with the reason.
//
// JUDGMENT CALLS. "Until taxable years beginning after December 31, 1979" is
// read as: the exception applies to taxable years beginning on or before that
// date (comparison on `year_begins_on`). The section 4942 transitional exclusion
// reduces the undistributed income by the accumulated (or corpus-locked) amount.
// Status: implemented_unverified; scenarios not executed; no legal review.

// --- note 7(2): section 4941 ---

use self::{
    DistributionPayment,
    ExciseAct,
    ExciseActKind,
    Person,
    ProhibitedTransactionType,
    SelfDealingActType,
    TaxableYear,
    adequate_consideration_4975f10,
    change_by_purchase_by_disqualified_person,
    change_in_holdings_eligible_for_c6,
    distributable_amount_after_4942i,
    excess_benefit_transaction_date,
    excise_act_kind,
    excise_act_occurred_on,
    holdings_test_date,
    initial_tax,
    involuntary_change_in_holdings_on,
    present_holdings_cap,
    present_holdings_substitution_applies,
    prohibited_transaction_exempt_4975,
    qualifying_distributions_made,
    self_dealing_act_type,
    self_dealing_exception_4941d2,
    self_dealing_taxable_year,
    undistributed_income_foundation,
    undistributed_income_year,
    year_begins_on,
};

pub relation transaction_with_dq_corporation_pursuant_to_securities_terms(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(A): the transaction is between the foundation and a corporation which is a disqualified person, pursuant to the terms of the corporation's securities in existence when the foundation acquired them";
}
pub relation foundation_acquired_the_securities_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "note 7(2)(A): the date the foundation acquired the securities";
}
rule Transition4941SecuritiesTerms(a: ExciseAct, acquired: Date) defeasible {
    label en official "note 7(2)(A) under section 4940: section 4941 does not apply to a transaction pursuant to the terms of securities acquired before May 27, 1969";
    when transaction_with_dq_corporation_pursuant_to_securities_terms(a);
    when foundation_acquired_the_securities_on(a, acquired);
    when acquired < @1969-05-27;
    then self_dealing_exception_4941d2(a);
}
pub relation property_owned_by_foundation_on_1969_05_26(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(B): the property is owned by the foundation on May 26, 1969";
}
pub relation property_acquired_under_pre_1969_trust_or_will(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(B): the property is acquired under the terms of a trust irrevocable on May 26, 1969, or a will executed on or before that date, in effect on that date and at all times thereafter";
}
pub relation foundation_required_to_dispose_to_avoid_4943_tax(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(B): the foundation is required to dispose of the property in order not to be liable for tax under section 4943 (applied, for a disposition before January 1, 1977, without taking section 4943(c)(4) into account)";
}
pub relation foundation_receives_at_least_fair_market_value_in_return(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(B), (F)(iii): the foundation receives an amount equal to or exceeding fair market value at the disposition (or when a contract was previously executed in a transaction which was not prohibited under section 503(b))";
}
rule Transition4941DispositionOwnedOn1969(a: ExciseAct) defeasible {
    label en official "note 7(2)(B): a disposition to a disqualified person of property owned on May 26, 1969 that the foundation must dispose of to avoid section 4943 tax, for at least fair market value";
    when property_owned_by_foundation_on_1969_05_26(a);
    when foundation_required_to_dispose_to_avoid_4943_tax(a);
    when foundation_receives_at_least_fair_market_value_in_return(a);
    then self_dealing_exception_4941d2(a);
}
rule Transition4941DispositionUnderTrustOrWill(a: ExciseAct) defeasible {
    label en official "note 7(2)(B): the same for property acquired under a pre-1969 trust or will";
    when property_acquired_under_pre_1969_trust_or_will(a);
    when foundation_required_to_dispose_to_avoid_4943_tax(a);
    when foundation_receives_at_least_fair_market_value_in_return(a);
    then self_dealing_exception_4941d2(a);
}
pub relation binding_contract_in_effect_on_1969_10_09_or_renewal(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(C): the leasing or lending is pursuant to a binding contract in effect on October 9, 1969 (or a renewal of it)";
}
pub relation remains_at_least_as_favorable_as_arms_length(a: ExciseAct) kind empirical {
    label en unofficial "notes 7(2)(C), 6(2)(A)-(D): the transaction remains at least as favorable as an arm's-length transaction with an unrelated party";
}
pub relation execution_not_prohibited_under_503b_when_made(a: ExciseAct) kind empirical {
    label en unofficial "notes 7(2)(C)-(D): the execution of the contract or arrangement was not, at that time, a prohibited transaction within the meaning of section 503(b) or the corresponding prior law";
}
rule Transition4941LeaseOrLoanUnderBindingContract(a: ExciseAct, y: TaxableYear, start: Date) defeasible {
    label en official "note 7(2)(C): a lease or loan under a binding contract of October 9, 1969, in taxable years beginning on or before December 31, 1979, at least as favorable as arm's length";
    when self_dealing_act_type(a, LendingOrExtensionOfCredit);
    when binding_contract_in_effect_on_1969_10_09_or_renewal(a);
    when remains_at_least_as_favorable_as_arms_length(a);
    when execution_not_prohibited_under_503b_when_made(a);
    when self_dealing_taxable_year(a, y);
    when year_begins_on(y, start);
    when start <= @1979-12-31;
    then self_dealing_exception_4941d2(a);
}
rule Transition4941LeaseUnderBindingContract(a: ExciseAct, y: TaxableYear, start: Date) defeasible {
    label en official "note 7(2)(C): the leasing branch";
    when self_dealing_act_type(a, SaleExchangeOrLease);
    when binding_contract_in_effect_on_1969_10_09_or_renewal(a);
    when remains_at_least_as_favorable_as_arms_length(a);
    when execution_not_prohibited_under_503b_when_made(a);
    when self_dealing_taxable_year(a, y);
    when year_begins_on(y, start);
    when start <= @1979-12-31;
    then self_dealing_exception_4941d2(a);
}
pub relation shared_use_arrangement_in_effect_before_1969_10_09(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(D): the shared use of goods, services or facilities is pursuant to an arrangement in effect before October 9, 1969";
}
pub relation arrangement_would_not_be_prohibited_if_503_continued(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(D): the arrangement would not be a prohibited transaction if section 503(b) continued to apply";
}
rule Transition4941SharedUse(a: ExciseAct, y: TaxableYear, start: Date) defeasible {
    label en official "note 7(2)(D): shared use under a pre-October 9, 1969 arrangement not prohibited then or now, in taxable years beginning on or before December 31, 1979";
    when self_dealing_act_type(a, FurnishingGoodsServicesOrFacilities);
    when shared_use_arrangement_in_effect_before_1969_10_09(a);
    when execution_not_prohibited_under_503b_when_made(a);
    when arrangement_would_not_be_prohibited_if_503_continued(a);
    when self_dealing_taxable_year(a, y);
    when year_begins_on(y, start);
    when start <= @1979-12-31;
    then self_dealing_exception_4941d2(a);
}
pub relation joint_or_common_interest_property_use(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(E): the use of property in which the foundation and a disqualified person have a joint or common interest";
}
pub relation both_interests_acquired_before_1969_10_09(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(E): the interests of both in the property were acquired before October 9, 1969";
}
rule Transition4941JointInterest(a: ExciseAct) defeasible {
    label en official "note 7(2)(E): use of jointly held property whose interests were acquired before October 9, 1969 (no end date)";
    when joint_or_common_interest_property_use(a);
    when both_interests_acquired_before_1969_10_09(a);
    then self_dealing_exception_4941d2(a);
}
pub relation foundation_leases_substantially_all_under_binding_contract_lease(a: ExciseAct) kind empirical {
    label en unofficial "note 7(2)(F)(i): the foundation is leasing substantially all of the property under a lease to which subparagraph (C) applies";
}
rule Transition4941DispositionOfLeasedProperty(a: ExciseAct, on: Date) defeasible {
    label en official "note 7(2)(F): a disposition (other than by lease) of property leased under a (C) lease, before January 1, 1978, for at least fair market value";
    when self_dealing_act_type(a, SaleExchangeOrLease);
    when foundation_leases_substantially_all_under_binding_contract_lease(a);
    when excise_act_occurred_on(a, on);
    when on < @1978-01-01;
    when foundation_receives_at_least_fair_market_value_in_return(a);
    then self_dealing_exception_4941d2(a);
}

// --- note 7(3): section 4942 for organizations organized before May 27, 1969 ---

pub relation organized_before_1969_05_27(f: Person) kind empirical {
    label en unofficial "note 7(3): the organization was organized before May 27, 1969";
}
pub relation income_required_accumulated_by_mandatory_terms(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "note 7(3)(B): the income required to be accumulated pursuant to the mandatory terms (as in effect on May 26, 1969 and at all times thereafter) of an instrument executed before May 27, 1969, for the transfer of income producing property";
}
pub relation section_504a_or_681c_would_apply(f: Person) kind empirical {
    label en unofficial "note 7(3)(B): the organization would have been denied exemption if section 504(a) had not been repealed, or would have had its deductions under section 642(c) limited if section 681(c) had not been repealed";
}
pub relation amount_locked_by_instrument_against_distributing_corpus(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "note 7(3)(E): the extent to which the requirements of section 4942 are inconsistent with a prohibition in the governing or other instrument against distributing capital or corpus";
}
pub relation reform_proceeding_pending_during_year(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "note 7(3), last sentence: a judicial proceeding by the foundation to reform, or excuse it from compliance with, its governing instrument in order to comply with section 4942 is pending during the year";
}
pub relation instrument_does_not_permit_compliance_after_proceeding(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "note 7(3), last sentence: after the judicial proceeding terminated the instrument does not permit compliance (relevant to subparagraph (B) only)";
}
pub relation transition_4942_exclusion(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "note 7(3)(B), (E): the amount of income section 4942 does not reach: accumulated by mandatory terms, or locked against distribution of corpus; after 1971 only during the pendency of the reform proceeding (and for (B) while the instrument does not permit compliance)";
}
rule Transition4942AccumulationBefore1972(f: Person, y: TaxableYear, amt: Money, start: Date) defeasible {
    label en official "note 7(3)(B): taxable years beginning on or before December 31, 1971: the mandatory accumulation is outside section 4942";
    when organized_before_1969_05_27(f);
    when income_required_accumulated_by_mandatory_terms(f, y, amt);
    when year_begins_on(y, start);
    when start <= @1971-12-31;
    unless section_504a_or_681c_would_apply(f) and organized_before_1969_05_27(f) and income_required_accumulated_by_mandatory_terms(f, y, amt);
    then transition_4942_exclusion(f, y, amt);
}
rule Transition4942AccumulationDuringProceeding(f: Person, y: TaxableYear, amt: Money, start: Date) defeasible {
    label en official "note 7(3)(B), last sentence: after 1971 only during the pendency of the reform proceeding";
    when organized_before_1969_05_27(f);
    when income_required_accumulated_by_mandatory_terms(f, y, amt);
    when year_begins_on(y, start);
    when start > @1971-12-31;
    when reform_proceeding_pending_during_year(f, y);
    unless section_504a_or_681c_would_apply(f) and organized_before_1969_05_27(f) and income_required_accumulated_by_mandatory_terms(f, y, amt);
    then transition_4942_exclusion(f, y, amt);
}
rule Transition4942AccumulationAfterProceeding(f: Person, y: TaxableYear, amt: Money, start: Date) defeasible {
    label en official "note 7(3)(B), last sentence: subparagraph (B) also applies after the proceeding ends while the instrument does not permit compliance";
    when organized_before_1969_05_27(f);
    when income_required_accumulated_by_mandatory_terms(f, y, amt);
    when year_begins_on(y, start);
    when start > @1971-12-31;
    when instrument_does_not_permit_compliance_after_proceeding(f, y);
    unless section_504a_or_681c_would_apply(f) and organized_before_1969_05_27(f) and income_required_accumulated_by_mandatory_terms(f, y, amt);
    then transition_4942_exclusion(f, y, amt);
}
rule Transition4942CorpusLockBefore1972(f: Person, y: TaxableYear, amt: Money, start: Date) defeasible {
    label en official "note 7(3)(E): taxable years beginning on or before December 31, 1971";
    when organized_before_1969_05_27(f);
    when amount_locked_by_instrument_against_distributing_corpus(f, y, amt);
    when year_begins_on(y, start);
    when start <= @1971-12-31;
    then transition_4942_exclusion(f, y, amt);
}
rule Transition4942CorpusLockDuringProceeding(f: Person, y: TaxableYear, amt: Money, start: Date) defeasible {
    label en official "note 7(3)(E), last sentence: after 1971 only during the pendency of the reform proceeding";
    when organized_before_1969_05_27(f);
    when amount_locked_by_instrument_against_distributing_corpus(f, y, amt);
    when year_begins_on(y, start);
    when start > @1971-12-31;
    when reform_proceeding_pending_during_year(f, y);
    then transition_4942_exclusion(f, y, amt);
}
pub relation undistributed_income_after_transition_exclusion(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4942(c) with note 7(3)(B), (E): the distributable amount less the qualifying distributions less the transitional exclusion, when positive";
}
rule UndistributedIncomeAfterTransitionExclusion(a: ExciseAct, f: Person, y: TaxableYear, d: Money, x: Money, e: Money) defeasible {
    label en official "note 7(3): undistributed income reduced by the accumulated or locked amount";
    when undistributed_income_foundation(a, f);
    when undistributed_income_year(a, y);
    when transition_4942_exclusion(f, y, e);
    when distributable_amount_after_4942i(a, d);
    when qualifying_distributions_made(a, x);
    when d > x + e;
    then undistributed_income_after_transition_exclusion(a, d - x - e);
}
pub relation transition_4942_exclusion_applies(a: ExciseAct) kind institutional {
    label en official "note 7(3): a transitional exclusion exists for the act's foundation and year";
}
rule Transition4942ExclusionApplies(a: ExciseAct, f: Person, y: TaxableYear) defeasible {
    label en official "note 7(3)";
    when undistributed_income_foundation(a, f);
    when undistributed_income_year(a, y);
    when transition_4942_exclusion(f, y, _);
    then transition_4942_exclusion_applies(a);
}
rule InitialTaxOnUndistributedIncomeAfterTransition(a: ExciseAct, f: Person, base: Money) defeasible {
    label en official "section 4942(a) on the undistributed income after the note 7(3) exclusion";
    when excise_act_kind(a, UndistributedIncomeYear);
    when undistributed_income_foundation(a, f);
    when undistributed_income_after_transition_exclusion(a, base);
    then initial_tax(a, f, base * UndistributedIncomeInitialTaxRate);
}
pub relation grant_to_nonoperating_pf_under_binding_commitment(p: DistributionPayment) kind empirical {
    label en unofficial "note 7(3)(C): a grant to a private foundation described in section 4942(g)(1)(A)(ii) and not (A)(i), pursuant to a written commitment binding on May 26, 1969 and at all times thereafter";
}
pub relation grant_for_170c2B_purposes_transition(p: DistributionPayment) kind empirical {
    label en unofficial "note 7(3)(C): the grant is made for one or more section 170(c)(2)(B) purposes";
}
pub relation payment_made_on(p: DistributionPayment, on: Date) kind empirical {
    label en unofficial "the date the grant is paid out to the private foundation";
}
pub relation transition_grant_treated_as_to_operating_foundation(p: DistributionPayment) kind institutional {
    label en official "note 7(3)(C): the grant is treated as a grant to an operating foundation when paid out on or before December 31, 1974";
}
rule TransitionGrantTreatedAsToOperatingFoundation(p: DistributionPayment, on: Date) defeasible {
    label en official "note 7(3)(C)";
    when grant_to_nonoperating_pf_under_binding_commitment(p);
    when grant_for_170c2B_purposes_transition(p);
    when payment_made_on(p, on);
    when on <= @1974-12-31;
    then transition_grant_treated_as_to_operating_foundation(p);
}

// --- note 7(4): section 4943 ---

pub relation incorporated_before_1951_01_01(f: Person) kind empirical {
    label en unofficial "note 7(4)(A)(i): the private foundation was incorporated before January 1, 1951";
}
pub relation more_than_90_percent_stock_of_regulated_enterprise_on_1969_05_26(f: Person) kind empirical {
    label en unofficial "note 7(4)(A)(ii): substantially all of the foundation's assets on May 26, 1969 consist of more than 90 percent of the stock of an incorporated business enterprise licensed and regulated (sales or contracts regulated, professional representatives licensed) by State agencies in at least 10 States";
}
pub relation stock_acquired_solely_by_gift_devise_or_bequest(f: Person) kind empirical {
    label en unofficial "note 7(4)(A)(iii): the foundation acquired the stock solely by gift, devise or bequest";
}
pub relation no_purchase_after_1969_05_26_and_no_other_excess_holdings(f: Person) kind empirical {
    label en unofficial "note 7(4)(B)(i): the foundation does not purchase any interest in the enterprise after May 26, 1969 and does not acquire an interest in another business enterprise constituting excess business holdings";
}
pub relation expended_substantially_all_adjusted_net_income_last_5_years_to_1970(f: Person) kind empirical {
    label en unofficial "note 7(4)(B)(ii): in the last 5 taxable years ending on or before December 31, 1970 the foundation expended substantially all of its adjusted net income for the purpose or function for which it is organized and operated";
}
pub relation special_4943_transition_foundation(f: Person) kind institutional {
    label en official "note 7(4)(A)-(B): the section 4943(c)(4)(A)(i) cap of 50 percent does not apply and (c)(4)(D) does not apply to the holdings of this foundation in the enterprise";
}
rule Special4943TransitionFoundation(f: Person) defeasible {
    label en official "note 7(4)(A)(i)-(iii) and (B)(i)-(ii)";
    when incorporated_before_1951_01_01(f);
    when more_than_90_percent_stock_of_regulated_enterprise_on_1969_05_26(f);
    when stock_acquired_solely_by_gift_devise_or_bequest(f);
    when no_purchase_after_1969_05_26_and_no_other_excess_holdings(f);
    when expended_substantially_all_adjusted_net_income_last_5_years_to_1970(f);
    then special_4943_transition_foundation(f);
}
pub relation act_foundation_4943_transition(a: ExciseAct, f: Person) kind empirical {
    label en unofficial "the foundation whose holdings the act concerns, for the note 7(4) test";
}
pub relation act_uses_special_4943_transition(a: ExciseAct) kind institutional {
    label en official "note 7(4): the holding is that of a special transition foundation";
}
rule ActUsesSpecial4943Transition(a: ExciseAct, f: Person) defeasible {
    label en official "note 7(4)";
    when act_foundation_4943_transition(a, f);
    when special_4943_transition_foundation(f);
    then act_uses_special_4943_transition(a);
}
rule SpecialTransitionCapUnlimited(a: ExciseAct, t: Date) defeasible {
    label en official "note 7(4)(A): 'but in no event more than 50 percent' is disregarded, so the substituted percentage is not capped";
    when holdings_test_date(a, t);
    when act_uses_special_4943_transition(a);
    when present_holdings_substitution_applies(a);
    then present_holdings_cap(a, 1.00);
}
pub relation trust_remainder_stock_deemed_held_1969(a: ExciseAct) kind institutional {
    label en official "note 7(4)(A), last sentence: stock of the enterprise in a trust created before May 27, 1969 of which the foundation is the remainder beneficiary is deemed held on May 26, 1969 when the foundation held (apart from the trust) more than 20 percent";
}
pub relation trust_created_before_1969_05_27_foundation_remainder_beneficiary(a: ExciseAct) kind empirical {
    label en unofficial "the stock is in a trust created before May 27, 1969 of which the foundation is the remainder beneficiary";
}
pub relation foundation_held_more_than_20_percent_apart_from_trust_1969(a: ExciseAct) kind empirical {
    label en unofficial "the foundation held (without regard to the trust) more than 20 percent of the enterprise's stock on May 26, 1969";
}
rule TrustRemainderStockDeemedHeld(a: ExciseAct) defeasible {
    label en official "note 7(4)(A), last sentence";
    when trust_created_before_1969_05_27_foundation_remainder_beneficiary(a);
    when foundation_held_more_than_20_percent_apart_from_trust_1969(a);
    then trust_remainder_stock_deemed_held_1969(a);
}
pub relation exchange_under_note_7_2B_pursuant_to_disposition_plan(a: ExciseAct) kind empirical {
    label en unofficial "note 7(4)(C): the exchange is described in paragraph (2)(B) and is pursuant to a plan for disposition of excess business holdings";
}
rule TransitionExchangeIsNotAPurchase(a: ExciseAct, on: Date) defeasible {
    label en official "note 7(4)(C): for section 4943(c)(6) an exchange under (2)(B) pursuant to a disposition plan is not a 'purchase', so the grace period is not lost";
    when involuntary_change_in_holdings_on(a, on);
    when exchange_under_note_7_2B_pursuant_to_disposition_plan(a);
    unless change_by_purchase_by_disqualified_person(a) and involuntary_change_in_holdings_on(a, on);
    then change_in_holdings_eligible_for_c6(a);
}

// --- note 6 under section 4975: ERISA savings rules ---

pub relation plan_loan_under_binding_contract_in_effect_1974_07_01(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(A): a loan or extension of credit under a binding contract in effect on July 1, 1974 (or a renewal of it)";
}
pub relation plan_lease_or_joint_use_under_binding_contract_1974_07_01(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(B): a lease or joint use of property under a binding contract in effect on July 1, 1974 (or a renewal of it)";
}
pub relation disposition_of_leased_property_at_fair_market_value(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(C): the plan receives not less than, or pays not more than, fair market value on the disposition of property described in (B)";
}
pub relation services_under_1974_arrangement_or_customary(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(D): services under a binding contract in effect on July 1, 1974, or which the disqualified person ordinarily and customarily furnished on June 30, 1974";
}
pub relation execution_not_prohibited_under_503b_at_the_time(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(A)-(D): the execution, making or provision was not, at the time, a prohibited transaction within the meaning of section 503(b) or the corresponding prior law";
}
rule Transition4975LoanUnderBindingContract(a: ExciseAct, on: Date) defeasible {
    label en official "note 6(2)(A): until June 30, 1984 a loan under a binding contract of July 1, 1974, at least as favorable as arm's length";
    when plan_loan_under_binding_contract_in_effect_1974_07_01(a);
    when remains_at_least_as_favorable_as_arms_length(a);
    when execution_not_prohibited_under_503b_at_the_time(a);
    when excise_act_occurred_on(a, on);
    when on <= @1984-06-30;
    then prohibited_transaction_exempt_4975(a);
}
rule Transition4975LeaseUnderBindingContract(a: ExciseAct, on: Date) defeasible {
    label en official "note 6(2)(B): until June 30, 1984 a lease or joint use under a binding contract of July 1, 1974";
    when plan_lease_or_joint_use_under_binding_contract_1974_07_01(a);
    when remains_at_least_as_favorable_as_arms_length(a);
    when execution_not_prohibited_under_503b_at_the_time(a);
    when excise_act_occurred_on(a, on);
    when on <= @1984-06-30;
    then prohibited_transaction_exempt_4975(a);
}
rule Transition4975DispositionOfLeasedProperty(a: ExciseAct, on: Date) defeasible {
    label en official "note 6(2)(C): before June 30, 1984 a disposition of (B) property at fair market value";
    when plan_lease_or_joint_use_under_binding_contract_1974_07_01(a);
    when disposition_of_leased_property_at_fair_market_value(a);
    when excise_act_occurred_on(a, on);
    when on < @1984-06-30;
    then prohibited_transaction_exempt_4975(a);
}
rule Transition4975Services(a: ExciseAct, on: Date) defeasible {
    label en official "note 6(2)(D): until June 30, 1977 services under a July 1, 1974 contract or customarily furnished on June 30, 1974";
    when services_under_1974_arrangement_or_customary(a);
    when remains_at_least_as_favorable_as_arms_length(a);
    when execution_not_prohibited_under_503b_at_the_time(a);
    when excise_act_occurred_on(a, on);
    when on <= @1977-06-30;
    then prohibited_transaction_exempt_4975(a);
}
pub relation plan_owned_property_on_1974_06_30_and_after(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(E): the property is owned by the plan on June 30, 1974 and at all times thereafter";
}
pub relation plan_required_to_dispose_under_erisa_407a2A(a: ExciseAct) kind empirical {
    label en unofficial "note 6(2)(E): the plan is required to dispose of the property to comply with section 407(a)(2)(A) of ERISA (excess employer securities and employer real property)";
}
rule Transition4975DispositionRequiredByErisa407(a: ExciseAct) defeasible {
    label en official "note 6(2)(E): a sale to a disqualified person of property the plan must dispose of under ERISA 407(a)(2)(A), for not less than adequate consideration (no end date)";
    when plan_owned_property_on_1974_06_30_and_after(a);
    when plan_required_to_dispose_under_erisa_407a2A(a);
    when adequate_consideration_4975f10(a);
    then prohibited_transaction_exempt_4975(a);
}

// --- note 4 under section 4955: 1996 binding-contract rule (section 4958) ---

pub relation transaction_under_written_contract_binding_since_1995_09_13(a: ExciseAct) kind empirical {
    label en unofficial "note 4(2): the benefit arises from a transaction pursuant to a written contract which was binding on September 13, 1995 and at all times thereafter before the transaction occurred";
}
pub relation excess_benefit_transaction_outside_1996_amendments(a: ExciseAct) kind institutional {
    label en official "note 4(1)-(2): section 4958 applies to excess benefit transactions on or after September 14, 1995, but not to a benefit arising under a written contract binding on September 13, 1995 and at all times thereafter";
}
rule ExcessBenefitOutside1996Amendments(a: ExciseAct) defeasible {
    label en official "note 4(2)";
    when transaction_under_written_contract_binding_since_1995_09_13(a);
    then excess_benefit_transaction_outside_1996_amendments(a);
}
rule ExcessBenefitBeforeEffectiveDate(a: ExciseAct, on: Date) defeasible {
    label en official "note 4(1): a transaction before September 14, 1995 is outside section 4958";
    when excess_benefit_transaction_date(a, on);
    when on < @1995-09-14;
    then excess_benefit_transaction_outside_1996_amendments(a);
}
