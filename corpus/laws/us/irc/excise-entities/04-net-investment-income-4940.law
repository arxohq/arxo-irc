// Section 4940 — excise tax based on investment income. Independent
// single-tier calculation (not the two-tier pattern of 4941 etc.).
//
// SCOPE:
//  - (a): the 1.39 percent flat tax on net investment income of an exempt
//    private foundation. Modelled fully.
//  - (c)(1): net investment income = gross investment income + capital
//    gain net income − allowed deductions. Modelled as exact Decimal/Money
//    arithmetic.
//  - (c)(2): gross investment income modelled as the SUM of its named
//    components (interest, dividends, rents, securities-loan payments,
//    royalties, similar income) rather than one opaque case fact — each
//    component is case-asserted (subtitle A's own computation of each
//    component is EXTERNAL_DEPENDENCY, per CONTRACT.md: subtitle A detail
//    is not in `us.irc.core`).
//  - (c)(3): allowed deductions modelled as ONE case-asserted aggregate
//    (`section_4940_allowed_deductions`); the (B) modifications — straight-
//    line-only depreciation (i), percentage-depletion disallowance (ii) —
//    are NOT modelled (the case must already have applied them before
//    asserting the aggregate) — TECH_GAP, not silently correct.
//  - (c)(4): capital gain net income modelled as ONE case-asserted
//    aggregate; the (A)-(D) adjustments (UBTI carve-out, the 12/31/1969
//    basis floor, the loss-limited-to-gains/no-carryover rule, and the
//    like-kind exchange rule) are NOT modelled — TECH_GAP.
//  - (c)(5) (tax-exempt bond interest and section 265 disallowance already
//    folded into subtitle A principles): NOT separately modelled — the
//    case-asserted gross investment income components already exclude what
//    section 103/265 would exclude, by the general "determined under the
//    principles of subtitle A" instruction in (c)(1) — INTERPRETATION.
//  - (b) (alternate tax for a private foundation not exempt under 501(a)):
//    NOT modelled — EXTERNAL_DEPENDENCY on subtitle A tax and section 511
//    UBIT tax amounts, neither of which this module computes.
//  - (d) (exempt operating foundation exception): the relation is declared
//    as a case-asserted placeholder pending the section 4942(j)(3)
//    operating-foundation test (not modelled this stage) and the full
//    (d)(2)(C)-(D) governing-body aggregate (needs a disqualified-
//    individual headcount fraction this stage does not implement) —
//    EXTERNAL_DEPENDENCY / TECH_GAP, not a silent pass-through.

use self::{
    IRC_S4940_A,
    IRC_S4940_C,
    IRC_S4940_D,
    Person,
    TaxableYear,
    exempt_operating_foundation_4940d2,
    section_4940_deduction_components_supplied,
};

@source(IRC_S4940_C, coverage = partial, quote = "the term \"gross investment income\" means the gross amount of income from interest, dividends, rents, payments with respect to securities loans (as defined in section 512(a)(5)), and royalties")
pub relation section_4940_interest_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) component: gross interest income for the taxable year (subtitle A computation is EXTERNAL_DEPENDENCY)";
}
pub relation section_4940_dividend_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) component: gross dividend income for the taxable year";
}
pub relation section_4940_rental_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) component: gross rental income for the taxable year";
}
pub relation section_4940_securities_loan_payments(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) component: payments with respect to securities loans (section 512(a)(5)) for the taxable year";
}
pub relation section_4940_royalty_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) component: gross royalty income for the taxable year";
}
@source(IRC_S4940_C, coverage = partial, quote = "Such term shall also include income from sources similar to those in the preceding sentence.")
pub relation section_4940_similar_investment_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(2) last sentence: income from sources similar to interest/dividends/rents/securities-loan payments/royalties";
}

@source(IRC_S4940_C, coverage = partial, quote = "the term \"gross investment income\" means the gross amount of income from interest, dividends, rents, payments with respect to securities loans (as defined in section 512(a)(5)), and royalties, but not including any such income to the extent included in computing the tax imposed by section 511. Such term shall also include income from sources similar to those in the preceding sentence.")
pub relation gross_investment_income(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(2): the gross amount of interest, dividend, rental, securities-loan-payment, royalty, and similar income (net of amounts included in computing the section 511 UBIT tax — this exclusion is EXTERNAL_DEPENDENCY on the `exempt-organizations` package's own UBTI computation and is not re-tested here; the case-asserted components must already exclude it)";
}
rule GrossInvestmentIncome(f: Person, y: TaxableYear, amount: Money, interest: Money, dividends: Money, rents: Money, loans: Money, royalties: Money, similar: Money) defeasible {
    label en official "section 4940(c)(2): gross investment income is the sum of its named components";
    when section_4940_interest_income(f, y, interest);
    when section_4940_dividend_income(f, y, dividends);
    when section_4940_rental_income(f, y, rents);
    when section_4940_securities_loan_payments(f, y, loans);
    when section_4940_royalty_income(f, y, royalties);
    when section_4940_similar_investment_income(f, y, similar);
    then gross_investment_income(f, y, interest + dividends + rents + loans + royalties + similar);
}

@source(IRC_S4940_C, coverage = partial, quote = "For purposes of paragraph (1) in determining capital gain net income")
pub relation section_4940_capital_gain_net_income(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(4): capital gain net income, case-asserted as ONE aggregate — the (A)-(D) adjustments are NOT separately modelled (TECH_GAP, see module header)";
}

@source(IRC_S4940_C, coverage = partial, quote = "there shall be allowed as a deduction all the ordinary and necessary expenses paid or incurred for the production or collection of gross investment income or for the management, conservation, or maintenance of property held for the production of such income")
pub relation section_4940_allowed_deductions(f: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4940(c)(3): ordinary and necessary expenses for the production/collection of gross investment income or the management/conservation/maintenance of income-producing property, case-asserted as ONE aggregate with the (B)(i)-(ii) straight-line-depreciation-only / no-percentage-depletion modifications already applied by the case (TECH_GAP: not independently enforced here)";
}

@source(IRC_S4940_C, coverage = partial, quote = "the net investment income is the amount by which (A) the sum of the gross investment income and the capital gain net income exceeds (B) the deductions allowed by paragraph (3)")
pub relation foundation_net_investment_income(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(c)(1): net investment income = gross investment income + capital gain net income − allowed deductions";
}
rule NetInvestmentIncome(f: Person, y: TaxableYear, amount: Money, gross: Money, capgain: Money, deductions: Money) defeasible {
    label en official "section 4940(c)(1): net investment income = gross investment income + capital gain net income − allowed deductions";
    when gross_investment_income(f, y, gross);
    when section_4940_capital_gain_net_income(f, y, capgain);
    when section_4940_allowed_deductions(f, y, deductions);
    // Stage 3: the component path of 26-*.law replaces the aggregate when the case supplies the (c)(3) components.
    unless section_4940_deduction_components_supplied(f, y) and gross_investment_income(f, y, gross) and section_4940_capital_gain_net_income(f, y, capgain) and section_4940_allowed_deductions(f, y, deductions);
    then foundation_net_investment_income(f, y, gross + capgain - deductions);
}

@source(IRC_S4940_D, coverage = partial, quote = "No tax shall be imposed by this section on any private foundation which is an exempt operating foundation for the taxable year.")
pub relation exempt_operating_foundation(f: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 4940(d): case-asserted placeholder pending the section 4942(j)(3) operating-foundation test and the full (d)(2) governing-body aggregate — EXTERNAL_DEPENDENCY, see module header";
}

@source(IRC_S4940_A, coverage = partial, quote = "There is hereby imposed on each private foundation which is exempt from taxation under section 501(a) for the taxable year, with respect to the carrying on of its activities, a tax equal to 1.39 percent of the net investment income of such foundation for the taxable year.")
pub relation section_4940_excise_tax(f: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4940(a): 1.39 percent of the net investment income of an exempt private foundation for the taxable year, unless the foundation is an exempt operating foundation under (d)";
}
rule Section4940ExciseTax(f: Person, y: TaxableYear, amount: Money, nii: Money) defeasible {
    label en official "section 4940(a): 1.39 percent of net investment income, imposed on a private foundation exempt under section 501(a), unless it is an exempt operating foundation under (d)";
    when us.irc.exempt_organizations::exempt_organization(f, y);
    when us.irc.exempt_organizations::private_foundation(f, y);
    when foundation_net_investment_income(f, y, nii);
    unless exempt_operating_foundation(f, y) and foundation_net_investment_income(f, y, nii);
    // Stage 3: the derived section 4940(d)(2) test (26-*.law).
    unless exempt_operating_foundation_4940d2(f, y) and foundation_net_investment_income(f, y, nii);
    then section_4940_excise_tax(f, y, round(nii * NetInvestmentIncomeTaxRate, 2, "HALF_UP"));
}
