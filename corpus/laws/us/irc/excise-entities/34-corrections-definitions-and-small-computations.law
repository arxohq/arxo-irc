// Stage 3 (26.09.2026). Definitions and small computations that stage 2 left as
// technical gaps: the "correction" definitions of sections 4945(i), 4951(e),
// 4952(e), 4955(f), 4971(c)(2) and 4980D(f)(3); employer size and
// headcount definitions (4980D(d)(2), 4980H(c)(2)(C)-(D), 4980E(d)(4), 5000A(c)(4)(A));
// section 4971(c)(4), (f)(3), (g)(3); 4972(c)(2), (c)(4); 4978(b)(3);
// 4979A(e)(2)(C); 4980F(e)-(f); 5000D(c), (f)(2); 4985(e)(3), (f).
//
// JUDGMENT CALLS. (a) Averages over business days and counts over a controlled
// group are case inputs (a count or average over a derived set is the section 111
// runtime subset limit, TECH-GAPS G5910). (b) The FIFO ordering of section
// 4971(c)(4)(B) and the carryforward ordering of 4972(c)(2) are applied to
// totals of the earlier years (the year-by-year residual is not iterated).
// (c) Amounts the statute leaves unrounded are cents HALF_UP where a division
// occurs. Status: implemented_unverified; scenarios not executed; no legal review.

// --- correction definitions ---

use self::{
    DesignatedDrugSale,
    EsopAllocationEvent,
    EsopDisposition,
    ExciseAct,
    IRC_S4980F_E,
    Person,
    Plan,
    TaxableYear,
    accrual_reduction_notice_given,
    applicable_large_employer,
    deduction_allowable_under_404_for_contributions,
    esop_amount_realized,
    esop_event_amount_involved,
    workforce_over_50_full_time_days_and_seasonal,
};

pub relation expenditure_recovered_in_full(a: ExciseAct) kind empirical {
    label en unofficial "the expenditure was recovered in full";
}
pub relation expenditure_recovered_to_extent_possible(a: ExciseAct) kind empirical {
    label en unofficial "part or all of the expenditure was recovered to the extent recovery is possible";
}
pub relation full_recovery_not_possible(a: ExciseAct) kind empirical {
    label en unofficial "full recovery is not possible";
}
pub relation additional_corrective_action_prescribed_taken(a: ExciseAct) kind empirical {
    label en unofficial "such additional corrective action as the Secretary prescribes by regulations was taken (the regulation is not pinned)";
}
pub relation report_in_question_obtained_or_made(a: ExciseAct) kind empirical {
    label en unofficial "section 4945(i)(1)(B): in the case of a failure to comply with subsection (h)(2) or (h)(3), the report in question was obtained or made";
}
pub relation failure_is_h2_or_h3_reporting(a: ExciseAct) kind empirical {
    label en unofficial "section 4945(i)(1)(B): the failure is a failure to comply with subsection (h)(2) or (h)(3)";
}
pub relation taxable_expenditure_corrected_4945i(a: ExciseAct) kind institutional {
    label en official "section 4945(i)(1): correction: (A) recovery to the extent possible (with additional corrective action where full recovery is not possible) or (B) obtaining or making the report";
}
rule TaxableExpenditureCorrectedByFullRecovery(a: ExciseAct) defeasible {
    label en official "section 4945(i)(1)(A): full recovery";
    when expenditure_recovered_in_full(a);
    then taxable_expenditure_corrected_4945i(a);
}
rule TaxableExpenditureCorrectedByPartialRecoveryAndAction(a: ExciseAct) defeasible {
    label en official "section 4945(i)(1)(A): recovery to the extent possible plus the prescribed corrective action where full recovery is not possible";
    when expenditure_recovered_to_extent_possible(a);
    when full_recovery_not_possible(a);
    when additional_corrective_action_prescribed_taken(a);
    then taxable_expenditure_corrected_4945i(a);
}
rule TaxableExpenditureCorrectedByReport(a: ExciseAct) defeasible {
    label en official "section 4945(i)(1)(B): the report in question was obtained or made";
    when failure_is_h2_or_h3_reporting(a);
    when report_in_question_obtained_or_made(a);
    then taxable_expenditure_corrected_4945i(a);
}
pub relation trust_transaction_undone_to_extent_possible(a: ExciseAct) kind empirical {
    label en unofficial "the transaction was undone to the extent possible";
}
pub relation trust_position_not_worse_than_highest_fiduciary_standard(a: ExciseAct) kind empirical {
    label en unofficial "the trust is in a financial position not worse than that in which it would be if the disqualified person were dealing under the highest fiduciary standards";
}
pub relation trust_self_dealing_corrected_4951e3(a: ExciseAct) kind institutional {
    label en official "section 4951(e)(3): correction: undoing the transaction to the extent possible and placing the trust in a position not worse than under the highest fiduciary standards";
}
rule TrustSelfDealingCorrected(a: ExciseAct) defeasible {
    label en official "section 4951(e)(3)";
    when trust_transaction_undone_to_extent_possible(a);
    when trust_position_not_worse_than_highest_fiduciary_standard(a);
    then trust_self_dealing_corrected_4951e3(a);
}
pub relation contributions_by_liability_persons_to_restore_trust(a: ExciseAct) kind empirical {
    label en unofficial "section 4952(e)(1): where full recovery is not possible, contributions were made by the persons whose black lung benefit claim liabilities are to be paid out of the trust, to the extent necessary to place the trust in a position not worse than if the expenditure had not been made";
}
pub relation black_lung_expenditure_corrected_4952e1(a: ExciseAct) kind institutional {
    label en official "section 4952(e)(1): correction of a taxable expenditure of a black lung benefit trust";
}
rule BlackLungExpenditureCorrectedByRecovery(a: ExciseAct) defeasible {
    label en official "section 4952(e)(1): full recovery";
    when expenditure_recovered_in_full(a);
    then black_lung_expenditure_corrected_4952e1(a);
}
rule BlackLungExpenditureCorrectedByContributions(a: ExciseAct) defeasible {
    label en official "section 4952(e)(1): recovery to the extent possible and contributions to make the trust whole";
    when expenditure_recovered_to_extent_possible(a);
    when full_recovery_not_possible(a);
    when contributions_by_liability_persons_to_restore_trust(a);
    then black_lung_expenditure_corrected_4952e1(a);
}
pub relation safeguards_against_future_political_expenditures_established(a: ExciseAct) kind empirical {
    label en unofficial "section 4955(f)(3): safeguards to prevent future political expenditures were established";
}
pub relation political_expenditure_corrected_4955f3(a: ExciseAct) kind institutional {
    label en official "section 4955(f)(3): correction: recovery to the extent possible, establishment of safeguards and, where full recovery is not possible, the corrective action the Secretary prescribes";
}
rule PoliticalExpenditureCorrectedFullRecovery(a: ExciseAct) defeasible {
    label en official "section 4955(f)(3): full recovery and safeguards";
    when expenditure_recovered_in_full(a);
    when safeguards_against_future_political_expenditures_established(a);
    then political_expenditure_corrected_4955f3(a);
}
rule PoliticalExpenditureCorrectedPartialRecovery(a: ExciseAct) defeasible {
    label en official "section 4955(f)(3): recovery to the extent possible, safeguards and the prescribed additional action";
    when expenditure_recovered_to_extent_possible(a);
    when full_recovery_not_possible(a);
    when safeguards_against_future_political_expenditures_established(a);
    when additional_corrective_action_prescribed_taken(a);
    then political_expenditure_corrected_4955f3(a);
}
pub relation deficiency_contribution_made(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(2): the contribution to or under the plan";
}
pub relation deficiency_at_end_of_plan_year(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(2): the accumulated funding deficiency (or CSEC accumulated funding deficiency) as of the end of the plan year in which it arose";
}
pub relation funding_deficiency_corrected_4971c2(a: ExciseAct) kind institutional {
    label en official "section 4971(c)(2): the contribution necessary to reduce the deficiency as of the end of the plan year to zero";
}
rule FundingDeficiencyCorrected(a: ExciseAct, contributed: Money, deficiency: Money) defeasible {
    label en official "section 4971(c)(2): contribution at least the deficiency";
    when deficiency_contribution_made(a, contributed);
    when deficiency_at_end_of_plan_year(a, deficiency);
    when contributed >= deficiency;
    then funding_deficiency_corrected_4971c2(a);
}
pub relation ghp_failure_retroactively_undone(a: ExciseAct) kind empirical {
    label en unofficial "section 4980D(f)(3)(A): the failure is retroactively undone to the extent possible";
}
pub relation ghp_person_placed_in_as_good_position(a: ExciseAct) kind empirical {
    label en unofficial "section 4980D(f)(3)(B): the person to whom the failure relates is placed in a financial position as good as if the failure had not occurred";
}
pub relation ghp_failure_corrected_4980Df3(a: ExciseAct) kind institutional {
    label en official "section 4980D(f)(3): the failure is treated as corrected";
}
rule GhpFailureCorrected(a: ExciseAct) defeasible {
    label en official "section 4980D(f)(3)(A)-(B)";
    when ghp_failure_retroactively_undone(a);
    when ghp_person_placed_in_as_good_position(a);
    then ghp_failure_corrected_4980Df3(a);
}

// --- employer size and headcount definitions ---

pub relation average_business_day_employees_preceding_year(emp: Person, cy: Integer, average: Decimal) kind empirical {
    label en unofficial "sections 4980D(d)(2)(A), 4980H(c)(2): the average number of employees on business days during the preceding calendar year, with all persons treated as a single employer under section 414(b), (c), (m) or (o) (a group count, case input)";
}
pub relation employees_on_first_day_of_plan_year(emp: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 4980D(d)(2)(A): the number of employees the employer has on the first day of the plan year";
}
pub relation employer_existed_throughout_preceding_calendar_year(emp: Person, cy: Integer) kind empirical {
    label en unofficial "sections 4980D(d)(2)(B), 4980H(c)(2)(C)(ii): the employer was in existence throughout the preceding calendar year";
}
pub relation expected_average_business_day_employees_current_year(emp: Person, cy: Integer, average: Decimal) kind empirical {
    label en unofficial "sections 4980D(d)(2)(B), 4980H(c)(2)(C)(ii): the average number of employees the employer is reasonably expected to employ on business days in the current calendar year";
}
pub relation predecessor_employer_of(emp: Person, pred: Person) kind empirical {
    label en unofficial "sections 4980D(d)(2)(C), 4980H(c)(2)(C)(iii): pred is a predecessor of the employer";
}
pub relation predecessor_average_business_day_employees_preceding_year(pred: Person, cy: Integer, average: Decimal) kind empirical {
    label en unofficial "the predecessor's average number of employees on business days during the preceding calendar year";
}
pub relation counted_average_employees_4980D(emp: Person, cy: Integer, average: Decimal) kind institutional {
    label en official "sections 4980D(d)(2)(A)-(C): the employer's average employee count: the preceding-year average (or the expected average of a new employer), plus a predecessor's";
}
rule CountedAverageEstablishedEmployer(emp: Person, cy: Integer, avg: Decimal) defeasible {
    label en official "section 4980D(d)(2)(A): the preceding calendar year average";
    when average_business_day_employees_preceding_year(emp, cy, avg);
    when employer_existed_throughout_preceding_calendar_year(emp, cy);
    unless predecessor_employer_of(emp, _) and average_business_day_employees_preceding_year(emp, cy, avg) and employer_existed_throughout_preceding_calendar_year(emp, cy);
    then counted_average_employees_4980D(emp, cy, avg);
}
rule CountedAverageNewEmployer(emp: Person, cy: Integer, avg: Decimal) defeasible {
    label en official "section 4980D(d)(2)(B): an employer not in existence throughout the preceding calendar year is tested on the expected average for the current year";
    when expected_average_business_day_employees_current_year(emp, cy, avg);
    unless employer_existed_throughout_preceding_calendar_year(emp, cy) and expected_average_business_day_employees_current_year(emp, cy, avg);
    unless predecessor_employer_of(emp, _) and expected_average_business_day_employees_current_year(emp, cy, avg);
    then counted_average_employees_4980D(emp, cy, avg);
}
rule CountedAverageWithPredecessor(emp: Person, cy: Integer, avg: Decimal, pred: Person, pavg: Decimal) defeasible {
    label en official "section 4980D(d)(2)(C): a reference to the employer includes its predecessor";
    when average_business_day_employees_preceding_year(emp, cy, avg);
    when employer_existed_throughout_preceding_calendar_year(emp, cy);
    when predecessor_employer_of(emp, pred);
    when predecessor_average_business_day_employees_preceding_year(pred, cy, pavg);
    then counted_average_employees_4980D(emp, cy, avg + pavg);
}
pub relation small_employer_4980D(emp: Person, cy: Integer) kind institutional {
    label en official "section 4980D(d)(2)(A): an average of at least 2 but not more than 50 employees on business days during the preceding calendar year and at least 2 employees on the first day of the plan year";
}
rule SmallEmployer4980D(emp: Person, cy: Integer, avg: Decimal, n: Integer) defeasible {
    label en official "section 4980D(d)(2)(A)-(C)";
    when counted_average_employees_4980D(emp, cy, avg);
    when avg >= 2.0;
    when avg <= 50.0;
    when employees_on_first_day_of_plan_year(emp, cy, n);
    when n >= 2;
    then small_employer_4980D(emp, cy);
}
pub relation counted_average_employees_4980H(emp: Person, cy: Integer, average: Decimal) kind institutional {
    label en official "section 4980H(c)(2)(C)(ii)-(iii): a new employer is tested on the expected current-year average; a reference to the employer includes its predecessor";
}
rule Counted4980HEstablished(emp: Person, cy: Integer, avg: Decimal) defeasible {
    label en official "section 4980H(c)(2)(A): the preceding calendar year";
    when average_business_day_employees_preceding_year(emp, cy, avg);
    when employer_existed_throughout_preceding_calendar_year(emp, cy);
    unless predecessor_employer_of(emp, _) and average_business_day_employees_preceding_year(emp, cy, avg) and employer_existed_throughout_preceding_calendar_year(emp, cy);
    then counted_average_employees_4980H(emp, cy, avg);
}
rule Counted4980HNewEmployer(emp: Person, cy: Integer, avg: Decimal) defeasible {
    label en official "section 4980H(c)(2)(C)(ii)";
    when expected_average_business_day_employees_current_year(emp, cy, avg);
    unless employer_existed_throughout_preceding_calendar_year(emp, cy) and expected_average_business_day_employees_current_year(emp, cy, avg);
    unless predecessor_employer_of(emp, _) and expected_average_business_day_employees_current_year(emp, cy, avg);
    then counted_average_employees_4980H(emp, cy, avg);
}
rule Counted4980HWithPredecessor(emp: Person, cy: Integer, avg: Decimal, pred: Person, pavg: Decimal) defeasible {
    label en official "section 4980H(c)(2)(C)(iii)";
    when average_business_day_employees_preceding_year(emp, cy, avg);
    when employer_existed_throughout_preceding_calendar_year(emp, cy);
    when predecessor_employer_of(emp, pred);
    when predecessor_average_business_day_employees_preceding_year(pred, cy, pavg);
    then counted_average_employees_4980H(emp, cy, avg + pavg);
}
pub relation applicable_large_employer_by_count_4980H(emp: Person, cy: Integer) kind institutional {
    label en official "section 4980H(c)(2)(A), (C): an employer whose counted average of full-time employees (with a new employer's expected average and any predecessor's) is at least 50";
}
rule ApplicableLargeEmployerByCount(emp: Person, cy: Integer, avg: Decimal) defeasible {
    label en official "section 4980H(c)(2)(A), (C)(ii)-(iii)";
    when counted_average_employees_4980H(emp, cy, avg);
    when avg >= 50.0;
    then applicable_large_employer_by_count_4980H(emp, cy);
}
rule ApplicableLargeEmployerViaCount(emp: Person, cy: Integer) defeasible {
    label en official "section 4980H(c)(2)(C)(ii)-(iii): the counted-average path also makes an applicable large employer";
    when applicable_large_employer_by_count_4980H(emp, cy);
    unless workforce_over_50_full_time_days_and_seasonal(emp, cy) and applicable_large_employer_by_count_4980H(emp, cy);
    then applicable_large_employer(emp, cy);
}
pub relation group_member_full_time_employees(member: Person, group: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 4980H(c)(2)(D)(ii): the number of full-time employees employed by the member of a group treated as one employer";
}
pub relation group_total_full_time_employees(group: Person, cy: Integer, n: Integer) kind empirical {
    label en unofficial "section 4980H(c)(2)(D)(ii): the number of full-time employees of the whole group";
}
pub relation member_share_of_group_reduction_4980H(member: Person, group: Person, cy: Integer, reduction: Decimal) kind institutional {
    label en official "section 4980H(c)(2)(D)(ii): only one reduction of 30 employees is allowed for the group, allocated among the members ratably by full-time employees (cents HALF_UP on the number of employees, JUDGMENT CALL)";
}
rule MemberShareOfGroupReduction(member: Person, group: Person, cy: Integer, mine: Integer, total: Integer) defeasible {
    label en official "section 4980H(c)(2)(D)(ii): 30 * member full-time employees / group full-time employees";
    when group_member_full_time_employees(member, group, cy, mine);
    when group_total_full_time_employees(group, cy, total);
    when total > 0;
    then member_share_of_group_reduction_4980H(member, group, cy, div_round(30.0 * mine, total * 1.0, 2, "HALF_UP"));
}
pub relation customarily_employed_hours_per_week(e: Person, cy: Integer, hours: Decimal) kind empirical {
    label en unofficial "section 4980E(d)(4)(B): the number of hours per week the employee is customarily employed";
}
pub relation part_time_employee_4980E(e: Person, cy: Integer) kind institutional {
    label en official "section 4980E(d)(4)(B): an employee customarily employed for fewer than 30 hours per week (the comparability test is applied to part-time and other employees separately, (d)(4)(A), by ComparableMsaPair)";
}
rule PartTimeEmployee4980E(e: Person, cy: Integer, h: Decimal) defeasible {
    label en official "section 4980E(d)(4)(B)";
    when customarily_employed_hours_per_week(e, cy, h);
    when h < 30.0;
    then part_time_employee_4980E(e, cy);
}
pub relation individuals_for_whom_151_deduction_allowed(t: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "section 5000A(c)(4)(A): the number of individuals for whom the taxpayer is allowed a deduction under section 151 for the taxable year";
}
pub relation family_size_5000A(t: Person, y: TaxableYear, n: Integer) kind institutional {
    label en official "section 5000A(c)(4)(A): the family size equals the number of individuals for whom the taxpayer is allowed a section 151 deduction";
}
rule FamilySize5000A(t: Person, y: TaxableYear, n: Integer) defeasible {
    label en official "section 5000A(c)(4)(A)";
    when individuals_for_whom_151_deduction_allowed(t, y, n);
    then family_size_5000A(t, y, n);
}

// --- 4971(c)(4): unpaid minimum required contributions and FIFO allocation ---

pub relation minimum_required_contribution_430(a: ExciseAct, py: Integer, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(4)(A): the minimum required contribution under section 430 for the plan year";
}
pub relation contribution_paid_by_due_date_430j1(a: ExciseAct, py: Integer, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(4)(A): the amount of it paid on or before the due date determined under section 430(j)(1)";
}
pub relation unpaid_minimum_required_contribution_for_year(a: ExciseAct, py: Integer, amount: Money) kind institutional {
    label en official "section 4971(c)(4)(A): the minimum required contribution for the plan year not paid on or before its due date";
}
rule UnpaidMinimumRequiredContribution(a: ExciseAct, py: Integer, req: Money, paid: Money) defeasible {
    label en official "section 4971(c)(4)(A): required minus paid by the due date, when positive";
    when minimum_required_contribution_430(a, py, req);
    when contribution_paid_by_due_date_430j1(a, py, paid);
    when req > paid;
    then unpaid_minimum_required_contribution_for_year(a, py, req - paid);
}
rule UnpaidMinimumRequiredContributionNothingPaid(a: ExciseAct, py: Integer, req: Money) defeasible {
    label en official "section 4971(c)(4)(A): nothing paid by the due date";
    when minimum_required_contribution_430(a, py, req);
    unless contribution_paid_by_due_date_430j1(a, py, _) and minimum_required_contribution_430(a, py, req);
    then unpaid_minimum_required_contribution_for_year(a, py, req);
}
pub relation payment_for_plan_year(a: ExciseAct, py: Integer, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(4)(B): a payment to or under the plan for the plan year";
}
pub relation unpaid_minimum_required_contributions_of_preceding_years(a: ExciseAct, py: Integer, amount: Money) kind empirical {
    label en unofficial "section 4971(c)(4)(B): the total unpaid minimum required contributions for all preceding plan years (the year-by-year first-in first-out residuals are not iterated)";
}
pub relation payment_allocated_to_preceding_years(a: ExciseAct, py: Integer, amount: Money) kind institutional {
    label en official "section 4971(c)(4)(B): the part of the payment allocated first to unpaid minimum required contributions of preceding plan years";
}
pub relation payment_allocated_to_current_year(a: ExciseAct, py: Integer, amount: Money) kind institutional {
    label en official "section 4971(c)(4)(B): the rest of the payment allocated to the minimum required contribution for the plan year";
}
rule PaymentAllocatedWithinPreceding(a: ExciseAct, py: Integer, pay: Money, unpaid: Money) defeasible {
    label en official "section 4971(c)(4)(B): the payment does not exceed the preceding years' unpaid amounts";
    when payment_for_plan_year(a, py, pay);
    when unpaid_minimum_required_contributions_of_preceding_years(a, py, unpaid);
    when pay <= unpaid;
    then payment_allocated_to_preceding_years(a, py, pay);
}
rule PaymentAllocatedExceedsPreceding(a: ExciseAct, py: Integer, pay: Money, unpaid: Money) defeasible {
    label en official "section 4971(c)(4)(B): the payment exceeds the preceding years' unpaid amounts";
    when payment_for_plan_year(a, py, pay);
    when unpaid_minimum_required_contributions_of_preceding_years(a, py, unpaid);
    when pay > unpaid;
    then payment_allocated_to_preceding_years(a, py, unpaid);
}
rule PaymentAllocatedCurrentRemainder(a: ExciseAct, py: Integer, pay: Money, unpaid: Money) defeasible {
    label en official "section 4971(c)(4)(B): the remainder goes to the current plan year";
    when payment_for_plan_year(a, py, pay);
    when unpaid_minimum_required_contributions_of_preceding_years(a, py, unpaid);
    when pay > unpaid;
    then payment_allocated_to_current_year(a, py, pay - unpaid);
}
rule PaymentAllocatedNoCurrentWhenAllPreceding(a: ExciseAct, py: Integer, pay: Money, unpaid: Money) defeasible {
    label en official "section 4971(c)(4)(B): no remainder";
    when payment_for_plan_year(a, py, pay);
    when unpaid_minimum_required_contributions_of_preceding_years(a, py, unpaid);
    when pay <= unpaid;
    then payment_allocated_to_current_year(a, py, 0.00 USD);
}

// --- 4971(f)(3)(B): no further tax once the second-tier tax is paid for the quarter ---

pub relation liquidity_second_tier_tax_paid_for_quarter(a: ExciseAct) kind empirical {
    label en unofficial "section 4971(f)(3)(B): the tax imposed by paragraph (2) has been paid with respect to the liquidity shortfall for the quarter";
}

// --- 4971(g)(3): deemed accumulated funding deficiency ---

pub relation multiemployer_plan_seriously_endangered_and_benchmarks_missed(a: ExciseAct) kind empirical {
    label en unofficial "section 4971(g)(3)(A): a plan in seriously endangered status fails to meet the applicable benchmarks by the end of the funding improvement period";
}
pub relation multiemployer_plan_critical_and_rehabilitation_requirements_missed(a: ExciseAct) kind empirical {
    label en unofficial "section 4971(g)(3)(B)(i): a plan in critical status fails to meet the requirements of section 432(e) by the end of the rehabilitation period";
}
pub relation multiemployer_plan_certified_no_progress_three_years(a: ExciseAct) kind empirical {
    label en unofficial "section 4971(g)(3)(B)(ii): a plan in critical status received a certification under section 432(b)(3)(A)(ii) for 3 consecutive plan years that it is not making the scheduled progress";
}
pub relation contributions_necessary_to_meet_benchmarks_or_requirements(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4971(g)(3): the amount of the contributions necessary to meet the benchmarks or requirements";
}
pub relation accumulated_funding_deficiency_of_last_plan_year(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4971(g)(3): the accumulated funding deficiency (if any) of the last plan year in the period";
}
pub relation deemed_deficiency_trigger_4971g3(a: ExciseAct) kind institutional {
    label en official "section 4971(g)(3)(A)-(B): the plan missed the benchmarks or requirements or received three consecutive no-progress certifications";
}
rule DeemedDeficiencyTriggerSeriouslyEndangered(a: ExciseAct) defeasible { label en official "section 4971(g)(3)(A)"; when multiemployer_plan_seriously_endangered_and_benchmarks_missed(a); then deemed_deficiency_trigger_4971g3(a); }
rule DeemedDeficiencyTriggerCriticalRehabilitation(a: ExciseAct) defeasible { label en official "section 4971(g)(3)(B)(i)"; when multiemployer_plan_critical_and_rehabilitation_requirements_missed(a); then deemed_deficiency_trigger_4971g3(a); }
rule DeemedDeficiencyTriggerNoProgress(a: ExciseAct) defeasible { label en official "section 4971(g)(3)(B)(ii)"; when multiemployer_plan_certified_no_progress_three_years(a); then deemed_deficiency_trigger_4971g3(a); }
pub relation deemed_accumulated_funding_deficiency_4971g3(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4971(g)(3): the plan is treated as having an accumulated funding deficiency for the last plan year of the period in an amount equal to the greater of the contributions necessary and the actual deficiency";
}
rule DeemedDeficiencyNecessaryContributionsGreater(a: ExciseAct, need: Money, actual: Money) defeasible {
    label en official "section 4971(g)(3): the contributions necessary are the greater amount";
    when deemed_deficiency_trigger_4971g3(a);
    when contributions_necessary_to_meet_benchmarks_or_requirements(a, need);
    when accumulated_funding_deficiency_of_last_plan_year(a, actual);
    when need >= actual;
    then deemed_accumulated_funding_deficiency_4971g3(a, need);
}
rule DeemedDeficiencyActualGreater(a: ExciseAct, need: Money, actual: Money) defeasible {
    label en official "section 4971(g)(3): the actual deficiency is the greater amount";
    when deemed_deficiency_trigger_4971g3(a);
    when contributions_necessary_to_meet_benchmarks_or_requirements(a, need);
    when accumulated_funding_deficiency_of_last_plan_year(a, actual);
    when actual > need;
    then deemed_accumulated_funding_deficiency_4971g3(a, actual);
}
rule DeemedDeficiencyNoActualDeficiency(a: ExciseAct, need: Money) defeasible {
    label en official "section 4971(g)(3): no accumulated funding deficiency of the last plan year exists, so the contributions necessary";
    when deemed_deficiency_trigger_4971g3(a);
    when contributions_necessary_to_meet_benchmarks_or_requirements(a, need);
    unless accumulated_funding_deficiency_of_last_plan_year(a, _) and deemed_deficiency_trigger_4971g3(a) and contributions_necessary_to_meet_benchmarks_or_requirements(a, need);
    then deemed_accumulated_funding_deficiency_4971g3(a, need);
}
pub relation benchmarks_or_requirements_unmet_in_plan_year(a: ExciseAct, py: Integer) kind empirical {
    label en unofficial "section 4971(g)(3): the benchmarks or requirements are not yet met in the succeeding plan year";
}
pub relation deemed_deficiency_persists_in_plan_year(a: ExciseAct, py: Integer) kind institutional {
    label en official "section 4971(g)(3): the deemed deficiency continues for each succeeding plan year until the benchmarks or requirements are met";
}
rule DeemedDeficiencyPersists(a: ExciseAct, py: Integer, amount: Money) defeasible {
    label en official "section 4971(g)(3), parenthetical";
    when deemed_accumulated_funding_deficiency_4971g3(a, amount);
    when benchmarks_or_requirements_unmet_in_plan_year(a, py);
    then deemed_deficiency_persists_in_plan_year(a, py);
}

// --- 4972(c)(2), (c)(4) ---

pub relation carryforward_deduction_to_year(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4972(c)(2)(A): the carryforwards to the taxable year from preceding taxable years";
}
pub relation deduction_treated_as_from_carryforward(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4972(c)(2)(A): the deduction allowable under section 404 is treated first as coming from carryforwards (in order of time)";
}
pub relation deduction_treated_as_from_current_contributions(employer: Person, plan: Plan, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4972(c)(2)(B): then from contributions made during the taxable year";
}
rule DeductionFromCarryforwardWithinCf(employer: Person, plan: Plan, y: TaxableYear, ded: Money, cf: Money) defeasible {
    label en official "section 4972(c)(2)(A): the deduction does not exceed the carryforwards";
    when deduction_allowable_under_404_for_contributions(employer, plan, y, ded);
    when carryforward_deduction_to_year(employer, plan, y, cf);
    when ded <= cf;
    then deduction_treated_as_from_carryforward(employer, plan, y, ded);
}
rule DeductionFromCarryforwardExceedsCf(employer: Person, plan: Plan, y: TaxableYear, ded: Money, cf: Money) defeasible {
    label en official "section 4972(c)(2)(A): the deduction exceeds the carryforwards";
    when deduction_allowable_under_404_for_contributions(employer, plan, y, ded);
    when carryforward_deduction_to_year(employer, plan, y, cf);
    when ded > cf;
    then deduction_treated_as_from_carryforward(employer, plan, y, cf);
}
rule DeductionFromCurrentRemainder(employer: Person, plan: Plan, y: TaxableYear, ded: Money, cf: Money) defeasible {
    label en official "section 4972(c)(2)(B): the remainder comes from the year's contributions";
    when deduction_allowable_under_404_for_contributions(employer, plan, y, ded);
    when carryforward_deduction_to_year(employer, plan, y, cf);
    when ded > cf;
    then deduction_treated_as_from_current_contributions(employer, plan, y, ded - cf);
}
rule DeductionFromCurrentWhenNoRemainder(employer: Person, plan: Plan, y: TaxableYear, ded: Money, cf: Money) defeasible {
    label en official "section 4972(c)(2)(B): nothing left for current contributions";
    when deduction_allowable_under_404_for_contributions(employer, plan, y, ded);
    when carryforward_deduction_to_year(employer, plan, y, cf);
    when ded <= cf;
    then deduction_treated_as_from_current_contributions(employer, plan, y, 0.00 USD);
}
pub relation required_contribution_412_for_self_employed(plan: Plan, ind: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4972(c)(4)(A): the amount required to be contributed under section 412 on behalf of an individual who is an employee within the meaning of section 401(c)(1)";
}
pub relation earned_income_404a8(ind: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "section 4972(c)(4)(B): the earned income (section 404(a)(8)) derived from the trade or business for which the plan is established";
}
pub relation self_employed_excess_treated_as_deduction_4972c4(plan: Plan, ind: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4972(c)(4): the excess of the required contribution over the earned income is treated as an amount allowable as a deduction under section 404";
}
rule SelfEmployedExcessTreatedAsDeduction(plan: Plan, ind: Person, y: TaxableYear, req: Money, earned: Money) defeasible {
    label en official "section 4972(c)(4)";
    when required_contribution_412_for_self_employed(plan, ind, y, req);
    when earned_income_404a8(ind, y, earned);
    when req > earned;
    then self_employed_excess_treated_as_deduction_4972c4(plan, ind, y, req - earned);
}

// --- 4978(b)(3), 4979A(e)(2)(C) ---

pub relation esop_distribution_to_employee(d: EsopDisposition) kind empirical {
    label en unofficial "section 4978(b)(3): the disposition is a distribution to an employee";
}
pub relation esop_distribution_price_paid(d: EsopDisposition, amount: Money) kind empirical {
    label en unofficial "the amount the employee actually paid (zero for a distribution without payment)";
}
pub relation esop_security_fair_market_value(d: EsopDisposition, amount: Money) kind empirical {
    label en unofficial "the fair market value of the qualified security on the disposition";
}
rule EsopAmountRealizedDistributionBelowFmv(d: EsopDisposition, price: Money, fmv: Money) defeasible {
    label en official "section 4978(b)(3): the amount realized on a distribution to an employee for less than fair market value is determined as if the security had been sold at fair market value";
    when esop_distribution_to_employee(d);
    when esop_distribution_price_paid(d, price);
    when esop_security_fair_market_value(d, fmv);
    when price < fmv;
    then esop_amount_realized(d, fmv);
}
rule EsopAmountRealizedDistributionAtOrAboveFmv(d: EsopDisposition, price: Money, fmv: Money) defeasible {
    label en official "section 4978(b)(1): a distribution for at least fair market value realizes the price";
    when esop_distribution_to_employee(d);
    when esop_distribution_price_paid(d, price);
    when esop_security_fair_market_value(d, fmv);
    when price >= fmv;
    then esop_amount_realized(d, price);
}
pub relation first_nonallocation_year_4979A(a: EsopAllocationEvent) kind empirical {
    label en unofficial "section 4979A(e)(2)(C): the event concerns the first nonallocation year of the employee stock ownership plan";
}
pub relation deemed_owned_shares_value_of_disqualified_person(a: EsopAllocationEvent, dp: Person, value: Money) kind empirical {
    label en unofficial "section 4979A(e)(2)(C): the total value of the deemed-owned shares of the disqualified person with respect to the plan";
}
rule FirstNonallocationYearAmountInvolved(a: EsopAllocationEvent, total: Money) defeasible {
    label en official "section 4979A(e)(2)(C): the amount involved for the first nonallocation year is the total value of all the deemed-owned shares of all disqualified persons";
    when first_nonallocation_year_4979A(a);
    when deemed_owned_shares_value_of_disqualified_person(a, _, _);
    then esop_event_amount_involved(a, sum(collect all v: Money, dp: Person where deemed_owned_shares_value_of_disqualified_person(a, dp, v), empty: 0.00 USD));
}

// --- 4980F(e)-(f) ---

pub relation notice_delivered_to(admin: Person, i: Person, plan: Person, recipient: Person) kind empirical {
    label en unofficial "section 4980F(e)(1), (4): the notice was delivered to recipient (the applicable individual, or a person the individual designated in writing)";
}
pub relation notice_designee_designated_in_writing(i: Person, designee: Person) kind empirical {
    label en unofficial "section 4980F(e)(4): the applicable individual designated the person in writing";
}
@source(IRC_S4980F_E, coverage = partial, quote = "written in a manner calculated to be understood by the average plan participant")
external judgment relation notice_understandable_and_sufficient(plan: Person) {
    authority Secretary;
    label en official "section 4980F(e)(2): the notice is written in a manner calculated to be understood by the average plan participant and provides sufficient information (as determined under regulations) to allow applicable individuals to understand the effect of the plan amendment";
}
@source(IRC_S4980F_E, coverage = partial, quote = "within a reasonable time before the effective date of the plan amendment")
external judgment relation notice_within_reasonable_time_before_effective_date(plan: Person) {
    authority Secretary;
    label en official "section 4980F(e)(3): the notice is provided within a reasonable time before the effective date of the plan amendment (except as provided in regulations)";
}
pub relation notice_provided_before_adoption_without_material_modification(plan: Person) kind empirical {
    label en unofficial "section 4980F(e)(5): the notice was provided before the adoption of the amendment and no material modification of the amendment occurs before adoption";
}
rule AccrualReductionNoticeGivenDirectly(admin: Person, i: Person, plan: Person) defeasible {
    label en official "section 4980F(e)(1)-(3): a notice delivered to the applicable individual, understandable and sufficient, within a reasonable time before the effective date";
    when notice_delivered_to(admin, i, plan, i);
    when notice_understandable_and_sufficient(plan);
    when notice_within_reasonable_time_before_effective_date(plan);
    then accrual_reduction_notice_given(admin, i, plan);
}
rule AccrualReductionNoticeGivenToDesignee(admin: Person, i: Person, plan: Person, designee: Person) defeasible {
    label en official "section 4980F(e)(4): a notice provided to a person the individual designated in writing";
    when notice_delivered_to(admin, i, plan, designee);
    when notice_designee_designated_in_writing(i, designee);
    when notice_understandable_and_sufficient(plan);
    when notice_within_reasonable_time_before_effective_date(plan);
    then accrual_reduction_notice_given(admin, i, plan);
}
rule AccrualReductionNoticeBeforeAdoption(admin: Person, i: Person, plan: Person) defeasible {
    label en official "section 4980F(e)(5): notice before adoption does not fail the requirement when no material modification occurs";
    when notice_delivered_to(admin, i, plan, i);
    when notice_understandable_and_sufficient(plan);
    when notice_provided_before_adoption_without_material_modification(plan);
    then accrual_reduction_notice_given(admin, i, plan);
}
pub relation plan_has_fewer_than_100_participants_with_accrued_benefit(plan: Person) kind empirical {
    label en unofficial "section 4980F(e)(2)(A): the plan has fewer than 100 participants who have accrued a benefit under it";
}
pub relation plan_offers_choice_between_new_and_old_formula(plan: Person) kind empirical {
    label en unofficial "section 4980F(e)(2)(B): the plan offers participants the option to choose between the new benefit formula and the old benefit formula";
}
pub relation secretary_provides_simplified_form_or_exemption(plan: Person) kind empirical {
    label en unofficial "section 4980F(e)(2): the Secretary provided a simplified form of notice for, or an exemption from any notice requirement of, the plan (a regulatory act)";
}
pub relation notice_requirement_relaxed_4980F_e2(plan: Person) kind institutional {
    label en official "section 4980F(e)(2): the Secretary may provide a simplified notice or exempt from any notice requirement a plan with fewer than 100 accrued-benefit participants or one offering a choice between formulas";
}
rule NoticeRequirementRelaxedSmallPlan(plan: Person) defeasible {
    label en official "section 4980F(e)(2)(A)";
    when plan_has_fewer_than_100_participants_with_accrued_benefit(plan);
    when secretary_provides_simplified_form_or_exemption(plan);
    then notice_requirement_relaxed_4980F_e2(plan);
}
rule NoticeRequirementRelaxedChoicePlan(plan: Person) defeasible {
    label en official "section 4980F(e)(2)(B)";
    when plan_offers_choice_between_new_and_old_formula(plan);
    when secretary_provides_simplified_form_or_exemption(plan);
    then notice_requirement_relaxed_4980F_e2(plan);
}
pub relation amendment_eliminates_or_reduces_early_retirement_subsidy(plan: Person) kind empirical {
    label en unofficial "section 4980F(f)(3): the amendment eliminates or reduces an early retirement benefit or retirement-type subsidy (within the meaning of section 411(d)(6)(B)(i))";
}
pub relation amendment_reduces_rate_of_future_accrual_4980F(plan: Person) kind institutional {
    label en official "section 4980F(f)(3): such an amendment is treated as having the effect of reducing the rate of future benefit accrual";
}
rule AmendmentEliminatingSubsidyReducesAccrual(plan: Person) defeasible {
    label en official "section 4980F(f)(3)";
    when amendment_eliminates_or_reduces_early_retirement_subsidy(plan);
    then amendment_reduces_rate_of_future_accrual_4980F(plan);
}

// --- 5000D(c), (f)(2) ---

enum ApplicableAgreementKind5000D {
    CoverageGapDiscountProgram1860D14A;
    ManufacturerDiscountProgram1860D14C;
    RebateAgreement1927b;
    OtherAgreement;
}
entity MedicareAgreement { label en unofficial "an agreement of a drug manufacturer with the Secretary of Health and Human Services (section 5000D(c)(2))"; }
pub relation medicare_agreement_kind(g: MedicareAgreement, k: ApplicableAgreementKind5000D) kind empirical {
    label en unofficial "which kind of agreement it is";
}
pub relation applicable_agreement_5000D(g: MedicareAgreement) kind institutional {
    label en official "section 5000D(c)(2): an agreement under the Medicare coverage gap discount program (1860D-14A), the manufacturer discount program (1860D-14C), or a rebate agreement under section 1927(b)";
}
rule ApplicableAgreementGap(g: MedicareAgreement) defeasible { label en official "section 5000D(c)(2)(A)(i)"; when medicare_agreement_kind(g, CoverageGapDiscountProgram1860D14A); then applicable_agreement_5000D(g); }
rule ApplicableAgreementDiscount(g: MedicareAgreement) defeasible { label en official "section 5000D(c)(2)(A)(ii)"; when medicare_agreement_kind(g, ManufacturerDiscountProgram1860D14C); then applicable_agreement_5000D(g); }
rule ApplicableAgreementRebate(g: MedicareAgreement) defeasible { label en official "section 5000D(c)(2)(B)"; when medicare_agreement_kind(g, RebateAgreement1927b); then applicable_agreement_5000D(g); }
pub relation suspension_begins_on(manu: Person, on: Date) kind empirical {
    label en unofficial "section 5000D(c)(1)(A): the first date on which notice of termination of all applicable agreements of the manufacturer has been received by the Secretary of Health and Human Services and none of the manufacturer's drugs is covered by an agreement under section 1860D-14A or 1860D-14C";
}
pub relation subsequent_applicable_agreement_first_day(manu: Person, on: Date) kind empirical {
    label en unofficial "section 5000D(c)(1)(B)(i): the first day after the (A) date on which the manufacturer enters into any subsequent applicable agreement";
}
pub relation any_drug_covered_by_agreement_first_date(manu: Person, on: Date) kind empirical {
    label en unofficial "section 5000D(c)(1)(B)(ii): the first date any drug of the manufacturer is covered by an agreement under section 1860D-14A or 1860D-14C";
}
pub relation last_day_of_february_following(on: Date, feb_end: Date) kind empirical {
    label en unofficial "the last day of the February following the date (a calendar fact of the case)";
}
pub relation suspension_trigger_candidate(manu: Person, on: Date) kind institutional {
    label en official "section 5000D(c)(1)(B): a candidate for the earlier of (i) and (ii)";
}
rule SuspensionTriggerFromAgreement(manu: Person, on: Date) defeasible { label en official "section 5000D(c)(1)(B)(i)"; when subsequent_applicable_agreement_first_day(manu, on); then suspension_trigger_candidate(manu, on); }
rule SuspensionTriggerFromCoverage(manu: Person, on: Date) defeasible { label en official "section 5000D(c)(1)(B)(ii)"; when any_drug_covered_by_agreement_first_date(manu, on); then suspension_trigger_candidate(manu, on); }
pub relation earlier_suspension_trigger_exists(manu: Person, on: Date) kind institutional {
    label en official "helper: a strictly earlier candidate exists";
}
rule EarlierSuspensionTriggerExists(manu: Person, on: Date, on2: Date) defeasible {
    label en official "helper";
    when suspension_trigger_candidate(manu, on);
    when suspension_trigger_candidate(manu, on2);
    when on2 < on;
    then earlier_suspension_trigger_exists(manu, on);
}
pub relation suspension_ends_on(manu: Person, on: Date) kind institutional {
    label en official "section 5000D(c)(1)(B): the last day of February following the earlier of (i) and (ii)";
}
rule SuspensionEndsOnFebruaryEnd(manu: Person, trigger: Date, feb: Date) defeasible {
    label en official "section 5000D(c)(1)(B)";
    when suspension_trigger_candidate(manu, trigger);
    when last_day_of_february_following(trigger, feb);
    unless earlier_suspension_trigger_exists(manu, trigger) and last_day_of_february_following(trigger, feb);
    then suspension_ends_on(manu, feb);
}
pub relation sale_manufacturer_and_day(s: DesignatedDrugSale, manu: Person, day: Date) kind empirical {
    label en unofficial "the manufacturer of the sold designated drug and the day of the sale";
}
pub relation sale_day_excluded_by_suspension_5000D(s: DesignatedDrugSale) kind institutional {
    label en official "section 5000D(c)(1): the day is not taken into account as a day of a period described in subsection (b) if it is also a day of the (A)-(B) suspension period";
}
rule SaleDayExcludedBySuspension(s: DesignatedDrugSale, manu: Person, day: Date, begins: Date, endd: Date) defeasible {
    label en official "section 5000D(c)(1)";
    when sale_manufacturer_and_day(s, manu, day);
    when suspension_begins_on(manu, begins);
    when suspension_ends_on(manu, endd);
    when day >= begins;
    when day <= endd;
    then sale_day_excluded_by_suspension_5000D(s);
}
pub relation sale_timed_to_avoid_5000D_tax(s: DesignatedDrugSale) kind empirical {
    label en unofficial "section 5000D(f)(2): the sale was timed for the purpose of avoiding the tax";
}
pub relation secretary_treats_sale_as_on_noncompliance_day_on(s: DesignatedDrugSale, on: Date) kind empirical {
    label en unofficial "section 5000D(f)(2): the date the Secretary treats the sale as occurring during a day described in subsection (b)";
}
pub relation sale_treated_as_on_noncompliance_day(s: DesignatedDrugSale) kind institutional {
    label en official "section 5000D(f)(2): the sale is treated as occurring during a day described in subsection (b)";
}
rule S5000DTimedSalePowerRule(s: DesignatedDrugSale, on: Date) defeasible {
    label en official "section 5000D(f)(2): in the case of a sale timed for the purpose of avoiding the tax the Secretary may treat it as occurring during a day described in subsection (b); an exercise for a sale that was not timed has no effect (E-0239)";
    when secretary_treats_sale_as_on_noncompliance_day_on(s, on);
    then power S5000DTreatTimedSale {
        holder us.irc.core::Secretary;
        over s;
        exercise secretary_treats_sale_as_on_noncompliance_day_on(s, on);
        valid_when sale_timed_to_avoid_5000D_tax(s);
        effect create(sale_treated_as_on_noncompliance_day(s));
        window [-infinity, infinity];
    };
}

// --- 4985(e)(3), (f) ---

pub relation compensation_granted_by_expatriated_group(comp: Person, corp: Person) kind empirical {
    label en unofficial "section 4985(e)(3)(A): the payment or right to payment is granted by the expatriated corporation or a member of its expanded affiliated group";
}
pub relation compensation_for_services_of_disqualified_individual(comp: Person, i: Person, corp: Person) kind empirical {
    label en unofficial "section 4985(e)(3)(A): the grant is in connection with the performance of services by a disqualified individual for the corporation or member";
}
pub relation value_based_on_stock_value(comp: Person) kind empirical {
    label en unofficial "section 4985(e)(3)(A): the value of the payment or right is based on (or determined by reference to) the value (or change in value) of stock in the corporation or member";
}
pub relation specified_stock_compensation_4985e3(comp: Person) kind institutional {
    label en official "section 4985(e)(3)(A): a grant by the expatriated group for services of a disqualified individual whose value is based on stock value";
}
rule SpecifiedStockCompensation4985e3(comp: Person, corp: Person, i: Person) defeasible {
    label en official "section 4985(e)(3)(A)";
    when compensation_granted_by_expatriated_group(comp, corp);
    when compensation_for_services_of_disqualified_individual(comp, i, corp);
    when value_based_on_stock_value(comp);
    then specified_stock_compensation_4985e3(comp);
}
pub relation option_to_which_part_ii_of_subchapter_d_applies(comp: Person) kind empirical {
    label en unofficial "section 4985(e)(3)(B)(i): an option to which part II of subchapter D of chapter 1 applies";
}
pub relation payment_from_plan_referred_to_in_280G_b6(comp: Person) kind empirical {
    label en unofficial "section 4985(e)(3)(B)(ii): a payment or right to payment from a plan referred to in section 280G(b)(6)";
}
pub relation specified_stock_compensation_excluded_4985e3B(comp: Person) kind institutional {
    label en official "section 4985(e)(3)(B): excluded from specified stock compensation";
}
rule ExcludedOptionPartII(comp: Person) defeasible { label en official "section 4985(e)(3)(B)(i)"; when option_to_which_part_ii_of_subchapter_d_applies(comp); then specified_stock_compensation_excluded_4985e3B(comp); }
rule ExcludedPlanPayment(comp: Person) defeasible { label en official "section 4985(e)(3)(B)(ii)"; when payment_from_plan_referred_to_in_280G_b6(comp); then specified_stock_compensation_excluded_4985e3B(comp); }
pub relation specified_stock_compensation_counted_4985(comp: Person) kind institutional {
    label en official "section 4985(e)(3): specified stock compensation net of the (B) exclusions";
}
rule SpecifiedStockCompensationCounted(comp: Person) defeasible {
    label en official "section 4985(e)(3)(A)-(B)";
    when specified_stock_compensation_4985e3(comp);
    unless specified_stock_compensation_excluded_4985e3B(comp) and specified_stock_compensation_4985e3(comp);
    then specified_stock_compensation_counted_4985(comp);
}
entity StockRestriction { label en unofficial "a restriction on stock or on a stock-based payment (section 4985(f)(1), (3))"; }
pub relation restriction_on_compensation(comp: Person, r: StockRestriction) kind empirical {
    label en unofficial "the restriction applies to the compensation";
}
pub relation restriction_by_its_terms_never_lapses(r: StockRestriction) kind empirical {
    label en unofficial "sections 4985(f)(1), (3): the restriction by its terms will never lapse";
}
pub relation restriction_cancelled_on(r: StockRestriction, on: Date) kind empirical {
    label en unofficial "section 4985(f)(1): the restriction was cancelled on this date";
}
pub relation cancellation_treated_as_grant_4985f1(comp: Person, r: StockRestriction) kind institutional {
    label en official "section 4985(f)(1): the cancellation of a restriction which by its terms will never lapse is treated as a grant";
}
rule CancellationOfNeverLapsingRestrictionIsGrant(comp: Person, r: StockRestriction, on: Date) defeasible {
    label en official "section 4985(f)(1)";
    when restriction_on_compensation(comp, r);
    when restriction_by_its_terms_never_lapses(r);
    when restriction_cancelled_on(r, on);
    then cancellation_treated_as_grant_4985f1(comp, r);
}
pub relation restriction_disregarded_in_valuation_4985f3(comp: Person, r: StockRestriction) kind institutional {
    label en official "section 4985(f)(3): whether there is specified stock compensation and its value are determined without regard to any restriction other than one which by its terms will never lapse";
}
rule RestrictionDisregardedInValuation(comp: Person, r: StockRestriction) defeasible {
    label en official "section 4985(f)(3)";
    when restriction_on_compensation(comp, r);
    unless restriction_by_its_terms_never_lapses(r) and restriction_on_compensation(comp, r);
    then restriction_disregarded_in_valuation_4985f3(comp, r);
}
pub relation transfer_of_property_to_holder(comp: Person) kind empirical {
    label en unofficial "section 4985(f)(4): the item is a transfer of property";
}
pub relation right_to_transfer_of_property(comp: Person) kind empirical {
    label en unofficial "section 4985(f)(4): the item is a right to a transfer of property";
}
pub relation treated_as_payment_or_right_to_payment_4985f4(comp: Person) kind institutional {
    label en official "section 4985(f)(4): any transfer of property is treated as a payment and any right to a transfer as a right to a payment";
}
rule TransferIsPayment(comp: Person) defeasible { label en official "section 4985(f)(4)"; when transfer_of_property_to_holder(comp); then treated_as_payment_or_right_to_payment_4985f4(comp); }
rule RightToTransferIsRightToPayment(comp: Person) defeasible { label en official "section 4985(f)(4)"; when right_to_transfer_of_property(comp); then treated_as_payment_or_right_to_payment_4985f4(comp); }
