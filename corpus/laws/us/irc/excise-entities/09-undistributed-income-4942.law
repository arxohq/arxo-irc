// Section 4942 — taxes on failure to distribute income. Fifth instantiation
// of the shared shape; reuses `taxable_period`/`corrected_within_taxable_period`
// under the same INTERPRETATION as sections 4945/4958 (this section's own
// "taxable period" cross-reference was not independently read this pass —
// assumed identical earliest-of-notice/assessment/correction shape).
//
// SCOPE:
//  - (a) 30% initial tax, (b) 100% additional tax: modelled, with the
//    intermediate values (c) undistributed income, (d) distributable
//    amount, (e)(1) minimum investment return (5% of net non-exempt-use
//    asset value) computed as real arithmetic, not opaque case facts.
//  - (a)(1) operating-foundation exception and (a)(2) incorrect-valuation
//    exception: NOT modelled (EXTERNAL_DEPENDENCY on section 4942(j)(3),
//    same placeholder already introduced by 04-net-investment-income-4940.law's
//    `exempt_operating_foundation`; the (a)(2) valuation exception is
//    TECH_GAP).
//  - (d)(1) the "(f)(2)(C) amounts" addition to the distributable amount:
//    NOT modelled (TECH_GAP — (f)(2)(C) itself is not read this pass).
//  - (e)(1)(A)/(B) fair market value of non-exempt-use assets and
//    acquisition indebtedness: modelled as case-asserted inputs (the
//    section 514(c)(1) acquisition-indebtedness computation itself is
//    EXTERNAL_DEPENDENCY, owned by whichever package models UBIT debt-
//    financed property).
//  - (e)(2) (the phase-in/short-year and cash-set-aside adjustments to
//    minimum investment return), (f) (operating foundation set-aside and
//    other distributable-amount adjustments beyond (f)(2)(C)), (g)(1)(A)'s
//    own (i)/(ii) controlled-organization/non-operating-foundation
//    exclusions, (g)(2)-(4) (set-asides, program-related investments,
//    additional qualifying-distribution categories), (h) (ordering rule for
//    which year's undistributed income a distribution corrects), (i)
//    (failure-to-distribute abatement cross-reference), (j) (definitions:
//    operating foundation, allowable distribution period, etc.): NOT
//    modelled — TECH_GAP / EXTERNAL_DEPENDENCY as noted.

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4942_A,
    IRC_S4942_B,
    IRC_S4942_C,
    IRC_S4942_D,
    IRC_S4942_E,
    IRC_S4942_G,
    Person,
    act_uses_note7_3F_special_stock_treatment,
    additional_tax,
    corrected_within_notice_or_assessment_period,
    distributable_amount_after_4942i,
    excise_act_kind,
    initial_tax,
    transition_4942_exclusion_applies,
    valuation_error_relief_applies,
};

@source(IRC_S4942_E, coverage = partial, quote = "the aggregate fair market value of all assets of the foundation other than those which are used (or held for use) directly in carrying out the foundation's exempt purpose")
pub relation undistributed_income_non_exempt_use_asset_value(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4942(e)(1)(A): the aggregate fair market value of the foundation's assets other than those used directly in its exempt purpose";
}
@source(IRC_S4942_E, coverage = partial, quote = "the acquisition indebtedness with respect to such assets (determined under section 514(c)(1) without regard to the taxable year in which the indebtedness was incurred)")
pub relation undistributed_income_acquisition_indebtedness(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4942(e)(1)(B): the section 514(c)(1) acquisition indebtedness with respect to the non-exempt-use assets (EXTERNAL_DEPENDENCY: the section 514(c)(1) computation itself is not modelled here)";
}
@source(IRC_S4942_E, coverage = partial, quote = "the minimum investment return for any private foundation for any taxable year is 5 percent of the excess of")
pub relation minimum_investment_return(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4942(e)(1): 5 percent of (non-exempt-use asset fair market value minus acquisition indebtedness)";
}
rule MinimumInvestmentReturn(a: ExciseAct, amount: Money, fmv: Money, debt: Money) defeasible {
    label en official "section 4942(e)(1): minimum investment return = 5 percent of (non-exempt-use asset FMV minus acquisition indebtedness)";
    when undistributed_income_non_exempt_use_asset_value(a, fmv);
    when undistributed_income_acquisition_indebtedness(a, debt);
    when fmv > debt;
    then minimum_investment_return(a, (fmv - debt) * MinimumInvestmentReturnRate);
}

pub relation subtitle_a_and_4940_tax_for_year(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4942(d)(2): the sum of the taxes imposed on the foundation for the taxable year under subtitle A and section 4940 (case-asserted; the section 4940 amount could be read from section_4940_excise_tax in 04-net-investment-income-4940.law, not yet wired — TECH_GAP)";
}
@source(IRC_S4942_D, coverage = partial, quote = "the term \"distributable amount\" means, with respect to any foundation for any taxable year, an amount equal to—")
pub relation distributable_amount(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4942(d): the minimum investment return (the (f)(2)(C) addition is NOT modelled, TECH_GAP), reduced by the subtitle A and section 4940 taxes for the year";
}
rule DistributableAmount(a: ExciseAct, amount: Money, mir: Money, taxes: Money) defeasible {
    label en official "section 4942(d)(1)-(2): distributable amount = minimum investment return minus the subtitle A/section 4940 taxes for the year (the (f)(2)(C) addition is not modelled)";
    when minimum_investment_return(a, mir);
    when subtitle_a_and_4940_tax_for_year(a, taxes);
    when mir > taxes;
    unless act_uses_note7_3F_special_stock_treatment(a) and minimum_investment_return(a, mir) and subtitle_a_and_4940_tax_for_year(a, taxes);  // Stage 4: note 7(3)(F), 38-*.law
    then distributable_amount(a, mir - taxes);
}

@source(IRC_S4942_G, coverage = partial, quote = "any amount (including that portion of reasonable and necessary administrative expenses) paid to accomplish one or more purposes described in section 170(c)(2)(B)")
pub relation qualifying_distributions_made(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4942(g)(1)(A)/(B): the aggregate qualifying distributions made before the relevant time, case-asserted as one aggregate — the (A)(i)/(ii) controlled-organization/non-operating-foundation exclusions are NOT independently tested (TECH_GAP; the case must already exclude a non-qualifying grant)";
}

@source(IRC_S4942_C, coverage = partial, quote = "the term \"undistributed income\" means, with respect to any private foundation for any taxable year as of any time, the amount by which—")
pub relation undistributed_income(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4942(c): undistributed income = distributable amount minus qualifying distributions made, when the distributable amount exceeds the distributions";
}
rule UndistributedIncome(a: ExciseAct, amount: Money, distributable: Money, distributed: Money) defeasible {
    label en official "section 4942(c)(1)-(2): undistributed income = distributable amount minus qualifying distributions made, when positive";
    when distributable_amount_after_4942i(a, distributable);  // Stage 3: section 4942(i) adjustment, 27-*.law
    when qualifying_distributions_made(a, distributed);
    when distributable > distributed;
    then undistributed_income(a, distributable - distributed);
}

pub relation undistributed_income_foundation(a: ExciseAct, f: Person) kind empirical {
    label en unofficial "the private foundation whose undistributed income is being tested";
}
pub relation undistributed_income_remaining_at_close_of_taxable_period(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4942(b): the portion of the undistributed income that remains undistributed at the close of the taxable period, case-asserted (may be less than the original undistributed_income if partial distributions were made after the initial tax was imposed)";
}

@source(IRC_S4942_A, coverage = partial, quote = "There is hereby imposed on the undistributed income of a private foundation for any taxable year, which has not been distributed before the first day of the second (or any succeeding) taxable year following such taxable year (if such first day falls within the taxable period), a tax equal to 30 percent of the amount of such income remaining undistributed at the beginning of such second (or succeeding) taxable year.")
rule InitialTaxOnUndistributedIncome(a: ExciseAct, f: Person, amount: Money, base: Money) defeasible {
    label en official "section 4942(a): 30 percent of the undistributed income remaining undistributed at the beginning of the second (or succeeding) taxable year, paid by the private foundation (the (a)(1) operating-foundation and (a)(2) incorrect-valuation exceptions are NOT modelled)";
    when excise_act_kind(a, UndistributedIncomeYear);
    when undistributed_income_foundation(a, f);
    when undistributed_income(a, base);
    // Stage 3: the section 4942(a)(2) valuation-error relief has its own reduced-base rule (27-*.law).
    unless valuation_error_relief_applies(a) and undistributed_income_foundation(a, f) and undistributed_income(a, base);
    // Stage 3: the note 7(3) transitional exclusion has its own base (37-*.law).
    unless transition_4942_exclusion_applies(a) and undistributed_income_foundation(a, f) and undistributed_income(a, base);
    then initial_tax(a, f, base * UndistributedIncomeInitialTaxRate);
}
@source(IRC_S4942_B, coverage = partial, quote = "In any case in which an initial tax is imposed under subsection (a) on the undistributed income of a private foundation for any taxable year, if any portion of such income remains undistributed at the close of the taxable period, there is hereby imposed a tax equal to 100 percent of the amount remaining undistributed at such time.")
rule AdditionalTaxOnUndistributedIncome(a: ExciseAct, f: Person, amount: Money, base: Money) defeasible {
    label en official "section 4942(b): 100 percent of the undistributed income remaining undistributed at the close of the taxable period, paid by the private foundation";
    when excise_act_kind(a, UndistributedIncomeYear);
    when undistributed_income_foundation(a, f);
    when undistributed_income(a, _);
    when undistributed_income_remaining_at_close_of_taxable_period(a, base);
    unless corrected_within_notice_or_assessment_period(a) and undistributed_income_foundation(a, f) and undistributed_income_remaining_at_close_of_taxable_period(a, base);
    then additional_tax(a, f, base * UndistributedIncomeAdditionalTaxRate);
}
