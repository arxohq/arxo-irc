// Section 4946 — definitions ("disqualified person", "foundation manager",
// "government official", "family"). PARTIAL this stage: only the
// categories section 4941's self-dealing scenarios need are modelled —
// (a)(1)(A) substantial contributor, (a)(1)(B) foundation manager,
// (a)(1)(C)(i) >20% corporate owner of a substantial contributor,
// (a)(1)(D) member of the family, and (d) the family definition itself.
//
// NOT MODELLED this stage (report as `not-done`, stage 2):
//  - (a)(1)(C)(ii)-(iii) (>20% owner of a partnership's profits interest or
//    a trust/unincorporated enterprise's beneficial interest which is a
//    substantial contributor): no `us.irc.corporations`-style constructive-
//    ownership relation exists for partnership profits interests or trust
//    beneficial interests (only `total_constructive_ownership_share` over a
//    `Corporation` does) — TECH_GAP (no owner package yet models
//    partnership/trust constructive ownership).
//  - (a)(1)(E)-(G) (>35% owned corporation/partnership/trust-or-estate of
//    persons described in (A)-(D)): same gap, plus a second-order
//    aggregation this stage has no time budget for — TECH_GAP.
//  - (a)(1)(H) (private foundation disqualified only for section 4943
//    purposes) and (a)(1)(I) (government official, only for section 4941):
//    NOT modelled — section 4943 is not modelled this stage, and (c)'s
//    government-official test (7 sub-categories of federal/state office)
//    is out of this stage's budget. A self-dealing act by a government
//    official therefore reads as an ordinary disqualified-person act under
//    this package for now (the 4941(d)(1)(F)/(d)(2)(G) government-official-
//    specific rules are themselves not modelled either — see
//    03-self-dealing-4941.law).
//  - (a)(3)-(4) (the exact §267(c)/constructive-ownership-of-stock
//    attribution rules for (1)(C)(i) and (1)(E)): this module uses
//    `us.irc.corporations::total_constructive_ownership_share` as given,
//    WITHOUT reproducing 4946(a)(3)'s own carve-out from the general
//    §267(c) family-attribution rule (4946(a)(3) restricts attribution
//    from one member of a family to another to a SINGLE step, where
//    §267(c)(2)/(4)'s general family attribution has no such limit) —
//    documented INTERPRETATION, not a silent gap.
//  - (b) full "foundation manager" test is modelled only for the (b)(1)
//    officer/director/trustee branch; the (b)(2) act-specific
//    "employee...having authority or responsibility with respect to such
//    act" branch needs the specific `ExciseAct` and is modelled directly on
//    `03-self-dealing-4941.law`'s manager-tax rules instead of here.
//  - (c) "government official" (7 sub-categories): NOT modelled.

use self::{
    Corporation,
    IRC_S4946_A,
    IRC_S4946_B,
    IRC_S4946_D,
    Person,
};

@source(IRC_S4946_A, coverage = partial, quote = "(A) a substantial contributor to the foundation,")
pub relation substantial_contributor(p: Person, f: Person) kind empirical {
    label en unofficial "p is a substantial contributor to private foundation f (section 507(d)(2) full test is EXTERNAL_DEPENDENCY — not yet modelled by any owner package; case asserts the section 507(d)(2) conclusion directly)";
}

@source(IRC_S4946_B, coverage = partial, quote = "an officer, director, or trustee of a foundation (or an individual having powers or responsibilities similar to those of officers, directors, or trustees of the foundation)")
pub relation officer_director_or_trustee(p: Person, f: Person) kind empirical {
    label en official "section 4946(b)(1): p is an officer, director, or trustee of foundation f (or has similar powers or responsibilities)";
}

pub relation foundation_manager(p: Person, f: Person) kind institutional {
    label en official "section 4946(b): p is a foundation manager of f — modelled here only via the (b)(1) officer/director/trustee branch; the (b)(2) act-specific employee branch is modelled per-act in 03-self-dealing-4941.law";
}
@source(IRC_S4946_B, coverage = partial, quote = "an officer, director, or trustee of a foundation")
rule FoundationManagerViaOfficerDirectorTrustee(p: Person, f: Person) defeasible {
    label en official "section 4946(b)(1): an officer, director, or trustee of the foundation is a foundation manager";
    when officer_director_or_trustee(p, f);
    then foundation_manager(p, f);
}

@source(IRC_S4946_D, coverage = partial, quote = "the family of any individual shall include only his spouse, ancestors, children, grandchildren, great grandchildren, and the spouses of children, grandchildren, and great grandchildren")
pub relation family_spouse_of(p: Person, of: Person) kind empirical {
    label en unofficial "section 4946(d): p is the spouse of `of`";
}
@source(IRC_S4946_D, coverage = partial, quote = "the family of any individual shall include only his spouse, ancestors, children, grandchildren, great grandchildren, and the spouses of children, grandchildren, and great grandchildren")
pub relation ancestor_of(p: Person, of: Person) kind empirical {
    label en unofficial "section 4946(d): p is an ancestor of `of`";
}
@source(IRC_S4946_D, coverage = partial, quote = "the family of any individual shall include only his spouse, ancestors, children, grandchildren, great grandchildren, and the spouses of children, grandchildren, and great grandchildren")
pub relation descendant_of(p: Person, of: Person) kind empirical {
    label en unofficial "section 4946(d): p is a child, grandchild, or great grandchild of `of` (the statute's three lineal-descendant generations collapsed into one case-asserted relation — a fourth-generation descendant is NOT within the family by the statute's own text, and this relation must not be asserted for one)";
}
@source(IRC_S4946_D, coverage = partial, quote = "and the spouses of children, grandchildren, and great grandchildren")
pub relation spouse_of_descendant_of(p: Person, of: Person) kind empirical {
    label en unofficial "section 4946(d): p is the spouse of a child, grandchild, or great grandchild of `of`";
}

@source(IRC_S4946_D, coverage = partial, quote = "the family of any individual shall include only his spouse, ancestors, children, grandchildren, great grandchildren, and the spouses of children, grandchildren, and great grandchildren")
pub relation member_of_family(p: Person, of: Person) kind institutional {
    label en official "section 4946(d): p is a member of the family of `of` (spouse, ancestor, or lineal descendant within three generations, or a spouse of such a descendant)";
}
rule MemberOfFamilyViaSpouse(p: Person, of: Person) defeasible {
    label en official "section 4946(d): the spouse is a member of the family";
    when family_spouse_of(p, of);
    then member_of_family(p, of);
}
rule MemberOfFamilyViaAncestor(p: Person, of: Person) defeasible {
    label en official "section 4946(d): an ancestor is a member of the family";
    when ancestor_of(p, of);
    then member_of_family(p, of);
}
rule MemberOfFamilyViaDescendant(p: Person, of: Person) defeasible {
    label en official "section 4946(d): a child, grandchild, or great grandchild is a member of the family";
    when descendant_of(p, of);
    then member_of_family(p, of);
}
rule MemberOfFamilyViaSpouseOfDescendant(p: Person, of: Person) defeasible {
    label en official "section 4946(d): the spouse of a child, grandchild, or great grandchild is a member of the family";
    when spouse_of_descendant_of(p, of);
    then member_of_family(p, of);
}

@source(IRC_S4946_A, coverage = partial, quote = "(C) an owner of more than 20 percent of—")
pub relation twenty_percent_corporate_owner_of_substantial_contributor(p: Person, f: Person) kind institutional {
    label en official "section 4946(a)(1)(C)(i): p owns more than 20 percent of the total combined voting power of a corporation which is a substantial contributor to f (INTERPRETATION: uses us.irc.corporations::total_constructive_ownership_share as-is, without reproducing 4946(a)(3)'s own single-step limit on the general section 267(c) family-attribution rule)";
}
rule TwentyPercentCorporateOwnerOfSubstantialContributor(p: Person, f: Person, corp: Corporation, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(C)(i): more than 20 percent constructive ownership of the voting power of a corporation that is itself a substantial contributor to f";
    when us.irc.corporations::total_constructive_ownership_share(p, corp, share);
    when share > 0.20;
    when substantial_contributor(corp, f);
    then twenty_percent_corporate_owner_of_substantial_contributor(p, f);
}

@source(IRC_S4946_A, coverage = partial, quote = "the term \"disqualified person\" means, with respect to a private foundation, a person who is—")
pub relation disqualified_person(p: Person, f: Person) kind institutional {
    label en official "section 4946(a)(1): p is a disqualified person with respect to private foundation f. PARTIAL: only (A) substantial contributor, (B) foundation manager (b)(1) branch, (C)(i) >20% corporate owner of a substantial contributor, and (D) member of the family of an (A)/(B)/(C) person are modelled — see the module header for (C)(ii)-(iii), (E)-(I), the (a)(3)-(4) attribution carve-outs, and the (b)(2) act-specific manager branch, which are NOT modelled this stage.";
}
rule DisqualifiedPersonViaSubstantialContributor(p: Person, f: Person) defeasible {
    label en official "section 4946(a)(1)(A): a substantial contributor is a disqualified person";
    when substantial_contributor(p, f);
    then disqualified_person(p, f);
}
rule DisqualifiedPersonViaFoundationManager(p: Person, f: Person) defeasible {
    label en official "section 4946(a)(1)(B): a foundation manager is a disqualified person";
    when foundation_manager(p, f);
    then disqualified_person(p, f);
}
rule DisqualifiedPersonViaTwentyPercentCorporateOwner(p: Person, f: Person) defeasible {
    label en official "section 4946(a)(1)(C)(i): a >20% corporate owner of a substantial contributor is a disqualified person";
    when twenty_percent_corporate_owner_of_substantial_contributor(p, f);
    then disqualified_person(p, f);
}
// (D) is intentionally NOT written as "member of the family of any
// disqualified person" (which would make `disqualified_person` recursive
// through itself — LDC-E4102, not stratifiable): the statute's own text
// limits (D) to the family of an (A)/(B)/(C) person specifically, so each
// of the three base categories gets its own non-recursive family rule.
@source(IRC_S4946_A, coverage = partial, quote = "(D) a member of the family (as defined in subsection (d)) of any individual described in subparagraph (A), (B), or (C),")
rule DisqualifiedPersonViaFamilyOfSubstantialContributor(p: Person, f: Person, dp: Person) defeasible {
    label en official "section 4946(a)(1)(D): a member of the family of a substantial contributor (A) is a disqualified person";
    when member_of_family(p, dp);
    when substantial_contributor(dp, f);
    then disqualified_person(p, f);
}
rule DisqualifiedPersonViaFamilyOfFoundationManager(p: Person, f: Person, dp: Person) defeasible {
    label en official "section 4946(a)(1)(D): a member of the family of a foundation manager (B) is a disqualified person";
    when member_of_family(p, dp);
    when foundation_manager(dp, f);
    then disqualified_person(p, f);
}
rule DisqualifiedPersonViaFamilyOfTwentyPercentOwner(p: Person, f: Person, dp: Person) defeasible {
    label en official "section 4946(a)(1)(D): a member of the family of a >20% corporate owner (C) is a disqualified person";
    when member_of_family(p, dp);
    when twenty_percent_corporate_owner_of_substantial_contributor(dp, f);
    then disqualified_person(p, f);
}
