// Section 4980B — failure to satisfy continuation coverage requirements of group
// health plans (COBRA). Stage 2 (DECISION-0379). This section is the densest
// source of deontic norms in the package:
//  - (f)(1): each qualified beneficiary who would lose coverage because of a
//    qualifying event is ENTITLED to elect continuation coverage within the
//    election period — a POWER of the beneficiary (holder: the beneficiary;
//    over: the plan; valid only within the election period of (f)(5)(A));
//  - (f)(2): the plan's continuation-coverage obligations — a DUTY to provide
//    identical coverage for at least the (f)(2)(B) period, a PROHIBITION on premiums
//    above 102 percent (150 percent for the disability extension) or demanded
//    before 45 days after the election, a DUTY to offer a conversion option in the
//    last 180 days;
//  - (f)(6): the notice DUTIES of the employer (30 days), the beneficiary (60
//    days), the plan administrator (14 days) and the plan (at commencement);
//  - (a)-(e): the excise tax on the failure: $100 a day of noncompliance per
//    qualified beneficiary, the exceptions and limitations, the persons liable.
//
// The unit of the tax is an ExciseAct of kind CobraFailure: one failure with respect to
// one qualified beneficiary; the noncompliance-period machinery is the shared one of
// 17-plan-reversions-and-health-failures-4980-4980G.law with one added candidate end: 6
// months after the last day of the (f)(2)(B) period (without regard to clause (iii)).
//
// STALE (26.09.2026): the $200-a-day family limit (G2516) is now modelled in
// 38-remaining-component-clauses-stage4.law:195-206 (`CobraFamilyDailyTax`/
// `CobraFamilyTotalTax`); the PBGC/TAA special periods (G2518) are now modelled in
// 30-continuation-coverage-details-4980B.law:156+ (`taa_eligible_individual` and
// following rules). Still NOT MODELLED: the actuarial computation of the applicable
// premium of self-insured plans (G2519); the qualifying-event loss-of-coverage
// counterfactual ("but for the continuation coverage required") is a case fact.

// ============================================================================
// Qualifying events, qualified beneficiaries, coverage periods
// ============================================================================

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4980B_A,
    IRC_S4980B_B,
    IRC_S4980B_C,
    IRC_S4980B_F,
    IRC_S4980B_G,
    Person,
    TaxableYear,
    applicable_premium_4980B,
    church_plan_414e,
    continuation_coverage_elected_or_deemed,
    excise_act_kind,
    failure_due_to_reasonable_cause,
    failure_employer,
    failure_excused_by_limitations,
    failure_reasonable_cause_established_for_waiver,
    failure_taxable_year_of_employer,
    noncompliance_days,
    noncompliance_end_candidate,
    pbgc_special_period_rule_applies,
    taa_special_period_rule_applies,
    uncorrected_at_notice_of_examination,
    violations_more_than_de_minimis,
};

enum QualifyingEventKind4980B {
    DeathOfCoveredEmployee;
    TerminationOrReducedHours;
    DivorceOrLegalSeparation;
    MedicareEntitlement;
    DependentCeasesToBeDependentChild;
    EmployerBankruptcyProceeding;
}
entity CobraQualifyingEvent { label en unofficial "a qualifying event with respect to a covered employee (section 4980B(f)(3))"; }
pub relation cobra_event_kind(ev: CobraQualifyingEvent, k: QualifyingEventKind4980B) kind empirical {
    label en official "section 4980B(f)(3)(A)-(F): which qualifying event";
}
pub relation cobra_event_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B): the date of the qualifying event";
}
pub relation cobra_event_plan(ev: CobraQualifyingEvent, plan: Person) kind empirical {
    label en official "the group health plan under which coverage would be lost";
}
pub relation cobra_event_covered_employee(ev: CobraQualifyingEvent, e: Person) kind empirical {
    label en official "section 4980B(f)(7): the covered employee (an individual who is or was provided coverage under the plan by virtue of services for a person maintaining the plan)";
}
pub relation event_causes_loss_of_coverage(ev: CobraQualifyingEvent, qb: Person) kind empirical {
    label en official "section 4980B(f)(3): but for continuation coverage the event would result in the loss of coverage of the beneficiary";
}
pub relation misconduct_termination(ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(3)(B): the termination is by reason of the employee's gross misconduct";
}
pub relation was_beneficiary_day_before_event_as(qb: Person, ev: CobraQualifyingEvent, rl: BeneficiaryRole) kind empirical {
    label en official "section 4980B(g)(1)(A), (D): on the day before the qualifying event the individual was a beneficiary as spouse, dependent child, or (bankruptcy) surviving spouse";
}
enum BeneficiaryRole { SpouseOfCoveredEmployee; DependentChild; SurvivingSpouse; CoveredEmployeeHimself; ChildBornOrAdoptedDuringCoverage; }
pub relation nonresident_alien_without_us_income(e: Person) kind empirical {
    label en official "section 4980B(g)(1)(C): the covered employee status is attributable to a period in which the individual was a nonresident alien with no U.S.-source earned income from the employer";
}
@source(IRC_S4980B_G, coverage = exact, quote = "The term \"qualified beneficiary\" means, with respect to a covered employee under a group health plan, any other individual who, on the day before the qualifying event for that employee, is a beneficiary under the plan—")
pub relation qualified_beneficiary(qb: Person, ev: CobraQualifyingEvent) kind institutional {
    label en official "section 4980B(g)(1): a spouse or dependent child who was a beneficiary the day before the event (and a child born or adopted during coverage); the covered employee himself for termination or reduced hours; retirees and surviving spouses for a bankruptcy event; not a nonresident-alien-attributable individual";
}
rule QualifiedBeneficiarySpouseOrChild(qb: Person, ev: CobraQualifyingEvent, e: Person, r: BeneficiaryRole) defeasible {
    label en official "section 4980B(g)(1)(A): a spouse or dependent child who was a beneficiary on the day before the event";
    when cobra_event_covered_employee(ev, e);
    when event_causes_loss_of_coverage(ev, qb);
    when was_beneficiary_day_before_event_as(qb, ev, r);
    unless nonresident_alien_without_us_income(e) and cobra_event_covered_employee(ev, e) and event_causes_loss_of_coverage(ev, qb) and was_beneficiary_day_before_event_as(qb, ev, r);
    unless misconduct_termination(ev) and cobra_event_covered_employee(ev, e) and event_causes_loss_of_coverage(ev, qb) and was_beneficiary_day_before_event_as(qb, ev, r);
    then qualified_beneficiary(qb, ev);
}
rule QualifiedBeneficiaryEmployeeForTermination(qb: Person, ev: CobraQualifyingEvent) defeasible {
    label en official "section 4980B(g)(1)(B): for termination or reduced hours the covered employee is a qualified beneficiary";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when cobra_event_covered_employee(ev, qb);
    when event_causes_loss_of_coverage(ev, qb);
    unless nonresident_alien_without_us_income(qb) and cobra_event_kind(ev, TerminationOrReducedHours) and cobra_event_covered_employee(ev, qb) and event_causes_loss_of_coverage(ev, qb);
    unless misconduct_termination(ev) and cobra_event_covered_employee(ev, qb) and event_causes_loss_of_coverage(ev, qb);
    then qualified_beneficiary(qb, ev);
}
pub relation second_qualifying_event_within_18_months_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(i)(II): a qualifying event (other than bankruptcy) occurred during the 18 months after a (f)(3)(B) event, on this date";
}
pub relation disability_determined_in_first_60_days_and_notified(qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(2)(B)(i)(VIII): the beneficiary was determined disabled (title II or XVI) during the first 60 days of continuation coverage and gave notice before the end of the 18 months";
}
pub relation covered_employee_medicare_entitled_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(i)(VII): the date the covered employee became entitled to Medicare benefits";
}
pub relation covered_employee_or_beneficiary_death_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(i)(III): the date of the death of the covered employee or qualified beneficiary (bankruptcy event)";
}
relation cobra_period_end_candidate(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en unofficial "a candidate end of the required continuation coverage period (section 4980B(f)(2)(B)): the earliest applies";
}
rule PeriodCandidate18MonthsTermination(ev: CobraQualifyingEvent, qb: Person, evd: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(I): 18 months after a termination or reduced-hours event";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    unless second_qualifying_event_within_18_months_on(ev, _) and qualified_beneficiary(qb, ev) and cobra_event_on(ev, evd);
    unless disability_determined_in_first_60_days_and_notified(qb, ev) and cobra_event_kind(ev, TerminationOrReducedHours) and cobra_event_on(ev, evd);
    unless pbgc_special_period_rule_applies(ev) and qualified_beneficiary(qb, ev) and cobra_event_on(ev, evd);  // Stage 3: (f)(2)(B)(i)(V)
    unless taa_special_period_rule_applies(ev) and qualified_beneficiary(qb, ev) and cobra_event_on(ev, evd);  // Stage 3: (f)(2)(B)(i)(VI)
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 18 calendar_month));
}
rule PeriodCandidate36MonthsMultipleEvents(ev: CobraQualifyingEvent, qb: Person, evd: Date, on2: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(II): 36 months after a termination or reduced-hours event when another (non-bankruptcy) event occurs within the 18 months";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when second_qualifying_event_within_18_months_on(ev, on2);
    when on2 <= add_calendar_period(evd, 18 calendar_month);
    unless pbgc_special_period_rule_applies(ev) and qualified_beneficiary(qb, ev) and cobra_event_on(ev, evd) and second_qualifying_event_within_18_months_on(ev, on2);  // Stage 3: (f)(2)(B)(i)(V)
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 36 calendar_month));
}
rule PeriodCandidate36MonthsOtherEvents(ev: CobraQualifyingEvent, qb: Person, evd: Date, k: QualifyingEventKind4980B) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(IV): 36 months after any other qualifying event (not termination/reduced hours or bankruptcy)";
    when cobra_event_kind(ev, k);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    unless event_kind_is_termination_or_bankruptcy(ev) and cobra_event_kind(ev, k) and qualified_beneficiary(qb, ev) and cobra_event_on(ev, evd);
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 36 calendar_month));
}
relation event_kind_is_termination_or_bankruptcy(ev: CobraQualifyingEvent) kind institutional {
    label en unofficial "the event is (f)(3)(B) or (f)(3)(F)";
}
rule EventKindIsTermination(ev: CobraQualifyingEvent) defeasible { label en unofficial "(f)(3)(B)"; when cobra_event_kind(ev, TerminationOrReducedHours); then event_kind_is_termination_or_bankruptcy(ev); }
rule EventKindIsBankruptcy(ev: CobraQualifyingEvent) defeasible { label en unofficial "(f)(3)(F)"; when cobra_event_kind(ev, EmployerBankruptcyProceeding); then event_kind_is_termination_or_bankruptcy(ev); }
rule PeriodCandidate29MonthsDisability(ev: CobraQualifyingEvent, qb: Person, evd: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VIII): 29 months (for all qualified beneficiaries) when a disability determination was made in the first 60 days and notified before the 18 months end";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when disability_determined_in_first_60_days_and_notified(qb, ev);
    then cobra_period_end_candidate(ev, qb, add_calendar_period(evd, 29 calendar_month));
}
rule PeriodCandidateMedicareThenEvent(ev: CobraQualifyingEvent, qb: Person, evd: Date, med: Date, e0: Person) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(VII): for beneficiaries other than the covered employee, a termination/reduced-hours event less than 18 months after Medicare entitlement keeps coverage to 36 months after entitlement";
    when cobra_event_kind(ev, TerminationOrReducedHours);
    when qualified_beneficiary(qb, ev);
    when cobra_event_on(ev, evd);
    when covered_employee_medicare_entitled_on(ev, med);
    when evd < add_calendar_period(med, 18 calendar_month);
    when evd >= med;
    when cobra_event_covered_employee(ev, e0);
    when qb != e0;
    then cobra_period_end_candidate(ev, qb, add_calendar_period(med, 36 calendar_month));
}
rule PeriodCandidateBankruptcy(ev: CobraQualifyingEvent, qb: Person, death: Date) defeasible {
    label en official "section 4980B(f)(2)(B)(i)(III): for a bankruptcy event, the date of death of the covered employee or beneficiary (for surviving spouse and dependent children, 36 months after the employee's death)";
    when cobra_event_kind(ev, EmployerBankruptcyProceeding);
    when qualified_beneficiary(qb, ev);
    when covered_employee_or_beneficiary_death_on(ev, death);
    then cobra_period_end_candidate(ev, qb, death);
}
pub relation employer_ceases_any_group_health_plan_on(ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(ii): the date on which the employer ceases to provide any group health plan to any employee";
}
pub relation coverage_ceased_for_nonpayment_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(iii): the date coverage ceases by reason of failure to make timely payment of a premium (payment is timely within 30 days after the due date)";
}
pub relation covered_by_other_plan_or_medicare_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(iv): the date the beneficiary first becomes, after the election, covered under another group health plan without a preexisting condition exclusion, or entitled to Medicare (other than (g)(1)(D) beneficiaries)";
}
pub relation disability_extension_terminated_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(B)(v): the month that begins more than 30 days after the final determination that the beneficiary is no longer disabled";
}
rule PeriodCandidateEndOfPlan(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible { label en official "section 4980B(f)(2)(B)(ii): end of plan"; when qualified_beneficiary(qb, ev); when employer_ceases_any_group_health_plan_on(ev, on); then cobra_period_end_candidate(ev, qb, on); }
rule PeriodCandidateNonpayment(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible { label en official "section 4980B(f)(2)(B)(iii): failure to pay premium"; when qualified_beneficiary(qb, ev); when coverage_ceased_for_nonpayment_on(ev, qb, on); then cobra_period_end_candidate(ev, qb, on); }
rule PeriodCandidateOtherCoverage(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible { label en official "section 4980B(f)(2)(B)(iv): other group health plan coverage or Medicare"; when qualified_beneficiary(qb, ev); when covered_by_other_plan_or_medicare_on(ev, qb, on); then cobra_period_end_candidate(ev, qb, on); }
rule PeriodCandidateDisabilityEnds(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible { label en official "section 4980B(f)(2)(B)(v): termination of extended coverage for disability"; when qualified_beneficiary(qb, ev); when disability_extension_terminated_on(ev, qb, on); then cobra_period_end_candidate(ev, qb, on); }
relation earlier_cobra_period_end_candidate_exists(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en unofficial "a strictly earlier candidate exists";
}
rule EarlierCobraPeriodEndCandidateExists(ev: CobraQualifyingEvent, qb: Person, on: Date, on2: Date) defeasible {
    label en unofficial "a strictly earlier candidate disqualifies this one";
    when cobra_period_end_candidate(ev, qb, on);
    when cobra_period_end_candidate(ev, qb, on2);
    when on2 < on;
    then earlier_cobra_period_end_candidate_exists(ev, qb, on);
}
@source(IRC_S4980B_F, coverage = exact, quote = "The coverage must extend for at least the period beginning on the date of the qualifying event and ending not earlier than the earliest of the following:")
pub relation continuation_coverage_required_until(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en official "section 4980B(f)(2)(B): the plan must provide coverage at least until the earliest of the listed dates";
}
rule ContinuationCoverageRequiredUntil(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible {
    label en official "the earliest candidate end";
    when cobra_period_end_candidate(ev, qb, on);
    unless earlier_cobra_period_end_candidate_exists(ev, qb, on);
    then continuation_coverage_required_until(ev, qb, on);
}

// ============================================================================
// Election: a power of the qualified beneficiary
// ============================================================================

pub relation coverage_terminates_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(5)(A)(i): the date coverage terminates under the plan by reason of the qualifying event";
}
pub relation election_notice_received_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(5)(A)(iii)(II): the date of the notice the beneficiary receives under paragraph (6)(D)";
}
relation election_period_end_candidate(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en unofficial "a candidate end of the election period: 60 days after the coverage termination date or after the notice date";
}
rule ElectionPeriodEndFromTermination(ev: CobraQualifyingEvent, qb: Person, t: Date) defeasible {
    label en official "section 4980B(f)(5)(A)(iii)(I): not earlier than 60 days after the date coverage terminates";
    when coverage_terminates_on(ev, qb, t);
    then election_period_end_candidate(ev, qb, add_calendar_period(t, 60 calendar_day));
}
rule ElectionPeriodEndFromNotice(ev: CobraQualifyingEvent, qb: Person, n: Date) defeasible {
    label en official "section 4980B(f)(5)(A)(iii)(II): not earlier than 60 days after the notice under (6)(D)";
    when election_notice_received_on(ev, qb, n);
    then election_period_end_candidate(ev, qb, add_calendar_period(n, 60 calendar_day));
}
relation later_election_period_end_candidate_exists(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en unofficial "a strictly later candidate exists";
}
rule LaterElectionPeriodEndCandidateExists(ev: CobraQualifyingEvent, qb: Person, on: Date, on2: Date) defeasible {
    label en unofficial "a strictly later candidate disqualifies this one";
    when election_period_end_candidate(ev, qb, on);
    when election_period_end_candidate(ev, qb, on2);
    when on2 > on;
    then later_election_period_end_candidate_exists(ev, qb, on);
}
pub relation election_period_ends(ev: CobraQualifyingEvent, qb: Person, on: Date) kind institutional {
    label en official "section 4980B(f)(5)(A): the election period ends not earlier than 60 days after the later of the coverage termination date and the notice date (a period of at least 60 days that begins no later than the coverage termination)";
}
rule ElectionPeriodEnds(ev: CobraQualifyingEvent, qb: Person, on: Date) defeasible {
    label en official "the later candidate end";
    when election_period_end_candidate(ev, qb, on);
    unless later_election_period_end_candidate_exists(ev, qb, on);
    then election_period_ends(ev, qb, on);
}
pub relation continuation_coverage_election_made_on(ev: CobraQualifyingEvent, qb: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(1): the qualified beneficiary elects continuation coverage on this date";
}
pub relation continuation_coverage_elected(ev: CobraQualifyingEvent, qb: Person) kind institutional {
    label en official "section 4980B(f)(1), (5): the qualified beneficiary validly elected continuation coverage within the election period";
}
pub relation election_within_election_period(ev: CobraQualifyingEvent, qb: Person) kind institutional {
    label en official "section 4980B(f)(5)(A): the election was made no later than the end of the election period";
}
rule ElectionWithinElectionPeriod(ev: CobraQualifyingEvent, qb: Person, on: Date, endd: Date) defeasible {
    label en official "the election date is on or before the end of the election period";
    when continuation_coverage_election_made_on(ev, qb, on);
    when election_period_ends(ev, qb, endd);
    when on <= endd;
    then election_within_election_period(ev, qb);
}
@source(IRC_S4980B_F, coverage = exact, quote = "each qualified beneficiary who would lose coverage under the plan as a result of a qualifying event is entitled to elect, within the election period, continuation coverage under the plan.")
rule S4980BElectionPowerRule(ev: CobraQualifyingEvent, qb: Person, plan: Person, t: Date, endd: Date, on: Date) defeasible {
    label en official "section 4980B(f)(1): the qualified beneficiary may elect continuation coverage under the plan within the election period; an election made after it yields no coverage (POWER_INVALID_EXERCISE, E-0239)";
    when qualified_beneficiary(qb, ev);
    when cobra_event_plan(ev, plan);
    when coverage_terminates_on(ev, qb, t);
    when election_period_ends(ev, qb, endd);
    when continuation_coverage_election_made_on(ev, qb, on);
    then power S4980BElectContinuationCoverage {
        holder qb;
        over plan;
        exercise continuation_coverage_election_made_on(ev, qb, on);
        valid_when election_within_election_period(ev, qb);
        effect create(continuation_coverage_elected(ev, qb));
        window [t, endd];
    };
}

// ============================================================================
// The plan's obligations: coverage, premium, conversion
// ============================================================================

pub relation continuation_coverage_provided_to(plan: Person, qb: Person, ev: CobraQualifyingEvent) kind institutional {
    label en official "section 4980B(f)(2): the plan provides continuation coverage identical to that of similarly situated beneficiaries with no qualifying event (with modifications applied in the same manner), without evidence of insurability";
}
@source(IRC_S4980B_F, coverage = exact, quote = "The coverage must consist of coverage which, as of the time the coverage is being provided, is identical to the coverage provided under the plan to similarly situated beneficiaries under the plan with respect to whom a qualifying event has not occurred.")
rule S4980BProvideContinuationCoverageDutyRule(ev: CobraQualifyingEvent, qb: Person, plan: Person, evd: Date, until: Date) defeasible {
    label en official "section 4980B(f)(1)-(2): a group health plan shall provide continuation coverage to an electing qualified beneficiary from the date of the qualifying event until at least the earliest of the (f)(2)(B) dates";
    when continuation_coverage_elected_or_deemed(ev, qb);  // Stage 3: includes the (f)(5)(B) deemed election (30-*.law)
    when cobra_event_plan(ev, plan);
    when cobra_event_on(ev, evd);
    when continuation_coverage_required_until(ev, qb, until);
    then duty S4980BContinuationCoverage {
        bearer plan;
        beneficiary qb;
        goal maintenance {
            condition continuation_coverage_provided_to(plan, qb, ev);
            window [evd, until];
        }
    };
}
pub relation applicable_premium_for_period(plan: Person, qb: Person, ev: CobraQualifyingEvent, amount: Money) kind empirical {
    label en official "section 4980B(f)(4): the cost to the plan for the 12-month determination period of coverage for similarly situated beneficiaries with no qualifying event (self-insured plans: a reasonable actuarial estimate — G2519)";
}
pub relation premium_charged(plan: Person, qb: Person, ev: CobraQualifyingEvent, amount: Money) kind empirical {
    label en official "section 4980B(f)(2)(C): the premium the plan requires for a period of continuation coverage";
}
pub relation in_disability_extension_after_18th_month(qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(2)(C): the month is after the 18th month of continuation coverage for an individual described in the last sentence of (B)(i) (the disability extension)";
}
@source(IRC_S4980B_F, coverage = exact, quote = "shall not exceed 102 percent of the applicable premium for such period, and")
rule S4980BPremiumCap102ProhibitionRule(plan: Person, qb: Person, ev: CobraQualifyingEvent, ap: Money, charged: Money) defeasible {
    label en official "section 4980B(f)(2)(C)(i): the plan shall not require a premium above 102 percent of the applicable premium — VIOLATED on itself when a higher premium is charged (E-0179)";
    when cobra_event_plan(ev, plan);
    when applicable_premium_4980B(plan, qb, ev, ap);  // Stage 3: derived or asserted (30-*.law)
    when premium_charged(plan, qb, ev, charged);
    when charged > ap * ContinuationPremiumCapShare4980B;
    unless in_disability_extension_after_18th_month(qb, ev) and premium_charged(plan, qb, ev, charged) and applicable_premium_4980B(plan, qb, ev, ap);
    then prohibition S4980BExcessPremium {
        bearer plan;
        beneficiary qb;
        action premium_charged(plan, qb, ev, charged);
        window [-infinity, infinity];
    };
}
@source(IRC_S4980B_F, coverage = exact, quote = "In the case of an individual described in the last sentence of subparagraph (B)(i), any reference in clause (i) of this subparagraph to \"102 percent\" is deemed a reference to \"150 percent\" for any month after the 18th month of continuation coverage described in subclause (I) or (II) of subparagraph (B)(i).")
rule S4980BPremiumCap150DisabilityProhibitionRule(plan: Person, qb: Person, ev: CobraQualifyingEvent, ap: Money, charged: Money) defeasible {
    label en official "section 4980B(f)(2)(C): for the disability extension after the 18th month the cap is 150 percent";
    when cobra_event_plan(ev, plan);
    when applicable_premium_4980B(plan, qb, ev, ap);  // Stage 3
    when premium_charged(plan, qb, ev, charged);
    when in_disability_extension_after_18th_month(qb, ev);
    when charged > ap * DisabilityExtensionPremiumCapShare4980B;
    then prohibition S4980BExcessDisabilityPremium {
        bearer plan;
        beneficiary qb;
        action premium_charged(plan, qb, ev, charged);
        window [-infinity, infinity];
    };
}
pub relation premium_demanded_on(plan: Person, qb: Person, ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(2)(C): the date the plan requires payment of a premium";
}
@source(IRC_S4980B_F, coverage = exact, quote = "In no event may the plan require the payment of any premium before the day which is 45 days after the day on which the qualified beneficiary made the initial election for continuation coverage.")
rule S4980BPremiumNotBefore45DaysProhibitionRule(plan: Person, qb: Person, ev: CobraQualifyingEvent, demanded: Date, elected: Date) defeasible {
    label en official "section 4980B(f)(2)(C): no premium may be required before the 45th day after the initial election — VIOLATED on itself when demanded earlier";
    when premium_demanded_on(plan, qb, ev, demanded);
    when continuation_coverage_election_made_on(ev, qb, elected);
    when demanded < add_calendar_period(elected, 45 calendar_day);
    then prohibition S4980BPremiumDemandedTooEarly {
        bearer plan;
        beneficiary qb;
        action premium_demanded_on(plan, qb, ev, demanded);
        window [-infinity, infinity];
    };
}
pub relation conversion_option_offered(plan: Person, qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(2)(E): during the 180-day period ending on the expiration date the plan provided the option of enrollment under a conversion health plan otherwise generally available under the plan";
}
@source(IRC_S4980B_F, coverage = exact, quote = "the plan must, during the 180-day period ending on such expiration date, provide to the qualified beneficiary the option of enrollment under a conversion health plan otherwise generally available under the plan.")
rule S4980BConversionOptionDutyRule(ev: CobraQualifyingEvent, qb: Person, plan: Person, expires: Date, calendar_before_1: Date) defeasible {
    label en official "section 4980B(f)(2)(E): when continuation coverage expires under (B)(i), the plan must offer the conversion option in the 180 days ending on the expiration date";
    when continuation_coverage_elected_or_deemed(ev, qb);  // Stage 3
    when cobra_event_plan(ev, plan);
    when continuation_coverage_required_until(ev, qb, expires)
        and us.irc.core::civil_calendar_boundary_before(expires, 180, us.irc.core::CalendarDay, calendar_before_1);
    then duty S4980BOfferConversionOption {
        bearer plan;
        beneficiary qb;
        goal achievement {
            condition conversion_option_offered(plan, qb, ev);
            window [calendar_before_1, expires];
        }
    };
}

// ============================================================================
// Notice duties (f)(6)
// ============================================================================

pub relation employer_notified_administrator_on(employer: Person, ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(6)(B): the employer notified the plan administrator of the qualifying event";
}
pub relation employer_of_covered_employee(employer: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(6)(B): the employer of the employee under the plan";
}
pub relation employer_plan_is_multiemployer_with_longer_period(ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(6)(B): the plan is a multiemployer plan whose terms provide a longer notice period (the case then uses that period)";
}
@source(IRC_S4980B_F, coverage = exact, quote = "The employer of an employee under a plan must notify the plan administrator of a qualifying event described in subparagraph (A), (B), (D), or (F) of paragraph (3) with respect to such employee within 30 days")
rule S4980BEmployerNoticeDutyRule(employer: Person, ev: CobraQualifyingEvent, evd: Date, k: QualifyingEventKind4980B) defeasible {
    label en official "section 4980B(f)(6)(B): the employer shall notify the plan administrator of a death, termination or reduced hours, Medicare entitlement or bankruptcy event within 30 days of the event";
    when employer_of_covered_employee(employer, ev);
    when cobra_event_kind(ev, k);
    when cobra_event_on(ev, evd);
    unless event_kind_notified_by_beneficiary(ev) and employer_of_covered_employee(employer, ev) and cobra_event_kind(ev, k) and cobra_event_on(ev, evd);
    then duty S4980BEmployerNotifiesAdministrator {
        bearer employer;
        goal achievement {
            condition employer_notified_administrator_of_event(employer, ev);
            window [evd, add_calendar_period(evd, 30 calendar_day)];
        }
    };
}
pub relation employer_notified_administrator_of_event(employer: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(6)(B): the employer notified the plan administrator";
}
relation event_kind_notified_by_beneficiary(ev: CobraQualifyingEvent) kind institutional {
    label en unofficial "the event is a divorce or a dependent child ceasing to be a dependent (the employee or beneficiary notifies, (f)(6)(C))";
}
rule EventNotifiedByBeneficiaryDivorce(ev: CobraQualifyingEvent) defeasible { label en unofficial "(f)(3)(C)"; when cobra_event_kind(ev, DivorceOrLegalSeparation); then event_kind_notified_by_beneficiary(ev); }
rule EventNotifiedByBeneficiaryDependent(ev: CobraQualifyingEvent) defeasible { label en unofficial "(f)(3)(E)"; when cobra_event_kind(ev, DependentCeasesToBeDependentChild); then event_kind_notified_by_beneficiary(ev); }
pub relation beneficiary_notified_administrator_of_event(who: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(6)(C): the covered employee or qualified beneficiary notified the plan administrator";
}
@source(IRC_S4980B_F, coverage = exact, quote = "Each covered employee or qualified beneficiary is responsible for notifying the plan administrator of the occurrence of any qualifying event described in subparagraph (C) or (E) of paragraph (3) within 60 days after the date of the qualifying event")
rule S4980BBeneficiaryNoticeDutyRule(who: Person, ev: CobraQualifyingEvent, evd: Date) defeasible {
    label en official "section 4980B(f)(6)(C): the covered employee or qualified beneficiary is responsible for notifying the plan administrator of a divorce, legal separation or loss of dependent status within 60 days";
    when qualified_beneficiary(who, ev);
    when cobra_event_on(ev, evd);
    when event_kind_notified_by_beneficiary(ev);
    then duty S4980BBeneficiaryNotifiesAdministrator {
        bearer who;
        goal achievement {
            condition beneficiary_notified_administrator_of_event(who, ev);
            window [evd, add_calendar_period(evd, 60 calendar_day)];
        }
    };
}
pub relation administrator_notified_on(admin: Person, ev: CobraQualifyingEvent, on: Date) kind empirical {
    label en official "section 4980B(f)(6)(D): the date the plan administrator was notified under (B) or (C)";
}
pub relation administrator_notified_beneficiary_of_rights(admin: Person, qb: Person, ev: CobraQualifyingEvent) kind empirical {
    label en official "section 4980B(f)(6)(D): the plan administrator notified the qualified beneficiary of the beneficiary's rights under the subsection";
}
pub relation plan_administrator_4980B(admin: Person, plan: Person) kind empirical {
    label en official "section 4980B(g)(3): the plan administrator (the administrator under ERISA section 3(16)(A))";
}
@source(IRC_S4980B_F, coverage = exact, quote = "For purposes of subparagraph (D), any notification shall be made within 14 days")
rule S4980BAdministratorNoticeDutyRule(admin: Person, qb: Person, ev: CobraQualifyingEvent, plan: Person, notified: Date) defeasible {
    label en official "section 4980B(f)(6)(D): the plan administrator shall notify each qualified beneficiary of the beneficiary's rights within 14 days of being notified of the qualifying event";
    when plan_administrator_4980B(admin, plan);
    when cobra_event_plan(ev, plan);
    when qualified_beneficiary(qb, ev);
    when administrator_notified_on(admin, ev, notified);
    then duty S4980BAdministratorNotifiesBeneficiary {
        bearer admin;
        beneficiary qb;
        goal achievement {
            condition administrator_notified_beneficiary_of_rights(admin, qb, ev);
            window [notified, add_calendar_period(notified, 14 calendar_day)];
        }
    };
}
pub relation coverage_commences_on(plan: Person, employee: Person, on: Date) kind empirical {
    label en official "section 4980B(f)(6)(A): the date coverage under the plan commences for the covered employee";
}
pub relation commencement_notice_given(plan: Person, employee: Person) kind empirical {
    label en official "section 4980B(f)(6)(A): written notice of the continuation coverage rights was provided to the covered employee and spouse";
}
@source(IRC_S4980B_F, coverage = exact, quote = "The group health plan shall provide, at the time of commencement of coverage under the plan, written notice to each covered employee and spouse of the employee (if any) of the rights provided under this subsection.")
rule S4980BCommencementNoticeDutyRule(plan: Person, employee: Person, start: Date) defeasible {
    label en official "section 4980B(f)(6)(A): the plan shall provide written notice of the rights at the time coverage commences";
    when coverage_commences_on(plan, employee, start);
    then duty S4980BCommencementNotice {
        bearer plan;
        beneficiary employee;
        goal achievement {
            condition commencement_notice_given(plan, employee);
            window [start, start];
        }
    };
}

// ============================================================================
// The tax (a)-(e)
// ============================================================================

pub relation cobra_failure_event(a: ExciseAct, ev: CobraQualifyingEvent) kind empirical {
    label en unofficial "the qualifying event the failure relates to";
}
pub relation cobra_failure_beneficiary(a: ExciseAct, qb: Person) kind empirical {
    label en unofficial "the qualified beneficiary to whom the failure relates";
}
pub relation cobra_failure_plan(a: ExciseAct, plan: Person) kind empirical {
    label en official "section 4980B(a): the group health plan that failed to meet the requirements of (f)";
}
pub relation cobra_failure_requirement_unmet(a: ExciseAct) kind empirical {
    label en official "section 4980B(a): the plan failed to meet a requirement of subsection (f) with respect to the qualified beneficiary (the case establishes which requirement)";
}
pub relation employer_normally_employed_fewer_than_20(a: ExciseAct) kind empirical {
    label en official "section 4980B(d)(1): the qualifying event occurred in the calendar year immediately following a calendar year in which all employers maintaining the plan normally employed fewer than 20 employees on a typical business day";
}
pub relation governmental_plan_414d(plan: Person) kind empirical {
    label en official "section 4980B(d)(2): a governmental plan (section 414(d))";
}
pub relation cobra_plan_multiemployer(plan: Person) kind empirical {
    label en official "section 4980B(e)(1)(A)(ii): the plan is a multiemployer plan";
}
pub relation coverage_period_last_day_without_premium_rule(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4980B(b)(2)(B)(ii): the last day in the period applicable to the qualified beneficiary under (f)(2)(B), determined without regard to clause (iii)";
}
rule NoncomplianceEndFromCobraOuterLimit(a: ExciseAct, last: Date) defeasible {
    label en official "section 4980B(b)(2)(B)(ii): 6 months after the last day of the (f)(2)(B) period";
    when coverage_period_last_day_without_premium_rule(a, last);
    then noncompliance_end_candidate(a, add_calendar_period(last, 6 calendar_month));
}
@source(IRC_S4980B_B, coverage = exact, quote = "The amount of the tax imposed by subsection (a) on any failure with respect to a qualified beneficiary shall be $100 for each day in the noncompliance period with respect to such failure.")
pub relation cobra_failure_gross_tax(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4980B(b)(1), (c)(3)(A): $100 × noncompliance days for the qualified beneficiary (the $100-a-day maximum per beneficiary)";
}
rule CobraFailureGrossTax(a: ExciseAct, plan: Person, n: Integer) defeasible {
    label en official "section 4980B(a), (b)(1)";
    when excise_act_kind(a, CobraFailure);
    when cobra_failure_plan(a, plan);
    when cobra_failure_requirement_unmet(a);
    when noncompliance_days(a, n);
    then cobra_failure_gross_tax(a, CobraFailureDailyTax4980B * n);
}
pub relation cobra_minimum_tax_cap(a: ExciseAct, amount: Money) kind institutional {
    label en official "section 4980B(b)(3): the ceiling of the minimum tax: $2,500, or $15,000 where the violations are more than de minimis";
}
rule CobraMinimumTaxCapOrdinary(a: ExciseAct, emp: Person, y: TaxableYear) defeasible {
    label en official "section 4980B(b)(3)(A): $2,500";
    when failure_employer(a, emp);
    when failure_taxable_year_of_employer(a, y);
    unless violations_more_than_de_minimis(emp, y) and failure_employer(a, emp) and failure_taxable_year_of_employer(a, y);
    then cobra_minimum_tax_cap(a, CobraMinimumTaxAfterExamination4980B);
}
rule CobraMinimumTaxCapDeMinimis(a: ExciseAct, emp: Person, y: TaxableYear) defeasible {
    label en official "section 4980B(b)(3)(B): $15,000";
    when failure_employer(a, emp);
    when failure_taxable_year_of_employer(a, y);
    when violations_more_than_de_minimis(emp, y);
    then cobra_minimum_tax_cap(a, CobraMinimumTaxDeMinimisExceeded4980B);
}
pub relation written_agreement_assumed_responsibility(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4980B(e)(2)(A): the person assumed, under a legally enforceable written agreement, responsibility for the performance of the act to which the failure relates";
}
pub relation person_responsible_for_administering_benefits_causing_failure(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4980B(e)(1)(B): a person responsible (other than as an employee) for administering or providing benefits under the plan whose act or failure to act caused (in whole or in part) the failure";
}
pub relation covers_similarly_situated_active_beneficiary_and_written_request(a: ExciseAct, p: Person) kind empirical {
    label en official "section 4980B(e)(2)(B): the person provides coverage for a similarly situated beneficiary with no qualifying event and received the written request to make the same coverage available to the qualified beneficiary";
}
pub relation cobra_liable_person(a: ExciseAct, p: Person) kind institutional {
    label en official "section 4980B(e): the employer (the plan for a multiemployer plan) and each person responsible for administering or providing benefits whose act caused the failure and who assumed responsibility in writing (or who fits (e)(2)(B))";
}
rule CobraLiableEmployer(a: ExciseAct, plan: Person, emp: Person) defeasible {
    label en official "section 4980B(e)(1)(A)(i): for a plan other than a multiemployer plan, the employer";
    when cobra_failure_plan(a, plan);
    when failure_employer(a, emp);
    unless cobra_plan_multiemployer(plan) and cobra_failure_plan(a, plan) and failure_employer(a, emp);
    then cobra_liable_person(a, emp);
}
rule CobraLiableMultiemployerPlan(a: ExciseAct, plan: Person) defeasible {
    label en official "section 4980B(e)(1)(A)(ii): for a multiemployer plan, the plan";
    when cobra_failure_plan(a, plan);
    when cobra_plan_multiemployer(plan);
    then cobra_liable_person(a, plan);
}
rule CobraLiableResponsiblePersonWithAgreement(a: ExciseAct, p: Person) defeasible {
    label en official "section 4980B(e)(1)(B), (e)(2)(A): a person responsible for administering or providing benefits whose act caused the failure, if it assumed responsibility under a written agreement";
    when person_responsible_for_administering_benefits_causing_failure(a, p);
    when written_agreement_assumed_responsibility(a, p);
    then cobra_liable_person(a, p);
}
rule CobraLiableResponsiblePersonSimilarlySituated(a: ExciseAct, p: Person) defeasible {
    label en official "section 4980B(e)(2)(B): a person who covers similarly situated active beneficiaries is liable once the written request is provided (without regard to the written-agreement rule)";
    when person_responsible_for_administering_benefits_causing_failure(a, p);
    when covers_similarly_situated_active_beneficiary_and_written_request(a, p);
    then cobra_liable_person(a, p);
}
@source(IRC_S4980B_A, coverage = exact, quote = "There is hereby imposed a tax on the failure of a group health plan to meet the requirements of subsection (f) with respect to any qualified beneficiary.")
pub relation cobra_failure_tax(a: ExciseAct, liable: Person, amount: Money) kind institutional {
    label en official "section 4980B: the tax on the failure after the (c) limits and (d) exceptions: $100 a day, none if not discoverable or promptly corrected for reasonable cause, but not less than the (b)(3) minimum where uncorrected at the examination notice";
}
rule CobraFailureTaxOrdinary(a: ExciseAct, g: Money, p: Person, plan: Person) defeasible {
    label en official "section 4980B(b)(1), (c)(1)-(2), (d): the gross tax unless excused or excepted";
    when cobra_failure_gross_tax(a, g);
    when cobra_liable_person(a, p);
    when cobra_failure_plan(a, plan);
    unless failure_excused_by_limitations(a) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan);
    unless employer_normally_employed_fewer_than_20(a) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan);
    unless governmental_plan_414d(plan) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan);
    unless church_plan_414e(plan) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan);
    then cobra_failure_tax(a, p, g);
}
rule CobraFailureTaxMinimumAfterExamination(a: ExciseAct, g: Money, p: Person, plan: Person, cap: Money) defeasible {
    label en official "section 4980B(b)(3): a failure uncorrected at the examination notice is taxed at least the lesser of the cap and the tax without the (c)(1)-(2) limitations, notwithstanding those limitations";
    when cobra_failure_gross_tax(a, g);
    when cobra_liable_person(a, p);
    when cobra_failure_plan(a, plan);
    when uncorrected_at_notice_of_examination(a);
    when failure_excused_by_limitations(a);
    when cobra_minimum_tax_cap(a, cap);
    unless employer_normally_employed_fewer_than_20(a) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan) and uncorrected_at_notice_of_examination(a) and cobra_minimum_tax_cap(a, cap);
    unless governmental_plan_414d(plan) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan) and uncorrected_at_notice_of_examination(a) and cobra_minimum_tax_cap(a, cap);
    unless church_plan_414e(plan) and cobra_failure_gross_tax(a, g) and cobra_liable_person(a, p) and cobra_failure_plan(a, plan) and uncorrected_at_notice_of_examination(a) and cobra_minimum_tax_cap(a, cap);
    then cobra_failure_tax(a, p, min(cap, g));
}
pub relation cobra_prior_year_plan_cost(emp: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4980B(c)(4)(A)(i)(I): the aggregate amount paid or incurred by the employer (or predecessor) during the preceding taxable year for group health plans";
}
pub relation cobra_reasonable_cause_failure(a: ExciseAct) kind institutional {
    label en official "section 4980B(c)(4): the failure is due to reasonable cause and not to willful neglect (the overall limitations apply only to such failures)";
}
rule CobraReasonableCauseFailure(a: ExciseAct) defeasible {
    label en official "the judgment relation about reasonable cause";
    when failure_due_to_reasonable_cause(a);
    then cobra_reasonable_cause_failure(a);
}
pub relation cobra_annual_tax_before_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980B(c)(4)(A): the taxes on the employer's reasonable-cause failures during its taxable year, before the overall limitation (single-employer plans; aggregate over a derived relation — G2514)";
}
rule CobraAnnualTaxBeforeLimit(emp: Person, y: TaxableYear, a0: ExciseAct) defeasible {
    label en official "sum of the failure taxes of the year";
    when failure_employer(a0, emp);
    when failure_taxable_year_of_employer(a0, y);
    then cobra_annual_tax_before_limit(emp, y, sum(collect all x: Money, a: ExciseAct where cobra_failure_tax(a, emp, x) and failure_taxable_year_of_employer(a, y) and cobra_reasonable_cause_failure(a), empty: 0.00 USD));
}
pub relation cobra_annual_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980B(c)(4)(A)(i): the lesser of 10 percent of the preceding year's group health plan cost and $500,000";
}
rule CobraAnnualLimit(emp: Person, y: TaxableYear, cost: Money) defeasible {
    label en official "section 4980B(c)(4)(A)(i)";
    when cobra_prior_year_plan_cost(emp, y, cost);
    then cobra_annual_limit(emp, y, min(cost * CobraOverallLimitShare4980B, CobraOverallLimitDollar4980B));
}
pub relation cobra_annual_tax_after_limit(emp: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4980B(c)(4): the reasonable-cause failure taxes after the overall limitation";
}
rule CobraAnnualTaxAfterLimit(emp: Person, y: TaxableYear, t: Money, l: Money) defeasible {
    label en official "the lesser of the taxes and the limit";
    when cobra_annual_tax_before_limit(emp, y, t);
    when cobra_annual_limit(emp, y, l);
    then cobra_annual_tax_after_limit(emp, y, min(t, l));
}
pub relation secretary_waives_cobra_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en official "section 4980B(c)(5): the Secretary waives part or all of the tax to the extent payment would be excessive relative to the failure";
}
pub relation cobra_failure_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4980B(c)(5): the tax on the failure is waived";
}
@source(IRC_S4980B_C, coverage = exact, quote = "the Secretary may waive part or all of the tax imposed by subsection (a) to the extent that the payment of such tax would be excessive relative to the failure involved.")
rule S4980BWaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4980B(c)(5): waiver for a failure due to reasonable cause and not to willful neglect";
    when excise_act_kind(a, CobraFailure);
    when secretary_waives_cobra_tax_on(a, on);
    then power S4980BWaiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_cobra_tax_on(a, on);
        valid_when failure_reasonable_cause_established_for_waiver(a);
        effect create(cobra_failure_tax_waived(a));
        window [-infinity, infinity];
    };
}
