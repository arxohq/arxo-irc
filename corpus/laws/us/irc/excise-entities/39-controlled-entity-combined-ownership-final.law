// Excise entities -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): section 4958(f)(3)(B) (G6891), "rules
// similar to the rules of paragraphs (3) and (4) of section 4946(a)" for the 35-percent controlled entity of (f)(3)(A).
//
// TECHNIQUE. The combined ownership of category (A) and (B) persons in an entity is a sum over the persons that are described in
// (A) (a position of substantial influence, `category_a_person_4958`) or (B) (a member of the family of such a person,
// `category_b_person_4958`, the classification of `DisqualifiedPerson4958Family` stated as its own relation so that the entity
// does not read `disqualified_person_4958`, which it also produces): their DIRECT shares of the entity plus the shares held
// through ONE entity tier that is not itself a category (A) or (B) person (the constructive ownership of section 267(c)(1),
// proportionately: the product of the person's share of the intermediary and the intermediary's share of the entity). The shares
// are case facts of one relation for the three entity kinds (the voting power of a corporation, the profits interest of a
// partnership, the beneficial interest of a trust or estate: the three tests of (f)(3)(A)(i)-(iii)). Bounded: two entity tiers are not
// followed (the rule of module 38 `constructive_interest_share_4946a4` has the same bound); the family attribution of
// section 267(c)(2) is not added on top of the direct shares of the family members, who are (B) persons and counted directly.
// The asserted `combined_ownership_by_a_or_b_persons` (module 21) stays the channel used when no direct share is supplied.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

use self::{
    ExciseAct,
    IRC_S4958_F,
    Person,
    category_a_person_4958,
    combined_ownership_by_a_or_b_persons,
    excess_benefit_organization,
    family_member_4958,
};

pub relation direct_ownership_share_4958f3(owner: Person, ent: Person, share: Decimal) kind empirical {
    label en official "section 4958(f)(3)(A): the share of the total combined voting power of a corporation, the profits interest of a partnership, or the beneficial interest of a trust or estate that the owner holds directly (case fact)";
}
pub relation category_b_person_4958(p: Person, org: Person, a: ExciseAct) kind institutional {
    label en official "section 4958(f)(1)(B): a member of the family of a category (A) person";
}
@source(IRC_S4958_F, coverage = exact, quote = "a member of the family of an individual described in subparagraph (A),")
rule CategoryBPerson4958(p: Person, org: Person, a: ExciseAct, q: Person) defeasible {
    label en official "section 4958(f)(1)(B)";
    when category_a_person_4958(q, org, a);
    when family_member_4958(p, q);
    then category_b_person_4958(p, org, a);
}
pub relation category_a_or_b_person_4958(p: Person, org: Person, a: ExciseAct) kind institutional {
    label en official "section 4958(f)(3)(A): a person described in (A) or (B) of section 4958(f)(1)";
}
rule CategoryAOrBFromA(p: Person, org: Person, a: ExciseAct) defeasible {
    label en official "category (A)";
    when category_a_person_4958(p, org, a);
    then category_a_or_b_person_4958(p, org, a);
}
rule CategoryAOrBFromB(p: Person, org: Person, a: ExciseAct) defeasible {
    label en official "category (B)";
    when category_b_person_4958(p, org, a);
    then category_a_or_b_person_4958(p, org, a);
}
pub relation combined_ownership_computed_4958f3(e: Person, org: Person, a: ExciseAct, share: Decimal) kind institutional {
    label en official "section 4958(f)(3)(A)-(B): the combined ownership of the entity by category (A) and (B) persons: their direct shares plus the shares through one tier of an intermediary that is not itself a category (A) or (B) person";
}
@source(IRC_S4958_F, coverage = exact, quote = "Rules similar to the rules of paragraphs (3) and (4) of section 4946(a) shall apply for purposes of this paragraph.")
rule CombinedOwnershipComputed4958f3(e: Person, org: Person, a: ExciseAct, h0: Person, s0: Decimal) defeasible {
    label en official "sum over the (A)/(B) persons of the direct share plus the one-tier constructive share";
    when excess_benefit_organization(a, org);
    when direct_ownership_share_4958f3(h0, e, s0);
    then combined_ownership_computed_4958f3(e, org, a,
        sum(collect all s: Decimal, h: Person where category_a_or_b_person_4958(h, org, a) and direct_ownership_share_4958f3(h, e, s), empty: 0.00)
        + sum(collect all x: Decimal, h2: Person, m: Person, s1: Decimal, s2: Decimal where category_a_or_b_person_4958(h2, org, a) and direct_ownership_share_4958f3(h2, m, s1) and direct_ownership_share_4958f3(m, e, s2) and not_known(category_a_or_b_person_4958(m, org, a)) and x == s1 * s2, empty: 0.00));
}
relation has_combined_ownership_computed_4958f3(e: Person, org: Person, a: ExciseAct) kind institutional {
    label en official "bridge for the absence test";
}
rule HasCombinedOwnershipComputed4958f3(e: Person, org: Person, a: ExciseAct, s: Decimal) defeasible {
    label en official "bridge for the absence test";
    when combined_ownership_computed_4958f3(e, org, a, s);
    then has_combined_ownership_computed_4958f3(e, org, a);
}
pub relation combined_ownership_for_controlled_entity_4958(e: Person, org: Person, a: ExciseAct, share: Decimal) kind institutional {
    label en official "the combined ownership the 35-percent test reads: computed from the direct shares where they are supplied, else asserted";
}
rule CombinedOwnershipForControlledEntityComputed4958(e: Person, org: Person, a: ExciseAct, s: Decimal) defeasible {
    label en official "the computed share";
    when combined_ownership_computed_4958f3(e, org, a, s);
    then combined_ownership_for_controlled_entity_4958(e, org, a, s);
}
rule CombinedOwnershipForControlledEntityAsserted4958(e: Person, org: Person, a: ExciseAct, s: Decimal) defeasible {
    label en official "the asserted share (the earlier channel)";
    when combined_ownership_by_a_or_b_persons(e, org, a, s);
    when not_known(has_combined_ownership_computed_4958f3(e, org, a));
    then combined_ownership_for_controlled_entity_4958(e, org, a, s);
}
