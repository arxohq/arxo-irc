// Stage 3 (26.09.2026). Section 4946(c) "government official" (the seven
// categories, tested at the time of the act), section 4946(a)(1)(I) (a
// government official is a disqualified person for section 4941 only),
// section 4941(d)(1)(F) (agreement to pay a government official) and the
// section 4941(d)(2) rules (A)-(H): one inclusion ((A) mortgaged transfer is a
// sale or exchange) and the exceptions (B)-(H) that take a transaction out of
// section 4941(d)(1).
//
// Design: the exceptions are one institutional relation
// `self_dealing_exception_4941d2(a)` that the classification rule of module 03
// (`SelfDealingActClassification`) reads through `unless`. Each exception
// clause is its own defeasible rule over case-asserted facts. The evaluative
// elements ("reasonable and necessary", "not excessive", "arm's-length terms")
// are `external judgment relation`s (DECISION-0194), not flat facts. Status:
// implemented_unverified; scenarios are not executed; no legal review.
//
// NOT modelled: the value of the lowest Senior Executive Service basic pay
// (4946(c)(3)(B)) and the section 5702 title 5 travel maximum are inputs of the
// case (their Title 5 sources are not pinned) — see TECH-GAPS G5900.

// --- 4946(c): government official ---

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4941_D,
    IRC_S4946_A,
    IRC_S4946_C,
    Person,
    ProhibitedTransactionType,
    SelfDealingActType,
    TaxableYear,
    chapter_42_foundation,
    disqualified_person,
    excise_act_kind,
    excise_act_occurred_on,
    self_dealing_act,
    self_dealing_act_type,
    self_dealing_disqualified_person,
    self_dealing_foundation,
    self_dealing_taxable_year,
};

enum GovernmentPositionCategory {
    ElectiveFederalOfficeExecutiveOrLegislative;
    PresidentialAppointmentExecutiveOrJudicialOffice;
    ScheduleCPosition;
    FederalPositionAtOrAboveLowestSesPay;
    CongressionalStaffPosition;
    StateOrLocalOffice;
    PersonalOrExecutiveAssistantOrSecretary;
    IrsOversightBoardMember;
}

@source(IRC_S4946_C, coverage = partial, quote = "an individual who, at the time of such act, holds any of the following offices or positions")
pub relation holds_government_position_on(p: Person, cat: GovernmentPositionCategory, on: Date) kind empirical {
    label en unofficial "section 4946(c): the individual holds a position of this category on the date";
}
@source(IRC_S4946_C, coverage = partial, quote = "other than as a \"special Government employee\"")
pub relation special_government_employee_on(p: Person, on: Date) kind empirical {
    label en official "section 4946(c): the position is held as a special Government employee within the meaning of 18 U.S.C. 202(a) (excluded from every category)";
}
@source(IRC_S4946_C, coverage = partial, quote = "compensation for which is equal to or greater than the lowest rate of basic pay for the Senior Executive Service")
pub relation compensation_at_or_above_lowest_ses_basic_pay_on(p: Person, on: Date) kind empirical {
    label en unofficial "section 4946(c)(3)(B): the compensation of the position equals or exceeds the lowest rate of basic pay for the Senior Executive Service under 5 U.S.C. 5382 (the amount is a Title 5 input)";
}
@source(IRC_S4946_C, coverage = partial, quote = "held by an individual receiving gross compensation at an annual rate of $15,000 or more")
pub relation annual_gross_compensation_rate_on(p: Person, on: Date, amount: Money) kind empirical {
    label en unofficial "section 4946(c)(4)-(5): the annual rate of gross compensation of the individual on the date";
}
@source(IRC_S4946_C, coverage = partial, quote = "personal or executive assistant or secretary to any of the foregoing")
pub relation assistant_or_secretary_to_on(p: Person, boss: Person, on: Date) kind empirical {
    label en unofficial "section 4946(c)(6): p is a personal or executive assistant or secretary to boss on the date";
}

pub relation government_office_holder_categories_1_to_5_on(p: Person, on: Date) kind institutional {
    label en official "section 4946(c)(1)-(5): the individual holds an elective or appointive federal office, a schedule C or SES-pay position, a congressional staff position at $15,000 or more, or a state or local office at $20,000 or more, other than as a special Government employee";
}
rule GovernmentOfficialElectiveFederal(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(1): an elective public office in the executive or legislative branch of the United States";
    when holds_government_position_on(p, ElectiveFederalOfficeExecutiveOrLegislative, on);
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}
rule GovernmentOfficialPresidentialAppointment(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(2): an office in the executive or judicial branch appointment to which was made by the President";
    when holds_government_position_on(p, PresidentialAppointmentExecutiveOrJudicialOffice, on);
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}
rule GovernmentOfficialScheduleC(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(3)(A): a position listed in schedule C of rule VI of the Civil Service Rules";
    when holds_government_position_on(p, ScheduleCPosition, on);
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}
rule GovernmentOfficialSesPay(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(3)(B): a federal position whose compensation is at or above the lowest rate of basic pay for the Senior Executive Service";
    when holds_government_position_on(p, FederalPositionAtOrAboveLowestSesPay, on);
    when compensation_at_or_above_lowest_ses_basic_pay_on(p, on);
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}
rule GovernmentOfficialCongressionalStaff(p: Person, on: Date, rate: Money) defeasible {
    label en official "section 4946(c)(4): a position under the House or the Senate held by an individual receiving gross compensation at an annual rate of $15,000 or more";
    when holds_government_position_on(p, CongressionalStaffPosition, on);
    when annual_gross_compensation_rate_on(p, on, rate);
    when rate >= 15000.00 USD;
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}
rule GovernmentOfficialStateOrLocalOffice(p: Person, on: Date, rate: Money) defeasible {
    label en official "section 4946(c)(5): an elective or appointive public office of a State, possession, political subdivision or the District of Columbia held by an individual receiving gross compensation at an annual rate of $20,000 or more";
    when holds_government_position_on(p, StateOrLocalOffice, on);
    when annual_gross_compensation_rate_on(p, on, rate);
    when rate >= 20000.00 USD;
    unless special_government_employee_on(p, on);
    then government_office_holder_categories_1_to_5_on(p, on);
}

@source(IRC_S4946_C, coverage = partial, quote = "For purposes of subsection (a)(1)(I) and section 4941, the term \"government official\" means")
pub relation government_official_on(p: Person, on: Date) kind institutional {
    label en official "section 4946(c): p is a government official on the date (categories (1)-(5), (6) assistant or secretary to such an official, (7) member of the Internal Revenue Service Oversight Board)";
}
rule GovernmentOfficialCategories1To5(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(1)-(5): the holder of an office or position of categories (1)-(5)";
    when government_office_holder_categories_1_to_5_on(p, on);
    then government_official_on(p, on);
}
rule GovernmentOfficialAssistant(p: Person, on: Date, boss: Person) defeasible {
    label en official "section 4946(c)(6): a personal or executive assistant or secretary to an official of categories (1)-(5)";
    when holds_government_position_on(p, PersonalOrExecutiveAssistantOrSecretary, on);
    when assistant_or_secretary_to_on(p, boss, on);
    when government_office_holder_categories_1_to_5_on(boss, on);
    unless special_government_employee_on(p, on);
    then government_official_on(p, on);
}
rule GovernmentOfficialIrsOversightBoard(p: Person, on: Date) defeasible {
    label en official "section 4946(c)(7): a member of the Internal Revenue Service Oversight Board";
    when holds_government_position_on(p, IrsOversightBoardMember, on);
    unless special_government_employee_on(p, on);
    then government_official_on(p, on);
}

// --- 4946(a)(1)(I): a government official is disqualified for section 4941 only ---

@source(IRC_S4946_A, coverage = partial, quote = "(I) only for purposes of section 4941, a government official (as defined in subsection (c)).")
pub relation disqualified_for_4941(p: Person, f: Person, a: ExciseAct) kind institutional {
    label en official "section 4946(a)(1): p is a disqualified person with respect to f for the self-dealing act a, including (I) a government official at the time of the act (for section 4941 only)";
}
rule DisqualifiedFor4941Ordinary(p: Person, f: Person, a: ExciseAct) defeasible {
    label en official "section 4946(a)(1)(A)-(D): an ordinary disqualified person is disqualified for section 4941";
    when excise_act_kind(a, SelfDealingAct);
    when disqualified_person(p, f);
    then disqualified_for_4941(p, f, a);
}
rule DisqualifiedFor4941GovernmentOfficial(p: Person, f: Person, a: ExciseAct, on: Date) defeasible {
    label en official "section 4946(a)(1)(I): a government official (section 4946(c)), tested on the date of the act, is a disqualified person for section 4941";
    when excise_act_kind(a, SelfDealingAct);
    when self_dealing_foundation(a, f);
    when excise_act_occurred_on(a, on);
    when government_official_on(p, on);
    then disqualified_for_4941(p, f, a);
}

pub relation self_dealing_party_is_government_official(a: ExciseAct) kind institutional {
    label en official "section 4946(c): the disqualified person on the other side of the act is a government official at the time of the act";
}
rule SelfDealingPartyIsGovernmentOfficial(a: ExciseAct, p: Person, on: Date) defeasible {
    label en official "section 4946(c): the counterparty of the act holds a government office on the date of the act";
    when self_dealing_disqualified_person(a, p);
    when excise_act_occurred_on(a, on);
    when government_official_on(p, on);
    then self_dealing_party_is_government_official(a);
}

// --- 4941(d)(1)(F): agreement to pay a government official ---

@source(IRC_S4941_D, coverage = partial, quote = "agreement by a private foundation to make any payment of money or other property to a government official (as defined in section 4946(c))")
pub relation employment_agreement_for_period_after_government_service(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(1)(F): the agreement is an agreement to employ the individual for a period after the termination of his government service";
}
@source(IRC_S4941_D, coverage = partial, quote = "if such individual is terminating his government service within a 90-day period")
pub relation government_service_terminates_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "section 4941(d)(1)(F): the date on which the individual terminates his government service";
}
pub relation agreement_to_pay_official_is_excepted_4941d1f(a: ExciseAct) kind institutional {
    label en official "section 4941(d)(1)(F): an agreement to employ the individual after termination of government service is not within (F) when the service terminates within a 90-day period";
}
rule AgreementToEmployWithin90DaysOfTermination(a: ExciseAct, made: Date, ends: Date) defeasible {
    label en official "section 4941(d)(1)(F): agreement to employ for any period after the termination of government service, where the individual terminates within a 90-day period (read as 90 days from the agreement date)";
    when excise_act_occurred_on(a, made);
    when employment_agreement_for_period_after_government_service(a);
    when government_service_terminates_on(a, ends);
    when ends <= add_calendar_period(made, 90 calendar_day);
    then agreement_to_pay_official_is_excepted_4941d1f(a);
}
rule TypeFAgreementRequiresGovernmentOfficial(a: ExciseAct) defeasible {
    label en official "section 4941(d)(1)(F): paragraph (F) reaches only agreements to pay a government official";
    when self_dealing_act_type(a, AgreementToPayGovernmentOfficial);
    unless self_dealing_party_is_government_official(a);
    then self_dealing_exception_4941d2(a);
}
rule TypeFAgreementExceptedByEmploymentWindow(a: ExciseAct) defeasible {
    label en official "section 4941(d)(1)(F): the post-service employment agreement carve-out";
    when self_dealing_act_type(a, AgreementToPayGovernmentOfficial);
    when agreement_to_pay_official_is_excepted_4941d1f(a);
    then self_dealing_exception_4941d2(a);
}

// --- 4941(d)(2)(A): the inclusion (mortgaged transfer is a sale or exchange) ---

@source(IRC_S4941_D, coverage = partial, quote = "the transfer of real or personal property by a disqualified person to a private foundation shall be treated as a sale or exchange")
pub relation transfer_of_property_by_disqualified_person_to_foundation(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(A): the act is a transfer of real or personal property by a disqualified person to the foundation";
}
pub relation property_subject_to_lien_assumed_by_foundation(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(A): the property is subject to a mortgage or similar lien which the foundation assumes";
}
pub relation lien_placed_by_disqualified_person_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "section 4941(d)(2)(A): the date on which a disqualified person placed a mortgage or similar lien on the property";
}
@source(IRC_S4941_D, coverage = partial, quote = "if the property is subject to a mortgage or similar lien which the foundation assumes")
pub relation transfer_treated_as_sale_or_exchange_4941d2a(a: ExciseAct) kind institutional {
    label en official "section 4941(d)(2)(A): the transfer of property by a disqualified person to the foundation is treated as a sale or exchange";
}
rule TransferAssumedLienIsSaleOrExchange(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(A): property subject to a lien the foundation assumes";
    when transfer_of_property_by_disqualified_person_to_foundation(a);
    when property_subject_to_lien_assumed_by_foundation(a);
    then transfer_treated_as_sale_or_exchange_4941d2a(a);
}
rule TransferRecentLienIsSaleOrExchange(a: ExciseAct, transfer: Date, placed: Date, calendar_before_1: Date) defeasible {
    label en official "section 4941(d)(2)(A): property subject to a lien a disqualified person placed on it within the 10-year period ending on the date of the transfer";
    when transfer_of_property_by_disqualified_person_to_foundation(a);
    when excise_act_occurred_on(a, transfer);
    when lien_placed_by_disqualified_person_on(a, placed);
    when placed >= calendar_before_1;
    when placed <= transfer
        and us.irc.core::civil_calendar_boundary_before(transfer, 10, us.irc.core::CalendarYear, calendar_before_1);
    then transfer_treated_as_sale_or_exchange_4941d2a(a);
}
rule SelfDealingViaMortgagedTransfer(a: ExciseAct, p: Person, f: Person, y: TaxableYear) defeasible {
    label en official "section 4941(d)(2)(A) with (d)(1)(A): a mortgaged transfer by a disqualified person is treated as a sale or exchange and is an act of self-dealing";
    when excise_act_kind(a, SelfDealingAct);
    when transfer_treated_as_sale_or_exchange_4941d2a(a);
    when self_dealing_disqualified_person(a, p);
    when self_dealing_foundation(a, f);
    when disqualified_for_4941(p, f, a);
    when self_dealing_taxable_year(a, y);
    when chapter_42_foundation(f, y);
    then self_dealing_act(a);
}

// --- 4941(d)(2)(B)-(H): exceptions ---

@source(IRC_S4941_D, coverage = partial, quote = "the lending of money by a disqualified person to a private foundation shall not be an act of self-dealing")
pub relation self_dealing_exception_4941d2(a: ExciseAct) kind institutional {
    label en official "section 4941(d)(2): the act is taken out of section 4941(d)(1) by one of the exception clauses (B)-(H) (or by the (d)(1)(F) carve-outs)";
}

pub relation loan_from_disqualified_person_to_foundation(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(B): the act is a loan of money by a disqualified person to the foundation";
}
pub relation loan_without_interest_or_other_charge(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(B): the loan is without interest or other charge (determined without regard to section 7872)";
}
pub relation proceeds_used_exclusively_for_501c3_purposes(a: ExciseAct) kind empirical {
    label en unofficial "sections 4941(d)(2)(B)-(C): the loan proceeds, goods, services or facilities are used exclusively for purposes specified in section 501(c)(3)";
}
rule ExceptionInterestFreeLoan(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(B): an interest-free loan by a disqualified person whose proceeds are used exclusively for section 501(c)(3) purposes is not self-dealing";
    when self_dealing_act_type(a, LendingOrExtensionOfCredit);
    when loan_from_disqualified_person_to_foundation(a);
    when loan_without_interest_or_other_charge(a);
    when proceeds_used_exclusively_for_501c3_purposes(a);
    then self_dealing_exception_4941d2(a);
}

pub relation furnishing_by_disqualified_person_to_foundation(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(C): the act is a furnishing of goods, services or facilities by a disqualified person to the foundation";
}
pub relation furnishing_without_charge(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(C): the furnishing is without charge";
}
rule ExceptionFreeFurnishingToFoundation(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(C): a free furnishing by a disqualified person used exclusively for section 501(c)(3) purposes is not self-dealing";
    when self_dealing_act_type(a, FurnishingGoodsServicesOrFacilities);
    when furnishing_by_disqualified_person_to_foundation(a);
    when furnishing_without_charge(a);
    when proceeds_used_exclusively_for_501c3_purposes(a);
    then self_dealing_exception_4941d2(a);
}

pub relation furnishing_by_foundation_to_disqualified_person(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(D): the act is a furnishing of goods, services or facilities by the foundation to a disqualified person";
}
pub relation furnishing_no_more_favorable_than_general_public(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(D): the furnishing is made on a basis no more favorable than that on which the goods, services or facilities are available to the general public";
}
rule ExceptionFurnishingByFoundationOnPublicTerms(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(D): a furnishing by the foundation on a basis no more favorable than to the general public is not self-dealing";
    when self_dealing_act_type(a, FurnishingGoodsServicesOrFacilities);
    when furnishing_by_foundation_to_disqualified_person(a);
    when furnishing_no_more_favorable_than_general_public(a);
    then self_dealing_exception_4941d2(a);
}

pub relation compensation_for_personal_services_of_disqualified_person(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(E): the act is a payment of compensation (or payment or reimbursement of expenses) by the foundation to a disqualified person for personal services";
}
@source(IRC_S4941_D, coverage = partial, quote = "personal services which are reasonable and necessary to carrying out the exempt purpose of the private foundation")
external judgment relation personal_services_compensation_reasonable_necessary_and_not_excessive(a: ExciseAct) {
    authority TaxCourt;
    label en official "section 4941(d)(2)(E): the personal services are reasonable and necessary to carrying out the exempt purpose and the compensation (or payment or reimbursement) is not excessive";
}
rule ExceptionReasonableCompensation(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(E): reasonable and necessary personal-services compensation that is not excessive is not self-dealing, except in the case of a government official";
    when self_dealing_act_type(a, PaymentOfCompensation);
    when compensation_for_personal_services_of_disqualified_person(a);
    when personal_services_compensation_reasonable_necessary_and_not_excessive(a);
    unless self_dealing_party_is_government_official(a);
    then self_dealing_exception_4941d2(a);
}

pub relation transaction_with_disqualified_corporation_in_corporate_adjustment(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(F): the transaction is between the foundation and a corporation which is a disqualified person, pursuant to a liquidation, merger, redemption, recapitalization or other corporate adjustment, organization or reorganization";
}
pub relation all_securities_of_class_subject_to_same_terms(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(F): all of the securities of the same class as that held by the foundation are subject to the same terms";
}
pub relation terms_give_foundation_no_less_than_fair_market_value(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(F): the terms provide for receipt by the foundation of no less than fair market value";
}
rule ExceptionCorporateAdjustment(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(F): a corporate-adjustment transaction on uniform terms giving the foundation at least fair market value is not self-dealing";
    when transaction_with_disqualified_corporation_in_corporate_adjustment(a);
    when all_securities_of_class_subject_to_same_terms(a);
    when terms_give_foundation_no_less_than_fair_market_value(a);
    then self_dealing_exception_4941d2(a);
}

// (G): additional exceptions in the case of a government official.

enum GovernmentOfficialExemptItem {
    PrizeOrAward;
    ScholarshipOrFellowship;
    QualifiedTrustAnnuity;
    Section404a2PlanPayment;
    NonMoneyGiftOrServices;
    FederalEmployeesCompensationPayment;
    DomesticTravelExpenses;
}
pub relation payment_to_official_item(a: ExciseAct, item: GovernmentOfficialExemptItem) kind empirical {
    label en unofficial "section 4941(d)(2)(G): which of the seven enumerated items the payment or benefit to the government official is";
}
pub relation prize_selected_from_general_public(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(i): the prize or award is subject to section 74(b) (without regard to paragraph (3)) and the recipients are selected from the general public";
}
pub relation scholarship_for_study_at_educational_organization(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(ii): the scholarship or fellowship grant would be subject to section 117(a) as in effect before the Tax Reform Act of 1986 and is to be used for study at an educational organization described in section 170(b)(1)(A)(ii)";
}
pub relation payment_by_qualified_trust_under_401(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(iii): the annuity or other payment forms part of a stock-bonus, pension or profit-sharing plan and is made by a qualified trust under section 401";
}
pub relation payment_under_plan_meeting_404a2(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(iv): the annuity or other payment is under a plan which meets the requirements of section 404(a)(2)";
}
pub relation gift_is_money(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(v): the contribution or gift is a contribution or gift of money";
}
pub relation aggregate_value_to_individual_in_calendar_year(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(v): the aggregate value of contributions, gifts, services and facilities made to or available to the individual during the calendar year";
}
pub relation payment_under_title_5_chapter_41(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vi): the payment is made under chapter 41 of title 5, United States Code";
}
pub relation travel_solely_within_united_states(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vii): the travel is solely from one point in the United States to another point in the United States";
}
pub relation travel_transportation_payment(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vii): the payment or reimbursement for the transportation involved";
}
pub relation actual_transportation_cost(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vii): the actual cost of the transportation involved";
}
pub relation travel_other_expense_payment(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vii): the payment or reimbursement for all other traveling expenses";
}
pub relation section_5702_maximum_for_like_travel(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4941(d)(2)(G)(vii): the maximum amount payable under 5 U.S.C. 5702 for like travel by employees of the United States (a Title 5 input)";
}

rule ExceptionOfficialPrizeOrAward(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(G)(i): prizes and awards selected from the general public, for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, PrizeOrAward);
    when prize_selected_from_general_public(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialScholarship(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(G)(ii): scholarships and fellowship grants for study at an educational organization, for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, ScholarshipOrFellowship);
    when scholarship_for_study_at_educational_organization(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialQualifiedTrustPayment(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(G)(iii): an annuity or other payment by a qualified trust under section 401, for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, QualifiedTrustAnnuity);
    when payment_by_qualified_trust_under_401(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialPlan404a2(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(G)(iv): a payment under a plan meeting section 404(a)(2), for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, Section404a2PlanPayment);
    when payment_under_plan_meeting_404a2(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialSmallNonMoneyGift(a: ExciseAct, total: Money) defeasible {
    label en official "section 4941(d)(2)(G)(v): a non-money contribution, gift, service or facility to the official whose calendar-year aggregate value does not exceed $25";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, NonMoneyGiftOrServices);
    when aggregate_value_to_individual_in_calendar_year(a, total);
    when total <= 25.00 USD;
    unless gift_is_money(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialChapter41Payment(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(G)(vi): a payment made under chapter 41 of title 5, for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, FederalEmployeesCompensationPayment);
    when payment_under_title_5_chapter_41(a);
    then self_dealing_exception_4941d2(a);
}
rule ExceptionOfficialDomesticTravel(a: ExciseAct, paid_transport: Money, actual: Money, paid_other: Money, maximum: Money) defeasible {
    label en official "section 4941(d)(2)(G)(vii): domestic travel payments not exceeding the actual transportation cost plus other traveling expenses not above 125 percent of the section 5702 maximum, for a government official";
    when self_dealing_party_is_government_official(a);
    when payment_to_official_item(a, DomesticTravelExpenses);
    when travel_solely_within_united_states(a);
    when travel_transportation_payment(a, paid_transport);
    when actual_transportation_cost(a, actual);
    when paid_transport <= actual;
    when travel_other_expense_payment(a, paid_other);
    when section_5702_maximum_for_like_travel(a, maximum);
    when paid_other <= maximum * 1.25;
    then self_dealing_exception_4941d2(a);
}

// (H): the office-space lease.

pub relation office_space_lease_by_disqualified_person(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(H): the act is the leasing by a disqualified person to the foundation of office space in a building with other tenants who are not disqualified persons";
}
pub relation lease_binding_and_in_effect_on_1969_10_09(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(H)(i): the lease was a binding lease in effect on October 9, 1969, or is a renewal of such a lease";
}
pub relation lease_execution_was_not_prohibited_transaction_503b(a: ExciseAct) kind empirical {
    label en unofficial "section 4941(d)(2)(H)(ii): the execution of the lease was not a prohibited transaction within the meaning of section 503(b) or a corresponding provision of prior law when executed";
}
@source(IRC_S4941_D, coverage = partial, quote = "the terms of the lease (or any renewal) reflect an arm's-length transaction")
external judgment relation lease_terms_reflect_arms_length_transaction(a: ExciseAct) {
    authority TaxCourt;
    label en official "section 4941(d)(2)(H)(iii): the terms of the lease (or any renewal) reflect an arm's-length transaction";
}
rule ExceptionOfficeSpaceLease(a: ExciseAct) defeasible {
    label en official "section 4941(d)(2)(H): a legacy office-space lease meeting (i)-(iii) is not treated as self-dealing";
    when office_space_lease_by_disqualified_person(a);
    when lease_binding_and_in_effect_on_1969_10_09(a);
    when lease_execution_was_not_prohibited_transaction_503b(a);
    when lease_terms_reflect_arms_length_transaction(a);
    then self_dealing_exception_4941d2(a);
}
