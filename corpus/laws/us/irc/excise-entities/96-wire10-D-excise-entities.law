// Excise entities -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 6501(n) (owner of the assessment period: `us.irc.assessment`) needs to know that an assessable payment under section 4980H
// exists for a calendar year. This package computes the monthly payments of section 4980H(a) and (b) and imports `assessment` (owner-derives-consumer-stub, Д-26):
// a positive monthly payment of the calendar year makes `assessment::assessable_payment_4980h(employer, taxable year)` hold for the
// taxable year that is that calendar year (`core::calendar_year_of`). JUDGMENT CALL: the year of the month is the calendar year `cy`
// that the month's employee count (`full_time_employees_in_month`) is tied to.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

import us.irc.assessment version "0.1.1";

use self::{
    Person,
    full_time_employees_in_month,
    no_offer_assessable_payment,
    offer_assessable_payment,
};

rule W10DAssessablePayment4980hFromNoOfferPayment strict {
    label en official "section 4980H(a): a positive assessable payment for a month of the calendar year is an assessable payment under section 4980H for the calendar year";
    for emp: us.irc.core::Person;
    for cy: Integer;
    for ym: Integer;
    for n: Integer;
    for amt: Money;
    for y: us.irc.core::TaxableYear;
    when no_offer_assessable_payment(emp, ym, amt);
    when full_time_employees_in_month(emp, cy, ym, n);
    when us.irc.core::calendar_year_of(y, cy);
    when amt > 0.00 USD;
    then us.irc.assessment::assessable_payment_4980h(emp, y);
}
rule W10DAssessablePayment4980hFromOfferPayment strict {
    label en official "section 4980H(b): a positive assessable payment for a month of the calendar year is an assessable payment under section 4980H for the calendar year";
    for emp: us.irc.core::Person;
    for cy: Integer;
    for ym: Integer;
    for n: Integer;
    for amt: Money;
    for y: us.irc.core::TaxableYear;
    when offer_assessable_payment(emp, ym, amt);
    when full_time_employees_in_month(emp, cy, ym, n);
    when us.irc.core::calendar_year_of(y, cy);
    when amt > 0.00 USD;
    then us.irc.assessment::assessable_payment_4980h(emp, y);
}
