// Stage G3 (IRC-G steps 4-5, 2026-09-27): the computer-model investment advice transition
// of Pub. L. 109-280 section 601 (fragment IRC_S4975_NOTE_11), rows 26/4975/note/11/2-25
// (21 bound rows; NON_NORMATIVE rows 1, 7, 12, 20, 26 are untouched). The Secretary of Labor's
// determinations, class exemption and information collection are unpinned, so the case
// supplies them (see the row notes); each rule is a bridge of the form "PL section + case
// fact of the applied date -> statutory consequent". The operative upshots feed the
// existing head `prohibited_transaction_exempt_4975` on a parallel path; no existing rule
// is touched. STATUS: implemented_unverified (static check only; scenarios in
// tests/S40-g3-computer-model-transition-601.lawtest are NOT executed).
//
// JUDGMENT CALLS (recorded, see the G3 journal): labels cite "section 601" with the
// subparagraph letter only (the pinned note header says §601(b)(3), the row notes say
// (b)(4)). "The later of" (D)(i) is one conjunctive rule. The (A) solicitation chain is
// milestone atoms on Integer step codes (1 open, 2 scope, 3 top-50, 4 nonproprietary,
// 5 ready for the (B) determination).

use self::{
    ExciseAct,
    IRC_S4975_NOTE_11,
    advice_uses_computer_model_program,
    excise_act_occurred_on,
    prohibited_transaction_exempt_4975,
};

relation transition_case_date_601(on: Date) kind empirical {
    label en unofficial "section 601: the date as of which the transition is applied (case fact)";
}
pub relation solicitation_open_601(on: Date) kind institutional {
    label en official "section 601(A) of Pub. L. 109-280: solicitation of feasibility information is due as of the date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(A) Solicitation of information.—As soon as practicable after the date of the enactment of this Act [Aug. 17, 2006], the Secretary of Labor, in consultation with the Secretary of the Treasury, shall—")
rule SolicitationOpen601A(on: Date) strict {
    label en official "section 601(A) of Pub. L. 109-280: solicitation is due from enactment (August 17, 2006, the pinned note header)";
    when transition_case_date_601(on);
    when on >= @2006-08-17;
    then solicitation_open_601(on);
}
relation solicitation_scope_601(covers_described_plans: Boolean) kind empirical {
    label en unofficial "section 601(A)(i): the solicitation covers the feasibility for plans described in subparagraphs (B)-(F) (and so much of (G) as relates to them) of section 4975(e)(1)";
}
pub relation solicitation_scope_set_601(on: Date) kind institutional {
    label en official "section 601(A)(i) of Pub. L. 109-280: the solicitation covers the described plans as of the date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(i) solicit information as to the feasibility of the application of computer model investment advice programs for plans described in subparagraphs (B) through (F) (and so much of subparagraph (G) as relates to such subparagraphs) of section 4975(e)(1) of the Internal Revenue Code of 1986, including soliciting information from—")
rule SolicitationScope601Ai(on: Date) strict {
    label en official "section 601(A)(i) of Pub. L. 109-280";
    when solicitation_open_601(on);
    when solicitation_scope_601(true);
    then solicitation_scope_set_601(on);
}
relation solicited_top50_trustees_601(solicited: Boolean) kind empirical {
    label en unofficial "section 601(A)(i)(I): information was solicited from at least the top 50 trustees (by assets held)";
}
pub relation top50_solicited_601(on: Date) kind institutional {
    label en official "section 601(A)(i)(I) of Pub. L. 109-280: the top-50 trustees were solicited as of the date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(I) at least the top 50 trustees of such plans, determined on the basis of assets held by such trustees, and")
rule SolicitedTop50_601Ai1(on: Date) strict {
    label en official "section 601(A)(i)(I) of Pub. L. 109-280";
    when solicitation_scope_set_601(on);
    when solicited_top50_trustees_601(true);
    then top50_solicited_601(on);
}
relation solicited_nonproprietary_providers_601(solicited: Boolean) kind empirical {
    label en unofficial "section 601(A)(i)(II): information was solicited from other persons offering computer model programs based on nonproprietary products";
}
pub relation nonproprietary_solicited_601(on: Date) kind institutional {
    label en official "section 601(A)(i)(II) of Pub. L. 109-280: the nonproprietary providers were solicited as of the date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(II) other persons offering computer model investment advice programs based on nonproprietary products, and")
rule SolicitedNonproprietary601Ai2(on: Date) strict {
    label en official "section 601(A)(i)(II) of Pub. L. 109-280";
    when solicitation_scope_set_601(on);
    when solicited_nonproprietary_providers_601(true);
    then nonproprietary_solicited_601(on);
}
pub relation ready_for_determination_601(on: Date) kind institutional {
    label en official "section 601(A)(ii) of Pub. L. 109-280: the (B) determination is to be made on the solicited information as of the date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(ii) shall on the basis of such information make the determination under subparagraph (B).")
rule ReadyForDetermination601Aii(on: Date) strict {
    label en official "section 601(A)(ii) of Pub. L. 109-280: the (B) determination is to be made on the solicited information";
    when top50_solicited_601(on);
    when nonproprietary_solicited_601(on);
    then ready_for_determination_601(on);
}
relation transition_criterion_facts_601(a: ExciseAct, uses_relevant_info: Boolean, full_range_investments: Boolean, beneficiary_flexibility: Boolean) kind empirical {
    label en unofficial "section 601(B)(i)-(iii): the program utilizes relevant beneficiary information, takes into account the full range of investments, and allows the beneficiary sufficient flexibility (case-applied)";
}
pub relation transition_criterion_met_601(a: ExciseAct, criterion: Integer) kind institutional {
    label en official "section 601(B) of Pub. L. 109-280: the feasibility criterion is met (1 relevant information, 2 full range, 3 flexibility)";
}
@source(IRC_S4975_NOTE_11, quote = "\"(i) utilizes relevant information about the account beneficiary, which may include age, life expectancy, retirement age, risk tolerance, other assets or sources of income, and preferences as to certain types of investments,")
rule CriterionRelevantInfo601Bi(a: ExciseAct) defeasible {
    label en official "section 601(B)(i) of Pub. L. 109-280";
    when transition_criterion_facts_601(a, true, _, _);
    then transition_criterion_met_601(a, 1);
}
@source(IRC_S4975_NOTE_11, quote = "\"(ii) takes into account the full range of investments, including equities and bonds, in determining the options for the investment portfolio of the account beneficiary, and")
rule CriterionFullRange601Bii(a: ExciseAct) defeasible {
    label en official "section 601(B)(ii) of Pub. L. 109-280";
    when transition_criterion_facts_601(a, _, true, _);
    then transition_criterion_met_601(a, 2);
}
@source(IRC_S4975_NOTE_11, quote = "\"(iii) allows the account beneficiary, in directing the investment of assets, sufficient flexibility in obtaining advice to evaluate and select investment options.")
rule CriterionFlexibility601Biii(a: ExciseAct) defeasible {
    label en official "section 601(B)(iii) of Pub. L. 109-280";
    when transition_criterion_facts_601(a, _, _, true);
    then transition_criterion_met_601(a, 3);
}
pub relation feasibility_basis_complete_601(a: ExciseAct) kind institutional {
    label en official "section 601(B) of Pub. L. 109-280: the solicited information and the three criteria are in place for the feasibility determination";
}
@source(IRC_S4975_NOTE_11, quote = "\"(B) Determination of feasibility.—The Secretary of Labor, in consultation with the Secretary of the Treasury, shall, on the basis of information received under subparagraph (A), determine whether there is any computer model investment advice program which may be utilized by a plan described in subparagraph (A)(i) to provide investment advice to the account beneficiary of the plan which—")
rule FeasibilityBasis601B(a: ExciseAct, on: Date) defeasible {
    label en official "section 601(B) of Pub. L. 109-280";
    when ready_for_determination_601(on);
    when transition_criterion_met_601(a, 1);
    when transition_criterion_met_601(a, 2);
    when transition_criterion_met_601(a, 3);
    then feasibility_basis_complete_601(a);
}
relation secretary_determination_601(program_exists: Boolean) kind empirical {
    label en unofficial "section 601(B) or (D): the Secretary of Labor determined that a described computer model program exists (true) or does not exist (false) (case fact; no determination is pinned)";
}
relation determination_date_601(on: Date) kind empirical {
    label en unofficial "section 601(C)(i)(II) or (D)(i): the date of the Secretary's determination";
}
relation advice_plan_in_scope_601(a: ExciseAct, described_in_Ai: Boolean) kind empirical {
    label en unofficial "section 601(C): the act's plan is described in subparagraph (A)(i)";
}
pub relation model_restriction_disapplied_601(a: ExciseAct) kind institutional {
    label en official "section 601(C)(i)(I) of Pub. L. 109-280: subclause (II) of section 4975(f)(8)(B)(i) does not apply to the plan";
}
@source(IRC_S4975_NOTE_11, quote = "\"(I) Restriction on use.—Subclause (II) of section 4975(f)(8)(B)(i) of the Internal Revenue Code of 1986 shall not apply to a plan described in subparagraph (A)(i).")
rule RestrictionDisapplied601Ci1(a: ExciseAct) defeasible {
    label en official "section 601(C)(i)(I) of Pub. L. 109-280";
    when advice_uses_computer_model_program(a);
    when advice_plan_in_scope_601(a, true);
    then model_restriction_disapplied_601(a);
}
pub relation model_restriction_lifted_601(a: ExciseAct) kind institutional {
    label en official "section 601(C)(i)(II) of Pub. L. 109-280: the restriction ceased as of the determination date";
}
@source(IRC_S4975_NOTE_11, quote = "\"(II) Restriction lifted if model certified.—If the Secretary of Labor determines under subparagraph (B) or (D) that there is a computer model investment advice program described in subparagraph (B), subclause (I) shall cease to apply as of the date of such determination.")
rule RestrictionLiftedOnDetermination601Ci2(a: ExciseAct, on: Date, determined: Date) defeasible {
    label en official "section 601(C)(i)(II) of Pub. L. 109-280: a program-exists determination lifts the restriction for acts on or after its date";
    when secretary_determination_601(true);
    when determination_date_601(determined);
    when excise_act_occurred_on(a, on);
    when on >= determined;
    then model_restriction_lifted_601(a);
}
pub relation class_exemption_granted_601(a: ExciseAct) kind institutional {
    label en official "section 601(C)(ii) of Pub. L. 109-280: the class exemption from section 4975(c) treatment is granted for the plan's transactions";
}
@source(IRC_S4975_NOTE_11, quote = "\"(ii) Class exemption if no initial certification by secretary.—If the Secretary of Labor determines under subparagraph (B) that there is no computer model investment advice program described in subparagraph (B), the Secretary of Labor shall grant a class exemption from treatment as a prohibited transaction under section 4975(c) of the Internal Revenue Code of 1986 to any transaction described in section 4975(d)(17)(A) of such Code with respect to plans described in subparagraph (A)(i), subject")
rule ClassExemptionGranted601Cii(a: ExciseAct) defeasible {
    label en official "section 601(C)(ii) of Pub. L. 109-280: a no-program determination grants the class exemption";
    when secretary_determination_601(false);
    when advice_plan_in_scope_601(a, true);
    then class_exemption_granted_601(a);
}
relation exemption_conditions_601(a: ExciseAct, meets_d17_and_f8: Boolean, uses_objective_criteria: Boolean) kind empirical {
    label en unofficial "section 601(C)(ii)(I)-(II): the exemption's conditions are met (requirements of (d)(17) and (f)(8) other than (C); objective-criteria asset allocation) (case-applied)";
}
pub relation exemption_condition_d17_f8_met_601(a: ExciseAct) kind institutional {
    label en official "section 601(C)(ii)(I) of Pub. L. 109-280";
}
@source(IRC_S4975_NOTE_11, quote = "\"(I) ensure the requirements of sections 4975(d)(17) and 4975(f)(8) (other than subparagraph (C) thereof) of the Internal Revenue Code of 1986 are met, and")
rule ExemptionConditionD17F8_601(a: ExciseAct) defeasible {
    label en official "section 601(C)(ii)(I) of Pub. L. 109-280";
    when exemption_conditions_601(a, true, _);
    then exemption_condition_d17_f8_met_601(a);
}
pub relation exemption_objective_criteria_met_601(a: ExciseAct) kind institutional {
    label en official "section 601(C)(ii)(II) of Pub. L. 109-280";
}
@source(IRC_S4975_NOTE_11, quote = "\"(II) ensure the investment advice provided under the investment advice program utilizes prescribed objective criteria to provide asset allocation portfolios comprised of securities or other property available as investments under the plan.")
rule ExemptionObjectiveCriteria601(a: ExciseAct) defeasible {
    label en official "section 601(C)(ii)(II) of Pub. L. 109-280";
    when exemption_conditions_601(a, _, true);
    then exemption_objective_criteria_met_601(a);
}
@source(IRC_S4975_NOTE_11, quote = "\"(C) Application of computer model investment advice program.—")
rule ClassExemptionApplies601(a: ExciseAct) defeasible {
    label en official "section 601(C)(ii) of Pub. L. 109-280: the granted exemption with its conditions takes the transaction out of section 4975(c) (parallel path to the existing head)";
    when class_exemption_granted_601(a);
    when exemption_condition_d17_f8_met_601(a);
    when exemption_objective_criteria_met_601(a);
    then prohibited_transaction_exempt_4975(a);
}
relation subsequent_determination_601(made: Boolean, on: Date) kind empirical {
    label en unofficial "section 601(D)(i): the Secretary made a subsequent program-exists determination on the date (case fact)";
}
relation exemption_first_effective_601(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "section 601(D)(i)(II): the first date on which the class exemption took effect for the act";
}
pub relation class_exemption_ceased_601(a: ExciseAct) kind institutional {
    label en official "section 601(D)(i) of Pub. L. 109-280: the class exemption ceased for the act (after the later of 2 years past the subsequent determination and 3 years past first effect)";
}
@source(IRC_S4975_NOTE_11, quote = "\"(D) Subsequent determination.—")
rule ClassExemptionCeased601Di(a: ExciseAct, on: Date, subsequent: Date, first_effect: Date) defeasible {
    label en official "section 601(D)(i) of Pub. L. 109-280: one conjunctive rule for the later-of pair";
    when class_exemption_granted_601(a);
    when subsequent_determination_601(true, subsequent);
    when exemption_first_effective_601(a, first_effect);
    when excise_act_occurred_on(a, on);
    when on > add_calendar_period(subsequent, 2 calendar_year);
    when on > add_calendar_period(first_effect, 3 calendar_year);
    then class_exemption_ceased_601(a);
}
relation determination_request_601(a: ExciseAct, requested: Date) kind empirical {
    label en unofficial "section 601(D)(ii): the date any person requested a determination on a computer model program";
}
relation request_determination_made_601(a: ExciseAct, made: Date, program_exists: Boolean) kind empirical {
    label en unofficial "section 601(D)(ii): the date the Secretary determined on the request, and whether the program was described in subparagraph (B)";
}
pub relation request_determination_timely_601(a: ExciseAct) kind institutional {
    label en official "section 601(D)(ii) of Pub. L. 109-280: the determination came within 90 days of the request";
}
@source(IRC_S4975_NOTE_11, quote = "\"(ii) Requests for determination.—Any person may request the Secretary of Labor to make a determination under this subparagraph with respect to any computer model investment advice program, and the Secretary of Labor shall make a determination with respect to such request within 90 days.")
rule RequestDeterminationTimely601Dii(a: ExciseAct, requested: Date, made: Date) defeasible {
    label en official "section 601(D)(ii) of Pub. L. 109-280, first sentence";
    when determination_request_601(a, requested);
    when request_determination_made_601(a, made, _);
    when made <= add_calendar_period(requested, 90 calendar_day);
    then request_determination_timely_601(a);
}
relation congressional_notice_601(a: ExciseAct, notified: Date) kind empirical {
    label en unofficial "section 601(D)(ii): the date the Secretary notified the four committees of a negative determination with reasons";
}
pub relation congressional_notice_timely_601(a: ExciseAct) kind institutional {
    label en official "section 601(D)(ii) of Pub. L. 109-280: the committees were notified within 10 days of the negative determination";
}
rule CongressionalNoticeTimely601Dii(a: ExciseAct, made: Date, notified: Date) defeasible {
    label en official "section 601(D)(ii) of Pub. L. 109-280, second sentence";
    when request_determination_made_601(a, made, false);
    when congressional_notice_601(a, notified);
    when notified <= add_calendar_period(made, 10 calendar_day);
    then congressional_notice_timely_601(a);
}
