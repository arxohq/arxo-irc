@source(IRC_S4965_A, coverage = exact, quote = "such entity shall pay a tax for the taxable year in which the entity becomes such a party and any subsequent taxable year in the amount determined under subsection (b)(1).")
rule S4965EntityTaxPaymentDutyRule(a: ExciseAct, e: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "4965(a)(1): the tax-exempt entity shall pay the tax";
    when tax_shelter_entity_tax(a, e, y, amt);
    then duty S4965EntityTaxPayment {
        bearer e;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition annual_excise_tax_paid(e, y, TaxShelterEntity4965);
            window [-infinity, infinity];
        }
    };
}
