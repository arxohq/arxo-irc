// Payment duties (Stage 2, DECISION-0379). Every section that says the tax "shall be paid by" a named person
// makes payment the DUTY of that bearer toward the United States (represented by the IRS organ). The goal is an
// achievement goal without a statutory window here: the due date belongs to the collection norms of other
// owners (section 6151), so the window is unbounded and a VIOLATED status arises only from an asserted negation
// of the goal (E-0179 / the payment fact). The taxes of the two-tier shape are read from the shared
// `initial_tax` / `additional_tax` heads by the kind of act; annual and event taxes are read from their own heads.
// Sections whose text carries no payment sentence (4940, 4942, 4943, 4959, 4968, 4999 ...) get no duty here.

use self::{
    EsopAllocationEvent,
    EsopDisposition,
    ExcessContributionAccountKind,
    ExciseAct,
    ExciseActKind,
    IRC_S4912_A,
    IRC_S4912_B,
    IRC_S4941_A,
    IRC_S4941_B,
    IRC_S4944_A,
    IRC_S4944_B,
    IRC_S4945_A,
    IRC_S4945_B,
    IRC_S4951_A,
    IRC_S4951_B,
    IRC_S4952_A,
    IRC_S4952_B,
    IRC_S4953_A,
    IRC_S4955_A,
    IRC_S4955_B,
    IRC_S4958_A,
    IRC_S4958_B,
    IRC_S4965_A,
    IRC_S4966_A,
    IRC_S4967_A,
    IRC_S4971_E,
    IRC_S4972_B,
    IRC_S4973_A,
    IRC_S4975_A,
    IRC_S4975_B,
    IRC_S4978_C,
    IRC_S4979A_C,
    IRC_S4979_B,
    Person,
    Plan,
    TaxableYear,
    additional_tax,
    esop_disposition_tax,
    excess_contribution_tax,
    excess_contributions_plan_tax,
    excess_contributions_tax_4973,
    excise_act_kind,
    initial_tax,
    lobbying_manager_tax,
    lobbying_organization_tax,
    nondeductible_contributions_tax,
    prohibited_esop_allocation_tax,
    tax_shelter_entity_tax,
    tax_shelter_manager_tax,
};

pub relation excise_initial_tax_paid(a: ExciseAct, p: Person) kind empirical {
    label en official "the first-tier tax on the act, owed by the person, has been paid";
}
pub relation excise_additional_tax_paid(a: ExciseAct, p: Person) kind empirical {
    label en official "the second-tier tax on the act, owed by the person, has been paid";
}
enum AnnualTaxKind { Lobbying4912Organization; Lobbying4912Manager; ExcessContributions4953; TaxShelterEntity4965; TaxShelterManager4965; NondeductibleContributions4972; ExcessContributions4973; ExcessPlanContributions4979; }
pub relation annual_excise_tax_paid(p: Person, y: TaxableYear, k: AnnualTaxKind) kind empirical {
    label en official "the annual or event tax of the kind, owed by the person for the taxable year, has been paid";
}
pub relation esop_disposition_tax_paid(d: EsopDisposition, p: Person) kind empirical {
    label en official "the section 4978 tax on the disposition, owed by the person, has been paid";
}
pub relation esop_allocation_tax_paid(a: EsopAllocationEvent, p: Person) kind empirical {
    label en official "the section 4979A tax on the allocation or ownership, owed by the person, has been paid";
}

@source(IRC_S4941_A, coverage = exact, quote = "The tax imposed by this paragraph shall be paid by any disqualified person (other than a foundation manager acting only as such) who participates in the act of self-dealing.")
rule S4941InitialTaxPaymentDutyRule(a: ExciseAct, p: Person, amt: Money) defeasible {
    label en official "4941 initial tax: the person liable shall pay it";
    when excise_act_kind(a, SelfDealingAct);
    when initial_tax(a, p, amt);
    then duty S4941InitialTaxPayment {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition excise_initial_tax_paid(a, p);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S4941_B, coverage = exact, quote = "The tax imposed by this paragraph shall be paid by any disqualified person (other than a foundation manager acting only as such) who participated in the act of self-dealing.")
rule S4941AdditionalTaxPaymentDutyRule(a: ExciseAct, p: Person, amt: Money) defeasible {
    label en official "4941 additional tax: the person liable shall pay it";
    when excise_act_kind(a, SelfDealingAct);
    when additional_tax(a, p, amt);
    then duty S4941AdditionalTaxPayment {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition excise_additional_tax_paid(a, p);
            window [-infinity, infinity];
        }
    };
}

