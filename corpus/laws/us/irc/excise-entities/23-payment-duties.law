@source(IRC_S4978_C, coverage = exact, quote = "The tax imposed by this subsection shall be paid by—")
rule S4978PaymentDutyRule(d: EsopDisposition, payer: Person, amt: Money) defeasible {
    label en official "4978(c): the employer or eligible worker-owned cooperative that made the written statement shall pay the tax";
    when esop_disposition_tax(d, payer, amt);
    then duty S4978TaxPayment {
        bearer payer;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition esop_disposition_tax_paid(d, payer);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S4979A_C, coverage = exact, quote = "The tax imposed by this section shall be paid—")
rule S4979APaymentDutyRule(a: EsopAllocationEvent, payer: Person, amt: Money) defeasible {
    label en official "4979A(c): the employer, cooperative or S corporation shall pay the tax";
    when prohibited_esop_allocation_tax(a, payer, amt);
    then duty S4979ATaxPayment {
        bearer payer;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition esop_allocation_tax_paid(a, payer);
            window [-infinity, infinity];
        }
    };
}
