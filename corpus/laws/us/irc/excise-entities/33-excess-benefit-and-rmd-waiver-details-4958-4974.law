// Stage 3 (26.09.2026). Section 4958(c)(3)(C)(ii) (organizations excepted from
// "substantial contributor"), (e) (applicable tax-exempt organization, with the
// 5-year lookback and the private foundation exclusion), (f)(6) (correction)
// and section 4974(d) (the Secretary's waiver of the shortfall tax as a power).
// `applicable_tax_exempt_organization` and `contributor_is_excepted_organization_4958c3Cii`
// were empirical; they are `institutional` now, still assertable, with derivation
// rules added here. Status: implemented_unverified; scenarios not executed; no
// legal review.

// --- (e): applicable tax-exempt organization ---

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4958_E,
    IRC_S4974_D,
    Person,
    applicable_tax_exempt_organization,
    contributor_is_excepted_organization_4958c3Cii,
    excess_benefit_organization,
    excess_benefit_transaction_date,
    excise_act_kind,
};

pub relation org_would_be_described_501c3_4_or_29_and_exempt_on(org: Person, on: Date) kind empirical {
    label en unofficial "section 4958(e)(1): without regard to any excess benefit the organization would be described in section 501(c)(3), (4) or (29) and exempt from tax under section 501(a) on the date";
}
pub relation org_is_private_foundation_509a(org: Person) kind empirical {
    label en unofficial "section 4958(e), last sentence: the organization is a private foundation as defined in section 509(a)";
}
@source(IRC_S4958_E, coverage = partial, quote = "any organization which was described in paragraph (1) at any time during the 5-year period ending on the date of the transaction")
rule ApplicableTaxExemptOrganizationOnTheDate(org: Person, on: Date) defeasible {
    label en official "section 4958(e)(1): described in section 501(c)(3), (4) or (29) and exempt on the transaction date, other than a private foundation";
    when org_would_be_described_501c3_4_or_29_and_exempt_on(org, on);
    unless org_is_private_foundation_509a(org) and org_would_be_described_501c3_4_or_29_and_exempt_on(org, on);
    then applicable_tax_exempt_organization(org, on);
}
rule ApplicableTaxExemptOrganizationWithinFiveYears(org: Person, on: Date, then_on: Date, a: ExciseAct, calendar_before_1: Date) defeasible {
    label en official "section 4958(e)(2): described in paragraph (1) at any time during the 5-year period ending on the date of the transaction, other than a private foundation";
    when org_would_be_described_501c3_4_or_29_and_exempt_on(org, then_on);
    when then_on <= on;
    when us.irc.core::civil_calendar_boundary_before(on, 5, us.irc.core::CalendarYear, calendar_before_1);
    when then_on >= calendar_before_1;
    when excess_benefit_organization(a, org);
    when excess_benefit_transaction_date(a, on);
    unless org_is_private_foundation_509a(org) and org_would_be_described_501c3_4_or_29_and_exempt_on(org, then_on) and excess_benefit_organization(a, org) and excess_benefit_transaction_date(a, on);
    then applicable_tax_exempt_organization(org, on);
}

// --- (c)(3)(C)(ii): organizations excepted from substantial contributor ---

pub relation contributor_organization_described_in_509a1(p: Person) kind empirical {
    label en unofficial "section 4958(c)(3)(C)(ii)(I): the contributing organization is described in section 509(a)(1)";
}
pub relation contributor_organization_described_in_509a2(p: Person) kind empirical {
    label en unofficial "section 4958(c)(3)(C)(ii)(I): the contributing organization is described in section 509(a)(2)";
}
pub relation contributor_organization_described_in_509a4(p: Person) kind empirical {
    label en unofficial "section 4958(c)(3)(C)(ii)(I): the contributing organization is described in section 509(a)(4)";
}
pub relation contributor_treated_as_509a2_by_last_sentence(p: Person) kind empirical {
    label en unofficial "section 4958(c)(3)(C)(ii)(II): the organization is treated as described in section 509(a)(2) by reason of the last sentence of section 509(a)";
}
pub relation contributor_is_supported_organization_of(p: Person, org: Person) kind empirical {
    label en unofficial "section 4958(c)(3)(C)(ii)(II): the organization is a supported organization (section 509(f)(3)) of the organization to which subparagraph (A) applies";
}
rule ExceptedContributorOrganization509a1(p: Person, org: Person) defeasible {
    label en official "section 4958(c)(3)(C)(ii)(I): an organization described in section 509(a)(1)";
    when contributor_organization_described_in_509a1(p);
    when is_supporting_organization_context(org);
    then contributor_is_excepted_organization_4958c3Cii(p, org);
}
rule ExceptedContributorOrganization509a2(p: Person, org: Person) defeasible {
    label en official "section 4958(c)(3)(C)(ii)(I): an organization described in section 509(a)(2)";
    when contributor_organization_described_in_509a2(p);
    when is_supporting_organization_context(org);
    then contributor_is_excepted_organization_4958c3Cii(p, org);
}
rule ExceptedContributorOrganization509a4(p: Person, org: Person) defeasible {
    label en official "section 4958(c)(3)(C)(ii)(I): an organization described in section 509(a)(4)";
    when contributor_organization_described_in_509a4(p);
    when is_supporting_organization_context(org);
    then contributor_is_excepted_organization_4958c3Cii(p, org);
}
rule ExceptedContributorSupportedOrganization(p: Person, org: Person) defeasible {
    label en official "section 4958(c)(3)(C)(ii)(II): a supported organization of the supporting organization that is treated as a 509(a)(2) organization by the last sentence of section 509(a)";
    when contributor_treated_as_509a2_by_last_sentence(p);
    when contributor_is_supported_organization_of(p, org);
    then contributor_is_excepted_organization_4958c3Cii(p, org);
}
pub relation is_supporting_organization_context(org: Person) kind empirical {
    label en unofficial "the organization is a section 509(a)(3) organization to which section 4958(c)(3)(A) applies";
}

// --- (f)(6): correction ---

pub relation excess_benefit_undone_to_extent_possible(a: ExciseAct) kind empirical {
    label en unofficial "section 4958(f)(6): the excess benefit has been undone to the extent possible";
}
pub relation additional_measures_placed_org_in_position_not_worse(a: ExciseAct) kind empirical {
    label en unofficial "section 4958(f)(6): the additional measures necessary to place the organization in a financial position not worse than if the disqualified person were dealing under the highest fiduciary standards were taken";
}
pub relation transaction_is_donor_advised_fund_payment_4958c2(a: ExciseAct) kind empirical {
    label en unofficial "section 4958(f)(6): the transaction is described in subsection (c)(2) (a donor advised fund payment)";
}
pub relation repaid_amount_held_in_donor_advised_fund(a: ExciseAct) kind empirical {
    label en unofficial "section 4958(f)(6): an amount repaid in the manner prescribed by the Secretary is held in a donor advised fund";
}
pub relation excess_benefit_corrected_4958f6(a: ExciseAct) kind institutional {
    label en official "section 4958(f)(6): the excess benefit transaction is corrected; for a (c)(2) transaction no repaid amount may be held in a donor advised fund (the act_corrected_on date of the case is meaningful only when this holds)";
}
rule ExcessBenefitCorrected(a: ExciseAct) defeasible {
    label en official "section 4958(f)(6)";
    when excess_benefit_undone_to_extent_possible(a);
    when additional_measures_placed_org_in_position_not_worse(a);
    unless transaction_is_donor_advised_fund_payment_4958c2(a) and repaid_amount_held_in_donor_advised_fund(a) and excess_benefit_undone_to_extent_possible(a) and additional_measures_placed_org_in_position_not_worse(a);
    then excess_benefit_corrected_4958f6(a);
}

// --- 4974(d): waiver of the shortfall tax ---

@source(IRC_S4974_D, coverage = exact, quote = "the shortfall described in subsection (a) in the amount distributed during any taxable year was due to reasonable error")
external judgment relation rmd_shortfall_due_to_reasonable_error(a: ExciseAct) {
    authority Secretary;
    label en official "section 4974(d)(1): the taxpayer establishes to the satisfaction of the Secretary that the shortfall was due to reasonable error";
}
@source(IRC_S4974_D, coverage = exact, quote = "reasonable steps are being taken to remedy the shortfall")
external judgment relation rmd_reasonable_steps_being_taken_to_remedy(a: ExciseAct) {
    authority Secretary;
    label en official "section 4974(d)(2): the taxpayer establishes to the satisfaction of the Secretary that reasonable steps are being taken to remedy the shortfall";
}
pub relation rmd_waiver_conditions_met(a: ExciseAct) kind institutional {
    label en official "section 4974(d)(1)-(2): both showings are established";
}
rule RmdWaiverConditionsMet(a: ExciseAct) defeasible {
    label en official "section 4974(d)(1)-(2)";
    when rmd_shortfall_due_to_reasonable_error(a);
    when rmd_reasonable_steps_being_taken_to_remedy(a);
    then rmd_waiver_conditions_met(a);
}
pub relation secretary_waives_rmd_tax_on(a: ExciseAct, on: Date) kind empirical {
    label en unofficial "section 4974(d): the Secretary waives the tax imposed by subsection (a) for the taxable year on this date";
}
pub relation rmd_shortfall_tax_waived(a: ExciseAct) kind institutional {
    label en official "section 4974(d): the shortfall tax for the taxable year is waived";
}
rule S4974WaiverPowerRule(a: ExciseAct, on: Date) defeasible {
    label en official "section 4974(d): the Secretary may waive the tax imposed by subsection (a) for the taxable year if the taxpayer establishes reasonable error and reasonable steps; an exercise without the showings has no effect (E-0239)";
    when excise_act_kind(a, RmdShortfall);
    when secretary_waives_rmd_tax_on(a, on);
    then power S4974Waiver {
        holder us.irc.core::Secretary;
        over a;
        exercise secretary_waives_rmd_tax_on(a, on);
        valid_when rmd_waiver_conditions_met(a);
        effect create(rmd_shortfall_tax_waived(a));
        window [-infinity, infinity];
    };
}
