// Excise entities -- WIRE-9 (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Section 4979 taxes the "excess contributions" (section 401(k)(8)(B)) and the "excess aggregate contributions" (section 401(m)(6)(B)) of a
// plan for the plan year that ends in the taxable year. Both amounts are computed by `us.irc.deferred_compensation` (which this package
// imports); the two local placeholders are derived from them. The case-fact channel stays valid.
//
// JUDGMENT CALLS
//  - The owner keys the amounts by `(plan, y)` where `y` names the plan year; section 4979 speaks of the plan year ending in the taxable
//    year. The two are identified through the same `TaxableYear` entity (the case names one year for both), which is exact for a plan
//    whose plan year is its sponsor's taxable year and an assumption otherwise.
//  - `excess_contributions_for_plan_year` is also fed by section 408(k)(6)(C) (SEP) and section 501(c)(18) contributions, which the owner
//    computes elsewhere or not at all; only the section 401(k)(8)(B) branch is derived, the others stay case facts.
//  - `controlled_group_member_414(e, member)` is derived from `us.irc.deductions::employers_treated_as_single_employer_414` in both argument orders
//    (the group relation is symmetric); the consequence clauses of sections 4977, 4980B-4980H ("treated as 1 employer") are not implemented by this
//    derivation, so their coverage rows stay EXTERNAL_DEPENDENCY.

language "law.core" version "0.2";
package us.irc.excise_entities version "0.1.1";
namespace "urn:us:irc:excise_entities:clir";

use self::{
    Person,
    Plan,
    TaxableYear,
    controlled_group_member_414,
    excess_aggregate_contributions_for_plan_year,
    excess_contributions_for_plan_year,
};

rule W9ExcessAggregateContributionsFromDeferredCompensation strict {
    label en official "section 4979(a)(2), (d): the excess aggregate contributions of the plan year are the section 401(m)(6)(B) amount the deferred-compensation package computes";
    for plan: Plan;
    for y: TaxableYear;
    for amount: Money;
    when us.irc.deferred_compensation::excess_aggregate_contributions_amount(plan, y, amount);
    then excess_aggregate_contributions_for_plan_year(plan, y, amount);
}
rule W9ExcessContributionsFromDeferredCompensation strict {
    label en official "section 4979(a)(1), (c): the excess contributions of the plan year include the section 401(k)(8)(B) amount the deferred-compensation package computes";
    for plan: Plan;
    for y: TaxableYear;
    for amount: Money;
    when us.irc.deferred_compensation::excess_contributions_amount(plan, y, amount);
    then excess_contributions_for_plan_year(plan, y, amount);
}

// --- section 414(b), (c), (m), (o): persons treated as a single employer (owner: deductions, section 220(c)(4)(D)(i)) -------------------

rule W9ControlledGroupMember414FromDeductions strict {
    label en official "sections 4971(e)(2)(B), 4977, 4980B, 4980D, 4980E, 4980F, 4980H: the member is treated with the employer as a single employer under section 414(b), (c), (m) or (o), as the deductions package records it";
    for e: Person;
    for member: Person;
    when us.irc.deductions::employers_treated_as_single_employer_414(e, member);
    then controlled_group_member_414(e, member);
}
rule W9ControlledGroupMember414FromDeductionsSymmetric strict {
    label en official "the single-employer relation of section 414(b), (c), (m), (o) is symmetric: the employer is treated with the member as a single employer";
    for e: Person;
    for member: Person;
    when us.irc.deductions::employers_treated_as_single_employer_414(member, e);
    then controlled_group_member_414(e, member);
}
