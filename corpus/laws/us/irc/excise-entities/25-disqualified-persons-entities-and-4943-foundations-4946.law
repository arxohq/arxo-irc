// Stage 3 (26.09.2026). Section 4946(a)(1)(C)(ii)-(iii) (an owner of more than
// 20 percent of the profits interest of a partnership or the beneficial
// interest of a trust or unincorporated enterprise which is a substantial
// contributor), (E)-(G) (a corporation, partnership or trust or estate of
// which persons described in (A)-(D) own more than 35 percent), (H) (a private
// foundation that is a disqualified person only for section 4943), and
// section 4946(b)(2) (employees with authority over an act).
//
// JUDGMENT CALLS. (1) The constructive ownership of profits and beneficial
// interests (section 4946(a)(4): the section 267(c) rules other than paragraph
// (3), with the (d) family) is a case input: `constructive_profits_interest_share`
// and `constructive_beneficial_interest_share` carry the result of that
// attribution; the multi-path attribution itself is not derived (TECH-GAPS
// G5901). (2) In (E)-(G) the ownership of "persons described in subparagraph
// (A), (B), (C), or (D)" is an aggregate over a derived relation; the aggregate
// share is a case input (section 111 runtime subset, TECH-GAPS G5902).
// (3) "Effectively controlled" and "substantially all of the contributions" in
// (H) are evaluative elements (DECISION-0194), external judgments.
// Status: implemented_unverified; scenarios not executed; no legal review.

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4946_A,
    IRC_S4946_B,
    Person,
    TaxableYear,
    disqualified_person,
    excise_act_kind,
    foundation_manager,
    substantial_contributor,
    twenty_percent_corporate_owner_of_substantial_contributor,
};

@source(IRC_S4946_A, coverage = partial, quote = "(ii) the profits interest of a partnership, or")
pub relation constructive_profits_interest_share(p: Person, ent: Person, share: Decimal) kind empirical {
    label en unofficial "section 4946(a)(1)(C)(ii), (a)(4): the share of the profits interest of the partnership owned by p, determined under the section 267(c) constructive ownership rules (case input)";
}
@source(IRC_S4946_A, coverage = partial, quote = "(iii) the beneficial interest of a trust or unincorporated enterprise,")
pub relation constructive_beneficial_interest_share(p: Person, ent: Person, share: Decimal) kind empirical {
    label en unofficial "section 4946(a)(1)(C)(iii), (a)(4): the share of the beneficial interest of the trust or unincorporated enterprise owned by p, determined under the section 267(c) constructive ownership rules (case input)";
}
rule TwentyPercentPartnershipOwnerOfSubstantialContributor(p: Person, f: Person, ent: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(C)(ii): more than 20 percent of the profits interest of a partnership that is itself a substantial contributor to f";
    when constructive_profits_interest_share(p, ent, share);
    when share > 0.20;
    when substantial_contributor(ent, f);
    then twenty_percent_corporate_owner_of_substantial_contributor(p, f);
}
rule TwentyPercentTrustOwnerOfSubstantialContributor(p: Person, f: Person, ent: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(C)(iii): more than 20 percent of the beneficial interest of a trust or unincorporated enterprise that is itself a substantial contributor to f";
    when constructive_beneficial_interest_share(p, ent, share);
    when share > 0.20;
    when substantial_contributor(ent, f);
    then twenty_percent_corporate_owner_of_substantial_contributor(p, f);
}

@source(IRC_S4946_A, coverage = partial, quote = "(E) a corporation of which persons described in subparagraph (A), (B), (C), or (D) own more than 35 percent of the total combined voting power,")
pub relation abcd_persons_combined_voting_power_share(ent: Person, f: Person, share: Decimal) kind empirical {
    label en unofficial "section 4946(a)(1)(E): the combined voting power of the corporation owned by persons described in (A)-(D) with respect to f (aggregate, case input)";
}
@source(IRC_S4946_A, coverage = partial, quote = "(F) a partnership in which persons described in subparagraph (A), (B), (C), or (D) own more than 35 percent of the profits interest,")
pub relation abcd_persons_combined_profits_interest_share(ent: Person, f: Person, share: Decimal) kind empirical {
    label en unofficial "section 4946(a)(1)(F): the profits interest of the partnership owned by persons described in (A)-(D) with respect to f (aggregate, case input)";
}
@source(IRC_S4946_A, coverage = partial, quote = "(G) a trust or estate in which persons described in subparagraph (A), (B), (C), or (D) hold more than 35 percent of the beneficial interest,")
pub relation abcd_persons_combined_beneficial_interest_share(ent: Person, f: Person, share: Decimal) kind empirical {
    label en unofficial "section 4946(a)(1)(G): the beneficial interest of the trust or estate held by persons described in (A)-(D) with respect to f (aggregate, case input)";
}
rule DisqualifiedPersonThirtyFivePercentCorporation(e: Person, f: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(E): a corporation more than 35 percent of whose voting power is owned by persons described in (A)-(D)";
    when abcd_persons_combined_voting_power_share(e, f, share);
    when share > 0.35;
    then disqualified_person(e, f);
}
rule DisqualifiedPersonThirtyFivePercentPartnership(e: Person, f: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(F): a partnership more than 35 percent of whose profits interest is owned by persons described in (A)-(D)";
    when abcd_persons_combined_profits_interest_share(e, f, share);
    when share > 0.35;
    then disqualified_person(e, f);
}
rule DisqualifiedPersonThirtyFivePercentTrustOrEstate(e: Person, f: Person, share: Decimal) defeasible {
    label en official "section 4946(a)(1)(G): a trust or estate more than 35 percent of whose beneficial interest is held by persons described in (A)-(D)";
    when abcd_persons_combined_beneficial_interest_share(e, f, share);
    when share > 0.35;
    then disqualified_person(e, f);
}

// (H): a private foundation that is a disqualified person only for section 4943.

@source(IRC_S4946_A, coverage = partial, quote = "which is effectively controlled (directly or indirectly) by the same person or persons who control the private foundation in question")
external judgment relation effectively_controlled_by_same_persons_as(other: Person, f: Person) {
    authority TaxCourt;
    label en official "section 4946(a)(1)(H)(i): the other private foundation is effectively controlled (directly or indirectly) by the same person or persons who control the foundation in question";
}
@source(IRC_S4946_A, coverage = partial, quote = "substantially all of the contributions to which were made (directly or indirectly) by the same person or persons described in subparagraph (A), (B), or (C)")
external judgment relation substantially_all_contributions_by_same_persons_as(other: Person, f: Person) {
    authority TaxCourt;
    label en official "section 4946(a)(1)(H)(ii): substantially all of the contributions to the other foundation were made by the same persons (or their families) who made substantially all of the contributions to the foundation in question";
}
@source(IRC_S4946_A, coverage = partial, quote = "(H) only for purposes of section 4943, a private foundation")
pub relation disqualified_person_for_4943(p: Person, f: Person) kind institutional {
    label en official "section 4946(a)(1): p is a disqualified person with respect to f for section 4943, including (H) a related private foundation (only for section 4943)";
}
rule DisqualifiedFor4943Ordinary(p: Person, f: Person) defeasible {
    label en official "section 4946(a)(1)(A)-(G): an ordinary disqualified person is disqualified for section 4943";
    when disqualified_person(p, f);
    then disqualified_person_for_4943(p, f);
}
rule DisqualifiedFor4943ControlledFoundation(p: Person, f: Person, y: TaxableYear) defeasible {
    label en official "section 4946(a)(1)(H)(i): a private foundation effectively controlled by the same persons who control the foundation in question";
    when us.irc.exempt_organizations::private_foundation(p, y);
    when effectively_controlled_by_same_persons_as(p, f);
    then disqualified_person_for_4943(p, f);
}
rule DisqualifiedFor4943CommonContributors(p: Person, f: Person, y: TaxableYear) defeasible {
    label en official "section 4946(a)(1)(H)(ii): a private foundation substantially all of whose contributions came from the same persons as those of the foundation in question";
    when us.irc.exempt_organizations::private_foundation(p, y);
    when substantially_all_contributions_by_same_persons_as(p, f);
    then disqualified_person_for_4943(p, f);
}

// (b)(2): employees having authority or responsibility with respect to an act.

@source(IRC_S4946_B, coverage = partial, quote = "the employees of the foundation having authority or responsibility with respect to such act")
pub relation employee_with_authority_over_act(p: Person, f: Person, a: ExciseAct) kind empirical {
    label en unofficial "section 4946(b)(2): p is an employee of f having authority or responsibility with respect to the act (or failure to act) a";
}
@source(IRC_S4946_B, coverage = partial, quote = "For purposes of this subchapter, the term \"foundation manager\" means, with respect to any private foundation")
pub relation foundation_manager_for_act(p: Person, f: Person, a: ExciseAct) kind institutional {
    label en official "section 4946(b): p is a foundation manager of f with respect to the act a: an officer, director or trustee ((b)(1)), or an employee having authority or responsibility with respect to the act ((b)(2))";
}
rule FoundationManagerForActOfficer(p: Person, f: Person, a: ExciseAct) defeasible {
    label en official "section 4946(b)(1): an officer, director or trustee is a foundation manager for every act of the foundation";
    when foundation_manager(p, f);
    when excise_act_kind(a, _);
    then foundation_manager_for_act(p, f, a);
}
rule FoundationManagerForActEmployee(p: Person, f: Person, a: ExciseAct) defeasible {
    label en official "section 4946(b)(2): an employee having authority or responsibility with respect to the act is a foundation manager for that act";
    when employee_with_authority_over_act(p, f, a);
    then foundation_manager_for_act(p, f, a);
}
