// Section 5000A — requirement to maintain minimum essential coverage (individual
// shared responsibility). Stage 2 (DECISION-0379).
//
//  - (a) is a DUTY of every applicable individual: for each month beginning after
//    2013 ensure that the individual and any dependent who is an applicable
//    individual is covered under minimum essential coverage;
//  - (b)(1) the penalty, (b)(2) inclusion with the return (a duty), (b)(3) the
//    persons liable (the taxpayer for a dependent; a joint filer and the spouse);
//  - (c) the amount: the lesser of the sum of the monthly amounts and the national
//    average bronze premium; each month 1/12 of the greater of the flat dollar
//    amount (capped at 300 percent) and the percentage of household income over the
//    filing threshold;
//  - (d)-(f) applicable individual, exemptions and minimum essential coverage;
//  - (g) administration: payment on notice and demand (a duty) and two IMMUNITIES
//    (no criminal prosecution for nonpayment; no notice of lien or levy).
//
// TEMPORAL LIMITS. The applicable dollar amount and the income percentage are A3
// parameters with values pinned for 2014 and 2015 and for months after 2018 ($0 and
// 0 percent, the pinned 2024 text as amended by Pub. L. 115-97 section 11081). No
// value is pinned for 2016-2018: the pinned edition does not carry the earlier text
// (SOURCE_GAP). The parameters are read at the legal time of the question, which
// must fall in the taxable year asked about (G2522). The affordability percentage
// of (e)(1)(D) is indexed by HHS after 2014 (not pinned, SOURCE_GAP). A month is
// the integer year*100+month; its dates come from an anchor date in the month.
//
// PL 119-21 section 71301 (AMENDMENTS.json maps it heuristically to 5000A) amends
// section 36B(e); it does not change the text of section 5000A.

// ============================================================================
// (d), (f): applicable individual and minimum essential coverage
// ============================================================================

use self::{
    IRC_S5000A_A,
    IRC_S5000A_B,
    IRC_S5000A_C,
    IRC_S5000A_D,
    IRC_S5000A_F,
    IRC_S5000A_G,
    Person,
    TaxableYear,
    religious_exemption_effective_5000Ad2A,
};

pub relation month_anchor_date(ym: Integer, on: Date) kind empirical {
    label en unofficial "a date inside the month ym (its first and last days are month_start_of / month_end_of of it)";
}
pub relation religious_exemption_in_effect(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(d)(2)(A): an exemption under ACA section 1311(d)(4)(H) certifying membership in a recognized religious sect (1402(g)(1)) or reliance solely on a religious method of healing, with the attestation for (i)(II)";
}
pub relation health_care_sharing_ministry_member(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(d)(2)(B): a member of a health care sharing ministry (501(c)(3), shared beliefs, continuous since December 31, 1999, annual independent audit)";
}
pub relation not_citizen_national_or_lawfully_present(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(d)(3): the individual is not a citizen or national of the United States or an alien lawfully present in the United States for the month";
}
pub relation incarcerated_not_pending_disposition(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(d)(4): the individual is incarcerated for the month, other than incarceration pending the disposition of charges";
}
@source(IRC_S5000A_D, coverage = exact, quote = "The term \"applicable individual\" means, with respect to any month, an individual other than an individual described in paragraph (2), (3), or (4).")
pub relation applicable_individual_5000A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(d): an individual for the month other than one with a religious exemption or in a health care sharing ministry, not lawfully present, or incarcerated";
}
rule ApplicableIndividual5000A(p: Person, ym: Integer) defeasible {
    label en official "section 5000A(d)(1)-(4)";
    when month_of_individual(p, ym);
    unless religious_exemption_in_effect(p, ym) and month_of_individual(p, ym);
    unless religious_exemption_effective_5000Ad2A(p, ym) and month_of_individual(p, ym);
    unless health_care_sharing_ministry_member(p, ym) and month_of_individual(p, ym);
    unless not_citizen_national_or_lawfully_present(p, ym) and month_of_individual(p, ym);
    unless incarcerated_not_pending_disposition(p, ym) and month_of_individual(p, ym);
    then applicable_individual_5000A(p, ym);
}
pub relation month_of_individual(p: Person, ym: Integer) kind empirical {
    label en unofficial "the individual and month under consideration (binds the month of the rules of this module)";
}
enum MinimumEssentialCoverageKind {
    MedicareA;
    Medicaid;
    Chip;
    Tricare;
    VeteransProgram;
    PeaceCorps;
    NonappropriatedFundProgram;
    EligibleEmployerSponsoredPlan;
    IndividualMarketPlan;
    GrandfatheredPlan;
    OtherRecognizedCoverage;
}
pub relation covered_by_coverage_kind(p: Person, ym: Integer, k: MinimumEssentialCoverageKind) kind empirical {
    label en official "section 5000A(f)(1): coverage of one of the listed kinds for the month";
}
pub relation coverage_only_excepted_benefits(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(f)(3): the coverage consists only of excepted benefits (section 2791(c)(1) of the PHSA, or (c)(2)-(4) under a separate policy)";
}
pub relation resides_abroad_or_possession_resident(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(f)(4): the month occurs during a period under section 911(d)(1)(A)-(B) applicable to the individual, or the individual is a bona fide resident of a possession (937(a))";
}
@source(IRC_S5000A_F, coverage = exact, quote = "The term \"minimum essential coverage\" means any of the following:")
pub relation covered_under_minimum_essential_coverage(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(f): covered by a listed kind of coverage (not merely excepted benefits) or treated as covered under (f)(4)";
}
rule CoveredByListedKind(p: Person, ym: Integer, k: MinimumEssentialCoverageKind) defeasible {
    label en official "section 5000A(f)(1)-(2)";
    when covered_by_coverage_kind(p, ym, k);
    unless coverage_only_excepted_benefits(p, ym) and covered_by_coverage_kind(p, ym, k);
    then covered_under_minimum_essential_coverage(p, ym);
}
rule TreatedAsCoveredAbroad(p: Person, ym: Integer) defeasible {
    label en official "section 5000A(f)(4): residents abroad and residents of possessions are treated as having minimum essential coverage";
    when month_of_individual(p, ym);
    when resides_abroad_or_possession_resident(p, ym);
    then covered_under_minimum_essential_coverage(p, ym);
}

// ============================================================================
// (a): the duty
// ============================================================================

@source(IRC_S5000A_A, coverage = exact, quote = "An applicable individual shall for each month beginning after 2013 ensure that the individual, and any dependent of the individual who is an applicable individual, is covered under minimum essential coverage for such month.")
rule S5000AMaintainCoverageDutyRule(p: Person, ym: Integer, d: Date) defeasible {
    label en official "section 5000A(a): an applicable individual shall for each month beginning after 2013 ensure that the individual is covered under minimum essential coverage — VIOLATED when the negation of coverage is asserted";
    when applicable_individual_5000A(p, ym);
    when ym >= 201401;
    when month_anchor_date(ym, d);
    then duty S5000AMaintainMinimumEssentialCoverage {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition covered_under_minimum_essential_coverage(p, ym);
            window [month_start_of(d), month_end_of(d)];
        }
    };
}

// ============================================================================
// (e): exemptions
// ============================================================================

pub relation required_contribution_annual(p: Person, ym: Integer, amount: Money) kind empirical {
    label en official "section 5000A(e)(1)(B): the required contribution (self-only employer premium share, or the lowest cost bronze plan premium reduced by the section 36B credit) on an annual basis";
}
pub relation household_income_for_exemption(p: Person, ym: Integer, amount: Money) kind empirical {
    label en official "section 5000A(e)(1)(A), (e)(2): the household income for the taxable year (increased by any salary-reduction exclusion of the required contribution for (e)(1))";
}
pub relation filing_threshold_gross_income(p: Person, ym: Integer, amount: Money) kind empirical {
    label en official "section 5000A(e)(2), (c)(2)(B): the amount of gross income specified in section 6012(a)(1) with respect to the taxpayer for the taxable year";
}
pub relation indian_tribe_member(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(e)(3): the individual is a member of an Indian tribe (section 45A(c)(6)) during the month";
}
pub relation hardship_determined(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(e)(5): the Secretary of Health and Human Services determined under section 1311(d)(4)(H) that the individual suffered a hardship with respect to obtaining coverage";
}
pub relation uncovered_gap_length_months(p: Person, ym: Integer, months: Integer) kind empirical {
    label en official "section 5000A(e)(4): the length in months of the continuous period without minimum essential coverage during which the month's last day falls (regardless of calendar years)";
}
pub relation first_short_gap_in_calendar_year(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(e)(4)(B)(iii): the gap is the first continuous period described in (A) covering months in the calendar year";
}
pub relation exempt_unaffordable_5000A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(e)(1): the required contribution exceeds 8 percent of household income";
}
rule ExemptUnaffordable(p: Person, ym: Integer, rc: Money, hi: Money) defeasible {
    label en official "section 5000A(e)(1)(A): required contribution above 8 percent (base value; indexed after 2014 — not pinned) of household income";
    when required_contribution_annual(p, ym, rc);
    when household_income_for_exemption(p, ym, hi);
    when rc > hi * AffordabilityShare5000A;
    then exempt_unaffordable_5000A(p, ym);
}
pub relation exempt_below_filing_threshold_5000A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(e)(2): household income below the section 6012(a)(1) gross income amount";
}
rule ExemptBelowFilingThreshold(p: Person, ym: Integer, hi: Money, th: Money) defeasible {
    label en official "section 5000A(e)(2)";
    when household_income_for_exemption(p, ym, hi);
    when filing_threshold_gross_income(p, ym, th);
    when hi < th;
    then exempt_below_filing_threshold_5000A(p, ym);
}
pub relation exempt_short_gap_5000A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(e)(4): a month whose last day falls in the first continuous period of less than 3 months without coverage in the calendar year";
}
rule ExemptShortGap(p: Person, ym: Integer, n: Integer) defeasible {
    label en official "section 5000A(e)(4)(A)-(B): gap shorter than 3 continuous months, first such gap in the calendar year";
    when uncovered_gap_length_months(p, ym, n);
    when n < ShortCoverageGapMonths5000A;
    when first_short_gap_in_calendar_year(p, ym);
    then exempt_short_gap_5000A(p, ym);
}
pub relation exempt_from_penalty_5000A(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(e): no penalty for the month (unaffordable coverage, income below the filing threshold, Indian tribe member, short coverage gap, hardship)";
}
rule ExemptFromPenaltyUnaffordable(p: Person, ym: Integer) defeasible { label en official "5000A(e)(1)"; when exempt_unaffordable_5000A(p, ym); then exempt_from_penalty_5000A(p, ym); }
rule ExemptFromPenaltyBelowThreshold(p: Person, ym: Integer) defeasible { label en official "5000A(e)(2)"; when exempt_below_filing_threshold_5000A(p, ym); then exempt_from_penalty_5000A(p, ym); }
rule ExemptFromPenaltyTribe(p: Person, ym: Integer) defeasible { label en official "5000A(e)(3)"; when indian_tribe_member(p, ym); then exempt_from_penalty_5000A(p, ym); }
rule ExemptFromPenaltyShortGap(p: Person, ym: Integer) defeasible { label en official "5000A(e)(4)"; when exempt_short_gap_5000A(p, ym); then exempt_from_penalty_5000A(p, ym); }
rule ExemptFromPenaltyHardship(p: Person, ym: Integer) defeasible { label en official "5000A(e)(5)"; when hardship_determined(p, ym); then exempt_from_penalty_5000A(p, ym); }

// ============================================================================
// (b), (c): the penalty
// ============================================================================

pub relation without_minimum_essential_coverage(p: Person, ym: Integer) kind empirical {
    label en official "section 5000A(b)(1): the individual fails to meet the requirement of (a) for the month (asserted: the individual was not covered under minimum essential coverage)";
}
@source(IRC_S5000A_B, coverage = exact, quote = "fails to meet the requirement of subsection (a) for 1 or more months, then, except as provided in subsection (e), there is hereby imposed on the taxpayer a penalty")
pub relation coverage_failure_month(p: Person, ym: Integer) kind institutional {
    label en official "section 5000A(b)(1): an applicable individual without coverage in a month for which no (e) exemption applies";
}
rule CoverageFailureMonth(p: Person, ym: Integer) defeasible {
    label en official "section 5000A(b)(1), (e)";
    when applicable_individual_5000A(p, ym);
    when without_minimum_essential_coverage(p, ym);
    when ym >= 201401;
    unless exempt_from_penalty_5000A(p, ym) and applicable_individual_5000A(p, ym) and without_minimum_essential_coverage(p, ym);
    then coverage_failure_month(p, ym);
}
pub relation taxpayer_for_individual(taxpayer: Person, p: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(b)(1), (b)(3): the taxpayer who is the individual, or for whom the individual is a dependent (152) for the taxable year including the month";
}
pub relation joint_return_spouse(p: Person, spouse: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(b)(3)(B): the individual files a joint return for the taxable year with the spouse";
}
pub relation liable_for_coverage_failure(taxpayer: Person, p: Person, ym: Integer, y: TaxableYear) kind institutional {
    label en official "section 5000A(b)(1), (3): the taxpayer (for a dependent, the other taxpayer; for joint filers, both spouses jointly) is liable for the penalty for the month";
}
rule LiableTaxpayerSelfOrDependent(taxpayer: Person, p: Person, ym: Integer, y: TaxableYear) defeasible {
    label en official "section 5000A(b)(1), (3)(A)";
    when coverage_failure_month(p, ym);
    when taxpayer_for_individual(taxpayer, p, y);
    then liable_for_coverage_failure(taxpayer, p, ym, y);
}
rule LiableJointFilerSpouse(taxpayer: Person, p: Person, ym: Integer, y: TaxableYear) defeasible {
    label en official "section 5000A(b)(3)(B): the individual and the spouse are jointly liable";
    when coverage_failure_month(p, ym);
    when joint_return_spouse(p, taxpayer, y);
    then liable_for_coverage_failure(taxpayer, p, ym, y);
}
pub relation failing_individuals_in_month(taxpayer: Person, y: TaxableYear, ym: Integer, adults: Integer, children_under_18: Integer) kind empirical {
    label en official "section 5000A(c)(2)(A)(i), (c)(3)(C): the number of individuals (18 or older / under 18 at the start of the month) with respect to whom a failure occurred in the month";
}
pub relation household_income_for_penalty(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 5000A(c)(4)(B)-(C): household income: modified adjusted gross income of the taxpayer plus that of other individuals in the family size who must file";
}
pub relation filing_threshold_for_penalty(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 5000A(c)(2)(B): the gross income amount specified in section 6012(a)(1) for the taxpayer for the taxable year";
}
pub relation flat_dollar_amount_5000A(taxpayer: Person, y: TaxableYear, ym: Integer, amount: Money) kind institutional {
    label en official "section 5000A(c)(2)(A): the lesser of the sum of the applicable dollar amounts (half for individuals under 18) and 300 percent of the applicable dollar amount";
}
rule FlatDollarAmount(taxpayer: Person, y: TaxableYear, ym: Integer, ad: Integer, ch: Integer) defeasible {
    label en official "section 5000A(c)(2)(A), (c)(3): min(adults × A + children × A/2, 3 × A); A is read at the legal time of the question (G2522)";
    when failing_individuals_in_month(taxpayer, y, ym, ad, ch);
    then flat_dollar_amount_5000A(taxpayer, y, ym, min(ApplicableDollarAmount5000A * ad + ApplicableDollarAmount5000A * ch * 0.5, ApplicableDollarAmount5000A * FlatAmountCapMultiple5000A));
}
pub relation percentage_amount_5000A(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 5000A(c)(2)(B): the percentage of the excess of household income over the filing threshold";
}
rule PercentageAmount(taxpayer: Person, y: TaxableYear, hi: Money, th: Money) defeasible {
    label en official "section 5000A(c)(2)(B): share × max(0, household income − threshold)";
    when household_income_for_penalty(taxpayer, y, hi);
    when filing_threshold_for_penalty(taxpayer, y, th);
    then percentage_amount_5000A(taxpayer, y, HouseholdIncomePenaltyShare5000A * max(hi - th, 0.00 USD));
}
pub relation monthly_penalty_amount_5000A(taxpayer: Person, y: TaxableYear, ym: Integer, amount: Money) kind institutional {
    label en official "section 5000A(c)(2): 1/12 of the greater of the flat dollar amount and the percentage amount for a month with a failure";
}
rule MonthlyPenaltyAmount(taxpayer: Person, y: TaxableYear, ym: Integer, flat: Money, pct: Money, p: Person) defeasible {
    label en official "section 5000A(c)(2): (greater of flat and percentage) ÷ 12, cents HALF_UP (JUDGMENT CALL: no rounding is named)";
    when liable_for_coverage_failure(taxpayer, p, ym, y);
    when flat_dollar_amount_5000A(taxpayer, y, ym, flat);
    when percentage_amount_5000A(taxpayer, y, pct);
    then monthly_penalty_amount_5000A(taxpayer, y, ym, div_round(max(flat, pct), 12.0, 2, "HALF_UP"));
}
pub relation national_average_bronze_premium(taxpayer: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 5000A(c)(1)(B): the national average premium for bronze level qualified health plans for the applicable family size offered through Exchanges for plan years beginning in the calendar year with or within which the taxable year ends";
}
@source(IRC_S5000A_C, coverage = exact, quote = "The amount of the penalty imposed by this section on any taxpayer for any taxable year with respect to failures described in subsection (b)(1) shall be equal to the lesser of—")
pub relation shared_responsibility_penalty(taxpayer: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 5000A(c)(1): the lesser of the sum of the monthly penalty amounts and the national average bronze premium (a monthly amount is counted for each month with one or more failures)";
}
rule SharedResponsibilityPenalty(taxpayer: Person, y: TaxableYear, cap: Money, m0: Integer) defeasible {
    label en official "section 5000A(c)(1): min(sum of monthly amounts, national average bronze premium) — the sum is an aggregate over a derived relation (G2514)";
    when national_average_bronze_premium(taxpayer, y, cap);
    when monthly_penalty_amount_5000A(taxpayer, y, m0, _);
    then shared_responsibility_penalty(taxpayer, y, min(sum(collect all a: Money, m: Integer where monthly_penalty_amount_5000A(taxpayer, y, m, a), empty: 0.00 USD), cap));
}
pub relation penalty_included_with_return(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(b)(2): the penalty is included with the taxpayer's return under chapter 1 for the taxable year including the month";
}
@source(IRC_S5000A_B, coverage = exact, quote = "Any penalty imposed by this section with respect to any month shall be included with a taxpayer's return under chapter 1 for the taxable year which includes such month.")
rule S5000AIncludeWithReturnDutyRule(taxpayer: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 5000A(b)(2): the penalty shall be included with the taxpayer's return for the taxable year";
    when shared_responsibility_penalty(taxpayer, y, amt);
    when amt > 0.00 USD;
    then duty S5000AIncludePenaltyWithReturn {
        bearer taxpayer;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition penalty_included_with_return(taxpayer, y);
            window [-infinity, infinity];
        }
    };
}

// ============================================================================
// (g): administration
// ============================================================================

pub relation notice_and_demand_for_5000A_on(taxpayer: Person, y: TaxableYear, on: Date) kind empirical {
    label en official "section 5000A(g)(1): the date of the Secretary's notice and demand for the penalty";
}
pub relation penalty_5000A_paid(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(g)(1): the penalty has been paid";
}
@source(IRC_S5000A_G, coverage = exact, quote = "The penalty provided by this section shall be paid upon notice and demand by the Secretary")
rule S5000APayUponNoticeDutyRule(taxpayer: Person, y: TaxableYear, amt: Money, demanded: Date) defeasible {
    label en official "section 5000A(g)(1): the penalty shall be paid upon notice and demand by the Secretary";
    when shared_responsibility_penalty(taxpayer, y, amt);
    when notice_and_demand_for_5000A_on(taxpayer, y, demanded);
    then duty S5000APayPenaltyOnDemand {
        bearer taxpayer;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition penalty_5000A_paid(taxpayer, y);
            window [demanded, infinity];
        }
    };
}
pub relation criminal_prosecution_for_nonpayment_5000A(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(g)(2)(A): a criminal prosecution or penalty is brought against the taxpayer for failing to timely pay the section 5000A penalty";
}
pub relation lien_or_levy_for_5000A_nonpayment(taxpayer: Person, y: TaxableYear) kind empirical {
    label en official "section 5000A(g)(2)(B): a notice of lien is filed against, or a levy made on, the taxpayer's property by reason of failure to pay the section 5000A penalty";
}
@source(IRC_S5000A_G, coverage = exact, quote = "In the case of any failure by a taxpayer to timely pay any penalty imposed by this section, such taxpayer shall not be subject to any criminal prosecution or penalty with respect to such failure.")
rule S5000ANoCriminalProsecutionImmunityRule(taxpayer: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 5000A(g)(2)(A): a taxpayer who fails to timely pay the penalty is not subject to criminal prosecution or penalty for that failure";
    when shared_responsibility_penalty(taxpayer, y, amt);
    then immunity S5000ANoCriminalProsecutionForNonpayment {
        holder taxpayer;
        against us.irc.core::IRS;
        protected_effect criminal_prosecution_for_nonpayment_5000A(taxpayer, y);
        window [-infinity, infinity];
    };
}
@source(IRC_S5000A_G, coverage = exact, quote = "file notice of lien with respect to any property of a taxpayer by reason of any failure to pay the penalty imposed by this section, or")
rule S5000ANoLienOrLevyImmunityRule(taxpayer: Person, y: TaxableYear, amt: Money) defeasible {
    label en official "section 5000A(g)(2)(B): the Secretary shall not file a notice of lien on, or levy on, the taxpayer's property by reason of a failure to pay the penalty";
    when shared_responsibility_penalty(taxpayer, y, amt);
    then immunity S5000ANoLienOrLevyForNonpayment {
        holder taxpayer;
        against us.irc.core::IRS;
        protected_effect lien_or_levy_for_5000A_nonpayment(taxpayer, y);
        window [-infinity, infinity];
    };
}
