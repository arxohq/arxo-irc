// Sections 4911 (tax on excess expenditures to influence legislation) and
// 4912 (tax on disqualifying lobbying expenditures of certain organizations).
// Stage 2 (DECISION-0379). Both are annual taxes on the ORGANIZATION (not the
// two-tier act shape of 01-excise-act-and-taxable-period.law), so the tax
// heads are their own relations keyed by (organization, taxable year).
//
// SCOPE
//  - 4911(a): 25 percent of excess lobbying expenditures of an organization with
//    a section 501(h) election in effect (the election itself is
//    `us.irc.exempt_organizations::section_501h_election_in_effect`).
//  - 4911(b): excess = the GREATER of the lobbying-limit excess and the
//    grass-roots-limit excess (`max` over two known scalars).
//  - 4911(c)(2): the lobbying nontaxable amount = lesser of $1,000,000 and the
//    statute's four-bracket table (thresholds, bases and rates are A3
//    parameters; the table has formulas, so it is rules, not a
//    decision table); 4911(c)(4): grass roots amount = 25 percent of it.
//  - 4911(d): "influencing legislation" classification of a communication with
//    the (d)(2) exceptions as `unless` and the (d)(3) member-communication
//    recharacterisation. The AMOUNTS (lobbying expenditures, exempt purpose
//    expenditures) stay case facts: summing the amounts over the derived set of
//    communications that influence legislation is an aggregate over a derived
//    relation (TECH-GAPS G2500).
//  - 4911(e)(1): exempt purpose expenditures as facts (the (B)/(C) inclusions
//    and exclusions are constraints on the asserted total, G2501).
//  - 4911(f): affiliated groups: definition of affiliation (f)(2) is a
//    classification; the group-as-one-organization computation and the
//    proportionate-share allocation are not modelled (G2502).
//  - 4912(a)/(b)/(c)/(d): 5 percent tax on the organization and, unless not
//    willful and due to reasonable cause, on a knowing organization manager;
//    applicability exceptions; joint and several liability.
//
// JUDGMENT CALL: where the statute names no rounding of a Money result the
// corpus convention is cents HALF_UP; the bracket products here are exact
// Decimal products and are not rounded (rates have at most two decimals and
// bases are whole dollars, so cents are exact for whole-dollar inputs).

// --- 4911(a): application and tax -----------------------------------------

use self::{
    IRC_S4911_A,
    IRC_S4911_B,
    IRC_S4911_C,
    IRC_S4911_D,
    IRC_S4911_E,
    IRC_S4911_F,
    IRC_S4911_TABLE_1,
    IRC_S4912_A,
    IRC_S4912_B,
    IRC_S4912_C,
    IRC_S4912_D,
    Person,
    TaxableYear,
    organization_manager,
};

@source(IRC_S4911_A, coverage = exact, quote = "This section applies to any organization with respect to which an election under section 501(h) (relating to lobbying expenditures by public charities) is in effect for the taxable year.")
pub relation section_4911_applies(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4911(a)(2): the organization has a section 501(h) election in effect for the taxable year, so the section 4911 tax applies";
}
@source(IRC_S4911_A, coverage = exact, quote = "This section applies to any organization with respect to which an election under section 501(h) (relating to lobbying expenditures by public charities) is in effect for the taxable year.")
rule Section4911AppliesWhen501hElectionInEffect(o: Person, y: TaxableYear) defeasible {
    label en official "section 4911(a)(2): an organization with a section 501(h) election in effect for the year is an organization to which section 4911 applies";
    when us.irc.exempt_organizations::section_501h_election_in_effect(o, y);
    then section_4911_applies(o, y);
}

@source(IRC_S4911_E, coverage = partial, quote = "The term \"exempt purpose expenditures\" means, with respect to any organization for any taxable year, the total of the amounts paid or incurred by such organization to accomplish purposes described in section 170(c)(2)(B) (relating to religious, charitable, educational, etc., purposes).")
pub relation exempt_purpose_expenditures(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4911(e)(1): total of the amounts paid or incurred in the year to accomplish section 170(c)(2)(B) purposes, including administrative expenses and lobbying amounts and excluding separate fundraising unit amounts (the (B)/(C) inclusions are constraints on the asserted total — G2501)";
}
@source(IRC_S4911_C, coverage = exact, quote = "The term \"lobbying expenditures\" means expenditures for the purpose of influencing legislation (as defined in subsection (d)).")
pub relation lobbying_expenditures_4911(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4911(c)(1): expenditures for the purpose of influencing legislation (the amount is asserted; the classification of each communication is section 4911(d) below, G2500)";
}
@source(IRC_S4911_C, coverage = exact, quote = "The term \"grass roots expenditures\" means expenditures for the purpose of influencing legislation (as defined in subsection (d) without regard to paragraph (1)(B) thereof).")
pub relation grass_roots_expenditures_4911(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4911(c)(3): expenditures for the purpose of influencing legislation counted without regard to the (d)(1)(B) direct-lobbying limb";
}

// --- 4911(c)(2): lobbying nontaxable amount ---------------------------------

@source(IRC_S4911_C, coverage = exact, quote = "The lobbying nontaxable amount for any organization for any taxable year is the lesser of (A) $1,000,000 or (B) the amount determined under the following table:")
pub relation lobbying_nontaxable_amount_table(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(c)(2)(B): the amount determined under the table from the exempt purpose expenditures";
}
@source(IRC_S4911_TABLE_1, coverage = exact, quote = "Not over $500,000 / 20 percent of the exempt purpose expenditures.")
rule LobbyingTableBracket1(o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4911(c)(2) table, row 1: exempt purpose expenditures not over $500,000 give 20 percent of them";
    when exempt_purpose_expenditures(o, y, x);
    when x <= LobbyingTableBracket1Top;
    then lobbying_nontaxable_amount_table(o, y, x * LobbyingTableBracket1Rate);
}
@source(IRC_S4911_TABLE_1, coverage = exact, quote = "Over $500,000 but not over $1,000,000 / $100,000, plus 15 percent of the excess of the exempt purpose expenditures over $500,000.")
rule LobbyingTableBracket2(o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4911(c)(2) table, row 2: over $500,000 but not over $1,000,000 give $100,000 plus 15 percent of the excess over $500,000";
    when exempt_purpose_expenditures(o, y, x);
    when x > LobbyingTableBracket1Top;
    when x <= LobbyingTableBracket2Top;
    then lobbying_nontaxable_amount_table(o, y, LobbyingTableBracket2Base + (x - LobbyingTableBracket1Top) * LobbyingTableBracket2Rate);
}
@source(IRC_S4911_TABLE_1, coverage = exact, quote = "Over $1,000,000 but not over $1,500,000 / $175,000 plus 10 percent of the excess of the exempt purpose expenditures over $1,000,000.")
rule LobbyingTableBracket3(o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4911(c)(2) table, row 3: over $1,000,000 but not over $1,500,000 give $175,000 plus 10 percent of the excess over $1,000,000";
    when exempt_purpose_expenditures(o, y, x);
    when x > LobbyingTableBracket2Top;
    when x <= LobbyingTableBracket3Top;
    then lobbying_nontaxable_amount_table(o, y, LobbyingTableBracket3Base + (x - LobbyingTableBracket2Top) * LobbyingTableBracket3Rate);
}
@source(IRC_S4911_TABLE_1, coverage = exact, quote = "Over $1,500,000 / $225,000 plus 5 percent of the excess of the exempt purpose expenditures over $1,500,000.")
rule LobbyingTableBracket4(o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4911(c)(2) table, row 4: over $1,500,000 give $225,000 plus 5 percent of the excess over $1,500,000";
    when exempt_purpose_expenditures(o, y, x);
    when x > LobbyingTableBracket3Top;
    then lobbying_nontaxable_amount_table(o, y, LobbyingTableBracket4Base + (x - LobbyingTableBracket3Top) * LobbyingTableBracket4Rate);
}

@source(IRC_S4911_C, coverage = exact, quote = "The lobbying nontaxable amount for any organization for any taxable year is the lesser of (A) $1,000,000 or (B) the amount determined under the following table:")
pub relation lobbying_nontaxable_amount(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(c)(2): the lesser of $1,000,000 and the table amount";
}
rule LobbyingNontaxableAmountIsLesserOfCapAndTable(o: Person, y: TaxableYear, t: Money) defeasible {
    label en official "section 4911(c)(2): lesser of $1,000,000 and the table amount";
    when lobbying_nontaxable_amount_table(o, y, t);
    then lobbying_nontaxable_amount(o, y, min(LobbyingNontaxableAmountCap, t));
}

@source(IRC_S4911_C, coverage = exact, quote = "The grass roots nontaxable amount for any organization for any taxable year is 25 percent of the lobbying nontaxable amount (determined under paragraph (2)) for such organization for such taxable year.")
pub relation grass_roots_nontaxable_amount(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(c)(4): 25 percent of the lobbying nontaxable amount";
}
rule GrassRootsNontaxableAmount(o: Person, y: TaxableYear, l: Money) defeasible {
    label en official "section 4911(c)(4): the grass roots nontaxable amount is 25 percent of the lobbying nontaxable amount";
    when lobbying_nontaxable_amount(o, y, l);
    then grass_roots_nontaxable_amount(o, y, l * GrassRootsNontaxableShare);
}

// --- 4911(b): excess lobbying expenditures ----------------------------------

@source(IRC_S4911_B, coverage = exact, quote = "the greater of—")
pub relation excess_lobbying_expenditures(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(b): the greater of the lobbying excess over the lobbying nontaxable amount and the grass roots excess over the grass roots nontaxable amount";
}
@source(IRC_S4911_B, coverage = exact, quote = "the amount by which the lobbying expenditures made by the organization during the taxable year exceed the lobbying nontaxable amount for such organization for such taxable year")
rule ExcessLobbyingExpenditures(o: Person, y: TaxableYear, l: Money, ln: Money, g: Money, gn: Money) defeasible {
    label en official "section 4911(b): excess lobbying expenditures are the greater of the two excesses; nothing is due when neither limit is exceeded";
    when section_4911_applies(o, y);
    when lobbying_expenditures_4911(o, y, l);
    when lobbying_nontaxable_amount(o, y, ln);
    when grass_roots_expenditures_4911(o, y, g);
    when grass_roots_nontaxable_amount(o, y, gn);
    when max(l - ln, g - gn) > 0.00 USD;
    then excess_lobbying_expenditures(o, y, max(l - ln, g - gn));
}

@source(IRC_S4911_A, coverage = exact, quote = "There is hereby imposed on the excess lobbying expenditures of any organization to which this section applies a tax equal to 25 percent of the amount of the excess lobbying expenditures for the taxable year.")
pub relation excess_lobbying_tax(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4911(a)(1): tax of 25 percent of the excess lobbying expenditures, owed by the organization";
}
rule ExcessLobbyingTax(o: Person, y: TaxableYear, e: Money) defeasible {
    label en official "section 4911(a)(1): 25 percent of the excess lobbying expenditures for the taxable year";
    when section_4911_applies(o, y);
    when excess_lobbying_expenditures(o, y, e);
    then excess_lobbying_tax(o, y, e * ExcessLobbyingTaxRate);
}

// --- 4911(d): influencing legislation ----------------------------------------

entity LobbyingCommunication { label en unofficial "a communication or other attempt that may be an attempt to influence legislation (section 4911(d))"; }

pub relation communication_by(c: LobbyingCommunication, o: Person) kind empirical {
    label en unofficial "the organization that made the communication";
}
@source(IRC_S4911_D, coverage = exact, quote = "any attempt to influence any legislation through an attempt to affect the opinions of the general public or any segment thereof")
pub relation attempts_to_affect_opinions_of_public(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(1)(A): the communication is an attempt to influence legislation through an attempt to affect the opinions of the general public or a segment of it";
}
@source(IRC_S4911_D, coverage = exact, quote = "any attempt to influence any legislation through communication with any member or employee of a legislative body, or with any government official or employee who may participate in the formulation of the legislation")
pub relation communicates_with_legislator_or_participating_official(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(1)(B): the communication is with a member or employee of a legislative body, or a government official or employee who may participate in formulating the legislation, in an attempt to influence legislation";
}
@source(IRC_S4911_D, coverage = exact, quote = "making available the results of nonpartisan analysis, study, or research")
pub relation is_nonpartisan_analysis(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(2)(A): making available the results of nonpartisan analysis, study, or research";
}
@source(IRC_S4911_D, coverage = exact, quote = "providing of technical advice or assistance (where such advice would otherwise constitute the influencing of legislation) to a governmental body or to a committee or other subdivision thereof in response to a written request by such body or subdivision, as the case may be")
pub relation is_technical_advice_on_written_request(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(2)(B): technical advice or assistance to a governmental body in response to its written request";
}
@source(IRC_S4911_D, coverage = exact, quote = "appearances before, or communications to, any legislative body with respect to a possible decision of such body which might affect the existence of the organization, its powers and duties, tax-exempt status, or the deduction of contributions to the organization")
pub relation is_self_defense_communication(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(2)(C): appearance or communication concerning a decision that might affect the organization's existence, powers and duties, tax-exempt status, or deductibility of contributions";
}
@source(IRC_S4911_D, coverage = exact, quote = "communications between the organization and its bona fide members with respect to legislation or proposed legislation of direct interest to the organization and such members, other than communications described in paragraph (3)")
pub relation is_communication_with_bona_fide_members(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(2)(D): communication between the organization and its bona fide members about legislation of direct interest to both";
}
@source(IRC_S4911_D, coverage = exact, quote = "A communication between an organization and any bona fide member of such organization to directly encourage such member to communicate as provided in paragraph (1)(B) shall be treated as a communication described in paragraph (1)(B)")
pub relation encourages_member_to_lobby_legislators(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(3)(A): a member communication that directly encourages the member to communicate as in (d)(1)(B)";
}
@source(IRC_S4911_D, coverage = exact, quote = "to directly encourage such member to urge persons other than members to communicate as provided in either subparagraph (A) or subparagraph (B) of paragraph (1) shall be treated as a communication described in paragraph (1)(A)")
pub relation encourages_member_to_urge_nonmembers(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(3)(B): a member communication that directly encourages the member to urge non-members to communicate as in (d)(1)(A) or (B)";
}
@source(IRC_S4911_D, coverage = partial, quote = "any communication with a governmental official or employee, other than—")
pub relation is_official_communication_not_lobbying(c: LobbyingCommunication) kind empirical {
    label en official "section 4911(d)(2)(E): a communication with a governmental official or employee that is neither a communication with a member or employee of a legislative body that would otherwise influence legislation nor one whose principal purpose is to influence legislation";
}

@source(IRC_S4911_D, coverage = exact, quote = "the term \"influencing legislation\" means—")
pub relation influencing_legislation(c: LobbyingCommunication) kind institutional {
    label en official "section 4911(d): the communication is influencing legislation";
}
@source(IRC_S4911_D, coverage = exact, quote = "any attempt to influence any legislation through an attempt to affect the opinions of the general public or any segment thereof")
rule InfluencingLegislationPublic(c: LobbyingCommunication) defeasible {
    label en official "section 4911(d)(1)(A): an attempt to influence legislation through the opinions of the public is influencing legislation, unless a (d)(2) exception applies";
    when attempts_to_affect_opinions_of_public(c);
    unless is_nonpartisan_analysis(c) and attempts_to_affect_opinions_of_public(c);
    unless is_technical_advice_on_written_request(c) and attempts_to_affect_opinions_of_public(c);
    unless is_self_defense_communication(c) and attempts_to_affect_opinions_of_public(c);
    unless is_communication_with_bona_fide_members(c) and attempts_to_affect_opinions_of_public(c);
    then influencing_legislation(c);
}
@source(IRC_S4911_D, coverage = exact, quote = "any attempt to influence any legislation through communication with any member or employee of a legislative body, or with any government official or employee who may participate in the formulation of the legislation")
rule InfluencingLegislationDirect(c: LobbyingCommunication) defeasible {
    label en official "section 4911(d)(1)(B): communication with a legislator or participating official is influencing legislation, unless a (d)(2) exception applies";
    when communicates_with_legislator_or_participating_official(c);
    unless is_nonpartisan_analysis(c) and communicates_with_legislator_or_participating_official(c);
    unless is_technical_advice_on_written_request(c) and communicates_with_legislator_or_participating_official(c);
    unless is_self_defense_communication(c) and communicates_with_legislator_or_participating_official(c);
    unless is_communication_with_bona_fide_members(c) and communicates_with_legislator_or_participating_official(c);
    then influencing_legislation(c);
}
@source(IRC_S4911_D, coverage = exact, quote = "A communication between an organization and any bona fide member of such organization to directly encourage such member to communicate as provided in paragraph (1)(B) shall be treated as a communication described in paragraph (1)(B)")
rule InfluencingLegislationMemberEncouragementDirect(c: LobbyingCommunication) defeasible {
    label en official "section 4911(d)(3)(A): encouraging a bona fide member to lobby legislators is treated as a (d)(1)(B) communication and is not excepted by (d)(2)(D)";
    when encourages_member_to_lobby_legislators(c);
    then influencing_legislation(c);
}
@source(IRC_S4911_D, coverage = exact, quote = "to directly encourage such member to urge persons other than members to communicate as provided in either subparagraph (A) or subparagraph (B) of paragraph (1) shall be treated as a communication described in paragraph (1)(A)")
rule InfluencingLegislationMemberEncouragementPublic(c: LobbyingCommunication) defeasible {
    label en official "section 4911(d)(3)(B): encouraging a member to urge non-members to communicate is treated as a (d)(1)(A) communication";
    when encourages_member_to_urge_nonmembers(c);
    then influencing_legislation(c);
}

// --- 4911(f)(2): affiliation ---------------------------------------------------

@source(IRC_S4911_F, coverage = exact, quote = "the governing instrument of one such organization requires it to be bound by decisions of the other organization on legislative issues")
pub relation governing_instrument_binds_on_legislative_issues(bound: Person, other: Person) kind empirical {
    label en official "section 4911(f)(2)(A): the governing instrument of `bound` requires it to be bound by decisions of `other` on legislative issues";
}
@source(IRC_S4911_F, coverage = exact, quote = "by aggregating their votes, have sufficient voting power to cause or prevent action on legislative issues by the first such organization")
pub relation governing_board_representatives_control_legislative_issues(first: Person, other: Person) kind empirical {
    label en official "section 4911(f)(2)(B): the governing board of `first` includes designated representatives, members, officers, or paid executive staff of `other` who by aggregating their votes can cause or prevent action on legislative issues";
}
@source(IRC_S4911_F, coverage = exact, quote = "two organizations are members of an affiliated group of organizations but only if—")
pub relation affiliated_for_4911f(a: Person, b: Person) kind institutional {
    label en official "section 4911(f)(2): two organizations are members of an affiliated group only if (A) or (B) holds";
}
rule AffiliatedByGoverningInstrument(a: Person, b: Person) defeasible {
    label en official "section 4911(f)(2)(A): affiliation by governing instrument";
    when governing_instrument_binds_on_legislative_issues(a, b);
    then affiliated_for_4911f(a, b);
}
rule AffiliatedByGoverningBoard(a: Person, b: Person) defeasible {
    label en official "section 4911(f)(2)(B): affiliation by board control of legislative issues";
    when governing_board_representatives_control_legislative_issues(a, b);
    then affiliated_for_4911f(a, b);
}

// --- 4912: tax on disqualifying lobbying expenditures ----------------------------

@source(IRC_S4912_D, coverage = exact, quote = "The term \"lobbying expenditure\" means any amount paid or incurred by the organization in carrying on propaganda, or otherwise attempting to influence legislation.")
pub relation lobbying_expenditures_4912(o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en official "section 4912(d)(1): the amount paid or incurred by the organization in carrying on propaganda, or otherwise attempting to influence legislation, in the taxable year";
}
@source(IRC_S4912_C, coverage = exact, quote = "this section shall apply to any organization which was exempt (or was determined by the Secretary to be exempt) from taxation under section 501(a) by reason of being an organization described in section 501(c)(3).")
pub relation section_501c3_exempt_organization(o: Person, y: TaxableYear) kind empirical {
    label en official "section 4912(c)(1): the organization was exempt, or determined by the Secretary to be exempt, under section 501(a) as a section 501(c)(3) organization";
}
@source(IRC_S4912_A, coverage = exact, quote = "is not described in section 501(c)(3) for any taxable year by reason of making lobbying expenditures")
pub relation not_501c3_by_reason_of_lobbying(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4912(a): the organization is not described in section 501(c)(3) for the taxable year by reason of making lobbying expenditures";
}
@source(IRC_S4912_C, coverage = exact, quote = "This section shall not apply to any organization—")
pub relation section_4912_applies(o: Person, y: TaxableYear) kind institutional {
    label en official "section 4912(c): the section applies to an organization exempt as a 501(c)(3) organization, except one with a 501(h) election, a disqualified organization under 501(h)(5), or a private foundation";
}
rule Section4912AppliesToExempt501c3(o: Person, y: TaxableYear) defeasible {
    label en official "section 4912(c)(1)/(2): applies to a 501(c)(3) organization other than (A) an electing organization, (B) a disqualified organization, (C) a private foundation";
    when section_501c3_exempt_organization(o, y);
    unless us.irc.exempt_organizations::section_501h_election_in_effect(o, y) and section_501c3_exempt_organization(o, y);
    unless us.irc.exempt_organizations::disqualified_organization_501h5(o) and section_501c3_exempt_organization(o, y);
    unless us.irc.exempt_organizations::private_foundation(o, y) and section_501c3_exempt_organization(o, y);
    then section_4912_applies(o, y);
}

@source(IRC_S4912_A, coverage = exact, quote = "there is hereby imposed a tax on the lobbying expenditures of such organization for such taxable year equal to 5 percent of the amount of such expenditures. The tax imposed by this subsection shall be paid by the organization.")
pub relation lobbying_organization_tax(o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4912(a): 5 percent of the lobbying expenditures, paid by the organization";
}
rule LobbyingOrganizationTax(o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4912(a): 5 percent of the lobbying expenditures of an organization not described in section 501(c)(3) by reason of them";
    when section_4912_applies(o, y);
    when not_501c3_by_reason_of_lobbying(o, y);
    when lobbying_expenditures_4912(o, y, x);
    then lobbying_organization_tax(o, y, x * LobbyingOrganizationTaxRate);
}

@source(IRC_S4912_B, coverage = exact, quote = "knowing that such expenditures are likely to result in the organization not being described in section 501(c)(3)")
external judgment relation manager_knew_lobbying_likely_to_disqualify(p: Person, o: Person, y: TaxableYear) {
    authority TaxCourt;
    label en official "section 4912(b): the organization manager agreed to the expenditures knowing that they are likely to result in the organization not being described in section 501(c)(3)";
}
@source(IRC_S4912_B, coverage = exact, quote = "unless such agreement is not willful and is due to reasonable cause")
external judgment relation manager_lobbying_agreement_not_willful_and_reasonable_cause(p: Person, o: Person, y: TaxableYear) {
    authority TaxCourt;
    label en official "section 4912(b): the manager's agreement was not willful and was due to reasonable cause";
}
pub relation amount_manager_agreed_to_lobbying(p: Person, o: Person, y: TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of the lobbying expenditures to whose making the manager agreed";
}
@source(IRC_S4912_B, coverage = exact, quote = "there is hereby imposed on the agreement of any organization manager to the making of any such expenditures, knowing that such expenditures are likely to result in the organization not being described in section 501(c)(3), a tax equal to 5 percent of the amount of such expenditures")
pub relation lobbying_manager_tax(p: Person, o: Person, y: TaxableYear, amount: Money) kind institutional {
    label en official "section 4912(b): 5 percent of the expenditures, on a knowing organization manager, unless not willful and due to reasonable cause";
}
rule LobbyingManagerTax(p: Person, o: Person, y: TaxableYear, x: Money) defeasible {
    label en official "section 4912(b): if the organization is taxed under (a), a knowing organization manager who agreed to the expenditures owes 5 percent, unless not willful and due to reasonable cause";
    when lobbying_organization_tax(o, y, _);
    when organization_manager(p, o);
    when amount_manager_agreed_to_lobbying(p, o, y, x);
    when manager_knew_lobbying_likely_to_disqualify(p, o, y);
    unless manager_lobbying_agreement_not_willful_and_reasonable_cause(p, o, y) and organization_manager(p, o) and amount_manager_agreed_to_lobbying(p, o, y, x);
    then lobbying_manager_tax(p, o, y, x * LobbyingManagerTaxRate);
}
@source(IRC_S4912_D, coverage = exact, quote = "If more than 1 person is liable under subsection (b), all such persons shall be jointly and severally liable under such subsection.")
pub relation lobbying_manager_jointly_and_severally_liable(p1: Person, p2: Person, o: Person, y: TaxableYear) kind institutional {
    label en official "section 4912(d)(3): two managers liable under (b) for the organization's lobbying expenditures are jointly and severally liable";
}
rule LobbyingManagersJointAndSeveral(p1: Person, p2: Person, o: Person, y: TaxableYear, a1: Money, a2: Money) defeasible {
    label en official "section 4912(d)(3): managers both liable under (b) are jointly and severally liable";
    when lobbying_manager_tax(p1, o, y, a1);
    when lobbying_manager_tax(p2, o, y, a2);
    when p1 != p2;
    then lobbying_manager_jointly_and_severally_liable(p1, p2, o, y);
}
