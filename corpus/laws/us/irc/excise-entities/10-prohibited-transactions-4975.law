// Section 4975 — tax on prohibited transactions (qualified plans/IRAs).
// Sixth instantiation of the shared shape; (f)(2) is a byte-for-byte
// restatement of section 4941(e)(1)'s "taxable period" wording (earliest of
// notice mailing / assessment / correction), so this module reuses
// `taxable_period`/`taxable_period_ends`/`corrected_within_taxable_period`
// directly with a genuine textual match, not an assumption.
//
// KEY DIFFERENCE FROM SECTION 4941: section 4975 has only ONE tier of
// persons (the disqualified person who participates, other than a fiduciary
// acting only as such) — there is no separate lower-rate "manager" tax
// tier, so this module has no manager-tax rule.
//
// SCOPE:
//  - (a)/(b): 15% initial / 100% additional tax on the disqualified person:
//    modelled fully.
//  - (c)(1)(A)-(F): all six prohibited-transaction categories modelled as a
//    case-asserted classification (mirroring section 4941(d)(1)'s pattern).
//  - (d): only (d)(1)(A) (the "available on a reasonably equivalent basis"
//    condition for a participant loan exemption) is modelled, as ONE
//    illustrative exemption; (d)(1)(B)-(D) and the other ~20 numbered
//    exemptions of (d) are NOT modelled — TECH_GAP (a case wanting any
//    other exemption cannot use this package this stage).
//  - (e)(1): "plan" is a case-asserted classification covering all seven
//    (A)-(G) categories as ONE flag (not distinguished further).
//  - (e)(2)(A)-(D): fiduciary / service provider / employer / employee
//    organization are modelled as case-asserted classifications; (E)-(I)
//    (50%/10% ownership tests, family, and the attribution chains) are NOT
//    modelled — TECH_GAP, same class as section 4946(a)(1)(C)(ii)-(iii)/(E)-(G).
//  - (f)(1) joint-and-several liability: modelled.
//  - (f)(3)-(12) (fiduciary/party-in-interest cross-references, the ESOP
//    and other specialized definitions): NOT modelled.

use self::{
    ExciseAct,
    ExciseActKind,
    IRC_S4975_A,
    IRC_S4975_B,
    IRC_S4975_C,
    IRC_S4975_D,
    IRC_S4975_E,
    IRC_S4975_F,
    Person,
    additional_tax,
    corrected_within_taxable_period,
    excise_act_kind,
    initial_tax,
    participant_exempt_from_tax_4975c,
    plan_outside_4975g,
    prohibited_transaction_exempt_4975,
};

enum ProhibitedTransactionType {
    SaleExchangeOrLeaseOfProperty;
    LendingOrExtensionOfCredit;
    FurnishingGoodsServicesOrFacilities;
    TransferOrUseOfPlanIncomeOrAssets;
    FiduciarySelfDealing;
    FiduciaryKickback;
}

@source(IRC_S4975_E, coverage = partial, quote = "the term \"plan\" means—")
pub relation is_plan(plan: Person, on: Date) kind institutional {
    label en unofficial "section 4975(e)(1): case-asserted classification — the entity is a plan within (A)-(G) (not distinguished further)";
}
@source(IRC_S4975_E, coverage = partial, quote = "a fiduciary;")
pub relation is_fiduciary_4975(p: Person, plan: Person) kind empirical {
    label en unofficial "section 4975(e)(2)(A): p is a fiduciary of the plan";
}
@source(IRC_S4975_E, coverage = partial, quote = "a person providing services to the plan;")
pub relation is_service_provider_4975(p: Person, plan: Person) kind empirical {
    label en unofficial "section 4975(e)(2)(B): p provides services to the plan";
}
@source(IRC_S4975_E, coverage = partial, quote = "an employer any of whose employees are covered by the plan;")
pub relation is_covering_employer_4975(p: Person, plan: Person) kind empirical {
    label en unofficial "section 4975(e)(2)(C): p is an employer any of whose employees are covered by the plan";
}
@source(IRC_S4975_E, coverage = partial, quote = "an employee organization any of whose members are covered by the plan;")
pub relation is_covering_employee_organization_4975(p: Person, plan: Person) kind empirical {
    label en unofficial "section 4975(e)(2)(D): p is an employee organization any of whose members are covered by the plan";
}

@source(IRC_S4975_E, coverage = partial, quote = "the term \"disqualified person\" means a person who is—")
pub relation disqualified_person_4975(p: Person, plan: Person) kind institutional {
    label en official "section 4975(e)(2)(A)-(D): p is a disqualified person with respect to the plan. (E)-(I) (ownership/family/attribution tests) are NOT modelled — TECH_GAP";
}
rule DisqualifiedPerson4975ViaFiduciary(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(A): a fiduciary is a disqualified person";
    when is_fiduciary_4975(p, plan);
    then disqualified_person_4975(p, plan);
}
rule DisqualifiedPerson4975ViaServiceProvider(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(B): a person providing services to the plan is a disqualified person";
    when is_service_provider_4975(p, plan);
    then disqualified_person_4975(p, plan);
}
rule DisqualifiedPerson4975ViaEmployer(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(C): a covering employer is a disqualified person";
    when is_covering_employer_4975(p, plan);
    then disqualified_person_4975(p, plan);
}
rule DisqualifiedPerson4975ViaEmployeeOrganization(p: Person, plan: Person) defeasible {
    label en official "section 4975(e)(2)(D): a covering employee organization is a disqualified person";
    when is_covering_employee_organization_4975(p, plan);
    then disqualified_person_4975(p, plan);
}

pub relation prohibited_transaction_type(a: ExciseAct, t: ProhibitedTransactionType) kind empirical {
    label en unofficial "case-asserted: which of section 4975(c)(1)(A)-(F)'s six categories the transaction falls into";
}
pub relation prohibited_transaction_disqualified_person(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "the disqualified person on the other side of (or engaging in) the prohibited transaction";
}
pub relation prohibited_transaction_plan(a: ExciseAct, plan: Person) kind empirical {
    label en unofficial "the plan involved in the prohibited transaction";
}
@source(IRC_S4975_A, coverage = partial, quote = "other than a fiduciary acting only as such")
pub relation prohibited_transaction_participant_is_fiduciary_acting_only_as_such(a: ExciseAct, p: Person) kind empirical {
    label en unofficial "p participated in the transaction only in a fiduciary capacity, excluding them from the (a)/(b) tax";
}

@source(IRC_S4975_C, coverage = partial, quote = "the term \"prohibited transaction\" means any direct or indirect—")
pub relation prohibited_transaction(a: ExciseAct) kind institutional {
    label en official "section 4975(c)(1)(A)-(F): the transaction is a prohibited transaction";
}
rule ProhibitedTransactionClassification(a: ExciseAct, t: ProhibitedTransactionType, p: Person, plan: Person, on: Date) defeasible {
    label en official "section 4975(c)(1): a direct or indirect sale/exchange/lease, loan, furnishing of goods/services/facilities, transfer/use of plan assets, or fiduciary self-dealing/kickback, between a plan and a disqualified person, is a prohibited transaction";
    when excise_act_kind(a, ProhibitedTransaction);
    when prohibited_transaction_type(a, t);
    when prohibited_transaction_disqualified_person(a, p);
    when prohibited_transaction_plan(a, plan);
    when disqualified_person_4975(p, plan);
    when is_plan(plan, on);
    // Stage 2: the (c)(2) exemption, the (d) exemptions and the (g) exclusions (22-prohibited-transaction-details-4975.law).
    unless prohibited_transaction_exempt_4975(a) and prohibited_transaction_disqualified_person(a, p) and prohibited_transaction_plan(a, plan);
    unless plan_outside_4975g(plan) and prohibited_transaction_plan(a, plan) and prohibited_transaction_disqualified_person(a, p);
    then prohibited_transaction(a);
}

pub relation prohibited_transaction_amount_involved(a: ExciseAct, amount: Money) kind empirical {
    label en unofficial "section 4975(a)/(b): the amount involved with respect to the prohibited transaction (single case-asserted value, same simplification as section 4941(e)(2))";
}
pub relation prohibited_transaction_years_in_taxable_period(a: ExciseAct, n: Integer) kind empirical {
    label en unofficial "case-asserted count of years (or parts thereof) in the taxable period — same TECH_GAP as section 4941(a)(1)'s year-count multiplier";
}

// --- (d)(1)(A): ONE illustrative exemption (participant loans available on
// a reasonably equivalent basis). (d)(1)(B)-(D) and the rest of (d) are NOT
// modelled. ---
@source(IRC_S4975_D, coverage = partial, quote = "is available to all such participants or beneficiaries on a reasonably equivalent basis,")
pub relation participant_loan_reasonably_equivalent_basis(a: ExciseAct) kind empirical {
    label en unofficial "section 4975(d)(1)(A): the loan is available to all plan participants/beneficiaries on a reasonably equivalent basis (case-asserted; (B)-(D) conditions are NOT independently tested)";
}
@source(IRC_S4975_D, coverage = partial, quote = "any loan made by the plan to a disqualified person who is a participant or beneficiary of the plan if such loan—")
pub relation prohibited_transaction_exempt_participant_loan(a: ExciseAct) kind institutional {
    label en official "section 4975(d)(1): a participant loan exemption applies (ONLY the (A) reasonably-equivalent-basis condition is tested here — (B)-(D) are NOT modelled, so this is an UNDERSTATEMENT of the real exemption test)";
}
rule ParticipantLoanExemption(a: ExciseAct) defeasible {
    label en official "section 4975(d)(1)(A): a participant loan available on a reasonably equivalent basis qualifies for the (d)(1) exemption (partial test)";
    when participant_loan_reasonably_equivalent_basis(a);
    then prohibited_transaction_exempt_participant_loan(a);
}

@source(IRC_S4975_A, coverage = partial, quote = "There is hereby imposed a tax on each prohibited transaction. The rate of tax shall be equal to 15 percent of the amount involved with respect to the prohibited transaction for each year (or part thereof) in the taxable period. The tax imposed by this subsection shall be paid by any disqualified person who participates in the prohibited transaction (other than a fiduciary acting only as such).")
rule InitialTaxOnProhibitedTransaction(a: ExciseAct, p: Person, amount: Money, base: Money, n: Integer) defeasible {
    label en official "section 4975(a): 15 percent of the amount involved per year (or part thereof) in the taxable period, paid by the participating disqualified person other than a fiduciary acting only as such";
    when prohibited_transaction(a);
    when prohibited_transaction_disqualified_person(a, p);
    when prohibited_transaction_amount_involved(a, base);
    when prohibited_transaction_years_in_taxable_period(a, n);
    unless prohibited_transaction_participant_is_fiduciary_acting_only_as_such(a, p) and prohibited_transaction_amount_involved(a, base) and prohibited_transaction_years_in_taxable_period(a, n);
    unless prohibited_transaction_exempt_participant_loan(a) and prohibited_transaction_disqualified_person(a, p) and prohibited_transaction_amount_involved(a, base) and prohibited_transaction_years_in_taxable_period(a, n);
    unless participant_exempt_from_tax_4975c(a, p) and prohibited_transaction_amount_involved(a, base) and prohibited_transaction_years_in_taxable_period(a, n);
    then initial_tax(a, p, base * ProhibitedTransactionInitialTaxRate * n);
}

@source(IRC_S4975_B, coverage = partial, quote = "In any case in which an initial tax is imposed by subsection (a) on a prohibited transaction and the transaction is not corrected within the taxable period, there is hereby imposed a tax equal to 100 percent of the amount involved. The tax imposed by this subsection shall be paid by any disqualified person who participated in the prohibited transaction (other than a fiduciary acting only as such).")
rule AdditionalTaxOnProhibitedTransaction(a: ExciseAct, p: Person, amount: Money, base: Money) defeasible {
    label en official "section 4975(b): 100 percent of the amount involved, paid by the participating disqualified person, if the transaction is not corrected within the taxable period";
    when prohibited_transaction(a);
    when prohibited_transaction_disqualified_person(a, p);
    when prohibited_transaction_amount_involved(a, base);
    unless prohibited_transaction_participant_is_fiduciary_acting_only_as_such(a, p) and prohibited_transaction_amount_involved(a, base);
    unless corrected_within_taxable_period(a) and prohibited_transaction_disqualified_person(a, p) and prohibited_transaction_amount_involved(a, base);
    unless participant_exempt_from_tax_4975c(a, p) and prohibited_transaction_amount_involved(a, base);
    then additional_tax(a, p, base * ProhibitedTransactionAdditionalTaxRate);
}

@source(IRC_S4975_F, coverage = partial, quote = "If more than one person is liable under subsection (a) or (b) with respect to any one prohibited transaction, all such persons shall be jointly and severally liable under such subsection with respect to such transaction.")
pub relation prohibited_transaction_jointly_and_severally_liable(a: ExciseAct, p1: Person, p2: Person) kind institutional {
    label en official "section 4975(f)(1): p1 and p2 are jointly and severally liable for the same subsection's tax on the same prohibited transaction";
}
rule JointAndSeveralProhibitedTransactionTax(a: ExciseAct, p1: Person, p2: Person, amount1: Money, amount2: Money) defeasible {
    label en official "section 4975(f)(1): two disqualified persons both liable under (a) for the same transaction are jointly and severally liable";
    when prohibited_transaction(a);
    when initial_tax(a, p1, amount1);
    when initial_tax(a, p2, amount2);
    when p1 != p2;
    then prohibited_transaction_jointly_and_severally_liable(a, p1, p2);
}
