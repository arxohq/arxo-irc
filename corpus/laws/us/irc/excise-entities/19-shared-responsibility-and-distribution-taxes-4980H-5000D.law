// Sections 4980H (employer shared responsibility payments), 4981 (REIT
// undistributed income), 4982 (RIC undistributed income), 4985 (stock
// compensation of insiders in expatriated corporations), 4999 (excess parachute
// payments), 5000 (nonconforming group health plans), 5000B (indoor tanning
// services), 5000C (foreign procurement payments) and 5000D (designated drugs).
// Section 5000A is in 20-individual-shared-responsibility-5000A.law. Stage 2
// (DECISION-0379).
//
// 4980H: the indexed payment amounts of (c)(5) (the premium adjustment percentage
// of ACA section 1302(c)(4), rounded DOWN to a multiple of $10) are not
// pinned (SOURCE_GAP) and rounding down is not among the language's rounding
// modes (HALF_UP / HALF_EVEN / HALF_DOWN — G2520): after 2014 the indexed
// annual amounts are case facts.
// 4981/4982: the "grossed up" prior-year figures are case facts (year-to-year
// recursion, G2504 pattern).
// 4985: the section 1(h)(1)(D) rate and the values of specified stock compensation
// determined under (b) are case facts.

// ============================================================================
// Section 4980H
// ============================================================================

use self::{
    IRC_S4980H_A,
    IRC_S4980H_B,
    IRC_S4980H_C,
    IRC_S4980H_D,
    IRC_S4981_A,
    IRC_S4981_D,
    IRC_S4982_A,
    IRC_S4982_D,
    IRC_S4985_A,
    IRC_S4985_E,
    IRC_S4999_A,
    IRC_S4999_C,
    IRC_S5000B_A,
    IRC_S5000B_C,
    IRC_S5000C_A,
    IRC_S5000D_A,
    IRC_S5000D_E,
    IRC_S5000_A,
    IRC_S5000_C,
    Person,
    TaxableYear,
    ric_capital_gain_net_income_used,
};

pub relation full_time_employees_average_preceding_year(emp: Person, cy: Integer, n: Decimal) kind empirical {
    label en official "section 4980H(c)(2)(A): the average number of full-time employees (employed on average at least 30 hours of service per week) on business days during the preceding calendar year, the 414 controlled group treated as one employer";
}
pub relation non_full_time_hours_of_service_average_month(emp: Person, cy: Integer, hours: Decimal) kind empirical {
    label en official "section 4980H(c)(2)(E): the aggregate hours of service of employees who are not full-time employees for the month (preceding calendar year average)";
}
pub relation workforce_over_50_full_time_days_and_seasonal(emp: Person, cy: Integer) kind empirical {
    label en official "section 4980H(c)(2)(B): the workforce exceeds 50 full-time employees for 120 days or fewer during the calendar year and the excess employees were seasonal workers";
}
@source(IRC_S4980H_C, coverage = exact, quote = "The term \"applicable large employer\" means, with respect to a calendar year, an employer who employed an average of at least 50 full-time employees on business days during the preceding calendar year.")
pub relation applicable_large_employer(emp: Person, cy: Integer) kind institutional {
    label en official "section 4980H(c)(2): an employer who employed an average of at least 50 full-time employees (including full-time equivalents) during the preceding calendar year, unless the seasonal-worker exemption applies";
}
rule ApplicableLargeEmployer(emp: Person, cy: Integer, ft: Decimal, nft: Decimal) defeasible {
    label en official "section 4980H(c)(2)(A), (B), (E): full-time employees plus (hours of service of others ÷ 120) at least 50";
    when full_time_employees_average_preceding_year(emp, cy, ft);
    when non_full_time_hours_of_service_average_month(emp, cy, nft);
    when ft + nft / FullTimeEquivalentHoursDivisor4980H >= ApplicableLargeEmployerThreshold4980H;
    unless workforce_over_50_full_time_days_and_seasonal(emp, cy) and full_time_employees_average_preceding_year(emp, cy, ft) and non_full_time_hours_of_service_average_month(emp, cy, nft);
    then applicable_large_employer(emp, cy);
}
pub relation indexed_annual_payment_amounts_4980H(cy: Integer, payment: Money, offered_payment: Money) kind empirical {
    label en official "section 4980H(c)(5): the annual amounts of (c)(1) ($2,000) and (b) ($3,000) as increased for calendar years after 2014 by the premium adjustment percentage and rounded down to a multiple of $10 (not pinned — SOURCE_GAP, G2520)";
}
pub relation payment_year_4980H(cy: Integer) kind empirical {
    label en unofficial "the calendar year for which the section 4980H payment amounts are asked (binds the year of the amount rules)";
}
pub relation applicable_payment_amount_month(cy: Integer, amount: Money) kind institutional {
    label en official "section 4980H(c)(1): the applicable payment amount for a month is 1/12 of $2,000 (as indexed after 2014)";
}
rule ApplicablePaymentAmount2014(cy: Integer) defeasible {
    label en official "section 4980H(c)(1): 1/12 of $2,000 for months in calendar year 2014 (no increase before the calendar years after 2014)";
    when payment_year_4980H(cy);
    when cy == 2014;
    then applicable_payment_amount_month(cy, div_round(ApplicablePaymentAmountStatutory4980H, 12.0, 2, "HALF_UP"));
}
rule ApplicablePaymentAmountIndexed(cy: Integer, pay: Money, offer: Money) defeasible {
    label en official "section 4980H(c)(1), (5): 1/12 of the indexed $2,000 for calendar years after 2014";
    when indexed_annual_payment_amounts_4980H(cy, pay, offer);
    when cy > 2014;
    then applicable_payment_amount_month(cy, div_round(pay, 12.0, 2, "HALF_UP"));
}
pub relation coverage_offered_payment_amount_month(cy: Integer, amount: Money) kind institutional {
    label en official "section 4980H(b)(1): 1/12 of $3,000 for a month (as indexed after 2014)";
}
rule CoverageOfferedPaymentAmount2014(cy: Integer) defeasible {
    label en official "section 4980H(b)(1): 1/12 of $3,000 for months in calendar year 2014";
    when payment_year_4980H(cy);
    when cy == 2014;
    then coverage_offered_payment_amount_month(cy, div_round(CoverageOfferedPaymentAmountStatutory4980H, 12.0, 2, "HALF_UP"));
}
rule CoverageOfferedPaymentAmountIndexed(cy: Integer, pay: Money, offer: Money) defeasible {
    label en official "section 4980H(b)(1), (c)(5): 1/12 of the indexed $3,000 for calendar years after 2014";
    when indexed_annual_payment_amounts_4980H(cy, pay, offer);
    when cy > 2014;
    then coverage_offered_payment_amount_month(cy, div_round(offer, 12.0, 2, "HALF_UP"));
}
pub relation full_time_employees_in_month(emp: Person, cy: Integer, ym: Integer, n: Integer) kind empirical {
    label en official "section 4980H(c)(4): the number of individuals employed by the employer as full-time employees during the month (30 hours of service per week on average)";
}
pub relation offered_mec_to_full_time_employees_and_dependents(emp: Person, ym: Integer) kind empirical {
    label en official "sections 4980H(a)(1), (b)(1)(A): the employer offers its full-time employees (and their dependents) the opportunity to enroll in minimum essential coverage under an eligible employer-sponsored plan for the month";
}
pub relation full_time_employees_certified_for_credit_or_reduction(emp: Person, ym: Integer, n: Integer) kind empirical {
    label en official "sections 4980H(a)(2), (b)(1)(B): the number of full-time employees certified to the employer under ACA section 1411 as enrolled for the month in a qualified health plan with an applicable premium tax credit or cost-sharing reduction";
}
@source(IRC_S4980H_A, coverage = exact, quote = "then there is hereby imposed on the employer an assessable payment equal to the product of the applicable payment amount and the number of individuals employed by the employer as full-time employees during such month.")
pub relation no_offer_assessable_payment(emp: Person, ym: Integer, amount: Money) kind institutional {
    label en official "section 4980H(a): the applicable payment amount × (full-time employees − 30) for a month in which the employer offers no qualifying coverage and at least one full-time employee is certified for a credit or reduction";
}
rule NoOfferAssessablePayment(emp: Person, cy: Integer, ym: Integer, n: Integer, certified: Integer, pay: Money) defeasible {
    label en official "section 4980H(a), (c)(2)(D): the number of full-time employees is reduced by 30 for this payment; cents HALF_UP (JUDGMENT CALL: no rounding is named)";
    when applicable_large_employer(emp, cy);
    when full_time_employees_in_month(emp, cy, ym, n);
    when full_time_employees_certified_for_credit_or_reduction(emp, ym, certified);
    when certified >= 1;
    when applicable_payment_amount_month(cy, pay);
    when n > LargeEmployerReductionEmployees4980H;
    unless offered_mec_to_full_time_employees_and_dependents(emp, ym) and applicable_large_employer(emp, cy) and full_time_employees_in_month(emp, cy, ym, n) and full_time_employees_certified_for_credit_or_reduction(emp, ym, certified) and applicable_payment_amount_month(cy, pay);
    then no_offer_assessable_payment(emp, ym, pay * (n - LargeEmployerReductionEmployees4980H));
}
@source(IRC_S4980H_B, coverage = exact, quote = "then there is hereby imposed on the employer an assessable payment equal to the product of the number of full-time employees of the applicable large employer described in subparagraph (B) for such month and an amount equal to 1/12 of $3,000.")
pub relation offer_assessable_payment(emp: Person, ym: Integer, amount: Money) kind institutional {
    label en official "section 4980H(b): 1/12 of $3,000 × the certified full-time employees, not more than the (a) amount that would apply, for a month in which coverage is offered";
}
rule OfferAssessablePayment(emp: Person, cy: Integer, ym: Integer, n: Integer, certified: Integer, offer: Money, pay: Money) defeasible {
    label en official "section 4980H(b)(1)-(2): certified full-time employees × 1/12 of $3,000, limited by the overall limitation of (b)(2) (applicable payment amount × (full-time employees − 30))";
    when applicable_large_employer(emp, cy);
    when offered_mec_to_full_time_employees_and_dependents(emp, ym);
    when full_time_employees_in_month(emp, cy, ym, n);
    when full_time_employees_certified_for_credit_or_reduction(emp, ym, certified);
    when certified >= 1;
    when coverage_offered_payment_amount_month(cy, offer);
    when applicable_payment_amount_month(cy, pay);
    when n > LargeEmployerReductionEmployees4980H;
    then offer_assessable_payment(emp, ym, min(offer * certified, pay * (n - LargeEmployerReductionEmployees4980H)));
}
pub relation notice_and_demand_for_4980H_on(emp: Person, on: Date) kind empirical {
    label en official "section 4980H(d)(1): the date of the Secretary's notice and demand for the assessable payment";
}
pub relation assessable_payment_4980H_paid(emp: Person) kind empirical {
    label en official "section 4980H(d)(1): the employer paid the assessable payment";
}
@source(IRC_S4980H_D, coverage = exact, quote = "Any assessable payment provided by this section shall be paid upon notice and demand by the Secretary")
rule S4980HPayUponNoticeDutyRule(emp: Person, demanded: Date, ym: Integer, amt: Money) defeasible {
    label en official "section 4980H(d)(1): the assessable payment shall be paid upon notice and demand by the Secretary";
    when no_offer_assessable_payment(emp, ym, amt);
    when notice_and_demand_for_4980H_on(emp, demanded);
    then duty S4980HPayAssessablePayment {
        bearer emp;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition assessable_payment_4980H_paid(emp);
            window [demanded, infinity];
        }
    };
}
pub relation first_proposed_assessment_letter_on(emp: Person, on: Date) kind empirical {
    label en official "section 4980H(d)(4): the date of the first letter informing the employer of a proposed assessment of the shared responsibility payment";
}
pub relation secretary_takes_further_action_on_proposed_assessment(emp: Person, on: Date) kind empirical {
    label en official "section 4980H(d)(4): the Secretary takes further action with respect to the proposed assessment on this date";
}
@source(IRC_S4980H_D, coverage = exact, quote = "The Secretary shall allow an applicable large employer at least 90 days from the date of the first letter which informs the employer of a proposed assessment of the employer shared responsibility payment under this section to respond to the proposed assessment before taking any further action with respect to such proposed assessment.")
rule S4980HResponsePeriodProhibitionRule(emp: Person, letter: Date, acted: Date) defeasible {
    label en official "section 4980H(d)(4): no further action on a proposed assessment during the 90 days after the first letter — VIOLATED on itself when the Secretary acts inside the period (E-0179)";
    when first_proposed_assessment_letter_on(emp, letter);
    when secretary_takes_further_action_on_proposed_assessment(emp, acted);
    when acted >= letter;
    when acted < add_calendar_period(letter, 90 calendar_day);
    then prohibition S4980HActBeforeResponsePeriodEnds {
        bearer us.irc.core::Secretary;
        beneficiary emp;
        action secretary_takes_further_action_on_proposed_assessment(emp, acted);
        window [letter, add_calendar_period(letter, 90 calendar_day)];
    };
}

// ============================================================================
// Sections 4981 and 4982
// ============================================================================

pub relation distribution_ordinary_income(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(e)(1), 4982(e)(1): the ordinary income for the calendar year (REIT taxable income / investment company taxable income determined under the special rules of (e), calendar year as the taxable year) — computed by the case (EXTERNAL_DEPENDENCY: sections 857(b)(2), 852(b)(2))";
}
pub relation distribution_capital_gain_net_income(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(e)(2), 4982(e)(2): the capital gain net income (for a RIC: for the one-year period ending on October 31 or the elected taxable year), reduced by the net ordinary loss (for a RIC not below net capital gain)";
}
pub relation prior_year_grossed_up_required_distribution(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(b)(2)(A), 4982(b)(2)(A): the grossed up required distribution for the preceding calendar year (with 100 percent substituted for each percentage, prior shortfall applied)";
}
pub relation prior_year_distributed_amount(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(b)(2)(B), (c)(2)(A), 4982(b)(2)(B), (c)(2)(A): the distributed amount for the preceding calendar year (determined with the prior-year overdistribution rule applied)";
}
pub relation dividends_paid_deduction_for_year(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(c)(1)(A), 4982(c)(1)(A): the deduction for dividends paid (section 561) during the calendar year (REIT: without the portion attributable to 857(b)(2)(D); RIC: without regard to sections 855 and exempt-interest dividends; determined without section 858 for a REIT)";
}
pub relation amounts_taxed_under_857_or_852(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "sections 4981(c)(1)(B), 4982(c)(1)(B): amounts on which tax is imposed under section 857(b)(1) or (b)(3)(A) (REIT) or 852(b)(1) or (b)(3)(A) (RIC) for taxable years ending in the calendar year";
}
pub relation qualified_estimated_tax_payments_elected(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4982(c)(4)(A)(i): for a RIC electing the paragraph, the amount on which qualified estimated tax payments are made during the calendar year";
}
pub relation prior_year_estimated_tax_increase(t: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 4982(c)(4)(A)(ii): the increase made for the preceding calendar year, which reduces this year's distributed amount";
}
pub relation entity_is_reit(t: Person, cy: Integer) kind empirical {
    label en official "section 4981(a): the entity is a real estate investment trust for the calendar year";
}
pub relation entity_is_ric(t: Person, cy: Integer) kind empirical {
    label en official "section 4982(a): the entity is a regulated investment company for the calendar year";
}
pub relation reit_required_distribution(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4981(b): 85 percent of ordinary income plus 95 percent of capital gain net income, increased by the prior-year shortfall";
}
rule ReitRequiredDistribution(t: Person, cy: Integer, oi: Money, cg: Money, gu: Money, pd: Money) defeasible {
    label en official "section 4981(b)(1)-(2): 85% × ordinary income + 95% × capital gain net income + max(0, prior grossed-up required − prior distributed)";
    when entity_is_reit(t, cy);
    when distribution_ordinary_income(t, cy, oi);
    when distribution_capital_gain_net_income(t, cy, cg);
    when prior_year_grossed_up_required_distribution(t, cy, gu);
    when prior_year_distributed_amount(t, cy, pd);
    then reit_required_distribution(t, cy, oi * ReitOrdinaryIncomeShare4981 + cg * ReitCapitalGainShare4981 + max(gu - pd, 0.00 USD));
}
pub relation reit_distributed_amount(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4981(c): dividends paid plus amounts taxed under 857(b)(1)/(b)(3)(A), increased by the prior-year overdistribution";
}
rule ReitDistributedAmount(t: Person, cy: Integer, dv: Money, tx: Money, gu: Money, pd: Money) defeasible {
    label en official "section 4981(c)(1)-(2): dividends + taxed amounts + max(0, prior distributed − prior grossed-up required)";
    when entity_is_reit(t, cy);
    when dividends_paid_deduction_for_year(t, cy, dv);
    when amounts_taxed_under_857_or_852(t, cy, tx);
    when prior_year_grossed_up_required_distribution(t, cy, gu);
    when prior_year_distributed_amount(t, cy, pd);
    then reit_distributed_amount(t, cy, dv + tx + max(pd - gu, 0.00 USD));
}
@source(IRC_S4981_A, coverage = exact, quote = "There is hereby imposed a tax on every real estate investment trust for each calendar year equal to 4 percent of the excess (if any) of—")
pub relation reit_undistributed_tax(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4981(a): 4 percent of the excess of the required distribution over the distributed amount";
}
rule ReitUndistributedTax(t: Person, cy: Integer, req: Money, dist: Money) defeasible {
    label en official "section 4981(a); cents HALF_UP (JUDGMENT CALL)";
    when reit_required_distribution(t, cy, req);
    when reit_distributed_amount(t, cy, dist);
    when req > dist;
    then reit_undistributed_tax(t, cy, round((req - dist) * ReitUndistributedTaxRate4981, 2, "HALF_UP"));
}
pub relation calendar_year_end_date(t: Person, cy: Integer, on: Date) kind empirical {
    label en unofficial "the last day of the calendar year (anchors the March 15 payment date)";
}
pub relation undistributed_tax_payment_due(t: Person, cy: Integer, on: Date) kind institutional {
    label en official "sections 4981(d), 4982(d): the tax for a calendar year shall be paid on or before March 15 of the following calendar year";
}
rule UndistributedTaxPaymentDue(t: Person, cy: Integer, endd: Date) defeasible {
    label en official "March 15 of the following calendar year (last day of the year + 1 day + 2 months + 14 days)";
    when calendar_year_end_date(t, cy, endd);
    then undistributed_tax_payment_due(t, cy, add_calendar_period(add_calendar_period(add_calendar_period(endd, 1 calendar_day), 2 calendar_month), 14 calendar_day));
}
pub relation undistributed_tax_paid(t: Person, cy: Integer) kind empirical {
    label en official "sections 4981(d), 4982(d): the tax for the calendar year has been paid";
}
@source(IRC_S4981_D, coverage = exact, quote = "The tax imposed by this section for any calendar year shall be paid on or before March 15 of the following calendar year.")
rule S4981PayByMarch15DutyRule(t: Person, cy: Integer, amt: Money, due: Date) defeasible {
    label en official "section 4981(d): the REIT shall pay the tax on or before March 15 of the following calendar year";
    when reit_undistributed_tax(t, cy, amt);
    when undistributed_tax_payment_due(t, cy, due);
    then duty S4981PayUndistributedTax {
        bearer t;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition undistributed_tax_paid(t, cy);
            window [-infinity, due];
        }
    };
}
pub relation ric_shareholders_all_excepted(t: Person, cy: Integer) kind empirical {
    label en official "section 4982(f): at all times during the calendar year each shareholder was a 401(a)/501(a) trust, a variable-contract segregated asset account, another tax-exempt entity described in 817(h)(4), or another such regulated investment company (shares from an initial organizational investment of up to $250,000 are disregarded)";
}
pub relation ric_required_distribution(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4982(b): 98 percent of ordinary income plus 98.2 percent of capital gain net income, increased by the prior-year shortfall";
}
rule RicRequiredDistribution(t: Person, cy: Integer, oi: Money, cg: Money, gu: Money, pd: Money) defeasible {
    label en official "section 4982(b)(1)-(2): 98% × ordinary income + 98.2% × capital gain net income + max(0, prior grossed-up required − prior distributed)";
    when entity_is_ric(t, cy);
    when distribution_ordinary_income(t, cy, oi);
    when ric_capital_gain_net_income_used(t, cy, cg);  // Stage 3: derived (e)(2)(B) amount or the asserted aggregate (31-*.law)
    when prior_year_grossed_up_required_distribution(t, cy, gu);
    when prior_year_distributed_amount(t, cy, pd);
    then ric_required_distribution(t, cy, oi * RicOrdinaryIncomeShare4982 + cg * RicCapitalGainShare4982 + max(gu - pd, 0.00 USD));
}
pub relation ric_distributed_amount(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4982(c): dividends paid plus amounts taxed under 852(b)(1)/(b)(3)(A), plus qualified estimated tax payments when elected less the prior-year increase, plus the prior-year overdistribution";
}
rule RicDistributedAmount(t: Person, cy: Integer, dv: Money, tx: Money, est: Money, prev: Money, gu: Money, pd: Money) defeasible {
    label en official "section 4982(c)(1), (2), (4)";
    when entity_is_ric(t, cy);
    when dividends_paid_deduction_for_year(t, cy, dv);
    when amounts_taxed_under_857_or_852(t, cy, tx);
    when qualified_estimated_tax_payments_elected(t, cy, est);
    when prior_year_estimated_tax_increase(t, cy, prev);
    when prior_year_grossed_up_required_distribution(t, cy, gu);
    when prior_year_distributed_amount(t, cy, pd);
    then ric_distributed_amount(t, cy, dv + tx + est - prev + max(pd - gu, 0.00 USD));
}
@source(IRC_S4982_A, coverage = exact, quote = "There is hereby imposed a tax on every regulated investment company for each calendar year equal to 4 percent of the excess (if any) of—")
pub relation ric_undistributed_tax(t: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 4982(a): 4 percent of the excess of the required distribution over the distributed amount; not for a company whose shareholders are all excepted (4982(f))";
}
rule RicUndistributedTax(t: Person, cy: Integer, req: Money, dist: Money) defeasible {
    label en official "section 4982(a), (f); cents HALF_UP (JUDGMENT CALL)";
    when ric_required_distribution(t, cy, req);
    when ric_distributed_amount(t, cy, dist);
    when req > dist;
    unless ric_shareholders_all_excepted(t, cy) and ric_required_distribution(t, cy, req) and ric_distributed_amount(t, cy, dist);
    then ric_undistributed_tax(t, cy, round((req - dist) * RicUndistributedTaxRate4982, 2, "HALF_UP"));
}
@source(IRC_S4982_D, coverage = exact, quote = "The tax imposed by this section for any calendar year shall be paid on or before March 15 of the following calendar year.")
rule S4982PayByMarch15DutyRule(t: Person, cy: Integer, amt: Money, due: Date) defeasible {
    label en official "section 4982(d): the regulated investment company shall pay the tax on or before March 15 of the following calendar year";
    when ric_undistributed_tax(t, cy, amt);
    when undistributed_tax_payment_due(t, cy, due);
    then duty S4982PayUndistributedTax {
        bearer t;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition undistributed_tax_paid(t, cy);
            window [-infinity, due];
        }
    };
}

// ============================================================================
// Section 4985
// ============================================================================

pub relation expatriated_corporation_4985(corp: Person) kind empirical {
    label en official "section 4985(e)(2)(A): an expatriated entity under section 7874(a)(2) (including a predecessor or successor)";
}
pub relation expatriation_date_4985(corp: Person, on: Date) kind institutional {
    label en official "section 4985(e)(2)(B): the date the corporation first becomes an expatriated corporation";
}
pub relation subject_to_section_16a(i: Person, corp: Person) kind empirical {
    label en official "section 4985(e)(1): during the 12-month period beginning 6 months before the expatriation date the individual is subject (or would be subject if the corporation were an issuer) to section 16(a) of the Securities Exchange Act of 1934 with respect to the corporation or a member of its expanded affiliated group";
}
@source(IRC_S4985_E, coverage = exact, quote = "The term \"disqualified individual\" means, with respect to a corporation, any individual who, at any time during the 12-month period beginning on the date which is 6 months before the expatriation date—")
pub relation disqualified_individual_4985(i: Person, corp: Person) kind institutional {
    label en official "section 4985(e)(1): a section 16(a) insider of an expatriated corporation";
}
rule DisqualifiedIndividual4985(i: Person, corp: Person) defeasible {
    label en official "section 4985(e)(1)(A)-(B)";
    when expatriated_corporation_4985(corp);
    when subject_to_section_16a(i, corp);
    then disqualified_individual_4985(i, corp);
}
pub relation shareholder_gain_recognized_by_reason_of_7874_acquisition(corp: Person) kind empirical {
    label en official "section 4985(c): gain on stock of the corporation is recognized in whole or part by any shareholder by reason of the acquisition referred to in section 7874(a)(2)(B)(i)";
}
pub relation stock_compensation_held_in_window(comp: Person, i: Person, corp: Person) kind empirical {
    label en official "section 4985(a)(2): the specified stock compensation is held (directly or indirectly) by or for the benefit of the individual or a family member (267) at any time in the 12-month period beginning 6 months before the expatriation date";
}
pub relation specified_stock_compensation_value(comp: Person, value: Money) kind empirical {
    label en official "section 4985(b): the value determined as of the date the (b)(2) rule prescribes (option or SAR: fair value; otherwise fair market value; expatriation date, the day before a cancellation in the 6 months before, or the grant date if later)";
}
pub relation specified_stock_compensation_excluded(comp: Person) kind empirical {
    label en official "section 4985(e)(3)(B): an option to which part II of subchapter D applies, or a payment or right to payment from a plan referred to in section 280G(b)(6)";
}
pub relation compensation_recognized_in_full_exception(comp: Person) kind empirical {
    label en official "section 4985(d): a stock option exercised on or during the 6 months before the expatriation date with section 83 income recognized on or before it, or other compensation exercised, sold, exchanged, distributed, cashed out or paid in the period in a transaction recognizing income, gain or loss in full";
}
pub relation capital_gains_rate_1h1D(y: TaxableYear, rate: Decimal) kind empirical {
    label en official "section 4985(a)(1): the rate of tax specified in section 1(h)(1)(D) (EXTERNAL_DEPENDENCY on us.irc.income_individual)";
}
pub relation expatriation_taxable_year(i: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxable year for which the section 1(h)(1)(D) rate is read";
}
pub relation holder_of_specified_stock_compensation(comp: Person, i: Person) kind empirical {
    label en unofficial "the individual (or family member) holding the specified stock compensation";
}
@source(IRC_S4985_A, coverage = exact, quote = "In the case of an individual who is a disqualified individual with respect to any expatriated corporation, there is hereby imposed on such person a tax equal to—")
pub relation expatriated_stock_compensation_tax(i: Person, corp: Person, amount: Money) kind institutional {
    label en official "section 4985(a): the section 1(h)(1)(D) rate × the value of the specified stock compensation held during the window, only if a shareholder recognized gain (4985(c)), excluding the (d) exceptions";
}
rule ExpatriatedStockCompensationTax(i: Person, corp: Person, y: TaxableYear, r: Decimal) defeasible {
    label en official "section 4985(a), (b), (c), (d), (e)(3): rate × sum of the values of held specified stock compensation not excluded or excepted; cents HALF_UP (JUDGMENT CALL)";
    when disqualified_individual_4985(i, corp);
    when shareholder_gain_recognized_by_reason_of_7874_acquisition(corp);
    when expatriation_taxable_year(i, y);
    when capital_gains_rate_1h1D(y, r);
    then expatriated_stock_compensation_tax(i, corp, round(r * sum(collect all v: Money, c: Person where stock_compensation_held_in_window(c, i, corp) and specified_stock_compensation_value(c, v) and eligible_specified_stock_compensation(c), empty: 0.00 USD), 2, "HALF_UP"));
}
pub relation eligible_specified_stock_compensation(comp: Person) kind institutional {
    label en official "section 4985(d), (e)(3): specified stock compensation that is not excluded by (e)(3)(B) or excepted by (d)";
}
rule EligibleSpecifiedStockCompensation(comp: Person, v: Money) defeasible {
    label en official "section 4985(d), (e)(3)(B)";
    when specified_stock_compensation_value(comp, v);
    unless specified_stock_compensation_excluded(comp) and specified_stock_compensation_value(comp, v);
    unless compensation_recognized_in_full_exception(comp) and specified_stock_compensation_value(comp, v);
    then eligible_specified_stock_compensation(comp);
}
pub relation corporation_paid_or_reimbursed_4985_tax(corp: Person, i: Person, amount: Money) kind empirical {
    label en official "section 4985(f)(2): the expatriated corporation (or a member of its expanded affiliated group) directly or indirectly paid or reimbursed the tax";
}
pub relation treated_as_specified_stock_compensation_4985f2(corp: Person, i: Person, amount: Money) kind institutional {
    label en official "section 4985(f)(2): a payment of the tax by the corporation is itself specified stock compensation and is not deductible under chapter 1";
}
rule PaymentOfTaxIsSpecifiedStockCompensation(corp: Person, i: Person, amt: Money) defeasible {
    label en official "section 4985(f)(2)(A)";
    when corporation_paid_or_reimbursed_4985_tax(corp, i, amt);
    then treated_as_specified_stock_compensation_4985f2(corp, i, amt);
}

// ============================================================================
// Section 4999
// ============================================================================

pub relation excess_parachute_payment_received(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "sections 4999(a)-(b): an excess parachute payment (section 280G(b)) received by the person — imported from us.irc.deductions";
}
rule ExcessParachutePaymentReceived(p: Person, corp: Person, item: Integer, amt: Money) defeasible {
    label en official "section 4999(b): the meaning of 'excess parachute payment' is that of section 280G(b), implemented in us.irc.deductions";
    when us.irc.deductions::excess_parachute_payment(p, corp, item, amt);
    then excess_parachute_payment_received(p, corp, item, amt);
}
@source(IRC_S4999_A, coverage = exact, quote = "There is hereby imposed on any person who receives an excess parachute payment a tax equal to 20 percent of the amount of such payment.")
pub relation excess_parachute_payment_tax(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "section 4999(a): 20 percent of the excess parachute payment, imposed on the recipient";
}
rule ExcessParachutePaymentTax(p: Person, corp: Person, item: Integer, amt: Money) defeasible {
    label en official "section 4999(a); cents HALF_UP (JUDGMENT CALL)";
    when excess_parachute_payment_received(p, corp, item, amt);
    then excess_parachute_payment_tax(p, corp, item, round(amt * ParachutePaymentExciseRate4999, 2, "HALF_UP"));
}
pub relation excess_parachute_payment_is_wages(p: Person, corp: Person, item: Integer) kind empirical {
    label en official "section 4999(c)(1): the excess parachute payment is wages within the meaning of section 3401";
}
@source(IRC_S4999_C, coverage = exact, quote = "the amount deducted and withheld under section 3402 shall be increased by the amount of the tax imposed by this section on such payment.")
pub relation withholding_increase_for_excess_parachute(p: Person, corp: Person, item: Integer, amount: Money) kind institutional {
    label en official "section 4999(c)(1): the amount deducted and withheld under section 3402 is increased by the tax on the excess parachute payment that is wages";
}
rule WithholdingIncreaseForExcessParachute(p: Person, corp: Person, item: Integer, tax: Money) defeasible {
    label en official "section 4999(c)(1)";
    when excess_parachute_payment_tax(p, corp, item, tax);
    when excess_parachute_payment_is_wages(p, corp, item);
    then withholding_increase_for_excess_parachute(p, corp, item, tax);
}

// ============================================================================
// Section 5000
// ============================================================================

pub relation employer_or_employee_organization_5000(p: Person) kind empirical {
    label en official "section 5000(a): an employer (including a self-employed person) or employee organization; not a Federal or other governmental entity ((d))";
}
pub relation governmental_entity_5000d(p: Person) kind empirical {
    label en official "section 5000(d): a Federal or other governmental entity, excluded from 'employer'";
}
pub relation contributes_to_nonconforming_group_health_plan(p: Person, plan: Person, cy: Integer) kind empirical {
    label en official "section 5000(a): the employer or employee organization contributes to a nonconforming group health plan during the calendar year";
}
pub relation plan_noncompliant_with_medicare_secondary_payer(plan: Person, cy: Integer) kind empirical {
    label en official "section 5000(c): at any time during the calendar year the plan does not comply with the requirements of paragraphs (1)(A) and (C) (group health plan), or (1)(B) (large group health plan), or (2) of section 1862(b) of the Social Security Act (EXTERNAL_DEPENDENCY)";
}
pub relation plan_covers_employer_with_100_or_more_employees(plan: Person, cy: Integer) kind institutional {
    label en official "section 5000(b)(2): the plan covers employees of at least one employer that normally employed at least 100 employees on a typical business day during the previous calendar year (the 52(a)/(b) group, the 414(m) affiliated service group and 414(n) leased employees aggregated)";
}
pub relation expenses_incurred_for_plan(p: Person, plan: Person, cy: Integer, amount: Money) kind empirical {
    label en official "section 5000(a): the employer's or employee organization's expenses incurred during the calendar year for the group health plan";
}
@source(IRC_S5000_C, coverage = exact, quote = "the term \"nonconforming group health plan\" means a group health plan or large group health plan that at any time during a calendar year does not comply with the requirements")
pub relation nonconforming_group_health_plan(plan: Person, cy: Integer) kind institutional {
    label en official "section 5000(c): a plan that at some time in the calendar year fails the section 1862(b) requirements";
}
rule NonconformingGroupHealthPlan(plan: Person, cy: Integer) defeasible {
    label en official "section 5000(c)";
    when plan_noncompliant_with_medicare_secondary_payer(plan, cy);
    then nonconforming_group_health_plan(plan, cy);
}
@source(IRC_S5000_A, coverage = exact, quote = "There is hereby imposed on any employer (including a self-employed person) or employee organization that contributes to a nonconforming group health plan a tax equal to 25 percent of the employer's or employee organization's expenses incurred during the calendar year for each group health plan to which the employer or employee organization contributes.")
pub relation nonconforming_plan_tax(p: Person, plan: Person, cy: Integer, amount: Money) kind institutional {
    label en official "section 5000(a): 25 percent of the expenses incurred during the calendar year for each group health plan to which the person contributes, when it contributes to a nonconforming plan; not for a governmental entity";
}
rule NonconformingPlanTax(p: Person, plan: Person, cy: Integer, exp: Money) defeasible {
    label en official "section 5000(a), (d); cents HALF_UP (JUDGMENT CALL)";
    when employer_or_employee_organization_5000(p);
    when contributes_to_nonconforming_group_health_plan(p, plan, cy);
    when nonconforming_group_health_plan(plan, cy);
    when expenses_incurred_for_plan(p, plan, cy, exp);
    unless governmental_entity_5000d(p) and employer_or_employee_organization_5000(p) and contributes_to_nonconforming_group_health_plan(p, plan, cy) and expenses_incurred_for_plan(p, plan, cy, exp);
    then nonconforming_plan_tax(p, plan, cy, round(exp * NonconformingGroupHealthPlanTaxRate5000, 2, "HALF_UP"));
}

// ============================================================================
// Section 5000B
// ============================================================================

entity IndoorTanningService { label en unofficial "a service employing an electronic product with ultraviolet lamps intended for irradiation of an individual to induce skin tanning (section 5000B(b)(1))"; }
pub relation tanning_service_client(s: IndoorTanningService, client: Person) kind empirical {
    label en official "section 5000B(c)(1): the individual on whom the service is performed";
}
pub relation tanning_service_provider(s: IndoorTanningService, provider: Person) kind empirical {
    label en official "section 5000B(c)(3): the person who performs the service";
}
pub relation tanning_service_amount_paid(s: IndoorTanningService, amount: Money) kind empirical {
    label en official "section 5000B(a): the amount paid for the service, determined without regard to this section, whether paid by insurance or otherwise";
}
pub relation phototherapy_by_licensed_medical_professional(s: IndoorTanningService) kind empirical {
    label en official "section 5000B(b)(2): a phototherapy service performed by a licensed medical professional";
}
@source(IRC_S5000B_A, coverage = exact, quote = "There is hereby imposed on any indoor tanning service a tax equal to 10 percent of the amount paid for such service")
pub relation indoor_tanning_tax(s: IndoorTanningService, client: Person, amount: Money) kind institutional {
    label en official "sections 5000B(a), (c)(1): 10 percent of the amount paid for an indoor tanning service, paid by the individual on whom the service is performed; phototherapy by a licensed medical professional is excluded";
}
rule IndoorTanningTax(s: IndoorTanningService, client: Person, paid: Money) defeasible {
    label en official "section 5000B(a)-(c); cents HALF_UP (JUDGMENT CALL)";
    when tanning_service_client(s, client);
    when tanning_service_amount_paid(s, paid);
    unless phototherapy_by_licensed_medical_professional(s) and tanning_service_client(s, client) and tanning_service_amount_paid(s, paid);
    then indoor_tanning_tax(s, client, round(paid * IndoorTanningTaxRate5000B, 2, "HALF_UP"));
}
pub relation tanning_payment_received_by(s: IndoorTanningService, payee: Person) kind empirical {
    label en official "section 5000B(c)(2): the person receiving a payment for the service";
}
pub relation tanning_tax_collected_from_client(s: IndoorTanningService) kind empirical {
    label en official "section 5000B(c)(2): the tax was collected from the individual on whom the service was performed";
}
pub relation tanning_tax_remitted_quarterly(s: IndoorTanningService, payee: Person) kind empirical {
    label en official "section 5000B(c)(2): the tax was remitted to the Secretary quarterly, at the time and manner the Secretary provides";
}
@source(IRC_S5000B_C, coverage = exact, quote = "Every person receiving a payment for services on which a tax is imposed under subsection (a) shall collect the amount of the tax from the individual on whom the service is performed and remit such tax quarterly to the Secretary")
rule S5000BCollectDutyRule(s: IndoorTanningService, payee: Person, client: Person, amt: Money) defeasible {
    label en official "section 5000B(c)(2): every person receiving a payment for a taxed service shall collect the tax from the client";
    when indoor_tanning_tax(s, client, amt);
    when tanning_payment_received_by(s, payee);
    then duty S5000BCollectTax {
        bearer payee;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition tanning_tax_collected_from_client(s);
            window [-infinity, infinity];
        }
    };
}
rule S5000BRemitDutyRule(s: IndoorTanningService, payee: Person, client: Person, amt: Money) defeasible {
    label en official "section 5000B(c)(2): every person receiving a payment shall remit the tax quarterly to the Secretary";
    when indoor_tanning_tax(s, client, amt);
    when tanning_payment_received_by(s, payee);
    then duty S5000BRemitTax {
        bearer payee;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition tanning_tax_remitted_quarterly(s, payee);
            window [-infinity, infinity];
        }
    };
}
pub relation tanning_tax_not_collected(s: IndoorTanningService) kind empirical {
    label en official "section 5000B(c)(3): the tax was not paid at the time payments were made and is not collected";
}
@source(IRC_S5000B_C, coverage = exact, quote = "Where any tax imposed by subsection (a) is not paid at the time payments for indoor tanning services are made, then to the extent that such tax is not collected, such tax shall be paid by the person who performs the service.")
pub relation tanning_secondary_liability(s: IndoorTanningService, provider: Person, amount: Money) kind institutional {
    label en official "section 5000B(c)(3): to the extent the tax is not collected, the person who performs the service pays it";
}
rule TanningSecondaryLiability(s: IndoorTanningService, provider: Person, client: Person, amt: Money) defeasible {
    label en official "section 5000B(c)(3)";
    when indoor_tanning_tax(s, client, amt);
    when tanning_service_provider(s, provider);
    when tanning_tax_not_collected(s);
    then tanning_secondary_liability(s, provider, amt);
}

// ============================================================================
// Section 5000C
// ============================================================================

entity ProcurementPayment { label en unofficial "a payment made pursuant to a contract with the Government of the United States"; }
pub relation procurement_payment_recipient(pp: ProcurementPayment, r: Person) kind empirical { label en official "the person receiving the payment"; }
pub relation procurement_payment_amount(pp: ProcurementPayment, amount: Money) kind empirical { label en official "the amount of the payment"; }
pub relation procurement_recipient_is_us_person(r: Person) kind empirical { label en official "section 5000C(c): a United States person (a foreign person is any other person)"; }
pub relation procurement_goods_made_in_non_agreement_country(pp: ProcurementPayment) kind empirical {
    label en official "section 5000C(b)(1): the payment is for goods manufactured or produced in any country that is not a party to an international procurement agreement with the United States";
}
pub relation procurement_services_provided_in_non_agreement_country(pp: ProcurementPayment) kind empirical {
    label en official "section 5000C(b)(2): the payment is for services provided in any country that is not a party to an international procurement agreement with the United States";
}
pub relation specified_federal_procurement_payment(pp: ProcurementPayment) kind institutional {
    label en official "section 5000C(b): a payment under a Government contract for goods produced, or services provided, in a non-agreement country";
}
rule SpecifiedProcurementPaymentGoods(pp: ProcurementPayment) defeasible { label en official "5000C(b)(1)"; when procurement_goods_made_in_non_agreement_country(pp); then specified_federal_procurement_payment(pp); }
rule SpecifiedProcurementPaymentServices(pp: ProcurementPayment) defeasible { label en official "5000C(b)(2)"; when procurement_services_provided_in_non_agreement_country(pp); then specified_federal_procurement_payment(pp); }
@source(IRC_S5000C_A, coverage = exact, quote = "There is hereby imposed on any foreign person that receives a specified Federal procurement payment a tax equal to 2 percent of the amount of such specified Federal procurement payment.")
pub relation foreign_procurement_tax(pp: ProcurementPayment, r: Person, amount: Money) kind institutional {
    label en official "section 5000C(a): 2 percent of a specified Federal procurement payment received by a foreign person";
}
rule ForeignProcurementTax(pp: ProcurementPayment, r: Person, amt: Money) defeasible {
    label en official "section 5000C(a), (c); cents HALF_UP (JUDGMENT CALL)";
    when specified_federal_procurement_payment(pp);
    when procurement_payment_recipient(pp, r);
    when procurement_payment_amount(pp, amt);
    unless procurement_recipient_is_us_person(r) and procurement_payment_recipient(pp, r) and procurement_payment_amount(pp, amt);
    then foreign_procurement_tax(pp, r, round(amt * ForeignProcurementPaymentTaxRate5000C, 2, "HALF_UP"));
}
pub relation chapter_3_withholding_increase_5000C(pp: ProcurementPayment, amount: Money) kind institutional {
    label en official "section 5000C(d)(1): the amount deducted and withheld under chapter 3 is increased by the tax on the payment";
}
rule Chapter3WithholdingIncrease5000C(pp: ProcurementPayment, r: Person, tax: Money) defeasible {
    label en official "section 5000C(d)(1)";
    when foreign_procurement_tax(pp, r, tax);
    then chapter_3_withholding_increase_5000C(pp, tax);
}

// ============================================================================
// Section 5000D
// ============================================================================

entity DesignatedDrugSale { label en unofficial "a sale by the manufacturer, producer, or importer of a designated drug on a day in a noncompliance period (section 5000D(a))"; }
pub relation drug_sale_price(s: DesignatedDrugSale, price: Money) kind empirical {
    label en official "section 5000D(a)(2): the price for which the drug was sold";
}
pub relation drug_sale_seller(s: DesignatedDrugSale, seller: Person) kind empirical {
    label en official "section 5000D(a): the manufacturer, producer, or importer";
}
pub relation drug_sale_on_noncompliance_day(s: DesignatedDrugSale, n: Integer) kind empirical {
    label en official "sections 5000D(b), (c), (d): the ordinal of the sale day among the days described in subsection (b), after the (c) suspension (the union of the four noncompliance periods and the suspension ledger is asserted — G2521)";
}
pub relation drug_is_designated_drug(s: DesignatedDrugSale) kind empirical {
    label en official "section 5000D(e)(1): a negotiation-eligible drug on the section 1192(a) list manufactured or produced in, or entered into, the United States";
}
// SSA reader (IRC-G/G6, 2026-09-27): section 5000D(e)(3) gives the section
// 1191 terms (initial price applicability year, price applicability period,
// maximum fair price) their Social Security Act meaning
// (row 26/5000D/e/3/u1). Pattern G4/CFR: the SSA content enters as a
// case-selected fact; the from-package leg — reading pubs of
// `us.ssa.title42_values` (govinfo bytes pinned in
// corpus/laws/us/ssa-title42-values/sources/) — waits for registry +
// lock --write + flip (step 6, owner gate).
pub enum Ssa1191Term5000De3 {
    InitialPriceApplicabilityYear;
    PriceApplicabilityPeriod;
    MaximumFairPrice;
}
pub relation ssa_1191_term_meaning_asserted_5000De3(term: Ssa1191Term5000De3) kind empirical {
    label en unofficial "the section 1191 term carries its Social Security Act meaning (42 USC 1320f), case-asserted from the pinned text";
}
pub relation ssa_1191_term_applies_5000De3(term: Ssa1191Term5000De3) kind institutional {
    label en official "section 5000D(e)(3): the section 1191 term applies with its Social Security Act meaning";
}
@source(IRC_S5000D_E, relation = formalizes, coverage = partial, quote = "The terms \"initial price applicability year\", \"price applicability period\", and \"maximum fair price\" have the meaning given such terms in section 1191 of the Social Security Act.")
rule S5000DE3Ssa1191TermsApply(term: Ssa1191Term5000De3) strict {
    label en official "section 5000D(e)(3): the asserted section 1191 term meaning applies";
    when ssa_1191_term_meaning_asserted_5000De3(term);
    then ssa_1191_term_applies_5000De3(term);
}
pub relation applicable_percentage_5000D(s: DesignatedDrugSale, pct: Decimal) kind institutional {
    label en official "section 5000D(d): 65 percent (first 90 days), 75 percent (91st-180th), 85 percent (181st-270th), 95 percent (later)";
}
rule ApplicablePercentageFirst(s: DesignatedDrugSale, n: Integer) defeasible { label en official "5000D(d)(1)"; when drug_sale_on_noncompliance_day(s, n); when n >= 1; when n <= 90; then applicable_percentage_5000D(s, DrugFirstPeriodRate5000D); }
rule ApplicablePercentageSecond(s: DesignatedDrugSale, n: Integer) defeasible { label en official "5000D(d)(2)"; when drug_sale_on_noncompliance_day(s, n); when n >= 91; when n <= 180; then applicable_percentage_5000D(s, DrugSecondPeriodRate5000D); }
rule ApplicablePercentageThird(s: DesignatedDrugSale, n: Integer) defeasible { label en official "5000D(d)(3)"; when drug_sale_on_noncompliance_day(s, n); when n >= 181; when n <= 270; then applicable_percentage_5000D(s, DrugThirdPeriodRate5000D); }
rule ApplicablePercentageLater(s: DesignatedDrugSale, n: Integer) defeasible { label en official "5000D(d)(4)"; when drug_sale_on_noncompliance_day(s, n); when n >= 271; then applicable_percentage_5000D(s, DrugLaterPeriodRate5000D); }
@source(IRC_S5000D_A, coverage = exact, quote = "a tax in an amount such that the applicable percentage is equal to the ratio of—")
pub relation designated_drug_sale_tax(s: DesignatedDrugSale, seller: Person, amount: Money) kind institutional {
    label en official "section 5000D(a): the tax T with T ÷ (T + price) = the applicable percentage, i.e. T = price × p ÷ (1 − p)";
}
rule DesignatedDrugSaleTax(s: DesignatedDrugSale, seller: Person, price: Money, pct: Decimal) defeasible {
    label en official "section 5000D(a): T = price × p ÷ (1 − p); cents HALF_UP (JUDGMENT CALL)";
    when drug_is_designated_drug(s);
    when drug_sale_seller(s, seller);
    when drug_sale_price(s, price);
    when applicable_percentage_5000D(s, pct);
    then designated_drug_sale_tax(s, seller, div_round(price * pct, 1.0 - pct, 2, "HALF_UP"));
}
