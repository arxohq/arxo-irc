// 26 U.S.C. §§7509, 7510, 7512, 7513, 7514, 7516, 7517, 7520, 7521, 7522,
// 7523, 7524, 7525 (chapter 77 miscellaneous provisions). STAGE 3.
// (§§7511 and 7515 are repealed: only their notes remain, classified in the
// coverage file.)
//
// JUDGMENT CALLS
//  - "at least once a month" (§7509) and "not less often than annually"
//    (§7524) are periodic duties. `recurring` goals are reserved but not
//    parsed, so each is a `maintenance` goal over the whole window; the
//    periodicity itself is TECH-GAPS G3000.
//  - §7512(b)'s "second banking day" needs a bank-holiday calendar that no
//    package supplies; the deadline is a case-supplied date fact
//    (`second_banking_day_after`) that the duty window reads (G3001).
//  - §7517(a) "later of the request or the determination" is derived by two
//    mutually exclusive rules (no variable-arity max); the 45-day window
//    reads the derived trigger.
//  - §7520(a)(2): "rounded to the nearest 2/10ths of 1 percent" has no
//    tie rule in the text; HALF_UP is the corpus convention (JUDGMENT CALL).
//  - §7521 duties bind the IRS as an `Organ`; the individual officer or
//    employee is not an entity of the corpus.
//  - §7525's privilege is a legal protection of a communication, modelled as
//    an `immunity` of the taxpayer with the communication as protected effect.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    Asset,
    IRC_S7509,
    IRC_S7510,
    IRC_S7512_A,
    IRC_S7512_B,
    IRC_S7512_C,
    IRC_S7513_A,
    IRC_S7513_B,
    IRC_S7514,
    IRC_S7516,
    IRC_S7517_A,
    IRC_S7517_B,
    IRC_S7517_C,
    IRC_S7520_A,
    IRC_S7520_B,
    IRC_S7520_C,
    IRC_S7521_A,
    IRC_S7521_B,
    IRC_S7521_C,
    IRC_S7521_D,
    IRC_S7522_A,
    IRC_S7522_B,
    IRC_S7523_A,
    IRC_S7523_B,
    IRC_S7524,
    IRC_S7525_A,
    IRS,
    Organ,
    Person,
    Secretary,
};

// --- §7509: expenditures incurred by the United States Postal Service --------

const PostmasterGeneral: Organ = entity_ref("urn:us:irc:administration:clir#PostmasterGeneral") {
    label en official "The Postmaster General";
}
const PostalService: Organ = entity_ref("urn:us:irc:administration:clir#UnitedStatesPostalService") {
    label en official "the United States Postal Service";
}

relation postal_service_bears_chapter_21_duties(o: Organ) kind empirical {
    label en unofficial "the Postal Service performs duties, if any, imposed on it with respect to chapter 21 (FICA), incurring additional expenditures in the District of Columbia and elsewhere";
}
relation monthly_expenditure_statement_transferred(o: Organ) kind empirical {
    label en unofficial "a statement of the Postal Service's additional chapter 21 expenditures is transferred to the Treasury at least once a month";
}
relation sums_advanced_to_postal_service(o: Organ) kind empirical {
    label en unofficial "the Secretary advances to the credit of the Postal Service, from chapter 21 collection appropriations, the sums required for the additional expenditures";
}

@source(IRC_S7509, relation = formalizes, coverage = partial, quote = "shall at least once a month transfer to the Treasury of the United States a statement of the additional expenditures")
rule S7509PostmasterStatementDuty strict {
    for o: Organ;
    when postal_service_bears_chapter_21_duties(o);
    then duty S7509TransferMonthlyStatement {
        bearer PostmasterGeneral;
        beneficiary Secretary;
        goal maintenance {
            condition monthly_expenditure_statement_transferred(o);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7509, relation = formalizes, coverage = partial, quote = "the Secretary shall be authorized and directed to advance from time to time to the credit of the United States Postal Service")
rule S7509SecretaryAdvanceDuty strict {
    for o: Organ;
    when postal_service_bears_chapter_21_duties(o)
        and monthly_expenditure_statement_transferred(o);
    then duty S7509AdvanceSumsToPostalService {
        bearer Secretary;
        beneficiary o;
        goal maintenance {
            condition sums_advanced_to_postal_service(o);
            window [-infinity, infinity];
        }
    };
}

// --- §7510: duty-free purchase privilege extended to taxed domestic goods -----

relation domestic_article_subject_to_tax(a: Asset) kind empirical {
    label en unofficial "the article is of domestic production and subject to tax by the provisions of this title";
}
pub relation duty_free_purchase_privilege_extends_to(a: Asset) kind institutional {
    label en unofficial "the privilege of purchasing goods for the use of the United States duty free extends to this article, under the Secretary's regulations (§7510)";
}
@source(IRC_S7510, relation = formalizes, coverage = exact, quote = "shall be extended, under such regulations as the Secretary may prescribe, to all articles of domestic production which are subject to tax by the provisions of this title")
rule S7510PrivilegeExtension strict {
    for a: Asset;
    when domestic_article_subject_to_tax(a);
    then duty_free_purchase_privilege_extends_to(a);
}

// --- §7512: separate accounting for certain collected taxes --------------------

relation must_collect_account_and_pay_over_subtitle_c_or_ch33(p: Person) kind empirical {
    label en unofficial "the person is required to collect, account for, and pay over a tax imposed by subtitle C (employment taxes) or chapter 33 (communications and air transportation taxes)";
}
relation fails_to_collect_account_pay_or_deposit(p: Person) kind empirical {
    label en unofficial "at the time and in the manner prescribed by law or regulations the person fails to collect, truthfully account for, or pay over the tax, or fails to make deposits, payments, or returns of it";
}
relation notice_delivered_in_hand_to(p: Person) kind empirical {
    label en unofficial "a notice of the failure is delivered in hand to the person";
}
relation is_corporation_partnership_or_trust_with_officer(entity_p: Person, officer: Person) kind empirical {
    label en unofficial "the officer, partner, or trustee acts for the corporation, partnership, or trust";
}
relation notice_delivered_in_hand_to_officer(officer: Person) kind empirical {
    label en unofficial "notice of the failure is delivered in hand to this officer, partner, or trustee";
}
pub relation s7512_notice_delivered(p: Person) kind institutional {
    label en unofficial "a §7512(a) notice is deemed delivered to the person (directly, or through an officer, partner, or trustee for an entity)";
}
pub relation s7512_notification_cancelled(p: Person) kind institutional {
    label en unofficial "the Secretary has cancelled the §7512(a) notification";
}
pub relation s7512_separate_account_requirements_apply(p: Person) kind institutional {
    label en unofficial "the requirements of §7512(b) apply to the person: there was a failure, notice was delivered in hand, and the notification is not cancelled";
}

@source(IRC_S7512_A, relation = formalizes, coverage = exact, quote = "is notified, by notice delivered in hand to such person, of any such failure")
rule S7512NoticeDeliveredDirectly defeasible {
    for p: Person;
    when must_collect_account_and_pay_over_subtitle_c_or_ch33(p)
        and fails_to_collect_account_pay_or_deposit(p)
        and notice_delivered_in_hand_to(p);
    then s7512_notice_delivered(p);
}
@source(IRC_S7512_A, relation = formalizes, coverage = exact, quote = "In the case of a corporation, partnership, or trust, notice delivered in hand to an officer, partner, or trustee, shall, for purposes of this section, be deemed to be notice delivered in hand to such corporation, partnership, or trust")
rule S7512NoticeDeliveredThroughOfficer defeasible {
    for p: Person;
    for officer: Person;
    when must_collect_account_and_pay_over_subtitle_c_or_ch33(p)
        and fails_to_collect_account_pay_or_deposit(p)
        and is_corporation_partnership_or_trust_with_officer(p, officer)
        and notice_delivered_in_hand_to_officer(officer);
    then s7512_notice_delivered(p);
}
@source(IRC_S7512_A, relation = formalizes, coverage = exact, quote = "then all the requirements of subsection (b) shall be complied with")
rule S7512RequirementsApply defeasible {
    for p: Person;
    when s7512_notice_delivered(p);
    then s7512_separate_account_requirements_apply(p);
    unless s7512_notification_cancelled(p) and s7512_notice_delivered(p);
}

relation tax_collected_after_notice(p: Person, amount: Money, collected: Date) kind empirical {
    label en unofficial "the person collected this amount of the tax after the delivery of the §7512(a) notice, on the date shown";
}
relation second_banking_day_after(collected: Date, deadline: Date) kind empirical {
    label en unofficial "the second banking day after the collection date is the deadline date (no bank-holiday calendar is supplied; case-supplied, TECH-GAPS G3001)";
}
relation collects_taxes_becoming_collectible_after_notice(p: Person) kind empirical {
    label en unofficial "the person collects the taxes that become collectible after delivery of the notice";
}
relation deposited_in_separate_bank_account(p: Person, amount: Money) kind empirical {
    label en unofficial "the amount is deposited in a separate account in a bank (as defined in section 581)";
}
relation amount_kept_in_account_until_paid_over(p: Person, amount: Money) kind empirical {
    label en unofficial "the amount is kept in the separate account until payment over to the United States";
}
relation account_designated_special_fund_in_trust(p: Person) kind empirical {
    label en unofficial "the account is designated a special fund in trust for the United States, payable to the United States by the person as trustee";
}

@source(IRC_S7512_B, relation = formalizes, coverage = partial, quote = "shall collect the taxes imposed by subtitle C or chapter 33 which become collectible after delivery of such notice")
rule S7512CollectDuty defeasible {
    for p: Person;
    when s7512_separate_account_requirements_apply(p);
    then duty S7512CollectTaxesAfterNotice {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition collects_taxes_becoming_collectible_after_notice(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7512_B, relation = formalizes, coverage = partial, quote = "shall (not later than the end of the second banking day after any amount of such taxes is collected) deposit such amount in a separate account in a bank")
rule S7512DepositDuty defeasible {
    for p: Person;
    for amount: Money;
    for collected: Date;
    for deadline: Date;
    when s7512_separate_account_requirements_apply(p)
        and tax_collected_after_notice(p, amount, collected)
        and second_banking_day_after(collected, deadline);
    then duty S7512DepositInSeparateAccount {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition deposited_in_separate_bank_account(p, amount);
            window [collected, deadline];
        }
    };
}
@source(IRC_S7512_B, relation = formalizes, coverage = partial, quote = "shall keep the amount of such taxes in such account until payment over to the United States")
rule S7512KeepDuty defeasible {
    for p: Person;
    for amount: Money;
    for collected: Date;
    when s7512_separate_account_requirements_apply(p)
        and tax_collected_after_notice(p, amount, collected);
    then duty S7512KeepAmountInAccount {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition amount_kept_in_account_until_paid_over(p, amount);
            window [collected, infinity];
        }
    };
}
@source(IRC_S7512_B, relation = formalizes, coverage = partial, quote = "Any such account shall be designated as a special fund in trust for the United States, payable to the United States by such person as trustee.")
rule S7512DesignateAccountDuty defeasible {
    for p: Person;
    when s7512_separate_account_requirements_apply(p);
    then duty S7512DesignateAccountAsTrust {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition account_designated_special_fund_in_trust(p);
            window [-infinity, infinity];
        }
    };
}

external judgment relation secretary_satisfied_of_future_compliance(p: Person) {
    authority Secretary;
    label en unofficial "the Secretary is satisfied that all requirements of law and regulations with respect to the taxes will henceforth be complied with (§7512(c))";
}
relation secretary_cancels_notification(p: Person, takes_effect: Date) kind empirical {
    label en unofficial "the Secretary cancels the §7512(a) notification, the cancellation taking effect at the time specified in the notice of cancellation";
}
@source(IRC_S7512_C, relation = formalizes, coverage = exact, quote = "he may cancel such notification. Such cancellation shall take effect at such time as is specified in the notice of such cancellation.")
rule S7512CancelNotificationPower strict {
    for p: Person;
    for takes_effect: Date;
    when secretary_cancels_notification(p, takes_effect);
    then power S7512CancelNotification {
        holder Secretary;
        over p;
        exercise secretary_cancels_notification(p, takes_effect);
        valid_when secretary_satisfied_of_future_compliance(p);
        effect create(s7512_notification_cancelled(p));
        window [takes_effect, infinity];
    };
}

// --- §7513: reproduction of returns and other documents -----------------------

relation secretary_has_films_or_reproductions_made(doc: Asset) kind empirical {
    label en unofficial "the Secretary has a Federal agency or other person process films or photoimpressions of a return, document, or other matter, or make reproductions from them";
}
pub relation film_reproduction_authorized(doc: Asset) kind institutional {
    label en unofficial "the film, photoimpression, or reproduction is validly made at the Secretary's direction under §7513(a)";
}
@source(IRC_S7513_A, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to have any Federal agency or any person process films or other photoimpressions of any return, document, or other matter, and make reproductions from films or photoimpressions of any return, document, or other matter.")
rule S7513ReproductionPower strict {
    for doc: Asset;
    when secretary_has_films_or_reproductions_made(doc);
    then power S7513ReproductionAuthority {
        holder Secretary;
        over doc;
        exercise secretary_has_films_or_reproductions_made(doc);
        valid_when secretary_has_films_or_reproductions_made(doc);
        effect create(film_reproduction_authorized(doc));
    };
}
relation secretary_prescribes_safeguard_regulations(o: Organ) kind empirical {
    label en unofficial "the Secretary has prescribed regulations providing the safeguards necessary or appropriate to protect films, photoimpressions and reproductions against unauthorized use and their information against unauthorized disclosure";
}
@source(IRC_S7513_B, relation = formalizes, coverage = partial, quote = "The Secretary shall prescribe regulations which shall provide such safeguards as in the opinion of the Secretary are necessary or appropriate")
rule S7513SafeguardRegulationsDuty strict {
    when true;
    then duty S7513PrescribeSafeguards {
        bearer Secretary;
        goal maintenance {
            condition secretary_prescribes_safeguard_regulations(Secretary);
            window [-infinity, infinity];
        }
    };
}

// --- §7514: seals of office --------------------------------------------------

entity Seal {
    label en unofficial "a seal of office prescribed or modified under §7514";
}
relation secretary_prescribes_seal(s: Seal, o: Organ) kind empirical {
    label en unofficial "the Secretary prescribes or modifies the seal for the officer or employee to whom functions of the Secretary have been or may be delegated";
}
relation seal_facsimile_published_in_federal_register_with_regulations(s: Seal) kind empirical {
    label en unofficial "a facsimile of the seal is published in the Federal Register together with the regulations prescribing the seal and its affixation";
}
pub relation seal_prescribed(s: Seal) kind institutional {
    label en unofficial "the seal of office is validly prescribed by the Secretary under §7514";
}
pub relation judicial_notice_of_seal_taken(s: Seal) kind institutional {
    label en unofficial "judicial notice shall be taken of the seal (§7514, last sentence)";
}
@source(IRC_S7514, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to prescribe or modify seals of office for the district directors of internal revenue and other officers or employees of the Treasury Department")
rule S7514SealPower strict {
    for s: Seal;
    for o: Organ;
    when secretary_prescribes_seal(s, o);
    then power S7514PrescribeSeal {
        holder Secretary;
        over o;
        exercise secretary_prescribes_seal(s, o);
        valid_when secretary_prescribes_seal(s, o);
        effect create(seal_prescribed(s));
    };
}
@source(IRC_S7514, relation = formalizes, coverage = exact, quote = "Judicial notice shall be taken of any seal prescribed in accordance with this authority, a facsimile of which has been published in the Federal Register together with the regulations prescribing such seal and the affixation thereof.")
rule S7514JudicialNotice strict {
    for s: Seal;
    when seal_prescribed(s)
        and seal_facsimile_published_in_federal_register_with_regulations(s);
    then judicial_notice_of_seal_taken(s);
}

// --- §7516: training and training aids on request ----------------------------

entity TrainingRequest {
    label en unofficial "a written request by a State, possession, political subdivision, the District of Columbia, or a foreign government for admission of its employees or officials to IRS training courses or for texts and training aids";
}
relation training_request_in_writing(r: TrainingRequest) kind empirical {
    label en unofficial "the request is made in writing";
}
relation training_request_by_eligible_government(r: TrainingRequest) kind empirical {
    label en unofficial "the requester is a State, the Commonwealth of Puerto Rico, a possession, a political subdivision or instrumentality of any of them, the District of Columbia, or a foreign government";
}
relation secretary_admits_or_supplies(r: TrainingRequest) kind empirical {
    label en unofficial "the Secretary, in his discretion, admits the requester's employees or officials to the training courses and supplies texts and training aids";
}
pub relation training_or_aids_provided_under_7516(r: TrainingRequest) kind institutional {
    label en unofficial "the training or training aids were validly provided under §7516";
}
@source(IRC_S7516, relation = formalizes, coverage = exact, quote = "The Secretary is authorized within his discretion, upon written request, to admit employees and officials of any State, the Commonwealth of Puerto Rico, any possession of the United States")
rule S7516AdmitPower strict {
    for r: TrainingRequest;
    when secretary_admits_or_supplies(r);
    then power S7516TrainingAuthority {
        holder Secretary;
        over r;
        exercise secretary_admits_or_supplies(r);
        valid_when request_eligible_for_training(r);
        effect create(training_or_aids_provided_under_7516(r));
    };
}
relation request_eligible_for_training(r: TrainingRequest) kind derived {
    label en unofficial "the request is in writing and made by an eligible government (folded into one atom for `valid_when`)";
}
@source(IRC_S7516, relation = formalizes, coverage = exact, quote = "upon written request")
rule S7516EligibleRequest strict {
    for r: TrainingRequest;
    when training_request_in_writing(r)
        and training_request_by_eligible_government(r);
    then request_eligible_for_training(r);
}
relation secretary_requires_training_fee(r: TrainingRequest, fee: Money) kind empirical {
    label en unofficial "the Secretary requires the requester to pay the fee for the training and training aids supplied";
}
relation training_cost(r: TrainingRequest, cost: Money) kind empirical {
    label en unofficial "the cost of the training and training aids supplied to the requester";
}
relation fee_is_reasonable_and_within_cost(r: TrainingRequest, fee: Money) kind derived {
    label en unofficial "the fee does not exceed the cost of the training and training aids supplied (the \"reasonable fee\" upper bound of §7516)";
}
pub relation training_fee_required(r: TrainingRequest, fee: Money) kind institutional {
    label en unofficial "the requester is validly required to pay the fee under §7516";
}
@source(IRC_S7516, relation = formalizes, coverage = exact, quote = "a reasonable fee not to exceed the cost of the training and training aids supplied pursuant to such request")
rule S7516FeeCap strict {
    for r: TrainingRequest;
    for fee: Money;
    for cost: Money;
    when secretary_requires_training_fee(r, fee)
        and training_cost(r, cost)
        and fee <= cost;
    then fee_is_reasonable_and_within_cost(r, fee);
}
@source(IRC_S7516, relation = formalizes, coverage = exact, quote = "The Secretary may require payment from the party or parties making the request of a reasonable fee")
rule S7516FeePower strict {
    for r: TrainingRequest;
    for fee: Money;
    when secretary_requires_training_fee(r, fee);
    then power S7516RequireFee {
        holder Secretary;
        over r;
        exercise secretary_requires_training_fee(r, fee);
        valid_when fee_is_reasonable_and_within_cost(r, fee);
        effect create(training_fee_required(r, fee));
    };
}

// --- §7517: furnishing on request the valuation basis (estate and gift) ------

entity ValuationDetermination {
    label en unofficial "a Secretary determination or proposed determination of the value of an item of property for purposes of the tax imposed under chapter 11, 12, or 13";
}
relation valuation_determination_made_on(v: ValuationDetermination, d: Date) kind empirical {
    label en unofficial "the Secretary made the determination or proposed determination on this date";
}
relation written_valuation_request_made_on(v: ValuationDetermination, requester: Person, d: Date) kind empirical {
    label en unofficial "the executor, donor, or person required to make the chapter 13 return requests a written statement in writing on this date";
}
relation valuation_statement_trigger_date(v: ValuationDetermination, d: Date) kind derived {
    label en unofficial "the later of the date of the request and the date of the determination or proposed determination: the day from which the 45 days run";
}
@source(IRC_S7517_A, relation = formalizes, coverage = exact, quote = "not later than 45 days after the later of the date of such request or the date of such determination or proposed determination")
rule S7517TriggerIsRequestDate strict {
    for v: ValuationDetermination;
    for requester: Person;
    for req: Date;
    for det: Date;
    when written_valuation_request_made_on(v, requester, req)
        and valuation_determination_made_on(v, det)
        and req >= det;
    then valuation_statement_trigger_date(v, req);
}
@source(IRC_S7517_A, relation = formalizes, coverage = exact, quote = "not later than 45 days after the later of the date of such request or the date of such determination or proposed determination")
rule S7517TriggerIsDeterminationDate strict {
    for v: ValuationDetermination;
    for requester: Person;
    for req: Date;
    for det: Date;
    when written_valuation_request_made_on(v, requester, req)
        and valuation_determination_made_on(v, det)
        and det > req;
    then valuation_statement_trigger_date(v, det);
}
relation valuation_statement_furnished(v: ValuationDetermination, requester: Person) kind empirical {
    label en unofficial "the Secretary furnished the requester a written statement containing the material required by §7517(b)";
}
@source(IRC_S7517_A, relation = formalizes, coverage = exact, quote = "he shall furnish, on the written request of the executor, donor, or the person required to make the return of the tax imposed by chapter 13 (as the case may be), to such executor, donor, or person a written statement containing the material required by subsection (b)")
rule S7517FurnishStatementDuty defeasible {
    for v: ValuationDetermination;
    for requester: Person;
    for req: Date;
    for trigger: Date;
    when written_valuation_request_made_on(v, requester, req)
        and valuation_statement_trigger_date(v, trigger);
    then duty S7517FurnishValuationStatement {
        bearer Secretary;
        beneficiary requester;
        goal achievement {
            condition valuation_statement_furnished(v, requester);
            window [req, add_calendar_period(trigger, 45 calendar_day)];
        }
    };
}
relation statement_explains_valuation_basis(v: ValuationDetermination) kind empirical {
    label en unofficial "the statement explains the basis on which the valuation was determined or proposed (§7517(b)(1))";
}
relation statement_sets_forth_computation(v: ValuationDetermination) kind empirical {
    label en unofficial "the statement sets forth any computation used in arriving at the value (§7517(b)(2))";
}
relation statement_contains_expert_appraisal_copy(v: ValuationDetermination) kind empirical {
    label en unofficial "the statement contains a copy of any expert appraisal made by or for the Secretary (§7517(b)(3))";
}
pub relation valuation_statement_complete(v: ValuationDetermination) kind institutional {
    label en unofficial "the statement has all three elements of §7517(b) (basis, computation, appraisal copy)";
}
@source(IRC_S7517_B, relation = formalizes, coverage = exact, quote = "A statement required to be furnished under subsection (a) with respect to the value of an item of property shall—")
rule S7517StatementContents strict {
    for v: ValuationDetermination;
    when statement_explains_valuation_basis(v)
        and statement_sets_forth_computation(v)
        and statement_contains_expert_appraisal_copy(v);
    then valuation_statement_complete(v);
}
relation value_statement_furnished_for(v: ValuationDetermination) kind empirical {
    label en unofficial "a statement is furnished under §7517 with respect to the value determined or proposed and the method used";
}
relation law_otherwise_provides_binding_value(v: ValuationDetermination) kind empirical {
    label en unofficial "the law otherwise provides that the value determined or proposed, or the method used, is binding on the Secretary";
}
pub relation valuation_not_binding_on_secretary(v: ValuationDetermination) kind institutional {
    label en unofficial "the value determined or proposed, and the method used to arrive at it, are not binding on the Secretary (§7517(c))";
}
@source(IRC_S7517_C, relation = formalizes, coverage = exact, quote = "the value determined or proposed by the Secretary with respect to which a statement is furnished under this section, and the method used in arriving at such value, shall not be binding on the Secretary")
rule S7517NotBinding defeasible {
    for v: ValuationDetermination;
    when value_statement_furnished_for(v);
    then valuation_not_binding_on_secretary(v);
    unless law_otherwise_provides_binding_value(v) and value_statement_furnished_for(v);
}

// --- §7520: valuation tables for annuities, life and term interests ----------

entity Valuation {
    label en unofficial "a valuation, as of a valuation date, of an annuity, an interest for life or a term of years, or a remainder or reversionary interest";
}
entity ValuedInterest {
    label en unofficial "an annuity, an interest for life or a term of years, or a remainder or reversionary interest being valued";
}
enum PriorMonth {
    OneMonthBefore;
    TwoMonthsBefore;
}
relation valuation_of(v: Valuation, i: ValuedInterest) kind empirical {
    label en unofficial "the valuation concerns this interest";
}
relation valuation_is_for_excluded_provision(v: Valuation) kind empirical {
    label en unofficial "the valuation is for purposes of part I of subchapter D of chapter 1 or another provision specified in regulations (§7520(b))";
}
relation federal_midterm_rate_for_valuation_month(v: Valuation, rate: Decimal) kind empirical {
    label en unofficial "the Federal midterm rate in effect under section 1274(d)(1) for the month in which the valuation date falls, as a decimal fraction (owner: section 1274)";
}
relation federal_midterm_rate_for_prior_month(v: Valuation, m: PriorMonth, rate: Decimal) kind empirical {
    label en unofficial "the Federal midterm rate in effect under section 1274(d)(1) for the named month preceding the month of the valuation date";
}
relation charitable_contribution_allowable_for_part(v: Valuation) kind empirical {
    label en unofficial "an income, estate, or gift tax charitable contribution is allowable for any part of the property transferred";
}
relation valuation_taxpayer(v: Valuation, t: Person) kind empirical {
    label en unofficial "the person whose valuation it is, who may elect the prior-month rate";
}
relation taxpayer_elects_prior_month_rate(v: Valuation, m: PriorMonth) kind empirical {
    label en unofficial "the taxpayer elects to use the Federal midterm rate of the named preceding month";
}
pub relation prior_month_rate_election_effective(v: Valuation, m: PriorMonth) kind institutional {
    label en unofficial "the election to use the Federal midterm rate of the preceding month is validly made";
}
pub relation section_7520_applies(v: Valuation) kind derived {
    label en unofficial "section 7520 governs the valuation (no §7520(b) exclusion)";
}
pub relation section_7520_interest_rate(v: Valuation, rate: Decimal) kind institutional {
    label en unofficial "the interest rate for §7520 valuation tables: 120 percent of the Federal midterm rate, rounded to the nearest 2/10ths of 1 percent";
}

@source(IRC_S7520_B, relation = formalizes, coverage = exact, quote = "This section shall not apply for purposes of part I of subchapter D of chapter 1 or any other provision specified in regulations.")
rule S7520Applies defeasible {
    for v: Valuation;
    for i: ValuedInterest;
    when valuation_of(v, i);
    then section_7520_applies(v);
    unless valuation_is_for_excluded_provision(v) and valuation_of(v, i);
}
@source(IRC_S7520_A, relation = formalizes, coverage = exact, quote = "by using an interest rate (rounded to the nearest 2/10ths of 1 percent) equal to 120 percent of the Federal midterm rate in effect under section 1274(d)(1) for the month in which the valuation date falls")
rule S7520RateForValuationMonth defeasible {
    for v: Valuation;
    for mid: Decimal;
    when section_7520_applies(v)
        and federal_midterm_rate_for_valuation_month(v, mid);
    then section_7520_interest_rate(v, round(mid * 1.2 / 0.002, 0, "HALF_UP") * 0.002);
    unless prior_month_rate_election_effective(v, OneMonthBefore) and federal_midterm_rate_for_valuation_month(v, mid);
    unless prior_month_rate_election_effective(v, TwoMonthsBefore) and federal_midterm_rate_for_valuation_month(v, mid);
}
@source(IRC_S7520_A, relation = formalizes, coverage = exact, quote = "the taxpayer may elect to use such Federal midterm rate for either of the 2 months preceding the month in which the valuation date falls")
rule S7520ElectionPower strict {
    for v: Valuation;
    for m: PriorMonth;
    for t: Person;
    when taxpayer_elects_prior_month_rate(v, m)
        and valuation_taxpayer(v, t);
    then power S7520ElectPriorMonthRate {
        holder t;
        over Secretary;
        exercise taxpayer_elects_prior_month_rate(v, m);
        valid_when charitable_contribution_allowable_for_part(v);
        effect create(prior_month_rate_election_effective(v, m));
    };
}
@source(IRC_S7520_A, relation = formalizes, coverage = exact, quote = "the taxpayer may elect to use such Federal midterm rate for either of the 2 months preceding the month in which the valuation date falls")
rule S7520RateForElectedMonth defeasible {
    for v: Valuation;
    for m: PriorMonth;
    for mid: Decimal;
    when section_7520_applies(v)
        and prior_month_rate_election_effective(v, m)
        and federal_midterm_rate_for_prior_month(v, m, mid);
    then section_7520_interest_rate(v, round(mid * 1.2 / 0.002, 0, "HALF_UP") * 0.002);
}
relation same_rate_used_for_each_interest(v: Valuation) kind empirical {
    label en unofficial "in a transfer of more than one interest in the same property with respect to which the taxpayer may use the same rate, the taxpayer uses the same rate for each interest";
}
relation transfer_of_more_than_one_interest_in_same_property(v: Valuation) kind empirical {
    label en unofficial "more than one interest in the same property is transferred and the taxpayer may use the same rate for each";
}
@source(IRC_S7520_A, relation = formalizes, coverage = exact, quote = "the taxpayer shall use the same rate with respect to each such interest")
rule S7520SameRateDuty defeasible {
    for v: Valuation;
    for t: Person;
    when transfer_of_more_than_one_interest_in_same_property(v)
        and valuation_taxpayer(v, t);
    then duty S7520UseSameRateForEachInterest {
        bearer t;
        beneficiary Secretary;
        goal achievement {
            condition same_rate_used_for_each_interest(v);
            window [-infinity, infinity];
        }
    };
}
relation secretary_prescribed_tables_with_factors_for_rate_categories(o: Organ) kind empirical {
    label en unofficial "the tables prescribed by the Secretary contain valuation factors for a series of interest rate categories (§7520(c)(1))";
}
relation secretary_revised_tables_for_recent_mortality(o: Organ) kind empirical {
    label en unofficial "the Secretary revised the tables for the most recent available mortality experience, not less frequently than once each 10 years (§7520(c)(2)); periodicity is TECH-GAPS G3000";
}
@source(IRC_S7520_C, relation = formalizes, coverage = exact, quote = "The tables prescribed by the Secretary for purposes of subsection (a) shall contain valuation factors for a series of interest rate categories.")
rule S7520TablesContentDuty strict {
    when true;
    then duty S7520TablesHaveRateCategoryFactors {
        bearer Secretary;
        goal maintenance {
            condition secretary_prescribed_tables_with_factors_for_rate_categories(Secretary);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7520_C, relation = formalizes, coverage = exact, quote = "Such tables shall be revised not less frequently than once each 10 years to take into account the most recent mortality experience available as of the time of the revision.")
rule S7520TablesRevisionDuty strict {
    when true;
    then duty S7520ReviseTablesForMortality {
        bearer Secretary;
        goal maintenance {
            condition secretary_revised_tables_for_recent_mortality(Secretary);
            window [-infinity, infinity];
        }
    };
}

// --- §7521: procedures involving taxpayer interviews -----------------------

entity Interview {
    label en unofficial "an interview between the Internal Revenue Service and a taxpayer";
}
relation interview_of(i: Interview, t: Person) kind empirical {
    label en unofficial "the interview is with this taxpayer";
}
relation in_person_interview_on_determination_or_collection(i: Interview) kind empirical {
    label en unofficial "the interview is in person and relates to the determination or collection of a tax";
}
relation interview_for_determination_of_tax(i: Interview) kind empirical {
    label en unofficial "the in-person interview relates to the determination of a tax (audit)";
}
relation interview_for_collection_of_tax(i: Interview) kind empirical {
    label en unofficial "the in-person interview relates to the collection of a tax";
}
relation interview_initiated_by_administrative_summons(i: Interview) kind empirical {
    label en unofficial "the interview was initiated by an administrative summons issued under subchapter A of chapter 78";
}
relation criminal_or_integrity_investigation(i: Interview) kind empirical {
    label en unofficial "the interview belongs to a criminal investigation or an investigation relating to the integrity of an IRS officer or employee (§7521(d))";
}
relation taxpayer_requested_recording_in_advance(i: Interview) kind empirical {
    label en unofficial "the taxpayer, upon advance request, seeks to make an audio recording at the taxpayer's own expense and with the taxpayer's own equipment";
}
relation taxpayer_allowed_audio_recording(i: Interview) kind empirical {
    label en unofficial "the IRS officer or employee allows the taxpayer to make the audio recording";
}
pub relation s7521_applies_to(i: Interview) kind derived {
    label en unofficial "§7521 applies to the interview: not a criminal or integrity investigation (§7521(d))";
}
@source(IRC_S7521_D, relation = formalizes, coverage = exact, quote = "This section shall not apply to criminal investigations or investigations relating to the integrity of any officer or employee of the Internal Revenue Service.")
rule S7521Applies defeasible {
    for i: Interview;
    when in_person_interview_on_determination_or_collection(i);
    then s7521_applies_to(i);
    unless criminal_or_integrity_investigation(i) and in_person_interview_on_determination_or_collection(i);
}
@source(IRC_S7521_A, relation = formalizes, coverage = exact, quote = "shall, upon advance request of such taxpayer, allow the taxpayer to make an audio recording of such interview at the taxpayer's own expense and with the taxpayer's own equipment")
rule S7521AllowTaxpayerRecordingDuty defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and taxpayer_requested_recording_in_advance(i);
    then duty S7521AllowTaxpayerAudioRecording {
        bearer IRS;
        beneficiary t;
        goal achievement {
            condition taxpayer_allowed_audio_recording(i);
            window [-infinity, infinity];
        }
    };
}
relation irs_informs_taxpayer_before_interview_of_recording(i: Interview) kind empirical {
    label en unofficial "the IRS informs the taxpayer of its own recording prior to the interview";
}
relation irs_records_interview(i: Interview) kind empirical {
    label en unofficial "the IRS officer or employee records the interview";
}
@source(IRC_S7521_A, relation = formalizes, coverage = exact, quote = "An officer or employee of the Internal Revenue Service may record any interview described in paragraph (1) if such officer or employee—")
rule S7521IrsMayRecord defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and irs_records_interview(i);
    then prohibition S7521NoUnnoticedIrsRecording {
        bearer IRS;
        beneficiary t;
        action irs_records_interview(i);
        window [-infinity, infinity];
    };
    unless irs_informs_taxpayer_before_interview_of_recording(i) and s7521_applies_to(i) and interview_of(i, t);
}
relation taxpayer_requests_copy_and_reimburses(i: Interview) kind empirical {
    label en unofficial "the taxpayer requests a transcript or copy of the IRS recording and provides reimbursement for the cost of transcription and reproduction";
}
relation irs_provides_transcript_or_copy(i: Interview) kind empirical {
    label en unofficial "the IRS provides the taxpayer the transcript or copy of its recording";
}
@source(IRC_S7521_A, relation = formalizes, coverage = exact, quote = "upon request of the taxpayer, provides the taxpayer with a transcript or copy of such recording but only if the taxpayer provides reimbursement for the cost of the transcription and reproduction of such transcript or copy")
rule S7521TranscriptDuty defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and irs_records_interview(i)
        and irs_informs_taxpayer_before_interview_of_recording(i)
        and taxpayer_requests_copy_and_reimburses(i);
    then duty S7521ProvideTranscriptOrCopy {
        bearer IRS;
        beneficiary t;
        goal achievement {
            condition irs_provides_transcript_or_copy(i);
            window [-infinity, infinity];
        }
    };
}
relation irs_explains_audit_process_and_rights(i: Interview) kind empirical {
    label en unofficial "the IRS explains the audit process and the taxpayer's rights under it before or at the initial interview";
}
relation irs_explains_collection_process_and_rights(i: Interview) kind empirical {
    label en unofficial "the IRS explains the collection process and the taxpayer's rights under it before or at the initial interview";
}
relation initial_interview(i: Interview) kind empirical {
    label en unofficial "this is the initial interview with the taxpayer";
}
@source(IRC_S7521_B, relation = formalizes, coverage = exact, quote = "an explanation of the audit process and the taxpayer's rights under such process")
rule S7521ExplainAuditDuty defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and initial_interview(i)
        and interview_for_determination_of_tax(i);
    then duty S7521ExplainAuditProcess {
        bearer IRS;
        beneficiary t;
        goal achievement {
            condition irs_explains_audit_process_and_rights(i);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7521_B, relation = formalizes, coverage = exact, quote = "an explanation of the collection process and the taxpayer's rights under such process")
rule S7521ExplainCollectionDuty defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and initial_interview(i)
        and interview_for_collection_of_tax(i);
    then duty S7521ExplainCollectionProcess {
        bearer IRS;
        beneficiary t;
        goal achievement {
            condition irs_explains_collection_process_and_rights(i);
            window [-infinity, infinity];
        }
    };
}
relation taxpayer_clearly_states_wish_to_consult_representative(i: Interview) kind empirical {
    label en unofficial "the taxpayer clearly states at any time during the interview a wish to consult an attorney, certified public accountant, enrolled agent, enrolled actuary, or other person permitted to represent the taxpayer before the IRS";
}
relation interview_suspended(i: Interview) kind empirical {
    label en unofficial "the IRS officer or employee suspends the interview";
}
@source(IRC_S7521_B, relation = formalizes, coverage = exact, quote = "such officer or employee shall suspend such interview regardless of whether the taxpayer may have answered one or more questions")
rule S7521SuspendOnConsultationDuty defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and interview_of(i, t)
        and taxpayer_clearly_states_wish_to_consult_representative(i);
    then duty S7521SuspendInterviewForConsultation {
        bearer IRS;
        beneficiary t;
        goal achievement {
            condition interview_suspended(i);
            window [-infinity, infinity];
        }
    };
    unless interview_initiated_by_administrative_summons(i) and s7521_applies_to(i) and interview_of(i, t);
}

// (c) representatives holding a power of attorney
relation representative_may_be_authorized(rep: Person) kind derived {
    label en unofficial "the representative is an attorney, CPA, enrolled agent, enrolled actuary, or other person permitted to represent the taxpayer, not disbarred or suspended from practice before the IRS, and holds a written power of attorney executed by the taxpayer";
}
relation permitted_to_represent_before_irs(rep: Person) kind empirical {
    label en unofficial "the person is permitted to represent taxpayers before the Internal Revenue Service";
}
relation not_disbarred_or_suspended_from_irs_practice(rep: Person) kind empirical {
    label en unofficial "the person is not disbarred or suspended from practice before the Internal Revenue Service";
}
relation written_power_of_attorney_executed_by(rep: Person, t: Person) kind empirical {
    label en unofficial "the representative has a written power of attorney executed by the taxpayer";
}
relation taxpayer_authorizes_representative_at_interview(rep: Person, t: Person, i: Interview) kind empirical {
    label en unofficial "the taxpayer authorizes the representative to represent the taxpayer in the interview";
}
pub relation representative_authorized_at_interview(rep: Person, t: Person, i: Interview) kind institutional {
    label en unofficial "the representative is validly authorized to represent the taxpayer at the interview (§7521(c))";
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "may be authorized by such taxpayer to represent the taxpayer in any interview described in subsection (a)")
rule S7521RepresentativeQualifies strict {
    for rep: Person;
    when permitted_to_represent_before_irs(rep)
        and not_disbarred_or_suspended_from_irs_practice(rep);
    then representative_may_be_authorized(rep);
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "may be authorized by such taxpayer to represent the taxpayer in any interview described in subsection (a)")
rule S7521AuthorizeRepresentativePower strict {
    for rep: Person;
    for t: Person;
    for i: Interview;
    when taxpayer_authorizes_representative_at_interview(rep, t, i);
    then power S7521AuthorizeRepresentative {
        holder t;
        over rep;
        exercise taxpayer_authorizes_representative_at_interview(rep, t, i);
        valid_when representative_qualified_with_power_of_attorney(rep, t);
        effect create(representative_authorized_at_interview(rep, t, i));
    };
}
relation representative_qualified_with_power_of_attorney(rep: Person, t: Person) kind derived {
    label en unofficial "the representative is qualified and holds the taxpayer's written power of attorney (folded into one atom for `valid_when`)";
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "who is not disbarred or suspended from practice before the Internal Revenue Service and who has a written power of attorney executed by the taxpayer")
rule S7521QualifiedWithPoa strict {
    for rep: Person;
    for t: Person;
    when representative_may_be_authorized(rep)
        and written_power_of_attorney_executed_by(rep, t);
    then representative_qualified_with_power_of_attorney(rep, t);
}
relation irs_requires_taxpayer_to_accompany_representative(i: Interview, t: Person) kind empirical {
    label en unofficial "an IRS officer or employee requires the taxpayer to accompany the representative to the interview";
}
relation administrative_summons_issued_to_taxpayer(i: Interview, t: Person) kind empirical {
    label en unofficial "an administrative summons under subchapter A of chapter 78 was issued to the taxpayer for the interview";
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "An officer or employee of the Internal Revenue Service may not require a taxpayer to accompany the representative in the absence of an administrative summons issued to the taxpayer under subchapter A of chapter 78.")
rule S7521NoRequiredAccompanimentProhibition defeasible {
    for i: Interview;
    for t: Person;
    when s7521_applies_to(i)
        and irs_requires_taxpayer_to_accompany_representative(i, t);
    then prohibition S7521NoRequiredAccompaniment {
        bearer IRS;
        beneficiary t;
        action irs_requires_taxpayer_to_accompany_representative(i, t);
        window [-infinity, infinity];
    };
    unless administrative_summons_issued_to_taxpayer(i, t) and s7521_applies_to(i) and irs_requires_taxpayer_to_accompany_representative(i, t);
}
relation supervisor_consents_to_direct_notice(i: Interview) kind empirical {
    label en unofficial "the immediate supervisor of the officer or employee consents to direct notice to the taxpayer of the officer's belief that the representative is responsible for unreasonable delay or hindrance";
}
relation officer_believes_representative_delays_or_hinders(i: Interview) kind empirical {
    label en unofficial "the officer or employee believes the representative is responsible for unreasonable delay or hindrance of the IRS examination or investigation";
}
relation officer_notifies_taxpayer_directly(i: Interview, t: Person) kind empirical {
    label en unofficial "the officer or employee notifies the taxpayer directly of that belief";
}
pub relation direct_notice_of_representative_delay_permitted(i: Interview, t: Person) kind institutional {
    label en unofficial "the direct notice to the taxpayer about the representative's delay or hindrance is validly given (§7521(c), last sentence)";
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "with the consent of the immediate supervisor of such officer or employee, may notify the taxpayer directly that such officer or employee believes such representative is responsible for unreasonable delay or hindrance")
rule S7521DirectNoticePower strict {
    for i: Interview;
    for t: Person;
    when officer_notifies_taxpayer_directly(i, t);
    then power S7521NotifyTaxpayerDirectly {
        holder IRS;
        over t;
        exercise officer_notifies_taxpayer_directly(i, t);
        valid_when direct_notice_conditions_met(i);
        effect create(direct_notice_of_representative_delay_permitted(i, t));
    };
}
relation direct_notice_conditions_met(i: Interview) kind derived {
    label en unofficial "the officer believes the representative causes unreasonable delay or hindrance and the immediate supervisor consents";
}
@source(IRC_S7521_C, relation = formalizes, coverage = exact, quote = "with the consent of the immediate supervisor of such officer or employee")
rule S7521DirectNoticeConditions strict {
    for i: Interview;
    when officer_believes_representative_delays_or_hinders(i)
        and supervisor_consents_to_direct_notice(i);
    then direct_notice_conditions_met(i);
}

// --- §7522: content of tax due, deficiency and other notices -------------------

enum S7522NoticeCategory {
    TaxDueOrDeficiencyNotice;
    InformationReturnMatchingNotice;
    FirstLetterOfProposedDeficiencyWithAppealsReview;
}
entity CoveredNotice {
    label en unofficial "a notice the Secretary sends, of a kind possibly covered by §7522";
}
relation notice_category(n: CoveredNotice, c: S7522NoticeCategory) kind empirical {
    label en unofficial "the notice is a tax due or deficiency notice described in section 6155, 6212, or 6303; a notice generated out of an information return matching program; or the first letter of proposed deficiency allowing administrative review in the Independent Office of Appeals";
}
relation notice_describes_basis_and_identifies_amounts(n: CoveredNotice) kind empirical {
    label en unofficial "the notice describes the basis for, and identifies the amounts (if any) of, the tax due, interest, additional amounts, additions to the tax, and assessable penalties included in it";
}
pub relation s7522_applies_to_notice(n: CoveredNotice) kind derived {
    label en unofficial "the notice is of a category to which §7522 applies";
}
@source(IRC_S7522_B, relation = formalizes, coverage = exact, quote = "This section shall apply to—")
rule S7522CoveredCategoryOne strict {
    for n: CoveredNotice;
    when notice_category(n, TaxDueOrDeficiencyNotice);
    then s7522_applies_to_notice(n);
}
@source(IRC_S7522_B, relation = formalizes, coverage = exact, quote = "any notice generated out of any information return matching program")
rule S7522CoveredCategoryTwo strict {
    for n: CoveredNotice;
    when notice_category(n, InformationReturnMatchingNotice);
    then s7522_applies_to_notice(n);
}
@source(IRC_S7522_B, relation = formalizes, coverage = exact, quote = "the 1st letter of proposed deficiency which allows the taxpayer an opportunity for administrative review in the Internal Revenue Service Independent Office of Appeals")
rule S7522CoveredCategoryThree strict {
    for n: CoveredNotice;
    when notice_category(n, FirstLetterOfProposedDeficiencyWithAppealsReview);
    then s7522_applies_to_notice(n);
}
@source(IRC_S7522_A, relation = formalizes, coverage = exact, quote = "Any notice to which this section applies shall describe the basis for, and identify the amounts (if any) of, the tax due, interest, additional amounts, additions to the tax, and assessable penalties included in such notice.")
rule S7522DescribeBasisDuty defeasible {
    for n: CoveredNotice;
    when s7522_applies_to_notice(n);
    then duty S7522DescribeBasisAndAmounts {
        bearer Secretary;
        goal achievement {
            condition notice_describes_basis_and_identifies_amounts(n);
            window [-infinity, infinity];
        }
    };
}
relation notice_inadequately_describes_basis(n: CoveredNotice) kind empirical {
    label en unofficial "the notice's description of the basis and amounts is inadequate";
}
relation notice_validity_recognised(n: CoveredNotice) kind empirical {
    label en unofficial "the notice is otherwise valid";
}
pub relation notice_remains_valid_despite_inadequate_description(n: CoveredNotice) kind institutional {
    label en unofficial "an inadequate description under §7522(a) does not invalidate the notice";
}
@source(IRC_S7522_A, relation = formalizes, coverage = exact, quote = "An inadequate description under the preceding sentence shall not invalidate such notice.")
rule S7522InadequacyDoesNotInvalidate strict {
    for n: CoveredNotice;
    when s7522_applies_to_notice(n)
        and notice_inadequately_describes_basis(n)
        and notice_validity_recognised(n);
    then notice_remains_valid_despite_inadequate_description(n);
}

// --- §7523: graphs in the instructions for individual income tax returns ----

entity FormInstructionBooklet {
    label en unofficial "a booklet of instructions for Form 1040, 1040A, or 1040EZ prepared by the Secretary for filing individual income tax returns for taxable years beginning in a calendar year";
}
relation booklet_prepared_by_secretary(b: FormInstructionBooklet) kind empirical {
    label en unofficial "the Secretary prepared the booklet";
}
enum MajorOutlayCategory {
    DefenseVeteransAndForeignAffairs;
    SocialSecurityMedicareAndOtherRetirement;
    PhysicalHumanAndCommunityDevelopment;
    SocialPrograms;
    LawEnforcementAndGeneralGovernment;
    InterestOnTheDebt;
}
enum MajorIncomeCategory {
    SocialSecurityMedicareUnemploymentAndOtherRetirementTaxes;
    PersonalIncomeTaxes;
    CorporateIncomeTaxes;
    BorrowingToCoverTheDeficit;
    ExciseCustomsEstateGiftAndMiscellaneousTaxes;
}
enum OutlayGraphFootnote {
    DefenseVeteransForeignAffairsPercentages;
    PhysicalHumanCommunityDevelopmentComposition;
    SocialProgramsPercentages;
}
relation booklet_includes_outlay_pie_graph_prominently(b: FormInstructionBooklet) kind empirical {
    label en unofficial "the booklet includes in a prominent place a pie-shaped graph of the relative sizes of the major outlay categories";
}
relation booklet_includes_income_pie_graph_prominently(b: FormInstructionBooklet) kind empirical {
    label en unofficial "the booklet includes in a prominent place a pie-shaped graph of the relative sizes of the major income categories";
}
relation outlay_graph_shows_category(b: FormInstructionBooklet, c: MajorOutlayCategory) kind empirical {
    label en unofficial "the outlay graph shows the named major outlay category (§7523(b)(1))";
}
relation income_graph_shows_category(b: FormInstructionBooklet, c: MajorIncomeCategory) kind empirical {
    label en unofficial "the income graph shows the named major income category (§7523(b)(2))";
}
relation outlay_graph_has_footnote(b: FormInstructionBooklet, f: OutlayGraphFootnote) kind empirical {
    label en unofficial "the outlay graph carries the named footnote required by §7523(b)(3)";
}
relation booklet_graphs_use_latest_complete_fiscal_year_data(b: FormInstructionBooklet) kind empirical {
    label en unofficial "the graphs are based on data for the most recent fiscal year for which complete data is available when the instructions are completed";
}
pub relation outlay_graph_shows_all_major_categories(b: FormInstructionBooklet) kind derived {
    label en unofficial "the outlay graph shows all six major outlay categories";
}
pub relation income_graph_shows_all_major_categories(b: FormInstructionBooklet) kind derived {
    label en unofficial "the income graph shows all five major income categories";
}
pub relation outlay_graph_has_all_required_footnotes(b: FormInstructionBooklet) kind derived {
    label en unofficial "the outlay graph carries all three footnotes of §7523(b)(3)(A)-(C)";
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The term \"major outlay categories\" means the following:")
rule S7523AllOutlayCategoriesShown strict {
    for b: FormInstructionBooklet;
    when outlay_graph_shows_category(b, DefenseVeteransAndForeignAffairs)
        and outlay_graph_shows_category(b, SocialSecurityMedicareAndOtherRetirement)
        and outlay_graph_shows_category(b, PhysicalHumanAndCommunityDevelopment)
        and outlay_graph_shows_category(b, SocialPrograms)
        and outlay_graph_shows_category(b, LawEnforcementAndGeneralGovernment)
        and outlay_graph_shows_category(b, InterestOnTheDebt);
    then outlay_graph_shows_all_major_categories(b);
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The term \"major income categories\" means the following:")
rule S7523AllIncomeCategoriesShown strict {
    for b: FormInstructionBooklet;
    when income_graph_shows_category(b, SocialSecurityMedicareUnemploymentAndOtherRetirementTaxes)
        and income_graph_shows_category(b, PersonalIncomeTaxes)
        and income_graph_shows_category(b, CorporateIncomeTaxes)
        and income_graph_shows_category(b, BorrowingToCoverTheDeficit)
        and income_graph_shows_category(b, ExciseCustomsEstateGiftAndMiscellaneousTaxes);
    then income_graph_shows_all_major_categories(b);
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The pie-shaped graph showing the major outlay categories shall include the following footnotes:")
rule S7523AllFootnotesPresent strict {
    for b: FormInstructionBooklet;
    when outlay_graph_has_footnote(b, DefenseVeteransForeignAffairsPercentages)
        and outlay_graph_has_footnote(b, PhysicalHumanCommunityDevelopmentComposition)
        and outlay_graph_has_footnote(b, SocialProgramsPercentages);
    then outlay_graph_has_all_required_footnotes(b);
}
@source(IRC_S7523_A, relation = formalizes, coverage = exact, quote = "a pie-shaped graph showing the relative sizes of the major outlay categories")
rule S7523OutlayGraphDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523IncludeOutlayGraph {
        bearer Secretary;
        goal achievement {
            condition booklet_includes_outlay_pie_graph_prominently(b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7523_A, relation = formalizes, coverage = exact, quote = "a pie-shaped graph showing the relative sizes of the major income categories")
rule S7523IncomeGraphDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523IncludeIncomeGraph {
        bearer Secretary;
        goal achievement {
            condition booklet_includes_income_pie_graph_prominently(b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The pie-shaped graph showing the major outlay categories shall include the following footnotes:")
rule S7523OutlayCategoriesDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523ShowAllOutlayCategories {
        bearer Secretary;
        goal achievement {
            condition outlay_graph_shows_all_major_categories(b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The term \"major income categories\" means the following:")
rule S7523IncomeCategoriesDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523ShowAllIncomeCategories {
        bearer Secretary;
        goal achievement {
            condition income_graph_shows_all_major_categories(b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "The pie-shaped graph showing the major outlay categories shall include the following footnotes:")
rule S7523FootnotesDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523IncludeFootnotes {
        bearer Secretary;
        goal achievement {
            condition outlay_graph_has_all_required_footnotes(b);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7523_B, relation = formalizes, coverage = exact, quote = "shall be based on data for the most recent fiscal year for which complete data is available as of the completion of the preparation of the instructions by the Secretary")
rule S7523DataVintageDuty strict {
    for b: FormInstructionBooklet;
    when booklet_prepared_by_secretary(b);
    then duty S7523UseLatestCompleteData {
        bearer Secretary;
        goal achievement {
            condition booklet_graphs_use_latest_complete_fiscal_year_data(b);
            window [-infinity, infinity];
        }
    };
}

// --- §7524: annual notice of tax delinquency ----------------------------------

relation taxpayer_has_delinquent_account(t: Person) kind empirical {
    label en unofficial "the taxpayer has a tax delinquent account";
}
relation annual_delinquency_notice_sent(t: Person) kind empirical {
    label en unofficial "the Secretary sent the taxpayer, not less often than annually, a written notice of the amount of the tax delinquency as of the date of the notice";
}
@source(IRC_S7524, relation = formalizes, coverage = exact, quote = "Not less often than annually, the Secretary shall send a written notice to each taxpayer who has a tax delinquent account of the amount of the tax delinquency as of the date of the notice.")
rule S7524AnnualNoticeDuty defeasible {
    for t: Person;
    when taxpayer_has_delinquent_account(t);
    then duty S7524SendAnnualDelinquencyNotice {
        bearer Secretary;
        beneficiary t;
        goal maintenance {
            condition annual_delinquency_notice_sent(t);
            window [-infinity, infinity];
        }
    };
}

// --- §7525: confidentiality privileges for tax advice --------------------------

entity TaxCommunication {
    label en unofficial "a communication between a taxpayer and a federally authorized tax practitioner";
}
relation communication_between(c: TaxCommunication, t: Person, pr: Person) kind empirical {
    label en unofficial "the communication is between this taxpayer and this practitioner";
}
relation authorized_under_federal_law_to_practice_before_irs(pr: Person) kind empirical {
    label en unofficial "the individual is authorized under Federal law to practice before the IRS, such practice being subject to Federal regulation under section 330 of title 31, United States Code";
}
relation communication_is_tax_advice(c: TaxCommunication) kind empirical {
    label en unofficial "the communication is advice given by the individual with respect to a matter within the scope of the individual's authority to practice";
}
relation communication_would_be_privileged_with_attorney(c: TaxCommunication) kind empirical {
    label en unofficial "the communication would be considered privileged if it were between a taxpayer and an attorney (common-law protections of confidentiality)";
}
relation asserted_in_noncriminal_matter_before_irs(c: TaxCommunication) kind empirical {
    label en unofficial "the privilege is asserted in a noncriminal tax matter before the Internal Revenue Service";
}
relation asserted_in_noncriminal_federal_court_proceeding_with_us(c: TaxCommunication) kind empirical {
    label en unofficial "the privilege is asserted in a noncriminal tax proceeding in Federal court brought by or against the United States";
}
relation written_communication_in_tax_shelter_promotion(c: TaxCommunication) kind empirical {
    label en unofficial "the communication is written and in connection with the promotion of the direct or indirect participation of the person (or a director, officer, employee, agent, representative, or capital or profits interest holder) in a tax shelter (section 6662(d)(2)(C)(ii))";
}
pub relation federally_authorized_tax_practitioner(pr: Person) kind institutional {
    label en official "The term \"federally authorized tax practitioner\" means any individual who is authorized under Federal law to practice before the Internal Revenue Service if such practice is subject to Federal regulation under section 330 of title 31, United States Code.";
}
pub relation tax_communication_privileged(c: TaxCommunication) kind institutional {
    label en unofficial "the taxpayer-practitioner communication carries the same common-law confidentiality protection as a taxpayer-attorney communication (§7525(a)(1))";
}
@source(IRC_S7525_A, relation = formalizes, coverage = exact, quote = "The term \"federally authorized tax practitioner\" means any individual who is authorized under Federal law to practice before the Internal Revenue Service if such practice is subject to Federal regulation under section 330 of title 31, United States Code.")
rule S7525PractitionerDefinition strict {
    for pr: Person;
    when authorized_under_federal_law_to_practice_before_irs(pr);
    then federally_authorized_tax_practitioner(pr);
}
@source(IRC_S7525_A, relation = formalizes, coverage = exact, quote = "the same common law protections of confidentiality which apply to a communication between a taxpayer and an attorney shall also apply to a communication between a taxpayer and any federally authorized tax practitioner")
rule S7525PrivilegeImmunity defeasible {
    for c: TaxCommunication;
    for t: Person;
    for pr: Person;
    when communication_between(c, t, pr)
        and federally_authorized_tax_practitioner(pr)
        and communication_is_tax_advice(c)
        and communication_would_be_privileged_with_attorney(c)
        and asserted_in_noncriminal_matter_before_irs(c);
    then immunity S7525PractitionerPrivilege {
        holder t;
        protected_effect tax_communication_privileged(c);
        window [-infinity, infinity];
    };
    unless written_communication_in_tax_shelter_promotion(c) and communication_between(c, t, pr);
}
@source(IRC_S7525_A, relation = formalizes, coverage = exact, quote = "Paragraph (1) may only be asserted in—")
rule S7525PrivilegeImmunityInCourt defeasible {
    for c: TaxCommunication;
    for t: Person;
    for pr: Person;
    when communication_between(c, t, pr)
        and federally_authorized_tax_practitioner(pr)
        and communication_is_tax_advice(c)
        and communication_would_be_privileged_with_attorney(c)
        and asserted_in_noncriminal_federal_court_proceeding_with_us(c);
    then immunity S7525PractitionerPrivilegeInCourt {
        holder t;
        protected_effect tax_communication_privileged(c);
        window [-infinity, infinity];
    };
    unless written_communication_in_tax_shelter_promotion(c) and communication_between(c, t, pr);
}
