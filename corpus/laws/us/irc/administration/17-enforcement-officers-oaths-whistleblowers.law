// 26 U.S.C. §7608 (authority of internal revenue enforcement officers), §7621
// (internal revenue districts), §7622 (authority to administer oaths),
// §7623 (expenses of detection; awards to whistleblowers; anti-retaliation),
// §7624 (reimbursement to State and local law enforcement agencies).
// STAGE 3. (§7607 and §7641 are repealed.)
//
// JUDGMENT CALLS
//  - §7608 powers are held by an officer (a `Person` in the model) charged
//    with the enforcement duty; "reasonable grounds to believe" for a felony
//    arrest is a case fact of the officer's belief (no adjudicating authority
//    is named), not an external judgment.
//  - §7623(b): the Whistleblower Office determines the award; the statute
//    fixes only its bounds (15-30 percent; at most 10 percent for less
//    substantial contribution). The determination is a power whose valid_when
//    is "within the statutory bounds"; the amount inside the bounds depends on
//    the individual's substantial contribution (an evaluative determination of
//    the Office, DECISION-0194: external judgment).
//  - §7623(d)(1) causation ("in reprisal for") is an external judgment of the
//    Secretary of Labor (the adjudicating agency of the section).
//  - Rounding: cents HALF_UP (statute names none).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    Asset,
    Congress,
    DistrictCourt,
    IRC_S7608_A,
    IRC_S7608_B,
    IRC_S7608_C,
    IRC_S7621_A,
    IRC_S7622_A,
    IRC_S7622_B,
    IRC_S7623_A,
    IRC_S7623_B,
    IRC_S7623_C,
    IRC_S7623_D,
    IRC_S7624_A,
    IRC_S7624_B,
    IRC_S7624_C,
    IRS,
    Organ,
    Person,
    Secretary,
};

// --- §7608(a)-(b): enforcement officers ------------------------------------------------

relation officer_charged_with_subtitle_e_enforcement(o: Person) kind empirical {
    label en unofficial "the investigator, agent or other internal revenue officer is charged by the Secretary with the duty of enforcing the criminal, seizure or forfeiture provisions of subtitle E or of any other law pertaining to commodities subject to tax under that subtitle";
}
relation officer_is_intelligence_division_criminal_investigator(o: Person) kind empirical {
    label en unofficial "the criminal investigator of the Intelligence Division of the IRS is charged with enforcing the criminal provisions of the internal revenue laws or other laws for which the Secretary has delegated investigatory authority";
}
relation officer_carries_firearms(o: Person) kind empirical {
    label en unofficial "the officer carries firearms in the performance of the duty";
}
relation officer_executes_or_serves_process(o: Person, p: Person) kind empirical {
    label en unofficial "the officer executes or serves a search warrant or an arrest warrant, or serves a subpoena or summons issued under authority of the United States";
}
relation offense_committed_in_officers_presence(o: Person, p: Person) kind empirical {
    label en unofficial "the person arrested committed an offense against the United States in the officer's presence";
}
relation officer_has_reasonable_grounds_felony(o: Person, p: Person) kind empirical {
    label en unofficial "the officer has reasonable grounds to believe the person to be arrested has committed or is committing a felony cognizable under the laws of the United States (under the internal revenue laws, for a criminal investigator)";
}
relation officer_arrests_without_warrant(o: Person, p: Person) kind empirical {
    label en unofficial "the officer makes an arrest without a warrant";
}
relation officer_seizes_property_subject_to_forfeiture(o: Person, a: Asset) kind empirical {
    label en unofficial "the officer seizes property subject to forfeiture to the United States";
}
relation property_subject_to_forfeiture(a: Asset) kind empirical {
    label en unofficial "the property is subject to forfeiture to the United States (under the internal revenue laws, for a criminal investigator)";
}
relation warrantless_arrest_conditions_met(o: Person, p: Person) kind derived {
    label en unofficial "the offense was committed in the officer's presence, or the officer has reasonable grounds to believe the person committed or is committing a felony";
}
pub relation officer_process_service_authorized(o: Person, p: Person) kind institutional {
    label en unofficial "the officer's execution or service of the process is authorized under §7608";
}
pub relation warrantless_arrest_authorized(o: Person, p: Person) kind institutional {
    label en unofficial "the officer's arrest without a warrant is authorized under §7608";
}
pub relation forfeiture_seizure_authorized(o: Person, a: Asset) kind institutional {
    label en unofficial "the officer's seizure of property subject to forfeiture is authorized under §7608";
}
relation officer_within_7608(o: Person) kind derived {
    label en unofficial "the officer is charged with subtitle E enforcement (§7608(a)) or is an Intelligence Division criminal investigator (§7608(b))";
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "whom the Secretary charges with the duty of enforcing any of the criminal, seizure, or forfeiture provisions of subtitle E")
rule S7608OfficerSubtitleE strict {
    for o: Person;
    when officer_charged_with_subtitle_e_enforcement(o);
    then officer_within_7608(o);
}
@source(IRC_S7608_B, relation = formalizes, coverage = exact, quote = "Any criminal investigator of the Intelligence Division of the Internal Revenue Service whom the Secretary charges with the duty of enforcing any of the criminal provisions of the internal revenue laws")
rule S7608OfficerIntelligence strict {
    for o: Person;
    when officer_is_intelligence_division_criminal_investigator(o);
    then officer_within_7608(o);
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "(1) carry firearms;")
rule S7608CarryFirearmsLiberty defeasible {
    for o: Person;
    when officer_within_7608(o)
        and officer_carries_firearms(o);
    then liberty S7608OfficerMayCarryFirearms {
        holder o;
        against Secretary;
        action officer_carries_firearms(o);
        window [-infinity, infinity];
    };
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "execute and serve search warrants and arrest warrants, and serve subpoenas and summonses issued under authority of the United States")
rule S7608ProcessPower strict {
    for o: Person;
    for p: Person;
    when officer_executes_or_serves_process(o, p);
    then power S7608ExecuteAndServeProcess {
        holder o;
        over p;
        exercise officer_executes_or_serves_process(o, p);
        valid_when officer_within_7608(o);
        effect create(officer_process_service_authorized(o, p));
    };
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "make arrests without warrant for any offense against the United States committed in his presence")
rule S7608WarrantlessPresence strict {
    for o: Person;
    for p: Person;
    when offense_committed_in_officers_presence(o, p);
    then warrantless_arrest_conditions_met(o, p);
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "or for any felony cognizable under the laws of the United States if he has reasonable grounds to believe that the person to be arrested has committed, or is committing, such felony")
rule S7608WarrantlessFelony strict {
    for o: Person;
    for p: Person;
    when officer_has_reasonable_grounds_felony(o, p);
    then warrantless_arrest_conditions_met(o, p);
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "in respect to the performance of such duty, make arrests without warrant for any offense against the United States committed in his presence")
rule S7608WarrantlessArrestPower strict {
    for o: Person;
    for p: Person;
    when officer_arrests_without_warrant(o, p)
        and officer_within_7608(o);
    then power S7608ArrestWithoutWarrant {
        holder o;
        over p;
        exercise officer_arrests_without_warrant(o, p);
        valid_when warrantless_arrest_conditions_met(o, p);
        effect create(warrantless_arrest_authorized(o, p));
    };
}
@source(IRC_S7608_A, relation = formalizes, coverage = exact, quote = "in respect to the performance of such duty, make seizures of property subject to forfeiture to the United States")
rule S7608SeizurePower strict {
    for o: Person;
    for a: Asset;
    when officer_seizes_property_subject_to_forfeiture(o, a)
        and officer_within_7608(o);
    then power S7608SeizePropertySubjectToForfeiture {
        holder o;
        over a;
        exercise officer_seizes_property_subject_to_forfeiture(o, a);
        valid_when property_subject_to_forfeiture(a);
        effect create(forfeiture_seizure_authorized(o, a));
    };
}

// --- §7608(c): undercover operations ---------------------------------------------------------

entity UndercoverOperation {
    label en unofficial "an undercover investigative operation of the Internal Revenue Service necessary for the detection and prosecution of offenses under the internal revenue laws or other laws for which the Secretary has delegated investigatory authority";
}
enum UndercoverExemption {
    PurchaseOrLeasePropertyWithoutProcurementLaws;
    ProprietaryEntitiesWithoutGovernmentCorporationLaws;
    BankDepositWithoutRestrictedDepositLaws;
    ProceedsOffsetExpensesWithoutMiscellaneousReceiptsLaw;
}
enum CertifyingOfficial {
    CommissionerOfInternalRevenue;
    DeputyCommissionerDesignated;
    AssistantCommissionerDesignated;
    OtherOfficial;
}
relation service_uses_undercover_exemption(op: UndercoverOperation, x: UndercoverExemption) kind empirical {
    label en unofficial "the Service uses the named exemption in the operation";
}
relation operation_certified_by(op: UndercoverOperation, c: CertifyingOfficial) kind empirical {
    label en unofficial "the Commissioner (or, if designated by the Commissioner, the Deputy or an Assistant Commissioner) certified in writing that the action is necessary for the conduct of the operation";
}
relation undercover_certification_valid(op: UndercoverOperation) kind derived {
    label en unofficial "the written certification comes from the Commissioner or a designated Deputy or Assistant Commissioner";
}
pub relation undercover_exemption_applies(op: UndercoverOperation, x: UndercoverExemption) kind institutional {
    label en unofficial "the named §7608(c)(1) exemption validly applies to the operation";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "This paragraph shall apply only upon the written certification of the Commissioner of Internal Revenue (or, if designated by the Commissioner, the Deputy Commissioner or an Assistant Commissioner of Internal Revenue)")
rule S7608CertificationByCommissioner strict {
    for op: UndercoverOperation;
    when operation_certified_by(op, CommissionerOfInternalRevenue);
    then undercover_certification_valid(op);
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "the Deputy Commissioner or an Assistant Commissioner of Internal Revenue")
rule S7608CertificationByDeputy strict {
    for op: UndercoverOperation;
    when operation_certified_by(op, DeputyCommissionerDesignated);
    then undercover_certification_valid(op);
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "the Deputy Commissioner or an Assistant Commissioner of Internal Revenue")
rule S7608CertificationByAssistant strict {
    for op: UndercoverOperation;
    when operation_certified_by(op, AssistantCommissionerDesignated);
    then undercover_certification_valid(op);
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "sums authorized to be appropriated for the Service may be used—")
rule S7608ExemptionPower strict {
    for op: UndercoverOperation;
    for x: UndercoverExemption;
    when service_uses_undercover_exemption(op, x);
    then power S7608UseUndercoverExemption {
        holder IRS;
        over op;
        exercise service_uses_undercover_exemption(op, x);
        valid_when undercover_certification_valid(op);
        effect create(undercover_exemption_applies(op, x));
    };
}
relation entity_net_value_over_50000_disposed(op: UndercoverOperation, value: Money) kind empirical {
    label en unofficial "a corporation or business entity established or acquired as part of the operation, with a net value over $50,000, is to be liquidated, sold, or otherwise disposed of";
}
relation service_reports_disposition_to_secretary(op: UndercoverOperation) kind empirical {
    label en unofficial "the Service reports the circumstances to the Secretary as much in advance as the Commissioner determines practicable";
}
relation disposition_proceeds_deposited_as_miscellaneous_receipts(op: UndercoverOperation) kind empirical {
    label en unofficial "the proceeds of the liquidation, sale or other disposition, after obligations are met, are deposited in the Treasury as miscellaneous receipts";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "with a net value over $50,000 is to be liquidated, sold, or otherwise disposed of, the Service, as much in advance as the Commissioner or his delegate determines is practicable, shall report the circumstances to the Secretary")
rule S7608ReportDispositionDuty defeasible {
    for op: UndercoverOperation;
    for v: Money;
    when entity_net_value_over_50000_disposed(op, v)
        and v > 50000.00 USD;
    then duty S7608ReportEntityDisposition {
        bearer IRS;
        beneficiary Secretary;
        goal achievement {
            condition service_reports_disposition_to_secretary(op);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "The proceeds of the liquidation, sale, or other disposition, after obligations are met, shall be deposited in the Treasury of the United States as miscellaneous receipts.")
rule S7608DepositDispositionProceedsDuty defeasible {
    for op: UndercoverOperation;
    for v: Money;
    when entity_net_value_over_50000_disposed(op, v)
        and v > 50000.00 USD;
    then duty S7608DepositDispositionProceeds {
        bearer IRS;
        beneficiary Secretary;
        goal achievement {
            condition disposition_proceeds_deposited_as_miscellaneous_receipts(op);
            window [-infinity, infinity];
        }
    };
}
relation proceeds_no_longer_necessary_for_operation(op: UndercoverOperation) kind empirical {
    label en unofficial "the proceeds from an undercover operation for which actions were authorized and carried out under (1)(B) and (C) are no longer necessary for the conduct of the operation";
}
relation remaining_proceeds_deposited_in_treasury(op: UndercoverOperation) kind empirical {
    label en unofficial "the proceeds or the balance remaining are deposited into the Treasury as miscellaneous receipts";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "As soon as the proceeds from an undercover investigative operation with respect to which an action is authorized and carried out under subparagraphs (B) and (C) of paragraph (1) are no longer necessary for the conduct of such operation")
rule S7608DepositProceedsDuty defeasible {
    for op: UndercoverOperation;
    when proceeds_no_longer_necessary_for_operation(op);
    then duty S7608DepositRemainingProceeds {
        bearer IRS;
        beneficiary Secretary;
        goal achievement {
            condition remaining_proceeds_deposited_in_treasury(op);
            window [-infinity, infinity];
        }
    };
}
relation criminal_proceedings_concluded_on(op: UndercoverOperation, d: Date) kind empirical {
    label en unofficial "all criminal proceedings (other than appeals) concluded on this date";
}
relation covert_activities_concluded_on(op: UndercoverOperation, d: Date) kind empirical {
    label en unofficial "covert activities concluded on this date";
}
relation closure_date(op: UndercoverOperation, d: Date) kind derived {
    label en unofficial "the closure date: the later of the two conclusion dates";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "The term \"closed\" means the date on which the later of the following occurs;")
rule S7608ClosureIsLaterCriminal strict {
    for op: UndercoverOperation;
    for c: Date;
    for v: Date;
    when criminal_proceedings_concluded_on(op, c)
        and covert_activities_concluded_on(op, v)
        and c >= v;
    then closure_date(op, c);
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "whichever occurs later")
rule S7608ClosureIsLaterCovert strict {
    for op: UndercoverOperation;
    for c: Date;
    for v: Date;
    when criminal_proceedings_concluded_on(op, c)
        and covert_activities_concluded_on(op, v)
        and v > c;
    then closure_date(op, v);
}
relation service_conducted_financial_audit(op: UndercoverOperation) kind empirical {
    label en unofficial "the Service conducts a detailed financial audit of the closed operation";
}
relation audit_results_submitted_to_secretary(op: UndercoverOperation) kind empirical {
    label en unofficial "the Service submits the audit results in writing to the Secretary";
}
relation audit_report_submitted_to_congress(op: UndercoverOperation) kind empirical {
    label en unofficial "the Service submits a report to the Congress concerning the audit";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "The Service shall conduct a detailed financial audit of each undercover investigative operation which is closed in each fiscal year")
rule S7608AuditDuty defeasible {
    for op: UndercoverOperation;
    for d: Date;
    when closure_date(op, d);
    then duty S7608ConductFinancialAudit {
        bearer IRS;
        beneficiary Secretary;
        goal achievement {
            condition service_conducted_financial_audit(op);
            window [d, infinity];
        }
    };
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "submit the results of the audit in writing to the Secretary")
rule S7608SubmitAuditResultsDuty defeasible {
    for op: UndercoverOperation;
    for d: Date;
    when closure_date(op, d);
    then duty S7608SubmitAuditResultsToSecretary {
        bearer IRS;
        beneficiary Secretary;
        goal achievement {
            condition audit_results_submitted_to_secretary(op);
            window [d, infinity];
        }
    };
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "not later than 180 days after such undercover operation is closed, submit a report to the Congress concerning such audit")
rule S7608CongressReportDuty defeasible {
    for op: UndercoverOperation;
    for d: Date;
    when closure_date(op, d);
    then duty S7608ReportAuditToCongress {
        bearer IRS;
        beneficiary Congress;
        goal achievement {
            condition audit_report_submitted_to_congress(op);
            window [d, add_calendar_period(d, 180 calendar_day)];
        }
    };
}
relation annual_report_to_congress_submitted(o: Organ) kind empirical {
    label en unofficial "the Service submits an annual report to the Congress specifying, for its undercover investigative operations, the counts by program of those pending, commenced and closed, and for each pending or closed operation the beginning and certification dates, total expenditures and use of proceeds, a detailed description, and the results";
}
@source(IRC_S7608_C, relation = formalizes, coverage = exact, quote = "The Service shall also submit a report annually to the Congress specifying as to its undercover investigative operations—")
rule S7608AnnualReportDuty strict {
    when true;
    then duty S7608SubmitAnnualReportToCongress {
        bearer IRS;
        beneficiary Congress;
        goal maintenance {
            condition annual_report_to_congress_submitted(IRS);
            window [-infinity, infinity];
        }
    };
}

// --- §7621, §7622: districts and oaths ----------------------------------------------------------

const President: Organ = entity_ref("urn:us:irc:administration:clir#President") {
    label en official "The President";
}
entity RevenueDistrict {
    label en unofficial "an internal revenue district established for administering the internal revenue laws";
}
relation president_establishes_district(d: RevenueDistrict) kind empirical {
    label en unofficial "the President establishes or alters the internal revenue district, subdividing a State or the District of Columbia, or uniting two or more States";
}
pub relation internal_revenue_district_in_force(d: RevenueDistrict) kind institutional {
    label en unofficial "the internal revenue district is validly established or altered by the President (§7621)";
}
@source(IRC_S7621_A, relation = formalizes, coverage = exact, quote = "The President shall establish convenient internal revenue districts for the purpose of administering the internal revenue laws. The President may from time to time alter such districts.")
rule S7621DistrictPower strict {
    for d: RevenueDistrict;
    when president_establishes_district(d);
    then power S7621EstablishOrAlterDistrict {
        holder President;
        over d;
        exercise president_establishes_district(d);
        valid_when president_establishes_district(d);
        effect create(internal_revenue_district_in_force(d));
    };
}
relation officer_designated_by_secretary_for_oaths(o: Person) kind empirical {
    label en unofficial "the officer or employee of the Treasury Department is designated by the Secretary to administer oaths and certify papers";
}
relation officer_administers_oath_or_certifies(o: Person, matter: Person) kind empirical {
    label en unofficial "the officer administers an oath or affirmation or certifies a paper necessary under the internal revenue laws or regulations";
}
pub relation oath_or_certification_authorized(o: Person, matter: Person) kind institutional {
    label en unofficial "the administration of the oath or the certification is authorized under §7622(a)";
}
@source(IRC_S7622_A, relation = formalizes, coverage = exact, quote = "Every officer or employee of the Treasury Department designated by the Secretary for that purpose is authorized to administer such oaths or affirmations and to certify to such papers as may be necessary under the internal revenue laws or regulations made thereunder.")
rule S7622OathPower strict {
    for o: Person;
    for matter: Person;
    when officer_administers_oath_or_certifies(o, matter);
    then power S7622AdministerOathsAndCertify {
        holder o;
        over matter;
        exercise officer_administers_oath_or_certifies(o, matter);
        valid_when officer_designated_by_secretary_for_oaths(o);
        effect create(oath_or_certification_authorized(o, matter));
    };
}
relation oath_administered_by_person_authorized_for_general_purposes(o: Person) kind empirical {
    label en unofficial "the oath or affirmation is administered by a person authorized to administer oaths for general purposes by the law of the United States, of any State or possession, or of the District of Columbia where it is administered";
}
pub relation oath_valid_for_internal_revenue_purposes(o: Person) kind institutional {
    label en unofficial "an oath or affirmation required or authorized under an internal revenue law or regulation may be administered by any person authorized for general purposes where administered (§7622(b), not an exclusive enumeration)";
}
@source(IRC_S7622_B, relation = formalizes, coverage = exact, quote = "may be administered by any person authorized to administer oaths for general purposes by the law of the United States, or of any State or possession of the United States, or of the District of Columbia, wherein such oath or affirmation is administered")
rule S7622OtherOaths strict {
    for o: Person;
    when oath_administered_by_person_authorized_for_general_purposes(o);
    then oath_valid_for_internal_revenue_purposes(o);
}

// --- §7623: detection expenses, whistleblower awards, anti-retaliation -------------------------------------

const WhistleblowerOffice: Organ = entity_ref("urn:us:irc:administration:clir#WhistleblowerOffice") {
    label en official "the Whistleblower Office";
}
entity WhistleblowerClaim {
    label en unofficial "a claim for an award under §7623(b) by an individual whose information the Secretary acted on";
}
entity ProceedsItem {
    label en unofficial "an amount collected as a result of an action, including related actions, or in settlement";
}
relation claimant_of(c: WhistleblowerClaim, i: Person) kind empirical {
    label en unofficial "the individual who brought information to the Secretary's attention";
}
relation secretary_proceeds_with_action_based_on_information(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the Secretary proceeds with an administrative or judicial action described in subsection (a) based on information brought to the Secretary's attention by the individual";
}
relation proceeds_item_of_claim(c: WhistleblowerClaim, it: ProceedsItem, amt: Money) kind empirical {
    label en unofficial "an amount collected as a result of the action (penalties, interest, additions to tax, additional amounts, criminal fines, civil forfeitures, proceeds from violations of reporting requirements, and other proceeds), whether or not available to the Secretary";
}
relation claim_has_proceeds_items(c: WhistleblowerClaim) kind empirical {
    label en unofficial "amounts were collected as a result of the action or settlement";
}
relation action_against_taxpayer_other_than_individual(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the action is against a taxpayer that is not an individual";
}
relation individual_taxpayer_gross_income_for_year(c: WhistleblowerClaim, amt: Money) kind empirical {
    label en unofficial "the gross income of the individual taxpayer for a taxable year subject to the action";
}
relation proceeds_in_dispute(c: WhistleblowerClaim, amt: Money) kind empirical {
    label en unofficial "the proceeds in dispute in the action";
}
relation claim_taxpayer_threshold_met(c: WhistleblowerClaim) kind derived {
    label en unofficial "the action is against a taxpayer other than an individual, or against an individual whose gross income exceeds $200,000 for any taxable year subject to the action";
}
relation claim_dispute_threshold_met(c: WhistleblowerClaim) kind derived {
    label en unofficial "the proceeds in dispute exceed $2,000,000";
}
pub relation section_7623b_applies(c: WhistleblowerClaim) kind institutional {
    label en unofficial "subsection (b) applies to the action: taxpayer threshold and proceeds-in-dispute threshold are met";
}
pub relation total_proceeds(c: WhistleblowerClaim, amt: Money) kind institutional {
    label en unofficial "the proceeds collected as a result of the action (including related actions) or from any settlement";
}
@source(IRC_S7623_C, relation = formalizes, coverage = exact, quote = "penalties, interest, additions to tax, and additional amounts provided under the internal revenue laws")
rule S7623TotalProceeds strict {
    for c: WhistleblowerClaim;
    when claim_has_proceeds_items(c);
    then total_proceeds(c, sum all amt: Money for it: ProceedsItem where proceeds_item_of_claim(c, it, amt));
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "against any taxpayer, but in the case of any individual, only if such individual's gross income exceeds $200,000 for any taxable year subject to such action")
rule S7623TaxpayerThresholdNonIndividual strict {
    for c: WhistleblowerClaim;
    when action_against_taxpayer_other_than_individual(c);
    then claim_taxpayer_threshold_met(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "in the case of any individual, only if such individual's gross income exceeds $200,000 for any taxable year subject to such action")
rule S7623TaxpayerThresholdIndividual strict {
    for c: WhistleblowerClaim;
    for gi: Money;
    when individual_taxpayer_gross_income_for_year(c, gi)
        and gi > 200000.00 USD;
    then claim_taxpayer_threshold_met(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "if the proceeds in dispute exceed $2,000,000")
rule S7623DisputeThreshold strict {
    for c: WhistleblowerClaim;
    for d: Money;
    when proceeds_in_dispute(c, d)
        and d > 2000000.00 USD;
    then claim_dispute_threshold_met(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "This subsection shall apply with respect to any action—")
rule S7623SubsectionBApplies strict {
    for c: WhistleblowerClaim;
    when claim_taxpayer_threshold_met(c)
        and claim_dispute_threshold_met(c);
    then section_7623b_applies(c);
}
relation claim_less_substantial_contribution(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the Whistleblower Office determines the action is based principally on disclosures of specific allegations (other than the individual's information) from a judicial or administrative hearing, a governmental report, hearing, audit or investigation, or the news media";
}
relation claim_individual_original_source(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the information resulting in the initiation of the action was originally provided by the individual";
}
relation claim_paragraph_2_applies(c: WhistleblowerClaim) kind derived {
    label en unofficial "paragraph (2) governs: less substantial contribution and the individual is not the original source of the information";
}
pub relation award_bounds(c: WhistleblowerClaim, floor: Money, ceiling: Money) kind institutional {
    label en unofficial "the statutory bounds of the award: at least 15 and at most 30 percent of proceeds (paragraph (1)); at most 10 percent (paragraph (2), no floor)";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply if the information resulting in the initiation of the action described in paragraph (1) was originally provided by the individual described in paragraph (1).")
rule S7623Paragraph2Applies strict {
    for c: WhistleblowerClaim;
    when claim_less_substantial_contribution(c)
        and not_known(claim_individual_original_source(c));
    then claim_paragraph_2_applies(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "such individual shall, subject to paragraph (2), receive as an award at least 15 percent but not more than 30 percent of the proceeds collected as a result of the action")
rule S7623BoundsParagraph1 strict {
    for c: WhistleblowerClaim;
    for total: Money;
    when section_7623b_applies(c)
        and secretary_proceeds_with_action_based_on_information(c)
        and total_proceeds(c, total)
        and not_known(claim_paragraph_2_applies(c));
    then award_bounds(c, round(total * 0.15, 2, "HALF_UP"), round(total * 0.30, 2, "HALF_UP"));
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "the Whistleblower Office may award such sums as it considers appropriate, but in no case more than 10 percent of the proceeds collected as a result of the action")
rule S7623BoundsParagraph2 strict {
    for c: WhistleblowerClaim;
    for total: Money;
    when section_7623b_applies(c)
        and secretary_proceeds_with_action_based_on_information(c)
        and total_proceeds(c, total)
        and claim_paragraph_2_applies(c);
    then award_bounds(c, 0.00 USD, round(total * 0.10, 2, "HALF_UP"));
}
relation whistleblower_office_determines_award(c: WhistleblowerClaim, amt: Money, on: Date) kind empirical {
    label en unofficial "the Whistleblower Office determines the award amount on this date";
}
relation award_within_bounds(c: WhistleblowerClaim, amt: Money) kind derived {
    label en unofficial "the determined amount lies within the statutory bounds";
}
pub relation award_determination_valid(c: WhistleblowerClaim, amt: Money) kind institutional {
    label en unofficial "the award determination is validly made within the statutory bounds";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "The determination of the amount of such award by the Whistleblower Office shall depend upon the extent to which the individual substantially contributed to such action.")
rule S7623AwardWithinBounds strict {
    for c: WhistleblowerClaim;
    for amt: Money;
    for floor: Money;
    for ceiling: Money;
    for on: Date;
    when whistleblower_office_determines_award(c, amt, on)
        and award_bounds(c, floor, ceiling)
        and amt >= floor
        and amt <= ceiling;
    then award_within_bounds(c, amt);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "The determination of the amount of such award by the Whistleblower Office shall depend upon the extent to which the individual substantially contributed to such action.")
rule S7623AwardPower strict {
    for c: WhistleblowerClaim;
    for i: Person;
    for amt: Money;
    for on: Date;
    when whistleblower_office_determines_award(c, amt, on)
        and claimant_of(c, i);
    then power S7623DetermineAward {
        holder WhistleblowerOffice;
        over i;
        exercise whistleblower_office_determines_award(c, amt, on);
        valid_when award_within_bounds(c, amt);
        effect create(award_determination_valid(c, amt));
    };
}
relation claimant_planned_and_initiated_underpayment(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the Whistleblower Office determines the claim is by an individual who planned and initiated the actions that led to the underpayment of tax or to the (a)(2) actions";
}
relation claimant_convicted_of_criminal_conduct_from_role(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the individual is convicted of criminal conduct arising from the planning and initiating role";
}
relation office_reduces_award(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the Whistleblower Office appropriately reduces the award";
}
relation award_paid_to_claimant(c: WhistleblowerClaim) kind empirical {
    label en unofficial "an award is paid to the claimant";
}
pub relation award_reduction_authorized(c: WhistleblowerClaim) kind institutional {
    label en unofficial "the Office's reduction of the award is authorized under §7623(b)(3)";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "then the Whistleblower Office may appropriately reduce such award")
rule S7623ReductionPower strict {
    for c: WhistleblowerClaim;
    for i: Person;
    when office_reduces_award(c)
        and claimant_of(c, i);
    then power S7623ReduceAward {
        holder WhistleblowerOffice;
        over i;
        exercise office_reduces_award(c);
        valid_when claimant_planned_and_initiated_underpayment(c);
        effect create(award_reduction_authorized(c));
    };
}
relation award_denied_due_to_conviction(c: WhistleblowerClaim) kind derived {
    label en unofficial "an award is paid despite the claimant's conviction of criminal conduct arising from the planning and initiating role";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "If such individual is convicted of criminal conduct arising from the role described in the preceding sentence, the Whistleblower Office shall deny any award.")
rule S7623AwardPaidDespiteConviction strict {
    for c: WhistleblowerClaim;
    when claimant_convicted_of_criminal_conduct_from_role(c)
        and award_paid_to_claimant(c);
    then award_denied_due_to_conviction(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "If such individual is convicted of criminal conduct arising from the role described in the preceding sentence, the Whistleblower Office shall deny any award.")
rule S7623DenyAwardProhibition strict {
    for c: WhistleblowerClaim;
    when award_denied_due_to_conviction(c);
    then prohibition S7623NoAwardAfterConviction {
        bearer WhistleblowerOffice;
        action award_denied_due_to_conviction(c);
        window [-infinity, infinity];
    };
}
relation information_submitted_under_penalty_of_perjury(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the information submitted to the Secretary is submitted under penalty of perjury";
}
relation award_paid_on_unsworn_information(c: WhistleblowerClaim) kind derived {
    label en unofficial "an award is paid on information not submitted under penalty of perjury";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "No award may be made under this subsection based on information submitted to the Secretary unless such information is submitted under penalty of perjury.")
rule S7623AwardOnUnsworn strict {
    for c: WhistleblowerClaim;
    when award_paid_to_claimant(c)
        and not_known(information_submitted_under_penalty_of_perjury(c));
    then award_paid_on_unsworn_information(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "No award may be made under this subsection based on information submitted to the Secretary unless such information is submitted under penalty of perjury.")
rule S7623UnswornInformationProhibition strict {
    for c: WhistleblowerClaim;
    when award_paid_on_unsworn_information(c);
    then prohibition S7623NoAwardOnUnswornInformation {
        bearer WhistleblowerOffice;
        action award_paid_on_unsworn_information(c);
        window [-infinity, infinity];
    };
}
relation award_determination_date(c: WhistleblowerClaim, d: Date) kind empirical {
    label en unofficial "the date of the Whistleblower Office's determination regarding an award";
}
relation claimant_appeals_to_tax_court(c: WhistleblowerClaim, on: Date) kind empirical {
    label en unofficial "the individual appeals the determination to the Tax Court on this date";
}
relation appeal_within_30_days(c: WhistleblowerClaim) kind derived {
    label en unofficial "the appeal is made within 30 days of the determination";
}
pub relation tax_court_appeal_timely(c: WhistleblowerClaim) kind institutional {
    label en unofficial "the appeal of the award determination to the Tax Court is timely, and the Tax Court has jurisdiction over the matter";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "may, within 30 days of such determination, be appealed to the Tax Court")
rule S7623AppealWindowFact strict {
    for c: WhistleblowerClaim;
    for det: Date;
    for on: Date;
    when award_determination_date(c, det)
        and claimant_appeals_to_tax_court(c, on)
        and on <= add_calendar_period(det, 30 calendar_day);
    then appeal_within_30_days(c);
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "Any determination regarding an award under paragraph (1), (2), or (3) may, within 30 days of such determination, be appealed to the Tax Court (and the Tax Court shall have jurisdiction with respect to such matter).")
rule S7623AppealPower strict {
    for c: WhistleblowerClaim;
    for i: Person;
    for det: Date;
    for on: Date;
    when claimant_appeals_to_tax_court(c, on)
        and award_determination_date(c, det)
        and claimant_of(c, i);
    then power S7623AppealToTaxCourt {
        holder i;
        over Secretary;
        exercise claimant_appeals_to_tax_court(c, on);
        valid_when appeal_within_30_days(c);
        effect create(tax_court_appeal_timely(c));
        window [det, add_calendar_period(det, 30 calendar_day)];
    };
}
relation individual_represented_by_counsel(c: WhistleblowerClaim) kind empirical {
    label en unofficial "the individual described in paragraph (1) or (2) is represented by counsel";
}
@source(IRC_S7623_B, relation = formalizes, coverage = exact, quote = "Any individual described in paragraph (1) or (2) may be represented by counsel.")
rule S7623CounselLiberty defeasible {
    for c: WhistleblowerClaim;
    for i: Person;
    when claimant_of(c, i)
        and individual_represented_by_counsel(c);
    then liberty S7623ClaimantMayBeRepresented {
        holder i;
        against Secretary;
        action individual_represented_by_counsel(c);
        window [-infinity, infinity];
    };
}
relation payment_made_from_collected_proceeds(o: Organ) kind empirical {
    label en unofficial "the amount paid is paid from the proceeds of amounts collected by reason of the information provided";
}
relation secretary_pays_detection_expenses(o: Organ, amt: Money) kind empirical {
    label en unofficial "the Secretary pays such sums as he deems necessary for detection, under regulations";
}
relation detection_expenses_not_otherwise_provided_for(o: Organ) kind empirical {
    label en unofficial "the expenses are not otherwise provided for by law";
}
pub relation detection_payment_authorized(o: Organ, amt: Money) kind institutional {
    label en unofficial "the payment for detecting underpayments and violations is authorized under §7623(a)";
}
@source(IRC_S7623_A, relation = formalizes, coverage = exact, quote = "The Secretary, under regulations prescribed by the Secretary, is authorized to pay such sums as he deems necessary for—")
rule S7623DetectionPaymentPower strict {
    for o: Organ;
    for amt: Money;
    when secretary_pays_detection_expenses(o, amt);
    then power S7623PayDetectionExpenses {
        holder Secretary;
        over o;
        exercise secretary_pays_detection_expenses(o, amt);
        valid_when detection_payment_conditions_met(o);
        effect create(detection_payment_authorized(o, amt));
    };
}
relation detection_payment_conditions_met(o: Organ) kind derived {
    label en unofficial "the expenses are not otherwise provided for by law and the amount is paid from the proceeds of amounts collected by reason of the information provided";
}
@source(IRC_S7623_A, relation = formalizes, coverage = exact, quote = "Any amount payable under the preceding sentence shall be paid from the proceeds of amounts collected by reason of the information provided")
rule S7623DetectionConditions strict {
    for o: Organ;
    when detection_expenses_not_otherwise_provided_for(o)
        and payment_made_from_collected_proceeds(o);
    then detection_payment_conditions_met(o);
}

// §7623(d): anti-retaliation
entity AdverseAction {
    label en unofficial "a discharge, demotion, suspension, threat, harassment, or other discrimination against an employee in the terms and conditions of employment";
}
relation adverse_action_by_employer(a: AdverseAction, employer: Person, employee: Person) kind empirical {
    label en unofficial "the employer (or an officer, employee, contractor, subcontractor or agent of the employer) takes the adverse action against the employee";
}
relation employee_provided_information_to_authorized_recipient(a: AdverseAction) kind empirical {
    label en unofficial "the employee lawfully provided information, caused it to be provided, or assisted an investigation regarding underpayment of tax or conduct the employee reasonably believes violates the internal revenue laws or federal tax-fraud law, to the IRS, the Secretary, TIGTA, the Comptroller General, the Department of Justice, Congress, a supervisor, or another person with authority to investigate or terminate misconduct";
}
relation employee_testified_or_assisted_in_action(a: AdverseAction) kind empirical {
    label en unofficial "the employee lawfully testified, participated in, or assisted an administrative or judicial action of the IRS relating to an alleged underpayment or violation";
}
external judgment relation adverse_action_in_reprisal_for_protected_act(a: AdverseAction) {
    authority SecretaryOfLabor;
    label en unofficial "the adverse action is in reprisal for the protected act (§7623(d)(1))";
}
relation protected_act_established(a: AdverseAction) kind derived {
    label en unofficial "the employee performed a protected act under (d)(1)(A) or (B)";
}
relation reprisal_established(a: AdverseAction) kind derived {
    label en unofficial "a protected act was performed and the action is in reprisal for it";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "to provide information, cause information to be provided, or otherwise assist in an investigation regarding underpayment of tax")
rule S7623ProtectedInformation strict {
    for a: AdverseAction;
    when employee_provided_information_to_authorized_recipient(a);
    then protected_act_established(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "to testify, participate in, or otherwise assist in any administrative or judicial action taken by the Internal Revenue Service")
rule S7623ProtectedTestimony strict {
    for a: AdverseAction;
    when employee_testified_or_assisted_in_action(a);
    then protected_act_established(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "in reprisal for any lawful act done by the employee—")
rule S7623Reprisal strict {
    for a: AdverseAction;
    when protected_act_established(a)
        and adverse_action_in_reprisal_for_protected_act(a);
    then reprisal_established(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "No employer, or any officer, employee, contractor, subcontractor, or agent of such employer, may discharge, demote, suspend, threaten, harass, or in any other manner discriminate against an employee")
rule S7623RetaliationProhibition strict {
    for a: AdverseAction;
    for employer: Person;
    for employee: Person;
    when adverse_action_by_employer(a, employer, employee)
        and reprisal_established(a);
    then prohibition S7623NoRetaliationAgainstEmployee {
        bearer employer;
        beneficiary employee;
        action reprisal_established(a);
        window [-infinity, infinity];
    };
}
relation violation_date(a: AdverseAction, d: Date) kind empirical {
    label en unofficial "the date on which the violation occurs";
}
relation complaint_filed_with_secretary_of_labor_on(a: AdverseAction, d: Date) kind empirical {
    label en unofficial "the complaint is filed with the Secretary of Labor on this date";
}
relation complaint_within_180_days(a: AdverseAction) kind derived {
    label en unofficial "the complaint is filed not later than 180 days after the violation";
}
pub relation labor_complaint_timely(a: AdverseAction) kind institutional {
    label en unofficial "the complaint with the Secretary of Labor is timely (§7623(d)(2)(B)(iv))";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "A complaint under subparagraph (A)(i) shall be filed not later than 180 days after the date on which the violation occurs.")
rule S7623ComplaintWithin180Days strict {
    for a: AdverseAction;
    for v: Date;
    for f: Date;
    when violation_date(a, v)
        and complaint_filed_with_secretary_of_labor_on(a, f)
        and f <= add_calendar_period(v, 180 calendar_day);
    then complaint_within_180_days(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "A person who alleges discharge or other reprisal by any person in violation of paragraph (1) may seek relief under paragraph (3) by—")
rule S7623ComplaintPower strict {
    for a: AdverseAction;
    for employee: Person;
    for employer: Person;
    for v: Date;
    for f: Date;
    when complaint_filed_with_secretary_of_labor_on(a, f)
        and violation_date(a, v)
        and adverse_action_by_employer(a, employer, employee);
    then power S7623FileLaborComplaint {
        holder employee;
        over employer;
        exercise complaint_filed_with_secretary_of_labor_on(a, f);
        valid_when complaint_within_180_days(a);
        effect create(labor_complaint_timely(a));
        window [v, add_calendar_period(v, 180 calendar_day)];
    };
}
relation labor_decision_final_within_180_days(a: AdverseAction) kind empirical {
    label en unofficial "the Secretary of Labor has issued a final decision within 180 days of the filing of the complaint";
}
relation delay_due_to_claimant_bad_faith(a: AdverseAction) kind empirical {
    label en unofficial "there is a showing that the delay is due to the bad faith of the claimant";
}
relation employee_brings_district_court_action(a: AdverseAction) kind empirical {
    label en unofficial "the employee brings an action at law or equity for de novo review in the appropriate district court";
}
relation district_court_action_conditions_met(a: AdverseAction) kind derived {
    label en unofficial "the Secretary of Labor issued no final decision within 180 days of the complaint and the delay is not due to the claimant's bad faith";
}
relation days_since_complaint(a: AdverseAction, n: Integer) kind empirical {
    label en unofficial "days elapsed since the complaint was filed";
}
relation labor_decision_overdue(a: AdverseAction) kind derived {
    label en unofficial "more than 180 days have elapsed since the complaint without a final decision";
}
pub relation district_court_de_novo_action_available(a: AdverseAction) kind institutional {
    label en unofficial "the employee may bring an action for de novo review in district court, with jurisdiction without regard to the amount in controversy, and a jury trial (§7623(d)(2)(A)(ii), (B)(v))";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "if the Secretary of Labor has not issued a final decision within 180 days of the filing of the complaint")
rule S7623LaborDecisionOverdue strict {
    for a: AdverseAction;
    for n: Integer;
    when days_since_complaint(a, n)
        and n > 180
        and not_known(labor_decision_final_within_180_days(a));
    then labor_decision_overdue(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "and there is no showing that such delay is due to the bad faith of the claimant")
rule S7623DistrictCourtConditions strict {
    for a: AdverseAction;
    when labor_decision_overdue(a)
        and not_known(delay_due_to_claimant_bad_faith(a));
    then district_court_action_conditions_met(a);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "bringing an action at law or equity for de novo review in the appropriate district court of the United States, which shall have jurisdiction over such an action without regard to the amount in controversy")
rule S7623DistrictCourtPower strict {
    for a: AdverseAction;
    for employee: Person;
    for employer: Person;
    when employee_brings_district_court_action(a)
        and adverse_action_by_employer(a, employer, employee);
    then power S7623BringDistrictCourtAction {
        holder employee;
        over employer;
        exercise employee_brings_district_court_action(a);
        valid_when district_court_action_conditions_met(a);
        effect create(district_court_de_novo_action_available(a));
    };
}
relation employee_prevails_in_action(a: AdverseAction) kind empirical {
    label en unofficial "the employee prevails in an action under paragraph (2)(A)";
}
relation back_pay_owed(a: AdverseAction, amt: Money) kind empirical {
    label en unofficial "the back pay the employee would have received but for the reprisal";
}
relation lost_benefits_owed(a: AdverseAction, amt: Money) kind empirical {
    label en unofficial "all lost benefits, before interest";
}
pub relation compensatory_pay_component(a: AdverseAction, amt: Money) kind institutional {
    label en unofficial "200 percent of back pay plus 100 percent of lost benefits, with interest (interest not computed here)";
}
relation reinstatement_with_same_seniority_ordered(a: AdverseAction) kind empirical {
    label en unofficial "the relief includes reinstatement with the seniority the employee would have had but for the reprisal";
}
relation make_whole_relief_provided(a: AdverseAction) kind empirical {
    label en unofficial "the prevailing employee receives all relief necessary to make the employee whole";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "the sum of 200 percent of the amount of back pay and 100 percent of all lost benefits, with interest")
rule S7623CompensatoryPayComponent strict {
    for a: AdverseAction;
    for bp: Money;
    for lb: Money;
    when employee_prevails_in_action(a)
        and back_pay_owed(a, bp)
        and lost_benefits_owed(a, lb);
    then compensatory_pay_component(a, bp * 2 + lb);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "An employee prevailing in any action under paragraph (2)(A) shall be entitled to all relief necessary to make the employee whole.")
rule S7623MakeWholeDuty defeasible {
    for a: AdverseAction;
    for employer: Person;
    for employee: Person;
    when employee_prevails_in_action(a)
        and adverse_action_by_employer(a, employer, employee);
    then duty S7623ProvideMakeWholeRelief {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition make_whole_relief_provided(a);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "reinstatement with the same seniority status that the employee would have had, but for the reprisal")
rule S7623ReinstatementDuty defeasible {
    for a: AdverseAction;
    for employer: Person;
    for employee: Person;
    when employee_prevails_in_action(a)
        and adverse_action_by_employer(a, employer, employee);
    then duty S7623ReinstateEmployee {
        bearer employer;
        beneficiary employee;
        goal achievement {
            condition reinstatement_with_same_seniority_ordered(a);
            window [-infinity, infinity];
        }
    };
}
relation party_to_district_court_action(a: AdverseAction, party: Person) kind empirical {
    label en unofficial "the person is a party to an action brought under (d)(2)(A)(ii)";
}
relation party_demands_jury_trial(a: AdverseAction, party: Person) kind empirical {
    label en unofficial "the party demands trial by jury";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "A party to an action brought under subparagraph (A)(ii) shall be entitled to trial by jury.")
rule S7623JuryTrialLiberty defeasible {
    for a: AdverseAction;
    for party: Person;
    when party_to_district_court_action(a, party)
        and party_demands_jury_trial(a, party);
    then liberty S7623PartyJuryTrial {
        holder party;
        against DistrictCourt;
        action party_demands_jury_trial(a, party);
        window [-infinity, infinity];
    };
}
relation waiver_of_7623d_rights_in_agreement(w: Person) kind empirical {
    label en unofficial "an agreement, policy form or condition of employment waives the rights and remedies of §7623(d)";
}
relation predispute_arbitration_of_7623d_disputes(w: Person) kind empirical {
    label en unofficial "a predispute arbitration agreement requires arbitration of a dispute arising under §7623(d)";
}
pub relation waiver_of_7623d_rights_unenforceable(w: Person) kind institutional {
    label en unofficial "the waiver of the rights and remedies of §7623(d) is not enforceable (§7623(d)(5)(A))";
}
pub relation predispute_arbitration_agreement_invalid(w: Person) kind institutional {
    label en unofficial "the predispute arbitration agreement is not valid or enforceable as to a §7623(d) dispute (§7623(d)(5)(B))";
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "The rights and remedies provided for in this subsection may not be waived by any agreement, policy form, or condition of employment, including by a predispute arbitration agreement.")
rule S7623WaiverInvalid strict {
    for w: Person;
    when waiver_of_7623d_rights_in_agreement(w);
    then waiver_of_7623d_rights_unenforceable(w);
}
@source(IRC_S7623_D, relation = formalizes, coverage = exact, quote = "No predispute arbitration agreement shall be valid or enforceable, if the agreement requires arbitration of a dispute arising under this subsection.")
rule S7623ArbitrationInvalid strict {
    for w: Person;
    when predispute_arbitration_of_7623d_disputes(w);
    then predispute_arbitration_agreement_invalid(w);
}

// --- §7624: reimbursement of State and local law enforcement agencies ------------------------------------------------

relation agency_provided_information_contributing_to_recovery(ag: Person, s: Money) kind empirical {
    label en unofficial "a State or local law enforcement agency provides information to the IRS that substantially contributes to the recovery of Federal taxes on illegal drug-related activities (or money laundering in connection with them); the sum recovered";
}
relation agency_reimbursement_paid(ag: Person, amt: Money) kind empirical {
    label en unofficial "the IRS reimburses the agency's investigative costs";
}
relation agency_reimbursement_ceiling(ag: Person, amt: Money) kind derived {
    label en unofficial "10 percent of the sum recovered on the agency's information";
}
relation reimbursement_exceeds_ten_percent(ag: Person) kind derived {
    label en unofficial "the reimbursement exceeds 10 percent of the sum recovered";
}
relation agency_already_reimbursed_elsewhere(ag: Person) kind empirical {
    label en unofficial "the agency has received reimbursement under a Federal or State forfeiture program or under State revenue laws";
}
relation reimbursement_despite_duplication(ag: Person) kind derived {
    label en unofficial "the IRS reimburses an agency that has received duplicative reimbursement";
}
relation irs_maintains_records_of_information_received(o: Organ) kind empirical {
    label en unofficial "the IRS maintains records of the receipt of information from a contributing agency";
}
relation irs_notifies_agency_of_recovery(ag: Person) kind empirical {
    label en unofficial "the IRS notifies the agency when monies have been recovered as the result of its information";
}
relation monies_recovered_from_agency_information(ag: Person) kind empirical {
    label en unofficial "monies have been recovered as a result of the agency's information";
}
relation agency_submits_cost_statement(ag: Person) kind empirical {
    label en unofficial "following notification the agency submits a statement detailing the investigative costs it incurred";
}
@source(IRC_S7624_A, relation = formalizes, coverage = exact, quote = "not to exceed 10 percent of the sum recovered")
rule S7624Ceiling strict {
    for ag: Person;
    for s: Money;
    when agency_provided_information_contributing_to_recovery(ag, s);
    then agency_reimbursement_ceiling(ag, round(s * 0.10, 2, "HALF_UP"));
}
@source(IRC_S7624_A, relation = formalizes, coverage = exact, quote = "such agency may be reimbursed by the Internal Revenue Service for costs incurred in the investigation")
rule S7624ExceedsCeiling strict {
    for ag: Person;
    for amt: Money;
    for ceiling: Money;
    when agency_reimbursement_paid(ag, amt)
        and agency_reimbursement_ceiling(ag, ceiling)
        and amt > ceiling;
    then reimbursement_exceeds_ten_percent(ag);
}
@source(IRC_S7624_A, relation = formalizes, coverage = exact, quote = "not to exceed 10 percent of the sum recovered")
rule S7624CeilingProhibition strict {
    for ag: Person;
    when reimbursement_exceeds_ten_percent(ag);
    then prohibition S7624NoReimbursementOverTenPercent {
        bearer IRS;
        beneficiary ag;
        action reimbursement_exceeds_ten_percent(ag);
        window [-infinity, infinity];
    };
}
@source(IRC_S7624_C, relation = formalizes, coverage = exact, quote = "No State or local agency may receive reimbursement under this section if reimbursement has been received by such agency under a Federal or State forfeiture program or under State revenue laws.")
rule S7624Duplication strict {
    for ag: Person;
    when agency_reimbursement_paid_flag(ag)
        and agency_already_reimbursed_elsewhere(ag);
    then reimbursement_despite_duplication(ag);
}
relation agency_reimbursement_paid_flag(ag: Person) kind derived {
    label en unofficial "a reimbursement is paid to the agency";
}
@source(IRC_S7624_A, relation = formalizes, coverage = exact, quote = "such agency may be reimbursed by the Internal Revenue Service")
rule S7624PaidFlag strict {
    for ag: Person;
    for amt: Money;
    when agency_reimbursement_paid(ag, amt);
    then agency_reimbursement_paid_flag(ag);
}
@source(IRC_S7624_C, relation = formalizes, coverage = exact, quote = "No State or local agency may receive reimbursement under this section if reimbursement has been received by such agency")
rule S7624DuplicationProhibition strict {
    for ag: Person;
    when reimbursement_despite_duplication(ag);
    then prohibition S7624NoDuplicativeReimbursement {
        bearer IRS;
        beneficiary ag;
        action reimbursement_despite_duplication(ag);
        window [-infinity, infinity];
    };
}
@source(IRC_S7624_B, relation = formalizes, coverage = exact, quote = "The Internal Revenue Service shall maintain records of the receipt of information from a contributing agency")
rule S7624RecordsDuty strict {
    for ag: Person;
    for s: Money;
    when agency_provided_information_contributing_to_recovery(ag, s);
    then duty S7624MaintainRecordsOfInformation {
        bearer IRS;
        beneficiary ag;
        goal maintenance {
            condition irs_maintains_records_of_information_received(IRS);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7624_B, relation = formalizes, coverage = exact, quote = "shall notify the agency when monies have been recovered as the result of such information")
rule S7624NotifyDuty defeasible {
    for ag: Person;
    when monies_recovered_from_agency_information(ag);
    then duty S7624NotifyAgencyOfRecovery {
        bearer IRS;
        beneficiary ag;
        goal achievement {
            condition irs_notifies_agency_of_recovery(ag);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7624_B, relation = formalizes, coverage = exact, quote = "Following such notification, the agency shall submit a statement detailing the investigative costs it incurred.")
rule S7624StatementDuty defeasible {
    for ag: Person;
    when irs_notifies_agency_of_recovery(ag);
    then duty S7624SubmitCostStatement {
        bearer ag;
        beneficiary IRS;
        goal achievement {
            condition agency_submits_cost_statement(ag);
            window [-infinity, infinity];
        }
    };
}
