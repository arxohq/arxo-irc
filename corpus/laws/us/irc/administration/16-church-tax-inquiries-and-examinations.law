// 26 U.S.C. §7611 — Restrictions on church tax inquiries and examinations.
// STAGE 3.
//
// JUDGMENT CALLS
//  - The 2-year and 90-day completion periods are achievement duties whose
//    window ends at the notice date plus the period; the suspension of
//    (c)(2) extends the deadline by a VARIABLE number of days, and
//    `add_calendar_period` takes a literal count, so a suspended period's
//    deadline is a case-supplied date (`extended_completion_deadline`,
//    TECH-GAPS G3009). Whether a period IS suspended is derived.
//  - "Reasonably believes (on the basis of facts and circumstances recorded
//    in writing)" is the high-level official's belief: an external judgment
//    (authority Secretary) plus a recorded-in-writing fact (DECISION-0194).
//  - "Substantial compliance" (§7611(d)(1), (e)(1)) is determined by the
//    regional counsel (d)(1) or found by the court (e)(1): case facts named
//    after the deciding organ.
//  - "3 most recent taxable years ending before the examination notice
//    date" is read from a case relation numbering years back from the notice
//    date (1 = most recent).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7611_A,
    IRC_S7611_B,
    IRC_S7611_C,
    IRC_S7611_D,
    IRC_S7611_E,
    IRC_S7611_F,
    IRC_S7611_G,
    IRC_S7611_I,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

entity ChurchInquiry {
    label en unofficial "a church tax inquiry: an inquiry to a church (other than an examination) to serve as a basis for determining whether the church is exempt as a church or is carrying on an unrelated trade or business or other taxable activities";
}
entity ChurchExamination {
    label en unofficial "a church tax examination: an examination of church records at the IRS's request, or of the religious activities of a church, for the purpose of the determination in an inquiry";
}
relation inquiry_of_church(i: ChurchInquiry, ch: Person) kind empirical {
    label en unofficial "the inquiry is directed to this church (any organization claiming to be a church, or a convention or association of churches)";
}
relation examination_follows_inquiry(e: ChurchExamination, i: ChurchInquiry) kind empirical {
    label en unofficial "the examination follows this inquiry";
}
relation examination_of_church(e: ChurchExamination, ch: Person) kind empirical {
    label en unofficial "the examination concerns this church";
}

// §7611(i): where the section does not apply
relation inquiry_is_criminal_investigation(i: ChurchInquiry) kind empirical {
    label en unofficial "the inquiry or examination is a criminal investigation";
}
relation inquiry_concerns_liability_of_person_other_than_church(i: ChurchInquiry) kind empirical {
    label en unofficial "the inquiry or examination relates to the tax liability of a person other than a church";
}
relation inquiry_concerns_termination_or_jeopardy_assessment(i: ChurchInquiry) kind empirical {
    label en unofficial "the matter is an assessment under section 6851, 6852 or 6861";
}
relation inquiry_concerns_willful_evasion(i: ChurchInquiry) kind empirical {
    label en unofficial "the matter is a willful attempt to defeat or evade any tax imposed by this title";
}
relation inquiry_concerns_knowing_failure_to_file(i: ChurchInquiry) kind empirical {
    label en unofficial "the matter is a knowing failure to file a return of tax";
}
relation s7611_applies_to_inquiry(i: ChurchInquiry) kind derived {
    label en unofficial "§7611 applies to the inquiry (no §7611(i) exclusion)";
}
@source(IRC_S7611_I, relation = formalizes, coverage = exact, quote = "This section shall not apply to—")
rule S7611AppliesUnlessExcluded strict {
    for i: ChurchInquiry;
    for ch: Person;
    when inquiry_of_church(i, ch)
        and not_known(inquiry_is_criminal_investigation(i))
        and not_known(inquiry_concerns_liability_of_person_other_than_church(i))
        and not_known(inquiry_concerns_termination_or_jeopardy_assessment(i))
        and not_known(inquiry_concerns_willful_evasion(i))
        and not_known(inquiry_concerns_knowing_failure_to_file(i));
    then s7611_applies_to_inquiry(i);
}

// §7611(a): restrictions on inquiries
external judgment relation official_reasonably_believes_church_may_be_taxable(i: ChurchInquiry) {
    authority Secretary;
    label en unofficial "an appropriate high-level Treasury official reasonably believes that the church may not be exempt by reason of its status as a church, or may be carrying on an unrelated trade or business or otherwise engaged in taxable activities (§7611(a)(2))";
}
relation belief_facts_recorded_in_writing(i: ChurchInquiry) kind empirical {
    label en unofficial "the facts and circumstances supporting the belief are recorded in writing";
}
relation written_notice_before_beginning_inquiry(i: ChurchInquiry) kind empirical {
    label en unofficial "before beginning the inquiry the Secretary provides written notice to the church of the beginning of the inquiry";
}
relation inquiry_notice_explains_concerns_and_subject(i: ChurchInquiry) kind empirical {
    label en unofficial "the notice explains the concerns which gave rise to the inquiry and the general subject matter";
}
relation inquiry_notice_explains_administrative_and_constitutional_provisions(i: ChurchInquiry) kind empirical {
    label en unofficial "the notice generally explains the applicable administrative and constitutional provisions (including the right to a conference before any examination of church records) and the provisions of this title that authorize or may be involved in the inquiry";
}
relation reasonable_belief_requirements_met(i: ChurchInquiry) kind derived {
    label en unofficial "the requirements of §7611(a)(2) are met";
}
relation inquiry_notice_requirements_met(i: ChurchInquiry) kind derived {
    label en unofficial "the requirements of §7611(a)(3) are met: written notice before beginning, with the required contents";
}
relation inquiry_preconditions_met(i: ChurchInquiry) kind derived {
    label en unofficial "both the reasonable belief requirements and the notice requirements are met";
}
relation secretary_begins_church_tax_inquiry(i: ChurchInquiry) kind empirical {
    label en unofficial "the Secretary begins the church tax inquiry";
}
pub relation church_tax_inquiry_begun(i: ChurchInquiry) kind institutional {
    label en unofficial "the church tax inquiry has validly begun under §7611(a)";
}
@source(IRC_S7611_A, relation = formalizes, coverage = exact, quote = "reasonably believes (on the basis of facts and circumstances recorded in writing) that the church—")
rule S7611ReasonableBelief strict {
    for i: ChurchInquiry;
    when official_reasonably_believes_church_may_be_taxable(i)
        and belief_facts_recorded_in_writing(i);
    then reasonable_belief_requirements_met(i);
}
@source(IRC_S7611_A, relation = formalizes, coverage = exact, quote = "the Secretary provides written notice to the church of the beginning of such inquiry")
rule S7611InquiryNoticeRequirements strict {
    for i: ChurchInquiry;
    when written_notice_before_beginning_inquiry(i)
        and inquiry_notice_explains_concerns_and_subject(i)
        and inquiry_notice_explains_administrative_and_constitutional_provisions(i);
    then inquiry_notice_requirements_met(i);
}
@source(IRC_S7611_A, relation = formalizes, coverage = exact, quote = "The Secretary may begin a church tax inquiry only if—")
rule S7611InquiryPreconditions strict {
    for i: ChurchInquiry;
    when reasonable_belief_requirements_met(i)
        and inquiry_notice_requirements_met(i);
    then inquiry_preconditions_met(i);
}
@source(IRC_S7611_A, relation = formalizes, coverage = exact, quote = "The Secretary may begin a church tax inquiry only if—")
rule S7611BeginInquiryPower strict {
    for i: ChurchInquiry;
    for ch: Person;
    when secretary_begins_church_tax_inquiry(i)
        and inquiry_of_church(i, ch)
        and s7611_applies_to_inquiry(i);
    then power S7611BeginChurchTaxInquiry {
        holder Secretary;
        over ch;
        exercise secretary_begins_church_tax_inquiry(i);
        valid_when inquiry_preconditions_met(i);
        effect create(church_tax_inquiry_begun(i));
    };
}

// §7611(b): restrictions on examinations
relation examination_notice_date(e: ChurchExamination, d: Date) kind empirical {
    label en unofficial "the date the examination notice is provided to the church (the examination notice date, §7611(h)(6))";
}
relation inquiry_notice_date(i: ChurchInquiry, d: Date) kind empirical {
    label en unofficial "the date the inquiry notice is provided (the inquiry notice date, §7611(h)(5))";
}
relation examination_start_date(e: ChurchExamination, d: Date) kind empirical {
    label en unofficial "the date the church tax examination begins";
}
relation examination_notice_given_to_regional_counsel_too(e: ChurchExamination) kind empirical {
    label en unofficial "the examination notice is provided to both the church and the appropriate regional counsel";
}
relation examination_notice_contains_inquiry_notice_copy(e: ChurchExamination) kind empirical {
    label en unofficial "the notice includes a copy of the church tax inquiry notice (§7611(b)(3)(A)(i))";
}
relation examination_notice_describes_records_and_activities(e: ChurchExamination) kind empirical {
    label en unofficial "the notice describes the church records and activities the Secretary seeks to examine (§7611(b)(3)(A)(ii))";
}
relation examination_notice_offers_conference(e: ChurchExamination) kind empirical {
    label en unofficial "the notice offers a conference between the church and the Secretary to discuss and attempt to resolve concerns (§7611(b)(3)(A)(iii))";
}
relation examination_notice_encloses_foia_documents(e: ChurchExamination) kind empirical {
    label en unofficial "the notice includes a copy of all documents collected or prepared by the IRS for use in the examination whose disclosure the Freedom of Information Act requires (§7611(b)(3)(A)(iv))";
}
relation church_requested_conference_before_examination(e: ChurchExamination) kind empirical {
    label en unofficial "the church requests a conference before the beginning of the examination";
}
relation church_had_reasonable_time_to_participate_in_conference(e: ChurchExamination) kind empirical {
    label en unofficial "the church has a reasonable time to participate in the conference";
}
relation examination_notice_contents_complete(e: ChurchExamination) kind derived {
    label en unofficial "the examination notice is a written notice with the (b)(3)(A)(i)-(iv) contents";
}
relation examination_notice_not_before_15th_day_after_inquiry_notice(e: ChurchExamination) kind derived {
    label en unofficial "the examination notice is not provided before the 15th day after the inquiry notice";
}
relation examination_notice_15_days_before_beginning(e: ChurchExamination) kind derived {
    label en unofficial "the examination notice is provided at least 15 days before the examination begins";
}
relation examination_preconditions_met(e: ChurchExamination) kind derived {
    label en unofficial "the (b)(2) requirements are met: notice at least 15 days before to the church and regional counsel, and the conference requirement";
}
relation secretary_begins_church_tax_examination(e: ChurchExamination) kind empirical {
    label en unofficial "the Secretary begins the church tax examination";
}
pub relation church_tax_examination_begun(e: ChurchExamination) kind institutional {
    label en unofficial "the church tax examination has validly begun under §7611(b)";
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "The notice described in this paragraph is a written notice which includes—")
rule S7611ExaminationNoticeContents strict {
    for e: ChurchExamination;
    when examination_notice_contains_inquiry_notice_copy(e)
        and examination_notice_describes_records_and_activities(e)
        and examination_notice_offers_conference(e)
        and examination_notice_encloses_foia_documents(e);
    then examination_notice_contents_complete(e);
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "The examination notice described in subparagraph (A) shall not be provided to the church before the 15th day after the date on which the church tax inquiry notice was provided to the church under subsection (a).")
rule S7611ExaminationNoticeNotEarly strict {
    for e: ChurchExamination;
    for i: ChurchInquiry;
    for n_exam: Date;
    for n_inq: Date;
    when examination_follows_inquiry(e, i)
        and examination_notice_date(e, n_exam)
        and inquiry_notice_date(i, n_inq)
        and days_between(n_inq, n_exam) >= 15;
    then examination_notice_not_before_15th_day_after_inquiry_notice(e);
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "at least 15 days before the beginning of such examination, the Secretary provides the notice described in paragraph (3) to both the church and the appropriate regional counsel of the Internal Revenue Service")
rule S7611ExaminationNotice15DaysBefore strict {
    for e: ChurchExamination;
    for n_exam: Date;
    for start: Date;
    when examination_notice_date(e, n_exam)
        and examination_start_date(e, start)
        and days_between(n_exam, start) >= 15;
    then examination_notice_15_days_before_beginning(e);
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "the church has a reasonable time to participate in a conference described in paragraph (3)(A)(iii), but only if the church requests such a conference before the beginning of the examination")
rule S7611ExaminationPreconditionsNoConferenceRequest strict {
    for e: ChurchExamination;
    when examination_notice_15_days_before_beginning(e)
        and examination_notice_given_to_regional_counsel_too(e)
        and examination_notice_contents_complete(e)
        and examination_notice_not_before_15th_day_after_inquiry_notice(e)
        and not_known(church_requested_conference_before_examination(e));
    then examination_preconditions_met(e);
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "the church has a reasonable time to participate in a conference described in paragraph (3)(A)(iii), but only if the church requests such a conference before the beginning of the examination")
rule S7611ExaminationPreconditionsWithConference strict {
    for e: ChurchExamination;
    when examination_notice_15_days_before_beginning(e)
        and examination_notice_given_to_regional_counsel_too(e)
        and examination_notice_contents_complete(e)
        and examination_notice_not_before_15th_day_after_inquiry_notice(e)
        and church_requested_conference_before_examination(e)
        and church_had_reasonable_time_to_participate_in_conference(e);
    then examination_preconditions_met(e);
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "The Secretary may begin a church tax examination only if the requirements of paragraph (2) have been met")
rule S7611BeginExaminationPower strict {
    for e: ChurchExamination;
    for ch: Person;
    when secretary_begins_church_tax_examination(e)
        and examination_of_church(e, ch);
    then power S7611BeginChurchTaxExamination {
        holder Secretary;
        over ch;
        exercise secretary_begins_church_tax_examination(e);
        valid_when examination_preconditions_met(e);
        effect create(church_tax_examination_begun(e));
    };
}
relation examination_of_church_records_beyond_necessary(e: ChurchExamination) kind empirical {
    label en unofficial "church records are examined beyond the extent necessary to determine the liability for, and the amount of, any tax";
}
relation examination_of_religious_activities_beyond_necessary(e: ChurchExamination) kind empirical {
    label en unofficial "religious activities are examined beyond the extent necessary to determine whether an organization claiming to be a church is a church for any period";
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "in the case of church records, to the extent necessary to determine the liability for, and the amount of, any tax imposed by this title")
rule S7611RecordsScopeProhibition strict {
    for e: ChurchExamination;
    when examination_of_church_records_beyond_necessary(e);
    then prohibition S7611NoExaminationOfRecordsBeyondNecessary {
        bearer Secretary;
        action examination_of_church_records_beyond_necessary(e);
        window [-infinity, infinity];
    };
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "in the case of religious activities, to the extent necessary to determine whether an organization claiming to be a church is a church for any period")
rule S7611ActivitiesScopeProhibition strict {
    for e: ChurchExamination;
    when examination_of_religious_activities_beyond_necessary(e);
    then prohibition S7611NoExaminationOfActivitiesBeyondNecessary {
        bearer Secretary;
        action examination_of_religious_activities_beyond_necessary(e);
        window [-infinity, infinity];
    };
}
relation regional_counsel_submits_advisory_objection(e: ChurchExamination, on: Date) kind empirical {
    label en unofficial "the regional counsel submits to the regional commissioner an advisory objection to the examination";
}
pub relation advisory_objection_submitted(e: ChurchExamination) kind institutional {
    label en unofficial "the regional counsel's advisory objection to the examination is validly submitted within 15 days of the notice";
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "may, within 15 days after such notice is provided, submit to the regional commissioner for the region an advisory objection to the examination")
rule S7611AdvisoryObjectionPower strict {
    for e: ChurchExamination;
    for n_exam: Date;
    for on: Date;
    when regional_counsel_submits_advisory_objection(e, on)
        and examination_notice_date(e, n_exam);
    then power S7611SubmitAdvisoryObjection {
        holder RegionalCounsel;
        over Secretary;
        exercise regional_counsel_submits_advisory_objection(e, on);
        valid_when advisory_objection_within_15_days(e);
        effect create(advisory_objection_submitted(e));
        window [n_exam, add_calendar_period(n_exam, 15 calendar_day)];
    };
}
const RegionalCounsel: Organ = entity_ref("urn:us:irc:administration:clir#RegionalCounsel") {
    label en official "the appropriate regional counsel of the Internal Revenue Service";
}
relation advisory_objection_within_15_days(e: ChurchExamination) kind derived {
    label en unofficial "the advisory objection is submitted within 15 days after the examination notice";
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "within 15 days after such notice is provided")
rule S7611AdvisoryObjectionTimely strict {
    for e: ChurchExamination;
    for n_exam: Date;
    for on: Date;
    when regional_counsel_submits_advisory_objection(e, on)
        and examination_notice_date(e, n_exam)
        and on <= add_calendar_period(n_exam, 15 calendar_day);
    then advisory_objection_within_15_days(e);
}
relation examination_of_unspecified_records_within_scope(e: ChurchExamination) kind empirical {
    label en unofficial "in the course of a compliant examination the Secretary examines church records or religious activities not specified in the notice, within the (b)(1)(A) or (B) scope";
}
@source(IRC_S7611_B, relation = formalizes, coverage = exact, quote = "the Secretary may examine any church records or religious activities which were not specified in the examination notice to the extent such examination meets the requirement of subparagraph (A) or (B) of paragraph (1)")
rule S7611UnspecifiedRecordsLiberty defeasible {
    for e: ChurchExamination;
    when church_tax_examination_begun(e)
        and examination_of_unspecified_records_within_scope(e);
    then liberty S7611ExamineUnspecifiedRecords {
        holder Secretary;
        against RegionalCounsel;
        action examination_of_unspecified_records_within_scope(e);
        window [-infinity, infinity];
    };
}

// §7611(c): time limits
relation church_period_suspended_cause_judicial_proceeding(e: ChurchExamination) kind empirical {
    label en unofficial "a judicial proceeding brought by the church against the Secretary, or by the Secretary against the church to compel compliance with a reasonable request, or an order in a proceeding under section 7609, is pending or being appealed";
}
relation church_failed_reasonable_request_over_20_days(e: ChurchExamination) kind empirical {
    label en unofficial "for a period in excess of 20 days (but not in excess of 6 months) the church or its agents fail to comply with any reasonable request of the Secretary for church records or other information";
}
relation suspension_mutually_agreed(e: ChurchExamination) kind empirical {
    label en unofficial "the Secretary and the church mutually agree on a period of suspension";
}
relation church_period_suspended(e: ChurchExamination) kind derived {
    label en unofficial "the 2-year and 90-day completion periods are suspended (§7611(c)(2))";
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "for any period during which—")
rule S7611SuspendedByProceeding strict {
    for e: ChurchExamination;
    when church_period_suspended_cause_judicial_proceeding(e);
    then church_period_suspended(e);
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "for any period in excess of 20 days (but not in excess of 6 months) in which the church or its agents fail to comply with any reasonable request of the Secretary for church records or other information")
rule S7611SuspendedByNoncompliance strict {
    for e: ChurchExamination;
    when church_failed_reasonable_request_over_20_days(e);
    then church_period_suspended(e);
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "for any period mutually agreed upon by the Secretary and the church")
rule S7611SuspendedByAgreement strict {
    for e: ChurchExamination;
    when suspension_mutually_agreed(e);
    then church_period_suspended(e);
}
relation examination_completed_with_final_determination(e: ChurchExamination) kind empirical {
    label en unofficial "the Secretary completes the church tax status inquiry or examination and makes a final determination";
}
relation extended_completion_deadline(e: ChurchExamination, d: Date) kind empirical {
    label en unofficial "the completion deadline after the suspension periods are added (case-supplied: a variable number of suspended days cannot be added by a literal step, TECH-GAPS G3009)";
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "The Secretary shall complete any church tax status inquiry or examination (and make a final determination with respect thereto) not later than the date which is 2 years after the examination notice date.")
rule S7611TwoYearDuty defeasible {
    for e: ChurchExamination;
    for n_exam: Date;
    when examination_notice_date(e, n_exam);
    then duty S7611CompleteExaminationWithinTwoYears {
        bearer Secretary;
        beneficiary RegionalCounsel;
        goal achievement {
            condition examination_completed_with_final_determination(e);
            window [n_exam, add_calendar_period(n_exam, 2 calendar_year)];
        }
    };
    unless church_period_suspended(e) and examination_notice_date(e, n_exam);
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "The Secretary shall complete any church tax status inquiry or examination (and make a final determination with respect thereto) not later than the date which is 2 years after the examination notice date.")
rule S7611TwoYearDutySuspended defeasible {
    for e: ChurchExamination;
    for n_exam: Date;
    for deadline: Date;
    when examination_notice_date(e, n_exam)
        and church_period_suspended(e)
        and extended_completion_deadline(e, deadline);
    then duty S7611CompleteExaminationByExtendedDeadline {
        bearer Secretary;
        beneficiary RegionalCounsel;
        goal achievement {
            condition examination_completed_with_final_determination(e);
            window [n_exam, deadline];
        }
    };
}
relation inquiry_not_followed_by_examination_notice(i: ChurchInquiry) kind empirical {
    label en unofficial "there is no examination notice for the inquiry";
}
relation inquiry_period_suspended(i: ChurchInquiry) kind empirical {
    label en unofficial "the 90-day period is suspended under §7611(c)(2)";
}
relation inquiry_completed_with_final_determination(i: ChurchInquiry) kind empirical {
    label en unofficial "the Secretary completes the church tax inquiry and makes a final determination";
}
@source(IRC_S7611_C, relation = formalizes, coverage = exact, quote = "the Secretary shall complete such inquiry (and make a final determination with respect thereto) not later than the date which is 90 days after the inquiry notice date")
rule S7611NinetyDayDuty defeasible {
    for i: ChurchInquiry;
    for n_inq: Date;
    when inquiry_not_followed_by_examination_notice(i)
        and inquiry_notice_date(i, n_inq);
    then duty S7611CompleteInquiryWithinNinetyDays {
        bearer Secretary;
        beneficiary RegionalCounsel;
        goal achievement {
            condition inquiry_completed_with_final_determination(i);
            window [n_inq, add_calendar_period(n_inq, 90 calendar_day)];
        }
    };
    unless inquiry_period_suspended(i) and inquiry_not_followed_by_examination_notice(i) and inquiry_notice_date(i, n_inq);
}

// §7611(d): limitations on revocation, deficiency and assessment
relation regional_counsel_written_determination_of_substantial_compliance(e: ChurchExamination) kind empirical {
    label en unofficial "the appropriate regional counsel determines in writing that there has been substantial compliance with the requirements of the section";
}
relation regional_counsel_written_approval(e: ChurchExamination) kind empirical {
    label en unofficial "the appropriate regional counsel approves in writing the revocation, notice of deficiency, or assessment";
}
relation regional_counsel_clearance_given(e: ChurchExamination) kind derived {
    label en unofficial "the regional counsel has both determined substantial compliance and approved in writing";
}
relation secretary_determines_organization_is_not_church(e: ChurchExamination) kind empirical {
    label en unofficial "the Secretary determines that the organization is not a church exempt under section 501(a) or described in section 170(c)";
}
relation secretary_sends_deficiency_notice_or_assesses(e: ChurchExamination) kind empirical {
    label en unofficial "the Secretary sends a notice of deficiency of any tax involved in the examination or (where the deficiency procedures do not apply) assesses an underpayment";
}
pub relation church_status_determination_authorized(e: ChurchExamination) kind institutional {
    label en unofficial "the determination that an organization is not a church is authorized under §7611(d)(1)(A)";
}
pub relation church_deficiency_or_assessment_authorized(e: ChurchExamination) kind institutional {
    label en unofficial "the notice of deficiency or assessment is authorized under §7611(d)(1)(B)";
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "only if the appropriate regional counsel of the Internal Revenue Service determines in writing that there has been substantial compliance with the requirements of this section and approves in writing of such revocation, notice of deficiency, or assessment")
rule S7611RegionalCounselClearance strict {
    for e: ChurchExamination;
    when regional_counsel_written_determination_of_substantial_compliance(e)
        and regional_counsel_written_approval(e);
    then regional_counsel_clearance_given(e);
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "determine that an organization is not a church which—")
rule S7611StatusDeterminationPower strict {
    for e: ChurchExamination;
    for ch: Person;
    when secretary_determines_organization_is_not_church(e)
        and examination_of_church(e, ch);
    then power S7611DetermineOrganizationNotAChurch {
        holder Secretary;
        over ch;
        exercise secretary_determines_organization_is_not_church(e);
        valid_when regional_counsel_clearance_given(e);
        effect create(church_status_determination_authorized(e));
    };
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "send a notice of deficiency of any tax involved in a church tax examination")
rule S7611DeficiencyPower strict {
    for e: ChurchExamination;
    for ch: Person;
    when secretary_sends_deficiency_notice_or_assesses(e)
        and examination_of_church(e, ch);
    then power S7611DeficiencyOrAssessment {
        holder Secretary;
        over ch;
        exercise secretary_sends_deficiency_notice_or_assesses(e);
        valid_when regional_counsel_clearance_given(e);
        effect create(church_deficiency_or_assessment_authorized(e));
    };
}
relation taxable_year_ordinal_before_notice(ch: Person, y: TaxableYear, n: Integer) kind empirical {
    label en unofficial "the taxable year is the n-th most recent taxable year ending before the examination notice date (1 = most recent)";
}
relation examination_for_revocation_of_exemption(e: ChurchExamination) kind empirical {
    label en unofficial "the church tax examination is with respect to the revocation of tax-exempt status under section 501(a)";
}
relation examination_for_unrelated_business_tax(e: ChurchExamination) kind empirical {
    label en unofficial "the church tax examination is with respect to the tax imposed by section 511";
}
relation church_not_exempt_for_any_of_three_years(e: ChurchExamination) kind empirical {
    label en unofficial "the organization is not a church exempt from tax under section 501(a) for any of the 3 most recent taxable years";
}
pub relation chapter_1_assessment_window_contains(e: ChurchExamination, y: TaxableYear) kind institutional {
    label en unofficial "chapter 1 tax (other than section 511) may be assessed, or collected without assessment, for this taxable year: the 3 most recent (6 if not exempt for any of the 3) years ending before the examination notice date";
}
pub relation section_511_assessment_window_contains(e: ChurchExamination, y: TaxableYear) kind institutional {
    label en unofficial "the section 511 tax may be assessed, or collected without assessment, for this taxable year: the 6 most recent years ending before the examination notice date";
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "only for the 3 most recent taxable years ending before the examination notice date")
rule S7611ChapterOneThreeYears strict {
    for e: ChurchExamination;
    for ch: Person;
    for y: TaxableYear;
    for n: Integer;
    when examination_for_revocation_of_exemption(e)
        and examination_of_church(e, ch)
        and taxable_year_ordinal_before_notice(ch, y, n)
        and n <= 3;
    then chapter_1_assessment_window_contains(e, y);
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "clause (i) shall be applied by substituting \"6 most recent taxable years\" for \"3 most recent taxable years\"")
rule S7611ChapterOneSixYears strict {
    for e: ChurchExamination;
    for ch: Person;
    for y: TaxableYear;
    for n: Integer;
    when examination_for_revocation_of_exemption(e)
        and examination_of_church(e, ch)
        and church_not_exempt_for_any_of_three_years(e)
        and taxable_year_ordinal_before_notice(ch, y, n)
        and n <= 6;
    then chapter_1_assessment_window_contains(e, y);
}
@source(IRC_S7611_D, relation = formalizes, coverage = exact, quote = "only with respect to the 6 most recent taxable years ending before the examination notice date")
rule S7611UnrelatedBusinessSixYears strict {
    for e: ChurchExamination;
    for ch: Person;
    for y: TaxableYear;
    for n: Integer;
    when examination_for_unrelated_business_tax(e)
        and examination_of_church(e, ch)
        and taxable_year_ordinal_before_notice(ch, y, n)
        and n <= 6;
    then section_511_assessment_window_contains(e, y);
}

// §7611(e): stay of summons proceedings; exclusive remedy
relation noncompliance_with_notice_requirements(e: ChurchExamination) kind empirical {
    label en unofficial "there has not been substantial compliance with the notice requirements of subsection (a) or (b), the conference requirement of (b)(3)(A)(iii), or the approval requirement of (d)(1)";
}
relation proceeding_to_compel_summons_compliance_pending(e: ChurchExamination) kind empirical {
    label en unofficial "a proceeding to compel compliance with a summons for the inquiry or examination is pending";
}
relation court_found_practicable_steps_to_correct_taken(e: ChurchExamination) kind empirical {
    label en unofficial "the court finds that all practicable steps to correct the noncompliance have been taken";
}
pub relation summons_proceeding_stayed(e: ChurchExamination) kind institutional {
    label en unofficial "the proceeding to compel compliance with the summons is stayed until the court finds all practicable steps to correct the noncompliance have been taken; the completion periods are not suspended during the stay";
}
@source(IRC_S7611_E, relation = formalizes, coverage = exact, quote = "any proceeding to compel compliance with any summons with respect to such inquiry or examination shall be stayed until the court finds that all practicable steps to correct the noncompliance have been taken")
rule S7611StayOfSummonsProceeding defeasible {
    for e: ChurchExamination;
    when noncompliance_with_notice_requirements(e)
        and proceeding_to_compel_summons_compliance_pending(e);
    then summons_proceeding_stayed(e);
    unless court_found_practicable_steps_to_correct_taken(e) and noncompliance_with_notice_requirements(e) and proceeding_to_compel_summons_compliance_pending(e);
}
relation suit_or_defense_by_reason_of_noncompliance_with_7611(e: ChurchExamination) kind empirical {
    label en unofficial "a suit is maintained, or a defense raised, by reason of the Secretary's noncompliance with §7611 other than the stay of (e)(1)";
}
pub relation section_7611_remedy_is_exclusive(e: ChurchExamination) kind institutional {
    label en unofficial "no suit may be maintained and no defense raised by reason of noncompliance with §7611 other than the (e)(1) stay";
}
@source(IRC_S7611_E, relation = formalizes, coverage = exact, quote = "No suit may be maintained, and no defense may be raised in any proceeding (other than as provided in paragraph (1)), by reason of any noncompliance by the Secretary with the requirements of this section.")
rule S7611ExclusiveRemedy strict {
    for e: ChurchExamination;
    when suit_or_defense_by_reason_of_noncompliance_with_7611(e);
    then section_7611_remedy_is_exclusive(e);
}

// §7611(f): no repeat inquiries within 5 years
relation prior_inquiry_completed_without_adverse_outcome(ch: Person, start: Date) kind empirical {
    label en unofficial "a prior church tax inquiry or examination of the church was completed without a revocation, notice of deficiency or assessment and without a request for a significant change in operational practices; the 5-year period began on the given notice date";
}
relation new_inquiry_of_church_on(i: ChurchInquiry, ch: Person, on: Date) kind empirical {
    label en unofficial "a new church tax inquiry or examination of the church begins on this date";
}
relation second_inquiry_approved_in_writing_by_secretary(i: ChurchInquiry) kind empirical {
    label en unofficial "the second inquiry or examination is approved in writing by the Secretary";
}
relation second_inquiry_on_different_issues(i: ChurchInquiry) kind empirical {
    label en unofficial "the second inquiry does not involve the same or similar issues as the preceding one";
}
relation new_inquiry_within_5_year_period(i: ChurchInquiry) kind derived {
    label en unofficial "a new inquiry begins within the applicable 5-year period after a completed inquiry with no adverse outcome";
}
@source(IRC_S7611_F, relation = formalizes, coverage = exact, quote = "the term \"applicable 5-year period\" means the 5-year period beginning on the date the notice taken into account for purposes of subsection (c)(1) was provided")
rule S7611NewInquiryWithinFiveYears strict {
    for i: ChurchInquiry;
    for ch: Person;
    for on: Date;
    for start: Date;
    when new_inquiry_of_church_on(i, ch, on)
        and prior_inquiry_completed_without_adverse_outcome(ch, start)
        and on >= start
        and on < add_calendar_period(start, 5 calendar_year);
    then new_inquiry_within_5_year_period(i);
}
@source(IRC_S7611_F, relation = formalizes, coverage = exact, quote = "no other church tax inquiry or examination may begin with respect to such church during the applicable 5-year period unless such inquiry or examination is approved in writing by the Secretary or does not involve the same or similar issues involved in the preceding inquiry or examination")
rule S7611NoRepeatInquiryProhibition defeasible {
    for i: ChurchInquiry;
    when new_inquiry_within_5_year_period(i);
    then prohibition S7611NoRepeatInquiryWithinFiveYears {
        bearer Secretary;
        action new_inquiry_within_5_year_period(i);
        window [-infinity, infinity];
    };
    unless second_inquiry_approved_in_writing_by_secretary(i) and new_inquiry_within_5_year_period(i);
    unless second_inquiry_on_different_issues(i) and new_inquiry_within_5_year_period(i);
}

// §7611(g): revenue agent's final report
relation final_report_of_agent_received_by_church(e: ChurchExamination) kind empirical {
    label en unofficial "a final report of an IRS agent is received by the church";
}
pub relation final_report_treated_as_determination_and_remedies_exhausted(e: ChurchExamination) kind institutional {
    label en unofficial "the final report is a determination of the Secretary under section 7428(a)(1) and the church is treated as having exhausted administrative remedies for sections 7428 and 7430";
}
@source(IRC_S7611_G, relation = formalizes, coverage = exact, quote = "Any final report of an agent of the Internal Revenue Service shall be treated as a determination of the Secretary under paragraph (1) of section 7428(a)")
rule S7611FinalReportIsDetermination strict {
    for e: ChurchExamination;
    when final_report_of_agent_received_by_church(e);
    then final_report_treated_as_determination_and_remedies_exhausted(e);
}
