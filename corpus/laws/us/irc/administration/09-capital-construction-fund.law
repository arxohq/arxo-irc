// 26 U.S.C. §7518 — Capital construction fund for commercial fishing and
// shipping (chapter 535 of title 46, U.S.C.). STAGE 3.
//
// JUDGMENT CALLS
//  - The fund's ledger (three accounts, FIFO/LIFO order of items, capital
//    losses offsetting only matching gains) is a running balance kept across
//    years; balances enter as case facts (`account_balance`), items are
//    classified into accounts by rule, and the ledger itself is TECH-GAPS
//    G3002. Allocation of one withdrawal over the balances is arithmetic and
//    is executable (§7518(f)(1), (g)(2)).
//  - The highest rate of tax under section 1 / section 11 (owners:
//    income-individual, corporations) is a case fact, `highest_rate`, not an
//    import.
//  - Rounding of a Money result: corpus convention (cents, HALF_UP), no
//    rounding named by §7518.
//  - "Joint regulations" (Treasury and the applicable Secretary) are supplied
//    as case facts where a date, a percentage or a procedure depends on them.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    Asset,
    IRC_S7518_A,
    IRC_S7518_B,
    IRC_S7518_C,
    IRC_S7518_D,
    IRC_S7518_E,
    IRC_S7518_F,
    IRC_S7518_G,
    IRC_S7518_H,
    IRC_S7518_TABLE_1,
    Person,
    Secretary,
    TaxableYear,
};

entity CapitalConstructionFund {
    label en unofficial "a fund established under chapter 535 of title 46, U.S.C. (a \"capital construction fund\")";
}
entity FundDeposit {
    label en unofficial "an amount deposited in a capital construction fund";
}
entity FundItem {
    label en unofficial "an item credited to or debited from a capital construction fund account";
}
entity FundWithdrawal {
    label en unofficial "a withdrawal from a capital construction fund";
}
enum FundAccount {
    CapitalAccount;
    CapitalGainAccount;
    OrdinaryIncomeAccount;
}

relation fund_owner(f: CapitalConstructionFund, p: Person) kind empirical {
    label en unofficial "the person maintaining the fund (owner or lessee under the agreement)";
}
relation fund_holder_is_lessee(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the person maintaining the fund is a lessee of the agreement vessel";
}

// --- (a) ceiling on deposits --------------------------------------------------

relation a1a_operating_income(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "(a)(1)(A): that portion of taxable income (computed under chapter 1, without carrybacks and without regard to this section) attributable to operation of the agreement vessels in U.S. commerce or fisheries";
}
relation a1b_section_167_deduction(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "(a)(1)(B): the amount allowable as a deduction under section 167 for the year with respect to the agreement vessels";
}
relation a1c_net_proceeds_not_in_a(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "(a)(1)(C): net proceeds (as defined in joint regulations) from sale or other disposition of, or insurance or indemnity for, an agreement vessel, where the transaction is not taken into account under (A)";
}
relation a1d_investment_receipts(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "(a)(1)(D): receipts from the investment or reinvestment of amounts held in the fund";
}
relation owner_permitted_b_deposit(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "(a)(2): the amount the owner is required or permitted to deposit for the period for the same vessel by reason of (a)(1)(B), under the chapter 535 agreement";
}
relation deposits_for_year(f: CapitalConstructionFund, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the total amount deposited in the fund for the taxable year";
}
pub relation deposit_ceiling(f: CapitalConstructionFund, y: TaxableYear, ceiling: Money) kind institutional {
    label en unofficial "the maximum amount that may be deposited in the fund for the taxable year (§7518(a)(1)-(2))";
}
pub relation deposit_exceeds_ceiling(f: CapitalConstructionFund, y: TaxableYear) kind institutional {
    label en unofficial "deposits for the year exceed the §7518(a) ceiling";
}

@source(IRC_S7518_A, relation = formalizes, coverage = exact, quote = "shall not exceed for any taxable year the sum of:")
rule S7518CeilingOwner strict {
    for f: CapitalConstructionFund;
    for y: TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    when a1a_operating_income(f, y, a)
        and a1b_section_167_deduction(f, y, b)
        and a1c_net_proceeds_not_in_a(f, y, c)
        and a1d_investment_receipts(f, y, d)
        and not_known(fund_holder_is_lessee(f));
    then deposit_ceiling(f, y, a + b + c + d);
}
@source(IRC_S7518_A, relation = formalizes, coverage = exact, quote = "the maximum amount which may be deposited with respect to an agreement vessel by reason of paragraph (1)(B) for any period shall be reduced by any amount which, under an agreement entered into under chapter 535 of title 46, United States Code, the owner is required or permitted to deposit for such period")
rule S7518CeilingLessee strict {
    for f: CapitalConstructionFund;
    for y: TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    for d: Money;
    for o: Money;
    when a1a_operating_income(f, y, a)
        and a1b_section_167_deduction(f, y, b)
        and a1c_net_proceeds_not_in_a(f, y, c)
        and a1d_investment_receipts(f, y, d)
        and fund_holder_is_lessee(f)
        and owner_permitted_b_deposit(f, y, o);
    then deposit_ceiling(f, y, a + (b - o) + c + d);
}
@source(IRC_S7518_A, relation = formalizes, coverage = exact, quote = "The amount deposited in a fund established under chapter 535 of title 46 of the United States Code (hereinafter in this section referred to as a \"capital construction fund\") shall not exceed for any taxable year the sum of:")
rule S7518DepositOverCeiling strict {
    for f: CapitalConstructionFund;
    for y: TaxableYear;
    for total: Money;
    for ceiling: Money;
    when deposits_for_year(f, y, total)
        and deposit_ceiling(f, y, ceiling)
        and total > ceiling;
    then deposit_exceeds_ceiling(f, y);
}
@source(IRC_S7518_A, relation = formalizes, coverage = exact, quote = "shall not exceed for any taxable year the sum of:")
rule S7518NoDepositOverCeiling strict {
    for f: CapitalConstructionFund;
    for y: TaxableYear;
    for p: Person;
    when deposit_exceeds_ceiling(f, y)
        and fund_owner(f, p);
    then prohibition S7518NoDepositOverCeilingProhibition {
        bearer p;
        action deposit_exceeds_ceiling(f, y);
        window [-infinity, infinity];
    };
}
relation barge_or_container_of_complement_in_agreement(v: Asset) kind empirical {
    label en unofficial "the barge or container is part of the complement of the vessel and is provided for in the agreement";
}
pub relation agreement_vessel_for_ceiling(v: Asset) kind institutional {
    label en unofficial "the barge or container counts as an agreement vessel for §7518(a)(1)";
}
@source(IRC_S7518_A, relation = formalizes, coverage = exact, quote = "the term \"agreement vessel\" includes barges and containers which are part of the complement of such vessel and which are provided for in the agreement")
rule S7518BargesAndContainersAreAgreementVessels strict {
    for v: Asset;
    when barge_or_container_of_complement_in_agreement(v);
    then agreement_vessel_for_ceiling(v);
}

// --- (b) investment requirements ------------------------------------------------

enum FundInvestmentKind {
    InterestBearingSecurityApprovedBySecretary;
    ListedDomesticStock;
    OtherInvestment;
}
relation fund_investment(f: CapitalConstructionFund, inv: Asset, k: FundInvestmentKind) kind empirical {
    label en unofficial "the fund holds the investment of the named kind";
}
relation fund_kept_in_specified_depository(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the fund amounts are kept in the depository or depositories specified in the agreement and are subject to the trustee and fiduciary requirements specified by the Secretary";
}
relation secretary_consents_to_stock_investment(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the Secretary consents to the investment of an agreed percentage of the fund assets in stock of domestic corporations";
}
relation agreed_stock_percentage(f: CapitalConstructionFund, pct: Decimal) kind empirical {
    label en unofficial "the agreed percentage of fund assets that may be invested in stock";
}
relation stock_listed_on_national_securities_exchange(inv: Asset) kind empirical {
    label en unofficial "the stock is currently fully listed and registered on an exchange registered with the SEC as a national securities exchange";
}
relation preferred_stock_not_listable_only_because_nonvoting(inv: Asset) kind empirical {
    label en unofficial "the preferred stock would meet the listing requirements but for the fact that it is nonvoting, and the common stock of the corporation meets the requirements";
}
external judgment relation stock_acquirable_by_prudent_persons(inv: Asset) {
    authority TaxCourt;
    label en unofficial "the stock is stock which would be acquired by prudent men of discretion and intelligence seeking a reasonable income and the preservation of their capital (§7518(b)(2))";
}
relation stock_meets_listing_requirements(inv: Asset) kind derived {
    label en unofficial "the stock is listed and registered as required, or is nonvoting preferred stock treated as meeting the requirement (§7518(b)(3))";
}
relation stock_investment_permitted(f: CapitalConstructionFund, inv: Asset) kind derived {
    label en unofficial "the stock investment is within the Secretary's consent, the 60 percent ceiling, the listing requirement and the prudent-person standard";
}
relation fund_invests_unpermitted_asset(f: CapitalConstructionFund) kind institutional {
    label en unofficial "the fund holds an investment that §7518(b)(2) does not allow";
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "Amounts in any capital construction fund shall be kept in the depository or depositories specified in the agreement and shall be subject to such trustee and other fiduciary requirements as may be specified by the Secretary.")
rule S7518DepositoryDuty strict {
    for f: CapitalConstructionFund;
    for p: Person;
    when fund_owner(f, p);
    then duty S7518KeepFundInSpecifiedDepository {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition fund_kept_in_specified_depository(f);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "if the common stock of a corporation meets the requirements of this subsection and if the preferred stock of such corporation would meet such requirements but for the fact that it cannot be listed and registered as required because it is nonvoting stock, such preferred stock shall be treated as meeting the requirements of this subsection")
rule S7518PreferredStockTreatedAsListed strict {
    for inv: Asset;
    when preferred_stock_not_listable_only_because_nonvoting(inv);
    then stock_meets_listing_requirements(inv);
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "Such stock must be currently fully listed and registered on an exchange registered with the Securities and Exchange Commission as a national securities exchange")
rule S7518ListedStockMeetsRequirements strict {
    for inv: Asset;
    when stock_listed_on_national_securities_exchange(inv);
    then stock_meets_listing_requirements(inv);
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "if such Secretary consents thereto, an agreed percentage (not in excess of 60 percent) of the assets of the fund may be invested in the stock of domestic corporations")
rule S7518StockInvestmentPermitted strict {
    for f: CapitalConstructionFund;
    for inv: Asset;
    for pct: Decimal;
    when fund_investment(f, inv, ListedDomesticStock)
        and secretary_consents_to_stock_investment(f)
        and agreed_stock_percentage(f, pct)
        and pct <= 0.60
        and stock_meets_listing_requirements(inv)
        and stock_acquirable_by_prudent_persons(inv);
    then stock_investment_permitted(f, inv);
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "Amounts in any capital construction fund may be invested only in interest-bearing securities approved by the Secretary")
rule S7518UnpermittedOtherInvestment strict {
    for f: CapitalConstructionFund;
    for inv: Asset;
    when fund_investment(f, inv, OtherInvestment);
    then fund_invests_unpermitted_asset(f);
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "if such Secretary consents thereto, an agreed percentage (not in excess of 60 percent)")
rule S7518UnpermittedStock strict {
    for f: CapitalConstructionFund;
    for inv: Asset;
    when fund_investment(f, inv, ListedDomesticStock)
        and not_known(stock_investment_permitted(f, inv));
    then fund_invests_unpermitted_asset(f);
}
@source(IRC_S7518_B, relation = formalizes, coverage = exact, quote = "Amounts in any capital construction fund may be invested only in interest-bearing securities approved by the Secretary")
rule S7518InvestmentProhibition strict {
    for f: CapitalConstructionFund;
    for p: Person;
    when fund_invests_unpermitted_asset(f)
        and fund_owner(f, p);
    then prohibition S7518NoUnpermittedInvestment {
        bearer p;
        beneficiary Secretary;
        action fund_invests_unpermitted_asset(f);
        window [-infinity, infinity];
    };
}

// --- (c) nontaxability for deposits ---------------------------------------------

relation deposit_of_fund(d: FundDeposit, f: CapitalConstructionFund) kind empirical {
    label en unofficial "the deposit is made to this fund";
}
relation deposit_amount(d: FundDeposit, amt: Money) kind empirical {
    label en unofficial "the amount of the deposit";
}
relation deposit_out_of_a1a_amounts(d: FundDeposit) kind empirical {
    label en unofficial "the deposit is out of amounts referred to in (a)(1)(A)";
}
relation deposit_pursuant_to_agreement(d: FundDeposit) kind empirical {
    label en unofficial "the amount is deposited pursuant to the chapter 535 agreement";
}
relation deposit_made_on(d: FundDeposit, on: Date) kind empirical {
    label en unofficial "the date the deposit is made";
}
relation joint_regulation_deposit_deadline(d: FundDeposit, deadline: Date) kind empirical {
    label en unofficial "the time provided in joint regulations by which the deposit must be made";
}
pub relation qualified_deposit(d: FundDeposit) kind institutional {
    label en unofficial "the deposit is made pursuant to the agreement and not later than the time provided in joint regulations (§7518(c)(2))";
}
pub relation taxable_income_reduction_for_deposit(d: FundDeposit, amt: Money) kind institutional {
    label en unofficial "taxable income for the year is reduced by the amount deposited out of (a)(1)(A) amounts (§7518(c)(1)(A))";
}
relation net_proceeds_deposited_in_fund(d: FundDeposit) kind empirical {
    label en unofficial "an amount equal to the net proceeds from the (a)(1)(C) transaction is deposited in the fund";
}
relation deposit_for_transaction_gain(d: FundDeposit) kind empirical {
    label en unofficial "the deposit relates to a gain from a transaction referred to in (a)(1)(C)";
}
pub relation gain_not_taken_into_account(d: FundDeposit) kind institutional {
    label en unofficial "the gain from the (a)(1)(C) transaction is not taken into account (§7518(c)(1)(B))";
}
pub relation fund_earnings_disregarded(f: CapitalConstructionFund) kind institutional {
    label en unofficial "earnings (including gains and losses) from investment of amounts in the fund are not taken into account for title purposes (§7518(c)(1)(C)); the fund's amounts are also disregarded in earnings and profits (D) and in the section 531 tax (E)";
}
@source(IRC_S7518_C, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply with respect to any amount only if such amount is deposited in the fund pursuant to the agreement and not later than the time provided in joint regulations.")
rule S7518QualifiedDeposit strict {
    for d: FundDeposit;
    for made: Date;
    for deadline: Date;
    when deposit_pursuant_to_agreement(d)
        and deposit_made_on(d, made)
        and joint_regulation_deposit_deadline(d, deadline)
        and made <= deadline;
    then qualified_deposit(d);
}
@source(IRC_S7518_C, relation = formalizes, coverage = exact, quote = "taxable income (determined without regard to this section and chapter 535 of title 46, United States Code) for the taxable year shall be reduced by an amount equal to the amount deposited for the taxable year out of amounts referred to in subsection (a)(1)(A)")
rule S7518TaxableIncomeReduction strict {
    for d: FundDeposit;
    for amt: Money;
    when qualified_deposit(d)
        and deposit_out_of_a1a_amounts(d)
        and deposit_amount(d, amt);
    then taxable_income_reduction_for_deposit(d, amt);
}
@source(IRC_S7518_C, relation = formalizes, coverage = exact, quote = "gain from a transaction referred to in subsection (a)(1)(C) shall not be taken into account if an amount equal to the net proceeds (as defined in joint regulations) from such transaction is deposited in the fund")
rule S7518GainNotTakenIntoAccount strict {
    for d: FundDeposit;
    when qualified_deposit(d)
        and deposit_for_transaction_gain(d)
        and net_proceeds_deposited_in_fund(d);
    then gain_not_taken_into_account(d);
}
@source(IRC_S7518_C, relation = formalizes, coverage = exact, quote = "the earnings (including gains and losses) from the investment and reinvestment of amounts held in the fund shall not be taken into account")
rule S7518FundEarningsDisregarded strict {
    for d: FundDeposit;
    for f: CapitalConstructionFund;
    when qualified_deposit(d)
        and deposit_of_fund(d, f);
    then fund_earnings_disregarded(f);
}

// --- (d) accounts -----------------------------------------------------------------

enum FundItemKind {
    DepositOfSection167Amount;
    NetProceedsExcludingGainNotTaken;
    DividendPercentageUnderSection243;
    TaxExemptInterestSection103;
    CapitalGainHeldMoreThanSixMonths;
    CapitalLossHeldMoreThanSixMonths;
    DepositOfOperatingIncomeA1A;
    CapitalGainHeldSixMonthsOrLess;
    CapitalLossHeldSixMonthsOrLess;
    InterestAndOtherOrdinaryIncome;
    OrdinaryIncomeFromA1CTransaction;
    DividendPortionNotInCapitalAccount;
}
relation fund_maintains_three_accounts(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the fund maintains the capital account, the capital gain account, and the ordinary income account";
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "Within a capital construction fund 3 accounts shall be maintained:")
rule S7518MaintainThreeAccountsDuty strict {
    for f: CapitalConstructionFund;
    for p: Person;
    when fund_owner(f, p);
    then duty S7518MaintainThreeAccounts {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition fund_maintains_three_accounts(f);
            window [-infinity, infinity];
        }
    };
}
relation fund_item_kind(i: FundItem, k: FundItemKind) kind empirical {
    label en unofficial "the fund item is of the named kind";
}
pub relation fund_item_account(i: FundItem, a: FundAccount) kind institutional {
    label en unofficial "the fund item belongs to the named account of the capital construction fund (§7518(d))";
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts referred to in subsection (a)(1)(B)")
rule S7518CapitalAccountSection167 strict {
    for i: FundItem;
    when fund_item_kind(i, DepositOfSection167Amount);
    then fund_item_account(i, CapitalAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts referred to in subsection (a)(1)(C) other than that portion thereof which represents gain not taken into account by reason of subsection (c)(1)(B)")
rule S7518CapitalAccountNetProceeds strict {
    for i: FundItem;
    when fund_item_kind(i, NetProceedsExcludingGainNotTaken);
    then fund_item_account(i, CapitalAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "the percentage applicable under section 243(a)(1) of any dividend received by the fund")
rule S7518CapitalAccountDividend strict {
    for i: FundItem;
    when fund_item_kind(i, DividendPercentageUnderSection243);
    then fund_item_account(i, CapitalAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "interest income exempt from taxation under section 103")
rule S7518CapitalAccountTaxExemptInterest strict {
    for i: FundItem;
    when fund_item_kind(i, TaxExemptInterestSection103);
    then fund_item_account(i, CapitalAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts representing capital gains on assets held for more than 6 months")
rule S7518GainAccountLongTermGain strict {
    for i: FundItem;
    when fund_item_kind(i, CapitalGainHeldMoreThanSixMonths);
    then fund_item_account(i, CapitalGainAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts representing capital losses on assets held in the fund for more than 6 months")
rule S7518GainAccountLongTermLoss strict {
    for i: FundItem;
    when fund_item_kind(i, CapitalLossHeldMoreThanSixMonths);
    then fund_item_account(i, CapitalGainAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts referred to in subsection (a)(1)(A)")
rule S7518OrdinaryAccountOperatingIncome strict {
    for i: FundItem;
    when fund_item_kind(i, DepositOfOperatingIncomeA1A);
    then fund_item_account(i, OrdinaryIncomeAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts representing capital gains on assets held for 6 months or less")
rule S7518OrdinaryAccountShortTermGain strict {
    for i: FundItem;
    when fund_item_kind(i, CapitalGainHeldSixMonthsOrLess);
    then fund_item_account(i, OrdinaryIncomeAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "amounts representing capital losses on assets held in the fund for 6 months or less")
rule S7518OrdinaryAccountShortTermLoss strict {
    for i: FundItem;
    when fund_item_kind(i, CapitalLossHeldSixMonthsOrLess);
    then fund_item_account(i, OrdinaryIncomeAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "interest (not including any tax-exempt interest referred to in paragraph (2)(D)) and other ordinary income")
rule S7518OrdinaryAccountInterest strict {
    for i: FundItem;
    when fund_item_kind(i, InterestAndOtherOrdinaryIncome);
    then fund_item_account(i, OrdinaryIncomeAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "ordinary income from a transaction described in subsection (a)(1)(C)")
rule S7518OrdinaryAccountTransactionIncome strict {
    for i: FundItem;
    when fund_item_kind(i, OrdinaryIncomeFromA1CTransaction);
    then fund_item_account(i, OrdinaryIncomeAccount);
}
@source(IRC_S7518_D, relation = formalizes, coverage = exact, quote = "the portion of any dividend referred to in paragraph (2)(C) not taken into account under such paragraph")
rule S7518OrdinaryAccountDividendRemainder strict {
    for i: FundItem;
    when fund_item_kind(i, DividendPortionNotInCapitalAccount);
    then fund_item_account(i, OrdinaryIncomeAccount);
}

// --- (e) qualified withdrawals ----------------------------------------------------

enum WithdrawalPurpose {
    AcquireOrBuildQualifiedVessel;
    AcquireOrBuildBargesOrContainers;
    PrincipalOnQualifiedVesselDebt;
    PrincipalOnBargeOrContainerDebt;
    AnyOtherPurpose;
}
relation withdrawal_from_fund(w: FundWithdrawal, f: CapitalConstructionFund) kind empirical {
    label en unofficial "the withdrawal is from this fund";
}
relation withdrawal_purpose(w: FundWithdrawal, p: WithdrawalPurpose) kind empirical {
    label en unofficial "the purpose for which the withdrawal is made";
}
relation withdrawal_amount(w: FundWithdrawal, amt: Money) kind empirical {
    label en unofficial "the amount withdrawn";
}
relation withdrawal_in_accordance_with_agreement(w: FundWithdrawal) kind empirical {
    label en unofficial "the withdrawal is made in accordance with the terms of the agreement";
}
relation barges_or_containers_constructed_in_us(w: FundWithdrawal) kind empirical {
    label en unofficial "the barges and containers are constructed in the United States";
}
relation regulation_allows_foreign_constructed_barges_or_containers(w: FundWithdrawal) kind empirical {
    label en unofficial "the Secretary's regulations provide otherwise for barges and containers not constructed in the United States";
}
relation barge_container_construction_test_met(w: FundWithdrawal) kind derived {
    label en unofficial "the barge or container is US-constructed or the Secretary's regulations except it";
}
pub relation qualified_withdrawal(w: FundWithdrawal) kind institutional {
    label en unofficial "the withdrawal is a qualified withdrawal (§7518(e)(1))";
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "Except to the extent provided in regulations prescribed by the Secretary, subparagraph (B), and so much of subparagraph (C) as relates only to barges and containers, shall apply only with respect to barges and containers constructed in the United States.")
rule S7518BargeConstructionUS strict {
    for w: FundWithdrawal;
    when barges_or_containers_constructed_in_us(w);
    then barge_container_construction_test_met(w);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "Except to the extent provided in regulations prescribed by the Secretary")
rule S7518BargeConstructionException strict {
    for w: FundWithdrawal;
    when regulation_allows_foreign_constructed_barges_or_containers(w);
    then barge_container_construction_test_met(w);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "the acquisition, construction, or reconstruction of a qualified vessel")
rule S7518QualifiedForVessel strict {
    for w: FundWithdrawal;
    when withdrawal_in_accordance_with_agreement(w)
        and withdrawal_purpose(w, AcquireOrBuildQualifiedVessel);
    then qualified_withdrawal(w);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "the acquisition, construction, or reconstruction of barges and containers which are part of the complement of a qualified vessel")
rule S7518QualifiedForBargesAndContainers strict {
    for w: FundWithdrawal;
    when withdrawal_in_accordance_with_agreement(w)
        and withdrawal_purpose(w, AcquireOrBuildBargesOrContainers)
        and barge_container_construction_test_met(w);
    then qualified_withdrawal(w);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "the payment of the principal on indebtedness incurred in connection with the acquisition, construction, or reconstruction of a qualified vessel")
rule S7518QualifiedForVesselDebt strict {
    for w: FundWithdrawal;
    when withdrawal_in_accordance_with_agreement(w)
        and withdrawal_purpose(w, PrincipalOnQualifiedVesselDebt);
    then qualified_withdrawal(w);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "or a barge or container which is part of the complement of a qualified vessel")
rule S7518QualifiedForBargeContainerDebt strict {
    for w: FundWithdrawal;
    when withdrawal_in_accordance_with_agreement(w)
        and withdrawal_purpose(w, PrincipalOnBargeOrContainerDebt)
        and barge_container_construction_test_met(w);
    then qualified_withdrawal(w);
}

relation substantial_obligation_unfulfilled_determination(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the Secretary determines, under joint regulations, that a substantial obligation under the agreement is not being fulfilled";
}
relation notice_and_hearing_given_to_fund_holder(f: CapitalConstructionFund) kind empirical {
    label en unofficial "notice and opportunity for hearing were given to the person maintaining the fund";
}
relation secretary_treats_fund_as_nonqualified_withdrawal(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the Secretary treats the entire fund or a portion as an amount withdrawn in a nonqualified withdrawal";
}
relation s7518e2_conditions_met(f: CapitalConstructionFund) kind derived {
    label en unofficial "the Secretary determined that a substantial obligation is unfulfilled and notice and opportunity for hearing were given";
}
pub relation fund_treated_as_nonqualified_withdrawal(f: CapitalConstructionFund) kind institutional {
    label en unofficial "the fund (or portion) is treated as withdrawn in a nonqualified withdrawal (§7518(e)(2))";
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "if the Secretary determines that any substantial obligation under any agreement is not being fulfilled, he may, after notice and opportunity for hearing to the person maintaining the fund")
rule S7518E2Conditions strict {
    for f: CapitalConstructionFund;
    when substantial_obligation_unfulfilled_determination(f)
        and notice_and_hearing_given_to_fund_holder(f);
    then s7518e2_conditions_met(f);
}
@source(IRC_S7518_E, relation = formalizes, coverage = exact, quote = "he may, after notice and opportunity for hearing to the person maintaining the fund, treat the entire fund or any portion thereof as an amount withdrawn from the fund in a nonqualified withdrawal")
rule S7518E2PenaltyPower strict {
    for f: CapitalConstructionFund;
    when secretary_treats_fund_as_nonqualified_withdrawal(f);
    then power S7518TreatFundAsNonqualified {
        holder Secretary;
        over f;
        exercise secretary_treats_fund_as_nonqualified_withdrawal(f);
        valid_when s7518e2_conditions_met(f);
        effect create(fund_treated_as_nonqualified_withdrawal(f));
    };
}

// --- (f) qualified withdrawals: ordering and basis ---------------------------------

relation account_balance(f: CapitalConstructionFund, a: FundAccount, amt: Money) kind empirical {
    label en unofficial "the balance of the named account of the fund immediately before the withdrawal; the ledger itself is TECH-GAPS G3002";
}
pub relation withdrawal_from_account(w: FundWithdrawal, a: FundAccount, amt: Money) kind institutional {
    label en unofficial "the portion of the withdrawal treated as made out of the named account: qualified in the order capital, capital gain, ordinary income (§7518(f)(1)); nonqualified in the order ordinary income, capital gain, capital (§7518(g)(2))";
}
relation transfer_relief_applies(w: FundWithdrawal) kind derived {
    label en unofficial "computational twin of the (h) power effect (E-0134): the same premises as its valid_when, readable by not_known";
}
relation nonqualified_withdrawal(w: FundWithdrawal) kind institutional {
    label en unofficial "any withdrawal that is not a qualified withdrawal (§7518(g)(1)); the (h) transfer relief is a separate exclusion";
}
relation transfer_treated_as_not_nonqualified_withdrawal(w: FundWithdrawal) kind empirical {
    label en unofficial "under joint regulations a section 381 transfer or partnership continuation is treated as not a nonqualified withdrawal (§7518(h))";
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "Except as provided in subsection (h), any withdrawal from a capital construction fund which is not a qualified withdrawal shall be treated as a nonqualified withdrawal.")
rule S7518NonqualifiedWithdrawal strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    when withdrawal_from_fund(w, f)
        and not_known(qualified_withdrawal(w))
        and not_known(transfer_relief_applies(w));
    then nonqualified_withdrawal(w);
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "first as made out of the capital account")
rule S7518QualifiedFromCapitalAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bal: Money;
    when qualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, CapitalAccount, bal);
    then withdrawal_from_account(w, CapitalAccount, min(amt, bal));
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "second as made out of the capital gain account")
rule S7518QualifiedFromCapitalGainAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bc: Money;
    for bg: Money;
    when qualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, CapitalAccount, bc)
        and account_balance(f, CapitalGainAccount, bg);
    then withdrawal_from_account(w, CapitalGainAccount, min(max(0.00 USD, amt - bc), bg));
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "third as made out of the ordinary income account")
rule S7518QualifiedFromOrdinaryAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bc: Money;
    for bg: Money;
    when qualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, CapitalAccount, bc)
        and account_balance(f, CapitalGainAccount, bg);
    then withdrawal_from_account(w, OrdinaryIncomeAccount, max(0.00 USD, amt - bc - bg));
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "first as made out of the ordinary income account")
rule S7518NonqualifiedFromOrdinaryAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bal: Money;
    when nonqualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, OrdinaryIncomeAccount, bal);
    then withdrawal_from_account(w, OrdinaryIncomeAccount, min(amt, bal));
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "second as made out of the capital gain account")
rule S7518NonqualifiedFromCapitalGainAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bo: Money;
    for bg: Money;
    when nonqualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, OrdinaryIncomeAccount, bo)
        and account_balance(f, CapitalGainAccount, bg);
    then withdrawal_from_account(w, CapitalGainAccount, min(max(0.00 USD, amt - bo), bg));
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "third as made out of the capital account")
rule S7518NonqualifiedFromCapitalAccount strict {
    for w: FundWithdrawal;
    for f: CapitalConstructionFund;
    for amt: Money;
    for bo: Money;
    for bg: Money;
    when nonqualified_withdrawal(w)
        and withdrawal_from_fund(w, f)
        and withdrawal_amount(w, amt)
        and account_balance(f, OrdinaryIncomeAccount, bo)
        and account_balance(f, CapitalGainAccount, bg);
    then withdrawal_from_account(w, CapitalAccount, max(0.00 USD, amt - bo - bg));
}

relation withdrawal_for_vessel_barge_or_container(w: FundWithdrawal) kind derived {
    label en unofficial "the qualified withdrawal is for a vessel, barge, or container (not to pay principal on debt)";
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "If any portion of a qualified withdrawal for a vessel, barge, or container is made out of the ordinary income account, the basis of such vessel, barge, or container shall be reduced by an amount equal to such portion.")
rule S7518PurposeVessel strict {
    for w: FundWithdrawal;
    when withdrawal_purpose(w, AcquireOrBuildQualifiedVessel);
    then withdrawal_for_vessel_barge_or_container(w);
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "If any portion of a qualified withdrawal for a vessel, barge, or container is made out of the capital gain account, the basis of such vessel, barge, or container shall be reduced by an amount equal to such portion.")
rule S7518PurposeBargeOrContainer strict {
    for w: FundWithdrawal;
    when withdrawal_purpose(w, AcquireOrBuildBargesOrContainers);
    then withdrawal_for_vessel_barge_or_container(w);
}
pub relation basis_reduction_for_asset(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the amount by which the basis of the vessel, barge, or container acquired is reduced: the portions of a qualified withdrawal out of the ordinary income account and the capital gain account (§7518(f)(2)-(3))";
}
pub relation basis_reduction_owed_on_debt_payment(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the aggregate reduction that would apply under (f)(2)-(3) if the withdrawal to pay principal were for the vessel: applied, in the order provided in joint regulations, to reduce the basis of vessels, barges and containers owned (§7518(f)(4)); the ordering and any excess treated as nonqualified are TECH-GAPS G3003";
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "the basis of such vessel, barge, or container shall be reduced by an amount equal to such portion")
rule S7518BasisReductionForAsset strict {
    for w: FundWithdrawal;
    for go: Money;
    for gg: Money;
    when qualified_withdrawal(w)
        and withdrawal_for_vessel_barge_or_container(w)
        and withdrawal_from_account(w, OrdinaryIncomeAccount, go)
        and withdrawal_from_account(w, CapitalGainAccount, gg);
    then basis_reduction_for_asset(w, go + gg);
}
@source(IRC_S7518_F, relation = formalizes, coverage = partial, quote = "then an amount equal to the aggregate reduction which would be required by paragraphs (2) and (3) if this were a qualified withdrawal for a purpose described in such paragraphs shall be applied")
rule S7518BasisReductionOnVesselDebt strict {
    for w: FundWithdrawal;
    for go: Money;
    for gg: Money;
    when qualified_withdrawal(w)
        and withdrawal_purpose(w, PrincipalOnQualifiedVesselDebt)
        and withdrawal_from_account(w, OrdinaryIncomeAccount, go)
        and withdrawal_from_account(w, CapitalGainAccount, gg);
    then basis_reduction_owed_on_debt_payment(w, go + gg);
}
@source(IRC_S7518_F, relation = formalizes, coverage = partial, quote = "then an amount equal to the aggregate reduction which would be required by paragraphs (2) and (3) if this were a qualified withdrawal for a purpose described in such paragraphs shall be applied")
rule S7518BasisReductionOnBargeDebt strict {
    for w: FundWithdrawal;
    for go: Money;
    for gg: Money;
    when qualified_withdrawal(w)
        and withdrawal_purpose(w, PrincipalOnBargeOrContainerDebt)
        and withdrawal_from_account(w, OrdinaryIncomeAccount, go)
        and withdrawal_from_account(w, CapitalGainAccount, gg);
    then basis_reduction_owed_on_debt_payment(w, go + gg);
}

// (f)(5) recapture of the basis reduction
relation disposition_gain_on_reduced_basis_property(w: FundWithdrawal, gain: Money) kind empirical {
    label en unofficial "the gain realized on a disposition of property whose basis was reduced under (f)(2), (3) or (4)";
}
relation aggregate_basis_reduction_on_property(w: FundWithdrawal, amt: Money) kind empirical {
    label en unofficial "the aggregate reduction in basis of the property under (f)(2), (3) and (4)";
}
relation redeposit_restores_fund(w: FundWithdrawal) kind empirical {
    label en unofficial "under joint regulations a redeposit restores the fund, insofar as practicable, to its position before the withdrawal";
}
pub relation recapture_treated_as_ordinary_income_withdrawal(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the gain, to the extent it does not exceed the aggregate basis reduction, is treated as an amount referred to in (g)(3)(A) withdrawn on the date of the disposition (§7518(f)(5))";
}
@source(IRC_S7518_F, relation = formalizes, coverage = exact, quote = "any gain realized on such disposition, to the extent it does not exceed the aggregate reduction in the basis of such property under such paragraphs, shall be treated as an amount referred to in subsection (g)(3)(A) which was withdrawn on the date of such disposition")
rule S7518RecaptureOnDisposition defeasible {
    for w: FundWithdrawal;
    for gain: Money;
    for red: Money;
    when disposition_gain_on_reduced_basis_property(w, gain)
        and aggregate_basis_reduction_on_property(w, red);
    then recapture_treated_as_ordinary_income_withdrawal(w, min(gain, red));
    unless redeposit_restores_fund(w) and disposition_gain_on_reduced_basis_property(w, gain) and aggregate_basis_reduction_on_property(w, red);
}

// --- (g) nonqualified withdrawals -----------------------------------------------------

pub relation nonqualified_withdrawal_ordinary_income(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the part of a nonqualified withdrawal out of the ordinary income account, included as ordinary income for the year of withdrawal (§7518(g)(3)(A))";
}
pub relation nonqualified_withdrawal_long_term_gain(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the part of a nonqualified withdrawal out of the capital gain account, included as gain from an asset held more than 6 months (§7518(g)(3)(B))";
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "any amount referred to in paragraph (2)(A) shall be included in income as an item of ordinary income for the taxable year in which the withdrawal is made")
rule S7518IncludeOrdinaryIncome strict {
    for w: FundWithdrawal;
    for amt: Money;
    when nonqualified_withdrawal(w)
        and withdrawal_from_account(w, OrdinaryIncomeAccount, amt);
    then nonqualified_withdrawal_ordinary_income(w, amt);
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "any amount referred to in paragraph (2)(B) shall be included in income for the taxable year in which the withdrawal is made as an item of gain realized during such year from the disposition of an asset held for more than 6 months")
rule S7518IncludeLongTermGain strict {
    for w: FundWithdrawal;
    for amt: Money;
    when nonqualified_withdrawal(w)
        and withdrawal_from_account(w, CapitalGainAccount, amt);
    then nonqualified_withdrawal_long_term_gain(w, amt);
}
relation withdrawal_year_last_payment_date(w: FundWithdrawal, d: Date) kind empirical {
    label en unofficial "the last date prescribed for payment of tax for the taxable year in which the withdrawal is made";
}
relation interest_or_addition_assessed_on(w: FundWithdrawal, d: Date) kind empirical {
    label en unofficial "interest under section 6601 or an addition under section 6651 is asserted for a period ending on this date on the additional tax attributable to the withdrawal";
}
pub relation no_interest_or_addition_through_payment_date(w: FundWithdrawal) kind institutional {
    label en unofficial "for the period on or before the last date prescribed for payment of tax for the year of withdrawal, no interest is payable under section 6601 and no addition under section 6651 (§7518(g)(3)(C)(i))";
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "no interest shall be payable under section 6601 and no addition to the tax shall be payable under section 6651")
rule S7518NoInterestBeforePaymentDate strict {
    for w: FundWithdrawal;
    for last: Date;
    for asserted: Date;
    when nonqualified_withdrawal(w)
        and withdrawal_year_last_payment_date(w, last)
        and interest_or_addition_assessed_on(w, asserted)
        and asserted <= last;
    then no_interest_or_addition_through_payment_date(w);
}

// (g)(5) amounts remaining after 25 years
relation remaining_at_close_of_year_after_deposit(f: CapitalConstructionFund, d: FundDeposit, k: Integer, amt: Money) kind empirical {
    label en unofficial "the amount deposited for the deposit year that remains in the fund at the close of the k-th taxable year following the deposit year (earnings other than net gains count as deposits for their year, (g)(5)(B))";
}
relation binding_contract_for_qualified_withdrawal(f: CapitalConstructionFund, d: FundDeposit, k: Integer) kind empirical {
    label en unofficial "at the close of the year there is a binding contract for a qualified withdrawal of the amount with respect to an identified item";
}
pub relation deemed_nonqualified_after_25_years(f: CapitalConstructionFund, d: FundDeposit, k: Integer, amt: Money) kind institutional {
    label en unofficial "the applicable percentage (20/40/60/80/100 percent for the 26th through 30th year) of the amount remaining is treated as a nonqualified withdrawal (§7518(g)(5)(A))";
}
@source(IRC_S7518_TABLE_1, relation = formalizes, coverage = exact, quote = "20 percent")
rule S7518Table26 defeasible {
    for f: CapitalConstructionFund;
    for d: FundDeposit;
    for amt: Money;
    when remaining_at_close_of_year_after_deposit(f, d, 26, amt);
    then deemed_nonqualified_after_25_years(f, d, 26, round(amt * 0.20, 2, "HALF_UP"));
    unless binding_contract_for_qualified_withdrawal(f, d, 26) and remaining_at_close_of_year_after_deposit(f, d, 26, amt);
}
@source(IRC_S7518_TABLE_1, relation = formalizes, coverage = exact, quote = "40 percent")
rule S7518Table27 defeasible {
    for f: CapitalConstructionFund;
    for d: FundDeposit;
    for amt: Money;
    when remaining_at_close_of_year_after_deposit(f, d, 27, amt);
    then deemed_nonqualified_after_25_years(f, d, 27, round(amt * 0.40, 2, "HALF_UP"));
    unless binding_contract_for_qualified_withdrawal(f, d, 27) and remaining_at_close_of_year_after_deposit(f, d, 27, amt);
}
@source(IRC_S7518_TABLE_1, relation = formalizes, coverage = exact, quote = "60 percent")
rule S7518Table28 defeasible {
    for f: CapitalConstructionFund;
    for d: FundDeposit;
    for amt: Money;
    when remaining_at_close_of_year_after_deposit(f, d, 28, amt);
    then deemed_nonqualified_after_25_years(f, d, 28, round(amt * 0.60, 2, "HALF_UP"));
    unless binding_contract_for_qualified_withdrawal(f, d, 28) and remaining_at_close_of_year_after_deposit(f, d, 28, amt);
}
@source(IRC_S7518_TABLE_1, relation = formalizes, coverage = exact, quote = "80 percent")
rule S7518Table29 defeasible {
    for f: CapitalConstructionFund;
    for d: FundDeposit;
    for amt: Money;
    when remaining_at_close_of_year_after_deposit(f, d, 29, amt);
    then deemed_nonqualified_after_25_years(f, d, 29, round(amt * 0.80, 2, "HALF_UP"));
    unless binding_contract_for_qualified_withdrawal(f, d, 29) and remaining_at_close_of_year_after_deposit(f, d, 29, amt);
}
@source(IRC_S7518_TABLE_1, relation = formalizes, coverage = exact, quote = "100 percent.")
rule S7518Table30 defeasible {
    for f: CapitalConstructionFund;
    for d: FundDeposit;
    for amt: Money;
    when remaining_at_close_of_year_after_deposit(f, d, 30, amt);
    then deemed_nonqualified_after_25_years(f, d, 30, amt);
    unless binding_contract_for_qualified_withdrawal(f, d, 30) and remaining_at_close_of_year_after_deposit(f, d, 30, amt);
}

// (g)(6) nonqualified withdrawals taxed at the highest marginal rate
relation highest_rate(p: Person, y: TaxableYear, rate: Decimal) kind empirical {
    label en unofficial "the highest rate of tax specified in section 1 (section 11 in the case of a corporation) for the year (owners: income-individual, corporations)";
}
relation nonqualified_withdrawal_in_year(w: FundWithdrawal, p: Person, y: TaxableYear) kind empirical {
    label en unofficial "the nonqualified withdrawal is made by this person in this taxable year";
}
relation person_is_corporation_for_withdrawal(p: Person) kind empirical {
    label en unofficial "the person maintaining the fund is a corporation";
}
relation section_1h_applies_for_year(p: Person, y: TaxableYear) kind empirical {
    label en unofficial "section 1(h) applies to the taxable year";
}
relation portion_attributable_to_deposits_without_tax_benefit(w: FundWithdrawal, amt: Money) kind empirical {
    label en unofficial "the portion of the nonqualified withdrawal properly attributable to deposits (other than earnings) that did not reduce chapter 1 liability for any earlier year";
}
pub relation withdrawal_tax_rate_for_gain_account_portion(w: FundWithdrawal, rate: Decimal) kind institutional {
    label en unofficial "the rate applied to the capital-gain-account portion: the highest rate, capped at 20 percent for a non-corporation for a year to which section 1(h) applies";
}
pub relation nonqualified_withdrawal_tax_increase(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the increase in the chapter 1 tax by reason of the nonqualified withdrawal: the highest-rate tax on the taxed part, with the capital gain account portion at its own rate (§7518(g)(6)(A)(ii))";
}
pub relation withdrawal_portion_treated_as_nol_deduction(w: FundWithdrawal, amt: Money) kind institutional {
    label en unofficial "the portion attributable to deposits without a tax benefit is excluded from the increase and treated as a section 172 deduction for the year of withdrawal (§7518(g)(6)(B))";
}
relation gain_account_rate_capped(w: FundWithdrawal) kind derived {
    label en unofficial "the 20 percent cap applies to the capital-gain-account portion of this nonqualified withdrawal";
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "the rate of tax taken into account under the preceding sentence shall not exceed 20 percent")
rule S7518GainAccountRateCapApplies strict {
    for w: FundWithdrawal;
    for p: Person;
    for y: TaxableYear;
    for rate: Decimal;
    when nonqualified_withdrawal_in_year(w, p, y)
        and highest_rate(p, y, rate)
        and not_known(person_is_corporation_for_withdrawal(p))
        and section_1h_applies_for_year(p, y)
        and rate > 0.20;
    then gain_account_rate_capped(w);
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "the rate of tax taken into account under the preceding sentence shall not exceed 20 percent")
rule S7518GainAccountRateCapped strict {
    for w: FundWithdrawal;
    when gain_account_rate_capped(w);
    then withdrawal_tax_rate_for_gain_account_portion(w, 0.20);
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "the product of the amount of such withdrawal and the highest rate of tax specified in section 1 (section 11 in the case of a corporation)")
rule S7518GainAccountRateUncapped strict {
    for w: FundWithdrawal;
    for p: Person;
    for y: TaxableYear;
    for rate: Decimal;
    when nonqualified_withdrawal_in_year(w, p, y)
        and highest_rate(p, y, rate)
        and not_known(gain_account_rate_capped(w));
    then withdrawal_tax_rate_for_gain_account_portion(w, rate);
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "by increasing the tax imposed by chapter 1 by the product of the amount of such withdrawal and the highest rate of tax specified in section 1 (section 11 in the case of a corporation)")
rule S7518TaxIncrease strict {
    for w: FundWithdrawal;
    for p: Person;
    for y: TaxableYear;
    for amt: Money;
    for gain: Money;
    for benefit: Money;
    for rate: Decimal;
    for grate: Decimal;
    when nonqualified_withdrawal_in_year(w, p, y)
        and withdrawal_amount(w, amt)
        and withdrawal_from_account(w, CapitalGainAccount, gain)
        and portion_attributable_to_deposits_without_tax_benefit(w, benefit)
        and highest_rate(p, y, rate)
        and withdrawal_tax_rate_for_gain_account_portion(w, grate);
    then nonqualified_withdrawal_tax_increase(w, round((amt - gain - benefit) * rate + gain * grate, 2, "HALF_UP"));
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "an amount equal to such portion shall be treated as allowed as a deduction under section 172 for the taxable year in which such withdrawal occurs")
rule S7518TaxBenefitRule strict {
    for w: FundWithdrawal;
    for benefit: Money;
    when nonqualified_withdrawal(w)
        and portion_attributable_to_deposits_without_tax_benefit(w, benefit);
    then withdrawal_portion_treated_as_nol_deduction(w, benefit);
}

// --- (h) reorganizations and partnership continuation ---------------------------------

relation joint_regulations_treat_transfer_as_not_withdrawal(w: FundWithdrawal) kind empirical {
    label en unofficial "under joint regulations, a transfer of the fund in a section 381 transaction, or a continuation of a partnership, is treated as if it did not constitute a nonqualified withdrawal";
}
relation section_381_transfer_or_partnership_continuation(w: FundWithdrawal) kind empirical {
    label en unofficial "the transfer is a transfer of the fund from one person to another in a transaction to which section 381 applies, or a continuation of a partnership";
}
@source(IRC_S7518_H, relation = formalizes, coverage = exact, quote = "a transfer of a fund from one person to another person in a transaction to which section 381 applies may be treated as if such transaction did not constitute a nonqualified withdrawal")
rule S7518TransferReliefPower strict {
    for w: FundWithdrawal;
    when joint_regulations_treat_transfer_as_not_withdrawal(w);
    then power S7518TreatTransferAsNotWithdrawal {
        holder Secretary;
        over w;
        exercise joint_regulations_treat_transfer_as_not_withdrawal(w);
        valid_when section_381_transfer_or_partnership_continuation(w);
        effect create(transfer_treated_as_not_nonqualified_withdrawal(w));
    };
}
@source(IRC_S7518_H, relation = formalizes, coverage = exact, quote = "a similar rule shall be applied in the case of a continuation of a partnership")
rule S7518TransferReliefTwin strict {
    for w: FundWithdrawal;
    when joint_regulations_treat_transfer_as_not_withdrawal(w)
        and section_381_transfer_or_partnership_continuation(w);
    then transfer_relief_applies(w);
}

// (g)(5)(D) excess balance
external judgment relation balance_exceeds_appropriate_program_amount(f: CapitalConstructionFund) {
    authority Secretary;
    label en unofficial "the Secretary determines that the balance in the fund exceeds the amount appropriate to meet the vessel construction program objectives of the person who established the fund (§7518(g)(5)(D))";
}
relation program_objectives_developed_within_3_years(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the person develops appropriate program objectives within 3 years to dissipate the excess";
}
relation secretary_treats_excess_balance_as_nonqualified(f: CapitalConstructionFund) kind empirical {
    label en unofficial "the Secretary treats the excess balance as a nonqualified withdrawal under (g)(5)(A)";
}
relation s7518g5d_conditions_met(f: CapitalConstructionFund) kind derived {
    label en unofficial "the Secretary determined that the balance is excessive and no appropriate program objectives were developed within 3 years";
}
pub relation excess_balance_treated_as_nonqualified(f: CapitalConstructionFund) kind institutional {
    label en unofficial "the excess balance is treated as a nonqualified withdrawal (§7518(g)(5)(D))";
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "unless such person develops appropriate program objectives within 3 years to dissipate such excess")
rule S7518G5DConditions strict {
    for f: CapitalConstructionFund;
    when balance_exceeds_appropriate_program_amount(f)
        and not_known(program_objectives_developed_within_3_years(f));
    then s7518g5d_conditions_met(f);
}
@source(IRC_S7518_G, relation = formalizes, coverage = exact, quote = "the amount of such excess shall be treated as a nonqualified withdrawal under subparagraph (A) unless such person develops appropriate program objectives within 3 years to dissipate such excess")
rule S7518G5DPower strict {
    for f: CapitalConstructionFund;
    when secretary_treats_excess_balance_as_nonqualified(f);
    then power S7518TreatExcessBalanceAsNonqualified {
        holder Secretary;
        over f;
        exercise secretary_treats_excess_balance_as_nonqualified(f);
        valid_when s7518g5d_conditions_met(f);
        effect create(excess_balance_treated_as_nonqualified(f));
    };
}
