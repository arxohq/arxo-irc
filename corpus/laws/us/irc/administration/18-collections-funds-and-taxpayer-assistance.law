// 26 U.S.C. §§7808 (depositaries), 7809 (deposit of collections), 7810
// (revolving fund for redemption of real property), 7811 (Taxpayer Assistance
// Orders), 7812 (critical pay authority for information technology positions).
// STAGE 3. (§7807, the interim provisions on enactment of the Code, is
// classified NON_NORMATIVE in the coverage file.)
//
// JUDGMENT CALLS
//  - §7809(a) "paid daily": read as paid into the Treasury not later than the
//    calendar day after receipt (achievement goal over [receipt, receipt + 1
//    calendar_day], IRC_CALENDAR_STEP policy in the scenarios). The text names
//    no banking-day rule (TECH-GAPS G3001 is the same calendar issue).
//  - §7811 significant hardship: the National Taxpayer Advocate's
//    determination is an external judgment; the four enumerated hardships of
//    (a)(2) "shall include" are executable facts that establish it.
//  - §7811(b): a Taxpayer Assistance Order creates a duty of the Secretary
//    with a window ending at the case-supplied "specified time period".
//  - §7812: the Title 5 substitutions are an EXTERNAL_DEPENDENCY; the window
//    "ending on September 30, 2025" is executable.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    Congress,
    IRC_S7808,
    IRC_S7809_A,
    IRC_S7809_B,
    IRC_S7809_C,
    IRC_S7809_D,
    IRC_S7810_A,
    IRC_S7810_B,
    IRC_S7810_C,
    IRC_S7811_A,
    IRC_S7811_B,
    IRC_S7811_C,
    IRC_S7811_D,
    IRC_S7811_E,
    IRC_S7811_F,
    IRC_S7811_G,
    IRC_S7812,
    Organ,
    Person,
    Secretary,
};

// --- §7808: depositaries ----------------------------------------------------------------------

entity Depositary {
    label en unofficial "a depositary designated for the deposit and safe-keeping of money collected under the internal revenue laws";
}
relation secretary_designates_depositary(d: Depositary, state: Person) kind empirical {
    label en unofficial "the Secretary designates the depositary in the State";
}
pub relation depositary_designated(d: Depositary) kind institutional {
    label en unofficial "the depositary is validly designated under §7808";
}
@source(IRC_S7808, relation = formalizes, coverage = exact, quote = "The Secretary is authorized to designate one or more depositaries in each State for the deposit and safe-keeping of the money collected by virtue of the internal revenue laws")
rule S7808DesignationPower strict {
    for d: Depositary;
    for state: Person;
    when secretary_designates_depositary(d, state);
    then power S7808DesignateDepositary {
        holder Secretary;
        over d;
        exercise secretary_designates_depositary(d, state);
        valid_when secretary_designates_depositary(d, state);
        effect create(depositary_designated(d));
    };
}
relation officer_of_depositary_receipt_given_for_deposit(d: Depositary) kind empirical {
    label en unofficial "the proper officer of the depositary gives a receipt to the Treasury officer or employee for the money deposited";
}
pub relation depositary_receipt_is_sufficient_voucher(d: Depositary) kind institutional {
    label en unofficial "the depositary officer's receipt is a sufficient voucher for the Treasury officer or employee in the settlement of his accounts";
}
@source(IRC_S7808, relation = formalizes, coverage = exact, quote = "the receipt of the proper officer of such depositary to the proper officer or employee of the Treasury Department for the money deposited by him shall be a sufficient voucher for such Treasury officer or employee in the settlement of his accounts")
rule S7808ReceiptIsVoucher strict {
    for d: Depositary;
    when depositary_designated(d)
        and officer_of_depositary_receipt_given_for_deposit(d);
    then depositary_receipt_is_sufficient_voucher(d);
}

// --- §7809: deposit of collections ---------------------------------------------------------------

entity CollectionReceipt {
    label en unofficial "taxes and revenues received, and collections of whatever nature received or collected by authority of any internal revenue law";
}
relation receipt_received_on(r: CollectionReceipt, officer: Person, d: Date) kind empirical {
    label en unofficial "the officer or employee receives or collects the amount on this date";
}
relation receipt_governed_by_specific_provision(r: CollectionReceipt) kind empirical {
    label en unofficial "the receipt is governed by subsection (b) or (c) or by section 6306, 7651, 7652, 7654 or 7810 instead of the general daily deposit rule";
}
relation receipt_paid_into_treasury_without_deduction(r: CollectionReceipt) kind empirical {
    label en unofficial "the gross amount is paid into the Treasury under the Secretary's instructions as internal revenue collections, without abatement or deduction for salary, compensation, fees, costs, charges, expenses or claims";
}
relation certificate_of_payment_transmitted(r: CollectionReceipt) kind empirical {
    label en unofficial "a certificate of the payment, naming the depositor and the account, signed by the Treasurer, a designated depositary or a deposit bank officer, is transmitted to the Secretary";
}
@source(IRC_S7809_A, relation = formalizes, coverage = exact, quote = "shall be paid daily into the Treasury of the United States under instructions of the Secretary as internal revenue collections, by the officer or employee receiving or collecting the same, without any abatement or deduction")
rule S7809DailyDepositDuty defeasible {
    for r: CollectionReceipt;
    for officer: Person;
    for d: Date;
    when receipt_received_on(r, officer, d);
    then duty S7809PayIntoTreasuryDaily {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition receipt_paid_into_treasury_without_deduction(r);
            window [d, add_calendar_period(d, 1 calendar_day)];
        }
    };
    unless receipt_governed_by_specific_provision(r) and receipt_received_on(r, officer, d);
}
@source(IRC_S7809_A, relation = formalizes, coverage = exact, quote = "A certificate of such payment, stating the name of the depositor and the specific account on which the deposit was made")
rule S7809CertificateDuty defeasible {
    for r: CollectionReceipt;
    for officer: Person;
    for d: Date;
    when receipt_received_on(r, officer, d);
    then duty S7809TransmitCertificateOfPayment {
        bearer officer;
        beneficiary Secretary;
        goal achievement {
            condition certificate_of_payment_transmitted(r);
            window [d, infinity];
        }
    };
    unless receipt_governed_by_specific_provision(r) and receipt_received_on(r, officer, d);
}
enum DepositFundItem {
    SumOfferedInCompromise;
    SumOfferedForPurchaseOfRealEstate;
    SurplusProceedsOfSaleUnderLevy;
    SurplusProceedsOfSaleOfRedeemedRealProperty;
}
entity DepositFundOffer {
    label en unofficial "a sum deposited in a deposit fund account with the Treasurer of the United States";
}
relation deposit_fund_item(o: DepositFundOffer, k: DepositFundItem) kind empirical {
    label en unofficial "the deposit is of the named kind (an offer in compromise under section 7122, an offer to purchase real estate under section 7506, or surplus proceeds after tax, interest, penalties, additions, costs and charges)";
}
relation deposited_in_deposit_fund_account(o: DepositFundOffer) kind empirical {
    label en unofficial "the sum is deposited with the Treasurer of the United States in a deposit fund account";
}
relation offer_accepted(o: DepositFundOffer) kind empirical {
    label en unofficial "the offer in compromise or offer for the purchase of real estate is accepted";
}
relation offer_rejected(o: DepositFundOffer) kind empirical {
    label en unofficial "the offer is rejected";
}
relation accepted_amount_withdrawn_and_deposited_as_collections(o: DepositFundOffer) kind empirical {
    label en unofficial "the accepted amount is withdrawn from the deposit fund account and deposited in the Treasury as internal revenue collections";
}
relation rejected_offer_refunded_to_maker(o: DepositFundOffer) kind empirical {
    label en unofficial "the Secretary refunds the amount of the rejected offer to its maker";
}
relation offer_is_compromise_or_real_estate_purchase(o: DepositFundOffer) kind derived {
    label en unofficial "the deposit is a sum offered in compromise or offered for purchase of real estate (the kinds with acceptance and rejection consequences)";
}
@source(IRC_S7809_B, relation = formalizes, coverage = exact, quote = "there shall be deposited with the Treasurer of the United States in a deposit fund account—")
rule S7809DepositFundDuty defeasible {
    for o: DepositFundOffer;
    for k: DepositFundItem;
    when deposit_fund_item(o, k);
    then duty S7809DepositInDepositFund {
        bearer Secretary;
        goal achievement {
            condition deposited_in_deposit_fund_account(o);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7809_B, relation = formalizes, coverage = exact, quote = "Sums offered in compromise under the provisions of section 7122;")
rule S7809KindCompromise strict {
    for o: DepositFundOffer;
    when deposit_fund_item(o, SumOfferedInCompromise);
    then offer_is_compromise_or_real_estate_purchase(o);
}
@source(IRC_S7809_B, relation = formalizes, coverage = exact, quote = "Sums offered for the purchase of real estate under the provisions of section 7506;")
rule S7809KindRealEstate strict {
    for o: DepositFundOffer;
    when deposit_fund_item(o, SumOfferedForPurchaseOfRealEstate);
    then offer_is_compromise_or_real_estate_purchase(o);
}
@source(IRC_S7809_B, relation = formalizes, coverage = exact, quote = "Upon the acceptance of such offer in compromise or offer for the purchase of such real estate, the amount so accepted shall be withdrawn from such deposit fund account and deposited in the Treasury of the United States as internal revenue collections.")
rule S7809AcceptedDuty defeasible {
    for o: DepositFundOffer;
    when offer_is_compromise_or_real_estate_purchase(o)
        and offer_accepted(o);
    then duty S7809DepositAcceptedAmountAsCollections {
        bearer Secretary;
        goal achievement {
            condition accepted_amount_withdrawn_and_deposited_as_collections(o);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7809_B, relation = formalizes, coverage = exact, quote = "Upon the rejection of any such offer, the Secretary shall refund to the maker of such offer the amount thereof.")
rule S7809RejectedDuty defeasible {
    for o: DepositFundOffer;
    when offer_is_compromise_or_real_estate_purchase(o)
        and offer_rejected(o);
    then duty S7809RefundRejectedOffer {
        bearer Secretary;
        goal achievement {
            condition rejected_offer_refunded_to_maker(o);
            window [-infinity, infinity];
        }
    };
}
enum ServiceReceiptKind {
    ReturnCopiesOrStatisticalStudies;
    TrainingAndTrainingAids;
    DataOrCopiesForStateOrFederalAgency;
    PublicInspectionOfWrittenDeterminations;
}
relation receipt_for_services(r: CollectionReceipt, k: ServiceReceiptKind) kind empirical {
    label en unofficial "moneys received in payment for work or services of the named kind (sections 6103(p) and 6108(b); section 7516; work for a State or Federal agency; section 6110)";
}
relation service_receipt_deposited_in_separate_account(r: CollectionReceipt) kind empirical {
    label en unofficial "the moneys are deposited in a separate account usable to reimburse appropriations which bore the costs or to refund excess sums";
}
@source(IRC_S7809_C, relation = formalizes, coverage = exact, quote = "shall be deposited in a separate account which may be used to reimburse appropriations which bore all or part of the costs of such work or services, or to refund excess sums when necessary")
rule S7809ServiceReceiptDuty defeasible {
    for r: CollectionReceipt;
    for k: ServiceReceiptKind;
    when receipt_for_services(r, k);
    then duty S7809DepositServiceReceiptsInSeparateAccount {
        bearer Secretary;
        goal achievement {
            condition service_receipt_deposited_in_separate_account(r);
            window [-infinity, infinity];
        }
    };
}
relation amounts_recovered_from_agency_information(x: Person, amt: Money) kind empirical {
    label en unofficial "amounts were recovered as the result of information provided to the IRS by State and local law enforcement agencies which substantially contributed to the recovery";
}
relation ten_percent_deposited_in_law_enforcement_account(x: Person) kind empirical {
    label en unofficial "an amount equal to 10 percent of the amounts recovered is deposited in a separate account used to make the reimbursements required under section 7624";
}
relation law_enforcement_account_balance_remaining(x: Person, amt: Money) kind empirical {
    label en unofficial "amounts remain in the account after payment of qualified costs under section 7624";
}
relation remaining_account_amounts_deposited_as_collections(x: Person) kind empirical {
    label en unofficial "the remaining amounts are withdrawn and deposited in the Treasury as internal revenue collections";
}
pub relation law_enforcement_account_deposit_due(x: Person, amt: Money) kind institutional {
    label en unofficial "the amount to deposit in the separate account: 10 percent of the amounts recovered";
}
@source(IRC_S7809_D, relation = formalizes, coverage = exact, quote = "an amount equal to 10 percent of such amounts shall be deposited in a separate account which shall be used to make the reimbursements required under section 7624")
rule S7809LawEnforcementDepositAmount strict {
    for x: Person;
    for amt: Money;
    when amounts_recovered_from_agency_information(x, amt);
    then law_enforcement_account_deposit_due(x, round(amt * 0.10, 2, "HALF_UP"));
}
@source(IRC_S7809_D, relation = formalizes, coverage = exact, quote = "an amount equal to 10 percent of such amounts shall be deposited in a separate account")
rule S7809LawEnforcementDepositDuty defeasible {
    for x: Person;
    for amt: Money;
    when law_enforcement_account_deposit_due(x, amt);
    then duty S7809DepositLawEnforcementShare {
        bearer Secretary;
        goal achievement {
            condition ten_percent_deposited_in_law_enforcement_account(x);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7809_D, relation = formalizes, coverage = exact, quote = "If any amounts remain in such account after payment of any qualified costs incurred under section 7624, such amounts shall be withdrawn from such account and deposited in the Treasury of the United States as internal revenue collections.")
rule S7809RemainingAccountDuty defeasible {
    for x: Person;
    for amt: Money;
    when law_enforcement_account_balance_remaining(x, amt)
        and amt > 0.00 USD;
    then duty S7809DepositRemainingAccountAmounts {
        bearer Secretary;
        goal achievement {
            condition remaining_account_amounts_deposited_as_collections(x);
            window [-infinity, infinity];
        }
    };
}

// --- §7810: revolving fund for redemption of real property ----------------------------------------------

relation redemption_fund_appropriations_authorized_total(amt: Money) kind empirical {
    label en unofficial "the aggregate sums authorized to be appropriated to the redemption revolving fund";
}
relation redemption_fund_authorization_exceeds_cap(amt: Money) kind derived {
    label en unofficial "the aggregate authorization exceeds $10,000,000";
}
@source(IRC_S7810_A, relation = formalizes, coverage = exact, quote = "such sums (not to exceed $10,000,000 in the aggregate) as may be necessary to carry out the purposes of this section")
rule S7810AuthorizationExceedsCap strict {
    for amt: Money;
    when redemption_fund_appropriations_authorized_total(amt)
        and amt > 10000000.00 USD;
    then redemption_fund_authorization_exceeds_cap(amt);
}
@source(IRC_S7810_A, relation = formalizes, coverage = exact, quote = "There are authorized to be appropriated from time to time such sums (not to exceed $10,000,000 in the aggregate) as may be necessary to carry out the purposes of this section.")
rule S7810CapProhibition strict {
    for amt: Money;
    when redemption_fund_authorization_exceeds_cap(amt);
    then prohibition S7810NoAuthorizationOverTenMillion {
        bearer Congress;
        action redemption_fund_authorization_exceeds_cap(amt);
        window [-infinity, infinity];
    };
}
entity RedeemedProperty {
    label en unofficial "real property redeemed by the Secretary under section 7425(d) or section 2410 of title 28";
}
relation amount_expended_from_fund_for_redemption(p: RedeemedProperty, amt: Money) kind empirical {
    label en unofficial "the amount expended from the revolving fund for the redemption";
}
relation redeemed_property_sold_for_proceeds(p: RedeemedProperty, proceeds: Money) kind empirical {
    label en unofficial "the redeemed property is subsequently sold and the proceeds received";
}
relation fund_reimbursed_amount(p: RedeemedProperty, amt: Money) kind empirical {
    label en unofficial "the fund is reimbursed this amount from the proceeds of the sale";
}
pub relation fund_reimbursement_due(p: RedeemedProperty, amt: Money) kind institutional {
    label en unofficial "the fund is reimbursed from the proceeds of a subsequent sale in an amount equal to the amount expended for the redemption (limited to the proceeds available)";
}
@source(IRC_S7810_B, relation = formalizes, coverage = exact, quote = "The fund shall be reimbursed from the proceeds of a subsequent sale of real property redeemed by the United States in an amount equal to the amount expended out of such fund for such redemption.")
rule S7810ReimbursementDue strict {
    for p: RedeemedProperty;
    for spent: Money;
    for proceeds: Money;
    when amount_expended_from_fund_for_redemption(p, spent)
        and redeemed_property_sold_for_proceeds(p, proceeds);
    then fund_reimbursement_due(p, min(spent, proceeds));
}
@source(IRC_S7810_B, relation = formalizes, coverage = exact, quote = "The fund shall be reimbursed from the proceeds of a subsequent sale of real property redeemed by the United States")
rule S7810ReimbursementDuty defeasible {
    for p: RedeemedProperty;
    for amt: Money;
    when fund_reimbursement_due(p, amt);
    then duty S7810ReimburseRedemptionFund {
        bearer Secretary;
        goal achievement {
            condition fund_reimbursed_amount(p, amt);
            window [-infinity, infinity];
        }
    };
}
relation secretary_maintains_fund_accounts_and_annual_reports(o: Organ) kind empirical {
    label en unofficial "the Secretary maintains an adequate system of accounts for the fund and prepares annual reports on the basis of the accounts";
}
@source(IRC_S7810_C, relation = formalizes, coverage = exact, quote = "The Secretary shall maintain an adequate system of accounts for such fund and prepare annual reports on the basis of such accounts.")
rule S7810AccountsDuty strict {
    when true;
    then duty S7810MaintainFundAccountsAndReports {
        bearer Secretary;
        goal maintenance {
            condition secretary_maintains_fund_accounts_and_annual_reports(Secretary);
            window [-infinity, infinity];
        }
    };
}

// --- §7811: Taxpayer Assistance Orders ---------------------------------------------------------------------

const NationalTaxpayerAdvocate: Organ = entity_ref("urn:us:irc:administration:clir#NationalTaxpayerAdvocate") {
    label en official "the National Taxpayer Advocate";
}
entity TaxpayerAssistanceOrder {
    label en unofficial "a Taxpayer Assistance Order issued by the National Taxpayer Advocate";
}
relation tao_application(a: TaxpayerAssistanceOrder, t: Person, filed: Date) kind empirical {
    label en unofficial "the taxpayer applies to the Office of the Taxpayer Advocate, in the form, manner and time the Secretary prescribes, on this date";
}
relation immediate_threat_of_adverse_action(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "there is an immediate threat of adverse action (§7811(a)(2)(A))";
}
relation delay_over_30_days_resolving_account_problems(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "there is a delay of more than 30 days in resolving taxpayer account problems (§7811(a)(2)(B))";
}
relation significant_costs_if_relief_not_granted(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "the taxpayer incurs significant costs (including fees for professional representation) if relief is not granted (§7811(a)(2)(C))";
}
relation irreparable_injury_or_long_term_adverse_impact(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "there is irreparable injury to, or a long-term adverse impact on, the taxpayer if relief is not granted (§7811(a)(2)(D))";
}
relation hardship_factor_present(a: TaxpayerAssistanceOrder) kind derived {
    label en unofficial "one of the (a)(2) factors of significant hardship is present";
}
external judgment relation advocate_determines_significant_hardship(a: TaxpayerAssistanceOrder) {
    authority NationalTaxpayerAdvocate;
    label en unofficial "the National Taxpayer Advocate determines the taxpayer is suffering or about to suffer a significant hardship as a result of the manner in which the internal revenue laws are being administered (§7811(a)(1)(A))";
}
relation taxpayer_meets_regulation_requirements(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "the taxpayer meets other requirements set forth in regulations prescribed by the Secretary (§7811(a)(1)(B))";
}
relation tao_grounds_present(a: TaxpayerAssistanceOrder) kind derived {
    label en unofficial "the advocate has determined significant hardship, or the taxpayer meets the regulation requirements";
}
relation advocate_issues_tao(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "the National Taxpayer Advocate issues the Taxpayer Assistance Order";
}
pub relation taxpayer_assistance_order_in_force(a: TaxpayerAssistanceOrder) kind institutional {
    label en unofficial "the Taxpayer Assistance Order is validly issued under §7811(a)";
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "(2) Determination of hardship")
rule S7811HardshipFactorImmediateThreat strict {
    for a: TaxpayerAssistanceOrder;
    when immediate_threat_of_adverse_action(a);
    then hardship_factor_present(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "a delay of more than 30 days in resolving taxpayer account problems")
rule S7811HardshipFactorDelay strict {
    for a: TaxpayerAssistanceOrder;
    when delay_over_30_days_resolving_account_problems(a);
    then hardship_factor_present(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "the incurring by the taxpayer of significant costs (including fees for professional representation) if relief is not granted")
rule S7811HardshipFactorCosts strict {
    for a: TaxpayerAssistanceOrder;
    when significant_costs_if_relief_not_granted(a);
    then hardship_factor_present(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "irreparable injury to, or a long-term adverse impact on, the taxpayer if relief is not granted")
rule S7811HardshipFactorInjury strict {
    for a: TaxpayerAssistanceOrder;
    when irreparable_injury_or_long_term_adverse_impact(a);
    then hardship_factor_present(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "the National Taxpayer Advocate determines the taxpayer is suffering or about to suffer a significant hardship as a result of the manner in which the internal revenue laws are being administered by the Secretary")
rule S7811GroundsHardship strict {
    for a: TaxpayerAssistanceOrder;
    when advocate_determines_significant_hardship(a);
    then tao_grounds_present(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "the taxpayer meets such other requirements as are set forth in regulations prescribed by the Secretary")
rule S7811GroundsRegulations strict {
    for a: TaxpayerAssistanceOrder;
    when taxpayer_meets_regulation_requirements(a);
    then tao_grounds_present(a);
}
relation tao_conditions_met(a: TaxpayerAssistanceOrder) kind derived {
    label en unofficial "an application is filed and the grounds of §7811(a)(1)(A) or (B) are present";
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "Upon application filed by a taxpayer with the Office of the Taxpayer Advocate")
rule S7811ConditionsMet strict {
    for a: TaxpayerAssistanceOrder;
    for t: Person;
    for filed: Date;
    when tao_application(a, t, filed)
        and tao_grounds_present(a);
    then tao_conditions_met(a);
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "the National Taxpayer Advocate may issue a Taxpayer Assistance Order if—")
rule S7811IssuePower strict {
    for a: TaxpayerAssistanceOrder;
    for t: Person;
    for filed: Date;
    when advocate_issues_tao(a)
        and tao_application(a, t, filed);
    then power S7811IssueTaxpayerAssistanceOrder {
        holder NationalTaxpayerAdvocate;
        over Secretary;
        exercise advocate_issues_tao(a);
        valid_when tao_conditions_met(a);
        effect create(taxpayer_assistance_order_in_force(a));
    };
}
relation irs_employee_not_following_published_guidance(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "an IRS employee is not following applicable published administrative guidance (including the Internal Revenue Manual)";
}
relation advocate_construes_factors_most_favorably_to_taxpayer(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "the National Taxpayer Advocate construes the factors in determining whether to issue an order in the manner most favorable to the taxpayer";
}
@source(IRC_S7811_A, relation = formalizes, coverage = exact, quote = "the National Taxpayer Advocate shall construe the factors taken into account in determining whether to issue a Taxpayer Assistance Order in the manner most favorable to the taxpayer")
rule S7811FavorableConstructionDuty defeasible {
    for a: TaxpayerAssistanceOrder;
    when irs_employee_not_following_published_guidance(a);
    then duty S7811ConstrueFactorsFavorablyToTaxpayer {
        bearer NationalTaxpayerAdvocate;
        goal maintenance {
            condition advocate_construes_factors_most_favorably_to_taxpayer(a);
            window [-infinity, infinity];
        }
    };
}
relation tao_taxpayer(a: TaxpayerAssistanceOrder, t: Person) kind empirical {
    label en unofficial "the taxpayer who is the subject of the order";
}
relation tao_issued_on(a: TaxpayerAssistanceOrder, d: Date) kind empirical {
    label en unofficial "the date the order is issued";
}
relation tao_deadline(a: TaxpayerAssistanceOrder, d: Date) kind empirical {
    label en unofficial "the end of the time period specified in the order within which the Secretary must act";
}
enum TaoTerm {
    ReleaseLeviedProperty;
    CeaseOrTakeOrRefrainUnderCollectionChapter64;
    CeaseOrTakeOrRefrainUnderBankruptcySubchapterB70;
    CeaseOrTakeOrRefrainUnderChapter78;
    CeaseOrTakeOrRefrainUnderProvisionDescribedByAdvocate;
}
relation tao_requires(a: TaxpayerAssistanceOrder, k: TaoTerm) kind empirical {
    label en unofficial "the order requires the Secretary, within the specified time period, to release levied property or to cease, take, or refrain from action under the named provisions";
}
relation secretary_complied_with_tao_term(a: TaxpayerAssistanceOrder, k: TaoTerm) kind empirical {
    label en unofficial "the Secretary complies with the named term of the order";
}
@source(IRC_S7811_B, relation = formalizes, coverage = exact, quote = "The terms of a Taxpayer Assistance Order may require the Secretary within a specified time period—")
rule S7811ComplianceDuty defeasible {
    for a: TaxpayerAssistanceOrder;
    for k: TaoTerm;
    for t: Person;
    for issued: Date;
    for deadline: Date;
    when taxpayer_assistance_order_in_force(a)
        and tao_requires(a, k)
        and tao_taxpayer(a, t)
        and tao_issued_on(a, issued)
        and tao_deadline(a, deadline);
    then duty S7811ComplyWithTaxpayerAssistanceOrder {
        bearer Secretary;
        beneficiary t;
        goal achievement {
            condition secretary_complied_with_tao_term(a, k);
            window [issued, deadline];
        }
    };
}
relation modifier_of_tao(a: TaxpayerAssistanceOrder, m: Person) kind empirical {
    label en unofficial "the person modifies or rescinds the order";
}
relation modifier_is_ntaco(m: Person) kind empirical {
    label en unofficial "the person is the National Taxpayer Advocate, the Commissioner of Internal Revenue, or the Deputy Commissioner of Internal Revenue";
}
relation written_explanation_provided_to_advocate(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "a written explanation of the reasons for the modification or rescission is provided to the National Taxpayer Advocate";
}
relation tao_modification_conditions_met(a: TaxpayerAssistanceOrder, m: Person) kind derived {
    label en unofficial "the modifier is an authorized official and a written explanation was provided to the Advocate";
}
pub relation tao_modified_or_rescinded(a: TaxpayerAssistanceOrder) kind institutional {
    label en unofficial "the Taxpayer Assistance Order is validly modified or rescinded under §7811(c)";
}
@source(IRC_S7811_C, relation = formalizes, coverage = exact, quote = "only by the National Taxpayer Advocate, the Commissioner of Internal Revenue, or the Deputy Commissioner of Internal Revenue, and")
rule S7811ModificationConditions strict {
    for a: TaxpayerAssistanceOrder;
    for m: Person;
    when modifier_of_tao(a, m)
        and modifier_is_ntaco(m)
        and written_explanation_provided_to_advocate(a);
    then tao_modification_conditions_met(a, m);
}
@source(IRC_S7811_C, relation = formalizes, coverage = exact, quote = "Any Taxpayer Assistance Order issued by the National Taxpayer Advocate under this section may be modified or rescinded—")
rule S7811ModificationPower strict {
    for a: TaxpayerAssistanceOrder;
    for m: Person;
    when modifier_of_tao(a, m)
        and taxpayer_assistance_order_in_force(a);
    then power S7811ModifyOrRescindOrder {
        holder m;
        over a;
        exercise modifier_of_tao(a, m);
        valid_when tao_modification_conditions_met(a, m);
        effect create(tao_modified_or_rescinded(a));
    };
}
relation tao_decision_date(a: TaxpayerAssistanceOrder, d: Date) kind empirical {
    label en unofficial "the date of the National Taxpayer Advocate's decision on the application";
}
relation tao_specified_suspension_period_end(a: TaxpayerAssistanceOrder, d: Date) kind empirical {
    label en unofficial "the end of any period specified by the Advocate in the order during which limitation periods are suspended";
}
pub relation limitation_suspended_pending_application(a: TaxpayerAssistanceOrder, from: Date, until: Date) kind institutional {
    label en unofficial "the running of any period of limitation with respect to an action described in subsection (b) is suspended from the application date to the decision date";
}
pub relation limitation_suspended_for_period_in_order(a: TaxpayerAssistanceOrder, from: Date, until: Date) kind institutional {
    label en unofficial "the running of any period of limitation is suspended for the period specified in the order (from its issue date)";
}
@source(IRC_S7811_D, relation = formalizes, coverage = exact, quote = "the period beginning on the date of the taxpayer's application under subsection (a) and ending on the date of the National Taxpayer Advocate's decision with respect to such application")
rule S7811SuspensionDuringApplication strict {
    for a: TaxpayerAssistanceOrder;
    for t: Person;
    for filed: Date;
    for decided: Date;
    when tao_application(a, t, filed)
        and tao_decision_date(a, decided);
    then limitation_suspended_pending_application(a, filed, decided);
}
@source(IRC_S7811_D, relation = formalizes, coverage = exact, quote = "any period specified by the National Taxpayer Advocate in a Taxpayer Assistance Order issued pursuant to such application")
rule S7811SuspensionForPeriodInOrder strict {
    for a: TaxpayerAssistanceOrder;
    for issued: Date;
    for until: Date;
    when tao_issued_on(a, issued)
        and tao_specified_suspension_period_end(a, until);
    then limitation_suspended_for_period_in_order(a, issued, until);
}
relation advocate_acts_without_application(a: TaxpayerAssistanceOrder) kind empirical {
    label en unofficial "the National Taxpayer Advocate takes an action in the absence of an application under subsection (a)";
}
@source(IRC_S7811_E, relation = formalizes, coverage = exact, quote = "Nothing in this section shall prevent the National Taxpayer Advocate from taking any action in the absence of an application under subsection (a).")
rule S7811IndependentActionLiberty defeasible {
    for a: TaxpayerAssistanceOrder;
    when advocate_acts_without_application(a);
    then liberty S7811ActWithoutApplication {
        holder NationalTaxpayerAdvocate;
        against Secretary;
        action advocate_acts_without_application(a);
        window [-infinity, infinity];
    };
}
relation designee_of_national_taxpayer_advocate(p: Person) kind empirical {
    label en unofficial "the person is a designee of the National Taxpayer Advocate";
}
pub relation treated_as_national_taxpayer_advocate(p: Person) kind institutional {
    label en unofficial "for purposes of §7811 the term \"National Taxpayer Advocate\" includes the designee";
}
@source(IRC_S7811_F, relation = formalizes, coverage = exact, quote = "the term \"National Taxpayer Advocate\" includes any designee of the National Taxpayer Advocate")
rule S7811DesigneeIncluded strict {
    for p: Person;
    when designee_of_national_taxpayer_advocate(p);
    then treated_as_national_taxpayer_advocate(p);
}
relation qualified_tax_collection_contractor(c: Person) kind empirical {
    label en unofficial "the person performs services under a qualified tax collection contract (section 6306(b))";
}
relation contractor_complied_with_tao_term(c: Person, a: TaxpayerAssistanceOrder, k: TaoTerm) kind empirical {
    label en unofficial "the contractor complies with the named term of the order";
}
@source(IRC_S7811_G, relation = formalizes, coverage = exact, quote = "shall apply to persons performing services under a qualified tax collection contract (as defined in section 6306(b)) to the same extent and in the same manner as such order or action applies to the Secretary")
rule S7811ContractorComplianceDuty defeasible {
    for c: Person;
    for a: TaxpayerAssistanceOrder;
    for k: TaoTerm;
    for t: Person;
    for issued: Date;
    for deadline: Date;
    when qualified_tax_collection_contractor(c)
        and taxpayer_assistance_order_in_force(a)
        and tao_requires(a, k)
        and tao_taxpayer(a, t)
        and tao_issued_on(a, issued)
        and tao_deadline(a, deadline);
    then duty S7811ContractorComplyWithOrder {
        bearer c;
        beneficiary t;
        goal achievement {
            condition contractor_complied_with_tao_term(c, a, k);
            window [issued, deadline];
        }
    };
}

// --- §7812: critical pay authority for information technology positions -------------------------------------------

relation it_position_critical_to_irs_operations(pos: Person) kind empirical {
    label en unofficial "the position is critical to the functionality of the information technology operations of the IRS";
}
relation critical_pay_appointment_made_on(pos: Person, d: Date) kind empirical {
    label en unofficial "an appointment is made under the streamlined critical pay authority on this date";
}
relation s7812_enactment_date(d: Date) kind empirical {
    label en unofficial "the date of the enactment of section 7812 (the text names the event, not the date; case-supplied)";
}
pub relation critical_pay_authority_available(pos: Person, d: Date) kind institutional {
    label en unofficial "the streamlined critical pay authority is available for the position on the date: from the enactment of section 7812 through September 30, 2025";
}
@source(IRC_S7812, relation = formalizes, coverage = partial, quote = "during the period beginning on the date of the enactment of section 7812 of the Internal Revenue Code of 1986, and ending on September 30, 2025")
rule S7812AuthorityWindow strict {
    for pos: Person;
    for d: Date;
    for enacted: Date;
    when it_position_critical_to_irs_operations(pos)
        and critical_pay_appointment_made_on(pos, d)
        and s7812_enactment_date(enacted)
        and d >= enacted
        and d <= @2025-09-30;
    then critical_pay_authority_available(pos, d);
}
