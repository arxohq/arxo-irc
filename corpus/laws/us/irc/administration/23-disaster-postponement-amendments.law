// 26 U.S.C. §7508A as amended by Pub. L. 119-29 (Filing Relief for Natural
// Disasters Act) and Pub. L. 119-64 (Disaster Related Extension of Deadlines
// Act). STAGE 3. Text: `us.irc.temporal` fragments PL119_29_S2 and
// PL119_64_S2 (NOT imported here: the package keeps no dependency on
// `us.irc.temporal`, which would force every importer's world to carry it;
// TECH-GAPS G3014). The 2024 edition pinned in this package predates both
// amendments, so the rules below are additive and dated by case-supplied
// enactment dates.
//
// JUDGMENT CALLS
//  - The enactment dates of both Acts are case facts (`pl_119_29_enactment_date`,
//    `pl_119_64_enactment_date`): the corpus does not pin an enactment date.
//  - PL 119-29 §2(a): a "qualified State declared disaster" is a State (or
//    District of Columbia Mayor) determination; the Governor's determination
//    that the damage warrants application, the written request, the declaration
//    date, and the consultation with the FEMA Administrator are case facts.
//    The Secretary's power is published as an institutional fact
//    (`state_declared_disaster_treated_as_disaster`); the consequent (a)/(b)
//    relief still runs through the Secretary's taxpayer determination of §7508A(a).
//  - PL 119-29 §2(b): "60 days" becomes "120 days" in the mandatory extension
//    for declarations made after enactment: the 60-day rules of module 03 are
//    switched off for such declarations and the 120-day rules take over.
//  - PL 119-64 §2(a): new subsection (f): a period disregarded for the time to
//    file a return is treated as an extension of time to file for
//    §6511(b)(2)(A), for claims filed after enactment. The section 6511 owner
//    reads `return_extension_for_6511`.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    CombatZoneActKind,
    CoveredEventKind,
    Person,
    Secretary,
    act_originally_due,
    deadline_postponed_by_secretary,
    disaster_declaration_incident_date,
    disaster_declaration_issued_on,
    mandatory_deadline_postponed,
    performed_on,
    qualified_taxpayer,
};

relation pl_119_29_enactment_date(d: Date) kind empirical {
    label en unofficial "the date of enactment of Pub. L. 119-29 (case-supplied)";
}
relation pl_119_64_enactment_date(d: Date) kind empirical {
    label en unofficial "the date of enactment of Pub. L. 119-64 (case-supplied)";
}
relation declared_after_pl_119_29(area: Person) kind derived {
    label en unofficial "the declaration was issued after the date of enactment of Pub. L. 119-29 (effective-date rule of section 2(c))";
}
rule S7508ADeclaredAfterPl11929 strict {
    for area: Person;
    for issued: Date;
    for enacted: Date;
    when disaster_declaration_issued_on(area, issued)
        and pl_119_29_enactment_date(enacted)
        and issued > enacted;
    then declared_after_pl_119_29(area);
}

// --- (e)(1)(B) as amended: 120 days --------------------------------------------------------------------

relation candidate_120_day_extension_end(disaster_area: Person, end: Date) kind empirical {
    label en unofficial "a candidate end date for the amended §7508A(e)(1) mandatory disregarded period, supplied by the caller and validated by the rules below";
}
pub relation mandatory_120_day_extension_end(disaster_area: Person, end: Date) kind institutional {
    label en unofficial "the last day of the amended mandatory disregarded period for declarations after Pub. L. 119-29: 120 days after the later of the earliest incident date or the declaration date";
}
rule S7508AMandatory120DayExtensionFromIncident defeasible {
    for disaster_area: Person;
    for incident: Date;
    for issued: Date;
    for end: Date;
    when disaster_declaration_incident_date(disaster_area, incident)
        and disaster_declaration_issued_on(disaster_area, issued)
        and incident >= issued
        and declared_after_pl_119_29(disaster_area)
        and candidate_120_day_extension_end(disaster_area, end)
        and end > incident
        and days_between(incident, end) == 120;
    then mandatory_120_day_extension_end(disaster_area, end);
}
rule S7508AMandatory120DayExtensionFromDeclaration defeasible {
    for disaster_area: Person;
    for incident: Date;
    for issued: Date;
    for end: Date;
    when disaster_declaration_incident_date(disaster_area, incident)
        and disaster_declaration_issued_on(disaster_area, issued)
        and issued > incident
        and declared_after_pl_119_29(disaster_area)
        and candidate_120_day_extension_end(disaster_area, end)
        and end > issued
        and days_between(issued, end) == 120;
    then mandatory_120_day_extension_end(disaster_area, end);
}
rule S7508AMandatoryDeadlinePostponed120 defeasible {
    for p: Person;
    for act_kind: CombatZoneActKind;
    for disaster_area: Person;
    for original: Date;
    for candidate: Date;
    for end: Date;
    when qualified_taxpayer(p)
        and act_originally_due(p, act_kind, original)
        and performed_on(p, act_kind, candidate)
        and mandatory_120_day_extension_end(disaster_area, end)
        and candidate <= end
        and candidate > original;
    then mandatory_deadline_postponed(p, act_kind, disaster_area, original, candidate);
}

// --- (c) as inserted: State-declared disasters ---------------------------------------------------------

relation state_declaration_made_on(area: Person, d: Date) kind empirical {
    label en unofficial "the date the State declaration of the disaster was made";
}
relation governor_written_request(area: Person) kind empirical {
    label en unofficial "the Governor of the State (or the Mayor of the District of Columbia) made a written request that the rules of subsections (a) and (b) apply";
}
relation governor_determines_damage_warrants_relief(area: Person) kind empirical {
    label en unofficial "in the Governor's (or Mayor's) determination the natural catastrophe, fire, flood or explosion causes damage of sufficient severity and magnitude to warrant application of the section";
}
relation fema_administrator_consulted(area: Person) kind empirical {
    label en unofficial "the Secretary consulted the Administrator of the Federal Emergency Management Agency";
}
relation secretary_applies_rules_to_state_declared_disaster(area: Person) kind empirical {
    label en unofficial "the Secretary applies the rules of subsections (a) and (b) to the qualified State declared disaster";
}
relation state_declared_disaster_request_valid(area: Person) kind derived {
    label en unofficial "the request, the Governor's determination, the FEMA consultation and the post-enactment declaration date are all present";
}
pub relation state_declared_disaster_treated_as_disaster(area: Person) kind institutional {
    label en unofficial "the qualified State declared disaster is treated in the same manner as a disaster, fire, or action otherwise described in subsection (a)";
}
rule S7508AStateDeclaredDisasterRequestValid strict {
    for area: Person;
    for made: Date;
    for enacted: Date;
    when governor_written_request(area)
        and governor_determines_damage_warrants_relief(area)
        and fema_administrator_consulted(area)
        and state_declaration_made_on(area, made)
        and pl_119_29_enactment_date(enacted)
        and made > enacted;
    then state_declared_disaster_request_valid(area);
}
rule S7508AApplyRulesToStateDeclaredDisaster strict {
    for area: Person;
    when secretary_applies_rules_to_state_declared_disaster(area);
    then power S7508AApplyRulesToStateDeclaredDisasterPower {
        holder Secretary;
        over area;
        exercise secretary_applies_rules_to_state_declared_disaster(area);
        valid_when state_declared_disaster_request_valid(area);
        effect create(state_declared_disaster_treated_as_disaster(area));
    };
}

// --- (f) as added by Pub. L. 119-64: the section 6511(b)(2)(A) look-back ----------------------------

relation credit_or_refund_claim_filed_on(p: Person, d: Date) kind empirical {
    label en unofficial "the claim for credit or refund was filed on this date";
}
pub relation return_extension_for_6511(p: Person, original: Date, extended: Date) kind institutional {
    label en unofficial "for section 6511(b)(2)(A), the period disregarded under section 7508A for the time to file the return is treated as an extension of time for filing the return: the return due on `original` is treated as due on `extended`";
}
rule S7508AFSecretaryPostponementIsFilingExtension defeasible {
    for p: Person;
    for kind: CoveredEventKind;
    for original: Date;
    for postponed: Date;
    for filed: Date;
    for enacted: Date;
    when deadline_postponed_by_secretary(p, FilingReturn, kind, original, postponed)
        and credit_or_refund_claim_filed_on(p, filed)
        and pl_119_64_enactment_date(enacted)
        and filed > enacted;
    then return_extension_for_6511(p, original, postponed);
}
rule S7508AFMandatoryPostponementIsFilingExtension defeasible {
    for p: Person;
    for area: Person;
    for original: Date;
    for postponed: Date;
    for filed: Date;
    for enacted: Date;
    when mandatory_deadline_postponed(p, FilingReturn, area, original, postponed)
        and credit_or_refund_claim_filed_on(p, filed)
        and pl_119_64_enactment_date(enacted)
        and filed > enacted;
    then return_extension_for_6511(p, original, postponed);
}
