// 26 U.S.C. §7501 (liability for taxes withheld: trust fund status), §7801
// (Secretary's administration/enforcement authority), §7805 (regulations,
// including §7805(b)'s retroactivity limits), §7806 (construction of title).
//
// JUDGMENT CALLS (see report):
//  - §7501(b) ("For penalties applicable ... see sections 6672 and 7202")
//    is a `see`-cross-reference (§7806(a) itself says such references "are
//    made only for convenience, and shall be given no legal effect") —
//    NON_NORMATIVE.
//  - §7801(a)(2) (ATF/Attorney General administration of chapter 53 and the
//    related parts of chapters 61-80) is modelled as an institutional fact
//    about WHO administers those provisions, not a duty or power addressed
//    to a taxpayer; §7801(a)(2)(B) (savings clause for existing ATF rulings)
//    is NON_NORMATIVE (a historical continuity statement, not a rule this
//    package's facts can test). §7801(b) is `repealed_or_reserved`.
//  - §7805(a)'s "prescribe all needful rules and regulations" is modelled as
//    a `power` of the Secretary (the general regulatory power every other
//    package's "Secretary may prescribe by regulation" facts ultimately rest
//    on), rather than a `duty`: the text is permissive/institutional
//    ("shall prescribe" as an institutional competence, not a taxpayer-
//    facing achievement goal with a breach state) — consistent with how
//    §7502(c)(2)/(f) and §7508A(a) above already model Secretary regulatory
//    authority as powers.
//  - §7805(b)'s retroactivity limitation is modelled as an `immunity`
//    protecting a TAXABLE PERIOD from a regulation's retroactive
//    application, with (2)-(8) as `unless` defeaters — mirroring the
//    joint-committee package's use of `unless` to fold a statute's own
//    exceptions into one derivation rather than several competing rules.
//  - §7805(c)-(f) (preparation/distribution of forms, election-timing
//    authority, temporary-regulation sunset, small-business review) are
//    institutional/procedural directives addressed to the Secretary's own
//    process, not to a taxpayer's legal position; modelled minimally
//    (§7805(d) as a power because an owner package's "election ... at such
//    time and manner as the Secretary prescribes" facts need it) or left
//    NON_NORMATIVE (see coverage: (c), (e), (f) do not create a testable
//    taxpayer-facing position at this stage).
//  - §7806 is, by its own terms, non-normative EXCEPT as a reading rule: it
//    tells a reader/formalizer that "see" cross-references and section
//    placement carry no legal effect. Modelled as two `interpretation`-style
//    institutional facts a case can check, not as rules with a breach state.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7501_A,
    IRC_S7801_A,
    IRC_S7801_C,
    IRC_S7805_A,
    IRC_S7805_B,
    IRC_S7805_D,
    IRC_S7806_A,
    IRC_S7806_B,
    Organ,
    Person,
    Secretary,
};

// --- §7501: trust fund status for withheld/collected taxes ------------------

relation required_to_collect_or_withhold_and_pay_over(p: Person, amount: Money) kind empirical {
    label en unofficial "the person is required to collect or withhold an internal revenue tax from another person and to pay over such tax to the United States";
}
relation collected_or_withheld_amount(p: Person, amount: Money) kind empirical {
    label en unofficial "the person has collected or withheld the amount of tax (§7501's trigger for the special-fund-in-trust status)";
}

pub relation held_in_special_trust_fund(p: Person, amount: Money) kind institutional {
    label en unofficial "the amount of tax collected or withheld is held to be a special fund in trust for the United States, under §7501(a)";
}

@source(IRC_S7501_A, relation = formalizes, coverage = exact, quote = "the amount of tax so collected or withheld shall be held to be a special fund in trust for the United States")
rule S7501TrustFundStatus strict {
    for p: Person;
    for amount: Money;
    when required_to_collect_or_withhold_and_pay_over(p, amount)
        and collected_or_withheld_amount(p, amount);
    then held_in_special_trust_fund(p, amount);
}

// --- §7801(a)(1): general administration and enforcement authority ----------

relation provision_of_this_title(provision: Person) kind empirical {
    label en unofficial "the case identifies a provision of this title whose administering authority is at issue (binder for §7801(a)(1)'s otherwise-unconditional \"except as otherwise expressly provided\" rule)";
}
relation express_provision_assigns_administration_elsewhere(provision: Person) kind empirical {
    label en unofficial "another provision of this title expressly provides that administration and enforcement of it is performed by someone other than the Secretary of the Treasury (§7801(a)(1)'s own gate, \"except as otherwise expressly provided by law\")";
}

pub relation administered_by_secretary(provision: Person) kind institutional {
    label en unofficial "administration and enforcement of the named provision is performed by or under the supervision of the Secretary of the Treasury, under §7801(a)(1)";
}
@source(IRC_S7801_A, relation = formalizes, coverage = exact, quote = "Except as otherwise expressly provided by law, the administration and enforcement of this title shall be performed by or under the supervision of the Secretary of the Treasury.")
rule S7801SecretaryAdministersTitle defeasible {
    for provision: Person;
    when provision_of_this_title(provision);
    then administered_by_secretary(provision);
    unless express_provision_assigns_administration_elsewhere(provision) and provision_of_this_title(provision);
}

// --- §7801(a)(2): chapter 53 / ATF administration ----------------------------

const AttorneyGeneral: Organ = entity_ref("urn:us:irc:administration:clir#AttorneyGeneral") {
    label en official "the Attorney General";
}
relation provision_relates_to_chapter_53_enforcement(provision: Person) kind empirical {
    label en unofficial "the provision is chapter 53, or a chapter 61-80 provision to the extent it relates to the enforcement and administration of chapter 53";
}
pub relation administered_by_attorney_general(provision: Person) kind institutional {
    label en unofficial "administration and enforcement of the named provision is performed by or under the supervision of the Attorney General, under §7801(a)(2)(A) — for those provisions, \"Secretary\" in this title means the Attorney General";
}
@source(IRC_S7801_A, relation = formalizes, coverage = partial, quote = "The administration and enforcement of the following provisions of this title shall be performed by or under the supervision of the Attorney General")
rule S7801AttorneyGeneralAdministersChapter53 strict {
    for provision: Person;
    when provision_relates_to_chapter_53_enforcement(provision);
    then administered_by_attorney_general(provision);
}

// --- §7801(c): Department of Justice functions unaffected --------------------

const DepartmentOfJustice: Organ = entity_ref("urn:us:irc:administration:clir#DepartmentOfJustice") {
    label en official "the Department of Justice";
}

pub relation doj_functions_unaffected(o: Organ) kind institutional {
    label en unofficial "§7801 does not affect the duties, powers, or functions vested in the Department of Justice by law existing on May 10, 1934";
}
@source(IRC_S7801_C, relation = formalizes, coverage = exact, quote = "Nothing in this section or section 301(f) of title 31 shall be considered to affect the duties, powers, or functions imposed upon, or vested in, the Department of Justice")
assert doj_functions_unaffected(DepartmentOfJustice);

// --- §7805(a): general regulatory power --------------------------------------

relation authority_expressly_given_to_other_person(matter: Person) kind empirical {
    label en unofficial "authority over the matter is expressly given by this title to a person other than an officer or employee of the Treasury Department (§7805(a)'s own gate)";
}
relation secretary_prescribes_regulation(matter: Person) kind empirical {
    label en unofficial "the Secretary prescribes a rule or regulation for the enforcement of this title with respect to the matter";
}
pub relation regulation_in_force(matter: Person) kind institutional {
    label en unofficial "a Secretary regulation for the enforcement of this title, as to the named matter, is validly in force under §7805(a)";
}
@source(IRC_S7805_A, relation = formalizes, coverage = exact, quote = "the Secretary shall prescribe all needful rules and regulations for the enforcement of this title")
rule S7805GeneralRegulatoryPower strict {
    for matter: Person;
    when secretary_prescribes_regulation(matter);
    then power S7805GeneralRegulatoryPowerGrant {
        holder Secretary;
        over matter;
        exercise secretary_prescribes_regulation(matter);
        valid_when not_delegated_elsewhere(matter);
        effect create(regulation_in_force(matter));
    };
}
relation not_delegated_elsewhere(matter: Person) kind derived {
    label en unofficial "authority over this matter has not been expressly given by this title to a person other than a Treasury Department officer or employee (the negative of §7805(a)'s gate, folded into a single valid_when atom per LDC-E1305)";
}
@source(IRC_S7805_A, relation = formalizes, coverage = partial, quote = "Except where such authority is expressly given by this title to any person other than an officer or employee of the Treasury Department")
rule S7805NotDelegatedElsewhere strict {
    for matter: Person;
    when secretary_prescribes_regulation(matter)
        and not_known(authority_expressly_given_to_other_person(matter));
    then not_delegated_elsewhere(matter);
}

// §7805(d): manner/time of elections — an owner package's "election ... at
// such time and manner as the Secretary prescribes" rests on this power.
relation secretary_prescribes_election_manner(election_kind: Person) kind empirical {
    label en unofficial "the Secretary prescribes the time and manner for making an election of the named kind, absent an express statutory provision otherwise";
}
pub relation election_manner_prescribed(election_kind: Person) kind institutional {
    label en unofficial "the time and manner for making this kind of election has been validly prescribed by the Secretary under §7805(d)";
}
@source(IRC_S7805_D, relation = formalizes, coverage = exact, quote = "Except to the extent otherwise provided by this title, any election under this title shall be made at such time and in such manner as the Secretary shall prescribe.")
rule S7805ElectionManner strict {
    for election_kind: Person;
    when secretary_prescribes_election_manner(election_kind);
    then power S7805ElectionMannerPower {
        holder Secretary;
        over election_kind;
        exercise secretary_prescribes_election_manner(election_kind);
        valid_when not_delegated_elsewhere(election_kind);
        effect create(election_manner_prescribed(election_kind));
    };
}

// --- §7805(b): retroactivity of regulations (immunity) -----------------------

entity RegulationMatter {
    label en unofficial "a matter as to which a temporary, proposed, or final regulation relates, for purposes of §7805(b)'s retroactivity limitation";
}
relation regulation_filed_with_federal_register_on(matter: RegulationMatter, d: Date) kind empirical {
    label en unofficial "the date the regulation is filed with the Federal Register (§7805(b)(1)(A))";
}
relation related_temporary_or_proposed_regulation_filed_on(matter: RegulationMatter, d: Date) kind empirical {
    label en unofficial "the date any proposed or temporary regulation to which a final regulation relates was filed with the Federal Register (§7805(b)(1)(B))";
}
relation notice_of_expected_contents_issued_on(matter: RegulationMatter, d: Date) kind empirical {
    label en unofficial "the date any notice substantially describing the expected contents of the regulation was issued to the public (§7805(b)(1)(C))";
}
// "The earliest of the following dates" — minimum over the §7805(b)(1)(A)-(C)
// candidates without a MIN term: every established date is a candidate, and
// the earliest is the candidate for which no strictly earlier candidate
// exists (the `us.irc.excise_entities` §4941(e)(1) pattern, TECH-GAPS G136).
// The previous hand enumeration concluded up to three "earliest" dates at
// once when both (B) and (C) preceded (A), and the immunity below then fired
// against the LATEST of them (TECH-GAPS G6).
relation retroactivity_boundary_candidate(matter: RegulationMatter, d: Date) kind derived {
    label en unofficial "one of the §7805(b)(1)(A)-(C) dates established for this regulation";
}
@source(IRC_S7805_B, relation = formalizes, coverage = partial, quote = "The date on which such regulation is filed with the Federal Register.")
rule S7805RetroactivityBoundaryFromFiling(matter: RegulationMatter, filed: Date) defeasible {
    when regulation_filed_with_federal_register_on(matter, filed);
    then retroactivity_boundary_candidate(matter, filed);
}
@source(IRC_S7805_B, relation = formalizes, coverage = partial, quote = "the date on which any proposed or temporary regulation to which such final regulation relates was filed with the Federal Register")
rule S7805RetroactivityBoundaryFromRelatedRegulation(matter: RegulationMatter, filed: Date, related: Date) defeasible {
    when regulation_filed_with_federal_register_on(matter, filed)
        and related_temporary_or_proposed_regulation_filed_on(matter, related);
    then retroactivity_boundary_candidate(matter, related);
}
@source(IRC_S7805_B, relation = formalizes, coverage = partial, quote = "The date on which any notice substantially describing the expected contents of any temporary, proposed, or final regulation is issued to the public.")
rule S7805RetroactivityBoundaryFromNotice(matter: RegulationMatter, filed: Date, notice: Date) defeasible {
    when regulation_filed_with_federal_register_on(matter, filed)
        and notice_of_expected_contents_issued_on(matter, notice);
    then retroactivity_boundary_candidate(matter, notice);
}
relation earlier_retroactivity_boundary_candidate_exists(matter: RegulationMatter, d: Date) kind derived {
    label en unofficial "another §7805(b)(1) candidate date for this regulation is strictly earlier than this one";
}
rule S7805EarlierRetroactivityBoundaryExists(matter: RegulationMatter, d: Date, earlier: Date) defeasible {
    when retroactivity_boundary_candidate(matter, d)
        and retroactivity_boundary_candidate(matter, earlier)
        and earlier < d;
    then earlier_retroactivity_boundary_candidate_exists(matter, d);
}
relation earliest_retroactivity_date(matter: RegulationMatter, d: Date) kind derived {
    label en unofficial "the earliest of the §7805(b)(1)(A)-(C) dates that are established for this regulation — the boundary before which the regulation may not apply, absent an exception";
}
@source(IRC_S7805_B, relation = formalizes, coverage = exact, quote = "shall apply to any taxable period ending before the earliest of the following dates")
rule S7805EarliestRetroactivityDate(matter: RegulationMatter, d: Date) defeasible {
    when retroactivity_boundary_candidate(matter, d);
    unless earlier_retroactivity_boundary_candidate_exists(matter, d);
    then earliest_retroactivity_date(matter, d);
}

relation statutory_provision_enacted_on(matter: RegulationMatter, d: Date) kind empirical {
    label en unofficial "the date of enactment of the statutory provision to which the regulation relates (§7805(b)(2) gate)";
}
relation regulation_filed_within_18_months_of_enactment(matter: RegulationMatter) kind derived {
    label en unofficial "the regulation was filed or issued within 18 months of the date of enactment of the statutory provision to which it relates (§7805(b)(2))";
}
@source(IRC_S7805_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply to regulations filed or issued within 18 months of the date of the enactment of the statutory provision to which the regulation relates.")
rule S7805PromptlyIssuedRegulation(matter: RegulationMatter, enacted: Date, filed: Date) defeasible {
    when statutory_provision_enacted_on(matter, enacted)
        and regulation_filed_with_federal_register_on(matter, filed)
        and filed <= add_calendar_period(enacted, 18 calendar_month);
    then regulation_filed_within_18_months_of_enactment(matter);
}
relation regulation_prevents_abuse(matter: RegulationMatter) kind empirical {
    label en unofficial "the Secretary provides that the regulation takes effect or applies retroactively to prevent abuse (§7805(b)(3))";
}
relation regulation_corrects_procedural_defect(matter: RegulationMatter) kind empirical {
    label en unofficial "the Secretary provides that the regulation applies retroactively to correct a procedural defect in a prior regulation (§7805(b)(4))";
}
relation regulation_is_internal_treasury_policy(matter: RegulationMatter) kind empirical {
    label en unofficial "the regulation relates to internal Treasury Department policies, practices, or procedures (§7805(b)(5))";
}
relation congress_authorized_secretary_to_set_effective_date(matter: RegulationMatter) kind empirical {
    label en unofficial "a legislative grant from Congress authorizes the Secretary to prescribe the effective date of this regulation (§7805(b)(6))";
}
relation taxpayer_elects_earlier_application(matter: RegulationMatter, p: Person) kind empirical {
    label en unofficial "the taxpayer elects to apply the regulation before the §7805(b)(1) dates, as the Secretary may provide (§7805(b)(7))";
}
relation regulation_applied_to_taxpayer(matter: RegulationMatter, p: Person, taxable_period_end: Date) kind empirical {
    label en unofficial "the regulation is being applied to the named taxpayer for a taxable period ending on this date — the act §7805(b) protects against when the date is before the earliest §7805(b)(1) date";
}

// §7805(b)(1) is read through the immunity position itself
// (`S7805RetroactivityProtection`, `evaluate positions()`); a same-named
// relation used to be declared here without any rule concluding it.
@source(IRC_S7805_B, relation = formalizes, coverage = exact, quote = "no temporary, proposed, or final regulation relating to the internal revenue laws shall apply to any taxable period ending before the earliest of the following dates")
rule S7805RetroactivityImmunity defeasible {
    for matter: RegulationMatter;
    for p: Person;
    for taxable_period_end: Date;
    for earliest: Date;
    when earliest_retroactivity_date(matter, earliest)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end)
        and taxable_period_end < earliest;
    then immunity S7805RetroactivityProtection {
        holder p;
        protected_effect regulation_applied_to_taxpayer(matter, p, taxable_period_end);
        window [-infinity, infinity];
    };
    unless regulation_filed_within_18_months_of_enactment(matter)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end);
    unless regulation_prevents_abuse(matter)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end);
    unless regulation_corrects_procedural_defect(matter)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end);
    unless regulation_is_internal_treasury_policy(matter)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end);
    unless congress_authorized_secretary_to_set_effective_date(matter)
        and regulation_applied_to_taxpayer(matter, p, taxable_period_end);
}

// --- §7806: construction of title (readings, not rules) ----------------------

pub relation cross_reference_has_no_legal_effect(from_provision: Person, to_provision: Person) kind institutional {
    label en unofficial "a \"see\" cross-reference from one provision of this title to another is made only for convenience and has no legal effect, under §7806(a)";
}
@source(IRC_S7806_A, relation = formalizes, coverage = exact, quote = "The cross references in this title to other portions of the title, or other provisions of law, where the word \"see\" is used, are made only for convenience, and shall be given no legal effect.")
rule S7806CrossReferenceNoEffect strict {
    for from_provision: Person;
    for to_provision: Person;
    when is_see_cross_reference(from_provision, to_provision);
    then cross_reference_has_no_legal_effect(from_provision, to_provision);
}
relation is_see_cross_reference(from_provision: Person, to_provision: Person) kind empirical {
    label en unofficial "the provision contains a \"see\" cross-reference to the other provision";
}

pub relation arrangement_has_no_legal_effect(provision: Person) kind institutional {
    label en unofficial "no inference, implication, or presumption of legislative construction may be drawn from the location or grouping of this provision, or from any table of contents/cross-references/sidenote, under §7806(b)";
}
@source(IRC_S7806_B, relation = formalizes, coverage = exact, quote = "No inference, implication, or presumption of legislative construction shall be drawn or made by reason of the location or grouping of any particular section or provision or portion of this title")
rule S7806ArrangementNoEffect strict {
    for provision: Person;
    when provision_of_this_title(provision);
    then arrangement_has_no_legal_effect(provision);
}
