// 26 U.S.C. §7527 (advance payment of health insurance costs of eligible
// individuals) and §7527A (advance payment of child tax credit). STAGE 3.
//
// JUDGMENT CALLS
//  - The Trade Adjustment Assistance Reauthorization Act of 2015 enactment
//    date is a case-supplied date (`taaraa_2015_enactment_date`); the text of
//    §7527 names the Act but not its date, and the corpus does not invent it.
//  - §7527A's annual advance amount reads the estimated credit under
//    §24(i)(1) as a case fact (owner: credits): the four assumptions
//    (A)-(D) of the estimate are the credits owner's computation.
//  - §7527A "equal periodic payments" is an achievement goal over the year's
//    payments; the per-payment ledger is a case fact.
//  - "Rules similar to §6428A(f)(3)(B) and (C)" is an EXTERNAL_DEPENDENCY
//    (§6428A is not in the corpus).
//  - Rounding of Money x Decimal: cents HALF_UP (statute names none).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7527A_A,
    IRC_S7527A_B,
    IRC_S7527A_C,
    IRC_S7527A_D,
    IRC_S7527A_E,
    IRC_S7527A_F,
    IRC_S7527A_G,
    IRC_S7527_A,
    IRC_S7527_B,
    IRC_S7527_C,
    IRC_S7527_D,
    IRC_S7527_E,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// --- §7527: advance payments of qualified health insurance costs -------------------

relation taaraa_2015_enactment_date(d: Date) kind empirical {
    label en unofficial "the date of enactment of the Trade Adjustment Assistance Reauthorization Act of 2015";
}
relation hctc_program_established(o: Organ) kind empirical {
    label en unofficial "the Secretary has established the program for making payments on behalf of certified individuals to providers of qualified health insurance";
}
@source(IRC_S7527_A, relation = formalizes, coverage = exact, quote = "Not later than the date that is 1 year after the date of the enactment of the Trade Adjustment Assistance Reauthorization Act of 2015, the Secretary shall establish a program")
rule S7527EstablishProgramDuty strict {
    for d: Date;
    when taaraa_2015_enactment_date(d);
    then duty S7527EstablishAdvancePaymentProgram {
        bearer Secretary;
        goal achievement {
            condition hctc_program_established(Secretary);
            window [d, add_calendar_period(d, 1 calendar_year)];
        }
    };
}

entity HealthCoverageCertificate {
    label en unofficial "a written statement that an individual is an eligible individual (qualified health insurance costs eligibility certificate)";
}
enum HctcRecipientKind {
    EligibleTaaRecipient;
    EligibleAlternativeTaaRecipient;
    EligiblePbgcPensionRecipient;
}
enum HctcCertifier {
    SecretaryOfLabor;
    PensionBenefitGuarantyCorporation;
    OtherDesignatedBySecretary;
}
relation certificate_states_individual_eligible(c: HealthCoverageCertificate, i: Person) kind empirical {
    label en unofficial "the certificate is a written statement that the individual is an eligible individual (section 35(c)), with the information the Secretary requires";
}
relation certificate_recipient_kind(c: HealthCoverageCertificate, k: HctcRecipientKind) kind empirical {
    label en unofficial "the individual is an eligible TAA recipient, an eligible alternative TAA recipient, or an eligible PBGC pension recipient";
}
relation certificate_certified_by(c: HealthCoverageCertificate, by: HctcCertifier) kind empirical {
    label en unofficial "the certificate is certified by the Secretary of Labor, by the Pension Benefit Guaranty Corporation, or by another person or entity designated by the Secretary";
}
relation certificate_includes_state_office_contact(c: HealthCoverageCertificate) kind empirical {
    label en unofficial "the certificate includes the name, address and telephone number of the State office or offices assisting with enrollment in qualified health insurance (§7527(d)(2)(A))";
}
relation certificate_lists_state_coverage_options(c: HealthCoverageCertificate) kind empirical {
    label en unofficial "the certificate lists the coverage options treated as qualified health insurance by the State of residence (§7527(d)(2)(B))";
}
relation certificate_states_63_day_enrollment_window(c: HealthCoverageCertificate) kind empirical {
    label en unofficial "the certificate informs a TAA-eligible individual of 63 days, from the date 7 days after issuance, to enroll without a lapse in creditable coverage (§7527(d)(2)(C))";
}
relation individual_is_taa_eligible_4980b(i: Person) kind empirical {
    label en unofficial "the individual is a TAA-eligible individual (section 4980B(f)(5)(C)(iv)(II))";
}
relation certificate_holder(c: HealthCoverageCertificate, i: Person) kind empirical {
    label en unofficial "the certificate is issued for this individual";
}
relation certificate_certified_appropriately(c: HealthCoverageCertificate) kind derived {
    label en unofficial "TAA recipients: certified by the Secretary of Labor (or a designee); PBGC pension recipients: certified by the PBGC (or a designee)";
}
relation certificate_contents_complete(c: HealthCoverageCertificate) kind derived {
    label en unofficial "the certificate includes the (d)(2)(A) and (B) information and, for TAA-eligible individuals, the (d)(2)(C) statement";
}
pub relation qualified_health_insurance_costs_eligibility_certificate(c: HealthCoverageCertificate) kind institutional {
    label en unofficial "the statement is a qualified health insurance costs eligibility certificate (§7527(d))";
}
pub relation certified_individual(i: Person) kind institutional {
    label en unofficial "an individual for whom a qualified health insurance costs credit eligibility certificate is in effect (§7527(c))";
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "in the case of an eligible TAA recipient (as defined in section 35(c)(2)) or an eligible alternative TAA recipient (as defined in section 35(c)(3)), is certified by the Secretary of Labor (or by any other person or entity designated by the Secretary)")
rule S7527CertifiedTaaByLabor strict {
    for c: HealthCoverageCertificate;
    when certificate_recipient_kind(c, EligibleTaaRecipient)
        and certificate_certified_by(c, SecretaryOfLabor);
    then certificate_certified_appropriately(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "in the case of an eligible TAA recipient (as defined in section 35(c)(2)) or an eligible alternative TAA recipient (as defined in section 35(c)(3)), is certified by the Secretary of Labor (or by any other person or entity designated by the Secretary)")
rule S7527CertifiedAlternativeTaaByLabor strict {
    for c: HealthCoverageCertificate;
    when certificate_recipient_kind(c, EligibleAlternativeTaaRecipient)
        and certificate_certified_by(c, SecretaryOfLabor);
    then certificate_certified_appropriately(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "or by any other person or entity designated by the Secretary")
rule S7527CertifiedTaaByDesignee strict {
    for c: HealthCoverageCertificate;
    when certificate_recipient_kind(c, EligibleTaaRecipient)
        and certificate_certified_by(c, OtherDesignatedBySecretary);
    then certificate_certified_appropriately(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "in the case of an eligible PBGC pension recipient (as defined in section 35(c)(4)), is certified by the Pension Benefit Guaranty Corporation (or by any other person or entity designated by the Secretary)")
rule S7527CertifiedPbgc strict {
    for c: HealthCoverageCertificate;
    when certificate_recipient_kind(c, EligiblePbgcPensionRecipient)
        and certificate_certified_by(c, PensionBenefitGuarantyCorporation);
    then certificate_certified_appropriately(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "in the case of an eligible PBGC pension recipient (as defined in section 35(c)(4)), is certified by the Pension Benefit Guaranty Corporation (or by any other person or entity designated by the Secretary)")
rule S7527CertifiedPbgcByDesignee strict {
    for c: HealthCoverageCertificate;
    when certificate_recipient_kind(c, EligiblePbgcPensionRecipient)
        and certificate_certified_by(c, OtherDesignatedBySecretary);
    then certificate_certified_appropriately(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "such statement shall not be treated as a qualified health insurance costs credit eligibility certificate unless such statement includes—")
rule S7527ContentsCompleteNotTaaEligible strict {
    for c: HealthCoverageCertificate;
    for i: Person;
    when certificate_holder(c, i)
        and certificate_includes_state_office_contact(c)
        and certificate_lists_state_coverage_options(c)
        and not_known(individual_is_taa_eligible_4980b(i));
    then certificate_contents_complete(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "in the case of a TAA-eligible individual (as defined in section 4980B(f)(5)(C)(iv)(II)), a statement informing the individual that the individual has 63 days from the date that is 7 days after the date of the issuance of such certificate to enroll in such insurance without a lapse in creditable coverage")
rule S7527ContentsCompleteTaaEligible strict {
    for c: HealthCoverageCertificate;
    for i: Person;
    when certificate_holder(c, i)
        and certificate_includes_state_office_contact(c)
        and certificate_lists_state_coverage_options(c)
        and individual_is_taa_eligible_4980b(i)
        and certificate_states_63_day_enrollment_window(c);
    then certificate_contents_complete(c);
}
@source(IRC_S7527_D, relation = formalizes, coverage = exact, quote = "means any written statement that an individual is an eligible individual (as defined in section 35(c)) if such statement provides such information as the Secretary may require for purposes of this section")
rule S7527QualifiedCertificate strict {
    for c: HealthCoverageCertificate;
    for i: Person;
    when certificate_holder(c, i)
        and certificate_states_individual_eligible(c, i)
        and certificate_certified_appropriately(c)
        and certificate_contents_complete(c);
    then qualified_health_insurance_costs_eligibility_certificate(c);
}
relation certificate_in_effect(c: HealthCoverageCertificate) kind empirical {
    label en unofficial "the certificate is in effect";
}
@source(IRC_S7527_C, relation = formalizes, coverage = exact, quote = "the term \"certified individual\" means any individual for whom a qualified health insurance costs credit eligibility certificate is in effect")
rule S7527CertifiedIndividual strict {
    for c: HealthCoverageCertificate;
    for i: Person;
    when certificate_holder(c, i)
        and qualified_health_insurance_costs_eligibility_certificate(c)
        and certificate_in_effect(c);
    then certified_individual(i);
}
relation advance_payments_on_behalf_of(i: Person, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "total advance payments made on behalf of the individual during the taxable year";
}
relation amount_paid_for_qualified_coverage(i: Person, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the amount paid by the taxpayer for coverage of the taxpayer and qualifying family members under qualified health insurance for eligible coverage months beginning in the taxable year";
}
relation advance_payments_exceed_72_5_percent(i: Person, y: TaxableYear) kind derived {
    label en unofficial "advance payments for the year exceed 72.5 percent of the amount paid for qualified coverage";
}
@source(IRC_S7527_B, relation = formalizes, coverage = exact, quote = "the total amount of such payments made on behalf of any individual during the taxable year does not exceed 72.5 percent of the amount paid by the taxpayer")
rule S7527AdvanceExceedsCap strict {
    for i: Person;
    for y: TaxableYear;
    for paid_out: Money;
    for paid_in: Money;
    when advance_payments_on_behalf_of(i, y, paid_out)
        and amount_paid_for_qualified_coverage(i, y, paid_in)
        and paid_out > round(paid_in * 0.725, 2, "HALF_UP");
    then advance_payments_exceed_72_5_percent(i, y);
}
@source(IRC_S7527_B, relation = formalizes, coverage = exact, quote = "The Secretary may make payments under subsection (a) only to the extent that the total amount of such payments made on behalf of any individual during the taxable year does not exceed 72.5 percent of the amount paid by the taxpayer")
rule S7527AdvanceCapProhibition strict {
    for i: Person;
    for y: TaxableYear;
    when advance_payments_exceed_72_5_percent(i, y);
    then prohibition S7527NoAdvanceOver72Point5Percent {
        bearer Secretary;
        beneficiary i;
        action advance_payments_exceed_72_5_percent(i, y);
        window [-infinity, infinity];
    };
}
relation retroactive_premiums_for_uncovered_months(i: Person, premiums: Money) kind empirical {
    label en unofficial "premiums for coverage under qualified health insurance for eligible coverage months after one year after the enactment date and before the first month of advance payments";
}
relation national_emergency_grant_payment_for_months(i: Person, amt: Money) kind empirical {
    label en unofficial "payment to the taxpayer for the purchase of qualified health insurance under a national emergency grant (section 173(f) of the Workforce Investment Act of 1998) for the taxable year covering those months";
}
relation retroactive_payment_made(i: Person, amt: Money) kind empirical {
    label en unofficial "the Secretary made the retroactive payment on behalf of the certified individual";
}
pub relation retroactive_payment_due(i: Person, amt: Money) kind institutional {
    label en unofficial "the aggregate retroactive payment: 72.5 percent of the premiums, reduced by any national emergency grant payment";
}
@source(IRC_S7527_E, relation = formalizes, coverage = exact, quote = "in an aggregate amount equal to 72.5 percent of the premiums for coverage of the taxpayer and qualifying family members under qualified health insurance for eligible coverage months")
rule S7527RetroactivePaymentAmount strict {
    for i: Person;
    for prem: Money;
    for grant: Money;
    when certified_individual(i)
        and retroactive_premiums_for_uncovered_months(i, prem)
        and national_emergency_grant_payment_for_months(i, grant);
    then retroactive_payment_due(i, max(0.00 USD, round(prem * 0.725, 2, "HALF_UP") - grant));
}
@source(IRC_S7527_E, relation = formalizes, coverage = exact, quote = "the Secretary shall make 1 or more retroactive payments on behalf of a certified individual")
rule S7527RetroactivePaymentDuty defeasible {
    for i: Person;
    for amt: Money;
    when retroactive_payment_due(i, amt);
    then duty S7527MakeRetroactivePayment {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition retroactive_payment_made(i, amt);
            window [-infinity, infinity];
        }
    };
}

// --- §7527A: advance payment of the child tax credit -----------------------------------

relation estimated_credit_24i1_for_year(t: Person, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the amount estimated as allowed under subpart C of part IV of subchapter A of chapter 1 by reason of section 24(i)(1) for the taxable year beginning in the calendar year, on the four assumptions of §7527A(b)(1)(A)-(D) (owner: credits)";
}
pub relation annual_advance_amount(t: Person, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the annual advance amount: 50 percent of the estimated section 24(i)(1) credit";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "the amount (if any) which is estimated by the Secretary as being equal to 50 percent of the amount which would be treated as allowed under subpart C of part IV of subchapter A of chapter 1 by reason of section 24(i)(1)")
rule S7527AAnnualAdvanceAmount strict {
    for t: Person;
    for cy: Integer;
    for est: Money;
    when estimated_credit_24i1_for_year(t, cy, est);
    then annual_advance_amount(t, cy, round(est * 0.5, 2, "HALF_UP"));
}
relation filed_return_for_preceding_year(t: Person, cy: Integer) kind empirical {
    label en unofficial "the taxpayer filed a return of tax for the taxable year beginning in the preceding calendar year";
}
pub relation reference_taxable_year_calendar(t: Person, cy: Integer, ref_cy: Integer) kind institutional {
    label en unofficial "the calendar year in which the reference taxable year begins";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "the taxpayer's taxable year beginning in the preceding calendar year or, in the case of taxpayer who did not file a return of tax for such taxable year, the taxpayer's taxable year beginning in the second preceding calendar year")
rule S7527AReferenceYearPreceding strict {
    for t: Person;
    for cy: Integer;
    when filed_return_for_preceding_year(t, cy);
    then reference_taxable_year_calendar(t, cy, cy - 1);
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "the taxpayer's taxable year beginning in the preceding calendar year or, in the case of taxpayer who did not file a return of tax for such taxable year, the taxpayer's taxable year beginning in the second preceding calendar year")
rule S7527AReferenceYearSecondPreceding strict {
    for t: Person;
    for cy: Integer;
    when calendar_year_of_advance_payments(t, cy)
        and not_known(filed_return_for_preceding_year(t, cy));
    then reference_taxable_year_calendar(t, cy, cy - 2);
}
relation calendar_year_of_advance_payments(t: Person, cy: Integer) kind empirical {
    label en unofficial "the calendar year for which the taxpayer's advance payments are determined";
}
relation periodic_payments_made_equal_and_total_annual_amount(t: Person, cy: Integer) kind empirical {
    label en unofficial "the periodic payments made to the taxpayer for the calendar year are in equal amounts and total the annual advance amount (except for the (b)(3)(B) adjustment)";
}
@source(IRC_S7527A_A, relation = formalizes, coverage = exact, quote = "The Secretary shall establish a program for making periodic payments to taxpayers which, in the aggregate during any calendar year, equal the annual advance amount determined with respect to such taxpayer for such calendar year.")
rule S7527APeriodicPaymentsDuty defeasible {
    for t: Person;
    for cy: Integer;
    for amt: Money;
    when annual_advance_amount(t, cy, amt);
    then duty S7527AMakePeriodicPayments {
        bearer Secretary;
        beneficiary t;
        goal achievement {
            condition periodic_payments_made_equal_and_total_annual_amount(t, cy);
            window [-infinity, infinity];
        }
    };
}
relation secretary_modifies_annual_advance_amount(t: Person, cy: Integer, new_amt: Money) kind empirical {
    label en unofficial "the Secretary modifies the annual advance amount during the calendar year, taking into account a return filed that year or other information provided by the taxpayer";
}
relation return_filed_or_information_provided_in_year(t: Person, cy: Integer) kind empirical {
    label en unofficial "the taxpayer filed a return during the calendar year or provided other information allowing the Secretary to estimate the credit more closely";
}
pub relation modified_annual_advance_amount(t: Person, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the annual advance amount as modified by the Secretary during the calendar year (§7527A(b)(3)(A))";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "The Secretary may modify, during any calendar year, the annual advance amount with respect to any taxpayer for such calendar year to take into account—")
rule S7527AModifyAmountPower strict {
    for t: Person;
    for cy: Integer;
    for new_amt: Money;
    when secretary_modifies_annual_advance_amount(t, cy, new_amt);
    then power S7527AModifyAnnualAdvanceAmount {
        holder Secretary;
        over t;
        exercise secretary_modifies_annual_advance_amount(t, cy, new_amt);
        valid_when return_filed_or_information_provided_in_year(t, cy);
        effect create(modified_annual_advance_amount(t, cy, new_amt));
    };
}
relation secretary_determines_status_from_known_information(t: Person, cy: Integer) kind empirical {
    label en unofficial "where the reference-year return does not establish the section 24(i)(1) status, the Secretary determines the status based on information known to the Secretary";
}
relation reference_return_does_not_establish_status(t: Person, cy: Integer) kind empirical {
    label en unofficial "the reference-year return does not establish the taxpayer's status as a taxpayer described in section 24(i)(1)";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "the Secretary shall, for purposes of paragraph (1)(A), determine such status based on information known to the Secretary")
rule S7527AStatusDeterminationDuty defeasible {
    for t: Person;
    for cy: Integer;
    when reference_return_does_not_establish_status(t, cy);
    then duty S7527ADetermineStatusFromKnownInformation {
        bearer Secretary;
        beneficiary t;
        goal achievement {
            condition secretary_determines_status_from_known_information(t, cy);
            window [-infinity, infinity];
        }
    };
}
enum PortalCapability {
    ElectNotToReceivePayments;
    ReportChangeInQualifyingChildren;
    ReportChangeInMaritalStatus;
    ReportSignificantIncomeChange;
    ReportOtherFactorProvidedBySecretary;
}
relation portal_supports(o: Organ, cap: PortalCapability) kind empirical {
    label en unofficial "the Secretary's on-line portal allows taxpayers to use the named capability: to elect not to receive payments, or to provide information relevant to a modification of the annual advance amount (change in qualifying children including by birth, marital status, significant income change, other factors)";
}
relation portal_established(o: Organ) kind derived {
    label en unofficial "the portal supports the election and all four kinds of modification information";
}
@source(IRC_S7527A_C, relation = formalizes, coverage = exact, quote = "The Secretary shall establish an on-line portal which allows taxpayers to—")
rule S7527APortalComplete strict {
    for o: Organ;
    when portal_supports(o, ElectNotToReceivePayments)
        and portal_supports(o, ReportChangeInQualifyingChildren)
        and portal_supports(o, ReportChangeInMaritalStatus)
        and portal_supports(o, ReportSignificantIncomeChange)
        and portal_supports(o, ReportOtherFactorProvidedBySecretary);
    then portal_established(o);
}
@source(IRC_S7527A_C, relation = formalizes, coverage = exact, quote = "The Secretary shall establish an on-line portal which allows taxpayers to—")
rule S7527APortalDuty strict {
    when true;
    then duty S7527AEstablishPortal {
        bearer Secretary;
        goal maintenance {
            condition portal_established(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation taxpayer_elects_out_of_advance_payments(t: Person) kind empirical {
    label en unofficial "the taxpayer elects, through the portal, not to receive payments under §7527A";
}
pub relation advance_payments_election_out_effective(t: Person) kind institutional {
    label en unofficial "the taxpayer's election not to receive advance payments is in effect";
}
@source(IRC_S7527A_C, relation = formalizes, coverage = exact, quote = "elect not to receive payments under this section")
rule S7527AElectOutPower strict {
    for t: Person;
    when taxpayer_elects_out_of_advance_payments(t);
    then power S7527AElectNotToReceivePayments {
        holder t;
        over Secretary;
        exercise taxpayer_elects_out_of_advance_payments(t);
        valid_when taxpayer_elects_out_of_advance_payments(t);
        effect create(advance_payments_election_out_effective(t));
    };
}
relation payments_made_to_taxpayer_in_calendar_year(t: Person, cy: Integer) kind empirical {
    label en unofficial "the Secretary made one or more payments to the taxpayer under §7527A in the calendar year";
}
relation calendar_year_end_date(cy: Integer, d: Date) kind empirical {
    label en unofficial "December 31 of the calendar year (case-supplied: no date-of-calendar-year term, TECH-GAPS G3005)";
}
relation written_notice_of_payments_provided(t: Person, cy: Integer) kind empirical {
    label en unofficial "the Secretary provided the taxpayer a written notice with the taxpayer identity, the aggregate amount of payments in the calendar year, and other appropriate information";
}
@source(IRC_S7527A_D, relation = formalizes, coverage = exact, quote = "Not later than January 31 of the calendar year following any calendar year during which the Secretary makes one or more payments to any taxpayer under this section, the Secretary shall provide such taxpayer with a written notice")
rule S7527ANoticeDuty defeasible {
    for t: Person;
    for cy: Integer;
    for dec31: Date;
    when payments_made_to_taxpayer_in_calendar_year(t, cy)
        and calendar_year_end_date(cy, dec31);
    then duty S7527AProvideNoticeOfPayments {
        bearer Secretary;
        beneficiary t;
        goal achievement {
            condition written_notice_of_payments_provided(t, cy);
            window [dec31, add_calendar_period(dec31, 1 calendar_month)];
        }
    };
}
relation payments_by_electronic_funds_transfer(t: Person) kind empirical {
    label en unofficial "the payments are made by electronic funds transfer, as Federal payments not made under this title";
}
relation payments_under_7527a_exist(t: Person) kind empirical {
    label en unofficial "payments are made to the taxpayer under §7527A";
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "The payments made by the Secretary under subsection (a) shall be made by electronic funds transfer to the same extent and in the same manner as if such payments were Federal payments not made under this title.")
rule S7527AEftDuty defeasible {
    for t: Person;
    when payments_under_7527a_exist(t);
    then duty S7527AMakePaymentsByEft {
        bearer Secretary;
        beneficiary t;
        goal maintenance {
            condition payments_by_electronic_funds_transfer(t);
            window [-infinity, infinity];
        }
    };
}
pub relation advance_payment_not_offset(t: Person) kind institutional {
    label en unofficial "payments under §7527A are not reduced or offset (§7527A(e)(3))";
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "Any payment made to any individual under this section shall not be—")
rule S7527ANoOffsetImmunity strict {
    for t: Person;
    when payments_under_7527a_exist(t);
    then immunity S7527APaymentImmuneFromOffset {
        holder t;
        against Secretary;
        protected_effect advance_payment_not_offset(t);
        window [-infinity, infinity];
    };
}
relation possession_has_mirror_code_tax_system(pos: Person) kind empirical {
    label en unofficial "the possession has a mirror code tax system (section 24(k))";
}
relation possession_elects_7527a_as_income_tax_law(pos: Person) kind empirical {
    label en unofficial "the possession elects to have §7527A treated as part of the income tax laws of the United States for its mirror code";
}
relation possession_has_approved_advance_payment_plan(pos: Person) kind empirical {
    label en unofficial "the possession has a plan, approved by the Secretary, for making advance payments consistent with its election";
}
relation possession_is_american_samoa(pos: Person) kind empirical {
    label en unofficial "the possession is American Samoa";
}
relation american_samoa_plan_includes_approved_advance_payment_program(pos: Person) kind empirical {
    label en unofficial "the section 24(k)(3)(B) plan includes a program approved by the Secretary for advance payments under rules similar to §7527A";
}
pub relation section_7527a_part_of_possession_income_tax_law(pos: Person) kind institutional {
    label en unofficial "§7527A is treated as part of the income tax laws of the United States for the possession's mirror code (only if the possession elects)";
}
pub relation possession_administrative_expense_increase(pos: Person, amt: Money) kind institutional {
    label en unofficial "the amount otherwise paid to the possession for taxable years beginning in 2021 is increased by $300,000";
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "this section shall not be treated as part of the income tax laws of the United States for purposes of determining the income tax law of such possession unless such possession elects to have this section be so treated")
rule S7527AMirrorCodeElection strict {
    for pos: Person;
    when possession_has_mirror_code_tax_system(pos)
        and possession_elects_7527a_as_income_tax_law(pos);
    then section_7527a_part_of_possession_income_tax_law(pos);
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "the amount otherwise paid by the Secretary to such possession under section 24(k)(1)(A) with respect to taxable years beginning in 2021 shall be increased by $300,000 if such possession has a plan, which has been approved by the Secretary")
rule S7527AMirrorCodeAdminIncrease strict {
    for pos: Person;
    when section_7527a_part_of_possession_income_tax_law(pos)
        and possession_has_approved_advance_payment_plan(pos);
    then possession_administrative_expense_increase(pos, 300000.00 USD);
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "The amount otherwise paid by the Secretary to American Samoa under subparagraph (A) of section 24(k)(3) with respect to taxable years beginning in 2021 shall be increased by $300,000")
rule S7527AAmericanSamoaAdminIncrease strict {
    for pos: Person;
    when possession_is_american_samoa(pos)
        and american_samoa_plan_includes_approved_advance_payment_program(pos);
    then possession_administrative_expense_increase(pos, 300000.00 USD);
}
relation possession_requests_immediate_payment(pos: Person) kind empirical {
    label en unofficial "the possession requests payment of the increase immediately upon approval of its plan";
}
relation secretary_pays_increase_on_approval(pos: Person) kind empirical {
    label en unofficial "the Secretary pays the increase immediately upon approval of the plan";
}
@source(IRC_S7527A_E, relation = formalizes, coverage = exact, quote = "The Secretary may pay, upon the request of the possession of the United States to which the payment is to be made, the amount of the increase determined under clause (i) or (ii) immediately upon approval of the plan referred to in such clause")
rule S7527ATimingLiberty defeasible {
    for pos: Person;
    when possession_requests_immediate_payment(pos)
        and secretary_pays_increase_on_approval(pos);
    then liberty S7527APayIncreaseOnApproval {
        holder Secretary;
        against pos;
        action secretary_pays_increase_on_approval(pos);
        window [-infinity, infinity];
    };
}
relation advance_payment_period(pay: Person, start: Date, stop: Date) kind empirical {
    label en unofficial "the period to which an advance payment under §7527A relates (payment identified by a person-typed key: the recipient)";
}
relation advance_payment_outside_window(pay: Person) kind derived {
    label en unofficial "a payment relates to a period before July 1, 2021 or after December 31, 2021";
}
@source(IRC_S7527A_F, relation = formalizes, coverage = exact, quote = "any period before July 1, 2021")
rule S7527ARelatesBeforeJuly2021 strict {
    for pay: Person;
    for start: Date;
    for stop: Date;
    when advance_payment_period(pay, start, stop)
        and start < @2021-07-01;
    then advance_payment_outside_window(pay);
}
@source(IRC_S7527A_F, relation = formalizes, coverage = exact, quote = "any period after December 31, 2021")
rule S7527ARelatesAfterDecember2021 strict {
    for pay: Person;
    for start: Date;
    for stop: Date;
    when advance_payment_period(pay, start, stop)
        and stop > @2021-12-31;
    then advance_payment_outside_window(pay);
}
@source(IRC_S7527A_F, relation = formalizes, coverage = exact, quote = "No payments shall be made under the program established under subsection (a) with respect to—")
rule S7527AWindowProhibition strict {
    for pay: Person;
    when advance_payment_outside_window(pay);
    then prohibition S7527ANoPaymentOutsideJulyToDecember2021 {
        bearer Secretary;
        beneficiary pay;
        action advance_payment_outside_window(pay);
        window [-infinity, infinity];
    };
}
relation secretary_issues_7527a_guidance(o: Organ) kind empirical {
    label en unofficial "the Secretary issues the regulations or other guidance necessary or appropriate to carry out §7527A and section 24(i)(1) and (j), including application where the filing status differs from the status used for the annual advance amount";
}
@source(IRC_S7527A_G, relation = formalizes, coverage = partial, quote = "The Secretary shall issue such regulations or other guidance as the Secretary determines necessary or appropriate to carry out the purposes of this section")
rule S7527AGuidanceDuty strict {
    when true;
    then duty S7527AIssueGuidance {
        bearer Secretary;
        goal maintenance {
            condition secretary_issues_7527a_guidance(Secretary);
            window [-infinity, infinity];
        }
    };
}
