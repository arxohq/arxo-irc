// G6: (B) and (C) both precede (A) — the boundary is the EARLIEST of the three,
// so a period ending between (C) and (A) is not protected.
test "S7805-05-EARLIEST-OF-THREE-DATES-IS-THE-BOUNDARY" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert regulation_filed_with_federal_register_on(entity_ref("urn:us:irc:administration:clir#Reg3"), @2026-03-01) { id "f0"; origin case_input; }
        assert related_temporary_or_proposed_regulation_filed_on(entity_ref("urn:us:irc:administration:clir#Reg3"), @2026-01-15) { id "f1"; origin case_input; }
        assert notice_of_expected_contents_issued_on(entity_ref("urn:us:irc:administration:clir#Reg3"), @2025-12-01) { id "f2"; origin case_input; }
    }
    evaluate truth(earliest_retroactivity_date(entity_ref("urn:us:irc:administration:clir#Reg3"), @2025-12-01));
    expect truth_status == TRUE_ONLY;
}

