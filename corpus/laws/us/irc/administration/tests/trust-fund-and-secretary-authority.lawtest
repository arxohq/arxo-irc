test "S7501-01-WITHHELD-TAX-IS-A-TRUST-FUND" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert required_to_collect_or_withhold_and_pay_over(entity_ref("urn:us:irc:administration:clir#Employer1"), 500.00 USD) { id "f0"; origin case_input; }
        assert collected_or_withheld_amount(entity_ref("urn:us:irc:administration:clir#Employer1"), 500.00 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(held_in_special_trust_fund(entity_ref("urn:us:irc:administration:clir#Employer1"), 500.00 USD));
    expect truth_status == TRUE_ONLY;
}

