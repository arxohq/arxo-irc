// --- §7518(a) ---
test "S7518-01-CEILING-IS-SUM-OF-A-B-C-D" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert a1a_operating_income(entity_ref("urn:us:irc:administration:clir#Fund1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 100000.00 USD) { id "f0"; origin case_input; }
        assert a1b_section_167_deduction(entity_ref("urn:us:irc:administration:clir#Fund1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 20000.00 USD) { id "f1"; origin case_input; }
        assert a1c_net_proceeds_not_in_a(entity_ref("urn:us:irc:administration:clir#Fund1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 0.00 USD) { id "f2"; origin case_input; }
        assert a1d_investment_receipts(entity_ref("urn:us:irc:administration:clir#Fund1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 5000.00 USD) { id "f3"; origin case_input; }
    }
    evaluate truth(deposit_ceiling(entity_ref("urn:us:irc:administration:clir#Fund1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 125000.00 USD));
    expect truth_status == TRUE_ONLY;
}
