// Scenarios for 27-section-7520-table-factors.law (26/7520/a/u2 wire).
// NOT executed in this stage — `implemented_unverified`.
// Key literal: Table S remainder factor at 3.2% for age 75 -> 0.69903
// (pinned `us.cfr.t26_7520_2031`, 20.2031-7 Table 2, eCFR 2026-09-24).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

test "S7520-09-TABLE-S-FACTOR-APPLIES-AT-COMPUTED-RATE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert section_7520_applies(entity_ref("urn:test:s7520:f9#v")) { id "f0"; origin case_input; }
        assert section_7520_interest_rate(entity_ref("urn:test:s7520:f9#v"), 0.032) { id "f1"; origin case_input; }
        assert table_s_remainder_factor_selected(entity_ref("urn:test:s7520:f9#v"), 0.032, 75, 0.69903) { id "f2"; origin case_input; }
    }
    evaluate truth(section_7520_table_factor(entity_ref("urn:test:s7520:f9#v"), 0.69903));
    expect truth_status == TRUE_ONLY;
}

test "S7520-10-TABLE-S-FACTOR-NOT-APPLIED-AT-OTHER-RATE" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert section_7520_applies(entity_ref("urn:test:s7520:f10#v")) { id "f0"; origin case_input; }
        assert section_7520_interest_rate(entity_ref("urn:test:s7520:f10#v"), 0.034) { id "f1"; origin case_input; }
        assert table_s_remainder_factor_selected(entity_ref("urn:test:s7520:f10#v"), 0.032, 75, 0.69903) { id "f2"; origin case_input; }
    }
    // selected factor is keyed to 0.032, the valuation rate is 0.034 -> no derivation
    evaluate truth(section_7520_table_factor(entity_ref("urn:test:s7520:f10#v"), 0.69903));
    expect truth_status == NEITHER;
}
