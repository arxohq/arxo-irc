// Scenarios for 26 U.S.C. §7851, §7852, module 06-applicability.law. NOT
// executed in this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

test "S7851-01-SUBTITLE-D-HISTORICAL-EFFECTIVE-DATE" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
    }
    evaluate truth(subtitle_effective_on(SubtitleD, @1955-01-01));
    expect truth_status == TRUE_ONLY;
}

test "S7852-01-SEPARABILITY-REMAINDER-UNAFFECTED" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert provision_held_invalid(entity_ref("urn:us:irc:administration:clir#InvalidProvision1")) { id "f0"; origin case_input; }
    }
    evaluate truth(remainder_unaffected_by_invalidity(entity_ref("urn:us:irc:administration:clir#InvalidProvision1")));
    expect truth_status == TRUE_ONLY;
}

test "S7852-02-DOUBLE-COUNTING-VIOLATION" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert item_taken_into_account_under_subtitle_a(entity_ref("urn:us:irc:administration:clir#Item1"), entity_ref("urn:us:irc:administration:clir#Taxpayer4")) { id "f0"; origin case_input; }
        assert item_taken_into_account_under_1939_code_ch1_or_2(entity_ref("urn:us:irc:administration:clir#Item1"), entity_ref("urn:us:irc:administration:clir#Taxpayer4")) { id "f1"; origin case_input; }
    }
    evaluate truth(double_counted_item_violates_7852c(entity_ref("urn:us:irc:administration:clir#Item1"), entity_ref("urn:us:irc:administration:clir#Taxpayer4")));
    expect truth_status == TRUE_ONLY;
}

test "S7852-03-DOUBLE-COUNTING-EXPRESSLY-INTENDED-DEFEATS-VIOLATION" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert item_taken_into_account_under_subtitle_a(entity_ref("urn:us:irc:administration:clir#Item2"), entity_ref("urn:us:irc:administration:clir#Taxpayer5")) { id "f0"; origin case_input; }
        assert item_taken_into_account_under_1939_code_ch1_or_2(entity_ref("urn:us:irc:administration:clir#Item2"), entity_ref("urn:us:irc:administration:clir#Taxpayer5")) { id "f1"; origin case_input; }
        assert double_counting_expressly_intended(entity_ref("urn:us:irc:administration:clir#Item2"), entity_ref("urn:us:irc:administration:clir#Taxpayer5")) { id "f2"; origin case_input; }
    }
    evaluate truth(double_counted_item_violates_7852c(entity_ref("urn:us:irc:administration:clir#Item2"), entity_ref("urn:us:irc:administration:clir#Taxpayer5")));
    expect truth_status == NEITHER;
}

test "S7852-04-1954-TREATY-SAVINGS-CLAUSE" {
    given {
        context { decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; legal_time @2026-01-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert title_provision_contrary_to_1954_treaty_obligation(entity_ref("urn:us:irc:administration:clir#Provision1"), entity_ref("urn:us:irc:administration:clir#Treaty1")) { id "f0"; origin case_input; }
    }
    evaluate truth(title_provision_does_not_apply_under_1954_treaty_savings_clause(entity_ref("urn:us:irc:administration:clir#Provision1"), entity_ref("urn:us:irc:administration:clir#Treaty1")));
    expect truth_status == TRUE_ONLY;
}
