// --- §7874(a)(2)(B) surrogate foreign corporation ---
test "S7874-01-CONDITION-I-ACQUISITION-AFTER-MARCH-4-2003" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert foreign_corporation(entity_ref("urn:us:irc:administration:clir#Foreign1")) { id "f0"; origin case_input; }
        assert domestic_corporation_or_partnership(entity_ref("urn:us:irc:administration:clir#Target1")) { id "f1"; origin case_input; }
        assert acquisition_completed_on(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1"), @2024-05-01) { id "f2"; origin case_input; }
        assert acquisition_first_property_date(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1"), @2024-05-01) { id "f3"; origin case_input; }
        assert acquisition_last_property_date(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1"), @2024-05-15) { id "f4"; origin case_input; }
        assert former_owner_percentage(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1"), 65.0) { id "f5"; origin case_input; }
        assert acquisition_pursuant_to_plan(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1")) { id "f6"; origin case_input; }
        assert eag_lacks_substantial_business_activities(entity_ref("urn:us:irc:administration:clir#Foreign1")) { id "f7"; origin case_input; }
    }
    evaluate truth(acquisition_condition_i(entity_ref("urn:us:irc:administration:clir#Foreign1"), entity_ref("urn:us:irc:administration:clir#Target1")));
    expect truth_status == TRUE_ONLY;
}
