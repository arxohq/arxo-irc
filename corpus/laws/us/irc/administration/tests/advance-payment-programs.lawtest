// Scenarios for 26 U.S.C. §§7527, 7527A, module 12-advance-payment-programs.law. NOT executed: `implemented_unverified`. The TAARA 2015 enactment date in S7527-01..03 is a scenario fact, not a corpus value.
language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

// --- §7527 ---
test "S7527-01-PROGRAM-DUTY-OPEN-WITHIN-ONE-YEAR" {
    given {
        context { decision_time @2016-01-01T09:00:00-04:00; knowledge_time @2016-01-01T09:00:00-04:00; legal_time @2016-01-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert taaraa_2015_enactment_date(@2015-06-29) { id "f0"; origin case_input; }
    }
    evaluate positions();
    expect position(S7527EstablishAdvancePaymentProgram, ACTIVE);
}
test "S7527-02-PROGRAM-DUTY-VIOLATED-AFTER-ONE-YEAR" {
    given {
        context { decision_time @2016-07-01T09:00:00-04:00; knowledge_time @2016-07-01T09:00:00-04:00; legal_time @2016-07-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
