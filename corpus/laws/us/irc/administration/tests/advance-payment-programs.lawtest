}
test "S7527-04-TAA-RECIPIENT-CERTIFIED-BY-LABOR-WITH-63-DAY-STATEMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert certificate_holder(entity_ref("urn:us:irc:administration:clir#Cert1"), entity_ref("urn:us:irc:administration:clir#Worker1")) { id "f0"; origin case_input; }
        assert certificate_states_individual_eligible(entity_ref("urn:us:irc:administration:clir#Cert1"), entity_ref("urn:us:irc:administration:clir#Worker1")) { id "f1"; origin case_input; }
        assert certificate_recipient_kind(entity_ref("urn:us:irc:administration:clir#Cert1"), EligibleTaaRecipient) { id "f2"; origin case_input; }
        assert certificate_certified_by(entity_ref("urn:us:irc:administration:clir#Cert1"), SecretaryOfLabor) { id "f3"; origin case_input; }
        assert certificate_includes_state_office_contact(entity_ref("urn:us:irc:administration:clir#Cert1")) { id "f4"; origin case_input; }
        assert certificate_lists_state_coverage_options(entity_ref("urn:us:irc:administration:clir#Cert1")) { id "f5"; origin case_input; }
        assert individual_is_taa_eligible_4980b(entity_ref("urn:us:irc:administration:clir#Worker1")) { id "f6"; origin case_input; }
        assert certificate_states_63_day_enrollment_window(entity_ref("urn:us:irc:administration:clir#Cert1")) { id "f7"; origin case_input; }
    }
    evaluate truth(qualified_health_insurance_costs_eligibility_certificate(entity_ref("urn:us:irc:administration:clir#Cert1")));
    expect truth_status == TRUE_ONLY;
}
