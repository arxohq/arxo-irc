}
test "S7527-03-PROGRAM-DUTY-SATISFIED-BY-ESTABLISHING" {
    given {
        context { decision_time @2016-01-01T09:00:00-04:00; knowledge_time @2016-01-01T09:00:00-04:00; legal_time @2016-01-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
