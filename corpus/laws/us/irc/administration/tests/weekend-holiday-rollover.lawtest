// Scenarios for 26 U.S.C. §7503, module 02-weekend-holiday-rollover.law.
// NOT executed in this stage — `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

test "S7503-01-BUSINESS-DAY-DUE-DATE-NOT-ROLLED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // 2026-04-15 is a Wednesday.
        assert day_in_question(@2026-04-15) { id "f0"; origin case_input; }
    }
    evaluate truth(last_day_rolled(@2026-04-15, @2026-04-15));
    expect truth_status == TRUE_ONLY;
}

test "S7503-02-SATURDAY-DUE-DATE-ROLLS-TO-VALIDATED-MONDAY" {
    given {
        context { decision_time @2026-04-18T09:00:00-04:00; knowledge_time @2026-04-18T09:00:00-04:00; legal_time @2026-04-18; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // 2026-04-18 is a Saturday; 2026-04-20 is the following Monday.
        assert day_in_question(@2026-04-18) { id "f0"; origin case_input; }
        assert day_in_question(@2026-04-20) { id "f1"; origin case_input; }
        assert next_business_day_candidate(@2026-04-18, @2026-04-20) { id "f2"; origin case_input; }
    }
    evaluate truth(last_day_rolled(@2026-04-18, @2026-04-20));
    expect truth_status == TRUE_ONLY;
}

test "S7503-03-SUNDAY-DUE-DATE-ROLLS-TO-VALIDATED-MONDAY" {
    given {
        context { decision_time @2026-04-19T09:00:00-04:00; knowledge_time @2026-04-19T09:00:00-04:00; legal_time @2026-04-19; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // 2026-04-19 is a Sunday.
        assert day_in_question(@2026-04-19) { id "f0"; origin case_input; }
        assert day_in_question(@2026-04-20) { id "f1"; origin case_input; }
        assert next_business_day_candidate(@2026-04-19, @2026-04-20) { id "f2"; origin case_input; }
    }
    evaluate truth(last_day_rolled(@2026-04-19, @2026-04-20));
    expect truth_status == TRUE_ONLY;
}

test "S7503-04-INVALID-CANDIDATE-STILL-A-WEEKEND-DAY-IS-REJECTED" {
    given {
        context { decision_time @2026-04-18T09:00:00-04:00; knowledge_time @2026-04-18T09:00:00-04:00; legal_time @2026-04-18; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // Candidate is 2026-04-19, itself a Sunday — not a business day.
        assert day_in_question(@2026-04-18) { id "f0"; origin case_input; }
        assert day_in_question(@2026-04-19) { id "f1"; origin case_input; }
        assert next_business_day_candidate(@2026-04-18, @2026-04-19) { id "f2"; origin case_input; }
    }
    evaluate truth(last_day_rolled(@2026-04-18, @2026-04-19));
    expect truth_status == NEITHER;
}

test "S7503-05-OBSERVED-JULY-3-2026-ASSERTED-AS-DC-LEGAL-HOLIDAY" {
    // 2026-07-04 is a Saturday; the Friday before is observed. §7503 reads the
    // District of Columbia's legal holidays, which are NOT the 5 U.S.C. §6103
    // list (D.C. Code adds DC Emancipation Day and its own observance rules;
    // no D.C. Code text is pinned — TECH-GAPS G4), so the observed day enters
    // as a case fact and the date is not a business day.
    given {
        context { decision_time @2026-07-03T09:00:00-04:00; knowledge_time @2026-07-03T09:00:00-04:00; legal_time @2026-07-03; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert day_in_question(@2026-07-03) { id "f0"; origin case_input; }
        assert legal_holiday_in_dc(@2026-07-03) { id "f1"; origin case_input; }
    }
    evaluate truth(is_business_day(@2026-07-03));
    expect truth_status == NEITHER;
}

test "S7503-07-WITHOUT-DC-HOLIDAY-FACT-A-WEEKDAY-IS-A-BUSINESS-DAY" {
    // The same Friday without the case fact: the package does not know DC
    // holidays by itself, so the date counts as a business day. This is the
    // visible cost of G4 until a D.C. Code holiday source is pinned.
    given {
        context { decision_time @2026-07-03T09:00:00-04:00; knowledge_time @2026-07-03T09:00:00-04:00; legal_time @2026-07-03; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert day_in_question(@2026-07-03) { id "f0"; origin case_input; }
    }
    evaluate truth(is_business_day(@2026-07-03));
    expect truth_status == TRUE_ONLY;
}

test "S7503-06-UNKNOWN-WEEKDAY-DUE-DATE-UNDETERMINED" {
    given {
        context { decision_time @2026-04-15T09:00:00-04:00; knowledge_time @2026-04-15T09:00:00-04:00; legal_time @2026-04-15; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
    }
    evaluate why_not(last_day_rolled(@2026-04-15, @2026-04-15));
    expect truth_status == NEITHER;
}
