test "S7518D5-01-LOSSES-LIMITED-BY-GAINS-PLUS-PRIOR-BALANCE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": account_component_gains_7518d5(entity_ref("urn:us:irc:administration:clir#CF1"), entity_ref("urn:us:irc:administration:clir#Y2026"), MoreThan6Months, 500.00 USD) { origin case_input; }
        assert "f1": account_component_losses_7518d5(entity_ref("urn:us:irc:administration:clir#CF1"), entity_ref("urn:us:irc:administration:clir#Y2026"), MoreThan6Months, 800.00 USD) { origin case_input; }
        assert "f2": prior_gain_component_balance_7518d5(entity_ref("urn:us:irc:administration:clir#CF1"), MoreThan6Months, 100.00 USD) { origin case_input; }
    }
    evaluate truth(allowed_capital_loss_offset_7518d5(entity_ref("urn:us:irc:administration:clir#CF1"), entity_ref("urn:us:irc:administration:clir#Y2026"), MoreThan6Months, 600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

