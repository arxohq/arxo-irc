        assert credits_and_refunds_for_individual(entity_ref("urn:us:irc:administration:clir#Individual1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 2500.00 USD) { id "f2"; origin case_input; }
        assert net_collections_covered_into_possession_treasury(entity_ref("urn:us:irc:administration:clir#Individual1"), entity_ref("urn:us:irc:administration:clir#Y2025")) { id "f3"; origin case_input; }
    }
    evaluate positions();
    expect position(S7654CoverOverNetCollections, SATISFIED);
}
