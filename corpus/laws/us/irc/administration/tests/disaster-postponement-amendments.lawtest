language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

// --- PL 119-29 §2(b): 120-day mandatory extension ---
test "S7508A-05-DECLARATION-AFTER-ENACTMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert qualified_taxpayer_principal_residence_in_disaster_area(entity_ref("urn:us:irc:administration:clir#Victim1")) { id "f0"; origin case_input; }
        assert disaster_declaration_incident_date(entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-08-01) { id "f1"; origin case_input; }
        assert disaster_declaration_issued_on(entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-08-05) { id "f2"; origin case_input; }
        assert pl_119_29_enactment_date(@2026-07-01) { id "f3"; origin case_input; }
    }
    evaluate truth(declared_after_pl_119_29(entity_ref("urn:us:irc:administration:clir#Disaster1")));
    expect truth_status == TRUE_ONLY;
}
