// --- PL 119-29 §2(a): State-declared disasters ---
test "S7508A-14-STATE-DECLARED-DISASTER-VALID-EXERCISE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert governor_written_request(entity_ref("urn:us:irc:administration:clir#StateDisaster1")) { id "f0"; origin case_input; }
        assert governor_determines_damage_warrants_relief(entity_ref("urn:us:irc:administration:clir#StateDisaster1")) { id "f1"; origin case_input; }
        assert fema_administrator_consulted(entity_ref("urn:us:irc:administration:clir#StateDisaster1")) { id "f2"; origin case_input; }
        assert state_declaration_made_on(entity_ref("urn:us:irc:administration:clir#StateDisaster1"), @2026-08-05) { id "f3"; origin case_input; }
        assert pl_119_29_enactment_date(@2026-07-01) { id "f4"; origin case_input; }
        assert secretary_applies_rules_to_state_declared_disaster(entity_ref("urn:us:irc:administration:clir#StateDisaster1")) { id "f5"; origin case_input; }
    }
    evaluate truth(state_declared_disaster_treated_as_disaster(entity_ref("urn:us:irc:administration:clir#StateDisaster1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}
