        assert election_444_in_effect(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026")) { id "f2"; origin case_input; }
        assert base_year_of(entity_ref("urn:us:irc:administration:clir#Y2026"), entity_ref("urn:us:irc:administration:clir#Y2025")) { id "f3"; origin case_input; }
        assert base_year_of_some_election_year(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025")) { id "f4"; origin case_input; }
        assert section_702a_or_1366a_items_total(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 100000.00 USD) { id "f5"; origin case_input; }
        assert guaranteed_payments_deducted_in_items(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 20000.00 USD) { id "f6"; origin case_input; }
        assert deferral_period_months(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 3) { id "f7"; origin case_input; }
        assert taxable_year_months(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 12) { id "f8"; origin case_input; }
        assert owner_payment(entity_ref("urn:us:irc:administration:clir#Pay1"), entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), IncludibleInOwnerGrossIncome, DuringDeferralPeriod, 10000.00 USD) { id "f9"; origin case_input; }
        assert owner_payment(entity_ref("urn:us:irc:administration:clir#Pay2"), entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), IncludibleInOwnerGrossIncome, OutsideDeferralPeriod, 5000.00 USD) { id "f10"; origin case_input; }
        assert owner_payment(entity_ref("urn:us:irc:administration:clir#Pay3"), entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), SCorporationDividend, OutsideDeferralPeriod, 3000.00 USD) { id "f11"; origin case_input; }
        assert election_year_begins_in_calendar_year(entity_ref("urn:us:irc:administration:clir#Y2026"), 2026) { id "f12"; origin case_input; }
        assert highest_section_1_rate_at_end_of_base_year(entity_ref("urn:us:irc:administration:clir#Y2026"), 0.37) { id "f13"; origin case_input; }
        assert aggregate_required_payments_preceding_years(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 3000.00 USD) { id "f14"; origin case_input; }
        assert aggregate_refunds_preceding_years(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026"), 2000.00 USD) { id "f15"; origin case_input; }
        assert election_444_terminated_effective(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026")) { id "f16"; origin case_input; }
    }
    evaluate truth(no_interest_on_refund_of_7519_payment(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026")));
    expect truth_status == TRUE_ONLY;
}
