test "S7519-01-PARTNERSHIP-NET-INCOME-ADDS-BACK-GUARANTEED-PAYMENTS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert entity_is_partnership_or_s_corporation(entity_ref("urn:us:irc:administration:clir#Entity1")) { id "f0"; origin case_input; }
        assert entity_is_partnership(entity_ref("urn:us:irc:administration:clir#Entity1")) { id "f1"; origin case_input; }
        assert election_444_in_effect(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2026")) { id "f2"; origin case_input; }
        assert base_year_of(entity_ref("urn:us:irc:administration:clir#Y2026"), entity_ref("urn:us:irc:administration:clir#Y2025")) { id "f3"; origin case_input; }
        assert base_year_of_some_election_year(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025")) { id "f4"; origin case_input; }
        assert section_702a_or_1366a_items_total(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 100000.00 USD) { id "f5"; origin case_input; }
        assert guaranteed_payments_deducted_in_items(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 20000.00 USD) { id "f6"; origin case_input; }
    }
    evaluate truth(net_income_for_base_year(entity_ref("urn:us:irc:administration:clir#Entity1"), entity_ref("urn:us:irc:administration:clir#Y2025"), 120000.00 USD));
    expect truth_status == TRUE_ONLY;
}
