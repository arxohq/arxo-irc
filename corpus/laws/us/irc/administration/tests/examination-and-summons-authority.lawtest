        assert entry_necessary_for_examining_articles(entity_ref("urn:us:irc:administration:clir#Premises1")) { id "f1"; origin case_input; }
        assert secretary_enters_premises_in_daytime(entity_ref("urn:us:irc:administration:clir#Premises1")) { id "f2"; origin case_input; }
    }
    evaluate truth(daytime_entry_authorized(entity_ref("urn:us:irc:administration:clir#Premises1")));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}
