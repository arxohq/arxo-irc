        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert communication_between(entity_ref("urn:us:irc:administration:clir#Comm1"), entity_ref("urn:us:irc:administration:clir#Taxpayer1"), entity_ref("urn:us:irc:administration:clir#Cpa1")) { id "f0"; origin case_input; }
        assert authorized_under_federal_law_to_practice_before_irs(entity_ref("urn:us:irc:administration:clir#Cpa1")) { id "f1"; origin case_input; }
        assert communication_is_tax_advice(entity_ref("urn:us:irc:administration:clir#Comm1")) { id "f2"; origin case_input; }
        assert communication_would_be_privileged_with_attorney(entity_ref("urn:us:irc:administration:clir#Comm1")) { id "f3"; origin case_input; }
        assert asserted_in_noncriminal_matter_before_irs(entity_ref("urn:us:irc:administration:clir#Comm1")) { id "f4"; origin case_input; }
        assert written_communication_in_tax_shelter_promotion(entity_ref("urn:us:irc:administration:clir#Comm1")) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect not position(S7525PractitionerPrivilege, ACTIVE);
}
test "S7525-05-PRACTITIONER-DEFINITION" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert authorized_under_federal_law_to_practice_before_irs(entity_ref("urn:us:irc:administration:clir#Cpa1")) { id "f0"; origin case_input; }
    }
    evaluate truth(federally_authorized_tax_practitioner(entity_ref("urn:us:irc:administration:clir#Cpa1")));
    expect truth_status == TRUE_ONLY;
}
