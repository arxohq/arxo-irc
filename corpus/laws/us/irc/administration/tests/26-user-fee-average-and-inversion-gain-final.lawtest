// Final TECH_GAP pass (26.09.2026): sections 7528(b)(2)(C)(iii) (G6892) and 7874(d)(2) (G6893). NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

test "S7528C3-01-AVERAGE-EXCLUDES-THE-EXEMPT-REQUEST" {
    // fees 400, 300 and 0 (the third exempt under (B)): the average is 350, not 233.33.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fee_charged_for_request(entity_ref("urn:test:s7528:1#r1"), EmployeePlanDetermination, 400 USD) { origin case_input; }
        assert "f1": fee_charged_for_request(entity_ref("urn:test:s7528:1#r2"), EmployeePlanDetermination, 300 USD) { origin case_input; }
        assert "f2": fee_charged_for_request(entity_ref("urn:test:s7528:1#r3"), EmployeePlanDetermination, 0 USD) { origin case_input; }
        assert "f3": request_for_determination_letter_on_plan_qualification(entity_ref("urn:test:s7528:1#r3"), Pension) { origin case_input; }
        assert "f4": plan_maintained_solely_by_eligible_employers(entity_ref("urn:test:s7528:1#r3")) { origin case_input; }
        assert "f5": employer_is_eligible_employer_at_request(entity_ref("urn:test:s7528:1#r3")) { origin case_input; }
    }
    evaluate truth(average_fee_charged_excluding_exempt(EmployeePlanDetermination, 350.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7528C3-02-AVERAGE-NOT-BELOW-THE-FLOOR-WHEN-THE-EXEMPT-REQUEST-IS-IGNORED" {
    // average 350 against the floor 300: not below (with the exempt 0 counted it would be).
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fee_charged_for_request(entity_ref("urn:test:s7528:2#r1"), EmployeePlanDetermination, 400 USD) { origin case_input; }
        assert "f1": fee_charged_for_request(entity_ref("urn:test:s7528:2#r2"), EmployeePlanDetermination, 300 USD) { origin case_input; }
        assert "f2": fee_charged_for_request(entity_ref("urn:test:s7528:2#r3"), EmployeePlanDetermination, 0 USD) { origin case_input; }
        assert "f3": request_for_determination_letter_on_plan_qualification(entity_ref("urn:test:s7528:2#r3"), Pension) { origin case_input; }
        assert "f4": plan_maintained_solely_by_eligible_employers(entity_ref("urn:test:s7528:2#r3")) { origin case_input; }
        assert "f5": employer_is_eligible_employer_at_request(entity_ref("urn:test:s7528:2#r3")) { origin case_input; }
    }
    evaluate truth(average_fee_below_floor(EmployeePlanDetermination));
    expect truth_status == NEITHER;
}

test "S7528C3-03-AVERAGE-BELOW-THE-FLOOR" {
    // fees 200, 300 and 0 (exempt): average 250 below the floor 300.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": fee_charged_for_request(entity_ref("urn:test:s7528:3#r1"), EmployeePlanDetermination, 200 USD) { origin case_input; }
        assert "f1": fee_charged_for_request(entity_ref("urn:test:s7528:3#r2"), EmployeePlanDetermination, 300 USD) { origin case_input; }
        assert "f2": fee_charged_for_request(entity_ref("urn:test:s7528:3#r3"), EmployeePlanDetermination, 0 USD) { origin case_input; }
        assert "f3": request_for_determination_letter_on_plan_qualification(entity_ref("urn:test:s7528:3#r3"), Pension) { origin case_input; }
        assert "f4": plan_maintained_solely_by_eligible_employers(entity_ref("urn:test:s7528:3#r3")) { origin case_input; }
        assert "f5": employer_is_eligible_employer_at_request(entity_ref("urn:test:s7528:3#r3")) { origin case_input; }
    }
    evaluate truth(average_fee_below_floor(EmployeePlanDetermination));
    expect truth_status == TRUE_ONLY;
}

test "S7528C3-04-ASSERTED-AVERAGE-WHEN-NO-PER-REQUEST-FEE" {
    // no per-request fee: the asserted average stands.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": average_fee_charged(EmployeePlanDetermination, 250.00 USD) { origin case_input; }
    }
    evaluate truth(average_fee_below_floor(EmployeePlanDetermination));
    expect truth_status == TRUE_ONLY;
}

test "S7874D2-01-INVERSION-GAIN-IS-THE-QUALIFYING-ITEMS-ONLY" {
    // two items in the applicable period: to a foreign related person (qualifies, 300) and to an unrelated foreign person (does not, 500): the gain is 300.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": expatriated_entity(entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f1": year_includes_applicable_period_portion(entity_ref("urn:test:s7874:1#x"), entity_ref("urn:test:s7874:1#y")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s7874:1#y"), @2024-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:s7874:1#y"), @2024-12-31) { origin case_input; }
        assert "f4": applicable_period(entity_ref("urn:test:s7874:1#x"), entity_ref("urn:test:s7874:1#e"), entity_ref("urn:test:s7874:1#d"), @2023-01-01, @2033-12-31) { origin case_input; }
        assert "f5": item_of_entity(entity_ref("urn:test:s7874:1#t1"), entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f6": item_date(entity_ref("urn:test:s7874:1#t1"), @2024-06-01) { origin case_input; }
        assert "f7": item_counterparty(entity_ref("urn:test:s7874:1#t1"), entity_ref("urn:test:s7874:1#p1")) { origin case_input; }
        assert "f8": foreign_person(entity_ref("urn:test:s7874:1#p1")) { origin case_input; }
        assert "f9": related_under_267b_or_707b1(entity_ref("urn:test:s7874:1#p1"), entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f10": item_income_or_gain(entity_ref("urn:test:s7874:1#t1"), 300 USD) { origin case_input; }
        assert "f11": item_of_entity(entity_ref("urn:test:s7874:1#t2"), entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f12": item_date(entity_ref("urn:test:s7874:1#t2"), @2024-07-01) { origin case_input; }
        assert "f13": item_counterparty(entity_ref("urn:test:s7874:1#t2"), entity_ref("urn:test:s7874:1#p2")) { origin case_input; }
        assert "f14": foreign_person(entity_ref("urn:test:s7874:1#p2")) { origin case_input; }
        assert "f15": item_income_or_gain(entity_ref("urn:test:s7874:1#t2"), 500 USD) { origin case_input; }
    }
    evaluate truth(inversion_gain_computed(entity_ref("urn:test:s7874:1#x"), entity_ref("urn:test:s7874:1#y"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7874D2-02-ITEM-OUTSIDE-THE-YEAR-IS-NOT-COUNTED" {
    // the qualifying item is dated in 2025, the year is 2024: gain 0.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": expatriated_entity(entity_ref("urn:test:s7874:2#x")) { origin case_input; }
        assert "f1": year_includes_applicable_period_portion(entity_ref("urn:test:s7874:2#x"), entity_ref("urn:test:s7874:2#y")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s7874:2#y"), @2024-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:s7874:2#y"), @2024-12-31) { origin case_input; }
        assert "f4": applicable_period(entity_ref("urn:test:s7874:2#x"), entity_ref("urn:test:s7874:2#e"), entity_ref("urn:test:s7874:2#d"), @2023-01-01, @2033-12-31) { origin case_input; }
        assert "f5": item_of_entity(entity_ref("urn:test:s7874:2#t1"), entity_ref("urn:test:s7874:2#x")) { origin case_input; }
        assert "f6": item_date(entity_ref("urn:test:s7874:2#t1"), @2025-02-01) { origin case_input; }
        assert "f7": item_counterparty(entity_ref("urn:test:s7874:2#t1"), entity_ref("urn:test:s7874:2#p1")) { origin case_input; }
        assert "f8": foreign_person(entity_ref("urn:test:s7874:2#p1")) { origin case_input; }
        assert "f9": related_under_267b_or_707b1(entity_ref("urn:test:s7874:2#p1"), entity_ref("urn:test:s7874:2#x")) { origin case_input; }
        assert "f10": item_income_or_gain(entity_ref("urn:test:s7874:2#t1"), 300 USD) { origin case_input; }
    }
    evaluate truth(inversion_gain_computed(entity_ref("urn:test:s7874:2#x"), entity_ref("urn:test:s7874:2#y"), 0.00 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7874D2-03-FLOOR-READS-THE-COMPUTED-GAIN" {
    // taxable income before the floor 100, computed inversion gain 300: taxable income after the floor 300.
    given {
        context {
            legal_time @2025-04-15;
            decision_time @2025-04-15T09:00:00-05:00;
            knowledge_time @2025-04-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": expatriated_entity(entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f1": year_includes_applicable_period_portion(entity_ref("urn:test:s7874:1#x"), entity_ref("urn:test:s7874:1#y")) { origin case_input; }
        assert "f2": us.irc.core::begins(entity_ref("urn:test:s7874:1#y"), @2024-01-01) { origin case_input; }
        assert "f3": us.irc.core::ends(entity_ref("urn:test:s7874:1#y"), @2024-12-31) { origin case_input; }
        assert "f4": applicable_period(entity_ref("urn:test:s7874:1#x"), entity_ref("urn:test:s7874:1#e"), entity_ref("urn:test:s7874:1#d"), @2023-01-01, @2033-12-31) { origin case_input; }
        assert "f5": item_of_entity(entity_ref("urn:test:s7874:1#t1"), entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f6": item_date(entity_ref("urn:test:s7874:1#t1"), @2024-06-01) { origin case_input; }
        assert "f7": item_counterparty(entity_ref("urn:test:s7874:1#t1"), entity_ref("urn:test:s7874:1#p1")) { origin case_input; }
        assert "f8": foreign_person(entity_ref("urn:test:s7874:1#p1")) { origin case_input; }
        assert "f9": related_under_267b_or_707b1(entity_ref("urn:test:s7874:1#p1"), entity_ref("urn:test:s7874:1#x")) { origin case_input; }
        assert "f10": item_income_or_gain(entity_ref("urn:test:s7874:1#t1"), 300 USD) { origin case_input; }
        assert "f11": taxable_income_before_floor(entity_ref("urn:test:s7874:3#x"), entity_ref("urn:test:s7874:3#y"), 100 USD) { origin case_input; }
    }
    evaluate truth(taxable_income_after_floor(entity_ref("urn:test:s7874:3#x"), entity_ref("urn:test:s7874:3#y"), 300.00 USD));
    expect truth_status == TRUE_ONLY;
}
