test "S7502-09-DESIGNATED-DELIVERY-SERVICE-RECORD-IS-POSTMARK-DATE" {
    given {
        context { decision_time @2026-04-20T09:00:00-04:00; knowledge_time @2026-04-20T09:00:00-04:00; legal_time @2026-04-20; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert prescribed_filing_date(entity_ref("urn:us:irc:administration:clir#Return9"), @2026-04-15) { id "f0"; origin case_input; }
        assert delivery_service_available_to_general_public(entity_ref("urn:us:irc:administration:clir#FedEx")) { id "f1"; origin case_input; }
        assert delivery_service_timely_and_reliable(entity_ref("urn:us:irc:administration:clir#FedEx")) { id "f2"; origin case_input; }
        assert delivery_service_records_delivery_date(entity_ref("urn:us:irc:administration:clir#FedEx")) { id "f3"; origin case_input; }
        assert designates_delivery_service(entity_ref("urn:us:irc:administration:clir#FedEx")) { id "f4"; origin case_input; }
        assert item_recorded_by_service_on(entity_ref("urn:us:irc:administration:clir#Return9"), entity_ref("urn:us:irc:administration:clir#FedEx"), @2026-04-15) { id "f5"; origin case_input; }
        assert deposited_in_us_mail_properly_addressed(entity_ref("urn:us:irc:administration:clir#Return9")) { id "f6"; origin case_input; }
    }
    evaluate why_not(timely_filed_by_mailing(entity_ref("urn:us:irc:administration:clir#Return9"), @2026-04-15, @2026-04-15));
    expect truth_status == NEITHER;
}
