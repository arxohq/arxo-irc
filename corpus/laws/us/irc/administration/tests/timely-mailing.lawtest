// Scenarios for 26 U.S.C. §7502, module 01-timely-mailing.law. Written from
// the text; NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction)
// — `implemented_unverified` per docs/foundations/us-irc/AGENT-BRIEF.md.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

test "S7502-01-POSTMARK-ON-DUE-DATE-IS-TIMELY" {
    given {
        context { decision_time @2026-04-20T09:00:00-04:00; knowledge_time @2026-04-20T09:00:00-04:00; legal_time @2026-04-20; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert prescribed_filing_date(entity_ref("urn:us:irc:administration:clir#Return1"), @2026-04-15) { id "f0"; origin case_input; }
        assert postmarked_on(entity_ref("urn:us:irc:administration:clir#Return1"), @2026-04-15) { id "f1"; origin case_input; }
        assert deposited_in_us_mail_properly_addressed(entity_ref("urn:us:irc:administration:clir#Return1")) { id "f2"; origin case_input; }
    }
    evaluate truth(timely_filed_by_mailing(entity_ref("urn:us:irc:administration:clir#Return1"), @2026-04-15, @2026-04-15));
    expect truth_status == TRUE_ONLY;
}

