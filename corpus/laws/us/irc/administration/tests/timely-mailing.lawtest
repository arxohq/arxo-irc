        assert postmarked_on(entity_ref("urn:us:irc:administration:clir#Return2"), @2026-04-16) { id "f1"; origin case_input; }
        assert deposited_in_us_mail_properly_addressed(entity_ref("urn:us:irc:administration:clir#Return2")) { id "f2"; origin case_input; }
    }
    evaluate truth(timely_filed_by_mailing(entity_ref("urn:us:irc:administration:clir#Return2"), @2026-04-15, @2026-04-16));
    expect truth_status == NEITHER;
}

