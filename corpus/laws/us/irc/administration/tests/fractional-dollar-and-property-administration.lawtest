    }
    evaluate truth(fractional_dollar_rounded_amount(DeficiencyOrUnderpaymentCollection, 100.50 USD, 101 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7504-03-NOT-IN-FORCE-UNTIL-SECRETARY-PRESCRIBES" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert raw_amount_at_issue(CreditOrRefundAllowance, 100.75 USD) { id "f0"; origin case_input; }
    }
    evaluate truth(fractional_dollar_rounded_amount(CreditOrRefundAllowance, 100.75 USD, 101 USD));
    expect truth_status == NEITHER;
}

