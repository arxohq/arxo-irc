// --- §7504: fractional dollar rounding -----------------------------------

test "S7504-01-DISREGARD-UNDER-50-CENTS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert secretary_prescribes_fractional_dollar_regulation(CreditOrRefundAllowance) { id "f0"; origin case_input; }
        assert raw_amount_at_issue(CreditOrRefundAllowance, 100.49 USD) { id "f1"; origin case_input; }
    }
    evaluate truth(fractional_dollar_rounded_amount(CreditOrRefundAllowance, 100.49 USD, 100 USD));
    expect truth_status == TRUE_ONLY;
}

test "S7504-02-ROUND-UP-AT-50-CENTS" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
