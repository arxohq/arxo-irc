}

test "S7508A-04-MANDATORY-60-DAY-EXTENSION-FOR-QUALIFIED-TAXPAYER" {
    given {
        context { decision_time @2026-10-01T09:00:00-04:00; knowledge_time @2026-10-01T09:00:00-04:00; legal_time @2026-10-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert qualified_taxpayer_principal_residence_in_disaster_area(entity_ref("urn:us:irc:administration:clir#Victim4")) { id "f0"; origin case_input; }
        assert disaster_declaration_incident_date(entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-08-01) { id "f1"; origin case_input; }
        assert disaster_declaration_issued_on(entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-08-05) { id "f2"; origin case_input; }
        assert candidate_60_day_extension_end(entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-10-04) { id "f3"; origin case_input; }
        assert act_originally_due(entity_ref("urn:us:irc:administration:clir#Victim4"), FilingReturn, @2026-08-15) { id "f4"; origin case_input; }
        assert performed_on(entity_ref("urn:us:irc:administration:clir#Victim4"), FilingReturn, @2026-09-25) { id "f5"; origin case_input; }
    }
    evaluate truth(mandatory_deadline_postponed(entity_ref("urn:us:irc:administration:clir#Victim4"), FilingReturn, entity_ref("urn:us:irc:administration:clir#Disaster1"), @2026-08-15, @2026-09-25));
    expect truth_status == TRUE_ONLY;
}
