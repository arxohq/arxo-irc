// Scenarios for 26 U.S.C. §7508 and §7508A, module
// 03-combat-zone-and-disaster-postponement.law. NOT executed in this stage —
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

// --- §7508: combat zone tolling arithmetic (180 days + days remaining) ------

test "S7508-01-DISREGARDED-DAYS-SERVICE-ONLY-NO-HOSPITALIZATION" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // 90 days of service (2026-01-01 to 2026-03-31) + 180 days = 270.
        assert combat_zone_or_contingency_service(entity_ref("urn:us:irc:administration:clir#Soldier1"), @2026-01-01, @2026-03-31) { id "f0"; origin case_input; }
    }
    evaluate truth(combat_zone_disregarded_days(entity_ref("urn:us:irc:administration:clir#Soldier1"), 269));
    expect truth_status == TRUE_ONLY;
}

test "S7508-02-DEADLINE-POSTPONED-WITHIN-ALLOWANCE" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert combat_zone_or_contingency_service(entity_ref("urn:us:irc:administration:clir#Soldier2"), @2026-01-01, @2026-01-31) { id "f0"; origin case_input; }
        assert act_originally_due(entity_ref("urn:us:irc:administration:clir#Soldier2"), FilingReturn, @2026-04-15) { id "f1"; origin case_input; }
        // 30 days service + 180 = 210 allowed days after 2026-04-15.
        assert performed_on(entity_ref("urn:us:irc:administration:clir#Soldier2"), FilingReturn, @2026-06-01) { id "f2"; origin case_input; }
    }
    evaluate truth(deadline_postponed(entity_ref("urn:us:irc:administration:clir#Soldier2"), FilingReturn, @2026-04-15, @2026-06-01));
    expect truth_status == TRUE_ONLY;
}

test "S7508-03-JEOPARDY-ASSESSMENT-EXCEPTION-BLOCKS-POSTPONEMENT" {
    given {
        context { decision_time @2026-06-01T09:00:00-04:00; knowledge_time @2026-06-01T09:00:00-04:00; legal_time @2026-06-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert combat_zone_or_contingency_service(entity_ref("urn:us:irc:administration:clir#Soldier3"), @2026-01-01, @2026-01-31) { id "f0"; origin case_input; }
        assert act_originally_due(entity_ref("urn:us:irc:administration:clir#Soldier3"), AssessmentOfTax, @2026-04-15) { id "f1"; origin case_input; }
        assert performed_on(entity_ref("urn:us:irc:administration:clir#Soldier3"), AssessmentOfTax, @2026-06-01) { id "f2"; origin case_input; }
        assert jeopardy_or_title11_or_transferred_assets_action(entity_ref("urn:us:irc:administration:clir#Soldier3")) { id "f3"; origin case_input; }
    }
    evaluate truth(deadline_postponed(entity_ref("urn:us:irc:administration:clir#Soldier3"), AssessmentOfTax, @2026-04-15, @2026-06-01));
    expect truth_status == NEITHER;
}

// --- §7508A: disaster postponement, valid and invalid exercise --------------

test "S7508A-01-VALID-EXERCISE-WITHIN-ONE-YEAR" {
    given {
        context { decision_time @2026-10-01T09:00:00-04:00; knowledge_time @2026-10-01T09:00:00-04:00; legal_time @2026-10-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert taxpayer_determined_affected_by_covered_event(entity_ref("urn:us:irc:administration:clir#Victim1"), FederallyDeclaredDisaster) { id "f0"; origin case_input; }
        assert secretary_specifies_postponement_period(entity_ref("urn:us:irc:administration:clir#Victim1"), FederallyDeclaredDisaster, 90) { id "f1"; origin case_input; }
    }
    evaluate truth(postponement_period_specified(entity_ref("urn:us:irc:administration:clir#Victim1"), FederallyDeclaredDisaster, 90));
    expect truth_status == TRUE_ONLY;
    expect not issue(POWER_INVALID_EXERCISE);
}

test "S7508A-02-INVALID-EXERCISE-WITHOUT-SECRETARY-DETERMINATION" {
    given {
        context { decision_time @2026-10-01T09:00:00-04:00; knowledge_time @2026-10-01T09:00:00-04:00; legal_time @2026-10-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        // No taxpayer_determined_affected_by_covered_event fact.
        assert secretary_specifies_postponement_period(entity_ref("urn:us:irc:administration:clir#Victim2"), FederallyDeclaredDisaster, 90) { id "f0"; origin case_input; }
    }
    evaluate truth(postponement_period_specified(entity_ref("urn:us:irc:administration:clir#Victim2"), FederallyDeclaredDisaster, 90));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

test "S7508A-03-PERIOD-OVER-ONE-YEAR-EXCEEDS-STATUTORY-CAP" {
    given {
        context { decision_time @2026-10-01T09:00:00-04:00; knowledge_time @2026-10-01T09:00:00-04:00; legal_time @2026-10-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
