        assert pr_education_expenditures(2021, 1500000.00 USD) { id "f3"; origin case_input; }
        assert pr_required_information_received_on(2021, @2021-09-01) { id "f4"; origin case_input; }
        assert pr_individual_return_due_date(2021, @2022-04-15) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(S7530PayPuertoRicoBeforeReturnDueDate, ACTIVE);
}
test "S7530-27-PR-PAYMENT-WINDOW-VIOLATED-AFTER-RETURN-DUE-DATE" {
    given {
        context { decision_time @2022-05-01T09:00:00-04:00; knowledge_time @2022-05-01T09:00:00-04:00; legal_time @2022-05-01; timezone "America/New_York"; deadline_policy us.irc.core::IRC_CALENDAR_STEP; }
        assert pr_eitc_cost_for_2019(150000000.00 USD) { id "f0"; origin case_input; }
        assert pr_eitc_cost_for_calendar_year(2021, 300000000.00 USD) { id "f1"; origin case_input; }
        assert pr_has_qualifying_eitc(2021) { id "f2"; origin case_input; }
        assert pr_education_expenditures(2021, 1500000.00 USD) { id "f3"; origin case_input; }
        assert pr_required_information_received_on(2021, @2021-09-01) { id "f4"; origin case_input; }
        assert pr_individual_return_due_date(2021, @2022-04-15) { id "f5"; origin case_input; }
    }
    evaluate positions();
    expect position(S7530PayPuertoRicoBeforeReturnDueDate, VIOLATED);
}
