        assert substantially_all_harvesting_by_tribe_members(entity_ref("urn:us:irc:administration:clir#Activity1")) { id "f2"; origin case_input; }
        assert activity_of_tribe(entity_ref("urn:us:irc:administration:clir#Activity1"), entity_ref("urn:us:irc:administration:clir#Tribe3")) { id "f3"; origin case_input; }
