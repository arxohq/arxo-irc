// 26 U.S.C. §§7601, 7602, 7603, 7604, 7605, 7606, 7610 — canvass of districts,
// examination and summons authority, service, enforcement, time and place,
// entry, fees and mileage. (§7607 is repealed: only its heading remains.)
// STAGE 3.
//
// JUDGMENT CALLS
//  - §7601(a) "to the extent he deems practicable" is the Secretary's own
//    practicability judgment (external judgment relation); the duty arises
//    only when the Secretary has found the canvass practicable.
//  - "Relevant or material" (§7602(a)(1)-(3)) is an external judgment of the
//    court that would enforce the summons (authority DistrictCourt,
//    DECISION-0194), not a case fact.
//  - §7602(d)(1) "with respect to any person": read as the person whose
//    liability for the tax and period is at issue (the summons matter's
//    taxpayer), separately per taxable period and per chapter ((d)(3)).
//  - §7602(c) periodic record: a `maintenance` goal (TECH-GAPS G3000).
//  - §7605(a): the ten-day minimum is measured with `days_between`
//    (summons date to appearance date); "reasonable" time and place is
//    a case fact (relation `time_and_place_reasonable`).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    DistrictCourt,
    IRC_S7601_A,
    IRC_S7602_A,
    IRC_S7602_B,
    IRC_S7602_C,
    IRC_S7602_D,
    IRC_S7602_E,
    IRC_S7602_F,
    IRC_S7603_A,
    IRC_S7603_B,
    IRC_S7604_A,
    IRC_S7604_B,
    IRC_S7605_A,
    IRC_S7605_B,
    IRC_S7606_A,
    IRC_S7606_B,
    IRC_S7610_A,
    IRC_S7610_B,
    IRS,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// --- §7601: canvass of districts -------------------------------------------------

external judgment relation canvass_practicable(o: Organ) {
    authority Secretary;
    label en unofficial "the Secretary deems it practicable to cause Treasury officers to canvass each internal revenue district (§7601(a))";
}
relation secretary_causes_district_canvass(o: Organ) kind empirical {
    label en unofficial "the Secretary causes Treasury officers or employees to proceed from time to time through each internal revenue district and inquire after persons who may be liable to pay internal revenue tax and persons owning or managing objects taxed";
}
@source(IRC_S7601_A, relation = formalizes, coverage = exact, quote = "The Secretary shall, to the extent he deems it practicable, cause officers or employees of the Treasury Department to proceed, from time to time, through each internal revenue district and inquire after and concerning all persons therein who may be liable to pay any internal revenue tax")
rule S7601CanvassDuty defeasible {
    for o: Organ;
    when canvass_practicable(o);
    then duty S7601CanvassDistricts {
        bearer Secretary;
        goal maintenance {
            condition secretary_causes_district_canvass(o);
            window [-infinity, infinity];
        }
    };
}

// --- §7602: examination of books and witnesses -----------------------------------------

entity TaxInquiry {
    label en unofficial "an inquiry of the Secretary for one of the purposes listed in §7602(a): the correctness of a return, making a return, liability of a person or of a transferee or fiduciary, collection, or (b) an offense connected with administration or enforcement";
}
entity SummonsDoc {
    label en unofficial "a summons issued under §7602 (or §§6420(e)(2), 6421(g)(2), 6427(j)(2))";
}
enum InquiryPurpose {
    AscertainCorrectnessOfReturn;
    MakeReturnWhereNoneMade;
    DetermineTaxLiability;
    DetermineTransfereeOrFiduciaryLiability;
    CollectTaxLiability;
    InquireIntoOffenseConnectedWithTaxAdministration;
}
relation inquiry_purpose(inq: TaxInquiry, p: InquiryPurpose) kind empirical {
    label en unofficial "the purpose of the inquiry";
}
relation inquiry_matter(inq: TaxInquiry, t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the inquiry concerns this person, taxable period and tax imposed by a separate chapter";
}
relation summons_for_inquiry(s: SummonsDoc, inq: TaxInquiry) kind empirical {
    label en unofficial "the summons issues for the inquiry";
}
relation summons_directed_to(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the person summoned: the person liable, an officer or employee of such a person, a custodian of books of account, or any other person the Secretary may deem proper";
}
external judgment relation summons_relevant_or_material(s: SummonsDoc) {
    authority DistrictCourt;
    label en unofficial "the books, papers, records, data or testimony sought are relevant or material to the inquiry (§7602(a)(2))";
}
relation inquiry_purpose_authorized(inq: TaxInquiry) kind derived {
    label en unofficial "the inquiry is for one of the purposes of §7602(a) or (b)";
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "For the purpose of ascertaining the correctness of any return, making a return where none has been made, determining the liability of any person for any internal revenue tax")
rule S7602PurposeCorrectness strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, AscertainCorrectnessOfReturn);
    then inquiry_purpose_authorized(inq);
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "making a return where none has been made")
rule S7602PurposeMakeReturn strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, MakeReturnWhereNoneMade);
    then inquiry_purpose_authorized(inq);
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "determining the liability of any person for any internal revenue tax")
rule S7602PurposeLiability strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, DetermineTaxLiability);
    then inquiry_purpose_authorized(inq);
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "the liability at law or in equity of any transferee or fiduciary of any person in respect of any internal revenue tax")
rule S7602PurposeTransferee strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, DetermineTransfereeOrFiduciaryLiability);
    then inquiry_purpose_authorized(inq);
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "or collecting any such liability")
rule S7602PurposeCollect strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, CollectTaxLiability);
    then inquiry_purpose_authorized(inq);
}
@source(IRC_S7602_B, relation = formalizes, coverage = exact, quote = "include the purpose of inquiring into any offense connected with the administration or enforcement of the internal revenue laws")
rule S7602PurposeOffense strict {
    for inq: TaxInquiry;
    when inquiry_purpose(inq, InquireIntoOffenseConnectedWithTaxAdministration);
    then inquiry_purpose_authorized(inq);
}

// §7602(d): Justice Department referral
relation secretary_recommended_grand_jury_or_prosecution(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the Secretary has recommended to the Attorney General a grand jury investigation of, or the criminal prosecution of, the person for an offense connected with administration or enforcement of the internal revenue laws";
}
relation request_under_6103h3B_for_return_information(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "a request is made under section 6103(h)(3)(B) for disclosure of return or return information relating to the person";
}
relation attorney_general_written_notice_no_prosecution_or_no_grand_jury(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the Attorney General notifies the Secretary in writing that he will not prosecute, will not authorize a grand jury investigation, or will discontinue such an investigation";
}
relation final_disposition_of_criminal_proceeding(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "a final disposition has been made of a criminal proceeding instituted by the Attorney General against the person";
}
relation attorney_general_written_notice_on_6103_request(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind empirical {
    label en unofficial "the Attorney General notifies the Secretary in writing that he will not prosecute for an offense relating to the section 6103(h)(3)(B) request";
}
relation justice_department_referral_terminated(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind derived {
    label en unofficial "the referral has ceased under §7602(d)(2)(B)";
}
pub relation justice_department_referral_in_effect(t: Person, y: TaxableYear, k: us.irc.core::TaxKind) kind institutional {
    label en unofficial "a Justice Department referral is in effect with respect to the person for the taxable period and chapter (§7602(d)(2)-(3))";
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "the Attorney General notifies the Secretary, in writing, that—")
rule S7602ReferralTerminatedByAttorneyGeneral strict {
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when attorney_general_written_notice_no_prosecution_or_no_grand_jury(t, y, k);
    then justice_department_referral_terminated(t, y, k);
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "a final disposition has been made of any criminal proceeding pertaining to the enforcement of the internal revenue laws which was instituted by the Attorney General against such person")
rule S7602ReferralTerminatedByFinalDisposition strict {
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when final_disposition_of_criminal_proceeding(t, y, k);
    then justice_department_referral_terminated(t, y, k);
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "relating to the request described in subparagraph (A)(ii)")
rule S7602ReferralTerminatedOn6103Request strict {
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when attorney_general_written_notice_on_6103_request(t, y, k);
    then justice_department_referral_terminated(t, y, k);
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "the Secretary has recommended to the Attorney General a grand jury investigation of, or the criminal prosecution of, such person")
rule S7602ReferralByRecommendation strict {
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when secretary_recommended_grand_jury_or_prosecution(t, y, k)
        and not_known(justice_department_referral_terminated(t, y, k));
    then justice_department_referral_in_effect(t, y, k);
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "any request is made under section 6103(h)(3)(B) for the disclosure of any return or return information")
rule S7602ReferralBy6103Request strict {
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when request_under_6103h3B_for_return_information(t, y, k)
        and not_known(justice_department_referral_terminated(t, y, k));
    then justice_department_referral_in_effect(t, y, k);
}
relation summons_conditions_met(s: SummonsDoc) kind derived {
    label en unofficial "the summons's inquiry has an authorized purpose, its object is relevant or material, and no Justice Department referral is in effect for the matter";
}
relation secretary_issues_summons(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary issues the summons";
}
pub relation summons_in_force(s: SummonsDoc) kind institutional {
    label en unofficial "the summons is validly issued under §7602(a)(2)";
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "To summon the person liable for tax or required to perform the act, or any officer or employee of such person, or any person having possession, custody, or care of books of account containing entries relating to the business of the person liable for tax or required to perform the act, or any other person the Secretary may deem proper")
rule S7602SummonsConditions strict {
    for s: SummonsDoc;
    for inq: TaxInquiry;
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when summons_for_inquiry(s, inq)
        and inquiry_purpose_authorized(inq)
        and inquiry_matter(inq, t, y, k)
        and summons_relevant_or_material(s)
        and not_known(justice_department_referral_in_effect(t, y, k));
    then summons_conditions_met(s);
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "To summon the person liable for tax or required to perform the act")
rule S7602SummonsPower strict {
    for s: SummonsDoc;
    for p: Person;
    when secretary_issues_summons(s)
        and summons_directed_to(s, p);
    then power S7602IssueSummons {
        holder Secretary;
        over p;
        exercise secretary_issues_summons(s);
        valid_when summons_conditions_met(s);
        effect create(summons_in_force(s));
    };
}
@source(IRC_S7602_D, relation = formalizes, coverage = exact, quote = "No summons may be issued under this title, and the Secretary may not begin any action under section 7604 to enforce any summons, with respect to any person if a Justice Department referral is in effect with respect to such person.")
rule S7602SummonsWhileReferralProhibition strict {
    for s: SummonsDoc;
    for inq: TaxInquiry;
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when secretary_issues_summons(s)
        and summons_for_inquiry(s, inq)
        and inquiry_matter(inq, t, y, k)
        and justice_department_referral_in_effect(t, y, k);
    then prohibition S7602NoSummonsWhileJusticeDepartmentReferral {
        bearer Secretary;
        beneficiary t;
        action secretary_issues_summons(s);
        window [-infinity, infinity];
    };
}
relation secretary_examines_books(inq: TaxInquiry) kind empirical {
    label en unofficial "the Secretary examines books, papers, records or other data that may be relevant or material to the inquiry";
}
relation secretary_takes_testimony(inq: TaxInquiry) kind empirical {
    label en unofficial "the Secretary takes testimony of the person concerned, under oath, relevant or material to the inquiry";
}
pub relation examination_of_books_authorized(inq: TaxInquiry) kind institutional {
    label en unofficial "the examination of books is authorized under §7602(a)(1)";
}
pub relation testimony_taking_authorized(inq: TaxInquiry) kind institutional {
    label en unofficial "the taking of testimony under oath is authorized under §7602(a)(3)";
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "To examine any books, papers, records, or other data which may be relevant or material to such inquiry")
rule S7602ExaminePower strict {
    for inq: TaxInquiry;
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when secretary_examines_books(inq)
        and inquiry_matter(inq, t, y, k);
    then power S7602ExamineBooks {
        holder Secretary;
        over t;
        exercise secretary_examines_books(inq);
        valid_when inquiry_purpose_authorized(inq);
        effect create(examination_of_books_authorized(inq));
    };
}
@source(IRC_S7602_A, relation = formalizes, coverage = exact, quote = "To take such testimony of the person concerned, under oath, as may be relevant or material to such inquiry")
rule S7602TestimonyPower strict {
    for inq: TaxInquiry;
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when secretary_takes_testimony(inq)
        and inquiry_matter(inq, t, y, k);
    then power S7602TakeTestimony {
        holder Secretary;
        over t;
        exercise secretary_takes_testimony(inq);
        valid_when inquiry_purpose_authorized(inq);
        effect create(testimony_taking_authorized(inq));
    };
}

// §7602(c): third-party contacts
entity ThirdPartyContact {
    label en unofficial "a contact by an IRS officer or employee with a person other than the taxpayer with respect to the determination or collection of the taxpayer's liability";
}
entity ContactNotice {
    label en unofficial "a notice to the taxpayer that contacts with other persons are intended to be made during a specified period";
}
relation contact_with_person_other_than_taxpayer(c: ThirdPartyContact, t: Person, on: Date) kind empirical {
    label en unofficial "the IRS contacts a person other than the taxpayer, on this date, about the taxpayer's tax liability";
}
relation contact_notice_period(n: ContactNotice, t: Person, start: Date, stop: Date, given: Date) kind empirical {
    label en unofficial "the notice to the taxpayer specifies the period from start to stop and was provided on the given date";
}
relation secretary_provides_shorter_notice_period(n: ContactNotice) kind empirical {
    label en unofficial "the Secretary has otherwise provided that the notice need not be given 45 days before the period begins";
}
relation notice_period_not_over_one_year(n: ContactNotice) kind derived {
    label en unofficial "the specified period is not greater than 1 year";
}
relation notice_given_45_days_before_period(n: ContactNotice) kind derived {
    label en unofficial "the notice is provided at least 45 days before the beginning of the period, or the Secretary provides otherwise";
}
relation contact_notice_valid(n: ContactNotice) kind derived {
    label en unofficial "the notice satisfies §7602(c)(1): period not over 1 year, informs of intended contacts, timely given";
}
relation contact_covered_by_valid_notice(c: ThirdPartyContact) kind derived {
    label en unofficial "the contact occurs during the period of a valid notice";
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "unless such contact occurs during a period (not greater than 1 year) which is specified in a notice which—")
rule S7602NoticePeriodWithinOneYear strict {
    for n: ContactNotice;
    for t: Person;
    for start: Date;
    for stop: Date;
    for given: Date;
    when contact_notice_period(n, t, start, stop, given)
        and stop <= add_calendar_period(start, 1 calendar_year);
    then notice_period_not_over_one_year(n);
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "is provided to the taxpayer not later than 45 days before the beginning of such period")
rule S7602NoticeGiven45DaysBefore strict {
    for n: ContactNotice;
    for t: Person;
    for start: Date;
    for stop: Date;
    for given: Date;
    when contact_notice_period(n, t, start, stop, given)
        and add_calendar_period(given, 45 calendar_day) <= start;
    then notice_given_45_days_before_period(n);
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "except as otherwise provided by the Secretary")
rule S7602NoticeGivenPerSecretaryRule strict {
    for n: ContactNotice;
    when secretary_provides_shorter_notice_period(n);
    then notice_given_45_days_before_period(n);
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "informs the taxpayer that contacts with persons other than the taxpayer are intended to be made during such period")
rule S7602NoticeValid strict {
    for n: ContactNotice;
    when notice_period_not_over_one_year(n)
        and notice_given_45_days_before_period(n);
    then contact_notice_valid(n);
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "may not contact any person other than the taxpayer with respect to the determination or collection of the tax liability of such taxpayer unless such contact occurs during a period")
rule S7602ContactCovered strict {
    for c: ThirdPartyContact;
    for n: ContactNotice;
    for t: Person;
    for on: Date;
    for start: Date;
    for stop: Date;
    for given: Date;
    when contact_with_person_other_than_taxpayer(c, t, on)
        and contact_notice_period(n, t, start, stop, given)
        and contact_notice_valid(n)
        and on >= start
        and on <= stop;
    then contact_covered_by_valid_notice(c);
}
relation taxpayer_authorized_contact(c: ThirdPartyContact) kind empirical {
    label en unofficial "the taxpayer has authorized the contact (§7602(c)(3)(A))";
}
external judgment relation notice_would_jeopardize_collection_or_risk_reprisal(c: ThirdPartyContact) {
    authority Secretary;
    label en unofficial "the Secretary determines for good cause shown that notice would jeopardize collection of any tax or may involve reprisal against any person (§7602(c)(3)(B))";
}
relation pending_criminal_investigation_on_contact(c: ThirdPartyContact) kind empirical {
    label en unofficial "the contact is with respect to a pending criminal investigation (§7602(c)(3)(C))";
}
relation contact_without_valid_notice(c: ThirdPartyContact) kind derived {
    label en unofficial "the IRS contacts a person other than the taxpayer outside a valid notice period and no exception applies";
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "This subsection shall not apply—")
rule S7602ContactWithoutNotice strict {
    for c: ThirdPartyContact;
    for t: Person;
    for on: Date;
    when contact_with_person_other_than_taxpayer(c, t, on)
        and not_known(contact_covered_by_valid_notice(c))
        and not_known(taxpayer_authorized_contact(c))
        and not_known(notice_would_jeopardize_collection_or_risk_reprisal(c))
        and not_known(pending_criminal_investigation_on_contact(c));
    then contact_without_valid_notice(c);
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "An officer or employee of the Internal Revenue Service may not contact any person other than the taxpayer with respect to the determination or collection of the tax liability of such taxpayer")
rule S7602ThirdPartyContactProhibition strict {
    for c: ThirdPartyContact;
    for t: Person;
    for on: Date;
    when contact_without_valid_notice(c)
        and contact_with_person_other_than_taxpayer(c, t, on);
    then prohibition S7602NoThirdPartyContactWithoutNotice {
        bearer IRS;
        beneficiary t;
        action contact_without_valid_notice(c);
        window [-infinity, infinity];
    };
}
relation notice_issued_without_intent_to_contact(n: ContactNotice) kind empirical {
    label en unofficial "the notice was issued although at that time there was no intent to contact persons other than the taxpayer during the specified period";
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "A notice shall not be issued under this paragraph unless there is an intent at the time such notice is issued to contact persons other than the taxpayer during the period specified in such notice.")
rule S7602NoNoticeWithoutIntent strict {
    for n: ContactNotice;
    for t: Person;
    for start: Date;
    for stop: Date;
    for given: Date;
    when notice_issued_without_intent_to_contact(n)
        and contact_notice_period(n, t, start, stop, given);
    then prohibition S7602NoNoticeWithoutIntentToContact {
        bearer IRS;
        beneficiary t;
        action notice_issued_without_intent_to_contact(n);
        window [-infinity, infinity];
    };
}
relation taxpayer_has_third_party_contact_history(t: Person) kind empirical {
    label en unofficial "the IRS has contacted persons other than the taxpayer with respect to the taxpayer's liability";
}
relation periodic_record_of_contacts_provided(t: Person) kind empirical {
    label en unofficial "the Secretary periodically provides the taxpayer a record of persons contacted";
}
relation taxpayer_requests_record_of_contacts(t: Person) kind empirical {
    label en unofficial "the taxpayer requests the record of persons contacted";
}
relation record_of_contacts_provided_on_request(t: Person) kind empirical {
    label en unofficial "the Secretary provides the record upon the taxpayer's request";
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "The Secretary shall periodically provide to a taxpayer a record of persons contacted during such period by the Secretary")
rule S7602PeriodicRecordDuty defeasible {
    for t: Person;
    when taxpayer_has_third_party_contact_history(t);
    then duty S7602ProvidePeriodicRecordOfContacts {
        bearer Secretary;
        beneficiary t;
        goal maintenance {
            condition periodic_record_of_contacts_provided(t);
            window [-infinity, infinity];
        }
    };
    unless taxpayer_authorized_all_contacts(t) and taxpayer_has_third_party_contact_history(t);
}
relation taxpayer_authorized_all_contacts(t: Person) kind empirical {
    label en unofficial "the taxpayer has authorized every contact (exception of (c)(3)(A) applied to the record)";
}
@source(IRC_S7602_C, relation = formalizes, coverage = exact, quote = "Such record shall also be provided upon request of the taxpayer.")
rule S7602RecordOnRequestDuty defeasible {
    for t: Person;
    when taxpayer_requests_record_of_contacts(t);
    then duty S7602ProvideRecordOnRequest {
        bearer Secretary;
        beneficiary t;
        goal achievement {
            condition record_of_contacts_provided_on_request(t);
            window [-infinity, infinity];
        }
    };
}

// §7602(e), (f)
relation uses_financial_status_technique(t: Person) kind empirical {
    label en unofficial "the Secretary uses financial status or economic reality examination techniques to determine the existence of unreported income of the taxpayer";
}
external judgment relation reasonable_indication_of_unreported_income(t: Person) {
    authority Secretary;
    label en unofficial "the Secretary has a reasonable indication that there is a likelihood of unreported income (§7602(e))";
}
@source(IRC_S7602_E, relation = formalizes, coverage = exact, quote = "The Secretary shall not use financial status or economic reality examination techniques to determine the existence of unreported income of any taxpayer unless the Secretary has a reasonable indication that there is a likelihood of such unreported income.")
rule S7602FinancialStatusProhibition defeasible {
    for t: Person;
    when uses_financial_status_technique(t);
    then prohibition S7602NoFinancialStatusTechniqueWithoutIndication {
        bearer Secretary;
        beneficiary t;
        action uses_financial_status_technique(t);
        window [-infinity, infinity];
    };
    unless reasonable_indication_of_unreported_income(t) and uses_financial_status_technique(t);
}
relation records_provided_to_6103n_person(p: Person) kind empirical {
    label en unofficial "the Secretary, under section 6103(n) authority, provides books, papers, records or other data obtained under §7602 to this person";
}
relation person_needs_records_solely_for_expert_evaluation(p: Person) kind empirical {
    label en unofficial "the person requires the information for the sole purpose of providing expert evaluation and assistance to the IRS";
}
@source(IRC_S7602_F, relation = formalizes, coverage = exact, quote = "The Secretary shall not, under the authority of section 6103(n), provide any books, papers, records, or other data obtained pursuant to this section to any person authorized under section 6103(n), except when such person requires such information for the sole purpose of providing expert evaluation and assistance to the Internal Revenue Service.")
rule S7602Section6103nProhibition defeasible {
    for p: Person;
    when records_provided_to_6103n_person(p);
    then prohibition S7602NoRecordsToContractorExceptExpertEvaluation {
        bearer Secretary;
        beneficiary p;
        action records_provided_to_6103n_person(p);
        window [-infinity, infinity];
    };
    unless person_needs_records_solely_for_expert_evaluation(p) and records_provided_to_6103n_person(p);
}
relation witness_questioned_under_oath_by(w: Person, q: Person) kind empirical {
    label en unofficial "the person q questions the witness w under oath on behalf of the Secretary about testimony obtained under §7602";
}
relation questioner_is_irs_or_chief_counsel_officer_or_employee(q: Person) kind empirical {
    label en unofficial "the person is an officer or employee of the Internal Revenue Service or the Office of Chief Counsel";
}
@source(IRC_S7602_F, relation = formalizes, coverage = exact, quote = "No person other than an officer or employee of the Internal Revenue Service or the Office of Chief Counsel may, on behalf of the Secretary, question a witness under oath whose testimony was obtained pursuant to this section.")
rule S7602QuestioningProhibition defeasible {
    for w: Person;
    for q: Person;
    when witness_questioned_under_oath_by(w, q);
    then prohibition S7602NoQuestioningByOutsiders {
        bearer q;
        beneficiary w;
        action witness_questioned_under_oath_by(w, q);
        window [-infinity, infinity];
    };
    unless questioner_is_irs_or_chief_counsel_officer_or_employee(q) and witness_questioned_under_oath_by(w, q);
}

// --- §7603: service of summons ---------------------------------------------------------

enum SummonsServiceMethod {
    AttestedCopyDeliveredInHand;
    AttestedCopyLeftAtLastAndUsualAbode;
    CertifiedOrRegisteredMailToLastKnownAddress;
}
enum RecordkeeperKind {
    SavingsInstitutionBankOrCreditUnion;
    ConsumerReportingAgency;
    CreditCardExtender;
    Broker;
    Attorney;
    Accountant;
    BarterExchange;
    RegulatedInvestmentCompanyOrAgent;
    EnrolledAgent;
    OwnerOrDeveloperOfSoftwareSourceCode;
}
relation summons_served_by(s: SummonsDoc, m: SummonsServiceMethod) kind empirical {
    label en unofficial "the summons is served by the named method";
}
relation summoned_person_recordkeeper_kind(s: SummonsDoc, k: RecordkeeperKind) kind empirical {
    label en unofficial "the person summoned is a third-party recordkeeper of the named kind (§7603(b)(2)(A)-(J))";
}
relation summons_requires_source_code_or_related_program_and_data(s: SummonsDoc) kind empirical {
    label en unofficial "the summons requires the production of the computer software source code or of the program and data described in section 7612(b)(1)(A)(ii) to which it relates";
}
relation records_described_with_reasonable_certainty(s: SummonsDoc) kind empirical {
    label en unofficial "the books, papers, records, or other data are described with reasonable certainty";
}
relation certificate_of_service_signed(s: SummonsDoc) kind empirical {
    label en unofficial "the certificate of service is signed by the person serving the summons";
}
pub relation summons_directed_to_third_party_recordkeeper(s: SummonsDoc) kind institutional {
    label en unofficial "the summoned person is a third-party recordkeeper under §7603(b)(2)";
}
pub relation summons_validly_served(s: SummonsDoc) kind institutional {
    label en unofficial "the summons is served in a manner §7603 allows";
}
pub relation description_of_records_sufficient(s: SummonsDoc) kind institutional {
    label en unofficial "the description of the records is sufficient (reasonable certainty)";
}
pub relation certificate_of_service_is_evidence(s: SummonsDoc) kind institutional {
    label en unofficial "the certificate of service signed by the person serving is evidence of the facts it states on the hearing of an enforcement application";
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any mutual savings bank, cooperative bank, domestic building and loan association, or other savings institution chartered and supervised as a savings and loan or similar association under Federal or State law, any bank (as defined in section 581), or any credit union (within the meaning of section 501(c)(14)(A))")
rule S7603RecordkeeperSavings strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, SavingsInstitutionBankOrCreditUnion);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any consumer reporting agency (as defined under section 603(f) of the Fair Credit Reporting Act (15 U.S.C. 1681a(f)))")
rule S7603RecordkeeperConsumerReporting strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, ConsumerReportingAgency);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any person extending credit through the use of credit cards or similar devices")
rule S7603RecordkeeperCredit strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, CreditCardExtender);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any broker (as defined in section 3(a)(4) of the Securities Exchange Act of 1934 (15 U.S.C. 78c(a)(4)))")
rule S7603RecordkeeperBroker strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, Broker);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any attorney")
rule S7603RecordkeeperAttorney strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, Attorney);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any accountant")
rule S7603RecordkeeperAccountant strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, Accountant);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any barter exchange (as defined in section 6045(c)(3))")
rule S7603RecordkeeperBarterExchange strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, BarterExchange);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any regulated investment company (as defined in section 851) and any agent of such regulated investment company when acting as an agent thereof")
rule S7603RecordkeeperRegulatedInvestmentCompany strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, RegulatedInvestmentCompanyOrAgent);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "any enrolled agent")
rule S7603RecordkeeperEnrolledAgent strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, EnrolledAgent);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "Subparagraph (J) shall apply only with respect to a summons requiring the production of the source code referred to in subparagraph (J) or the program and data described in section 7612(b)(1)(A)(ii) to which such source code relates.")
rule S7603RecordkeeperSourceCodeOwner strict {
    for s: SummonsDoc;
    when summoned_person_recordkeeper_kind(s, OwnerOrDeveloperOfSoftwareSourceCode)
        and summons_requires_source_code_or_related_program_and_data(s);
    then summons_directed_to_third_party_recordkeeper(s);
}
@source(IRC_S7603_A, relation = formalizes, coverage = exact, quote = "shall be served by the Secretary, by an attested copy delivered in hand to the person to whom it is directed")
rule S7603ServiceInHand strict {
    for s: SummonsDoc;
    when summons_served_by(s, AttestedCopyDeliveredInHand);
    then summons_validly_served(s);
}
@source(IRC_S7603_A, relation = formalizes, coverage = exact, quote = "or left at his last and usual place of abode")
rule S7603ServiceAtAbode strict {
    for s: SummonsDoc;
    when summons_served_by(s, AttestedCopyLeftAtLastAndUsualAbode);
    then summons_validly_served(s);
}
@source(IRC_S7603_B, relation = formalizes, coverage = exact, quote = "may also be served by certified or registered mail to the last known address of such recordkeeper")
rule S7603ServiceByMailOnRecordkeeper strict {
    for s: SummonsDoc;
    when summons_served_by(s, CertifiedOrRegisteredMailToLastKnownAddress)
        and summons_directed_to_third_party_recordkeeper(s);
    then summons_validly_served(s);
}
@source(IRC_S7603_A, relation = formalizes, coverage = exact, quote = "it shall be sufficient if such books, papers, records, or other data are described with reasonable certainty")
rule S7603DescriptionSufficient strict {
    for s: SummonsDoc;
    when records_described_with_reasonable_certainty(s);
    then description_of_records_sufficient(s);
}
@source(IRC_S7603_A, relation = formalizes, coverage = exact, quote = "the certificate of service signed by the person serving the summons shall be evidence of the facts it states on the hearing of an application for the enforcement of the summons")
rule S7603CertificateIsEvidence strict {
    for s: SummonsDoc;
    when certificate_of_service_signed(s);
    then certificate_of_service_is_evidence(s);
}

// --- §7604: enforcement of summons --------------------------------------------------------

relation summoned_person_resides_or_is_found_in_district(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned person resides or is found in the judicial district of the court";
}
relation summoned_person_neglects_or_refuses(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned person neglects or refuses to obey the summons, to produce the records, or to give testimony as required";
}
relation secretary_applies_for_attachment(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary applies to the district judge or magistrate judge for an attachment as for a contempt";
}
relation enforcement_action_conditions_met(s: SummonsDoc) kind derived {
    label en unofficial "the summoned person neglects or refuses to obey, the summons is in force, and no Justice Department referral is in effect (§7602(d)(1))";
}
pub relation district_court_jurisdiction_to_compel(s: SummonsDoc) kind institutional {
    label en unofficial "the district court where the person resides or is found has jurisdiction by appropriate process to compel attendance, testimony, or production";
}
pub relation attachment_application_authorized(s: SummonsDoc) kind institutional {
    label en unofficial "the Secretary's application for an attachment against the summoned person as for a contempt is authorized under §7604(b)";
}
@source(IRC_S7604_A, relation = formalizes, coverage = exact, quote = "the United States district court for the district in which such person resides or is found shall have jurisdiction by appropriate process to compel such attendance, testimony, or production of books, papers, records, or other data")
rule S7604Jurisdiction strict {
    for s: SummonsDoc;
    for p: Person;
    when summoned_person_resides_or_is_found_in_district(s, p);
    then district_court_jurisdiction_to_compel(s);
}
@source(IRC_S7604_B, relation = formalizes, coverage = exact, quote = "neglects or refuses to obey such summons, or to produce books, papers, records, or other data, or to give testimony, as required")
rule S7604EnforcementConditions strict {
    for s: SummonsDoc;
    for p: Person;
    for inq: TaxInquiry;
    for t: Person;
    for y: TaxableYear;
    for k: us.irc.core::TaxKind;
    when summoned_person_neglects_or_refuses(s, p)
        and summons_in_force(s)
        and summons_for_inquiry(s, inq)
        and inquiry_matter(inq, t, y, k)
        and not_known(justice_department_referral_in_effect(t, y, k));
    then enforcement_action_conditions_met(s);
}
@source(IRC_S7604_B, relation = formalizes, coverage = exact, quote = "the Secretary may apply to the judge of the district court or to a United States magistrate judge for the district within which the person so summoned resides or is found for an attachment against him as for a contempt")
rule S7604AttachmentPower strict {
    for s: SummonsDoc;
    for p: Person;
    when secretary_applies_for_attachment(s)
        and summoned_person_neglects_or_refuses(s, p);
    then power S7604ApplyForAttachment {
        holder Secretary;
        over p;
        exercise secretary_applies_for_attachment(s);
        valid_when enforcement_action_conditions_met(s);
        effect create(attachment_application_authorized(s));
    };
}
relation satisfactory_proof_of_disobedience_made(s: SummonsDoc) kind empirical {
    label en unofficial "satisfactory proof is made to the court of the summoned person's neglect or refusal";
}
relation court_hears_attachment_application(s: SummonsDoc) kind empirical {
    label en unofficial "the judge or magistrate judge hears the application";
}
relation court_issues_attachment(s: SummonsDoc) kind empirical {
    label en unofficial "the court issues an attachment, directed to a proper officer, for the arrest of the summoned person";
}
@source(IRC_S7604_B, relation = formalizes, coverage = exact, quote = "It shall be the duty of the judge or magistrate judge to hear the application")
rule S7604CourtHearingDuty strict {
    for s: SummonsDoc;
    when secretary_applies_for_attachment(s)
        and attachment_application_authorized(s);
    then duty S7604HearAttachmentApplication {
        bearer DistrictCourt;
        beneficiary Secretary;
        goal achievement {
            condition court_hears_attachment_application(s);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7604_B, relation = formalizes, coverage = exact, quote = "if satisfactory proof is made, to issue an attachment, directed to some proper officer, for the arrest of such person")
rule S7604CourtAttachmentDuty strict {
    for s: SummonsDoc;
    when secretary_applies_for_attachment(s)
        and attachment_application_authorized(s)
        and satisfactory_proof_of_disobedience_made(s);
    then duty S7604IssueAttachment {
        bearer DistrictCourt;
        beneficiary Secretary;
        goal achievement {
            condition court_issues_attachment(s);
            window [-infinity, infinity];
        }
    };
}
relation court_orders_obedience_or_punishes_default(s: SummonsDoc) kind empirical {
    label en unofficial "after a hearing the judge or magistrate judge makes the order he deems proper, not inconsistent with the law for the punishment of contempts, to enforce obedience to the summons and to punish the person for default or disobedience";
}
pub relation contempt_order_authorized(s: SummonsDoc) kind institutional {
    label en unofficial "the court's order enforcing obedience or punishing default is authorized";
}
@source(IRC_S7604_B, relation = formalizes, coverage = exact, quote = "upon such hearing the judge or the United States magistrate judge shall have power to make such order as he shall deem proper, not inconsistent with the law for the punishment of contempts, to enforce obedience to the requirements of the summons and to punish such person for his default or disobedience")
rule S7604ContemptPower strict {
    for s: SummonsDoc;
    for p: Person;
    when court_orders_obedience_or_punishes_default(s)
        and summoned_person_neglects_or_refuses(s, p);
    then power S7604OrderEnforcementOrPunishment {
        holder DistrictCourt;
        over p;
        exercise court_orders_obedience_or_punishes_default(s);
        valid_when satisfactory_proof_of_disobedience_made(s);
        effect create(contempt_order_authorized(s));
    };
}

// --- §7605: time and place; restrictions on examination ----------------------------------------

relation summons_date_and_appearance(s: SummonsDoc, issued: Date, appearance: Date) kind empirical {
    label en unofficial "the date of the summons and the date fixed for appearance before the Secretary";
}
relation time_and_place_reasonable(s: SummonsDoc) kind empirical {
    label en unofficial "the time and place of examination fixed by the Secretary are reasonable under the circumstances";
}
relation summons_under_7602a2_or_corresponding(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is under §7602(a)(2) or the corresponding authority of sections 6420(e)(2), 6421(g)(2), 6427(j)(2)";
}
relation appearance_date_less_than_10_days(s: SummonsDoc) kind derived {
    label en unofficial "the date fixed for appearance is less than 10 days from the date of the summons";
}
@source(IRC_S7605_A, relation = formalizes, coverage = exact, quote = "the date fixed for appearance before the Secretary shall not be less than 10 days from the date of the summons")
rule S7605AppearanceUnderTenDays strict {
    for s: SummonsDoc;
    for issued: Date;
    for appearance: Date;
    when summons_under_7602a2_or_corresponding(s)
        and summons_date_and_appearance(s, issued, appearance)
        and days_between(issued, appearance) < 10;
    then appearance_date_less_than_10_days(s);
}
@source(IRC_S7605_A, relation = formalizes, coverage = exact, quote = "the date fixed for appearance before the Secretary shall not be less than 10 days from the date of the summons")
rule S7605TenDaysProhibition strict {
    for s: SummonsDoc;
    when appearance_date_less_than_10_days(s);
    then prohibition S7605NoAppearanceDateUnderTenDays {
        bearer Secretary;
        action appearance_date_less_than_10_days(s);
        window [-infinity, infinity];
    };
}
relation examination_time_and_place_unreasonable(s: SummonsDoc) kind derived {
    label en unofficial "the time and place of examination fixed by the Secretary are not reasonable under the circumstances";
}
relation time_and_place_fixed_as_unreasonable(s: SummonsDoc) kind empirical {
    label en unofficial "the time and place fixed by the Secretary are unreasonable under the circumstances (asserted negation)";
}
@source(IRC_S7605_A, relation = formalizes, coverage = exact, quote = "shall be such time and place as may be fixed by the Secretary and as are reasonable under the circumstances")
rule S7605UnreasonableTimeAndPlace strict {
    for s: SummonsDoc;
    when time_and_place_fixed_as_unreasonable(s);
    then examination_time_and_place_unreasonable(s);
}
@source(IRC_S7605_A, relation = formalizes, coverage = exact, quote = "shall be such time and place as may be fixed by the Secretary and as are reasonable under the circumstances")
rule S7605ReasonableTimeAndPlaceProhibition strict {
    for s: SummonsDoc;
    when examination_time_and_place_unreasonable(s);
    then prohibition S7605NoUnreasonableTimeOrPlace {
        bearer Secretary;
        action examination_time_and_place_unreasonable(s);
        window [-infinity, infinity];
    };
}
relation taxpayer_subjected_to_unnecessary_examination(t: Person) kind empirical {
    label en unofficial "the taxpayer is subjected to unnecessary examination or investigation";
}
@source(IRC_S7605_B, relation = formalizes, coverage = exact, quote = "No taxpayer shall be subjected to unnecessary examination or investigations")
rule S7605UnnecessaryExaminationProhibition strict {
    for t: Person;
    when taxpayer_subjected_to_unnecessary_examination(t);
    then prohibition S7605NoUnnecessaryExamination {
        bearer Secretary;
        beneficiary t;
        action taxpayer_subjected_to_unnecessary_examination(t);
        window [-infinity, infinity];
    };
}
relation books_inspection(t: Person, y: TaxableYear, ordinal: Integer) kind empirical {
    label en unofficial "an inspection of the taxpayer's books of account for the taxable year, numbered by order";
}
relation taxpayer_requests_additional_inspection(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "the taxpayer requests an additional inspection";
}
relation secretary_notified_in_writing_additional_inspection_necessary(t: Person, y: TaxableYear) kind empirical {
    label en unofficial "after investigation the Secretary notifies the taxpayer in writing that an additional inspection is necessary";
}
relation second_inspection_of_books_for_year(t: Person, y: TaxableYear) kind derived {
    label en unofficial "a second inspection of the taxpayer's books of account is made for the taxable year";
}
@source(IRC_S7605_B, relation = formalizes, coverage = exact, quote = "only one inspection of a taxpayer's books of account shall be made for each taxable year")
rule S7605SecondInspection strict {
    for t: Person;
    for y: TaxableYear;
    for n: Integer;
    when books_inspection(t, y, n)
        and n >= 2;
    then second_inspection_of_books_for_year(t, y);
}
@source(IRC_S7605_B, relation = formalizes, coverage = exact, quote = "unless the taxpayer requests otherwise or unless the Secretary, after investigation, notifies the taxpayer in writing that an additional inspection is necessary")
rule S7605OneInspectionProhibition defeasible {
    for t: Person;
    for y: TaxableYear;
    when second_inspection_of_books_for_year(t, y);
    then prohibition S7605NoSecondInspectionOfBooks {
        bearer Secretary;
        beneficiary t;
        action second_inspection_of_books_for_year(t, y);
        window [-infinity, infinity];
    };
    unless taxpayer_requests_additional_inspection(t, y) and second_inspection_of_books_for_year(t, y);
    unless secretary_notified_in_writing_additional_inspection_necessary(t, y) and second_inspection_of_books_for_year(t, y);
}

// --- §7606: entry of premises ----------------------------------------------------------------------

entity Premises {
    label en unofficial "a building or place where articles or objects subject to tax are made, produced, or kept";
}
relation premises_hold_taxed_articles(pr: Premises) kind empirical {
    label en unofficial "articles or objects subject to tax are made, produced, or kept on the premises";
}
relation premises_open_at_night(pr: Premises) kind empirical {
    label en unofficial "the premises are open at night";
}
relation entry_necessary_for_examining_articles(pr: Premises) kind empirical {
    label en unofficial "the entry is necessary for the purpose of examining the articles or objects";
}
relation secretary_enters_premises_in_daytime(pr: Premises) kind empirical {
    label en unofficial "the Secretary enters the premises in the daytime";
}
relation secretary_enters_premises_at_night(pr: Premises) kind empirical {
    label en unofficial "the Secretary enters the premises at night, while open, in the performance of official duties";
}
relation daytime_entry_conditions_met(pr: Premises) kind derived {
    label en unofficial "the premises hold taxed articles and the entry is necessary for examining them";
}
relation night_entry_conditions_met(pr: Premises) kind derived {
    label en unofficial "the premises hold taxed articles, are open at night, and the entry serves the Secretary's official duties";
}
pub relation daytime_entry_authorized(pr: Premises) kind institutional {
    label en unofficial "the Secretary's daytime entry is authorized under §7606(a)";
}
pub relation night_entry_authorized(pr: Premises) kind institutional {
    label en unofficial "the Secretary's night entry while the premises are open is authorized under §7606(b)";
}
@source(IRC_S7606_A, relation = formalizes, coverage = exact, quote = "any building or place where any articles or objects subject to tax are made, produced, or kept, so far as it may be necessary for the purpose of examining said articles or objects")
rule S7606DaytimeConditions strict {
    for pr: Premises;
    when premises_hold_taxed_articles(pr)
        and entry_necessary_for_examining_articles(pr);
    then daytime_entry_conditions_met(pr);
}
@source(IRC_S7606_A, relation = formalizes, coverage = exact, quote = "The Secretary may enter, in the daytime, any building or place where any articles or objects subject to tax are made, produced, or kept")
rule S7606DaytimeEntryPower strict {
    for pr: Premises;
    when secretary_enters_premises_in_daytime(pr);
    then power S7606EnterInDaytime {
        holder Secretary;
        over pr;
        exercise secretary_enters_premises_in_daytime(pr);
        valid_when daytime_entry_conditions_met(pr);
        effect create(daytime_entry_authorized(pr));
    };
}
@source(IRC_S7606_B, relation = formalizes, coverage = exact, quote = "When such premises are open at night, the Secretary may enter them while so open, in the performance of his official duties.")
rule S7606NightConditions strict {
    for pr: Premises;
    when premises_hold_taxed_articles(pr)
        and premises_open_at_night(pr);
    then night_entry_conditions_met(pr);
}
@source(IRC_S7606_B, relation = formalizes, coverage = exact, quote = "When such premises are open at night, the Secretary may enter them while so open, in the performance of his official duties.")
rule S7606NightEntryPower strict {
    for pr: Premises;
    when secretary_enters_premises_at_night(pr);
    then power S7606EnterAtNight {
        holder Secretary;
        over pr;
        exercise secretary_enters_premises_at_night(pr);
        valid_when night_entry_conditions_met(pr);
        effect create(night_entry_authorized(pr));
    };
}

// --- §7610: fees and mileage of persons summoned ---------------------------------------------------------

relation secretary_establishes_summons_fee_regulations(o: Organ) kind empirical {
    label en unofficial "the Secretary has established by regulations the rates and conditions for fees and mileage of persons summoned and for reimbursement of reasonably necessary costs directly incurred in searching for, reproducing, or transporting records";
}
@source(IRC_S7610_A, relation = formalizes, coverage = exact, quote = "The Secretary shall by regulations establish the rates and conditions under which payment may be made of—")
rule S7610FeeRegulationsDuty strict {
    when true;
    then duty S7610EstablishFeeAndReimbursementRegulations {
        bearer Secretary;
        goal maintenance {
            condition secretary_establishes_summons_fee_regulations(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation cost_reimbursement_paid_for_summons(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary pays reimbursement of costs of searching for, reproducing, or transporting records required by the summons";
}
relation taxpayer_has_proprietary_interest_in_records(s: SummonsDoc) kind empirical {
    label en unofficial "the person with respect to whose liability the summons is issued has a proprietary interest in the records or data required";
}
relation summoned_is_taxpayer_or_acting_representative(s: SummonsDoc) kind empirical {
    label en unofficial "the person summoned is the taxpayer or an officer, employee, agent, accountant, or attorney of the taxpayer acting as such when served";
}
@source(IRC_S7610_B, relation = formalizes, coverage = exact, quote = "No payment may be made under paragraph (2) of subsection (a) if—")
rule S7610ProprietaryInterestProhibition strict {
    for s: SummonsDoc;
    when cost_reimbursement_paid_for_summons(s)
        and taxpayer_has_proprietary_interest_in_records(s);
    then prohibition S7610NoReimbursementWhereTaxpayerOwnsRecords {
        bearer Secretary;
        action cost_reimbursement_paid_for_summons(s);
        window [-infinity, infinity];
    };
}
@source(IRC_S7610_B, relation = formalizes, coverage = exact, quote = "the person summoned is the person with respect to whose liability the summons is issued or an officer, employee, agent, accountant, or attorney of such person who, at the time the summons is served, is acting as such")
rule S7610TaxpayerRepresentativeProhibition strict {
    for s: SummonsDoc;
    when cost_reimbursement_paid_for_summons(s)
        and summoned_is_taxpayer_or_acting_representative(s);
    then prohibition S7610NoReimbursementToTaxpayerOrRepresentative {
        bearer Secretary;
        action cost_reimbursement_paid_for_summons(s);
        window [-infinity, infinity];
    };
}
