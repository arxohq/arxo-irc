// 26 U.S.C. §7528 (user fees), §7529 (notification of suspected identity
// theft), §7530 (payments to Puerto Rico, the mirror-code possessions and
// American Samoa for earned income tax credit costs). STAGE 3.
//
// JUDGMENT CALLS
//  - §7528(b)(3): the "average fee" per category is a case fact (an
//    aggregate over the fee program's requests); the statutory floor per
//    category is an executable prohibition on the Secretary.
//  - §7529 "as soon as practicable" has no date: achievement goals over the
//    open window; the tax-administration investigation carve-out is an
//    `unless` on each duty.
//  - §7530: the cost to a territory of its earned income tax credit is
//    determined by the Secretary on the territory's law (case fact,
//    EXTERNAL_DEPENDENCY: territorial law is not in the corpus); the
//    cost-of-living adjustment with the substituted base year (calendar year
//    2020) is a case fact (owner: income-individual, section 1(f)(3)).
//  - Rounding to the nearest multiple of $1,000,000 / $100,000: HALF_UP.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7528_A,
    IRC_S7528_B,
    IRC_S7528_TABLE_1,
    IRC_S7529_A,
    IRC_S7529_B,
    IRC_S7530_A,
    IRC_S7530_B,
    IRC_S7530_C,
    IRC_S7530_D,
    Organ,
    Person,
    Secretary,
    TaxableYear,
    average_fee_for_floor_test,
};

// --- §7528: user fees ------------------------------------------------------------

enum UserFeeCategory {
    EmployeePlanRulingAndOpinion;
    ExemptOrganizationRuling;
    EmployeePlanDetermination;
    ExemptOrganizationDetermination;
    ChiefCounselRuling;
}
entity UserFeeRequest {
    label en unofficial "a request to the Internal Revenue Service for a ruling letter, opinion letter, determination letter, or other similar request";
}
relation user_fee_program_established(o: Organ) kind empirical {
    label en unofficial "the Secretary has established a program requiring user fees for requests for ruling, opinion and determination letters and other similar requests";
}
@source(IRC_S7528_A, relation = formalizes, coverage = exact, quote = "The Secretary shall establish a program requiring the payment of user fees for—")
rule S7528EstablishProgramDuty strict {
    when true;
    then duty S7528EstablishUserFeeProgram {
        bearer Secretary;
        goal maintenance {
            condition user_fee_program_established(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation fees_vary_by_category(o: Organ) kind empirical {
    label en unofficial "the fees vary according to categories (or subcategories) established by the Secretary, determined after taking into account the average time for and difficulty of complying with requests in each category";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "shall vary according to categories (or subcategories) established by the Secretary")
rule S7528FeeStructureDuty strict {
    when true;
    then duty S7528FeesVaryByCategoryAndDifficulty {
        bearer Secretary;
        goal maintenance {
            condition fees_vary_by_category(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation fee_request_submitted_on(r: UserFeeRequest, requester: Person, d: Date) kind empirical {
    label en unofficial "the request is submitted on this date";
}
relation fee_paid_on(r: UserFeeRequest, d: Date) kind empirical {
    label en unofficial "the user fee for the request is paid on this date";
}
relation user_fee_paid_in_advance(r: UserFeeRequest) kind derived {
    label en unofficial "the fee is paid on or before the submission of the request";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "shall be payable in advance")
rule S7528PaidInAdvance strict {
    for r: UserFeeRequest;
    for requester: Person;
    for submitted: Date;
    for paid: Date;
    when fee_request_submitted_on(r, requester, submitted)
        and fee_paid_on(r, paid)
        and paid <= submitted;
    then user_fee_paid_in_advance(r);
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "shall be payable in advance")
rule S7528PayInAdvanceDuty defeasible {
    for r: UserFeeRequest;
    for requester: Person;
    for submitted: Date;
    when fee_request_submitted_on(r, requester, submitted);
    then duty S7528PayUserFeeInAdvance {
        bearer requester;
        beneficiary Secretary;
        goal achievement {
            condition user_fee_paid_in_advance(r);
            window [-infinity, submitted];
        }
    };
}
relation program_provides_exemptions_and_reduced_fees_as_appropriate(o: Organ) kind empirical {
    label en unofficial "the program provides for exemptions (and reduced fees) that the Secretary determines to be appropriate";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The Secretary shall provide for such exemptions (and reduced fees) under such program as the Secretary determines to be appropriate.")
rule S7528ExemptionsDuty strict {
    when true;
    then duty S7528ProvideExemptionsAsAppropriate {
        bearer Secretary;
        goal maintenance {
            condition program_provides_exemptions_and_reduced_fees_as_appropriate(Secretary);
            window [-infinity, infinity];
        }
    };
}
enum PensionBenefitPlanKind {
    Pension;
    ProfitSharing;
    StockBonus;
    Annuity;
    EmployeeStockOwnership;
}
relation request_for_determination_letter_on_plan_qualification(r: UserFeeRequest, k: PensionBenefitPlanKind) kind empirical {
    label en unofficial "the request is for a determination letter on the qualified status of a pension benefit plan (pension, profit-sharing, stock bonus, annuity, or employee stock ownership plan) or a trust that is part of it";
}
relation plan_maintained_solely_by_eligible_employers(r: UserFeeRequest) kind empirical {
    label en unofficial "the plan is maintained solely by one or more eligible employers";
}
relation employer_is_eligible_employer_at_request(r: UserFeeRequest) kind empirical {
    label en unofficial "each employer is an eligible employer (section 408(p)(2)(C)(i)(I)) with at least one non-highly compensated participating employee, determined as of the date of the request";
}
relation request_made_after_fifth_plan_year_or_remedial_period(r: UserFeeRequest) kind empirical {
    label en unofficial "the request is made after the later of the fifth plan year of existence and the end of any remedial amendment period beginning within the first 5 plan years";
}
relation request_made_by_prototype_plan_sponsor(r: UserFeeRequest) kind empirical {
    label en unofficial "the request is made by the sponsor of a prototype or similar plan the sponsor intends to market to participating employers";
}
relation secretary_requires_user_fee_for(r: UserFeeRequest) kind empirical {
    label en unofficial "the Secretary requires payment of a user fee for the request";
}
relation exempt_small_plan_request(r: UserFeeRequest) kind derived {
    label en unofficial "the request is for a determination letter of an eligible-employer pension plan for which no fee may be required";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The Secretary shall not require payment of user fees under such program for requests for determination letters with respect to the qualified status of a pension benefit plan maintained solely by 1 or more eligible employers")
rule S7528ExemptSmallPlanRequest defeasible {
    for r: UserFeeRequest;
    for k: PensionBenefitPlanKind;
    when request_for_determination_letter_on_plan_qualification(r, k)
        and plan_maintained_solely_by_eligible_employers(r)
        and employer_is_eligible_employer_at_request(r);
    then exempt_small_plan_request(r);
    unless request_made_after_fifth_plan_year_or_remedial_period(r) and request_for_determination_letter_on_plan_qualification(r, k) and plan_maintained_solely_by_eligible_employers(r) and employer_is_eligible_employer_at_request(r);
    unless request_made_by_prototype_plan_sponsor(r) and request_for_determination_letter_on_plan_qualification(r, k) and plan_maintained_solely_by_eligible_employers(r) and employer_is_eligible_employer_at_request(r);
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The Secretary shall not require payment of user fees under such program for requests for determination letters with respect to the qualified status of a pension benefit plan maintained solely by 1 or more eligible employers")
rule S7528NoFeeForSmallPlanRequest strict {
    for r: UserFeeRequest;
    when exempt_small_plan_request(r)
        and secretary_requires_user_fee_for(r);
    then prohibition S7528NoFeeForEligibleEmployerPlanRequest {
        bearer Secretary;
        action secretary_requires_user_fee_for(r);
        window [-infinity, infinity];
    };
}
relation average_fee_charged(c: UserFeeCategory, avg: Money) kind empirical {
    label en unofficial "the average fee charged under the program for requests in the category, not taking into account requests exempted under (B)";
}
pub relation statutory_average_fee_floor(c: UserFeeCategory, floor: Money) kind institutional {
    label en unofficial "the minimum average fee for the category (§7528(b)(3) table)";
}
relation average_fee_below_floor(c: UserFeeCategory) kind derived {
    label en unofficial "the average fee charged in the category is below its statutory floor";
}
@source(IRC_S7528_TABLE_1, relation = formalizes, coverage = exact, quote = "Employee plan ruling and opinion")
rule S7528FloorEmployeePlanRuling strict {
    when true;
    then statutory_average_fee_floor(EmployeePlanRulingAndOpinion, 250.00 USD);
}
@source(IRC_S7528_TABLE_1, relation = formalizes, coverage = exact, quote = "Exempt organization ruling")
rule S7528FloorExemptOrganizationRuling strict {
    when true;
    then statutory_average_fee_floor(ExemptOrganizationRuling, 350.00 USD);
}
@source(IRC_S7528_TABLE_1, relation = formalizes, coverage = exact, quote = "Employee plan determination")
rule S7528FloorEmployeePlanDetermination strict {
    when true;
    then statutory_average_fee_floor(EmployeePlanDetermination, 300.00 USD);
}
@source(IRC_S7528_TABLE_1, relation = formalizes, coverage = exact, quote = "Exempt organization determination")
rule S7528FloorExemptOrganizationDetermination strict {
    when true;
    then statutory_average_fee_floor(ExemptOrganizationDetermination, 275.00 USD);
}
@source(IRC_S7528_TABLE_1, relation = formalizes, coverage = exact, quote = "Chief counsel ruling")
rule S7528FloorChiefCounselRuling strict {
    when true;
    then statutory_average_fee_floor(ChiefCounselRuling, 200.00 USD);
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The average fee charged under the program required by subsection (a) shall not be less than the amount determined under the following table:")
rule S7528AverageBelowFloor defeasible {
    for c: UserFeeCategory;
    for avg: Money;
    for floor: Money;
    when average_fee_for_floor_test(c, avg)
        and statutory_average_fee_floor(c, floor)
        and avg < floor;
    then average_fee_below_floor(c);
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The average fee charged under the program required by subsection (a) shall not be less than the amount determined under the following table:")
rule S7528AverageFloorProhibition strict {
    for c: UserFeeCategory;
    when average_fee_below_floor(c);
    then prohibition S7528NoAverageFeeBelowFloor {
        bearer Secretary;
        action average_fee_below_floor(c);
        window [-infinity, infinity];
    };
}
relation peo_certification_fee_charged(p: Person, y: TaxableYear, fee: Money) kind empirical {
    label en unofficial "the annual fee charged in connection with the Secretary's certification of a professional employer organization under section 7705";
}
relation peo_fee_exceeds_1000(p: Person, y: TaxableYear) kind derived {
    label en unofficial "the annual certification fee exceeds $1,000";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "The fee charged under the program in connection with the certification by the Secretary of a professional employer organization under section 7705 shall be an annual fee not to exceed $1,000 per year.")
rule S7528PeoFeeExceeds strict {
    for p: Person;
    for y: TaxableYear;
    for fee: Money;
    when peo_certification_fee_charged(p, y, fee)
        and fee > 1000.00 USD;
    then peo_fee_exceeds_1000(p, y);
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "shall be an annual fee not to exceed $1,000 per year")
rule S7528PeoFeeProhibition strict {
    for p: Person;
    for y: TaxableYear;
    when peo_fee_exceeds_1000(p, y);
    then prohibition S7528NoPeoFeeOver1000 {
        bearer Secretary;
        beneficiary p;
        action peo_fee_exceeds_1000(p, y);
        window [-infinity, infinity];
    };
}

// --- §7529: notification of suspected identity theft -----------------------------------

entity IdentityUse {
    label en unofficial "a determination that there has been or may have been an unauthorized use of the identity of an individual (including to obtain employment)";
}
enum IdentityTheftNotice {
    NotifyOfDetermination;
    LawEnforcementReportInstructions;
    StepsToPermitLawEnforcementAccess;
    ProtectiveActionsInformation;
    IdentityProtectionMeasuresOffer;
    InvestigationInitiated;
    UnauthorizedUseSubstantiated;
    ActionOrReferralAgainstPerson;
}
relation secretary_determines_identity_use(u: IdentityUse, i: Person) kind empirical {
    label en unofficial "the Secretary determines that there has been or may have been an unauthorized use of the individual's identity";
}
relation notice_would_jeopardize_tax_administration_investigation(u: IdentityUse) kind empirical {
    label en unofficial "giving the notification would jeopardize an investigation relating to tax administration";
}
relation identity_theft_notice_given(u: IdentityUse, n: IdentityTheftNotice) kind empirical {
    label en unofficial "the Secretary gives the individual (or the individual's designee) the named notification";
}
relation employment_related_identity_use(u: IdentityUse) kind empirical {
    label en unofficial "the unauthorized use is use of the individual's identity to obtain employment (included in the section by (b)(1))";
}
relation secretary_reviewed_mismatch_information(u: IdentityUse) kind empirical {
    label en unofficial "the Secretary reviewed information from section 6051 statements, information returns for compensation, or Social Security Administration information indicating that the SSN does not correspond with the name";
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "notify the individual of such determination")
rule S7529NotifyDeterminationDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529NotifyOfDetermination {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, NotifyOfDetermination);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "provide instructions on how to file a report with law enforcement regarding the unauthorized use")
rule S7529LawEnforcementInstructionsDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529ProvideLawEnforcementReportInstructions {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, LawEnforcementReportInstructions);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "identify any steps to be taken by the individual to permit law enforcement to access personal information of the individual during the investigation")
rule S7529AccessStepsDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529IdentifyStepsForLawEnforcementAccess {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, StepsToPermitLawEnforcementAccess);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "provide information regarding actions the individual may take in order to protect the individual from harm relating to the unauthorized use")
rule S7529ProtectiveActionsDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529ProvideProtectiveActionInformation {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, ProtectiveActionsInformation);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "offer identity protection measures to the individual, such as the use of an identity protection personal identification number")
rule S7529ProtectionOfferDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529OfferIdentityProtection {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, IdentityProtectionMeasuresOffer);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "whether an investigation has been initiated in regards to such unauthorized use")
rule S7529InvestigationNoticeDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529NotifyInvestigationInitiated {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, InvestigationInitiated);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "whether the investigation substantiated an unauthorized use of the identity of the individual")
rule S7529SubstantiationNoticeDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529NotifyUnauthorizedUseSubstantiated {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, UnauthorizedUseSubstantiated);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
@source(IRC_S7529_A, relation = formalizes, coverage = exact, quote = "any action has been taken against a person relating to such unauthorized use, or")
rule S7529ActionOrReferralNoticeDuty defeasible {
    for u: IdentityUse;
    for i: Person;
    when secretary_determines_identity_use(u, i);
    then duty S7529NotifyActionOrReferral {
        bearer Secretary;
        beneficiary i;
        goal achievement {
            condition identity_theft_notice_given(u, ActionOrReferralAgainstPerson);
            window [-infinity, infinity];
        }
    };
    unless notice_would_jeopardize_tax_administration_investigation(u) and secretary_determines_identity_use(u, i);
}
relation identity_use_includes_employment(u: IdentityUse) kind derived {
    label en unofficial "the unauthorized use includes use of the identity to obtain employment (§7529(b)(1))";
}
@source(IRC_S7529_B, relation = formalizes, coverage = exact, quote = "the unauthorized use of the identity of an individual includes the unauthorized use of the identity of the individual to obtain employment")
rule S7529EmploymentIsIdentityUse strict {
    for u: IdentityUse;
    when employment_related_identity_use(u);
    then identity_use_includes_employment(u);
}
@source(IRC_S7529_B, relation = formalizes, coverage = exact, quote = "the Secretary shall review any information—")
rule S7529ReviewMismatchDuty defeasible {
    for u: IdentityUse;
    when employment_related_identity_use(u);
    then duty S7529ReviewNameNumberMismatchInformation {
        bearer Secretary;
        goal achievement {
            condition secretary_reviewed_mismatch_information(u);
            window [-infinity, infinity];
        }
    };
}

// --- §7530: earned income tax credit payments to Puerto Rico and possessions ---------------

relation calendar_year_of_payment(cy: Integer) kind empirical {
    label en unofficial "a calendar year for which payments are determined";
}
relation pr_eitc_cost_for_calendar_year(cy: Integer, cost: Money) kind empirical {
    label en unofficial "the cost to Puerto Rico of its earned income tax credit for taxable years beginning in or with the calendar year, determined on the basis of Puerto Rico law (reductions in revenues and refunds, no administrative costs)";
}
relation pr_eitc_cost_for_2019(cost: Money) kind empirical {
    label en unofficial "the cost to Puerto Rico of the earned income tax credit for taxable years beginning in or with calendar year 2019";
}
relation cola_with_2020_base_year(cy: Integer, pct: Decimal) kind empirical {
    label en unofficial "the cost-of-living adjustment under section 1(f)(3) for the calendar year, substituting calendar year 2020 for calendar year 2016 (owner: income-individual)";
}
relation pr_education_expenditures(cy: Integer, amt: Money) kind empirical {
    label en unofficial "expenditures by Puerto Rico during the calendar year for education efforts on the earned income tax credit for individual taxpayers and return preparers";
}
relation pr_has_qualifying_eitc(cy: Integer) kind empirical {
    label en unofficial "Puerto Rico has in effect an earned income tax credit for taxable years beginning in or with the calendar year that, relative to the credit in effect for 2019, increases the percentage of earned income allowed for each group in a manner designed to substantially increase workforce participation";
}
pub relation pr_base_amount_2021(base: Money) kind institutional {
    label en unofficial "base amount for 2021: the greater of the 2019 cost rounded to the nearest multiple of $1,000,000 and $200,000,000";
}
pub relation pr_base_amount(cy: Integer, base: Money) kind institutional {
    label en unofficial "base amount for the calendar year (2021: as above; after 2021: the 2021 amount increased by the section 1(f)(3) adjustment with a 2020 base year, rounded to the nearest $1,000,000)";
}
pub relation pr_specified_matching_amount(cy: Integer, amt: Money) kind institutional {
    label en unofficial "the lesser of the excess of the credit cost over the base amount and three times the base amount (§7530(a)(3))";
}
pub relation pr_payment_due(cy: Integer, amt: Money) kind institutional {
    label en unofficial "the payment to Puerto Rico for the calendar year: the specified matching amount plus, for 2021 through 2025, the lesser of its education expenditures and $1,000,000";
}
pub relation pr_payment_made(cy: Integer, amt: Money) kind empirical {
    label en unofficial "the Secretary makes the payment to Puerto Rico for the calendar year";
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "the cost to Puerto Rico of the earned income tax credit for taxable years beginning in or with calendar year 2019 (rounded to the nearest multiple of $1,000,000), or")
rule S7530PrBase2021 strict {
    for cost: Money;
    when pr_eitc_cost_for_2019(cost);
    then pr_base_amount_2021(max(div_round(cost, 1000000.0, 0, "HALF_UP") * 1000000, 200000000.00 USD));
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "In the case of calendar year 2021, the term \"base amount\" means the greater of—")
rule S7530PrBaseFor2021 strict {
    for base: Money;
    when pr_base_amount_2021(base);
    then pr_base_amount(2021, base);
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "the term \"base amount\" means the dollar amount determined under clause (i) increased by an amount equal to")
rule S7530PrBaseAfter2021 strict {
    for cy: Integer;
    for base: Money;
    for cola: Decimal;
    when pr_base_amount_2021(base)
        and cola_with_2020_base_year(cy, cola)
        and cy > 2021;
    then pr_base_amount(cy, div_round(base * (1.0 + cola), 1000000.0, 0, "HALF_UP") * 1000000);
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "the product of 3, multiplied by the base amount for such calendar year")
rule S7530PrSpecifiedMatchingAmount strict {
    for cy: Integer;
    for cost: Money;
    for base: Money;
    when pr_eitc_cost_for_calendar_year(cy, cost)
        and pr_base_amount(cy, base);
    then pr_specified_matching_amount(cy, min(max(0.00 USD, cost - base), base * 3));
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "the expenditures made by Puerto Rico during such calendar year for education efforts with respect to individual taxpayers and tax return preparers relating to the earned income tax credit")
rule S7530PrPaymentWithEducation strict {
    for cy: Integer;
    for spec_amt: Money;
    for edu: Money;
    when pr_specified_matching_amount(cy, spec_amt)
        and pr_education_expenditures(cy, edu)
        and cy >= 2021
        and cy <= 2025
        and pr_has_qualifying_eitc(cy);
    then pr_payment_due(cy, spec_amt + min(edu, 1000000.00 USD));
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "With respect to calendar year 2021 and each calendar year thereafter, the Secretary shall, except as otherwise provided in this subsection, make payments to Puerto Rico equal to—")
rule S7530PrPaymentAfter2025 strict {
    for cy: Integer;
    for spec_amt: Money;
    when pr_specified_matching_amount(cy, spec_amt)
        and cy > 2025
        and pr_has_qualifying_eitc(cy);
    then pr_payment_due(cy, spec_amt);
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "the Secretary shall, except as otherwise provided in this subsection, make payments to Puerto Rico equal to—")
rule S7530PrPaymentDuty defeasible {
    for cy: Integer;
    for amt: Money;
    when pr_payment_due(cy, amt);
    then duty S7530PayPuertoRico {
        bearer Secretary;
        beneficiary PuertoRico;
        goal achievement {
            condition pr_payment_made(cy, amt);
            window [-infinity, infinity];
        }
    };
}
relation pr_required_information_received_on(cy: Integer, d: Date) kind empirical {
    label en unofficial "the date the Secretary receives the information required to determine the payment";
}
relation pr_individual_return_due_date(cy: Integer, d: Date) kind empirical {
    label en unofficial "the due date for individual income tax returns under Puerto Rico law for taxable years that began on the first day of the calendar year";
}
@source(IRC_S7530_A, relation = formalizes, coverage = partial, quote = "within a reasonable period of time before the due date for individual income tax returns (as determined under the laws of Puerto Rico)")
rule S7530PrTimelyPaymentDuty defeasible {
    for cy: Integer;
    for amt: Money;
    for got: Date;
    for due: Date;
    when pr_payment_due(cy, amt)
        and pr_required_information_received_on(cy, got)
        and pr_individual_return_due_date(cy, due);
    then duty S7530PayPuertoRicoBeforeReturnDueDate {
        bearer Secretary;
        beneficiary PuertoRico;
        goal achievement {
            condition pr_payment_made(cy, amt);
            window [got, due];
        }
    };
}
const PuertoRico: Person = entity_ref("urn:us:irc:administration:clir#PuertoRico") {
    label en official "Puerto Rico";
}
relation payment_made_to_pr_without_qualifying_eitc(cy: Integer) kind derived {
    label en unofficial "a payment is made to Puerto Rico for a calendar year for which it has no qualifying earned income tax credit";
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "The Secretary shall not make any payments under paragraph (1) with respect to any calendar year unless Puerto Rico has in effect an earned income tax credit")
rule S7530PrPaymentWithoutEitc strict {
    for cy: Integer;
    for amt: Money;
    when pr_payment_made(cy, amt)
        and not_known(pr_has_qualifying_eitc(cy));
    then payment_made_to_pr_without_qualifying_eitc(cy);
}
@source(IRC_S7530_A, relation = formalizes, coverage = exact, quote = "The Secretary shall not make any payments under paragraph (1) with respect to any calendar year unless Puerto Rico has in effect an earned income tax credit")
rule S7530PrEitcProhibition strict {
    for cy: Integer;
    when payment_made_to_pr_without_qualifying_eitc(cy);
    then prohibition S7530NoPuertoRicoPaymentWithoutEitcReform {
        bearer Secretary;
        beneficiary PuertoRico;
        action payment_made_to_pr_without_qualifying_eitc(cy);
        window [-infinity, infinity];
    };
}
enum MirrorCodePossession {
    VirginIslands;
    Guam;
    NorthernMarianaIslands;
}
relation possession_eitc_cost(pos: MirrorCodePossession, cy: Integer, cost: Money) kind empirical {
    label en unofficial "the cost to the possession of the earned income tax credit for taxable years beginning in or with the calendar year";
}
relation possession_education_expenditures(pos: MirrorCodePossession, cy: Integer, amt: Money) kind empirical {
    label en unofficial "expenditures by the possession during the calendar year for education efforts on its earned income tax credit";
}
pub relation possession_payment_due(pos: MirrorCodePossession, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the payment to a mirror code possession: the cost of the earned income tax credit plus, for 2021 through 2025, the lesser of its education expenditures and $50,000";
}
@source(IRC_S7530_B, relation = formalizes, coverage = exact, quote = "the expenditures made by such possession during such calendar year for education efforts with respect to individual taxpayers and tax return preparers relating to such earned income tax credit")
rule S7530PossessionPaymentWithEducation strict {
    for pos: MirrorCodePossession;
    for cy: Integer;
    for cost: Money;
    for edu: Money;
    when possession_eitc_cost(pos, cy, cost)
        and possession_education_expenditures(pos, cy, edu)
        and cy >= 2021
        and cy <= 2025;
    then possession_payment_due(pos, cy, cost + min(edu, 50000.00 USD));
}
@source(IRC_S7530_B, relation = formalizes, coverage = exact, quote = "the cost to such possession of the earned income tax credit for taxable years beginning in or with such calendar year")
rule S7530PossessionPaymentAfter2025 strict {
    for pos: MirrorCodePossession;
    for cy: Integer;
    for cost: Money;
    when possession_eitc_cost(pos, cy, cost)
        and cy > 2025;
    then possession_payment_due(pos, cy, cost);
}
relation possession_payment_made(pos: MirrorCodePossession, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the Secretary makes the payment to the possession for the calendar year";
}
@source(IRC_S7530_B, relation = formalizes, coverage = exact, quote = "the Secretary shall, except as otherwise provided in this subsection, make payments to the Virgin Islands, Guam, and the Commonwealth of the Northern Mariana Islands equal to—")
rule S7530PossessionPaymentDuty defeasible {
    for pos: MirrorCodePossession;
    for cy: Integer;
    for amt: Money;
    when possession_payment_due(pos, cy, amt);
    then duty S7530PayMirrorCodePossession {
        bearer Secretary;
        goal achievement {
            condition possession_payment_made(pos, cy, amt);
            window [-infinity, infinity];
        }
    };
}
relation american_samoa_eitc_cost(cy: Integer, cost: Money) kind empirical {
    label en unofficial "the cost to American Samoa of the earned income tax credit for taxable years beginning in or with the calendar year";
}
relation american_samoa_education_expenditures(cy: Integer, amt: Money) kind empirical {
    label en unofficial "expenditures by American Samoa during the calendar year for education efforts on its earned income tax credit";
}
relation american_samoa_has_refundable_eitc(cy: Integer) kind empirical {
    label en unofficial "American Samoa has in effect for taxable years beginning in or with the calendar year an earned income tax credit that allows a refundable credit to individuals on the basis of earned income, designed to substantially increase workforce participation";
}
pub relation american_samoa_cap(cy: Integer, cap: Money) kind institutional {
    label en unofficial "the $16,000,000 cap; after 2021 increased by the section 1(f)(3) adjustment with a 2020 base year, rounded to the nearest $100,000";
}
pub relation american_samoa_payment_due(cy: Integer, amt: Money) kind institutional {
    label en unofficial "the payment to American Samoa: the lesser of the credit cost and the cap, plus for 2021 through 2025 the lesser of its education expenditures and $50,000";
}
@source(IRC_S7530_C, relation = formalizes, coverage = exact, quote = "(ii) $16,000,000, plus")
rule S7530AsCap2021 strict {
    for cy: Integer;
    when calendar_year_of_payment(cy)
        and cy == 2021;
    then american_samoa_cap(cy, 16000000.00 USD);
}
@source(IRC_S7530_C, relation = formalizes, coverage = exact, quote = "the $16,000,000 amount in paragraph (1)(A)(ii) shall be increased by an amount equal to")
rule S7530AsCapAfter2021 strict {
    for cy: Integer;
    for cola: Decimal;
    when cola_with_2020_base_year(cy, cola)
        and cy > 2021;
    then american_samoa_cap(cy, div_round(16000000.00 USD * (1.0 + cola), 100000.0, 0, "HALF_UP") * 100000);
}
@source(IRC_S7530_C, relation = formalizes, coverage = exact, quote = "the expenditures made by American Samoa during such calendar year for education efforts")
rule S7530AsPaymentWithEducation strict {
    for cy: Integer;
    for cost: Money;
    for cap: Money;
    for edu: Money;
    when american_samoa_eitc_cost(cy, cost)
        and american_samoa_cap(cy, cap)
        and american_samoa_education_expenditures(cy, edu)
        and american_samoa_has_refundable_eitc(cy)
        and cy >= 2021
        and cy <= 2025;
    then american_samoa_payment_due(cy, min(cost, cap) + min(edu, 50000.00 USD));
}
@source(IRC_S7530_C, relation = formalizes, coverage = exact, quote = "the cost to American Samoa of the earned income tax credit for taxable years beginning in or with such calendar year, or")
rule S7530AsPaymentAfter2025 strict {
    for cy: Integer;
    for cost: Money;
    for cap: Money;
    when american_samoa_eitc_cost(cy, cost)
        and american_samoa_cap(cy, cap)
        and american_samoa_has_refundable_eitc(cy)
        and cy > 2025;
    then american_samoa_payment_due(cy, min(cost, cap));
}
relation american_samoa_payment_made(cy: Integer, amt: Money) kind empirical {
    label en unofficial "the Secretary makes the payment to American Samoa for the calendar year";
}
const AmericanSamoa: Person = entity_ref("urn:us:irc:administration:clir#AmericanSamoa") {
    label en official "American Samoa";
}
@source(IRC_S7530_C, relation = formalizes, coverage = exact, quote = "the Secretary shall, except as otherwise provided in this subsection, make payments to American Samoa equal to—")
rule S7530AsPaymentDuty defeasible {
    for cy: Integer;
    for amt: Money;
    when american_samoa_payment_due(cy, amt);
    then duty S7530PayAmericanSamoa {
        bearer Secretary;
        beneficiary AmericanSamoa;
        goal achievement {
            condition american_samoa_payment_made(cy, amt);
            window [-infinity, infinity];
        }
    };
}
pub relation payments_treated_as_refund_for_31_usc_1324(cy: Integer) kind institutional {
    label en unofficial "the payments under §7530 are treated, for section 1324 of title 31, in the same manner as a refund due from a credit provision referred to in section 1324(b)(2)";
}
@source(IRC_S7530_D, relation = formalizes, coverage = exact, quote = "the payments under this section shall be treated in the same manner as a refund due from a credit provision referred to in subsection (b)(2) of such section")
rule S7530TreatedAsRefund strict {
    for cy: Integer;
    when calendar_year_of_payment(cy);
    then payments_treated_as_refund_for_31_usc_1324(cy);
}
