// 26 U.S.C. Chapters 77, 78, 80 and remainder of Subtitle F — Miscellaneous Administrative Provisions: package skeleton. The text is pinned whole
// (`sources.law`, generated by
// `corpus/tools/sources/sync/sync_us_irc_fragments.py --package administration` from
// the shared Title 26 snapshot, docs/foundations/us-irc/SOURCE-MANIFEST.json).
// Formalization modules are added stage by stage; see
// docs/foundations/us-irc/TASKS.json and DECISION-0379.

// MODULE MAP (stage 1, IRC-17, DECISION-0379)
//   package.law                          — shared ontology, imports, type aliases (this file)
//   01-timely-mailing.law                — §7502 (timely mailing treated as timely filing/paying)
//   02-weekend-holiday-rollover.law      — §7503 (Saturday/Sunday/legal-holiday rollover)
//   03-combat-zone-and-disaster-postponement.law — §7508 (combat zone/contingency operation), §7508A (disaster/fire/terroristic-action postponement)
//   04-trust-fund-and-secretary-authority.law    — §7501 (trust fund status), §7801 (Secretary's administration/enforcement authority), §7805 (regulations), §7806 (construction of title)
//   05-irs-organization.law              — §§7802-7804 (Oversight Board, Commissioner, Chief Counsel, Taxpayer Advocate, Independent Office of Appeals, IRS personnel authority) — institutional facts and powers, not an exhaustive personnel-administration audit trail (see report)
//   06-applicability.law                 — §7851 (applicability of the 1954/1986 Code's subtitles), §7852 (separability, treaty status, other applicable rules)
//   07-fractional-dollar-and-property-administration.law — §7504 (fractional
//     parts of a dollar), §7505 (sale of personal property acquired by the
//     United States), §7506 (administration of real estate acquired by the
//     United States), §7507 (exemption of insolvent banks from tax) — STAGE 2
//
// Remaining stage-2 priority sections (§7508A PL 119-29/119-64 amendments,
// §7502 remainder, computed §7503 rollover beyond the WIRE-1 calendar,
// §7508 remainder, §§7509-7530, ch.77-78 discovery/summons/whistleblower,
// ch.80 §7803/§7811/§7872/§7874 etc.) are addressed in the stage-2 report
// (docs/foundations/us-irc/coverage/administration.json,
// docs/status/2026-09-25-us-irc-administration-stage2.md); most remain
// `unreviewed`/TECH_GAP per that report, not silently dropped.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

import us.irc.core version "0.1.1";

// `us.code.federal_holidays` (5 U.S.C. §6103, the DC/federal holiday
// calendar §7503 needs) — WIRE-1 (25.09.2026, DECISION D-08): the
// coordinator added `pub` to `Holiday`/`observed_holiday_on` there (the one
// visibility change DECISION D-08 authorized outside this package's own
// paths) and wires it in here. See 02-weekend-holiday-rollover.law for the
// bridging rule: the case-asserted `legal_holiday_in_dc` fallback stays
// (the imported calendar is pinned for 2026 only), a NEW derived relation
// reads the import for the years it covers.
import us.code.federal_holidays version "0.1.1";

type Person = us.irc.core::Person;
type Organ = us.irc.core::Organ;
type TaxableYear = us.irc.core::TaxableYear;

const Secretary: Organ = us.irc.core::Secretary;
const IRS: Organ = us.irc.core::IRS;
const DistrictCourt: Organ = us.irc.core::DistrictCourt;
const Congress: Organ = us.irc.core::Congress;
