// 26 U.S.C. 7606(a) — Entry of premises for examination of taxable objects
fragment IRC_S7606_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/7606/a";
    text en official """(a) Entry during day
The Secretary may enter, in the daytime, any building or place where any articles or objects subject to tax are made, produced, or kept, so far as it may be necessary for the purpose of examining said articles or objects.""";
    content_hash "sha256:85ba4ab6b5d8d628a39e819f24d907bc7776e4170dbdd083e0414636cabea528";
}

// 26 U.S.C. 7606(b) — Entry of premises for examination of taxable objects
fragment IRC_S7606_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/7606/b";
    text en official """(b) Entry at night
When such premises are open at night, the Secretary may enter them while so open, in the performance of his official duties.""";
    content_hash "sha256:9594c2835bf1254864069319410c300f0821b505ba5548d9e492907980418257";
}

// 26 U.S.C. 7606(c) — Entry of premises for examination of taxable objects
fragment IRC_S7606_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/7606/c";
    text en official """(c) Penalties
For penalty for refusal to permit entry or examination, see section 7342.""";
    content_hash "sha256:11d4d1c9246298d9b28495009e6d2b2dfa5425e54384b1b044cc25acd2397e6e";
}

