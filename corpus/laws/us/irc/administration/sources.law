    content_hash "sha256:59291f7b0ef41289efa5f7c20694b4268d5a262d984acd239c46421c7005f4f4";
}

// 26 U.S.C. §7874 — statutory note 5 (effectivedate-note)
fragment IRC_S7874_NOTE_5 in IRC_2024_EDITION {
    kind note;
    locator "section/7874/note/5";
    text en official """Effective Date
Pub. L. 108–357, title VIII, §801(c), Oct. 22, 2004, 118 Stat. 1566, provided that: "The amendments made by this section [enacting this section] shall apply to taxable years ending after March 4, 2003." """;
    content_hash "sha256:09996fc8625e7ca2c88934d2b02e9d421acf303f36325d09ef37b273f8ccc202";
