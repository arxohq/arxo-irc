// 26 U.S.C. 7621(a) — Internal revenue districts
fragment IRC_S7621_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/7621/a";
    text en official """(a) Establishment and alteration
The President shall establish convenient internal revenue districts for the purpose of administering the internal revenue laws. The President may from time to time alter such districts.""";
    content_hash "sha256:ecd16ed86ddcf9855a723f88ca7a132c5973e1b9160d9f9ffa5ecf64ac8d3e43";
}

// 26 U.S.C. 7621(b) — Internal revenue districts
fragment IRC_S7621_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/7621/b";
    text en official """(b) Boundaries
For the purpose mentioned in subsection (a), the President may subdivide any State, or the District of Columbia, or may unite into one district two or more States.""";
    content_hash "sha256:cabfcca375b54aa495bfb89fc8eb9ce2ec871229fd2bac71394a01b13e2717d7";
}

