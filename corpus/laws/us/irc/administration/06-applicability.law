// 26 U.S.C. §7851 — Applicability of revenue laws (the 1954/1986 Code's own
// transition from the Internal Revenue Code of 1939); §7852 — other
// applicable rules (separability, treaty status, cross-code references,
// double-counting, Privacy Act).
//
// SCOPE JUDGMENT CALL (see report). §7851(a) is entirely the 1954 Code's own
// historical transition from the 1939 Code (chapter-by-chapter effective
// dates running from 1954-1955), superseded decades ago and carrying no live
// computation any current case needs — it is not "unreviewed" (it has been
// read), but it is NON_NORMATIVE for this stage: no fact pattern a case could
// present today turns on whether Subtitle D took effect January 1, 1955.
// Modelled here, per the task's explicit instruction to capture "the ones
// that fix effective dates of subtitles as institutional facts": the general
// rule's chapter-headline effective dates (§7851(a)(1)-(6)), as historical
// institutional facts, not as rules with a live condition. §7851(b)-(e)
// (savings clauses for 1939-Code rights/offices/delegations/limitations
// periods) are the SAME kind of historical continuity statement and are
// NON_NORMATIVE for the identical reason.
//
// §7852 is different: (a) separability, (c) anti-double-counting, and (d)
// treaty non-preferential status are live, general interpretive rules with
// no expiration, and are modelled as executable readings. (b) (cross-
// reference from the 1939 Code to this title) and (e) (Privacy Act carve-out)
// are institutional facts about OTHER bodies of law, not about this title's
// own operative content; both are modelled where a case-testable predicate
// exists and NON_NORMATIVE otherwise (see coverage).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7851_A,
    IRC_S7852_A,
    IRC_S7852_C,
    IRC_S7852_D,
    Person,
};

// --- §7851(a): historical effective dates of the 1954 Code's subtitles ------

entity Subtitle {
    label en unofficial "a subtitle of the Internal Revenue Code of 1954/1986, for purposes of §7851(a)'s historical transition rule";
}
const SubtitleA: Subtitle = entity_ref("urn:us:irc:administration:clir#SubtitleA") { label en official "Subtitle A — Income Taxes"; }
const SubtitleD: Subtitle = entity_ref("urn:us:irc:administration:clir#SubtitleD") { label en official "Subtitle D — Miscellaneous Excise Taxes"; }
const SubtitleE: Subtitle = entity_ref("urn:us:irc:administration:clir#SubtitleE") { label en official "Subtitle E — Alcohol, Tobacco, and Certain Other Excise Taxes"; }
const SubtitleF: Subtitle = entity_ref("urn:us:irc:administration:clir#SubtitleF") { label en official "Subtitle F — Procedure and Administration"; }

relation subtitle_effective_on(s: Subtitle, d: Date) kind institutional {
    label en unofficial "the historical date on which the named subtitle of the 1954 Code took effect, under §7851(a) — a historical fact, superseded by decades of subsequent law (see module header); no current case-testable condition depends on it";
}
@source(IRC_S7851_A, relation = formalizes, coverage = partial, quote = "Chapters 1, 2, and 6 of this title shall apply only with respect to taxable years beginning after December 31, 1953")
assert subtitle_effective_on(SubtitleA, @1953-12-31);
@source(IRC_S7851_A, relation = formalizes, coverage = exact, quote = "Subtitle D of this title shall take effect on January 1, 1955.")
assert subtitle_effective_on(SubtitleD, @1955-01-01);
@source(IRC_S7851_A, relation = formalizes, coverage = exact, quote = "Subtitle E shall take effect on January 1, 1955")
assert subtitle_effective_on(SubtitleE, @1955-01-01);
@source(IRC_S7851_A, relation = formalizes, coverage = exact, quote = "The provisions of subtitle F shall take effect on the day after the date of enactment of this title")
assert subtitle_effective_on(SubtitleF, @1954-08-17);

// --- §7852(a): separability clause --------------------------------------------

relation provision_held_invalid(provision: Person) kind empirical {
    label en unofficial "a provision of this title, or its application to a person or circumstance, is held invalid";
}
pub relation remainder_unaffected_by_invalidity(provision: Person) kind institutional {
    label en unofficial "the remainder of the title, and the application of the invalid provision to other persons or circumstances, is not affected by the provision being held invalid, under §7852(a)";
}
@source(IRC_S7852_A, relation = formalizes, coverage = exact, quote = "If any provision of this title, or the application thereof to any person or circumstances, is held invalid, the remainder of the title, and the application of such provision to other persons or circumstances, shall not be affected thereby.")
rule S7852Separability strict {
    for provision: Person;
    when provision_held_invalid(provision);
    then remainder_unaffected_by_invalidity(provision);
}

// --- §7852(c): items not twice included in income or deducted ---------------

relation item_taken_into_account_under_subtitle_a(item: Person, p: Person) kind empirical {
    label en unofficial "the item (income, deduction, credit, or otherwise) is taken into account in computing a tax under Subtitle A of this title";
}
relation item_taken_into_account_under_1939_code_ch1_or_2(item: Person, p: Person) kind empirical {
    label en unofficial "the SAME item is also taken into account in computing a tax under chapter 1 or 2 of the Internal Revenue Code of 1939";
}
relation double_counting_expressly_intended(item: Person, p: Person) kind empirical {
    label en unofficial "double counting of this item is otherwise distinctly expressed or manifestly intended (§7852(c)'s own exception)";
}
pub relation double_counted_item_violates_7852c(item: Person, p: Person) kind institutional {
    label en unofficial "the same item was taken into account under both Subtitle A and the 1939 Code chapters 1/2, contrary to §7852(c)";
}
@source(IRC_S7852_C, relation = formalizes, coverage = exact, quote = "the same item (whether of income, deduction, credit, or otherwise) shall not be taken into account both in computing a tax under subtitle A of this title and a tax under chapter 1 or 2 of the Internal Revenue Code of 1939")
rule S7852NoDoubleCounting defeasible {
    for item: Person;
    for p: Person;
    when item_taken_into_account_under_subtitle_a(item, p)
        and item_taken_into_account_under_1939_code_ch1_or_2(item, p);
    then double_counted_item_violates_7852c(item, p);
    unless double_counting_expressly_intended(item, p);
}

// --- §7852(d): treaty obligations ----------------------------------------------

pub relation no_preferential_status_between_treaty_and_title(treaty: Person) kind institutional {
    label en unofficial "for purposes of the relationship between the named treaty and this title, neither has preferential status by reason of being a treaty or a law, under §7852(d)(1)";
}
@source(IRC_S7852_D, relation = formalizes, coverage = exact, quote = "For purposes of determining the relationship between a provision of a treaty and any law of the United States affecting revenue, neither the treaty nor the law shall have preferential status by reason of its being a treaty or law.")
relation treaty_in_question(treaty: Person) kind empirical {
    label en unofficial "the case identifies which treaty's relationship to this title is at issue (binder — the rule is otherwise unconditional over all treaties)";
}
rule S7852TreatyNoPreferentialStatus strict {
    for treaty: Person;
    when treaty_in_question(treaty);
    then no_preferential_status_between_treaty_and_title(treaty);
}

relation title_provision_contrary_to_1954_treaty_obligation(provision: Person, treaty: Person) kind empirical {
    label en unofficial "applying the named title provision (as in effect without a post-1954 amendment) would be contrary to a treaty obligation of the United States in effect on August 16, 1954 (§7852(d)(2) savings-clause gate)";
}
pub relation title_provision_does_not_apply_under_1954_treaty_savings_clause(provision: Person, treaty: Person) kind institutional {
    label en unofficial "the title provision does not apply, under §7852(d)(2)'s savings clause for pre-existing 1954 treaty obligations";
}
@source(IRC_S7852_D, relation = formalizes, coverage = exact, quote = "No provision of this title (as in effect without regard to any amendment thereto enacted after August 16, 1954) shall apply in any case where its application would be contrary to any treaty obligation of the United States in effect on August 16, 1954.")
rule S7852TreatySavingsClause strict {
    for provision: Person;
    for treaty: Person;
    when title_provision_contrary_to_1954_treaty_obligation(provision, treaty);
    then title_provision_does_not_apply_under_1954_treaty_savings_clause(provision, treaty);
}
