// 26 U.S.C. §§7651-7655 — Subchapter D: possessions (administration and
// collection of taxes in possessions; shipments to and from Puerto Rico and
// the Virgin Islands; cover-over of taxes; coordination of United States and
// possession individual income taxes). STAGE 3.
//
// AMENDMENT (PL 119-21 §70427, approved 2025-07-04). §7652(f)(1) now reads
// "$13.25, or" for distilled spirits brought into the United States after
// December 31, 2025. The pinned 2024 base text is "$10.50 ($13.25 ... after June
// 30, 1999, and before January 1, 2022)". No `revision` is declared: the
// package has no consolidated before/after editions to link, and applicability
// turns on the date the spirits are BROUGHT IN (a fact of the transaction), not
// on the date the law is read; the two limits are therefore dated rules keyed
// on that transaction date (a legal_time `effective` window would give the wrong
// answer for a later reading of an older shipment). Scenarios cover before, on
// and after the boundaries (1999-06-30/07-01, 2021-12-31/2022-01-01,
// 2025-12-31/2026-01-01). Between 2022 and 2025 the pinned base text returns
// to $10.50.
//
// JUDGMENT CALLS
//  - The tax on like domestic articles, the section 5001(a)(1) rate and the
//    estimated refunds and drawbacks are case facts (owners: excise-goods,
//    alcohol); nothing is invented.
//  - "Federal excise tax subsidy" is a determination of the Secretary
//    (external judgment) built from the two limbs (i) different kind, (ii)
//    greater amount, which are case facts.
//  - The transfer to a possession is a duty of the Secretary with an open
//    window (the text names no date; §7654(c) says "not less frequently than
//    annually", a maintenance goal, TECH-GAPS G3000).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7651,
    IRC_S7652_A,
    IRC_S7652_B,
    IRC_S7652_C,
    IRC_S7652_D,
    IRC_S7652_E,
    IRC_S7652_F,
    IRC_S7652_G,
    IRC_S7652_H,
    IRC_S7652_I,
    IRC_S7653_A,
    IRC_S7653_B,
    IRC_S7653_C,
    IRC_S7654_A,
    IRC_S7654_B,
    IRC_S7654_C,
    IRC_S7654_D,
    IRC_S7654_E,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// --- §7651: administration and collection of taxes in possessions ---------------------------------

relation is_possession_of_united_states(pos: Person) kind empirical {
    label en unofficial "the territory is a possession of the United States";
}
relation tax_imposed_by_title_in_possession(t: Money, pos: Person) kind empirical {
    label en unofficial "a tax is imposed by this title in the possession (amount)";
}
relation covered_into_treasury_of_possession_by_organic_act(pos: Person) kind empirical {
    label en unofficial "the proceeds are covered into the treasury of the Virgin Islands or Guam under section 28(a) of the Revised Organic Act of the Virgin Islands or section 30 of the Organic Act of Guam";
}
pub relation us_administrative_laws_extend_to_possession(pos: Person) kind institutional {
    label en unofficial "the laws of the United States applicable to assessment and collection of any tax or liability under this title (including penalties), and to administration, collection and enforcement of taxes imposed in the possession, apply there as if it were a State and the term \"United States\" in a geographical sense included it";
}
@source(IRC_S7651, relation = formalizes, coverage = exact, quote = "shall, in respect of such tax or liability, extend to and be applicable in any possession of the United States in the same manner and to the same extent as if such possession were a State")
rule S7651LawsExtendToPossession strict {
    for pos: Person;
    when is_possession_of_united_states(pos);
    then us_administrative_laws_extend_to_possession(pos);
}
relation possession_tax_paid_into_treasury_as_collections(pos: Person) kind empirical {
    label en unofficial "the tax is paid into the Treasury of the United States as internal revenue collections";
}
@source(IRC_S7651, relation = formalizes, coverage = exact, quote = "Such tax shall be collected under the direction of the Secretary, and shall be paid into the Treasury of the United States as internal revenue collections")
rule S7651CollectionDuty defeasible {
    for pos: Person;
    for amt: Money;
    when is_possession_of_united_states(pos)
        and tax_imposed_by_title_in_possession(amt, pos);
    then duty S7651CollectAndPayIntoTreasury {
        bearer Secretary;
        goal maintenance {
            condition possession_tax_paid_into_treasury_as_collections(pos);
            window [-infinity, infinity];
        }
    };
    unless covered_into_treasury_of_possession_by_organic_act(pos) and is_possession_of_united_states(pos) and tax_imposed_by_title_in_possession(amt, pos);
}

// --- §7652: shipments to the United States from Puerto Rico and the Virgin Islands ----------------------------

entity ShippedArticle {
    label en unofficial "an article of merchandise coming into the United States from Puerto Rico or the Virgin Islands";
}
enum ShipmentOrigin {
    OriginPuertoRico;
    OriginVirginIslands;
}
relation article_origin(a: ShippedArticle, o: ShipmentOrigin) kind empirical {
    label en unofficial "the article is of the named origin";
}
relation article_withdrawn_for_consumption_or_sale(a: ShippedArticle) kind empirical {
    label en unofficial "the article is withdrawn for consumption or sale in the United States";
}
relation section_5314_applies(a: ShippedArticle) kind empirical {
    label en unofficial "section 5314 applies to the article (the exception of (a)(1) and (b)(1))";
}
relation us_tax_on_like_domestic_article(a: ShippedArticle, tax: Money) kind empirical {
    label en unofficial "the internal revenue tax imposed in the United States upon the like article of domestic manufacture (owner: excise-goods)";
}
pub relation importation_tax_on_possession_article(a: ShippedArticle, tax: Money) kind institutional {
    label en unofficial "the tax imposed upon the article coming into the United States: equal to the tax on the like domestic article (Puerto Rican articles when withdrawn for consumption or sale)";
}
@source(IRC_S7652_A, relation = formalizes, coverage = exact, quote = "articles of merchandise of Puerto Rican manufacture coming into the United States and withdrawn for consumption or sale shall be subject to a tax equal to the internal revenue tax imposed in the United States upon the like articles of merchandise of domestic manufacture")
rule S7652PuertoRicoArticleTax defeasible {
    for a: ShippedArticle;
    for tax: Money;
    when article_origin(a, OriginPuertoRico)
        and article_withdrawn_for_consumption_or_sale(a)
        and us_tax_on_like_domestic_article(a, tax);
    then importation_tax_on_possession_article(a, tax);
    unless section_5314_applies(a) and article_origin(a, OriginPuertoRico) and article_withdrawn_for_consumption_or_sale(a) and us_tax_on_like_domestic_article(a, tax);
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "there shall be imposed in the United States, upon articles coming into the United States from the Virgin Islands, a tax equal to the internal revenue tax imposed in the United States upon like articles of domestic manufacture")
rule S7652VirginIslandsArticleTax defeasible {
    for a: ShippedArticle;
    for tax: Money;
    when article_origin(a, OriginVirginIslands)
        and us_tax_on_like_domestic_article(a, tax);
    then importation_tax_on_possession_article(a, tax);
    unless section_5314_applies(a) and article_origin(a, OriginVirginIslands) and us_tax_on_like_domestic_article(a, tax);
}
relation regulations_prescribe_puerto_rico_payment_mode_and_time(o: Organ) kind empirical {
    label en unofficial "the Secretary has prescribed by regulations the mode and time for payment and collection of the Puerto Rico importation tax, including any discretionary method of section 6302(b) and (c), and authorizing payment before shipment from Puerto Rico";
}
@source(IRC_S7652_A, relation = formalizes, coverage = exact, quote = "The Secretary shall by regulations prescribe the mode and time for payment and collection of the tax described in paragraph (1)")
rule S7652PaymentRegulationsDuty strict {
    when true;
    then duty S7652PrescribePaymentRegulations {
        bearer Secretary;
        goal maintenance {
            condition regulations_prescribe_puerto_rico_payment_mode_and_time(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation virgin_islands_article_shipped_to_us(a: ShippedArticle) kind empirical {
    label en unofficial "the article is shipped from the Virgin Islands to the United States";
}
pub relation exempt_from_virgin_islands_internal_revenue_tax(a: ShippedArticle) kind institutional {
    label en unofficial "the article shipped from the Virgin Islands to the United States is exempt from any tax imposed by the internal revenue laws of the islands";
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "Such articles shipped from such islands to the United States shall be exempt from the payment of any tax imposed by the internal revenue laws of such islands.")
rule S7652VirginIslandsExemption strict {
    for a: ShippedArticle;
    when virgin_islands_article_shipped_to_us(a);
    then exempt_from_virgin_islands_internal_revenue_tax(a);
}

// (c), (d): what counts as produced in Puerto Rico or the Virgin Islands
relation article_contains_distilled_spirits(a: ShippedArticle) kind empirical {
    label en unofficial "the article contains distilled spirits";
}
relation share_of_alcohol_attributable_to_rum(a: ShippedArticle, share: Decimal) kind empirical {
    label en unofficial "the share of the alcoholic content of the article attributable to rum";
}
relation value_of_materials_produced_in_puerto_rico(a: ShippedArticle, amt: Money) kind empirical {
    label en unofficial "the cost or value of the materials produced in Puerto Rico";
}
relation direct_costs_of_processing_in_puerto_rico(a: ShippedArticle, amt: Money) kind empirical {
    label en unofficial "the direct costs of processing operations performed in Puerto Rico (meaning as in section 213 of the Caribbean Basin Economic Recovery Act)";
}
relation article_value_when_brought_into_us(a: ShippedArticle, amt: Money) kind empirical {
    label en unofficial "the value of the article as of the time it is brought into the United States";
}
pub relation treated_as_produced_in_possession(a: ShippedArticle) kind institutional {
    label en unofficial "the article is treated as produced in Puerto Rico or the Virgin Islands for purposes of the cover-over of (a)(3) and (b)(3)";
}
@source(IRC_S7652_C, relation = formalizes, coverage = exact, quote = "unless at least 92 percent of the alcoholic content in such article is attributable to rum")
rule S7652SpiritsProducedIfRum92 strict {
    for a: ShippedArticle;
    for share: Decimal;
    when article_contains_distilled_spirits(a)
        and share_of_alcohol_attributable_to_rum(a, share)
        and share >= 0.92;
    then treated_as_produced_in_possession(a);
}
@source(IRC_S7652_D, relation = formalizes, coverage = exact, quote = "equals or exceeds 50 percent of the value of such article as of the time it is brought into the United States")
rule S7652NonSpiritsProducedIfValueAdded strict {
    for a: ShippedArticle;
    for mat: Money;
    for proc: Money;
    for value: Money;
    when article_origin(a, OriginPuertoRico)
        and not_known(article_contains_distilled_spirits(a))
        and value_of_materials_produced_in_puerto_rico(a, mat)
        and direct_costs_of_processing_in_puerto_rico(a, proc)
        and article_value_when_brought_into_us(a, value)
        and mat + proc >= value * 0.5;
    then treated_as_produced_in_possession(a);
}
@source(IRC_S7652_D, relation = formalizes, coverage = partial, quote = "Any article, other than an article containing distilled spirits, shall in no event be treated as produced in Puerto Rico unless")
rule S7652VirginIslandsNonSpirits strict {
    for a: ShippedArticle;
    when article_origin(a, OriginVirginIslands)
        and not_known(article_contains_distilled_spirits(a))
        and virgin_islands_article_shipped_to_us(a);
    then treated_as_produced_in_possession(a);
}

// (d)(2): federal excise tax subsidies
relation possession_subsidy_kind_differs_from_general(a: ShippedArticle) kind empirical {
    label en unofficial "the subsidy provided by Puerto Rico or the Virgin Islands for the article is of a kind different from the subsidy offered generally to industries producing articles not subject to Federal excise taxes";
}
relation possession_subsidy_amount_greater_than_general(a: ShippedArticle) kind empirical {
    label en unofficial "the subsidy for the article is in an amount per value or volume of production greater than the general subsidy";
}
relation federal_excise_tax_subsidy_established(a: ShippedArticle) kind derived {
    label en unofficial "a Federal excise tax subsidy is provided: a subsidy of a different kind or in a greater amount per value or volume than the general subsidy";
}
external judgment relation secretary_determines_federal_excise_tax_subsidy(a: ShippedArticle) {
    authority Secretary;
    label en unofficial "the Secretary determines that a Federal excise tax subsidy was provided by Puerto Rico or the Virgin Islands with respect to the article (§7652(d)(2)(A))";
}
@source(IRC_S7652_D, relation = formalizes, coverage = exact, quote = "of a kind different from, or")
rule S7652SubsidyDifferentKind strict {
    for a: ShippedArticle;
    when possession_subsidy_kind_differs_from_general(a);
    then federal_excise_tax_subsidy_established(a);
}
@source(IRC_S7652_D, relation = formalizes, coverage = exact, quote = "in an amount per value or volume of production greater than,")
rule S7652SubsidyGreaterAmount strict {
    for a: ShippedArticle;
    when possession_subsidy_amount_greater_than_general(a);
    then federal_excise_tax_subsidy_established(a);
}

// (a)(3), (b)(3), (e), (f)-(i): cover-over
relation taxes_collected_on_possession_articles(o: ShipmentOrigin, amt: Money) kind empirical {
    label en unofficial "all taxes imposed by and collected under the internal revenue laws of the United States on articles produced in the possession and transported to the United States, or (Puerto Rico) consumed in the island";
}
relation estimated_refunds_and_drawbacks(o: ShipmentOrigin, amt: Money) kind empirical {
    label en unofficial "the estimated amount necessary for payment of refunds and drawbacks (Virgin Islands: refunds or credits)";
}
pub relation puerto_rico_cover_over_amount(amt: Money) kind institutional {
    label en unofficial "the taxes collected on articles produced in Puerto Rico and transported to the United States, or consumed in the island, less the estimated refunds and drawbacks, covered into the treasury of Puerto Rico (§7652(a)(3))";
}
pub relation virgin_islands_cover_over_pool(amt: Money) kind institutional {
    label en unofficial "the amount determined by the Secretary on articles produced in the Virgin Islands, less 1 percent and less estimated refunds or credits, subject to disposition under (b)(3)(A)-(B)";
}
@source(IRC_S7652_A, relation = formalizes, coverage = exact, quote = "All taxes collected under the internal revenue laws of the United States on articles produced in Puerto Rico and transported to the United States (less the estimated amount necessary for payment of refunds and drawbacks), or consumed in the island, shall be covered into the treasury of Puerto Rico.")
rule S7652PuertoRicoCoverOverAmount strict {
    for collected: Money;
    for refunds: Money;
    when taxes_collected_on_possession_articles(OriginPuertoRico, collected)
        and estimated_refunds_and_drawbacks(OriginPuertoRico, refunds);
    then puerto_rico_cover_over_amount(max(0.00 USD, collected - refunds));
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "The amount so determined less 1 percent and less the estimated amount of refunds or credits shall be subject to disposition as follows:")
rule S7652VirginIslandsPool strict {
    for collected: Money;
    for refunds: Money;
    when taxes_collected_on_possession_articles(OriginVirginIslands, collected)
        and estimated_refunds_and_drawbacks(OriginVirginIslands, refunds);
    then virgin_islands_cover_over_pool(max(0.00 USD, round(collected * 0.99, 2, "HALF_UP") - refunds));
}
relation puerto_rico_cover_over_made(amt: Money) kind empirical {
    label en unofficial "the Secretary covers the amount into the treasury of Puerto Rico";
}
@source(IRC_S7652_A, relation = formalizes, coverage = exact, quote = "shall be covered into the treasury of Puerto Rico")
rule S7652PuertoRicoCoverOverDuty defeasible {
    for amt: Money;
    when puerto_rico_cover_over_amount(amt)
        and amt > 0.00 USD;
    then duty S7652CoverOverToPuertoRico {
        bearer Secretary;
        goal achievement {
            condition puerto_rico_cover_over_made(amt);
            window [-infinity, infinity];
        }
    };
}
relation virgin_islands_estimated_payment_made_before_fiscal_year(amt: Money) kind empirical {
    label en unofficial "the payment of an estimated amount is made to the government of the Virgin Islands before the commencement of each fiscal year, as set forth in section 4(c)(2) of the Act of August 18, 1978 (48 U.S.C. 1645)";
}
relation virgin_islands_remainder_deposited_as_miscellaneous_receipts(amt: Money) kind empirical {
    label en unofficial "any amounts remaining are deposited in the Treasury of the United States as miscellaneous receipts";
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "The payment of an estimated amount shall be made to the government of the Virgin Islands before the commencement of each fiscal year")
rule S7652VirginIslandsPaymentDuty defeasible {
    for amt: Money;
    when virgin_islands_cover_over_pool(amt)
        and amt > 0.00 USD;
    then duty S7652PayVirginIslandsEstimatedAmount {
        bearer Secretary;
        goal achievement {
            condition virgin_islands_estimated_payment_made_before_fiscal_year(amt);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "Any amounts remaining shall be deposited in the Treasury of the United States as miscellaneous receipts.")
rule S7652VirginIslandsRemainderDuty defeasible {
    for amt: Money;
    when virgin_islands_cover_over_pool(amt)
        and amt > 0.00 USD;
    then duty S7652DepositVirginIslandsRemainder {
        bearer Secretary;
        goal achievement {
            condition virgin_islands_remainder_deposited_as_miscellaneous_receipts(amt);
            window [-infinity, infinity];
        }
    };
}
relation unobligated_federal_contribution_balance(fy: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the unobligated and unexpended balance at the end of the fiscal year of the Federal contribution made for the four preceding calendar quarters";
}
pub relation balance_available_for_emergency_and_essential_projects(fy: TaxableYear, amt: Money) kind institutional {
    label en unofficial "the part of the carried-over balance that remains available, only for emergency relief purposes and essential public projects, not exceeding $5,000,000 in the aggregate";
}
pub relation excess_balance_transferred_to_treasury(fy: TaxableYear, amt: Money) kind institutional {
    label en unofficial "the balance above $5,000,000 that is transferred and paid over to the Treasury as miscellaneous receipts";
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "The aggregate amount of moneys available for expenditure for emergency relief purposes and essential public projects only shall not exceed the sum of $5,000,000 at the end of any fiscal year.")
rule S7652CarryoverAvailable strict {
    for fy: TaxableYear;
    for bal: Money;
    when unobligated_federal_contribution_balance(fy, bal);
    then balance_available_for_emergency_and_essential_projects(fy, min(bal, 5000000.00 USD));
}
@source(IRC_S7652_B, relation = formalizes, coverage = exact, quote = "shall thereupon be transferred and paid over to the Treasury of the United States as miscellaneous receipts")
rule S7652CarryoverExcess strict {
    for fy: TaxableYear;
    for bal: Money;
    when unobligated_federal_contribution_balance(fy, bal)
        and bal > 5000000.00 USD;
    then excess_balance_transferred_to_treasury(fy, bal - 5000000.00 USD);
}
relation cover_over_made_for_article_with_subsidy(a: ShippedArticle) kind empirical {
    label en unofficial "an amount is transferred under (a)(3) or (b)(3) in respect of taxes imposed on an article other than one containing distilled spirits";
}
relation cover_over_transferred_despite_subsidy(a: ShippedArticle) kind derived {
    label en unofficial "an amount is transferred for an article on which the Secretary determined a Federal excise tax subsidy was provided";
}
@source(IRC_S7652_D, relation = formalizes, coverage = exact, quote = "No amount shall be transferred under subsection (a)(3) or (b)(3) in respect of taxes imposed on any article, other than an article containing distilled spirits, if the Secretary determines that a Federal excise tax subsidy was provided")
rule S7652TransferDespiteSubsidy strict {
    for a: ShippedArticle;
    when cover_over_made_for_article_with_subsidy(a)
        and not_known(article_contains_distilled_spirits(a))
        and secretary_determines_federal_excise_tax_subsidy(a)
        and federal_excise_tax_subsidy_established(a);
    then cover_over_transferred_despite_subsidy(a);
}
@source(IRC_S7652_D, relation = formalizes, coverage = exact, quote = "No amount shall be transferred under subsection (a)(3) or (b)(3) in respect of taxes imposed on any article, other than an article containing distilled spirits")
rule S7652NoTransferProhibition strict {
    for a: ShippedArticle;
    when cover_over_transferred_despite_subsidy(a);
    then prohibition S7652NoCoverOverOnSubsidizedArticle {
        bearer Secretary;
        action cover_over_transferred_despite_subsidy(a);
        window [-infinity, infinity];
    };
}
// (e) rum
relation rum_taxes_collected_under_5001a1(amt: Money) kind empirical {
    label en unofficial "taxes collected under section 5001(a)(1) on rum imported into the United States";
}
relation rum_estimated_refunds_and_drawbacks(amt: Money) kind empirical {
    label en unofficial "the estimated amount necessary for payment of refunds and drawbacks on rum";
}
relation rum_subject_to_tax_under_a_or_b(amt: Money) kind empirical {
    label en unofficial "the rum is subject to tax under subsection (a) or (b) (the (e)(4) coordination rule)";
}
pub relation rum_cover_over_amount(amt: Money) kind institutional {
    label en unofficial "the taxes collected under section 5001(a)(1) on rum imported into the United States, less estimated refunds and drawbacks, covered into the treasuries of Puerto Rico and the Virgin Islands";
}
@source(IRC_S7652_E, relation = formalizes, coverage = exact, quote = "All taxes collected under section 5001(a)(1) on rum imported into the United States (less the estimated amount necessary for payment of refunds and drawbacks) shall be covered into the treasuries of Puerto Rico and the Virgin Islands.")
rule S7652RumCoverOver defeasible {
    for collected: Money;
    for refunds: Money;
    when rum_taxes_collected_under_5001a1(collected)
        and rum_estimated_refunds_and_drawbacks(refunds);
    then rum_cover_over_amount(max(0.00 USD, collected - refunds));
    unless rum_subject_to_tax_under_a_or_b(collected) and rum_taxes_collected_under_5001a1(collected) and rum_estimated_refunds_and_drawbacks(refunds);
}
relation secretary_prescribes_rum_division_formula(o: Organ) kind empirical {
    label en unofficial "the Secretary from time to time prescribes by regulation a formula for dividing the rum tax collections between Puerto Rico and the Virgin Islands and the timing and methods of transfer";
}
@source(IRC_S7652_E, relation = formalizes, coverage = exact, quote = "The Secretary shall, from time to time, prescribe by regulation a formula for the division of such tax collections between Puerto Rico and the Virgin Islands")
rule S7652RumFormulaDuty strict {
    when true;
    then duty S7652PrescribeRumDivisionFormula {
        bearer Secretary;
        goal maintenance {
            condition secretary_prescribes_rum_division_formula(Secretary);
            window [-infinity, infinity];
        }
    };
}
// (f) limitation on cover over of distilled spirits
relation spirits_brought_into_us_on(s: Person, d: Date) kind empirical {
    label en unofficial "the distilled spirits are brought into the United States on this date";
}
relation section_5001a1_rate_per_proof_gallon(rate: Money) kind empirical {
    label en unofficial "the tax imposed under section 5001(a)(1) on each proof gallon, determined as if subsection (c)(1) of that section did not apply (owner: alcohol)";
}
relation statutory_cover_over_ceiling_per_proof_gallon(s: Person, ceiling: Money) kind derived {
    label en unofficial "the statutory rate ceiling in (f)(1) for the date the spirits are brought in";
}
pub relation cover_over_rate_limit_per_proof_gallon(s: Person, limit: Money) kind institutional {
    label en unofficial "the lesser of the (f)(1) rate and the (f)(2) section 5001(a)(1) rate: the most that may be covered into the treasuries of Puerto Rico and the Virgin Islands per proof gallon";
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "$10.50 ($13.25 in the case of distilled spirits brought into the United States after June 30, 1999, and before January 1, 2022)")
rule S7652CeilingBeforeJuly1999 strict {
    for s: Person;
    for d: Date;
    when spirits_brought_into_us_on(s, d)
        and d <= @1999-06-30;
    then statutory_cover_over_ceiling_per_proof_gallon(s, 10.50 USD);
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "$13.25 in the case of distilled spirits brought into the United States after June 30, 1999, and before January 1, 2022")
rule S7652CeilingBetween1999And2022 strict {
    for s: Person;
    for d: Date;
    when spirits_brought_into_us_on(s, d)
        and d > @1999-06-30
        and d < @2022-01-01;
    then statutory_cover_over_ceiling_per_proof_gallon(s, 13.25 USD);
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "$10.50 ($13.25 in the case of distilled spirits brought into the United States after June 30, 1999, and before January 1, 2022)")
rule S7652Ceiling2022To2025 strict {
    for s: Person;
    for d: Date;
    when spirits_brought_into_us_on(s, d)
        and d >= @2022-01-01
        and d <= @2025-12-31;
    then statutory_cover_over_ceiling_per_proof_gallon(s, 10.50 USD);
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "$10.50 ($13.25 in the case of distilled spirits brought into the United States after June 30, 1999, and before January 1, 2022)")
rule S7652CeilingAfter2025PublicLaw119Dash21 strict {
    for s: Person;
    for d: Date;
    when spirits_brought_into_us_on(s, d)
        and d > @2025-12-31;
    then statutory_cover_over_ceiling_per_proof_gallon(s, 13.25 USD);
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "the amount covered into the treasuries of Puerto Rico and the Virgin Islands shall not exceed the lesser of the rate of—")
rule S7652LesserOfCeilings strict {
    for s: Person;
    for ceiling: Money;
    for tax: Money;
    when statutory_cover_over_ceiling_per_proof_gallon(s, ceiling)
        and section_5001a1_rate_per_proof_gallon(tax);
    then cover_over_rate_limit_per_proof_gallon(s, min(ceiling, tax));
}
relation spirits_covered_over_per_proof_gallon(s: Person, rate: Money) kind empirical {
    label en unofficial "the amount covered into the treasuries of Puerto Rico and the Virgin Islands per proof gallon of the spirits";
}
relation cover_over_above_rate_limit(s: Person) kind derived {
    label en unofficial "the amount covered over per proof gallon exceeds the (f) limit";
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "shall not exceed the lesser of the rate of—")
rule S7652CoverOverAboveLimit strict {
    for s: Person;
    for rate: Money;
    for limit: Money;
    when spirits_covered_over_per_proof_gallon(s, rate)
        and cover_over_rate_limit_per_proof_gallon(s, limit)
        and rate > limit;
    then cover_over_above_rate_limit(s);
}
@source(IRC_S7652_F, relation = formalizes, coverage = exact, quote = "with respect to taxes imposed under section 5001 or this section on distilled spirits, the amount covered into the treasuries of Puerto Rico and the Virgin Islands shall not exceed")
rule S7652LimitProhibition strict {
    for s: Person;
    when cover_over_above_rate_limit(s);
    then prohibition S7652NoCoverOverAboveRateLimit {
        bearer Secretary;
        action cover_over_above_rate_limit(s);
        window [-infinity, infinity];
    };
}
// (g) medicinal alcohol
relation article_unfit_for_beverage_purposes_with_spirits(a: ShippedArticle) kind empirical {
    label en unofficial "the article is a medicine, medicinal preparation, food product, flavor, flavoring extract, or perfume containing distilled spirits, unfit for beverage purposes, brought into the United States from Puerto Rico or the Virgin Islands";
}
relation amount_covered_over_for_unfit_article(a: ShippedArticle) kind empirical {
    label en unofficial "an amount is covered into the treasury of Puerto Rico or the Virgin Islands for the article";
}
relation cover_over_for_unfit_article_made(a: ShippedArticle) kind derived {
    label en unofficial "an amount is covered over for a medicinal or unfit-for-beverage article";
}
@source(IRC_S7652_G, relation = formalizes, coverage = exact, quote = "no amount shall be covered into the treasuries of Puerto Rico or the Virgin Islands")
rule S7652UnfitArticleCoverOver strict {
    for a: ShippedArticle;
    when article_unfit_for_beverage_purposes_with_spirits(a)
        and amount_covered_over_for_unfit_article(a);
    then cover_over_for_unfit_article_made(a);
}
@source(IRC_S7652_G, relation = formalizes, coverage = exact, quote = "no amount shall be covered into the treasuries of Puerto Rico or the Virgin Islands")
rule S7652UnfitArticleProhibition strict {
    for a: ShippedArticle;
    when cover_over_for_unfit_article_made(a);
    then prohibition S7652NoCoverOverForUnfitArticle {
        bearer Secretary;
        action cover_over_for_unfit_article_made(a);
        window [-infinity, infinity];
    };
}
// (h) manner of cover over
relation cover_over_made_outside_manner_of_this_section(a: ShippedArticle) kind empirical {
    label en unofficial "an amount is covered into the treasury of Puerto Rico or the Virgin Islands otherwise than in the manner specified in this section, by reason of a provision of law not contained in this title or in a revenue Act (whether subsequently enacted or seeking to waive subsection (h))";
}
@source(IRC_S7652_H, relation = formalizes, coverage = exact, quote = "No amount shall be covered into the treasury of Puerto Rico or the Virgin Islands with respect to taxes for which cover over is provided under this section unless made in the manner specified in this section")
rule S7652MannerProhibition strict {
    for a: ShippedArticle;
    when cover_over_made_outside_manner_of_this_section(a);
    then prohibition S7652NoCoverOverOutsideThisTitle {
        bearer Secretary;
        action cover_over_made_outside_manner_of_this_section(a);
        window [-infinity, infinity];
    };
}
// (i) determination of taxes collected
relation taxes_collected_under_5001a1_gross(amt: Money) kind empirical {
    label en unofficial "taxes imposed by and collected under section 5001(a)(1), determined without regard to section 5001(c)";
}
pub relation cover_over_tax_base_ignoring_5001c(amt: Money) kind institutional {
    label en unofficial "for subsections (a)(3), (b)(3) and (e)(1), taxes collected under section 5001(a)(1) are determined without regard to section 5001(c), and refunds under section 5001(c)(4) are not taken into account as a refund";
}
@source(IRC_S7652_I, relation = formalizes, coverage = exact, quote = "the amount of taxes imposed by and collected under section 5001(a)(1) shall be determined without regard to section 5001(c)")
rule S7652TaxBaseIgnoringSection5001c strict {
    for amt: Money;
    when taxes_collected_under_5001a1_gross(amt);
    then cover_over_tax_base_ignoring_5001c(amt);
}

// --- §7653: shipments from the United States ----------------------------------------------------------------------------------

entity ArticleToPossession {
    label en unofficial "an article of merchandise of United States manufacture going into Puerto Rico, the Virgin Islands, Guam or American Samoa";
}
enum PossessionDestination {
    DestPuertoRico;
    DestVirginIslands;
    DestGuam;
    DestAmericanSamoa;
}
relation article_going_to(a: ArticleToPossession, d: PossessionDestination) kind empirical {
    label en unofficial "the article goes into the named possession";
}
relation possession_tax_on_like_local_article(a: ArticleToPossession, tax: Money) kind empirical {
    label en unofficial "the internal revenue tax imposed in Puerto Rico or the Virgin Islands upon the like article of local manufacture";
}
pub relation possession_import_tax_on_us_article(a: ArticleToPossession, tax: Money) kind institutional {
    label en unofficial "the tax on the article coming into Puerto Rico (entered at the port of entry) or imported into the Virgin Islands: equal in rate and amount to the tax imposed there on the like local article";
}
pub relation exempt_from_us_internal_revenue_tax(a: ArticleToPossession) kind institutional {
    label en unofficial "the article going from the United States to Puerto Rico, the Virgin Islands, Guam or American Samoa is exempt from any tax imposed by the internal revenue laws of the United States";
}
pub relation drawback_extended_to_possession_shipment(a: ArticleToPossession) kind institutional {
    label en unofficial "the provisions allowing drawback of internal revenue tax on exported articles extend, so far as applicable, to like articles taxed and shipped to Puerto Rico, the Virgin Islands, Guam or American Samoa";
}
relation article_taxed_in_us_before_shipment(a: ArticleToPossession) kind empirical {
    label en unofficial "internal revenue tax has been paid on the article in the United States before shipment";
}
@source(IRC_S7653_A, relation = formalizes, coverage = exact, quote = "All articles of merchandise of United States manufacture coming into Puerto Rico shall be entered at the port of entry upon payment of a tax equal in rate and amount to the internal revenue tax imposed in Puerto Rico upon the like articles of Puerto Rican manufacture.")
rule S7653PuertoRicoImportTax strict {
    for a: ArticleToPossession;
    for tax: Money;
    when article_going_to(a, DestPuertoRico)
        and possession_tax_on_like_local_article(a, tax);
    then possession_import_tax_on_us_article(a, tax);
}
@source(IRC_S7653_A, relation = formalizes, coverage = exact, quote = "There shall be imposed in the Virgin Islands upon articles imported from the United States a tax equal to the internal revenue tax imposed in such islands upon like articles there manufactured.")
rule S7653VirginIslandsImportTax strict {
    for a: ArticleToPossession;
    for tax: Money;
    when article_going_to(a, DestVirginIslands)
        and possession_tax_on_like_local_article(a, tax);
    then possession_import_tax_on_us_article(a, tax);
}
@source(IRC_S7653_B, relation = formalizes, coverage = exact, quote = "Articles, goods, wares, or merchandise going into Puerto Rico, the Virgin Islands, Guam, and American Samoa from the United States shall be exempted from the payment of any tax imposed by the internal revenue laws of the United States.")
rule S7653ExemptionFromUsTax strict {
    for a: ArticleToPossession;
    for d: PossessionDestination;
    when article_going_to(a, d);
    then exempt_from_us_internal_revenue_tax(a);
}
@source(IRC_S7653_C, relation = formalizes, coverage = exact, quote = "All provisions of law for the allowance of drawback of internal revenue tax on articles exported from the United States are, so far as applicable, extended to like articles upon which an internal revenue tax has been paid when shipped from the United States to Puerto Rico, the Virgin Islands, Guam, or American Samoa.")
rule S7653DrawbackExtended strict {
    for a: ArticleToPossession;
    for d: PossessionDestination;
    when article_going_to(a, d)
        and article_taxed_in_us_before_shipment(a);
    then drawback_extended_to_possession_shipment(a);
}

// --- §7654: coordination of United States and possession individual income taxes ---------------------------------------------------

enum SpecifiedPossession {
    SpecGuam;
    SpecAmericanSamoa;
    SpecNorthernMarianaIslands;
    SpecVirginIslands;
}
entity PossessionResidentIndividual {
    label en unofficial "an individual to whom section 931 or 932(c) applies";
}
relation individual_resident_of(i: PossessionResidentIndividual, pos: SpecifiedPossession) kind empirical {
    label en unofficial "the individual is a bona fide resident of the specified possession and section 931 or 932(c) applies";
}
relation chapter_1_collections_from_individual(i: PossessionResidentIndividual, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the collections of tax imposed by chapter 1 for the taxable year with respect to the individual";
}
relation credits_and_refunds_for_individual(i: PossessionResidentIndividual, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "credits allowed against the tax liability and refunds made of income taxes for the taxable year";
}
pub relation net_collection_for_individual(i: PossessionResidentIndividual, y: TaxableYear, amt: Money) kind institutional {
    label en unofficial "net collections for the taxable year: collections with an appropriate adjustment for credits allowed and refunds made";
}
@source(IRC_S7654_B, relation = formalizes, coverage = exact, quote = "In determining net collections for a taxable year, an appropriate adjustment shall be made for credits allowed against the tax liability and refunds made of income taxes for the taxable year.")
rule S7654NetCollection strict {
    for i: PossessionResidentIndividual;
    for y: TaxableYear;
    for c: Money;
    for adj: Money;
    when chapter_1_collections_from_individual(i, y, c)
        and credits_and_refunds_for_individual(i, y, adj);
    then net_collection_for_individual(i, y, max(0.00 USD, c - adj));
}
relation net_collections_covered_into_possession_treasury(i: PossessionResidentIndividual, y: TaxableYear) kind empirical {
    label en unofficial "the net collection is covered into the Treasury of the possession of which the individual is a bona fide resident";
}
@source(IRC_S7654_A, relation = formalizes, coverage = exact, quote = "shall be covered into the Treasury of the specified possession of which such individual is a bona fide resident")
rule S7654CoverOverDuty defeasible {
    for i: PossessionResidentIndividual;
    for pos: SpecifiedPossession;
    for y: TaxableYear;
    for amt: Money;
    when individual_resident_of(i, pos)
        and net_collection_for_individual(i, y, amt);
    then duty S7654CoverOverNetCollections {
        bearer Secretary;
        goal achievement {
            condition net_collections_covered_into_possession_treasury(i, y);
            window [-infinity, infinity];
        }
    };
}
relation transfers_made_at_least_annually(pos: SpecifiedPossession) kind empirical {
    label en unofficial "the transfers of funds between the United States and the specified possession required by the section are made not less frequently than annually";
}
relation possession_transfers_required(pos: SpecifiedPossession) kind empirical {
    label en unofficial "transfers between the United States and the possession are required by the section";
}
@source(IRC_S7654_C, relation = formalizes, coverage = exact, quote = "The transfers of funds between the United States and any specified possession required by this section shall be made not less frequently than annually.")
rule S7654AnnualTransferDuty defeasible {
    for pos: SpecifiedPossession;
    when possession_transfers_required(pos);
    then duty S7654TransferAtLeastAnnually {
        bearer Secretary;
        goal maintenance {
            condition transfers_made_at_least_annually(pos);
            window [-infinity, infinity];
        }
    };
}
relation withholding_on_armed_forces_stationed_in_possession(pos: SpecifiedPossession, amt: Money) kind empirical {
    label en unofficial "the taxes deducted and withheld by the United States under chapter 24 on compensation paid to members of the Armed Forces stationed in the possession who have no income tax liability to it by reason of the Servicemembers Civil Relief Act";
}
relation withholding_on_federal_employees_in_possession(pos: SpecifiedPossession, amt: Money) kind empirical {
    label en unofficial "the taxes deducted and withheld under chapter 24 on amounts paid for services performed as an employee of the United States (or an agency) in the possession, for individuals to whom neither section 931 nor 932(c) applies";
}
relation federal_personnel_payment_made(pos: SpecifiedPossession, amt: Money) kind empirical {
    label en unofficial "the United States pays the possession the amount, at the times and in the manner the Secretary determines";
}
pub relation federal_personnel_payment_due(pos: SpecifiedPossession, amt: Money) kind institutional {
    label en unofficial "the amount the United States pays each specified possession in addition to the (a) amount: the chapter 24 withholding on service members stationed there (no liability to the possession under the Servicemembers Civil Relief Act) and on federal employees there to whom section 931 or 932(c) does not apply";
}
@source(IRC_S7654_D, relation = formalizes, coverage = exact, quote = "the United States shall pay to each specified possession at such times and in such manner as determined by the Secretary—")
rule S7654FederalPersonnelAmount strict {
    for pos: SpecifiedPossession;
    for mil: Money;
    for civ: Money;
    when withholding_on_armed_forces_stationed_in_possession(pos, mil)
        and withholding_on_federal_employees_in_possession(pos, civ);
    then federal_personnel_payment_due(pos, mil + civ);
}
@source(IRC_S7654_D, relation = formalizes, coverage = exact, quote = "In addition to the amount determined under subsection (a), the United States shall pay to each specified possession")
rule S7654FederalPersonnelDuty defeasible {
    for pos: SpecifiedPossession;
    for amt: Money;
    when federal_personnel_payment_due(pos, amt);
    then duty S7654PayFederalPersonnelWithholding {
        bearer Secretary;
        goal achievement {
            condition federal_personnel_payment_made(pos, amt);
            window [-infinity, infinity];
        }
    };
}
relation secretary_prescribes_7654_regulations(o: Organ) kind empirical {
    label en unofficial "the Secretary has prescribed the regulations necessary to carry out the section and sections 931 and 932, including regulations prohibiting the rebate of covered-over taxes allocable to United States source income and prescribing the information the individuals must furnish";
}
@source(IRC_S7654_E, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out the provisions of this section and sections 931 and 932")
rule S7654RegulationsDuty strict {
    when true;
    then duty S7654PrescribeRegulations {
        bearer Secretary;
        goal maintenance {
            condition secretary_prescribes_7654_regulations(Secretary);
            window [-infinity, infinity];
        }
    };
}
