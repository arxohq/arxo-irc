// 26 U.S.C. §7526 (low-income taxpayer clinics) and §7526A (Community
// Volunteer Income Tax Assistance matching grants). STAGE 3.
//
// JUDGMENT CALLS
//  - Both programs are discretionary grants "subject to the availability of
//    appropriated funds". The award is a `power` of the Secretary whose
//    valid_when folds the statutory conditions into one derived atom
//    (qualified recipient, appropriated funds, annual cap, matching funds,
//    term); the annual and aggregate dollar limits are prohibitions of the
//    Secretary's allocation.
//  - "Unless otherwise provided by specific appropriation" (aggregate
//    limits) is an `unless` on the prohibition, supplied as a case fact.
//  - The poverty-level test (250 percent of the OMB poverty level) and the
//    §32(b) completed phaseout amount are case facts (owners: OMB criteria,
//    Rev. Proc. published values); nothing is invented.
//  - "At least once every 5 calendar years" site visits (§7526A(d)(1)) are a
//    periodic duty modelled as `maintenance` (TECH-GAPS G3000).
//  - §7526A(g)(3) ("are encouraged, in appropriate cases") is hortatory and
//    is classified NON_NORMATIVE in the coverage file.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7526A_A,
    IRC_S7526A_B,
    IRC_S7526A_C,
    IRC_S7526A_D,
    IRC_S7526A_E,
    IRC_S7526A_F,
    IRC_S7526A_G,
    IRC_S7526_A,
    IRC_S7526_B,
    IRC_S7526_C,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// --- §7526: low-income taxpayer clinics -----------------------------------------

entity ClinicGrant {
    label en unofficial "a matching grant to a low-income taxpayer clinic (§7526) or to a qualified return preparation program (§7526A)";
}
enum MatchingCostKind {
    SalaryIncludingFringeBenefits;
    EquipmentCost;
    OtherOrdinaryAndNecessaryCost;
    IndirectExpenseOrGeneralOverhead;
}
entity MatchingCost {
    label en unofficial "an amount the clinic or program contributes as matching funds";
}
relation matching_cost_of_grant(g: ClinicGrant, mc: MatchingCost, k: MatchingCostKind, amt: Money) kind empirical {
    label en unofficial "the matching contribution of the named kind for the grant";
}
pub relation counted_matching_funds(g: ClinicGrant, amt: Money) kind institutional {
    label en unofficial "matching funds that count under §7526(c)(5) / §7526A(b)(2): salary and fringe benefits, equipment cost and other ordinary and necessary costs, never indirect expenses or general overhead";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "Indirect expenses, including general overhead of the institution sponsoring the clinic, shall not be counted as matching funds.")
rule S7526CountedMatchingFunds strict {
    for g: ClinicGrant;
    when clinic_grant_has_matching_costs(g);
    then counted_matching_funds(g, sum all amt: Money for mc: MatchingCost where matching_cost_of_grant(g, mc, SalaryIncludingFringeBenefits, amt) or matching_cost_of_grant(g, mc, EquipmentCost, amt) or matching_cost_of_grant(g, mc, OtherOrdinaryAndNecessaryCost, amt));
}
relation clinic_grant_has_matching_costs(g: ClinicGrant) kind empirical {
    label en unofficial "the grant recipient reports matching contributions";
}
enum ClinicKind {
    SchoolClinicalProgram;
    Section501cOrganization;
}
relation clinic_kind_of(c: Person, k: ClinicKind) kind empirical {
    label en unofficial "the clinic is a clinical program at an accredited law, business, or accounting school in which students represent low-income taxpayers, or a section 501(c) organization exempt under section 501(a) that meets paragraph (1) through representation or referral";
}
relation clinic_charges_no_more_than_nominal_fee(c: Person) kind empirical {
    label en unofficial "the clinic does not charge more than a nominal fee for its services (except reimbursement of actual costs)";
}
relation clinic_share_of_clients_at_or_below_250_percent_poverty(c: Person, share: Decimal) kind empirical {
    label en unofficial "the share of taxpayers represented by the clinic whose incomes do not exceed 250 percent of the poverty level (OMB criteria)";
}
relation clinic_amount_in_controversy_generally_within_7463_limit(c: Person) kind empirical {
    label en unofficial "the amount in controversy for any taxable year generally does not exceed the amount specified in section 7463";
}
relation clinic_informs_english_second_language_individuals(c: Person) kind empirical {
    label en unofficial "the clinic operates programs to inform individuals for whom English is a second language about their rights and responsibilities under this title";
}
relation clinic_is_a_clinic(c: Person) kind derived {
    label en unofficial "the entity is a clinic within §7526(b)(2)";
}
relation clinic_represents_low_income_taxpayers(c: Person) kind derived {
    label en unofficial "§7526(b)(1)(B): at least 90 percent of represented taxpayers are at or below 250 percent of the poverty level and the amount in controversy is generally within the section 7463 limit";
}
pub relation qualified_low_income_taxpayer_clinic(c: Person) kind institutional {
    label en unofficial "the clinic is a qualified low-income taxpayer clinic (§7526(b)(1))";
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "a clinical program at an accredited law, business, or accounting school in which students represent low-income taxpayers in controversies arising under this title")
rule S7526ClinicSchool strict {
    for c: Person;
    when clinic_kind_of(c, SchoolClinicalProgram);
    then clinic_is_a_clinic(c);
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "an organization described in section 501(c) and exempt from tax under section 501(a) which satisfies the requirements of paragraph (1) through representation of taxpayers or referral of taxpayers to qualified representatives")
rule S7526ClinicOrganization strict {
    for c: Person;
    when clinic_kind_of(c, Section501cOrganization);
    then clinic_is_a_clinic(c);
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "at least 90 percent of the taxpayers represented by the clinic have incomes which do not exceed 250 percent of the poverty level")
rule S7526RepresentsLowIncome strict {
    for c: Person;
    for share: Decimal;
    when clinic_share_of_clients_at_or_below_250_percent_poverty(c, share)
        and share >= 0.90
        and clinic_amount_in_controversy_generally_within_7463_limit(c);
    then clinic_represents_low_income_taxpayers(c);
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "does not charge more than a nominal fee for its services (except for reimbursement of actual costs incurred)")
rule S7526QualifiedClinicRepresenting strict {
    for c: Person;
    when clinic_is_a_clinic(c)
        and clinic_charges_no_more_than_nominal_fee(c)
        and clinic_represents_low_income_taxpayers(c);
    then qualified_low_income_taxpayer_clinic(c);
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "operates programs to inform individuals for whom English is a second language about their rights and responsibilities under this title")
rule S7526QualifiedClinicEnglishSecondLanguage strict {
    for c: Person;
    when clinic_is_a_clinic(c)
        and clinic_charges_no_more_than_nominal_fee(c)
        and clinic_informs_english_second_language_individuals(c);
    then qualified_low_income_taxpayer_clinic(c);
}
relation individual_authorized_to_practice_before_irs_or_court(i: Person) kind empirical {
    label en unofficial "the individual (attorney or not) is authorized to practice before the Internal Revenue Service or the applicable court";
}
pub relation qualified_representative(i: Person) kind institutional {
    label en unofficial "the individual is a qualified representative under §7526(b)(3)";
}
@source(IRC_S7526_B, relation = formalizes, coverage = exact, quote = "The term \"qualified representative\" means any individual (whether or not an attorney) who is authorized to practice before the Internal Revenue Service or the applicable court.")
rule S7526QualifiedRepresentative strict {
    for i: Person;
    when individual_authorized_to_practice_before_irs_or_court(i);
    then qualified_representative(i);
}

relation clinic_grant_recipient(g: ClinicGrant, c: Person) kind empirical {
    label en unofficial "the grant is made to this clinic or program";
}
relation clinic_grant_year_amount(g: ClinicGrant, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the amount of the grant allocated for the year";
}
relation appropriated_funds_available_for_grant(g: ClinicGrant) kind empirical {
    label en unofficial "appropriated funds are available for the grant";
}
relation clinic_grant_total_amount(g: ClinicGrant, amt: Money) kind empirical {
    label en unofficial "the total amount of the grant";
}
relation clinic_grant_term_years(g: ClinicGrant, years: Integer) kind empirical {
    label en unofficial "the length of the grant in years";
}
relation clinic_year_total_grants(c: Person, y: TaxableYear, total: Money) kind derived {
    label en unofficial "the aggregate amount of grants to the clinic for the year";
}
relation clinic_year_within_annual_cap(c: Person, y: TaxableYear) kind derived {
    label en unofficial "grants to the clinic for the year do not exceed $100,000 (§7526(c)(2))";
}
relation clinic_grant_within_annual_cap(g: ClinicGrant) kind derived {
    label en unofficial "the grant's clinic stays within the annual $100,000 cap for the grant's year";
}
relation clinic_grant_term_within_3_years(g: ClinicGrant) kind derived {
    label en unofficial "the grant lasts at most 3 years";
}
relation clinic_grant_matched_dollar_for_dollar(g: ClinicGrant) kind derived {
    label en unofficial "matching funds equal at least the grant, dollar for dollar (§7526(c)(5))";
}
relation clinic_grant_conditions_met(g: ClinicGrant) kind derived {
    label en unofficial "the recipient is a qualified low-income taxpayer clinic; funds are appropriated; the annual cap, the 3-year term and the dollar-for-dollar match are respected";
}
relation secretary_awards_clinic_grant(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary awards the matching grant";
}
pub relation clinic_grant_made(g: ClinicGrant) kind institutional {
    label en unofficial "the matching grant is validly made under §7526(a)";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "The aggregate amount of grants which may be made under this section to a clinic for a year shall not exceed $100,000.")
rule S7526ClinicYearTotal strict {
    for c: Person;
    for y: TaxableYear;
    when clinic_grant_recipient_in_year(c, y);
    then clinic_year_total_grants(c, y, sum all amt: Money for g: ClinicGrant where clinic_grant_recipient(g, c) and clinic_grant_year_amount(g, y, amt));
}
relation clinic_grant_recipient_in_year(c: Person, y: TaxableYear) kind empirical {
    label en unofficial "the clinic receives a grant allocated for the year";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "The aggregate amount of grants which may be made under this section to a clinic for a year shall not exceed $100,000.")
rule S7526ClinicYearWithinCap strict {
    for c: Person;
    for y: TaxableYear;
    for total: Money;
    when clinic_year_total_grants(c, y, total)
        and total <= 100000.00 USD;
    then clinic_year_within_annual_cap(c, y);
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "The aggregate amount of grants which may be made under this section to a clinic for a year shall not exceed $100,000.")
rule S7526GrantWithinAnnualCap strict {
    for g: ClinicGrant;
    for c: Person;
    for y: TaxableYear;
    for amt: Money;
    when clinic_grant_recipient(g, c)
        and clinic_grant_year_amount(g, y, amt)
        and clinic_year_within_annual_cap(c, y);
    then clinic_grant_within_annual_cap(g);
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to award a multi-year grant not to exceed 3 years")
rule S7526TermWithinThreeYears strict {
    for g: ClinicGrant;
    for n: Integer;
    when clinic_grant_term_years(g, n)
        and n <= 3;
    then clinic_grant_term_within_3_years(g);
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "A low-income taxpayer clinic must provide matching funds on a dollar-for-dollar basis for all grants provided under this section.")
rule S7526MatchedDollarForDollar strict {
    for g: ClinicGrant;
    for total: Money;
    for matched: Money;
    when clinic_grant_total_amount(g, total)
        and counted_matching_funds(g, matched)
        and matched >= total;
    then clinic_grant_matched_dollar_for_dollar(g);
}
@source(IRC_S7526_A, relation = formalizes, coverage = exact, quote = "The Secretary may, subject to the availability of appropriated funds, make grants to provide matching funds for the development, expansion, or continuation of qualified low-income taxpayer clinics.")
rule S7526GrantConditions strict {
    for g: ClinicGrant;
    for c: Person;
    when clinic_grant_recipient(g, c)
        and qualified_low_income_taxpayer_clinic(c)
        and appropriated_funds_available_for_grant(g)
        and clinic_grant_within_annual_cap(g)
        and clinic_grant_term_within_3_years(g)
        and clinic_grant_matched_dollar_for_dollar(g);
    then clinic_grant_conditions_met(g);
}
@source(IRC_S7526_A, relation = formalizes, coverage = exact, quote = "The Secretary may, subject to the availability of appropriated funds, make grants to provide matching funds for the development, expansion, or continuation of qualified low-income taxpayer clinics.")
rule S7526GrantPower strict {
    for g: ClinicGrant;
    for c: Person;
    when secretary_awards_clinic_grant(g)
        and clinic_grant_recipient(g, c);
    then power S7526AwardClinicGrant {
        holder Secretary;
        over c;
        exercise secretary_awards_clinic_grant(g);
        valid_when clinic_grant_conditions_met(g);
        effect create(clinic_grant_made(g));
    };
}

relation specific_appropriation_provides_otherwise_for_clinics(y: TaxableYear) kind empirical {
    label en unofficial "a specific appropriation provides otherwise than the $6,000,000 annual allocation limit";
}
relation clinic_program_year_allocation(g: ClinicGrant, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "amount of the grant allocated by the Secretary for the year (exclusive of costs of administering the program)";
}
relation clinic_program_year_total(y: TaxableYear, total: Money) kind derived {
    label en unofficial "the aggregate allocated to §7526 grants for the year";
}
relation clinic_program_year_active(y: TaxableYear) kind empirical {
    label en unofficial "the Secretary allocates funds to grants under §7526 for the year";
}
relation clinic_allocation_exceeds_annual_limit(y: TaxableYear) kind derived {
    label en unofficial "the aggregate allocated for the year exceeds $6,000,000";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "the Secretary shall not allocate more than $6,000,000 per year (exclusive of costs of administering the program) to grants under this section")
rule S7526ProgramYearTotal strict {
    for y: TaxableYear;
    when clinic_program_year_active(y);
    then clinic_program_year_total(y, sum all amt: Money for g: ClinicGrant where clinic_program_year_allocation(g, y, amt));
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "the Secretary shall not allocate more than $6,000,000 per year (exclusive of costs of administering the program) to grants under this section")
rule S7526AllocationExceeds strict {
    for y: TaxableYear;
    for total: Money;
    when clinic_program_year_total(y, total)
        and total > 6000000.00 USD;
    then clinic_allocation_exceeds_annual_limit(y);
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "Unless otherwise provided by specific appropriation, the Secretary shall not allocate more than $6,000,000 per year")
rule S7526AllocationProhibition defeasible {
    for y: TaxableYear;
    when clinic_allocation_exceeds_annual_limit(y);
    then prohibition S7526NoAllocationOverSixMillion {
        bearer Secretary;
        action clinic_allocation_exceeds_annual_limit(y);
        window [-infinity, infinity];
    };
    unless specific_appropriation_provides_otherwise_for_clinics(y) and clinic_allocation_exceeds_annual_limit(y);
}
relation secretary_considered_number_of_taxpayers_to_be_served(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary considered the number of taxpayers the clinic will serve, including those for whom English is a second language (§7526(c)(4)(A))";
}
relation secretary_considered_other_clinics_serving_population(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary considered the existence of other clinics serving the same population (§7526(c)(4)(B))";
}
relation secretary_considered_quality_of_program(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary considered the quality of the program, including administrators' and representatives' qualifications and the clinic's record (§7526(c)(4)(C))";
}
relation secretary_considered_alternative_funding_sources(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary considered alternative funding sources available to the clinic (§7526(c)(4)(D))";
}
relation all_four_grant_criteria_considered(g: ClinicGrant) kind derived {
    label en unofficial "the Secretary considered all of criteria (A)-(D)";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "In determining whether to make a grant under this section, the Secretary shall consider—")
rule S7526AllCriteriaConsidered strict {
    for g: ClinicGrant;
    when secretary_considered_number_of_taxpayers_to_be_served(g)
        and secretary_considered_other_clinics_serving_population(g)
        and secretary_considered_quality_of_program(g)
        and secretary_considered_alternative_funding_sources(g);
    then all_four_grant_criteria_considered(g);
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "In determining whether to make a grant under this section, the Secretary shall consider—")
rule S7526ConsiderCriteriaDuty defeasible {
    for g: ClinicGrant;
    when secretary_awards_clinic_grant(g);
    then duty S7526ConsiderGrantCriteria {
        bearer Secretary;
        goal achievement {
            condition all_four_grant_criteria_considered(g);
            window [-infinity, infinity];
        }
    };
}
relation treasury_officer_advises_taxpayer_of_clinics(t: Person) kind empirical {
    label en unofficial "an officer or employee of the Treasury advises the taxpayer of the availability of, and eligibility requirements for, advice from specific qualified clinics receiving funding, and provides their location and contact information";
}
@source(IRC_S7526_C, relation = formalizes, coverage = exact, quote = "Notwithstanding any other provision of law, officers and employees of the Department of the Treasury may—")
rule S7526TreasuryMayAdvise defeasible {
    for t: Person;
    when treasury_officer_advises_taxpayer_of_clinics(t);
    then liberty S7526AdviseTaxpayersOfClinics {
        holder Secretary;
        against t;
        action treasury_officer_advises_taxpayer_of_clinics(t);
        window [-infinity, infinity];
    };
}

// --- §7526A: Community Volunteer Income Tax Assistance matching grants ----------

relation qrpp_is_administered_by_qualified_entity(p: Person) kind empirical {
    label en unofficial "the return preparation program is administered by a qualified entity";
}
relation qrpp_share_of_applicable_taxpayers(p: Person, share: Decimal) kind empirical {
    label en unofficial "the share of individuals assisted who are applicable taxpayers";
}
relation qrpp_volunteers_meet_training_requirements(p: Person) kind empirical {
    label en unofficial "all volunteers who assist in preparing returns meet the training requirements prescribed by the Secretary";
}
relation qrpp_reviews_all_returns(p: Person) kind empirical {
    label en unofficial "the program uses a quality review process that reviews 100 percent of all returns";
}
pub relation qualified_return_preparation_program(p: Person) kind institutional {
    label en unofficial "the program is a qualified return preparation program (§7526A(e)(1))";
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "The term \"qualified return preparation program\" means any program—")
rule S7526AQualifiedProgram strict {
    for p: Person;
    for share: Decimal;
    when qrpp_share_of_applicable_taxpayers(p, share)
        and share >= 0.90
        and qrpp_is_administered_by_qualified_entity(p)
        and qrpp_volunteers_meet_training_requirements(p)
        and qrpp_reviews_all_returns(p);
    then qualified_return_preparation_program(p);
}
enum EligibleOrganizationKind {
    HigherEducationInstitution;
    Section501cOrganizationExempt;
    LocalGovernmentAgencyOrTribe;
    LeadOrganizationCoalition;
    StateAgencyOrCooperativeExtensionWhereNoOthersAvailable;
}
relation entity_eligible_organization_kind(p: Person, k: EligibleOrganizationKind) kind empirical {
    label en unofficial "the entity is an eligible organization of the named kind under §7526A(e)(2)(B)";
}
relation entity_in_compliance_with_federal_tax_filing_and_payment(p: Person) kind empirical {
    label en unofficial "the entity is in compliance with Federal tax filing and payment requirements";
}
relation entity_not_debarred_or_suspended(p: Person) kind empirical {
    label en unofficial "the entity is not debarred or suspended from Federal contracts, grants, or cooperative agreements";
}
relation entity_agrees_to_substantiate_matching_funds(p: Person) kind empirical {
    label en unofficial "the entity agrees to provide documentation to substantiate any matching funds";
}
pub relation qualified_entity(p: Person) kind institutional {
    label en unofficial "the entity is a qualified entity (§7526A(e)(2)(A))";
}
relation entity_is_eligible_organization(p: Person) kind derived {
    label en unofficial "the entity is an eligible organization under one of the five kinds of §7526A(e)(2)(B)";
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "an institution of higher education which is described in section 102 (other than subsection (a)(1)(C) thereof) of the Higher Education Act of 1965")
rule S7526AEligibleHigherEducation strict {
    for p: Person;
    when entity_eligible_organization_kind(p, HigherEducationInstitution);
    then entity_is_eligible_organization(p);
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "an organization described in section 501(c) and exempt from tax under section 501(a)")
rule S7526AEligibleExemptOrganization strict {
    for p: Person;
    when entity_eligible_organization_kind(p, Section501cOrganizationExempt);
    then entity_is_eligible_organization(p);
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "a local government agency, including—")
rule S7526AEligibleLocalGovernment strict {
    for p: Person;
    when entity_eligible_organization_kind(p, LocalGovernmentAgencyOrTribe);
    then entity_is_eligible_organization(p);
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "a local, State, regional, or national coalition (with one lead organization which meets the eligibility requirements of clause (i), (ii), or (iii) acting as the applicant organization)")
rule S7526AEligibleCoalition strict {
    for p: Person;
    when entity_eligible_organization_kind(p, LeadOrganizationCoalition);
    then entity_is_eligible_organization(p);
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "in the case of applicable taxpayers and members of underserved populations with respect to which no organizations described in the preceding clauses are available—")
rule S7526AEligibleStateOrExtension strict {
    for p: Person;
    when entity_eligible_organization_kind(p, StateAgencyOrCooperativeExtensionWhereNoOthersAvailable);
    then entity_is_eligible_organization(p);
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "The term \"qualified entity\" means any entity which—")
rule S7526AQualifiedEntity strict {
    for p: Person;
    when entity_is_eligible_organization(p)
        and entity_in_compliance_with_federal_tax_filing_and_payment(p)
        and entity_not_debarred_or_suspended(p)
        and entity_agrees_to_substantiate_matching_funds(p);
    then qualified_entity(p);
}
relation taxpayer_income_for_year(t: Person, y: TaxableYear, income: Money) kind empirical {
    label en unofficial "the taxpayer's income for the taxable year";
}
relation completed_phaseout_amount_32b_joint_three_children(y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the completed phaseout amount under section 32(b) for a married couple filing jointly with three or more qualifying children, as determined in a revenue procedure or other published guidance";
}
pub relation applicable_taxpayer(t: Person, y: TaxableYear) kind institutional {
    label en unofficial "the taxpayer's income for the year does not exceed the completed §32(b) phaseout amount for a joint return with three or more qualifying children (§7526A(e)(3))";
}
@source(IRC_S7526A_E, relation = formalizes, coverage = exact, quote = "a taxpayer whose income for the taxable year does not exceed an amount equal to the completed phaseout amount under section 32(b) for a married couple filing a joint return with three or more qualifying children")
rule S7526AApplicableTaxpayer strict {
    for t: Person;
    for y: TaxableYear;
    for income: Money;
    for limit: Money;
    when taxpayer_income_for_year(t, y, income)
        and completed_phaseout_amount_32b_joint_three_children(y, limit)
        and income <= limit;
    then applicable_taxpayer(t, y);
}
enum UnderservedPopulationKind {
    PersonsWithDisabilities;
    LimitedEnglishProficiency;
    NativeAmericans;
    RuralResidents;
    ArmedForcesMembersAndSpouses;
    TheElderly;
}
relation person_belongs_to_underserved_population(t: Person, k: UnderservedPopulationKind) kind empirical {
    label en unofficial "the person belongs to the named population";
}
pub relation underserved_population_member(t: Person) kind institutional {
    label en unofficial "the person belongs to an underserved population (§7526A(e)(4), an open list: \"includes\")";
}
@source(IRC_S7526A_E, relation = formalizes, coverage = partial, quote = "The term \"underserved population\" includes populations of persons with disabilities, persons with limited English proficiency, Native Americans, individuals living in rural areas, members of the Armed Forces and their spouses, and the elderly.")
rule S7526AUnderservedPopulation strict {
    for t: Person;
    for k: UnderservedPopulationKind;
    when person_belongs_to_underserved_population(t, k);
    then underserved_population_member(t);
}

relation vita_grant_recipient(g: ClinicGrant, p: Person) kind empirical {
    label en unofficial "the grant is made to this program";
}
relation vita_grant_total_amount(g: ClinicGrant, amt: Money) kind empirical {
    label en unofficial "the total amount of the grant";
}
relation vita_grant_term_years(g: ClinicGrant, years: Integer) kind empirical {
    label en unofficial "the length of the grant in years";
}
relation vita_program_ineligible_after_adherence_failure(p: Person) kind empirical {
    label en unofficial "the program was awarded a grant and later determined not to meet adherence standards or not to carry out the purposes of the section";
}
relation vita_program_documented_corrective_measures(p: Person) kind empirical {
    label en unofficial "the program provides sufficient documentation of corrective measures for the deficiencies";
}
relation appropriated_funds_available_for_vita_grant(g: ClinicGrant) kind empirical {
    label en unofficial "appropriated funds are available for the grant";
}
relation vita_grant_matched_dollar_for_dollar(g: ClinicGrant) kind derived {
    label en unofficial "matching funds equal at least the grant, dollar for dollar (§7526A(b)(2))";
}
relation vita_grant_term_within_3_years(g: ClinicGrant) kind derived {
    label en unofficial "the grant lasts at most 3 years (§7526A(f)(1))";
}
relation vita_program_eligible_for_more_grants(p: Person) kind derived {
    label en unofficial "the program is not barred from additional grants by an adherence failure, or has documented corrective measures";
}
relation vita_grant_conditions_met(g: ClinicGrant) kind derived {
    label en unofficial "qualified return preparation program recipient, appropriated funds, dollar-for-dollar match, term of at most 3 years, and no adherence bar";
}
relation secretary_awards_vita_grant(g: ClinicGrant) kind empirical {
    label en unofficial "the Secretary awards the matching grant";
}
pub relation vita_grant_made(g: ClinicGrant) kind institutional {
    label en unofficial "the matching grant is validly made under §7526A(a)";
}
@source(IRC_S7526A_B, relation = formalizes, coverage = exact, quote = "A qualified return preparation program must provide matching funds on a dollar-for-dollar basis for all grants provided under this section.")
rule S7526AMatchedDollarForDollar strict {
    for g: ClinicGrant;
    for total: Money;
    for matched: Money;
    when vita_grant_total_amount(g, total)
        and counted_matching_funds(g, matched)
        and matched >= total;
    then vita_grant_matched_dollar_for_dollar(g);
}
@source(IRC_S7526A_F, relation = formalizes, coverage = exact, quote = "the Secretary is authorized to award a multi-year grant not to exceed 3 years")
rule S7526ATermWithinThreeYears strict {
    for g: ClinicGrant;
    for n: Integer;
    when vita_grant_term_years(g, n)
        and n <= 3;
    then vita_grant_term_within_3_years(g);
}
@source(IRC_S7526A_D, relation = formalizes, coverage = exact, quote = "such program shall not be eligible for any additional grants under this section unless such program provides sufficient documentation of corrective measures established to address any such deficiencies determined")
rule S7526AEligibleWhenNoAdherenceFailure strict {
    for p: Person;
    when qualified_return_preparation_program(p)
        and not_known(vita_program_ineligible_after_adherence_failure(p));
    then vita_program_eligible_for_more_grants(p);
}
@source(IRC_S7526A_D, relation = formalizes, coverage = exact, quote = "unless such program provides sufficient documentation of corrective measures established to address any such deficiencies determined")
rule S7526AEligibleWithCorrectiveMeasures strict {
    for p: Person;
    when qualified_return_preparation_program(p)
        and vita_program_ineligible_after_adherence_failure(p)
        and vita_program_documented_corrective_measures(p);
    then vita_program_eligible_for_more_grants(p);
}
@source(IRC_S7526A_A, relation = formalizes, coverage = exact, quote = "the Secretary may, subject to the availability of appropriated funds, make grants to provide matching funds for the development, expansion, or continuation of qualified return preparation programs assisting applicable taxpayers and members of underserved populations")
rule S7526AGrantConditions strict {
    for g: ClinicGrant;
    for p: Person;
    when vita_grant_recipient(g, p)
        and vita_program_eligible_for_more_grants(p)
        and appropriated_funds_available_for_vita_grant(g)
        and vita_grant_matched_dollar_for_dollar(g)
        and vita_grant_term_within_3_years(g);
    then vita_grant_conditions_met(g);
}
@source(IRC_S7526A_A, relation = formalizes, coverage = exact, quote = "the Secretary may, subject to the availability of appropriated funds, make grants to provide matching funds for the development, expansion, or continuation of qualified return preparation programs assisting applicable taxpayers and members of underserved populations")
rule S7526AGrantPower strict {
    for g: ClinicGrant;
    for p: Person;
    when secretary_awards_vita_grant(g)
        and vita_grant_recipient(g, p);
    then power S7526AAwardVitaGrant {
        holder Secretary;
        over p;
        exercise secretary_awards_vita_grant(g);
        valid_when vita_grant_conditions_met(g);
        effect create(vita_grant_made(g));
    };
}
relation vita_program_established(o: Organ) kind empirical {
    label en unofficial "the Secretary has established the Community Volunteer Income Tax Assistance Matching Grant Program";
}
@source(IRC_S7526A_A, relation = formalizes, coverage = exact, quote = "The Secretary shall establish a Community Volunteer Income Tax Assistance Matching Grant Program")
rule S7526AEstablishProgramDuty strict {
    when true;
    then duty S7526AEstablishProgram {
        bearer Secretary;
        goal maintenance {
            condition vita_program_established(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation vita_applicant_submits_application(p: Person) kind empirical {
    label en unofficial "the applicant submits an application to the Secretary at such time, in such manner, and containing such information as the Secretary may reasonably require";
}
relation vita_grant_application_submitted_by(g: ClinicGrant, p: Person) kind empirical {
    label en unofficial "the program applied for the grant";
}
@source(IRC_S7526A_C, relation = formalizes, coverage = exact, quote = "Each applicant for a grant under this section shall submit an application to the Secretary at such time, in such manner, and containing such information as the Secretary may reasonably require.")
rule S7526AApplicationDuty defeasible {
    for g: ClinicGrant;
    for p: Person;
    when vita_grant_application_submitted_by(g, p);
    then duty S7526ASubmitApplication {
        bearer p;
        beneficiary Secretary;
        goal achievement {
            condition vita_applicant_submits_application(p);
            window [-infinity, infinity];
        }
    };
}
relation secretary_gives_priority_to_applications(g: ClinicGrant) kind empirical {
    label en unofficial "in awarding grants the Secretary gives priority to applications that demonstrate assistance to applicable taxpayers, outreach on income supports including the earned income tax credit, and outreach to underserved populations";
}
@source(IRC_S7526A_C, relation = formalizes, coverage = exact, quote = "In awarding grants under this section, the Secretary shall give priority to applications which demonstrate—")
rule S7526APriorityDuty defeasible {
    for g: ClinicGrant;
    when secretary_awards_vita_grant(g);
    then duty S7526AGivePriorityToApplications {
        bearer Secretary;
        goal achievement {
            condition secretary_gives_priority_to_applications(g);
            window [-infinity, infinity];
        }
    };
}
relation secretary_conducts_site_visits_every_5_calendar_years(p: Person) kind empirical {
    label en unofficial "the Secretary conducts periodic site visits at least once every 5 calendar years of a program's operation under a grant, to ensure the purposes of the section are carried out and to determine whether the program meets adherence standards";
}
relation program_operating_under_vita_grant(p: Person) kind empirical {
    label en unofficial "the qualified return preparation program is operating under a grant";
}
@source(IRC_S7526A_D, relation = formalizes, coverage = exact, quote = "shall conduct not less frequently than once every 5 calendar years during which a qualified return preparation program is operating under a grant under this section, periodic site visits")
rule S7526ASiteVisitDuty defeasible {
    for p: Person;
    when program_operating_under_vita_grant(p);
    then duty S7526AConductSiteVisits {
        bearer Secretary;
        goal maintenance {
            condition secretary_conducts_site_visits_every_5_calendar_years(p);
            window [-infinity, infinity];
        }
    };
}
relation additional_grant_awarded_to_ineligible_program(g: ClinicGrant) kind derived {
    label en unofficial "an additional grant is awarded to a program barred by an adherence failure without documented corrective measures";
}
@source(IRC_S7526A_D, relation = formalizes, coverage = exact, quote = "such program shall not be eligible for any additional grants under this section")
rule S7526AAdditionalGrantToIneligible strict {
    for g: ClinicGrant;
    for p: Person;
    when secretary_awards_vita_grant(g)
        and vita_grant_recipient(g, p)
        and vita_program_ineligible_after_adherence_failure(p)
        and not_known(vita_program_documented_corrective_measures(p));
    then additional_grant_awarded_to_ineligible_program(g);
}
@source(IRC_S7526A_D, relation = formalizes, coverage = exact, quote = "such program shall not be eligible for any additional grants under this section unless such program provides sufficient documentation of corrective measures established to address any such deficiencies determined")
rule S7526ANoAdditionalGrantProhibition strict {
    for g: ClinicGrant;
    when additional_grant_awarded_to_ineligible_program(g);
    then prohibition S7526ANoAdditionalGrantAfterAdherenceFailure {
        bearer Secretary;
        action additional_grant_awarded_to_ineligible_program(g);
        window [-infinity, infinity];
    };
}
relation specific_appropriation_provides_otherwise_for_vita(fy: TaxableYear) kind empirical {
    label en unofficial "a specific appropriation provides otherwise than the $30 million per fiscal year allocation limit";
}
relation vita_program_year_active(fy: TaxableYear) kind empirical {
    label en unofficial "the Secretary allocates funds to grants under §7526A for the fiscal year";
}
relation vita_program_year_allocation(g: ClinicGrant, fy: TaxableYear, amt: Money) kind empirical {
    label en unofficial "amount of the grant allocated for the fiscal year (exclusive of costs of administering the program)";
}
relation vita_program_year_total(fy: TaxableYear, total: Money) kind derived {
    label en unofficial "the aggregate allocated to §7526A grants for the fiscal year";
}
relation vita_allocation_exceeds_annual_limit(fy: TaxableYear) kind derived {
    label en unofficial "the aggregate allocated for the fiscal year exceeds $30 million";
}
@source(IRC_S7526A_F, relation = formalizes, coverage = exact, quote = "the Secretary shall not allocate more than $30 million per fiscal year (exclusive of costs of administering the program) to grants under this section")
rule S7526AProgramYearTotal strict {
    for fy: TaxableYear;
    when vita_program_year_active(fy);
    then vita_program_year_total(fy, sum all amt: Money for g: ClinicGrant where vita_program_year_allocation(g, fy, amt));
}
@source(IRC_S7526A_F, relation = formalizes, coverage = exact, quote = "the Secretary shall not allocate more than $30 million per fiscal year (exclusive of costs of administering the program) to grants under this section")
rule S7526AAllocationExceeds strict {
    for fy: TaxableYear;
    for total: Money;
    when vita_program_year_total(fy, total)
        and total > 30000000.00 USD;
    then vita_allocation_exceeds_annual_limit(fy);
}
@source(IRC_S7526A_F, relation = formalizes, coverage = exact, quote = "Unless otherwise provided by specific appropriation, the Secretary shall not allocate more than $30 million per fiscal year")
rule S7526AAllocationProhibition defeasible {
    for fy: TaxableYear;
    when vita_allocation_exceeds_annual_limit(fy);
    then prohibition S7526ANoAllocationOverThirtyMillion {
        bearer Secretary;
        action vita_allocation_exceeds_annual_limit(fy);
        window [-infinity, infinity];
    };
    unless specific_appropriation_provides_otherwise_for_vita(fy) and vita_allocation_exceeds_annual_limit(fy);
}
relation secretary_promotes_qrpp_through_mass_communications(o: Organ) kind empirical {
    label en unofficial "the Secretary promotes tax preparation through qualified return preparation programs by mass communications and other means";
}
@source(IRC_S7526A_G, relation = formalizes, coverage = exact, quote = "The Secretary shall promote tax preparation through qualified return preparation programs through the use of mass communications and other means.")
rule S7526APromotionDuty strict {
    when true;
    then duty S7526APromoteQualifiedPrograms {
        bearer Secretary;
        goal maintenance {
            condition secretary_promotes_qrpp_through_mass_communications(Secretary);
            window [-infinity, infinity];
        }
    };
}
relation secretary_provides_taxpayers_information_on_programs(t: Person) kind empirical {
    label en unofficial "the Secretary provides the taxpayer information regarding qualified return preparation programs receiving grants";
}
@source(IRC_S7526A_G, relation = formalizes, coverage = exact, quote = "The Secretary may provide taxpayers information regarding qualified return preparation programs receiving grants under this section.")
rule S7526AInformationLiberty defeasible {
    for t: Person;
    when secretary_provides_taxpayers_information_on_programs(t);
    then liberty S7526AProvideProgramInformation {
        holder Secretary;
        against t;
        action secretary_provides_taxpayers_information_on_programs(t);
        window [-infinity, infinity];
    };
}

enum GrantUsePurpose {
    ProgramOperatingCosts;
    OutreachAndEducationActivities;
    FinancialEducationAssetDevelopmentAndSavingsServices;
}
relation program_uses_grant_for(p: Person, purpose: GrantUsePurpose) kind empirical {
    label en unofficial "the qualified return preparation program uses the grant for the named purpose: ordinary and necessary program operation costs (coordinators' wages, training and quality review, equipment, rural vehicle expenses), outreach and education, or financial education, asset development and savings accounts";
}
@source(IRC_S7526A_B, relation = formalizes, coverage = exact, quote = "Qualified return preparation programs may use grants received under this section for—")
rule S7526AUseOfFundsLiberty defeasible {
    for p: Person;
    for purpose: GrantUsePurpose;
    when qualified_return_preparation_program(p)
        and program_uses_grant_for(p, purpose);
    then liberty S7526AUseGrantForAuthorizedPurpose {
        holder p;
        against Secretary;
        action program_uses_grant_for(p, purpose);
        window [-infinity, infinity];
    };
}
