// 26 U.S.C. §7502 — Timely mailing treated as timely filing and paying.
//
// Stage 1 (IRC-17, DECISION-0379): this is one of the timing rules every
// other package depends on. Modelled generically over a "mailed item"
// (return, claim, statement, other document, or payment) rather than typing
// it as `us.irc.core::Return` only — the text itself is generic and several
// owners (returns, collection, assessment) will assert facts about their own
// documents against this package's `timely_filed_by_mailing` interface.
//
// JUDGMENT CALLS (see report):
//  - (a)(1)'s "delivered ... after such period" is the gate that the rule
//    even needs to be reached (mail delivered ON TIME needs no §7502 rescue
//    at all); modelled as a precondition on the rule's applicability rather
//    than a fact the case must separately assert, because a case that shows
//    a postmark on/before the prescribed date and a passing (a)(2) test has
//    already shown everything (a)(1) requires of a late-delivered item.
//  - (b)'s "postmarks not made by ... USPS" gate is modelled as a defeater
//    on the general mailing rule (`unless postmark_not_by_usps(item) and not
//    postmark_by_usps_regulation_recognized(item)`), because the Secretary's
//    regulations recognizing a non-USPS postmark are an EXTERNAL fact this
//    package cannot invent (DECISION-0194 does not apply — this is not an
//    evaluative element of the norm, it is a delegated regulatory contract;
//    classified EXTERNAL_DEPENDENCY in coverage).
//  - (c)(2) (certified mail / electronic filing extension of the registered-
//    mail evidentiary rule) is a `power` of the Secretary to extend (c)(1)'s
//    treatment by regulation; `valid_when` is the single derived atom
//    `secretary_extended_registered_mail_treatment(mode)` per the lesson
//    that `valid_when` takes one atom only (LDC-E1305/E0201/E4101).
//  - (f)(2)(D) ("meets such other criteria as the Secretary may prescribe")
//    is a DECISION-0194 evaluative element: channelled through an `external
//    judgment relation` naming the Secretary, not an arithmetic guard.
//  - (e) mailing-of-deposits rule reuses the SAME `MailedItem` entity (a
//    deposit is itself something "delivered by the United States mail") with
//    its own timely-deposit predicate, since (e)(2)'s "second day before" is
//    a distinct arithmetic gate from (a)(2)'s "on or before the prescribed
//    date", and the two must not be conflated into one rule.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7502_A,
    IRC_S7502_C,
    IRC_S7502_E,
    IRC_S7502_F,
    Secretary,
};

// --- Shared vocabulary -------------------------------------------------------

entity MailedItem {
    label en unofficial "a return, claim, statement, or other document required to be filed, or payment or deposit required to be made, under the internal revenue laws";
}

// --- §7502(a): general rule --------------------------------------------------

relation prescribed_filing_date(item: MailedItem, d: Date) kind institutional {
    label en unofficial "the prescribed period or date (including any extension granted) for filing or paying the item";
}
relation postmarked_on(item: MailedItem, d: Date) kind empirical {
    label en unofficial "the date of the United States postmark stamped on the cover in which the item was mailed";
}
relation deposited_in_us_mail_properly_addressed(item: MailedItem) kind empirical {
    label en unofficial "the item was, within the prescribed time, deposited in the mail in the United States in an envelope or other appropriate wrapper, postage prepaid, properly addressed to the required agency, officer, or office";
}
relation postmark_not_by_usps(item: MailedItem) kind empirical {
    label en unofficial "the postmark on the item's cover was not made by the United States Postal Service";
}
relation postmark_by_usps_regulation_recognized(item: MailedItem) kind empirical {
    label en unofficial "the Secretary's regulations under (b) provide that this non-USPS postmark is recognized for purposes of this section (an external regulatory fact; see report, EXTERNAL_DEPENDENCY)";
}

// (d) exceptions — a positive predicate for each, combined with `unless`.
relation filed_in_court_other_than_tax_court(item: MailedItem) kind empirical {
    label en unofficial "the item is filed in, or the payment made to, a court other than the Tax Court (§7502(d)(1))";
}
relation currency_payment_not_actually_received(item: MailedItem) kind empirical {
    label en unofficial "the item is currency or another medium of payment not actually received and accounted for (§7502(d)(2))";
}
relation required_delivery_method_other_than_mail(item: MailedItem) kind empirical {
    label en unofficial "the item is required, under another provision of the internal revenue laws or regulations, to be delivered by a method other than mailing (§7502(d)(3))";
}

pub relation timely_filed_by_mailing(item: MailedItem, prescribed: Date, postmark: Date) kind institutional {
    label en unofficial "the mailed item is deemed filed or paid on the postmark date under §7502, rather than on the date of actual delivery";
}

@source(IRC_S7502_A, relation = formalizes, coverage = partial, quote = "the date of the United States postmark stamped on the cover in which such return, claim, statement, or other document, or payment, is mailed shall be deemed to be the date of delivery or the date of payment, as the case may be")
rule S7502TimelyMailingGeneralRule defeasible {
    for item: MailedItem;
    for prescribed: Date;
    for postmark: Date;
    when prescribed_filing_date(item, prescribed)
        and postmarked_on(item, postmark)
        and postmark <= prescribed
        and deposited_in_us_mail_properly_addressed(item);
    then timely_filed_by_mailing(item, prescribed, postmark);
    unless filed_in_court_other_than_tax_court(item)
        and prescribed_filing_date(item, prescribed) and postmarked_on(item, postmark);
    unless currency_payment_not_actually_received(item)
        and prescribed_filing_date(item, prescribed) and postmarked_on(item, postmark);
    unless required_delivery_method_other_than_mail(item)
        and prescribed_filing_date(item, prescribed) and postmarked_on(item, postmark);
    unless postmark_not_by_usps(item) and not_known(postmark_by_usps_regulation_recognized(item))
        and prescribed_filing_date(item, prescribed) and postmarked_on(item, postmark);
}

// --- §7502(c)(1): registered mail --------------------------------------------

relation sent_by_registered_mail(item: MailedItem, registration_date: Date) kind empirical {
    label en unofficial "the item was sent by United States registered mail, registered on the given date";
}

@source(IRC_S7502_C, relation = formalizes, coverage = partial, quote = "the date of registration shall be deemed the postmark date")
rule S7502RegisteredMailIsPostmarkDate defeasible {
    for item: MailedItem;
    for registration_date: Date;
    when sent_by_registered_mail(item, registration_date);
    then postmarked_on(item, registration_date);
}

// --- §7502(c)(2): certified mail; electronic filing --------------------------
//
// A delegated regulatory extension, not an evaluative element: the Secretary
// either has, or has not, extended (c)(1)'s treatment to certified mail or a
// given mode of electronic filing. Modelled as a `power` whose `valid_when`
// is the single derived atom below (LDC-E1305 lesson).

enum AlternateFilingMode { CertifiedMail; ElectronicFiling; }

relation secretary_extended_registered_mail_treatment(mode: AlternateFilingMode) kind institutional {
    label en unofficial "the Secretary has, by regulation under §7502(c)(2), extended the registered-mail prima-facie-evidence and postmark-date rule to this filing mode";
}
relation secretary_prescribes_extension(mode: AlternateFilingMode) kind empirical {
    label en unofficial "the Secretary has prescribed, by regulation, that (c)(1)'s treatment extends to this filing mode";
}

@source(IRC_S7502_C, relation = formalizes, coverage = partial, quote = "The Secretary is authorized to provide by regulations the extent to which the provisions of paragraph (1) with respect to prima facie evidence of delivery and the postmark date shall apply to certified mail and electronic filing")
rule S7502ExtendRegisteredMailTreatment strict {
    for mode: AlternateFilingMode;
    when secretary_prescribes_extension(mode);
    then power S7502ExtendRegisteredMailTreatmentPower {
        holder Secretary;
        over mode;
        exercise secretary_prescribes_extension(mode);
        valid_when secretary_prescribes_extension(mode);
        effect create(secretary_extended_registered_mail_treatment(mode));
    };
}

relation sent_by_certified_mail(item: MailedItem, mailing_date: Date) kind empirical {
    label en unofficial "the item was sent by United States certified mail on the given date";
}
relation filed_electronically(item: MailedItem, filing_date: Date) kind empirical {
    label en unofficial "the item was filed electronically on the given date";
}

@source(IRC_S7502_C, relation = formalizes, coverage = partial, quote = "certified mail and electronic filing")
rule S7502CertifiedMailIsPostmarkDate defeasible {
    for item: MailedItem;
    for mailing_date: Date;
    when sent_by_certified_mail(item, mailing_date)
        and secretary_extended_registered_mail_treatment(CertifiedMail);
    then postmarked_on(item, mailing_date);
}

@source(IRC_S7502_C, relation = formalizes, coverage = partial, quote = "certified mail and electronic filing")
rule S7502ElectronicFilingIsPostmarkDate defeasible {
    for item: MailedItem;
    for filing_date: Date;
    when filed_electronically(item, filing_date)
        and secretary_extended_registered_mail_treatment(ElectronicFiling);
    then postmarked_on(item, filing_date);
}

// --- §7502(e): mailing of deposits -------------------------------------------

relation deposit_prescribed_date(item: MailedItem, d: Date) kind institutional {
    label en unofficial "the prescribed date (including any extension) for making the deposit, under regulations prescribed by the Secretary under §6302(c)";
}
relation deposit_mailed_on(item: MailedItem, d: Date) kind empirical {
    label en unofficial "the date the deposit was mailed";
}
relation deposit_mailed_properly_addressed(item: MailedItem) kind empirical {
    label en unofficial "the deposit was, on or before the second day before the prescribed date, mailed in the United States in an envelope or other appropriate wrapper, postage prepaid, properly addressed to the depositary authorized to receive it";
}
relation deposit_amount_at_least_20000(item: MailedItem) kind empirical {
    label en unofficial "the deposit is $20,000 or more (§7502(e)(3))";
}
relation depositor_required_to_deposit_more_than_monthly(item: MailedItem) kind empirical {
    label en unofficial "the person required to make the deposit is required to deposit the tax more than once a month (§7502(e)(3) gate)";
}

pub relation timely_deposit_by_mailing(item: MailedItem, prescribed: Date, mailed: Date) kind institutional {
    label en unofficial "the mailed deposit is deemed received on the date it was mailed, under §7502(e)";
}

@source(IRC_S7502_E, relation = formalizes, coverage = partial, quote = "such deposit shall be deemed received by such bank, trust company, domestic building and loan association, or credit union on the date the deposit was mailed")
rule S7502TimelyDepositByMailing defeasible {
    for item: MailedItem;
    for prescribed: Date;
    for mailed: Date;
    when deposit_prescribed_date(item, prescribed)
        and deposit_mailed_on(item, mailed)
        and days_between(mailed, prescribed) >= 2
        and deposit_mailed_properly_addressed(item);
    then timely_deposit_by_mailing(item, prescribed, mailed);
    unless deposit_amount_at_least_20000(item) and depositor_required_to_deposit_more_than_monthly(item)
        and deposit_prescribed_date(item, prescribed) and deposit_mailed_on(item, mailed);
}

// --- §7502(f): private delivery services -------------------------------------

entity DeliveryService {
    label en unofficial "a trade or business providing a delivery service that may be designated by the Secretary under §7502(f)(2)";
}

relation delivery_service_available_to_general_public(s: DeliveryService) kind empirical {
    label en unofficial "the delivery service is available to the general public (§7502(f)(2)(A))";
}
relation delivery_service_timely_and_reliable(s: DeliveryService) kind empirical {
    label en unofficial "the delivery service is at least as timely and reliable on a regular basis as the United States mail (§7502(f)(2)(B))";
}
relation delivery_service_records_delivery_date(s: DeliveryService) kind empirical {
    label en unofficial "the delivery service records electronically, or marks on the cover, the date the item was given to it for delivery (§7502(f)(2)(C))";
}

// (D)'s "such other criteria as the Secretary may prescribe" is an open-ended
// evaluative element (DECISION-0194): channelled through the Secretary's own
// judgment, not an arithmetic guard the case can supply as a flat fact.
external judgment relation delivery_service_meets_secretary_criteria(s: DeliveryService) {
    authority Secretary;
    label en unofficial "the Secretary's judgment that the delivery service meets such other criteria as the Secretary may prescribe (§7502(f)(2)(D))";
}

relation delivery_service_designation_conditions_met(s: DeliveryService) kind institutional {
    label en unofficial "the delivery service satisfies (f)(2)(A)-(D), the conditions on which the Secretary's designation power is exercisable";
}
@source(IRC_S7502_F, relation = formalizes, coverage = partial, quote = "is available to the general public")
rule S7502DeliveryServiceConditionsMet strict {
    for s: DeliveryService;
    when delivery_service_available_to_general_public(s)
        and delivery_service_timely_and_reliable(s)
        and delivery_service_records_delivery_date(s)
        and delivery_service_meets_secretary_criteria(s);
    then delivery_service_designation_conditions_met(s);
}

relation designates_delivery_service(s: DeliveryService) kind empirical {
    label en unofficial "the Secretary designates the delivery service under §7502(f)(2)";
}
pub relation designated_delivery_service(s: DeliveryService) kind institutional {
    label en unofficial "the delivery service is, at present, designated by the Secretary under §7502(f)(2)";
}

@source(IRC_S7502_F, relation = formalizes, coverage = exact, quote = "The Secretary may designate a delivery service under the preceding sentence only if the Secretary determines that such service—")
rule S7502DesignateDeliveryService strict {
    for s: DeliveryService;
    when designates_delivery_service(s);
    then power S7502DesignateDeliveryServicePower {
        holder Secretary;
        over s;
        exercise designates_delivery_service(s);
        valid_when delivery_service_designation_conditions_met(s);
        effect create(designated_delivery_service(s));
    };
}

relation item_recorded_by_service_on(item: MailedItem, s: DeliveryService, d: Date) kind empirical {
    label en unofficial "the designated delivery service recorded or marked the date the item was given to it for delivery";
}
@source(IRC_S7502_F, relation = formalizes, coverage = exact, quote = "any reference in this section to a postmark by the United States Postal Service shall be treated as including a reference to any date recorded or marked as described in paragraph (2)(C) by any designated delivery service")
rule S7502DesignatedServiceRecordIsPostmarkDate defeasible {
    for item: MailedItem;
    for s: DeliveryService;
    for d: Date;
    when item_recorded_by_service_on(item, s, d)
        and designated_delivery_service(s);
    then postmarked_on(item, d);
}

// (f)(3): equivalents of registered/certified mail via a designated delivery
// service — the same extension mechanism as (c)(2), applied to a designated
// service's own registered/certified-equivalent product.
relation secretary_prescribes_service_equivalent_rule(s: DeliveryService) kind empirical {
    label en unofficial "the Secretary provides a rule similar to (c)(1) for a service substantially equivalent to registered or certified mail, provided by the designated delivery service";
}
relation designated_service_registered_equivalent(s: DeliveryService) kind institutional {
    label en unofficial "the named designated delivery service's product is treated, by the Secretary's rule, as substantially equivalent to registered or certified mail";
}
@source(IRC_S7502_F, relation = formalizes, coverage = partial, quote = "The Secretary may provide a rule similar to the rule of paragraph (1) with respect to any service provided by a designated delivery service which is substantially equivalent to United States registered or certified mail")
rule S7502ServiceEquivalentToRegisteredMail strict {
    for s: DeliveryService;
    when secretary_prescribes_service_equivalent_rule(s)
        and designated_delivery_service(s);
    then designated_service_registered_equivalent(s);
}
