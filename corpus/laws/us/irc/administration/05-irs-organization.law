// 26 U.S.C. §7802 (IRS Oversight Board), §7803 (Commissioner, Chief Counsel,
// National Taxpayer Advocate, Independent Office of Appeals), §7804 (other
// IRS personnel authority) — institutional relations and powers of the
// Service's organization, per the task's "institutional relations and
// powers" scope for these sections.
//
// SCOPE JUDGMENT CALL (see report). These three sections run to roughly 140
// disposition rows, most of which are internal government-organization
// detail addressed to Congress or to the agencies themselves (Oversight
// Board member qualifications and staggered terms, the exact contents of
// annual/semiannual reports, ethics-in-government cross-references, TIGTA
// audit-and-reporting duties) rather than a rule that changes a taxpayer's
// or an office-holder's legal position in a way this package's facts can
// test. Modelled here: the EXISTENCE of each office/board and its named
// holder-facing powers (appointment, removal, delegation limits, the
// Commissioner's regulations-consultation duty, the Taxpayer Bill of Rights
// as named rights, the National Taxpayer Advocate's report duty, the
// Independent Office of Appeals' resolution function and the taxpayer's own
// power to request Appeals consideration). NOT modelled as separate rules:
// Oversight Board composition counts/staggered terms (same
// numeric-roster-aggregate limitation as the joint-committee package's
// §8002(a), classified INTERPRETATION/TECH_GAP in coverage, not
// NON_NORMATIVE), the detailed CONTENTS lists of the required reports
// (§7802(f)(3), §7803(c)(2)(B), §7803(d)(1)-(2)) — classified NON_NORMATIVE
// (a reporting checklist, not a rule with its own breach state distinct from
// the underlying report duty already modelled), and internal personnel/ethics
// cross-references to Title 5/Title 18 (§7802(b)(3)) — classified
// NON_NORMATIVE (this title creates no separate internal-revenue-law
// position from them).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7802_A,
    IRC_S7802_C,
    IRC_S7802_D,
    IRC_S7803_A,
    IRC_S7803_B,
    IRC_S7803_C,
    IRC_S7803_E,
    IRC_S7804_A,
    IRC_S7804_D,
    Organ,
    Person,
    Secretary,
};

// --- §7802: IRS Oversight Board -----------------------------------------------

const OversightBoard: Organ = entity_ref("urn:us:irc:administration:clir#OversightBoard") {
    label en official "Internal Revenue Service Oversight Board";
}
relation is_oversight_board(o: Organ) kind institutional {
    label en unofficial "the organ is the Internal Revenue Service Oversight Board established by §7802(a)";
}
@source(IRC_S7802_A, relation = formalizes, coverage = exact, quote = "There is established within the Department of the Treasury the Internal Revenue Service Oversight Board")
assert is_oversight_board(OversightBoard);

relation oversight_board_reviews_strategic_plans(o: Organ) kind institutional {
    label en unofficial "the Oversight Board reviews and approves the Internal Revenue Service's strategic plans, under §7802(d)(1)";
}
@source(IRC_S7802_D, relation = formalizes, coverage = partial, quote = "To review and approve strategic plans of the Internal Revenue Service")
rule S7802OversightBoardReviewsStrategicPlans strict {
    when is_oversight_board(OversightBoard);
    then oversight_board_reviews_strategic_plans(OversightBoard);
}

relation oversight_board_recommends_commissioner_candidate(o: Organ, candidate: Person) kind empirical {
    label en unofficial "the Oversight Board recommends the person to the President as a candidate for appointment as Commissioner of Internal Revenue (§7802(d)(3)(A))";
}
pub relation commissioner_candidate_recommended(candidate: Person) kind institutional {
    label en unofficial "the person has been validly recommended to the President as a Commissioner candidate by the Oversight Board";
}
@source(IRC_S7802_D, relation = formalizes, coverage = partial, quote = "recommend to the President candidates for appointment as the Commissioner of Internal Revenue")
rule S7802RecommendCommissionerCandidate strict {
    for candidate: Person;
    when oversight_board_recommends_commissioner_candidate(OversightBoard, candidate);
    then power S7802RecommendCommissionerCandidatePower {
        holder OversightBoard;
        over candidate;
        exercise oversight_board_recommends_commissioner_candidate(OversightBoard, candidate);
        valid_when is_oversight_board(OversightBoard);
        effect create(commissioner_candidate_recommended(candidate));
    };
}

relation oversight_board_recommends_commissioner_removal(o: Organ, commissioner: Person) kind empirical {
    label en unofficial "the Oversight Board recommends to the President the removal of the Commissioner of Internal Revenue (§7802(d)(3)(A))";
}
pub relation commissioner_removal_recommended(commissioner: Person) kind institutional {
    label en unofficial "the removal of the Commissioner has been validly recommended to the President by the Oversight Board";
}
@source(IRC_S7802_D, relation = formalizes, coverage = partial, quote = "recommend to the President the removal of the Commissioner")
rule S7802RecommendCommissionerRemoval strict {
    for commissioner: Person;
    when oversight_board_recommends_commissioner_removal(OversightBoard, commissioner);
    then power S7802RecommendCommissionerRemovalPower {
        holder OversightBoard;
        over commissioner;
        exercise oversight_board_recommends_commissioner_removal(OversightBoard, commissioner);
        valid_when is_oversight_board(OversightBoard);
        effect create(commissioner_removal_recommended(commissioner));
    };
}
relation oversight_board_reviews_senior_executive_action(o: Organ, senior_executive: Person) kind empirical {
    label en unofficial "the Oversight Board reviews the Commissioner's selection, evaluation, or compensation of an Internal Revenue Service senior executive who has program management responsibility over significant functions (§7802(d)(3)(B))";
}
pub relation senior_executive_action_reviewed(senior_executive: Person) kind institutional {
    label en unofficial "the Commissioner's selection, evaluation, or compensation of the senior executive has been reviewed by the Oversight Board";
}
@source(IRC_S7802_D, relation = formalizes, coverage = partial, quote = "review the Commissioner's selection, evaluation, and compensation of Internal Revenue Service senior executives")
rule S7802ReviewSeniorExecutives strict {
    for senior_executive: Person;
    when oversight_board_reviews_senior_executive_action(OversightBoard, senior_executive);
    then power S7802ReviewSeniorExecutivesPower {
        holder OversightBoard;
        over senior_executive;
        exercise oversight_board_reviews_senior_executive_action(OversightBoard, senior_executive);
        valid_when is_oversight_board(OversightBoard);
        effect create(senior_executive_action_reviewed(senior_executive));
    };
}
relation oversight_board_approves_reorganization_plan(o: Organ, plan: Person) kind empirical {
    label en unofficial "the Oversight Board reviews and approves the Commissioner's plan for a major reorganization of the Internal Revenue Service (§7802(d)(3)(C))";
}
pub relation reorganization_plan_approved(plan: Person) kind institutional {
    label en unofficial "the Commissioner's major reorganization plan has been approved by the Oversight Board";
}
@source(IRC_S7802_D, relation = formalizes, coverage = exact, quote = "review and approve the Commissioner's plans for any major reorganization of the Internal Revenue Service")
rule S7802ApproveReorganization strict {
    for plan: Person;
    when oversight_board_approves_reorganization_plan(OversightBoard, plan);
    then power S7802ApproveReorganizationPower {
        holder OversightBoard;
        over plan;
        exercise oversight_board_approves_reorganization_plan(OversightBoard, plan);
        valid_when is_oversight_board(OversightBoard);
        effect create(reorganization_plan_approved(plan));
    };
}

relation oversight_board_has_no_responsibility_over(matter: Person) kind institutional {
    label en unofficial "the Oversight Board has no responsibility or authority over the named matter (tax policy formulation, specific law enforcement, specific procurement, or specific personnel actions except as (d)(3) allows), under §7802(c)(2)";
}
relation matter_is_excluded_from_oversight(matter: Person) kind empirical {
    label en unofficial "the matter is federal tax policy formulation, a specific law-enforcement activity, a specific procurement activity, or a specific personnel action excluded by §7802(c)(2)";
}
@source(IRC_S7802_C, relation = formalizes, coverage = partial, quote = "The Oversight Board shall have no responsibilities or authority with respect to")
rule S7802NoResponsibilityOverExcludedMatter strict {
    for matter: Person;
    when matter_is_excluded_from_oversight(matter);
    then oversight_board_has_no_responsibility_over(matter);
}

// --- §7803(a): Commissioner of Internal Revenue -------------------------------

const Commissioner: Organ = entity_ref("urn:us:irc:administration:clir#Commissioner") {
    label en official "Commissioner of Internal Revenue";
}
relation commissioner_appointed(p: Person) kind empirical {
    label en unofficial "the President, by and with the advice and consent of the Senate, appoints the person Commissioner of Internal Revenue";
}
pub relation is_commissioner(p: Person) kind institutional {
    label en unofficial "the person currently holds the office of Commissioner of Internal Revenue";
}
@source(IRC_S7803_A, relation = formalizes, coverage = exact, quote = "There shall be in the Department of the Treasury a Commissioner of Internal Revenue who shall be appointed by the President, by and with the advice and consent of the Senate.")
rule S7803AppointCommissioner strict {
    for p: Person;
    when commissioner_appointed(p);
    then power S7803AppointCommissionerPower {
        holder us.irc.core::Congress;
        over p;
        exercise commissioner_appointed(p);
        valid_when commissioner_appointed(p);
        effect create(is_commissioner(p));
    };
}

relation commissioner_removed(p: Person) kind empirical {
    label en unofficial "the President removes the person from the office of Commissioner of Internal Revenue";
}
@source(IRC_S7803_A, relation = formalizes, coverage = exact, quote = "The Commissioner may be removed at the will of the President.")
rule S7803RemoveCommissioner strict {
    for p: Person;
    when commissioner_removed(p) and is_commissioner(p);
    then power S7803RemoveCommissionerPower {
        holder us.irc.core::Congress;
        over p;
        exercise commissioner_removed(p);
        valid_when is_commissioner(p);
        effect terminate(is_commissioner(p));
    };
}

relation secretary_delegates_power_to_commissioner(power_kind: Person) kind empirical {
    label en unofficial "the Secretary delegates a §7803(a)(2)(A)/(B) power to the Commissioner (administration/management/direction/supervision of the internal revenue laws, or recommending Chief Counsel appointment/removal)";
}
relation secretary_determines_not_to_delegate(power_kind: Person) kind empirical {
    label en unofficial "the Secretary determines not to delegate the named §7803(a)(2)(A)/(B) power to the Commissioner";
}
relation notified_congressional_committees_30_days_ago(power_kind: Person, notice_date: Date, effective_date: Date) kind empirical {
    label en unofficial "the Secretary notified the named House and Senate committees of the non-delegation determination, and at least 30 days have passed before the determination's stated effective date (§7803(a)(2) gate)";
}
pub relation non_delegation_determination_effective(power_kind: Person, effective_date: Date) kind institutional {
    label en unofficial "the Secretary's determination not to delegate the named power has taken effect (only after the 30-day committee-notice period), under §7803(a)(2)";
}
@source(IRC_S7803_A, relation = formalizes, coverage = partial, quote = "such determination may not take effect until 30 days after the Secretary notifies the Committees on Ways and Means, Government Reform and Oversight, and Appropriations of the House of Representatives and the Committees on Finance, Governmental Affairs, and Appropriations of the Senate")
rule S7803NonDelegationEffectiveAfterNotice defeasible {
    for power_kind: Person;
    for notice_date: Date;
    for effective_date: Date;
    when secretary_determines_not_to_delegate(power_kind)
        and notified_congressional_committees_30_days_ago(power_kind, notice_date, effective_date)
        and days_between(notice_date, effective_date) >= 30;
    then non_delegation_determination_effective(power_kind, effective_date);
}

// §7803(a)(3): the Taxpayer Bill of Rights — named rights the Commissioner
// must ensure IRS employees are familiar with and act in accord with.
enum TaxpayerRightKind {
    RightToBeInformed; RightToQualityService; RightToPayNoMoreThanCorrectTax;
    RightToChallengeAndBeHeard; RightToAppealInIndependentForum; RightToFinality;
    RightToPrivacy; RightToConfidentiality; RightToRetainRepresentation;
    RightToFairAndJustTaxSystem;
}
relation taxpayer_right_in_question(right: TaxpayerRightKind) kind empirical {
    label en unofficial "the case identifies which §7803(a)(3) taxpayer right is at issue (binder — the rule is otherwise unconditional over the whole enum)";
}
relation commissioner_ensures_taxpayer_right_observed(right: TaxpayerRightKind) kind institutional {
    label en unofficial "the Commissioner ensures IRS employees are familiar with and act in accord with the named taxpayer right, under §7803(a)(3)";
}
@source(IRC_S7803_A, relation = formalizes, coverage = partial, quote = "the Commissioner shall ensure that employees of the Internal Revenue Service are familiar with and act in accord with taxpayer rights as afforded by other provisions of this title")
rule S7803TaxpayerBillOfRights(right: TaxpayerRightKind) strict {
    when is_commissioner(Commissioner) and taxpayer_right_in_question(right);
    then commissioner_ensures_taxpayer_right_observed(right);
}

// --- §7803(b): Chief Counsel ----------------------------------------------------

const ChiefCounsel: Organ = entity_ref("urn:us:irc:administration:clir#ChiefCounsel") {
    label en official "Chief Counsel for the Internal Revenue Service";
}
relation chief_counsel_appointed(p: Person) kind empirical {
    label en unofficial "the person is appointed Chief Counsel for the Internal Revenue Service";
}
pub relation is_chief_counsel(p: Person) kind institutional {
    label en unofficial "the person currently holds the office of Chief Counsel for the Internal Revenue Service";
}
@source(IRC_S7803_B, relation = formalizes, coverage = partial, quote = "There shall be in the Department of the Treasury a Chief Counsel for the Internal Revenue Service")
rule S7803AppointChiefCounsel strict {
    for p: Person;
    when chief_counsel_appointed(p);
    then power S7803AppointChiefCounselPower {
        holder us.irc.core::Congress;
        over p;
        exercise chief_counsel_appointed(p);
        valid_when chief_counsel_appointed(p);
        effect create(is_chief_counsel(p));
    };
}

// --- §7803(c): National Taxpayer Advocate --------------------------------------

const OfficeOfTaxpayerAdvocate: Organ = entity_ref("urn:us:irc:administration:clir#OfficeOfTaxpayerAdvocate") {
    label en official "Office of the Taxpayer Advocate";
}
relation is_office_of_taxpayer_advocate(o: Organ) kind institutional {
    label en unofficial "the office is the Office of the Taxpayer Advocate established by §7803(c)(1)(A)";
}
@source(IRC_S7803_C, relation = formalizes, coverage = exact, quote = "There is established in the Internal Revenue Service an office to be known as the \"Office of the Taxpayer")
assert is_office_of_taxpayer_advocate(OfficeOfTaxpayerAdvocate);

relation national_taxpayer_advocate_appointed(p: Person) kind empirical {
    label en unofficial "the Secretary of the Treasury, after consultation with the Commissioner and the Oversight Board, appoints the person National Taxpayer Advocate (§7803(c)(1)(B)(ii))";
}
pub relation is_national_taxpayer_advocate(p: Person) kind institutional {
    label en unofficial "the person currently holds the office of National Taxpayer Advocate";
}
@source(IRC_S7803_C, relation = formalizes, coverage = partial, quote = "The National Taxpayer Advocate shall be appointed by the Secretary of the Treasury after consultation")
rule S7803AppointNationalTaxpayerAdvocate strict {
    for p: Person;
    when national_taxpayer_advocate_appointed(p);
    then power S7803AppointNationalTaxpayerAdvocatePower {
        holder Secretary;
        over p;
        exercise national_taxpayer_advocate_appointed(p);
        valid_when national_taxpayer_advocate_appointed(p);
        effect create(is_national_taxpayer_advocate(p));
    };
}

relation taxpayer_advocate_report_submitted(p: Person, deadline_kind: Person, submitted_on: Date) kind empirical {
    label en unofficial "the National Taxpayer Advocate submitted the named report (objectives report by June 30, or annual report by December 31) on the given date";
}
relation taxpayer_advocate_report_due(p: Person, deadline_kind: Person, due: Date) kind institutional {
    label en unofficial "the statutory due date for the named report";
}
relation taxpayer_advocate_report_timely(p: Person, deadline_kind: Person) kind institutional {
    label en unofficial "the National Taxpayer Advocate's report was submitted by the statutory deadline";
}
@source(IRC_S7803_C, relation = formalizes, coverage = partial, quote = "Not later than June 30 of each calendar year, the National Taxpayer Advocate shall report")
rule S7803ObjectivesReportTimely defeasible {
    for p: Person;
    for deadline_kind: Person;
    for due: Date;
    for submitted_on: Date;
    when taxpayer_advocate_report_due(p, deadline_kind, due)
        and taxpayer_advocate_report_submitted(p, deadline_kind, submitted_on)
        and submitted_on <= due;
    then taxpayer_advocate_report_timely(p, deadline_kind);
}

// §7803(c)(1)(d)(i): National Taxpayer Advocate's power to appoint local
// taxpayer advocates and take personnel actions with respect to them.
relation national_taxpayer_advocate_appoints_local_advocate(p: Person, state: Person, local: Person) kind empirical {
    label en unofficial "the National Taxpayer Advocate appoints a local taxpayer advocate for a State";
}
pub relation is_local_taxpayer_advocate(local: Person, state: Person) kind institutional {
    label en unofficial "the person is the appointed local taxpayer advocate for the named State";
}
@source(IRC_S7803_C, relation = formalizes, coverage = partial, quote = "appoint local taxpayer advocates and make available at least 1 such advocate for each State")
rule S7803AppointLocalTaxpayerAdvocate strict {
    for p: Person;
    for state: Person;
    for local: Person;
    when national_taxpayer_advocate_appoints_local_advocate(p, state, local)
        and is_national_taxpayer_advocate(p);
    then power S7803AppointLocalTaxpayerAdvocatePower {
        holder p;
        over local;
        exercise national_taxpayer_advocate_appoints_local_advocate(p, state, local);
        valid_when is_national_taxpayer_advocate(p);
        effect create(is_local_taxpayer_advocate(local, state));
    };
}

// --- §7803(e): Internal Revenue Service Independent Office of Appeals ---------

const IndependentOfficeOfAppeals: Organ = entity_ref("urn:us:irc:administration:clir#IndependentOfficeOfAppeals") {
    label en official "Internal Revenue Service Independent Office of Appeals";
}
relation is_independent_office_of_appeals(o: Organ) kind institutional {
    label en unofficial "the office is the Internal Revenue Service Independent Office of Appeals established by §7803(e)(1)";
}
@source(IRC_S7803_E, relation = formalizes, coverage = exact, quote = "There is established in the Internal Revenue Service an office to be known as the \"Internal Revenue")
assert is_independent_office_of_appeals(IndependentOfficeOfAppeals);

relation appeals_resolution_available_to_taxpayer(t: Person) kind institutional {
    label en unofficial "the §7803(e)(3) Federal tax controversy resolution process is generally available to the taxpayer, under §7803(e)(4)";
}
@source(IRC_S7803_E, relation = formalizes, coverage = exact, quote = "The resolution process described in paragraph (3) shall be generally available to all taxpayers.")
relation taxpayer_in_question(t: Person) kind empirical {
    label en unofficial "the case identifies which taxpayer's access to Appeals is at issue (binder — the rule is otherwise unconditional over all taxpayers)";
}
rule S7803AppealsAvailableToAllTaxpayers strict {
    for t: Person;
    when is_independent_office_of_appeals(IndependentOfficeOfAppeals) and taxpayer_in_question(t);
    then appeals_resolution_available_to_taxpayer(t);
}

// §7803(e)(5): a taxpayer's request that a denial of Appeals referral be
// accompanied by a detailed written notice — modelled as the taxpayer's own
// power to trigger the notice duty, since the request is the taxpayer's act.
relation taxpayer_in_receipt_of_deficiency_notice(t: Person) kind empirical {
    label en unofficial "the taxpayer is in receipt of a notice of deficiency authorized under §6212 (§7803(e)(5)(A) gate)";
}
relation taxpayer_requests_appeals_referral(t: Person) kind empirical {
    label en unofficial "the taxpayer requests referral of the taxpayer's case to the Internal Revenue Service Independent Office of Appeals";
}
relation appeals_referral_denied(t: Person) kind empirical {
    label en unofficial "the Internal Revenue Service denies the taxpayer's request for referral to the Independent Office of Appeals";
}
pub relation appeals_denial_notice_required(t: Person) kind institutional {
    label en unofficial "the Internal Revenue Service must provide the taxpayer a detailed written notice of the denial, under §7803(e)(5)(A)";
}
relation request_excluded_by_paragraph_d(t: Person) kind empirical {
    label en unofficial "the request is of a type excluded from paragraph (5) by §7803(e)(5)(D)";
}
@source(IRC_S7803_E, relation = formalizes, coverage = partial, quote = "If any taxpayer which is in receipt of a notice of deficiency authorized under section 6212 requests")
rule S7803AppealsDenialNoticeRequired defeasible {
    for t: Person;
    when taxpayer_in_receipt_of_deficiency_notice(t)
        and taxpayer_requests_appeals_referral(t)
        and appeals_referral_denied(t);
    then appeals_denial_notice_required(t);
    unless request_excluded_by_paragraph_d(t);
}

// --- §7804(a): Commissioner's personnel authority ------------------------------

relation commissioner_employs_persons(p: Person) kind empirical {
    label en unofficial "the Commissioner employs the person for the administration and enforcement of the internal revenue laws";
}
relation secretary_otherwise_prescribes_employment(p: Person) kind empirical {
    label en unofficial "the Secretary otherwise prescribes as to the employment of this person (§7804(a)'s own gate)";
}
pub relation employed_by_commissioner(p: Person) kind institutional {
    label en unofficial "the person is validly employed under the Commissioner's §7804(a) authority";
}
@source(IRC_S7804_A, relation = formalizes, coverage = exact, quote = "the Commissioner of Internal Revenue is authorized to employ such number of persons as the Commissioner deems proper for the administration and enforcement of the internal revenue laws")
rule S7804CommissionerEmploysPersons strict {
    for p: Person;
    when commissioner_employs_persons(p);
    then power S7804CommissionerEmploysPersonsPower {
        holder Commissioner;
        over p;
        exercise commissioner_employs_persons(p);
        valid_when not_prescribed_otherwise_by_secretary(p);
        effect create(employed_by_commissioner(p));
    };
}
relation not_prescribed_otherwise_by_secretary(p: Person) kind derived {
    label en unofficial "the Secretary has not otherwise prescribed as to this person's employment (the negative of §7804(a)'s gate, folded into one valid_when atom per LDC-E1305)";
}
@source(IRC_S7804_A, relation = formalizes, coverage = partial, quote = "Unless otherwise prescribed by the Secretary")
rule S7804NotPrescribedOtherwise strict {
    for p: Person;
    when commissioner_employs_persons(p)
        and not_known(secretary_otherwise_prescribes_employment(p));
    then not_prescribed_otherwise_by_secretary(p);
}

// §7804(d): prohibition on rehiring an involuntarily separated employee.
relation removed_for_misconduct(p: Person) kind empirical {
    label en unofficial "the person was removed for misconduct under subchapter [7803's personnel subchapter] or chapter 43 or 75 of title 5, United States Code, or whose employment was terminated under RRA-1998 §1203";
}
relation commissioner_rehires(p: Person) kind empirical {
    label en unofficial "the Commissioner hires (or rehires) the person";
}
@source(IRC_S7804_D, relation = formalizes, coverage = exact, quote = "The Commissioner may not hire any individual previously employed by the Commissioner who was removed for misconduct")
rule S7804NoRehireAfterInvoluntarySeparation strict {
    for p: Person;
    when removed_for_misconduct(p);
    then prohibition NoRehireAfterInvoluntarySeparation {
        bearer Commissioner;
        beneficiary p;
        action commissioner_rehires(p);
        window [-infinity, infinity];
    };
}
