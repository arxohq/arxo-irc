// 26 U.S.C. §7872 — Treatment of loans with below-market interest rates.
// STAGE 3.
//
// JUDGMENT CALLS
//  - Rates: the applicable Federal rate (compounded semiannually, §1274(d))
//    is a case fact per loan and period (nothing is invented), EXCEPT for
//    months pinned in the AFR month-index, where the §7872(f)(2) table rules
//    below read it from the us.irs.rev_rul_afr Table 1 contract. The
//    demand-loan AFR is the short-term rate for the period; the term-loan AFR
//    is fixed at the loan date (term category applied by the case).
//  - Forgone interest for a calendar year: principal x effective annual rate x
//    (days the section applies / days in year) less the interest payable and
//    allocable to the year, never below zero; effective annual rate =
//    (1 + r/2)^2 - 1 (interest accrued at the AFR, compounded semiannually,
//    payable annually). Varying balances within the year and daily
//    compounding are TECH-GAPS G3011.
//  - Present value of payments (term loans) is a case fact (discounted at the
//    AFR by regulation): TECH-GAPS G3011.
//  - The count of days on which the section applies is a case fact per loan
//    and year; whether the section applies ON A GIVEN DAY (de minimis tests)
//    is executable.
//  - "In the nature of a gift" (§7872(f)(3)) and "one of the principal
//    purposes ... avoidance of any Federal tax" are external judgments
//    (DECISION-0194, authority TaxCourt: the adjudicator of such questions).
//  - §7872(d)(1): the $100,000 threshold is tested per calendar year (the
//    aggregate never over $100,000 in the year); the statute tests each day.
//  - §7872(g)(5): the indexed $90,000 limit (section 1(f)(3), 1985 base) is a
//    case fact (no value pinned).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

import us.irs.rev_rul_afr version "0.1.1";

use self::{
    IRC_S7872_A,
    IRC_S7872_B,
    IRC_S7872_C,
    IRC_S7872_D,
    IRC_S7872_E,
    IRC_S7872_F,
    IRC_S7872_G,
    IRC_S7872_H,
    IRC_S7872_I,
    Organ,
    Person,
    Secretary,
};

entity BelowMarketLoan {
    label en unofficial "a loan that may be a below-market loan under §7872";
}
relation loan_lender(l: BelowMarketLoan, p: Person) kind empirical {
    label en unofficial "the lender";
}
relation loan_borrower(l: BelowMarketLoan, p: Person) kind empirical {
    label en unofficial "the borrower";
}

// --- §7872(f)(5), (6): demand loans and term loans --------------------------------------------

relation payable_in_full_on_demand_of_lender(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan is payable in full at any time on the demand of the lender";
}
relation benefits_nontransferable_and_conditioned_on_future_services(l: BelowMarketLoan) kind empirical {
    label en unofficial "the benefits of the interest arrangements are not transferable and are conditioned on the future performance of substantial services by an individual";
}
relation regulations_treat_indefinite_maturity_as_demand(l: BelowMarketLoan) kind empirical {
    label en unofficial "regulations provide that a loan with an indefinite maturity is a demand loan";
}
pub relation demand_loan(l: BelowMarketLoan) kind institutional {
    label en unofficial "the loan is a demand loan for purposes other than determining the applicable Federal rate";
}
pub relation demand_loan_for_afr(l: BelowMarketLoan) kind institutional {
    label en unofficial "the loan is a demand loan for determining the applicable Federal rate: payable in full on the lender's demand (the service-conditioned and indefinite-maturity extensions do not count there)";
}
pub relation term_loan(l: BelowMarketLoan) kind institutional {
    label en unofficial "the loan is a term loan: any loan which is not a demand loan";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "The term \"demand loan\" means any loan which is payable in full at any time on the demand of the lender.")
rule S7872DemandLoanForAfr strict {
    for l: BelowMarketLoan;
    when payable_in_full_on_demand_of_lender(l);
    then demand_loan_for_afr(l);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "The term \"demand loan\" means any loan which is payable in full at any time on the demand of the lender.")
rule S7872DemandLoanPayable strict {
    for l: BelowMarketLoan;
    when payable_in_full_on_demand_of_lender(l);
    then demand_loan(l);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "Such term also includes (for purposes other than determining the applicable Federal rate under paragraph (2)) any loan if the benefits of the interest arrangements of such loan are not transferable and are conditioned on the future performance of substantial services by an individual.")
rule S7872DemandLoanServices strict {
    for l: BelowMarketLoan;
    when benefits_nontransferable_and_conditioned_on_future_services(l);
    then demand_loan(l);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "To the extent provided in regulations, such term also includes any loan with an indefinite maturity.")
rule S7872DemandLoanIndefinite strict {
    for l: BelowMarketLoan;
    when regulations_treat_indefinite_maturity_as_demand(l);
    then demand_loan(l);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "The term \"term loan\" means any loan which is not a demand loan.")
rule S7872TermLoan strict {
    for l: BelowMarketLoan;
    for b: Person;
    when loan_borrower(l, b)
        and not_known(demand_loan(l));
    then term_loan(l);
}

// --- §7872(e), (f)(1), (f)(2), (f)(4): below-market loans -------------------------------------------

relation amount_loaned(l: BelowMarketLoan, amt: Money) kind empirical {
    label en unofficial "the amount loaned: the amount received by the borrower (§7872(f)(4))";
}
relation interest_rate_payable_on_demand_loan(l: BelowMarketLoan, r: Decimal) kind empirical {
    label en unofficial "the annual rate at which interest is payable on the demand loan";
}
relation afr_semiannual_for_year(l: BelowMarketLoan, cy: Integer, r: Decimal) kind empirical {
    label en unofficial "the applicable Federal rate for a demand loan for the period: the Federal short-term rate in effect under section 1274(d), compounded semiannually (case-fact path; the Table 1 path is demand_loan_afr_from_table_7872, used for pinned months)";
}
relation present_value_of_payments_at_afr(l: BelowMarketLoan, pv: Money) kind empirical {
    label en unofficial "the present value, as of the date of the loan, of all payments due under the term loan, discounted at the applicable Federal rate as regulations provide (TECH-GAPS G3011)";
}
pub relation below_market_demand_loan_in_year(l: BelowMarketLoan, cy: Integer) kind institutional {
    label en unofficial "demand loan on which interest is payable at a rate less than the applicable Federal rate for the year";
}
pub relation below_market_term_loan(l: BelowMarketLoan) kind institutional {
    label en unofficial "term loan whose amount loaned exceeds the present value of all payments due";
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "in the case of a demand loan, interest is payable on the loan at a rate less than the applicable Federal rate")
rule S7872BelowMarketDemand strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for r: Decimal;
    for afr: Decimal;
    when demand_loan(l)
        and interest_rate_payable_on_demand_loan(l, r)
        and afr_semiannual_for_year(l, cy, afr)
        and r < afr;
    then below_market_demand_loan_in_year(l, cy);
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "in the case of a term loan, the amount loaned exceeds the present value of all payments due under the loan")
rule S7872BelowMarketTerm strict {
    for l: BelowMarketLoan;
    for amt: Money;
    for pv: Money;
    when term_loan(l)
        and amount_loaned(l, amt)
        and present_value_of_payments_at_afr(l, pv)
        and amt > pv;
    then below_market_term_loan(l);
}
relation loan_date(l: BelowMarketLoan, d: Date) kind empirical {
    label en unofficial "the date the loan was made";
}
relation written_contract_to_purchase_residence_date(l: BelowMarketLoan, d: Date) kind empirical {
    label en unofficial "the date the written contract to purchase the principal residence was entered into";
}
relation employer_term_loan_for_principal_residence_purchase(l: BelowMarketLoan) kind empirical {
    label en unofficial "a term loan by an employer to an employee whose proceeds are used to purchase a principal residence (section 121)";
}
relation section_217_applies_to_purchase(l: BelowMarketLoan) kind empirical {
    label en unofficial "the purchase is in connection with the commencement of work or a change in the principal place of work to which section 217 applies";
}
pub relation afr_determination_date(l: BelowMarketLoan, d: Date) kind institutional {
    label en unofficial "the date as of which the applicable Federal rate of a term loan is determined: the day the loan was made, or for an employee relocation loan to which section 217 applies, the date of the written purchase contract (§7872(f)(2)(A), (11))";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "the applicable Federal rate shall be the applicable Federal rate in effect under section 1274(d) (as of the day on which the loan was made), compounded semiannually")
rule S7872AfrDateLoanDay defeasible {
    for l: BelowMarketLoan;
    for d: Date;
    when term_loan(l)
        and loan_date(l, d);
    then afr_determination_date(l, d);
    unless employer_term_loan_for_principal_residence_purchase(l) and section_217_applies_to_purchase(l) and term_loan(l) and loan_date(l, d);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "the determination of the applicable Federal rate shall be made as of the date the written contract to purchase such residence was entered into")
rule S7872AfrDateRelocation strict {
    for l: BelowMarketLoan;
    for d: Date;
    when term_loan(l)
        and employer_term_loan_for_principal_residence_purchase(l)
        and section_217_applies_to_purchase(l)
        and written_contract_to_purchase_residence_date(l, d);
    then afr_determination_date(l, d);
}

// --- §7872(f)(2): applicable Federal rates from the pinned Table 1 -------------------------------------------
// The section 1274(d) rates are published monthly by the IRS in Revenue Rulings. This module reads them from
// the us.irs.rev_rul_afr Table 1 contract (afr_table_rate/4: horizon, tier, compounding, rate) under the
// month-index policy (corpus/laws/us/rev-rul-afr/month-index.json): a table rule below fires only for a pinned
// month ("2026-08" via Rev. Rul. 2026-13, "2026-10" via Rev. Rul. 2026-19); a month absent from the index
// (e.g. 2026-09, the 2025 duplicates) keeps the case-fact path. Single-issue evaluation worlds are assumed:
// both pinned issues emit the same predicate, so world composition (one issue per world) is the merge step's.
// Every rate number comes from the tables; .law carries only the statutory key literals
// (horizon/tier/compounding) and the month policy data above — no rate is written here.
relation afr_table_month_7872(m: Text) kind institutional {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue governs a Table 1 lookup: a month pinned in the AFR month-index (the freshest ruling of that month)";
}
rule S7872AfrMonth202608 strict {
    label en unofficial "August 2026 is a pinned AFR month (Rev. Rul. 2026-13, month-index selection policy)";
    when true;
    then afr_table_month_7872("2026-08");
}
rule S7872AfrMonth202610 strict {
    label en unofficial "October 2026 is a pinned AFR month (Rev. Rul. 2026-19, month-index selection policy)";
    when true;
    then afr_table_month_7872("2026-10");
}

// --- §7872(f)(2)(B): demand-loan AFR from Table 1 (short-term, semiannual, for the period) --------------------
relation demand_loan_afr_month_7872(l: BelowMarketLoan, cy: Integer, m: Text) kind empirical {
    label en unofficial "the calendar month (YYYY-MM) whose Revenue Ruling issue supplies the Federal short-term rate for the demand loan's forgone-interest period in the year (case-selected: the statute names the period, not the month)";
}
pub relation demand_loan_afr_from_table_7872(l: BelowMarketLoan, cy: Integer, m: Text, r: Decimal) kind institutional {
    label en official "the applicable Federal rate for the demand loan for the year from the pinned Table 1: the Federal short-term rate in effect under section 1274(d) for the period, compounded semiannually (section 7872(f)(2)(B))";
}
@source(IRC_S7872_F, relation = formalizes, coverage = partial, quote = "In the case of a demand loan, the applicable Federal rate shall be the Federal short-term rate in effect under section 1274(d) for the period for which the amount of forgone interest is being determined, compounded semiannually.")
rule S7872DemandAfrFromTable strict {
    label en official "the demand-loan AFR for the year is the Table 1 short-term base rate with semiannual compounding for a pinned month (section 7872(f)(2)(B))";
    for l: BelowMarketLoan;
    for cy: Integer;
    for m: Text;
    for r: Decimal;
    when demand_loan(l)
        and demand_loan_afr_month_7872(l, cy, m)
        and afr_table_month_7872(m)
        and us.irs.rev_rul_afr::afr_table_rate("short", "base", "semiannual", r);
    then demand_loan_afr_from_table_7872(l, cy, m, r);
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "in the case of a demand loan, interest is payable on the loan at a rate less than the applicable Federal rate")
rule S7872BelowMarketDemandFromTable strict {
    label en official "a demand loan is below-market for the year when its payable rate is less than the Table 1 AFR (section 7872(e)(1)(A) via section 7872(f)(2)(B))";
    for l: BelowMarketLoan;
    for cy: Integer;
    for m: Text;
    for r: Decimal;
    for afr: Decimal;
    when demand_loan(l)
        and interest_rate_payable_on_demand_loan(l, r)
        and demand_loan_afr_from_table_7872(l, cy, m, afr)
        and r < afr;
    then below_market_demand_loan_in_year(l, cy);
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "the excess of—")
rule S7872ForgoneInterestDemandFromTable strict {
    label en official "forgone interest on a demand loan from the Table 1 AFR (section 7872(e)(2) via section 7872(f)(2)(B))";
    for l: BelowMarketLoan;
    for cy: Integer;
    for m: Text;
    for principal: Money;
    for afr: Decimal;
    for n: Integer;
    for ydays: Integer;
    for paid: Money;
    when demand_loan(l)
        and principal_outstanding(l, cy, principal)
        and demand_loan_afr_from_table_7872(l, cy, m, afr)
        and days_section_applies_in_year(l, cy, n)
        and days_in_calendar_year(cy, ydays)
        and interest_payable_allocable_to_year(l, cy, paid);
    then forgone_interest_for_year(l, cy, max(0.00 USD, div_round(principal * ((1.0 + afr * 0.5) * (1.0 + afr * 0.5) - 1.0) * n, ydays * 1.0, 2, "HALF_UP") - paid));
}

// --- §7872(f)(2)(A): term-loan AFR from Table 1 (1274(d) horizon of the loan, semiannual, as of loan day) -----
relation term_loan_afr_month_7872(l: BelowMarketLoan, m: Text) kind empirical {
    label en unofficial "the calendar month (YYYY-MM) of the AFR determination date whose Revenue Ruling issue supplies the term-loan rate (case-selected: normally the month of afr_determination_date)";
}
relation term_loan_afr_horizon_7872(l: BelowMarketLoan, h: Text) kind empirical {
    label en unofficial "the section 1274(d)(1) term category of the loan (short, mid, or long), applied by the case to the loan's term (the 1274(d)(1) year boundaries are not pinned in this package)";
}
pub relation term_loan_afr_from_table_7872(l: BelowMarketLoan, m: Text, r: Decimal) kind institutional {
    label en official "the applicable Federal rate for the term loan from the pinned Table 1: the section 1274(d) rate for the loan's term category, compounded semiannually (section 7872(f)(2)(A))";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "the applicable Federal rate shall be the applicable Federal rate in effect under section 1274(d) (as of the day on which the loan was made), compounded semiannually")
rule S7872TermAfrFromTable strict {
    label en official "the term-loan AFR is the Table 1 base rate of the loan's 1274(d) term category with semiannual compounding for a pinned month (section 7872(f)(2)(A))";
    for l: BelowMarketLoan;
    for m: Text;
    for h: Text;
    for r: Decimal;
    when term_loan(l)
        and term_loan_afr_month_7872(l, m)
        and term_loan_afr_horizon_7872(l, h)
        and afr_table_month_7872(m)
        and us.irs.rev_rul_afr::afr_table_rate(h, "base", "semiannual", r);
    then term_loan_afr_from_table_7872(l, m, r);
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "the excess of—")
rule S7872ForgoneInterestGiftTermFromTable strict {
    label en official "forgone interest on a gift term loan from the Table 1 AFR at the loan date (section 7872(e)(2) via section 7872(f)(2)(A))";
    for l: BelowMarketLoan;
    for cy: Integer;
    for m: Text;
    for principal: Money;
    for afr: Decimal;
    for n: Integer;
    for ydays: Integer;
    for paid: Money;
    when term_loan(l)
        and gift_loan(l)
        and principal_outstanding(l, cy, principal)
        and term_loan_afr_from_table_7872(l, m, afr)
        and days_section_applies_in_year(l, cy, n)
        and days_in_calendar_year(cy, ydays)
        and interest_payable_allocable_to_year(l, cy, paid);
    then forgone_interest_for_year(l, cy, max(0.00 USD, div_round(principal * ((1.0 + afr * 0.5) * (1.0 + afr * 0.5) - 1.0) * n, ydays * 1.0, 2, "HALF_UP") - paid));
}

// --- §7872(c): loans to which the section applies -----------------------------------------------------

external judgment relation forgoing_of_interest_in_nature_of_gift(l: BelowMarketLoan) {
    authority TaxCourt;
    label en unofficial "the forgoing of interest is in the nature of a gift (§7872(f)(3))";
}
external judgment relation interest_arrangements_principal_purpose_tax_avoidance(l: BelowMarketLoan) {
    authority TaxCourt;
    label en unofficial "one of the principal purposes of the interest arrangements of the loan is the avoidance of any Federal tax (§7872(c)(1)(D), (c)(2)-(3))";
}
relation loan_is_below_market(l: BelowMarketLoan) kind derived {
    label en unofficial "the loan is a below-market loan (demand or term) for some year or at all";
}
relation employer_employee_loan(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan is directly or indirectly between an employer and an employee";
}
relation independent_contractor_loan(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan is directly or indirectly between an independent contractor and a person for whom the contractor provides services";
}
relation corporation_shareholder_loan(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan is directly or indirectly between a corporation and a shareholder";
}
relation regulations_extend_section_to_loan(l: BelowMarketLoan) kind empirical {
    label en unofficial "to the extent provided in regulations, the loan (not described in (A), (B), (C) or (F)) has interest arrangements with a significant effect on a Federal tax liability of the lender or borrower";
}
relation loan_to_qualified_continuing_care_facility_under_contract(l: BelowMarketLoan) kind empirical {
    label en unofficial "a loan to a qualified continuing care facility pursuant to a continuing care contract";
}
relation gift_loan(l: BelowMarketLoan) kind derived {
    label en unofficial "a below-market loan where the forgoing of interest is in the nature of a gift";
}
relation section_7872_category_applies(l: BelowMarketLoan) kind derived {
    label en unofficial "the loan is in one of the categories of §7872(c)(1)(A)-(F)";
}
relation below_market_loan_at_all(l: BelowMarketLoan) kind derived {
    label en unofficial "the loan is below-market in the demand or term sense";
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "The term \"below-market loan\" means any loan if—")
rule S7872BelowMarketAnyDemand strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    when below_market_demand_loan_in_year(l, cy);
    then below_market_loan_at_all(l);
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "The term \"below-market loan\" means any loan if—")
rule S7872BelowMarketAnyTerm strict {
    for l: BelowMarketLoan;
    when below_market_term_loan(l);
    then below_market_loan_at_all(l);
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "The term \"gift loan\" means any below-market loan where the forgoing of interest is in the nature of a gift.")
rule S7872GiftLoan strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and forgoing_of_interest_in_nature_of_gift(l);
    then gift_loan(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "Any below-market loan which is a gift loan.")
rule S7872CategoryGift strict {
    for l: BelowMarketLoan;
    when gift_loan(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "an employer and an employee, or")
rule S7872CategoryEmployer strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and employer_employee_loan(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "an independent contractor and a person for whom such independent contractor provides services")
rule S7872CategoryContractor strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and independent_contractor_loan(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "Any below-market loan directly or indirectly between a corporation and any shareholder of such corporation.")
rule S7872CategoryShareholder strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and corporation_shareholder_loan(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "Any below-market loan 1 of the principal purposes of the interest arrangements of which is the avoidance of any Federal tax.")
rule S7872CategoryTaxAvoidance strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and interest_arrangements_principal_purpose_tax_avoidance(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "To the extent provided in regulations, any below-market loan which is not described in subparagraph (A), (B), (C), or (F)")
rule S7872CategoryRegulations strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and regulations_extend_section_to_loan(l);
    then section_7872_category_applies(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "Any loan to any qualified continuing care facility pursuant to a continuing care contract.")
rule S7872CategoryContinuingCare strict {
    for l: BelowMarketLoan;
    when below_market_loan_at_all(l)
        and loan_to_qualified_continuing_care_facility_under_contract(l);
    then section_7872_category_applies(l);
}
// (c)(2), (c)(3): $10,000 de minimis exceptions, tested per day
relation aggregate_outstanding_on(l: BelowMarketLoan, d: Date, amt: Money) kind empirical {
    label en unofficial "the aggregate outstanding amount of loans between the borrower and lender on the day (spouses treated as one person, §7872(f)(7))";
}
relation gift_loan_directly_between_individuals(l: BelowMarketLoan) kind empirical {
    label en unofficial "the gift loan is directly between individuals";
}
relation gift_loan_attributable_to_income_producing_assets(l: BelowMarketLoan) kind empirical {
    label en unofficial "the gift loan is directly attributable to the purchase or carrying of income-producing assets";
}
relation section_applied_on_an_earlier_day(l: BelowMarketLoan) kind empirical {
    label en unofficial "section 7872 applied to the term loan on an earlier day";
}
relation excluded_by_sections_483_643i_1274(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan is one to which section 483, 643(i) or 1274 applies";
}
relation de_minimis_day(l: BelowMarketLoan, d: Date) kind derived {
    label en unofficial "the day is excluded by the $10,000 de minimis exception of (c)(2) or (c)(3), not defeated by (f)(10)";
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "this section shall not apply to any day on which the aggregate outstanding amount of loans between such individuals does not exceed $10,000")
rule S7872DeMinimisGift strict {
    for l: BelowMarketLoan;
    for d: Date;
    for agg: Money;
    when gift_loan(l)
        and gift_loan_directly_between_individuals(l)
        and aggregate_outstanding_on(l, d, agg)
        and agg <= 10000.00 USD
        and not_known(gift_loan_attributable_to_income_producing_assets(l))
        and not_known(term_loan_stays_subject_under_f10(l));
    then de_minimis_day(l, d);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "this section shall not apply to any day on which the aggregate outstanding amount of loans between the borrower and lender does not exceed $10,000")
rule S7872DeMinimisCompensationOrCorporate strict {
    for l: BelowMarketLoan;
    for d: Date;
    for agg: Money;
    when aggregate_outstanding_on(l, d, agg)
        and agg <= 10000.00 USD
        and not_known(interest_arrangements_principal_purpose_tax_avoidance(l))
        and not_known(term_loan_stays_subject_under_f10(l))
        and comp_or_corp_loan(l);
    then de_minimis_day(l, d);
}
relation comp_or_corp_loan(l: BelowMarketLoan) kind derived {
    label en unofficial "the loan is described in (c)(1)(B) or (C): compensation-related or corporation-shareholder";
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "In the case of any loan described in subparagraph (B) or (C) of paragraph (1)")
rule S7872CompOrCorpEmployer strict {
    for l: BelowMarketLoan;
    when employer_employee_loan(l);
    then comp_or_corp_loan(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "In the case of any loan described in subparagraph (B) or (C) of paragraph (1)")
rule S7872CompOrCorpContractor strict {
    for l: BelowMarketLoan;
    when independent_contractor_loan(l);
    then comp_or_corp_loan(l);
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "In the case of any loan described in subparagraph (B) or (C) of paragraph (1)")
rule S7872CompOrCorpShareholder strict {
    for l: BelowMarketLoan;
    when corporation_shareholder_loan(l);
    then comp_or_corp_loan(l);
}
relation term_loan_stays_subject_under_f10(l: BelowMarketLoan) kind derived {
    label en unofficial "a term loan to which the section applied on an earlier day continues to be subject to it notwithstanding (c)(2) and (3) (for a gift loan, only for chapter 12)";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "If this section applies to any term loan on any day, this section shall continue to apply to such loan notwithstanding paragraphs (2) and (3) of subsection (c).")
rule S7872F10TermLoanContinues strict {
    for l: BelowMarketLoan;
    when term_loan(l)
        and section_applied_on_an_earlier_day(l)
        and not_known(gift_loan(l));
    then term_loan_stays_subject_under_f10(l);
}
// (g), (h): loans to qualified continuing care facilities
relation lender_or_spouse_age_at_close_of_year(l: BelowMarketLoan, cy: Integer, age: Integer) kind empirical {
    label en unofficial "the age attained before the close of the calendar year by the lender (or the lender's spouse, if greater)";
}
relation facility_is_qccf_on_last_day_of_year(l: BelowMarketLoan, cy: Integer) kind empirical {
    label en unofficial "the facility owing the loan is a qualified continuing care facility on the last day of the year";
}
relation loan_made_pursuant_to_continuing_care_contract(l: BelowMarketLoan) kind empirical {
    label en unofficial "the loan was made pursuant to a continuing care contract";
}
relation aggregate_continuing_care_loans_with_previous(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the aggregate outstanding amount of the loan (without regard to (g)), added to all other previous loans between the lender (or spouse) and any qualified continuing care facility to which (g)(1) applies";
}
relation indexed_continuing_care_limit(cy: Integer, amt: Money) kind empirical {
    label en unofficial "the $90,000 limit of (g)(2), increased for loans made after 1986 by the section 1(f)(3) adjustment (1985 base) rounded to the nearest $100 (case-supplied; no value pinned)";
}
relation section_7872h_exception(l: BelowMarketLoan, cy: Integer) kind derived {
    label en unofficial "the (h) exception applies for the calendar year: loan owed by a qualified continuing care facility on the last day, made pursuant to a continuing care contract, lender (or spouse) attaining age 62";
}
relation section_7872g_exception(l: BelowMarketLoan, cy: Integer) kind derived {
    label en unofficial "the (g) exception applies for the calendar year: below-market loan to a qualified continuing care facility under a contract, lender (or spouse) attaining age 65, within the indexed $90,000 limit, and (h) not applicable to that year (§7872(g)(6))";
}
relation continuing_care_exception_applies(l: BelowMarketLoan, cy: Integer) kind derived {
    label en unofficial "the (g) or (h) exception applies for the calendar year";
}
@source(IRC_S7872_H, relation = formalizes, coverage = exact, quote = "if such loan was made pursuant to a continuing care contract and if the lender (or the lender's spouse) attains age 62 before the close of such year")
rule S7872HException strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for age: Integer;
    when facility_is_qccf_on_last_day_of_year(l, cy)
        and loan_made_pursuant_to_continuing_care_contract(l)
        and lender_or_spouse_age_at_close_of_year(l, cy, age)
        and age >= 62;
    then section_7872h_exception(l, cy);
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "if the lender (or the lender's spouse) attains age 65 before the close of such year")
rule S7872GException strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for age: Integer;
    for agg: Money;
    for limit: Money;
    when loan_to_qualified_continuing_care_facility_under_contract(l)
        and lender_or_spouse_age_at_close_of_year(l, cy, age)
        and age >= 65
        and aggregate_continuing_care_loans_with_previous(l, cy, agg)
        and indexed_continuing_care_limit(cy, limit)
        and agg <= limit
        and not_known(section_7872h_exception(l, cy));
    then section_7872g_exception(l, cy);
}
pub relation continuing_care_excess_not_excluded(l: BelowMarketLoan, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the part of the aggregate outstanding amount above the (g)(2) limit, to which the (g)(1) exception does not extend and which stays subject to the section (the rule applies only \"to the extent\" the aggregate is within the limit; the day-level application of the section to that part is not split, TECH-GAPS G3011)";
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply only to the extent that the aggregate outstanding amount of any loan to which such paragraph applies")
rule S7872GExcess strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for age: Integer;
    for agg: Money;
    for limit: Money;
    when loan_to_qualified_continuing_care_facility_under_contract(l)
        and lender_or_spouse_age_at_close_of_year(l, cy, age)
        and age >= 65
        and aggregate_continuing_care_loans_with_previous(l, cy, agg)
        and indexed_continuing_care_limit(cy, limit)
        and agg > limit
        and not_known(section_7872h_exception(l, cy));
    then continuing_care_excess_not_excluded(l, cy, agg - limit);
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply for any calendar year to which subsection (h) applies.")
rule S7872ContinuingCareExceptionH strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    when section_7872h_exception(l, cy);
    then continuing_care_exception_applies(l, cy);
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "This section shall not apply for any calendar year to any below-market loan made by a lender to a qualified continuing care facility pursuant to a continuing care contract")
rule S7872ContinuingCareExceptionG strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    when section_7872g_exception(l, cy);
    then continuing_care_exception_applies(l, cy);
}
relation day_in_calendar_year(d: Date, cy: Integer) kind empirical {
    label en unofficial "the day falls in the calendar year";
}
pub relation section_7872_applies_on_day(l: BelowMarketLoan, d: Date) kind institutional {
    label en unofficial "§7872 applies to the loan on the day: a below-market loan in one of the (c)(1) categories, not excluded by (c)(2)-(3) de minimis, sections 483/643(i)/1274, or the continuing care exceptions";
}
@source(IRC_S7872_C, relation = formalizes, coverage = exact, quote = "Except as otherwise provided in this subsection and subsection (g), this section shall apply to—")
rule S7872AppliesOnDay strict {
    for l: BelowMarketLoan;
    for d: Date;
    for cy: Integer;
    when section_7872_category_applies(l)
        and day_in_calendar_year(d, cy)
        and not_known(de_minimis_day(l, d))
        and not_known(excluded_by_sections_483_643i_1274(l))
        and not_known(continuing_care_exception_applies(l, cy));
    then section_7872_applies_on_day(l, d);
}
// --- §7872(a), (e)(2), (f)(2): gift and demand loans -----------------------------------------------------------

relation principal_outstanding(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the principal outstanding during the year (constant for the period counted; varying balances are TECH-GAPS G3011)";
}
relation days_section_applies_in_year(l: BelowMarketLoan, cy: Integer, n: Integer) kind empirical {
    label en unofficial "the number of days in the year on which the section applies to the loan (case-supplied count of the days for which section_7872_applies_on_day holds)";
}
relation days_in_calendar_year(cy: Integer, n: Integer) kind empirical {
    label en unofficial "the number of days in the calendar year";
}
relation interest_payable_allocable_to_year(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the interest payable on the loan and properly allocable to the year";
}
relation calendar_year_last_day(cy: Integer, d: Date) kind empirical {
    label en unofficial "December 31 of the calendar year (case-supplied: no calendar-year date term, TECH-GAPS G3005)";
}
relation regulations_alter_timing_of_transfers(l: BelowMarketLoan) kind empirical {
    label en unofficial "regulations prescribed by the Secretary provide otherwise for the time the forgone interest is treated as transferred and retransferred";
}
pub relation forgone_interest_for_year(l: BelowMarketLoan, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the forgone interest for the calendar year: the excess of the interest at the applicable Federal rate (compounded semiannually, payable annually) over the interest payable and allocable to the year";
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "the excess of—")
rule S7872ForgoneInterestDemand strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for principal: Money;
    for afr: Decimal;
    for n: Integer;
    for ydays: Integer;
    for paid: Money;
    when demand_loan(l)
        and principal_outstanding(l, cy, principal)
        and afr_semiannual_for_year(l, cy, afr)
        and days_section_applies_in_year(l, cy, n)
        and days_in_calendar_year(cy, ydays)
        and interest_payable_allocable_to_year(l, cy, paid);
    then forgone_interest_for_year(l, cy, max(0.00 USD, div_round(principal * ((1.0 + afr * 0.5) * (1.0 + afr * 0.5) - 1.0) * n, ydays * 1.0, 2, "HALF_UP") - paid));
}
@source(IRC_S7872_E, relation = formalizes, coverage = exact, quote = "the excess of—")
rule S7872ForgoneInterestGiftTerm strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for principal: Money;
    for afr: Decimal;
    for n: Integer;
    for ydays: Integer;
    for paid: Money;
    when term_loan(l)
        and gift_loan(l)
        and principal_outstanding(l, cy, principal)
        and afr_at_loan_date(l, afr)
        and days_section_applies_in_year(l, cy, n)
        and days_in_calendar_year(cy, ydays)
        and interest_payable_allocable_to_year(l, cy, paid);
    then forgone_interest_for_year(l, cy, max(0.00 USD, div_round(principal * ((1.0 + afr * 0.5) * (1.0 + afr * 0.5) - 1.0) * n, ydays * 1.0, 2, "HALF_UP") - paid));
}
relation afr_at_loan_date(l: BelowMarketLoan, r: Decimal) kind empirical {
    label en unofficial "the applicable Federal rate in effect under section 1274(d) as of the determination date, compounded semiannually (term loans; case-fact path — the Table 1 path is term_loan_afr_from_table_7872, used for pinned months)";
}
pub relation subsection_a_applies(l: BelowMarketLoan, cy: Integer) kind institutional {
    label en unofficial "subsection (a) governs the loan for the year: a below-market gift loan or demand loan to which the section applies (a gift term loan is governed by (b)(1) for chapter 12 (§7872(d)(2)))";
}
pub relation forgone_interest_transferred_to_borrower(l: BelowMarketLoan, cy: Integer, amt: Money, on: Date) kind institutional {
    label en unofficial "the forgone interest is treated as transferred from the lender to the borrower on the last day of the calendar year";
}
pub relation forgone_interest_retransferred_as_interest(l: BelowMarketLoan, cy: Integer, amt: Money, on: Date) kind institutional {
    label en unofficial "the forgone interest is treated as retransferred by the borrower to the lender as interest on the last day of the calendar year";
}
@source(IRC_S7872_A, relation = formalizes, coverage = exact, quote = "in the case of any below-market loan to which this section applies and which is a gift loan or a demand loan, the forgone interest shall be treated as—")
rule S7872SubsectionAApplies strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for d: Date;
    when section_7872_applies_on_day(l, d)
        and day_in_calendar_year(d, cy)
        and demand_loan(l);
    then subsection_a_applies(l, cy);
}
@source(IRC_S7872_A, relation = formalizes, coverage = exact, quote = "and which is a gift loan or a demand loan")
rule S7872SubsectionAGiftLoan strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for d: Date;
    when section_7872_applies_on_day(l, d)
        and day_in_calendar_year(d, cy)
        and gift_loan(l);
    then subsection_a_applies(l, cy);
}
@source(IRC_S7872_A, relation = formalizes, coverage = exact, quote = "(A) transferred from the lender to the borrower, and")
rule S7872TransferToBorrower defeasible {
    for l: BelowMarketLoan;
    for cy: Integer;
    for amt: Money;
    for last: Date;
    when subsection_a_applies(l, cy)
        and forgone_interest_for_year(l, cy, amt)
        and calendar_year_last_day(cy, last);
    then forgone_interest_transferred_to_borrower(l, cy, amt, last);
    unless regulations_alter_timing_of_transfers(l) and subsection_a_applies(l, cy) and forgone_interest_for_year(l, cy, amt) and calendar_year_last_day(cy, last);
}
@source(IRC_S7872_A, relation = formalizes, coverage = exact, quote = "(B) retransferred by the borrower to the lender as interest.")
rule S7872RetransferAsInterest defeasible {
    for l: BelowMarketLoan;
    for cy: Integer;
    for amt: Money;
    for last: Date;
    when subsection_a_applies(l, cy)
        and forgone_interest_for_year(l, cy, amt)
        and calendar_year_last_day(cy, last);
    then forgone_interest_retransferred_as_interest(l, cy, amt, last);
    unless regulations_alter_timing_of_transfers(l) and subsection_a_applies(l, cy) and forgone_interest_for_year(l, cy, amt) and calendar_year_last_day(cy, last);
}

// --- §7872(d): special rules for gift loans ------------------------------------------------------------------------------

relation borrower_net_investment_income(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the borrower's net investment income for the year (section 163(d)(4), owner: deductions)";
}
relation section_1272_deferred_payment_amounts(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "amounts that would be included in the borrower's gross income for the year by reason of section 1272 if it applied to all deferred payment obligations (market discount bonds, short-term obligations, savings bonds, annuities and similar): treated as interest received";
}
relation aggregate_never_over_100000_in_year(l: BelowMarketLoan, cy: Integer) kind empirical {
    label en unofficial "the aggregate outstanding amount of loans between the borrower and lender does not exceed $100,000 on any day of the year";
}
relation borrower_total_uncapped_retransfer(l: BelowMarketLoan, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the sum, over all the borrower's gift loans, of the amounts that would be treated as retransferred without the paragraph (1) limitation";
}
relation net_investment_income_effective(l: BelowMarketLoan, cy: Integer, amt: Money) kind derived {
    label en unofficial "net investment income including the section 1272 amounts, treated as zero if it does not exceed $1,000 (§7872(d)(1)(E))";
}
relation retransfer_limit_applies(l: BelowMarketLoan, cy: Integer) kind derived {
    label en unofficial "the (d)(1) limitation applies: a gift loan directly between individuals, aggregate not over $100,000, and no principal purpose of tax avoidance";
}
pub relation retransfer_for_subtitle_a(l: BelowMarketLoan, cy: Integer, amt: Money) kind institutional {
    label en unofficial "the amount treated as retransferred by the borrower to the lender as of the close of the year for subtitle A: limited to the (allocated) net investment income where (d)(1) applies";
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "If the net investment income of any borrower for any year does not exceed $1,000, the net investment income of such borrower for such year shall be treated as zero.")
rule S7872NiiDeMinimisZero strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for nii: Money;
    for s1272: Money;
    when borrower_net_investment_income(l, cy, nii)
        and section_1272_deferred_payment_amounts(l, cy, s1272)
        and nii + s1272 <= 1000.00 USD;
    then net_investment_income_effective(l, cy, 0.00 USD);
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "any amount which would be included in the gross income of such person for such year by reason of section 1272 if such section applied to all deferred payment obligations shall be treated as interest received by such person for such year")
rule S7872NiiIncludes1272 strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for nii: Money;
    for s1272: Money;
    when borrower_net_investment_income(l, cy, nii)
        and section_1272_deferred_payment_amounts(l, cy, s1272)
        and nii + s1272 > 1000.00 USD;
    then net_investment_income_effective(l, cy, nii + s1272);
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "the amount treated as retransferred by the borrower to the lender as of the close of any year shall not exceed the borrower's net investment income for such year")
rule S7872RetransferLimitApplies strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    when gift_loan(l)
        and gift_loan_directly_between_individuals(l)
        and aggregate_never_over_100000_in_year(l, cy)
        and not_known(interest_arrangements_principal_purpose_tax_avoidance(l));
    then retransfer_limit_applies(l, cy);
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "in any case in which a borrower has outstanding more than 1 gift loan, the net investment income of such borrower shall be allocated among such loans in proportion to the respective amounts which would be treated as retransferred by the borrower without regard to this paragraph")
rule S7872RetransferLimited strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for uncapped: Money;
    for total: Money;
    for nii: Money;
    when retransfer_limit_applies(l, cy)
        and forgone_interest_for_year(l, cy, uncapped)
        and borrower_total_uncapped_retransfer(l, cy, total)
        and net_investment_income_effective(l, cy, nii)
        and total > 0.00 USD;
    then retransfer_for_subtitle_a(l, cy, min(uncapped, div_round(nii * (uncapped / 1.00 USD), total / 1.00 USD, 2, "HALF_UP")));
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "Subparagraph (A) shall not apply to any loan the interest arrangements of which have as 1 of their principal purposes the avoidance of any Federal tax.")
rule S7872RetransferUnlimited strict {
    for l: BelowMarketLoan;
    for cy: Integer;
    for uncapped: Money;
    when subsection_a_applies(l, cy)
        and forgone_interest_for_year(l, cy, uncapped)
        and not_known(retransfer_limit_applies(l, cy));
    then retransfer_for_subtitle_a(l, cy, uncapped);
}
pub relation chapter_12_uses_subsection_b(l: BelowMarketLoan) kind institutional {
    label en unofficial "for chapter 12 (gift tax) a gift loan that is a term loan is governed by subsection (b)(1), not (a) (§7872(d)(2))";
}
@source(IRC_S7872_D, relation = formalizes, coverage = exact, quote = "In the case of any gift loan which is a term loan, subsection (b)(1) (and not subsection (a)) shall apply for purposes of chapter 12.")
rule S7872GiftTermLoanChapter12 strict {
    for l: BelowMarketLoan;
    when gift_loan(l)
        and term_loan(l);
    then chapter_12_uses_subsection_b(l);
}

// --- §7872(b): other below-market loans ------------------------------------------------------------------------------------------

relation first_day_section_applies(l: BelowMarketLoan, d: Date) kind empirical {
    label en unofficial "the first day on which the section applies to the loan";
}
pub relation subsection_b_applies(l: BelowMarketLoan) kind institutional {
    label en unofficial "subsection (b) governs the loan: a below-market term loan to which the section applies and to which (a)(1) does not apply";
}
pub relation deemed_cash_transfer_amount(l: BelowMarketLoan, amt: Money) kind institutional {
    label en unofficial "the cash treated as transferred by the lender and received by the borrower: the amount loaned over the present value of all payments required under the loan";
}
pub relation deemed_cash_transfer_date(l: BelowMarketLoan, d: Date) kind institutional {
    label en unofficial "the date of the deemed transfer: the date the loan was made or, if later, the first day the section applies";
}
pub relation section_7872_original_issue_discount(l: BelowMarketLoan, amt: Money) kind institutional {
    label en unofficial "the original issue discount the loan is treated as having, equal to the excess; in addition to any other original issue discount";
}
@source(IRC_S7872_B, relation = formalizes, coverage = exact, quote = "in the case of any below-market loan to which this section applies and to which subsection (a)(1) does not apply")
rule S7872SubsectionBApplies strict {
    for l: BelowMarketLoan;
    for d: Date;
    when below_market_term_loan(l)
        and section_7872_applies_on_day(l, d)
        and not_known(gift_loan(l))
        and not_known(demand_loan(l));
    then subsection_b_applies(l);
}
@source(IRC_S7872_B, relation = formalizes, coverage = exact, quote = "cash in an amount equal to the excess of—")
rule S7872DeemedCash strict {
    for l: BelowMarketLoan;
    for amt: Money;
    for pv: Money;
    when subsection_b_applies(l)
        and amount_loaned(l, amt)
        and present_value_of_payments_at_afr(l, pv);
    then deemed_cash_transfer_amount(l, amt - pv);
}
@source(IRC_S7872_B, relation = formalizes, coverage = exact, quote = "the lender shall be treated as having transferred on the date the loan was made (or, if later, on the first day on which this section applies to such loan)")
rule S7872DeemedCashDateLoan strict {
    for l: BelowMarketLoan;
    for made: Date;
    for first: Date;
    when subsection_b_applies(l)
        and loan_date(l, made)
        and first_day_section_applies(l, first)
        and made >= first;
    then deemed_cash_transfer_date(l, made);
}
@source(IRC_S7872_B, relation = formalizes, coverage = exact, quote = "(or, if later, on the first day on which this section applies to such loan)")
rule S7872DeemedCashDateFirstDay strict {
    for l: BelowMarketLoan;
    for made: Date;
    for first: Date;
    when subsection_b_applies(l)
        and loan_date(l, made)
        and first_day_section_applies(l, first)
        and first > made;
    then deemed_cash_transfer_date(l, first);
}
@source(IRC_S7872_B, relation = formalizes, coverage = exact, quote = "Any below-market loan to which paragraph (1) applies shall be treated as having original issue discount in an amount equal to the excess described in paragraph (1).")
rule S7872OriginalIssueDiscount strict {
    for l: BelowMarketLoan;
    for amt: Money;
    when deemed_cash_transfer_amount(l, amt);
    then section_7872_original_issue_discount(l, amt);
}

// --- §7872(f)(7), (9): spouses; withholding ------------------------------------------------------------------------------------------------------

relation spouses(a: Person, b: Person) kind empirical {
    label en unofficial "the two persons are husband and wife";
}
pub relation treated_as_one_person_for_7872(a: Person, b: Person) kind institutional {
    label en unofficial "a husband and wife are treated as one person (used by the aggregate outstanding amounts)";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "A husband and wife shall be treated as 1 person.")
rule S7872SpousesOnePerson strict {
    for a: Person;
    for b: Person;
    when spouses(a, b);
    then treated_as_one_person_for_7872(a, b);
}
relation withholding_on_deemed_amount(agent: Person, l: BelowMarketLoan) kind empirical {
    label en unofficial "an amount is withheld under chapter 24 with respect to an amount treated as transferred or retransferred under (a), or treated as received under (b)";
}
@source(IRC_S7872_F, relation = formalizes, coverage = exact, quote = "No amount shall be withheld under chapter 24 with respect to—")
rule S7872NoWithholdingProhibition strict {
    for agent: Person;
    for l: BelowMarketLoan;
    when withholding_on_deemed_amount(agent, l);
    then prohibition S7872NoChapter24WithholdingOnDeemedAmounts {
        bearer agent;
        action withholding_on_deemed_amount(agent, l);
        window [-infinity, infinity];
    };
}

// --- §7872(g), (h): definitions of continuing care contract and facility ------------------------------------------------------------------------------

relation contract_written(k: Person) kind empirical {
    label en unofficial "the continuing care contract is a written contract between an individual and a qualified continuing care facility";
}
relation contract_life_use(k: Person) kind empirical {
    label en unofficial "the individual or the individual's spouse may use a qualified continuing care facility for their life or lives";
}
relation contract_independent_then_skilled_nursing_g(k: Person) kind empirical {
    label en unofficial "(g)(3)(B): the individual first resides in a separate independent living unit with meals and personal care and does not need long-term nursing care, then is provided long-term and skilled nursing care as health requires";
}
relation contract_no_additional_substantial_payment(k: Person) kind empirical {
    label en unofficial "(g)(3)(C): no additional substantial payment is required if increased personal care or nursing care is needed";
}
relation contract_housing_independent_and_assisted_h(k: Person) kind empirical {
    label en unofficial "(h)(2)(B): the individual is provided housing in an independent living unit and in an assisted living or nursing facility as available in the facility";
}
relation contract_assisted_living_or_nursing_care_h(k: Person) kind empirical {
    label en unofficial "(h)(2)(C): the individual is provided assisted living or nursing care as health requires and as available in the facility";
}
pub relation continuing_care_contract_g(k: Person) kind institutional {
    label en unofficial "a continuing care contract for the (g) exception";
}
pub relation continuing_care_contract_h(k: Person) kind institutional {
    label en unofficial "a continuing care contract for the (h) exception (limited by the Secretary's guidance to contracts providing only the described facilities, care and services)";
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "the term \"continuing care contract\" means a written contract between an individual and a qualified continuing care facility under which—")
rule S7872ContractG strict {
    for k: Person;
    when contract_written(k)
        and contract_life_use(k)
        and contract_independent_then_skilled_nursing_g(k)
        and contract_no_additional_substantial_payment(k);
    then continuing_care_contract_g(k);
}
@source(IRC_S7872_H, relation = formalizes, coverage = exact, quote = "the term \"continuing care contract\" means a written contract between an individual and a qualified continuing care facility under which—")
rule S7872ContractH strict {
    for k: Person;
    when contract_written(k)
        and contract_life_use(k)
        and contract_housing_independent_and_assisted_h(k)
        and contract_assisted_living_or_nursing_care_h(k);
    then continuing_care_contract_h(k);
}
relation facility_designed_for_continuing_care_contracts(f: Person) kind empirical {
    label en unofficial "the facilities are designed to provide services under continuing care contracts";
}
relation substantially_all_residents_covered_by_contracts(f: Person) kind empirical {
    label en unofficial "substantially all of the residents are covered by continuing care contracts";
}
relation substantially_all_facilities_owned_or_operated_by_borrower(f: Person) kind empirical {
    label en unofficial "substantially all facilities used to provide the required services are owned or operated by the borrower";
}
relation facility_is_traditional_nursing_home(f: Person) kind empirical {
    label en unofficial "the facility is of a type traditionally considered a nursing home";
}
relation facility_has_independent_living_unit_plus_assisted_or_nursing(f: Person) kind empirical {
    label en unofficial "the facilities include an independent living unit, plus an assisted living or nursing facility, or both";
}
relation substantially_all_independent_unit_residents_covered(f: Person) kind empirical {
    label en unofficial "substantially all of the independent living unit residents are covered by continuing care contracts";
}
pub relation qualified_continuing_care_facility_g(f: Person) kind institutional {
    label en unofficial "a qualified continuing care facility for the (g) exception";
}
pub relation qualified_continuing_care_facility_h(f: Person) kind institutional {
    label en unofficial "a qualified continuing care facility for the (h) exception";
}
@source(IRC_S7872_G, relation = formalizes, coverage = exact, quote = "the term \"qualified continuing care facility\" means 1 or more facilities—")
rule S7872FacilityG defeasible {
    for f: Person;
    when facility_designed_for_continuing_care_contracts(f)
        and substantially_all_residents_covered_by_contracts(f)
        and substantially_all_facilities_owned_or_operated_by_borrower(f);
    then qualified_continuing_care_facility_g(f);
    unless facility_is_traditional_nursing_home(f) and facility_designed_for_continuing_care_contracts(f) and substantially_all_residents_covered_by_contracts(f) and substantially_all_facilities_owned_or_operated_by_borrower(f);
}
@source(IRC_S7872_H, relation = formalizes, coverage = exact, quote = "the term \"qualified continuing care facility\" means 1 or more facilities—")
rule S7872FacilityH defeasible {
    for f: Person;
    when facility_designed_for_continuing_care_contracts(f)
        and facility_has_independent_living_unit_plus_assisted_or_nursing(f)
        and substantially_all_independent_unit_residents_covered(f);
    then qualified_continuing_care_facility_h(f);
    unless facility_is_traditional_nursing_home(f) and facility_designed_for_continuing_care_contracts(f) and facility_has_independent_living_unit_plus_assisted_or_nursing(f) and substantially_all_independent_unit_residents_covered(f);
}

// --- §7872(i): regulations --------------------------------------------------------------------------------------------------------------------------

relation secretary_prescribes_7872_regulations(o: Organ) kind empirical {
    label en unofficial "the Secretary has prescribed the regulations necessary or appropriate to carry out the purposes of §7872, including adjustments, consistency of positions and exemption of classes of transactions with no significant effect on tax";
}
relation secretary_issues_continuing_care_contract_guidance(o: Organ) kind empirical {
    label en unofficial "the Secretary has issued guidance limiting the (h) continuing care contract to contracts providing only the described facilities, care and services";
}
@source(IRC_S7872_I, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations as may be necessary or appropriate to carry out the purposes of this section")
rule S7872RegulationsDuty strict {
    when true;
    then duty S7872PrescribeRegulations {
        bearer Secretary;
        goal maintenance {
            condition secretary_prescribes_7872_regulations(Secretary);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7872_H, relation = formalizes, coverage = exact, quote = "The Secretary shall issue guidance which limits such term to contracts which provide only facilities, care, and services described in this paragraph.")
rule S7872GuidanceDuty strict {
    when true;
    then duty S7872IssueContinuingCareContractGuidance {
        bearer Secretary;
        goal maintenance {
            condition secretary_issues_continuing_care_contract_guidance(Secretary);
            window [-infinity, infinity];
        }
    };
}
