// 26 U.S.C. §7871 (Indian tribal governments treated as States for certain
// purposes) and §7873 (income derived by Indians from exercise of fishing
// rights). STAGE 3.
//
// JUDGMENT CALLS
//  - §7871(a): "treated as a State for purposes of ..." is published as an
//    institutional fact `tribal_government_treated_as_state(g, purpose)`; the
//    listed sections (170, 2055, 2106, 2522, 164, 103, 511, 105, 403, 454,
//    chapters 31/32/33/36/41/42) read it in their owners' packages (pending
//    dependencies in administration.deps.json).
//  - "Substantially all of the proceeds" and "essential governmental function"
//    have no numeric threshold in the text: they are case facts of the issue
//    (DECISION-0194 not applied: no adjudicating authority is named).
//  - "Substantially all" of the harvesting by members and of the entity's
//    management functions (§7873) are likewise case facts.
//  - §7871(c)(3)(D): the calendar-year employment test compares outstanding
//    bonds to 20 times prior-year wages; both amounts are case facts (wages
//    within §3121(a) belong to employment).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7871_A,
    IRC_S7871_B,
    IRC_S7871_C,
    IRC_S7871_D,
    IRC_S7871_E,
    IRC_S7871_F,
    IRC_S7873_A,
    IRC_S7873_B,
    IRC_S7873_C,
    Organ,
    Person,
    Secretary,
    TaxableYear,
};

// --- §7871(a), (b), (e): treated as a State ---------------------------------------------------------

enum TribalStatePurpose {
    Section170CharitableDeduction;
    Section2055And2106a2EstateDeduction;
    Section2522GiftDeduction;
    ExciseTaxChapter31SpecialFuels;
    ExciseTaxChapter32ManufacturersTaxes;
    ExciseTaxSubchapterBChapter33Communications;
    ExciseTaxSubchapterDChapter36HighwayVehicles;
    Section164TaxDeduction;
    Section103StateAndLocalBonds;
    Section511a2BInstrumentalityColleges;
    Section105eAccidentAndHealthPlans;
    Section403b1AiiEmployerContributions;
    Section454b2DiscountObligations;
    Chapter41LegislationExpenditures;
    SubchapterAChapter42PrivateFoundations;
}
relation is_indian_tribal_government(g: Person) kind empirical {
    label en unofficial "the person is an Indian tribal government";
}
enum TribalPurposeClass {
    UnconditionalPurpose;
    ExciseTaxPurpose;
    BondPurpose;
}
relation purpose_class(p: TribalStatePurpose, c: TribalPurposeClass) kind institutional {
    label en unofficial "the classification of each §7871(a) purpose: unconditional, excise tax (subject to (b)), or section 103 bonds (subject to (c))";
}
assert purpose_class(Section170CharitableDeduction, UnconditionalPurpose);
assert purpose_class(Section2055And2106a2EstateDeduction, UnconditionalPurpose);
assert purpose_class(Section2522GiftDeduction, UnconditionalPurpose);
assert purpose_class(ExciseTaxChapter31SpecialFuels, ExciseTaxPurpose);
assert purpose_class(ExciseTaxChapter32ManufacturersTaxes, ExciseTaxPurpose);
assert purpose_class(ExciseTaxSubchapterBChapter33Communications, ExciseTaxPurpose);
assert purpose_class(ExciseTaxSubchapterDChapter36HighwayVehicles, ExciseTaxPurpose);
assert purpose_class(Section164TaxDeduction, UnconditionalPurpose);
assert purpose_class(Section103StateAndLocalBonds, BondPurpose);
assert purpose_class(Section511a2BInstrumentalityColleges, UnconditionalPurpose);
assert purpose_class(Section105eAccidentAndHealthPlans, UnconditionalPurpose);
assert purpose_class(Section403b1AiiEmployerContributions, UnconditionalPurpose);
assert purpose_class(Section454b2DiscountObligations, UnconditionalPurpose);
assert purpose_class(Chapter41LegislationExpenditures, UnconditionalPurpose);
assert purpose_class(SubchapterAChapter42PrivateFoundations, UnconditionalPurpose);
relation purpose_at_issue(g: Person, p: TribalStatePurpose) kind empirical {
    label en unofficial "the case asks whether the Indian tribal government is treated as a State for this purpose";
}
relation transaction_involves_essential_governmental_function(g: Person) kind empirical {
    label en unofficial "the transaction involves the exercise of an essential governmental function of the Indian tribal government (§7871(b))";
}
relation function_customarily_performed_by_state_and_local_governments(g: Person) kind empirical {
    label en unofficial "the function is customarily performed by State and local governments with general taxing powers";
}
relation function_is_essential_governmental(g: Person) kind derived {
    label en unofficial "the function counts as an essential governmental function: not excluded by §7871(e)";
}
pub relation tribal_government_treated_as_state(g: Person, p: TribalStatePurpose) kind institutional {
    label en unofficial "the Indian tribal government is treated as a State for the purpose (§7871(a)); for excise purposes only for a transaction involving an essential governmental function (b); for section 103 subject to the subsection (c) bond conditions";
}
@source(IRC_S7871_E, relation = formalizes, coverage = exact, quote = "the term \"essential governmental function\" shall not include any function which is not customarily performed by State and local governments with general taxing powers")
rule S7871EssentialGovernmentalFunction strict {
    for g: Person;
    when function_customarily_performed_by_state_and_local_governments(g);
    then function_is_essential_governmental(g);
}
@source(IRC_S7871_A, relation = formalizes, coverage = exact, quote = "An Indian tribal government shall be treated as a State—")
rule S7871TreatedAsStateUnconditional strict {
    for g: Person;
    for p: TribalStatePurpose;
    when is_indian_tribal_government(g)
        and purpose_at_issue(g, p)
        and purpose_class(p, UnconditionalPurpose);
    then tribal_government_treated_as_state(g, p);
}
@source(IRC_S7871_B, relation = formalizes, coverage = exact, quote = "Paragraph (2) of subsection (a) shall apply with respect to any transaction only if, in addition to any other requirement of this title applicable to similar transactions involving a State or political subdivision thereof, the transaction involves the exercise of an essential governmental function of the Indian tribal government.")
rule S7871TreatedAsStateExcise strict {
    for g: Person;
    for p: TribalStatePurpose;
    when is_indian_tribal_government(g)
        and purpose_at_issue(g, p)
        and purpose_class(p, ExciseTaxPurpose)
        and transaction_involves_essential_governmental_function(g)
        and function_is_essential_governmental(g);
    then tribal_government_treated_as_state(g, p);
}

// --- §7871(c): tax-exempt bonds --------------------------------------------------------------------

entity TribalObligation {
    label en unofficial "an obligation issued by an Indian tribal government (or a subdivision thereof)";
}
relation obligation_of_government(o: TribalObligation, g: Person) kind empirical {
    label en unofficial "the issuer of the obligation";
}
relation substantially_all_proceeds_for_essential_function(o: TribalObligation) kind empirical {
    label en unofficial "the obligation is part of an issue substantially all of the proceeds of which are to be used in the exercise of an essential governmental function";
}
relation obligation_is_private_activity_bond(o: TribalObligation) kind empirical {
    label en unofficial "the obligation is a private activity bond (section 141(a))";
}
relation obligation_meets_small_manufacturing_exception(o: TribalObligation) kind derived {
    label en unofficial "the obligation meets all six conditions (i)-(vi) of paragraph (3)(B)";
}
relation net_proceeds_95_percent_for_depreciable_manufacturing_property(o: TribalObligation) kind empirical {
    label en unofficial "95 percent or more of the net proceeds are used for acquisition, construction, reconstruction or improvement of depreciable property that is part of a manufacturing facility (section 144(a)(12)(C))";
}
relation issued_by_tribal_government_or_subdivision(o: TribalObligation) kind empirical {
    label en unofficial "the issue is issued by an Indian tribal government or a subdivision thereof";
}
relation net_proceeds_95_percent_for_property_on_qualified_indian_lands_owned_by_issuer(o: TribalObligation) kind empirical {
    label en unofficial "95 percent or more of the net proceeds finance property located, throughout the 5-year period ending on issuance, on the qualified Indian lands of the issuer and owned and operated by the issuer";
}
relation not_private_activity_bond_but_for_subparagraph_c(o: TribalObligation) kind empirical {
    label en unofficial "the obligation would not be a private activity bond without regard to subparagraph (C)";
}
relation employment_requirement_reasonably_expected_at_issuance(o: TribalObligation) kind empirical {
    label en unofficial "it is reasonably expected at issuance that the employment requirement of (D)(i) will be met for the financed facility";
}
relation no_principal_user_described_in_144a6b(o: TribalObligation) kind empirical {
    label en unofficial "no principal user of the facility will be a person (or group) described in section 144(a)(6)(B)";
}
pub relation section_103_applies_to_tribal_obligation(o: TribalObligation) kind institutional {
    label en unofficial "section 103(a) applies to the obligation issued by an Indian tribal government (or subdivision): essential-function proceeds (paragraph (1)) or the paragraph (3) exception for certain private activity bonds";
}
pub relation obligation_treated_as_qualified_small_issue_bond(o: TribalObligation) kind institutional {
    label en unofficial "the obligation is treated as a qualified small issue bond, section 146 does not apply, and (C) the private activity bond rules otherwise apply";
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "Subsection (a) of section 103 shall apply to any obligation (not described in paragraph (2)) issued by an Indian tribal government (or subdivision thereof) only if such obligation is part of an issue substantially all of the proceeds of which are to be used in the exercise of any essential governmental function.")
rule S7871Section103EssentialFunction strict {
    for o: TribalObligation;
    when substantially_all_proceeds_for_essential_function(o)
        and not_known(obligation_is_private_activity_bond(o));
    then section_103_applies_to_tribal_obligation(o);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "(i) 95 percent or more of the net proceeds of the issue are to be used for the acquisition, construction, reconstruction, or improvement of property which is of a character subject to the allowance for depreciation and which is part of a manufacturing facility")
rule S7871ExceptionConditions strict {
    for o: TribalObligation;
    when net_proceeds_95_percent_for_depreciable_manufacturing_property(o)
        and issued_by_tribal_government_or_subdivision(o)
        and net_proceeds_95_percent_for_property_on_qualified_indian_lands_owned_by_issuer(o)
        and not_private_activity_bond_but_for_subparagraph_c(o)
        and employment_requirement_reasonably_expected_at_issuance(o)
        and no_principal_user_described_in_144a6b(o);
    then obligation_meets_small_manufacturing_exception(o);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (3), subsection (a) of section 103 shall not apply to any private activity bond (as defined in section 141(a)) issued by an Indian tribal government (or subdivision thereof).")
rule S7871Section103PrivateActivityException strict {
    for o: TribalObligation;
    when obligation_is_private_activity_bond(o)
        and obligation_meets_small_manufacturing_exception(o);
    then section_103_applies_to_tribal_obligation(o);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "such obligation shall be treated for purposes of this title as a qualified small issue bond")
rule S7871QualifiedSmallIssueTreatment strict {
    for o: TribalObligation;
    when obligation_meets_small_manufacturing_exception(o);
    then obligation_treated_as_qualified_small_issue_bond(o);
}
// (D) employment requirement
relation calendar_year_start(cy: Integer, d: Date) kind empirical {
    label en unofficial "the first day of the calendar year (case-supplied: no calendar-year date term, TECH-GAPS G3005)";
}
relation issue_date_of(o: TribalObligation, d: Date) kind empirical {
    label en unofficial "the date of issuance of the issue (of the original issue for a refunding obligation)";
}
relation establishment_of(o: TribalObligation, e: Person) kind empirical {
    label en unofficial "the establishment which includes the facility financed by the net proceeds of the issue";
}
relation outstanding_face_amount_at_year_end(e: Person, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the aggregate face amount of all outstanding tax-exempt private activity bonds issued to finance the establishment at the close of the calendar year";
}
relation outstanding_face_amount_at_day_90(e: Person, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the aggregate face amount outstanding at the close of the 90th day after the close of the calendar year";
}
relation member_wages_prior_year(e: Person, cy: Integer, amt: Money) kind empirical {
    label en unofficial "the aggregate wages (section 3121(a)) paid during the preceding calendar year to enrolled members of the issuer's tribe (or their spouses) for services at the establishment";
}
relation in_testing_period(o: TribalObligation, cy: Integer) kind derived {
    label en unofficial "the calendar year begins more than 2 years after the date of issuance: it is in the testing period";
}
relation employment_requirement_met(e: Person, cy: Integer) kind derived {
    label en unofficial "as of the close of the calendar year, outstanding bonds are not more than 20 times the prior-year wages of tribal members";
}
relation employment_requirement_met_with_day_90_substitution(e: Person, cy: Integer) kind derived {
    label en unofficial "the requirement would be met if the amount outstanding at the close of the 90th day after the year were used";
}
pub relation section_103_ceases_for_establishment(e: Person, cy: Integer) kind institutional {
    label en unofficial "section 103 ceases to apply to interest received or accrued after the close of the calendar year on all private activity bonds financing the establishment (§7871(c)(3)(D)(ii)(I))";
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "each calendar year which begins more than 2 years after the date of issuance of the issue")
rule S7871TestingPeriod strict {
    for o: TribalObligation;
    for cy: Integer;
    for start: Date;
    for issued: Date;
    when calendar_year_start(cy, start)
        and issue_date_of(o, issued)
        and start > add_calendar_period(issued, 2 calendar_year);
    then in_testing_period(o, cy);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "is not more than 20 times greater than the aggregate wages (as defined by section 3121(a)) paid during the preceding calendar year")
rule S7871EmploymentRequirementMet strict {
    for e: Person;
    for cy: Integer;
    for bonds: Money;
    for wages: Money;
    when outstanding_face_amount_at_year_end(e, cy, bonds)
        and member_wages_prior_year(e, cy, wages)
        and bonds <= wages * 20;
    then employment_requirement_met(e, cy);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "Subclause (I) shall not apply if the requirements of this subparagraph would be met if the aggregate face amount of all tax-exempt private activity bonds issued to provide financing for the establishment and outstanding at the close of the 90th day after the close of the calendar year were substituted")
rule S7871Day90Substitution strict {
    for e: Person;
    for cy: Integer;
    for bonds: Money;
    for wages: Money;
    when outstanding_face_amount_at_day_90(e, cy, bonds)
        and member_wages_prior_year(e, cy, wages)
        and bonds <= wages * 20;
    then employment_requirement_met_with_day_90_substitution(e, cy);
}
relation employment_requirement_not_met(e: Person, cy: Integer) kind derived {
    label en unofficial "as of the close of the calendar year, outstanding bonds exceed 20 times the prior-year wages of tribal members";
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "If, as of the close of any calendar year in the testing period, the requirements of this subparagraph are not met with respect to an establishment")
rule S7871EmploymentNotMet strict {
    for e: Person;
    for cy: Integer;
    for bonds: Money;
    for wages: Money;
    when outstanding_face_amount_at_year_end(e, cy, bonds)
        and member_wages_prior_year(e, cy, wages)
        and bonds > wages * 20;
    then employment_requirement_not_met(e, cy);
}
@source(IRC_S7871_C, relation = formalizes, coverage = exact, quote = "section 103 shall cease to apply to interest received or accrued (on all private activity bonds issued to provide financing for the establishment) after the close of such calendar year")
rule S7871EmploymentFailure defeasible {
    for o: TribalObligation;
    for e: Person;
    for cy: Integer;
    when establishment_of(o, e)
        and in_testing_period(o, cy)
        and employment_requirement_not_met(e, cy);
    then section_103_ceases_for_establishment(e, cy);
    unless employment_requirement_met_with_day_90_substitution(e, cy) and establishment_of(o, e) and in_testing_period(o, cy) and employment_requirement_not_met(e, cy);
}

@source(IRC_S7871_A, relation = formalizes, coverage = exact, quote = "subject to subsection (c), for purposes of section 103 (relating to State and local bonds);")
rule S7871TreatedAsStateBonds strict {
    for g: Person;
    for p: TribalStatePurpose;
    for o: TribalObligation;
    when is_indian_tribal_government(g)
        and purpose_at_issue(g, p)
        and purpose_class(p, BondPurpose)
        and obligation_of_government(o, g)
        and section_103_applies_to_tribal_obligation(o);
    then tribal_government_treated_as_state(g, p);
}

// --- §7871(d): subdivisions -------------------------------------------------------------------------------

entity TribalSubdivision {
    label en unofficial "a subdivision of an Indian tribal government";
}
relation subdivision_delegated_substantial_governmental_functions(s: TribalSubdivision) kind empirical {
    label en unofficial "the subdivision has been delegated the right to exercise one or more of the substantial governmental functions of the Indian tribal government";
}
relation secretary_consulted_secretary_of_interior(s: TribalSubdivision) kind empirical {
    label en unofficial "the Secretary consulted the Secretary of the Interior";
}
relation secretary_determines_subdivision_is_political_subdivision(s: TribalSubdivision) kind empirical {
    label en unofficial "the Secretary determines that the subdivision is treated as a political subdivision of a State";
}
relation political_subdivision_determination_conditions_met(s: TribalSubdivision) kind derived {
    label en unofficial "the subdivision has been delegated substantial governmental functions and the Secretary consulted the Secretary of the Interior";
}
pub relation tribal_subdivision_treated_as_political_subdivision(s: TribalSubdivision) kind institutional {
    label en unofficial "the subdivision is treated as a political subdivision of a State for the purposes specified in subsection (a), if and only if the Secretary so determines";
}
@source(IRC_S7871_D, relation = formalizes, coverage = exact, quote = "after consultation with the Secretary of the Interior) that such subdivision has been delegated the right to exercise one or more of the substantial governmental functions of the Indian tribal government")
rule S7871SubdivisionConditions strict {
    for s: TribalSubdivision;
    when subdivision_delegated_substantial_governmental_functions(s)
        and secretary_consulted_secretary_of_interior(s);
    then political_subdivision_determination_conditions_met(s);
}
@source(IRC_S7871_D, relation = formalizes, coverage = exact, quote = "a subdivision of an Indian tribal government shall be treated as a political subdivision of a State if (and only if) the Secretary determines")
rule S7871SubdivisionDeterminationPower strict {
    for s: TribalSubdivision;
    when secretary_determines_subdivision_is_political_subdivision(s);
    then power S7871DetermineSubdivisionStatus {
        holder Secretary;
        over s;
        exercise secretary_determines_subdivision_is_political_subdivision(s);
        valid_when political_subdivision_determination_conditions_met(s);
        effect create(tribal_subdivision_treated_as_political_subdivision(s));
    };
}

// --- §7871(f): tribal economic development bonds ----------------------------------------------------------------

relation allocation_of_national_limitation(g: Person, amt: Money) kind empirical {
    label en unofficial "the amount of the national tribal economic development bond limitation the Secretary allocates to the Indian tribal government";
}
relation aggregate_allocations_total(amt: Money) kind derived {
    label en unofficial "the sum of the allocations across tribal governments";
}
relation allocation_year_active(y: TaxableYear) kind empirical {
    label en unofficial "allocations are being made for the period";
}
relation allocations_exceed_national_limit(y: TaxableYear) kind derived {
    label en unofficial "the aggregate allocations exceed $2,000,000,000";
}
relation allocation_record(g: Person, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the Secretary allocates the amount of the national limitation to the tribal government for the period";
}
relation allocations_total_for(y: TaxableYear, amt: Money) kind derived {
    label en unofficial "the aggregate of the allocations for the period";
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "There is a national tribal economic development bond limitation of $2,000,000,000.")
rule S7871AllocationsTotal strict {
    for y: TaxableYear;
    when allocation_year_active(y);
    then allocations_total_for(y, sum all amt: Money for g: Person where allocation_record(g, y, amt));
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "There is a national tribal economic development bond limitation of $2,000,000,000.")
rule S7871AllocationsExceedLimit strict {
    for y: TaxableYear;
    for total: Money;
    when allocations_total_for(y, total)
        and total > 2000000000.00 USD;
    then allocations_exceed_national_limit(y);
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "There is a national tribal economic development bond limitation of $2,000,000,000.")
rule S7871AllocationLimitProhibition strict {
    for y: TaxableYear;
    when allocations_exceed_national_limit(y);
    then prohibition S7871NoAllocationsOverNationalLimit {
        bearer Secretary;
        action allocations_exceed_national_limit(y);
        window [-infinity, infinity];
    };
}
relation secretary_allocates_limitation_after_consulting_interior(o: Organ) kind empirical {
    label en unofficial "the Secretary allocates the national tribal economic development bond limitation among the tribal governments in the manner the Secretary, in consultation with the Secretary of the Interior, determines appropriate";
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "The Secretary shall allocate the national tribal economic development bond limitation among the Indian tribal governments in such manner as the Secretary, in consultation with the Secretary of the Interior, determines appropriate.")
rule S7871AllocationDuty strict {
    when true;
    then duty S7871AllocateTribalBondLimitation {
        bearer Secretary;
        goal maintenance {
            condition secretary_allocates_limitation_after_consulting_interior(Secretary);
            window [-infinity, infinity];
        }
    };
}
entity TribalEconomicBond {
    label en unofficial "a bond issued by an Indian tribal government that may be a tribal economic development bond";
}
relation bond_issuer(b: TribalEconomicBond, g: Person) kind empirical {
    label en unofficial "the Indian tribal government that issued the bond";
}
relation bond_interest_would_be_exempt_under_103_if_state(b: TribalEconomicBond) kind empirical {
    label en unofficial "the interest would be exempt from tax under section 103 if the bond were issued by a State or local government";
}
relation bond_designated_by_government(b: TribalEconomicBond) kind empirical {
    label en unofficial "the Indian tribal government designates the bond as a tribal economic development bond";
}
relation proceeds_finance_gaming_building_or_property(b: TribalEconomicBond) kind empirical {
    label en unofficial "any portion of the proceeds of the issue finances any portion of a building in which class II or class III gaming is conducted or housed, or other property actually used in such gaming";
}
relation proceeds_finance_facility_outside_reservation(b: TribalEconomicBond) kind empirical {
    label en unofficial "any portion of the proceeds finances a facility located outside the Indian reservation (section 168(j)(6))";
}
relation bond_face_amount(b: TribalEconomicBond, amt: Money) kind empirical {
    label en unofficial "the face amount of the bond";
}
pub relation tribal_economic_development_bond(b: TribalEconomicBond) kind institutional {
    label en unofficial "the bond is a tribal economic development bond (§7871(f)(3))";
}
pub relation tribal_economic_development_bond_treated_as_state_bond(b: TribalEconomicBond) kind institutional {
    label en unofficial "notwithstanding subsection (c), the bond is treated as if issued by a State; the issuer and its instrumentalities are treated as a State for section 141; section 146 does not apply (§7871(f)(2))";
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "the term \"tribal economic development bond\" means any bond issued by an Indian tribal government—")
rule S7871TribalEconomicDevelopmentBond defeasible {
    for b: TribalEconomicBond;
    for g: Person;
    when bond_issuer(b, g)
        and is_indian_tribal_government(g)
        and bond_interest_would_be_exempt_under_103_if_state(b)
        and bond_designated_by_government(b);
    then tribal_economic_development_bond(b);
    unless proceeds_finance_gaming_building_or_property(b) and bond_issuer(b, g);
    unless proceeds_finance_facility_outside_reservation(b) and bond_issuer(b, g);
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "notwithstanding subsection (c), such bond shall be treated for purposes of this title in the same manner as if such bond were issued by a State")
rule S7871TreatedAsStateBond defeasible {
    for b: TribalEconomicBond;
    when tribal_economic_development_bond(b);
    then tribal_economic_development_bond_treated_as_state_bond(b);
}
relation designated_face_amount_total(g: Person, amt: Money) kind derived {
    label en unofficial "the aggregate face amount of the bonds designated by the government as tribal economic development bonds";
}
relation designations_exceed_allocation(g: Person) kind derived {
    label en unofficial "the aggregate designated face amount exceeds the limitation allocated to the government";
}
relation government_has_allocation(g: Person, y: TaxableYear, amt: Money) kind empirical {
    label en unofficial "the limitation allocated to the tribal government";
}
relation government_designates_bonds(g: Person, y: TaxableYear) kind empirical {
    label en unofficial "the government designates bonds as tribal economic development bonds";
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "The maximum aggregate face amount of bonds which may be designated by any Indian tribal government under subparagraph (A) shall not exceed the amount of national tribal economic development bond limitation allocated to such government under paragraph (1).")
rule S7871DesignatedTotal strict {
    for g: Person;
    for y: TaxableYear;
    when government_designates_bonds(g, y);
    then designated_face_amount_total(g, sum all amt: Money for b: TribalEconomicBond where designated_bond_of(b, g, amt));
}
relation designated_bond_of(b: TribalEconomicBond, g: Person, amt: Money) kind empirical {
    label en unofficial "the bond is designated by the government with this face amount";
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "shall not exceed the amount of national tribal economic development bond limitation allocated to such government under paragraph (1)")
rule S7871DesignationsExceed strict {
    for g: Person;
    for y: TaxableYear;
    for total: Money;
    for alloc: Money;
    when designated_face_amount_total(g, total)
        and government_has_allocation(g, y, alloc)
        and total > alloc;
    then designations_exceed_allocation(g);
}
@source(IRC_S7871_F, relation = formalizes, coverage = exact, quote = "The maximum aggregate face amount of bonds which may be designated by any Indian tribal government")
rule S7871DesignationProhibition strict {
    for g: Person;
    when designations_exceed_allocation(g);
    then prohibition S7871NoDesignationOverAllocation {
        bearer g;
        beneficiary Secretary;
        action designations_exceed_allocation(g);
        window [-infinity, infinity];
    };
}

// --- §7873: income derived by Indians from exercise of fishing rights ---------------------------------------------------

entity FishingRightsActivity {
    label en unofficial "an activity directly related to harvesting, processing, or transporting fish harvested in the exercise of a recognized fishing right of a tribe, or to selling such fish";
}
entity IndianEntity {
    label en unofficial "an entity that may be a qualified Indian entity of an Indian tribe";
}
relation activity_of_tribe(a: FishingRightsActivity, tribe: Person) kind empirical {
    label en unofficial "the activity relates to this Indian tribe";
}
relation activity_directly_related_to_fish_harvested_under_recognized_right(a: FishingRightsActivity) kind empirical {
    label en unofficial "the activity is directly related to harvesting, processing, transporting or selling fish harvested in the exercise of a recognized fishing right of the tribe";
}
relation substantially_all_harvesting_by_tribe_members(a: FishingRightsActivity) kind empirical {
    label en unofficial "substantially all of the harvesting was performed by members of the tribe";
}
pub relation fishing_rights_related_activity(a: FishingRightsActivity) kind institutional {
    label en unofficial "the activity is a fishing rights-related activity of the tribe (§7873(b)(1))";
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "any activity directly related to harvesting, processing, or transporting fish harvested in the exercise of a recognized fishing right of such tribe or to selling such fish but only if substantially all of such harvesting was performed by members of such tribe")
rule S7873FishingRightsActivity strict {
    for a: FishingRightsActivity;
    when activity_directly_related_to_fish_harvested_under_recognized_right(a)
        and substantially_all_harvesting_by_tribe_members(a);
    then fishing_rights_related_activity(a);
}
relation right_secured_by_treaty_executive_order_or_act(tribe: Person, on: Date) kind empirical {
    label en unofficial "the fishing right of the tribe is secured by a treaty with the United States, an Executive order, or an Act of Congress as of this date";
}
pub relation recognized_fishing_right(tribe: Person) kind institutional {
    label en unofficial "the tribe's fishing right is a recognized fishing right: secured as of March 17, 1988 by a treaty, Executive order or Act of Congress";
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "fishing rights secured as of March 17, 1988, by a treaty between such tribe and the United States or by an Executive order or an Act of Congress")
rule S7873RecognizedRight strict {
    for tribe: Person;
    when right_secured_by_treaty_executive_order_or_act(tribe, @1988-03-17);
    then recognized_fishing_right(tribe);
}
relation entity_engaged_in_fishing_rights_activity_of_tribe(e: IndianEntity, tribe: Person) kind empirical {
    label en unofficial "the entity is engaged in a fishing rights-related activity of the tribe (which makes the tribe a qualified Indian tribe with respect to the entity)";
}
relation equity_owned_by_qualified_tribes_members_or_spouses(e: IndianEntity) kind empirical {
    label en unofficial "all of the equity interests in the entity are owned by qualified Indian tribes, members of such tribes, or their spouses";
}
relation entity_engages_in_substantial_processing_or_transporting(e: IndianEntity) kind empirical {
    label en unofficial "the entity engages to any extent in any substantial processing or transporting of fish";
}
relation gross_receipts_share_from_fishing_rights_activities(e: IndianEntity, share: Decimal) kind empirical {
    label en unofficial "the share of annual gross receipts derived from fishing rights-related activities of one or more qualified Indian tribes each of which owns at least 10 percent of the equity (equity of members or spouses counts as the tribe's)";
}
relation regulations_relax_gross_receipts_test(e: IndianEntity) kind empirical {
    label en unofficial "regulations provide otherwise for the 90 percent gross receipts test";
}
relation management_substantially_by_tribe_members(e: IndianEntity) kind empirical {
    label en unofficial "substantially all of the management functions are performed by members of qualified Indian tribes";
}
relation gross_receipts_condition_met(e: IndianEntity) kind derived {
    label en unofficial "the (iii) gross-receipts condition is met, not applicable to an entity without substantial processing or transporting, or relaxed by regulations";
}
pub relation qualified_indian_entity(e: IndianEntity, tribe: Person) kind institutional {
    label en unofficial "the entity is a qualified Indian entity with respect to the tribe (§7873(b)(3))";
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "90 percent or more of the annual gross receipts of the entity is derived from fishing rights-related activities of one or more qualified Indian tribes each of which owns at least 10 percent of the equity interests in the entity")
rule S7873GrossReceiptsMet strict {
    for e: IndianEntity;
    for share: Decimal;
    when entity_engages_in_substantial_processing_or_transporting(e)
        and gross_receipts_share_from_fishing_rights_activities(e, share)
        and share >= 0.90;
    then gross_receipts_condition_met(e);
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "except as provided in regulations, in the case of an entity which engages to any extent in any substantial processing or transporting of fish")
rule S7873GrossReceiptsNotApplicable strict {
    for e: IndianEntity;
    when not_known(entity_engages_in_substantial_processing_or_transporting(e))
        and equity_owned_by_qualified_tribes_members_or_spouses(e);
    then gross_receipts_condition_met(e);
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "except as provided in regulations")
rule S7873GrossReceiptsRegulations strict {
    for e: IndianEntity;
    when regulations_relax_gross_receipts_test(e);
    then gross_receipts_condition_met(e);
}
@source(IRC_S7873_B, relation = formalizes, coverage = exact, quote = "The term \"qualified Indian entity\" means, with respect to an Indian tribe, any entity if—")
rule S7873QualifiedIndianEntity strict {
    for e: IndianEntity;
    for tribe: Person;
    when entity_engaged_in_fishing_rights_activity_of_tribe(e, tribe)
        and equity_owned_by_qualified_tribes_members_or_spouses(e)
        and gross_receipts_condition_met(e)
        and management_substantially_by_tribe_members(e);
    then qualified_indian_entity(e, tribe);
}
relation income_derived_from_fishing_rights_activity(inc: Person, a: FishingRightsActivity) kind empirical {
    label en unofficial "the income is derived from the fishing rights-related activity of the tribe";
}
relation income_derived_by_member_or_entity(inc: Person, holder: Person, tribe: Person) kind empirical {
    label en unofficial "the income is derived by a member of the Indian tribe (directly or through a qualified Indian entity) or by a qualified Indian entity";
}
relation holder_is_tribe_member(holder: Person, tribe: Person) kind empirical {
    label en unofficial "the person is a member of the Indian tribe";
}
relation holder_is_qualified_entity_of(holder: Person, tribe: Person) kind empirical {
    label en unofficial "the person is a qualified Indian entity with respect to the tribe (asserted as a fact of the holder; the derived relation qualified_indian_entity establishes it for an IndianEntity)";
}
pub relation income_free_of_subtitle_a_tax(inc: Person, holder: Person) kind institutional {
    label en unofficial "no tax is imposed by subtitle A (income and self-employment taxes) on the income (§7873(a)(1))";
}
@source(IRC_S7873_A, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by subtitle A on income derived—")
rule S7873IncomeImmunity defeasible {
    for inc: Person;
    for holder: Person;
    for tribe: Person;
    for a: FishingRightsActivity;
    when income_derived_by_member_or_entity(inc, holder, tribe)
        and income_derived_from_fishing_rights_activity(inc, a)
        and fishing_rights_related_activity(a)
        and activity_of_tribe(a, tribe)
        and holder_is_tribe_or_entity(holder, tribe);
    then immunity S7873FishingRightsIncomeImmunity {
        holder holder;
        protected_effect income_free_of_subtitle_a_tax(inc, holder);
        window [-infinity, infinity];
    };
}
relation holder_is_tribe_or_entity(holder: Person, tribe: Person) kind derived {
    label en unofficial "the holder is a member of the tribe or a qualified Indian entity of the tribe";
}
@source(IRC_S7873_A, relation = formalizes, coverage = exact, quote = "by a member of an Indian tribe directly or through a qualified Indian entity")
rule S7873HolderMember strict {
    for holder: Person;
    for tribe: Person;
    when holder_is_tribe_member(holder, tribe);
    then holder_is_tribe_or_entity(holder, tribe);
}
@source(IRC_S7873_A, relation = formalizes, coverage = exact, quote = "by a qualified Indian entity")
rule S7873HolderEntity strict {
    for holder: Person;
    for tribe: Person;
    when holder_is_qualified_entity_of(holder, tribe);
    then holder_is_tribe_or_entity(holder, tribe);
}
relation remuneration_for_services_in_fishing_rights_activity(rem: Person, a: FishingRightsActivity) kind empirical {
    label en unofficial "the remuneration is paid for services performed in a fishing rights-related activity of the tribe";
}
relation remuneration_paid_by_member_or_qualified_entity(rem: Person, payer: Person, tribe: Person) kind empirical {
    label en unofficial "the remuneration is paid to a member of the tribe for another member of the tribe or for a qualified Indian entity";
}
relation payee_is_tribe_member(rem: Person, tribe: Person) kind empirical {
    label en unofficial "the person performing the services is a member of the tribe";
}
pub relation remuneration_free_of_subtitle_c_tax(rem: Person) kind institutional {
    label en unofficial "no tax is imposed by subtitle C (employment taxes) on the remuneration (§7873(a)(2))";
}
relation payer_is_member_or_qualified_entity(rem: Person, tribe: Person) kind empirical {
    label en unofficial "the services are for another member of the tribe or for a qualified Indian entity";
}
@source(IRC_S7873_A, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by subtitle C on remuneration paid for services performed in a fishing rights-related activity of an Indian tribe by a member of such tribe for another member of such tribe or for a qualified Indian entity.")
rule S7873RemunerationImmunity defeasible {
    for rem: Person;
    for tribe: Person;
    for a: FishingRightsActivity;
    when remuneration_for_services_in_fishing_rights_activity(rem, a)
        and fishing_rights_related_activity(a)
        and activity_of_tribe(a, tribe)
        and payee_is_tribe_member(rem, tribe)
        and payer_is_member_or_qualified_entity(rem, tribe);
    then immunity S7873FishingRightsRemunerationImmunity {
        holder rem;
        protected_effect remuneration_free_of_subtitle_c_tax(rem);
        window [-infinity, infinity];
    };
}
relation distribution_from_qualified_indian_entity(d: Person, e: IndianEntity, tribe: Person, amt: Money) kind empirical {
    label en unofficial "a distribution with respect to an equity interest in the qualified Indian entity to a member of the tribe";
}
relation distribution_attributable_to_fishing_rights_income(d: Person, amt: Money) kind empirical {
    label en unofficial "the part of the distribution attributable to income derived by the entity from a fishing rights-related activity of the tribe";
}
pub relation distribution_treated_as_derived_from_fishing_rights(d: Person, amt: Money) kind institutional {
    label en unofficial "the distribution is treated as derived by the member from a fishing rights-related activity of the tribe, to the extent attributable to the entity's income from such an activity (§7873(c)(1))";
}
@source(IRC_S7873_C, relation = formalizes, coverage = exact, quote = "shall be treated as derived by such member from a fishing rights-related activity of such tribe to the extent such distribution is attributable to income derived by such entity from a fishing rights-related activity of such tribe")
rule S7873DistributionTreatment strict {
    for d: Person;
    for e: IndianEntity;
    for tribe: Person;
    for amt: Money;
    for part: Money;
    when distribution_from_qualified_indian_entity(d, e, tribe, amt)
        and qualified_indian_entity(e, tribe)
        and distribution_attributable_to_fishing_rights_income(d, part);
    then distribution_treated_as_derived_from_fishing_rights(d, min(amt, part));
}
relation amount_total_and_entitled(x: Person, total: Money, entitled: Money) kind empirical {
    label en unofficial "the total amount derived (or paid for services) and the part entitled to the benefits of subsection (a)";
}
relation de_minimis_unrelated_amount(x: Person, amt: Money) kind empirical {
    label en unofficial "the amount not entitled to the benefits, said to be de minimis";
}
relation unrelated_amount_is_de_minimis(x: Person) kind empirical {
    label en unofficial "all but a de minimis amount is entitled to the benefits of subsection (a)";
}
pub relation entire_amount_entitled_to_benefit(x: Person) kind institutional {
    label en unofficial "the entire amount is entitled to the benefits of the paragraph of subsection (a) (§7873(c)(2))";
}
@source(IRC_S7873_C, relation = formalizes, coverage = exact, quote = "then the entire amount shall be entitled to the benefits of such paragraph")
rule S7873DeMinimisEntire strict {
    for x: Person;
    when unrelated_amount_is_de_minimis(x);
    then entire_amount_entitled_to_benefit(x);
}
