// 26 U.S.C. §7504 — Fractional parts of a dollar; §7505 — Sale of personal
// property acquired by the United States; §7506 — Administration of real
// estate acquired by the United States; §7507 — Exemption of insolvent banks
// from tax. STAGE 2 (DECISION-0379), priority items §7504/§7505/§7506/§7507.
//
// JUDGMENT CALLS (see report):
//  - §7504 is an ENABLING power ("The Secretary MAY by regulations
//    provide..."), not a self-executing rounding rule: the 50-cent
//    disregard/round-up only governs an actual credit-or-refund allowance or
//    deficiency/underpayment collection once the Secretary has exercised the
//    power to prescribe it. Modelled as a `power` whose effect creates
//    `fractional_dollar_disregard_in_force(ctx)`; the arithmetic itself
//    (`round(raw, 0, "HALF_UP")` — exactly the statutory "<50c disregarded,
//    >=50c rounds up to $1" rule) is a separate rule gated on that fact.
//    `round(_, 0, "HALF_UP")` is used because HALF_UP rounding to zero
//    decimal places IS the statutory test bit for bit: a fraction below
//    0.50 rounds down (disregarded) and 0.50 or more rounds up to the next
//    whole dollar (§48/§58 of the type system).
//  - §7505(a)'s sale power and §7506(b)/(c)/(d)'s real-estate powers are
//    modelled uniformly on `Asset` (personal property) and a new local
//    `Realty : Asset` subtype (real estate) rather than importing a
//    property subtype from another package: §7505/§7506 concern the
//    UNITED STATES' own disposition of property it has already acquired
//    through internal-revenue collection, not a taxpayer's property
//    transaction — no other `us.irc.*` package needs this subtype, so it is
//    declared locally rather than requested as a `pub` from a neighbour.
//  - §7506(a) ("shall have charge of") is modelled as an institutional_effect
//    (custody vests by force of law on the acquisition event), not a power:
//    the Secretary does not choose whether to take charge: the statute gives
//    no discretion, only naming the acquisition modes that trigger it.
//  - §7506(d)'s release-to-debtor is modelled as a `power` whose `valid_when`
//    is the single derived atom folding the 2-year-window-with-interest test
//    (LDC-E1305: `valid_when` takes one atom); the 1%-per-month interest
//    computation is the caller's (a consumer never needs `us.irc.
//    administration` for a debt-interest calculation elsewhere in this
//    corpus, so a caller supplies the interest-inclusive amount already
//    paid as a fact instead of this module recomputing simple interest).
//  - §7507 combines an `immunity` (asset-diminishment protection, (a)'s core
//    rule) with a `power` (the Secretary's discretionary remission for
//    State-chartered banks, (a)'s last clause) and a `duty`-shaped
//    institutional fact (mandatory abatement by the Comptroller's insolvency
//    finding for NATIONAL banks — no Secretary discretion there, so modelled
//    as an institutional_effect, not a power). (c)'s reassessment/refund and
//    the 90-day suspension of the limitations period are modelled as
//    institutional facts a downstream package (`assessment`/`collection`)
//    reads; this package does not restate those packages' own limitations
//    machinery. (d)'s carve-out (chapters 21/23 — FICA/RRTA) is a priority
//    exception on the immunity itself.
//  - "Bank or trust company" is not given its own entity type: any `Person`
//    (a `Corporation` in practice) stands for it, consistent with §7701's
//    six-category list already declared in `us.irc.core`.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7504,
    IRC_S7505_A,
    IRC_S7505_B,
    IRC_S7506_A,
    IRC_S7506_B,
    IRC_S7506_C,
    IRC_S7506_D,
    IRC_S7507_A,
    Person,
    Secretary,
};

type Asset = us.irc.core::Asset;

// --- §7504: fractional parts of a dollar --------------------------------------

enum FractionalDollarContext {
    CreditOrRefundAllowance;
    DeficiencyOrUnderpaymentCollection;
}

relation secretary_prescribes_fractional_dollar_regulation(ctx: FractionalDollarContext) kind empirical {
    label en unofficial "the Secretary prescribes, by regulations, that fractional parts of a dollar be disregarded (or rounded up at 50 cents) for the named context";
}
pub relation fractional_dollar_disregard_in_force(ctx: FractionalDollarContext) kind institutional {
    label en unofficial "§7504's fractional-dollar disregard/round-up rule is validly in force for the named context";
}
@source(IRC_S7504, relation = formalizes, coverage = exact, quote = "The Secretary may by regulations provide that in the allowance of any amount as a credit or refund, or in the collection of any amount as a deficiency or underpayment, of any tax imposed by this title, a fractional part of a dollar shall be disregarded, unless it amounts to 50 cents or more, in which case it shall be increased to 1 dollar.")
rule S7504FractionalDollarRegulationPower strict {
    for ctx: FractionalDollarContext;
    when secretary_prescribes_fractional_dollar_regulation(ctx);
    then power S7504FractionalDollarRegulationGrant {
        holder Secretary;
        over ctx;
        exercise secretary_prescribes_fractional_dollar_regulation(ctx);
        valid_when secretary_prescribes_fractional_dollar_regulation(ctx);
        effect create(fractional_dollar_disregard_in_force(ctx));
    };
}

relation raw_amount_at_issue(ctx: FractionalDollarContext, raw: Money) kind empirical {
    label en unofficial "the credit/refund/deficiency/underpayment amount, before §7504 rounding, that is at issue in the case";
}
pub relation fractional_dollar_rounded_amount(ctx: FractionalDollarContext, raw: Money, rounded: Money) kind institutional {
    label en unofficial "the §7504-rounded amount: `raw`'s fractional dollar disregarded unless it is 50 cents or more, in which case increased to the next whole dollar";
}
@source(IRC_S7504, relation = formalizes, coverage = exact, quote = "a fractional part of a dollar shall be disregarded, unless it amounts to 50 cents or more, in which case it shall be increased to 1 dollar")
rule S7504RoundToWholeDollar defeasible {
    for ctx: FractionalDollarContext;
    for raw: Money;
    when fractional_dollar_disregard_in_force(ctx)
        and raw_amount_at_issue(ctx, raw);
    then fractional_dollar_rounded_amount(ctx, raw, round(raw, 0, "HALF_UP"));
}

// --- §7505: sale of personal property acquired by the United States ----------

relation personal_property_acquired_by_us(a: Asset) kind empirical {
    label en unofficial "the personal property was acquired by the United States in payment of, or as security for, a debt arising under the internal revenue laws";
}
relation secretary_sells_personal_property(a: Asset) kind empirical {
    label en unofficial "the Secretary sells the personal property in accordance with prescribed regulations";
}
pub relation personal_property_sold_by_secretary(a: Asset) kind institutional {
    label en unofficial "the Secretary has validly sold the personal property under §7505(a)";
}
@source(IRC_S7505_A, relation = formalizes, coverage = exact, quote = "Any personal property acquired by the United States in payment of or as security for debts arising under the internal revenue laws may be sold by the Secretary in accordance with such regulations as may be prescribed by the Secretary.")
rule S7505SalePower strict {
    for a: Asset;
    when secretary_sells_personal_property(a);
    then power S7505SalePowerGrant {
        holder Secretary;
        over a;
        exercise secretary_sells_personal_property(a);
        valid_when personal_property_acquired_by_us(a);
        effect create(personal_property_sold_by_secretary(a));
    };
}

relation personal_property_resold(a: Asset) kind empirical {
    label en unofficial "the personal property sold under §7505(a) is resold";
}
pub relation resale_proceeds_paid_into_treasury(a: Asset) kind institutional {
    label en unofficial "§7505(b): on resale, the proceeds are paid into the Treasury as internal revenue collections";
}
pub relation distinct_account_of_sale_charges_rendered(a: Asset) kind institutional {
    label en unofficial "§7505(b): a distinct account of all charges incurred in the sale is rendered";
}
@source(IRC_S7505_B, relation = formalizes, coverage = exact, quote = "In case of the resale of such property, the proceeds of the sale shall be paid into the Treasury as internal revenue collections, and there shall be rendered a distinct account of all charges incurred in such sales.")
rule S7505AccountingOnResaleProceeds strict {
    for a: Asset;
    when personal_property_resold(a);
    then resale_proceeds_paid_into_treasury(a);
}
@source(IRC_S7505_B, relation = formalizes, coverage = exact, quote = "there shall be rendered a distinct account of all charges incurred in such sales")
rule S7505AccountingOnResaleCharges strict {
    for a: Asset;
    when personal_property_resold(a);
    then distinct_account_of_sale_charges_rendered(a);
}

// --- §7506: administration of real estate acquired by the United States ------

entity Realty : Asset {
    label en unofficial "real estate that is or has become property of the United States by forfeiture, conveyance, assignment, mortgage, other security, or redemption under the internal revenue laws (§7506(a))";
}

enum RealEstateAcquisitionMode {
    JudgmentOfForfeiture;
    AssignedSetOffOrConveyed;
    VestedByMortgageOrSecurity;
    RedeemedByUnitedStates;
}
relation real_estate_acquired_by_us(r: Realty, mode: RealEstateAcquisitionMode) kind empirical {
    label en unofficial "the real estate became United States property by the named §7506(a) mode, in payment of or security for a debt or penalty arising under the internal revenue laws";
}
pub relation secretary_has_charge_of_realty(r: Realty) kind institutional {
    label en unofficial "the Secretary has charge of this real estate under §7506(a) (vests by force of law on acquisition; no discretion)";
}
@source(IRC_S7506_A, relation = formalizes, coverage = exact, quote = "The Secretary shall have charge of all real estate which is or shall become the property of the United States by judgment of forfeiture under the internal revenue laws, or which has been or shall be assigned, set off, or conveyed by purchase or otherwise to the United States in payment of debts or penalties arising under the laws relating to internal revenue, or which has been or shall be vested in the United States by mortgage or other security for the payment of such debts, or which has been redeemed by the United States, and of all trusts created for the use of the United States in payment of such debts due them.")
rule S7506ChargeVestsOnAcquisition strict {
    for r: Realty;
    for mode: RealEstateAcquisitionMode;
    when real_estate_acquired_by_us(r, mode);
    then secretary_has_charge_of_realty(r);
}

relation secretary_notice_days_before_sale(r: Realty, days: Integer) kind empirical {
    label en unofficial "the number of days' public notice the Secretary gave before the public sale of this real estate";
}
relation notice_of_at_least_20_days_given(r: Realty) kind derived {
    label en unofficial "at least 20 days' notice of the public sale was given, per §7506(b)'s own minimum (folded to one atom for `valid_when`, LDC-E1305)";
}
@source(IRC_S7506_B, relation = formalizes, coverage = partial, quote = "upon not less than 20 days' notice")
rule S7506NoticeAtLeast20Days strict {
    for r: Realty;
    for days: Integer;
    when secretary_notice_days_before_sale(r, days)
        and days >= 20;
    then notice_of_at_least_20_days_given(r);
}
relation secretary_sells_realty(r: Realty) kind empirical {
    label en unofficial "the Secretary sells the real estate at public sale";
}
pub relation realty_sold_by_secretary(r: Realty) kind institutional {
    label en unofficial "the Secretary has validly sold the real estate at public sale under §7506(b)";
}
@source(IRC_S7506_B, relation = formalizes, coverage = exact, quote = "The Secretary, may, at public sale, and upon not less than 20 days' notice, sell and dispose of any real estate owned or held by the United States as aforesaid.")
rule S7506SalePower strict {
    for r: Realty;
    when secretary_sells_realty(r);
    then power S7506SalePowerGrant {
        holder Secretary;
        over r;
        exercise secretary_sells_realty(r);
        valid_when notice_of_at_least_20_days_given(r);
        effect create(realty_sold_by_secretary(r));
    };
}

relation secretary_leases_realty(r: Realty) kind empirical {
    label en unofficial "the Secretary leases the real estate on terms and for a period the Secretary deems proper, pending sale";
}
pub relation realty_leased_by_secretary(r: Realty) kind institutional {
    label en unofficial "the Secretary has validly leased the real estate under §7506(c), pending sale";
}
@source(IRC_S7506_C, relation = formalizes, coverage = exact, quote = "Until such sale, the Secretary may lease such real estate owned as aforesaid on such terms and for such period as the Secretary shall deem proper.")
rule S7506LeasePower strict {
    for r: Realty;
    when secretary_leases_realty(r)
        and not_known(realty_sold_by_secretary(r));
    then power S7506LeasePowerGrant {
        holder Secretary;
        over r;
        exercise secretary_leases_realty(r);
        valid_when not_known(realty_sold_by_secretary(r));
        effect create(realty_leased_by_secretary(r));
    };
}

relation debt_and_interest_paid_within_2_years_of_acquisition(r: Realty) kind empirical {
    label en unofficial "the underlying debt, together with interest at 1 percent per month, has been paid to the United States within 2 years of the real estate's acquisition (§7506(d)'s own window; the interest computation itself is the caller's, not this module's — see report)";
}
relation secretary_releases_realty_to_debtor(r: Realty) kind empirical {
    label en unofficial "the Secretary releases (by deed or otherwise conveys) the real estate to the debtor, or the debtor's heirs or legal representatives";
}
pub relation realty_released_to_debtor(r: Realty) kind institutional {
    label en unofficial "the Secretary has validly released the real estate to the debtor (or heirs/legal representatives) under §7506(d)";
}
@source(IRC_S7506_D, relation = formalizes, coverage = exact, quote = "In cases where real estate has or may become the property of the United States by conveyance or otherwise, in payment of or as security for a debt arising under the laws relating to internal revenue, and such debt shall have been paid, together with the interest thereon, at the rate of 1 percent per month, to the United States, within 2 years from the date of the acquisition of such real estate, it shall be lawful for the Secretary to release by deed or otherwise convey such real estate to the debtor from whom it was taken, or to his heirs or other legal representatives.")
rule S7506ReleaseToDebtorPower strict {
    for r: Realty;
    when secretary_releases_realty_to_debtor(r);
    then power S7506ReleaseToDebtorPowerGrant {
        holder Secretary;
        over r;
        exercise secretary_releases_realty_to_debtor(r);
        valid_when debt_and_interest_paid_within_2_years_of_acquisition(r);
        effect create(realty_released_to_debtor(r));
    };
}

// --- §7507: exemption of insolvent banks from tax -----------------------------

relation bank_ceased_business_by_insolvency_or_bankruptcy(bank: Person) kind empirical {
    label en unofficial "the bank or trust company (a substantial portion of whose business consists of receiving deposits and making loans and discounts) has ceased to do business by reason of insolvency or bankruptcy";
}
relation tax_would_diminish_depositor_payment_assets(bank: Person) kind empirical {
    label en unofficial "assessing, collecting, or paying the tax into the Treasury on account of the bank would diminish the assets necessary for the full payment of all its depositors";
}
relation tax_assessed_collected_or_paid_on_account_of_bank(bank: Person) kind empirical {
    label en unofficial "a tax is being assessed, collected, or paid into the Treasury on account of the named insolvent/bankrupt bank or trust company (the act §7507(a) protects against)";
}
relation employment_tax_chapter_21_or_23(tax_chapter: Integer) kind empirical {
    label en unofficial "the tax at issue is imposed by chapter 21 (FICA) or chapter 23 (FUTA) of this title — §7507(d)'s carve-out";
}
@source(IRC_S7507_A, relation = formalizes, coverage = exact, quote = "no tax shall be assessed or collected, or paid into the Treasury of the United States, on account of such bank or trust company, which shall diminish the assets thereof necessary for the full payment of all its depositors")
rule S7507InsolventBankImmunity defeasible {
    for bank: Person;
    when bank_ceased_business_by_insolvency_or_bankruptcy(bank)
        and tax_would_diminish_depositor_payment_assets(bank)
        and tax_assessed_collected_or_paid_on_account_of_bank(bank);
    then immunity S7507InsolventBankProtection {
        holder bank;
        protected_effect tax_assessed_collected_or_paid_on_account_of_bank(bank);
        window [-infinity, infinity];
    };
    unless employment_tax_chapter_21_or_23(21)
        and tax_assessed_collected_or_paid_on_account_of_bank(bank);
    unless employment_tax_chapter_21_or_23(23)
        and tax_assessed_collected_or_paid_on_account_of_bank(bank);
}

relation comptroller_finds_national_bank_insolvent(bank: Person) kind empirical {
    label en unofficial "the Comptroller of the Currency finds the named national bank to be insolvent";
}
pub relation tax_abated_for_national_bank(bank: Person) kind institutional {
    label en unofficial "§7507(a): the tax is abated from the national bank found insolvent by the Comptroller of the Currency (mandatory — no Secretary discretion)";
}
@source(IRC_S7507_A, relation = formalizes, coverage = exact, quote = "such tax shall be abated from such national banks as are found by the Comptroller of the Currency to be insolvent")
rule S7507MandatoryAbatementForNationalBanks strict {
    for bank: Person;
    when comptroller_finds_national_bank_insolvent(bank);
    then tax_abated_for_national_bank(bank);
}

relation state_chartered_insolvent_bank(bank: Person) kind empirical {
    label en unofficial "the bank or trust company is organized under State law (not a national bank) and is insolvent or bankrupt within §7507(a)";
}
relation secretary_ascertains_depositor_claims_affected(bank: Person) kind empirical {
    label en unofficial "the facts appear to the Secretary showing the tax would affect the claims of the bank's depositors";
}
pub relation tax_remitted_for_state_bank(bank: Person) kind institutional {
    label en unofficial "§7507(a): the Secretary has validly remitted the tax against the insolvent State-chartered bank or trust company";
}
@source(IRC_S7507_A, relation = formalizes, coverage = exact, quote = "the Secretary, when the facts shall appear to him, is authorized to remit so much of the said tax against any such insolvent banks and trust companies organized under State law as shall be found to affect the claims of their depositors")
rule S7507SecretaryRemissionPower strict {
    for bank: Person;
    when secretary_ascertains_depositor_claims_affected(bank);
    then power S7507RemissionPowerGrant {
        holder Secretary;
        over bank;
        exercise secretary_ascertains_depositor_claims_affected(bank);
        valid_when state_chartered_insolvent_bank(bank);
        effect create(tax_remitted_for_state_bank(bank));
    };
}

// §7507(c): reassessment/refund and the 90-day suspension of limitations are
// downstream `assessment`/`collection` package facts this package publishes
// the trigger for, rather than a restatement of those packages' own
// limitations machinery (their `pub` surface is outside this package).
pub relation s7507_bars_assessment_or_collection(bank: Person) kind institutional {
    label en unofficial "assessment, collection, or payment of the tax on account of this bank is currently barred under §7507(a) or (b) — the trigger fact `us.irc.assessment`'s own limitations rule reads for the §7507(c)(4) 90-day suspension";
}
@source(IRC_S7507_A, relation = formalizes, coverage = contextual, quote = "no tax shall be assessed or collected, or paid into the Treasury of the United States, on account of such bank or trust company")
rule S7507BarTriggersLimitationsSuspension defeasible {
    for bank: Person;
    when bank_ceased_business_by_insolvency_or_bankruptcy(bank)
        and tax_would_diminish_depositor_payment_assets(bank);
    then s7507_bars_assessment_or_collection(bank);
}
