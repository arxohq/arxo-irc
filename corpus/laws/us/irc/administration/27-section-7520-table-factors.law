// Section 7520 table factors (G4-RMD wire, 27.09.2026,
// implemented_unverified; scenarios written, NOT executed; no legal review).
//
// FROM-PACKAGE: `us.cfr.t26_7520_2031` (20.2031-0…-9, pinned eCFR
// 2026-09-24; Table S/B factors as `tables/*.lawtable.json`, structural
// mirrors, values as printed text). That package is rule-less by design:
// the factor enters here as a CASE-SELECTED fact (the case asserts the
// Table S/B row it reads at the valuation's §7520 rate), and the rule
// below applies it where section 7520 governs. Only key literals are
// modelled (Table S remainder factor at the computed rate); the full
// Table S rate grid (Pub 1457) is out of scope (see that package's README).
// The 120-percent-midterm rate itself (26/7520/a/u3, EXEC) is NOT touched:
// `section_7520_interest_rate` from module 08 is read, never rederived.

// =====================================================================
// 26/7520/a/u2: factors under tables prescribed by the Secretary
// =====================================================================

use self::{
    IRC_S7520_A,
    Valuation,
    section_7520_applies,
    section_7520_interest_rate,
};

pub relation table_s_remainder_factor_selected(v: Valuation, rate: Decimal, age: Integer, factor: Decimal) kind empirical {
    label en unofficial "the Table S remainder factor the case selects for this valuation at this section 7520 rate and age (20.2031-7 Table S; case-asserted key literal)";
}
pub relation section_7520_table_factor(v: Valuation, factor: Decimal) kind institutional {
    label en unofficial "the prescribed-table valuation factor applicable to the valuation at its section 7520 rate (section 7520(a)(1))";
}
@source(IRC_S7520_A, relation = formalizes, coverage = contextual, quote = "(1) under tables prescribed by the Secretary, and")
rule S7520TableSFactorApplied defeasible {
    for v: Valuation;
    for rate: Decimal;
    for age: Integer;
    for factor: Decimal;
    when section_7520_applies(v)
        and section_7520_interest_rate(v, rate)
        and table_s_remainder_factor_selected(v, rate, age, factor);
    then section_7520_table_factor(v, factor);
}
