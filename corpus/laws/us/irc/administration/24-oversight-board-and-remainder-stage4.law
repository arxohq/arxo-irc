// Administration — stage 4 (26.09.2026, DECISION-0379, implemented_unverified): rows that
// stages 2-3 left as TECH_GAP and could be expressed.
//
// Covered: §7802(b)(1), (2), (4) (composition, qualifications, terms, reappointment,
// vacancies, quorum of the IRS Oversight Board); §7508A(d)(6) (a separate period for each of
// several declarations); §7507(b), (c)(2), (c)(3) (segregated assets of a bank, reassessment);
// §7527A(b)(3)(B) (adjustment of later periodic payments after a modification); §7874(a)(2)(B)(ii)
// (I)-(II) (the ownership percentage of former shareholders or partners).
//
// METHOD AND JUDGMENT CALLS.
//  - Rosters are counted over EMPIRICAL facts (`count(collect ...)`); validity of the members is
//    tested by a separate relation (`unqualified_board_seat_holder`), so no aggregate reads a
//    derived predicate (§111 subset limit).
//  - §7802(b)(2)(A): "solely on the basis of professional experience and expertise" and "without
//    regard to political affiliation" are facts of the appointment record (`appointed_solely_on_expertise`,
//    `appointed_without_regard_to_political_affiliation`), not computed; "should collectively bring to
//    bear expertise in all of the areas" is a recommendation: the module reports whether the areas
//    are covered (`board_expertise_covers_all_areas`) and does not turn "should" into a duty.
//  - §7802(b)(2)(B): the terms are checked per member; the initial staggering (2 members for 3 years,
//    2 for 4, 2 for 5) is a count over the initially appointed (A) members.
//  - §7508A(d)(6): the existing rules key a disaster period on `disaster_area: Person`, which "stands
//    for the declared disaster"; each declaration is its own key, so several declarations of one area
//    give separate periods without a collision. The new relations name that structure.
//  - §7874(a)(2)(B)(ii): the percentage is the greater of the vote and the value percentage (the text
//    says "by vote or value"); the (c)(2) exclusions are already applied to the inputs.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    Commissioner,
    IRC_S7507_B,
    IRC_S7507_C,
    IRC_S7508A_D,
    IRC_S7527A_B,
    IRC_S7802_B,
    IRC_S7874_A,
    Organ,
    OversightBoard,
    Person,
    Secretary,
    disaster_declaration_issued_on,
    employment_tax_chapter_21_or_23,
    former_owner_percentage,
    is_oversight_board,
    mandatory_60_day_extension_end,
};

// ============================================================================
// §7802(b)(1) — composition
// ============================================================================

pub enum OversightBoardSeat {
    PresidentialAppointeeExternal;     // (1)(A)
    SecretaryOrDeputySecretary;        // (1)(B)
    Commissioner;                      // (1)(C)
    FederalEmployeeOrEmployeeRepresentative;  // (1)(D)
    label en unofficial "the four kinds of seat on the Oversight Board";
}
pub relation board_seat_held(m: Person, seat: OversightBoardSeat) kind empirical {
    label en official "the person holds the seat on the Oversight Board";
}
pub relation seat_holder_is_other_federal_officer_or_employee(m: Person) kind empirical {
    label en official "the person is otherwise a Federal officer or employee";
}
pub relation appointed_by_president_with_senate_consent(m: Person) kind empirical {
    label en official "the person is appointed by the President, by and with the advice and consent of the Senate";
}
pub relation seat_holder_is_full_time_federal_employee_or_representative(m: Person) kind empirical {
    label en official "the person is a full-time Federal employee or a representative of employees";
}
pub relation secretary_designated_deputy_to_serve(m: Person) kind empirical {
    label en official "the Secretary of the Treasury designated the Deputy Secretary of the Treasury to serve";
}
pub relation holds_office_secretary_of_treasury(m: Person) kind empirical {
    label en official "the person is the Secretary of the Treasury";
}
pub relation holds_office_deputy_secretary_of_treasury(m: Person) kind empirical {
    label en official "the person is the Deputy Secretary of the Treasury";
}
pub relation holds_office_commissioner_of_internal_revenue(m: Person) kind empirical {
    label en official "the person is the Commissioner of Internal Revenue";
}
pub relation oversight_board_seat_count(seat: OversightBoardSeat, n: Integer) kind institutional {
    label en unofficial "the number of persons holding seats of the kind";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(A) six members shall be individuals who are not otherwise Federal officers or employees and who are appointed by the President, by and with the advice and consent of the Senate.")
rule S7802b1CountExternalSeats strict {
    label en official "the number of seats of kind (1)(A)";
    when is_oversight_board(OversightBoard);
    then oversight_board_seat_count(PresidentialAppointeeExternal, count(collect m: Person where board_seat_held(m, PresidentialAppointeeExternal)));
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(B) one member shall be the Secretary of the Treasury or, if the Secretary so designates, the Deputy Secretary of the Treasury.")
rule S7802b1CountSecretarySeats strict {
    label en official "the number of seats of kind (1)(B)";
    when is_oversight_board(OversightBoard);
    then oversight_board_seat_count(SecretaryOrDeputySecretary, count(collect m: Person where board_seat_held(m, SecretaryOrDeputySecretary)));
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(C) one member shall be the Commissioner of Internal Revenue.")
rule S7802b1CountCommissionerSeats strict {
    label en official "the number of seats of kind (1)(C)";
    when is_oversight_board(OversightBoard);
    then oversight_board_seat_count(Commissioner, count(collect m: Person where board_seat_held(m, Commissioner)));
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(D) one member shall be an individual who is a full-time Federal employee or a representative of employees and who is appointed by the President, by and with the advice and consent of the Senate.")
rule S7802b1CountEmployeeSeats strict {
    label en official "the number of seats of kind (1)(D)";
    when is_oversight_board(OversightBoard);
    then oversight_board_seat_count(FederalEmployeeOrEmployeeRepresentative, count(collect m: Person where board_seat_held(m, FederalEmployeeOrEmployeeRepresentative)));
}
pub relation unqualified_board_seat_holder(m: Person) kind institutional {
    label en unofficial "a person holds a seat without meeting the condition the seat requires";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "six members shall be individuals who are not otherwise Federal officers or employees and who are appointed by the President, by and with the advice and consent of the Senate.")
rule S7802b1AHolderIsOtherOfficer strict {
    label en official "a (1)(A) member who is otherwise a Federal officer or employee does not meet the seat's condition";
    for m: Person;
    when board_seat_held(m, PresidentialAppointeeExternal) and seat_holder_is_other_federal_officer_or_employee(m);
    then unqualified_board_seat_holder(m);
}
rule S7802b1AHolderNotAppointed strict {
    label en official "a (1)(A) member not appointed by the President with Senate consent does not meet the seat's condition";
    for m: Person;
    when board_seat_held(m, PresidentialAppointeeExternal) and not_known(appointed_by_president_with_senate_consent(m));
    then unqualified_board_seat_holder(m);
}
rule S7802b1BHolderNotSecretaryOrDesignatedDeputy strict {
    label en official "a (1)(B) member must be the Secretary or the designated Deputy Secretary";
    for m: Person;
    when board_seat_held(m, SecretaryOrDeputySecretary)
        and not_known(holds_office_secretary_of_treasury(m))
        and not_known(designated_deputy_secretary(m));
    then unqualified_board_seat_holder(m);
}
pub relation designated_deputy_secretary(m: Person) kind institutional {
    label en unofficial "the person is the Deputy Secretary of the Treasury designated by the Secretary to serve";
}
rule S7802b1BDeputyDesignated strict {
    for m: Person;
    when holds_office_deputy_secretary_of_treasury(m) and secretary_designated_deputy_to_serve(m);
    then designated_deputy_secretary(m);
}
rule S7802b1CHolderNotCommissioner strict {
    label en official "a (1)(C) member must be the Commissioner of Internal Revenue";
    for m: Person;
    when board_seat_held(m, Commissioner) and not_known(holds_office_commissioner_of_internal_revenue(m));
    then unqualified_board_seat_holder(m);
}
rule S7802b1DHolderNotEmployee strict {
    label en official "a (1)(D) member must be a full-time Federal employee or a representative of employees";
    for m: Person;
    when board_seat_held(m, FederalEmployeeOrEmployeeRepresentative) and not_known(seat_holder_is_full_time_federal_employee_or_representative(m));
    then unqualified_board_seat_holder(m);
}
rule S7802b1DHolderNotAppointed strict {
    label en official "a (1)(D) member must be appointed by the President with Senate consent";
    for m: Person;
    when board_seat_held(m, FederalEmployeeOrEmployeeRepresentative) and not_known(appointed_by_president_with_senate_consent(m));
    then unqualified_board_seat_holder(m);
}
pub relation exists_unqualified_board_seat_holder(o: Person) kind institutional {
    label en unofficial "existential wrapper over `unqualified_board_seat_holder` for the board";
}
rule S7802b1ExistsUnqualified strict {
    for m: Person;
    when unqualified_board_seat_holder(m);
    then exists_unqualified_board_seat_holder(OversightBoard);
}
pub relation oversight_board_composed_as_prescribed(o: Organ) kind institutional {
    label en official "the Oversight Board is composed of nine members: six external presidential appointees, the Secretary (or the designated Deputy Secretary), the Commissioner, and one Federal employee or employee representative";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "The Oversight Board shall be composed of nine members, as follows:")
rule S7802b1Composition strict {
    label en official "the board is composed of nine members in the prescribed seats, each meeting the seat's condition";
    for nA: Integer;
    for nB: Integer;
    for nC: Integer;
    for nD: Integer;
    when is_oversight_board(OversightBoard)
        and oversight_board_seat_count(PresidentialAppointeeExternal, nA)
        and oversight_board_seat_count(SecretaryOrDeputySecretary, nB)
        and oversight_board_seat_count(Commissioner, nC)
        and oversight_board_seat_count(FederalEmployeeOrEmployeeRepresentative, nD)
        and nA == 6 and nB == 1 and nC == 1 and nD == 1
        and not_known(exists_unqualified_board_seat_holder(OversightBoard));
    then oversight_board_composed_as_prescribed(OversightBoard);
}

// ============================================================================
// §7802(b)(2)(A) — qualifications
// ============================================================================

pub enum OversightExpertiseArea {
    ManagementOfLargeServiceOrganizations;   // (i)
    CustomerService;                         // (ii)
    FederalTaxLawsAndAdministration;         // (iii)
    InformationTechnology;                   // (iv)
    OrganizationDevelopment;                 // (v)
    NeedsAndConcernsOfTaxpayers;             // (vi)
    NeedsAndConcernsOfSmallBusinesses;       // (vii)
    label en unofficial "the areas of professional experience and expertise of section 7802(b)(2)(A)(i)-(vii)";
}
pub relation appointed_without_regard_to_political_affiliation(m: Person) kind empirical {
    label en official "the member is appointed without regard to political affiliation";
}
pub relation appointed_solely_on_expertise(m: Person) kind empirical {
    label en official "the member is appointed solely on the basis of professional experience and expertise in one or more of the listed areas";
}
pub relation board_member_expertise_area(m: Person, area: OversightExpertiseArea) kind empirical {
    label en official "the member has professional experience and expertise in the area";
}
pub relation external_member_appointment_conforms(m: Person) kind institutional {
    label en official "the (1)(A) member is appointed without regard to political affiliation and solely on the basis of professional experience and expertise in one or more of the listed areas";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "Members of the Oversight Board described in paragraph (1)(A) shall be appointed without regard to political affiliation and solely on the basis of their professional experience and expertise in one or more of the following areas:")
rule S7802b2AAppointmentConforms strict {
    label en official "a (1)(A) member is appointed without regard to political affiliation and solely on the basis of expertise in at least one listed area";
    for m: Person;
    for area: OversightExpertiseArea;
    when board_seat_held(m, PresidentialAppointeeExternal)
        and appointed_without_regard_to_political_affiliation(m)
        and appointed_solely_on_expertise(m)
        and board_member_expertise_area(m, area);
    then external_member_appointment_conforms(m);
}
pub relation external_member_appointment_defective(m: Person) kind institutional {
    label en unofficial "a (1)(A) member whose appointment does not conform to (2)(A)";
}
rule S7802b2ADefectiveAppointment strict {
    for m: Person;
    when board_seat_held(m, PresidentialAppointeeExternal) and not_known(external_member_appointment_conforms(m));
    then external_member_appointment_defective(m);
}
pub relation area_covered_by_external_members(area: OversightExpertiseArea) kind institutional {
    label en unofficial "at least one (1)(A) member has expertise in the area";
}
rule S7802b2ACoverage strict {
    for m: Person;
    for area: OversightExpertiseArea;
    when board_seat_held(m, PresidentialAppointeeExternal) and board_member_expertise_area(m, area);
    then area_covered_by_external_members(area);
}
pub relation board_expertise_covers_all_areas(o: Organ) kind institutional {
    label en official "in the aggregate, the (1)(A) members bring to bear expertise in all seven areas (a recommendation: 'should collectively bring to bear')";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "In the aggregate, the members of the Oversight Board described in paragraph (1)(A) should collectively bring to bear expertise in all of the areas described in the preceding sentence.")
rule S7802b2ACollectiveExpertise strict {
    label en official "the external members collectively cover all seven areas";
    when is_oversight_board(OversightBoard)
        and area_covered_by_external_members(ManagementOfLargeServiceOrganizations)
        and area_covered_by_external_members(CustomerService)
        and area_covered_by_external_members(FederalTaxLawsAndAdministration)
        and area_covered_by_external_members(InformationTechnology)
        and area_covered_by_external_members(OrganizationDevelopment)
        and area_covered_by_external_members(NeedsAndConcernsOfTaxpayers)
        and area_covered_by_external_members(NeedsAndConcernsOfSmallBusinesses);
    then board_expertise_covers_all_areas(OversightBoard);
}

// ============================================================================
// §7802(b)(2)(B)-(D) — terms, reappointment, vacancies
// ============================================================================

pub relation board_term_years(m: Person, years: Integer) kind empirical {
    label en official "the length in years of the term for which the member is appointed";
}
pub relation first_appointed_under_1A(m: Person) kind empirical {
    label en official "the member is among the members first appointed under paragraph (1)(A)";
}
pub relation appointment_term_valid(m: Person) kind institutional {
    label en official "the member's term is as section 7802(b)(2)(B) prescribes: 5 years for (1)(A) and (1)(D) members, except that the members first appointed under (1)(A) serve 3, 4 or 5 years";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "Each member who is described in subparagraph (A) or (D) of paragraph (1) shall be appointed for a term of 5 years, except that of the members first appointed under paragraph (1)(A)—")
rule S7802b2BOrdinaryTermFiveYears strict {
    label en official "a (1)(A) or (1)(D) member not among the first appointees serves a 5-year term";
    for m: Person;
    when board_term_years(m, 5)
        and (board_seat_held(m, PresidentialAppointeeExternal) or board_seat_held(m, FederalEmployeeOrEmployeeRepresentative))
        and not_known(first_appointed_under_1A(m));
    then appointment_term_valid(m);
}
rule S7802b2BInitialTermThreeYears strict {
    label en official "a first-appointed (1)(A) member may serve 3 years";
    for m: Person;
    when board_term_years(m, 3) and board_seat_held(m, PresidentialAppointeeExternal) and first_appointed_under_1A(m);
    then appointment_term_valid(m);
}
rule S7802b2BInitialTermFourYears strict {
    label en official "a first-appointed (1)(A) member may serve 4 years";
    for m: Person;
    when board_term_years(m, 4) and board_seat_held(m, PresidentialAppointeeExternal) and first_appointed_under_1A(m);
    then appointment_term_valid(m);
}
rule S7802b2BInitialTermFiveYears strict {
    label en official "a first-appointed (1)(A) member may serve 5 years";
    for m: Person;
    when board_term_years(m, 5) and board_seat_held(m, PresidentialAppointeeExternal) and first_appointed_under_1A(m);
    then appointment_term_valid(m);
}
pub relation initial_terms_staggered_as_prescribed(o: Organ) kind institutional {
    label en official "of the members first appointed under (1)(A) two serve 3 years, two serve 4 years and two serve 5 years";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(i) two members shall be appointed for a term of 3 years,")
rule S7802b2BiTwoForThreeYears strict {
    label en official "two of the first appointees serve 3 years";
    when is_oversight_board(OversightBoard)
        and count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 3)) == 2
        and count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 4)) == 2
        and count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 5)) == 2;
    then initial_terms_staggered_as_prescribed(OversightBoard);
}
pub relation initial_term_cohort_count(years: Integer, n: Integer) kind institutional {
    label en unofficial "the number of first-appointed (1)(A) members with a term of the given length";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(ii) two members shall be appointed for a term of 4 years, and")
rule S7802b2BiiCohortFour strict {
    label en official "the number of first appointees with a 4-year term";
    when is_oversight_board(OversightBoard);
    then initial_term_cohort_count(4, count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 4)));
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "(iii) two members shall be appointed for a term of 5 years.")
rule S7802b2BiiiCohortFive strict {
    label en official "the number of first appointees with a 5-year term";
    when is_oversight_board(OversightBoard);
    then initial_term_cohort_count(5, count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 5)));
}
rule S7802b2BiCohortThree strict {
    label en official "the number of first appointees with a 3-year term";
    when is_oversight_board(OversightBoard);
    then initial_term_cohort_count(3, count(collect m: Person where first_appointed_under_1A(m) and board_term_years(m, 3)));
}
pub relation five_year_term_served_by(m: Person, ordinal: Integer) kind empirical {
    label en official "the person served (or is appointed to) the 5-year term of this ordinal on the Oversight Board";
}
pub relation reappointment_permitted(m: Person) kind institutional {
    label en official "the individual may be appointed to another 5-year term: fewer than two 5-year terms so far";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "An individual who is described in subparagraph (A) or (D) of paragraph (1) may be appointed to no more than two 5-year terms on the Oversight Board.")
rule S7802b2CReappointmentLimit strict {
    label en official "an (A) or (D) member may hold no more than two 5-year terms";
    for m: Person;
    when (board_seat_held(m, PresidentialAppointeeExternal) or board_seat_held(m, FederalEmployeeOrEmployeeRepresentative))
        and count(collect t: Integer where five_year_term_served_by(m, t)) < 2;
    then reappointment_permitted(m);
}
pub relation appointment_beyond_two_terms(m: Person) kind institutional {
    label en unofficial "the member is appointed to a third 5-year term";
}
rule S7802b2CThirdTerm strict {
    for m: Person;
    when (board_seat_held(m, PresidentialAppointeeExternal) or board_seat_held(m, FederalEmployeeOrEmployeeRepresentative))
        and count(collect t: Integer where five_year_term_served_by(m, t)) > 2;
    then appointment_beyond_two_terms(m);
}
pub relation vacancy_predecessor_term_ends_on(m: Person, endsOn: Date) kind empirical {
    label en official "the date the term of the predecessor of a member appointed to fill a vacancy was to expire";
}
pub relation member_term_ends_on(m: Person, endsOn: Date) kind empirical {
    label en official "the date the member's term ends";
}
pub relation vacancy_filled_by_original_manner(m: Person) kind empirical {
    label en official "the vacancy is filled in the same manner as the original appointment";
}
pub relation vacancy_appointment_valid(m: Person) kind institutional {
    label en official "the member appointed to fill a vacancy before the predecessor's term expired serves the remainder of that term";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "Any member appointed to fill a vacancy occurring before the expiration of the term for which the member's predecessor was appointed shall be appointed for the remainder of that term.")
rule S7802b2DVacancyRemainderOfTerm strict {
    label en official "a vacancy appointee serves the remainder of the predecessor's term, and is appointed in the same manner as the original appointment";
    for m: Person;
    for endsOn: Date;
    when vacancy_predecessor_term_ends_on(m, endsOn)
        and member_term_ends_on(m, endsOn)
        and vacancy_filled_by_original_manner(m);
    then vacancy_appointment_valid(m);
}

// ============================================================================
// §7802(b)(4) — quorum and majority
// ============================================================================

pub relation board_meeting_members_present(meeting: Person, n: Integer) kind empirical {
    label en official "the number of Board members present at the meeting";
}
pub relation board_meeting_members_present_and_voting(meeting: Person, n: Integer) kind empirical {
    label en official "the number of Board members present and voting";
}
pub relation board_meeting_votes_in_favor(meeting: Person, n: Integer) kind empirical {
    label en official "the number of members present and voting who vote in favor";
}
pub relation board_meeting_quorum_and_majority(meeting: Person) kind institutional {
    label en official "five members are present (a quorum) and a majority of the members present and voting favor the action";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "Five members of the Oversight Board shall constitute a quorum. A majority of members present and voting shall be required for the Oversight Board to take action.")
rule S7802b4QuorumAndMajority strict {
    label en official "a quorum is five members and action needs a majority of those present and voting";
    for meeting: Person;
    for present: Integer;
    for voting: Integer;
    for favor: Integer;
    when board_meeting_members_present(meeting, present)
        and board_meeting_members_present_and_voting(meeting, voting)
        and board_meeting_votes_in_favor(meeting, favor)
        and present >= 5
        and favor * 2 > voting;
    then board_meeting_quorum_and_majority(meeting);
}
pub relation oversight_board_takes_action(meeting: Person, matter: Person) kind empirical {
    label en official "the Oversight Board takes the action at the meeting";
}
pub relation oversight_board_action_taken_validly(meeting: Person, matter: Person) kind institutional {
    label en official "the Oversight Board's action at the meeting is taken with a quorum and a majority";
}
@source(IRC_S7802_B, relation = formalizes, coverage = exact, quote = "A majority of members present and voting shall be required for the Oversight Board to take action.")
rule S7802b4BoardActionPower strict {
    label en official "the Oversight Board takes action only with a quorum and a majority of those present and voting";
    for meeting: Person;
    for matter: Person;
    when oversight_board_takes_action(meeting, matter);
    then power S7802b4BoardActionPowerGrant {
        holder OversightBoard;
        over matter;
        exercise oversight_board_takes_action(meeting, matter);
        valid_when board_meeting_quorum_and_majority(meeting);
        effect create(oversight_board_action_taken_validly(meeting, matter));
    };
}

// ============================================================================
// §7508A(d)(6) — multiple declarations
// ============================================================================

pub relation declaration_relates_to_area(declaration: Person, area: Person) kind empirical {
    label en official "the disaster declaration relates to the disaster area";
}
pub relation declarations_of_area_within_60_days(area: Person) kind institutional {
    label en official "several declarations relating to one disaster area are issued within a 60-day period";
}
@source(IRC_S7508A_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), in the case of multiple declarations relating to a disaster area which are issued within a 60-day period, a separate period shall be determined under such paragraph with respect to each such declaration.")
rule S7508Ad6MultipleDeclarationsWithin60Days defeasible {
    label en official "two declarations of one area issued within 60 days of each other";
    for area: Person;
    for d1: Person;
    for d2: Person;
    for issued1: Date;
    for issued2: Date;
    when declaration_relates_to_area(d1, area)
        and declaration_relates_to_area(d2, area)
        and d1 != d2
        and disaster_declaration_issued_on(d1, issued1)
        and disaster_declaration_issued_on(d2, issued2)
        and issued2 >= issued1
        and issued2 <= add_calendar_period(issued1, 60 calendar_day);
    then declarations_of_area_within_60_days(area);
}
pub relation separate_period_for_declaration(declaration: Person, end: Date) kind institutional {
    label en official "a separate mandatory period is determined for each declaration: it ends 60 days after the later of the declaration's earliest incident date and its issue date";
}
@source(IRC_S7508A_D, relation = formalizes, coverage = exact, quote = "a separate period shall be determined under such paragraph with respect to each such declaration.")
rule S7508Ad6SeparatePeriodPerDeclaration defeasible {
    label en official "each declaration of a multiply-declared area has its own mandatory period";
    for area: Person;
    for declaration: Person;
    for end: Date;
    when declarations_of_area_within_60_days(area)
        and declaration_relates_to_area(declaration, area)
        and mandatory_60_day_extension_end(declaration, end);
    then separate_period_for_declaration(declaration, end);
}

// ============================================================================
// §7507(b), (c)(2), (c)(3)
// ============================================================================

pub relation bank_released_from_deposit_liability_for_lien_or_segregated_assets(bank: Person) kind empirical {
    label en official "the bank or trust company has been released or discharged from its liability to its depositors for part of their claims, and the depositors accepted a lien upon subsequent earnings or claims against segregated or transferred assets in lieu thereof";
}
pub relation tax_would_diminish_assets_available_for_depositor_claims(taxpayer: Person) kind empirical {
    label en official "assessing, collecting or paying the tax on account of the bank, the trustee or the agent would diminish the assets available for the payment of the depositor claims and necessary for their full payment";
}
pub relation tax_assessed_collected_or_paid_on_account_of_taxpayer(taxpayer: Person) kind empirical {
    label en official "a tax is assessed, collected, or paid into the Treasury on account of the bank, the individual or corporate trustee, or the agent";
}
pub relation taxpayer_is_bank_trustee_or_agent_of_released_bank(taxpayer: Person, bank: Person) kind empirical {
    label en official "the taxpayer is the bank, an individual or corporate trustee, or an agent (including a liquidating corporation) holding the segregated assets";
}
@source(IRC_S7507_B, relation = formalizes, coverage = exact, quote = "no tax shall be assessed or collected, or paid into the Treasury of the United States, on account of such bank or trust company, such individual or corporate trustee or such agent, which shall diminish the assets thereof which are available for the payment of such depositor claims and which are necessary for the full payment thereof.")
rule S7507bSegregatedAssetsImmunity defeasible {
    label en official "no tax is assessed or collected on account of the bank, trustee or agent to the extent it would diminish assets available for the depositors' claims";
    for taxpayer: Person;
    for bank: Person;
    when bank_released_from_deposit_liability_for_lien_or_segregated_assets(bank)
        and taxpayer_is_bank_trustee_or_agent_of_released_bank(taxpayer, bank)
        and tax_would_diminish_assets_available_for_depositor_claims(taxpayer)
        and tax_assessed_collected_or_paid_on_account_of_taxpayer(taxpayer);
    then immunity S7507bSegregatedAssetsProtection {
        holder taxpayer;
        protected_effect tax_assessed_collected_or_paid_on_account_of_taxpayer(taxpayer);
        window [-infinity, infinity];
    };
    unless employment_tax_chapter_21_or_23(21)
        and tax_assessed_collected_or_paid_on_account_of_taxpayer(taxpayer)
        and bank_released_from_deposit_liability_for_lien_or_segregated_assets(bank)
        and taxpayer_is_bank_trustee_or_agent_of_released_bank(taxpayer, bank)
        and tax_would_diminish_assets_available_for_depositor_claims(taxpayer);
    unless employment_tax_chapter_21_or_23(23)
        and tax_assessed_collected_or_paid_on_account_of_taxpayer(taxpayer)
        and bank_released_from_deposit_liability_for_lien_or_segregated_assets(bank)
        and taxpayer_is_bank_trustee_or_agent_of_released_bank(taxpayer, bank)
        and tax_would_diminish_assets_available_for_depositor_claims(taxpayer);
}
pub relation tax_previously_barred_abated_or_remitted_under_7507a(bank: Person) kind empirical {
    label en official "the tax, the assessment, collection or payment of which is barred under subsection (a), or which has been abated or remitted";
}
pub relation payment_of_tax_will_not_diminish_assets(bank: Person) kind empirical {
    label en official "it appears that payment of the tax will not diminish the assets necessary for the full payment of all the depositors";
}
pub relation tax_reassessed_on_account_of_bank(bank: Person) kind empirical {
    label en official "the tax is assessed or reassessed";
}
@source(IRC_S7507_C, relation = formalizes, coverage = exact, quote = "shall be assessed or reassessed whenever it shall appear that payment of the tax will not diminish the assets as aforesaid.")
rule S7507c2ReassessWhenNoDiminution defeasible {
    label en official "a tax barred, abated or remitted under (a) shall be assessed or reassessed whenever payment will not diminish the assets";
    for bank: Person;
    when tax_previously_barred_abated_or_remitted_under_7507a(bank) and payment_of_tax_will_not_diminish_assets(bank);
    then duty S7507c2ReassessDuty {
        bearer Secretary;
        goal achievement {
            condition tax_reassessed_on_account_of_bank(bank);
            window [-infinity, infinity];
        }
    };
}
pub relation tax_previously_barred_or_refunded_under_7507b(taxpayer: Person) kind empirical {
    label en official "the tax, the assessment, collection or payment of which is barred under subsection (b), or which has been refunded";
}
pub relation depositor_claims_paid_in_full(bank: Person) kind empirical {
    label en official "the claims of the depositors are fully paid";
}
pub relation remaining_segregated_or_transferred_assets(bank: Person, amount: Money) kind empirical {
    label en official "the assets remaining of those segregated or transferred as described in subsection (b)";
}
pub relation tax_barred_or_refunded_amount(taxpayer: Person, bank: Person, amount: Money) kind empirical {
    label en official "the amount of the tax that was barred or refunded";
}
pub relation reassessable_after_claims_paid(taxpayer: Person, bank: Person, amount: Money) kind institutional {
    label en official "the tax may be assessed or reassessed to the extent of the remaining segregated or transferred assets";
}
@source(IRC_S7507_C, relation = formalizes, coverage = exact, quote = "shall be assessed or reassessed after full payment of such claims of depositors to the extent of the remaining assets segregated or transferred as described in subsection (b).")
rule S7507c3ReassessAfterFullPayment defeasible {
    label en official "after full payment of the depositors' claims the tax is reassessed to the extent of the remaining segregated or transferred assets";
    for taxpayer: Person;
    for bank: Person;
    for barred: Money;
    for remaining: Money;
    when tax_previously_barred_or_refunded_under_7507b(taxpayer)
        and taxpayer_is_bank_trustee_or_agent_of_released_bank(taxpayer, bank)
        and depositor_claims_paid_in_full(bank)
        and tax_barred_or_refunded_amount(taxpayer, bank, barred)
        and remaining_segregated_or_transferred_assets(bank, remaining);
    then reassessable_after_claims_paid(taxpayer, bank, min(barred, remaining));
}

// ============================================================================
// §7527A(b)(3)(B) — adjustment of later payments after a modification
// ============================================================================

pub relation modified_periodic_payment_amount(t: Person, amount: Money) kind empirical {
    label en official "the periodic payment on the basis of the annual advance amount as modified";
}
pub relation periodic_payment_made_before_modification(t: Person, k: Integer, amount: Money) kind empirical {
    label en official "a periodic payment made before the date of the modification (k is its ordinal)";
}
pub relation periodic_payment_adjustment_for_prior_payments(t: Person, adjustment: Money) kind institutional {
    label en official "the amount by which the payments made before the modification were less than (positive) or greater than (negative) what they would have been on the modified annual advance amount, to be taken into account in payments after the modification";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "to properly take into account the amount by which any periodic payment made before such date was greater than or less than the amount that such payment would have been on the basis of the annual advance amount as so modified.")
rule S7527Ab3BAdjustmentForPriorPayments strict {
    label en official "the adjustment is the difference between what the earlier payments would have been on the modified amount and what they were";
    for t: Person;
    for modified: Money;
    when modified_periodic_payment_amount(t, modified);
    then periodic_payment_adjustment_for_prior_payments(t,
        (modified * count(collect k: Integer where periodic_payment_made_before_modification(t, k, _)))
        - (sum all amount: Money for k: Integer where periodic_payment_made_before_modification(t, k, amount)));
}
pub relation secretary_adjusts_later_periodic_payment(t: Person) kind empirical {
    label en official "the Secretary adjusts the amount of a periodic payment made after the modification";
}
@source(IRC_S7527A_B, relation = formalizes, coverage = exact, quote = "the Secretary may adjust the amount of any periodic payment made after the date of such modification")
rule S7527Ab3BSecretaryMayAdjust defeasible {
    label en official "the Secretary may adjust later periodic payments for the excess or deficit of earlier ones";
    for t: Person;
    for adjustment: Money;
    when periodic_payment_adjustment_for_prior_payments(t, adjustment) and secretary_adjusts_later_periodic_payment(t);
    then liberty S7527Ab3BAdjustLaterPaymentLiberty {
        holder Secretary;
        against t;
        action secretary_adjusts_later_periodic_payment(t);
        window [-infinity, infinity];
    };
}

// ============================================================================
// §7874(a)(2)(B)(ii) — the ownership percentage of former owners
// ============================================================================

pub enum OwnershipMeasure {
    ByVote;
    ByValue;
    label en unofficial "the stock of the entity is measured by vote or by value";
}
pub relation entity_stock_held_by_former_owners(e: Person, d: Person, measure: OwnershipMeasure, held: Decimal) kind empirical {
    label en official "the amount (votes, or value) of the entity's stock held after the acquisition by former shareholders of the domestic corporation by reason of holding stock in it, or by former partners of the domestic partnership by reason of holding a capital or profits interest in it, measured after the section 7874(c)(2) exclusions";
}
pub relation entity_total_stock(e: Person, measure: OwnershipMeasure, total: Decimal) kind empirical {
    label en official "the total amount (votes, or value) of the entity's stock after the acquisition, measured after the section 7874(c)(2) exclusions";
}
pub relation acquisition_of_domestic_corporation(e: Person, d: Person) kind empirical {
    label en official "the acquisition is with respect to a domestic corporation (clause (I))";
}
pub relation acquisition_of_domestic_partnership(e: Person, d: Person) kind empirical {
    label en official "the acquisition is with respect to a domestic partnership (clause (II))";
}
@source(IRC_S7874_A, relation = formalizes, coverage = exact, quote = "(I) in the case of an acquisition with respect to a domestic corporation, by former shareholders of the domestic corporation by reason of holding stock in the domestic corporation, or")
rule S7874a2BiiIFormerShareholdersPercentage strict {
    label en official "the percentage of the entity's stock (by vote or by value) held by former shareholders of the domestic corporation by reason of their stock";
    for e: Person;
    for d: Person;
    for measure: OwnershipMeasure;
    for held: Decimal;
    for total: Decimal;
    when acquisition_of_domestic_corporation(e, d)
        and entity_stock_held_by_former_owners(e, d, measure, held)
        and entity_total_stock(e, measure, total)
        and total > 0.0;
    then former_owner_percentage(e, d, div_round(held * 100.0, total, 4, "HALF_UP"));
}
@source(IRC_S7874_A, relation = formalizes, coverage = exact, quote = "(II) in the case of an acquisition with respect to a domestic partnership, by former partners of the domestic partnership by reason of holding a capital or profits interest in the domestic partnership,")
rule S7874a2BiiIIFormerPartnersPercentage strict {
    label en official "the percentage of the entity's stock (by vote or by value) held by former partners of the domestic partnership by reason of their capital or profits interest";
    for e: Person;
    for d: Person;
    for measure: OwnershipMeasure;
    for held: Decimal;
    for total: Decimal;
    when acquisition_of_domestic_partnership(e, d)
        and entity_stock_held_by_former_owners(e, d, measure, held)
        and entity_total_stock(e, measure, total)
        and total > 0.0;
    then former_owner_percentage(e, d, div_round(held * 100.0, total, 4, "HALF_UP"));
}
