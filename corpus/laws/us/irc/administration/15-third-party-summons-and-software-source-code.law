// 26 U.S.C. §7609 (special procedures for third-party summonses), §7612
// (special procedures for summonses for computer software), §7613 (cross
// references; classified in the coverage file). STAGE 3.
//
// JUDGMENT CALLS
//  - The notice deadline of §7609(a)(1) has two limbs: within 3 days of the
//    day of service and no later than the 23rd day before the day fixed for
//    examination; each is its own achievement duty. The second window end is
//    `add_calendar_period(exam, -23 calendar_day)` (a negative step; the
//    scenarios are not executed, so the negative-step semantics under the
//    IRC_CALENDAR_STEP policy are unverified).
//  - "Close of the 23rd day after notice" (§7609(d)(1)) is measured with
//    `days_between(notice, examination) <= 23` (examination on day 23 is
//    still before the close of that day).
//  - Limitations suspensions (§7609(e)) are published as institutional facts
//    (`summons_limitations_suspended_from`); the §6501/§6531 clocks belong to
//    assessment and crimes (pending dependencies).
//  - §7609(g)/(f) court determinations are powers of the district court; the
//    "reasonable cause to believe" of (g) is an external judgment of the court.
//  - "Reasonable specificity" and the (b)(1)(C) outweighing determination of
//    §7612 are external judgments (the Secretary's determination for (C)).

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    DistrictCourt,
    IRC_S7609_A,
    IRC_S7609_B,
    IRC_S7609_C,
    IRC_S7609_D,
    IRC_S7609_E,
    IRC_S7609_F,
    IRC_S7609_G,
    IRC_S7609_H,
    IRC_S7609_I,
    IRC_S7612_A,
    IRC_S7612_B,
    IRC_S7612_C,
    Person,
    Secretary,
    SummonsDoc,
    summons_directed_to,
};

// --- §7609(a): notice --------------------------------------------------------------------

relation summons_seeks_records_of_other_person(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the summons requires testimony on or relating to, or production of records made or kept on or relating to, or production of computer software source code with respect to, a person other than the person summoned, who is identified in the summons";
}
relation summons_under_7602a2_6420_6421_6427_or_7612(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is issued under section 7602(a)(2), 6420(e)(2), 6421(g)(2), 6427(j)(2) or 7612";
}
relation summons_served_on_taxpayer_or_its_officer(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is served on the person with respect to whose liability it is issued, or an officer or employee of that person (§7609(c)(2)(A))";
}
relation summons_to_determine_whether_records_exist(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is issued to determine whether records of the business transactions or affairs of an identified person have been made or kept (§7609(c)(2)(B))";
}
relation summons_solely_to_identify_numbered_account_holder(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is issued solely to determine the identity of a person having a numbered account or similar arrangement with a bank or institution described in section 7603(b)(2)(A) (§7609(c)(2)(C))";
}
relation summons_in_aid_of_collection(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is issued in aid of collection of an assessment made or judgment rendered against the person with respect to whose liability it is issued, or of a transferee or fiduciary liability of such a person (§7609(c)(2)(D))";
}
relation criminal_investigator_summons_on_non_recordkeeper(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is issued by an IRS criminal investigator in connection with an offense investigation and served on a person who is not a third-party recordkeeper (§7609(c)(2)(E))";
}
relation summons_is_john_doe_or_special_exception_summons(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is described in subsection (f) (John Doe) or (g) (special exception), to which subsection (a) does not apply (§7609(c)(3))";
}
relation s7609_exception_applies(s: SummonsDoc) kind derived {
    label en unofficial "one of the §7609(c)(2) exceptions or (c)(3) applies to the summons";
}
pub relation s7609_notice_applies(s: SummonsDoc, x: Person) kind institutional {
    label en unofficial "§7609(a) requires notice of the summons to the identified person";
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "served on the person with respect to whose liability the summons is issued, or any officer or employee of such person")
rule S7609ExceptionServedOnTaxpayer strict {
    for s: SummonsDoc;
    when summons_served_on_taxpayer_or_its_officer(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "issued to determine whether or not records of the business transactions or affairs of an identified person have been made or kept")
rule S7609ExceptionRecordsExist strict {
    for s: SummonsDoc;
    when summons_to_determine_whether_records_exist(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "issued solely to determine the identity of any person having a numbered account (or similar arrangement) with a bank or other institution described in section 7603(b)(2)(A)")
rule S7609ExceptionNumberedAccount strict {
    for s: SummonsDoc;
    when summons_solely_to_identify_numbered_account_holder(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "issued in aid of the collection of—")
rule S7609ExceptionCollection strict {
    for s: SummonsDoc;
    when summons_in_aid_of_collection(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "issued by a criminal investigator of the Internal Revenue Service in connection with the investigation of an offense connected with the administration or enforcement of the internal revenue laws")
rule S7609ExceptionCriminalInvestigator strict {
    for s: SummonsDoc;
    when criminal_investigator_summons_on_non_recordkeeper(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any summons described in subsection (f) or (g).")
rule S7609ExceptionJohnDoe strict {
    for s: SummonsDoc;
    when summons_is_john_doe_or_special_exception_summons(s);
    then s7609_exception_applies(s);
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "then notice of the summons shall be given to any person so identified")
rule S7609NoticeApplies strict {
    for s: SummonsDoc;
    for x: Person;
    when summons_under_7602a2_6420_6421_6427_or_7612(s)
        and summons_seeks_records_of_other_person(s, x)
        and not_known(s7609_exception_applies(s));
    then s7609_notice_applies(s, x);
}
relation summons_served_on(s: SummonsDoc, d: Date) kind empirical {
    label en unofficial "the date the summons is served";
}
relation records_examination_date_fixed(s: SummonsDoc, d: Date) kind empirical {
    label en unofficial "the day fixed in the summons as the day upon which the records are to be examined";
}
relation notice_of_summons_given_to(s: SummonsDoc, x: Person, d: Date) kind empirical {
    label en unofficial "notice of the summons, with a copy of the summons and an explanation of the right to bring a proceeding to quash, is given to the person on this date";
}
relation notice_of_summons_given_in_time(s: SummonsDoc, x: Person) kind derived {
    label en unofficial "the notice was given within 3 days of service and not later than the 23rd day before the day fixed for examination";
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "within 3 days of the day on which such service is made")
rule S7609NoticeWithinThreeDays strict {
    for s: SummonsDoc;
    for x: Person;
    for served: Date;
    for given: Date;
    for exam: Date;
    for calendar_before_1: Date;
    when s7609_notice_applies(s, x)
        and summons_served_on(s, served)
        and records_examination_date_fixed(s, exam)
        and notice_of_summons_given_to(s, x, given)
        and given <= add_calendar_period(served, 3 calendar_day)
        and given <= calendar_before_1
        and us.irc.core::civil_calendar_boundary_before(exam, 23, us.irc.core::CalendarDay, calendar_before_1);
    then notice_of_summons_given_in_time(s, x);
}
relation s7609_notice_delivered(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the Secretary delivers the §7609(a)(1) notice to the identified person";
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "notice of the summons shall be given to any person so identified within 3 days of the day on which such service is made")
rule S7609NoticeDuty3Days defeasible {
    for s: SummonsDoc;
    for x: Person;
    for served: Date;
    when s7609_notice_applies(s, x)
        and summons_served_on(s, served);
    then duty S7609GiveNoticeWithinThreeDays {
        bearer Secretary;
        beneficiary x;
        goal achievement {
            condition s7609_notice_delivered(s, x);
            window [served, add_calendar_period(served, 3 calendar_day)];
        }
    };
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "but no later than the 23rd day before the day fixed in the summons as the day upon which such records are to be examined")
rule S7609NoticeDuty23Days defeasible {
    for s: SummonsDoc;
    for x: Person;
    for served: Date;
    for exam: Date;
    for calendar_before_1: Date;
    when s7609_notice_applies(s, x)
        and summons_served_on(s, served)
        and records_examination_date_fixed(s, exam)
        and us.irc.core::civil_calendar_boundary_before(exam, 23, us.irc.core::CalendarDay, calendar_before_1);
    then duty S7609GiveNoticeBy23rdDayBeforeExamination {
        bearer Secretary;
        beneficiary x;
        goal achievement {
            condition s7609_notice_delivered(s, x);
            window [served, calendar_before_1];
        }
    };
}
relation notice_accompanied_by_copy_of_summons(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the notice is accompanied by a copy of the summons that was served";
}
relation notice_explains_right_to_quash(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the notice contains an explanation of the right under (b)(2) to bring a proceeding to quash";
}
relation notice_content_complete(s: SummonsDoc, x: Person) kind derived {
    label en unofficial "the notice carries the summons copy and the explanation of the right to quash";
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "Such notice shall be accompanied by a copy of the summons which has been served and shall contain an explanation of the right under subsection (b)(2) to bring a proceeding to quash the summons.")
rule S7609NoticeContent strict {
    for s: SummonsDoc;
    for x: Person;
    when notice_accompanied_by_copy_of_summons(s, x)
        and notice_explains_right_to_quash(s, x);
    then notice_content_complete(s, x);
}
enum NoticeDeliveryManner {
    ServedAsSummonsUnderSection7603;
    NoticeMailedCertifiedOrRegistered;
    LeftWithPersonSummonedWhenNoLastKnownAddress;
}
relation notice_delivery_manner(s: SummonsDoc, x: Person, m: NoticeDeliveryManner) kind empirical {
    label en unofficial "the manner of delivery of the notice, on or before the third day";
}
relation person_has_last_known_address(x: Person) kind empirical {
    label en unofficial "the person entitled to notice has a last known address";
}
pub relation notice_sufficient(s: SummonsDoc, x: Person) kind institutional {
    label en unofficial "the notice is sufficient under §7609(a)(2): served as a summons under section 7603, mailed by certified or registered mail to the last known address (even if the person is deceased, under a disability or no longer in existence), or, absent an address, left with the person summoned";
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "such notice is served in the manner provided in section 7603 (relating to service of summons) upon the person entitled to notice")
rule S7609SufficientServed strict {
    for s: SummonsDoc;
    for x: Person;
    when notice_delivery_manner(s, x, ServedAsSummonsUnderSection7603);
    then notice_sufficient(s, x);
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "or is mailed by certified or registered mail to the last known address of such person")
rule S7609SufficientMailed strict {
    for s: SummonsDoc;
    for x: Person;
    when notice_delivery_manner(s, x, NoticeMailedCertifiedOrRegistered)
        and person_has_last_known_address(x);
    then notice_sufficient(s, x);
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "or, in the absence of a last known address, is left with the person summoned")
rule S7609SufficientLeftWithSummoned strict {
    for s: SummonsDoc;
    for x: Person;
    when notice_delivery_manner(s, x, LeftWithPersonSummonedWhenNoLastKnownAddress)
        and not_known(person_has_last_known_address(x));
    then notice_sufficient(s, x);
}
relation summons_identifies_taxpayer_and_locating_information(s: SummonsDoc) kind empirical {
    label en unofficial "the summons identifies the taxpayer to whom it relates or the other person to whom the records pertain and gives other information enabling the person summoned to locate the records";
}
@source(IRC_S7609_A, relation = formalizes, coverage = exact, quote = "shall identify the taxpayer to whom the summons relates or the other person to whom the records pertain and shall provide such other information as will enable the person summoned to locate the records required under the summons")
rule S7609SummonsContentDuty defeasible {
    for s: SummonsDoc;
    for x: Person;
    when s7609_notice_applies(s, x);
    then duty S7609SummonsIdentifiesPersonAndRecords {
        bearer Secretary;
        goal achievement {
            condition summons_identifies_taxpayer_and_locating_information(s);
            window [-infinity, infinity];
        }
    };
}

// --- §7609(b): intervention and proceeding to quash ------------------------------------------

relation person_intervenes_in_enforcement_proceeding(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the person entitled to notice intervenes in a section 7604 proceeding to enforce the summons";
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "shall have the right to intervene in any proceeding with respect to the enforcement of such summons under section 7604")
rule S7609InterventionLiberty defeasible {
    for s: SummonsDoc;
    for x: Person;
    when s7609_notice_applies(s, x)
        and person_intervenes_in_enforcement_proceeding(s, x);
    then liberty S7609InterveneInEnforcement {
        holder x;
        against Secretary;
        action person_intervenes_in_enforcement_proceeding(s, x);
        window [-infinity, infinity];
    };
}
relation petition_to_quash_begun_on(s: SummonsDoc, x: Person, d: Date) kind empirical {
    label en unofficial "the person entitled to notice begins a proceeding to quash the summons on this date";
}
relation quash_notice_date(s: SummonsDoc, x: Person, d: Date) kind empirical {
    label en unofficial "the date notice is given in the manner provided in subsection (a)(2)";
}
pub relation quash_proceeding_begun_in_time(s: SummonsDoc, x: Person) kind institutional {
    label en unofficial "a proceeding to quash begun not later than the 20th day after the notice date";
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "shall have the right to begin a proceeding to quash such summons not later than the 20th day after the day such notice is given in the manner provided in subsection (a)(2)")
rule S7609QuashPower strict {
    for s: SummonsDoc;
    for x: Person;
    for given: Date;
    for on: Date;
    when petition_to_quash_begun_on(s, x, on)
        and quash_notice_date(s, x, given)
        and s7609_notice_applies(s, x);
    then power S7609BeginQuashProceeding {
        holder x;
        over Secretary;
        exercise petition_to_quash_begun_on(s, x, on);
        valid_when quash_period_open(s, x);
        effect create(quash_proceeding_begun_in_time(s, x));
        window [given, add_calendar_period(given, 20 calendar_day)];
    };
}
relation quash_period_open(s: SummonsDoc, x: Person) kind derived {
    label en unofficial "the proceeding to quash begins on or before the 20th day after the notice date";
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "not later than the 20th day after the day such notice is given")
rule S7609QuashPeriod strict {
    for s: SummonsDoc;
    for x: Person;
    for given: Date;
    for on: Date;
    when petition_to_quash_begun_on(s, x, on)
        and quash_notice_date(s, x, given)
        and on <= add_calendar_period(given, 20 calendar_day);
    then quash_period_open(s, x);
}
relation petition_copy_mailed_to_summoned_and_secretary(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "the petitioner mails, by registered or certified mail, a copy of the petition to the person summoned and to the office the Secretary directs in the notice";
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "such person shall mail by registered or certified mail a copy of the petition to the person summoned and to such office as the Secretary may direct")
rule S7609PetitionCopyDuty defeasible {
    for s: SummonsDoc;
    for x: Person;
    for given: Date;
    for on: Date;
    when petition_to_quash_begun_on(s, x, on)
        and quash_notice_date(s, x, given);
    then duty S7609MailPetitionCopy {
        bearer x;
        beneficiary Secretary;
        goal achievement {
            condition petition_copy_mailed_to_summoned_and_secretary(s, x);
            window [on, add_calendar_period(given, 20 calendar_day)];
        }
    };
}
relation summoned_person_intervenes_in_quash_proceeding(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the person summoned intervenes in the proceeding to quash";
}
relation summoned_person_bound_by_quash_decision(s: SummonsDoc, p: Person) kind derived {
    label en unofficial "the person summoned is bound by the decision in the quash proceeding whether or not the person intervenes";
}
relation quash_proceeding_decided(s: SummonsDoc) kind empirical {
    label en unofficial "a decision is rendered in the proceeding to quash the summons";
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "the person summoned shall have the right to intervene in any proceeding under subparagraph (A)")
rule S7609SummonedInterventionLiberty defeasible {
    for s: SummonsDoc;
    for p: Person;
    when summons_directed_to(s, p)
        and summoned_person_intervenes_in_quash_proceeding(s, p);
    then liberty S7609SummonedPersonIntervenesInQuash {
        holder p;
        against Secretary;
        action summoned_person_intervenes_in_quash_proceeding(s, p);
        window [-infinity, infinity];
    };
}
@source(IRC_S7609_B, relation = formalizes, coverage = exact, quote = "Such person shall be bound by the decision in such proceeding (whether or not the person intervenes in such proceeding).")
rule S7609SummonedBound strict {
    for s: SummonsDoc;
    for p: Person;
    when summons_directed_to(s, p)
        and quash_proceeding_decided(s);
    then summoned_person_bound_by_quash_decision(s, p);
}

// --- §7609(d): restriction on examination --------------------------------------------------------

relation records_examined_on(s: SummonsDoc, d: Date) kind empirical {
    label en unofficial "the records required to be produced under the summons are examined on this date";
}
relation quash_begun_within_20_days_with_mailing_requirements_met(s: SummonsDoc, x: Person) kind empirical {
    label en unofficial "a proceeding under (b)(2)(A) was begun within the 20-day period and the (b)(2)(B) requirements have been met";
}
relation court_order_or_consent_permits_examination(s: SummonsDoc) kind empirical {
    label en unofficial "the examination is in accordance with an order of the court having jurisdiction, or with the consent of the person beginning the proceeding to quash";
}
relation examination_before_close_of_23rd_day(s: SummonsDoc) kind derived {
    label en unofficial "the records are examined before the close of the 23rd day after the notice was given";
}
relation examination_while_quash_pending(s: SummonsDoc) kind derived {
    label en unofficial "the records are examined while a timely quash proceeding (with the mailing requirements met) is pending, without court order or consent";
}
@source(IRC_S7609_D, relation = formalizes, coverage = exact, quote = "before the close of the 23rd day after the day notice with respect to the summons is given in the manner provided in subsection (a)(2)")
rule S7609ExaminationBefore23rdDay strict {
    for s: SummonsDoc;
    for x: Person;
    for given: Date;
    for on: Date;
    when s7609_notice_applies(s, x)
        and quash_notice_date(s, x, given)
        and records_examined_on(s, on)
        and days_between(given, on) <= 23;
    then examination_before_close_of_23rd_day(s);
}
@source(IRC_S7609_D, relation = formalizes, coverage = exact, quote = "where a proceeding under subsection (b)(2)(A) was begun within the 20-day period referred to in such subsection and the requirements of subsection (b)(2)(B) have been met, except in accordance with an order of the court having jurisdiction of such proceeding or with the consent of the person beginning the proceeding to quash")
rule S7609ExaminationWhileQuashPending strict {
    for s: SummonsDoc;
    for x: Person;
    for on: Date;
    when quash_begun_within_20_days_with_mailing_requirements_met(s, x)
        and records_examined_on(s, on)
        and not_known(court_order_or_consent_permits_examination(s));
    then examination_while_quash_pending(s);
}
@source(IRC_S7609_D, relation = formalizes, coverage = exact, quote = "No examination of any records required to be produced under a summons as to which notice is required under subsection (a) may be made—")
rule S7609ExaminationRestrictionBefore23 strict {
    for s: SummonsDoc;
    when examination_before_close_of_23rd_day(s);
    then prohibition S7609NoExaminationBefore23rdDay {
        bearer Secretary;
        action examination_before_close_of_23rd_day(s);
        window [-infinity, infinity];
    };
}
@source(IRC_S7609_D, relation = formalizes, coverage = exact, quote = "No examination of any records required to be produced under a summons as to which notice is required under subsection (a) may be made—")
rule S7609ExaminationRestrictionQuashPending strict {
    for s: SummonsDoc;
    when examination_while_quash_pending(s);
    then prohibition S7609NoExaminationWhileQuashPending {
        bearer Secretary;
        action examination_while_quash_pending(s);
        window [-infinity, infinity];
    };
}

// --- §7609(e): suspension of limitations --------------------------------------------------------------

relation person_took_action_under_7609b(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the person with respect to whose liability the summons is issued (or its agent, nominee or other person acting under its direction or control) takes action as provided in subsection (b)";
}
relation summons_enforcement_proceeding_pending_from(s: SummonsDoc, from: Date) kind empirical {
    label en unofficial "a proceeding, and appeals therein, with respect to enforcement of the summons is pending from this date";
}
relation summons_enforcement_proceeding_final_on(s: SummonsDoc, on: Date) kind empirical {
    label en unofficial "the proceeding, and appeals therein, is finally resolved on this date";
}
relation summons_response_final_resolution(s: SummonsDoc, on: Date) kind empirical {
    label en unofficial "the summoned party's response to the summons is finally resolved on this date";
}
relation taxpayer_of_summons(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the person with respect to whose liability the summons is issued";
}
pub relation summons_limitations_suspended(s: SummonsDoc, p: Person, from: Date, until: Date) kind institutional {
    label en unofficial "the running of any period of limitations under section 6501 or 6531 is suspended for the person from the first date until the second";
}
@source(IRC_S7609_E, relation = formalizes, coverage = exact, quote = "then the running of any period of limitations under section 6501 (relating to the assessment and collection of tax) or under section 6531 (relating to criminal prosecutions) with respect to such person shall be suspended for the period during which a proceeding, and appeals therein, with respect to the enforcement of such summons is pending")
rule S7609SuspensionOnTaxpayerAction strict {
    for s: SummonsDoc;
    for p: Person;
    for from: Date;
    for until: Date;
    when person_took_action_under_7609b(s, p)
        and summons_enforcement_proceeding_pending_from(s, from)
        and summons_enforcement_proceeding_final_on(s, until);
    then summons_limitations_suspended(s, p, from, until);
}
@source(IRC_S7609_E, relation = formalizes, coverage = exact, quote = "beginning on the date which is 6 months after the service of such summons")
rule S7609SuspensionAfterSixMonths strict {
    for s: SummonsDoc;
    for p: Person;
    for served: Date;
    for until: Date;
    when taxpayer_of_summons(s, p)
        and summons_served_on(s, served)
        and summons_response_final_resolution(s, until)
        and not_known(person_took_action_under_7609b(s, p))
        and until >= add_calendar_period(served, 6 calendar_month);
    then summons_limitations_suspended(s, p, add_calendar_period(served, 6 calendar_month), until);
}

// --- §7609(f), (g), (h): John Doe summons and special exception ---------------------------------------------

relation john_doe_summons_served(s: SummonsDoc) kind empirical {
    label en unofficial "a summons that does not identify the person with respect to whose liability it is issued is served";
}
relation court_found_particular_person_or_class(s: SummonsDoc) kind empirical {
    label en unofficial "the court proceeding establishes that the summons relates to the investigation of a particular person or ascertainable group or class of persons (§7609(f)(1))";
}
relation court_found_reasonable_basis_of_noncompliance(s: SummonsDoc) kind empirical {
    label en unofficial "the court proceeding establishes a reasonable basis for believing the person or group may fail or have failed to comply with an internal revenue law (§7609(f)(2))";
}
relation court_found_information_not_readily_available(s: SummonsDoc) kind empirical {
    label en unofficial "the court proceeding establishes that the information sought (and the identity of the persons) is not readily available from other sources (§7609(f)(3))";
}
relation john_doe_requirements_established(s: SummonsDoc) kind derived {
    label en unofficial "the Secretary established requirements (1)-(3) in a court proceeding";
}
@source(IRC_S7609_F, relation = formalizes, coverage = exact, quote = "may be served only after a court proceeding in which the Secretary establishes that—")
rule S7609JohnDoeRequirements strict {
    for s: SummonsDoc;
    when court_found_particular_person_or_class(s)
        and court_found_reasonable_basis_of_noncompliance(s)
        and court_found_information_not_readily_available(s);
    then john_doe_requirements_established(s);
}
relation john_doe_service_without_court_proceeding(s: SummonsDoc) kind derived {
    label en unofficial "a John Doe summons is served without the required court establishment";
}
@source(IRC_S7609_F, relation = formalizes, coverage = exact, quote = "Any summons described in subsection (c)(1) which does not identify the person with respect to whose liability the summons is issued may be served only after a court proceeding")
rule S7609JohnDoeWithoutProceeding strict {
    for s: SummonsDoc;
    when john_doe_summons_served(s)
        and not_known(john_doe_requirements_established(s));
    then john_doe_service_without_court_proceeding(s);
}
@source(IRC_S7609_F, relation = formalizes, coverage = exact, quote = "may be served only after a court proceeding in which the Secretary establishes that—")
rule S7609JohnDoeProhibition strict {
    for s: SummonsDoc;
    when john_doe_service_without_court_proceeding(s);
    then prohibition S7609NoJohnDoeServiceWithoutCourtProceeding {
        bearer Secretary;
        action john_doe_service_without_court_proceeding(s);
        window [-infinity, infinity];
    };
}
relation john_doe_information_narrowly_tailored(s: SummonsDoc) kind empirical {
    label en unofficial "the information sought is narrowly tailored to information pertaining to the failure or potential failure of the person or group or class to comply with identified provisions of internal revenue law";
}
relation john_doe_summons_issued_not_narrowly_tailored(s: SummonsDoc) kind derived {
    label en unofficial "a John Doe summons is issued whose information sought is not narrowly tailored";
}
@source(IRC_S7609_F, relation = formalizes, coverage = exact, quote = "The Secretary shall not issue any summons described in the preceding sentence unless the information sought to be obtained is narrowly tailored")
rule S7609JohnDoeNotTailored strict {
    for s: SummonsDoc;
    when john_doe_summons_served(s)
        and not_known(john_doe_information_narrowly_tailored(s));
    then john_doe_summons_issued_not_narrowly_tailored(s);
}
@source(IRC_S7609_F, relation = formalizes, coverage = exact, quote = "The Secretary shall not issue any summons described in the preceding sentence unless the information sought to be obtained is narrowly tailored to information that pertains to the failure (or potential failure) of the person or group or class of persons referred to in paragraph (2) to comply with one or more provisions of the internal revenue law which have been identified for purposes of such paragraph.")
rule S7609JohnDoeTailoringProhibition strict {
    for s: SummonsDoc;
    when john_doe_summons_issued_not_narrowly_tailored(s);
    then prohibition S7609NoJohnDoeSummonsNotNarrowlyTailored {
        bearer Secretary;
        action john_doe_summons_issued_not_narrowly_tailored(s);
        window [-infinity, infinity];
    };
}
external judgment relation reasonable_cause_notice_may_lead_to_concealment_or_flight(s: SummonsDoc) {
    authority DistrictCourt;
    label en unofficial "there is reasonable cause to believe the giving of notice may lead to attempts to conceal, destroy, or alter records, to prevent communication of information from other persons through intimidation, bribery, or collusion, or to flee (§7609(g))";
}
relation secretary_petitions_for_special_exception(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary petitions the court to determine that the summons is described in subsection (g)";
}
pub relation special_exception_summons_determined(s: SummonsDoc) kind institutional {
    label en unofficial "the court has determined that the summons is one described in subsection (g), to which the notice of (a) does not apply";
}
@source(IRC_S7609_G, relation = formalizes, coverage = exact, quote = "A summons is described in this subsection if, upon petition by the Secretary, the court determines, on the basis of the facts and circumstances alleged, that there is reasonable cause to believe")
rule S7609SpecialExceptionPower strict {
    for s: SummonsDoc;
    when secretary_petitions_for_special_exception(s);
    then power S7609DetermineSpecialException {
        holder DistrictCourt;
        over s;
        exercise secretary_petitions_for_special_exception(s);
        valid_when reasonable_cause_notice_may_lead_to_concealment_or_flight(s);
        effect create(special_exception_summons_determined(s));
    };
}
relation proceeding_under_b2_f_or_g_in_district_of_person_summoned(s: SummonsDoc) kind empirical {
    label en unofficial "the proceeding under subsection (b)(2), (f) or (g) is brought in the district where the person to be summoned resides or is found";
}
pub relation district_court_has_7609_jurisdiction(s: SummonsDoc) kind institutional {
    label en unofficial "the district court has jurisdiction to hear and determine the proceeding under §7609(b)(2), (f) or (g); an order denying the petition is a final appealable order";
}
@source(IRC_S7609_H, relation = formalizes, coverage = exact, quote = "The United States district court for the district within which the person to be summoned resides or is found shall have jurisdiction to hear and determine any proceeding brought under subsection (b)(2), (f), or (g).")
rule S7609Jurisdiction strict {
    for s: SummonsDoc;
    when proceeding_under_b2_f_or_g_in_district_of_person_summoned(s);
    then district_court_has_7609_jurisdiction(s);
}
relation determination_made_ex_parte_on_petition_and_affidavits(s: SummonsDoc) kind empirical {
    label en unofficial "the determinations under subsections (f) and (g) are made ex parte and solely on the petition and supporting affidavits";
}
@source(IRC_S7609_H, relation = formalizes, coverage = exact, quote = "The determinations required to be made under subsections (f) and (g) shall be made ex parte and shall be made solely on the petition and supporting affidavits.")
rule S7609ExParteDuty defeasible {
    for s: SummonsDoc;
    when secretary_petitions_for_special_exception(s);
    then duty S7609DecideExParteOnPetitionAndAffidavits {
        bearer DistrictCourt;
        goal maintenance {
            condition determination_made_ex_parte_on_petition_and_affidavits(s);
            window [-infinity, infinity];
        }
    };
}

// --- §7609(i), (j): duty and protection of summoned party --------------------------------------------------------

relation records_assembled_and_ready_to_produce(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned party assembles the records requested (or the portion the Secretary prescribes) and is prepared to produce them on the day fixed";
}
relation summons_for_records_received_by(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned party receives a summons to which section 7609 applies for the production of records";
}
@source(IRC_S7609_I, relation = formalizes, coverage = exact, quote = "the summoned party shall proceed to assemble the records requested, or such portion thereof as the Secretary may prescribe, and shall be prepared to produce the records pursuant to the summons on the day on which the records are to be examined")
rule S7609AssembleRecordsDuty defeasible {
    for s: SummonsDoc;
    for p: Person;
    when summons_for_records_received_by(s, p)
        and s7609_summons_applies(s);
    then duty S7609AssembleAndProduceRecords {
        bearer p;
        beneficiary Secretary;
        goal maintenance {
            condition records_assembled_and_ready_to_produce(s, p);
            window [-infinity, infinity];
        }
    };
}
relation s7609_summons_applies(s: SummonsDoc) kind derived {
    label en unofficial "the summons is one to which section 7609 applies (a notice is required for some person)";
}
@source(IRC_S7609_C, relation = formalizes, coverage = exact, quote = "this section shall apply to any summons issued under paragraph (2) of section 7602(a) or under section 6420(e)(2), 6421(g)(2), 6427(j)(2), or 7612")
rule S7609SummonsAppliesDerived strict {
    for s: SummonsDoc;
    for x: Person;
    when s7609_notice_applies(s, x);
    then s7609_summons_applies(s);
}
relation secretary_certifies_quash_period_expired_or_consent(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary issues the summoned party a certificate that the period to begin a proceeding to quash has expired and none began, or that the taxpayer consents to the examination";
}
relation certificate_condition_expired_or_consented(s: SummonsDoc) kind empirical {
    label en unofficial "the quash period has expired without a proceeding, or the taxpayer consents to the examination";
}
pub relation quash_certificate_issued(s: SummonsDoc) kind institutional {
    label en unofficial "a certificate of the Secretary to the summoned party under §7609(i)(2) is validly issued";
}
@source(IRC_S7609_I, relation = formalizes, coverage = exact, quote = "The Secretary may issue a certificate to the summoned party that the period prescribed for beginning a proceeding to quash a summons has expired and that no such proceeding began within such period, or that the taxpayer consents to the examination.")
rule S7609CertificatePower strict {
    for s: SummonsDoc;
    for p: Person;
    when secretary_certifies_quash_period_expired_or_consent(s)
        and summons_directed_to(s, p);
    then power S7609IssueCertificate {
        holder Secretary;
        over p;
        exercise secretary_certifies_quash_period_expired_or_consent(s);
        valid_when certificate_condition_expired_or_consented(s);
        effect create(quash_certificate_issued(s));
    };
}
relation summoned_party_disclosed_in_good_faith_reliance(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned party, or its agent or employee, discloses records or testimony pursuant to the section in good faith reliance on the Secretary's certificate or a court order";
}
pub relation summoned_party_not_liable_for_disclosure(s: SummonsDoc, p: Person) kind institutional {
    label en unofficial "the summoned party is not liable to any customer or other person for the disclosure made in good faith reliance on the certificate or court order (§7609(i)(3))";
}
@source(IRC_S7609_I, relation = formalizes, coverage = exact, quote = "Any summoned party, or agent or employee thereof, making a disclosure of records or testimony pursuant to this section in good faith reliance on the certificate of the Secretary or an order of a court requiring production of records or the giving of such testimony shall not be liable to any customer or other person for such disclosure.")
rule S7609GoodFaithImmunity strict {
    for s: SummonsDoc;
    for p: Person;
    when summoned_party_disclosed_in_good_faith_reliance(s, p);
    then immunity S7609SummonedPartyNoLiability {
        holder p;
        protected_effect summoned_party_not_liable_for_disclosure(s, p);
        window [-infinity, infinity];
    };
}
relation john_doe_summons_period_suspended_under_e2(s: SummonsDoc) kind empirical {
    label en unofficial "a period of limitations has been suspended under subsection (e)(2) with respect to a John Doe summons";
}
relation summoned_party_gives_notice_of_suspension(s: SummonsDoc, p: Person) kind empirical {
    label en unofficial "the summoned party gives notice of the suspension to any person described in subsection (f)";
}
@source(IRC_S7609_I, relation = formalizes, coverage = exact, quote = "the summoned party shall provide notice of such suspension to any person described in subsection (f)")
rule S7609JohnDoeSuspensionNoticeDuty defeasible {
    for s: SummonsDoc;
    for p: Person;
    when john_doe_summons_period_suspended_under_e2(s)
        and summons_directed_to(s, p);
    then duty S7609NotifyOfJohnDoeSuspension {
        bearer p;
        goal achievement {
            condition summoned_party_gives_notice_of_suspension(s, p);
            window [-infinity, infinity];
        }
    };
}

// --- §7612: computer software source code --------------------------------------------------------------------------------

relation summons_seeks_tax_related_source_code(s: SummonsDoc) kind empirical {
    label en unofficial "the summons seeks to produce or analyze tax-related computer software source code";
}
relation secretary_unable_to_ascertain_item_otherwise(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary is unable to otherwise reasonably ascertain the correctness of an item on a return from the taxpayer's books or from the executable code and associated data";
}
relation secretary_identifies_source_code_portion_with_specificity(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary identifies with reasonable specificity the portion, item or component of the source code needed";
}
relation secretary_determines_need_outweighs_disclosure_risk(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary determines that the need for the portion outweighs the risks of unauthorized disclosure of trade secrets";
}
relation source_code_offense_inquiry(s: SummonsDoc) kind empirical {
    label en unofficial "the summons is an inquiry into an offense connected with the administration or enforcement of the internal revenue laws";
}
relation source_code_for_internal_use_only(s: SummonsDoc) kind empirical {
    label en unofficial "the source code was acquired or developed by the taxpayer or a related person primarily for internal use rather than commercial distribution";
}
relation source_code_communications_owner_taxpayer(s: SummonsDoc) kind empirical {
    label en unofficial "the summons seeks communications between the owner of the source code and the taxpayer or related persons";
}
relation source_code_required_by_other_provision(s: SummonsDoc) kind empirical {
    label en unofficial "the source code is required to be provided or made available by another provision of this title";
}
relation secretary_determined_not_feasible_without_executable_code(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary determines that it is not feasible to determine the correctness of an item without the executable code and associated data (§7612(b)(3)(A))";
}
relation secretary_formally_requested_code_and_data(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary made a formal request to the taxpayer for the executable code and data and to the owner of the source code for the executable code (§7612(b)(3)(B))";
}
relation code_and_data_provided_within_180_days(s: SummonsDoc) kind empirical {
    label en unofficial "the code and data are provided within 180 days of the request";
}
relation secretary_treated_as_meeting_a_and_b_by_cooperation_failure(s: SummonsDoc) kind derived {
    label en unofficial "the Secretary is treated as meeting (b)(1)(A) and (B) because the code and data were not provided within 180 days of the formal request";
}
relation source_code_summons_exception_conditions_met(s: SummonsDoc) kind derived {
    label en unofficial "the (b)(1) conditions (A)-(C) are met, or an exception of (b)(2) applies";
}
relation source_code_summons_issued(s: SummonsDoc) kind empirical {
    label en unofficial "the Secretary issues the summons for tax-related source code, or begins a section 7604 action to enforce it";
}
relation source_code_summons_without_authority(s: SummonsDoc) kind derived {
    label en unofficial "a summons for tax-related computer software source code is issued or enforced without meeting the (b) conditions";
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "the Secretary determines that it is not feasible to determine the correctness of an item without access to the computer software executable code and associated data described in paragraph (1)(A)(ii)")
rule S7612CooperationFailure strict {
    for s: SummonsDoc;
    when secretary_determined_not_feasible_without_executable_code(s)
        and secretary_formally_requested_code_and_data(s)
        and not_known(code_and_data_provided_within_180_days(s));
    then secretary_treated_as_meeting_a_and_b_by_cooperation_failure(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "the Secretary is unable to otherwise reasonably ascertain the correctness of any item on a return from—")
rule S7612ConditionsMetDirectly strict {
    for s: SummonsDoc;
    when secretary_unable_to_ascertain_item_otherwise(s)
        and secretary_identifies_source_code_portion_with_specificity(s)
        and secretary_determines_need_outweighs_disclosure_risk(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "the Secretary shall be treated as meeting the requirements of subparagraphs (A) and (B) of such paragraph if—")
rule S7612ConditionsMetByCooperationFailure strict {
    for s: SummonsDoc;
    when secretary_treated_as_meeting_a_and_b_by_cooperation_failure(s)
        and secretary_determines_need_outweighs_disclosure_risk(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "any inquiry into any offense connected with the administration or enforcement of the internal revenue laws")
rule S7612ExceptionOffense strict {
    for s: SummonsDoc;
    when source_code_offense_inquiry(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "any tax-related computer software source code acquired or developed by the taxpayer or a related person primarily for internal use by the taxpayer or such person rather than for commercial distribution")
rule S7612ExceptionInternalUse strict {
    for s: SummonsDoc;
    when source_code_for_internal_use_only(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "any communications between the owner of the tax-related computer software source code and the taxpayer or related persons")
rule S7612ExceptionCommunications strict {
    for s: SummonsDoc;
    when source_code_communications_owner_taxpayer(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "any tax-related computer software source code which is required to be provided or made available pursuant to any other provision of this title")
rule S7612ExceptionOtherProvision strict {
    for s: SummonsDoc;
    when source_code_required_by_other_provision(s);
    then source_code_summons_exception_conditions_met(s);
}
@source(IRC_S7612_A, relation = formalizes, coverage = exact, quote = "no summons may be issued under this title, and the Secretary may not begin any action under section 7604 to enforce any summons to produce or analyze any tax-related computer software source code")
rule S7612WithoutAuthority strict {
    for s: SummonsDoc;
    when summons_seeks_tax_related_source_code(s)
        and source_code_summons_issued(s)
        and not_known(source_code_summons_exception_conditions_met(s));
    then source_code_summons_without_authority(s);
}
@source(IRC_S7612_A, relation = formalizes, coverage = exact, quote = "no summons may be issued under this title, and the Secretary may not begin any action under section 7604 to enforce any summons to produce or analyze any tax-related computer software source code")
rule S7612SourceCodeProhibition strict {
    for s: SummonsDoc;
    when source_code_summons_without_authority(s);
    then prohibition S7612NoSourceCodeSummonsWithoutConditions {
        bearer Secretary;
        action source_code_summons_without_authority(s);
        window [-infinity, infinity];
    };
}
relation party_requests_hearing_on_b_requirements(s: SummonsDoc) kind empirical {
    label en unofficial "in a section 7604 proceeding on a §7612 summons, a party requests a hearing on whether the applicable requirements of subsection (b) have been met";
}
relation court_holds_hearing_on_b_requirements(s: SummonsDoc) kind empirical {
    label en unofficial "the court holds the hearing";
}
@source(IRC_S7612_B, relation = formalizes, coverage = exact, quote = "the court shall, at the request of any party, hold a hearing to determine whether the applicable requirements of this subsection have been met")
rule S7612HearingDuty defeasible {
    for s: SummonsDoc;
    when party_requests_hearing_on_b_requirements(s);
    then duty S7612CourtHoldsHearingOnRequirements {
        bearer DistrictCourt;
        goal achievement {
            condition court_holds_hearing_on_b_requirements(s);
            window [-infinity, infinity];
        }
    };
}
relation court_issues_protective_order(s: SummonsDoc) kind empirical {
    label en unofficial "in a court proceeding to enforce a summons for software the court receives evidence and issues an order necessary to prevent disclosure of trade secrets or confidential information, including sealing";
}
relation court_proceeding_to_enforce_software_summons(s: SummonsDoc) kind empirical {
    label en unofficial "there is a court proceeding to enforce a summons for any portion of software";
}
pub relation software_protective_order_authorized(s: SummonsDoc) kind institutional {
    label en unofficial "the court's protective order is authorized under §7612(c)(1)";
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the court may receive evidence and issue any order necessary to prevent the disclosure of trade secrets or other confidential information with respect to such software")
rule S7612ProtectiveOrderPower strict {
    for s: SummonsDoc;
    when court_issues_protective_order(s);
    then power S7612IssueProtectiveOrder {
        holder DistrictCourt;
        over s;
        exercise court_issues_protective_order(s);
        valid_when court_proceeding_to_enforce_software_summons(s);
        effect create(software_protective_order_authorized(s));
    };
}

// (c)(2) safeguards for software in the Secretary's possession
entity SoftwareInPossession {
    label en unofficial "software that comes into the possession or control of the Secretary in the course of an examination of a taxpayer";
}
relation software_used_for_other_purpose(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software is used for a purpose outside (c)(2)(A)";
}
relation advance_list_of_analysts_provided(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the Secretary provided the taxpayer and the owner, in advance, a written list of the names of all individuals who will analyze or have access to the software";
}
relation software_kept_in_secure_area_and_source_code_not_removed(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software is kept in a secure area or place and source code is not removed from the owner's place of business unless the owner permits or a court orders";
}
relation software_copied_beyond_necessary_analysis(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software is copied other than as necessary to perform the analysis";
}
relation copies_numbered_and_certified_in_writing(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the Secretary numbers all copies made and certifies in writing that no other copies have been or will be made";
}
relation permitted_use_period_ended(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the period during which the software may be used under (c)(2)(A) has ended";
}
relation software_and_copies_returned_and_deleted(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software and all copies are returned to the person from whom they were obtained and copies on hard drives are permanently deleted";
}
relation written_perjury_certification_from_each_analyst_obtained(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the Secretary obtains from each person who analyzed or had access a written certification under penalty of perjury that all copies and materials were returned and none copied";
}
relation software_decompiled_or_disassembled(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software is decompiled or disassembled";
}
relation non_employee_analyst_engaged(sw: SoftwareInPossession) kind empirical {
    label en unofficial "a person who is not an officer or employee of the United States will analyze or have access to the software";
}
relation written_nondisclosure_agreement_provided(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the Secretary provides the taxpayer and the interest owner a written agreement in which the non-employee agrees not to disclose to persons other than those permitted under section 6103 and not to participate for 2 years in developing similar software";
}
relation software_in_secretary_possession(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the software has come into the possession or control of the Secretary in the course of an examination of a taxpayer";
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software may be used only in connection with the examination of such taxpayer's return, any appeal by the taxpayer to the Internal Revenue Service Independent Office of Appeals")
rule S7612UseLimitProhibition strict {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and software_used_for_other_purpose(sw);
    then prohibition S7612NoUseOutsidePermittedPurposes {
        bearer Secretary;
        action software_used_for_other_purpose(sw);
        window [-infinity, infinity];
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the Secretary shall provide, in advance, to the taxpayer and the owner of the software a written list of the names of all individuals who will analyze or otherwise have access to the software")
rule S7612AdvanceListDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw);
    then duty S7612ProvideAdvanceListOfAnalysts {
        bearer Secretary;
        goal achievement {
            condition advance_list_of_analysts_provided(sw);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software shall be maintained in a secure area or place, and, in the case of computer software source code, shall not be removed from the owner's place of business unless the owner permits, or a court orders, such removal")
rule S7612SecureAreaDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw);
    then duty S7612KeepSoftwareSecure {
        bearer Secretary;
        goal maintenance {
            condition software_kept_in_secure_area_and_source_code_not_removed(sw);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software may not be copied except as necessary to perform such analysis")
rule S7612CopyLimitProhibition strict {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and software_copied_beyond_necessary_analysis(sw);
    then prohibition S7612NoCopyingBeyondNecessaryAnalysis {
        bearer Secretary;
        action software_copied_beyond_necessary_analysis(sw);
        window [-infinity, infinity];
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the Secretary shall number all copies made and certify in writing that no other copies have been (or will be) made")
rule S7612NumberAndCertifyCopiesDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw);
    then duty S7612NumberAndCertifyCopies {
        bearer Secretary;
        goal maintenance {
            condition copies_numbered_and_certified_in_writing(sw);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software and all copies thereof shall be returned to the person from whom they were obtained and any copies thereof made under subparagraph (D) on the hard drive of a machine or other mass storage device shall be permanently deleted")
rule S7612ReturnAndDeleteDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and permitted_use_period_ended(sw);
    then duty S7612ReturnAndDeleteSoftware {
        bearer Secretary;
        goal achievement {
            condition software_and_copies_returned_and_deleted(sw);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the Secretary shall obtain from any person who analyzes or otherwise had access to such software a written certification under penalty of perjury that all copies and related materials have been returned and that no copies were made of them")
rule S7612PerjuryCertificationDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and permitted_use_period_ended(sw);
    then duty S7612ObtainPerjuryCertification {
        bearer Secretary;
        goal achievement {
            condition written_perjury_certification_from_each_analyst_obtained(sw);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software may not be decompiled or disassembled")
rule S7612NoDecompilingProhibition strict {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and software_decompiled_or_disassembled(sw);
    then prohibition S7612NoDecompilingOrDisassembly {
        bearer Secretary;
        action software_decompiled_or_disassembled(sw);
        window [-infinity, infinity];
    };
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the Secretary shall provide to the taxpayer and the owner of any interest in such software, as the case may be, a written agreement, between the Secretary and any person who is not an officer or employee of the United States")
rule S7612AgreementDuty defeasible {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw)
        and non_employee_analyst_engaged(sw);
    then duty S7612ProvideNondisclosureAgreement {
        bearer Secretary;
        goal achievement {
            condition written_nondisclosure_agreement_provided(sw);
            window [-infinity, infinity];
        }
    };
}
pub relation software_is_return_information(sw: SoftwareInPossession) kind institutional {
    label en unofficial "the software is treated as return information for purposes of section 6103 (§7612(c)(2)(H))";
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the software shall be treated as return information for purposes of section 6103")
rule S7612ReturnInformation strict {
    for sw: SoftwareInPossession;
    when software_in_secretary_possession(sw);
    then software_is_return_information(sw);
}
relation owner_makes_equipment_available_for_onsite_analysis(sw: SoftwareInPossession) kind empirical {
    label en unofficial "the owner makes available any necessary equipment or materials for analysis of source code required to be conducted on the owner's premises";
}
relation source_code_analysis_on_owner_premises(sw: SoftwareInPossession, owner: Person) kind empirical {
    label en unofficial "analysis of the source code is required to be conducted on the owner's premises";
}
@source(IRC_S7612_C, relation = formalizes, coverage = exact, quote = "the owner shall make available any necessary equipment or materials for analysis of computer software source code required to be conducted on the owner's premises")
rule S7612OwnerEquipmentDuty defeasible {
    for sw: SoftwareInPossession;
    for owner: Person;
    when source_code_analysis_on_owner_premises(sw, owner);
    then duty S7612OwnerMakesEquipmentAvailable {
        bearer owner;
        beneficiary Secretary;
        goal maintenance {
            condition owner_makes_equipment_available_for_onsite_analysis(sw);
            window [-infinity, infinity];
        }
    };
}
