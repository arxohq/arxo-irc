// Administration -- final TECH_GAP pass (26.09.2026, DECISION-0379, implemented_unverified): sections 7528(b)(2)(C)(iii) (G6892)
// and 7874(d)(2) (G6893).
//
// SECTION 7528(b)(2)(C)(iii): the average fee is taken over the requests of the category WITHOUT the requests exempted under (B). The
// exempt classification `exempt_small_plan_request` is DERIVED (defeasible, two defeaters); the sum and the count use a
// `not_known` over it inside the generator (the exempt requests are exactly the established ones), so no request that stands
// as exempt is taken into account. The per-request fees are case facts; the earlier asserted `average_fee_charged` stays the channel
// used when no per-request fee is supplied.
//
// SECTION 7874(d)(2): the inversion gain of a year is the sum of the income or gain of the items that QUALIFY (the derived
// `qualifying_inversion_item`, strict) dated inside the taxable year; the amounts of the items are case facts. The asserted
// `inversion_gain_for_year` stays the channel used when no item amount is supplied. JUDGMENT CALL: an aggregate over a
// derived (strict) relation; the year is delimited by the dates of `begins`/`ends` of core.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7528_B,
    IRC_S7874_D,
    InversionItem,
    Person,
    TaxableYear,
    UserFeeCategory,
    UserFeeRequest,
    average_fee_charged,
    exempt_small_plan_request,
    expatriated_entity,
    inversion_gain_for_year,
    item_date,
    item_of_entity,
    qualifying_inversion_item,
    year_includes_applicable_period_portion,
};

relation fee_charged_for_request(r: UserFeeRequest, c: UserFeeCategory, fee: Money) kind empirical {
    label en unofficial "the fee charged under the program for the request, which is in the category (case fact per request)";
}
relation average_fee_charged_excluding_exempt(c: UserFeeCategory, avg: Money) kind derived {
    label en unofficial "the average of the fees charged for the requests of the category, not taking into account the requests exempted under section 7528(b)(2)(B); cents HALF_UP";
}
@source(IRC_S7528_B, relation = formalizes, coverage = exact, quote = "For purposes of any determination of average fees charged, any request to which subparagraph (B) applies shall not be taken into account.")
rule S7528AverageFeeExcludingExempt defeasible {
    for c: UserFeeCategory;
    for r0: UserFeeRequest;
    for f0: Money;
    when fee_charged_for_request(r0, c, f0)
        and count(collect all r1: UserFeeRequest, f1: Money where fee_charged_for_request(r1, c, f1) and not_known(exempt_small_plan_request(r1))) > 0;
    then average_fee_charged_excluding_exempt(c, div_round(sum(collect all f2: Money, r2: UserFeeRequest where fee_charged_for_request(r2, c, f2) and not_known(exempt_small_plan_request(r2)), empty: 0.00 USD), count(collect all r3: UserFeeRequest, f3: Money where fee_charged_for_request(r3, c, f3) and not_known(exempt_small_plan_request(r3))) * 1.0, 2, "HALF_UP"));
}
relation has_average_fee_excluding_exempt(c: UserFeeCategory) kind derived {
    label en unofficial "bridge for the absence test";
}
rule S7528HasAverageFeeExcludingExempt defeasible {
    for c: UserFeeCategory;
    for avg: Money;
    when average_fee_charged_excluding_exempt(c, avg);
    then has_average_fee_excluding_exempt(c);
}
relation average_fee_for_floor_test(c: UserFeeCategory, avg: Money) kind derived {
    label en unofficial "the average fee the floor test reads: the average computed over the non-exempt requests where the per-request fees are supplied, else the asserted average";
}
rule S7528AverageFeeForFloorTestComputed defeasible {
    for c: UserFeeCategory;
    for avg: Money;
    when average_fee_charged_excluding_exempt(c, avg);
    then average_fee_for_floor_test(c, avg);
}
rule S7528AverageFeeForFloorTestAsserted defeasible {
    for c: UserFeeCategory;
    for avg: Money;
    when average_fee_charged(c, avg)
        and not_known(has_average_fee_excluding_exempt(c));
    then average_fee_for_floor_test(c, avg);
}

// ---- section 7874(d)(2) ----

relation item_income_or_gain(t: InversionItem, amt: Money) kind empirical {
    label en unofficial "the income or gain recognized by reason of the transfer, or the income received or accrued by reason of the license (section 7874(d)(2)) — case fact per item";
}
relation inversion_gain_computed(x: Person, y: TaxableYear, amt: Money) kind institutional {
    label en unofficial "the inversion gain of the entity for the year: the sum of the income and gain of the qualifying items dated in the taxable year";
}
@source(IRC_S7874_D, relation = formalizes, coverage = exact, quote = "The term \"inversion gain\" means the income or gain recognized by reason of the transfer during the applicable period of stock or other properties by an expatriated entity, and any income received or accrued during the applicable period by reason of a license of any property by an expatriated entity—")
rule S7874InversionGainComputed strict {
    for x: Person;
    for y: TaxableYear;
    for b: Date;
    for e: Date;
    for t0: InversionItem;
    when expatriated_entity(x)
        and year_includes_applicable_period_portion(x, y)
        and us.irc.core::begins(y, b)
        and us.irc.core::ends(y, e)
        and item_of_entity(t0, x);
    then inversion_gain_computed(x, y, sum(collect all a: Money, t: InversionItem, dt: Date where item_of_entity(t, x) and qualifying_inversion_item(t) and item_income_or_gain(t, a) and item_date(t, dt) and dt >= b and dt <= e, empty: 0.00 USD));
}
relation has_inversion_gain_computed(x: Person, y: TaxableYear) kind institutional {
    label en unofficial "bridge for the absence test";
}
rule S7874HasInversionGainComputed strict {
    for x: Person;
    for y: TaxableYear;
    for g: Money;
    when inversion_gain_computed(x, y, g);
    then has_inversion_gain_computed(x, y);
}
relation inversion_gain_of_year(x: Person, y: TaxableYear, amt: Money) kind institutional {
    label en unofficial "the inversion gain the floor, the credit ceiling and the source rule read: computed from the items where an item is supplied, else asserted";
}
rule S7874InversionGainOfYearComputed strict {
    for x: Person;
    for y: TaxableYear;
    for g: Money;
    when inversion_gain_computed(x, y, g);
    then inversion_gain_of_year(x, y, g);
}
rule S7874InversionGainOfYearAsserted strict {
    for x: Person;
    for y: TaxableYear;
    for g: Money;
    when inversion_gain_for_year(x, y, g)
        and not_known(has_inversion_gain_computed(x, y));
    then inversion_gain_of_year(x, y, g);
}
