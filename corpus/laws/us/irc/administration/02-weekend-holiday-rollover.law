// 26 U.S.C. §7503 — Time for performance of acts where the last day falls on
// Saturday, Sunday, or a legal holiday.
//
// CALENDAR RESOURCE (per task instructions). Weekend detection is COMPUTED:
// `weekday_of(d)` (§84, ISO numbering 1=Monday..7=Sunday) needs no §85
// business-day snapshot at all (established idiom: `corpus/laws/kz/laws/
// collectors/03-pravila-vzaimodeystviya.law`). The "legal holiday in the
// District of Columbia" half of the calendar is now PARTIALLY computed:
// WIRE-1 (25.09.2026, DECISION D-08) added `pub` to `us.code.
// federal_holidays::Holiday`/`observed_holiday_on` and wired the import
// here (see `LegalHolidayInDcFromFederalCalendar` below). That package
// pins ONLY the 2026 calendar (`corpus/laws/us/federal-holidays/02-
// holidays.law`), so `legal_holiday_in_dc(d)` stays declared `empirical`
// for a case to assert directly for any OTHER year; the new derived
// relation `legal_holiday_in_dc_per_federal_calendar(d)` supplies the
// SAME fact for a 2026 date without requiring the case to assert it, and
// `S7503IsBusinessDay` excludes a date if EITHER source says it is a
// holiday.
//
// TECH_GAP (declared, not worked around): the language's closed computable
// surface (§58/§86) has no "next calendar day" step that does not require a
// §85 business-day snapshot — `add_calendar_period`/`add_business_days` with
// a `calendar_day` unit are the SAME ambiguous unit family and read the
// snapshot regardless (errata E-0029/E-0109; see `corpus/laws/us/
// constitution/01-congress.law`'s identical finding for the Article I §7
// "within ten Days (Sundays excepted)" veto clause, which hit the same wall).
// Registering a real business-day snapshot derived from `us.code.
// federal_holidays` is the `gen_kz_clir.py`-family generator step the
// AGENT-BRIEF forbids in this stage (heavy, refreshes consumers, and belongs
// to whoever runs the integration step, not a single-package agent). So:
// the FACT that `base` falls on a weekend or a legal holiday is computed;
// the ROLLED-FORWARD date itself is validated, not computed — a case (or a
// consumer package) supplies a candidate `rolled` date and this package's
// rule confirms it is (a) strictly after `base`, (b) itself a business day,
// and (c) that no earlier day in between was a business day is NOT checked
// (no bounded quantifier over dates is available either) — so a caller that
// supplies a `rolled` date more than one non-business run ahead of the true
// next business day is not caught by this package alone. This is the
// TECH_GAP row for §7503 in the coverage report.

language "law.core" version "0.2";
package us.irc.administration version "0.1.1";
namespace "urn:us:irc:administration:clir";

use self::{
    IRC_S7503,
    Organ,
};

// --- Weekend and legal-holiday detection (computed) --------------------------

relation falls_on_weekend(d: Date) kind derived {
    label en unofficial "the date is a Saturday or a Sunday";
}
@source(IRC_S7503, relation = formalizes, coverage = partial, quote = "Saturday, Sunday, or a legal holiday")
rule S7503FallsOnSaturday(d: Date) defeasible {
    when day_in_question(d);
    when weekday_of(d) == 6;
    then falls_on_weekend(d);
}
@source(IRC_S7503, relation = formalizes, coverage = partial, quote = "Saturday, Sunday, or a legal holiday")
rule S7503FallsOnSunday(d: Date) defeasible {
    when day_in_question(d);
    when weekday_of(d) == 7;
    then falls_on_weekend(d);
}

relation day_in_question(d: Date) kind empirical {
    label en unofficial "the date whose calendar status (weekend/business day) is at issue in the case; needed because `weekday_of` cannot bind a rule head variable on its own (§190)";
}

// A legal holiday in the District of Columbia (§7503's own default).
//
// Case-asserted fallback for any year OUTSIDE the imported calendar's 2026
// snapshot (kept `empirical` on purpose — WIRE-1 did not remove this, only
// added the computed source below, so every scenario already asserting this
// relation directly keeps working unchanged).
relation legal_holiday_in_dc(d: Date) kind empirical {
    label en unofficial "the date is a legal holiday in the District of Columbia (case-asserted fallback for a year outside `us.code.federal_holidays`'s pinned 2026 snapshot)";
}

// The SAME fact, COMPUTED from `us.code.federal_holidays` (5 U.S.C. §6103)
// for the year it actually pins (2026) — WIRE-1 (25.09.2026, DECISION D-08).
relation legal_holiday_in_dc_per_federal_calendar(d: Date) kind derived {
    label en unofficial "the date is a legal holiday in the District of Columbia per the imported 5 U.S.C. §6103 calendar (`us.code.federal_holidays`, 2026 snapshot only)";
}
@source(IRC_S7503, relation = formalizes, coverage = contextual, quote = "Saturday, Sunday, or a legal holiday")
rule S7503LegalHolidayInDcFromFederalCalendar(d: Date) defeasible {
    when day_in_question(d)
        and count(collect h: us.code.federal_holidays::Holiday
                   where us.code.federal_holidays::observed_holiday_on(h, d)) > 0;
    then legal_holiday_in_dc_per_federal_calendar(d);
}

// §7503's own extension: a Statewide legal holiday, for an office located
// outside the District of Columbia but within an internal revenue district.
// No Statewide-holiday calendar is pinned anywhere in this corpus; the case
// must assert this directly. EXTERNAL_DEPENDENCY (no source package exists
// to import for the 50 States' own holiday calendars).
relation office_outside_dc_within_internal_revenue_district(office: Organ) kind empirical {
    label en unofficial "the office at which the act is required to be performed is located outside the District of Columbia but within an internal revenue district (§7503's State-holiday clause gate)";
}
relation statewide_legal_holiday(office: Organ, d: Date) kind empirical {
    label en unofficial "the date is a Statewide legal holiday in the State where the named office is located (asserted directly — no Statewide holiday calendar is pinned in this corpus; EXTERNAL_DEPENDENCY)";
}
relation legal_holiday_for_office(office: Organ, d: Date) kind institutional {
    label en unofficial "the date is a §7503 \"legal holiday\" for an act required to be performed at this office";
}
@source(IRC_S7503, relation = formalizes, coverage = partial, quote = "the term \"legal holiday\" also means a Statewide legal holiday in the State where such office is located")
rule S7503StatewideHolidayForOffice(office: Organ, d: Date) defeasible {
    when office_outside_dc_within_internal_revenue_district(office)
        and statewide_legal_holiday(office, d);
    then legal_holiday_for_office(office, d);
}
// The DC calendar applies regardless of office (§7503's default definition);
// `is_business_day` below reads `legal_holiday_in_dc` directly for that
// reason, so `legal_holiday_for_office` only needs to add the State-specific
// EXTENSION on top of it, not restate the DC default for an unbound `office`
// (§190 range-restriction: "for any office" has no positive witness here).

relation is_business_day(d: Date) kind derived {
    label en unofficial "the date is neither a Saturday/Sunday nor a legal holiday in the District of Columbia (default office)";
}
@source(IRC_S7503, relation = formalizes, coverage = partial, quote = "the performance of such act shall be considered timely if it is performed on the next succeeding day which is not a Saturday, Sunday, or a legal holiday")
rule S7503IsBusinessDay(d: Date) defeasible {
    when day_in_question(d)
        and not_known(falls_on_weekend(d))
        and not_known(legal_holiday_in_dc(d))
        and not_known(legal_holiday_in_dc_per_federal_calendar(d));
    then is_business_day(d);
}

// --- §7503: the rollover itself -----------------------------------------------
//
// `base` is ALREADY the last day for performing the act "determined by
// including any authorized extension of time" (§7503's own instruction) —
// the caller (a consumer package's deadline rule) is responsible for passing
// the post-extension date, not the bare statutory date.

relation next_business_day_candidate(base: Date, candidate: Date) kind empirical {
    label en unofficial "a candidate for the next succeeding day which is not a Saturday, Sunday, or legal holiday, supplied by the caller (this package validates but does not compute the walk-forward — see TECH_GAP in the module header)";
}

pub relation last_day_rolled(base: Date, rolled: Date) kind institutional {
    label en unofficial "§7503's rolled-forward last day for performing an act whose otherwise-prescribed last day is `base`";
}

@source(IRC_S7503, relation = formalizes, coverage = exact, quote = "When the last day prescribed under authority of the internal revenue laws for performing any act falls on Saturday, Sunday, or a legal holiday, the performance of such act shall be considered timely if it is performed on the next succeeding day which is not a Saturday, Sunday, or a legal holiday")
rule S7503NoRolloverOnBusinessDay(base: Date) defeasible {
    when is_business_day(base);
    then last_day_rolled(base, base);
}

@source(IRC_S7503, relation = formalizes, coverage = exact, quote = "the performance of such act shall be considered timely if it is performed on the next succeeding day which is not a Saturday, Sunday, or a legal holiday")
rule S7503RollToValidatedNextBusinessDay(base: Date, candidate: Date) defeasible {
    when day_in_question(base)
        and not_known(is_business_day(base))
        and next_business_day_candidate(base, candidate)
        and candidate > base
        and day_in_question(candidate)
        and is_business_day(candidate);
    then last_day_rolled(base, candidate);
}
