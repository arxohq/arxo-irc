// Scenarios for §9823 — air ambulance report requirements. NOT executed
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9823-01-FIRST-REPORT-WITHIN-90-DAYS-DISCHARGED" {
    given {
        context { legal_time @2023-01-15; decision_time @2023-01-15T09:00:00-05:00; knowledge_time @2023-01-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9823:t1#plan"), entity_ref("urn:test:s9823:t1#sponsor")) { origin case_input; }
        assert "f1": air_ambulance_reporting_first_year_end(entity_ref("urn:test:s9823:t1#plan"), @2022-12-31) { origin case_input; }
        assert "f2": air_ambulance_report_content(entity_ref("urn:test:s9823:t1#plan"), entity_ref("urn:test:s9823:t1#y")) { origin case_input; }
        assert "f3": air_ambulance_report_submitted_on(entity_ref("urn:test:s9823:t1#plan"), entity_ref("urn:test:s9823:t1#y"), @2023-01-10) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9823FirstReport, VIOLATED);
    expect not position(S9823FirstReport, ACTIVE);
}

test "S9823-02-FIRST-REPORT-NOT-FILED-VIOLATED" {
    given {
        context { legal_time @2023-04-15; decision_time @2023-04-15T09:00:00-05:00; knowledge_time @2023-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9823:t2#plan"), entity_ref("urn:test:s9823:t2#sponsor")) { origin case_input; }
        assert "f1": air_ambulance_reporting_first_year_end(entity_ref("urn:test:s9823:t2#plan"), @2022-12-31) { origin case_input; }
        assert "f2": air_ambulance_report_content(entity_ref("urn:test:s9823:t2#plan"), entity_ref("urn:test:s9823:t2#y")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9823FirstReport, VIOLATED);
}
