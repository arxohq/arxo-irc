// Scenarios for §9831 (general exceptions) and §9832 (definitions). NOT
// executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9831-01-GOVERNMENTAL-PLAN-EXEMPT" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": governmental_plan(entity_ref("urn:test:s9831:t1#plan")) { origin case_input; }
    }
    evaluate truth(chapter_100_exempt(entity_ref("urn:test:s9831:t1#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S9831-02-FEWER-THAN-2-EMPLOYEE-PARTICIPANTS-EXEMPT" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": current_employee_participant_count_on_first_day(entity_ref("urn:test:s9831:t2#plan"), entity_ref("urn:test:s9831:t2#y"), 1) { origin case_input; }
    }
    evaluate truth(chapter_100_exempt(entity_ref("urn:test:s9831:t2#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S9831-03-2-EMPLOYEE-PARTICIPANTS-NOT-EXEMPT-ON-COUNT-ALONE" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": current_employee_participant_count_on_first_day(entity_ref("urn:test:s9831:t3#plan"), entity_ref("urn:test:s9831:t3#y"), 2) { origin case_input; }
    }
    evaluate truth(chapter_100_exempt(entity_ref("urn:test:s9831:t3#plan")));
    expect truth_status == NEITHER;
}

test "S9832-01-EXCEPTED-BENEFIT-CATEGORY-1-CLASSIFIED" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": excepted_benefit_category(entity_ref("urn:test:s9832:t1#benefit"), NotSubjectToRequirements) { origin case_input; }
    }
    evaluate truth(excepted_benefit(entity_ref("urn:test:s9832:t1#benefit")));
    expect truth_status == TRUE_ONLY;
}

test "S9832-02-CHAPTER-100-EXEMPT-AS-TO-EXCEPTED-BENEFIT" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": excepted_benefit_category(entity_ref("urn:test:s9832:t2#benefit"), NotSubjectToRequirements) { origin case_input; }
        assert "f1": benefit_provided_under_plan(entity_ref("urn:test:s9832:t2#benefit"), entity_ref("urn:test:s9832:t2#plan")) { origin case_input; }
    }
    evaluate truth(chapter_100_exempt_as_to_benefit(entity_ref("urn:test:s9832:t2#plan"), entity_ref("urn:test:s9832:t2#benefit")));
    expect truth_status == TRUE_ONLY;
}

test "S9832-03-GROUP-HEALTH-PLAN-BY-CONSTRUCTION" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9832:t3#plan"), entity_ref("urn:test:s9832:t3#sponsor")) { origin case_input; }
    }
    evaluate truth(group_health_plan(entity_ref("urn:test:s9832:t3#plan")));
    expect truth_status == TRUE_ONLY;
}
