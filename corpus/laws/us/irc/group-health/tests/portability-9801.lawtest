// Scenarios for §9801 — preexisting condition exclusion, creditable
// coverage, the 63-day break rule, certification duty, special enrollment.
// NOT executed in this stage (owner's NO-HEAVY-CHECKS restriction);
// `implemented_unverified`.

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9801-01-CREDITABLE-COVERAGE-BROKEN-BY-64-DAY-GAP-FULL-12-MONTH-EXCLUSION" {
    given {
        context { legal_time @2026-08-01; decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": enrolled_on(entity_ref("urn:test:s9801:t1#person"), entity_ref("urn:test:s9801:t1#plan"), @2026-04-01) { origin case_input; }
        assert "f1": creditable_coverage_period_of(entity_ref("urn:test:s9801:t1#period1"), entity_ref("urn:test:s9801:t1#person"), OtherGroupHealthPlan) { origin case_input; }
        assert "f2": creditable_coverage_begins(entity_ref("urn:test:s9801:t1#period1"), @2025-01-01) { origin case_input; }
        assert "f3": creditable_coverage_ends(entity_ref("urn:test:s9801:t1#period1"), @2025-01-27) { origin case_input; }
        assert "f4": condition_within_6_month_lookback(entity_ref("urn:test:s9801:t1#person"), entity_ref("urn:test:s9801:t1#plan")) { origin case_input; }
        assert "f5": condition_date_in_question(entity_ref("urn:test:s9801:t1#person"), entity_ref("urn:test:s9801:t1#plan"), @2026-04-15) { origin case_input; }
        // gap from 2025-01-27 to enrollment 2026-04-01 is far more than 63/64 days: the period does not count.
    }
    evaluate truth(creditable_coverage_broken_by_63_day_gap(entity_ref("urn:test:s9801:t1#period1"), entity_ref("urn:test:s9801:t1#plan")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(preexisting_exclusion_may_apply_on(entity_ref("urn:test:s9801:t1#person"), entity_ref("urn:test:s9801:t1#plan"), @2026-04-15));
    expect truth_status == TRUE_ONLY;
}

test "S9801-02-LATE-ENROLLEE-18-MONTH-BASE" {
    given {
        context { legal_time @2026-08-01; decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": enrolled_on(entity_ref("urn:test:s9801:t2#person"), entity_ref("urn:test:s9801:t2#plan"), @2026-04-01) { origin case_input; }
        assert "f1": late_enrollee(entity_ref("urn:test:s9801:t2#person"), entity_ref("urn:test:s9801:t2#plan")) { origin case_input; }
    }
    evaluate truth(preexisting_exclusion_base_months(entity_ref("urn:test:s9801:t2#person"), entity_ref("urn:test:s9801:t2#plan"), 18));
    expect truth_status == TRUE_ONLY;
}

test "S9801-03-SPECIAL-ENROLLMENT-AT-30-DAYS-TIMELY" {
    given {
        context { legal_time @2026-08-01; decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": prior_coverage_lost_on(entity_ref("urn:test:s9801:t3#person"), @2026-06-01) { origin case_input; }
        assert "f1": special_enrollment_requested_on(entity_ref("urn:test:s9801:t3#person"), entity_ref("urn:test:s9801:t3#plan"), @2026-07-01) { origin case_input; }
    }
    evaluate truth(loss_of_coverage_special_enrollment_timely(entity_ref("urn:test:s9801:t3#person"), entity_ref("urn:test:s9801:t3#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S9801-04-SPECIAL-ENROLLMENT-AT-31-DAYS-UNDETERMINED" {
    given {
        context { legal_time @2026-08-01; decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": prior_coverage_lost_on(entity_ref("urn:test:s9801:t4#person"), @2026-06-01) { origin case_input; }
        assert "f1": special_enrollment_requested_on(entity_ref("urn:test:s9801:t4#person"), entity_ref("urn:test:s9801:t4#plan"), @2026-07-02) { origin case_input; }
    }
    evaluate truth(loss_of_coverage_special_enrollment_timely(entity_ref("urn:test:s9801:t4#person"), entity_ref("urn:test:s9801:t4#plan")));
    expect truth_status == NEITHER;
}

test "S9801-05-CERTIFICATION-DUTY-DISCHARGED" {
    given {
        context { legal_time @2026-03-05; decision_time @2026-03-05T09:00:00-05:00; knowledge_time @2026-03-05T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9801:t5#plan"), entity_ref("urn:test:s9801:t5#sponsor")) { origin case_input; }
        assert "f1": coverage_ceased_or_cobra_started_on(entity_ref("urn:test:s9801:t5#person"), entity_ref("urn:test:s9801:t5#plan"), @2026-03-01) { origin case_input; }
        assert "f2": certification_issued(entity_ref("urn:test:s9801:t5#cert"), entity_ref("urn:test:s9801:t5#person"), entity_ref("urn:test:s9801:t5#plan"), @2026-03-01) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9801CertificationAtCessation, VIOLATED);
    expect not position(S9801CertificationAtCessation, ACTIVE);
}

test "S9801-06-CERTIFICATION-DUTY-VIOLATED-NOT-ISSUED" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9801:t6#plan"), entity_ref("urn:test:s9801:t6#sponsor")) { origin case_input; }
        assert "f1": coverage_ceased_or_cobra_started_on(entity_ref("urn:test:s9801:t6#person"), entity_ref("urn:test:s9801:t6#plan"), @2026-03-01) { origin case_input; }
    }
    evaluate positions();
    expect position(S9801CertificationAtCessation, VIOLATED);
}

test "S9801-07-PREGNANCY-EXCLUSION-BARRED" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": enrolled_on(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan"), @2026-05-01) { origin case_input; }
        assert "f1": condition_is_pregnancy(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan")) { origin case_input; }
        assert "f2": condition_within_6_month_lookback(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan")) { origin case_input; }
        assert "f3": condition_date_in_question(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan"), @2026-05-15) { origin case_input; }
    }
    evaluate truth(preexisting_exclusion_barred_under_d(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(preexisting_exclusion_may_apply_on(entity_ref("urn:test:s9801:t7#person"), entity_ref("urn:test:s9801:t7#plan"), @2026-05-15));
    expect truth_status == NEITHER;
}
