// Scenarios for §9822 — choice of PCP, pediatric care, OB/GYN direct
// access. NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9822-01-PCP-CHOICE-REFUSED-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9822:t1#plan"), entity_ref("urn:test:s9822:t1#sponsor")) { origin case_input; }
        assert "f1": plan_requires_pcp_designation(entity_ref("urn:test:s9822:t1#plan")) { origin case_input; }
        assert "f2": participating_pcp_available_to_accept(entity_ref("urn:test:s9822:t1#provider"), entity_ref("urn:test:s9822:t1#plan"), entity_ref("urn:test:s9822:t1#person")) { origin case_input; }
        assert "f3": plan_refused_pcp_designation(entity_ref("urn:test:s9822:t1#plan"), entity_ref("urn:test:s9822:t1#person"), entity_ref("urn:test:s9822:t1#provider")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9822RefusalToPermitPcpChoice, VIOLATED);
}

test "S9822-02-OBGYN-AUTHORIZATION-REQUIRED-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9822:t2#plan"), entity_ref("urn:test:s9822:t2#sponsor")) { origin case_input; }
        assert "f1": plan_provides_obgyn_coverage_and_requires_pcp(entity_ref("urn:test:s9822:t2#plan")) { origin case_input; }
        assert "f2": obgyn_professional_participates(entity_ref("urn:test:s9822:t2#professional"), entity_ref("urn:test:s9822:t2#plan")) { origin case_input; }
        assert "f3": obgyn_direct_access_sought(entity_ref("urn:test:s9822:t2#plan"), entity_ref("urn:test:s9822:t2#person"), entity_ref("urn:test:s9822:t2#professional")) { origin case_input; }
        assert "f4": plan_required_authorization_for_obgyn_care(entity_ref("urn:test:s9822:t2#plan"), entity_ref("urn:test:s9822:t2#person"), entity_ref("urn:test:s9822:t2#professional")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9822ObgynAuthorizationRequirement, VIOLATED);
}
