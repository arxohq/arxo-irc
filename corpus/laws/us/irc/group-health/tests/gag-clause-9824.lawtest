// Scenarios for §9824 — gag clauses on price and quality information.
// NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9824-01-GAG-CLAUSE-AGREEMENT-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9824:t1#plan"), entity_ref("urn:test:s9824:t1#sponsor")) { origin case_input; }
        assert "f1": plan_entered_gag_clause_agreement(entity_ref("urn:test:s9824:t1#plan"), entity_ref("urn:test:s9824:t1#tpa"), ElectronicDeIdentifiedClaimsAccess) { origin case_input; }
    }
    evaluate positions();
    expect position(S9824GagClauseAgreement, VIOLATED);
}

test "S9824-02-NO-AGREEMENT-UNDETERMINED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9824:t2#plan"), entity_ref("urn:test:s9824:t2#sponsor")) { origin case_input; }
    }
    evaluate truth(plan_entered_gag_clause_agreement(entity_ref("urn:test:s9824:t2#plan"), entity_ref("urn:test:s9824:t2#tpa"), ProviderSpecificCostOrQualityInfo));
    expect truth_status == NEITHER;
}
