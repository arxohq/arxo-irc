// Scenarios for §9819 — price comparison tool. NOT executed
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9819-01-TOOL-AND-PHONE-GUIDANCE-DISCHARGED" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9819:t1#plan"), entity_ref("urn:test:s9819:t1#sponsor")) { origin case_input; }
        assert "f1": price_comparison_tool_maintained(entity_ref("urn:test:s9819:t1#plan")) { origin case_input; }
        assert "f2": price_comparison_phone_guidance_offered(entity_ref("urn:test:s9819:t1#plan")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9819PriceComparisonTool, VIOLATED);
    expect not position(S9819PriceComparisonTool, ACTIVE);
}

test "S9819-02-NO-TOOL-VIOLATED" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9819:t2#plan"), entity_ref("urn:test:s9819:t2#sponsor")) { origin case_input; }
        assert "f1": price_comparison_phone_guidance_offered(entity_ref("urn:test:s9819:t2#plan")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9819PriceComparisonTool, VIOLATED);
}
