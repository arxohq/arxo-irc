// Scenarios for §9817 — surprise air ambulance bills. NOT executed
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9817-01-EXCESSIVE-COST-SHARING-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9817:t1#plan"), entity_ref("urn:test:s9817:t1#sponsor")) { origin case_input; }
        assert "f1": air_ambulance_claim_for(entity_ref("urn:test:s9817:t1#claim"), entity_ref("urn:test:s9817:t1#person"), entity_ref("urn:test:s9817:t1#plan")) { origin case_input; }
        assert "f2": air_ambulance_claim_nonparticipating(entity_ref("urn:test:s9817:t1#claim")) { origin case_input; }
        assert "f3": air_ambulance_claim_would_be_covered_if_participating(entity_ref("urn:test:s9817:t1#claim")) { origin case_input; }
        assert "f4": air_ambulance_recognized_amount(entity_ref("urn:test:s9817:t1#claim"), 5000.00) { origin case_input; }
        assert "f5": plan_in_network_cost_sharing_rate(entity_ref("urn:test:s9817:t1#plan"), 0.10) { origin case_input; }
        assert "f6": air_ambulance_actual_cost_sharing_imposed(entity_ref("urn:test:s9817:t1#claim"), 2000.00) { origin case_input; }
    }
    evaluate positions();
    expect position(S9817ExcessiveCostSharing, VIOLATED);
}

test "S9817-02-IDR-INITIATION-AT-DAY-4-TIMELY" {
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": air_ambulance_payment_received_on(entity_ref("urn:test:s9817:t2#dispute"), @2026-01-01) { origin case_input; }
        assert "f1": air_ambulance_idr_initiated_on(entity_ref("urn:test:s9817:t2#dispute"), @2026-02-04) { origin case_input; }
    }
    evaluate truth(air_ambulance_idr_initiation_timely(entity_ref("urn:test:s9817:t2#dispute")));
    expect truth_status == TRUE_ONLY;
}

test "S9817-03-TIMING-OF-PAYMENT-DUTY-VIOLATED" {
    given {
        context { legal_time @2026-04-15; decision_time @2026-04-15T09:00:00-05:00; knowledge_time @2026-04-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9817:t3#plan"), entity_ref("urn:test:s9817:t3#sponsor")) { origin case_input; }
        assert "f1": air_ambulance_idr_dispute_for(entity_ref("urn:test:s9817:t3#dispute"), entity_ref("urn:test:s9817:t3#claim")) { origin case_input; }
        assert "f2": air_ambulance_claim_for(entity_ref("urn:test:s9817:t3#claim"), entity_ref("urn:test:s9817:t3#person"), entity_ref("urn:test:s9817:t3#plan")) { origin case_input; }
        assert "f3": air_ambulance_idr_determination_made_on(entity_ref("urn:test:s9817:t3#dispute"), @2026-03-01) { origin case_input; }
    }
    evaluate positions();
    expect position(S9817TimingOfPayment, VIOLATED);
}
