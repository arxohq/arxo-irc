// Scenarios for §9815 (PHSA incorporation), §9816(a)-(c),(f) (surprise
// billing cost-sharing and IDR windows, advance EOB), §9820(a)-(c)
// (provider directories). NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9816-01-EMERGENCY-COST-SHARING-EXCEEDS-IN-NETWORK-EQUIVALENT-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9816:t1#plan"), entity_ref("urn:test:s9816:t1#sponsor")) { origin case_input; }
        assert "f1": emergency_claim_for(entity_ref("urn:test:s9816:t1#claim"), entity_ref("urn:test:s9816:t1#person"), entity_ref("urn:test:s9816:t1#plan")) { origin case_input; }
        assert "f2": emergency_claim_nonparticipating(entity_ref("urn:test:s9816:t1#claim")) { origin case_input; }
        assert "f3": recognized_amount(entity_ref("urn:test:s9816:t1#claim"), 1000.00) { origin case_input; }
        assert "f4": plan_in_network_cost_sharing_rate(entity_ref("urn:test:s9816:t1#plan"), 0.20) { origin case_input; }
        assert "f5": actual_cost_sharing_imposed(entity_ref("urn:test:s9816:t1#claim"), 500.00) { origin case_input; }
    }
    evaluate positions();
    expect position(S9816ExcessiveCostSharing, VIOLATED);
}

test "S9816-02-INITIAL-PAYMENT-WITHIN-30-DAYS-DISCHARGED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9816:t2#plan"), entity_ref("urn:test:s9816:t2#sponsor")) { origin case_input; }
        assert "f1": emergency_claim_for(entity_ref("urn:test:s9816:t2#claim"), entity_ref("urn:test:s9816:t2#person"), entity_ref("urn:test:s9816:t2#plan")) { origin case_input; }
        assert "f2": bill_transmitted_on(entity_ref("urn:test:s9816:t2#claim"), @2026-01-01) { origin case_input; }
        assert "f3": initial_payment_or_denial_sent_on(entity_ref("urn:test:s9816:t2#claim"), @2026-01-20) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9816InitialPaymentOrDenial, VIOLATED);
    expect not position(S9816InitialPaymentOrDenial, ACTIVE);
}

test "S9816-03-IDR-INITIATION-AT-DAY-4-TIMELY" {
    // open negotiation received day 0; 30-day period ends day 30; the 4-day
    // IDR window runs day 31-34. Initiation on day 34 (4 days after) is timely.
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": initial_payment_or_denial_received_on(entity_ref("urn:test:s9816:t3#dispute"), @2026-01-01) { origin case_input; }
        assert "f1": idr_process_initiated_on(entity_ref("urn:test:s9816:t3#dispute"), @2026-02-04) { origin case_input; }
    }
    evaluate truth(idr_initiation_timely(entity_ref("urn:test:s9816:t3#dispute")));
    expect truth_status == TRUE_ONLY;
}

test "S9816-04-IDR-INITIATION-AT-DAY-5-UNDETERMINED" {
    given {
        context { legal_time @2026-03-15; decision_time @2026-03-15T09:00:00-05:00; knowledge_time @2026-03-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": initial_payment_or_denial_received_on(entity_ref("urn:test:s9816:t4#dispute"), @2026-01-01) { origin case_input; }
        assert "f1": idr_process_initiated_on(entity_ref("urn:test:s9816:t4#dispute"), @2026-02-05) { origin case_input; }
    }
    evaluate truth(idr_initiation_timely(entity_ref("urn:test:s9816:t4#dispute")));
    expect truth_status == NEITHER;
}

test "S9816-05-ADVANCE-EOB-3-BUSINESS-DAYS-WHEN-SCHEDULED-10-DAYS-AHEAD" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9816:t5#plan"), entity_ref("urn:test:s9816:t5#sponsor")) { origin case_input; }
        assert "f1": eob_request_for(entity_ref("urn:test:s9816:t5#request"), entity_ref("urn:test:s9816:t5#person"), entity_ref("urn:test:s9816:t5#plan")) { origin case_input; }
        assert "f2": eob_request_received_on(entity_ref("urn:test:s9816:t5#request"), @2026-01-05) { origin case_input; }
        assert "f3": eob_scheduled_at_least_10_business_days_ahead(entity_ref("urn:test:s9816:t5#request")) { origin case_input; }
        assert "f4": nth_business_day_after(@2026-01-05, 3, @2026-01-08) { origin case_input; }
    }
    evaluate truth(advanced_eob_due(entity_ref("urn:test:s9816:t5#request"), @2026-01-08));
    expect truth_status == TRUE_ONLY;
}

test "S9816-06-ADVANCE-EOB-1-BUSINESS-DAY-WHEN-NOT-10-DAYS-AHEAD" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9816:t6#plan"), entity_ref("urn:test:s9816:t6#sponsor")) { origin case_input; }
        assert "f1": eob_request_for(entity_ref("urn:test:s9816:t6#request"), entity_ref("urn:test:s9816:t6#person"), entity_ref("urn:test:s9816:t6#plan")) { origin case_input; }
        assert "f2": eob_request_received_on(entity_ref("urn:test:s9816:t6#request"), @2026-01-05) { origin case_input; }
        assert "f3": nth_business_day_after(@2026-01-05, 1, @2026-01-06) { origin case_input; }
    }
    evaluate truth(advanced_eob_due(entity_ref("urn:test:s9816:t6#request"), @2026-01-06));
    expect truth_status == TRUE_ONLY;
}

test "S9820-01-COST-SHARING-ON-INCORRECT-DIRECTORY-INFO-VIOLATED" {
    given {
        context { legal_time @2026-02-01; decision_time @2026-02-01T09:00:00-05:00; knowledge_time @2026-02-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9820:t1#plan"), entity_ref("urn:test:s9820:t1#sponsor")) { origin case_input; }
        assert "f1": nonparticipating_item_furnished(entity_ref("urn:test:s9820:t1#claim"), entity_ref("urn:test:s9820:t1#person"), entity_ref("urn:test:s9820:t1#plan")) { origin case_input; }
        assert "f2": relied_on_incorrect_directory_information(entity_ref("urn:test:s9820:t1#claim")) { origin case_input; }
        assert "f3": recognized_amount(entity_ref("urn:test:s9820:t1#claim"), 800.00) { origin case_input; }
        assert "f4": plan_in_network_cost_sharing_rate(entity_ref("urn:test:s9820:t1#plan"), 0.10) { origin case_input; }
        assert "f5": actual_cost_sharing_imposed(entity_ref("urn:test:s9820:t1#claim"), 300.00) { origin case_input; }
    }
    evaluate positions();
    expect position(S9820ExcessiveCostSharingOnIncorrectDirectory, VIOLATED);
}
