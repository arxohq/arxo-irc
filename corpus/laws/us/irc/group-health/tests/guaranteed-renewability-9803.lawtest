// Scenarios for §9803 — guaranteed renewability in multiemployer plans and
// MEWAs. NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9803-01-DENIAL-OF-ACCESS-WITH-NO-EXCEPTION-VIOLATED" {
    given {
        context { legal_time @2026-04-01; decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": multiemployer_plan_9803(entity_ref("urn:test:s9803:t1#plan")) { origin case_input; }
        assert "f1": plan_sponsor(entity_ref("urn:test:s9803:t1#plan"), entity_ref("urn:test:s9803:t1#sponsor")) { origin case_input; }
        assert "f2": plan_denied_continued_access(entity_ref("urn:test:s9803:t1#plan"), entity_ref("urn:test:s9803:t1#employer")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9803DenialOfContinuedAccess, VIOLATED);
}

test "S9803-02-DENIAL-FOR-NONPAYMENT-NOT-VIOLATED" {
    given {
        context { legal_time @2026-04-01; decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": multiemployer_plan_9803(entity_ref("urn:test:s9803:t2#plan")) { origin case_input; }
        assert "f1": plan_sponsor(entity_ref("urn:test:s9803:t2#plan"), entity_ref("urn:test:s9803:t2#sponsor")) { origin case_input; }
        assert "f2": plan_denied_continued_access(entity_ref("urn:test:s9803:t2#plan"), entity_ref("urn:test:s9803:t2#employer")) { origin case_input; }
        assert "f3": denial_for_nonpayment_of_contributions(entity_ref("urn:test:s9803:t2#plan"), entity_ref("urn:test:s9803:t2#employer")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9803DenialOfContinuedAccess, VIOLATED);
    expect not position(S9803DenialOfContinuedAccess, ACTIVE);
}

test "S9803B-01-MEWA-CLASSIFICATION-APPLIES-SECTION-9803" {
    given {
        context { legal_time @2026-04-01; decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": multiple_employer_welfare_arrangement(entity_ref("urn:test:s9803b:t1#plan")) { origin case_input; }
    }
    evaluate truth(section_9803_applies(entity_ref("urn:test:s9803b:t1#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S9803B-02-NO-CLASSIFICATION-FACT-NO-SECTION-9803" {
    given {
        context { legal_time @2026-04-01; decision_time @2026-04-01T09:00:00-05:00; knowledge_time @2026-04-01T09:00:00-05:00; timezone "America/New_York"; }
    }
    evaluate truth(section_9803_applies(entity_ref("urn:test:s9803b:t2#plan")));
    expect truth_status == NEITHER;
}
