// Scenarios for §9825 — pharmacy benefits and drug cost reporting.
// NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9825-01-REPORT-BY-JUNE-1-DISCHARGED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9825:t1#plan"), entity_ref("urn:test:s9825:t1#sponsor")) { origin case_input; }
        assert "f1": pharmacy_report_content_complete(entity_ref("urn:test:s9825:t1#plan"), entity_ref("urn:test:s9825:t1#y")) { origin case_input; }
        assert "f2": pharmacy_report_deadline(entity_ref("urn:test:s9825:t1#y"), @2026-06-01) { origin case_input; }
        assert "f3": pharmacy_report_submitted_on(entity_ref("urn:test:s9825:t1#plan"), entity_ref("urn:test:s9825:t1#y"), @2026-05-20) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9825AnnualReport, VIOLATED);
    expect not position(S9825AnnualReport, ACTIVE);
}

test "S9825-02-REPORT-LATE-VIOLATED" {
    given {
        context { legal_time @2026-06-15; decision_time @2026-06-15T09:00:00-05:00; knowledge_time @2026-06-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9825:t2#plan"), entity_ref("urn:test:s9825:t2#sponsor")) { origin case_input; }
        assert "f1": pharmacy_report_content_complete(entity_ref("urn:test:s9825:t2#plan"), entity_ref("urn:test:s9825:t2#y")) { origin case_input; }
        assert "f2": pharmacy_report_deadline(entity_ref("urn:test:s9825:t2#y"), @2026-06-01) { origin case_input; }
    }
    evaluate positions();
    expect position(S9825AnnualReport, VIOLATED);
}

test "S9825-03-CONFIDENTIAL-INFO-DISCLOSED-CLASSIFICATION" {
    given {
        context { legal_time @2026-08-01; decision_time @2026-08-01T09:00:00-05:00; knowledge_time @2026-08-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": confidential_information_included_in_public_report(entity_ref("urn:test:s9825:t3#info")) { origin case_input; }
    }
    evaluate truth(confidentiality_protection_breached(entity_ref("urn:test:s9825:t3#info")));
    expect truth_status == TRUE_ONLY;
}
