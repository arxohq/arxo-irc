test "S9802F-01-SMALL-EMPLOYER-EMPLOYEE-EVIDENCE-OF-GOOD-HEALTH-EXCEPTION" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": church_plan(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan")) { origin case_input; }
        assert "f1": church_plan_year_begins(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan"), @2026-01-01) { origin case_input; }
        assert "f2": church_plan_good_health_provisions_on_july_15_1997(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan")) { origin case_input; }
        assert "f3": church_plan_requires_good_health_for_small_employer_employees_and_self_employed(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan")) { origin case_input; }
        assert "f4": eligibility_rule_based_on_factor(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan"), entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#p"), EvidenceOfInsurability) { origin case_input; }
        assert "f5": person_employee_of_employer_with_10_or_fewer(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#p")) { origin case_input; }
    }
    // church plan grandfathered since July 15, 1997
    evaluate truth(church_plan_good_health_exception(entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#plan"), entity_ref("urn:test:s9802f01smallemployeremployeeevidenceofg#p"), EvidenceOfInsurability));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
