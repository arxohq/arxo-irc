// Scenarios for §9834 — enforcement cross-reference to section 4980D.
// §9833 (regulations) carries no norm of its own for a plan/participant and
// so has no scenario (NON_NORMATIVE, see coverage row 26/9833/u1). NOT
// executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9834-01-FAILURE-SUBJECT-TO-4980D-CLASSIFICATION" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9834:t1#plan"), entity_ref("urn:test:s9834:t1#sponsor")) { origin case_input; }
    }
    evaluate truth(chapter_100_failure_subject_to_4980d_excise(entity_ref("urn:test:s9834:t1#plan")));
    expect truth_status == TRUE_ONLY;
}
