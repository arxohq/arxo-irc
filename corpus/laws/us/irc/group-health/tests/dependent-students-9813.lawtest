// Scenarios for §9813 — dependent students on medically necessary leave.
// NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9813-01-COVERAGE-TERMINATED-BEFORE-1-YEAR-VIOLATED" {
    given {
        context { legal_time @2026-06-01; decision_time @2026-06-01T09:00:00-05:00; knowledge_time @2026-06-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9813:t1#plan"), entity_ref("urn:test:s9813:t1#sponsor")) { origin case_input; }
        assert "f1": medically_necessary_leave_of_absence(entity_ref("urn:test:s9813:t1#dependent"), entity_ref("urn:test:s9813:t1#plan"), @2026-01-01) { origin case_input; }
        assert "f2": physician_certification_received(entity_ref("urn:test:s9813:t1#dependent"), entity_ref("urn:test:s9813:t1#plan")) { origin case_input; }
        assert "f3": dependent_enrolled_as_student_before_leave(entity_ref("urn:test:s9813:t1#dependent"), entity_ref("urn:test:s9813:t1#plan")) { origin case_input; }
        assert "f4": coverage_terminated_due_to_leave(entity_ref("urn:test:s9813:t1#dependent"), entity_ref("urn:test:s9813:t1#plan"), @2026-04-01) { origin case_input; }
    }
    evaluate positions();
    expect position(S9813DependentStudentContinuation, VIOLATED);
}

test "S9813-02-COVERAGE-CONTINUED-DISCHARGED" {
    given {
        context { legal_time @2027-01-05; decision_time @2027-01-05T09:00:00-05:00; knowledge_time @2027-01-05T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9813:t2#plan"), entity_ref("urn:test:s9813:t2#sponsor")) { origin case_input; }
        assert "f1": medically_necessary_leave_of_absence(entity_ref("urn:test:s9813:t2#dependent"), entity_ref("urn:test:s9813:t2#plan"), @2026-01-01) { origin case_input; }
        assert "f2": physician_certification_received(entity_ref("urn:test:s9813:t2#dependent"), entity_ref("urn:test:s9813:t2#plan")) { origin case_input; }
        assert "f3": dependent_enrolled_as_student_before_leave(entity_ref("urn:test:s9813:t2#dependent"), entity_ref("urn:test:s9813:t2#plan")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9813DependentStudentContinuation, VIOLATED);
    expect not position(S9813DependentStudentContinuation, ACTIVE);
}
