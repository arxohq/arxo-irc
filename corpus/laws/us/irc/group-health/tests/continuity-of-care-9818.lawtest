// Scenarios for §9818 — continuity of care on provider-network termination.
// NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9818-01-NOTIFICATION-DUTY-VIOLATED-NOT-SENT" {
    given {
        context { legal_time @2026-03-01; decision_time @2026-03-01T09:00:00-05:00; knowledge_time @2026-03-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9818:t1#plan"), entity_ref("urn:test:s9818:t1#sponsor")) { origin case_input; }
        assert "f1": continuing_care_patient_ground(entity_ref("urn:test:s9818:t1#person"), entity_ref("urn:test:s9818:t1#provider"), SeriousComplexConditionTreatment) { origin case_input; }
        assert "f2": section_9818_trigger(entity_ref("urn:test:s9818:t1#person"), entity_ref("urn:test:s9818:t1#provider"), entity_ref("urn:test:s9818:t1#plan"), BenefitsTerminatedByParticipationChange, @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(S9818Notification, VIOLATED);
}

test "S9818-02-TRANSITIONAL-CARE-DUTY-DISCHARGED" {
    given {
        context { legal_time @2026-01-15; decision_time @2026-01-15T09:00:00-05:00; knowledge_time @2026-01-15T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9818:t2#plan"), entity_ref("urn:test:s9818:t2#sponsor")) { origin case_input; }
        assert "f1": continuity_notice_sent(entity_ref("urn:test:s9818:t2#person"), entity_ref("urn:test:s9818:t2#provider"), entity_ref("urn:test:s9818:t2#plan"), @2026-01-01) { origin case_input; }
        assert "f2": elects_continued_transitional_care(entity_ref("urn:test:s9818:t2#person"), entity_ref("urn:test:s9818:t2#provider"), entity_ref("urn:test:s9818:t2#plan")) { origin case_input; }
        assert "f3": transitional_benefits_provided(entity_ref("urn:test:s9818:t2#person"), entity_ref("urn:test:s9818:t2#provider"), entity_ref("urn:test:s9818:t2#plan"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9818TransitionalCare, VIOLATED);
    expect not position(S9818TransitionalCare, ACTIVE);
}
