// Scenarios for §9802 — health-factor discrimination, genetic testing and
// genetic information collection. NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9802-01-ELIGIBILITY-DENIED-FOR-HEALTH-STATUS-VIOLATED-ONCE" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t1#plan"), entity_ref("urn:test:s9802:t1#sponsor")) { origin case_input; }
        assert "f1": eligibility_rule_based_on_factor(entity_ref("urn:test:s9802:t1#plan"), entity_ref("urn:test:s9802:t1#person"), HealthStatus) { origin case_input; }
    }
    evaluate positions();
    expect position(S9802AEligibilityDiscrimination, VIOLATED);
}

test "S9802-02-UNIFORM-BENEFIT-LIMITATION-NOT-A-VIOLATION" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t2#plan"), entity_ref("urn:test:s9802:t2#sponsor")) { origin case_input; }
        assert "f1": eligibility_rule_based_on_factor(entity_ref("urn:test:s9802:t2#plan"), entity_ref("urn:test:s9802:t2#person"), MedicalCondition) { origin case_input; }
        assert "f2": eligibility_rule_is_uniform_benefit_limitation(entity_ref("urn:test:s9802:t2#plan"), entity_ref("urn:test:s9802:t2#person"), MedicalCondition) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9802AEligibilityDiscrimination, VIOLATED);
    expect not position(S9802AEligibilityDiscrimination, ACTIVE);
}

test "S9802-03-GENETIC-TESTING-REQUIRED-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t3#plan"), entity_ref("urn:test:s9802:t3#sponsor")) { origin case_input; }
        assert "f1": plan_requested_or_required_genetic_test(entity_ref("urn:test:s9802:t3#plan"), entity_ref("urn:test:s9802:t3#person")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9802CGeneticTestingProhibition, VIOLATED);
}

test "S9802-04-GENETIC-TESTING-RESEARCH-EXCEPTION-NOT-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t4#plan"), entity_ref("urn:test:s9802:t4#sponsor")) { origin case_input; }
        assert "f1": plan_requested_or_required_genetic_test(entity_ref("urn:test:s9802:t4#plan"), entity_ref("urn:test:s9802:t4#person")) { origin case_input; }
        assert "f2": genetic_test_request_meets_research_exception(entity_ref("urn:test:s9802:t4#plan"), entity_ref("urn:test:s9802:t4#person")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9802CGeneticTestingProhibition, VIOLATED);
    expect not position(S9802CGeneticTestingProhibition, ACTIVE);
}

test "S9802-05-GENETIC-INFO-COLLECTED-FOR-UNDERWRITING-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t5#plan"), entity_ref("urn:test:s9802:t5#sponsor")) { origin case_input; }
        assert "f1": genetic_information_collected_for_underwriting(entity_ref("urn:test:s9802:t5#plan"), entity_ref("urn:test:s9802:t5#person")) { origin case_input; }
    }
    evaluate positions();
    expect position(S9802D1NoGeneticInfoForUnderwriting, VIOLATED);
}

test "S9802-06-UNKNOWN-FACTOR-UNDETERMINED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9802:t6#plan"), entity_ref("urn:test:s9802:t6#sponsor")) { origin case_input; }
    }
    evaluate truth(eligibility_rule_based_on_factor(entity_ref("urn:test:s9802:t6#plan"), entity_ref("urn:test:s9802:t6#person"), Disability));
    expect truth_status == NEITHER;
}
