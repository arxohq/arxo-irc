// Scenarios for §9811 — 48/96-hour minimum hospital stays. NOT executed
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9811-01-VAGINAL-DELIVERY-47-HOURS-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9811:t1#plan"), entity_ref("urn:test:s9811:t1#sponsor")) { origin case_input; }
        assert "f1": hospital_stay_for(entity_ref("urn:test:s9811:t1#stay"), entity_ref("urn:test:s9811:t1#mother"), entity_ref("urn:test:s9811:t1#plan")) { origin case_input; }
        assert "f2": hospital_stay_delivery_kind(entity_ref("urn:test:s9811:t1#stay"), VaginalDelivery) { origin case_input; }
        assert "f3": hospital_stay_hours(entity_ref("urn:test:s9811:t1#stay"), 47) { origin case_input; }
    }
    evaluate positions();
    expect position(S9811MinimumStayRestriction, VIOLATED);
}

test "S9811-02-VAGINAL-DELIVERY-48-HOURS-NOT-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9811:t2#plan"), entity_ref("urn:test:s9811:t2#sponsor")) { origin case_input; }
        assert "f1": hospital_stay_for(entity_ref("urn:test:s9811:t2#stay"), entity_ref("urn:test:s9811:t2#mother"), entity_ref("urn:test:s9811:t2#plan")) { origin case_input; }
        assert "f2": hospital_stay_delivery_kind(entity_ref("urn:test:s9811:t2#stay"), VaginalDelivery) { origin case_input; }
        assert "f3": hospital_stay_hours(entity_ref("urn:test:s9811:t2#stay"), 48) { origin case_input; }
    }
    evaluate truth(minimum_stay_hours(VaginalDelivery, 48));
    expect truth_status == TRUE_ONLY;
}

test "S9811-03-EARLY-DISCHARGE-BY-ATTENDING-PROVIDER-EXCEPTION-NOT-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9811:t3#plan"), entity_ref("urn:test:s9811:t3#sponsor")) { origin case_input; }
        assert "f1": hospital_stay_for(entity_ref("urn:test:s9811:t3#stay"), entity_ref("urn:test:s9811:t3#mother"), entity_ref("urn:test:s9811:t3#plan")) { origin case_input; }
        assert "f2": hospital_stay_delivery_kind(entity_ref("urn:test:s9811:t3#stay"), CaesareanSection) { origin case_input; }
        assert "f3": hospital_stay_hours(entity_ref("urn:test:s9811:t3#stay"), 60) { origin case_input; }
        assert "f4": discharge_decided_by_attending_provider_with_mother(entity_ref("urn:test:s9811:t3#stay")) { origin case_input; }
    }
    evaluate positions();
    expect not position(S9811MinimumStayRestriction, VIOLATED);
    expect not position(S9811MinimumStayRestriction, ACTIVE);
}

test "S9811-04-CAESAREAN-95-HOURS-VIOLATED" {
    given {
        context { legal_time @2026-05-01; decision_time @2026-05-01T09:00:00-05:00; knowledge_time @2026-05-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9811:t4#plan"), entity_ref("urn:test:s9811:t4#sponsor")) { origin case_input; }
        assert "f1": hospital_stay_for(entity_ref("urn:test:s9811:t4#stay"), entity_ref("urn:test:s9811:t4#mother"), entity_ref("urn:test:s9811:t4#plan")) { origin case_input; }
        assert "f2": hospital_stay_delivery_kind(entity_ref("urn:test:s9811:t4#stay"), CaesareanSection) { origin case_input; }
        assert "f3": hospital_stay_hours(entity_ref("urn:test:s9811:t4#stay"), 95) { origin case_input; }
    }
    evaluate positions();
    expect position(S9811MinimumStayRestriction, VIOLATED);
}
