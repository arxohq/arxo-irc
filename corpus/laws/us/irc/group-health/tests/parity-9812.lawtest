// Scenarios for §9812 — mental health parity: aggregate limits, the
// predominant financial-requirement test, small-employer/cost exemptions.
// NOT executed (implemented_unverified).

language "law.core" version "0.2";
package us.irc.group_health version "0.1.1";
namespace "urn:us:irc:group_health:clir";

test "S9812-01-NO-MED-SURG-LIFETIME-LIMIT-BARS-MH-LIMIT-VIOLATED" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9812:t1#plan"), entity_ref("urn:test:s9812:t1#sponsor")) { origin case_input; }
        assert "f1": plan_provides_both_med_surg_and_mh_sud(entity_ref("urn:test:s9812:t1#plan")) { origin case_input; }
        assert "f2": plan_has_aggregate_limit_on_mh_sud(entity_ref("urn:test:s9812:t1#plan"), LifetimeLimit, 1000000.00) { origin case_input; }
    }
    evaluate positions();
    expect position(S9812NoLifetimeLimitWithoutMedSurgLimit, VIOLATED);
}

test "S9812-02-PREDOMINANT-FINANCIAL-REQUIREMENT-AT-EXACTLY-TWO-THIRDS" {
    // Three medical/surgical benefit lines: two at a $20 copay, one at a $40
    // copay -- $20 is predominant (2 of 3, i.e. exactly 2/3 of the benefits).
    // The MH/SUD level equal to the predominant level is NOT more restrictive.
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9812:t2#plan"), entity_ref("urn:test:s9812:t2#sponsor")) { origin case_input; }
        assert "f1": plan_provides_both_med_surg_and_mh_sud(entity_ref("urn:test:s9812:t2#plan")) { origin case_input; }
        assert "f2": med_surg_benefit_financial_requirement_level(entity_ref("urn:test:s9812:t2#plan"), entity_ref("urn:test:s9812:t2#benefit1"), 20.00) { origin case_input; }
        assert "f3": med_surg_benefit_financial_requirement_level(entity_ref("urn:test:s9812:t2#plan"), entity_ref("urn:test:s9812:t2#benefit2"), 20.00) { origin case_input; }
        assert "f4": med_surg_benefit_financial_requirement_level(entity_ref("urn:test:s9812:t2#plan"), entity_ref("urn:test:s9812:t2#benefit3"), 40.00) { origin case_input; }
        assert "f5": mh_sud_financial_requirement_level(entity_ref("urn:test:s9812:t2#plan"), 20.00) { origin case_input; }
    }
    evaluate truth(predominant_financial_requirement_level(entity_ref("urn:test:s9812:t2#plan"), 20.00));
    expect truth_status == TRUE_ONLY;
    evaluate truth(mh_sud_financial_requirement_more_restrictive(entity_ref("urn:test:s9812:t2#plan"), 20.00, 20.00));
    expect truth_status == NEITHER;
    evaluate truth(mental_health_parity_met(entity_ref("urn:test:s9812:t2#plan")));
    expect truth_status == TRUE_ONLY;
}

test "S9812-03-MH-LEVEL-ABOVE-PREDOMINANT-VIOLATED" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": plan_sponsor(entity_ref("urn:test:s9812:t3#plan"), entity_ref("urn:test:s9812:t3#sponsor")) { origin case_input; }
        assert "f1": plan_provides_both_med_surg_and_mh_sud(entity_ref("urn:test:s9812:t3#plan")) { origin case_input; }
        assert "f2": med_surg_benefit_financial_requirement_level(entity_ref("urn:test:s9812:t3#plan"), entity_ref("urn:test:s9812:t3#benefit1"), 20.00) { origin case_input; }
        assert "f3": med_surg_benefit_financial_requirement_level(entity_ref("urn:test:s9812:t3#plan"), entity_ref("urn:test:s9812:t3#benefit2"), 20.00) { origin case_input; }
        assert "f4": mh_sud_financial_requirement_level(entity_ref("urn:test:s9812:t3#plan"), 30.00) { origin case_input; }
    }
    evaluate positions();
    expect position(S9812MoreRestrictiveFinancialRequirement, VIOLATED);
}

test "S9812-04-SMALL-EMPLOYER-AT-50-EXEMPT" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": average_employees_preceding_calendar_year(entity_ref("urn:test:s9812:t4#employer"), 50.0) { origin case_input; }
    }
    evaluate truth(small_employer_9812(entity_ref("urn:test:s9812:t4#employer")));
    expect truth_status == TRUE_ONLY;
}

test "S9812-05-EMPLOYER-AT-51-NOT-SMALL-EMPLOYER" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": average_employees_preceding_calendar_year(entity_ref("urn:test:s9812:t5#employer"), 51.0) { origin case_input; }
    }
    evaluate truth(small_employer_9812(entity_ref("urn:test:s9812:t5#employer")));
    expect truth_status == NEITHER;
}

test "S9812-06-COST-EXEMPTION-EXCEEDS-FIRST-YEAR-2-PERCENT" {
    given {
        context { legal_time @2026-01-01; decision_time @2026-01-01T09:00:00-05:00; knowledge_time @2026-01-01T09:00:00-05:00; timezone "America/New_York"; }
        assert "f0": first_plan_year_9812_applied(entity_ref("urn:test:s9812:t6#plan"), entity_ref("urn:test:s9812:t6#y2026")) { origin case_input; }
        assert "f1": cost_increase_percentage(entity_ref("urn:test:s9812:t6#plan"), entity_ref("urn:test:s9812:t6#y2026"), 3.5) { origin case_input; }
    }
    evaluate truth(cost_exemption_qualifies(entity_ref("urn:test:s9812:t6#plan"), entity_ref("urn:test:s9812:t6#y2026")));
    expect truth_status == TRUE_ONLY;
}
