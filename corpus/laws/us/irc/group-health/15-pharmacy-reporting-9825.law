// 26 U.S.C. §9825 — Reporting on pharmacy benefits and drug costs (the
// annual "by June 1" report duty named in the task's own outline).
// Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9825_A,
    IRC_S9825_C,
    Person,
    TaxableYear,
    plan_sponsor,
};

pub relation pharmacy_report_content_complete(plan: GroupHealthPlan, y: TaxableYear) kind empirical {
    label en unofficial "case fact/classification: the plan compiled ALL TEN section 9825(a)(1)-(10) content items for the previous plan year (plan-year dates, participant/beneficiary count, States offered, top-50 dispensed/costly/increased-expenditure drugs, spending breakdown, average premiums, rebate impact, premium/cost reduction) — bundled into one completeness fact per the corpus's convention for a closed enumerated content list rather than ten separate case facts (TECH_GAP if a scenario needs to test a SINGLE missing item: this classification is all-or-nothing)";
}
pub relation pharmacy_report_submitted_on(plan: GroupHealthPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan submitted the section 9825(a) report to the Secretary, the Secretary of Health and Human Services, and the Secretary of Labor";
}
pub relation pharmacy_report_deadline(y: TaxableYear, deadline: Date) kind empirical {
    label en unofficial "case fact: the June 1 (or, for the first report, the 1-year-after-enactment) deadline date applicable to this plan year's report — a calendar-fixed date the language's `add_calendar_period` cannot construct from a variable year (TECH_GAP: no `date_in_year(y, month, day)` constructor; see TECH-GAPS.md), so the case supplies the deadline date directly";
}

@source(IRC_S9825_A, relation = formalizes, coverage = partial, quote = "not later than June 1 of each year thereafter, a group health plan shall submit to the Secretary, the Secretary of Health and Human Services, and the Secretary of Labor the following information with respect to the health plan in the previous plan year")
rule S9825AnnualReportDuty(plan: GroupHealthPlan, sponsor: Person, y: TaxableYear, deadline: Date) strict {
    label en official "section 9825(a): the plan shall submit the full pharmacy-benefits report by the applicable June 1 (or first-year) deadline";
    when pharmacy_report_content_complete(plan, y)
        and pharmacy_report_deadline(y, deadline)
        and plan_sponsor(plan, sponsor);
    then duty S9825AnnualReport {
        bearer sponsor;
        beneficiary sponsor;
        goal achievement {
            condition pharmacy_report_submitted_on(plan, y, _);
            window [-infinity, deadline];
        }
    };
}

// --- (c): privacy protection — addressed to the SECRETARY (an `Organ`, not
// a `Person`), whose compilation of the (b) public report this package does
// not otherwise model. `prohibition`'s `bearer` slot is `Person`-typed in
// every exemplar this corpus uses (jp.constitution, kz.constitution); the
// Secretary is a core `Organ` constant, not a `Person` subtype, so this is
// classified (not derived as a `prohibition` position) rather than forcing
// a type mismatch or inventing a `Person` standing in for the agency.

@source(IRC_S9825_C, relation = formalizes, coverage = exact, quote = "No confidential or trade secret information submitted to the Secretary under subsection (a) shall be included in the report under subsection (b).")
pub relation confidential_information_included_in_public_report(info: Person) kind empirical {
    label en unofficial "case fact: confidential or trade-secret information submitted under (a) was included in the Secretary's (b) public report";
}
pub relation confidentiality_protection_breached(info: Person) kind institutional {
    label en official "section 9825(c): confidential/trade-secret information was, contrary to this section, included in the public report — classification of the breach (addressed to the Secretary, an Organ, not modeled as a Person-bearer `prohibition` position)";
}
rule ConfidentialityProtectionBreached(info: Person) strict {
    when confidential_information_included_in_public_report(info);
    then confidentiality_protection_breached(info);
}
