// 26 U.S.C. §9818 — Continuity of care (ensuring continuity of care when a
// provider/facility's contractual relationship with the plan terminates).
// NOTE: the task's own outline described this scope (90-day continuation for
// a "continuing care patient") under §9822; the PINNED text shows §9818 is
// actually captioned "Continuity of care" and carries this duty, while
// §9822 is "Other patient protections" (choice of PCP/pediatric/OB-GYN
// access, formalized separately in 12-patient-protections-9822.law). Flagged
// per the task's own "check pinned" proviso. Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9818_A,
    IRC_S9818_B,
    Person,
    plan_sponsor,
};

pub enum ContinuingCarePatientGround {
    SeriousComplexConditionTreatment;
    InstitutionalOrInpatientCare;
    ScheduledNonelectiveSurgery;
    PregnancyTreatment;
    TerminallyIllTreatment;
}
@source(IRC_S9818_B, relation = formalizes, coverage = partial, quote = "The term \"continuing care patient\" means an individual who, with respect to a provider or facility")
pub relation continuing_care_patient_ground(person: Person, provider: Person, ground: ContinuingCarePatientGround) kind empirical {
    label en unofficial "case fact/classification: person is a continuing care patient with respect to provider on the named section 9818(b)(1)(A)-(E) ground (the (2) 'serious and complex condition' sub-test is bundled into ground A rather than separately derived: TECH_GAP for the acute/chronic sub-classification)";
}
pub relation continuing_care_patient(person: Person, provider: Person) kind institutional {
    label en official "section 9818(b)(1): person is a continuing care patient with respect to provider";
}
rule ContinuingCarePatient(person: Person, provider: Person, ground: ContinuingCarePatientGround) strict {
    when continuing_care_patient_ground(person, provider, ground);
    then continuing_care_patient(person, provider);
}

pub enum ContractTerminationGround { ContractExpiredOrNotRenewed; TerminatedForQualityFailureOrFraud; }
@source(IRC_S9818_B, relation = formalizes, coverage = exact, quote = "The term \"terminated\" includes, with respect to a contract, the expiration or nonrenewal of the contract, but does not include a termination of the contract for failure to meet applicable quality standards or for fraud.")
pub relation contract_termination_ground(plan: GroupHealthPlan, provider: Person, ground: ContractTerminationGround) kind empirical {
    label en unofficial "case fact/classification: the way the plan/provider contractual relationship ended (section 9818(b)(3))";
}
pub relation contract_terminated_9818(plan: GroupHealthPlan, provider: Person) kind institutional {
    label en official "section 9818(b)(3): the contract was 'terminated' for section 9818(a)(1)(A) purposes (expiration/nonrenewal counts; a quality-failure or fraud termination does NOT)";
}
rule ContractTerminated9818(plan: GroupHealthPlan, provider: Person) strict {
    when contract_termination_ground(plan, provider, ContractExpiredOrNotRenewed);
    then contract_terminated_9818(plan, provider);
}

// --- (a)(1): the triggering events -----------------------------------------

pub enum Section9818TriggerKind {
    ContractualRelationshipTerminated;
    BenefitsTerminatedByParticipationChange;
    IssuerContractTerminated;
}
pub relation section_9818_trigger(person: Person, provider: Person, plan: GroupHealthPlan, kind: Section9818TriggerKind, on: Date) kind empirical {
    label en unofficial "case fact: with respect to person (a continuing care patient of provider under plan), one of the three section 9818(a)(1)(A)-(C) triggering events occurred on this date";
}
pub relation section_9818_applies(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) kind institutional {
    label en official "section 9818(a)(1) gate: person is a continuing care patient of provider and a triggering event occurred under plan";
}
rule Section9818AppliesContractTerminated(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) strict {
    when continuing_care_patient(person, provider)
        and section_9818_trigger(person, provider, plan, ContractualRelationshipTerminated, on)
        and contract_terminated_9818(plan, provider);
    then section_9818_applies(person, provider, plan, on);
}
rule Section9818AppliesBenefitsTerminated(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) strict {
    when continuing_care_patient(person, provider)
        and section_9818_trigger(person, provider, plan, BenefitsTerminatedByParticipationChange, on);
    then section_9818_applies(person, provider, plan, on);
}
rule Section9818AppliesIssuerContractTerminated(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) strict {
    when continuing_care_patient(person, provider)
        and section_9818_trigger(person, provider, plan, IssuerContractTerminated, on);
    then section_9818_applies(person, provider, plan, on);
}

// --- (a)(2): the plan's three requirements ----------------------------------

pub relation continuity_notice_sent(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the plan notified the individual of the termination and the right to elect continued transitional care (section 9818(a)(2)(A))";
}
@source(IRC_S9818_A, relation = formalizes, coverage = partial, quote = "notify each individual enrolled under such plan who is a continuing care patient with respect to a provider or facility at the time of a termination described in paragraph (1) affecting such provider on a timely basis of such termination and such individual's right to elect continued transitional care from such provider or facility under this section")
rule S9818NotificationDuty(person: Person, provider: Person, plan: GroupHealthPlan, sponsor: Person, triggered: Date) strict {
    label en official "section 9818(a)(2)(A): the plan must notify the continuing care patient of the termination and the election right, on a timely basis";
    when section_9818_applies(person, provider, plan, triggered) and plan_sponsor(plan, sponsor);
    then duty S9818Notification {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition continuity_notice_sent(person, provider, plan, _);
            window [triggered, infinity];
        }
    };
}

pub relation elects_continued_transitional_care(person: Person, provider: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the individual elected to continue benefits from the provider/facility under section 9818(a)(2)(C)";
}
pub relation still_continuing_care_patient_on(person: Person, provider: Person, on: Date) kind empirical {
    label en unofficial "case fact: the individual is still a continuing care patient with respect to the provider/facility on this date (section 9818(a)(2)(C)(ii))";
}

@source(IRC_S9818_A, relation = formalizes, coverage = exact, quote = "permit the patient to elect to continue to have benefits provided under such plan, under the same terms and conditions as would have applied and with respect to such items and services as would have been covered under such plan had such termination not occurred")
pub relation transitional_benefits_provided(person: Person, provider: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: on this date, the plan provided benefits for the provider's course of treatment as if the termination had not occurred";
}
// JUDGMENT CALL: the window below uses only the outer 90-day cap of
// section 9818(a)(2)(C)(i); the "OR earlier if the individual is no longer
// a continuing care patient" branch (C)(ii) is not separately modeled as an
// early-termination condition on the maintenance goal (TECH_GAP: no
// `<= min(...)`-style window-shortening construct is available; see
// TECH-GAPS.md).
rule S9818TransitionalCareDuty(person: Person, provider: Person, plan: GroupHealthPlan, sponsor: Person, notice_sent: Date) strict {
    label en official "section 9818(a)(2)(C): once elected, the plan must continue benefits under the pre-termination terms through the earlier of the 90-day period after notice or the date the individual is no longer a continuing care patient";
    when continuity_notice_sent(person, provider, plan, notice_sent)
        and elects_continued_transitional_care(person, provider, plan)
        and plan_sponsor(plan, sponsor);
    then duty S9818TransitionalCare {
        bearer sponsor;
        beneficiary person;
        goal maintenance {
            condition transitional_benefits_provided(person, provider, plan, notice_sent);
            window [notice_sent, add_calendar_period(notice_sent, 90 calendar_day)];
        }
    };
}
