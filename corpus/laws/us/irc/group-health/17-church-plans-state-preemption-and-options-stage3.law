// Stage 3 (TECH_GAP reduction), part A: section 9802(f) (church plans: evidence of good health), 9811(e) (preemption by State
// law) and 9812(d) (separate application to each benefit package option).
//
// The exceptions edit the prohibitions they qualify IN PLACE (`not_known` guard in the `when` of the existing rules of modules 02
// and 03) instead of adding parallel producers, so no guard is bypassed.
//
// JUDGMENT CALLS:
// (1) "evidence of good health" is read as the section 9802(a)(1) factors HealthStatus and EvidenceOfInsurability; the church-plan
//     exception is applied to the eligibility prohibition of section 9802(a) only ("solely because such plan requires evidence of good
//     health for coverage"), not to the premium rules of (b).
// (2) The grandfather clause of (f) ("the plan included the provisions ... on July 15, 1997, and at all times thereafter before the
//     beginning of such year") is derived from a recorded provision-on-1997-07-15 fact and the recorded dates on which the provisions
//     ceased; a cessation before the beginning of the plan year defeats the exception.
// (3) A State law "that regulates such coverage" is a fact linking the law to the plan's health insurance coverage; the
//     substance of the three alternative State laws is asserted (the State's own text is not this package's).
// (4) Section 9812(d): a benefit package option is an entity that IS a group health plan for section 9812 (the entity
//     `BenefitPackageOption` is a subtype of `GroupHealthPlan`), so every section 9812 rule already applies to each option
//     separately as long as the option's own facts (sponsor, benefits, limits) are recorded on the option.

// =====================================================================
// Section 9802(f): church plans
// =====================================================================

use self::{
    GroupHealthPlan,
    HealthFactor,
    IRC_S9802_F,
    IRC_S9811_E,
    IRC_S9812_D,
    Person,
    eligibility_rule_based_on_factor,
};

pub relation church_plan(plan: GroupHealthPlan) kind institutional {
    label en unofficial "the plan is a church plan as defined in section 414(e) (EXTERNAL_DEPENDENCY on section 414(e), carried as a fact)";
}
pub relation church_plan_year_begins(plan: GroupHealthPlan, begins: Date) kind empirical {
    label en unofficial "section 9802(f): the plan year under consideration begins on this date";
}
pub relation church_plan_good_health_provisions_on_july_15_1997(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9802(f): the plan included the good-health evidence provisions on July 15, 1997";
}
pub relation church_plan_good_health_provisions_ceased_on(plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "section 9802(f): the plan ceased to include the good-health evidence provisions on this date";
}
relation church_plan_provisions_lapsed_before(plan: GroupHealthPlan, begins: Date) kind institutional {
    label en unofficial "helper: the good-health provisions ceased before the plan year began (existential closure of the cessation dates)";
}
rule ChurchPlanProvisionsLapsedBefore(plan: GroupHealthPlan, begins: Date, ceased: Date) strict {
    when church_plan_year_begins(plan, begins) and church_plan_good_health_provisions_ceased_on(plan, ceased) and ceased < begins;
    then church_plan_provisions_lapsed_before(plan, begins);
}
pub relation church_plan_grandfathered_for_year(plan: GroupHealthPlan, begins: Date) kind institutional {
    label en official "section 9802(f) last sentence: the subsection applies to the plan for the year beginning on this date, because the plan included the provisions on July 15, 1997 and at all times thereafter before the year began";
}
@source(IRC_S9802_F, relation = formalizes, coverage = exact, quote = "This subsection shall apply to a plan for any year only if the plan included the provisions described in the preceding sentence on July 15, 1997, and at all times thereafter before the beginning of such year.")
rule ChurchPlanGrandfathered(plan: GroupHealthPlan, begins: Date) strict {
    when church_plan(plan)
        and church_plan_year_begins(plan, begins)
        and church_plan_good_health_provisions_on_july_15_1997(plan)
        and not_known(church_plan_provisions_lapsed_before(plan, begins));
    then church_plan_grandfathered_for_year(plan, begins);
}
pub relation church_plan_requires_good_health_for_small_employer_employees_and_self_employed(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9802(f)(1): the plan requires evidence of good health for coverage of BOTH any employee of an employer with 10 or fewer employees and any self-employed individual";
}
pub relation church_plan_requires_good_health_for_late_enrollees(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9802(f)(2): the plan requires evidence of good health for coverage of an individual who enrolls after the first 90 days of initial eligibility";
}
pub relation person_employee_of_employer_with_10_or_fewer(person: Person) kind empirical {
    label en unofficial "section 9802(f)(1): the person is an employee of an employer with 10 or fewer employees (determined without regard to section 414(e)(3)(C))";
}
pub relation person_self_employed(person: Person) kind empirical {
    label en unofficial "section 9802(f)(1): the person is a self-employed individual";
}
pub relation initial_eligibility_began_on(person: Person, on: Date) kind empirical {
    label en unofficial "the date the person's initial eligibility under the plan began";
}
pub relation plan_enrolled_on(person: Person, on: Date) kind empirical {
    label en unofficial "the date the person enrolled under the plan";
}
pub relation person_enrolls_after_first_90_days(person: Person) kind institutional {
    label en official "section 9802(f)(2): the individual enrolls after the first 90 days of initial eligibility";
}
rule PersonEnrollsAfterFirst90Days(person: Person, eligible: Date, enrolled: Date) strict {
    when initial_eligibility_began_on(person, eligible) and plan_enrolled_on(person, enrolled) and enrolled > add_calendar_period(eligible, 90 calendar_day);
    then person_enrolls_after_first_90_days(person);
}
pub relation good_health_evidence_factor(factor: HealthFactor) kind institutional {
    label en unofficial "JUDGMENT CALL: the health factors that a requirement of evidence of good health is based on";
}
rule GoodHealthEvidenceFactorHealthStatus strict {
    then good_health_evidence_factor(HealthStatus);
}
rule GoodHealthEvidenceFactorInsurability strict {
    then good_health_evidence_factor(EvidenceOfInsurability);
}
pub relation church_plan_good_health_exception(plan: GroupHealthPlan, person: Person, factor: HealthFactor) kind institutional {
    label en official "section 9802(f): the church plan is not treated as failing the eligibility requirement of section 9802 solely because it requires evidence of good health for this person";
}
@source(IRC_S9802_F, relation = formalizes, coverage = exact, quote = "(1) both any employee of an employer with 10 or less employees (determined without regard to section 414(e)(3)(C)) and any self-employed individual, or")
rule ChurchPlanGoodHealthExceptionSmallEmployerEmployee(plan: GroupHealthPlan, person: Person, factor: HealthFactor, begins: Date) strict {
    when eligibility_rule_based_on_factor(plan, person, factor)
        and good_health_evidence_factor(factor)
        and church_plan_grandfathered_for_year(plan, begins)
        and church_plan_requires_good_health_for_small_employer_employees_and_self_employed(plan)
        and person_employee_of_employer_with_10_or_fewer(person);
    then church_plan_good_health_exception(plan, person, factor);
}
@source(IRC_S9802_F, relation = formalizes, coverage = exact, quote = "(1) both any employee of an employer with 10 or less employees (determined without regard to section 414(e)(3)(C)) and any self-employed individual, or")
rule ChurchPlanGoodHealthExceptionSelfEmployed(plan: GroupHealthPlan, person: Person, factor: HealthFactor, begins: Date) strict {
    when eligibility_rule_based_on_factor(plan, person, factor)
        and good_health_evidence_factor(factor)
        and church_plan_grandfathered_for_year(plan, begins)
        and church_plan_requires_good_health_for_small_employer_employees_and_self_employed(plan)
        and person_self_employed(person);
    then church_plan_good_health_exception(plan, person, factor);
}
@source(IRC_S9802_F, relation = formalizes, coverage = exact, quote = "(2) any individual who enrolls after the first 90 days of initial eligibility under the plan.")
rule ChurchPlanGoodHealthExceptionLateEnrollee(plan: GroupHealthPlan, person: Person, factor: HealthFactor, begins: Date) strict {
    when eligibility_rule_based_on_factor(plan, person, factor)
        and good_health_evidence_factor(factor)
        and church_plan_grandfathered_for_year(plan, begins)
        and church_plan_requires_good_health_for_late_enrollees(plan)
        and person_enrolls_after_first_90_days(person);
    then church_plan_good_health_exception(plan, person, factor);
}

// =====================================================================
// Section 9811(e): preemption by State law
// =====================================================================

pub entity StateLaw {
    label en unofficial "a State law (including a decision, rule, regulation or other State action having the effect of law) that regulates health insurance coverage";
}
pub relation plan_has_health_insurance_coverage(plan: GroupHealthPlan) kind empirical {
    label en unofficial "the plan's benefits are provided through health insurance coverage (section 9811(e) speaks of health insurance coverage, not of a self-insured plan)";
}
pub relation state_law_regulates_coverage_of(law: StateLaw, plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9811(e): the State law is for a State that regulates the plan's health insurance coverage";
}
pub relation state_law_requires_48_96_hour_stay(law: StateLaw) kind empirical {
    label en unofficial "section 9811(e)(1): the State law requires the coverage to provide at least a 48-hour hospital stay after a normal vaginal delivery and at least a 96-hour stay after a caesarean section";
}
pub relation state_law_requires_professional_guideline_care(law: StateLaw) kind empirical {
    label en unofficial "section 9811(e)(2): the State law requires maternity and pediatric care in accordance with guidelines of the American College of Obstetricians and Gynecologists, the American Academy of Pediatrics, or other established professional medical associations";
}
pub relation state_law_leaves_stay_to_attending_provider(law: StateLaw) kind empirical {
    label en unofficial "section 9811(e)(3): the State law requires, in connection with maternity coverage, that the length of stay be left to the decision of (or required to be made by) the attending provider in consultation with the mother";
}
pub relation state_law_preempts_9811(plan: GroupHealthPlan) kind institutional {
    label en official "section 9811(e): the requirements of section 9811 do not apply to the health insurance coverage because a State law described in (1), (2) or (3) applies";
}
@source(IRC_S9811_E, relation = formalizes, coverage = exact, quote = "(1) Such State law requires such coverage to provide for at least a 48-hour hospital length of stay following a normal vaginal delivery and at least a 96-hour hospital length of stay following a caesarean section.")
rule StateLawPreempts9811ByMinimumStay(plan: GroupHealthPlan, law: StateLaw) strict {
    when plan_has_health_insurance_coverage(plan) and state_law_regulates_coverage_of(law, plan) and state_law_requires_48_96_hour_stay(law);
    then state_law_preempts_9811(plan);
}
@source(IRC_S9811_E, relation = formalizes, coverage = exact, quote = "(2) Such State law requires such coverage to provide for maternity and pediatric care in accordance with guidelines established by the American College of Obstetricians and Gynecologists, the American Academy of Pediatrics, or other established professional medical associations.")
rule StateLawPreempts9811ByGuidelines(plan: GroupHealthPlan, law: StateLaw) strict {
    when plan_has_health_insurance_coverage(plan) and state_law_regulates_coverage_of(law, plan) and state_law_requires_professional_guideline_care(law);
    then state_law_preempts_9811(plan);
}
@source(IRC_S9811_E, relation = formalizes, coverage = exact, quote = "(3) Such State law requires, in connection with such coverage for maternity care, that the hospital length of stay for such care is left to the decision of (or required to be made by) the attending provider in consultation with the mother.")
rule StateLawPreempts9811ByAttendingProviderDecision(plan: GroupHealthPlan, law: StateLaw) strict {
    when plan_has_health_insurance_coverage(plan) and state_law_regulates_coverage_of(law, plan) and state_law_leaves_stay_to_attending_provider(law);
    then state_law_preempts_9811(plan);
}

// =====================================================================
// Section 9812(d): each benefit package option is tested on its own
// =====================================================================

pub entity BenefitPackageOption : GroupHealthPlan {
    label en unofficial "one benefit package option under a group health plan; for section 9812 it is applied as a plan of its own (section 9812(d))";
}
pub relation benefit_package_option_of(option: BenefitPackageOption, plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9812(d): this option is one of the benefit package options the plan offers a participant or beneficiary";
}
pub relation section_9812_applied_separately(option: BenefitPackageOption) kind institutional {
    label en official "section 9812(d): the plan offers two or more benefit package options, so section 9812 is applied separately with respect to this option";
}
@source(IRC_S9812_D, relation = formalizes, coverage = exact, quote = "In the case of a group health plan that offers a participant or beneficiary two or more benefit package options under the plan, the requirements of this section shall be applied separately with respect to each such option.")
rule Section9812AppliedSeparately(option: BenefitPackageOption, plan: GroupHealthPlan) strict {
    when benefit_package_option_of(option, plan)
        and count(collect other: BenefitPackageOption where benefit_package_option_of(other, plan)) >= 2;
    then section_9812_applied_separately(option);
}
