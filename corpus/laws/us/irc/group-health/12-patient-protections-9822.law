// 26 U.S.C. §9822 — Other patient protections (choice of primary care
// provider, pediatric care access, OB/GYN direct access). NOTE: this is
// DISTINCT from §9818 "Continuity of care" (see that module's header for
// the correction to the task's own outline). Stage 1b (IRC-18-K).

// --- (a): choice of health care professional -------------------------------

use self::{
    GroupHealthPlan,
    IRC_S9822_A,
    IRC_S9822_B,
    IRC_S9822_C,
    Person,
    plan_sponsor,
};

pub relation plan_requires_pcp_designation(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan requires or provides for designation of a participating primary care provider (section 9822(a) gate)";
}
pub relation participating_pcp_available_to_accept(provider: Person, plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: this participating primary care provider is available to accept this individual under the plan";
}
pub relation plan_refused_pcp_designation(plan: GroupHealthPlan, person: Person, provider: Person) kind empirical {
    label en unofficial "case fact: the plan refused to permit the individual to designate this available participating primary care provider";
}
@source(IRC_S9822_A, relation = formalizes, coverage = exact, quote = "the plan shall permit each participant and beneficiary to designate any participating primary care provider who is available to accept such individual")
rule S9822AChoiceOfPcpProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for provider: Person;
    for sponsor: Person;
    when plan_requires_pcp_designation(plan)
        and participating_pcp_available_to_accept(provider, plan, person)
        and plan_refused_pcp_designation(plan, person, provider)
        and plan_sponsor(plan, sponsor);
    then prohibition S9822RefusalToPermitPcpChoice {
        bearer sponsor;
        action plan_refused_pcp_designation(plan, person, provider);
        window [-infinity, infinity];
    };
}

// --- (b): pediatric care ----------------------------------------------------

pub relation pediatrician_participates_in_network(pediatrician: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this pediatrician (allopathic or osteopathic) participates in the plan's network (section 9822(b)(1))";
}
pub relation plan_refused_pediatrician_as_pcp(plan: GroupHealthPlan, child: Person, pediatrician: Person) kind empirical {
    label en unofficial "case fact: the plan refused to permit the designation of this participating pediatrician as the child's primary care provider";
}
@source(IRC_S9822_B, relation = formalizes, coverage = exact, quote = "the plan shall permit such person to designate a physician (allopathic or osteopathic) who specializes in pediatrics as the child's primary care provider if such provider participates in the network of the plan")
rule S9822BPediatricCareProhibition defeasible {
    for plan: GroupHealthPlan;
    for child: Person;
    for pediatrician: Person;
    for sponsor: Person;
    when plan_requires_pcp_designation(plan)
        and pediatrician_participates_in_network(pediatrician, plan)
        and plan_refused_pediatrician_as_pcp(plan, child, pediatrician)
        and plan_sponsor(plan, sponsor);
    then prohibition S9822RefusalToPermitPediatricianAsPcp {
        bearer sponsor;
        action plan_refused_pediatrician_as_pcp(plan, child, pediatrician);
        window [-infinity, infinity];
    };
}

// --- (c): OB/GYN direct access ----------------------------------------------

@source(IRC_S9822_C, relation = formalizes, coverage = partial, quote = "A group health plan described in paragraph (2) may not require authorization or referral by the plan, issuer, or any person")
pub relation plan_provides_obgyn_coverage_and_requires_pcp(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan provides coverage for obstetric/gynecologic care and requires designation of a participating PCP (section 9822(c)(2) gate)";
}
pub relation obgyn_professional_participates(professional: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this health care professional who specializes in obstetrics or gynecology participates in the plan and agrees to adhere to its policies and procedures (section 9822(c)(1)(A))";
}
pub relation obgyn_direct_access_sought(plan: GroupHealthPlan, person: Person, professional: Person) kind empirical {
    label en unofficial "case fact: this female participant/beneficiary sought coverage for obstetrical or gynecological care from this participating OB/GYN professional (section 9822(c)(1)(A) gate, binds `person` for range restriction)";
}
pub relation plan_required_authorization_for_obgyn_care(plan: GroupHealthPlan, person: Person, professional: Person) kind empirical {
    label en unofficial "case fact: the plan (or issuer, or any person) required authorization or referral for OB/GYN care sought from this participating professional";
}
@source(IRC_S9822_C, relation = formalizes, coverage = exact, quote = "may not require authorization or referral by the plan, issuer, or any person (including a primary care provider described in paragraph (2)(B)) in the case of a female participant or beneficiary who seeks coverage for obstetrical or gynecological care provided by a participating health care professional who specializes in obstetrics or gynecology")
rule S9822CObgynDirectAccessProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for professional: Person;
    for sponsor: Person;
    when plan_provides_obgyn_coverage_and_requires_pcp(plan)
        and obgyn_professional_participates(professional, plan)
        and obgyn_direct_access_sought(plan, person, professional)
        and plan_required_authorization_for_obgyn_care(plan, person, professional)
        and plan_sponsor(plan, sponsor);
    then prohibition S9822ObgynAuthorizationRequirement {
        bearer sponsor;
        action plan_required_authorization_for_obgyn_care(plan, person, professional);
        window [-infinity, infinity];
    };
}

@source(IRC_S9822_C, relation = formalizes, coverage = exact, quote = "A group health plan described in paragraph (2) shall treat the provision of obstetrical and gynecological care, and the ordering of related obstetrical and gynecological items and services, pursuant to the direct access described under subparagraph (A), by a participating health care professional who specializes in obstetrics or gynecology as the authorization of the primary care provider.")
pub relation obgyn_care_deemed_pcp_authorized(plan: GroupHealthPlan, person: Person, professional: Person) kind institutional {
    label en official "section 9822(c)(1)(B): OB/GYN care and orders under direct access are deemed authorized by the primary care provider";
}
rule ObgynCareDeemedPcpAuthorized(plan: GroupHealthPlan, person: Person, professional: Person) strict {
    when plan_provides_obgyn_coverage_and_requires_pcp(plan)
        and obgyn_professional_participates(professional, plan)
        and obgyn_direct_access_sought(plan, person, professional);
    then obgyn_care_deemed_pcp_authorized(plan, person, professional);
}
