// 26 U.S.C. §9815 (incorporation of PHSA part A market reforms), §9816
// (a)-(c) (preventing surprise medical bills: emergency services, IDR
// windows), §9820(a)-(c) (provider directories, cost-sharing on incorrect
// directory information, patient-protection disclosure). Priority scope per
// task instructions.
//
// BUSINESS-DAY TECH_GAP (declared once, applies to every "N business day"
// window below): `us.irc.administration`'s own §7503 module found that the
// language's closed computable surface has no "count N business days
// forward" step — `add_calendar_period`'s unit count must be a literal and
// there is no calendar-aware successor function; the ROLLED-FORWARD /
// COUNTED-FORWARD date must be a case-asserted candidate that a rule
// VALIDATES, not a value this package computes from a start date and a
// literal N (see administration/02-weekend-holiday-rollover.law header).
// This package follows the identical pattern: `nth_business_day_after` is a
// relation the case (or, once wired up, `administration`'s own calendar
// resource) asserts; this package's rules only compare against it.

use self::{
    GroupHealthPlan,
    IRC_S9815_A,
    IRC_S9815_B,
    IRC_S9816_A,
    IRC_S9816_C,
    IRC_S9816_F,
    IRC_S9820_A,
    IRC_S9820_B,
    Person,
    plan_sponsor,
};

pub relation nth_business_day_after(from: Date, n: Integer, on: Date) kind empirical {
    label en unofficial "case fact (TECH_GAP surface, see module header): `on` is the n-th business day after `from`, under the federal business-day calendar of section 7503 (owned by us.irc.administration, which itself declares no pub calendar resource yet — see its own EXTERNAL_DEPENDENCY note). Asserted directly by the case until that resource is wired up.";
}

// ===========================================================================
// §9815 — incorporation of PHSA part A market reforms (EXTERNAL_DEPENDENCY)
// ===========================================================================

@source(IRC_S9815_A, relation = formalizes, coverage = exact, quote = "the provisions of part A of title XXVII of the Public Health Service Act (as amended by the Patient Protection and Affordable Care Act) shall apply to group health plans, and health insurance issuers providing health insurance coverage in connection with group health plans, as if included in this subchapter")
pub relation incorporates_phsa_part_a(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9815(a): part A of title XXVII of the Public Health Service Act (42 U.S.C. 300gg et seq., sections 2701-2728) applies to this plan as if written into this subchapter. EXTERNAL_DEPENDENCY: the incorporated PHSA sections are not this package's or even this corpus's text (no `us.phsa.*` package exists); this relation names the dependency without inventing PHSA's content.";
}
rule IncorporatesPhsaPartA(plan: GroupHealthPlan) strict {
    when plan_sponsor(plan, _);
    then incorporates_phsa_part_a(plan);
}
@source(IRC_S9815_B, relation = formalizes, coverage = exact, quote = "the provisions of sections 2716 and 2718 of title XXVII of the Public Health Service Act (as amended by the Patient Protection and Affordable Care Act) shall not apply with respect to self-insured group health plans")
pub relation self_insured_plan(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan is self-insured (section 9815(b) exception)";
}
pub relation phsa_2716_2718_excepted(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9815(b): sections 2716 (PHSA, additional standards) and 2718 (medical loss ratio) do not apply to this self-insured plan";
}
rule Phsa27162718Excepted(plan: GroupHealthPlan) strict {
    when self_insured_plan(plan);
    then phsa_2716_2718_excepted(plan);
}

// ===========================================================================
// §9816(a) — emergency services cost-sharing
// ===========================================================================

pub entity EmergencyServiceClaim {
    label en unofficial "one item/service furnished as an emergency service (section 9816(a)(3)(C)) to a participant or beneficiary";
}
pub relation emergency_claim_for(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this claim is for emergency services furnished to this person under this plan";
}
pub relation emergency_claim_nonparticipating(svc_claim: EmergencyServiceClaim) kind empirical {
    label en unofficial "case fact: the emergency services were furnished by a nonparticipating provider or nonparticipating emergency facility (section 9816(a)(1)(C))";
}
@source(IRC_S9816_A, relation = formalizes, coverage = partial, quote = "The term \"recognized amount\" means, with respect to an item or service furnished by a nonparticipating provider or nonparticipating emergency facility during a year and a group health plan—")
pub relation recognized_amount(svc_claim: EmergencyServiceClaim, amount: Money) kind empirical {
    label en unofficial "case fact: the section 9816(a)(3)(H) recognized amount for this claim (specified-State-law amount, or the qualifying payment amount, or the All-Payer Model Agreement amount, as applicable — the METHODOLOGY of each branch is regulatory/EXTERNAL_DEPENDENCY per (a)(2)(B) rulemaking; this package takes the resulting figure as asserted)";
}
pub relation in_network_cost_sharing_amount(svc_claim: EmergencyServiceClaim, amount: Money) kind institutional {
    label en unofficial "the cost-sharing amount that would apply under the plan if the recognized amount were charged by a participating provider (section 9816(a)(1)(C)(iii)) — computed via the plan's ordinary in-network cost-sharing rate, itself a case-asserted plan-design fact";
}
pub relation plan_in_network_cost_sharing_rate(plan: GroupHealthPlan, rate: Decimal) kind empirical {
    label en unofficial "case fact: the plan's cost-sharing rate (e.g. 0.20 for 20% coinsurance) that would apply to a participating-provider claim of the same kind";
}
rule InNetworkCostSharingAmount(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, recognized: Money, rate: Decimal) strict {
    when emergency_claim_for(svc_claim, person, plan)
        and recognized_amount(svc_claim, recognized)
        and plan_in_network_cost_sharing_rate(plan, rate);
    then in_network_cost_sharing_amount(svc_claim, recognized * rate);
}
pub relation actual_cost_sharing_imposed(svc_claim: EmergencyServiceClaim, amount: Money) kind empirical {
    label en unofficial "case fact: the cost-sharing amount the plan actually imposed on the participant/beneficiary for this claim";
}
@source(IRC_S9816_A, relation = formalizes, coverage = exact, quote = "the cost-sharing requirement is not greater than the requirement that would apply if such services were provided by a participating provider or a participating emergency facility")
pub relation surprise_bill_cost_sharing_excessive(svc_claim: EmergencyServiceClaim) kind institutional {
    label en unofficial "classification: the plan imposed cost-sharing on this emergency claim greater than the in-network-equivalent amount";
}
rule SurpriseBillCostSharingExcessive(svc_claim: EmergencyServiceClaim, actual: Money, cap: Money) strict {
    when actual_cost_sharing_imposed(svc_claim, actual)
        and in_network_cost_sharing_amount(svc_claim, cap)
        and actual > cap;
    then surprise_bill_cost_sharing_excessive(svc_claim);
}
rule S9816AExcessiveCostSharingProhibition(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, sponsor: Person, actual: Money) defeasible {
    when surprise_bill_cost_sharing_excessive(svc_claim)
        and emergency_claim_for(svc_claim, person, plan)
        and emergency_claim_nonparticipating(svc_claim)
        and actual_cost_sharing_imposed(svc_claim, actual)
        and plan_sponsor(plan, sponsor);
    then prohibition S9816ExcessiveCostSharing {
        bearer sponsor;
        action actual_cost_sharing_imposed(svc_claim, actual);
        window [-infinity, infinity];
    };
}
// The pub interface symbol the assignment names ("surprise_bill_cost_sharing"):
pub relation surprise_bill_cost_sharing(svc_claim: EmergencyServiceClaim, amount: Money) kind institutional {
    label en unofficial "the cost-sharing amount section 9816(a) PERMITS the plan to impose on this emergency claim — equal to the in-network-equivalent amount computed above";
}
rule SurpriseBillCostSharingIsCap(svc_claim: EmergencyServiceClaim, cap: Money) strict {
    when in_network_cost_sharing_amount(svc_claim, cap);
    then surprise_bill_cost_sharing(svc_claim, cap);
}

@source(IRC_S9816_A, relation = formalizes, coverage = partial, quote = "not later than 30 calendar days after the bill for such services is transmitted by such provider or facility, sends to the provider or facility, as applicable, an initial payment or notice of denial of payment")
pub relation bill_transmitted_on(svc_claim: EmergencyServiceClaim, on: Date) kind empirical {
    label en unofficial "case fact: the date the provider/facility transmitted the bill for this emergency claim";
}
pub relation initial_payment_or_denial_sent_on(svc_claim: EmergencyServiceClaim, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan sent an initial payment or a notice of denial for this claim";
}
rule S9816AInitialPaymentOrDenialDuty(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, sponsor: Person, transmitted: Date) strict {
    label en official "section 9816(a)(1)(D)(iv)(I): the plan must send an initial payment or notice of denial within 30 calendar days of the bill being transmitted";
    when bill_transmitted_on(svc_claim, transmitted)
        and emergency_claim_for(svc_claim, person, plan)
        and plan_sponsor(plan, sponsor);
    then duty S9816InitialPaymentOrDenial {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition initial_payment_or_denial_sent_on(svc_claim, _);
            window [transmitted, add_calendar_period(transmitted, 30 calendar_day)];
        }
    };
}

// ===========================================================================
// §9816(c) — determination of out-of-network rates; IDR windows
// ===========================================================================

pub entity IdrDispute {
    label en unofficial "one independent-dispute-resolution matter over the out-of-network rate for a qualified IDR item or service (section 9816(c))";
}
pub relation idr_dispute_for(dispute: IdrDispute, svc_claim: EmergencyServiceClaim) kind empirical {
    label en unofficial "case fact: this IDR dispute concerns this claim";
}
pub relation initial_payment_or_denial_received_on(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date the provider/facility received the initial payment or notice of denial that starts the section 9816(c)(1)(A) 30-day open-negotiation window";
}

@source(IRC_S9816_C, relation = formalizes, coverage = exact, quote = "the provider or facility (as applicable) or plan may, during the 30-day period beginning on the day the provider or facility receives an initial payment or a notice of denial of payment from the plan regarding a claim for payment for such item or service, initiate open negotiations")
pub relation open_negotiation_initiated_on(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date open negotiation was initiated";
}
pub relation open_negotiation_timely(dispute: IdrDispute) kind institutional {
    label en unofficial "the section 9816(c)(1)(A) open negotiation was initiated within the 30-day window";
}
rule OpenNegotiationTimely(dispute: IdrDispute, received: Date, initiated: Date) strict {
    when initial_payment_or_denial_received_on(dispute, received)
        and open_negotiation_initiated_on(dispute, initiated)
        and initiated >= received
        and initiated <= add_calendar_period(received, 30 calendar_day);
    then open_negotiation_timely(dispute);
}

@source(IRC_S9816_C, relation = formalizes, coverage = exact, quote = "the provider or facility (as applicable) or group health plan that was party to such negotiations may, during the 4-day period beginning on the day after such open negotiation period, initiate the independent dispute resolution process")
pub relation idr_process_initiated_on(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date a party submitted the IDR-initiation notification";
}
pub relation idr_initiation_timely(dispute: IdrDispute) kind institutional {
    label en unofficial "the section 9816(c)(1)(B) IDR-process initiation was made within the 4-day window after the open negotiation period ended";
}
rule IdrInitiationTimely(dispute: IdrDispute, received: Date, initiated: Date) strict {
    label en official "section 9816(c)(1)(A)-(B): the open negotiation period is exactly 30 days after receipt; IDR initiation must follow within 4 days after that 30-day period ends";
    when initial_payment_or_denial_received_on(dispute, received)
        and idr_process_initiated_on(dispute, initiated)
        and initiated > add_calendar_period(received, 30 calendar_day)
        and initiated <= add_calendar_period(add_calendar_period(received, 30 calendar_day), 4 calendar_day);
    then idr_initiation_timely(dispute);
}

@source(IRC_S9816_C, relation = formalizes, coverage = exact, quote = "Not later than 10 days after the date of selection of the certifed IDR entity with respect to a determination for a qualified IDR item or service")
pub relation idr_entity_selected_on(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date the certified IDR entity was selected (jointly, or by the Secretary) for this dispute";
}
pub relation idr_offer_submitted_on(dispute: IdrDispute, party: Person, on: Date) kind empirical {
    label en unofficial "case fact: the date this party (provider/facility or plan) submitted its payment offer to the certified IDR entity";
}
rule S9816COfferSubmissionDuty(dispute: IdrDispute, svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, sponsor: Person, selected: Date) strict {
    label en official "section 9816(c)(5)(B): each party shall submit its offer not later than 10 days after selection of the certified IDR entity";
    when idr_entity_selected_on(dispute, selected)
        and idr_dispute_for(dispute, svc_claim)
        and emergency_claim_for(svc_claim, person, plan)
        and plan_sponsor(plan, sponsor);
    then duty S9816OfferSubmission {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition idr_offer_submitted_on(dispute, sponsor, _);
            window [selected, add_calendar_period(selected, 10 calendar_day)];
        }
    };
}

@source(IRC_S9816_C, relation = formalizes, coverage = exact, quote = "Not later than 30 days after the date of selection of the certified IDR entity with respect to a determination for a qualified IDR item or service, the certified IDR entity shall")
pub relation idr_determination_made_on(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date the certified IDR entity made its payment determination";
}
pub relation idr_determination_timely(dispute: IdrDispute) kind institutional {
    label en unofficial "the section 9816(c)(5)(A) 30-day determination window was met";
}
rule IdrDeterminationTimely(dispute: IdrDispute, selected: Date, determined: Date) strict {
    when idr_entity_selected_on(dispute, selected)
        and idr_determination_made_on(dispute, determined)
        and determined <= add_calendar_period(selected, 30 calendar_day);
    then idr_determination_timely(dispute);
}

@source(IRC_S9816_C, relation = formalizes, coverage = exact, quote = "that allows for the group health plan and the nonparticipating provider or the nonparticipating emergency facility (as applicable) involved in a notification under paragraph (1)(B) to jointly select, not later than the last day of the 3-business day period following the date of the initiation of the process with respect to such item or service")
pub relation idr_entity_jointly_selected_by(dispute: IdrDispute, on: Date) kind empirical {
    label en unofficial "case fact: the date the parties jointly selected the certified IDR entity (section 9816(c)(4)(F)(i), a 3-BUSINESS-day window — see module header TECH_GAP: business-day counting is validated via `nth_business_day_after`, not computed)";
}
pub relation idr_joint_selection_timely(dispute: IdrDispute) kind institutional {
    label en unofficial "the joint selection of the certified IDR entity was made within the 3-business-day window";
}
rule IdrJointSelectionTimely(dispute: IdrDispute, initiated: Date, deadline: Date, selected: Date) strict {
    when idr_process_initiated_on(dispute, initiated)
        and nth_business_day_after(initiated, 3, deadline)
        and idr_entity_jointly_selected_by(dispute, selected)
        and selected <= deadline;
    then idr_joint_selection_timely(dispute);
}

// ===========================================================================
// §9816(f) — advance explanation of benefits (advanced EOB)
// ===========================================================================

pub entity AdvanceEobRequest {
    label en unofficial "one section 2799B-6 PHSA notification from a provider/facility, or a participant/beneficiary request, that starts the section 9816(f) advance-EOB clock";
}
pub relation eob_request_for(request: AdvanceEobRequest, person: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this request/notification concerns this person's scheduled item or service under this plan";
}
pub relation eob_request_received_on(request: AdvanceEobRequest, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan received the notification or request";
}
@source(IRC_S9816_F, relation = formalizes, coverage = partial, quote = "in the case such item or service was so scheduled at least 10 business days before such item or service is to be furnished (or in the case of a request made to such plan or coverage by such participant or beneficiary), 3 business days")
pub relation eob_scheduled_at_least_10_business_days_ahead(request: AdvanceEobRequest) kind empirical {
    label en unofficial "case fact: the item/service was scheduled at least 10 business days before it is to be furnished, OR the notification arose from the participant/beneficiary's own request — both trigger the 3-business-day (rather than 1-business-day) window";
}
pub relation advanced_eob_provided_on(request: AdvanceEobRequest, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan provided the advance EOB notification";
}
// advanced_eob_due: the pub interface symbol the assignment names.
pub relation advanced_eob_due(request: AdvanceEobRequest, deadline: Date) kind institutional {
    label en official "section 9816(f)(1): the deadline for the plan to provide the advance EOB — 1 business day after receipt, or 3 business days if the item/service was scheduled >=10 business days ahead or the notification was a participant/beneficiary request";
}
rule AdvancedEobDueOneBusinessDay(request: AdvanceEobRequest, received: Date, deadline: Date) defeasible {
    when eob_request_received_on(request, received)
        and nth_business_day_after(received, 1, deadline);
    then advanced_eob_due(request, deadline);
    unless eob_request_received_on(request, received)
        and nth_business_day_after(received, 1, deadline)
        and eob_scheduled_at_least_10_business_days_ahead(request);
}
rule AdvancedEobDueThreeBusinessDays(request: AdvanceEobRequest, received: Date, deadline: Date) strict {
    when eob_request_received_on(request, received)
        and eob_scheduled_at_least_10_business_days_ahead(request)
        and nth_business_day_after(received, 3, deadline);
    then advanced_eob_due(request, deadline);
}
rule S9816FAdvancedEobDuty(request: AdvanceEobRequest, person: Person, plan: GroupHealthPlan, sponsor: Person, deadline: Date) strict {
    label en official "section 9816(f)(1): the plan shall provide the advance EOB notification by the applicable business-day deadline";
    when advanced_eob_due(request, deadline)
        and eob_request_for(request, person, plan)
        and plan_sponsor(plan, sponsor);
    then duty S9816AdvancedEob {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition advanced_eob_provided_on(request, _);
            window [-infinity, deadline];
        }
    };
}

// ===========================================================================
// §9820(a)-(c) — provider directories, incorrect-information cost-sharing,
// balance-billing disclosure
// ===========================================================================

@source(IRC_S9820_A, relation = formalizes, coverage = partial, quote = "not less frequently than once every 90 days, such plan verifies and updates the provider directory information")
pub relation directory_verified_on(plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan last verified/updated its provider directory database (section 9820(a)(2)(A))";
}
// JUDGMENT CALL / TECH_GAP: section 9820(a)(2)(A) is a periodic maintenance
// duty ("not less frequently than once every 90 days") whose beneficiary is
// the plan's enrollee population generally, not any single named `Person`
// bound by a case fact (unlike sections 9801(e)/9812(a)(4), which name the
// requester). A `duty` position requires a bound `beneficiary`; inventing
// one (e.g. the sponsor itself) would misstate who the norm protects. Left
// as the classification relation below (verified-on-date, overdue), not a
// `duty` position — see coverage row 26/9820/a/2/a/u1.
pub relation directory_verification_asked_on(plan: GroupHealthPlan, asof: Date) kind empirical {
    label en unofficial "case fact: the date a scenario asks whether the plan's directory verification is overdue (binds `asof`, per §190)";
}
pub relation directory_verification_overdue(plan: GroupHealthPlan, last: Date, asof: Date) kind institutional {
    label en unofficial "classification: more than 90 days elapsed between the plan's last verification and the date asked about (section 9820(a)(2)(A))";
}
rule DirectoryVerificationOverdue(plan: GroupHealthPlan, last: Date, asof: Date) strict {
    when directory_verified_on(plan, last)
        and directory_verification_asked_on(plan, asof)
        and asof > last and days_between(last, asof) > 90;
    then directory_verification_overdue(plan, last, asof);
}

@source(IRC_S9820_A, relation = formalizes, coverage = exact, quote = "responds to such individual as soon as practicable and in no case later than 1 business day after such call is received")
pub relation directory_call_received_on(plan: GroupHealthPlan, caller: Person, on: Date) kind empirical {
    label en unofficial "case fact: the date an enrollee's telephone request under the response protocol was received";
}
pub relation directory_response_sent_on(plan: GroupHealthPlan, caller: Person, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan responded";
}
rule S9820AResponseProtocolDuty(plan: GroupHealthPlan, sponsor: Person, caller: Person, received: Date, deadline: Date) strict {
    label en official "section 9820(a)(3)(A): the plan shall respond to a telephone directory request no later than 1 business day after the call is received";
    when directory_call_received_on(plan, caller, received)
        and nth_business_day_after(received, 1, deadline)
        and plan_sponsor(plan, sponsor);
    then duty S9820ResponseProtocol {
        bearer sponsor;
        beneficiary caller;
        goal achievement {
            condition directory_response_sent_on(plan, caller, _);
            window [received, deadline];
        }
    };
}

// (b): cost-sharing protection when the participant relied on incorrect
// network information.
pub relation nonparticipating_item_furnished(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this claim's item/service was furnished by a nonparticipating provider/facility, but would be covered if furnished by a participating one (section 9820(b)(1))";
}
@source(IRC_S9820_B, relation = formalizes, coverage = partial, quote = "The participant or beneficiary received through a database, provider directory, or response protocol described in subsection (a) information with respect to such item and service to be furnished and such information provided that the provider was a participating provider")
pub relation relied_on_incorrect_directory_information(svc_claim: EmergencyServiceClaim) kind empirical {
    label en unofficial "case fact/classification: one of the section 9820(b)(2)(A)/(B) criteria is met — the participant received (or was told through the response protocol) incorrect information that the provider/facility was participating";
}
pub relation participating_equivalent_cost_sharing_amount(svc_claim: EmergencyServiceClaim, amount: Money) kind institutional {
    label en unofficial "the cost-sharing amount that would apply had the item/service been furnished by a participating provider/facility (section 9820(b)(1)(A) cap)";
}
rule ParticipatingEquivalentCostSharingAmount(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, recognized: Money, rate: Decimal) strict {
    when nonparticipating_item_furnished(svc_claim, person, plan)
        and recognized_amount(svc_claim, recognized)
        and plan_in_network_cost_sharing_rate(plan, rate);
    then participating_equivalent_cost_sharing_amount(svc_claim, recognized * rate);
}
rule S9820BExcessiveCostSharingOnIncorrectDirectoryProhibition(svc_claim: EmergencyServiceClaim, person: Person, plan: GroupHealthPlan, sponsor: Person, actual: Money, cap: Money) defeasible {
    label en official "section 9820(b)(1)(A): the plan may not impose cost-sharing greater than the participating-equivalent amount when the participant relied on incorrect directory information";
    when relied_on_incorrect_directory_information(svc_claim)
        and nonparticipating_item_furnished(svc_claim, person, plan)
        and actual_cost_sharing_imposed(svc_claim, actual)
        and participating_equivalent_cost_sharing_amount(svc_claim, cap)
        and actual > cap
        and plan_sponsor(plan, sponsor);
    then prohibition S9820ExcessiveCostSharingOnIncorrectDirectory {
        bearer sponsor;
        action actual_cost_sharing_imposed(svc_claim, actual);
        window [-infinity, infinity];
    };
}
