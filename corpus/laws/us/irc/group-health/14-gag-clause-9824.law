// 26 U.S.C. §9824 — Increasing transparency by removing gag clauses on
// price and quality information. Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9824_A,
    Person,
    TaxableYear,
    plan_sponsor,
};

pub enum GagClauseRestrictedDisclosure {
    ProviderSpecificCostOrQualityInfo;      // (a)(1)(A)
    ElectronicDeIdentifiedClaimsAccess;     // (a)(1)(B)
    SharingWithBusinessAssociate;           // (a)(1)(C)
}
@source(IRC_S9824_A, relation = formalizes, coverage = partial, quote = "A group health plan may not enter into an agreement with a health care provider, network or association of providers, third-party administrator, or other service provider offering access to a network of providers that would directly or indirectly restrict a group health plan from")
pub relation plan_entered_gag_clause_agreement(plan: GroupHealthPlan, counterparty: Person, restricted: GagClauseRestrictedDisclosure) kind empirical {
    label en unofficial "case fact: the plan entered an agreement with this counterparty (provider, network/association of providers, TPA, or other network-access service provider) that directly or indirectly restricts the plan from making the named section 9824(a)(1)(A)-(C) disclosure";
}
rule S9824GagClauseProhibition defeasible {
    for plan: GroupHealthPlan;
    for counterparty: Person;
    for restricted: GagClauseRestrictedDisclosure;
    for sponsor: Person;
    when plan_entered_gag_clause_agreement(plan, counterparty, restricted) and plan_sponsor(plan, sponsor);
    then prohibition S9824GagClauseAgreement {
        bearer sponsor;
        action plan_entered_gag_clause_agreement(plan, counterparty, restricted);
        window [-infinity, infinity];
    };
}

// --- (a)(3): annual attestation duty ----------------------------------------

pub relation gag_clause_attestation_submitted(plan: GroupHealthPlan, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the plan submitted its annual section 9824(a)(3) compliance attestation to the Secretary for this plan year";
}
// JUDGMENT CALL: `y` is bound via the sponsor's own `year_of` (us.irc.core)
// as a proxy for "plan year" — the statute's own "plan year" concept is not
// the same TaxableYear shape and this package does not build a separate
// PlanYear entity; adequate to key an annual duty, not exact for a sponsor
// whose taxable year differs from the plan year.
@source(IRC_S9824_A, relation = formalizes, coverage = exact, quote = "A group health plan shall annually submit to the Secretary an attestation that such plan is in compliance with the requirements of this subsection.")
rule S9824AttestationDuty(plan: GroupHealthPlan, sponsor: Person, y: TaxableYear) strict {
    label en official "section 9824(a)(3): the plan must annually attest compliance with subsection (a)";
    when plan_sponsor(plan, sponsor) and us.irc.core::year_of(sponsor, y);
    then duty S9824Attestation {
        bearer sponsor;
        beneficiary sponsor;
        goal maintenance {
            condition gag_clause_attestation_submitted(plan, y);
            window [-infinity, infinity];
        }
    };
}
