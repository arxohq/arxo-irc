// Stage 3 (TECH_GAP reduction), part B: section 9816(b) (non-emergency items and services furnished by nonparticipating
// providers at participating facilities), 9816(d) (database access fees), 9816(e) (identification cards) and 9820(c)
// (disclosure on patient protections against balance billing).
//
// JUDGMENT CALLS:
// (1) The notice and consent criteria of section 2799B-2(d) of the Public Health Service Act (an EXTERNAL_DEPENDENCY) are carried as a
//     fact of the claim; section 9816(b)(1) applies to a claim only if they were NOT satisfied.
// (2) The recognized amount, the out-of-network rate and the plan's in-network cost-sharing rate are asserted figures (their methods are
//     section 9816(a)(3)(H), (K) and regulations); the cap is the recognized amount times the in-network rate, in cents HALF_UP where the
//     text names no rounding.
// (3) The total plan payment is the out-of-network rate less the cost-sharing amount determined under (A)-(B); the timing is the 30 days
//     after the determination (section 9816(c)(6)), the determination date being a case fact.
// (4) "Any other facility, specified by the Secretary" (V) and "such other items and services as the Secretary may specify" are external
//     judgment relations with authority Secretary (DECISION-0194).

// =====================================================================
// Section 9816(b)(2): participating health care facility and visit
// =====================================================================

use self::{
    GroupHealthPlan,
    IRC_S9816_B,
    IRC_S9816_D,
    IRC_S9816_E,
    IRC_S9820_C,
    Person,
    plan_in_network_cost_sharing_rate,
    plan_sponsor,
};

pub entity HealthCareFacility {
    label en unofficial "a health care facility at which items and services are furnished to a participant or beneficiary";
}
pub enum HealthCareFacilityKind { Hospital; HospitalOutpatientDepartment; CriticalAccessHospital; AmbulatorySurgicalCenter; OtherFacility; }
pub relation health_care_facility_kind(facility: HealthCareFacility, kind: HealthCareFacilityKind) kind empirical {
    label en unofficial "the kind of the facility (section 9816(b)(2)(A)(ii)(I)-(V)): a hospital (section 1861(e) of the Social Security Act), a hospital outpatient department, a critical access hospital (section 1861(mm)(1)), an ambulatory surgical center (section 1833(i)(1)(A)), or any other facility";
}
pub external judgment relation secretary_specified_facility(facility: HealthCareFacility) {
    authority Secretary;
    label en official "section 9816(b)(2)(A)(ii)(V): the Secretary specified this other facility as one that provides items or services for which coverage is provided under the plan or coverage (DECISION-0194: the specification is the Secretary's)";
}
pub relation facility_contract_with_plan(facility: HealthCareFacility, plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9816(b)(2)(A)(i): the facility has a direct or indirect contractual relationship with the plan with respect to the furnishing of the item or service at the facility";
}
pub relation health_care_facility_described(facility: HealthCareFacility) kind institutional {
    label en official "section 9816(b)(2)(A)(ii): the facility is a hospital, a hospital outpatient department, a critical access hospital, an ambulatory surgical center, or another facility specified by the Secretary";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "(I) A hospital (as defined in 1861(e) of the Social Security Act).")
rule FacilityDescribedHospital(facility: HealthCareFacility) strict {
    when health_care_facility_kind(facility, Hospital);
    then health_care_facility_described(facility);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "(II) A hospital outpatient department.")
rule FacilityDescribedOutpatientDepartment(facility: HealthCareFacility) strict {
    when health_care_facility_kind(facility, HospitalOutpatientDepartment);
    then health_care_facility_described(facility);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "(III) A critical access hospital (as defined in section 1861(mm)(1) of such Act).")
rule FacilityDescribedCriticalAccessHospital(facility: HealthCareFacility) strict {
    when health_care_facility_kind(facility, CriticalAccessHospital);
    then health_care_facility_described(facility);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "(IV) An ambulatory surgical center described in section 1833(i)(1)(A) of such Act.")
rule FacilityDescribedAmbulatorySurgicalCenter(facility: HealthCareFacility) strict {
    when health_care_facility_kind(facility, AmbulatorySurgicalCenter);
    then health_care_facility_described(facility);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "(V) Any other facility, specified by the Secretary, that provides items or services for which coverage is provided under the plan or coverage, respectively.")
rule FacilityDescribedOtherSpecified(facility: HealthCareFacility) strict {
    when health_care_facility_kind(facility, OtherFacility) and secretary_specified_facility(facility);
    then health_care_facility_described(facility);
}
pub relation participating_health_care_facility(facility: HealthCareFacility, plan: GroupHealthPlan) kind institutional {
    label en official "section 9816(b)(2)(A)(i): a described facility that has a direct or indirect contractual relationship with the plan for the furnishing of the item or service";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "The term \"participating health care facility\" means, with respect to an item or service and a group health plan, a health care facility described in clause (ii) that has a direct or indirect contractual relationship with the plan, with respect to the furnishing of such an item or service at the facility.")
rule ParticipatingHealthCareFacility(facility: HealthCareFacility, plan: GroupHealthPlan) strict {
    when health_care_facility_described(facility) and facility_contract_with_plan(facility, plan);
    then participating_health_care_facility(facility, plan);
}

pub entity FacilityClaim {
    label en unofficial "one item or service (other than an emergency service to which section 9816(a) applies) furnished to a participant or beneficiary by a nonparticipating provider in connection with a visit at a health care facility";
}
pub enum VisitItemKind { EquipmentAndDevices; TelemedicineServices; ImagingServices; LaboratoryServices; PreoperativeOrPostoperativeServices; OtherItemOrService; }
pub relation facility_claim_for(fc: FacilityClaim, person: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "the claim is for an item or service furnished to this person under this plan";
}
pub relation facility_claim_visit_facility(fc: FacilityClaim, facility: HealthCareFacility) kind empirical {
    label en unofficial "the item or service was furnished with respect to a visit at this facility";
}
pub relation facility_claim_furnished_at_facility(fc: FacilityClaim) kind empirical {
    label en unofficial "the provider furnished the item or service at the facility";
}
pub relation facility_claim_item_kind(fc: FacilityClaim, kind: VisitItemKind) kind empirical {
    label en unofficial "the kind of the item or service, for the section 9816(b)(2)(B) definition of a visit";
}
pub external judgment relation secretary_specified_visit_item(fc: FacilityClaim) {
    authority Secretary;
    label en official "section 9816(b)(2)(B): the Secretary specified this item or service as included in a visit (DECISION-0194)";
}
pub relation facility_claim_covered_by_plan(fc: FacilityClaim) kind empirical {
    label en unofficial "section 9816(b)(1): benefits are provided or covered by the group health plan for this item or service";
}
pub relation facility_claim_nonparticipating_provider(fc: FacilityClaim, provider: Person) kind empirical {
    label en unofficial "the provider that furnished the item or service is a nonparticipating provider (section 9816(a)(3)(G)(i))";
}
pub relation facility_claim_notice_and_consent_satisfied(fc: FacilityClaim) kind empirical {
    label en unofficial "the provider satisfied the notice and consent criteria of section 2799B-2(d) of the Public Health Service Act (EXTERNAL_DEPENDENCY)";
}
pub relation claim_in_visit_at_facility(fc: FacilityClaim) kind institutional {
    label en official "section 9816(b)(2)(B): the item or service was furnished with respect to a visit at the facility: at the facility, or an item or service that a visit includes regardless of whether the provider is at the facility";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "regardless of whether or not the provider furnishing such items or services is at the facility.")
rule ClaimInVisitAtFacilityByProviderPresence(fc: FacilityClaim, facility: HealthCareFacility) strict {
    when facility_claim_visit_facility(fc, facility) and facility_claim_furnished_at_facility(fc);
    then claim_in_visit_at_facility(fc);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "The term \"visit\" shall, with respect to items and services furnished to an individual at a health care facility, include equipment and devices, telemedicine services, imaging services, laboratory services, preoperative and postoperative services, and such other items and services as the Secretary may specify")
rule ClaimInVisitAtFacilityByItemKind(fc: FacilityClaim, facility: HealthCareFacility, kind: VisitItemKind) strict {
    when facility_claim_visit_facility(fc, facility)
        and facility_claim_item_kind(fc, kind)
        and kind != OtherItemOrService;
    then claim_in_visit_at_facility(fc);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "and such other items and services as the Secretary may specify, regardless of whether or not the provider furnishing such items or services is at the facility.")
rule ClaimInVisitAtFacilityBySecretarySpecification(fc: FacilityClaim, facility: HealthCareFacility) strict {
    when facility_claim_visit_facility(fc, facility) and secretary_specified_visit_item(fc);
    then claim_in_visit_at_facility(fc);
}

// =====================================================================
// Section 9816(b)(1): the plan's obligations for such a claim
// =====================================================================

pub relation facility_claim_applies_9816b(fc: FacilityClaim) kind institutional {
    label en official "section 9816(b)(1): benefits are covered for the item or service, a nonparticipating provider furnished it without the notice and consent of section 2799B-2(d), in a visit at a participating health care facility";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "In the case of items or services (other than emergency services to which subsection (a) applies) for which any benefits are provided or covered by a group health plan furnished to a participant or beneficiary of such plan by a nonparticipating provider")
rule FacilityClaimApplies9816b(fc: FacilityClaim, plan: GroupHealthPlan, facility: HealthCareFacility, provider: Person, person: Person) strict {
    when facility_claim_for(fc, person, plan)
        and facility_claim_covered_by_plan(fc)
        and facility_claim_nonparticipating_provider(fc, provider)
        and not_known(facility_claim_notice_and_consent_satisfied(fc))
        and claim_in_visit_at_facility(fc)
        and facility_claim_visit_facility(fc, facility)
        and participating_health_care_facility(facility, plan);
    then facility_claim_applies_9816b(fc);
}
pub relation facility_recognized_amount(fc: FacilityClaim, amount: Money) kind empirical {
    label en unofficial "section 9816(b)(1)(B): the recognized amount (section 9816(a)(3)(H)) for the item or service, plan and year (asserted figure)";
}
pub relation facility_cost_sharing_cap(fc: FacilityClaim, amount: Money) kind institutional {
    label en official "section 9816(b)(1)(A)-(B): the cost-sharing requirement that would apply had a participating provider furnished the item or service, calculated as if the total amount charged were the recognized amount";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "shall calculate such cost-sharing requirement as if the total amount that would have been charged for such items and services by such participating provider were equal to the recognized amount")
rule FacilityCostSharingCap(fc: FacilityClaim, plan: GroupHealthPlan, person: Person, recognized: Money, rate: Decimal) strict {
    when facility_claim_applies_9816b(fc)
        and facility_claim_for(fc, person, plan)
        and facility_recognized_amount(fc, recognized)
        and plan_in_network_cost_sharing_rate(plan, rate);
    then facility_cost_sharing_cap(fc, round(recognized * rate, 2, "HALF_UP"));
}
pub relation facility_actual_cost_sharing(fc: FacilityClaim, amount: Money) kind empirical {
    label en unofficial "the cost-sharing amount the plan actually imposed on the participant or beneficiary for this item or service";
}
pub relation facility_cost_sharing_excessive(fc: FacilityClaim) kind institutional {
    label en official "section 9816(b)(1)(A): the plan imposed cost-sharing greater than the participating-provider amount";
}
rule FacilityCostSharingExcessive(fc: FacilityClaim, actual: Money, cap: Money) strict {
    when facility_actual_cost_sharing(fc, actual) and facility_cost_sharing_cap(fc, cap) and actual > cap;
    then facility_cost_sharing_excessive(fc);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "shall not impose on such participant or beneficiary a cost-sharing requirement for such items and services so furnished that is greater than the cost-sharing requirement that would apply under such plan had such items or services been furnished by a participating provider")
rule S9816BExcessiveCostSharingProhibition(fc: FacilityClaim, plan: GroupHealthPlan, person: Person, sponsor: Person, actual: Money) defeasible {
    when facility_cost_sharing_excessive(fc)
        and facility_claim_for(fc, person, plan)
        and facility_actual_cost_sharing(fc, actual)
        and plan_sponsor(plan, sponsor);
    then prohibition S9816BExcessiveCostSharing {
        bearer sponsor;
        action facility_actual_cost_sharing(fc, actual);
        window [-infinity, infinity];
    };
}

pub relation facility_bill_transmitted_on(fc: FacilityClaim, on: Date) kind empirical {
    label en unofficial "the date the provider transmitted the bill for the item or service";
}
pub relation facility_initial_payment_or_denial_sent_on(fc: FacilityClaim, on: Date) kind empirical {
    label en unofficial "the date the plan sent the provider an initial payment or a notice of denial of payment";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "not later than 30 calendar days after the bill for such items or services is transmitted by such provider, shall send to the provider an initial payment or notice of denial of payment;")
rule S9816BInitialPaymentOrDenialDuty(fc: FacilityClaim, plan: GroupHealthPlan, person: Person, sponsor: Person, transmitted: Date, provider: Person) defeasible {
    when facility_claim_applies_9816b(fc)
        and facility_bill_transmitted_on(fc, transmitted)
        and facility_claim_for(fc, person, plan)
        and facility_claim_nonparticipating_provider(fc, provider)
        and plan_sponsor(plan, sponsor);
    then duty S9816BInitialPaymentOrDenial {
        bearer sponsor;
        beneficiary provider;
        goal achievement {
            condition facility_initial_payment_or_denial_sent_on(fc, _);
            window [transmitted, add_calendar_period(transmitted, 30 calendar_day)];
        }
    };
}

pub relation facility_out_of_network_rate(fc: FacilityClaim, amount: Money) kind empirical {
    label en unofficial "the out-of-network rate (section 9816(a)(3)(K)) for the item or service (asserted figure)";
}
pub relation facility_determination_made_on(fc: FacilityClaim, on: Date) kind empirical {
    label en unofficial "the date the payment amount was determined under open negotiations or by the certified IDR entity (section 9816(c)(6))";
}
pub relation facility_total_plan_payment_due(fc: FacilityClaim, amount: Money) kind institutional {
    label en official "section 9816(b)(1)(D): the total plan payment: the out-of-network rate less the cost-sharing amount determined under (A) and (B), with any initial payment applied toward it";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "equal to the amount by which the out-of-network rate (as defined in subsection (a)(3)(K)) for such items and services exceeds the cost-sharing amount imposed under the plan for such items and services (as determined in accordance with subparagraphs (A) and (B)) and year")
rule FacilityTotalPlanPaymentDue(fc: FacilityClaim, oon: Money, cap: Money) strict {
    when facility_out_of_network_rate(fc, oon) and facility_cost_sharing_cap(fc, cap) and oon > cap;
    then facility_total_plan_payment_due(fc, oon - cap);
}
pub relation facility_total_plan_payment_paid(fc: FacilityClaim, amount: Money) kind empirical {
    label en unofficial "the total the plan has paid directly to the provider for the item or service (initial payment included)";
}
pub relation facility_total_plan_payment_satisfied(fc: FacilityClaim) kind institutional {
    label en official "section 9816(b)(1)(D): the total paid directly to the provider is at least the total plan payment due";
}
rule FacilityTotalPlanPaymentSatisfied(fc: FacilityClaim, due: Money, paid: Money) strict {
    when facility_total_plan_payment_due(fc, due) and facility_total_plan_payment_paid(fc, paid) and paid >= due;
    then facility_total_plan_payment_satisfied(fc);
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "shall pay a total plan payment directly, in accordance, if applicable, with the timing requirement described in subsection (c)(6), to such provider furnishing such items and services to such participant or beneficiary")
rule S9816BTotalPlanPaymentDuty(fc: FacilityClaim, plan: GroupHealthPlan, person: Person, sponsor: Person, provider: Person, determined: Date, due: Money) defeasible {
    when facility_total_plan_payment_due(fc, due)
        and facility_determination_made_on(fc, determined)
        and facility_claim_for(fc, person, plan)
        and facility_claim_nonparticipating_provider(fc, provider)
        and plan_sponsor(plan, sponsor);
    then duty S9816BTotalPlanPayment {
        bearer sponsor;
        beneficiary provider;
        goal achievement {
            condition facility_total_plan_payment_satisfied(fc);
            window [determined, add_calendar_period(determined, 30 calendar_day)];
        }
    };
}

pub relation facility_cost_sharing_counted_toward_in_network_limits(fc: FacilityClaim) kind empirical {
    label en unofficial "the cost-sharing payments made by the participant or beneficiary for this item or service were counted toward the in-network deductible and in-network out-of-pocket maximum as if furnished by a participating provider";
}
@source(IRC_S9816_B, relation = formalizes, coverage = exact, quote = "shall count toward any in-network deductible and in-network out-of-pocket maximums (as applicable) applied under the plan, any cost-sharing payments made by the participant or beneficiary")
rule S9816BCountCostSharingDuty(fc: FacilityClaim, plan: GroupHealthPlan, person: Person, sponsor: Person) defeasible {
    when facility_claim_applies_9816b(fc)
        and facility_claim_for(fc, person, plan)
        and plan_sponsor(plan, sponsor);
    then duty S9816BCountCostSharing {
        bearer sponsor;
        beneficiary person;
        goal maintenance {
            condition facility_cost_sharing_counted_toward_in_network_limits(fc);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 9816(d): database access fees
// =====================================================================

pub relation plan_used_database_for_insufficient_information_rate(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9816(d): the sponsor, pursuant to subsection (a)(3)(E)(iii), used a database to determine a rate by reason of having insufficient information";
}
pub relation sponsor_covers_database_access_cost(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9816(d): the sponsor covers the cost for access to the database";
}
@source(IRC_S9816_D, relation = formalizes, coverage = exact, quote = "such sponsor shall cover the cost for access to such database.")
rule S9816DDatabaseAccessCostDuty(plan: GroupHealthPlan, sponsor: Person) defeasible {
    when plan_used_database_for_insufficient_information_rate(plan) and plan_sponsor(plan, sponsor);
    then duty S9816DCoverDatabaseAccessCost {
        bearer sponsor;
        goal maintenance {
            condition sponsor_covers_database_access_cost(plan);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 9816(e): identification cards
// =====================================================================

pub entity PlanIdentificationCard {
    label en unofficial "a physical or electronic plan or insurance identification card issued to a participant or beneficiary";
}
pub relation id_card_issued(card: PlanIdentificationCard, person: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "the card was issued to this person under this plan on this date";
}
pub relation plan_covers_benefit_for_items_or_services(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9816(e): the plan provides or covers any benefit with respect to items or services";
}
pub relation id_card_shows_deductible(card: PlanIdentificationCard) kind empirical {
    label en unofficial "section 9816(e)(1): the card shows any deductible applicable to the plan";
}
pub relation id_card_shows_out_of_pocket_maximum(card: PlanIdentificationCard) kind empirical {
    label en unofficial "section 9816(e)(2): the card shows any out-of-pocket maximum limitation applicable to the plan";
}
pub relation id_card_shows_consumer_assistance_contact(card: PlanIdentificationCard) kind empirical {
    label en unofficial "section 9816(e)(3): the card shows a telephone number and an Internet website address for consumer assistance information";
}
pub relation id_card_information_in_clear_writing(card: PlanIdentificationCard) kind empirical {
    label en unofficial "section 9816(e): the information on the card is in clear writing";
}
pub relation id_card_complete(card: PlanIdentificationCard) kind institutional {
    label en official "section 9816(e)(1)-(3): the card shows, in clear writing, the deductible, the out-of-pocket maximum, and the consumer assistance telephone number and website address";
}
@source(IRC_S9816_E, relation = formalizes, coverage = exact, quote = "(3) A telephone number and Internet website address through which such individual may seek consumer assistance information")
rule IdCardComplete(card: PlanIdentificationCard) strict {
    when id_card_shows_deductible(card)
        and id_card_shows_out_of_pocket_maximum(card)
        and id_card_shows_consumer_assistance_contact(card)
        and id_card_information_in_clear_writing(card);
    then id_card_complete(card);
}
@source(IRC_S9816_E, relation = formalizes, coverage = exact, quote = "shall include, in clear writing, on any physical or electronic plan or insurance identification card issued to the participants or beneficiaries in the plan the following:")
rule S9816EIdentificationCardDuty(card: PlanIdentificationCard, person: Person, plan: GroupHealthPlan, sponsor: Person, issued: Date) defeasible {
    when id_card_issued(card, person, plan, issued)
        and plan_covers_benefit_for_items_or_services(plan)
        and plan_sponsor(plan, sponsor);
    then duty S9816EIdentificationCardContent {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition id_card_complete(card);
            window [issued, issued];
        }
    };
}

// =====================================================================
// Section 9820(c): disclosure on patient protections against balance billing
// =====================================================================

pub relation disclosure_plan_year_begins(plan: GroupHealthPlan, begins: Date) kind empirical {
    label en unofficial "section 9820(c): the plan year under consideration begins on this date";
}
pub relation disclosure_covers_phsa_balance_billing_prohibitions(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c)(1)(A): the disclosure describes the requirements and prohibitions under sections 2799B-1 and 2799B-2 of the Public Health Service Act, in plain language";
}
pub relation state_law_provides_provider_charge_requirements(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c)(1)(B): applicable State law provides other requirements on the amounts providers and facilities without a contract with the plan may charge";
}
pub relation disclosure_covers_state_law_provider_charge_requirements(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c)(1)(B): the disclosure describes those State law requirements, in plain language";
}
pub relation disclosure_covers_section_9816_requirements(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c)(1)(C): the disclosure describes the requirements applied under section 9816, in plain language";
}
pub relation disclosure_covers_agency_contact_information(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c)(2): the disclosure gives information on contacting the appropriate State and Federal agencies";
}
pub relation balance_billing_disclosure_publicly_available(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c): the plan made the disclosure publicly available";
}
pub relation balance_billing_disclosure_posted_on_website(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9820(c): the plan posted the disclosure on a public website of the plan or issuer";
}
pub relation balance_billing_disclosure_content_complete(plan: GroupHealthPlan) kind institutional {
    label en official "section 9820(c)(1)-(2): the disclosure covers (A) the PHSA prohibitions, (B) State law requirements where State law provides them, (C) section 9816, and (2) agency contact information";
}
@source(IRC_S9820_C, relation = formalizes, coverage = exact, quote = "(1) information in plain language on—")
rule DisclosureContentCompleteWithoutStateLaw(plan: GroupHealthPlan) strict {
    when disclosure_covers_phsa_balance_billing_prohibitions(plan)
        and disclosure_covers_section_9816_requirements(plan)
        and disclosure_covers_agency_contact_information(plan)
        and not_known(state_law_provides_provider_charge_requirements(plan));
    then balance_billing_disclosure_content_complete(plan);
}
@source(IRC_S9820_C, relation = formalizes, coverage = exact, quote = "(B) if provided for under applicable State law, any other requirements on providers and facilities regarding the amounts")
rule DisclosureContentCompleteWithStateLaw(plan: GroupHealthPlan) strict {
    when disclosure_covers_phsa_balance_billing_prohibitions(plan)
        and disclosure_covers_section_9816_requirements(plan)
        and disclosure_covers_agency_contact_information(plan)
        and state_law_provides_provider_charge_requirements(plan)
        and disclosure_covers_state_law_provider_charge_requirements(plan);
    then balance_billing_disclosure_content_complete(plan);
}
pub relation balance_billing_disclosure_made(plan: GroupHealthPlan) kind institutional {
    label en official "section 9820(c): the disclosure is complete, publicly available and posted on a public website";
}
rule BalanceBillingDisclosureMade(plan: GroupHealthPlan) strict {
    when balance_billing_disclosure_content_complete(plan)
        and balance_billing_disclosure_publicly_available(plan)
        and balance_billing_disclosure_posted_on_website(plan);
    then balance_billing_disclosure_made(plan);
}
@source(IRC_S9820_C, relation = formalizes, coverage = exact, quote = "For plan years beginning on or after January 1, 2022, each group health plan shall make publicly available, post on a public website of such plan or issuer")
rule S9820CPublicDisclosureDuty(plan: GroupHealthPlan, sponsor: Person, begins: Date) defeasible {
    when disclosure_plan_year_begins(plan, begins) and begins >= @2022-01-01 and plan_sponsor(plan, sponsor);
    then duty S9820CPublishBalanceBillingDisclosure {
        bearer sponsor;
        goal achievement {
            condition balance_billing_disclosure_made(plan);
            window [begins, add_calendar_period(begins, 12 calendar_month)];
        }
    };
}
pub entity ExplanationOfBenefits {
    label en unofficial "an explanation of benefits for an item or service with respect to which the requirements of section 9816 apply";
}
pub relation eob_issued_for_9816_item(eob: ExplanationOfBenefits, person: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "the plan issued this explanation of benefits to the person on this date for an item or service with respect to which section 9816 applies";
}
pub relation eob_includes_balance_billing_disclosure(eob: ExplanationOfBenefits) kind empirical {
    label en unofficial "section 9820(c): the explanation of benefits includes the balance billing disclosure";
}
@source(IRC_S9820_C, relation = formalizes, coverage = exact, quote = "and include on each explanation of benefits for an item or service with respect to which the requirements under section 9816 applies")
rule S9820CEobDisclosureDuty(eob: ExplanationOfBenefits, person: Person, plan: GroupHealthPlan, sponsor: Person, issued: Date) defeasible {
    when eob_issued_for_9816_item(eob, person, plan, issued) and issued >= @2022-01-01 and plan_sponsor(plan, sponsor);
    then duty S9820CIncludeDisclosureOnEob {
        bearer sponsor;
        beneficiary person;
        goal achievement {
            condition eob_includes_balance_billing_disclosure(eob);
            window [issued, issued];
        }
    };
}
