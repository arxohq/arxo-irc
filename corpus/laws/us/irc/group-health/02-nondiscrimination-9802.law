// 26 U.S.C. §9802 — Prohibiting discrimination against individual
// participants and beneficiaries based on health status. Priority section
// (a)-(d) fully, per task instructions.

// --- the eight health factors of (a)(1) ---------------------------------

use self::{
    GroupHealthPlan,
    IRC_S9802_A,
    IRC_S9802_B,
    IRC_S9802_C,
    IRC_S9802_D,
    IRC_S9802_G,
    Person,
    church_plan_good_health_exception,
    plan_sponsor,
};

pub enum HealthFactor {
    HealthStatus;
    MedicalCondition;
    ClaimsExperience;
    ReceiptOfHealthCare;
    MedicalHistory;
    GeneticInformation;
    EvidenceOfInsurability;
    Disability;
}

// --- (a): eligibility rules based on a health factor ---------------------

@source(IRC_S9802_A, relation = formalizes, coverage = partial, quote = "a group health plan may not establish rules for eligibility (including continued eligibility) of any individual to enroll under the terms of the plan based on any of the following factors")
pub relation eligibility_rule_based_on_factor(plan: GroupHealthPlan, person: Person, factor: HealthFactor) kind empirical {
    label en unofficial "case fact: the plan established/applied a rule for eligibility (including continued eligibility, and waiting-period rules per (a)(3)) affecting this person's enrollment, based on this section 9802(a)(1) health factor";
}
@source(IRC_S9802_A, relation = formalizes, coverage = partial, quote = "paragraph (1) shall not be construed—")
pub relation eligibility_rule_is_uniform_benefit_limitation(plan: GroupHealthPlan, person: Person, factor: HealthFactor) kind empirical {
    label en unofficial "case fact/classification: the challenged rule is in truth a benefit design limitation applied uniformly to similarly situated individuals (section 9802(a)(2)) — not an eligibility rule based on a health factor";
}

@source(IRC_S9802_A, relation = formalizes, coverage = exact, quote = "a group health plan may not establish rules for eligibility (including continued eligibility) of any individual to enroll under the terms of the plan based on any of the following factors in relation to the individual or a dependent of the individual")
rule S9802AEligibilityDiscriminationProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for factor: HealthFactor;
    for sponsor: Person;
    when eligibility_rule_based_on_factor(plan, person, factor)
        and plan_sponsor(plan, sponsor)
        and not_known(church_plan_good_health_exception(plan, person, factor));
    then prohibition S9802AEligibilityDiscrimination {
        bearer sponsor;
        action eligibility_rule_based_on_factor(plan, person, factor);
        window [-infinity, infinity];
    };
    unless eligibility_rule_based_on_factor(plan, person, factor)
        and plan_sponsor(plan, sponsor)
        and eligibility_rule_is_uniform_benefit_limitation(plan, person, factor);
}

// --- (b): premium/contribution discrimination -----------------------------

@source(IRC_S9802_B, relation = formalizes, coverage = exact, quote = "A group health plan may not require any individual (as a condition of enrollment or continued enrollment under the plan) to pay a premium or contribution which is greater than such premium or contribution for a similarly situated individual enrolled in the plan on the basis of any factor described in subsection (a)(1)")
pub relation individual_premium_based_on_factor(plan: GroupHealthPlan, person: Person, factor: HealthFactor) kind empirical {
    label en unofficial "case fact: the plan charged this person a higher premium/contribution than a similarly situated individual, based on a section 9802(a)(1) factor";
}
@source(IRC_S9802_B, relation = formalizes, coverage = partial, quote = "to prevent a group health plan from establishing premium discounts or rebates or modifying otherwise applicable copayments or deductibles in return for adherence to programs of health promotion and disease prevention")
pub relation premium_variation_is_wellness_program(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact/classification: the premium/cost-sharing variation is a discount, rebate, or copayment/deductible modification in return for adherence to a bona fide wellness/health-promotion program (section 9802(b)(2)(B) exception; the statutory text names no numeric reward cap — a 30%/50% cap, if any, is set by regulation, EXTERNAL_DEPENDENCY, not this section's own text)";
}

rule S9802BPremiumDiscriminationProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for factor: HealthFactor;
    for sponsor: Person;
    when individual_premium_based_on_factor(plan, person, factor) and plan_sponsor(plan, sponsor);
    then prohibition S9802BPremiumDiscrimination {
        bearer sponsor;
        action individual_premium_based_on_factor(plan, person, factor);
        window [-infinity, infinity];
    };
    unless individual_premium_based_on_factor(plan, person, factor)
        and plan_sponsor(plan, sponsor)
        and premium_variation_is_wellness_program(plan, person);
}

@source(IRC_S9802_B, relation = formalizes, coverage = exact, quote = "a group health plan may not adjust premium or contribution amounts for the group covered under such plan on the basis of genetic information")
pub relation group_premium_adjusted_on_genetic_information(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan adjusted the GROUP's premium/contribution amount based on genetic information (section 9802(b)(3)(A)) — separate from the individual-level (b)(1) prohibition";
}
rule S9802B3NoGroupBasedGeneticDiscriminationProhibition defeasible {
    for plan: GroupHealthPlan;
    for sponsor: Person;
    when group_premium_adjusted_on_genetic_information(plan) and plan_sponsor(plan, sponsor);
    then prohibition S9802B3NoGroupBasedGeneticDiscrimination {
        bearer sponsor;
        action group_premium_adjusted_on_genetic_information(plan);
        window [-infinity, infinity];
    };
}

// --- (c): genetic testing --------------------------------------------------

@source(IRC_S9802_C, relation = formalizes, coverage = exact, quote = "A group health plan may not request or require an individual or a family member of such individual to undergo a genetic test.")
pub relation plan_requested_or_required_genetic_test(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: the plan (not a treating health care professional, and not under the (c)(4) research exception) requested or required this individual/family member to undergo a genetic test";
}
@source(IRC_S9802_C, relation = formalizes, coverage = partial, quote = "Notwithstanding paragraph (1), a group health plan may request, but not require, that a participant or beneficiary undergo a genetic test if each of the following conditions is met")
pub relation genetic_test_request_meets_research_exception(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact/classification: the (c)(4) research-exception conditions (IRB-compliant research, voluntary with notice, no underwriting use, Secretary notified) are all met for this request";
}
rule S9802CGeneticTestingRule defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for sponsor: Person;
    when plan_requested_or_required_genetic_test(plan, person) and plan_sponsor(plan, sponsor);
    then prohibition S9802CGeneticTestingProhibition {
        bearer sponsor;
        action plan_requested_or_required_genetic_test(plan, person);
        window [-infinity, infinity];
    };
    unless plan_requested_or_required_genetic_test(plan, person)
        and plan_sponsor(plan, sponsor)
        and genetic_test_request_meets_research_exception(plan, person);
}

// --- (d): prohibition on collection of genetic information ----------------

@source(IRC_S9802_D, relation = formalizes, coverage = exact, quote = "A group health plan shall not request, require, or purchase genetic information for underwriting purposes")
pub relation genetic_information_collected_for_underwriting(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: the plan requested, required, or purchased genetic information about this person for underwriting purposes (section 9832(d) defines underwriting purposes; imported where that module declares it)";
}
rule S9802D1NoGeneticInfoForUnderwritingProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for sponsor: Person;
    when genetic_information_collected_for_underwriting(plan, person) and plan_sponsor(plan, sponsor);
    then prohibition S9802D1NoGeneticInfoForUnderwriting {
        bearer sponsor;
        action genetic_information_collected_for_underwriting(plan, person);
        window [-infinity, infinity];
    };
}

@source(IRC_S9802_D, relation = formalizes, coverage = exact, quote = "A group health plan shall not request, require, or purchase genetic information with respect to any individual prior to such individual's enrollment under the plan or in connection with such enrollment.")
pub relation genetic_information_collected_before_or_at_enrollment(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: the plan requested, required, or purchased genetic information about this individual before or in connection with enrollment";
}
@source(IRC_S9802_D, relation = formalizes, coverage = exact, quote = "If a group health plan obtains genetic information incidental to the requesting, requiring, or purchasing of other information concerning any individual, such request, requirement, or purchase shall not be considered a violation of paragraph (2) if such request, requirement, or purchase is not in violation of paragraph (1).")
pub relation genetic_information_collection_incidental(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact/classification: the genetic information was obtained only incidentally to requesting other information, and the request did not itself violate (d)(1)";
}
rule S9802D2NoPreEnrollmentGeneticCollectionProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for sponsor: Person;
    when genetic_information_collected_before_or_at_enrollment(plan, person) and plan_sponsor(plan, sponsor);
    then prohibition S9802D2NoPreEnrollmentGeneticCollection {
        bearer sponsor;
        action genetic_information_collected_before_or_at_enrollment(plan, person);
        window [-infinity, infinity];
    };
    unless genetic_information_collected_before_or_at_enrollment(plan, person)
        and plan_sponsor(plan, sponsor)
        and genetic_information_collection_incidental(plan, person);
}

// --- (f): fetus/embryo genetic information extension (definitional) ------

@source(IRC_S9802_G, relation = formalizes, coverage = exact, quote = "with respect to such an individual or family member of an individual who is a pregnant woman, include genetic information of any fetus carried by such pregnant woman")
pub relation genetic_information_includes_fetus_of(fetus_carrier: Person) kind institutional {
    label en official "section 9802(g)(1): genetic information of a fetus carried by a pregnant woman counts as genetic information of that woman (and her family members) for this chapter";
}
rule S9802GFetusGeneticInformation strict {
    for fetus_carrier: Person;
    when is_pregnant(fetus_carrier);
    then genetic_information_includes_fetus_of(fetus_carrier);
}
pub relation is_pregnant(person: Person) kind empirical {
    label en unofficial "case fact: the person is a pregnant woman (section 9802(g)(1))";
}
