// 26 U.S.C. §9803 — Guaranteed renewability in multiemployer plans and
// certain multiple employer welfare arrangements. Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9803_A,
    IRC_S9803_B,
    Person,
    plan_sponsor,
};

@source(IRC_S9803_B, relation = formalizes, coverage = exact, quote = "the term \"multiple employer welfare arrangement\" has the meaning given such term by section 3(40) of the Employee Retirement Income Security Act of 1974, as in effect on the date of the enactment of this section")
pub relation multiple_employer_welfare_arrangement(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact/classification: this plan is a multiple employer welfare arrangement within ERISA section 3(40) (section 9803(b)) — EXTERNAL_DEPENDENCY, ERISA is outside Title 26";
}
pub relation multiemployer_plan_9803(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact/classification: this plan is a multiemployer plan within section 414(f) (section 9803(a)) — EXTERNAL_DEPENDENCY on section 414(f)";
}
@source(IRC_S9803_A, relation = formalizes, coverage = partial, quote = "A group health plan which is a multiemployer plan (as defined in section 414(f)) or which is a multiple employer welfare arrangement may not deny an employer continued access to the same or different coverage under such plan")
pub relation section_9803_applies(plan: GroupHealthPlan) kind institutional {
    label en official "section 9803(a) gate: the plan is a multiemployer plan or a multiple employer welfare arrangement";
}
rule Section9803AppliesMultiemployer(plan: GroupHealthPlan) strict {
    when multiemployer_plan_9803(plan);
    then section_9803_applies(plan);
}
rule Section9803AppliesMewa(plan: GroupHealthPlan) strict {
    when multiple_employer_welfare_arrangement(plan);
    then section_9803_applies(plan);
}

pub relation plan_denied_continued_access(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the plan denied this employer continued access to the same or different coverage under the plan";
}

// --- (a)(1)-(6): the six exceptions, each a positive case fact -----------

@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "for nonpayment of contributions")
pub relation denial_for_nonpayment_of_contributions(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the denial was for nonpayment of contributions (section 9803(a)(1))";
}
@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "for fraud or other intentional misrepresentation of material fact by the employer")
pub relation denial_for_employer_fraud(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the denial was for fraud or intentional misrepresentation of material fact by the employer (section 9803(a)(2))";
}
@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "for noncompliance with material plan provisions")
pub relation denial_for_material_noncompliance(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the denial was for noncompliance with material plan provisions (section 9803(a)(3))";
}
@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "because the plan is ceasing to offer any coverage in a geographic area")
pub relation denial_for_ceasing_coverage_in_area(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the denial was because the plan is ceasing to offer any coverage in a geographic area (section 9803(a)(4))";
}
@source(IRC_S9803_A, relation = formalizes, coverage = partial, quote = "because there is no longer any individual enrolled through the employer who lives, resides, or works in the service area of the network plan and the plan applies this paragraph uniformly without regard to the claims experience of employers or a factor described in section 9802(a)(1)")
pub relation denial_for_no_enrollee_in_network_service_area(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact/classification: the plan offers benefits through a network plan, no enrollee through the employer lives/resides/works in its service area, and the plan applies this uniformly without regard to claims experience or a section 9802(a)(1) factor (section 9803(a)(5), all conditions bundled into one case fact per the corpus's evaluative-bundling convention for a multi-condition exception the case asserts as a whole)";
}
@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "for failure to meet the terms of an applicable collective bargaining agreement, to renew a collective bargaining or other agreement requiring or authorizing contributions to the plan, or to employ employees covered by such an agreement")
pub relation denial_for_collective_bargaining_failure(plan: GroupHealthPlan, employer: Person) kind empirical {
    label en unofficial "case fact: the denial was for a collective-bargaining-agreement failure described in section 9803(a)(6)";
}

// `bearer` needs a bound Person: section 9803's addressee IS the plan
// (an ERISA multiemployer plan / MEWA is not necessarily "sponsored" by a
// single employer the way 00-vocabulary.law's `plan_sponsor` models an
// ordinary single-employer plan), but a joint board of trustees or other
// plan administrator asserted via `plan_sponsor` is read directly where the
// case supplies it; absent that fact the position is simply not derivable
// (UNDETERMINED) rather than fabricating a bearer (rights-positions.md:
// "do not invent a bearer").
@source(IRC_S9803_A, relation = formalizes, coverage = exact, quote = "may not deny an employer continued access to the same or different coverage under such plan, other than")
rule S9803GuaranteedRenewabilityProhibition defeasible {
    for plan: GroupHealthPlan;
    for employer: Person;
    for sponsor: Person;
    when section_9803_applies(plan) and plan_denied_continued_access(plan, employer) and plan_sponsor(plan, sponsor);
    then prohibition S9803DenialOfContinuedAccess {
        bearer sponsor;
        action plan_denied_continued_access(plan, employer);
        window [-infinity, infinity];
    };
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_nonpayment_of_contributions(plan, employer);
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_employer_fraud(plan, employer);
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_material_noncompliance(plan, employer);
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_ceasing_coverage_in_area(plan, employer);
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_no_enrollee_in_network_service_area(plan, employer);
    unless section_9803_applies(plan)
        and plan_denied_continued_access(plan, employer)
        and plan_sponsor(plan, sponsor)
        and denial_for_collective_bargaining_failure(plan, employer);
}
