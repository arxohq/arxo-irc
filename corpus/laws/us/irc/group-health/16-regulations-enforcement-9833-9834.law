// 26 U.S.C. §9833 (regulations — rulemaking authority, NON_NORMATIVE for a
// plan/participant) and §9834 (enforcement — a pure cross-reference to the
// section 4980D excise, EXTERNAL_DEPENDENCY: no `us.irc.excise_entities`
// module formalizes section 4980D yet, per the excise-entities check
// performed for this report). Stage 1b (IRC-18-K).

// §9833 grants the Secretary rulemaking authority; it imposes no duty,
// prohibition, power or immunity on a plan, participant or beneficiary, and
// so classifies as NON_NORMATIVE for this package's purposes (institutional
// effect internal to the Treasury, not a norm this corpus's case model
// reads). No relation/rule is declared for it; see coverage row
// 26/9833/u1.

use self::{
    GroupHealthPlan,
    Person,
    plan_sponsor,
};

// §9834 cross-references section 4980D for the excise consequence of a
// plan's failure to meet chapter 100's requirements. Declared as a typed
// dependency contract rather than an invented result (AGENT-BRIEF: "A
// reference to a section not yet implemented is a typed dependency
// contract... not an invented result").
pub relation chapter_100_failure_subject_to_4980d_excise(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9834: a group health plan's failure to meet chapter 100's requirements is subject to the excise tax of section 4980D. EXTERNAL_DEPENDENCY: no us.irc.excise_entities module yet formalizes section 4980D's own liability/exception machinery (checked; only its `sources.law` fragments are pinned there) — this relation names the cross-reference without re-deriving 4980D's content.";
}
rule ChapterFailureSubjectTo4980dExcise(plan: GroupHealthPlan) strict {
    when plan_sponsor(plan, _);
    then chapter_100_failure_subject_to_4980d_excise(plan);
}
