// Subtitle K, chapter 100 — shared vocabulary for the group-health-plan
// package (IRC-18, K01). A `GroupHealthPlan` is the bearer of the duties,
// prohibitions and powers this chapter imposes; `us.irc.core` supplies
// `Person`, `Individual`, the `Employer` role and `TaxableYear`/`Date`
// primitives, but has NO health-plan-specific shape of its own (CONTRACT.md:
// "deontic consequences ... every owner writes its OWN duty/power/
// prohibition/immunity over core's entities and relations"). This module is
// imported by every other module of this package.

use self::{
    IRC_S9832_A,
};

type Person = us.irc.core::Person;
type Individual = us.irc.core::Individual;
type TaxableYear = us.irc.core::TaxableYear;
type Organ = us.irc.core::Organ;

const Secretary: Organ = us.irc.core::Secretary;

// --- the plan itself ---------------------------------------------------

// §9832(a): "the term 'group health plan' means a plan (including a
// self-insured plan) of, or contributed to by, an employer or employee
// organization ... to provide health care ... to the employees, former
// employees, the employer, [or] others associated or formerly associated
// with the employer in a business relationship". Modeled as a local entity
// (own to this package, per AGENT-BRIEF: "a local definition stays local")
// rather than a subtype of `Person`: a plan is not itself a taxpayer here,
// it is the ADDRESSEE of chapter 100's duties/prohibitions/powers, and its
// SPONSOR (an `Employer`) is the `Person` that bears any consequence
// requiring a `Person` (e.g. the section 4980D excise, owned by
// `excise-entities`, not this package).
pub entity GroupHealthPlan {
    label en unofficial "a group health plan within the meaning of section 9832(a) (including a self-insured plan)";
}

@source(IRC_S9832_A, coverage = partial, quote = "the term \"group health plan\" has the meaning given to such term by section 5000(b)(1)")
pub relation plan_sponsor(plan: GroupHealthPlan, sponsor: Person) kind empirical {
    label en unofficial "case fact: the employer (or employee organization) that maintains/contributes to this plan (section 9832(a))";
}

// Participants and beneficiaries (the chapter's recurring addressees of a
// right/protection). Kept as roles over `Person` under the plan, following
// the `us.irc.core` role idiom (`role Employer for Person` etc.) rather than
// inventing a new type: a beneficiary of one plan is a `Person` like any
// other for the rest of the corpus.
role Participant for Person;
role Beneficiary for Person;

pub relation enrolled_under(person: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: person is enrolled as a participant or beneficiary under this plan";
}

pub relation is_dependent_of(dependent: Person, of: Person) kind empirical {
    label en unofficial "case fact: dependent relationship (spouse, child) for special-enrollment and coverage purposes (sections 9801(f), 9811, 9813)";
}

// --- attending / treating provider (sections 9801(e)(1)(A) COBRA notices,
// 9811(a)(2) attending-provider exception, 9813(b)(3) physician
// certification) ---
pub relation attending_provider(provider: Person, patient: Person) kind empirical {
    label en unofficial "case fact: provider is the attending/treating provider for patient, for purposes of the discharge-decision and certification norms of this chapter";
}
