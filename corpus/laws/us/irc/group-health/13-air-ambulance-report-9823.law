// 26 U.S.C. §9823 — Air ambulance report requirements (reporting duty to
// the Secretary, distinct from the §9820 provider-directory duties).
// Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9823_A,
    IRC_S9823_B,
    Person,
    TaxableYear,
    plan_sponsor,
};

@source(IRC_S9823_A, relation = formalizes, coverage = partial, quote = "not later than the date that is 90 days after the last day of the first calendar year beginning on or after the date on which a final rule is promulgated pursuant to the rulemaking described in section 106(d) of the No Surprises Act, the information described in subsection (b) with respect to such plan year")
pub relation air_ambulance_reporting_first_year_end(plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the last day of the FIRST calendar year beginning on or after the section 106(d) No Surprises Act final rule's promulgation — the anchor date the 90-day filing deadlines of (a)(1)-(2) are computed from (EXTERNAL_DEPENDENCY: the final-rule promulgation date is not pinned in this package's own text)";
}
pub relation air_ambulance_report_content(plan: GroupHealthPlan, y: TaxableYear) kind empirical {
    label en unofficial "case fact: the plan compiled the section 9823(b) information (disaggregated air ambulance claims data) for this plan year";
}
pub relation air_ambulance_report_submitted_on(plan: GroupHealthPlan, y: TaxableYear, on: Date) kind empirical {
    label en unofficial "case fact: the date the plan submitted the section 9823(a) report to the Secretary/Secretary of Labor/Secretary of HHS jointly, for this plan year";
}

@source(IRC_S9823_A, relation = formalizes, coverage = exact, quote = "Each group health plan shall submit to the Secretary, jointly with the Secretary of Labor and the Secretary of Health and Human Services")
rule S9823FirstReportDuty(plan: GroupHealthPlan, sponsor: Person, y: TaxableYear, first_year_end: Date) strict {
    label en official "section 9823(a)(1): the plan shall submit the section 9823(b) information not later than 90 days after the end of the first covered plan year";
    when air_ambulance_reporting_first_year_end(plan, first_year_end)
        and air_ambulance_report_content(plan, y)
        and plan_sponsor(plan, sponsor);
    then duty S9823FirstReport {
        bearer sponsor;
        beneficiary sponsor;
        goal achievement {
            condition air_ambulance_report_submitted_on(plan, y, _);
            window [-infinity, add_calendar_period(first_year_end, 90 calendar_day)];
        }
    };
}

@source(IRC_S9823_A, relation = formalizes, coverage = exact, quote = "not later than the date that is 90 days after the last day of the calendar year immediately succeeding the plan year described in paragraph (1), such information with respect to such immediately succeeding plan year")
rule S9823SecondReportDuty(plan: GroupHealthPlan, sponsor: Person, y: TaxableYear, first_year_end: Date) strict {
    label en official "section 9823(a)(2): the plan shall submit the same information for the immediately succeeding plan year, within 90 days after that year's end";
    when air_ambulance_reporting_first_year_end(plan, first_year_end)
        and air_ambulance_report_content(plan, y)
        and plan_sponsor(plan, sponsor);
    then duty S9823SecondReport {
        bearer sponsor;
        beneficiary sponsor;
        goal achievement {
            condition air_ambulance_report_submitted_on(plan, y, _);
            window [-infinity, add_calendar_period(add_calendar_period(first_year_end, 12 calendar_month), 90 calendar_day)];
        }
    };
}

// --- (b): content classification (disaggregation factors, case-asserted) ---

@source(IRC_S9823_B, relation = formalizes, coverage = partial, quote = "Claims data for air ambulance services furnished by providers of such services, disaggregated by each of the following factors")
pub relation air_ambulance_report_disaggregated(plan: GroupHealthPlan, y: TaxableYear) kind empirical {
    label en unofficial "case fact/classification: the plan's compiled claims data is disaggregated by the section 9823(b)(1)(A)-(E) factors (emergent/nonemergent, program type, rural/urban origin, aircraft type, contract status) — bundled into one completeness case fact per the corpus's convention for a closed enumerated content list, rather than five separate facts";
}
