// 26 U.S.C. §9819 — Maintenance of price comparison tool. A single,
// unlettered section (task's "check pinned" — confirmed: no subsections).
// Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9819,
    Person,
    plan_sponsor,
};

pub relation price_comparison_tool_maintained(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan/issuer makes available on its website a price comparison tool meeting section 9819's description, and offers telephone price comparison guidance";
}
pub relation price_comparison_phone_guidance_offered(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan offers price comparison guidance by telephone (section 9819)";
}

pub relation price_comparison_duty_met(plan: GroupHealthPlan) kind institutional {
    label en unofficial "both section 9819 requirements are met: the website tool and the telephone guidance (a `goal` condition slot takes one atom, per the compiler's single-formula-slot restriction, so the conjunction is folded into this one relation)";
}
rule PriceComparisonDutyMet(plan: GroupHealthPlan) strict {
    when price_comparison_tool_maintained(plan) and price_comparison_phone_guidance_offered(plan);
    then price_comparison_duty_met(plan);
}

@source(IRC_S9819, relation = formalizes, coverage = exact, quote = "A group health plan shall offer price comparison guidance by telephone and make available on the Internet website of the plan or issuer a price comparison tool")
rule S9819PriceComparisonToolDuty(plan: GroupHealthPlan, sponsor: Person) strict {
    label en official "section 9819: the plan shall offer telephone price-comparison guidance and maintain a website price comparison tool";
    when plan_sponsor(plan, sponsor);
    then duty S9819PriceComparisonTool {
        bearer sponsor;
        beneficiary sponsor;
        goal maintenance {
            condition price_comparison_duty_met(plan);
            window [-infinity, infinity];
        }
    };
}
