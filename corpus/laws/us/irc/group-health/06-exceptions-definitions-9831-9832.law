// 26 U.S.C. §9831 (general exceptions) and §9832 (definitions). Priority
// scope: fully, per task instructions.

// ===========================================================================
// §9832 — definitions (read first: §9831's exceptions and every other
// module's classifications cross-reference these)
// ===========================================================================

use self::{
    GroupHealthPlan,
    IRC_S9831_A,
    IRC_S9831_B,
    IRC_S9831_C,
    IRC_S9831_D,
    IRC_S9832_A,
    IRC_S9832_B,
    IRC_S9832_C,
    IRC_S9832_D,
    Person,
    TaxableYear,
    is_dependent_of,
    plan_sponsor,
};

@source(IRC_S9832_A, relation = formalizes, coverage = exact, quote = "the term \"group health plan\" has the meaning given to such term by section 5000(b)(1)")
pub relation group_health_plan(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9832(a): every `GroupHealthPlan` instance IS a group health plan for this chapter by construction (the section 5000(b)(1) cross-reference is EXTERNAL_DEPENDENCY on subtitle D — a plan of, or contributed to by, an employer or employee organization to provide health care to employees/former employees/others associated with the employer; this package takes the classification as the entry condition for the `GroupHealthPlan` type rather than re-deriving 5000(b)(1) here)";
}
rule GroupHealthPlanByConstruction(plan: GroupHealthPlan) strict {
    when plan_sponsor(plan, _);
    then group_health_plan(plan);
}

@source(IRC_S9832_B, relation = formalizes, coverage = exact, quote = "the term \"health insurance coverage\" means benefits consisting of medical care (provided directly, through insurance or reimbursement, or otherwise) under any hospital or medical service policy or certificate, hospital or medical service plan contract, or health maintenance organization contract offered by a health insurance issuer")
pub relation health_insurance_coverage(coverage: Person) kind empirical {
    label en unofficial "case fact/classification: this coverage instance (typed Person as a case-asserted line-item placeholder, per corpus convention) is health insurance coverage within section 9832(b)(1)(A), i.e. NOT limited to the excepted benefits of (c)(1) (see (b)(1)(B))";
}
@source(IRC_S9832_B, relation = formalizes, coverage = exact, quote = "The term \"health insurance issuer\" means an insurance company, insurance service, or insurance organization")
pub relation health_insurance_issuer(issuer: Person) kind empirical {
    label en unofficial "case fact/classification: this Person is a health insurance issuer under section 9832(b)(2) (licensed, State-regulated insurer; a group health plan itself is excluded by the last sentence)";
}

// --- (c): excepted benefits ------------------------------------------------

pub enum ExceptedBenefitCategory {
    NotSubjectToRequirements;              // (c)(1)
    NotSubjectIfOfferedSeparately;         // (c)(2)
    NotSubjectIfIndependentNoncoordinated; // (c)(3)
    NotSubjectIfSeparatePolicy;            // (c)(4)
}
@source(IRC_S9832_C, relation = formalizes, coverage = partial, quote = "the term \"excepted benefits\" means benefits under one or more (or any combination thereof) of the following")
pub relation excepted_benefit_category(benefit: Person, category: ExceptedBenefitCategory) kind empirical {
    label en unofficial "case fact/classification: this benefit falls in the named section 9832(c) category (the specific (c)(1)(A)-(H)/(c)(2)(A)-(C)/(c)(3)(A)-(B)/(c)(4) items are a closed enumerated LIST — the classification of a given benefit against that list is asserted, per AGENT-BRIEF's 'never invent a case fact' method, rather than re-derived from a description the case does not supply)";
}
pub relation excepted_benefit(benefit: Person) kind institutional {
    label en official "section 9832(c): the benefit is an excepted benefit (any of the four categories)";
}
rule ExceptedBenefit(benefit: Person, category: ExceptedBenefitCategory) strict {
    when excepted_benefit_category(benefit, category);
    then excepted_benefit(benefit);
}

// --- (d): other definitions -------------------------------------------------

pub enum CobraProvisionKind { Section4980B; ErisaPart6; PhsaTitleXXII; }
@source(IRC_S9832_D, relation = formalizes, coverage = partial, quote = "The term \"COBRA continuation provision\" means any of the following")
pub relation cobra_continuation_provision(kind: CobraProvisionKind) kind institutional {
    label en official "section 9832(d)(1): the closed list of COBRA continuation provisions — section 4980B (except the pediatric-vaccines part of (f)(1)), ERISA part 6 (except section 609), PHSA title XXII";
}
rule CobraContinuationProvisionEnumerated strict {
    then cobra_continuation_provision(Section4980B);
}
rule CobraContinuationProvisionErisa strict {
    then cobra_continuation_provision(ErisaPart6);
}
rule CobraContinuationProvisionPhsa strict {
    then cobra_continuation_provision(PhsaTitleXXII);
}

@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "The term \"governmental plan\" has the meaning given such term by section 414(d).")
pub relation governmental_plan(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact/classification: this plan is a governmental plan within the meaning of section 414(d). EXTERNAL_DEPENDENCY: section 414(d)'s own test is owned by whichever package formalizes chapter 1 subchapter D retirement-plan definitions, not this package; asserted directly here.";
}

@source(IRC_S9832_D, relation = formalizes, coverage = partial, quote = "The term \"medical care\" has the meaning given such term by section 213(d) determined without regard to—")
pub relation medical_care(item: Person) kind empirical {
    label en unofficial "case fact/classification: this item/service is medical care within section 213(d) (excluding the (1)(C) accident/health insurance premium branch, and the qualified-long-term-care-insurance part of (1)(D)) — section 213(d) itself is EXTERNAL_DEPENDENCY (subchapter B, owned by a different package)";
}

@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "The term \"network plan\" means health insurance coverage of a health insurance issuer under which the financing and delivery of medical care are provided, in whole or in part, through a defined set of providers under contract with the issuer.")
pub relation network_plan(coverage: Person) kind empirical {
    label en unofficial "case fact/classification: the coverage is a network plan under section 9832(d)(4)";
}

@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "the assumption and retention by such person of a legal obligation for total or partial support of such child in anticipation of adoption of such child")
pub relation placed_for_adoption(person: Person, child: Person, on: Date) kind empirical {
    label en unofficial "case fact: person assumed a legal support obligation for child in anticipation of adoption, on this date (section 9832(d)(5)) — this is the fact `01-portability-9801.law`'s adopted-child protection reads via `is_dependent_of`/`became_dependent_on`";
}

@source(IRC_S9832_D, relation = formalizes, coverage = partial, quote = "a dependent (as such term is used for purposes of section 9801(f)(2)) of such individual")
pub relation family_member(person: Person, of: Person) kind institutional {
    label en unofficial "section 9832(d)(6): person is a family member of `of` — a dependent under section 9801(f)(2), or a first- through fourth-degree relative. The relative-degree computation itself is not modeled (TECH_GAP: no pinned genealogical-degree primitive in this corpus); a dependent is derived from `is_dependent_of`.";
}
rule FamilyMemberViaDependent(person: Person, of: Person) strict {
    when is_dependent_of(person, of);
    then family_member(person, of);
}

pub enum GeneticInformationKind { OwnGeneticTest; FamilyGeneticTest; FamilyDiseaseManifestation; }
@source(IRC_S9832_D, relation = formalizes, coverage = partial, quote = "information about—")
pub relation genetic_information_item(person: Person, kind: GeneticInformationKind) kind empirical {
    label en unofficial "case fact: this item of information about `person` is genetic information of the named section 9832(d)(7)(A) kind (sex/age are excluded by (d)(7)(C) — a case must not assert those as this kind)";
}

@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "an analysis of human DNA, RNA, chromosomes, proteins, or metabolites, that detects genotypes, mutations, or chromosomal changes")
pub relation genetic_test_9832(analysis_item: Person) kind empirical {
    label en unofficial "case fact/classification: this analysis is a genetic test under section 9832(d)(8)(A) (not merely a protein/metabolite analysis excluded by (d)(8)(B))";
}

@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "rules for, or determination of, eligibility (including enrollment and continued eligibility) for benefits under the plan or coverage")
pub relation underwriting_purpose_eligibility(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9832(d)(10)(A): a rule/determination of eligibility for benefits is, by definition, for underwriting purposes";
}
@source(IRC_S9832_D, relation = formalizes, coverage = exact, quote = "the computation of premium or contribution amounts under the plan or coverage")
pub relation underwriting_purpose_premium_computation(plan: GroupHealthPlan) kind institutional {
    label en unofficial "section 9832(d)(10)(B): computing premium/contribution amounts is, by definition, for underwriting purposes";
}

// ===========================================================================
// §9831 — general exceptions
// ===========================================================================

@source(IRC_S9831_A, relation = formalizes, coverage = exact, quote = "The requirements of this chapter shall not apply to—")
pub relation chapter_100_exempt(plan: GroupHealthPlan) kind institutional {
    label en official "section 9831(a): chapter 100 does not apply to this plan (governmental plan, or fewer than 2 current-employee participants)";
}
rule Chapter100ExemptGovernmentalPlan(plan: GroupHealthPlan) strict {
    when governmental_plan(plan);
    then chapter_100_exempt(plan);
}

@source(IRC_S9831_A, relation = formalizes, coverage = exact, quote = "any group health plan for any plan year if, on the first day of such plan year, such plan has less than 2 participants who are current employees")
pub relation current_employee_participant_count_on_first_day(plan: GroupHealthPlan, y: TaxableYear, count: Integer) kind empirical {
    label en unofficial "case fact: the number of participants who are current employees on the first day of this plan year";
}
rule Chapter100ExemptFewParticipants(plan: GroupHealthPlan, y: TaxableYear, count: Integer) strict {
    when current_employee_participant_count_on_first_day(plan, y, count) and count < 2;
    then chapter_100_exempt(plan);
}

@source(IRC_S9831_B, relation = formalizes, coverage = exact, quote = "The requirements of this chapter shall not apply to any group health plan in relation to its provision of excepted benefits described in section 9832(c)(1).")
pub relation benefit_provided_under_plan(benefit: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this benefit is provided under this group health plan (binds the plan/benefit pair for the section 9831(b)/(c) 'in relation to' exemptions)";
}
pub relation chapter_100_exempt_as_to_benefit(plan: GroupHealthPlan, benefit: Person) kind institutional {
    label en official "section 9831(b)/(c): chapter 100 does not apply to this plan IN RELATION TO its provision of this particular excepted benefit";
}
rule Chapter100ExemptAsToBenefitCategory1(plan: GroupHealthPlan, benefit: Person) strict {
    when benefit_provided_under_plan(benefit, plan)
        and excepted_benefit_category(benefit, NotSubjectToRequirements);
    then chapter_100_exempt_as_to_benefit(plan, benefit);
}

@source(IRC_S9831_C, relation = formalizes, coverage = partial, quote = "The requirements of this chapter shall not apply to any group health plan in relation to its provision of excepted benefits described in section 9832(c)(2) if the benefits—")
pub relation benefit_offered_separately_or_not_integral(benefit: Person) kind empirical {
    label en unofficial "case fact/classification: the (c)(2) benefit is provided under a separate policy/certificate/contract of insurance, or is otherwise not an integral part of the plan (section 9831(c)(1))";
}
rule Chapter100ExemptAsToBenefitCategory2(plan: GroupHealthPlan, benefit: Person) strict {
    when benefit_provided_under_plan(benefit, plan)
        and excepted_benefit_category(benefit, NotSubjectIfOfferedSeparately)
        and benefit_offered_separately_or_not_integral(benefit);
    then chapter_100_exempt_as_to_benefit(plan, benefit);
}

@source(IRC_S9831_C, relation = formalizes, coverage = partial, quote = "The requirements of this chapter shall not apply to any group health plan in relation to its provision of excepted benefits described in section 9832(c)(3) if all of the following conditions are met")
pub relation benefit_independent_noncoordinated(benefit: Person) kind empirical {
    label en unofficial "case fact/classification: all three (c)(2)(A)-(C) conditions are met — separate policy, no coordination with any other plan exclusion, paid without regard to whether the same event is covered elsewhere (section 9831(c)(2))";
}
rule Chapter100ExemptAsToBenefitCategory3(plan: GroupHealthPlan, benefit: Person) strict {
    when benefit_provided_under_plan(benefit, plan)
        and excepted_benefit_category(benefit, NotSubjectIfIndependentNoncoordinated)
        and benefit_independent_noncoordinated(benefit);
    then chapter_100_exempt_as_to_benefit(plan, benefit);
}

@source(IRC_S9831_C, relation = formalizes, coverage = exact, quote = "The requirements of this chapter shall not apply to any group health plan in relation to its provision of excepted benefits described in section 9832(c)(4) if the benefits are provided under a separate policy, certificate, or contract of insurance.")
pub relation benefit_under_separate_policy(benefit: Person) kind empirical {
    label en unofficial "case fact/classification: the (c)(4) supplemental benefit is provided under a separate policy/certificate/contract of insurance (section 9831(c)(3))";
}
rule Chapter100ExemptAsToBenefitCategory4(plan: GroupHealthPlan, benefit: Person) strict {
    when benefit_provided_under_plan(benefit, plan)
        and excepted_benefit_category(benefit, NotSubjectIfSeparatePolicy)
        and benefit_under_separate_policy(benefit);
    then chapter_100_exempt_as_to_benefit(plan, benefit);
}

// (d) qualified small employer HRA exclusion: a definitional carve-out from
// "group health plan" for THIS TITLE, not a chapter-100-specific exception —
// classified `non_normative`-adjacent (it removes the arrangement from the
// `GroupHealthPlan` type's own scope rather than exempting a plan from a
// duty). The $4,950/$10,000 caps ((d)(2)(B)(iii)) are pinned statutory
// amounts but are inflation-adjusted after 2016 by (d)(2)(D)(ii) — the
// published (indexed) figure for a given year is a SOURCE_GAP (Rev. Proc.
// not pinned in this package's text), per AGENT-BRIEF's "never invent a
// rate" rule; see coverage row 26/9831/d/2/d/ii/u1 and TECH-GAPS.md.
pub enum QsehraCap { BaseYear2016; }
@source(IRC_S9831_D, relation = formalizes, coverage = exact, quote = "the amount of payments and reimbursements described in clause (ii) for any year do not exceed $4,950 ($10,000 in the case of an arrangement that also provides for payments or reimbursements for family members of the employee)")
pub relation qsehra_statutory_cap_2016(covers_family: Boolean, amount: Money) kind institutional {
    label en official "section 9831(d)(2)(B)(iii): the 2016 base-year statutory caps before inflation adjustment — $4,950 (individual), $10,000 (with family members)";
}
rule QsehraStatutoryCapIndividual strict {
    then qsehra_statutory_cap_2016(false, 4950.00 USD);
}
rule QsehraStatutoryCapFamily strict {
    then qsehra_statutory_cap_2016(true, 10000.00 USD);
}
