// 26 U.S.C. §9813 — Coverage of dependent students on medically necessary
// leave of absence. Stage 1b (IRC-18-K).

use self::{
    GroupHealthPlan,
    IRC_S9813_A,
    IRC_S9813_B,
    IRC_S9813_C,
    IRC_S9813_D,
    IRC_S9813_E,
    Person,
    plan_sponsor,
};

@source(IRC_S9813_A, relation = formalizes, coverage = partial, quote = "the term \"medically necessary leave of absence\" means, with respect to a dependent child described in subsection (b)(2) in connection with a group health plan, a leave of absence of such child from a postsecondary educational institution")
pub relation medically_necessary_leave_of_absence(dependent: Person, plan: GroupHealthPlan, begins: Date) kind empirical {
    label en unofficial "case fact: this dependent child began a medically necessary leave of absence (or other enrollment change) from a postsecondary educational institution on this date, meeting section 9813(a)(1)-(3) (commenced while suffering a serious illness/injury, medically necessary, causes loss of student status)";
}
@source(IRC_S9813_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply to a group health plan only if the plan, or the issuer of health insurance coverage offered in connection with the plan, has received written certification by a treating physician of the dependent child which states that the child is suffering from a serious illness or injury and that the leave of absence (or other change of enrollment) described in subsection (a) is medically necessary.")
pub relation physician_certification_received(dependent: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan/issuer received the section 9813(b)(3) written physician certification";
}
@source(IRC_S9813_B, relation = formalizes, coverage = partial, quote = "was enrolled in the plan, on the basis of being a student at a postsecondary educational institution (as described in subsection (a)), immediately before the first day of the medically necessary leave of absence involved")
pub relation dependent_enrolled_as_student_before_leave(dependent: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the dependent child was enrolled in the plan as a student immediately before the leave began (section 9813(b)(2)(B))";
}

@source(IRC_S9813_B, relation = formalizes, coverage = exact, quote = "a group health plan shall not terminate coverage of such child under such plan due to a medically necessary leave of absence before the date that is the earlier of—")
pub relation coverage_terminated_due_to_leave(dependent: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the plan terminated the dependent's coverage, due to the medically necessary leave, on this date";
}
pub relation coverage_would_otherwise_terminate_on(dependent: Person, plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the date coverage would otherwise terminate under the plan's own terms, apart from the leave (section 9813(b)(1)(B))";
}

@source(IRC_S9813_B, relation = formalizes, coverage = exact, quote = "In the case of a dependent child described in paragraph (2), a group health plan shall not terminate coverage of such child under such plan due to a medically necessary leave of absence before the date that is the earlier of")
rule S9813ContinuationDuty(dependent: Person, plan: GroupHealthPlan, sponsor: Person, begins: Date, start: Date) strict {
    label en official "section 9813(b)(1), (e): coverage must continue for 1 year after the leave begins, or until it would otherwise terminate under the plan's terms, whichever is earlier; under changed coverage, for the remainder of that period";
    when leave_coverage_applies(dependent, plan, begins, start)
        and plan_sponsor(plan, sponsor);
    then duty S9813DependentStudentContinuation {
        bearer sponsor;
        beneficiary dependent;
        goal maintenance {
            condition not coverage_terminated_before_earlier_of_year_or_own_term(dependent, plan);
            window [start, add_calendar_period(begins, 12 calendar_month)];
        }
    };
}

pub relation coverage_terminated_before_earlier_of_year_or_own_term(dependent: Person, plan: GroupHealthPlan) kind institutional {
    label en unofficial "the plan terminated coverage before EITHER the 1-year mark or its own otherwise-applicable termination date, whichever is earlier — the section 9813(b)(1) breach condition";
}
rule TerminatedBeforeOneYear(dependent: Person, plan: GroupHealthPlan, begins: Date, terminated: Date) defeasible {
    when leave_coverage_applies(dependent, plan, begins, _)
        and coverage_terminated_due_to_leave(dependent, plan, terminated)
        and terminated < add_calendar_period(begins, 12 calendar_month);
    then coverage_terminated_before_earlier_of_year_or_own_term(dependent, plan);
    unless leave_coverage_applies(dependent, plan, begins, _)
        and coverage_terminated_due_to_leave(dependent, plan, terminated)
        and coverage_would_otherwise_terminate_on(dependent, plan, terminated);
}

// --- (c): notice duty ------------------------------------------------------

@source(IRC_S9813_C, relation = formalizes, coverage = exact, quote = "A group health plan shall include, with any notice regarding a requirement for certification of student status for coverage under the plan, a description of the terms of this section for continued coverage during medically necessary leaves of absence.")
pub relation student_status_certification_notice_sent(plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the plan sent a notice regarding the requirement for certification of student status, on this date";
}
pub relation section_9813_description_included_in_notice(plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "case fact: the section 9813 continued-coverage description was included in that notice";
}
rule S9813NoticeDuty(plan: GroupHealthPlan, sponsor: Person, sent: Date) strict {
    label en official "section 9813(c): any student-status-certification notice must include a description of this section's continued-coverage terms";
    when student_status_certification_notice_sent(plan, sent) and plan_sponsor(plan, sponsor);
    then duty S9813NoticeOfContinuedCoverage {
        bearer sponsor;
        beneficiary sponsor;
        goal achievement {
            condition section_9813_description_included_in_notice(plan, sent);
            window [sent, sent];
        }
    };
}

// --- (d): no change in benefits (classification) ---------------------------

@source(IRC_S9813_D, relation = formalizes, coverage = exact, quote = "A dependent child whose benefits are continued under this section shall be entitled to the same benefits as if (during the medically necessary leave of absence) the child continued to be a covered student at the institution of higher education and was not on a medically necessary leave of absence.")
pub relation same_benefits_as_if_still_enrolled(dependent: Person, plan: GroupHealthPlan) kind institutional {
    label en official "section 9813(d): a dependent whose coverage continues under this section is entitled to the SAME benefits as if not on leave";
}
rule S9813SameBenefits(dependent: Person, plan: GroupHealthPlan) strict {
    when leave_coverage_applies(dependent, plan, _, _);
    then same_benefits_as_if_still_enrolled(dependent, plan);
}

// --- (e): continued application when coverage itself changes ---------------
// Stage 3: `leave_coverage_applies` is the one relation the (b) duty, the breach classification and the (d) benefits read.
// It has two producers: the leave covered by the plan itself, and the leave carried over to CHANGED coverage
// (a change of issuer, between insured and self-insured coverage, or otherwise) that still covers dependent children,
// for the remainder of the leave period. JUDGMENT CALL: the physician certification and the pre-leave student enrollment
// are those recorded under the previous coverage ("in the same manner as if the changed coverage had been the previous
// coverage"); the duty of the changed coverage's sponsor starts on the date of the change.

pub relation coverage_arrangement_changed(dependent: Person, old_plan: GroupHealthPlan, new_plan: GroupHealthPlan, on: Date) kind empirical {
    label en unofficial "section 9813(e)(2): the manner in which the dependent child is covered changed on this date, from the old coverage to the new (a change of health insurance coverage or issuer, between insured and self-insured coverage, or otherwise)";
}
pub relation changed_coverage_covers_dependent_children(plan: GroupHealthPlan) kind empirical {
    label en unofficial "section 9813(e)(3): the coverage as changed continues to provide coverage of beneficiaries as dependent children";
}
pub relation leave_coverage_applies(dependent: Person, plan: GroupHealthPlan, begins: Date, start: Date) kind institutional {
    label en official "section 9813(b), (e): this coverage must continue the dependent child's coverage during the medically necessary leave that began on `begins`, from `start` (the leave's start, or the date of the change of coverage)";
}
@source(IRC_S9813_B, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall apply to a group health plan only if the plan, or the issuer of health insurance coverage offered in connection with the plan, has received written certification by a treating physician of the dependent child")
rule LeaveCoverageAppliesUnderOwnPlan(dependent: Person, plan: GroupHealthPlan, begins: Date) strict {
    when medically_necessary_leave_of_absence(dependent, plan, begins)
        and physician_certification_received(dependent, plan)
        and dependent_enrolled_as_student_before_leave(dependent, plan);
    then leave_coverage_applies(dependent, plan, begins, begins);
}
@source(IRC_S9813_E, relation = formalizes, coverage = exact, quote = "this section shall apply to coverage of the child under the changed coverage for the remainder of the period of the medically necessary leave of absence of the dependent child under the plan in the same manner as it would have applied if the changed coverage had been the previous coverage.")
rule LeaveCoverageAppliesUnderChangedCoverage(dependent: Person, old_plan: GroupHealthPlan, new_plan: GroupHealthPlan, begins: Date, changed_on: Date) strict {
    when medically_necessary_leave_of_absence(dependent, old_plan, begins)
        and physician_certification_received(dependent, old_plan)
        and dependent_enrolled_as_student_before_leave(dependent, old_plan)
        and coverage_arrangement_changed(dependent, old_plan, new_plan, changed_on)
        and changed_coverage_covers_dependent_children(new_plan)
        and changed_on >= begins
        and changed_on < add_calendar_period(begins, 12 calendar_month);
    then leave_coverage_applies(dependent, new_plan, begins, changed_on);
}
