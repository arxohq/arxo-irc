// 26 U.S.C. §9812 — Parity in mental health and substance use disorder
// benefits. Priority scope: (a)(1)-(3) and (c) fully, per task instructions.
// (a)(4)-(8) (plan-information duties, NQTL comparative-analysis duty,
// guidance documents) are informational/administrative duties owed to the
// Secretary/public rather than to a participant; modeled at the duty level
// only for (a)(4) and (a)(7)(A)/(8)(A)(iii)(bb) (the ones with an exact
// window in the text); the guidance-document and audit provisions
// ((a)(2)(A) audit process for section 9816, (a)(6),(a)(7)(D) public
// comment, (8)(B)-(C)) are classified `non_normative`/`external_norm_
// unresolved` (agency rulemaking obligations, not a plan's own norm) — see
// coverage rows.

// --- (a)(1)-(2): aggregate lifetime / annual dollar limits ----------------

use self::{
    GroupHealthPlan,
    IRC_S9812_A,
    IRC_S9812_C,
    Person,
    TaxableYear,
    plan_sponsor,
};

pub enum ParityLimitKind { LifetimeLimit; AnnualLimit; }

@source(IRC_S9812_A, relation = formalizes, coverage = partial, quote = "In the case of a group health plan that provides both medical and surgical benefits and mental health or substance use disorder benefits")
pub relation plan_provides_both_med_surg_and_mh_sud(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan provides both medical/surgical benefits and mental health or substance use disorder (MH/SUD) benefits — the gate condition for all of section 9812(a)";
}
pub relation plan_has_aggregate_limit_on_med_surg(plan: GroupHealthPlan, kind: ParityLimitKind, amount: Money) kind empirical {
    label en unofficial "case fact: the plan includes an aggregate lifetime or annual dollar limit on substantially all medical and surgical benefits, at this amount (section 9812(a)(1)(B)/(2)(B) 'applicable limit')";
}
pub relation plan_has_aggregate_limit_on_mh_sud(plan: GroupHealthPlan, kind: ParityLimitKind, amount: Money) kind empirical {
    label en unofficial "case fact: the plan includes an aggregate lifetime or annual dollar limit on mental health or substance use disorder benefits, at this amount";
}

@source(IRC_S9812_A, relation = formalizes, coverage = exact, quote = "If the plan does not include an aggregate lifetime limit on substantially all medical and surgical benefits, the plan may not impose any aggregate lifetime limit on mental health or substance use disorder benefits.")
pub relation no_med_surg_limit_bars_mh_sud_limit(plan: GroupHealthPlan, kind: ParityLimitKind) kind institutional {
    label en unofficial "helper classification: no med/surg aggregate limit of this kind exists, so no MH/SUD limit of this kind may be imposed (feeds the prohibition below)";
}
rule NoMedSurgLifetimeLimitBarsMhSudLimit(plan: GroupHealthPlan) defeasible {
    when plan_provides_both_med_surg_and_mh_sud(plan);
    then no_med_surg_limit_bars_mh_sud_limit(plan, LifetimeLimit);
    unless plan_provides_both_med_surg_and_mh_sud(plan)
        and plan_has_aggregate_limit_on_med_surg(plan, LifetimeLimit, _);
}
rule NoMedSurgAnnualLimitBarsMhSudLimit(plan: GroupHealthPlan) defeasible {
    when plan_provides_both_med_surg_and_mh_sud(plan);
    then no_med_surg_limit_bars_mh_sud_limit(plan, AnnualLimit);
    unless plan_provides_both_med_surg_and_mh_sud(plan)
        and plan_has_aggregate_limit_on_med_surg(plan, AnnualLimit, _);
}
rule S9812A1NoLifetimeLimitProhibition defeasible {
    for plan: GroupHealthPlan;
    for amount: Money;
    for sponsor: Person;
    when no_med_surg_limit_bars_mh_sud_limit(plan, LifetimeLimit)
        and plan_has_aggregate_limit_on_mh_sud(plan, LifetimeLimit, amount)
        and plan_sponsor(plan, sponsor);
    then prohibition S9812NoLifetimeLimitWithoutMedSurgLimit {
        bearer sponsor;
        action plan_has_aggregate_limit_on_mh_sud(plan, LifetimeLimit, amount);
        window [-infinity, infinity];
    };
}
rule S9812A2NoAnnualLimitProhibition defeasible {
    for plan: GroupHealthPlan;
    for amount: Money;
    for sponsor: Person;
    when no_med_surg_limit_bars_mh_sud_limit(plan, AnnualLimit)
        and plan_has_aggregate_limit_on_mh_sud(plan, AnnualLimit, amount)
        and plan_sponsor(plan, sponsor);
    then prohibition S9812NoAnnualLimitWithoutMedSurgLimit {
        bearer sponsor;
        action plan_has_aggregate_limit_on_mh_sud(plan, AnnualLimit, amount);
        window [-infinity, infinity];
    };
}

@source(IRC_S9812_A, relation = formalizes, coverage = exact, quote = "not include any aggregate lifetime limit on mental health or substance use disorder benefits that is less than the applicable lifetime limit")
pub relation mh_sud_limit_below_applicable_limit(plan: GroupHealthPlan, kind: ParityLimitKind) kind institutional {
    label en unofficial "helper: the plan has BOTH a med/surg limit and a strictly lower MH/SUD limit of the same kind — violates (a)(1)(B)(ii)/(a)(2)(B)(ii) unless the plan instead applies the SAME limit to both under (i)";
}
rule MhSudLimitBelowApplicable(plan: GroupHealthPlan, kind: ParityLimitKind, med: Money, mh: Money) strict {
    when plan_has_aggregate_limit_on_med_surg(plan, kind, med)
        and plan_has_aggregate_limit_on_mh_sud(plan, kind, mh)
        and mh < med;
    then mh_sud_limit_below_applicable_limit(plan, kind);
}
rule S9812A1B2BLowerLimitProhibition defeasible {
    for plan: GroupHealthPlan;
    for kind: ParityLimitKind;
    for mh: Money;
    for sponsor: Person;
    when mh_sud_limit_below_applicable_limit(plan, kind)
        and plan_has_aggregate_limit_on_mh_sud(plan, kind, mh)
        and plan_sponsor(plan, sponsor);
    then prohibition S9812LowerMhSudLimitThanApplicable {
        bearer sponsor;
        action plan_has_aggregate_limit_on_mh_sud(plan, kind, mh);
        window [-infinity, infinity];
    };
}

// --- (a)(3): financial requirements / treatment limitations parity --------
//
// "Predominant" (e(2) definition: "the most common or frequent of such type
// of limit or requirement") is modeled by COUNTING, over the medical/
// surgical benefits the plan provides, how many are subject to each
// asserted financial-requirement LEVEL, and picking the level with the
// largest count via the "no strictly larger count exists" idiom (avoids a
// max-over-derived aggregate, same technique as `excise-entities`' taxable-
// period-end). The regulatory refinement (a fraction — e.g. the commonly
// cited "more than 2/3 of medical/surgical benefits" substantially-all test)
// is NOT in this section's own text: EXTERNAL_DEPENDENCY on 45 CFR 146.136
// (Secretary regulations), not invented here.

pub relation med_surg_benefit_financial_requirement_level(plan: GroupHealthPlan, benefit: Person, level: Money) kind empirical {
    label en unofficial "case fact: this medical/surgical benefit (identified by a Person-typed benefit-line placeholder, per the corpus convention of typing case-asserted line items as Person when no dedicated entity exists yet) is subject to this financial-requirement level (e.g. a copay/coinsurance amount) under the plan";
}
relation financial_requirement_level_count(plan: GroupHealthPlan, level: Money, count: Integer) kind institutional {
    label en unofficial "how many medical/surgical benefits of the plan carry this financial-requirement level";
}
rule FinancialRequirementLevelCount(plan: GroupHealthPlan, level: Money) strict {
    when med_surg_benefit_financial_requirement_level(plan, _, level);
    then financial_requirement_level_count(plan, level,
        sum all one: Integer for benefit: Person
            where med_surg_benefit_financial_requirement_level(plan, benefit, level) and one == 1);
}
relation larger_count_level_exists(plan: GroupHealthPlan, level: Money) kind institutional {
    label en unofficial "some OTHER financial-requirement level has a strictly larger count of medical/surgical benefits than `level` — used to pick the predominant (most common) level without a max-over-derived aggregate";
}
rule LargerCountLevelExists(plan: GroupHealthPlan, level: Money, count: Integer, level2: Money, count2: Integer) defeasible {
    when financial_requirement_level_count(plan, level, count)
        and financial_requirement_level_count(plan, level2, count2)
        and count2 > count;
    then larger_count_level_exists(plan, level);
}
@source(IRC_S9812_A, relation = formalizes, coverage = partial, quote = "A financial requirement or treatment limit is considered to be predominant if it is the most common or frequent of such type of limit or requirement.")
pub relation predominant_financial_requirement_level(plan: GroupHealthPlan, level: Money) kind institutional {
    label en official "section 9812(a)(3)(B)(ii): the most common/frequent financial-requirement level applied to the plan's medical/surgical benefits";
}
rule PredominantFinancialRequirementLevel(plan: GroupHealthPlan, level: Money) defeasible {
    when financial_requirement_level_count(plan, level, _);
    unless larger_count_level_exists(plan, level);
    then predominant_financial_requirement_level(plan, level);
}

pub relation mh_sud_financial_requirement_level(plan: GroupHealthPlan, level: Money) kind empirical {
    label en unofficial "case fact: the financial-requirement level (copay/coinsurance amount) the plan applies to mental health or substance use disorder benefits";
}
@source(IRC_S9812_A, relation = formalizes, coverage = exact, quote = "the financial requirements applicable to such mental health or substance use disorder benefits are no more restrictive than the predominant financial requirements applied to substantially all medical and surgical benefits covered by the plan")
pub relation mh_sud_financial_requirement_more_restrictive(plan: GroupHealthPlan, mh_level: Money, predominant: Money) kind institutional {
    label en unofficial "classification: the plan's MH/SUD financial-requirement level is strictly higher (more restrictive) than the predominant medical/surgical level";
}
rule MhSudFinancialRequirementMoreRestrictive(plan: GroupHealthPlan, mh: Money, predominant: Money) defeasible {
    when mh_sud_financial_requirement_level(plan, mh)
        and predominant_financial_requirement_level(plan, predominant)
        and mh > predominant;
    then mh_sud_financial_requirement_more_restrictive(plan, mh, predominant);
}
rule S9812A3FinancialRequirementParityProhibition defeasible {
    for plan: GroupHealthPlan;
    for mh: Money;
    for predominant: Money;
    for sponsor: Person;
    when mh_sud_financial_requirement_more_restrictive(plan, mh, predominant) and plan_sponsor(plan, sponsor);
    then prohibition S9812MoreRestrictiveFinancialRequirement {
        bearer sponsor;
        action mh_sud_financial_requirement_level(plan, mh);
        window [-infinity, infinity];
    };
}

@source(IRC_S9812_A, relation = formalizes, coverage = exact, quote = "there are no separate cost sharing requirements that are applicable only with respect to mental health or substance use disorder benefits")
pub relation plan_has_mh_sud_only_cost_sharing(plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: the plan imposes a cost-sharing requirement that applies ONLY to MH/SUD benefits (with no medical/surgical analogue)";
}
rule S9812A3NoMhSudOnlyCostSharingProhibition defeasible {
    for plan: GroupHealthPlan;
    for sponsor: Person;
    when plan_has_mh_sud_only_cost_sharing(plan) and plan_sponsor(plan, sponsor);
    then prohibition S9812NoMhSudOnlyCostSharing {
        bearer sponsor;
        action plan_has_mh_sud_only_cost_sharing(plan);
        window [-infinity, infinity];
    };
}

// mental_health_parity_met: the pub interface symbol the assignment names.
pub relation mental_health_parity_met(plan: GroupHealthPlan) kind institutional {
    label en unofficial "the plan's MH/SUD financial requirements/treatment limitations meet section 9812(a)(3) parity (no more-restrictive finding and no MH/SUD-only cost sharing) — an affirmative check for a consumer package, not itself a statutory term";
}
rule MentalHealthParityMet(plan: GroupHealthPlan) defeasible {
    when plan_provides_both_med_surg_and_mh_sud(plan);
    unless mh_sud_financial_requirement_more_restrictive(plan, _, _)
        and plan_provides_both_med_surg_and_mh_sud(plan);
    unless plan_has_mh_sud_only_cost_sharing(plan)
        and plan_provides_both_med_surg_and_mh_sud(plan);
    then mental_health_parity_met(plan);
}

// --- (a)(4): availability of plan information (duty) -----------------------

@source(IRC_S9812_A, relation = formalizes, coverage = exact, quote = "The criteria for medical necessity determinations made under the plan with respect to mental health or substance use disorder benefits shall be made available by the plan administrator in accordance with regulations to any current or potential participant, beneficiary, or contracting provider upon request.")
pub relation medical_necessity_criteria_requested_on(plan: GroupHealthPlan, requester: Person, on: Date) kind empirical {
    label en unofficial "case fact: a current/potential participant, beneficiary, or contracting provider requested the plan's MH/SUD medical-necessity criteria on this date";
}
pub relation medical_necessity_criteria_provided_on(plan: GroupHealthPlan, requester: Person, on: Date) kind empirical {
    label en unofficial "case fact: the plan administrator made the criteria available on this date";
}
rule S9812A4AvailabilityOfCriteriaDuty(plan: GroupHealthPlan, sponsor: Person, requester: Person, requested: Date) strict {
    label en official "section 9812(a)(4): the plan administrator shall make the medical-necessity criteria available upon request";
    when medical_necessity_criteria_requested_on(plan, requester, requested) and plan_sponsor(plan, sponsor);
    then duty S9812AvailabilityOfCriteria {
        bearer sponsor;
        beneficiary requester;
        goal achievement {
            condition medical_necessity_criteria_provided_on(plan, requester, _);
            window [requested, infinity];
        }
    };
}

// --- (c)(1): small employer exemption --------------------------------------

@source(IRC_S9812_C, relation = formalizes, coverage = exact, quote = "the term \"small employer\" means, with respect to a calendar year and a plan year, an employer who employed an average of at least 2 (or 1 in the case of an employer residing in a State that permits small groups to include a single individual) but not more than 50 employees on business days during the preceding calendar year")
pub relation average_employees_preceding_calendar_year(employer: Person, average: Decimal) kind empirical {
    label en unofficial "case fact: the average number of employees the employer employed on business days during the preceding calendar year (section 9812(c)(1)(B))";
}
pub relation state_permits_single_individual_small_group(employer: Person) kind empirical {
    label en unofficial "case fact/classification: the employer resides in a State that permits small groups to include a single individual (lowers the floor from 2 to 1)";
}
pub relation small_employer_9812(employer: Person) kind institutional {
    label en official "section 9812(c)(1)(B): the employer is a 'small employer' for this section (average 2-50 employees, or 1-50 in a single-individual-small-group State)";
}
rule SmallEmployerOrdinary(employer: Person, average: Decimal) strict {
    when average_employees_preceding_calendar_year(employer, average)
        and average >= 2.0 and average <= 50.0;
    then small_employer_9812(employer);
}
rule SmallEmployerSingleIndividualState(employer: Person, average: Decimal) strict {
    when average_employees_preceding_calendar_year(employer, average)
        and state_permits_single_individual_small_group(employer)
        and average >= 1.0 and average <= 50.0;
    then small_employer_9812(employer);
}
@source(IRC_S9812_C, relation = formalizes, coverage = exact, quote = "This section shall not apply to any group health plan for any plan year of a small employer.")
pub relation small_employer_exempt(plan: GroupHealthPlan, y: TaxableYear) kind institutional {
    label en unofficial "section 9812(c)(1)(A): section 9812 does not apply to a group health plan for a plan year of a small employer — the pub interface symbol the assignment names";
}
rule SmallEmployerExempt(plan: GroupHealthPlan, sponsor: Person, y: TaxableYear) strict {
    when plan_sponsor(plan, sponsor) and small_employer_9812(sponsor) and us.irc.core::year_of(sponsor, y);
    then small_employer_exempt(plan, y);
}

// --- (c)(2): increased cost exemption ---------------------------------------

pub relation cost_increase_percentage(plan: GroupHealthPlan, y: TaxableYear, percentage: Decimal) kind empirical {
    label en unofficial "case fact: the certified percentage increase in actual total costs of coverage attributable to applying section 9812, for the plan year (section 9812(c)(2)(A), determined and certified by an actuary under (c)(2)(C))";
}
pub relation first_plan_year_9812_applied(plan: GroupHealthPlan, y: TaxableYear) kind empirical {
    label en unofficial "case fact: y is the first plan year in which section 9812 was applied to this plan (section 9812(c)(2)(B)(i) sets the 2% threshold for that year, 1% thereafter)";
}
pub relation applicable_cost_exemption_percentage(plan: GroupHealthPlan, y: TaxableYear, percentage: Decimal) kind institutional {
    label en official "section 9812(c)(2)(B): 2 percent for the first plan year section 9812 is applied, 1 percent for each subsequent plan year";
}
rule ApplicableCostExemptionPercentageFirstYear(plan: GroupHealthPlan, y: TaxableYear) strict {
    when first_plan_year_9812_applied(plan, y);
    then applicable_cost_exemption_percentage(plan, y, 2.0);
}
rule ApplicableCostExemptionPercentageSubsequentYear(plan: GroupHealthPlan, y: TaxableYear) defeasible {
    when cost_increase_percentage(plan, y, _);
    then applicable_cost_exemption_percentage(plan, y, 1.0);
    unless cost_increase_percentage(plan, y, _)
        and first_plan_year_9812_applied(plan, y);
}
@source(IRC_S9812_C, relation = formalizes, coverage = exact, quote = "the provisions of this section shall not apply to such plan during the following plan year, and such exemption shall apply to the plan for 1 plan year")
pub relation cost_exemption_qualifies(plan: GroupHealthPlan, y: TaxableYear) kind institutional {
    label en official "section 9812(c)(2)(A): the certified cost increase exceeds the applicable percentage — the plan qualifies for a 1-plan-year cost exemption in the FOLLOWING plan year";
}
rule CostExemptionQualifies(plan: GroupHealthPlan, y: TaxableYear, actual: Decimal, applicable: Decimal) defeasible {
    when cost_increase_percentage(plan, y, actual)
        and applicable_cost_exemption_percentage(plan, y, applicable)
        and actual > applicable;
    then cost_exemption_qualifies(plan, y);
}
