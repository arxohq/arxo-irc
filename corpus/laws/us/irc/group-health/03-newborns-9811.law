// 26 U.S.C. §9811 — Standards relating to benefits for mothers and newborns.
// Priority section (fully, per task instructions).

use self::{
    GroupHealthPlan,
    IRC_S9811_A,
    IRC_S9811_B,
    IRC_S9811_C,
    Person,
    plan_sponsor,
    state_law_preempts_9811,
};

pub entity HospitalStay {
    label en unofficial "one hospital length-of-stay in connection with childbirth for a mother or her newborn child";
}
pub enum DeliveryKind { VaginalDelivery; CaesareanSection; }

pub relation hospital_stay_for(stay: HospitalStay, mother_or_newborn: Person, plan: GroupHealthPlan) kind empirical {
    label en unofficial "case fact: this hospital stay is for the named mother or newborn child, under this plan";
}
pub relation hospital_stay_delivery_kind(stay: HospitalStay, kind: DeliveryKind) kind empirical {
    label en unofficial "case fact: the delivery was a normal vaginal delivery or a caesarean section (section 9811(a)(1)(A))";
}
pub relation hospital_stay_hours(stay: HospitalStay, hours: Integer) kind empirical {
    label en unofficial "case fact: the covered length of the hospital stay, in hours, under the plan's benefit design";
}
@source(IRC_S9811_A, relation = formalizes, coverage = exact, quote = "the decision to discharge the mother or her newborn child prior to the expiration of the minimum length of stay otherwise required under paragraph (1)(A) is made by an attending provider in consultation with the mother")
pub relation discharge_decided_by_attending_provider_with_mother(stay: HospitalStay) kind empirical {
    label en unofficial "case fact/classification: the (a)(2) exception applies — an attending provider, in consultation with the mother, made the early-discharge decision";
}

pub relation minimum_stay_hours(kind: DeliveryKind, hours: Integer) kind institutional {
    label en official "section 9811(a)(1)(A): the statutory minimum length of stay — 48 hours for a normal vaginal delivery, 96 hours for a caesarean section";
}
rule MinimumStayHoursVaginal strict {
    then minimum_stay_hours(VaginalDelivery, 48);
}
rule MinimumStayHoursCaesarean strict {
    then minimum_stay_hours(CaesareanSection, 96);
}

@source(IRC_S9811_A, relation = formalizes, coverage = exact, quote = "A group health plan may not—")
rule S9811AMinimumStayProhibition defeasible {
    for stay: HospitalStay;
    for person: Person;
    for plan: GroupHealthPlan;
    for sponsor: Person;
    for kind: DeliveryKind;
    for min: Integer;
    for actual: Integer;
    when hospital_stay_for(stay, person, plan)
        and hospital_stay_delivery_kind(stay, kind)
        and hospital_stay_hours(stay, actual)
        and minimum_stay_hours(kind, min)
        and actual < min
        and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811MinimumStayRestriction {
        bearer sponsor;
        action hospital_stay_hours(stay, actual);
        window [-infinity, infinity];
    };
    unless hospital_stay_hours(stay, actual)
        and plan_sponsor(plan, sponsor)
        and discharge_decided_by_attending_provider_with_mother(stay);
}

@source(IRC_S9811_A, relation = formalizes, coverage = exact, quote = "require that a provider obtain authorization from the plan or the issuer for prescribing any length of stay required under subparagraph (A) (without regard to paragraph (2))")
pub relation plan_required_prior_authorization_for_stay(stay: HospitalStay) kind empirical {
    label en unofficial "case fact: the plan required a provider to obtain prior authorization for prescribing a length of stay within the statutory minimum (section 9811(a)(1)(B) — no exception, even under (a)(2))";
}
rule S9811ANoPriorAuthorizationProhibition defeasible {
    for stay: HospitalStay;
    for person: Person;
    for plan: GroupHealthPlan;
    for sponsor: Person;
    when plan_required_prior_authorization_for_stay(stay)
        and hospital_stay_for(stay, person, plan)
        and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811NoPriorAuthorizationForMinimumStay {
        bearer sponsor;
        action plan_required_prior_authorization_for_stay(stay);
        window [-infinity, infinity];
    };
}

// --- (b): the five additional prohibitions --------------------------------

@source(IRC_S9811_B, relation = formalizes, coverage = partial, quote = "deny to the mother or her newborn child eligibility, or continued eligibility, to enroll or to renew coverage under the terms of the plan, solely for the purpose of avoiding the requirements of this section")
pub relation plan_denied_eligibility_to_avoid_9811(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: the plan denied (continued) eligibility to enroll/renew solely to avoid section 9811";
}
rule S9811B1NoEligibilityDenialToAvoidProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for sponsor: Person;
    when plan_denied_eligibility_to_avoid_9811(plan, person) and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811B1NoEligibilityDenialToAvoid {
        bearer sponsor;
        action plan_denied_eligibility_to_avoid_9811(plan, person);
        window [-infinity, infinity];
    };
}

@source(IRC_S9811_B, relation = formalizes, coverage = partial, quote = "provide monetary payments or rebates to mothers to encourage such mothers to accept less than the minimum protections available under this section")
pub relation plan_paid_mother_to_accept_less_than_minimum(plan: GroupHealthPlan, person: Person) kind empirical {
    label en unofficial "case fact: the plan offered a monetary payment/rebate to the mother to encourage accepting less than the section 9811 minimum";
}
rule S9811B2NoIncentivePaymentsToMothersProhibition defeasible {
    for plan: GroupHealthPlan;
    for person: Person;
    for sponsor: Person;
    when plan_paid_mother_to_accept_less_than_minimum(plan, person) and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811B2NoIncentivePaymentsToMothers {
        bearer sponsor;
        action plan_paid_mother_to_accept_less_than_minimum(plan, person);
        window [-infinity, infinity];
    };
}

@source(IRC_S9811_B, relation = formalizes, coverage = partial, quote = "penalize or otherwise reduce or limit the reimbursement of an attending provider because such provider provided care to an individual participant or beneficiary in accordance with this section")
pub relation plan_penalized_provider_for_9811_compliant_care(plan: GroupHealthPlan, provider: Person) kind empirical {
    label en unofficial "case fact: the plan penalized/reduced/limited reimbursement of an attending provider because the provider complied with section 9811";
}
rule S9811B3NoProviderPenaltyProhibition defeasible {
    for plan: GroupHealthPlan;
    for provider: Person;
    for sponsor: Person;
    when plan_penalized_provider_for_9811_compliant_care(plan, provider) and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811B3NoProviderPenalty {
        bearer sponsor;
        action plan_penalized_provider_for_9811_compliant_care(plan, provider);
        window [-infinity, infinity];
    };
}

@source(IRC_S9811_B, relation = formalizes, coverage = partial, quote = "provide incentives (monetary or otherwise) to an attending provider to induce such provider to provide care to an individual participant or beneficiary in a manner inconsistent with this section")
pub relation plan_incentivized_provider_against_9811(plan: GroupHealthPlan, provider: Person) kind empirical {
    label en unofficial "case fact: the plan offered an incentive to induce a provider to act inconsistently with section 9811";
}
rule S9811B4NoIncentiveAgainstComplianceProhibition defeasible {
    for plan: GroupHealthPlan;
    for provider: Person;
    for sponsor: Person;
    when plan_incentivized_provider_against_9811(plan, provider) and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811B4NoIncentiveAgainstCompliance {
        bearer sponsor;
        action plan_incentivized_provider_against_9811(plan, provider);
        window [-infinity, infinity];
    };
}

@source(IRC_S9811_B, relation = formalizes, coverage = partial, quote = "restrict benefits for any portion of a period within a hospital length of stay required under subsection (a) in a manner which is less favorable than the benefits provided for any preceding portion of such stay")
pub relation plan_restricted_benefits_for_later_stay_portion(plan: GroupHealthPlan, stay: HospitalStay) kind empirical {
    label en unofficial "case fact: within a required minimum stay, the plan applied less favorable benefits (e.g. higher cost-sharing) to a later portion of the stay than to an earlier portion (section 9811(b)(5), subject to (c)(3))";
}
rule S9811B5NoLessFavorableLaterPortionProhibition defeasible {
    for plan: GroupHealthPlan;
    for stay: HospitalStay;
    for sponsor: Person;
    when plan_restricted_benefits_for_later_stay_portion(plan, stay) and plan_sponsor(plan, sponsor)
        and not_known(state_law_preempts_9811(plan));
    then prohibition S9811B5NoLessFavorableLaterPortion {
        bearer sponsor;
        action plan_restricted_benefits_for_later_stay_portion(plan, stay);
        window [-infinity, infinity];
    };
}

// --- (c)(3): rule of construction — uniform cost-sharing IS permitted ------

@source(IRC_S9811_C, relation = formalizes, coverage = exact, quote = "except that such coinsurance or other cost-sharing for any portion of a period within a hospital length of stay required under subsection (a) may not be greater than such coinsurance or cost-sharing for any preceding portion of such stay")
pub relation cost_sharing_uniform_across_stay(plan: GroupHealthPlan, stay: HospitalStay) kind empirical {
    label en unofficial "case fact/classification: cost-sharing (deductibles, coinsurance) is uniform (not increasing) across every portion of the stay — this is section 9811(c)(3)'s own textual limit on what (b)(5) forbids, restated here for completeness; a plan meeting it does not violate (b)(5)";
}
