// Chapter 35 (section 4401) and chapter 36 (section 4461). Priority list,
// IRC-13 stage 1.

// =====================================================================
// Section 4401 — tax on wagers
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4401_A,
    IRC_S4401_B,
    IRC_S4401_C,
    IRC_S4461_B,
    IRC_S4461_C,
    Person,
    excise_tax_due,
    liable_for_excise,
};

pub entity WagerEvent : ExciseEvent;

pub relation wager_authorized_by_state(e: WagerEvent) kind empirical {
    label en unofficial "section 4401(a)(1): the wager is authorized under the law of the State in which accepted";
}
pub relation wager_amount_charges_included(e: WagerEvent, amount: Money) kind empirical {
    label en unofficial "section 4401(b): the amount of the wager, including all charges incident to placing it, UNLESS the taxpayer establishes a separately collected tax-equivalent charge";
}
pub relation wager_tax_collected_as_separate_charge(e: WagerEvent, amount: Money) kind empirical {
    label en unofficial "section 4401(b) proviso: the taxpayer establishes, per Secretary regulations, that an amount equal to the tax has been collected as a separate charge from the person placing the wager";
}
pub relation wager_has_separate_tax_charge(e: WagerEvent) kind empirical {
    label en unofficial "the case asserts that some separately collected tax-equivalent charge exists for this wager (kept apart from the amount so `not_known` can test its absence without an unbound amount variable, per this package's §190 range-restriction convention)";
}
pub relation wager_accepted_by(e: WagerEvent, acceptor: Person) kind empirical {
    label en unofficial "section 4401(c): the person engaged in the business of accepting this wager, or conducting the wagering pool or lottery it was placed in";
}

pub relation wager_taxable_amount(e: WagerEvent, amount: Money) kind institutional {
    label en official "section 4401(b): the amount of the wager for tax purposes, after excluding any separately collected tax-equivalent charge";
}
@source(IRC_S4401_B, relation = formalizes, coverage = exact, quote = "if the taxpayer establishes, in accordance with regulations prescribed by the Secretary, that an amount equal to the tax imposed by this subchapter has been collected as a separate charge from the person placing such wager, the amount so collected shall be excluded")
rule WagerTaxableAmountExcludingSeparateCharge(e: WagerEvent, included: Money, separate: Money) strict {
    when wager_amount_charges_included(e, included) and wager_tax_collected_as_separate_charge(e, separate);
    then wager_taxable_amount(e, included - separate);
}
@source(IRC_S4401_B, relation = formalizes, coverage = exact, quote = "In determining the amount of any wager for the purposes of this subchapter, all charges incident to the placing of such wager shall be included")
rule WagerTaxableAmountFull(e: WagerEvent, included: Money) strict {
    when wager_amount_charges_included(e, included) and not_known(wager_has_separate_tax_charge(e));
    then wager_taxable_amount(e, included);
}

@source(IRC_S4401_A, relation = formalizes, coverage = exact, quote = "There shall be imposed on any wager authorized under the law of the State in which accepted an excise tax equal to 0.25 percent of the amount of such wager.")
rule AuthorizedWagerTax(e: WagerEvent, amount: Money) strict {
    when wager_authorized_by_state(e) and wager_taxable_amount(e, amount);
    then excise_tax_due(e, round(amount * S4401AuthorizedWagerRatePercent, 2, "HALF_UP"));
}
@source(IRC_S4401_A, relation = formalizes, coverage = exact, quote = "There shall be imposed on any wager not described in paragraph (1) an excise tax equal to 2 percent of the amount of such wager.")
rule UnauthorizedWagerTax(e: WagerEvent, amount: Money) strict {
    when wager_taxable_amount(e, amount) and not_known(wager_authorized_by_state(e));
    then excise_tax_due(e, round(amount * S4401UnauthorizedWagerRatePercent, 2, "HALF_UP"));
}

@source(IRC_S4401_C, relation = formalizes, coverage = exact, quote = "Each person who is engaged in the business of accepting wagers shall be liable for and shall pay the tax under this subchapter on all wagers placed with him.")
rule WagerLiability(e: WagerEvent, acceptor: Person, amount: Money) defeasible {
    when wager_accepted_by(e, acceptor) and excise_tax_due(e, amount);
    then liable_for_excise(acceptor, e, amount);
}

// =====================================================================
// Section 4461 — harbor maintenance tax
// =====================================================================

pub entity PortUseEvent : ExciseEvent;

pub enum PortUseDirection {
    CargoEnteringUnitedStates;
    OtherPortUse;
}

pub relation port_use(e: PortUseEvent, direction: PortUseDirection, cargo_value: Money, unloaded_on: Date) kind empirical {
    label en unofficial "section 4461(a): any port use, with the value of the commercial cargo involved (section 4462) and the date of unloading (section 4461(c)(2))";
}
pub relation port_use_importer(e: PortUseEvent, importer: Person) kind empirical {
    label en unofficial "section 4461(c)(1)(A): the importer, for cargo entering the United States";
}
pub relation port_use_shipper(e: PortUseEvent, shipper: Person) kind empirical {
    label en unofficial "section 4461(c)(1)(B): the shipper, in any other case";
}

@source(IRC_S4461_B, relation = formalizes, coverage = exact, quote = "The amount of the tax imposed by subsection (a) on any port use shall be an amount equal to 0.125 percent of the value of the commercial cargo involved.")
rule HarborMaintenanceTax(e: PortUseEvent, value: Money) strict {
    when port_use(e, _, value, _);
    then excise_tax_due(e, round(value * S4461RatePercent, 2, "HALF_UP"));
}

@source(IRC_S4461_C, relation = formalizes, coverage = exact, quote = "in the case of cargo entering the United States, the importer, or")
rule HarborMaintenanceLiabilityImporter(e: PortUseEvent, importer: Person, amount: Money) defeasible {
    when port_use(e, CargoEnteringUnitedStates, _, _) and port_use_importer(e, importer) and excise_tax_due(e, amount);
    then liable_for_excise(importer, e, amount);
}
@source(IRC_S4461_C, relation = formalizes, coverage = exact, quote = "in any other case, the shipper")
rule HarborMaintenanceLiabilityShipper(e: PortUseEvent, shipper: Person, amount: Money) defeasible {
    when port_use(e, OtherPortUse, _, _) and port_use_shipper(e, shipper) and excise_tax_due(e, amount);
    then liable_for_excise(shipper, e, amount);
}
