// Stage 3 (TECH_GAP reduction): section 4662 (gas ton, later sellers treated as manufacturers, corrective-action
// interval), section 4682(d)(3) (limit on the export benefit), section 4501(d) (special acquisitions of stock of
// foreign corporations) and section 4612(d) (the oil spill credit ledger and the affiliated group).

// =====================================================================
// Section 4662(a)(4): the ton of a gas
// =====================================================================

use self::{
    ChemicalSaleEvent,
    CrudeOilEvent,
    CrudeOilEventKind,
    IRC_S4082_B,
    IRC_S4501_C,
    IRC_S4501_D,
    IRC_S4611_C,
    IRC_S4611_F,
    IRC_S4612_D,
    IRC_S4662_A,
    IRC_S4662_B,
    IRC_S4672_A,
    IRC_S4682_D,
    OzoneChemicalEvent,
    Person,
    Secretary,
    StockRepurchaseEvent,
    TaxableFuelEvent,
    chemical_qualified_animal_feed_use,
    chemical_qualified_fertilizer_use,
    chemical_qualified_fuel_use,
    chemical_quantity_tons,
    chemical_sale,
    chemical_use_liability_for_tax,
    corporation_stock_traded_on_established_securities_market,
    crude_oil_event,
    crude_oil_used_on_premises_of_production,
    oil_spill_prepayment_credit,
    oil_spill_rate_portion_of_tax,
    organic_taxable_chemical_in_intermediate_hydrocarbon_stream,
    ozone_chemical_sale_or_use,
    repurchases_including_specified_affiliate_acquisitions,
    stock_repurchase_year,
};

pub relation chemical_gas_sale_cubic_feet(e: ChemicalSaleEvent, cubic_feet: Decimal) kind empirical {
    label en official "section 4662(a)(4): the quantity of the gas sold, in cubic feet";
}
pub relation gas_cubic_feet_equivalent_of_2000_pounds(e: ChemicalSaleEvent, cubic_feet_per_ton: Decimal) kind empirical {
    label en official "section 4662(a)(4): the amount of the gas in cubic feet which is the equivalent of 2,000 pounds on a molecular weight basis (the conversion needs a molecular weight and the temperature and pressure of a cubic foot, which the statute does not state; the case supplies the resulting cubic feet per ton)";
}
@source(IRC_S4662_A, relation = formalizes, coverage = exact, quote = "In the case of any taxable chemical which is a gas, the term \"ton\" means the amount of such gas in cubic feet which is the equivalent of 2,000 pounds on a molecular weight basis.")
rule ChemicalGasTonsFromCubicFeet(e: ChemicalSaleEvent, cf: Decimal, per_ton: Decimal) strict {
    when chemical_gas_sale_cubic_feet(e, cf) and gas_cubic_feet_equivalent_of_2000_pounds(e, per_ton) and per_ton > 0.0;
    then chemical_quantity_tons(e, div_round(cf, per_ton, 6, "HALF_UP"));
}

// =====================================================================
// Section 4662(b)(2)(D), (5)(E), (9)(D), (10)(B): the first later seller or user is treated as the manufacturer
// =====================================================================

pub relation chemical_exempt_as_qualified_fertilizer_substance(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(2)(A): no tax was imposed on the sale or use because the chemical is a qualified fertilizer substance";
}
pub relation chemical_exempt_as_qualified_fuel_substance(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(5)(A): no tax was imposed on the sale or use because the chemical is a qualified fuel substance";
}
pub relation chemical_exempt_as_qualified_animal_feed_substance(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(9)(A): no tax was imposed on the sale or use because the chemical is a qualified animal feed substance";
}
pub relation chemical_exempt_within_intermediate_hydrocarbon_stream(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(10)(A): no tax was imposed on the organic taxable chemical while part of an intermediate hydrocarbon stream";
}
rule ChemicalExemptAsFertilizerSubstance(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Nitric acid" or s == "Sulfuric acid" or s == "Ammonia" or s == "Methane") and chemical_qualified_fertilizer_use(e);
    then chemical_exempt_as_qualified_fertilizer_substance(e);
}
rule ChemicalExemptAsFuelSubstance(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Acetylene" or s == "Benzene" or s == "Butylene" or s == "Butadiene" or s == "Ethylene" or s == "Napthalene" or s == "Propylene" or s == "Toluene" or s == "Xylene") and chemical_qualified_fuel_use(e);
    then chemical_exempt_as_qualified_fuel_substance(e);
}
rule ChemicalExemptAsAnimalFeedSubstance(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Nitric acid" or s == "Sulfuric acid" or s == "Ammonia" or s == "Methane") and chemical_qualified_animal_feed_use(e);
    then chemical_exempt_as_qualified_animal_feed_substance(e);
}
rule ChemicalExemptWithinIntermediateStream(e: ChemicalSaleEvent) strict {
    when chemical_sale(e, _, _, _, _) and organic_taxable_chemical_in_intermediate_hydrocarbon_stream(e);
    then chemical_exempt_within_intermediate_hydrocarbon_stream(e);
}
pub relation first_later_sale_or_use_of_exempted_chemical(later: ChemicalSaleEvent, earlier: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(2)(D), (5)(E), (9)(D): the later event is the first sale or use of the chemical, exempted at the earlier event, other than in a sale or use of the exempt kind (the link and the order are asserted; the language has no event-history relation, G1607)";
}
pub relation treated_as_manufacturer_of_chemical(p: Person, e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b): for purposes of section 4661(a), the person is treated as the manufacturer of the chemical";
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "the first person who sells or uses such chemical other than in a sale or use described in subparagraph (A) shall be treated as the manufacturer of such chemical.")
rule FirstLaterSellerOfFertilizerSubstanceIsManufacturer(later: ChemicalSaleEvent, earlier: ChemicalSaleEvent, seller: Person) strict {
    when first_later_sale_or_use_of_exempted_chemical(later, earlier)
        and chemical_exempt_as_qualified_fertilizer_substance(earlier)
        and not_known(chemical_qualified_fertilizer_use(later))
        and chemical_sale(later, _, _, _, seller);
    then treated_as_manufacturer_of_chemical(seller, later);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "For purposes of section 4661(a), if no tax was imposed by such section on the sale or use of any chemical by reason of subparagraph (A), the first person who sells or uses such chemical other than in a sale or use described in subparagraph (A) shall be treated as the manufacturer of such chemical.")
rule FirstLaterSellerOfFuelSubstanceIsManufacturer(later: ChemicalSaleEvent, earlier: ChemicalSaleEvent, seller: Person) strict {
    when first_later_sale_or_use_of_exempted_chemical(later, earlier)
        and chemical_exempt_as_qualified_fuel_substance(earlier)
        and not_known(chemical_qualified_fuel_use(later))
        and chemical_sale(later, _, _, _, seller);
    then treated_as_manufacturer_of_chemical(seller, later);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "For purposes of section 4661(a), if no tax was imposed by such section on the sale or use of any chemical by reason of subparagraph (A), the 1st person who sells or uses such chemical other than in a sale or use described in subparagraph (A) shall be treated as the manufacturer of such chemical.")
rule FirstLaterSellerOfAnimalFeedSubstanceIsManufacturer(later: ChemicalSaleEvent, earlier: ChemicalSaleEvent, seller: Person) strict {
    when first_later_sale_or_use_of_exempted_chemical(later, earlier)
        and chemical_exempt_as_qualified_animal_feed_substance(earlier)
        and not_known(chemical_qualified_animal_feed_use(later))
        and chemical_sale(later, _, _, _, seller);
    then treated_as_manufacturer_of_chemical(seller, later);
}
pub relation organic_chemical_isolated_or_removed_from_intermediate_stream_by(e: ChemicalSaleEvent, actor: Person) kind empirical {
    label en official "section 4662(b)(10)(B): an organic taxable chemical on which no tax was imposed by reason of subparagraph (A) is isolated, extracted, or otherwise removed from, or ceases to be part of, an intermediate hydrocarbon stream, by the given person";
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "(i) such isolation, extraction, removal, or cessation shall be treated as use by the person causing such event, and")
rule StreamRemovalTreatedAsUseByCauser(e: ChemicalSaleEvent, p: Person) strict {
    when chemical_exempt_within_intermediate_hydrocarbon_stream(e) and organic_chemical_isolated_or_removed_from_intermediate_stream_by(e, p);
    then chemical_use_liability_for_tax(e, p);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "(ii) such person shall be treated as the manufacturer of such chemical.")
rule StreamRemovalCauserIsManufacturer(e: ChemicalSaleEvent, p: Person) strict {
    when chemical_exempt_within_intermediate_hydrocarbon_stream(e) and organic_chemical_isolated_or_removed_from_intermediate_stream_by(e, p);
    then treated_as_manufacturer_of_chemical(p, e);
}

// =====================================================================
// Section 4662(b)(8)(B)-(D): the interval during which required corrective action is uncompleted
// =====================================================================

pub enum CorrectiveActionSource {
    FinalPermitUnderSolidWasteDisposalAct3005;
    FinalOrderUnderSolidWasteDisposalAct3004Or3008;
    FinalOrderUnderCercla106;
}
pub relation corrective_action_requirement(e: ChemicalSaleEvent, origin_kind: CorrectiveActionSource, required_on: Date) kind empirical {
    label en official "section 4662(b)(8)(C)(i): the corrective action at the recycling unit is required by the Administrator or an authorized State pursuant to the given final permit or order, from the given date";
}
pub relation corrective_action_completion_certified_on(e: ChemicalSaleEvent, certified: Date) kind empirical {
    label en official "section 4662(b)(8)(C)(ii): the Administrator or the State certifies to the Secretary on this date that the corrective action has been completed";
}
pub relation corrective_action_requires_groundwater_treatment(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(8)(D): the corrective action requires groundwater treatment";
}
pub relation groundwater_treatment_complies_with_permit_or_order(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(8)(D): the treatment complies with the applicable permit or order (until the date it ceases to comply)";
}
pub relation groundwater_treatment_ceased_complying_on(e: ChemicalSaleEvent, ceased: Date) kind empirical {
    label en official "section 4662(b)(8)(D) last sentence: the date the treatment ceases to comply with the permit or order";
}
pub relation corrective_action_required_since(e: ChemicalSaleEvent, since: Date) kind institutional {
    label en official "section 4662(b)(8)(C)(i): the date the corrective action was required by a final permit or order";
}
pub relation corrective_action_certified_completed_by_sale_date(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(8)(C)(ii): completion had been certified on or before the date of the sale";
}
pub relation groundwater_treatment_stopped_complying_by_sale_date(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(8)(D) last sentence: the treatment had ceased to comply on or before the date of the sale";
}
pub relation groundwater_action_treated_as_completed_on_sale_date(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(8)(D): the groundwater treatment action is treated as completed at the close of the 10-year period beginning on the date the action is required, if the treatment complied throughout";
}
pub relation required_corrective_action_uncompleted_on_sale_date(e: ChemicalSaleEvent) kind institutional {
    label en official "section 4662(b)(8)(B), (C): the corrective action required of the taxpayer at the recycling unit is uncompleted on the date of the sale: from the date it was required until completion is certified (or the 10-year groundwater rule completes it)";
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "(i) beginning on the date that the corrective action is required by the Administrator or an authorized State pursuant to—")
rule CorrectiveActionRequiredSince(e: ChemicalSaleEvent, src: CorrectiveActionSource, since: Date) strict {
    when corrective_action_requirement(e, src, since)
        and (src == FinalPermitUnderSolidWasteDisposalAct3005 or src == FinalOrderUnderSolidWasteDisposalAct3004Or3008 or src == FinalOrderUnderCercla106);
    then corrective_action_required_since(e, since);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "(ii) ending on the date the Administrator or such State (as the case may be) certifies to the Secretary that such corrective action has been completed.")
rule CorrectiveActionCertifiedByDate(e: ChemicalSaleEvent, certified: Date, on: Date) strict {
    when corrective_action_completion_certified_on(e, certified) and chemical_sale(e, _, _, on, _) and certified <= on;
    then corrective_action_certified_completed_by_sale_date(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "The preceding sentence shall cease to apply beginning on the date such treatment ceases to comply with such permit or order.")
rule GroundwaterTreatmentStoppedComplyingByDate(e: ChemicalSaleEvent, ceased: Date, on: Date) strict {
    when groundwater_treatment_ceased_complying_on(e, ceased) and chemical_sale(e, _, _, on, _) and ceased <= on;
    then groundwater_treatment_stopped_complying_by_sale_date(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "In the case of corrective action requiring groundwater treatment, such action shall be treated as completed as of the close of the 10-year period beginning on the date such action is required if such treatment complies with the permit or order applicable under subparagraph (C)(i) throughout such period.")
rule GroundwaterActionTreatedAsCompleted(e: ChemicalSaleEvent, since: Date, on: Date) strict {
    when corrective_action_requires_groundwater_treatment(e)
        and groundwater_treatment_complies_with_permit_or_order(e)
        and corrective_action_required_since(e, since)
        and chemical_sale(e, _, _, on, _)
        and on >= add_calendar_period(since, 10 calendar_year)
        and not_known(groundwater_treatment_stopped_complying_by_sale_date(e));
    then groundwater_action_treated_as_completed_on_sale_date(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (B), required corrective action shall be treated as uncompleted during the period—")
rule RequiredCorrectiveActionUncompletedOnSaleDate(e: ChemicalSaleEvent, since: Date, on: Date) strict {
    when corrective_action_required_since(e, since)
        and chemical_sale(e, _, _, on, _)
        and since <= on
        and not_known(corrective_action_certified_completed_by_sale_date(e))
        and not_known(groundwater_action_treated_as_completed_on_sale_date(e));
    then required_corrective_action_uncompleted_on_sale_date(e);
}
// The recycled-metal exemption (RecycledMetalExempt, module 16) now also reads `required_corrective_action_uncompleted_on_sale_date`.

// =====================================================================
// Section 4682(d)(3): limit on the export tax benefit
// =====================================================================

pub enum OzoneChemicalClass {
    NewlyListedChemical;
    OtherOzoneDepletingChemical;
}
pub relation newly_listed_ozone_chemical(e: OzoneChemicalEvent) kind institutional {
    label en official "section 4682(d)(3)(C)(iii): a substance which appears in the table of section 4682(a)(2) below Halon-2402";
}
rule NewlyListedOzoneChemical(e: OzoneChemicalEvent, c: Text) strict {
    when ozone_chemical_sale_or_use(e, c, _, _, _) and (c == "Carbon tetrachloride" or c == "Methyl chloroform" or c == "CFC–13" or c == "CFC–111" or c == "CFC–112" or c == "CFC–211"
        or c == "CFC–212" or c == "CFC–213" or c == "CFC–214" or c == "CFC–215" or c == "CFC–216" or c == "CFC–217");
    then newly_listed_ozone_chemical(e);
}
pub relation ozone_base_year_exported_adjusted_pounds(p: Person, class: OzoneChemicalClass, exported: Decimal) kind empirical {
    label en official "section 4682(d)(3)(B)(ii): the ozone-depletion factor adjusted pounds of the person's chemicals exported in 1986 (1989 for newly listed chemicals), direct exports as determined by the EPA plus indirect exports as allocated to the person by the EPA";
}
pub relation ozone_base_year_produced_adjusted_pounds(p: Person, class: OzoneChemicalClass, produced: Decimal) kind empirical {
    label en official "section 4682(d)(3)(B)(ii): the ozone-depletion factor adjusted pounds of all ozone-depleting chemicals manufactured or produced by the person in 1986 (1989 for newly listed chemicals)";
}
pub relation ozone_tax_on_max_epa_permitted_quantity(p: Person, calendar_year: Integer, class: OzoneChemicalClass, tax: Money) kind empirical {
    label en official "section 4682(d)(3)(B)(i)(I): the aggregate tax which would (but for subsection (d) and (g)) be imposed with respect to the maximum quantity permitted to be manufactured or produced by the person during the calendar year under EPA regulations (other than chemicals with an additional production allowance)";
}
pub relation ozone_tax_on_additional_production_allowance(p: Person, calendar_year: Integer, class: OzoneChemicalClass, tax: Money) kind empirical {
    label en official "section 4682(d)(3)(B)(i)(II): the aggregate tax which would (but for subsection (d) and (g)) be imposed with respect to any additional production allowance granted by the EPA under 40 CFR Part 82 (as in effect on September 14, 1989)";
}
pub relation ozone_tax_imposed_on_imports(p: Person, calendar_year: Integer, class: OzoneChemicalClass, tax: Money) kind empirical {
    label en official "section 4682(d)(3)(B)(i)(III): the aggregate tax which was imposed with respect to ozone-depleting chemicals imported by the person during the calendar year";
}
external judgment relation secretary_determined_comparable_regulations_for_newly_listed_chemicals(class: OzoneChemicalClass) {
    authority Secretary;
    label en official "section 4682(d)(3)(C)(ii)(II): the regulations (whether or not prescribed by the Secretary) which the Secretary determines are comparable to the EPA regulations of clause (i)(II) with respect to newly listed chemicals";
}
pub relation ozone_export_benefit_claimed(p: Person, calendar_year: Integer, class: OzoneChemicalClass, benefit: Money) kind empirical {
    label en official "section 4682(d)(3)(A): the aggregate tax benefit claimed under the rules similar to section 4662(e) for the calendar year";
}
pub relation ozone_additional_allowance_counts(p: Person, calendar_year: Integer, class: OzoneChemicalClass) kind institutional {
    label en official "section 4682(d)(3)(B)(i)(II), (C)(ii)(II): the additional production allowance term counts (for newly listed chemicals only with regulations the Secretary determines comparable)";
}
rule OzoneAdditionalAllowanceCountsOtherChemicals(p: Person, y: Integer) strict {
    when ozone_tax_on_additional_production_allowance(p, y, OtherOzoneDepletingChemical, _);
    then ozone_additional_allowance_counts(p, y, OtherOzoneDepletingChemical);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(II) clause (i)(II) thereof shall be applied by substituting for the regulations referred to therein any regulations (whether or not prescribed by the Secretary) which the Secretary determines are comparable to the regulations referred to in such clause with respect to newly listed chemicals.")
rule OzoneAdditionalAllowanceCountsNewlyListed(p: Person, y: Integer) strict {
    when ozone_tax_on_additional_production_allowance(p, y, NewlyListedChemical, _)
        and secretary_determined_comparable_regulations_for_newly_listed_chemicals(NewlyListedChemical);
    then ozone_additional_allowance_counts(p, y, NewlyListedChemical);
}
pub relation ozone_export_benefit_limit_terms(p: Person, calendar_year: Integer, class: OzoneChemicalClass, from_max_quantity: Money, from_allowance: Money, from_imports: Money) kind institutional {
    label en official "section 4682(d)(3)(B)(i): the three terms of the limit: the export percentage of the tax on the maximum permitted quantity, the tax on the additional production allowance, and the tax imposed on imports";
}
pub relation ozone_export_benefit_limit(p: Person, calendar_year: Integer, class: OzoneChemicalClass, limit: Money) kind institutional {
    label en official "section 4682(d)(3)(B)(i): the limit on the aggregate tax benefit: the sum of the three terms";
}
pub relation ozone_export_benefit_allowed(p: Person, calendar_year: Integer, class: OzoneChemicalClass, allowed: Money) kind institutional {
    label en official "section 4682(d)(3): the export tax benefit allowed: the benefit claimed, but not more than the limit";
}
// Term (I): base-year export percentage x tax on the maximum permitted quantity, one rounding (Money forms).
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(I) the amount equal to the 1986 export percentage of the aggregate tax which would (but for this subsection and subsection (g)) be imposed by this subchapter with respect to the maximum quantity of ozone-depleting chemicals permitted to be manufactured or produced by such person during such calendar year under regulations prescribed by the Environmental Protection Agency (other than chemicals with respect to which subclause (II) applies),")
rule OzoneExportBenefitLimitTermsWithAllowance(p: Person, y: Integer, c: OzoneChemicalClass, exported: Decimal, produced: Decimal, maxtax: Money, allowance: Money, imports: Money) strict {
    when ozone_base_year_exported_adjusted_pounds(p, c, exported)
        and ozone_base_year_produced_adjusted_pounds(p, c, produced)
        and produced > 0.0
        and ozone_tax_on_max_epa_permitted_quantity(p, y, c, maxtax)
        and ozone_additional_allowance_counts(p, y, c)
        and ozone_tax_on_additional_production_allowance(p, y, c, allowance)
        and ozone_tax_imposed_on_imports(p, y, c, imports);
    then ozone_export_benefit_limit_terms(p, y, c, div_round(maxtax * exported, produced, 2, "HALF_UP"), allowance, imports);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(III) the aggregate tax which was imposed by this subchapter with respect to ozone-depleting chemicals imported by such person during the calendar year.")
rule OzoneExportBenefitLimitTermsWithoutAllowance(p: Person, y: Integer, c: OzoneChemicalClass, exported: Decimal, produced: Decimal, maxtax: Money, imports: Money) strict {
    when ozone_base_year_exported_adjusted_pounds(p, c, exported)
        and ozone_base_year_produced_adjusted_pounds(p, c, produced)
        and produced > 0.0
        and ozone_tax_on_max_epa_permitted_quantity(p, y, c, maxtax)
        and not_known(ozone_additional_allowance_counts(p, y, c))
        and ozone_tax_imposed_on_imports(p, y, c, imports);
    then ozone_export_benefit_limit_terms(p, y, c, div_round(maxtax * exported, produced, 2, "HALF_UP"), 0.00 USD, imports);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "The aggregate tax benefit allowable under subparagraph (A) with respect to ozone-depleting chemicals manufactured, produced, or imported by any person during a calendar year shall not exceed the sum of—")
rule OzoneExportBenefitLimit(p: Person, y: Integer, c: OzoneChemicalClass, a: Money, b: Money, d: Money) strict {
    when ozone_export_benefit_limit_terms(p, y, c, a, b, d);
    then ozone_export_benefit_limit(p, y, c, a + b + d);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(C) Separate application of limit for newly listed chemicals")
rule OzoneExportBenefitAllowed(p: Person, y: Integer, c: OzoneChemicalClass, claimed: Money, limit: Money) strict {
    when ozone_export_benefit_claimed(p, y, c, claimed) and ozone_export_benefit_limit(p, y, c, limit);
    then ozone_export_benefit_allowed(p, y, c, min(claimed, limit));
}

// =====================================================================
// Section 4501(d): special rules for acquisitions of stock of certain foreign corporations
// =====================================================================

pub relation foreign_corporation_4501(p: Person) kind empirical {
    label en official "the person is a foreign corporation (section 7701(a)(5), EXTERNAL_DEPENDENCY carried as a fact)";
}
pub relation foreign_partnership_4501(p: Person) kind empirical {
    label en official "the person is a foreign partnership (section 7701(a)(5), EXTERNAL_DEPENDENCY carried as a fact)";
}
pub relation foreign_partnership_has_domestic_entity_as_direct_or_indirect_partner(p: Person) kind empirical {
    label en official "section 4501(d)(1): the foreign partnership has a domestic entity as a direct or indirect partner";
}
pub relation ownership_by_vote_percent(owner: Person, owned: Person, percent: Decimal) kind empirical {
    label en official "section 4501(c)(2)(B)(i): the percentage of the stock of the owned corporation, by vote, owned directly or indirectly by the owner (the indirect computation is a case input)";
}
pub relation ownership_by_value_percent(owner: Person, owned: Person, percent: Decimal) kind empirical {
    label en official "section 4501(c)(2)(B)(i): the percentage of the stock of the owned corporation, by value, owned directly or indirectly by the owner";
}
pub relation partnership_capital_interest_held_percent(holder: Person, partnership: Person, percent: Decimal) kind empirical {
    label en official "section 4501(c)(2)(B)(ii): the percentage of the capital interests of the partnership held directly or indirectly by the holder";
}
pub relation partnership_profits_interest_held_percent(holder: Person, partnership: Person, percent: Decimal) kind empirical {
    label en official "section 4501(c)(2)(B)(ii): the percentage of the profits interests of the partnership held directly or indirectly by the holder";
}
pub relation specified_affiliate_of(affiliate: Person, corporation: Person) kind institutional {
    label en official "section 4501(c)(2)(B): with respect to the corporation, a corporation more than 50 percent of the stock of which (by vote or by value) it owns directly or indirectly, or a partnership more than 50 percent of the capital or profits interests of which it holds directly or indirectly";
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(i) any corporation more than 50 percent of the stock of which is owned (by vote or by value), directly or indirectly, by such corporation, and")
rule SpecifiedAffiliateCorporationByVote(a: Person, c: Person, pct: Decimal) strict {
    when ownership_by_vote_percent(c, a, pct) and pct > 0.50;
    then specified_affiliate_of(a, c);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(i) any corporation more than 50 percent of the stock of which is owned (by vote or by value), directly or indirectly, by such corporation, and")
rule SpecifiedAffiliateCorporationByValue(a: Person, c: Person, pct: Decimal) strict {
    when ownership_by_value_percent(c, a, pct) and pct > 0.50;
    then specified_affiliate_of(a, c);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(ii) any partnership more than 50 percent of the capital interests or profits interests of which is held, directly or indirectly, by such corporation.")
rule SpecifiedAffiliatePartnershipByCapital(a: Person, c: Person, pct: Decimal) strict {
    when partnership_capital_interest_held_percent(c, a, pct) and pct > 0.50;
    then specified_affiliate_of(a, c);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(ii) any partnership more than 50 percent of the capital interests or profits interests of which is held, directly or indirectly, by such corporation.")
rule SpecifiedAffiliatePartnershipByProfits(a: Person, c: Person, pct: Decimal) strict {
    when partnership_profits_interest_held_percent(c, a, pct) and pct > 0.50;
    then specified_affiliate_of(a, c);
}
pub relation applicable_foreign_corporation(p: Person) kind institutional {
    label en official "section 4501(d)(3)(A): any foreign corporation the stock of which is traded on an established securities market (within the meaning of section 7704(b)(1))";
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "The term \"applicable foreign corporation\" means any foreign corporation the stock of which is traded on an established securities market (within the meaning of section 7704(b)(1)).")
rule ApplicableForeignCorporation(p: Person) strict {
    when foreign_corporation_4501(p) and corporation_stock_traded_on_established_securities_market(p);
    then applicable_foreign_corporation(p);
}
pub relation qualifying_specified_affiliate_of(affiliate: Person, corporation: Person) kind institutional {
    label en official "section 4501(d)(1): a specified affiliate other than a foreign corporation or a foreign partnership (unless the partnership has a domestic entity as a direct or indirect partner)";
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "by a specified affiliate of such corporation (other than a foreign corporation or a foreign partnership (unless such partnership has a domestic entity as a direct or indirect partner))")
rule QualifyingSpecifiedAffiliateDomestic(a: Person, c: Person) strict {
    when specified_affiliate_of(a, c) and not_known(foreign_corporation_4501(a)) and not_known(foreign_partnership_4501(a));
    then qualifying_specified_affiliate_of(a, c);
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "(unless such partnership has a domestic entity as a direct or indirect partner)")
rule QualifyingSpecifiedAffiliateForeignPartnershipWithDomesticPartner(a: Person, c: Person) strict {
    when specified_affiliate_of(a, c)
        and not_known(foreign_corporation_4501(a))
        and foreign_partnership_4501(a)
        and foreign_partnership_has_domestic_entity_as_direct_or_indirect_partner(a);
    then qualifying_specified_affiliate_of(a, c);
}
pub relation stock_acquisition_by_specified_affiliate(e: StockRepurchaseEvent, affiliate: Person, target: Person, seller: Person) kind empirical {
    label en official "section 4501(d)(1), (2): the acquisition of stock of the target corporation by the specified affiliate from the seller";
}
pub relation seller_is_target_or_its_specified_affiliate(e: StockRepurchaseEvent) kind empirical {
    label en official "section 4501(d)(1): the seller is the target corporation or a specified affiliate of it";
}
pub relation surrogate_foreign_corporation_with_2021_substitution(p: Person) kind empirical {
    label en official "section 4501(d)(3)(B): the corporation is a surrogate foreign corporation as determined under section 7874(a)(2)(B) by substituting September 20, 2021 for March 4, 2003 (EXTERNAL_DEPENDENCY on section 7874, carried as a fact)";
}
pub relation taxable_year_includes_portion_of_applicable_period_7874d1(p: Person, year_ends_on: Date) kind empirical {
    label en official "section 4501(d)(3)(B): the taxable year includes any portion of the applicable period with respect to the corporation under section 7874(d)(1)";
}
pub relation covered_surrogate_foreign_corporation(p: Person, year_ends_on: Date) kind institutional {
    label en official "section 4501(d)(3)(B): a surrogate foreign corporation the stock of which is traded on an established securities market, only for taxable years including any portion of the applicable period";
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "the stock of which is traded on an established securities market (within the meaning of section 7704(b)(1)), but only with respect to taxable years which include any portion of the applicable period with respect to such corporation under section 7874(d)(1).")
rule CoveredSurrogateForeignCorporation(p: Person, ends: Date) strict {
    when surrogate_foreign_corporation_with_2021_substitution(p)
        and corporation_stock_traded_on_established_securities_market(p)
        and taxable_year_includes_portion_of_applicable_period_7874d1(p, ends);
    then covered_surrogate_foreign_corporation(p, ends);
}
pub relation expatriated_entity_of(surrogate: Person, entity_person: Person) kind empirical {
    label en official "section 4501(d)(3)(C): the expatriated entity with respect to the surrogate foreign corporation (the meaning given by section 7874(a)(2)(A), carried as a fact)";
}
pub relation repurchase_of_covered_surrogate_stock_by_itself(e: StockRepurchaseEvent, surrogate: Person) kind empirical {
    label en official "section 4501(d)(2): a repurchase of stock of a covered surrogate foreign corporation by that corporation";
}
pub relation special_rule_covered_corporation(e: StockRepurchaseEvent, corporation: Person) kind institutional {
    label en official "section 4501(d)(1)(A), (2)(A): the person is treated as a covered corporation with respect to this acquisition or repurchase (the specified affiliate, or the expatriated entity), which is treated as its own repurchase of stock of a covered corporation ((d)(1)(B), (2)(B))";
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "(A) such specified affiliate shall be treated as a covered corporation with respect to such acquisition,")
rule SpecifiedAffiliateOfApplicableForeignCorporationIsCovered(e: StockRepurchaseEvent, aff: Person, target: Person, seller: Person) strict {
    when stock_acquisition_by_specified_affiliate(e, aff, target, seller)
        and applicable_foreign_corporation(target)
        and qualifying_specified_affiliate_of(aff, target)
        and not_known(seller_is_target_or_its_specified_affiliate(e));
    then special_rule_covered_corporation(e, aff);
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "(A) the expatriated entity with respect to such covered surrogate foreign corporation shall be treated as a covered corporation with respect to such repurchase or acquisition,")
rule ExpatriatedEntityOfCoveredSurrogateIsCoveredOnAffiliateAcquisition(e: StockRepurchaseEvent, aff: Person, target: Person, seller: Person, ee: Person, ends: Date) strict {
    when stock_acquisition_by_specified_affiliate(e, aff, target, seller)
        and specified_affiliate_of(aff, target)
        and covered_surrogate_foreign_corporation(target, ends)
        and expatriated_entity_of(target, ee);
    then special_rule_covered_corporation(e, ee);
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "In the case of a repurchase of stock of a covered surrogate foreign corporation by such covered surrogate foreign corporation, or an acquisition of stock of a covered surrogate foreign corporation by a specified affiliate of such corporation, for purposes of this section—")
rule ExpatriatedEntityOfCoveredSurrogateIsCoveredOnOwnRepurchase(e: StockRepurchaseEvent, sur: Person, ee: Person, ends: Date) strict {
    when repurchase_of_covered_surrogate_stock_by_itself(e, sur)
        and covered_surrogate_foreign_corporation(sur, ends)
        and expatriated_entity_of(sur, ee);
    then special_rule_covered_corporation(e, ee);
}
pub relation stock_issued_by_special_corporation_to_its_own_employees_fmv(e: StockRepurchaseEvent, fmv: Money) kind empirical {
    label en official "section 4501(d)(1)(C), (2)(C): the fair market value of stock issued or provided by the specified affiliate (or the expatriated entity) to its own employees during the taxable year";
}
pub relation issuance_adjustment_fmv(e: StockRepurchaseEvent, fmv: Money) kind institutional {
    label en official "section 4501(c)(3), (d)(1)(C), (2)(C): the fair market value of stock issued that reduces the repurchase base: all stock issued by the covered corporation, or, under the special rules, only stock issued to the affiliate's (expatriated entity's) own employees";
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be reduced by the fair market value of any stock issued by the covered corporation during the taxable year")
rule IssuanceAdjustmentGeneral(e: StockRepurchaseEvent, iss: Money, corp: Person) strict {
    when stock_repurchase_year(e, corp, _, _, iss) and not_known(special_rule_covered_corporation(e, corp));
    then issuance_adjustment_fmv(e, iss);
}
@source(IRC_S4501_D, relation = formalizes, coverage = exact, quote = "(C) the adjustment under subsection (c)(3) shall be determined only with respect to stock issued or provided by such specified affiliate to employees of the specified affiliate.")
rule IssuanceAdjustmentSpecialRuleOwnEmployeesOnly(e: StockRepurchaseEvent, corp: Person, iss: Money) strict {
    when stock_repurchase_year(e, corp, _, _, _) and special_rule_covered_corporation(e, corp) and stock_issued_by_special_corporation_to_its_own_employees_fmv(e, iss);
    then issuance_adjustment_fmv(e, iss);
}

// =====================================================================
// Section 4612(d): the oil spill credit ledger; an affiliated group is one taxpayer
// =====================================================================

pub enum OilSpillPriorFund {
    DeepwaterPortLiabilityTrustFund;
    OffshoreOilPollutionCompensationFund;
    TransAlaskaPipelineLiabilityFundTransferred;
}
pub relation oil_spill_credit_taxpayer(e: CrudeOilEvent, taxpayer: Person, period_no: Integer) kind empirical {
    label en official "section 4612(d): the taxpayer (an affiliated group counts as one taxpayer, represented by one member) and the ordinal number of the period of this crude oil event";
}
pub relation oil_spill_group_member(member: Person, taxpayer: Person) kind empirical {
    label en official "section 4612(d) last sentence: the member would be a member of the same affiliated group (section 1504(a)) as the taxpayer if section 1504(a)(2) were applied with 100 percent for 80 percent (the taxpayer is a member of its own group)";
}
pub relation oil_spill_prepaid_fund_payment(member: Person, fund: OilSpillPriorFund, paid_on: Date, amount: Money) kind empirical {
    label en official "section 4612(d)(1)(A): an amount paid by the member into the Deepwater Port Liability Trust Fund or the Offshore Oil Pollution Compensation Fund (or into the Trans-Alaska Pipeline Liability Fund, to the extent transferred to the Oil Spill Liability Trust Fund) on the date";
}
pub relation oil_spill_prepaid_fund_interest_accrued_before_1987(member: Person, amount: Money) kind empirical {
    label en official "section 4612(d)(1)(B): the interest accrued on such amounts before January 1, 1987";
}
pub relation oil_spill_credit_taken_into_account_in_period(taxpayer: Person, period_no: Integer, amount: Money) kind empirical {
    label en official "section 4612(d)(2): the amount of the payments taken into account under this subsection for the given period";
}
pub relation oil_spill_credit_ledger_amounts(e: CrudeOilEvent, paid_with_interest: Money, taken_into_account_in_prior_periods: Money) kind institutional {
    label en official "section 4612(d)(1), (2): the pre-1987 payments with accrued interest of the taxpayer's affiliated group, and the amount taken into account for all prior periods (a sum over the recorded earlier periods)";
}
@source(IRC_S4612_D, relation = formalizes, coverage = exact, quote = "(2) the amount of such payments taken into account under this subsection for all prior periods.")
rule OilSpillCreditLedgerAmounts(e: CrudeOilEvent, tp: Person, n: Integer) strict {
    when oil_spill_credit_taxpayer(e, tp, n);
    then oil_spill_credit_ledger_amounts(e,
        sum(collect all a: Money, m: Person, f: OilSpillPriorFund, d: Date where oil_spill_group_member(m, tp) and oil_spill_prepaid_fund_payment(m, f, d, a) and d < @1987-01-01, empty: 0.00 USD)
        + sum(collect all i: Money, m2: Person where oil_spill_group_member(m2, tp) and oil_spill_prepaid_fund_interest_accrued_before_1987(m2, i), empty: 0.00 USD),
        sum(collect all u: Money, k: Integer where oil_spill_credit_taken_into_account_in_period(tp, k, u) and k < n, empty: 0.00 USD));
}
@source(IRC_S4612_D, relation = formalizes, coverage = exact, quote = "The preceding sentence shall also apply to amounts paid by the taxpayer into the Trans-Alaska Pipeline Liability Fund to the extent of amounts transferred from such Fund into the Oil Spill Liability Trust Fund.")
rule OilSpillPrepaymentCreditFromLedgerAvailable(e: CrudeOilEvent, paid: Money, used: Money, portion: Money) strict {
    when oil_spill_credit_ledger_amounts(e, paid, used) and oil_spill_rate_portion_of_tax(e, portion) and paid > used and paid - used <= portion;
    then oil_spill_prepayment_credit(e, paid - used);
}
@source(IRC_S4612_D, relation = formalizes, coverage = exact, quote = "For purposes of this subsection, all taxpayers which would be members of the same affiliated group (as defined in section 1504(a)) if section 1504(a)(2) were applied by substituting \"100 percent\" for \"80 percent\" shall be treated as 1 taxpayer.")
rule OilSpillPrepaymentCreditFromLedgerLimitedToPortion(e: CrudeOilEvent, paid: Money, used: Money, portion: Money) strict {
    when oil_spill_credit_ledger_amounts(e, paid, used) and oil_spill_rate_portion_of_tax(e, portion) and paid > used and paid - used > portion;
    then oil_spill_prepayment_credit(e, portion);
}

// =====================================================================
// Section 4611(c)(3), (f)(2): the 2026 published total against the termination of the Oil Spill rate
// =====================================================================

// Rev. Proc. 2025-32 section 4.45 gives a total of $0.27 a barrel for 2026, while section 4611(f)(2) says the Oil Spill
// Liability Trust Fund financing rate shall not apply after December 31, 2025, so 2026 would bear only the indexed
// Hazardous Substance Superfund rate. The package computes the published total (module 08) and records the tension
// as data: the flag below is true for every crude oil event after 2025, so a reader sees that the published figure
// may include a terminated component. No statutory-formula figure is invented: the cost-of-living factor is not pinned.
pub relation oil_spill_rate_terminated_for_event(e: CrudeOilEvent) kind institutional {
    label en official "section 4611(f)(2): the Oil Spill Liability Trust Fund financing rate shall not apply after December 31, 2025, so it does not apply to this event";
}
@source(IRC_S4611_F, relation = formalizes, coverage = exact, quote = "The Oil Spill Liability Trust Fund financing rate shall not apply after December 31, 2025.")
rule OilSpillRateTerminatedAfter2025(e: CrudeOilEvent, on: Date) strict {
    when crude_oil_event(e, _, _, on, _) and on > @2025-12-31;
    then oil_spill_rate_terminated_for_event(e);
}
pub relation published_indexed_total_may_include_terminated_oil_spill_component(e: CrudeOilEvent) kind institutional {
    label en official "INTERPRETATION flag: the published indexed total rate used for this event (Rev. Proc. 2025-32 section 4.45, $0.27 for 2026) cannot be reconciled with section 4611(f)(2), which removes the Oil Spill component after 2025";
}
@source(IRC_S4611_C, relation = formalizes, coverage = partial, quote = "In the case of a year beginning after 2023, the amount in paragraph (2)(A) shall be increased by an amount equal to—")
rule PublishedIndexedTotalMayIncludeTerminatedOilSpillComponent(e: CrudeOilEvent, on: Date) strict {
    when crude_oil_event(e, _, _, on, _)
        and oil_spill_rate_terminated_for_event(e)
        and not_known(crude_oil_used_on_premises_of_production(e))
        and on >= @2026-01-01 and on < @2027-01-01;
    then published_indexed_total_may_include_terminated_oil_spill_component(e);
}

// =====================================================================
// Section 4501(c)(1)(B): transactions the Secretary determines to be economically similar to a redemption
// =====================================================================

external judgment relation secretary_determined_economically_similar_to_redemption(e: StockRepurchaseEvent, fmv: Money) {
    authority Secretary;
    label en official "section 4501(c)(1)(B): a transaction determined by the Secretary to be economically similar to a redemption within the meaning of section 317(b), with its fair market value (DECISION-0194)";
}
pub relation economically_similar_transaction_determined(e: StockRepurchaseEvent) kind institutional {
    label en official "marker: the Secretary determined an economically similar transaction for this event";
}
rule EconomicallySimilarTransactionDeterminedMarker(e: StockRepurchaseEvent, fmv: Money) strict {
    when secretary_determined_economically_similar_to_redemption(e, fmv);
    then economically_similar_transaction_determined(e);
}
pub relation repurchases_treated_as_repurchases_4501c(e: StockRepurchaseEvent, total: Money) kind institutional {
    label en official "section 4501(c)(1), (2): the repurchases of the corporation, the acquisitions by its specified affiliates treated as repurchases, and the transactions the Secretary determined economically similar";
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(B) any transaction determined by the Secretary to be economically similar to a transaction described in subparagraph (A).")
rule RepurchasesTreatedWithEconomicallySimilar(e: StockRepurchaseEvent, t: Money, fmv: Money) strict {
    when repurchases_including_specified_affiliate_acquisitions(e, t) and secretary_determined_economically_similar_to_redemption(e, fmv);
    then repurchases_treated_as_repurchases_4501c(e, t + fmv);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "(A) a redemption within the meaning of section 317(b) with regard to the stock of a covered corporation, and")
rule RepurchasesTreatedWithoutEconomicallySimilar(e: StockRepurchaseEvent, t: Money) strict {
    when repurchases_including_specified_affiliate_acquisitions(e, t) and not_known(economically_similar_transaction_determined(e));
    then repurchases_treated_as_repurchases_4501c(e, t);
}

// =====================================================================
// Section 4672(a)(2), last sentence: the Secretary decides a listing request within 180 days
// =====================================================================

pub relation listing_determination_requested_on(substance: Text, requested: Date) kind empirical {
    label en official "section 4672(a)(2): an importer or exporter requests that the Secretary determine whether the substance be listed as a taxable substance or removed from the listing, on the given date";
}
pub relation secretary_made_listing_determination_for(substance: Text) kind empirical {
    label en official "section 4672(a)(2): the Secretary made the requested determination";
}
@source(IRC_S4672_A, relation = formalizes, coverage = exact, quote = "the Secretary shall make such determination within 180 days after the date the request was filed.")
rule SecretaryListingDeterminationDutyRule(s: Text, d: Date) strict {
    when listing_determination_requested_on(s, d);
    then duty SecretaryDeterminesListingWithin180Days {
        bearer Secretary;
        goal achievement {
            condition secretary_made_listing_determination_for(s);
            window [d, add_calendar_period(d, 180 calendar_day)];
        }
    };
}

// =====================================================================
// Section 4082(b): the definition of a nontaxable use
// =====================================================================

// The determination that a fuel is destined for a nontaxable use stays the Secretary's (external judgment
// `secretary_determines_destined_for_nontaxable_use`, module 09); this is the definition that guides it.
pub relation fuel_use_exempt_from_4041a1_tax_not_by_prior_imposition(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b)(1): the use is exempt from the tax imposed by section 4041(a)(1) other than by reason of a prior imposition of tax";
}
pub relation fuel_use_in_a_train(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b)(2): the use is a use in a train";
}
pub relation fuel_use_described_in_4041a1C_iii_II(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b)(3): the use is described in section 4041(a)(1)(C)(iii)(II) (school bus and intracity transportation)";
}
pub relation fuel_use_is_kerosene_in_an_aircraft(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b) last sentence: the use is the use of kerosene in an aircraft";
}
pub relation fuel_use_described_in_6421e2C(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b) last sentence: the use is described in section 6421(e)(2)(C)";
}
pub relation nontaxable_use_4082b(e: TaxableFuelEvent) kind institutional {
    label en official "section 4082(b): the use is a nontaxable use";
}
@source(IRC_S4082_B, relation = formalizes, coverage = exact, quote = "(1) any use which is exempt from the tax imposed by section 4041(a)(1) other than by reason of a prior imposition of tax,")
rule NontaxableUseExemptFrom4041a1(e: TaxableFuelEvent) strict {
    when fuel_use_exempt_from_4041a1_tax_not_by_prior_imposition(e)
        and not_known(fuel_use_is_kerosene_in_an_aircraft(e))
        and not_known(fuel_use_described_in_6421e2C(e));
    then nontaxable_use_4082b(e);
}
@source(IRC_S4082_B, relation = formalizes, coverage = exact, quote = "(2) any use in a train, and")
rule NontaxableUseInTrain(e: TaxableFuelEvent) strict {
    when fuel_use_in_a_train(e)
        and not_known(fuel_use_is_kerosene_in_an_aircraft(e))
        and not_known(fuel_use_described_in_6421e2C(e));
    then nontaxable_use_4082b(e);
}
@source(IRC_S4082_B, relation = formalizes, coverage = exact, quote = "(3) any use described in section 4041(a)(1)(C)(iii)(II).")
rule NontaxableUseSchoolBusOrIntracity(e: TaxableFuelEvent) strict {
    when fuel_use_described_in_4041a1C_iii_II(e)
        and not_known(fuel_use_is_kerosene_in_an_aircraft(e))
        and not_known(fuel_use_described_in_6421e2C(e));
    then nontaxable_use_4082b(e);
}
