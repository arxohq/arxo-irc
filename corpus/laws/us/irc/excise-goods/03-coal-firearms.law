// Chapter 32: sections 4121 (coal) and 4181 (firearms, shells, and
// cartridges). Priority list, IRC-13 stage 1.

// =====================================================================
// Section 4121 — tax on coal
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4121_A,
    IRC_S4121_B,
    IRC_S4121_C,
    IRC_S4181,
    Person,
    excise_tax_due,
    liable_for_excise,
    tax_free_sale,
};

pub enum CoalMineKind {
    UndergroundMine;
    SurfaceMine;
}

pub entity CoalSaleEvent : ExciseEvent;

pub relation coal_sale(e: CoalSaleEvent, mine: CoalMineKind, tons: Decimal, price: Money, producer: Person) kind empirical {
    label en unofficial "section 4121(a)(1): coal from a mine located in the United States, sold by the producer, with the price at which that ton of coal is sold";
}
pub relation coal_is_lignite(e: CoalSaleEvent) kind empirical {
    label en unofficial "section 4121(c): the coal is lignite, exempt from the tax entirely";
}

pub relation coal_rate_per_ton(e: CoalSaleEvent, rate: Money) kind institutional {
    label en official "section 4121(b)(1)-(2): the per-ton rate before the section 4121(a)(2) percentage-of-price cap";
}
@source(IRC_S4121_B, relation = formalizes, coverage = exact, quote = "the rate of tax on coal from underground mines shall be $1.10")
rule UndergroundRate(e: CoalSaleEvent) strict {
    when coal_sale(e, UndergroundMine, _, _, _);
    then coal_rate_per_ton(e, S4121UndergroundRatePerTon);
}
@source(IRC_S4121_B, relation = formalizes, coverage = exact, quote = "the rate of tax on coal from surface mines shall be $.55")
rule SurfaceRate(e: CoalSaleEvent) strict {
    when coal_sale(e, SurfaceMine, _, _, _);
    then coal_rate_per_ton(e, S4121SurfaceRatePerTon);
}

// section 4121(a)(2): "shall not exceed the applicable percentage ... of the
// price" — the lesser-of computation PLAN §5 asks for, with the intermediate
// per-ton and percentage-of-price values both exposed.
pub relation coal_per_ton_amount(e: CoalSaleEvent, amount: Money) kind institutional {
    label en official "section 4121(a)(1)/(b): rate per ton times tons sold, before the section 4121(a)(2) cap";
}
pub relation coal_percentage_cap_amount(e: CoalSaleEvent, amount: Money) kind institutional {
    label en official "section 4121(a)(2)/(b)(3): 4.4 percent of the price at which the ton of coal is sold";
}

@source(IRC_S4121_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on coal from mines located in the United States sold by the producer, a tax equal to the rate per ton determined under subsection (b).")
rule CoalPerTonAmount(e: CoalSaleEvent, tons: Decimal, rate: Money) strict {
    when coal_sale(e, _, tons, _, _) and coal_rate_per_ton(e, rate);
    then coal_per_ton_amount(e, round(rate * tons, 2, "HALF_UP"));
}

@source(IRC_S4121_A, relation = formalizes, coverage = exact, quote = "The amount of the tax imposed by paragraph (1) with respect to a ton of coal shall not exceed the applicable percentage (determined under subsection (b)) of the price at which such ton of coal is sold by the producer.")
rule CoalPercentageCapAmount(e: CoalSaleEvent, tons: Decimal, price: Money) strict {
    when coal_sale(e, _, tons, price, _);
    then coal_percentage_cap_amount(e, round(price * S4121ApplicablePercentage * tons, 2, "HALF_UP"));
}

@source(IRC_S4121_A, relation = formalizes, coverage = exact, quote = "The amount of the tax imposed by paragraph (1) with respect to a ton of coal shall not exceed the applicable percentage (determined under subsection (b)) of the price at which such ton of coal is sold by the producer.")
rule CoalTaxLesserOf(e: CoalSaleEvent, perTon: Money, cap: Money) strict {
    when coal_per_ton_amount(e, perTon) and coal_percentage_cap_amount(e, cap) and not_known(coal_is_lignite(e));
    then excise_tax_due(e, min(perTon, cap));
}

@source(IRC_S4121_C, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (a) shall not apply in the case of lignite.")
rule CoalLigniteExempt(e: CoalSaleEvent) strict {
    when coal_sale(e, _, _, _, _) and coal_is_lignite(e);
    then tax_free_sale(e);
}

@source(IRC_S4121_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on coal from mines located in the United States sold by the producer, a tax equal to the rate per ton determined under subsection (b).")
rule CoalLiability(e: CoalSaleEvent, producer: Person, amount: Money) defeasible {
    when coal_sale(e, _, _, _, producer) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(producer, e, amount);
}

// =====================================================================
// Section 4181 — firearms, shells, and cartridges
// =====================================================================

pub enum FirearmArticleKind {
    Pistol;
    Revolver;
    OtherFirearm;
    ShellOrCartridge;
}

pub entity FirearmSaleEvent : ExciseEvent;

pub relation firearm_sale(e: FirearmSaleEvent, article: FirearmArticleKind, price: Money, seller: Person) kind empirical {
    label en unofficial "section 4181: the sale by the manufacturer, producer, or importer of a pistol, revolver, other firearm, or shell/cartridge";
}

@source(IRC_S4181, relation = formalizes, coverage = exact, quote = "Articles taxable at 10 percent—\nPistols.\nRevolvers.")
rule PistolRevolverTax(e: FirearmSaleEvent, price: Money) strict {
    when (firearm_sale(e, Pistol, price, _) or firearm_sale(e, Revolver, price, _));
    then excise_tax_due(e, round(price * S4181PistolRevolverRatePercent, 2, "HALF_UP"));
}

@source(IRC_S4181, relation = formalizes, coverage = exact, quote = "Articles taxable at 11 percent—\nFirearms (other than pistols and revolvers).\nShells, and cartridges.")
rule OtherFirearmTax(e: FirearmSaleEvent, price: Money) strict {
    when (firearm_sale(e, OtherFirearm, price, _) or firearm_sale(e, ShellOrCartridge, price, _));
    then excise_tax_due(e, round(price * S4181OtherFirearmsRatePercent, 2, "HALF_UP"));
}

@source(IRC_S4181, relation = formalizes, coverage = exact, quote = "There is hereby imposed upon the sale by the manufacturer, producer, or importer of the following articles a tax equivalent to the specified percent of the price for which so sold")
rule FirearmLiability(e: FirearmSaleEvent, seller: Person, amount: Money) defeasible {
    when firearm_sale(e, _, _, seller) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(seller, e, amount);
}
