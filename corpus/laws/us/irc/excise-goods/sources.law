// 26 U.S.C. 4272(a) — Definition of taxable transportation, etc.
fragment IRC_S4272_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4272/a";
    text en official """(a) In general
For purposes of this part, except as provided in subsection (b), the term "taxable transportation" means transportation by air which begins and ends in the United States.""";
    content_hash "sha256:ac18b061fc160099020d5c1f482d72f0ddbb76d1739cfd4a59ef190baa79a5c6";
}

// 26 U.S.C. 4272(b) — Definition of taxable transportation, etc.
fragment IRC_S4272_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4272/b";
    text en official """(b) Exceptions
For purposes of this part, the term "taxable transportation" does not include—
(1) that portion of any transportation which meets the requirements of paragraphs (1), (2), (3), and (4) of section 4262(b), or
(2) under regulations prescribed by the Secretary, transportation of property in the course of exportation (including shipment to a possession of the United States) by continuous movement, and in due course so exported.""";
    content_hash "sha256:0072c131f95cfcdc839e5b1a8c2ecfbbb78be49d3d1439735aa92856f6c7f8a5";
}

// 26 U.S.C. 4272(c) — Definition of taxable transportation, etc.
fragment IRC_S4272_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4272/c";
    text en official """(c) Excess baggage of passengers
For purposes of this part, the term "property" does not include excess baggage accompanying a passenger traveling on an aircraft operated on an established line.""";
    content_hash "sha256:907a5cb01ef3d4dccc028bffb10192a80bc00226fb33045e09e49b57b6b19a79";
}

// 26 U.S.C. 4272(d) — Definition of taxable transportation, etc.
fragment IRC_S4272_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/4272/d";
    text en official """(d) Transportation
For purposes of this part, the term "transportation" includes layover or waiting time and movement of the aircraft in deadhead service.""";
    content_hash "sha256:daad0c5df806547b6d5cdd6fd95288d4f20e392a639f0850f6cb6f3443b62472";
}

// structural heading: part D/33/C/III
fragment IRC_HEAD_PART_D_33_C_III in IRC_2024_EDITION {
    kind heading;
    locator "part/D/33/C/III";
    text en official """Part D/33/C/III""";
    content_hash "sha256:8e4e23a625721d4892fe3cf326b8744673b3c009e6578d8ad451968f740cd11d";
}

// 26 U.S.C. 4281(a) — Small aircraft on nonestablished lines
fragment IRC_S4281_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4281/a";
    text en official """(a) In general
The taxes imposed by sections 4261 and 4271 shall not apply to transportation by an aircraft having a maximum certificated takeoff weight of 6,000 pounds or less, except when such aircraft is operated on an established line or when such aircraft is a jet aircraft.""";
    content_hash "sha256:9bd24ed05685a76887935249d2a20fdea03fd2176bb28b09fb87c76b7c942284";
}

// 26 U.S.C. 4281(b) — Small aircraft on nonestablished lines
fragment IRC_S4281_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4281/b";
    text en official """(b) Maximum certificated takeoff weight
For purposes of this section, the term "maximum certificated takeoff weight" means the maximum such weight contained in the type certificate or airworthiness certificate.""";
    content_hash "sha256:a535a53284cca204e7e544e3bf4c21223feaf556bd701bfefc7999d244faccb8";
}

// 26 U.S.C. 4281(c) — Small aircraft on nonestablished lines
fragment IRC_S4281_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4281/c";
    text en official """(c) Sightseeing
For purposes of this section, an aircraft shall not be considered as operated on an established line at any time during which such aircraft is being operated on a flight the sole purpose of which is sightseeing.""";
    content_hash "sha256:546cc6f2222f326742198072453fabbbd5b6a988148add84e5cb871714480834";
}

// 26 U.S.C. 4281(d) — Small aircraft on nonestablished lines
fragment IRC_S4281_D in IRC_2024_EDITION {
    kind subsection;
    locator "section/4281/d";
    text en official """(d) Jet aircraft
For purposes of this section, the term "jet aircraft" shall not include any aircraft which is a rotorcraft or propeller aircraft.""";
    content_hash "sha256:ddb89abf2348462cc7563fcd62a09c8c0e50068d5e4421cf7ce030aad318d5e7";
}

// 26 U.S.C. §4281 — statutory note 5 (effectivedate-amendment-note)
