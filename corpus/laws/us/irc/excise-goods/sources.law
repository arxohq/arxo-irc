// 26 U.S.C. 4282(a) — Transportation by air for other members of affiliated group
fragment IRC_S4282_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4282/a";
    text en official """(a) General rule
Under regulations prescribed by the Secretary, if—
(1) one member of an affiliated group is the owner or lessee of an aircraft, and
(2) such aircraft is not available for hire by persons who are not members of such group,
no tax shall be imposed under section 4261 or 4271 upon any payment received by one member of the affiliated group from another member of such group for services furnished to such other member in connection with the use of such aircraft.""";
    content_hash "sha256:f7079ffef9d97ddb074ee7d9ad59acb664fd3135effcd8b5fae92afdf6afa882";
}

// 26 U.S.C. 4282(b) — Transportation by air for other members of affiliated group
fragment IRC_S4282_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4282/b";
    text en official """(b) Availability for hire
For purposes of subsection (a), the determination of whether an aircraft is available for hire by persons who are not members of an affiliated group shall be made on a flight-by-flight basis.""";
    content_hash "sha256:6723f9383acd115ef2d18a80c8e138e2dd680197c520c8f1a02a60020527c488";
}

// 26 U.S.C. 4282(c) — Transportation by air for other members of affiliated group
fragment IRC_S4282_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4282/c";
    text en official """(c) Affiliated group
For purposes of subsection (a), the term "affiliated group" has the meaning assigned to such term by section 1504(a), except that all corporations shall be treated as includible corporations (without any exclusion under section 1504(b)).""";
    content_hash "sha256:cf38dbe03d1f6a12ece0776c328e69e87f5a9079c9de3b458d88bf4348bb3af4";
}

// 26 U.S.C. §4282 — statutory note 5 (effectivedate-amendment-note)
