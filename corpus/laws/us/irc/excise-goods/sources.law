// 26 U.S.C. 4461(a) — Imposition of tax
fragment IRC_S4461_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4461/a";
    text en official """(a) General rule
There is hereby imposed a tax on any port use.""";
    content_hash "sha256:2cd95b92ebaa77bcba3a7c57c022f2b295085af8d54a6965dd577d76aa020c11";
}

// 26 U.S.C. 4461(b) — Imposition of tax
fragment IRC_S4461_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4461/b";
    text en official """(b) Amount of tax
The amount of the tax imposed by subsection (a) on any port use shall be an amount equal to 0.125 percent of the value of the commercial cargo involved.""";
    content_hash "sha256:ea93891c06fbe128fb94aac2fb95d5cfa143394aff83445ce2cdfefdd2cb261a";
}

// 26 U.S.C. 4461(c) — Imposition of tax
fragment IRC_S4461_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4461/c";
    text en official """(c) Liability and time of imposition of tax
(1) Liability
The tax imposed by subsection (a) shall be paid by—
(A) in the case of cargo entering the United States, the importer, or
(B) in any other case, the shipper.
(2) Time of imposition
Except as provided by regulations, the tax imposed by subsection (a) shall be imposed at the time of unloading.""";
    content_hash "sha256:a192682c2c232fdb12061de85645d25837ed75e12fab66a875a3d785e06a7eae";
}

