// 26 U.S.C. §4191 — statutory note 2 (effectivedate-repeal-note)
fragment IRC_S4191_NOTE_2 in IRC_2024_EDITION {
    kind note;
    locator "section/4191/note/2";
    text en official """Effective Date of Repeal
Repeal applicable to sales after Dec. 31, 2019, see section 501(d) of Pub. L. 116–94, set out as an Effective Date of 2019 Amendment note under section 4221 of this title.""";
    content_hash "sha256:10c8c12de3d3f1f5c840342737f2b3ba855ffad61137cbf2e1d947a16c09117c";
}

