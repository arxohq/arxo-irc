    content_hash "sha256:14a55e63c80e358225b3b8282e82ccc4cea7a7ad7fcfb5ab2ebea2bec2b9fed9";
}

// structural heading: part D/33/C/I
fragment IRC_HEAD_PART_D_33_C_I in IRC_2024_EDITION {
    kind heading;
    locator "part/D/33/C/I";
    text en official """Part D/33/C/I""";
    content_hash "sha256:a546bb973a1f45f51aad2d2c430b8b47c9c888f35290e841c963a8cd9f18b51e";
