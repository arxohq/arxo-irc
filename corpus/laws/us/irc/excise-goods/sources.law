// 26 U.S.C. 4131(a) — Imposition of tax
fragment IRC_S4131_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/4131/a";
    text en official """(a) General rule
There is hereby imposed a tax on any taxable vaccine sold by the manufacturer, producer, or importer thereof.""";
    content_hash "sha256:ae79abf80f1ff7fdabdeb7b5910d11cfb05d477f796917704f4ab49a9ccb1df7";
}

// 26 U.S.C. 4131(b) — Imposition of tax
fragment IRC_S4131_B in IRC_2024_EDITION {
    kind subsection;
    locator "section/4131/b";
    text en official """(b) Amount of tax
(1) In general
The amount of the tax imposed by subsection (a) shall be 75 cents per dose of any taxable vaccine.
(2) Combinations of vaccines
If any taxable vaccine is described in more than 1 subparagraph of section 4132(a)(1), the amount of the tax imposed by subsection (a) on such vaccine shall be the sum of the amounts for the vaccines which are so included.""";
    content_hash "sha256:fb409bdb5cd01890b9192b0b9c5bb70b067345838a583a0e296c499132bb7b10";
}

// 26 U.S.C. 4131(c) — Imposition of tax
fragment IRC_S4131_C in IRC_2024_EDITION {
    kind subsection;
    locator "section/4131/c";
    text en official """(c) Application of section
The tax imposed by this section shall apply—
(1) after December 31, 1987, and before January 1, 1993, and
(2) during periods after the date of the enactment of the Revenue Reconciliation Act of 1993.
[table T1]""";
    content_hash "sha256:8ddbe90fc93031b3e0cccbc4915f26ebe1c1a1660faa59b4e8a14a96f01c077c";
}

