    locator "section/4251#table/T1";
    text en official """ / The percentage is: | During 1983, 1984, 1985, 1986, or 1987 / 3 | During 1988 or thereafter / 0." """;
    content_hash "sha256:40cf8be89369436f998969088fdc0fd15d386aff43784462b10a5f20a84d30d3";
