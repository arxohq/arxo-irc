// Stage 2: chapter 34 (sections 4371-4377: foreign insurance tax and the
// patient-centered outcomes research fees) and chapter 37 (section 4501:
// tax on repurchases of corporate stock).
//
// The fee rate of sections 4375 and 4376 after fiscal year 2014 is set by an
// adjustment for projected national health expenditures that the Secretary
// publishes; no such publication is pinned in this package, so the parameter
// has values for the statutory fiscal years 2013 and 2014 only, later years are
// MISSING_PARAMETER_VALUE (TECH-GAPS.md). The dataset is read at the
// legal_time of the question: read the fee with the legal_time set to the last
// day of the policy or plan year.

// =====================================================================
// Sections 4371-4374 — tax on policies issued by foreign insurers
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4371,
    IRC_S4372_A,
    IRC_S4372_D,
    IRC_S4372_E,
    IRC_S4372_F,
    IRC_S4373,
    IRC_S4374,
    IRC_S4375_A,
    IRC_S4375_B,
    IRC_S4375_C,
    IRC_S4376_A,
    IRC_S4376_B,
    IRC_S4376_C,
    IRC_S4377_B,
    IRC_S4377_D,
    IRC_S4501_A,
    IRC_S4501_B,
    IRC_S4501_C,
    IRC_S4501_F,
    Organ,
    Person,
    Secretary,
    excise_tax_due,
    issuance_adjustment_fmv,
    liable_for_excise,
    repurchases_treated_as_repurchases_4501c,
    special_rule_covered_corporation,
    tax_free_sale,
};

pub enum ForeignInsurerKind {
    NonresidentAlienIndividual;
    ForeignPartnership;
    ForeignCorporation;
    ForeignGovernmentOrMunicipalTaxingBody;
    OtherInsurer;
}
pub enum ForeignPolicyKind {
    CasualtyInsuranceOrIndemnityBond;
    LifeSicknessAccidentInsuranceOrAnnuity;
    Reinsurance;
}
pub enum InsuredKind {
    DomesticCorporationOrPartnership;
    IndividualResidentOfUnitedStates;
    ForeignEntityOrNonresidentEngagedInUsTradeOrBusiness;
    OtherInsured;
}

pub entity ForeignPolicyEvent : ExciseEvent;

pub relation insurer_kind(p: Person, kind: ForeignInsurerKind) kind empirical {
    label en official "section 4372(a): the kind of insurer or reinsurer";
}
pub relation insurer_bound_by_indemnity_bond(p: Person) kind empirical {
    label en official "section 4372(a): the nonresident alien individual, foreign partnership, or foreign corporation becomes bound by an obligation of the nature of an indemnity bond (still a foreign insurer)";
}
pub relation foreign_insurer_or_reinsurer(p: Person) kind institutional {
    label en official "section 4372(a): an insurer or reinsurer who is a nonresident alien individual, a foreign partnership, or a foreign corporation (not a foreign government or a municipal or other corporation exercising the taxing power)";
}
pub relation foreign_policy(e: ForeignPolicyEvent, kind: ForeignPolicyKind, premium_dollars: Decimal, insurer: Person, on: Date) kind empirical {
    label en official "section 4371: a policy of insurance, indemnity bond, annuity contract or policy of reinsurance issued by a foreign insurer or reinsurer; the premium paid, in whole dollars and cents of United States currency";
}
pub relation policy_issued_to_or_for_or_in_name_of_insured(e: ForeignPolicyEvent, insured: Person, insured_kind: InsuredKind) kind empirical {
    label en official "section 4371(1), 4372(d): the policy is issued to or for, or in the name of, an insured, of the given kind";
}
pub relation hazards_wholly_or_partly_within_united_states(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4372(d)(1): the hazards, risks, losses, or liabilities are wholly or partly within the United States";
}
pub relation hazards_within_united_states(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4372(d)(2): the hazards, risks, losses, or liabilities are within the United States";
}
pub relation life_or_person_hazards_of_us_citizen_or_resident(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4372(e): the contract is with respect to the life or hazards to the person of a citizen or resident of the United States";
}
pub relation reinsurance_covers_taxable_contracts(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4372(f), 4371(3): the reinsurance covers hazards covered by contracts taxable under paragraph (1) or (2) of section 4371";
}
pub relation insured_within_4372d(e: ForeignPolicyEvent) kind institutional {
    label en official "section 4372(d): the policy insures an insured as defined";
}
pub relation foreign_policy_taxed_kind(e: ForeignPolicyEvent, kind: ForeignPolicyKind) kind institutional {
    label en official "section 4371: the policy falls in the taxable paragraph (1), (2) or (3) as defined by section 4372(b), (c), (e), (f)";
}
pub relation amount_effectively_connected_with_us_trade_or_business(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4373(1): the amount is effectively connected with the conduct of a trade or business within the United States";
}
pub relation treaty_exempts_amount_from_section_882a(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4373(1): the amount is exempt from the application of section 882(a) pursuant to a treaty obligation of the United States";
}
pub relation indemnity_bond_to_secure_us_payment(e: ForeignPolicyEvent) kind empirical {
    label en official "section 4373(2): an indemnity bond required to secure payment of a pension, allowance, allotment, relief, or insurance by the United States, or a duplicate or payment of a United States bond, note, certificate, warrant or check";
}

@source(IRC_S4372_A, relation = formalizes, coverage = exact, quote = "means an insurer or reinsurer who is a nonresident alien individual, or a foreign partnership, or a foreign corporation.")
rule ForeignInsurerNonresidentAlien(p: Person) strict {
    when insurer_kind(p, NonresidentAlienIndividual);
    then foreign_insurer_or_reinsurer(p);
}
@source(IRC_S4372_A, relation = formalizes, coverage = exact, quote = "means an insurer or reinsurer who is a nonresident alien individual, or a foreign partnership, or a foreign corporation.")
rule ForeignInsurerForeignPartnership(p: Person) strict {
    when insurer_kind(p, ForeignPartnership);
    then foreign_insurer_or_reinsurer(p);
}
@source(IRC_S4372_A, relation = formalizes, coverage = exact, quote = "means an insurer or reinsurer who is a nonresident alien individual, or a foreign partnership, or a foreign corporation.")
rule ForeignInsurerForeignCorporation(p: Person) strict {
    when insurer_kind(p, ForeignCorporation);
    then foreign_insurer_or_reinsurer(p);
}
@source(IRC_S4372_A, relation = formalizes, coverage = exact, quote = "The term does not include a foreign government, or municipal or other corporation exercising the taxing power.")
rule ForeignInsurerBoundByIndemnityBond(p: Person) strict {
    when insurer_bound_by_indemnity_bond(p) and not_known(insurer_kind(p, ForeignGovernmentOrMunicipalTaxingBody));
    then foreign_insurer_or_reinsurer(p);
}

@source(IRC_S4372_D, relation = formalizes, coverage = exact, quote = "(1) a domestic corporation or partnership, or an individual resident of the United States, against, or with respect to, hazards, risks, losses, or liabilities wholly or partly within the United States, or")
rule InsuredDomesticOrResident(e: ForeignPolicyEvent, i: Person, k: InsuredKind) strict {
    when policy_issued_to_or_for_or_in_name_of_insured(e, i, k)
        and (k == DomesticCorporationOrPartnership or k == IndividualResidentOfUnitedStates)
        and hazards_wholly_or_partly_within_united_states(e);
    then insured_within_4372d(e);
}
@source(IRC_S4372_D, relation = formalizes, coverage = exact, quote = "(2) a foreign corporation, foreign partnership, or nonresident individual, engaged in a trade or business within the United States, against, or with respect to, hazards, risks, losses, or liabilities within the United States.")
rule InsuredForeignEngagedInUsBusiness(e: ForeignPolicyEvent, i: Person) strict {
    when policy_issued_to_or_for_or_in_name_of_insured(e, i, ForeignEntityOrNonresidentEngagedInUsTradeOrBusiness) and hazards_within_united_states(e);
    then insured_within_4372d(e);
}

@source(IRC_S4371, relation = formalizes, coverage = exact, quote = "(1) Casualty insurance and indemnity bonds")
rule TaxedCasualtyPolicy(e: ForeignPolicyEvent) strict {
    when foreign_policy(e, CasualtyInsuranceOrIndemnityBond, _, _, _) and insured_within_4372d(e);
    then foreign_policy_taxed_kind(e, CasualtyInsuranceOrIndemnityBond);
}
@source(IRC_S4372_E, relation = formalizes, coverage = exact, quote = "with respect to the life or hazards to the person of a citizen or resident of the United States.")
rule TaxedLifePolicy(e: ForeignPolicyEvent) strict {
    when foreign_policy(e, LifeSicknessAccidentInsuranceOrAnnuity, _, _, _) and life_or_person_hazards_of_us_citizen_or_resident(e);
    then foreign_policy_taxed_kind(e, LifeSicknessAccidentInsuranceOrAnnuity);
}
@source(IRC_S4372_F, relation = formalizes, coverage = exact, quote = "against, or with respect to, any of the hazards, risks, losses, or liabilities covered by contracts taxable under paragraph (1) or (2) of section 4371.")
rule TaxedReinsurancePolicy(e: ForeignPolicyEvent) strict {
    when foreign_policy(e, Reinsurance, _, _, _) and reinsurance_covers_taxable_contracts(e);
    then foreign_policy_taxed_kind(e, Reinsurance);
}

@source(IRC_S4371, relation = formalizes, coverage = exact, quote = "4 cents on each dollar, or fractional part thereof, of the premium paid on the policy of casualty insurance or the indemnity bond")
rule ForeignCasualtyPolicyTax(e: ForeignPolicyEvent, premium: Decimal, insurer: Person) strict {
    when foreign_policy(e, CasualtyInsuranceOrIndemnityBond, premium, insurer, _)
        and foreign_insurer_or_reinsurer(insurer)
        and foreign_policy_taxed_kind(e, CasualtyInsuranceOrIndemnityBond)
        and not_known(amount_effectively_connected_with_us_trade_or_business(e))
        and not_known(indemnity_bond_to_secure_us_payment(e));
    then excise_tax_due(e, S4371CasualtyRatePerDollar * div_round(premium, 1.0, 0, "CEILING"));
}
@source(IRC_S4371, relation = formalizes, coverage = exact, quote = "1 cent on each dollar, or fractional part thereof, of the premium paid on the policy of life, sickness, or accident insurance, or annuity contract; and")
rule ForeignLifePolicyTax(e: ForeignPolicyEvent, premium: Decimal, insurer: Person) strict {
    when foreign_policy(e, LifeSicknessAccidentInsuranceOrAnnuity, premium, insurer, _)
        and foreign_insurer_or_reinsurer(insurer)
        and foreign_policy_taxed_kind(e, LifeSicknessAccidentInsuranceOrAnnuity)
        and not_known(amount_effectively_connected_with_us_trade_or_business(e));
    then excise_tax_due(e, S4371LifeAndReinsuranceRatePerDollar * div_round(premium, 1.0, 0, "CEILING"));
}
@source(IRC_S4371, relation = formalizes, coverage = exact, quote = "1 cent on each dollar, or fractional part thereof, of the premium paid on the policy of reinsurance covering any of the contracts taxable under paragraph (1) or (2).")
rule ForeignReinsurancePolicyTax(e: ForeignPolicyEvent, premium: Decimal, insurer: Person) strict {
    when foreign_policy(e, Reinsurance, premium, insurer, _)
        and foreign_insurer_or_reinsurer(insurer)
        and foreign_policy_taxed_kind(e, Reinsurance)
        and not_known(amount_effectively_connected_with_us_trade_or_business(e));
    then excise_tax_due(e, S4371LifeAndReinsuranceRatePerDollar * div_round(premium, 1.0, 0, "CEILING"));
}
@source(IRC_S4373, relation = formalizes, coverage = exact, quote = "unless such amount is exempt from the application of section 882(a) pursuant to a treaty obligation of the United States.")
rule EffectivelyConnectedItemsNotTaxedUnlessTreatyExempt(e: ForeignPolicyEvent) strict {
    when foreign_policy(e, _, _, _, _)
        and amount_effectively_connected_with_us_trade_or_business(e)
        and not_known(treaty_exempts_amount_from_section_882a(e));
    then tax_free_sale(e);
}
@source(IRC_S4373, relation = formalizes, coverage = exact, quote = "Any indemnity bond required to be filed by any person to secure payment of any pension, allowance, allotment, relief, or insurance by the United States")
rule UsBenefitIndemnityBondExempt(e: ForeignPolicyEvent) strict {
    when foreign_policy(e, CasualtyInsuranceOrIndemnityBond, _, _, _) and indemnity_bond_to_secure_us_payment(e);
    then tax_free_sale(e);
}

pub relation person_makes_signs_issues_or_sells_document(p: Person, e: ForeignPolicyEvent) kind empirical {
    label en official "section 4374: the person makes, signs, issues, or sells the document or instrument subject to the tax, or it is made, signed, issued or sold for the person's use or benefit";
}
pub relation united_states_or_agency_or_instrumentality(p: Person) kind empirical {
    label en official "section 4374: the person is the United States or an agency or instrumentality of it (not liable for the tax)";
}
@source(IRC_S4374, relation = formalizes, coverage = exact, quote = "The tax imposed by this chapter shall be paid, on the basis of a return, by any person who makes, signs, issues, or sells any of the documents and instruments subject to the tax, or for whose use or benefit the same are made, signed, issued, or sold.")
rule ForeignPolicyTaxLiability(p: Person, e: ForeignPolicyEvent, amount: Money) defeasible {
    when person_makes_signs_issues_or_sells_document(p, e) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(p, e, amount);
    unless united_states_or_agency_or_instrumentality(p) and person_makes_signs_issues_or_sells_document(p, e) and excise_tax_due(e, amount);
}

// =====================================================================
// Sections 4375-4377 — fees on health insurance policies and self-insured plans
// =====================================================================

pub enum PlanEstablisherKind {
    SingleEmployer;
    EmployeeOrganization;
    MultipleEmployersOrJointEmployerAndOrganization;
    MultipleEmployerWelfareArrangement;
    VoluntaryEmployeesBeneficiaryAssociation501c9;
    Organization501c6;
    RuralCooperativeOrAssociation;
}

pub entity HealthInsurancePolicy : ExciseEvent;
pub entity SelfInsuredHealthPlan : ExciseEvent;

pub relation health_policy_year(pol: HealthInsurancePolicy, year_ends_on: Date, average_lives_covered: Decimal, issuer: Person) kind empirical {
    label en official "section 4375(a): the policy year end, the average number of lives covered under the policy (as determined by regulation), and the issuer";
}
pub relation accident_or_health_policy_for_us_residents(pol: HealthInsurancePolicy) kind empirical {
    label en official "section 4375(c)(1): an accident or health insurance policy (including a policy under a group health plan) issued with respect to individuals residing in the United States";
}
pub relation substantially_all_coverage_excepted_benefits(pol: HealthInsurancePolicy) kind empirical {
    label en official "section 4375(c)(2): substantially all of the coverage is of excepted benefits described in section 9832(c)";
}
pub relation prepaid_coverage_arrangement_fixed_payments(pol: HealthInsurancePolicy, provider: Person) kind empirical {
    label en official "section 4375(c)(3)(B): fixed payments or premiums are received as consideration for any person's agreement to provide or arrange accident or health coverage to residents of the United States";
}
pub relation specified_health_insurance_policy(pol: HealthInsurancePolicy) kind institutional {
    label en official "section 4375(c): a specified health insurance policy";
}
pub relation lives_under_exempt_governmental_program(pol: HealthInsurancePolicy, lives: Decimal) kind empirical {
    label en official "section 4377(b)(2)-(3): the average number of covered lives under an exempt governmental program (Medicare, Medicaid or CHIP, military and veterans, Indian health)";
}
pub relation fee_lives_for_policy(pol: HealthInsurancePolicy, lives: Decimal) kind institutional {
    label en official "section 4375(a), 4377(b)(2): the average number of lives covered, without covered lives under an exempt governmental program";
}

@source(IRC_S4375_C, relation = formalizes, coverage = exact, quote = "the term \"specified health insurance policy\" means any accident or health insurance policy (including a policy under a group health plan) issued with respect to individuals residing in the United States.")
rule SpecifiedHealthInsurancePolicyClassification(pol: HealthInsurancePolicy) strict {
    when accident_or_health_policy_for_us_residents(pol) and not_known(substantially_all_coverage_excepted_benefits(pol));
    then specified_health_insurance_policy(pol);
}
@source(IRC_S4375_C, relation = formalizes, coverage = exact, quote = "such arrangement shall be treated as a specified health insurance policy, and the person referred to in such subparagraph shall be treated as the issuer.")
rule PrepaidCoverageArrangementIsPolicy(pol: HealthInsurancePolicy, provider: Person) strict {
    when prepaid_coverage_arrangement_fixed_payments(pol, provider);
    then specified_health_insurance_policy(pol);
}
@source(IRC_S4377_B, relation = formalizes, coverage = exact, quote = "no fee shall be imposed under section 4375 or section 4376 on any covered life under such program.")
rule FeeLivesNetOfExemptGovernmentalPrograms(pol: HealthInsurancePolicy, avg: Decimal, exempt: Decimal) strict {
    when health_policy_year(pol, _, avg, _) and lives_under_exempt_governmental_program(pol, exempt) and avg >= exempt;
    then fee_lives_for_policy(pol, avg - exempt);
}
@source(IRC_S4375_A, relation = formalizes, coverage = exact, quote = "multiplied by the average number of lives covered under the policy.")
rule FeeLivesWithoutExemptProgram(pol: HealthInsurancePolicy, avg: Decimal) strict {
    when health_policy_year(pol, _, avg, _) and not_known(policy_has_exempt_governmental_program_lives(pol));
    then fee_lives_for_policy(pol, avg);
}
pub relation policy_has_exempt_governmental_program_lives(pol: HealthInsurancePolicy) kind empirical {
    label en official "marker: the case states lives under an exempt governmental program for this policy";
}

@source(IRC_S4375_A, relation = formalizes, coverage = exact, quote = "a fee equal to the product of $2 ($1 in the case of policy years ending during fiscal year 2013) multiplied by the average number of lives covered under the policy.")
rule HealthInsurancePolicyFee(pol: HealthInsurancePolicy, ends: Date, lives: Decimal) strict {
    when health_policy_year(pol, ends, _, _)
        and specified_health_insurance_policy(pol)
        and fee_lives_for_policy(pol, lives)
        and ends > @2012-09-30
        and ends <= @2029-09-30;
    then excise_tax_due(pol, round(S4375FeePerCoveredLife * lives, 2, "HALF_UP"));
}
@source(IRC_S4375_B, relation = formalizes, coverage = exact, quote = "The fee imposed by subsection (a) shall be paid by the issuer of the policy.")
rule HealthInsurancePolicyFeeLiability(pol: HealthInsurancePolicy, issuer: Person, amount: Money) defeasible {
    when health_policy_year(pol, _, _, issuer) and excise_tax_due(pol, amount);
    then liable_for_excise(issuer, pol, amount);
}

pub relation plan_year(pl: SelfInsuredHealthPlan, year_ends_on: Date, average_lives_covered: Decimal) kind empirical {
    label en official "section 4376(a): the plan year end and the average number of lives covered under the plan";
}
pub relation plan_coverage_partly_other_than_through_insurance_policy(pl: SelfInsuredHealthPlan) kind empirical {
    label en official "section 4376(c)(1): any portion of the accident or health coverage is provided other than through an insurance policy";
}
pub relation plan_established_or_maintained_by(pl: SelfInsuredHealthPlan, kind: PlanEstablisherKind, sponsor: Person) kind empirical {
    label en official "section 4376(b)(2), (c)(2): the kind of establishing or maintaining body and the person who is the plan sponsor under the section 4376(b)(2) table (the employer, the employee organization, the association, committee, joint board of trustees or other similar group, or the cooperative or association)";
}
pub relation applicable_self_insured_health_plan(pl: SelfInsuredHealthPlan) kind institutional {
    label en official "section 4376(c): an applicable self-insured health plan";
}
pub relation plan_sponsor(pl: SelfInsuredHealthPlan, sponsor: Person) kind institutional {
    label en official "section 4376(b)(2): the plan sponsor";
}
pub relation plan_lives_under_exempt_governmental_program(pl: SelfInsuredHealthPlan, lives: Decimal) kind empirical {
    label en official "section 4377(b)(2): covered lives under an exempt governmental program (no fee)";
}

@source(IRC_S4376_C, relation = formalizes, coverage = exact, quote = "(1) any portion of such coverage is provided other than through an insurance policy, and")
rule ApplicableSelfInsuredHealthPlan(pl: SelfInsuredHealthPlan, k: PlanEstablisherKind, s: Person) strict {
    when plan_coverage_partly_other_than_through_insurance_policy(pl) and plan_established_or_maintained_by(pl, k, s);
    then applicable_self_insured_health_plan(pl);
}
@source(IRC_S4376_B, relation = formalizes, coverage = exact, quote = "(A) the employer in the case of a plan established or maintained by a single employer,")
rule PlanSponsorDetermined(pl: SelfInsuredHealthPlan, k: PlanEstablisherKind, s: Person) strict {
    when plan_established_or_maintained_by(pl, k, s);
    then plan_sponsor(pl, s);
}
@source(IRC_S4376_A, relation = formalizes, coverage = exact, quote = "there is hereby imposed a fee equal to $2 ($1 in the case of plan years ending during fiscal year 2013) multiplied by the average number of lives covered under the plan.")
rule SelfInsuredPlanFee(pl: SelfInsuredHealthPlan, ends: Date, avg: Decimal, exempt: Decimal) strict {
    when plan_year(pl, ends, avg)
        and applicable_self_insured_health_plan(pl)
        and plan_lives_under_exempt_governmental_program(pl, exempt)
        and avg >= exempt
        and ends > @2012-09-30
        and ends <= @2029-09-30;
    then excise_tax_due(pl, round(S4375FeePerCoveredLife * (avg - exempt), 2, "HALF_UP"));
}
@source(IRC_S4376_A, relation = formalizes, coverage = exact, quote = "there is hereby imposed a fee equal to $2 ($1 in the case of plan years ending during fiscal year 2013) multiplied by the average number of lives covered under the plan.")
rule SelfInsuredPlanFeeNoExemptLives(pl: SelfInsuredHealthPlan, ends: Date, avg: Decimal) strict {
    when plan_year(pl, ends, avg)
        and applicable_self_insured_health_plan(pl)
        and not_known(plan_has_exempt_program_lives_stated(pl))
        and ends > @2012-09-30
        and ends <= @2029-09-30;
    then excise_tax_due(pl, round(S4375FeePerCoveredLife * avg, 2, "HALF_UP"));
}
pub relation plan_has_exempt_program_lives_stated(pl: SelfInsuredHealthPlan) kind empirical {
    label en official "marker: the case states lives under an exempt governmental program for this plan";
}
@source(IRC_S4376_B, relation = formalizes, coverage = exact, quote = "The fee imposed by subsection (a) shall be paid by the plan sponsor.")
rule SelfInsuredPlanFeeLiability(pl: SelfInsuredHealthPlan, sponsor: Person, amount: Money) defeasible {
    when plan_sponsor(pl, sponsor) and excise_tax_due(pl, amount);
    then liable_for_excise(sponsor, pl, amount);
}

pub relation secretary_covers_over_fee_collections_to_possession(x: Organ) kind empirical {
    label en official "section 4377(d): the Secretary covers over an amount collected under the subchapter to a possession of the United States";
}
@source(IRC_S4377_D, relation = formalizes, coverage = exact, quote = "no amount collected under this subchapter shall be covered over to any possession of the United States.")
rule Section4377dNoCoverOverProhibitionRule strict {
    when true;
    then prohibition NoCoverOverOfHealthFeesToPossessions {
        bearer Secretary;
        action secretary_covers_over_fee_collections_to_possession(Secretary);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4501 — tax on repurchases of corporate stock
// =====================================================================

pub entity StockRepurchaseEvent : ExciseEvent;

pub relation stock_repurchase_year(
    e: StockRepurchaseEvent,
    corporation: Person,
    year_ends_on: Date,
    repurchased_fmv: Money,
    issued_fmv: Money,
) kind empirical {
    label en official "section 4501(a), (c)(3): the fair market value of the corporation's stock repurchased during the taxable year (DECISION-0194: an adjudicated amount when disputed) and of the stock it issued during the year";
}
pub relation corporation_stock_traded_on_established_securities_market(p: Person) kind empirical {
    label en official "section 4501(b): the stock of the corporation is traded on an established securities market (section 7704(b)(1))";
}
pub relation corporation_is_domestic(p: Person) kind empirical {
    label en official "section 4501(b): the corporation is a domestic corporation";
}
pub relation covered_corporation(p: Person) kind institutional {
    label en official "section 4501(b): a domestic corporation whose stock is traded on an established securities market";
}
pub relation repurchase_portion_in_reorganization_no_gain_or_loss(e: StockRepurchaseEvent, fmv: Money) kind empirical {
    label en official "section 4501(e)(1): the FMV of the repurchase that is part of a section 368(a) reorganization with no gain or loss recognized by the shareholder";
}
pub relation repurchase_portion_contributed_to_retirement_or_stock_ownership_plan(e: StockRepurchaseEvent, fmv: Money) kind empirical {
    label en official "section 4501(e)(2): stock (or an equal value of stock) contributed to an employer-sponsored retirement plan, employee stock ownership plan, or similar plan";
}
pub relation repurchase_portion_treated_as_dividend(e: StockRepurchaseEvent, fmv: Money) kind empirical {
    label en official "section 4501(e)(6): the FMV of the repurchase treated as a dividend for purposes of the title";
}
pub relation repurchase_by_dealer_in_securities_in_ordinary_course(e: StockRepurchaseEvent) kind empirical {
    label en official "section 4501(e)(4): the repurchase is by a dealer in securities in the ordinary course of business (under regulations)";
}
pub relation repurchaser_is_regulated_investment_company_or_reit(p: Person) kind empirical {
    label en official "section 4501(e)(5): the repurchasing corporation is a regulated investment company or a real estate investment trust";
}
pub relation repurchase_exclusion_amounts_stated(e: StockRepurchaseEvent) kind empirical {
    label en official "marker: the case states the section 4501(e)(1), (2), (6) exclusion amounts for this event";
}
pub relation specified_affiliate_acquisition_fmv(e: StockRepurchaseEvent, fmv: Money) kind empirical {
    label en official "section 4501(c)(2)(A): the FMV of stock of the covered corporation acquired by a specified affiliate from a person other than the corporation or a specified affiliate (treated as a repurchase by the corporation)";
}
pub relation repurchases_including_specified_affiliate_acquisitions(e: StockRepurchaseEvent, total: Money) kind institutional {
    label en official "section 4501(c)(2)(A): the FMV of stock repurchased by the corporation plus the stock of the corporation acquired by its specified affiliates from persons other than the corporation or a specified affiliate";
}
pub relation specified_affiliate_acquisition_stated(e: StockRepurchaseEvent) kind empirical {
    label en official "marker: the case states the FMV of specified-affiliate acquisitions for this event";
}
pub relation section_4501_tax_base(e: StockRepurchaseEvent, base: Money) kind institutional {
    label en official "section 4501(a), (c)(3), (e): repurchased FMV less excluded portions and less the FMV of stock issued during the taxable year, not below zero";
}

@source(IRC_S4501_B, relation = formalizes, coverage = exact, quote = "the term \"covered corporation\" means any domestic corporation the stock of which is traded on an established securities market")
rule CoveredCorporationClassification(p: Person) strict {
    when corporation_is_domestic(p) and corporation_stock_traded_on_established_securities_market(p);
    then covered_corporation(p);
}

@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be reduced by the fair market value of any stock issued by the covered corporation during the taxable year")
rule Section4501TaxBaseWithExclusions(e: StockRepurchaseEvent, rep: Money, iss: Money, reorg: Money, plan: Money, div: Money) strict {
    when issuance_adjustment_fmv(e, iss)
        and repurchases_treated_as_repurchases_4501c(e, rep)
        and repurchase_exclusion_amounts_stated(e)
        and repurchase_portion_in_reorganization_no_gain_or_loss(e, reorg)
        and repurchase_portion_contributed_to_retirement_or_stock_ownership_plan(e, plan)
        and repurchase_portion_treated_as_dividend(e, div)
        and rep - reorg - plan - div >= iss;
    then section_4501_tax_base(e, rep - reorg - plan - div - iss);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be reduced by the fair market value of any stock issued by the covered corporation during the taxable year")
rule Section4501TaxBaseNoExclusionsStated(e: StockRepurchaseEvent, rep: Money, iss: Money) strict {
    when issuance_adjustment_fmv(e, iss)
        and repurchases_treated_as_repurchases_4501c(e, rep)
        and not_known(repurchase_exclusion_amounts_stated(e))
        and rep >= iss;
    then section_4501_tax_base(e, rep - iss);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be reduced by the fair market value of any stock issued by the covered corporation during the taxable year")
rule Section4501TaxBaseIssuanceExceedsRepurchases(e: StockRepurchaseEvent, rep: Money, iss: Money) strict {
    when issuance_adjustment_fmv(e, iss) and repurchases_treated_as_repurchases_4501c(e, rep) and not_known(repurchase_exclusion_amounts_stated(e)) and rep < iss;
    then section_4501_tax_base(e, 0 USD);
}

@source(IRC_S4501_A, relation = formalizes, coverage = exact, quote = "a tax equal to 1 percent of the fair market value of any stock of the corporation which is repurchased by such corporation during the taxable year.")
rule Section4501Tax(e: StockRepurchaseEvent, corp: Person, ends: Date, rep: Money, base: Money) strict {
    when stock_repurchase_year(e, corp, ends, _, _)
        and (covered_corporation(corp) or special_rule_covered_corporation(e, corp))
        and section_4501_tax_base(e, base)
        and repurchases_treated_as_repurchases_4501c(e, rep)
        and rep > 1000000 USD
        and ends > @2022-12-31
        and not_known(repurchase_by_dealer_in_securities_in_ordinary_course(e))
        and not_known(repurchaser_is_regulated_investment_company_or_reit(corp));
    then excise_tax_due(e, round(base * S4501RatePercent, 2, "HALF_UP"));
}
@source(IRC_S4501_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on each covered corporation a tax")
rule Section4501Liability(e: StockRepurchaseEvent, corp: Person, amount: Money) defeasible {
    when stock_repurchase_year(e, corp, _, _, _) and excise_tax_due(e, amount);
    then liable_for_excise(corp, e, amount);
}

pub relation secretary_prescribed_repurchase_tax_regulations_and_guidance(x: Organ) kind institutional {
    label en official "section 4501(f): the regulations and other guidance necessary to carry out and to prevent the avoidance of section 4501 have been prescribed (exception abuse, special classes of stock and preferred stock, application of the subsection (d) rules)";
}
@source(IRC_S4501_F, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations and other guidance as are necessary or appropriate to carry out, and to prevent the avoidance of, the purposes of this section")
rule Section4501fRegulationsDutyRule strict {
    when true;
    then duty Section4501RegulationsDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_prescribed_repurchase_tax_regulations_and_guidance(Secretary);
            window [-infinity, infinity];
        }
    };
}

@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be treated as a repurchase of the stock of the covered corporation by such covered corporation.")
rule RepurchasesIncludeSpecifiedAffiliateAcquisitions(e: StockRepurchaseEvent, rep: Money, aff: Money) strict {
    when stock_repurchase_year(e, _, _, rep, _) and specified_affiliate_acquisition_fmv(e, aff);
    then repurchases_including_specified_affiliate_acquisitions(e, rep + aff);
}
@source(IRC_S4501_C, relation = formalizes, coverage = exact, quote = "shall be treated as a repurchase of the stock of the covered corporation by such covered corporation.")
rule RepurchasesWithoutSpecifiedAffiliateAcquisitions(e: StockRepurchaseEvent, rep: Money) strict {
    when stock_repurchase_year(e, _, _, rep, _) and not_known(specified_affiliate_acquisition_stated(e));
    then repurchases_including_specified_affiliate_acquisitions(e, rep);
}
