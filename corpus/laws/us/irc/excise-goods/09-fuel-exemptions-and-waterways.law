// Stage 2: section 4041(b)-(m) (exemptions, aviation fuel, LUST add-ons,
// alcohol fuels), section 4042 (inland waterways), section 4043 (fractional
// aircraft), section 4082 (dyed fuel), section 4083 (definitions), sections
// 4103 and 4105. Builds on the stage-1 event shapes of 01-motor-fuels.law.
//
// METHOD NOTE (stage 2). An exemption is a positive fact asserted by the case
// (the use, the purchaser, the destination) that concludes the shared
// `tax_free_sale(e)` relation; the stage-1 liability rules already read
// `not_known(tax_free_sale(e))`. Closed-world absence of a fact is never
// `not fact` (SPEC §69): the strict rules below use `not_known(...)`.
//
// section 4041(d)(5): the LUST add-on is determined WITHOUT the exemptions of
// (b)(1)(A), (f), (g), (h) and (l), except export and foreign-trade vessel
// supplies. So the add-on is its own tax relation and does not read
// `tax_free_sale`.

// =====================================================================
// Section 4041(b)(1), (f), (g), (h), (j), (l) — exemptions
// =====================================================================

use self::{
    AlternativeFuelEvent,
    AlternativeFuelKind,
    ExciseEvent,
    IRC_S4041_B,
    IRC_S4041_C,
    IRC_S4041_D,
    IRC_S4041_F,
    IRC_S4041_G,
    IRC_S4041_H,
    IRC_S4041_J,
    IRC_S4041_L,
    IRC_S4041_M,
    IRC_S4042_A,
    IRC_S4042_B,
    IRC_S4042_C,
    IRC_S4042_D,
    IRC_S4043_A,
    IRC_S4043_B,
    IRC_S4043_C,
    IRC_S4082_A,
    IRC_S4082_F,
    IRC_S4083_A,
    IRC_S4083_D,
    IRC_S4103,
    IRC_S4105_A,
    IRC_S4105_B,
    Organ,
    Person,
    Secretary,
    SpecialMotorFuelEvent,
    SpecialMotorFuelUse,
    SpecialMotorFuelVehicleKind,
    TaxableFuelEvent,
    TaxableFuelKind,
    TaxableFuelTrigger,
    alternative_fuel_event,
    excise_tax_due,
    fuel_train,
    liable_for_excise,
    special_motor_fuel_event,
    tax_free_sale,
    taxable_fuel_event,
    waterway_use_by_state_or_political_subdivision,
};

pub enum Section4041gGround {
    VesselOrAircraftSupplies;
    VesselOrAircraftSuppliesForeignTrade;
    StateOrLocalGovernmentUse;
    ExportOrShipmentToPossession;
    NonprofitEducationalOrganization;
    QualifiedBloodCollector;
}

pub relation off_highway_business_use(e: ExciseEvent) kind empirical {
    label en official "section 4041(b)(1)(C): the liquid is sold for use or used in an off-highway business use within the meaning of section 6421(e)(2) (a use in a diesel-powered train does not count for subsection (a)(1))";
}
pub relation used_on_farm_for_farming_purposes(e: ExciseEvent) kind empirical {
    label en official "section 4041(f): the liquid is sold for use or used on a farm for farming purposes, determined under section 6420(c)(1)-(3)";
}
pub relation exemption_ground_4041g(e: ExciseEvent, ground: Section4041gGround) kind empirical {
    label en official "section 4041(g): the sale or use falls within one of the other exemptions (vessel or aircraft supplies, State or local government, export, nonprofit educational organization, qualified blood collector)";
}
pub relation aircraft_museum_use(e: ExciseEvent, museum: Person) kind empirical {
    label en official "section 4041(h)(1): the liquid is sold for use or used by the museum in an aircraft or vehicle owned by it and used exclusively for the museum purposes of (h)(2)(C)";
}
pub relation section_501c3_exempt_organization(p: Person) kind empirical {
    label en official "the organization is described in section 501(c)(3) and exempt from income tax under section 501(a) (fact; the classification itself is owned by the exempt-organizations package)";
}
pub relation operated_as_museum_under_state_charter(p: Person) kind empirical {
    label en official "section 4041(h)(2)(B): operated as a museum under charter by a State or the District of Columbia";
}
pub relation operated_exclusively_for_wwii_aircraft(p: Person) kind empirical {
    label en official "section 4041(h)(2)(C): operated exclusively for the procurement, care, and exhibition of aircraft of the type used for combat or transport in World War II";
}
pub relation aircraft_museum(p: Person) kind institutional {
    label en official "section 4041(h)(2): the organization is an aircraft museum";
}
pub relation air_transportation_exempt_under_4261_f_or_g(e: ExciseEvent) kind empirical {
    label en official "section 4041(l): the liquid is used in a helicopter or fixed-wing aircraft for transportation meeting the requirements of section 4261(f) or (g)";
}
pub relation sale_at_retail_by_united_states(e: ExciseEvent) kind empirical {
    label en official "section 4041(j): the liquid is sold at retail by the United States or an agency or instrumentality of it";
}
pub relation us_agency_sales_statutorily_exempt(e: ExciseEvent) kind empirical {
    label en official "section 4041(j): sales by that agency or instrumentality are by statute specifically exempted from the taxes";
}
pub relation section_4041_applies_to_us_retail_sale(e: ExciseEvent) kind institutional {
    label en official "section 4041(j): the taxes of section 4041 apply to a retail sale by the United States or its agency unless a statute specifically exempts that agency's sales";
}

@source(IRC_S4041_H, relation = formalizes, coverage = exact, quote = "described in section 501(c)(3) which is exempt from income tax under section 501(a)")
rule AircraftMuseumClassification(p: Person) strict {
    when section_501c3_exempt_organization(p) and operated_as_museum_under_state_charter(p) and operated_exclusively_for_wwii_aircraft(p);
    then aircraft_museum(p);
}

@source(IRC_S4041_J, relation = formalizes, coverage = exact, quote = "The taxes imposed by this section shall apply with respect to liquids sold at retail by the United States")
rule UsRetailSaleTaxable(e: ExciseEvent) strict {
    when sale_at_retail_by_united_states(e) and not_known(us_agency_sales_statutorily_exempt(e));
    then section_4041_applies_to_us_retail_sale(e);
}

@source(IRC_S4041_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by subsection (a) on liquids sold for use or used in an off-highway business use.")
rule OffHighwayExemptionSpecialFuel(e: SpecialMotorFuelEvent) strict {
    when special_motor_fuel_event(e, _, _, _, _, _) and off_highway_business_use(e) and not_known(fuel_train(e));
    then tax_free_sale(e);
}
@source(IRC_S4041_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by subsection (a) on liquids sold for use or used in an off-highway business use.")
rule OffHighwayExemptionAlternativeFuel(e: AlternativeFuelEvent) strict {
    when alternative_fuel_event(e, _, _, _, _) and off_highway_business_use(e);
    then tax_free_sale(e);
}

@source(IRC_S4041_F, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used on a farm for farming purposes")
rule FarmUseExemptionSpecialFuel(e: SpecialMotorFuelEvent) strict {
    when special_motor_fuel_event(e, _, _, _, _, _) and used_on_farm_for_farming_purposes(e);
    then tax_free_sale(e);
}
@source(IRC_S4041_F, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used on a farm for farming purposes")
rule FarmUseExemptionAlternativeFuel(e: AlternativeFuelEvent) strict {
    when alternative_fuel_event(e, _, _, _, _) and used_on_farm_for_farming_purposes(e);
    then tax_free_sale(e);
}

@source(IRC_S4041_G, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, no tax shall be imposed under this section—")
rule OtherExemptionsSpecialFuel(e: SpecialMotorFuelEvent, ground: Section4041gGround) strict {
    when special_motor_fuel_event(e, _, _, _, _, _) and exemption_ground_4041g(e, ground);
    then tax_free_sale(e);
}
@source(IRC_S4041_G, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, no tax shall be imposed under this section—")
rule OtherExemptionsAlternativeFuel(e: AlternativeFuelEvent, ground: Section4041gGround) strict {
    when alternative_fuel_event(e, _, _, _, _) and exemption_ground_4041g(e, ground);
    then tax_free_sale(e);
}

@source(IRC_S4041_H, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used by an aircraft museum")
rule AircraftMuseumExemptionSpecialFuel(e: SpecialMotorFuelEvent, museum: Person) strict {
    when special_motor_fuel_event(e, _, _, _, _, _) and aircraft_museum_use(e, museum) and aircraft_museum(museum);
    then tax_free_sale(e);
}
@source(IRC_S4041_H, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used by an aircraft museum")
rule AircraftMuseumExemptionAlternativeFuel(e: AlternativeFuelEvent, museum: Person) strict {
    when alternative_fuel_event(e, _, _, _, _) and aircraft_museum_use(e, museum) and aircraft_museum(museum);
    then tax_free_sale(e);
}

// =====================================================================
// Section 4041(c), (d)(2): liquids used as a fuel in aviation
// =====================================================================

pub entity AviationFuelEvent : ExciseEvent;

pub relation aviation_fuel_event(
    e: AviationFuelEvent,
    use: SpecialMotorFuelUse,
    gallons: Decimal,
    on: Date,
    responsible: Person,
) kind empirical {
    label en official "section 4041(c)(1): a liquid for use as a fuel other than aviation gasoline sold to the owner, lessee or other operator of an aircraft for use in it, or used by a person in an aircraft without a taxable sale";
}
pub relation aviation_fuel_commercial_aviation(e: AviationFuelEvent) kind empirical {
    label en official "section 4041(c)(3): the sale or use is for commercial aviation (section 4083(b))";
}
pub relation aviation_fuel_previously_taxed_under_4081(e: AviationFuelEvent) kind empirical {
    label en official "section 4041(c)(2): tax was imposed on the liquid under section 4081 (other than at the LUST financing rate) and not credited or refunded";
}
pub relation aviation_fuel_taxable_sale_under_4041c1a(e: AviationFuelEvent) kind empirical {
    label en official "section 4041(c)(1)(B): there was a taxable sale of the fuel under subparagraph (A), so a later use is not taxed again";
}
pub relation aviation_fuel_is_gasoline(e: AviationFuelEvent) kind empirical {
    label en official "section 4041(d)(2): the liquid is gasoline as defined in section 4083 (the LUST add-on applies only to liquids other than gasoline)";
}
pub relation aviation_fuel_taxed_under_4081(e: AviationFuelEvent) kind empirical {
    label en official "section 4041(d)(2): there was a taxable sale of the liquid under section 4081";
}
pub relation aviation_fuel_taxed_under_4043(e: AviationFuelEvent) kind empirical {
    label en official "section 4261(j): tax is imposed under section 4043 with respect to the fuel used in the air transportation";
}

@source(IRC_S4041_C, relation = formalizes, coverage = exact, quote = "21.8 cents per gallon (4.3 cents per gallon with respect to any sale or use for commercial aviation)")
rule AviationFuelTaxNonCommercial(e: AviationFuelEvent, gallons: Decimal) strict {
    when aviation_fuel_event(e, _, gallons, _, _) and not_known(aviation_fuel_commercial_aviation(e));
    then excise_tax_due(e, round(S4041cAviationRatePerGallon * gallons, 2, "HALF_UP"));
}
@source(IRC_S4041_C, relation = formalizes, coverage = exact, quote = "21.8 cents per gallon (4.3 cents per gallon with respect to any sale or use for commercial aviation)")
rule AviationFuelTaxCommercial(e: AviationFuelEvent, gallons: Decimal) strict {
    when aviation_fuel_event(e, _, gallons, _, _) and aviation_fuel_commercial_aviation(e);
    then excise_tax_due(e, round(S4041cCommercialAviationRatePerGallon * gallons, 2, "HALF_UP"));
}

@source(IRC_S4041_C, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by this subsection on the sale or use of any liquid for use as a fuel other than aviation gasoline if tax was imposed on such liquid under section 4081")
rule AviationFuelPreviouslyTaxedExempt(e: AviationFuelEvent) strict {
    when aviation_fuel_event(e, _, _, _, _) and aviation_fuel_previously_taxed_under_4081(e);
    then tax_free_sale(e);
}
@source(IRC_S4041_C, relation = formalizes, coverage = exact, quote = "used by any person in an aircraft unless there was a taxable sale of such fuel under subparagraph (A)")
rule AviationFuelUseAfterTaxableSaleExempt(e: AviationFuelEvent) strict {
    when aviation_fuel_event(e, UsedAsFuelWithoutTaxableSale, _, _, _) and aviation_fuel_taxable_sale_under_4041c1a(e);
    then tax_free_sale(e);
}
@source(IRC_S4041_L, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under this section on any liquid sold for use in, or used in, a helicopter or a fixed-wing aircraft")
rule AviationFuelSection4261Exempt(e: AviationFuelEvent) strict {
    when aviation_fuel_event(e, _, _, _, _) and air_transportation_exempt_under_4261_f_or_g(e);
    then tax_free_sale(e);
}
@source(IRC_S4041_F, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used on a farm for farming purposes")
rule AviationFuelFarmExempt(e: AviationFuelEvent) strict {
    when aviation_fuel_event(e, _, _, _, _) and used_on_farm_for_farming_purposes(e);
    then tax_free_sale(e);
}
@source(IRC_S4041_G, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, no tax shall be imposed under this section—")
rule AviationFuelOtherExemptions(e: AviationFuelEvent, ground: Section4041gGround) strict {
    when aviation_fuel_event(e, _, _, _, _) and exemption_ground_4041g(e, ground);
    then tax_free_sale(e);
}
@source(IRC_S4041_H, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under this section on any liquid sold for use or used by an aircraft museum")
rule AviationFuelAircraftMuseumExempt(e: AviationFuelEvent, museum: Person) strict {
    when aviation_fuel_event(e, _, _, _, _) and aircraft_museum_use(e, museum) and aircraft_museum(museum);
    then tax_free_sale(e);
}

@source(IRC_S4041_C, relation = formalizes, coverage = partial, quote = "There is hereby imposed a tax upon any liquid for use as a fuel other than aviation gasoline—")
rule AviationFuelLiability(e: AviationFuelEvent, responsible: Person, amount: Money) defeasible {
    when aviation_fuel_event(e, _, _, _, responsible) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(responsible, e, amount);
}

// --- section 4041(d): additional LUST taxes --------------------------------

pub relation lust_add_on_tax_due(e: ExciseEvent, amount: Money) kind institutional {
    label en official "section 4041(d): the additional Leaking Underground Storage Tank Trust Fund tax on this sale or use (0.1 cent a gallon; 0.05 cent for qualified methanol or ethanol fuel under (b)(2)(A)(ii))";
}
pub relation lust_rate_tax_imposed_under_4081(e: ExciseEvent) kind empirical {
    label en official "section 4041(d)(1): tax was imposed on the liquid under section 4081 at the Leaking Underground Storage Tank Trust Fund financing rate";
}
pub relation lust_add_on_exempt(e: ExciseEvent) kind institutional {
    label en official "section 4041(d)(5): the add-on is not exempted by (b)(1)(A), (f), (g), (h) or (l), except for export and for supplies of vessels employed in foreign trade";
}

@source(IRC_S4041_D, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply with respect to subsection (g)(3)")
rule LustAddOnExportExempt(e: ExciseEvent) strict {
    when exemption_ground_4041g(e, ExportOrShipmentToPossession);
    then lust_add_on_exempt(e);
}
@source(IRC_S4041_D, relation = formalizes, coverage = exact, quote = "so much of subsection (g)(1) as relates to vessels")
rule LustAddOnForeignTradeVesselExempt(e: ExciseEvent) strict {
    when exemption_ground_4041g(e, VesselOrAircraftSuppliesForeignTrade);
    then lust_add_on_exempt(e);
}

@source(IRC_S4041_D, relation = formalizes, coverage = exact, quote = "there is hereby imposed a tax of 0.1 cent a gallon on the sale or use of any liquid")
rule LustAddOnSpecialFuel(e: SpecialMotorFuelEvent, gallons: Decimal, on: Date) strict {
    when special_motor_fuel_event(e, _, _, gallons, on, _)
        and on >= @1997-10-01 and on < @2028-10-01
        and not_known(lust_rate_tax_imposed_under_4081(e))
        and not_known(lust_add_on_exempt(e));
    then lust_add_on_tax_due(e, round(S4041dLustRatePerGallon * gallons, 4, "HALF_UP"));
}
@source(IRC_S4041_D, relation = formalizes, coverage = partial, quote = "(other than liquefied petroleum gas and other than liquefied natural gas)")
rule LustAddOnCoalOrBiomassLiquid(e: AlternativeFuelEvent, gallons: Decimal, on: Date) strict {
    when alternative_fuel_event(e, CoalOrBiomassDerivedLiquidFuel, gallons, on, _)
        and on >= @1997-10-01 and on < @2028-10-01
        and not_known(lust_rate_tax_imposed_under_4081(e))
        and not_known(lust_add_on_exempt(e));
    then lust_add_on_tax_due(e, round(S4041dLustRatePerGallon * gallons, 4, "HALF_UP"));
}
@source(IRC_S4041_D, relation = formalizes, coverage = exact, quote = "In addition to the taxes imposed by subsection (c), there is hereby imposed a tax of 0.1 cent a gallon on any liquid")
rule LustAddOnAviation(e: AviationFuelEvent, gallons: Decimal, on: Date) strict {
    when aviation_fuel_event(e, _, gallons, on, _)
        and on >= @1997-10-01 and on < @2028-10-01
        and not_known(aviation_fuel_is_gasoline(e))
        and not_known(aviation_fuel_taxed_under_4081(e))
        and not_known(lust_add_on_exempt(e));
    then lust_add_on_tax_due(e, round(S4041dLustRatePerGallon * gallons, 4, "HALF_UP"));
}

// =====================================================================
// Section 4041(b)(2), (m): alcohol fuels
// =====================================================================

pub enum AlcoholSource {
    ProducedFromCoalOrPeat;
    ProducedFromNaturalGas;
    OtherSource;
}

pub entity AlcoholFuelEvent : ExciseEvent;

pub relation alcohol_fuel_event(
    e: AlcoholFuelEvent,
    alcohol_origin: AlcoholSource,
    alcohol_share: Decimal,
    gallons: Decimal,
    on: Date,
    responsible: Person,
) kind empirical {
    label en official "a sale or use of a liquid consisting in part (alcohol_share, a fraction 0..1) of methanol, ethanol or other alcohol produced from the named source, sections 4041(b)(2)(B) and (m)(2)";
}
pub relation alcohol_includes_ethanol(e: AlcoholFuelEvent) kind empirical {
    label en official "at least part of the alcohol in the fuel is ethanol (sections 4041(b)(2)(A)(i), (m)(1)(A)(i))";
}
pub relation qualified_methanol_or_ethanol_fuel(e: AlcoholFuelEvent) kind institutional {
    label en official "section 4041(b)(2)(B): any liquid at least 85 percent of which consists of methanol, ethanol, or other alcohol produced from coal (including peat)";
}
pub relation partially_exempt_methanol_or_ethanol_fuel(e: AlcoholFuelEvent) kind institutional {
    label en official "section 4041(m)(2): any liquid at least 85 percent of which consists of methanol, ethanol, or other alcohol produced from natural gas";
}
pub relation qualified_alcohol_fuel_rate_reduction(e: AlcoholFuelEvent, reduction: Money) kind institutional {
    label en official "section 4041(b)(2)(A)(i), (C)(i): the applicable blender rate per gallon by which the section 4041(a)(2) rate is reduced (5.4 cents; 6 cents for a mixture with no ethanol) on sales before 2001; 2001-2008 depends on section 40(h)(2) (EXTERNAL_DEPENDENCY, not computed); none after 2008 (subparagraph (D))";
}

@source(IRC_S4041_B, relation = formalizes, coverage = exact, quote = "at least 85 percent of which consists of methanol, ethanol, or other alcohol produced from coal (including peat)")
rule QualifiedMethanolOrEthanolFuelClassification(e: AlcoholFuelEvent, share: Decimal) strict {
    when alcohol_fuel_event(e, ProducedFromCoalOrPeat, share, _, _, _) and share >= 0.85;
    then qualified_methanol_or_ethanol_fuel(e);
}
@source(IRC_S4041_M, relation = formalizes, coverage = exact, quote = "at least 85 percent of which consists of methanol, ethanol, or other alcohol produced from natural gas")
rule PartiallyExemptMethanolOrEthanolFuelClassification(e: AlcoholFuelEvent, share: Decimal) strict {
    when alcohol_fuel_event(e, ProducedFromNaturalGas, share, _, _, _) and share >= 0.85;
    then partially_exempt_methanol_or_ethanol_fuel(e);
}

@source(IRC_S4041_B, relation = formalizes, coverage = partial, quote = "(6 cents per gallon in the case of a mixture none of the alcohol in which consists of ethanol)")
rule BlenderReductionNoEthanolBefore2001(e: AlcoholFuelEvent, on: Date) strict {
    when alcohol_fuel_event(e, _, _, _, on, _) and qualified_methanol_or_ethanol_fuel(e) and on < @2001-01-01 and not_known(alcohol_includes_ethanol(e));
    then qualified_alcohol_fuel_rate_reduction(e, S4041bNoEthanolBlenderReduction);
}
@source(IRC_S4041_B, relation = formalizes, coverage = partial, quote = "(i) except as provided in clause (ii), 5.4 cents, and")
rule BlenderReductionWithEthanolBefore2001(e: AlcoholFuelEvent, on: Date) strict {
    when alcohol_fuel_event(e, _, _, _, on, _) and qualified_methanol_or_ethanol_fuel(e) and on < @2001-01-01 and alcohol_includes_ethanol(e);
    then qualified_alcohol_fuel_rate_reduction(e, S4041bBlenderReduction);
}

@source(IRC_S4041_M, relation = formalizes, coverage = exact, quote = "(i) in the case of fuel none of the alcohol in which consists of ethanol, 9.15 cents per gallon, and")
rule PartiallyExemptAlcoholFuelTaxNoEthanol(e: AlcoholFuelEvent, gallons: Decimal) strict {
    when alcohol_fuel_event(e, _, _, gallons, _, _) and partially_exempt_methanol_or_ethanol_fuel(e) and not_known(alcohol_includes_ethanol(e));
    then excise_tax_due(e, round(S4041mNoEthanolRatePerGallon * gallons, 2, "HALF_UP"));
}
@source(IRC_S4041_M, relation = formalizes, coverage = exact, quote = "(ii) in any other case, 11.3 cents per gallon, and")
rule PartiallyExemptAlcoholFuelTaxEthanol(e: AlcoholFuelEvent, gallons: Decimal) strict {
    when alcohol_fuel_event(e, _, _, gallons, _, _) and partially_exempt_methanol_or_ethanol_fuel(e) and alcohol_includes_ethanol(e);
    then excise_tax_due(e, round(S4041mEthanolRatePerGallon * gallons, 2, "HALF_UP"));
}
@source(IRC_S4041_M, relation = formalizes, coverage = partial, quote = "In the case of the sale or use of any partially exempt methanol or ethanol fuel")
rule AlcoholFuelLiability(e: AlcoholFuelEvent, responsible: Person, amount: Money) defeasible {
    when alcohol_fuel_event(e, _, _, _, _, responsible) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(responsible, e, amount);
}

// =====================================================================
// Section 4042 — inland waterways fuel tax
// =====================================================================

pub entity WaterwayFuelEvent : ExciseEvent;

pub relation waterway_fuel_use(e: WaterwayFuelEvent, gallons: Decimal, on: Date, user: Person) kind empirical {
    label en official "section 4042(a): a liquid used during a calendar quarter by a person as a fuel in a vessel";
}
pub relation vessel_use_on_us_inland_or_intracoastal_waterway(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(d)(1): the use is on an inland or intracoastal waterway of the United States described in section 206 of the Inland Waterways Revenue Act of 1978";
}
pub relation vessel_transports_property_for_hire(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(d)(1)(A): the vessel is used in the business of transporting property for compensation or hire";
}
pub relation vessel_transports_property_in_own_business(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(d)(1)(B): the vessel transports property in the business of its owner, lessee or operator";
}
pub relation transported_property_only_fish_caught_on_voyage(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(d)(1)(B): the only property transported is fish or other aquatic animal life caught on the voyage";
}
pub relation commercial_waterway_transportation(e: WaterwayFuelEvent) kind institutional {
    label en official "section 4042(d)(1): use of a vessel on an inland or intracoastal waterway in business transport of property";
}
pub relation high_seas_vessel_draft_over_12_feet(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(c)(1): a vessel designed primarily for use on the high seas which has a draft of more than 12 feet";
}
pub relation vessel_used_primarily_for_persons(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(c)(2): a vessel used primarily for the transportation of persons";
}
pub relation lash_or_seabee_barge_tug_use(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(c)(4): use for movement by tug of exclusively LASH and SEABEE ocean-going barges released by their ocean-going carriers solely to pick up or deliver cargo";
}
pub relation waterway_fuel_taxed_under_4041d_or_4081_lust(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(b)(3): tax was imposed on the fuel under section 4041(d) or 4081 at the LUST financing rate";
}
pub relation waterway_fuel_tax_exempt_use(e: WaterwayFuelEvent) kind institutional {
    label en official "section 4042(c)(1), (2), (4): the use is excluded from the tax of subsection (a)";
}
pub relation waterway_fuel_rate(e: WaterwayFuelEvent, rate: Money) kind institutional {
    label en official "section 4042(b): the sum of the Inland Waterways Trust Fund financing rate and the LUST financing rate";
}

@source(IRC_S4042_D, relation = formalizes, coverage = exact, quote = "any use of a vessel on any inland or intracoastal waterway of the United States—")
rule CommercialWaterwayForHire(e: WaterwayFuelEvent) strict {
    when vessel_use_on_us_inland_or_intracoastal_waterway(e) and vessel_transports_property_for_hire(e);
    then commercial_waterway_transportation(e);
}
@source(IRC_S4042_D, relation = formalizes, coverage = exact, quote = "(B) in transporting property in the business of the owner, lessee, or operator of the vessel (other than fish or other aquatic animal life caught on the voyage).")
rule CommercialWaterwayOwnBusiness(e: WaterwayFuelEvent) strict {
    when vessel_use_on_us_inland_or_intracoastal_waterway(e) and vessel_transports_property_in_own_business(e) and not_known(transported_property_only_fish_caught_on_voyage(e)) and not_known(waterway_use_by_state_or_political_subdivision(e));
    then commercial_waterway_transportation(e);
}

@source(IRC_S4042_C, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (a) shall not apply with respect to any vessel designed primarily for use on the high seas which has a draft of more than 12 feet.")
rule WaterwayHighSeasVesselExempt(e: WaterwayFuelEvent) strict {
    when waterway_fuel_use(e, _, _, _) and high_seas_vessel_draft_over_12_feet(e);
    then waterway_fuel_tax_exempt_use(e);
}
@source(IRC_S4042_C, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (a) shall not apply with respect to any vessel used primarily for the transportation of persons.")
rule WaterwayPassengerVesselExempt(e: WaterwayFuelEvent) strict {
    when waterway_fuel_use(e, _, _, _) and vessel_used_primarily_for_persons(e);
    then waterway_fuel_tax_exempt_use(e);
}
@source(IRC_S4042_C, relation = formalizes, coverage = partial, quote = "The tax imposed by subsection (a) shall not apply with respect to use for movement by tug of exclusively LASH")
rule WaterwayLashSeabeeTugExempt(e: WaterwayFuelEvent) strict {
    when waterway_fuel_use(e, _, _, _) and lash_or_seabee_barge_tug_use(e);
    then waterway_fuel_tax_exempt_use(e);
}

@source(IRC_S4042_B, relation = formalizes, coverage = exact, quote = "(A) The Inland Waterways Trust Fund financing rate is 29 cents per gallon.")
rule WaterwayRateWithLust(e: WaterwayFuelEvent, on: Date) strict {
    when waterway_fuel_use(e, _, on, _) and on >= @1997-10-01 and on < @2028-10-01 and not_known(waterway_fuel_taxed_under_4041d_or_4081_lust(e));
    then waterway_fuel_rate(e, S4042InlandWaterwaysRatePerGallon + S4042LustRatePerGallon);
}
@source(IRC_S4042_B, relation = formalizes, coverage = exact, quote = "shall not apply to the use of any fuel if tax was imposed with respect to such fuel under section 4041(d) or 4081")
rule WaterwayRateWithoutLustAlreadyTaxed(e: WaterwayFuelEvent, on: Date) strict {
    when waterway_fuel_use(e, _, on, _) and waterway_fuel_taxed_under_4041d_or_4081_lust(e);
    then waterway_fuel_rate(e, S4042InlandWaterwaysRatePerGallon);
}
@source(IRC_S4042_B, relation = formalizes, coverage = exact, quote = "shall not apply during any period during which the Leaking Underground Storage Tank Trust Fund financing rate under section 4081 does not apply")
rule WaterwayRateWithoutLustPeriod(e: WaterwayFuelEvent, on: Date) strict {
    when waterway_fuel_use(e, _, on, _) and (on < @1997-10-01 or on >= @2028-10-01) and not_known(waterway_fuel_taxed_under_4041d_or_4081_lust(e));
    then waterway_fuel_rate(e, S4042InlandWaterwaysRatePerGallon);
}

@source(IRC_S4042_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on any liquid used during any calendar quarter by any person as a fuel in a vessel in commercial waterway transportation.")
rule WaterwayFuelTax(e: WaterwayFuelEvent, gallons: Decimal, rate: Money) strict {
    when waterway_fuel_use(e, _, _, _) and waterway_fuel_use(e, gallons, _, _) and commercial_waterway_transportation(e) and waterway_fuel_rate(e, rate) and not_known(waterway_fuel_tax_exempt_use(e));
    then excise_tax_due(e, round(rate * gallons, 4, "HALF_UP"));
}
@source(IRC_S4042_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on any liquid used during any calendar quarter by any person as a fuel in a vessel in commercial waterway transportation.")
rule WaterwayFuelLiability(e: WaterwayFuelEvent, user: Person, amount: Money) defeasible {
    when waterway_fuel_use(e, _, _, user) and excise_tax_due(e, amount);
    then liable_for_excise(user, e, amount);
}

// =====================================================================
// Section 4043 — fractional program aircraft
// =====================================================================

pub enum FractionalAircraftKind {
    SubsonicFixedWingOrPoweredLift;
    Rotorcraft;
}

pub entity FractionalProgramAircraft;
pub entity FractionalFuelEvent : ExciseEvent;

pub relation fractional_ownership_interest(owner: Person, aircraft: FractionalProgramAircraft, kind: FractionalAircraftKind, share: Decimal) kind empirical {
    label en official "section 4043(c)(3)(C)-(D): the person owns, or holds a qualifying multi-year leasehold in, the stated fractional share (0..1) of the aircraft";
}
pub relation minimum_fractional_ownership_interest_held(owner: Person, aircraft: FractionalProgramAircraft) kind institutional {
    label en official "section 4043(c)(3)(B): an interest of at least 1/16 of a subsonic, fixed wing or powered lift aircraft, or at least 1/32 of a rotorcraft";
}
pub relation qualified_fractional_owner(owner: Person) kind institutional {
    label en official "section 4043(c)(3)(A): a fractional owner with a minimum fractional ownership interest in at least one fractional program aircraft";
}
pub relation fractional_program_aircraft_faa_listed_and_us_registered(aircraft: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(1): the aircraft is listed as a fractional program aircraft in FAA management specifications under 14 CFR part 91 subpart K and is registered in the United States";
}
pub relation fractional_fuel_use(e: FractionalFuelEvent, aircraft: FractionalProgramAircraft, gallons: Decimal, on: Date, user: Person) kind empirical {
    label en official "section 4043(a): a liquid used (during a calendar quarter by any person) in a fractional program aircraft as fuel";
}
pub relation fractional_fuel_for_qualified_owner_transport(e: FractionalFuelEvent, owner: Person) kind empirical {
    label en official "section 4043(a)(1)-(2): the fuel is used for the transportation of a qualified fractional owner of the program, or on account of that owner including deadhead service";
}
pub relation fractional_flight_excluded_from_owner_use(e: FractionalFuelEvent) kind empirical {
    label en official "section 4043(c)(5)-(6): the flight is excluded from use for or on account of a qualified fractional owner (e.g. deadhead service separately charged to a person other than a qualified owner)";
}

@source(IRC_S4043_C, relation = formalizes, coverage = exact, quote = "(i) a fractional ownership interest equal to or greater than 1/16 of at least 1 subsonic, fixed wing, or powered lift aircraft, or")
rule MinimumFractionalInterestFixedWing(o: Person, a: FractionalProgramAircraft, share: Decimal) strict {
    when fractional_ownership_interest(o, a, SubsonicFixedWingOrPoweredLift, share) and share >= 0.0625;
    then minimum_fractional_ownership_interest_held(o, a);
}
@source(IRC_S4043_C, relation = formalizes, coverage = exact, quote = "(ii) a fractional ownership interest equal to or greater than 1/32 of at least 1 rotorcraft aircraft.")
rule MinimumFractionalInterestRotorcraft(o: Person, a: FractionalProgramAircraft, share: Decimal) strict {
    when fractional_ownership_interest(o, a, Rotorcraft, share) and share >= 0.03125;
    then minimum_fractional_ownership_interest_held(o, a);
}
@source(IRC_S4043_C, relation = formalizes, coverage = exact, quote = "The term \"qualified fractional owner\" means any fractional owner which has a minimum fractional ownership interest in at least one fractional program aircraft.")
rule QualifiedFractionalOwnerClassification(o: Person, a: FractionalProgramAircraft) strict {
    when minimum_fractional_ownership_interest_held(o, a) and fractional_program_aircraft_faa_listed_and_us_registered(a);
    then qualified_fractional_owner(o);
}

@source(IRC_S4043_B, relation = formalizes, coverage = exact, quote = "The rate of tax imposed by subsection (a) is 14.1 cents per gallon.")
rule FractionalAircraftFuelTax(e: FractionalFuelEvent, a: FractionalProgramAircraft, gallons: Decimal, on: Date, owner: Person) strict {
    when fractional_fuel_use(e, a, gallons, on, _)
        and fractional_program_aircraft_faa_listed_and_us_registered(a)
        and fractional_fuel_for_qualified_owner_transport(e, owner)
        and qualified_fractional_owner(owner)
        and on <= @2028-09-30
        and not_known(fractional_flight_excluded_from_owner_use(e));
    then excise_tax_due(e, round(S4043RatePerGallon * gallons, 4, "HALF_UP"));
}
@source(IRC_S4043_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on any liquid used (during any calendar quarter by any person) in a fractional program aircraft as fuel—")
rule FractionalAircraftFuelLiability(e: FractionalFuelEvent, user: Person, amount: Money) defeasible {
    when fractional_fuel_use(e, _, _, _, user) and excise_tax_due(e, amount);
    then liable_for_excise(user, e, amount);
}

// =====================================================================
// Section 4082 — dyed diesel fuel and kerosene; section 4083 definitions
// =====================================================================

external judgment relation secretary_determines_destined_for_nontaxable_use(e: TaxableFuelEvent) {
    authority Secretary;
    label en official "section 4082(a)(1): the Secretary determines that the diesel fuel or kerosene is destined for a nontaxable use (DECISION-0194 judgment channel: the text commits the determination to the Secretary)";
}
pub relation fuel_indelibly_dyed_by_mechanical_injection(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(a)(2): the diesel fuel or kerosene is indelibly dyed by mechanical injection in accordance with regulations";
}
pub relation fuel_meets_marking_requirements_if_any(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(a)(3): the fuel meets the marking requirements (if any) prescribed by the Secretary in regulations";
}
pub relation dyed_fuel_exempt_from_non_lust_tax(e: TaxableFuelEvent) kind institutional {
    label en official "section 4082(a), (f)(1): the section 4081 tax other than at the LUST financing rate does not apply to this dyed fuel";
}
pub relation dyed_fuel_lust_only_tax_due(e: TaxableFuelEvent, amount: Money) kind institutional {
    label en official "section 4082(f)(1): section 4082(a) does not apply to the section 4081 tax at the LUST financing rate, so only that add-on remains due";
}
pub relation dyed_fuel_supplies_or_export_determined(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(f)(2): the Secretary determines the fuel is destined for export or for use by the purchaser as supplies for vessels (LUST tax is then also not imposed)";
}
pub relation fuel_use_is_nontaxable_use_4082b(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(b): the intended use is a nontaxable use (exempt from tax under section 4041(a)(1) other than by prior imposition, a use in a train, or a use described in section 4041(a)(1)(C)(iii)(II)); the use of kerosene in an aircraft is never a nontaxable use";
}
pub relation section_4083_taxable_fuel(e: TaxableFuelEvent) kind institutional {
    label en official "section 4083(a)(1): gasoline, diesel fuel, or kerosene is taxable fuel";
}

@source(IRC_S4082_A, relation = formalizes, coverage = exact, quote = "The tax imposed by section 4081 shall not apply to diesel fuel and kerosene—")
rule DyedFuelExemptFromNonLustTax(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and secretary_determines_destined_for_nontaxable_use(e)
        and fuel_indelibly_dyed_by_mechanical_injection(e)
        and fuel_meets_marking_requirements_if_any(e);
    then dyed_fuel_exempt_from_non_lust_tax(e);
}
@source(IRC_S4082_F, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to the tax imposed under section 4081 at the Leaking Underground Storage Tank Trust Fund financing rate.")
rule DyedFuelLustOnlyTax(e: TaxableFuelEvent, gallons: Decimal, on: Date) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, gallons, on, _)
        and dyed_fuel_exempt_from_non_lust_tax(e)
        and on >= @1997-10-01 and on < @2028-10-01
        and not_known(dyed_fuel_supplies_or_export_determined(e));
    then dyed_fuel_lust_only_tax_due(e, round(LustFinancingRatePerGallon * gallons, 4, "HALF_UP"));
}
@source(IRC_S4082_F, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to the tax imposed under section 4081 at the Leaking Underground Storage Tank Trust Fund financing rate.")
rule DyedFuelLustLiability(e: TaxableFuelEvent, responsible: Person, amount: Money) defeasible {
    when taxable_fuel_event(e, _, _, _, _, responsible) and dyed_fuel_lust_only_tax_due(e, amount);
    then liable_for_excise(responsible, e, amount);
}

@source(IRC_S4083_A, relation = formalizes, coverage = exact, quote = "The term \"taxable fuel\" means—")
rule TaxableFuelClassification(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, _, _, _, _, _);
    then section_4083_taxable_fuel(e);
}

const TaxCourt: Organ = us.irc.core::TaxCourt;

// =====================================================================
// Section 4103 — liability of officers who willfully fail to pay
// Section 4105 — two-party exchanges
// =====================================================================

external judgment relation willful_failure_to_pay_4081_or_4041a1(taxpayer: Person, e: TaxableFuelEvent) {
    authority TaxCourt;
    label en official "section 4103: there is a willful failure to pay the tax imposed by section 4041(a)(1) or 4081 (DECISION-0194: willfulness is an evaluative element, decided by the court when the question is litigated)";
}
pub relation under_duty_to_assure_payment(p: Person, taxpayer: Person) kind empirical {
    label en official "section 4103(1): p is an officer, employee or agent of the taxpayer who is under a duty to assure payment of the tax";
}
pub relation willfully_fails_to_perform_duty_to_assure_payment(p: Person, taxpayer: Person, e: TaxableFuelEvent) kind empirical {
    label en official "section 4103(1): p willfully fails to perform that duty";
}
pub relation willfully_causes_taxpayer_failure_to_pay(p: Person, taxpayer: Person, e: TaxableFuelEvent) kind empirical {
    label en official "section 4103(2): p willfully causes the taxpayer to fail to pay the tax";
}
pub relation jointly_and_severally_liable_for_fuel_tax(p: Person, taxpayer: Person, e: TaxableFuelEvent, amount: Money) kind institutional {
    label en official "section 4103: p is jointly and severally liable with the taxpayer for the tax to which the failure relates";
}

@source(IRC_S4103, relation = formalizes, coverage = exact, quote = "shall be jointly and severally liable with the taxpayer for the tax to which such failure relates.")
rule OfficerLiabilityFailedToPerformDuty(p: Person, taxpayer: Person, e: TaxableFuelEvent, amount: Money) defeasible {
    when willful_failure_to_pay_4081_or_4041a1(taxpayer, e)
        and under_duty_to_assure_payment(p, taxpayer)
        and willfully_fails_to_perform_duty_to_assure_payment(p, taxpayer, e)
        and excise_tax_due(e, amount);
    then jointly_and_severally_liable_for_fuel_tax(p, taxpayer, e, amount);
}
@source(IRC_S4103, relation = formalizes, coverage = exact, quote = "(2) who willfully causes the taxpayer to fail to pay such tax,")
rule OfficerLiabilityCausedFailure(p: Person, taxpayer: Person, e: TaxableFuelEvent, amount: Money) defeasible {
    when willful_failure_to_pay_4081_or_4041a1(taxpayer, e)
        and willfully_causes_taxpayer_failure_to_pay(p, taxpayer, e)
        and excise_tax_due(e, amount);
    then jointly_and_severally_liable_for_fuel_tax(p, taxpayer, e, amount);
}

pub relation two_party_exchange_from_registrant_with_inventory_position(e: TaxableFuelEvent) kind empirical {
    label en official "section 4105(b)(1): the transaction (other than a sale) transfers taxable fuel from a delivering person registered as a taxable fuel registrant who holds the terminal inventory position, as reflected in the terminal operator's records";
}
pub relation two_party_exchange_before_or_with_rack_removal(e: TaxableFuelEvent) kind empirical {
    label en official "section 4105(b)(2): the exchange occurs before or contemporaneous with completion of removal across the rack by the receiving person";
}
pub relation terminal_operator_treats_receiver_as_remover(e: TaxableFuelEvent) kind empirical {
    label en official "section 4105(b)(3): the terminal operator in its books and records treats the receiving person as the person that removes the product across the rack";
}
pub relation two_party_exchange_under_written_contract(e: TaxableFuelEvent) kind empirical {
    label en official "section 4105(b)(4): the transaction is the subject of a written contract";
}
pub relation two_party_exchange(e: TaxableFuelEvent) kind institutional {
    label en official "section 4105(b): a two-party exchange (all four conditions hold)";
}
pub relation delivering_person_not_liable_in_two_party_exchange(e: TaxableFuelEvent) kind institutional {
    label en official "section 4105(a): in a two-party exchange the delivering person is not liable for the tax under section 4081(a)(1)(A)(ii)";
}

@source(IRC_S4105_B, relation = formalizes, coverage = exact, quote = "The term \"two-party exchange\" means a transaction, other than a sale")
rule TwoPartyExchangeClassification(e: TaxableFuelEvent) strict {
    when two_party_exchange_from_registrant_with_inventory_position(e)
        and two_party_exchange_before_or_with_rack_removal(e)
        and terminal_operator_treats_receiver_as_remover(e)
        and two_party_exchange_under_written_contract(e);
    then two_party_exchange(e);
}
@source(IRC_S4105_A, relation = formalizes, coverage = exact, quote = "In a two-party exchange, the delivering person shall not be liable for the tax imposed under section 4081(a)(1)(A)(ii).")
rule DeliveringPersonNotLiableInTwoPartyExchange(e: TaxableFuelEvent) strict {
    when two_party_exchange(e);
    then delivering_person_not_liable_in_two_party_exchange(e);
}

// --- section 4041(b)(2)(A)(ii), (d)(1): the LUST add-on for qualified methanol or ethanol fuel is 0.05 cent ---
pub relation qualified_alcohol_fuel_lust_add_on_tax_due(e: AlcoholFuelEvent, amount: Money) kind institutional {
    label en official "section 4041(b)(2)(A)(ii): subsection (d)(1) is applied by substituting 0.05 cent for 0.1 cent for the sales and uses to which the blender reduction applies";
}
@source(IRC_S4041_B, relation = formalizes, coverage = exact, quote = "(ii) subsection (d)(1) shall be applied by substituting \"0.05 cent\" for \"0.1 cent\" with respect to the sales and uses to which clause (i) applies.")
rule QualifiedAlcoholFuelLustAddOn(e: AlcoholFuelEvent, gallons: Decimal, on: Date, reduction: Money) strict {
    when alcohol_fuel_event(e, _, _, gallons, on, _) and qualified_alcohol_fuel_rate_reduction(e, reduction) and on < @2009-01-01;
    then qualified_alcohol_fuel_lust_add_on_tax_due(e, round(S4041dQualifiedAlcoholLustRatePerGallon * gallons, 4, "HALF_UP"));
}
// section 4083(d)(2): inspection sites
pub relation secretary_establishes_inspection_site(x: Organ, site: Person) kind empirical {
    label en official "section 4083(d)(2): the Secretary establishes an inspection site for carrying out the authority to detain containers";
}
@source(IRC_S4083_D, relation = formalizes, coverage = exact, quote = "The Secretary may establish inspection sites for purposes of carrying out the Secretary's authority under paragraph (1)(B).")
rule Section4083d2InspectionSitesLibertyRule(site: Person) strict {
    when secretary_establishes_inspection_site(Secretary, site);
    then liberty EstablishFuelInspectionSites {
        holder Secretary;
        action secretary_establishes_inspection_site(Secretary, site);
        window [-infinity, infinity];
    };
}
