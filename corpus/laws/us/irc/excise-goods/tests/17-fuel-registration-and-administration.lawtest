// Sections 4081(e), 4082(c)-(g), 4083(b)-(d), 4101-4104, 4042(c)(3), 4043(c)(2) scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4081E-01-DUPLICATED-TAX-REFUNDED-WHEN-ESTABLISHED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_fuel_event(entity_ref("urn:test:s4081e1#e"), DieselOrKerosene, RemovalFromTerminal, 1000.0, @2024-06-15, entity_ref("urn:test:s4081e1#r")) { origin case_input; }
        assert "f1": fuel_tax_paid_by(entity_ref("urn:test:s4081e1#e"), entity_ref("urn:test:s4081e1#p"), 243 USD) { origin case_input; }
        assert "f2": fuel_tax_refund_claim(entity_ref("urn:test:s4081e1#e"), entity_ref("urn:test:s4081e1#p")) { origin case_input; }
        assert "f3": prior_tax_established_to_secretary_satisfaction_4081e(entity_ref("urn:test:s4081e1#e")) { origin case_input; }
    }
    evaluate truth(fuel_tax_refunded_without_interest(entity_ref("urn:test:s4081e1#e"), entity_ref("urn:test:s4081e1#p"), 243 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

