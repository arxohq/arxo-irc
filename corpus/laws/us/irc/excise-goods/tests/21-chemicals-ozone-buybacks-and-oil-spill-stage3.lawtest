test "S4662A4-02-GAS-TON-FROM-CUBIC-FEET" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": chemical_gas_sale_cubic_feet(entity_ref("urn:test:s4662a402gastonfromcubicfeet#e"), 6000.0) { origin case_input; }
        assert "f1": gas_cubic_feet_equivalent_of_2000_pounds(entity_ref("urn:test:s4662a402gastonfromcubicfeet#e"), 12000.0) { origin case_input; }
    }
    // half a ton of the gas: 6,000 of 12,000 cubic feet per 2,000 pounds (the conversion factor is a case input)
    evaluate truth(chemical_quantity_tons(entity_ref("urn:test:s4662a402gastonfromcubicfeet#e"), 0.5));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
