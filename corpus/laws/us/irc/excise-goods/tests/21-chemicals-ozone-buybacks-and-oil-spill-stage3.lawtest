        assert "f1": oil_spill_group_member(entity_ref("urn:test:s4612d06prioruseexhaustspaymentsnocredit#tp"), entity_ref("urn:test:s4612d06prioruseexhaustspaymentsnocredit#tp")) { origin case_input; }
        assert "f2": oil_spill_prepaid_fund_payment(entity_ref("urn:test:s4612d06prioruseexhaustspaymentsnocredit#tp"), TransAlaskaPipelineLiabilityFundTransferred, @1986-06-01, 100000.00 USD) { origin case_input; }
        assert "f3": oil_spill_credit_taken_into_account_in_period(entity_ref("urn:test:s4612d06prioruseexhaustspaymentsnocredit#tp"), 1, 100000.00 USD) { origin case_input; }
