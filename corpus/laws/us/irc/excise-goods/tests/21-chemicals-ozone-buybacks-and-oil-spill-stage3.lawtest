        assert "f3": oil_spill_prepaid_fund_payment(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), DeepwaterPortLiabilityTrustFund, @1985-06-01, 500000.00 USD) { origin case_input; }
        assert "f4": oil_spill_prepaid_fund_payment(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#m2"), OffshoreOilPollutionCompensationFund, @1986-03-01, 300000.00 USD) { origin case_input; }
        assert "f5": oil_spill_prepaid_fund_payment(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), DeepwaterPortLiabilityTrustFund, @1987-02-01, 200000.00 USD) { origin case_input; }
        assert "f6": oil_spill_prepaid_fund_payment(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#m3"), DeepwaterPortLiabilityTrustFund, @1985-06-01, 100000.00 USD) { origin case_input; }
        assert "f7": oil_spill_prepaid_fund_interest_accrued_before_1987(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), 40000.00 USD) { origin case_input; }
        assert "f8": oil_spill_credit_taken_into_account_in_period(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), 1, 100000.00 USD) { origin case_input; }
        assert "f9": oil_spill_credit_taken_into_account_in_period(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), 2, 200000.00 USD) { origin case_input; }
        assert "f10": oil_spill_credit_taken_into_account_in_period(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), 3, 999.00 USD) { origin case_input; }
        assert "f11": oil_spill_credit_taken_into_account_in_period(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#tp"), 4, 888.00 USD) { origin case_input; }
    }
    // pre-1987 payments of the two group members 800,000 + interest 40,000; the 1987 payment and the non-member are out; prior periods 1 and 2 = 300,000
    evaluate truth(oil_spill_credit_ledger_amounts(entity_ref("urn:test:s4612d03ledgersumsaffiliatedgrouppayment#e"), 840000.00 USD, 300000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
