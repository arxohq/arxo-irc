// Sections 4251 and 4261(a)-(c) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4251-01-COMMUNICATIONS-3-PERCENT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": communications_payment(entity_ref("urn:test:s4251:e1#e"), 100 USD, entity_ref("urn:test:s4251:e1#payer")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4251:e1#e"), 3.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4261-01-DOMESTIC-PERCENTAGE-PLUS-SEGMENT-FEE" {
    given {
        context {
            legal_time @2025-06-15;
            decision_time @2025-06-15T09:00:00-05:00;
            knowledge_time @2025-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": domestic_air_transportation_payment(entity_ref("urn:test:s4261:e1#e"), 400 USD, entity_ref("urn:test:s4261:e1#payer")) { origin case_input; }
        assert "f1": domestic_segment(entity_ref("urn:test:s4261:e1#e"), 2.0, entity_ref("urn:test:s4261:e1#payer")) { origin case_input; }
        assert "f2": has_domestic_segment_fee(entity_ref("urn:test:s4261:e1#e")) { origin case_input; }
    }
    // 7.5% * 400 = 30.00; + 2 segments * $5.20 (Rev. Proc. 2024-40, calendar year 2025) = 10.40; total 40.40
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4261:e1#e"), 40.40 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4261-02-INTERNATIONAL-FACILITIES-CHARGE" {
    given {
        context {
            legal_time @2025-06-15;
            decision_time @2025-06-15T09:00:00-05:00;
            knowledge_time @2025-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": international_travel_payment(entity_ref("urn:test:s4261:e2#e"), 900 USD, entity_ref("urn:test:s4261:e2#payer"), true) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4261:e2#e"), 22.90 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4261-03-ALASKA-HAWAII-DEPARTURE-6-DOLLAR-RATE" {
    given {
        context {
            legal_time @2025-06-15;
            decision_time @2025-06-15T09:00:00-05:00;
            knowledge_time @2025-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": international_travel_payment(entity_ref("urn:test:s4261:e3#e"), 900 USD, entity_ref("urn:test:s4261:e3#payer"), true) { origin case_input; }
        assert "f1": international_travel_alaska_hawaii_departure(entity_ref("urn:test:s4261:e3#e")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4261:e3#e"), 11.40 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
