test "S4064-01-GAS-GUZZLER-AT-BOUNDARY-13-5-MPG" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gas_guzzler_sale(entity_ref("urn:test:s4064:e1#e"), 13.5, entity_ref("urn:test:s4064:e1#mfr")) { origin case_input; }
    }
    // "at least 13.5 but less than 14.5" band: $5,400
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4064:e1#e"), 5400 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4064-02-EMERGENCY-VEHICLE-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": gas_guzzler_sale(entity_ref("urn:test:s4064:e2#e"), 10.0, entity_ref("urn:test:s4064:e2#mfr")) { origin case_input; }
        assert "f1": automobile_is_emergency_or_exempt_vehicle(entity_ref("urn:test:s4064:e2#e")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4064:e2#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4071-01-ORDINARY-TIRE-OVER-3500-POUNDS" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tire_sale(entity_ref("urn:test:s4071:e1#e"), OrdinaryTire, 4200.0, entity_ref("urn:test:s4071:e1#seller")) { origin case_input; }
    }
    // excess = 4200-3500 = 700, ceil(700/10 units of 10 lb) = 70 units * 9.45c = $6.615 -> $6.62 (HALF_UP)
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4071:e1#e"), 6.62 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4071-02-BIASPLY-TIRE-HALF-RATE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tire_sale(entity_ref("urn:test:s4071:e2#e"), BiasplyOrSuperSingleTire, 4200.0, entity_ref("urn:test:s4071:e2#seller")) { origin case_input; }
    }
    // 70 units * 4.725c = $3.3075 -> $3.31 (HALF_UP)
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4071:e2#e"), 3.31 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4071-03-TERMINATED-AFTER-OCT-2028" {
    given {
        context {
            legal_time @2029-01-01;
            decision_time @2029-01-01T09:00:00-05:00;
            knowledge_time @2029-01-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": tire_sale(entity_ref("urn:test:s4071:e3#e"), OrdinaryTire, 4200.0, entity_ref("urn:test:s4071:e3#seller")) { origin case_input; }
        assert "f1": tire_sold_on(entity_ref("urn:test:s4071:e3#e"), @2029-01-01) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4071:e3#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
