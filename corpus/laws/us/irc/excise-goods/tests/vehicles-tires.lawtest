// Sections 4051(a)-(c), 4064, 4071(a)-(d) scenarios. NOT EXECUTED
// (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4051-01-TRUCK-CHASSIS-AT-33001-POUNDS-TAXABLE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": retail_truck_sale(entity_ref("urn:test:s4051:e1#e"), AutomobileTruckChassis, 100000 USD, @2024-06-15, entity_ref("urn:test:s4051:e1#seller")) { origin case_input; }
        assert "f1": truck_gross_vehicle_weight_pounds(entity_ref("urn:test:s4051:e1#e"), 33001.0) { origin case_input; }
    }
    // over the 33,000-pound threshold: 12% of $100,000 = $12,000
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4051:e1#e"), 12000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4051-02-TRUCK-CHASSIS-AT-33000-POUNDS-EXCLUDED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": retail_truck_sale(entity_ref("urn:test:s4051:e2#e"), AutomobileTruckChassis, 100000 USD, @2024-06-15, entity_ref("urn:test:s4051:e2#seller")) { origin case_input; }
        assert "f1": truck_gross_vehicle_weight_pounds(entity_ref("urn:test:s4051:e2#e"), 33000.0) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4051:e2#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

