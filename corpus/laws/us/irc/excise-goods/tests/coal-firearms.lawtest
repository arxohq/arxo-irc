// Sections 4121 and 4181 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4121-01-UNDERGROUND-COAL-PER-TON-BELOW-CAP" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": coal_sale(entity_ref("urn:test:s4121:e1#e"), UndergroundMine, 100.0, 50 USD, entity_ref("urn:test:s4121:e1#producer")) { origin case_input; }
    }
    // per-ton: 1.10*100 = 110; cap: 4.4%*50*100 = 220; lesser = 110
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4121:e1#e"), 110.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4121-02-UNDERGROUND-COAL-CAP-BINDS-AT-LOW-PRICE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": coal_sale(entity_ref("urn:test:s4121:e2#e"), UndergroundMine, 100.0, 10 USD, entity_ref("urn:test:s4121:e2#producer")) { origin case_input; }
    }
    // per-ton: 1.10*100 = 110; cap: 4.4%*10*100 = 44; lesser = 44 (cap binds)
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4121:e2#e"), 44.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4121-03-LIGNITE-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": coal_sale(entity_ref("urn:test:s4121:e3#e"), SurfaceMine, 100.0, 50 USD, entity_ref("urn:test:s4121:e3#producer")) { origin case_input; }
        assert "f1": coal_is_lignite(entity_ref("urn:test:s4121:e3#e")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4121:e3#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

