        assert "f1": rate_in_effect_on(@2024-07-01, 0.12) { origin case_input; }
        assert "f2": installment_accounts_sold_or_disposed(entity_ref("urn:test:s4216d02returnedaccountcreditkeepssectio#s")) { origin case_input; }
        assert "f3": installment_payment_after_sale_of_account(entity_ref("urn:test:s4216d02returnedaccountcreditkeepssectio#i"), entity_ref("urn:test:s4216d02returnedaccountcreditkeepssectio#s")) { origin case_input; }
        assert "f4": installment_payment_on_returned_account_credit_6416b5(entity_ref("urn:test:s4216d02returnedaccountcreditkeepssectio#i")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4216d02returnedaccountcreditkeepssectio#i"), 12.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
