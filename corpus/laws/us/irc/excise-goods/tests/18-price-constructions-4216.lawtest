        assert "f1": local_advertising_sale_ledger(entity_ref("urn:test:s4216e201quarter2aggregateexceedsfiveper#i2"), entity_ref("urn:test:s4216e201quarter2aggregateexceedsfiveper#m"), 4051, 2024, 2, 2000.00 USD, 100.00 USD) { origin case_input; }
