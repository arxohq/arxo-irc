        assert "f5": local_advertising_charge(entity_ref("urn:test:s4216e101localadvertisingchargeexcludedu#a"), 50.00 USD) { origin case_input; }
        assert "f6": local_advertising_charge_is_separate_charge_made_when_sold(entity_ref("urn:test:s4216e101localadvertisingchargeexcludedu#a")) { origin case_input; }
        assert "f7": local_advertising_charge_intended_to_be_refunded(entity_ref("urn:test:s4216e101localadvertisingchargeexcludedu#a")) { origin case_input; }
    }
    // price without the charge 1,000; 5 percent = 50; the whole 50 charge is excluded
    evaluate truth(s4216_sale_price(entity_ref("urn:test:s4216e101localadvertisingchargeexcludedu#a"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
