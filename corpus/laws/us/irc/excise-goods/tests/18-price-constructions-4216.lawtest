// Stage 3: section 4216(b), (d), (e) scenarios. NOT EXECUTED (implemented_unverified): written from the pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4216B2-01-SPECIAL-RULE-HIGHEST-WHOLESALE-PRICE-IS-LOWER" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": sale_amount_charged(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a"), 1000.00 USD) { origin case_input; }
        assert "f1": container_and_packing_charge(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a"), 0.00 USD) { origin case_input; }
        assert "f2": article_sold_at_retail_or_to_retailer_4216(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a")) { origin case_input; }
        assert "f3": manufacturer_regularly_sells_at_retail_or_to_retailers(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a")) { origin case_input; }
        assert "f4": manufacturer_regularly_sells_to_wholesale_distributors_at_arms_length(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a")) { origin case_input; }
        assert "f5": manufacturer_establishes_prices_without_regard_to_tax_benefit(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a")) { origin case_input; }
        assert "f6": transaction_is_arms_length_4216(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a")) { origin case_input; }
        assert "f7": highest_price_to_wholesale_distributors_other_than_special_dealers(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a"), 900.00 USD) { origin case_input; }
    }
    // lower of the price sold (1,000) and the highest wholesale price (900)
    evaluate truth(constructive_sale_price(entity_ref("urn:test:s4216b201specialrulehighestwholesalepric#a"), 900.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
