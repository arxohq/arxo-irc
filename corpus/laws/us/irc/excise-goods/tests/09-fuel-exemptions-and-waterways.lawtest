// Sections 4041(b)-(m), 4042, 4043, 4082, 4083, 4103, 4105 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4041B-01-OFF-HIGHWAY-USE-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": special_motor_fuel_event(entity_ref("urn:test:s4041b1#e"), SoldToOperatorForFuelUse, DieselPoweredHighwayVehicleOrTrain, 1000.0, @2024-06-15, entity_ref("urn:test:s4041b1#r")) { origin case_input; }
        assert "f1": off_highway_business_use(entity_ref("urn:test:s4041b1#e")) { origin case_input; }
    }
    // section 4041(b)(1)(A)
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4041b1#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4041B-02-OFF-HIGHWAY-USE-IN-DIESEL-TRAIN-NOT-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": special_motor_fuel_event(entity_ref("urn:test:s4041b2#e"), SoldToOperatorForFuelUse, DieselPoweredHighwayVehicleOrTrain, 1000.0, @2024-06-15, entity_ref("urn:test:s4041b2#r")) { origin case_input; }
        assert "f1": off_highway_business_use(entity_ref("urn:test:s4041b2#e")) { origin case_input; }
        assert "f2": fuel_train(entity_ref("urn:test:s4041b2#e")) { origin case_input; }
    }
    // section 4041(b)(1)(C): a use in a diesel-powered train is not an off-highway business use for (a)(1); nothing else exempts it
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4041b2#e")));
    expect truth_status == NEITHER;
}

