            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": taxable_fuel_event(entity_ref("urn:test:s4105b#e"), DieselOrKerosene, RemovalFromTerminal, 1000.0, @2024-06-15, entity_ref("urn:test:s4105b#r")) { origin case_input; }
        assert "f1": two_party_exchange_from_registrant_with_inventory_position(entity_ref("urn:test:s4105b#e")) { origin case_input; }
        assert "f2": two_party_exchange_before_or_with_rack_removal(entity_ref("urn:test:s4105b#e")) { origin case_input; }
        assert "f3": terminal_operator_treats_receiver_as_remover(entity_ref("urn:test:s4105b#e")) { origin case_input; }
    }
    evaluate truth(two_party_exchange(entity_ref("urn:test:s4105b#e")));
    expect truth_status == NEITHER;
}

test "S4041B2-04-QUALIFIED-ALCOHOL-FUEL-LUST-ADD-ON-0-05-CENT" {
    given {
        context {
            legal_time @1999-06-15;
            decision_time @1999-06-15T09:00:00-05:00;
            knowledge_time @1999-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": alcohol_fuel_event(entity_ref("urn:test:s4041b2d#e"), ProducedFromCoalOrPeat, 0.85, 1000.0, @1999-06-15, entity_ref("urn:test:s4041b2d#r")) { origin case_input; }
        assert "f1": alcohol_includes_ethanol(entity_ref("urn:test:s4041b2d#e")) { origin case_input; }
    }
    // 0.05 cent x 1000 gallons
    evaluate truth(qualified_alcohol_fuel_lust_add_on_tax_due(entity_ref("urn:test:s4041b2d#e"), 0.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

