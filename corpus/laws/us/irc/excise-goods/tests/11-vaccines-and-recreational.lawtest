// Sections 4131, 4132, 4161, 4162 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4131-01-DPT-DOSE-SUMS-THREE-COMPONENTS" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vaccine_sale(entity_ref("urn:test:s4131a#e"), @2024-06-15, entity_ref("urn:test:s4131a#m")) { origin case_input; }
        assert "f1": vaccine_component_doses(entity_ref("urn:test:s4131a#e"), DiphtheriaToxoid, 1.0) { origin case_input; }
        assert "f2": vaccine_component_doses(entity_ref("urn:test:s4131a#e"), TetanusToxoid, 1.0) { origin case_input; }
        assert "f3": vaccine_component_doses(entity_ref("urn:test:s4131a#e"), PertussisBacteriaOrAntigens, 1.0) { origin case_input; }
        assert "f4": vaccine_substance_designed_for_human_disease_prevention(entity_ref("urn:test:s4131a#e")) { origin case_input; }
        assert "f5": vaccine_manufactured_in_or_entered_into_united_states(entity_ref("urn:test:s4131a#e")) { origin case_input; }
    }
    // section 4131(b)(2): the amounts for each subparagraph of 4132(a)(1) that describes the vaccine
    evaluate truth(vaccine_total_component_doses(entity_ref("urn:test:s4131a#e"), 3.0));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

