test "S4161B-05-ARROW-SHAFT-TAX-2024-INDEXED-VALUE-NOT-PINNED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": archery_sale(entity_ref("urn:test:s4161j#e"), ArrowShaft, 0 USD, 100.0, @2024-06-15, entity_ref("urn:test:s4161j#m")) { origin case_input; }
        assert "f1": arrow_shaft_first_sale(entity_ref("urn:test:s4161j#e")) { origin case_input; }
        assert "f2": arrow_measures_18_inches_or_more(entity_ref("urn:test:s4161j#e")) { origin case_input; }
    }
    // calendar years after 2005: 39 cents plus the section 1(f)(3) adjustment, not pinned: MISSING_PARAMETER_VALUE, never the unindexed 39 cents
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4161j#e"), 39.00 USD));
    expect truth_status == NEITHER;
}

