test "S4132B-01-CLAIM-WITHIN-SIX-MONTHS-ABATED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": vaccine_sale(entity_ref("urn:test:s4132c#e"), @2024-06-15, entity_ref("urn:test:s4132c#m")) { origin case_input; }
        assert "f1": vaccine_tax_paid(entity_ref("urn:test:s4132c#e"), entity_ref("urn:test:s4132c#p"), 2.25 USD) { origin case_input; }
        assert "f2": vaccine_returned_or_destroyed_on(entity_ref("urn:test:s4132c#e"), entity_ref("urn:test:s4132c#p"), @2024-03-01) { origin case_input; }
        assert "f3": vaccine_tax_repaid_or_purchaser_consent(entity_ref("urn:test:s4132c#e"), entity_ref("urn:test:s4132c#p")) { origin case_input; }
        assert "f4": vaccine_abatement_claim_filed_on(entity_ref("urn:test:s4132c#e"), entity_ref("urn:test:s4132c#p"), @2024-08-31) { origin case_input; }
    }
    // valid power: claim on Aug 31 is within 6 months after Mar 1 (deadline Sep 1)
    evaluate truth(vaccine_tax_abated_credited_or_refunded(entity_ref("urn:test:s4132c#e"), entity_ref("urn:test:s4132c#p"), 2.25 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

