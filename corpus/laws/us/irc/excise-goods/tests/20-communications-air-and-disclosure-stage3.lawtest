        }
        assert "f0": transportation_purchased_between_two_locations_on_specified_flights(entity_ref("urn:test:s4261b301reroutingsamepricekeepsoriginal#e")) { origin case_input; }
        assert "f1": route_change_between_the_two_locations(entity_ref("urn:test:s4261b301reroutingsamepricekeepsoriginal#e"), 2.0, 1.0) { origin case_input; }
        assert "f2": domestic_segment(entity_ref("urn:test:s4261b301reroutingsamepricekeepsoriginal#e"), 1.0, entity_ref("urn:test:s4261b301reroutingsamepricekeepsoriginal#p")) { origin case_input; }
    }
    // the segments fell from 2 to 1 but the amount charged did not change: the tax is determined without regard to the change
    evaluate truth(chargeable_domestic_segment_count(entity_ref("urn:test:s4261b301reroutingsamepricekeepsoriginal#e"), 2.0));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
