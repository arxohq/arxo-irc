test "S4221E1-01-RECIPROCITY-ADVISED-PRIVILEGE-ALLOWED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": article_sold_as_supplies_for_aircraft_registered_in_foreign_country(entity_ref("urn:test:s4221e101reciprocityadvisedprivilegeallo#e"), "Canada") { origin case_input; }
        assert "f1": commerce_advised_treasury_that_country_allows_reciprocal_privileges("Canada") { origin case_input; }
    }
    // the Secretary of Commerce advised the Treasury of a substantially reciprocal privilege (external judgment)
    evaluate truth(foreign_aircraft_supplies_privilege_allowed(entity_ref("urn:test:s4221e101reciprocityadvisedprivilegeallo#e"), "Canada"));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
