// Sections 4401 and 4461 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4401-01-AUTHORIZED-WAGER-QUARTER-PERCENT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wager_authorized_by_state(entity_ref("urn:test:s4401:e1#e")) { origin case_input; }
        assert "f1": wager_amount_charges_included(entity_ref("urn:test:s4401:e1#e"), 1000 USD) { origin case_input; }
        assert "f2": wager_accepted_by(entity_ref("urn:test:s4401:e1#e"), entity_ref("urn:test:s4401:e1#acceptor")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4401:e1#e"), 2.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4401-02-UNAUTHORIZED-WAGER-2-PERCENT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": wager_amount_charges_included(entity_ref("urn:test:s4401:e2#e"), 1000 USD) { origin case_input; }
        assert "f1": wager_accepted_by(entity_ref("urn:test:s4401:e2#e"), entity_ref("urn:test:s4401:e2#acceptor")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4401:e2#e"), 20.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4461-01-HARBOR-MAINTENANCE-IMPORTER-LIABLE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": port_use(entity_ref("urn:test:s4461:e1#e"), CargoEnteringUnitedStates, 100000 USD, @2024-06-15) { origin case_input; }
        assert "f1": port_use_importer(entity_ref("urn:test:s4461:e1#e"), entity_ref("urn:test:s4461:e1#importer")) { origin case_input; }
    }
    // 0.125% * 100000 = 125.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4461:e1#e"), 125.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
