            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": ozone_chemical_sale_or_use(entity_ref("urn:test:s4682x2#e"), "CFC–12", 0.5, 2024, entity_ref("urn:test:s4682x2#p")) { origin case_input; }
        assert "f1": ozone_chemical_manufactured_or_entered_in_united_states(entity_ref("urn:test:s4682x2#e")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4682x2#e"), 9.20 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4671A-01-IMPORTER-LIABLE-FOR-TAX-ON-SUBSTANCE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": imported_substance_sale_or_use(entity_ref("urn:test:s4671x#e"), "Cumene", 10000 USD, @2024-06-15, entity_ref("urn:test:s4671x#i")) { origin case_input; }
        assert "f1": initial_list_taxable_substance("Cumene", true) { origin case_input; }
    }
    evaluate truth(liable_for_excise(entity_ref("urn:test:s4671x#i"), entity_ref("urn:test:s4671x#e"), 1000.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
