        assert "f1": oil_spill_credit_prepaid_amounts(entity_ref("urn:test:s4612d#e"), 500 USD, 100 USD) { origin case_input; }
        assert "f2": oil_spill_rate_portion_of_tax(entity_ref("urn:test:s4612d#e"), 90 USD) { origin case_input; }
    }
    // excess 400 but only 90 of the tax is attributable to the oil spill rate
    evaluate truth(oil_spill_prepayment_credit(entity_ref("urn:test:s4612d#e"), 90.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

