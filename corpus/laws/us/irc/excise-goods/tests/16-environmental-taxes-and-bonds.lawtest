// Sections 4611(c)-(f), 4612, 4661-4662, 4671-4672, 4681-4682, 4701 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4611C3-01-2025-INDEXED-RATE-26-CENTS" {
    given {
        context {
            legal_time @2025-06-15;
            decision_time @2025-06-15T09:00:00-05:00;
            knowledge_time @2025-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": crude_oil_event(entity_ref("urn:test:s4611a#e"), CrudeOilReceivedAtRefinery, 1000.0, @2025-06-15, entity_ref("urn:test:s4611a#r")) { origin case_input; }
    }
    // Rev. Proc. 2024-40 section 2.46: $0.26 a barrel x 1000 barrels
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4611a#e"), 260.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

