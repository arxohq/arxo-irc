test "S4217B-01-PAYMENT-TAX-BELOW-TOTAL" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": lease_by_manufacturer_producer_or_importer(entity_ref("urn:test:s4217e#l")) { origin case_input; }
        assert "f1": lessor_also_sells_same_type_and_model_at_arms_length(entity_ref("urn:test:s4217e#l")) { origin case_input; }
        assert "f2": first_lease_under_4217b_is_first_lease_of_article(entity_ref("urn:test:s4217e#l")) { origin case_input; }
        assert "f3": constructive_sale_price_if_sold_at_retail_on_first_lease(entity_ref("urn:test:s4217e#l"), 100000 USD) { origin case_input; }
        assert "f4": applicable_rate_on_date_of_first_lease(entity_ref("urn:test:s4217e#l"), 0.12) { origin case_input; }
        assert "f5": lease_payment(entity_ref("urn:test:s4217e#pay"), entity_ref("urn:test:s4217e#l"), 5000 USD, @2024-06-15, 0.12) { origin case_input; }
        assert "f6": lease_tax_paid_on_prior_payments(entity_ref("urn:test:s4217e#pay"), 1000 USD) { origin case_input; }
    }
    // 5,000 x 12% = 600; 1,000 + 600 <= 12,000
    evaluate truth(lease_payment_tax(entity_ref("urn:test:s4217e#pay"), 600.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

