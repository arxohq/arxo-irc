            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": purchased_for_exclusive_use_of_united_states(entity_ref("urn:test:s4293c#e")) { origin case_input; }
        assert "f1": secretary_determines_substantial_burden_avoidable_by_exemption(entity_ref("urn:test:s4293c#e")) { origin case_input; }
        assert "f2": secretary_authorizes_united_states_exemption(entity_ref("urn:test:s4293c#e")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4293c#e")));
    expect truth_status == NEITHER;
}

test "S4182A-02-PL-119-21-NON-MACHINEGUN-FIREARM-DEEMED-TAXED-FROM-2026" {
    given {
        context {
            legal_time @2026-01-01;
            decision_time @2026-01-01T09:00:00-05:00;
            knowledge_time @2026-01-01T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": firearm_sale(entity_ref("urn:test:s4182g#e"), OtherFirearm, 500 USD, entity_ref("urn:test:s4182g#s")) { origin case_input; }
        assert "f1": firearm_described_in_5811a2(entity_ref("urn:test:s4182g#e")) { origin case_input; }
        assert "f2": firearm_sale_date(entity_ref("urn:test:s4182g#e"), @2026-01-01) { origin case_input; }
    }
    // calendar quarters beginning more than 90 days after July 4, 2025: first is Jan 1, 2026
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4182g#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4182A-03-PL-119-21-BEFORE-2026-NOT-DEEMED-TAXED" {
    given {
        context {
            legal_time @2025-12-31;
            decision_time @2025-12-31T09:00:00-05:00;
            knowledge_time @2025-12-31T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": firearm_sale(entity_ref("urn:test:s4182h#e"), OtherFirearm, 500 USD, entity_ref("urn:test:s4182h#s")) { origin case_input; }
        assert "f1": firearm_described_in_5811a2(entity_ref("urn:test:s4182h#e")) { origin case_input; }
        assert "f2": firearm_sale_date(entity_ref("urn:test:s4182h#e"), @2025-12-31) { origin case_input; }
    }
    // the quarter beginning Oct 1, 2025 is only 89 days after enactment
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4182h#e")));
    expect truth_status == NEITHER;
}

