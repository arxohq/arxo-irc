        }
        assert "f0": manufacturer_of_event(entity_ref("urn:test:s4222b#e"), entity_ref("urn:test:s4222b#m")) { origin case_input; }
        assert "f1": first_purchaser_of_event(entity_ref("urn:test:s4222b#e"), entity_ref("urn:test:s4222b#p1")) { origin case_input; }
        assert "f2": registered_under_4222(entity_ref("urn:test:s4222b#m")) { origin case_input; }
    }
    // section 4222(a): section 4221 does not apply unless all are registered
    evaluate truth(registration_satisfied_for_4221(entity_ref("urn:test:s4222b#e")));
    expect truth_status == NEITHER;
}

