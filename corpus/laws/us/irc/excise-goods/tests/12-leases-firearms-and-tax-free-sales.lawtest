// Sections 4182, 4217-4219, 4222-4225, 4293 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4222A-01-MANUFACTURER-AND-FIRST-PURCHASER-REGISTERED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": manufacturer_of_event(entity_ref("urn:test:s4222a#e"), entity_ref("urn:test:s4222a#m")) { origin case_input; }
        assert "f1": first_purchaser_of_event(entity_ref("urn:test:s4222a#e"), entity_ref("urn:test:s4222a#p1")) { origin case_input; }
        assert "f2": registered_under_4222(entity_ref("urn:test:s4222a#m")) { origin case_input; }
        assert "f3": registered_under_4222(entity_ref("urn:test:s4222a#p1")) { origin case_input; }
    }
    evaluate truth(registration_satisfied_for_4221(entity_ref("urn:test:s4222a#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4222A-02-FIRST-PURCHASER-NOT-REGISTERED" {
    given {
        context {
            legal_time @2024-06-15;
