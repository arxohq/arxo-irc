// Sections 4216 and 4221 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4216-01-PRICE-EXCLUDES-ESTABLISHED-TRANSPORTATION-CHARGE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sale_amount_charged(entity_ref("urn:test:s4216:e1#a"), 1000 USD) { origin case_input; }
        assert "f1": container_and_packing_charge(entity_ref("urn:test:s4216:e1#a"), 50 USD) { origin case_input; }
        assert "f2": transportation_or_similar_charge(entity_ref("urn:test:s4216:e1#a"), 75 USD) { origin case_input; }
        assert "f3": s4216_charge_established_to_secretary_satisfaction(entity_ref("urn:test:s4216:e1#a")) { origin adjudicated; }
    }
    evaluate truth(price_for_tax_purposes(entity_ref("urn:test:s4216:e1#a"), 1050 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

