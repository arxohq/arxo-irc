}

test "S4221-01-EXPORT-BEFORE-ANY-OTHER-USE-TAX-FREE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sold_for_tax_free_use(entity_ref("urn:test:s4221:e1#e"), Export) { origin case_input; }
        assert "f1": exportation_or_use_occurs_before_any_other_use(entity_ref("urn:test:s4221:e1#e")) { origin case_input; }
        // stage 2: section 4222(a) requires the manufacturer and the first purchaser to be registered
        assert "f2": manufacturer_of_event(entity_ref("urn:test:s4221:e1#e"), entity_ref("urn:test:s4221:e1#m")) { origin case_input; }
        assert "f3": first_purchaser_of_event(entity_ref("urn:test:s4221:e1#e"), entity_ref("urn:test:s4221:e1#p1")) { origin case_input; }
        assert "f4": registered_under_4222(entity_ref("urn:test:s4221:e1#m")) { origin case_input; }
        assert "f5": registered_under_4222(entity_ref("urn:test:s4221:e1#p1")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4221:e1#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4221-02-GAS-GUZZLER-STATE-USE-CARVEOUT-NOT-TAX-FREE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": excise_event_taxed_under_section(entity_ref("urn:test:s4221:e2#e"), 4064) { origin case_input; }
        assert "f1": sold_for_tax_free_use(entity_ref("urn:test:s4221:e2#e"), StateOrLocalGovernmentExclusiveUse) { origin case_input; }
        assert "f2": exportation_or_use_occurs_before_any_other_use(entity_ref("urn:test:s4221:e2#e")) { origin case_input; }
    }
    // section 4221(a) flush language: paragraph (4) does not apply to section 4064
    evaluate truth(s4221_carveout_applies(entity_ref("urn:test:s4221:e2#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4221-03-PROOF-NOT-RECEIVED-REINSTATES-TAX" {
    given {
        context {
            legal_time @2025-03-01;
            decision_time @2025-03-01T09:00:00-05:00;
            knowledge_time @2025-03-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": sold_for_tax_free_use(entity_ref("urn:test:s4221:e3#e"), Export) { origin case_input; }
        assert "f1": excise_event_sale_date(entity_ref("urn:test:s4221:e3#e"), @2024-06-15) { origin case_input; }
    }
    // no manufacturer_received_proof_by fact asserted within the 6-month window
    evaluate truth(s4221_carveout_applies(entity_ref("urn:test:s4221:e3#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
