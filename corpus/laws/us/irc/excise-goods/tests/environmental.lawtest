// Sections 4611(a)-(c) and 4661 scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4611-01-CRUDE-OIL-BEFORE-2017-RATE" {
    given {
        context {
            legal_time @2016-06-15;
            decision_time @2016-06-15T09:00:00-05:00;
            knowledge_time @2016-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": crude_oil_event(entity_ref("urn:test:s4611:e1#e"), CrudeOilReceivedAtRefinery, 1000.0, @2016-06-15, entity_ref("urn:test:s4611:e1#refiner")) { origin case_input; }
    }
    // (16.4 + 8) cents/barrel * 1000 = $244.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4611:e1#e"), 244.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4611-02-CRUDE-OIL-AFTER-2016-RATE-BEFORE-INDEXING" {
    given {
        context {
            legal_time @2023-06-15;
            decision_time @2023-06-15T09:00:00-05:00;
            knowledge_time @2023-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": crude_oil_event(entity_ref("urn:test:s4611:e2#e"), CrudeOilReceivedAtRefinery, 1000.0, @2023-06-15, entity_ref("urn:test:s4611:e2#refiner")) { origin case_input; }
    }
    // (16.4 + 9) cents/barrel * 1000 = $254.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4611:e2#e"), 254.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4611-03-ON-PREMISES-USE-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": crude_oil_event(entity_ref("urn:test:s4611:e3#e"), DomesticCrudeOilUsedOrExportedWithoutPriorTax, 500.0, @2024-06-15, entity_ref("urn:test:s4611:e3#producer")) { origin case_input; }
        assert "f1": crude_oil_used_on_premises_of_production(entity_ref("urn:test:s4611:e3#e")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4611:e3#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4661-01-BENZENE-TAX-PER-TON" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": chemical_sale(entity_ref("urn:test:s4661:e1#e"), "Benzene", 10.0, @2024-06-15, entity_ref("urn:test:s4661:e1#seller")) { origin case_input; }
    }
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4661:e1#e"), 97.40 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4661-02-TERMINATED-AFTER-2031" {
    given {
        context {
            legal_time @2032-01-15;
            decision_time @2032-01-15T09:00:00-05:00;
            knowledge_time @2032-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": chemical_sale(entity_ref("urn:test:s4661:e2#e"), "Benzene", 10.0, @2032-01-15, entity_ref("urn:test:s4661:e2#seller")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4661:e2#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
