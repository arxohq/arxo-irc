// Sections 4051(d), 4052, 4053, 4072, 4073 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4051D-01-TIRE-TAX-CREDITED-AGAINST-RETAIL-TAX" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": retail_truck_sale(entity_ref("urn:test:s4051d1#e"), AutomobileTruckChassis, 100000 USD, @2024-06-15, entity_ref("urn:test:s4051d1#s")) { origin case_input; }
        assert "f1": truck_gross_vehicle_weight_pounds(entity_ref("urn:test:s4051d1#e"), 40000.0) { origin case_input; }
        assert "f2": tire_sale(entity_ref("urn:test:s4051d1#t"), OrdinaryTire, 4500.0, entity_ref("urn:test:s4051d1#ts")) { origin case_input; }
        assert "f3": tires_sold_with_taxed_article(entity_ref("urn:test:s4051d1#e"), entity_ref("urn:test:s4051d1#t")) { origin case_input; }
    }
    // 12% x 100,000 = 12,000.00; tire tax = 100 units x $0.0945 = 9.45; net 11,990.55
    evaluate truth(retail_truck_tax_after_tire_credit(entity_ref("urn:test:s4051d1#e"), 11990.55 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

