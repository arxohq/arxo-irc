        assert "f1": truck_gross_vehicle_weight_pounds(entity_ref("urn:test:s4051d2#e"), 40000.0) { origin case_input; }
    }
    // the credit rule needs tires sold in connection with the article
    evaluate truth(retail_truck_tax_after_tire_credit(entity_ref("urn:test:s4051d2#e"), 12000.00 USD));
