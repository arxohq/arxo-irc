// Sections 4252-4254, 4261(d)-(k), 4262, 4263, 4271, 4272, 4281, 4282, 4291 scenarios (stage 2). NOT EXECUTED (implemented_unverified): written from the
// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4252B-01-TOLL-CHARGE-BY-DISTANCE-AND-TIME" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": service_toll_charge_varies_with_distance_and_elapsed_time(entity_ref("urn:test:s4252a#s")) { origin case_input; }
        assert "f1": toll_charge_paid_within_united_states(entity_ref("urn:test:s4252a#s")) { origin case_input; }
    }
    evaluate truth(toll_telephone_service(entity_ref("urn:test:s4252a#s")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

