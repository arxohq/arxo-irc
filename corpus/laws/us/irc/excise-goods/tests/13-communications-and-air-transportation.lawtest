test "S4253L-03-CHANGE-NOT-YET-REPORTED-DUTY-ACTIVE" {
    given {
        context {
            legal_time @2024-05-15;
            decision_time @2024-05-15T09:00:00-05:00;
            knowledge_time @2024-05-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": communications_payment(entity_ref("urn:test:s4253l#e"), 80 USD, entity_ref("urn:test:s4253l#p")) { origin case_input; }
        assert "f1": exemption_information_changed_on(entity_ref("urn:test:s4253l#e"), entity_ref("urn:test:s4253l#c"), @2024-05-01) { origin case_input; }
    }
    // the 30-day window (May 1 - May 31) is still open on the reading date
    evaluate positions();
    expect position(InformProviderOfChangedExemptionInformation, ACTIVE);
}

