test "S4481C1-01-FIRST-USE-IN-OCTOBER-NINE-MONTHS" {
    given {
        context {
            legal_time @2024-10-15;
            decision_time @2024-10-15T09:00:00-05:00;
            knowledge_time @2024-10-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
