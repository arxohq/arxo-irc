        assert "f1": highway_taxable_period_begins(entity_ref("urn:test:s4481c101firstuseinoctoberninemonths#e"), @2024-07-01) { origin case_input; }
        assert "f2": highway_dated_event(entity_ref("urn:test:s4481c101firstuseinoctoberninemonths#e"), FirstUseInPeriod, @2024-10-15) { origin case_input; }
    }
    // table amount 100 + 22 x 5 = 210; October is month index 3: 12 - 3 = 9 months; 210 x 9 / 12
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4481c101firstuseinoctoberninemonths#e"), 157.50 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
