// pinned text; expectations are what the statute says, not engine output.

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4402-01-PARIMUTUEL-WAGER-EXEMPT" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": wager_amount_charges_included(entity_ref("urn:test:s4402a#e"), 1000 USD) { origin case_input; }
        assert "f1": wager_placed_with_state_licensed_parimutuel_enterprise(entity_ref("urn:test:s4402a#e")) { origin case_input; }
    }
    evaluate truth(tax_free_sale(entity_ref("urn:test:s4402a#e")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

