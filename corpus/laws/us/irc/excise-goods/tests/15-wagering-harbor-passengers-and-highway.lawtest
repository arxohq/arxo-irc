            timezone "America/New_York";
            deadline_policy us.irc.core::IRC_CALENDAR_STEP;
        }
        assert "f0": highway_vehicle_use(entity_ref("urn:test:s4483o#e"), 60000.0, entity_ref("urn:test:s4483o#o")) { origin case_input; }
        assert "f1": highway_miles_used_in_taxable_period(entity_ref("urn:test:s4483o#e"), 3000.0) { origin case_input; }
        assert "f2": highway_tax_paid_by(entity_ref("urn:test:s4483o#e"), entity_ref("urn:test:s4483o#p"), 210 USD) { origin case_input; }
        assert "f3": highway_low_mileage_refund_claim_filed(entity_ref("urn:test:s4483o#e"), entity_ref("urn:test:s4483o#p")) { origin case_input; }
    }
    // invalid exercise: section 4483(d)(2)(C) information not furnished
    evaluate truth(highway_tax_credited_or_refunded(entity_ref("urn:test:s4483o#e"), entity_ref("urn:test:s4483o#p"), 210 USD));
    expect truth_status == NEITHER;
}

