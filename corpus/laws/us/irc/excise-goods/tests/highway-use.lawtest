// Section 4481(a)-(c) scenarios. NOT EXECUTED (implemented_unverified).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4481-01-AT-55000-POUNDS-BASE-AMOUNT" {
    given {
        context {
            legal_time @2024-07-01;
            decision_time @2024-07-01T09:00:00-05:00;
            knowledge_time @2024-07-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": highway_vehicle_use(entity_ref("urn:test:s4481:e1#e"), 55000.0, entity_ref("urn:test:s4481:e1#owner")) { origin case_input; }
    }
    evaluate truth(excise_tax_due_full_year(entity_ref("urn:test:s4481:e1#e"), 100.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4481-02-AT-56000-POUNDS-ONE-BAND-STEP" {
    given {
        context {
            legal_time @2024-07-01;
            decision_time @2024-07-01T09:00:00-05:00;
            knowledge_time @2024-07-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": highway_vehicle_use(entity_ref("urn:test:s4481:e2#e"), 56000.0, entity_ref("urn:test:s4481:e2#owner")) { origin case_input; }
    }
    // ceil((56000-55000)/1000) = 1 band * $22 + $100 = $122
    evaluate truth(excise_tax_due_full_year(entity_ref("urn:test:s4481:e2#e"), 122.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4481-03-OVER-75000-POUNDS-FLAT-550" {
    given {
        context {
            legal_time @2024-07-01;
            decision_time @2024-07-01T09:00:00-05:00;
            knowledge_time @2024-07-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": highway_vehicle_use(entity_ref("urn:test:s4481:e3#e"), 80000.0, entity_ref("urn:test:s4481:e3#owner")) { origin case_input; }
    }
    evaluate truth(excise_tax_due_full_year(entity_ref("urn:test:s4481:e3#e"), 550.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4481-04-PRORATED-SIX-MONTHS" {
    given {
        context {
            legal_time @2024-07-01;
            decision_time @2024-07-01T09:00:00-05:00;
            knowledge_time @2024-07-01T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": highway_vehicle_use(entity_ref("urn:test:s4481:e4#e"), 60000.0, entity_ref("urn:test:s4481:e4#owner")) { origin case_input; }
        assert "f1": highway_use_months_in_period(entity_ref("urn:test:s4481:e4#e"), 6.0) { origin case_input; }
    }
    // full-year: 100 + ceil(5000/1000)*22 = 100 + 110 = 210; prorated 6/12 = 105.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4481:e4#e"), 105.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
