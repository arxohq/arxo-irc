test "S4081-05-UNKNOWN-QUANTITY-UNDETERMINED" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_fuel_rate(entity_ref("urn:test:s4081:e5#e"), 0.183 USD) { origin case_input; }
    }
    // no `taxable_fuel_event` asserted -> gallons unknown -> tax amount NEITHER/UNDETERMINED
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4081:e5#e"), 0.00 USD));
    expect truth_status == NEITHER;
}
