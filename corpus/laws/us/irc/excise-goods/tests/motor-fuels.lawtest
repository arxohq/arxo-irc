// Sections 4041(a) and 4081(a)-(d) scenarios. NOT EXECUTED
// (implemented_unverified per AGENT-BRIEF; scenarios written from the
// pinned text, not from any engine run).

language "law.core" version "0.2";
package us.irc.excise_goods version "0.1.1";
namespace "urn:us:irc:excise_goods:clir";

test "S4081-01-GASOLINE-REMOVAL-FROM-REFINERY-WITH-LUST" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_fuel_event(entity_ref("urn:test:s4081:e1#e"), GasolineOtherThanAviation, RemovalFromRefinery, 1000.0, @2024-06-15, entity_ref("urn:test:s4081:e1#remover")) { origin case_input; }
    }
    // 18.3 + 0.1 (LUST) = 18.4 cents/gal * 1000 gal = $184.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4081:e1#e"), 184.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4081-02-DIESEL-WATER-EMULSION-SUBSTITUTED-RATE" {
    given {
        context {
            legal_time @2024-06-15;
            decision_time @2024-06-15T09:00:00-05:00;
            knowledge_time @2024-06-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_fuel_event(entity_ref("urn:test:s4081:e2#e"), DieselOrKerosene, RemovalFromTerminal, 500.0, @2024-06-15, entity_ref("urn:test:s4081:e2#remover")) { origin case_input; }
        assert "f1": diesel_water_fuel_emulsion(entity_ref("urn:test:s4081:e2#e")) { origin case_input; }
    }
    // 19.7 + 0.1 (LUST) = 19.8 cents/gal * 500 = $99.00
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4081:e2#e"), 99.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

test "S4081-03-BULK-TRANSFER-TO-REGISTERED-TERMINAL-TAX-FREE" {
    given {
        context {
