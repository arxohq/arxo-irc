}

test "S4081-04-GASOLINE-RATE-AFTER-2028-BOUNDARY" {
    given {
        context {
            legal_time @2029-01-15;
            decision_time @2029-01-15T09:00:00-05:00;
            knowledge_time @2029-01-15T09:00:00-05:00;
            timezone "America/New_York";
        }
        assert "f0": taxable_fuel_event(entity_ref("urn:test:s4081:e4#e"), GasolineOtherThanAviation, RemovalFromRefinery, 1000.0, @2029-01-15, entity_ref("urn:test:s4081:e4#remover")) { origin case_input; }
    }
    // after 2028-10-01: rate 4.3 cents, LUST no longer applies (window ended 2028-10-01)
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4081:e4#e"), 43.00 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

