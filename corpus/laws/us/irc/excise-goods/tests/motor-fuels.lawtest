        }
        assert "f0": special_motor_fuel_event(entity_ref("urn:test:s4041:e2#e"), SoldToOperatorForFuelUse, DieselPoweredHighwayVehicleOrTrain, 100.0, @2005-03-01, entity_ref("urn:test:s4041:e2#seller")) { origin case_input; }
        assert "f1": fuel_train(entity_ref("urn:test:s4041:e2#e")) { origin case_input; }
    }
    // 3.3 cents/gal * 100 = $3.30 (Dec 31 2004 - Jun 30 2005 window)
    evaluate truth(excise_tax_due(entity_ref("urn:test:s4041:e2#e"), 3.30 USD));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

