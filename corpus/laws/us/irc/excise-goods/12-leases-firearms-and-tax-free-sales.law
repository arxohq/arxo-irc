// Stage 2: section 4182 (firearms exemptions), sections 4217-4219 (leases,
// use by the manufacturer, sales by other than the manufacturer), sections
// 4222-4225 and 4227 (registration for tax-free sales, purchasing
// manufacturer, Indian handicrafts), section 4293 (exemption for the United
// States). Builds on 03-coal-firearms.law and 04-general-provisions.law.
//
// STAGE-2 CORRECTION TO STAGE 1. Section 4221(a) does not apply "unless the
// manufacturer, the first purchaser, and the second purchaser (if any) are
// all registered under this section" (section 4222(a)). Stage 1 modelled the
// tax-free classification without that condition. The classification rule in
// 04-general-provisions.law now also reads `registration_satisfied_for_4221`,
// defined here.

// =====================================================================
// Section 4222 — registration
// =====================================================================

use self::{
    ExciseEvent,
    FirearmArticleKind,
    FirearmSaleEvent,
    IRC_S4182_A,
    IRC_S4182_B,
    IRC_S4182_C,
    IRC_S4182_D,
    IRC_S4217_A,
    IRC_S4217_B,
    IRC_S4217_C,
    IRC_S4217_D,
    IRC_S4217_E,
    IRC_S4218_A,
    IRC_S4218_B,
    IRC_S4218_C,
    IRC_S4219,
    IRC_S4222_A,
    IRC_S4222_B,
    IRC_S4222_C,
    IRC_S4223_A,
    IRC_S4223_B,
    IRC_S4225,
    IRC_S4293,
    Lease,
    Person,
    Secretary,
    TireSaleEvent,
    excise_event_taxed_under_section,
    excise_tax_due,
    firearm_sale,
    liable_for_excise,
    manufacturer_of_event,
    tax_free_sale,
};

pub relation registered_under_4222(p: Person) kind empirical {
    label en official "section 4222(a): the person is registered under section 4222 (registration is made as the Secretary prescribes by regulations)";
}
pub relation first_purchaser_of_event(e: ExciseEvent, p: Person) kind empirical {
    label en official "section 4222(a): the first purchaser in the sale";
}
pub relation second_purchaser_of_event(e: ExciseEvent, p: Person) kind empirical {
    label en official "section 4222(a): the second purchaser (resale purchaser) in the sale, if any";
}
pub relation second_purchaser_present(e: ExciseEvent) kind empirical {
    label en official "section 4222(a): there is a second purchaser";
}
pub relation registration_denied_revoked_or_suspended(p: Person) kind institutional {
    label en official "section 4222(c): the registration of the person has been denied, revoked, or suspended";
}
pub relation party_effectively_registered(p: Person) kind institutional {
    label en official "section 4222(a), (c): registered and not denied, revoked, or suspended";
}
pub relation purchaser_state_or_local_government_with_exemption_certificate(e: ExciseEvent) kind empirical {
    label en official "section 4222(b)(1): the purchaser is a State or local government complying with the Secretary's regulations on exemption certificates in lieu of registration";
}
pub relation purchase_or_sale_by_united_states_outside_regulations(e: ExciseEvent) kind empirical {
    label en official "section 4222(b)(3): a purchase or sale by the United States that the Secretary's regulations do not subject to subsection (a)";
}
pub relation supplies_for_vessel_or_aircraft_with_exemption_certificate(e: ExciseEvent) kind empirical {
    label en official "section 4222(b)(5): a sale for use by the purchaser as supplies for a vessel or aircraft, the purchaser complying with the regulations on exemption certificates";
}
pub relation registration_requirement_relieved(e: ExciseEvent) kind institutional {
    label en official "section 4222(b)(2): the Secretary has relieved the purchaser or second purchaser, or both, from the requirement of registering";
}
pub relation s4222_exception_applies(e: ExciseEvent) kind institutional {
    label en official "section 4222(b): the registration requirement of subsection (a) does not apply to this sale";
}
pub relation registration_satisfied_for_4221(e: ExciseEvent) kind institutional {
    label en official "section 4222(a): the manufacturer, the first purchaser, and the second purchaser (if any) are all registered, or an exception of subsection (b) applies";
}

@source(IRC_S4222_C, relation = formalizes, coverage = exact, quote = "the registration of any person under this section may be denied, revoked, or suspended if the Secretary determines—")
rule PartyEffectivelyRegistered(p: Person) defeasible {
    when registered_under_4222(p) and not_known(registration_denied_revoked_or_suspended(p));
    then party_effectively_registered(p);
}

@source(IRC_S4222_A, relation = formalizes, coverage = exact, quote = "unless the manufacturer, the first purchaser, and the second purchaser (if any) are all registered under this section.")
rule RegistrationSatisfiedWithoutSecondPurchaser(e: ExciseEvent, m: Person, p1: Person) defeasible {
    when manufacturer_of_event(e, m)
        and first_purchaser_of_event(e, p1)
        and party_effectively_registered(m)
        and party_effectively_registered(p1)
        and not_known(second_purchaser_present(e));
    then registration_satisfied_for_4221(e);
}
@source(IRC_S4222_A, relation = formalizes, coverage = exact, quote = "unless the manufacturer, the first purchaser, and the second purchaser (if any) are all registered under this section.")
rule RegistrationSatisfiedWithSecondPurchaser(e: ExciseEvent, m: Person, p1: Person, p2: Person) defeasible {
    when manufacturer_of_event(e, m)
        and first_purchaser_of_event(e, p1)
        and second_purchaser_of_event(e, p2)
        and second_purchaser_present(e)
        and party_effectively_registered(m)
        and party_effectively_registered(p1)
        and party_effectively_registered(p2);
    then registration_satisfied_for_4221(e);
}
@source(IRC_S4222_B, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any State or local government in connection with the purchase by it of any article")
rule RegistrationExceptionStateOrLocal(e: ExciseEvent) strict {
    when purchaser_state_or_local_government_with_exemption_certificate(e);
    then s4222_exception_applies(e);
}
@source(IRC_S4222_B, relation = formalizes, coverage = partial, quote = "Subsection (a) shall apply to purchases and sales by the United States only to the extent provided by regulations prescribed by the Secretary.")
rule RegistrationExceptionUnitedStates(e: ExciseEvent) strict {
    when purchase_or_sale_by_united_states_outside_regulations(e);
    then s4222_exception_applies(e);
}
@source(IRC_S4222_B, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to a sale of an article for use by the purchaser as supplies for any vessel or aircraft")
rule RegistrationExceptionSupplies(e: ExciseEvent) strict {
    when supplies_for_vessel_or_aircraft_with_exemption_certificate(e);
    then s4222_exception_applies(e);
}
@source(IRC_S4222_B, relation = formalizes, coverage = exact, quote = "the Secretary may relieve the purchaser or the second purchaser, or both, from the requirement of registering under this section.")
rule RegistrationExceptionSecretaryRelief(e: ExciseEvent) defeasible {
    when registration_requirement_relieved(e);
    then s4222_exception_applies(e);
}
@source(IRC_S4222_B, relation = formalizes, coverage = exact, quote = "Subsection (a) shall not apply to any State or local government in connection with the purchase by it of any article")
rule RegistrationSatisfiedByException(e: ExciseEvent) defeasible {
    when s4222_exception_applies(e);
    then registration_satisfied_for_4221(e);
}

// section 4222(b)(2): the Secretary's power to relieve from registration.
pub relation secretary_relief_from_registration_granted(e: ExciseEvent) kind empirical {
    label en official "the Secretary acts to relieve the purchaser or second purchaser from registering, under regulations prescribed for the purpose of paragraph (2)";
}
pub relation secretary_relief_regulations_prescribed(e: ExciseEvent) kind empirical {
    label en official "section 4222(b)(2): the relief is subject to such regulations as the Secretary may prescribe for the purpose of the paragraph";
}
@source(IRC_S4222_B, relation = formalizes, coverage = exact, quote = "Subject to such regulations as the Secretary may prescribe for the purpose of this paragraph, the Secretary may relieve")
rule Section4222b2ReliefPowerRule(e: ExciseEvent) defeasible {
    when secretary_relief_from_registration_granted(e);
    then power Section4222RegistrationRelief {
        holder Secretary;
        over e;
        exercise secretary_relief_from_registration_granted(e);
        valid_when secretary_relief_regulations_prescribed(e);
        effect create(registration_requirement_relieved(e));
        window [-infinity, infinity];
    };
}

// section 4222(c): denial, revocation or suspension of registration.
external judgment relation secretary_determines_registration_used_to_avoid_or_interfere_with_tax(p: Person) {
    authority Secretary;
    label en official "section 4222(c)(1): the Secretary determines that the person has used the registration to avoid payment of any chapter 32 tax or to postpone or interfere with its collection";
}
external judgment relation secretary_determines_denial_revocation_suspension_necessary_to_protect_revenue(p: Person) {
    authority Secretary;
    label en official "section 4222(c)(2): the Secretary determines that denial, revocation, or suspension is necessary to protect the revenue";
}
pub relation registration_action_taken(p: Person) kind empirical {
    label en official "the Secretary denies, revokes, or suspends the registration of the person";
}
pub relation registration_action_grounds_exist(p: Person) kind institutional {
    label en official "section 4222(c)(1)-(2): a ground for denial, revocation, or suspension exists (single-atom valid_when helper)";
}
@source(IRC_S4222_C, relation = formalizes, coverage = exact, quote = "(1) that such person has used such registration to avoid the payment of any tax imposed by this chapter")
rule RegistrationActionGroundAvoidance(p: Person) strict {
    when secretary_determines_registration_used_to_avoid_or_interfere_with_tax(p);
    then registration_action_grounds_exist(p);
}
@source(IRC_S4222_C, relation = formalizes, coverage = exact, quote = "(2) that such denial, revocation, or suspension is necessary to protect the revenue.")
rule RegistrationActionGroundProtectRevenue(p: Person) strict {
    when secretary_determines_denial_revocation_suspension_necessary_to_protect_revenue(p);
    then registration_action_grounds_exist(p);
}
@source(IRC_S4222_C, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, the registration of any person under this section may be denied, revoked, or suspended if the Secretary determines—")
rule Section4222cRegistrationActionPowerRule(p: Person) defeasible {
    when registration_action_taken(p);
    then power Section4222cRegistrationAction {
        holder Secretary;
        over p;
        exercise registration_action_taken(p);
        valid_when registration_action_grounds_exist(p);
        effect create(registration_denied_revoked_or_suspended(p));
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4182 — firearms exemptions
// =====================================================================

pub enum SensitiveAmmunitionCategory {
    ShotgunAmmunition;
    RifleOnlyAmmunitionGenerallyAvailable;
    AmmunitionComponentParts;
}

pub relation firearm_taxed_under_5811(e: FirearmSaleEvent) kind empirical {
    label en official "section 4182(a): the tax provided by section 5811 has been paid on the firearm";
}
pub relation purchased_with_funds_appropriated_for_military_department(e: FirearmSaleEvent) kind empirical {
    label en official "section 4182(b): the articles are purchased with funds appropriated for the military department";
}
pub relation manufacturer_group_articles_in_calendar_year(e: FirearmSaleEvent, count: Integer) kind empirical {
    label en official "section 4182(c)(1)-(2): the aggregate number of pistols, revolvers and firearms manufactured, produced, and imported during the calendar year by the person, all persons treated as a single employer under section 52(a) or (b) counted as one (the section 52 grouping is EXTERNAL_DEPENDENCY carried as this asserted count)";
}

@source(IRC_S4182_A, relation = formalizes, coverage = exact, quote = "The tax imposed by section 4181 shall not apply to any firearm on which the tax provided by section 5811 has been paid.")
rule FirearmTaxedUnder5811Exempt(e: FirearmSaleEvent) strict {
    when firearm_sale(e, _, _, _) and firearm_taxed_under_5811(e);
    then tax_free_sale(e);
}
@source(IRC_S4182_B, relation = formalizes, coverage = exact, quote = "shall be subject to any tax imposed on the sale or transfer of such articles.")
rule FirearmMilitaryPurchaseExempt(e: FirearmSaleEvent) strict {
    when firearm_sale(e, _, _, _) and purchased_with_funds_appropriated_for_military_department(e);
    then tax_free_sale(e);
}
@source(IRC_S4182_C, relation = formalizes, coverage = exact, quote = "manufactured, produced, or imported by a person who manufactures, produces, and imports less than an aggregate of 50 of such articles during the calendar year.")
rule FirearmSmallManufacturerExempt(e: FirearmSaleEvent, article: FirearmArticleKind, count: Integer) strict {
    when firearm_sale(e, article, _, _)
        and article != ShellOrCartridge
        and manufacturer_group_articles_in_calendar_year(e, count)
        and count < 50;
    then tax_free_sale(e);
}

// PL 119-21 section 70436(c) (amending section 4182(a), applicable to calendar quarters beginning
// more than 90 days after July 4, 2025, i.e. from January 1, 2026): any firearm described in section
// 5811(a)(2) is deemed a firearm on which the section 5811 tax has been paid. The 2024 base text is
// not changed; the amendment is a plain applicability date, so it is a dated rule rather than a
// `revision` (no `revision` declaration is used anywhere in us.irc, so its runtime behaviour is untested).
pub relation firearm_sale_date(e: FirearmSaleEvent, on: Date) kind empirical {
    label en official "the date of the firearm sale, needed for the Pub. L. 119-21 section 70436 applicability date";
}
pub relation firearm_described_in_5811a2(e: FirearmSaleEvent) kind empirical {
    label en official "section 5811(a)(2) as amended by Pub. L. 119-21 section 70436(a): a firearm transferred that is not a machinegun or a destructive device";
}
@source(IRC_S4182_A, relation = formalizes, coverage = partial, quote = "The tax imposed by section 4181 shall not apply to any firearm on which the tax provided by section 5811 has been paid.")
rule FirearmDescribedIn5811a2DeemedTaxedFrom2026(e: FirearmSaleEvent, on: Date) strict {
    when firearm_sale(e, _, _, _) and firearm_described_in_5811a2(e) and firearm_sale_date(e, on) and on >= @2026-01-01;
    then tax_free_sale(e);
}

pub relation holder_of_federal_firearms_license_chapter_44(p: Person) kind empirical {
    label en official "section 4182(d): the person holds a Federal license under chapter 44 of title 18, United States Code";
}
pub relation purchaser_record_required_of_licensee(p: Person, category: SensitiveAmmunitionCategory) kind institutional {
    label en official "a requirement to record the name, address or other information about the purchaser of the ammunition (sections 922(b)(5) and 923(g) of title 18, external)";
}
pub relation licensee_sells_ammunition_category(p: Person, category: SensitiveAmmunitionCategory) kind empirical {
    label en official "section 4182(d): the licensee sells shotgun ammunition, ammunition suitable for use only in rifles generally available in commerce, or component parts for these types of ammunition";
}
@source(IRC_S4182_D, relation = formalizes, coverage = exact, quote = "no person holding a Federal license under chapter 44 of title 18, United States Code, shall be required to record the name, address, or other information about the purchaser")
rule Section4182dNoRecordRequirementImmunityRule(p: Person, category: SensitiveAmmunitionCategory) strict {
    when holder_of_federal_firearms_license_chapter_44(p) and licensee_sells_ammunition_category(p, category);
    then immunity Section4182dNoPurchaserRecordRequirement {
        holder p;
        protected_effect purchaser_record_required_of_licensee(p, category);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4217 — leases
// =====================================================================

pub relation lease_by_manufacturer_producer_or_importer(l: Lease) kind empirical {
    label en official "section 4217(a): the lease (including any renewal, extension, or subsequent lease) of an article by the manufacturer, producer, or importer";
}
pub relation lease_considered_sale(l: Lease) kind institutional {
    label en official "section 4217(a): the lease is considered a sale of the article for purposes of chapter 32";
}
pub relation lessor_also_sells_same_type_and_model_at_arms_length(l: Lease) kind empirical {
    label en official "section 4217(d)(1): at the time of the lease (or a prior lease to which (b) applies) the lessor was also engaged in the business of selling in arm's length transactions the same type and model of article";
}
pub relation lease_percentage_of_payment_regime_applies(l: Lease) kind institutional {
    label en official "section 4217(b), (d)(1): tax is paid on each lease payment as a percentage of the payment until the total tax is reached";
}
pub relation first_lease_under_4217b_is_first_lease_of_article(l: Lease) kind empirical {
    label en official "section 4217(c): the first lease to which subsection (b) applies is the first lease of the article";
}
pub relation constructive_sale_price_if_sold_at_retail_on_first_lease(l: Lease, price: Money) kind empirical {
    label en official "section 4217(c)(1): the constructive sale price determined under section 4216(b) if the article were sold at retail on the date of the first lease (an evaluative amount fixed under section 4216(b), carried as an asserted amount)";
}
pub relation fair_market_value_on_first_lease(l: Lease, value: Money) kind empirical {
    label en official "section 4217(c)(2): the fair market value of the article on the date of the first lease to which (b) applies (DECISION-0194: an adjudicated fact, asserted with origin adjudicated)";
}
pub relation applicable_rate_on_date_of_first_lease(l: Lease, rate_percent: Decimal) kind empirical {
    label en official "section 4217(c), last sentence: the applicable rate specified in chapter 32 in effect on the date of the first lease to which subsection (b) applies";
}
pub relation lease_total_tax(l: Lease, total: Money) kind institutional {
    label en official "section 4217(c): the total tax";
}

@source(IRC_S4217_A, relation = formalizes, coverage = exact, quote = "shall be considered a sale of such article.")
rule LeaseByManufacturerConsideredSale(l: Lease) strict {
    when lease_by_manufacturer_producer_or_importer(l);
    then lease_considered_sale(l);
}
@source(IRC_S4217_D, relation = formalizes, coverage = exact, quote = "was also engaged in the business of selling in arm's length transactions the same type and model of article.")
rule LeasePercentageRegimeApplies(l: Lease) strict {
    when lease_by_manufacturer_producer_or_importer(l) and lessor_also_sells_same_type_and_model_at_arms_length(l);
    then lease_percentage_of_payment_regime_applies(l);
}
@source(IRC_S4217_C, relation = formalizes, coverage = exact, quote = "(1) except as provided in paragraph (2), the tax computed on the constructive sale price for such article")
rule LeaseTotalTaxOnConstructivePrice(l: Lease, price: Money, rate: Decimal) strict {
    when lease_percentage_of_payment_regime_applies(l)
        and first_lease_under_4217b_is_first_lease_of_article(l)
        and constructive_sale_price_if_sold_at_retail_on_first_lease(l, price)
        and applicable_rate_on_date_of_first_lease(l, rate);
    then lease_total_tax(l, round(price * rate, 2, "HALF_UP"));
}
@source(IRC_S4217_C, relation = formalizes, coverage = exact, quote = "the tax computed on the fair market value of such article on the date of the first lease to which subsection (b) applies.")
rule LeaseTotalTaxOnFairMarketValue(l: Lease, value: Money, rate: Decimal) strict {
    when lease_percentage_of_payment_regime_applies(l)
        and not_known(first_lease_under_4217b_is_first_lease_of_article(l))
        and fair_market_value_on_first_lease(l, value)
        and applicable_rate_on_date_of_first_lease(l, rate);
    then lease_total_tax(l, round(value * rate, 2, "HALF_UP"));
}

pub entity LeasePayment : ExciseEvent;
pub relation lease_payment(pay: LeasePayment, lease: Lease, amount: Money, on: Date, rate_percent_on_payment_date: Decimal) kind empirical {
    label en official "section 4217(b): a lease payment and the rate of tax in effect on the date of the payment";
}
pub relation lease_tax_paid_on_prior_payments(pay: LeasePayment, prior: Money) kind empirical {
    label en official "section 4217(b): the tax payments already made under this lease and any prior lease to which (b) applies (TECH_GAP: not derived from the payment history here, asserted)";
}
pub relation lease_payment_tax_before_total_tax_limit(pay: LeasePayment, tax: Money) kind institutional {
    label en official "section 4217(b): the percentage of this payment equal to the rate in effect on the date of the payment";
}
pub relation lease_payment_tax(pay: LeasePayment, tax: Money) kind institutional {
    label en official "section 4217(b): tax on this payment, not beyond the total tax";
}

@source(IRC_S4217_B, relation = formalizes, coverage = exact, quote = "there shall be paid on each lease payment with respect to such article a percentage of such payment equal to the rate of tax in effect on the date of such payment")
rule LeasePaymentTaxUncapped(pay: LeasePayment, amount: Money, rate: Decimal) strict {
    when lease_payment(pay, _, amount, _, rate);
    then lease_payment_tax_before_total_tax_limit(pay, round(amount * rate, 2, "HALF_UP"));
}
@source(IRC_S4217_B, relation = formalizes, coverage = exact, quote = "until the total of the tax payments under such lease and any prior lease to which this subsection applies equals the total tax.")
rule LeasePaymentTaxWithinTotal(pay: LeasePayment, l: Lease, base: Money, prior: Money, total: Money) strict {
    when lease_payment(pay, l, _, _, _)
        and lease_payment_tax_before_total_tax_limit(pay, base)
        and lease_tax_paid_on_prior_payments(pay, prior)
        and lease_total_tax(l, total)
        and prior + base <= total;
    then lease_payment_tax(pay, base);
}
@source(IRC_S4217_B, relation = formalizes, coverage = exact, quote = "until the total of the tax payments under such lease and any prior lease to which this subsection applies equals the total tax.")
rule LeasePaymentTaxCapped(pay: LeasePayment, l: Lease, base: Money, prior: Money, total: Money) strict {
    when lease_payment(pay, l, _, _, _)
        and lease_payment_tax_before_total_tax_limit(pay, base)
        and lease_tax_paid_on_prior_payments(pay, prior)
        and lease_total_tax(l, total)
        and prior + base > total
        and prior < total;
    then lease_payment_tax(pay, total - prior);
}
@source(IRC_S4217_B, relation = formalizes, coverage = exact, quote = "until the total of the tax payments under such lease and any prior lease to which this subsection applies equals the total tax.")
rule LeasePaymentTaxAfterTotalReached(pay: LeasePayment, l: Lease, prior: Money, total: Money) strict {
    when lease_payment(pay, l, _, _, _)
        and lease_tax_paid_on_prior_payments(pay, prior)
        and lease_total_tax(l, total)
        and prior >= total;
    then lease_payment_tax(pay, 0 USD);
}

// --- (d)(2)-(3): sale of a leased article -------------------------------------

pub entity SaleOfLeasedArticle : ExciseEvent;
pub relation sale_of_leased_article(s: SaleOfLeasedArticle, l: Lease, price: Money, rate_percent_on_sale_date: Decimal) kind empirical {
    label en official "section 4217(d)(2): the taxpayer sells the leased article at this price, the rate being that in effect on the date of the sale (an arm's length sale is priced without regard to section 4216(b))";
}
pub relation lease_tax_paid_before_sale(s: SaleOfLeasedArticle, paid: Money) kind empirical {
    label en official "section 4217(d)(2)(A)(i): the tax imposed on lease payments under leases to which subsection (b) applies";
}
pub relation total_tax_has_become_payable(l: Lease) kind empirical {
    label en official "section 4217(d)(3): the total tax has become payable";
}
@source(IRC_S4217_D, relation = formalizes, coverage = exact, quote = "the tax payable on such sale shall be whichever of the following is the smaller:")
rule SaleBeforeTotalTaxPayableTax(s: SaleOfLeasedArticle, l: Lease, price: Money, rate: Decimal, paid: Money, total: Money) strict {
    when sale_of_leased_article(s, l, price, rate)
        and lease_tax_paid_before_sale(s, paid)
        and lease_total_tax(l, total)
        and not_known(total_tax_has_become_payable(l));
    then excise_tax_due(s, min(total - paid, round(price * rate, 2, "HALF_UP")));
}
@source(IRC_S4217_D, relation = formalizes, coverage = exact, quote = "If the taxpayer sells an article after the total tax has become payable, no tax shall be imposed under this chapter on such sale.")
rule SaleAfterTotalTaxPayableNoTax(s: SaleOfLeasedArticle, l: Lease) strict {
    when sale_of_leased_article(s, l, _, _) and total_tax_has_become_payable(l);
    then tax_free_sale(s);
}

// --- (e): leases of automobiles subject to the gas guzzler tax ---------------

pub entity GasGuzzlerLeasePayment : ExciseEvent;
pub relation gas_guzzler_lease_payment(pay: GasGuzzlerLeasePayment, payment: Money, total_amount_to_be_paid_under_lease: Money, total_gas_guzzler_tax: Money) kind empirical {
    label en official "section 4217(e)(2)(A): a payment under the first lease of the automobile by the manufacturer, the total amount to be paid under the lease, and the total gas guzzler tax (tax under section 4064 at the rate in effect on the date of the first lease)";
}
pub relation gas_guzzler_lease_cancellation_or_disposition_before_total_payable(l: Lease, total_gas_guzzler_tax: Money, tax_paid_on_lease_payments: Money) kind empirical {
    label en official "section 4217(e)(2)(B): the lease is canceled, or the automobile sold or otherwise disposed of, before the total gas guzzler tax is payable";
}
pub relation gas_guzzler_disposition_after_total_payable(l: Lease) kind empirical {
    label en official "section 4217(e)(2)(C): the automobile is sold or otherwise disposed of after the total gas guzzler tax is payable";
}
pub relation gas_guzzler_lease_payment_tax(pay: GasGuzzlerLeasePayment, tax: Money) kind institutional {
    label en official "section 4217(e)(2)(A): the portion of the total gas guzzler tax that bears the same ratio to it as this payment bears to the total amount to be paid under the lease";
}
pub relation gas_guzzler_lease_cancellation_tax(l: Lease, tax: Money) kind institutional {
    label en official "section 4217(e)(2)(B): the difference between the tax imposed on the lease payments and the total gas guzzler tax";
}
@source(IRC_S4217_E, relation = formalizes, coverage = exact, quote = "there shall be paid by the manufacturer on each lease payment that portion of the total gas guzzler tax which bears the same ratio to such total gas guzzler tax as such payment bears to the total amount to be paid under such lease,")
rule GasGuzzlerLeasePaymentTax(pay: GasGuzzlerLeasePayment, payment: Money, total: Money, gg: Money) strict {
    when gas_guzzler_lease_payment(pay, payment, total, gg) and total > 0 USD;
    then gas_guzzler_lease_payment_tax(pay, round(gg * (payment / total), 2, "HALF_UP"));
}
@source(IRC_S4217_E, relation = formalizes, coverage = exact, quote = "there shall be paid by the manufacturer on such cancellation, sale, or disposition the difference between the tax imposed under subparagraph (A) on the lease payments and the total gas guzzler tax, and")
rule GasGuzzlerLeaseCancellationTax(l: Lease, gg: Money, paid: Money) strict {
    when gas_guzzler_lease_cancellation_or_disposition_before_total_payable(l, gg, paid) and gg >= paid;
    then gas_guzzler_lease_cancellation_tax(l, gg - paid);
}

// =====================================================================
// Section 4218 — use by manufacturer, producer, or importer
// Section 4219 — sales by other than the manufacturer or importer
// =====================================================================

pub entity ManufacturerUseEvent : ExciseEvent;

pub relation manufacturer_uses_article(e: ManufacturerUseEvent, user: Person, applicable_rate_percent: Decimal) kind empirical {
    label en official "section 4218(a): the manufacturer, producer, or importer uses an article (other than a section 4071 tire) and the chapter 32 tax rate applicable to a sale of it";
}
pub relation used_as_material_or_component_of_another_taxable_article(e: ManufacturerUseEvent) kind empirical {
    label en official "section 4218(a): the article is used as material in the manufacture or production of, or as a component part of, another article taxable under chapter 32 to be manufactured or produced by the user";
}
pub relation gasoline_used_for_nonfuel_purposes_as_material(e: ManufacturerUseEvent) kind empirical {
    label en official "section 4218(a), second sentence: gasoline used for nonfuel purposes as a material in the manufacture of another article";
}
pub relation article_is_coal_taxable_under_4121(e: ManufacturerUseEvent) kind empirical {
    label en official "section 4218(a), third sentence: the article is coal taxable under section 4121 (the material-use exception is disregarded)";
}
external judgment relation secretary_determined_ordinary_course_price_of_similar_articles(e: ManufacturerUseEvent, price: Money) {
    authority Secretary;
    label en official "section 4218(c): the price at which such or similar articles are sold in the ordinary course of trade by manufacturers, producers, or importers, as determined by the Secretary";
}
pub relation use_treated_as_sale_by_user(e: ManufacturerUseEvent) kind institutional {
    label en official "section 4218(a): the user is liable for chapter 32 tax in the same manner as if the article were sold by him";
}

@source(IRC_S4218_A, relation = formalizes, coverage = exact, quote = "then he shall be liable for tax under this chapter in the same manner as if such article were sold by him.")
rule UseByManufacturerTreatedAsSale(e: ManufacturerUseEvent) strict {
    when manufacturer_uses_article(e, _, _)
        and not_known(used_as_material_or_component_of_another_taxable_article(e))
        and not_known(gasoline_used_for_nonfuel_purposes_as_material(e));
    then use_treated_as_sale_by_user(e);
}
@source(IRC_S4218_A, relation = formalizes, coverage = exact, quote = "the words \"(otherwise than as material in the manufacture or production of, or as a component part of, another article taxable under this chapter to be manufactured or produced by him)\" shall be disregarded.")
rule UseOfCoalTreatedAsSaleDespiteMaterialUse(e: ManufacturerUseEvent) strict {
    when manufacturer_uses_article(e, _, _) and article_is_coal_taxable_under_4121(e);
    then use_treated_as_sale_by_user(e);
}
@source(IRC_S4218_C, relation = formalizes, coverage = exact, quote = "the tax (if based on the price for which the article is sold) shall be computed on the price at which such or similar articles are sold")
rule UseByManufacturerTax(e: ManufacturerUseEvent, rate: Decimal, price: Money) defeasible {
    when manufacturer_uses_article(e, _, rate)
        and use_treated_as_sale_by_user(e)
        and secretary_determined_ordinary_course_price_of_similar_articles(e, price);
    then excise_tax_due(e, round(price * rate, 2, "HALF_UP"));
}
@source(IRC_S4218_A, relation = formalizes, coverage = exact, quote = "then he shall be liable for tax under this chapter in the same manner as if such article were sold by him.")
rule UseByManufacturerLiability(e: ManufacturerUseEvent, user: Person, amount: Money) defeasible {
    when manufacturer_uses_article(e, user, _) and use_treated_as_sale_by_user(e) and excise_tax_due(e, amount);
    then liable_for_excise(user, e, amount);
}

pub relation tire_manufacturer_sells_with_article_or_uses(t: TireSaleEvent, seller: Person) kind empirical {
    label en official "section 4218(b): the manufacturer, producer, or importer of a section 4071 tire sells it on or in connection with the sale of any article, or uses it";
}
@source(IRC_S4218_B, relation = formalizes, coverage = partial, quote = "and sells it on or in connection with the sale of any article, or uses it, then he shall be liable for tax under this chapter in the same manner as if such article were sold by him.")
rule TireSoldWithArticleOrUsedLiability(t: TireSaleEvent, seller: Person, amount: Money) defeasible {
    when tire_manufacturer_sells_with_article_or_uses(t, seller) and excise_tax_due(t, amount) and not_known(tax_free_sale(t));
    then liable_for_excise(seller, t, amount);
}

pub relation acquires_right_to_sell_from_manufacturer_by_nontaxable_transaction(p: Person, e: ExciseEvent) kind empirical {
    label en official "section 4219: the person acquires from the manufacturer, producer, or importer, by operation of law or by a transaction not taxable under chapter 32, the right to sell the article";
}
@source(IRC_S4219, relation = formalizes, coverage = exact, quote = "the sale of such article by such person shall be taxable under this chapter as if made by the manufacturer, producer, or importer, and such person shall be liable for the tax.")
rule PersonAcquiringRightToSellLiable(p: Person, e: ExciseEvent, amount: Money) defeasible {
    when acquires_right_to_sell_from_manufacturer_by_nontaxable_transaction(p, e) and excise_tax_due(e, amount);
    then liable_for_excise(p, e, amount);
}

// =====================================================================
// Section 4223 — purchasing manufacturer; computation of tax
// =====================================================================

pub relation sold_tax_free_for_further_manufacture_to(e: ExciseEvent, purchaser: Person) kind empirical {
    label en official "section 4223(a): the article is sold or resold free of tax under section 4221(a)(1) to a manufacturer or producer for use in further manufacture";
}
pub relation treated_as_manufacturer_of_article(p: Person, e: ExciseEvent) kind institutional {
    label en official "section 4223(a): the purchasing manufacturer or producer is treated as the manufacturer or producer of the article";
}
@source(IRC_S4223_A, relation = formalizes, coverage = exact, quote = "shall be treated as the manufacturer or producer of such article.")
rule PurchasingManufacturerTreatedAsManufacturer(p: Person, e: ExciseEvent) strict {
    when sold_tax_free_for_further_manufacture_to(e, p);
    then treated_as_manufacturer_of_article(p, e);
}

pub relation price_at_which_purchasing_manufacturer_sold(e: ExciseEvent, price: Money) kind empirical {
    label en official "section 4223(b)(1): the price for which the article was sold by the purchasing manufacturer (or, for a use, the section 4218(c) price), determined under section 4216";
}
pub relation price_paid_by_purchasing_manufacturer(e: ExciseEvent, price: Money) kind empirical {
    label en official "section 4223(b)(2)(A): the price at which the article was sold to the purchasing manufacturer";
}
pub relation price_of_original_manufacturer_sale(e: ExciseEvent, price: Money) kind empirical {
    label en official "section 4223(b)(2)(B): the price for which the article was sold by the person who, without regard to subsection (a), is the manufacturer, producer, or importer";
}
external judgment relation price_established_to_secretary_satisfaction_4223(e: ExciseEvent) {
    authority Secretary;
    label en official "section 4223(b)(2): the manufacturer establishes the price to the satisfaction of the Secretary";
}
pub relation election_4223_b2a_made_in_return(e: ExciseEvent, p: Person) kind empirical {
    label en official "section 4223(b)(2)(A): the election to use the price at which the article was sold to the manufacturer is made in the return reporting the tax";
}
pub relation election_4223_b2b_made_in_return(e: ExciseEvent, p: Person) kind empirical {
    label en official "section 4223(b)(2)(B): the election to use the price of the original manufacturer's sale is made in the return reporting the tax";
}
pub relation election_4223_revoked(e: ExciseEvent, p: Person) kind empirical {
    label en official "the manufacturer revokes an election under section 4223(b)(2), which the section forbids";
}
pub relation price_treated_as_sale_price_for_tax(e: ExciseEvent, price: Money) kind institutional {
    label en official "section 4223(b): the price at which the article is treated as having been sold by the purchasing manufacturer";
}
@source(IRC_S4223_B, relation = formalizes, coverage = exact, quote = "(1) at the price for which the article was sold by him")
rule DefaultPriceIsOwnSalePrice(e: ExciseEvent, p: Person, price: Money) defeasible {
    when treated_as_manufacturer_of_article(p, e) and price_at_which_purchasing_manufacturer_sold(e, price);
    then price_treated_as_sale_price_for_tax(e, price);
    unless election_4223_b2a_made_in_return(e, p) and treated_as_manufacturer_of_article(p, e) and price_at_which_purchasing_manufacturer_sold(e, price);
    unless election_4223_b2b_made_in_return(e, p) and treated_as_manufacturer_of_article(p, e) and price_at_which_purchasing_manufacturer_sold(e, price);
}
@source(IRC_S4223_B, relation = formalizes, coverage = exact, quote = "(A) at the price for which the article was sold to him; or")
rule Election4223b2aPowerRule(e: ExciseEvent, p: Person, price: Money) defeasible {
    when election_4223_b2a_made_in_return(e, p) and price_paid_by_purchasing_manufacturer(e, price);
    then power Election4223PriceSoldToManufacturer {
        holder p;
        over e;
        exercise election_4223_b2a_made_in_return(e, p);
        valid_when price_established_to_secretary_satisfaction_4223(e);
        effect create(price_treated_as_sale_price_for_tax(e, price));
        window [-infinity, infinity];
    };
}
@source(IRC_S4223_B, relation = formalizes, coverage = exact, quote = "(B) at the price for which the article was sold by the person who (without regard to subsection (a)) is the manufacturer, producer, or importer of such article.")
rule Election4223b2bPowerRule(e: ExciseEvent, p: Person, price: Money) defeasible {
    when election_4223_b2b_made_in_return(e, p) and price_of_original_manufacturer_sale(e, price);
    then power Election4223PriceOfOriginalManufacturerSale {
        holder p;
        over e;
        exercise election_4223_b2b_made_in_return(e, p);
        valid_when price_established_to_secretary_satisfaction_4223(e);
        effect create(price_treated_as_sale_price_for_tax(e, price));
        window [-infinity, infinity];
    };
}
@source(IRC_S4223_B, relation = formalizes, coverage = exact, quote = "An election under paragraph (2) shall be made in the return reporting the tax applicable to the sale or use of the article, and may not be revoked.")
rule Election4223NoRevocationProhibitionRule(e: ExciseEvent, p: Person) defeasible {
    when election_4223_b2a_made_in_return(e, p);
    then prohibition Election4223NoRevocation {
        bearer p;
        action election_4223_revoked(e, p);
        window [-infinity, infinity];
    };
}
@source(IRC_S4223_B, relation = formalizes, coverage = exact, quote = "An election under paragraph (2) shall be made in the return reporting the tax applicable to the sale or use of the article, and may not be revoked.")
rule Election4223bNoRevocationProhibitionRule(e: ExciseEvent, p: Person) defeasible {
    when election_4223_b2b_made_in_return(e, p);
    then prohibition Election4223bNoRevocation {
        bearer p;
        action election_4223_revoked(e, p);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4225 — native Indian handicraft; section 4293 — United States exemption
// =====================================================================

pub relation article_of_native_indian_handicraft(e: ExciseEvent) kind empirical {
    label en official "section 4225: the article is native Indian handicraft";
}
pub relation manufactured_by_indians_on_reservation_school_or_alaska(e: ExciseEvent) kind empirical {
    label en official "section 4225: manufactured or produced by Indians on Indian reservations, or in Indian schools, or by Indians under the jurisdiction of the United States Government in Alaska";
}
@source(IRC_S4225, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under this chapter on any article of native Indian handicraft")
rule IndianHandicraftExempt(e: ExciseEvent) strict {
    when article_of_native_indian_handicraft(e) and manufactured_by_indians_on_reservation_school_or_alaska(e);
    then tax_free_sale(e);
}

pub relation purchased_for_exclusive_use_of_united_states(e: ExciseEvent) kind empirical {
    label en official "section 4293: the article or service, or class of them, is to be purchased for the exclusive use of the United States";
}
pub relation secretary_authorizes_united_states_exemption(e: ExciseEvent) kind empirical {
    label en official "the Secretary of the Treasury authorizes exemption from the tax for this article or service under section 4293";
}
external judgment relation secretary_determines_substantial_burden_avoidable_by_exemption(e: ExciseEvent) {
    authority Secretary;
    label en official "section 4293: the Secretary determines that imposing the tax will cause substantial burden or expense which can be avoided by granting exemption";
}
external judgment relation secretary_determines_full_benefit_accrues_to_united_states(e: ExciseEvent) {
    authority Secretary;
    label en official "section 4293: the Secretary determines that the full benefit of the exemption, if granted, will accrue to the United States";
}
pub relation united_states_exemption_conditions_met(e: ExciseEvent) kind institutional {
    label en official "section 4293: exclusive use of the United States, both Secretary determinations, and the tax is not one excluded (sections 4064 and 4121)";
}
@source(IRC_S4293, relation = formalizes, coverage = exact, quote = "if he determines that the imposition of such taxes with respect to such articles or services, or class of articles or services will cause substantial burden or expense which can be avoided by granting tax exemption")
rule UnitedStatesExemptionConditions(e: ExciseEvent) strict {
    when purchased_for_exclusive_use_of_united_states(e)
        and secretary_determines_substantial_burden_avoidable_by_exemption(e)
        and secretary_determines_full_benefit_accrues_to_united_states(e)
        and not_known(excise_event_taxed_under_section(e, 4064))
        and not_known(excise_event_taxed_under_section(e, 4121));
    then united_states_exemption_conditions_met(e);
}
@source(IRC_S4293, relation = formalizes, coverage = exact, quote = "The Secretary of the Treasury may authorize exemption from the taxes imposed by section 4041, section 4051, chapter 32")
rule Section4293ExemptionPowerRule(e: ExciseEvent) defeasible {
    when secretary_authorizes_united_states_exemption(e);
    then power Section4293UnitedStatesExemption {
        holder Secretary;
        over e;
        exercise secretary_authorizes_united_states_exemption(e);
        valid_when united_states_exemption_conditions_met(e);
        effect create(tax_free_sale(e));
        window [-infinity, infinity];
    };
}
