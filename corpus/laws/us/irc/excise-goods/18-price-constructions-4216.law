// Stage 3 (TECH_GAP reduction): section 4216(b) constructive sale price, (d) sale of installment accounts,
// (e) local-advertising exclusion. Builds on `PricedArticleSale`, `price_for_tax_purposes` and the partial
// payment shapes of 04-general-provisions.law.
//
// Channel choices (DECISION-0194): the amounts the statute commits to "the Secretary" (the price at which
// manufacturers sell in the ordinary course of trade; the highest price to wholesale distributors) are
// `external judgment` relations with the authority `Secretary`; the arithmetic that follows from them (the
// lower of two prices, 90 percent of a lowest price, the ratio of paragraph (4)) is ordinary rules. Facts about
// how the parties sell (regularly sells at retail, affiliated group member, arm's length transaction) are
// case facts; none of them is reduced to an arithmetic guard.
//
// JUDGMENT CALLS (also on the coverage rows): (1) where the statute names no rounding of a Money result the
// package convention is cents HALF_UP (AGENT-BRIEF "Money forms"). (2) Paragraph (4) reduces the retailer
// price by the percentage that (R - W) is of R (W = price to wholesale distributors, R = price wholesale
// distributors charge retailers); the rule is written for R >= W and stays silent otherwise (reading
// "difference" as a non-negative reduction). (3) Paragraph (5)(B) is read as: a fixed amount to which the
// purchaser is entitled under a pre-existing contract does not lower the lowest price, so the candidate prices
// are the invoiced prices. (4) The per-quarter aggregate of subsection (e)(2) is computed over recorded ledger
// items (case facts); an aggregate over derived per-sale results would be a section 111 subset limit.

// =====================================================================
// Section 4216(b) — constructive sale price
// =====================================================================

use self::{
    IRC_S4216_A,
    IRC_S4216_B,
    IRC_S4216_D,
    IRC_S4216_E,
    PartialPaymentInstallment,
    Person,
    PricedArticleSale,
    price_for_tax_purposes,
};

pub relation article_sold_at_retail_4216(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(1)(A): the article is sold at retail";
}
pub relation article_sold_on_consignment_4216(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(1)(B): the article is sold on consignment";
}
pub relation article_sold_below_fair_market_price_not_at_arms_length_4216(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(1)(C): the article is sold (otherwise than through an arm's length transaction) at less than the fair market price";
}
pub relation article_sold_at_retail_or_to_retailer_4216(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(2): the article is sold at retail or to a retailer";
}

pub external judgment relation secretary_determined_ordinary_trade_manufacturer_price(a: PricedArticleSale, price: Money) {
    authority Secretary;
    label en official "section 4216(b)(1): the price for which such articles are sold, in the ordinary course of trade, by manufacturers or producers thereof, as determined by the Secretary (DECISION-0194: the text commits the determination to the Secretary)";
}
pub external judgment relation secretary_determined_highest_wholesale_distributor_price(a: PricedArticleSale, price: Money) {
    authority Secretary;
    label en official "section 4216(b)(1): the highest price for which such articles are sold to wholesale distributors, in the ordinary course of trade, by manufacturers or producers thereof, as determined by the Secretary";
}

pub relation s4216_sale_price(a: PricedArticleSale, price: Money) kind institutional {
    label en official "the price for which the article is sold under section 4216(a) and (e): the section 4216(a) price less any local-advertising charge excluded under subsection (e)";
}
pub relation constructive_sale_price(a: PricedArticleSale, price: Money) kind institutional {
    label en official "section 4216(b): the price on which the tax under this chapter is computed when the article is sold at retail, on consignment, or below the fair market price outside an arm's length transaction, or under the special rules of paragraphs (2)-(4)";
}

// --- paragraph (2): special rule ---------------------------------------------

pub relation manufacturer_regularly_sells_at_retail_or_to_retailers(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(2)(A): the manufacturer, producer, or importer of the article regularly sells such articles at retail or to retailers, as the case may be";
}
pub relation manufacturer_regularly_sells_to_wholesale_distributors_at_arms_length(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(2)(B): the manufacturer, producer, or importer regularly sells such articles to one or more wholesale distributors in arm's length transactions";
}
pub relation manufacturer_establishes_prices_without_regard_to_tax_benefit(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(2)(B): he establishes that his prices in such cases are determined without regard to any tax benefit under this paragraph";
}
pub relation transaction_is_arms_length_4216(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(2)(C): the transaction is an arm's length transaction";
}
pub relation highest_price_to_wholesale_distributors_other_than_special_dealers(a: PricedArticleSale, price: Money) kind empirical {
    label en official "section 4216(b)(2): the highest price for which such articles are sold by the manufacturer, producer, or importer to wholesale distributors (other than special dealers)";
}
pub relation s4216b2_special_rule_applies(a: PricedArticleSale) kind institutional {
    label en official "section 4216(b)(2): the special rule applies, so paragraph (1) does not apply";
}

@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "If an article is sold at retail or to a retailer, and if—")
rule S4216b2SpecialRuleApplies(a: PricedArticleSale) strict {
    when article_sold_at_retail_or_to_retailer_4216(a)
        and manufacturer_regularly_sells_at_retail_or_to_retailers(a)
        and manufacturer_regularly_sells_to_wholesale_distributors_at_arms_length(a)
        and manufacturer_establishes_prices_without_regard_to_tax_benefit(a)
        and transaction_is_arms_length_4216(a);
    then s4216b2_special_rule_applies(a);
}

@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "the tax under this chapter shall (if based on the price for which the article is sold) be computed on whichever of the following prices is the lower: (i) the price for which such article is sold, or (ii) the highest price for which such articles are sold by such manufacturer, producer, or importer to wholesale distributors (other than special dealers).")
rule S4216b2ConstructivePriceLowerOfTwo(a: PricedArticleSale, sold: Money, highest: Money) strict {
    when s4216b2_special_rule_applies(a)
        and s4216_sale_price(a, sold)
        and highest_price_to_wholesale_distributors_other_than_special_dealers(a, highest);
    then constructive_sale_price(a, min(sold, highest));
}

// --- paragraph (5): definition of lowest price ---------------------------------

pub relation distributor_arms_length_price_to_independent_retailer(a: PricedArticleSale, price: Money) kind empirical {
    label en official "section 4216(b)(3)(B), (5): a price at which the distributor regularly sells the article in arm's-length transactions to independent retailers, whatever share of its sales is made at that price and stated without any fixed amount to which the purchaser has a contractual right (paragraph (5)(A), (B))";
}
pub relation s4216b5_lowest_price_to_independent_retailers(a: PricedArticleSale, price: Money) kind institutional {
    label en official "section 4216(b)(5): the lowest price, determined without requiring that any given percentage of sales be made at that price and without including any fixed amount to which the purchaser has a right under contractual arrangements existing at the time of the sale";
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "(A) without requiring that any given percentage of sales be made at that price, and")
rule S4216b5LowestPrice(a: PricedArticleSale, p: Money) strict {
    when distributor_arms_length_price_to_independent_retailer(a, p);
    then s4216b5_lowest_price_to_independent_retailers(a, min(collect q: Money where distributor_arms_length_price_to_independent_retailer(a, q)));
}

// --- paragraph (3): affiliated distributor selling to independent retailers ----

pub relation regularly_sells_to_distributor_in_same_affiliated_group_1504a(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(3)(A): the manufacturer, producer, or importer regularly sells such article to a distributor which is a member of the same affiliated group of corporations (section 1504(a)) as the manufacturer, producer, or importer (the section 1504(a) classification is an EXTERNAL_DEPENDENCY carried as a fact)";
}
pub relation distributor_regularly_sells_to_independent_retailers(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(3)(B): the distributor regularly sells such article to one or more independent retailers";
}
pub relation distributor_regularly_sells_to_wholesale_distributors(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(3)(B): the distributor regularly sells such article to wholesale distributors";
}
pub relation s4216b3_conditions_met(a: PricedArticleSale) kind institutional {
    label en official "section 4216(b)(3)(A) and (B): the manufacturer sells to an affiliated distributor, which sells to independent retailers but not to wholesale distributors";
}
pub relation s4216b3_constructive_price(a: PricedArticleSale, price: Money) kind institutional {
    label en official "section 4216(b)(3): 90 percent of the lowest price for which the distributor regularly sells the article in arm's-length transactions to the independent retailers";
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "(B) such distributor regularly sells such article to one or more independent retailers, but does not regularly sell to wholesale distributors,")
rule S4216b3ConditionsMet(a: PricedArticleSale) strict {
    when regularly_sells_to_distributor_in_same_affiliated_group_1504a(a)
        and distributor_regularly_sells_to_independent_retailers(a)
        and not_known(distributor_regularly_sells_to_wholesale_distributors(a));
    then s4216b3_conditions_met(a);
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "the constructive sale price of such article shall be 90 percent of the lowest price for which such distributor regularly sells such article in arm's-length transactions to such independent retailers.")
rule S4216b3ConstructivePrice(a: PricedArticleSale, lowest: Money) strict {
    when s4216b3_conditions_met(a) and s4216b5_lowest_price_to_independent_retailers(a, lowest);
    then s4216b3_constructive_price(a, round(lowest * 0.90, 2, "HALF_UP"));
}

// --- paragraph (4): affiliated distributor selling only to retailers ------------

pub relation regularly_sells_only_to_distributor_in_same_affiliated_group_1504a(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(4)(A): the manufacturer, producer, or importer regularly sells (except for tax-free sales) only to a distributor which is a member of the same affiliated group of corporations (section 1504(a))";
}
pub relation distributor_regularly_sells_only_to_retailers(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(4)(B): the distributor regularly sells (except for tax-free sales) such article only to retailers";
}
pub relation normal_industry_method_is_arms_length_sales_to_distributors(a: PricedArticleSale) kind empirical {
    label en official "section 4216(b)(4)(C): the normal method of sales for such articles within the industry by manufacturers, producers, or importers is to sell such articles in arm's-length transactions to distributors";
}
pub relation distributor_price_to_retailers(a: PricedArticleSale, price: Money) kind empirical {
    label en official "section 4216(b)(4): the price at which the article is sold to retailers by the distributor";
}
pub relation comparable_articles_price_manufacturer_to_wholesale_distributor(a: PricedArticleSale, price: Money) kind empirical {
    label en official "section 4216(b)(4)(i): the price for which comparable articles are sold to wholesale distributors, in the ordinary course of trade, by manufacturers or producers thereof";
}
pub relation comparable_articles_price_wholesale_distributor_to_retailers(a: PricedArticleSale, price: Money) kind empirical {
    label en official "section 4216(b)(4)(ii): the price at which such wholesale distributors in arm's-length transactions sell such comparable articles to retailers";
}
pub relation s4216b4_conditions_met(a: PricedArticleSale) kind institutional {
    label en official "section 4216(b)(4)(A)-(C) are all met";
}
pub relation s4216b4_constructive_price(a: PricedArticleSale, price: Money) kind institutional {
    label en official "section 4216(b)(4): the distributor's retail-level price reduced by the percentage that the difference between the wholesale-distributor purchase price and the retailer price is of the retailer price";
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "(C) the normal method of sales for such articles within the industry by manufacturers, producers, or importers is to sell such articles in arm's-length transactions to distributors,")
rule S4216b4ConditionsMet(a: PricedArticleSale) strict {
    when regularly_sells_only_to_distributor_in_same_affiliated_group_1504a(a)
        and distributor_regularly_sells_only_to_retailers(a)
        and normal_industry_method_is_arms_length_sales_to_distributors(a);
    then s4216b4_conditions_met(a);
}
// P - P * (R - W) / R = P * W / R, one rounding (AGENT-BRIEF "Money forms"). JUDGMENT CALL: written for R >= W.
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "the constructive sale price for such article shall be the price at which such article is sold to retailers by the distributor, reduced by a percentage of such price equal to the percentage which")
rule S4216b4ConstructivePrice(a: PricedArticleSale, p: Money, w: Money, r: Money) strict {
    when s4216b4_conditions_met(a)
        and distributor_price_to_retailers(a, p)
        and comparable_articles_price_manufacturer_to_wholesale_distributor(a, w)
        and comparable_articles_price_wholesale_distributor_to_retailers(a, r)
        and r >= w and r > 0.00 USD;
    then s4216b4_constructive_price(a, div_round(p * (w / 1.00 USD), r / 1.00 USD, 2, "HALF_UP"));
}

// --- paragraph (1): the general rule and the choice among (1), (3), (4) ---------

pub relation s4216b1_general_rule_applies(a: PricedArticleSale) kind institutional {
    label en official "section 4216(b)(1): the article is sold at retail, on consignment, or below the fair market price outside an arm's length transaction, and paragraph (2) does not apply";
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "This paragraph shall not apply if paragraph (2) applies.")
rule S4216b1AppliesRetail(a: PricedArticleSale) strict {
    when article_sold_at_retail_4216(a) and not_known(s4216b2_special_rule_applies(a));
    then s4216b1_general_rule_applies(a);
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "(B) sold on consignment, or")
rule S4216b1AppliesConsignment(a: PricedArticleSale) strict {
    when article_sold_on_consignment_4216(a) and not_known(s4216b2_special_rule_applies(a));
    then s4216b1_general_rule_applies(a);
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "(C) sold (otherwise than through an arm's length transaction) at less than the fair market price,")
rule S4216b1AppliesBelowFairMarket(a: PricedArticleSale) strict {
    when article_sold_below_fair_market_price_not_at_arms_length_4216(a) and not_known(s4216b2_special_rule_applies(a));
    then s4216b1_general_rule_applies(a);
}

// Retail sale: the lower of the price sold and the Secretary-determined highest wholesale price.
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "In the case of an article sold at retail, the computation under the preceding sentence shall be on whichever of the following prices is the lower: (i) the price for which such article is sold, or (ii) the highest price for which such articles are sold to wholesale distributors, in the ordinary course of trade, by manufacturers or producers thereof, as determined by the Secretary.")
rule S4216b1RetailConstructivePrice(a: PricedArticleSale, sold: Money, highest: Money) strict {
    when s4216b1_general_rule_applies(a)
        and article_sold_at_retail_4216(a)
        and not_known(s4216b3_conditions_met(a))
        and not_known(s4216b4_conditions_met(a))
        and s4216_sale_price(a, sold)
        and secretary_determined_highest_wholesale_distributor_price(a, highest);
    then constructive_sale_price(a, min(sold, highest));
}
// Consignment or below-fair-market sale (not at retail): the Secretary-determined ordinary-trade manufacturer price.
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "the tax under this chapter shall (if based on the price for which the article is sold) be computed on the price for which such articles are sold, in the ordinary course of trade, by manufacturers or producers thereof, as determined by the Secretary.")
rule S4216b1NonRetailConstructivePrice(a: PricedArticleSale, price: Money) strict {
    when s4216b1_general_rule_applies(a)
        and not_known(article_sold_at_retail_4216(a))
        and not_known(s4216b3_conditions_met(a))
        and not_known(s4216b4_conditions_met(a))
        and secretary_determined_ordinary_trade_manufacturer_price(a, price);
    then constructive_sale_price(a, price);
}
// Paragraph (3) alone, paragraph (4) alone, both (the lower of the two).
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (4), for purposes of paragraph (1), if—")
rule S4216b3ConstructivePriceGoverns(a: PricedArticleSale, price: Money) strict {
    when s4216b1_general_rule_applies(a) and s4216b3_constructive_price(a, price) and not_known(s4216b4_conditions_met(a));
    then constructive_sale_price(a, price);
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), if—")
rule S4216b4ConstructivePriceGoverns(a: PricedArticleSale, price: Money) strict {
    when s4216b1_general_rule_applies(a) and s4216b4_constructive_price(a, price) and not_known(s4216b3_conditions_met(a));
    then constructive_sale_price(a, price);
}
@source(IRC_S4216_B, relation = formalizes, coverage = exact, quote = "If both this paragraph and paragraph (4) apply with respect to an article, the constructive sale price for such article shall be the lower of the constructive sale price determined under this paragraph or paragraph (4).")
rule S4216b3And4LowerOfTwo(a: PricedArticleSale, p3: Money, p4: Money) strict {
    when s4216b1_general_rule_applies(a) and s4216b3_constructive_price(a, p3) and s4216b4_constructive_price(a, p4);
    then constructive_sale_price(a, min(p3, p4));
}

// =====================================================================
// Section 4216(e) — exclusion of local advertising charge from the sale price
// =====================================================================

pub enum LocalAdvertisingMedium {
    RadioStation;
    TelevisionStation;
    Newspaper;
    Magazine;
    OutdoorAdvertisingSign;
    OutdoorAdvertisingPoster;
    OtherMedium;
}
pub relation advertising_initiated_or_obtained_by_purchaser_or_vendee(a: PricedArticleSale) kind empirical {
    label en official "section 4216(e)(4)(A): the advertising is initiated or obtained by the purchaser or any subsequent vendee";
}
pub relation advertising_names_article_and_retail_location(a: PricedArticleSale) kind empirical {
    label en official "section 4216(e)(4)(B): the advertising names the article for which the price is determinable under this section and states the location at which such article may be purchased at retail";
}
pub relation advertising_medium(a: PricedArticleSale, medium: LocalAdvertisingMedium) kind empirical {
    label en official "section 4216(e)(4)(C): how the advertising is published: broadcast over a radio or television station, in a newspaper or magazine, or by an outdoor advertising sign or poster";
}
pub relation local_advertising(a: PricedArticleSale) kind institutional {
    label en official "section 4216(e)(4): the advertising is local advertising";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "(C) is broadcast over a radio station or television station, appears in a newspaper or magazine, or is displayed by means of an outdoor advertising sign or poster.")
rule LocalAdvertisingDefinition(a: PricedArticleSale, m: LocalAdvertisingMedium) strict {
    when advertising_initiated_or_obtained_by_purchaser_or_vendee(a)
        and advertising_names_article_and_retail_location(a)
        and advertising_medium(a, m)
        and (m == RadioStation or m == TelevisionStation or m == Newspaper or m == Magazine
            or m == OutdoorAdvertisingSign or m == OutdoorAdvertisingPoster);
    then local_advertising(a);
}

pub relation local_advertising_charge(a: PricedArticleSale, charge: Money) kind empirical {
    label en official "section 4216(e)(1): the amount of the charge for advertising included in the amount for which the article is sold";
}
pub relation local_advertising_charge_is_separate_charge_made_when_sold(a: PricedArticleSale) kind empirical {
    label en official "section 4216(e)(1)(B): the charge is a separate charge made when the article is sold";
}
pub relation local_advertising_charge_intended_to_be_refunded(a: PricedArticleSale) kind empirical {
    label en official "section 4216(e)(1)(C): the charge is intended to be refunded to the purchaser or any subsequent vendee in reimbursement of costs incurred for local advertising";
}
pub relation local_advertising_exclusion_conditions_met(a: PricedArticleSale) kind institutional {
    label en official "section 4216(e)(1): the charge is for local advertising and is a separate charge intended to be refunded";
}
pub relation local_advertising_excluded_amount(a: PricedArticleSale, excluded: Money) kind institutional {
    label en official "section 4216(e)(1): the part of the local-advertising charge excluded from the price: not more than 5 percent of the price determined by excluding any charge for local advertising";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "(B) is a separate charge made when the article is sold, and")
rule LocalAdvertisingExclusionConditionsMet(a: PricedArticleSale) strict {
    when local_advertising(a)
        and local_advertising_charge_is_separate_charge_made_when_sold(a)
        and local_advertising_charge_intended_to_be_refunded(a);
    then local_advertising_exclusion_conditions_met(a);
}
// P' = the section 4216(a) price less the whole advertising charge; excluded = min(charge, 5 percent of P').
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "(A) does not exceed 5 percent of the price for which the article is sold (as determined under this section by excluding any charge for local advertising),")
rule LocalAdvertisingExcludedAmount(a: PricedArticleSale, total: Money, charge: Money) strict {
    when local_advertising_exclusion_conditions_met(a)
        and price_for_tax_purposes(a, total)
        and local_advertising_charge(a, charge)
        and total >= charge;
    then local_advertising_excluded_amount(a, min(charge, round((total - charge) * S4216LocalAdvertisingCapPercent, 2, "HALF_UP")));
}

// The exclusion ceases on the first day of the fifth calendar month following the calendar year of the
// sale unless the charge has been refunded before that day.
pub relation calendar_year_following_sale_begins(a: PricedArticleSale, first_day: Date) kind empirical {
    label en official "section 4216(e)(1): the first day (January 1) of the calendar year following the calendar year during which the article was sold";
}
pub relation local_advertising_refunded_on(a: PricedArticleSale, on: Date) kind empirical {
    label en official "section 4216(e)(1): the date on which the charge (or a portion of it) was refunded to the purchaser or subsequent vendee";
}
pub relation local_advertising_exclusion_cutoff(a: PricedArticleSale, cutoff: Date) kind institutional {
    label en official "section 4216(e)(1): the first day of the fifth calendar month following the calendar year during which the article was sold";
}
pub relation local_advertising_refunded_before_cutoff(a: PricedArticleSale) kind institutional {
    label en official "section 4216(e)(1): the charge was refunded before the cutoff day";
}
pub relation local_advertising_exclusion_ceases_on(a: PricedArticleSale, cutoff: Date) kind institutional {
    label en official "section 4216(e)(1): the charge (or portion) was not refunded before the cutoff day, so the exclusion ceases to apply as of that day";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "the exclusion provided by the preceding sentence shall cease to apply as of such first day.")
rule LocalAdvertisingExclusionCutoff(a: PricedArticleSale, jan1: Date) strict {
    when local_advertising_exclusion_conditions_met(a) and calendar_year_following_sale_begins(a, jan1);
    then local_advertising_exclusion_cutoff(a, add_calendar_period(jan1, 4 calendar_month));
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "In the case of any such charge (or portion thereof) which is not so refunded before the first day of the fifth calendar month following the calendar year during which the article was sold")
rule LocalAdvertisingRefundedBeforeCutoff(a: PricedArticleSale, cutoff: Date, refunded: Date) strict {
    when local_advertising_exclusion_cutoff(a, cutoff) and local_advertising_refunded_on(a, refunded) and refunded < cutoff;
    then local_advertising_refunded_before_cutoff(a);
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "In the case of any such charge (or portion thereof) which is not so refunded before the first day of the fifth calendar month following the calendar year during which the article was sold")
rule LocalAdvertisingExclusionCeases(a: PricedArticleSale, cutoff: Date) strict {
    when local_advertising_exclusion_cutoff(a, cutoff) and not_known(local_advertising_refunded_before_cutoff(a));
    then local_advertising_exclusion_ceases_on(a, cutoff);
}

pub relation local_advertising_exclusion_computed(a: PricedArticleSale) kind institutional {
    label en official "marker: an excluded local-advertising amount was computed for this sale under section 4216(e)(1)";
}
pub relation local_advertising_exclusion_ceased(a: PricedArticleSale) kind institutional {
    label en official "marker: the local-advertising exclusion has ceased to apply for this sale under the last sentence of section 4216(e)(1)";
}
rule LocalAdvertisingExclusionComputedMarker(a: PricedArticleSale, x: Money) strict {
    when local_advertising_excluded_amount(a, x);
    then local_advertising_exclusion_computed(a);
}
rule LocalAdvertisingExclusionCeasedMarker(a: PricedArticleSale, c: Date) strict {
    when local_advertising_exclusion_ceases_on(a, c);
    then local_advertising_exclusion_ceased(a);
}

// (3): no other advertising charge is a basis for exclusion or readjustment.
pub relation advertising_charge_of_other_kind(a: PricedArticleSale, charge: Money) kind empirical {
    label en official "section 4216(e)(3): a charge or expenditure for advertising that is not a local-advertising charge within paragraphs (1), (2) and (4)";
}
pub relation advertising_not_a_basis_for_price_exclusion(a: PricedArticleSale) kind institutional {
    label en official "section 4216(e)(3): no charge or expenditure for advertising serves, for this section or section 6416(b)(1), as the basis for an exclusion from, or readjustment of, the price";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "Except to the extent provided by paragraphs (1) and (2), no charge or expenditure for advertising shall serve, for purposes of this section or section 6416(b)(1), as the basis for an exclusion from, or as a readjustment of, the price of any article.")
rule OtherAdvertisingIsNotABasisForExclusion(a: PricedArticleSale, charge: Money) strict {
    when advertising_charge_of_other_kind(a, charge) and not_known(local_advertising_exclusion_conditions_met(a));
    then advertising_not_a_basis_for_price_exclusion(a);
}

// The price after (a) and (e): the (a) price less the excluded local-advertising amount (when the exclusion has not ceased).
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "there shall be excluded a charge for local advertising (as defined in paragraph (4)) to the extent that such charge—")
rule S4216SalePriceWithLocalAdvertisingExclusion(a: PricedArticleSale, total: Money, excluded: Money) strict {
    when price_for_tax_purposes(a, total)
        and local_advertising_excluded_amount(a, excluded)
        and not_known(local_advertising_exclusion_ceased(a));
    then s4216_sale_price(a, total - excluded);
}
@source(IRC_S4216_A, relation = formalizes, coverage = exact, quote = "there shall be included any charge for coverings and containers of whatever nature, and any charge incident to placing the article in condition packed ready for shipment")
rule S4216SalePriceWithoutExclusion(a: PricedArticleSale, total: Money) strict {
    when price_for_tax_purposes(a, total) and not_known(local_advertising_exclusion_computed(a));
    then s4216_sale_price(a, total);
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "the exclusion provided by the preceding sentence shall cease to apply as of such first day.")
rule S4216SalePriceAfterExclusionCeased(a: PricedArticleSale, total: Money) strict {
    when price_for_tax_purposes(a, total) and local_advertising_exclusion_ceased(a);
    then s4216_sale_price(a, total);
}

// --- (e)(2): the aggregate limit, applied to each manufacturer at the close of each calendar quarter ---

pub entity LocalAdvertisingLedgerItem;
pub relation local_advertising_sale_ledger(
    item: LocalAdvertisingLedgerItem,
    manufacturer: Person,
    section: Integer,
    calendar_year: Integer,
    quarter: Integer,
    price_excluding_local_advertising: Money,
    excluded_charge: Money,
) kind empirical {
    label en official "section 4216(e)(2): a sale on which tax was imposed under the given section of this chapter, with its price determined by excluding all charges for local advertising and the local-advertising charge excluded under paragraph (1)";
}
pub relation local_advertising_readjustment_ledger(
    item: LocalAdvertisingLedgerItem,
    manufacturer: Person,
    section: Integer,
    calendar_year: Integer,
    quarter: Integer,
    readjustment: Money,
) kind empirical {
    label en official "section 4216(e)(2)(A)(ii): a readjustment for local advertising under section 6416(b)(1) (credits or refunds for price readjustments)";
}
pub relation local_advertising_quarter_close(manufacturer: Person, section: Integer, calendar_year: Integer, quarter: Integer) kind empirical {
    label en official "section 4216(e)(2): the close of the calendar quarter as of which the limit is applied to this manufacturer, producer, or importer";
}
pub relation local_advertising_aggregate_excess(manufacturer: Person, section: Integer, calendar_year: Integer, quarter: Integer, excess: Money) kind institutional {
    label en official "section 4216(e)(2): the amount by which the aggregate excluded charges plus readjustments (quarter and preceding quarters of the same calendar year) exceed 5 percent of the aggregate prices, excluding all local-advertising charges; zero when the limit is respected";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "The preceding sentence shall be applied to each manufacturer, producer, and importer as of the close of each calendar quarter, taking into account the items specified in subparagraphs (A) and (B) for such calendar quarter and preceding calendar quarters in the same calendar year.")
rule LocalAdvertisingAggregateExcess(m: Person, s: Integer, y: Integer, q: Integer) strict {
    when local_advertising_quarter_close(m, s, y, q);
    then local_advertising_aggregate_excess(m, s, y, q,
        max(0.00 USD,
            sum(collect all x: Money, i: LocalAdvertisingLedgerItem, qq: Integer where local_advertising_sale_ledger(i, m, s, y, qq, _, x) and qq <= q, empty: 0.00 USD)
            + sum(collect all r: Money, j: LocalAdvertisingLedgerItem, qr: Integer where local_advertising_readjustment_ledger(j, m, s, y, qr, r) and qr <= q, empty: 0.00 USD)
            - round(sum(collect all pr: Money, k: LocalAdvertisingLedgerItem, qp: Integer where local_advertising_sale_ledger(k, m, s, y, qp, pr, _) and qp <= q, empty: 0.00 USD)
                * S4216LocalAdvertisingCapPercent, 2, "HALF_UP")));
}
pub relation local_advertising_aggregate_limit_respected(manufacturer: Person, section: Integer, calendar_year: Integer, quarter: Integer) kind institutional {
    label en official "section 4216(e)(2): the aggregate of excluded charges and readjustments does not exceed 5 percent of the aggregate prices";
}
@source(IRC_S4216_E, relation = formalizes, coverage = exact, quote = "(A) The sum of (i) the aggregate of the charges for local advertising excluded under paragraph (1), plus (ii) the aggregate of the readjustments for local advertising under section 6416(b)(1) (relating to credits or refunds for price readjustments), shall not exceed")
rule LocalAdvertisingAggregateLimitRespected(m: Person, s: Integer, y: Integer, q: Integer) strict {
    when local_advertising_aggregate_excess(m, s, y, q, 0.00 USD);
    then local_advertising_aggregate_limit_respected(m, s, y, q);
}

// =====================================================================
// Section 4216(d) — sales of installment accounts
// =====================================================================

pub entity InstallmentAccountsSale : ExciseEvent;

pub relation installment_accounts_sold_or_disposed(s: InstallmentAccountsSale) kind empirical {
    label en official "section 4216(d): installment accounts, with respect to payments on which tax is being computed as provided in subsection (c), are sold or otherwise disposed of";
}
pub relation installment_payment_after_sale_of_account(inst: PartialPaymentInstallment, s: InstallmentAccountsSale) kind empirical {
    label en official "section 4216(d): the payment is a subsequent payment on an account sold or otherwise disposed of";
}
pub relation installment_payment_on_returned_account_credit_6416b5(inst: PartialPaymentInstallment) kind empirical {
    label en official "section 4216(d): the subsequent payment is on a returned account with respect to which credit or refund is allowable by reason of section 6416(b)(5)";
}
pub relation section_4216c_disapplied_after_account_sale(inst: PartialPaymentInstallment) kind institutional {
    label en official "section 4216(d): subsection (c) does not apply to this subsequent payment on a sold or disposed account";
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "then subsection (c) shall not apply with respect to any subsequent payments on such accounts (other than subsequent payments on returned accounts with respect to which credit or refund is allowable by reason of section 6416(b)(5)), but instead—")
rule SectionCDisappliedAfterSaleOfAccount(inst: PartialPaymentInstallment, s: InstallmentAccountsSale) strict {
    when installment_accounts_sold_or_disposed(s)
        and installment_payment_after_sale_of_account(inst, s)
        and not_known(installment_payment_on_returned_account_credit_6416b5(inst));
    then section_4216c_disapplied_after_account_sale(inst);
}

pub relation installment_tax_paid_item(s: InstallmentAccountsSale, n: Integer, tax_paid: Money) kind empirical {
    label en official "section 4216(d)(1)(A): the tax previously paid on one payment on the installment accounts";
}
pub relation installment_scheduled_tax_item(s: InstallmentAccountsSale, n: Integer, tax: Money) kind empirical {
    label en official "section 4216(d)(1)(B): the tax computed as provided in subsection (c) (rate on the due date times the payment) on one payment that would have fallen due had the accounts not been sold";
}
pub relation installment_tax_previously_paid(s: InstallmentAccountsSale, total: Money) kind institutional {
    label en official "section 4216(d)(1)(A): the tax previously paid on the payments on such installment accounts";
}
pub relation installment_total_tax_if_not_disposed(s: InstallmentAccountsSale, total: Money) kind institutional {
    label en official "section 4216(d)(1)(B): the total tax which would be payable if such installment accounts had not been sold or otherwise disposed of (computed as provided in subsection (c))";
}
pub relation installment_sale_tax_difference(s: InstallmentAccountsSale, amount: Money) kind institutional {
    label en official "section 4216(d)(1): the amount to be paid on the sale: the total tax (B) less the tax previously paid (A); never negative";
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "(A) the tax previously paid on the payments on such installment accounts")
rule InstallmentTaxPreviouslyPaid(s: InstallmentAccountsSale) strict {
    when installment_accounts_sold_or_disposed(s);
    then installment_tax_previously_paid(s, sum(collect all t: Money, n: Integer where installment_tax_paid_item(s, n, t), empty: 0.00 USD));
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "(B) the total tax which would be payable if such installment accounts had not been sold or otherwise disposed of (computed as provided in subsection (c))")
rule InstallmentTotalTaxIfNotDisposed(s: InstallmentAccountsSale) strict {
    when installment_accounts_sold_or_disposed(s);
    then installment_total_tax_if_not_disposed(s, sum(collect all t: Money, n: Integer where installment_scheduled_tax_item(s, n, t), empty: 0.00 USD));
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "(1) there shall be paid an amount equal to the difference between (A) the tax previously paid on the payments on such installment accounts, and (B) the total tax which would be payable if such installment accounts had not been sold or otherwise disposed of (computed as provided in subsection (c)); except that")
rule InstallmentSaleTaxDifference(s: InstallmentAccountsSale, paid: Money, total: Money) strict {
    when installment_tax_previously_paid(s, paid) and installment_total_tax_if_not_disposed(s, total);
    then installment_sale_tax_difference(s, max(0.00 USD, total - paid));
}

// (2): a sale under a court order in bankruptcy or insolvency caps the (1) amount at the sum, over the
// unpaid installments, of the proportionate share of the sale price times the rate on the due date.
// Since share_i x rate_i = S x U_i / sum(U) x rate_i, the cap is S x sum(T_i) / sum(U_i), where T_i is the
// tax on the unpaid installment payment computed as provided in subsection (c) (payment x rate on its due date).
pub relation installment_sale_pursuant_to_bankruptcy_court_order(s: InstallmentAccountsSale) kind empirical {
    label en official "section 4216(d)(2): the sale is pursuant to the order of, or subject to the approval of, a court of competent jurisdiction in a bankruptcy or insolvency proceeding";
}
pub relation installment_accounts_sale_price(s: InstallmentAccountsSale, amount: Money) kind empirical {
    label en official "section 4216(d)(2): the amount for which the accounts are sold";
}
pub relation unpaid_installment_item(s: InstallmentAccountsSale, n: Integer, unpaid_payment: Money, tax_at_due_date_rate: Money) kind empirical {
    label en official "section 4216(d)(2): one unpaid installment payment and the tax on it computed at the rate of tax in effect on the date it is or was due";
}
pub relation installment_bankruptcy_cap(s: InstallmentAccountsSale, cap: Money) kind institutional {
    label en official "section 4216(d)(2): the sum, over the unpaid installments, of the proportionate share of the sale price allocable to each times the rate in effect on its due date";
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "(2) if any such sale is pursuant to the order of, or subject to the approval of, a court of competent jurisdiction in a bankruptcy or insolvency proceeding, the amount computed under paragraph (1) shall not exceed the sum of the amounts computed by multiplying (A) the proportionate share of the amount for which such accounts are sold which is allocable to each unpaid installment payment by (B) the rate of tax under this chapter in effect on the date such unpaid installment payment is or was due.")
rule InstallmentBankruptcyCap(s: InstallmentAccountsSale, sold: Money) strict {
    when installment_sale_pursuant_to_bankruptcy_court_order(s)
        and installment_accounts_sale_price(s, sold)
        and sum(collect all u: Money, n1: Integer, t1: Money where unpaid_installment_item(s, n1, u, t1), empty: 0.00 USD) > 0.00 USD;
    then installment_bankruptcy_cap(s, div_round(sold * (sum(collect all t: Money, n2: Integer, u2: Money where unpaid_installment_item(s, n2, u2, t), empty: 0.00 USD) / 1.00 USD),
        sum(collect all u3: Money, n3: Integer, t3: Money where unpaid_installment_item(s, n3, u3, t3), empty: 0.00 USD) / 1.00 USD, 2, "HALF_UP"));
}
pub relation installment_sale_tax_amount_after_court_cap(s: InstallmentAccountsSale, amount: Money) kind institutional {
    label en official "section 4216(d)(1)-(2): the amount computed under paragraph (1), limited by paragraph (2) in a court-ordered bankruptcy or insolvency sale";
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "the amount computed under paragraph (1) shall not exceed the sum of the amounts computed by multiplying")
rule InstallmentSaleTaxLimitedByBankruptcyCap(s: InstallmentAccountsSale, diff: Money, cap: Money) strict {
    when installment_sale_tax_difference(s, diff) and installment_bankruptcy_cap(s, cap);
    then installment_sale_tax_amount_after_court_cap(s, min(diff, cap));
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "(1) there shall be paid an amount equal to the difference between (A) the tax previously paid on the payments on such installment accounts, and (B) the total tax which would be payable if such installment accounts had not been sold or otherwise disposed of (computed as provided in subsection (c)); except that")
rule InstallmentSaleTaxNotCourtOrdered(s: InstallmentAccountsSale, diff: Money) strict {
    when installment_sale_tax_difference(s, diff) and not_known(installment_sale_pursuant_to_bankruptcy_court_order(s));
    then installment_sale_tax_amount_after_court_cap(s, diff);
}

// The overall cap: the sum of the amounts payable under (d) and (c) in respect of the sale of an article does not exceed the total tax.
pub relation installment_total_tax_of_article(s: InstallmentAccountsSale, total_tax: Money) kind empirical {
    label en official "section 4216(d) last sentence: the total tax in respect of the sale of the article";
}
pub relation installment_tax_payable_under_c_in_respect_of_sale(s: InstallmentAccountsSale, amount: Money) kind empirical {
    label en official "section 4216(d) last sentence: the amounts already payable under subsection (c) in respect of the sale of the article";
}
pub relation installment_sale_tax_payable_after_total_cap(s: InstallmentAccountsSale, amount: Money) kind institutional {
    label en official "section 4216(d) last sentence: the amount payable under this subsection, limited so that with the amounts payable under subsection (c) it does not exceed the total tax";
}
@source(IRC_S4216_D, relation = formalizes, coverage = exact, quote = "The sum of the amounts payable under this subsection and subsection (c) in respect of the sale of any article shall not exceed the total tax.")
rule InstallmentSaleTaxCappedAtTotalTax(s: InstallmentAccountsSale, amt: Money, total: Money, under_c: Money) strict {
    when installment_sale_tax_amount_after_court_cap(s, amt)
        and installment_total_tax_of_article(s, total)
        and installment_tax_payable_under_c_in_respect_of_sale(s, under_c);
    then installment_sale_tax_payable_after_total_cap(s, max(0.00 USD, min(amt, total - under_c)));
}
