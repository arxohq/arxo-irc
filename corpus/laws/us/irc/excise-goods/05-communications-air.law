// Chapter 33: sections 4251 (communications services) and 4261(a)-(c) (air
// transportation of persons). Priority list, IRC-13 stage 1.

// =====================================================================
// Section 4251 — communications services
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4251_A,
    IRC_S4251_D,
    IRC_S4261_A,
    IRC_S4261_B,
    IRC_S4261_C,
    IRC_S4261_E,
    Person,
    air_taxes_a_b_excluded_by_outside_payment,
    chargeable_domestic_segment_count,
    domestic_segments_at_rural_airports,
    excise_tax_due,
    liable_for_excise,
    tax_free_sale,
};

pub entity CommunicationsPaymentEvent : ExciseEvent;

pub relation communications_payment(e: CommunicationsPaymentEvent, amount: Money, payer: Person) kind empirical {
    label en unofficial "section 4251(a): an amount paid for communications services (local telephone, toll telephone, or teletypewriter exchange service, section 4251(b)(1))";
}

@source(IRC_S4251_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on amounts paid for communications services a tax equal to the applicable percentage of amounts so paid.")
rule CommunicationsTax(e: CommunicationsPaymentEvent, amount: Money) strict {
    when communications_payment(e, amount, _);
    then excise_tax_due(e, round(amount * S4251ApplicablePercentage, 2, "HALF_UP"));
}

@source(IRC_S4251_A, relation = formalizes, coverage = exact, quote = "The tax imposed by this section shall be paid by the person paying for such services.")
rule CommunicationsLiability(e: CommunicationsPaymentEvent, payer: Person, amount: Money) defeasible {
    when communications_payment(e, _, payer) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(payer, e, amount);
}

// section 4251(c): a bill for pre-November-1 service not rendered before the
// close of the calendar year is treated as first rendered on December 31 of
// that year — a classification about WHEN the payment counts as made, not a
// separate computation; the case supplies the corrected date directly
// (`billed_on`), so this package records the rule as read but does not
// re-derive `billed_on` from an unrendered-bill fact pattern (TECH_GAP: see
// coverage note — would need a "no bill rendered by year end" case fact and
// a rule producing the December-31 date, both straightforward but out of
// this stage's budget).

// section 4251(d): prepaid telephone cards.
pub entity PrepaidTelephoneCardTransfer : ExciseEvent;
pub relation prepaid_card_transferred_to_noncarrier(e: PrepaidTelephoneCardTransfer, face_amount: Money, transferor: Person) kind empirical {
    label en unofficial "section 4251(d)(1): a telecommunications carrier transfers a prepaid telephone card, with its face amount, to a person who is not such a carrier";
}
@source(IRC_S4251_D, relation = formalizes, coverage = exact, quote = "the face amount of such card shall be treated as the amount paid for such communications services")
rule PrepaidCardTreatedAsPayment(e: PrepaidTelephoneCardTransfer, faceAmount: Money) strict {
    when prepaid_card_transferred_to_noncarrier(e, faceAmount, _);
    then excise_tax_due(e, round(faceAmount * S4251ApplicablePercentage, 2, "HALF_UP"));
}
@source(IRC_S4251_D, relation = formalizes, coverage = exact, quote = "the face amount of such card shall be treated as the amount paid for such communications services")
rule PrepaidCardLiability(e: PrepaidTelephoneCardTransfer, transferor: Person, amount: Money) defeasible {
    when prepaid_card_transferred_to_noncarrier(e, _, transferor) and excise_tax_due(e, amount);
    then liable_for_excise(transferor, e, amount);
}

// =====================================================================
// Section 4261 — air transportation of persons
// =====================================================================

pub entity AirTransportationEvent : ExciseEvent;

pub relation domestic_air_transportation_payment(e: AirTransportationEvent, amount: Money, payer: Person) kind empirical {
    label en unofficial "section 4261(a): the amount paid for taxable transportation of a person by air (the general percentage tax)";
}
pub relation domestic_segment(e: AirTransportationEvent, count: Decimal, payer: Person) kind empirical {
    label en unofficial "section 4261(b): the number of domestic segments (one takeoff and one landing each, section 4261(b)(2)) in this taxable transportation, asserted by the case; section 4261(b)(3) freezes this count against a mere rerouting that does not change the amount charged, so the case supplies the count actually chargeable rather than this package re-deriving it from a route change";
}
pub relation international_travel_payment(e: AirTransportationEvent, amount: Money, payer: Person, begins_or_ends_in_us: Boolean) kind empirical {
    label en unofficial "section 4261(c)(1): the amount paid for transportation of a person by air that begins or ends in the United States";
}
pub relation international_travel_wholly_taxable_under_a(e: AirTransportationEvent) kind empirical {
    label en unofficial "section 4261(c)(2): the exception where the transportation is entirely taxable under subsection (a) (determined without regard to sections 4281 and 4282)";
}
pub relation international_travel_alaska_hawaii_departure(e: AirTransportationEvent) kind empirical {
    label en unofficial "section 4261(c)(3): the domestic segment to which the international-facilities tax applies begins or ends in Alaska or Hawaii, and this is a departure";
}

@source(IRC_S4261_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on the amount paid for taxable transportation of any person a tax equal to 7.5 percent of the amount so paid.")
rule DomesticPercentageTax(e: AirTransportationEvent, amount: Money) strict {
    when domestic_air_transportation_payment(e, amount, _) and not_known(air_taxes_a_b_excluded_by_outside_payment(e));
    then air_transportation_percentage_tax(e, round(amount * S4261PercentageRatePercent, 2, "HALF_UP"));
}
pub relation air_transportation_percentage_tax(e: AirTransportationEvent, amount: Money) kind institutional {
    label en official "section 4261(a): the 7.5 percent component of the tax on this taxable transportation";
}

@source(IRC_S4261_B, relation = formalizes, coverage = exact, quote = "There is hereby imposed on the amount paid for each domestic segment of taxable transportation by air a tax in the amount of $3.00.")
rule DomesticSegmentFeeTax(e: AirTransportationEvent, count: Decimal) strict {
    when chargeable_domestic_segment_count(e, count)
        and not_known(air_taxes_a_b_excluded_by_outside_payment(e))
        and not_known(has_rural_airport_segments_stated(e));
    then air_transportation_segment_fee(e, round(S4261DomesticSegmentFee * count, 2, "HALF_UP"));
}
// section 4261(e)(1)(A): segments beginning or ending at a rural airport bear no segment tax
// (stage 2; `rural_airport_for_year` and the count are in 13-communications-and-air-transportation.law).
pub relation has_rural_airport_segments_stated(e: AirTransportationEvent) kind empirical {
    label en unofficial "marker: the case states how many of the event's domestic segments begin or end at a rural airport (`domestic_segments_at_rural_airports`), so the segment fee is computed net of them";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "The tax imposed by subsection (b)(1) shall not apply to any domestic segment beginning or ending at an airport which is a rural airport")
rule DomesticSegmentFeeTaxNetOfRuralAirports(e: AirTransportationEvent, count: Decimal, rural: Decimal) strict {
    when chargeable_domestic_segment_count(e, count)
        and has_rural_airport_segments_stated(e)
        and domestic_segments_at_rural_airports(e, rural)
        and count >= rural
        and not_known(air_taxes_a_b_excluded_by_outside_payment(e));
    then air_transportation_segment_fee(e, round(S4261DomesticSegmentFee * (count - rural), 2, "HALF_UP"));
}
pub relation air_transportation_segment_fee(e: AirTransportationEvent, amount: Money) kind institutional {
    label en official "section 4261(b)(1): $3.00 per domestic segment component of the tax";
}
pub relation has_domestic_segment_fee(e: AirTransportationEvent) kind empirical {
    label en unofficial "the case asserts that some domestic-segment fee applies to this event (kept apart from the amount so `not_known` can test its absence without an unbound amount variable, per this package's §190 range-restriction convention)";
}

@source(IRC_S4261_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on the amount paid for taxable transportation of any person a tax equal to 7.5 percent of the amount so paid.")
rule DomesticTotalTax(e: AirTransportationEvent, pct: Money, segFee: Money) strict {
    when air_transportation_percentage_tax(e, pct) and air_transportation_segment_fee(e, segFee);
    then excise_tax_due(e, pct + segFee);
}
@source(IRC_S4261_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed on the amount paid for taxable transportation of any person a tax equal to 7.5 percent of the amount so paid.")
rule DomesticPercentageOnlyTax(e: AirTransportationEvent, pct: Money) strict {
    when air_transportation_percentage_tax(e, pct) and not_known(has_domestic_segment_fee(e));
    then excise_tax_due(e, pct);
}

@source(IRC_S4261_C, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax of $12.00 on any amount paid (whether within or without the United States) for any transportation of any person by air, if such transportation begins or ends in the United States.")
rule InternationalFacilitiesTax(e: AirTransportationEvent, beginsOrEnds: Boolean) strict {
    when international_travel_payment(e, _, _, beginsOrEnds)
        and beginsOrEnds == true
        and not_known(international_travel_wholly_taxable_under_a(e))
        and not_known(international_travel_alaska_hawaii_departure(e));
    then excise_tax_due(e, S4261InternationalFacilitiesCharge);
}

@source(IRC_S4261_C, relation = formalizes, coverage = exact, quote = "In any case in which the tax imposed by paragraph (1) applies to a domestic segment beginning or ending in Alaska or Hawaii, such tax shall apply only to departures and shall be at the rate of $6.")
rule InternationalFacilitiesTaxAlaskaHawaii(e: AirTransportationEvent, beginsOrEnds: Boolean) strict {
    when international_travel_payment(e, _, _, beginsOrEnds)
        and beginsOrEnds == true
        and not_known(international_travel_wholly_taxable_under_a(e))
        and international_travel_alaska_hawaii_departure(e);
    then excise_tax_due(e, S4261AlaskaHawaiiRate);
}

@source(IRC_S4261_C, relation = formalizes, coverage = exact, quote = "This subsection shall not apply to any transportation all of which is taxable under subsection (a) (determined without regard to sections 4281 and 4282).")
rule InternationalTravelWhollyDomesticExempt(e: AirTransportationEvent) strict {
    when international_travel_payment(e, _, _, _) and international_travel_wholly_taxable_under_a(e);
    then tax_free_sale(e);
}

@source(IRC_S4261_A, relation = formalizes, coverage = partial, quote = "There is hereby imposed on the amount paid for taxable transportation of any person a tax equal to 7.5 percent of the amount so paid.")
rule AirTransportationLiability(e: AirTransportationEvent, payer: Person, amount: Money) defeasible {
    when (domestic_air_transportation_payment(e, _, payer) or international_travel_payment(e, _, payer, _))
        and excise_tax_due(e, amount)
        and not_known(tax_free_sale(e));
    then liable_for_excise(payer, e, amount);
}
