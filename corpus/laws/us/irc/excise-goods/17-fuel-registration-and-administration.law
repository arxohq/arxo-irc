// Stage 2: chapter 31 administration of the fuel taxes:
// section 4081(e) (refund of duplicated tax), section 4082(c)-(g) (dye
// exceptions, kerosene into aircraft, regulations), section 4083(b)-(d)
// (commercial aviation, use as removal, inspection), sections 4101-4104
// (registration, records, returns), section 4042(c)(3) and (e), section
// 4043(c)(2) (fractional ownership program). Builds on 01-motor-fuels.law and
// 09-fuel-exemptions-and-waterways.law.

// =====================================================================
// Section 4081(e) — refund where a prior tax was paid
// =====================================================================

use self::{
    ExciseEvent,
    FractionalProgramAircraft,
    IRC_S4043_C,
    IRC_S4081_E,
    IRC_S4082_C,
    IRC_S4082_D,
    IRC_S4082_E,
    IRC_S4082_G,
    IRC_S4083_B,
    IRC_S4083_C,
    IRC_S4083_D,
    IRC_S4101_A,
    IRC_S4101_B,
    IRC_S4101_C,
    IRC_S4101_D,
    IRC_S4102,
    IRC_S4104_A,
    Organ,
    Person,
    Secretary,
    TaxableFuelEvent,
    TaxableFuelKind,
    TaxableFuelTrigger,
    WaterwayFuelEvent,
    dyed_fuel_exempt_from_non_lust_tax,
    excise_tax_due,
    fuel_meets_marking_requirements_if_any,
    secretary_determines_destined_for_nontaxable_use,
    taxable_fuel_event,
    taxable_fuel_rate,
};

external judgment relation prior_tax_established_to_secretary_satisfaction_4081e(e: TaxableFuelEvent) {
    authority Secretary;
    label en official "section 4081(e): the person who paid the tax establishes to the satisfaction of the Secretary that a prior tax was paid (and not credited or refunded) with respect to the taxable fuel";
}
pub relation fuel_tax_paid_by(e: TaxableFuelEvent, payer: Person, amount: Money) kind empirical {
    label en official "the tax imposed by section 4081 on the fuel was paid by this person, in this amount";
}
pub relation fuel_tax_refund_claim(e: TaxableFuelEvent, payer: Person) kind empirical {
    label en official "the payer claims refund of the duplicated tax under section 4081(e)";
}
pub relation fuel_tax_refunded_without_interest(e: TaxableFuelEvent, payer: Person, amount: Money) kind institutional {
    label en official "section 4081(e): the tax paid by the person is refunded, without interest, as if an overpayment";
}
@source(IRC_S4081_E, relation = formalizes, coverage = exact, quote = "then an amount equal to the tax paid by such person shall be allowed as a refund (without interest) to such person")
rule Section4081eRefundPowerRule(e: TaxableFuelEvent, payer: Person, paid: Money) defeasible {
    when fuel_tax_refund_claim(e, payer) and fuel_tax_paid_by(e, payer, paid);
    then power Section4081ePriorTaxRefundClaim {
        holder payer;
        over e;
        exercise fuel_tax_refund_claim(e, payer);
        valid_when prior_tax_established_to_secretary_satisfaction_4081e(e);
        effect create(fuel_tax_refunded_without_interest(e, payer, paid));
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4082(c)-(e), (g) — dyeing exceptions, aircraft kerosene, regulations
// =====================================================================

pub relation fuel_sold_in_state_area_exempted_from_clean_air_act_dyeing(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(c)(1): the fuel is removed, entered, or sold in a State for ultimate sale or use in an area exempted from the fuel dyeing requirements under section 211(i)(4) of the Clean Air Act for the period";
}
pub relation fuel_use_certified_under_secretary_regulations(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(c)(2): the use of the fuel is certified pursuant to regulations issued by the Secretary";
}
pub relation kerosene_received_by_pipeline_or_vessel_for_non_fuel_feedstock_use(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(d)(1)(A): kerosene received by pipeline or vessel for use by the receiver in the manufacture or production of a substance other than gasoline, diesel fuel, or special fuels";
}
pub relation kerosene_removed_or_entered_for_feedstock_use_under_regulations(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(d)(1)(B): to the extent provided in regulations, removed or entered for such a use by the remover or enterer, or for resale by him for such a use by the purchaser";
}
pub relation feedstock_parties_registered_under_4101(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(d)(1), last clause: the person receiving, removing or entering the kerosene and the purchaser (if any) are registered under section 4101 with respect to the tax imposed by section 4081";
}
pub relation kerosene_received_by_registered_wholesale_distributor_selling_only_to_ultimate_vendors(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(d)(2): to the extent provided in regulations, kerosene received by a wholesale distributor registered under section 4101 that sells exclusively to ultimate vendors described in section 6427(l)(5)(B)";
}
pub relation dye_requirement_excepted(e: TaxableFuelEvent) kind institutional {
    label en official "section 4082(c), (d): paragraph (2) of subsection (a) (the dyeing requirement) does not apply";
}
@source(IRC_S4082_C, relation = formalizes, coverage = exact, quote = "(2) the use of which is certified pursuant to regulations issued by the Secretary.")
rule DyeExceptionCleanAirActArea(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and fuel_sold_in_state_area_exempted_from_clean_air_act_dyeing(e)
        and fuel_use_certified_under_secretary_regulations(e);
    then dye_requirement_excepted(e);
}
@source(IRC_S4082_D, relation = formalizes, coverage = exact, quote = "(A) received by pipeline or vessel for use by the person receiving the kerosene in the manufacture or production of any substance")
rule DyeExceptionKeroseneFeedstockReceived(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and kerosene_received_by_pipeline_or_vessel_for_non_fuel_feedstock_use(e)
        and feedstock_parties_registered_under_4101(e);
    then dye_requirement_excepted(e);
}
@source(IRC_S4082_D, relation = formalizes, coverage = exact, quote = "(B) to the extent provided in regulations, removed or entered—")
rule DyeExceptionKeroseneFeedstockRemoved(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and kerosene_removed_or_entered_for_feedstock_use_under_regulations(e)
        and feedstock_parties_registered_under_4101(e);
    then dye_requirement_excepted(e);
}
@source(IRC_S4082_D, relation = formalizes, coverage = exact, quote = "(B) sells kerosene exclusively to ultimate vendors described in section 6427(l)(5)(B) with respect to kerosene.")
rule DyeExceptionWholesaleDistributor(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and kerosene_received_by_registered_wholesale_distributor_selling_only_to_ultimate_vendors(e);
    then dye_requirement_excepted(e);
}
@source(IRC_S4082_C, relation = formalizes, coverage = exact, quote = "Paragraph (2) of subsection (a) shall not apply with respect to any diesel fuel and kerosene—")
rule DyedFuelExemptViaDyeException(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and secretary_determines_destined_for_nontaxable_use(e)
        and dye_requirement_excepted(e)
        and fuel_meets_marking_requirements_if_any(e);
    then dyed_fuel_exempt_from_non_lust_tax(e);
}

pub relation kerosene_exempt_from_4041c_other_than_prior_tax(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(e): the kerosene (other than kerosene taxed under section 4043) is exempt from the tax imposed by section 4041(c), other than by reason of a prior imposition of tax";
}
pub relation kerosene_removed_directly_into_aircraft_tank(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(e): the kerosene is removed from a refinery or terminal (including a section 4081(a)(3)(A) removal within a secure area of an airport) directly into the fuel tank of an aircraft";
}
pub relation aircraft_employed_in_foreign_trade_or_trade_with_possessions(e: TaxableFuelEvent) kind empirical {
    label en official "section 4082(e)(2): the aircraft is employed in foreign trade or trade between the United States and any of its possessions";
}
pub relation kerosene_aircraft_rate_zeroed_by_4082e(e: TaxableFuelEvent) kind institutional {
    label en official "section 4082(e)(1): the rate under section 4081(a)(2)(A)(iii) is zero";
}
pub relation kerosene_aircraft_lust_increase_zeroed_by_4082e2(e: TaxableFuelEvent) kind institutional {
    label en official "section 4082(e)(2): the increase in the rate under section 4081(a)(2)(B) (the LUST financing rate) is zero";
}
@source(IRC_S4082_E, relation = formalizes, coverage = exact, quote = "(1) the rate of tax under section 4081(a)(2)(A)(iii) shall be zero, and")
rule KeroseneIntoAircraftRateZero(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and kerosene_exempt_from_4041c_other_than_prior_tax(e)
        and kerosene_removed_directly_into_aircraft_tank(e);
    then kerosene_aircraft_rate_zeroed_by_4082e(e);
}
@source(IRC_S4082_E, relation = formalizes, coverage = exact, quote = "(2) if such aircraft is employed in foreign trade or trade between the United States and any of its possessions, the increase in such rate under section 4081(a)(2)(B) shall be zero.")
rule KeroseneIntoForeignTradeAircraftLustZero(e: TaxableFuelEvent) strict {
    when kerosene_aircraft_rate_zeroed_by_4082e(e) and aircraft_employed_in_foreign_trade_or_trade_with_possessions(e);
    then kerosene_aircraft_lust_increase_zeroed_by_4082e2(e);
}
@source(IRC_S4082_E, relation = formalizes, coverage = exact, quote = "(2) if such aircraft is employed in foreign trade or trade between the United States and any of its possessions, the increase in such rate under section 4081(a)(2)(B) shall be zero.")
rule KeroseneAircraftZeroedLustTax(e: TaxableFuelEvent, gallons: Decimal, rate: Money, on: Date) strict {
    when taxable_fuel_event(e, _, _, gallons, on, _)
        and taxable_fuel_rate(e, rate)
        and kerosene_aircraft_lust_increase_zeroed_by_4082e2(e)
        and on >= @1997-10-01 and on < @2028-10-01;
    then excise_tax_due(e, round(rate * gallons, 2, "HALF_UP"));
}
@source(IRC_S4082_E, relation = formalizes, coverage = exact, quote = "(1) the rate of tax under section 4081(a)(2)(A)(iii) shall be zero, and")
rule KeroseneAircraftZeroRate(e: TaxableFuelEvent) strict {
    when kerosene_aircraft_rate_zeroed_by_4082e(e);
    then taxable_fuel_rate(e, 0 USD);
}

pub relation secretary_prescribed_section_4082_regulations_including_pump_labeling(x: Organ) kind institutional {
    label en official "section 4082(g): the regulations necessary to carry out section 4082 are prescribed, including regulations requiring the conspicuous labeling of retail diesel fuel and kerosene pumps and other delivery facilities to assure that persons are aware of which fuel is available only for nontaxable uses";
}
@source(IRC_S4082_G, relation = formalizes, coverage = exact, quote = "The Secretary shall prescribe such regulations as may be necessary to carry out this section")
rule Section4082gRegulationsDutyRule strict {
    when true;
    then duty Section4082RegulationsDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_prescribed_section_4082_regulations_including_pump_labeling(Secretary);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 4083(b)-(d)
// =====================================================================

pub entity AircraftUse;
pub relation aircraft_use_in_business_of_transporting_persons_or_property_for_hire(u: AircraftUse) kind empirical {
    label en official "section 4083(b): any use of an aircraft in a business of transporting persons or property for compensation or hire by air";
}
pub relation aircraft_use_allocable_to_transportation_exempt_from_4261_4271(u: AircraftUse) kind empirical {
    label en official "section 4083(b): the use is properly allocable to transportation exempt from the taxes of sections 4261 and 4271 by reason of section 4281 or 4282, or subsection (h) or (i) of section 4261";
}
pub relation aircraft_use_taxed_under_4043_or_excluded_by_4043c5(u: AircraftUse, before_october_1_2028: Boolean) kind empirical {
    label en official "section 4083(b), last sentence: tax is imposed under section 4043 with respect to the fuel consumed, or no tax is imposed by reason of section 4043(c)(5), and the use is before October 1, 2028";
}
pub relation commercial_aviation_use(u: AircraftUse) kind institutional {
    label en official "section 4083(b): commercial aviation";
}
@source(IRC_S4083_B, relation = formalizes, coverage = exact, quote = "the term \"commercial aviation\" means any use of an aircraft in a business of transporting persons or property for compensation or hire by air")
rule CommercialAviationClassification(u: AircraftUse) strict {
    when aircraft_use_in_business_of_transporting_persons_or_property_for_hire(u)
        and not_known(aircraft_use_allocable_to_transportation_exempt_from_4261_4271(u))
        and not_known(aircraft_use_taxed_under_4043_or_excluded_by_4043c5(u, true));
    then commercial_aviation_use(u);
}

pub relation person_uses_taxable_fuel(e: TaxableFuelEvent, user: Person) kind empirical {
    label en official "section 4083(c): a person uses taxable fuel";
}
pub relation use_in_production_of_taxable_or_special_fuels(e: TaxableFuelEvent) kind empirical {
    label en official "section 4083(c): the use is in the production of taxable fuels or of special fuels referred to in section 4041";
}
pub relation use_of_taxable_fuel_considered_a_removal(e: TaxableFuelEvent, user: Person) kind institutional {
    label en official "section 4083(c): the use is considered a removal for purposes of chapter 32";
}
@source(IRC_S4083_C, relation = formalizes, coverage = exact, quote = "such use shall for the purposes of this chapter be considered a removal.")
rule UseOfTaxableFuelIsRemoval(e: TaxableFuelEvent, user: Person) strict {
    when person_uses_taxable_fuel(e, user) and not_known(use_in_production_of_taxable_or_special_fuels(e));
    then use_of_taxable_fuel_considered_a_removal(e, user);
}

pub relation secretary_enters_place_where_taxable_fuel_produced_or_stored(x: Organ, place: Person) kind empirical {
    label en official "section 4083(d)(1)(A): the Secretary enters a place at which taxable fuel is produced or stored to examine equipment, take samples, or inspect books, records and shipping papers";
}
@source(IRC_S4083_D, relation = formalizes, coverage = exact, quote = "the Secretary may in administering compliance with this subpart, section 4041, and penalties and other administrative provisions related thereto—")
rule Section4083dEntryLibertyRule(p: Person) strict {
    when secretary_enters_place_where_taxable_fuel_produced_or_stored(Secretary, p);
    then liberty EnterFuelProductionOrStoragePlace {
        holder Secretary;
        action secretary_enters_place_where_taxable_fuel_produced_or_stored(Secretary, p);
        window [-infinity, infinity];
    };
}
pub entity FuelInspectionRefusal;
pub relation refusal_to_admit_entry_or_permit_authorized_action(r: FuelInspectionRefusal, refuser: Person) kind empirical {
    label en official "section 4083(d)(3)(A): a refusal to admit entry or other refusal to permit an action of the Secretary authorized by paragraph (1)";
}
pub relation forfeiture_penalty_for_refusal(r: FuelInspectionRefusal, refuser: Person, amount: Money) kind institutional {
    label en official "section 4083(d)(3)(A): the penalty of section 7342 applies to each refusal, with $1,000 substituted for $500";
}
@source(IRC_S4083_D, relation = formalizes, coverage = exact, quote = "except that section 7342 shall be applied by substituting \"$1,000\" for \"$500\" for each such refusal.")
rule RefusalPenaltyAmount(r: FuelInspectionRefusal, p: Person) strict {
    when refusal_to_admit_entry_or_permit_authorized_action(r, p);
    then forfeiture_penalty_for_refusal(r, p, S4083dRefusalPenaltyPerRefusal);
}

// =====================================================================
// Sections 4101-4104 — registration, records, returns
// =====================================================================

pub enum Section4101Ground {
    SecretaryRequiredForFuelTax;
    BiodieselOrAlcoholProducerOrImporter;
    SustainableAviationFuelProducerOrImporter;
    CleanFuelProductionCreditFuelProducer;
    SecondGenerationBiofuelProducer;
}
pub relation person_within_4101a1_ground(p: Person, ground: Section4101Ground) kind empirical {
    label en official "section 4101(a)(1): the person is required by the Secretary to register with respect to the tax imposed by section 4041(a) or 4081, or produces or imports biodiesel or alcohol, produces or imports sustainable aviation fuel, produces a fuel eligible for the clean fuel production credit (pursuant to section 45Z), or produces second generation biofuel";
}
pub relation clean_fuel_produced_on(p: Person, on: Date) kind empirical {
    label en official "the date on which the person produced the fuel eligible for the clean fuel production credit (PL 117-169 section 13704(c), amended by PL 119-21 section 70521(i): fuel produced after December 31, 2024)";
}
pub relation registered_with_secretary_under_4101(p: Person) kind empirical {
    label en official "section 4101(a)(1): the person is registered with the Secretary in the form and manner prescribed by regulations";
}
pub relation required_to_register_under_4101(p: Person) kind institutional {
    label en official "section 4101(a)(1): the person is required to register";
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "Every person required by the Secretary to register under this section with respect to the tax imposed by section 4041(a) or 4081")
rule RequiredToRegisterByGround(p: Person, ground: Section4101Ground) strict {
    when person_within_4101a1_ground(p, ground) and ground != CleanFuelProductionCreditFuelProducer;
    then required_to_register_under_4101(p);
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "every person producing a fuel eligible for the clean fuel production credit (pursuant to section 45Z)")
rule RequiredToRegisterCleanFuelProducerAfter2024(p: Person, on: Date) strict {
    when person_within_4101a1_ground(p, CleanFuelProductionCreditFuelProducer) and clean_fuel_produced_on(p, on) and on > @2024-12-31;
    then required_to_register_under_4101(p);
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "shall register with the Secretary at such time, in such form and manner, and subject to such terms and conditions, as the Secretary may by regulations prescribe.")
rule Section4101a1RegistrationDutyRule(p: Person) defeasible {
    when required_to_register_under_4101(p);
    then duty RegisterUnder4101 {
        bearer p;
        goal achievement {
            condition registered_with_secretary_under_4101(p);
            window [-infinity, infinity];
        }
    };
}

pub relation secretary_requires_registration_of_ftz_terminal_operators_and_inventory_holders(x: Organ) kind institutional {
    label en official "section 4101(a)(2): the Secretary requires registration by any person which operates a terminal or refinery within a foreign trade zone or customs bonded storage facility, or holds an inventory position with respect to a taxable fuel in such a terminal";
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "The Secretary shall require registration by any person which—")
rule Section4101a2SecretaryRegistrationDutyRule strict {
    when true;
    then duty SecretaryRequiresFtzRegistration {
        bearer Secretary;
        goal achievement {
            condition secretary_requires_registration_of_ftz_terminal_operators_and_inventory_holders(Secretary);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_requires_registration_of_persons_extending_credit_on_exempt_fuel_sales(x: Organ) kind institutional {
    label en official "section 4101(a)(4): the Secretary requires registration by any person which extends credit by credit card to an ultimate purchaser described in section 6416(b)(2)(C) or (D) for taxable fuel on which tax was imposed and does not collect the tax from that purchaser";
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "(B) does not collect the amount of such tax from such ultimate purchaser.")
rule Section4101a4SecretaryRegistrationDutyRule strict {
    when true;
    then duty SecretaryRequiresCreditCardLenderRegistration {
        bearer Secretary;
        goal achievement {
            condition secretary_requires_registration_of_persons_extending_credit_on_exempt_fuel_sales(Secretary);
            window [-infinity, infinity];
        }
    };
}
pub relation vessel_operator_required_to_register(p: Person) kind empirical {
    label en official "section 4101(a)(3): the operator of a vessel is required by the Secretary to register under the section";
}
pub relation vessel_operator_displays_proof_of_registration_on_each_vessel(p: Person) kind empirical {
    label en official "section 4101(a)(3): the operator displays proof of registration through the prescribed identification device on each vessel used to transport taxable fuel";
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "shall display proof of registration through an identification device prescribed by the Secretary on each vessel used by such operator to transport any taxable fuel.")
rule Section4101a3DisplayDutyRule(p: Person) defeasible {
    when vessel_operator_required_to_register(p);
    then duty DisplayProofOfRegistrationOnVessels {
        bearer p;
        goal maintenance {
            condition vessel_operator_displays_proof_of_registration_on_each_vessel(p);
            window [-infinity, infinity];
        }
    };
}

pub relation registrant_is_corporation_with_stock_regularly_traded_on_established_market(p: Person) kind empirical {
    label en official "section 4101(a)(5): the registrant is a corporation the stock of which is regularly traded on an established securities market";
}
pub relation share_of_ownership_or_assets_held_by_new_persons_after_transaction(p: Person, share: Decimal) kind empirical {
    label en official "section 4101(a)(5): after a transaction (or series of related transactions), the share (0..1) of the interests in, or assets of, the person held by persons other than those (or persons related to them) who held more than 50 percent before";
}
pub relation reregistered_under_4101(p: Person) kind empirical {
    label en official "the person reregistered under section 4101";
}
pub relation reregistration_required_after_ownership_change(p: Person) kind institutional {
    label en official "section 4101(a)(5): a person (other than a publicly traded corporation) is required to reregister when more than 50 percent of ownership interests or assets pass to other persons";
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "shall be required to reregister under this section if after a transaction (or series of related transactions) more than 50 percent of ownership interests in, or assets of, such person are held by persons other than persons (or persons related thereto)")
rule ReregistrationRequiredAfterOwnershipChange(p: Person, share: Decimal) strict {
    when share_of_ownership_or_assets_held_by_new_persons_after_transaction(p, share)
        and share > 0.5
        and not_known(registrant_is_corporation_with_stock_regularly_traded_on_established_market(p));
    then reregistration_required_after_ownership_change(p);
}
@source(IRC_S4101_A, relation = formalizes, coverage = exact, quote = "shall be required to reregister under this section if after a transaction (or series of related transactions)")
rule Section4101a5ReregistrationDutyRule(p: Person) defeasible {
    when reregistration_required_after_ownership_change(p);
    then duty ReregisterAfterOwnershipChange {
        bearer p;
        goal achievement {
            condition reregistered_under_4101(p);
            window [-infinity, infinity];
        }
    };
}

// (b) bonds and liens
pub relation secretary_conditions_registration_on_bond_and_lien(p: Person) kind empirical {
    label en official "section 4101(b)(1): the Secretary requires, as a condition of permitting registration, a bond and agreement to a lien on property used in the business or, with consent, other property";
}
pub relation bond_and_lien_regulations_prescribed(p: Person) kind empirical {
    label en official "section 4101(b)(1): the requirement is made under regulations prescribed by the Secretary";
}
pub relation registration_conditioned_on_bond_and_lien(p: Person) kind institutional {
    label en official "section 4101(b)(1): registration is conditioned on the bond and lien";
}
@source(IRC_S4101_B, relation = formalizes, coverage = exact, quote = "the Secretary may require, as a condition of permitting any person to be registered under subsection (a), that such person—")
rule Section4101b1BondLienPowerRule(p: Person) defeasible {
    when secretary_conditions_registration_on_bond_and_lien(p);
    then power Section4101bBondAndLienCondition {
        holder Secretary;
        over p;
        exercise secretary_conditions_registration_on_bond_and_lien(p);
        valid_when bond_and_lien_regulations_prescribed(p);
        effect create(registration_conditioned_on_bond_and_lien(p));
        window [-infinity, infinity];
    };
}
pub relation lien_discharge_requested_on(p: Person, on: Date) kind empirical {
    label en official "section 4101(b)(2): a request for a discharge or release of a lien imposed under paragraph (1) in connection with a transfer of property";
}
pub relation secretary_responded_to_discharge_request(p: Person) kind empirical {
    label en official "section 4101(b)(2): the Secretary responded to the request";
}
@source(IRC_S4101_B, relation = formalizes, coverage = exact, quote = "The Secretary shall respond to any request to discharge or release a lien imposed pursuant to paragraph (1) in connection with a transfer of property not later than 90 days after the date the request for such a discharge or release is made.")
rule Section4101b2RespondWithin90DaysDutyRule(p: Person, asked: Date) defeasible {
    when lien_discharge_requested_on(p, asked);
    then duty RespondToLienDischargeRequestWithin90Days {
        bearer Secretary;
        goal achievement {
            condition secretary_responded_to_discharge_request(p);
            window [asked, add_calendar_period(asked, 90 calendar_day)];
        }
    };
}

// (c) denial, revocation or suspension of a section 4101 registration
external judgment relation secretary_determines_4101_registration_used_to_avoid_or_interfere_with_tax(p: Person) {
    authority Secretary;
    label en official "section 4101(c) with section 4222(c)(1): the Secretary determines that the person has used the registration to avoid payment of a tax or to postpone or interfere with its collection";
}
external judgment relation secretary_determines_4101_action_necessary_to_protect_revenue(p: Person) {
    authority Secretary;
    label en official "section 4101(c) with section 4222(c)(2): the Secretary determines that denial, revocation, or suspension is necessary to protect the revenue";
}
pub relation registration_under_4101_action_taken(p: Person) kind empirical {
    label en official "the Secretary denies, revokes, or suspends the person's registration under section 4101";
}
pub relation registration_under_4101_denied_revoked_or_suspended(p: Person) kind institutional {
    label en official "the registration under section 4101 is denied, revoked or suspended";
}
pub relation registration_4101_action_grounds_exist(p: Person) kind institutional {
    label en official "section 4101(c), 4222(c): a ground exists (single-atom valid_when helper)";
}
@source(IRC_S4101_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of section 4222(c) shall apply to registration under this section.")
rule Registration4101GroundAvoidance(p: Person) strict {
    when secretary_determines_4101_registration_used_to_avoid_or_interfere_with_tax(p);
    then registration_4101_action_grounds_exist(p);
}
@source(IRC_S4101_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of section 4222(c) shall apply to registration under this section.")
rule Registration4101GroundProtectRevenue(p: Person) strict {
    when secretary_determines_4101_action_necessary_to_protect_revenue(p);
    then registration_4101_action_grounds_exist(p);
}
@source(IRC_S4101_C, relation = formalizes, coverage = partial, quote = "Rules similar to the rules of section 4222(c) shall apply to registration under this section.")
rule Section4101cRegistrationActionPowerRule(p: Person) defeasible {
    when registration_under_4101_action_taken(p);
    then power Section4101cRegistrationAction {
        holder Secretary;
        over p;
        exercise registration_under_4101_action_taken(p);
        valid_when registration_4101_action_grounds_exist(p);
        effect create(registration_under_4101_denied_revoked_or_suspended(p));
        window [-infinity, infinity];
    };
}

// (d) information reporting
pub relation secretary_requires_information_reporting(p: Person) kind empirical {
    label en official "section 4101(d): the Secretary requires information reporting by the person (a registrant, or another person the Secretary deems necessary to carry out the part)";
}
pub relation information_reporting_requirement_made_by_authority(p: Person) kind empirical {
    label en official "section 4101(d): the requirement is made under the authority of the subsection";
}
pub relation information_reporting_required(p: Person) kind institutional {
    label en official "section 4101(d): the person is required to report";
}
@source(IRC_S4101_D, relation = formalizes, coverage = exact, quote = "The Secretary may require—")
rule Section4101dInformationReportingPowerRule(p: Person) defeasible {
    when secretary_requires_information_reporting(p);
    then power Section4101dRequireInformationReporting {
        holder Secretary;
        over p;
        exercise secretary_requires_information_reporting(p);
        valid_when information_reporting_requirement_made_by_authority(p);
        effect create(information_reporting_required(p));
        window [-infinity, infinity];
    };
}
pub relation reportable_transactions_in_month(p: Person, count: Integer) kind empirical {
    label en official "section 4101(d): the number of reportable transactions of a person required to report, in a month";
}
pub relation report_filed_in_electronic_format(p: Person) kind empirical {
    label en official "section 4101(d): the report is filed in electronic format";
}
@source(IRC_S4101_D, relation = formalizes, coverage = exact, quote = "Any person who is required to report under this subsection and who has 25 or more reportable transactions in a month shall file such report in electronic format.")
rule Section4101dElectronicFormatDutyRule(p: Person, n: Integer) defeasible {
    when information_reporting_required(p) and reportable_transactions_in_month(p, n) and n >= 25;
    then duty FileFuelInformationReportElectronically {
        bearer p;
        goal achievement {
            condition report_filed_in_electronic_format(p);
            window [-infinity, infinity];
        }
    };
}

// section 4102: inspection by State and local officers
pub relation state_or_local_officer_charged_with_fuel_tax_enforcement(o: Person) kind empirical {
    label en official "section 4102: an officer of a State or political subdivision charged with the enforcement or collection of a tax on any taxable fuel";
}
pub relation officer_inspects_fuel_tax_records(o: Person, subject: Person) kind empirical {
    label en official "section 4102: the officer inspects the records required to be kept with respect to the part's taxes";
}
@source(IRC_S4102, relation = formalizes, coverage = exact, quote = "records required to be kept with respect to taxes under this part shall be open to inspection by such officers of a State")
rule Section4102RecordsInspectionLibertyRule(o: Person, subject: Person) strict {
    when state_or_local_officer_charged_with_fuel_tax_enforcement(o) and officer_inspects_fuel_tax_records(o, subject);
    then liberty InspectFuelTaxRecords {
        holder o;
        action officer_inspects_fuel_tax_records(o, subject);
        window [-infinity, infinity];
    };
}

// section 4104: returns for tax benefits
pub relation claims_tax_benefit_under_34_40_or_40a(p: Person) kind empirical {
    label en official "section 4104(a)(1): the person claims tax benefits under section 34, 40 or 40A";
}
pub relation claims_tax_benefit_under_4041b2_6426_or_6427e(p: Person) kind empirical {
    label en official "section 4104(a)(2): the person claims tax benefits under section 4041(b)(2), 6426, or 6427(e)";
}
pub relation filed_return_at_time_of_claim(p: Person) kind empirical {
    label en official "section 4104(a)(1): the person files a return at the time of the claim, in the manner the Secretary prescribes";
}
pub relation filed_quarterly_return_for_benefit(p: Person) kind empirical {
    label en official "section 4104(a)(2): the person files a quarterly return, in the manner the Secretary prescribes";
}
@source(IRC_S4104_A, relation = formalizes, coverage = exact, quote = "(1) under the provisions of sections 34, 40, and 40A, to file a return at the time such person claims such benefits")
rule Section4104a1ReturnDutyRule(p: Person) defeasible {
    when claims_tax_benefit_under_34_40_or_40a(p);
    then duty FileReturnWhenClaimingFuelBenefit {
        bearer p;
        goal achievement {
            condition filed_return_at_time_of_claim(p);
            window [-infinity, infinity];
        }
    };
}
@source(IRC_S4104_A, relation = formalizes, coverage = exact, quote = "(2) under the provisions of section 4041(b)(2), 6426, or 6427(e) to file a quarterly return")
rule Section4104a2QuarterlyReturnDutyRule(p: Person) defeasible {
    when claims_tax_benefit_under_4041b2_6426_or_6427e(p);
    then duty FileQuarterlyReturnForFuelBenefit {
        bearer p;
        goal achievement {
            condition filed_quarterly_return_for_benefit(p);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 4042(c)(3) and (e); section 4043(c)(2)
// =====================================================================

pub relation waterway_use_by_state_or_political_subdivision(e: WaterwayFuelEvent) kind empirical {
    label en official "section 4042(c)(3): the use is by a State or political subdivision of a State (subparagraph (B) of subsection (d)(1) does not apply)";
}

pub relation program_has_single_fractional_ownership_manager(pr: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(2)(A): a single fractional ownership program manager provides program management services on behalf of the fractional owners";
}
pub relation program_has_one_or_more_owners_per_aircraft_with_shared_ownership(pr: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(2)(B): there are 1 or more fractional owners per aircraft, with at least 1 aircraft having more than 1 owner";
}
pub relation program_has_two_aircraft_all_interests_at_least_minimum_and_not_manager_held(pr: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(2)(C): with respect to at least 2 aircraft, none of the ownership interests are less than the minimum fractional ownership interest or held by the program manager";
}
pub relation program_has_dry_lease_aircraft_exchange_among_all_owners(pr: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(2)(D), (4): a dry-lease aircraft exchange arrangement (aircraft available as needed without crew to each fractional owner) documented by the written program agreements";
}
pub relation program_has_multi_year_program_agreements(pr: FractionalProgramAircraft) kind empirical {
    label en official "section 4043(c)(2)(E): multi-year program agreements cover the fractional ownership, program management services, and dry-lease exchange aspects";
}
pub relation fractional_ownership_aircraft_program(pr: FractionalProgramAircraft) kind institutional {
    label en official "section 4043(c)(2): a fractional ownership aircraft program";
}
@source(IRC_S4043_C, relation = formalizes, coverage = exact, quote = "(E) there are multi-year program agreements covering the fractional ownership, fractional ownership program management services, and dry-lease aircraft exchange aspects of the program.")
rule FractionalOwnershipAircraftProgramClassification(pr: FractionalProgramAircraft) strict {
    when program_has_single_fractional_ownership_manager(pr)
        and program_has_one_or_more_owners_per_aircraft_with_shared_ownership(pr)
        and program_has_two_aircraft_all_interests_at_least_minimum_and_not_manager_held(pr)
        and program_has_dry_lease_aircraft_exchange_among_all_owners(pr)
        and program_has_multi_year_program_agreements(pr);
    then fractional_ownership_aircraft_program(pr);
}
