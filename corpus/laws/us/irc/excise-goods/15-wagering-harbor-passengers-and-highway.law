// Stage 2: chapter 35 (wagering: sections 4402-4424, special taxes 4901-4907),
// chapter 36 (harbor maintenance: 4462; passengers by sea: 4471-4472; highway
// motor vehicle use tax: 4481(d)-(f), 4482, 4483). Builds on
// 06-wagering-harbor.law and 07-highway-use.law.

// =====================================================================
// Chapter 35 subchapter A — wagering tax (sections 4402-4405)
// =====================================================================

use self::{
    ExciseEvent,
    HighwayVehicleUseEvent,
    IRC_S4402,
    IRC_S4403,
    IRC_S4404,
    IRC_S4411_A,
    IRC_S4411_B,
    IRC_S4412_A,
    IRC_S4412_C,
    IRC_S4421,
    IRC_S4423,
    IRC_S4424_A,
    IRC_S4424_C,
    IRC_S4462_A,
    IRC_S4462_B,
    IRC_S4462_C,
    IRC_S4462_D,
    IRC_S4462_E,
    IRC_S4462_G,
    IRC_S4462_H,
    IRC_S4471_A,
    IRC_S4471_B,
    IRC_S4472,
    IRC_S4481_D,
    IRC_S4481_E,
    IRC_S4481_F,
    IRC_S4482_B,
    IRC_S4483_A,
    IRC_S4483_B,
    IRC_S4483_C,
    IRC_S4483_D,
    IRC_S4483_G,
    IRC_S4483_H,
    IRC_S4901_A,
    IRC_S4901_B,
    IRC_S4902,
    IRC_S4903,
    IRC_S4904,
    IRC_S4905_A,
    IRC_S4907,
    Organ,
    Person,
    PortUseDirection,
    PortUseEvent,
    Secretary,
    WagerEvent,
    excise_tax_due,
    highway_vehicle_use,
    liable_for_excise,
    port_use,
    tax_free_sale,
    wager_accepted_by,
};

pub relation wager_placed_with_state_licensed_parimutuel_enterprise(e: WagerEvent) kind empirical {
    label en official "section 4402(1): the wager is placed with, or in a wagering pool conducted by, a parimutuel wagering enterprise licensed under State law";
}
pub relation wager_placed_in_coin_operated_device(e: WagerEvent) kind empirical {
    label en official "section 4402(2): the wager is placed in a coin-operated device (as defined in section 4462 as in effect for years beginning before July 1, 1980), or the amount is paid in lieu of inserting a coin, token or similar object to operate such a device";
}
pub relation wager_in_state_agency_lottery_pool_or_sweepstakes(e: WagerEvent) kind empirical {
    label en official "section 4402(3): the wager is placed in a sweepstakes, wagering pool, or lottery conducted by an agency of a State acting under authority of State law";
}
pub relation wager_placed_with_conducting_state_agency_or_its_authorized_agents(e: WagerEvent) kind empirical {
    label en official "section 4402(3): the wager is placed with the State agency conducting the sweepstakes, pool or lottery, or with its authorized employees or agents";
}

@source(IRC_S4402, relation = formalizes, coverage = exact, quote = "a parimutuel wagering enterprise licensed under State law,")
rule ParimutuelWagerExempt(e: WagerEvent) strict {
    when wager_placed_with_state_licensed_parimutuel_enterprise(e);
    then tax_free_sale(e);
}
@source(IRC_S4402, relation = formalizes, coverage = exact, quote = "On any wager placed in a coin-operated device")
rule CoinOperatedDeviceWagerExempt(e: WagerEvent) strict {
    when wager_placed_in_coin_operated_device(e);
    then tax_free_sale(e);
}
@source(IRC_S4402, relation = formalizes, coverage = exact, quote = "On any wager placed in a sweepstakes, wagering pool, or lottery which is conducted by an agency of a State acting under authority of State law")
rule StateConductedLotteryWagerExempt(e: WagerEvent) strict {
    when wager_in_state_agency_lottery_pool_or_sweepstakes(e) and wager_placed_with_conducting_state_agency_or_its_authorized_agents(e);
    then tax_free_sale(e);
}

// section 4404: territorial extent
pub relation wager_territorial_facts_stated(e: WagerEvent) kind empirical {
    label en official "marker: the case states the section 4404 territorial facts for this wager";
}
pub relation wager_accepted_in_united_states(e: WagerEvent) kind empirical {
    label en official "section 4404(1): the wager is accepted in the United States";
}
pub relation wager_placed_by_person_in_united_states(e: WagerEvent) kind empirical {
    label en official "section 4404(2): the wager is placed by a person who is in the United States";
}
pub relation wager_with_united_states_citizen_or_resident(e: WagerEvent) kind empirical {
    label en official "section 4404(2)(A): the wager is placed with a person who is a citizen or resident of the United States";
}
pub relation wager_in_pool_or_lottery_conducted_by_united_states_citizen_or_resident(e: WagerEvent) kind empirical {
    label en official "section 4404(2)(B): the wager is placed in a wagering pool or lottery conducted by a person who is a citizen or resident of the United States";
}
pub relation wager_within_territorial_extent(e: WagerEvent) kind institutional {
    label en official "section 4404: the tax applies only to wagers accepted in the United States, or placed by a person in the United States with (or in a pool or lottery conducted by) a citizen or resident of the United States";
}
@source(IRC_S4404, relation = formalizes, coverage = exact, quote = "(1) accepted in the United States, or")
rule WagerTerritorialAcceptedInUs(e: WagerEvent) strict {
    when wager_accepted_in_united_states(e);
    then wager_within_territorial_extent(e);
}
@source(IRC_S4404, relation = formalizes, coverage = exact, quote = "(A) with a person who is a citizen or resident of the United States, or")
rule WagerTerritorialPlacedWithUsPerson(e: WagerEvent) strict {
    when wager_placed_by_person_in_united_states(e) and wager_with_united_states_citizen_or_resident(e);
    then wager_within_territorial_extent(e);
}
@source(IRC_S4404, relation = formalizes, coverage = exact, quote = "(B) in a wagering pool or lottery conducted by a person who is a citizen or resident of the United States.")
rule WagerTerritorialPoolOfUsPerson(e: WagerEvent) strict {
    when wager_placed_by_person_in_united_states(e) and wager_in_pool_or_lottery_conducted_by_united_states_citizen_or_resident(e);
    then wager_within_territorial_extent(e);
}
@source(IRC_S4404, relation = formalizes, coverage = exact, quote = "The tax imposed by this subchapter shall apply only to wagers")
rule WagerOutsideTerritorialExtentNotTaxed(e: WagerEvent) strict {
    when wager_territorial_facts_stated(e) and not_known(wager_within_territorial_extent(e));
    then tax_free_sale(e);
}

// section 4403: records
pub relation keeps_daily_record_of_gross_wagers(p: Person) kind empirical {
    label en official "section 4403: the person keeps a daily record showing the gross amount of all wagers on which he is liable, in addition to the records required under section 6001(a)";
}
@source(IRC_S4403, relation = formalizes, coverage = exact, quote = "shall keep a daily record showing the gross amount of all wagers on which he is so liable")
rule Section4403DailyRecordDutyRule(e: WagerEvent, p: Person) defeasible {
    when wager_accepted_by(e, p);
    then duty KeepDailyWagerRecord {
        bearer p;
        goal maintenance {
            condition keeps_daily_record_of_gross_wagers(p);
            window [-infinity, infinity];
        }
    };
}

// section 4421: definitions of wager and lottery
pub relation wager_on_sports_event_or_contest_with_person_in_business_of_accepting(e: WagerEvent) kind empirical {
    label en official "section 4421(1)(A): a wager with respect to a sports event or a contest placed with a person engaged in the business of accepting such wagers";
}
pub relation wager_in_pool_on_sports_event_or_contest_conducted_for_profit(e: WagerEvent) kind empirical {
    label en official "section 4421(1)(B): a wager placed in a wagering pool with respect to a sports event or a contest, if the pool is conducted for profit";
}
pub relation wager_in_lottery_conducted_for_profit(e: WagerEvent) kind empirical {
    label en official "section 4421(1)(C): a wager placed in a lottery conducted for profit";
}
pub relation lottery_game_conducted_in_presence_of_all_bettors(e: WagerEvent) kind empirical {
    label en official "section 4421(2)(A): a game of a type in which usually the wagers are placed, the winners determined, and the prizes distributed in the presence of all persons placing wagers";
}
pub relation lottery_drawing_by_exempt_organization_without_private_inurement(e: WagerEvent) kind empirical {
    label en official "section 4421(2)(B): a drawing conducted by an organization exempt from tax under sections 501 and 521, no part of the net proceeds of which inures to the benefit of any private shareholder or individual";
}
pub relation wager_within_definition_4421(e: WagerEvent) kind institutional {
    label en official "section 4421(1): a wager (the lottery limb excludes the games and drawings of 4421(2)(A), (B))";
}
@source(IRC_S4421, relation = formalizes, coverage = exact, quote = "(A) any wager with respect to a sports event or a contest placed with a person engaged in the business of accepting such wagers,")
rule WagerDefinitionSportsWithBookmaker(e: WagerEvent) strict {
    when wager_on_sports_event_or_contest_with_person_in_business_of_accepting(e);
    then wager_within_definition_4421(e);
}
@source(IRC_S4421, relation = formalizes, coverage = exact, quote = "(B) any wager placed in a wagering pool with respect to a sports event or a contest, if such pool is conducted for profit, and")
rule WagerDefinitionForProfitPool(e: WagerEvent) strict {
    when wager_in_pool_on_sports_event_or_contest_conducted_for_profit(e);
    then wager_within_definition_4421(e);
}
@source(IRC_S4421, relation = formalizes, coverage = exact, quote = "(C) any wager placed in a lottery conducted for profit.")
rule WagerDefinitionForProfitLottery(e: WagerEvent) strict {
    when wager_in_lottery_conducted_for_profit(e)
        and not_known(lottery_game_conducted_in_presence_of_all_bettors(e))
        and not_known(lottery_drawing_by_exempt_organization_without_private_inurement(e));
    then wager_within_definition_4421(e);
}

// section 4423 (liberty of the Secretary), 4424 (confidentiality)
pub relation secretary_inspects_wagering_books(x: Organ, p: Person) kind empirical {
    label en official "section 4423: the Secretary examines and inspects the books of account of a person liable for tax under the chapter";
}
@source(IRC_S4423, relation = formalizes, coverage = exact, quote = "the books of account of any person liable for tax under this chapter may be examined and inspected as frequently as may be needful to the enforcement of this chapter.")
rule Section4423InspectionLibertyRule(p: Person) strict {
    label en official "section 4423: notwithstanding section 7605(b), the Secretary may examine and inspect the books as frequently as needful";
    when wager_accepted_by(_, p);
    then liberty InspectWageringBooksAsOftenAsNeeded {
        holder Secretary;
        action secretary_inspects_wagering_books(Secretary, p);
        window [-infinity, infinity];
    };
}

pub relation treasury_officer_or_employee(p: Person) kind empirical {
    label en official "section 4424(a): the person is an officer or employee of the Treasury Department";
}
pub relation divulges_wagering_return_information(actor: Person, info_subject: Person) kind empirical {
    label en official "section 4424(a): the actor divulges or makes known to any person a return, payment or registration made under the chapter, a record required for it that the Secretary is permitted to examine or that is produced under section 7602, or information come at by exploiting them";
}
pub relation disclosure_in_connection_with_tax_administration_or_enforcement(actor: Person, info_subject: Person) kind empirical {
    label en official "section 4424(b): the disclosure is in connection with the administration or civil or criminal enforcement of a tax imposed by the title";
}
@source(IRC_S4424_A, relation = formalizes, coverage = exact, quote = "neither the Secretary nor any other officer or employee of the Treasury Department may divulge or make known in any manner whatever to any person—")
rule Section4424aConfidentialityProhibitionRule(p: Person, subject: Person) defeasible {
    when treasury_officer_or_employee(p) and divulges_wagering_return_information(p, subject);
    then prohibition WageringReturnConfidentiality {
        bearer p;
        action divulges_wagering_return_information(p, subject);
        window [-infinity, infinity];
    };
    unless disclosure_in_connection_with_tax_administration_or_enforcement(p, subject) and treasury_officer_or_employee(p) and divulges_wagering_return_information(p, subject);
}

pub relation wagering_document_possessed_by_taxpayer_used_against_in_criminal_proceeding(taxpayer: Person) kind institutional {
    label en official "section 4424(c): a special tax stamp, or a return, payment or registration copy possessed by the taxpayer (or information from exploiting them) is used against the taxpayer in a criminal proceeding";
}
pub relation holds_special_tax_stamp_or_taxpayer_copy(taxpayer: Person) kind empirical {
    label en official "section 4424(c)(1)-(2): the taxpayer holds a special-tax stamp or possesses a copy of a return, payment or registration made under the chapter";
}
@source(IRC_S4424_C, relation = formalizes, coverage = exact, quote = "shall not be used against such taxpayer in any criminal proceeding.")
rule Section4424cNoCriminalUseImmunityRule(t: Person) strict {
    when holds_special_tax_stamp_or_taxpayer_copy(t);
    then immunity WageringDocumentsNotUsableInCriminalProceeding {
        holder t;
        protected_effect wagering_document_possessed_by_taxpayer_used_against_in_criminal_proceeding(t);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Chapter 35 subchapter B — special tax on wagering (sections 4411-4414) and sections 4901-4907
// =====================================================================

pub entity SpecialTaxpayer;

pub relation liable_for_tax_under_4401(p: SpecialTaxpayer) kind empirical {
    label en official "section 4411(a): the person is liable for the tax imposed under section 4401";
}
pub relation engaged_in_receiving_wagers_for_person_liable_under_4401(p: SpecialTaxpayer) kind empirical {
    label en official "section 4411(a): the person is engaged in receiving wagers for or on behalf of a person liable under section 4401";
}
pub relation liability_under_4401_only_under_paragraph_1_of_4401a(p: SpecialTaxpayer) kind empirical {
    label en official "section 4411(b)(1): the person's liability under section 4401 is determined only under paragraph (1) of section 4401(a) (authorized wagers)";
}
pub relation receives_wagers_only_for_persons_liable_only_under_4401a1(p: SpecialTaxpayer) kind empirical {
    label en official "section 4411(b)(2): the person is engaged in receiving wagers only for or on behalf of persons described in paragraph (1)";
}
pub relation special_tax_annual_amount(p: SpecialTaxpayer, amount: Money) kind institutional {
    label en official "section 4411: the special tax per year ($500, or $50 for the persons of subsection (b))";
}
pub relation special_tax_months_in_first_period(p: SpecialTaxpayer, months: Decimal) kind empirical {
    label en official "section 4901(b): when the business commences after July 1, the number of months from the first day of the month in which liability commenced to and including June 30 following (TECH_GAP: the month count is asserted, no month-difference term)";
}
pub relation special_tax_due_for_first_period(p: SpecialTaxpayer, amount: Money) kind institutional {
    label en official "section 4901(b): the special tax reckoned proportionately from the first day of the month in which liability commenced to June 30 following";
}
pub relation special_tax_imposed_as_of_july_1(p: SpecialTaxpayer) kind empirical {
    label en official "section 4901(b): the tax is imposed as of July 1 in the year (a full year)";
}

@source(IRC_S4411_B, relation = formalizes, coverage = exact, quote = "(1) any person whose liability for tax under section 4401 is determined only under paragraph (1) of section 4401(a), and")
rule SpecialTaxAuthorizedOnly(p: SpecialTaxpayer) strict {
    when liable_for_tax_under_4401(p) and liability_under_4401_only_under_paragraph_1_of_4401a(p);
    then special_tax_annual_amount(p, S4411AuthorizedPersonsSpecialTax);
}
@source(IRC_S4411_B, relation = formalizes, coverage = exact, quote = "(2) any person who is engaged in receiving wagers only for or on behalf of persons described in paragraph (1).")
rule SpecialTaxReceiverForAuthorizedOnly(p: SpecialTaxpayer) strict {
    when engaged_in_receiving_wagers_for_person_liable_under_4401(p) and receives_wagers_only_for_persons_liable_only_under_4401a1(p);
    then special_tax_annual_amount(p, S4411AuthorizedPersonsSpecialTax);
}
@source(IRC_S4411_A, relation = formalizes, coverage = exact, quote = "There shall be imposed a special tax of $500 per year to be paid by each person who is liable for the tax imposed under section 4401")
rule SpecialTaxGeneral(p: SpecialTaxpayer) strict {
    when liable_for_tax_under_4401(p) and not_known(liability_under_4401_only_under_paragraph_1_of_4401a(p));
    then special_tax_annual_amount(p, S4411SpecialTax);
}
@source(IRC_S4411_A, relation = formalizes, coverage = exact, quote = "or who is engaged in receiving wagers for or on behalf of any person so liable.")
rule SpecialTaxReceiverGeneral(p: SpecialTaxpayer) strict {
    when engaged_in_receiving_wagers_for_person_liable_under_4401(p) and not_known(receives_wagers_only_for_persons_liable_only_under_4401a1(p));
    then special_tax_annual_amount(p, S4411SpecialTax);
}
@source(IRC_S4901_B, relation = formalizes, coverage = exact, quote = "in the latter case it shall be reckoned proportionately, from the first day of the month in which the liability to a special tax commenced, to and including the 30th day of June following.")
rule SpecialTaxProportionalFirstPeriod(p: SpecialTaxpayer, annual: Money, months: Decimal) strict {
    when special_tax_annual_amount(p, annual) and special_tax_months_in_first_period(p, months);
    then special_tax_due_for_first_period(p, div_round(annual * months, 12.0, 2, "HALF_UP"));
}
@source(IRC_S4901_B, relation = formalizes, coverage = exact, quote = "In the former case the tax shall be reckoned for 1 year")
rule SpecialTaxFullYearAtJuly1(p: SpecialTaxpayer, annual: Money) strict {
    when special_tax_annual_amount(p, annual) and special_tax_imposed_as_of_july_1(p);
    then special_tax_due_for_first_period(p, annual);
}

// section 4901(a): prohibition
pub relation engaged_in_business_subject_to_special_tax_4411(p: SpecialTaxpayer) kind empirical {
    label en official "section 4901(a): the person is engaged in or carries on a trade or business subject to the tax imposed by section 4411 (wagering)";
}
pub relation has_paid_special_tax(p: SpecialTaxpayer) kind empirical {
    label en official "section 4901(a): the person has paid the special tax for the business";
}
@source(IRC_S4901_A, relation = formalizes, coverage = exact, quote = "No person shall be engaged in or carry on any trade or business subject to the tax imposed by section 4411 (wagering) until he has paid the special tax therefor.")
rule Section4901aSpecialTaxConditionPrecedentRule(p: SpecialTaxpayer) defeasible {
    when engaged_in_business_subject_to_special_tax_4411(p);
    then prohibition NoWageringBusinessBeforeSpecialTaxPaid {
        bearer p;
        action engaged_in_business_subject_to_special_tax_4411(p);
        window [-infinity, infinity];
    };
    unless has_paid_special_tax(p) and engaged_in_business_subject_to_special_tax_4411(p);
}

// section 4412: registration
pub relation registered_special_tax_particulars_with_secretary(p: SpecialTaxpayer) kind empirical {
    label en official "section 4412(a)-(b): the person registered his name and place of residence, each place of business and the persons who receive wagers for him (for a firm or company, the names and residences of the persons constituting it)";
}
@source(IRC_S4412_A, relation = formalizes, coverage = exact, quote = "Each person required to pay a special tax under this subchapter shall register with the official in charge of the internal revenue district—")
rule Section4412RegistrationDutyRule(p: SpecialTaxpayer) defeasible {
    when special_tax_annual_amount(p, _);
    then duty RegisterForWageringSpecialTax {
        bearer p;
        goal achievement {
            condition registered_special_tax_particulars_with_secretary(p);
            window [-infinity, infinity];
        }
    };
}
pub relation secretary_requires_supplemental_registration_information(p: SpecialTaxpayer) kind empirical {
    label en official "the Secretary requires supplemental information from a person required to register";
}
pub relation supplemental_information_needful_to_enforce_chapter(p: SpecialTaxpayer) kind empirical {
    label en official "section 4412(c): the information is needful to the enforcement of the chapter and the requirement accords with regulations prescribed by the Secretary";
}
pub relation supplemental_registration_information_required(p: SpecialTaxpayer) kind institutional {
    label en official "section 4412(c): the person must furnish the supplemental information";
}
@source(IRC_S4412_C, relation = formalizes, coverage = exact, quote = "the Secretary may require from time to time such supplemental information from any person required to register under this section as may be needful to the enforcement of this chapter.")
rule Section4412cSupplementalInformationPowerRule(p: SpecialTaxpayer) defeasible {
    when secretary_requires_supplemental_registration_information(p);
    then power RequireSupplementalRegistrationInformation {
        holder Secretary;
        over p;
        exercise secretary_requires_supplemental_registration_information(p);
        valid_when supplemental_information_needful_to_enforce_chapter(p);
        effect create(supplemental_registration_information_required(p));
        window [-infinity, infinity];
    };
}

// sections 4902, 4903, 4904, 4905, 4907
pub entity CopartnershipBusiness;
pub relation copartnership_business_at_one_place(b: CopartnershipBusiness, persons: Integer) kind empirical {
    label en official "section 4902: any number of persons doing business in copartnership at any one place";
}
pub relation special_taxes_payable_by_copartnership(b: CopartnershipBusiness, count: Integer) kind institutional {
    label en official "section 4902: the number of special taxes required (one)";
}
@source(IRC_S4902, relation = formalizes, coverage = exact, quote = "shall be required to pay but one special tax.")
rule CopartnershipPaysOneSpecialTax(b: CopartnershipBusiness, n: Integer) strict {
    when copartnership_business_at_one_place(b, n) and n >= 1;
    then special_taxes_payable_by_copartnership(b, 1);
}

pub relation carries_on_business_at_place_not_stated_in_register(p: SpecialTaxpayer) kind empirical {
    label en official "section 4903: the person carries on a trade or business in a place other than that stated in the register kept in the office of the official in charge of the internal revenue district";
}
pub relation storage_of_goods_only_at_other_place(p: SpecialTaxpayer) kind empirical {
    label en official "section 4903: the other place is used only for the storage of goods, wares or merchandise";
}
pub relation manufacturer_selling_own_goods_at_place_of_production_or_principal_office(p: SpecialTaxpayer) kind empirical {
    label en official "section 4903: sale by manufacturers or producers of their own goods at the place of production or manufacture, and at their principal office, no goods kept except as samples";
}
pub relation special_tax_paid_other_than_4411(p: SpecialTaxpayer) kind empirical {
    label en official "section 4903: the special tax paid is a special tax other than the tax imposed by section 4411";
}
pub relation additional_special_tax_required_for_other_place(p: SpecialTaxpayer) kind institutional {
    label en official "section 4903: the payment of a special tax (other than under section 4411) does not exempt a person carrying on business in another place from an additional special tax";
}
@source(IRC_S4903, relation = formalizes, coverage = exact, quote = "shall not exempt from an additional special tax the person carrying on a trade or business in any other place than that stated in the register")
rule AdditionalSpecialTaxOtherPlace(p: SpecialTaxpayer) strict {
    when special_tax_paid_other_than_4411(p)
        and carries_on_business_at_place_not_stated_in_register(p)
        and not_known(storage_of_goods_only_at_other_place(p))
        and not_known(manufacturer_selling_own_goods_at_place_of_production_or_principal_office(p));
    then additional_special_tax_required_for_other_place(p);
}

pub entity SpecialTaxPursuit;
pub relation pursuit_special_tax_rate(pursuit: SpecialTaxPursuit, holder: Person, amount: Money) kind empirical {
    label en official "section 4904: the special tax severally prescribed for one of the pursuits or occupations carried on in the same place by the same person at the same time";
}
pub relation special_tax_total_for_pursuits_of_holder(holder: Person, total: Money) kind institutional {
    label en official "section 4904: the tax is paid for each pursuit according to the rates severally prescribed";
}
@source(IRC_S4904, relation = formalizes, coverage = exact, quote = "the tax shall be paid for each according to the rates severally prescribed.")
rule SpecialTaxTotalForSeveralPursuits(holder: Person) strict {
    when pursuit_special_tax_rate(_, holder, _);
    then special_tax_total_for_pursuits_of_holder(holder, sum all a: Money for pu: SpecialTaxPursuit where pursuit_special_tax_rate(pu, holder, a));
}

pub relation special_taxpayer_died_and_successor_carries_on(deceased: Person, successor: Person) kind empirical {
    label en official "section 4905(a): the person who paid the special tax died, and his spouse, child, executors, administrators or other legal representatives carry on the same trade or business in the same house and premises for the residue of the term";
}
pub relation additional_special_tax_imposed_on_successor(successor: Person, deceased: Person) kind institutional {
    label en official "an additional special tax is imposed on the successor for the residue of the term";
}
@source(IRC_S4905_A, relation = formalizes, coverage = exact, quote = "may occupy the house or premises, and in like manner carry on, for the residue of the term for which the tax is paid, the same trade or business as the deceased before carried on, in the same house and upon the same premises, without the payment of any additional tax.")
rule Section4905aSuccessorImmunityRule(d: Person, s: Person) strict {
    when special_taxpayer_died_and_successor_carries_on(d, s);
    then immunity SuccessorNoAdditionalSpecialTaxForResidueOfTerm {
        holder s;
        protected_effect additional_special_tax_imposed_on_successor(s, d);
        window [-infinity, infinity];
    };
}
pub relation special_tax_business_removed_to_place_specified_in_register(p: Person) kind empirical {
    label en official "section 4905(a): a person who paid the special tax removes to another place and carries on the business specified in the register there";
}
pub relation additional_special_tax_imposed_on_remover(p: Person) kind institutional {
    label en official "an additional special tax is imposed because of the removal";
}
@source(IRC_S4905_A, relation = formalizes, coverage = exact, quote = "he may carry on the trade or business specified in the register kept in the office of the official in charge of the internal revenue district at the place to which he removes, without the payment of any additional tax")
rule Section4905aRemovalImmunityRule(p: Person) strict {
    when special_tax_business_removed_to_place_specified_in_register(p);
    then immunity RemovalNoAdditionalSpecialTax {
        holder p;
        protected_effect additional_special_tax_imposed_on_remover(p);
        window [-infinity, infinity];
    };
}
pub relation death_change_or_removal_case(p: Person) kind empirical {
    label en official "section 4905(a) proviso: a case of death, change or removal, with the name of the successor or of the person making the change or removal";
}
pub relation death_change_or_removal_registered_with_secretary(p: Person) kind empirical {
    label en official "section 4905(a) proviso: the case is registered with the Secretary under regulations";
}
@source(IRC_S4905_A, relation = formalizes, coverage = exact, quote = "Provided, That all cases of death, change, or removal, as aforesaid, with the name of the successor to any person deceased, or of the person making such change or removal, shall be registered with the Secretary")
rule Section4905aRegistrationDutyRule(p: Person) defeasible {
    when death_change_or_removal_case(p);
    then duty RegisterDeathChangeOrRemovalOfSpecialTaxBusiness {
        bearer p;
        goal achievement {
            condition death_change_or_removal_registered_with_secretary(p);
            window [-infinity, infinity];
        }
    };
}

pub relation united_states_agency_or_instrumentality_special_tax_subject(a: Person) kind empirical {
    label en official "section 4907: the person is an agency or instrumentality of the United States carrying on a business subject to a special tax other than the section 4411 tax";
}
pub relation agency_granted_specific_statutory_exemption_from_special_tax(a: Person) kind empirical {
    label en official "section 4907: the agency or instrumentality is granted by statute a specific exemption from the tax";
}
pub relation special_tax_applies_to_united_states_agency(a: Person) kind institutional {
    label en official "section 4907: the special tax applies to the agency or instrumentality";
}
@source(IRC_S4907, relation = formalizes, coverage = exact, quote = "shall apply to any agency or instrumentality of the United States unless such agency or instrumentality is granted by statute a specific exemption from such tax.")
rule SpecialTaxAppliesToUnitedStatesAgencies(a: Person) strict {
    when united_states_agency_or_instrumentality_special_tax_subject(a) and not_known(agency_granted_specific_statutory_exemption_from_special_tax(a));
    then special_tax_applies_to_united_states_agency(a);
}

// =====================================================================
// Section 4462 — harbor maintenance tax: definitions and exemptions
// =====================================================================

pub enum PortCargoRoute {
    MainlandPortToAlaskaHawaiiOrPossessionForUltimateUseThere;
    AlaskaHawaiiOrPossessionToMainlandOrSuchAreaForUltimateUseThere;
    UnloadingOfCargoDescribedInPrecedingRoutes;
    LoadedAndUnloadedInSameStateOrPossession;
    PassengersOnUsFlagVesselsOperatingSolelyWithinStateWatersOfAlaskaOrHawaii;
    OtherRoute;
}

pub relation port_use_cargo_route(e: PortUseEvent, route: PortCargoRoute) kind empirical {
    label en official "section 4462(b)(1): the route of the cargo of this port use";
}
pub relation port_use_cargo_is_crude_oil_from_alaska(e: PortUseEvent) kind empirical {
    label en official "section 4462(b)(2): the cargo is crude oil with respect to Alaska (not cargo for subsection (b))";
}
pub relation vessel_fuel_subject_to_section_4042_tax(e: PortUseEvent) kind empirical {
    label en official "section 4462(c): any fuel of the vessel has been or will be subject to the tax imposed by section 4042";
}
pub relation cargo_to_be_exported_from_united_states(e: PortUseEvent) kind empirical {
    label en official "section 4462(d): the commercial cargo is to be exported from the United States";
}
pub relation port_use_by_united_states_or_agency(e: PortUseEvent) kind empirical {
    label en official "section 4462(e): the tax would be imposed on the United States or an agency or instrumentality of it";
}
pub relation nonprofit_owned_or_financed_cargo_certified_humanitarian(e: PortUseEvent) kind empirical {
    label en official "section 4462(h): cargo owned or financed by a nonprofit organization or cooperative and certified by the United States Customs Service as intended for humanitarian or development assistance overseas";
}
pub relation cargo_already_taxed_on_same_vessel_loading_or_unloading(e: PortUseEvent) kind empirical {
    label en official "section 4462(g)(1): a tax under section 4461(a) was already imposed on the loading on and unloading from (or unloading and loading on) the same vessel of the same cargo";
}
pub relation port_use_is_movement_of_cargo_within_port(e: PortUseEvent) kind empirical {
    label en official "section 4462(g)(2): the mere movement of cargo within a port (under regulations)";
}
pub relation relay_cargo_already_taxed_under_single_bill_of_lading(e: PortUseEvent) kind empirical {
    label en official "section 4462(g)(3): cargo moving under a single bill of lading unloaded from one vessel and loaded onto another for relay to or from Alaska, Hawaii or a possession, on which one tax was imposed";
}
pub relation vessel_is_ferry_engaged_primarily_in_ferrying_passengers(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(4)(B): a ferry (a vessel arriving in the United States on a regular schedule during its operating season at intervals of at least once each business day) engaged primarily in ferrying passengers between points within the United States or between the United States and contiguous countries";
}
pub relation cargo_is_bunker_fuel_stores_or_operating_equipment(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(3)(B)(i): bunker fuel, ship's stores, sea stores, or the legitimate equipment necessary to the operation of the vessel";
}
pub relation cargo_is_fish_caught_and_not_previously_landed(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(3)(B)(ii): fish or other aquatic animal life caught and not previously landed on shore";
}
pub relation harbor_is_inland_waterway_or_not_open_to_public_navigation(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(2)(A): the channel or harbor is an inland waterway or is not open to public navigation";
}
pub relation harbor_without_federal_funds_since_1977_or_deauthorized_before_1985(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(2)(B): no Federal funds have been used since 1977 for construction, maintenance, or operation of the channel or harbor, or it was deauthorized by Federal law before 1985";
}
pub relation port_use_passenger_charge(e: PortUseEvent, actual_charge: Money) kind empirical {
    label en official "section 4462(a)(5)(B): the actual charge paid for the transportation of passengers for hire";
}
pub relation port_use_prevailing_charge_for_comparable_service(e: PortUseEvent, prevailing_charge: Money) kind empirical {
    label en official "section 4462(a)(5)(B): the prevailing charge for comparable service when no actual charge is paid";
}
pub relation port_use_passenger_value(e: PortUseEvent, value: Money) kind institutional {
    label en official "section 4462(a)(5)(B): the value of the transportation of passengers for hire";
}
pub relation port_use_passenger_charge_stated(e: PortUseEvent) kind empirical {
    label en official "marker: an actual charge is stated for this passenger port use";
}

@source(IRC_S4462_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4461(a) with respect to—")
rule PortUseAlaskaHawaiiPossessionRoutes(e: PortUseEvent, route: PortCargoRoute) strict {
    when port_use_cargo_route(e, route)
        and route != OtherRoute
        and not_known(port_use_cargo_is_crude_oil_from_alaska(e));
    then tax_free_sale(e);
}
@source(IRC_S4462_C, relation = formalizes, coverage = exact, quote = "if any fuel of such vessel has been (or will be) subject to the tax imposed by section 4042")
rule PortUseVesselFuelTaxedUnder4042Exempt(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and vessel_fuel_subject_to_section_4042_tax(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_D, relation = formalizes, coverage = exact, quote = "The tax imposed by section 4461(a) shall not apply to any port use with respect to any commercial cargo to be exported from the United States.")
rule PortUseExportCargoExempt(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and cargo_to_be_exported_from_united_states(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_E, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under this subchapter on the United States or any agency or instrumentality thereof.")
rule PortUseUnitedStatesExempt(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and port_use_by_united_states_or_agency(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_H, relation = formalizes, coverage = exact, quote = "which is certified by the United States Customs Service as intended for use in humanitarian or development assistance overseas.")
rule PortUseHumanitarianCargoExempt(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and nonprofit_owned_or_financed_cargo_certified_humanitarian(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_G, relation = formalizes, coverage = exact, quote = "Only 1 tax shall be imposed under section 4461(a) with respect to the loading on and unloading from, or the unloading from and the loading on, the same vessel of the same cargo.")
rule PortUseTaxedOnlyOncePerVesselCargo(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and cargo_already_taxed_on_same_vessel_loading_or_unloading(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_G, relation = formalizes, coverage = exact, quote = "Under regulations, no tax shall be imposed under section 4461(a) on the mere movement of cargo within a port.")
rule PortUseIntraportMovementExempt(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and port_use_is_movement_of_cargo_within_port(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_G, relation = formalizes, coverage = exact, quote = "Only 1 tax shall be imposed under section 4461(a) on cargo (moving under a single bill of lading)")
rule PortUseRelayCargoTaxedOnce(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and relay_cargo_already_taxed_under_single_bill_of_lading(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "The term \"commercial vessel\" does not include any ferry engaged primarily in the ferrying of passengers")
rule PortUseFerryNotCommercialVessel(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and vessel_is_ferry_engaged_primarily_in_ferrying_passengers(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "(i) bunker fuel, ship's stores, sea stores, or the legitimate equipment necessary to the operation of a vessel, or")
rule PortUseBunkerFuelNotCommercialCargo(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and cargo_is_bunker_fuel_stores_or_operating_equipment(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "(ii) fish or other aquatic animal life caught and not previously landed on shore.")
rule PortUseCaughtFishNotCommercialCargo(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and cargo_is_fish_caught_and_not_previously_landed(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "(i) is not an inland waterway, and")
rule PortUseInlandOrClosedHarborNotPort(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and harbor_is_inland_waterway_or_not_open_to_public_navigation(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "The term \"port\" does not include any channel or harbor with respect to which no Federal funds have been used since 1977")
rule PortUseUnfundedOrDeauthorizedHarborNotPort(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and harbor_without_federal_funds_since_1977_or_deauthorized_before_1985(e);
    then tax_free_sale(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "the term \"value\" means the actual charge paid for such service or the prevailing charge for comparable service if no actual charge is paid.")
rule PassengerValueActualCharge(e: PortUseEvent, actual: Money) strict {
    when port_use_passenger_charge(e, actual);
    then port_use_passenger_value(e, actual);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "the term \"value\" means the actual charge paid for such service or the prevailing charge for comparable service if no actual charge is paid.")
rule PassengerValuePrevailingCharge(e: PortUseEvent, prevailing: Money) strict {
    when port_use_prevailing_charge_for_comparable_service(e, prevailing) and not_known(port_use_passenger_charge_stated(e));
    then port_use_passenger_value(e, prevailing);
}

// =====================================================================
// Sections 4471-4472 — tax on passengers of certain commercial vessels
// =====================================================================

pub entity CommercialPassengerVoyageEvent : ExciseEvent;

pub relation commercial_passenger_voyage(e: CommercialPassengerVoyageEvent, passengers: Decimal, provider: Person, berth_capacity: Integer, voyage_hours: Decimal) kind empirical {
    label en official "sections 4471(a), 4472: the number of passengers of the voyage, the person providing the voyage, the passenger vessel's berth or stateroom capacity and the length of the voyage in hours";
}
pub relation voyage_extends_over_one_or_more_nights(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4472(1)(A)(i): the voyage of a commercial passenger vessel extends over 1 or more nights";
}
pub relation voyage_of_gambling_vessel_beyond_us_territorial_waters(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4472(1)(A)(ii): a commercial vessel transporting passengers engaged in gambling aboard the vessel beyond the territorial waters of the United States";
}
pub relation passengers_embark_or_disembark_in_united_states(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4472(1)(A): passengers embark or disembark the vessel in the United States during the voyage";
}
pub relation vessel_owned_or_operated_by_government(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4472(1)(A), last sentence: the vessel is owned or operated by the United States, a State, or an agency or subdivision of them";
}
pub relation voyage_between_two_us_ports(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4472(1)(B): the voyage is between 2 ports in the United States";
}
pub relation covered_voyage(e: CommercialPassengerVoyageEvent) kind institutional {
    label en official "section 4472(1): a covered voyage";
}
pub relation passenger_vessel(e: CommercialPassengerVoyageEvent) kind institutional {
    label en official "section 4472(2): a vessel having berth or stateroom accommodations for more than 16 passengers";
}
pub relation passenger_tax_imposed_earlier_for_passenger(e: CommercialPassengerVoyageEvent) kind empirical {
    label en official "section 4471(c): the tax has already been imposed for the passenger on the covered voyage, at first embarkation or disembarkation in the United States";
}
@source(IRC_S4472, relation = formalizes, coverage = exact, quote = "The term \"passenger vessel\" means any vessel having berth or stateroom accommodations for more than 16 passengers.")
rule PassengerVesselClassification(e: CommercialPassengerVoyageEvent, berths: Integer) strict {
    when commercial_passenger_voyage(e, _, _, berths, _) and berths > 16;
    then passenger_vessel(e);
}
@source(IRC_S4472, relation = formalizes, coverage = exact, quote = "(i) a commercial passenger vessel which extends over 1 or more nights, or")
rule CoveredVoyageOvernight(e: CommercialPassengerVoyageEvent, hours: Decimal) strict {
    when voyage_extends_over_one_or_more_nights(e)
        and passengers_embark_or_disembark_in_united_states(e)
        and not_known(vessel_owned_or_operated_by_government(e))
        and commercial_passenger_voyage(e, _, _, _, hours)
        and not_known(short_voyage_between_us_ports(e));
    then covered_voyage(e);
}
pub relation short_voyage_between_us_ports(e: CommercialPassengerVoyageEvent) kind institutional {
    label en official "section 4472(1)(B): a voyage of a passenger vessel of less than 12 hours between 2 ports in the United States";
}
@source(IRC_S4472, relation = formalizes, coverage = exact, quote = "The term \"covered voyage\" shall not include a voyage of a passenger vessel of less than 12 hours between 2 ports in the United States.")
rule ShortVoyageBetweenUsPortsClassification(e: CommercialPassengerVoyageEvent, hours: Decimal) strict {
    when passenger_vessel(e) and voyage_between_two_us_ports(e) and commercial_passenger_voyage(e, _, _, _, hours) and hours < 12.0;
    then short_voyage_between_us_ports(e);
}
@source(IRC_S4472, relation = formalizes, coverage = exact, quote = "(ii) a commercial vessel transporting passengers engaged in gambling aboard the vessel beyond the territorial waters of the United States,")
rule CoveredVoyageGambling(e: CommercialPassengerVoyageEvent) strict {
    when voyage_of_gambling_vessel_beyond_us_territorial_waters(e)
        and passengers_embark_or_disembark_in_united_states(e)
        and not_known(vessel_owned_or_operated_by_government(e));
    then covered_voyage(e);
}
@source(IRC_S4471_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax of $3 per passenger on a covered voyage.")
rule PassengerVoyageTax(e: CommercialPassengerVoyageEvent, passengers: Decimal) strict {
    when commercial_passenger_voyage(e, passengers, _, _, _) and covered_voyage(e) and not_known(passenger_tax_imposed_earlier_for_passenger(e));
    then excise_tax_due(e, round(S4471PassengerTaxPerPassenger * passengers, 2, "HALF_UP"));
}
@source(IRC_S4471_B, relation = formalizes, coverage = exact, quote = "The tax imposed by this section shall be paid by the person providing the covered voyage.")
rule PassengerVoyageLiability(e: CommercialPassengerVoyageEvent, provider: Person, amount: Money) defeasible {
    when commercial_passenger_voyage(e, _, provider, _, _) and excise_tax_due(e, amount);
    then liable_for_excise(provider, e, amount);
}

// =====================================================================
// Sections 4481(d)-(f), 4482, 4483 — highway motor vehicle use tax
// =====================================================================

pub relation highway_use_date(e: HighwayVehicleUseEvent, on: Date) kind empirical {
    label en official "sections 4481(f), 4483(i): the date of the use";
}
pub relation highway_tax_already_paid_for_vehicle_in_period(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4481(d): the tax imposed by the section has been paid with respect to this vehicle for the taxable period";
}
@source(IRC_S4481_D, relation = formalizes, coverage = exact, quote = "no further tax shall be imposed by this section for such taxable period with respect to such vehicle.")
rule HighwayUseOneTaxPerPeriod(e: HighwayVehicleUseEvent) strict {
    when highway_vehicle_use(e, _, _) and highway_tax_already_paid_for_vehicle_in_period(e);
    then tax_free_sale(e);
}
@source(IRC_S4481_F, relation = formalizes, coverage = exact, quote = "The tax imposed by this section shall apply only to use before October 1, 2029.")
rule HighwayUseAfterSeptember30_2029NotTaxed(e: HighwayVehicleUseEvent, on: Date) strict {
    when highway_vehicle_use(e, _, _) and highway_use_date(e, on) and on >= @2029-10-01;
    then tax_free_sale(e);
}

pub relation highway_return_vehicles_count(p: Person, vehicles: Integer) kind empirical {
    label en official "section 4481(e): the number of vehicles for which the taxpayer files a return under section 4481 for the taxable period";
}
pub relation highway_return_filed_electronically(p: Person) kind empirical {
    label en official "section 4481(e): the return is filed electronically";
}
@source(IRC_S4481_E, relation = formalizes, coverage = exact, quote = "Any taxpayer who files a return under this section with respect to 25 or more vehicles for any taxable period shall file such return electronically.")
rule Section4481eElectronicFilingDutyRule(p: Person, n: Integer) defeasible {
    when highway_return_vehicles_count(p, n) and n >= 25;
    then duty FileHighwayUseReturnElectronically {
        bearer p;
        goal achievement {
            condition highway_return_filed_electronically(p);
            window [-infinity, infinity];
        }
    };
}

// section 4482(b): taxable gross weight
pub relation highway_weight_components(e: HighwayVehicleUseEvent, vehicle_unloaded_pounds: Decimal, customary_trailers_unloaded_pounds: Decimal, maximum_customary_load_pounds: Decimal) kind empirical {
    label en official "section 4482(b): the actual unloaded weight of the fully equipped vehicle, the actual unloaded weight of the fully equipped semitrailers and trailers customarily used with vehicles of its type, and the weight of the maximum load customarily carried on such vehicles and trailers";
}
pub relation highway_taxable_gross_weight_computed(e: HighwayVehicleUseEvent, pounds: Decimal) kind institutional {
    label en official "section 4482(b): the sum of the unloaded weights and the maximum customary load";
}
@source(IRC_S4482_B, relation = formalizes, coverage = exact, quote = "For purposes of this subchapter, the term \"taxable gross weight\", when used with respect to any highway motor vehicle, means the sum of—")
rule HighwayTaxableGrossWeightSum(e: HighwayVehicleUseEvent, v: Decimal, t: Decimal, l: Decimal) strict {
    when highway_weight_components(e, v, t, l);
    then highway_taxable_gross_weight_computed(e, v + t + l);
}

// section 4483: exemptions
pub relation highway_use_by_state_or_political_subdivision(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(a): the vehicle is used by a State or a political subdivision of a State";
}
pub relation transit_type_bus_meeting_60_percent_test(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(c): a transit-type bus used by a person who met the 60-percent passenger fare revenue test of former section 6421(b)(2) for the last 3 months of the preceding year (or another period prescribed)";
}
pub relation highway_vehicle_of_section_4053_8(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(g): the vehicle is described in section 4053(8) (mobile machinery)";
}
pub relation blood_collector_vehicle_use_share_prior_period(e: HighwayVehicleUseEvent, share: Decimal) kind empirical {
    label en official "section 4483(h)(2): the share (0..1) of the use of the vehicle during the prior taxable period by a qualified blood collector organization in the collection, storage or transportation of blood";
}
pub relation blood_collector_certified_expected_share(e: HighwayVehicleUseEvent, share: Decimal) kind empirical {
    label en official "section 4483(h)(3): the organization certifies to the Secretary the share of use it reasonably expects in the taxable period for a vehicle first placed in service in it";
}
pub relation vehicle_first_placed_in_service_in_taxable_period(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(h)(3): the vehicle is first placed in service in the taxable period";
}
pub relation used_by_qualified_blood_collector_organization(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(h)(1): the vehicle is used by a qualified blood collector organization (section 7701(a)(49))";
}
pub relation qualified_blood_collector_vehicle(e: HighwayVehicleUseEvent) kind institutional {
    label en official "section 4483(h)(2)-(3): a qualified blood collector vehicle";
}

@source(IRC_S4483_A, relation = formalizes, coverage = exact, quote = "no tax shall be imposed by section 4481 on the use of any highway motor vehicle by any State or any political subdivision of a State.")
rule HighwayUseStateLocalExempt(e: HighwayVehicleUseEvent, on: Date) strict {
    when highway_vehicle_use(e, _, _) and highway_use_by_state_or_political_subdivision(e) and highway_use_date(e, on) and on < @2029-10-01;
    then tax_free_sale(e);
}
@source(IRC_S4483_C, relation = formalizes, coverage = exact, quote = "no tax shall be imposed by section 4481 on the use of any bus which is of the transit type")
rule HighwayUseTransitBusExempt(e: HighwayVehicleUseEvent, on: Date) strict {
    when highway_vehicle_use(e, _, _) and transit_type_bus_meeting_60_percent_test(e) and highway_use_date(e, on) and on < @2029-10-01;
    then tax_free_sale(e);
}
@source(IRC_S4483_G, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by section 4481 on the use of any vehicle described in section 4053(8).")
rule HighwayUseMobileMachineryExempt(e: HighwayVehicleUseEvent) strict {
    when highway_vehicle_use(e, _, _) and highway_vehicle_of_section_4053_8(e);
    then tax_free_sale(e);
}
@source(IRC_S4483_H, relation = formalizes, coverage = exact, quote = "means a vehicle at least 80 percent of the use of which during the prior taxable period was by a qualified blood collector organization")
rule QualifiedBloodCollectorVehiclePriorUse(e: HighwayVehicleUseEvent, share: Decimal) strict {
    when blood_collector_vehicle_use_share_prior_period(e, share) and share >= 0.8;
    then qualified_blood_collector_vehicle(e);
}
@source(IRC_S4483_H, relation = formalizes, coverage = exact, quote = "the organization reasonably expects at least 80 percent of the use of such vehicle by the organization during such taxable period will be in the collection, storage, or transportation of blood.")
rule QualifiedBloodCollectorVehicleFirstYear(e: HighwayVehicleUseEvent, share: Decimal) strict {
    when vehicle_first_placed_in_service_in_taxable_period(e) and blood_collector_certified_expected_share(e, share) and share >= 0.8;
    then qualified_blood_collector_vehicle(e);
}
@source(IRC_S4483_H, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by section 4481 on the use of any qualified blood collector vehicle by a qualified blood collector organization.")
rule HighwayUseBloodCollectorExempt(e: HighwayVehicleUseEvent) strict {
    when highway_vehicle_use(e, _, _) and qualified_blood_collector_vehicle(e) and used_by_qualified_blood_collector_organization(e);
    then tax_free_sale(e);
}

// (d) low-mileage suspension, exemption, refund, transfer
pub relation reasonable_to_expect_use_below_mileage_threshold(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(d)(1)(A)(i): it is reasonable to expect that the use of the vehicle on public highways during the taxable period will be less than the threshold (DECISION-0194: an evaluative expectation, asserted with origin adjudicated where disputed)";
}
pub relation owner_furnished_expected_use_information(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(d)(1)(A)(ii): the owner furnishes the information the Secretary requires with respect to the expected use";
}
pub relation owner_furnished_actual_use_information(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(d)(2)(C): the owner furnishes the information the Secretary requires with respect to the use during the taxable period (except as otherwise provided in regulations)";
}
pub relation highway_miles_used_in_taxable_period(e: HighwayVehicleUseEvent, miles: Decimal) kind empirical {
    label en official "section 4483(d)(1)(B), (2)(B): the miles the vehicle is used on public highways during the taxable period";
}
pub relation agricultural_vehicle_for_mileage_test(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(d)(5)(B): the vehicle is used primarily for farming purposes and registered as a highway motor vehicle used for farming purposes (7,500 miles instead of 5,000)";
}
pub relation highway_mileage_threshold(e: HighwayVehicleUseEvent, threshold: Decimal) kind institutional {
    label en official "section 4483(d)(1), (5): 5,000 miles, or 7,500 for an agricultural vehicle";
}
pub relation highway_tax_collection_suspended(e: HighwayVehicleUseEvent) kind institutional {
    label en official "section 4483(d)(1)(A): collection of the tax with respect to the vehicle is suspended for the taxable period";
}
pub relation highway_tax_paid_by(e: HighwayVehicleUseEvent, payer: Person, amount: Money) kind empirical {
    label en official "section 4483(d)(3): the tax paid with respect to the vehicle and the person who paid it";
}
pub relation highway_low_mileage_refund_claim_filed(e: HighwayVehicleUseEvent, payer: Person) kind empirical {
    label en official "the payer claims credit or refund of the tax under section 4483(d)(3)";
}
pub relation highway_mileage_exemption_requirements_met(e: HighwayVehicleUseEvent) kind institutional {
    label en official "section 4483(d)(3): the requirements of subparagraphs (B) and (C) of paragraph (2) are met for the taxable period";
}
pub relation highway_tax_credited_or_refunded(e: HighwayVehicleUseEvent, payer: Person, amount: Money) kind institutional {
    label en official "section 4483(d)(3): the amount of the tax is credited or refunded (without interest) to the person who paid it";
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "In the case of an agricultural vehicle, paragraphs (1) and (2) shall be applied by substituting \"7,500\" for \"5,000\" each place it appears.")
rule HighwayMileageThresholdAgricultural(e: HighwayVehicleUseEvent) strict {
    when highway_vehicle_use(e, _, _) and agricultural_vehicle_for_mileage_test(e);
    then highway_mileage_threshold(e, S4483dAgriculturalMileageThreshold);
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "(i) it is reasonable to expect that the use of any highway motor vehicle on public highways during any taxable period will be less than 5,000 miles, and")
rule HighwayMileageThresholdOrdinary(e: HighwayVehicleUseEvent) strict {
    when highway_vehicle_use(e, _, _) and not_known(agricultural_vehicle_for_mileage_test(e));
    then highway_mileage_threshold(e, S4483dMileageThreshold);
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "then the collection of the tax imposed by section 4481 with respect to the use of such vehicle shall be suspended during the taxable period.")
rule HighwayTaxCollectionSuspended(e: HighwayVehicleUseEvent) strict {
    when reasonable_to_expect_use_below_mileage_threshold(e) and owner_furnished_expected_use_information(e);
    then highway_tax_collection_suspended(e);
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "then no tax shall be imposed by section 4481 on the use of such vehicle for the taxable period.")
rule HighwayUseLowMileageExempt(e: HighwayVehicleUseEvent, miles: Decimal, threshold: Decimal) strict {
    when highway_tax_collection_suspended(e)
        and highway_miles_used_in_taxable_period(e, miles)
        and highway_mileage_threshold(e, threshold)
        and miles <= threshold
        and owner_furnished_actual_use_information(e);
    then tax_free_sale(e);
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "(B) the requirements of subparagraphs (B) and (C) of paragraph (2) are met with respect to such taxable period,")
rule HighwayMileageExemptionRequirementsMet(e: HighwayVehicleUseEvent, miles: Decimal, threshold: Decimal) strict {
    when highway_miles_used_in_taxable_period(e, miles)
        and highway_mileage_threshold(e, threshold)
        and miles <= threshold
        and owner_furnished_actual_use_information(e);
    then highway_mileage_exemption_requirements_met(e);
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "the amount of such tax shall be credited or refunded (without interest) to the person who paid such tax.")
rule HighwayLowMileageRefundPowerRule(e: HighwayVehicleUseEvent, payer: Person, paid: Money) defeasible {
    when highway_low_mileage_refund_claim_filed(e, payer) and highway_tax_paid_by(e, payer, paid);
    then power HighwayLowMileageRefundClaim {
        holder payer;
        over e;
        exercise highway_low_mileage_refund_claim_filed(e, payer);
        valid_when highway_mileage_exemption_requirements_met(e);
        effect create(highway_tax_credited_or_refunded(e, payer, paid));
        window [-infinity, infinity];
    };
}

pub relation highway_vehicle_transferred_to_new_owner_while_suspended(e: HighwayVehicleUseEvent, old_owner: Person, new_owner: Person) kind empirical {
    label en official "section 4483(d)(4): a vehicle whose collection is suspended is transferred to a new owner while the suspension is in effect";
}
pub relation old_owner_furnished_transfer_information(e: HighwayVehicleUseEvent, old_owner: Person) kind empirical {
    label en official "section 4483(d)(4)(C): the old owner furnishes the information the Secretary requires about the transfer";
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "shall not be liable for the tax imposed by section 4481 (and the new owner shall be liable for such tax)")
rule HighwayTransferOldOwnerImmunityRule(e: HighwayVehicleUseEvent, old: Person, new: Person, amount: Money) defeasible {
    when highway_vehicle_transferred_to_new_owner_while_suspended(e, old, new)
        and highway_tax_collection_suspended(e)
        and old_owner_furnished_transfer_information(e, old)
        and excise_tax_due(e, amount);
    then immunity OldOwnerNotLiableAfterSuspendedVehicleTransfer {
        holder old;
        protected_effect liable_for_excise(old, e, amount);
        window [-infinity, infinity];
    };
}
@source(IRC_S4483_D, relation = formalizes, coverage = exact, quote = "shall not be liable for the tax imposed by section 4481 (and the new owner shall be liable for such tax)")
rule HighwayTransferNewOwnerLiable(e: HighwayVehicleUseEvent, old: Person, new: Person, amount: Money) defeasible {
    when highway_vehicle_transferred_to_new_owner_while_suspended(e, old, new)
        and highway_tax_collection_suspended(e)
        and old_owner_furnished_transfer_information(e, old)
        and excise_tax_due(e, amount);
    then liable_for_excise(new, e, amount);
}

// section 4483(b): exemption for use by the United States (Secretary's power)
pub relation highway_use_by_united_states(e: HighwayVehicleUseEvent) kind empirical {
    label en official "section 4483(b): the use is by the United States of a particular highway motor vehicle or class of vehicles";
}
pub relation secretary_authorizes_highway_exemption_for_united_states(e: HighwayVehicleUseEvent) kind empirical {
    label en official "the Secretary of the Treasury authorizes exemption from the section 4481 tax for the use";
}
external judgment relation secretary_determines_highway_tax_burden_avoidable(e: HighwayVehicleUseEvent) {
    authority Secretary;
    label en official "section 4483(b): the Secretary determines that imposing the tax will cause substantial burden or expense which can be avoided by granting exemption";
}
external judgment relation secretary_determines_full_benefit_of_highway_exemption_accrues_to_united_states(e: HighwayVehicleUseEvent) {
    authority Secretary;
    label en official "section 4483(b): the Secretary determines that the full benefit of the exemption will accrue to the United States";
}
pub relation highway_united_states_exemption_conditions_met(e: HighwayVehicleUseEvent) kind institutional {
    label en official "section 4483(b): use by the United States and both determinations";
}
@source(IRC_S4483_B, relation = formalizes, coverage = exact, quote = "if he determines that the imposition of such tax with respect to such use will cause substantial burden or expense which can be avoided by granting tax exemption")
rule HighwayUnitedStatesExemptionConditions(e: HighwayVehicleUseEvent) strict {
    when highway_use_by_united_states(e)
        and secretary_determines_highway_tax_burden_avoidable(e)
        and secretary_determines_full_benefit_of_highway_exemption_accrues_to_united_states(e);
    then highway_united_states_exemption_conditions_met(e);
}
@source(IRC_S4483_B, relation = formalizes, coverage = exact, quote = "The Secretary of the Treasury may authorize exemption from the tax imposed by section 4481 as to the use by the United States")
rule Section4483bExemptionPowerRule(e: HighwayVehicleUseEvent) defeasible {
    when secretary_authorizes_highway_exemption_for_united_states(e);
    then power Section4483bUnitedStatesHighwayExemption {
        holder Secretary;
        over e;
        exercise secretary_authorizes_highway_exemption_for_united_states(e);
        valid_when highway_united_states_exemption_conditions_met(e);
        effect create(tax_free_sale(e));
        window [-infinity, infinity];
    };
}
