// Stage 2: chapter 33 subchapter B (communications: sections 4252-4254) and
// subchapters C, D, E (transportation by air: sections 4261(d)-(k), 4262,
// 4263, 4271, 4272, 4281, 4282; general: section 4291). Builds on
// 05-communications-air.law.
//
// Indexed dollar amounts: the section 4261(b), (c) amounts are indexed by
// (e)(4). The datasets hold the unindexed statutory amounts and the Revenue
// Procedure values pinned in us.irc.inflation_adjustments (2025, 2026); the
// years between are MISSING_PARAMETER_VALUE (TECH-GAPS.md).
//
// STAGE-2 CORRECTION TO STAGE 1: `not X(e)` in a strict rule body needs an
// explicit negative (SPEC §69), so the stage-1 exclusions were rewritten with
// `not_known`; the section 4261(e)(1)-(2) exclusions added here are read by the
// stage-1 rules `DomesticPercentageTax`, `DomesticSegmentFeeTax`.

// =====================================================================
// Sections 4252-4254 — communications services
// =====================================================================

use self::{
    AirTransportationEvent,
    CommunicationsPaymentEvent,
    ExciseEvent,
    IRC_S4251_B,
    IRC_S4252_A,
    IRC_S4252_B,
    IRC_S4252_C,
    IRC_S4252_D,
    IRC_S4253_A,
    IRC_S4253_B,
    IRC_S4253_C,
    IRC_S4253_D,
    IRC_S4253_F,
    IRC_S4253_G,
    IRC_S4253_L,
    IRC_S4254_A,
    IRC_S4254_B,
    IRC_S4254_C,
    IRC_S4261_D,
    IRC_S4261_E,
    IRC_S4261_F,
    IRC_S4261_G,
    IRC_S4261_H,
    IRC_S4261_I,
    IRC_S4261_J,
    IRC_S4261_K,
    IRC_S4262_A,
    IRC_S4262_C,
    IRC_S4263_A,
    IRC_S4263_B,
    IRC_S4263_C,
    IRC_S4271_A,
    IRC_S4271_B,
    IRC_S4271_C,
    IRC_S4271_D,
    IRC_S4272_B,
    IRC_S4272_C,
    IRC_S4281_A,
    IRC_S4281_C,
    IRC_S4281_D,
    IRC_S4282_A,
    IRC_S4291,
    Person,
    Section4041gGround,
    communications_payment,
    excise_tax_due,
    liable_for_excise,
    route_portion_excluded_by_4262b,
    tax_free_sale,
};

pub entity CommunicationsService;

pub enum CommunicationsServiceKind {
    LocalTelephoneService;
    TollTelephoneService;
    TeletypewriterExchangeService;
    PrivateCommunicationService;
}

pub relation service_gives_access_to_local_telephone_system(s: CommunicationsService) kind empirical {
    label en official "section 4252(a)(1): access to a local telephone system and the privilege of telephonic quality communication with substantially all persons having stations of that system";
}
pub relation service_is_facility_in_connection_with_local_access(s: CommunicationsService) kind empirical {
    label en official "section 4252(a)(2): a facility or service provided in connection with the section 4252(a)(1) service";
}
pub relation service_toll_charge_varies_with_distance_and_elapsed_time(s: CommunicationsService) kind empirical {
    label en official "section 4252(b)(1)(A): there is a toll charge which varies in amount with the distance and elapsed transmission time of each individual communication";
}
pub relation toll_charge_paid_within_united_states(s: CommunicationsService) kind empirical {
    label en official "section 4252(b)(1)(B): the charge is paid within the United States";
}
pub relation service_periodic_charge_for_unlimited_calls_outside_local_area(s: CommunicationsService) kind empirical {
    label en official "section 4252(b)(2): a service entitling the subscriber, on payment of a periodic charge, to an unlimited number of telephonic communications to or from all or a substantial portion of the persons with stations in a specified area outside the subscriber's local telephone system area";
}
pub relation service_gives_teletypewriter_exchange_access_and_intercommunication(s: CommunicationsService) kind empirical {
    label en official "section 4252(c): access from a teletypewriter or other data station to the exchange system and the privilege of intercommunication with substantially all persons having stations of the same system";
}
pub relation service_gives_exclusive_or_priority_channel_use(s: CommunicationsService) kind empirical {
    label en official "section 4252(d)(1)(A): exclusive or priority use of any communication channel or groups of channels";
}
pub relation service_gives_intercommunication_system_use(s: CommunicationsService) kind empirical {
    label en official "section 4252(d)(1)(B): use of an intercommunication system for the subscriber's stations";
}
pub relation service_is_associated_with_private_channel_or_system(s: CommunicationsService) kind empirical {
    label en official "section 4252(d)(2)-(3): switching capacity, extension lines and stations, other associated services necessary or unique to such channels or systems, or channel mileage connecting a station outside a local system area with its central office";
}
pub relation separate_charge_made_for_service(s: CommunicationsService) kind empirical {
    label en official "section 4252(d), last clause: a separate charge is made for the communication service";
}
pub relation toll_telephone_service(s: CommunicationsService) kind institutional {
    label en official "section 4252(b): toll telephone service";
}
pub relation private_communication_service(s: CommunicationsService) kind institutional {
    label en official "section 4252(d): private communication service (a separate charge is required)";
}
pub relation local_telephone_service(s: CommunicationsService) kind institutional {
    label en official "section 4252(a): local telephone service (excludes toll telephone service and private communication service)";
}
pub relation teletypewriter_exchange_service(s: CommunicationsService) kind institutional {
    label en official "section 4252(c): teletypewriter exchange service (excludes local telephone service)";
}
pub relation taxable_communications_service(s: CommunicationsService) kind institutional {
    label en official "section 4251(b)(1): local telephone service, toll telephone service, or teletypewriter exchange service";
}

@source(IRC_S4252_B, relation = formalizes, coverage = exact, quote = "(B) the charge is paid within the United States, and")
rule TollServiceByCharge(s: CommunicationsService) strict {
    when service_toll_charge_varies_with_distance_and_elapsed_time(s) and toll_charge_paid_within_united_states(s);
    then toll_telephone_service(s);
}
@source(IRC_S4252_B, relation = formalizes, coverage = exact, quote = "(2) a service which entitles the subscriber, upon payment of a periodic charge")
rule TollServiceByPeriodicCharge(s: CommunicationsService) strict {
    when service_periodic_charge_for_unlimited_calls_outside_local_area(s);
    then toll_telephone_service(s);
}
@source(IRC_S4252_D, relation = formalizes, coverage = exact, quote = "except that such term does not include any communication service unless a separate charge is made for such service.")
rule PrivateServiceChannel(s: CommunicationsService) strict {
    when service_gives_exclusive_or_priority_channel_use(s) and separate_charge_made_for_service(s);
    then private_communication_service(s);
}
@source(IRC_S4252_D, relation = formalizes, coverage = exact, quote = "(B) to the use of an intercommunication system for the subscriber's stations,")
rule PrivateServiceIntercom(s: CommunicationsService) strict {
    when service_gives_intercommunication_system_use(s) and separate_charge_made_for_service(s);
    then private_communication_service(s);
}
@source(IRC_S4252_D, relation = formalizes, coverage = exact, quote = "(2) switching capacity, extension lines and stations, or other associated services which are provided in connection with, and are necessary or unique to the use of, channels or systems described in paragraph (1), and")
rule PrivateServiceAssociated(s: CommunicationsService) strict {
    when service_is_associated_with_private_channel_or_system(s) and separate_charge_made_for_service(s);
    then private_communication_service(s);
}
@source(IRC_S4252_A, relation = formalizes, coverage = exact, quote = "The term \"local telephone service\" does not include any service which is a \"toll telephone service\" or a \"private communication service\" as defined in subsections (b) and (d).")
rule LocalServiceClassification(s: CommunicationsService) strict {
    when (service_gives_access_to_local_telephone_system(s) or service_is_facility_in_connection_with_local_access(s))
        and not_known(toll_telephone_service(s))
        and not_known(private_communication_service(s));
    then local_telephone_service(s);
}
@source(IRC_S4252_C, relation = formalizes, coverage = exact, quote = "The term \"teletypewriter exchange service\" does not include any service which is \"local telephone service\" as defined in subsection (a).")
rule TeletypewriterServiceClassification(s: CommunicationsService) strict {
    when service_gives_teletypewriter_exchange_access_and_intercommunication(s) and not_known(local_telephone_service(s));
    then teletypewriter_exchange_service(s);
}
@source(IRC_S4251_B, relation = formalizes, coverage = exact, quote = "(A) local telephone service;")
rule TaxableCommunicationsServiceLocal(s: CommunicationsService) strict {
    when local_telephone_service(s);
    then taxable_communications_service(s);
}
@source(IRC_S4251_B, relation = formalizes, coverage = exact, quote = "(B) toll telephone service; and")
rule TaxableCommunicationsServiceToll(s: CommunicationsService) strict {
    when toll_telephone_service(s);
    then taxable_communications_service(s);
}
@source(IRC_S4251_B, relation = formalizes, coverage = exact, quote = "(C) teletypewriter exchange service.")
rule TaxableCommunicationsServiceTeletypewriter(s: CommunicationsService) strict {
    when teletypewriter_exchange_service(s);
    then taxable_communications_service(s);
}

pub relation payment_for_communications_service(e: CommunicationsPaymentEvent, s: CommunicationsService) kind empirical {
    label en official "the communications payment is for this service";
}
@source(IRC_S4251_B, relation = formalizes, coverage = partial, quote = "The term \"communications services\" means—")
rule PrivateServicePaymentNotTaxed(e: CommunicationsPaymentEvent, s: CommunicationsService) strict {
    when payment_for_communications_service(e, s) and private_communication_service(s) and not_known(taxable_communications_service(s));
    then tax_free_sale(e);
}

// --- section 4253: exemptions -------------------------------------------------

pub enum Section4253Ground {
    CoinOperatedPublicTelephone;
    NewsService;
    InternationalOrganizationOrRedCross;
    CombatZoneServicemember;
    CommonCarrierOrBroadcasterUse;
    InstallationCharge;
    NonprofitHospital;
    StateOrLocalGovernment;
    NonprofitEducationalOrganization;
    QualifiedBloodCollectorOrganization;
}

pub relation communications_payment_service_kind(e: CommunicationsPaymentEvent, kind: CommunicationsServiceKind) kind empirical {
    label en official "the kind of communications service the payment is for (section 4252)";
}
pub relation exemption_ground_4253(e: CommunicationsPaymentEvent, ground: Section4253Ground) kind empirical {
    label en official "section 4253: the payment falls within a named exemption ground";
}
pub relation coin_operated_guaranteed_amount(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(a): the coin-operated service is furnished for a guaranteed amount (the guaranteed amount plus any fixed periodic charge stays taxable)";
}
pub relation combat_zone_certificate_furnished(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(d): a certificate with the facts the Secretary prescribes by regulations is furnished to the person receiving the payment";
}
pub relation news_service_charge_billed_in_writing(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(b): the charge for the news service is billed in writing to the person";
}
pub relation exemption_statement_provided_to_provider(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(l)(1): the claimant provided the provider a statement certifying entitlement to the exemption";
}
pub relation provider_has_actual_knowledge_statement_false(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(l)(2)(A): the provider has actual knowledge that the information in the statement is false";
}
pub relation provider_notified_by_secretary_no_longer_entitled(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(l)(2)(B): the provider is notified by the Secretary that the statement provider is no longer entitled to the exemption";
}
pub relation exemption_statement_in_effect(e: CommunicationsPaymentEvent) kind institutional {
    label en official "section 4253(l): the exemption statement was provided and neither event ending its duration has happened";
}

@source(IRC_S4253_L, relation = formalizes, coverage = exact, quote = "Any statement provided under paragraph (1) shall remain in effect until—")
rule ExemptionStatementInEffect(e: CommunicationsPaymentEvent) strict {
    when exemption_statement_provided_to_provider(e)
        and not_known(provider_has_actual_knowledge_statement_false(e))
        and not_known(provider_notified_by_secretary_no_longer_entitled(e));
    then exemption_statement_in_effect(e);
}

@source(IRC_S4253_A, relation = formalizes, coverage = exact, quote = "Service paid for by inserting coins in coin-operated telephones available to the public shall not be subject to the tax imposed by section 4251 with respect to local telephone service")
rule CoinOperatedLocalExempt(e: CommunicationsPaymentEvent) strict {
    when exemption_ground_4253(e, CoinOperatedPublicTelephone)
        and communications_payment_service_kind(e, LocalTelephoneService)
        and not_known(coin_operated_guaranteed_amount(e));
    then tax_free_sale(e);
}
@source(IRC_S4253_A, relation = formalizes, coverage = exact, quote = "or with respect to toll telephone service if the charge for such toll telephone service is less than 25 cents")
rule CoinOperatedTollUnder25CentsExempt(e: CommunicationsPaymentEvent, amount: Money) strict {
    when exemption_ground_4253(e, CoinOperatedPublicTelephone)
        and communications_payment_service_kind(e, TollTelephoneService)
        and communications_payment(e, amount, _)
        and amount < 0.25 USD
        and not_known(coin_operated_guaranteed_amount(e));
    then tax_free_sale(e);
}
@source(IRC_S4253_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4251, except with respect to local telephone service, on any payment received from any person for services used in the collection of news")
rule NewsServiceExempt(e: CommunicationsPaymentEvent) strict {
    when exemption_ground_4253(e, NewsService)
        and news_service_charge_billed_in_writing(e)
        and (communications_payment_service_kind(e, TollTelephoneService) or communications_payment_service_kind(e, TeletypewriterExchangeService));
    then tax_free_sale(e);
}
@source(IRC_S4253_D, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4251 on any payment received for any toll telephone service which originates within a combat zone")
rule CombatZoneServicememberExempt(e: CommunicationsPaymentEvent) strict {
    when exemption_ground_4253(e, CombatZoneServicemember)
        and communications_payment_service_kind(e, TollTelephoneService)
        and combat_zone_certificate_furnished(e);
    then tax_free_sale(e);
}
@source(IRC_S4253_F, relation = formalizes, coverage = exact, quote = "to the extent that the amount so paid is for use by a common carrier, telephone or telegraph company, or radio broadcasting station or network in the conduct of its business as such.")
rule CommonCarrierUseExempt(e: CommunicationsPaymentEvent) strict {
    when exemption_ground_4253(e, CommonCarrierOrBroadcasterUse) and service_period_toll_kind(e);
    then tax_free_sale(e);
}
pub relation service_period_toll_kind(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4253(f): the toll service is one described in section 4252(b)(2) (periodic-charge unlimited-call service)";
}
@source(IRC_S4253_G, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4251 on so much of any amount paid for the installation of any instrument, wire, pole, switchboard, apparatus, or equipment as is properly attributable to such installation.")
rule InstallationChargeExempt(e: CommunicationsPaymentEvent) strict {
    when exemption_ground_4253(e, InstallationCharge);
    then tax_free_sale(e);
}
@source(IRC_S4253_C, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4251 on any payment received for services furnished to an international organization, or to the American National Red Cross.")
rule CertificateBackedExemptions(e: CommunicationsPaymentEvent, ground: Section4253Ground) strict {
    label en official "sections 4253(c), (h), (i), (j), (k) with (l)(1): the exemption needs the statement in effect";
    when exemption_ground_4253(e, ground)
        and (ground == InternationalOrganizationOrRedCross or ground == NonprofitHospital or ground == StateOrLocalGovernment or ground == NonprofitEducationalOrganization or ground == QualifiedBloodCollectorOrganization)
        and exemption_statement_in_effect(e);
    then tax_free_sale(e);
}

// section 4253(l)(2), last sentence: duty of the certificate provider to report changes.
pub relation exemption_information_changed_on(e: CommunicationsPaymentEvent, claimant: Person, on: Date) kind empirical {
    label en official "the information in an exemption statement is no longer accurate on this date";
}
pub relation claimant_informed_provider_of_change(e: CommunicationsPaymentEvent, claimant: Person) kind empirical {
    label en official "the person providing the statement informed the provider of the change";
}
@source(IRC_S4253_L, relation = formalizes, coverage = exact, quote = "the person providing such statement shall inform the provider of communications services within 30 days of any change of information.")
rule ExemptionChangeInformationDuty(e: CommunicationsPaymentEvent, claimant: Person, changed: Date) defeasible {
    when exemption_information_changed_on(e, claimant, changed);
    then duty InformProviderOfChangedExemptionInformation {
        bearer claimant;
        goal achievement {
            condition claimant_informed_provider_of_change(e, claimant);
            window [changed, add_calendar_period(changed, 30 calendar_day)];
        }
    };
}

// --- section 4254 ------------------------------------------------------------

pub relation communications_amount_paid_components(e: CommunicationsPaymentEvent, gross: Money, separately_stated_state_or_local_tax: Money) kind empirical {
    label en official "section 4254(c): the amount paid and any State or local tax on the furnishing or sale of the services that is separately stated in the bill";
}
pub relation communications_amount_paid_for_tax(e: CommunicationsPaymentEvent, base: Money) kind institutional {
    label en official "section 4254(c): the amount paid for communications services excluding separately stated State or local tax";
}
@source(IRC_S4254_C, relation = formalizes, coverage = exact, quote = "there shall not be included the amount of any State or local tax imposed on the furnishing or sale of such services, if the amount of such tax is separately stated in the bill.")
rule CommunicationsAmountNetOfStateLocalTax(e: CommunicationsPaymentEvent, gross: Money, state: Money) strict {
    when communications_amount_paid_components(e, gross, state);
    then communications_amount_paid_for_tax(e, gross - state);
}

pub entity CommunicationsBill;
pub relation bill_charge(b: CommunicationsBill, group: Text, item: Text, amount: Money) kind empirical {
    label en official "section 4254(a): a charge for local or toll telephone service included in the bill, in the group the biller uses for computing the tax (a charge in no group uses its own item name as the group)";
}
pub relation bill_group_tax_base(b: CommunicationsBill, group: Text, base: Money) kind institutional {
    label en official "section 4254(a): the sum of all charges within the group (with no grouping every item is its own group, the sum of all charges for the bill is the sum over groups)";
}
pub relation bill_group_tax(b: CommunicationsBill, group: Text, tax: Money) kind institutional {
    label en official "section 4254(a)(2): the tax on the group base at the applicable percentage";
}
@source(IRC_S4254_A, relation = formalizes, coverage = partial, quote = "(A) the amount on which the tax with respect to each such group shall be based shall be the sum of all items within that group")
rule BillGroupTaxBase(b: CommunicationsBill, g: Text) strict {
    when bill_charge(b, g, _, _);
    then bill_group_tax_base(b, g, sum all a: Money for i: Text where bill_charge(b, g, i, a));
}
@source(IRC_S4254_A, relation = formalizes, coverage = partial, quote = "(A) the amount on which the tax with respect to each such group shall be based shall be the sum of all items within that group")
rule BillGroupTaxAmount(b: CommunicationsBill, g: Text, base: Money) strict {
    when bill_group_tax_base(b, g, base);
    then bill_group_tax(b, g, round(base * S4251ApplicablePercentage, 2, "HALF_UP"));
}

pub relation coin_operated_toll_tax_computation(e: CommunicationsPaymentEvent, charge: Money) kind empirical {
    label en official "section 4254(b): the tax on toll telephone service is paid by inserting coins in coin-operated telephones; the charge on which it is computed";
}
pub relation coin_operated_toll_tax_rounded(e: CommunicationsPaymentEvent, tax: Money) kind institutional {
    label en official "section 4254(b): the tax computed to the nearest multiple of 5 cents, the next higher multiple where it is midway";
}
@source(IRC_S4254_B, relation = formalizes, coverage = exact, quote = "tax shall be computed to the nearest multiple of 5 cents, except that, where the tax is midway between multiples of 5 cents, the next higher multiple shall apply.")
rule CoinOperatedTollTaxRounding(e: CommunicationsPaymentEvent, charge: Money) strict {
    when coin_operated_toll_tax_computation(e, charge);
    then coin_operated_toll_tax_rounded(e, round(charge * S4251ApplicablePercentage / 0.05, 0, "HALF_UP") * 0.05);
}

// =====================================================================
// Section 4261 (d)-(k) — air transportation of persons
// =====================================================================

pub relation air_transportation_dates(e: AirTransportationEvent, transportation_begins: Date, paid_on: Date) kind empirical {
    label en official "section 4261(k): the date the transportation begins and the date the amount is paid";
}
pub relation air_tax_applies_by_period(e: AirTransportationEvent) kind institutional {
    label en official "section 4261(k)(1): the transportation begins during the period from the 7th day after the 1997 Reinstatement Act's enactment (Aug. 5, 1997, recorded in the pinned notes to Pub. L. 105-34) to September 30, 2028, or the amount is paid during the period for transportation beginning after it";
}
pub relation air_tax_paid_treated_as_overpayment(e: AirTransportationEvent) kind institutional {
    label en official "section 4261(k)(2): tax paid under (k)(1)(B) is treated as an overpayment when the taxes would not have applied to the transportation had it been paid for on the date it begins";
}
@source(IRC_S4261_K, relation = formalizes, coverage = exact, quote = "(A) transportation beginning during the period—")
rule AirTaxAppliesTransportationBeginsInPeriod(e: AirTransportationEvent, begins: Date, paid: Date) strict {
    when air_transportation_dates(e, begins, paid) and begins >= @1997-08-12 and begins <= @2028-09-30;
    then air_tax_applies_by_period(e);
}
@source(IRC_S4261_K, relation = formalizes, coverage = exact, quote = "(B) amounts paid during such period for transportation beginning after such period.")
rule AirTaxAppliesPaidInPeriodForLaterTransportation(e: AirTransportationEvent, begins: Date, paid: Date) strict {
    when air_transportation_dates(e, begins, paid) and paid >= @1997-08-12 and paid <= @2028-09-30 and begins > @2028-09-30;
    then air_tax_applies_by_period(e);
}
@source(IRC_S4261_K, relation = formalizes, coverage = exact, quote = "any tax paid under paragraph (1)(B) with respect to such transportation shall be treated as an overpayment.")
rule AirTaxPaidForLaterTransportationOverpayment(e: AirTransportationEvent, begins: Date, paid: Date) strict {
    when air_transportation_dates(e, begins, paid) and paid <= @2028-09-30 and begins > @2028-09-30;
    then air_tax_paid_treated_as_overpayment(e);
}
@source(IRC_S4261_K, relation = formalizes, coverage = exact, quote = "The taxes imposed by this section shall apply to—")
rule AirTaxOutsidePeriodNotImposed(e: AirTransportationEvent) strict {
    when air_transportation_dates(e, _, _) and not_known(air_tax_applies_by_period(e));
    then tax_free_sale(e);
}

pub relation air_payment_made_outside_united_states(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(e)(2): the amount is paid outside the United States for taxable transportation";
}
pub relation air_transportation_begins_and_ends_in_united_states(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(e)(2): the transportation begins and ends in the United States";
}
pub relation air_taxes_a_b_excluded_by_outside_payment(e: AirTransportationEvent) kind institutional {
    label en official "section 4261(e)(2): the taxes of subsections (a) and (b) do not apply to an amount paid outside the United States unless the transportation begins and ends in the United States";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "the taxes imposed by subsections (a) and (b) shall apply only if such transportation begins and ends in the United States.")
rule AirTaxesABExcludedByOutsidePayment(e: AirTransportationEvent) strict {
    when air_payment_made_outside_united_states(e) and not_known(air_transportation_begins_and_ends_in_united_states(e));
    then air_taxes_a_b_excluded_by_outside_payment(e);
}

// (e)(1) rural airports
pub entity Airport;
pub relation airport_departing_passengers_second_preceding_year(a: Airport, year: Integer, passengers: Decimal) kind empirical {
    label en official "section 4261(e)(1)(B)(i): the commercial passengers departing by air during the second preceding calendar year from the airport";
}
pub relation airport_departing_passengers_on_segments_of_100_miles_or_more(a: Airport, year: Integer, passengers: Decimal) kind empirical {
    label en official "section 4261(e)(1)(B)(i): for an airport described in (ii)(III), the departing passengers on flight segments of at least 100 miles during the second preceding calendar year";
}
pub relation airport_not_within_75_miles_of_larger_airport(a: Airport) kind empirical {
    label en official "section 4261(e)(1)(B)(ii)(I): the airport is not located within 75 miles of another airport which is not described in clause (i)";
}
pub relation airport_receiving_essential_air_service_subsidies(a: Airport) kind empirical {
    label en official "section 4261(e)(1)(B)(ii)(II): the airport is receiving essential air service subsidies as of the date of enactment of the paragraph";
}
pub relation airport_not_connected_by_paved_roads_to_another_airport(a: Airport) kind empirical {
    label en official "section 4261(e)(1)(B)(ii)(III): the airport is not connected by paved roads to another airport";
}
pub relation rural_airport_for_year(a: Airport, year: Integer) kind institutional {
    label en official "section 4261(e)(1)(B): a rural airport for the calendar year";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "(I) is not located within 75 miles of another airport which is not described in clause (i),")
rule RuralAirportByDistance(a: Airport, year: Integer, n: Decimal) strict {
    when airport_departing_passengers_second_preceding_year(a, year, n) and n < 100000.0 and airport_not_within_75_miles_of_larger_airport(a);
    then rural_airport_for_year(a, year);
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "(II) is receiving essential air service subsidies as of the date of the enactment of this paragraph, or")
rule RuralAirportBySubsidy(a: Airport, year: Integer, n: Decimal) strict {
    when airport_departing_passengers_second_preceding_year(a, year, n) and n < 100000.0 and airport_receiving_essential_air_service_subsidies(a);
    then rural_airport_for_year(a, year);
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "(III) is not connected by paved roads to another airport.")
rule RuralAirportNoPavedRoads(a: Airport, year: Integer, n: Decimal) strict {
    when airport_departing_passengers_on_segments_of_100_miles_or_more(a, year, n) and n < 100000.0 and airport_not_connected_by_paved_roads_to_another_airport(a);
    then rural_airport_for_year(a, year);
}
pub relation domestic_segments_at_rural_airports(e: AirTransportationEvent, segments: Decimal) kind empirical {
    label en official "section 4261(e)(1)(A): the number of the event's domestic segments beginning or ending at an airport which is a rural airport for the calendar year (the airport classification is `rural_airport_for_year`)";
}

// (e)(3) mileage awards, (e)(5) aircraft management services
pub entity MileageAwardPaymentEvent : ExciseEvent;
pub relation mileage_award_payment(e: MileageAwardPaymentEvent, amount_and_value_of_benefit: Money, payer: Person) kind empirical {
    label en official "section 4261(e)(3)(A): an amount paid (and the value of any other benefit provided) to an air carrier or related person for the right to provide mileage awards or other reductions in the cost of air transportation of persons";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "shall be treated for purposes of subsection (a) as an amount paid for taxable transportation, and such amount shall be taxable under subsection (a) without regard to any other provision of this subchapter.")
rule MileageAwardPaymentTax(e: MileageAwardPaymentEvent, amount: Money) strict {
    when mileage_award_payment(e, amount, _);
    then excise_tax_due(e, round(amount * S4261PercentageRatePercent, 2, "HALF_UP"));
}
@source(IRC_S4261_D, relation = formalizes, coverage = exact, quote = "the taxes imposed by this section shall be paid by the person making the payment subject to the tax.")
rule MileageAwardPaymentLiability(e: MileageAwardPaymentEvent, payer: Person, amount: Money) defeasible {
    when mileage_award_payment(e, _, payer) and excise_tax_due(e, amount);
    then liable_for_excise(payer, e, amount);
}

pub entity AircraftLease;
pub relation lease_from_management_service_provider_or_related_person(l: AircraftLease) kind empirical {
    label en official "section 4261(e)(5)(C)(ii): a lease from a person providing aircraft management services for the aircraft (or a related person, section 465(b)(3)(C))";
}
pub relation aircraft_lease_term_days(l: AircraftLease, days: Integer) kind empirical {
    label en official "the term of the aircraft lease in days";
}
pub relation disqualified_aircraft_lease(l: AircraftLease) kind institutional {
    label en official "section 4261(e)(5)(C)(ii): such a lease for a term of 31 days or less";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "if such lease is for a term of 31 days or less.")
rule DisqualifiedLeaseClassification(l: AircraftLease, days: Integer) strict {
    when lease_from_management_service_provider_or_related_person(l) and aircraft_lease_term_days(l, days) and days <= 31;
    then disqualified_aircraft_lease(l);
}
pub relation aircraft_management_payment(e: AirTransportationEvent, total_paid: Money, management_services_portion: Money) kind empirical {
    label en official "section 4261(e)(5)(A), (D): amounts paid by an aircraft owner to a person, and the portion consisting of aircraft management services (maintenance and support of the aircraft or flights on it)";
}
pub relation payer_is_aircraft_owner_or_qualifying_lessee(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(e)(5)(C)(i): the payer owns the aircraft or leases it other than under a disqualified lease";
}
pub relation taxable_amount_after_aircraft_management_exclusion(e: AirTransportationEvent, amount: Money) kind institutional {
    label en official "section 4261(e)(5)(D): pro rata: the tax base is the portion that is not aircraft management services";
}
@source(IRC_S4261_E, relation = formalizes, coverage = exact, quote = "this paragraph shall apply on a pro rata basis only to the portion which consists of amounts described in such subparagraph.")
rule AircraftManagementProRataExclusion(e: AirTransportationEvent, total: Money, mgmt: Money) strict {
    when aircraft_management_payment(e, total, mgmt) and payer_is_aircraft_owner_or_qualifying_lessee(e) and total >= mgmt;
    then taxable_amount_after_aircraft_management_exclusion(e, total - mgmt);
}

// (f)-(j) exemptions
pub enum Section4261Exemption {
    HelicopterMineralOilGasTransport;
    HelicopterOrAirplaneTreeOperations;
    AirAmbulanceEmergencyMedical;
    SkydivingOnly;
    SeaplaneWaterSegment;
}
pub relation air_transportation_exempt_ground(e: AirTransportationEvent, ground: Section4261Exemption) kind empirical {
    label en official "section 4261(f)-(i): the air transportation is of one of the exempt kinds";
}
pub relation aircraft_avoids_airport_and_air_navigation_services_during_use(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(f), flush: the aircraft does not take off from or land at a facility eligible for assistance under the Airport and Airway Development Act of 1970 or use services under 49 U.S.C. 44509, 44913(b) or subchapter I of chapter 471";
}
pub relation seaplane_places_without_airport_trust_fund_assistance(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(i): the places of the takeoff and landing have not received and are not receiving financial assistance from the Airport and Airway Trust Fund";
}
pub relation air_transportation_fuel_taxed_under_4043(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(j): tax is imposed under section 4043 with respect to the fuel used in the air transportation";
}
@source(IRC_S4261_F, relation = formalizes, coverage = exact, quote = "but only if the helicopter or fixed-wing aircraft does not take off from, or land at, a facility eligible for assistance")
rule AirExemptionMineralsOrTrees(e: AirTransportationEvent, ground: Section4261Exemption) strict {
    when air_transportation_exempt_ground(e, ground)
        and (ground == HelicopterMineralOilGasTransport or ground == HelicopterOrAirplaneTreeOperations)
        and aircraft_avoids_airport_and_air_navigation_services_during_use(e);
    then tax_free_sale(e);
}
@source(IRC_S4261_G, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under this section or section 4271 on any air transportation for the purpose of providing emergency medical services—")
rule AirExemptionEmergencyMedical(e: AirTransportationEvent) strict {
    when air_transportation_exempt_ground(e, AirAmbulanceEmergencyMedical);
    then tax_free_sale(e);
}
@source(IRC_S4261_H, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by this section or section 4271 on any air transportation exclusively for the purpose of skydiving.")
rule AirExemptionSkydiving(e: AirTransportationEvent) strict {
    when air_transportation_exempt_ground(e, SkydivingOnly);
    then tax_free_sale(e);
}
@source(IRC_S4261_I, relation = formalizes, coverage = exact, quote = "but only if the places at which such takeoff and landing occur have not received and are not receiving financial assistance from the Airport and Airways Trust Fund.")
rule AirExemptionSeaplane(e: AirTransportationEvent) strict {
    when air_transportation_exempt_ground(e, SeaplaneWaterSegment) and seaplane_places_without_airport_trust_fund_assistance(e);
    then tax_free_sale(e);
}
@source(IRC_S4261_J, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by this section or section 4271 on any air transportation if tax is imposed under section 4043 with respect to the fuel used in such transportation.")
rule AirExemptionFractionalFuelTaxed(e: AirTransportationEvent, begins: Date, paid: Date) strict {
    when air_transportation_dates(e, begins, paid) and air_transportation_fuel_taxed_under_4043(e) and begins <= @2028-09-30;
    then tax_free_sale(e);
}

// (d) by whom paid, and section 4263, 4291: collection duties
pub relation air_tax_payment_outside_united_states_for_prepaid_order(e: AirTransportationEvent, carrier: Person) kind empirical {
    label en official "section 4263(a): the payment is made outside the United States for a prepaid order, exchange order, or similar order; the carrier furnishes the initial transportation under the order";
}
pub relation carrier_collected_air_tax(e: AirTransportationEvent, carrier: Person) kind empirical {
    label en official "the carrier collected the amount of the tax";
}
@source(IRC_S4263_A, relation = formalizes, coverage = exact, quote = "the person furnishing the initial transportation pursuant to such order shall collect the amount of the tax.")
rule Section4263aCollectionDutyRule(e: AirTransportationEvent, carrier: Person) defeasible {
    when air_tax_payment_outside_united_states_for_prepaid_order(e, carrier);
    then duty CarrierCollectsAirTaxOnPrepaidOrder {
        bearer carrier;
        goal achievement {
            condition carrier_collected_air_tax(e, carrier);
            window [-infinity, infinity];
        }
    };
}
pub relation tax_not_paid_at_time_of_payment_and_not_collected_otherwise(e: AirTransportationEvent, initial_segment_carrier: Person) kind empirical {
    label en official "section 4263(c): the tax was not paid when payment for the transportation was made and is not collected under any other provision; the carrier provides the initial segment beginning or ending in the United States";
}
@source(IRC_S4263_C, relation = formalizes, coverage = exact, quote = "such tax shall be paid by the carrier providing the initial segment of such transportation which begins or ends in the United States.")
rule Section4263cCarrierLiableForUncollectedTax(e: AirTransportationEvent, carrier: Person, amount: Money) defeasible {
    when tax_not_paid_at_time_of_payment_and_not_collected_otherwise(e, carrier) and excise_tax_due(e, amount);
    then liable_for_excise(carrier, e, amount);
}
pub relation refund_of_ticket_bought_without_tax(e: AirTransportationEvent, refunder: Person) kind empirical {
    label en official "section 4263(b): a person refunds an amount with respect to a ticket or order purchased without payment of the section 4261 tax";
}
pub relation refunder_deducted_tax_due_from_refund(e: AirTransportationEvent, refunder: Person) kind empirical {
    label en official "section 4263(b): the refunder deducted from the amount refundable, to the extent available, the tax due for the used portion and reported the amount remaining uncollected";
}
@source(IRC_S4263_B, relation = formalizes, coverage = exact, quote = "shall deduct from the amount refundable, to the extent available, any tax due under such section as a result of the use of a portion of the transportation purchased in connection with such ticket or order")
rule Section4263bRefundDeductionDutyRule(e: AirTransportationEvent, refunder: Person) defeasible {
    when refund_of_ticket_bought_without_tax(e, refunder);
    then duty RefunderDeductsAndReportsTaxDue {
        bearer refunder;
        goal achievement {
            condition refunder_deducted_tax_due_from_refund(e, refunder);
            window [-infinity, infinity];
        }
    };
}
pub relation person_receives_payment_on_which_tax_is_imposed_on_payor(e: ExciseEvent, recipient: Person) kind empirical {
    label en official "section 4291: the person receives a payment for facilities or services on which a chapter 33 tax is imposed on the payor";
}
pub relation recipient_collected_tax_from_payor(e: ExciseEvent, recipient: Person) kind empirical {
    label en official "section 4291: the recipient collected the amount of the tax from the person making the payment";
}
pub relation payment_outside_4263a_collection_rule(e: ExciseEvent) kind empirical {
    label en official "section 4263(a) does not govern this payment (section 4291 says 'except as otherwise provided in section 4263(a)')";
}
@source(IRC_S4291, relation = formalizes, coverage = exact, quote = "every person receiving any payment for facilities or services on which a tax is imposed upon the payor thereof under this chapter shall collect the amount of the tax from the person making such payment.")
rule Section4291CollectionDutyRule(e: ExciseEvent, recipient: Person) defeasible {
    when person_receives_payment_on_which_tax_is_imposed_on_payor(e, recipient);
    then duty RecipientCollectsTaxFromPayor {
        bearer recipient;
        goal achievement {
            condition recipient_collected_tax_from_payor(e, recipient);
            window [-infinity, infinity];
        }
    };
    unless payment_outside_4263a_collection_rule(e) and person_receives_payment_on_which_tax_is_imposed_on_payor(e, recipient);
}

// =====================================================================
// Sections 4262, 4272 — taxable transportation; 4271 — air freight
// =====================================================================

pub entity AirRoute;
pub relation route_begins_in_us_or_225_mile_zone(r: AirRoute) kind empirical {
    label en official "section 4262(a)(1): the transportation by air begins in the United States or in the 225-mile zone";
}
pub relation route_ends_in_us_or_225_mile_zone(r: AirRoute) kind empirical {
    label en official "section 4262(a)(1): the transportation ends in the United States or in the 225-mile zone";
}
pub relation portion_between_us_stations_not_part_of_uninterrupted_international_transportation(r: AirRoute) kind empirical {
    label en official "section 4262(a)(2): a portion directly or indirectly from one port or station in the United States to another, not part of uninterrupted international air transportation";
}
pub relation route_portion_meets_all_four_exclusion_requirements_4262b(r: AirRoute) kind empirical {
    label en official "section 4262(b): the portion is outside the United States, has no segment to or from the 225-mile zone gateway, begins and ends at the named points, and its direct line passes over a point more than 225 miles from the United States";
}
pub relation taxable_air_transportation_of_persons(r: AirRoute) kind institutional {
    label en official "section 4262(a)-(b): taxable transportation of persons";
}
@source(IRC_S4262_A, relation = formalizes, coverage = exact, quote = "(1) transportation by air which begins in the United States or in the 225–mile zone and ends in the United States or in the 225–mile zone; and")
rule TaxableTransportationBothEnds(r: AirRoute) strict {
    when route_begins_in_us_or_225_mile_zone(r) and route_ends_in_us_or_225_mile_zone(r) and not_known(route_portion_meets_all_four_exclusion_requirements_4262b(r)) and not_known(route_portion_excluded_by_4262b(r));
    then taxable_air_transportation_of_persons(r);
}
@source(IRC_S4262_A, relation = formalizes, coverage = exact, quote = "but only if such portion is not a part of uninterrupted international air transportation")
rule TaxableTransportationPortion(r: AirRoute) strict {
    when portion_between_us_stations_not_part_of_uninterrupted_international_transportation(r) and not_known(route_portion_meets_all_four_exclusion_requirements_4262b(r)) and not_known(route_portion_excluded_by_4262b(r));
    then taxable_air_transportation_of_persons(r);
}

pub relation scheduled_interval_hours_between_us_portions(r: AirRoute, hours: Decimal) kind empirical {
    label en official "section 4262(c)(3)(A): the scheduled interval between the beginning or end of the portion between United States stations and the end or beginning of the other portion";
}
pub relation scheduled_interval_hours_between_segments_of_us_portion(r: AirRoute, hours: Decimal) kind empirical {
    label en official "section 4262(c)(3)(B): the scheduled interval between the beginning or end and the end or beginning of any two segments of the United States portion";
}
pub relation route_is_transportation_described_in_4262a1(r: AirRoute) kind empirical {
    label en official "section 4262(c)(3): the transportation is described in subsection (a)(1) (uninterrupted international transportation is not)";
}
pub relation uninterrupted_international_air_transportation(r: AirRoute) kind institutional {
    label en official "section 4262(c)(3): transportation by air not described in (a)(1) with both scheduled intervals at most 12 hours";
}
@source(IRC_S4262_C, relation = formalizes, coverage = exact, quote = "(B) the scheduled interval between the beginning or end and the end or beginning of any two segments of the portion of such transportation referred to in subparagraph (A)(i) is not more than 12 hours.")
rule UninterruptedInternationalTransportation(r: AirRoute, a: Decimal, b: Decimal) strict {
    when scheduled_interval_hours_between_us_portions(r, a)
        and scheduled_interval_hours_between_segments_of_us_portion(r, b)
        and a <= 12.0
        and b <= 12.0
        and not_known(route_is_transportation_described_in_4262a1(r));
    then uninterrupted_international_air_transportation(r);
}

pub entity AirFreightPaymentEvent : ExciseEvent;
pub relation air_freight_payment(e: AirFreightPaymentEvent, amount: Money, payee_is_air_carrier_for_hire: Boolean, payer: Person) kind empirical {
    label en official "section 4271(a): an amount paid within or without the United States for taxable transportation of property by air, and whether it was paid to a person engaged in the business of transporting property by air for hire";
}
pub relation air_freight_transportation_dates(e: AirFreightPaymentEvent, transportation_begins: Date, paid_on: Date) kind empirical {
    label en official "section 4271(d): the date the transportation begins and the date the amount is paid";
}
pub relation air_freight_taxable_transportation_of_property(e: AirFreightPaymentEvent) kind empirical {
    label en official "section 4272: transportation of property by air which begins and ends in the United States and is not excluded by section 4272(b)-(c)";
}
pub relation air_freight_tax_applies_by_period(e: AirFreightPaymentEvent) kind institutional {
    label en official "section 4271(d)(1): the transportation begins between the 7th day after the 1997 Act's enactment and September 30, 2028, or the amount is paid in that period for later transportation";
}
@source(IRC_S4271_D, relation = formalizes, coverage = exact, quote = "(A) transportation beginning during the period—")
rule AirFreightPeriodByBeginning(e: AirFreightPaymentEvent, begins: Date, paid: Date) strict {
    when air_freight_transportation_dates(e, begins, paid) and begins >= @1997-08-12 and begins <= @2028-09-30;
    then air_freight_tax_applies_by_period(e);
}
@source(IRC_S4271_D, relation = formalizes, coverage = exact, quote = "(B) amounts paid during such period for transportation beginning after such period.")
rule AirFreightPeriodByPayment(e: AirFreightPaymentEvent, begins: Date, paid: Date) strict {
    when air_freight_transportation_dates(e, begins, paid) and paid >= @1997-08-12 and paid <= @2028-09-30 and begins > @2028-09-30;
    then air_freight_tax_applies_by_period(e);
}
@source(IRC_S4271_A, relation = formalizes, coverage = exact, quote = "a tax equal to 6.25 percent of the amount so paid for such transportation.")
rule AirFreightTax(e: AirFreightPaymentEvent, amount: Money) strict {
    when air_freight_payment(e, amount, true, _)
        and air_freight_taxable_transportation_of_property(e)
        and air_freight_tax_applies_by_period(e);
    then excise_tax_due(e, round(amount * S4271RatePercent, 2, "HALF_UP"));
}
@source(IRC_S4271_B, relation = formalizes, coverage = exact, quote = "the tax imposed by subsection (a) shall be paid by the person making the payment subject to tax.")
rule AirFreightLiability(e: AirFreightPaymentEvent, payer: Person, amount: Money) defeasible {
    when air_freight_payment(e, _, _, payer) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(payer, e, amount);
}
pub relation air_freight_payment_outside_united_states_unpaid(e: AirFreightPaymentEvent, consignee: Person) kind empirical {
    label en official "section 4271(b)(2): the payment is made outside the United States and the payer does not pay the tax; the consignee is the person to whom the property is delivered in the United States by the person furnishing the last segment";
}
@source(IRC_S4271_B, relation = formalizes, coverage = exact, quote = "(A) shall be paid by the person to whom the property is delivered in the United States by the person furnishing the last segment of the taxable transportation in respect of which such tax is imposed, and")
rule AirFreightConsigneeLiability(e: AirFreightPaymentEvent, consignee: Person, amount: Money) defeasible {
    when air_freight_payment_outside_united_states_unpaid(e, consignee) and excise_tax_due(e, amount);
    then liable_for_excise(consignee, e, amount);
}
pub relation air_freight_excess_baggage_accompanying_passenger_on_established_line(e: AirFreightPaymentEvent) kind empirical {
    label en official "section 4272(c): excess baggage accompanying a passenger traveling on an aircraft operated on an established line (not property)";
}
pub relation air_freight_exportation_by_continuous_movement(e: AirFreightPaymentEvent) kind empirical {
    label en official "section 4272(b)(2): transportation of property in the course of exportation (including shipment to a possession) by continuous movement and in due course so exported (under regulations)";
}
@source(IRC_S4272_C, relation = formalizes, coverage = exact, quote = "the term \"property\" does not include excess baggage accompanying a passenger traveling on an aircraft operated on an established line.")
rule AirFreightExcessBaggageNotProperty(e: AirFreightPaymentEvent) strict {
    when air_freight_payment(e, _, _, _) and air_freight_excess_baggage_accompanying_passenger_on_established_line(e);
    then tax_free_sale(e);
}
@source(IRC_S4272_B, relation = formalizes, coverage = exact, quote = "(2) under regulations prescribed by the Secretary, transportation of property in the course of exportation")
rule AirFreightExportationExempt(e: AirFreightPaymentEvent) strict {
    when air_freight_payment(e, _, _, _) and air_freight_exportation_by_continuous_movement(e);
    then tax_free_sale(e);
}

// =====================================================================
// Sections 4281, 4282 — small aircraft; affiliated groups
// =====================================================================

pub relation aircraft_maximum_certificated_takeoff_weight_pounds(e: ExciseEvent, pounds: Decimal) kind empirical {
    label en official "section 4281(b): the maximum weight contained in the type certificate or airworthiness certificate of the aircraft";
}
pub relation aircraft_operated_on_established_line(e: ExciseEvent) kind empirical {
    label en official "section 4281(a): the aircraft is operated on an established line";
}
pub relation flight_sole_purpose_sightseeing(e: ExciseEvent) kind empirical {
    label en official "section 4281(c): the flight's sole purpose is sightseeing (then the aircraft is not operated on an established line)";
}
pub relation aircraft_is_jet_aircraft(e: ExciseEvent) kind empirical {
    label en official "section 4281(a), (d): a jet aircraft (rotorcraft and propeller aircraft are not jet aircraft)";
}
pub relation aircraft_is_rotorcraft_or_propeller_aircraft(e: ExciseEvent) kind empirical {
    label en official "section 4281(d): the aircraft is a rotorcraft or propeller aircraft";
}
pub relation operated_on_established_line_for_4281(e: ExciseEvent) kind institutional {
    label en official "section 4281(a), (c): operated on an established line, excluding a flight whose sole purpose is sightseeing";
}
pub relation jet_aircraft_for_4281(e: ExciseEvent) kind institutional {
    label en official "section 4281(d): a jet aircraft, not a rotorcraft or propeller aircraft";
}
@source(IRC_S4281_C, relation = formalizes, coverage = exact, quote = "an aircraft shall not be considered as operated on an established line at any time during which such aircraft is being operated on a flight the sole purpose of which is sightseeing.")
rule EstablishedLineForSmallAircraft(e: ExciseEvent) strict {
    when aircraft_operated_on_established_line(e) and not_known(flight_sole_purpose_sightseeing(e));
    then operated_on_established_line_for_4281(e);
}
@source(IRC_S4281_D, relation = formalizes, coverage = exact, quote = "the term \"jet aircraft\" shall not include any aircraft which is a rotorcraft or propeller aircraft.")
rule JetAircraftForSmallAircraft(e: ExciseEvent) strict {
    when aircraft_is_jet_aircraft(e) and not_known(aircraft_is_rotorcraft_or_propeller_aircraft(e));
    then jet_aircraft_for_4281(e);
}
@source(IRC_S4281_A, relation = formalizes, coverage = exact, quote = "The taxes imposed by sections 4261 and 4271 shall not apply to transportation by an aircraft having a maximum certificated takeoff weight of 6,000 pounds or less")
rule SmallAircraftExempt(e: ExciseEvent, pounds: Decimal) strict {
    when aircraft_maximum_certificated_takeoff_weight_pounds(e, pounds)
        and pounds <= 6000.0
        and not_known(operated_on_established_line_for_4281(e))
        and not_known(jet_aircraft_for_4281(e));
    then tax_free_sale(e);
}

pub relation aircraft_owner_or_lessee_is_member_of_affiliated_group(e: ExciseEvent, owner: Person) kind empirical {
    label en official "section 4282(a)(1): one member of an affiliated group (section 1504(a) with all corporations treated as includible corporations) is the owner or lessee of the aircraft";
}
pub relation aircraft_available_for_hire_by_nonmembers_on_flight(e: ExciseEvent) kind empirical {
    label en official "section 4282(a)(2), (b): the aircraft is available for hire by persons who are not members of the group, determined flight by flight";
}
pub relation payment_between_members_of_affiliated_group_for_aircraft_services(e: ExciseEvent) kind empirical {
    label en official "section 4282(a): a payment received by one member of the group from another member for services furnished in connection with the use of the aircraft";
}
@source(IRC_S4282_A, relation = formalizes, coverage = exact, quote = "no tax shall be imposed under section 4261 or 4271 upon any payment received by one member of the affiliated group from another member of such group")
rule AffiliatedGroupAircraftPaymentExempt(e: ExciseEvent, owner: Person) strict {
    when aircraft_owner_or_lessee_is_member_of_affiliated_group(e, owner)
        and payment_between_members_of_affiliated_group_for_aircraft_services(e)
        and not_known(aircraft_available_for_hire_by_nonmembers_on_flight(e));
    then tax_free_sale(e);
}

// --- section 4271(c): joint provision of services ---
pub relation air_freight_joint_services_receipts_and_expenses(e: AirFreightPaymentEvent, receipts_portion_received_by_carrier: Money, expenses_of_non_carriers_attributable: Money) kind empirical {
    label en official "section 4271(c): a person engaged in the business of transporting property by air for hire and other persons jointly provide services, the carrier receiving a portion of the receipts; the expenses incurred by the persons not so engaged that are properly attributable to the taxable transportation and taken into account in fixing that portion";
}
pub relation air_freight_amount_paid_in_joint_case(e: AirFreightPaymentEvent, amount: Money) kind institutional {
    label en official "section 4271(c): the amount paid for the taxable transportation is the sum of the receipts portion and the attributable expenses";
}
@source(IRC_S4271_C, relation = formalizes, coverage = exact, quote = "the amount paid for the taxable transportation shall be treated as being the sum of (1) the portion of the receipts so received, and (2) any expenses incurred by any of the persons not so engaged")
rule AirFreightJointServicesAmountPaid(e: AirFreightPaymentEvent, receipts: Money, expenses: Money) strict {
    when air_freight_joint_services_receipts_and_expenses(e, receipts, expenses);
    then air_freight_amount_paid_in_joint_case(e, receipts + expenses);
}
