// Stage 2: chapter 38 (environmental taxes): section 4611(d)-(f) is in the
// stage-1 event shape of 08-environmental.law; section 4612 (definitions,
// credits), section 4662 (taxable chemicals: exemptions, refunds), sections
// 4671-4672 (imported substances), sections 4681-4682 (ozone-depleting
// chemicals) and chapter 39 section 4701 (unregistered obligations).
//
// The tables of sections 4661(b) (all 42 chemicals, completing stage 1),
// 4672(a)(3) (the initial list) and 4682(a)(2), (b) (ozone-depletion factors)
// are `.lawtable.json` sidecars.

// =====================================================================
// Section 4612 — definitions and credits (crude oil and petroleum products)
// =====================================================================

use self::{
    ChemicalSaleEvent,
    CrudeOilEvent,
    CrudeOilEventKind,
    ExciseEvent,
    IRC_S4612_A,
    IRC_S4612_B,
    IRC_S4612_C,
    IRC_S4612_D,
    IRC_S4662_A,
    IRC_S4662_B,
    IRC_S4662_C,
    IRC_S4662_D,
    IRC_S4662_E,
    IRC_S4671_A,
    IRC_S4671_B,
    IRC_S4672_A,
    IRC_S4672_NOTE_8,
    IRC_S4681_A,
    IRC_S4681_B,
    IRC_S4681_TABLE_1,
    IRC_S4682_A,
    IRC_S4682_C,
    IRC_S4682_D,
    IRC_S4682_G,
    IRC_S4682_H,
    IRC_S4701_A,
    IRC_S4701_B,
    Organ,
    Person,
    Secretary,
    chemical_sale,
    crude_oil_event,
    excise_tax_due,
    liable_for_excise,
    required_corrective_action_uncompleted_on_sale_date,
    tax_free_sale,
};

pub relation crude_oil_quantity_gallons(e: CrudeOilEvent, gallons: Decimal) kind empirical {
    label en official "section 4612(a)(8): the quantity in United States gallons (a barrel is 42 United States gallons)";
}
pub relation crude_oil_quantity_barrels(e: CrudeOilEvent, barrels: Decimal) kind institutional {
    label en official "section 4612(a)(8)-(9): the quantity in barrels, a fraction of a barrel being taxed at the same fraction";
}
@source(IRC_S4612_A, relation = formalizes, coverage = exact, quote = "The term \"barrel\" means 42 United States gallons.")
rule BarrelsFromGallons(e: CrudeOilEvent, gallons: Decimal) strict {
    when crude_oil_quantity_gallons(e, gallons);
    then crude_oil_quantity_barrels(e, div_round(gallons, 42.0, 6, "HALF_UP"));
}

pub relation prior_section_4611_tax_established(e: CrudeOilEvent) kind empirical {
    label en official "section 4612(b): the person who would be liable establishes that a prior tax imposed by section 4611 has been imposed with respect to the product";
}
@source(IRC_S4612_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by section 4611 with respect to any petroleum product if the person who would be liable for such tax establishes that a prior tax imposed by such section has been imposed with respect to such product.")
rule OnlyOneSection4611TaxPerProduct(e: CrudeOilEvent) strict {
    when crude_oil_event(e, _, _, _, _) and prior_section_4611_tax_established(e);
    then tax_free_sale(e);
}

pub relation pipeline_crude_oil_removed_and_returned(e: CrudeOilEvent, operator: Person, removed_barrels: Decimal, returned_barrels: Decimal) kind empirical {
    label en official "section 4612(c): the operator of a United States refinery removes crude oil from a pipeline and returns a portion of it into a stream of other crude oil in the same pipeline";
}
pub relation pipeline_return_credit(e: CrudeOilEvent, credit: Money) kind institutional {
    label en official "section 4612(c): the credit equal to the section 4611 rate on the crude oil removed times the barrels returned";
}
@source(IRC_S4612_C, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by section 4611 to such operator an amount equal to the product of the rate of tax imposed by section 4611 on the crude oil so removed by such operator and the number of barrels of crude oil returned by such operator to such pipeline.")
rule PipelineReturnCredit(e: CrudeOilEvent, removed: Decimal, returned: Decimal, due: Money) defeasible {
    when pipeline_crude_oil_removed_and_returned(e, _, removed, returned) and excise_tax_due(e, due) and removed > 0.0 and returned <= removed;
    then pipeline_return_credit(e, round(due * (returned / removed), 2, "HALF_UP"));
}

pub relation oil_spill_credit_prepaid_amounts(e: CrudeOilEvent, paid_before_1987_with_interest: Money, taken_into_account_in_prior_periods: Money) kind empirical {
    label en official "section 4612(d): the amounts paid before January 1, 1987 into the Deepwater Port Liability Trust Fund and the Offshore Oil Pollution Compensation Fund (and the Trans-Alaska Pipeline Liability Fund amounts transferred), with interest, and the part already taken into account for prior periods (an affiliated group is one taxpayer, section 1504(a) at 100 percent)";
}
pub relation oil_spill_rate_portion_of_tax(e: CrudeOilEvent, portion: Money) kind empirical {
    label en official "section 4612(d): so much of the tax as is attributable to the Oil Spill Liability Trust Fund financing rate";
}
pub relation oil_spill_prepayment_credit(e: CrudeOilEvent, credit: Money) kind institutional {
    label en official "section 4612(d): the excess of the pre-1987 fund payments over the amounts taken into account for prior periods, applied against the oil spill portion of the tax (not below zero, not beyond that portion)";
}
@source(IRC_S4612_D, relation = formalizes, coverage = partial, quote = "There shall be allowed as a credit against so much of the tax imposed by section 4611 as is attributable to the Oil Spill Liability Trust Fund financing rate for any period an amount equal to the excess of—")
rule OilSpillPrepaymentCreditAvailable(e: CrudeOilEvent, paid: Money, used: Money, portion: Money) strict {
    when oil_spill_credit_prepaid_amounts(e, paid, used) and oil_spill_rate_portion_of_tax(e, portion) and paid > used and paid - used <= portion;
    then oil_spill_prepayment_credit(e, paid - used);
}
@source(IRC_S4612_D, relation = formalizes, coverage = partial, quote = "There shall be allowed as a credit against so much of the tax imposed by section 4611 as is attributable to the Oil Spill Liability Trust Fund financing rate for any period an amount equal to the excess of—")
rule OilSpillPrepaymentCreditLimitedToPortion(e: CrudeOilEvent, paid: Money, used: Money, portion: Money) strict {
    when oil_spill_credit_prepaid_amounts(e, paid, used) and oil_spill_rate_portion_of_tax(e, portion) and paid > used and paid - used > portion;
    then oil_spill_prepayment_credit(e, portion);
}

// =====================================================================
// Section 4662 — taxable chemicals: definitions, exemptions, credits
// =====================================================================

pub relation chemical_tons_gas_equivalent(e: ChemicalSaleEvent, pounds: Decimal, gas: Boolean) kind empirical {
    label en official "section 4662(a)(4): the quantity in pounds; for a gas the ton is the amount in cubic feet equivalent to 2,000 pounds on a molecular weight basis (the conversion is the caller's, the quantity is asserted as pounds-equivalent)";
}
pub relation chemical_quantity_tons(e: ChemicalSaleEvent, tons: Decimal) kind institutional {
    label en official "section 4662(a)(4)-(5): the quantity in tons of 2,000 pounds, a fraction of a ton being taxed at the same fraction";
}
@source(IRC_S4662_A, relation = formalizes, coverage = partial, quote = "The term \"ton\" means 2,000 pounds.")
rule ChemicalTonsFromPounds(e: ChemicalSaleEvent, pounds: Decimal, gas: Boolean) strict {
    when chemical_tons_gas_equivalent(e, pounds, gas);
    then chemical_quantity_tons(e, div_round(pounds, 2000.0, 6, "HALF_UP"));
}

pub relation chemical_manufactured_or_entered_in_united_states(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(a)(1)(B): the substance is manufactured or produced in the United States or entered into the United States for consumption, use, or warehousing";
}
pub relation chemical_derived_from_coal(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(4): the substance is derived from coal (to the extent of the derivation)";
}
pub relation methane_or_butane_used_as_fuel(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(1): methane or butane used as a fuel or in the manufacture of motor fuel, diesel fuel, aviation fuel, or jet fuel (under regulations it is a taxable chemical only when used otherwise)";
}
pub relation chemical_qualified_fertilizer_use(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(2)(B)-(C): used (or sold for use, or resale for ultimate use) in the manufacture or production of fertilizer or for direct application as a fertilizer";
}
pub relation sulfuric_acid_byproduct_of_air_pollution_control_same_site(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(3): sulfuric acid produced solely as a byproduct of, and on the same site as, air pollution control equipment";
}
pub relation chemical_qualified_fuel_use(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(5)(B)-(C): used (or sold for use, or resale for ultimate use) in the manufacture or production of motor fuel, diesel fuel, aviation fuel, or jet fuel, or as such a fuel";
}
pub relation chemical_transitory_presence_in_smelting_or_refining(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(6)(A): the chemical (barium sulfide, cupric sulfate, cupric oxide, cuprous oxide, lead oxide, zinc chloride, zinc sulfate, or a solution or mixture containing them) is present only transitorily during a process of smelting, refining, or otherwise extracting a substance not subject to tax";
}
pub relation chemical_removed_from_extraction_process(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(6)(C): the chemical is removed from or ceases to be part of the smelting, refining, or extraction process";
}
pub relation recycled_from_solid_waste_not_original_process(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(8)(A): the chromium, cobalt, or nickel is diverted or recovered in the United States from solid waste as part of a recycling process (not the original manufacturing or production process)";
}
pub relation required_corrective_action_uncompleted(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(8)(B)-(D): the corrective action required of the taxpayer at the recycling unit is uncompleted (a groundwater treatment action counts as completed at the close of 10 years while treatment complies)";
}
pub relation chemical_qualified_animal_feed_use(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(9)(B)-(C): used (or sold for use, or resale for ultimate use) in the manufacture or production of animal feed, feed supplements or their ingredients";
}
pub relation organic_taxable_chemical_in_intermediate_hydrocarbon_stream(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(10)(A): the organic taxable chemical is part of an intermediate hydrocarbon stream containing one or more organic taxable chemicals";
}
pub relation intermediate_stream_sale_registration_requirements_satisfied(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(b)(10)(C), (c)(2)(B): on a sale of the stream the parties are registered and the receiver notified its registration number and district";
}
pub relation chemical_sold_for_export_or_resale_for_export(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(e)(1)(A): the sale by the manufacturer or producer is for export, or for resale by the purchaser to a second purchaser for export";
}
pub relation export_proof_received_within_window(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(e)(1)(B): rules similar to section 4221(b): proof of export received within the 6-month window";
}


@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "the term \"taxable chemical\" shall not include any substance to the extent derived from coal.")
rule ChemicalDerivedFromCoalNotTaxable(e: ChemicalSaleEvent) strict {
    when chemical_sale(e, _, _, _, _) and chemical_derived_from_coal(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "Under regulations prescribed by the Secretary, methane or butane shall be treated as a taxable chemical only if it is used otherwise than as a fuel")
rule MethaneOrButaneUsedAsFuelNotTaxable(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Methane" or s == "Butane") and methane_or_butane_used_as_fuel(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "which is a qualified fertilizer substance, no tax shall be imposed under section 4661(a).")
rule FertilizerSubstanceExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Nitric acid" or s == "Sulfuric acid" or s == "Ammonia" or s == "Methane") and chemical_qualified_fertilizer_use(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "In the case of sulfuric acid produced solely as a byproduct of and on the same site as air pollution control equipment, no tax shall be imposed under section 4661.")
rule SulfuricAcidByproductOfAirPollutionControlExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and s == "Sulfuric acid" and sulfuric_acid_byproduct_of_air_pollution_control_same_site(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "In the case of any chemical described in subparagraph (D) which is a qualified fuel substance, no tax shall be imposed under section 4661(a).")
rule FuelSubstanceExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Acetylene" or s == "Benzene" or s == "Butylene" or s == "Butadiene" or s == "Ethylene" or s == "Napthalene" or s == "Propylene" or s == "Toluene" or s == "Xylene") and chemical_qualified_fuel_use(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4661(a) on any taxable chemical described in subparagraph (B) by reason of the transitory presence of such chemical")
rule TransitoryPresenceExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Barium sulfide" or s == "Cupric sulfate" or s == "Cupric oxide" or s == "Cuprous oxide" or s == "Lead oxide" or s == "Zinc chloride" or s == "Zinc sulfate") and chemical_transitory_presence_in_smelting_or_refining(e) and not_known(chemical_removed_from_extraction_process(e));
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4661(a) on any chromium, cobalt, or nickel which is diverted or recovered in the United States")
rule RecycledMetalExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Chromium" or s == "Cobalt" or s == "Nickel") and recycled_from_solid_waste_not_original_process(e) and not_known(required_corrective_action_uncompleted(e)) and not_known(required_corrective_action_uncompleted_on_sale_date(e));
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "which is a qualified animal feed substance, no tax shall be imposed under section 4661(a).")
rule AnimalFeedSubstanceExempt(e: ChemicalSaleEvent, s: Text) strict {
    when chemical_sale(e, s, _, _, _) and (s == "Nitric acid" or s == "Sulfuric acid" or s == "Ammonia" or s == "Methane") and chemical_qualified_animal_feed_use(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_B, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4661(a) on any organic taxable chemical while such chemical is part of an intermediate hydrocarbon stream")
rule IntermediateHydrocarbonStreamExempt(e: ChemicalSaleEvent) strict {
    when chemical_sale(e, _, _, _, _) and organic_taxable_chemical_in_intermediate_hydrocarbon_stream(e);
    then tax_free_sale(e);
}
@source(IRC_S4662_E, relation = formalizes, coverage = exact, quote = "No tax shall be imposed under section 4661 on the sale by the manufacturer or producer of any taxable chemical for export, or for resale by the purchaser to a second purchaser for export.")
rule ChemicalExportSaleExempt(e: ChemicalSaleEvent) strict {
    when chemical_sale(e, _, _, _, _) and chemical_sold_for_export_or_resale_for_export(e) and export_proof_received_within_window(e);
    then tax_free_sale(e);
}

// (c) use and inventory exchange
pub relation chemical_used_by_manufacturer_producer_or_importer(e: ChemicalSaleEvent, user: Person) kind empirical {
    label en official "section 4662(c)(1): a person who manufactures, produces or imports a taxable chemical and uses it";
}
pub relation chemical_inventory_exchange(e: ChemicalSaleEvent, other_person: Person) kind empirical {
    label en official "section 4662(c)(2)(C): an exchange of property that is inventory property (section 1221(a)(1)) in the hands of each party";
}
pub relation both_exchange_parties_registered_and_notified(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(c)(2)(B): both parties are registered as manufacturers, producers, or importers of taxable chemicals and the receiver notified its registration number and district";
}
pub relation chemical_use_liability_for_tax(e: ChemicalSaleEvent, user: Person) kind institutional {
    label en official "section 4662(c)(1): the user is liable for tax as if the chemical were sold by him";
}
pub relation inventory_exchange_not_a_sale_other_person_treated_as_manufacturer(e: ChemicalSaleEvent, other_person: Person) kind institutional {
    label en official "section 4662(c)(2)(A): the exchange is not a sale and the other person is treated as manufacturer, producer, or importer";
}
@source(IRC_S4662_C, relation = formalizes, coverage = exact, quote = "then such person shall be liable for tax under section 4661 in the same manner as if such chemical were sold by such person.")
rule ChemicalUseTreatedAsSale(e: ChemicalSaleEvent, user: Person) strict {
    when chemical_used_by_manufacturer_producer_or_importer(e, user);
    then chemical_use_liability_for_tax(e, user);
}
@source(IRC_S4662_C, relation = formalizes, coverage = exact, quote = "(i) such exchange shall not be treated as a sale, and")
rule InventoryExchangeNotASale(e: ChemicalSaleEvent, other: Person) strict {
    when chemical_inventory_exchange(e, other) and both_exchange_parties_registered_and_notified(e);
    then inventory_exchange_not_a_sale_other_person_treated_as_manufacturer(e, other);
}
@source(IRC_S4662_C, relation = formalizes, coverage = exact, quote = "(i) such exchange shall not be treated as a sale, and")
rule InventoryExchangeTaxFree(e: ChemicalSaleEvent, other: Person) strict {
    when inventory_exchange_not_a_sale_other_person_treated_as_manufacturer(e, other);
    then tax_free_sale(e);
}

// (d) and (e)(2) credits and refunds are powers of the person who used or paid
pub relation chemical_tax_paid(e: ChemicalSaleEvent, payer: Person, amount: Money) kind empirical {
    label en official "a tax under section 4661 was paid with respect to the chemical, and by whom";
}
pub relation chemical_used_in_manufacture_of_other_taxable_chemical(e: ChemicalSaleEvent, user: Person) kind empirical {
    label en official "section 4662(d)(1)(B): the chemical was used by a person in the manufacture or production of any other substance which is a taxable chemical";
}
pub relation tax_on_other_substance_manufactured(e: ChemicalSaleEvent, amount: Money) kind empirical {
    label en official "section 4662(d)(1): the tax imposed on the other substance manufactured (or which would have been imposed but for subsection (b) or (e)): the cap of the credit";
}
pub relation chemical_credit_or_refund_claim(e: ChemicalSaleEvent, claimant: Person) kind empirical {
    label en official "the claimant claims credit or refund under section 4662(d) or (e)(2)";
}
pub relation chemical_credit_for_further_taxable_manufacture_valid(e: ChemicalSaleEvent, claimant: Person) kind institutional {
    label en official "section 4662(d)(1): the claimant used the chemical to make another taxable chemical";
}
pub relation chemical_credit_or_refund_allowed(e: ChemicalSaleEvent, claimant: Person, amount: Money) kind institutional {
    label en official "the amount allowed as credit or refund (without interest)";
}
@source(IRC_S4662_D, relation = formalizes, coverage = exact, quote = "(B) such chemical was used by any person in the manufacture or production of any other substance which is a taxable chemical,")
rule ChemicalCreditForFurtherManufactureConditions(e: ChemicalSaleEvent, user: Person) strict {
    when chemical_used_in_manufacture_of_other_taxable_chemical(e, user);
    then chemical_credit_for_further_taxable_manufacture_valid(e, user);
}
@source(IRC_S4662_D, relation = formalizes, coverage = exact, quote = "then an amount equal to the tax so paid shall be allowed as a credit or refund (without interest) to such person in the same manner as if it were an overpayment of tax imposed by such section.")
rule ChemicalCreditForFurtherManufacturePowerRule(e: ChemicalSaleEvent, claimant: Person, paid: Money) defeasible {
    when chemical_credit_or_refund_claim(e, claimant) and chemical_tax_paid(e, _, paid);
    then power ChemicalCreditForFurtherTaxableManufacture {
        holder claimant;
        over e;
        exercise chemical_credit_or_refund_claim(e, claimant);
        valid_when chemical_credit_for_further_taxable_manufacture_valid(e, claimant);
        effect create(chemical_credit_or_refund_allowed(e, claimant, paid));
        window [-infinity, infinity];
    };
}

pub relation chemical_exported_by_someone_after_tax_paid(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(e)(2)(A)(ii)(I): the chemical was exported by any person";
}
pub relation chemical_used_as_material_in_exported_taxable_substance(e: ChemicalSaleEvent) kind empirical {
    label en official "section 4662(e)(2)(A)(ii)(II): the chemical was used as a material in a substance which was exported and which at export was a taxable substance (section 4672(a))";
}
pub relation payer_repaid_or_agreed_to_repay_exporter(e: ChemicalSaleEvent, payer: Person) kind empirical {
    label en official "section 4662(e)(2)(B)(i): the person who paid the tax has repaid or agreed to repay it to the exporter";
}
pub relation payer_obtained_written_consent_of_exporter(e: ChemicalSaleEvent, payer: Person) kind empirical {
    label en official "section 4662(e)(2)(B)(ii): the person who paid the tax has obtained the written consent of the exporter to the credit or refund";
}
pub relation export_refund_conditions_met(e: ChemicalSaleEvent, payer: Person) kind institutional {
    label en official "section 4662(e)(2): the chemical or a substance made from it was exported, and the payer meets the repayment or consent condition";
}
@source(IRC_S4662_E, relation = formalizes, coverage = exact, quote = "(i) has repaid or agreed to repay the amount of the tax to the person who exported the taxable chemical or taxable substance (as so defined), or")
rule ExportRefundConditionsByRepayment(e: ChemicalSaleEvent, payer: Person) strict {
    when chemical_exported_by_someone_after_tax_paid(e) and payer_repaid_or_agreed_to_repay_exporter(e, payer);
    then export_refund_conditions_met(e, payer);
}
@source(IRC_S4662_E, relation = formalizes, coverage = exact, quote = "(ii) has obtained the written consent of such exporter to the allowance of the credit or the making of the refund.")
rule ExportRefundConditionsByConsent(e: ChemicalSaleEvent, payer: Person) strict {
    when chemical_exported_by_someone_after_tax_paid(e) and payer_obtained_written_consent_of_exporter(e, payer);
    then export_refund_conditions_met(e, payer);
}
@source(IRC_S4662_E, relation = formalizes, coverage = exact, quote = "credit or refund (without interest) of such tax shall be allowed or made to the person who paid such tax.")
rule ExportRefundPowerRule(e: ChemicalSaleEvent, payer: Person, paid: Money) defeasible {
    when chemical_credit_or_refund_claim(e, payer) and chemical_tax_paid(e, payer, paid);
    then power ChemicalExportRefundClaim {
        holder payer;
        over e;
        exercise chemical_credit_or_refund_claim(e, payer);
        valid_when export_refund_conditions_met(e, payer);
        effect create(chemical_credit_or_refund_allowed(e, payer, paid));
        window [-infinity, infinity];
    };
}

// =====================================================================
// Sections 4671, 4672 — imported taxable substances
// =====================================================================

pub entity ImportedSubstanceEvent : ExciseEvent;

pub relation imported_substance_sale_or_use(e: ImportedSubstanceEvent, substance: Text, appraised_value: Money, on: Date, importer: Person) kind empirical {
    label en official "section 4671(a): a taxable substance sold or used by the importer, with its appraised value when entered into the United States";
}
pub relation tax_on_taxable_chemicals_used_as_materials(e: ImportedSubstanceEvent, tax: Money) kind empirical {
    label en official "section 4671(b)(1): the tax which section 4661 would have imposed on the taxable chemicals used as materials in the manufacture of the substance if sold in the United States for that use (a computation on the substance's bill of materials, given as an amount)";
}
pub relation importer_furnished_information_to_secretary(e: ImportedSubstanceEvent) kind empirical {
    label en official "section 4671(b)(2): the importer furnishes the Secretary, at the time and in the manner prescribed, sufficient information to determine the tax under paragraph (1)";
}
pub relation secretary_prescribed_rate_for_substance(e: ImportedSubstanceEvent, tax: Money) kind empirical {
    label en official "section 4671(b)(3): the tax prescribed by the Secretary for the substance in lieu of the paragraph (2) rate (equal to the tax that would be imposed if the substance were produced using the predominant method of production)";
}
pub relation substance_taxed_under_4611_or_4661(e: ImportedSubstanceEvent) kind empirical {
    label en official "section 4671(c): tax is imposed on the sale or use of the substance under section 4611 or 4661";
}
pub relation initial_list_taxable_substance(substance: Text, listed: Boolean) kind institutional {
    label en official "section 4672(a)(3): the substance is on the initial list of taxable substances (populated by initial-taxable-substance-list.lawtable.json)";
}
external judgment relation secretary_determines_substance_meets_20_percent_test(substance: Text) {
    authority Secretary;
    label en official "section 4672(a)(2)(B): the Secretary determines, in consultation with the Administrator of the EPA and the Commissioner of U.S. Customs and Border Protection, that taxable chemicals are more than 20 percent of the weight (or value) of the materials used to produce the substance, on the predominant method of production";
}
pub relation substance_removed_from_list_by_secretary(substance: Text) kind empirical {
    label en official "section 4672(a)(4): the Secretary has removed the substance from the list (allowed only for substances meeting neither test)";
}
pub relation listed_taxable_substance(substance: Text) kind institutional {
    label en official "section 4672(a)(1)-(2): a substance listed as a taxable substance";
}
@source(IRC_S4672_A, relation = formalizes, coverage = exact, quote = "(A) the substance is contained in the list under paragraph (3), or")
rule TaxableSubstanceOnInitialList(s: Text) strict {
    when initial_list_taxable_substance(s, true) and not_known(substance_removed_from_list_by_secretary(s));
    then listed_taxable_substance(s);
}
@source(IRC_S4672_A, relation = formalizes, coverage = exact, quote = "the Secretary determines, in consultation with the Administrator of the Environmental Protection Agency and the Commissioner of U.S. Customs and Border Protection, that taxable chemicals constitute more than 20 percent of the weight")
rule TaxableSubstanceByTwentyPercentTest(s: Text) strict {
    when secretary_determines_substance_meets_20_percent_test(s);
    then listed_taxable_substance(s);
}

@source(IRC_S4671_B, relation = formalizes, coverage = exact, quote = "shall be the amount of the tax which would have been imposed by section 4661 on the taxable chemicals used as materials in the manufacture or production of such substance")
rule ImportedSubstanceTaxOnMaterials(e: ImportedSubstanceEvent, s: Text, on: Date, tax: Money) strict {
    when imported_substance_sale_or_use(e, s, _, on, _)
        and listed_taxable_substance(s)
        and importer_furnished_information_to_secretary(e)
        and tax_on_taxable_chemicals_used_as_materials(e, tax)
        and not_known(substance_taxed_under_4611_or_4661(e))
        and on <= @2031-12-31;
    then excise_tax_due(e, tax);
}
@source(IRC_S4671_B, relation = formalizes, coverage = exact, quote = "the amount of the tax imposed on such taxable substance shall be 10 percent of the appraised value of such substance")
rule ImportedSubstanceTaxWithoutInformation(e: ImportedSubstanceEvent, s: Text, value: Money, on: Date) strict {
    when imported_substance_sale_or_use(e, s, value, on, _)
        and listed_taxable_substance(s)
        and not_known(importer_furnished_information_to_secretary(e))
        and not_known(secretary_prescribed_rate_stated(e))
        and not_known(substance_taxed_under_4611_or_4661(e))
        and on <= @2031-12-31;
    then excise_tax_due(e, round(value * S4671UninformedImporterRatePercent, 2, "HALF_UP"));
}
pub relation secretary_prescribed_rate_stated(e: ImportedSubstanceEvent) kind empirical {
    label en official "marker: a Secretary-prescribed rate under section 4671(b)(3) is stated for this substance";
}
@source(IRC_S4671_B, relation = formalizes, coverage = exact, quote = "The tax prescribed by the Secretary shall be equal to the amount of tax which would be imposed by subsection (a) with respect to the taxable substance if such substance were produced using the predominant method of production of such substance.")
rule ImportedSubstanceSecretaryPrescribedRate(e: ImportedSubstanceEvent, s: Text, on: Date, tax: Money) strict {
    when imported_substance_sale_or_use(e, s, _, on, _)
        and listed_taxable_substance(s)
        and not_known(importer_furnished_information_to_secretary(e))
        and secretary_prescribed_rate_for_substance(e, tax)
        and not_known(substance_taxed_under_4611_or_4661(e))
        and on <= @2031-12-31;
    then excise_tax_due(e, tax);
}
@source(IRC_S4671_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on any taxable substance sold or used by the importer thereof.")
rule ImportedSubstanceLiability(e: ImportedSubstanceEvent, importer: Person, amount: Money) defeasible {
    when imported_substance_sale_or_use(e, _, _, _, importer) and excise_tax_due(e, amount);
    then liable_for_excise(importer, e, amount);
}

pub relation secretary_added_substances_meeting_tests_to_list(x: Organ) kind institutional {
    label en official "section 4672(a)(4): the Secretary has added to the list the substances which meet either the weight or value test of paragraph (2)(B)";
}
@source(IRC_S4672_A, relation = formalizes, coverage = exact, quote = "The Secretary shall add to the list under paragraph (3) substances which meet either the weight or value tests of paragraph (2)(B)")
rule Section4672a4ListModificationDutyRule strict {
    when true;
    then duty AddSubstancesMeetingTestsToTaxableSubstanceList {
        bearer Secretary;
        goal maintenance {
            condition secretary_added_substances_meeting_tests_to_list(Secretary);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Sections 4681, 4682 — ozone-depleting chemicals
// =====================================================================

pub entity OzoneChemicalEvent : ExciseEvent;

pub relation ozone_chemical_sale_or_use(e: OzoneChemicalEvent, chemical: Text, pounds: Decimal, calendar_year: Integer, seller_or_user: Person) kind empirical {
    label en official "section 4681(a)(1): an ozone-depleting chemical sold or used by the manufacturer, producer, or importer, with the pounds and the calendar year of the sale or use";
}
pub relation ozone_depletion_factor(chemical: Text, factor: Decimal) kind institutional {
    label en official "section 4682(b): the ozone-depletion factor of the chemical (populated by ozone-depletion-factor.lawtable.json)";
}
pub relation ozone_chemical_manufactured_or_entered_in_united_states(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(a)(1)(B): manufactured or produced in the United States or entered for consumption, use, or warehousing";
}
pub relation ozone_depleting_chemical(e: OzoneChemicalEvent) kind institutional {
    label en official "section 4682(a)(1): a substance listed in the table of section 4682(a)(2) that is manufactured or produced in, or entered into, the United States";
}
pub relation ozone_base_tax_amount(e: OzoneChemicalEvent, base: Money) kind institutional {
    label en official "section 4681(b)(1)(B): the base tax amount per pound for the calendar year: $5.35 increased by 45 cents for each year after 1995 (the table values of 1993-1995 apply to earlier years)";
}
pub relation ozone_tax_per_pound(e: OzoneChemicalEvent, per_pound: Money) kind institutional {
    label en official "section 4681(b)(1)(A): the base tax amount multiplied by the ozone-depletion factor";
}
@source(IRC_S4682_A, relation = formalizes, coverage = exact, quote = "(B) which is manufactured or produced in the United States or entered into the United States for consumption, use, or warehousing.")
rule OzoneDepletingChemicalClassification(e: OzoneChemicalEvent, c: Text, f: Decimal) strict {
    when ozone_chemical_sale_or_use(e, c, _, _, _) and ozone_depletion_factor(c, f) and ozone_chemical_manufactured_or_entered_in_united_states(e);
    then ozone_depleting_chemical(e);
}
@source(IRC_S4681_B, relation = formalizes, coverage = exact, quote = "The base tax amount for purposes of subparagraph (A) with respect to any sale or use during any calendar year after 1995 shall be $5.35 increased by 45 cents for each year after 1995.")
rule OzoneBaseTaxAfter1995(e: OzoneChemicalEvent, year: Integer) strict {
    when ozone_chemical_sale_or_use(e, _, _, year, _) and year > 1995;
    then ozone_base_tax_amount(e, S4681BaseTaxAmount1995 + S4681AnnualIncrease * (year - 1995));
}
@source(IRC_S4681_TABLE_1, relation = formalizes, coverage = exact, quote = "1993 / 3.35")
rule OzoneBaseTax1993(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, 1993, _);
    then ozone_base_tax_amount(e, 3.35 USD);
}
@source(IRC_S4681_TABLE_1, relation = formalizes, coverage = exact, quote = "1994 / 4.35")
rule OzoneBaseTax1994(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, 1994, _);
    then ozone_base_tax_amount(e, 4.35 USD);
}
@source(IRC_S4681_TABLE_1, relation = formalizes, coverage = exact, quote = "1995 / 5.35")
rule OzoneBaseTax1995(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, 1995, _);
    then ozone_base_tax_amount(e, 5.35 USD);
}
@source(IRC_S4681_B, relation = formalizes, coverage = exact, quote = "(i) the base tax amount, multiplied by")
rule OzoneTaxPerPound(e: OzoneChemicalEvent, c: Text, f: Decimal, base: Money) strict {
    when ozone_chemical_sale_or_use(e, c, _, _, _) and ozone_depletion_factor(c, f) and ozone_base_tax_amount(e, base);
    then ozone_tax_per_pound(e, round(base * f, 4, "HALF_UP"));
}

pub relation ozone_chemical_recycled_in_united_states_not_original_process(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(d)(1): the chemical is diverted or recovered in the United States as part of a recycling process (not the original manufacturing or production process), or is recycled Halon-1301 or Halon-2402 imported from a Montreal Protocol signatory";
}
pub relation ozone_chemical_entirely_consumed_in_manufacture_of_other_chemical(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(d)(2)(A)(i): the ozone-depleting chemical is used and entirely consumed in the manufacture or production of any other chemical";
}
pub relation ozone_sale_for_entirely_consumed_use_registered(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(d)(2)(A)(ii): the sale is for a use meeting clause (i) (or resale for such a use), and the manufacturer, producer, importer and purchasers meet the registration requirements";
}
pub relation ozone_substance_used_as_propellant_in_metered_dose_inhalers(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(g)(1)(A)(i): the substance is used as a propellant in metered-dose inhalers";
}
pub relation ozone_qualified_sale_for_inhaler_propellant_registered(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(g)(1)(B): a sale for use (or resale for use) as a propellant in metered dose inhalers, with the registration requirements met";
}
pub relation ozone_chemical_sold_for_export(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(d)(3)(A): rules similar to section 4662(e) apply: a sale for export (subject to the limit of subparagraph (B))";
}
pub relation ozone_export_benefit_within_limit(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(d)(3)(B): the aggregate export tax benefit for the calendar year is within the limit (the 1986 export percentage computation is TECH_GAP)";
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by section 4681 on any ozone-depleting chemical which is diverted or recovered in the United States as part of a recycling process")
rule OzoneRecycledExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_chemical_recycled_in_united_states_not_original_process(e);
    then tax_free_sale(e);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(i) on the use of any ozone-depleting chemical in the manufacture or production of any other chemical if the ozone-depleting chemical is entirely consumed in such use,")
rule OzoneEntirelyConsumedUseExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_chemical_entirely_consumed_in_manufacture_of_other_chemical(e);
    then tax_free_sale(e);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "Clause (ii) shall apply only if the manufacturer, producer, and importer, and the 1st and 2d purchasers (if any), meet such registration requirements as may be prescribed by the Secretary.")
rule OzoneSaleForConsumedUseExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_sale_for_entirely_consumed_use_registered(e);
    then tax_free_sale(e);
}
@source(IRC_S4682_G, relation = formalizes, coverage = exact, quote = "(i) any use of any substance as a propellant in metered-dose inhalers, or")
rule OzoneInhalerPropellantUseExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_substance_used_as_propellant_in_metered_dose_inhalers(e);
    then tax_free_sale(e);
}
@source(IRC_S4682_G, relation = formalizes, coverage = exact, quote = "(ii) any qualified sale by the manufacturer, producer, or importer of any substance.")
rule OzoneInhalerQualifiedSaleExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_qualified_sale_for_inhaler_propellant_registered(e);
    then tax_free_sale(e);
}
@source(IRC_S4682_D, relation = formalizes, coverage = partial, quote = "(A) In general")
rule OzoneExportSaleExempt(e: OzoneChemicalEvent) strict {
    when ozone_chemical_sale_or_use(e, _, _, _, _) and ozone_chemical_sold_for_export(e) and ozone_export_benefit_within_limit(e);
    then tax_free_sale(e);
}

@source(IRC_S4681_A, relation = formalizes, coverage = exact, quote = "(1) any ozone-depleting chemical sold or used by the manufacturer, producer, or importer thereof, and")
rule OzoneChemicalTax(e: OzoneChemicalEvent, pounds: Decimal, per_pound: Money) strict {
    when ozone_chemical_sale_or_use(e, _, pounds, _, _) and ozone_depleting_chemical(e) and ozone_tax_per_pound(e, per_pound);
    then excise_tax_due(e, round(per_pound * pounds, 2, "HALF_UP"));
}
@source(IRC_S4681_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on—")
rule OzoneChemicalLiability(e: OzoneChemicalEvent, p: Person, amount: Money) defeasible {
    when ozone_chemical_sale_or_use(e, _, _, _, p) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(p, e, amount);
}

// imported taxable products (section 4682(c))
pub relation imported_product_uses_ozone_depleting_chemical_as_material(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(c)(1): a product (other than an ozone-depleting chemical) entered into the United States for consumption, use, or warehousing, in which an ozone-depleting chemical was used as material";
}
pub relation product_specified_de_minimis_by_regulation(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(c)(2): the product is specified in regulations as using a de minimis amount of ozone-depleting chemicals";
}
pub relation de_minimis_use_for_refrigeration_aerosol_foam_or_electronics(e: OzoneChemicalEvent) kind empirical {
    label en official "section 4682(c)(2), second sentence: an ozone-depleting chemical other than methyl chloroform is used for refrigeration or air conditioning, creating an aerosol or foam, or manufacturing electronic components (the de minimis exception does not apply)";
}
pub relation imported_taxable_product(e: OzoneChemicalEvent) kind institutional {
    label en official "section 4682(c): an imported taxable product";
}
@source(IRC_S4682_C, relation = formalizes, coverage = exact, quote = "The term \"imported taxable product\" shall not include any product specified in regulations prescribed by the Secretary as using a de minimis amount of ozone-depleting chemicals as materials in the manufacture or production thereof.")
rule ImportedTaxableProductNotDeMinimis(e: OzoneChemicalEvent) strict {
    when imported_product_uses_ozone_depleting_chemical_as_material(e) and not_known(product_specified_de_minimis_by_regulation(e));
    then imported_taxable_product(e);
}
@source(IRC_S4682_C, relation = formalizes, coverage = exact, quote = "The preceding sentence shall not apply to any product in which any ozone-depleting chemical (other than methyl chloroform) is used for purposes of refrigeration or air conditioning")
rule ImportedTaxableProductDeMinimisDenied(e: OzoneChemicalEvent) strict {
    when imported_product_uses_ozone_depleting_chemical_as_material(e) and product_specified_de_minimis_by_regulation(e) and de_minimis_use_for_refrigeration_aerosol_foam_or_electronics(e);
    then imported_taxable_product(e);
}

// floor stocks tax (h)
pub relation ozone_chemical_held_on_january_1(e: OzoneChemicalEvent, holder: Person, pounds: Decimal, chemical: Text, tax_increase_year: Integer) kind empirical {
    label en official "section 4682(h)(1)(A): on January 1 of the calendar year an ozone-depleting chemical is held by a person other than its manufacturer, producer or importer for sale or for use in further manufacture";
}
pub relation prior_ozone_tax_on_held_chemical(e: OzoneChemicalEvent, prior: Money) kind empirical {
    label en official "section 4682(h)(1)(B)(ii): the prior tax (if any) imposed by the subchapter on the substance";
}
pub relation floor_stocks_tax_before_prior_tax(e: OzoneChemicalEvent, tax: Money) kind institutional {
    label en official "section 4682(h)(1)(B)(i): the tax which would be imposed under section 4681 on the held quantity if the manufacturer's sale had occurred on the tax-increase date";
}
pub relation floor_stocks_tax(e: OzoneChemicalEvent, tax: Money) kind institutional {
    label en official "section 4682(h)(1)(B): the excess (if any) of that tax over the prior tax";
}
@source(IRC_S4682_H, relation = formalizes, coverage = exact, quote = "(i) the tax which would be imposed under section 4681 on such substance if the sale of such chemical by the manufacturer, producer, or importer thereof had occurred on the tax-increase date, over")
rule FloorStocksTaxBeforePriorTax(e: OzoneChemicalEvent, c: Text, pounds: Decimal, year: Integer, f: Decimal) strict {
    when ozone_chemical_held_on_january_1(e, _, pounds, c, year) and ozone_depletion_factor(c, f) and year > 1995;
    then floor_stocks_tax_before_prior_tax(e, round((S4681BaseTaxAmount1995 + S4681AnnualIncrease * (year - 1995)) * f * pounds, 2, "HALF_UP"));
}
@source(IRC_S4682_H, relation = formalizes, coverage = exact, quote = "The amount of the tax imposed by subparagraph (A) shall be the excess (if any) of—")
rule FloorStocksTaxNetOfPriorTax(e: OzoneChemicalEvent, gross: Money, prior: Money) strict {
    when floor_stocks_tax_before_prior_tax(e, gross) and prior_ozone_tax_on_held_chemical(e, prior) and gross > prior;
    then floor_stocks_tax(e, gross - prior);
}
@source(IRC_S4682_H, relation = formalizes, coverage = exact, quote = "The amount of the tax imposed by subparagraph (A) shall be the excess (if any) of—")
rule FloorStocksTaxNoExcess(e: OzoneChemicalEvent, gross: Money, prior: Money) strict {
    when floor_stocks_tax_before_prior_tax(e, gross) and prior_ozone_tax_on_held_chemical(e, prior) and gross <= prior;
    then floor_stocks_tax(e, 0 USD);
}
@source(IRC_S4682_H, relation = formalizes, coverage = exact, quote = "If, on any tax-increase date, any ozone-depleting chemical is held by any person (other than the manufacturer, producer, or importer thereof) for sale or for use in further manufacture, there is hereby imposed a floor stocks tax.")
rule FloorStocksTaxLiability(e: OzoneChemicalEvent, holder: Person, tax: Money, pounds: Decimal, c: Text, year: Integer) defeasible {
    when ozone_chemical_held_on_january_1(e, holder, pounds, c, year) and floor_stocks_tax(e, tax);
    then liable_for_excise(holder, e, tax);
}
pub relation floor_stocks_tax_paid_on(e: OzoneChemicalEvent, holder: Person, on: Date) kind empirical {
    label en official "the holder paid the floor stocks tax on this date";
}
pub relation floor_stocks_tax_payment_year(e: OzoneChemicalEvent, holder: Person, jan_1: Date, jun_30: Date) kind empirical {
    label en official "section 4682(h)(2): January 1 of the calendar year and June 30 of that year (the due date is a fixed calendar day of the same year; the pair is asserted because there is no date-construction term, TECH-GAPS.md)";
}
pub relation floor_stocks_tax_paid_by_deadline(e: OzoneChemicalEvent, holder: Person) kind empirical {
    label en official "the floor stocks tax was paid on or before June 30";
}
@source(IRC_S4682_H, relation = formalizes, coverage = exact, quote = "The taxes imposed by this subsection on January 1 of any calendar year shall be paid on or before June 30 of such year.")
rule FloorStocksTaxPaymentDutyRule(e: OzoneChemicalEvent, holder: Person, jan1: Date, jun30: Date) defeasible {
    when floor_stocks_tax_payment_year(e, holder, jan1, jun30);
    then duty PayOzoneFloorStocksTaxByJune30 {
        bearer holder;
        goal achievement {
            condition floor_stocks_tax_paid_by_deadline(e, holder);
            window [jan1, jun30];
        }
    };
}

// =====================================================================
// Section 4701 — tax on issuance of registration-required obligations not in registered form
// =====================================================================

pub entity UnregisteredObligationIssue : ExciseEvent;

pub relation unregistered_obligation_issued(e: UnregisteredObligationIssue, issuer: Person, principal: Money, calendar_years_or_portions: Integer, on: Date) kind empirical {
    label en official "section 4701(a): a person issues a registration-required obligation which is not in registered form: the principal amount, the number of calendar years (or portions) from issuance to maturity (asserted: no date-difference term) and the issuance date";
}
pub relation obligation_registration_required_under_163f(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(1)(A): the obligation is a registration-required obligation within the meaning of section 163(f) (EXTERNAL_DEPENDENCY)";
}
pub relation obligation_required_to_be_registered_under_149a(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(1)(A)(i): the obligation is required to be registered under section 149(a)";
}
pub relation obligation_sold_only_to_non_us_persons_with_arrangements(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(1)(B)(i): arrangements reasonably designed to ensure that the obligation will be sold (or resold in connection with the original issue) only to a person who is not a United States person";
}
pub relation obligation_interest_payable_only_outside_united_states(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(1)(B)(ii): interest is payable only outside the United States and its possessions";
}
pub relation obligation_face_statement_us_holders_limited(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(1)(B)(iii): on the face of the obligation there is a statement that any United States person who holds it will be subject to limitations under the United States income tax laws";
}
pub relation obligation_in_registered_form(e: UnregisteredObligationIssue) kind empirical {
    label en official "section 4701(b)(2): the obligation is in registered form (section 163(f))";
}
pub relation obligation_described_in_4701b1b(e: UnregisteredObligationIssue) kind institutional {
    label en official "section 4701(b)(1)(B): an obligation with foreign-targeting arrangements, interest payable abroad, and the face statement";
}
pub relation taxable_registration_required_obligation(e: UnregisteredObligationIssue) kind institutional {
    label en official "section 4701(b)(1)(A): a registration-required obligation other than one required to be registered under section 149(a) or described in subparagraph (B)";
}
@source(IRC_S4701_B, relation = formalizes, coverage = exact, quote = "(iii) on the face of such obligation there is a statement that any United States person who holds such obligation will be subject to limitations under the United States income tax laws.")
rule ObligationDescribedInSubparagraphB(e: UnregisteredObligationIssue) strict {
    when obligation_sold_only_to_non_us_persons_with_arrangements(e)
        and obligation_interest_payable_only_outside_united_states(e)
        and obligation_face_statement_us_holders_limited(e);
    then obligation_described_in_4701b1b(e);
}
@source(IRC_S4701_B, relation = formalizes, coverage = exact, quote = "except that such term shall not include any obligation which—")
rule TaxableRegistrationRequiredObligation(e: UnregisteredObligationIssue) strict {
    when obligation_registration_required_under_163f(e)
        and not_known(obligation_required_to_be_registered_under_149a(e))
        and not_known(obligation_described_in_4701b1b(e));
    then taxable_registration_required_obligation(e);
}
@source(IRC_S4701_A, relation = formalizes, coverage = exact, quote = "(1) 1 percent of the principal amount of such obligation, multiplied by")
rule Section4701Tax(e: UnregisteredObligationIssue, principal: Money, years: Integer) strict {
    when unregistered_obligation_issued(e, _, principal, years, _)
        and taxable_registration_required_obligation(e)
        and not_known(obligation_in_registered_form(e));
    then excise_tax_due(e, round(principal * S4701RatePercent * years, 2, "HALF_UP"));
}
@source(IRC_S4701_A, relation = formalizes, coverage = exact, quote = "In the case of any person who issues a registration-required obligation which is not in registered form, there is hereby imposed on such person on the issuance of such obligation a tax")
rule Section4701Liability(e: UnregisteredObligationIssue, issuer: Person, amount: Money) defeasible {
    when unregistered_obligation_issued(e, issuer, _, _, _) and excise_tax_due(e, amount);
    then liable_for_excise(issuer, e, amount);
}

// --- section 4672 statutory note: substances determined taxable before November 15, 2021 ---
pub relation substance_determined_taxable_under_4672a2_before_2021_11_15(substance: Text) kind empirical {
    label en official "Pub. L. 117-58 section 80201(c)(2): the substance was determined to be a taxable substance by reason of section 4672(a)(2) before the date of enactment of the Act (Nov. 15, 2021)";
}
pub relation secretary_determined_otherwise_for_substance(substance: Text) kind empirical {
    label en official "Pub. L. 117-58 section 80201(c)(2): the Secretary (or delegate) has otherwise determined";
}
@source(IRC_S4672_NOTE_8, relation = formalizes, coverage = exact, quote = "shall continue to be treated as a taxable substance for purposes of such section after such date.")
rule PriorDeterminationsPresumedTaxableSubstance(s: Text) strict {
    when substance_determined_taxable_under_4672a2_before_2021_11_15(s) and not_known(secretary_determined_otherwise_for_substance(s));
    then listed_taxable_substance(s);
}

// --- section 4681(b)(2): imported taxable products ---
pub relation tax_on_ozone_chemicals_used_as_materials_if_sold_on_date(e: OzoneChemicalEvent, tax: Money) kind empirical {
    label en official "section 4681(b)(2)(A): the tax which would have been imposed on the ozone-depleting chemicals used as materials in the manufacture of the product if they had been sold in the United States on the date of the sale of the imported taxable product (a computation on the product's bill of materials, given as an amount; TECH-GAPS.md)";
}
@source(IRC_S4681_B, relation = formalizes, coverage = partial, quote = "The amount of the tax imposed by subsection (a) on any imported taxable product shall be the amount of tax which would have been imposed by subsection (a) on the ozone-depleting chemicals used as materials in the manufacture or production of such product")
rule ImportedTaxableProductTax(e: OzoneChemicalEvent, tax: Money) strict {
    when imported_taxable_product(e) and tax_on_ozone_chemicals_used_as_materials_if_sold_on_date(e, tax);
    then excise_tax_due(e, tax);
}

// --- section 4682(d)(2)(B), (g)(2): credit or refund powers ---
pub relation ozone_tax_paid_on_chemical(e: OzoneChemicalEvent, payer: Person, amount: Money) kind empirical {
    label en official "the tax under the subchapter paid with respect to the ozone-depleting chemical, and by whom";
}
pub relation ozone_credit_or_refund_claim(e: OzoneChemicalEvent, claimant: Person) kind empirical {
    label en official "the claimant claims credit or refund under section 4682(d)(2)(B) or (g)(2)";
}
pub relation ozone_chemical_used_and_entirely_consumed_by_claimant(e: OzoneChemicalEvent, claimant: Person) kind empirical {
    label en official "section 4682(d)(2)(B)(ii): the chemical was used (and entirely consumed) by the claimant in the manufacture or production of any other chemical";
}
pub relation substance_used_by_claimant_as_metered_dose_inhaler_propellant(e: OzoneChemicalEvent, claimant: Person) kind empirical {
    label en official "section 4682(g)(2): the substance on which tax was paid is used by the claimant as a propellant in metered-dose inhalers";
}
pub relation ozone_credit_claim_valid(e: OzoneChemicalEvent, claimant: Person) kind institutional {
    label en official "section 4682(d)(2)(B), (g)(2): the claimant's use qualifies (single-atom valid_when helper)";
}
pub relation ozone_credit_or_refund_allowed(e: OzoneChemicalEvent, claimant: Person, amount: Money) kind institutional {
    label en official "the tax paid is allowed as a credit or refund without interest";
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "(ii) such chemical was used (and entirely consumed) by any person in the manufacture or production of any other chemical,")
rule OzoneCreditClaimValidConsumed(e: OzoneChemicalEvent, c: Person) strict {
    when ozone_chemical_used_and_entirely_consumed_by_claimant(e, c);
    then ozone_credit_claim_valid(e, c);
}
@source(IRC_S4682_G, relation = formalizes, coverage = exact, quote = "If any substance on which tax was paid under this subchapter is used by any person as a propellant in metered-dose inhalers, credit or refund without interest shall be allowed to such person in an amount equal to the tax so paid.")
rule OzoneCreditClaimValidInhaler(e: OzoneChemicalEvent, c: Person) strict {
    when substance_used_by_claimant_as_metered_dose_inhaler_propellant(e, c);
    then ozone_credit_claim_valid(e, c);
}
@source(IRC_S4682_D, relation = formalizes, coverage = exact, quote = "then an amount equal to the tax so paid shall be allowed as a credit or refund (without interest) to such person in the same manner as if it were an overpayment of tax imposed by section 4681.")
rule OzoneCreditRefundPowerRule(e: OzoneChemicalEvent, c: Person, paid: Money) defeasible {
    when ozone_credit_or_refund_claim(e, c) and ozone_tax_paid_on_chemical(e, _, paid);
    then power OzoneChemicalCreditOrRefundClaim {
        holder c;
        over e;
        exercise ozone_credit_or_refund_claim(e, c);
        valid_when ozone_credit_claim_valid(e, c);
        effect create(ozone_credit_or_refund_allowed(e, c, paid));
        window [-infinity, infinity];
    };
}
