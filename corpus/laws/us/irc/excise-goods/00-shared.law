// Shared shapes for Subtitle D, chapters 31-38 ("Excise Taxes on Goods"),
// stage 1 (IRC-13 stage 1, DECISION-0379). Method per AGENT-BRIEF/task: every
// excise tax is a calculation over a taxable EVENT (sale, removal, entry,
// use, port use, wager, payment for a service) with the liable person
// captured as an institutional effect. Because the taxable events differ in
// shape across chapters (a fuel removal is not a wager), this module gives a
// common top type `ExciseEvent` and the two relations every family bridges
// into (`excise_tax_due`, `liable_for_excise`); each family module below
// declares its own `ExciseEvent` subtype with the fields its statute reads
// and its own rules that conclude these two shared relations.
//
// JUDGMENT CALL (report this): `us.irc.core::liability(p, y: TaxableYear,
// kind, amount)` is keyed by ANNUAL TaxableYear, but chapters 31-38 excise
// taxes accrue and are returned on a CALENDAR-QUARTER basis (section 6071(a)
// context, owned by `us.irc.returns`), not an annual one. Core has no
// quarterly-keyed liability shape (see CONTRACT.md "Period" vs "TaxableYear"
// note) and this package cannot add one unilaterally. This package therefore
// stops at `liable_for_excise(p, e, amount)` — a per-EVENT liability, which
// is what the statute itself imposes ("there is hereby imposed on the sale
// ... a tax") — and records a `pending_core_extension` dependency (see
// `excise-goods.deps.json`) for a quarterly aggregation bridge into
// `us.irc.core::liability`, rather than inventing a local lookalike of
// `TaxableYear` for quarters.

type Person = us.irc.core::Person;
type Organ = us.irc.core::Organ;
type TaxKind = us.irc.core::TaxKind;

const Secretary: Organ = us.irc.core::Secretary;

// Top type for every taxable event this package models. Never asserted
// directly by a case — always through a family subtype below.
pub entity ExciseEvent;

// The tax the statute imposes on this EVENT, before liability is assigned to
// a person (some events, e.g. a coal sale, have exactly one liable person by
// construction; others, e.g. tire retail delivery under section 4071(b), can
// shift the liable person without changing the amount due).
pub relation excise_tax_due(e: ExciseEvent, amount: Money) kind institutional {
    label en unofficial "the excise tax this package's rules compute for this taxable event, before assigning the liable person";
}

// The institutional effect PLAN §6.2 item 1 asks for: which person owes the
// tax on this event, and how much.
pub relation liable_for_excise(p: Person, e: ExciseEvent, amount: Money) kind institutional {
    label en unofficial "p is liable for `amount` of excise tax on account of event e (PLAN §6.2 liability-arises effect)";
}

// A tax-free sale (section 4221 and its family-specific counterparts,
// section 4053, section 4082) is not zero tax computed and forgiven — it is
// a CLASSIFICATION that the taxing rule below must check before it fires at
// all ("no tax shall be imposed ... but only if such ... use is to occur
// before any other use"). Declared once here; every family's taxing rule
// carries `and not tax_free_sale(e)` in its `when` clause via `unless`.
pub relation tax_free_sale(e: ExciseEvent) kind institutional {
    label en unofficial "this event qualifies as a tax-free sale under section 4221 (or a family-specific tax-free-sale provision) and so bears no excise tax under this chapter";
}
