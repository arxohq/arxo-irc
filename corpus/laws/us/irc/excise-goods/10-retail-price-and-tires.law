// Stage 2: section 4051(d) (tire credit), section 4052 (definitions and
// special rules of the retail tax), section 4053 (exemptions), section 4072
// (tire definitions), section 4073 (tires for the Department of Defense and
// the Coast Guard). Builds on the stage-1 shapes of 02-vehicles-tires.law.

// =====================================================================
// Section 4051(d) — credit for the section 4071 tax on tires sold with an article
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4051_D,
    IRC_S4052_A,
    IRC_S4052_B,
    IRC_S4052_C,
    IRC_S4052_E,
    IRC_S4052_F,
    IRC_S4052_G,
    IRC_S4053,
    IRC_S4072_A,
    IRC_S4072_D,
    IRC_S4072_E,
    IRC_S4073,
    Organ,
    Person,
    RetailTruckArticleKind,
    RetailTruckSaleEvent,
    Secretary,
    TireKind,
    TireSaleEvent,
    excise_tax_due,
    retail_truck_sale,
    tax_free_sale,
    tire_sale,
};

pub relation tires_sold_with_taxed_article(article_sale: RetailTruckSaleEvent, tires: TireSaleEvent) kind empirical {
    label en official "section 4051(d)(1): tires are sold on or in connection with the sale of the article";
}
pub relation retail_truck_tax_after_tire_credit(article_sale: RetailTruckSaleEvent, net: Money) kind institutional {
    label en official "section 4051(d): the section 4051 tax less the credit equal to the section 4071 tax on the tires sold with the article (never below zero)";
}

@source(IRC_S4051_D, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by this subchapter an amount equal to the tax (if any) imposed by section 4071 on such tires.")
rule RetailTruckTaxNetOfTireCredit(a: RetailTruckSaleEvent, t: TireSaleEvent, due: Money, credit: Money) defeasible {
    when tires_sold_with_taxed_article(a, t) and excise_tax_due(a, due) and excise_tax_due(t, credit) and due >= credit;
    then retail_truck_tax_after_tire_credit(a, due - credit);
}
@source(IRC_S4051_D, relation = formalizes, coverage = exact, quote = "there shall be allowed as a credit against the tax imposed by this subchapter an amount equal to the tax (if any) imposed by section 4071 on such tires.")
rule RetailTruckTaxTireCreditExceedsTax(a: RetailTruckSaleEvent, t: TireSaleEvent, due: Money, credit: Money) defeasible {
    when tires_sold_with_taxed_article(a, t) and excise_tax_due(a, due) and excise_tax_due(t, credit) and due < credit;
    then retail_truck_tax_after_tire_credit(a, 0 USD);
}

// =====================================================================
// Section 4052 — definitions and special rules
// =====================================================================

// --- (a)(1) first retail sale, (e) long-term lease --------------------------

pub relation article_sale_after_production(e: ExciseEvent) kind empirical {
    label en official "section 4052(a)(1): a sale after production, manufacture or importation of the article";
}
pub relation sale_for_resale_or_long_term_lease(e: ExciseEvent) kind empirical {
    label en official "section 4052(a)(1): the sale is for resale or for leasing in a long-term lease";
}
pub relation first_retail_sale(e: ExciseEvent) kind institutional {
    label en official "section 4052(a)(1): the first sale, for a purpose other than for resale or leasing in a long-term lease, after production, manufacture, or importation";
}
pub entity Lease;
pub relation lease_term_years_under_168i3A(lease: Lease, years: Decimal) kind empirical {
    label en official "section 4052(e): the lease term in years, determined under the rules of section 168(i)(3)(A) (the determination is EXTERNAL_DEPENDENCY on section 168, carried here as a fact)";
}
pub relation long_term_lease(lease: Lease) kind institutional {
    label en official "section 4052(e): a lease with a term of 1 year or more";
}

@source(IRC_S4052_A, relation = formalizes, coverage = exact, quote = "The term \"first retail sale\" means the first sale, for a purpose other than for resale or leasing in a long-term lease, after production, manufacture, or importation.")
rule FirstRetailSaleClassification(e: ExciseEvent) strict {
    when article_sale_after_production(e) and not_known(sale_for_resale_or_long_term_lease(e));
    then first_retail_sale(e);
}
@source(IRC_S4052_E, relation = formalizes, coverage = exact, quote = "the term \"long-term lease\" means any lease with a term of 1 year or more.")
rule LongTermLeaseClassification(l: Lease, years: Decimal) strict {
    when lease_term_years_under_168i3A(l, years) and years >= 1.0;
    then long_term_lease(l);
}

// --- (a)(3) use before the first retail sale -------------------------------

external judgment relation secretary_determined_retail_price_of_similar_articles(a: RetailTruckSaleEvent, price: Money) {
    authority Secretary;
    label en official "section 4052(a)(3)(C), (b)(2): the price at which similar articles are sold at retail in the ordinary course of trade, as determined by the Secretary (DECISION-0194: the text commits the determination to the Secretary)";
}
pub relation article_used_before_first_retail_sale(a: RetailTruckSaleEvent, user: Person) kind empirical {
    label en official "section 4052(a)(3)(A): a person uses an article taxable under section 4051 before the first retail sale of it";
}
pub relation article_used_as_material_or_component_of_another_article(a: RetailTruckSaleEvent, user: Person) kind empirical {
    label en official "section 4052(a)(3)(B): the use is as material in the manufacture or production of, or as a component part of, another article to be manufactured or produced by the user";
}
pub relation tax_on_use_before_first_retail_sale(a: RetailTruckSaleEvent, user: Person, amount: Money) kind institutional {
    label en official "section 4052(a)(3): the user is liable for the section 4051 tax as if the article were sold at retail by him, computed on the Secretary-determined retail price of similar articles";
}

@source(IRC_S4052_A, relation = formalizes, coverage = exact, quote = "then such person shall be liable for tax under section 4051 in the same manner as if such article were sold at retail by him.")
rule UseBeforeFirstRetailSaleTax(a: RetailTruckSaleEvent, user: Person, price: Money) defeasible {
    when article_used_before_first_retail_sale(a, user)
        and not_known(article_used_as_material_or_component_of_another_article(a, user))
        and secretary_determined_retail_price_of_similar_articles(a, price);
    then tax_on_use_before_first_retail_sale(a, user, round(price * S4051RetailTaxRatePercent, 2, "HALF_UP"));
}

// --- (b)(1) price ------------------------------------------------------------

pub relation retail_price_inputs(
    e: ExciseEvent,
    invoiced_price_before_trade_in: Money,
    charge_to_place_in_condition_ready_for_use: Money,
    tax_imposed_by_this_subchapter_included: Money,
    separately_stated_state_or_local_retail_sales_tax: Money,
    value_of_used_component_furnished_by_first_user: Money,
) kind empirical {
    label en official "section 4052(b)(1): the components of the price: the price determined without regard to any trade-in, the charge incident to placing the article in condition ready for use, the subchapter tax and separately stated retail sales tax included in the invoice, and the value of a used component furnished by the first user";
}
pub relation retail_tax_base_price(e: ExciseEvent, price: Money) kind institutional {
    label en official "section 4052(b)(1): the price for purposes of the subchapter";
}

@source(IRC_S4052_B, relation = formalizes, coverage = exact, quote = "(A) there shall be included any charge incident to placing the article in condition ready for use,")
rule RetailTaxBasePriceComputation(e: ExciseEvent, base: Money, ready: Money, tax: Money, sales_tax: Money, used: Money) strict {
    label en official "price = invoiced price (no trade-in adjustment, (C)) + ready-for-use charge ((A)) - the subchapter tax ((B)(i)) - separately stated sales tax ((B)(ii)) - furnished used component ((B)(iii))";
    when retail_price_inputs(e, base, ready, tax, sales_tax, used);
    then retail_tax_base_price(e, base + ready - tax - sales_tax - used);
}

// --- (b)(2), (b)(3), (b)(4) constructive prices ------------------------------

external judgment relation presumed_markup_percentage_of_article_type(e: ExciseEvent, percentage: Decimal) {
    authority Secretary;
    label en official "section 4052(b)(3)(B): the average markup percentage of retailers of articles of the type involved, as determined by the Secretary";
}
pub relation lease_price_inputs(e: ExciseEvent, price_sold_to_lessor: Money, lessor_installed_or_leased_parts_cost: Money) kind empirical {
    label en official "section 4052(b)(3)(A)(i): the price at which the article was sold to the lessor and the cost of parts and accessories installed by the lessor (or leased in connection with the lease)";
}
pub relation long_term_lease_treated_as_first_retail_sale(e: ExciseEvent) kind empirical {
    label en official "section 4052(b)(3)(A): a long-term lease of an article which is treated as the first retail sale of it";
}
pub relation long_term_lease_tax_base_price(e: ExciseEvent, price: Money) kind institutional {
    label en official "section 4052(b)(3)(A): the sum of (i) and (ii): price sold to the lessor plus parts cost, plus the presumed markup percentage of that sum";
}
pub relation manufacturer_or_related_person_liable(e: ExciseEvent, price_before_markup: Money) kind empirical {
    label en official "section 4052(b)(4)(A): the manufacturer, producer or importer (or a related person) is liable for tax on the article; the price the tax would be based on before this paragraph";
}
pub relation manufacturer_related_tax_base_price(e: ExciseEvent, price: Money) kind institutional {
    label en official "section 4052(b)(4)(A): the price plus the product of that price and the presumed markup percentage";
}

@source(IRC_S4052_B, relation = formalizes, coverage = exact, quote = "an amount equal to the presumed markup percentage of the sum described in clause (i).")
rule LongTermLeaseTaxBasePrice(e: ExciseEvent, sold: Money, parts: Money, pct: Decimal) defeasible {
    when long_term_lease_treated_as_first_retail_sale(e)
        and lease_price_inputs(e, sold, parts)
        and presumed_markup_percentage_of_article_type(e, pct);
    then long_term_lease_tax_base_price(e, round((sold + parts) * (1.0 + pct), 2, "HALF_UP"));
}
@source(IRC_S4052_B, relation = formalizes, coverage = exact, quote = "(ii) the product of the price referred to in clause (i) and the presumed markup percentage determined under paragraph (3)(B).")
rule ManufacturerRelatedTaxBasePrice(e: ExciseEvent, price: Money, pct: Decimal) defeasible {
    when manufacturer_or_related_person_liable(e, price) and presumed_markup_percentage_of_article_type(e, pct);
    then manufacturer_related_tax_base_price(e, round(price * (1.0 + pct), 2, "HALF_UP"));
}

// --- (c) combinations not treated as manufacture; (f) repairs ---------------

pub relation combines_article_only_with_listed_item(p: Person, article: ExciseEvent) kind empirical {
    label en official "section 4052(c)(1)-(2): the person merely combines the article with a coupling device, wrecker crane, loading and unloading equipment, aerial ladder or tower, snow and ice control equipment, earthmoving, excavation and construction equipment, spreader, sleeper cab, cab shield, or wood or metal floor";
}
pub relation treated_as_manufacturer_by_combination(p: Person, article: ExciseEvent) kind institutional {
    label en official "not treated as engaged in manufacture merely by combining with a listed item (negative derived by rule below; subsection (a)(3)(B) is not covered by the carve-out)";
}
pub relation not_treated_as_manufacturer_by_combination(p: Person, article: ExciseEvent) kind institutional {
    label en official "section 4052(c)(1): the person is not treated as engaged in the manufacture of the article by reason of merely combining it with a listed item";
}
pub relation article_repaired_or_modified(a: ExciseEvent) kind empirical {
    label en official "section 4052(f)(1): an article described in section 4051(a)(1) is repaired or modified (including a modification which changes the transportation function of the article or increases its load-carrying capacity)";
}
pub relation article_as_modified_would_be_taxable_if_new_but_was_not_when_new(a: ExciseEvent) kind empirical {
    label en official "section 4052(f)(2): the article as repaired or modified would, if new, be taxable under section 4051 and the article when new was not taxable under that section or the corresponding provision of prior law";
}
pub relation article_treated_as_manufactured_by_repair(a: ExciseEvent) kind institutional {
    label en official "section 4052(f): the article is treated as manufactured or produced by reason of the repairs or modifications";
}

@source(IRC_S4052_C, relation = formalizes, coverage = exact, quote = "a person shall not be treated as engaged in the manufacture of any article by reason of merely combining such article with any item listed in paragraph (2).")
rule MerelyCombiningIsNotManufacture(p: Person, a: ExciseEvent) strict {
    when combines_article_only_with_listed_item(p, a);
    then not_treated_as_manufacturer_by_combination(p, a);
}
@source(IRC_S4052_F, relation = formalizes, coverage = exact, quote = "Paragraph (1) shall not apply if the article (as repaired or modified) would, if new, be taxable under section 4051")
rule RepairTreatedAsManufactureWhenNewlyTaxable(a: ExciseEvent) strict {
    when article_repaired_or_modified(a) and article_as_modified_would_be_taxable_if_new_but_was_not_when_new(a);
    then article_treated_as_manufactured_by_repair(a);
}

// --- (g) duty of the Secretary: certification statement regulations ----------

pub relation secretary_prescribed_resale_statement_regulations(x: Organ) kind institutional {
    label en official "section 4052(g): regulations are prescribed that permit, in lieu of any other certification, a statement made under penalties of perjury by persons purchasing taxable articles for resale or leasing in a long-term lease";
}
@source(IRC_S4052_G, relation = formalizes, coverage = partial, quote = "The Secretary shall prescribe regulations which permit")
rule SecretaryResaleStatementRegulationsDuty strict {
    label en official "section 4052(g): the Secretary shall prescribe regulations which permit a purchaser-for-resale statement in lieu of any other certification";
    when true;
    then duty Section4052gRegulationsDuty {
        bearer Secretary;
        goal achievement {
            condition secretary_prescribed_resale_statement_regulations(Secretary);
            window [-infinity, infinity];
        }
    };
}

// =====================================================================
// Section 4053 — exemptions from the retail tax
// =====================================================================

pub enum Section4053Exemption {
    LivingQuartersOrCamping;
    FarmSeedFeedFertilizerBody;
    HouseTrailer;
    AmbulanceOrHearse;
    ConcreteProcessingEquipment;
    TrashContainer;
    RoadRailTrailerChassisOrBody;
    MachineryCarriageChassis;
    IdlingReductionDevice;
    HighRValueInsulation;
}

pub relation designed_to_be_mounted_on_truck_or_automobile_chassis(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(1)(A), (5)(A): the article is designed to be mounted or placed on an automobile truck, truck chassis, or automobile chassis (for (5): a truck chassis or truck trailer or semitrailer chassis)";
}
pub relation designed_primarily_as_living_quarters_or_camping(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(1)(B): designed to be used primarily as living quarters or camping accommodations";
}
pub relation body_designed_primarily_for_farm_seed_feed_fertilizer(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(2)(A)-(E): body primarily designed to process, haul, spread or load or unload feed, seed, or fertilizer on farms, or a combination";
}
pub relation article_is_house_trailer(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(3): a house trailer";
}
pub relation article_is_ambulance_or_hearse(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(4): an ambulance, hearse, or combination ambulance-hearse";
}
pub relation designed_to_process_or_prepare_concrete(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(5)(B): designed to be used to process or prepare concrete";
}
pub relation designed_as_trash_container_not_for_other_freight(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(6)(A): designed to be used as a trash container and not designed for transportation of freight other than trash";
}
pub relation not_designed_to_be_permanently_mounted_or_affixed(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(6)(B): not designed to be permanently mounted on or permanently affixed to an automobile truck chassis or body";
}
pub relation designed_for_both_highway_and_railroad_car_use(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(7): a chassis or body of a trailer or semitrailer designed for use both as a highway vehicle and a railroad car (a piggy-back trailer is not so treated)";
}
pub relation chassis_with_permanently_mounted_machinery(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(8)(A): machinery or equipment to perform a construction, manufacturing, processing, farming, mining, drilling, timbering, or similar operation is permanently mounted on the chassis";
}
pub relation chassis_specially_designed_only_as_mobile_carriage_and_mount(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(8)(B): the chassis is specially designed to serve only as a mobile carriage and mount (and power source) for that machinery or equipment";
}
pub relation chassis_could_not_be_used_for_other_load_without_substantial_modification(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(8)(C): by reason of the special design the chassis could not, without substantial structural modification, transport any load other than that machinery";
}
pub relation device_designed_to_provide_services_without_main_engine(e: RetailTruckSaleEvent) kind empirical {
    label en official "section 4053(9)(A): a device or system designed to provide services (heat, air conditioning, electricity) that would otherwise require operation of the main drive engine while the vehicle is temporarily parked";
}
external judgment relation epa_administrator_determines_idling_reduction(e: RetailTruckSaleEvent) {
    authority EpaAdministrator;
    label en official "section 4053(9)(B): the Administrator of the Environmental Protection Agency, in consultation with the Secretary of Energy and the Secretary of Transportation, determines that the device reduces idling of the vehicle at a motor vehicle rest stop or other location";
}
pub relation insulation_r_value_per_inch(e: RetailTruckSaleEvent, r_value: Decimal) kind empirical {
    label en official "section 4053(10): the R value per inch of the insulation";
}
pub relation article_exempt_from_4051_under_4053(e: RetailTruckSaleEvent, ground: Section4053Exemption) kind institutional {
    label en official "section 4053: no tax shall be imposed by section 4051 on the article, for the named ground";
}

const EpaAdministrator: Organ = entity_ref("urn:us:irc:excise_goods:clir#EpaAdministrator") {
    label en official "Administrator of the Environmental Protection Agency";
}

@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "(B) to be used primarily as living quarters or camping accommodations.")
rule Exempt4053Living(e: RetailTruckSaleEvent) strict {
    when designed_to_be_mounted_on_truck_or_automobile_chassis(e) and designed_primarily_as_living_quarters_or_camping(e);
    then article_exempt_from_4051_under_4053(e, LivingQuartersOrCamping);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "(E) for any combination of the foregoing.")
rule Exempt4053Farm(e: RetailTruckSaleEvent) strict {
    when body_designed_primarily_for_farm_seed_feed_fertilizer(e);
    then article_exempt_from_4051_under_4053(e, FarmSeedFeedFertilizerBody);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "Any house trailer.")
rule Exempt4053HouseTrailer(e: RetailTruckSaleEvent) strict {
    when article_is_house_trailer(e);
    then article_exempt_from_4051_under_4053(e, HouseTrailer);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "Any ambulance, hearse, or combination ambulance-hearse.")
rule Exempt4053AmbulanceHearse(e: RetailTruckSaleEvent) strict {
    when article_is_ambulance_or_hearse(e);
    then article_exempt_from_4051_under_4053(e, AmbulanceOrHearse);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "(B) to be used to process or prepare concrete.")
rule Exempt4053Concrete(e: RetailTruckSaleEvent) strict {
    when designed_to_be_mounted_on_truck_or_automobile_chassis(e) and designed_to_process_or_prepare_concrete(e);
    then article_exempt_from_4051_under_4053(e, ConcreteProcessingEquipment);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "(B) which is not designed to be permanently mounted on or permanently affixed to an automobile truck chassis or body.")
rule Exempt4053Trash(e: RetailTruckSaleEvent) strict {
    when designed_as_trash_container_not_for_other_freight(e) and not_designed_to_be_permanently_mounted_or_affixed(e);
    then article_exempt_from_4051_under_4053(e, TrashContainer);
}
@source(IRC_S4053, relation = formalizes, coverage = partial, quote = "Any chassis or body of a trailer or semitrailer which is designed for use both as a highway vehicle and a railroad car.")
rule Exempt4053RoadRail(e: RetailTruckSaleEvent) strict {
    when designed_for_both_highway_and_railroad_car_use(e);
    then article_exempt_from_4051_under_4053(e, RoadRailTrailerChassisOrBody);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "Any vehicle which consists of a chassis—")
rule Exempt4053MachineryCarriage(e: RetailTruckSaleEvent) strict {
    when chassis_with_permanently_mounted_machinery(e)
        and chassis_specially_designed_only_as_mobile_carriage_and_mount(e)
        and chassis_could_not_be_used_for_other_load_without_substantial_modification(e);
    then article_exempt_from_4051_under_4053(e, MachineryCarriageChassis);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "Any device or system of devices which—")
rule Exempt4053IdlingReduction(e: RetailTruckSaleEvent) strict {
    when device_designed_to_provide_services_without_main_engine(e) and epa_administrator_determines_idling_reduction(e);
    then article_exempt_from_4051_under_4053(e, IdlingReductionDevice);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "Any insulation that has an R value of not less than R35 per inch.")
rule Exempt4053Insulation(e: RetailTruckSaleEvent, r: Decimal) strict {
    when insulation_r_value_per_inch(e, r) and r >= 35.0;
    then article_exempt_from_4051_under_4053(e, HighRValueInsulation);
}
@source(IRC_S4053, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by section 4051 on any of the following articles:")
rule Exempt4053NoTax(e: RetailTruckSaleEvent, ground: Section4053Exemption) strict {
    when retail_truck_sale(e, _, _, _, _) and article_exempt_from_4051_under_4053(e, ground);
    then tax_free_sale(e);
}

// =====================================================================
// Sections 4072 and 4073 — tire definitions and exemption
// =====================================================================

pub relation tire_made_wholly_or_partly_of_rubber(e: TireSaleEvent) kind empirical {
    label en official "section 4072(a)-(b): the tire is wholly or in part made of rubber (including synthetic and substitute rubber)";
}
pub relation tire_of_type_used_on_highway_vehicles(e: TireSaleEvent) kind empirical {
    label en official "section 4072(c): a tire of the type used on motor vehicles which are highway vehicles, or on vehicles of the type used in connection with such motor vehicles";
}
pub relation tire_marked_for_highway_use_under_federal_regulations(e: TireSaleEvent) kind empirical {
    label en official "section 4072(a): the tire is marked pursuant to Federal regulations for highway use";
}
pub relation tire_of_type_used_exclusively_on_vehicles_of_section_4053_8(e: TireSaleEvent) kind empirical {
    label en official "section 4072(c), last sentence: tires of a type used exclusively on vehicles described in section 4053(8)";
}
pub relation taxable_tire(e: TireSaleEvent) kind institutional {
    label en official "section 4072(a): a taxable tire";
}
pub relation tire_ply_cords_angle_substantially_less_than_90_degrees_alternating(e: TireSaleEvent) kind empirical {
    label en official "section 4072(d): a pneumatic tire on which the ply cords that extend to the beads are laid at alternate angles substantially less than 90 degrees to the centerline of the tread";
}
pub relation biasply_tire(e: TireSaleEvent) kind institutional {
    label en official "section 4072(d): a biasply tire";
}
pub relation tire_cross_section_width_inches(e: TireSaleEvent, width: Decimal) kind empirical {
    label en official "section 4072(e): the cross section width of a single tire in inches";
}
pub relation tire_designed_to_replace_two_in_dual_fitment(e: TireSaleEvent) kind empirical {
    label en official "section 4072(e): designed to replace 2 tires in a dual fitment";
}
pub relation tire_designed_for_steering(e: TireSaleEvent) kind empirical {
    label en official "section 4072(e): the tire is designed for steering (such a tire is never a super single tire)";
}
pub relation super_single_tire(e: TireSaleEvent) kind institutional {
    label en official "section 4072(e): a single tire greater than 13 inches in cross section width designed to replace 2 tires in a dual fitment, excluding any tire designed for steering";
}
pub relation tire_sold_for_exclusive_use_of_dod_or_coast_guard(e: TireSaleEvent) kind empirical {
    label en official "section 4073: the tire is sold for the exclusive use of the Department of Defense or the Coast Guard";
}

@source(IRC_S4072_A, relation = formalizes, coverage = exact, quote = "the term \"taxable tire\" means any tire of the type used on highway vehicles if wholly or in part made of rubber and if marked pursuant to Federal regulations for highway use.")
rule TaxableTireClassification(e: TireSaleEvent) strict {
    when tire_made_wholly_or_partly_of_rubber(e)
        and tire_of_type_used_on_highway_vehicles(e)
        and tire_marked_for_highway_use_under_federal_regulations(e)
        and not_known(tire_of_type_used_exclusively_on_vehicles_of_section_4053_8(e));
    then taxable_tire(e);
}
@source(IRC_S4072_D, relation = formalizes, coverage = exact, quote = "the term \"biasply tire\" means a pneumatic tire on which the ply cords that extend to the beads are laid at alternate angles substantially less than 90 degrees to the centerline of the tread.")
rule BiasplyTireClassification(e: TireSaleEvent) strict {
    when tire_ply_cords_angle_substantially_less_than_90_degrees_alternating(e);
    then biasply_tire(e);
}
@source(IRC_S4072_E, relation = formalizes, coverage = exact, quote = "the term \"super single tire\" means a single tire greater than 13 inches in cross section width designed to replace 2 tires in a dual fitment.")
rule SuperSingleTireClassification(e: TireSaleEvent, width: Decimal) strict {
    when tire_cross_section_width_inches(e, width) and width > 13.0 and tire_designed_to_replace_two_in_dual_fitment(e) and not_known(tire_designed_for_steering(e));
    then super_single_tire(e);
}
@source(IRC_S4073, relation = formalizes, coverage = exact, quote = "The tax imposed by section 4071 shall not apply to tires sold for the exclusive use of the Department of Defense or the Coast Guard.")
rule TireDefenseOrCoastGuardExempt(e: TireSaleEvent) strict {
    when tire_sale(e, _, _, _) and tire_sold_for_exclusive_use_of_dod_or_coast_guard(e);
    then tax_free_sale(e);
}

// --- section 4052(b)(2): sale below the fair market price otherwise than at arm's length ---
pub relation sold_otherwise_than_at_arms_length_below_fair_market_price(a: RetailTruckSaleEvent) kind empirical {
    label en official "section 4052(b)(2): the article is sold (otherwise than through an arm's-length transaction) at less than the fair market price";
}
@source(IRC_S4052_B, relation = formalizes, coverage = exact, quote = "In the case of any article sold (otherwise than through an arm's-length transaction) at less than the fair market price")
rule BelowFairMarketPriceTaxedOnSecretaryPrice(a: RetailTruckSaleEvent, price: Money) strict {
    when sold_otherwise_than_at_arms_length_below_fair_market_price(a) and secretary_determined_retail_price_of_similar_articles(a, price);
    then retail_tax_base_price(a, price);
}
