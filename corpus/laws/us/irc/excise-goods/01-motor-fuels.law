// Chapter 31, subchapter A: sections 4041(a) (special fuels/diesel) and 4081
// (a)-(d) (gasoline/diesel/kerosene manufacturers tax). Priority list, IRC-13
// stage 1. Rates are `.lawparam.json` A3 datasets beside this file; the
// section 4081(d) 2028-10-01 boundary and the section 4041(a)(1)(C)(ii)
// train-rate windows are windowed VALUES (not `revision` pairs) per
// AGENT-BRIEF's "Amendments" guidance — JUDGMENT CALL: a plain rate change on
// a fixed calendar date reads more directly as an A3 value transition than as
// a base/amended rule pair, and this package's task explicitly names only the
// 2028 boundary as in scope (earlier historical windows, e.g. the 1996-1997
// aviation-rate blip, are left unreviewed/stage 2 — not needed by any
// scenario in the pinned 2024-2028 edition window).

// =====================================================================
// Section 4081 — tax on removal, entry, or sale of taxable fuel
// =====================================================================

use self::{
    ExciseEvent,
    IRC_S4041_A,
    IRC_S4081_A,
    IRC_S4081_B,
    Person,
    excise_tax_due,
    kerosene_aircraft_lust_increase_zeroed_by_4082e2,
    kerosene_aircraft_rate_zeroed_by_4082e,
    liable_for_excise,
    tax_free_sale,
};

pub enum TaxableFuelKind {
    GasolineOtherThanAviation;
    AviationGasoline;
    DieselOrKerosene;
}

pub enum TaxableFuelTrigger {
    RemovalFromRefinery;
    RemovalFromTerminal;
    EntryForConsumptionUseOrWarehousing;
    SaleToUnregisteredPerson;
    RemovalOrSaleByBlender;
}

pub entity TaxableFuelEvent : ExciseEvent;

pub relation taxable_fuel_event(
    e: TaxableFuelEvent,
    kind: TaxableFuelKind,
    trigger: TaxableFuelTrigger,
    gallons: Decimal,
    on: Date,
    responsible: Person,
) kind empirical {
    label en unofficial "a removal, entry, or sale of taxable fuel (gasoline, diesel, or kerosene) asserted by the case, with the triggering event and the person the statute looks to (remover, enterer, seller, or blender)";
}

// section 4081(a)(1)(A)(iv) reads on a PRIOR taxable removal/entry; case
// asserts it directly rather than this package tracing the fuel's history.
pub relation prior_taxable_removal_or_entry(e: TaxableFuelEvent) kind empirical {
    label en unofficial "there was a prior taxable removal or entry of this fuel under section 4081(a)(1)(A)(i)-(iii), so a later sale to an unregistered person under (a)(1)(A)(iv) is not separately taxed";
}

// section 4081(a)(1)(B): bulk transfer to a registered terminal or refinery.
pub relation bulk_transfer_between_registered_parties(e: TaxableFuelEvent) kind empirical {
    label en unofficial "section 4081(a)(1)(B): the fuel was transferred in bulk by pipeline or vessel to a terminal or refinery, and the remover/enterer, the pipeline or vessel operator, and the terminal/refinery operator are all registered under section 4101";
}

// section 4081(a)(2)(D): diesel-water fuel emulsion, substituted rate.
pub relation diesel_water_fuel_emulsion(e: TaxableFuelEvent) kind empirical {
    label en unofficial "section 4081(a)(2)(D): the fuel is a diesel-water fuel emulsion at least 14% water with an EPA-registered emulsion additive, and the person removing, selling, or using it is registered under section 4101";
}

// section 4081(a)(2)(C): kerosene removed directly into an aircraft fuel tank.
pub relation kerosene_into_aircraft_fuel_tank_for_commercial_aviation(e: TaxableFuelEvent) kind empirical {
    label en unofficial "section 4081(a)(2)(C)(i): kerosene removed from a refinery or terminal directly into the fuel tank of an aircraft, for use in commercial aviation by a person registered for such use under section 4101";
}
pub relation kerosene_into_aircraft_fuel_tank_for_other_aviation(e: TaxableFuelEvent) kind empirical {
    label en unofficial "section 4081(a)(2)(C)(ii): kerosene removed directly into an aircraft fuel tank for use in aviation not described in clause (i)";
}

pub relation taxable_fuel_rate(e: TaxableFuelEvent, rate: Money) kind institutional {
    label en official "the section 4081(a)(2) rate per gallon applicable to this taxable fuel event, before the Leaking Underground Storage Tank Trust Fund financing rate add-on";
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "in the case of gasoline other than aviation gasoline, 18.3 cents per gallon")
rule GasolineRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, GasolineOtherThanAviation, _, _, _, _) and not_known(diesel_water_fuel_emulsion(e));
    then taxable_fuel_rate(e, GasolineRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "in the case of aviation gasoline, 19.3 cents per gallon")
rule AviationGasolineRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, AviationGasoline, _, _, _, _);
    then taxable_fuel_rate(e, AviationGasolineRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "in the case of diesel fuel or kerosene, 24.3 cents per gallon")
rule DieselKeroseneRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _)
        and not_known(diesel_water_fuel_emulsion(e))
        and not_known(kerosene_into_aircraft_fuel_tank_for_commercial_aviation(e))
        and not_known(kerosene_into_aircraft_fuel_tank_for_other_aviation(e));
    then taxable_fuel_rate(e, DieselKeroseneRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "subparagraph (A)(iii) shall be applied by substituting \"19.7 cents\" for \"24.3 cents\"")
rule DieselWaterEmulsionRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _) and diesel_water_fuel_emulsion(e);
    then taxable_fuel_rate(e, DieselWaterEmulsionRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "in the case of use for commercial aviation by a person registered for such use under section 4101, 4.3 cents per gallon")
rule AviationKeroseneCommercialRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _) and kerosene_into_aircraft_fuel_tank_for_commercial_aviation(e) and not_known(kerosene_aircraft_rate_zeroed_by_4082e(e));
    then taxable_fuel_rate(e, AviationKeroseneCommercialRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "in the case of use for aviation not described in clause (i), 21.8 cents per gallon")
rule AviationKeroseneOtherRate(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, DieselOrKerosene, _, _, _, _) and kerosene_into_aircraft_fuel_tank_for_other_aviation(e) and not_known(kerosene_aircraft_rate_zeroed_by_4082e(e));
    then taxable_fuel_rate(e, AviationKeroseneOtherRatePerGallon);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "The rates of tax specified in subparagraph (A) shall each be increased by 0.1 cent per gallon.")
rule TaxableFuelTaxWithLust(e: TaxableFuelEvent, gallons: Decimal, rate: Money, on: Date) strict {
    when taxable_fuel_event(e, _, _, gallons, on, _)
        and taxable_fuel_rate(e, rate)
        and on >= @1997-10-01 and on < @2028-10-01
        and not_known(kerosene_aircraft_lust_increase_zeroed_by_4082e2(e));
    then excise_tax_due(e, round((rate + LustFinancingRatePerGallon) * gallons, 2, "HALF_UP"));
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax at the rate specified in paragraph (2) on")
rule TaxableFuelTaxWithoutLust(e: TaxableFuelEvent, gallons: Decimal, rate: Money, on: Date) strict {
    when taxable_fuel_event(e, _, _, gallons, on, _)
        and taxable_fuel_rate(e, rate)
        and (on < @1997-10-01 or on >= @2028-10-01);
    then excise_tax_due(e, round(rate * gallons, 2, "HALF_UP"));
}

// section 4081(a)(1)(B): bulk transfer exemption; section 4081(a)(1)(A)(iv):
// no separate tax on a sale to an unregistered person if there was already a
// prior taxable removal/entry.
@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "The tax imposed by this paragraph shall not apply to any removal or entry of a taxable fuel transferred in bulk by pipeline or vessel to a terminal or refinery if the person removing or entering the taxable fuel, the operator of such pipeline or vessel (except as provided in clause (ii)), and the operator of such terminal or refinery are registered under section 4101.")
rule NoTaxOnRegisteredBulkTransfer(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, _, RemovalFromRefinery, _, _, _) and bulk_transfer_between_registered_parties(e);
    then tax_free_sale(e);
}
rule NoTaxOnRegisteredBulkTransferTerminal(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, _, RemovalFromTerminal, _, _, _) and bulk_transfer_between_registered_parties(e);
    then tax_free_sale(e);
}
@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "the sale of a taxable fuel to any person who is not registered under section 4101 unless there was a prior taxable removal or entry of such fuel")
rule NoTaxOnSaleAfterPriorTaxableEvent(e: TaxableFuelEvent) strict {
    when taxable_fuel_event(e, _, SaleToUnregisteredPerson, _, _, _) and prior_taxable_removal_or_entry(e);
    then tax_free_sale(e);
}

@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax at the rate specified in paragraph (2) on")
rule TaxableFuelLiability(e: TaxableFuelEvent, responsible: Person, amount: Money, trigger: TaxableFuelTrigger) defeasible {
    when taxable_fuel_event(e, _, trigger, _, _, responsible)
        and (trigger == RemovalFromRefinery or trigger == RemovalFromTerminal or trigger == EntryForConsumptionUseOrWarehousing or trigger == SaleToUnregisteredPerson)
        and excise_tax_due(e, amount)
        and not_known(tax_free_sale(e))
        and not_known(kerosene_into_aircraft_fuel_tank_for_commercial_aviation(e));
    then liable_for_excise(responsible, e, amount);
}

// section 4081(a)(4): liability for kerosene used in commercial aviation
// falls on the USER, not the remover; overrides the general rule above for
// this one trigger.
pub relation commercial_aviation_kerosene_user(e: TaxableFuelEvent, user: Person) kind empirical {
    label en unofficial "section 4081(a)(4): the person who uses kerosene for commercial aviation, for a fuel tank treated as removed at the section 4081(a)(2)(C)(i) rate";
}
@source(IRC_S4081_A, relation = formalizes, coverage = exact, quote = "the person who uses the fuel for commercial aviation shall pay the tax imposed under such paragraph")
rule CommercialAviationKeroseneUserLiability(e: TaxableFuelEvent, user: Person, amount: Money) defeasible {
    when kerosene_into_aircraft_fuel_tank_for_commercial_aviation(e)
        and commercial_aviation_kerosene_user(e, user)
        and excise_tax_due(e, amount)
        and not_known(tax_free_sale(e));
    then liable_for_excise(user, e, amount);
}

// --- section 4081(b): removal or sale by a blender --------------------------

pub relation blender_prior_tax_paid(e: TaxableFuelEvent, amount: Money) kind empirical {
    label en unofficial "section 4081(b)(2): the amount of tax the blender establishes was previously paid on this fuel by reason of subsection (a)";
}

@source(IRC_S4081_B, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax at the rate determined under subsection (a) on taxable fuel removed or sold by the blender thereof.")
rule BlenderTaxBeforeCredit(e: TaxableFuelEvent, gallons: Decimal, rate: Money) strict {
    when taxable_fuel_event(e, _, RemovalOrSaleByBlender, gallons, _, _) and taxable_fuel_rate(e, rate);
    then excise_tax_due(e, round(rate * gallons, 2, "HALF_UP"));
}

@source(IRC_S4081_B, relation = formalizes, coverage = exact, quote = "the amount of the tax so paid shall be allowed as a credit against the tax imposed by reason of paragraph (1)")
rule BlenderLiabilityAfterCredit(e: TaxableFuelEvent, responsible: Person, due: Money, prior: Money) defeasible {
    when taxable_fuel_event(e, _, RemovalOrSaleByBlender, _, _, responsible)
        and excise_tax_due(e, due)
        and blender_prior_tax_paid(e, prior)
        and due > prior;
    then liable_for_excise(responsible, e, due - prior);
}

// =====================================================================
// Section 4041(a) — diesel fuel, special motor fuels, and alternative fuels
// =====================================================================

pub enum SpecialMotorFuelUse {
    SoldToOperatorForFuelUse;
    UsedAsFuelWithoutTaxableSale;
}

pub enum SpecialMotorFuelVehicleKind {
    DieselPoweredHighwayVehicleOrTrain;
    OtherMotorVehicleOrMotorboat;
    QualifiedBus;
}

pub entity SpecialMotorFuelEvent : ExciseEvent;

pub relation special_motor_fuel_event(
    e: SpecialMotorFuelEvent,
    use: SpecialMotorFuelUse,
    vehicle: SpecialMotorFuelVehicleKind,
    gallons: Decimal,
    on: Date,
    responsible: Person,
) kind empirical {
    label en unofficial "a sale or use of a non-gasoline liquid as fuel in a diesel-powered highway vehicle or train (section 4041(a)(1)), asserted by the case";
}

pub relation fuel_train(e: SpecialMotorFuelEvent) kind empirical {
    label en unofficial "the fuel is sold for use, or used, in a train (section 4041(a)(1)(C)(ii))";
}
pub relation fuel_previously_taxed_under_4081(e: SpecialMotorFuelEvent) kind empirical {
    label en unofficial "section 4041(a)(1)(B): tax was imposed on this liquid under section 4081 (other than the LUST rate) and not credited or refunded";
}
pub relation fuel_school_bus_or_intracity_transportation(e: SpecialMotorFuelEvent) kind empirical {
    label en unofficial "section 4041(a)(1)(C)(iii)(II): use described in subparagraph (B) or (C) of section 6427(b)(2) (school bus and intracity transportation)";
}

@source(IRC_S4041_A, relation = formalizes, coverage = partial, quote = "No tax shall be imposed by this paragraph on the sale or use of any liquid if tax was imposed on such liquid under section 4081 (other than such tax at the Leaking Underground Storage Tank Trust Fund financing rate) and the tax thereon was not credited or refunded.")
rule NoTaxOnPreviouslyTaxedFuel(e: SpecialMotorFuelEvent) strict {
    when special_motor_fuel_event(e, _, DieselPoweredHighwayVehicleOrTrain, _, _, _) and fuel_previously_taxed_under_4081(e);
    then tax_free_sale(e);
}

@source(IRC_S4041_A, relation = formalizes, coverage = partial, quote = "No tax shall be imposed by this paragraph on any sale for use, or use, described in subparagraph (B) or (C) of section 6427(b)(2) (relating to school bus and intracity transportation).")
rule NoTaxOnSchoolOrIntracityBus(e: SpecialMotorFuelEvent) strict {
    when special_motor_fuel_event(e, _, QualifiedBus, _, _, _) and fuel_school_bus_or_intracity_transportation(e);
    then tax_free_sale(e);
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "the rate of the tax imposed by this paragraph shall be the rate of tax specified in section 4081(a)(2)(A) on diesel fuel which is in effect at the time of such sale or use")
rule SpecialFuelDieselRate(e: SpecialMotorFuelEvent, gallons: Decimal, on: Date) strict {
    when special_motor_fuel_event(e, _, DieselPoweredHighwayVehicleOrTrain, gallons, on, _) and not_known(fuel_train(e));
    then excise_tax_due(e, round(DieselKeroseneRatePerGallon * gallons, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "In the case of any sale for use, or use, of diesel fuel in a train, the rate of tax imposed by this paragraph shall be")
rule SpecialFuelTrainRate(e: SpecialMotorFuelEvent, gallons: Decimal, on: Date) strict {
    when special_motor_fuel_event(e, _, DieselPoweredHighwayVehicleOrTrain, gallons, on, _) and fuel_train(e);
    then excise_tax_due(e, round(S4041TrainRatePerGallon * gallons, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "the rate of tax imposed by this paragraph shall be 7.3 cents per gallon (4.3 cents per gallon after September 30, 2028)")
rule SpecialFuelBusRate(e: SpecialMotorFuelEvent, gallons: Decimal, on: Date) strict {
    when special_motor_fuel_event(e, _, QualifiedBus, gallons, on, _) and not_known(fuel_school_bus_or_intracity_transportation(e));
    then excise_tax_due(e, round(S4041BusRatePerGallon * gallons, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "There is hereby imposed a tax on any liquid other than gasoline (as defined in section 4083)")
rule SpecialMotorFuelLiability(e: SpecialMotorFuelEvent, responsible: Person, amount: Money) defeasible {
    when special_motor_fuel_event(e, _, _, _, _, responsible) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(responsible, e, amount);
}

// --- section 4041(a)(2)/(3): alternative fuels and compressed natural gas ---

pub enum AlternativeFuelKind {
    LiquefiedPetroleumGas;
    LiquefiedNaturalGas;
    CoalOrBiomassDerivedLiquidFuel;
    CompressedNaturalGas;
    OtherAlternativeLiquidFuel;
}

pub entity AlternativeFuelEvent : ExciseEvent;

// JUDGMENT CALL / TECH_GAP (report this): quantity is asserted directly in
// "energy equivalent gallons" (the unit section 4041(a)(2)(C)/(D) and
// (a)(3)(D) define). The BTU/pound-to-gallon-equivalent CONVERSION itself
// (e.g. "5.75 pounds of liquefied petroleum gas" per equivalent gallon) is
// not computed by this package from a pounds quantity — see coverage note on
// section 4041(a)(2)(C)/(D) and (a)(3)(D) (classified TECH_GAP, minimal
// reproduction: assert a pounds quantity and expect a computed
// energy-equivalent-gallon count).
pub relation alternative_fuel_event(
    e: AlternativeFuelEvent,
    kind: AlternativeFuelKind,
    energy_equivalent_gallons: Decimal,
    on: Date,
    responsible: Person,
) kind empirical {
    label en unofficial "a sale or use of an alternative fuel (section 4041(a)(2)) or compressed natural gas (section 4041(a)(3)) as fuel in a motor vehicle or motorboat, quantity already expressed in energy-equivalent gallons";
}

pub relation alternative_fuel_bus_use(e: AlternativeFuelEvent) kind empirical {
    label en unofficial "section 4041(a)(3)(B): use described in subparagraph (B) or (C) of section 6427(b)(2) (school bus and intracity transportation)";
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "in the case of liquefied petroleum gas, 18.3 cents per energy equivalent of a gallon of gasoline")
rule LpgTax(e: AlternativeFuelEvent, qty: Decimal) strict {
    when alternative_fuel_event(e, LiquefiedPetroleumGas, qty, _, _);
    then excise_tax_due(e, round(S4041LpgRatePerEnergyEquivalentGallon * qty, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "in the case of any liquid fuel (other than ethanol and methanol) derived from coal (including peat) and liquid hydrocarbons derived from biomass (as defined in section 45K(c)(3)), 24.3 cents per gallon")
rule CoalOrBiomassLiquidFuelTax(e: AlternativeFuelEvent, qty: Decimal) strict {
    when alternative_fuel_event(e, CoalOrBiomassDerivedLiquidFuel, qty, _, _);
    then excise_tax_due(e, round(S4041CoalOrBiomassLiquidFuelRatePerGallon * qty, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "in the case of liquefied natural gas, 24.3 cents per energy equivalent of a gallon of diesel")
rule LngTax(e: AlternativeFuelEvent, qty: Decimal) strict {
    when alternative_fuel_event(e, LiquefiedNaturalGas, qty, _, _);
    then excise_tax_due(e, round(S4041LngRatePerEnergyEquivalentGallonOfDiesel * qty, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "The rate of the tax imposed by this paragraph shall be 18.3 cents per energy equivalent of a gallon of gasoline.")
rule CngTax(e: AlternativeFuelEvent, qty: Decimal) strict {
    when alternative_fuel_event(e, CompressedNaturalGas, qty, _, _) and not_known(alternative_fuel_bus_use(e));
    then excise_tax_due(e, round(S4041CngRatePerEnergyEquivalentGallon * qty, 2, "HALF_UP"));
}

@source(IRC_S4041_A, relation = formalizes, coverage = exact, quote = "No tax shall be imposed by this paragraph on any sale for use, or use, described in subparagraph (B) or (C) of section 6427(b)(2) (relating to school bus and intracity transportation).")
rule NoTaxOnCngBusUse(e: AlternativeFuelEvent) strict {
    when alternative_fuel_event(e, CompressedNaturalGas, _, _, _) and alternative_fuel_bus_use(e);
    then tax_free_sale(e);
}

@source(IRC_S4041_A, relation = formalizes, coverage = partial, quote = "There is hereby imposed a tax on any liquid (other than gas oil, fuel oil, or any product taxable under section 4081")
rule AlternativeFuelLiability(e: AlternativeFuelEvent, responsible: Person, amount: Money) defeasible {
    when alternative_fuel_event(e, _, _, _, responsible) and excise_tax_due(e, amount) and not_known(tax_free_sale(e));
    then liable_for_excise(responsible, e, amount);
}
