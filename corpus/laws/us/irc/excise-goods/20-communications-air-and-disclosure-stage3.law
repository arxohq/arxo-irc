// Stage 3 (TECH_GAP reduction): sections 4221(e)(1), 4251(c), (d)(2), 4253(e), 4261(b)(3), 4262(b)-(c),
// 4263(f), 4424(b), 4462(a)(2)(C).
//
// Geography (sections 4262, 4263(f)): the language has no geometry, so distances and coordinates enter as
// NUMERIC case facts (a distance in miles, a longitude and latitude in degrees) and the statutory tests
// (not more than 225 miles, west of 30 degrees west, north of the Equator) are ordinary comparisons on them.
// Which point is the "nearest point in the continental United States" is a measurement the case supplies.

// =====================================================================
// Section 4221(e)(1): reciprocity for aircraft supplies sold for foreign-registered aircraft
// =====================================================================

use self::{
    AirRoute,
    AirTransportationEvent,
    CommunicationsPaymentEvent,
    CommunicationsService,
    ExciseEvent,
    IRC_S4221_E,
    IRC_S4251_C,
    IRC_S4251_D,
    IRC_S4253_E,
    IRC_S4261_B,
    IRC_S4262_B,
    IRC_S4262_C,
    IRC_S4263_F,
    IRC_S4424_B,
    IRC_S4462_A,
    Organ,
    Person,
    PortUseDirection,
    PortUseEvent,
    PrepaidTelephoneCardTransfer,
    domestic_segment,
    excise_tax_due,
    liable_for_excise,
    port_use,
    s4221_carveout_applies,
    tax_free_sale,
};

const SecretaryOfCommerce: Organ = entity_ref("urn:us:irc:excise_goods:clir#SecretaryOfCommerce") {
    label en official "the Secretary of Commerce";
}
pub relation article_sold_as_supplies_for_aircraft_registered_in_foreign_country(e: ExciseEvent, country: Text) kind empirical {
    label en official "section 4221(e)(1): the article is sold for use as supplies for civil aircraft employed in foreign trade or trade between the United States and its possessions, registered in the foreign country";
}
external judgment relation commerce_advised_treasury_that_country_allows_reciprocal_privileges(country: Text) {
    authority SecretaryOfCommerce;
    label en official "section 4221(e)(1): the Secretary of the Treasury has been advised by the Secretary of Commerce that he has found that the foreign country allows, or will allow, substantially reciprocal privileges in respect of aircraft registered in the United States (DECISION-0194: the finding is the Secretary of Commerce's)";
}
external judgment relation commerce_advised_treasury_that_country_discontinued_privileges(country: Text) {
    authority SecretaryOfCommerce;
    label en official "section 4221(e)(1): the Secretary of the Treasury is advised by the Secretary of Commerce that he has found that the foreign country has discontinued or will discontinue the allowance of such privileges";
}
pub relation foreign_aircraft_supplies_privilege_allowed(e: ExciseEvent, country: Text) kind institutional {
    label en official "section 4221(e)(1): the privileges of subsection (a)(3) are allowed for aircraft registered in this foreign country";
}
@source(IRC_S4221_E, relation = formalizes, coverage = exact, quote = "shall be allowed only if the Secretary of the Treasury has been advised by the Secretary of Commerce that he has found that such foreign country allows, or will allow, substantially reciprocal privileges in respect of aircraft registered in the United States.")
rule ForeignAircraftSuppliesPrivilegeAllowed(e: ExciseEvent, country: Text) strict {
    when article_sold_as_supplies_for_aircraft_registered_in_foreign_country(e, country)
        and commerce_advised_treasury_that_country_allows_reciprocal_privileges(country)
        and not_known(commerce_advised_treasury_that_country_discontinued_privileges(country));
    then foreign_aircraft_supplies_privilege_allowed(e, country);
}
@source(IRC_S4221_E, relation = formalizes, coverage = exact, quote = "the privileges granted under subsection (a)(3) shall not apply thereafter in respect of civil aircraft registered in that foreign country")
rule ForeignAircraftSuppliesWithoutReciprocityCarveOut(e: ExciseEvent, country: Text) strict {
    when article_sold_as_supplies_for_aircraft_registered_in_foreign_country(e, country)
        and not_known(foreign_aircraft_supplies_privilege_allowed(e, country));
    then s4221_carveout_applies(e);
}

// =====================================================================
// Section 4251(c): a bill for pre-November service not rendered before the close of the year
// =====================================================================

pub relation communications_service_rendered_on(e: CommunicationsPaymentEvent, rendered: Date, calendar_year_begins: Date) kind empirical {
    label en official "section 4251(c): the date the communications service was rendered and the first day (January 1) of that calendar year";
}
pub relation communications_bill_rendered_before_close_of_year(e: CommunicationsPaymentEvent) kind empirical {
    label en official "section 4251(c): a bill for the service was rendered before the close of the calendar year";
}
pub relation communications_bill_treated_as_first_rendered_on(e: CommunicationsPaymentEvent, on: Date) kind institutional {
    label en official "section 4251(c): the bill is treated as having been first rendered on December 31 of the year (service rendered before November 1 and no bill rendered before the close of the year)";
}
@source(IRC_S4251_C, relation = formalizes, coverage = exact, quote = "in the case of communications services rendered before November 1 of a calendar year for which a bill has not been rendered before the close of such year, a bill shall be treated as having been first rendered on December 31 of such year.")
rule UnrenderedPreNovemberBillTreatedAsRenderedOnDecember31(e: CommunicationsPaymentEvent, rendered: Date, jan1: Date, calendar_before_1: Date) strict {
    when communications_service_rendered_on(e, rendered, jan1)
        and rendered < add_calendar_period(jan1, 10 calendar_month)
        and not_known(communications_bill_rendered_before_close_of_year(e))
        and us.irc.core::civil_calendar_boundary_before(add_calendar_period(jan1, 1 calendar_year), 1, us.irc.core::CalendarDay, calendar_before_1);
    then communications_bill_treated_as_first_rendered_on(e, calendar_before_1);
}

// =====================================================================
// Section 4251(d)(2): prepaid telephone card without a specified dollar amount
// =====================================================================

pub relation prepaid_card_transferred_without_specified_dollar_amount(e: PrepaidTelephoneCardTransfer, transferor: Person) kind empirical {
    label en official "section 4251(d)(2): a prepaid telephone card which entitles the user other than to a specified dollar amount of use is transferred by a carrier to a non-carrier";
}
external judgment relation secretary_determined_face_amount_of_nondollar_prepaid_card(e: PrepaidTelephoneCardTransfer, face: Money) {
    authority Secretary;
    label en official "section 4251(d)(2): the face amount is determined under regulations prescribed by the Secretary (DECISION-0194)";
}
@source(IRC_S4251_D, relation = formalizes, coverage = exact, quote = "In the case of any prepaid telephone card which entitles the user other than to a specified dollar amount of use, the face amount shall be determined under regulations prescribed by the Secretary.")
rule NonDollarPrepaidCardTaxOnSecretaryFaceAmount(e: PrepaidTelephoneCardTransfer, face: Money) strict {
    when prepaid_card_transferred_without_specified_dollar_amount(e, _) and secretary_determined_face_amount_of_nondollar_prepaid_card(e, face);
    then excise_tax_due(e, round(face * S4251ApplicablePercentage, 2, "HALF_UP"));
}
@source(IRC_S4251_D, relation = formalizes, coverage = exact, quote = "that amount shall be treated as paid when the card is transferred by any telecommunications carrier to any person who is not such a carrier.")
rule NonDollarPrepaidCardLiability(e: PrepaidTelephoneCardTransfer, transferor: Person, amount: Money) defeasible {
    when prepaid_card_transferred_without_specified_dollar_amount(e, transferor) and excise_tax_due(e, amount);
    then liable_for_excise(transferor, e, amount);
}

// =====================================================================
// Section 4253(e): only one payment of tax per service
// =====================================================================

pub relation communications_payment_for_service(e: CommunicationsPaymentEvent, service: CommunicationsService, paid_on: Date) kind empirical {
    label en official "section 4253(e): the payment is for the given service (lines or stations of one or more persons may be used in furnishing it), made on the given date";
}
pub relation earlier_payment_for_same_service_exists(e: CommunicationsPaymentEvent) kind institutional {
    label en official "section 4253(e): a payment of tax for the same service was made earlier";
}
@source(IRC_S4253_E, relation = formalizes, coverage = exact, quote = "Only one payment of tax under section 4251 shall be required with respect to the tax on any service")
rule EarlierPaymentForSameServiceExists(e: CommunicationsPaymentEvent, s: CommunicationsService, d: Date, e2: CommunicationsPaymentEvent, d2: Date) strict {
    when communications_payment_for_service(e, s, d) and communications_payment_for_service(e2, s, d2) and d2 < d;
    then earlier_payment_for_same_service_exists(e);
}
@source(IRC_S4253_E, relation = formalizes, coverage = exact, quote = "notwithstanding the lines or stations of one or more persons are used in furnishing such service.")
rule LaterPaymentForSameServiceNotTaxedAgain(e: CommunicationsPaymentEvent) strict {
    when earlier_payment_for_same_service_exists(e);
    then tax_free_sale(e);
}

// =====================================================================
// Section 4261(b)(3): the segment count is frozen against a rerouting that does not change the amount charged
// =====================================================================

pub relation transportation_purchased_between_two_locations_on_specified_flights(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(b)(3)(A): transportation is purchased between 2 locations on specified flights";
}
pub relation route_change_between_the_two_locations(e: AirTransportationEvent, original_segments: Decimal, changed_segments: Decimal) kind empirical {
    label en official "section 4261(b)(3)(B): the number of domestic segments on the route originally purchased and on the route actually taken";
}
pub relation amount_charged_changed_by_route_change(e: AirTransportationEvent) kind empirical {
    label en official "section 4261(b)(3)(B): the amount charged for the transportation changed with the change in route";
}
pub relation rerouting_alters_segments_without_change_in_amount_charged(e: AirTransportationEvent) kind institutional {
    label en official "section 4261(b)(3): a route change changes the number of domestic segments but there is no change in the amount charged";
}
pub relation chargeable_domestic_segment_count(e: AirTransportationEvent, count: Decimal) kind institutional {
    label en official "section 4261(b)(1), (3): the number of domestic segments the tax is determined on, without regard to a rerouting that changes the segment count but not the amount charged";
}
@source(IRC_S4261_B, relation = formalizes, coverage = exact, quote = "(B) there is a change in the route taken between such 2 locations which changes the number of domestic segments, but there is no change in the amount charged for such transportation,")
rule ReroutingAltersSegmentsWithoutChangeInAmount(e: AirTransportationEvent, orig: Decimal, changed: Decimal) strict {
    when transportation_purchased_between_two_locations_on_specified_flights(e)
        and route_change_between_the_two_locations(e, orig, changed)
        and orig != changed
        and not_known(amount_charged_changed_by_route_change(e));
    then rerouting_alters_segments_without_change_in_amount_charged(e);
}
@source(IRC_S4261_B, relation = formalizes, coverage = exact, quote = "the tax imposed by paragraph (1) shall be determined without regard to such change in route.")
rule ChargeableSegmentCountFrozenAtOriginal(e: AirTransportationEvent, orig: Decimal, changed: Decimal) strict {
    when rerouting_alters_segments_without_change_in_amount_charged(e) and route_change_between_the_two_locations(e, orig, changed);
    then chargeable_domestic_segment_count(e, orig);
}
@source(IRC_S4261_B, relation = formalizes, coverage = exact, quote = "There is hereby imposed on the amount paid for each domestic segment of taxable transportation by air a tax in the amount of $3.00.")
rule ChargeableSegmentCountAsStated(e: AirTransportationEvent, count: Decimal) strict {
    when domestic_segment(e, count, _) and not_known(rerouting_alters_segments_without_change_in_amount_charged(e));
    then chargeable_domestic_segment_count(e, count);
}

// =====================================================================
// Section 4262(b), (c)(2): exclusion of travel outside the 225-mile zone
// =====================================================================

pub entity AirSegment;
pub entity AirStation;

pub relation station_in_canada_or_mexico(st: AirStation) kind empirical {
    label en official "section 4262(c)(2): the port or station is in Canada or Mexico";
}
pub relation station_distance_to_nearest_point_of_continental_us_miles(st: AirStation, miles: Decimal) kind empirical {
    label en official "section 4262(c)(2): the distance in miles from the port or station to the nearest point in the continental United States (a measurement the case supplies)";
}
pub relation station_in_225_mile_zone(st: AirStation) kind institutional {
    label en official "section 4262(c)(2): the 225-mile zone: the portion of Canada and Mexico which is not more than 225 miles from the nearest point in the continental United States";
}
@source(IRC_S4262_C, relation = formalizes, coverage = exact, quote = "The term \"225-mile zone\" means that portion of Canada and Mexico which is not more than 225 miles from the nearest point in the continental United States.")
rule StationIn225MileZone(st: AirStation, d: Decimal) strict {
    when station_in_canada_or_mexico(st) and station_distance_to_nearest_point_of_continental_us_miles(st, d) and d <= 225.0;
    then station_in_225_mile_zone(st);
}

pub relation route_portion_outside_united_states(r: AirRoute) kind empirical {
    label en official "section 4262(b)(1): the portion of the transportation by air is outside the United States";
}
pub relation segment_of_route_portion(seg: AirSegment, r: AirRoute) kind empirical {
    label en official "the segment belongs to the portion of the route under section 4262(b)";
}
pub relation portion_is_between_border_or_zone_point_and_zone_station(r: AirRoute) kind empirical {
    label en official "section 4262(b)(2)(A)-(B): the portion itself is directly or indirectly between (A) a point where the route leaves or enters the continental United States, or a port or station in the 225-mile zone, and (B) a port or station in the 225-mile zone";
}
pub relation segment_is_between_border_or_zone_point_and_zone_station(seg: AirSegment) kind empirical {
    label en official "section 4262(b)(2)(A)-(B): the segment is directly or indirectly between (A) a point where the route leaves or enters the continental United States, or a port or station in the 225-mile zone, and (B) a port or station in the 225-mile zone";
}
pub relation portion_or_a_segment_in_excluded_band_4262b2(r: AirRoute) kind institutional {
    label en official "section 4262(b)(2): the portion or a segment of it is between the points of subparagraphs (A) and (B), so requirement (2) fails";
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(2) neither such portion nor any segment thereof is directly or indirectly—")
rule PortionItselfInExcludedBand(r: AirRoute) strict {
    when portion_is_between_border_or_zone_point_and_zone_station(r);
    then portion_or_a_segment_in_excluded_band_4262b2(r);
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(2) neither such portion nor any segment thereof is directly or indirectly—")
rule SegmentInExcludedBand(r: AirRoute, seg: AirSegment) strict {
    when segment_of_route_portion(seg, r) and segment_is_between_border_or_zone_point_and_zone_station(seg);
    then portion_or_a_segment_in_excluded_band_4262b2(r);
}
pub relation portion_begins_at_us_leaving_point(r: AirRoute) kind empirical {
    label en official "section 4262(b)(3)(A)(i): the portion begins at the point where the route of the transportation leaves the United States";
}
pub relation portion_begins_at_225_mile_zone_station(r: AirRoute) kind empirical {
    label en official "section 4262(b)(3)(A)(ii): the portion begins at a port or station in the 225-mile zone";
}
pub relation portion_ends_at_us_entering_point(r: AirRoute) kind empirical {
    label en official "section 4262(b)(3)(B)(i): the portion ends at the point where the route of the transportation enters the United States";
}
pub relation portion_ends_at_225_mile_zone_station(r: AirRoute) kind empirical {
    label en official "section 4262(b)(3)(B)(ii): the portion ends at a port or station in the 225-mile zone";
}
pub relation direct_line_max_distance_from_united_states_miles(r: AirRoute, miles: Decimal) kind empirical {
    label en official "section 4262(b)(4): the greatest distance from the United States, in miles, of a point through or over which a direct line between the beginning and end points passes (a measurement the case supplies)";
}
pub relation portion_begins_as_required_4262b3A(r: AirRoute) kind institutional {
    label en official "section 4262(b)(3)(A): the portion begins at the point where the route leaves the United States or at a port or station in the 225-mile zone";
}
pub relation portion_ends_as_required_4262b3B(r: AirRoute) kind institutional {
    label en official "section 4262(b)(3)(B): the portion ends at the point where the route enters the United States or at a port or station in the 225-mile zone";
}
pub relation direct_line_passes_beyond_225_miles_4262b4(r: AirRoute) kind institutional {
    label en official "section 4262(b)(4): a direct line from the beginning point to the end point passes through or over a point which is not within 225 miles of the United States";
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(A) begins at either (i) the point where the route of the transportation leaves the United States, or (ii) a port or station in the 225-mile zone, and")
rule PortionBeginsAtLeavingPoint(r: AirRoute) strict {
    when portion_begins_at_us_leaving_point(r);
    then portion_begins_as_required_4262b3A(r);
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(A) begins at either (i) the point where the route of the transportation leaves the United States, or (ii) a port or station in the 225-mile zone, and")
rule PortionBeginsAtZoneStation(r: AirRoute) strict {
    when portion_begins_at_225_mile_zone_station(r);
    then portion_begins_as_required_4262b3A(r);
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(B) ends at either (i) the point where the route of the transportation enters the United States, or (ii) a port or station in the 225-mile zone; and")
rule PortionEndsAtEnteringPoint(r: AirRoute) strict {
    when portion_ends_at_us_entering_point(r);
    then portion_ends_as_required_4262b3B(r);
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "(B) ends at either (i) the point where the route of the transportation enters the United States, or (ii) a port or station in the 225-mile zone; and")
rule PortionEndsAtZoneStation(r: AirRoute) strict {
    when portion_ends_at_225_mile_zone_station(r);
    then portion_ends_as_required_4262b3B(r);
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "passes through or over a point which is not within 225 miles of the United States.")
rule DirectLinePassesBeyond225Miles(r: AirRoute, miles: Decimal) strict {
    when direct_line_max_distance_from_united_states_miles(r, miles) and miles > 225.0;
    then direct_line_passes_beyond_225_miles_4262b4(r);
}
pub relation route_portion_excluded_by_4262b(r: AirRoute) kind institutional {
    label en official "section 4262(b): the portion meets all 4 requirements, so it is not taxable transportation";
}
@source(IRC_S4262_B, relation = formalizes, coverage = exact, quote = "For purposes of this part, the term \"taxable transportation\" does not include that portion of any transportation by air which meets all 4 of the following requirements:")
rule RoutePortionExcludedByAllFourRequirements(r: AirRoute) strict {
    when route_portion_outside_united_states(r)
        and not_known(portion_or_a_segment_in_excluded_band_4262b2(r))
        and portion_begins_as_required_4262b3A(r)
        and portion_ends_as_required_4262b3B(r)
        and direct_line_passes_beyond_225_miles_4262b4(r);
    then route_portion_excluded_by_4262b(r);
}
// The taxable-transportation rules of module 13 now also read `route_portion_excluded_by_4262b` (stage 3 edit).

// =====================================================================
// Section 4263(f): transportation outside the northern portion of the Western Hemisphere
// =====================================================================

pub entity GeoPoint;
pub relation point_longitude_degrees(pt: GeoPoint, longitude: Decimal) kind empirical {
    label en official "the longitude of the point in degrees, positive east of Greenwich and negative west of it (from -180 to 180)";
}
pub relation point_latitude_degrees(pt: GeoPoint, latitude: Decimal) kind empirical {
    label en official "the latitude of the point in degrees, positive north of the Equator";
}
pub relation point_in_country_of_south_america(pt: GeoPoint) kind empirical {
    label en official "section 4263(f): the point is in a country of South America";
}
pub relation point_in_northern_portion_of_western_hemisphere(pt: GeoPoint) kind institutional {
    label en official "section 4263(f): the area lying west of the 30th meridian west of Greenwich, east of the international dateline, and north of the Equator, but not including any country of South America";
}
@source(IRC_S4263_F, relation = formalizes, coverage = exact, quote = "the term \"northern portion of the Western Hemisphere\" means the area lying west of the 30th meridian west of Greenwich, east of the international dateline, and north of the Equator, but not including any country of South America.")
rule PointInNorthernPortionOfWesternHemisphere(pt: GeoPoint, lon: Decimal, lat: Decimal) strict {
    when point_longitude_degrees(pt, lon)
        and point_latitude_degrees(pt, lat)
        and lon < -30.0 and lon > -180.0 and lat > 0.0
        and not_known(point_in_country_of_south_america(pt));
    then point_in_northern_portion_of_western_hemisphere(pt);
}
pub relation route_part_outside_northern_portion_of_western_hemisphere(r: AirRoute) kind empirical {
    label en official "section 4263(f): a part of the transportation is outside the northern portion of the Western Hemisphere";
}
pub relation route_leaves_and_reenters_northern_portion_of_western_hemisphere(r: AirRoute) kind empirical {
    label en official "section 4263(f): the route of the transportation leaves and reenters the northern portion of the Western Hemisphere";
}
pub relation transportation_considered_split_at_leaving_northern_portion(r: AirRoute) kind institutional {
    label en official "section 4263(f): the transportation is considered to consist of transportation to a point outside the northern portion of the Western Hemisphere and of separate transportation thereafter";
}
@source(IRC_S4263_F, relation = formalizes, coverage = exact, quote = "such transportation shall be considered to consist of transportation to a point outside such northern portion, and of separate transportation thereafter.")
rule TransportationLeavingAndReenteringNorthernWesternHemisphereIsSplit(r: AirRoute) strict {
    when route_part_outside_northern_portion_of_western_hemisphere(r) and route_leaves_and_reenters_northern_portion_of_western_hemisphere(r);
    then transportation_considered_split_at_leaving_northern_portion(r);
}

// =====================================================================
// Section 4424(b): onward disclosure and criminal use of documents disclosed for tax enforcement
// =====================================================================

pub entity WageringDocument;
pub relation document_disclosed_under_4424b(doc: WageringDocument) kind empirical {
    label en official "section 4424(b): the document or information was disclosed in connection with the administration or civil or criminal enforcement of a tax imposed by the title (the identity of the document is the entity)";
}
pub relation united_states_officer_or_employee(p: Person) kind empirical {
    label en official "section 4424(b)(1): the person is an officer or employee of the United States";
}
pub relation divulges_disclosed_document(actor: Person, doc: WageringDocument) kind empirical {
    label en official "section 4424(b)(1): the actor divulges or makes known in any manner whatever the document or information disclosed under subsection (b)";
}
pub relation divulgence_in_connection_with_administration_or_enforcement_of_title(actor: Person, doc: WageringDocument) kind empirical {
    label en official "section 4424(b)(1): the divulgence is in connection with the administration or civil or criminal enforcement of this title";
}
@source(IRC_S4424_B, relation = formalizes, coverage = exact, quote = "(1) divulged or made known in any manner whatever by any officer or employee of the United States to any person except in connection with the administration or civil or criminal enforcement of this title, nor")
rule Section4424bOnwardDisclosureProhibitionRule(p: Person, doc: WageringDocument) defeasible {
    when document_disclosed_under_4424b(doc) and united_states_officer_or_employee(p) and divulges_disclosed_document(p, doc);
    then prohibition WageringDocumentOnwardDisclosure {
        bearer p;
        action divulges_disclosed_document(p, doc);
        window [-infinity, infinity];
    };
    unless divulgence_in_connection_with_administration_or_enforcement_of_title(p, doc) and document_disclosed_under_4424b(doc) and united_states_officer_or_employee(p) and divulges_disclosed_document(p, doc);
}
pub relation disclosed_document_used_in_criminal_prosecution(doc: WageringDocument, offense_date: Date) kind empirical {
    label en official "section 4424(b)(2): the document or information is used, directly or indirectly, in a criminal prosecution for an offense occurring on the given date";
}
pub relation prosecutor_of_offense_using_disclosed_document(actor: Person, doc: WageringDocument) kind empirical {
    label en official "section 4424(b)(2): the person who uses the disclosed document in the criminal prosecution";
}
pub relation criminal_use_of_disclosed_document_before_1974_10_29_offense(actor: Person, doc: WageringDocument) kind institutional {
    label en official "section 4424(b)(2): use of the disclosed document in a prosecution for an offense before the date of enactment of the section (JUDGMENT CALL: 1974-10-29, Pub. L. 93-499 section 3(d)(1), the enacting act, see the section note)";
}
@source(IRC_S4424_B, relation = formalizes, coverage = exact, quote = "(2) used, directly or indirectly, in any criminal prosecution for any offense occurring before the date of enactment of this section.")
rule DisclosedDocumentUsedForOffenseBeforeEnactment(actor: Person, doc: WageringDocument, offense: Date) strict {
    when document_disclosed_under_4424b(doc)
        and prosecutor_of_offense_using_disclosed_document(actor, doc)
        and disclosed_document_used_in_criminal_prosecution(doc, offense)
        and offense < @1974-10-29;
    then criminal_use_of_disclosed_document_before_1974_10_29_offense(actor, doc);
}
@source(IRC_S4424_B, relation = formalizes, coverage = exact, quote = "(2) used, directly or indirectly, in any criminal prosecution for any offense occurring before the date of enactment of this section.")
rule Section4424bNoCriminalUseBeforeEnactmentProhibitionRule(actor: Person, doc: WageringDocument) strict {
    when criminal_use_of_disclosed_document_before_1974_10_29_offense(actor, doc);
    then prohibition WageringDocumentCriminalUseForEarlierOffense {
        bearer actor;
        action criminal_use_of_disclosed_document_before_1974_10_29_offense(actor, doc);
        window [-infinity, infinity];
    };
}

// =====================================================================
// Section 4462(a)(2)(C): the Columbia River channels count as a port only up to Bonneville lock and dam
// =====================================================================

pub relation harbor_is_channel_of_columbia_river_in_oregon_or_washington(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(2)(C): the channel is a channel of the Columbia River in the States of Oregon and Washington";
}
pub relation harbor_channel_is_upstream_of_bonneville_lock_and_dam(e: PortUseEvent) kind empirical {
    label en official "section 4462(a)(2)(C): the channel lies above the downstream side of Bonneville lock and dam";
}
pub relation columbia_river_channel_outside_port_definition(e: PortUseEvent) kind institutional {
    label en official "section 4462(a)(2)(C): the Columbia River channels are included as a port only up to the downstream side of Bonneville lock and dam, so this upstream channel is not a port";
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "The term \"port\" shall include the channels of the Columbia River in the States of Oregon and Washington only up to the downstream side of Bonneville lock and dam.")
rule ColumbiaRiverUpstreamChannelIsNotAPort(e: PortUseEvent) strict {
    when harbor_is_channel_of_columbia_river_in_oregon_or_washington(e) and harbor_channel_is_upstream_of_bonneville_lock_and_dam(e);
    then columbia_river_channel_outside_port_definition(e);
}
@source(IRC_S4462_A, relation = formalizes, coverage = exact, quote = "The term \"port\" shall include the channels of the Columbia River in the States of Oregon and Washington only up to the downstream side of Bonneville lock and dam.")
rule PortUseOnUpstreamColumbiaChannelNotTaxed(e: PortUseEvent) strict {
    when port_use(e, _, _, _) and columbia_river_channel_outside_port_definition(e);
    then tax_free_sale(e);
}
