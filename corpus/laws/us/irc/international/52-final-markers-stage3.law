// Stage 3 (TECH_GAP reduction), module 52: last markers and boycott rules: section 951(a)(2)(B) gloss; 958(a)(3); 932(a)(3), (c)(3);
// 964(d)(1)(A); 985(b)(4); 986(a)(1)(D)(ii); 995(b)(2)(A), (b)(4)(A), (d)(2); 999(a)(2), (b), (c)(2). Status implemented_unverified:
// not a legal review; scenarios in tests/final-markers-stage3.lawtest are written, NOT executed.

use self::{
    IRC_S877A_A,
    IRC_S877A_D,
    IRC_S932_A,
    IRC_S932_C,
    IRC_S951_A,
    IRC_S952_C,
    IRC_S957_C,
    IRC_S958_A,
    IRC_S964_D,
    IRC_S985_B,
    IRC_S986_A,
    IRC_S995_B,
    IRC_S995_D,
    IRC_S999_A,
    IRC_S999_B,
    IRC_S999_C,
    participates_in_international_boycott_999b3,
    person_has_operations_in_listed_or_boycott_country_999a1,
};

pub relation section_1248_dividend_included_951a2B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "gain included in the gross income of a person as a dividend under section 1248";
}
pub relation section_1248_gain_treated_as_distribution_for_951a2B(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for purposes of subparagraph (B) any gain included as a dividend under section 1248 is treated as a distribution received with respect to the stock involved";
}
@source(IRC_S951_A, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (B), any gain included in the gross income of any person as a dividend under")
rule S951A2B1248GainAsDistribution defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_1248_dividend_included_951a2B(p, corp, y, amount);
    then section_1248_gain_treated_as_distribution_for_951a2B(p, corp, y, amount);
}
pub relation foreign_mutual_insurance_company_958a3(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is a foreign mutual insurance company";
}
pub relation certificate_entitles_holder_to_voting_power_958a3(corp: us.irc.core::Corporation, certificate_id: Text) kind empirical {
    label en official "a certificate entitling the holder to voting power in the corporation";
}
pub relation certificate_counts_as_stock_958a3(corp: us.irc.core::Corporation, certificate_id: Text) kind institutional {
    label en official "for a foreign mutual insurance company the term stock includes any certificate entitling the holder to voting power";
}
@source(IRC_S958_A, relation = formalizes, coverage = exact, quote = "For purposes of applying paragraph (1) in the case of a foreign mutual insurance company, the term \"stock\"")
rule S958A3CertificatesAsStock defeasible {
    for corp: us.irc.core::Corporation;
    for certificate_id: Text;
    when foreign_mutual_insurance_company_958a3(corp)
     and certificate_entitles_holder_to_voting_power_958a3(corp, certificate_id);
    then certificate_counts_as_stock_958a3(corp, certificate_id);
}
pub relation individual_to_whom_932a_applies_932(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is one to whom subsection (a) (citizens and residents of the Virgin Islands) applies in the taxable year";
}
pub relation united_states_includes_virgin_islands_for_chapter_1_932a3(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for so much of this title (other than this section and section 7654) as relates to chapter 1 taxes, the United States is treated as including the Virgin Islands (the widening applies to every chapter 1 rule as a reading of the term; the rules themselves are not re-run)";
}
@source(IRC_S932_A, relation = formalizes, coverage = exact, quote = "In the case of an individual to whom this subsection applies in a taxable year for purposes of so much of")
rule S932A3UnitedStatesIncludesVirginIslands defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when individual_to_whom_932a_applies_932(individual, y);
    then united_states_includes_virgin_islands_for_chapter_1_932a3(individual, y);
}
pub relation individual_to_whom_932c_applies_932(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is one to whom subsection (c) (United States citizens and residents with Virgin Islands filing) applies in the taxable year";
}
pub relation virgin_islands_includes_united_states_for_chapter_1_932c3(individual: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for so much of this title as relates to chapter 1 taxes, the Virgin Islands are treated as including the United States";
}
@source(IRC_S932_C, relation = formalizes, coverage = exact, quote = "In the case of an individual to whom this subsection applies in a taxable year for purposes of so much of")
rule S932C3VirginIslandsIncludesUnitedStates defeasible {
    for individual: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when individual_to_whom_932c_applies_932(individual, y);
    then virgin_islands_includes_united_states_for_chapter_1_932c3(individual, y);
}
pub relation qualified_insurance_branch_of_cfc_964d1(branch_id: Text, cfc: us.irc.core::Corporation, country: Text) kind empirical {
    label en official "a qualified insurance branch of a controlled foreign corporation, and the foreign country with respect to which the branch qualifies under paragraph (2)";
}
pub relation branch_treated_as_separate_foreign_corporation_964d1A(branch_id: Text, country: Text) kind institutional {
    label en official "the qualified insurance branch is treated as a separate foreign corporation created under the laws of the country with respect to which it qualifies";
}
@source(IRC_S964_D, relation = formalizes, coverage = exact, quote = "(A) a qualified insurance branch of a controlled foreign corporation shall be treated as a separate foreign")
rule S964D1ABranchAsSeparateCorporation defeasible {
    for branch_id: Text;
    for cfc: us.irc.core::Corporation;
    for country: Text;
    when qualified_insurance_branch_of_cfc_964d1(branch_id, cfc, country);
    then branch_treated_as_separate_foreign_corporation_964d1A(branch_id, country);
}
pub relation functional_currency_change_985b4(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer changes its functional currency in the taxable year";
}
pub relation change_treated_as_method_of_accounting_change_985b4(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a change in the functional currency is treated as a change in the taxpayer's method of accounting for purposes of section 481, under procedures to be established by the Secretary";
}
@source(IRC_S985_B, relation = formalizes, coverage = exact, quote = "Any change in the functional currency shall be treated as a change in the taxpayer's method of accounting for")
rule S985B4ChangeIsMethodChange defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when functional_currency_change_985b4(p, y);
    then change_treated_as_method_of_accounting_change_985b4(p, y);
}
pub relation election_986a1D_for_qbu_taxes_986a1Dii(p: us.irc.core::Person, tax_id: Text, qbu_id: Text) kind empirical {
    label en official "an election under subparagraph (D) for foreign income taxes attributable to a qualified business unit, made in accordance with regulations";
}
pub relation election_may_apply_to_qbu_taxes_986a1Dii(p: us.irc.core::Person, tax_id: Text, qbu_id: Text) kind institutional {
    label en official "the election may apply to foreign income taxes attributable to a qualified business unit (the regulations governing the form are external)";
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "An election under this subparagraph may apply to foreign income taxes attributable to a qualified business")
rule S986A1DiiElectionForQbuTaxes defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for qbu_id: Text;
    when election_986a1D_for_qbu_taxes_986a1Dii(p, tax_id, qbu_id);
    then election_may_apply_to_qbu_taxes_986a1Dii(p, tax_id, qbu_id);
}
pub relation shareholder_disc_income_share_995b2A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, percent: Decimal, accumulated_disc_income: Money) kind empirical {
    label en official "the shareholder's pro rata share (percent) and the DISC income of the corporation accumulated during the immediately preceding consecutive taxable years for which it was a DISC";
}
pub relation corporation_revoked_or_failed_disc_conditions_995b2A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the corporation revoked its election to be treated as a DISC or failed to satisfy the conditions of section 992(a)(1) for the taxable year";
}
pub relation deemed_dividend_on_disqualification_995b2A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder is deemed to have received a distribution taxable as a dividend equal to its pro rata share of the accumulated DISC income of the preceding consecutive DISC years (the timing is subparagraph (B))";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "(A) A shareholder of a corporation which revoked its election to be treated as a DISC or failed to satisfy")
rule S995B2ADeemedDividendOnDisqualification defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for percent: Decimal;
    for income: Money;
    when corporation_revoked_or_failed_disc_conditions_995b2A(corp, y)
     and shareholder_disc_income_share_995b2A(shareholder, corp, percent, income);
    then deemed_dividend_on_disqualification_995b2A(shareholder, corp, y, round(income * (percent / 100.0), 2, "HALF_UP"));
}
pub relation disc_member_of_controlled_group_995b4A(disc: us.irc.core::Corporation, group_id: Text) kind empirical {
    label en official "the DISC is a member of the controlled group";
}
pub relation group_treated_as_single_corporation_995b4A(group_id: Text) kind institutional {
    label en official "for paragraph (1)(E) all DISCs which are members of the same controlled group are treated as a single corporation";
}
@source(IRC_S995_B, relation = formalizes, coverage = exact, quote = "For purposes of applying paragraph (1)(E), all DISC's which are members of the same controlled group shall be")
rule S995B4ASingleCorporation defeasible {
    for disc: us.irc.core::Corporation;
    for group_id: Text;
    when disc_member_of_controlled_group_995b4A(disc, group_id);
    then group_treated_as_single_corporation_995b4A(group_id);
}
pub relation asset_kind_995d2(asset_id: Text, is_qualified_export_asset: Boolean) kind empirical {
    label en official "the asset is (or would be if owned by a DISC) a qualified export asset";
}
pub relation amount_attributable_year_start_995d2(item_id: Text, year_begins_on: Date) kind empirical {
    label en official "the first day of the taxable year to which the amount is attributable";
}
pub relation amount_counted_for_paragraph_2_995d2(item_id: Text) kind institutional {
    label en official "amounts described in paragraph (2) are taken into account only to the extent attributable to taxable years beginning after December 31, 1971 (the exceptions of subparagraphs (B)(ii) and (v) are separate case flags)";
}
@source(IRC_S995_D, relation = formalizes, coverage = exact, quote = "For purposes of this paragraph, assets which are qualified export assets of a DISC (or would be qualified")
rule S995D2CountedOnlyAfter1971 defeasible {
    for item_id: Text;
    for begins_on: Date;
    when amount_attributable_year_start_995d2(item_id, begins_on)
     and begins_on > @1971-12-31;
    then amount_counted_for_paragraph_2_995d2(item_id);
}
pub relation international_boycott_report_participation_999a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer, a foreign corporation of which he is a United States shareholder, or a member of the controlled group participated in or cooperated with an international boycott during the year, or was requested to";
}
pub relation participation_and_request_reported_999a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the taxpayer reported whether it participated or cooperated, or was requested, and the nature of each such operation";
}
@source(IRC_S999_A, relation = formalizes, coverage = exact, quote = "A taxpayer shall report whether he, a foreign corporation of which he is a United States shareholder, or any")
rule S999A2DutyToReportParticipation defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when person_has_operations_in_listed_or_boycott_country_999a1(p, y);
    then duty S999A2ReportParticipationDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition participation_and_request_reported_999a2(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation boycott_country_operation_999b1(p: us.irc.core::Person, operation_id: Text, country: Text) kind empirical {
    label en official "an operation of the taxpayer or its controlled group in the country, or in another country that requires participation as a condition of doing business";
}
pub relation clearly_separate_operation_without_participation_shown_999b1(p: us.irc.core::Person, operation_id: Text) kind empirical {
    label en official "the person clearly demonstrates that the operation is a clearly separate and identifiable operation in connection with which there was no participation or cooperation";
}
pub relation operation_treated_as_boycott_participation_999b1(p: us.irc.core::Person, operation_id: Text) kind institutional {
    label en official "if the person participates in or cooperates with an international boycott in the year, all its operations in the country (and other countries requiring participation) are treated as operations in connection with which the participation occurred, except operations clearly shown separate and non-participating";
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "If the person or a member of a controlled group (within the meaning of section 993(a)(3)) which includes the")
rule S999B1AllOperationsTreatedAsParticipation defeasible {
    for p: us.irc.core::Person;
    for operation_id: Text;
    for country: Text;
    when participates_in_international_boycott_999b3(p)
     and boycott_country_operation_999b1(p, operation_id, country);
    unless clearly_separate_operation_without_participation_shown_999b1(p, operation_id)
     and boycott_country_operation_999b1(p, operation_id, country);
    then operation_treated_as_boycott_participation_999b1(p, operation_id);
}
pub relation operation_not_related_to_boycott_group_999b2A(p: us.irc.core::Person, operation_id: Text) kind institutional {
    label en official "a clearly separate and identifiable operation in a country of the group is not treated as an operation in or related to a group of countries associated in carrying out a boycott if the person clearly demonstrates no participation or cooperation in that operation";
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "A clearly separate and identifiable operation of a person, or of a member of the controlled group (within the")
rule S999B2ANonboycottOperation defeasible {
    for p: us.irc.core::Person;
    for operation_id: Text;
    when clearly_separate_operation_without_participation_shown_999b1(p, operation_id);
    then operation_not_related_to_boycott_group_999b2A(p, operation_id);
}
pub relation operations_shown_separate_and_identifiable_999b2B(p: us.irc.core::Person, operation_a: Text, operation_b: Text) kind empirical {
    label en official "the taxpayer shows that different operations within the same country, or operations in different countries, are clearly separate and identifiable operations";
}
pub relation operations_are_separate_and_identifiable_999b2B(p: us.irc.core::Person, operation_a: Text, operation_b: Text) kind institutional {
    label en official "the operations are clearly separate and identifiable (a case showing)";
}
@source(IRC_S999_B, relation = formalizes, coverage = exact, quote = "A taxpayer may show that different operations within the same country, or operations in different countries,")
rule S999B2BSeparateOperations defeasible {
    for p: us.irc.core::Person;
    for a: Text;
    for b: Text;
    when operations_shown_separate_and_identifiable_999b2B(p, a, b);
    then operations_are_separate_and_identifiable_999b2B(p, a, b);
}
pub relation amount_specifically_attributable_to_operations_999c2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, credit_disallowed: Money, subpart_f_addition: Money, deemed_distribution: Money) kind empirical {
    label en official "the taxpayer clearly demonstrates that taxes paid and income earned are attributable to specific operations; the credit disallowed under section 908(a), the subpart F addition under section 952(a)(3) and the deemed distribution under section 995(b)(1)(F)(ii) attributable to the boycott operations";
}
pub relation specific_operations_amounts_in_lieu_of_boycott_factor_999c2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, credit_disallowed: Money, subpart_f_addition: Money, deemed_distribution: Money) kind institutional {
    label en official "in lieu of applying the international boycott factor for the year, the three amounts are those specifically attributable to the operations";
}
@source(IRC_S999_C, relation = formalizes, coverage = exact, quote = "If the taxpayer clearly demonstrates that the foreign taxes paid and income earned for the taxable year are")
rule S999C2SpecificOperationsInLieuOfFactor defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    for c: Money;
    when amount_specifically_attributable_to_operations_999c2(p, y, a, b, c);
    then specific_operations_amounts_in_lieu_of_boycott_factor_999c2(p, y, a, b, c);
}

// --- §877A(a)(2), (d)(2)(C), (e)(1)(C): proper adjustments ------------------------------------------------------------------------

pub relation gain_or_loss_taken_into_account_on_expatriation_877Aa2(individual: us.irc.core::Individual, property_id: Text, amount: Money) kind empirical {
    label en official "the gain or loss taken into account under the preceding sentence (the deemed sale on the day before the expatriation date)";
}
pub relation gain_or_loss_subsequently_realized_877Aa2(individual: us.irc.core::Individual, property_id: Text, amount: Money) kind empirical {
    label en official "the gain or loss subsequently realized, determined without regard to paragraph (3)";
}
pub relation subsequent_gain_or_loss_after_proper_adjustment_877Aa2(individual: us.irc.core::Individual, property_id: Text, amount: Money) kind institutional {
    label en official "proper adjustment of the gain or loss subsequently realized for the gain or loss already taken into account (read as: the subsequent gain or loss less the amount already taken into account; JUDGMENT CALL, the statute says proper adjustment)";
}
@source(IRC_S877A_A, relation = formalizes, coverage = partial, quote = "Proper adjustment shall be made in the amount of any gain or loss subsequently realized for gain or loss")
rule S877Aa2ProperAdjustment defeasible {
    for individual: us.irc.core::Individual;
    for property_id: Text;
    for taken: Money;
    for later: Money;
    when gain_or_loss_taken_into_account_on_expatriation_877Aa2(individual, property_id, taken)
     and gain_or_loss_subsequently_realized_877Aa2(individual, property_id, later);
    then subsequent_gain_or_loss_after_proper_adjustment_877Aa2(individual, property_id, later - taken);
}
pub relation deemed_distribution_of_account_877A(individual: us.irc.core::Individual, account_id: Text, deemed: Money) kind empirical {
    label en official "the amount of the account or plan treated as received (a deemed distribution) on the day before the expatriation date";
}
pub relation subsequent_distribution_from_account_877A(individual: us.irc.core::Individual, account_id: Text, distribution: Money) kind empirical {
    label en official "a subsequent distribution from the plan or account";
}
pub relation subsequent_distribution_after_appropriate_adjustment_877A(individual: us.irc.core::Individual, account_id: Text, includible: Money) kind institutional {
    label en official "appropriate adjustment of the subsequent distribution to reflect the deemed distribution (read as: the distribution less the amount already treated as received, not below zero; JUDGMENT CALL)";
}
@source(IRC_S877A_D, relation = formalizes, coverage = partial, quote = "(C) appropriate adjustments shall be made to subsequent distributions from the plan to reflect such treatment.")
rule S877ADAdjustSubsequentDistribution defeasible {
    for individual: us.irc.core::Individual;
    for account_id: Text;
    for deemed: Money;
    for distribution: Money;
    when deemed_distribution_of_account_877A(individual, account_id, deemed)
     and subsequent_distribution_from_account_877A(individual, account_id, distribution);
    then subsequent_distribution_after_appropriate_adjustment_877A(individual, account_id, max(distribution - deemed, 0.00 USD));
}

// --- §957(c)(2): Guam, American Samoa and Northern Mariana Islands corporations -------------------------------------------

pub relation corporation_organized_in_guam_american_samoa_or_nmi_957c2(corp: us.irc.core::Corporation) kind empirical {
    label en official "the corporation is organized under the laws of Guam, American Samoa or the Northern Mariana Islands";
}
pub relation possession_source_gross_income_percent_957c2A(corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the corporation's gross income for the 3-year period ending at the close of the taxable year (or the part it or a predecessor existed) derived from sources within such a possession or effectively connected with a trade or business there";
}
pub relation active_possession_business_gross_income_percent_957c2B(corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of that gross income derived from the active conduct of a trade or business within such a possession (determined under regulations, a case input)";
}
pub relation individual_bona_fide_resident_of_possession_957c2(individual: us.irc.core::Individual) kind empirical {
    label en official "the individual is a bona fide resident of Guam, American Samoa or the Northern Mariana Islands";
}
pub relation possession_corporation_conditions_957c2AB_met(corp: us.irc.core::Corporation) kind institutional {
    label en official "at least 80 percent of the gross income is possession-source or effectively connected there, and at least 50 percent is from the active conduct of a trade or business there";
}
@source(IRC_S957_C, relation = formalizes, coverage = exact, quote = "(2) with respect to a corporation organized under the laws of Guam, American Samoa, or the Northern Mariana")
rule S957C2ABPossessionCorporationConditions defeasible {
    for corp: us.irc.core::Corporation;
    for source_percent: Decimal;
    for active_percent: Decimal;
    when corporation_organized_in_guam_american_samoa_or_nmi_957c2(corp)
     and possession_source_gross_income_percent_957c2A(corp, source_percent)
     and active_possession_business_gross_income_percent_957c2B(corp, active_percent)
     and source_percent >= 80.0
     and active_percent >= 50.0;
    then possession_corporation_conditions_957c2AB_met(corp);
}
pub relation resident_individual_not_united_states_person_for_subpart_957c2(individual: us.irc.core::Individual, corp: us.irc.core::Corporation) kind institutional {
    label en official "with respect to such a corporation the term United States person does not include an individual who is a bona fide resident of the possession";
}
@source(IRC_S957_C, relation = formalizes, coverage = exact, quote = "(2) with respect to a corporation organized under the laws of Guam, American Samoa, or the Northern Mariana")
rule S957C2ResidentNotUnitedStatesPerson defeasible {
    for individual: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    when possession_corporation_conditions_957c2AB_met(corp)
     and individual_bona_fide_resident_of_possession_957c2(individual);
    then resident_individual_not_united_states_person_for_subpart_957c2(individual, corp);
}

// --- §952(c)(1)(B)(vii): election to disregard the same country exception -----------------------------------------------------

pub relation elects_953a_without_same_country_exception_952c1Bvii(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "an election is made to have section 953(a) applied without regard to the same country exception of paragraph (1)(A) thereof (once made, revocable only with the Secretary's consent)";
}
pub relation all_same_country_group_members_elect_952c1Bviiii(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "in an affiliated group (section 1504 with more than 50 percent for 80 percent, without regard to section 1504(b)(3)) the election is made for all other controlled foreign corporations of the group created or organized under the laws of the same country";
}
pub relation same_country_exception_disregarded_952c1Bvii(cfc: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 953(a) is applied without regard to the same country exception for the corporation: the election is made and, in an affiliated group, is made for all same-country members";
}
@source(IRC_S952_C, relation = formalizes, coverage = exact, quote = "An election may be made under this clause to have section 953(a) applied for purposes of this title without")
rule S952C1BviiElectionWithGroupConsistency defeasible {
    for cfc: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when elects_953a_without_same_country_exception_952c1Bvii(cfc, y)
     and all_same_country_group_members_elect_952c1Bviiii(cfc, y);
    then same_country_exception_disregarded_952c1Bvii(cfc, y);
}
