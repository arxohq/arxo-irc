// Subpart D (possessions of the United States): §931 (Guam, American Samoa,
// the Northern Mariana Islands), §932 (coordination with the Virgin Islands),
// §933 (Puerto Rico), §934 (limitation on reduction of Virgin Islands
// liability), §937 (bona fide resident; source rules; reporting). §934A,
// §935 and §936 carry no operative text in the pinned edition (repealed).
// Stage 2c (IRC-10 stage 2c, A13).
//
// The §937(a) definition is imported by name from module 13 where module 13
// already models the Puerto Rico bona fide resident concept for §865(g)(3);
// this module states the general definition once, for all named possessions.

// --- §937(a): bona fide resident --------------------------------------------

use self::{
    IRC_S931_A,
    IRC_S931_B,
    IRC_S932_A,
    IRC_S932_B,
    IRC_S932_C,
    IRC_S932_D,
    IRC_S933,
    IRC_S934_A,
    IRC_S934_B,
    IRC_S937_A,
    IRC_S937_B,
    IRC_S937_C,
    VirginIslandsGovernment,
};

pub relation days_present_in_specified_possession_937a1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, possession: Text, days: Integer) kind empirical {
    label en official "the number of days the person is present in the named possession (Guam, American Samoa, the Northern Mariana Islands, Puerto Rico or the Virgin Islands) during the taxable year, days determined under the principles of section 7701(b)";
}
pub relation tax_home_outside_possession_937a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, possession: Text) kind empirical {
    label en official "the person has a tax home (principles of section 911(d)(3) without regard to its second sentence) outside the possession during the taxable year";
}
pub relation closer_connection_elsewhere_937a2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, possession: Text) kind empirical {
    label en official "the person has a closer connection (principles of section 7701(b)(3)(B)(ii)) to the United States or a foreign country than to the possession";
}
pub relation bona_fide_resident_of_possession_937a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, possession: Text) kind institutional {
    label en official "a bona fide resident of the possession for the taxable year: present at least 183 days, without a tax home outside the possession and without a closer connection to the United States or a foreign country (section 937(a))";
}
@source(IRC_S937_A, relation = formalizes, coverage = exact, quote = "(1) who is present for at least 183 days during the taxable year in Guam, American Samoa, the Northern Mariana Islands, Puerto Rico, or the Virgin Islands, as the case may be, and")
rule S937ABonaFideResident defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for possession: Text;
    for days: Integer;
    when days_present_in_specified_possession_937a1(p, y, possession, days)
     and days >= 183;
    unless tax_home_outside_possession_937a2(p, y, possession)
     and days_present_in_specified_possession_937a1(p, y, possession, days);
    unless closer_connection_elsewhere_937a2(p, y, possession)
     and days_present_in_specified_possession_937a1(p, y, possession, days);
    then bona_fide_resident_of_possession_937a(p, y, possession);
}

// --- §937(b): source rules for possessions -----------------------------------

pub relation income_us_source_or_eci_under_part_i_937b2(item_id: Text) kind empirical {
    label en official "the income is treated as income from sources within the United States or as effectively connected with a United States trade or business";
}
pub relation income_from_possession_sources_by_similar_rules_937b1(item_id: Text, possession: Text) kind empirical {
    label en official "by rules similar to those that determine United States source or effective connection, the income is from sources within the possession, or effectively connected with a trade or business within it";
}
pub relation income_treated_as_possession_source_937b(item_id: Text, possession: Text) kind institutional {
    label en official "the income is treated as from sources within the possession or effectively connected with a business there: rules similar to the US source rules apply, but income treated as US-source or US-effectively-connected is never possession income (section 937(b))";
}
@source(IRC_S937_B, relation = formalizes, coverage = exact, quote = "(1) except as provided in paragraph (2), rules similar to the rules for determining whether income is income from sources within the United States or is effectively connected with the conduct of a trade or business within the United States shall apply for purposes of determining whether income is from sources within a possession specified in subsection (a)(1) or effectively connected with the conduct of a trade or business within any such possession, and")
rule S937B1PossessionSourceBySimilarRules defeasible {
    for item_id: Text;
    for possession: Text;
    when income_from_possession_sources_by_similar_rules_937b1(item_id, possession);
    unless income_us_source_or_eci_under_part_i_937b2(item_id)
     and income_from_possession_sources_by_similar_rules_937b1(item_id, possession);
    then income_treated_as_possession_source_937b(item_id, possession);
}
pub relation individual_takes_position_became_or_ceased_bona_fide_resident_937c1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "for the taxable year, the individual takes the position for US income tax reporting purposes that the individual became, or ceases to be, a bona fide resident of a specified possession";
}
pub relation notice_of_possession_residence_position_filed_937c1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual has filed with the Secretary, at the time and in the manner prescribed, notice of the position";
}
@source(IRC_S937_C, relation = formalizes, coverage = exact, quote = "such individual shall file with the Secretary, at such time and in such manner as the Secretary may prescribe, notice of such position.")
rule S937C1DutyToFileNoticeOfPosition defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when individual_takes_position_became_or_ceased_bona_fide_resident_937c1(p, y);
    then duty S937C1NoticeOfPositionDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition notice_of_possession_residence_position_filed_937c1(p, y);
            window [-infinity, infinity];
        }
    };
}

// --- §931: Guam, American Samoa, the Northern Mariana Islands ---------------

pub relation specified_possession_931c(possession: Text) kind institutional {
    label en official "the possession is a specified possession for section 931: Guam, American Samoa, or the Northern Mariana Islands (section 931(c))";
}
rule S931CGuam defeasible {
    when true;
    then specified_possession_931c("Guam");
}
rule S931CAmericanSamoa defeasible {
    when true;
    then specified_possession_931c("American Samoa");
}
rule S931CNorthernMarianaIslands defeasible {
    when true;
    then specified_possession_931c("Northern Mariana Islands");
}
pub relation income_from_specified_possession_sources_931a1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, possession: Text, amount: Money) kind empirical {
    label en official "income derived from sources within the specified possession (section 937(b) rules)";
}
pub relation income_eci_in_specified_possession_931a2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, possession: Text, amount: Money) kind empirical {
    label en official "income effectively connected with the conduct of a trade or business by the individual within the specified possession";
}
pub relation amounts_paid_for_us_government_employee_services_931d(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, possession: Text, amount: Money) kind empirical {
    label en official "amounts paid for services performed as an employee of the United States or any agency thereof, treated as not described in section 931(a)(1) or (2)";
}
pub relation section_931_excluded_income(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, possession: Text, amount: Money) kind institutional {
    label en official "the amount excluded from gross income under section 931(a): possession-source and possession-effectively-connected income of a bona fide resident of the specified possession for the entire taxable year, other than United States government employee pay (section 931(a), (d))";
}
@source(IRC_S931_A, relation = formalizes, coverage = exact, quote = "In the case of an individual who is a bona fide resident of a specified possession during the entire taxable year, gross income shall not include—")
rule S931AExclusionSourceIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for possession: Text;
    for amount: Money;
    when bona_fide_resident_of_possession_937a(p, y, possession)
     and specified_possession_931c(possession)
     and income_from_specified_possession_sources_931a1(p, y, possession, amount);
    unless amounts_paid_for_us_government_employee_services_931d(p, y, possession, amount)
     and income_from_specified_possession_sources_931a1(p, y, possession, amount);
    then section_931_excluded_income(p, y, possession, amount);
}
@source(IRC_S931_A, relation = formalizes, coverage = exact, quote = "(2) income effectively connected with the conduct of a trade or business by such individual within any specified possession.")
rule S931AExclusionEciIncome defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for possession: Text;
    for amount: Money;
    when bona_fide_resident_of_possession_937a(p, y, possession)
     and specified_possession_931c(possession)
     and income_eci_in_specified_possession_931a2(p, y, possession, amount);
    unless amounts_paid_for_us_government_employee_services_931d(p, y, possession, amount)
     and income_eci_in_specified_possession_931a2(p, y, possession, amount);
    then section_931_excluded_income(p, y, possession, amount);
}
pub relation deduction_or_credit_allocable_to_excluded_amounts_931b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, is_personal_exemption: Text) kind empirical {
    label en official "a deduction (other than the section 151 personal-exemption deduction) or a credit properly allocable or chargeable against amounts excluded under section 931; the flag is `exemption` for a section 151 deduction and `other` otherwise";
}
pub relation deduction_or_credit_disallowed_931b(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the deduction or credit is not allowed: it is properly allocable or chargeable against amounts excluded under section 931 (section 931(b)); the section 151 personal exemption is not caught";
}
@source(IRC_S931_B, relation = formalizes, coverage = exact, quote = "properly allocable or chargeable against amounts excluded from gross income under this section.")
rule S931BAllocableDeductionOrCreditNotAllowed defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when deduction_or_credit_allocable_to_excluded_amounts_931b(p, y, item_id, "other");
    then deduction_or_credit_disallowed_931b(p, y, item_id);
}

// --- §932: coordination with the Virgin Islands -------------------------------

pub relation citizen_or_resident_of_us_not_bona_fide_vi_resident_932a1Ai(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is a citizen or resident of the United States, other than a bona fide resident of the Virgin Islands during the entire taxable year";
}
pub relation income_from_vi_sources_or_eci_932a1Aii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual has income derived from sources within the Virgin Islands, or effectively connected with a trade or business there, for the taxable year";
}
pub relation files_joint_return_with_described_individual_932(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, spouse: us.irc.core::Individual) kind empirical {
    label en official "the individual files a joint return for the taxable year with the spouse";
}
pub relation section_932a_direct(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 932(a)(1)(A) applies to the individual directly: a citizen or resident with Virgin Islands income (the base of the joint-return extension of (B))";
}
pub relation section_932a_applies(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 932(a) (treatment of United States residents) applies to the individual for the year";
}
@source(IRC_S932_A, relation = formalizes, coverage = exact, quote = "(i) is a citizen or resident of the United States (other than a bona fide resident of the Virgin Islands during the entire taxable year), and")
rule S932A1ADirectApplication defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when citizen_or_resident_of_us_not_bona_fide_vi_resident_932a1Ai(p, y)
     and income_from_vi_sources_or_eci_932a1Aii(p, y);
    then section_932a_direct(p, y);
}
rule S932A1ADirectIsApplication defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_932a_direct(p, y);
    then section_932a_applies(p, y);
}
@source(IRC_S932_A, relation = formalizes, coverage = exact, quote = "(B) such individual files a joint return for the taxable year with an individual described in subparagraph (A).")
rule S932A1BJointReturnApplication defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for spouse: us.irc.core::Individual;
    when files_joint_return_with_described_individual_932(p, y, spouse)
     and section_932a_direct(spouse, y);
    then section_932a_applies(p, y);
}
pub relation filed_return_with_united_states_932a2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual filed the income tax return for the year with the United States";
}
pub relation filed_return_with_virgin_islands_932(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual filed the income tax return for the year with the Virgin Islands";
}
@source(IRC_S932_A, relation = formalizes, coverage = exact, quote = "Each individual to whom this subsection applies for the taxable year shall file his income tax return for the taxable year with both the United States and the Virgin Islands.")
rule S932A2DutyToFileWithUnitedStates defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_932a_applies(p, y);
    then duty S932A2FileWithUnitedStatesDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition filed_return_with_united_states_932a2(p, y);
            window [-infinity, infinity];
        }
    };
}
rule S932A2DutyToFileWithVirginIslands defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_932a_applies(p, y);
    then duty S932A2FileWithVirginIslandsDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition filed_return_with_virgin_islands_932(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation virgin_islands_agi_932b2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "adjusted gross income determined by taking into account only income derived from sources within the Virgin Islands and deductions properly apportioned or allocable thereto";
}
pub relation adjusted_gross_income_932b2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "adjusted gross income";
}
pub relation united_states_tax_before_932b3_credit(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxes imposed by chapter 1 for the taxable year, determined without regard to paragraph (3) (the section 932(b)(3) credit)";
}
pub relation applicable_percentage_932b2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, ratio: Decimal) kind institutional {
    label en official "the applicable percentage: Virgin Islands adjusted gross income divided by adjusted gross income (section 932(b)(2)(A))";
}
@source(IRC_S932_B, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"applicable percentage\" means the percentage which Virgin Islands adjusted gross income bears to adjusted gross income.")
rule S932B2AApplicablePercentage defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for vi_agi: Money;
    for agi: Money;
    when virgin_islands_agi_932b2B(p, y, vi_agi)
     and adjusted_gross_income_932b2A(p, y, agi)
     and agi > 0.00 USD;
    then applicable_percentage_932b2(p, y, vi_agi / agi);
}
pub relation tax_payable_to_virgin_islands_932b1(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion of the US tax liability payable to the Virgin Islands: the applicable percentage of the taxes imposed by chapter 1 (determined without regard to paragraph (3)) (section 932(b)(1))";
}
@source(IRC_S932_B, relation = formalizes, coverage = exact, quote = "Each individual to whom subsection (a) applies for the taxable year shall pay the applicable percentage of the taxes imposed by this chapter for such taxable year (determined without regard to paragraph (3)) to the Virgin Islands.")
rule S932B1TaxPayableToVirginIslands defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    for tax: Money;
    when section_932a_applies(p, y)
     and applicable_percentage_932b2(p, y, pct)
     and united_states_tax_before_932b3_credit(p, y, tax);
    then tax_payable_to_virgin_islands_932b1(p, y, round(tax * pct, 2, "HALF_UP"));
}
pub relation amount_paid_to_virgin_islands_932b3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the taxes required to be paid to the Virgin Islands under section 932(b)(1) that are so paid";
}
pub relation credit_for_taxes_paid_to_virgin_islands_932b3(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the credit against the chapter 1 tax equal to the taxes required to be paid to the Virgin Islands under paragraph (1) which are so paid (section 932(b)(3))";
}
@source(IRC_S932_B, relation = formalizes, coverage = exact, quote = "There shall be allowed as a credit against the tax imposed by this chapter for the taxable year an amount equal to the taxes required to be paid to the Virgin Islands under paragraph (1) which are so paid.")
rule S932B3CreditForPaidTaxes defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for required: Money;
    for paid: Money;
    when tax_payable_to_virgin_islands_932b1(p, y, required)
     and amount_paid_to_virgin_islands_932b3(p, y, paid);
    then credit_for_taxes_paid_to_virgin_islands_932b3(p, y, min(required, paid));
}
pub relation bona_fide_vi_resident_entire_year_932c1A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual is a bona fide resident of the Virgin Islands during the entire taxable year";
}
pub relation section_932c_applies(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "section 932(c) (treatment of Virgin Islands residents) applies to the individual for the year";
}
@source(IRC_S932_C, relation = formalizes, coverage = exact, quote = "(A) such individual is a bona fide resident of the Virgin Islands during the entire taxable year, or")
rule S932C1ADirectApplication defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when bona_fide_vi_resident_entire_year_932c1A(p, y);
    then section_932c_applies(p, y);
}
@source(IRC_S932_C, relation = formalizes, coverage = exact, quote = "(B) such individual files a joint return for the taxable year with an individual described in subparagraph (A).")
rule S932C1BJointReturnApplication defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for spouse: us.irc.core::Individual;
    when files_joint_return_with_described_individual_932(p, y, spouse)
     and bona_fide_vi_resident_entire_year_932c1A(spouse, y);
    then section_932c_applies(p, y);
}
@source(IRC_S932_C, relation = formalizes, coverage = exact, quote = "Each individual to whom this subsection applies for the taxable year shall file an income tax return for the taxable year with the Virgin Islands.")
rule S932C2DutyToFileWithVirginIslands defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when section_932c_applies(p, y);
    then duty S932C2FileWithVirginIslandsDuty {
        bearer p;
        beneficiary us.irc.core::IRS;
        goal achievement {
            condition filed_return_with_virgin_islands_932(p, y);
            window [-infinity, infinity];
        }
    };
}
pub relation reports_income_from_all_sources_with_sources_identified_932c4B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "on the return to the Virgin Islands the individual reports income from all sources and identifies the source of each item";
}
pub relation fully_pays_section_934a_liability_932c4C(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the individual fully pays the tax liability referred to in section 934(a) to the Virgin Islands with respect to that income";
}
pub relation amount_included_on_virgin_islands_return_932c4(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount included in gross income on the Virgin Islands return";
}
pub relation amount_excluded_from_us_gross_income_932c4(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "for calculating income tax liability to the United States, gross income does not include any amount included in gross income on the Virgin Islands return, with the allocable deductions and credits disregarded (section 932(c)(4))";
}
@source(IRC_S932_C, relation = formalizes, coverage = exact, quote = "for purposes of calculating income tax liability to the United States, gross income shall not include any amount included in gross income on such return, and allocable deductions and credits shall not be taken into account.")
rule S932C4ExclusionForFullyReportingResident defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when bona_fide_vi_resident_entire_year_932c1A(p, y)
     and reports_income_from_all_sources_with_sources_identified_932c4B(p, y)
     and fully_pays_section_934a_liability_932c4C(p, y)
     and amount_included_on_virgin_islands_return_932c4(p, y, amount);
    then amount_excluded_from_us_gross_income_932c4(p, y, amount);
}
pub relation spouse_agi_932d(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, agi: Money) kind empirical {
    label en official "the adjusted gross income of the spouse, determined without regard to community property laws";
}
pub relation residence_governing_joint_return_932d(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, governing: us.irc.core::Individual) kind institutional {
    label en official "on a joint return this section is applied on the basis of the residence of the spouse with the greater adjusted gross income (section 932(d))";
}
@source(IRC_S932_D, relation = formalizes, coverage = exact, quote = "In the case of a joint return, this section shall be applied on the basis of the residence of the spouse who has the greater adjusted gross income (determined without regard to community property laws) for the taxable year.")
rule S932DGreaterAgiSpouseGovernsFirst defeasible {
    for a: us.irc.core::Individual;
    for b: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for agi_a: Money;
    for agi_b: Money;
    when files_joint_return_with_described_individual_932(a, y, b)
     and spouse_agi_932d(a, y, agi_a)
     and spouse_agi_932d(b, y, agi_b)
     and agi_a > agi_b;
    then residence_governing_joint_return_932d(a, y, a);
}
rule S932DGreaterAgiSpouseGovernsSecond defeasible {
    for a: us.irc.core::Individual;
    for b: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for agi_a: Money;
    for agi_b: Money;
    when files_joint_return_with_described_individual_932(a, y, b)
     and spouse_agi_932d(a, y, agi_a)
     and spouse_agi_932d(b, y, agi_b)
     and agi_b > agi_a;
    then residence_governing_joint_return_932d(a, y, b);
}

// --- §933: Puerto Rico --------------------------------------------------------

pub relation income_from_puerto_rico_sources_933(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income derived from sources within Puerto Rico";
}
pub relation amounts_received_as_us_government_employee_933(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "amounts received for services performed as an employee of the United States or any agency thereof";
}
pub relation section_933_exclusion(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the Puerto Rico source income excluded from gross income and exempt from taxation under this subtitle (section 933(1)-(2))";
}
@source(IRC_S933, relation = formalizes, coverage = partial, quote = "In the case of an individual who is a bona fide resident of Puerto Rico during the entire taxable year, income derived from sources within Puerto Rico (except amounts received for services performed as an employee of the United States or any agency thereof)")
rule S9331ExclusionEntireYearResident defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when bona_fide_resident_of_possession_937a(p, y, "Puerto Rico")
     and income_from_puerto_rico_sources_933(p, y, amount);
    unless amounts_received_as_us_government_employee_933(p, y, amount)
     and income_from_puerto_rico_sources_933(p, y, amount);
    then section_933_exclusion(p, y, amount);
}
pub relation us_citizen_bona_fide_pr_resident_at_least_2_years_before_change_933_2(p: us.irc.core::Individual, change_of_residence_on: Date) kind empirical {
    label en official "an individual citizen of the United States who has been a bona fide resident of Puerto Rico for a period of at least 2 years before the date on which the individual changes residence from Puerto Rico";
}
pub relation income_attributable_to_pr_residence_period_before_change_933_2(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "income derived from sources within Puerto Rico attributable to that part of the period of Puerto Rican residence before the change-of-residence date";
}
@source(IRC_S933, relation = formalizes, coverage = partial, quote = "In the case of an individual citizen of the United States who has been a bona fide resident of Puerto Rico for a period of at least 2 years before the date on which he changes his residence from Puerto Rico, income derived from sources therein (except amounts received for services performed as an employee of the United States or any agency thereof) which is attributable to that part of such period of Puerto Rican residence before such date")
rule S9332ExclusionYearOfChange defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for change_on: Date;
    when us_citizen_bona_fide_pr_resident_at_least_2_years_before_change_933_2(p, change_on)
     and income_attributable_to_pr_residence_period_before_change_933_2(p, y, amount);
    unless amounts_received_as_us_government_employee_933(p, y, amount)
     and income_attributable_to_pr_residence_period_before_change_933_2(p, y, amount);
    then section_933_exclusion(p, y, amount);
}
pub relation deduction_or_credit_allocable_to_pr_excluded_income_933(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text, kind: Text) kind empirical {
    label en official "a deduction or credit properly allocable to or chargeable against amounts excluded under section 933; kind is `exemption` for a section 151 deduction, `other` otherwise";
}
pub relation deduction_or_credit_disallowed_933(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the deduction or credit allocable to excluded Puerto Rico income is not allowed, save the personal exemption (section 933(1)-(2))";
}
rule S933AllocableDeductionOrCreditNotAllowed defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when deduction_or_credit_allocable_to_pr_excluded_income_933(p, y, item_id, "other");
    then deduction_or_credit_disallowed_933(p, y, item_id);
}

// --- §934: limitation on reduction of Virgin Islands liability ---------------

pub relation virgin_islands_tax_liability_under_us_code_934a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "tax liability incurred to the Virgin Islands pursuant to this subtitle as made applicable there by the 1921 Act (48 U.S.C. 1397) or section 28(a) of the Revised Organic Act (48 U.S.C. 1642)";
}
pub relation liability_attributable_to_vi_source_or_eci_income_934b1(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the liability attributable to income derived from sources within the Virgin Islands or effectively connected with a trade or business within the Virgin Islands";
}
pub relation liability_payable_under_932b_934b2(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the liability is payable to the Virgin Islands under section 932(b) by a citizen or resident of the United States";
}
pub relation qualified_foreign_corporation_ownership_934b3B(corp: us.irc.core::Corporation, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage of the total voting power, and of the total value, of the foreign corporation owned or treated as owned (section 958) by one or more United States persons";
}
pub relation qualified_foreign_corporation_934b3B(corp: us.irc.core::Corporation) kind institutional {
    label en official "a qualified foreign corporation: a foreign corporation of which less than 10 percent of the total voting power, and less than 10 percent of the total value, is owned or treated as owned by United States persons (section 934(b)(3)(B))";
}
@source(IRC_S934_B, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), the term \"qualified foreign corporation\" means any foreign corporation if less than 10 percent of—")
rule S934B3BQualifiedForeignCorporation defeasible {
    for corp: us.irc.core::Corporation;
    for vote: Decimal;
    for value: Decimal;
    when qualified_foreign_corporation_ownership_934b3B(corp, vote, value)
     and vote < 10.0
     and value < 10.0;
    then qualified_foreign_corporation_934b3B(corp);
}
pub relation liability_attributable_to_non_us_income_of_qualified_foreign_corp_934b3A(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the liability attributable to income derived from sources outside the United States which is not effectively connected with a United States trade or business";
}
pub relation vi_liability_reducible_by_vi_law_934(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount of Virgin Islands liability that Virgin Islands law may reduce or remit: the liability attributable to Virgin Islands source or effectively connected income other than liability payable under section 932(b), and the non-US income liability of a qualified foreign corporation (section 934(b)(1)-(3)); the rest may not be reduced or remitted by any Virgin Islands law, grant or subsidy (section 934(a))";
}
@source(IRC_S934_B, relation = formalizes, coverage = exact, quote = "Except as provided in paragraph (2), subsection (a) shall not apply with respect to so much of the tax liability referred to in subsection (a) as is attributable to income derived from sources within the Virgin Islands or income effectively connected with the conduct of a trade or business within the Virgin Islands.")
rule S934B1ReducibleViSourceLiability defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when virgin_islands_tax_liability_under_us_code_934a(p, y, _)
     and liability_attributable_to_vi_source_or_eci_income_934b1(p, y, amount);
    unless liability_payable_under_932b_934b2(p, y)
     and liability_attributable_to_vi_source_or_eci_income_934b1(p, y, amount);
    then vi_liability_reducible_by_vi_law_934(p, y, amount);
}
@source(IRC_S934_B, relation = formalizes, coverage = exact, quote = "In the case of a qualified foreign corporation, subsection (a) shall not apply with respect to so much of the tax liability referred to in subsection (a) as is attributable to income which is derived from sources outside the United States and which is not effectively connected with the conduct of a trade or business within the United States.")
rule S934B3AQualifiedForeignCorporationNonUsIncome defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when qualified_foreign_corporation_934b3B(corp)
     and liability_attributable_to_non_us_income_of_qualified_foreign_corp_934b3A(corp, y, amount);
    then vi_liability_reducible_by_vi_law_934(corp, y, amount);
}
pub relation vi_law_reduces_or_remits_liability_934a(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "a law enacted in the Virgin Islands reduces or remits, directly or indirectly (grant, subsidy or similar payment), the amount of the liability";
}
@source(IRC_S934_A, relation = formalizes, coverage = exact, quote = "shall not be reduced or remitted in any way, directly or indirectly, whether by grant, subsidy, or other similar payment, by any law enacted in the Virgin Islands, except to the extent provided in subsection (b).")
rule S934AProhibitionOfViReduction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when vi_law_reduces_or_remits_liability_934a(p, y, amount);
    then prohibition S934AViLawMayNotReduceLiabilityProhibition {
        bearer VirginIslandsGovernment;
        action vi_law_reduces_or_remits_liability_934a(p, y, amount);
        window [-infinity, infinity];
    };
}
