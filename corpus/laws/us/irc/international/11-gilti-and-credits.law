// §951A(a)-(c) — GILTI (net CFC tested income minus net deemed tangible
// income return), with a PL 119-21 second edition (§70323: renamed "net CFC
// tested income", QBAI/NDTIR subtraction REPEALED, for taxable years of
// foreign corporations beginning after December 31, 2025); §960(a),(d) —
// deemed paid credit for subpart F/GILTI inclusions, with the PL 119-21
// 80%->90% rate change (§70312, same taxable-year boundary); §962 — the
// individual's election to be taxed at corporate rates, as a `power`.
// Stage 1b (IRC-10 stage 1b, A13).
//
// EDITION BOUNDARY MODELING: `us.irc.temporal`'s PL119_21_EDITION fragments
// (PL119_21_S70312, PL119_21_S70323, PL119_21_S70331) confirm the exact
// amendments and the "taxable years beginning after December 31, 2025"
// effective date shared by all three. This module does NOT build a formal
// `revision` node (grammar §32; AGENT-BRIEF.md flags `revision`+`op`
// requiring a `next` edition as heavier machinery, LDC-E1305) — it uses
// effective-windowed rule PAIRS gated on the CFC's own taxable-year begin
// date compared to the literal boundary `@2025-12-31`, per AGENT-BRIEF.md's
// fallback instruction ("if you fall back to windows, say why"). The boundary
// is read off the CFC's `TaxableYear` (via `us.irc.core::begins`), matching
// the amendments' own "taxable years of foreign corporations beginning
// after December 31, 2025" language for both §951A and §960(d); §59A's
// analogous "taxable years beginning after December 31, 2025" (no foreign-
// corporation qualifier — it is the taxpayer's own year) is handled the same
// way in module 09.

use self::{
    IRC_S951A_A,
    IRC_S951A_B,
    IRC_S951A_C,
    IRC_S960_A,
    IRC_S960_D,
    IRC_S962_A,
    IRC_S962_B,
    subpart_f_inclusion,
};

pub relation cfc_taxable_year_begins_after_20251231(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the controlled foreign corporation's taxable year y begins after December 31, 2025 — the PL 119-21 (§70312/§70323) edition boundary";
}
rule CfcYearBeginsAfterPl11921Boundary strict {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when us.irc.core::year_of(corp, y)
     and us.irc.core::begins(y, d)
     and d > @2025-12-31;
    then cfc_taxable_year_begins_after_20251231(corp, y);
}

// A shareholder-level (or domestic-corporation-level) analogue of the same
// boundary, keyed only to the TaxableYear itself rather than to one specific
// CFC: the GILTI inclusion and the section 960(d) credit are computed at the
// SHAREHOLDER's aggregate level across ALL its CFCs, so a single-CFC-keyed
// boundary does not fit those two rules (this stage's modeling
// simplification — a shareholder with CFCs straddling the boundary in
// different CFC taxable years is not disambiguated further).
pub relation taxable_year_begins_after_20251231(y: us.irc.core::TaxableYear) kind institutional {
    label en official "the taxable year y begins after December 31, 2025 — the PL 119-21 edition boundary, applied at the shareholder/domestic-corporation level for the GILTI inclusion (section 951A(a)) and the section 960(d) credit";
}
rule YearBeginsAfterPl11921Boundary strict {
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when us.irc.core::begins(y, d)
     and d > @2025-12-31;
    then taxable_year_begins_after_20251231(y);
}

// --- §951A(c) [pre-2026] / (b) [post-2026]: net CFC tested income ----------

pub relation tested_income_of_cfc(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the corporation's tested income for its taxable year (section 951A(c)(2)(A)/(b)(2)(A) as redesignated) — the gross-income-minus-allocable-deductions computation itself is not modeled this stage (TECH_GAP), asserted as a case input";
}
pub relation tested_loss_of_cfc(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en unofficial "the corporation's tested loss for its taxable year, for the section 951A(c)(1)(B)/(b)(1)(B) aggregate";
}
pub relation shareholder_pro_rata_share_of_tested_income(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en unofficial "the shareholder's pro rata share (section 951A(e)(1), determined under section 951(a)(2) rules) of the CFC's tested income for the year — asserted directly rather than re-deriving section 951(a)(2)'s day-ratio formula a second time for a DIFFERENT base (tested income rather than subpart F income)";
}
pub relation shareholder_pro_rata_share_of_tested_loss(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en unofficial "the shareholder's pro rata share (section 951A(e)(1)) of the CFC's tested loss for the year";
}

@source(IRC_S951A_C, relation = formalizes, coverage = partial, quote = "the aggregate of such shareholder's pro rata share of the tested income of each controlled foreign corporation with respect to which such shareholder is a United States shareholder for such taxable year of such United States shareholder")
pub relation net_cfc_tested_income(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder's net CFC tested income for the year (section 951A(c)(1) pre-2026 / (b)(1) post-2026 as redesignated): aggregate pro rata tested income minus aggregate pro rata tested loss, across all CFCs";
}
rule S951ACNetCfcTestedIncomeSingleCfc defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for income_share: Money;
    for loss_share: Money;
    when shareholder_pro_rata_share_of_tested_income(shareholder, corp, y, income_share)
     and shareholder_pro_rata_share_of_tested_loss(shareholder, corp, y, loss_share);
    then net_cfc_tested_income(shareholder, y, income_share - loss_share);
}
rule S951ACNetCfcTestedIncomeNoLoss defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for income_share: Money;
    when shareholder_pro_rata_share_of_tested_income(shareholder, corp, y, income_share);
    unless shareholder_pro_rata_share_of_tested_loss(shareholder, corp, y, _)
     and shareholder_pro_rata_share_of_tested_income(shareholder, corp, y, income_share);
    then net_cfc_tested_income(shareholder, y, income_share);
}

// --- §951A(b) [pre-2026]: net deemed tangible income return (QBAI-based) ---
//
// REPEALED for taxable years of foreign corporations beginning after
// December 31, 2025 (PL 119-21 §70323(a)(2)): §951A(b)/(d) are struck, and
// the GILTI/net-CFC-tested-income inclusion becomes net_cfc_tested_income
// directly (no NDTIR subtraction). This module therefore gates the NDTIR
// subtraction itself on the PRE-2026 edition.

pub relation shareholder_pro_rata_share_of_qbai(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the shareholder's pro rata share of the CFC's qualified business asset investment (section 951A(d), pre-2026 edition) — the quarterly-average-adjusted-basis computation itself is not modeled this stage (TECH_GAP), asserted as a case input";
}
pub relation ndtir_interest_expense(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the interest expense taken into account under section 951A(c)(2)(A)(ii) [pre-2026] in determining net CFC tested income, to the extent the corresponding interest income was not so taken into account — section 951A(b)(2)(B), pre-2026 edition";
}

@source(IRC_S951A_B, relation = formalizes, coverage = partial, quote = "10 percent of the aggregate of such shareholder's pro rata share of the qualified business asset investment of each controlled foreign corporation with respect to which such shareholder is a United States shareholder for such taxable year")
pub relation net_deemed_tangible_income_return(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the shareholder's net deemed tangible income return for the year (section 951A(b), PRE-2026 EDITION ONLY): 10% of aggregate pro rata QBAI, minus the specified interest expense";
}
rule S951ABNetDeemedTangibleIncomeReturnPre2026 defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for qbai_share: Money;
    for interest_expense: Money;
    when shareholder_pro_rata_share_of_qbai(shareholder, corp, y, qbai_share)
     and ndtir_interest_expense(shareholder, y, interest_expense);
    unless cfc_taxable_year_begins_after_20251231(corp, y)
     and shareholder_pro_rata_share_of_qbai(shareholder, corp, y, qbai_share)
     and ndtir_interest_expense(shareholder, y, interest_expense);
    then net_deemed_tangible_income_return(shareholder, y, (qbai_share * 0.10) - interest_expense);
}

// --- §951A(a): the GILTI inclusion itself, both editions -------------------

@source(IRC_S951A_A, relation = formalizes, coverage = exact, quote = "Each person who is a United States shareholder of any controlled foreign corporation for any taxable year of such United States shareholder shall include in gross income such shareholder's global intangible low-taxed income for such taxable year.")
pub relation gilti_inclusion(shareholder: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the United States shareholder's section 951A(a) gross income inclusion: net CFC tested income minus net deemed tangible income return (pre-2026 edition), or net CFC tested income alone (PL 119-21 edition, taxable years of foreign corporations beginning after December 31, 2025 — section 70323 repeals the QBAI/NDTIR subtraction and effectively renames the inclusion 'net CFC tested income')";
}
// pre-2026 edition: excess of net CFC tested income over NDTIR (floor at
// zero — the statute's own "excess (if any)" language).
rule S951AGiltiInclusionPre2026 defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    for ndtir: Money;
    when net_cfc_tested_income(shareholder, y, tested)
     and net_deemed_tangible_income_return(shareholder, y, ndtir);
    unless taxable_year_begins_after_20251231(y)
     and net_cfc_tested_income(shareholder, y, tested)
     and net_deemed_tangible_income_return(shareholder, y, ndtir);
    then gilti_inclusion(shareholder, y, max(0.00 USD, tested - ndtir));
}
// post-2026 (PL 119-21) edition: the inclusion IS net CFC tested income,
// with no NDTIR subtraction (§951A(b)/(d) repealed by §70323(a)(2)).
rule S951AGiltiInclusionPost2026 defeasible {
    for shareholder: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    when net_cfc_tested_income(shareholder, y, tested)
     and taxable_year_begins_after_20251231(y);
    then gilti_inclusion(shareholder, y, tested);
}

// --- §960(a): deemed paid credit for subpart F inclusions ------------------

pub relation cfc_foreign_income_taxes_attributable(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en unofficial "the CFC's foreign income taxes properly attributable to a specific item of section 951(a)(1) income included by the domestic corporation, for section 960(a)";
}
@source(IRC_S960_A, relation = formalizes, coverage = exact, quote = "such domestic corporation shall be deemed to have paid so much of such foreign corporation's foreign income taxes as are properly attributable to such item of income")
pub relation deemed_paid_credit_960a(domestic_corp: us.irc.core::Corporation, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind institutional {
    label en official "the domestic corporation is deemed to have paid the foreign income tax properly attributable to a section 951(a)(1) item it includes with respect to this controlled foreign corporation (section 960(a))";
}
rule S960ADeemedPaidCredit defeasible {
    for domestic_corp: us.irc.core::Corporation;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    when subpart_f_inclusion(domestic_corp, corp, y, _)
     and cfc_foreign_income_taxes_attributable(corp, y, item_id, amount);
    then deemed_paid_credit_960a(domestic_corp, corp, y, item_id, amount);
}

// --- §960(d): deemed paid credit for GILTI, 80%/90% dual edition -----------

pub relation inclusion_percentage_960d(domestic_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, percentage: Decimal) kind empirical {
    label en official "the domestic corporation's section 960(d)(2) inclusion percentage: GILTI (or net CFC tested income) divided by the aggregate section 951A(c)(1)(A)/(b)(1)(A) amount — asserted directly, the ratio's own numerator/denominator wiring is not re-derived here";
}
pub relation aggregate_tested_foreign_income_taxes(domestic_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the aggregate tested foreign income taxes paid or accrued by the domestic corporation's CFCs, properly attributable to the tested income taken into account under section 951A — section 960(d)(3)";
}

pub relation deemed_paid_credit_960d(domestic_corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the domestic corporation's section 960(d) deemed paid credit for GILTI/net-CFC-tested-income inclusions: 80% (pre-2026) or 90% (PL 119-21, taxable years of foreign corporations beginning after December 31, 2025) of inclusion percentage times aggregate tested foreign income taxes";
}
@source(IRC_S960_D, relation = formalizes, coverage = exact, quote = "such domestic corporation shall be deemed to have paid foreign income taxes equal to 80 percent of the product of—")
rule S960DDeemedPaidCreditPre2026 defeasible {
    for domestic_corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    for taxes: Money;
    when inclusion_percentage_960d(domestic_corp, y, pct)
     and aggregate_tested_foreign_income_taxes(domestic_corp, y, taxes);
    unless taxable_year_begins_after_20251231(y)
     and inclusion_percentage_960d(domestic_corp, y, pct)
     and aggregate_tested_foreign_income_taxes(domestic_corp, y, taxes);
    then deemed_paid_credit_960d(domestic_corp, y, taxes * pct * 0.80);
}
@source(us.irc.temporal::PL119_21_S70312, relation = derives_from, quote = "Section 960(d)(1) is amended by striking “80 percent” and inserting “90 percent”.")
rule S960DDeemedPaidCreditPost2026 defeasible {
    for domestic_corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for pct: Decimal;
    for taxes: Money;
    when inclusion_percentage_960d(domestic_corp, y, pct)
     and aggregate_tested_foreign_income_taxes(domestic_corp, y, taxes)
     and taxable_year_begins_after_20251231(y);
    then deemed_paid_credit_960d(domestic_corp, y, taxes * pct * 0.90);
}

// --- §962: individual's election to be taxed at corporate rates -----------

pub relation elects_962(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the United States shareholder (an individual) elects to have section 962 apply for the taxable year, made at the time and manner the Secretary prescribes (section 962(b))";
}
pub relation revoked_962_without_secretary_consent(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the shareholder attempts to revoke a section 962 election for the year without the Secretary's consent — section 962(b)'s bar on unilateral revocation";
}
pub relation section_11_tax_if_domestic_corp(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the tax which would be imposed under section 11 if the shareholder's section 951(a)/951A inclusions had been received by a domestic corporation — EXTERNAL_DEPENDENCY on us.irc.corporations' section 11 computation, asserted directly (see international.deps.json); the (c) bracket-proration refinement is not modeled this stage (TECH_GAP)";
}

pub relation section_962_election_effective(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the section 962 election is in effect for the year: made under (b) and not unilaterally revoked";
}
@source(IRC_S962_B, relation = formalizes, coverage = exact, quote = "An election made for any taxable year may not be revoked except with the consent of the Secretary.")
rule S962ElectionPower defeasible {
    for shareholder: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    when elects_962(shareholder, y);
    unless revoked_962_without_secretary_consent(shareholder, y);
    then power S962Election {
        holder shareholder;
        over shareholder;
        exercise elects_962(shareholder, y);
        valid_when elects_962(shareholder, y);
        effect create(section_962_election_effective(shareholder, y));
    };
}
@source(IRC_S962_A, relation = formalizes, coverage = exact, quote = "the tax imposed under this chapter on amounts which are included in his gross income under section 951(a) shall (in lieu of the tax determined under sections 1 and 55) be an amount equal to the tax which would be imposed under section 11 if such amounts were received by a domestic corporation")
pub relation tax_under_962a1(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "under a section 962 election, the tax on section 951(a)/951A amounts is the section 11 corporate-rate amount instead of the section 1/55 individual rates (section 962(a)(1)) — the (c) per-bracket proration to the shareholder's actual pro rata E&P share is a TECH_GAP simplification: this rule reads the already-prorated section 11 figure as a case input";
}
rule S962ATaxAtCorporateRates strict {
    for shareholder: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when section_962_election_effective(shareholder, y)
     and section_11_tax_if_domestic_corp(shareholder, y, amount);
    then tax_under_962a1(shareholder, y, amount);
}
