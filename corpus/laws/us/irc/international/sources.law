    content_hash "sha256:669d828f2cff445371c30fa6b3049dfb7f163a3187e3d61f6e4cfeea9a6838c0";
}

// 26 U.S.C. 876(a) — Alien residents of Puerto Rico, Guam, American Samoa, or the Northern Mariana Islands
fragment IRC_S876_A in IRC_2024_EDITION {
    kind subsection;
    locator "section/876/a";
    text en official """(a) General rule
This subpart shall not apply to any alien individual who is a bona fide resident of Puerto Rico, Guam, American Samoa, or the Northern Mariana Islands during the entire taxable year and such alien shall be subject to the tax imposed by section 1.""";
    content_hash "sha256:abe6216806b838c3598452533b03dedd1f9c81c5363ea7c331a7faefed4a48de";
}

// 26 U.S.C. 876(b) — Alien residents of Puerto Rico, Guam, American Samoa, or the Northern Mariana Islands
fragment IRC_S876_B in IRC_2024_EDITION {
