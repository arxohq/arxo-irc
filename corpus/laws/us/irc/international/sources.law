For purposes of this section, the term "nonresident alien individual" includes an alien resident of Puerto Rico.""";
    content_hash "sha256:05a2a30df751cf943c2465acbb7caa17109aec20ba9d9924b4ca027a16fc6499";
}

// 26 U.S.C. 1441(f) — Withholding of tax on nonresident aliens
fragment IRC_S1441_F in IRC_2024_EDITION {
