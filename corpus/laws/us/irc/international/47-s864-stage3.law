// Stage 3 (TECH_GAP reduction), module 47: section 864(c)(8)(B), (d)(2), (e)(4)(C), (e)(5)(B), (e)(6), (g). Status
// implemented_unverified: not a legal review; scenarios in tests/s864-stage3.lawtest are written, NOT executed.
//
// Modeling notes.
//  * Allocation directives ("allocated and apportioned as if ...") are modeled as markers carrying the tag of the
//    allocation regime, because the gross-income and deduction ledgers they act on are not derived in this package.
//  * Sums over the assets of a partnership (the deemed sale) are asserted directly (section 111).

// --- §864(c)(8)(B): the deemed-sale amount ---------------------------------------------------------------------------------

use self::{
    IRC_S864_C,
    IRC_S864_D,
    IRC_S864_E,
    IRC_S864_G,
    corporation_described_in_864e5C,
    income_treated_as_interest_864d1,
    nonresident_alien_or_foreign_corp,
    owns_interest_in_partnership_engaged_in_us_business_864c8,
    partnership_interest_sale_gain,
    partnership_interest_sale_loss,
    uspri_gain_treated_as_eci_under_897_864c8C,
};

pub relation partnership_deemed_sale_eci_gain_864c8B(partnership: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the gain on the deemed sale of all the partnership's assets at fair market value on the date of the sale of the interest that would have been effectively connected with the conduct of a trade or business within the United States (an aggregate over assets)";
}
pub relation partnership_deemed_sale_eci_loss_864c8B(partnership: us.irc.core::Person, amount: Money) kind empirical {
    label en official "the loss on that deemed sale that would have been so effectively connected (an aggregate over assets)";
}
pub relation partner_share_of_non_separately_stated_income_864c8B(p: us.irc.core::Person, partnership: us.irc.core::Person, percent: Decimal) kind empirical {
    label en official "the partner's share (percent) of the non-separately stated taxable income or loss of the partnership, the share in which the deemed-sale gain or loss is distributed";
}
pub relation no_deemed_sale_gain_effectively_connected_864c8B(partnership: us.irc.core::Person) kind empirical {
    label en official "no gain on the deemed sale would have been effectively connected";
}
pub relation no_deemed_sale_loss_effectively_connected_864c8B(partnership: us.irc.core::Person) kind empirical {
    label en official "no loss on the deemed sale would have been effectively connected";
}
pub relation deemed_sale_gain_amount_864c8Bi(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "in the case of gain: the partner's distributive share of the deemed-sale gain that would have been effectively connected, or zero if none would have been";
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(I) the portion of the partner's distributive share of the amount of gain which would have been effectively")
rule S864C8BiIPortionOfDistributiveShare defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for gain: Money;
    for percent: Decimal;
    when partnership_deemed_sale_eci_gain_864c8B(partnership, gain)
     and partner_share_of_non_separately_stated_income_864c8B(p, partnership, percent);
    then deemed_sale_gain_amount_864c8Bi(p, partnership, round(gain * (percent / 100.0), 2, "HALF_UP"));
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(II) zero if no gain on such deemed sale would have been so effectively connected, and")
rule S864C8BiIIZeroWhereNoneEffectivelyConnected defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for percent: Decimal;
    when no_deemed_sale_gain_effectively_connected_864c8B(partnership)
     and partner_share_of_non_separately_stated_income_864c8B(p, partnership, percent);
    then deemed_sale_gain_amount_864c8Bi(p, partnership, 0.00 USD);
}
pub relation deemed_sale_loss_amount_864c8Bii(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "in the case of loss: the partner's distributive share of the deemed-sale loss that would have been effectively connected, or zero if none would have been";
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(I) the portion of the partner's distributive share of the amount of loss on the deemed sale described in")
rule S864C8BiiIPortionOfDistributiveShare defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for loss: Money;
    for percent: Decimal;
    when partnership_deemed_sale_eci_loss_864c8B(partnership, loss)
     and partner_share_of_non_separately_stated_income_864c8B(p, partnership, percent);
    then deemed_sale_loss_amount_864c8Bii(p, partnership, round(loss * (percent / 100.0), 2, "HALF_UP"));
}
@source(IRC_S864_C, relation = formalizes, coverage = exact, quote = "(II) zero if no loss on such deemed sale would be have been so effectively connected.")
rule S864C8BiiIIZeroWhereNoneEffectivelyConnected defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for percent: Decimal;
    when no_deemed_sale_loss_effectively_connected_864c8B(partnership)
     and partner_share_of_non_separately_stated_income_864c8B(p, partnership, percent);
    then deemed_sale_loss_amount_864c8Bii(p, partnership, 0.00 USD);
}
// The derived (B) amounts feed the (A) rule in the same way as the asserted ones (module 19 reads the asserted
// `deemed_sale_eci_gain_share_864c8B`); a case gives one of the two inputs, not both.
pub relation partnership_interest_gain_eci_by_derived_deemed_sale_864c8(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "gain on the sale of a partnership interest treated as effectively connected, using the derived (B)(i) deemed-sale amount: the lesser of the gain and that amount, less the section 897 amount";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(i) in the case of any gain on the sale or exchange of the partnership interest, is—")
rule S864C8AGainByDerivedDeemedSale defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for gain: Money;
    for deemed: Money;
    for uspri: Money;
    when nonresident_alien_or_foreign_corp(p)
     and owns_interest_in_partnership_engaged_in_us_business_864c8(p, partnership)
     and partnership_interest_sale_gain(p, partnership, gain)
     and deemed_sale_gain_amount_864c8Bi(p, partnership, deemed)
     and uspri_gain_treated_as_eci_under_897_864c8C(p, partnership, uspri);
    then partnership_interest_gain_eci_by_derived_deemed_sale_864c8(p, partnership, max(0.00 USD, min(gain, deemed) - uspri));
}
pub relation partnership_interest_loss_eci_by_derived_deemed_sale_864c8(p: us.irc.core::Person, partnership: us.irc.core::Person, amount: Money) kind institutional {
    label en official "loss on the sale of a partnership interest treated as effectively connected, using the derived (B)(ii) deemed-sale amount";
}
@source(IRC_S864_C, relation = formalizes, coverage = partial, quote = "(ii) in the case of any loss on the sale or exchange of the partnership interest, is—")
rule S864C8ALossByDerivedDeemedSale defeasible {
    for p: us.irc.core::Person;
    for partnership: us.irc.core::Person;
    for loss: Money;
    for deemed: Money;
    for uspri: Money;
    when nonresident_alien_or_foreign_corp(p)
     and owns_interest_in_partnership_engaged_in_us_business_864c8(p, partnership)
     and partnership_interest_sale_loss(p, partnership, loss)
     and deemed_sale_loss_amount_864c8Bii(p, partnership, deemed)
     and uspri_gain_treated_as_eci_under_897_864c8C(p, partnership, uspri);
    then partnership_interest_loss_eci_by_derived_deemed_sale_864c8(p, partnership, max(0.00 USD, min(loss, deemed) - uspri));
}

// --- §864(d)(2): the provisions to which the interest treatment applies -----------------------------------------------------

pub relation interest_treatment_applies_to_provision_864d2(acquirer: us.irc.core::Person, receivable_id: Text, provision: Text) kind institutional {
    label en official "an amount treated as interest under paragraph (1) is so treated for section 904 (foreign tax credit limitation, provision '904') and for subpart F (provision 'subpart_f')";
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(A) Section 904 (relating to limitation on foreign tax credit).")
rule S864D2ASection904 defeasible {
    for acquirer: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(acquirer, rid, income);
    then interest_treatment_applies_to_provision_864d2(acquirer, rid, "904");
}
@source(IRC_S864_D, relation = formalizes, coverage = exact, quote = "(B) Subpart F of part III of this subchapter (relating to controlled foreign corporations).")
rule S864D2BSubpartF defeasible {
    for acquirer: us.irc.core::Person;
    for rid: Text;
    for income: Money;
    when income_treated_as_interest_864d1(acquirer, rid, income);
    then interest_treatment_applies_to_provision_864d2(acquirer, rid, "subpart_f");
}

// --- §864(e)(4)(C): earnings and profits adjustment through chains of stock -----------------------------------------------

pub relation affiliated_group_voting_percent_of_corporation_864e4Cii(taxpayer_group: Text, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power of all classes of stock entitled to vote of the corporation owned by members of the taxpayer's affiliated group, directly or through the proportional ownership of clause (iii)";
}
pub relation stock_ownership_requirements_met_864e4Cii(taxpayer_group: Text, corp: us.irc.core::Corporation) kind institutional {
    label en official "the members of the taxpayer's affiliated group own 10 percent or more of the total combined voting power of the corporation";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "The stock ownership requirements of this clause are met with respect to any corporation if members of the")
rule S864E4CiiTenPercentOfVotingPower defeasible {
    for taxpayer_group: Text;
    for corp: us.irc.core::Corporation;
    for percent: Decimal;
    when affiliated_group_voting_percent_of_corporation_864e4Cii(taxpayer_group, corp, percent)
     and percent >= 10.0;
    then stock_ownership_requirements_met_864e4Cii(taxpayer_group, corp);
}
pub relation entity_stock_percent_of_corporation_864e4Ciii(entity_id: Text, corp: us.irc.core::Corporation, percent: Decimal) kind empirical {
    label en official "the percentage of the corporation's stock owned (directly or indirectly) by the corporation, partnership or trust";
}
pub relation holder_interest_percent_in_entity_864e4Ciii(holder: Text, entity_id: Text, percent: Decimal) kind empirical {
    label en official "the percentage interest of the shareholder, partner or beneficiary in the corporation, partnership or trust";
}
pub relation stock_treated_as_owned_proportionately_864e4Ciii(holder: Text, corp: us.irc.core::Corporation, percent: Decimal) kind institutional {
    label en official "stock owned by a corporation, partnership or trust is treated as owned proportionately by its shareholders, partners or beneficiaries; one step is derived (the successive treatment as actually owned would need a recursion the runtime subset rejects, LDC-E4102)";
}
@source(IRC_S864_E, relation = formalizes, coverage = partial, quote = "For purposes of this subparagraph, stock owned (directly or indirectly) by a corporation, partnership, or")
rule S864E4CiiiProportionateOwnershipOneStep defeasible {
    for holder: Text;
    for entity_id: Text;
    for corp: us.irc.core::Corporation;
    for entity_percent: Decimal;
    for interest: Decimal;
    when entity_stock_percent_of_corporation_864e4Ciii(entity_id, corp, entity_percent)
     and holder_interest_percent_in_entity_864e4Ciii(holder, entity_id, interest);
    then stock_treated_as_owned_proportionately_864e4Ciii(holder, corp, entity_percent * (interest / 100.0));
}
pub relation earnings_and_profits_of_other_corporation_attributable_864e4Ci(taxpayer_group: Text, corp: us.irc.core::Corporation, amount: Money) kind empirical {
    label en official "the earnings and profits (or deficit) of the other corporation attributable to the stock the taxpayer is treated as owning and to the period during which the stock was so treated as owned";
}
pub relation earnings_adjustment_includes_other_corporation_864e4Ci(taxpayer_group: Text, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the adjustment under subparagraph (A) includes the earnings and profits (or deficit) of the other corporation attributable to the stock so owned, where the clause (ii) stock ownership requirements are met";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "If, by reason of holding stock in a nonaffiliated 10-percent owned corporation, the taxpayer is treated under")
rule S864E4CiChainEarningsAdjustment defeasible {
    for taxpayer_group: Text;
    for corp: us.irc.core::Corporation;
    for amount: Money;
    when stock_ownership_requirements_met_864e4Cii(taxpayer_group, corp)
     and earnings_and_profits_of_other_corporation_attributable_864e4Ci(taxpayer_group, corp, amount);
    then earnings_adjustment_includes_other_corporation_864e4Ci(taxpayer_group, corp, amount);
}

// --- §864(e)(5)(B), (e)(6) ------------------------------------------------------------------------------------------------------------

pub relation corporation_includible_only_for_separate_1504_864e5B(corp: us.irc.core::Corporation) kind institutional {
    label en official "a corporation described in subparagraph (C) (a section 581 or 591 financial institution meeting the conditions) is treated as an includible corporation for section 1504 only for applying that section separately to corporations so described, and not for paragraph (6)";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "For purposes of subparagraph (A), any corporation described in subparagraph (C) shall be treated as an")
rule S864E5BSeparateSection1504Application defeasible {
    for corp: us.irc.core::Corporation;
    when corporation_described_in_864e5C(corp);
    then corporation_includible_only_for_separate_1504_864e5B(corp);
}
pub relation expense_not_directly_allocable_864e6(expense_id: Text, group_id: Text) kind empirical {
    label en official "an expense other than interest which is not directly allocable or apportionable to any specific income producing activity, of a member of the affiliated group";
}
pub relation qualified_research_expenditure_864e6(expense_id: Text) kind empirical {
    label en official "the expense is a qualified research and experimental expenditure (subsection (g)(4)(E): paragraph (6) does not apply to it)";
}
pub relation allocated_as_if_group_were_single_corporation_864e6(expense_id: Text, group_id: Text) kind institutional {
    label en official "the expense is allocated and apportioned as if all members of the affiliated group were a single corporation";
}
@source(IRC_S864_E, relation = formalizes, coverage = exact, quote = "Expenses other than interest which are not directly allocable or apportioned to any specific income producing")
rule S864E6ExpensesAsSingleCorporation defeasible {
    for expense_id: Text;
    for group_id: Text;
    when expense_not_directly_allocable_864e6(expense_id, group_id);
    unless qualified_research_expenditure_864e6(expense_id)
     and expense_not_directly_allocable_864e6(expense_id, group_id);
    then allocated_as_if_group_were_single_corporation_864e6(expense_id, group_id);
}
pub relation section_864e6_not_applicable_to_research_864g4E(expense_id: Text) kind institutional {
    label en official "paragraph (6) of subsection (e) does not apply to qualified research and experimental expenditures";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(E) Paragraph (6) of subsection (e) shall not apply to qualified research and experimental expenditures.")
rule S864G4EParagraphSixNotApplicableToResearch defeasible {
    for expense_id: Text;
    when qualified_research_expenditure_864e6(expense_id);
    then section_864e6_not_applicable_to_research_864g4E(expense_id);
}

// --- §864(g): research and experimental expenditures ------------------------------------------------------------------------------

pub relation rd_expense_solely_to_meet_legal_requirements_864g1A(expense_id: Text, jurisdiction: Text) kind empirical {
    label en official "qualified research and experimental expenditures expended solely to meet legal requirements imposed by a political entity with respect to the improvement or marketing of specific products or processes, for purposes not reasonably expected to generate gross income (beyond de minimis amounts) outside its jurisdiction";
}
pub relation rd_allocated_only_to_jurisdiction_864g1A(expense_id: Text, jurisdiction: Text) kind institutional {
    label en official "the expenditures are allocated only to gross income from sources within the jurisdiction";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(A) Any qualified research and experimental expenditures expended solely to meet legal requirements imposed")
rule S864G1AAllocatedOnlyToJurisdiction defeasible {
    for expense_id: Text;
    for jurisdiction: Text;
    when rd_expense_solely_to_meet_legal_requirements_864g1A(expense_id, jurisdiction);
    then rd_allocated_only_to_jurisdiction_864g1A(expense_id, jurisdiction);
}
pub relation rd_activity_location_864g3B(expense_id: Text, location: Text) kind empirical {
    label en official "where the activities to which the expenditures are attributable are conducted: 'space', 'international_waters' (on or under water not within the jurisdiction, as recognized by the United States, of a foreign country, a possession or the United States) or 'antarctica'";
}
pub relation rd_expense_in_space_waters_or_antarctica_864g3B(expense_id: Text) kind institutional {
    label en official "the expenditures are attributable to activities conducted in space, on or under international waters, or in Antarctica";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(i) in space,")
rule S864G3BiSpace defeasible {
    for expense_id: Text;
    when rd_activity_location_864g3B(expense_id, "space");
    then rd_expense_in_space_waters_or_antarctica_864g3B(expense_id);
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(ii) on or under water not within the jurisdiction (as recognized by the United States) of a foreign country,")
rule S864G3BiiInternationalWaters defeasible {
    for expense_id: Text;
    when rd_activity_location_864g3B(expense_id, "international_waters");
    then rd_expense_in_space_waters_or_antarctica_864g3B(expense_id);
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(iii) in Antarctica.")
rule S864G3BiiiAntarctica defeasible {
    for expense_id: Text;
    when rd_activity_location_864g3B(expense_id, "antarctica");
    then rd_expense_in_space_waters_or_antarctica_864g3B(expense_id);
}
pub relation rd_incurred_by_united_states_person_864g3A(expense_id: Text) kind empirical {
    label en official "the expenditures are incurred by a United States person";
}
pub relation rd_deemed_activity_location_864g3A(expense_id: Text, deemed_location: Text) kind institutional {
    label en official "the expenditures are allocated and apportioned as if attributable to activities conducted in the United States ('united_states', if incurred by a United States person) or outside the United States ('foreign', otherwise)";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(i) if incurred by a United States person, shall be allocated and apportioned under this section in the same")
rule S864G3AiUsPersonAllocatedAsUsActivities defeasible {
    for expense_id: Text;
    when rd_expense_in_space_waters_or_antarctica_864g3B(expense_id)
     and rd_incurred_by_united_states_person_864g3A(expense_id);
    then rd_deemed_activity_location_864g3A(expense_id, "united_states");
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(ii) if incurred by a person other than a United States person, shall be allocated and apportioned under this")
rule S864G3AiiOtherPersonAllocatedAsForeignActivities defeasible {
    for expense_id: Text;
    when rd_expense_in_space_waters_or_antarctica_864g3B(expense_id);
    unless rd_incurred_by_united_states_person_864g3A(expense_id)
     and rd_expense_in_space_waters_or_antarctica_864g3B(expense_id);
    then rd_deemed_activity_location_864g3A(expense_id, "foreign");
}
pub relation affiliated_group_rd_allocated_as_single_corporation_864g4A(group_id: Text) kind empirical {
    label en official "the allocation and apportionment of qualified research and experimental expenditures under paragraph (1) is made for an affiliated group (subsection (e)(5))";
}
pub relation rd_group_allocation_as_single_corporation_864g4A(group_id: Text) kind institutional {
    label en official "the allocation and apportionment is determined as if all members of the affiliated group were a single corporation, except as provided in subparagraph (B)";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(A) Except as provided in subparagraph (B), the allocation and apportionment required by paragraph (1) shall")
rule S864G4AGroupAsSingleCorporation defeasible {
    for group_id: Text;
    when affiliated_group_rd_allocated_as_single_corporation_864g4A(group_id);
    then rd_group_allocation_as_single_corporation_864g4A(group_id);
}
pub relation possession_electing_corporation_item_864g4B(item_id: Text, kind: Text) kind empirical {
    label en official "an item related to an electing corporation (section 936(h)(5)(E)): 'sales_or_gross_income' (sales and gross income from products produced in whole or in part in a possession) or 'dividends' (dividends from the electing corporation)";
}
pub relation election_936h5F_not_in_effect_for_product_864g4B(item_id: Text) kind empirical {
    label en official "the item is attributable to sales of products with respect to which an election under section 936(h)(5)(F) is not in effect";
}
pub relation excluded_from_864g1_allocation_864g4B(item_id: Text) kind institutional {
    label en official "the sales, gross income and dividends of an electing corporation are not taken into account in the allocation and apportionment, except for products for which an election under section 936(h)(5)(F) is not in effect";
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(i) sales and gross income from products produced in whole or in part in a possession by an electing")
rule S864G4BiSalesAndGrossIncomeExcluded defeasible {
    for item_id: Text;
    when possession_electing_corporation_item_864g4B(item_id, "sales_or_gross_income");
    unless election_936h5F_not_in_effect_for_product_864g4B(item_id)
     and possession_electing_corporation_item_864g4B(item_id, "sales_or_gross_income");
    then excluded_from_864g1_allocation_864g4B(item_id);
}
@source(IRC_S864_G, relation = formalizes, coverage = exact, quote = "(ii) dividends from an electing corporation,")
rule S864G4BiiDividendsExcluded defeasible {
    for item_id: Text;
    when possession_electing_corporation_item_864g4B(item_id, "dividends");
    unless election_936h5F_not_in_effect_for_product_864g4B(item_id)
     and possession_electing_corporation_item_864g4B(item_id, "dividends");
    then excluded_from_864g1_allocation_864g4B(item_id);
}
pub relation qualified_rd_expenditures_864g4C(expense_id: Text, amount: Money) kind empirical {
    label en official "the qualified research and experimental expenditures taken into account under paragraph (1)";
}
pub relation cost_sharing_amount_included_864g4C(expense_id: Text, amount: Money) kind empirical {
    label en official "the amount of the expenditures included in computing the cost-sharing amount (section 936(h)(5)(C)(i)(I))";
}
pub relation adjusted_qualified_rd_expenditures_864g4C(expense_id: Text, amount: Money) kind institutional {
    label en official "the expenditures adjusted to reflect the amount included in computing the cost-sharing amount (read as: the expenditures less that amount; JUDGMENT CALL, the statute says adjusted to reflect)";
}
@source(IRC_S864_G, relation = formalizes, coverage = partial, quote = "(C) The qualified research and experimental expenditures taken into account for purposes of paragraph (1)")
rule S864G4CAdjustForCostSharing defeasible {
    for expense_id: Text;
    for total: Money;
    for shared: Money;
    when qualified_rd_expenditures_864g4C(expense_id, total)
     and cost_sharing_amount_included_864g4C(expense_id, shared);
    then adjusted_qualified_rd_expenditures_864g4C(expense_id, max(total - shared, 0.00 USD));
}
