// PL 119-21 (July 4, 2025) editions of provisions of this package that the
// earlier modules did not yet carry as a second edition, and the sections the
// amendments touch: §951(a) (§70354 rewrite), §951B (§70353(b), new),
// §958(b)(4) (§70353(a)), §904(b)(5)-(6) (§70311, §70313), §960(d)(4)
// (§70312(b)), §954(c)(6) (§70351), §898 (§70352). Stage 2c (IRC-10 stage 2c,
// A13).
//
// EDITION MODELING: as in module 11, a formal `revision` node is not used
// (TECH-GAPS G97: needs a `next` edition; AGENT-BRIEF fallback). The pre-
// amendment rules of modules 10 and 11 are gated with an `unless` on the
// edition boundary; the amended rules here are gated on the same boundary.
// The boundary is read off the taxable year (`us.irc.core::begins`); the
// PL's own "taxable years of foreign corporations beginning after
// December 31, 2025" is the CFC's year. The amendments of PL 119-21
// §70354(b) to §951A(b)-(c) (pro rata share by reference to §951(a)(3),
// any-day ownership) are not carried into module 11's tested-income shares,
// which are case-supplied amounts (TECH-GAPS G1741).

// --- §951(a) (PL 119-21 §70354(a)): any-day ownership --------------------------

use self::{
    IRC_S898_B,
    IRC_S898_C,
    IRC_S951_B,
    IRC_S951_C,
    IRC_S954_C,
    IRC_S957_B,
    aggregate_us_shareholder_value_share_on_day,
    aggregate_us_shareholder_vote_share_on_day,
    cfc_taxable_year_begins_after_20251231,
    controlled_foreign_corporation,
    foreign_corporation_957,
    pro_rata_share_of_subpart_f_income,
    section_956_amount,
    shareholder_stock_ownership_share_958a,
    subpart_f_inclusion,
    subpart_f_income_of_cfc,
    taxable_year_begins_after_20251231,
    united_states_shareholder_vote_or_value_owned,
    us_shareholder_owns_stock_on_last_cfc_day,
};

pub relation shareholder_owned_stock_on_any_day_of_cfc_year_951a1A(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the United States shareholder owns (within the meaning of section 958(a)) stock in the corporation on any day during the CFC year, for the amended section 951(a)(1)(A)";
}
pub relation shareholder_cfc_period_fraction_951a2B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, fraction: Decimal) kind empirical {
    label en official "the part of the CFC year (0 to 1) during which the shareholder owned the stock, was a United States shareholder of the corporation, and the corporation was a controlled foreign corporation, all three at once (amended section 951(a)(2)(B)(i)-(iii))";
}
@source(us.irc.temporal::PL119_21_S70354, relation = derives_from, quote = "each United States shareholder which owns (within the meaning of section 958(a)) stock in such corporation on any day during the CFC year")
rule S951A2PostPl11921ProRataShare defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for subpart_f_income: Money;
    for ownership_share: Decimal;
    for period: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and subpart_f_income_of_cfc(corp, y, subpart_f_income)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share)
     and shareholder_cfc_period_fraction_951a2B(shareholder, corp, y, period);
    then pro_rata_share_of_subpart_f_income(shareholder, corp, y, round(subpart_f_income * ownership_share * period, 2, "HALF_UP"));
}
@source(us.irc.temporal::PL119_21_S70354, relation = derives_from, quote = "each United States shareholder which owns (within the meaning of section 958(a)) stock in such corporation on any day during the CFC year")
rule S951A1APostPl11921Inclusion defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and controlled_foreign_corporation(corp, y)
     and shareholder_owned_stock_on_any_day_of_cfc_year_951a1A(shareholder, corp, y)
     and pro_rata_share_of_subpart_f_income(shareholder, corp, y, amount);
    then subpart_f_inclusion(shareholder, corp, y, amount);
}
pub relation section_956_inclusion_951a1B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount determined under section 956 with respect to the shareholder for the CFC year, included by a shareholder that owns stock on the last day of the CFC year on which the corporation is a controlled foreign corporation, to the extent not excluded under section 959(a)(2) (section 951(a)(1)(B))";
}
pub relation section_956_amount_excluded_under_959a2(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the part of the section 956 amount excluded from gross income under section 959(a)(2)";
}
@source(us.irc.temporal::PL119_21_S70354, relation = derives_from, quote = "shall include in gross income the amount determined under section 956 with respect to such shareholder for the CFC year (but only to the extent not excluded from gross income under section 959(a)(2))")
rule S951A1BSection956InclusionOnLastCfcDay defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for excluded: Money;
    when us_shareholder_owns_stock_on_last_cfc_day(shareholder, corp, y)
     and section_956_amount(shareholder, corp, y, amount)
     and section_956_amount_excluded_under_959a2(shareholder, corp, y, excluded);
    then section_956_inclusion_951a1B(shareholder, corp, y, max(0.00 USD, amount - excluded));
}
@source(us.irc.temporal::PL119_21_S70354, relation = derives_from, quote = "shall include in gross income the amount determined under section 956 with respect to such shareholder for the CFC year (but only to the extent not excluded from gross income under section 959(a)(2))")
rule S951A1BSection956InclusionNoExclusion defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when us_shareholder_owns_stock_on_last_cfc_day(shareholder, corp, y)
     and section_956_amount(shareholder, corp, y, amount);
    unless section_956_amount_excluded_under_959a2(shareholder, corp, y, _)
     and us_shareholder_owns_stock_on_last_cfc_day(shareholder, corp, y)
     and section_956_amount(shareholder, corp, y, amount);
    then section_956_inclusion_951a1B(shareholder, corp, y, amount);
}
// (a)(3): the taxable year of inclusion is the shareholder's taxable year that
// includes the last day on which the shareholder owns stock in the CFC
// during the CFC year.
pub relation last_day_shareholder_owns_stock_in_cfc_year_951a3(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, last_day: Date) kind empirical {
    label en official "the last day on which the shareholder owns (within the meaning of section 958(a)) stock in the controlled foreign corporation during the CFC year";
}
pub relation shareholder_inclusion_year_951a3(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, cfc_year: us.irc.core::TaxableYear, inclusion_year: us.irc.core::TaxableYear) kind institutional {
    label en official "the shareholder's taxable year in which an amount under section 951(a)(1) for the CFC year is included: the year that includes the last day on which the shareholder owns stock in the corporation during the CFC year (amended section 951(a)(3))";
}
@source(us.irc.temporal::PL119_21_S70354, relation = derives_from, quote = "Any amount required to be included in gross income by a United States shareholder under paragraph (1) with respect to a CFC year shall be included in gross income for the shareholder’s taxable year which includes the last day on which the shareholder owns (within the meaning of section 958(a)) stock in the controlled foreign corporation during such CFC year.")
rule S951A3InclusionYearIncludesLastOwnershipDay defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for cfc_year: us.irc.core::TaxableYear;
    for inclusion_year: us.irc.core::TaxableYear;
    for last_day: Date;
    for b: Date;
    for e: Date;
    when cfc_taxable_year_begins_after_20251231(corp, cfc_year)
     and last_day_shareholder_owns_stock_in_cfc_year_951a3(shareholder, corp, cfc_year, last_day)
     and us.irc.core::year_of(shareholder, inclusion_year)
     and us.irc.core::begins(inclusion_year, b)
     and us.irc.core::ends(inclusion_year, e)
     and b <= last_day
     and last_day <= e;
    then shareholder_inclusion_year_951a3(shareholder, corp, cfc_year, inclusion_year);
}

// --- §951B (PL 119-21 §70353(b)): foreign controlled United States shareholders

pub relation us_person_vote_percent_without_958b4_951B(person: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage of the total combined voting power and of the total value that the United States person owns (section 958(a)) or is considered as owning by applying section 958(b) without regard to paragraph (4) thereof";
}
pub relation aggregate_foreign_controlled_shareholder_percent_951B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the combined voting power and the value owned by foreign controlled United States shareholders together, with section 958(b) applied without regard to paragraph (4) (the section 957(a) test as substituted by section 951B(c))";
}
pub relation foreign_controlled_united_states_shareholder_951B(person: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a United States person that would be a United States shareholder with respect to the foreign corporation if section 951(b) were applied by substituting `more than 50 percent` for `10 percent or more` and section 958(b) were applied without regard to paragraph (4) (section 951B(b))";
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "the term ‘foreign controlled United States shareholder’ means, with respect to any foreign corporation, any United States person which would be a United States shareholder with respect to such foreign corporation if—")
rule S951BbForeignControlledUsShareholderByVote defeasible {
    for person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for vote: Decimal;
    for value: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and us.irc.definitions::united_states_person(person)
     and us_person_vote_percent_without_958b4_951B(person, corp, y, vote, value)
     and vote > 50.0;
    then foreign_controlled_united_states_shareholder_951B(person, corp, y);
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "the term ‘foreign controlled United States shareholder’ means, with respect to any foreign corporation, any United States person which would be a United States shareholder with respect to such foreign corporation if—")
rule S951BbForeignControlledUsShareholderByValue defeasible {
    for person: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for vote: Decimal;
    for value: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and us.irc.definitions::united_states_person(person)
     and us_person_vote_percent_without_958b4_951B(person, corp, y, vote, value)
     and value > 50.0;
    then foreign_controlled_united_states_shareholder_951B(person, corp, y);
}
pub relation foreign_controlled_foreign_corporation_951B(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a foreign corporation, other than a controlled foreign corporation, that would be a controlled foreign corporation if section 957(a) were applied by substituting foreign controlled United States shareholders for United States shareholders and section 958(b) (other than paragraph (4)) for section 958(b) (section 951B(c))";
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "the term ‘foreign controlled foreign corporation’ means a foreign corporation, other than a controlled foreign corporation, which would be a controlled foreign corporation if section 957(a) were applied—")
rule S951BcForeignControlledForeignCorporationByVote defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for vote: Decimal;
    for value: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and foreign_corporation_957(corp)
     and aggregate_foreign_controlled_shareholder_percent_951B(corp, y, vote, value)
     and vote > 50.0;
    unless controlled_foreign_corporation(corp, y)
     and foreign_corporation_957(corp);
    then foreign_controlled_foreign_corporation_951B(corp, y);
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "the term ‘foreign controlled foreign corporation’ means a foreign corporation, other than a controlled foreign corporation, which would be a controlled foreign corporation if section 957(a) were applied—")
rule S951BcForeignControlledForeignCorporationByValue defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for vote: Decimal;
    for value: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and foreign_corporation_957(corp)
     and aggregate_foreign_controlled_shareholder_percent_951B(corp, y, vote, value)
     and value > 50.0;
    unless controlled_foreign_corporation(corp, y)
     and foreign_corporation_957(corp);
    then foreign_controlled_foreign_corporation_951B(corp, y);
}
pub relation subpart_f_inclusion_951B(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "a foreign controlled United States shareholder's inclusion under subpart F applied, separately from and in addition to the ordinary application, by treating the foreign controlled foreign corporation as a controlled foreign corporation (section 951B(a)(1)): the pro rata share of the corporation's subpart F income, computed by the ordinary section 951(a) rules; section 951A applies alike through (a)(2) — that consequence is not chained here (TECH-GAPS G1742)";
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "this subpart (other than sections 951A, 951(b), and 957) shall be applied with respect to such shareholder (separately from, and in addition to, the application of this subpart without regard to this section)—")
rule S951BaForeignControlledInclusion defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when foreign_controlled_united_states_shareholder_951B(shareholder, corp, y)
     and foreign_controlled_foreign_corporation_951B(corp, y)
     and shareholder_owned_stock_on_any_day_of_cfc_year_951a1A(shareholder, corp, y)
     and pro_rata_share_of_subpart_f_income(shareholder, corp, y, amount);
    then subpart_f_inclusion_951B(shareholder, corp, y, amount);
}

// --- §958(b)(4) (PL 119-21 §70353(a)): no downward attribution from foreign
// persons ---------------------------------------------------------------------

pub relation ownership_determination_year_958b4(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind empirical {
    label en unofficial "the taxable year of the foreign corporation for which the section 958(b) ownership is being determined";
}
pub relation downward_attribution_source_is_not_us_person_958b4(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock attributed to the person under section 318(a)(3)(A), (B) or (C) is owned by a person who is not a United States person";
}
pub relation downward_attribution_barred_958b4(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "section 318(a)(3)(A)-(C) is not applied so as to consider a United States person as owning stock which is owned by a person who is not a United States person, for a taxable year of the foreign corporation beginning after December 31, 2025 (section 958(b)(4))";
}
@source(us.irc.temporal::PL119_21_S70353, relation = derives_from, quote = "shall not be applied so as to consider a United States person as owning stock which is owned by a person who is not a United States person")
rule S958B4DownwardAttributionFromForeignPersonBarred defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    when ownership_determination_year_958b4(corp, y)
     and cfc_taxable_year_begins_after_20251231(corp, y)
     and us.irc.definitions::united_states_person(p)
     and downward_attribution_source_is_not_us_person_958b4(p, corp);
    then downward_attribution_barred_958b4(p, corp);
}

// --- §904(b)(5), (b)(6) (PL 119-21 §70311, §70313) -----------------------------

pub relation gilti_basket_gross_income_904b5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "gross income in the section 904(d)(1)(A) category (section 951A amounts, other than passive category income) for the taxable year";
}
pub relation section_250a1B_and_164a3_deductions_904b5A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "any deduction allowed under section 250(a)(1)(B), and under section 164(a)(3) for taxes imposed on amounts described in section 250(a)(1)(B)";
}
pub relation other_directly_allocable_deductions_904b5C(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "any other deduction to the section 904(d)(1)(A) income that is directly allocable to it";
}
pub relation deductions_apportioned_to_us_source_only_904b5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the interest expense, research and experimental expenditures and other not-directly-allocable amounts that would but for (B) and (C) have been allocated or apportioned to the section 904(d)(1)(A) income are allocated only to income from sources within the United States (last sentence of section 904(b)(5))";
}
pub relation interest_and_rd_and_indirect_deductions_otherwise_allocable_904b5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount of interest expense, research and experimental expenditures and other not-directly-allocable deductions that, without (B) and (C), would have been allocated or apportioned to the section 904(d)(1)(A) income";
}
@source(us.irc.temporal::PL119_21_S70311, relation = derives_from, quote = "Any amount or deduction which would (but for subparagraphs (B) and (C)) have been allocated or apportioned to such income shall only be allocated or apportioned to income which is from sources within the United States.")
rule S904B5UsSourceOnlyResidual defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when taxable_year_begins_after_20251231(y)
     and interest_and_rd_and_indirect_deductions_otherwise_allocable_904b5(p, y, amount);
    then deductions_apportioned_to_us_source_only_904b5(p, y, amount);
}
pub relation foreign_source_taxable_income_gilti_basket_904b5(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "taxable income from sources without the United States for the section 904(d)(1)(A) basket for the section 904(a) limitation, in taxable years beginning after December 31, 2025: the gross income less the section 250(a)(1)(B) deduction and section 164(a)(3) taxes and directly allocable other deductions, with no interest expense or research and experimental expenditures (section 904(b)(5)(A)-(C)), floored at zero";
}
@source(us.irc.temporal::PL119_21_S70311, relation = derives_from, quote = "the taxpayer’s taxable income from sources without the United States shall be determined by allocating and apportioning—")
rule S904B5GiltiBasketForeignSourceTaxableIncome defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for gross: Money;
    for d250: Money;
    for direct: Money;
    when taxable_year_begins_after_20251231(y)
     and gilti_basket_gross_income_904b5(p, y, gross)
     and section_250a1B_and_164a3_deductions_904b5A(p, y, d250)
     and other_directly_allocable_deductions_904b5C(p, y, direct);
    then foreign_source_taxable_income_gilti_basket_904b5(p, y, max(0.00 USD, gross - d250 - direct));
}
pub relation us_person_has_foreign_office_904b6(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the United States person maintains an office or other fixed place of business in a foreign country (determined under rules similar to section 864(c)(5))";
}
pub relation inventory_income_from_us_produced_sold_abroad_via_foreign_office_904b6(p: us.irc.core::Person, y: us.irc.core::TaxableYear, portion: Money, total_income: Money) kind empirical {
    label en official "the portion of income that (A) is from the sale or exchange outside the United States of inventory produced in the United States, for use outside the United States, to which the third sentence of section 863(b) applies, and (B) is attributable to the foreign office (rules similar to section 864(c)(5)); and the total income from the sale of such inventory";
}
pub relation foreign_source_inventory_income_904b6(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion treated as from sources without the United States for section 904, not exceeding 50 percent of the income from the sale or exchange of the inventory property (section 904(b)(6))";
}
@source(us.irc.temporal::PL119_21_S70313, relation = derives_from, quote = "shall be treated as from sources without the United States, except that the amount so treated shall not exceed 50 percent of the income from the sale or exchange of such inventory property.")
rule S904B6ForeignOfficeInventoryIncomeCappedAtHalf defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for portion: Money;
    for total: Money;
    when taxable_year_begins_after_20251231(y)
     and us.irc.definitions::united_states_person(p)
     and us_person_has_foreign_office_904b6(p, y)
     and inventory_income_from_us_produced_sold_abroad_via_foreign_office_904b6(p, y, portion, total);
    then foreign_source_inventory_income_904b6(p, y, min(portion, round(total * 0.50, 2, "HALF_UP")));
}

// --- §960(d)(4) (PL 119-21 §70312(b)): PTEP net CFC tested income ------------

pub relation foreign_income_taxes_on_ptep_tested_income_960d4(domestic_corp: us.irc.core::Corporation, tax_paid_on: Date, amount: Money) kind empirical {
    label en official "foreign income taxes paid or accrued (or deemed paid under section 960(b)(1)) on the given date with respect to any amount excluded from gross income under section 959(a) by reason of an inclusion under section 951A(a)";
}
pub relation disallowed_credit_960d4(domestic_corp: us.irc.core::Corporation, tax_paid_on: Date, amount: Money) kind institutional {
    label en official "no credit is allowed under section 901 for 10 percent of those foreign income taxes, for taxes paid or accrued (or deemed paid) after June 28, 2025 (section 960(d)(4), PL 119-21 §70312(b) and (c)(2))";
}
@source(us.irc.temporal::PL119_21_S70312, relation = derives_from, quote = "No credit shall be allowed under section 901 for 10 percent of any foreign income taxes paid or accrued (or deemed paid under subsection (b)(1)) with respect to any amount excluded from gross income under section 959(a) by reason of an inclusion in gross income under section 951A(a).")
rule S960D4TenPercentDisallowanceAfterJune282025 defeasible {
    for corp: us.irc.core::Corporation;
    for paid_on: Date;
    for amount: Money;
    when foreign_income_taxes_on_ptep_tested_income_960d4(corp, paid_on, amount)
     and paid_on > @2025-06-28;
    then disallowed_credit_960d4(corp, paid_on, round(amount * 0.10, 2, "HALF_UP"));
}

// --- §954(c)(6): look-thru rule for related controlled foreign corporations --

pub relation payment_from_related_cfc_954c6(payee: us.irc.core::Corporation, payer: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text, amount: Money) kind empirical {
    label en official "dividends, interest, rents or royalties received or accrued by the controlled foreign corporation from a controlled foreign corporation which is a related person";
}
pub relation portion_attributable_to_payer_income_not_subpart_f_or_eci_954c6(item_id: Text, portion: Money) kind empirical {
    label en official "the portion of the payment attributable or properly allocable (rules similar to section 904(d)(3)(C) and (D)) to income of the payer which is neither subpart F income nor income treated as effectively connected with a US trade or business";
}
pub relation payment_creates_or_increases_952c_deficit_954c6B(item_id: Text) kind empirical {
    label en official "the interest, rent or royalty creates (or increases) a deficit which under section 952(c) may reduce the subpart F income of the payor or another controlled foreign corporation (section 954(c)(6)(B))";
}
pub relation year_begins_after_20051231_954c6C(y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation's taxable year begins after December 31, 2005";
}
rule S954C6CYearAfter2005 defeasible {
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when us.irc.core::begins(y, d)
     and d > @2005-12-31;
    then year_begins_after_20051231_954c6C(y);
}
pub relation look_thru_excluded_from_fphci_954c6(payee: us.irc.core::Corporation, item_id: Text, amount: Money) kind institutional {
    label en official "the payment is not treated as foreign personal holding company income to the extent of the look-through portion (section 954(c)(6)(A)); for taxable years of foreign corporations beginning after December 31, 2005 and before January 1, 2026, and, by PL 119-21 §70351, for years beginning after December 31, 2025 without an end date";
}
@source(IRC_S954_C, relation = formalizes, coverage = partial, quote = "For purposes of this subsection, dividends, interest, rents, and royalties received or accrued from a controlled foreign corporation which is a related person shall not be treated as foreign personal holding company income to the extent attributable or properly allocable (determined under rules similar to the rules of subparagraphs (C) and (D) of section 904(d)(3)) to income of the related person which is neither subpart F income nor income treated as effectively connected with the conduct of a trade or business in the United States.")
rule S954C6AOriginalWindow defeasible {
    for payee: us.irc.core::Corporation;
    for payer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    for portion: Money;
    for d: Date;
    when payment_from_related_cfc_954c6(payee, payer, y, item_id, amount)
     and portion_attributable_to_payer_income_not_subpart_f_or_eci_954c6(item_id, portion)
     and year_begins_after_20051231_954c6C(y)
     and us.irc.core::begins(y, d)
     and d <= @2025-12-31;
    unless payment_creates_or_increases_952c_deficit_954c6B(item_id)
     and payment_from_related_cfc_954c6(payee, payer, y, item_id, amount)
     and portion_attributable_to_payer_income_not_subpart_f_or_eci_954c6(item_id, portion);
    then look_thru_excluded_from_fphci_954c6(payee, item_id, min(amount, portion));
}
@source(us.irc.temporal::PL119_21_S70351, relation = derives_from, quote = "striking “and before January 1, 2026,”")
rule S954C6APermanentAfter2025 defeasible {
    for payee: us.irc.core::Corporation;
    for payer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    for amount: Money;
    for portion: Money;
    when cfc_taxable_year_begins_after_20251231(payee, y)
     and payment_from_related_cfc_954c6(payee, payer, y, item_id, amount)
     and portion_attributable_to_payer_income_not_subpart_f_or_eci_954c6(item_id, portion);
    unless payment_creates_or_increases_952c_deficit_954c6B(item_id)
     and payment_from_related_cfc_954c6(payee, payer, y, item_id, amount)
     and portion_attributable_to_payer_income_not_subpart_f_or_eci_954c6(item_id, portion);
    then look_thru_excluded_from_fphci_954c6(payee, item_id, min(amount, portion));
}

// --- §898: taxable year of certain foreign corporations ----------------------

pub relation specified_foreign_corporation_ownership_on_testing_day_898(corp: us.irc.core::Corporation, testing_day: Date, vote_percent: Decimal, value_percent: Decimal) kind empirical {
    label en official "the percentage of total voting power, and of total value, of the foreign corporation owned by a United States shareholder on the testing day (rules of section 958(a) and (b) apply)";
}
pub relation testing_day_898(corp: us.irc.core::Corporation, testing_day: Date) kind empirical {
    label en official "a testing day: the first day of the corporation's taxable year (determined without regard to section 898), or a day in the representative period the Secretary prescribes (section 898(c)(3)(B))";
}
pub relation foreign_corp_treated_as_cfc_for_any_purpose_898b1A(corp: us.irc.core::Corporation) kind empirical {
    label en official "the foreign corporation is treated as a controlled foreign corporation for any purpose under subpart F";
}
pub relation specified_foreign_corporation_898b(corp: us.irc.core::Corporation) kind institutional {
    label en official "a specified foreign corporation: a foreign corporation treated as a controlled foreign corporation for any purpose under subpart F, of which a United States shareholder owns, on each testing day, more than 50 percent of the total voting power or of the total value (section 898(b))";
}
pub relation testing_day_fails_majority_898b2A(corp: us.irc.core::Corporation) kind institutional {
    label en official "some testing day exists on which no United States shareholder owns more than 50 percent of the voting power or of the value";
}
pub relation testing_day_with_majority_898b2A(corp: us.irc.core::Corporation, testing_day: Date) kind institutional {
    label en official "on the testing day a United States shareholder owns more than 50 percent of the voting power or of the value";
}
rule S898B2AMajorityOnDayByVote defeasible {
    for corp: us.irc.core::Corporation;
    for d: Date;
    for vote: Decimal;
    for value: Decimal;
    when testing_day_898(corp, d)
     and specified_foreign_corporation_ownership_on_testing_day_898(corp, d, vote, value)
     and vote > 50.0;
    then testing_day_with_majority_898b2A(corp, d);
}
rule S898B2AMajorityOnDayByValue defeasible {
    for corp: us.irc.core::Corporation;
    for d: Date;
    for vote: Decimal;
    for value: Decimal;
    when testing_day_898(corp, d)
     and specified_foreign_corporation_ownership_on_testing_day_898(corp, d, vote, value)
     and value > 50.0;
    then testing_day_with_majority_898b2A(corp, d);
}
rule S898B2ATestingDayWithoutMajority defeasible {
    for corp: us.irc.core::Corporation;
    for d: Date;
    when testing_day_898(corp, d);
    unless testing_day_with_majority_898b2A(corp, d)
     and testing_day_898(corp, d);
    then testing_day_fails_majority_898b2A(corp);
}
@source(IRC_S898_B, relation = formalizes, coverage = exact, quote = "(B) with respect to which the ownership requirements of paragraph (2) are met.")
rule S898B1SpecifiedForeignCorporation defeasible {
    for corp: us.irc.core::Corporation;
    when foreign_corp_treated_as_cfc_for_any_purpose_898b1A(corp)
     and testing_day_898(corp, _);
    unless testing_day_fails_majority_898b2A(corp)
     and foreign_corp_treated_as_cfc_for_any_purpose_898b1A(corp);
    then specified_foreign_corporation_898b(corp);
}
// (c)(3): the majority U.S. shareholder year is the taxable year that, on
// each testing day, was the taxable year of each qualifying shareholder.
pub relation qualifying_shareholder_year_tag_898c3(corp: us.irc.core::Corporation, shareholder: us.irc.core::Person, testing_day: Date, year_tag: Text) kind empirical {
    label en official "the taxable year (identified by a tag, e.g. the month it ends) that was, on the testing day, the taxable year of a United States shareholder described in section 898(b)(2)(A) or whose stock was treated as owned under (b)(2)(B) by such a shareholder";
}
pub relation shareholder_year_tag_conflict_898c3(corp: us.irc.core::Corporation, year_tag: Text) kind institutional {
    label en official "some qualifying shareholder on some testing day had a taxable year different from the tag";
}
pub relation shareholder_year_tag_898c3(corp: us.irc.core::Corporation, year_tag: Text) kind institutional {
    label en official "a tag carried by at least one qualifying shareholder on one testing day (a candidate for the majority U.S. shareholder year)";
}
rule S898C3CandidateTag defeasible {
    for corp: us.irc.core::Corporation;
    for s: us.irc.core::Person;
    for d: Date;
    for tag: Text;
    when qualifying_shareholder_year_tag_898c3(corp, s, d, tag);
    then shareholder_year_tag_898c3(corp, tag);
}
rule S898C3ConflictingTag defeasible {
    for corp: us.irc.core::Corporation;
    for s: us.irc.core::Person;
    for d: Date;
    for tag: Text;
    for other: Text;
    when shareholder_year_tag_898c3(corp, tag)
     and qualifying_shareholder_year_tag_898c3(corp, s, d, other)
     and other != tag;
    then shareholder_year_tag_conflict_898c3(corp, tag);
}
pub relation majority_us_shareholder_year_898c3(corp: us.irc.core::Corporation, year_tag: Text) kind institutional {
    label en official "the majority U.S. shareholder year: the taxable year that on each testing day constituted the taxable year of each qualifying United States shareholder (section 898(c)(3)(A))";
}
@source(IRC_S898_C, relation = formalizes, coverage = exact, quote = "(A) the majority U.S. shareholder year, or")
rule S898C3MajorityUsShareholderYear defeasible {
    for corp: us.irc.core::Corporation;
    for tag: Text;
    when shareholder_year_tag_898c3(corp, tag);
    unless shareholder_year_tag_conflict_898c3(corp, tag)
     and shareholder_year_tag_898c3(corp, tag);
    then majority_us_shareholder_year_898c3(corp, tag);
}
pub relation regulation_prescribed_year_tag_898c1B(corp: us.irc.core::Corporation, year_tag: Text) kind empirical {
    label en official "the taxable year prescribed under regulations, for a specified foreign corporation with no majority U.S. shareholder year (section 898(c)(1)(B))";
}
pub relation required_year_898c1(corp: us.irc.core::Corporation, year_tag: Text) kind institutional {
    label en official "the required year of the specified foreign corporation: the majority U.S. shareholder year, or, if there is none, the taxable year prescribed under regulations (section 898(c)(1)); the taxable year of a specified foreign corporation is the required year (section 898(a))";
}
@source(IRC_S898_C, relation = formalizes, coverage = exact, quote = "The required year is—")
rule S898C1RequiredYearMajority defeasible {
    for corp: us.irc.core::Corporation;
    for tag: Text;
    when specified_foreign_corporation_898b(corp)
     and majority_us_shareholder_year_898c3(corp, tag);
    then required_year_898c1(corp, tag);
}
@source(IRC_S898_C, relation = formalizes, coverage = exact, quote = "(B) if there is no majority U.S. shareholder year, the taxable year prescribed under regulations.")
rule S898C1RequiredYearByRegulation defeasible {
    for corp: us.irc.core::Corporation;
    for tag: Text;
    when specified_foreign_corporation_898b(corp)
     and regulation_prescribed_year_tag_898c1B(corp, tag);
    unless majority_us_shareholder_year_898c3(corp, _)
     and specified_foreign_corporation_898b(corp)
     and regulation_prescribed_year_tag_898c1B(corp, tag);
    then required_year_898c1(corp, tag);
}
// (c)(2): the one-month deferral election, repealed by PL 119-21 §70352 for
// taxable years of specified foreign corporations beginning after
// November 30, 2025.
pub relation elects_one_month_deferral_898c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, year_tag: Text) kind empirical {
    label en official "the specified foreign corporation elects a taxable year beginning 1 month earlier than the majority U.S. shareholder year (pre-amendment section 898(c)(2)); the tag names the resulting year";
}
pub relation specified_corp_year_begins_after_20251130_898(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the taxable year of the specified foreign corporation begins after November 30, 2025, the PL 119-21 §70352 boundary";
}
rule S898YearAfterNov302025 defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for d: Date;
    when us.irc.core::year_of(corp, y)
     and us.irc.core::begins(y, d)
     and d > @2025-11-30;
    then specified_corp_year_begins_after_20251130_898(corp, y);
}
pub relation deferral_election_effective_898c2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the one-month-deferral election is allowed for the year: only for taxable years beginning before December 1, 2025 (section 898(c)(2) as repealed by PL 119-21 §70352 for later years)";
}
@source(IRC_S898_C, relation = formalizes, coverage = exact, quote = "A specified foreign corporation may elect, in lieu of the taxable year under paragraph (1)(A), a taxable year beginning 1 month earlier than the majority U.S. shareholder year.")
rule S898C2DeferralElectionBeforeRepeal defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for tag: Text;
    when specified_foreign_corporation_898b(corp)
     and elects_one_month_deferral_898c2(corp, y, tag);
    unless specified_corp_year_begins_after_20251130_898(corp, y)
     and elects_one_month_deferral_898c2(corp, y, tag);
    then deferral_election_effective_898c2(corp, y);
}

// --- §951(b), §951(c), §957(b) ----------------------------------------------

pub relation united_states_shareholder_951b(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a United States shareholder of the foreign corporation: a United States person (section 957(c)) that owns (section 958(a)) or is considered as owning (section 958(b)) 10 percent or more of the total combined voting power, or 10 percent or more of the total value of the shares (section 951(b)); module 06's `us_shareholder_status` remains the asserted flag that other rules read";
}
@source(IRC_S951_B, relation = formalizes, coverage = exact, quote = "10 percent or more of the total combined voting power of all classes of stock entitled to vote of such foreign corporation")
rule S951BUsShareholderByVote defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for vote: Decimal;
    for value: Decimal;
    when us.irc.definitions::united_states_person(shareholder)
     and united_states_shareholder_vote_or_value_owned(shareholder, corp, y, day, vote, value)
     and vote >= 0.10;
    then united_states_shareholder_951b(shareholder, corp, y);
}
@source(IRC_S951_B, relation = formalizes, coverage = exact, quote = "10 percent or more of the total value of shares of all classes of stock of such foreign corporation")
rule S951BUsShareholderByValue defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for vote: Decimal;
    for value: Decimal;
    when us.irc.definitions::united_states_person(shareholder)
     and united_states_shareholder_vote_or_value_owned(shareholder, corp, y, day, vote, value)
     and value >= 0.10;
    then united_states_shareholder_951b(shareholder, corp, y);
}
pub relation pfic_1293_inclusion_for_same_amount_951c(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "but for section 951(c), the amount would be included in the shareholder's gross income both under section 951(a)(1)(A) and under section 1293 (passive foreign investment company inclusion)";
}
pub relation section_1293_inclusion_displaced_951c(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the amount is included only under section 951(a)(1)(A): the section 1293 inclusion is displaced (section 951(c))";
}
@source(IRC_S951_C, relation = formalizes, coverage = exact, quote = "such amount shall be included in the gross income of such shareholder only under subsection (a)(1)(A).")
rule S951CSubpartFDisplacesSection1293 defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when pfic_1293_inclusion_for_same_amount_951c(shareholder, corp, y, amount)
     and subpart_f_inclusion(shareholder, corp, y, _);
    then section_1293_inclusion_displaced_951c(shareholder, corp, y, amount);
}
pub relation insurance_income_cfc_957b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "for purposes only of taking into account section 953(a) insurance income, a foreign corporation is a controlled foreign corporation if more than 25 percent of the total combined voting power (or of the total value) is owned or considered owned by United States shareholders on any day of the year (section 957(b))";
}
@source(IRC_S957_B, relation = formalizes, coverage = partial, quote = "For purposes only of taking into account income described in section 953(a) (relating to insurance income), the term \"controlled foreign corporation\" includes not only a foreign corporation as defined by subsection (a) but also one of which more than 25 percent of the total combined voting power of all classes of stock (or more")
rule S957BInsuranceCfcByVote defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for total_vote_share: Decimal;
    when foreign_corporation_957(corp)
     and aggregate_us_shareholder_vote_share_on_day(corp, y, day, total_vote_share)
     and total_vote_share > 0.25;
    then insurance_income_cfc_957b(corp, y);
}
rule S957BInsuranceCfcByValue defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for day: Date;
    for total_value_share: Decimal;
    when foreign_corporation_957(corp)
     and aggregate_us_shareholder_value_share_on_day(corp, y, day, total_value_share)
     and total_value_share > 0.25;
    then insurance_income_cfc_957b(corp, y);
}
