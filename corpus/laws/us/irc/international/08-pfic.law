// §1297(a) — passive foreign investment company: the 75% income test and
// the 50% asset test. Stage 1 (IRC-10 stage 1, A13). §1297(b)-(f) (passive
// income definition/exceptions, asset-test details) are NOT modeled this
// stage beyond the classification (b)(1) presupposes generically —
// `passive_income_ratio`/`passive_asset_ratio` are asserted as case facts
// rather than derived from section 954(c) FPHCI items. §1291 (excess
// distribution regime), §1293 (QEF), §1295-§1296 (elections) are NOT
// modeled this stage (stage 2).

use self::{
    IRC_S1295_A,
    IRC_S1296_A,
    IRC_S1296_B,
    IRC_S1296_C,
    IRC_S1297_A,
    IRC_S1297_B,
    IRC_S1297_C,
    foreign_personal_holding_company_income_item,
};

pub relation gross_income_passive_ratio(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, ratio: Decimal) kind empirical {
    label en official "the ratio of passive income (section 1297(b)) to the foreign corporation's total gross income for the taxable year, for the section 1297(a)(1) 75% income test";
}
pub relation average_passive_asset_ratio(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, ratio: Decimal) kind empirical {
    label en official "the average percentage (section 1297(e)) of the foreign corporation's assets during the taxable year that produce, or are held for the production of, passive income — for the section 1297(a)(2) 50% asset test";
}
pub relation foreign_corporation_1297(corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the corporation is a foreign corporation, for section 1297(a)";
}

@source(IRC_S1297_A, relation = formalizes, coverage = exact, quote = "75 percent or more of the gross income of such corporation for the taxable year is passive income")
pub relation passive_foreign_investment_company(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the foreign corporation is a passive foreign investment company for the taxable year (section 1297(a)): 75% or more of its gross income is passive income, or at least 50% of its assets (average) produce or are held for producing passive income";
}
// boundary named by the owner's task: 75% qualifies ("75 percent or more"),
// 74.9% does not.
rule S1297A1IncomeTest defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ratio: Decimal;
    when foreign_corporation_1297(corp)
     and gross_income_passive_ratio(corp, y, ratio)
     and ratio >= 0.75;
    then passive_foreign_investment_company(corp, y);
}
@source(IRC_S1297_A, relation = formalizes, coverage = exact, quote = "the average percentage of assets (as determined in accordance with subsection (e)) held by such corporation during the taxable year which produce passive income or which are held for the production of passive income is at least 50 percent")
rule S1297A2AssetTest defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for ratio: Decimal;
    when foreign_corporation_1297(corp)
     and average_passive_asset_ratio(corp, y, ratio)
     and ratio >= 0.50;
    then passive_foreign_investment_company(corp, y);
}

// --- §1297(b): passive income, with the related-person exception ----------
//
// Stage 2b (IRC-10 stage 2b, A13). (b)(1) links to `10-subpart-f.law`'s own
// section 954(c) FPHCI classification (bare intra-package reference);
// (b)(2)(C) the related-person exception reuses that module's
// `related_person_954d3` concept directly (the statute itself substitutes
// "foreign corporation" for "controlled foreign corporation" in section
// 954(d)(3) — not independently re-derived, since the underlying relation
// is generic over any `us.irc.core::Corporation`). (b)(2)(A)/(B)/(D) (active
// banking/insurance business, export trade corporation) are NOT modeled —
// TECH_GAP.

pub relation gross_income_item_1297b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en unofficial "an item of the foreign corporation's gross income, for classification under section 1297(b)";
}
@source(IRC_S1297_B, relation = formalizes, coverage = exact, quote = "the term \"passive income\" means any income which is of a kind which would be foreign personal holding company income as defined in section 954(c)")
pub relation passive_income_1297(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind institutional {
    label en official "the item is passive income for section 1297(b): of a kind that would be foreign personal holding company income under section 954(c), unless received from a related person out of that related person's non-passive income (the (2)(C) exception)";
}
rule S1297B1PassiveIncomeByFphciKind defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for item_id: Text;
    when gross_income_item_1297b(corp, y, item_id)
     and foreign_personal_holding_company_income_item(corp, y, item_id);
    unless received_from_related_person_out_of_non_passive_income_1297b2c(corp, y, item_id)
     and gross_income_item_1297b(corp, y, item_id);
    then passive_income_1297(corp, y, item_id);
}
pub relation received_from_related_person_out_of_non_passive_income_1297b2c(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, item_id: Text) kind empirical {
    label en unofficial "the interest, dividend, rent, or royalty is received from a related person (section 954(d)(3), substituting 'foreign corporation' for 'controlled foreign corporation') to the extent properly allocable to that related person's non-passive income, for the section 1297(b)(2)(C) exception";
}

// --- §1297(c): look-through for 25-percent-owned corporations -------------

pub relation owns_at_least_25_percent_by_value(parent: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, share: Decimal) kind empirical {
    label en unofficial "the foreign corporation owns, directly or indirectly, this share (by value) of another corporation's stock, for the section 1297(c) 25%-look-through test";
}
pub relation subsidiary_passive_income_amount(subsidiary: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the subsidiary's income for the taxable year, for the section 1297(c)(2) proportionate-share look-through";
}
pub relation subsidiary_assets_amount(subsidiary: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the subsidiary's assets for the taxable year, for the section 1297(c)(1) proportionate-share look-through";
}
@source(IRC_S1297_C, relation = formalizes, coverage = exact, quote = "such foreign corporation shall be treated as if it—\n(1) held its proportionate share of the assets of such other corporation, and\n(2) received directly its proportionate share of the income of such other corporation")
pub relation look_through_proportionate_share_1297c(parent: us.irc.core::Corporation, subsidiary: us.irc.core::Corporation, y: us.irc.core::TaxableYear, asset_share: Money, income_share: Money) kind institutional {
    label en official "under the section 1297(c) 25%-look-through, the parent foreign corporation is treated as holding its proportionate share of the 25%-or-more-owned subsidiary's assets and receiving its proportionate share of the subsidiary's income directly, for purposes of the section 1297(a) PFIC tests";
}
rule S1297CLookThroughAtLeastTwentyFivePercent defeasible {
    for parent: us.irc.core::Corporation;
    for subsidiary: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for share: Decimal;
    for assets: Money;
    for income: Money;
    when owns_at_least_25_percent_by_value(parent, subsidiary, share)
     and share >= 0.25
     and subsidiary_assets_amount(subsidiary, y, assets)
     and subsidiary_passive_income_amount(subsidiary, y, income);
    then look_through_proportionate_share_1297c(parent, subsidiary, y, round(assets * share, 2, "HALF_UP"), round(income * share, 2, "HALF_UP"));
}

// --- §1295: qualified electing fund election, as a power -------------------

pub relation elects_qef_1295(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the taxpayer makes the section 1295(b) qualified-electing-fund election with respect to the passive foreign investment company, for the taxable year";
}
pub relation pfic_complies_with_qef_reporting_requirements(corp: us.irc.core::Corporation) kind empirical {
    label en official "the passive foreign investment company complies with the Secretary's requirements for determining ordinary earnings and net capital gain and otherwise carrying out this subpart, for section 1295(a)(2)";
}
@source(IRC_S1295_A, relation = formalizes, coverage = exact, quote = "any passive foreign investment company shall be treated as a qualified electing fund with respect to the taxpayer if—\n(1) an election by the taxpayer under subsection (b) applies to such company for the taxable year, and\n(2) such company complies with such requirements as the Secretary may prescribe")
pub relation qualified_electing_fund(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "the passive foreign investment company is treated as a qualified electing fund with respect to the taxpayer (section 1295(a)): the taxpayer's section 1295(b) election applies and the company complies with the Secretary's ordinary-earnings/net-capital-gain reporting requirements";
}
rule S1295AQualifiedElectingFundPower defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when elects_qef_1295(p, corp)
     and pfic_complies_with_qef_reporting_requirements(corp);
    then power S1295QefElection {
        holder p;
        over corp;
        exercise elects_qef_1295(p, corp);
        valid_when pfic_complies_with_qef_reporting_requirements(corp);
        effect create(qualified_electing_fund(p, corp));
    };
}

// --- §1296: mark-to-market election, as a power, with (b)-(d) ------------

pub relation elects_mark_to_market_1296(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind empirical {
    label en unofficial "the United States person makes the section 1296(a) mark-to-market election with respect to marketable stock in the passive foreign investment company";
}
pub relation marketable_stock_1296(corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock in the passive foreign investment company is marketable stock within the meaning of section 1296(e), for the section 1296(a) election's eligibility condition";
}
pub relation pfic_stock_fair_market_value(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the fair market value of the United States person's marketable PFIC stock as of the close of the taxable year, for section 1296(a)(1)-(2)";
}
pub relation pfic_stock_adjusted_basis(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the adjusted basis of the United States person's marketable PFIC stock as of the close of the taxable year, for section 1296(a)(1)-(2)";
}
pub relation unreversed_inclusions_1296d(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the excess of prior-year section 1296(a)(1) inclusions over prior-year section 1296(a)(2) deductions with respect to this stock, for the section 1296(d) 'unreversed inclusions' limitation on the (a)(2) deduction — asserted directly rather than accumulated year over year (TECH-GAPS G330 class)";
}
@source(IRC_S1296_A, relation = formalizes, coverage = partial, quote = "If the fair market value of such stock as of the close of such taxable year exceeds its adjusted basis, such United States person shall include in gross income for such taxable year an amount equal to the amount of such excess.")
pub relation mtm_inclusion_1296a1(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1296(a)(1) mark-to-market inclusion: the excess of the PFIC stock's fair market value over its adjusted basis at year end";
}
rule S1296A1MarkToMarketInclusion defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for fmv: Money;
    for basis: Money;
    when mark_to_market_1296_effective(p, corp)
     and pfic_stock_fair_market_value(p, corp, y, fmv)
     and pfic_stock_adjusted_basis(p, corp, y, basis)
     and fmv > basis;
    then mtm_inclusion_1296a1(p, corp, y, fmv - basis);
}
@source(IRC_S1296_A, relation = formalizes, coverage = partial, quote = "If the adjusted basis of such stock exceeds the fair market value of such stock as of the close of such taxable year, such United States person shall be allowed a deduction for such taxable year equal to the lesser of—\n(A) the amount of such excess, or\n(B) the unreversed inclusions with respect to such stock")
pub relation mtm_deduction_1296a2(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1296(a)(2) mark-to-market deduction: the lesser of the PFIC stock's basis-over-FMV excess, or the section 1296(d) unreversed inclusions for that stock";
}
rule S1296A2MarkToMarketDeduction defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for fmv: Money;
    for basis: Money;
    for unreversed: Money;
    when mark_to_market_1296_effective(p, corp)
     and pfic_stock_fair_market_value(p, corp, y, fmv)
     and pfic_stock_adjusted_basis(p, corp, y, basis)
     and unreversed_inclusions_1296d(p, corp, y, unreversed)
     and basis > fmv;
    then mtm_deduction_1296a2(p, corp, y, min(basis - fmv, unreversed));
}
pub relation mark_to_market_1296_effective(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "the section 1296 mark-to-market election is in effect for the United States person's marketable PFIC stock";
}
rule S1296MarkToMarketElectionPower defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when elects_mark_to_market_1296(p, corp)
     and marketable_stock_1296(corp);
    then power S1296MarkToMarketElection {
        holder p;
        over corp;
        exercise elects_mark_to_market_1296(p, corp);
        valid_when marketable_stock_1296(corp);
        effect create(mark_to_market_1296_effective(p, corp));
    };
}
@source(IRC_S1296_B, relation = formalizes, coverage = exact, quote = "shall be increased by the amount included in the gross income of the United States person under subsection (a)(1) with respect to such stock, and\n(B) shall be decreased by the amount allowed as a deduction to the United States person under subsection (a)(2) with respect to such stock")
pub relation pfic_stock_basis_after_1296b_adjustment(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1296(b)(1) basis adjustment: the PFIC stock's adjusted basis, increased by the year's (a)(1) inclusion and decreased by the year's (a)(2) deduction";
}
rule S1296B1BasisAdjustmentWithInclusion defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basis: Money;
    for inclusion: Money;
    when pfic_stock_adjusted_basis(p, corp, y, basis)
     and mtm_inclusion_1296a1(p, corp, y, inclusion);
    then pfic_stock_basis_after_1296b_adjustment(p, corp, y, basis + inclusion);
}
rule S1296B1BasisAdjustmentWithDeduction defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for basis: Money;
    for deduction: Money;
    when pfic_stock_adjusted_basis(p, corp, y, basis)
     and mtm_deduction_1296a2(p, corp, y, deduction);
    then pfic_stock_basis_after_1296b_adjustment(p, corp, y, basis - deduction);
}
@source(IRC_S1296_C, relation = formalizes, coverage = exact, quote = "Any amount included in gross income under subsection (a)(1), and any gain on the sale or other disposition of marketable stock in a passive foreign investment company (with respect to which an election under this section is in effect), shall be treated as ordinary income.")
pub relation mtm_1296c1_ordinary_gain(p: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1296(a)(1) inclusion is treated as ordinary income (section 1296(c)(1)(A))";
}
rule S1296C1AOrdinaryIncomeCharacter defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when mtm_inclusion_1296a1(p, corp, y, amount);
    then mtm_1296c1_ordinary_gain(p, corp, y, amount);
}
