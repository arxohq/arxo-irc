// §985 functional currency; §986 foreign income taxes, earnings and profits,
// previously taxed E&P; §987 branch transactions (translation core); §988(b)-(d)
// definitions and hedging; §989(a)-(b) qualified business unit and appropriate
// exchange rate; §964(a),(d),(e) earnings and profits, insurance branches,
// sales of stock by a controlled foreign corporation; §982 foreign-based
// documentation. Stage 2c (IRC-10 stage 2c, A13). Module 17 carries §988(a),
// (c)(1), (e).
//
// Exchange rates are case-supplied Decimal amounts (units of dollars per unit
// of foreign currency); a translation multiplies the foreign amount by the
// statutory rate. The module does not derive average or spot rates.

// --- §985: functional currency ------------------------------------------------

use self::{
    IRC_S964_D,
    IRC_S964_E,
    IRC_S982_A,
    IRC_S982_B,
    IRC_S982_C,
    IRC_S985_B,
    IRC_S986_A,
    IRC_S986_B,
    IRC_S986_C,
    IRC_S987,
    IRC_S988_B,
    IRC_S988_D,
    IRC_S989_A,
    IRC_S989_B,
};

pub relation qualified_business_unit_activities_primarily_in_dollars_985b2(unit_id: Text) kind empirical {
    label en official "the activities of the qualified business unit are primarily conducted in dollars";
}
pub relation qbu_economic_environment_currency_985b1B(unit_id: Text, currency: Text) kind empirical {
    label en official "the currency of the economic environment in which a significant part of the unit's activities are conducted and which the unit uses in keeping its books and records";
}
pub relation elects_dollar_functional_currency_985b3(unit_id: Text) kind empirical {
    label en official "the taxpayer elects to use the dollar as the functional currency for the unit (to the extent regulations provide), the unit keeping its books in dollars or the taxpayer using a method approximating a separate transactions method";
}
pub relation qbu_is_dollar_functional_985b1(unit_id: Text) kind institutional {
    label en official "the functional currency of the unit is the dollar (dollar activities, or an election, or the general dollar rule)";
}
@source(IRC_S985_B, relation = formalizes, coverage = exact, quote = "The functional currency of any qualified business unit shall be the dollar if activities of such unit are primarily conducted in dollars.")
rule S985B2DollarWhenActivitiesInDollars defeasible {
    for unit_id: Text;
    when qualified_business_unit_activities_primarily_in_dollars_985b2(unit_id);
    then qbu_is_dollar_functional_985b1(unit_id);
}
@source(IRC_S985_B, relation = formalizes, coverage = partial, quote = "To the extent provided in regulations, the taxpayer may elect to use the dollar as the functional currency for any qualified business unit if—")
rule S985B3ElectionPower strict {
    for unit_id: Text;
    for p: us.irc.core::Person;
    when elects_dollar_functional_currency_985b3(unit_id)
     and unit_owner_985(p, unit_id);
    then power S985B3DollarElection {
        holder p;
        over p;
        exercise elects_dollar_functional_currency_985b3(unit_id);
        valid_when unit_keeps_books_in_dollars_or_approximates_separate_transactions_985b3(unit_id);
        effect create(qbu_is_dollar_functional_985b1(unit_id));
    };
}
pub relation unit_owner_985(p: us.irc.core::Person, unit_id: Text) kind empirical {
    label en unofficial "the taxpayer owning the qualified business unit (a domain anchor)";
}
pub relation unit_keeps_books_in_dollars_or_approximates_separate_transactions_985b3(unit_id: Text) kind empirical {
    label en official "the unit keeps its books and records in dollars, or the taxpayer uses a method of accounting that approximates a separate transactions method";
}
pub relation functional_currency_985b1(unit_id: Text, currency: Text) kind institutional {
    label en official "the functional currency of the unit: the dollar, or for a qualified business unit the currency of its economic environment (section 985(b)(1)-(2))";
}
rule S985B1ADollarFunctionalCurrency defeasible {
    for unit_id: Text;
    when qbu_is_dollar_functional_985b1(unit_id);
    then functional_currency_985b1(unit_id, "USD");
}
@source(IRC_S985_B, relation = formalizes, coverage = exact, quote = "(B) in the case of a qualified business unit, the currency of the economic environment in which a significant part of such unit's activities are conducted and which is used by such unit in keeping its books and records.")
rule S985B1BEconomicEnvironmentCurrency defeasible {
    for unit_id: Text;
    for currency: Text;
    when qbu_economic_environment_currency_985b1B(unit_id, currency);
    unless qbu_is_dollar_functional_985b1(unit_id)
     and qbu_economic_environment_currency_985b1B(unit_id, currency);
    then functional_currency_985b1(unit_id, currency);
}

// --- §986(a): translation of foreign income taxes ---------------------------

pub relation foreign_income_tax_accrual_986a1(p: us.irc.core::Person, tax_id: Text, foreign_amount: Money, year_paid_offset_years: Integer) kind empirical {
    label en official "a foreign income tax accrued by a taxpayer who takes foreign income taxes into account when accrued, in a foreign currency amount (Money units here are units of the foreign currency), and the number of years between the close of the taxable year to which it relates and its payment (negative when paid before the year began)";
}
pub relation average_exchange_rate_for_tax_year_986a1A(tax_id: Text, rate: Decimal) kind empirical {
    label en official "the average exchange rate for the taxable year to which the tax relates";
}
pub relation exchange_rate_at_payment_986a2A(tax_id: Text, rate: Decimal) kind empirical {
    label en official "the exchange rate as of the time the tax was paid to the foreign country or possession";
}
pub relation tax_liability_in_inflationary_currency_986a1C(tax_id: Text) kind empirical {
    label en official "the liability for the tax is denominated in an inflationary currency (as determined under regulations)";
}
pub relation elects_986a1D_exception_for_non_functional_currency(p: us.irc.core::Person, tax_id: Text) kind empirical {
    label en official "the taxpayer elects that the average-rate rule does not apply to taxes denominated in a currency other than the taxpayer's functional currency";
}
pub relation tax_denominated_in_non_functional_currency_986a1D(tax_id: Text) kind empirical {
    label en official "the liability for the tax is denominated in a currency other than the taxpayer's functional currency";
}
pub relation taxpayer_is_regulated_investment_company_accrual_986a1E(p: us.irc.core::Person) kind empirical {
    label en official "the taxpayer is a regulated investment company that takes income into account on an accrual basis";
}
pub relation average_rate_applies_to_tax_986a1(p: us.irc.core::Person, tax_id: Text) kind institutional {
    label en official "the average exchange rate rule of section 986(a)(1)(A) applies to the tax: not for taxes paid more than 2 years after the year's close or before its start, not for inflationary currency, not under the (D) election, and not for a RIC on the accrual basis";
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "the amount of any foreign income taxes (and any adjustment thereto) shall be translated into dollars by using the average exchange rate for the taxable year to which such taxes relate.")
rule S986A1AAverageRateApplies defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    for offset: Integer;
    when foreign_income_tax_accrual_986a1(p, tax_id, amount, offset)
     and offset <= 2
     and offset >= 0;
    unless tax_liability_in_inflationary_currency_986a1C(tax_id)
     and foreign_income_tax_accrual_986a1(p, tax_id, amount, offset);
    unless elects_986a1D_exception_for_non_functional_currency(p, tax_id)
     and tax_denominated_in_non_functional_currency_986a1D(tax_id)
     and foreign_income_tax_accrual_986a1(p, tax_id, amount, offset);
    unless taxpayer_is_regulated_investment_company_accrual_986a1E(p)
     and foreign_income_tax_accrual_986a1(p, tax_id, amount, offset);
    then average_rate_applies_to_tax_986a1(p, tax_id);
}
pub relation dollars_of_foreign_income_tax_986a(p: us.irc.core::Person, tax_id: Text, dollars: Money) kind institutional {
    label en official "the dollar amount of the foreign income tax for the foreign tax credit: at the year's average rate where paragraph (1)(A) applies, otherwise at the rate as of the time of payment (section 986(a)(1)(A), (2)(A))";
}
rule S986A1ATranslateAtAverageRate defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    for offset: Integer;
    for rate: Decimal;
    when average_rate_applies_to_tax_986a1(p, tax_id)
     and foreign_income_tax_accrual_986a1(p, tax_id, amount, offset)
     and average_exchange_rate_for_tax_year_986a1A(tax_id, rate);
    then dollars_of_foreign_income_tax_986a(p, tax_id, round(amount * rate, 2, "HALF_UP"));
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "(A) such taxes shall be translated into dollars using the exchange rates as of the time such taxes were paid to the foreign country or possession of the United States, and")
rule S986A2ATranslateAtPaymentRate defeasible {
    for p: us.irc.core::Person;
    for tax_id: Text;
    for amount: Money;
    for offset: Integer;
    for rate: Decimal;
    when foreign_income_tax_accrual_986a1(p, tax_id, amount, offset)
     and exchange_rate_at_payment_986a2A(tax_id, rate);
    unless average_rate_applies_to_tax_986a1(p, tax_id)
     and foreign_income_tax_accrual_986a1(p, tax_id, amount, offset)
     and exchange_rate_at_payment_986a2A(tax_id, rate);
    then dollars_of_foreign_income_tax_986a(p, tax_id, round(amount * rate, 2, "HALF_UP"));
}
pub relation refund_of_foreign_income_tax_986a2B(tax_id: Text, foreign_amount: Money, original_payment_rate: Decimal) kind empirical {
    label en official "a refund or credit of foreign income taxes and the exchange rate as of the time of the original payment";
}
pub relation dollars_of_refund_986a2Bii(tax_id: Text, dollars: Money) kind institutional {
    label en official "a refund or credit of foreign income taxes is translated at the exchange rate as of the time of the original payment (section 986(a)(2)(B)(ii))";
}
@source(IRC_S986_A, relation = formalizes, coverage = exact, quote = "(ii) in the case of any refund or credit of foreign income taxes, using the exchange rate as of the time of the original payment of such foreign income taxes.")
rule S986A2BiiRefundAtOriginalPaymentRate defeasible {
    for tax_id: Text;
    for amount: Money;
    for rate: Decimal;
    when refund_of_foreign_income_tax_986a2B(tax_id, amount, rate);
    then dollars_of_refund_986a2Bii(tax_id, round(amount * rate, 2, "HALF_UP"));
}
pub relation adjustment_paid_to_foreign_country_986a2Bi(tax_id: Text, foreign_amount: Money, rate_at_adjustment_payment: Decimal) kind empirical {
    label en official "an adjustment to the tax (other than a refund or credit) paid to the foreign country or possession, and the exchange rate as of the time the adjustment is paid";
}
pub relation dollars_of_adjustment_986a2Bi(tax_id: Text, dollars: Money) kind institutional {
    label en official "an adjustment to the tax is translated at the exchange rate as of the time the adjustment is paid (section 986(a)(2)(B)(i))";
}
rule S986A2BiAdjustmentAtAdjustmentPaymentRate defeasible {
    for tax_id: Text;
    for amount: Money;
    for rate: Decimal;
    when adjustment_paid_to_foreign_country_986a2Bi(tax_id, amount, rate);
    then dollars_of_adjustment_986a2Bi(tax_id, round(amount * rate, 2, "HALF_UP"));
}

// --- §986(b), (c) ---------------------------------------------------------------

pub relation cfc_earnings_and_profits_in_functional_currency_986b1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, foreign_amount: Money) kind empirical {
    label en official "the earnings and profits of the foreign corporation determined in its functional currency";
}
pub relation appropriate_exchange_rate_986b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the appropriate exchange rate (section 989(b)) for the earnings and profits when distributed, deemed distributed or otherwise taken into account";
}
pub relation earnings_and_profits_in_dollars_986b2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, dollars: Money) kind institutional {
    label en official "the earnings and profits of a foreign corporation, determined in its functional currency, translated into dollars at the appropriate exchange rate for a United States person (section 986(b))";
}
@source(IRC_S986_B, relation = formalizes, coverage = exact, quote = "(2) in the case of any United States person, the earnings and profits determined under paragraph (1) (when distributed, deemed distributed, or otherwise taken into account under this subtitle) shall (if necessary) be translated into dollars using the appropriate exchange rate.")
rule S986BTranslateEarningsAndProfits defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when cfc_earnings_and_profits_in_functional_currency_986b1(corp, y, amount)
     and appropriate_exchange_rate_986b2(corp, y, rate);
    then earnings_and_profits_in_dollars_986b2(corp, y, round(amount * rate, 2, "HALF_UP"));
}
pub relation ptep_distribution_dollars_at_actual_distribution_986c(p: us.irc.core::Person, corp: us.irc.core::Corporation, dollars_at_actual: Money, dollars_at_deemed: Money) kind empirical {
    label en official "a distribution of previously taxed earnings and profits (section 959 or 1293(c)): the dollar value at the actual distribution date and at the earlier deemed distribution (inclusion) date";
}
pub relation section_986c_currency_gain_or_loss(p: us.irc.core::Person, corp: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "foreign currency gain (positive) or loss (negative) on a distribution of previously taxed earnings and profits, attributable to exchange rate movements between deemed and actual distribution: the difference in dollar values, recognized as ordinary income or loss from the same source as the inclusion (section 986(c)(1))";
}
@source(IRC_S986_C, relation = formalizes, coverage = exact, quote = "Foreign currency gain or loss with respect to distributions of previously taxed earnings and profits (as described in section 959 or 1293(c)) attributable to movements in exchange rates between the times of deemed and actual distribution shall be recognized and treated as ordinary income or loss from the same source as the associated income inclusion.")
rule S986C1PreviouslyTaxedDistributionCurrencyGain defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for actual: Money;
    for deemed: Money;
    when ptep_distribution_dollars_at_actual_distribution_986c(p, corp, actual, deemed);
    then section_986c_currency_gain_or_loss(p, corp, actual - deemed);
}

// --- §987: branch transactions (translation core) -------------------------------

pub relation qbu_income_in_functional_currency_987(unit_id: Text, y: us.irc.core::TaxableYear, foreign_amount: Money) kind empirical {
    label en official "the taxable income (positive) or loss (negative) of the qualified business unit computed separately in its functional currency";
}
pub relation appropriate_exchange_rate_for_unit_987(unit_id: Text, y: us.irc.core::TaxableYear, rate: Decimal) kind empirical {
    label en official "the appropriate exchange rate for the unit (section 989(b)(4): the average rate for the unit's taxable year)";
}
pub relation qbu_income_in_dollars_987(unit_id: Text, y: us.irc.core::TaxableYear, dollars: Money) kind institutional {
    label en official "the income or loss of a qualified business unit with a non-dollar functional currency, computed in that currency and translated at the appropriate exchange rate (section 987(1)-(2))";
}
@source(IRC_S987, relation = formalizes, coverage = partial, quote = "(2) by translating the income or loss separately computed under paragraph (1) at the appropriate exchange rate, and")
rule S987TranslateUnitIncome defeasible {
    for unit_id: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for rate: Decimal;
    when qbu_income_in_functional_currency_987(unit_id, y, amount)
     and appropriate_exchange_rate_for_unit_987(unit_id, y, rate);
    then qbu_income_in_dollars_987(unit_id, y, round(amount * rate, 2, "HALF_UP"));
}

// --- §988(b)-(d) ----------------------------------------------------------------

pub relation section_988_transaction_gain_or_loss_988b(tx_id: Text, total_gain_or_loss: Money, exchange_rate_gain_or_loss_between_booking_and_payment: Money) kind empirical {
    label en official "the gain (positive) or loss (negative) from a section 988 transaction, and the gain or loss realized by reason of changes in exchange rates on or after the booking date and before the payment date";
}
pub relation foreign_currency_gain_988b1(tx_id: Text, amount: Money) kind institutional {
    label en official "foreign currency gain: gain from a section 988 transaction to the extent it does not exceed the gain realized by reason of exchange rate changes between the booking date and the payment date (section 988(b)(1))";
}
@source(IRC_S988_B, relation = formalizes, coverage = exact, quote = "The term \"foreign currency gain\" means any gain from a section 988 transaction to the extent such gain does not exceed gain realized by reason of changes in exchange rates on or after the booking date and before the payment date.")
rule S988B1ForeignCurrencyGain defeasible {
    for tx_id: Text;
    for total: Money;
    for fx: Money;
    when section_988_transaction_gain_or_loss_988b(tx_id, total, fx)
     and total > 0.00 USD
     and fx > 0.00 USD;
    then foreign_currency_gain_988b1(tx_id, min(total, fx));
}
pub relation foreign_currency_loss_988b2(tx_id: Text, amount: Money) kind institutional {
    label en official "foreign currency loss (positive magnitude): loss from a section 988 transaction to the extent it does not exceed the loss realized by reason of exchange rate changes between the booking date and the payment date (section 988(b)(2))";
}
@source(IRC_S988_B, relation = formalizes, coverage = exact, quote = "The term \"foreign currency loss\" means any loss from a section 988 transaction to the extent such loss does not exceed the loss realized by reason of changes in exchange rates on or after the booking date and before the payment date.")
rule S988B2ForeignCurrencyLoss defeasible {
    for tx_id: Text;
    for total: Money;
    for fx: Money;
    when section_988_transaction_gain_or_loss_988b(tx_id, total, fx)
     and total < 0.00 USD
     and fx < 0.00 USD;
    then foreign_currency_loss_988b2(tx_id, min(0.00 USD - total, 0.00 USD - fx));
}
pub relation transaction_is_988c1Biii_contract_option_or_instrument_988b3(tx_id: Text) kind empirical {
    label en official "the section 988 transaction is one described in subsection (c)(1)(B)(iii) (a forward contract, futures contract, option or similar instrument)";
}
pub relation entire_gain_or_loss_is_foreign_currency_988b3(tx_id: Text, amount: Money) kind institutional {
    label en official "for a transaction described in section 988(c)(1)(B)(iii), any gain or loss is foreign currency gain or loss (section 988(b)(3))";
}
@source(IRC_S988_B, relation = formalizes, coverage = exact, quote = "In the case of any section 988 transaction described in subsection (c)(1)(B)(iii), any gain or loss from such transaction shall be treated as foreign currency gain or loss (as the case may be).")
rule S988B3FullyForeignCurrencyForContracts defeasible {
    for tx_id: Text;
    for total: Money;
    for fx: Money;
    when transaction_is_988c1Biii_contract_option_or_instrument_988b3(tx_id)
     and section_988_transaction_gain_or_loss_988b(tx_id, total, fx);
    then entire_gain_or_loss_is_foreign_currency_988b3(tx_id, total);
}
pub relation transaction_acquired_or_obligor_on_988c2A(tx_id: Text, on: Date) kind empirical {
    label en official "the date of acquisition or on which the taxpayer becomes the obligor, for a transaction described in (c)(1)(B)(i)";
}
pub relation transaction_accrued_on_988c2B(tx_id: Text, on: Date) kind empirical {
    label en official "the date the item accrued or was otherwise taken into account, for a transaction described in (c)(1)(B)(ii)";
}
pub relation booking_date_988c2(tx_id: Text, on: Date) kind institutional {
    label en official "the booking date: the acquisition or obligor date (debt instrument) or the date accrued or taken into account (payables and receivables) (section 988(c)(2))";
}
rule S988C2ABookingDateAcquisition defeasible {
    for tx_id: Text;
    for on: Date;
    when transaction_acquired_or_obligor_on_988c2A(tx_id, on);
    then booking_date_988c2(tx_id, on);
}
rule S988C2BBookingDateAccrual defeasible {
    for tx_id: Text;
    for on: Date;
    when transaction_accrued_on_988c2B(tx_id, on);
    then booking_date_988c2(tx_id, on);
}
pub relation elects_988d_integration_of_hedge(p: us.irc.core::Person, tx_id: Text) kind empirical {
    label en official "a section 988 transaction is part of a 988 hedging transaction and the regulations integrate them";
}
pub relation hedging_transaction_entered_primarily_to_manage_currency_risk_988d2A(tx_id: Text) kind empirical {
    label en official "the transaction is entered into by the taxpayer primarily to manage the risk of currency fluctuations with respect to property held or to be held, or borrowings made or to be made or obligations incurred or to be incurred";
}
pub relation hedging_transaction_identified_988d2B(tx_id: Text) kind empirical {
    label en official "the transaction is identified by the Secretary or the taxpayer as being a 988 hedging transaction";
}
pub relation section_988_hedging_transaction_988d2(tx_id: Text) kind institutional {
    label en official "a 988 hedging transaction: entered into primarily to manage currency risk on held property or borrowings or obligations, and identified as such (section 988(d)(2))";
}
@source(IRC_S988_D, relation = formalizes, coverage = exact, quote = "For purposes of paragraph (1), the term \"988 hedging transaction\" means any transaction—")
rule S988D2HedgingTransaction defeasible {
    for tx_id: Text;
    when hedging_transaction_entered_primarily_to_manage_currency_risk_988d2A(tx_id)
     and hedging_transaction_identified_988d2B(tx_id);
    then section_988_hedging_transaction_988d2(tx_id);
}

// --- §989(a)-(b) ----------------------------------------------------------------

pub relation unit_of_trade_or_business_separate_and_clearly_identified_989a(unit_id: Text) kind empirical {
    label en official "a separate and clearly identified unit of a trade or business of the taxpayer";
}
pub relation unit_maintains_separate_books_and_records_989a(unit_id: Text) kind empirical {
    label en official "the unit maintains separate books and records";
}
pub relation qualified_business_unit_989a(unit_id: Text) kind institutional {
    label en official "a qualified business unit: a separate and clearly identified unit of a trade or business of a taxpayer which maintains separate books and records (section 989(a))";
}
@source(IRC_S989_A, relation = formalizes, coverage = exact, quote = "the term \"qualified business unit\" means any separate and clearly identified unit of a trade or business of a taxpayer which maintains separate books and records.")
rule S989AQualifiedBusinessUnit defeasible {
    for unit_id: Text;
    when unit_of_trade_or_business_separate_and_clearly_identified_989a(unit_id)
     and unit_maintains_separate_books_and_records_989a(unit_id);
    then qualified_business_unit_989a(unit_id);
}
pub relation exchange_rate_context_989b(item_id: Text, kind: Text) kind empirical {
    label en official "the kind of amount being translated: `actual_distribution`, `1248_deemed_dividend`, `951a1A_or_1293a_inclusion`, `951a1B_inclusion`, or `other_qbu`";
}
pub relation spot_rate_on_inclusion_date_989b(item_id: Text, rate: Decimal) kind empirical {
    label en official "the spot rate on the date the distribution or deemed dividend is included in income";
}
pub relation average_rate_for_foreign_corporation_year_989b3(item_id: Text, rate: Decimal) kind empirical {
    label en official "the average exchange rate for the taxable year of the foreign corporation";
}
pub relation average_rate_for_qbu_year_989b4(item_id: Text, rate: Decimal) kind empirical {
    label en official "the average exchange rate for the taxable year of the qualified business unit";
}
pub relation appropriate_exchange_rate_989b(item_id: Text, rate: Decimal) kind institutional {
    label en official "the appropriate exchange rate: the spot rate on the inclusion date for an actual distribution and for a section 1248 deemed dividend; the foreign corporation's average rate for section 951(a)(1)(A) and 1293(a) inclusions; the unit's average rate for any other unit (section 989(b)); a section 951(a)(1)(B) inclusion is an actual distribution on the last day of the year (the date is a case input)";
}
@source(IRC_S989_B, relation = formalizes, coverage = exact, quote = "(1) in the case of an actual distribution of earnings and profits, the spot rate on the date such distribution is included in income,")
rule S989B1ActualDistributionSpotRate defeasible {
    for item_id: Text;
    for rate: Decimal;
    when exchange_rate_context_989b(item_id, "actual_distribution")
     and spot_rate_on_inclusion_date_989b(item_id, rate);
    then appropriate_exchange_rate_989b(item_id, rate);
}
@source(IRC_S989_B, relation = formalizes, coverage = exact, quote = "(2) in the case of an actual or deemed sale or exchange of stock in a foreign corporation treated as a dividend under section 1248, the spot rate on the date the deemed dividend is included in income,")
rule S989B2DeemedDividendSpotRate defeasible {
    for item_id: Text;
    for rate: Decimal;
    when exchange_rate_context_989b(item_id, "1248_deemed_dividend")
     and spot_rate_on_inclusion_date_989b(item_id, rate);
    then appropriate_exchange_rate_989b(item_id, rate);
}
@source(IRC_S989_B, relation = formalizes, coverage = exact, quote = "(3) in the case of any amounts included in income under section 951(a)(1)(A) or 1293(a), the average exchange rate for the taxable year of the foreign corporation, or")
rule S989B3InclusionAverageRate defeasible {
    for item_id: Text;
    for rate: Decimal;
    when exchange_rate_context_989b(item_id, "951a1A_or_1293a_inclusion")
     and average_rate_for_foreign_corporation_year_989b3(item_id, rate);
    then appropriate_exchange_rate_989b(item_id, rate);
}
@source(IRC_S989_B, relation = formalizes, coverage = exact, quote = "(4) in the case of any other qualified business unit of a taxpayer, the average exchange rate for the taxable year of such qualified business unit.")
rule S989B4OtherUnitAverageRate defeasible {
    for item_id: Text;
    for rate: Decimal;
    when exchange_rate_context_989b(item_id, "other_qbu")
     and average_rate_for_qbu_year_989b4(item_id, rate);
    then appropriate_exchange_rate_989b(item_id, rate);
}
@source(IRC_S989_B, relation = formalizes, coverage = exact, quote = "For purposes of the preceding sentence, any amount included in income under section 951(a)(1)(B) shall be treated as an actual distribution made on the last day of the taxable year for which such amount was so included.")
rule S989BSection956InclusionIsActualDistributionOnLastDay defeasible {
    for item_id: Text;
    for rate: Decimal;
    when exchange_rate_context_989b(item_id, "951a1B_inclusion")
     and spot_rate_on_inclusion_date_989b(item_id, rate);
    then appropriate_exchange_rate_989b(item_id, rate);
}

// --- §964(a), (d), (e) ------------------------------------------------------------

pub relation cfc_earnings_and_profits_domestic_rules_964a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the earnings and profits (or deficit) of the foreign corporation for the year, determined by rules substantially similar to those applicable to domestic corporations (subject to section 312(k)(4)) and under regulations";
}
pub relation cfc_sells_stock_of_foreign_corporation_964e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text, gain: Money) kind empirical {
    label en official "a controlled foreign corporation sells or exchanges stock in another foreign corporation (or is treated as having gain from the sale of such stock under any provision of the subtitle), recognizing this gain";
}
pub relation gain_that_would_be_dividend_under_1248_964e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text, amount: Money) kind empirical {
    label en official "the extent to which the gain would have been included as a dividend under section 1248 if the controlled foreign corporation were a United States person";
}
pub relation cfc_stock_gain_treated_as_dividend_964e1(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text, amount: Money) kind institutional {
    label en official "gain on a sale or exchange by a controlled foreign corporation of stock in another foreign corporation is included in its gross income as a dividend to the same extent as under section 1248 (section 964(e)(1))";
}
@source(IRC_S964_E, relation = formalizes, coverage = exact, quote = "If a controlled foreign corporation sells or exchanges stock in any other foreign corporation, gain recognized on such sale or exchange shall be included in the gross income of such controlled foreign corporation as a dividend to the same extent that it would have been so included under section 1248")
rule S964E1GainAsDividend defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for stock_id: Text;
    for gain: Money;
    for as_dividend: Money;
    when cfc_sells_stock_of_foreign_corporation_964e1(corp, y, stock_id, gain)
     and gain_that_would_be_dividend_under_1248_964e1(corp, y, stock_id, as_dividend);
    then cfc_stock_gain_treated_as_dividend_964e1(corp, y, stock_id, min(gain, as_dividend));
}
pub relation dividend_by_964e_not_eligible_for_954c3Ai_exception_964e2(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text) kind institutional {
    label en official "clause (i) of section 954(c)(3)(A) (same-country related-person dividends) does not apply to an amount treated as a dividend by reason of paragraph (1) (section 964(e)(2))";
}
rule S964E2SameCountryExceptionDoesNotApply defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for stock_id: Text;
    for amount: Money;
    when cfc_stock_gain_treated_as_dividend_964e1(corp, y, stock_id, amount);
    then dividend_by_964e_not_eligible_for_954c3Ai_exception_964e2(corp, y, stock_id);
}
pub relation cfc_held_stock_one_year_or_more_964e4a(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text) kind empirical {
    label en official "the stock sold was held for 1 year or more (taxable years of the controlled foreign corporation beginning after December 31, 2017)";
}
pub relation foreign_source_portion_of_964e_dividend_964e4c(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text, amount: Money) kind empirical {
    label en official "the foreign-source portion of the dividend, determined as under section 245A(c)";
}
pub relation subpart_f_income_from_964e_dividend_964e4Ai(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, stock_id: Text, amount: Money) kind institutional {
    label en official "for a stock held for 1 year or more, the foreign-source portion of the section 964(e)(1) dividend is subpart F income of the selling controlled foreign corporation for the year (section 964(e)(4)(A)(i)), for taxable years beginning after December 31, 2017";
}
@source(IRC_S964_E, relation = formalizes, coverage = exact, quote = "(i) the foreign-source portion of such dividend shall be treated for purposes of section 951(a)(1)(A) as subpart F income of the selling controlled foreign corporation for such taxable year,")
rule S964E4AiForeignSourcePortionIsSubpartF defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for stock_id: Text;
    for amount: Money;
    for d: Date;
    when us.irc.core::begins(y, d)
     and d > @2017-12-31
     and cfc_stock_gain_treated_as_dividend_964e1(corp, y, stock_id, _)
     and cfc_held_stock_one_year_or_more_964e4a(corp, y, stock_id)
     and foreign_source_portion_of_964e_dividend_964e4c(corp, y, stock_id, amount);
    then subpart_f_income_from_964e_dividend_964e4Ai(corp, y, stock_id, amount);
}
pub relation qualified_insurance_branch_election_964d2D(branch_id: Text) kind empirical {
    label en official "an election under section 964(d)(2) applies to the branch (for the taxable year made and all later years unless revoked with the Secretary's consent)";
}
pub relation branch_licensed_and_predominantly_insurance_964d2(branch_id: Text) kind empirical {
    label en official "the branch of a controlled foreign corporation is licensed and predominantly engaged on a permanent basis in the active conduct of an insurance business in a foreign country";
}
pub relation branch_separate_books_964d2A(branch_id: Text) kind empirical {
    label en official "separate books and accounts are maintained for the branch";
}
pub relation branch_principal_place_in_country_964d2B(branch_id: Text) kind empirical {
    label en official "the principal place of business of the branch is in that foreign country";
}
pub relation branch_taxable_under_subchapter_l_if_domestic_964d2C(branch_id: Text) kind empirical {
    label en official "the branch would be taxable under subchapter L if it were a separate domestic corporation";
}
pub relation qualified_insurance_branch_964d2(branch_id: Text) kind institutional {
    label en official "a qualified insurance branch: licensed and predominantly engaged in an insurance business in a foreign country, with separate books, principal place of business there, subchapter L taxable if separate, and an election in effect (section 964(d)(2))";
}
@source(IRC_S964_D, relation = formalizes, coverage = exact, quote = "(D) an election under this paragraph applies to such branch.")
rule S964D2QualifiedInsuranceBranch defeasible {
    for branch_id: Text;
    when branch_licensed_and_predominantly_insurance_964d2(branch_id)
     and branch_separate_books_964d2A(branch_id)
     and branch_principal_place_in_country_964d2B(branch_id)
     and branch_taxable_under_subchapter_l_if_domestic_964d2C(branch_id)
     and qualified_insurance_branch_election_964d2D(branch_id);
    then qualified_insurance_branch_964d2(branch_id);
}
pub relation amount_transferred_or_credited_from_branch_964d1B(branch_id: Text, amount: Money) kind empirical {
    label en official "an amount directly or indirectly transferred or credited from the branch to one or more other accounts of the controlled foreign corporation";
}
pub relation branch_transfer_treated_as_dividend_964d1B(branch_id: Text, amount: Money) kind institutional {
    label en official "the amount transferred or credited from a qualified insurance branch to other accounts of the CFC is treated as a dividend paid to the CFC, and the branch as a separate foreign corporation, for this chapter and sections 6038 and 6046 (section 964(d)(1))";
}
@source(IRC_S964_D, relation = formalizes, coverage = partial, quote = "(B) except as provided in regulations, any amount directly or indirectly transferred or credited from such branch to one or more other accounts of such controlled foreign corporation shall be treated as a dividend paid to such controlled foreign corporation.")
rule S964D1BTransferIsDividend defeasible {
    for branch_id: Text;
    for amount: Money;
    when qualified_insurance_branch_964d2(branch_id)
     and amount_transferred_or_credited_from_branch_964d1B(branch_id, amount);
    then branch_transfer_treated_as_dividend_964d1B(branch_id, amount);
}

// --- §982: foreign-based documentation -----------------------------------------

pub relation formal_document_request_mailed_982c1(taxpayer: us.irc.core::Person, request_id: Text, mailed_on: Date) kind empirical {
    label en official "a formal document request (a request made after the normal request procedures have failed, for foreign-based documentation, mailed by registered or certified mail to the taxpayer's last known address, stating the time and place, the reason earlier documentation is insufficient, the documentation sought and the consequences of failure)";
}
pub relation taxpayer_substantially_complied_with_request_982a(taxpayer: us.irc.core::Person, request_id: Text) kind empirical {
    label en official "the taxpayer substantially complied with the formal document request";
}
pub relation quash_proceeding_begun_982c2(taxpayer: us.irc.core::Person, request_id: Text, begun_on: Date) kind empirical {
    label en official "a proceeding to quash the request begun on this date (right to begin not later than the 90th day after the request was mailed)";
}
pub relation quash_proceeding_pending_days_982c2C(taxpayer: us.irc.core::Person, request_id: Text, days: Integer) kind empirical {
    label en official "the number of days during which a proceeding to quash was pending (the 90-day period is suspended)";
}
pub relation compliance_period_ends_982a(taxpayer: us.irc.core::Person, request_id: Text, ends_on: Date) kind institutional {
    label en official "the end of the compliance period: the 90th day after the mailing of the request, extended by the days a quash proceeding was pending (section 982(a), (c)(2)(C)); extensions by the Secretary or a court ((d)(3)) are not modeled";
}
@source(IRC_S982_A, relation = formalizes, coverage = partial, quote = "If the taxpayer fails to substantially comply with any formal document request arising out of the examination of the tax treatment of any item (hereinafter in this section referred to as the \"examined item\") before the 90th day after the date of the mailing of such request")
rule S982AComplianceDeadlineNinetyDays defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for mailed_on: Date;
    when formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on);
    unless quash_proceeding_pending_days_982c2C(taxpayer, request_id, _)
     and formal_document_request_mailed_982c1(taxpayer, request_id, mailed_on);
    then compliance_period_ends_982a(taxpayer, request_id, add_calendar_period(mailed_on, 90 calendar_day));
}
pub relation compliance_period_suspended_982c2C(taxpayer: us.irc.core::Person, request_id: Text) kind institutional {
    label en official "the running of the 90-day period is suspended while a proceeding to quash is pending (section 982(c)(2)(C)); the extended end date is not computed (technical gap: variable-length calendar arithmetic)";
}
@source(IRC_S982_C, relation = formalizes, coverage = partial, quote = "The running of the 90-day period referred to in subsection (a) shall be suspended during any period during which a proceeding brought under subparagraph (A) is pending.")
rule S982C2CDeadlineSuspendedForQuashProceeding defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for pending: Integer;
    when quash_proceeding_pending_days_982c2C(taxpayer, request_id, pending)
     and pending > 0;
    then compliance_period_suspended_982c2C(taxpayer, request_id);
}
pub relation reasonable_cause_for_failure_982b1(taxpayer: us.irc.core::Person, request_id: Text) kind empirical {
    label en official "the taxpayer establishes that the failure to provide the documentation is due to reasonable cause";
}
pub relation foreign_penalty_for_disclosure_only_reason_982b2(taxpayer: us.irc.core::Person, request_id: Text) kind empirical {
    label en official "the only reason given is that a foreign jurisdiction would impose a civil or criminal penalty for disclosing the documentation";
}
pub relation failure_to_comply_982a(taxpayer: us.irc.core::Person, request_id: Text, on: Date) kind institutional {
    label en official "the taxpayer failed to substantially comply before the end of the compliance period, without reasonable cause (a foreign disclosure penalty is not reasonable cause)";
}
pub relation compliance_test_date_982(taxpayer: us.irc.core::Person, request_id: Text, on: Date) kind empirical {
    label en unofficial "the date at which compliance is tested (a domain anchor)";
}
@source(IRC_S982_B, relation = formalizes, coverage = exact, quote = "the fact that a foreign jurisdiction would impose a civil or criminal penalty on the taxpayer (or any other person) for disclosing the requested documentation is not reasonable cause.")
rule S982FailureToComplyWithoutReasonableCause defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for on: Date;
    for ends: Date;
    when compliance_period_ends_982a(taxpayer, request_id, ends)
     and compliance_test_date_982(taxpayer, request_id, on)
     and on > ends;
    unless taxpayer_substantially_complied_with_request_982a(taxpayer, request_id)
     and compliance_period_ends_982a(taxpayer, request_id, ends)
     and compliance_test_date_982(taxpayer, request_id, on);
    unless reasonable_cause_for_failure_982b1(taxpayer, request_id)
     and compliance_period_ends_982a(taxpayer, request_id, ends)
     and compliance_test_date_982(taxpayer, request_id, on);
    then failure_to_comply_982a(taxpayer, request_id, on);
}
pub relation foreign_documentation_may_not_be_introduced_982a(taxpayer: us.irc.core::Person, request_id: Text) kind institutional {
    label en official "on the Secretary's motion, the taxpayer may not introduce any foreign-based documentation covered by the request in a civil proceeding on the examined item (section 982(a)); the motion and the court order are not modeled";
}
rule S982AConsequenceForeignDocumentationExcluded defeasible {
    for taxpayer: us.irc.core::Person;
    for request_id: Text;
    for on: Date;
    when failure_to_comply_982a(taxpayer, request_id, on);
    then foreign_documentation_may_not_be_introduced_982a(taxpayer, request_id);
}
