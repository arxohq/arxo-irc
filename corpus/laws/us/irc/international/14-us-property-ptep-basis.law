// §956 — investment of earnings in United States asset (the "amount"
// determined for a US shareholder, US-asset classification, and the (d)
// pledge/guarantee constructive-holding rule); §959(a),(d) — the previously-
// taxed-earnings-and-profits (PTEP) exclusion from gross income and the
// not-a-dividend/E&P-reduction treatment of an excluded distribution; §961
// (a),(b) — basis increase for a section 951(a) inclusion and basis
// reduction for a section 959(a) exclusion, with the section 962-election
// caps on both. Stage 2 (IRC-10 stage 2, A13).
//
// NOT modeled this stage: §956(b) applicable-earnings' own reductions
// (already-distributed amounts, the pre-CFC-acquisition and ceased-to-be-
// CFC special rules of (b)(2)-(3)) — `applicable_earnings_956` is asserted
// directly as the already-net figure (INTERPRETATION); the twelve §956(c)(2)
// (A)-(L) exceptions and the (c)(3) trade/service-receivable override are
// folded into a single case-asserted `us_property_956_excepted` flag rather
// than independently derived item-by-item (TECH_GAP — same folding
// convention `10-subpart-f.law` uses for the §954(c) FPHCI item list);
// §959(b),(c),(e),(f) (the chain-of-CFCs exclusion, the section 316(a)
// ordering-of-distributions allocation, the section 1248 coordination, and
// the allocation-of-inclusions ordering rule) are not modeled — the (a)
// exclusion here is a single-shareholder, single-layer PTEP pool, not the
// full multi-category ordering machinery (TECH_GAP, same self-referential-
// balance-tracking class as TECH-GAPS G97 for a MULTI-YEAR pool, though a
// single-year balance comparison is within this stage's reach and IS
// modeled); §961(c),(d) (chain-of-CFCs basis pass-through, and the section
// 245A specified-10%-owned-foreign-corporation basis reduction) are not
// modeled.

// --- §956(c): United States asset, and (d) pledges/guarantees ---------

use self::{
    IRC_S956_A,
    IRC_S956_C,
    IRC_S956_D,
    IRC_S959_A,
    IRC_S959_D,
    IRC_S961_A,
    IRC_S961_B,
    elects_962,
    subpart_f_inclusion,
    us_property_956_exception_applies,
};

pub relation tangible_property_located_in_us_956(asset: Text) kind empirical {
    label en official "tangible asset located in the United States, for section 956(c)(1)(A)";
}
pub relation stock_of_domestic_corporation_956(asset: Text) kind empirical {
    label en official "stock of a domestic corporation, for section 956(c)(1)(B)";
}
pub relation obligation_of_united_states_person_956(asset: Text) kind empirical {
    label en official "an obligation of a United States person, for section 956(c)(1)(C)";
}
pub relation right_to_use_ip_in_us_956(asset: Text) kind empirical {
    label en official "a right to the use in the United States of a patent, copyright, invention, model, design, secret formula or process, or other similar right, acquired or developed by the controlled foreign corporation for use in the United States, for section 956(c)(1)(D)";
}
pub relation us_property_956_excepted(asset: Text) kind empirical {
    label en unofficial "the asset falls within one of the twelve section 956(c)(2)(A)-(L) exceptions (bank deposits, export inventory, ordinary-course trade obligations, foreign-commerce transportation equipment, insurance unearned-premium assets, excluded ocean/continental-shelf equipment, section 952(b)-excluded E&P assets, dealer collateral/margin deposits, dealer securities, and the (L) qualifying obligation) — folded into one case-asserted flag rather than independently derived per exception (TECH_GAP, twelve-item list)";
}
@source(IRC_S956_C, relation = formalizes, coverage = partial, quote = "the term \"United States property\" means any property acquired after December 31, 1962, which is—")
pub relation us_property_956(asset: Text) kind institutional {
    label en official "the asset is United States asset for section 956(a): it is tangible asset in the US, stock of a domestic corporation, an obligation of a US person, or a US-use IP right, and none of the section 956(c)(2) exceptions this stage folds into one flag applies";
}
rule S956C1TangiblePropertyInUs defeasible {
    for asset: Text;
    when tangible_property_located_in_us_956(asset);
    unless us_property_956_excepted(asset);
    unless us_property_956_exception_applies(asset);
    then us_property_956(asset);
}
rule S956C1StockOfDomesticCorporation defeasible {
    for asset: Text;
    when stock_of_domestic_corporation_956(asset);
    unless us_property_956_excepted(asset);
    unless us_property_956_exception_applies(asset);
    then us_property_956(asset);
}
rule S956C1ObligationOfUsPerson defeasible {
    for asset: Text;
    when obligation_of_united_states_person_956(asset);
    unless us_property_956_excepted(asset);
    unless us_property_956_exception_applies(asset);
    then us_property_956(asset);
}
rule S956C1RightToUseIpInUs defeasible {
    for asset: Text;
    when right_to_use_ip_in_us_956(asset);
    unless us_property_956_excepted(asset);
    unless us_property_956_exception_applies(asset);
    then us_property_956(asset);
}

pub relation cfc_is_pledgor_or_guarantor_of(corp: us.irc.core::Corporation, obligation: Text) kind empirical {
    label en official "the controlled foreign corporation is a pledgor or guarantor of the obligation of a United States person, for section 956(d)";
}
@source(IRC_S956_D, relation = formalizes, coverage = exact, quote = "a controlled foreign corporation shall, under regulations prescribed by the Secretary, be considered as holding an obligation of a United States person if such controlled foreign corporation is a pledgor or guarantor of such obligations")
rule S956DPledgeOrGuaranteeTreatedAsHolding defeasible {
    for corp: us.irc.core::Corporation;
    for obligation: Text;
    when cfc_is_pledgor_or_guarantor_of(corp, obligation);
    then obligation_of_united_states_person_956(obligation);
}

// --- §956(a): the amount ---------------------------------------------------

pub relation shareholder_pro_rata_avg_us_property_956(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's pro rata share of the average of the amounts of United States asset held (directly or indirectly) by the controlled foreign corporation as of the close of each quarter of the taxable year, for section 956(a)(1)(A) — asserted directly as the already-averaged, already-pro-rated figure (INTERPRETATION: the quarterly-average computation itself and the pro-ration by ownership share are not independently derived this stage, unlike the section 951(a)(2) pro rata formula module 10 does derive)";
}
pub relation shareholder_959c1a_earnings_and_profits(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of earnings and profits described in section 959(c)(1)(A) with respect to the shareholder, for the section 956(a)(1)(B) offset";
}
@source(IRC_S956_A, relation = formalizes, coverage = partial, quote = "the excess (if any) of—\n(A) such shareholder's pro rata share of the average of the amounts of United States property held (directly or indirectly) by the controlled foreign corporation as of the close of each quarter of such taxable year, over\n(B) the amount of earnings and profits described in section 959(c)(1)(A) with respect to such shareholder")
pub relation section_956a1_excess(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 956(a)(1) excess (if any) of the shareholder's pro rata average US asset over the section 959(c)(1)(A) E&P offset, floored at zero";
}
rule S956A1Excess defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for asset: Money;
    for offset: Money;
    when shareholder_pro_rata_avg_us_property_956(shareholder, corp, y, asset)
     and shareholder_959c1a_earnings_and_profits(shareholder, corp, y, offset);
    then section_956a1_excess(shareholder, corp, y, max(0.00 USD, asset - offset));
}
pub relation applicable_earnings_956(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the controlled foreign corporation's applicable earnings for the taxable year (section 956(b)(1)) — asserted directly as the already-net figure (see module note: the (b)(1) reductions themselves are not independently derived)";
}
pub relation shareholder_stock_ownership_share_958a_956(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, share: Decimal) kind empirical {
    label en unofficial "the shareholder's section 958(a) stock ownership share in the corporation, for the section 956(a)(2) pro rata share of applicable earnings — reuses the same concept module 10 names `shareholder_stock_ownership_share_958a`, declared again locally under a distinct name because this module does not import it as a cross-file bare reference without re-declaration risk (LDC-E1201 caution)";
}
@source(IRC_S956_A, relation = formalizes, coverage = exact, quote = "such shareholder's pro rata share of the applicable earnings of such controlled foreign corporation")
pub relation shareholder_pro_rata_applicable_earnings_956(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 956(a)(2) alternative: the shareholder's pro rata share of the corporation's applicable earnings";
}
rule S956A2ProRataApplicableEarnings defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for earnings: Money;
    for share: Decimal;
    when applicable_earnings_956(corp, y, earnings)
     and shareholder_stock_ownership_share_958a_956(shareholder, corp, y, share);
    then shareholder_pro_rata_applicable_earnings_956(shareholder, corp, y, earnings * share);
}
@source(IRC_S956_A, relation = formalizes, coverage = exact, quote = "the amount determined under this section with respect to any United States shareholder for any taxable year is the lesser of—")
pub relation section_956_amount(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 956(a) amount: the lesser of the (a)(1) excess or the (a)(2) pro rata share of applicable earnings — the amount a US shareholder must include in gross income under section 951(a)(1)(B) for the CFC's investment in United States asset";
}
rule S956AAmount defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for excess: Money;
    for applicable: Money;
    when section_956a1_excess(shareholder, corp, y, excess)
     and shareholder_pro_rata_applicable_earnings_956(shareholder, corp, y, applicable);
    then section_956_amount(shareholder, corp, y, min(excess, applicable));
}

// --- §959(a),(d): previously-taxed E&P exclusion --------------------------

pub relation ptep_balance_959c1a(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's previously-taxed-earnings-and-profits balance attributable to prior section 951(a) inclusions with respect to the corporation, as of the start of the taxable year — a single-year balance snapshot, not the full multi-category (c) ordering machinery (see module note)";
}
pub relation distribution_received_from_cfc(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "a distribution the shareholder receives from the controlled foreign corporation during the taxable year, for section 959(a)";
}
@source(IRC_S959_A, relation = formalizes, coverage = partial, quote = "the earnings and profits of a foreign corporation attributable to amounts which are, or have been, included in the gross income of a United States shareholder under section 951(a) shall not, when—\n(1) such amounts are distributed to, or\n(2) such amounts would, but for this subsection, be included under section 951(a)(1)(B) in the gross income of,\nsuch shareholder")
pub relation distribution_excluded_under_959a(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the portion of a distribution from the controlled foreign corporation excluded from the shareholder's gross income under section 959(a)(1), limited to the shareholder's previously-taxed-E&P balance";
}
rule S959ADistributionExcluded defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for distribution: Money;
    for ptep: Money;
    when distribution_received_from_cfc(shareholder, corp, y, distribution)
     and ptep_balance_959c1a(shareholder, corp, y, ptep);
    then distribution_excluded_under_959a(shareholder, corp, y, min(distribution, ptep));
}
@source(IRC_S959_D, relation = formalizes, coverage = exact, quote = "Any distribution excluded from gross income under subsection (a) shall be treated, for purposes of this chapter, as a distribution which is not a dividend; except that such distributions shall immediately reduce earnings and profits.")
pub relation distribution_959a_not_a_dividend(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear) kind institutional {
    label en official "a distribution excluded from gross income under section 959(a) is NOT treated as a dividend for chapter 1 purposes, and immediately reduces the corporation's earnings and profits (section 959(d))";
}
rule S959DNotADividend defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when distribution_excluded_under_959a(shareholder, corp, y, amount)
     and amount > 0.00 USD;
    then distribution_959a_not_a_dividend(shareholder, corp, y);
}

// --- §961(a),(b): basis adjustments -----------------------------------------

// `elects_962` is `11-gilti-and-credits.law`'s own relation (declared there
// for the section 962 power's `exercise`/`valid_when`); referenced here by
// its bare intra-package name (its own `Individual`-typed signature is a
// subtype of `Person`, matched by the `subpart_f_inclusion` shareholder
// this module already reads).
pub relation tax_paid_on_951a_inclusion_962(shareholder: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the amount of tax paid under chapter 1 with respect to the shareholder's section 951(a) inclusions for the year, for the section 961(a) second-sentence cap that applies when a section 962 election is in effect";
}
@source(IRC_S961_A, relation = formalizes, coverage = partial, quote = "the basis of a United States shareholder's stock in a controlled foreign corporation, and the basis of property of a United States shareholder by reason of which he is considered under section 958(a)(2) as owning stock of a controlled foreign corporation, shall be increased by the amount required to be included in his gross income under section 951(a) with respect to such stock")
pub relation basis_increase_961a(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 961(a) increase to the basis of the shareholder's stock in the controlled foreign corporation: the amount included in gross income under section 951(a) with respect to that stock, capped at the section 962 tax-paid amount if a section 962 election is in effect for the year";
}
rule S961ABasisIncreaseNoElection defeasible {
    for shareholder: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for inclusion: Money;
    when subpart_f_inclusion(shareholder, corp, y, inclusion);
    unless elects_962(shareholder, y)
     and subpart_f_inclusion(shareholder, corp, y, inclusion);
    then basis_increase_961a(shareholder, corp, y, inclusion);
}
rule S961ABasisIncreaseWithElection defeasible {
    for shareholder: us.irc.core::Individual;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for inclusion: Money;
    for tax_paid: Money;
    when subpart_f_inclusion(shareholder, corp, y, inclusion)
     and elects_962(shareholder, y)
     and tax_paid_on_951a_inclusion_962(shareholder, y, tax_paid);
    then basis_increase_961a(shareholder, corp, y, min(inclusion, tax_paid));
}

@source(IRC_S961_B, relation = formalizes, coverage = partial, quote = "the adjusted basis of stock or other property with respect to which a United States shareholder or a United States person receives an amount which is excluded from gross income under section 959(a) shall be reduced by the amount so excluded")
pub relation basis_reduction_961b(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 961(b)(1) reduction to the basis of the stock or other asset with respect to which the shareholder received a section 959(a)-excluded distribution, equal to the amount excluded";
}
rule S961BBasisReduction defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for excluded: Money;
    when distribution_excluded_under_959a(shareholder, corp, y, excluded)
     and excluded > 0.00 USD;
    then basis_reduction_961b(shareholder, corp, y, excluded);
}
pub relation stock_basis_before_961b_reduction(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en unofficial "the shareholder's adjusted basis in the stock or other asset immediately before the section 961(b) reduction, for the section 961(b)(2) excess-over-basis test";
}
@source(IRC_S961_B, relation = formalizes, coverage = exact, quote = "To the extent that an amount excluded from gross income under section 959(a) exceeds the adjusted basis of the stock or other property with respect to which it is received, the amount shall be treated as gain from the sale or exchange of property.")
pub relation excess_961b2_treated_as_gain(shareholder: us.irc.core::Person, corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 961(b)(2) amount: the portion of a section 959(a)-excluded distribution that exceeds the shareholder's basis in the stock or asset, treated as gain from the sale or exchange of asset";
}
rule S961B2ExcessTreatedAsGain defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for excluded: Money;
    for basis: Money;
    when distribution_excluded_under_959a(shareholder, corp, y, excluded)
     and stock_basis_before_961b_reduction(shareholder, corp, y, basis)
     and excluded > basis;
    then excess_961b2_treated_as_gain(shareholder, corp, y, excluded - basis);
}
