// International -- WIRE-10 group D (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// The highest rate of tax specified in section 1 for the taxable year (sections 1446(b)(2)(A) and 871(b)(1)) is derived from the
// highest rate `us.irc.income_individual` states for taxable years beginning after 2017. Earlier years keep the case-fact channel.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

use self::{
    highest_individual_rate,
};

rule W10HighestIndividualRateFromIncomeIndividual strict {
    label en official "the highest rate of tax specified in section 1 for the taxable year is the highest rate the income-individual package states for the year";
    for y: us.irc.core::TaxableYear;
    for rate: Decimal;
    when us.irc.income_individual::highest_rate_under_section_1(y, rate);
    then highest_individual_rate(y, rate);
}
