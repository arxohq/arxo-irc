// International -- WIRE-10, group B (26.09.2026, DECISION-0379, implemented_unverified; scenarios written, NOT executed; no legal review).
//
// Owner-derives-consumer technique: `income_individual` (the alternative minimum tax, section 55(a)) reads the tax imposed by section
// 59A as a `pub` stub; this package owns section 59A and already imports `income_individual`, so it derives that stub. The rule is
// `defeasible` because the producer of `base_erosion_minimum_tax_amount` is defeasible (LDC-E4103). The case-fact channel of the
// stub stays valid.

language "law.core" version "0.2";
package us.irc.international version "0.1.1";
namespace "urn:us:irc:international:clir";

use self::{
    IRC_S59A_A,
    applicable_taxpayer_59a,
    base_erosion_minimum_tax_amount,
};

@source(IRC_S59A_A, relation = formalizes, coverage = partial, quote = "a tax equal to the base erosion minimum tax amount for the taxable year")
rule W10Section59aTaxForSection55 defeasible {
    label en official "the tax imposed by section 59A is the base erosion minimum tax amount; income_individual reads it for the section 55(a) alternative minimum tax";
    for taxpayer: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when applicable_taxpayer_59a(taxpayer, y);
    when base_erosion_minimum_tax_amount(taxpayer, y, amount);
    then us.irc.income_individual::section_59a_tax(taxpayer, y, amount);
}
