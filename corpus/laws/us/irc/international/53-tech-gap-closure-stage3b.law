// Stage 3b, module 53: the last TECH_GAP rows of stage 3 (G5200-G5209) and the pro rata chain G1741. Every computation takes its
// aggregates (per-pool earnings, reserve inputs, film estimates, excesses) as case-supplied amounts; bounded, one-step forms only,
// multi-year ledgers stay case inputs (residual limits: TECH-GAPS G5700-G5702). Status implemented_unverified: not a legal review;
// scenarios in tests/tech-gap-closure-stage3b.lawtest are written, NOT executed.

// --- §951A(c)(2)(A)(i): gross income for tested income, derived from the five exclusions -------------------------------------------

use self::{
    IRC_S911_F,
    IRC_S951A_C,
    IRC_S951A_E,
    IRC_S954_I,
    IRC_S958_B,
    IRC_S960_C,
    IRC_S971_B,
    IRC_S987,
    IRC_S993_D,
    IRC_S995_C,
    IRC_S996_D,
    capital_gain_excess_911f2A,
    cfc_gross_income_for_tested_income_951Ac2Ai,
    cfc_status_fraction_of_year,
    cfc_taxable_year_begins_after_20251231,
    domestic_film_maker_993d4B,
    downward_attribution_barred_958b4,
    excess_limitation_account_balance_960c2,
    excess_limitation_account_decrease_960c2C,
    excess_limitation_account_increase_960c2B,
    gain_on_disposition_of_disc_stock_995c,
    prior_inclusion_year_condition_960c1A,
    shareholder_cfc_period_fraction_951a2B,
    shareholder_pro_rata_share_of_tested_income,
    shareholder_pro_rata_share_of_tested_loss,
    shareholder_stock_ownership_share_958a,
    tested_income_computed_951Ac2A,
    tested_income_of_cfc,
    tested_loss_computed_951Ac2B,
    tested_loss_of_cfc,
};

pub relation cfc_total_gross_income_before_exclusions_951Ac2Ai(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the gross income of the controlled foreign corporation for the taxable year before the section 951A(c)(2)(A)(i) exclusions";
}
pub relation cfc_gross_income_exclusions_951Ac2Ai(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, eci_952b: Money, subpart_f: Money, high_taxed_954b4: Money, related_dividends: Money, oil_gas: Money) kind empirical {
    label en official "the amounts excluded from tested gross income: (I) section 952(b) items, (II) gross income taken into account in determining subpart F income, (III) gross income excluded by section 954(b)(4), (IV) dividends received from a related person, (V) foreign oil and gas extraction income";
}
@source(IRC_S951A_C, relation = formalizes, coverage = partial, quote = "The term \"tested income\" means, with respect to any controlled foreign corporation for any taxable year of such controlled foreign corporation, the excess (if any) of—")
rule S951AC2AiGrossIncomeWithoutExclusions defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for total: Money;
    for eci: Money;
    for subpart_f: Money;
    for high_taxed: Money;
    for related: Money;
    for oil_gas: Money;
    when cfc_total_gross_income_before_exclusions_951Ac2Ai(corp, y, total)
     and cfc_gross_income_exclusions_951Ac2Ai(corp, y, eci, subpart_f, high_taxed, related, oil_gas);
    then cfc_gross_income_for_tested_income_951Ac2Ai(corp, y, total - eci - subpart_f - high_taxed - related - oil_gas);
}
@source(IRC_S951A_C, relation = formalizes, coverage = partial, quote = "The term \"tested income\" means, with respect to any controlled foreign corporation for any taxable year of such controlled foreign corporation, the excess (if any) of—")
rule S951AC2ATestedIncomeOfCfcFromComputed defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when tested_income_computed_951Ac2A(corp, y, amount);
    then tested_income_of_cfc(corp, y, amount);
}
@source(IRC_S951A_C, relation = formalizes, coverage = partial, quote = "The term \"tested loss\" means, with respect to any controlled foreign corporation for any taxable year of such controlled foreign corporation, the excess (if any) of the amount described in subparagraph (A)(ii) over the amount described in subparagraph (A)(i")
rule S951AC2BTestedLossOfCfcFromComputed defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when tested_loss_computed_951Ac2B(corp, y, amount);
    then tested_loss_of_cfc(corp, y, amount);
}

// --- §951A(e)(1): pro rata share under the section 951(a)(2) rules (G1741), both editions ------------------------------------------

@source(IRC_S951A_E, relation = formalizes, coverage = partial, quote = "pro rata share")
rule S951AE1ProRataTestedIncomePreEdition defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    for cfc_fraction: Decimal;
    for ownership_share: Decimal;
    when tested_income_computed_951Ac2A(corp, y, tested)
     and cfc_status_fraction_of_year(corp, y, cfc_fraction)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share);
    unless cfc_taxable_year_begins_after_20251231(corp, y)
     and tested_income_computed_951Ac2A(corp, y, tested)
     and cfc_status_fraction_of_year(corp, y, cfc_fraction)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share);
    then shareholder_pro_rata_share_of_tested_income(shareholder, corp, y, round(tested * cfc_fraction * ownership_share, 2, "HALF_UP"));
}
@source(IRC_S951A_E, relation = formalizes, coverage = partial, quote = "pro rata share")
rule S951AE1ProRataTestedIncomePostEdition defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    for ownership_share: Decimal;
    for period: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and tested_income_computed_951Ac2A(corp, y, tested)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share)
     and shareholder_cfc_period_fraction_951a2B(shareholder, corp, y, period);
    then shareholder_pro_rata_share_of_tested_income(shareholder, corp, y, round(tested * ownership_share * period, 2, "HALF_UP"));
}
@source(IRC_S951A_E, relation = formalizes, coverage = partial, quote = "pro rata share")
rule S951AE1ProRataTestedLossPreEdition defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    for cfc_fraction: Decimal;
    for ownership_share: Decimal;
    when tested_loss_computed_951Ac2B(corp, y, tested)
     and cfc_status_fraction_of_year(corp, y, cfc_fraction)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share);
    unless cfc_taxable_year_begins_after_20251231(corp, y)
     and tested_loss_computed_951Ac2B(corp, y, tested)
     and cfc_status_fraction_of_year(corp, y, cfc_fraction)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share);
    then shareholder_pro_rata_share_of_tested_loss(shareholder, corp, y, round(tested * cfc_fraction * ownership_share, 2, "HALF_UP"));
}
@source(IRC_S951A_E, relation = formalizes, coverage = partial, quote = "pro rata share")
rule S951AE1ProRataTestedLossPostEdition defeasible {
    for shareholder: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for tested: Money;
    for ownership_share: Decimal;
    for period: Decimal;
    when cfc_taxable_year_begins_after_20251231(corp, y)
     and tested_loss_computed_951Ac2B(corp, y, tested)
     and shareholder_stock_ownership_share_958a(shareholder, corp, y, ownership_share)
     and shareholder_cfc_period_fraction_951a2B(shareholder, corp, y, period);
    then shareholder_pro_rata_share_of_tested_loss(shareholder, corp, y, round(tested * ownership_share * period, 2, "HALF_UP"));
}

// --- §960(c)(2)(A), (B) last sentence: the excess limitation account, one-step form -----------------------------------------------

pub relation first_account_year_960c2A(p: us.irc.core::Person, y: us.irc.core::TaxableYear) kind empirical {
    label en official "the first taxable year for which the taxpayer meets the requirements of section 960(c)(1)(A) and so establishes the excess limitation account";
}
pub relation excess_limitation_account_opening_balance_960c2A(p: us.irc.core::Person, y: us.irc.core::TaxableYear, balance: Money) kind institutional {
    label en official "the opening balance of the excess limitation account in the year of its establishment: zero";
}
@source(IRC_S960_C, relation = formalizes, coverage = exact, quote = "Each taxpayer meeting the requirements of paragraph (1)(A) shall establish an excess limitation account. The opening balance of such account shall be zero.")
rule S960C2AOpeningBalanceZero defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    when prior_inclusion_year_condition_960c1A(p)
     and first_account_year_960c2A(p, y);
    then excess_limitation_account_opening_balance_960c2A(p, y, 0.00 USD);
}
pub relation credit_increase_by_carryback_only_for_inclusions_960c2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the increase in the section 901 credit allowable for the year by reason of a carryback which would not have been allowable but for the section 951(a) inclusions";
}
pub relation excess_limitation_account_increase_after_carryback_960c2B(p: us.irc.core::Person, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the yearly addition to the account after the proper reduction for the carryback credit increase (section 960(c)(2)(B), last sentence), not below zero";
}
@source(IRC_S960_C, relation = formalizes, coverage = exact, quote = "Proper reductions in the amount added to the account under the preceding sentence for any taxable year shall be made for any increase in the credit allowable under section 901 for such taxable year by reason of a carryback")
rule S960C2BCarrybackReduction defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for addition: Money;
    for carryback: Money;
    when excess_limitation_account_increase_960c2B(p, y, addition)
     and credit_increase_by_carryback_only_for_inclusions_960c2B(p, y, carryback);
    then excess_limitation_account_increase_after_carryback_960c2B(p, y, max(0.00 USD, addition - carryback));
}
pub relation excess_limitation_account_balance_end_of_year_960c2(p: us.irc.core::Person, y: us.irc.core::TaxableYear, balance: Money) kind institutional {
    label en official "the balance of the account at the end of the year: opening balance plus the addition after carryback reductions less the reduction under section 960(c)(2)(C) (one year; the next year's opening balance is a case input, TECH-GAPS G5700)";
}
@source(IRC_S960_C, relation = formalizes, coverage = partial, quote = "For each taxable year beginning after September 30, 1993, the taxpayer shall increase the amount in the excess limitation account by the excess (if any) of—")
rule S960C2EndOfYearBalance defeasible {
    for p: us.irc.core::Person;
    for y: us.irc.core::TaxableYear;
    for opening: Money;
    for addition: Money;
    for reduction: Money;
    when excess_limitation_account_balance_960c2(p, y, opening)
     and excess_limitation_account_increase_after_carryback_960c2B(p, y, addition)
     and excess_limitation_account_decrease_960c2C(p, y, reduction);
    then excess_limitation_account_balance_end_of_year_960c2(p, y, opening + addition - reduction);
}

// --- §954(i)(4)(A), (5): substituted parameters for insurance reserves ---------------------------------------------------------------

pub relation qualifying_insurance_company_or_branch_954i(company: us.irc.core::Corporation) kind empirical {
    label en official "a qualifying insurance company or a qualifying insurance company branch (section 954(i)(2))";
}
pub relation functional_currency_mid_term_rate_954i(company: us.irc.core::Corporation, rate: Decimal) kind empirical {
    label en official "the interest rate determined for the functional currency of the company or branch, calculated in the same manner as the Federal mid-term rate under section 1274(d)";
}
pub relation highest_assumed_rate_for_foreign_statement_reserves_954i5B(company: us.irc.core::Corporation, rate: Decimal) kind empirical {
    label en official "the highest assumed interest rate permitted to be used in determining foreign statement reserves";
}
pub relation home_country_mortality_table_954i5C(company: us.irc.core::Corporation, table_id: Text) kind empirical {
    label en official "the tables for mortality and morbidity which reasonably reflect the current mortality and morbidity risks in the home country of the company or branch";
}
pub relation reserve_interest_rate_substituted_954i(company: us.irc.core::Corporation, rate: Decimal) kind institutional {
    label en official "the rate substituted for the applicable Federal interest rate in determining unearned premiums (paragraph (4)(A)(i)) and reserves (paragraph (5)(A)) as under subchapter L";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "the interest rate determined for the functional currency of the company or branch, and which, except as provided by the Secretary, is calculated in the same manner as the Federal mid-term rate under section 1274(d), shall be substituted for the applicable Federal interest rate")
rule S954I4Ai5AFunctionalCurrencyRateSubstituted defeasible {
    for company: us.irc.core::Corporation;
    for rate: Decimal;
    when qualifying_insurance_company_or_branch_954i(company)
     and functional_currency_mid_term_rate_954i(company, rate);
    then reserve_interest_rate_substituted_954i(company, rate);
}
pub relation foreign_loss_payment_pattern_used_954i4Aii(company: us.irc.core::Corporation) kind institutional {
    label en official "the company or branch uses the appropriate foreign loss payment pattern in determining unearned premiums and reserves for property, casualty or health contracts (paragraph (4)(A)(ii))";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(ii) such company or branch shall use the appropriate foreign loss payment pattern.")
rule S954I4AiiForeignLossPaymentPattern defeasible {
    for company: us.irc.core::Corporation;
    when qualifying_insurance_company_or_branch_954i(company);
    then foreign_loss_payment_pattern_used_954i4Aii(company);
}
pub relation reserve_assumed_interest_rate_954i5B(company: us.irc.core::Corporation, rate: Decimal) kind institutional {
    label en official "the assumed interest rate applied in the section 954(i)(5) reserve: the highest rate permitted in determining foreign statement reserves";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(B) the highest assumed interest rate permitted to be used in determining foreign statement reserves shall apply, and")
rule S954I5BHighestAssumedRateApplies defeasible {
    for company: us.irc.core::Corporation;
    for rate: Decimal;
    when qualifying_insurance_company_or_branch_954i(company)
     and highest_assumed_rate_for_foreign_statement_reserves_954i5B(company, rate);
    then reserve_assumed_interest_rate_954i5B(company, rate);
}
pub relation reserve_mortality_table_substituted_954i5C(company: us.irc.core::Corporation, table_id: Text) kind institutional {
    label en official "the home-country mortality and morbidity table substituted for the table otherwise used under subchapter L";
}
@source(IRC_S954_I, relation = formalizes, coverage = exact, quote = "(C) tables for mortality and morbidity which reasonably reflect the current mortality and morbidity risks in the company's or branch's home country shall be substituted for the mortality and morbidity tables otherwise used for such subchapter.")
rule S954I5CHomeCountryTablesSubstituted defeasible {
    for company: us.irc.core::Corporation;
    for table_id: Text;
    when qualifying_insurance_company_or_branch_954i(company)
     and home_country_mortality_table_954i5C(company, table_id);
    then reserve_mortality_table_substituted_954i5C(company, table_id);
}
pub relation reserve_determined_as_under_subchapter_L_954i5(company: us.irc.core::Corporation, contract_id: Text) kind institutional {
    label en official "the reserve of the contract is determined as it would be if the company or branch were subject to tax under subchapter L, with the substitutions of paragraph (5)(A)-(C); the subchapter L amount itself is a case input (module 46)";
}
pub relation contract_of_qualifying_company_954i5(company: us.irc.core::Corporation, contract_id: Text) kind empirical {
    label en official "the contract is a contract of the qualifying insurance company or branch for which a reserve is determined under paragraph (5)";
}
@source(IRC_S954_I, relation = formalizes, coverage = partial, quote = "The amount of the reserve determined under this paragraph with respect to any contract shall be determined in the same manner as it would be determined if the qualifying insurance company or qualifying insurance company branch were subject to tax under subchapter L")
rule S954I5ReserveAsUnderSubchapterL defeasible {
    for company: us.irc.core::Corporation;
    for contract_id: Text;
    for rate: Decimal;
    for assumed: Decimal;
    for table_id: Text;
    when contract_of_qualifying_company_954i5(company, contract_id)
     and reserve_interest_rate_substituted_954i(company, rate)
     and reserve_assumed_interest_rate_954i5B(company, assumed)
     and reserve_mortality_table_substituted_954i5C(company, table_id);
    then reserve_determined_as_under_subchapter_L_954i5(company, contract_id);
}

// --- §987(3)(A), (B): remittances --------------------------------------------------------------------------------------------------

pub relation qbu_remittance_987(qbu: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the post-1986 remittance from the qualified business unit for the taxable year";
}
pub relation qbu_post1986_earnings_pool_987(qbu: Text, pool_id: Text, amount: Money, total: Money) kind empirical {
    label en official "one pool of post-1986 accumulated earnings of the unit and the total of all pools (case-supplied aggregates)";
}
pub relation remittance_attributed_to_pool_987A(qbu: Text, y: us.irc.core::TaxableYear, pool_id: Text, amount: Money) kind institutional {
    label en official "the part of the remittance treated as made out of the pool: pro rata to the pool's share of post-1986 accumulated earnings (section 987(3)(A))";
}
@source(IRC_S987, relation = formalizes, coverage = exact, quote = "(A) treating post-1986 remittances from each such unit as made on a pro rata basis out of post-1986 accumulated earnings")
rule S987A3ARemittanceProRataOutOfPools defeasible {
    for qbu: Text;
    for y: us.irc.core::TaxableYear;
    for pool_id: Text;
    for remittance: Money;
    for pool: Money;
    for total: Money;
    when qbu_remittance_987(qbu, y, remittance)
     and qbu_post1986_earnings_pool_987(qbu, pool_id, pool, total)
     and total > 0.00 USD;
    then remittance_attributed_to_pool_987A(qbu, y, pool_id, div_round(remittance * (pool / 1.00 USD), total / 1.00 USD, 2, "HALF_UP"));
}
pub relation remittance_gain_or_loss_987(qbu: Text, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the gain or loss determined on the remittance under section 987";
}
pub relation qbu_earnings_us_source_percent_987(qbu: Text, percent: Decimal) kind empirical {
    label en official "the part (0 to 1) of the post-1986 accumulated earnings of the unit that arose from sources within the United States (case-supplied aggregate)";
}
pub relation remittance_gain_or_loss_ordinary_987B(qbu: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the gain or loss on the remittance is ordinary income or loss, respectively (section 987(3)(B))";
}
@source(IRC_S987, relation = formalizes, coverage = exact, quote = "(B) treating gain or loss determined under this paragraph as ordinary income or loss, respectively")
rule S987A3BGainOrLossOrdinary defeasible {
    for qbu: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    when remittance_gain_or_loss_987(qbu, y, amount);
    then remittance_gain_or_loss_ordinary_987B(qbu, y, amount);
}
pub relation remittance_gain_or_loss_us_source_987B(qbu: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the part of the remittance gain or loss sourced within the United States by reference to the source of the income giving rise to the post-1986 accumulated earnings (section 987(3)(B))";
}
@source(IRC_S987, relation = formalizes, coverage = exact, quote = "sourcing such gain or loss by reference to the source of the income giving rise to post-1986 accumulated earnings")
rule S987A3BUsSourcePart defeasible {
    for qbu: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for percent: Decimal;
    when remittance_gain_or_loss_987(qbu, y, amount)
     and qbu_earnings_us_source_percent_987(qbu, percent);
    then remittance_gain_or_loss_us_source_987B(qbu, y, round(amount * percent, 2, "HALF_UP"));
}
pub relation remittance_gain_or_loss_foreign_source_987B(qbu: Text, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the remaining part of the remittance gain or loss, sourced without the United States (section 987(3)(B))";
}
@source(IRC_S987, relation = formalizes, coverage = exact, quote = "sourcing such gain or loss by reference to the source of the income giving rise to post-1986 accumulated earnings")
rule S987A3BForeignSourcePart defeasible {
    for qbu: Text;
    for y: us.irc.core::TaxableYear;
    for amount: Money;
    for us_part: Money;
    when remittance_gain_or_loss_987(qbu, y, amount)
     and remittance_gain_or_loss_us_source_987B(qbu, y, us_part);
    then remittance_gain_or_loss_foreign_source_987B(qbu, y, amount - us_part);
}

// --- §911(f)(2)(A)(iii), (B): stacking of the capital gain excess ------------------------------------------------------------------

pub relation section_1h4B_amount_911f2Aiii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind empirical {
    label en official "the amount described in section 1(h)(4)(B) before the section 911(f)(2)(A)(iii) increase";
}
pub relation section_1h4B_amount_increased_911f2Aiii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the section 1(h)(4)(B) amount after increase by the capital gain excess; adjusted net capital gain, unrecaptured section 1250 gain and 28-percent rate gain are determined by the section 1(h) computation of the income tax package on this amount";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "(iii) adjusted net capital gain, unrecaptured section 1250 gain, and 28-percent rate gain shall each be determined after increasing the amount described in section 1(h)(4)(B) by such capital gain excess.")
rule S911F2AiiiIncreaseSection1h4B defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for base: Money;
    for excess: Money;
    when section_1h4B_amount_911f2Aiii(p, y, base)
     and capital_gain_excess_911f2A(p, y, excess);
    then section_1h4B_amount_increased_911f2Aiii(p, y, base + excess);
}
pub relation net_capital_gain_and_taxable_excess_911f2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, net_capital_gain: Money, taxable_excess: Money) kind empirical {
    label en official "the taxpayer's net capital gain without regard to this subsection and the taxable excess as defined in section 55(b)(1)(B)";
}
pub relation section_55b3_analog_applies_911f2B(p: us.irc.core::Individual, y: us.irc.core::TaxableYear) kind institutional {
    label en official "the net capital gain exceeds the taxable excess, so the section 55(b)(3) rules apply as modified by section 911(f)(2)(B)";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "In applying section 55(b)(3) for purposes of determining the tax under paragraph (1)(B)(i) for any taxable year in which, without regard to this subsection, the taxpayer's net capital gain exceeds the taxable excess")
rule S911F2BApplies defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ncg: Money;
    for excess: Money;
    when net_capital_gain_and_taxable_excess_911f2B(p, y, ncg, excess)
     and ncg > excess;
    then section_55b3_analog_applies_911f2B(p, y);
}
pub relation taxable_income_substitute_911f2Bi(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the taxable excess substituted for taxable income when the rules of subparagraph (A) are applied under section 55(b)(3)";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "the rules of subparagraph (A) shall apply, except that such subparagraph shall be applied by substituting \"the taxable excess (as defined in section 55(b)(1)(B))\" for \"taxable income\"")
rule S911F2BiTaxableExcessSubstituted defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for ncg: Money;
    for excess: Money;
    when section_55b3_analog_applies_911f2B(p, y)
     and net_capital_gain_and_taxable_excess_911f2B(p, y, ncg, excess);
    then taxable_income_substitute_911f2Bi(p, y, excess);
}
pub relation excess_1h1B_and_1h1Cii_as_determined_911f2A(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, excess_1h1B: Money, excess_1h1Cii: Money) kind empirical {
    label en official "each such excess as determined under the rules of subparagraph (A) for the tax under paragraph (1)(A)(i)";
}
pub relation excess_referenced_in_55b3B_911f2Bii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reference in section 55(b)(3)(B) to the excess described in section 1(h)(1)(B) is treated as the excess determined under subparagraph (A)";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "the reference in section 55(b)(3)(B) to the excess described in section 1(h)(1)(B)")
rule S911F2BiiReference55b3B defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    when section_55b3_analog_applies_911f2B(p, y)
     and excess_1h1B_and_1h1Cii_as_determined_911f2A(p, y, a, b);
    then excess_referenced_in_55b3B_911f2Bii(p, y, a);
}
pub relation excess_referenced_in_55b3Cii_911f2Bii(p: us.irc.core::Individual, y: us.irc.core::TaxableYear, amount: Money) kind institutional {
    label en official "the reference in section 55(b)(3)(C)(ii) to the excess described in section 1(h)(1)(C)(ii) is treated as the excess determined under subparagraph (A)";
}
@source(IRC_S911_F, relation = formalizes, coverage = exact, quote = "the reference in section 55(b)(3)(C)(ii) to the excess described in section 1(h)(1)(C)(ii)")
rule S911F2BiiReference55b3Cii defeasible {
    for p: us.irc.core::Individual;
    for y: us.irc.core::TaxableYear;
    for a: Money;
    for b: Money;
    when section_55b3_analog_applies_911f2B(p, y)
     and excess_1h1B_and_1h1Cii_as_determined_911f2A(p, y, a, b);
    then excess_referenced_in_55b3Cii_911f2Bii(p, y, b);
}

// --- §971(b) last sentence: allocation of aggregate income by cost ratio -----------------------------------------------------------

pub relation aggregate_income_export_property_and_other_services_971b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, contract_id: Text, aggregate: Money, export_property_cost: Money, total_cost: Money) kind empirical {
    label en official "the aggregate income received from an unrelated person for the use of export property in services together with other services, the cost of the export property consumed (including a reasonable allowance for depreciation) and the total costs and expenses attributable to the aggregate income";
}
pub relation amount_established_by_unrelated_transactions_971b(contract_id: Text) kind empirical {
    label en official "the part of the aggregate income attributable to the use of the export property can be established by reference to transactions between unrelated persons";
}
pub relation income_attributed_to_export_property_use_971b(corp: us.irc.core::Corporation, y: us.irc.core::TaxableYear, contract_id: Text, amount: Money) kind institutional {
    label en official "the part of the aggregate income considered attributable to the use of the export property: the aggregate times the ratio of the export property cost consumed to the total costs and expenses, where it cannot be established by reference to transactions between unrelated persons";
}
@source(IRC_S971_B, relation = formalizes, coverage = exact, quote = "be that part of such aggregate income which the cost of the export property consumed in the rendition of such services (including a reasonable allowance for depreciation) bears to the total costs and expenses attributable to such aggregate income")
rule S971BAllocationByCostRatio defeasible {
    for corp: us.irc.core::Corporation;
    for y: us.irc.core::TaxableYear;
    for contract_id: Text;
    for aggregate: Money;
    for property_cost: Money;
    for total_cost: Money;
    when aggregate_income_export_property_and_other_services_971b(corp, y, contract_id, aggregate, property_cost, total_cost)
     and total_cost > 0.00 USD;
    unless amount_established_by_unrelated_transactions_971b(contract_id)
     and aggregate_income_export_property_and_other_services_971b(corp, y, contract_id, aggregate, property_cost, total_cost);
    then income_attributed_to_export_property_use_971b(corp, y, contract_id, div_round(aggregate * (property_cost / 1.00 USD), total_cost / 1.00 USD, 2, "HALF_UP"));
}

// --- §993(d)(4)(A), (C): film maker limitation on estimates; fully taxable service payments -----------------------------------------

pub relation regulations_permit_estimate_basis_993d4A(borrower: us.irc.core::Person) kind empirical {
    label en official "the regulations prescribed by the Secretary provide for the limitation to be determined on the basis of estimates and industry experience for the borrower";
}
pub relation film_costs_and_estimates_993d4Ai(borrower: us.irc.core::Person, film_id: Text, abc_amounts: Money, estimated_amounts: Money) kind empirical {
    label en official "the sum of the amounts described in paragraph (2)(A), (B) and (C) and the reasonable estimates of all such amounts to be incurred for films commenced in the year of the loan";
}
pub relation producers_experience_receipts_993d4Aii(borrower: us.irc.core::Person, film_id: Text, foreign_receipts: Money, gross_receipts: Money) kind empirical {
    label en official "the annual receipts of producers of similar films from sales, leases or rentals outside the United States and their annual gross receipts from such sales, leases or rentals";
}
pub relation film_limitation_estimated_cost_basis_993d4Ai(borrower: us.irc.core::Person, film_id: Text, amount: Money) kind institutional {
    label en official "clause (i) basis: the sum of the described amounts plus the reasonable estimates";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "(i) the sum of the amounts described in subparagraphs (A), (B), and (C) thereof plus reasonable estimates of all such amounts to be incurred at any time by the borrower with respect to films which are commenced within the taxable year in which the loan is made")
rule S993D4AiCostBasis defeasible {
    for borrower: us.irc.core::Person;
    for film_id: Text;
    for abc: Money;
    for estimates: Money;
    when domestic_film_maker_993d4B(borrower, film_id)
     and regulations_permit_estimate_basis_993d4A(borrower)
     and film_costs_and_estimates_993d4Ai(borrower, film_id, abc, estimates);
    then film_limitation_estimated_cost_basis_993d4Ai(borrower, film_id, abc + estimates);
}
pub relation film_limitation_experience_percentage_993d4Aii(borrower: us.irc.core::Person, film_id: Text, percentage: Decimal) kind institutional {
    label en official "clause (ii) basis: the percentage which the producers' foreign receipts are of their gross receipts";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "the percentage which, based on the experience of producers of similar films, the annual receipts of such producers from the sale, lease, or rental of such films outside the United States is of the annual gross receipts of such producers")
rule S993D4AiiExperiencePercentage defeasible {
    for borrower: us.irc.core::Person;
    for film_id: Text;
    for foreign: Money;
    for gross: Money;
    when domestic_film_maker_993d4B(borrower, film_id)
     and regulations_permit_estimate_basis_993d4A(borrower)
     and producers_experience_receipts_993d4Aii(borrower, film_id, foreign, gross)
     and gross > 0.00 USD;
    then film_limitation_experience_percentage_993d4Aii(borrower, film_id, foreign / gross);
}
pub relation film_maker_limitation_on_estimates_993d4A(borrower: us.irc.core::Person, film_id: Text, limitation: Money) kind institutional {
    label en official "the paragraph (2) limitation of a domestic film maker determined on the basis of the estimated cost basis and the industry experience percentage";
}
@source(IRC_S993_D, relation = formalizes, coverage = partial, quote = "the limitation described in paragraph (2) may be determined (to the extent provided under regulations prescribed by the Secretary) on the basis of")
rule S993D4ALimitationOnEstimates defeasible {
    for borrower: us.irc.core::Person;
    for film_id: Text;
    for basis: Money;
    for percentage: Decimal;
    when film_limitation_estimated_cost_basis_993d4Ai(borrower, film_id, basis)
     and film_limitation_experience_percentage_993d4Aii(borrower, film_id, percentage);
    then film_maker_limitation_on_estimates_993d4A(borrower, film_id, round(basis * percentage, 2, "HALF_UP"));
}
pub relation film_service_payment_993d4C(film_id: Text, payment_id: Text, payee: us.irc.core::Person, amount: Money) kind empirical {
    label en official "an amount paid or to be paid for services performed in the making of the film";
}
pub relation payment_contingent_on_receipts_or_profits_993d4Ci(payment_id: Text) kind empirical {
    label en official "the amount is contingent upon receipts or profits of the film";
}
pub relation payee_is_us_person_nonresident_or_officer_corporation_993d4Cii(payee: us.irc.core::Person) kind empirical {
    label en official "the payee is a United States person, a non-resident alien individual, or a corporation furnishing the services of an officer or employee to the borrower";
}
pub relation payee_film_services_total_and_included_993d4Cii(payee: us.irc.core::Person, film_id: Text, total_received: Money, total_included: Money) kind empirical {
    label en official "the total amount received for services in the making of the film and the part fully included in gross income for purposes of this chapter";
}
pub relation fully_taxable_by_united_states_993d4Cii(payee: us.irc.core::Person, film_id: Text) kind institutional {
    label en official "the amounts paid to the payee are fully taxable by the United States, only if the total received for the services on the film is fully included in gross income";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "shall be treated as fully taxable by the United States only if the total amount received by such person, individual, officer, or employee for services performed in the making of such film is fully included in gross income")
rule S993D4CiiFullyTaxable defeasible {
    for payee: us.irc.core::Person;
    for film_id: Text;
    for received: Money;
    when payee_is_us_person_nonresident_or_officer_corporation_993d4Cii(payee)
     and payee_film_services_total_and_included_993d4Cii(payee, film_id, received, received);
    then fully_taxable_by_united_states_993d4Cii(payee, film_id);
}
pub relation payment_not_taken_into_account_993d4Ci(payment_id: Text) kind institutional {
    label en official "the contingent amount which is fully taxable by the United States is not taken into account for clause (v) of subparagraph (B)";
}
@source(IRC_S993_D, relation = formalizes, coverage = exact, quote = "(i) there shall not be taken into account any amount which is contingent upon receipts or profits of the film and which is fully taxable by the United States")
rule S993D4CiNotTakenIntoAccount defeasible {
    for film_id: Text;
    for payment_id: Text;
    for payee: us.irc.core::Person;
    for amount: Money;
    when film_service_payment_993d4C(film_id, payment_id, payee, amount)
     and payment_contingent_on_receipts_or_profits_993d4Ci(payment_id)
     and fully_taxable_by_united_states_993d4Cii(payee, film_id);
    then payment_not_taken_into_account_993d4Ci(payment_id);
}

// --- §995(c)(1)(B): disposition terminating the separate corporate existence ----------------------------------------------------------

pub relation disposition_terminating_disc_existence_995c1B(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation) kind empirical {
    label en official "the stock of the DISC or former DISC is disposed of in a transaction in which its separate corporate existence terminates (the transaction taxonomy of subchapter C is a case classification)";
}
pub relation mere_change_of_place_of_organization_995c1B(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation) kind empirical {
    label en official "the termination is only a mere change in place of organization, however effected";
}
pub relation gain_recognized_on_terminating_disposition_995c1B(shareholder: us.irc.core::Person, disc: us.irc.core::Corporation, amount: Money) kind institutional {
    label en official "the gain recognized notwithstanding any other provision of the title, to the extent provided in paragraph (2), and included as a dividend";
}
@source(IRC_S995_C, relation = formalizes, coverage = exact, quote = "any gain realized on the disposition of such stock in the transaction shall be recognized notwithstanding any other provision of this title to the extent provided in paragraph (2)")
rule S995C1BGainRecognizedOnTerminatingDisposition defeasible {
    for shareholder: us.irc.core::Person;
    for disc: us.irc.core::Corporation;
    for gain: Money;
    for adi: Money;
    when disposition_terminating_disc_existence_995c1B(shareholder, disc)
     and gain_on_disposition_of_disc_stock_995c(shareholder, disc, gain, adi);
    unless mere_change_of_place_of_organization_995c1B(shareholder, disc)
     and gain_on_disposition_of_disc_stock_995c(shareholder, disc, gain, adi);
    then gain_recognized_on_terminating_disposition_995c1B(shareholder, disc, min(gain, adi));
}

// --- §996(d): previously taxed income and redemption -------------------------------------------------------------------------------------

pub relation share_gain_treated_under_995c_996d1A(disc: us.irc.core::Corporation, share_id: Text, gain: Money) kind empirical {
    label en official "the gain with respect to the share of stock treated under section 995(c) as a dividend or as ordinary income";
}
pub relation share_other_amounts_treated_as_previously_taxed_996d1(share_id: Text, amount: Money) kind empirical {
    label en official "any other amounts with respect to the share already treated under paragraph (1) as made from previously taxed income (case-supplied running total)";
}
pub relation later_distribution_on_share_996d1B(share_id: Text, distribution: Money) kind empirical {
    label en official "a person subsequently receives an actual distribution out of accumulated DISC income, or a deemed distribution under section 995(b)(2), with respect to the share";
}
pub relation distribution_treated_as_from_previously_taxed_income_996d1(share_id: Text, amount: Money) kind institutional {
    label en official "the part of the distribution treated as a distribution from previously taxed income: the gain exceeding the other amounts already so treated, up to the distribution";
}
@source(IRC_S996_D, relation = formalizes, coverage = exact, quote = "such person shall treat such distribution in the same manner as a distribution from previously taxed income to the extent that")
rule S996D1DistributionAsPreviouslyTaxedIncome defeasible {
    for disc: us.irc.core::Corporation;
    for share_id: Text;
    for gain: Money;
    for other: Money;
    for distribution: Money;
    when share_gain_treated_under_995c_996d1A(disc, share_id, gain)
     and share_other_amounts_treated_as_previously_taxed_996d1(share_id, other)
     and later_distribution_on_share_996d1B(share_id, distribution);
    then distribution_treated_as_from_previously_taxed_income_996d1(share_id, min(distribution, max(0.00 USD, gain - other)));
}
pub relation redemption_gain_treated_as_ordinary_996d2(disc: us.irc.core::Corporation, share_id: Text, gain: Money) kind empirical {
    label en official "the gain described in section 995(c) with respect to redeemed stock which is (or has been) treated as ordinary income";
}
pub relation accumulated_disc_income_reduction_996d2(disc: us.irc.core::Corporation, share_id: Text, amount: Money) kind institutional {
    label en official "the reduction of accumulated DISC income on a redemption: the ordinary income gain, except to the extent distributions on the stock were treated under paragraph (1)";
}
@source(IRC_S996_D, relation = formalizes, coverage = exact, quote = "the accumulated DISC income shall be reduced by an amount equal to the gain described in section 995(c) with respect to such stock which is (or has been) treated as ordinary income")
rule S996D2ReductionOnRedemption defeasible {
    for disc: us.irc.core::Corporation;
    for share_id: Text;
    for gain: Money;
    for treated: Money;
    when redemption_gain_treated_as_ordinary_996d2(disc, share_id, gain)
     and share_other_amounts_treated_as_previously_taxed_996d1(share_id, treated);
    then accumulated_disc_income_reduction_996d2(disc, share_id, max(0.00 USD, gain - treated));
}

// --- §958(b) as amended by Pub. L. 119-21: carve-back for section 956(c)(2) ---------------------------------------------------------

pub relation ownership_determined_for_956c2_958b(corp: us.irc.core::Corporation) kind empirical {
    label en official "the stock ownership is being determined for purposes of section 956(c)(2)";
}
pub relation domestic_stock_treated_as_owned_by_us_shareholder_956c2(p: us.irc.core::Person, corp: us.irc.core::Corporation) kind institutional {
    label en official "for purposes of section 956(c)(2) the downward attribution bar of paragraph (4) does not stop stock of a domestic corporation from being treated as owned by the United States shareholder";
}
@source(IRC_S958_B, relation = formalizes, coverage = partial, quote = "Paragraph (1) shall not apply for purposes of section 956(c)(2) to treat stock of a domestic corporation as not owned by a United States shareholder.")
rule S958BCarveBackFor956c2 defeasible {
    for p: us.irc.core::Person;
    for corp: us.irc.core::Corporation;
    when downward_attribution_barred_958b4(p, corp)
     and ownership_determined_for_956c2_958b(corp);
    then domestic_stock_treated_as_owned_by_us_shareholder_956c2(p, corp);
}
